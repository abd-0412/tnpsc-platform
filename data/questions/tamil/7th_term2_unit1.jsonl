// ==============================================================================
// 7-ஆம் வகுப்பு தமிழ் - பருவம் 2 - இயல் 1: கல்வி / அழியாச் செல்வம் / இலக்கணம் / சொல் வகைகள் (மொத்த வினாக்கள்: 68)
// ==============================================================================
// ==============================================================================
// பாடம் 1: அழியாச் செல்வம் (கவிதைப்பேழை - நாலடியார், சமண முனிவர்கள்) [Q001 - Q010, Q067]
// வைப்புழிக் கோட்படா, சொல்-பொருள், நாலடி நானூறு / வேளாண் வேதம், நாலும் இரண்டும் சொல்லுக்குறுதி,
// கூற்றுகள் (சமண முனிவர்கள், 400 வெண்பா, முப்பால்), அழியாச் செல்வம் கல்வி, புணர்ச்சி (வாய்த்தீயின், கேடில்லை, எவனொருவன்), தனிப்பாடல் திரட்டு, கூற்று-காரணம்
// ==============================================================================
{"id":"b-tam-7t2-001","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வைப்புழிக் கோட்படா; வாய்த்தீயிற் கேடில்லை; மிக்க சிறப்பின் அரசர் செறின்வவ்வார்...’ - என்னும் நாலடியார் பாடலை இயற்றியவர்கள் யார்?"}],"options":[{"key":"A","text":"பௌத்தத் துறவிகள்"},{"key":"B","text":"சமண முனிவர்கள்"},{"key":"C","text":"நாயன்மார்கள்"},{"key":"D","text":"ஆழ்வார்கள்"}],"explanation":"நாலடியார் பல சமண முனிவர்களால் இயற்றப்பட்ட பாடல்களின் தொகுப்பாகும்."}}}
{"id":"b-tam-7t2-002","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அழியாச் செல்வம்’ நாலடியார் பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"வைப்புழி"},{"label":"B","text":"கோட்படா"},{"label":"C","text":"விச்சை"},{"label":"D","text":"வவ்வார்"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"ஒருவரால் கொள்ளப்படாது"},{"label":"2","text":"பொருள் சேமித்து வைக்கும் இடம்"},{"label":"3","text":"கவர முடியாது"},{"label":"4","text":"கல்வி"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-4, B-1, C-2, D-3","mapping":{"A":"4","B":"1","C":"2","D":"3"}}],"explanation":"வைப்புழி = பொருள் சேமித்து வைக்கும் இடம்; கோட்படா = ஒருவரால் கொள்ளப்படாது; வாய்த்து ஈயில் = பெறும்படி கொடுத்தாலும்; விச்சை = கல்வி; வவ்வார் = கவர முடியாது; எச்சம் = செல்வம்."}}}
{"id":"b-tam-7t2-003","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நாலடி நானூறு’ மற்றும் ‘வேளாண் வேதம்’ என்று போற்றப்படும் பதினெண்கீழ்க்கணக்கு நூல் எது?"}],"options":[{"key":"A","text":"திருக்குறள்"},{"key":"B","text":"நாலடியார்"},{"key":"C","text":"நான்மணிக்கடிகை"},{"key":"D","text":"பழமொழி நானூறு"}],"explanation":"நாலடியார் நானூறு வெண்பாக்களால் ஆனதால் நாலடி நானூறு என்றும், அறக்கருத்துகளை விரிவாகக் கூறுவதால் வேளாண் வேதம் என்றும் அழைக்கப்படுகிறது."}}}
{"id":"pyq-tam-7t2-004","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":22},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நாலும் இரண்டும் சொல்லுக்குறுதி’ - என்னும் பழமொழியில் ‘நாலும்’, ‘இரண்டும்’ என்னும் சொற்கள் முறையே குறிக்கும் நூல்கள் எவை?"}],"options":[{"key":"A","text":"நான்மணிக்கடிகை, திருக்குறள்"},{"key":"B","text":"நாலடியார், ஆத்திசூடி"},{"key":"C","text":"நாலடியார், திருக்குறள்"},{"key":"D","text":"திரிகடுகம், நன்னெறி"}],"explanation":"நாலும் என்பது நாலடியாரையும், இரண்டும் என்பது இரண்டு அடிகளைக் கொண்ட திருக்குறளையும் குறிக்கிறது."}}}
{"id":"b-tam-7t2-005","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"text","text":"நாலடியார் நூல் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"இந்நூல் சமண முனிவர்கள் பலரால் பாடப்பட்ட பாடல்களின் தொகுப்பாகும்."},{"type":"statement","label":"II","text":"இந்நூல் பதினெண்கீழ்க்கணக்கு நூல்களுள் ஒன்றாகும்; நானூறு வெண்பாக்களால் ஆனது."},{"type":"statement","label":"III","text":"திருக்குறள் போன்றே அறம், பொருள், இன்பம் என்னும் முப்பால் பகுப்பு கொண்டதாகும்."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"நூல் வெளிப் பகுதியின்படி நாலடியார் பற்றிய மூன்று கூற்றுகளும் முற்றிலும் சரியானவை."}}}
{"id":"b-tam-7t2-006","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 3"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஒருவர் தம் குழந்தைகளுக்குச் சேர்த்து வைக்க வேண்டிய அழியாத விழுமிய செல்வம் எது’ என நாலடியார் குறிப்பிடுகிறது?"}],"options":[{"key":"A","text":"பொன் செல்வம்"},{"key":"B","text":"கல்வி"},{"key":"C","text":"நிலம்"},{"key":"D","text":"அணிகலன்"}],"explanation":"பிறரால் கவரப்பட முடியாததும், கொடுக்கக் கொடுக்கக் குறையாததும், அரசராலும் பறிக்க முடியாததுமான கல்வியே ஒருவன் தன் மக்களுக்குச் சேர்க்க வேண்டிய அழியாச் செல்வம்."}}}
{"id":"b-tam-7t2-007","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 3"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வாய்த்தீயின்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"வாய்த்து + ஈயின்"},{"key":"B","text":"வாய் + தீயின்"},{"key":"C","text":"வாய்த்து + தீயின்"},{"key":"D","text":"வாய் + ஈயின்"}],"explanation":"வாய்த்து + ஈயின் = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி உகரம் கெட்டு, த் + ஈ = தீ ஆகி 'வாய்த்தீயின்' எனப் புணரும்."}}}
{"id":"b-tam-7t2-008","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 3"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கேடில்லை’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"கேடி + இல்லை"},{"key":"B","text":"கே + இல்லை"},{"key":"C","text":"கேள்வி + இல்லை"},{"key":"D","text":"கேடு + இல்லை"}],"explanation":"கேடு + இல்லை = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'கேடில்லை' எனப் புணரும்."}}}
{"id":"b-tam-7t2-009","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 3"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எவன் + ஒருவன்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"எவன்ஒருவன்"},{"key":"B","text":"எவன்னொருவன்"},{"key":"C","text":"எவனொருவன்"},{"key":"D","text":"ஏன்னொருவன்"}],"explanation":"உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி ன் + ஒ = நொ ஆகி, 'எவனொருவன்' எனப் புணரும்."}}}
{"id":"b-tam-7t2-010","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 3"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வெள்ளத்தால் அழியாது வெந்தணலால் வேகாது வேந்தராலும் கொள்ளத்தான் முடியாது கொடுத்தாலும் நிறைவன்றிக் குறைவுறாது...’ - இவ்வடிகள் இடம்பெற்றுள்ள நூல் எது?"}],"options":[{"key":"A","text":"நாலடியார்"},{"key":"B","text":"தனிப்பாடல் திரட்டு"},{"key":"C","text":"நீதிநெறி விளக்கம்"},{"key":"D","text":"மூதுரை"}],"explanation":"பக்கம் 3 கற்பவை கற்றபின் பகுதியில் கல்வியின் அழியாச் சிறப்பைக் கூறும் இப்பாடல் தனிப்பாடல் திரட்டிலிருந்து தரப்பட்டுள்ளது."}}}
{"id":"b-tam-7t2-067","kind":"assertion_reason","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"கல்வி ஒருவருக்கு அழியாத விழுமிய செல்வமாகத் திகழ்கிறது."},{"type":"reason","text":"கல்வியைப் பிறரால் கவர்ந்து செல்ல முடியாது; பிறருக்குக் கொடுத்தாலும் குறையாது; அரசாங்கத்தாலும் பறிமுதல் செய்ய இயலாது."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"நாலடியார் கூறும் 'வைப்புழிக் கோட்படா வாய்த்தீயிற் கேடில்லை அரசர் செறின்வவ்வார்' வரிகள் இதனை முழுமையாக மெய்ப்பிக்கின்றன."}}}
// ==============================================================================
// பாடம் 2: தேயிலைத் தோட்டப் பாட்டு (கவிதைப்பேழை - முகம்மது இராவுத்தர்) [Q011 - Q022]
// இலங்கை/அந்தமான் தீவுகள், சொல்-பொருள், மண்ணுளிப் பாம்பு, கல்வியொழுக்கம் இல்லாக் குறை, முகம்மது இராவுத்தர்,
// முச்சந்தி/குஜிலி இலக்கியம் / பாரத மக்களின் பரிதாபச் சிந்து, கைத்தொழில்கள் அழிவு, கல்வி இல்லாமை, புணர்ச்சி (நாடெங்கும், குறையெனவே), பாக்கி பொய்க்கணக்கு, ஒற்றுமை
// ==============================================================================
{"id":"b-tam-7t2-011","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"19-ஆம் நூற்றாண்டில் ஏற்பட்ட பஞ்சத்தின் காரணமாகக் கூலித் தொழிலாளர்களாகத் தமிழர்கள் கப்பலேறிச் சென்ற ஆங்கிலேயக் குடியேற்றத் தீவுகள் எவை?"}],"options":[{"key":"A","text":"மாலத்தீவு, லட்சத்தீவு"},{"key":"B","text":"இலங்கை, அந்தமான் தீவுகள்"},{"key":"C","text":"மடகாஸ்கர், சிஷெல்ஸ்"},{"key":"D","text":"சுமத்ரா, ஜாவா"}],"explanation":"'அக்கரை தேசத்தின் லங்கைத் தீவுக்குள்ளே அந்தமான் தீவு போன்ற இடத்தில்' தேயிலைத் தோட்டத் தொழிலாளர்களாகக் கொண்டு சேர்க்கப்பட்டனர்."}}}
{"id":"b-tam-7t2-012","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 5"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தேயிலைத் தோட்டப் பாட்டு’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"ராஜரீகம்"},{"label":"B","text":"ரட்சித்து"},{"label":"C","text":"அருஞ்சேகரம்"},{"label":"D","text":"பாக்கி"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"காப்பாற்றி"},{"label":"2","text":"ஆட்சிமுறை"},{"label":"3","text":"கடன்"},{"label":"4","text":"அரிய சேமிப்பு"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}}],"explanation":"ராஜரீகம் = ஆட்சிமுறை; ரட்சித்து = காப்பாற்றி; அருஞ்சேகரம் = அரிய சேமிப்பு; பாக்கி = கடன்; பிராணி = விலங்கு; லங்கைத்தீவு = இலங்கை; கட்டுப்பாடு = உறுதி."}}}
{"id":"b-tam-7t2-013","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"தேயிலைத் தோட்டக் கூலித் தொழிலாளர்கள் பெண்டு பிள்ளைகளுடன் எந்தப் பாம்பைப் போல ஒடுங்கி வாழ்ந்து வருவதாகப் பாடல் வரிகள் கூறுகின்றன?"}],"options":[{"key":"A","text":"நல்ல பாம்பு"},{"key":"B","text":"சாரைப் பாம்பு"},{"key":"C","text":"மண்ணுளிப் பாம்பு"},{"key":"D","text":"பச்சைப்பாம்பு"}],"explanation":"'உண்ண உணவுக்கும் உள்ள செலவுக்கும் ஒவ்வொரு நாளும் அரிதாகி - சிறு மண்ணுளிப் பாம்புபோல் பெண்டு பிள்ளையுடன் வாழ்ந்து வருவதைக் காணீரோ!' என விவரிக்கப்பட்டுள்ளது."}}}
{"id":"b-tam-7t2-014","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"இந்தியத் தொழிலாளர்கள் அந்நிய நாட்டில் சென்று இத்தகைய கொடுமைகளை அனுபவிப்பதற்கான அடிப்படைக் காரணமாகப் பாடல் குறிப்பிடுவது எது?"}],"options":[{"key":"A","text":"பணமின்மை மட்டுமே"},{"key":"B","text":"மனதுக்கு ஒப்பிய கல்வி, ஒழுக்கம், நாகரிகம் ஆகியவை இல்லாக் குறை"},{"key":"C","text":"விவசாயத் தொழில் தெரியாமை"},{"key":"D","text":"வானிலை மாறுபாடுகள்"}],"explanation":"'இந்தியர் துன்பப் படுவதற்கு - மனது ஒப்பிய கல்வியொழுக்கம் நாகரீகம் ஒன்றேனும் இல்லாக் குறையெனவே' என்று கவிஞர் கூறுகிறார்."}}}
{"id":"b-tam-7t2-015","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"பாடப்பகுதியில் இடம்பெற்றுள்ள ‘தேயிலைத் தோட்டப் பாட்டு’ பாடலை இயற்றிய ஆசிரியர் யார்?"}],"options":[{"key":"A","text":"கவி கா.மு. ஷெரீப்"},{"key":"B","text":"முகம்மது இராவுத்தர்"},{"key":"C","text":"உமறுப்புலவர்"},{"key":"D","text":"செய்குதம்பிப் பாவலர்"}],"explanation":"இப்பாடலின் ஆசிரியர் முகம்மது இராவுத்தர் ஆவார்."}}}
{"id":"b-tam-7t2-016","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 5"},"texts":{"ta":{"blocks":[{"type":"text","text":"19-ஆம் Centuries இறுதியில் தோன்றிய மக்கள் இலக்கியங்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"மக்கள் வாழ்வில் ஏற்படும் தாக்கங்களைப் பாடல்களாகவும் கதைப்பாடல்களாகவும் வெளியிட்ட சிறுசிறு நூல்கள் வெளியிடப்பட்டன."},{"type":"statement","label":"II","text":"இந்நூல்கள் வெகுசன இலக்கியம், முச்சந்தி இலக்கியம், குஜிலி நூல்கள், பெரிய எழுத்துப் புத்தகங்கள் எனப் பலவாறாக அழைக்கப்பட்டன."},{"type":"statement","label":"III","text":"பாடப்பகுதி ‘பாரத மக்களின் பரிதாபச் சிந்து’ என்ற ‘தேயிலைத் தோட்டப் பாட்டு’ என்னும் நூலிலிருந்து தரப்பட்டுள்ளது."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"நூல் வெளிப் பகுதியின்படி மூன்று கூற்றுகளும் வரலாற்றுத் துல்லியத்துடன் அமைந்த சரியான தகவல்களாகும்."}}}
{"id":"b-tam-7t2-017","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"முற்காலத்தில் இந்திய மக்களுக்கு வருமானம் கொடுத்து அவர்களைக் காப்பாற்றி வந்தவை எவை?"}],"options":[{"key":"A","text":"பற்றுவரவு"},{"key":"B","text":"பன்னாட்டு வணிகம்"},{"key":"C","text":"கைத்தொழில்கள்"},{"key":"D","text":"தேயிலைத் தோட்டங்கள்"}],"explanation":"மக்களுக்கு வருமானம் கொடுத்துக் காப்பாற்றி வந்த கைத்தொழில்களை அந்நியர்கள் சமயம் பார்த்து அழித்தனர்."}}}
{"id":"b-tam-7t2-018","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"முற்காலத்தில் இந்திய மக்கள் அந்நிய நாடுகளில் துன்பப்பட்டதற்குக் காரணமாக அமைந்தது எது?"}],"options":[{"key":"A","text":"விளையாட்டு இன்மை"},{"key":"B","text":"கல்வி இல்லாமை"},{"key":"C","text":"கலைகள் இன்மை"},{"key":"D","text":"இயற்கை வளமின்மை"}],"explanation":"கல்வி, ஒழுக்கம், நாகரிகம் ஆகியவற்றின் இன்மையே தொழிலாளர்களின் இழிநிலைக்கு முதன்மைக் காரணமாக அமைந்தது."}}}
{"id":"b-tam-7t2-019","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நாடெங்கும்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"நா + டெங்கும்"},{"key":"B","text":"நாடு + டெங்கும்"},{"key":"C","text":"நா + எங்கும்"},{"key":"D","text":"நாடு + எங்கும்"}],"explanation":"நாடு + எங்கும் = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'நாடெங்கும்' எனப் புணரும்."}}}
{"id":"b-tam-7t2-020","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘குறை + எனவே’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"குறையெனவே"},{"key":"B","text":"குறைஎனவே"},{"key":"C","text":"குறையனவே"},{"key":"D","text":"குறைவெனவே"}],"explanation":"'இ ஈ ஐ வழி யவ்வும்' விதிப்படி உடம்படுமெய் ய் தோன்றி, 'குறையெனவே' எனப் புணரும்."}}}
{"id":"b-tam-7t2-021","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"கூலித் தொழிலாளர்கள் மீது வெள்ளை முதலாளிகள் எதனை எழுதி வாழ்நாள் முழுவதும் தலைச்சுமையாக்கி வைத்தனர்?"}],"options":[{"key":"A","text":"வரி விதிப்பை"},{"key":"B","text":"ஒன்றுக்குப் பத்து நூறாயிரமாகத் தண்டுமுண்டுமாய்க் கணக்கு எழுதி பாக்கியை (கடனை)"},{"key":"C","text":"நில பத்திரங்களை"},{"key":"D","text":"அடிமை சாசனங்களை"}],"explanation":"தொழிலாளர்கள் மீது ஒன்றுக்குப் பத்தாகப் பொய்க் கணக்கு எழுதி அவர்களைச் சாகும் வரை தலைச்சுமை கடனாளியாக்கினர்."}}}
{"id":"b-tam-7t2-022","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"தொழிலாளர்கள் துன்பம் நீங்கி ஒற்றுமையாக வாழ்வதற்குத் தேயிலைத் தோட்டப் பாட்டு காட்டும் நல்வழி எது?"}],"options":[{"key":"A","text":"ஆயுதம் ஏந்திப் போரிடுவது"},{"key":"B","text":"பிள்ளைகளுக்கெல்லாம் ஏற்றமுள்ள கல்வியைப் புகட்டி நீங்கள் ஒன்றும் குறையில்லா ஒற்றுமையாகவே ஊரில் கட்டுப்பாடு செய்குவீரே"},{"key":"C","text":"பிற நாடுகளுக்குக் குடிபெயர்வது"},{"key":"D","text":"கைத்தொழில்களைக் கைவிடுவது"}],"explanation":"'பிள்ளைகளுக்கெல்லாம் ஏற்றமுள்ள கல்வியைப் புகட்டி நீங்கள் ஒன்றும் குறையில்லா ஒற்றுமையாகவே ஊரில் கட்டுப்பாடு செய்குவீரே' என அறிவுறுத்துகிறது."}}}
// ==============================================================================
// பாடம் 3: வாழ்விக்கும் கல்வி (உரைநடை உலகம் - திருக்குறளார் வீ. முனிசாமி) [Q023 - Q034]
// மனிதப் பிறவி தனித்தன்மை, காலமறிதல் & கல்வி, மாடு=செல்வம், விளக்கில்லாத வீடு, விலங்கொடு மக்கள்,
// நன்றின்பால் உய்ப்பது அறிவு, பாரதியார் பள்ளித் தலமனைத்தும், கற்க கசடற (காய்/கிழங்கு உவமை), வீ. முனிசாமி நூல்கள், புணர்ச்சி (உயர்வடைவோம், இவையெல்லாம்)
// ==============================================================================
{"id":"b-tam-7t2-023","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 7"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘உலகிலுள்ள உயிரினங்களுள் மனிதப் பிறவி மட்டுமே தனித்தன்மை உடையது’ - என்று திருக்குறளார் வீ. முனிசாமி கூறுவதற்குக் காரணம் என்ன?"}],"options":[{"key":"A","text":"மனிதன் பேசும் ஆற்றல் பெற்றுள்ளதால்"},{"key":"B","text":"பிற உயிரினங்களுக்கு எதிர்காலத்தைக் கணித்துவிட முடியும்; ஆனால் மனிதப் பிறவிக்கு மட்டுமே எதிர்காலம் சொல்ல முடியாது என்பதால்"},{"key":"C","text":"மனிதன் உழைக்கத் தெரிந்தவன் என்பதால்"},{"key":"D","text":"மனிதன் நாகரிகம் படைத்தவன் என்பதால்"}],"explanation":"வாழை மரம் காய் தரும், பசு கன்று ஈன்றால் பால் தரும் எனச் சொல்லலாம்; மனிதன் எதிர்காலத்தில் மாவட்ட ஆட்சியரா, மேதையா எனச் சொல்ல முடியாது; எனவே மனிதப் பிறவி அருமையானது."}}}
{"id":"b-tam-7t2-024","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 8"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘காலத்தின் அருமையை உணர்த்தவே திருவள்ளுவர் எவ்விரண்டு அதிகாரங்களையும் எழுதியுள்ளார்’ என வீ. முனிசாமி குறிப்பிடுகிறார்?"}],"options":[{"key":"A","text":"அறன் வலியுறுத்தல், அன்புடைமை"},{"key":"B","text":"காலமறிதல், கல்வி"},{"key":"C","text":"சுற்றந்தழால், மடியின்மை"},{"key":"D","text":"இறைமாட்சி, தெரிந்து செயல்வகை"}],"explanation":"காலம் போனால் திரும்ப வராது என்பதையும், இளமையில் கற்கும் கல்வியின் மேன்மையையும் உணர்த்தவே காலமறிதல், கல்வி ஆகிய இரு அதிகாரங்களை வள்ளுவர் தந்தார்."}}}
{"id":"pyq-tam-7t2-025","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":7},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கேடில் விழுச்செல்வம் கல்வி ஒருவற்கு மாடல்ல மற்றை யவை’ - இக்குறட்பாவில் ‘மாடு’ என்னும் சொல் குறிக்கும் பொருள் யாது?"}],"options":[{"key":"A","text":"அணிகலன்"},{"key":"B","text":"செல்வம்"},{"key":"C","text":"விலங்கு"},{"key":"D","text":"அறிவு"}],"explanation":"மாடு என்ற சொல்லுக்குச் செல்வம் என்பது பொருள். ஒருவனுக்கு அழிவில்லாத சிறந்த செல்வம் கல்வியே ஆகும்."}}}
{"id":"b-tam-7t2-026","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 8"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கல்வி இல்லாத நாடு ________ வீடு போன்றது’ - திருக்குறளார் வீ. முனிசாமியின் உவமை யாது?"}],"options":[{"key":"A","text":"சுவர் இல்லாத"},{"key":"B","text":"விளக்கில்லாத"},{"key":"C","text":"கதவில்லாத"},{"key":"D","text":"கூரை இல்லாத"}],"explanation":"கல்வி இல்லாத நாடு விளக்கில்லாத இருண்ட வீடு போன்றது; விளக்கில்லாத வீட்டில் யாரும் குடியிருக்க மாட்டார்கள்."}}}
{"id":"pyq-tam-7t2-027","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":54},"texts":{"ta":{"blocks":[{"type":"text","text":"‘விலங்கொடு மக்கள் அனையர் இலங்குநூல் கற்றாரோடு ஏனை யவர்’ - இக்குறட்பாவில் திருவள்ளுவர் யாரை விலங்குகளோடு ஒப்பிடுகிறார்?"}],"options":[{"key":"A","text":"பொருளற்ற ஏழைகளை"},{"key":"B","text":"கல்வியறிவு இல்லாத கல்லாதவர்களை"},{"key":"C","text":"அன்பில்லாதவர்களை"},{"key":"D","text":"பொய் பேசுபவர்களை"}],"explanation":"சிறந்த நூல்களைக் கற்றவரோடு கல்லாதவரை ஒப்பிடும்போது, மக்களுக்கும் விலங்குகளுக்கும் இடையே உள்ள வேற்றுமையே வெளிப்படும் என்கிறார்."}}}
{"id":"b-tam-7t2-028","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 9"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நல்ல செயல்களை மனிதன் தானாகவே முன்வந்து செய்ய வேண்டும்; இன்னொருவர் சொல்லிச் செய்யக் கூடாது’ என்பதை வள்ளுவர் எந்தக் குறளடி மூலம் வலியுறுத்துகிறார்?"}],"options":[{"key":"A","text":"எண்ணித் துணிக கருமம்"},{"key":"B","text":"நன்றின்பால் உய்ப்பது அறிவு"},{"key":"C","text":"கற்க கசடறக் கற்பவை"},{"key":"D","text":"செய்தக்க அல்ல செயக்கெடும்"}],"explanation":"பசு தானாகவே சொம்பைத் தூக்கிப் பால் தராது; ஆனால் மனிதன் நல்ல செயல்களைத் தானாகச் செய்ய வேண்டும் என்பதை 'நன்றின்பால் உய்ப்பது அறிவு' என்ற அடி விளக்குகிறது."}}}
{"id":"pyq-tam-7t2-029","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2018,"paper":"tamil","no":48},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பள்ளித் தலமனைத்தும் கோயில் செய்குவோம்; எங்கள் பாரத தேசமென்று தோள்கொட்டுவோம்’ - என்று முழங்கிய கவிஞர் யார்?"}],"options":[{"key":"A","text":"பாரதிதாசன்"},{"key":"B","text":"மகாகவி பாரதியார்"},{"key":"C","text":"நாமக்கல் கவிஞர்"},{"key":"D","text":"கவிமணி"}],"explanation":"குழந்தைகளின் எதிர்காலத்தை நிர்ணயிக்கும் பள்ளிக்கூடங்களை இறைவனின் திருக்கோயில்களாக மதித்துப் பாரதியார் பாடினார்."}}}
{"id":"b-tam-7t2-030","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 10"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சில நூல்கள் பூமிக்கு மேலே விளையும் காய் போன்றது; சில நூல்கள் பூமிக்கு அடியில் தோண்டி எடுக்கும் கிழங்கு போன்றது’ - இவ்வாறாகத் திருக்குறளார் எந்த வள்ளுவர் வாக்கிற்கு விளக்கம் தருகிறார்?"}],"options":[{"key":"A","text":"தொட்டனைத்து ஊறும் மணற்கேணி"},{"key":"B","text":"கற்க கசடறக் கற்பவை"},{"key":"C","text":"எப்பொருள் யார்யார்வாய்க் கேட்பினும்"},{"key":"D","text":"அறிவுடையார் ஆவ தறிவார்"}],"explanation":"நூல்களை ஆழ்ந்து ஆராய்ந்து அதன் உட்பொருளைத் தோண்டி அறிய வேண்டும் என்பதை விளக்கவே 'கற்க கசடற' என்பதற்கு இவ்வுவமையைக் கூறுகிறார்."}}}
{"id":"b-tam-7t2-031","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"3","C":"4","D":"1"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 10"},"texts":{"ta":{"blocks":[{"type":"text","text":"திருக்குறளார் வீ. முனிசாமியின் நூல்களைச் சரியாகப் பொருத்துக:"},{"type":"list","name":"நூல் வகை","items":[{"label":"A","text":"பாடப்பகுதி கட்டுரை"},{"label":"B","text":"நகைச்சுவை நூல்"},{"label":"C","text":"உரை நூல்"},{"label":"D","text":"வள்ளுவர் நெறி நூல்"}]},{"type":"list","name":"நூலின் பெயர்","items":[{"label":"1","text":"வள்ளுவர் காட்டிய வழி"},{"label":"2","text":"சிந்தனைக் களஞ்சியம்"},{"label":"3","text":"திருக்குறளில் நகைச்சுவை"},{"label":"4","text":"உலகப்பொதுமறை திருக்குறள் உரை விளக்கம்"}]}],"options":[{"key":"A","text":"A-2, B-3, C-4, D-1","mapping":{"A":"2","B":"3","C":"4","D":"1"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}}],"explanation":"பாடப்பகுதி = சிந்தனைக் களஞ்சியம்; நகைச்சுவை = திருக்குறளில் நகைச்சுவை; உரை = உலகப்பொதுமறை திருக்குறள் உரை விளக்கம்; நெறி = வள்ளுவர் உள்ளம், வள்ளுவர் காட்டிய வழி."}}}
{"id":"b-tam-7t2-032","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 11"},"texts":{"ta":{"blocks":[{"type":"text","text":"காலத்தின் அருமையைக் கூறும் திருக்குறள் அதிகாரம் எது?"}],"options":[{"key":"A","text":"கல்வி"},{"key":"B","text":"காலமறிதல்"},{"key":"C","text":"வினையறிதல்"},{"key":"D","text":"மடியின்மை"}],"explanation":"பாடநூல் மதிப்பீட்டு வினா: காலத்தின் அருமையைக் கூறும் அதிகாரம் காலமறிதல் ஆகும்."}}}
{"id":"b-tam-7t2-033","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 11"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘உயர்வடைவோம்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"உயர் + வடைவோம்"},{"key":"B","text":"உயர் + அடைவோம்"},{"key":"C","text":"உயர்வு + வடைவோம்"},{"key":"D","text":"உயர்வு + அடைவோம்"}],"explanation":"உயர்வு + அடைவோம் = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி வ் + அ = வ ஆகி 'உயர்வடைவோம்' எனப் புணரும்."}}}
{"id":"b-tam-7t2-034","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 11"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இவை + எல்லாம்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"இவைஎல்லாம்"},{"key":"B","text":"இவையெல்லாம்"},{"key":"C","text":"இதுயெல்லாம்"},{"key":"D","text":"இவயெல்லாம்"}],"explanation":"'இ ஈ ஐ வழி யவ்வும்' விதிப்படி உடம்படுமெய் ய் தோன்றி (ய் + எ = யெ), 'இவையெல்லாம்' எனப் புணரும்."}}}
// ==============================================================================
// பாடம் 4: பள்ளி மறுதிறப்பு (விரிவானம் / துணைப்பாடம் - சுப்ரபாரதிமணியன்) [Q035 - Q042]
// மதிவாணன் & கவின், பின்னலாடை நிறுவனம் (வயது 15 பொய்), அம்பேத்கர்/கலாம் பலகை, நல்லூர் பேருந்து முதியவர் அவமானம்,
// பள்ளி செல்ல முடிவு, சுப்ரபாரதிமணியன் (பின்னல், வேட்டை, தண்ணீர் யுத்தம், புத்துமண்), கனவு இதழ், தாவரங்களின் உரையாடல் பொருந்தாமை
// ==============================================================================
{"id":"b-tam-7t2-035","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 12"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பள்ளி மறுதிறப்பு’ கதையில் இடம்பெறும் முதன்மைக் கதாபாத்திரங்களான இரு நண்பர்கள் யார்?"}],"options":[{"key":"A","text":"வளவன், எழிலன்"},{"key":"B","text":"மதிவாணன், கவின்"},{"key":"C","text":"செழியன், இளமாறன்"},{"key":"D","text":"கண்ணன், மணி"}],"explanation":"கோடை விடுமுறையில் பின்னலாடை நிறுவனத்திற்கு வேலைக்குச் சென்ற மதிவாணன் மற்றும் கவின் ஆவர்."}}}
{"id":"b-tam-7t2-036","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 13"},"texts":{"ta":{"blocks":[{"type":"text","text":"பின்னலாடை நிறுவனத்தில் அதிகாரிகள் ஆய்வுக்கு வரும்போது குழந்தைத் தொழிலாளர்களை என்ன வயது சொல்லுமாறு முதலாளிகள் பணிக்கின்றனர்?"}],"options":[{"key":"A","text":"வயது பன்னிரண்டு"},{"key":"B","text":"வயது பதினைந்து"},{"key":"C","text":"வயது பதினெட்டு"},{"key":"D","text":"வயது பத்து"}],"explanation":"அதிகாரிகள் வந்தால் தங்களை மாட்டிக்கொள்ளாமல் இருக்க 'வயது பதினைந்து' என்று சொல்லுமாறு பழக்கினர்."}}}
{"id":"b-tam-7t2-037","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 13"},"texts":{"ta":{"blocks":[{"type":"text","text":"எதிரில் இருந்த விளம்பரப் பலகையில் தென்பட்ட யாருடைய உருவங்கள் மதிவாணனுக்குப் படிப்பே அடிப்படைத் தேவை என்பதை உணர்த்தின?"}],"options":[{"key":"A","text":"காந்தி, நேரு"},{"key":"B","text":"அம்பேத்கர், அப்துல் கலாம்"},{"key":"C","text":"பெரியார், அண்ணா"},{"key":"D","text":"காமராசர், வ.உ.சி."}],"explanation":"அம்பேத்கரும் அப்துல் கலாமும் விளம்பரப் பலகையில் இருந்தனர்; இவர்களைப் போல் உயர கல்வி வேண்டும் என மதிவாணன் சிந்தித்தான்."}}}
{"id":"b-tam-7t2-038","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 14"},"texts":{"ta":{"blocks":[{"type":"text","text":"பேருந்து நிறுத்தத்தில் நின்ற முதியவர் சிறுவர்களிடம் எந்த ஊருக்குப் பேருந்து செல்லுமா என்று வழி கேட்டார்?"}],"options":[{"key":"A","text":"பசும்பொன்"},{"key":"B","text":"நல்லூர்"},{"key":"C","text":"கமுதி"},{"key":"D","text":"சாயல்குடி"}],"explanation":"முதியவர் 'இது நல்லூர் போகுமா?' என்று பேருந்துப் பலகையைப் படிக்கத் தெரியாமல் கேட்டார்."}}}
{"id":"b-tam-7t2-039","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 14"},"texts":{"ta":{"blocks":[{"type":"text","text":"பேருந்துப் பலகையைப் படிக்கத் தெரியாத முதியவரைச் சிறுவர்கள் கேலி செய்ததைக் கண்டு மதிவாணன் எடுத்த உறுதி யாது?"}],"options":[{"key":"A","text":"பின்னலாடை நிறுவனத்திலேயே தொடர்ந்து வேலை செய்வது"},{"key":"B","text":"கல்வியறிவு இல்லாவிட்டால் வாழ்க்கை முழுவதும் அவமானப்பட வேண்டும்; நல்ல படிப்புதான் தலைநிமிர்ந்து நிற்க வைக்கும் எனப் பள்ளிக்குச் செல்ல முடிவெடுத்தான்"},{"key":"C","text":"முதியவருக்குப் பணம் கொடுப்பது"},{"key":"D","text":"ஊருக்குச் சென்றுவிடுவது"}],"explanation":"முதியவரின் அவமானம் மதிவாணனின் கண்களைத் திறந்தது; படிப்பே மனிதனை உயர்த்தும் என உணர்ந்து பள்ளிக்குச் சென்றான்."}}}
{"id":"pyq-tam-7t2-040","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":44},"texts":{"ta":{"blocks":[{"type":"text","text":"குழந்தைத் தொழிலாளர் முறை ஒழிப்பு மற்றும் இயற்கை வளப் பாதுகாப்பு ஆகிய கருத்துகளை வலியுறுத்திப் ‘பின்னல், வேட்டை, தண்ணீர் யுத்தம்’ உள்ளிட்ட நூல்களை எழுதியவர் யார்?"}],"options":[{"key":"A","text":"எஸ். ராமகிருஷ்ணன்"},{"key":"B","text":"சுப்ரபாரதிமணியன்"},{"key":"C","text":"மேலாண்மை பொன்னுச்சாமி"},{"key":"D","text":"கந்தர்வன்"}],"explanation":"இக்கதையின் ஆசிரியர் சுப்ரபாரதிமணியன் ஆவார்."}}}
{"id":"b-tam-7t2-041","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 14"},"texts":{"ta":{"blocks":[{"type":"text","text":"எழுத்தாளர் சுப்ரபாரதிமணியன் நடத்தி வரும் இலக்கிய இதழின் பெயர் யாது?"}],"options":[{"key":"A","text":"கொல்லிப்பாவை"},{"key":"B","text":"கனவு"},{"key":"C","text":"அன்னம் விடு தூது"},{"key":"D","text":"வானம்பாடி"}],"explanation":"சுப்ரபாரதிமணியன் 'கனவு' என்னும் இலக்கிய இதழை நடத்தி வருகிறார்."}}}
{"id":"b-tam-7t2-042","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 14"},"texts":{"ta":{"blocks":[{"type":"text","text":"சுப்ரபாரதிமணியன் இயற்றிய நூல்களுள் பொருந்தாத ஒன்றைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"பின்னல், வேட்டை"},{"key":"B","text":"தண்ணீர் யுத்தம், புத்துமண்"},{"key":"C","text":"கதை சொல்லும் கலை"},{"key":"D","text":"தாவரங்களின் உரையாடல்"}],"explanation":"'தாவரங்களின் உரையாடல்' என்பது எஸ். ராமகிருஷ்ணனின் சிறுகதைத் தொகுதி; மற்றவை சுப்ரபாரதிமணியனின் படைப்புகள்."}}}
