{"id": "b-tam-6t1-096", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 35"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘மாரி அல்லது காரியம் இல்லை’ என்று மழையின் சிறப்பைக் கூறும் நூல் எது?"}], "options": [{"key": "A", "text": "நாலடியார்"}, {"key": "B", "text": "கொன்றை வேந்தன்"}, {"key": "C", "text": "மூதுரை"}, {"key": "D", "text": "திருக்குறள்"}], "explanation": "பக்கம் 35 கட்டுரைக் குறிப்பில் 'மாரி அல்லது காரியம் இல்லை' என்று கொன்றை வேந்தன் குறிப்பிடுவதாகத் தரப்பட்டுள்ளது."}}}
{"id": "b-tam-6t1-097", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 36"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கபிலன் வேலை செய்ததால் களைப்பாக இருக்கிறான்’ - இத்தொடரை இரு தொடர்களாகப் பிரித்து எழுதினால் எவ்வாறு அமையும்?"}], "options": [{"key": "A", "text": "கபிலன் வேலை செய்தான். களைப்பாக இருக்கிறான்."}, {"key": "B", "text": "கபிலன் களைப்பாக இருக்கிறான். வேலை செய்தான்."}, {"key": "C", "text": "கபிலன் வேலை செய்யவில்லை. களைப்பாக இருக்கிறான்."}, {"key": "D", "text": "வேலை செய்ததால் கபிலன் களைப்புற்றான்."}], "explanation": "பாடநூல் மொழிப்பயிற்சி விதிப்படி: 'கபிலன் வேலை செய்தான். களைப்பாக இருக்கிறான்.' என இரண்டு தனித்தொடர்களாகப் பிரிக்க வேண்டும்."}}}
{"id": "b-tam-6t1-098", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 36"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பரந்து விரிந்து இருப்பதால் கடலுக்குப் ________ என்று பெயர்’ - சரியான மயங்கொலிச் சொல் எது?"}], "options": [{"key": "A", "text": "பறவை"}, {"key": "B", "text": "பரவை"}, {"key": "C", "text": "பறவைமை"}, {"key": "D", "text": "பரவு"}], "explanation": "பரந்து விரிந்து காணப்படுவதால் கடலுக்குப் 'பரவை' என்று பெயர். பறவை என்பது சிறகுடைய உயிரினத்தைக் குறிக்கும்."}}}
{"id": "b-tam-6t1-099", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 36"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘இலக்கிய மன்ற விழாவில் முகிலன் சிறப்பாக ________ ஆற்றினார்’ - பொருத்தமான சொல்லைத் தேர்க:"}], "options": [{"key": "A", "text": "உறை"}, {"key": "B", "text": "உரை"}, {"key": "C", "text": "உரசு"}, {"key": "D", "text": "உரைப்பு"}], "explanation": "பேச்சு நிகழ்த்துவதை 'உரை ஆற்றினார்' என்பர்; உறை என்பது மூடி அல்லது கடித உறை, தயிர் உறைதலைக் குறிக்கும்."}}}
{"id": "b-tam-6t1-100", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 36"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘முத்து தம் ________ காரணமாக ஊருக்குச் சென்றார்’ - சரியான சொல் எது?"}], "options": [{"key": "A", "text": "பனி"}, {"key": "B", "text": "பணி"}, {"key": "C", "text": "பணிவு"}, {"key": "D", "text": "பன்னல்"}], "explanation": "பணி என்றால் வேலை என்று பொருள். பனி என்பது குளிர்காலப் பனியைக் குறிக்கும்."}}}
{"id": "b-tam-6t1-101", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 36"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கலைமகள் தனது வீட்டுத் தோட்டத்தைப் பார்க்க வருமாறு தோழியை ________’ - சரியான விடை எது?"}], "options": [{"key": "A", "text": "அலைத்தாள்"}, {"key": "B", "text": "அழைத்தாள்"}, {"key": "C", "text": "அழைப்பு"}, {"key": "D", "text": "அலைந்தாள்"}], "explanation": "கூப்பிடுதலை 'அழைத்தாள்' என்பர். அலைத்தல் என்பது நீரலைத்தல் அல்லது அலைச்சலைக் குறிக்கும்."}}}
{"id": "b-tam-6t1-102", "kind": "match", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "3", "B": "1", "C": "4", "D": "2"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 37"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"}, {"type": "list", "name": "ஆங்கிலக் கலைச்சொல்", "items": [{"label": "A", "text": "Continent"}, {"label": "B", "text": "Climate"}, {"label": "C", "text": "Weather"}, {"label": "D", "text": "Migration"}]}, {"type": "list", "name": "தமிழாக்கம்", "items": [{"label": "1", "text": "தட்பவெப்பநிலை"}, {"label": "2", "text": "வலசை"}, {"label": "3", "text": "கண்டம்"}, {"label": "4", "text": "வானிலை"}]}], "options": [{"key": "A", "text": "A-3, B-1, C-4, D-2", "mapping": {"A": "3", "B": "1", "C": "4", "D": "2"}}, {"key": "B", "text": "A-1, B-3, C-2, D-4", "mapping": {"A": "1", "B": "3", "C": "2", "D": "4"}}, {"key": "C", "text": "A-3, B-4, C-1, D-2", "mapping": {"A": "3", "B": "4", "C": "1", "D": "2"}}, {"key": "D", "text": "A-2, B-1, C-4, D-3", "mapping": {"A": "2", "B": "1", "C": "4", "D": "3"}}], "explanation": "Continent = கண்டம், Climate = தட்பவெப்பநிலை, Weather = வானிலை, Migration = வலசை."}}}
{"id": "b-tam-6t1-103", "kind": "match", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "2", "B": "1"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 37"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கலைச்சொற்களைப் பொருத்துக:"}, {"type": "list", "name": "ஆங்கிலக் கலைச்சொல்", "items": [{"label": "A", "text": "Sanctuary"}, {"label": "B", "text": "Gravitational Field"}]}, {"type": "list", "name": "தமிழாக்கம்", "items": [{"label": "1", "text": "புவிஈர்ப்புப்புலம்"}, {"label": "2", "text": "புகலிடம்"}]}], "options": [{"key": "A", "text": "A-2, B-1", "mapping": {"A": "2", "B": "1"}}, {"key": "B", "text": "A-1, B-2", "mapping": {"A": "1", "B": "2"}}, {"key": "C", "text": "A-2, B-2", "mapping": {"A": "2", "B": "2"}}, {"key": "D", "text": "A-1, B-1", "mapping": {"A": "1", "B": "1"}}], "explanation": "Sanctuary = புகலிடம், Gravitational Field = புவிஈர்ப்புப்புலம்."}}}
