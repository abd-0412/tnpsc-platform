{"id": "b-tam-6t1-013", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 5"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘யாமறிந்த மொழிகளிலே தமிழ்மொழி போல் இனிதாவது எங்கும் காணோம்’ - என்று பாடியவர் யார்?"}], "options": [{"key": "A", "text": "பாரதிதாசன்"}, {"key": "B", "text": "பாரதியார்"}, {"key": "C", "text": "கவிமணி"}, {"key": "D", "text": "நாமக்கல் கவிஞர்"}], "explanation": "பல மொழிகள் கற்ற கவிஞர் பாரதியார் தமிழ்மொழியின் இனிமையை வியந்து இவ்வாறு பாடியுள்ளார்."}}}
{"id": "b-tam-6t1-014", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 5"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘என்று பிறந்தவள் என்று உணராத இயல்பினளாம் எங்கள் தாய்!’ - என்று பாரதியார் குறிப்பிட்டது எதனை?"}], "options": [{"key": "A", "text": "தமிழ்த்தாய்"}, {"key": "B", "text": "பாரதத்தாய்"}, {"key": "C", "text": "இயற்கைத் தாய்"}, {"key": "D", "text": "நிலமகள்"}], "explanation": "பாரதியார் பாரதத்தாயின் தொன்மையை உரைத்த போதிலும், அது தமிழ்த்தாயின் பழமைக்கும் பொருந்துவதாகப் பாடப்பகுதி விளக்குகிறது."}}}
{"id": "b-tam-6t1-015", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 5"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "வளர்தமிழ் பாடப்பகுதியின்படி உலகில் எத்தனைக்கும் மேற்பட்ட மொழிகள் உள்ளன?"}], "options": [{"key": "A", "text": "3000-க்கும் மேற்பட்ட"}, {"key": "B", "text": "5000-க்கும் மேற்பட்ட"}, {"key": "C", "text": "6000-க்கும் மேற்பட்ட"}, {"key": "D", "text": "8000-க்கும் மேற்பட்ட"}], "explanation": "உலகில் ஆறாயிரத்திற்கும் மேற்பட்ட மொழிகள் உள்ளன. அவற்றுள் சில மொழிகள் மட்டுமே பேச்சு மற்றும் எழுத்து வடிவம் இரண்டையும் பெற்றுள்ளன."}}}
{"id": "b-tam-6t1-016", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 5"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தமிழில் நமக்குக் கிடைத்துள்ள மிகப்பழமையான இலக்கண நூல் எது?"}], "options": [{"key": "A", "text": "நன்னூல்"}, {"key": "B", "text": "தொல்காப்பியம்"}, {"key": "C", "text": "அகத்தியம்"}, {"key": "D", "text": "வீரசோழியம்"}], "explanation": "தமிழில் நமக்குக் கிடைத்துள்ள மிகப் பழமையான இலக்கண நூல் தொல்காப்பியம் ஆகும்."}}}
{"id": "pyq-tam-6t1-017", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "3", "B": "1", "C": "2"}}, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 25}, "texts": {"ta": {"blocks": [{"type": "text", "text": "சொல் முதன்முதலில் ஆளப்படும் இலக்கிய நூல்களைச் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "பட்டியல் I (சொல்)", "items": [{"label": "A", "text": "தமிழ்"}, {"label": "B", "text": "தமிழ்நாடு"}, {"label": "C", "text": "தமிழன்"}]}, {"type": "list", "name": "பட்டியல் II (இலக்கியம்)", "items": [{"label": "1", "text": "சிலப்பதிகாரம் (வஞ்சிக்காண்டம்)"}, {"label": "2", "text": "அப்பர் தேவாரம்"}, {"label": "3", "text": "தொல்காப்பியம்"}]}], "options": [{"key": "A", "text": "A-3, B-1, C-2", "mapping": {"A": "3", "B": "1", "C": "2"}}, {"key": "B", "text": "A-1, B-2, C-3", "mapping": {"A": "1", "B": "2", "C": "3"}}, {"key": "C", "text": "A-3, B-2, C-1", "mapping": {"A": "3", "B": "2", "C": "1"}}, {"key": "D", "text": "A-2, B-1, C-3", "mapping": {"A": "2", "B": "1", "C": "3"}}], "explanation": "தமிழ் - தொல்காப்பியம்; தமிழ்நாடு - சிலப்பதிகாரம் வஞ்சிக்காண்டம்; தமிழன் - அப்பர் தேவாரம்."}}}
{"id": "b-tam-6t1-018", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 6"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘இமிழ்கடல் வேலியைத் தமிழ்நாடு ஆக்கிய இதுநீ கருதினை ஆயின்’ - என்ற வரிகள் இடம்பெற்றுள்ள காப்பியம் எது?"}], "options": [{"key": "A", "text": "மணிமேகலை"}, {"key": "B", "text": "சிலப்பதிகாரம்"}, {"key": "C", "text": "சீவக சிந்தாமணி"}, {"key": "D", "text": "குண்டலகேசி"}], "explanation": "சிலப்பதிகாரத்தின் வஞ்சிக்காண்டத்தில் (வஞ்சி : 165) தமிழ்நாடு என்ற சொல் முதன்முதலில் ஆளப்பட்டுள்ளது."}}}
{"id": "b-tam-6t1-019", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 6"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘... தமிழன் கண்டாய்’ - என்ற மேற்கோள் வரி இடம்பெற்றுள்ள நூல் எது?"}], "options": [{"key": "A", "text": "திருவாசகம்"}, {"key": "B", "text": "தொல்காப்பியம்"}, {"key": "C", "text": "அப்பர் தேவாரம்"}, {"key": "D", "text": "நாலாயிரத் திவ்வியப் பிரபந்தம்"}], "explanation": "திருநாவுக்கரசர் (அப்பர்) பாடிய தேவாரத் திருத்தாண்டகத்தில் (பாடல் 23) 'தமிழன் கண்டாய்' என்று குறிப்பிடப்பட்டுள்ளது."}}}
{"id": "b-tam-6t1-020", "kind": "statements", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": false, "II": true, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 6"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தமிழ் எழுத்துகளின் எழுதும் முறை குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "தமிழ் எழுத்துகள் பெரும்பாலும் இடஞ்சுழி எழுத்துகளாகவே அமைந்துள்ளன."}, {"type": "statement", "label": "II", "text": "அ, எ, ஔ, ண, ஞ ஆகியவை வலஞ்சுழி எழுத்துகள் ஆகும்."}, {"type": "statement", "label": "III", "text": "ட, ய, ழ ஆகியவை இடஞ்சுழி எழுத்துகள் ஆகும்."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "C", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "தமிழ் எழுத்துகள் பெரும்பாலும் 'வலஞ்சுழி' எழுத்துகளாகவே அமைந்துள்ளன. எனவே கூற்று I தவறானது."}}}
{"id": "b-tam-6t1-021", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 6"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "உயர்திணையின் எதிர்ச்சொல்லைத் தாழ்திணை என்று கூறாமல் ‘அஃறிணை’ என்று பெயரிட்டனர். அஃறிணை என்பதன் சரியான பிரிப்பு யாது?"}], "options": [{"key": "A", "text": "அஃது + திணை"}, {"key": "B", "text": "அல் + திணை"}, {"key": "C", "text": "அக + திணை"}, {"key": "D", "text": "அருமை + திணை"}], "explanation": "அல் + திணை = அஃறிணை (உயர்வு அல்லாத திணை). சீர்மை மிக்க சொல்மரபுக்கு இது சிறந்த சான்றாகும்."}}}
{"id": "b-tam-6t1-022", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 6"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பாகற்காய் என்னும் சொல் எவ்வவாறு பொருள் நயத்தோடு பிரித்துப் பெயரிடப்பட்டுள்ளது?"}], "options": [{"key": "A", "text": "பாகர் + காய்"}, {"key": "B", "text": "பாகு + அல் + காய்"}, {"key": "C", "text": "பாகு + காய்"}, {"key": "D", "text": "பாகன் + அல் + காய்"}], "explanation": "கசப்புச் சுவையுடைய காயைக் கசப்புக்காய் எனக் கூறாமல், இனிப்பு அல்லாத காய் எனப் பொருள் தரும்படி 'பாகு + அல் + காய் = பாகற்காய்' எனப் பெயரிட்டனர்."}}}
{"id": "b-tam-6t1-023", "kind": "arrange", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "arrange", "order": ["I", "III", "II", "V", "IV", "VII", "VI"]}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 7"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பூவின் தோற்றம் முதல் உதிர்தல் வரையிலான ஏழு நிலைகளைச் சரியான காலவரிசைப்படி ஒழுங்குபடுத்துக:"}, {"type": "list", "name": "பூவின் நிலைகள்", "items": [{"label": "I", "text": "அரும்பு"}, {"label": "II", "text": "முகை"}, {"label": "III", "text": "மொட்டு"}, {"label": "IV", "text": "அலர்"}, {"label": "V", "text": "மலர்"}, {"label": "VI", "text": "செம்மல்"}, {"label": "VII", "text": "வீ"}]}], "options": [{"key": "A", "text": "I, III, II, V, IV, VII, VI", "sequence": ["I", "III", "II", "V", "IV", "VII", "VI"]}, {"key": "B", "text": "I, II, III, V, IV, VI, VII", "sequence": ["I", "II", "III", "V", "IV", "VI", "VII"]}, {"key": "C", "text": "III, I, II, IV, V, VII, VI", "sequence": ["III", "I", "II", "IV", "V", "VII", "VI"]}, {"key": "D", "text": "I, III, II, IV, V, VII, VI", "sequence": ["I", "III", "II", "IV", "V", "VII", "VI"]}], "explanation": "பூவின் 7 நிலைகள்: அரும்பு (தோற்றம்) -> மொட்டு -> முகை -> மலர் -> அலர் (மலர் விரிந்த நிலை) -> வீ (கீழே விழுந்த நிலை) -> செம்மல் (வாடிய நிலை)."}}}
{"id": "pyq-tam-6t1-024", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": true, "source": {"type": "past_paper", "exam": "g4", "year": 2018, "paper": "tamil", "no": 33}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘மா’ என்னும் ஓரெழுத்து ஒருமொழி தரும் பொருள்களுள் தவறான ஒன்றைத் தேர்வு செய்க:"}], "options": [{"key": "A", "text": "பெரிய, திருமகள்"}, {"key": "B", "text": "அழகு, அறிவு"}, {"key": "C", "text": "அளவு, அழைத்தல், துகள்"}, {"key": "D", "text": "வானம், நிலவு"}], "explanation": "'மா' என்பதற்கு மரம், விலங்கு, பெரிய, திருமகள், அழகு, அறிவு, அளவு, அழைத்தல், துகள், மேன்மை, வயல், வண்டு போன்ற பொருள்கள் உண்டு; வானம், நிலவு என்பது தவறானது."}}}
{"id": "b-tam-6t1-025", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "2", "B": "1", "C": "4", "D": "3"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 7"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தாவரங்களின் இலைப்பெயர்களைச் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "தாவரம்", "items": [{"label": "A", "text": "நெல், வரகு"}, {"label": "B", "text": "கரும்பு, நாணல்"}, {"label": "C", "text": "பனை, தென்னை"}, {"label": "D", "text": "கமுகு (பாக்கு)"}]}, {"type": "list", "name": "இலைப்பெயர்", "items": [{"label": "1", "text": "தோகை"}, {"label": "2", "text": "தாள்"}, {"label": "3", "text": "கூந்தல்"}, {"label": "4", "text": "ஓலை"}]}], "options": [{"key": "A", "text": "A-2, B-1, C-4, D-3", "mapping": {"A": "2", "B": "1", "C": "4", "D": "3"}}, {"key": "B", "text": "A-1, B-2, C-3, D-4", "mapping": {"A": "1", "B": "2", "C": "3", "D": "4"}}, {"key": "C", "text": "A-2, B-4, C-1, D-3", "mapping": {"A": "2", "B": "4", "C": "1", "D": "3"}}, {"key": "D", "text": "A-3, B-1, C-4, D-2", "mapping": {"A": "3", "B": "1", "C": "4", "D": "2"}}], "explanation": "நெல்/வரகு = தாள்; கரும்பு/நாணல் = தோகை; பனை/தென்னை = ஓலை; கமுகு = கூந்தல்; சப்பாத்திக்கள்ளி/தாழை = மடல்; அருகு/கோரை = புல்; மல்லி = தழை."}}}
{"id": "b-tam-6t1-026", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 7"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "சப்பாத்திக்கள்ளி, தாழை ஆகியவற்றின் இலைப்பெயர் எவ்வாறு அழைக்கப்படுகிறது?"}], "options": [{"key": "A", "text": "தோகை"}, {"key": "B", "text": "ஓலை"}, {"key": "C", "text": "மடல்"}, {"key": "D", "text": "கூந்தல்"}], "explanation": "சப்பாத்திக்கள்ளி மற்றும் தாழையின் இலைகளை 'மடல்' என்று அழைப்பர்."}}}
{"id": "b-tam-6t1-027", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 8"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தமிழ் எண்களில் ‘அ’ மற்றும் ‘கூ’ குறிக்கும் எண்கள் முறையே எவை?"}], "options": [{"key": "A", "text": "7 மற்றும் 8"}, {"key": "B", "text": "8 மற்றும் 9"}, {"key": "C", "text": "6 மற்றும் 8"}, {"key": "D", "text": "8 மற்றும் 10"}], "explanation": "1-க, 2-உ, 3-ங, 4-ச, 5-ரு, 6-சா, 7-எ, 8-அ, 9-கூ, 10-க0. எனவே 'அ' என்பது 8, 'கூ' என்பது 9."}}}
{"id": "extra-tam-6t1-028", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "other", "note": "செம்மொழி தகுதி கூடுதல் வினா"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தமிழ்மொழி இந்திய அரசால் அதிகாரப்பூர்வமாகச் செம்மொழியாக அறிவிக்கப்பட்ட ஆண்டு எது?"}], "options": [{"key": "A", "text": "2002"}, {"key": "B", "text": "2003"}, {"key": "C", "text": "2004"}, {"key": "D", "text": "2005"}], "explanation": "தமிழ் மொழி 2004-ஆம் ஆண்டு நடுவண் அரசால் முதல் செம்மொழியாக அறிவிக்கப்பட்டது."}}}
{"id": "b-tam-6t1-029", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 9"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘வானம் தீண்டும் தூரம் நீ வளர்ந்து வாழ வேண்டும்! சர்க்கரைத் தமிழ் அள்ளி தாலாட்டு நாள் சொல்லி வாழ்த்துகிறோம்!’ - என்ற பிறந்தநாள் வாழ்த்துப் பாடலை இயற்றியவர் யார்?"}], "options": [{"key": "A", "text": "பாரதிதாசன்"}, {"key": "B", "text": "கவிஞர் அறிவுமதி"}, {"key": "C", "text": "கவிஞர் வைரமுத்து"}, {"key": "D", "text": "கவிஞர் கண்ணதாசன்"}], "explanation": "இயல் 1 கற்பவை கற்றபின் பகுதியில் அமைந்த பிறந்தநாள் வாழ்த்துப் பாடலை இயற்றியவர் கவிஞர் அறிவுமதி."}}}
{"id": "b-tam-6t1-030", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 9"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘தொன்மை’ என்னும் சொல்லின் பொருள் யாது?"}], "options": [{"key": "A", "text": "புதுமை"}, {"key": "B", "text": "பழமை"}, {"key": "C", "text": "பெருமை"}, {"key": "D", "text": "சீர்மை"}], "explanation": "தொன்மை என்னும் சொல்லின் பொருள் பழமை ஆகும்."}}}
{"id": "b-tam-6t1-031", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 9"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘சீரிளமை’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}], "options": [{"key": "A", "text": "சிறு + இளமை"}, {"key": "B", "text": "சீர்மை + இளமை"}, {"key": "C", "text": "சீரி + இளமை"}, {"key": "D", "text": "சீற் + இளமை"}], "explanation": "சீர்மை + இளமை = ஈறுபோதல் விதிப்படி 'மை' கெட்டு, சீரிளமை எனப் புணரும்."}}}
