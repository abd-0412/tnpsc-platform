{"id": "b-tam-6t1-038", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 14"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தமிழ் மொழியின் இலக்கண வகைகள் மொத்தம் எத்தனை?"}], "options": [{"key": "A", "text": "மூன்று"}, {"key": "B", "text": "நான்கு"}, {"key": "C", "text": "ஐந்து"}, {"key": "D", "text": "ஆறு"}], "explanation": "தமிழ் மொழியின் இலக்கண வகைகள் ஐந்து: எழுத்து, சொல், பொருள், யாப்பு, அணி."}}}
{"id": "b-tam-6t1-039", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 14"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஒலி வடிவமாக எழுப்பப்படுவதும் வரிவடிவமாக எழுதப்படுவதும் எவ்வாறு அழைக்கப்படுகிறது?"}], "options": [{"key": "A", "text": "சொல்"}, {"key": "B", "text": "எழுத்து"}, {"key": "C", "text": "பொருள்"}, {"key": "D", "text": "யாப்பு"}], "explanation": "ஒலி வடிவமாக எழுப்பப்படுவதும் வரிவடிவமாக எழுதப்படுவதும் எழுத்து எனப்படுகிறது."}}}
{"id": "b-tam-6t1-040", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 14, 15"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "உயிர் எழுத்துகளில் குறில் மற்றும் நெடில் எழுத்துகளின் எண்ணிக்கை முறையே எவை?"}], "options": [{"key": "A", "text": "5 மற்றும் 7"}, {"key": "B", "text": "7 மற்றும் 5"}, {"key": "C", "text": "6 மற்றும் 6"}, {"key": "D", "text": "5 மற்றும் 8"}], "explanation": "அ, இ, உ, எ, ஒ ஆகிய ஐந்தும் குறில் எழுத்துகள்; ஆ, ஈ, ஊ, ஏ, ஐ, ஓ, ஔ ஆகிய ஏழும் நெடில் எழுத்துகள்."}}}
{"id": "pyq-tam-6t1-041", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 41}, "texts": {"ta": {"blocks": [{"type": "text", "text": "இலக்கணத்தில் 'மாத்திரை' என்பது எதனைக் குறிக்கும் அளவாகும்?"}], "options": [{"key": "A", "text": "எழுத்துகளை உச்சரிக்கும் கால அளவு"}, {"key": "B", "text": "எழுத்துகளின் வரிவடிவ அளவு"}, {"key": "C", "text": "எழுத்துகளின் ஒலிப்பு விசை"}, {"key": "D", "text": "சொற்களின் நீள அளவு"}], "explanation": "மாத்திரை என்பது இங்குக் கால அளவைக் குறிக்கிறது. ஒருமுறை கண் இமைக்கவோ கைநொடிக்கவோ ஆகும் கால அளவு ஒரு மாத்திரை."}}}
{"id": "b-tam-6t1-042", "kind": "match", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "2", "B": "1", "C": "3", "D": "3"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 15, 16"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "எழுத்துகளையும் அவற்றின் மாத்திரை அளவுகளையும் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "எழுத்து வகை", "items": [{"label": "A", "text": "குறில் எழுத்து"}, {"label": "B", "text": "நெடில் எழுத்து"}, {"label": "C", "text": "மெய் எழுத்து"}, {"label": "D", "text": "ஆய்த எழுத்து"}]}, {"type": "list", "name": "மாத்திரை அளவு", "items": [{"label": "1", "text": "இரண்டு மாத்திரை"}, {"label": "2", "text": "ஒரு மாத்திரை"}, {"label": "3", "text": "அரை மாத்திரை"}, {"label": "4", "text": "கால் மாத்திரை"}]}], "options": [{"key": "A", "text": "A-2, B-1, C-3, D-3", "mapping": {"A": "2", "B": "1", "C": "3", "D": "3"}}, {"key": "B", "text": "A-1, B-2, C-3, D-3", "mapping": {"A": "1", "B": "2", "C": "3", "D": "3"}}, {"key": "C", "text": "A-2, B-1, C-4, D-3", "mapping": {"A": "2", "B": "1", "C": "4", "D": "3"}}, {"key": "D", "text": "A-1, B-2, C-4, D-3", "mapping": {"A": "1", "B": "2", "C": "4", "D": "3"}}], "explanation": "குறில் = 1 மாத்திரை, நெடில் = 2 மாத்திரை, மெய் = அரை மாத்திரை, ஆய்தம் = அரை மாத்திரை."}}}
{"id": "b-tam-6t1-043", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 15"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "வன்மையாகவும் இல்லாமல், மென்மையாகவும் இல்லாமல் இரண்டிற்கும் இடைப்பட்டு ஒலிக்கும் 'இடையின' மெய்யெழுத்துகள் எவை?"}], "options": [{"key": "A", "text": "க், ச், ட், த், ப், ற்"}, {"key": "B", "text": "ங், ஞ், ண், ந், ம், ன்"}, {"key": "C", "text": "ய், ர், ல், வ், ழ், ள்"}, {"key": "D", "text": "க், ங், ச், ஞ், ட், ண்"}], "explanation": "ய், ர், ல், வ், ழ், ள் ஆகிய ஆறும் வன்மையாகவும் மென்மையாகவும் இல்லாமல் இடைப்பட்டு ஒலிப்பதால் இடையினம் எனப்படும்."}}}
{"id": "b-tam-6t1-044", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 16"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "மெய் எழுத்துகள் பதினெட்டுடன் உயிர் எழுத்துகள் பன்னிரண்டும் சேர்வதால் தோன்றும் உயிர்மெய் எழுத்துகளின் மொத்த எண்ணிக்கை யாது?"}], "options": [{"key": "A", "text": "30 எழுத்துகள்"}, {"key": "B", "text": "216 எழுத்துகள்"}, {"key": "C", "text": "247 எழுத்துகள்"}, {"key": "D", "text": "108 எழுத்துகள்"}], "explanation": "18 x 12 = 216 உயிர்மெய் எழுத்துகள் தோன்றுகின்றன."}}}
{"id": "pyq-tam-6t1-045", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 47}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கபிலர்’ என்னும் சொல்லிற்குரிய மொத்த மாத்திரை அளவு யாது?"}], "options": [{"key": "A", "text": "4 மாத்திரை"}, {"key": "B", "text": "3 மாத்திரை"}, {"key": "C", "text": "3.5 மாத்திரை"}, {"key": "D", "text": "2.5 மாத்திரை"}], "explanation": "க (குறில் = 1) + பி (குறில் = 1) + ல (குறில் = 1) + ர் (மெய் = 0.5) = 1 + 1 + 1 + 0.5 = 3.5 மாத்திரை."}}}
{"id": "b-tam-6t1-046", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 16"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பாடநூல் மதிப்பீட்டின்படி, ஆய்த எழுத்து இடம்பெறும் இரண்டரை (2½) மாத்திரை அளவுள்ள சொல்லுக்குச் சரியான எடுத்துக்காட்டு எது?"}], "options": [{"key": "A", "text": "அஃது"}, {"key": "B", "text": "எஃகு"}, {"key": "C", "text": "அஃறிணை"}, {"key": "D", "text": "கஃசு"}], "explanation": "எ (குறில் = 1) + ஃ (ஆய்தம் = 0.5) + கு (குறில் = 1) = 2.5 மாத்திரை."}}}
{"id": "b-tam-6t1-047", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 16"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "இரண்டு மாத்திரை அளவு கொண்ட ஓரெழுத்துச் சொல்லுக்கு எடுத்துக்காட்டு எது?"}], "options": [{"key": "A", "text": "அ"}, {"key": "B", "text": "தீ"}, {"key": "C", "text": "க்"}, {"key": "D", "text": "ஃ"}], "explanation": "நெடில் எழுத்துகள் தனித்து நிற்கும் போது இரண்டு மாத்திரை பெறும். (எ.கா: தீ, பூ, கை, மா)."}}}
