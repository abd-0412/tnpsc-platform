// ==============================================================================
// 6-ஆம் வகுப்பு தமிழ் - பருவம் 2 - இயல் 2: வணிகம் / தொழில் / உழைப்பு (மொத்த வினாக்கள்: 82)
// ==============================================================================

// ==============================================================================
// பாடம் 1: நானிலம் படைத்தவன் (கவிதைப்பேழை - முடியரசன்) [Q073 - Q084]
// கல்லெடுத்து முள்ளெடுத்து, மல்லெடுத்த/சமர்/கழனி, ஏலம் மிளகு, முடியரசன் (துரைராசு),
// திராவிட நாட்டின் வானம்பாடி, பூங்கொடி/வீரகாவியம்/காவியப்பாவை, பாரதியார் பாடல், புணர்ச்சி
// ==============================================================================
{"id": "b-tam-6t2-073", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 26"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கல்லெடுத்து முள்ளெடுத்துக் காட்டுப் பெருவெளியை மல்லெடுத்த திண்தோள் மறத்தால் வளப்படுத்தி...’ - இவ்வடிகளை இயற்றிய பாவலர் யார்?"}], "options": [{"key": "A", "text": "பாரதிதாசன்"}, {"key": "B", "text": "முடியரசன்"}, {"key": "C", "text": "பட்டுக்கோட்டை கல்யாணசுந்தரம்"}, {"key": "D", "text": "பெருஞ்சித்திரனார்"}], "explanation": "இயல் 2 கவிதைப்பேழையான 'நானிலம் படைத்தவன்' என்னும் பாடலை இயற்றியவர் முடியரசன் ஆவார்."}}}
{"id": "b-tam-6t2-074", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "3", "B": "1", "C": "4", "D": "2"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 26"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘நானிலம் படைத்தவன்’ பாடலில் இடம்பெற்றுள்ள அரும்பதங்களை அவற்றின் பொருள்களோடு சரியாகப் பொருத்துக:"}, {"type": "list", "name": "சொல்", "items": [{"label": "A", "text": "மல்லெடுத்த"}, {"label": "B", "text": "சமர்"}, {"label": "C", "text": "கழனி"}, {"label": "D", "text": "எக்களிப்பு"}]}, {"type": "list", "name": "பொருள்", "items": [{"label": "1", "text": "போர்"}, {"label": "2", "text": "பெருமகிழ்ச்சி"}, {"label": "3", "text": "வலிமைபெற்ற"}, {"label": "4", "text": "வயல்"}]}], "options": [{"key": "A", "text": "A-3, B-1, C-4, D-2", "mapping": {"A": "3", "B": "1", "C": "4", "D": "2"}}, {"key": "B", "text": "A-1, B-3, C-2, D-4", "mapping": {"A": "1", "B": "3", "C": "2", "D": "4"}}, {"key": "C", "text": "A-3, B-4, C-1, D-2", "mapping": {"A": "3", "B": "4", "C": "1", "D": "2"}}, {"key": "D", "text": "A-4, B-1, C-2, D-3", "mapping": {"A": "4", "B": "1", "C": "2", "D": "3"}}], "explanation": "மல்லெடுத்த = வலிமைபெற்ற; சமர் = போர்; கழனி = வயல்; மறம் = வீரம்; எக்களிப்பு = பெருமகிழ்ச்சி; கலம் = கப்பல்; ஆழி = கடல்; நல்கும் = தரும்."}}}
{"id": "b-tam-6t2-075", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 26"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘மாநிலத்தில் முல்லை மருதம் குறிஞ்சி நெய்தல் நானிலத்தைக் கண்டபெரும் நாகரிக மாந்தன்அவன்’ - இப்பாடல் வரியில் தமிழன் எவற்றைத் தோணிக்குள் ஏற்றி உலகெங்கும் வணிகம் செய்ததாகக் குறிப்பிடப்படுகிறது?"}], "options": [{"key": "A", "text": "நெல், கரும்பு"}, {"key": "B", "text": "பட்டு, பருத்தி"}, {"key": "C", "text": "ஏலம், மிளகு"}, {"key": "D", "text": "சந்தனம், இஞ்சி"}], "explanation": "'எக்களிப்பு மீதூர ஏலம் மிளகுமுதல் பண்டங்கள் ஏற்றிப் பயன்நல்கும் வாணிகத்தால் கண்டங்கள் சுற்றிக் கலமேறி வந்தவன் தமிழன்' எனக் கவிஞர் குறிப்பிடுகிறார்."}}}
{"id": "b-tam-6t2-076", "kind": "assertion_reason", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "assertion_reason", "a_true": true, "r_true": true, "r_explains_a": true}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 26, 27"}, "texts": {"ta": {"blocks": [{"type": "assertion", "text": "பழந்தமிழன் அஞ்சாமை மிக்கவனாக இருந்தபோதிலும் ஒரு குறிப்பிட்ட செயலுக்கு மட்டும் அஞ்சி ஒதுங்கினான்."}, {"type": "reason", "text": "சான்றோர்கள் அஞ்சுகின்ற தீமைகளைச் செய்வதற்கு அஞ்சி, அத்தீமைகளைத் தன் வாழ்விலிருந்து அகற்றி விலக்கிடுவான்."}], "options": [{"key": "A", "text": "(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்", "semantic": "both_true_explains"}, {"key": "B", "text": "(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல", "semantic": "both_true_not_explains"}, {"key": "C", "text": "(A) சரி ஆனால் (R) தவறு", "semantic": "a_true_r_false"}, {"key": "D", "text": "(A) தவறு ஆனால் (R) சரி", "semantic": "a_false_r_true"}], "explanation": "'அஞ்சாமை மிக்கவன்தான் ஆனாலும் சான்றோர்கள் அஞ்சுவதை அஞ்சி அகற்றி விலக்கிடுவான்' என்று பாடல் வரிகள் தெளிவுபடுத்துகின்றன."}}}
{"id": "pyq-tam-6t2-077", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 32}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கவிஞர் முடியரசனின் இயற்பெயர் யாது?"}], "options": [{"key": "A", "text": "சுப்புரத்தினம்"}, {"key": "B", "text": "அரவிந்தன்"}, {"key": "C", "text": "துரைராசு"}, {"key": "D", "text": "மாணிக்கம்"}], "explanation": "முடியரசனின் இயற்பெயர் துரைராசு ஆகும்."}}}
{"id": "pyq-tam-6t2-078", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 45}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘திராவிட நாட்டின் வானம்பாடி’ என்று பாராட்டப்பெற்ற கவிஞர் யார்?"}], "options": [{"key": "A", "text": "பாரதிதாசன்"}, {"key": "B", "text": "முடியரசன்"}, {"key": "C", "text": "வாணிதாசன்"}, {"key": "D", "text": "கண்ணதாசன்"}], "explanation": "கவிஞர் முடியரசன் 'திராவிட நாட்டின் வானம்பாடி' என்று அறிஞர் அண்ணாவால் பாராட்டப்பெற்றவர்."}}}
{"id": "b-tam-6t2-079", "kind": "statements", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 27"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கவிஞர் முடியரசன் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "இவர் பூங்கொடி, வீரகாவியம், காவியப்பாவை முதலிய சிறந்த நூல்களை எழுதியுள்ளார்."}, {"type": "statement", "label": "II", "text": "பாடப்பகுதியில் அமைந்துள்ள 'நானிலம் படைத்தவன்' பாடல் 'புதியதொரு விதி செய்வோம்' என்னும் நூலில் இடம்பெற்றுள்ளது."}, {"type": "statement", "label": "III", "text": "இவர் 'திராவிட நாட்டின் வானம்பாடி' எனப் போற்றப்படுகிறார்."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "C", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "நூல் வெளி குறிப்பின்படி இம்மூன்று தகவல்களும் முற்றிலும் சரியானவை."}}}
{"id": "b-tam-6t2-080", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 27"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கங்கை நதிப்புறத்துக் கோதுமைப் பண்டம் காவிரி வெற்றிலைக்கு மாறு கொள்ளுவோம்’ - என்று பண்டமாற்று வணிகத்தை அழகாகப் பாடிய கவிஞர் யார்?"}], "options": [{"key": "A", "text": "மகாகவி பாரதியார்"}, {"key": "B", "text": "பாரதிதாசன்"}, {"key": "C", "text": "முடியரசன்"}, {"key": "D", "text": "நாமக்கல் கவிஞர்"}], "explanation": "பக்கம் 27 கற்பவை கற்றபின் பகுதியில் அமைந்த 'வெள்ளிப் பனிமலையின் மீதுலாவுவோம்...' என்ற பாடலைப் பாடியவர் மகாகவி பாரதியார்."}}}
{"id": "b-tam-6t2-081", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 28"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘நானிலம்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}], "options": [{"key": "A", "text": "நா + னிலம்"}, {"key": "B", "text": "நான்கு + நிலம்"}, {"key": "C", "text": "நா + நிலம்"}, {"key": "D", "text": "நான் + நிலம்"}], "explanation": "நான்கு + நிலம் = நானிலம் (எண்ணுப்பெயர்ப் புணர்ச்சி விதிப்படி 'கு' கெட்டு, முதலெழுத்து நீண்டு நானிலம் எனப் புணரும்)."}}}
{"id": "b-tam-6t2-082", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 28"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘நாடு + என்ற’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}], "options": [{"key": "A", "text": "நாடென்ற"}, {"key": "B", "text": "நாடன்ற"}, {"key": "C", "text": "நாடுஎன்ற"}, {"key": "D", "text": "நாடுஅன்ற"}], "explanation": "உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'டு' விலுள்ள உ கெட்டு, ட் + ஏ = டே ஆகி 'நாடென்ற' எனப் புணரும்."}}}
{"id": "b-tam-6t2-083", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "D", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 28"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கலம் + ஏறி’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}], "options": [{"key": "A", "text": "கலம்ஏறி"}, {"key": "B", "text": "கலமறி"}, {"key": "C", "text": "கலன்ஏறி"}, {"key": "D", "text": "கலமேறி"}], "explanation": "உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி (ம் + ஏ = மே) கலமேறி எனப் புணரும்."}}}
{"id": "b-tam-6t2-084", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 28"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "போர்க்களத்தில் வெளிப்படும் சுவை அல்லது குணம் எது?"}], "options": [{"key": "A", "text": "மகிழ்ச்சி"}, {"key": "B", "text": "துன்பம்"}, {"key": "C", "text": "வீரம் (மறம்)"}, {"key": "D", "text": "அழுகை"}], "explanation": "போர்க்களத்தில் வெளிப்படும் வீரமே 'மறம்' எனப்படும்."}}}

// ==============================================================================
// பாடம் 2: கடலோடு விளையாடு (நாட்டுப்புறப் பாடல் / நெய்தல் திணை) [Q085 - Q094]
// விடிவெள்ளி/பஞ்சுமெத்தை/புயல்/போர்வை உவமைகள், விரிகடல்/கட்டுமரம்/அரிச்சுவடி,
// நெய்தல் திணை விளக்கம், சு. சக்திவேல் (நாட்டுப்புற இயல் ஆய்வு), புணர்ச்சி
// ==============================================================================
{"id": "b-tam-6t2-085", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "4", "B": "1", "C": "2", "D": "3"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 29, 31"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கடலோடு விளையாடு’ பாடலில் மீனவர்கள் தங்களின் வாழ்வியலோடு தொடர்புபடுத்தும் இயற்கை உருவகங்களைச் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "இயற்கைக் கூறு", "items": [{"label": "A", "text": "விடிவெள்ளி"}, {"label": "B", "text": "வெண்மணல்"}, {"label": "C", "text": "பாயும்புயல்"}, {"label": "D", "text": "பனிமூட்டம்"}]}, {"type": "list", "name": "மீனவர் உவமை", "items": [{"label": "1", "text": "பஞ்சுமெத்தை"}, {"label": "2", "text": "ஊஞ்சல்"}, {"label": "3", "text": "உடல்போர்வை"}, {"label": "4", "text": "விளக்கு"}]}], "options": [{"key": "A", "text": "A-4, B-1, C-2, D-3", "mapping": {"A": "4", "B": "1", "C": "2", "D": "3"}}, {"key": "B", "text": "A-1, B-4, C-2, D-3", "mapping": {"A": "1", "B": "4", "C": "2", "D": "3"}}, {"key": "C", "text": "A-4, B-2, C-1, D-3", "mapping": {"A": "4", "B": "2", "C": "1", "D": "3"}}, {"key": "D", "text": "A-3, B-1, C-2, D-4", "mapping": {"A": "3", "B": "1", "C": "2", "D": "4"}}], "explanation": "விடிவெள்ளி = விளக்கு; மணல் = பஞ்சுமெத்தை; புயல் = ஊஞ்சல்; பனிமூட்டம் = போர்வை."}}}
{"id": "b-tam-6t2-086", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "2", "B": "4", "C": "1", "D": "3"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 29, 30"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "மீனவர்களின் பிற வாழ்வியல் உவமைகளைச் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "இயற்கை", "items": [{"label": "A", "text": "விரிகடல்"}, {"label": "B", "text": "கட்டுமரம்"}, {"label": "C", "text": "மின்னல் வரி"}, {"label": "D", "text": "முழுநிலவு"}]}, {"type": "list", "name": "உவமை", "items": [{"label": "1", "text": "அரிச்சுவடி (அகரவரிசை எழுத்துகள்)"}, {"label": "2", "text": "பள்ளிக்கூடம்"}, {"label": "3", "text": "கண்ணாடி"}, {"label": "4", "text": "வாழும் வீடு"}]}], "options": [{"key": "A", "text": "A-2, B-4, C-1, D-3", "mapping": {"A": "2", "B": "4", "C": "1", "D": "3"}}, {"key": "B", "text": "A-4, B-2, C-1, D-3", "mapping": {"A": "4", "B": "2", "C": "1", "D": "3"}}, {"key": "C", "text": "A-2, B-1, C-4, D-3", "mapping": {"A": "2", "B": "1", "C": "4", "D": "3"}}, {"key": "D", "text": "A-1, B-4, C-2, D-3", "mapping": {"A": "1", "B": "4", "C": "2", "D": "3"}}], "explanation": "விரிகடல் = பள்ளிக்கூடம்; கட்டுமரம் = வாழும் வீடு; மின்னல் வரி = அரிச்சுவடி; முழுநிலவு = கண்ணாடி; மூச்சடக்கும் நீச்சல் = தவம்; பெருவானம் = தொழும் தலைவன்."}}}
{"id": "b-tam-6t2-087", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 29"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அரிச்சுவடி’ என்னும் சொல்லின் பொருள் யாது?"}], "options": [{"key": "A", "text": "மின்னல் கோடு"}, {"key": "B", "text": "அகரவரிசை எழுத்துகள்"}, {"key": "C", "text": "கதிரவனின் ஒளி"}, {"key": "D", "text": "பழைய சுவடி"}], "explanation": "அரிச்சுவடி என்பது 'அகரவரிசை எழுத்துகள்' ஆகும். கதிர்ச்சுடர் = கதிரவனின் ஒளி; மின்னல்வரி = மின்னல் கோடு."}}}
{"id": "b-tam-6t2-088", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "3", "B": "1", "C": "4", "D": "2"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 30"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தெரிந்து தெளிவோம் பகுதியிலுள்ள ‘நெய்தல் திணை’ தொடர்பான தகவல்களைப் பொருத்துக:"}, {"type": "list", "name": "கூறு", "items": [{"label": "A", "text": "நிலம்"}, {"label": "B", "text": "மக்கள்"}, {"label": "C", "text": "தொழில்"}, {"label": "D", "text": "பூ"}]}, {"type": "list", "name": "விளக்கம்", "items": [{"label": "1", "text": "பரதவர், பரத்தியர்"}, {"label": "2", "text": "தாழம்பூ"}, {"label": "3", "text": "கடலும் கடல் சார்ந்த இடமும்"}, {"label": "4", "text": "மீன்பிடித்தல், உப்பு விளைவித்தல்"}]}], "options": [{"key": "A", "text": "A-3, B-1, C-4, D-2", "mapping": {"A": "3", "B": "1", "C": "4", "D": "2"}}, {"key": "B", "text": "A-1, B-3, C-4, D-2", "mapping": {"A": "1", "B": "3", "C": "4", "D": "2"}}, {"key": "C", "text": "A-3, B-4, C-1, D-2", "mapping": {"A": "3", "B": "4", "C": "1", "D": "2"}}, {"key": "D", "text": "A-2, B-1, C-4, D-3", "mapping": {"A": "2", "B": "1", "C": "4", "D": "3"}}], "explanation": "நெய்தல்: நிலம் - கடலும் கடல் சார்ந்த இடமும்; மக்கள் - பரதவர், பரத்தியர்; தொழில் - மீன்பிடித்தல், உப்பு விளைவித்தல்; பூ - தாழம்பூ."}}}
{"id": "pyq-tam-6t2-089", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2018, "paper": "tamil", "no": 54}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘நாட்டுப்புற இயல் ஆய்வு’ என்னும் நூலைத் தொகுத்த நாட்டுப்புறவியல் அறிஞர் யார்?"}], "options": [{"key": "A", "text": "வானமாமலை"}, {"key": "B", "text": "முனைவர் சு. சக்திவேல்"}, {"key": "C", "text": "கி. ராஜநாராயணன்"}, {"key": "D", "text": "சா. கந்தசாமி"}], "explanation": "பாடப்பகுதியில் இடம்பெற்றுள்ள நாட்டுப்புறப் பாடல் சு. சக்திவேல் தொகுத்த 'நாட்டுப்புற இயல் ஆய்வு' என்னும் நூலில் இடம்பெற்றுள்ளது."}}}
{"id": "b-tam-6t2-090", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "D", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 31"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கதிர்ச்சுடர்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}], "options": [{"key": "A", "text": "கதிர்ச் + சுடர்"}, {"key": "B", "text": "கதிரின் + சுடர்"}, {"key": "C", "text": "கதிரவன் + சுடர்"}, {"key": "D", "text": "கதிர் + சுடர்"}], "explanation": "கதிர் + சுடர் = கதிர்ச்சுடர்."}}}
{"id": "b-tam-6t2-091", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 31"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘மூச்சடக்கி’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}], "options": [{"key": "A", "text": "மூச்சு + அடக்கி"}, {"key": "B", "text": "மூச் + அடக்கி"}, {"key": "C", "text": "மூச் + சடக்கி"}, {"key": "D", "text": "மூச்சை + அடக்கி"}], "explanation": "மூச்சு + அடக்கி = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'சு' விலுள்ள உ கெட்டு, ச் + அ = ச ஆகி மூச்சடக்கி எனப் புணரும்."}}}
{"id": "b-tam-6t2-092", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 31"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பெருமை + வானம்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}], "options": [{"key": "A", "text": "பெருமைவனம்"}, {"key": "B", "text": "பெருவானம்"}, {"key": "C", "text": "பெருமானம்"}, {"key": "D", "text": "பேர்வானம்"}], "explanation": "ஈறுபோதல் விதிப்படி 'மை' கெட்டுப் 'பெருவானம்' எனப் புணரும்."}}}
{"id": "b-tam-6t2-093", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 31"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அடிக்கும் + அலை’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}], "options": [{"key": "A", "text": "அடிக்குமலை"}, {"key": "B", "text": "அடிக்கும் அலை"}, {"key": "C", "text": "அடிக்கிலை"}, {"key": "D", "text": "அடியலை"}], "explanation": "உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே: ம் + அ = ம ஆகி 'அடிக்கும் அலை' என இயல்பாக ஒலிக்கும்."}}}
{"id": "b-tam-6t2-094", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 30"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "வாய்மொழி இலக்கியங்களுள் அடங்குபவை எவை?"}], "options": [{"key": "A", "text": "காப்பியங்கள், சிற்றிலக்கியங்கள்"}, {"key": "B", "text": "ஏற்றப்பாட்டு, ஓடப்பாட்டு முதலான தொழில்பாடல்கள், தாலாட்டுப் பாடல்கள்"}, {"key": "C", "text": "இலக்கண நூல்கள், அறநூல்கள்"}, {"key": "D", "text": "கட்டுரைகள், சிறுகதைகள்"}], "explanation": "காதால் கேட்டு வாய்மொழியாகவே வழங்கி வருவதால் நாட்டுப்புறப் பாடல்கள் (ஏற்றப்பாட்டு, ஓடப்பாட்டு, தாலாட்டு போன்றவை) வாய்மொழி இலக்கியம் எனப்படும்."}}}

// ==============================================================================
// பாடம் 3: வளரும் வணிகம் (உரைநடை உலகம்) [Q095 - Q110]
// நுகர்வோர்/வணிகர், நற்றிணை (உமணர்), குறுந்தொகை (பாலொடு வந்து கூழொடு),
// அகநானூறு (பொன்னொடு வந்து கறியொடு), வணிகச்சாத்து, பட்டினம்/பாக்கம், பூம்புகார்,
// ஏற்றுமதி/இறக்குமதி, வாணிகம் பேணி, நடுவு நின்ற நன்னெஞ்சினோர் (பட்டினப்பாலை),
// கொள்வதும் மிகை கொளாது, சிறு/பெரு வணிகம், புணர்ச்சி
// ==============================================================================
{"id": "b-tam-6t2-095", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 32"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஒரு பொருளைப் பிறரிடம் இருந்து வாங்குவதும் பிறருக்கு விற்பதும் வணிகம் ஆகும். இதில் பொருள்களை வாங்குபவர் எவ்வாறு அழைக்கப்படுகிறார்?"}], "options": [{"key": "A", "text": "நுகர்வோர்"}, {"key": "B", "text": "வணிகர்"}, {"key": "C", "text": "முதலீட்டாளர்"}, {"key": "D", "text": "வணிகச்சாத்து"}], "explanation": "பொருள்களை விற்பவரை வணிகர் என்பர்; வாங்குபவரை நுகர்வோர் என்பர்."}}}
{"id": "pyq-tam-6t2-096", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 16}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘தந்நாடு விளைந்த வெண்ணெல் தந்து பிறநாட்டு உப்பின் கொள்ளைச் சாற்றி உமணர் போகலும்’ - இவ்வடிகள் இடம்பெற்றுள்ள சங்க இலக்கிய நூல் எது?"}], "options": [{"key": "A", "text": "நற்றிணை (பாடல் 183)"}, {"key": "B", "text": "குறுந்தொகை"}, {"key": "C", "text": "அகநானூறு"}, {"key": "D", "text": "புறநானூறு"}], "explanation": "நெல்லிற்கு உப்பைப் பண்டமாற்றாகப் பெற்றுச் சென்ற உமணர்களைப் பற்றிக் குறிப்பிடுவது நற்றிணை ஆகும்."}}}
{"id": "pyq-tam-6t2-097", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 48}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பாலொடு வந்து கூழொடு பெயரும்’ - என்ற பண்டமாற்று வணிகக் காட்சி இடம்பெற்றுள்ள நூல் எது?"}], "options": [{"key": "A", "text": "நற்றிணை"}, {"key": "B", "text": "குறுந்தொகை (பாடல் 221)"}, {"key": "C", "text": "அகநானூறு"}, {"key": "D", "text": "பதிற்றுப்பத்து"}], "explanation": "ஆட்டின் பாலைக் கொடுத்துத் தானியத்தைப் பெற்ற பண்டமாற்றுச் செய்தி குறுந்தொகையில் (பாடல் 221) வருகிறது."}}}
{"id": "pyq-tam-6t2-098", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 59}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பொன்னொடு வந்து கறியொடு பெயரும்’ - என்று யவனர்களின் மிளகு வணிகம் பற்றிக் குறிப்பிடும் சங்க இலக்கியம் எது?"}], "options": [{"key": "A", "text": "நற்றிணை"}, {"key": "B", "text": "குறுந்தொகை"}, {"key": "C", "text": "அகநானூறு (பாடல் 149)"}, {"key": "D", "text": "பட்டினப்பாலை"}], "explanation": "பொன்னைக் கொடுத்துவிட்டு மிளகை (கறி = மிளகு) ஏற்றிச் சென்ற செய்தி அகநானூற்றில் (பாடல் 149) குறிப்பிடப்பட்டுள்ளது."}}}
{"id": "b-tam-6t2-099", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 32"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பண்டைக்காலத்தில் வணிகர்கள் பொருள்களை ஏற்றி வெளியூருக்குச் செல்லும்போது அமைத்துக் கொண்ட பாதுகாப்புக் குழு எவ்வாறு அழைக்கப்பட்டது?"}], "options": [{"key": "A", "text": "வணிகக்குழு"}, {"key": "B", "text": "வணிகச்சாத்து"}, {"key": "C", "text": "உமணர் கூட்டம்"}, {"key": "D", "text": "வணிக வாரியம்"}], "explanation": "வணிகர்கள் வண்டிகளில் பொருள்களை ஏற்றி வெளியூருக்குச் செல்லும் கூட்டத்தை 'வணிகச்சாத்து' என்பர்."}}}
{"id": "b-tam-6t2-100", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 33"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பண்டைத் தமிழ்நாட்டின் கடற்கரைத் துறைமுக நகரங்கள் எவ்வாறு குறிப்பிடப்பட்டன?"}], "options": [{"key": "A", "text": "ஊர், பேரூர்"}, {"key": "B", "text": "பட்டினம், பாக்கம்"}, {"key": "C", "text": "நகரம், பெருநகரம்"}, {"key": "D", "text": "சேரி, குடி"}], "explanation": "கப்பல்கள் வந்து நின்று போகும் துறைமுக நகரங்கள் 'பட்டினம்' என்றும் 'பாக்கம்' என்றும் அழைக்கப்பட்டன."}}}
{"id": "b-tam-6t2-101", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 33"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பண்டைத் தமிழ்நாட்டின் தலைசிறந்த துறைமுகமாக விளங்கிய நகரம் எது?"}], "options": [{"key": "A", "text": "பூம்புகார்"}, {"key": "B", "text": "கொற்கை"}, {"key": "C", "text": "முசிறி"}, {"key": "D", "text": "தொண்டி"}], "explanation": "தமிழ்நாட்டின் தலைசிறந்த துறைமுகமாகப் பூம்புகார் விளங்கியது; இங்குப் பல்வேறு நாட்டுக் கப்பல்கள் வந்து நின்றன."}}}
{"id": "b-tam-6t2-102", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "3", "B": "1", "C": "2"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 33"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பண்டைத் தமிழ்நாட்டின் ஏற்றுமதி மற்றும் இறக்குமதிப் பொருள்களைச் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "நாடு / வழி", "items": [{"label": "A", "text": "தமிழ்நாட்டிலிருந்து ஏற்றுமதி"}, {"label": "B", "text": "சீனத்திலிருந்து இறக்குமதி"}, {"label": "C", "text": "அரேபியாவிலிருந்து இறக்குமதி"}]}, {"type": "list", "name": "பொருள்கள்", "items": [{"label": "1", "text": "கண்ணாடி, கற்பூரம், பட்டு"}, {"label": "2", "text": "குதிரைகள்"}, {"label": "3", "text": "தேக்கு, சந்தனம், மிளகு, அரிசி, மயில்தோகை"}]}], "options": [{"key": "A", "text": "A-3, B-1, C-2", "mapping": {"A": "3", "B": "1", "C": "2"}}, {"key": "B", "text": "A-1, B-3, C-2", "mapping": {"A": "1", "B": "3", "C": "2"}}, {"key": "C", "text": "A-3, B-2, C-1", "mapping": {"A": "3", "B": "2", "C": "1"}}, {"key": "D", "text": "A-2, B-1, C-3", "mapping": {"A": "2", "B": "1", "C": "3"}}], "explanation": "தமிழ்நாடு ஏற்றுமதி = தேக்கு, சந்தனம், மிளகு, அரிசி, மயில்தோகை, இஞ்சி; சீனா இறக்குமதி = கண்ணாடி, கற்பூரம், பட்டு; அரேபியா = குதிரைகள்."}}}
{"id": "pyq-tam-6t2-103", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 66}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘வாணிகம் செய்வார்க்கு வாணிகம் பேணிப் பிறவும் தமபோல் செயின்’ - என்ற திருக்குறள் உணர்த்தும் வணிகப் பண்பு யாது?"}], "options": [{"key": "A", "text": "வணிக விரிவாக்கம்"}, {"key": "B", "text": "வணிகரின் நேர்மை"}, {"key": "C", "text": "அதிக இலாபம் ஈட்டுதல்"}, {"key": "D", "text": "கடல் வாணிகம்"}], "explanation": "பிறர் பொருளையும் தம் பொருள் போலக் கருதி நேர்மையாக வணிகம் செய்ய வேண்டும் என்பதை இக்குறள் வலியுறுத்துகிறது."}}}
{"id": "pyq-tam-6t2-104", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 78}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘நடுவு நின்ற நன்னெஞ்சினோர்’ - என்று வணிகர்களின் நேர்மையைப் போற்றிப் பாராட்டும் சங்க நூல் எது?"}], "options": [{"key": "A", "text": "மதுரைக்காஞ்சி"}, {"key": "B", "text": "பட்டினப்பாலை"}, {"key": "C", "text": "நெடுநல்வாடை"}, {"key": "D", "text": "முல்லைப்பாட்டு"}], "explanation": "பொருளை வாங்கும் போது அதிகமாக வாங்காமலும், பிறருக்குக் கொடுக்கும் போது குறைத்துக் கொடுக்காமலும் நேர்மை காத்ததால் வணிகரைப் பட்டினப்பாலை இவ்வாறு பாராட்டுகிறது."}}}
{"id": "b-tam-6t2-105", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 34"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கொள்வதும் மிகை கொளாது கொடுப்பதும் குறைபடாது’ - என்ற வணிக நேர்மை வரி இடம்பெற்றுள்ள நூல் எது?"}], "options": [{"key": "A", "text": "சிலப்பதிகாரம்"}, {"key": "B", "text": "பட்டினப்பாலை"}, {"key": "C", "text": "பரிபாடல்"}, {"key": "D", "text": "மணிமேகலை"}], "explanation": "பக்கம் 34 கற்பவை கற்றபின் பகுதியில் வணிக நேர்மைக்கு மேற்கோளாகப் பட்டினப்பாலை வரி தரப்பட்டுள்ளது."}}}
{"id": "b-tam-6t2-106", "kind": "statements", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 33"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "சிறு வணிகம் மற்றும் பெரு வணிகம் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "சிறு முதலீட்டில் பொருள்களை வாங்கி வீதிகளில் வைத்து விற்பனை செய்பவர்கள் சிறு வணிகர்கள் ஆவர்."}, {"type": "statement", "label": "II", "text": "சிறு வணிகர்கள் நுகர்வோரிடம் நேரடித் தொடர்பு கொள்பவர்கள் ஆவர்."}, {"type": "statement", "label": "III", "text": "பெரு வணிகர்களுக்கு நுகர்வோருடன் நேரடித் தொடர்பு இருப்பது மிகவும் அரிது."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "C", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "பாடப்பகுதி விளக்கத்தின்படி மூன்று கூற்றுகளும் முற்றிலும் சரியானவை."}}}
{"id": "b-tam-6t2-107", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 35"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘வணிகம் + சாத்து’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}], "options": [{"key": "A", "text": "வணிகசாத்து"}, {"key": "B", "text": "வணிகம்சாத்து"}, {"key": "C", "text": "வணிகச்சாத்து"}, {"key": "D", "text": "வணிகத்துசாத்து"}], "explanation": "மவ்வீறு ஒற்றழிந்து உயிரீறொப்பவும் விதிப்படி மகர ஒற்று கெட்டு, வல்லினம் மிகுந்து 'வணிகச்சாத்து' எனப் புணரும்."}}}
{"id": "b-tam-6t2-108", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 35"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பண்டம் + மாற்று’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}], "options": [{"key": "A", "text": "பண்டமாற்று"}, {"key": "B", "text": "பண்டம்மாற்று"}, {"key": "C", "text": "பண்மாற்று"}, {"key": "D", "text": "பண்டுமாற்று"}], "explanation": "நிலைமொழி ஈற்று மகர மெய் கெட்டுப் 'பண்டமாற்று' எனப் புணரும்."}}}
{"id": "b-tam-6t2-109", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "D", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 35"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘மின்னணு’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}], "options": [{"key": "A", "text": "மின் + னணு"}, {"key": "B", "text": "மின்ன + அணு"}, {"key": "C", "text": "மின்னல் + அணு"}, {"key": "D", "text": "மின் + அணு"}], "explanation": "மின் + அணு = தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும் விதிப்படி ன் இரட்டித்து, உடல்மேல் உயிர்வந்து ஒன்றி 'மின்னணு' எனப் புணரும்."}}}
{"id": "b-tam-6t2-110", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 35"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘விரிவடைந்த’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}], "options": [{"key": "A", "text": "விரி + வடைந்த"}, {"key": "B", "text": "விரி + அடைந்த"}, {"key": "C", "text": "விரிவு + அடைந்த"}, {"key": "D", "text": "விரிவ் + அடைந்த"}], "explanation": "விரிவு + அடைந்த = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி வ் + அ = வ ஆகி விரிவடைந்த எனப் புணரும்."}}}

// ==============================================================================
// பாடம் 4: உழைப்பே மூலதனம் (துணைப்பாடம் / விரிவானம்) [Q111 - Q116]
// பாடுபட்டுத் தேடிய பணத்தைப் புதைத்து வைக்காதீர் (ஔவையார்), அருளப்பர் (பூங்குளம்),
// வளவன் (விவசாயம்), அமுதா (கால்நடை), எழிலன் (வங்கிக் காப்பறை)
// ==============================================================================
{"id": "b-tam-6t2-111", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 36"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பாடுபட்டுத் தேடிய பணத்தைப் புதைத்து வைக்காதீர்’ - என்பது யாருடைய அறிவுரை ஆகும்?"}], "options": [{"key": "A", "text": "திருவள்ளுவர்"}, {"key": "B", "text": "ஔவையார்"}, {"key": "C", "text": "பாரதியார்"}, {"key": "D", "text": "கபிலர்"}], "explanation": "பணம் என்பது முடக்கி வைக்கப்படாமல் தொழில் செய்து பெருக்கப்பட வேண்டும் என ஔவையார் அறிவுறுத்தியுள்ளார்."}}}
{"id": "b-tam-6t2-112", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 36"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘உழைப்பே மூலதனம்’ கதையில் பூங்குளம் ஊரைச் சேர்ந்த அருளப்பர் தம் பிள்ளைகள் மூவருக்கும் ஆளுக்கு எவ்வளவு தொகையைப் பிரித்துக் கொடுத்தார்?"}], "options": [{"key": "A", "text": "இருபத்தையாயிரம் ரூபாய்"}, {"key": "B", "text": "முப்பதினாயிரம் ரூபாய்"}, {"key": "C", "text": "ஐம்பதாயிரம் ரூபாய்"}, {"key": "D", "text": "ஒரு இலட்சம் ரூபாய்"}], "explanation": "அருளப்பர் வெளிநாடு செல்லும் முன் வளவன், அமுதா, எழிலன் ஆகிய மூவருக்கும் ஆளுக்கு 50,000 ரூபாய் கொடுத்தார்."}}}
{"id": "b-tam-6t2-113", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 36, 37"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தந்தை கொடுத்த பணத்தைக் கொண்டு நிலத்தைக் குத்தகைக்குப் பிடித்துக் காய்கறித் தோட்டம் அமைத்து உழைப்பால் பணத்தை இரட்டிப்பாக்கியவர் யார்?"}], "options": [{"key": "A", "text": "எழிலன்"}, {"key": "B", "text": "வளவன்"}, {"key": "C", "text": "அமுதா"}, {"key": "D", "text": "அருளப்பர்"}], "explanation": "வளவன் உழவுத்தொழிலில் ஆர்வம் உடையவன்; காய்கறிகளை விளைவித்து விற்றுப் பணத்தை இரட்டிப்பாக்கினான்."}}}
{"id": "b-tam-6t2-114", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 37"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "நாட்டு மாடுகளை வாங்கிப் பராமரித்து, மகளிர் சுய உதவிக்குழுக்கள் மூலம் பால், வெண்ணெய், நெய் விற்றுப் பொருளை ஈட்டியவர் யார்?"}], "options": [{"key": "A", "text": "வளவன்"}, {"key": "B", "text": "எழிலன்"}, {"key": "C", "text": "அமுதா"}, {"key": "D", "text": "கயல்விழி"}], "explanation": "அமுதா கால்நடை வளர்ப்பில் ஈடுபட்டுக் குடும்பத்திற்குப் பயனுள்ள வகையில் பணத்தைப் பெருக்கினாள்."}}}
{"id": "b-tam-6t2-115", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 37, 38"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தந்தை கொடுத்த பணத்தை வங்கியின் பாதுகாப்புப் பெட்டகத்தில் பூட்டி வைத்துத் தன் காலத்தையும் உழைப்பையும் வீணாக்கியவர் யார்?"}], "options": [{"key": "A", "text": "வளவன்"}, {"key": "B", "text": "எழிலன்"}, {"key": "C", "text": "அமுதா"}, {"key": "D", "text": "அருளப்பர்"}], "explanation": "எழிலன் பணத்தைப் பயன்படுத்தாமல் வங்கிக் காப்பறையில் வைத்திருந்து தந்தையிடம் ஏமாற்றமடைந்தான்."}}}
{"id": "b-tam-6t2-116", "kind": "assertion_reason", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "assertion_reason", "a_true": true, "r_true": true, "r_explains_a": true}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 38"}, "texts": {"ta": {"blocks": [{"type": "assertion", "text": "பணம் என்பது வங்கிக் காப்பறையில் வைத்துப் பாதுகாக்க வேண்டிய பொருளன்று."}, {"type": "reason", "text": "பணத்தைப் பயன்படுத்தித் தொழில் செய்து முன்னேறுவதே இளமையும் ஆற்றலும் உடையோரின் செயலாகும்."}], "options": [{"key": "A", "text": "(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்", "semantic": "both_true_explains"}, {"key": "B", "text": "(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல", "semantic": "both_true_not_explains"}, {"key": "C", "text": "(A) சரி ஆனால் (R) தவறு", "semantic": "a_true_r_false"}, {"key": "D", "text": "(A) தவறு ஆனால் (R) சரி", "semantic": "a_false_r_true"}], "explanation": "உழைப்பே மூலதனம் கதையின் நீதியாக அருளப்பர் தன் மகன் எழிலனிடம் இக்கருத்தைக் கூறி அவனது தவற்றை உணரச் செய்கிறார்."}}}

// ==============================================================================
// பாடம் 5: இன எழுத்துகள் (கற்கண்டு - இலக்கணம்) [Q117 - Q125]
// இன எழுத்துகள் வரையறை, வல்லினம்-மெல்லினம் இணை, இடையினம் (6 ஒரே இனம்), ஐ-இ, ஔ-உ,
// அளபெடை, ஆய்த எழுத்துக்கு இனமில்லை, இனவெழுத்துப் பிழை திருத்தம்
// ==============================================================================
{"id": "b-tam-6t2-117", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 39"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "எழுத்துகளுக்கு இடையே ஒலிக்கும் முயற்சி, பிறக்கும் இடம் ஆகியவற்றில் ஒற்றுமை உடைய எழுத்துகள் எவ்வாறு அழைக்கப்படுகின்றன?"}], "options": [{"key": "A", "text": "சுட்டெழுத்துகள்"}, {"key": "B", "text": "இன எழுத்துகள்"}, {"key": "C", "text": "சார்பெழுத்துகள்"}, {"key": "D", "text": "முதல் எழுத்துகள்"}], "explanation": "ஒலிக்கும் முயற்சி, பிறக்கும் இடம் ஆகியவற்றில் ஒற்றுமை உடைய எழுத்துகள் 'இன எழுத்துகள்' எனப்படும்."}}}
{"id": "pyq-tam-6t2-118", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 71}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஆறு வல்லின மெய் எழுத்துகளுக்கும் இன எழுத்துகளாக அமைபவை எவை?"}], "options": [{"key": "A", "text": "ஆறு இடையின மெய் எழுத்துகள்"}, {"key": "B", "text": "ஆறு மெல்லின மெய் எழுத்துகள்"}, {"key": "C", "text": "பன்னிரண்டு உயிர் எழுத்துகள்"}, {"key": "D", "text": "ஆய்த எழுத்து"}], "explanation": "ஆறு வல்லின மெய் எழுத்துகளுக்கும் ஆறு மெல்லின மெய் எழுத்துகள் இன எழுத்துகள் ஆகும் (ங்-க், ஞ்-ச், ண்-ட், ந்-த், ம்-ப், ன்-ற்)."}}}
{"id": "b-tam-6t2-119", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 39"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "இடையின மெய்யெழுத்துகள் (ய், ர், ல், வ், ழ், ள்) ஆறும் எவ்வகையான இனமாக அமைகின்றன?"}], "options": [{"key": "A", "text": "வல்லினத்திற்கு இனம்"}, {"key": "B", "text": "மெல்லினத்திற்கு இனம்"}, {"key": "C", "text": "ஆறும் ஒரே இனமாகும்"}, {"key": "D", "text": "இவற்றுக்கு இன எழுத்து இல்லை"}], "explanation": "இடையின எழுத்துகள் ஆறும் (ய், ர், ல், வ், ழ், ள்) ஒரே இனமாகும்."}}}
{"id": "pyq-tam-6t2-120", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 85}, "texts": {"ta": {"blocks": [{"type": "text", "text": "குறில் இணை இல்லாத ‘ஐ’ மற்றும் ‘ஔ’ என்னும் உயிர் நெடில் எழுத்துகளுக்கு இன எழுத்துகளாக அமைபவை முறையே எவை?"}], "options": [{"key": "A", "text": "ஈ, ஊ"}, {"key": "B", "text": "இ, உ"}, {"key": "C", "text": "அ, இ"}, {"key": "D", "text": "எ, ஒ"}], "explanation": "குறில் இல்லாத 'ஐ' என்பதற்கு 'இ' என்பதும், 'ஔ' என்பதற்கு 'உ' என்பதும் இன எழுத்துகள் ஆகும்."}}}
{"id": "b-tam-6t2-121", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 39"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தமிழ் மொழியில் நெடிலைத் தொடர்ந்து அதன் இனமாகிய குறில் எழுத்து சேர்ந்து வரும் ஒரே இடம் எது?"}], "options": [{"key": "A", "text": "புணர்ச்சி"}, {"key": "B", "text": "பகாப்பதம்"}, {"key": "C", "text": "அளபெடை (எ.கா: ஓஒதல், தூஉம், தழீஇ)"}, {"key": "D", "text": "தொகைநிலைத் தொடர்"}], "explanation": "சொல்லில் உயிரெழுத்துகள் பொதுவாகச் சேர்ந்து வருவதில்லை; அளபெடையில் மட்டுமே நெடிலைத் தொடர்ந்து அதன் இனக்குறில் வரும்."}}}
{"id": "pyq-tam-6t2-122", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2018, "paper": "tamil", "no": 91}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தமிழ் எழுத்துகளில் எந்த ஓர் எழுத்துக்கு மட்டுமே இன எழுத்து இல்லை?"}], "options": [{"key": "A", "text": "ஔ"}, {"key": "B", "text": "ழ்"}, {"key": "C", "text": "ஆய்த எழுத்து (ஃ)"}, {"key": "D", "text": "ங்"}], "explanation": "தமிழ் எழுத்துகளில் ஆய்த எழுத்துக்கு மட்டுமே இன எழுத்து இல்லை."}}}
{"id": "b-tam-6t2-123", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 40"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "மெல்லினத்திற்கான இன எழுத்து இடம்பெறாத சொல் எது?"}], "options": [{"key": "A", "text": "மஞ்சள்"}, {"key": "B", "text": "வந்தான்"}, {"key": "C", "text": "கண்ணில்"}, {"key": "D", "text": "தம்பி"}], "explanation": "மஞ்சள் (ஞ்-ச்), வந்தான் (ந்-த்), தம்பி (ம்-ப்) ஆகியவற்றில் இனவெழுத்து உண்டு. 'கண்ணில்' என்பதில் ண்-ணே வந்துள்ளதால் மெல்லின வல்லின இன இணை இல்லை."}}}
{"id": "b-tam-6t2-124", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 40"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "இனவெழுத்துப் பிழையுள்ள தவறான சொல் எது?"}], "options": [{"key": "A", "text": "கண்டான்"}, {"key": "B", "text": "வென்ரான்"}, {"key": "C", "text": "நண்டு"}, {"key": "D", "text": "வண்டு"}], "explanation": "'ற்' என்ற வல்லினத்திற்கு 'ன்' தான் இனவெழுத்து; எனவே 'வென்றான்' என்றே எழுத வேண்டும் ('வென்ரான்' என்பது பிழை)."}}}
{"id": "b-tam-6t2-125", "kind": "match", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "3", "B": "1", "C": "4", "D": "2"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 40"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பாடநூல் பிழைதிருத்தப் பகுதியிலுள்ள சொற்களைச் சரியான வடிவத்தோடு பொருத்துக:"}, {"type": "list", "name": "பிழையான சொல்", "items": [{"label": "A", "text": "தெண்றல்"}, {"label": "B", "text": "கன்டம்"}, {"label": "C", "text": "நன்ரி"}, {"label": "D", "text": "மன்டபம்"}]}, {"type": "list", "name": "திருத்தம்", "items": [{"label": "1", "text": "கண்டம்"}, {"label": "2", "text": "மண்டபம்"}, {"label": "3", "text": "தென்றல்"}, {"label": "4", "text": "நன்றி"}]}], "options": [{"key": "A", "text": "A-3, B-1, C-4, D-2", "mapping": {"A": "3", "B": "1", "C": "4", "D": "2"}}, {"key": "B", "text": "A-1, B-3, C-2, D-4", "mapping": {"A": "1", "B": "3", "C": "2", "D": "4"}}, {"key": "C", "text": "A-3, B-4, C-1, D-2", "mapping": {"A": "3", "B": "4", "C": "1", "D": "2"}}, {"key": "D", "text": "A-4, B-1, C-2, D-3", "mapping": {"A": "4", "B": "1", "C": "2", "D": "3"}}], "explanation": "றகரத்திற்கு னகரமும் (தென்றல், நன்றி), டகரத்திற்கு ணகரமும் (கண்டம், மண்டபம்) இன எழுத்துகளாகும்."}}}

// ==============================================================================
// பாடம் 6: மொழியை ஆள்வோம், கடிதம் & கலைச்சொற்கள் [Q126 - Q136]
// ஓர்/ஒரு, அஃது/அது விதிகள், விடுகதைகள் (தராசு, ஏற்றுமதி-இறக்குமதி),
// உறவுமுறைக் கடிதம் (5 பகுதிகள்), நவரத்தினங்கள் அகரவரிசை, கலைச்சொற்கள்
// ==============================================================================
{"id": "b-tam-6t2-126", "kind": "statements", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "D", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 43"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘ஓர் / ஒரு’ மற்றும் ‘அஃது / அது’ பயன்பாட்டு விதிகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "உயிரெழுத்தில் தொடங்கும் சொல்லுக்கு முன் 'ஓர்' என்னும் சொல்லைப் பயன்படுத்த வேண்டும்."}, {"type": "statement", "label": "II", "text": "உயிர்மெய்யெழுத்தில் தொடங்கும் சொல்லுக்கு முன் 'ஒரு' என்னும் சொல்லைப் பயன்படுத்த வேண்டும்."}, {"type": "statement", "label": "III", "text": "உயிரெழுத்தில் தொடங்கும் சொல்லுக்கு முன் 'அஃது' என்றும், உயிர்மெய்யெழுத்தில் தொடங்கும் சொல்லுக்கு முன் 'அது' என்றும் பயன்படுத்த வேண்டும்."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "C", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "பாடநூல் இலக்கண விளக்கத்தின்படி மூன்று விதிகளும் முற்றிலும் சரியானவை (எ.கா: ஓர் ஊர், ஒரு நகரம், அஃது இங்கே உள்ளது, அது நன்றாக உள்ளது)."}}}
{"id": "b-tam-6t2-127", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 43"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘ஒரு அழகிய சிற்றூரில் ஓர் குளம் இருந்தது’ - இத்தொடரிலுள்ள பிழையைத் திருத்தி எழுதினால் கிடைக்கும் சரியான தொடர் எது?"}], "options": [{"key": "A", "text": "ஒரு அழகிய சிற்றூரில் ஒரு குளம் இருந்தது"}, {"key": "B", "text": "ஓர் அழகிய சிற்றூரில் ஒரு குளம் இருந்தது"}, {"key": "C", "text": "ஓர் அழகிய சிற்றூரில் ஓர் குளம் இருந்தது"}, {"key": "D", "text": "ஒரு அழகிய சிற்றூரில் குளம் இருந்தது"}], "explanation": "'அழகிய' உயிரெழுத்து என்பதால் 'ஓர் அழகிய' எனவும், 'குளம்' உயிர்மெய் என்பதால் 'ஒரு குளம்' எனவும் அமைவதே சரி."}}}
{"id": "b-tam-6t2-128", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 43"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அஃது நகரத்திற்குச் செல்லும் சாலை’ - இத்தொடரிலுள்ள பிழையைத் திருத்துக:"}], "options": [{"key": "A", "text": "அஃது நகரத்திற்குச் செல்வது சாலை"}, {"key": "B", "text": "அது நகரத்திற்குச் செல்லும் சாலை"}, {"key": "C", "text": "அஃது ஒரு நகரத்திற்குச் செல்லும் சாலை"}, {"key": "D", "text": "அது ஓர் நகரத்திற்குச் செல்லும் சாலை"}], "explanation": "'நகரத்திற்கு' என்பது உயிர்மெய்யெழுத்து என்பதால் அதன்முன் 'அது' என்றே வர வேண்டும் ('அஃது' தவறு)."}}}
{"id": "b-tam-6t2-129", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 43"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘தனி ஆளாய் இருந்தால் நடுநிலையாய் இருந்திடுவான்; யாரும் வந்து அமர்ந்தால் ஏற்றம் இறக்கம் காட்டிடுவான். அவன் யார்?’ - விடுகதைக்குரிய விடை யாது?"}], "options": [{"key": "A", "text": "கப்பல்"}, {"key": "B", "text": "தராசு"}, {"key": "C", "text": "குதிரை"}, {"key": "D", "text": "நெல்மணி"}], "explanation": "பாடநூல் விடுகதை விடை: தராசு."}}}
{"id": "b-tam-6t2-130", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 43"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘ஒருமதி வெளியே போகும்; ஒருமதி உள்ளே வரும்; இருமதியும் சேர்ந்துவிட்டால் பலநிதியும் சேர்ந்து வரும். அவை என்ன?’ - விடுகதையின் விடை எது?"}], "options": [{"key": "A", "text": "ஏற்றுமதி - இறக்குமதி"}, {"key": "B", "text": "பண்டமாற்று"}, {"key": "C", "text": "முழுநிலவு"}, {"key": "D", "text": "பணம்"}], "explanation": "பக்கம் 43 விடுகதை விடை: ஏற்றுமதி - இறக்குமதி."}}}
{"id": "b-tam-6t2-131", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 42"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "உறவினர்களுக்கும் நண்பர்களுக்கும் எழுதப்படும் ‘உறவுமுறைக் கடிதம்’ எத்தனை பகுதிகளைக் கொண்டது?"}], "options": [{"key": "A", "text": "நான்கு பகுதிகள்"}, {"key": "B", "text": "ஐந்து பகுதிகள்"}, {"key": "C", "text": "ஆறு பகுதிகள்"}, {"key": "D", "text": "ஏழு பகுதிகள்"}], "explanation": "உறவுமுறைக் கடிதம் 5 பகுதிகளைக் கொண்டது: 1. இடமும் தேதியும், 2. விளி, 3. உடல்பகுதி, 4. கையொப்பம், 5. உறைமேல் முகவரி."}}}
{"id": "b-tam-6t2-132", "kind": "match", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "3", "B": "1", "C": "4", "D": "2"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 44"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"}, {"type": "list", "name": "ஆங்கிலக் கலைச்சொல்", "items": [{"label": "A", "text": "Commodity"}, {"label": "B", "text": "Voyage"}, {"label": "C", "text": "Ferries"}, {"label": "D", "text": "Heritage"}]}, {"type": "list", "name": "தமிழாக்கம்", "items": [{"label": "1", "text": "கடற்பயணம்"}, {"label": "2", "text": "பாரம்பரியம்"}, {"label": "3", "text": "பண்டம்"}, {"label": "4", "text": "பயணப்படகுகள்"}]}], "options": [{"key": "A", "text": "A-3, B-1, C-4, D-2", "mapping": {"A": "3", "B": "1", "C": "4", "D": "2"}}, {"key": "B", "text": "A-1, B-3, C-2, D-4", "mapping": {"A": "1", "B": "3", "C": "2", "D": "4"}}, {"key": "C", "text": "A-3, B-4, C-1, D-2", "mapping": {"A": "3", "B": "4", "C": "1", "D": "2"}}, {"key": "D", "text": "A-4, B-1, C-2, D-3", "mapping": {"A": "4", "B": "1", "C": "2", "D": "3"}}], "explanation": "Commodity = பண்டம், Voyage = கடற்பயணம், Ferries = பயணப்படகுகள், Heritage = பாரம்பரியம்."}}}
{"id": "b-tam-6t2-133", "kind": "match", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "2", "B": "4", "C": "1", "D": "3"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 44"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "வணிகக் கலைச்சொற்களைச் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "ஆங்கிலக் கலைச்சொல்", "items": [{"label": "A", "text": "Consumer"}, {"label": "B", "text": "Merchant"}, {"label": "C", "text": "Entrepreneur"}, {"label": "D", "text": "Adulteration"}]}, {"type": "list", "name": "தமிழாக்கம்", "items": [{"label": "1", "text": "தொழில் முனைவோர்"}, {"label": "2", "text": "நுகர்வோர்"}, {"label": "3", "text": "கலப்படம்"}, {"label": "4", "text": "வணிகர்"}]}], "options": [{"key": "A", "text": "A-2, B-4, C-1, D-3", "mapping": {"A": "2", "B": "4", "C": "1", "D": "3"}}, {"key": "B", "text": "A-4, B-2, C-1, D-3", "mapping": {"A": "4", "B": "2", "C": "1", "D": "3"}}, {"key": "C", "text": "A-2, B-1, C-4, D-3", "mapping": {"A": "2", "B": "1", "C": "4", "D": "3"}}, {"key": "D", "text": "A-1, B-4, C-2, D-3", "mapping": {"A": "1", "B": "4", "C": "2", "D": "3"}}], "explanation": "Consumer = நுகர்வோர், Merchant = வணிகர், Entrepreneur = தொழில் முனைவோர், Adulteration = கலப்படம்."}}}
{"id": "b-tam-6t2-134", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 44"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பக்கம் 44 குறுக்கெழுத்துப் புதிரில் 'அரேபியாவிலிருந்து இறக்குமதி செய்யப்பட்டது' என்பதற்குரிய விடை யாது?"}], "options": [{"key": "A", "text": "யானை"}, {"key": "B", "text": "குதிரை"}, {"key": "C", "text": "ஒட்டகம்"}, {"key": "D", "text": "பட்டு"}], "explanation": "குறுக்கெழுத்துப் புதிரின்படி அரேபியாவிலிருந்து இறக்குமதி செய்யப்பட்டது குதிரை ஆகும்."}}}
{"id": "b-tam-6t2-135", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 42"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘நீலம், கோமேதகம், மாணிக்கம், வைரம், பவளம்’ முதலான நவமணிகளை அகரவரிசைப்படுத்தும்போது முதல் சொல்லாக அமைவது எது?"}], "options": [{"key": "A", "text": "நீலம்"}, {"key": "B", "text": "கோமேதகம்"}, {"key": "C", "text": "பவளம்"}, {"key": "D", "text": "மாணிக்கம்"}], "explanation": "அகரவரிசை: கோமேதகம், நீலம், பவளம், புட்பராகம், மரகதம், மாணிக்கம், முத்து, வைடூரியம், வைரம்."}}}
{"id": "b-tam-6t2-136", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 44"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘காடும் காடு சார்ந்த இடமும்’ என்பது நால்வகை நிலங்களில் எந்த நிலத்தைக் குறிக்கும்?"}], "options": [{"key": "A", "text": "குறிஞ்சி"}, {"key": "B", "text": "முல்லை"}, {"key": "C", "text": "மருதம்"}, {"key": "D", "text": "நெய்தல்"}], "explanation": "குறுக்கெழுத்துப் புதிர்க் குறிப்பு: காடும் காடு சார்ந்த இடமும் முல்லை நிலம் ஆகும்."}}}

