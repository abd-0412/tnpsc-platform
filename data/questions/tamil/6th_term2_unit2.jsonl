// பாடம் 7: திருக்குறள் (வாழ்வியல்) [Q137 - Q154]
// அன்புடைமை (புன்கண்நீர், மறத்திற்கும் அஃதே துணை, வெயில்போலக் காயுமே, வன்பாற்கண் வற்றல் மரம்),
// விருந்தோம்பல் (செய்யாள், செல்விருந்து), இனியவை கூறல் (அகன்அமர்ந்து, துன்புறூஉம் துவ்வாமை),
// பயனில சொல்லாமை (மக்கட் பதடி), ஈகை (வறியார்க்குஒன்று ஈவதே, ஆற்றுவார் ஆற்றல் பசிஆற்றல்,
// தீப்பிணி, வைப்புழி, சாதலின் இன்னாதது இல்லை), புதிய பாடத்திட்ட குறட்பாக்கள் (150), ஓர்/அஃது தொடர்
// ==============================================================================
{"id": "b-tam-6t2-137", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 45"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அன்பிற்கும் உண்டோ அடைக்கும்தாழ் ஆர்வலர் புன்கண்நீர் பூசல் தரும்’ - இக்குறட்பாவில் ‘புன்கண்நீர்’ என்பதன் பொருள் யாது?"}], "options": [{"key": "A", "text": "மகிழ்ச்சிக் கண்ணீர்"}, {"key": "B", "text": "பொய்க் கண்ணீர்"}, {"key": "C", "text": "துன்பக் கண்ணீர்"}, {"key": "D", "text": "அருவி நீர்"}], "explanation": "புன்கண் என்றால் துன்பம்; அன்புடையவர் தம் அன்புக்குரியவரின் துன்பத்தைக் கண்டு சிந்தும் துன்பக் கண்ணீரே அவரது அன்பை வெளிப்படுத்திவிடும்."}}}
{"id": "b-tam-6t2-138", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 45"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அறத்திற்கே அன்புசார்பு என்ப அறியார் மறத்திற்கும் அஃதே துணை’ - இக்குறட்பாவின்படி அன்பு எதற்குத் துணையாக நிற்கிறது?"}], "options": [{"key": "A", "text": "அறத்திற்கு மட்டுமே"}, {"key": "B", "text": "அறத்திற்கும் வீரத்திற்கும் (மறத்திற்கும்)"}, {"key": "C", "text": "செல்வத்திற்கு மட்டுமே"}, {"key": "D", "text": "கல்விக்கு மட்டுமே"}], "explanation": "அறியாதவர்கள் அறத்திற்கு மட்டுமே அன்பு துணை என்பர்; உண்மையில் மறத்திற்கும் (வீரத்திற்கும்) அன்பே துணையாகும்."}}}
{"id": "pyq-tam-6t2-139", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 51}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘என்பு இலதனை வெயில்போலக் காயுமே அன்பி லதனை அறம்’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?"}], "options": [{"key": "A", "text": "உவமையணி"}, {"key": "B", "text": "எடுத்துக்காட்டு உவமையணி"}, {"key": "C", "text": "இல்பொருள் உவமையணி"}, {"key": "D", "text": "வேற்றுமையணி"}], "explanation": "'போல' என்ற உவம உருபு வெளிப்பட்டு வந்துள்ளதால் இது உவமையணி ஆகும் (எலும்பில்லாத புழுவை வெயில் வருத்துவது போல)."}}}
{"id": "pyq-tam-6t2-140", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 64}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அன்பகத்து இல்லா உயிர்வாழ்க்கை வன்பாற்கண் வற்றல் மரம்தளிர்த் தற்று’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?"}], "options": [{"key": "A", "text": "உவமையணி"}, {"key": "B", "text": "எடுத்துக்காட்டு உவமையணி"}, {"key": "C", "text": "இல்பொருள் உவமையணி"}, {"key": "D", "text": "சொற்பொருள் பின்வருநிலையணி"}], "explanation": "பாலைநிலத்தில் காய்ந்துபோன மரம் மீண்டும் தளிர்விடாது; இல்லாத ஒன்று கூறப்பட்டதால் இல்பொருள் உவமையணி."}}}
{"id": "b-tam-6t2-141", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 45"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அகன்அமர்ந்து செய்யாள் உறையும் முகன்அமர்ந்து நல்விருந்து ஓம்புவான் இல்’ - இக்குறட்பாவில் ‘செய்யாள்’ என்பது யாரைக் குறிக்கிறது?"}], "options": [{"key": "A", "text": "கலைமகள்"}, {"key": "B", "text": "திருமகள் (செல்வம்)"}, {"key": "C", "text": "நிலமகள்"}, {"key": "D", "text": "தாயன்பு"}], "explanation": "முகம் மலர்ந்து விருந்தினரைப் போற்றுபவன் இல்லத்தில் திருமகள் (செய்யாள்) விரும்பி உறைவாள்."}}}
{"id": "b-tam-6t2-142", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 45"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘செல்விருந்து ஓம்பி வருவிருந்து பார்த்துஇருப்பான் நல்விருந்து __’ - விடுபட்ட சீர் எது?"}], "options": [{"key": "A", "text": "வானவர்க்கு"}, {"key": "B", "text": "வானத் தவர்க்கு"}, {"key": "C", "text": "தேவர்க்கு"}, {"key": "D", "text": "வையத்தார்க்கு"}], "explanation": "வந்த விருந்தினரைப் போற்றி, வரப்போகும் விருந்தினரை எதிர்நோக்கி இருப்பவன் வானத்தில் உள்ள தேவர்க்கும் சிறந்த விருந்தினன் ஆவான்."}}}
{"id": "b-tam-6t2-143", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 46"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அகன்அமர்ந்து ஈதலின் நன்றே முகன்அமர்ந்து இன்சொலன் ஆகப் பெறின்’ - இக்குறள் உணர்த்தும் கருத்து யாது?"}], "options": [{"key": "A", "text": "பொருள் கொடுப்பதே தலையாய அறம்"}, {"key": "B", "text": "முகம் மலர்ந்து இன்சொல் பேசுவது, உள்ளம் விரும்பி ஒரு பொருளைக் கொடுப்பதைக் காட்டிலும் மேலானது"}, {"key": "C", "text": "கடுஞ்சொல் பேசுவது தருமத்தை அழிக்கும்"}, {"key": "D", "text": "பொருளற்ற சொற்களைப் பேசக் கூடாது"}], "explanation": "இனியவை கூறல் அதிகாரக் குறள்: இன்முகம் காட்டி இனிய சொல் கூறுவது தானம் செய்வதை விடச் சிறந்தது."}}}
{"id": "b-tam-6t2-144", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 46"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘துன்புறூஉம் துவ்வாமை இல்லாகும் யார்மாட்டும் இன்புறூஉம் இன்சொ லவர்க்கு’ - இதில் ‘துவ்வாமை’ என்பதன் பொருள் யாது?"}], "options": [{"key": "A", "text": "துன்பம்"}, {"key": "B", "text": "வறுமை"}, {"key": "C", "text": "பகைமை"}, {"key": "D", "text": "நோய்"}], "explanation": "துவ்வாமை என்றால் வறுமை என்று பொருள்; எல்லாரிடமும் இன்சொல் பேசுபவர்க்கு வறுமை வாராது."}}}
{"id": "b-tam-6t2-145", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 46"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பயனில்சொல் பாராட்டு வானை மகன்எனல் மக்கட் __ எனல்’ - விடுபட்ட சீர் எது?"}], "options": [{"key": "A", "text": "பதடி"}, {"key": "B", "text": "பதடி எனல்"}, {"key": "C", "text": "புல்லன்"}, {"key": "D", "text": "கொடியன்"}], "explanation": "பயனற்ற சொற்களைப் பேசுபவனை மனிதன் என்று கூறலாகாது; அவன் மனிதர்களில் பதர் (மக்கட் பதடி) ஆவான்."}}}
{"id": "pyq-tam-6t2-146", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 82}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘வறியார்க்குஒன்று ஈவதே ஈகைமற்று எல்லாம் குறியெதிர்ப்பை நீரது உடைத்து’ - இக்குறட்பாவின்படி உண்மையான ‘ஈகை’ என்பது யாது?"}], "options": [{"key": "A", "text": "நண்பர்களுக்குக் கொடுப்பது"}, {"key": "B", "text": "இல்லாத ஏழைகளுக்குக் கொடுப்பதே"}, {"key": "C", "text": "பயனை எதிர்பார்த்துக் கொடுப்பது"}, {"key": "D", "text": "சுற்றத்தாருக்கு உதவுவது"}], "explanation": "ஏதும் இல்லாத வறியவர்க்குக் கொடுப்பதே உண்மையான ஈகை; மற்றவர்க்குக் கொடுப்பது மறுபயனை எதிர்பார்த்துக் கொடுப்பதாகும்."}}}
{"id": "b-tam-6t2-147", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 47"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘ஆற்றுவார் ஆற்றல் பசிஆற்றல் அப்பசியை மாற்றுவார் ஆற்றலின் பின்’ - இக்குறளின்படி எல்லாவற்றையும் விடப் பேராற்றல் எது?"}], "options": [{"key": "A", "text": "போர்க்களத்தில் வெற்றி பெறுவது"}, {"key": "B", "text": "ஏழைகளின் பசியைப் போக்குவது"}, {"key": "C", "text": "தவத்தினால் பசியைப் பொறுத்துக் கொள்வது"}, {"key": "D", "text": "நூல்களைக் கற்றுத் தேர்வது"}], "explanation": "தன் பசியைப் பொறுப்பது பேராற்றல் என்றாலும், அதைவிடப் பிறர் பசியைப் போக்குவதே மேலான பேராற்றலாகும்."}}}
{"id": "b-tam-6t2-148", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 47"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பாத்துஊண் மரீஇ யவனைப் பசிஎன்னும் ________ தீண்டல் அரிது’ - விடுபட்ட சீர் எது?"}], "options": [{"key": "A", "text": "கொடும்பிணி"}, {"key": "B", "text": "தீப்பிணி"}, {"key": "C", "text": "வெம்பசி"}, {"key": "D", "text": "பெருந்துன்பம்"}], "explanation": "பகுத்துண்டு வாழும் பழக்கமுடையவனைப் பசி என்னும் 'தீப்பிணி' தீண்டாது."}}}
{"id": "b-tam-6t2-149", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 47"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அற்றார் அழிபசி தீர்த்தல் அஃதுஒருவன் பெற்றான் பொருள்வைப் புழி’ - இதில் ‘வைப்புழி’ என்பதன் பொருள் யாது?"}], "options": [{"key": "A", "text": "செலவிடும் இடம்"}, {"key": "B", "text": "சேமித்து வைக்கும் இடம் (பாதுகாப்பிடம்)"}, {"key": "C", "text": "அழிக்கும் வழி"}, {"key": "D", "text": "வங்கி"}], "explanation": "பொருளுடையவன் ஏழைகளின் பசியைத் தீர்ப்பதே அப்பொருளைப் பிற்காலத்திற்காகச் சேமித்து வைக்கும் பாதுகாப்பிடமாகும்."}}}
{"id": "b-tam-6t2-150", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 47"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘சாதலின் இன்னாதது இல்லை இனிதுஅதூஉம் ஈதல் இயையாக் கடை’ - இக்குறளின் உட்பொருள் யாது?"}], "options": [{"key": "A", "text": "சாவு கொடுமையானது"}, {"key": "B", "text": "ஒரு ஏழைக்கு உதவ முடியாத சூழல் வரும்போது விரும்பத்தகாத சாவும் கூட இனியதாகும்"}, {"key": "C", "text": "ஈகை செய்வோர்க்குச் சாவு இல்லை"}, {"key": "D", "text": "செல்வம் அழிந்தால் இறந்துவிட வேண்டும்"}], "explanation": "ஈதல் செய்ய முடியாத இழிந்த நிலை வருமானால் சாவைக் காட்டிலும் துன்பமானது வேறில்லை; அந்நிலையில் சாவும் இனியதே."}}}
{"id": "b-tam-6t2-151", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 47"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "புதிய பாடத்திட்டத்தின்படி மாணவர்களிடம் திருக்குறளின் நற்பண்புகள் சென்று சேர எத்தனை குறட்பாக்கள் சேர்க்கப்பட்டுள்ளன?"}], "options": [{"key": "A", "text": "100 பாக்கள்"}, {"key": "B", "text": "133 பாக்கள்"}, {"key": "C", "text": "150 பாக்கள்"}, {"key": "D", "text": "200 பாக்கள்"}], "explanation": "பக்கம் 47 வழிகாட்டிக் குறிப்பின்படி, புதிய பாடத்திட்டத்தில் 150 திருக்குறட்பாக்கள் சேர்க்கப்பட்டுள்ளன."}}}
{"id": "b-tam-6t2-152", "kind": "statements", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 47"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பள்ளிகளில் திருக்குறள் வளங்களை மாணவர்களிடம் கொண்டு சேர்க்கப் பாடநூல் பரிந்துரைக்கும் வழிகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "நாள்தோறும் ஒரு திருக்குறளைப் பொருளுடன் வழிபாட்டுக் கூட்டத்திலும் தகவல்பலகையிலும் காட்சிப்படுத்தலாம்."}, {"type": "statement", "label": "II", "text": "திருக்குறள் நாடக விழாக்கள், வினாடி-வினா மற்றும் குறளை இசையமைத்துப் பாடும் நிகழ்வுகளை ஒருங்கிணைக்கலாம்."}, {"type": "statement", "label": "III", "text": "பள்ளி சார்ந்த அழைப்பிதழ்கள் மற்றும் பரிசுச் சான்றிதழ்களில் திருக்குறளை அச்சிட்டு வழங்கலாம்."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "C", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "பாடநூல் பக்கம் 47-ல் உள்ள அனைத்துப் பரிந்துரைகளும் சரியானவை."}}}
{"id": "b-tam-6t2-153", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 43"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘ஒரு இரவும் ஓர் பகலும் சேர்ந்தது ஒருநாள்’ - இத்தொடரிலுள்ள பிழையைத் திருத்தி எழுதுக:"}], "options": [{"key": "A", "text": "ஒரு இரவும் ஒரு பகலும் சேர்ந்தது ஒருநாள்"}, {"key": "B", "text": "ஓர் இரவும் ஒரு பகலும் சேர்ந்தது ஒருநாள்"}, {"key": "C", "text": "ஓர் இரவும் ஓர் பகலும் சேர்ந்தது ஒருநாள்"}, {"key": "D", "text": "ஒரு இரவும் ஓர் பகலும் சேர்ந்தது ஓர்நாள்"}], "explanation": "'இரவு' உயிரெழுத்தில் தொடங்குவதால் 'ஓர் இரவு' எனவும், 'பகல்' உயிர்மெய்யில் தொடங்குவதால் 'ஒரு பகல்' எனவும் திருத்தப்பட வேண்டும்."}}}
{"id": "b-tam-6t2-154", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 43"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அது ஒரு இனிய பாடல்’ - இத்தொடரிலுள்ள பிழையைத் திருத்தி எழுதுக:"}], "options": [{"key": "A", "text": "அது ஓர் இனிய பாடல்"}, {"key": "B", "text": "அஃது ஓர் இனிய பாடல்"}, {"key": "C", "text": "அஃது ஒரு இனிய பாடல்"}, {"key": "D", "text": "அது இனிய பாடல்"}], "explanation": "'ஓர்' உயிரெழுத்து என்பதால் அதன்முன் 'அஃது' வர வேண்டும்; 'இனிய' உயிரெழுத்து என்பதால் அதன்முன் 'ஓர்' வர வேண்டும்; எனவே 'அஃது ஓர் இனிய பாடல்' என்பதே சரியானது."}}}
