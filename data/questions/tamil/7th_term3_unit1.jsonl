{"id":"b-tam-7t3-062","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 17"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இந்தியா கிழக்கே வங்கக் கடல் உள்ளது’ - ‘இன் / இல்’ உருபு சேர்த்து எழுதப்படும் சரியான தொடர் எது?"}],"options":[{"key":"A","text":"இந்தியாவுக்கு கிழக்கில்"},{"key":"B","text":"இந்தியாவின் கிழக்கே வங்கக் கடல் உள்ளது"},{"key":"C","text":"இந்தியாவில் கிழக்கின்"},{"key":"D","text":"இந்தியாவின் கிழக்கில்"}],"explanation":"'இன்' இடைச்சொல் சேர்ந்து 'இந்தியாவின் கிழக்கே வங்கக் கடல் உள்ளது' என அமைவதே முறை."}}}
{"id":"b-tam-7t3-063","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 17"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அறநூல்கள் சிறந்தது திருக்குறள்’ - சரியான உருபுடன் அமையும் தொடர் எது?"}],"options":[{"key":"A","text":"அறநூல்களின் சிறந்தது திருக்குறள்"},{"key":"B","text":"அறநூல்களுள் சிறந்தது திருக்குறள் (இல் உருபு ஒப்புப்பொருளில்)"},{"key":"C","text":"அறநூல்கள் இல் திருக்குறள்"},{"key":"D","text":"அறநூலின் திருக்குறள்"}],"explanation":"அறநூல்களுள் (அறநூல்களில்) சிறந்தது திருக்குறள் என ஒப்பு/எல்லைப் பொருளில் 'இல்' உருபு வரும்."}}}
{"id":"b-tam-7t3-064","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 17"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தூதோலை’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"தூது + தோலை"},{"key":"B","text":"தூது + ஓலை"},{"key":"C","text":"தூ + தோலை"},{"key":"D","text":"தூதோ + லை"}],"explanation":"தூது + ஓலை = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'தூதோலை' எனப் புணரும்."}}}
{"id":"b-tam-7t3-065","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 18"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘என் தாயார் என்னை ________ காத்து வளர்த்தார்’ - பொருத்தமான உவமைத் தொடரைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"கண்ணை இமை காப்பது போல"},{"key":"B","text":"தாயைக் கண்ட சேயைப் போல"},{"key":"C","text":"நகமும் சதையும் போல"},{"key":"D","text":"பசுமரத்தாணி போல"}],"explanation":"பாதுகாப்பிற்குரிய சிறந்த உவமை 'கண்ணை இமை காப்பது போல' என்பதாகும்."}}}
{"id":"b-tam-7t3-066","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 18"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நானும் என் தோழியும் ________ இணைந்து இருப்போம்’ - சரியான உவமை எது?"}],"options":[{"key":"A","text":"இஞ்சி தின்ற குரங்கு போல"},{"key":"B","text":"நகமும் சதையும் போல"},{"key":"C","text":"எலியும் பூனையும் போல"},{"key":"D","text":"கிணற்றுத்தவளை போல"}],"explanation":"ஒற்றுமையோடு இணைந்திருப்பதற்கு 'நகமும் சதையும் போல' என்ற உவமை பயன்படும்."}}}
{"id":"b-tam-7t3-067","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 18"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சிறுவயதில் நான் பார்த்த நிகழ்ச்சிகள் ________ என் மனத்தில் பதிந்தன’ - பொருத்தமான உவமை எது?"}],"options":[{"key":"A","text":"குடத்துள் இட்ட விளக்கு போல"},{"key":"B","text":"பசுமரத்தாணி போல"},{"key":"C","text":"கிணற்றுத்தவளை போல"},{"key":"D","text":"குன்றின்மேலிட்ட விளக்கு போல"}],"explanation":"ஆழமாக நினைவில் பதிவதைப் 'பசுமரத்தாணி போல' என்பர்."}}}
{"id":"b-tam-7t3-068","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 18"},"texts":{"ta":{"blocks":[{"type":"text","text":"வேளாண்மை மற்றும் சமூகக் கலைச்சொற்களைச் சரியாகப் பொருத்துக:"},{"type":"list","name":"ஆங்கிலக் கலைச்சொல்","items":[{"label":"A","text":"Civilization"},{"label":"B","text":"Agriculture"},{"label":"C","text":"Irrigation"},{"label":"D","text":"Cultivation"}]},{"type":"list","name":"தமிழாக்கம்","items":[{"label":"1","text":"வேளாண்மை"},{"label":"2","text":"நாகரிகம்"},{"label":"3","text":"பயிரிடுதல்"},{"label":"4","text":"நீர்ப்பாசனம்"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-4, B-1, C-2, D-3","mapping":{"A":"4","B":"1","C":"2","D":"3"}}],"explanation":"Civilization = நாகரிகம்; Agriculture = வேளாண்மை; Irrigation = நீர்ப்பாசனம்; Cultivation = பயிரிடுதல்."}}}
{"id":"b-tam-7t3-069","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 18"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நாகப்பட்டினம்’ என்னும் சொல்லில் இருந்து உருவாக்க முடியாத புதிய சொல் எது?"}],"options":[{"key":"A","text":"நாகம்"},{"key":"B","text":"வேலி"},{"key":"C","text":"பட்டம்"},{"key":"D","text":"பினம்"}],"explanation":"'வேலி' என்ற சொல் திருநெல்வேலியில் உள்ளதே தவிர நாகப்பட்டினத்தில் இல்லை."}}}
