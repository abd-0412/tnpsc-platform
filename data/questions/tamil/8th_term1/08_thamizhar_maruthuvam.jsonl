// 8-ஆம் வகுப்பு தமிழ் - பருவம் 1 - பாடம் 8: தமிழர் மருத்துவம் (உரைநடை உலகம் - மருத்துவர் கு. சிவராமன்)
// வினாக்கள் எண்ணிக்கை: 5
// ==============================================================================
{"id":"b-tam-8t1-054","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 30"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தமிழர் மருத்துவம்’ என்னும் தலைப்பில் மாணவர்களுடன் உரையாடிய சித்த மருத்துவர் யார்?"}],"options":[{"key":"A","text":"மருத்துவர் கு. இராமசாமி"},{"key":"B","text":"மருத்துவர் கு. சிவராமன்"},{"key":"C","text":"மருத்துவர் மோகனராசு"},{"key":"D","text":"மருத்துவர் பிரபுதாஸ்"}],"explanation":"பள்ளி ஆண்டுமலருக்காகச் சித்த மருத்துவர் கு. சிவராமன் அவர்களிடம் மாணவர்கள் நேர்காணல் செய்கின்றனர்."}}}
{"id":"b-tam-8t1-055","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 31"},"texts":{"ta":{"blocks":[{"type":"text","text":"சித்த மருத்துவத்தில் நாட்பட்ட நோய்களுக்குத் தாவரங்கள் மட்டுமின்றி எவற்றை மருந்தாகப் பயன்படுத்தினர்?"}],"options":[{"key":"A","text":"விலங்குகளின் உறுப்புகளை"},{"key":"B","text":"உலோகங்களையும் பாஷாணங்களையும்"},{"key":"C","text":"கடல் சிப்பிகளை"},{"key":"D","text":"வேதிப் பொருள்களை"}],"explanation":"'வேர்பாரு தழைபாரு மிஞ்சினக்கால் பற்பசெந்தூரம் பாரே' - மூலிகைகளோடு உலோகங்களையும் பாஷாணங்களையும் பயன்படுத்தினர்."}}}
{"id":"b-tam-8t1-056","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 32"},"texts":{"ta":{"blocks":[{"type":"text","text":"நடைமுறையில் உள்ள மருத்துவ முறைகளுள் பொருந்தாத ஒன்றைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"சித்த மருத்துவம்"},{"key":"B","text":"மாயாஜால மருத்துவம்"},{"key":"C","text":"ஆயுர்வேத மருத்துவம்"},{"key":"D","text":"அலோபதி மருத்துவம்"}],"explanation":"பாடநூல் பெட்டகச் செய்தியின்படி சித்த, ஆயுர்வேத, யுனானி மற்றும் அலோபதி ஆகியவை நடைமுறையில் உள்ள மருத்துவ முறைகளாகும்; மாயாஜால மருத்துவம் என்பது இதில் பொருந்தாதது."}}}
{"id":"b-tam-8t1-057","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 34"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தமிழர் மருத்துவம்’ பாடத்தின்படி மனிதன் நோய்கள் பெருக முக்கியக் காரணமாக விளங்குவது எது?"}],"options":[{"key":"A","text":"நகரமயமாக்கல்"},{"key":"B","text":"இயற்கையை விட்டு விலகி வந்தது"},{"key":"C","text":"உறக்கமின்மை"},{"key":"D","text":"மரபணு மாற்றம்"}],"explanation":"மனிதன் இயற்கையைவிட்டு விலகி வந்தது, மாறிப்போன உணவுப்பழக்கம், மாசு நிறைந்த சுற்றுச்சூழல் ஆகியவை நோய்ப் பெருக்கத்திற்குக் காரணம்."}}}
{"id":"b-tam-8t1-058","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 34"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘உணவுக்காகச் சமையலறையில் செலவிடும் நேரத்தை, ________ செலவிடும் நேரம் என நினைக்க வேண்டும்’ - மருத்துவர் சிவராமன் கூறுவது யாது?"}],"options":[{"key":"A","text":"உடற்பயிற்சிக்காக"},{"key":"B","text":"மகிழ்ச்சிக்காக"},{"key":"C","text":"நம் நல்வாழ்விற்காக"},{"key":"D","text":"சுவைக்காக"}],"explanation":"சமையலறையில் செலவிடும் நேரத்தைத் தன் நல்வாழ்விற்காகச் செலவிடும் நேரமாகக் கருத வேண்டும்."}}}
