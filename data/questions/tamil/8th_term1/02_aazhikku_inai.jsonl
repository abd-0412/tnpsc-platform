// 8-ஆம் வகுப்பு தமிழ் - பருவம் 1 - பாடம் 2: ஆழிக்கு இணை (கவிதைப்பேழை - சந்தக்கவிமணி தமிழழகனார்)
// வினாக்கள் எண்ணிக்கை: 8
// ==============================================================================
{"id":"b-tam-8t1-010","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 5"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘முத்தமிழ் துய்ப்பதால் முச்சங்கம் கண்டதால் மெத்த வணிகலமும் மேவலால்...’ - என்னும் ‘ஆழிக்கு இணை’ பாடலை இயற்றிய கவிஞர் யார்?"}],"options":[{"key":"A","text":"தமிழழகனார்"},{"key":"B","text":"சந்தக்கவிமணி தமிழழகனார்"},{"key":"C","text":"பாரதிதாசன்"},{"key":"D","text":"காளமேகப் புலவர்"}],"explanation":"தமிழையும் கடலையும் இரட்டுற மொழிந்து பாடியவர் சந்தக்கவிமணி தமிழழகனார் ஆவார்."}}}
{"id":"b-tam-8t1-011","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 5"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஆழிக்கு இணை’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"துய்ப்பதால்"},{"label":"B","text":"மேவலால்"},{"label":"C","text":"நித்தம்"},{"label":"D","text":"ஆழி"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"பொருந்துதலால், பெறுதலால்"},{"label":"2","text":"கற்பதால், தருதலால்"},{"label":"3","text":"கடல்"},{"label":"4","text":"நாள்தோறும்"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}}],"explanation":"துய்ப்பதால் = கற்பதால், தருதலால்; மெத்த வணிகலம் = அணிகலன், பெரிய வணிகக் கப்பல்; மேவலால் = பொருந்துதலால், பெறுதலால்; நித்தம் = நாள்தோறும்; ஆழி = கடல்."}}}
{"id":"b-tam-8t1-012","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ்த்தாய் ஐம்பெருங்காப்பியங்களை எவ்வாறாக அணிந்துள்ளதாகத் தமிழழகனார் குறிப்பிடுகிறார்?"}],"options":[{"key":"A","text":"மாலையாக"},{"key":"B","text":"ஆடையாக"},{"key":"C","text":"அணிகலன்களாக (வணிகலன்)"},{"key":"D","text":"மகுடமாக"}],"explanation":"ஐம்பெருங்காப்பியங்களை அணிகலன்களாகவும் (மெத்த வணிகலம்), கடல் பெரிய வணிகக் கப்பல்களாகவும் விளங்குகின்றன."}}}
{"id":"pyq-tam-8t1-013","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":22},"texts":{"ta":{"blocks":[{"type":"text","text":"ஒரு சொல் அல்லது தொடர் இருபொருள் தருமாறு பாடும் அணி எது?"}],"options":[{"key":"A","text":"உவமையணி"},{"key":"B","text":"இரட்டுறமொழிதல் அணி (சிலேடை)"},{"key":"C","text":"ஏகதேச உவமையணி"},{"key":"D","text":"பிரிதுமொழிதல் அணி"}],"explanation":"ஒரு சொல் அல்லது தொடர் இரு பொருள் தருமாறு அமைவது இரட்டுறமொழிதல் (சிலேடை) அணி எனப்படும்."}}}
{"id":"b-tam-8t1-014","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சந்தக்கவிமணி’ என்று அழைக்கப்படும் தமிழழகனாரின் இயற்பெயர் யாது?"}],"options":[{"key":"A","text":"சுவாமிநாதன்"},{"key":"B","text":"சண்முகசுந்தரம்"},{"key":"C","text":"இராசகோபாலன்"},{"key":"D","text":"முத்தையா"}],"explanation":"தமிழழகனாரின் இயற்பெயர் சண்முகசுந்தரம் ஆகும்; இவர் இளம்வயதிலேயே இலக்கணப் புலமை பெற்றவர்."}}}
{"id":"b-tam-8t1-015","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஆழிக்கு இணை’ என்னும் பாடல் எந்த நூலிலிருந்து எடுக்கப்பட்டுள்ளது?"}],"options":[{"key":"A","text":"நாலாயிரத் திவ்யப் பிரபந்தம்"},{"key":"B","text":"தனிப்பாடல் திரட்டு (ஐந்தாம் பகுதி கழகப் பதிப்பு)"},{"key":"C","text":"பன்னிரு திருமுறை"},{"key":"D","text":"புறநானூறு"}],"explanation":"புலவர் பலரின் பாடல்களின் தொகுப்பான 'தனிப்பாடல் திரட்டு' நூலிலிருந்து இப்பாடல் எடுக்கப்பட்டுள்ளது."}}}
{"id":"b-tam-8t1-016","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 7"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘முத்தமிழ்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"முத்து + தமிழ்"},{"key":"B","text":"மூன்று + தமிழ்"},{"key":"C","text":"மு + தமிழ்"},{"key":"D","text":"முத் + தமிழ்"}],"explanation":"மூன்று + தமிழ் = இயல், இசை, நாடகம் என்ற மூன்றும் இணைந்த முத்தமிழ் எனப் புணரும்."}}}
{"id":"b-tam-8t1-046","kind":"assertion_reason","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 5"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"தமிழழகனார் இயற்றிய ‘ஆழிக்கு இணை’ என்னும் பாடல் இரட்டுறமொழிதல் அணிக்குச் சிறந்த சான்றாகும்."},{"type":"reason","text":"இப்பாடலில் பயின்றுவரும் சொற்கள் ஒருசேரத் தமிழையும் கடலையும் குறிக்கும் வகையில் இருவேறு பொருள்களைத் தருமாறு அமைக்கப்பட்டுள்ளன."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"ஒரு சொல் அல்லது தொடர் இரு பொருள் தருவதால் இது இரட்டுறமொழிதல் அணி ஆகும்; கூற்றும் காரணமும் சரி."}}}
