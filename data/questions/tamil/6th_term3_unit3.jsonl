{"id":"b-tam-6t3-154","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 49"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தமக்கென முயலா நோன்றாள் பிறர்க்கென முயலுநர் உண்மை யானே’ - என்ற புகழ்பெற்ற மனிதநேயப் பாடல் வரிகள் இடம்பெற்றுள்ள சங்க இலக்கிய நூல் எது?"}],"options":[{"key":"A","text":"அகநானூறு"},{"key":"B","text":"புறநானூறு (பாடல் 182)"},{"key":"C","text":"நற்றிணை"},{"key":"D","text":"குறுந்தொகை"}],"explanation":"இளம்பெருவழுதி பாடிய புறநானூற்றின் 182-ஆம் பாடல் வரிகள் மனிதநேயத்தின் உண்மையை விளக்குகின்றன."}}}
{"id":"b-tam-6t3-155","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 49"},"texts":{"ta":{"blocks":[{"type":"text","text":"சத்திரத்துத் திண்ணையில் படுத்திருந்தபோது தன் காதிலிருந்த தங்கக் கடுக்கனைக் கழற்றிய திருடனிடம் மறு காதைக் காட்டித் திரும்பிய அருள்வள்ளல் யார்?"}],"options":[{"key":"A","text":"தாயுமானவர்"},{"key":"B","text":"இராமலிங்க அடிகளார் (வள்ளலார்)"},{"key":"C","text":"அன்னை தெரசா"},{"key":"D","text":"போதிதர்மர்"}],"explanation":"திருடனைத் திருடன் என்று காட்டிக் கொடுக்காமல் அவனுக்கும் அன்பு காட்டியவர் வள்ளலார் ஆவார்."}}}
{"id":"pyq-tam-6t3-156","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2018,"paper":"tamil","no":12},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வாடிய பயிரைக் கண்டபோதெல்லாம் வாடினேன்’ - என்று பாடிய ஜீவகாருண்ய ஒழுக்கச் சீலர் யார்?"}],"options":[{"key":"A","text":"பாரதியார்"},{"key":"B","text":"வள்ளலார்"},{"key":"C","text":"பாரதிதாசன்"},{"key":"D","text":"தாயுமானவர்"}],"explanation":"பயிர் வாடுவதைக் கண்டும் உள்ளம் உருகிப் பாடியவர் திருவருட்பிரகாச வள்ளலார்."}}}
{"id":"b-tam-6t3-157","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 50"},"texts":{"ta":{"blocks":[{"type":"text","text":"மக்களின் பசிப்பிணியைப் போக்க வள்ளலார் வடலூரில் ‘சத்திய தருமச்சாலையைத்’ தொடங்கியதன் சிறப்பு யாது?"}],"options":[{"key":"A","text":"அங்கு மாநாடுகள் நடத்தப்பட்டன"},{"key":"B","text":"அவர் ஏற்றிய அணையா அடுப்பு மூலம் இன்றும் தொடர்ந்து பசித்தோருக்கு உணவளிக்கப்பட்டு வருகிறது"},{"key":"C","text":"பள்ளிக்கூடம் அமைக்கப்பட்டது"},{"key":"D","text":"மருத்துவமனை தொடங்கப்பட்டது"}],"explanation":"வள்ளலார் வடலூரில் பசிப்பிணி போக்கத் தொடங்கிய சத்திய தருமச்சாலையின் அடுப்பு இன்றும் அணையாமல் பசி தீர்த்து வருகிறது."}}}
{"id":"b-tam-6t3-158","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 50"},"texts":{"ta":{"blocks":[{"type":"text","text":"சாலையோரத்தில் ஆதரவற்று விரல்கள் இன்றிப் பூனையுடன் கிடந்த மூதாட்டியைக் கண்டு கண்ணீர் விட்டு தொழுநோயாளிகளுக்கு வாழ்நாள் தொண்டாற்றியவர் யார்?"}],"options":[{"key":"A","text":"அன்னி பெசன்ட்"},{"key":"B","text":"புஷ்பாஞ்சலி"},{"key":"C","text":"அன்னை தெரசா"},{"key":"D","text":"கல்பனா சாவ்லா"}],"explanation":"தொழுநோயாளிகளைத் தொட்டுத் தூக்கி அன்போடு ஆதரவளித்தவர் அன்னை தெரசா ஆவார்."}}}
{"id":"b-tam-6t3-159","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 51"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வாழ்க்கை என்பது நீ சாகும் வரை அல்ல; மற்றவர் மனதில் நீ வாழும் வரை!’ - என்ற பொன்மொழியை உரைத்தவர் யார்?"}],"options":[{"key":"A","text":"காந்தியடிகள்"},{"key":"B","text":"வள்ளலார்"},{"key":"C","text":"அன்னை தெரசா"},{"key":"D","text":"கைலாஷ் சத்யார்த்தி"}],"explanation":"பக்கம் 51 தெரிந்து தெளிவோம் பகுதியில் இத்தத்துவப் பொன்மொழியை அன்னை தெரசா உரைத்ததாகக் குறிப்பிடப்பட்டுள்ளது."}}}
{"id":"pyq-tam-6t3-160","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":64},"texts":{"ta":{"blocks":[{"type":"text","text":"அன்னை தெரசாவிற்கு அடுத்து அமைதிக்கான நோபல் பரிசு பெற்ற இந்தியர் யார்?"}],"options":[{"key":"A","text":"அமர்த்தியா சென்"},{"key":"B","text":"கைலாஷ் சத்யார்த்தி"},{"key":"C","text":"சி.வி. இராமன்"},{"key":"D","text":"அப்துல் கலாம்"}],"explanation":"அன்னை தெரசாவிற்கு அடுத்து அமைதிக்கான நோபல் பரிசு பெற்ற இந்தியர் கைலாஷ் சத்யார்த்தி ஆவார்."}}}
{"id":"b-tam-6t3-161","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 51"},"texts":{"ta":{"blocks":[{"type":"text","text":"கைலாஷ் சத்யார்த்தி குழந்தைத் தொழிலாளர் முறையை ஒழிக்கத் தொடங்கிய இயக்கத்தின் பெயர் யாது?"}],"options":[{"key":"A","text":"குழந்தைகளைப் பாதுகாப்போம் (Bachpan Bachao Andolan)"},{"key":"B","text":"குழந்தைகளை நேசிப்போம்"},{"key":"C","text":"குழந்தைகள் கல்வி இயக்கம்"},{"key":"D","text":"இளைய பாரதம்"}],"explanation":"கைலாஷ் சத்யார்த்தி தொடங்கிய இயக்கம் 'குழந்தைகளைப் பாதுகாப்போம்' ஆகும்."}}}
{"id":"b-tam-6t3-162","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 51"},"texts":{"ta":{"blocks":[{"type":"text","text":"கைலாஷ் சத்யார்த்தியின் சாதனைகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"கடந்த முப்பது ஆண்டுகளில் 86,000 குழந்தைத் தொழிலாளர்களை மீட்டுள்ளார்."},{"type":"statement","label":"II","text":"உலகக் குழந்தைகள் கல்வி உரிமைக்காக 103 நாடுகளில் 80,000 கி.மீ தூரம் நடைப்பயணம் சென்றுள்ளார்."},{"type":"statement","label":"III","text":"‘குழந்தைகளைத் தொழிலாளர்களாக மாற்றுவது மனிதத் தன்மைக்கு எதிரான குற்றம்; உலகத்தைக் குழந்தைகளின் கண் கொண்டு பாருங்கள்’ என்று முழங்கியுள்ளார்."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"பாடப்பகுதியில் இடம்பெற்றுள்ள கைலாஷ் சத்யார்த்தி பற்றிய மூன்று புள்ளிவிவரக் கூற்றுகளும் முற்றிலும் சரியானவை."}}}
{"id":"b-tam-6t3-163","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"3","C":"1"}},"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 52"},"texts":{"ta":{"blocks":[{"type":"text","text":"மனிதநேயப் பண்பாளர்களை அவர்தம் தொண்டுகளோடு சரியாகப் பொருத்துக:"},{"type":"list","name":"சான்றோர்","items":[{"label":"A","text":"வள்ளலார்"},{"label":"B","text":"கைலாஷ் சத்யார்த்தி"},{"label":"C","text":"அன்னை தெரசா"}]},{"type":"list","name":"தொண்டு","items":[{"label":"1","text":"நோயாளிகளிடம் அன்பு காட்டியவர்"},{"label":"2","text":"பசிப்பிணி போக்கியவர்"},{"label":"3","text":"குழந்தைகள் உரிமைக்குப் பாடுபட்டவர்"}]}],"options":[{"key":"A","text":"A-2, B-3, C-1","mapping":{"A":"2","B":"3","C":"1"}},{"key":"B","text":"A-1, B-2, C-3","mapping":{"A":"1","B":"2","C":"3"}},{"key":"C","text":"A-3, B-1, C-2","mapping":{"A":"3","B":"1","C":"2"}},{"key":"D","text":"A-2, B-1, C-3","mapping":{"A":"2","B":"1","C":"3"}}],"explanation":"வள்ளலார் - பசிப்பிணி போக்கியவர்; கைலாஷ் சத்யார்த்தி - குழந்தைகள் உரிமைக்குப் பாடுபட்டவர்; அன்னை தெரசா - நோயாளிகளிடம் அன்பு காட்டியவர்."}}}
{"id":"b-tam-6t3-164","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 55"},"texts":{"ta":{"blocks":[{"type":"text","text":"விபத்தில் மூளைச்சாவு அடைந்த தம் மகன் ஹிதேந்திரனின் துடிக்கும் இதயத்தையே உறுப்புக்கொடையாகத் தந்து உறுப்புதான விழிப்புணர்வை ஏற்படுத்திய மருத்துவர்கள் யார்?"}],"options":[{"key":"A","text":"சாரங்கபாணி - சாவித்திரி தம்பதியினர்"},{"key":"B","text":"அசோகன் - புஷ்பாஞ்சலி மருத்துவத் தம்பதியினர்"},{"key":"C","text":"இராதாகிருஷ்ணன் - வசந்தா தம்பதியினர்"},{"key":"D","text":"சுந்தரம் - மஞ்சுளா தம்பதியினர்"}],"explanation":"திருக்கழுக்குன்றத்தைச் சேர்ந்த அசோகன் - புஷ்பாஞ்சலி என்ற மருத்துவத் தம்பதியினர் தம் மகன் ஹிதேந்திரனின் இதயத்தை உறுப்புக் கொடையாகத் தந்தனர்."}}}
{"id":"b-tam-6t3-165","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 55"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஹிதேந்திரனின் இதயம் எந்த ஊரில் இதய நோய் முற்றி உயிருக்குப் போராடிக்கொண்டிருந்த சிறுமிக்குப் பொருத்தப்பட்டது?"}],"options":[{"key":"A","text":"சென்னை"},{"key":"B","text":"மதுரை"},{"key":"C","text":"பெங்களூரு"},{"key":"D","text":"ஹைதராபாத்"}],"explanation":"பெங்களூருவில் இதய மாற்று அறுவை சிகிச்சைக்குக் காத்திருந்த சிறுமிக்கு ஹிதேந்திரனின் இதயம் வெற்றிகரமாகப் பொருத்தப்பட்டது."}}}
