// பாடம் 6: திருக்குறள் & கூடுதல் வினாக்கள் (வாழ்வியல் & இலக்கணம்) [Q183 - Q200]
// கள்ளாமை (எள்ளாமை, விழுமம்), இன்னா செய்யாமை (மாசுஅற்றார் கோள், பிற்பகல், செற்றார்),
// கொல்லாமை, ஊக்கமுடைமை (வெரூஉம், மரம்மக்கள்), பெரியாரைப் பிழையாமை (இடும்பை, கூற்றம், ஏந்திய கொள்கையார்),
// இடப்பெயர், பண்புப்பெயர், தொழிற்பெயர், இடுகுறி பொதுப்பெயர் கூற்று-காரணம், ஹிதேந்திரன் (திருக்கழுக்குன்றம்)
// ==============================================================================
{"id":"b-tam-6t3-183","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 62"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எள்ளாமை வேண்டுவான் என்பான் எனைத்துஒன்றும் கள்ளாமை காக்கதன் நெஞ்சு’ - இதில் ‘எள்ளாமை’ என்பதன் பொருள் யாது?"}],"options":[{"key":"A","text":"புகழ் பெறுதல்"},{"key":"B","text":"பிறரால் இகழப்படாமல் (வசை இல்லாமல்) வாழ்தல்"},{"key":"C","text":"செல்வம் சேர்த்தல்"},{"key":"D","text":"தானம் செய்தல்"}],"explanation":"பிறரால் இகழப்படாமல் வாழ விரும்புகின்றவன் எவ்வகையான திருட்டையும் தன் உள்ளத்தில் நினையாமல் காக்க வேண்டும்."}}}
{"id":"b-tam-6t3-184","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 62"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘களவின்கண் கன்றிய காதல் விளைவின்கண் வீயா விழுமம் தரும்’ - இக்குறட்பாவில் ‘விழுமம்’ என்பதன் பொருள் யாது?"}],"options":[{"key":"A","text":"மகிழ்ச்சி"},{"key":"B","text":"வெற்றி"},{"key":"C","text":"நீங்காத துன்பம்"},{"key":"D","text":"அழிவு"}],"explanation":"விழுமம் என்றால் துன்பம் என்று பொருள். களவு செய்வதில் அதிக ஆசை வைத்தால் முடிவில் நீங்காத துன்பம் தரும்."}}}
{"id":"b-tam-6t3-185","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 62"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சிறப்புஈனும் செல்வம் பெறினும் பிறர்க்குஇன்னா செய்யாமை மாசுஅற்றார் கோள்’ - இக்குறட்பாவின்படி தூய நெஞ்சினரின் கொள்கை எது?"}],"options":[{"key":"A","text":"செல்வத்தை ஈட்டுவது"},{"key":"B","text":"சிறப்பைத் தரும் பெருஞ்செல்வம் கிடைப்பினும் பிறருக்குத் துன்பம் செய்யாதிருப்பது"},{"key":"C","text":"அரசனைப் போற்றுவது"},{"key":"D","text":"நாட்டை ஆள்வது"}],"explanation":"சிறப்புமிக்க செல்வம் கிடைத்தாலும் பிறர்க்குத் துன்பம் செய்யாமையே குற்றமற்ற மாசற்ற பெரியோரின் கொள்கையாகும்."}}}
{"id":"pyq-tam-6t3-186","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":71},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பிறர்க்குஇன்னா முற்பகல் செய்யின் தமக்குஇன்னா ________ தாமே வரும்’ - விடுபட்ட சீர் எது?"}],"options":[{"key":"A","text":"மறுபகல்"},{"key":"B","text":"பிற்பகல்"},{"key":"C","text":"அந்திப்பகல்"},{"key":"D","text":"மறுநாள்"}],"explanation":"\"பிறர்க்குஇன்னா முற்பகல் செய்யின் தமக்குஇன்னா பிற்பகல் தாமே வரும்\" (முற்பகலில் கொடுமை செய்தால் பிற்பகலில் அக்கொடுமை தானே வந்து சேரும்)."}}}
{"id":"b-tam-6t3-187","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 62"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘செய்யாமல் செற்றார்க்கும் இன்னாத செய்தபின் உய்யா விழுமம் தரும்’ - இதில் ‘செற்றார்’ என்பதன் பொருள் யாது?"}],"options":[{"key":"A","text":"நண்பர்"},{"key":"B","text":"பகைத்தவர் (பகைவர்)"},{"key":"C","text":"சான்றோர்"},{"key":"D","text":"உறவினர்"}],"explanation":"செற்றார் என்றால் பகைவர் என்று பொருள்; நாம் ஒரு தீங்கும் செய்யாத நிலையில் வலிய வந்து பகைத்தவர்க்கும் துன்பம் செய்யலாகாது."}}}
{"id":"b-tam-6t3-188","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 63"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அறவினை யாதுஎனின் கொல்லாமை; கோறல் பிறவினை எல்லாம் தரும்’ - இதில் அறங்கள் எல்லாவற்றிலும் தலையாய அறமாக வள்ளுவர் எதனைக் கூறுகிறார்?"}],"options":[{"key":"A","text":"தானம் செய்தல்"},{"key":"B","text":"கொல்லாமை (எவ்வுயிரையும் கொல்லாதிருத்தல்)"},{"key":"C","text":"வாய்மை பேசுதல்"},{"key":"D","text":"தவம் செய்தல்"}],"explanation":"எவ்வுயிரையும் கொல்லாதிருத்தலே தலையாய அறமாகும்; பிற உயிரைக் கொல்லுதல் எல்லாத் தீமைகளையும் கொண்டுவந்து சேர்க்கும்."}}}
{"id":"b-tam-6t3-189","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 63"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தன்உயிர் நீப்பினும் செய்யற்க தான்பிறிது இன்உயிர் நீக்கும் வினை’ - இக்குறட்பா உணர்த்தும் செய்தி யாது?"}],"options":[{"key":"A","text":"தன் உயிரைக் காக்கப் பிற உயிரைக் கொல்லலாம்"},{"key":"B","text":"போரில் பகைவரைக் கொல்லலாம்"},{"key":"C","text":"தன் உயிரே போகும் நிலை வந்தாலும் பிறிதோர் உயிரைப் போக்கும் தீய வினையைச் செய்யக்கூடாது"},{"key":"D","text":"அரசனுக்காக உயிரை விடலாம்"}],"explanation":"தன்னுடைய இன்னுயிரே அழியும் சூழல் வரினும் மற்றோர் உயிரைப் போக்கும் கொலை வினையை எக்காலத்தும் செய்யலாகாது."}}}
{"id":"b-tam-6t3-190","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 63"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘உடையர் எனப்படுவது ஊக்கம் அஃதுஇல்லார் உடையது உடையரோ மற்று’ - ஒருவனுக்கு உண்மையான உடைமையாக அமைவது எது?"}],"options":[{"key":"A","text":"பொருட்செல்வம்"},{"key":"B","text":"ஊக்கமுடைமை"},{"key":"C","text":"அணிகலன்"},{"key":"D","text":"நிலவுடைமை"}],"explanation":"ஊக்கமே ஒருவருக்கு நிலையான சொத்தாகும்; ஊக்கம் இல்லாதவர் பிற செல்வங்களைப் பெற்றிருந்தாலும் எதையும் உடையவராகார்."}}}
{"id":"b-tam-6t3-191","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 63"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பரியது கூர்ங்கோட்டது ஆயினும் யானை வெரூஉம் புலிதாக் குறின்’ - இக்குறட்பாவில் ‘வெரூஉம்’ என்பதன் பொருள் யாது?"}],"options":[{"key":"A","text":"எதிர்த்து நிற்கும்"},{"key":"B","text":"அஞ்சும் (பயப்படும்)"},{"key":"C","text":"தாக்கும்"},{"key":"D","text":"வெற்றி பெறும்"}],"explanation":"வெரூஉம் என்றால் அஞ்சும் என்று பொருள். உடலால் பெரிதாகவும் கூர்மையான தந்தங்களை உடையதாகவும் இருப்பினும் புலி தாக்கினால் யானை அஞ்சி நடுங்கும்."}}}
{"id":"b-tam-6t3-192","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 63"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘உரம்ஒருவற்கு உள்ள வெறுக்கை அஃது இல்லார் மரம்மக்கள் ஆதலே வேறு’ - ஊக்கம் இல்லாத மனிதர்களை வள்ளுவர் எதனோடு ஒப்பிடுகிறார்?"}],"options":[{"key":"A","text":"கல்லோடு"},{"key":"B","text":"மரத்தோடு (உயிரற்ற மரம்)"},{"key":"C","text":"விலங்கோடு"},{"key":"D","text":"புல்லோடு"}],"explanation":"ஊக்கமிகுதியே வலிமை; மன ஊக்கம் இல்லாதவர் வடிவத்தால் மனிதர் போன்றிருப்பினும் நடைமுறையில் மரத்திற்கு ஒப்பாவர்."}}}
{"id":"b-tam-6t3-193","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 64"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பெரியாரைப் பேணாது ஒழுகின் பெரியாரால் பேரா இடும்பை தரும்’ - இதில் ‘இடும்பை’ என்னும் சொல்லின் பொருள் யாது?"}],"options":[{"key":"A","text":"பகை"},{"key":"B","text":"நீங்காத பெருந்துன்பம்"},{"key":"C","text":"இழிவு"},{"key":"D","text":"வறுமை"}],"explanation":"இடும்பை என்றால் துன்பம் என்று பொருள். ஆற்றல்மிக்க சான்றோரை மதியாது நடந்தால் தவிர்க்க முடியாத பெருந்துன்பம் உண்டாகும்."}}}
{"id":"b-tam-6t3-194","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 64"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கூற்றத்தைக் கையால் விளித்துஅற்றால் ஆற்றுவார்க்கு ஆற்றாதார் இன்னா செயல்’ - வலியவருக்கு மெலியவர் துன்பம் செய்வது எதைப் போன்றது?"}],"options":[{"key":"A","text":"நெருப்பில் விழுவது போன்றது"},{"key":"B","text":"கடலில் குதிப்பது போன்றது"},{"key":"C","text":"யமனைத் தன் கையசைத்துத் தானே வரவழைத்துக் கொள்வது போன்றது"},{"key":"D","text":"விஷத்தைக் குடிப்பது போன்றது"}],"explanation":"ஆற்றல் மிகுந்த பெரியவர்க்கு மெலியவர் தீங்கு செய்ய நினைப்பது கூற்றுவனைத் (எமனை) தன் கையால் கூப்பிட்டு அழைப்பதற்கு ஒப்பாகும்."}}}
{"id":"b-tam-6t3-195","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 64"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஏந்திய கொள்கையார் சீறின் இடைமுரிந்து வேந்தனும் வேந்து கெடும்’ - உயர்ந்த கொள்கையுடைய சான்றோர்கள் சினம் கொண்டால் யாருக்குப் பேரழிவு உண்டாகும்?"}],"options":[{"key":"A","text":"குடிமக்களுக்கு"},{"key":"B","text":"அரசனும் அவனது அரசாட்சியும் இடைநடுவே அழியும்"},{"key":"C","text":"வணிகர்களுக்கு"},{"key":"D","text":"போர்ப்படைக்கு"}],"explanation":"மேலான கொள்கையுடைய பெரியவர்கள் சீறினால் நாட்டின் அரசனும் தன் அரச பதவியை இழந்து வழியின்றி அழிவான்."}}}
{"id":"b-tam-6t3-196","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 56"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘காவியா பள்ளிக்குச் சென்றாள்’ - இத்தொடரில் ‘பள்ளி’ என்பது எவ்வகைப் பெயர்ச்சொல்?"}],"options":[{"key":"A","text":"பொருட்பெயர்"},{"key":"B","text":"இடப்பெயர்"},{"key":"C","text":"காலப்பெயர்"},{"key":"D","text":"தொழிற்பெயர்"}],"explanation":"ஓர் இடத்தின் பெயரைக் குறிப்பதால் 'பள்ளி' என்பது இடப்பெயர் ஆகும்."}}}
{"id":"b-tam-6t3-197","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 56"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘காவியா இனிமையாகப் பேசுவாள்’ - இதில் ‘இனிமை’ என்பது எவ்வகைப் பெயர்ச்சொல்?"}],"options":[{"key":"A","text":"பொருட்பெயர்"},{"key":"B","text":"சினைப்பெயர்"},{"key":"C","text":"பண்புப்பெயர்"},{"key":"D","text":"தொழிற்பெயர்"}],"explanation":"பொருளின் அல்லது குணத்தின் தன்மையைக் குறிப்பதால் 'இனிமை' என்பது பண்புப்பெயர் ஆகும்."}}}
{"id":"b-tam-6t3-198","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 56"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘காவியாவுக்கு நடனம் ஆடுதல் பிடிக்கும்’ - இதில் ‘ஆடுதல்’ என்பது எவ்வகைப் பெயர்ச்சொல்?"}],"options":[{"key":"A","text":"பொருட்பெயர்"},{"key":"B","text":"சினைப்பெயர்"},{"key":"C","text":"காலப்பெயர்"},{"key":"D","text":"தொழிற்பெயர்"}],"explanation":"ஒரு தொழிலையோ செயலையோ குறிக்கும் சொல் 'தொழிற்பெயர்' எனப்படும்."}}}
{"id":"b-tam-6t3-199","kind":"assertion_reason","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 57"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"‘மரம், காடு’ ஆகிய சொற்கள் இடுகுறிப் பொதுப்பெயர்கள் ஆகும்."},{"type":"reason","text":"நம் முன்னோர் காரணம் கருதாமல் அத்தன்மையுடைய எல்லாப் பொருள்களுக்கும் பொதுவாக இட்டு வழங்கியதால் இவை இடுகுறிப் பொதுப்பெயர்கள் எனப்படுகின்றன."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"காரணம் கருதாமல் எல்லா மரங்களையும் குறிப்பதால் மரம் என்பது இடுகுறிப் பொதுப்பெயராகும்; கூற்றும் காரணமும் சரி."}}}
{"id":"b-tam-6t3-200","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 55"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பிறந்தபோது பெற்றோரின் இதயத்தைக் கொள்ளை கொண்டதால் ஹிதேந்திரன் என்று பெயரிடப்பட்டான்; இறந்தபோது உலகத்தார் இதயங்களை எல்லாம் கொள்ளை கொண்டான்’ - என்று போற்றப்படும் இளைஞன் வாழ்ந்த ஊர் எது?"}],"options":[{"key":"A","text":"சென்னை"},{"key":"B","text":"மதுரை"},{"key":"C","text":"திருக்கழுக்குன்றம்"},{"key":"D","text":"காஞ்சிபுரம்"}],"explanation":"உறுப்புதான வரலாற்றில் நிலைத்து நிற்கும் ஹிதேந்திரன் திருக்கழுக்குன்றத்தைச் சேர்ந்த மருத்துவர்களின் மகன் ஆவார்."}}}
