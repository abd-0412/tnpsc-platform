// பாடம் 4: பெயர்ச்சொல் / இடுகுறிப்பெயர் & காரணப்பெயர் (கற்கண்டு - இலக்கணம்) [Q166 - Q178]
// அறுவகைப் பெயர்ச்சொற்கள், இடுகுறிப்பெயர் (பொது/சிறப்பு), காரணப்பெயர் (பொது/சிறப்பு),
// பெயர்ச்சொல் பகுப்பாய்வு (மண், வளையல், வாழை, கைகள், மாலை)
// ==============================================================================
{"id":"b-tam-6t3-166","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 56"},"texts":{"ta":{"blocks":[{"type":"text","text":"பொருளின் தன்மையைக் குறிக்கும் பெயர்ச்சொல் மொத்தம் எத்தனை வகைப்படும்?"}],"options":[{"key":"A","text":"நான்கு வகைப்படும்"},{"key":"B","text":"ஆறு வகைப்படும் (பொருள், இடம், காலம், சினை, பண்பு, தொழில்)"},{"key":"C","text":"எட்டு வகைப்படும்"},{"key":"D","text":"பத்து வகைப்படும்"}],"explanation":"பெயர்ச்சொல் பொருட்பெயர், இடப்பெயர், காலப்பெயர், சினைப்பெயர், பண்புப்பெயர், தொழிற்பெயர் என ஆறு வகைப்படும்."}}}
{"id":"b-tam-6t3-167","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"4","C":"1","D":"2"}},"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 56"},"texts":{"ta":{"blocks":[{"type":"text","text":"அறுவகைப் பெயர்ச்சொற்களுக்குரிய சரியான சான்றுகளைப் பொருத்துக:"},{"type":"list","name":"பெயர் வகை","items":[{"label":"A","text":"பொருட்பெயர்"},{"label":"B","text":"சினைப்பெயர்"},{"label":"C","text":"பண்புப்பெயர்"},{"label":"D","text":"தொழிற்பெயர்"}]},{"type":"list","name":"சான்று","items":[{"label":"1","text":"வட்டம், செம்மை"},{"label":"2","text":"படித்தல், ஆடுதல்"},{"label":"3","text":"மரம், புத்தகம்"},{"label":"4","text":"கண், கிளை"}]}],"options":[{"key":"A","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"D","text":"A-4, B-3, C-2, D-1","mapping":{"A":"4","B":"3","C":"2","D":"1"}}],"explanation":"பொருட்பெயர் = மரம், புத்தகம்; சினைப்பெயர் = உறுப்புகளைக் குறிக்கும் கண், கிளை; பண்புப்பெயர் = வட்டம், செம்மை; தொழிற்பெயர் = படித்தல், ஆடுதல்."}}}
{"id":"b-tam-6t3-168","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 57"},"texts":{"ta":{"blocks":[{"type":"text","text":"நம் முன்னோர் சில பொருள்களுக்குக் ‘காரணம் கருதாமல்’ இட்டு வழங்கிய பெயர்கள் எவ்வாறு அழைக்கப்படும்?"}],"options":[{"key":"A","text":"காரணப்பெயர்"},{"key":"B","text":"இடுகுறிப்பெயர் (எ.கா: மண், மரம், காற்று)"},{"key":"C","text":"ஆகுபெயர்"},{"key":"D","text":"அன்மொழித்தொகை"}],"explanation":"காரணம் ஏதுமின்றி நம் முன்னோர் இட்டு வழங்கிய தொன்மையான பெயர்கள் இடுகுறிப்பெயர்கள் எனப்படும்."}}}
{"id":"b-tam-6t3-169","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 57"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஓர் இடுகுறிப்பெயர் அத்தன்மை உடைய எல்லாப் பொருள்களையும் பொதுவாகக் குறிப்பது எவ்வாறு அழைக்கப்படும்?"}],"options":[{"key":"A","text":"இடுகுறிச் சிறப்புப்பெயர்"},{"key":"B","text":"இடுகுறிப் பொதுப்பெயர் (எ.கா: மரம், காடு)"},{"key":"C","text":"காரணப் பொதுப்பெயர்"},{"key":"D","text":"காரணச் சிறப்புப்பெயர்"}],"explanation":"எல்லாப் பொருள்களையும் பொதுவாகக் குறிக்கும் இடுகுறிப்பெயர் 'இடுகுறிப் பொதுப்பெயர்' எனப்படும்."}}}
{"id":"b-tam-6t3-170","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 57"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஓர் இடுகுறிப்பெயர் குறிப்பாக ஒரு பொருளை மட்டும் சிறப்பாகக் குறிப்பது எது?"}],"options":[{"key":"A","text":"இடுகுறிப் பொதுப்பெயர்"},{"key":"B","text":"இடுகுறிச் சிறப்புப்பெயர் (எ.கா: மா, கருவேலங்காடு)"},{"key":"C","text":"காரணச் சிறப்புப்பெயர்"},{"key":"D","text":"காரணப் பொதுப்பெயர்"}],"explanation":"குறிப்பாக ஒன்றை மட்டும் குறித்து வரும் இடுகுறிப்பெயர் 'இடுகுறிச் சிறப்புப்பெயர்' ஆகும் (எ.கா: மா மரம், கருவேலங்காடு)."}}}
{"id":"b-tam-6t3-171","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 57"},"texts":{"ta":{"blocks":[{"type":"text","text":"நம் முன்னோர் காரணத்தோடு ஒரு பொருளுக்கு வழங்கிய பெயர் எது?"}],"options":[{"key":"A","text":"இடுகுறிப்பெயர்"},{"key":"B","text":"பண்புப்பெயர்"},{"key":"C","text":"காரணப்பெயர் (எ.கா: நாற்காலி, கரும்பலகை)"},{"key":"D","text":"இணைப்பெயர்"}],"explanation":"காரணம் கருதி இட்டு வழங்கிய பெயர்கள் காரணப்பெயர்கள் எனப்படும் (நான்கு கால்கள் உடையதால் நாற்காலி)."}}}
{"id":"b-tam-6t3-172","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 57"},"texts":{"ta":{"blocks":[{"type":"text","text":"காரணப்பெயர் குறிப்பிட்ட காரணமுடைய எல்லாப் பொருள்களையும் பொதுவாகக் குறித்தால் அது எவ்வாறு அழைக்கப்படும்?"}],"options":[{"key":"A","text":"காரணச் சிறப்புப்பெயர்"},{"key":"B","text":"காரணப் பொதுப்பெயர் (எ.கா: பறவை, அணி)"},{"key":"C","text":"இடுகுறிப் பொதுப்பெயர்"},{"key":"D","text":"இடுகுறிச் சிறப்புப்பெயர்"}],"explanation":"பறக்கும் காரணமுடைய எல்லா உயிர்களையும் 'பறவை' எனக் குறிப்பது காரணப் பொதுப்பெயர் ஆகும்."}}}
{"id":"b-tam-6t3-173","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 58"},"texts":{"ta":{"blocks":[{"type":"text","text":"குறிப்பிட்ட காரணமுடைய எல்லாப் பொருள்களுள் ஒன்றை மட்டும் சிறப்பாகக் குறிப்பது எது?"}],"options":[{"key":"A","text":"காரணப் பொதுப்பெயர்"},{"key":"B","text":"காரணச் சிறப்புப்பெயர் (எ.கா: வளையல், மரங்கொத்தி)"},{"key":"C","text":"இடுகுறிப் பொதுப்பெயர்"},{"key":"D","text":"இடுகுறிச் சிறப்புப்பெயர்"}],"explanation":"வளைந்திருக்கும் எல்லாப் பொருள்களையும் குறிக்காமல் கையில் அணியும் அணிகலனை மட்டும் குறிப்பதால் 'வளையல்' காரணச் சிறப்புப்பெயர் ஆகும்."}}}
{"id":"b-tam-6t3-174","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 58"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பறவை, மண், முக்காலி, மரங்கொத்தி’ - இவற்றுள் இடுகுறிப்பெயரைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"பறவை"},{"key":"B","text":"மண்"},{"key":"C","text":"முக்காலி"},{"key":"D","text":"மரங்கொத்தி"}],"explanation":"மண் என்பது காரணம் கருதாமல் இட்டு வழங்கிய இடுகுறிப்பெயர்; மற்றவை காரணப்பெயர்கள்."}}}
{"id":"b-tam-6t3-175","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 58"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மரம், வளையல், சுவர், யானை’ - இவற்றுள் காரணப்பெயர் எது?"}],"options":[{"key":"A","text":"மரம்"},{"key":"B","text":"வளையல்"},{"key":"C","text":"சுவர்"},{"key":"D","text":"யானை"}],"explanation":"வளைந்த வடிவம் கொண்டுள்ள காரணத்தால் வந்த 'வளையல்' என்பது காரணப்பெயர் ஆகும்."}}}
{"id":"b-tam-6t3-176","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 58"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வயல், வாழை, மீன்கொத்தி, பறவை’ - இவற்றுள் இடுகுறிச் சிறப்புப்பெயர் எது?"}],"options":[{"key":"A","text":"வயல்"},{"key":"B","text":"வாழை"},{"key":"C","text":"மீன்கொத்தி"},{"key":"D","text":"பறவை"}],"explanation":"மரங்களுள் குறிப்பாக ஒரு மரத்தை மட்டும் காரணமின்றி இட்டு வழங்குவதால் 'வாழை' இடுகுறிச் சிறப்புப்பெயர்."}}}
{"id":"b-tam-6t3-177","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 59"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கைகள் இரண்டும் பிறர்க்கு உதவவே எனச் சான்றோர் கருதினர்’ - இதில் ‘கைகள்’ என்பது எவ்வகைப் பெயர்ச்சொல்?"}],"options":[{"key":"A","text":"பொருட்பெயர்"},{"key":"B","text":"சினைப்பெயர் (உறுப்பு)"},{"key":"C","text":"தொழிற்பெயர்"},{"key":"D","text":"பண்புப்பெயர்"}],"explanation":"உடலின் உறுப்பைக் குறிப்பதால் 'கைகள்' என்பது சினைப்பெயர் ஆகும்."}}}
{"id":"b-tam-6t3-178","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 59"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மாலை முழுதும் விளையாட்டு’ - இதில் ‘மாலை’ என்பது எவ்வகைப் பெயர்ச்சொல்?"}],"options":[{"key":"A","text":"இடப்பெயர்"},{"key":"B","text":"காலப்பெயர்"},{"key":"C","text":"பொருட்பெயர்"},{"key":"D","text":"சினைப்பெயர்"}],"explanation":"பொழுதைக் (நேரத்தைக்) குறிப்பதால் மாலை என்பது காலப்பெயர் ஆகும்."}}}
