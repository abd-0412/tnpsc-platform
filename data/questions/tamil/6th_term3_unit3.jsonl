// 6-ஆம் வகுப்பு தமிழ் - பருவம் 3 - இயல் 3: மனிதநேயம் / கருணை / ஈகை / வாழ்வியல் (மொத்த வினாக்கள்: 68)
// ==============================================================================
// ==============================================================================
// பாடம் 1: ஆசிய ஜோதி (கவிதைப்பேழை - கவிமணி தேசிக விநாயகனார்) [Q133 - Q144]
// பிம்பிசாரன் யாகம் / புத்தர்பிரான், வாழும் உயிரை வாங்கிவிடல், கும்பி/பூதலம்/பார், கவிமணி (36 ஆண்டுகள் ஆசிரியர்),
// எட்வின் அர்னால்டு (Light of Asia), புணர்ச்சி (எளிதாகும், பாலையெல்லாம், இன்னுயிர், மலையெலாம்), கருணை வாழ்வு
// ==============================================================================
{"id":"b-tam-6t3-133","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 42"},"texts":{"ta":{"blocks":[{"type":"text","text":"பிம்பிசார மன்னனின் யாகத்திற்காகக் கொண்டு செல்லப்பட்ட ஆட்டுக்குட்டியைத் தோளில் சுமந்து சென்று உயிர்க்கொலையைத் தடுத்தவர் யார்?"}],"options":[{"key":"A","text":"மகாவீரர்"},{"key":"B","text":"புத்தர்பிரான்"},{"key":"C","text":"வள்ளலார்"},{"key":"D","text":"அன்னை தெரசா"}],"explanation":"அரச வாழ்வைத் துறந்து வந்த புத்தர்பிரான், பிம்பிசார மன்னனின் யாகசாலையில் ஆட்டின் உயிரைக் காக்க அறவுரை கூறி உயிர்க்கொலையைத் தடுத்தார்."}}}
{"id":"b-tam-6t3-134","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 42"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வாழும் உயிரை வாங்கிவிடல் இந்த மண்ணில் எவர்க்கும் எளிதாகும்; வீழும் உடலை எழுப்புதலோ ஒரு வேந்தன் நினைக்கிலும் ஆகாதையா!’ - இவ்வடிகள் இடம்பெற்றுள்ள நூல் எது?"}],"options":[{"key":"A","text":"மணிமேகலை"},{"key":"B","text":"ஆசிய ஜோதி"},{"key":"C","text":"குண்டலகேசி"},{"key":"D","text":"இரட்சணிய யாத்திரிகம்"}],"explanation":"இவ்வடிகள் கவிமணி தேசிக விநாயகனார் இயற்றிய 'ஆசிய ஜோதி' என்னும் நூலில் இடம்பெற்றுள்ளன."}}}
{"id":"b-tam-6t3-135","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஆசிய ஜோதி பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"கும்பி"},{"label":"B","text":"பூதலம்"},{"label":"C","text":"பார்"},{"label":"D","text":"அஞ்சினர்"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"பூமி"},{"label":"2","text":"வயிறு"},{"label":"3","text":"பயந்தனர்"},{"label":"4","text":"உலகம்"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}}],"explanation":"கும்பி = வயிறு; பூதலம் = பூமி; பார் = உலகம்; அஞ்சினர் = பயந்தனர்; வீழும் = விழும்; கருணை = இரக்கம்; வேந்தன் = அரசன்."}}}
{"id":"b-tam-6t3-136","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"கவிமணி தேசிக விநாயகனார் எத்தனை ஆண்டுகள் பள்ளி ஆசிரியராகப் பணியாற்றிப் பெருமை பெற்றார்?"}],"options":[{"key":"A","text":"30 ஆண்டுகள்"},{"key":"B","text":"32 ஆண்டுகள்"},{"key":"C","text":"36 ஆண்டுகள்"},{"key":"D","text":"40 ஆண்டுகள்"}],"explanation":"கவிமணி தேசிக விநாயகனார் இருபதாம் நூற்றாண்டில் வாழ்ந்த கவிஞர்; இவர் முப்பத்தாறு (36) ஆண்டுகள் பள்ளி ஆசிரியராகப் பணியாற்றினார்."}}}
{"id":"pyq-tam-6t3-137","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":28},"texts":{"ta":{"blocks":[{"type":"text","text":"கவிமணி தேசிக விநாயகனார் இயற்றிய ‘ஆசிய ஜோதி’ என்னும் நூல் ஆங்கிலத்தில் எட்வின் அர்னால்டு எழுதிய எந்த நூலின் தழுவலாகும்?"}],"options":[{"key":"A","text":"The Secret Path"},{"key":"B","text":"Light of Asia"},{"key":"C","text":"Song of Life"},{"key":"D","text":"The Voice of Asia"}],"explanation":"ஆசிய ஜோதி ஆங்கில மொழியில் எட்வின் அர்னால்டு என்பவர் எழுதிய 'லைட் ஆஃப் ஆசியா' (Light of Asia) என்னும் நூலைத் தழுவி எழுதப்பட்டது."}}}
{"id":"b-tam-6t3-138","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 45"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எளிதாகும்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"எளிது + தாகும்"},{"key":"B","text":"எளி + தாகும்"},{"key":"C","text":"எளிது + ஆகும்"},{"key":"D","text":"எளிதா + ஆகும்"}],"explanation":"எளிது + ஆகும் = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'த்' நின்று, த் + ஆ = தா ஆகி 'எளிதாகும்' எனப் புணரும்."}}}
{"id":"b-tam-6t3-139","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 45"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பாலையெல்லாம்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"பாலை + யெல்லாம்"},{"key":"B","text":"பாலை + எல்லாம்"},{"key":"C","text":"பாலை + எலாம்"},{"key":"D","text":"பா + எல்லாம்"}],"explanation":"பாலை + எல்லாம் = 'இ ஈ ஐ வழி யவ்வும்' விதிப்படி உடம்படுமெய் 'ய்' தோன்றிப் 'பாலையெல்லாம்' எனப் புணரும்."}}}
{"id":"b-tam-6t3-140","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 45"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இனிமை + உயிர்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"இன்உயிர்"},{"key":"B","text":"இனியஉயிர்"},{"key":"C","text":"இன்னுயிர்"},{"key":"D","text":"இனிமைஉயிர்"}],"explanation":"ஈறுபோதல் விதிப்படி 'மை' கெட்டு, தனிக்குறில்முன் ஒற்று உயிர்வரின் இரட்டும் விதிப்படி ன் இரட்டித்து 'இன்னுயிர்' எனப் புணரும்."}}}
{"id":"b-tam-6t3-141","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 45"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மலை + எலாம்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"மலைஎலாம்"},{"key":"B","text":"மலையெலாம்"},{"key":"C","text":"மலையெல்லாம்"},{"key":"D","text":"மலைளாம்"}],"explanation":"மலை + எலாம் = உடம்படுமெய் ய் தோன்றி (ய் + எ = யெ), 'மலையெலாம்' எனப் புணரும்."}}}
{"id":"b-tam-6t3-142","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"புத்தர்பிரானின் கூற்றுப்படி ஒரு மனிதன் செய்த நன்மையும் தீமையும் எவ்வாறு செயல்படும்?"}],"options":[{"key":"A","text":"செய்தவரை விட்டு ஒருநாளும் விலகிச் செல்லாது"},{"key":"B","text":"ஆடுகளுக்குப் பலியிடுவதன் மூலம் விலகிவிடும்"},{"key":"C","text":"காலப்போக்கில் தானாக அழிந்துவிடும்"},{"key":"D","text":"அரசனால் மன்னிக்கப்படும்"}],"explanation":"'தீயவும் நல்லவும் செய்தவரை விட்டுச் செல்வது ஒருநாளும் இல்லை ஐயா!' எனப் புத்தர்பிரான் அறவுரை கூறினார்."}}}
{"id":"b-tam-6t3-143","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஆசிய ஜோதி நூல் யாருடைய வரலாற்றையும் அறநெறிகளையும் விரிவாகக் கூறுகிறது?"}],"options":[{"key":"A","text":"மகாவீரர்"},{"key":"B","text":"கௌதம புத்தர்"},{"key":"C","text":"அசோகர்"},{"key":"D","text":"போதிதர்மர்"}],"explanation":"ஆசிய ஜோதி நூல் கௌதம புத்தரின் வாழ்க்கை வரலாற்றையும் அவரது கருணை போதனைகளையும் விளக்குகிறது."}}}
{"id":"b-tam-6t3-144","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 45"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நேர்மையான கண்ணிய வாழ்வை வாழ்பவர் யார்’ என ஆசிய ஜோதி பாடல் குறிப்பிடுகிறது?"}],"options":[{"key":"A","text":"எல்லா உயிர்களிடத்தும் கருணை கொண்டவர்"},{"key":"B","text":"அரண்மனையில் வாழும் அரசன்"},{"key":"C","text":"யாகங்களை நடத்தும் முனிவர்"},{"key":"D","text":"செல்வத்தை ஈட்டுபவர்"}],"explanation":"'காட்டும் கருணை உடையவரே என்றும் கண்ணிய வாழ்வை உடையவராம்' என்று பாடல் உரைக்கிறது."}}}
