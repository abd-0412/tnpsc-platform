// ==============================================================================
// பாடம் 13 (இயல் 3 - பாடம் 1): மலைப்பொழிவு (கவிதைப்பேழை - கண்ணதாசன், இயேசுகாவியம்) [Q114 - Q121]
// சாதிகளாலும் பேதங்களாலும் தள்ளாடும் உலகம், சொல்-பொருள் (பேதங்கள், உன்னதம், இரக்கம், தர்மம்),
// கண்ணதாசன் இயற்பெயர் (முத்தையா), இயேசுகாவியம், இமைக்கும் போதில் (கால அளவு),
// புணர்ச்சி (மலையளவு, தன்னாடு, இவையில்லாது)
// ==============================================================================
{"id":"b-tam-7t3-114","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 46"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சாதிகளாலும் பேதங்களாலும் தள்ளாடும் உலகம் - அது தர்மம் ஒன்றை நம்பிய பிறகே அடங்கிவிடும் கலகம்!’ - என்னும் ‘மலைப்பொழிவு’ பாடலை இயற்றிய கவிஞர் யார்?"}],"options":[{"key":"A","text":"உடுமலை நாராயணகவி"},{"key":"B","text":"கண்ணதாசன்"},{"key":"C","text":"சுரதா"},{"key":"D","text":"வாணிதாசன்"}],"explanation":"இயேசுவின் வாழ்க்கை வரலாற்றைக் கூறும் 'இயேசுகாவியம்' நூலின் மலைப்பொழிவு பகுதியிலிருந்து இப்பாடலை இயற்றியவர் கண்ணதாசன் ஆவார்."}}}
{"id":"b-tam-7t3-115","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"4","C":"1","D":"3"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 47"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மலைப்பொழிவு’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"பேதங்கள்"},{"label":"B","text":"உன்னதம்"},{"label":"C","text":"இரக்கம்"},{"label":"D","text":"தர்மம்"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"கருணை"},{"label":"2","text":"வேறுபாடுகள்"},{"label":"3","text":"அறம்"},{"label":"4","text":"உயர்வு"}]}],"options":[{"key":"A","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"D","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}}],"explanation":"பேதங்கள் = வேறுபாடுகள்; உன்னதம் = உயர்வு; இரக்கம் = கருணை; தர்மம் = அறம்."}}}
{"id":"b-tam-7t3-116","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 47"},"texts":{"ta":{"blocks":[{"type":"text","text":"கவியரசு கண்ணதாசனின் இயற்பெயர் யாது?"}],"options":[{"key":"A","text":"முத்துசாமி"},{"key":"B","text":"முத்தையா"},{"key":"C","text":"இராசகோபாலன்"},{"key":"D","text":"சுப்பரத்தினம்"}],"explanation":"கண்ணதாசனின் இயற்பெயர் முத்தையா ஆகும்; இவர் தமிழக அரசின் அரசவைக் கவிஞராகவும் விளங்கியவர்."}}}
{"id":"b-tam-7t3-117","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 47"},"texts":{"ta":{"blocks":[{"type":"text","text":"இயேசுவின் வாழ்க்கை வரலாற்றையும் அவரது அறிவுரைகளையும் விரிவாகக் கூறும் நூலின் பெயர் என்ன?"}],"options":[{"key":"A","text":"இரட்சணிய யாத்திரிகம்"},{"key":"B","text":"இயேசுகாவியம்"},{"key":"C","text":"தேம்பாவணி"},{"key":"D","text":"கிறிஸ்து புராணம்"}],"explanation":"கண்ணதாசன் இயற்றிய 'இயேசுகாவியம்' நூலில் இயேசுவின் வரலாற்றுடன் அறிவுரைகளும் தொகுக்கப்பட்டுள்ளன."}}}
{"id":"b-tam-7t3-118","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 48"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இமைக்கும் போதில்’ என்னும் தொடர் குறிக்கும் கால அளவு யாது?"}],"options":[{"key":"A","text":"நீண்ட காலம்"},{"key":"B","text":"ஒரு நாள் பொழுது"},{"key":"C","text":"மிகக் குறுகிய காலம் (கண் சிமிட்டும் நேரம்)"},{"key":"D","text":"ஒரு மணி நேரம்"}],"explanation":"இமைக்கும் பொழுது என்பது கண் சிமிட்டும் குறுகிய கால அளவைக் குறிக்கும்."}}}
{"id":"b-tam-7t3-119","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 48"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மலையளவு’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"மலை + யளவு"},{"key":"B","text":"மலை + அளவு"},{"key":"C","text":"மலையின் + அளவு"},{"key":"D","text":"மலையில் + அளவு"}],"explanation":"மலை + அளவு = உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி ய் + அ = ய ஆகி 'மலையளவு' எனப் புணரும்."}}}
{"id":"b-tam-7t3-120","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 48"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தன்னாடு’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"தன் + னாடு"},{"key":"B","text":"தன்மை + னாடு"},{"key":"C","text":"தன் + நாடு"},{"key":"D","text":"தன்மை + நாடு"}],"explanation":"தன் + நாடு = 'தன்' என்னும் நிலைமொழியோடு 'நாடு' சேரும்போது 'தன்னாடு' எனப் புணரும்."}}}
{"id":"b-tam-7t3-121","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 48"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இவை + இல்லாது’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"இவையில்லாது"},{"key":"B","text":"இவைஇல்லாது"},{"key":"C","text":"இவயில்லாது"},{"key":"D","text":"இவஇல்லாது"}],"explanation":"ஐ வழி யவ்வும் விதிப்படி உடம்படுமெய் ய் தோன்றி (ய் + இ = யி), 'இவையில்லாது' எனப் புணரும்."}}}

