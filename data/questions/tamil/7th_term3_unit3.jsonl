// பாடம் 16 (இயல் 3 - பாடம் 4): பயணம் (விரிவானம் / துணைப்பாடம் - பாவண்ணன்) [Q136 - Q137]
// பாவண்ணன் நூல்கள் (பொருந்தாதது: ஆகாயத்துக்கு அடுத்த வீடு - மு. மேத்தா), பிரயாணம் சிறுகதைத் தொகுப்பு, கன்னட மொழிபெயர்ப்பு
// ==============================================================================
{"id":"b-tam-7t3-136","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 55"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பயணம்’ என்னும் சிறுகதையின் ஆசிரியர் பாவண்ணன் எழுதிய பிற நூல்களுள் பொருந்தாத ஒன்றைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"வேர்கள் தொலைவில் இருக்கின்றன, நேற்று வாழ்ந்தவர்கள்"},{"key":"B","text":"ஆகாயத்துக்கு அடுத்த வீடு"},{"key":"C","text":"கடலோர வீடு, பாய்மரக்கப்பல்"},{"key":"D","text":"மீசைக்கார பூனை, பிரயாணம்"}],"explanation":"'ஆகாயத்துக்கு அடுத்த வீடு' மு. மேத்தாவின் நூல்; மற்றவை பாவண்ணனின் படைப்புகளாகும்."}}}
{"id":"b-tam-7t3-137","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 55"},"texts":{"ta":{"blocks":[{"type":"text","text":"கன்னட மொழியிலிருந்து பல நூல்களைத் தமிழில் மொழிபெயர்த்தவரும், ‘பிரயாணம்’ நூலின் ஆசிரியருமான எழுத்தாளர் யார்?"}],"options":[{"key":"A","text":"எஸ். ராமகிருஷ்ணன்"},{"key":"B","text":"பாவண்ணன்"},{"key":"C","text":"நாஞ்சில் நாடன்"},{"key":"D","text":"அழகிய பெரியவன்"}],"explanation":"சிறுகதை, கவிதை, மொழிபெயர்ப்பு எனப் பல்வேறு தளங்களில் இயங்கிவரும் பாவண்ணன் எழுதிய 'பிரயாணம்' நூலிலிருந்து 'பயணம்' கதை எடுக்கப்பட்டுள்ளது."}}}

// ==============================================================================
// பாடம் 17 (இயல் 3 - பாடம் 5): அணி இலக்கணம் / வினா, விடை வகைகள் (கற்கண்டு - இலக்கணம்) [Q138 - Q142]
// வினா 6 வகைகள், வினா வகைகள் பொருத்துக (அறிவினா, அறியா வினா, ஐய வினா, கொளல் வினா),
// விடை 8 வகைகள் (3 வெளிப்படை, 5 குறிப்பு), விடை வகைகள் பொருத்துக (மறை, ஏவல், உற்றது உரைத்தல், இனமொழி),
// இனமொழி விடை சான்று
// ==============================================================================
{"id":"b-tam-7t3-138","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 59"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ் மொழியில் கேள்விகள் கேட்கும் முறையான ‘வினா’ எத்தனை வகைப்படும்?"}],"options":[{"key":"A","text":"நான்கு வகைப்படும்"},{"key":"B","text":"ஆறு வகைப்படும் (அறிவினா, அறியா வினா, ஐயவினா, கொளல் வினா, கொடை வினா, ஏவல் வினா)"},{"key":"C","text":"எட்டு வகைப்படும்"},{"key":"D","text":"பத்து வகைப்படும்"}],"explanation":"வினா ஆறு வகைப்படும்."}}}
{"id":"b-tam-7t3-139","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"4","C":"1","D":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 59"},"texts":{"ta":{"blocks":[{"type":"text","text":"வினா வகைகளையும் அவற்றுக்குரிய சான்றுகளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"வினா வகை","items":[{"label":"A","text":"அறிவினா"},{"label":"B","text":"அறியா வினா"},{"label":"C","text":"ஐய வினா"},{"label":"D","text":"கொளல் வினா"}]},{"type":"list","name":"சான்று","items":[{"label":"1","text":"இச்செயலைச் செய்தது மங்கையா? மணிமேகலையா?"},{"label":"2","text":"ஜெயகாந்தன் சிறுகதைகள் இருக்கிறதா?"},{"label":"3","text":"மாணவரிடம் 'இந்தக் கவிதையின் பொருள் யாது?' என ஆசிரியர் கேட்பது"},{"label":"4","text":"ஆசிரியரிடம் 'இந்தக் கவிதையின் பொருள் யாது?' என மாணவர் கேட்பது"}]}],"options":[{"key":"A","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"D","text":"A-4, B-3, C-2, D-1","mapping":{"A":"4","B":"3","C":"2","D":"1"}}],"explanation":"அறிவினா = ஆசிரியர் மாணவரிடம் கேட்பது; அறியா வினா = மாணவர் ஆசிரியரிடம் கேட்பது; ஐய வினா = தெளிவு பெறக் கேட்பது; கொளல் வினா = பொருள் வாங்கக் கேட்பது."}}}
{"id":"b-tam-7t3-140","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 59"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழில் வினாவிற்கு விடையளிக்கும் முறைகள் எத்தனை வகையாகப் பிரிக்கப்பட்டுள்ளன?"}],"options":[{"key":"A","text":"ஆறு வகைகள்"},{"key":"B","text":"எட்டு வகைகள் (சுட்டு, மறை, நேர், ஏவல், வினா எதிர் வினாதல், உற்றது உரைத்தல், உறுவது கூறல், இனமொழி)"},{"key":"C","text":"பத்து வகைகள்"},{"key":"D","text":"நான்கு வகைகள்"}],"explanation":"விடை எட்டு வகைப்படும்; முதல் 3 வெளிப்படை விடைகள், அடுத்த 5 குறிப்பு விடைகள் ஆகும்."}}}
{"id":"b-tam-7t3-141","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"4","C":"1","D":"3"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 60"},"texts":{"ta":{"blocks":[{"type":"text","text":"விடை வகைகளையும் அவற்றுக்குரிய சான்றுகளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"விடை வகை","items":[{"label":"A","text":"மறை விடை"},{"label":"B","text":"ஏவல் விடை"},{"label":"C","text":"உற்றது உரைத்தல் விடை"},{"label":"D","text":"இனமொழி விடை"}]},{"type":"list","name":"சான்று","items":[{"label":"1","text":"‘நீ விளையாடவில்லையா?’ என்ற வினாவிற்கு ‘கால் வலிக்கிறது’ என நேர்ந்ததைக் கூறுவது"},{"label":"2","text":"‘கடைக்குப் போவாயா?’ என்ற கேள்விக்குப் ‘போகமாட்டேன்’ என மறுத்துக் கூறுவது"},{"label":"3","text":"‘உனக்குக் கதை எழுதத் தெரியுமா?’ என்ற வினாவிற்குக் ‘கட்டுரை எழுதத் தெரியும்’ என இணை கூறுவது"},{"label":"4","text":"‘இந்த வேலையைச் செய்வாயா?’ என்று கேட்டால் ‘நீயே செய்’ என ஏவிக் கூறுவது"}]}],"options":[{"key":"A","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"D","text":"A-4, B-3, C-2, D-1","mapping":{"A":"4","B":"3","C":"2","D":"1"}}],"explanation":"மறை விடை = மறுத்துக் கூறுவது; ஏவல் விடை = ஏவிக்கூறுவது; உற்றது உரைத்தல் = நேர்ந்ததைக் கூறுவது; இனமொழி விடை = இணையான மற்றொன்றைக் கூறுவது."}}}
{"id":"b-tam-7t3-142","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 61"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மட்டைப்பந்து விளையாடத் தெரியுமா?’ என்னும் வினாவிற்குக் ‘கால்பந்து விளையாடத் தெரியும்’ என்று விடையளிப்பது எவ்வகை விடை?"}],"options":[{"key":"A","text":"மறைவிடை"},{"key":"B","text":"இனமொழி விடை"},{"key":"C","text":"உற்றது உரைத்தல் விடை"},{"key":"D","text":"நேர்விடை"}],"explanation":"வினாவிற்கு விடையாக அதற்கு இனமான மற்றொன்றைக் கூறுவது 'இனமொழி விடை' எனப்படும்."}}}

// ==============================================================================
// பாடம் 18 (இயல் 3 - பாடம் 6): மொழியை ஆள்வோம் & கலைச்சொற்கள் அறிவோம் [Q143]
// மானுடம் காத்தல் கலைச்சொற்கள் (Philosophy: தத்துவம், Simplicity: எளிமை, Honesty: நேர்மை, Dignity: கண்ணியம்)
// ==============================================================================
{"id":"b-tam-7t3-143","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"4","C":"1","D":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 66"},"texts":{"ta":{"blocks":[{"type":"text","text":"மானுடம் காத்தல் மற்றும் மனிதநேயக் கலைச்சொற்களைச் சரியாகப் பொருத்துக:"},{"type":"list","name":"ஆங்கிலச் சொல்","items":[{"label":"A","text":"Philosophy"},{"label":"B","text":"Simplicity"},{"label":"C","text":"Honesty"},{"label":"D","text":"Dignity"}]},{"type":"list","name":"தமிழாக்கம்","items":[{"label":"1","text":"நேர்மை"},{"label":"2","text":"கண்ணியம்"},{"label":"3","text":"தத்துவம்"},{"label":"4","text":"எளிமை"}]}],"options":[{"key":"A","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"D","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}}],"explanation":"Philosophy = தத்துவம்; Simplicity = எளிமை; Honesty = நேர்மை; Dignity = கண்ணியம்; Charity = ஈகை; Sincerity = வாய்மை; Doctrine = கொள்கை."}}}

// ==============================================================================
// பாடம் 19 (இயல் 3 - பாடம் 7): திருக்குறள் (வாழ்வியல் / நீதி இலக்கியம்) [Q144 - Q155]
// சூழ்ச்சி முடிவு துணிவுஎய்தல், தூங்குக தூங்கிச் செயற்பால, வினைபகை என்றிரண்டின் எச்சம் (தீயெச்சம்),
// பகையகத்துச் சாவார் எளியர், தள்ளா விளையுளும் தக்காரும் (நாடு), பிணியின்மை செல்வம் விளைவுஇன்பம் ஏமம் (5 சிறப்புகள்),
// ஆற்று பவர்க்கும் அரண்பொருள், உயர்வுஅகலம் திண்மை அருமை (அரணின் 4 இயல்புகள்),
// ஒளிஒருவற்கு உள்ள வெறுக்கை (ஊக்கம்), பணியுமாம் என்றும் பெருமை, அற்றம் மறைக்கும் பெருமை,
// மேலிருந்தும் மேலல்லார் (முரண்தொடை நயம் - PYQ 2022)
// ==============================================================================
{"id":"b-tam-7t3-144","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 67"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சூழ்ச்சி முடிவு துணிவுஎய்தல் அத்துணிவு தாழ்ச்சியுள் தங்குதல் தீது’ - இக்குறளின்படி ஒரு காரியத்தை ஆராய்ந்து துணிந்த பின் என்ன செய்ய வேண்டும்?"}],"options":[{"key":"A","text":"மீண்டும் பலமுறை யோசிக்க வேண்டும்"},{"key":"B","text":"அத்துணிவைச் செயல்படுத்தாமல் தாமதப்படுத்துதல் தீதாகும்"},{"key":"C","text":"பகைவரின் உதவியை நாட வேண்டும்"},{"key":"D","text":"பொருளைச் சேமிக்க வேண்டும்"}],"explanation":"ஆராய்ந்து ஒரு முடிவுக்கு வந்த பின், அதனை உடனே செயல்படுத்த வேண்டும்; தாமதிப்பது குற்றமாகும்."}}}
{"id":"b-tam-7t3-145","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 67"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தூங்குக தூங்கிச் செயற்பால தூங்கற்க தூங்காது செய்யும் வினை’ - வினையாற்றும் முறை குறித்து வள்ளுவர் கூறுவது யாது?"}],"options":[{"key":"A","text":"எப்போதும் ஆழ்ந்து தூங்கி எழ வேண்டும்"},{"key":"B","text":"தாழ்த்திச் செய்ய வேண்டிய செயல்களைத் தாழ்த்திச் செய்க; உடனே செய்ய வேண்டிய செயல்களைத் தாமதப்படுத்தாமல் உடனே செய்க"},{"key":"C","text":"பகலில் வேலை செய்யக் கூடாது"},{"key":"D","text":"இரவில் சிந்திக்க வேண்டும்"}],"explanation":"காலம் தாழ்த்திச் செய்ய வேண்டியதைத் தாழ்த்தியும், உடனே முடிக்க வேண்டியதை விரைவாகவும் முடிக்க வேண்டும்."}}}
{"id":"b-tam-7t3-146","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 67"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வினைபகை என்றிரண்டின் எச்சம் நினையுங்கால் தீயெச்சம் போலத் தெறும்’ - எஞ்சியிருக்கும் காரியக் குறையும் பகைக்கு குறையும் எதனைப் போல அழித்துவிடும்?"}],"options":[{"key":"A","text":"வெள்ளத்தைப் போல"},{"key":"B","text":"நெருப்புப் போல (தீயெச்சம் போல)"},{"key":"C","text":"காற்றைப் போல"},{"key":"D","text":"நஞ்சைப் போல"}],"explanation":"தீயின் எச்சம் சிறு பொறி நின்று மீண்டும் வளர்வது போல, தீர்ந்ததாகத் தோன்றும் பகையும் வினையும் முற்றும் அழித்துவிடும்."}}}
{"id":"b-tam-7t3-147","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 67"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பகையகத்துச் சாவார் எளியர் அரியர் அவையகத்து அஞ்சா தவர்’ - போர்க்களத்தில் மரணமடைய அஞ்சாத வீரர்களைக் காட்டிலும் அரிதானவர்கள் யார்?"}],"options":[{"key":"A","text":"செல்வத்தைக் கொடை அளிப்பவர்"},{"key":"B","text":"சபையில் (அவையில்) பலரின் முன் அஞ்சாமல் பேசவல்லவர்கள்"},{"key":"C","text":"கவிதை பாடுபவர்கள்"},{"key":"D","text":"நாடு ஆள்பவர்கள்"}],"explanation":"போர்க்களத்தில் உயிர்விடத் துணிபவர் பலர்; ஆனால் அவைக் களத்தில் நடுங்காமல் துணிந்து பேசுபவரோ மிகச் சிலரே."}}}
{"id":"b-tam-7t3-148","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 68"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தள்ளா விளையுளும் தக்காரும் தாழ்விலாச் செல்வரும் சேர்வது நாடு’ - சிறந்த நாட்டின் இலக்கணங்களாக வள்ளுவர் கூறுவன எவை?"}],"options":[{"key":"A","text":"கோட்டைகளும் மதில்களும்"},{"key":"B","text":"குறையாத விளைச்சலும், சான்றோர்களும், சோர்விலாத வணிகர்களும்"},{"key":"C","text":"அதிக மக்கள்தொகையும் செல்வமும்"},{"key":"D","text":"ஆறுகளும் மலைகளும்"}],"explanation":"குறையாத விளைச்சல், சான்றோர், சீரான வணிகச் செல்வம் உடையதே சிறந்த நாடாகும்."}}}
{"id":"b-tam-7t3-149","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 68"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பிணியின்மை செல்வம் விளைவுஇன்பம் ஏமம் அணியென்ப நாட்டிற்கு இவ ஐந்து’ - ஒரு நாட்டிற்கு அழகாக விளங்கும் ஐந்து சிறப்புகள் எவை?"}],"options":[{"key":"A","text":"படை, குடி, கூழ், அமைச்சு, நட்பு"},{"key":"B","text":"நோயின்மை, செல்வம், விளைச்சல், இன்பம், காவல் (ஏமம்)"},{"key":"C","text":"நீர், நிலம், மலை, காடு, மதில்"},{"key":"D","text":"கல்வி, வீரம், ஈகை, அறிவு, ஊக்கம்"}],"explanation":"நோயின்மை, செல்வம், விளைச்சல், இன்பம், காவல் ஆகிய ஐந்தும் நாட்டிற்கு அழகு சேர்க்கும் அணிகளாகும்."}}}
{"id":"b-tam-7t3-150","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 68"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஆற்று பவர்க்கும் அரண்பொருள் அஞ்சித்தன் போற்று பவர்க்கும் பொருள்’ - அரண் என்னும் பாதுகாப்பு யாருக்குத் தேவைப்படுகிறது?"}],"options":[{"key":"A","text":"மக்களுக்கு மட்டும்"},{"key":"B","text":"போருக்குச் செல்வோர்க்கும், தன்னைத் தற்காத்துக் கொள்ள அஞ்சுபவர்க்கும்"},{"key":"C","text":"அரசனுக்கும் அமைச்சனுக்கும்"},{"key":"D","text":"வணிகர்களுக்கு மட்டும்"}],"explanation":"பகை மீது போர் தொடுத்துச் செல்வோருக்கும், தன் நாட்டைப் பாதுகாத்துக் கொள்ள விரும்புவோருக்கும் மதில் அரண் அவசியமாகும்."}}}
{"id":"b-tam-7t3-151","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 68"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘உயர்வுஅகலம் திண்மை அருமைஇந் நான்கின் அமைவுஅரண் என்றுரைக்கும் நூல்’ - ஒரு நாட்டின் மதிலரசுக்கு இருக்க வேண்டிய நான்கு சிறப்பியல்புகள் எவை?"}],"options":[{"key":"A","text":"நீளம், அகலம், உயரம், ஆழம்"},{"key":"B","text":"உயரம், அகலம், உறுதி (திண்மை), பகைவர்க்கு அரியதாதல்"},{"key":"C","text":"கல், மரம், மண், சுண்ணாம்பு"},{"key":"D","text":"படை, குடி, கூழ், அமைச்சு"}],"explanation":"உயரம், அகலம், திண்மை (உறுதி), பகைவர்க்கு அரியதாதல் ஆகிய நான்கும் அரணின் சிறப்புகளாகும்."}}}
{"id":"b-tam-7t3-152","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 69"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஒளிஒருவற்கு உள்ள வெறுக்கை இளிஒருவற்கு அஃதுஇறந்து வாழ்தும் எனல்’ - ஒருவனுக்கு உண்மையான ஒளியாகவும் மதிப்பாகவும் திகழ்வது எது?"}],"options":[{"key":"A","text":"அளவற்ற பொருள் செல்வம்"},{"key":"B","text":"மன ஊக்கம் (உள்ளக் குறிக்கோள்)"},{"key":"C","text":"அரச பதவிகள்"},{"key":"D","text":"உறவினர்களின் பலம்"}],"explanation":"மன ஊக்கமே ஒருவர்க்கு மதிப்பாகும்; அதனை இழந்து வாழ்வது வாழ்க்கையின் இழிவாகும்."}}}
{"id":"b-tam-7t3-153","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 69"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பணியுமாம் என்றும் பெருமை சிறுமை அணியுமாம் தன்னை வியந்து’ - சான்றோர்களின் இயல்பும் சிறியவர்களின் இயல்பும் எவ்வாறு இருக்கும்?"}],"options":[{"key":"A","text":"இருவரும் சமமாகப் பேசுவர்"},{"key":"B","text":"பெருமை உடையவர் எப்போதும் பணிவுடன் நடப்பர்; சிறுமை உடையவரோ தன்னைத்தானே வியந்து புகழ்ந்து கொள்வர்"},{"key":"C","text":"பெரியவர் கோபப்படுவர்"},{"key":"D","text":"சிறியவர் அடக்கமாக இருப்பர்"}],"explanation":"பணிவோடு இருத்தலே பெருமையின் குணமுமாகும்; தற்புகழ்ச்சி பேசுவதே சிறுமையின் அடையாளமாகும்."}}}
{"id":"b-tam-7t3-154","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 69"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அற்றம் மறைக்கும் பெருமை சிறுமைதான் குற்றமே கூறி விடும்’ - பெருமை உடையோரின் குணமும் சிறுமை உடையோரின் குணமும் எத்தகையது?"}],"options":[{"key":"A","text":"இருவரும் குற்றங்களை மறைப்பர்"},{"key":"B","text":"பிறரின் குற்றங்களை மறைப்பது பெருமை; பிறரது குற்றத்தையே கூறித் திரிவது சிறுமை"},{"key":"C","text":"குற்றங்களை மன்னிப்பது பெருமை"},{"key":"D","text":"பகைவர்களை மன்னித்தல்"}],"explanation":"பிறரது குறைகளை மறைப்பவரே பெருமைமிக்கவர்; குறைகளையே கூறித் திரிபவரே சிறியவர்."}}}
{"id":"pyq-tam-7t3-155","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":25},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மேலிருந்தும் மேலல்லார் மேலல்லர் கீழிருந்தும் கீழல்லார் கீழல் லவர்’ - இக்குறட்பாவில் பயின்று வந்துள்ள முரண்தொடை நயம் எதனை விளக்குகிறது?"}],"options":[{"key":"A","text":"பணக்காரரும் ஏழையும்"},{"key":"B","text":"உயர் குலமும் தாழ்ந்த குலமும்"},{"key":"C","text":"இடத்தால் உயர்வில் நின்றாலும் நல்ல குணமில்லாதவர் சிறியவரே; தாழ்ந்த நிலையில் நின்றாலும் நற்பண்பு உள்ளவரே பெரியவராவர்"},{"key":"D","text":"அரசனும் அமைச்சனும்"}],"explanation":"உயர்ந்த இடத்தில் இருந்தாலும் நற்குணம் இல்லாதவர் சிறியவரே; எளிய நிலையில் இருந்தாலும் நற்பண்பு மிக்கவர் பெரியவரே."}}}
