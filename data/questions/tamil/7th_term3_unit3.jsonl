{"id":"b-tam-7t3-126","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 51"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கண்ணியமிகு’ என்னும் அடைமொழியால் அழைக்கப்படும் பெருமைக்குரிய தலைவர் யார்?"}],"options":[{"key":"A","text":"முகம்மது அலி ஜின்னா"},{"key":"B","text":"காயிதே மில்லத் முகம்மது இசுமாயில்"},{"key":"C","text":"கான்சாகிப்"},{"key":"D","text":"வாகுப் கான்"}],"explanation":"எளிமை, நேர்மை, நாட்டுப்பற்றுடையவராய்ச் சிறந்து விளங்கிய முகமது இசுமாயில் 'காயிதே மில்லத்' என அழைக்கப்பட்டார்."}}}
{"id":"pyq-tam-7t3-127","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":12},"texts":{"ta":{"blocks":[{"type":"text","text":"‘காயிதே மில்லத்’ என்னும் அரபுச் சொல்லுக்கு உரிய சரியான பொருள் யாது?"}],"options":[{"key":"A","text":"சமூகத் தலைவர்"},{"key":"B","text":"நாட்டின் வழிகாட்டி"},{"key":"C","text":"சமுதாய வழிகாட்டி"},{"key":"D","text":"இஸ்லாமியத் தூதர்"}],"explanation":"காயிதே மில்லத் என்றால் அரபு மொழியில் 'சமுதாய வழிகாட்டி' என்று பொருள்."}}}
{"id":"b-tam-7t3-128","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 51"},"texts":{"ta":{"blocks":[{"type":"text","text":"இளமையில் காந்தியடிகளின் ஒத்துழையாமை இயக்கக் கோரிக்கையால் ஈர்க்கப்பட்டுத் தனது கல்லூிக் கல்வியைத் துறந்த தலைவர் யார்?"}],"options":[{"key":"A","text":"சுவாமிநாதன்"},{"key":"B","text":"காயிதே மில்லத் முகமது இசுமாயில்"},{"key":"C","text":"காமராசர்"},{"key":"D","text":"யாக்கூப் கான்"}],"explanation":"திருச்சி தூய வளனார் கல்லூரியில் பயின்றுகொண்டிருந்தபோது ஒத்துழையாமை இயக்கத்தில் இணைந்தார்."}}}
{"id":"b-tam-7t3-129","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 52"},"texts":{"ta":{"blocks":[{"type":"text","text":"இந்தியா விடுதலை பெற்ற பிறகு அரசியல் நிர்ணய சபைக் கூட்டத்தில் நாட்டின் ஆட்சிமொழி குறித்த விவாதத்தில் ‘பழமையான மொழிகளில் ஒன்றை ஆட்சிமொழி ஆக்க வேண்டும் என்றால் அது தமிழ்மொழிதான்’ என வாதிட்ட தலைவர் யார்?"}],"options":[{"key":"A","text":"பெரியார்"},{"key":"B","text":"காயிதே மில்லத்"},{"key":"C","text":"அறிஞர் அண்ணா"},{"key":"D","text":"ராஜாஜி"}],"explanation":"நாடாளுமன்ற அரசியல் நிர்ணய சபையில் தமிழ்மொழியே மிகப் பழமையான இலக்கியச் செறிவுமிக்க மொழி என முழங்கியவர் காயிதே மில்லத் ஆவார்."}}}
{"id":"b-tam-7t3-130","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 52"},"texts":{"ta":{"blocks":[{"type":"text","text":"1962 இந்தியா-சீனா போரின்போது தனது ஒரே மகனைப் போர்முனைக்கு அனுப்பத் தயார் என அறிவித்து அப்போதைய பிரதமர் நேருவுக்குக் கடிதம் எழுதியவர் யார்?"}],"options":[{"key":"A","text":"காமராசர்"},{"key":"B","text":"காயிதே மில்லத்"},{"key":"C","text":"பக்தவத்சலம்"},{"key":"D","text":"சி. சுப்பிரமணியம்"}],"explanation":"நாட்டின் மீதான பற்றால் தன் மகனைப் போர்முனைக்கு அனுப்ப முன்வந்து நேருவுக்குக் கடிதம் எழுதிய தேசப்பற்றாளர் காயிதே மில்லத் ஆவார்."}}}
{"id":"pyq-tam-7t3-131","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":30},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தமிழக அரசியல் வானில் கவ்வியிருந்த காரிருளை அகற்ற வந்த ஒளிக்கதிராகக் காயிதே மில்லத் திகழ்கிறார்’ - என்று புகழ்ந்து பாராட்டியவர் யார்?"}],"options":[{"key":"A","text":"தந்தை பெரியார்"},{"key":"B","text":"பேரறிஞர் அண்ணா"},{"key":"C","text":"காமராசர்"},{"key":"D","text":"மு. கருணாநிதி"}],"explanation":"காயிதே மில்லத் அவர்களின் நேர்மை மற்றும் எளிமையைப் பாராட்டி அறிஞர் அண்ணா இவ்வாறு கூறினார்."}}}
{"id":"b-tam-7t3-132","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 53"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இப்படிப்பட்ட தலைவர் கிடைப்பது அரிது. அவர் நல்ல உத்தமமான மனிதர்’ - என்று காயிதே மில்லத்தைப் பாராட்டியவர் யார்?"}],"options":[{"key":"A","text":"அறிஞர் அண்ணா"},{"key":"B","text":"தந்தை பெரியார்"},{"key":"C","text":"காமராசர்"},{"key":"D","text":"ராஜாஜி"}],"explanation":"தந்தை பெரியார் அவர்கள் காயிதே மில்லத்தின் உத்தம குணத்தைப் பாராட்டிச் சிறப்பித்துள்ளார்."}}}
{"id":"b-tam-7t3-133","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 53"},"texts":{"ta":{"blocks":[{"type":"text","text":"காயிதே மில்லத் அவர்களின் முயற்சியால் உருவாக்கப்பட்ட புகழ்பெற்ற கல்வி நிறுவனங்களை ஊர்களோடு பொருத்துக:"},{"type":"list","name":"கல்லூரி","items":[{"label":"A","text":"ஜமால் முகம்மது கல்லூரி"},{"label":"B","text":"ஃபரூக் கல்லூரி"}]},{"type":"list","name":"இடம்","items":[{"label":"1","text":"கேரளா"},{"label":"2","text":"திருச்சி"},{"label":"3","text":"சென்னை"}]}],"options":[{"key":"A","text":"A-2, B-1","mapping":{"A":"2","B":"1"}},{"key":"B","text":"A-1, B-2","mapping":{"A":"1","B":"2"}},{"key":"C","text":"A-2, B-3","mapping":{"A":"2","B":"3"}},{"key":"D","text":"A-3, B-1","mapping":{"A":"3","B":"1"}}],"explanation":"திருச்சியில் ஜமால் முகம்மது கல்லூரியும், கேரளாவில் ஃபரூக் கல்லூரியும் தொடங்கக் காரணமாக இருந்தவர் காயிதே மில்லத் ஆவார்."}}}
{"id":"b-tam-7t3-134","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 54"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எதிரொலித்தது’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"எதிர் + ரொலித்தது"},{"key":"B","text":"எதில் + ஒலித்தது"},{"key":"C","text":"எதிர் + ஒலித்தது"},{"key":"D","text":"எதி + ரொலித்தது"}],"explanation":"எதிர் + ஒலித்தது = உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி ர் + ஒ = ரொ ஆகி 'எதிரொலித்தது' எனப் புணரும்."}}}
{"id":"b-tam-7t3-135","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 54"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘முதுமை + மொழி’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"முதுமொழி"},{"key":"B","text":"முதுமைமொழி"},{"key":"C","text":"முதியமொழி"},{"key":"D","text":"முதல்மொழி"}],"explanation":"ஈறுபோதல் விதிப்படி 'மை' கெட்டு, 'முதுமொழி' எனப் புணரும்."}}}

