// பாடம் 3: மனித யந்திரம் (விரிவானம் / துணைப்பாடம் - புதுமைப்பித்தன்) [2 வினாக்கள்: Q008, Q021]
// மனித யந்திரம் சிறுகதை - புதுமைப்பித்தன் (விருத்தாசலம்),
// சிறுகதை மன்னன், நவீன தமிழ் இலக்கிய முன்னோடி,
// எந்திரமயமான நவீன நகர வாழ்க்கையில் மனிதநேயம் மற்றும் உணர்வற்ற நிலையைச் சுட்டுதல்
// ==============================================================================
{"id":"b-tam-8t7-008","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 140"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மனித யந்திரம்’ என்னும் சிறுகதையின் ஆசிரியர் யார்?"}],"options":[{"key":"A","text":"ஜெயகாந்தன்"},{"key":"B","text":"புதுமைப்பித்தன்"},{"key":"C","text":"கி. ராஜநாராயணன்"},{"key":"D","text":"லா.சா. ராமாமிருதம்"}],"explanation":"நவீன தமிழ் இலக்கியத்தின் முன்னோடியான புதுமைப்பித்தன் எழுதிய சிறுகதை 'மனித யந்திரம்' ஆகும்."}}}
{"id":"b-tam-8t7-021","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 140"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மனித யந்திரம்’ கதையில் புதுமைப்பித்தன் வெளிப்படுத்தும் முக்கிய மனிதநேயச் சிந்தனை யாது?"}],"options":[{"key":"A","text":"இயந்திரங்களின் ஆதிக்கம்"},{"key":"B","text":"பணத்தின் பின்னால் ஓடும் மனிதன் தனது மனிதத்தன்மையை இழத்தல்"},{"key":"C","text":"கிராமத்து வாழ்க்கை முறை"},{"key":"D","text":"அரசியல் ஊழல்"}],"explanation":"நவீன நகர வாழ்வில் எந்திரமாய் மாறிப்போன மனிதர்களின் உணர்வற்ற நிலையைச் சிறுகதை சுட்டுகிறது."}}}

// ==============================================================================
// பாடம் 4: வேற்றுமை (கற்கண்டு - இலக்கணம்) [11 வினாக்கள்: Q009, Q010, Q011, Q012, Q017, Q018, Q022, Q025, Q026, Q027, Q028]
// வேற்றுமை இலக்கணம் (8 வகை - PYQ 2022),
// பெயர்ச்சொல்லின் பொருளை வேறுபடுத்துவது வேற்றுமை,
// முதல் வேற்றுமை (எழுவாய் - உருபு இல்லை), எட்டாம் வேற்றுமை (விளி - உருபு இல்லை),
// வேற்றுமை உருபுகள்: 2-ஐ, 3-ஆல்/ஆன்/ஒடு/ஓடு, 4-கு, 5-இன்/இல், 6-அது/ஆது/அ, 7-கண்,
// சான்றுகள்: புலியைக் கொன்றான் (2-ஆம் வேற்றுமை), அன்பால் கட்டினான் (3-ஆம் வேற்றுமை), நண்பனுக்குக் கொடுத்தான் (4-ஆம் வேற்றுமை)
// ==============================================================================
{"id":"b-tam-8t7-009","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 144"},"texts":{"ta":{"blocks":[{"type":"text","text":"பெயர்ச்சொல்லின் பொருளை வேறுபடுத்துவது ________ எனப்படும்."}],"options":[{"key":"A","text":"விகுதி"},{"key":"B","text":"வேற்றுமை (எ.கா: ஐ, ஆல், கு, இன், அது, கண்)"},{"key":"C","text":"இடைச்சொல்"},{"key":"D","text":"உரிச்சொல்"}],"explanation":"பெயர்ச்சொல்லின் பொருளை வேறுபடுத்தும் முறை வேற்றுமை எனப்படும்; இது 8 வகைப்படும்."}}}
{"id":"pyq-tam-8t7-010","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":76},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ் இலக்கணத்தில் வேற்றுமை உருபுகள் எத்தனை வகைகளாகப் பிரிக்கப்படுகின்றன?"}],"options":[{"key":"A","text":"ஆறு வகை"},{"key":"B","text":"ஏழு வகை (முதல் மற்றும் எட்டாம் வேற்றுமைக்கு உருபு இல்லை)"},{"key":"C","text":"எட்டு வகை"},{"key":"D","text":"ஒன்பது வகை"}],"explanation":"வேற்றுமை மொத்தம் 8 வகைப்படும்; முதல் வேற்றுமை (எழுவாய்) மற்றும் எட்டாம் வேற்றுமை (விளி) ஆகியவற்றுக்கு உருபுகள் கிடையாது."}}}
{"id":"b-tam-8t7-011","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"4","C":"1","D":"3"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 145"},"texts":{"ta":{"blocks":[{"type":"text","text":"வேற்றுமை உருபுகளை அவற்றுக்குரிய எண்களுடன் சரியாகப் பொருத்துக:"},{"type":"list","name":"வேற்றுமை","items":[{"label":"A","text":"இரண்டாம் வேற்றுமை"},{"label":"B","text":"மூன்றாம் வேற்றுமை"},{"label":"C","text":"நான்காம் வேற்றுமை"},{"label":"D","text":"ஐந்தாம் வேற்றுமை"}]},{"type":"list","name":"உருபு","items":[{"label":"1","text":"கு"},{"label":"2","text":"ஐ"},{"label":"3","text":"இன், இல்"},{"label":"4","text":"ஆல், ஆன், ஒடு, ஓடு"}]}],"options":[{"key":"A","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-3, C-1, D-4","mapping":{"A":"2","B":"3","C":"1","D":"4"}},{"key":"D","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}}],"explanation":"2-ஆம் வேற்றுமை = ஐ; 3-ஆம் வேற்றுமை = ஆல், ஆன், ஒடு, ஓடு; 4-ஆம் வேற்றுமை = கு; 5-ஆம் வேற்றுமை = இன், இல்; 6-ஆம் வேற்றுமை = அது, ஆது, அ; 7-ஆம் வேற்றுமை = கண்."}}}
{"id":"b-tam-8t7-012","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 149"},"texts":{"ta":{"blocks":[{"type":"text","text":"விளி வேற்றுமை என்று அழைக்கப்படும் வேற்றுமை எது?"}],"options":[{"key":"A","text":"முதல் வேற்றுமை"},{"key":"B","text":"எட்டாம் வேற்றுமை (விளி வேற்றுமை)"},{"key":"C","text":"ஏழாம் வேற்றுமை"},{"key":"D","text":"ஆறாம் வேற்றுமை"}],"explanation":"பெயர்ச்சொல்லை விளித்து (அழைத்து)ப் கூறும் எட்டாம் வேற்றுமை 'விளி வேற்றுமை' எனப்படும்."}}}
{"id":"b-tam-8t7-017","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 144"},"texts":{"ta":{"blocks":[{"type":"text","text":"பெயர்ச்சொல்லுடன் இணைக்கப்படும் வேற்றுமை உருபுகள் எவ்வாறு அழைக்கப்படுகின்றன?"}],"options":[{"key":"A","text":"விகுதிகள்"},{"key":"B","text":"வேற்றுமை உருபுகள் (வேற்றுமைச் சொற்கள் / ஐ, ஆல், கு...)"},{"key":"C","text":"இடைநிலைகள்"},{"key":"D","text":"சாரியைகள்"}],"explanation":"பெயர்ச்சொல்லின் பொருளை வேறுபடுத்தும் உருபுகள் வேற்றுமை உருபுகள் எனப்படும்."}}}
{"id":"b-tam-8t7-018","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 144"},"texts":{"ta":{"blocks":[{"type":"text","text":"வேற்றுமை உருபுகள் ஏற்கும் போது பெயர்ச்சொற்கள் எவ்வாறு மாற்றம் பெறும்?"}],"options":[{"key":"A","text":"விகாரமடையும்"},{"key":"B","text":"சேற்றுவடிவம் / சாரியை பெற்றுத் திரிந்து நிற்கும் (வேற்றுமை உருபு ஏற்றுத் திரிவது)"},{"key":"C","text":"முற்றிலும் கெடும்"},{"key":"D","text":"மாற்றமின்றி அப்படியே நிற்கும்"}],"explanation":"பெயர்ச்சொற்கள் வேற்றுமை உருபு ஏற்கும் முன்பு சாரியை பெறுவதும் திரிந்து வருவதும் உண்டு."}}}
{"id":"b-tam-8t7-022","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 144"},"texts":{"ta":{"blocks":[{"type":"text","text":"வேற்றுமை உருபுகளை அவற்றுக்குரிய பெயர்களோடு சரியாகப் பொருத்துக:"},{"type":"list","name":"வேற்றுமை","items":[{"label":"A","text":"முதலாம் வேற்றுமை"},{"label":"B","text":"இரண்டாம் வேற்றுமை"},{"label":"C","text":"நான்காம் வேற்றுமை"},{"label":"D","text":"ஏழாம் வேற்றுமை"}]},{"type":"list","name":"உருபு","items":[{"label":"1","text":"ஐ"},{"label":"2","text":"உருபு கிடையாது (எழுவாய்)"},{"label":"3","text":"கண்"},{"label":"4","text":"கு"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-2, D-4","mapping":{"A":"3","B":"1","C":"2","D":"4"}}],"explanation":"முதலாம் வேற்றுமை = உருபு இல்லை; இரண்டாம் வேற்றுமை = ஐ; நான்காம் வேற்றுமை = கு; ஏழாம் வேற்றுமை = கண்."}}}
{"id":"b-tam-8t7-025","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 148"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘புலியைக் கொன்றான்’ என்னும் தொடரில் பயின்று வந்துள்ள வேற்றுமை எது?"}],"options":[{"key":"A","text":"முதல் வேற்றுமை"},{"key":"B","text":"இரண்டாம் வேற்றுமை (ஐ உருபு மறைந்து வந்துள்ளது)"},{"key":"C","text":"மூன்றாம் வேற்றுமை"},{"key":"D","text":"நான்காம் வேற்றுமை"}],"explanation":"புலியை + கொன்றான் என 'ஐ' உருபு மறைந்து வருவதால் இது இரண்டாம் வேற்றுமைத் தொகை (இரண்டாம் வேற்றுமை) ஆகும்."}}}
{"id":"b-tam-8t7-026","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 149"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அன்பால் கட்டினான்’ என்னும் தொடர் எவ்வகை வேற்றுமைத் தொடர்?"}],"options":[{"key":"A","text":"இரண்டாம் வேற்றுமை"},{"key":"B","text":"மூன்றாம் வேற்றுமை (ஆல் உருபு)"},{"key":"C","text":"நான்காம் வேற்றுமை"},{"key":"D","text":"ஐந்தாம் வேற்றுமை"}],"explanation":"அன்பு + ஆல் = அன்பால் என வந்துள்ளதால் இது மூன்றாம் வேற்றுமைத் தொடர் ஆகும்."}}}
{"id":"b-tam-8t7-027","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 150"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நண்பனுக்குக் கொடுத்தான்’ என்னும் தொடரில் வந்துள்ள ‘கு’ உருபு எவ்வகை வேற்றுமையைக் குறிக்கும்?"}],"options":[{"key":"A","text":"மூன்றாம் வேற்றுமை"},{"key":"B","text":"நான்காம் வேற்றுமை (கொடைப் பொருள்)"},{"key":"C","text":"ஐந்தாம் வேற்றுமை"},{"key":"D","text":"ஆறாம் வேற்றுமை"}],"explanation":"நான்காம் வேற்றுமை உருபு 'கு' ஆகும்; இது கொடை, பகை, நட்பு உள்ளிட்ட பல பொருள்களில் வரும்."}}}
{"id":"b-tam-8t7-028","kind":"assertion_reason","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 144"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"பெயர்ச்சொல்லின் பொருளை வேறுபடுத்திக் காட்டும் முறையே ‘வேற்றுமை’ எனப்படும்."},{"type":"reason","text":"வேற்றுமை உருபுகள் பெயர்ச்சொல்லுடன் இணைந்து அதன் பொருளைக் காரகக் கூறுகளாக மாற்றுகின்றன."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"வேற்றுமை இலக்கணத்தின் அடிப்படை வரையறை இதுவே; கூற்றும் காரணமும் சரியானவையே."}}}

