// பாடம் 5: திருக்குறள் & அறவியல் கலைச்சொற்கள் (வாழ்வியல் / மொழியை ஆள்வோம்) [4 வினாக்கள்: Q013, Q014, Q015, Q016]
// திருக்குறள் & கலைச்சொற்கள்,
// செயற்கை அறிந்தக் கடைத்தும் உலகத்து இயற்கை அறிந்து செயல் (தெரிந்து செயல்வகை),
// இன்னா செய்தாரைத் ஒறுத்தல் அவர்நாண நன்னயம் செய்து விடல் (இன்னா செய்யாமை),
// அருளிலார்க் கவ்வுலகம் இல்லை பொருளிலார்க் கிவ்வுலகம் இல்லாகி யாங்கு (அருளுடைமை),
// கலைச்சொற்கள்: Values (விழுமியங்கள்), Reform (சீர்திருத்தம்), Simplicity (எளிமை), Intellectual (அறிவுசார்ந்த)
// ==============================================================================
{"id":"b-tam-8t7-013","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 151"},"texts":{"ta":{"blocks":[{"type":"text","text":"அறவியல் கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"},{"type":"list","name":"ஆங்கிலச் சொல்","items":[{"label":"A","text":"Values"},{"label":"B","text":"Reform"},{"label":"C","text":"Simplicity"},{"label":"D","text":"Intellectual"}]},{"type":"list","name":"தமிழாக்கம்","items":[{"label":"1","text":"சீர்திருத்தம்"},{"label":"2","text":"மதிப்பீடுகள் / விழுமியங்கள்"},{"label":"3","text":"அறிவுசார்ந்த"},{"label":"4","text":"எளிமை"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-2, D-4","mapping":{"A":"3","B":"1","C":"2","D":"4"}}],"explanation":"Values = விழுமியங்கள்; Reform = சீர்திருத்தம்; Simplicity = எளிமை; Intellectual = அறிவுசார்ந்த; Doctrine = கொள்கை."}}}
{"id":"b-tam-8t7-014","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 152"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘செயற்கை அறிந்தக் கடைத்தும் உலகத்து இயற்கை அறிந்து செயல்’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?"}],"options":[{"key":"A","text":"உவமையணி"},{"key":"B","text":"உவமையணி (கைக்குள் இருக்கும் நெல்லிக்கனி போல)"},{"key":"C","text":"பிறிதுமொழிதல் அணி"},{"key":"D","text":"ஏகதேச உவமையணி"}],"explanation":"நன்கு அறிந்த ஒரு செயலைச் செய்வது கையில் உள்ள நெல்லிக்கனி போன்றது என உவமை கூறுவதால் இது உவமையணி ஆகும்."}}}
{"id":"b-tam-8t7-015","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 152"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இன்னா செய்தாரைத் ஒறுத்தல் அவர்நாண நன்னயம் செய்து விடல்’ - இக்குறள் வலியுறுத்தும் அறம் யாது?"}],"options":[{"key":"A","text":"பகைவரை அழித்தல்"},{"key":"B","text":"தீமை செய்தவருக்கு நன்மை செய்து அவர் வெட்கப்படுமாறு தண்டிப்பது"},{"key":"C","text":"செல்வத்தைக் கொடுத்தல்"},{"key":"D","text":"போரிடுதல்"}],"explanation":"தமக்குத் தீமை செய்தவர் நாணுமாறு அவர்களுக்கு நன்மை செய்வதே சிறந்த தண்டனை (பொறை)."}}}
{"id":"b-tam-8t7-016","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 153"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அருளிலார்க் கவ்வுலகம் இல்லை பொருளிலார்க் கிவ்வுலகம் இல்லாகி யாங்கு’ - கருணையில்லாதவரின் செல்வம் எதனைப் போல அழியும்?"}],"options":[{"key":"A","text":"மழையில்லாத மேகம்"},{"key":"B","text":"இலையுதிர்ந்த மரம் அல்லது பூப்பைப் போலச் சட்டெனத் தோன்றி உடனே அழியும்"},{"key":"C","text":"விளக்கில்லாத இருள்"},{"key":"D","text":"காற்றில் பறக்கும் இலை"}],"explanation":"அருள் இல்லாதவர் சேர்க்கும் செல்வமானது தோன்றுவது போலத் தோன்றி உடனே மறைந்துவிடும்."}}}
