{"id":"b-tam-8t7-001","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 132"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஒன்றே குலமும் ஒருவனே தேவனும் நன்றே நினைமின் நமக்குள் நமமில்லை...’ - என்னும் ‘மெய்ஞ்ஞான ஒளி’ பாடலை இயற்றியவர் யார்?"}],"options":[{"key":"A","text":"திருமூலர்"},{"key":"B","text":"தாயுமானவர்"},{"key":"C","text":"பட்டினத்தார்"},{"key":"D","text":"இராமலிங்க அடிகளார்"}],"explanation":"பராபரக் கண்ணி பாடல்கள் மூலம் அனைத்துயிர்களையும் ஒன்றாய் எண்ணும் தாயுமானவர் இப்பாடலை இயற்றியுள்ளார்."}}}
{"id":"b-tam-8t7-002","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 133"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மெய்ஞ்ஞான ஒளி’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"செந்நாப் போதார்"},{"label":"B","text":"வையகம்"},{"label":"C","text":"ஓதும்"},{"label":"D","text":"பொச்சாப்பு"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"உலகம்"},{"label":"2","text":"சோம்பல் / சோர்வு"},{"label":"3","text":"நூல்களைச் சொன்ன சான்றோர் (திருவள்ளுவர்)"},{"label":"4","text":"சொல்லும்"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}}],"explanation":"செந்நாப் போதார் = செவ்விய நாவினை உடைய சான்றோர் (வள்ளுவர்); வையம் = உலகம்; ஓதும் = சொல்லும்; பொச்சாப்பு = சோம்பல்."}}}
{"id":"b-tam-8t7-003","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 133"},"texts":{"ta":{"blocks":[{"type":"text","text":"திருச்சி விஜய ரகுநாத சேரிடம் தலைமைப் கணக்கராகப் பணிபுரிந்த ஆன்மீகக் கவிஞர் யார்?"}],"options":[{"key":"A","text":"பட்டினத்தார்"},{"key":"B","text":"தாயுமானவர்"},{"key":"C","text":"குமரகுருபரர்"},{"key":"D","text":"சிவவாக்கியார்"}],"explanation":"தாயுமானவர் திருச்சிராப்பள்ளி ஆண்ட விஜய ரகுநாத சேதுபதி மன்னரிடம் தலைமைப் கணக்கராகப் பணியாற்றியவர்."}}}
{"id":"pyq-tam-8t7-004","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":18},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எல்லாரும் இன்புற்றிருக்க நினைப்பதுவே அல்லாமல் வேறொன்றறியேன் பராபரமே’ - என்று பாடியவர் யார்?"}],"options":[{"key":"A","text":"இராமலிங்க அடிகளார்"},{"key":"B","text":"பாரதியார்"},{"key":"C","text":"தாயுமானவர்"},{"key":"D","text":"திருமூலர்"}],"explanation":"அனைத்து உயிர்களையும் தன் உயிர் போல் நேசிக்கும் பராபரக் கண்ணி பாடல்களை இயற்றியவர் தாயுமானவர் ஆவார்."}}}
{"id":"b-tam-8t7-005","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 132"},"texts":{"ta":{"blocks":[{"type":"text","text":"தாயுமானவர் ஆற்றிய பணி யாது?"}],"options":[{"key":"A","text":"மன்னரின் படைத்தலைவர்"},{"key":"B","text":"விஜய ரகுநாத சேதுபதி மன்னரிடம் தலைமைப் கணக்கர்"},{"key":"C","text":"அமைச்சர்"},{"key":"D","text":"அரசு மருத்துவர்"}],"explanation":"தாயுமானவர் திருச்சி விஜய ரகுநாத சேரிடம் தலைமைப் கணக்கராகப் பணிபுரிந்தவர்."}}}
{"id":"b-tam-8t7-006","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 132"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மெய்ஞ்ஞான ஒளி’ பாடலில் தாயுமானவர் இறைவனை எவ்வாறாகக் குறிப்பிடுகிறார்?"}],"options":[{"key":"A","text":"அரசனாக"},{"key":"B","text":"எல்லா உயிர்களுக்கும் ஒளியாக விளங்கும் மெய்ஞ்ஞான ஜோதியாக"},{"key":"C","text":"போர்க்கள வீரனாக"},{"key":"D","text":"வணிகனாக"}],"explanation":"அனைத்து உயிர்களிலும் ஊடுருவி நிற்கும் இறைவனை மெய்ஞ்ஞான ஒளியாகக் குறிப்பிடுகிறார்."}}}
{"id":"b-tam-8t7-007","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 132"},"texts":{"ta":{"blocks":[{"type":"text","text":"தாயுமானவர் இயற்றிய பராபரக் கண்ணி பாடல்கள் எதனை வலியுறுத்துகின்றன?"}],"options":[{"key":"A","text":"போர்க்களச் சிறப்பு"},{"key":"B","text":"அனைத்து உயிர்களையும் தன் உயிர் போல் நேசிக்கும் ஆன்மீகச் சமத்துவம்"},{"key":"C","text":"வணிக முறைகள்"},{"key":"D","text":"அரசியல் சுதந்திரம்"}],"explanation":"அனைத்து உயிர்களும் இன்புற்றிருக்க வேண்டும் என்ற சமத்துவ சிந்தனையை வலியுறுத்துகிறது."}}}
{"id":"b-tam-8t7-008","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 132"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மெய்ஞ்ஞான ஒளி’ பாடலில் தாயுமானவர் கூறும் சமத்துவக் கருத்து யாது?"}],"options":[{"key":"A","text":"அனைவரும் செல்வந்தர்களாக இருக்க வேண்டும்"},{"key":"B","text":"ஒன்றே குலமும் ஒருவனே தேவனும் என உணர்ந்து மனிதர்கள் பேதமின்றி வாழ்தல்"},{"key":"C","text":"அரசியல் சுதந்திரம் பெறுதல்"},{"key":"D","text":"மொழிகள் அனைத்தையும் கற்றல்"}],"explanation":"சாதி, மத பேதங்களைக் கடந்து அனைத்து உயிர்களும் சமம் என்ற ஆன்மீகச் சமத்துவத்தைத் தாயுமானவர் போற்றுகிறார்."}}}
{"id":"b-tam-8t7-009","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 136"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அயோத்திதாசர் சிந்தனைகள்’ என்னும் உரைநடைப் பகுதி எத்தகைய சீர்திருத்தச் சிந்தனைகளை விளக்குகிறது?"}],"options":[{"key":"A","text":"அரசியல் போராட்டம்"},{"key":"B","text":"கல்வி, சமத்துவம், பகுத்தறிவு மற்றும் சமூகச் சீர்திருத்தம்"},{"key":"C","text":"சினிமாத்துறை வளர்ச்சி"},{"key":"D","text":"வெளிநாட்டு வணிகம்"}],"explanation":"பண்டித அயோத்திதாசரின் சமூக சீர்திருத்தம் மற்றும் கல்விப் பணிகள் இப்பாடலில் விளக்கப்பட்டுள்ளன."}}}
{"id":"b-tam-8t7-010","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 137"},"texts":{"ta":{"blocks":[{"type":"text","text":"பண்டித அயோத்திதாசர் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"இவர் 1907-இல் 'ஒருபைசாத் தமிழன்' என்னும் வார இதழைத் தொடங்கினார்."},{"type":"statement","label":"II","text":"பின்னர் அந்த இதழின் பெயர் 'தமிழன்' என மாற்றப்பட்டது."},{"type":"statement","label":"III","text":"இவர் சமஸ்கிருதம், பாலி, ஆங்கிலம் ஆகிய மொழிகளிலும் புலமை பெற்றவர்."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"அயோத்திதாசர் பற்றிய மேற்கண்ட மூன்று கூற்றுகளும் முற்றிலும் சரியானவை."}}}
{"id":"b-tam-8t7-011","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 138"},"texts":{"ta":{"blocks":[{"type":"text","text":"அயோத்திதாசர் பதிப்பித்த மருத்துவ நூல்களுள் ஒன்று எது?"}],"options":[{"key":"A","text":"திருக்குறள் மெய்ப்பொருளுரை"},{"key":"B","text":"போகர் எழுநூறு மற்றும் அகத்தியர் இருநூறு"},{"key":"C","text":"அகநானூறு"},{"key":"D","text":"மணிமேகலை"}],"explanation":"அயோத்திதாசர் போகர் எழுநூறு, அகத்தியர் இருநூறு உள்ளிட்ட பல மருத்துவ நூல்களைப் பதிப்பித்துள்ளார்."}}}
{"id":"b-tam-8t7-012","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 136"},"texts":{"ta":{"blocks":[{"type":"text","text":"பண்டித அயோத்திதாசர் எந்தெந்த மொழிகளில் புலமை பெற்றிருந்தார்?"}],"options":[{"key":"A","text":"தமிழ் மட்டும்"},{"key":"B","text":"தமிழ், சமஸ்கிருதம், பாலி, ஆங்கிலம்"},{"key":"C","text":"தெலுங்கு, இந்தி"},{"key":"D","text":"மலையாளம், உருது"}],"explanation":"அயோத்திதாசர் தமிழ் மட்டுமின்றிச் சமஸ்கிருதம், பாலி, ஆங்கிலம் ஆகிய மொழிகளிலும் தேர்ச்சி பெற்றவர்."}}}
{"id":"b-tam-8t7-013","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 137"},"texts":{"ta":{"blocks":[{"type":"text","text":"பண்டித அயோத்திதாசர் தொடங்கிய வார இதழ் எது?"}],"options":[{"key":"A","text":"இந்தியா"},{"key":"B","text":"ஒருபைசாத் தமிழன்"},{"key":"C","text":"குடியரசு"},{"key":"D","text":"விடுதலை"}],"explanation":"அயோத்திதாசர் 1907-இல் 'ஒருபைசாத் தமிழன்' வார இதழைத் தொடங்கினார்."}}}
{"id":"b-tam-8t7-014","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 137"},"texts":{"ta":{"blocks":[{"type":"text","text":"பண்டித அயோத்திதாசர் நிறுவிய அமைப்புகளில் ஒன்று எது?"}],"options":[{"key":"A","text":"சுயமரியாதை இயக்கம்"},{"key":"B","text":"திராவிட மகா சபை (அத்துஆவைத் சங்கம்)"},{"key":"C","text":"நீதிக்கட்சி"},{"key":"D","text":"சமத்துவச் சங்கம்"}],"explanation":"அயோத்திதாசர் சாதி மறுப்பு மற்றும் சமூக முன்னேற்றத்திற்காகத் திராவிட மகா சபை போன்ற அமைப்புகளை உருவாக்க உதவினார்."}}}
{"id":"b-tam-8t7-015","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 140"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மனித யந்திரம்’ என்னும் சிறுகதையின் ஆசிரியர் யார்?"}],"options":[{"key":"A","text":"ஜெயகாந்தன்"},{"key":"B","text":"புதுமைப்பித்தன்"},{"key":"C","text":"கி. ராஜநாராயணன்"},{"key":"D","text":"லா.சா. ராமாமிருதம்"}],"explanation":"நவீன தமிழ் இலக்கியத்தின் முன்னோடியான புதுமைப்பித்தன் எழுதிய சிறுகதை 'மனித யந்திரம்' ஆகும்."}}}
{"id":"b-tam-8t7-016","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 140"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மனித யந்திரம்’ கதையில் புதுமைப்பித்தன் வெளிப்படுத்தும் முக்கிய சிந்தனை யாது?"}],"options":[{"key":"A","text":"இயந்திரங்களின் வளர்ச்சி"},{"key":"B","text":"பணத்தின் பின்னால் ஓடும் மனிதன் தனது மனிதத்தன்மையை இழத்தல்"},{"key":"C","text":"கிராமத்து வாழ்க்கை"},{"key":"D","text":"அரசியல் ஊழல்"}],"explanation":"நவீன நகர வாழ்வில் எந்திரமாய் மாறிப்போன மனிதர்களின் உணர்வற்ற நிலையைச் சிறுகதை சுட்டுகிறது."}}}
{"id":"b-tam-8t7-017","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 144"},"texts":{"ta":{"blocks":[{"type":"text","text":"பெயர்ச்சொல்லின் பொருளை வேறுபடுத்துவது ________ எனப்படும்."}],"options":[{"key":"A","text":"விகுதி"},{"key":"B","text":"வேற்றுமை (ஐ, ஆல், கு, இன், அது, கண்)"},{"key":"C","text":"இடைச்சொல்"},{"key":"D","text":"உரிச்சொல்"}],"explanation":"பெயர்ச்சொல்லின் பொருளை வேறுபடுத்தும் முறை வேற்றுமை எனப்படும்; இது 8 வகைப்படும்."}}}
{"id":"pyq-tam-8t7-018","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":76},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ் இலக்கணத்தில் வேற்றுமை உருபுகள் எத்தனை வகைகளாகப் பிரிக்கப்படுகின்றன?"}],"options":[{"key":"A","text":"ஆறு வகை"},{"key":"B","text":"ஏழு வகை"},{"key":"C","text":"எட்டு வகை (முதல் மற்றும் எட்டாம் வேற்றுமைக்கு உருபு இல்லை)"},{"key":"D","text":"ஒன்பது வகை"}],"explanation":"வேற்றுமை மொத்தம் 8 வகைப்படும்; முதல் மற்றும் எட்டாம் வேற்றுமைக்குத் தனி உருபுகள் கிடையாது."}}}
{"id":"b-tam-8t7-019","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"4","C":"1","D":"3"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 145"},"texts":{"ta":{"blocks":[{"type":"text","text":"வேற்றுமை உருபுகளை அவற்றுக்குரிய எண்களுடன் சரியாகப் பொருத்துக:"},{"type":"list","name":"வேற்றுமை","items":[{"label":"A","text":"இரண்டாம் வேற்றுமை"},{"label":"B","text":"மூன்றாம் வேற்றுமை"},{"label":"C","text":"நான்காம் வேற்றுமை"},{"label":"D","text":"ஐந்தாம் வேற்றுமை"}]},{"type":"list","name":"உருபு","items":[{"label":"1","text":"கு"},{"label":"2","text":"ஐ"},{"label":"3","text":"இன், இல்"},{"label":"4","text":"ஆல், ஆன், ஒடு, ஓடு"}]}],"options":[{"key":"A","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-3, C-1, D-4","mapping":{"A":"2","B":"3","C":"1","D":"4"}},{"key":"D","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}}],"explanation":"2-ஆம் வேற்றுமை = ஐ; 3-ஆம் வேற்றுமை = ஆல், ஆன், ஒடு, ஓடு; 4-ஆம் வேற்றுமை = கு; 5-ஆம் வேற்றுமை = இன், இல்."}}}
{"id":"b-tam-8t7-020","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 149"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘விளி வேற்றுமை’ என்று அழைக்கப்படும் வேற்றுமை எது?"}],"options":[{"key":"A","text":"முதல் வேற்றுமை"},{"key":"B","text":"எட்டாம் வேற்றுமை (விளி வேற்றுமை)"},{"key":"C","text":"ஏழாம் வேற்றுமை"},{"key":"D","text":"ஆறாம் வேற்றுமை"}],"explanation":"பெயர்ச்சொல்லை விளித்து (அழைத்து)ப் கூறும் எட்டாம் வேற்றுமை 'விளி வேற்றுமை' எனப்படும்."}}}
{"id":"b-tam-8t7-021","kind":"assertion_reason","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 144"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"பெயர்ச்சொல்லின் பொருளை வேறுபடுத்திக் காட்டும் முறையே ‘வேற்றுமை’ எனப்படும்."},{"type":"reason","text":"வேற்றுமை உருபுகள் பெயர்ச்சொல்லுடன் இணைந்து அதன் பொருளைத் தெளிவாக வெளிப்படுத்த உதவுகின்றன."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"வேற்றுமை இலக்கணத்தின் அடிப்படை வரையறை இதுவே; கூற்றும் காரணமும் சரியானவையே."}}}
{"id":"b-tam-8t7-022","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 148"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘புலியைக் கொன்றான்’ என்னும் தொடரில் பயின்று வந்துள்ள வேற்றுமை எது?"}],"options":[{"key":"A","text":"முதல் வேற்றுமை"},{"key":"B","text":"இரண்டாம் வேற்றுமை (ஐ உருபு மறைந்து வந்துள்ளது)"},{"key":"C","text":"மூன்றாம் வேற்றுமை"},{"key":"D","text":"நான்காம் வேற்றுமை"}],"explanation":"புலியை + கொன்றான் என 'ஐ' உருபு மறைந்து வருவதால் இது இரண்டாம் வேற்றுமைத் தொகையாகும்."}}}
{"id":"b-tam-8t7-023","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 149"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அன்பால் கட்டினான்’ என்னும் தொடர் எவ்வகை வேற்றுமைத் தொடர்?"}],"options":[{"key":"A","text":"இரண்டாம் வேற்றுமை"},{"key":"B","text":"மூன்றாம் வேற்றுமை (ஆல் உருபு)"},{"key":"C","text":"நான்காம் வேற்றுமை"},{"key":"D","text":"ஐந்தாம் வேற்றுமை"}],"explanation":"அன்பு + ஆல் = அன்பால் என வந்துள்ளதால் இது மூன்றாம் வேற்றுமைத் தொடர் ஆகும்."}}}
{"id":"b-tam-8t7-024","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 150"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நண்பனுக்குக் கொடுத்தான்’ என்னும் தொடரில் வந்துள்ள ‘கு’ உருபு எவ்வகை வேற்றுமையைக் குறிக்கும்?"}],"options":[{"key":"A","text":"மூன்றாம் வேற்றுமை"},{"key":"B","text":"நான்காம் வேற்றுமை (கொடைப் பொருள்)"},{"key":"C","text":"ஐந்தாம் வேற்றுமை"},{"key":"D","text":"ஆறாம் வேற்றுமை"}],"explanation":"நான்காம் வேற்றுமை உருபு 'கு' ஆகும்; இது கொடை, பகை, நட்பு உள்ளிட்ட பல பொருள்களில் வரும்."}}}
{"id":"b-tam-8t7-025","kind":"assertion_reason","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 149"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"பெயர்ச்சொல்லை விளித்து (அழைத்துப்) கூறும் வேற்றுமை எட்டாம் வேற்றுமை எனப்படும்."},{"text":"எட்டாம் வேற்றுமை விளி வேற்றுமை என்றும் அழைக்கப்படுகிறது.","type":"reason"}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"விளி வேற்றுமையின் இலக்கண விளக்கம் இதுவே; கூற்றும் காரணமும் சரி."}}}
{"id":"b-tam-8t7-026","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 144"},"texts":{"ta":{"blocks":[{"type":"text","text":"பெயர்ச்சொல்லுடன் இணைக்கப்படும் வேற்றுமை உருபுகள் எவ்வாறு அழைக்கப்படுகின்றன?"}],"options":[{"key":"A","text":"விகுதிகள்"},{"key":"B","text":"வேற்றுமை உருபுகள் (ஐ, ஆல், கு...)"},{"key":"C","text":"இடைநிலைகள்"},{"key":"D","text":"சாரியைகள்"}],"explanation":"பெயர்ச்சொல்லின் பொருளை வேறுபடுத்தும் உருபுகள் வேற்றுமை உருபுகள் எனப்படும்."}}}
{"id":"b-tam-8t7-027","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 144"},"texts":{"ta":{"blocks":[{"type":"text","text":"வேற்றுமை உருபுகள் ஏற்கும் போது பெயர்ச்சொற்கள் எவ்வாறு மாற்றம் பெறும்?"}],"options":[{"key":"A","text":"விகாரமடையும்"},{"key":"B","text":"சாரியை பெற்றுத் திரிந்து நிற்கும் (வேற்றுமை உருபு ஏற்றுத் திரிவது)"},{"key":"C","text":"முற்றிலும் கெடும்"},{"key":"D","text":"மாற்றமின்றி அப்படியே நிற்கும்"}],"explanation":"பெயர்ச்சொற்கள் வேற்றுமை உருபு ஏற்கும் முன்பு சாரியை பெறுவதும் திரிந்து வருவதும் உண்டு."}}}
{"id":"b-tam-8t7-028","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 144"},"texts":{"ta":{"blocks":[{"type":"text","text":"வேற்றுமை உருபுகளை அவற்றுக்குரிய பெயர்களோடு சரியாகப் பொருத்துக:"},{"type":"list","name":"வேற்றுமை","items":[{"label":"A","text":"முதலாம் வேற்றுமை"},{"label":"B","text":"இரண்டாம் வேற்றுமை"},{"label":"C","text":"நான்காம் வேற்றுமை"},{"label":"D","text":"ஏழாம் வேற்றுமை"}]},{"type":"list","name":"உருபு","items":[{"label":"1","text":"ஐ"},{"label":"2","text":"உருபு கிடையாது (எழுவாய்)"},{"label":"3","text":"கண்"},{"label":"4","text":"கு"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-2, D-4","mapping":{"A":"3","B":"1","C":"2","D":"4"}}],"explanation":"முதலாம் வேற்றுமை = உருபு இல்லை; இரண்டாம் வேற்றுமை = ஐ; நான்காம் வேற்றுமை = கு; ஏழாம் வேற்றுமை = கண்."}}}
{"id":"b-tam-8t7-029","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 151"},"texts":{"ta":{"blocks":[{"type":"text","text":"அறவியல் கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"},{"type":"list","name":"ஆங்கிலச் சொல்","items":[{"label":"A","text":"Values"},{"label":"B","text":"Reform"},{"label":"C","text":"Simplicity"},{"label":"D","text":"Intellectual"}]},{"type":"list","name":"தமிழாக்கம்","items":[{"label":"1","text":"சீர்திருத்தம்"},{"label":"2","text":"மதிப்பீடுகள் / விழுமியங்கள்"},{"label":"3","text":"அறிவுசார்ந்த"},{"label":"4","text":"எளிமை"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-2, D-4","mapping":{"A":"3","B":"1","C":"2","D":"4"}}],"explanation":"Values = விழுமியங்கள்; Reform = சீர்திருத்தம்; Simplicity = எளிமை; Intellectual = அறிவுசார்ந்த."}}}
{"id":"b-tam-8t7-030","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 152"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘செயற்கை அறிந்தக்கால் என்கை அகத்துமைப் பூச்சிக்கை யற்று’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?"}],"options":[{"key":"A","text":"உவமையணி"},{"key":"B","text":"உவமையணி (கைநெல்லிக்கனி உவமை)"},{"key":"C","text":"பிறிதுமொழிதல் அணி"},{"key":"D","text":"ஏகதேச உவமையணி"}],"explanation":"நன்கு அறிந்த ஒரு செயலைச் செய்வது கையில் உள்ள நெல்லிக்கனி போன்றது என உவமை கூறுவதால் இது உவமையணி ஆகும்."}}}
{"id":"b-tam-8t7-031","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 152"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இன்னா செய்தாரைத் ஒறுத்தல் அவர்நாண நன்னயம் செய்து விடல்’ - இக்குறள் வலியுறுத்தும் அறம் யாது?"}],"options":[{"key":"A","text":"பகைவரை அழித்தல்"},{"key":"B","text":"தீமை செய்தவருக்கு நன்மை செய்து அவர் வெட்கப்படுமாறு தண்டிப்பது"},{"key":"C","text":"செல்வத்தைக் கொடுத்தல்"},{"key":"D","text":"போரிடுதல்"}],"explanation":"தமக்குத் தீமை செய்தவர் நாணுமாறு அவர்களுக்கு நன்மை செய்வதே சிறந்த தண்டனை."}}}
{"id":"b-tam-8t7-032","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 153"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பொருளற்றார் பூப்பைப் போலத் தோன்றும் அருளற்றார் அற்ற கொடி’ - கருணையில்லாதவரின் செல்வம் எதனைப் போல அழியும்?"}],"options":[{"key":"A","text":"மழையில்லாத மேகம்"},{"key":"B","text":"இலையுதிர்ந்த மரம் அல்லது பூப்பைப் போலச் சட்டெனத் தோன்றி உடனே அழியும்"},{"key":"C","text":"விளக்கில்லாத இருள்"},{"key":"D","text":"காற்றில் பறக்கும் இலை"}],"explanation":"அருள் இல்லாதவர் சேர்க்கும் செல்வமானது தோன்றுவது போலத் தோன்றி உடனே மறைந்துவிடும்."}}}
