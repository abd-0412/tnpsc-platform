// பாடம் 3: கல்விக்கண் திறந்தவர் (காமராசர் உரைநடை) [Q150 - Q163]
// பள்ளித் தொலைவுத் திட்டம், பாரத ரத்னா, கல்வி வளர்ச்சி நாள், மணிமண்டபம், K-Plan
// ==============================================================================
{"id": "b-tam-6t1-150", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "2", "B": "1", "C": "3"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 48"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "காமராசரின் பள்ளி அமைக்கும் தொலைவுத் திட்டத்தை அதன் பள்ளிகளோடு பொருத்துக:"}, {"type": "list", "name": "பள்ளியின் நிலை", "items": [{"label": "A", "text": "ஆரம்பப்பள்ளி"}, {"label": "B", "text": "நடுநிலைப்பள்ளி"}, {"label": "C", "text": "உயர்நிலைப்பள்ளி"}]}, {"type": "list", "name": "தொலைவுத் திட்டம்", "items": [{"label": "1", "text": "மூன்று மைல் தூரம்"}, {"label": "2", "text": "ஒரு மைல் தூரம்"}, {"label": "3", "text": "ஐந்து மைல் தூரம்"}]}], "options": [{"key": "A", "text": "A-2, B-1, C-3", "mapping": {"A": "2", "B": "1", "C": "3"}}, {"key": "B", "text": "A-1, B-2, C-3", "mapping": {"A": "1", "B": "2", "C": "3"}}, {"key": "C", "text": "A-3, B-1, C-2", "mapping": {"A": "3", "B": "1", "C": "2"}}, {"key": "D", "text": "A-2, B-3, C-1", "mapping": {"A": "2", "B": "3", "C": "1"}}], "explanation": "ஒரு மைல் தூரத்தில் ஆரம்பப்பள்ளி, மூன்று மைல் தூரத்தில் நடுநிலைப்பள்ளி, ஐந்து மைல் தூரத்தில் உயர்நிலைப்பள்ளி இருக்க வேண்டும் எனத் திட்டமிட்டார்."}}}
{"id": "pyq-tam-6t1-151", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 11}, "texts": {"ta": {"blocks": [{"type": "text", "text": "காமராசரைக் ‘கல்விக்கண் திறந்தவர்’ என மனமாரப் பாராட்டிய தலைவர் யார்?"}], "options": [{"key": "A", "text": "அறிஞர் அண்ணா"}, {"key": "B", "text": "பாரதியார்"}, {"key": "C", "text": "தந்தை பெரியார்"}, {"key": "D", "text": "ராஜாஜி"}], "explanation": "கல்வித்துறை விதிகளை மாணவர்களுக்காக மாற்றிப் பள்ளிகளைத் திறந்த காமராசரைத் 'தந்தை பெரியார்' மனமாரப் பாராட்டினார்."}}}
{"id": "b-tam-6t1-152", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 49"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பெருந்தலைவர் காமராசரின் சிறப்புப் பெயர்களுள் பொருந்தாத ஒன்றைத் தேர்வு செய்க:"}], "options": [{"key": "A", "text": "கருப்புக் காந்தி, படிக்காத மேதை"}, {"key": "B", "text": "கர்மவீரர், ஏழைப்பங்காளர்"}, {"key": "C", "text": "தலைவர்களை உருவாக்குபவர் (King Maker)"}, {"key": "D", "text": "வைக்கம் வீரர்"}], "explanation": "வைக்கம் வீரர் என்பது தந்தை பெரியாரின் சிறப்புப் பெயர். காமராசரின் சிறப்புப் பெயர்கள்: பெருந்தலைவர், படிக்காத மேதை, கர்மவீரர், கருப்புக் காந்தி, ஏழைப்பங்காளர், தலைவர்களை உருவாக்குபவர்."}}}
{"id": "b-tam-6t1-153", "kind": "statements", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 49"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "காமராசரின் கல்விப் பணிகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "காமராசர் முதல்வராகப் பதவியேற்றபோது மூடப்பட்டிருந்த சுமார் 6000 தொடக்கப்பள்ளிகளை உடனடியாகத் திறக்க ஆணையிட்டார்."}, {"type": "statement", "label": "II", "text": "மாணவர்கள் பசியின்றிப் படிக்க மதிய உணவுத் திட்டத்தையும், ஏற்றத்தாழ்வின்றிப் பயிலச் சீருடைத் திட்டத்தையும் கொண்டு வந்தார்."}, {"type": "statement", "label": "III", "text": "பள்ளிகளின் வசதிகளைப் பெருக்கப் பள்ளிச் சீரமைப்பு மாநாடுகள் நடத்தினார்."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "C", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "பாடப்பகுதியில் காமராசர் ஆற்றிய கல்விப் பணிகளாக இம்மூன்று முக்கிய சாதனைகளும் தெளிவாகக் குறிப்பிடப்பட்டுள்ளன."}}}
{"id": "pyq-tam-6t1-154", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 22}, "texts": {"ta": {"blocks": [{"type": "text", "text": "நடுவண் அரசு காமராசருக்கு ‘பாரத ரத்னா’ விருது வழங்கிய ஆண்டு எது?"}], "options": [{"key": "A", "text": "1971"}, {"key": "B", "text": "1976"}, {"key": "C", "text": "1980"}, {"key": "D", "text": "1984"}], "explanation": "நடுவண் அரசு 1976-இல் பெருந்தலைவர் காமராசருக்குப் பாரத ரத்னா விருது வழங்கிச் சிறப்பித்தது."}}}
{"id": "b-tam-6t1-155", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 49"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "காமராசரின் பிறந்தநாளான ஜூலை 15-ஆம் நாள் தமிழ்நாடு அரசால் எந்நாளாகக் கொண்டாடப்படுகிறது?"}], "options": [{"key": "A", "text": "மாணவர் நாள்"}, {"key": "B", "text": "கல்வி வளர்ச்சி நாள்"}, {"key": "C", "text": "இளைஞர் நாள்"}, {"key": "D", "text": "குழந்தைகள் நாள்"}], "explanation": "காமராசரின் பிறந்தநாளான ஜூலை 15 கல்வி வளர்ச்சி நாளாகக் கொண்டாடப்பட்டு வருகிறது."}}}
{"id": "b-tam-6t1-156", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 49"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கன்னியாகுமரியில் காமராசருக்கு மணிமண்டபம் அமைக்கப்பட்ட நாள் எது?"}], "options": [{"key": "A", "text": "15.07.1976"}, {"key": "B", "text": "02.10.1985"}, {"key": "C", "text": "02.10.2000"}, {"key": "D", "text": "15.08.2005"}], "explanation": "கன்னியாகுமரியில் காமராசருக்கு 02.10.2000 அன்று அரசு மணிமண்டபம் அமைத்தது."}}}
{"id": "b-tam-6t1-157", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 49"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "சென்னையில் உள்ள எந்த விமான நிலையத்திற்குக் காமராசரின் பெயர் சூட்டப்பட்டுள்ளது?"}], "options": [{"key": "A", "text": "பன்னாட்டு விமான நிலையம்"}, {"key": "B", "text": "உள்நாட்டு விமான நிலையம்"}, {"key": "C", "text": "சரக்கு விமான நிலையம்"}, {"key": "D", "text": "தாம்பரம் விமான நிலையம்"}], "explanation": "சென்னையில் உள்ள உள்நாட்டு விமான நிலையத்திற்குக் காமராசர் பெயர் சூட்டப்பட்டுள்ளது. (பன்னாட்டு முனையத்திற்கு அண்ணா பெயர்)."}}}
{"id": "b-tam-6t1-158", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 48"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பரமக்குடி தரைப்பாலத்தில் காட்டாற்றில் வெள்ளம் சென்ற நிகழ்வில் காமராசர் பள்ளி கட்ட விதிவிலக்கு அளித்த தூர விதிமுறை யாது?"}], "options": [{"key": "A", "text": "ஒரு மைல் தூரம்"}, {"key": "B", "text": "இரண்டு மைல் தூரம்"}, {"key": "C", "text": "மூன்று மைல் தூரம்"}, {"key": "D", "text": "ஐந்து மைல் தூரம்"}], "explanation": "மூன்று மைல் தூரத்திற்குள் பள்ளி இருந்தால் அனுமதி இல்லை என்ற விதியை மாணவர் நலனுக்காகத் தளர்த்திப் பள்ளி கட்ட உத்தரவிட்டார்."}}}
{"id": "b-tam-6t1-159", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 50"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பசியின்றி’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}], "options": [{"key": "A", "text": "பசி + இன்றி"}, {"key": "B", "text": "பசி + யின்றி"}, {"key": "C", "text": "பசு + இன்றி"}, {"key": "D", "text": "பசிய + இன்றி"}], "explanation": "பசி + இன்றி = உடம்படுமெய் 'ய்' தோன்றி, ய் + இ = யி ஆகி பசியின்றி எனப் புணரும்."}}}
{"id": "b-tam-6t1-160", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 50"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘படிப்பறிவு’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}], "options": [{"key": "A", "text": "படி + அறிவு"}, {"key": "B", "text": "படிப்பு + அறிவு"}, {"key": "C", "text": "படி + வறிவு"}, {"key": "D", "text": "படிப்பு + வறிவு"}], "explanation": "படிப்பு + அறிவு = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'ப்பு' வில் உ கெட்டு, ப் + அ = ப ஆகி படிப்பறிவு எனப் புணரும்."}}}
{"id": "b-tam-6t1-161", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 50"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘காடு + ஆறு’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}], "options": [{"key": "A", "text": "காட்டாறு"}, {"key": "B", "text": "காடாறு"}, {"key": "C", "text": "காட்டுஆறு"}, {"key": "D", "text": "காடுஆறு"}], "explanation": "நெடிலோடும் உயிர்த்தொடர்க் குற்றுகரங்களுள் ட ற ஒற்று இரட்டும் விதிப்படி 'ட்' இரட்டித்து, காட்டாறு எனப் புணரும்."}}}
{"id": "extra-tam-6t1-162", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "other", "note": "காமராசர் வரலாற்று கூடுதல் வினா"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பெருந்தலைவர் காமராசரின் அரசியல் குருவாகத் திகழ்ந்த பெருமகன் யார்?"}], "options": [{"key": "A", "text": "கோபால கிருஷ்ண கோகலே"}, {"key": "B", "text": "தீரர் சத்தியமூர்த்தி"}, {"key": "C", "text": "சுப்பிரமணிய சிவா"}, {"key": "D", "text": "வ.உ. சிதம்பரனார்"}], "explanation": "காமராசர் தீரர் சத்தியமூர்த்தியைத் தம்முடைய அரசியல் குருவாக ஏற்றுக்கொண்டார்."}}}
{"id": "extra-tam-6t1-163", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "other", "note": "காமராசர் பதவித் திட்டம்"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கட்சிப் பணிக்காக மூத்த தலைவர்கள் பதவிகளைத் துறக்க வேண்டும் எனத் தாம் பதவி விலகி வழிகாட்டிய காமராசரின் திட்டம் எது?"}], "options": [{"key": "A", "text": "கல்வித் திட்டம்"}, {"key": "B", "text": "கே-திட்டம் (K-Plan)"}, {"key": "C", "text": "வளர்ச்சித் திட்டம்"}, {"key": "D", "text": "பஞ்சாயத்துத் திட்டம்"}], "explanation": "1963-இல் காங்கிரஸ் கட்சியைப் பலப்படுத்த மூத்த தலைவர்கள் பதவி விலக வேண்டும் எனக் கொண்டுவந்த திட்டம் 'K-Plan' ஆகும்."}}}

// ==============================================================================
// பாடம் 4: நூலகம் நோக்கி (அண்ணா நூற்றாண்டு நூலகம்) [Q164 - Q175]
// 8 ஏக்கர் 9 அடுக்குகள், முனைவர் ச. இரா. அரங்கநாதன், தரைத்தளம் முதல் 8-ஆம் தளம் வரை
// ==============================================================================
{"id": "b-tam-6t1-164", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 51"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "சென்னைக் கோட்டூர்புரத்தில் அமைந்துள்ள அண்ணா நூற்றாண்டு நூலகம் ஆசியக் கண்டத்திலேயே எத்தனையாவது பெரிய நூலகம் ஆகும்?"}], "options": [{"key": "A", "text": "இரண்டாவது"}, {"key": "B", "text": "மூன்றாவது"}, {"key": "C", "text": "முதலாவது"}, {"key": "D", "text": "நான்காவது"}], "explanation": "அண்ணா நூற்றாண்டு நூலகம் ஆசியக் கண்டத்திலேயே மூன்றாவது பெரிய நூலகம் ஆகும். (2025 புதிய பாடநூல் திருத்தத்தின்படி 'மூன்றாவது')."}}}
{"id": "b-tam-6t1-165", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 51"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "அண்ணா நூற்றாண்டு நூலகத்தின் மொத்தப் பரப்பளவு மற்றும் அடுக்குகளின் எண்ணிக்கை முறையே எவை?"}], "options": [{"key": "A", "text": "6 ஏக்கர், 7 அடுக்குகள்"}, {"key": "B", "text": "10 ஏக்கர், 8 அடுக்குகள்"}, {"key": "C", "text": "8 ஏக்கர், தரைத்தளத்தோடு 9 அடுக்குகள்"}, {"key": "D", "text": "5 ஏக்கர், 8 அடுக்குகள்"}], "explanation": "அண்ணா நூற்றாண்டு நூலகம் 8 ஏக்கர் பரப்பளவில், தரைத்தளத்தோடு சேர்த்து 9 அடுக்குகளைக் கொண்டுள்ளது."}}}
{"id": "pyq-tam-6t1-166", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 19}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘இந்திய நூலகவியலின் தந்தை’ (Father of Indian Library Science) என்று அழைக்கப்படுபவர் யார்?"}], "options": [{"key": "A", "text": "அறிஞர் அண்ணா"}, {"key": "B", "text": "முனைவர் ச. இரா. அரங்கநாதன்"}, {"key": "C", "text": "காமராசர்"}, {"key": "D", "text": "டாக்டர் அம்பேத்கர்"}], "explanation": "நூலக விதிகளை உருவாக்கிய முனைவர் ச. இரா. அரங்கநாதன் 'இந்திய நூலகவியலின் தந்தை' என அழைக்கப்படுகிறார்."}}}
{"id": "b-tam-6t1-167", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 52"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "அண்ணா நூற்றாண்டு நூலகத்தில் பார்வைத் திறன் குறைபாடு உடையோருக்கான பிரெய்லி நூல்கள் பிரிவு எந்தத் தளத்தில் அமைந்துள்ளது?"}], "options": [{"key": "A", "text": "தரைத்தளம்"}, {"key": "B", "text": "முதல் தளம்"}, {"key": "C", "text": "இரண்டாம் தளம்"}, {"key": "D", "text": "ஏழாம் தளம்"}], "explanation": "தரைத்தளத்தில் சொந்த நூல் படிப்பகமும், பார்வைத் திறன் குறைபாடு உடையோருக்கான பிரெய்லி நூல்களும் இடம்பெற்றுள்ளன."}}}
{"id": "b-tam-6t1-168", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 52"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "குழந்தைகளுக்காகச் சிறப்பாக உருவாக்கப்பட்ட முதல் தளத்தில் பிற நாடுகளில் இருந்து திரட்டப்பட்ட எத்தனைக்கும் மேற்பட்ட நூல்கள் உள்ளன?"}], "options": [{"key": "A", "text": "20,000-க்கும் மேற்பட்ட"}, {"key": "B", "text": "50,000-க்கும் மேற்பட்ட"}, {"key": "C", "text": "1,00,000-க்கும் மேற்பட்ட"}, {"key": "D", "text": "10,000-க்கும் மேற்பட்ட"}], "explanation": "முதல் தளத்தில் 20 ஆயிரத்துக்கும் மேற்பட்ட குறுந்தகடுகளும், பிற நாடுகளில் இருந்து திரட்டப்பட்ட 50 ஆயிரத்துக்கும் மேற்பட்ட நூல்களும் உள்ளன."}}}
{"id": "b-tam-6t1-169", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 53"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "அண்ணா நூற்றாண்டு நூலகத்தின் எந்தத் தளத்தில் பழமையான ஓலைச்சுவடிகள் கொண்ட ‘அரசு கீழ்த்திசைச் சுவடிகள் நூலகம்’ அமைந்துள்ளது?"}], "options": [{"key": "A", "text": "ஐந்தாம் தளம்"}, {"key": "B", "text": "ஆறாம் தளம்"}, {"key": "C", "text": "ஏழாம் தளம்"}, {"key": "D", "text": "எட்டாம் தளம்"}], "explanation": "ஏழாம் தளத்தில் வரலாறு, புவியியல், சுற்றுலா நூல்களுடன் 'அரசு கீழ்த்திசைச் சுவடிகள் நூலகம்' இயங்கி வருகிறது."}}}
{"id": "b-tam-6t1-170", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 53"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஆசியக் கண்டத்திலேயே மிகப்பெரிய நூலகம் எந்த நாட்டில் அமைந்துள்ளது?"}], "options": [{"key": "A", "text": "இந்தியா"}, {"key": "B", "text": "சீனா"}, {"key": "C", "text": "ஜப்பான்"}, {"key": "D", "text": "சிங்கப்பூர்"}], "explanation": "பக்கம் 53 தெரிந்து தெளிவோம் குறிப்பின்படி, ஆசியக் கண்டத்திலேயே மிகப் பெரிய நூலகம் சீனாவில் உள்ளது."}}}
{"id": "pyq-tam-6t1-171", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 62}, "texts": {"ta": {"blocks": [{"type": "text", "text": "சிறந்த நூலகர்களுக்குத் தமிழ்நாடு அரசால் வழங்கப்படும் விருதின் பெயர் யாது?"}], "options": [{"key": "A", "text": "திருவள்ளுவர் விருது"}, {"key": "B", "text": "முனைவர் ச. இரா. அரங்கநாதன் விருது"}, {"key": "C", "text": "அண்ணா விருது"}, {"key": "D", "text": "காமராசர் விருது"}], "explanation": "நூலகப் பணியில் சிறந்து விளங்குபவர்களுக்கு முனைவர் ச. இரா. அரங்கநாதன் விருது வழங்கப்படுகிறது."}}}
{"id": "b-tam-6t1-172", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "3", "B": "1", "C": "4", "D": "2"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 54"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "அண்ணா நூற்றாண்டு நூலகத் தளங்களையும் அங்குள்ள நூல்களின் பிரிவுகளையும் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "தளம்", "items": [{"label": "A", "text": "இரண்டாம் தளம்"}, {"label": "B", "text": "மூன்றாம் தளம்"}, {"label": "C", "text": "ஐந்தாம் தளம்"}, {"label": "D", "text": "ஆறாம் தளம்"}]}, {"type": "list", "name": "நூல்கள் பிரிவு", "items": [{"label": "1", "text": "கணினி அறிவியல், தத்துவம், அரசியல்"}, {"label": "2", "text": "பொறியியல், வேளாண்மை, திரைப்படக்கலை"}, {"label": "3", "text": "தமிழ் நூல்கள்"}, {"label": "4", "text": "கணிதம், அறிவியல், மருத்துவம்"}]}], "options": [{"key": "A", "text": "A-3, B-1, C-4, D-2", "mapping": {"A": "3", "B": "1", "C": "4", "D": "2"}}, {"key": "B", "text": "A-1, B-3, C-2, D-4", "mapping": {"A": "1", "B": "3", "C": "2", "D": "4"}}, {"key": "C", "text": "A-3, B-4, C-1, D-2", "mapping": {"A": "3", "B": "4", "C": "1", "D": "2"}}, {"key": "D", "text": "A-2, B-1, C-4, D-3", "mapping": {"A": "2", "B": "1", "C": "4", "D": "3"}}], "explanation": "2-ஆம் தளம் = தமிழ் நூல்கள்; 3-ஆம் தளம் = கணினி, தத்துவம், அரசியல்; 5-ஆம் தளம் = கணிதம், அறிவியல், மருத்துவம்; 6-ஆம் தளம் = பொறியியல், வேளாண்மை, திரைப்படம்."}}}
{"id": "b-tam-6t1-173", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 54"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "அண்ணா நூற்றாண்டு நூலகத்தின் எட்டாம் தளத்தில் அமைந்துள்ள பிரிவுகள் எவை?"}], "options": [{"key": "A", "text": "பொருளியல், சட்டம் மற்றும் வணிகவியல்"}, {"key": "B", "text": "கல்வித் தொலைக்காட்சி மற்றும் நூலக அலுவலகப் பிரிவு"}, {"key": "C", "text": "வரலாறு, புவியியல் மற்றும் சுற்றுலா"}, {"key": "D", "text": "குழந்தைகள் விளையாட்டுப் பிரிவு"}], "explanation": "எட்டாம் தளத்தில் கல்வித் தொலைக்காட்சி மற்றும் நூலகத்தின் தலைமை அலுவலகப் பிரிவு அமைந்துள்ளது."}}}
{"id": "extra-tam-6t1-174", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "other", "note": "தேசிய நூலக நாள் கூடுதல் வினா"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "இந்தியாவில் தேசிய நூலக நாளாகக் (National Library Day) கடைப்பிடிக்கப்படும் நாள் எது?"}], "options": [{"key": "A", "text": "ஜூலை 15"}, {"key": "B", "text": "ஆகஸ்ட் 9 (ரங்கநாதன் பிறந்தநாள்)"}, {"key": "C", "text": "அக்டோபர் 2"}, {"key": "D", "text": "நவம்பர் 14"}], "explanation": "இந்திய நூலகவியலின் தந்தை முனைவர் ச. இரா. அரங்கநாதனின் பிறந்தநாளான ஆகஸ்ட் 9 தேசிய நூலக நாளாகக் கொண்டாடப்படுகிறது."}}}
{"id": "extra-tam-6t1-175", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "other", "note": "நூலக வரலாற்று வினா"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தமிழ்நாட்டின் மிகப்பழமையான கன்னிமாரா பொது நூலகம் சென்னையில் தொடங்கப்பட்ட ஆண்டு எது?"}], "options": [{"key": "A", "text": "1850"}, {"key": "B", "text": "1875"}, {"key": "C", "text": "1896"}, {"key": "D", "text": "1910"}], "explanation": "சென்னையில் அமைந்துள்ள புகழ்பெற்ற கன்னிமாரா பொது நூலகம் 1896-ஆம் ஆண்டு தொடங்கப்பட்டது."}}}

// ==============================================================================
// பாடம் 5: மொழிமுதல், இறுதி எழுத்துகள் (கற்கண்டு - இலக்கணம்) [Q176 - Q185]
// மொழிமுதல் எழுத்துகள் (102), க ச த ந ப ம, ஞ (4), ய (6), வ (8), ங (1), வராத எழுத்துகள்
// ==============================================================================
{"id": "b-tam-6t1-176", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 55"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "சொல்லின் முதலில் வரும் எழுத்துகளை எவ்வாறு அழைப்பர்?"}], "options": [{"key": "A", "text": "மொழி இறுதி எழுத்துகள்"}, {"key": "B", "text": "மொழிமுதல் எழுத்துகள்"}, {"key": "C", "text": "சார்பெழுத்துகள்"}, {"key": "D", "text": "இணை எழுத்துகள்"}], "explanation": "'மொழி' என்பதற்குச் சொல் என்னும் பொருளும் உண்டு. சொல்லின் முதலில் வரும் எழுத்துகளை மொழிமுதல் எழுத்துகள் என்பர்."}}}
{"id": "b-tam-6t1-177", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 55"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "உயிர் எழுத்துகளில் எத்தனை எழுத்துகள் சொல்லின் முதலில் வரும்?"}], "options": [{"key": "A", "text": "குறில் 5 மட்டுமே"}, {"key": "B", "text": "12 உயிர் எழுத்துகளும்"}, {"key": "C", "text": "நெடில் 7 மட்டுமே"}, {"key": "D", "text": "எவையும் வராது"}], "explanation": "உயிர் எழுத்துகள் பன்னிரண்டும் சொல்லின் முதலில் வரும்."}}}
{"id": "b-tam-6t1-178", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 55"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "எந்தெந்த உயிர்மெய் வரிசைகளில் உள்ள எல்லா உயிர்மெய் எழுத்துகளும் சொல்லின் முதலில் வரும்?"}], "options": [{"key": "A", "text": "க, ச, த, ந, ப, ம"}, {"key": "B", "text": "ங, ஞ, ய, வ"}, {"key": "C", "text": "ட, ண, ர, ல"}, {"key": "D", "text": "ழ, ள, ற, ன"}], "explanation": "க, ச, த, ந, ப, ம ஆகிய 6 உயிர்மெய் வரிசைகளில் உள்ள 12 உயிர்மெய் வடிவங்களும் சொல்லின் முதலில் வரும் (6 x 12 = 72)."}}}
{"id": "b-tam-6t1-179", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 55"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘ங’ வரிசையில் எத்தனை எழுத்து மட்டுமே சொல்லில் முதல் எழுத்தாக வருகிறது?"}], "options": [{"key": "A", "text": "எழுத்துகள் ஏதும் இல்லை"}, {"key": "B", "text": "‘ங’ என்னும் ஓர் எழுத்து மட்டும் (எ.கா: ஙனம்)"}, {"key": "C", "text": "நான்கு எழுத்துகள்"}, {"key": "D", "text": "பன்னிரண்டு எழுத்துகள்"}], "explanation": "ங வரிசையில் 'ங' என்னும் ஓர் எழுத்து மட்டுமே சொல்லின் முதலில் வரும். இக்காலத்தில் அது அங்ஙனம், இங்ஙனம், எங்ஙனம் என்றே வழங்கி வருகிறது."}}}
{"id": "pyq-tam-6t1-180", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 76}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘ஞ’ வரிசையில் சொல்லின் முதலில் வரும் எழுத்துகளின் மொத்த எண்ணிக்கை யாது?"}], "options": [{"key": "A", "text": "1 எழுத்து"}, {"key": "B", "text": "2 எழுத்துகள்"}, {"key": "C", "text": "4 எழுத்துகள் (ஞ, ஞா, ஞெ, ஞொ)"}, {"key": "D", "text": "6 எழுத்துகள்"}], "explanation": "ஞ வரிசையில் ஞ, ஞா, ஞெ, ஞொ ஆகிய 4 எழுத்துகள் மட்டுமே சொல்லின் முதலில் வரும்."}}}
{"id": "pyq-tam-6t1-181", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 81}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘ய’ வரிசையில் சொல்லின் முதலில் வரும் எழுத்துகள் எத்தனை?"}], "options": [{"key": "A", "text": "4 எழுத்துகள்"}, {"key": "B", "text": "5 எழுத்துகள்"}, {"key": "C", "text": "6 எழுத்துகள் (ய, யா, யு, யூ, யோ, யௌ)"}, {"key": "D", "text": "8 எழுத்துகள்"}], "explanation": "ய வரிசையில் ய, யா, யு, யூ, யோ, யௌ ஆகிய ஆறு எழுத்துகள் மட்டுமே மொழிக்கு முதலில் வரும்."}}}
{"id": "pyq-tam-6t1-182", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 83}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘வ’ வரிசையில் சொல்லின் முதலில் வரும் எழுத்துகள் மொத்தம் எத்தனை?"}], "options": [{"key": "A", "text": "6 எழுத்துகள்"}, {"key": "B", "text": "7 எழுத்துகள்"}, {"key": "C", "text": "8 எழுத்துகள் (வ, வா, வி, வீ, வெ, வே, வை, வௌ)"}, {"key": "D", "text": "12 எழுத்துகள்"}], "explanation": "வகர வரிசையில் வ, வா, வி, வீ, வெ, வே, வை, வௌ ஆகிய எட்டு எழுத்துகள் மொழிக்கு முதலில் வரும்."}}}
{"id": "b-tam-6t1-183", "kind": "statements", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "D", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 56"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "மொழிக்கு முதலில் வராத எழுத்துகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "மெய்யெழுத்துகள் பதினெட்டும் தனித்துச் சொல்லின் முதலில் வாரா."}, {"type": "statement", "label": "II", "text": "ட, ண, ர, ல, ழ, ள, ற, ன ஆகிய எட்டு உயிர்மெய் வரிசைகளில் உள்ள ஓர் எழுத்து கூடச் சொல்லின் முதலில் வராது."}, {"type": "statement", "label": "III", "text": "ஆய்த எழுத்து சொல்லின் முதலில் வராது."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "C", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "மொழிக்கு முதலில் வராதவை: மெய் 18, ஆய்தம் 1, மற்றும் ட, ண, ர, ல, ழ, ள, ற, ன ஆகிய 8 உயிர்மெய் வரிசைகள்."}}}
{"id": "b-tam-6t1-184", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 56"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘டமாரம், ரம்பம், லண்டன், ஃப்ரான்ஸ், டென்மார்க்’ போன்ற சொற்கள் தமிழில் எவ்வாறு வகைப்படுத்தப்படுகின்றன?"}], "options": [{"key": "A", "text": "தூய தமிழ்ச் சொற்கள்"}, {"key": "B", "text": "திசைச்சொற்கள்"}, {"key": "C", "text": "தமிழில் ஒலிபெயர்த்து எழுதப்படும் பிறமொழிச் சொற்கள்"}, {"key": "D", "text": "வடமொழித் தற்சமச் சொற்கள்"}], "explanation": "ட, ர, ல, ஃ போன்றவை சொல்லின் முதலில் வராது. இவை தமிழில் ஒலிபெயர்த்து எழுதப்படும் பிறமொழிச் சொற்கள் ஆகும்."}}}
{"id": "extra-tam-6t1-185", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "other", "note": "நன்னூல் மொழிமுதல் எழுத்துகள் விதி"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "நன்னூலார் இலக்கண விதிப்படி தமிழ் மொழியில் சொல்லின் முதலில் வரும் மொத்த எழுத்துகளின் எண்ணிக்கை யாது?"}], "options": [{"key": "A", "text": "30 எழுத்துகள்"}, {"key": "B", "text": "102 எழுத்துகள்"}, {"key": "C", "text": "216 எழுத்துகள்"}, {"key": "D", "text": "247 எழுத்துகள்"}], "explanation": "உயிர் 12 + க, ச, த, ந, ப, ம (6x12=72) + வ (8) + ய (6) + ஞ (4) + ங (1) = மொத்தம் 102 எழுத்துகள் மொழிமுதல் வரும்."}}}

// ==============================================================================
// பாடம் 6: மொழியை ஆள்வோம், விழாக்கள் & கலைச்சொற்கள் [Q186 - Q190]
// ஆற்றுணா வேண்டுவது இல், தலைவர்கள் பிறந்தநாள் விழாக்கள், நூலகக் கலைச்சொற்கள்
// ==============================================================================
{"id": "b-tam-6t1-186", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 57"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘ஆற்றுணா வேண்டுவது இல்’ - என்று கல்வியின் மேன்மையை எடுத்துரைக்கும் பதினெண்கீழ்க்கணக்கு நூல் எது?"}], "options": [{"key": "A", "text": "நாலடியார்"}, {"key": "B", "text": "பழமொழி நானூறு"}, {"key": "C", "text": "நான்மணிக்கடிகை"}, {"key": "D", "text": "திரிகடுகம்"}], "explanation": "முன்றுறை அரையனார் இயற்றிய பழமொழி நானூறு பாடலில் (பாடல் 4) 'ஆற்றுணா வேண்டுவது இல்' (கற்றவனுக்குக் கட்டுச்சோறு வேண்டாம்) என்று வருகிறது."}}}
{"id": "b-tam-6t1-187", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "3", "B": "1", "C": "4", "D": "2"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 57"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தலைவர்களின் பிறந்தநாளுக்குரிய விழாக்களைச் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "தலைவர்", "items": [{"label": "A", "text": "காமராசர்"}, {"label": "B", "text": "டாக்டர் எஸ். இராதாகிருஷ்ணன்"}, {"label": "C", "text": "டாக்டர் ஏ.பி.ஜே. அப்துல் கலாம்"}, {"label": "D", "text": "சுவாமி விவேகானந்தர்"}]}, {"type": "list", "name": "விழா நாள்", "items": [{"label": "1", "text": "ஆசிரியர் நாள்"}, {"label": "2", "text": "தேசிய இளைஞர் நாள்"}, {"label": "3", "text": "கல்வி வளர்ச்சி நாள்"}, {"label": "4", "text": "மாணவர் நாள்"}]}], "options": [{"key": "A", "text": "A-3, B-1, C-4, D-2", "mapping": {"A": "3", "B": "1", "C": "4", "D": "2"}}, {"key": "B", "text": "A-1, B-3, C-2, D-4", "mapping": {"A": "1", "B": "3", "C": "2", "D": "4"}}, {"key": "C", "text": "A-3, B-4, C-1, D-2", "mapping": {"A": "3", "B": "4", "C": "1", "D": "2"}}, {"key": "D", "text": "A-4, B-1, C-3, D-2", "mapping": {"A": "4", "B": "1", "C": "3", "D": "2"}}], "explanation": "காமராசர் = கல்வி வளர்ச்சி நாள் (ஜூலை 15); இராதாகிருஷ்ணன் = ஆசிரியர் நாள் (செப் 5); கலாம் = மாணவர் நாள் (அக் 15); விவேகானந்தர் = தேசிய இளைஞர் நாள் (ஜன 12); நேரு = குழந்தைகள் நாள் (நவ 14)."}}}
{"id": "b-tam-6t1-188", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 58"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘ஆடை தைக்க உதவுவது ________; மூதுரை ஓர் ________’ - இருபொருள் தரும் சொல்லாக அமைவது எது?"}], "options": [{"key": "A", "text": "ஊசி"}, {"key": "B", "text": "நூல்"}, {"key": "C", "text": "ஆடை"}, {"key": "D", "text": "ஏடு"}], "explanation": "'நூல்' என்னும் சொல் தையல் நூலையும், அறிவு புகட்டும் புத்தகத்தையும் குறிக்கும் இருபொருள் சொல்லாகும்."}}}
{"id": "b-tam-6t1-189", "kind": "match", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "2", "B": "1", "C": "4", "D": "3"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 60"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"}, {"type": "list", "name": "ஆங்கிலக் கலைச்சொல்", "items": [{"label": "A", "text": "Education"}, {"label": "B", "text": "University"}, {"label": "C", "text": "Escalator"}, {"label": "D", "text": "Lift"}]}, {"type": "list", "name": "தமிழாக்கம்", "items": [{"label": "1", "text": "பல்கலைக்கழகம்"}, {"label": "2", "text": "கல்வி"}, {"label": "3", "text": "மின்தூக்கி"}, {"label": "4", "text": "நகரும் படிக்கட்டு"}]}], "options": [{"key": "A", "text": "A-2, B-1, C-4, D-3", "mapping": {"A": "2", "B": "1", "C": "4", "D": "3"}}, {"key": "B", "text": "A-1, B-2, C-3, D-4", "mapping": {"A": "1", "B": "2", "C": "3", "D": "4"}}, {"key": "C", "text": "A-2, B-1, C-3, D-4", "mapping": {"A": "2", "B": "1", "C": "3", "D": "4"}}, {"key": "D", "text": "A-4, B-3, C-2, D-1", "mapping": {"A": "4", "B": "3", "C": "2", "D": "1"}}], "explanation": "Education = கல்வி, University = பல்கலைக்கழகம், Escalator = நகரும் படிக்கட்டு, Lift = மின்தூக்கி."}}}
{"id": "b-tam-6t1-190", "kind": "match", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "3", "B": "1", "C": "4", "D": "2"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 60"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "நூலகக் கலைச்சொற்களைச் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "ஆங்கிலக் கலைச்சொல்", "items": [{"label": "A", "text": "Library"}, {"label": "B", "text": "E-Library"}, {"label": "C", "text": "E-Book"}, {"label": "D", "text": "E-Magazine"}]}, {"type": "list", "name": "தமிழாக்கம்", "items": [{"label": "1", "text": "மின்நூலகம்"}, {"label": "2", "text": "மின் இதழ்கள்"}, {"label": "3", "text": "நூலகம்"}, {"label": "4", "text": "மின்நூல்"}]}], "options": [{"key": "A", "text": "A-3, B-1, C-4, D-2", "mapping": {"A": "3", "B": "1", "C": "4", "D": "2"}}, {"key": "B", "text": "A-1, B-3, C-4, D-2", "mapping": {"A": "1", "B": "3", "C": "4", "D": "2"}}, {"key": "C", "text": "A-3, B-1, C-2, D-4", "mapping": {"A": "3", "B": "1", "C": "2", "D": "4"}}, {"key": "D", "text": "A-4, B-1, C-3, D-2", "mapping": {"A": "4", "B": "1", "C": "3", "D": "2"}}], "explanation": "Library = நூலகம், E-Library = மின்நூலகம், E-Book = மின்நூல், E-Magazine = மின் இதழ்கள்."}}}
