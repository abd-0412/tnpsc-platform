// ==============================================================================
// பாடம் 1: கல்வியைப் போற்று (நீதி வெண்பா - கா.ப. செய்குதம்பிப் பாவலர்) [Q132 - Q139]
// அருளைப் பெருக்கி, சொல்லும் பொருளும், சதாவதானி, இடலாக்குடி, சீறாப்புராண உரை
// ==============================================================================
{"id": "b-tam-6t1-132", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 42"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அருளைப் பெருக்கி அறிவைத் திருத்தி மருளை அகற்றி மதிக்கும் தெருளை அருத்துவதும்... கல்வியென்றே போற்று’ - இவ்வடிகளை இயற்றியவர் யார்?"}], "options": [{"key": "A", "text": "பட்டுக்கோட்டை கல்யாணசுந்தரம்"}, {"key": "B", "text": "கா.ப. செய்குதம்பிப் பாவலர்"}, {"key": "C", "text": "உமறுப்புலவர்"}, {"key": "D", "text": "பெருஞ்சித்திரனார்"}], "explanation": "இயல் 3 கவிதைப்பேழையான 'கல்வியைப் போற்று' என்னும் நீதி வெண்பாப் பாடலை இயற்றியவர் கா.ப. செய்குதம்பிப் பாவலர் ஆவார்."}}}
{"id": "b-tam-6t1-133", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "2", "B": "1", "C": "4", "D": "3"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 42"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கல்வியைப் போற்று’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "சொல்", "items": [{"label": "A", "text": "மருளை"}, {"label": "B", "text": "தெருளை"}, {"label": "C", "text": "அருத்துவதும்"}, {"label": "D", "text": "ஆவி"}]}, {"type": "list", "name": "பொருள்", "items": [{"label": "1", "text": "தெளிவை"}, {"label": "2", "text": "மயக்கத்தை"}, {"label": "3", "text": "உயிர்"}, {"label": "4", "text": "தருவதும்"}]}], "options": [{"key": "A", "text": "A-2, B-1, C-4, D-3", "mapping": {"A": "2", "B": "1", "C": "4", "D": "3"}}, {"key": "B", "text": "A-1, B-2, C-3, D-4", "mapping": {"A": "1", "B": "2", "C": "3", "D": "4"}}, {"key": "C", "text": "A-2, B-4, C-1, D-3", "mapping": {"A": "2", "B": "4", "C": "1", "D": "3"}}, {"key": "D", "text": "A-3, B-1, C-4, D-2", "mapping": {"A": "3", "B": "1", "C": "4", "D": "2"}}], "explanation": "மருளை = மயக்கத்தை, தெருளை = தெளிவை, அருத்துவதும் = தருவதும், ஆவி = உயிர், மதி = அறிவு, பொருத்துவதும் = சேர்ப்பதும்."}}}
{"id": "b-tam-6t1-134", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 42"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கா.ப. செய்குதம்பிப் பாவலர் கன்னியாகுமரி மாவட்டத்தில் எந்த ஊரைச் சேர்ந்தவர்?"}], "options": [{"key": "A", "text": "தேரூர்"}, {"key": "B", "text": "சுசீந்திரம்"}, {"key": "C", "text": "இடலாக்குடி"}, {"key": "D", "text": "நாகர்கோவில்"}], "explanation": "கா.ப. செய்குதம்பிப் பாவலர் கன்னியாகுமரி மாவட்டம் இடலாக்குடி என்னும் ஊரைச் சேர்ந்தவர்."}}}
{"id": "pyq-tam-6t1-135", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 58}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஒரே நேரத்தில் நிகழ்த்தப்படும் நூறு செயல்களையும் நினைவில் கொண்டு விடையளித்து ‘சதாவதானி’ என்று பாராட்டப்பெற்றவர் யார்?"}], "options": [{"key": "A", "text": "செய்கு அப்துல் காதிர்"}, {"key": "B", "text": "கா.ப. செய்குதம்பிப் பாவலர்"}, {"key": "C", "text": "உமறுப்புலவர்"}, {"key": "D", "text": "குணங்குடி மஸ்தான் சாகிபு"}], "explanation": "அறிஞர் பலர் முன்னிலையில் ஒரே நேரத்தில் 100 செயல்களைச் செய்து காட்டி 'சதாவதானி' என்ற பட்டம் பெற்றவர் செய்குதம்பிப் பாவலர்."}}}
{"id": "pyq-tam-6t1-136", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 67}, "texts": {"ta": {"blocks": [{"type": "text", "text": "இஸ்லாமியத் தமிழிலக்கியத்தின் முதன்மை நூலான ‘சீறாப்புராணத்திற்கு’ விரிவான உரை எழுதிய அறிஞர் யார்?"}], "options": [{"key": "A", "text": "காசி ஆனந்தன்"}, {"key": "B", "text": "அழகிய பெரியவன்"}, {"key": "C", "text": "கா.ப. செய்குதம்பிப் பாவலர்"}, {"key": "D", "text": "பட்டுக்கோட்டை கல்யாணசுந்தரம்"}], "explanation": "செய்குதம்பிப் பாவலர் சீறாப்புராணத்திற்கு அரும்பத உரையும் விளக்கவுரையும் எழுதியுள்ளார்."}}}
{"id": "b-tam-6t1-137", "kind": "statements", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 42"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கா.ப. செய்குதம்பிப் பாவலர் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "இவர் நபிகள் நாயக மான்மிய மஞ்சரி என்னும் நூலை இயற்றியுள்ளார்."}, {"type": "statement", "label": "II", "text": "திருமதினத்து அந்தாதி என்னும் நூலையும் இவர் படைத்துள்ளார்."}, {"type": "statement", "label": "III", "text": "பாடப்பகுதியில் இடம்பெற்றுள்ள ‘கல்வியைப் போற்று’ பாடல் நீதி வெண்பா என்னும் நூலில் இருந்து எடுக்கப்பட்டது."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "C", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "நூல் வெளி தகவலின்படி செய்குதம்பிப் பாவலர் நபிகள் நாயக மான்மிய மஞ்சரி, திருமதினத்து அந்தாதி, நீதி வெண்பா உரைகள் முதலியவற்றை இயற்றியுள்ளார்."}}}
{"id": "b-tam-6t1-138", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 43"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘மன்னனும் மாசறக் கற்றோனும் சீர்தூக்கின் மன்னனின் கற்றோன் சிறப்புடையன்’ - இவ்வடிகளை இயற்றிய சங்ககாலப் பெண்பாற்புலவர் யார்?"}], "options": [{"key": "A", "text": "காக்கைப்பாடினியார்"}, {"key": "B", "text": "ஔவையார்"}, {"key": "C", "text": "வெள்ளிவீதியார்"}, {"key": "D", "text": "நச்செள்ளையார்"}], "explanation": "இயல் 3 கற்பவை கற்றபின் பகுதியில் இடம்பெற்றுள்ள 'மன்னனின் கற்றோன் சிறப்புடையன்' என்ற மூதுரைப் பாடலை இயற்றியவர் ஔவையார்."}}}
{"id": "b-tam-6t1-139", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 43"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அருளை - மருளை’, ‘அருத்துவதும் - பொருத்துவதும்’ ஆகிய சொற்களில் அமைந்துள்ள தொடை நயம் யாது?"}], "options": [{"key": "A", "text": "மோனைத்தொடை"}, {"key": "B", "text": "எதுகைத்தொடை"}, {"key": "C", "text": "இயைபுத்தொடை"}, {"key": "D", "text": "முரண்டொடை"}], "explanation": "முதலெழுத்து அளவொத்திருக்க, இரண்டாம் எழுத்து ஒன்றி வருவது எதுகைத்தொடை ஆகும் ('ரு' ஒன்றி வந்துள்ளது)."}}}

// ==============================================================================
// பாடம் 2: துன்பத்தை வெல்லும் கல்வி (பட்டுக்கோட்டை கல்யாணசுந்தரம்) [Q140 - Q149]
// ஏட்டில் படித்ததோடு, மக்கள் கவிஞர், தூற்றும்படி, செங்கப்படுத்தான்காடு, புணர்ச்சி
// ==============================================================================
{"id": "b-tam-6t1-140", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 44"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘ஏட்டில் படித்ததோடு இருந்துவிடாதே - நீ ஏன் படித்தோம் என்பதையும் மறந்துவிடாதே’ - என்று பாடிய மக்கள் கவிஞர் யார்?"}], "options": [{"key": "A", "text": "பாரதிதாசன்"}, {"key": "B", "text": "பட்டுக்கோட்டை கல்யாணசுந்தரம்"}, {"key": "C", "text": "உடுமலை நாராயணகவி"}, {"key": "D", "text": "மருதகாசி"}], "explanation": "துன்பத்தை வெல்லும் கல்வி என்னும் பாடலைப் பாடியவர் பட்டுக்கோட்டை கல்யாணசுந்தரம் ஆவார்."}}}
{"id": "b-tam-6t1-141", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 44"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘துன்பத்தை வெல்லும் கல்வி’ பாடலின் சொல்லும் பொருளில் ‘தூற்றும்படி’ மற்றும் ‘மாற்றார்’ என்பதன் பொருள் யாது?"}], "options": [{"key": "A", "text": "புகழும்படி, சுற்றத்தார்"}, {"key": "B", "text": "இகழும்படி, மற்றவர்"}, {"key": "C", "text": "பார்க்கும்படி, நண்பர்"}, {"key": "D", "text": "வியக்கும்படி, பகைவர்"}], "explanation": "தூற்றும்படி = இகழும்படி; மாற்றார் = மற்றவர்; மூத்தோர் = பெரியோர்; மேதைகள் = அறிஞர்கள்; வற்றாமல் = குறையாமல்."}}}
{"id": "pyq-tam-6t1-142", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2018, "paper": "tamil", "no": 35}, "texts": {"ta": {"blocks": [{"type": "text", "text": "எளிய தமிழில் சமூகச் சீர்திருத்தக் கருத்துகளை வலியுறுத்திப் பாடிய காரணத்தால் ‘மக்கள் கவிஞர்’ என அழைக்கப்படுபவர் யார்?"}], "options": [{"key": "A", "text": "நாமக்கல் கவிஞர்"}, {"key": "B", "text": "பாரதிதாசன்"}, {"key": "C", "text": "பட்டுக்கோட்டை கல்யாணசுந்தரம்"}, {"key": "D", "text": "கண்ணதாசன்"}], "explanation": "திரையிசைப் பாடல்களில் உழைப்பாளிகளின் உயர்வை எளிய தமிழில் போற்றிப் பாடிய பட்டுக்கோட்டை கல்யாணசுந்தரம் 'மக்கள் கவிஞர்' எனப்படுகிறார்."}}}
{"id": "b-tam-6t1-143", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 44"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பட்டுக்கோட்டை கல்யாணசுந்தரத்தின் கவிதை வரிகளின்படி நாம் யாரிடம் சேரக்கூடாது?"}], "options": [{"key": "A", "text": "படிப்பறிவு இல்லாதவரிடம்"}, {"key": "B", "text": "தன்மானமில்லாக் கோழையுடன்"}, {"key": "C", "text": "வறுமையில் வாடுபவரிடம்"}, {"key": "D", "text": "முதியவர்களிடம்"}], "explanation": "'மாற்றார் கைப்பொருளை நம்பி வாழக்கூடாது - தன் மானமில்லாக் கோழையுடன் சேரக்கூடாது' என்று கவிஞர் கூறுகிறார்."}}}
{"id": "b-tam-6t1-144", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 45"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘ஏட்டில் - ஏன்படித்தோம்’, ‘நாட்டின் - நல்லவர்’ ஆகிய சொற்களில் அமைந்துள்ள நயம் யாது?"}], "options": [{"key": "A", "text": "மோனைத்தொடை"}, {"key": "B", "text": "எதுகைத்தொடை"}, {"key": "C", "text": "இயைபுத்தொடை"}, {"key": "D", "text": "முரண்டொடை"}], "explanation": "முதல் எழுத்து ஒன்றி வருவது மோனைத்தொடை ஆகும். (மோனைத்தொடையில் குறில் நெடில் மாறியும் வரலாம்)."}}}
{"id": "b-tam-6t1-145", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 45"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘இருந்துவிடாதே - மறந்துவிடாதே’, ‘வாழக்கூடாது - சேரக்கூடாது’ ஆகிய சொற்களில் அமைந்துள்ள நயம் யாது?"}], "options": [{"key": "A", "text": "மோனைத்தொடை"}, {"key": "B", "text": "எதுகைத்தொடை"}, {"key": "C", "text": "இயைபுத்தொடை"}, {"key": "D", "text": "அளபெடை"}], "explanation": "அடிகளின் அல்லது சீர்களின் இறுதியில் ஒரே ஓசையில் அல்லது சொல்லில் முடிவது இயைபுத்தொடை ஆகும்."}}}
{"id": "b-tam-6t1-146", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 46"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கைப்பொருள்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}], "options": [{"key": "A", "text": "கையில் + பொருள்"}, {"key": "B", "text": "கைப் + பொருள்"}, {"key": "C", "text": "கை + பொருள்"}, {"key": "D", "text": "கைப்பு + பொருள்"}], "explanation": "கை + பொருள் = இயல்பினும் விதியினும் நின்ற உயிர்முன் க ச த ப மிகும் விதிப்படி 'ப்' மிகுந்து கைப்பொருள் என்றாகும்."}}}
{"id": "b-tam-6t1-147", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 46"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘மானம் + இல்லா’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}], "options": [{"key": "A", "text": "மானம் இல்லா"}, {"key": "B", "text": "மானமில்லா"}, {"key": "C", "text": "மானமல்லா"}, {"key": "D", "text": "மானம்மில்லா"}], "explanation": "உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி ம் + இ = மி ஆகி, 'மானமில்லா' எனப் புணரும்."}}}
{"id": "extra-tam-6t1-148", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "other", "note": "பட்டுக்கோட்டையார் ஊர் குறிப்பு"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "மக்கள் கவிஞர் பட்டுக்கோட்டை கல்யாணசுந்தரம் பிறந்த ஊர் எது?"}], "options": [{"key": "A", "text": "இடலாக்குடி"}, {"key": "B", "text": "எட்டயபுரம்"}, {"key": "C", "text": "செங்கப்படுத்தான்காடு"}, {"key": "D", "text": "மோகனூர்"}], "explanation": "பட்டுக்கோட்டை கல்யாணசுந்தரம் தஞ்சாவூர் மாவட்டம் பட்டுக்கோட்டை அருகிலுள்ள செங்கப்படுத்தான்காடு என்னும் ஊரில் பிறந்தார்."}}}
{"id": "b-tam-6t1-149", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 46"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘மாணவர் பிறர் ________ நடக்கக் கூடாது; நாம் ________ சொல்படி நடக்க வேண்டும்’ - மதிப்பீட்டின் சரியான இணை எது?"}], "options": [{"key": "A", "text": "போற்றும்படி, இளையோர்"}, {"key": "B", "text": "தூற்றும்படி, மூத்தோர்"}, {"key": "C", "text": "பார்க்கும்படி, ஊரார்"}, {"key": "D", "text": "வியக்கும்படி, நண்பர்"}], "explanation": "பாடநூல் மதிப்பீட்டு வினா: மாணவர் பிறர் தூற்றும்படி (இகழும்படி) நடக்கக் கூடாது; பெரியோர்களான மூத்தோர் சொல்படி நடக்க வேண்டும்."}}}

