{"id": "b-tam-6t2-049", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 17"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கிடைக்கும் பொருள்களின் மதிப்பைக்கூட்டிப் புதிய பொருளாக மாற்றுவதற்கு வணிகத்தில் என்ன பெயர்?"}], "options": [{"key": "A", "text": "இணைய வணிகம்"}, {"key": "B", "text": "மதிப்புக் கூட்டுதல்"}, {"key": "C", "text": "பண்டமாற்று"}, {"key": "D", "text": "மொத்தக் கொள்முதல்"}], "explanation": "கல் என்பதைச் சிலையாகவும், கல் தூளைக் கோலமாவாகவும் மாற்றுவது போல மதிப்புக்கூட்டிப் புதிய பொருளாக்குவது 'மதிப்புக் கூட்டுதல்' எனப்படும்."}}}
{"id": "b-tam-6t2-050", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 18"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அவள் ஊருக்குச் ________’ - சரியான வினைமுற்றைத் தேர்வு செய்க:"}], "options": [{"key": "A", "text": "சென்றேன்"}, {"key": "B", "text": "சென்றாய்"}, {"key": "C", "text": "சென்றாள்"}, {"key": "D", "text": "சென்றார்"}], "explanation": "அவள் என்பது படர்க்கைப் பெண்பால் பெயர்ச்சொல்; எனவே 'சென்றாள்' என்ற வினைமுற்றே பொருந்தும்."}}}
{"id": "b-tam-6t2-051", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 19"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பல் + ல் + உண்டு’ மற்றும் ‘பல் + ல் + இல்லை’ ஆகியவை புணர்ந்து உருவாகும் புதிய சொற்கள் எவை?"}], "options": [{"key": "A", "text": "பல்லுண்டு, பல்லில்லை"}, {"key": "B", "text": "பலுண்டு, பலில்லை"}, {"key": "C", "text": "பல்லு உண்டு, பல்லு இல்லை"}, {"key": "D", "text": "பல்உண்டு, பல்இல்லை"}], "explanation": "தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும் விதிப்படி பல்லுண்டு, பல்லில்லை எனப் புணரும்."}}}
{"id": "b-tam-6t2-052", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": true, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 19"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பாடநூல் கட்டங்களில் மறைந்துள்ள சுற்றுலாத் தலங்களுள் பொருந்தாத ஒன்று எது?"}], "options": [{"key": "A", "text": "தஞ்சாவூர்"}, {"key": "B", "text": "கல்லணை"}, {"key": "C", "text": "மதுரை"}, {"key": "D", "text": "கொடைக்கானல்"}], "explanation": "பக்கம் 19 கட்டங்களில் தஞ்சாவூர், கல்லணை, குற்றாலம், சுருளி, மதுரை, மாமல்லபுரம் உள்ளன; கொடைக்கானல் இல்லை."}}}
{"id": "b-tam-6t2-053", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 20"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘நான் சென்றேன்’ என்ற தொடரை அடைப்புக்குறிச் சொற்களைக் கொண்டு (ஊருக்கு, நேற்று, பேருந்தில்) நீட்டித்து எழுதப்படும் சரியான வடிவம் எது?"}], "options": [{"key": "A", "text": "நான் நேற்று பேருந்தில் ஊருக்குச் சென்றேன்"}, {"key": "B", "text": "ஊருக்கு நேற்று பேருந்தில் சென்றேன்"}, {"key": "C", "text": "நான் சென்றேன் ஊருக்கு பேருந்தில் நேற்று"}, {"key": "D", "text": "பேருந்தில் நான் சென்றேன் நேற்று"}], "explanation": "நான் நேற்று பேருந்தில் ஊருக்குச் சென்றேன் என்பது சரியான வாக்கிய அமைப்பாகும்."}}}
{"id": "b-tam-6t2-054", "kind": "match", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "2", "B": "1", "C": "4", "D": "3"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 20"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஆங்கிலக் கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"}, {"type": "list", "name": "ஆங்கிலக் கலைச்சொல்", "items": [{"label": "A", "text": "Harvest"}, {"label": "B", "text": "Gratitude"}, {"label": "C", "text": "Cradle"}, {"label": "D", "text": "Palace"}]}, {"type": "list", "name": "தமிழாக்கம்", "items": [{"label": "1", "text": "நன்றியுணர்வு"}, {"label": "2", "text": "அறுவடை"}, {"label": "3", "text": "அரண்மனை"}, {"label": "4", "text": "தொட்டில்"}]}], "options": [{"key": "A", "text": "A-2, B-1, C-4, D-3", "mapping": {"A": "2", "B": "1", "C": "4", "D": "3"}}, {"key": "B", "text": "A-1, B-2, C-3, D-4", "mapping": {"A": "1", "B": "2", "C": "3", "D": "4"}}, {"key": "C", "text": "A-2, B-4, C-1, D-3", "mapping": {"A": "2", "B": "4", "C": "1", "D": "3"}}, {"key": "D", "text": "A-4, B-1, C-2, D-3", "mapping": {"A": "4", "B": "1", "C": "2", "D": "3"}}], "explanation": "Harvest = அறுவடை; Gratitude = நன்றியுணர்வு; Cradle = தொட்டில்; Palace = அரண்மனை; Locality = வட்டாரம்; Mountain Top = மலையுச்சி."}}}
{"id": "b-tam-6t2-055", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 20"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘Locality’ மற்றும் ‘Mountain Top’ ஆகிய ஆங்கிலச் சொற்களுக்கு இணையான தமிழ்ச் சொற்கள் முறையே எவை?"}], "options": [{"key": "A", "text": "அரண்மனை, மலையடிவாரம்"}, {"key": "B", "text": "வட்டாரம், மலையுச்சி"}, {"key": "C", "text": "மாவட்டம், மலைக்குன்று"}, {"key": "D", "text": "நகரம், முகடு"}], "explanation": "Locality = வட்டாரம்; Mountain Top = மலையுச்சி."}}}
{"id": "b-tam-6t2-056", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 15"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கீழ்க்காணும் மெய்யெழுத்துகளில் மொழி இறுதியில் வரக்கூடிய மெய் எது?"}], "options": [{"key": "A", "text": "க்"}, {"key": "B", "text": "த்"}, {"key": "C", "text": "ஞ்"}, {"key": "D", "text": "ற்"}], "explanation": "க், த், ற் ஆகியவை மொழி இறுதியில் வராத 7 மெய்களுள் அடங்கும்; 'ஞ்' என்பது மொழி இறுதியில் வரும் 11 மெய்களுள் ஒன்றாகும் (எ.கா: உரிஞ்)."}}}
