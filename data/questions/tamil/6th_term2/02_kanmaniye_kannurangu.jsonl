{"id": "b-tam-6t2-009", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": true, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கண்மணியே கண்ணுறங்கு தாலாட்டுப் பாடலில் இடம்பெற்றுள்ள சொற்பொருள்களுள் தவறான இணையைத் தேர்வு செய்க:"}], "options": [{"key": "A", "text": "நந்தவனம் - பூஞ்சோலை"}, {"key": "B", "text": "பண் - இசை"}, {"key": "C", "text": "பார் - உலகம்"}, {"key": "D", "text": "இழைத்து - இழந்து"}], "explanation": "'இழைத்து' என்பதன் பொருள் 'பதித்து' (தங்கத்தில் பூ பதித்து) என்பதாகும்; இழந்து என்பது தவறு."}}}
{"id": "b-tam-6t2-010", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தாலாட்டுப் பாடலில் இடம்பெற்றுள்ள ‘முத்தேன்’ என்னும் தொகைச்சொல்லின் சரியான விளக்கம் எது?"}], "options": [{"key": "A", "text": "கொம்புத்தேன், மலைத்தேன், கொசுத்தேன்"}, {"key": "B", "text": "மரத்தேன், மனைத்தேன், மலர்த்தேன்"}, {"key": "C", "text": "பாறைத்தேன், காட்டுத்தேன், பூத்தேன்"}, {"key": "D", "text": "செந்தேன், கொம்புத்தேன், மலைத்தேன்"}], "explanation": "முத்தேன் என்பது கொம்புத்தேன், மலைத்தேன், கொசுத்தேன் ஆகியவற்றைக் குறிக்கும்."}}}
{"id": "b-tam-6t2-011", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "3", "B": "1", "C": "2"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கண்மணியே கண்ணுறங்கு பாடலில் குழந்தையை மூவேந்தர் நாட்டுச் சிறப்புகளோடு தாய் ஒப்பிடுவதைச் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "நாடு", "items": [{"label": "A", "text": "சேர நாடு"}, {"label": "B", "text": "சோழ நாடு"}, {"label": "C", "text": "பாண்டி நாடு"}]}, {"type": "list", "name": "சிறப்பு", "items": [{"label": "1", "text": "முக்கனி (சுவையான விருந்து)"}, {"label": "2", "text": "முத்தமிழ் (குளம் வெட்டி, அணை கட்டிப் பசி போக்கல்)"}, {"label": "3", "text": "முத்தேன் (தந்தத் தொட்டில், தங்கப் பூ)"}]}], "options": [{"key": "A", "text": "A-3, B-1, C-2", "mapping": {"A": "3", "B": "1", "C": "2"}}, {"key": "B", "text": "A-1, B-2, C-3", "mapping": {"A": "1", "B": "2", "C": "3"}}, {"key": "C", "text": "A-2, B-3, C-1", "mapping": {"A": "2", "B": "3", "C": "1"}}, {"key": "D", "text": "A-3, B-2, C-1", "mapping": {"A": "3", "B": "2", "C": "1"}}], "explanation": "சேர நாட்டு முத்தேன், சோழ நாட்டு முக்கனி, பாண்டி நாட்டு முத்தமிழ் எனத் தாய் பாராட்டுகிறாள்."}}}
{"id": "b-tam-6t2-012", "kind": "statements", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 5"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தாலாட்டுப் பாடல் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "தாலாட்டு வாய்மொழி இலக்கியங்களுள் ஒன்றாகும்."}, {"type": "statement", "label": "II", "text": "'தால்' என்பதற்கு 'நாக்கு' என்று பொருள்."}, {"type": "statement", "label": "III", "text": "நாக்கை அசைத்துப் பாடுவதால் தாலாட்டு (தால் + ஆட்டு) என்று பெயர்பெற்றது."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "C", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "கொடுக்கப்பட்டுள்ள மூன்று கூற்றுகளும் சரியானவை. தால் = நாக்கு; நாக்கை அசைத்துப் பாடுவதால் தாலாட்டு எனப்படும்."}}}
{"id": "b-tam-6t2-013", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 5"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘வாழை + இலை’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}], "options": [{"key": "A", "text": "வாழையிலை"}, {"key": "B", "text": "வாழைஇலை"}, {"key": "C", "text": "வாழைலை"}, {"key": "D", "text": "வாழிலை"}], "explanation": "வாழை + இலை = வாழையிலை ('இ ஈ ஐ வழி யவ்வும்' விதிப்படி உடம்படுமெய் 'ய்' தோன்றி வாழையிலை எனப் புணரும்)."}}}
{"id": "b-tam-6t2-014", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 5"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘உதித்த’ என்ற சொல்லிற்குரிய எதிர்ச்சொல் யாது?"}], "options": [{"key": "A", "text": "மறைந்த"}, {"key": "B", "text": "நிறைந்த"}, {"key": "C", "text": "குறைந்த"}, {"key": "D", "text": "தோன்றிய"}], "explanation": "உதித்த என்றால் தோன்றிய என்று பொருள்; எனவே அதன் எதிர்ச்சொல் 'மறைந்த' ஆகும்."}}}
{"id": "b-tam-6t2-015", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘நந்தவனம் கண் திறந்து நற்றமிழ்ப் பூ எடுத்து...’ - இவ்வடியில் பயின்று வந்துள்ள மோனைச் சொற்கள் எவை?"}], "options": [{"key": "A", "text": "நந்தவனம் - நற்றமிழ்"}, {"key": "B", "text": "கண் - திறந்து"}, {"key": "C", "text": "பூ - எடுத்து"}, {"key": "D", "text": "நந்தவனம் - எடுத்து"}], "explanation": "சீர்களின் முதல் எழுத்து 'ந' ஒன்றி வருவதால் நந்தவனம் - நற்றமிழ் என்பது மோனை நயம் ஆகும்."}}}
{"id": "b-tam-6t2-016", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "வாழை இலை பரப்பி வந்தாரை இன்முகத்தோடு உபசரித்து அறுசுவை விருந்து வைக்கும் நாடாகத் தாலாட்டுப் பாடல் எதனைக் கூறுகிறது?"}], "options": [{"key": "A", "text": "சேர நாடு"}, {"key": "B", "text": "சோழ நாடு"}, {"key": "C", "text": "பாண்டிய நாடு"}, {"key": "D", "text": "பல்லவ நாடு"}], "explanation": "'வாழை இலை பரப்பி வந்தாரைக் கை அமர்த்திச் சுவையான விருந்து வைக்கும் சோழநாட்டு முக்கனியோ!' என சோழ நாட்டைக் குறிப்பிடுகிறது."}}}
