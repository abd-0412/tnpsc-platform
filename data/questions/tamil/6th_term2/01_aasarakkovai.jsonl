{"id": "b-tam-6t2-001", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 2"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஆசாரக்கோவை பாடலில் இடம்பெற்றுள்ள ‘ஒப்புரவு’ என்னும் சொல்லின் பொருள் யாது?"}], "options": [{"key": "A", "text": "பிறர் செய்த உதவியை மறவாமை"}, {"key": "B", "text": "எல்லோரையும் சமமாகப் பேணுதல்"}, {"key": "C", "text": "நற்பண்புடையவரோடு நட்புக் கொள்ளுதல்"}, {"key": "D", "text": "பிறர் செய்யும் தீமைகளைப் பொறுத்துக் கொள்ளுதல்"}], "explanation": "ஆசாரக்கோவை சொல்லும் பொருளும் பகுதியில் 'ஒப்புரவு' என்பது 'எல்லோரையும் சமமாகப் பேணுதல்' எனக் குறிப்பிடப்பட்டுள்ளது."}}}
{"id": "b-tam-6t2-002", "kind": "statements", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": false}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 2"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஆசாரக்கோவை குறிப்பிடும் நல்லொழுக்க விதைகள் தொடர்பான பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "பிறர் செய்த உதவியை மறவாதிருத்தல் மற்றும் பிறர் செய்யும் தீமைகளைப் பொறுத்துக் கொள்ளுதல் நல்லொழுக்க வித்துகள் ஆகும்."}, {"type": "statement", "label": "II", "text": "இனிய சொற்களைப் பேசுதல் மற்றும் எவ்வுயிர்க்கும் துன்பம் செய்யாதிருத்தல் நல்லொழுக்க வித்துகள் ஆகும்."}, {"type": "statement", "label": "III", "text": "ஆசாரக்கோவை மொத்தம் பத்து நல்லொழுக்க விதைகளைக் குறிப்பிடுகிறது."}], "options": [{"key": "A", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "B", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "C", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "கூற்றுகள் I மற்றும் II சரி. ஆசாரக்கோவை நல்லொழுக்கத்தின் விதைகளாக மொத்தம் எட்டு நற்பண்புகளைக் குறிப்பிடுகிறது (இவையெட்டும் சொல்லிய ஆசார வித்து); பத்து அல்ல."}}}
{"id": "b-tam-6t2-003", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "3", "B": "1", "C": "4", "D": "2"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 2"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஆசாரக்கோவை நூலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "சொல்", "items": [{"label": "A", "text": "நன்றியறிதல்"}, {"label": "B", "text": "ஒப்புரவு"}, {"label": "C", "text": "நட்டல்"}, {"label": "D", "text": "பொறை"}]}, {"type": "list", "name": "பொருள்", "items": [{"label": "1", "text": "எல்லோரையும் சமமாகப் பேணுதல்"}, {"label": "2", "text": "பொறுமை"}, {"label": "3", "text": "பிறர் செய்த உதவியை மறவாமை"}, {"label": "4", "text": "நட்புக் கொள்ளுதல்"}]}], "options": [{"key": "A", "text": "A-3, B-1, C-4, D-2", "mapping": {"A": "3", "B": "1", "C": "4", "D": "2"}}, {"key": "B", "text": "A-1, B-3, C-2, D-4", "mapping": {"A": "1", "B": "3", "C": "2", "D": "4"}}, {"key": "C", "text": "A-3, B-4, C-1, D-2", "mapping": {"A": "3", "B": "4", "C": "1", "D": "2"}}, {"key": "D", "text": "A-4, B-1, C-2, D-3", "mapping": {"A": "4", "B": "1", "C": "2", "D": "3"}}], "explanation": "நன்றியறிதல் = பிறர் செய்த உதவியை மறவாமை; ஒப்புரவு = எல்லோரையும் சமமாகப் பேணுதல்; நட்டல் = நட்புக் கொள்ளுதல்; பொறை = பொறுமை."}}}
{"id": "b-tam-6t2-004", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 2"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஆசாரக்கோவையின் ஆசிரியர் பெருவாயின் முள்ளியார் பிறந்த ஊர் எது?"}], "options": [{"key": "A", "text": "வண்கயத்தூர்"}, {"key": "B", "text": "இடலாக்குடி"}, {"key": "C", "text": "செங்கப்படுத்தான்காடு"}, {"key": "D", "text": "மோகனூர்"}], "explanation": "ஆசாரக்கோவையின் ஆசிரியர் பெருவாயின் முள்ளியார் பிறந்த ஊர் வண்கயத்தூர் ஆகும்."}}}
{"id": "b-tam-6t2-005", "kind": "statements", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 2"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஆசாரக்கோவை நூல் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "ஆசாரக்கோவை என்பதற்கு 'நல்ல ஒழுக்கங்களின் தொகுப்பு' என்பது பொருள்."}, {"type": "statement", "label": "II", "text": "இந்நூல் பதினெண்கீழ்க்கணக்கு நூல்களுள் ஒன்றாகும்."}, {"type": "statement", "label": "III", "text": "இந்நூல் நூறு வெண்பாக்களைக் கொண்டது."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "C", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "மூன்று கூற்றுகளும் சரியானவை. ஆசாரக்கோவை = நல்ல ஒழுக்கங்களின் தொகுப்பு; பதினெண்கீழ்க்கணக்கு நூல்; 100 வெண்பாக்களை உடையது."}}}
{"id": "b-tam-6t2-006", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 2"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘நன்றியறிதல் பொறையுடைமை இன்சொல்லோடு... நல்லினத் தாரோடு நட்டல் - இவையெட்டும்...’ - இவ்வடிகளில் அமைந்துள்ள தொடை நயம் யாது?"}], "options": [{"key": "A", "text": "மோனைத்தொடை"}, {"key": "B", "text": "எதுகைத்தொடை"}, {"key": "C", "text": "இயைபுத்தொடை"}, {"key": "D", "text": "முரண்டொடை"}], "explanation": "அடிகளின் முதலெழுத்து அளவொத்து நிற்க, இரண்டாம் எழுத்து 'ன் / ல்' ஒன்றி அமைவதால் இது எதுகைத்தொடை ஆகும்."}}}
{"id": "b-tam-6t2-007", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "D", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 3"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பொறையுடைமை’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}], "options": [{"key": "A", "text": "பொறுமை + உடைமை"}, {"key": "B", "text": "பொறை + யுடைமை"}, {"key": "C", "text": "பொறு + யுடைமை"}, {"key": "D", "text": "பொறை + உடைமை"}], "explanation": "பொறை + உடைமை = பொறையுடைமை ('இ ஈ ஐ வழி யவ்வும்' விதிப்படி உடம்படுமெய் ய் தோன்றிப் புணர்ந்தது)."}}}
{"id": "b-tam-6t2-008", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 3"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘இவை + எட்டும்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}], "options": [{"key": "A", "text": "இவை எட்டும்"}, {"key": "B", "text": "இவையெட்டும்"}, {"key": "C", "text": "இவ்வெட்டும்"}, {"key": "D", "text": "இவ்எட்டும்"}], "explanation": "இவை + எட்டும் = இவையெட்டும் (உடம்படுமெய் 'ய்' தோன்றி புணர்ந்தது)."}}}
