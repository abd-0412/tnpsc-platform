// ==============================================================================
// பாடம் 1: ஏதிலிக்குருவிகள் (கவிதைப்பேழை - அழகிய பெரியவன்) [Q055 - Q062]
// தூக்கணாங்குருவி, புல் வீடுகள், அழகிய பெரியவன் இயற்பெயர், தகப்பன் கொடி, புணர்ச்சி
// ==============================================================================
{"id": "b-tam-6t1-055", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 20"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘போகும் வழியெல்லாம் தூக்கணாங்குருவிக் கூடுகள் காற்றில் ஆடும் புல் வீடுகள்’ - என்று பாடிய கவிஞர் யார்?"}], "options": [{"key": "A", "text": "பாரதிதாசன்"}, {"key": "B", "text": "அழகிய பெரியவன்"}, {"key": "C", "text": "கா.ப. செய்குதம்பிப் பாவலர்"}, {"key": "D", "text": "பட்டுக்கோட்டை கல்யாணசுந்தரம்"}], "explanation": "இயல் 2 கவிதைப்பேழையான 'ஏதிலிக்குருவிகள்' என்னும் சுற்றுச்சூழல் கவிதையைப் பாடியவர் அழகிய பெரியவன் ஆவார்."}}}
{"id": "b-tam-6t1-056", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 20"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘ஏதிலி’ மற்றும் ‘மறுகியது’ ஆகிய சொற்களின் சரியான பொருள்கள் முறையே எவை?"}], "options": [{"key": "A", "text": "உறவினர், மகிழ்ந்தது"}, {"key": "B", "text": "அகதி, வருந்தியது"}, {"key": "C", "text": "பறவை, பறந்தது"}, {"key": "D", "text": "விருந்தாளி, வாடியது"}], "explanation": "பாடப்பகுதி சொல்லும் பொருளும் குறிப்பின்படி ஏதிலி என்றால் 'அகதி' என்றும், மறுகியது என்றால் 'வருந்தியது' என்றும் பொருள்படும்."}}}
{"id": "b-tam-6t1-057", "kind": "assertion_reason", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "assertion_reason", "a_true": true, "r_true": true, "r_explains_a": true}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 20"}, "texts": {"ta": {"blocks": [{"type": "assertion", "text": "கவிஞர் அழகிய பெரியவன் தூக்கணாங்குருவியின் கூடுகளைக் 'காற்றிலாடும் புல் வீடுகள்' எனக் குறிப்பிடுகிறார்."}, {"type": "reason", "text": "தூக்கணாங்குருவிகள் காய்ந்த புற்களை நுட்பமாக நெய்து காற்றில் அசையும் வகையில் அழகான கூடுகளைக் கட்டுகின்றன."}], "options": [{"key": "A", "text": "(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்", "semantic": "both_true_explains"}, {"key": "B", "text": "(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல", "semantic": "both_true_not_explains"}, {"key": "C", "text": "(A) சரி ஆனால் (R) தவறு", "semantic": "a_true_r_false"}, {"key": "D", "text": "(A) தவறு ஆனால் (R) சரி", "semantic": "a_false_r_true"}], "explanation": "தூக்கணாங்குருவியின் கூடுகள் புற்களினால் ஆன தொங்கும் அமைப்பைக் கொண்டிருப்பதால் அதனைப் புல் வீடுகள் என்றார்."}}}
{"id": "b-tam-6t1-058", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 21"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "அழகிய பெரியவன் அவர்களின் இயற்பெயர் யாது?"}], "options": [{"key": "A", "text": "சுப்புரத்தினம்"}, {"key": "B", "text": "மாணிக்கம்"}, {"key": "C", "text": "அரவிந்தன்"}, {"key": "D", "text": "துரைராசு"}], "explanation": "ஏதிலிக்குருவிகள் கவிதையை எழுதிய அழகிய பெரியவனின் இயற்பெயர் அரவிந்தன் ஆகும்."}}}
{"id": "pyq-tam-6t1-059", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 52}, "texts": {"ta": {"blocks": [{"type": "text", "text": "அழகிய பெரியவன் எந்தப் புதினத்திற்காக 2003-ஆம் ஆண்டில் தமிழ்நாடு அரசின் விருது பெற்றார்?"}], "options": [{"key": "A", "text": "குறடு"}, {"key": "B", "text": "தகப்பன் கொடி"}, {"key": "C", "text": "நெரிக்கட்டு"}, {"key": "D", "text": "அரூப நஞ்சு"}], "explanation": "அழகிய பெரியவன் 'தகப்பன் கொடி' என்னும் புதினத்திற்காக 2003-ஆம் ஆண்டில் தமிழ்நாடு அரசின் விருது பெற்றார்."}}}
{"id": "b-tam-6t1-060", "kind": "statements", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 21"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "அழகிய பெரியவன் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "இவர் புதினம், சிறுகதை, கவிதை, கட்டுரை போன்ற படைப்புத் தளங்களில் இயங்கி வருபவர்."}, {"type": "statement", "label": "II", "text": "குறடு, நெரிக்கட்டு ஆகியவை இவரது சிறுகதைத் தொகுப்புகள் ஆகும்."}, {"type": "statement", "label": "III", "text": "அரூப நஞ்சு, பெருகும் வேட்கை உள்ளிட்ட கவிதை நூல்களையும் இவர் எழுதியுள்ளார்."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "C", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "நூல் வெளி குறிப்பின்படி அழகிய பெரியவன் இயற்றிய நூல்கள்: குறடு, நெரிக்கட்டு, அரூப நஞ்சு, பெருகும் வேட்கை, தகப்பன் கொடி."}}}
{"id": "b-tam-6t1-061", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 21"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘முன்பென்றால்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}], "options": [{"key": "A", "text": "முன் + பென்றால்"}, {"key": "B", "text": "முன்பு + அன்றால்"}, {"key": "C", "text": "முன்பு + என்றால்"}, {"key": "D", "text": "முன் + என்றால்"}], "explanation": "முன்பு + என்றால் = முன்பென்றால் (உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'பு' இல் உள்ள 'உ' கெட்டு, ப் + ஏ = பே எனப் புணரும்)."}}}
{"id": "b-tam-6t1-062", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 21"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘சுழித்தோடும்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}], "options": [{"key": "A", "text": "சுழித்து + ஓடும்"}, {"key": "B", "text": "சுழி + தோடும்"}, {"key": "C", "text": "சுழி + ஓடும்"}, {"key": "D", "text": "சுழித் + தோடும்"}], "explanation": "சுழித்து + ஓடும் = சுழித்தோடும்."}}}

