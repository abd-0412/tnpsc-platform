{"id": "b-tam-6t1-087", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 33"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "எழுத்துகள் எத்தனை வகைப்படும்?"}], "options": [{"key": "A", "text": "ஒரு வகை"}, {"key": "B", "text": "இரண்டு வகை (முதல் எழுத்துகள், சார்பு எழுத்துகள்)"}, {"key": "C", "text": "மூன்று வகை"}, {"key": "D", "text": "ஐந்து வகை"}], "explanation": "எழுத்துகள் முதல் எழுத்துகள், சார்பு எழுத்துகள் என இரண்டு வகைப்படும்."}}}
{"id": "pyq-tam-6t1-088", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 15}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பிற எழுத்துகள் தோன்றுவதற்கும் இயங்குவதற்கும் முதற்காரணமாக விளங்கும் ‘முதல் எழுத்துகள்’ மொத்தம் எத்தனை?"}], "options": [{"key": "A", "text": "12"}, {"key": "B", "text": "18"}, {"key": "C", "text": "30 (உயிர் 12 + மெய் 18)"}, {"key": "D", "text": "216"}], "explanation": "உயிர் எழுத்துகள் 12 மற்றும் மெய் எழுத்துகள் 18 ஆகிய முப்பதும் முதல் எழுத்துகள் ஆகும்."}}}
{"id": "pyq-tam-6t1-089", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 32}, "texts": {"ta": {"blocks": [{"type": "text", "text": "முதல் எழுத்துகளைச் சார்ந்து வரும் சார்பெழுத்துகள் எத்தனை வகைப்படும்?"}], "options": [{"key": "A", "text": "ஐந்து வகை"}, {"key": "B", "text": "எட்டு வகை"}, {"key": "C", "text": "பத்து வகை"}, {"key": "D", "text": "பன்னிரண்டு வகை"}], "explanation": "சார்பெழுத்துகள் 10 வகைப்படும்: உயிர்மெய், ஆய்தம், உயிரளபெடை, ஒற்றளபெடை, குற்றியலிகரம், குற்றியலுகரம், ஐகாரக்குறுக்கம், ஔகாரக்குறுக்கம், மகரக்குறுக்கம், ஆய்தக்குறுக்கம்."}}}
{"id": "b-tam-6t1-090", "kind": "statements", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": false}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 34"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "உயிர்மெய் எழுத்து குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "உயிர்மெய் எழுத்தின் ஒலிவடிவம் மெய்யும் உயிரும் சேர்ந்ததாக இருக்கும்."}, {"type": "statement", "label": "II", "text": "உயிர்மெய் எழுத்தின் வரிவடிவம் மெய்யெழுத்தை ஒத்திருக்கும்."}, {"type": "statement", "label": "III", "text": "உயிர்மெய் எழுத்து ஒலிக்கும் கால அளவு மெய்யெழுத்தை ஒத்திருக்கும்."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "C", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "உயிர்மெய் எழுத்து ஒலிக்கும் கால அளவு 'உயிர் எழுத்தை' ஒத்திருக்கும்; மெய்யெழுத்தை அன்று. எனவே கூற்று III தவறானது."}}}
{"id": "b-tam-6t1-091", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "D", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 34"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஆய்த எழுத்தின் வேறு பெயர்களுள் பொருந்தாத ஒன்றைத் தேர்வு செய்க:"}], "options": [{"key": "A", "text": "முப்புள்ளி"}, {"key": "B", "text": "முப்பாற்புள்ளி"}, {"key": "C", "text": "தனிநிலை, அஃகேனம்"}, {"key": "D", "text": "ஒற்றெழுத்து"}], "explanation": "ஆய்த எழுத்தின் வேறு பெயர்கள்: முப்புள்ளி, முப்பாற்புள்ளி, தனிநிலை, அஃகேனம். ஒற்றெழுத்து என்பது மெய்யெழுத்தைக் குறிக்கும்."}}}
{"id": "pyq-tam-6t1-092", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 89}, "texts": {"ta": {"blocks": [{"type": "text", "text": "சொல்லில் ஆய்த எழுத்து இடம்பெறும் சரியான இலக்கண விதி எது?"}], "options": [{"key": "A", "text": "சொல்லின் முதலிலும் இறுதியிலும் மட்டுமே வரும்"}, {"key": "B", "text": "தனக்குமுன் ஒரு குறிலையும், தனக்குப்பின் ஒரு வல்லின உயிர்மெய்யையும் பெற்று இடையில் மட்டுமே வரும்"}, {"key": "C", "text": "தனக்குமுன் நெடிலையும், பின் மெல்லின உயிர்மெய்யையும் பெற்று வரும்"}, {"key": "D", "text": "சொற்களில் எவ்விடத்திலும் தனித்து இயங்கும்"}], "explanation": "ஆய்த எழுத்து தனக்குமுன் ஒரு குறிலையும் தனக்குப்பின் ஒரு வல்லின உயிர்மெய் எழுத்தையும் பெற்றுச் சொல்லின் இடையில் மட்டுமே வரும்; தனித்து இயங்காது."}}}
{"id": "b-tam-6t1-093", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 34"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பாடநூலின்படி முதல் எழுத்துகள் மட்டுமே இடம்பெற்றுள்ள சொல்லுக்கு எடுத்துக்காட்டு எது?"}], "options": [{"key": "A", "text": "குருவி"}, {"key": "B", "text": "ஆம்"}, {"key": "C", "text": "எஃகு"}, {"key": "D", "text": "தமிழ்"}], "explanation": "'ஆம்' என்ற சொல்லில் 'ஆ' (உயிர் எழுத்து), 'ம்' (மெய் எழுத்து) ஆகிய இரண்டும் முதல் எழுத்துகள் மட்டுமே ஆகும்."}}}
{"id": "b-tam-6t1-094", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 34"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பாடநூல் எடுத்துக்காட்டின்படி முதல் எழுத்துகள் இடம்பெறாத சொல்லுக்குச் சான்று எது?"}], "options": [{"key": "A", "text": "அணில்"}, {"key": "B", "text": "குருவி"}, {"key": "C", "text": "ஊசி"}, {"key": "D", "text": "கல்வி"}], "explanation": "'குருவி' என்னும் சொல்லில் உள்ள கு, ரு, வி ஆகிய மூன்றும் சார்பெழுத்தான உயிர்மெய் எழுத்துகள்; இதில் தனி முதல் எழுத்துகள் (உயிர், மெய்) இல்லை."}}}
{"id": "extra-tam-6t1-095", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "other", "note": "இலக்கண நூல்கள் ஒப்பீடு வினா"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தொல்காப்பியர் குறிப்பிடும் சார்பெழுத்துகளின் எண்ணிக்கை யாது?"}], "options": [{"key": "A", "text": "ஒன்று"}, {"key": "B", "text": "இரண்டு"}, {"key": "C", "text": "மூன்று (குற்றியலிகரம், குற்றியலுகரம், ஆய்தம்)"}, {"key": "D", "text": "பத்து"}], "explanation": "தொல்காப்பியர் குற்றியலிகரம், குற்றியலுகரம், ஆய்தம் என 3 சார்பெழுத்துகளைக் கூறினார். நன்னூலாரே சார்பெழுத்துகளை 10 என விரித்துக் கூறினார்."}}}

// ==============================================================================
// பாடம் 5: மொழியை ஆள்வோம் & கலைச்சொற்கள் [Q096 - Q103]
// கொன்றை வேந்தன், தொடர் பிரித்தல், மயங்கொலி (பரவை, உரை, பணி, அழைத்தாள்), கலைச்சொற்கள்
// ==============================================================================
{"id": "b-tam-6t1-096", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 35"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘மாரி அல்லது காரியம் இல்லை’ என்று மழையின் சிறப்பைக் கூறும் நூல் எது?"}], "options": [{"key": "A", "text": "நாலடியார்"}, {"key": "B", "text": "கொன்றை வேந்தன்"}, {"key": "C", "text": "மூதுரை"}, {"key": "D", "text": "திருக்குறள்"}], "explanation": "பக்கம் 35 கட்டுரைக் குறிப்பில் 'மாரி அல்லது காரியம் இல்லை' என்று கொன்றை வேந்தன் குறிப்பிடுவதாகத் தரப்பட்டுள்ளது."}}}
{"id": "b-tam-6t1-097", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 36"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கபிலன் வேலை செய்ததால் களைப்பாக இருக்கிறான்’ - இத்தொடரை இரு தொடர்களாகப் பிரித்து எழுதினால் எவ்வாறு அமையும்?"}], "options": [{"key": "A", "text": "கபிலன் வேலை செய்தான். களைப்பாக இருக்கிறான்."}, {"key": "B", "text": "கபிலன் களைப்பாக இருக்கிறான். வேலை செய்தான்."}, {"key": "C", "text": "கபிலன் வேலை செய்யவில்லை. களைப்பாக இருக்கிறான்."}, {"key": "D", "text": "வேலை செய்ததால் கபிலன் களைப்புற்றான்."}], "explanation": "பாடநூல் மொழிப்பயிற்சி விதிப்படி: 'கபிலன் வேலை செய்தான். களைப்பாக இருக்கிறான்.' என இரண்டு தனித்தொடர்களாகப் பிரிக்க வேண்டும்."}}}
{"id": "b-tam-6t1-098", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 36"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பரந்து விரிந்து இருப்பதால் கடலுக்குப் ________ என்று பெயர்’ - சரியான மயங்கொலிச் சொல் எது?"}], "options": [{"key": "A", "text": "பறவை"}, {"key": "B", "text": "பரவை"}, {"key": "C", "text": "பறவைமை"}, {"key": "D", "text": "பரவு"}], "explanation": "பரந்து விரிந்து காணப்படுவதால் கடலுக்குப் 'பரவை' என்று பெயர். பறவை என்பது சிறகுடைய உயிரினத்தைக் குறிக்கும்."}}}
{"id": "b-tam-6t1-099", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 36"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘இலக்கிய மன்ற விழாவில் முகிலன் சிறப்பாக ________ ஆற்றினார்’ - பொருத்தமான சொல்லைத் தேர்க:"}], "options": [{"key": "A", "text": "உறை"}, {"key": "B", "text": "உரை"}, {"key": "C", "text": "உரசு"}, {"key": "D", "text": "உரைப்பு"}], "explanation": "பேச்சு நிகழ்த்துவதை 'உரை ஆற்றினார்' என்பர்; உறை என்பது மூடி அல்லது கடித உறை, தயிர் உறைதலைக் குறிக்கும்."}}}
{"id": "b-tam-6t1-100", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 36"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘முத்து தம் ________ காரணமாக ஊருக்குச் சென்றார்’ - சரியான சொல் எது?"}], "options": [{"key": "A", "text": "பனி"}, {"key": "B", "text": "பணி"}, {"key": "C", "text": "பணிவு"}, {"key": "D", "text": "பன்னல்"}], "explanation": "பணி என்றால் வேலை என்று பொருள். பனி என்பது குளிர்காலப் பனியைக் குறிக்கும்."}}}
{"id": "b-tam-6t1-101", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 36"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கலைமகள் தனது வீட்டுத் தோட்டத்தைப் பார்க்க வருமாறு தோழியை ________’ - சரியான விடை எது?"}], "options": [{"key": "A", "text": "அலைத்தாள்"}, {"key": "B", "text": "அழைத்தாள்"}, {"key": "C", "text": "அழைப்பு"}, {"key": "D", "text": "அலைந்தாள்"}], "explanation": "கூப்பிடுதலை 'அழைத்தாள்' என்பர். அலைத்தல் என்பது நீரலைத்தல் அல்லது அலைச்சலைக் குறிக்கும்."}}}
{"id": "b-tam-6t1-102", "kind": "match", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "3", "B": "1", "C": "4", "D": "2"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 37"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"}, {"type": "list", "name": "ஆங்கிலக் கலைச்சொல்", "items": [{"label": "A", "text": "Continent"}, {"label": "B", "text": "Climate"}, {"label": "C", "text": "Weather"}, {"label": "D", "text": "Migration"}]}, {"type": "list", "name": "தமிழாக்கம்", "items": [{"label": "1", "text": "தட்பவெப்பநிலை"}, {"label": "2", "text": "வலசை"}, {"label": "3", "text": "கண்டம்"}, {"label": "4", "text": "வானிலை"}]}], "options": [{"key": "A", "text": "A-3, B-1, C-4, D-2", "mapping": {"A": "3", "B": "1", "C": "4", "D": "2"}}, {"key": "B", "text": "A-1, B-3, C-2, D-4", "mapping": {"A": "1", "B": "3", "C": "2", "D": "4"}}, {"key": "C", "text": "A-3, B-4, C-1, D-2", "mapping": {"A": "3", "B": "4", "C": "1", "D": "2"}}, {"key": "D", "text": "A-2, B-1, C-4, D-3", "mapping": {"A": "2", "B": "1", "C": "4", "D": "3"}}], "explanation": "Continent = கண்டம், Climate = தட்பவெப்பநிலை, Weather = வானிலை, Migration = வலசை."}}}
{"id": "b-tam-6t1-103", "kind": "match", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "2", "B": "1"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 37"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கலைச்சொற்களைப் பொருத்துக:"}, {"type": "list", "name": "ஆங்கிலக் கலைச்சொல்", "items": [{"label": "A", "text": "Sanctuary"}, {"label": "B", "text": "Gravitational Field"}]}, {"type": "list", "name": "தமிழாக்கம்", "items": [{"label": "1", "text": "புவிஈர்ப்புப்புலம்"}, {"label": "2", "text": "புகலிடம்"}]}], "options": [{"key": "A", "text": "A-2, B-1", "mapping": {"A": "2", "B": "1"}}, {"key": "B", "text": "A-1, B-2", "mapping": {"A": "1", "B": "2"}}, {"key": "C", "text": "A-2, B-2", "mapping": {"A": "2", "B": "2"}}, {"key": "D", "text": "A-1, B-1", "mapping": {"A": "1", "B": "1"}}], "explanation": "Sanctuary = புகலிடம், Gravitational Field = புவிஈர்ப்புப்புலம்."}}}

// ==============================================================================
// பாடம் 6: திருக்குறள் (வாழ்வியல்) [Q104 - Q126]
// கடவுள் வாழ்த்து, வான்சிறப்பு, நீத்தார் பெருமை, மக்கட்பேறு, அன்புடைமை, இனியவை கூறல்,
// அணிகள் (எடுத்துக்காட்டு உவமையணி, உவமையணி), திருவள்ளுவர் குறிப்பு, திருவள்ளுவர் ஆண்டு
// ==============================================================================
{"id": "b-tam-6t1-104", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 38"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அகர முதல எழுத்தெல்லாம் ஆதி பகவன் முதற்றே உலகு’ - இக்குறட்பாவில் எழுத்துகளுக்குத் தொடக்கமாக அமைவது எது?"}], "options": [{"key": "A", "text": "ஆதிபகவன்"}, {"key": "B", "text": "அகர எழுத்து (அ)"}, {"key": "C", "text": "உயிர்மெய் எழுத்து"}, {"key": "D", "text": "சொல்"}], "explanation": "அகரமே எழுத்துகளுக்குத் தொடக்கம்; அதுபோல ஆதிபகவனே உலகுக்குத் தொடக்கமாக விளங்குகிறான்."}}}
{"id": "pyq-tam-6t1-105", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2018, "paper": "tamil", "no": 12}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அகர முதல எழுத்தெல்லாம் ஆதி பகவன் முதற்றே உலகு’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?"}], "options": [{"key": "A", "text": "உவமையணி"}, {"key": "B", "text": "எடுத்துக்காட்டு உவமையணி"}, {"key": "C", "text": "வேற்றுமையணி"}, {"key": "D", "text": "பொருள் பின்வருநிலையணி"}], "explanation": "'அதுபோல' என்ற உவம உருபு மறைந்து வந்துள்ளதால் இக்குறளில் எடுத்துக்காட்டு உவமையணி பயின்று வந்துள்ளது."}}}
{"id": "b-tam-6t1-106", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 38"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘விண்இன்று பொய்ப்பின் விரிநீர் வியனுலகத்து உள்நின்று உடற்றும் பசி’ - இக்குறளில் ‘உடற்றும்’ என்பதன் பொருள் யாது?"}], "options": [{"key": "A", "text": "அழிக்கும்"}, {"key": "B", "text": "துன்புறுத்தும்"}, {"key": "C", "text": "காக்கும்"}, {"key": "D", "text": "போக்கும்"}], "explanation": "மழை உரிய காலத்தில் பெய்யாது பொய்த்துப் போனால், உலகத்து உயிர்களை எல்லாம் பசி உள்ளே நின்று துன்புறுத்தும் (வருத்தும்)."}}}
{"id": "b-tam-6t1-107", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 38"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கெடுப்பதூஉம் கெட்டார்க்குச் சார்வாய்மற்று ஆங்கே எடுப்பதூஉம் எல்லாம் ________’ - விடுபட்ட சீரைக் கண்டறிக:"}], "options": [{"key": "A", "text": "அறம்"}, {"key": "B", "text": "உலகு"}, {"key": "C", "text": "மழை"}, {"key": "D", "text": "பசி"}], "explanation": "உரிய காலத்தில் பெய்யாது கெடுப்பதும் மழைதான்; உரிய காலத்தில் பெய்து காப்பதும் மழைதான்."}}}
{"id": "extra-tam-6t1-108", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "other", "note": "இலக்கணக் குறிப்பு வினா"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கெடுப்பதூஉம்’, ‘எடுப்பதூஉம்’ ஆகிய சொற்களில் அமைந்துள்ள இலக்கணக் குறிப்பு யாது?"}], "options": [{"key": "A", "text": "செய்யுளிசை அளபெடை"}, {"key": "B", "text": "இன்னிசை அளபெடை"}, {"key": "C", "text": "சொல்லிசை அளபெடை"}, {"key": "D", "text": "ஒற்றளபெடை"}], "explanation": "செய்யுளில் ஓசை குறையாத இடத்தும் இனிய ஓசைக்காக அளபெடுப்பது இன்னிசை அளபெடை ஆகும் (தூஉம்)."}}}
{"id": "b-tam-6t1-109", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 38"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘செயற்கரிய செய்வார் பெரியர் சிறியர் செயற்கரிய செய்கலா தார்’ - இக்குறட்பாவின்படி பெரியவர் யார்?"}], "options": [{"key": "A", "text": "வயதில் மூத்தவர்"}, {"key": "B", "text": "முடியாத செயலையும் முடித்துக் காட்டுபவர்"}, {"key": "C", "text": "செல்வம் உடையவர்"}, {"key": "D", "text": "அரிய நூல்களைப் படித்தவர்"}], "explanation": "முடியாத செயலையும் முடித்துக் காட்டுபவரே பெரியோர்; முடியாது என்பவர் சிறியோர் ஆவார்."}}}
{"id": "b-tam-6t1-110", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 40"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘செயற்கரிய செய்வார் பெரியர் சிறியர் செயற்கரிய செய்கலா தார்’ - இக்குறளில் அமைந்துள்ள மோனைச் சொற்கள் எவை?"}], "options": [{"key": "A", "text": "செயற்கரிய - செய்கலா தார்"}, {"key": "B", "text": "பெரியர் - சிறியர்"}, {"key": "C", "text": "செய்வார் - தார்"}, {"key": "D", "text": "செயற்கரிய - பெரியர்"}], "explanation": "முதல் எழுத்து ஒன்றி வருவது மோனை ஆகும் (செ - செ: செயற்கரிய - செய்கலா தார்)."}}}
{"id": "b-tam-6t1-111", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 40"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘செயற்கரிய செய்வார் பெரியர் சிறியர்...’ - இக்குறளில் அமைந்துள்ள எதுகைச் சொற்கள் எவை?"}], "options": [{"key": "A", "text": "செயற்கரிய - செய்கலா தார்"}, {"key": "B", "text": "பெரியர் - சிறியர்"}, {"key": "C", "text": "செயற்கரிய - செய்வார்"}, {"key": "D", "text": "செய்கலா - தார்"}], "explanation": "இரண்டாம் எழுத்து ஒன்றி வருவது எதுகை ஆகும் (பெரியர் - சிறியர்: 'ரி' ஒன்றி வந்துள்ளது)."}}}
{"id": "b-tam-6t1-112", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 38"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘தம்மின்தம் மக்கள் அறிவுடைமை மாநிலத்து மன்னுயிர்க்கு எல்லாம் இனிது’ - இக்குறட்பா இடம்பெற்றுள்ள அதிகாரம் எது?"}], "options": [{"key": "A", "text": "வான் சிறப்பு"}, {"key": "B", "text": "மக்கட்பேறு"}, {"key": "C", "text": "அன்புடைமை"}, {"key": "D", "text": "நீத்தார் பெருமை"}], "explanation": "தம்மைவிடத் தம் பிள்ளைகள் அறிவுடையோர் என்றால் மக்களுக்கு அதுவே மகிழ்ச்சி என்று கூறும் இக்குறள் 'மக்கட்பேறு' அதிகாரத்தில் உள்ளது."}}}
{"id": "pyq-tam-6t1-113", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 27}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘ஈன்ற பொழுதின் பெரிதுவக்கும் தன்மகனைச் சான்றோன் எனக்கேட்ட தாய்’ - இக்குறளில் ‘உவக்கும்’ என்பதன் பொருள் யாது?"}], "options": [{"key": "A", "text": "வருந்தும்"}, {"key": "B", "text": "அஞ்சும்"}, {"key": "C", "text": "மகிழும்"}, {"key": "D", "text": "வியக்கும்"}], "explanation": "பெரிதுவக்கும் என்றால் 'பெருமகிழ்ச்சி அடைவாள்' என்று பொருள்."}}}
{"id": "b-tam-6t1-114", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 40"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "2016 ரியோ பாராலிம்பிக்கில் மாரியப்பன் தங்கப் பதக்கம் வென்றபோது, அவரது தாய் ‘அவனைப் பெற்றெடுத்த பொழுதைவிட இப்போது அதிகமாக மகிழ்கிறேன்’ எனக் கூறிய நிகழ்விற்குப் பொருத்தமான திருக்குறள் எது?"}], "options": [{"key": "A", "text": "செயற்கரிய செய்வார் பெரியர் சிறியர் செயற்கரிய செய்கலா தார்"}, {"key": "B", "text": "ஈன்ற பொழுதின் பெரிதுவக்கும் தன்மகனைச் சான்றோன் எனக்கேட்ட தாய்"}, {"key": "C", "text": "இனிய உளவாக இன்னாத கூறல் கனியிருப்பக் காய்கவர்ந் தற்று"}, {"key": "D", "text": "அன்பிலார் எல்லாம் தமக்குரியர் அன்புடையார் என்பும் உரியர் பிறர்க்கு"}], "explanation": "பாடநூல் மதிப்பீட்டு வினா: தன் மகன் சான்றோன் எனப் பிறர் புகழக் கேட்ட தாய் அடைந்த பெருமகிழ்ச்சிக்கு இக்குறளே பொருத்தமானது."}}}
{"id": "pyq-tam-6t1-115", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 4}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அன்பிலார் எல்லாம் தமக்குரியர் அன்புடையார் என்பும் உரியர் பிறர்க்கு’ - இக்குறளில் ‘என்பு’ என்னும் சொல் எதனைக் குறிக்கிறது?"}], "options": [{"key": "A", "text": "பொருள்"}, {"key": "B", "text": "எலும்பு (உடம்பு)"}, {"key": "C", "text": "உயிர்"}, {"key": "D", "text": "சொல்"}], "explanation": "என்பு என்பது எலும்பைக் குறிக்கும். அன்பு உடையவர்கள் தம் எலும்பையும் (உடம்பையும்) பிறர்க்குத் தந்து உதவுவர்."}}}
{"id": "b-tam-6t1-116", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 39"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அன்பின் வழியது உயிர்நிலை அஃதிலார்க்கு என்புதோல் போர்த்த உடம்பு’ - இக்குறட்பாவின்படி உயிருள்ள உடலாகக் கருதப்படுவது எது?"}], "options": [{"key": "A", "text": "நன்கு பருத்த உடம்பு"}, {"key": "B", "text": "அன்பு பொருந்திய உடம்பு"}, {"key": "C", "text": "ஆடை அணிந்த உடம்பு"}, {"key": "D", "text": "அறிவுடையோரின் உடம்பு"}], "explanation": "அன்பு இருப்பதுதான் உயிருள்ள உடல்; அன்பு இல்லாதது வெறும் எலும்பின் மேல் தோல் போர்த்திய வெற்று உடம்பாகும்."}}}
{"id": "pyq-tam-6t1-117", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 44}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பணிவுடையன் இன்சொலன் ஆதல் ஒருவற்கு அணியல்ல மற்றுப் பிற’ - இக்குறளின்படி ஒருவருக்கு மிகச்சிறந்த அணிகலன்கள் எவை?"}], "options": [{"key": "A", "text": "பொன் மாலை, மோதிரம்"}, {"key": "B", "text": "அறிவும் வீரமும்"}, {"key": "C", "text": "பணிவும் இன்சொல்லும்"}, {"key": "D", "text": "செல்வமும் புகழும்"}], "explanation": "பணிவும் இனிய சொல்லுமே ஒருவருக்கு உண்மையான மிகச்சிறந்த அணிகலன்கள் ஆகும்."}}}
{"id": "pyq-tam-6t1-118", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 62}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘இனிய உளவாக இன்னாத கூறல் கனியிருப்பக் காய்கவர்ந் தற்று’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?"}], "options": [{"key": "A", "text": "வேற்றுமையணி"}, {"key": "B", "text": "உவமையணி"}, {"key": "C", "text": "எடுத்துக்காட்டு உவமையணி"}, {"key": "D", "text": "சொற்பொருள் பின்வருநிலையணி"}], "explanation": "'அற்று' என்னும் உவம உருபு வெளிப்படையாக வந்துள்ளதால் இது உவமையணி ஆகும்."}}}
{"id": "b-tam-6t1-119", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 39"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "திருவள்ளுவர் எத்தனை ஆண்டுகளுக்கு முற்பட்டவர் எனக் குறிப்பிடப்படுகிறார்?"}], "options": [{"key": "A", "text": "ஆயிரம் ஆண்டுகள்"}, {"key": "B", "text": "இரண்டாயிரம் ஆண்டுகள்"}, {"key": "C", "text": "மூவாயிரம் ஆண்டுகள்"}, {"key": "D", "text": "ஐந்நூறு ஆண்டுகள்"}], "explanation": "திருவள்ளுவர் இரண்டாயிரம் ஆண்டுகளுக்கு முற்பட்டவர்; எக்காலத்துக்கும் பொருந்தும் வாழ்க்கை நெறிகளை வகுத்துக் கூறியுள்ளார்."}}}
{"id": "b-tam-6t1-120", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 39"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "திருவள்ளுவரின் சிறப்புப் பெயர்களுள் பொருந்தாத ஒன்றைத் தேர்வு செய்க:"}], "options": [{"key": "A", "text": "வான்புகழ் வள்ளுவர்"}, {"key": "B", "text": "தெய்வப்புலவர்"}, {"key": "C", "text": "பொய்யில் புலவர்"}, {"key": "D", "text": "பாவேந்தர்"}], "explanation": "பாவேந்தர் என்பது பாரதிதாசனின் சிறப்புப் பெயர். வான்புகழ் வள்ளுவர், தெய்வப்புலவர், பொய்யில் புலவர் ஆகியவை திருவள்ளுவரின் பெயர்கள்."}}}
{"id": "b-tam-6t1-121", "kind": "statements", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": false, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 39"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "திருக்குறள் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "அறத்துப்பால், பொருட்பால், இன்பத்துப்பால் என்னும் மூன்று பிரிவுகளைக் கொண்டது."}, {"type": "statement", "label": "II", "text": "இது பதினெண்மேற்கணக்கு நூல்களுள் ஒன்றாகும்."}, {"type": "statement", "label": "III", "text": "133 அதிகாரங்களில் 1330 குறட்பாக்களைக் கொண்டுள்ளது."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "C", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "திருக்குறள் 'பதினெண்கீழ்க்கணக்கு' நூல்களுள் ஒன்று; மேற்கணக்கு நூல் அல்ல. எனவே கூற்று II தவறானது."}}}
{"id": "extra-tam-6t1-122", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "other", "note": "திருவள்ளுவர் ஆண்டு கணக்கீடு"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "திருவள்ளுவர் ஆண்டைக் கணக்கிடக் கிறிஸ்து பிறப்பதற்கு முன் (கி.மு.) எத்தனை ஆண்டுகளைக் கூட்ட வேண்டும்?"}], "options": [{"key": "A", "text": "30 ஆண்டுகள்"}, {"key": "B", "text": "32 ஆண்டுகள்"}, {"key": "C", "text": "31 ஆண்டுகள்"}, {"key": "D", "text": "25 ஆண்டுகள்"}], "explanation": "திருவள்ளுவர் ஆண்டு = தற்போதைய ஆங்கில ஆண்டு + 31 (எ.கா: 2024 + 31 = 2055)."}}}
{"id": "b-tam-6t1-123", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 39"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "உலகப் பொதுமறை, வாயுறை வாழ்த்து முதலிய சிறப்புப் பெயர்களைக் கொண்ட நூல் எத்தனைக்கும் மேற்பட்ட மொழிகளில் மொழிபெயர்க்கப்பட்டுள்ளது?"}], "options": [{"key": "A", "text": "50-க்கும் மேற்பட்ட"}, {"key": "B", "text": "80-க்கும் மேற்பட்ட"}, {"key": "C", "text": "100-க்கும் மேற்பட்ட"}, {"key": "D", "text": "150-க்கும் மேற்பட்ட"}], "explanation": "நூற்றுக்கும் மேற்பட்ட உலக மொழிகளில் திருக்குறள் மொழிபெயர்க்கப்பட்டு உலகப் பொதுமறையாகத் திகழ்கிறது."}}}
{"id": "extra-tam-6t1-124", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "other", "note": "அறத்துப்பால் இயல்கள் கூடுதல் வினா"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "திருக்குறளின் அறத்துப்பாலில் உள்ள அதிகாரங்களின் மொத்த எண்ணிக்கை யாது?"}], "options": [{"key": "A", "text": "70 அதிகாரங்கள்"}, {"key": "B", "text": "38 அதிகாரங்கள்"}, {"key": "C", "text": "25 அதிகாரங்கள்"}, {"key": "D", "text": "133 அதிகாரங்கள்"}], "explanation": "அறத்துப்பால் - 38 அதிகாரங்கள்; பொருட்பால் - 70 அதிகாரங்கள்; இன்பத்துப்பால் - 25 அதிகாரங்கள் (மொத்தம் 133)."}}}
{"id": "b-tam-6t1-125", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 40"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘மக்களுக்கு மகிழ்ச்சி தருவது ________; ஒருவர்க்குச் சிறந்த அணி ________’ - மதிப்பீட்டின்படி சரியான இணை எது?"}], "options": [{"key": "A", "text": "வன்சொல், மாலை"}, {"key": "B", "text": "அறிவுடைய மக்கள், இன்சொல்"}, {"key": "C", "text": "செல்வம், காதணி"}, {"key": "D", "text": "ஊக்கமின்மை, பணிவு"}], "explanation": "பக்கம் 40 மதிப்பீட்டின்படி மக்களுக்கு மகிழ்ச்சி தருவது அறிவுடைய மக்கள்; ஒருவர்க்குச் சிறந்த அணி இன்சொல் (பணிவும் இன்சொல்லும்) ஆகும்."}}}
{"id": "b-tam-6t1-126", "kind": "statements", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 38, 39"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "திருக்குறள் கருத்துகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "அன்பில்லாதவர் எல்லாப் பொருளும் தமக்கே என்பர்; அன்பு உடையவர் தம் உடம்பையும் பிறர்க்கு என்பர்."}, {"type": "statement", "label": "II", "text": "பணிவும் இன்சொல்லுமே ஒருவருக்கு மிகச்சிறந்த அணிகலன்கள் ஆகும்; மற்றவை அணிகலன்கள் ஆகா."}, {"type": "statement", "label": "III", "text": "இனிய சொல் இருக்கும் போது கடுமையான சொல் பேசுவது கனி இருக்கும் போது காயைத் தின்பதற்கு ஒப்பானது."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "C", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "மூன்று கூற்றுகளும் முறையே அன்புடைமை மற்றும் இனியவை கூறல் அதிகாரக் குறட்பாக்களின் சரியான பொருளாகும்."}}}

// ==============================================================================
// பாடம் 7: மொழிப்பயிற்சி & மதிப்பீடு (புணர்ச்சி - சேர்த்தெழுதுதல் / பிரித்தெழுதுதல்) [Q127 - Q131]
// வழியெல்லாம், தட்பவெப்பம், வேதியுரங்கள், தரையிறங்கும், வழித்தடம்
// ==============================================================================
{"id": "b-tam-6t1-127", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 21"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘வழி + எல்லாம்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}], "options": [{"key": "A", "text": "வழிஎல்லாம்"}, {"key": "B", "text": "வழியெல்லாம்"}, {"key": "C", "text": "வழியில்லாம்"}, {"key": "D", "text": "வழிலெல்லாம்"}], "explanation": "வழி + எல்லாம் = வழியெல்லாம் (இ ஈ ஐ வழி யவ்வும் உடம்படுமெய் விதிப்படி 'ய்' தோன்றி, ய் + ஏ = யே எனப் புணரும்)."}}}
{"id": "b-tam-6t1-128", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 25"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘தட்பவெப்பம்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}], "options": [{"key": "A", "text": "தட்பம் + வெப்பம்"}, {"key": "B", "text": "தட்ப + வெப்பம்"}, {"key": "C", "text": "தட் + வெப்பம்"}, {"key": "D", "text": "தட்பு + வெப்பம்"}], "explanation": "தட்பம் + வெப்பம் = தட்பவெப்பம்."}}}
{"id": "b-tam-6t1-129", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 25"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘வேதியுரங்கள்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}], "options": [{"key": "A", "text": "வேதி + யுரங்கள்"}, {"key": "B", "text": "வேதி + உரங்கள்"}, {"key": "C", "text": "வேத் + உரங்கள்"}, {"key": "D", "text": "வேதிய + உரங்கள்"}], "explanation": "வேதி + உரங்கள் = உடம்படுமெய் 'ய்' தோன்றி, ய் + உ = யு ஆகி வேதியுரங்கள் எனப் புணரும்."}}}
{"id": "b-tam-6t1-130", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 25"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘தரை + இறங்கும்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}], "options": [{"key": "A", "text": "தரையிறங்கும்"}, {"key": "B", "text": "தரைஇறங்கும்"}, {"key": "C", "text": "தரையுறங்கும்"}, {"key": "D", "text": "தரையெங்கும்"}], "explanation": "தரை + இறங்கும் = உடம்படுமெய் 'ய்' தோன்றி, ய் + இ = யி ஆகி தரையிறங்கும் எனப் புணரும்."}}}
{"id": "b-tam-6t1-131", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 26"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘வழி + தடம்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}], "options": [{"key": "A", "text": "வழிதடம்"}, {"key": "B", "text": "வழித்தடம்"}, {"key": "C", "text": "வழிதிடம்"}, {"key": "D", "text": "வழத்தடம்"}], "explanation": "இயல்பினும் விதியினும் நின்ற உயிர்முன் க ச த ப மிகும் விதிப்படி 'த்' மிகுந்து 'வழித்தடம்' எனப் புணரும்."}}}
