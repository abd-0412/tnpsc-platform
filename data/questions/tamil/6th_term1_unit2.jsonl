// பாடம் 2: சிறகின் ஓசை (உரைநடை உலகம்) [Q063 - Q078]
// வலசை போதல், வழிகாட்டிகள், திசைகள், சத்திமுத்தப் புலவர், செங்கால் நாரை,
// கப்பல் பறவை, சிட்டுக்குருவி, பாரதியார், டாக்டர் சலீம் அலி, ஆர்க்டிக் ஆலா
// ==============================================================================
{"id": "b-tam-6t1-063", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 22"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பறவைகள் ஒரு குறிப்பிட்ட காலத்திற்குப் பின் கண்டம் விட்டுக் கண்டம் இடம் பெயர்தலை எவ்வாறு அழைப்பர்?"}], "options": [{"key": "A", "text": "அடைக்கலம் புகுதல்"}, {"key": "B", "text": "புகலிடம் செல்லுதல்"}, {"key": "C", "text": "வலசை போதல் (Migration)"}, {"key": "D", "text": "புலம்பெயர்தல்"}], "explanation": "பறவைகள் பெருங்கடல்களையும் மலைகளையும் கடந்து இடம் பெயர்தலை 'வலசை போதல்' என்பர். நீர்வாழ் பறவைகளே பெரும்பாலும் வலசை போகின்றன."}}}
{"id": "b-tam-6t1-064", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 22"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பறவைகள் வலசை போவதற்கு அடிப்படையாகக் கொள்ளும் இயற்கை வழிகாட்டிகள் எவை?"}], "options": [{"key": "A", "text": "காற்று, மழை, மேகம்"}, {"key": "B", "text": "சூரியன், நதிகள், தாவரங்கள்"}, {"key": "C", "text": "நிலவு, விண்மீன், புவிஈர்ப்புப் புலம்"}, {"key": "D", "text": "கடல்நீரோட்டம், திசைகாட்டி, வெப்பம்"}], "explanation": "நிலவு, விண்மீன், புவிஈர்ப்புப் புலம் (Gravitational Field) ஆகிய மூன்றையும் அடிப்படையாகக் கொண்டே பறவைகள் இடம் பெயர்கின்றன."}}}
{"id": "pyq-tam-6t1-065", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 38}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பறவைகள் பொதுவாக எந்தெந்தத் திசைகளை நோக்கி வலசை போகின்றன?"}], "options": [{"key": "A", "text": "வடக்கிலிருந்து தெற்கு நோக்கியும், மேற்கிலிருந்து கிழக்கு நோக்கியும்"}, {"key": "B", "text": "தெற்கிலிருந்து வடக்கு நோக்கியும், கிழக்கிலிருந்து மேற்கு நோக்கியும்"}, {"key": "C", "text": "கிழக்கிலிருந்து மேற்கு நோக்கியும், தெற்கிலிருந்து வடக்கு நோக்கியும்"}, {"key": "D", "text": "மேற்கிலிருந்து தெற்கு நோக்கியும், கிழக்கிலிருந்து வடக்கு நோக்கியும்"}], "explanation": "பொதுவாக வடக்கிலிருந்து தெற்கு நோக்கியும், மேற்கிலிருந்து கிழக்கு நோக்கியும் பறவைகள் வலசை போகின்றன."}}}
{"id": "b-tam-6t1-066", "kind": "statements", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 23"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "வலசையின் போது பறவைகளின் உடலில் ஏற்படும் மாற்றங்கள் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "தலையில் சிறகு வளர்தல்."}, {"type": "statement", "label": "II", "text": "இறகுகளின் நிறம் மாறுதல்."}, {"type": "statement", "label": "III", "text": "உடலில் கற்றையாக முடி வளர்தல்."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "C", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "வலசையின் போது தலையில் சிறகு வளர்தல், இறகுகளின் நிறம் மாறுதல், உடலில் கற்றையாக முடி வளர்தல் ஆகிய மாற்றங்கள் ஏற்படுகின்றன."}}}
{"id": "pyq-tam-6t1-067", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2018, "paper": "tamil", "no": 64}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘நாராய், நாராய், செங்கால் நாராய்... தென்திசைக் குமரிஆடி வடதிசைக்கு ஏகுவீர் ஆயின்’ - என்று 1500 ஆண்டுகளுக்கு முன்பே பாடிய தமிழ்ப்புலவர் யார்?"}], "options": [{"key": "A", "text": "கபிலர்"}, {"key": "B", "text": "சத்திமுத்தப் புலவர்"}, {"key": "C", "text": "பிசிராந்தையார்"}, {"key": "D", "text": "பெருந்தலைச் சாத்தனார்"}], "explanation": "ஏறத்தாழ 1500 ஆண்டுகளுக்கு முன்பு வாழ்ந்த சத்திமுத்தப் புலவர் பாடிய இவ்வடிகள் பறவைகள் வலசை வந்த செய்தியைக் குறிப்பிடுகின்றன."}}}
{"id": "b-tam-6t1-068", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 23"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தற்கால ஆய்விலும் எந்த நாட்டிலிருந்து தமிழ்நாட்டிற்குச் செங்கால் நாரைகள் வலசை வருவது உறுதி செய்யப்பட்டுள்ளது?"}], "options": [{"key": "A", "text": "ஆப்பிரிக்கா"}, {"key": "B", "text": "ஆஸ்திரேலியா"}, {"key": "C", "text": "ஐரோப்பா"}, {"key": "D", "text": "வட அமெரிக்கா"}], "explanation": "ஐரோப்பாவில் இருந்து தமிழ்நாட்டிற்குச் செங்கால் நாரைகள் வருவது தற்போதைய அறிவியல் ஆய்விலும் உறுதிப்படுத்தப்பட்டுள்ளது."}}}
{"id": "b-tam-6t1-069", "kind": "statements", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 23"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கப்பல் பறவை (Frigate bird) பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "சிறகடிக்காமல் கடலையும் தாண்டிப் பறக்கும் திறனுடையது."}, {"type": "statement", "label": "II", "text": "தரையிறங்காமல் 400 கிலோ மீட்டர் வரை பறக்கும் ஆற்றல் கொண்டது."}, {"type": "statement", "label": "III", "text": "இது கப்பல் கூழைக்கடா, கடற்கொள்ளைப் பறவை என்றும் அழைக்கப்படுகிறது."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "C", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "பக்கம் 23 தெரிந்து தெளிவோம் குறிப்பில் கப்பல் பறவை குறித்த மூன்று தகவல்களும் துல்லியமாகத் தரப்பட்டுள்ளன."}}}
{"id": "b-tam-6t1-070", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 23"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "சிட்டுக்குருவி கூடுகட்டி முட்டையிட்டுக் குஞ்சு பொரிப்பது குறித்த கால அளவு எது?"}], "options": [{"key": "A", "text": "10 நாள்கள் அடைகாக்கும்; 11-ஆம் நாளில் குஞ்சுகள் வெளிவரும்"}, {"key": "B", "text": "12 நாள்கள் அடைகாக்கும்; 13-ஆம் நாளில் குஞ்சுகள் வெளிவரும்"}, {"key": "C", "text": "14 நாள்கள் அடைகாக்கும்; 15-ஆம் நாளில் குஞ்சுகள் வெளிவரும்"}, {"key": "D", "text": "16 நாள்கள் அடைகாக்கும்; 17-ஆம் நாளில் குஞ்சுகள் வெளிவரும்"}], "explanation": "சிட்டுக்குருவி 3 முதல் 6 முட்டைகள் வரை இடும்; பதினான்கு நாள்கள் அடைகாக்கும். பதினைந்தாம் நாளில் குஞ்சுகள் வெளிவரும்."}}}
{"id": "b-tam-6t1-071", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 24"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "இமயமலைத் தொடரில் எத்தனை மீட்டர் உயரத்தில் கூடச் சிட்டுக்குருவிகள் வாழ்கின்றன?"}], "options": [{"key": "A", "text": "2000 மீட்டர்"}, {"key": "B", "text": "4000 மீட்டர்"}, {"key": "C", "text": "6000 மீட்டர்"}, {"key": "D", "text": "8000 மீட்டர்"}], "explanation": "துருவப் பகுதிகள் தவிர மனிதன் வாழும் இடமெல்லாம் வாழும் சிட்டுக்குருவிகள் இமயமலையில் 4000 மீட்டர் உயரத்தில் கூட வாழ்கின்றன."}}}
{"id": "b-tam-6t1-072", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 24"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "சிட்டுக்குருவியின் சராசரி வாழ்நாள் எத்தனை ஆண்டுகள் ஆகும்?"}], "options": [{"key": "A", "text": "5 முதல் 8 ஆண்டுகள்"}, {"key": "B", "text": "10 முதல் 13 ஆண்டுகள்"}, {"key": "C", "text": "15 முதல் 18 ஆண்டுகள்"}, {"key": "D", "text": "20 முதல் 25 ஆண்டுகள்"}], "explanation": "சிட்டுக்குருவியின் வாழ்நாள் பத்து முதல் பதின்மூன்று ஆண்டுகள் ஆகும்."}}}
{"id": "b-tam-6t1-073", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 24"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘காக்கை குருவி எங்கள் சாதி’ - என்று பாடி, சமைக்க வைத்திருந்த அரிசியையும் சிட்டுக்குருவிகளுக்குப் போட்டுவிட்டுப் பட்டினியாக இருந்த புலவர் யார்?"}], "options": [{"key": "A", "text": "மகாகவி பாரதியார்"}, {"key": "B", "text": "பாரதிதாசன்"}, {"key": "C", "text": "கவிமணி தேசிக விநாயகம்"}, {"key": "D", "text": "நாமக்கல் கவிஞர்"}], "explanation": "'காக்கைகுருவி எங்கள் சாதி' என்று பாடிய பாரதியார், தம் மனைவி சமைக்க வைத்திருந்த அரிசியையும் குருவிகளுக்கு மகிழ்வுடன் இட்டுப் பட்டினியாக இருந்தார்."}}}
{"id": "pyq-tam-6t1-074", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 71}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘இந்தியாவின் பறவை மனிதர்’ என்று அழைக்கப்படுபவர் யார்?"}], "options": [{"key": "A", "text": "டாக்டர் ஏ.பி.ஜே. அப்துல் கலாம்"}, {"key": "B", "text": "டாக்டர் சலீம் அலி"}, {"key": "C", "text": "டாக்டர் எம்.எஸ். சுவாமிநாதன்"}, {"key": "D", "text": "பேராசிரியர் சுந்தரனார்"}], "explanation": "தம் வாழ்நாள் முழுவதும் பறவைகளை ஆராய்ச்சி செய்து படம் பிடித்த டாக்டர் சலீம் அலி 'இந்தியாவின் பறவை மனிதர்' என்று போற்றப்படுகிறார்."}}}
{"id": "pyq-tam-6t1-075", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 55}, "texts": {"ta": {"blocks": [{"type": "text", "text": "டாக்டர் சலீம் அலி எழுதிய வாழ்க்கை வரலாற்று நூலின் பெயர் யாது?"}], "options": [{"key": "A", "text": "பறவைகளின் உலகம்"}, {"key": "B", "text": "சிட்டுக்குருவியின் வீழ்ச்சி (The Fall of a Sparrow)"}, {"key": "C", "text": "என் சிறகுகள்"}, {"key": "D", "text": "இந்தியப் பறவையியல்"}], "explanation": "டாக்டர் சலீம் அலி தம்முடைய வாழ்க்கை வரலாற்று நூலுக்குச் 'சிட்டுக்குருவியின் வீழ்ச்சி' (The Fall of a Sparrow) என்று பெயரிட்டுள்ளார்."}}}
{"id": "b-tam-6t1-076", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 25"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘மனிதன் இல்லாத உலகில் பறவைகள் வாழ முடியும்; பறவைகள் இல்லாத உலகில் மனிதன் வாழ முடியாது’ - என்று கூறிய பறவையியல் ஆய்வாளர் யார்?"}], "options": [{"key": "A", "text": "அப்துல் கலாம்"}, {"key": "B", "text": "டாக்டர் சலீம் அலி"}, {"key": "C", "text": "சுந்தர்லால் பகுகுணா"}, {"key": "D", "text": "மயில்சாமி அண்ணாதுரை"}], "explanation": "பறவைகளின் இன்றியமையாமையை உணர்த்தும் இக்கூற்றைக் கூறியவர் பறவையியல் முன்னோடி டாக்டர் சலீம் அலி ஆவார்."}}}
{"id": "b-tam-6t1-077", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 25"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பறவைகள் பற்றிய படிப்பு மற்றும் உலகச் சிட்டுக்குருவிகள் நாள் ஆகியவை முறையே எவை?"}], "options": [{"key": "A", "text": "Ornithology, மார்ச் 20"}, {"key": "B", "text": "Entomology, மார்ச் 21"}, {"key": "C", "text": "Ornithology, ஏப்ரல் 22"}, {"key": "D", "text": "Ecology, ஜூன் 5"}], "explanation": "பறவைகள் பற்றிய படிப்பு Ornithology எனப்படும். உலகச் சிட்டுக்குருவிகள் நாள் மார்ச் 20 ஆகும்."}}}
{"id": "b-tam-6t1-078", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 25"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "உலகிலேயே நெடுந்தொலைவு (22,000 கி.மீ.) பயணம் செய்யும் அரிய பறவையினம் எது?"}], "options": [{"key": "A", "text": "கப்பல் பறவை"}, {"key": "B", "text": "ஆர்க்டிக் ஆலா (Arctic Tern)"}, {"key": "C", "text": "செங்கால் நாரை"}, {"key": "D", "text": "கூழைக்கடா"}], "explanation": "உலகிலேயே மிக நீண்ட தொலைவு (22,000 கி.மீ.) பயணம் செய்யும் பறவையினம் ஆர்க்டிக் ஆலா ஆகும்."}}}

// ==============================================================================
// பாடம் 3: கிழவனும் கடலும் (The Old Man and the Sea) [Q079 - Q086]
// எர்னெஸ்ட் ஹெமிங்வே, 1954 நோபல் பரிசு, சாண்டியாகோ, 84 நாட்கள், மனோலின், சூரை மீன், சுறா
// ==============================================================================
{"id": "b-tam-6t1-079", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 27"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கிழவனும் கடலும்’ (The Old Man and the Sea) என்னும் ஆங்கிலப் புதினத்தின் ஆசிரியர் யார்?"}], "options": [{"key": "A", "text": "வில்லியம் ஷேக்ஸ்பியர்"}, {"key": "B", "text": "எர்னெஸ்ட் ஹெமிங்வே"}, {"key": "C", "text": "லிலியன் வாட்சன்"}, {"key": "D", "text": "ஜான் மில்டன்"}], "explanation": "கிழவனும் கடலும் ஆங்கிலப் புதினத்தை எழுதியவர் எர்னெஸ்ட் ஹெமிங்வே ஆவார்."}}}
{"id": "pyq-tam-6t1-080", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 84}, "texts": {"ta": {"blocks": [{"type": "text", "text": "எர்னெஸ்ட் ஹெமிங்வே எழுதிய 'கிழவனும் கடலும்' புதினத்திற்கு நோபல் பரிசு வழங்கப்பட்ட ஆண்டு எது?"}], "options": [{"key": "A", "text": "1952"}, {"key": "B", "text": "1954"}, {"key": "C", "text": "1956"}, {"key": "D", "text": "1960"}], "explanation": "இந்நூல் 1954-ஆம் ஆண்டு இலக்கியத்திற்கான நோபல் பரிசு பெற்றது."}}}
{"id": "b-tam-6t1-081", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 27"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கிழவனும் கடலும்’ படக்கதையின் கதாநாயகனான முதிய மீனவரின் பெயர் யாது?"}], "options": [{"key": "A", "text": "மனோலின்"}, {"key": "B", "text": "சாண்டியாகோ"}, {"key": "C", "text": "ராபர்ட்"}, {"key": "D", "text": "பீட்டர்"}], "explanation": "இக்கதையின் நாயகன் சாண்டியாகோ என்ற வயது முதிர்ந்த மீனவர் ஆவார்."}}}
{"id": "b-tam-6t1-082", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 27"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "சாண்டியாகோவிற்கு எத்தனை நாள்களாகக் கடலில் ஒரு மீனும் கிடைக்கவில்லை?"}], "options": [{"key": "A", "text": "நாற்பது நாள்கள்"}, {"key": "B", "text": "எண்பத்து நான்கு நாள்கள்"}, {"key": "C", "text": "எண்பத்து ஐந்து நாள்கள்"}, {"key": "D", "text": "நூறு நாள்கள்"}], "explanation": "கடந்த 84 நாள்களாக அவருக்கு ஒரு மீனும் கிடைக்கவில்லை; 85-ஆவது நாளில்தான் பெரிய மீன் சிக்கியது."}}}
{"id": "b-tam-6t1-083", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 27"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "மீன்பிடிக்கக் கற்றுக்கொள்வதற்காக முதல் நாற்பது நாள்களும் சாண்டியாகோவுடன் கடலுக்குச் சென்ற சிறுவன் யார்?"}], "options": [{"key": "A", "text": "பீட்டர்"}, {"key": "B", "text": "மனோலின்"}, {"key": "C", "text": "கபிலன்"}, {"key": "D", "text": "அருண்"}], "explanation": "மனோலின் என்னும் சிறுவன் முதல் நாற்பது நாள்களும் சாண்டியாகோவுடன் மீன்பிடிக்கச் சென்று உதவிகள் செய்தான்."}}}
{"id": "extra-tam-6t1-084", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "other", "note": "பாடநூல் உரையாடல் குறிப்பு"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "சாண்டியாகோ பெரிய மீனைப் பிடிப்பதற்காகத் தன் தூண்டில் முள்ளில் மாட்டி வைத்திருந்த சிறிய மீனின் வகை எது?"}], "options": [{"key": "A", "text": "சுறா மீன்"}, {"key": "B", "text": "கெண்டை மீன்"}, {"key": "C", "text": "சூரை மீன்"}, {"key": "D", "text": "மத்தி மீன்"}], "explanation": "பக்கம் 28-ல் சாண்டியாகோ 'தூண்டில் முள்ளில் உனக்காகச் சூரைமீனை மாட்டி வைத்திருக்கிறேன்' என்று மீனிடம் பேசுவதாகக் குறிப்பிடப்பட்டுள்ளது."}}}
{"id": "b-tam-6t1-085", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 30, 31"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "சாண்டியாகோ தூண்டிலில் பிடித்த பெரிய மீனைத் தாக்கிய கடலின் வேட்டை மீன்கள் எவை?"}], "options": [{"key": "A", "text": "திமிங்கிலங்கள்"}, {"key": "B", "text": "சுறா மீன்கள்"}, {"key": "C", "text": "டால்பின்கள்"}, {"key": "D", "text": "வாள் மீன்கள்"}], "explanation": "சாண்டியாகோ படகின் பக்கவாட்டில் கட்டி இழுத்து வந்த மீனைச் சுறா மீன்கள் தாக்கித் தின்றன."}}}
{"id": "b-tam-6t1-086", "kind": "assertion_reason", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "assertion_reason", "a_true": true, "r_true": true, "r_explains_a": true}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 32"}, "texts": {"ta": {"blocks": [{"type": "assertion", "text": "கடைசியில் மீனின் எலும்பும் தலையும் மட்டுமே மிஞ்சியிருந்தாலும் சாண்டியாகோவின் முயற்சி வென்றதாக மனோலின் பாராட்டினான்."}, {"type": "reason", "text": "வலை இல்லாமல் தூண்டிலால் மட்டுமே அவ்வளவு பெரிய மீனை அடக்கிப் படகில் கட்டி இழுத்து வந்த அவரது விடாமுயற்சியும் திறமையும் நிரூபிக்கப்பட்டன."}], "options": [{"key": "A", "text": "(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்", "semantic": "both_true_explains"}, {"key": "B", "text": "(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல", "semantic": "both_true_not_explains"}, {"key": "C", "text": "(A) சரி ஆனால் (R) தவறு", "semantic": "a_true_r_false"}, {"key": "D", "text": "(A) தவறு ஆனால் (R) சரி", "semantic": "a_false_r_true"}], "explanation": "சாண்டியாகோவின் விடாமுயற்சியும் திறமையும் வென்றுவிட்டதால் இனி அவரை யாரும் பழித்துப் பேச முடியாது என்று மனோலின் போற்றுகிறான்."}}}

