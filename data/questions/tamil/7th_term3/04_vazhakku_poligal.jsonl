// 7-ஆம் வகுப்பு தமிழ் - பருவம் 3 - இயல் 1 - பாடம் 4: அணி இலக்கணம் / வழக்கு & போலி (கற்கண்டு - இலக்கணம்)
// வினாக்கள் எண்ணிக்கை: 20
// ==============================================================================
{"id":"b-tam-7t3-044","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 13"},"texts":{"ta":{"blocks":[{"type":"text","text":"எழுத்திலும் பேச்சிலும் சொற்களைப் பயன்படுத்தும் முறையை ‘வழக்கு’ என்பர். வழக்கு எத்தனை வகைப்படும்?"}],"options":[{"key":"A","text":"மூன்று வகைப்படும்"},{"key":"B","text":"இரண்டு வகைப்படும் (இயல்பு வழக்கு, தகுதி வழக்கு)"},{"key":"C","text":"நான்கு வகைப்படும்"},{"key":"D","text":"ஆறு வகைப்படும்"}],"explanation":"வழக்கு இயல்பு வழக்கு, தகுதி வழக்கு என இருவகைப்படும்."}}}
{"id":"b-tam-7t3-045","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 13"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஒரு பொருளை அதற்கே உரிய இயல்பான சொற்களால் குறிப்பிடும் ‘இயல்பு வழக்கு’ எத்தனை வகைப்படும்?"}],"options":[{"key":"A","text":"இரண்டு வகைப்படும்"},{"key":"B","text":"மூன்று வகைப்படும் (இலக்கணம் உடையது, இலக்கணப்போலி, மரூஉ)"},{"key":"C","text":"நான்கு வகைப்படும்"},{"key":"D","text":"ஐந்து வகைப்படும்"}],"explanation":"இயல்பு வழக்கு இலக்கணம் உடையது, இலக்கணப்போலி, மரூஉ என 3 வகைப்படும்."}}}
{"id":"b-tam-7t3-046","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 13"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நிலம், மரம், வான், எழுது’ - தமக்குரிய பொருளை எவ்வகை மாறுபாடும் இல்லாமல் இயல்பாகத் தரும் சொற்கள் எவை?"}],"options":[{"key":"A","text":"இலக்கணப்போலி"},{"key":"B","text":"இலக்கணம் உடையது"},{"key":"C","text":"மரூஉ"},{"key":"D","text":"இடக்கரடக்கல்"}],"explanation":"இலக்கண நெறி மாறாமல் முறையாக அமைந்த சொல் 'இலக்கணம் உடையது' ஆகும்."}}}
{"id":"b-tam-7t3-047","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 13"},"texts":{"ta":{"blocks":[{"type":"text","text":"இல்லத்தின் முன் பகுதியை ‘இல்முன்’ எனக் குறிக்காமல் ‘முன்றில்’ எனவும், கிளையின் நுனியை ‘நுனிக்கிளை’ எனவும் வழங்குவது எவ்வகை வழக்கு?"}],"options":[{"key":"A","text":"மரூஉ"},{"key":"B","text":"இலக்கணப்போலி (முன்பின்னாகத் தொக்க போலி)"},{"key":"C","text":"இலக்கணம் உடையது"},{"key":"D","text":"குழூஉக்குறி"}],"explanation":"இலக்கண முறைப்படி அமையாவிட்டாலும் இலக்கணமுடையவை போலவே ஏற்றுக்கொள்ளப்படும் சொற்கள் இலக்கணப்போலி எனப்படும்."}}}
{"id":"pyq-tam-7t3-048","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":86},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வாயில்’ மற்றும் ‘வாசல்’ ஆகிய சொற்கள் முறையே எவ்வகை வழக்குகளைச் சேர்ந்தவை?"}],"options":[{"key":"A","text":"மரூஉ, இலக்கணப்போலி"},{"key":"B","text":"இலக்கணப்போலி, மரூஉ"},{"key":"C","text":"இலக்கணம் உடையது, இலக்கணப்போலி"},{"key":"D","text":"தகுதி வழக்கு, இயல்பு வழக்கு"}],"explanation":"இல்வாய் என்பது 'வாயில்' என அமைவது இலக்கணப்போலி; வாயில் என்பது பேச்சுவழக்கில் 'வாசல்' என மருவி வருவது மரூஉ ஆகும்."}}}
{"id":"b-tam-7t3-049","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 14"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘புறநகர், கால்வாய், தசை, கடைக்கண்’ - இச்சொற்கள் முன்பின் பகுதிகள் இடம்மாறி அமைந்துள்ளதால் எவ்வாறு அழைக்கப்படும்?"}],"options":[{"key":"A","text":"முற்றுப்போலி"},{"key":"B","text":"முன்பின்னாகத் தொக்க போலி (இலக்கணப்போலி)"},{"key":"C","text":"மரூஉ"},{"key":"D","text":"இடக்கரடக்கல்"}],"explanation":"நகர்ப்புறம் - புறநகர், வாய்க்கால் - கால்வாய், சதையின்தசை - தசை, கண்கடை - கடைக்கண் என இடம்மாறுவதால் முன்பின்னாகத் தொக்க போலி எனப்படும்."}}}
{"id":"b-tam-7t3-050","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 14"},"texts":{"ta":{"blocks":[{"type":"text","text":"சொல்லின் முதலிலோ, இடையிலோ, இறுதியிலோ இயல்பாக இருக்க வேண்டிய ஓர் எழுத்திற்குப் பதிலாக வேறு ஓர் எழுத்து இடம்பெற்று அதே பொருள் தருவது எது?"}],"options":[{"key":"A","text":"சொற்போலி"},{"key":"B","text":"எழுத்துப்போலி"},{"key":"C","text":"மரூஉ"},{"key":"D","text":"இடைச்சொல்"}],"explanation":"எழுத்து மாறி நின்று அதே பொருள் தருவது எழுத்துப்போலி ஆகும்; இது முதற்போலி, இடைப்போலி, கடைப்போலி என 3 வகைப்படும்."}}}
{"id":"b-tam-7t3-051","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 14"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பசல் - பைசல், மஞ்சு - மைஞ்சு, மயல் - மையல்’ - இச்சொற்களில் அமைந்துள்ள போலி வகை எது?"}],"options":[{"key":"A","text":"முதற்போலி"},{"key":"B","text":"இடைப்போலி"},{"key":"C","text":"கடைப்போலி"},{"key":"D","text":"முற்றுப்போலி"}],"explanation":"சொல்லின் முதலெழுத்து 'அ' மாறி 'ஐ' எனப் போலியாக வந்துள்ளதால் இது முதற்போலி ஆகும்."}}}
{"id":"b-tam-7t3-052","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 14"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அமச்சு - அமைச்சு, இலஞ்சி - இலைஞ்சி, அரயர் - அரையர்’ - இச்சொற்களில் அமைந்துள்ள போலி வகை எது?"}],"options":[{"key":"A","text":"முதற்போலி"},{"key":"B","text":"இடைப்போலி"},{"key":"C","text":"கடைப்போலி"},{"key":"D","text":"முற்றுப்போலி"}],"explanation":"சொல்லின் இடையில் உள்ள எழுத்து மாறி வந்துள்ளதால் இது இடைப்போலி எனப்படும்."}}}
{"id":"pyq-tam-7t3-053","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":84},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அகம் - அகன், நிலம் - நிலன், முகம் - முகன், பந்தல் - பந்தர், சாம்பல் - சாம்பர்’ - இச்சொற்களில் அமைந்துள்ள போலி வகை எது?"}],"options":[{"key":"A","text":"முதற்போலி"},{"key":"B","text":"இடைப்போலி"},{"key":"C","text":"கடைப்போலி (இறுதிப்போலி)"},{"key":"D","text":"முற்றுப்போலி"}],"explanation":"சொல்லின் இறுதியில் மகரத்திற்கு னகரமும், லகரத்திற்கு ரகரமும் போலியாக வந்துள்ளதால் கடைப்போலி எனப்படும்."}}}
{"id":"pyq-tam-7t3-054","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":79},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஐந்து’ என்னும் சொல்லுக்குப் பதிலாக ‘அஞ்சு’ என எல்லா எழுத்துகளும் முற்றிலும் வேறுபட்டாலும் பொருள் மாறாமல் வருவது எது?"}],"options":[{"key":"A","text":"கடைப்போலி"},{"key":"B","text":"முற்றுப்போலி"},{"key":"C","text":"இலக்கணப்போலி"},{"key":"D","text":"மரூஉ"}],"explanation":"சொல்லில் அமைந்த எழுத்துகள் அனைத்தும் வேறுபட்டாலும் பொருள் மாறாமல் நிற்பது 'முற்றுப்போலி' ஆகும்."}}}
{"id":"b-tam-7t3-055","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 15"},"texts":{"ta":{"blocks":[{"type":"text","text":"தஞ்சாவூர் $\\rightarrow$ தஞ்சை, திருநெல்வேலி $\\rightarrow$ நெல்லை, குடமூக்கு $\\rightarrow$ குடந்தை என இலக்கண நெறியிலிருந்து பிறழ்ந்து சிதைந்து வழங்கும் சொற்கள் எவை?"}],"options":[{"key":"A","text":"இலக்கணப்போலி"},{"key":"B","text":"மரூஉ"},{"key":"C","text":"இடக்கரடக்கல்"},{"key":"D","text":"குழூஉக்குறி"}],"explanation":"இலக்கண நெறியிலிருந்து பிறழ்ந்து சிதைந்து வழங்கும் சொற்கள் மரூஉ எனப்படும் (எ.கா: கோவை, எந்தை, போது, சோணாடு)."}}}
{"id":"b-tam-7t3-056","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 15"},"texts":{"ta":{"blocks":[{"type":"text","text":"பிறரிடம் வெளிப்படையாகச் சொல்லத் தகாத சொற்களை நாகரிகம் கருதித் தகுதியுடைய வேறு சொற்களால் மறைத்துக் கூறுவது எது?"}],"options":[{"key":"A","text":"மங்கலம்"},{"key":"B","text":"இடக்கரடக்கல் (எ.கா: கால் கழுவி வந்தான்)"},{"key":"C","text":"குழூஉக்குறி"},{"key":"D","text":"மரூஉ"}],"explanation":"நாகரிகம் கருதி மறைமுகமாகக் குறிப்பிடுவது இடக்கரடக்கல் எனப்படும்."}}}
{"id":"pyq-tam-7t3-057","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2018,"paper":"tamil","no":83},"texts":{"ta":{"blocks":[{"type":"text","text":"மங்கலமில்லாத சொற்களை மாற்றி ‘செத்தார் என்பதைத் துஞ்சினார் / காலமானார்’ எனவும், ‘விளக்கை அணை என்பதை விளக்கைக் குளிரவை’ எனவும் கூறுவது எது?"}],"options":[{"key":"A","text":"இடக்கரடக்கல்"},{"key":"B","text":"மங்கலம்"},{"key":"C","text":"குழூஉக்குறி"},{"key":"D","text":"இலக்கணப்போலி"}],"explanation":"மங்கலமற்ற சொற்களை மாற்றி மங்கலச் சொற்களால் குறிப்பிடுவது மங்கலம் எனப்படும்."}}}
{"id":"b-tam-7t3-058","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 15"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஓலை என்பதைத் திருமுகம்’ என்றும், ‘கருப்பு ஆடு என்பதை வெள்ளாடு’ என்றும், ‘நஞ்சுள்ள பாம்பை நல்லபாம்பு’ என்றும் வழங்குவது எவ்வகை வழக்கு?"}],"options":[{"key":"A","text":"இடக்கரடக்கல்"},{"key":"B","text":"மங்கலம்"},{"key":"C","text":"குழூஉக்குறி"},{"key":"D","text":"மரூஉ"}],"explanation":"அமங்கலமானவற்றை மங்கலச் சொற்களாக மாற்றி வழங்குவது மங்கலம் ஆகும்."}}}
{"id":"pyq-tam-7t3-059","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":91},"texts":{"ta":{"blocks":[{"type":"text","text":"பொற்கொல்லர் பொன்னைப் ‘பறி’ எனலும், யானைப்பாகர் ஆடையைக் ‘காரை’ எனலும் எவ்வகைத் தகுதி வழக்குகள் ஆகும்?"}],"options":[{"key":"A","text":"இடக்கரடக்கல்"},{"key":"B","text":"குழூஉக்குறி"},{"key":"C","text":"மங்கலம்"},{"key":"D","text":"மரூஉ"}],"explanation":"பிறர் அறியாமல் ஒரு குழுவினர் தமக்குள் மட்டும் புரியும் வகையில் பயன்படுத்தும் சொல் குழூஉக்குறி எனப்படும்."}}}
{"id":"b-tam-7t3-060","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"4","B":"1","C":"2","D":"3"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 16"},"texts":{"ta":{"blocks":[{"type":"text","text":"போலிச் சொற்களை அவற்றின் வகையோடு சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"பந்தர்"},{"label":"B","text":"மைஞ்சு"},{"label":"C","text":"அஞ்சு"},{"label":"D","text":"அரையர்"}]},{"type":"list","name":"போலி வகை","items":[{"label":"1","text":"முதற்போலி"},{"label":"2","text":"முற்றுப்போலி"},{"label":"3","text":"இடைப்போலி"},{"label":"4","text":"கடைப்போலி"}]}],"options":[{"key":"A","text":"A-4, B-1, C-2, D-3","mapping":{"A":"4","B":"1","C":"2","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-4, B-3, C-2, D-1","mapping":{"A":"4","B":"3","C":"2","D":"1"}},{"key":"D","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}}],"explanation":"பந்தர் = கடைப்போலி (பந்தல்); மைஞ்சு = முதற்போலி (மஞ்சு); அஞ்சு = முற்றுப்போலி (ஐந்து); அரையர் = இடைப்போலி (அரயர்)."}}}
{"id":"b-tam-7t3-061","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 16"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வாழைப்பழம் மிகவும் நஞ்சு விட்டது’ - இத்தொடரில் இடம்பெற்றுள்ள போலிச் சொல்லின் சரியான சொல் எது?"}],"options":[{"key":"A","text":"நஞ்சு"},{"key":"B","text":"நைந்து விட்டது"},{"key":"C","text":"காய்ந்து விட்டது"},{"key":"D","text":"அழுகி விட்டது"}],"explanation":"நைந்து விட்டது என்னும் சொல்லே பேச்சு வழக்கில் 'நஞ்சு விட்டது' எனப் போலியாக வழங்கப்படுகிறது."}}}
{"id":"b-tam-7t3-071","kind":"assertion_reason","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 13"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"‘முன்றில், நுனிக்கிளை’ ஆகிய சொற்கள் இலக்கணப்போலிகள் (சொற்போலிகள்) ஆகும்."},{"type":"reason","text":"இவை இலக்கண முறைப்படி அமையாவிட்டாலும் முன்பின் பகுதிகள் இடம்மாறி இலக்கணமுடையவை போலவே மரபில் ஏற்றுக்கொள்ளப்படுகின்றன."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"இல்முன் என்பது முன்றில் எனவும் கிளைநுனி என்பது நுனிக்கிளை எனவும் இடம்மாறுவது முன்பின்னாகத் தொக்க போலி ஆகும்; கூற்றும் காரணமும் சரி."}}}
{"id":"b-tam-7t3-072","kind":"assertion_reason","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 15"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"பொற்கொல்லர் பொன்னைப் ‘பறி’ என அழைப்பது குழூஉக்குறி ஆகும்."},{"type":"reason","text":"பலர் கூடியிருக்கும் இடத்தில் பிறர் அறியாமல் ஒரு குறிப்பிட்ட குழுவினர் மட்டும் தமக்குள் பொருளைப் புரிந்து கொள்ளும் வகையில் பயன்படுத்தும் சொல் குழூஉக்குறி எனப்படும்."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"குழுவினர் தமக்குள் பயன்படுத்தும் பிரத்யேகக் குறியீட்டுச் சொற்கள் குழூஉக்குறி எனப்படும்; கூற்றும் காரணமும் சரி."}}}
