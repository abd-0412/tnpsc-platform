// 7-ஆம் வகுப்பு தமிழ் - பருவம் 3 - இயல் 1 - பாடம் 2: திக்கெல்லாம் புகழுறும் திருநெல்வேலி (உரைநடை உலகம்)
// வினாக்கள் எண்ணிக்கை: 23
// ==============================================================================
{"id":"b-tam-7t3-009","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"பழந்தமிழகத்தில் பாண்டிய மன்னர்களின் இரண்டாவது தலைநகரமாக விளங்கிய வரலாற்றுச் சிறப்புமிக்க நகரம் எது?"}],"options":[{"key":"A","text":"கொற்கை"},{"key":"B","text":"திருநெல்வேலி"},{"key":"C","text":"மதுரை"},{"key":"D","text":"தென்காசி"}],"explanation":"பாண்டியர்களின் முதல் தலைநகரமாக மதுரையும், இரண்டாவது தலைநகரமாகத் திருநெல்வேலியும் விளங்கின."}}}
{"id":"pyq-tam-7t3-010","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":28},"texts":{"ta":{"blocks":[{"type":"text","text":"‘திக்கெல்லாம் புகழுறும் திருநெல்வேலி’ என்று நெல்லைச் சீமையின் புகழைப் பாடிய சைவ சமயக் குரவர் யார்?"}],"options":[{"key":"A","text":"திருநாவுக்கரசர்"},{"key":"B","text":"திருஞானசம்பந்தர்"},{"key":"C","text":"சுந்தரர்"},{"key":"D","text":"மாணிக்கவாசகர்"}],"explanation":"'திக்கெல்லாம் புகழுறும் திருநெல்வேலி' என்று திருஞானசம்பந்தர் தேவாரம் பாடியுள்ளார்."}}}
{"id":"pyq-tam-7t3-011","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":18},"texts":{"ta":{"blocks":[{"type":"text","text":"திருநெல்வேலிப் பகுதியைத் ‘தண்பொருநைப் புனல் நாடு’ என்று போற்றிய புலவர் பெருமான் யார்?"}],"options":[{"key":"A","text":"கம்பர்"},{"key":"B","text":"சேக்கிழார்"},{"key":"C","text":"புகழேந்தி"},{"key":"D","text":"ஒட்டக்கூத்தர்"}],"explanation":"பெரியபுராணத்தில் சேக்கிழார் நெல்லை வளத்தைத் 'தண்பொருநைப் புனல் நாடு' என்று புகழ்ந்துள்ளார்."}}}
{"id":"b-tam-7t3-012","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 5"},"texts":{"ta":{"blocks":[{"type":"text","text":"முற்காலத்தில் திருநெல்வேலிக்கு ‘வேணுவனம்’ என்னும் பெயரும் இருந்தது. ‘வேணுவனம்’ என்பதன் பொருள் யாது?"}],"options":[{"key":"A","text":"செந்நெல் காடு"},{"key":"B","text":"மூங்கில் காடு"},{"key":"C","text":"சந்தனக் காடு"},{"key":"D","text":"பனை மரக் காடு"}],"explanation":"வேணுவனம் என்றால் மூங்கில் காடு என்பது பொருளாகும்; மூங்கில் நெல் மிகுதியாக விளைந்ததால் நெல்வேலி எனப் பெயர் பெற்றிருக்கலாம்."}}}
{"id":"pyq-tam-7t3-013","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2018,"paper":"tamil","no":32},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பொதியி லாயினும் இமய மாயினும் பதியெழு அறியாப் பழங்குடி’ - என்று சிலப்பதிகாரத்தில் பொதிகை மலைக்கு முதலிடம் கொடுத்துப் பாடியவர் யார்?"}],"options":[{"key":"A","text":"சீத்தலைச் சாத்தனார்"},{"key":"B","text":"திருவள்ளுவர்"},{"key":"C","text":"இளங்கோவடிகள்"},{"key":"D","text":"பரணர்"}],"explanation":"இளங்கோவடிகள் இமயமலைக்கு முன்பாகத் தென்னாட்டிலுள்ள பொதிகை மலைக்கு முதலிடம் கொடுத்துப் பாடியுள்ளார்."}}}
{"id":"b-tam-7t3-014","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 5"},"texts":{"ta":{"blocks":[{"type":"text","text":"திருநெல்வேலிச் சீமையை வளம் செழிக்கச் செய்யும் தாமிரபரணி ஆற்றின் பழம்பெயர் யாது?"}],"options":[{"key":"A","text":"பவானி"},{"key":"B","text":"தண்பொருநை நதி"},{"key":"C","text":"வைகை"},{"key":"D","text":"பொன்னி"}],"explanation":"தாமிரபரணி ஆறு பழங்காலத்தில் 'தண்பொருநை நதி' என்று அழைக்கப்பட்டது."}}}
{"id":"b-tam-7t3-015","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":true,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 5"},"texts":{"ta":{"blocks":[{"type":"text","text":"தாமிரபரணி ஆற்றின் கிளை ஆறுகளுள் பொருந்தாத ஒன்றைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"பச்சையாறு, மணிமுத்தாறு"},{"key":"B","text":"சிற்றாறு, காரையாறு"},{"key":"C","text":"சேர்வலாறு, கடனாநதி"},{"key":"D","text":"அமராவதி, நொய்யல்"}],"explanation":"அமராவதி, நொய்யல் ஆகியவை காவிரியின் கிளை ஆறுகள்; பச்சையாறு, மணிமுத்தாறு, சிற்றாறு, காரையாறு, சேர்வலாறு, கடனாநதி ஆகியவை தாமிரபரணியின் கிளை ஆறுகள்."}}}
{"id":"b-tam-7t3-016","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழகத்தில் எந்த உற்பத்திப் பொருளின் விளைச்சலில் திருநெல்வேலிச் சீமை முதலிடம் வகிக்கின்றது?"}],"options":[{"key":"A","text":"மாங்கனி"},{"key":"B","text":"நெல்லிக்காய்"},{"key":"C","text":"பருத்தி"},{"key":"D","text":"தேயிலை"}],"explanation":"நெல்லிக்காய் உற்பத்தியில் தமிழகத்தில் திருநெல்வேலிச் சீமை முதலிடம் வகிக்கின்றது."}}}
{"id":"pyq-tam-7t3-017","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":15},"texts":{"ta":{"blocks":[{"type":"text","text":"பழந்தமிழர்கள் பயன்படுத்திய முதுமக்கள் தாழிகள் கண்டெடுக்கப்பட்ட புகழ்பெற்ற ‘ஆதிச்சநல்லூர்’ தற்போது எந்த மாவட்டத்தில் அமைந்துள்ளது?"}],"options":[{"key":"A","text":"திருநெல்வேலி மாவட்டம்"},{"key":"B","text":"தூத்துக்குடி மாவட்டம்"},{"key":"C","text":"தென்காசி மாவட்டம்"},{"key":"D","text":"இராமநாதபுரம் மாவட்டம்"}],"explanation":"முற்காலத்தில் நெல்லைச் சீமையில் இருந்த ஆதிச்சநல்லூர் தற்போது தூத்துக்குடி மாவட்டத்தில் உள்ளது."}}}
{"id":"b-tam-7t3-018","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"கொற்கை முத்துக்குளித்தல் பற்றிக் கூறும் சங்க இலக்கிய அடிகளை நூல்களோடு சரியாகப் பொருத்துக:"},{"type":"list","name":"சங்க இலக்கிய அடி","items":[{"label":"A","text":"முத்துபடு பரப்பிற் கொற்கை முன்றுறை"},{"label":"B","text":"கொற்கையில் பெருந்துறை முத்து"}]},{"type":"list","name":"நூல்","items":[{"label":"1","text":"அகநானூறு (27:9)"},{"label":"2","text":"நற்றிணை (23:6)"}]}],"options":[{"key":"A","text":"A-2, B-1","mapping":{"A":"2","B":"1"}},{"key":"B","text":"A-1, B-2","mapping":{"A":"1","B":"2"}},{"key":"C","text":"A-2, B-2","mapping":{"A":"2","B":"2"}},{"key":"D","text":"A-1, B-1","mapping":{"A":"1","B":"1"}}],"explanation":"முத்துபடு பரப்பிற் கொற்கை முன்றுறை = நற்றிணை; கொற்கையில் பெருந்துறை முத்து = அகநானூறு."}}}
{"id":"b-tam-7t3-019","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"கொற்கையில் விளைந்த புகழ்பெற்ற பாண்டி நாட்டு முத்துகளை விரும்பி வாங்கிச் சென்ற கிரேக்க, உரோமாபுரி நாட்டவர்கள் எவ்வாறு அழைக்கப்பட்டனர்?"}],"options":[{"key":"A","text":"சீனர்கள்"},{"key":"B","text":"சோனகர்"},{"key":"C","text":"யவனர்கள்"},{"key":"D","text":"ஆரியர்கள்"}],"explanation":"கிரேக்க மற்றும் உரோமானிய வணிகர்களைப் பழந்தமிழர் 'யவனர்கள்' என்று அழைத்தனர்."}}}
{"id":"pyq-tam-7t3-020","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":44},"texts":{"ta":{"blocks":[{"type":"text","text":"தாமிரபரணி ஆற்றின் மேற்குக் கரையில் திருநெல்வேலியும் கிழக்குக் கரையில் பாளையங்கோட்டையும் அமைந்துள்ளன. இவ்விரு நகரங்களும் எவ்வாறு அழைக்கப்படுகின்றன?"}],"options":[{"key":"A","text":"இணை நகரங்கள்"},{"key":"B","text":"இரட்டை நகரங்கள்"},{"key":"C","text":"துறைமுக நகரங்கள்"},{"key":"D","text":"கோட்டை நகரங்கள்"}],"explanation":"திருநெல்வேலியும் பாளையங்கோட்டையும் 'இரட்டை நகரங்கள்' என அழைக்கப்படுகின்றன."}}}
{"id":"pyq-tam-7t3-021","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":37},"texts":{"ta":{"blocks":[{"type":"text","text":"அதிக எண்ணிக்கையிலான கல்வி நிலையங்கள் அமைந்துள்ளதால் ‘தென்னிந்தியாவின் ஆக்ஸ்போர்டு’ என்று அழைக்கப்படும் நகரம் எது?"}],"options":[{"key":"A","text":"மதுரை"},{"key":"B","text":"பாளையங்கோட்டை"},{"key":"C","text":"திருநெல்வேலி"},{"key":"D","text":"திருச்சி"}],"explanation":"பாளையங்கோட்டையில் அதிக கல்வி நிலையங்கள் இருப்பதால் அந்நகரைத் 'தென்னிந்தியாவின் ஆக்ஸ்போர்டு' என்பர்."}}}
{"id":"b-tam-7t3-022","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"நெல்லை மாநகரில் ‘அக்கசாலைத் தெரு’ என்று வழங்கப்படும் பகுதி எதனால் அப்பெயர் பெற்றது?"}],"options":[{"key":"A","text":"சிறைச்சாலை இருந்த இடம்"},{"key":"B","text":"அணிகலன்களும் பொற்காசுகளும் உருவாக்கும் பணியாளர்கள் வாழ்ந்த பகுதி"},{"key":"C","text":"தானியங்களை விற்பனை செய்த கடை"},{"key":"D","text":"பட்டு நெசவு செய்த பகுதி"}],"explanation":"அக்கசாலை என்பது அணிகலன்களும் பொன் நாணயங்களும் உருவாக்கும் இடமாகும்."}}}
{"id":"b-tam-7t3-023","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘காவற்புரைத் தெரு’ மற்றும் ‘கூழைக்கடைத் தெரு’ ஆகியவற்றின் உண்மைப் பெயர்ப் பின்னணி யாது?"}],"options":[{"key":"A","text":"காவல் நிலையம், கஞ்சி விற்ற கடை"},{"key":"B","text":"சிறைச்சாலை (காவற்புரை), தானியக் கடை (கூலக்கடைத்தெரு)"},{"key":"C","text":"கோட்டை வாசல், துணிக்கடை"},{"key":"D","text":"அரண்மனை வாயில், கறிக்கடை"}],"explanation":"காவற்புரை என்றால் சிறைச்சாலை; கூலம் என்பது தானியத்தைக் குறிக்கும்; கூலக்கடைத்தெருவே மருவிக் கூழைக்கடைத் தெருவானது."}}}
{"id":"b-tam-7t3-024","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 7"},"texts":{"ta":{"blocks":[{"type":"text","text":"பாண்டிய மன்னன் நின்றசீர் நெடுமாறனை நெல்லை மக்கள் வரவேற்ற இடம் ‘பாண்டியபுரம்’ எனில், அவன் தேவி மங்கையர்க்கரசியை மகளிர் வரவேற்ற இடம் எது?"}],"options":[{"key":"A","text":"மீனாட்சிபுரம்"},{"key":"B","text":"திருமங்கை நகர்"},{"key":"C","text":"சேரன்மாதேவி"},{"key":"D","text":"குலசேகரன்பட்டினம்"}],"explanation":"மங்கையர்க்கரசியை மகளிர் எதிர்கொண்டு வரவேற்ற இடம் 'திருமங்கை நகர்' என வழங்கப்படுகிறது."}}}
{"id":"b-tam-7t3-025","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 7"},"texts":{"ta":{"blocks":[{"type":"text","text":"நாயக்க மன்னரின் தளவாயாக விளங்கிய அரியநாதரின் வழித்தோன்றலான வீரராகவர் மற்றும் அவரது துணைவியார் மீனாட்சி அம்மையார் பெயரில் அமைந்த ஊர்கள் எவை?"}],"options":[{"key":"A","text":"பாண்டியபுரம், திருமங்கை நகர்"},{"key":"B","text":"வீரராகவபுரம், மீனாட்சிபுரம்"},{"key":"C","text":"செங்கோட்டை, உக்கிரன்கோட்டை"},{"key":"D","text":"கங்கைகொண்டான், குலசேகரன் பட்டினம்"}],"explanation":"வீரராகவர் பெயரில் வீரராகவபுரமும், துணைவியார் பெயரில் மீனாட்சிபுரமும் உருவாயின."}}}
{"id":"b-tam-7t3-026","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 7"},"texts":{"ta":{"blocks":[{"type":"text","text":"திருநெல்வேலி மாவட்ட நிர்வாகப் பிரிவுகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"1790 செப்டம்பர் 1-இல் கிழக்கிந்தியக் கம்பெனியால் திருநெல்வேலி மாவட்டம் உருவாக்கப்பட்டது."},{"type":"statement","label":"II","text":"1986-இல் திருநெல்வேலி மாவட்டத்தைப் பிரித்துத் தூத்துக்குடி மாவட்டம் உருவாக்கப்பட்டது."},{"type":"statement","label":"III","text":"2019-இல் திருநெல்வேலி மாவட்டத்திலிருந்து தென்காசி தனி மாவட்டமாகப் பிரிக்கப்பட்டது."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"பாடநூல் பக்கம் 7 தெரிந்து தெளிவோம் குறிப்பின்படி மூன்று வரலாற்றுப் பிரிவுகளும் முற்றிலும் சரியானவை."}}}
{"id":"b-tam-7t3-027","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 8"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘திக்கெல்லாம் புகழுறும் திருநெல்வேலி’ பாட மதிப்பீட்டுப் பொருத்துகவைச் சரியாக இணைக்க:"},{"type":"list","name":"பட்டியல் I","items":[{"label":"A","text":"தண்பொருநை"},{"label":"B","text":"அக்கசாலை"},{"label":"C","text":"கொற்கை"},{"label":"D","text":"திரிகூடமலை"}]},{"type":"list","name":"பட்டியல் II","items":[{"label":"1","text":"பொன்நாணயங்கள் உருவாக்கும் இடம்"},{"label":"2","text":"குற்றாலம்"},{"label":"3","text":"தாமிரபரணி"},{"label":"4","text":"முத்துக்குளித்தல்"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}}],"explanation":"தண்பொருநை = தாமிரபரணி; அக்கசாலை = பொன்நாணயங்கள் தயாரிக்கும் இடம்; கொற்கை = முத்துக்குளித்தல்; திரிகூடமலை = குற்றாலம்."}}}
{"id":"b-tam-7t3-028","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 8"},"texts":{"ta":{"blocks":[{"type":"text","text":"திருநெல்வேலி எந்த மன்னர்களோடு தொடர்புடைய வரலாற்றுத் தலைநகரமாகும்?"}],"options":[{"key":"A","text":"சேர மன்னர்கள்"},{"key":"B","text":"சோழ மன்னர்கள்"},{"key":"C","text":"பாண்டிய மன்னர்கள்"},{"key":"D","text":"பல்லவ மன்னர்கள்"}],"explanation":"பாடநூல் மதிப்பீட்டு வினா: திருநெல்வேலி பாண்டிய மன்னர்களோடு தொடர்புடையது."}}}
{"id":"b-tam-7t3-029","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 8"},"texts":{"ta":{"blocks":[{"type":"text","text":"இளங்கோவடிகள் எந்த மலைக்கு முதன்மை கொடுத்துப் பாடினார்?"}],"options":[{"key":"A","text":"இமய மலை"},{"key":"B","text":"கொல்லி மலை"},{"key":"C","text":"பொதிகை மலை"},{"key":"D","text":"விந்திய மலை"}],"explanation":"'பொதியிலாயினும் இமயமாயினும்' என இளங்கோவடிகள் பொதிகை மலைக்கு முதன்மை தந்தார்."}}}
{"id":"b-tam-7t3-030","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 8"},"texts":{"ta":{"blocks":[{"type":"text","text":"திருநெல்வேலி எந்த ஆற்றின் கரையில் அமைந்துள்ளது?"}],"options":[{"key":"A","text":"காவிரி"},{"key":"B","text":"வைகை"},{"key":"C","text":"தென்பெண்ணை"},{"key":"D","text":"தாமிரபரணி"}],"explanation":"திருநெல்வேலி மாநகரம் தாமிரபரணி (தண்பொருநை) ஆற்றின் கரையில் அமைந்துள்ளது."}}}
{"id":"b-tam-7t3-070","kind":"assertion_reason","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 5"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"இளங்கோவடிகள் சிலப்பதிகாரத்தில் பொதிகை மலைக்கு முதன்மை கொடுத்துப் பாடியுள்ளார்."},{"type":"reason","text":"தென்னாட்டிலுள்ள பொதிகை மலை முற்காலம் தொட்டே அகத்திய முனிவர் வாழ்ந்த பெருமைமிக்கத் தமிழின் தொன்மையான மலையாகப் போற்றப்பட்டது."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"'பொதியிலாயினும் இமயமாயினும்' என வடநாட்டு இமயத்திற்கு முன்பாகத் தென்னகப் பொதிகையை முன்னிறுத்திப் பாடியுள்ளார்; கூற்றும் காரணமும் சரி."}}}
