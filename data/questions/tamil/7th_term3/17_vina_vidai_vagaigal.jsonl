// 7-ஆம் வகுப்பு தமிழ் - பருவம் 3 - இயல் 3 - பாடம் 17: வினா, விடை வகைகள் (கற்கண்டு - இலக்கணம்)
// வினாக்கள் எண்ணிக்கை: 5
// ==============================================================================
{"id":"b-tam-7t3-138","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 59"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ் மொழியில் கேள்விகள் கேட்கும் முறையான ‘வினா’ எத்தனை வகைப்படும்?"}],"options":[{"key":"A","text":"நான்கு வகைப்படும்"},{"key":"B","text":"ஆறு வகைப்படும் (அறிவினா, அறியா வினா, ஐயவினா, கொளல் வினா, கொடை வினா, ஏவல் வினா)"},{"key":"C","text":"எட்டு வகைப்படும்"},{"key":"D","text":"பத்து வகைப்படும்"}],"explanation":"வினா ஆறு வகைப்படும்."}}}
{"id":"b-tam-7t3-139","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"4","C":"1","D":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 59"},"texts":{"ta":{"blocks":[{"type":"text","text":"வினா வகைகளையும் அவற்றுக்குரிய சான்றுகளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"வினா வகை","items":[{"label":"A","text":"அறிவினா"},{"label":"B","text":"அறியா வினா"},{"label":"C","text":"ஐய வினா"},{"label":"D","text":"கொளல் வினா"}]},{"type":"list","name":"சான்று","items":[{"label":"1","text":"இச்செயலைச் செய்தது மங்கையா? மணிமேகலையா?"},{"label":"2","text":"ஜெயகாந்தன் சிறுகதைகள் இருக்கிறதா?"},{"label":"3","text":"மாணவரிடம் 'இந்தக் கவிதையின் பொருள் யாது?' என ஆசிரியர் கேட்பது"},{"label":"4","text":"ஆசிரியரிடம் 'இந்தக் கவிதையின் பொருள் யாது?' என மாணவர் கேட்பது"}]}],"options":[{"key":"A","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"D","text":"A-4, B-3, C-2, D-1","mapping":{"A":"4","B":"3","C":"2","D":"1"}}],"explanation":"அறிவினா = ஆசிரியர் மாணவரிடம் கேட்பது; அறியா வினா = மாணவர் ஆசிரியரிடம் கேட்பது; ஐய வினா = தெளிவு பெறக் கேட்பது; கொளல் வினா = பொருள் வாங்கக் கேட்பது."}}}
{"id":"b-tam-7t3-140","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 59"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழில் வினாவிற்கு விடையளிக்கும் முறைகள் எத்தனை வகையாகப் பிரிக்கப்பட்டுள்ளன?"}],"options":[{"key":"A","text":"ஆறு வகைகள்"},{"key":"B","text":"எட்டு வகைகள் (சுட்டு, மறை, நேர், ஏவல், வினா எதிர் வினாதல், உற்றது உரைத்தல், உறுவது கூறல், இனமொழி)"},{"key":"C","text":"பத்து வகைகள்"},{"key":"D","text":"நான்கு வகைகள்"}],"explanation":"விடை எட்டு வகைப்படும்; முதல் 3 வெளிப்படை விடைகள், அடுத்த 5 குறிப்பு விடைகள் ஆகும்."}}}
{"id":"b-tam-7t3-141","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"4","C":"1","D":"3"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 60"},"texts":{"ta":{"blocks":[{"type":"text","text":"விடை வகைகளையும் அவற்றுக்குரிய சான்றுகளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"விடை வகை","items":[{"label":"A","text":"மறை விடை"},{"label":"B","text":"ஏவல் விடை"},{"label":"C","text":"உற்றது உரைத்தல் விடை"},{"label":"D","text":"இனமொழி விடை"}]},{"type":"list","name":"சான்று","items":[{"label":"1","text":"‘நீ விளையாடவில்லையா?’ என்ற வினாவிற்கு ‘கால் வலிக்கிறது’ என நேர்ந்ததைக் கூறுவது"},{"label":"2","text":"‘கடைக்குப் போவாயா?’ என்ற கேள்விக்குப் ‘போகமாட்டேன்’ என மறுத்துக் கூறுவது"},{"label":"3","text":"‘உனக்குக் கதை எழுதத் தெரியுமா?’ என்ற வினாவிற்குக் ‘கட்டுரை எழுதத் தெரியும்’ என இணை கூறுவது"},{"label":"4","text":"‘இந்த வேலையைச் செய்வாயா?’ என்று கேட்டால் ‘நீயே செய்’ என ஏவிக் கூறுவது"}]}],"options":[{"key":"A","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"D","text":"A-4, B-3, C-2, D-1","mapping":{"A":"4","B":"3","C":"2","D":"1"}}],"explanation":"மறை விடை = மறுத்துக் கூறுவது; ஏவல் விடை = ஏவிக்கூறுவது; உற்றது உரைத்தல் = நேர்ந்ததைக் கூறுவது; இனமொழி விடை = இணையான மற்றொன்றைக் கூறுவது."}}}
{"id":"b-tam-7t3-142","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 61"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மட்டைப்பந்து விளையாடத் தெரியுமா?’ என்னும் வினாவிற்குக் ‘கால்பந்து விளையாடத் தெரியும்’ என்று விடையளிப்பது எவ்வகை விடை?"}],"options":[{"key":"A","text":"மறைவிடை"},{"key":"B","text":"இனமொழி விடை"},{"key":"C","text":"உற்றது உரைத்தல் விடை"},{"key":"D","text":"நேர்விடை"}],"explanation":"வினாவிற்கு விடையாக அதற்கு இனமான மற்றொன்றைக் கூறுவது 'இனமொழி விடை' எனப்படும்."}}}
