// 7-ஆம் வகுப்பு தமிழ் - பருவம் 3 - இயல் 1 - பாடம் 1: விருந்தோம்பல் (கவிதைப்பேழை - முன்றுறை அரையனார், பழமொழி நானூறு)
// வினாக்கள் எண்ணிக்கை: 8
// ==============================================================================
{"id":"b-tam-7t3-001","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மாரியொன்று இன்றி வறந்திருந்த காலத்தும் பாரி மடமகள் பாண்மகற்கு நீர்உலையுள் பொன்திறந்து கொண்டு புகாவாக நல்கினாள் ஒன்றுறா முன்றிலோ இல்’ - என்ற விருந்தோம்பல் பாடலை இயற்றியவர் யார்?"}],"options":[{"key":"A","text":"காரியாசான்"},{"key":"B","text":"முன்றுறை அரையனார்"},{"key":"C","text":"கபிலர்"},{"key":"D","text":"கணிமேதாவியார்"}],"explanation":"பழமொழி நானூறு நூலில் இடம்பெற்றுள்ள இப்பாடலை இயற்றியவர் முன்றுறை அரையனார் ஆவார்."}}}
{"id":"b-tam-7t3-002","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"4","C":"1","D":"3"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘விருந்தோம்பல்’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"மாரி"},{"label":"B","text":"புகாவாக"},{"label":"C","text":"மடமகள்"},{"label":"D","text":"முன்றில்"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"இளமகள்"},{"label":"2","text":"மழை"},{"label":"3","text":"வீட்டின் முன் இடம் (திண்ணை / வீடு)"},{"label":"4","text":"உணவாக"}]}],"options":[{"key":"A","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"D","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}}],"explanation":"மாரி = மழை; புகாவாக = உணவாக; மடமகள் = இளமகள்; நல்கினாள் = கொடுத்தாள்; முன்றில் = வீட்டின் முன் இடம் (திண்ணை), இங்கு வீட்டைக் குறிக்கிறது."}}}
{"id":"b-tam-7t3-003","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஒன்றுறா முன்றிலோ இல்’ என்னும் பழமொழியின் சரியான பொருள் யாது?"}],"options":[{"key":"A","text":"திண்ணை இல்லாத வீடே இல்லை"},{"key":"B","text":"பொருள் ஏதும் இல்லாத வீடு எதுவும் இல்லை"},{"key":"C","text":"விருந்தினர் வராத வீடே இல்லை"},{"key":"D","text":"மழை இல்லாத நாடே இல்லை"}],"explanation":"'ஒன்றுறா முன்றிலோ இல்' என்றால் பொருள் ஏதும் இல்லாத வீடே இல்லை என்பது பொருளாகும்."}}}
{"id":"b-tam-7t3-004","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"text","text":"மழையின்றி வறட்சி நிலவிய காலத்தும் பாணர்களுக்கு உலைநீரில் பொன் இட்டு உணவு போலத் தந்து விருந்தோம்பிய பாரியின் புதல்வியர் யார்?"}],"options":[{"key":"A","text":"வெள்ளிவீதியார், ஒளவையார்"},{"key":"B","text":"அங்கவை, சங்கவை"},{"key":"C","text":"மாதவி, மணிமேகலை"},{"key":"D","text":"குணமாலை, சுரமஞ்சரி"}],"explanation":"வள்ளல் பாரியின் மகளிரான அங்கவை, சங்கவை ஆகியோரிடம் பாணர்கள் இரந்து நின்றபோது உலைநீரில் பொன்னிட்டுத் தந்தனர்."}}}
{"id":"b-tam-7t3-005","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 3"},"texts":{"ta":{"blocks":[{"type":"text","text":"பழமொழி நானூறு நூல் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"இந்நூலின் ஆசிரியர் முன்றுறை அரையனார் ஆவார்; இவர் பொ.ஆ. (கி.பி.) நான்காம் நூற்றாண்டைச் சேர்ந்தவர்."},{"type":"statement","label":"II","text":"கடவுள் வாழ்த்துப் பாடல் மூலம் இவர் சமண சமயத்தைச் சேர்ந்தவர் என அறியமுடிகிறது."},{"type":"statement","label":"III","text":"இந்நூல் பதினெண்கீழ்க்கணக்கு நூல்களுள் ஒன்று; ஒவ்வொரு பாடலின் இறுதியிலும் ஒரு பழமொழி இடம்பெற்றிருக்கும்."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"நூல் வெளிப் பகுதியின்படி முன்றுறை அரையனார் மற்றும் பழமொழி நானூறு பற்றிய மூன்று கூற்றுகளும் முற்றிலும் சரியானவை."}}}
{"id":"b-tam-7t3-006","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 3"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மரம் வளர்த்தால் ________ பெறலாம்’ - பாடநூல் மதிப்பீட்டு விடையைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"மாறி"},{"key":"B","text":"மாரி (மழை)"},{"key":"C","text":"காரி"},{"key":"D","text":"பாரி"}],"explanation":"மாரி என்றால் மழை என்று பொருள்; மரம் வளர்த்தால் மாரி பெறலாம்."}}}
{"id":"b-tam-7t3-007","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 3"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நீருலையில்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"நீரு + உலையில்"},{"key":"B","text":"நீர் + இலையில்"},{"key":"C","text":"நீர் + உலையில்"},{"key":"D","text":"நீரு + இலையில்"}],"explanation":"நீர் + உலையில் = உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி ர் + உ = ரு ஆகி 'நீருலையில்' எனப் புணரும்."}}}
{"id":"b-tam-7t3-008","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 3"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மாரி + ஒன்று’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"மாரியொன்று"},{"key":"B","text":"மாரிஒன்று"},{"key":"C","text":"மாரியின்று"},{"key":"D","text":"மாரியன்று"}],"explanation":"'இ ஈ ஐ வழி யவ்வும்' விதிப்படி உடம்படுமெய் ய் தோன்றி (ய் + ஒ = யொ), 'மாரியொன்று' எனப் புணரும்."}}}
