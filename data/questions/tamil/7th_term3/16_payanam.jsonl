// 7-ஆம் வகுப்பு தமிழ் - பருவம் 3 - இயல் 3 - பாடம் 16: பயணம் (விரிவானம் / துணைப்பாடம் - பாவண்ணன்)
// வினாக்கள் எண்ணிக்கை: 2
// ==============================================================================
{"id":"b-tam-7t3-136","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 55"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பயணம்’ என்னும் சிறுகதையின் ஆசிரியர் பாவண்ணன் எழுதிய பிற நூல்களுள் பொருந்தாத ஒன்றைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"வேர்கள் தொலைவில் இருக்கின்றன, நேற்று வாழ்ந்தவர்கள்"},{"key":"B","text":"ஆகாயத்துக்கு அடுத்த வீடு"},{"key":"C","text":"கடலோர வீடு, பாய்மரக்கப்பல்"},{"key":"D","text":"மீசைக்கார பூனை, பிரயாணம்"}],"explanation":"'ஆகாயத்துக்கு அடுத்த வீடு' மு. மேத்தாவின் நூல்; மற்றவை பாவண்ணனின் படைப்புகளாகும்."}}}
{"id":"b-tam-7t3-137","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 55"},"texts":{"ta":{"blocks":[{"type":"text","text":"கன்னட மொழியிலிருந்து பல நூல்களைத் தமிழில் மொழிபெயர்த்தவரும், ‘பிரயாணம்’ நூலின் ஆசிரியருமான எழுத்தாளர் யார்?"}],"options":[{"key":"A","text":"எஸ். ராமகிருஷ்ணன்"},{"key":"B","text":"பாவண்ணன்"},{"key":"C","text":"நாஞ்சில் நாடன்"},{"key":"D","text":"அழகிய பெரியவன்"}],"explanation":"சிறுகதை, கவிதை, மொழிபெயர்ப்பு எனப் பல்வேறு தளங்களில் இயங்கிவரும் பாவண்ணன் எழுதிய 'பிரயாணம்' நூலிலிருந்து 'பயணம்' கதை எடுக்கப்பட்டுள்ளது."}}}
