// 7-ஆம் வகுப்பு தமிழ் - பருவம் 3 - இயல் 1 - பாடம் 3: திருநெல்வேலிச் சீமையும் கவிகளும் (விரிவானம் / துணைப்பாடம் - டி.கே.சி.)
// வினாக்கள் எண்ணிக்கை: 13
// ==============================================================================
{"id":"b-tam-7t3-031","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 10"},"texts":{"ta":{"blocks":[{"type":"text","text":"பாரதியாரின் பிறப்பிடமாகிய எட்டையபுரத்தில் சுமார் இருநூறு ஆண்டுகளுக்கு முன் வாழ்ந்து, வெங்கடேசுர எட்டப்ப ராஜாவைப் பற்றிப் பாடிய அரசவைப் புலவர் யார்?"}],"options":[{"key":"A","text":"அண்ணாமலையார்"},{"key":"B","text":"அழகிய சொக்கநாதர்"},{"key":"C","text":"கடிகைமுத்துப் புலவர்"},{"key":"D","text":"நமசிவாயப் புலவர்"}],"explanation":"சுமார் இருநூறு ஆண்டுகளுக்கு முன் எட்டையபுரத்தில் வாழ்ந்தவர் கடிகைமுத்துப் புலவர் ஆவார்."}}}
{"id":"b-tam-7t3-032","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 10"},"texts":{"ta":{"blocks":[{"type":"text","text":"தாமிரபரணி நதியும் சிற்றாறும் கலக்கின்ற ‘சீவலப்பேரி’ என்னும் முக்கூடலைப் பற்றி எழுந்த புகழ்பெற்ற சிற்றிலக்கிய நூல் எது?"}],"options":[{"key":"A","text":"குற்றாலக் குறவஞ்சி"},{"key":"B","text":"முக்கூடல் பள்ளு"},{"key":"C","text":"காவடிச்சிந்து"},{"key":"D","text":"திருக்கருவை அந்தாதி"}],"explanation":"தாமிரபரணியும் சிற்றாறும் கூடும் முக்கூடலைப் (சீவலப்பேரி) பற்றிப் பாடப்பட்ட உழவர் பிரபந்தம் முக்கூடல் பள்ளு ஆகும்."}}}
{"id":"b-tam-7t3-033","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 10"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஆற்று வெள்ளம் நாளை வரத் தோற்றுதே குறி - மலையாள மின்னல் ஈழ மின்னல் சூழ மின்னுதே!’ - இவ்வடிகள் இடம்பெற்றுள்ள நூல் எது?"}],"options":[{"key":"A","text":"குற்றாலக் குறவஞ்சி"},{"key":"B","text":"முக்கூடல் பள்ளு"},{"key":"C","text":"பழமொழி நானூறு"},{"key":"D","text":"திருக்கருவை பதிற்றுப்பத்தந்தாதி"}],"explanation":"குடியானவர்களுக்கு மழைக் குறியைக் காட்டும் இப்பாடல் முக்கூடல் பள்ளுவில் இடம்பெற்றுள்ளது."}}}
{"id":"b-tam-7t3-034","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 10"},"texts":{"ta":{"blocks":[{"type":"text","text":"சுமார் முந்நூறு ஆண்டுகளுக்கு முன் நெல்லையப்பர் கோவிலில் எழுந்தருளியுள்ள காந்திமதித் தாயிடம் சுவாமிக்குச் சிபாரிசு செய்யுமாறு பாடிய மதுரைப் புலவர் யார்?"}],"options":[{"key":"A","text":"அழகிய சொக்கநாதர்"},{"key":"B","text":"பலபட்டடைச் சொக்கநாதப் புலவர்"},{"key":"C","text":"முன்றுறை அரையனார்"},{"key":"D","text":"திரிகூடராசப்பக் கவிராயர்"}],"explanation":"காந்திமதித் தாயிடம் உரிமை பாராட்டிச் சிபாரிசு செய்யுமாறு பாடியவர் பலபட்டடைச் சொக்கநாதப் புலவர்."}}}
{"id":"pyq-tam-7t3-035","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2018,"paper":"tamil","no":71},"texts":{"ta":{"blocks":[{"type":"text","text":"நம்மாழ்வாரின் அவதாரத் தலமான ‘ஆழ்வார்திருநகரி’க்கு முற்காலத்தில் வழங்கிய பூர்வப் பெயர் யாது?"}],"options":[{"key":"A","text":"சீவலப்பேரி"},{"key":"B","text":"திருக்குருகூர்"},{"key":"C","text":"சீவைகுண்டம்"},{"key":"D","text":"கரிவலம்வந்தநல்லூர்"}],"explanation":"நம்மாழ்வார் பிறந்த ஆழ்வார்திருநகரிக்குப் பூர்வத்தில் 'திருக்குருகூர்' என்று பெயர்; இவர் ஆயிரம் தமிழ்ப்பாடல்களால் திருவாய்மொழியை அருளினார்."}}}
{"id":"b-tam-7t3-036","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 10"},"texts":{"ta":{"blocks":[{"type":"text","text":"காயல்பட்டணத்தில் வாழ்ந்த வள்ளல் சீதக்காதி இறந்தபோது, ‘சீமான் இறந்திட்ட போதே புலமையும் செத்ததுவே!’ என்று ஆற்றாமையோடு பாடிய புலவர் யார்?"}],"options":[{"key":"A","text":"உமறுப்புலவர்"},{"key":"B","text":"நமசிவாயப் புலவர்"},{"key":"C","text":"கடிகைமுத்துப் புலவர்"},{"key":"D","text":"பலபட்டடைச் சொக்கநாதர்"}],"explanation":"கொடைவள்ளல் சீதக்காதி மறைந்தபோது நெஞ்சம் வெம்பிப் பாடியவர் நமசிவாயப் புலவர் ஆவார்."}}}
{"id":"pyq-tam-7t3-037","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":51},"texts":{"ta":{"blocks":[{"type":"text","text":"கழுகுமலை முருகன் மீது பாடப்பட்ட ‘காவடிச்சிந்து’ பாடல்களை இயற்றிய கவிஞர் யார்?"}],"options":[{"key":"A","text":"அழகிய சொக்கநாதர்"},{"key":"B","text":"அண்ணாமலையார்"},{"key":"C","text":"அருணகிரிநாதர்"},{"key":"D","text":"கடிகைமுத்துப் புலவர்"}],"explanation":"கழுகுமலை முருகன் மீது காவடிச்சிந்து பாடியவர் சென்னிக்குளம் அண்ணாமலையார் ஆவார்."}}}
{"id":"b-tam-7t3-038","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 11"},"texts":{"ta":{"blocks":[{"type":"text","text":"சங்கரன்கோவில் கோமதித் தாய் மீது ‘வாடா என அழைத்து வாழ்வித்தால் அம்ம உனைக் கூடாதென்றார் தடுப்பார் கோமதித்தாய் ஈஸ்வரியே!’ என்று பாடியவர் யார்?"}],"options":[{"key":"A","text":"பலபட்டடைச் சொக்கநாதர்"},{"key":"B","text":"திருநெல்வேலி அழகிய சொக்கநாதர்"},{"key":"C","text":"முன்றுறை அரையனார்"},{"key":"D","text":"குமரகுருபரர்"}],"explanation":"கோமதித் தாய் மீது அழகிய பக்திப் பாடல்களைப் பாடியவர் திருநெல்வேலி அழகிய சொக்கநாதர் ஆவார்."}}}
{"id":"b-tam-7t3-039","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 11"},"texts":{"ta":{"blocks":[{"type":"text","text":"கருவைநல்லூர் (கரிவலம்வந்தநல்லூர்) தலத்தின் சிறப்பில் தோய்ந்து ‘திருக்கருவை வெண்பா அந்தாதி, பதிற்றுப்பத்தந்தாதி, கலித்துறை அந்தாதி’ என்னும் குட்டித் திருவாசக நூல்களைப் பாடியவர் யார்?"}],"options":[{"key":"A","text":"அழகிய சொக்கநாதர்"},{"key":"B","text":"அதிவீரராம பாண்டியர் (புலவர் ஒருவர்)"},{"key":"C","text":"திரிகூடராசப்பக் கவிராயர்"},{"key":"D","text":"முன்றுறை அரையனார்"}],"explanation":"கருவை அந்தாதிகளைப் பாடியவர் பாண்டிய மன்னர் அதிவீரராம பாண்டியர் ஆவார் (பாடநூல்: 'சிறப்பில் தோய்ந்த புலவர் ஒருவர்')."}}}
{"id":"b-tam-7t3-040","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 11"},"texts":{"ta":{"blocks":[{"type":"text","text":"சுமார் ஆயிரத்து முந்நூறு ஆண்டுகளுக்கு முன் குற்றாலத்திற்கு வருகை தந்து ‘நுண்துளி தூங்கும் குற்றாலம்’ என்று பாடியவர் யார்?"}],"options":[{"key":"A","text":"அப்பர்"},{"key":"B","text":"மாணிக்கவாசகர்"},{"key":"C","text":"திருஞானசம்பந்தர்"},{"key":"D","text":"சுந்தரர்"}],"explanation":"'நுண்துளி தூங்கும் குற்றாலம்' என்று திருஞானசம்பந்தர் தேவாரம் பாடியுள்ளார்."}}}
{"id":"pyq-tam-7t3-041","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":8},"texts":{"ta":{"blocks":[{"type":"text","text":"குற்றாலத்துக்குக் கிழக்கே இரண்டு மைலில் உள்ள மேலகரத்தில் வாழ்ந்து ‘குற்றாலக் குறவஞ்சி’ என்னும் ஒப்பற்ற நூலைப் பாடியவர் யார்?"}],"options":[{"key":"A","text":"அழகிய சொக்கநாதர்"},{"key":"B","text":"திரிகூடராசப்பக் கவிராயர்"},{"key":"C","text":"கடிகைமுத்துப் புலவர்"},{"key":"D","text":"நமசிவாயப் புலவர்"}],"explanation":"மேலகரத்தில் வாழ்ந்த திரிகூடராசப்பக் கவிராயர் குற்றாலக் குறவஞ்சியைப் பாடினார்."}}}
{"id":"pyq-tam-7t3-042","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":11},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ரசிகமணி’ என்று சிறப்பிக்கப்பட்டவரும், தமது இல்லத்தில் ‘வட்டத்தொட்டி’ என்னும் பெயரில் இலக்கியக் கூட்டங்கள் நடத்தியவருமான அறிஞர் யார்?"}],"options":[{"key":"A","text":"வ.உ.சி."},{"key":"B","text":"டி.கே. சிதம்பரநாதர் (டி.கே.சி.)"},{"key":"C","text":"ரா.பி. சேதுப்பிள்ளை"},{"key":"D","text":"திரு.வி.க."}],"explanation":"டி.கே.சி. 'ரசிகமணி' என்றும், கடித இலக்கிய முன்னோடி என்றும், தமிழிசைக் காவலர் என்றும் புகழப்படுகிறார்."}}}
{"id":"b-tam-7t3-043","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 12"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘திருநெல்வேலிச் சீமையும் கவிகளும்’ என்னும் பாடப்பகுதி டி.கே.சி. அவர்களின் எந்த நூலிலிருந்து எடுக்கப்பட்டுள்ளது?"}],"options":[{"key":"A","text":"வட்டத்தொட்டி"},{"key":"B","text":"இதய ஒலி"},{"key":"C","text":"கம்பர் யார்"},{"key":"D","text":"முத்தொள்ளாயிர உரை"}],"explanation":"இக்கட்டுரை டி.கே.சி. அவர்களின் 'இதய ஒலி' என்னும் நூலிலிருந்து எடுத்துத் தரப்பட்டுள்ளது."}}}
