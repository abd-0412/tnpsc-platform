// 7-ஆம் வகுப்பு தமிழ் - பருவம் 3 - இயல் 3 - பாடம் 14: தன்னை அறிதல் (கவிதைப்பேழை - சே. பிருந்தா)
// வினாக்கள் எண்ணிக்கை: 4
// ==============================================================================
{"id":"b-tam-7t3-122","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 49"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அன்றைக்குத்தான் அம்மா காக்காவிற்கு அது குயில் குஞ்சு என்று தெரிந்தது...’ - என்னும் தன்நம்பிக்கைக் கவிதையான ‘தன்னை அறிதல்’ பாடலை இயற்றியவர் யார்?"}],"options":[{"key":"A","text":"தாமரை"},{"key":"B","text":"சே. பிருந்தா"},{"key":"C","text":"வெண்ணிலா"},{"key":"D","text":"குட்டி ரேவதி"}],"explanation":"குயில்குஞ்சின் தன்நம்பிக்கைக் கதையைப் பாடிய பெண் கவிஞர் சே. பிருந்தா ஆவார்."}}}
{"id":"b-tam-7t3-123","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 50"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கூடு கட்டத் தெரியாத’ பறவை இனமாகக் கவிதையில் குறிப்பிடப்படுவது எது?"}],"options":[{"key":"A","text":"காக்கை"},{"key":"B","text":"குயில்"},{"key":"C","text":"சிட்டுக்குருவி"},{"key":"D","text":"மைனா"}],"explanation":"குயில் தன் முட்டைகளைக் காக்கையின் கூட்டில் இடுவதால் அதற்குத் தனியாகக் கூடு கட்டத் தெரியாது."}}}
{"id":"b-tam-7t3-124","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 50"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தானொரு’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"தா + ஒரு"},{"key":"B","text":"தான் + னொரு"},{"key":"C","text":"தான் + ஒரு"},{"key":"D","text":"தானே + ஒரு"}],"explanation":"தான் + ஒரு = உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி ன் + ஒ = னொ ஆகி 'தானொரு' எனப் புணரும்."}}}
{"id":"b-tam-7t3-125","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 3, பக்கம் 50"},"texts":{"ta":{"blocks":[{"type":"text","text":"கவிஞர் சே. பிருந்தா குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"இவர் புகழ்பெற்ற பெண்கவிஞர்களுள் ஒருவர் ஆவார்."},{"type":"statement","label":"II","text":"மழை பற்றிய பகிர்தல்கள், வீடு முழுக்க வானம், மகளுக்குச் சொன்ன கதை ஆகிய கவிதை நூல்களை எழுதியுள்ளார்."},{"type":"statement","label":"III","text":"பாடப்பகுதியில் இடம்பெற்றுள்ள ‘தன்னை அறிதல்’ கவிதை ‘மகளுக்குச் சொன்ன கதை’ நூலிலிருந்து எடுக்கப்பட்டுள்ளது."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"நூல் வெளிப் பகுதியின்படி கவிஞர் சே. பிருந்தா பற்றிய மூன்று கூற்றுகளும் முற்றிலும் சரியானவை."}}}
