{"id":"b-tam-6t3-081","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 26"},"texts":{"ta":{"blocks":[{"type":"text","text":"அமெரிக்காவில் பூஜேசவுண்ட் என்னுமிடத்தைச் சுற்றி வாழ்ந்த பழங்குடியினர் யார்?"}],"options":[{"key":"A","text":"இன்கா பழங்குடியினர்"},{"key":"B","text":"சுகுவாமிஷ் பழங்குடியினர்"},{"key":"C","text":"மாயன் பழங்குடியினர்"},{"key":"D","text":"செரோகி பழங்குடியினர்"}],"explanation":"அமெரிக்காவில் பூஜேசவுண்ட் என்னுமிடத்தைச் சுற்றி வாழ்ந்தவர்கள் சுகுவாமிஷ் பழங்குடியினர் ஆவர்."}}}
{"id":"b-tam-6t3-082","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 26"},"texts":{"ta":{"blocks":[{"type":"text","text":"சுகுவாமிஷ் பழங்குடியினரின் தலைவராக விளங்கியவர் யார்?"}],"options":[{"key":"A","text":"வாஷிங்டன்"},{"key":"B","text":"லிங்கன்"},{"key":"C","text":"சியாட்டல்"},{"key":"D","text":"கென்னடி"}],"explanation":"சுகுவாமிஷ் பழங்குடியினரின் தலைவராக விளங்கியவர் சியாட்டல் ஆவார்."}}}
{"id":"b-tam-6t3-083","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 26"},"texts":{"ta":{"blocks":[{"type":"text","text":"செவ்விந்தியர்கள் இந்நிலத்தை எவ்வாறாகக் கருதி மதிக்கின்றனர்?"}],"options":[{"key":"A","text":"தாயாக"},{"key":"B","text":"தந்தையாக"},{"key":"C","text":"பகைவராக"},{"key":"D","text":"வணிகப் பொருளாக"}],"explanation":"நாங்கள் பூமியைத் தாயாகவும், வானத்தைத் தந்தையாகவும் கருதக்கூடியவர்கள் என்று சியாட்டல் கடிதத்தில் குறிப்பிடுகிறார்."}}}
{"id":"b-tam-6t3-084","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 26"},"texts":{"ta":{"blocks":[{"type":"text","text":"சியாட்டல் கடிதத்தில் இயற்கைக் கூறுகளை உறவுகளோடு ஒப்பிடுவதைச் சரியாகப் பொருத்துக:"},{"type":"list","name":"இயற்கைக் கூறு","items":[{"label":"A","text":"நறுமண மலர்கள்"},{"label":"B","text":"மான்கள், குதிரைகள், கழுகுகள்"},{"label":"C","text":"பூமி"},{"label":"D","text":"வானம்"}]},{"type":"list","name":"உறவு முறை","items":[{"label":"1","text":"சகோதரர்கள்"},{"label":"2","text":"சகோதரிகள்"},{"label":"3","text":"தந்தை"},{"label":"4","text":"தாய்"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}}],"explanation":"நறுமணம் மிகுந்த மலர்கள் யாவும் சகோதரிகள்; மான்கள், குதிரைகள், கழுகுகள் சகோதரர்கள்; பூமி தாய்; வானம் தந்தை."}}}
{"id":"b-tam-6t3-085","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 27"},"texts":{"ta":{"blocks":[{"type":"text","text":"சியாட்டலின் கடிதத்தின்படி ஓடைகளிலும் ஆறுகளிலும் ஓடும் நீரானது வெறும் தண்ணீரன்று; அது எதைக் குறிக்கிறது?"}],"options":[{"key":"A","text":"இயற்கையின் கண்ணீர்"},{"key":"B","text":"எமது மூதாதையரின் குருதி"},{"key":"C","text":"வானத்தின் அமிழ்தம்"},{"key":"D","text":"மண்ணின் சத்து"}],"explanation":"'இங்குள்ள ஓடைகளிலும் ஆறுகளிலும் ஓடும் வனப்புமிகு நீரானது வெறும் தண்ணீரன்று; எமது மூதாதையரின் குருதியாகும்' எனச் சியாட்டல் கூறுகிறார்."}}}
{"id":"b-tam-6t3-086","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 28"},"texts":{"ta":{"blocks":[{"type":"text","text":"சியாட்டல் எழுதிய கடிதம் எந்த நூலில் இருந்து எடுத்துத் தரப்பட்டுள்ளது?"}],"options":[{"key":"A","text":"பழங்குடியினர் பண்பாடு"},{"key":"B","text":"பக்தவத்சல பாரதி எழுதிய ‘தமிழகப் பழங்குடிகள்’"},{"key":"C","text":"நா. வானமாமலை கட்டுரைகள்"},{"key":"D","text":"இயற்கை காப்போம்"}],"explanation":"இக்கட்டுரை பக்தவத்சல பாரதி எழுதிய 'தமிழகப் பழங்குடிகள்' எனும் நூலில் இருந்து எடுத்துத்தரப்பட்டுள்ளது."}}}
{"id":"b-tam-6t3-087","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 29"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இன்னோசை’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"இன் + ஓசை"},{"key":"B","text":"இனி + ஓசை"},{"key":"C","text":"இனிமை + ஓசை"},{"key":"D","text":"இன் + னோசை"}],"explanation":"இனிமை + ஓசை = ஈறுபோதல் விதிப்படி 'மை' கெட்டு, இன் + ஓசை ஆகி, உடல்மேல் உயிர் வந்து 'இன்னோசை' எனப் புணரும்."}}}
{"id":"b-tam-6t3-088","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 29"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பால் + ஊறும்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"பால்ஊறும்"},{"key":"B","text":"பாலூறும்"},{"key":"C","text":"பால்லூறும்"},{"key":"D","text":"பாஊறும்"}],"explanation":"உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி ல் + ஊ = லூ ஆகி 'பாலூறும்' எனப் புணரும்."}}}
{"id":"b-tam-6t3-089","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 26"},"texts":{"ta":{"blocks":[{"type":"text","text":"எவற்றை விலைகொடுத்து வாங்கவோ விற்கவோ முடியாது என்று சியாட்டல் வினவுகிறார்?"}],"options":[{"key":"A","text":"விலங்குகளையும் மரங்களையும்"},{"key":"B","text":"காற்றின் தூய்மையையும் நீரின் உயர்வையும்"},{"key":"C","text":"மலைகளையும் கடற்கரைகளையும்"},{"key":"D","text":"கற்களையும் மணிகளையும்"}],"explanation":"'காற்றின் தூய்மையும் நீரின் உயர்வும் யாருக்கும் சொந்தமானவை அல்ல; அப்படியிருக்கையில் நீங்கள் அவற்றை எவ்வாறு விலைகொடுத்து வாங்க முடியும்?' என்று கேட்கிறார்."}}}
{"id":"b-tam-6t3-090","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 27"},"texts":{"ta":{"blocks":[{"type":"text","text":"வெள்ளையர்களின் நகர வாழ்வு குறித்துச் சியாட்டல் கடிதத்தில் உள்ள பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"வெள்ளையர்களின் நகரங்களில் அமைதியான இடம் எதுவுமில்லை."},{"type":"statement","label":"II","text":"இலைகளின் ஓசைகளையோ பூச்சியினங்களின் ரீங்காரங்களையோ கேட்க முடிவதில்லை."},{"type":"statement","label":"III","text":"வெள்ளையர்களுக்கு இப்பூமியானது உடன்பிறந்தார் அன்று; பகைவரே."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"மூன்று கூற்றுகளுமே சியாட்டல் தம் கடிதத்தில் வெள்ளையர்களின் பண்பாட்டை ஒப்பிட்டுக் கூறிய உண்மைகளாகும்."}}}
{"id":"b-tam-6t3-091","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 28"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பூமியின் மீது மக்கள் துப்புவது எதற்கு ஒப்பாகும்’ எனச் சியாட்டல் கடிதம் குறிப்பிடுகிறது?"}],"options":[{"key":"A","text":"கடவுளை அவமதிப்பதற்குச் சமம்"},{"key":"B","text":"தம் தாய் மீது துப்புவதற்கு ஒப்பாகும்"},{"key":"C","text":"தற்கொலைக்குச் சமம்"},{"key":"D","text":"மண்ணை அழிப்பதற்குச் சமம்"}],"explanation":"'இப்பூமியின் மீது மக்கள் துப்பக்கூடுமானால் அஃது அவர்கள் தம் தாய் மீது துப்புவதற்கு ஒப்பானதாகும்' என்றார்."}}}
{"id":"b-tam-6t3-092","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 28"},"texts":{"ta":{"blocks":[{"type":"text","text":"செவ்விந்தியர்களின் கால்களைத் தாங்கி நிற்கும் நிலமானது எதனால் ஆனது எனச் சியாட்டல் போற்றுகிறார்?"}],"options":[{"key":"A","text":"மலைகளின் துகள்களால்"},{"key":"B","text":"பாட்டன்மார்கள் எரிந்த சாம்பலால்"},{"key":"C","text":"மழைநீரின் படிவுகளால்"},{"key":"D","text":"மரங்களின் உக்கல்களால்"}],"explanation":"'எங்கள் கால்களைத் தாங்கி நிற்கும் இந்நிலமானது எம்முடைய பாட்டன்மார்கள் எரிந்த சாம்பலால் ஆனதாகும்' என்றார்."}}}
