// ==============================================================================
// 7-ஆம் வகுப்பு தமிழ் - பருவம் 1 - இயல் 2: இயற்கை / காடு / விலங்குகள் உலகம் / கப்பற்கலை / வாழ்வியல் (மொத்த வினாக்கள்: 74)
// ==============================================================================
// ==============================================================================
// பாடம் 1: காடு (கவிதைப்பேழை - உவமைக் கவிஞர் சுரதா) [Q067 - Q078]
// கார்த்திகை தீபமெனக் காடெல்லாம், சொல்-பொருள், உவமைக் கவிஞர், இயற்பெயர் இராசகோபாலன்,
// தேன்மழை / கிளிக்கண்ணி, வாழை கன்றை ஈன்றது, புணர்ச்சி (காடெல்லாம், கிழங்கெடுக்கும்), நச்சரவம் கலங்கும்,
// இயற்கை விடுதி, நெஞ்சில் உரமுமின்றி (பாரதியார்), கார்த்திகை விளக்குகள் உவமை
// ==============================================================================
{"id":"b-tam-7t1-067","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 24"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கார்த்திகை தீபமெனக் காடெல்லாம் பூத்திருக்கும் பார்த்திட வேண்டுமடீ - கிளியே பார்வை குளிருமடீ!’ - என்ற ‘காடு’ பாடலை இயற்றிய கவிஞர் யார்?"}],"options":[{"key":"A","text":"வாணிதாசன்"},{"key":"B","text":"சுரதா"},{"key":"C","text":"கண்ணதாசன்"},{"key":"D","text":"பாரதிதாசன்"}],"explanation":"காடு என்னும் தலைப்பில் அமைந்த இக்கிளிக்கண்ணிப் பாடலை இயற்றியவர் உவமைக் கவிஞர் சுரதா ஆவார்."}}}
{"id":"b-tam-7t1-068","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘காடு’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"ஈன்று"},{"label":"B","text":"கொம்பு"},{"label":"C","text":"அதிமதுரம்"},{"label":"D","text":"நச்சரவம்"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"கிளை"},{"label":"2","text":"விடமுள்ள பாம்பு"},{"label":"3","text":"தந்து"},{"label":"4","text":"மிகுந்த சுவை"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}}],"explanation":"ஈன்று = தந்து; கொம்பு = கிளை; அதிமதுரம் = மிகுந்த சுவை; களித்திட = மகிழ்ந்திட; நச்சரவம் = விடமுள்ள பாம்பு; விடுதி = தங்கும் இடம்."}}}
{"id":"pyq-tam-7t1-069","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":12},"texts":{"ta":{"blocks":[{"type":"text","text":"உவமைகளைப் பயன்படுத்திக் கவிதைகள் எழுதுவதில் வல்லவர் என்பதால் ‘உவமைக் கவிஞர்’ என்று போற்றப்படுபவர் யார்?"}],"options":[{"key":"A","text":"முடியரசன்"},{"key":"B","text":"வாணிதாசன்"},{"key":"C","text":"சுரதா"},{"key":"D","text":"பட்டுக்கோட்டை கல்யாணசுந்தரம்"}],"explanation":"உவமைகளைக் கையாள்வதில் இணையற்ற சிறப்புப் பெற்றதால் கவிஞர் சுரதா 'உவமைக் கவிஞர்' என்று அழைக்கப்படுகிறார்."}}}
{"id":"b-tam-7t1-070","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"கவிஞர் சுரதாவின் இயற்பெயர் யாது?"}],"options":[{"key":"A","text":"துரைராசு"},{"key":"B","text":"இராசகோபாலன்"},{"key":"C","text":"சுப்புரத்தினம்"},{"key":"D","text":"முத்தையா"}],"explanation":"சுரதாவின் இயற்பெயர் இராசகோபாலன். பாரதிதாசன் மீது கொண்ட பற்றினால் தம் பெயரைச் சுப்புரத்தினதாசன் (சுரதா) என மாற்றிக் கொண்டார்."}}}
{"id":"b-tam-7t1-071","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"கவிஞர் சுரதா குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"அமுதும் தேனும், தேன்மழை, துறைமுகம் உள்ளிட்ட பல நூல்களை இவர் இயற்றியுள்ளார்."},{"type":"statement","label":"II","text":"பாடப்பகுதியில் இடம்பெற்றுள்ள ‘காடு’ பாடல் தேன்மழை என்னும் நூலில் இயற்கை எழில் என்னும் பகுதியிலிருந்து எடுக்கப்பட்டுள்ளது."},{"type":"statement","label":"III","text":"இப்பாடல் கிளியின் மொழி போன்ற இனிய சொற்களைப் பேசும் பெண்ணை நோக்கிக் கூறுவதாக அமையும் ‘கிளிக்கண்ணி’ பாவகையைச் சேர்ந்தது."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"நூல் வெளிப் பகுதியின்படி கவிஞர் சுரதா மற்றும் காடு பாடல் பற்றிய மூன்று கூற்றுகளும் முற்றிலும் சரியானவை."}}}
{"id":"b-tam-7t1-072","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 26"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வாழை, கன்றை ________’ - பாடநூல் மதிப்பீட்டுச் சரியான சொல்லைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"ஈன்றது"},{"key":"B","text":"வழங்கியது"},{"key":"C","text":"கொடுத்தது"},{"key":"D","text":"தந்தது"}],"explanation":"வாழை கன்றை ஈன்றது (தந்தது) என்பது சரியான மரபுத் தொடர் பயன்பாடாகும்."}}}
{"id":"b-tam-7t1-073","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 26"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘காடெல்லாம்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"காடு + டெல்லாம்"},{"key":"B","text":"காடு + எல்லாம்"},{"key":"C","text":"கா + டெல்லாம்"},{"key":"D","text":"கான் + எல்லாம்"}],"explanation":"காடு + எல்லாம் = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'ட்' நின்று, ட் + எ = டெ ஆகி 'காடெல்லாம்' எனப் புணரும்."}}}
{"id":"b-tam-7t1-074","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 26"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கிழங்கு + எடுக்கும்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"கிழங்குஎடுக்கும்"},{"key":"B","text":"கிழங்கெடுக்கும்"},{"key":"C","text":"கிழங்குடுக்கும்"},{"key":"D","text":"கிழங்கொடுக்கும்"}],"explanation":"கிழங்கு + எடுக்கும் = உகரம் கெட்டு, க் + எ = கெ ஆகி 'கிழங்கெடுக்கும்' எனப் புணரும்."}}}
{"id":"b-tam-7t1-075","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"காட்டில் பன்றிகள் கிழங்குகளைத் தோண்டி உண்பதைக் கண்டு கலக்கமடைவதாகச் சுரதா எதனைக் குறிப்பிடுகிறார்?"}],"options":[{"key":"A","text":"மயில்கள்"},{"key":"B","text":"நச்சரவம் (விடமுள்ள பாம்புகள்)"},{"key":"C","text":"நரிகள்"},{"key":"D","text":"யானைகள்"}],"explanation":"'பச்சை மயில்நடிக்கும் பன்றி கிழங்கெடுக்கும் நச்சர வங்கலங்கும் கிளியே' என்று பாடல் கூறுகிறது."}}}
{"id":"b-tam-7t1-076","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"காட்டில் உள்ள விலங்கினங்கள் எங்கும் அலைந்து திரியும் இடத்தை ‘இயற்கை விடுதி’ என்று குறிப்பிட்டவர் யார்?"}],"options":[{"key":"A","text":"பாரதியார்"},{"key":"B","text":"சுரதா"},{"key":"C","text":"ராஜமார்த்தாண்டன்"},{"key":"D","text":"வாணிதாசன்"}],"explanation":"'சிங்கம் புலிகரடி சிறுத்தை விலங்கினங்கள் எங்கும் திரியுமடீ கிளியே இயற்கை விடுதியிலே' எனச் சுரதா பாடியுள்ளார்."}}}
{"id":"b-tam-7t1-077","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 26"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நெஞ்சில் உரமுமின்றி நேர்மைத் திறமுமின்றி வஞ்சனை சொல்வாரடீ! - கிளியே வாய்ச்சொல்லில் வீரரடி’ - என்ற கிளிக்கண்ணிப் பாடலை இயற்றியவர் யார்?"}],"options":[{"key":"A","text":"சுரதா"},{"key":"B","text":"மகாகவி பாரதியார்"},{"key":"C","text":"பாரதிதாசன்"},{"key":"D","text":"கவிமணி"}],"explanation":"பக்கம் 26 கற்பவை கற்றபின் பகுதியில் இக்கிளிக்கண்ணிப் பாடல் பாரதியாரின் கவிதையாகத் தரப்பட்டுள்ளது."}}}
{"id":"b-tam-7t1-078","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 24"},"texts":{"ta":{"blocks":[{"type":"text","text":"காடு முழுவதும் பூத்துக் குலுங்கும் காட்டுப்பூக்களுக்கு உவமையாகக் கவிஞர் சுரதா எதனைக் குறிப்பிடுகிறார்?"}],"options":[{"key":"A","text":"வானத்து விண்மீன்கள்"},{"key":"B","text":"கார்த்திகை விளக்குகள் (தீபம்)"},{"key":"C","text":"பொற்காசுகள்"},{"key":"D","text":"மின்னல் கீற்றுகள்"}],"explanation":"'கார்த்திகை தீபமெனக் காடெல்லாம் பூத்திருக்கும்' என்று கார்த்திகை விளக்குகளை உவமையாகக் கூறுகிறார்."}}}
// ==============================================================================
// பாடம் 2: அப்படியே நிற்கட்டும் அந்த மரம் (கவிதைப்பேழை - ராஜமார்த்தாண்டன்) [Q079 - Q088]
// நாவல் மரம், கருநீலக் கோலிக்குண்டுகள், சுட்ட பழங்கள் (மண் ஒட்டியவை), சொல்-பொருள்,
// கொல்லிப்பாவை சிற்றிதழ் / கொங்குதேர் வாழ்க்கை, தமிழ் வளர்ச்சித் துறை பரிசு,
// புணர்ச்சி (பெயரறியா, மனமில்லை, நேற்றிரவு), குழந்தை வரைந்தது பறவைகளை மட்டுமே (கலாப்ரியா)
// ==============================================================================
{"id":"b-tam-7t1-079","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 27"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அப்படியே நிற்கட்டும் அந்த மரம்’ என்னும் கவிதைத் தலைப்பில் நாவல் மரத்தின் அழகையும் அழிவையும் கவிதையாகப் பாடியவர் யார்?"}],"options":[{"key":"A","text":"சுரதா"},{"key":"B","text":"ராஜமார்த்தாண்டன்"},{"key":"C","text":"கலாப்ரியா"},{"key":"D","text":"மீரா"}],"explanation":"ஊரின் வடகோடியில் நின்ற நாவல் மரம் குறித்த நினைவுகளைப் பாடியவர் கவிஞர் ராஜமார்த்தாண்டன் ஆவார்."}}}
{"id":"b-tam-7t1-080","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 27"},"texts":{"ta":{"blocks":[{"type":"text","text":"பச்சை இலைகளூடே கிளைகளில் தொங்கும் நாவற்பழங்களுக்குக் கவிஞர் ராஜமார்த்தாண்டன் கூறும் பொருத்தமான உவமை எது?"}],"options":[{"key":"A","text":"நீல மணிகள்"},{"key":"B","text":"கருநீலக் கோலிக்குண்டுகள்"},{"key":"C","text":"கருப்பு முத்துகள்"},{"key":"D","text":"திராட்சைக் குலைகள்"}],"explanation":"'பளபளக்கும் பச்சை இலைகளூடே கருநீலக் கோலிக்குண்டுகளாய் நாவற்பழங்கள் கிளைகளில் தொங்கும்' எனப் பாடியுள்ளார்."}}}
{"id":"b-tam-7t1-081","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 29"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அப்படியே நிற்கட்டும் அந்த மரம்’ பாடலில் ‘சுட்ட பழங்கள்’ என்று குறிப்பிடப்படுபவை எவை?"}],"options":[{"key":"A","text":"மண் ஒட்டிய பழங்கள்"},{"key":"B","text":"சூடான பழங்கள்"},{"key":"C","text":"வேகவைத்த பழங்கள்"},{"key":"D","text":"சுடப்பட்ட பழங்கள்"}],"explanation":"மரத்திலிருந்து கீழே உதிர்ந்து தரையில் விழுந்து மண் ஒட்டிய பழங்களையே 'சுட்ட பழங்கள்' என்று குறிப்பிடுகின்றனர்."}}}
{"id":"b-tam-7t1-082","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"3","C":"4","D":"1"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 28"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அப்படியே நிற்கட்டும் அந்த மரம்’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"பரவசம்"},{"label":"B","text":"துஷ்டி கேட்டல்"},{"label":"C","text":"குஞ்சு குளுவான்கள்"},{"label":"D","text":"கிளியாந்தட்டு"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"ஒரு வகை விளையாட்டு"},{"label":"2","text":"மகிழ்ச்சிப் பெருக்கு"},{"label":"3","text":"துக்கம் விசாரித்தல்"},{"label":"4","text":"சிறுகுழந்தைகள்"}]}],"options":[{"key":"A","text":"A-2, B-3, C-4, D-1","mapping":{"A":"2","B":"3","C":"4","D":"1"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}}],"explanation":"பரவசம் = மகிழ்ச்சிப் பெருக்கு; துஷ்டி கேட்டல் = துக்கம் விசாரித்தல்; குஞ்சு குளுவான்கள் = சிறுகுழந்தைகள்; கிளியாந்தட்டு = ஒரு வகை விளையாட்டு."}}}
{"id":"pyq-tam-7t1-083","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":35},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கொல்லிப்பாவை’ என்னும் சிற்றிதழை நடத்தியவரும், சிறந்த தமிழ்க் கவிதைகளைத் தொகுத்துக் ‘கொங்குதேர் வாழ்க்கை’ என்னும் தலைப்பில் நூலாக்கியவருமான கவிஞர் யார்?"}],"options":[{"key":"A","text":"சுரதா"},{"key":"B","text":"மீரா"},{"key":"C","text":"ராஜமார்த்தாண்டன்"},{"key":"D","text":"கலாப்ரியா"}],"explanation":"கொல்லிப்பாவை சிற்றிதழை நடத்தியவர் மற்றும் கொங்குதேர் வாழ்க்கை நூலைத் தொகுத்தவர் ராஜமார்த்தாண்டன் ஆவார்."}}}
{"id":"b-tam-7t1-084","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 28"},"texts":{"ta":{"blocks":[{"type":"text","text":"ராஜமார்த்தாண்டன் தனது எந்த நூலுக்காகத் தமிழ் வளர்ச்சித் துறையின் சிறந்த நூலுக்கான பரிசைப் பெற்றார்?"}],"options":[{"key":"A","text":"கொங்குதேர் வாழ்க்கை"},{"key":"B","text":"ராஜமார்த்தாண்டன் கவிதைகள்"},{"key":"C","text":"அப்படியே நிற்கட்டும் அந்த மரம்"},{"key":"D","text":"கொல்லிப்பாவை"}],"explanation":"'ராஜமார்த்தாண்டன் கவிதைகள்' என்னும் நூலுக்காக இவர் தமிழ் வளர்ச்சித் துறையின் பரிசு பெற்றார்."}}}
{"id":"b-tam-7t1-085","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 29"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பெயரறியா’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"பெயர + றியா"},{"key":"B","text":"பெயர் + ரறியா"},{"key":"C","text":"பெயர் + அறியா"},{"key":"D","text":"பெயர + அறியா"}],"explanation":"உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி (ர் + அ = ர) பெயர் + அறியா = பெயரறியா எனப் புணரும்."}}}
{"id":"b-tam-7t1-086","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 29"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மனமில்லை’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"மன + மில்லை"},{"key":"B","text":"மனமி + இல்லை"},{"key":"C","text":"மனம் + மில்லை"},{"key":"D","text":"மனம் + இல்லை"}],"explanation":"உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே: ம் + இ = மி ஆகி மனம் + இல்லை = மனமில்லை எனப் புணரும்."}}}
{"id":"b-tam-7t1-087","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 29"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நேற்று + இரவு’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"நேற்று இரவு"},{"key":"B","text":"நேற்றிரவு"},{"key":"C","text":"நேற்றுரவு"},{"key":"D","text":"நேற்இரவு"}],"explanation":"உயிர்வரின் உக்குறள் மெய்விட்டோடும்: ற்று-வில் உகரம் கெட்டு, ற் + இ = றி ஆகி 'நேற்றிரவு' எனப் புணரும்."}}}
{"id":"b-tam-7t1-088","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 29"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘குழந்தை வரைந்தது பறவைகளை மட்டுமே; வானம் தானாக உருவானது’ - என்ற புகழ்பெற்ற புதுக்கவிதையை இயற்றியவர் யார்?"}],"options":[{"key":"A","text":"ராஜமார்த்தாண்டன்"},{"key":"B","text":"கலாப்ரியா"},{"key":"C","text":"மீரா"},{"key":"D","text":"மு. மேத்தா"}],"explanation":"பக்கம் 29-ல் உள்ள இக்குறிப்பிடத்தக்க புதுக்கவிதையை இயற்றியவர் கவிஞர் கலாப்ரியா ஆவார்."}}}
