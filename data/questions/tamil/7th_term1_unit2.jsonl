{"id":"b-tam-7t1-116","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 39"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஐ’ என்னும் நெடில் எழுத்து தனித்து வரும்போது தனக்குரிய இரண்டு மாத்திரையிலிருந்து குறைந்து, சொல்லின் முதலில் வரும்போது எத்தனை மாத்திரை அளவில் ஒலிக்கும்?"}],"options":[{"key":"A","text":"இரண்டு மாத்திரை"},{"key":"B","text":"ஒன்றரை மாத்திரை"},{"key":"C","text":"ஒரு மாத்திரை"},{"key":"D","text":"அரை மாத்திரை"}],"explanation":"ஐகாரம் சொல்லின் முதலில் வரும்போது 1½ மாத்திரையாகக் குறைந்து ஒலிக்கும் (எ.கா: வையம்)."}}}
{"id":"b-tam-7t1-117","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 39"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஐகாரக் குறுக்கம் சொல்லின் இடையிலும் இறுதியிலும் வரும்போது எத்தனை மாத்திரை அளவில் ஒலிக்கும்?"}],"options":[{"key":"A","text":"இரண்டு மாத்திரை"},{"key":"B","text":"ஒன்றரை மாத்திரை"},{"key":"C","text":"ஒரு மாத்திரை"},{"key":"D","text":"அரை மாத்திரை"}],"explanation":"ஐகாரம் சொல்லின் இடையிலும் (சமையல்) இறுதியிலும் (பறவை) வரும்போது 1 மாத்திரை அளவில் ஒலிக்கும்."}}}
{"id":"b-tam-7t1-118","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 40"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வேட்கை’ என்னும் சொல்லில் இறுதியில் வந்துள்ள ஐகாரக் குறுக்கம் பெறும் மாத்திரை அளவு யாது?"}],"options":[{"key":"A","text":"அரை மாத்திரை"},{"key":"B","text":"ஒரு மாத்திரை"},{"key":"C","text":"ஒன்றரை மாத்திரை"},{"key":"D","text":"இரண்டு மாத்திரை"}],"explanation":"சொல்லின் இறுதியில் வரும் ஐகாரக் குறுக்கம் ஒரு மாத்திரை அளவு பெறும்."}}}
{"id":"pyq-tam-7t1-119","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":88},"texts":{"ta":{"blocks":[{"type":"text","text":"நால்வகைக் குறுக்கங்களில் சொல்லின் முதலில் மட்டுமே இடம்பெறும் குறுக்கம் எது?"}],"options":[{"key":"A","text":"ஐகாரக் குறுக்கம்"},{"key":"B","text":"ஔகாரக் குறுக்கம் (எ.கா: ஔவையார்)"},{"key":"C","text":"மகரக் குறுக்கம்"},{"key":"D","text":"ஆய்தக் குறுக்கம்"}],"explanation":"ஔகாரம் சொல்லின் இடையிலும் இறுதியிலும் வராது; சொல்லின் முதலில் மட்டுமே ஒன்றரை மாத்திரையாய்க் குறுகி வரும்."}}}
{"id":"b-tam-7t1-120","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 39"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வலம் வந்தான்’ என்பதில் மகர மெய்யெழுத்தை அடுத்து வகர எழுத்து வருவதால் மகரமெய் அரை மாத்திரையிலிருந்து குறைந்து எத்தனை மாத்திரையாய் ஒலிக்கும்?"}],"options":[{"key":"A","text":"ஒரு மாத்திரை"},{"key":"B","text":"அரை மாத்திரை"},{"key":"C","text":"கால் மாத்திரை"},{"key":"D","text":"முக்கால் மாத்திரை"}],"explanation":"மகரக்குறுக்கம் தனக்குரிய அரை மாத்திரையிலிருந்து குறைந்து கால் மாத்திரை அளவில் ஒலிக்கும்."}}}
{"id":"b-tam-7t1-121","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 39"},"texts":{"ta":{"blocks":[{"type":"text","text":"செய்யுளில் ஓசைச் சீர்மைக்காகப் ‘போலும்’ மற்றும் ‘மருளும்’ ஆகிய சொற்கள் எவ்வாறு திரிந்து மகரக்குறுக்கமாக ஒலிக்கும்?"}],"options":[{"key":"A","text":"போலும், மருளும்"},{"key":"B","text":"போன்ம், மருண்ம்"},{"key":"C","text":"போல்வது, மருள்வது"},{"key":"D","text":"போனது, மருண்டது"}],"explanation":"போன்ம், மருண்ம் என ன், ண் அடுத்து வரும் மகர மெய் கால் மாத்திரையாய் ஒலிக்கும்."}}}
{"id":"b-tam-7t1-122","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 40"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘போன்ம், மருண்ம், வலம்வந்தான், பணம் கிடைத்தது’ - இவற்றுள் மகரக்குறுக்கம் இடம்பெறாத சொல் எது?"}],"options":[{"key":"A","text":"போன்ம்"},{"key":"B","text":"மருண்ம்"},{"key":"C","text":"வலம்வந்தான்"},{"key":"D","text":"பணம் கிடைத்தது"}],"explanation":"பணம் கிடைத்தது என்பதில் மகர மெய் முழுமையாக அரை மாத்திரை ஒலிக்கிறது; குறுக்கம் பெறவில்லை."}}}
{"id":"b-tam-7t1-123","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 40"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘முள் + தீது’ மற்றும் ‘கல் + தீது’ ஆகியவை புணர்ந்து ஆய்தக்குறுக்கமாக மாறும் வடிவங்கள் எவை?"}],"options":[{"key":"A","text":"முள்தீது, கல்தீது"},{"key":"B","text":"முஃடீது, கஃறீது (கால் மாத்திரை)"},{"key":"C","text":"முத்தீது, கத்தீது"},{"key":"D","text":"முடீது, கறீது"}],"explanation":"முள் + தீது = முஃடீது; கல் + தீது = கஃறீது என ஆய்தம் கால் மாத்திரையாய்க் குறுகும்."}}}
{"id":"b-tam-7t1-124","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"3","C":"4","D":"1"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 42"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஆங்கிலக் கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"},{"type":"list","name":"ஆங்கிலச் சொல்","items":[{"label":"A","text":"Parable"},{"label":"B","text":"Forestry"},{"label":"C","text":"Natural Resource"},{"label":"D","text":"Conservator of Forests"}]},{"type":"list","name":"தமிழாக்கம்","items":[{"label":"1","text":"வனப் பாதுகாவலர்"},{"label":"2","text":"உவமை"},{"label":"3","text":"வனவியல்"},{"label":"4","text":"இயற்கை வளம்"}]}],"options":[{"key":"A","text":"A-2, B-3, C-4, D-1","mapping":{"A":"2","B":"3","C":"4","D":"1"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"D","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}}],"explanation":"Parable = உவமை; Forestry = வனவியல்; Natural Resource = இயற்கை வளம்; Conservator of Forests = வனப் பாதுகாவலர்."}}}
