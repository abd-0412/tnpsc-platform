{"id":"b-tam-7t1-089","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 30"},"texts":{"ta":{"blocks":[{"type":"text","text":"நமக்குக் கிடைத்துள்ள தமிழ் நூல்களிலேயே மிகவும் பழமையான தொல்காப்பியம் கடற்பயணத்தை எவ்வாறு குறிப்பிடுகிறது?"}],"options":[{"key":"A","text":"நன்னீர் வழக்கம்"},{"key":"B","text":"கடல் வழக்கம்"},{"key":"C","text":"முந்நீர் வழக்கம்"},{"key":"D","text":"நாவாய் வழக்கம்"}],"explanation":"தொல்காப்பியம் கடற்பயணத்தை 'முந்நீர் வழக்கம்' என்று குறிப்பிடுவதால், தொல்காப்பியர் காலத்திற்கு முன்பே கடற்பயணம் இருந்தது தெளிவாகிறது."}}}
{"id":"b-tam-7t1-090","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 30"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கடலோடா கால்வல் நெடுந்தேர் கடலோடும் நாவாயும் ஓடா நிலத்து’ - என்னும் திருக்குறள் மூலம் அறியப்படும் வரலாற்று உண்மை யாது?"}],"options":[{"key":"A","text":"நிலத்தில் தேர்கள் மட்டுமே ஓடும்"},{"key":"B","text":"திருவள்ளுவர் காலத்திலேயே கடலில் செல்லும் பெரிய நாவாய்கள் (கப்பல்கள்) வழக்கத்தில் இருந்தன"},{"key":"C","text":"கப்பல்கள் வெளிநாட்டிலிருந்து வாங்கப்பட்டன"},{"key":"D","text":"தேர்கள் கடலில் மூழ்கின"}],"explanation":"வள்ளுவர் காலத்திலேயே கடலில் செல்லும் பெரிய கப்பல்களான 'நாவாய்கள்' பெருமளவில் இருந்தன என்பதை இக்குறள் மெய்ப்பிக்கிறது."}}}
{"id":"b-tam-7t1-091","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"3","C":"1"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 30"},"texts":{"ta":{"blocks":[{"type":"text","text":"கப்பல் பற்றிய சங்க இலக்கியக் குறிப்புகளைச் சரியாகப் பொருத்துக:"},{"type":"list","name":"இலக்கிய வரி","items":[{"label":"A","text":"உலகு கிளர்ந்தன்ன உருகெழு வங்கம்"},{"label":"B","text":"நீர்மிசை நிவக்கும் பெருங்கலி வங்கம்"},{"label":"C","text":"கலஞ்செய் கம்மியர் வருகெனக் கூஉய்"}]},{"type":"list","name":"நூல்","items":[{"label":"1","text":"மணிமேகலை (காதை 25)"},{"label":"2","text":"அகநானூறு (பாடல் 255)"},{"label":"3","text":"பதிற்றுப்பத்து (பாடல் 52)"}]}],"options":[{"key":"A","text":"A-2, B-3, C-1","mapping":{"A":"2","B":"3","C":"1"}},{"key":"B","text":"A-1, B-2, C-3","mapping":{"A":"1","B":"2","C":"3"}},{"key":"C","text":"A-3, B-1, C-2","mapping":{"A":"3","B":"1","C":"2"}},{"key":"D","text":"A-2, B-1, C-3","mapping":{"A":"2","B":"1","C":"3"}}],"explanation":"உலகு கிளர்ந்தன்ன உருகெழு வங்கம் = அகநானூறு; நீர்மிசை நிவக்கும் பெருங்கலி வங்கம் = பதிற்றுப்பத்து; கலஞ்செய் கம்மியர் வருகெனக் கூஉய் = மணிமேகலை."}}}
{"id":"b-tam-7t1-092","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 30"},"texts":{"ta":{"blocks":[{"type":"text","text":"பல வகையான கப்பல்களின் பெயர்களைக் குறிப்பிட்டுள்ள பழமையான நிகண்டு நூல் எது?"}],"options":[{"key":"A","text":"சூடாமணி நிகண்டு"},{"key":"B","text":"சேந்தன் திவாகரம்"},{"key":"C","text":"பிங்கல நிகண்டு"},{"key":"D","text":"அகராதி நிகண்டு"}],"explanation":"சேந்தன் திவாகரம் என்னும் நிகண்டு நூலில் பலவகையான கப்பல்களின் பெயர்கள் விரிவாகக் குறிப்பிடப்பட்டுள்ளன."}}}
{"id":"b-tam-7t1-093","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 31"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழர்கள் சிறிய நீர்நிலைகளைக் கடக்கப் பயன்படுத்திய ஊர்திகளுள் பொருந்தாதது எது?"}],"options":[{"key":"A","text":"தோணி, ஓடம், படகு"},{"key":"B","text":"கலம், வங்கம், நாவாய்"},{"key":"C","text":"புணை, மிதவை"},{"key":"D","text":"தெப்பம்"}],"explanation":"கலம், வங்கம், நாவாய் முதலியவை அளவில் பெரியவை; இவற்றைத் தமிழர்கள் கடல் பயணத்திற்குப் பயன்படுத்தினர். சிறிய நீர்நிலைகளுக்குத் தோணி, ஓடம், படகு, புணை, மிதவை, தெப்பம் பயன்பட்டன."}}}
{"id":"b-tam-7t1-094","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 31"},"texts":{"ta":{"blocks":[{"type":"text","text":"பழந்தமிழகத்தில் கப்பல் கட்டும் கலைஞர்கள் எவ்வாறு அழைக்கப்பட்டனர்?"}],"options":[{"key":"A","text":"மீகாமன்"},{"key":"B","text":"கம்மியர்"},{"key":"C","text":"நீகான்"},{"key":"D","text":"கொல்லர்"}],"explanation":"கப்பல் கட்டும் கலைஞர்கள் 'கம்மியர்' என்று அழைக்கப்பட்டனர் ('கலஞ்செய் கம்மியர் வருகெனக் கூஉய்' - மணிமேகலை)."}}}
{"id":"b-tam-7t1-095","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 31"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழர்கள் கப்பலின் நீளம், அகலம், உயரம் ஆகியவற்றைக் கணக்கிடப் பயன்படுத்திய நீட்டல் அளவை எது?"}],"options":[{"key":"A","text":"விரற்கடை"},{"key":"B","text":"சாண்"},{"key":"C","text":"தச்சுமுழம்"},{"key":"D","text":"அடி"}],"explanation":"கப்பலின் நீளம், அகலம், உயரத்தைத் 'தச்சுமுழம்' என்னும் நீட்டல் அளவையால் கணக்கிட்டுக் கப்பல்களை உருவாக்கினர்."}}}
{"id":"b-tam-7t1-096","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 31"},"texts":{"ta":{"blocks":[{"type":"text","text":"பெரிய படகுகளின் முன்பக்கத்தை யானை, குதிரை, அன்னம் போன்றவற்றின் முகத்தைப் போல வடிவமைத்த முறைகள் எவை?"}],"options":[{"key":"A","text":"கயமுக அம்பி, நரிமுக அம்பி"},{"key":"B","text":"கரிமுக அம்பி, பரிமுக அம்பி"},{"key":"C","text":"சிங்கமுக அம்பி, புலிமுக அம்பி"},{"key":"D","text":"மயில்முக அம்பி, கிளிமுக அம்பி"}],"explanation":"யானை முகத்தை உடையது கரிமுக அம்பி என்றும், குதிரை முகத்தை உடையது பரிமுக அம்பி என்றும் அழைக்கப்பட்டன."}}}
{"id":"pyq-tam-7t1-097","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2018,"paper":"tamil","no":27},"texts":{"ta":{"blocks":[{"type":"text","text":"பழங்காலத் தமிழ்நாட்டுக் கப்பல்களில் பயன்படுத்தப்பட்ட மணி ஒன்று தற்காலத்தில் எந்த நாட்டின் அருங்காட்சியகத்தில் காட்சிக்கு வைக்கப்பட்டுள்ளது?"}],"options":[{"key":"A","text":"இங்கிலாந்து (லண்டன் அருங்காட்சியகம்)"},{"key":"B","text":"நியூசிலாந்து (வெலிங்டன் அருங்காட்சியகம்)"},{"key":"C","text":"பிரான்ஸ் (பாரிஸ் அருங்காட்சியகம்)"},{"key":"D","text":"சீனா (பீஜிங் அருங்காட்சியகம்)"}],"explanation":"நியூசிலாந்து நாட்டு வெலிங்டன் அருங்காட்சியகத்தில் தமிழர்கள் பயன்படுத்திய பழங்காலக் கப்பல் மணி இடம்பெற்றுள்ளது."}}}
{"id":"b-tam-7t1-098","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 32"},"texts":{"ta":{"blocks":[{"type":"text","text":"சுண்ணாம்பையும் சணலையும் கலந்து அரைத்து எண்ணெய் கலந்து கப்பலின் அடிப்பகுதியில் பூசும் தமிழரின் தொழில்நுட்பத்தை வியந்து பாராட்டிய இத்தாலி நாட்டுப் பயணி யார்?"}],"options":[{"key":"A","text":"யுவான் சுவாங்"},{"key":"B","text":"மார்க்கோ போலோ"},{"key":"C","text":"இபின் பதூதா"},{"key":"D","text":"மெகஸ்தனிஸ்"}],"explanation":"இத்தாலி நாட்டைச் சேர்ந்த மார்க்கோ போலோ என்னும் கடற்பயணி தமிழரின் இப்பழுதாகாத் தொழில்நுட்பத்தை வியந்து பாராட்டியுள்ளார்."}}}
{"id":"pyq-tam-7t1-099","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":59},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஆங்கிலேயர் கட்டிய கப்பல்களைப் பன்னிரண்டு ஆண்டுகளுக்கு ஒருமுறை பழுதுபார்க்க வேண்டும்; ஆனால் தமிழர் கட்டிய கப்பல்களை ஐம்பது ஆண்டுகள் ஆனாலும் பழுதுபார்க்க வேண்டிய அவசியமில்லை’ - என்று கூறிய ஆங்கிலேயர் யார்?"}],"options":[{"key":"A","text":"காரன்வாலிஸ்"},{"key":"B","text":"மெக்காலே"},{"key":"C","text":"வாக்கர் (Walker)"},{"key":"D","text":"வில்லியம் ஜோன்ஸ்"}],"explanation":"தமிழரின் கப்பல் கட்டும் திறனை வியந்து வாக்கர் என்னும் ஆங்கில அறிஞர் இவ்வாறு பாராட்டியுள்ளார்."}}}
{"id":"b-tam-7t1-100","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"3","C":"4","D":"1"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 32"},"texts":{"ta":{"blocks":[{"type":"text","text":"கப்பலின் முதன்மையான உறுப்புகளையும் அவற்றின் விளக்கங்களையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"கப்பலின் உறுப்பு","items":[{"label":"A","text":"எரா"},{"label":"B","text":"பருமல்"},{"label":"C","text":"சுக்கான்"},{"label":"D","text":"நங்கூரம்"}]},{"type":"list","name":"விளக்கம்","items":[{"label":"1","text":"கப்பலை ஓரிடத்தில் நிலையாக நிறுத்தி வைக்க உதவும் உறுப்பு"},{"label":"2","text":"கப்பலின் முதன்மையான உறுப்பாகிய அடிமரம்"},{"label":"3","text":"கப்பலின் குறுக்கு மரம்"},{"label":"4","text":"கப்பலைச் செலுத்தவும் திசை திருப்பவும் பயன்படும் முதன்மைக் கருவி"}]}],"options":[{"key":"A","text":"A-2, B-3, C-4, D-1","mapping":{"A":"2","B":"3","C":"4","D":"1"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"D","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}}],"explanation":"எரா = அடிமரம்; பருமல் = குறுக்கு மரம்; சுக்கான் = திசை திருப்பும் முதன்மைக் கருவி; நங்கூரம் = கப்பலை நிலையாக நிறுத்த உதவும் உறுப்பு."}}}
{"id":"b-tam-7t1-101","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 32"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கப்பல் சாத்திரம்’ என்னும் நூலில் குறிப்பிடப்பட்டுள்ள காந்த ஊசி பொருத்தப்பட்ட திசைகாட்டும் கருவியாகக் கருதப்படுவது எது?"}],"options":[{"key":"A","text":"சுக்கான்"},{"key":"B","text":"சமுக்கு"},{"key":"C","text":"கண்ணடை"},{"key":"D","text":"பருமல்"}],"explanation":"கப்பல் சாத்திரம் குறிப்பிடும் 'சமுக்கு' என்னும் கருவி காந்த ஊசி பொருத்தப்பட்ட திசைகாட்டும் கருவி என ஆய்வாளர்கள் கருதுகின்றனர்."}}}
{"id":"b-tam-7t1-102","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 33"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நளியிரு முந்நீர் நாவாய் ஓட்டி வளி தொழில் ஆண்ட உரவோன் மருக!’ - என்று கரிகால் பெருவளத்தானைப் போற்றிப் பாடிய பெண்பாற்புலவர் யார்?"}],"options":[{"key":"A","text":"ஔவையார்"},{"key":"B","text":"காக்கைப்பாடினியார்"},{"key":"C","text":"வெண்ணிக்குயத்தியார் (புறநானூறு 66)"},{"key":"D","text":"நச்செள்ளையார்"}],"explanation":"காற்றின் திசையறிந்து கப்பல் செலுத்திய தமிழரின் திறத்தைப் புறநானூற்றில் வெண்ணிக்குயத்தியார் போற்றியுள்ளார்."}}}
{"id":"b-tam-7t1-103","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 33"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கலம் தந்த பொற்பரிசம் கழித்தோணியால் கரை சேர்க்குந்து’ - என்ற புறநானூற்றுப் பாடல் அடி உணர்த்தும் செய்தி யாது?"}],"options":[{"key":"A","text":"கப்பல்கள் கரையைத் தொட்டு நின்றன"},{"key":"B","text":"பெரிய கப்பல்கள் கரைக்கு வர முடியாததால் கப்பலில் வந்த பொருள்களைத் தோணிகள் மூலம் கரைக்குக் கொண்டு வந்தனர்"},{"key":"C","text":"தங்கத்தை மட்டுமே கப்பலில் கொண்டு வந்தனர்"},{"key":"D","text":"பொருள்கள் கடலில் மூழ்கின"}],"explanation":"பெரிய கப்பல்களிலிருந்து பொருள்களைச் சிறு தோணிகள் வழியாகக் கரைக்குக் கொண்டு சேர்த்த நிகழ்வைப் புறநானூறு கூறுகிறது."}}}
{"id":"b-tam-7t1-104","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 33"},"texts":{"ta":{"blocks":[{"type":"text","text":"பழந்தமிழர்கள் கடல் வணிகப் பயணத்திற்கு எவற்றை வழிகாட்டிகளாகப் பயன்படுத்தியிருக்கலாம் என்று தற்காலச் செயற்கைக்கோள் ஆய்வுகள் கூறுகின்றன?"}],"options":[{"key":"A","text":"திமிங்கிலங்கள்"},{"key":"B","text":"கடல் ஆமைகள்"},{"key":"C","text":"டால்பின்கள்"},{"key":"D","text":"சுறாக்கள்"}],"explanation":"கடல் ஆமைகள் இனப்பெருக்கத்திற்குச் செல்லும் வழியையே தமிழர்கள் வணிகத் தொடர்புப் பாதைகளாகப் பயன்படுத்தினர் என்ற கருத்து உள்ளது."}}}
{"id":"b-tam-7t1-105","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 34"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழர்கள் சிறிய நீர்நிலைகளைக் கடக்கப் பயன்படுத்தியது ________ ஆகும்."}],"options":[{"key":"A","text":"கலம்"},{"key":"B","text":"வங்கம்"},{"key":"C","text":"நாவாய்"},{"key":"D","text":"ஓடம்"}],"explanation":"பாடநூல் மதிப்பீட்டு வினா: சிறிய நீர்நிலைகளைக் கடக்க 'ஓடம்' பயன்பட்டது; கலம், வங்கம், நாவாய் கடலுக்குரியவை."}}}
