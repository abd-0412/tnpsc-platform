// பாடம் 6: திருக்குறள் (வாழ்வியல்) [Q125 - Q140]
// அணுவைத் துளைத்து (ஔவையார்), ஒழுக்காறாக் கொள்க, அவ்விய நெஞ்சத்தான், கண்நின்று கண்அறச் சொல்லினும்,
// ஏதிலார் (பிறர்), அருட்செல்வம் செல்வத்துள் செல்வம் (சொற்பொருள் பின்வருநிலை அணி), பூரியார் (இழிந்தவர்),
// வலியார்முன் தன்னை நினைக்க, வாய்மை எனப்படுவது, தன்நெஞ்சு அறிவது, உள்ளத்தால் பொய்யாது,
// சிறந்த அரசின் நான்கு படிகள் (இயற்றல், ஈட்டல், காத்தல், வகுத்தல்), புணர்ச்சி (பொருட்செல்வம், யாதெனின், தன்னெஞ்சு), காந்தியடிகள் வாய்மை
// ==============================================================================
{"id":"b-tam-7t1-125","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அணுவைத் துளைத்து ஏழ்கடலைப் புகட்டிக் குறுகத் தரித்த குறள்’ - என்று திருக்குறளின் பெருமையைப் போற்றிப் பாடியவர் யார்?"}],"options":[{"key":"A","text":"கபிலர்"},{"key":"B","text":"ஔவையார்"},{"key":"C","text":"பரணர்"},{"key":"D","text":"இடைக்காடனார்"}],"explanation":"திருக்குறளின் நுட்பமான அடக்கத்தைப் பாராட்டி ஔவையார் திருவள்ளுவமாலையில் இவ்வாறு பாடியுள்ளார்."}}}
{"id":"b-tam-7t1-126","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஒழுக்காறாக் கொள்க ஒருவன்தன் நெஞ்சத்து அழுக்காறு இலாத இயல்பு’ - இக்குறளின்படி ஒருவன் எதனை ஒழுக்க நெறியாகக் கொள்ள வேண்டும்?"}],"options":[{"key":"A","text":"பிறருக்கு தானம் செய்வதை"},{"key":"B","text":"கடுஞ்சொல் பேசாதிருப்பதை"},{"key":"C","text":"தன் நெஞ்சில் பொறாமை இல்லாத பண்பை"},{"key":"D","text":"பொருளீட்டுவதை"}],"explanation":"ஒருவன் தன் உள்ளத்தில் பொறாமை இல்லாத பண்பையே சிறந்த ஒழுக்க நெறியாகக் கொண்டு வாழ வேண்டும்."}}}
{"id":"b-tam-7t1-127","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அவ்விய நெஞ்சத்தான் ஆக்கமும் செவ்வியான் கேடும் நினைக்கப் படும்’ - சான்றோர்களால் ஆராயப்படுவது எது?"}],"options":[{"key":"A","text":"அரசனின் கொடையும் வீரமும்"},{"key":"B","text":"பொறாமை கொண்டவனுடைய செல்வமும், பொறாமை இல்லாத நல்லவனுடைய வறுமையும்"},{"key":"C","text":"உழவனின் விளைச்சலும் கடனும்"},{"key":"D","text":"வணிகரின் வரவும் செலவும்"}],"explanation":"பொறாமை கொண்டவனின் செல்வமும் (ஆக்கம்), நல்லவனின் வறுமையும் (கேடு) சான்றோரால் ஆராயப்படும்."}}}
{"id":"b-tam-7t1-128","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கண்நின்று கண்அறச் சொல்லினும் சொல்லற்க முன்இன்று பின்நோக்காச் சொல்’ - இக்குறள் உணர்த்தும் நெறி யாது?"}],"options":[{"key":"A","text":"எப்போதும் இன்சொல் மட்டுமே பேச வேண்டும்"},{"key":"B","text":"நேருக்குநேர் நின்று கடுமையான சொற்களைக் கூறினாலும் கூறலாம்; ஆனால் அவர் இல்லாத போது புறங்கூறுதல் கூடாது"},{"key":"C","text":"கண்களைப் பார்த்துப் பேச வேண்டும்"},{"key":"D","text":"பகைவரிடம் அமைதி காக்க வேண்டும்"}],"explanation":"நேரில் கடினமாகப் பேசினாலும் ஒருபோதும் அவர் இல்லாத போது புறம்பேசுதல் (கோள் சொல்லுதல்) கூடாது."}}}
{"id":"b-tam-7t1-129","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஏதிலார் குற்றம்போல் தம்குற்றம் காண்கிற்பின் தீதுண்டோ மன்னும் உயிர்க்கு’ - இதில் ‘ஏதிலார்’ என்பதன் பொருள் யாது?"}],"options":[{"key":"A","text":"நண்பர்"},{"key":"B","text":"பிறர் (அயலார்)"},{"key":"C","text":"உறவினர்"},{"key":"D","text":"சான்றோர்"}],"explanation":"ஏதிலார் என்றால் பிறர் என்று பொருள்; பிறருடைய குற்றத்தைக் காண்பது போல் தன் குற்றத்தையும் காண்பவருக்குத் துன்பமே இல்லை."}}}
{"id":"pyq-tam-7t1-130","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":15},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அருட்செல்வம் செல்வத்துள் செல்வம் பொருட்செல்வம் பூரியார் கண்ணும் உள’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?"}],"options":[{"key":"A","text":"உவமையணி"},{"key":"B","text":"சொற்பொருள் பின்வருநிலை அணி"},{"key":"C","text":"வேற்றுமையணி"},{"key":"D","text":"எடுத்துக்காட்டு உவமையணி"}],"explanation":"'செல்வம்' என்னும் சொல் ஒரே பொருளில் பலமுறை செய்யுளில் மீண்டும் மீண்டும் வந்துள்ளதால் இது சொற்பொருள் பின்வருநிலை அணி ஆகும்."}}}
{"id":"b-tam-7t1-131","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அருட்செல்வம் செல்வத்துள் செல்வம் பொருட்செல்வம் பூரியார் கண்ணும் உள’ - இதில் ‘பூரியார்’ என்பதன் பொருள் யாது?"}],"options":[{"key":"A","text":"செல்வந்தர்"},{"key":"B","text":"இழிந்தவர் (அறிவற்ற கீழ்மக்கள்)"},{"key":"C","text":"சான்றோர்"},{"key":"D","text":"அரசர்"}],"explanation":"பூரியார் என்றால் இழிந்தவர் என்று பொருள்; பொருட்செல்வம் இழிந்தவரிடமும் உண்டு, அருட்செல்வமே மேலானது."}}}
{"id":"b-tam-7t1-132","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வலியார்முன் தன்னை நினைக்கதான் தன்னின் மெலியார்மேல் செல்லும் இடத்து’ - ஒருவர் எப்போது அஞ்சி நிற்கும் நிலையை எண்ணிப் பார்க்க வேண்டும்?"}],"options":[{"key":"A","text":"போர்க்களத்திற்குச் செல்லும்போது"},{"key":"B","text":"தம்மைவிட மெலிந்த எளியவரைத் துன்புறுத்த முனையும்போது"},{"key":"C","text":"மன்னனைப் பார்க்கும்போது"},{"key":"D","text":"நீதிமன்றத்தில் நிற்கும்போது"}],"explanation":"தம்மைவிட எளியவரைத் துன்புறுத்த நினைக்கும்போது, தம்மைவிட வலிமையுடையவர் முன் தாம் அஞ்சி நிற்கும் நிலையை எண்ண வேண்டும்."}}}
{"id":"b-tam-7t1-133","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வாய்மை எனப்படுவது யாதெனின் யாதொன்றும் தீமை இலாத சொலல்’ - திருக்குறளின்படி வாய்மை என்பது யாது?"}],"options":[{"key":"A","text":"உண்மையை மட்டும் உரக்கப் பேசுதல்"},{"key":"B","text":"மற்றவர்க்கு ஒரு தீங்கும் தராத நன்மையான சொற்களைப் பேசுதல்"},{"key":"C","text":"இனிய தமிழில் பேசுதல்"},{"key":"D","text":"எப்போதும் பேசாமல் மௌனம் காத்தல்"}],"explanation":"மற்றவருக்குச் சிறிதும் தீமை தராத பயனுள்ள சொற்களைப் பேசுவதே வாய்மை எனப்படும்."}}}
{"id":"b-tam-7t1-134","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தன்நெஞ்சு அறிவது பொய்யற்க பொய்த்தபின் தன்நெஞ்சே தன்னைச் சுடும்’ - ஒருவன் தன் மனமறியப் பொய் கூறினால் எது அவனை வருத்தும்?"}],"options":[{"key":"A","text":"அரசனின் தண்டனை"},{"key":"B","text":"அவனது மனசாட்சியே (தன் நெஞ்சமே)"},{"key":"C","text":"ஊராரின் பழிச்சொல்"},{"key":"D","text":"பகைவரின் தாக்குதல்"}],"explanation":"தன் நெஞ்சறியப் பொய் கூறினால் அவனது நெஞ்சமே (மனசாட்சியே) நெருப்பாய்த் தன்னை வருத்தும்."}}}
{"id":"b-tam-7t1-135","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘உள்ளத்தால் பொய்யாது ஒழுகின் உலகத்தார் உள்ளத்துள் எல்லாம் உளன்’ - உலகத்தார் உள்ளங்களில் எல்லாம் வாழ்பவர் யார்?"}],"options":[{"key":"A","text":"போரில் வென்ற மன்னன்"},{"key":"B","text":"தன் உள்ளத்தில் பொய் இல்லாமல் வாய்மையோடு வாழ்பவர்"},{"key":"C","text":"அளவற்ற செல்வத்தைப் பகிர்ந்தளிப்பவர்"},{"key":"D","text":"வேதங்களை ஓதியவர்"}],"explanation":"உள்ளத்தில் சிறிதும் பொய்யின்றி நேர்மையோடு வாழ்பவர் உலக மக்களின் நெஞ்சங்களில் எல்லாம் நிலைத்து வாழ்வார்."}}}
{"id":"b-tam-7t1-136","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இயற்றலும் ஈட்டலும் காத்தலும் காத்த வகுத்தலும் வல்லது அரசு’ - ஒரு சிறந்த அரசின் கடமைகளாக வள்ளுவர் கூறும் நான்கு படிகள் எவை?"}],"options":[{"key":"A","text":"படை, குடி, கூழ், அமைச்சு"},{"key":"B","text":"பொருள் வரும் வழிகளை அறிதல் (இயற்றல்), சேர்த்தல் (ஈட்டல்), பாதுகாத்தல் (காத்தல்), பயனுள்ள வகையில் திட்டமிட்டுச் செலவிடுதல் (வகுத்தல்)"},{"key":"C","text":"வரி விதித்தல், போர் புரிதல், நிலம் வாங்குதல், தானம் செய்தல்"},{"key":"D","text":"கோட்டை அமைத்தல், தூது செல்லுதல், கல்வி புகட்டுதல், நீதியளித்தல்"}],"explanation":"வருவாய் வழிகளை அறிதல், திரட்டுதல், பாதுகாத்தல், பகிர்ந்தளித்தல் ஆகிய நான்கும் சிறந்த அரசின் செயல்பாடுகள்."}}}
{"id":"b-tam-7t1-137","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 46"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பொருட்செல்வம்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"பொரு + செல்வம்"},{"key":"B","text":"பொருட் + செல்வம்"},{"key":"C","text":"பொருள் + செல்வம்"},{"key":"D","text":"பொரும் + செல்வம்"}],"explanation":"பொருள் + செல்வம் = ள் திரிந்து ட் ஆகி 'பொருட்செல்வம்' எனப் புணரும்."}}}
{"id":"b-tam-7t1-138","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 46"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘யாதெனின்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"யா + எனின்"},{"key":"B","text":"யாது + தெனின்"},{"key":"C","text":"யா + தெனின்"},{"key":"D","text":"யாது + எனின்"}],"explanation":"யாது + எனின் = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'யாதெனின்' எனப் புணரும்."}}}
{"id":"b-tam-7t1-139","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 46"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தன் + நெஞ்சு’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"தன்நெஞ்சு"},{"key":"B","text":"தன்னெஞ்சு"},{"key":"C","text":"தானெஞ்சு"},{"key":"D","text":"தானேநெஞ்சு"}],"explanation":"தனிக்குறில்முன் ஒற்று உயிர்வரின் இரட்டும் விதிப்படி தன்னெஞ்சு எனப் புணரும்."}}}
{"id":"b-tam-7t1-140","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 46"},"texts":{"ta":{"blocks":[{"type":"text","text":"சிறு வயதில் அரிச்சந்திரன் நாடகத்தைப் பார்த்து, வாழ்நாள் முழுவதும் பொய் பேசாமை என்னும் வாய்மையைக் கடைப்பிடித்த காந்தியடிகள் அனைவரின் இதயத்திலும் இடம்பிடித்த நிகழ்விற்குப் பொருத்தமான திருக்குறள் எது?"}],"options":[{"key":"A","text":"ஒழுக்காறாக் கொள்க ஒருவன்தன் நெஞ்சத்து அழுக்காறு இலாத இயல்பு"},{"key":"B","text":"அருட்செல்வம் செல்வத்துள் செல்வம் பொருட்செல்வம் பூரியார் கண்ணும் உள"},{"key":"C","text":"உள்ளத்தால் பொய்யாது ஒழுகின் உலகத்தார் உள்ளத்துள் எல்லாம் உளன்"},{"key":"D","text":"ஏதிலார் குற்றம்போல் தம்குற்றம் காண்கிற்பின் தீதுண்டோ மன்னும் உயிர்க்கு"}],"explanation":"காந்தியடிகள் உள்ளத்தில் பொய் இல்லாமல் வாழ்ந்து உலக மக்கள் இதயங்களில் எல்லாம் இடம்பிடித்ததற்கு இக்குறள் மிகப்பொருந்தும்."}}}
