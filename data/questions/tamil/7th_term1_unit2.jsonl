// ==============================================================================
{"id":"b-tam-7t1-106","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ்நாட்டின் இரண்டாவது மிகப்பெரிய புலிகள் காப்பகமான ‘களக்காடு முண்டந்துறை புலிகள் காப்பகத்தின்’ மொத்தப் பரப்பளவு எவ்வளவு?"}],"options":[{"key":"A","text":"750 சதுர கிலோ மீட்டர்"},{"key":"B","text":"895 சதுர கிலோ மீட்டர்"},{"key":"C","text":"985 சதுர கிலோ மீட்டர்"},{"key":"D","text":"1000 சதுர கிலோ மீட்டர்"}],"explanation":"களக்காடு முண்டந்துறை புலிகள் காப்பகம் 895 சதுர கிலோ மீட்டர் பரப்பளவு கொண்டது."}}}
{"id":"b-tam-7t1-107","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 36"},"texts":{"ta":{"blocks":[{"type":"text","text":"யானைகள் குறித்த பின்வரும் பாடநூல் தகவல்களை ஆராய்க:"},{"type":"statement","label":"I","text":"ஆசிய யானைகளில் ஆண் யானைக்குத் தந்தம் உண்டு, பெண் யானைக்குத் தந்தம் இல்லை; ஆப்பிரிக்க யானைகளில் இரண்டுக்குமே தந்தம் உண்டு."},{"type":"statement","label":"II","text":"யானைக் கூட்டத்திற்கு எப்போதும் ஒரு பெண் யானையே தலைமை தாங்கும்."},{"type":"statement","label":"III","text":"ஒரு யானை நாள் ஒன்றுக்கு 250 கிலோ புல், இலைதழைகளை உணவாக உட்கொள்ளும்; குடிக்க 65 லிட்டர் தண்ணீர் தேவைப்படும்."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"பாடப்பகுதியில் இடம்பெற்றுள்ள யானைகள் பற்றிய மூன்று தகவல்களும் முற்றிலும் சரியானவை."}}}
{"id":"b-tam-7t1-108","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 36"},"texts":{"ta":{"blocks":[{"type":"text","text":"யானைகளின் புலன் உணர்வுகள் குறித்த சரியான உண்மை எது?"}],"options":[{"key":"A","text":"கண்பார்வை மிகுதி; கேட்கும் ஆற்றல் குறைவு"},{"key":"B","text":"கண்பார்வை குறைவு; கேட்கும் ஆற்றலும் மோப்ப ஆற்றலும் மிகுதி"},{"key":"C","text":"அனைத்துப் புலன்களும் ஒரே சீரானவை"},{"key":"D","text":"நினைவாற்றல் இல்லாத விலங்கு"}],"explanation":"யானைக்குக் கண்பார்வை குறைவு; ஆனால் கேட்கும் ஆற்றலும் மோப்ப ஆற்றலும் மிக அதிகம்; அத்துடன் மிகுந்த நினைவாற்றல் கொண்டது."}}}
{"id":"b-tam-7t1-109","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 36"},"texts":{"ta":{"blocks":[{"type":"text","text":"அனைத்துண்ணியான கரடிக்கு மிகவும் பிடித்த முதன்மை உணவு எது?"}],"options":[{"key":"A","text":"தேன்"},{"key":"B","text":"கறையான்"},{"key":"C","text":"பழங்கள்"},{"key":"D","text":"புற்றீசல்"}],"explanation":"கரடி பழங்கள், தேன் உண்டாலும் 'கறையான்' அதற்கு மிகவும் பிடித்த உணவாகும்; நன்கு வளர்ந்த கரடி 160 கிலோ எடை வரை இருக்கும்."}}}
{"id":"b-tam-7t1-110","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 37"},"texts":{"ta":{"blocks":[{"type":"text","text":"புலிகள் குறித்த பின்வரும் பண்புகளை ஆராய்க:"},{"type":"statement","label":"I","text":"புலிகள் தனித்து வாழும் இயல்புடையவை; ஒரு குறிப்பிட்ட எல்லைக்குள் ஒரு புலி மட்டுமே வாழும்."},{"type":"statement","label":"II","text":"கருவுற்ற புலியானது தொண்ணூறு நாள்களில் இரண்டு அல்லது மூன்று குட்டிகள் ஈனும்."},{"type":"statement","label":"III","text":"புலி தனக்கான உணவை வேட்டையாடிய பின்பு வேறு எந்த விலங்கையும் வேட்டையாடுவதில்லை என்பதால் அதனைப் 'பண்புள்ள விலங்கு' என்பர்."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"புலி காட்டின் வளத்தைக் குறிக்கும் குறியீடு; பாடப்பகுதியில் உள்ள இம்மூன்று பண்புகளும் முற்றிலும் சரியானவை."}}}
{"id":"b-tam-7t1-111","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 37"},"texts":{"ta":{"blocks":[{"type":"text","text":"இந்தியாவில் ஆசியச் சிங்கங்கள் குஜராத் மாநிலத்தில் எந்த சரணாலயத்தில் மட்டுமே பாதுகாக்கப்பட்டு வாழ்கின்றன?"}],"options":[{"key":"A","text":"காசிரங்கா சரணாலயம்"},{"key":"B","text":"ஜிம் கார்பெட் சரணாலயம்"},{"key":"C","text":"கிர் சரணாலயம்"},{"key":"D","text":"முதுமலை சரணாலயம்"}],"explanation":"இந்தியாவில் குஜராத் மாநிலத்தின் 'கிர் சரணாலயத்தில்' மட்டுமே ஆசியச் சிங்கங்கள் வாழ்கின்றன."}}}
{"id":"b-tam-7t1-112","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 37"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ்நாட்டில் முதன்மை வனக்கல்லூரி அமைந்துள்ள இடம் எது?"}],"options":[{"key":"A","text":"வால்பாறை"},{"key":"B","text":"மேட்டுப்பாளையம் (கோவை மாவட்டம்)"},{"key":"C","text":"ஏற்காடு"},{"key":"D","text":"கொடைக்கானல்"}],"explanation":"மேட்டுப்பாளையத்தில் உள்ள வனக்கல்லூரியில் இளநிலை மற்றும் முதுநிலை வனவியல் (Forestry) பட்டப்படிப்புகள் கற்பிக்கப்படுகின்றன."}}}
{"id":"pyq-tam-7t1-113","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":77},"texts":{"ta":{"blocks":[{"type":"text","text":"அசாம் மாநிலத்தில் பிரம்மபுத்திரா ஆற்றின் நடுவில் தனி ஒரு மனிதனாகப் பெருங்காட்டை உருவாக்கி ‘இந்திய வனமகன்’ என்று அழைக்கப்படுபவர் யார்?"}],"options":[{"key":"A","text":"சுந்தர்லால் பகுகுணா"},{"key":"B","text":"ஜாதவ் பயேங்"},{"key":"C","text":"சலீம் அலி"},{"key":"D","text":"மேத்தா பட்கர்"}],"explanation":"தனி மனிதனாகக் காட்டை உருவாக்கிய ஜாதவ் பயேங் அவர்களுக்கு இந்திய அரசு 2015-இல் 'பத்மஸ்ரீ' விருது வழங்கியது."}}}
{"id":"b-tam-7t1-114","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 38"},"texts":{"ta":{"blocks":[{"type":"text","text":"இந்திய வனமகன் ஜாதவ் பயேங் அவர்களுக்கு மதிப்புறு முனைவர் (Doctorate) பட்டம் வழங்கிச் சிறப்பித்த பல்கலைக்கழகம் எது?"}],"options":[{"key":"A","text":"தில்லி பல்கலைக்கழகம்"},{"key":"B","text":"கொல்கத்தா பல்கலைக்கழகம்"},{"key":"C","text":"கௌகாத்தி பல்கலைக்கழகம்"},{"key":"D","text":"அசாம் மத்திய பல்கலைக்கழகம்"}],"explanation":"அசாமில் உள்ள கௌகாத்தி பல்கலைக்கழகம் ஜாதவ் பயேங் அவர்களுக்கு மதிப்புறு முனைவர் பட்டம் வழங்கியது."}}}
{"id":"b-tam-7t1-115","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 2, பக்கம் 38"},"texts":{"ta":{"blocks":[{"type":"text","text":"இந்தியாவில் காணப்படும் மான்களுள் அழகில் மிகவும் சிறந்தது என்று பாராட்டப்படுவது எது?"}],"options":[{"key":"A","text":"சருகுமான்"},{"key":"B","text":"புள்ளிமான்"},{"key":"C","text":"மிளாமான்"},{"key":"D","text":"வெளிமான்"}],"explanation":"சருகுமான், மிளாமான், வெளிமான் ஆகிய பல வகைகள் இருப்பினும் புள்ளிமான்களே அழகில் சிறந்தவை என்பர்."}}}
