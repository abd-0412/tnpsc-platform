{"id":"b-tam-6t3-034","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 13"},"texts":{"ta":{"blocks":[{"type":"text","text":"வீரமங்கை வேலுநாச்சியார் எந்த மன்னரின் ஒரே மகள் ஆவார்?"}],"options":[{"key":"A","text":"சிவகங்கை முத்துவடுகநாதர்"},{"key":"B","text":"பாஞ்சாலங்குறிச்சி கட்டபொம்மன்"},{"key":"C","text":"இராமநாதபுர மன்னர் செல்லமுத்து"},{"key":"D","text":"புதுக்கோட்டை தொண்டைமான்"}],"explanation":"இராமநாதபுரத்தை ஆட்சி செய்த செல்லமுத்து மன்னரின் ஒரே மகள் வேலுநாச்சியார் ஆவார்."}}}
{"id":"b-tam-6t3-035","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 13"},"texts":{"ta":{"blocks":[{"type":"text","text":"வேலுநாச்சியார் தாய்மொழியாகிய தமிழ் தவிரப் புலமை பெற்றிருந்த பிற மொழிகள் எவை?"}],"options":[{"key":"A","text":"ஆங்கிலம், இந்தி, தெலுங்கு"},{"key":"B","text":"மலையாளம், உருது, அரபி"},{"key":"C","text":"ஆங்கிலம், பிரெஞ்சு, உருது"},{"key":"D","text":"சமஸ்கிருதம், ஆங்கிலம், பிரெஞ்சு"}],"explanation":"வேலுநாச்சியார் தமிழ் மட்டுமன்றி ஆங்கிலம், பிரெஞ்சு, உருது ஆகிய மொழிகளையும் சிறப்பாகக் கற்றறிந்தார்."}}}
{"id":"b-tam-6t3-036","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 13"},"texts":{"ta":{"blocks":[{"type":"text","text":"வேலுநாச்சியாரின் கணவரான சிவகங்கை மன்னர் முத்துவடுகநாதர் ஆங்கிலேயரால் நயவஞ்சகமாகக் கொல்லப்பட்ட இடம் எது?"}],"options":[{"key":"A","text":"சிவகங்கைக் கோட்டை"},{"key":"B","text":"காளையார்கோவில்"},{"key":"C","text":"திண்டுக்கல் கோட்டை"},{"key":"D","text":"திருப்பத்தூர்"}],"explanation":"காளையார்கோவிலில் நடைபெற்ற போரில் முத்துவடுகநாதர் ஆங்கிலேயரால் நயவஞ்சகமாகக் கொல்லப்பட்டார்."}}}
{"id":"b-tam-6t3-037","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 13"},"texts":{"ta":{"blocks":[{"type":"text","text":"கணவர் கொல்லப்பட்ட பின் வேலுநாச்சியார் எந்தக் கோட்டையில் தங்கிப் படையைத் திரட்டிப் பயிற்சி அளித்தார்?"}],"options":[{"key":"A","text":"செஞ்சிக் கோட்டை"},{"key":"B","text":"திண்டுக்கல் கோட்டை"},{"key":"C","text":"திருமயம் கோட்டை"},{"key":"D","text":"வேலூர் கோட்டை"}],"explanation":"திண்டுக்கல் கோட்டையில் எட்டு ஆண்டுகள் தங்கி வேலுநாச்சியார் ஒரு பெரும் படையைத் திரட்டினார்."}}}
{"id":"b-tam-6t3-038","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 14"},"texts":{"ta":{"blocks":[{"type":"text","text":"மைசூர் மன்னர் ஐதர்அலியிடம் வேலுநாச்சியார் எந்த மொழியில் பேசி 5000 குதிரைப்படை வீரர்களை உதவியாகப் பெற்றார்?"}],"options":[{"key":"A","text":"தமிழ்"},{"key":"B","text":"ஆங்கிலம்"},{"key":"C","text":"உருது மொழி"},{"key":"D","text":"பிரெஞ்சு"}],"explanation":"வேலுநாச்சியார் ஐதர்அலியிடம் உருது மொழியில் பேசியதால் மகிழ்ந்த அவர், 5000 குதிரைப்படை வீரர்களை அனுப்பினார்."}}}
{"id":"b-tam-6t3-039","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 13"},"texts":{"ta":{"blocks":[{"type":"text","text":"வேலுநாச்சியாரின் அமைச்சராகவும் தளபதிகளாகவும் விளங்கியவர்கள் முறையே யார்?"}],"options":[{"key":"A","text":"குயிலி - அமைச்சர்; பெரிய மருது, சின்ன மருது - தளபதிகள்"},{"key":"B","text":"தாண்டவராயர் - அமைச்சர்; பெரிய மருது, சின்ன மருது - தளபதிகள்"},{"key":"C","text":"முத்துவடுகநாதர் - அமைச்சர்; தாண்டவராயர் - தளபதி"},{"key":"D","text":"வெள்ளையத்தேவன் - அமைச்சர்; மருது சகோதரர்கள் - தளபதிகள்"}],"explanation":"வேலுநாச்சியாரின் அமைச்சர் தாண்டவராயர்; தளபதிகள் மருது சகோதரர்கள் ஆவர்."}}}
{"id":"b-tam-6t3-040","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 15"},"texts":{"ta":{"blocks":[{"type":"text","text":"சிவகங்கைக் கோட்டைக் கதவுகள் எந்தத் திருநாளன்று திறக்கப்படும் என்பதை அறிந்து வேலுநாச்சியார் படையுடன் சென்றார்?"}],"options":[{"key":"A","text":"தீபாவளித் திருநாள்"},{"key":"B","text":"விஜயதசமித் திருநாள்"},{"key":"C","text":"பொங்கல் திருநாள்"},{"key":"D","text":"சிவராத்திரி நாள்"}],"explanation":"விஜயதசமி நாளில் பெண்களுக்கு மட்டுமே கோட்டைக்குள் அனுமதி உண்டு என்பதைப் பயன்படுத்தி மாறுவேடத்தில் படைகளை அனுப்பினார்."}}}
{"id":"b-tam-6t3-041","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 15"},"texts":{"ta":{"blocks":[{"type":"text","text":"வேலுநாச்சியாரைக் காட்டிக் கொடுக்க மறுத்ததால் ஆங்கிலேயரால் கொல்லப்பட்ட யாருக்கு நடுகல் நடப்பட்டு வேலுநாச்சியார் தாலியைக் காணிக்கையாகச் செலுத்தினார்?"}],"options":[{"key":"A","text":"குயிலி"},{"key":"B","text":"நாச்சியார்"},{"key":"C","text":"உடையாள்"},{"key":"D","text":"செல்லம்மாள்"}],"explanation":"ஆங்கிலேயருக்குத் துப்பு சொல்ல மறுத்து உயிர்துறந்த உடையாளுக்கு நடுகல் நட்டுத் தம் மாங்கல்யத்தைக் காணிக்கையாக்கினார்."}}}
{"id":"b-tam-6t3-042","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 16"},"texts":{"ta":{"blocks":[{"type":"text","text":"சிவகங்கைக் கோட்டையில் உள்ள ஆங்கிலேயரின் ஆயுதக் கிடங்கிற்குத் தன் உடலில் தீ வைத்துக்கொண்டு குதித்து உயிர்த்தியாகம் செய்த வீரப்பெண் யார்?"}],"options":[{"key":"A","text":"உடையாள்"},{"key":"B","text":"குயிலி"},{"key":"C","text":"ஜான்சி ராணி"},{"key":"D","text":"மூவலூர் ராமாமிர்தம்"}],"explanation":"பெண்கள் படைத்தலைவி குயிலி தன் உடலில் தீ வைத்துக் கிடங்குக்குள் குதித்து ஆயுதங்களை அழித்தார்."}}}
{"id":"pyq-tam-6t3-043","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":22},"texts":{"ta":{"blocks":[{"type":"text","text":"வீரமங்கை வேலுநாச்சியாரின் காலம் மற்றும் அவர் சிவகங்கையை மீட்ட ஆண்டு முறையே எவை?"}],"options":[{"key":"A","text":"1720 - 1780; மீட்ட ஆண்டு 1772"},{"key":"B","text":"1730 - 1796; மீட்ட ஆண்டு 1780"},{"key":"C","text":"1750 - 1801; மீட்ட ஆண்டு 1789"},{"key":"D","text":"1740 - 1799; மீட்ட ஆண்டு 1785"}],"explanation":"பக்கம் 16 தெரிந்து தெளிவோம் குறிப்பின்படி: வேலுநாச்சியாரின் காலம் 1730-1796; சிவகங்கையை மீட்ட ஆண்டு 1780."}}}
{"id":"b-tam-6t3-044","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 16"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஆங்கிலேயரை எதிர்த்து வீரப்போர் புரிந்து வெற்றி கண்ட முதல் இந்தியப் பெண் விடுதலைப் போராட்ட வீராங்கனை யார்?"}],"options":[{"key":"A","text":"ஜான்சி ராணி லக்ஷ்மிபாய்"},{"key":"B","text":"வேலுநாச்சியார்"},{"key":"C","text":"ராணி மங்கம்மாள்"},{"key":"D","text":"அன்னி பெசன்ட்"}],"explanation":"1857-ல் போரிட்ட ஜான்சி ராணிக்கு முன்பே ஆங்கிலேயரை எதிர்த்து வீரப்போர் புரிந்து வெற்றி பெற்றவர் வேலுநாச்சியார் ஆவார்."}}}
