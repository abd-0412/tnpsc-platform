// பாடம் 1: பாரதம் அன்றைய நாற்றங்கால் (கவிதைப்பேழை - தாராபாரதி / கவிஞாயிறு) [Q001 - Q010]
// தேசம் உடுத்திய நூலாடை (திருக்குறள்), மெய்யுணர்வு மேலாடை, காளிதாசன்/கம்பன்/குமரிமுனை,
// கவிஞாயிறு இராதாகிருஷ்ணன், நூல்கள், புணர்ச்சி (நூலாடை, எதிரொலிக்க), கலைக்கூடம்
// ==============================================================================
{"id":"b-tam-6t3-001","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தேசம் உடுத்திய நூலாடை’ எனக் கவிஞர் தாராபாரதி குறிப்பிடும் நூல் எது?"}],"options":[{"key":"A","text":"திருவாசகம்"},{"key":"B","text":"திருக்குறள்"},{"key":"C","text":"திரிகடுகம்"},{"key":"D","text":"திருப்பாவை"}],"explanation":"'தெய்வ வள்ளுவன் நெய்த குறள்தான் தேசம் உடுத்திய நூலாடை' என்று தாராபாரதி போற்றுகிறார்."}}}
{"id":"b-tam-6t3-002","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"text","text":"உண்மைகளைப் போற்றும் இந்தியத் தாய்க்கு மேலாடையாக விளங்குவதாகத் தாராபாரதி எதனைக் கூறுகிறார்?"}],"options":[{"key":"A","text":"அகிம்சை"},{"key":"B","text":"அமுதசுரபி"},{"key":"C","text":"மெய்யுணர்வு"},{"key":"D","text":"அறநெறி"}],"explanation":"'மெய்களைப் போற்றிய இந்தியத் தாய்க்கு மெய்யுணர்வு என்கிற மேலாடை' எனப் பாடலில் குறிப்பிடப்பட்டுள்ளது."}}}
{"id":"b-tam-6t3-003","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பாரதம் அன்றைய நாற்றங்கால்’ பாடலில் இடம்பெற்றுள்ள இலக்கிய உவமைகளைச் சரியாகப் பொருத்துக:"},{"type":"list","name":"கவிஞர் / பகுதி","items":[{"label":"A","text":"காளிதாசனின் பாடல்கள்"},{"label":"B","text":"கம்பனின் கவிதைகள்"},{"label":"C","text":"குமரிமுனையின் கூந்தல்"},{"label":"D","text":"காந்தியின் கைத்தடி"}]},{"type":"list","name":"இடம்பெறும் நிகழ்வு","items":[{"label":"1","text":"கங்கை அலைகள் இசையமைக்கின்றன"},{"label":"2","text":"காவிரிக்கரையில் எதிரொலிக்கின்றன"},{"label":"3","text":"அறத்தின் ஊன்றுகோல்"},{"label":"4","text":"காஷ்மீரத்துப் பூக்கள் தொடுக்கப்படுகின்றன"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-4, B-1, C-2, D-3","mapping":{"A":"4","B":"1","C":"2","D":"3"}}],"explanation":"காளிதாசனின் பாடல்கள் காவிரிக்கரையில் எதிரொலிக்க, கம்பனின் கவிதைக்குக் கங்கை இசையமைக்கிறது; குமரியின் கூந்தலுக்குக் காஷ்மீர் பூத்தொடுக்கிறது; காந்தியின் கைத்தடி அறத்தின் ஊன்றுகோல்."}}}
{"id":"b-tam-6t3-004","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 3"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கவிஞாயிறு’ என்னும் அடைமொழியால் அழைக்கப்பெறும் கவிஞர் யார்?"}],"options":[{"key":"A","text":"தாராபாரதி"},{"key":"B","text":"பெருஞ்சித்திரனார்"},{"key":"C","text":"முடியரசன்"},{"key":"D","text":"சுரதா"}],"explanation":"தாராபாரதியின் இயற்பெயர் இராதாகிருஷ்ணன். இவர் 'கவிஞாயிறு' என்னும் சிறப்பு அடைமொழி பெற்றவர்."}}}
{"id":"b-tam-6t3-005","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 3"},"texts":{"ta":{"blocks":[{"type":"text","text":"கவிஞர் தாராபாரதி குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"தாராபாரதியின் இயற்பெயர் இராதாகிருஷ்ணன் என்பதாகும்."},{"type":"statement","label":"II","text":"புதிய விடியல்கள், இது எங்கள் கிழக்கு, விரல் நுனி வெளிச்சங்கள் ஆகியவை இவர் இயற்றிய நூல்கள் ஆகும்."},{"type":"statement","label":"III","text":"பாடப்பகுதியில் இடம்பெற்றுள்ள ‘பாரதம் அன்றைய நாற்றங்கால்’ பாடல் ‘தாராபாரதியின் கவிதைகள்’ தொகுப்பில் இடம்பெற்றுள்ளது."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"தாராபாரதி பற்றிய மூன்று கூற்றுகளும் பாடநூல் நூல் வெளிப் பகுதியின்படி முற்றிலும் சரியானவை."}}}
{"id":"b-tam-6t3-006","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நூலாடை’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"நூல் + ஆடை"},{"key":"B","text":"நூலா + டை"},{"key":"C","text":"நூல் + லாடை"},{"key":"D","text":"நூலா + ஆடை"}],"explanation":"நூல் + ஆடை = நூலாடை (உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே: ல் + ஆ = லா)."}}}
{"id":"b-tam-6t3-007","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எதிர் + ஒலிக்க’ என்பதைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"எதிரலிக்க"},{"key":"B","text":"எதிர்ஒலிக்க"},{"key":"C","text":"எதிரொலிக்க"},{"key":"D","text":"எதிர்ரொலிக்க"}],"explanation":"எதிர் + ஒலிக்க = எதிரொலிக்க (உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே: ர் + ஒ = ரொ)."}}}
{"id":"b-tam-6t3-008","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"பாரதம் அன்றைய நாற்றங்கால் பாடலின்படி காவியக் கலைக்கூடமாகக் காட்சி தருவது எது?"}],"options":[{"key":"A","text":"கல்லில் செதுக்கிய சிற்பங்கள்"},{"key":"B","text":"ஓவியக்கூடம்"},{"key":"C","text":"பள்ளிக்கூடம்"},{"key":"D","text":"அரண்மனை வாயில்"}],"explanation":"'கல்லைக் கூட காவிய மாக்கிக் கட்டி நிறுத்திய கலைக்கூடம்' எனச் சிற்பங்களை தாராபாரதி குறிப்பிடுகிறார்."}}}
{"id":"b-tam-6t3-009","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 3"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அன்னை - அன்னிய’, ‘மெய்களை - மெய்யுணர்வு’ ஆகிய சொற்களில் அமைந்துள்ள நயம் யாது?"}],"options":[{"key":"A","text":"மோனைத்தொடை"},{"key":"B","text":"எதுகைத்தொடை"},{"key":"C","text":"இயைபுத்தொடை"},{"key":"D","text":"முரண்டொடை"}],"explanation":"முதல் எழுத்து அளவொத்திருக்க, இரண்டாம் எழுத்து ('ன்', 'ய்') ஒன்றி வருவதால் இது எதுகைத்தொடை ஆகும்."}}}
{"id":"b-tam-6t3-010","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"text","text":"பிறநாட்டு மக்களின் பசியையும் போக்கும் வண்ணம் நமது பாரத நாடு எதைப் போன்று திகழ்கிறது எனத் தாராபாரதி பாடுகிறார்?"}],"options":[{"key":"A","text":"கற்பகத் தரு"},{"key":"B","text":"அமுதசுரபி"},{"key":"C","text":"மணிபல்லவத் தீவு"},{"key":"D","text":"பொற்காலம்"}],"explanation":"'அன்னை நாட்டின் அமுத சுரபியில் அன்னிய நாடுகள் பசிதீர' எனப் பாரத நாட்டை அமுதசுரபியாகக் கவிஞர் உருவகிக்கிறார்."}}}
// ==============================================================================
// பாடம் 2: பாஞ்சை வளம் (கவிதைப்பேழை / கதைப்பாடல் - வீரபாண்டிய கட்டபொம்மு) [Q011 - Q022]
// வாரணம் (யானை), பரி (குதிரை), முயல் நாயை விரட்டுதல், மெத்தை வீடு, பொக்கிஷம்/சாஸ்தி/விஸ்தாரம்,
// நா. வானமாமலை, புணர்ச்சி (பூட்டுங்கதவுகள், தோரணமேடை, வாசலலங்காரம்), விந்தைகள், சக்கதேவி
// ==============================================================================
{"id":"b-tam-6t3-011","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"பாஞ்சை வளம் பாடலின் சொல்லும் பொருளில் ‘வாரணம்’ மற்றும் ‘பரி’ என்பதன் பொருள் முறையே யாது?"}],"options":[{"key":"A","text":"குதிரை, யானை"},{"key":"B","text":"பாக்கு, வீரம்"},{"key":"C","text":"யானை, குதிரை"},{"key":"D","text":"செல்வம், அழகு"}],"explanation":"வாரணம் = யானை, பரி = குதிரை, கமுகு = பாக்கு, சிங்காரம் = அழகு."}}}
{"id":"b-tam-6t3-012","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"பாஞ்சாலங்குறிச்சியில் வீரம் மிகுந்த மண்ணின் பெருமையால் வேட்டை நாயை எதிர்த்து விரட்டுவது எது?"}],"options":[{"key":"A","text":"முயல்"},{"key":"B","text":"மான்"},{"key":"C","text":"நரி"},{"key":"D","text":"குயில்"}],"explanation":"'முயலும் நாயை விரட்டிடுமாம் - நல்ல முனையுள்ள பாஞ்சால நாட்டினிலே' என்று கதைப்பாடல் கூறுகிறது."}}}
{"id":"b-tam-6t3-013","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 8"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மெத்தை வீடு’ என்று பாஞ்சை வளம் பாடலில் குறிப்பிடப்படுவது எது?"}],"options":[{"key":"A","text":"மெத்தை விரிக்கப்பட்ட வீடு"},{"key":"B","text":"படுக்கையறை உள்ள வீடு"},{"key":"C","text":"மேட்டுப் பகுதியில் உள்ள வீடு"},{"key":"D","text":"மதில்களால் சூழப்பட்ட மாடி வீடு"}],"explanation":"மெத்தை வீடு என்பது மதில்களால் சூழப்பட்ட நேர்த்தியான மாடி வீட்டைக் குறிக்கிறது."}}}
{"id":"b-tam-6t3-014","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"3","C":"4","D":"1"}},"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 8"},"texts":{"ta":{"blocks":[{"type":"text","text":"பாஞ்சை வளம் பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"பொக்கிஷம்"},{"label":"B","text":"சாஸ்தி"},{"label":"C","text":"விஸ்தாரம்"},{"label":"D","text":"சிங்காரம்"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"அழகு"},{"label":"2","text":"செல்வம்"},{"label":"3","text":"மிகுதி"},{"label":"4","text":"பெரும்பரப்பு"}]}],"options":[{"key":"A","text":"A-2, B-3, C-4, D-1","mapping":{"A":"2","B":"3","C":"4","D":"1"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}}],"explanation":"பொக்கிஷம் = செல்வம், சாஸ்தி = மிகுதி, விஸ்தாரம் = பெரும்பரப்பு, சிங்காரம் = அழகு, சூரன் = வீரன்."}}}
{"id":"b-tam-6t3-015","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 7"},"texts":{"ta":{"blocks":[{"type":"text","text":"பாடப்பகுதியில் இடம்பெற்றுள்ள ‘வீரபாண்டிய கட்டபொம்மு கதைப்பாடல்’ என்னும் நூலைத் தொகுத்து வெளியிட்ட நாட்டுப்புறவியல் அறிஞர் யார்?"}],"options":[{"key":"A","text":"சு. சக்திவேல்"},{"key":"B","text":"நா. வானமாமலை"},{"key":"C","text":"கி. வா. ஜகந்நாதன்"},{"key":"D","text":"மயிலை சீனி. வேங்கடசாமி"}],"explanation":"கட்டபொம்மன் கதைப்பாடலைத் தொகுத்து வெளியிட்டவர் பேராசிரியர் நா. வானமாமலை ஆவார்."}}}
{"id":"b-tam-6t3-016","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 8"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பூட்டுங்கதவுகள்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"பூட்டு + கதவுகள்"},{"key":"B","text":"பூட்டும் + கதவுகள்"},{"key":"C","text":"பூட்டின் + கதவுகள்"},{"key":"D","text":"பூட்டிய + கதவுகள்"}],"explanation":"பூட்டும் + கதவுகள் = மவ்வீறு ஒற்றழிந்து உயிரீறொப்பவும் விதிப்படி 'பூட்டுங்கதவுகள்' எனப் புணரும்."}}}
{"id":"b-tam-6t3-017","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 8"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தோரணமேடை’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"தோரணம் + மேடை"},{"key":"B","text":"தோரண + மேடை"},{"key":"C","text":"தோரணம் + ஒடை"},{"key":"D","text":"தோரணம் + ஓடை"}],"explanation":"தோரணம் + மேடை = மவ்வீறு ஒற்றழிந்து தோரணமேடை என்றானது."}}}
{"id":"b-tam-6t3-018","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 8"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வாசல் + அலங்காரம்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"வாசல்அலங்காரம்"},{"key":"B","text":"வாசலங்காரம்"},{"key":"C","text":"வாசலலங்காரம்"},{"key":"D","text":"வாசலிங்காரம்"}],"explanation":"உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே: ல் + அ = ல ஆகி, 'வாசலலங்காரம்' எனப் புணரும்."}}}
{"id":"b-tam-6t3-019","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"பாஞ்சாலங்குறிச்சியின் விந்தைகளாகக் கதைப்பாடல் குறிப்பிடும் பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"வீரம் மிகுந்த பாஞ்சாலங்குறிச்சியில் முயலானது வேட்டை நாயை எதிர்த்து விரட்டிவிடும்."},{"type":"statement","label":"II","text":"பசுவும் புலியும் நீர்நிலையின் ஒரே துறையில் நின்று பால் போன்ற தண்ணீரைக் குடிக்கும்."},{"type":"statement","label":"III","text":"கட்டபொம்மு துரை பெயர் சொன்னால் கறந்து வைத்த பாலைக்கூடக் காகம் குடிக்காது."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"பாஞ்சாலங்குறிச்சியின் வீர விந்தைகளாக இம்மூன்று நிகழ்வுகளும் பாடலில் தெளிவாகக் கூறப்பட்டுள்ளன."}}}
{"id":"b-tam-6t3-020","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"பாஞ்சாலங்குறிச்சி நாட்டிற்குத் திருவாக்கு அருள் செய்யும் காவல் தெய்வம் எது?"}],"options":[{"key":"A","text":"காளி தேவி"},{"key":"B","text":"மீனாட்சி அம்மன்"},{"key":"C","text":"சக்கதேவி (சக்கமாதேவி)"},{"key":"D","text":"மாரியம்மன்"}],"explanation":"'வரந்தருவாளே சக்க தேவி - திருவாக்கருள் செய்வாளே சக்க தேவி' எனப் பாடல் கூறுகிறது."}}}
{"id":"b-tam-6t3-021","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 8"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஊர்வலத்தின் முன்னால் ________ அசைந்து வந்தது’ - சரியான விடையைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"தோரணம்"},{"key":"B","text":"வானரம்"},{"key":"C","text":"வாரணம்"},{"key":"D","text":"சந்தனம்"}],"explanation":"வாரணம் என்றால் யானை. ஊர்வலத்தின் முன்னால் யானை (வாரணம்) அசைந்து வந்தது."}}}
{"id":"b-tam-6t3-022","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 5"},"texts":{"ta":{"blocks":[{"type":"text","text":"கதை தழுவிய நிலையில் அமையும் நாட்டுப்புறப் பாடல்கள் எவ்வாறு அழைக்கப்படுகின்றன?"}],"options":[{"key":"A","text":"தொழில் பாடல்"},{"key":"B","text":"கதைப்பாடல்"},{"key":"C","text":"தாலாட்டுப் பாடல்"},{"key":"D","text":"விளையாட்டுப் பாடல்"}],"explanation":"கதை தழுவிய நிலையில் அமையும் பாடல் கதைப்பாடல் எனப்படும்; இது சமூக, வரலாற்று, புராணக் கதைப்பாடல் என வகைப்படும்."}}}
