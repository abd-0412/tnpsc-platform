// பாடம் 3: தமிழ்நாட்டில் காந்தி (உரைநடை உலகம்) [Q023 - Q033]
// ஆடை எளிமை மாற்றம் (மதுரை 1921), ரௌலட் சட்டம் (இராஜாஜி இல்லம் 1919), பாரதியார் சந்திப்பு,
// கானாடுகாத்தான் அன்பர் வீடு, மீனாட்சியம்மன் கோவில், குற்றால அருவி, ஜி.யு. போப் தமிழ்க்கையேடு,
// உ.வே.சா (1937 சென்னை இலக்கிய மாநாடு), காந்தியடிகளின் தமிழ்க் கையெழுத்து
// ==============================================================================
{"id":"pyq-tam-6t3-023","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":31},"texts":{"ta":{"blocks":[{"type":"text","text":"காந்தியடிகளிடம் ஆடை அணிவதில் மிகச்சிறந்த எளிமை மாற்றத்தை ஏற்படுத்திய தமிழக ஊர் எது?"}],"options":[{"key":"A","text":"சென்னை"},{"key":"B","text":"மதுரை"},{"key":"C","text":"காரைக்குடி"},{"key":"D","text":"திருநெல்வேலி"}],"explanation":"1921 செப்டம்பரில் மதுரைக்குச் சென்றபோது ஏழை உழவர்களின் நிலையைக் கண்டு காந்தி வேட்டி, துண்டு மட்டுமே அணியத் தொடங்கினார்."}}}
{"id":"b-tam-6t3-024","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 9"},"texts":{"ta":{"blocks":[{"type":"text","text":"1919-ஆம் ஆண்டு பிப்ரவரி மாதம் ரௌலட் சட்டத்தை எதிர்ப்பது தொடர்பான ஆலோசனைக் கூட்டம் சென்னையில் யாருடைய வீட்டில் நடைபெற்றது?"}],"options":[{"key":"A","text":"இராஜாஜி"},{"key":"B","text":"பாரதியார்"},{"key":"C","text":"வ.உ.சிதம்பரனார்"},{"key":"D","text":"திரு.வி.க."}],"explanation":"ரௌலட் சட்டத்தை எதிர்க்கும் கருத்தாய்வுக் கூட்டம் சென்னையில் இராஜாஜியின் இல்லத்தில் நடைபெற்றது."}}}
{"id":"pyq-tam-6t3-025","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":45},"texts":{"ta":{"blocks":[{"type":"text","text":"பாரதியாரைச் சந்தித்த காந்தியடிகள், ‘இவர் எங்கள் தமிழ்நாட்டுக் கவிஞர்’ என இராஜாஜி அறிமுகப்படுத்தியபோது கூறிய கூற்று யாது?"}],"options":[{"key":"A","text":"இவர் ஒரு சிறந்த விடுதலைப் போராட்ட வீரர்"},{"key":"B","text":"இவரைப் பத்திரமாகப் பாதுகாக்க வேண்டும்"},{"key":"C","text":"இவரது பாடல்கள் புரட்சிகரமானவை"},{"key":"D","text":"இவரை டெல்லிக்கு அழைத்துச் செல்ல வேண்டும்"}],"explanation":"பாரதியாரைக் கண்ட காந்தியடிகள் 'இவர் யார்?' எனக் கேட்க, ராஜாஜி 'எங்கள் தமிழ்நாட்டுக் கவிஞர்' என்றார். உடனே காந்தி 'இவரைப் பத்திரமாகப் பாதுகாக்க வேண்டும்' என்றார்."}}}
{"id":"b-tam-6t3-026","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 10"},"texts":{"ta":{"blocks":[{"type":"text","text":"காந்தியடிகள் தமிழ்நாட்டில் நீளமான வேட்டி, மேல்சட்டை, பெரிய தலைப்பாகை அணிவதைத் துறந்து எப்போது வேட்டியும் துண்டும் மட்டுமே அணியத் தொடங்கினார்?"}],"options":[{"key":"A","text":"1919 பிப்ரவரி"},{"key":"B","text":"1920 ஆகஸ்ட்"},{"key":"C","text":"1921 செப்டம்பர்"},{"key":"D","text":"1937 ஏப்ரல்"}],"explanation":"1921-ஆம் ஆண்டு செப்டம்பர் மாதத்தில் காந்தியடிகள் மதுரைக்குச் சென்றபோது தமது தோற்றத்தை மாற்றிக்கொண்டார்."}}}
{"id":"b-tam-6t3-027","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 10"},"texts":{"ta":{"blocks":[{"type":"text","text":"காரைக்குடி அருகே கானாடுகாத்தான் ஊரில் தங்கியிருந்த அன்பர் வீட்டில் வெளிநாட்டு அலங்காரப் பொருள்களைப் பார்த்துக் காந்தி கூறிய அறிவுரை யாது?"}],"options":[{"key":"A","text":"வீட்டை உடனடியாக ஏலம் விடுங்கள்"},{"key":"B","text":"இதற்குச் செலவு செய்த பணத்தில் பத்தில் ஒரு பங்கு என்னிடம் கொடுத்தால் இதைவிட அழகாகச் செய்துவிடுவேன்"},{"key":"C","text":"வெளிநாட்டுப் பொருள்களைக் கடலில் எறியுங்கள்"},{"key":"D","text":"இந்திய கைத்தறி ஆடைகளை மட்டுமே அணியுங்கள்"}],"explanation":"பத்தில் ஒரு பங்கு பணத்தைக் கொடுத்தால் இதைவிட அழகாகச் செய்துவிடுவேன் என்றார்; மறுமுறை வந்தபோது அங்கு வெளிநாட்டுப் பொருள்கள் ஏதுமில்லை."}}}
{"id":"b-tam-6t3-028","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 11"},"texts":{"ta":{"blocks":[{"type":"text","text":"காந்தியடிகள் மதுரை மீனாட்சியம்மன் கோவிலுக்குள் முதலில் செல்ல மறுத்ததற்குக் காரணம் என்ன?"}],"options":[{"key":"A","text":"கோவிலில் வழிபட விருப்பமில்லை"},{"key":"B","text":"நேரமின்மை காரணமாக"},{"key":"C","text":"அக்கோவிலுக்குள் செல்ல எல்லா மக்களுக்கும் அனுமதி இல்லை என்பதால்"},{"key":"D","text":"ஆங்கிலேயர்களின் தடை இருந்ததால்"}],"explanation":"எல்லா மக்களுக்கும் அனுமதி இல்லாததால் நுழைய மறுத்தார்; பல ஆண்டுகளுக்குப் பின் அனைவருக்கும் அனுமதி வழங்கப்பட்ட பிறகே சென்றார்."}}}
{"id":"b-tam-6t3-029","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 11"},"texts":{"ta":{"blocks":[{"type":"text","text":"குற்றால அருவியில் நீராட அனைவருக்கும் உரிமை இருந்தும் காந்தியடிகள் அங்கு நீராட மறுத்ததன் காரணம் யாது?"}],"options":[{"key":"A","text":"அருவியில் வெள்ளம் அதிகமாக இருந்ததால்"},{"key":"B","text":"அருவிக்குச் செல்லும் வழியில் உள்ள கோவில் வழியாகச் செல்ல ஒருசாராருக்குத் தடை இருந்ததால்"},{"key":"C","text":"தண்ணீரின் குளிர்ச்சி காரணமாக"},{"key":"D","text":"உடல்நலக்குறைவு ஏற்பட்டதால்"}],"explanation":"அருவிக்குச் செல்லும் வழியிலுள்ள கோவிலில் ஒருசாராருக்குத் தடை இருந்ததை அறிந்து, தீண்டாமையை எதிர்த்து நீராட மறுத்தார்."}}}
{"id":"pyq-tam-6t3-030","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2018,"paper":"tamil","no":54},"texts":{"ta":{"blocks":[{"type":"text","text":"காந்தியடிகள் தென்னாப்பிரிக்காவில் வாழ்ந்த காலத்தில் தம்மைக் கவர்ந்ததாகக் குறிப்பிட்ட தமிழ் நூல் மற்றும் ஆசிரியர் யார்?"}],"options":[{"key":"A","text":"வீரமாமுனிவரின் தேம்பாவணி"},{"key":"B","text":"கால்டுவெல்லின் திராவிட மொழிகளின் ஒப்பிலக்கணம்"},{"key":"C","text":"ஜி.யு. போப் எழுதிய தமிழ்க்கையேடு"},{"key":"D","text":"சீகன் பால்குவின் தமிழ் அகராதி"}],"explanation":"காந்தியடிகள் ஜி.யு. போப் எழுதிய தமிழ்க்கையேடு தம்மைக் கவர்ந்ததாகவும், திருக்குறள் பெரிதும் கவர்ந்ததாகவும் கூறியுள்ளார்."}}}
{"id":"pyq-tam-6t3-031","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":16},"texts":{"ta":{"blocks":[{"type":"text","text":"1937-இல் சென்னையில் நடைபெற்ற இலக்கிய மாநாட்டில் ‘இந்தப் பெரியவரின் அடிநிழலில் இருந்து தமிழ் கற்க வேண்டும் என்னும் ஆவல் உண்டாகிறது’ என்று காந்தியடிகள் யாரைக் குறிப்பிட்டார்?"}],"options":[{"key":"A","text":"மறைமலையடிகள்"},{"key":"B","text":"திரு.வி.க."},{"key":"C","text":"உ.வே. சாமிநாதர்"},{"key":"D","text":"பாரதியார்"}],"explanation":"1937 இலக்கிய மாநாட்டின் வரவேற்புக்குழுத் தலைவராக இருந்த உ.வே.சாவின் உரையைக் கேட்டு மகிழ்ந்து காந்தியடிகள் இவ்வாறு கூறினார்."}}}
{"id":"b-tam-6t3-032","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 12"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ்நாட்டில் காந்தி பாட மதிப்பீட்டுப் பொருத்துகவைச் சரியாக இணைக்க:"},{"type":"list","name":"பட்டியல் I","items":[{"label":"A","text":"இலக்கிய மாநாடு"},{"label":"B","text":"தமிழ்நாட்டுக் கவிஞர்"},{"label":"C","text":"குற்றாலம்"},{"label":"D","text":"தமிழ்க் கையேடு"}]},{"type":"list","name":"பட்டியல் II","items":[{"label":"1","text":"பாரதியார்"},{"label":"2","text":"சென்னை (1937)"},{"label":"3","text":"ஜி.யு. போப்"},{"label":"4","text":"அருவி"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}}],"explanation":"இலக்கிய மாநாடு - சென்னை; தமிழ்நாட்டுக் கவிஞர் - பாரதியார்; குற்றாலம் - அருவி; தமிழ்க் கையேடு - ஜி.யு. போப்."}}}
{"id":"b-tam-6t3-033","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 11"},"texts":{"ta":{"blocks":[{"type":"text","text":"காந்தியடிகள் தம் கையெழுத்தை எந்த மொழியில் இடுவதை வழக்கமாகக் கொண்டிருந்தார் எனப் பாடநூல் படம் காட்டுகிறது?"}],"options":[{"key":"A","text":"ஆங்கிலம் (M.K. Gandhi)"},{"key":"B","text":"தமிழ் (மோ.க. காந்தி)"},{"key":"C","text":"குஜராத்தி"},{"key":"D","text":"இந்தி"}],"explanation":"பாடநூல் பக்கம் 11-ல் காந்தியடிகளின் தமிழ்க் கையெழுத்து 'மோ.க. காந்தி' எனக் காட்சிப்படுத்தப்பட்டுள்ளது."}}}
