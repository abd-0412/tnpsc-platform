// பாடம் 6: மொழியை ஆள்வோம், கலைச்சொற்கள் & கூடுதல் வினாக்கள் [Q057 - Q070]
// வ.உ.சிதம்பரனார் (சுதேசி நாவாய்ச் சங்கம் 1906, பாரதியார்), அகரவரிசை, கலைச்சொற்கள், புணர்ச்சி,
// அஃறிணைப் பன்மை வினைமுற்று, சுட்டு/வினா கூடுதல் வினாக்கள், வேலுநாச்சியார் & காந்தி அருங்காட்சியகம்
// ==============================================================================
{"id":"b-tam-6t3-057","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 20"},"texts":{"ta":{"blocks":[{"type":"text","text":"வ.உ.சிதம்பரனார் ‘சுதேசி நாவாய்ச் சங்கம்’ என்ற உள்நாட்டு இந்தியக் கப்பல் நிறுவனத்தைப் பதிவு செய்த நாள் எது?"}],"options":[{"key":"A","text":"1905 அக்டோபர் 16"},{"key":"B","text":"1906 அக்டோபர் 16"},{"key":"C","text":"1907 நவம்பர் 18"},{"key":"D","text":"1908 மார்ச் 12"}],"explanation":"வ.உ.சி. 1906-ஆம் ஆண்டு அக்டோபர் 16-ஆம் நாள் சுதேசி நாவாய்ச் சங்கத்தைப் பதிவு செய்தார்."}}}
{"id":"b-tam-6t3-058","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 20"},"texts":{"ta":{"blocks":[{"type":"text","text":"வ.உ.சிதம்பரனார் சென்னைக்குச் செல்லும்போது யாரைச் சந்திப்பதை வழக்கமாகக் கொண்டிருந்தார்?"}],"options":[{"key":"A","text":"காந்தியடிகள்"},{"key":"B","text":"மகாகவி பாரதியார்"},{"key":"C","text":"இராஜாஜி"},{"key":"D","text":"உ.வே.சா"}],"explanation":"வ.உ.சி. சென்னை செல்லும்போது பாரதியாரைச் சந்திப்பதையும் அவரது பாடல்களைக் கேட்பதையும் வழக்கமாகக் கொண்டிருந்தார்."}}}
{"id":"b-tam-6t3-059","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 21"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பழங்கள், பாரதம், பின்னிரவு, பீலி, புதுமை, பூமி, பேருந்து, பையன், போக்குவரத்து, பொதுக்கூட்டம்’ - சரியான அகரவரிசை எது?"}],"options":[{"key":"A","text":"பாரதம், பழங்கள், பீலி, பின்னிரவு, புதுமை, பூமி, பேருந்து, பையன், பொதுக்கூட்டம், போக்குவரத்து"},{"key":"B","text":"பழங்கள், பாரதம், பின்னிரவு, பீலி, புதுமை, பூமி, பேருந்து, பையன், பொதுக்கூட்டம், போக்குவரத்து"},{"key":"C","text":"பழங்கள், பாரதம், பீலி, பின்னிரவு, பூமி, புதுமை, பையன், பேருந்து, போக்குவரத்து, பொதுக்கூட்டம்"},{"key":"D","text":"பின்னிரவு, பீலி, பழங்கள், பாரதம், புதுமை, பூமி, பேருந்து, பையன், பொதுக்கூட்டம், போக்குவரத்து"}],"explanation":"ப, பா, பி, பீ, பு, பூ, பே, பை, பொ, போ என்ற உயிர்மெய் அகரவரிசைப்படி அமைந்தது."}}}
{"id":"b-tam-6t3-060","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"3","C":"4","D":"1"}},"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 22"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஆங்கிலக் கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"},{"type":"list","name":"ஆங்கிலச் சொல்","items":[{"label":"A","text":"Patriotism"},{"label":"B","text":"Art Gallery"},{"label":"C","text":"Knowledge of Reality"},{"label":"D","text":"Literature"}]},{"type":"list","name":"தமிழாக்கம்","items":[{"label":"1","text":"இலக்கியம்"},{"label":"2","text":"நாட்டுப்பற்று"},{"label":"3","text":"கலைக்கூடம்"},{"label":"4","text":"மெய்யுணர்வு"}]}],"options":[{"key":"A","text":"A-2, B-3, C-4, D-1","mapping":{"A":"2","B":"3","C":"4","D":"1"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"D","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}}],"explanation":"Patriotism = நாட்டுப்பற்று; Art Gallery = கலைக்கூடம்; Knowledge of Reality = மெய்யுணர்வு; Literature = இலக்கியம்."}}}
{"id":"b-tam-6t3-061","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 21"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வடக்கு + உண்டு’ மற்றும் ‘பந்து + இல்லை’ ஆகிய சொற்கள் புணர்ந்து உருவாகும் புதிய சொற்கள் எவை?"}],"options":[{"key":"A","text":"வடக்குண்டு, பந்தில்லை"},{"key":"B","text":"வடக்கு உண்டு, பந்து இல்லை"},{"key":"C","text":"வடக்குண்டு, பந்தில்ல"},{"key":"D","text":"வடக்குஉண்டு, பந்துஇல்லை"}],"explanation":"உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி உ கெட்டு, க் + உ = கு, த் + இ = தி ஆகி வடக்குண்டு, பந்தில்லை எனப் புணரும்."}}}
{"id":"b-tam-6t3-062","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 22"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மாடுகள் வீட்டுக்கு ________’ - சரியான வினைமுற்றைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"வந்தது"},{"key":"B","text":"வந்தன"},{"key":"C","text":"வந்தார்கள்"},{"key":"D","text":"வந்தாள்"}],"explanation":"மாடுகள் என்பது அஃறிணைப் பன்மைப் பெயர்ச்சொல்; எனவே 'வந்தன' என்ற வினைமுற்றே பொருந்தும்."}}}
{"id":"b-tam-6t3-063","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 17"},"texts":{"ta":{"blocks":[{"type":"text","text":"கீழ்க்கண்டவற்றுள் அண்மைச்சுட்டுச் சொல்லாக அமைவது எது?"}],"options":[{"key":"A","text":"அவன்"},{"key":"B","text":"அங்கு"},{"key":"C","text":"இவர்"},{"key":"D","text":"அந்த"}],"explanation":"அருகில் உள்ளவரைக் குறிக்கும் 'இவர்' என்பது அண்மைச்சுட்டுச் சொல் ஆகும்."}}}
{"id":"b-tam-6t3-064","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 18"},"texts":{"ta":{"blocks":[{"type":"text","text":"சொல்லின் முதலில் மட்டுமே வரக்கூடிய வினா எழுத்துகள் எவை?"}],"options":[{"key":"A","text":"ஆ, ஓ"},{"key":"B","text":"எ, யா"},{"key":"C","text":"ஏ, ஓ"},{"key":"D","text":"அ, இ"}],"explanation":"எ, யா ஆகிய இரண்டும் சொல்லின் முதலில் மட்டுமே வரும் வினா எழுத்துகள் ஆகும் (எ.கா: எங்கு, யாருக்கு)."}}}
{"id":"b-tam-6t3-065","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 18"},"texts":{"ta":{"blocks":[{"type":"text","text":"சொல்லின் இறுதியில் மட்டுமே வரக்கூடிய வினா எழுத்துகள் எவை?"}],"options":[{"key":"A","text":"எ, யா"},{"key":"B","text":"ஆ, ஓ"},{"key":"C","text":"ஏ"},{"key":"D","text":"உ"}],"explanation":"ஆ, ஓ ஆகிய இரண்டும் சொல்லின் இறுதியில் மட்டுமே வரும் வினா எழுத்துகள் ஆகும் (எ.கா: பேசலாமா? தெரியுமோ?)."}}}
{"id":"b-tam-6t3-066","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":true,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 13"},"texts":{"ta":{"blocks":[{"type":"text","text":"வேலுநாச்சியார் முறையாகக் கற்றுத் தேர்ந்த தற்காப்புக் கலைகளில் பொருந்தாதது எது?"}],"options":[{"key":"A","text":"சிலம்பம், குதிரையேற்றம்"},{"key":"B","text":"மல்யுத்தம், சுருள்வாள்"},{"key":"C","text":"வாள்போர், விற்பயிற்சி"},{"key":"D","text":"சிலம்பம், வாள்போர்"}],"explanation":"சிலம்பம், குதிரையேற்றம், வாள்போர், விற்பயிற்சி ஆகியவற்றை முறையாகக் கற்றுக் கொண்டார் எனப் பாடத்தில் உள்ளது."}}}
{"id":"b-tam-6t3-067","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 14"},"texts":{"ta":{"blocks":[{"type":"text","text":"சிவகங்கையை மீட்பதற்கு முன்பாக வேலுநாச்சியார் முதலில் எந்த ஊரைக் கைப்பற்ற வேண்டும் என்று முடிவு செய்தார்?"}],"options":[{"key":"A","text":"திருப்பத்தூர்"},{"key":"B","text":"காளையார்கோவில்"},{"key":"C","text":"இராமநாதபுரம்"},{"key":"D","text":"திண்டுக்கல்"}],"explanation":"'என் கணவர் கொல்லப்பட்ட ஊர் காளையார்கோவில். எனவே நாம் முதலில் காளையார்கோவிலைக் கைப்பற்றுவோம்' என்றார்."}}}
{"id":"b-tam-6t3-068","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 9"},"texts":{"ta":{"blocks":[{"type":"text","text":"மதுரையில் அமைந்துள்ள காந்தியடிகளின் வரலாற்று அருங்காட்சியகம் எங்கு அமைந்துள்ளது எனப் பாடநூல் படம் உணர்த்துகிறது?"}],"options":[{"key":"A","text":"சென்னை அண்ணா சாலை"},{"key":"B","text":"திருச்சி மலைக்கோட்டை"},{"key":"C","text":"மதுரை (இராணி மங்கம்மாள் அரண்மனை வளாகம்)"},{"key":"D","text":"கன்னியாகுமரி"}],"explanation":"பக்கம் 9-ல் உள்ள படம் 'மதுரையில் உள்ள காந்தி அருங்காட்சியகம்' ஆகும்."}}}
{"id":"b-tam-6t3-069","kind":"assertion_reason","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 16"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"வேலுநாச்சியார் சிவகங்கைக் கோட்டையை எளிதில் கைப்பற்றி வெற்றி பெற்றார்."},{"type":"reason","text":"குயிலி தன் உடலில் தீ வைத்துக் கொண்டு ஆங்கிலேயரின் ஆயுதக் கிடங்கில் குதித்து அதனை அழித்ததால் ஆங்கிலேயப் படை நிலை குலைந்தது."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"குயிலியின் தற்கொலைப்படைத் தியாகத்தால் ஆயுதக் கிடங்கு தீக்கிரையானதே ஆங்கிலேயர் தோற்று ஓட முதன்மைக் காரணமானது."}}}
{"id":"b-tam-6t3-070","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 18"},"texts":{"ta":{"blocks":[{"type":"text","text":"சொல்லின் முதலிலும் இறுதியிலும் வரக்கூடிய ஒரே வினா எழுத்து எது?"}],"options":[{"key":"A","text":"ஆ"},{"key":"B","text":"ஏ (எ.கா: ஏன், நீதானே)"},{"key":"C","text":"ஓ"},{"key":"D","text":"யா"}],"explanation":"'ஏ' என்னும் எழுத்து மொழி முதலிலும் வரும் (ஏன்?), இறுதியிலும் வரும் (நீதானே? த்+ஏ=தே)."}}}
