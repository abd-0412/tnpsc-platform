// பாடம் 5: நால்வகைச் சொற்கள் / சுட்டு எழுத்துகள் & வினா எழுத்துகள் (கற்கண்டு - இலக்கணம்) [Q045 - Q056]
// சுட்டு எழுத்துகள் (3: அ, இ, உ), அகச்சுட்டு, புறச்சுட்டு, உ சுட்டு, அண்மை/சேய்மைச் சுட்டு,
// சுட்டுத்திரிபு, வினா எழுத்துகள் (5: எ, யா, ஆ, ஓ, ஏ), அகவினா, புறவினா, தொடர் நிரப்புதல்
// ==============================================================================
{"id":"b-tam-6t3-045","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 17"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ் மொழியில் ஒன்றைச் சுட்டிக்காட்ட வரும் ‘சுட்டு எழுத்துகள்’ மொத்தம் எத்தனை?"}],"options":[{"key":"A","text":"இரண்டு (அ, இ)"},{"key":"B","text":"நான்கு (அ, இ, உ, எ)"},{"key":"C","text":"மூன்று (அ, இ, உ)"},{"key":"D","text":"ஐந்து (அ, இ, உ, எ, ஏ)"}],"explanation":"சுட்டு எழுத்துகள் மூன்று: அ, இ, உ. ஆனால் இன்று 'உ' என்னும் எழுத்தைச் சுட்டாகப் பயன்படுத்துவது இல்லை."}}}
{"id":"b-tam-6t3-046","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 17"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இவன், அவன், இது, அது’ - இச்சொற்களில் சுட்டு எழுத்துகளை நீக்கினால் பிற எழுத்துகள் பொருள் தருவதில்லை; இது எவ்வகைச் சுட்டு?"}],"options":[{"key":"A","text":"புறச்சுட்டு"},{"key":"B","text":"அகச்சுட்டு"},{"key":"C","text":"அண்மைச்சுட்டு"},{"key":"D","text":"சுட்டுத்திரிபு"}],"explanation":"சுட்டு எழுத்துகள் சொல்லின் உள்ளேயே (அகத்தே) இருந்து சுட்டுப் பொருளைத் தருவது 'அகச்சுட்டு' எனப்படும்."}}}
{"id":"b-tam-6t3-047","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 17"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அவ்வானம், இம்மலை, இந்நூல்’ - இச்சொற்களில் உள்ள சுட்டு எழுத்துகளை நீக்கினாலும் பிற எழுத்துகள் பொருள் தரும்; இது எவ்வகைச் சுட்டு?"}],"options":[{"key":"A","text":"புறச்சுட்டு"},{"key":"B","text":"அகச்சுட்டு"},{"key":"C","text":"சேய்மைச்சுட்டு"},{"key":"D","text":"சுட்டுத்திரிபு"}],"explanation":"சுட்டு எழுத்துகள் சொல்லின் வெளியே (புறத்தே) நின்று பொருளைத் தருவது 'புறச்சுட்டு' எனப்படும்."}}}
{"id":"b-tam-6t3-048","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 17"},"texts":{"ta":{"blocks":[{"type":"text","text":"அருகில் உள்ளவற்றையும் தொலைவில் உள்ளவற்றிற்கும் இடையில் இருப்பதைச் சுட்டிக்காட்ட அக்காலத்தில் பயன்பட்ட சுட்டெழுத்து எது?"}],"options":[{"key":"A","text":"அ"},{"key":"B","text":"உ (எ.கா: உது, உவன்)"},{"key":"C","text":"இ"},{"key":"D","text":"எ"}],"explanation":"தெரிந்து தெளிவோம் குறிப்பின்படி, அண்மைக்கும் சேய்மைக்கும் இடையில் உள்ளதைச் சுட்ட 'உ' பயன்பட்டது (உது, உவன், உப்பக்கம்)."}}}
{"id":"b-tam-6t3-049","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 17"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அண்மைச்சுட்டு’ மற்றும் ‘சேய்மைச்சுட்டு’ ஆகியவற்றிற்குரிய சுட்டு எழுத்துகள் முறையே எவை?"}],"options":[{"key":"A","text":"அ, இ"},{"key":"B","text":"இ, அ"},{"key":"C","text":"உ, அ"},{"key":"D","text":"எ, ஏ"}],"explanation":"அண்மையில் உள்ளதைச் சுட்ட 'இ' (இவன், இது); சேய்மையில் (தொலைவில்) உள்ளதைச் சுட்ட 'அ' (அவள், அது) பயன்படும்."}}}
{"id":"b-tam-6t3-050","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 18"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அம்மரம், இவ்வீடு’ ஆகிய சொற்கள் ‘அந்த மரம், இந்த வீடு’ எனத் திரிந்து வழங்குவது எவ்வகைப் பெயர் பெறும்?"}],"options":[{"key":"A","text":"அகச்சுட்டு"},{"key":"B","text":"புறச்சுட்டு"},{"key":"C","text":"சுட்டுத்திரிபு"},{"key":"D","text":"அண்மைச்சுட்டு"}],"explanation":"அ, இ ஆகிய சுட்டு எழுத்துகள் மாற்றம் பெற்று (திரிந்து) அந்த, இந்த என வழங்குவது 'சுட்டுத்திரிபு' எனப்படும்."}}}
{"id":"pyq-tam-6t3-051","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":72},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ் மொழியில் வினாப் பொருளைத் தரும் ‘வினா எழுத்துகள்’ மொத்தம் எத்தனை?"}],"options":[{"key":"A","text":"மூன்று"},{"key":"B","text":"ஐந்து (எ, யா, ஆ, ஓ, ஏ)"},{"key":"C","text":"நான்கு"},{"key":"D","text":"ஆறு"}],"explanation":"எ, யா, ஆ, ஓ, ஏ ஆகிய ஐந்தும் தமிழ் மொழியின் வினா எழுத்துகள் ஆகும்."}}}
{"id":"b-tam-6t3-052","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"3","C":"1"}},"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 18"},"texts":{"ta":{"blocks":[{"type":"text","text":"வினா எழுத்துகள் சொல்லில் இடம்பெறும் முறையைச் சரியாகப் பொருத்துக:"},{"type":"list","name":"இடம்பெறும் முறை","items":[{"label":"A","text":"மொழியின் முதலில் வருபவை"},{"label":"B","text":"மொழியின் இறுதியில் வருபவை"},{"label":"C","text":"மொழி முதலிலும் இறுதியிலும் வருபவை"}]},{"type":"list","name":"வினா எழுத்துகள்","items":[{"label":"1","text":"ஏ (ஏன், நீதானே)"},{"label":"2","text":"எ, யா (எங்கு, யாருக்கு)"},{"label":"3","text":"ஆ, ஓ (பேசலாமா, தெரியுமோ)"}]}],"options":[{"key":"A","text":"A-2, B-3, C-1","mapping":{"A":"2","B":"3","C":"1"}},{"key":"B","text":"A-1, B-2, C-3","mapping":{"A":"1","B":"2","C":"3"}},{"key":"C","text":"A-3, B-1, C-2","mapping":{"A":"3","B":"1","C":"2"}},{"key":"D","text":"A-2, B-1, C-3","mapping":{"A":"2","B":"1","C":"3"}}],"explanation":"மொழி முதலில் வருபவை: எ, யா; இறுதியில் வருபவை: ஆ, ஓ; முதலிலும் இறுதியிலும் வருவது: ஏ."}}}
{"id":"b-tam-6t3-053","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 18"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எது, யார், ஏன்’ - இச்சொற்களில் உள்ள வினா எழுத்துகளை நீக்கினால் பொருள் தராமல், சொல்லின் அகத்தே நின்று வினாப் பொருள் தருவது எது?"}],"options":[{"key":"A","text":"புறவினா"},{"key":"B","text":"அகவினா"},{"key":"C","text":"சுட்டுத்திரிபு"},{"key":"D","text":"அகச்சுட்டு"}],"explanation":"வினா எழுத்துகள் சொல்லின் அகத்தே இருந்து வினாப் பொருளைத் தருவது 'அகவினா' எனப்படும்."}}}
{"id":"b-tam-6t3-054","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 19"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அவனா? வருவானோ?’ - இச்சொற்களில் உள்ள ஆ, ஓ ஆகிய வினா எழுத்துகளை நீக்கினாலும் பிற எழுத்துகள் பொருள் தரும்; இது எவ்வகை வினா?"}],"options":[{"key":"A","text":"புறவினா"},{"key":"B","text":"அகவினா"},{"key":"C","text":"சுட்டுத்திரிபு"},{"key":"D","text":"புறச்சுட்டு"}],"explanation":"வினா எழுத்துகள் சொல்லின் புறத்தே வந்து வினாப் பொருளைத் தருவது 'புறவினா' எனப்படும்."}}}
{"id":"b-tam-6t3-055","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 19"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘என் வீடு ________ உள்ளது; தம்பி ________ வா’ - மதிப்பீட்டுப் பகுதிக்குரிய சரியான விடை இணை எது?"}],"options":[{"key":"A","text":"அது, இவர்"},{"key":"B","text":"அங்கே, இங்கே"},{"key":"C","text":"அங்கே, அவர்"},{"key":"D","text":"அது, இங்கே"}],"explanation":"என் வீடு அங்கே உள்ளது; தம்பி இங்கே வா."}}}
{"id":"b-tam-6t3-056","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 1, பக்கம் 19"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நீர் ________ தேங்கி இருக்கிறது? யார் ________ தெரியுமா?’ - சரியான சொற்களைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"அது, யாது"},{"key":"B","text":"எங்கே, என்று"},{"key":"C","text":"எங்கே, அவர்"},{"key":"D","text":"அது, அவர்"}],"explanation":"நீர் எங்கே தேங்கி இருக்கிறது? யார் அவர் தெரியுமா?"}}}
