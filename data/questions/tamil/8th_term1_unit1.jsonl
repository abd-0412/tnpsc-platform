// பாடம் 11: திருக்குறள் (வாழ்வியல் / நீதி இலக்கியம்) [Q065 - Q066]
// தக்கார் தகவிலர் என்பது அவரவர் எச்சத்தால் காணப் படும் (நடுவுநிலைமை), சமன்செய்து சீர்தூக்கும் கோல்போல் (உவமையணி)
// ==============================================================================
{"id":"b-tam-8t1-065","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தக்கார் தகவிலர் என்பது அவரவர் எச்சத்தால் காணப் படும்’ - நடுவுநிலைமையை அறியும் வழி யாக வள்ளுவர் எதனைக் குறிப்பிடுகிறார்?"}],"options":[{"key":"A","text":"அரசின் தண்டனை"},{"key":"B","text":"அவரவருக்குப் பின் எஞ்சி நிற்கும் புகழினாலும் பழியினாலும்"},{"key":"C","text":"அவர்களின் செல்வப் பெருக்கினால்"},{"key":"D","text":"அவர்களின் தோற்றத்தால்"}],"explanation":"ஒருவர் நடுவுநிலைமை உடையவரா இல்லையா என்பது அவர் இறந்தபின் நிற்கும் புகழினாலும் பழியினாலும் அறியப்படும்."}}}
{"id":"b-tam-8t1-066","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சமன்செய்து சீர்தூக்கும் கோல்போல் அமைந்துஒருபால் கோடாமை சான்றோர்க்கு அணி’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?"}],"options":[{"key":"A","text":"உருவக அணி"},{"key":"B","text":"உவமையணி (போல் என்னும் உவம உருபு வெளிப்படையாக வந்தது)"},{"key":"C","text":"பிறிதுமொழிதல் அணி"},{"key":"D","text":"இல்பொருள் உவமையணி"}],"explanation":"துலாக்கோல் போல நடுவுநிலைமையுடன் கோடாமை சான்றோர்க்கு அழகு என வந்துள்ளதால் இது உவமையணி ஆகும்."}}}
