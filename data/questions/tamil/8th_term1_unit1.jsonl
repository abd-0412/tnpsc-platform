// பாடம் 3: தமிழ் வரிவடிவ வளர்ச்சி (உரைநடை உலகம்) [Q017 - Q030]
// தொடக்க காலச் சைகைகள், ஓவிய எழுத்து (Pictograph), கல்வெட்டுகள் (கி.மு. 3) & செப்பேடுகள் (கி.பி. 7),
// வட்டெழுத்து (PYQ 2019), சேர பாண்டிய மண்டல வட்டெழுத்துகள் (8 - 11 நூற்றாண்டு),
// கண்ணெழுத்து (சிலப்பதிகாரம் 'கண்ணெழுத்துப் படுத்த எண்ணுப் பல்பொதி'), அரச்சலூர் கல்வெட்டு (இருவகை எழுத்துகள்),
// ஐராவதம் மகாதேவன் ('Early Tamil Epigraphy'), எகர ஒகர புள்ளி எழுத்துகள், பகரத்தினுள் புள்ளி (மகரம்),
// வீரமாமுனிவர் எழுத்துச் சீர்திருத்தம் (PYQ 2022), தந்தை பெரியார் எழுத்துச் சீர்திருத்தம் (1978 - PYQ 2018),
// அச்சுக்கலை மற்றும் நிலையான வரிவடிவம்
// ==============================================================================
{"id":"b-tam-8t1-017","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 8"},"texts":{"ta":{"blocks":[{"type":"text","text":"மனிதன் தன் கருத்துகளைத் தெரிவிக்கத் தொடக்க காலத்தில் எதனைப் பயன்படுத்தினான்?"}],"options":[{"key":"A","text":"எழுத்துகளைப் பொறித்தான்"},{"key":"B","text":"சைகைகளைப் பயன்படுத்தினான்"},{"key":"C","text":"புத்தகங்களை எழுதினான்"},{"key":"D","text":"ஓவியம் வரைந்தான்"}],"explanation":"மனிதன் தோன்றிய காலத்தில் தனது தேவைகளையும் கருத்துகளையும் வெளிப்படுத்தச் சைகைகளையே முதலில் பயன்படுத்தினான்."}}}
{"id":"b-tam-8t1-018","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 8"},"texts":{"ta":{"blocks":[{"type":"text","text":"தொடக்க காலத்தில் எழுத்து என்பது ஒலியையோ வடிவத்தையோ குறிக்காமல் எதைக் குறிக்கும் ஓவிய வடிவமாக இருந்தது?"}],"options":[{"key":"A","text":"ஒலியின் வடிவம்"},{"key":"B","text":"பொருளின் ஓவிய வடிவம் (ஓவிய எழுத்து)"},{"key":"C","text":"எண்ணிக்கையின் குறிப்பீடு"},{"key":"D","text":"இயற்கையின் தோற்றம்"}],"explanation":"தொடக்க காலத்தில் எழுத்து பொருளின் ஓவிய வடிவமாக (Pictograph) இருந்தது; இதுவே ஓவிய எழுத்து எனப்படும்."}}}
{"id":"b-tam-8t1-019","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 9"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ் எழுத்துகளின் பழைய வரிவடிவங்களை எவற்றின் மூலம் அறிய முடிகிறது?"}],"options":[{"key":"A","text":"ஓலைச்சுவடிகள் மட்டும்"},{"key":"B","text":"கருங்கல் சுவர்களிலுள்ள கல்வெட்டுகள் மற்றும் செப்பேடுகள்"},{"key":"C","text":"நவீன அச்சு நூல்கள்"},{"key":"D","text":"பழங்காலத் துணி ஓவியங்கள்"}],"explanation":"கல்வெட்டுகள் (கி.மு. 3-ஆம் நூற்றாண்டு முதல்), செப்பேடுகள் (கி.பி. 7-ஆம் நூற்றாண்டு முதல்) மூலம் அறியலாம்."}}}
{"id":"pyq-tam-8t1-020","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":25},"texts":{"ta":{"blocks":[{"type":"text","text":"வளைந்த கோடுகளால் அமைந்த மிகப்பழைய தமிழ் எழுத்து வடிவம் எவ்வாறு அழைக்கப்படுகிறது?"}],"options":[{"key":"A","text":"தமிழி எழுத்து"},{"key":"B","text":"வட்டெழுத்து"},{"key":"C","text":"கண்ணெழுத்து"},{"key":"D","text":"பிராம்மி எழுத்து"}],"explanation":"வட்டெழுத்து என்பது வளைந்த கோடுகளால் அமைந்த மிகப்பழைய தமிழ் எழுத்து ஆகும்."}}}
{"id":"b-tam-8t1-021","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 9"},"texts":{"ta":{"blocks":[{"type":"text","text":"சேர மண்டலம், பாண்டிய மண்டலம் ஆகிய பகுதிகளில் எந்த நூற்றாண்டுகள் வரை வட்டெழுத்துகள் பயன்பாட்டில் இருந்தன?"}],"options":[{"key":"A","text":"கி.பி. 5 முதல் 8 வரை"},{"key":"B","text":"கி.பி. எட்டாம் நூற்றாண்டு முதல் பதினொன்றாம் நூற்றாண்டு வரை"},{"key":"C","text":"கி.பி. 12 முதல் 15 வரை"},{"key":"D","text":"கி.பி. 10 முதல் 14 வரை"}],"explanation":"சேர, பாண்டிய மண்டலங்களில் 8 முதல் 11-ஆம் நூற்றாண்டு வரை வட்டெழுத்துகளே சாசனங்களில் இடம்பெற்றுள்ளன."}}}
{"id":"b-tam-8t1-022","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 9"},"texts":{"ta":{"blocks":[{"type":"text","text":"சிலப்பதிகாரத்தில் ‘கண்ணெழுத்துப் படுத்த எண்ணுப் பல்பொதி’ என்னும் தொடரில் இடம்பெற்றுள்ள ‘கண்ணெழுத்து’ குறிப்பது யாது?"}],"options":[{"key":"A","text":"கண்களால் எழுதும் முறை"},{"key":"B","text":"கடைச்சங்க காலத்தில் தமிழகத்தில் எழுதப்பட்ட எழுத்துகள்"},{"key":"C","text":"அசோகர் காலத்து பிராம்மி எழுத்து"},{"key":"D","text":"ஓலைச்சுவடி எழுத்து"}],"explanation":"கடைச்சங்க காலத்தில் தமிழகத்தில் எழுதப்பட்ட எழுத்துகள் 'கண்ணெழுத்துகள்' என அழைக்கப்பட்டன (சிலம்பு 5:112)."}}}
{"id":"b-tam-8t1-023","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 9"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ்மொழியை எழுத இருவகை எழுத்துகள் வழக்கிலிருந்தன என்பதை உணர்த்தும் கல்வெட்டு எது?"}],"options":[{"key":"A","text":"மாங்குளம் கல்வெட்டு"},{"key":"B","text":"அரச்சலூர் கல்வெட்டு"},{"key":"C","text":"புகழூர் கல்வெட்டு"},{"key":"D","text":"உத்திரமேரூர் கல்வெட்டு"}],"explanation":"அரச்சலூர் கல்வெட்டில் தமிழ் எழுத்தும் வட்டெழுத்தும் கலந்து எழுதப்பட்டுள்ளதால் இருவகை எழுத்துகள் வழக்கிலிருந்தமை அறியப்படும்."}}}
{"id":"b-tam-8t1-024","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 9"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ்ப் பிராம்மி வரிவடிவம் குறித்த ஐராவதம் மகாதேவனின் ஆய்வு நூலின் தகவல்களை ஆராய்க:"},{"type":"statement","label":"I","text":"தென்தமிழகக் கல்வெட்டுகளில் பிராம்மியுடன் தமிழி, தரமிழி, திராவிடி வரிவடிவங்களும் காணப்படுகின்றன."},{"type":"statement","label":"II","text":"சங்ககாலக் கல்வெட்டு வரிவடிவம் அசோகர் காலப் பிராம்மியிலிருந்து வேறுபட்டது."},{"type":"statement","label":"III","text":"இச்செய்தியை ‘எர்லி தமிழ் எபிகிராபி’ (Early Tamil Epigraphy) என்னும் ஆய்வு நூலில் ஐராவதம் மகாதேவன் தெளிவுபடுத்துகிறார்."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"ஐராவதம் மகாதேவனின் ஆய்வு நூல் மற்றும் தமிழ்ப் பிராம்மி பற்றிய மூன்று கூற்றுகளும் முற்றிலும் சரியானவை."}}}
{"id":"b-tam-8t1-025","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 10"},"texts":{"ta":{"blocks":[{"type":"text","text":"தொல்காப்பியர் காலம் முதல் எகர ஒகர குறில் எழுத்துகளைக் குறிக்க எங்குப் புள்ளி வைக்கும் வழக்கம் இருந்தது?"}],"options":[{"key":"A","text":"எழுத்தின் முன்னால்"},{"key":"B","text":"எழுத்துகளின் மேல் புள்ளி வைக்கும் வழக்கம்"},{"key":"C","text":"எழுத்தின் கீழே"},{"key":"D","text":"எழுத்தின் பக்கத்தில்"}],"explanation":"எகர ஒகர குறில் எழுத்தைக் குறிக்க எழுத்தின் மேல் புள்ளி வைப்பது தொல்காப்பியர் காலம் தொட்டு இருந்துள்ளது (எ.கா: எது - ஏது)."}}}
{"id":"b-tam-8t1-026","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 10"},"texts":{"ta":{"blocks":[{"type":"text","text":"பழங்காலத்தில் மகர எழுத்தைக் குறிப்பிட எந்த எழுத்தின் உள்ளே புள்ளி இடும் வழக்கம் இருந்தது?"}],"options":[{"key":"A","text":"ககர எழுத்து"},{"key":"B","text":"மகர எழுத்து"},{"key":"C","text":"பகர எழுத்தின் உள்ளே புள்ளி (ப)"},{"key":"D","text":"வகர எழுத்து"}],"explanation":"மகர எழுத்தைக் குறிக்கப் பகர எழுத்தின் உள்ளே புள்ளி (ப) இட்டனர்."}}}
{"id":"pyq-tam-8t1-027","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":71},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ் எழுத்துகளில் மிகப்பெரும் சீர்திருத்தத்தைச் செய்தவர் யார்?"}],"options":[{"key":"A","text":"தந்தை பெரியார்"},{"key":"B","text":"வீரமாமுனிவர்"},{"key":"C","text":"அருட்கலைஞர்"},{"key":"D","text":"பவநந்தி முனிவர்"}],"explanation":"எகர ஒகர வரிசை எழுத்துகளில் புள்ளிகளால் ஏற்படும் குழப்பங்களை நீக்கி மிகப்பெரிய சீர்திருத்தம் செய்தவர் வீரமாமுனிவர் ஆவார்."}}}
{"id":"pyq-tam-8t1-028","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2018,"paper":"tamil","no":18},"texts":{"ta":{"blocks":[{"type":"text","text":"இருபதாம் நூற்றாண்டில் தமிழ் எழுத்துகளில் சீர்திருத்தம் செய்த தந்தை பெரியாரின் எழுத்துகள் எப்போது தமிழ்நாடு அரசால் நடைமுறைப்படுத்தப்பட்டன?"}],"options":[{"key":"A","text":"1950"},{"key":"B","text":"1965"},{"key":"C","text":"1978"},{"key":"D","text":"1985"}],"explanation":"தந்தை பெரியாரின் நூற்றாண்டு விழாவையொட்டி (1978-ஆம் ஆண்டு), அவரது எழுத்துச் சீர்திருத்தங்கள் தமிழ்நாடு அரசால் அதிகாரப்பூர்வமாக நடைமுறைப்படுத்தப்பட்டன."}}}
{"id":"b-tam-8t1-029","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 12"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ் எழுத்துகள் இப்போதுள்ள நிலையான வடிவத்தைப் பெறக் காரணமாக அமைந்த கலை எது?"}],"options":[{"key":"A","text":"ஓவியக்கலை"},{"key":"B","text":"சிற்பக்கலை"},{"key":"C","text":"அச்சுக்கலை"},{"key":"D","text":"கட்டடக் கலை"}],"explanation":"அச்சுக்கலை தோன்றிய பிறகே தமிழ் எழுத்துகள் இப்போதுள்ள நிலையான வடிவத்தைப் பெற்றுள்ளன."}}}
{"id":"b-tam-8t1-030","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 12"},"texts":{"ta":{"blocks":[{"type":"text","text":"வளைந்த கோடுகளால் அமைந்த மிகப்பழைய தமிழ் எழுத்து ________ என அழைக்கப்படுகிறது."}],"options":[{"key":"A","text":"கோட்டெழுத்து"},{"key":"B","text":"வட்டெழுத்து"},{"key":"C","text":"சித்திர எழுத்து"},{"key":"D","text":"ஓவிய எழுத்து"}],"explanation":"மதிப்பீட்டு வினா: வளைந்த கோடுகளால் அமைந்த மிகப்பழைய தமிழ் எழுத்து வட்டெழுத்து எனப்படும்."}}}

