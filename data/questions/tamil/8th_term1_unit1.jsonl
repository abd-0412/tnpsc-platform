// பாடம் 7: பட்ட மரம் (கவிதைப்பேழை - கவிஞர் தமிழ்ஒளி) [Q048 - Q053]
// மொட்டைக் கிளையொடு நின்று தினம்பெரும் மூச்சு விடும்மரமே, சொல்-பொருள் (விசனம், குந்த, கந்தம், குமைந்தனை),
// பாரதிதாசனின் மாணவர் தமிழ்ஒளி, கந்தம் (மணம்), புணர்ச்சி (வருமென்று, கிழிந்தெழில்)
// ==============================================================================
{"id":"b-tam-8t1-048","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 24"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மொட்டைக் கிளையொடு நின்று தினம்பெரும் மூச்சு விடும்மரமே!...’ - என்னும் ‘பட்ட மரம்’ கவிதையை இயற்றியவர் யார்?"}],"options":[{"key":"A","text":"சுரதா"},{"key":"B","text":"தமிழ்ஒளி"},{"key":"C","text":"சிற்பி"},{"key":"D","text":"மீரா"}],"explanation":"பட்டுப்போன மரத்தின் வேதனையைக் கவிதையாகப் பாடியவர் கவிஞர் தமிழ்ஒளி ஆவார்."}}}
{"id":"b-tam-8t1-049","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 28"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பட்ட மரம்’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"விசனம்"},{"label":"B","text":"குந்த"},{"label":"C","text":"கந்தம்"},{"label":"D","text":"குமைந்தனை"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"உட்கார"},{"label":"2","text":"வருந்தினாய்"},{"label":"3","text":"கவலை"},{"label":"4","text":"மணம்"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}}],"explanation":"விசனம் = கவலை; குந்த = உட்கார; கந்தம் = மணம்; எய்தி = அடைந்து; குமைந்தனை = வருந்தினாய்; புவி = உலகம்; மிசை = மேல்."}}}
{"id":"b-tam-8t1-050","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 29"},"texts":{"ta":{"blocks":[{"type":"text","text":"கவிஞர் தமிழ்ஒளி யாருடைய கவிமரபு வழித்தோன்றலாகவும் மாணவராகவும் விளங்கியவர்?"}],"options":[{"key":"A","text":"பாரதியார்"},{"key":"B","text":"பாரதிதாசன்"},{"key":"C","text":"நாமக்கல் கவிஞர்"},{"key":"D","text":"கவிமணி"}],"explanation":"தமிழ்ஒளி பாரதியாரின் கவிமரபு வழித்தோன்றலாகவும் பாரதிதாசனின் மாணவராகவும் விளங்கியவர்."}}}
{"id":"b-tam-8t1-051","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 29"},"texts":{"ta":{"blocks":[{"type":"text","text":"மலர்களிலிருந்து வரும் ________ வண்டுகளை ஈர்க்கும்."}],"options":[{"key":"A","text":"மந்தம்"},{"key":"B","text":"அந்தம்"},{"key":"C","text":"சந்தம்"},{"key":"D","text":"கந்தம் (மணம்)"}],"explanation":"கந்தம் என்றால் மணம் என்று பொருள்; மலரின் மணம் வண்டுகளை ஈர்க்கும்."}}}
{"id":"b-tam-8t1-052","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 29"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வருமென்று’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"வரு + மென்று"},{"key":"B","text":"வரும் + என்று"},{"key":"C","text":"வரு + என்று"},{"key":"D","text":"வரும + என்று"}],"explanation":"வரும் + என்று = உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி 'வருமென்று' எனப் புணரும்."}}}
{"id":"b-tam-8t1-053","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 29"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கிழிந்து + எழில்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"கிழிந்தெழில்"},{"key":"B","text":"கிழிந்து எழில்"},{"key":"C","text":"கிழிந்தொழில்"},{"key":"D","text":"கிழிந்தழில்"}],"explanation":"உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி உ கெட்டு, த் + எ = தெ ஆகி 'கிழிந்தெழில்' எனப் புணரும்."}}}

