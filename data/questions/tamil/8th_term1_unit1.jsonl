// ==============================================================================
// பாடம் 1: தமிழ்மொழி வாழ்த்து (கவிதைப்பேழை - பாரதியார்) [Q001 - Q009]
// வாழ்க நிரந்தரம் வாழ்க தமிழ்மொழி, சொல்-பொருள் (நிரந்தரம், வைப்பு, சூழ்கலி, தொல்லை),
// புதிய அறம் பாட வந்த அறிஞன் / செந்தமிழ்த் தேனீ (பாரதிதாசன் பாராட்டு - PYQ 2022),
// பாரதியார் நூல் வெளி (இதழ்கள்: இந்தியா, விஜயா; உரைநடைகள்: சந்திரிகையின் கதை, தராசு),
// வைப்பு (நிலப்பகுதி), புணர்ச்சி (என்றென்றும், வானமளந்தது, அறிந்ததனைத்தும், வானமறிந்த)
// ==============================================================================
{"id":"b-tam-8t1-001","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வாழ்க நிரந்தரம்! வாழ்க தமிழ்மொழி! வாழிய வாழியவே...’ - என்னும் ‘தமிழ்மொழி வாழ்த்து’ பாடலை இயற்றிய கவிஞர் யார்?"}],"options":[{"key":"A","text":"பாரதிதாசன்"},{"key":"B","text":"சி. சுப்பிரமணிய பாரதியார்"},{"key":"C","text":"நாமக்கல் கவிஞர்"},{"key":"D","text":"கவிமணி"}],"explanation":"தமிழ்மொழியின் பெருமையை வாழ்த்திப் பாடும் 'தமிழ்மொழி வாழ்த்து' பாடலை இயற்றியவர் மகாகவி பாரதியார் ஆவார்."}}}
{"id":"b-tam-8t1-002","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தமிழ்மொழி வாழ்த்து’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"நிரந்தரம்"},{"label":"B","text":"வைப்பு"},{"label":"C","text":"சூழ்கலி"},{"label":"D","text":"தொல்லை"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"நிலப்பகுதி"},{"label":"2","text":"பழமை, துன்பம்"},{"label":"3","text":"காலம் முழுமையும்"},{"label":"4","text":"சூழ்ந்துள்ள அறியாமை இருள்"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}}],"explanation":"நிரந்தரம் = காலம் முழுமையும்; வைப்பு = நிலப்பகுதி; சூழ்கலி = சூழ்ந்துள்ள அறியாமை இருள்; வண்மொழி = வளமிக்க மொழி; இசை = புகழ்; தொல்லை = பழமை, துன்பம்."}}}
{"id":"pyq-tam-8t1-003","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":14},"texts":{"ta":{"blocks":[{"type":"text","text":"பாரதியாரைப் ‘புதிய அறம் பாட வந்த அறிஞன்’ என்றும் ‘செந்தமிழ்த் தேனீ’ என்றும் புகழ்ந்து போற்றியவர் யார்?"}],"options":[{"key":"A","text":"கவிமணி"},{"key":"B","text":"நாமக்கல் கவிஞர்"},{"key":"C","text":"பாரதிதாசன்"},{"key":"D","text":"உடுமலை நாராயணகவி"}],"explanation":"பாரதியாரைச் 'சிந்துக்குத் தந்தை', 'செந்தமிழ்த் தேனீ', 'புதிய அறம் பாட வந்த அறிஞன்' எனப் புகழ்ந்தவர் பாரதிதாசன் ஆவார்."}}}
{"id":"b-tam-8t1-004","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 3"},"texts":{"ta":{"blocks":[{"type":"text","text":"மகாகவி பாரதியார் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"இவர் கவிஞர், எழுத்தாளர், இதழாளர், சமூகச் சீர்திருத்தச் சிந்தனையாளர், விடுதலைப் போராட்ட வீரர் எனப் பன்முக ஆற்றல் கொண்டவர்."},{"type":"statement","label":"II","text":"இந்தியா, விஜயா முதலான இதழ்களில் எழுதி விடுதலைப் போருக்கு வித்திட்டவர்."},{"type":"statement","label":"III","text":"கவிதைகள் மட்டுமன்றிச் சந்திரிகையின் கதை, தராசு உள்ளிட்ட உரைநடை நூல்களையும் வசன கவிதைகளையும் எழுதியுள்ளார்."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"நூல் வெளிப் பகுதியின்படி பாரதியார் பற்றிய மூன்று கூற்றுகளும் முற்றிலும் சரியானவை."}}}
{"id":"b-tam-8t1-005","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"மக்கள் வாழும் நிலப்பகுதியைக் குறிக்கும் சொல் எது?"}],"options":[{"key":"A","text":"வைப்பு"},{"key":"B","text":"கடல்"},{"key":"C","text":"பரவை"},{"key":"D","text":"ஆழி"}],"explanation":"வைப்பு என்றால் மக்கள் வாழும் நிலப்பகுதி என்று பொருள்."}}}
{"id":"b-tam-8t1-006","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘என்றென்றும்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"என் + றென்றும்"},{"key":"B","text":"என்று + என்றும்"},{"key":"C","text":"என் + என்றும்"},{"key":"D","text":"என்றும் + என்றும்"}],"explanation":"என்று + என்றும் = உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி உ கெட்டு, த் + எ = தெ ஆகி 'என்றென்றும்' எனப் புணரும்."}}}
{"id":"b-tam-8t1-007","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வானமளந்தது’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"வான + மளந்தது"},{"key":"B","text":"வான் + அளந்தது"},{"key":"C","text":"வானம் + அளந்தது"},{"key":"D","text":"வான் + மளந்தது"}],"explanation":"வானம் + அளந்தது = உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி ம் + அ = ம ஆகி 'வானமளந்தது' எனப் புணரும்."}}}
{"id":"b-tam-8t1-008","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அறிந்தது + அனைத்தும்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"அறிந்தது அனைத்தும்"},{"key":"B","text":"அறிந்ததனைத்தும்"},{"key":"C","text":"அறிந்தனைத்தும்"},{"key":"D","text":"அறிந்துனைத்தும்"}],"explanation":"உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி உ கெட்டு, த் + அ = த ஆகி 'அறிந்ததனைத்தும்' எனப் புணரும்."}}}
{"id":"b-tam-8t1-009","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வானம் + அறிந்த’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"வானமறிந்த"},{"key":"B","text":"வான் அறிந்த"},{"key":"C","text":"வானம்அறிந்து"},{"key":"D","text":"வான்மறிந்த"}],"explanation":"உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி ம் + அ = ம ஆகி 'வானமறிந்த' எனப் புணரும்."}}}

