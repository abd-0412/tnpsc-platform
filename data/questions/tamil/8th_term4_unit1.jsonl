// பாடம் 5: திருக்குறள் (வாழ்வியல் / நீதி இலக்கியம்) [Q032 - Q034, Q057, Q071]
// நிறைமொழி மாந்தர் ஆணையிற் கிளப்ப மறைமொழி தானே மந்திரம் என்ப (தொல்காப்பியம் - சான்றோர் வாக்கு மந்திரம் போன்றது),
// கண்ணோட்டம், ஒற்றாடல், உழவு, செய்தக்க அல்ல செயக்கெடும் (இயல் 4 வாழ்வியல் அதிகாரங்கள்)
// ==============================================================================
{"id":"b-tam-8t4-032","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 88"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நிறைமொழி மாந்தர் ஆணையிற் கிளப்ப மறைமொழி தானே மந்திரம் என்ப’ - என்னும் தொல்காப்பியக் கூற்று எதனை விளக்குகிறது?"}],"options":[{"key":"A","text":"அரசரின் ஆணை"},{"key":"B","text":"சான்றோரின் வாக்குகள் (மந்திரம் போலப் பொன்னானவை)"},{"key":"C","text":"இசை இலக்கணம்"},{"key":"D","text":"நாடகக் கலை"}],"explanation":"சான்றோர்களின் மறைமொழி அல்லது நிறைமொழி மாந்தரின் சொற்கள் மந்திரம் போன்ற ஆற்றல் உடையவை."}}}
{"id":"b-tam-8t4-033","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 88"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கற்க கசடறக் கற்பவை கற்றபின் நிற்க அதற்குத் தக’ - இக்குறளின் வழி நிற்கும் திருக்குறள் அதிகாரங்கள் எட்டாம் வகுப்பு இயல் 4-ல் எவை?"}],"options":[{"key":"A","text":"கல்வி, காலம் அறிதல்"},{"key":"B","text":"கண்ணோட்டம், ஒற்றாடல், உழவு (மற்றும் பிற)"},{"key":"C","text":"அன்புடைமை, செய்நன்றி"},{"key":"D","text":"அடக்கம், பொறை"}],"explanation":"எட்டாம் வகுப்பு இயல் 4-ல் கண்ணோட்டம், ஒற்றாடல், உழவு உள்ளிட்ட திருக்குறள் அதிகாரங்கள் இடம்பெற்றுள்ளன."}}}
{"id":"b-tam-8t4-034","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 90"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘செய்தக்க அல்ல செயக்கெடும்’ - இக்குறள் எத்தனையாவது பருவத்தின் தொடர்ச்சியாக இயல் 4-ல் வருகிறது?"}],"options":[{"key":"A","text":"பருவம் 1"},{"key":"B","text":"பருவம் 2"},{"key":"C","text":"பருவம் 3"},{"key":"D","text":"எட்டாம் வகுப்பு திருக்குறள் தொகுப்பு"}],"explanation":"எட்டாம் வகுப்பு திருக்குறள் பகுதியிலும் அறம், பொருள் சார்ந்த பல அதிகாரங்கள் மாணவர்களின் வாழ்வியல் பயிற்சிக்காக வழங்கப்பட்டுள்ளன."}}}
{"id":"b-tam-8t4-057","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 88"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நிறைமொழி மாந்தர் ஆணையிற் கிளப்ப மறைமொழி தானே மந்திரம் என்ப’ - என்னும் தொல்காப்பியக் கூற்று எதனை விளக்குகிறது?"}],"options":[{"key":"A","text":"அரசரின் ஆணை"},{"key":"B","text":"சான்றோரின் வாக்குகள் (மந்திரம் போன்ற ஆற்றல் உடையவை)"},{"key":"C","text":"இசை இலக்கணம்"},{"key":"D","text":"நாடகக் கலை"}],"explanation":"சான்றோர்களின் மறைமொழி அல்லது நிறைமொழி மாந்தரின் சொற்கள் மந்திரம் போன்ற ஆற்றல் உடையவை."}}}
{"id":"b-tam-8t4-071","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 88"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘உழவு’ மற்றும் ‘ஒற்றாடல்’ போன்ற வாழ்வியல் அதிகாரங்கள் எட்டாம் வகுப்பு எந்த இயலில் இடம்பெற்றுள்ளன?"}],"options":[{"key":"A","text":"இயல் 1"},{"key":"B","text":"இயல் 4"},{"key":"C","text":"இயல் 2"},{"key":"D","text":"இயல் 3"}],"explanation":"எட்டாம் வகுப்பு இயல் 4-ன் இறுதியில் மாணவர்களின் வாழ்வியல் சிந்தனைக்காகத் திருக்குறள் அதிகாரங்கள் வழங்கப்பட்டுள்ளன."}}}
