{"id":"b-tam-8t4-019","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 75"},"texts":{"ta":{"blocks":[{"type":"text","text":"மனிதர்களின் ஒன்பது சுவைகளையும் வெளிப்படுத்தக் கூடிய கலையாகத் தோன்றியது எது?"}],"options":[{"key":"A","text":"நாடகம்"},{"key":"B","text":"இசை"},{"key":"C","text":"சிற்பம்"},{"key":"D","text":"ஓவியம்"}],"explanation":"மனித உள்ளத்தின் குரல் அல்லது கருவியின் வழியாக வெளிப்பட்டு நவரசங்களை உணர்த்துவது இசையாகும்."}}}
{"id":"b-tam-8t4-020","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 75"},"texts":{"ta":{"blocks":[{"type":"text","text":"இசைக்கருவிகளை இசைத்துப் பாடல் பாடியவர்கள் பழந்தமிழ்ச் சமூகத்தில் எவ்வாறு அழைக்கப்பட்டனர்?"}],"options":[{"key":"A","text":"புலவர்கள்"},{"key":"B","text":"பாணர்"},{"key":"C","text":"கூத்தர்"},{"key":"D","text":"விறலியர்"}],"explanation":"இசைக்கருவிகளை இசைத்துப் பாடல் பாடியவர்கள் பாணர் எனப்பட்டனர்."}}}
{"id":"b-tam-8t4-021","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 76"},"texts":{"ta":{"blocks":[{"type":"text","text":"இசைக்கருவிகள் எத்தனை வகைகளாகப் பிரிக்கப்படுகின்றன?"}],"options":[{"key":"A","text":"மூன்று வகை"},{"key":"B","text":"நான்கு வகை (தோல், நரம்பு, காற்று, கஞ்சக்கருவிகள்)"},{"key":"C","text":"ஐந்து வகை"},{"key":"D","text":"இரண்டு வகை"}],"explanation":"இசைக்கருவிகள் தோல்கருவி, நரம்புக்கருவி, காற்றுக்கருவி, கஞ்சக்கருவி என 4 வகைப்படும்."}}}
{"id":"b-tam-8t4-022","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 76"},"texts":{"ta":{"blocks":[{"type":"text","text":"இசைக்கருவிகளின் வகைகளையும் அவற்றுக்குரிய சான்றுகளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"இசைக்கருவி வகை","items":[{"label":"A","text":"தோல்கருவி"},{"label":"B","text":"நரம்புக்கருவி"},{"label":"C","text":"காற்றுக்கருவி"},{"label":"D","text":"கஞ்சக்கருவி"}]},{"type":"list","name":"சான்று","items":[{"label":"1","text":"யாழ், வீணை"},{"label":"2","text":"சாலரா, சேகண்டி"},{"label":"3","text":"முழவு, முரசு"},{"label":"4","text":"குழல், சங்கு"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}}],"explanation":"தோல்கருவி = முழவு, முரசு; நரம்புக்கருவி = யாழ், வீணை; காற்றுக்கருவி = குழல், சங்கு; கஞ்சக்கருவி = சாலரா, சேகண்டி."}}}
{"id":"b-tam-8t4-023","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 76"},"texts":{"ta":{"blocks":[{"type":"text","text":"இடை சுருங்கிய ஒரு கைப்பறையாகவும், உடல் பித்தளையால் ஆனதாகவும் உள்ள இசைக்கருவி எது?"}],"options":[{"key":"A","text":"மதளம்"},{"key":"B","text":"உடுக்கை"},{"key":"C","text":"உறமுழா"},{"key":"D","text":"திமிலை"}],"explanation":"உடுக்கை என்பது இடை சுருங்கிய ஒரு கைப்பறை ஆகும்; இதன் உடல் பித்தளையால் ஆனது."}}}
{"id":"b-tam-8t4-024","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 76"},"texts":{"ta":{"blocks":[{"type":"text","text":"பெரிய உடுக்கையானது எவ்வாறு அழைக்கப்படுகிறது?"}],"options":[{"key":"A","text":"குடுகுடுப்பை"},{"key":"B","text":"தவண்டை"},{"key":"C","text":"மதளம்"},{"key":"D","text":"சல்லிகை"}],"explanation":"பெரிய உடுக்கை 'தவண்டை' என்றும், சிறு உடுக்கை 'குடுகுடுப்பை' என்றும் அழைக்கப்படும்."}}}
{"id":"b-tam-8t4-025","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 76"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஐந்து முகங்களைக் கொண்டு ஒரு பெரிய குடத்தின் வடிவில் அமைந்த முரசு வகை சார்ந்த தோல்கருவி எது?"}],"options":[{"key":"A","text":"முழவு"},{"key":"B","text":"குடமுழா"},{"key":"C","text":"தவண்டை"},{"key":"D","text":"மத்தளம்"}],"explanation":"குடமுழா என்பது ஒரு பெரிய குடத்தின் வடிவில் ஐந்து வட்டவடிவ வாய்களுடன் அமைந்த ஐந்து முக முரசாகும்."}}}
{"id":"b-tam-8t4-047","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 75"},"texts":{"ta":{"blocks":[{"type":"text","text":"நகை, அழுகை, வீரம் உள்ளிட்ட எத்தனை சுவைகளை வெளிப்படுத்தக் கூடிய கலையாக இசை பிறந்தது?"}],"options":[{"key":"A","text":"எட்டு சுவைகள்"},{"key":"B","text":"ஒன்பது சுவைகள் (நவரசங்கள்)"},{"key":"C","text":"ஏழு சுவைகள்"},{"key":"D","text":"பத்து சுவைகள்"}],"explanation":"இசை என்பது நகை, அழுகை, இளிவரல், மருட்கை, அச்சம், பெருமிதம், வெகுளி, உவகை என்ற ஒன்பது சுவைகளையும் வெளிப்படுத்தும்."}}}
{"id":"b-tam-8t4-048","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 75"},"texts":{"ta":{"blocks":[{"type":"text","text":"இசைக்கருவிகளை இசைத்துப் பாடல் பாடியவர்கள் பழந்தமிழ்ச் சமூகத்தில் எவ்வாறு அழைக்கப்பட்டனர்?"}],"options":[{"key":"A","text":"புலவர்கள்"},{"key":"B","text":"பாணர்"},{"key":"C","text":"கூத்தர்"},{"key":"D","text":"விறலியர்"}],"explanation":"இசைக்கருவிகளை இசைத்துப் பாடல் பாடியோர் 'பாணர்' என அழைக்கப்பட்டனர்."}}}
{"id":"b-tam-8t4-049","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 76"},"texts":{"ta":{"blocks":[{"type":"text","text":"விலங்குகளின் தோலால் மூடப்பட்டுச் செய்யப்படும் இசைக்கருவிகள் எவ்வாறு அழைக்கப்படும்?"}],"options":[{"key":"A","text":"நரம்புக்கருவிகள்"},{"key":"B","text":"தோல்கருவிகள் (எ.கா: முழவு, முரசு)"},{"key":"C","text":"கஞ்சக்கருவிகள்"},{"key":"D","text":"காற்றுக்கருவிகள்"}],"explanation":"விலங்குகளின் தோலால் மூடப்பட்டுச் செய்யப்படும் கருவிகள் தோல்கருவிகள் எனப்படும்."}}}
{"id":"b-tam-8t4-050","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 76"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஒன்றோடு ஒன்று மோதி இசைக்கப்படும் இசைக்கருவிகள் எவ்வாறு அழைக்கப்படும்?"}],"options":[{"key":"A","text":"காற்றுக் கருவிகள்"},{"key":"B","text":"கஞ்சக் கருவிகள் (எ.கா: சாலரா, சேகண்டி)"},{"key":"C","text":"நரம்புக் கருவிகள்"},{"key":"D","text":"தோல் கருவிகள்"}],"explanation":"ஒன்றோடு ஒன்று மோதி இசைக்கப்படும் கருவிகள் கஞ்சக்கருவிகள் எனப்படும்."}}}
{"id":"b-tam-8t4-051","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 76"},"texts":{"ta":{"blocks":[{"type":"text","text":"சிறு உடுக்கை எவ்வாறு அழைக்கப்படுகிறது?"}],"options":[{"key":"A","text":"தவண்டை"},{"key":"B","text":"குடுகுடுப்பை"},{"key":"C","text":"மதளம்"},{"key":"D","text":"பறை"}],"explanation":"பெரிய உடுக்கை தவண்டை என்றும், சிறு உடுக்கை குடுகுடுப்பை என்றும் அழைக்கப்படும்."}}}
{"id":"b-tam-8t4-052","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 76"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஐந்து முகங்களைக் கொண்ட முரசு வகையைச் சேர்ந்த ஒரு பெரிய குடத்தின் வடிவில் அமைந்த இசைக்கருவி எது?"}],"options":[{"key":"A","text":"முழவு"},{"key":"B","text":"குடமுழா"},{"key":"C","text":"மத்தளம்"},{"key":"D","text":"திமிலை"}],"explanation":"குடமுழா என்பது ஒரு பெரிய குடத்தின் வடிவில் ஐந்து வட்டவடிவ வாய்களுடன் அமைந்த ஐந்து முக முரசாகும்."}}}
{"id":"b-tam-8t4-068","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 75"},"texts":{"ta":{"blocks":[{"type":"text","text":"குரல்வழி இசை, கருவிவழி இசை என இசையை எத்தனை வகையாகப் பிரிப்பர்?"}],"options":[{"key":"A","text":"மூன்று வகை"},{"key":"B","text":"இரண்டு வகை"},{"key":"C","text":"நான்கு வகை"},{"key":"D","text":"ஐந்து வகை"}],"explanation":"மக்கள் குரல் வழியாகவும் செயற்கைக் கருவிகள் வழியாகவும் வெளிப்படுத்திய இசையைக் குரல்வழி இசை, கருவிவழி இசை என இரண்டாகப் பிரிப்பர்."}}}

