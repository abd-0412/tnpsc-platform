// ==============================================================================
// பாடம் 1: இயற்கையைப் போற்றுவோம் / சிலப்பதிகார வாழ்த்து (இளங்கோவடிகள்) [Q001 - Q009, Q053]
// திங்களைப் போற்றுதும் ஞாயிறு போற்றுதும் மாமழை போற்றுதும், சொல்லும் பொருளும் (திங்கள், கொங்கு, திகிரி, நாமநீர், அளி),
// முத்தமிழ்க் காப்பியம் / தமிழின் முதல் காப்பியம் (PYQ 2022), இளங்கோவடிகள் நூல் வெளி (சேர மரபு, கி.பி. 2-ஆம் நூற்றாண்டு),
// புணர்ச்சி விதிகள் (வெண்குடை, அங்கண், கொங்கலர், அவனளிபோல்), கழுத்தில் சூடுவது தார் (மாலை)
// ==============================================================================
{"id":"b-tam-8t2-001","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 24"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘திங்களைப் போற்றுதும்! திங்களைப் போற்றுதும்!...’ - எனத் தொடங்கும் சிலப்பதிகார வாழ்த்துப் பாடல் யாரைப் போற்றிக் பாடப்பட்டுள்ளது?"}],"options":[{"key":"A","text":"ஞாயிறு மற்றும் மழை"},{"key":"B","text":"திங்கள் (நிலவு), ஞாயிறு, மழை"},{"key":"C","text":"காவிரி நதி"},{"key":"D","text":"சோழ மன்னன்"}],"explanation":"சிலப்பதிகாரத்தில் திங்கள், ஞாயிறு, மழை ஆகிய இயற்கைக் கூறுகளை வாழ்த்திப் பாடும் பகுதியிலிருந்து இப்பாடல் தரப்பட்டுள்ளது."}}}
{"id":"b-tam-8t2-002","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இயற்கையைப் போற்றுவோம்’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"திங்கள்"},{"label":"B","text":"கொங்கு"},{"label":"C","text":"திகிரி"},{"label":"D","text":"நாமநீர்"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"மகரந்தம்"},{"label":"2","text":"அச்சம் தரும் கடல்"},{"label":"3","text":"நிலவு"},{"label":"4","text":"ஆணைச்சக்கரம்"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}}],"explanation":"திங்கள் = நிலவு; கொங்கு = மகரந்தம்; அலர் = மலர்தல்; தார் = மாலை; சென்னி = சோழ மன்னன்; அங்கண் = அழகிய இடம்; ஞாயிறு = கதிரவன்; திகிரி = ஆணைச்சக்கரம்; பொற்கோட்டு = பொன்மயமான சிகரத்தில்; மேரு = இமயமலை; அளி = கருணை; நாமநீர் = அச்சம் தரும் கடல்."}}}
{"id":"pyq-tam-8t2-003","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":12},"texts":{"ta":{"blocks":[{"type":"text","text":"ஐம்பெருங்காப்பியங்களுள் ஒன்றாகவும், தமிழின் முதல் காப்பியமாகவும் போற்றப்படும் நூல் எது?"}],"options":[{"key":"A","text":"மணிமேகலை"},{"key":"B","text":"சீவகசிந்தாமணி"},{"key":"C","text":"சிலப்பதிகாரம்"},{"key":"D","text":"வளையாபதி"}],"explanation":"சிலப்பதிகாரம் தமிழின் முதல் காப்பியமாகும்; இது முத்தமிழ்க்காப்பியம், குடிமக்கள் காப்பியம் என்றும் போற்றப்படுகிறது."}}}
{"id":"b-tam-8t2-004","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"சிலப்பதிகாரக் காப்பியம் மற்றும் இளங்கோவடிகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"சிலப்பதிகாரத்தை இயற்றியவர் இளங்கோவடிகள் ஆவார்; இவர் சேர மன்னர் மரபைச் சேர்ந்தவர்."},{"type":"statement","label":"II","text":"இளங்கோவடிகளின் காலம் பொ.ஆ. (கி.பி.) இரண்டாம் நூற்றாண்டு என்பர்."},{"type":"statement","label":"III","text":"இந்நூல் முத்தமிழ்க் காப்பியம், குடிமக்கள் காப்பியம் என்றும் அழைக்கப்படுகிறது."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"நூல் வெளிப் பகுதியின்படி சிலப்பதிகாரம் மற்றும் இளங்கோவடிகள் பற்றிய மூன்று கூற்றுகளும் முற்றிலும் சரியானவை."}}}
{"id":"b-tam-8t2-005","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 26"},"texts":{"ta":{"blocks":[{"type":"text","text":"கழுத்தில் சூடுவது ________ ஆகும்."}],"options":[{"key":"A","text":"தார் (மாலை)"},{"key":"B","text":"கணையாழி"},{"key":"C","text":"தண்டை"},{"key":"D","text":"மேகலை"}],"explanation":"தார் என்றால் மாலை என்று பொருள்; இது கழுத்தில் சூடப்படும்."}}}
{"id":"b-tam-8t2-006","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 26"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வெண்குடை’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"வெண் + குடை"},{"key":"B","text":"வெண்மை + குடை"},{"key":"C","text":"வெம் + குடை"},{"key":"D","text":"வெம்மை + குடை"}],"explanation":"வெண்மை + குடை = ஈறுபோதல் விதிப்படி 'மை' கெட்டு, 'வெண்குடை' எனப் புணரும்."}}}
{"id":"b-tam-8t2-007","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 26"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அங்கண்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"அம் + கண்"},{"key":"B","text":"அ + கண்"},{"key":"C","text":"அங் + கண்"},{"key":"D","text":"அங்கு + கண்"}],"explanation":"அம் + கண் = 'இயல்பினும் விதியினும் நின்ற உயிர்முன் கசதப மிகும்' விதிப்படி 'அங்கண்' எனப் புணரும்."}}}
{"id":"b-tam-8t2-008","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 26"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கொங்கு + அலர்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"கொங்குஅலர்"},{"key":"B","text":"கொங்அலர்"},{"key":"C","text":"கொங்கலர்"},{"key":"D","text":"கொங்குலர்"}],"explanation":"உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி ங் + அ = க ஆகி 'கொங்கலர்' எனப் புணரும்."}}}
{"id":"b-tam-8t2-009","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 26"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அவன் + அளிபோல்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"அவன் அளிபோல்"},{"key":"B","text":"அவனளிபோல்"},{"key":"C","text":"அவன்வளிபோல்"},{"key":"D","text":"அவனாளிபோல்"}],"explanation":"உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி ன் + அ = ன ஆகி 'அவனளிபோல்' எனப் புணரும்."}}}
{"id":"b-tam-8t2-053","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 24"},"texts":{"ta":{"blocks":[{"type":"text","text":"சிலப்பதிகாரத்தின் வாழ்த்துப் பகுதியில் எவற்றை முதன்மையாகப் போற்றிப் பாடப்பட்டுள்ளது?"}],"options":[{"key":"A","text":"கடல் மற்றும் மலை"},{"key":"B","text":"திங்கள், ஞாயிறு, மழை"},{"key":"C","text":"சோழநாடும் பாண்டிய நாடும்"},{"key":"D","text":"ஆறும் குளமும்"}],"explanation":"சிலப்பதிகாரத்தின் தொடக்கமாகத் திங்கள், ஞாயிறு, மழை ஆகிய இயற்கைக் கூறுகள் வாழ்த்தப்பட்டுள்ளன."}}}

