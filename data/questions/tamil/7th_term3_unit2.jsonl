{"id":"b-tam-7t3-082","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 23"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இன்சொல் விளைநிலனா ஈதலே வித்தாக வன்சொல் களைகட்டு வாய்மை எருவட்டி...’ - என்ற அறநெறிச்சாரப் பாடலை இயற்றியவர் யார்?"}],"options":[{"key":"A","text":"பூதத்தாழ்வார்"},{"key":"B","text":"முனைப்பாடியார்"},{"key":"C","text":"பொய்கையாழ்வார்"},{"key":"D","text":"ஔவையார்"}],"explanation":"உழவுத்தொழிலை அறத்தோடு ஒப்பிடும் 'அறம் என்னும் கதிர்' பாடலை இயற்றியவர் சமணப்புலவர் முனைப்பாடியார் ஆவார்."}}}
{"id":"b-tam-7t3-083","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 23"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அறம் என்னும் கதிர்’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"வித்து"},{"label":"B","text":"நிலன்"},{"label":"C","text":"களை"},{"label":"D","text":"பைங்கூழ்"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"நிலம்"},{"label":"2","text":"பசுமையான பயிர்"},{"label":"3","text":"விதை"},{"label":"4","text":"வேண்டாத செடி"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}}],"explanation":"வித்து = விதை; நிலன் = நிலம்; களை = வேண்டாத செடி; பைங்கூழ் = பசுமையான பயிர்; வன்சொல் = கடுஞ்சொல்."}}}
{"id":"b-tam-7t3-084","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 24"},"texts":{"ta":{"blocks":[{"type":"text","text":"முனைப்பாடியார் திருமுனைப்பாடி என்னும் ஊரைச் சேர்ந்த சமணப்புலவர் ஆவார்; இவரது காலம் என்ன?"}],"options":[{"key":"A","text":"12-ஆம் நூற்றாண்டு"},{"key":"B","text":"13-ஆம் நூற்றாண்டு"},{"key":"C","text":"14-ஆம் நூற்றாண்டு"},{"key":"D","text":"15-ஆம் நூற்றாண்டு"}],"explanation":"முனைப்பாடியார் 13-ஆம் நூற்றாண்டைச் சேர்ந்த சமணப் புலவர் ஆவார்."}}}
{"id":"b-tam-7t3-085","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 24"},"texts":{"ta":{"blocks":[{"type":"text","text":"முனைப்பாடியார் இயற்றிய ‘அறநெறிச்சாரம்’ என்னும் நூல் எத்தனை பாடல்களைக் கொண்டது?"}],"options":[{"key":"A","text":"100 பாடல்கள்"},{"key":"B","text":"225 பாடல்கள்"},{"key":"C","text":"400 பாடல்கள்"},{"key":"D","text":"500 பாடல்கள்"}],"explanation":"அறநெறிச்சாரம் மொத்தமாக 225 பாடல்களைக் கொண்டுள்ளது; அறநெறிகளைத் தொகுத்துக் கூறுவதால் இப்பெயர் பெற்றது."}}}
{"id":"b-tam-7t3-086","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 24"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இன்சொல்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"இனிய + சொல்"},{"key":"B","text":"இன்மை + சொல்"},{"key":"C","text":"இனிமை + சொல்"},{"key":"D","text":"இன் + சொல்"}],"explanation":"இனிமை + சொல் = ஈறுபோதல் விதிப்படி 'மை' கெட்டு, தனிக்குறில் முன் ஒற்று இரட்டும் விதிப்படி 'இன்சொல்' எனப் புணரும்."}}}
{"id":"b-tam-7t3-087","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 24"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அறம் + கதிர்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"அறகதிர்"},{"key":"B","text":"அறுகதிர்"},{"key":"C","text":"அறக்கதிர்"},{"key":"D","text":"அறம்கதிர்"}],"explanation":"இயல்பினும் விதியினும் நின்ற உயிர்முன் கசதப மிகும் விதிப்படி 'க்' மிகுந்து 'அறக்கதிர்' எனப் புணரும்."}}}
{"id":"b-tam-7t3-088","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 24"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இளமை’ என்னும் சொல்லின் நேர் எதிர்ச்சொல் யாது?"}],"options":[{"key":"A","text":"முதுமை"},{"key":"B","text":"புதுமை"},{"key":"C","text":"தனிமை"},{"key":"D","text":"இனிமை"}],"explanation":"இளமை என்பதன் எதிர்ச்சொல் முதுமை ஆகும்."}}}

// ==============================================================================
// பாடம் 8 (இயல் 2 - பாடம் 3): ஒப்புரவு நெறி (உரைநடை உலகம் - தவத்திரு குன்றக்குடி அடிகளார்) [Q089 - Q094]
// ஒருவர் எல்லாருக்காகவும் எல்லாரும் ஒருவருக்காகவும் (பொதுவுடைமை நெறி / குன்றக்குடி அடிகளார்),
// வறுமை = பிணி, செல்வம் = மருந்து, பாவேந்தர் பாரதிதாசன் 'உலகம் உண்ண உண்; உடுத்த உடுப்பாய்' (PYQ 2022),
// ஊருணி நீர்நிறைந்து அற்றே, பயன்மரம் உள்ளூர்ப் பழுத்தற்றால், அடிகளார் இதழ்கள் (அருளோசை, அறிக அறிவியல்)
// ==============================================================================
{"id":"b-tam-7t3-089","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஒருவர் எல்லாருக்காகவும், எல்லாரும் ஒருவருக்காகவும்’ என்னும் பொதுவுடைமை நெறியைத் திருக்குறள் வழியே விளக்கியவர் யார்?"}],"options":[{"key":"A","text":"தந்தை பெரியார்"},{"key":"B","text":"தவத்திரு குன்றக்குடி அடிகளார்"},{"key":"C","text":"பேரறிஞர் அண்ணா"},{"key":"D","text":"திரு.வி.க."}],"explanation":"ஒப்புரவு நெறி என்னும் கட்டுரையில் குன்றக்குடி அடிகளார் இத்தத்துவத்தை விரிவாக விளக்கியுள்ளார்."}}}
{"id":"b-tam-7t3-090","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 26"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ் மரபுப்படி வறுமையை எவ்வாறு குறிப்பிடுவர்?"}],"options":[{"key":"A","text":"பிணி (நோய்)"},{"key":"B","text":"பகை"},{"key":"C","text":"இழிவு"},{"key":"D","text":"சாக்காடு"}],"explanation":"வறுமையைப் 'பிணி' என்றும் செல்வத்தை 'மருந்து' என்றும் கூறுவது தமிழர்களின் வாழ்வியல் மரபு."}}}
{"id":"pyq-tam-7t3-091","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":26},"texts":{"ta":{"blocks":[{"type":"text","text":"‘உலகம் உண்ண உண்; உடுத்த உடுப்பாய்’ - என்று பாடிய புரட்சிக் கவிஞர் யார்?"}],"options":[{"key":"A","text":"பாரதியார்"},{"key":"B","text":"பாவேந்தர் பாரதிதாசன்"},{"key":"C","text":"சுரதா"},{"key":"D","text":"முடியரசன்"}],"explanation":"பொருளீட்டல் தான்மட்டும் வாழ்வதற்காக அன்று என்ற ஒப்புரவு நெறியை விளக்கும் வகையில் பாரதிதாசன் இவ்வாறு கூறினார்."}}}
{"id":"b-tam-7t3-092","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 27"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஊருணி நீர்நிறைந்து அற்றே உலகவாம் பேரறி வாளன் திரு’ - இக்குறட்பாவில் ஒப்புரவிற்காக வள்ளுவர் பயன்படுத்திய உவமை எது?"}],"options":[{"key":"A","text":"பயன்மரம்"},{"key":"B","text":"ஊருணி (ஊருக்குள் நீர் நிறைந்த குளம்)"},{"key":"C","text":"மருந்துமரம்"},{"key":"D","text":"மணற்கேணி"}],"explanation":"பேரறிவாளனின் செல்வம் ஊருணி நீர்நிறைந்து பயன்படுவது போன்றது."}}}
{"id":"b-tam-7t3-093","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 27"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பயன்மரம் உள்ளூர்ப் பழுத்துஅற்றால் செல்வம் நயனுடை யான்கண் படின்’ - நற்பண்பு உடையவரிடம் செல்வம் சேர்வது எதனைப் போன்றது?"}],"options":[{"key":"A","text":"நந்தவன மலர்கள் போன்றது"},{"key":"B","text":"ஊருக்குள் பயன்தரும் மரத்தில் பழங்கள் பழுத்திருப்பதைப் போன்றது"},{"key":"C","text":"வானத்து மழை போன்றது"},{"key":"D","text":"சுரசுரப்பான பாறை போன்றது"}],"explanation":"நல்லவர் பெற்ற செல்வம் ஊருக்குள் பழுத்த பயன்மரம் போலப் பலருக்கும் பயன்படும்."}}}
{"id":"b-tam-7t3-094","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 28"},"texts":{"ta":{"blocks":[{"type":"text","text":"மக்கள் பணியையே இறைப் பணியாக எண்ணித் தொண்டு செய்தவரும், குன்றக்குடி திருமடத்தின் தலைவராக விளங்கியவருமான அறிஞர் யார்?"}],"options":[{"key":"A","text":"தந்தை பெரியார்"},{"key":"B","text":"தவத்திரு குன்றக்குடி அடிகளார்"},{"key":"C","text":"திரு.வி.க."},{"key":"D","text":"பொன்னம்பல அடிகளார்"}],"explanation":"குன்றக்குடி அடிகளார் திருக்குறள் நெறியைப் பரப்பி 'அருளோசை', 'அறிக அறிவியல்' இதழ்களை நடத்தியவர்."}}}

// ==============================================================================
// பாடம் 9 (இயல் 2 - பாடம் 4): உண்மை ஒளி (விரிவானம் / துணைப்பாடம் - ஜென் தத்துவம்) [Q095 - Q096]
// ஜென் ஜப்பானிய சொல் பொருள் (தியானம் செய்), உண்மை ஒளி ஜென் கதையின் நீதி (மனிதநேயம் / தன்னலமற்ற உதவி)
