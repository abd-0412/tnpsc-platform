// பாடம் 11 (இயல் 2 - பாடம் 6): மொழியை ஆள்வோம் & கலைச்சொற்கள் அறிவோம் [Q104]
// சமூகக் கலைச்சொற்கள் (Objective: குறிக்கோள், Communism: பொதுவுடைமை, Poverty: வறுமை, Responsibility: பொறுப்பு)
// ==============================================================================
{"id":"b-tam-7t3-104","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"3","C":"4","D":"1"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 41"},"texts":{"ta":{"blocks":[{"type":"text","text":"சமூகக் கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"},{"type":"list","name":"ஆங்கிலச் சொல்","items":[{"label":"A","text":"Objective"},{"label":"B","text":"Communism"},{"label":"C","text":"Poverty"},{"label":"D","text":"Responsibility"}]},{"type":"list","name":"தமிழாக்கம்","items":[{"label":"1","text":"பொறுப்பு"},{"label":"2","text":"குறிக்கோள்"},{"label":"3","text":"பொதுவுடைமை"},{"label":"4","text":"வறுமை"}]}],"options":[{"key":"A","text":"A-2, B-3, C-4, D-1","mapping":{"A":"2","B":"3","C":"4","D":"1"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}}],"explanation":"Objective = குறிக்கோள்; Communism = பொதுவுடைமை; Poverty = வறுமை; Responsibility = பொறுப்பு; Ambition = லட்சியம்; Neighbour = அயலவர்."}}}

// ==============================================================================
// பாடம் 12 (இயல் 2 - பாடம் 7): திருக்குறள் (வாழ்வியல் / நீதி இலக்கியம்) [Q105 - Q113]
// பொருள்கருவி காலம் வினைஇடனொடு ஐந்தும் (5 காரணிகள்), வினையால் வினையாக்கிக் கோடல் (உவமை அணி),
// கற்றாருள் கற்றார் எனப்படுவர், உறுபசியும் ஓவாப் பிணியும் (நாட்டின் இலக்கணம்), மணிநீரும் மண்ணும் மலையும் (4 அரண்கள்),
// பிறப்பொக்கும் எல்லா உயிர்க்கும் (PYQ 2022), நாட்டின் அரண் அல்லாதது (வயல்), புணர்ச்சி (நாடென்ப, கண்ணில்லது)
// ==============================================================================
{"id":"b-tam-7t3-105","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 42"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பொருள்கருவி காலம் வினைஇடனொடு ஐந்தும் இருள்தீர எண்ணிச் செயல்’ - ஒரு செயலைச் செய்ய எத்தனை காரணிகளை ஆராய வேண்டும் எனத் திருவள்ளுவர் கூறுகிறார்?"}],"options":[{"key":"A","text":"மூன்று"},{"key":"B","text":"ஐந்து (பொருள், கருவி, காலம், செயல், இடம்)"},{"key":"C","text":"நான்கு"},{"key":"D","text":"ஆறு"}],"explanation":"பொருள், கருவி, காலம், செயல், இடம் ஆகிய ஐந்தையும் தெளிவாக ஆராய்ந்தே ஒரு செயலில் இறங்க வேண்டும்."}}}
{"id":"b-tam-7t3-106","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 42"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வினையால் வினையாக்கிக் கோடல் நனைகவுள் யானையால் யானையாத் தற்று’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?"}],"options":[{"key":"A","text":"உருவக அணி"},{"key":"B","text":"உவமை அணி"},{"key":"C","text":"ஏகதேச உருவக அணி"},{"key":"D","text":"பிறிது மொழிதல் அணி"}],"explanation":"ஒரு செயலைச் செய்யும்போதே அச்செயலால் மற்றொரு செயலையும் முடித்தல், யானையைக் கொண்டு மற்றொரு யானையைப் பிடிப்பதற்கு ஒப்பானதாகும். இதில் 'அற்று' என்ற உவம உருபு வெளிப்படையாக வந்துள்ளதால் இது 'உவமை அணி' ஆகும்."}}}
{"id":"b-tam-7t3-107","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 42"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கற்றாருள் கற்றார் எனப்படுவர் கற்றார்முன் கற்ற செலச்சொல்லு வார்’ - கற்றவருள் மிகவும் சிறந்தவராக மதிக்கப்படுபவர் யார்?"}],"options":[{"key":"A","text":"அதிக நூல்களைப் படித்தவர்"},{"key":"B","text":"தாம் கற்ற கல்வியைக் கற்றோர் முன்னிலையில் தெளிவாக விளங்கும்படி சொல்ல வல்லவர்"},{"key":"C","text":"அரசாங்கப் பதவியில் உள்ளவர்"},{"key":"D","text":"அமைதியாக இருப்பவர்"}],"explanation":"கற்றவர் முன் தான் கற்ற கல்வியின் பொருளை அவர்கள் மனத்தில் பதியும் வண்ணம் சொல்ல வல்லவரே கற்றவருள் சிறந்தவர்."}}}
{"id":"b-tam-7t3-108","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 42"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘உறுபசியும் ஓவாப் பிணியும் செறுபகையும் சேராது இயல்வது நாடு’ - ஒரு சிறந்த நாட்டின் இலக்கணங்களாக வள்ளுவர் கூறுவன எவை?"}],"options":[{"key":"A","text":"கோட்டைகளும் படைகளும்"},{"key":"B","text":"மிக்க பசியும், ஓயாத நோயும், அழிவு செய்யும் பகையும் சேராத நாடே சிறந்த நாடு"},{"key":"C","text":"அதிக மக்கள்தொகை கொண்ட நாடு"},{"key":"D","text":"தங்கம் விளையும் நாடு"}],"explanation":"தீராத பசி, தீராத நோய், தீராத பகை ஆகிய மூன்றும் இல்லாத நாடே மிகச் சிறந்த நாடாகும்."}}}
{"id":"b-tam-7t3-109","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மணிநீரும் மண்ணும் மலையும் அணிநிழல் காடும் உடையது அரண்’ - ஒரு நாட்டின் பாதுகாப்பிற்குரிய நான்கு அரண்களாக வள்ளுவர் எவற்றைக் குறிப்பிடுகிறார்?"}],"options":[{"key":"A","text":"மதில், கோட்டை, வீரர், ஆயுதம்"},{"key":"B","text":"தெளிந்த நீர், நிலம், மலை, அழகிய நிழல் தரும் காடு"},{"key":"C","text":"மழை, காற்று, வெயில், வெளி"},{"key":"D","text":"தங்கம், வெள்ளி, முத்து, பவளம்"}],"explanation":"நீர், நிலம், மலை, காடு ஆகிய நான்கும் ஒரு நாட்டின் இயற்கை அரண்களாக விளங்கும்."}}}
{"id":"pyq-tam-7t3-110","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":31},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பிறப்பொக்கும் எல்லா உயிர்க்கும் சிறப்புஒவ்வா செய்தொழில் வேற்றுமை யான்’ - இக்குறட்பா விளக்கும் மிக முக்கியமான உண்மை யாது?"}],"options":[{"key":"A","text":"மக்கள் அனைவரும் செல்வத்தால் ஒத்தவர்கள்"},{"key":"B","text":"மக்கள் அனைவரும் பிறப்பால் ஒத்த இயல்புடையவர்களே; அவர்கள் செய்யும் செயலாலேயே சிறப்பு வேறுபடும்"},{"key":"C","text":"அனைவரும் ஒரே குலத்தைச் சேர்ந்தவர்கள்"},{"key":"D","text":"அனைவரும் சமமான கல்வியைப் பெற்றவர்கள்"}],"explanation":"பிறப்பால் அனைவரும் சமமே; அவரவர் செய்யும் நல்ல தீய செயல்களின் காரணமாகவே சிறப்பு வேறுபடுகிறது."}}}
{"id":"b-tam-7t3-111","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மணிநீரும் மண்ணும் மலையும் அணிநிழல் காடும் உடையது அரண்’ - இத்தொடரின்படி கீழ்க்கண்டவற்றுள் எது ஒரு நாட்டின் அரண் அன்று?"}],"options":[{"key":"A","text":"தெளிந்த நீர்"},{"key":"B","text":"மலை"},{"key":"C","text":"காடு"},{"key":"D","text":"வயல்"}],"explanation":"பாடநூல் மதிப்பீட்டு வினா: வயல் என்பது நாட்டின் அரண் அன்று; நீர், நிலம், மலை, காடு அரண்களாகும்."}}}
{"id":"b-tam-7t3-112","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நாடென்ப’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"நாடு + என்ப"},{"key":"B","text":"நான் + என்ப"},{"key":"C","text":"நா + டென்ப"},{"key":"D","text":"நாடு + டென்ப"}],"explanation":"நாடு + என்ப = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி உ கெட்டு, ட் + எ = டெ ஆகி 'நாடென்ப' எனப் புணரும்."}}}
{"id":"b-tam-7t3-113","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கண் + இல்லது’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"கணிஇல்லது"},{"key":"B","text":"கணில்லது"},{"key":"C","text":"கண்ணில்லாது"},{"key":"D","text":"கண்ணில்லது"}],"explanation":"தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும் விதிப்படி கண் + ண் + இல்லது என்றாகி, பின் உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி ண் + இ = ணி ஆகி 'கண்ணில்லது' எனப் புணரும்."}}}
