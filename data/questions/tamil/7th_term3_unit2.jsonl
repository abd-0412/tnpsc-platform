// பாடம் 10 (இயல் 2 - பாடம் 5): அணி இலக்கணம் / திணை, பால், இடம், இரட்டைக்கிளவி, அடுக்குத்தொடர் (கற்கண்டு - இலக்கணம்) [Q097 - Q103]
// உயர்திணை (ஆறறிவு மனிதர்கள்), பால் 5 வகைகள், இடம் 3 வகைகள் (தன்மை, முன்னிலை, படர்க்கை),
// இரட்டைக்கிளவி இலக்கணம் (பிரித்தால் பொருள் தராது), அடுக்குத்தொடர் இலக்கணம் (பிரித்தால் பொருள் தரும்),
// செல்கின்றன (பலவின்பால்), மழை சடசடவெனப் பெய்தது (இரட்டைக்கிளவி)
// ==============================================================================
{"id":"b-tam-7t3-097","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழில் ஆறறிவுடைய மனிதர்களைக் குறிக்கும் திணை எது?"}],"options":[{"key":"A","text":"அஃறிணை"},{"key":"B","text":"உயர்திணை"},{"key":"C","text":"பலர்பால்"},{"key":"D","text":"ஒன்றன்பால்"}],"explanation":"மனிதர்களை உயர்திணை என்றும், விலங்கு பறவை உள்ளிட்ட மற்றவற்றை அஃறிணை என்றும் வகைப்படுத்துவர்."}}}
{"id":"b-tam-7t3-098","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழில் ‘பால்’ பகுப்பு எத்தனை வகைகளாகப் பிரிக்கப்பட்டுள்ளது?"}],"options":[{"key":"A","text":"மூன்று வகைகள்"},{"key":"B","text":"ஐந்து வகைகள் (ஆண்பால், பெண்பால், பலர்பால், ஒன்றன்பால், பலவின்பால்)"},{"key":"C","text":"நான்கு வகைகள்"},{"key":"D","text":"ஆறு வகைகள்"}],"explanation":"பால் ஐவகைப்படும்; உயர்திணைக்கு 3-ம், அஃறிணைக்கு 2-ம் உரியன."}}}
{"id":"b-tam-7t3-099","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 36"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழில் ‘இடம்’ எத்தனை வகைகளாகப் பகுக்கப்பட்டுள்ளது?"}],"options":[{"key":"A","text":"இரண்டு வகைகள்"},{"key":"B","text":"மூன்று வகைகள் (தன்மை, முன்னிலை, படர்க்கை)"},{"key":"C","text":"நான்கு வகைகள்"},{"key":"D","text":"ஐந்து வகைகள்"}],"explanation":"இடம் தன்மை, முன்னிலை, படர்க்கை என மூன்று வகைப்படும்."}}}
{"id":"b-tam-7t3-100","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 37"},"texts":{"ta":{"blocks":[{"type":"text","text":"இரட்டையாக இணைந்து வந்து, பிரித்தால் தனிப்பொருள் தராத சொற்கள் எவ்வாறு அழைக்கப்படும்?"}],"options":[{"key":"A","text":"அடுக்குத்தொடர்"},{"key":"B","text":"இரட்டைக்கிளவி (எ.கா: விறுவிறு, கலகல)"},{"key":"C","text":"இணைச்சொல்"},{"key":"D","text":"பகாப்பதம்"}],"explanation":"பிரித்தால் பொருள் தராமல் இரட்டையாக வரும் சொற்கள் இரட்டைக்கிளவி எனப்படும்."}}}
{"id":"b-tam-7t3-101","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 37"},"texts":{"ta":{"blocks":[{"type":"text","text":"அச்சம், விரைவு, சினம் போன்ற காரணங்களால் ஒரு சொல் ஒன்றுக்கு மேற்பட்ட முறை தொடர்ந்து வருவது எது?"}],"options":[{"key":"A","text":"இரட்டைக்கிளவி"},{"key":"B","text":"அடுக்குத்தொடர் (எ.கா: பாம்பு பாம்பு)"},{"key":"C","text":"மரபுத்தொடர்"},{"key":"D","text":"விளித்தொடர்"}],"explanation":"அடுக்குத்தொடரில் பலமுறை வரும் ஒவ்வொரு சொல்லும் தனித்தனிப் பொருள் தரும்."}}}
{"id":"b-tam-7t3-102","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 38"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘செல்கின்றன’ என்னும் வினைமுற்றுக்குரிய சரியான பால் எது?"}],"options":[{"key":"A","text":"ஒன்றன்பால்"},{"key":"B","text":"பலவின்பால் (அஃறிணைப் பன்மை)"},{"key":"C","text":"பலர்பால்"},{"key":"D","text":"ஆண்பால்"}],"explanation":"செல்கின்றன என்பது அஃறிணைப் பன்மையை உணர்த்துவதால் பலவின்பால் ஆகும்."}}}
{"id":"b-tam-7t3-103","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 38"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மழை சடசடவெனப் பெய்தது’ - இத்தொடரில் இடம்பெற்றுள்ள சொல் அமைப்பு முறை யாது?"}],"options":[{"key":"A","text":"அடுக்குத்தொடர்"},{"key":"B","text":"இரட்டைக்கிளவி (சடசட)"},{"key":"C","text":"உரிச்சொல் தொடர்"},{"key":"D","text":"வினையெச்சம்"}],"explanation":"சடசட என்பது பிரித்தால் பொருள் தராத இரட்டைக்கிளவி ஆகும்."}}}

