// ==============================================================================
// 7-ஆம் வகுப்பு தமிழ் - பருவம் 3 - இயல் 2 வினா வங்கி (41 வினாக்கள்)
// பாடங்கள்:
//   1. பாடம் 6: புதுமை விளக்கு (கவிதைப்பேழை - பொய்கையாழ்வார், பூதத்தாழ்வார்) [Q073 - Q081] (9 வினாக்கள்)
//   2. பாடம் 7: அறம் என்னும் கதிர் (கவிதைப்பேழை - முனைப்பாடியார், அறநெறிச்சாரம்) [Q082 - Q088] (7 வினாக்கள்)
//   3. பாடம் 8: ஒப்புரவு நெறி (உரைநடை உலகம் - தவத்திரு குன்றக்குடி அடிகளார்) [Q089 - Q094] (6 வினாக்கள்)
//   4. பாடம் 9: உண்மை ஒளி (துணைப்பாடம் / விரிவானம் - ஜென் தத்துவம்) [Q095 - Q096] (2 வினாக்கள்)
//   5. பாடம் 10: திணை, பால், இடம், இரட்டைக்கிளவி, அடுக்குத்தொடர் (கற்கண்டு - இலக்கணம்) [Q097 - Q103] (7 வினாக்கள்)
//   6. பாடம் 11: மொழியை ஆள்வோம் & கலைச்சொற்கள் அறிவோம் [Q104] (1 வினா)
//   7. பாடம் 12: திருக்குறள் (வாழ்வியல்) [Q105 - Q113] (9 வினாக்கள்)
// வினாக்கள் வரம்பு: b-tam-7t3-073 முதல் b-tam-7t3-113 வரை
// மொத்தம்: 41 வினாக்கள்
// ==============================================================================

// ==============================================================================
// பாடம் 6 (இயல் 2 - பாடம் 1): புதுமை விளக்கு (கவிதைப்பேழை - பொய்கையாழ்வார், பூதத்தாழ்வார்) [Q073 - Q081]
// வையம் தகளியா வார்கடலே நெய்யாக (பொய்கையாழ்வார்), சொல்-பொருள் (வையம், வெய்ய, சொல்மாலை, இடர்ஆழி),
// உருவக அணி, அன்பே தகளியா ஆர்வமே நெய்யாக (பூதத்தாழ்வார்), சொல்-பொருள் (தகளி, சிந்தை, ஞானம், நாரணன்),
// அந்தாதி சிற்றிலக்கிய இலக்கணம், ஆழ்வார்கள் நூல் வெளி (திருவெஃகா, மாமல்லபுரம், முதல் & இரண்டாம் திருவந்தாதி),
// புணர்ச்சி (ஞானச்சுடர், இன்புருகு)
// ==============================================================================
{"id":"b-tam-7t3-073","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 20"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வையம் தகளியா வார்கடலே நெய்யாக வெய்ய கதிரோன் விளக்காக...’ - என்ற ‘புதுமை விளக்கு’ பாடலை இயற்றியவர் யார்?"}],"options":[{"key":"A","text":"பூதத்தாழ்வார்"},{"key":"B","text":"பொய்கையாழ்வார்"},{"key":"C","text":"பேயாழ்வார்"},{"key":"D","text":"திருமங்கையாழ்வார்"}],"explanation":"முதல் திருவந்தாதியைப் பாடிய பொய்கையாழ்வார் பூமியை விளக்காக உருவகப்படுத்தி இப்பாடலை இயற்றியுள்ளார்."}}}
{"id":"b-tam-7t3-074","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"4","C":"1","D":"3"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 20"},"texts":{"ta":{"blocks":[{"type":"text","text":"பொய்கையாழ்வார் பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"வையம்"},{"label":"B","text":"வெய்ய"},{"label":"C","text":"சொல்மாலை"},{"label":"D","text":"இடர்ஆழி"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"பாமாலை"},{"label":"2","text":"உலகம்"},{"label":"3","text":"துன்பக்கடல்"},{"label":"4","text":"வெப்பக்கதிர் வீசும்"}]}],"options":[{"key":"A","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"D","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}}],"explanation":"வையம் = உலகம்; வெய்ய = வெப்பக்கதிர் வீசும்; சொல்மாலை = பாமாலை; இடர்ஆழி = துன்பக்கடல்; சுடர் ஆழியான் = ஒளிவிடும் சக்கரத்தை உடைய திருமால்."}}}
{"id":"b-tam-7t3-075","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 20"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வையம் தகளியா வார்கடலே நெய்யாக’ - இப்பாடலில் பயின்று வந்துள்ள அணி எது?"}],"options":[{"key":"A","text":"உவமையணி"},{"key":"B","text":"உருவக அணி"},{"key":"C","text":"ஏகதேச உவமையணி"},{"key":"D","text":"தற்குறிப்பற்ற அணி"}],"explanation":"பூமி அகல்விளக்காகவும், கடல் நெய்யாகவும், கதிரவன் சுடராகவும் உவமை வேறு பொருண்மையில்லாமல் ஒன்றே என உருவகப்படுத்தப்பட்டுள்ளதால் இது 'உருவக அணி' ஆகும்."}}}
{"id":"b-tam-7t3-076","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 21"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அன்பே தகளியா ஆர்வமே நெய்யாக இன்புருகு சிந்தை இடுதிரியா...’ - என்ற பாடலை இயற்றியவர் யார்?"}],"options":[{"key":"A","text":"பொய்கையாழ்வார்"},{"key":"B","text":"பூதத்தாழ்வார்"},{"key":"C","text":"பேயாழ்வார்"},{"key":"D","text":"பெரியாழ்வார்"}],"explanation":"இரண்டாம் திருவந்தாதியின் முதல் பாடலான இப்பாடலை இயற்றியவர் பூதத்தாழ்வார் ஆவார்."}}}
{"id":"b-tam-7t3-077","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"3","C":"4","D":"1"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 21"},"texts":{"ta":{"blocks":[{"type":"text","text":"பூதத்தாழ்வார் பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"தகளி"},{"label":"B","text":"சிந்தை"},{"label":"C","text":"ஞானம்"},{"label":"D","text":"நாரணன்"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"திருமால்"},{"label":"2","text":"அகல்விளக்கு"},{"label":"3","text":"மனம்"},{"label":"4","text":"அறிவு"}]}],"options":[{"key":"A","text":"A-2, B-3, C-4, D-1","mapping":{"A":"2","B":"3","C":"4","D":"1"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}}],"explanation":"தகளி = அகல்விளக்கு; சிந்தை = மனம்; ஞானம் = அறிவு; நாரணன் = திருமால்."}}}
{"id":"b-tam-7t3-078","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 21"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஒரு பாடலின் இறுதி எழுத்தோ, அசையோ, சொல்லோ அடுத்து வரும் பாடலுக்கு முதலாக அமையும் சிற்றிலக்கிய வகை எது?"}],"options":[{"key":"A","text":"கலம்பகம்"},{"key":"B","text":"அந்தாதி (அந்தம் - முடிவு, ஆதி - முதல்)"},{"key":"C","text":"பரணி"},{"key":"D","text":"உலா"}],"explanation":"அந்தம் (முடிவு) ஆதி (முதல்) என்பவற்றைக் கொண்டு பாடப்படுவது 'அந்தாதி' என்னும் சிற்றிலக்கியமாகும்."}}}
{"id":"b-tam-7t3-079","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 21"},"texts":{"ta":{"blocks":[{"type":"text","text":"பொய்கையாழ்வார் மற்றும் பூதத்தாழ்வார் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"பொய்கையாழ்வார் காஞ்சிபுரத்திற்கு அருகிலுள்ள திருவெஃகா என்னும் ஊரில் பிறந்தவர்."},{"type":"statement","label":"II","text":"பூதத்தாழ்வார் சென்னையை அடுத்துள்ள மாமல்லபுரத்தில் பிறந்தவர்."},{"type":"statement","label":"III","text":"இவர்களது பாடல்கள் நாலாயிரத் திவ்வியப் பிரபந்தத்தில் முறையே முதல் மற்றும் இரண்டாம் திருவந்தாதிகளாகத் தொகுக்கப்பட்டுள்ளன."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"நூல் வெளிப் பகுதியின்படி இரு ஆழ்வார்கள் பற்றிய மூன்று கூற்றுகளும் முற்றிலும் சரியானவை."}}}
{"id":"b-tam-7t3-080","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 22"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஞானச்சுடர்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"ஞான + சுடர்"},{"key":"B","text":"ஞானச் + சுடர்"},{"key":"C","text":"ஞானம் + சுடர்"},{"key":"D","text":"ஞானி + சுடர்"}],"explanation":"ஞானம் + சுடர் = மவ்வீறு ஒற்றழிந்து உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'ஞானச்சுடர்' எனப் புணரும்."}}}
{"id":"b-tam-7t3-081","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 22"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இன்பு + உருகு’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"இன்பு உருகு"},{"key":"B","text":"இன்பும் உருகு"},{"key":"C","text":"இன்புருகு"},{"key":"D","text":"இன்பருகு"}],"explanation":"உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'இன்பு' என்பது 'இன்ப்' என மெய்விட்டு நின்று, பின் 'உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே' விதிப்படி (ன்ப் + உ = பு) 'இன்புருகு' எனப் புணரும்."}}}

// ==============================================================================
// பாடம் 7 (இயல் 2 - பாடம் 2): அறம் என்னும் கதிர் (கவிதைப்பேழை - முனைப்பாடியார், அறநெறிச்சாரம்) [Q082 - Q088]
// இன்சொல் விளைநிலனா ஈதலே வித்தாக, சொல்-பொருள் (வித்து, நிலன், களை, பைங்கூழ்),
// முனைப்பாடியார் காலம் (13-ஆம் நூற்றாண்டு சமணப்புலவர்), அறநெறிச்சாரம் பாடல்கள் (225),
// புணர்ச்சி (இன்சொல், அறக்கதிர்), எதிர்ச்சொல் (இளமை x முதுமை)
