// 7-ஆம் வகுப்பு தமிழ் - பருவம் 1 - இயல் 3: நாடு, சமூகம் / விடுதலைப் போராட்டம் / தேசியம் / இலக்கணம் / வாழ்வியல் (மொத்த வினாக்கள்: 105)
// ==============================================================================
// ==============================================================================
// பாடம் 1: விடுதலைத் திருநாள் (கவிதைப்பேழை - கவிஞர் மீரா) [Q141 - Q152]
// விடுதலைத் திருநாள், சொல்-பொருள், பகத்சிங் பரவசம், மீரா இயற்பெயர் மீ. இராசேந்திரன்,
// அன்னம் விடு தூது, நூல்கள் (கோடையும் வசந்தமும், ஊசிகள், குக்கூ), தரிசனம், வையம், புணர்ச்சி (சீவனில்லாமல், விலங்கொடித்து, காட்டையெரித்து, இதந்தரும்)
// ==============================================================================
{"id":"b-tam-7t1-141","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 48"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘முன்னூறு வருடமாய் முற்றுகை யிட்ட அந்நிய இருட்டின் அரக்கக் கூத்து முடிந்தது என்று முழங்கி நின்றது எந்த நாளோ அந்த நாள் இது’ - என்று விடுதலைத் திருநாளைப் பாடிய கவிஞர் யார்?"}],"options":[{"key":"A","text":"மு. மேத்தா"},{"key":"B","text":"மீரா"},{"key":"C","text":"சுரதா"},{"key":"D","text":"தாராபாரதி"}],"explanation":"விடுதலைத் திருநாள் என்னும் தலைப்பில் அமைந்த இப்புதுக்கவிதையைப் பாடியவர் கவிஞர் மீரா ஆவார்."}}}
{"id":"b-tam-7t1-142","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 49"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘விடுதலைத் திருநாள்’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"சீவன்"},{"label":"B","text":"சத்தியம்"},{"label":"C","text":"ஆனந்த தரிசனம்"},{"label":"D","text":"வையம்"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"உண்மை"},{"label":"2","text":"உயிர்"},{"label":"3","text":"உலகம்"},{"label":"4","text":"மகிழ்வான காட்சி"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}}],"explanation":"சீவன் = உயிர்; சத்தியம் = உண்மை; ஆனந்த தரிசனம் = மகிழ்வான காட்சி; வையம் = உலகம்; சபதம் = சூளுரை; மோகித்து = விரும்பி."}}}
{"id":"b-tam-7t1-143","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 48"},"texts":{"ta":{"blocks":[{"type":"text","text":"சதி வழக்கில் தூக்குக் கயிற்றில் தொங்கப் போகும் கடைசி வினாடியிலும் தன் கண்முன் நிறுத்திப் பரவசப்பட்ட மாவீரன் யார் எனக் கவிஞர் மீரா குறிப்பிடுகிறார்?"}],"options":[{"key":"A","text":"வாஞ்சிநாதன்"},{"key":"B","text":"பகத்சிங்"},{"key":"C","text":"திருப்பூர் குமரன்"},{"key":"D","text":"சுபாஷ் சந்திரபோஸ்"}],"explanation":"'சதி வழக்கினிலே சம்பந்தப் பட்டுத் தூக்குக் கயிற்றில் தொங்கப் போகும் கடைசிக் கணத்திலும் கண்முன் நிறுத்திப் பகத்சிங் பார்த்துப் பரவசப் பட்ட அற்புத விடியல்' எனப் பாடலில் குறிப்பிடப்பட்டுள்ளது."}}}
{"id":"pyq-tam-7t1-144","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":33},"texts":{"ta":{"blocks":[{"type":"text","text":"கவிஞர் மீராவின் இயற்பெயர் யாது?"}],"options":[{"key":"A","text":"இராசகோபாலன்"},{"key":"B","text":"மீ. இராசேந்திரன்"},{"key":"C","text":"இராதாகிருஷ்ணன்"},{"key":"D","text":"துரைராசு"}],"explanation":"மீரா என்னும் புனைப்பெயரில் எழுதிய கவிஞரின் இயற்பெயர் மீ. இராசேந்திரன் ஆகும்."}}}
{"id":"b-tam-7t1-145","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 49"},"texts":{"ta":{"blocks":[{"type":"text","text":"கவிஞர் மீரா நடத்திய இதழின் பெயர் யாது?"}],"options":[{"key":"A","text":"கொல்லிப்பாவை"},{"key":"B","text":"அன்னம் விடு தூது"},{"key":"C","text":"வானம்பாடி"},{"key":"D","text":"குயில்"}],"explanation":"கல்லூரிப் பேராசிரியராகப் பணியாற்றிய கவிஞர் மீரா 'அன்னம் விடு தூது' என்னும் சிற்றிதழை நடத்தினார்."}}}
{"id":"b-tam-7t1-146","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 49"},"texts":{"ta":{"blocks":[{"type":"text","text":"கவிஞர் மீரா இயற்றிய நூல்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"ஊசிகள், குக்கூ, மூன்றும் ஆறும், வா இந்தப் பக்கம் உள்ளிட்ட பல நூல்களை எழுதியுள்ளார்."},{"type":"statement","label":"II","text":"பாடப்பகுதியில் இடம்பெற்றுள்ள ‘விடுதலைத் திருநாள்’ கவிதை ‘கோடையும் வசந்தமும்’ என்னும் நூலிலிருந்து தரப்பட்டுள்ளது."},{"type":"statement","label":"III","text":"இவர் கல்லூரிப் பேராசிரியராகப் பணியாற்றியவர்."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"நூல் வெளிப் பகுதியின்படி கவிஞர் மீரா பற்றிய மூன்று கூற்றுகளும் முற்றிலும் சரியானவை."}}}
{"id":"b-tam-7t1-147","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 50"},"texts":{"ta":{"blocks":[{"type":"text","text":"வானில் முழுநிலவு அழகாகத் ________ அளித்தது."}],"options":[{"key":"A","text":"தயவு"},{"key":"B","text":"தரிசனம்"},{"key":"C","text":"துணிவு"},{"key":"D","text":"தயக்கம்"}],"explanation":"தரிசனம் என்றால் காட்சி என்று பொருள்; முழுநிலவு அழகாகக் காட்சி (தரிசனம்) அளித்தது."}}}
{"id":"b-tam-7t1-148","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 50"},"texts":{"ta":{"blocks":[{"type":"text","text":"இந்த ________ முழுவதும் போற்றும்படி வாழ்வதே சிறந்த வாழ்வு."}],"options":[{"key":"A","text":"வையம்"},{"key":"B","text":"வானம்"},{"key":"C","text":"ஆழி"},{"key":"D","text":"கானகம்"}],"explanation":"வையம் என்றால் உலகம் என்று பொருள்; இவ்வுலகம் முழுவதும் போற்ற வாழ்வதே சிறந்த வாழ்வு."}}}
{"id":"b-tam-7t1-149","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 50"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சீவனில்லாமல்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"சீவ + நில்லாமல்"},{"key":"B","text":"சீவன் + நில்லாமல்"},{"key":"C","text":"சீவன் + இல்லாமல்"},{"key":"D","text":"சீவ + இல்லாமல்"}],"explanation":"உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி ன் + இ = நி ஆகி, 'சீவனில்லாமல்' எனப் புணரும்."}}}
{"id":"b-tam-7t1-150","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 50"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘விலங்கொடித்து’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"விலம் + கொடித்து"},{"key":"B","text":"விலம் + ஒடித்து"},{"key":"C","text":"விலன் + ஒடித்து"},{"key":"D","text":"விலங்கு + ஒடித்து"}],"explanation":"விலங்கு + ஒடித்து = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி உகரம் கெட்டு, க் + ஒ = கொ ஆகி 'விலங்கொடித்து' எனப் புணரும்."}}}
{"id":"b-tam-7t1-151","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 50"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘காட்டை + எரித்து’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"காட்டைஎரித்து"},{"key":"B","text":"காட்டையெரித்து"},{"key":"C","text":"காடுஎரித்து"},{"key":"D","text":"காடுயெரித்து"}],"explanation":"'இ ஈ ஐ வழி யவ்வும்' விதிப்படி உடம்படுமெய் ய் தோன்றி (ய் + எ = யெ), 'காட்டையெரித்து' எனப் புணரும்."}}}
{"id":"b-tam-7t1-152","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 50"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இதம் + தரும்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"இதந்தரும்"},{"key":"B","text":"இதம்தரும்"},{"key":"C","text":"இதத்தரும்"},{"key":"D","text":"இதைத்தரும்"}],"explanation":"மகர ஈற்று விதியின்படி 'ம்' கெட்டு, வல்லினம் முன் இன மெல்லெழுத்தாகி 'இதந்தரும்' எனப் புணரும்."}}}
// ==============================================================================
// பாடம் 2: தேசியம்காத்த செம்மல் பசும்பொன் உ. முத்துராமலிங்கத்தேவர் (உரைநடை உலகம்) [Q153 - Q181, Q243]
// தேசியம் உடல் தெய்வீகம் உயிர், சுத்தத் தியாகி (பெரியார்), பசும்பொன் 1908 அக் 30, பெற்றோர், இசுலாமியத் தாய்,
// பிளேக் நோய், வாய்ப்பூட்டுச் சட்டம், தேசியம் காத்த செம்மல் (திரு.வி.க.), அரசியல் குரு நேதாஜி (மதுரை வருகை 1939),
// நேதாஜி இதழ், சாயல்குடி விவேகானந்தர் உரை, காமராசர் பாராட்டு, தென்னாட்டுச் சிங்கம் (அண்ணா), உள்ளத்து நேர்மை (இராஜாஜி),
// கே.டி.கே. தங்கமணி, குற்றப்பரம்பரை எதிர்ப்பு மாநாடு (கமுதி 1934, நீக்கம் 1948), கோவில் நுழைவு (திருச்சுழி அர்ச்சகர்கள் 1939),
// 31 சிற்றூர்கள் நிலப்பகிர்வு, பாரதமாதா கூட்டுறவு, 23 தொழிற்சங்கங்கள், ஜீவானந்தம், வாழ்ந்த நாள்கள் 20,075 / சிறை 4,000,
// தாமோ இராணுவச் சிறை, பர்மா பயணம், அஞ்சல்தலை 1995, சிறப்புப் பெயர்கள், மறைவு 1963 அக் 30, INA கூற்று-காரணம்
// ==============================================================================
{"id":"b-tam-7t1-153","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 51"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தேசியம் உடல், தெய்வீகம் உயிர்’ எனக் கருதி மக்கள் தொண்டு செய்த பெருமகன் யார்?"}],"options":[{"key":"A","text":"வ.உ.சிதம்பரனார்"},{"key":"B","text":"பசும்பொன் உ. முத்துராமலிங்கத்தேவர்"},{"key":"C","text":"காமராசர்"},{"key":"D","text":"தீரர் சத்தியமூர்த்தி"}],"explanation":"தேசியத்தையும் தெய்வீகத்தையும் தனது இரு கண்களாகப் போற்றி வாழ்ந்தவர் பசும்பொன் முத்துராமலிங்கத்தேவர்."}}}
{"id":"pyq-tam-7t1-154","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":2},"texts":{"ta":{"blocks":[{"type":"text","text":"பசும்பொன் முத்துராமலிங்கத்தேவரை ‘சுத்தத் தியாகி’ என்று மனமாரப் பாராட்டிய தலைவர் யார்?"}],"options":[{"key":"A","text":"அறிஞர் அண்ணா"},{"key":"B","text":"திரு.வி.க."},{"key":"C","text":"தந்தை பெரியார்"},{"key":"D","text":"காமராசர்"}],"explanation":"'வீரப்பேச்சால் தியாகிகளையும் விவேகப்பேச்சால் அறிவாளிகளையும் உண்டாக்கியவர்; சுத்தத் தியாகி' என்று தந்தை பெரியார் பாராட்டினார்."}}}
{"id":"pyq-tam-7t1-155","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":11},"texts":{"ta":{"blocks":[{"type":"text","text":"பசும்பொன் முத்துராமலிங்கத்தேவர் பிறந்த ஊர் மற்றும் பிறந்த ஆண்டு முறையே எவை?"}],"options":[{"key":"A","text":"கமுதி, 1906 அக்டோபர் 16"},{"key":"B","text":"பசும்பொன் (இராமநாதபுரம் மாவட்டம்), 1908 அக்டோபர் 30"},{"key":"C","text":"சாயல்குடி, 1909 செப்டம்பர் 15"},{"key":"D","text":"திருச்சுழி, 1908 அக்டோபர் 2"}],"explanation":"முத்துராமலிங்கத்தேவர் 1908-ஆம் ஆண்டு அக்டோபர் 30-ஆம் நாள் இராமநாதபுரம் மாவட்டத்திலுள்ள பசும்பொன் என்னும் ஊரில் பிறந்தார்."}}}
{"id":"b-tam-7t1-156","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 51"},"texts":{"ta":{"blocks":[{"type":"text","text":"முத்துராமலிங்கத்தேவரின் பெற்றோர்கள் யார்?"}],"options":[{"key":"A","text":"செல்லமுத்து - சக்குபாய்"},{"key":"B","text":"உக்கிர பாண்டியத்தேவர் - இந்திராணி அம்மையார்"},{"key":"C","text":"பொன்னம்பலத்தேவர் - சிவகாமி அம்மையார்"},{"key":"D","text":"மாயாண்டித்தேவர் - லட்சுமி அம்மையார்"}],"explanation":"இவரது பெற்றோர் உக்கிர பாண்டியத்தேவர் மற்றும் இந்திராணி அம்மையார் ஆவர்."}}}
{"id":"b-tam-7t1-157","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 51"},"texts":{"ta":{"blocks":[{"type":"text","text":"இளமையிலேயே அன்னையை இழந்த முத்துராமலிங்கத்தேவரை அன்போடு பாலூட்டி வளர்த்தவர் யார்?"}],"options":[{"key":"A","text":"அவரது பெரியம்மா"},{"key":"B","text":"கிறித்தவத் தாய் ஒருவர்"},{"key":"C","text":"இசுலாமியத் தாய் ஒருவர்"},{"key":"D","text":"ஊர்ப் பெண்மணி"}],"explanation":"இளமையிலேயே தாயை இழந்ததால் ஓர் இசுலாமியத் தாயினால் பாலூட்டி வளர்க்கப்பட்டார்."}}}
{"id":"b-tam-7t1-158","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 51"},"texts":{"ta":{"blocks":[{"type":"text","text":"முத்துராமலிங்கத்தேவர் இராமநாதபுரத்தில் உயர்நிலைக் கல்வி படித்துக் கொண்டிருந்தபோது அவரது படிப்பு பாதியில் நிற்கக் காரணமான தொற்றுநோய் எது?"}],"options":[{"key":"A","text":"காலரா"},{"key":"B","text":"பிளேக் நோய்"},{"key":"C","text":"மலேரியா"},{"key":"D","text":"அம்மை நோய்"}],"explanation":"அவ்வூரில் பிளேக் நோய் பரவியதால் பள்ளிப் படிப்பு நின்றது; அதன்பின் தாமாகவே நூல்களைப் படித்து அறிவை வளர்த்துக் கொண்டார்."}}}
{"id":"b-tam-7t1-159","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 52"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஆங்கில அரசால் வடஇந்தியாவில் பாலகங்காதர திலகருக்கும், தென்னிந்தியாவில் முத்துராமலிங்கத்தேவருக்கும் விதிக்கப்பட்ட கடுமையான தடைச் சட்டம் எது?"}],"options":[{"key":"A","text":"ரௌலட் சட்டம்"},{"key":"B","text":"குற்றப்பரம்பரைச் சட்டம்"},{"key":"C","text":"மேடைகளில் அரசியல் பேசக்கூடாது என்ற வாய்ப்பூட்டுச் சட்டம்"},{"key":"D","text":"ஆயுதத் தடைச் சட்டம்"}],"explanation":"வடநாட்டில் திலகருக்கும் தென்னாட்டில் முத்துராமலிங்கத்தேவருக்கும் மேடைகளில் பேச வாய்ப்பூட்டுச் சட்டம் விதிக்கப்பட்டது."}}}
{"id":"pyq-tam-7t1-160","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2018,"paper":"tamil","no":19},"texts":{"ta":{"blocks":[{"type":"text","text":"முத்துராமலிங்கத்தேவரின் விடுதலை வேட்கையை அறிந்து அவரைத் ‘தேசியம் காத்த செம்மல்’ என்று பாராட்டிய தமிழறிஞர் யார்?"}],"options":[{"key":"A","text":"தந்தை பெரியார்"},{"key":"B","text":"திரு. வி. கலியாணசுந்தரனார் (திரு.வி.க.)"},{"key":"C","text":"உ.வே.சா"},{"key":"D","text":"மறைமலையடிகள்"}],"explanation":"முத்துராமலிங்கத்தேவரைத் 'தேசியம் காத்த செம்மல்' என மனமாரப் பாராட்டியவர் திரு.வி.க. ஆவார்."}}}
{"id":"b-tam-7t1-161","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 52"},"texts":{"ta":{"blocks":[{"type":"text","text":"முத்துராமலிங்கத்தேவர் யாரைத் தனது அரசியல் குருவாக ஏற்றுக்கொண்டார்?"}],"options":[{"key":"A","text":"காந்தியடிகள்"},{"key":"B","text":"நேதாஜி சுபாஷ் சந்திரபோஸ்"},{"key":"C","text":"திலகர்"},{"key":"D","text":"விவேகானந்தர்"}],"explanation":"வங்கச்சிங்கம் என்று போற்றப்பட்ட நேதாஜி சுபாஷ் சந்திரபோஸைத் தமது அரசியல் குருவாக ஏற்றார்."}}}
{"id":"b-tam-7t1-162","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 52"},"texts":{"ta":{"blocks":[{"type":"text","text":"முத்துராமலிங்கத்தேவரின் அழைப்பை ஏற்று நேதாஜி சுபாஷ் சந்திரபோஸ் மதுரைக்கு வருகை தந்த நாள் எது?"}],"options":[{"key":"A","text":"1937 பிப்ரவரி 14"},{"key":"B","text":"1939 செப்டம்பர் 6"},{"key":"C","text":"1940 அக்டோபர் 30"},{"key":"D","text":"1942 ஆகஸ்ட் 8"}],"explanation":"1939-ஆம் ஆண்டு செப்டம்பர்த் திங்கள் ஆறாம் நாள் நேதாஜி மதுரைக்கு வருகை தந்தார்."}}}
{"id":"b-tam-7t1-163","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 52"},"texts":{"ta":{"blocks":[{"type":"text","text":"முத்துராமலிங்கத்தேவர் விடுதலைக்குப் பின் நடத்திய வார இதழின் பெயர் யாது?"}],"options":[{"key":"A","text":"பாரத மாதா"},{"key":"B","text":"நேதாஜி"},{"key":"C","text":"சிங்கம்"},{"key":"D","text":"சுயராஜ்யா"}],"explanation":"முத்துராமலிங்கத்தேவர் 'நேதாஜி' என்னும் பெயரில் வார இதழ் ஒன்றை நடத்தினார்."}}}
{"id":"b-tam-7t1-164","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 52"},"texts":{"ta":{"blocks":[{"type":"text","text":"முத்துராமலிங்கத்தேவர் முதன்முதலில் எந்த ஊரில் ‘விவேகானந்தரின் பெருமை’ என்னும் தலைப்பில் மூன்று மணிநேரம் சொற்பொழிவாற்றினார்?"}],"options":[{"key":"A","text":"கமுதி"},{"key":"B","text":"பசும்பொன்"},{"key":"C","text":"சாயல்குடி"},{"key":"D","text":"இராமநாதபுரம்"}],"explanation":"தேவர் முதன்முதலில் சாயல்குடி என்னும் ஊரில் விவேகானந்தரின் பெருமை குறித்து 3 மணிநேரம் உரையாற்றினார்."}}}
{"id":"b-tam-7t1-165","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 53"},"texts":{"ta":{"blocks":[{"type":"text","text":"சாயல்குடியில் முத்துராமலிங்கத்தேவரின் வீரமிக்க பேச்சைக் கேட்டு ‘இதுபோன்ற ஒரு பேச்சை நான் இதுவரை கேட்டதேயில்லை; இவரது பேச்சு விடுதலைப் போருக்குப் பெரிதும் உதவும்’ என்று மகிழ்ந்த தலைவர் யார்?"}],"options":[{"key":"A","text":"இராஜாஜி"},{"key":"B","text":"பெருந்தலைவர் காமராசர்"},{"key":"C","text":"பெரியார்"},{"key":"D","text":"அண்ணா"}],"explanation":"அக்கூட்டத்தில் உடனிருந்த காமராசர் முத்துராமலிங்கத்தேவரின் பேச்சை மனமாரப் பாராட்டினார்."}}}
{"id":"pyq-tam-7t1-166","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":27},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தென்னாட்டுச் சிங்கம் என்று தேவரைச் சொல்லுகிறார்களே, அது சாலப்பொருந்தும்; அவர் பேசத் தொடங்கியதும் சிங்கத்தின் முழக்கம் போலவே இருந்தது’ - என்று புகழ்ந்துரைத்தவர் யார்?"}],"options":[{"key":"A","text":"காமராசர்"},{"key":"B","text":"இராஜாஜி"},{"key":"C","text":"பேரறிஞர் அண்ணா"},{"key":"D","text":"திரு.வி.க."}],"explanation":"முத்துராமலிங்கத்தேவரைத் தென்னாட்டுச் சிங்கம் என்று பாராட்டியவர் பேரறிஞர் அண்ணா ஆவார்."}}}
{"id":"pyq-tam-7t1-167","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":41},"texts":{"ta":{"blocks":[{"type":"text","text":"‘முத்துராமலிங்கத்தேவர் பேச்சு உள்ளத்தில் இருந்து வெளிவருகிறது, உதடுகளிலிருந்து அல்ல... உள்ளத்தால் உண்மையெனப் பட்டதை மறைக்காமல் அப்படியே பேசிவிடுவது அவர் வழக்கம்’ - என்று பாராட்டிய மூதறிஞர் யார்?"}],"options":[{"key":"A","text":"பெரியார்"},{"key":"B","text":"மூதறிஞர் இராஜாஜி"},{"key":"C","text":"காமராசர்"},{"key":"D","text":"சத்தியமூர்த்தி"}],"explanation":"தேவரின் உள்ளத்து நேர்மையைப் பாராட்டி மூதறிஞர் இராஜாஜி இவ்வாறு புகழ்ந்தார்."}}}
{"id":"b-tam-7t1-168","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 53"},"texts":{"ta":{"blocks":[{"type":"text","text":"1937 சட்டமன்றத் தேர்தலில் முத்துராமலிங்கத்தேவர் இராமநாதபுரம் அரசர் சண்முக ராஜேஸ்வர சேதுபதியை எதிர்த்துப் போட்டியிட்டு வெற்றிபெற்ற போது லண்டனில் பாரிஸ்டர் படித்துக்கொண்டிருந்த எந்தத் தோழர் இதனைப் பாராட்டி எழுதினார்?"}],"options":[{"key":"A","text":"ப. ஜீவானந்தம்"},{"key":"B","text":"வி.வி. கிரி"},{"key":"C","text":"தோழர் கே.டி.கே. தங்கமணி"},{"key":"D","text":"சிங்காரவேலர்"}],"explanation":"இந்திய மாணவர்கள் எதிர்பார்த்திருந்த வெற்றி இது என்று கே.டி.கே. தங்கமணி லண்டனிலிருந்து குறிப்பிட்டார்."}}}
{"id":"b-tam-7t1-169","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 53"},"texts":{"ta":{"blocks":[{"type":"text","text":"பிறப்பாலேயே ஒருவரைக் குற்றவாளியாகக் கருதும் ஆங்கில அரசின் ‘குற்றப்பரம்பரைச் சட்டத்தை’ நீக்குவதற்காக முத்துராமலிங்கத்தேவர் எந்த ஊரில் மாநாட்டை நடத்தினார்?"}],"options":[{"key":"A","text":"பசும்பொன்"},{"key":"B","text":"கமுதி (1934 மே 12, 13)"},{"key":"C","text":"மதுரை"},{"key":"D","text":"இராமநாதபுரம்"}],"explanation":"1934-ஆம் ஆண்டு மே 12, 13 தேதிகளில் கமுதியில் குற்றப்பரம்பரைச் சட்ட எதிர்ப்பு மாநாட்டை நடத்தினார்."}}}
{"id":"pyq-tam-7t1-170","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":4},"texts":{"ta":{"blocks":[{"type":"text","text":"முத்துராமலிங்கத்தேவரின் தொடர் போராட்டத்தால் ஆங்கிலேயரின் ‘குற்றப்பரம்பரைச் சட்டம்’ எந்த ஆண்டு முற்றிலுமாக நீக்கப்பட்டது?"}],"options":[{"key":"A","text":"1942"},{"key":"B","text":"1948"},{"key":"C","text":"1950"},{"key":"D","text":"1952"}],"explanation":"தேவரின் இடைவிடாத போராட்டத்தால் 1948-ஆம் ஆண்டு குற்றப்பரம்பரைச் சட்டம் நீக்கப்பட்டது."}}}
{"id":"b-tam-7t1-171","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 54"},"texts":{"ta":{"blocks":[{"type":"text","text":"1939 ஜூலை 8 அன்று மதுரை மீனாட்சியம்மன் கோவில் நுழைவுப் போராட்டத்தை வைத்தியநாத ஐயர் முன்னெடுத்தபோது அர்ச்சகர்கள் புறக்கணித்ததால், எங்கிருந்து அர்ச்சகர்களை அழைத்து வந்து தேவர் அபோராட்டத்தை வெற்றிபெறச் செய்தார்?"}],"options":[{"key":"A","text":"பசும்பொன்"},{"key":"B","text":"திருச்சுழி"},{"key":"C","text":"இராமேஸ்வரம்"},{"key":"D","text":"கமுதி"}],"explanation":"திருச்சுழியில் இருந்து அர்ச்சகர்கள் இருவரை அழைத்து வந்து ஆலயப் பணியை முடக்காமல் கோவில் நுழைவை வெற்றிகரமாக்கினார்."}}}
{"id":"b-tam-7t1-172","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 54"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘உழுபவர்க்கே நிலம்’ என்று கூறித் தமக்குச் சொந்தமாக எத்தனை சிற்றூர்களில் இருந்த விளைநிலங்களைக் குத்தகை இல்லாமல் உழுபவர்க்கே பங்கிட்டுக் கொடுத்தார்?"}],"options":[{"key":"A","text":"21 சிற்றூர்கள்"},{"key":"B","text":"25 சிற்றூர்கள்"},{"key":"C","text":"31 சிற்றூர்கள்"},{"key":"D","text":"40 சிற்றூர்கள்"}],"explanation":"தமக்குச் சொந்தமாக 31 சிற்றூர்களில் இருந்த நிலங்களை ஏழை எளிய மக்களுக்கும் ஒடுக்கப்பட்டவர்க்கும் பங்கிட்டு அளித்தார்."}}}
{"id":"b-tam-7t1-173","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 54"},"texts":{"ta":{"blocks":[{"type":"text","text":"விவசாயிகளின் விளைபொருள்களுக்குச் சரியான விலை கிடைக்க வேண்டும் என்பதற்காகக் கமுதியில் முத்துராமலிங்கத்தேவர் தொடங்கிய கூட்டுறவு அமைப்பு எது?"}],"options":[{"key":"A","text":"உழவர் கூட்டுறவு வங்கி"},{"key":"B","text":"பாரதமாதா கூட்டுறவுப் பண்டகசாலை"},{"key":"C","text":"நேதாஜி விவசாய சங்கம்"},{"key":"D","text":"பசும்பொன் கூட்டுறவு சங்கம்"}],"explanation":"கமுதியில் வியாபாரிகளின் சுரண்டலைத் தடுத்து 'பாரதமாதா கூட்டுறவுப் பண்டகசாலை'யை ஏற்படுத்தினார்."}}}
{"id":"b-tam-7t1-174","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 54"},"texts":{"ta":{"blocks":[{"type":"text","text":"1938-இல் மதுரையில் எத்தனை தொழிலாளர் சங்கங்களின் தலைவராக முத்துராமலிங்கத்தேவர் திகழ்ந்தார்?"}],"options":[{"key":"A","text":"15 தொழிலாளர் சங்கங்கள்"},{"key":"B","text":"23 தொழிலாளர் சங்கங்கள்"},{"key":"C","text":"30 தொழிலாளர் சங்கங்கள்"},{"key":"D","text":"10 தொழிலாளர் சங்கங்கள்"}],"explanation":"1938 காலக்கட்டத்தில் மதுரையில் 23 தொழிலாளர் சங்கங்களின் தலைவராகத் தேவர் திகழ்ந்தார்."}}}
{"id":"b-tam-7t1-175","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 54"},"texts":{"ta":{"blocks":[{"type":"text","text":"1938-இல் மதுரையில் உள்ள நூற்பாலைத் தொழிலாளர்களின் உரிமைக்காக யாருடன் இணைந்து போராட்டம் நடத்தி ஏழு திங்கள் சிறைத் தண்டனை பெற்றார்?"}],"options":[{"key":"A","text":"காமராசர்"},{"key":"B","text":"தோழர் ப. ஜீவானந்தம்"},{"key":"C","text":"சிங்காரவேலர்"},{"key":"D","text":"அண்ணா"}],"explanation":"தோழர் ப. ஜீவானந்தத்துடன் இணைந்து நூற்பாலைத் தொழிலாளர்களுக்காகப் போராடினார்."}}}
{"id":"pyq-tam-7t1-176","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":61},"texts":{"ta":{"blocks":[{"type":"text","text":"முத்துராமலிங்கத்தேவர் இம்மண்ணுலகில் வாழ்ந்த நாள்கள் மற்றும் விடுதலைப் போராட்டத்திற்காகச் சிறையில் கழித்த நாள்கள் முறையே எவை?"}],"options":[{"key":"A","text":"வாழ்ந்த நாள்கள்: 25,000; சிறையில்: 5,000"},{"key":"B","text":"வாழ்ந்த நாள்கள்: 20,075; சிறையில்: 4,000 (வாழ்நாளில் ஐந்தில் ஒரு பங்கு)"},{"key":"C","text":"வாழ்ந்த நாள்கள்: 18,500; சிறையில்: 3,000"},{"key":"D","text":"வாழ்ந்த நாள்கள்: 22,000; சிறையில்: 4,500"}],"explanation":"பக்கம் 54 பெட்டகச் செய்தி: வாழ்ந்த நாள்கள் 20,075; சிறையில் கழித்த நாள்கள் 4,000 (சுமார் ஐந்தில் ஒரு பங்கு)."}}}
{"id":"b-tam-7t1-177","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 54"},"texts":{"ta":{"blocks":[{"type":"text","text":"இரண்டாம் உலகப்போர் சமயத்தில் முத்துராமலிங்கத்தேவர் மத்தியப் பிரதேசத்தில் உள்ள எந்த இராணுவச் சிறையில் அடைக்கப்பட்டிருந்தார்?"}],"options":[{"key":"A","text":"அலிப்பூர் சிறை"},{"key":"B","text":"அமராவதி சிறை"},{"key":"C","text":"தாமோ இராணுவச் சிறை"},{"key":"D","text":"ஜபல்பூர் சிறை"}],"explanation":"மத்தியப் பிரதேசத்தின் தாமோ என்னும் நகரில் உள்ள இராணுவச் சிறையில் போர்க்காலம் முழுவதும் அடைக்கப்பட்டிருந்தார்."}}}
{"id":"b-tam-7t1-178","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 54"},"texts":{"ta":{"blocks":[{"type":"text","text":"முத்துராமலிங்கத்தேவர் எந்த ஆண்டுகளுக்கு இடையே பர்மா நாட்டிற்கு இருமுறை சென்றிருந்தார்?"}],"options":[{"key":"A","text":"1930, 1945"},{"key":"B","text":"1936, 1955"},{"key":"C","text":"1938, 1958"},{"key":"D","text":"1940, 1960"}],"explanation":"தேவர் 1936, 1955 ஆகிய ஆண்டுகளில் பர்மா சென்றார்; அங்குப் பெண்கள் கூந்தலை விரித்து வரவேற்பதை ஏற்க மறுத்தார்."}}}
{"id":"pyq-tam-7t1-179","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2018,"paper":"tamil","no":58},"texts":{"ta":{"blocks":[{"type":"text","text":"இந்திய அஞ்சல் துறை பசும்பொன் முத்துராமலிங்கத்தேவருக்கு அஞ்சல்தலை வெளியிட்ட ஆண்டு எது?"}],"options":[{"key":"A","text":"1985"},{"key":"B","text":"1990"},{"key":"C","text":"1995"},{"key":"D","text":"2000"}],"explanation":"இந்திய அரசால் 1995-ஆம் ஆண்டு முத்துராமலிங்கத்தேவருக்குத் தபால் தலை வெளியிடப்பட்டுச் சிறப்பிக்கப்பட்டது."}}}
{"id":"b-tam-7t1-180","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":true,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 54"},"texts":{"ta":{"blocks":[{"type":"text","text":"முத்துராமலிங்கத்தேவரின் சிறப்புப் பெயர்களுள் பொருந்தாத ஒன்றைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"வித்யா பாஸ்கர், பிரவசன கேசரி"},{"key":"B","text":"சன்மார்க்க சண்டமாருதம்"},{"key":"C","text":"இந்து புத்தசமய மேதை"},{"key":"D","text":"செக்கிழுத்த செம்மல்"}],"explanation":"செக்கிழுத்த செம்மல் என்பது வ.உ.சிதம்பரனாரின் சிறப்புப் பெயர்; மற்றவை தேவரின் சிறப்புப் பெயர்கள்."}}}
{"id":"b-tam-7t1-181","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 55"},"texts":{"ta":{"blocks":[{"type":"text","text":"முத்துராமலிங்கத்தேவர் மறைந்த நாளும், ஆண்டுதோறும் தமிழக அரசால் அரசு விழா எடுக்கப்படும் நாளும் எது?"}],"options":[{"key":"A","text":"1963 செப்டம்பர் 15"},{"key":"B","text":"1963 அக்டோபர் 30"},{"key":"C","text":"1962 அக்டோபர் 2"},{"key":"D","text":"1965 நவம்பர் 14"}],"explanation":"தேவர் தாம் பிறந்த அதே அக்டோபர் 30-ஆம் நாளில் (1963) இவ்வுலகை விட்டு மறைந்தார்."}}}
{"id":"b-tam-7t1-243","kind":"assertion_reason","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 52"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"முத்துராமலிங்கத்தேவர் இந்திய தேசிய இராணுவத்தில் ஏராளமான தமிழர்களை இணைக்கக் காரணமாக இருந்தார்."},{"type":"reason","text":"அவர் நேதாஜி சுபாஷ் சந்திரபோஸைத் தமது அரசியல் குருவாக ஏற்றுக்கொண்டு, நேதாஜியை மதுரைக்கு வரவழைத்து மக்களிடையே எழுச்சியை ஊட்டினார்."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"நேதாஜியுடன் கொண்ட நெருங்கிய தோழமையினாலும் அழைப்பினாலும் தென் தமிழ்நாட்டிலிருந்து பெருந்திரளான வீரர்கள் INA-வில் இணைந்தனர்."}}}
