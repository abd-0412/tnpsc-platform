{"id":"pyq-tam-7t1-195","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":76},"texts":{"ta":{"blocks":[{"type":"text","text":"நன்னூல் என்னும் இலக்கண நூலை எழுதிய பவணந்தி முனிவரின்படி தமிழில் உள்ள ‘ஓரெழுத்து ஒருமொழிகளின்’ மொத்த எண்ணிக்கை யாது?"}],"options":[{"key":"A","text":"40 எழுத்துகள்"},{"key":"B","text":"42 எழுத்துகள்"},{"key":"C","text":"44 எழுத்துகள்"},{"key":"D","text":"46 எழுத்துகள்"}],"explanation":"நன்னூலார் பவணந்தி முனிவர் தமிழில் மொத்தம் 42 ஓரெழுத்து ஒருமொழிகள் உள்ளதாகக் குறிப்பிட்டுள்ளார்."}}}
{"id":"b-tam-7t1-196","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 60"},"texts":{"ta":{"blocks":[{"type":"text","text":"நன்னூல் குறிப்பிடும் 42 ஓரெழுத்து ஒருமொழிகளில் இடம்பெற்றுள்ள ‘குறில் எழுத்துகள்’ எவை?"}],"options":[{"key":"A","text":"அ, இ"},{"key":"B","text":"நொ, து (இரண்டு மட்டும்)"},{"key":"C","text":"எ, ஒ"},{"key":"D","text":"கு, சு"}],"explanation":"நொ (நோய்), து (உண்) ஆகிய இரண்டு மட்டுமே குறில் எழுத்துகள்; ஏனைய 40 சொற்களும் நெடில் எழுத்துகளாகும்."}}}
{"id":"b-tam-7t1-197","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"3","C":"4","D":"1"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 60"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஓரெழுத்து ஒருமொழிகளையும் அவற்றின் சரியான பொருள்களையும் பொருத்துக:"},{"type":"list","name":"ஓரெழுத்து ஒருமொழி","items":[{"label":"A","text":"ஆ"},{"label":"B","text":"ஊ"},{"label":"C","text":"ஏ"},{"label":"D","text":"ஐ"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"தலைவன்"},{"label":"2","text":"பசு"},{"label":"3","text":"இறைச்சி"},{"label":"4","text":"அம்பு"}]}],"options":[{"key":"A","text":"A-2, B-3, C-4, D-1","mapping":{"A":"2","B":"3","C":"4","D":"1"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}}],"explanation":"ஆ = பசு; ஊ = இறைச்சி; ஏ = அம்பு; ஐ = தலைவன்."}}}
{"id":"b-tam-7t1-198","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"4","B":"3","C":"1","D":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 60"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஓரெழுத்து ஒருமொழிகளைச் சரியான பொருளுடன் பொருத்துக:"},{"type":"list","name":"ஓரெழுத்து ஒருமொழி","items":[{"label":"A","text":"ஓ"},{"label":"B","text":"கா"},{"label":"C","text":"கோ"},{"label":"D","text":"சா"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"அரசன்"},{"label":"2","text":"இறந்துபோ"},{"label":"3","text":"சோலை"},{"label":"4","text":"மதகுநீர் தாங்கும் பலகை"}]}],"options":[{"key":"A","text":"A-4, B-3, C-1, D-2","mapping":{"A":"4","B":"3","C":"1","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-4, B-1, C-2, D-3","mapping":{"A":"4","B":"1","C":"2","D":"3"}},{"key":"D","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}}],"explanation":"ஓ = மதகுநீர் தாங்கும் பலகை; கா = சோலை; கோ = அரசன்; சா = இறந்துபோ."}}}
{"id":"b-tam-7t1-199","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 60"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஓரெழுத்து ஒருமொழிகளைச் சரியான பொருளுடன் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"சீ"},{"label":"B","text":"சோ"},{"label":"C","text":"மா"},{"label":"D","text":"மீ"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"மதில்"},{"label":"2","text":"வான்"},{"label":"3","text":"இகழ்ச்சி"},{"label":"4","text":"மாமரம்"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}}],"explanation":"சீ = இகழ்ச்சி; சோ = மதில்; மா = மாமரம்; மீ = வான்."}}}
{"id":"b-tam-7t1-200","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 60"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘யா’ மற்றும் ‘வௌ’ ஆகிய ஓரெழுத்து ஒருமொழிகளின் பொருள்கள் முறையே எவை?"}],"options":[{"key":"A","text":"மரக்கலம், வீசு"},{"key":"B","text":"அகலம், கவர் (பறித்தல்)"},{"key":"C","text":"அழகு, பயம்"},{"key":"D","text":"இரவு, ஒளி"}],"explanation":"யா = அகலம்; வௌ = கவர் (கவர்தல்/பறித்தல்)."}}}
{"id":"b-tam-7t1-201","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 60"},"texts":{"ta":{"blocks":[{"type":"text","text":"பவணந்தி முனிவர் கூறிய 42 ஓரெழுத்து ஒருமொழிகளில் தற்காலத்தில் பெருமளவு வழக்கில் உள்ள சொற்களின் எண்ணிக்கை எத்தனை?"}],"options":[{"key":"A","text":"12 சொற்கள்"},{"key":"B","text":"17 சொற்கள்"},{"key":"C","text":"24 சொற்கள்"},{"key":"D","text":"30 சொற்கள்"}],"explanation":"பக்கம் 60 தெரிந்து தெளிவோம் குறிப்பின்படி 17 ஓரெழுத்து ஒருமொழிகள் மட்டுமே தற்காலத்தில் பெருமளவு வழக்கில் உள்ளன."}}}
{"id":"b-tam-7t1-202","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 60"},"texts":{"ta":{"blocks":[{"type":"text","text":"சிறுசிறு உறுப்புகளாகப் பிரிக்கும் வகையில் அமையும் சொற்கள் எவ்வாறு அழைக்கப்படும்?"}],"options":[{"key":"A","text":"பகாப்பதங்கள்"},{"key":"B","text":"வேர்ச்சொற்கள்"},{"key":"C","text":"பகுபதங்கள் (எ.கா: வேலன், படித்தான்)"},{"key":"D","text":"அடிச்சொற்கள்"}],"explanation":"பகுபத உறுப்புகளாகப் பிரிக்கக்கூடிய சொற்களைப் பகுபதங்கள் என்பர்."}}}
{"id":"b-tam-7t1-203","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 61"},"texts":{"ta":{"blocks":[{"type":"text","text":"பகுபதமாக அமையும் பெயர்ச்சொல்லான ‘பெயர்ப்பகுபதம்’ எத்தனை வகைப்படும்?"}],"options":[{"key":"A","text":"நான்கு வகைப்படும்"},{"key":"B","text":"ஐந்து வகைப்படும்"},{"key":"C","text":"ஆறு வகைப்படும் (பொருள், இடம், காலம், சினை, பண்பு, தொழில்)"},{"key":"D","text":"எட்டு வகைப்படும்"}],"explanation":"பெயர்ப்பகுபதம் பொருள், இடம், காலம், சினை, பண்பு, தொழில் என 6 வகைப்படும்."}}}
{"id":"b-tam-7t1-204","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"4","C":"1","D":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 61"},"texts":{"ta":{"blocks":[{"type":"text","text":"பெயர்ப்பகுபதச் சொற்களை அவற்றுக்குரிய வகையோடு சரியாகப் பொருத்துக:"},{"type":"list","name":"பெயர்ப்பகுபதம்","items":[{"label":"A","text":"பொன்னன்"},{"label":"B","text":"நாடன்"},{"label":"C","text":"சித்திரையான்"},{"label":"D","text":"கண்ணன்"}]},{"type":"list","name":"வகை","items":[{"label":"1","text":"காலப் பெயர்ப்பகுபதம்"},{"label":"2","text":"சினைப் பெயர்ப்பகுபதம்"},{"label":"3","text":"பொருட் பெயர்ப்பகுபதம்"},{"label":"4","text":"இடப் பெயர்ப்பகுபதம்"}]}],"options":[{"key":"A","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"D","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}}],"explanation":"பொன்னன் = பொருள்; நாடன் = இடம்; சித்திரையான் = காலம்; கண்ணன் = சினை; இனியன் = பண்பு; உழவன் = தொழில்."}}}
{"id":"pyq-tam-7t1-205","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":81},"texts":{"ta":{"blocks":[{"type":"text","text":"பகுபத உறுப்புகள் மொத்தம் எத்தனை வகைப்படும்?"}],"options":[{"key":"A","text":"நான்கு வகைகள்"},{"key":"B","text":"ஆறு வகைகள் (பகுதி, விகுதி, இடைநிலை, சந்தி, சாரியை, விகாரம்)"},{"key":"C","text":"எட்டு வகைகள்"},{"key":"D","text":"பத்து வகைகள்"}],"explanation":"பகுபத உறுப்புகள் பகுதி, விகுதி, இடைநிலை, சந்தி, சாரியை, விகாரம் என 6 வகைப்படும்."}}}
{"id":"b-tam-7t1-206","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 61"},"texts":{"ta":{"blocks":[{"type":"text","text":"பகுபதத்தின் முதலில் அமைந்து முதன்மையான பொருளைத் தருவதும், வினைப்பகுபதத்தில் கட்டளையாகவே அமைவதும் எது?"}],"options":[{"key":"A","text":"விகுதி"},{"key":"B","text":"பகுதி"},{"key":"C","text":"இடைநிலை"},{"key":"D","text":"சந்தி"}],"explanation":"பகுபதத்தின் முதலில் நின்று பொருள் தருவது பகுதி ஆகும்; வினையில் இது கட்டளையாகவே வரும் (எ.கா: நட, உண்)."}}}
{"id":"b-tam-7t1-207","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 61"},"texts":{"ta":{"blocks":[{"type":"text","text":"பகுபதத்தின் இறுதியில் அமைந்து திணை, பால், எண், இடம் ஆகியவற்றையோ முற்று, எச்சம் ஆகியவற்றையோ காட்டுவது எது?"}],"options":[{"key":"A","text":"பகுதி"},{"key":"B","text":"விகுதி"},{"key":"C","text":"சாரியை"},{"key":"D","text":"இடைநிலை"}],"explanation":"பகுபதத்தின் இறுதியில் நின்று திணை, பால் போன்றவற்றைக் காட்டுவது விகுதி ஆகும்."}}}
{"id":"pyq-tam-7t1-208","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":79},"texts":{"ta":{"blocks":[{"type":"text","text":"பகுபதத்தில் பகுதிக்கும் விகுதிக்கும் இடையில் அமைந்து ‘காலம்’ அல்லது ‘எதிர்மறையைக்’ காட்டும் உறுப்பு எது?"}],"options":[{"key":"A","text":"சந்தி"},{"key":"B","text":"சாரியை"},{"key":"C","text":"இடைநிலை"},{"key":"D","text":"விகாரம்"}],"explanation":"பகுதிக்கும் விகுதிக்கும் இடையே காலம் அல்லது எதிர்மறையைக் காட்டுவது இடைநிலை ஆகும்."}}}
{"id":"b-tam-7t1-209","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 61"},"texts":{"ta":{"blocks":[{"type":"text","text":"பெரும்பாலும் பகுதிக்கும் இடைநிலைக்கும் இடையே இடம்பெறும் மெய்யெழுத்து எவ்வாறு அழைக்கப்படும்?"}],"options":[{"key":"A","text":"சாரியை"},{"key":"B","text":"சந்தி"},{"key":"C","text":"விகாரம்"},{"key":"D","text":"விகுதி"}],"explanation":"பகுதிக்கும் இடைநிலைக்கும் இடையே பெரும்பாலும் வருவது சந்தி ஆகும்."}}}
{"id":"b-tam-7t1-210","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 61"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வந்தனன்’ (வா(வ) + த்(ந்) + த் + அன் + அன்) என்னும் சொல்லில் முதல் ‘த்’ என்பது ந் எனத் திரிந்து இருப்பது எவ்வகை உறுப்பாகும்?"}],"options":[{"key":"A","text":"இடைநிலை"},{"key":"B","text":"சந்தி த் ஆனது ந் எனத் திரிந்த விகாரம்"},{"key":"C","text":"சாரியை"},{"key":"D","text":"விகுதி"}],"explanation":"பகுதி, சந்தி, இடைநிலை ஆகியவற்றில் ஏற்படும் மாற்றமே விகாரம் எனப்படும்."}}}
{"id":"b-tam-7t1-211","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 62"},"texts":{"ta":{"blocks":[{"type":"text","text":"மேலும் சிறிய உறுப்புகளாகப் பிரிக்க முடியாத, அடிச்சொல் அல்லது வேர்ச்சொல்லாக அமையும் சொல் எது?"}],"options":[{"key":"A","text":"பகுபதம்"},{"key":"B","text":"பகாப்பதம் (எ.கா: மரம், நட, மன், நனி)"},{"key":"C","text":"வினைமுற்று"},{"key":"D","text":"ஆகுபெயர்"}],"explanation":"பகுபத உறுப்புகளாகப் பிரிக்க முடியாத அடிச்சொல் அல்லது வேர்ச்சொல் 'பகாப்பதம்' எனப்படும்."}}}
{"id":"b-tam-7t1-212","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"4","C":"1","D":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 62"},"texts":{"ta":{"blocks":[{"type":"text","text":"பகாப்பதச் சொற்களை அவற்றின் வகையோடு சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"நிலம், நீர்"},{"label":"B","text":"நட, வா"},{"label":"C","text":"மன், கொல்"},{"label":"D","text":"உறு, தவ"}]},{"type":"list","name":"பகாப்பத வகை","items":[{"label":"1","text":"இடைப் பகாப்பதம்"},{"label":"2","text":"உரிப் பகாப்பதம்"},{"label":"3","text":"பெயர்ப் பகாப்பதம்"},{"label":"4","text":"வினைப் பகாப்பதம்"}]}],"options":[{"key":"A","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"D","text":"A-4, B-3, C-2, D-1","mapping":{"A":"4","B":"3","C":"2","D":"1"}}],"explanation":"நிலம், நீர் = பெயர்ப் பகாப்பதம்; நட, வா = வினைப் பகாப்பதம்; மன், கொல் = இடைப் பகாப்பதம்; உறு, தவ = உரிப் பகாப்பதம்."}}}
{"id":"b-tam-7t1-213","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 62"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எழுதினான்’ என்பது எவ்வகைச் சொல்?"}],"options":[{"key":"A","text":"பெயர்ப் பகுபதம்"},{"key":"B","text":"வினைப் பகுபதம் (எழுது + த் + ஆன்)"},{"key":"C","text":"பெயர்ப் பகாப்பதம்"},{"key":"D","text":"வினைப் பகாப்பதம்"}],"explanation":"எழுது + த் + ஆன் என உறுப்புகளாகப் பிரிக்கக்கூடிய வினைச்சொல் என்பதால் 'வினைப் பகுபதம்' ஆகும்."}}}
{"id":"b-tam-7t1-214","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 64"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஒரு தொடரில் ‘யார்? எது? எவை?’ என்னும் வினாக்களுக்கு விடையாக அமைவது எது?"}],"options":[{"key":"A","text":"பயனிலை"},{"key":"B","text":"எழுவாய் (Subject)"},{"key":"C","text":"செயப்படுபொருள்"},{"key":"D","text":"அடைமொழி"}],"explanation":"ஒரு தொடரில் யார், எது, எவை என்னும் வினாக்களுக்கு விடையாக அமைவது எழுவாய் ஆகும்."}}}
{"id":"b-tam-7t1-215","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 64"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஒரு தொடரில் ‘யாரை, எதை, எவற்றை’ என்னும் வினாக்களுக்கு விடையாக வருவது எது?"}],"options":[{"key":"A","text":"எழுவாய்"},{"key":"B","text":"செயப்படுபொருள் (Object)"},{"key":"C","text":"பயனிலை"},{"key":"D","text":"இடைநிலை"}],"explanation":"யாரை, எதை, எவற்றை என்ற வினாக்களுக்கு விடையாக அமைவது செயப்படுபொருள் ஆகும்."}}}
{"id":"b-tam-7t1-216","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 64"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வீரர்கள் நாட்டைக் காத்தனர்’ - இத்தொடரில் எழுவாய், செயப்படுபொருள், பயனிலை முறையே எவை?"}],"options":[{"key":"A","text":"காத்தனர், நாட்டை, வீரர்கள்"},{"key":"B","text":"வீரர்கள் (எழுவாய்), நாட்டை (செயப்படுபொருள்), காத்தனர் (பயனிலை)"},{"key":"C","text":"நாட்டை, வீரர்கள், காத்தனர்"},{"key":"D","text":"வீரர்கள், காத்தனர், நாட்டை"}],"explanation":"யார் காத்தனர்? வீரர்கள் (எழுவாய்); எதைக் காத்தனர்? நாட்டை (செயப்படுபொருள்); என்ன செய்தனர்? காத்தனர் (பயனிலை)."}}}
{"id":"b-tam-7t1-217","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 65"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கடல் பார்த்தாள்’ என்ற தொடரில் இடைச்சொல் ‘ஐ’ சேர்த்து எழுதக் கிடைக்கும் சரியான வடிவம் எது?"}],"options":[{"key":"A","text":"கடல் பார்த்தாள்"},{"key":"B","text":"கடலைப் பார்த்தாள்"},{"key":"C","text":"கடலில் பார்த்தாள்"},{"key":"D","text":"கடலொடு பார்த்தாள்"}],"explanation":"கடல் + ஐ + பார்த்தாள் = கடலைப் பார்த்தாள்."}}}
// ==============================================================================
// பாடம் 5: மொழியை ஆள்வோம், தலைவர்கள் சிறப்புப் பெயர்கள் & கலைச்சொற்கள் [Q218 - Q221, Q245]
// தலைவர்களின் அடைமொழிகள் (மூதறிஞர், வீரமங்கை, கட்டபொம்மன், கொடிகாத்தவர்), சிறப்புப் பெயர்கள் (வள்ளியம்மை, வ.உ.சி, பாரதியார், வாஞ்சிநாதன்),
// கலைச்சொற்கள் (Ballad, Courage, Sacrifice, Political Genius / Elocution, Unity, Slogan, Equality), திருக்குறள் 3 பால்கள் எண் குறியீடு
// ==============================================================================
{"id":"b-tam-7t1-218","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"4","C":"1","D":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 66"},"texts":{"ta":{"blocks":[{"type":"text","text":"விடுதலைப் போராட்டத் தலைவர்களின் அடைமொழிகளைப் பெயர்களோடு பொருத்துக:"},{"type":"list","name":"அடைமொழி","items":[{"label":"A","text":"மூதறிஞர்"},{"label":"B","text":"வீரமங்கை"},{"label":"C","text":"பாஞ்சாலங்குறிச்சி வீரன்"},{"label":"D","text":"கொடிகாத்தவர்"}]},{"type":"list","name":"தலைவர்","items":[{"label":"1","text":"கட்டபொம்மன்"},{"label":"2","text":"திருப்பூர் குமரன்"},{"label":"3","text":"இராஜாஜி"},{"label":"4","text":"வேலுநாச்சியார்"}]}],"options":[{"key":"A","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"D","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}}],"explanation":"மூதறிஞர் = இராஜாஜி; வீரமங்கை = வேலுநாச்சியார்; பாஞ்சாலங்குறிச்சி வீரன் = கட்டபொம்மன்; கொடிகாத்தவர் = திருப்பூர் குமரன்."}}}
{"id":"b-tam-7t1-219","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"4","C":"1","D":"3"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 66"},"texts":{"ta":{"blocks":[{"type":"text","text":"தலைவர்களின் சிறப்புப் பெயர்களைச் சரியாகப் பொருத்துக:"},{"type":"list","name":"சிறப்புப் பெயர்","items":[{"label":"A","text":"தில்லையாடியின் பெருமை"},{"label":"B","text":"கப்பலோட்டிய தமிழர்"},{"label":"C","text":"பாட்டுக்கொரு புலவன்"},{"label":"D","text":"மணியாட்சியின் தியாகி"}]},{"type":"list","name":"தலைவர்","items":[{"label":"1","text":"பாரதியார்"},{"label":"2","text":"வள்ளியம்மை"},{"label":"3","text":"வாஞ்சிநாதன்"},{"label":"4","text":"வ.உ.சிதம்பரனார்"}]}],"options":[{"key":"A","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"D","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}}],"explanation":"தில்லையாடியின் பெருமை = வள்ளியம்மை; கப்பலோட்டிய தமிழர் = வ.உ.சி.; பாட்டுக்கொரு புலவன் = பாரதியார்; மணியாட்சியின் தியாகி = வாஞ்சிநாதன்."}}}
{"id":"b-tam-7t1-220","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 66"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஆங்கிலக் கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"},{"type":"list","name":"ஆங்கிலச் சொல்","items":[{"label":"A","text":"Ballad"},{"label":"B","text":"Courage"},{"label":"C","text":"Sacrifice"},{"label":"D","text":"Political Genius"}]},{"type":"list","name":"தமிழாக்கம்","items":[{"label":"1","text":"துணிவு"},{"label":"2","text":"அரசியல் மேதை"},{"label":"3","text":"கதைப்பாடல்"},{"label":"4","text":"தியாகம்"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}}],"explanation":"Ballad = கதைப்பாடல்; Courage = துணிவு; Sacrifice = தியாகம்; Political Genius = அரசியல் மேதை."}}}
{"id":"b-tam-7t1-221","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"4","C":"1","D":"3"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 66"},"texts":{"ta":{"blocks":[{"type":"text","text":"கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"},{"type":"list","name":"ஆங்கிலச் சொல்","items":[{"label":"A","text":"Elocution"},{"label":"B","text":"Unity"},{"label":"C","text":"Slogan"},{"label":"D","text":"Equality"}]},{"type":"list","name":"தமிழாக்கம்","items":[{"label":"1","text":"முழக்கம்"},{"label":"2","text":"பேச்சாற்றல்"},{"label":"3","text":"சமத்துவம்"},{"label":"4","text":"ஒற்றுமை"}]}],"options":[{"key":"A","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"D","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}}],"explanation":"Elocution = பேச்சாற்றல்; Unity = ஒற்றுமை; Slogan = முழக்கம்; Equality = சமத்துவம்."}}}
{"id":"b-tam-7t1-245","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 65"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘திருக்குறள் ________ பால்களைக் கொண்டது’ - சரியான தமிழ் எண்ணைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"உ"},{"key":"B","text":"௩"},{"key":"C","text":"ச"},{"key":"D","text":"ரு"}],"explanation":"திருக்குறள் 3 (அறத்துப்பால், பொருட்பால், இன்பத்துப்பால்) பால்களைக் கொண்டது; 3 என்பதன் தமிழ் எண் குறியீடு '௩' ஆகும்."}}}
// ==============================================================================
// பாடம் 6: திருக்குறள் (வாழ்வியல் - அழுக்காறாமை, புறங்கூறாமை, அருளுடைமை, வாய்மை, இறைமாட்சி) [Q222 - Q242]
// அறன்ஆக்கம் வேண்டாதான், கொடுப்பது அழுக்கறுப்பான், அவ்வித்து அழுக்காறு (செய்யவள்-தவ்வை), அறனழீஇ,
// புறம்கூறிப் பொய்த்துயிர் வாழ்தலின் சாதல், பிறன்பழி கூறுவான், பகச்சொல்லி, அறன்நோக்கி ஆற்றுங்கொல் வையம்,
// அல்லல் அருள்ஆள்வார்க்கு (மல்லல், கரி), பொருளில்லார்க்கு இவ்வுலகம், பொருள்அற்றார் பூப்பர்,
// பொய்ம்மையும் வாய்மை இடத்த, மனத்தொடு வாய்மை, புறந்தூய்மை நீரான், எல்லா விளக்கும் (சொற்பொருள் பின்வருநிலை),
// படைகுடி கூழ்அமைச்சு (கூழ்=உணவு/நிதி), எஞ்சாமை (குறையாமை), தூங்காமை (சுறுசுறுப்பு), முறைசெய்து காப்பாற்றும் (இறை),
// செவிகைப்பச் சொற்பொறுக்கும் (கவிகை=குடை), கொடைஅளி செங்கோல் (அளி=கருணை, குடிஓம்பல்=பாதுகாத்தல்)
// ==============================================================================
{"id":"b-tam-7t1-222","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 67"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அறன்ஆக்கம் வேண்டாதான் என்பான் பிறனாக்கம் பேணாது அழுக்கறுப் பான்’ - இக்குறளின்படி தனக்கு நல்வளர்ச்சி வேண்டாம் என்று நினைப்பவன் எதைச் செய்வான்?"}],"options":[{"key":"A","text":"சோம்பேறியாக இருப்பான்"},{"key":"B","text":"மற்றவனுடைய வளர்ச்சியைக் கண்டு பொறாமைப்படுவான்"},{"key":"C","text":"செல்வத்தை இழப்பான்"},{"key":"D","text":"பொய் பேசுவான்"}],"explanation":"தனக்கு அறமும் ஆக்கமும் வேண்டாம் என்று விடுபவனே மற்றவனது உயர்வைக் கண்டு பொறாமைப்படுவான்."}}}
{"id":"b-tam-7t1-223","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 67"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கொடுப்பது அழுக்கறுப்பான் சுற்றம் உடுப்பதூஉம் உண்பதூஉம் இன்றிக் கெடும்’ - இக்குறட்பா உணர்த்தும் நீதி யாது?"}],"options":[{"key":"A","text":"தானம் செய்யாதவன் கெடுவான்"},{"key":"B","text":"பிறருக்குக் கொடுக்கப்படுவதைக் கண்டு பொறாமைப்படுபவனது சுற்றத்தாரும் உண்ண உணவும் உடுக்க உடையும் இன்றி அழிவர்"},{"key":"C","text":"சுற்றத்தாரோடு பகை கொள்ளக்கூடாது"},{"key":"D","text":"செல்வம் நிலைக்காது"}],"explanation":"பிறருக்கு ஈயப்படுவதைக் கண்டு பொறுக்காதவனின் சுற்றத்தாரும் ஆடை உணவின்றி வறுமையில் கெடுவர்."}}}
{"id":"b-tam-7t1-224","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 67"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அவ்வித்து அழுக்காறு உடையானைச் செய்யவள் தவ்வையைக் காட்டி விடும்’ - இதில் ‘செய்யவள்’ மற்றும் ‘தவ்வை’ முறையே யாரைக் குறிக்கிறது?"}],"options":[{"key":"A","text":"மகள், தாய்"},{"key":"B","text":"திருமகள் (சீதேவி), மூதேவி (மூத்தவள்)"},{"key":"C","text":"அரசி, வேலைக்காரி"},{"key":"D","text":"நங்கை, தோழி"}],"explanation":"மனம் சுருங்கிப் பொறாமைப்படுபவனைத் திருமகள் (செய்யவள்) நீங்கி, தன் அக்கா ஆகிய மூதேவியிடம் (தவ்வை) ஒப்படைத்து விடுவாள்."}}}
{"id":"b-tam-7t1-225","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 67"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அறனழீஇ அல்லவை செய்தலின் தீதே புறனழீஇப் பொய்த்து நகை’ - அறத்தை அழித்துச் செய்யும் பாவச் செயல்களைவிடக் கொடிய தீமை எது?"}],"options":[{"key":"A","text":"பொய் பேசுதல்"},{"key":"B","text":"ஒருவர் இல்லாதபோது அவரைப் புறம்பேசி, அவர் முன்னே பொய்யாகச் சிரித்து நடிப்பது"},{"key":"C","text":"களவு செய்தல்"},{"key":"D","text":"பெரியவரை இகழ்தல்"}],"explanation":"ஒருவனைப் புறத்தே இகழ்ந்துவிட்டு அவன் முன்னே பொய்யாக முகமலர்ச்சி காட்டி நகைப்பது அறத்தை அழித்தலை விடத் தீயதாகும்."}}}
{"id":"b-tam-7t1-226","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 67"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘புறம்கூறிப் பொய்த்துயிர் வாழ்தலின் சாதல் அறம்கூறும் ஆக்கம் தரும்’ - கோள்சொல்லி நடித்துப் பொய்யாய் உயிர்வாழ்வதைவிட எது மேலானது?"}],"options":[{"key":"A","text":"துறவறம் பூணுதல்"},{"key":"B","text":"இறந்துபோதல் (சாதல்)"},{"key":"C","text":"நாட்டை விட்டு விலகுதல்"},{"key":"D","text":"மௌனம் காத்தல்"}],"explanation":"புறங்கூறிப் பொய்யாக நடித்து உயிர் வாழ்வதைக் காட்டிலும் இறந்து போதலே அறநூல்கள் பாராட்டும் பயனைத் தரும்."}}}
{"id":"b-tam-7t1-227","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 67"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பிறன்பழி கூறுவான் தன்பழி யுள்ளும் திறன்தெரிந்து கூறப் படும்’ - பிறர் பழியைத் தேடிப் புறங்கூறுபவனுக்கு நேர்வது யாது?"}],"options":[{"key":"A","text":"அரசன் தண்டிப்பான்"},{"key":"B","text":"அவனது கடுமையான பழிகளை மற்றவர்கள் ஆராய்ந்து அவனுக்கு நேரே எடுத்துரைப்பர்"},{"key":"C","text":"செல்வம் அழியும்"},{"key":"D","text":"நண்பர்கள் கைவிடுவர்"}],"explanation":"பிறரது குற்றத்தை ஊரறியப் பேசுபவனது குற்றங்களை மற்றவர்கள் அவனைக் காட்டிலும் மிகக் கடுமையாகப் பேசிவிடுவர்."}}}
{"id":"b-tam-7t1-228","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 67"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பகச்சொல்லிக் கேளிர்ப் பிரிப்பர் நகச்சொல்லி நட்பாடல் தேற்றா தவர்’ - மகிழ்ந்து பேசிப் பழகத் தெரியாத கோள்சொல்பவர்கள் எதைச் செய்வர்?"}],"options":[{"key":"A","text":"பகைவரை வெல்வர்"},{"key":"B","text":"பொருளைச் சேர்ப்பர்"},{"key":"C","text":"புறம்பேசி நெருங்கிய உறவினரையும் நண்பரையும் கூடப் பிரித்துவிடுவர்"},{"key":"D","text":"நாட்டை ஆள்வர்"}],"explanation":"மகிழ்ந்து பழகத் தெரியாதவர் புறங்கூறி நண்பர்களையும் உறவினர்களையும் பிரித்து விடுவர்."}}}
{"id":"b-tam-7t1-229","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 67"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அறன்நோக்கி ஆற்றுங்கொல் வையம் புறன்நோக்கிப் புன்சொல் உரைப்பான் பொறை’ - மனிதன் இல்லாதபோது அவனைப் புறம்பேசுபவனின் உடலை உலகம் சுமப்பதற்கு என்ன காரணம் என வள்ளுவர் வியக்கிறார்?"}],"options":[{"key":"A","text":"அவன் செய்த தவத்தால்"},{"key":"B","text":"பூமித்தாயின் தர்மக் கடமை (பொறை) கருதியோ"},{"key":"C","text":"அரசனின் ஆணையால்"},{"key":"D","text":"அவனது செல்வத்தால்"}],"explanation":"புறங்கூறும் இழிமகனை நிலவுலகம் இன்னமும் சுமக்கின்றதே, அது பூமியின் பொறுமை அறம் கருதியோ என்று வியக்கிறார்."}}}
{"id":"b-tam-7t1-230","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 68"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அல்லல் அருள்ஆள்வார்க்கு இல்லை வளிவழங்கும் மல்லல்மா ஞாலம் கரி’ - இதில் ‘மல்லல்’ மற்றும் ‘கரி’ என்பதன் பொருள் முறையே யாது?"}],"options":[{"key":"A","text":"வறுமை, யானை"},{"key":"B","text":"வளம், சான்று"},{"key":"C","text":"பெருமை, கருமை"},{"key":"D","text":"காற்று, பூமி"}],"explanation":"மல்லல் = வளம்; கரி = சாட்சி (சான்று); அருள் உடையவர்க்குத் துன்பம் இல்லை என்பதற்கு வளம் நிறைந்த காற்றுலகு சான்றாகும்."}}}
{"id":"b-tam-7t1-231","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 68"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அருளில்லார்க்கு அவ்வுலகம் இல்லை ________ இவ்வுலகம் இல்லாகி யாங்கு’ - விடுபட்ட சரியான சீர் எது?"}],"options":[{"key":"A","text":"அறிவில்லார்க்கு"},{"key":"B","text":"பொருளில்லார்க்கு"},{"key":"C","text":"புகழில்லார்க்கு"},{"key":"D","text":"அன்பில்லார்க்கு"}],"explanation":"\"அருளில்லார்க்கு அவ்வுலகம் இல்லை பொருளில்லார்க்கு இவ்வுலகம் இல்லாகி யாங்கு\"."}}}
{"id":"b-tam-7t1-232","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 68"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பொருள்அற்றார் பூப்பர் ஒருகால் அருள்அற்றார் அற்றார்மற்று ஆதல் அரிது’ - செல்வத்தை இழந்தவர் கூடக் காலப்போக்கில் மீண்டும் செழிப்பர்; ஆனால் எதனை இழந்தவர் மீள முடியாது?"}],"options":[{"key":"A","text":"நிலத்தை இழந்தவர்"},{"key":"B","text":"பதவியை இழந்தவர்"},{"key":"C","text":"அருளை (கருணையை) இழந்தவர்"},{"key":"D","text":"ஆடைகளை இழந்தவர்"}],"explanation":"பொருளற்றவர் ஒருகாலத்தில் செழிக்கலாம்; ஆனால் அருள் அற்றவர் ஒருபோதும் உய்ய முடியாது."}}}
{"id":"pyq-tam-7t1-233","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2018,"paper":"tamil","no":11},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பொய்ம்மையும் வாய்மை இடத்த புரைதீர்ந்த ________ பயக்கும் எனின்’ - விடுபட்ட சீர் எது?"}],"options":[{"key":"A","text":"செல்வம்"},{"key":"B","text":"நன்மை"},{"key":"C","text":"புகழ்"},{"key":"D","text":"அறம்"}],"explanation":"\"பொய்ம்மையும் வாய்மை இடத்த புரைதீர்ந்த நன்மை பயக்கும் எனின்\" (குற்றமற்ற நன்மையை விளைவிக்குமானால் பொய்யும் மெய்யாகும்)."}}}
{"id":"b-tam-7t1-234","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 68"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மனத்தொடு வாய்மை மொழியின் தவத்தொடு தானம்செய் வாரின் தலை’ - ஒருவன் உள்ளத்தோடு உண்மையை உரைப்பானாயின் அவன் எவரைக் காட்டிலும் மேலானவன்?"}],"options":[{"key":"A","text":"அரசனை விட"},{"key":"B","text":"தவமும் தானமும் செய்பவரைக் காட்டிலும் மேலானவன்"},{"key":"C","text":"வேதங்கள் கற்றவனை விட"},{"key":"D","text":"போரில் வென்ற வீரனை விட"}],"explanation":"மனமறிய வாய்மை பேசுகின்றவன் தவமும் தானமும் ஒருங்கே செய்பவரைக் காட்டிலும் உயர்ந்தவன் ஆவான்."}}}
{"id":"pyq-tam-7t1-235","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":92},"texts":{"ta":{"blocks":[{"type":"text","text":"‘புறந்தூய்மை நீரான் அமையும் அகந்தூய்மை ________ காணப்படும்’ - மனிதனின் மனத்தூய்மை எதனால் வெளிப்படும்?"}],"options":[{"key":"A","text":"கல்வியால்"},{"key":"B","text":"வாய்மையால் (உண்மையால்)"},{"key":"C","text":"செல்வத்தால்"},{"key":"D","text":"அழகினால்"}],"explanation":"உடலின் தூய்மை நீரினால் உண்டாகும்; உள்ளத்தின் தூய்மை வாய்மையினால் மட்டுமே அறியப்படும்."}}}
{"id":"b-tam-7t1-236","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 68"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எல்லா விளக்கும் விளக்கல்ல சான்றோர்க்குப் பொய்யா விளக்கே விளக்கு’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?"}],"options":[{"key":"A","text":"உவமையணி"},{"key":"B","text":"சொற்பொருள் பின்வருநிலை அணி"},{"key":"C","text":"வேற்றுமையணி"},{"key":"D","text":"பிறிது மொழிதலணி"}],"explanation":"'விளக்கு' என்னும் சொல் ஒரே பொருளில் பலமுறை செய்யுளில் மீண்டும் மீண்டும் வந்துள்ளதால் இது சொற்பொருள் பின்வருநிலை அணி ஆகும்."}}}
{"id":"b-tam-7t1-237","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 69"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘படைகுடி கூழ்அமைச்சு நட்புஅரண் ஆறும் உடையான் அரசருள் ஏறு’ - இதில் அரசர்க்குரிய ஆறு உறுப்புகளில் ‘கூழ்’ என்பது எதனைக் குறிக்கிறது?"}],"options":[{"key":"A","text":"கஞ்சி"},{"key":"B","text":"உணவு அல்லது நிதி (பொருள்/தானியம்)"},{"key":"C","text":"ஆடை"},{"key":"D","text":"நிலம்"}],"explanation":"கூழ் என்பது நாட்டிற்கான உணவு, தானிய வளம் மற்றும் சேமிக்கப்பட்ட கருவூலப் பொருளைக் குறிக்கும்."}}}
{"id":"b-tam-7t1-238","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 69"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அஞ்சாமை ஈகை அறிவுஊக்கம் இந்நான்கும் எஞ்சாமை வேந்தற்கு இயல்பு’ - இதில் ‘எஞ்சாமை’ என்பதன் பொருள் யாது?"}],"options":[{"key":"A","text":"மிகுதியாக இருத்தல்"},{"key":"B","text":"குறையாமல் இருத்தல்"},{"key":"C","text":"மறைந்து போதல்"},{"key":"D","text":"வெளிப்படுதல்"}],"explanation":"அஞ்சாமை, ஈகை, அறிவு, ஊக்கம் ஆகிய நான்கும் அரசனிடம் எப்போதும் குறையாமல் இருக்க வேண்டும்."}}}
{"id":"b-tam-7t1-239","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 69"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தூங்காமை கல்வி துணிவுடைமை இம்மூன்றும் நீங்கா நிலன்ஆள் பவர்க்கு’ - இதில் ‘தூங்காமை’ என்பது எதைக் குறிக்கிறது?"}],"options":[{"key":"A","text":"இரவில் விழித்திருப்பது"},{"key":"B","text":"காலந்தாழ்த்தாத சுறுசுறுப்பு (சோம்பலின்மை)"},{"key":"C","text":"உறங்காமல் உழைப்பது"},{"key":"D","text":"கண்காணிப்பது"}],"explanation":"தூங்காமை என்பது செய்ய வேண்டிய காரியங்களைச் சோம்பலின்றி உடனுக்குடன் விரைந்து செய்யும் செயல்திறனைக் குறிக்கும்."}}}
{"id":"b-tam-7t1-240","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 69"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘முறைசெய்து காப்பாற்றும் மன்னவன் மக்கட்கு இறையென்று வைக்கப் படும்’ - நீதிநெறி தவறாது முறைசெய்து மக்களைக் காக்கும் மன்னன் எவ்வாறு மதிக்கப்படுவான்?"}],"options":[{"key":"A","text":"தலைவனாக"},{"key":"B","text":"மக்களால் கடவுளுக்கு இணையாக (இறை)"},{"key":"C","text":"போர்வீரனாக"},{"key":"D","text":"ஆசிரியனாக"}],"explanation":"நீதியோடு ஆட்சி புரியும் மன்னன் குடிமக்களால் கண்கண்ட தெய்வமாகவே போற்றப்படுவான்."}}}
{"id":"b-tam-7t1-241","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 69"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘செவிகைப்பச் சொற்பொறுக்கும் பண்புடை வேந்தன் கவிகைக்கீழ்த் தங்கும் உலகு’ - இதில் ‘கவிகை’ என்னும் சொல் எதனைக் குறிக்கிறது?"}],"options":[{"key":"A","text":"அரண்மனை"},{"key":"B","text":"அரசனின் வெண்கொற்றக்குடை"},{"key":"C","text":"வாள்"},{"key":"D","text":"கவசம்"}],"explanation":"கவிகை என்றால் குடை (வெண்கொற்றக்குடை) என்று பொருள்; கசப்பான அறிவுரையையும் பொறுக்கும் மன்னனின் குடைக்கீழ் உலகம் நிலைக்கும்."}}}
{"id":"b-tam-7t1-242","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 3, பக்கம் 69"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கொடைஅளி செங்கோல் குடிஓம்பல் நான்கும் உடையானாம் வேந்தர்க்கு ஒளி’ - இதில் ‘அளி’ மற்றும் ‘குடிஓம்பல்’ ஆகியவற்றின் பொருள்கள் முறையே எவை?"}],"options":[{"key":"A","text":"பரிசு, போர்"},{"key":"B","text":"கருணை (அன்பு), மக்களைப் பாதுகாத்தல்"},{"key":"C","text":"ஆணை, வரி"},{"key":"D","text":"செல்வம், மாளிகை"}],"explanation":"கொடை, அளி (கருணை), செங்கோல் முறைமை, குடிமக்களைக் காத்தல் ஆகிய நான்கும் அரசனுக்கு ஒளியாகும்."}}}
