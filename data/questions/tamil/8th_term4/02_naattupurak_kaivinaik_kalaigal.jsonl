{"id":"b-tam-8t4-008","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 70"},"texts":{"ta":{"blocks":[{"type":"text","text":"அன்றாடப் பயன்பாட்டுக்காக அழகிய பொருள்களைத் தொழில்முறையில் உருவாக்கும் கலை எவ்வாறு அழைக்கப்படும்?"}],"options":[{"key":"A","text":"நுண்கலை"},{"key":"B","text":"கைவினைக்கலை"},{"key":"C","text":"சிற்பக்கலை"},{"key":"D","text":"ஓவியக்கலை"}],"explanation":"அன்றாடப் பயன்பாட்டுக்காக அழகிய பொருள்களைத் தொழில்முறையில் உருவாக்கும் கலை கைவினைக்கலை எனப்படும்."}}}
{"id":"b-tam-8t4-009","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 70"},"texts":{"ta":{"blocks":[{"type":"text","text":"நாகை மாவட்டம் செம்பியன் கண்டியூரில் கண்டுபிடிக்கப்பட்ட சிறப்பான கலைப்பொருள்கள் எவை?"}],"options":[{"key":"A","text":"முதுமக்கள் தாழிகள்"},{"key":"B","text":"கலையழகு மிகுந்த மண்கலங்கள்"},{"key":"C","text":"செப்புத் திருமேனிகள்"},{"key":"D","text":"யானைத் தந்த சிற்பங்கள்"}],"explanation":"செம்பியன் கண்டியூரில் கலையழகு மிகுந்த மண்கலங்கள் கண்டுபிடிக்கப்பட்டுள்ளன."}}}
{"id":"b-tam-8t4-010","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 71"},"texts":{"ta":{"blocks":[{"type":"text","text":"சுடுமண் சிற்பங்களை ஆங்கிலத்தில் எவ்வாறு அழைப்பர்?"}],"options":[{"key":"A","text":"Cemetry"},{"key":"B","text":"டெரகோட்டா (Terracotta)"},{"key":"C","text":"Pottery"},{"key":"D","text":"Sculpture"}],"explanation":"மண்பாண்டங்களின் வளர்ச்சி நிலையாகிய சுடுமண் சிற்பங்களை ஆங்கிலத்தில் டெரகோட்டா என்பர்."}}}
{"id":"pyq-tam-8t4-011","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":42},"texts":{"ta":{"blocks":[{"type":"text","text":"கைவினைப் பொருள்கள் செய்வதற்கு மிகவும் ஏற்ற மூங்கில் வகை எது?"}],"options":[{"key":"A","text":"கல்மூங்கில்"},{"key":"B","text":"கூட்டுமூங்கில்"},{"key":"C","text":"மலைமூங்கில்"},{"key":"D","text":"நாணல் மூங்கில்"}],"explanation":"கல்மூங்கில், மலைமூங்கில், கூட்டுமூங்கில் என்பவற்றுள் 'கூட்டுமூங்கில்களே' கைவினைப் பொருள்கள் செய்வதற்கு ஏற்றவை."}}}
{"id":"b-tam-8t4-012","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 72"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கூம்பொடு மீப்பாய் களையாது’ என்னும் அடி மூலம் பாய்மரக் கப்பல்களில் பாய் பயன்படுத்தப்பட்ட செய்தியைக் கூறும் சங்க இலக்கிய நூல் எது?"}],"options":[{"key":"A","text":"நற்றிணை"},{"key":"B","text":"புறநானூறு"},{"key":"C","text":"அகநானூறு"},{"key":"D","text":"பதிற்றுப்பத்து"}],"explanation":"பாய்மரக் கப்பல்களில் பாய்கள் பயன்படுத்தப்பட்டதைப் புறநானூற்றுப் பாடல் அடி சுட்டுகிறது."}}}
{"id":"b-tam-8t4-013","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 73"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ்நாட்டின் மாநில மரமாகப் போற்றப்படுவது எது?"}],"options":[{"key":"A","text":"மாமரம்"},{"key":"B","text":"வேப்பமரம்"},{"key":"C","text":"பனைமரம்"},{"key":"D","text":"தென்னைமரம்"}],"explanation":"தமிழ்நாட்டின் மாநில மரமாகப் பனைமரம் விளங்குகிறது."}}}
{"id":"b-tam-8t4-014","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 73"},"texts":{"ta":{"blocks":[{"type":"text","text":"பிரம்பு என்பது எந்த வகையைச் சேர்ந்த தாவரம்?"}],"options":[{"key":"A","text":"மரவகை"},{"key":"B","text":"கொடிவகை"},{"key":"C","text":"புல்வகை"},{"key":"D","text":"பூண்டுவகை"}],"explanation":"பிரம்பு என்பது நீர்நிறைந்த வாய்க்கால் வரப்புகளிலும் மண்குகைகளிலும் வளரும் ஒரு கொடிவகையாகும்."}}}
{"id":"b-tam-8t4-015","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 73"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ்நாட்டில் பிரம்பு தற்போது அருகிவிட்டதால் நமது தேவைக்காக எந்தெந்த மாநிலங்கள் மற்றும் நாடுகளில் இருந்து பிரம்பு தருவிக்கப்படுகிறது?"}],"options":[{"key":"A","text":"கர்நாடகா, கேரளா"},{"key":"B","text":"அசாம், அந்தமான், மலேசியா"},{"key":"C","text":"மராட்டியம், வங்கம்"},{"key":"D","text":"சிங்கப்பூர், இலங்கை"}],"explanation":"பிரம்பு தற்பொழுது அசாம், அந்தமான், மலேசியா போன்ற இடங்களிலிருந்து தருவிக்கப்படுகிறது."}}}
{"id":"b-tam-8t4-016","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 73"},"texts":{"ta":{"blocks":[{"type":"text","text":"நாட்டுப்புறக் கைவினைக் கலைகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"பழந்தமிழ் இலக்கியங்களைப் பாதுகாத்து வைத்தவை பனையோலைகள் ஆகும்."},{"type":"statement","label":"II","text":"பானை செய்தல் என்பது 'வனைதல்' என்னும் கலையாகும்."},{"type":"statement","label":"III","text":"பிரம்பு கொடிவகையைச் சேர்ந்த தாவரம் ஆகும்."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"நாட்டுப்புறக் கைவினைக் கலைகள் பாடப்பகுதியிலுள்ள மூன்று கூற்றுகளும் முற்றிலும் சரியானவை."}}}
{"id":"b-tam-8t4-017","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 74"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மட்டுமல்ல’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"மட்டு + மல்ல"},{"key":"B","text":"மட்டம் + அல்ல"},{"key":"C","text":"மட்டு + அல்ல"},{"key":"D","text":"மட்டும் + அல்ல"}],"explanation":"மட்டு + அல்ல = உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி ட் + அ = ட ஆகி 'மட்டுமல்ல' எனப் புணரும்."}}}
{"id":"b-tam-8t4-018","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 74"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கயிறு + கட்டில்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"கயிற்றுக்கட்டில்"},{"key":"B","text":"கயிர்க்கட்டில்"},{"key":"C","text":"கயிறுக்கட்டில்"},{"key":"D","text":"கயிற்றுகட்டில்"}],"explanation":"இயற்கை புணர்ச்சி விதிகளின்படி கயிறு + கட்டில் என்பது 'கயிற்றுக்கட்டில்' என மாறும்."}}}
{"id":"b-tam-8t4-041","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 70"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ்நாட்டில் ஆதிச்சநல்லூரில் கண்டெடுக்கப்பட்ட தொல்பொருள்களுள் குறிப்பிடத்தக்கது எது?"}],"options":[{"key":"A","text":"சுடுமண் பொம்மைகள்"},{"key":"B","text":"முதுமக்கள் தாழிகள்"},{"key":"C","text":"செப்பேடுகள்"},{"key":"D","text":"நாணயங்கள்"}],"explanation":"தமிழ்நாட்டில் ஆதிச்சநல்லூரில் இறந்தவர்களின் உடல்களைப் புதைக்கப் பயன்படுத்திய முதுமக்கள் தாழிகள் கிடைத்துள்ளன."}}}
{"id":"b-tam-8t4-042","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 70"},"texts":{"ta":{"blocks":[{"type":"text","text":"மதுரைக்கு அருகில் உள்ள எந்த ஊரில் ஏராளமான சுடுமண் பொருள்கள் கிடைத்துள்ளன?"}],"options":[{"key":"A","text":"கொற்கை"},{"key":"B","text":"கீழடி"},{"key":"C","text":"உறையூர்"},{"key":"D","text":"அரிக்கமேடு"}],"explanation":"மதுரைக்கு அருகில் உள்ள கீழடியில் ஏராளமான சுடுமண் பொருள்கள் அகழ்வாராய்ச்சியில் கிடைத்துள்ளன."}}}
{"id":"b-tam-8t4-043","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 72"},"texts":{"ta":{"blocks":[{"type":"text","text":"மூங்கில் வகைகளுள் கைவினைப் பொருள்கள் செய்வதற்கு மிகவும் ஏற்ற மூங்கில் எது?"}],"options":[{"key":"A","text":"கல்மூங்கில்"},{"key":"B","text":"கூட்டுமூங்கில்"},{"key":"C","text":"மலைமூங்கில்"},{"key":"D","text":"சாதாரண மூங்கில்"}],"explanation":"கல்மூங்கில், மலைமூங்கில், கூட்டுமூங்கில் என்பவற்றுள் கூட்டுமூங்கில்களே கைவினைப் பொருள்கள் செய்வதற்கு ஏற்றவை."}}}
{"id":"b-tam-8t4-044","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 72"},"texts":{"ta":{"blocks":[{"type":"text","text":"குழந்தைகளைப் படுக்கவைக்கப் பயன்படும் பாய் வகை எது?"}],"options":[{"key":"A","text":"பந்திப்பாய்"},{"key":"B","text":"தடுக்குப்பாய்"},{"key":"C","text":"திண்ணைப்பாய்"},{"key":"D","text":"பட்டுப்பாய்"}],"explanation":"குழந்தைகளைப் படுக்கவைப்பது தடுக்குப்பாய் ஆகும்."}}}
{"id":"b-tam-8t4-045","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 72"},"texts":{"ta":{"blocks":[{"type":"text","text":"இசுலாமியர் தொழுகைக்குப் பயன்படுத்தும் பாய் வகை எது?"}],"options":[{"key":"A","text":"பட்டுப்பாய்"},{"key":"B","text":"தொழுகைப்பாய்"},{"key":"C","text":"திண்ணைப்பாய்"},{"key":"D","text":"பந்திப்பாய்"}],"explanation":"இசுலாமியர் தொழுகைக்குப் பயன்படுத்தும் பாய் தொழுகைப்பாய் எனப்படும்."}}}
{"id":"b-tam-8t4-046","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 73"},"texts":{"ta":{"blocks":[{"type":"text","text":"பிரம்பு என்பது எந்தத் தாவர வகையைச் சார்ந்தது?"}],"options":[{"key":"A","text":"மரவகை"},{"key":"B","text":"கொடிவகை"},{"key":"C","text":"புல்வகை"},{"key":"D","text":"கிழங்குவகை"}],"explanation":"பிரம்பு என்பது கொடிவகையைச் சேர்ந்த ஒரு தாவரமாகும்."}}}
{"id":"b-tam-8t4-058","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 74"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மட்டுமல்ல’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"மட்டு + மல்ல"},{"key":"B","text":"மட்டு + அல்ல"},{"key":"C","text":"மட்டம் + அல்ல"},{"key":"D","text":"மட்டும் + அல்ல"}],"explanation":"மட்டு + அல்ல = உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி ட் + அ = ட ஆகி 'மட்டுமல்ல' எனப் புணரும்."}}}
{"id":"b-tam-8t4-059","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 74"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கயிறு + கட்டில்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"கயிற்றுக்கட்டில்"},{"key":"B","text":"கயிர்க்கட்டில்"},{"key":"C","text":"கயிறுக்கட்டில்"},{"key":"D","text":"கயிற்றுகட்டில்"}],"explanation":"இயற்கை புணர்ச்சி விதிகளின்படி கயிறு + கட்டில் என்பது 'கயிற்றுக்கட்டில்' என மாறும்."}}}
{"id":"b-tam-8t4-065","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 70"},"texts":{"ta":{"blocks":[{"type":"text","text":"சிந்துசமவெளி அகழாய்வில் கண்டுபிடிக்கப்பட்ட கைவினைப் பொருள்கள் எவை?"}],"options":[{"key":"A","text":"செப்புத் திருமேனிகள்"},{"key":"B","text":"பானை ஓடுகள்"},{"key":"C","text":"துணி வகைகள்"},{"key":"D","text":"பனையோலைச் சுவடிகள்"}],"explanation":"சிந்துசமவெளி அகழாய்வில் பானை ஓடுகள் கிடைத்துள்ளன; இது மண்பாண்டக் கலையின் தொன்மையை உணர்த்தும்."}}}
{"id":"b-tam-8t4-066","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 72"},"texts":{"ta":{"blocks":[{"type":"text","text":"திருமணங்களுக்குப் பயன்படுத்தப்படும் பாய்களின் சிறப்பு என்ன?"}],"options":[{"key":"A","text":"மஞ்சள் நிறம் கொண்டவை"},{"key":"B","text":"மணமக்களின் பெயர்கள் மற்றும் வழிபாட்டுச் சின்னங்கள் இடம்பெற்றிருக்கும் (பட்டுப்பாய்)"},{"key":"C","text":"பட்டுத் நூலால் மட்டுமே நெய்யப்படுபவை"},{"key":"D","text":"மூங்கில் இழைகளால் ஆனவை"}],"explanation":"திருமணத்துக்குப் பயன்படுத்தும் பட்டுப்பாய்களில் மணமக்களின் பெயர்கள், குத்துவிளக்கு, மயில் போன்ற உருவங்கள் இடம்பெறும்."}}}
{"id":"b-tam-8t4-067","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 73"},"texts":{"ta":{"blocks":[{"type":"text","text":"பனைமட்டையின் நாரிலிருந்து எவை உருவாக்கப்படுகின்றன?"}],"options":[{"key":"A","text":"பாய் மற்றும் கூடை"},{"key":"B","text":"கயிறு, கட்டில், கூடை"},{"key":"C","text":"விசிறி, தொப்பி"},{"key":"D","text":"ஓலைச்சுவடிகள்"}],"explanation":"பனைமட்டையின் நாரிலிருந்து கயிறு, கட்டில், கூடை போன்றவை செய்யப்படுகின்றன."}}}
{"id":"b-tam-8t4-072","kind":"assertion_reason","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 70"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"மண்பாண்டக் கலை தமிழரின் மிகப்பழமையான கைவினைக்கலைகளில் ஒன்றாக விளங்குகிறது."},{"type":"reason","text":"சிந்துசமவெளி அகழ்ாய்விலும் தமிழகத்தின் ஆதிச்சநல்லூர், கீழடி போன்ற இடங்களிலும் மண்பாண்டங்களும் சுடுமண் பொருள்களும் ஏராளமாகக் கிடைத்துள்ளன."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"தொல்லியல் சான்றுகள் மண்பாண்டக் கலையின் தொன்மையை உறுதிப்படுத்துகின்றன; கூற்றும் காரணமும் சரியானவையே."}}}
