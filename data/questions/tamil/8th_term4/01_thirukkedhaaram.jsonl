// பாடம் 1: திருக்கேதாரம் (கவிதைப்பேழை - சுந்தரர் தேவாரம்) [Q001 - Q007, Q036 - Q040, Q060, Q061, Q064]
// வினாக்கள் எண்ணிக்கை: 15
// ==============================================================================
{"id":"b-tam-8t4-001","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 68"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பண்ணின்தமிழ் இசைபாடலின் பழவேய்முழவு அதிரக் கண்ணின்ஒளி கனகச்சுனை வயிரம்அவை சொரிய...’ - என்னும் தேவாரப் பாடலை இயற்றியவர் யார்?"}],"options":[{"key":"A","text":"திருஞானசம்பந்தர்"},{"key":"B","text":"சுந்தரர்"},{"key":"C","text":"திருநாவுக்கரசர்"},{"key":"D","text":"மாணிக்கவாசகர்"}],"explanation":"திருக்கேதாரம் என்னும் திருத்தலத்தின் இசைச் சிறப்பைப் பாடியவர் சுந்தரர் ஆவார்; இப்பாடல்கள் ஏழாம் திருமுறையில் இடம்பெற்றுள்ளன."}}}
{"id":"b-tam-8t4-002","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 68"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘திருக்கேதாரம்’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"பண்"},{"label":"B","text":"கனகச்சுனை"},{"label":"C","text":"மதவேழங்கள்"},{"label":"D","text":"முரலும்"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"பொன் வண்ண நீர்நிலை"},{"label":"2","text":"முழங்கும்"},{"label":"3","text":"இசை"},{"label":"4","text":"மதயானைகள்"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}}],"explanation":"பண் = இசை; கனகச்சுனை = பொன் வண்ண நீர்நிலை; மதவேழங்கள் = மதயானைகள்; முரலும் = முழங்கும்; பழவேய் = முதிர்ந்த மூங்கில்; முழவு = இசைக்கருவி."}}}
{"id":"b-tam-8t4-003","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 69"},"texts":{"ta":{"blocks":[{"type":"text","text":"தேவாரம் பாடிய மூவருள் ஒருவராகவும் ‘நம்பியாரூரர், தம்பிரான் தோழர்’ என்னும் சிறப்புப் பெயர்களால் அழைக்கப்படுபவர் யார்?"}],"options":[{"key":"A","text":"திருஞானசம்பந்தர்"},{"key":"B","text":"சுந்தரர்"},{"key":"C","text":"திருநாவுக்கரசர்"},{"key":"D","text":"மாணிக்கவாசகர்"}],"explanation":"சுந்தரர் நம்பியாரூரர் என்றும் தம்பிரான் தோழர் என்றும் அழைக்கப்படுகிறார்; இவரது பாடல்கள் பன்னிரு திருமுறைகளில் 7-ஆம் திருமுறையாக வைக்கப்பட்டுள்ளன."}}}
{"id":"pyq-tam-8t4-004","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":18},"texts":{"ta":{"blocks":[{"type":"text","text":"திருஞானசம்பந்தர், திருநாவுக்கரசர், சுந்தரர் ஆகிய மூவர் பாடிய தேவாரத் திருமுறைகளைத் தொகுத்தவர் யார்?"}],"options":[{"key":"A","text":"சேக்கிழார்"},{"key":"B","text":"நச்சினார்க்கினியர்"},{"key":"C","text":"நம்பியாண்டார் நம்பி"},{"key":"D","text":"உமறுப்புலவர்"}],"explanation":"தேவாரப் பாடல்களைத் தொகுத்தவர் நம்பியாண்டார் நம்பி ஆவார்."}}}
{"id":"b-tam-8t4-005","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 69"},"texts":{"ta":{"blocks":[{"type":"text","text":"சுந்தரர் மற்றும் தேவார நூல்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"சுந்தரர் அருளிய தேவாரப் பாடல்கள் பன்னிரு திருமுறைகளுள் ஏழாம் திருமுறையாக வைக்கப்பட்டுள்ளன."},{"type":"statement","label":"II","text":"இவர் இயற்றிய திருத்தொண்டத் தொகையை முதல் நூலாகக் கொண்டே சேக்கிழார் பெரியபுராணத்தைப் படைத்தார்."},{"type":"statement","label":"III","text":"இப்பாடலில் ஒவ்வொரு அடியிலும் நான்கு சீர்கள் இடம்பெற்றுள்ளதால் இது அளவடி எனப்படும்."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"நூல் வெளி மற்றும் இலக்கண விளக்கத்தின்படி மேற்கண்ட மூன்று கூற்றுகளும் முற்றிலும் சரியானவை."}}}
{"id":"b-tam-8t4-006","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 69"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கனகச்சுனை’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"கனகச் + சுனை"},{"key":"B","text":"கனக + சுனை"},{"key":"C","text":"கனம் + சுனை"},{"key":"D","text":"கனகம் + சுனை"}],"explanation":"கனகம் + சுனை = மவ்வீறு ஒற்றழிந்து உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'கனகச்சுனை' எனப் புணரும்."}}}
{"id":"b-tam-8t4-007","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 69"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘முழவு + அதிர’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"முழவுதிர"},{"key":"B","text":"முழவுதிரை"},{"key":"C","text":"முழவதிர"},{"key":"D","text":"முழவு அதிர"}],"explanation":"உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி உ கெட்டு, வ் + அ = வ ஆகி 'முழவதிர' எனப் புணரும்."}}}
{"id":"b-tam-8t4-036","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 68"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கண்ணின் ஒளி கனகச்சுனை வயிரம்அவை சொரிய...’ - இப்பாடலில் ‘கனகச்சுனை’ என்னும் சொல்லின் பொருள் யாது?"}],"options":[{"key":"A","text":"தங்கக் குளம்"},{"key":"B","text":"பொன் வண்ண நீர்நிலை"},{"key":"C","text":"வைரக் குகை"},{"key":"D","text":"அருவி நீர்"}],"explanation":"கனகச்சுனை என்றால் பொன் வண்ண நீர்நிலை என்று பொருள்."}}}
{"id":"b-tam-8t4-037","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 68"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மண்நின்றன மதவேழங்கள் மணிவாரிக்கொண்டு எறியக் கிண்என்றுஇசை முரலும்...’ - இப்பாடலில் ‘மதவேழங்கள்’ எனக் குறிக்கப்படுபவை எவை?"}],"options":[{"key":"A","text":"காட்டுக்குதிரைகள்"},{"key":"B","text":"மதயானைகள்"},{"key":"C","text":"காட்டுப்பன்றிகள்"},{"key":"D","text":"புலிகள்"}],"explanation":"வேழம் என்றால் யானையைக் குறிக்கும்; மதவேழங்கள் என்பது மதயானைகளைக் குறிப்பதாகும்."}}}
{"id":"b-tam-8t4-038","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 68"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பழவேய்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைக்கும் சொல் யாது?"}],"options":[{"key":"A","text":"பழமை + வேய்"},{"key":"B","text":"பழமை + வேய் (முதிர்ந்த மூங்கில்)"},{"key":"C","text":"பழம் + வேய்"},{"key":"D","text":"பழ + வேய்"}],"explanation":"பழவேய் என்பது பழமை + வேய் (முதிர்ந்த மூங்கில்) எனப் பிரியும்."}}}
{"id":"b-tam-8t4-039","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 69"},"texts":{"ta":{"blocks":[{"type":"text","text":"சுந்தரரின் தேவாரப் பாடல்கள் பன்னிரு திருமுறைகளில் எத்தனையாவது திருமுறையாக வைக்கப்பட்டுள்ளன?"}],"options":[{"key":"A","text":"ஐந்தாம் திருமுறை"},{"key":"B","text":"ஏழாம் திருமுறை"},{"key":"C","text":"ஒன்பதாம் திருமுறை"},{"key":"D","text":"பன்னிரண்டாம் திருமுறை"}],"explanation":"சுந்தரர் அருளிய தேவாரப் பாடல்கள் பன்னிரு திருமுறைகளுள் ஏழாம் திருமுறையாக வைக்கப்பட்டுள்ளன."}}}
{"id":"b-tam-8t4-040","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 69"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஒவ்வொரு அடியிலும் நான்கு சீர்களைக் கொண்ட அடி எவ்வாறு அழைக்கப்படும்?"}],"options":[{"key":"A","text":"குறளடி"},{"key":"B","text":"அளவடி (நேரடி)"},{"key":"C","text":"சிந்தடி"},{"key":"D","text":"நெடிலடி"}],"explanation":"நான்கு சீர்களைக் கொண்ட அடி அளவடி எனப்படும்."}}}
{"id":"b-tam-8t4-060","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 69"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கனகச்சுனை’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"கனகச் + சுனை"},{"key":"B","text":"கனக + சுனை"},{"key":"C","text":"கனகம் + சுனை"},{"key":"D","text":"கனம் + சுனை"}],"explanation":"கனகம் + சுனை = மவ்வீறு ஒற்றழிந்து உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'கனகச்சுனை' எனப் புணரும்."}}}
{"id":"b-tam-8t4-061","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 69"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘முழவு + அதிர’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"முழவுதிர"},{"key":"B","text":"முழவுதிரை"},{"key":"C","text":"முழவதிர"},{"key":"D","text":"முழவு அதிர"}],"explanation":"உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி உ கெட்டு, வ் + அ = வ ஆகி 'முழவதிர' எனப் புணரும்."}}}
{"id":"b-tam-8t4-064","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 4, பக்கம் 68"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘திருக்கேதாரம்’ பாடலில் முதிர்ந்த மூங்கில்களால் அதிர்ந்து ஒலிக்கும் இசைக்கருவி எது?"}],"options":[{"key":"A","text":"யாழ்"},{"key":"B","text":"பழவேய் முழவு (புல்லாங்குழல் மற்றும் முழவு)"},{"key":"C","text":"மதளம்"},{"key":"D","text":"உடுக்கை"}],"explanation":"பண்ணோடு சேர்ந்த தமிழ்ப் பாடல்களுக்கு ஏற்ப முதிர்ந்த மூங்கில்களால் ஆகிய புல்லாங்குழலும் முழவும் ஒலிக்கும்."}}}
