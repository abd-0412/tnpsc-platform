// பாடம் 1: பராபரக் கண்ணி (கவிதைப்பேழை - தாயுமானவர்) [Q071 - Q080]
// தண்டருள்கூர் செம்மையருக்கு, தண்டருள்/கூர்/செம்மையருக்கு/ஏவல், விசயரகுநாத சொக்கலிங்கர்,
// தமிழ் மொழியின் உபநிடதம், கண்ணி விளக்கம், அன்பர்பணி செய்யஎனை, புணர்ச்சி (தம்முயிர், இன்புற்றிருக்க, தானென்று), சோம்பல்
// ==============================================================================
{"id":"b-tam-6t3-071","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 24"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தம்உயிர்போல் எவ்வுயிரும் தானென்று தண்டருள்கூர் செம்மையருக்கு ஏவல்என்று செய்வேன் பராபரமே!’ - இவ்வடிகளை இயற்றியவர் யார்?"}],"options":[{"key":"A","text":"வள்ளலார்"},{"key":"B","text":"தாயுமானவர்"},{"key":"C","text":"பட்டினத்தார்"},{"key":"D","text":"குமரகுருபரர்"}],"explanation":"பராபரக் கண்ணி என்னும் தலைப்பில் அமைந்த இப்பாடலை இயற்றியவர் தாயுமானவர் ஆவார்."}}}
{"id":"b-tam-6t3-072","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 24"},"texts":{"ta":{"blocks":[{"type":"text","text":"பராபரக் கண்ணி பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"தண்டருள்"},{"label":"B","text":"கூர்"},{"label":"C","text":"செம்மையருக்கு"},{"label":"D","text":"ஏவல்"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"மிகுதி"},{"label":"2","text":"குளிர்ந்த கருணை"},{"label":"3","text":"தொண்டு"},{"label":"4","text":"சான்றோருக்கு"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}}],"explanation":"தண்டருள் = குளிர்ந்த கருணை; கூர் = மிகுதி; செம்மையருக்கு = சான்றோருக்கு; ஏவல் = தொண்டு; பராபரமே = மேலான பொருளே; பணி = தொண்டு; எய்தும் = கிடைக்கும்."}}}
{"id":"b-tam-6t3-073","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"தாயுமானவர் திருச்சியை ஆண்ட எந்த மன்னரிடம் தலைமைக் கணக்கராகப் பணிபுரிந்தார்?"}],"options":[{"key":"A","text":"இரகுநாத சேதுபதி"},{"key":"B","text":"விசயரகுநாத சொக்கலிங்கர்"},{"key":"C","text":"மங்கம்மாள்"},{"key":"D","text":"முத்துவடுகநாதர்"}],"explanation":"தாயுமானவர் திருச்சியை ஆண்ட விசயரகுநாத சொக்கலிங்கரிடம் தலைமைக் கணக்கராகப் பணிபுரிந்தார்."}}}
{"id":"pyq-tam-6t3-074","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":33},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தமிழ் மொழியின் உபநிடதம்’ எனப் போற்றப்படும் சிறப்புமிக்க நூல் எது?"}],"options":[{"key":"A","text":"திருமந்திரம்"},{"key":"B","text":"தேவாரம்"},{"key":"C","text":"தாயுமானவர் பாடல்கள்"},{"key":"D","text":"திருவருட்பா"}],"explanation":"தாயுமானவர் பாடல்கள் என்னும் தொகுப்பினை அறிஞர்கள் 'தமிழ் மொழியின் உபநிடதம்' எனப் போற்றுவர்."}}}
{"id":"b-tam-6t3-075","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ் இலக்கியத்தில் ‘கண்ணி’ என்பது எவ்வகையான செய்யுள் அமைப்பைக் குறிக்கும்?"}],"options":[{"key":"A","text":"நான்கு அடிகளில் பாடப்படும் பாடல்"},{"key":"B","text":"இரண்டு அடிகளில் பாடப்படும் பாடல்வகை"},{"key":"C","text":"எட்டு அடிகளில் அமையும் வெண்பா"},{"key":"D","text":"ஒரே அடியில் வரும் தனிப்பாடல்"}],"explanation":"'கண்ணி' என்பது இரண்டு அடிகளில் எதுகை அமையப் பாடப்படும் பாடல் வகை ஆகும்."}}}
{"id":"b-tam-6t3-076","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 24"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அன்பர்பணி செய்யஎனை ஆளாக்கி விட்டுவிட்டால் இன்பநிலை தானேவந்து எய்தும் பராபரமே!’ - இப்பாடலில் இன்பநிலை எப்போது வந்து சேரும் எனத் தாயுமானவர் கூறுகிறார்?"}],"options":[{"key":"A","text":"செல்வங்களை ஈட்டும்போது"},{"key":"B","text":"அன்பர்களுக்குத் தொண்டு செய்பவராக மாறிவிட்டால்"},{"key":"C","text":"அனைத்துப் புலன்களையும் அடக்கியபின்"},{"key":"D","text":"வானுலகை அடையும்போது"}],"explanation":"அன்பர்களுக்குத் தொண்டு செய்யும் பணியில் தன்னை ஈடுபடுத்திக் கொண்டால் பேரின்ப நிலை தானே வந்து எய்தும் என்கிறார்."}}}
{"id":"b-tam-6t3-077","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தம் + உயிர்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"தம்முயிர்"},{"key":"B","text":"தமதுயிர்"},{"key":"C","text":"தம்உயிர்"},{"key":"D","text":"தம்முஉயிர்"}],"explanation":"தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும் விதிப்படி ம் இரட்டித்து (தம் + ம் + உயிர்), உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி 'தம்முயிர்' எனப் புணரும்."}}}
{"id":"b-tam-6t3-078","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இன்புற்று + இருக்க’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"இன்புற்றிருக்க"},{"key":"B","text":"இன்புறுறிருக்க"},{"key":"C","text":"இன்புற்றுஇருக்க"},{"key":"D","text":"இன்புறு இருக்க"}],"explanation":"உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'ற்' நின்று, ற் + இ = றி ஆகி 'இன்புற்றிருக்க' எனப் புணரும்."}}}
{"id":"b-tam-6t3-079","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தானென்று’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"தானெ + என்று"},{"key":"B","text":"தான் + என்று"},{"key":"C","text":"தா + னென்று"},{"key":"D","text":"தான் + னென்று"}],"explanation":"தான் + என்று = உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி ன் + ஏ = னெ ஆகி 'தானென்று' எனப் புணரும்."}}}
{"id":"b-tam-6t3-080","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சோம்பல்’ என்னும் சொல்லுக்குரிய பொருத்தமான எதிர்ச்சொல் எது?"}],"options":[{"key":"A","text":"அழிவு"},{"key":"B","text":"துன்பம்"},{"key":"C","text":"சுறுசுறுப்பு"},{"key":"D","text":"சோகம்"}],"explanation":"சோம்பல் என்பதன் நேர் எதிர்ச்சொல் சுறுசுறுப்பு ஆகும்."}}}
