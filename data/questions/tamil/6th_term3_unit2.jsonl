// பாடம் 6: திருக்குறள் (வாழ்வியல்) [Q117 - Q132]
// மனத்துக்கண் மாசிலன் (ஆகுல நீர), அழுக்காறு அவா வெகுளி, வறியார்க்கு ஒன்று ஈவதே, வன்கணவர்,
// இன்னாசெய் தாரை ஒறுத்தல், அறிவினான் ஆகுவது, பகுத்துண்டு பல்லுயிர், ஆற்றுவார் ஆற்றல்,
// எரியால் சுடப்படினும், ஈகை/துன்பம்/குற்றம் நிரப்புதல், சீரமைப்பு, நிறைமதி சூழல் வினா, இடைச்சொல் கூற்று-காரணம், மாணா
// ==============================================================================
{"id":"b-tam-6t3-117","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 38"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மனத்துக்கண் மாசிலன் ஆதல் அனைத்தறன் ஆகுல நீர பிற’ - இதில் ‘ஆகுல நீர’ என்பதன் பொருள் யாது?"}],"options":[{"key":"A","text":"அமைதியான செயல்"},{"key":"B","text":"வெறும் ஆரவாரத் தன்மை உடையவை"},{"key":"C","text":"நிலையான அறம்"},{"key":"D","text":"துன்பம் தருவன"}],"explanation":"உள்ளத்தில் குற்றம் இல்லாமல் இருப்பதே சிறந்த அறம்; மற்ற வெளிப்பகட்டுகள் வெறும் ஆரவாரமே (ஆகுல நீர) ஆகும்."}}}
{"id":"b-tam-6t3-118","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 38"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அழுக்காறு அவாவெகுளி இன்னாச்சொல் நான்கும் இழுக்கா இயன்றது அறம்’ - இதில் ‘அழுக்காறு’ மற்றும் ‘அவா’ என்பதன் பொருள் முறையே யாது?"}],"options":[{"key":"A","text":"கோபம், சினம்"},{"key":"B","text":"பேராசை, பொறாமை"},{"key":"C","text":"பொறாமை, பேராசை"},{"key":"D","text":"கடுஞ்சொல், பொய்"}],"explanation":"அழுக்காறு = பொறாமை; அவா = பேராசை; வெகுளி = சினம்; இன்னாச்சொல் = கடுஞ்சொல்."}}}
{"id":"b-tam-6t3-119","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 38"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வறியார்க்கு ஒன்று ஈவதே ஈகை மற்று எல்லாம் குறியெதிர்ப்பை நீரது உடைத்து’ - இக்குறளின்படி உண்மையான ஈகை என்பது எது?"}],"options":[{"key":"A","text":"உறவினர்களுக்குக் கொடுப்பது"},{"key":"B","text":"இல்லாத ஏழைகளுக்குக் கொடுப்பது"},{"key":"C","text":"பயனை எதிர்பார்த்துக் கொடுப்பது"},{"key":"D","text":"நண்பர்களுக்கு விருந்தளிப்பது"}],"explanation":"இல்லாத ஏழைகளுக்குத் தருவதே ஈகை ஆகும்; மற்றவை எல்லாம் கைம்மாறு கருதிச் செய்பவை."}}}
{"id":"b-tam-6t3-120","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 38"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஈத்துவக்கும் இன்பம் அறியார்கொல் தாமுடைமை வைத்திழக்கும் வன்க ணவர்’ - இதில் ‘வன்கணவர்’ என்பவர் யார்?"}],"options":[{"key":"A","text":"வீரமுடைய போர்வீரர்"},{"key":"B","text":"பிறருக்குக் கொடுத்து மகிழாமல் பொருளைச் சேர்த்து வைத்துப் பின் இழக்கும் கொடிய நெஞ்சினர்"},{"key":"C","text":"செல்வந்தர்"},{"key":"D","text":"விருந்தோம்புவோர்"}],"explanation":"ஏழைகளுக்கு ஈந்து மகிழும் இன்பத்தை அறியாமல் பொருளைச் சேர்த்து வைத்துப் பின் இழக்கும் இரக்கமற்றவரே வன்கணவர்."}}}
{"id":"pyq-tam-6t3-121","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":5},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இன்னாசெய் தாரை ஒறுத்தல் அவர்நாண நன்னயம் செய்து விடல்’ - நமக்குத் துன்பம் செய்தவரைத் தண்டிக்கும் சிறந்த வழியாக வள்ளுவர் கூறுவது யாது?"}],"options":[{"key":"A","text":"அவரைச் சிறையில் அடைப்பது"},{"key":"B","text":"அவர் வெட்கித் தலைகுனியும்படி அவருக்கு நன்மையைச் செய்வது"},{"key":"C","text":"அவரைப் புறக்கணிப்பது"},{"key":"D","text":"திரும்பத் துன்பம் செய்வது"}],"explanation":"நமக்குத் துன்பம் செய்தவர் நாணும்படி அவருக்கு நன்மை செய்துவிடுவதுதான் அவரைத் தண்டிக்கும் தலையாய வழியாகும்."}}}
{"id":"b-tam-6t3-122","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 39"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அறிவினான் ஆகுவது உண்டோ பிறிதின்நோய் தந்நோய்போல் போற்றாக் கடை’ - ஒருவர் பெற்றுள்ள அறிவினால் உண்டாகும் பயன் யாது?"}],"options":[{"key":"A","text":"செல்வத்தை ஈட்டுவது"},{"key":"B","text":"புகழ் பெறுவது"},{"key":"C","text":"பிற உயிரின் துன்பத்தைத் தன் துன்பம் போல் கருதிப் போக்குவது"},{"key":"D","text":"அரசவையில் முதன்மை பெறுவது"}],"explanation":"பிற உயிரின் துன்பத்தைத் தனது துன்பம் போல் கருதாவிட்டால் தாம் பெற்றுள்ள அறிவால் எந்தப் பயனும் இல்லை."}}}
{"id":"b-tam-6t3-123","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 39"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பகுத்துண்டு பல்லுயிர் ஓம்புதல் நூலோர் தொகுத்தவற்றுள் எல்லாம் தலை’ - அறநூல்கள் கூறும் அறங்களுள் தலையாய அறமாக வள்ளுவர் எதனைக் கூறுகிறார்?"}],"options":[{"key":"A","text":"தவம் செய்வது"},{"key":"B","text":"பொன் தானம் செய்வது"},{"key":"C","text":"தம்மிடம் உள்ளவற்றைப் பிற உயிர்களுக்குப் பகிர்ந்து கொடுத்துக் காப்பாற்றுவது"},{"key":"D","text":"இனிய சொற்களைப் பேசுவது"}],"explanation":"தம்மிடம் உள்ள உணவைப் பிற உயிர்களுக்குப் பகிர்ந்து கொடுத்துக் காப்பாற்றுவதே அறங்களுள் எல்லாம் முதன்மையானதாகும்."}}}
{"id":"b-tam-6t3-124","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 39"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஆற்றுவார் ஆற்றல் இகழாமை போற்றுவார் போற்றலுள் எல்லாம் தலை’ - தம்மைத் தீங்கிலிருந்து காத்துக்கொள்ளும் வழிகளுள் சிறந்த வழியாக வள்ளுவர் எதனைக் கூறுகிறார்?"}],"options":[{"key":"A","text":"பகைவரை அழிப்பது"},{"key":"B","text":"ஆற்றல் உடைய பெரியவர்களை இகழாமல் போற்றுவது"},{"key":"C","text":"கோட்டை அமைப்பது"},{"key":"D","text":"செல்வத்தைச் சேமிப்பது"}],"explanation":"ஆற்றல் உடைய சான்றோர்களை மதிக்காமல் இகழாதிருத்தலே தன்னைத் தீங்கிலிருந்து காக்கும் வழிகளுள் முதன்மையானதாகும்."}}}
{"id":"b-tam-6t3-125","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 39"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எரியால் சுடப்படினும் உய்வுண்டாம் உய்யார் பெரியார்ப் பிழைத்தொழுகு வார்’ - இதில் எதனால் சுடப்பட்டவர்கூடப் பிழைத்துக் கொள்ள முடியும் என்று வள்ளுவர் கூறுகிறார்?"}],"options":[{"key":"A","text":"சூரியனின் வெப்பத்தால்"},{"key":"B","text":"தீயினால் (நெருப்பினால்)"},{"key":"C","text":"பகைவரின் அம்பினால்"},{"key":"D","text":"மின்னலினால்"}],"explanation":"தீயினால் சுடப்பட்டவர்கூடப் பிழைத்துக்கொள்ள முடியும்; ஆனால் பெரியவர்களுக்குத் தீங்கு செய்தவர் தப்ப முடியாது."}}}
{"id":"b-tam-6t3-126","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 40"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஏழைகளுக்கு உதவி செய்வதே ________ ஆகும்’ - மதிப்பீட்டு விடையைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"பகை"},{"key":"B","text":"ஈகை"},{"key":"C","text":"வறுமை"},{"key":"D","text":"கொடுமை"}],"explanation":"இல்லாத ஏழைகளுக்கு உதவி செய்வதே ஈகை ஆகும்."}}}
{"id":"b-tam-6t3-127","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 40"},"texts":{"ta":{"blocks":[{"type":"text","text":"பிற உயிர்களின் ________ கண்டு வருந்துவதே அறிவின் பயனாகும்."}],"options":[{"key":"A","text":"மகிழ்வைக்"},{"key":"B","text":"செல்வத்தைக்"},{"key":"C","text":"துன்பத்தைக்"},{"key":"D","text":"பகையைக்"}],"explanation":"பிற உயிர்களின் துன்பத்தைக் கண்டு தன் துன்பம் போல் வருந்துவதே அறிவின் பயனாகும்."}}}
{"id":"b-tam-6t3-128","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 40"},"texts":{"ta":{"blocks":[{"type":"text","text":"உள்ளத்தில் ________ இல்லாமல் இருப்பதே சிறந்த அறமாகும்."}],"options":[{"key":"A","text":"மகிழ்ச்சி"},{"key":"B","text":"மன்னிப்பு"},{"key":"C","text":"துணிவு"},{"key":"D","text":"குற்றம் (மாசு)"}],"explanation":"மனத்துக்கண் மாசிலன் ஆதல் அனைத்தறன் - உள்ளத்தில் குற்றம் இல்லாமல் இருப்பதே சிறந்த அறம்."}}}
{"id":"b-tam-6t3-129","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 40"},"texts":{"ta":{"blocks":[{"type":"text","text":"இடம் மாறியுள்ள சீர்களைச் சரியான வரிசையில் அமைத்து எழுதுக: ‘வறியார்க்கு ஒன்று ஈகைமற்று ஈவதே எல்லாம் குறியெதிர்ப்பை உடைத்து நீரது’"}],"options":[{"key":"A","text":"வறியார்க்குஒன்று ஈவதே ஈகைமற்று எல்லாம் குறியெதிர்ப்பை நீரது உடைத்து"},{"key":"B","text":"வறியார்க்கு ஈவதே ஒன்று ஈகைமற்று நீரது உடைத்து குறியெதிர்ப்பை எல்லாம்"},{"key":"C","text":"ஈகைமற்று வறியார்க்கு ஒன்று ஈவதே எல்லாம் உடைத்து குறியெதிர்ப்பை நீரது"},{"key":"D","text":"குறியெதிர்ப்பை நீரது உடைத்து வறியார்க்கு ஒன்று ஈவதே ஈகைமற்று எல்லாம்"}],"explanation":"குறளின் சரியான சீரமைப்பு: \"வறியார்க்குஒன்று ஈவதே ஈகைமற்று எல்லாம் குறியெதிர்ப்பை நீரது உடைத்து\"."}}}
{"id":"b-tam-6t3-130","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 40"},"texts":{"ta":{"blocks":[{"type":"text","text":"நிறைமதி தான் கொண்டு வந்த உணவைத் தோழிகளோடு பகிர்வதோடு, அருகே பறந்து வந்த பறவைகளுக்கும் உணவளித்துப் பகிர்ந்த நிகழ்விற்குப் பொருத்தமான திருக்குறள் எது?"}],"options":[{"key":"A","text":"மனத்துக்கண் மாசிலன் ஆதல் அனைத்தறன் ஆகுல நீர பிற"},{"key":"B","text":"எனைத்தானும் எஞ்ஞான்றும் யார்க்கும் மனத்தானாம் மாணாசெய் யாமை தலை"},{"key":"C","text":"பகுத்துண்டு பல்லுயிர் ஓம்புதல் நூலோர் தொகுத்தவற்றுள் எல்லாம் தலை"},{"key":"D","text":"இன்னாசெய் தாரை ஒறுத்தல் அவர்நாண நன்னயம் செய்து விடல்"}],"explanation":"பறவைகளுக்கும் உணவை வழங்கிப் பகிர்ந்ததால் 'பகுத்துண்டு பல்லுயிர் ஓம்புதல் நூலோர் தொகுத்தவற்றுள் எல்லாம் தலை' என்ற குறள் மிகப்பொருந்தும்."}}}
{"id":"b-tam-6t3-131","kind":"assertion_reason","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 34"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"இடைச்சொல் தனித்து இயங்கும் ஆற்றல் அற்றது."},{"type":"reason","text":"இடைச்சொற்கள் எப்போதும் பெயர்ச்சொல்லையோ வினைச்சொல்லையோ சார்ந்து மட்டுமே சொல்லில் வரும்."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"இடைச்சொல் பெயர்ச்சொல்லையும் வினைச்சொல்லையும் சார்ந்து வருவதால் தனித்து இயங்காது; எனவே கூற்றும் காரணமும் சரி."}}}
{"id":"b-tam-6t3-132","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 39"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எனைத்தானும் எஞ்ஞான்றும் யார்க்கும் மனத்தானாம் மாணாசெய் யாமை தலை’ - இதில் ‘மாணா’ என்பதன் பொருள் யாது?"}],"options":[{"key":"A","text":"நல்ல செயல்"},{"key":"B","text":"செய்யத் தகாத செயல் (துன்பம்/தீமை)"},{"key":"C","text":"புகழ் தரும் செயல்"},{"key":"D","text":"பெரிய செயல்"}],"explanation":"மாணா செயல் என்பது மனத்தால் விரும்பத்தகாத தீய செயலாகும்; உள்ளம் ஏற்றுக்கொள்ளாத எச்செயலையும் சிறிதும் செய்யக்கூடாது."}}}
