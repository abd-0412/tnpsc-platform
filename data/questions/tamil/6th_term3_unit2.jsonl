{"id":"b-tam-6t3-093","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 30"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பாதம்’ சிறுகதையில் தியேட்டர் வாசலில் காலணி தைக்கும் முதிய தொழிலாளியின் பெயர் யாது?"}],"options":[{"key":"A","text":"முனியன்"},{"key":"B","text":"மாரி"},{"key":"C","text":"அருளப்பர்"},{"key":"D","text":"கந்தன்"}],"explanation":"எஸ். ராமகிருஷ்ணனின் பாதம் கதையின் முதன்மைக் கதாபாத்திரம் மாரி என்னும் காலணி தைக்கும் தொழிலாளி ஆவார்."}}}
{"id":"b-tam-6t3-094","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 30"},"texts":{"ta":{"blocks":[{"type":"text","text":"மழைநாளில் சிறுமி ஒருத்தி மாரியிடம் தைக்கக் கொடுத்துச் சென்ற காலணி எந்த நிறத்தில் இருந்தது?"}],"options":[{"key":"A","text":"பச்சை நிறம்"},{"key":"B","text":"வெள்ளை நிறம்"},{"key":"C","text":"இளம் சிவப்பு நிறம் (வெல்வெட் தைத்தது)"},{"key":"D","text":"நீல நிறம்"}],"explanation":"அந்தச் சிறுமி கொடுத்துச் சென்ற காலணி இளம் சிவப்பு நிறத்தில், வெல்வெட் தைத்துப் பூவேலை கொண்டதாக இருந்தது."}}}
{"id":"b-tam-6t3-095","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 31"},"texts":{"ta":{"blocks":[{"type":"text","text":"மாரி தைத்து வைத்த ஒற்றைக் காலணியில் இருந்த மிகப்பெரிய விந்தை என்ன?"}],"options":[{"key":"A","text":"அது தானாகவே பறக்கும் தன்மை கொண்டது"},{"key":"B","text":"குழந்தை முதல் முதியவர் வரை உலகின் எல்லா மனிதர்களின் பாதங்களுக்கும் சரியாகப் பொருந்தியது"},{"key":"C","text":"பொன்னாக மாறும் சக்தி கொண்டது"},{"key":"D","text":"தேய்ந்து போகவே போகாது"}],"explanation":"அந்தக் காலணி ஒரு வயதுக் குழந்தை முதல் முதியவர் வரை யார் அணிந்தாலும் அவர்தம் பாத அளவிற்கு ஏற்பப் பொருந்தும் விந்தை கொண்டது."}}}
{"id":"b-tam-6t3-096","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 32"},"texts":{"ta":{"blocks":[{"type":"text","text":"விந்தைக் காலணியைத் தைக்கக் கொடுத்த சிறுமி எத்தனை ஆண்டுகளுக்குப் பிறகு மீண்டும் மாரியைத் தேடி வந்தாள்?"}],"options":[{"key":"A","text":"பத்து ஆண்டுகள்"},{"key":"B","text":"இருபது ஆண்டுகள்"},{"key":"C","text":"முப்பது ஆண்டுகள்"},{"key":"D","text":"நாற்பது ஆண்டுகள்"}],"explanation":"இப்படியாக மாரியின் முப்பது வருடம் கடந்தது; முப்பது ஆண்டுகள் கழித்து ஒரு மழை இரவில் நடுத்தர வயதுப் பெண்ணாக வந்தாள்."}}}
{"id":"b-tam-6t3-097","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":true,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 33"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பாதம்’ கதையை எழுதிய தற்கால எழுத்தாளர் எஸ். ராமகிருஷ்ணன் இயற்றிய பிற நூல்களுள் பொருந்தாதது எது?"}],"options":[{"key":"A","text":"உபபாண்டவம், கதாவிலாசம்"},{"key":"B","text":"ஆகாயத்துக்கு அடுத்த வீடு"},{"key":"C","text":"தேசாந்திரி, கால் முளைத்த கதைகள்"},{"key":"D","text":"தாவரங்களின் உரையாடல்"}],"explanation":"'ஆகாயத்துக்கு அடுத்த வீடு' என்பது மு. மேத்தாவின் சாகித்திய அகாதெமி பரிசு பெற்ற நூல்; மற்றவை எஸ். ராமகிருஷ்ணனின் படைப்புகள்."}}}
{"id":"b-tam-6t3-098","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 33"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பாதம்’ என்னும் விந்தைக் கதை எஸ். ராமகிருஷ்ணனின் எந்தச் சிறுகதைத் தொகுப்பில் இடம்பெற்றுள்ளது?"}],"options":[{"key":"A","text":"கதாவிலாசம்"},{"key":"B","text":"தாவரங்களின் உரையாடல்"},{"key":"C","text":"தேசாந்திரி"},{"key":"D","text":"கால் முளைத்த கதைகள்"}],"explanation":"இக்கதை எஸ். ராமகிருஷ்ணனின் 'தாவரங்களின் உரையாடல்' என்னும் சிறுகதைத் தொகுப்பில் இடம்பெற்றுள்ளது."}}}
{"id":"b-tam-6t3-099","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 33"},"texts":{"ta":{"blocks":[{"type":"text","text":"முப்பது ஆண்டுகள் கழித்து வந்த பெண், தைத்து வாங்கிய காலணியைத் தெருவிளக்கின் கீழ் அணிய முயன்றபோது நிகழ்ந்தது என்ன?"}],"options":[{"key":"A","text":"இரண்டு காலணிகளும் தங்கமாக மாறின"},{"key":"B","text":"அவளது பாதங்கள் மாயமாக மறைந்தன"},{"key":"C","text":"இடது காலணி பொருந்தியது; மாரி தைத்துக் கொடுத்த வலது காலணி அவளுக்குப் பொருந்தாமல் சிறியதாக இருந்தது"},{"key":"D","text":"இரண்டு காலணிகளும் சரியாகப் பொருந்தின"}],"explanation":"அவள் கொண்டு வந்த இடது காலணி பொருந்தியது; ஆனால் மாரி தைத்துக் கொடுத்த வலது காலணி அவளுக்குப் பொருந்தாமல் சிறியதாக இருந்தது."}}}
{"id":"b-tam-6t3-100","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 32"},"texts":{"ta":{"blocks":[{"type":"text","text":"விந்தைக் காலணியைத் திருட முயன்ற இருவரால் தாக்கப்பட்டு நடக்க இயலாமல் படுக்கையில் வீழ்ந்த மாரியின் உள்ள ஏக்கம் என்னவாக இருந்தது?"}],"options":[{"key":"A","text":"பணத்தை இன்னும் சேர்க்க வேண்டும் என்ற ஏக்கம்"},{"key":"B","text":"தான் இறப்பதற்கு முன் ஒருமுறையாவது அக்காலணியைச் சிறுமியிடம் ஒப்படைத்துவிட வேண்டும் என்ற ஏக்கம்"},{"key":"C","text":"அக்காலணியைப் புதைத்துவிட வேண்டும் என்ற ஏக்கம்"},{"key":"D","text":"அரசாங்கத்திடம் ஒப்படைக்க வேண்டும் என்ற ஏக்கம்"}],"explanation":"தான் அவள் காலணியால் வாழ்வு பெற்ற கடனைச் சுமந்து மரிக்காமல், இறக்கும் முன் அவளிடம் திரும்ப ஒப்படைக்க வேண்டும் என ஏங்கினார்."}}}
