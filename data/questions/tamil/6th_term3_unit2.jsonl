// பாடம் 4: நால்வகைச் சொற்கள் (கற்கண்டு - இலக்கணம்) [Q101 - Q108]
// பெயர்/வினை/இடை/உரி (நான்கு வகை), இடைச்சொல் தனித்து இயங்காது, உரிச்சொல் (மிகுதிப்படுத்த),
// பொருந்தாச் சொல் வகைப்பாடு, வளவனும் தங்கையும் மாநகரப் பேருந்தில்
// ==============================================================================
{"id":"b-tam-6t3-101","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 34"},"texts":{"ta":{"blocks":[{"type":"text","text":"இலக்கண அடிப்படையில் தமிழ் மொழியில் சொற்கள் எத்தனை வகைப்படும்?"}],"options":[{"key":"A","text":"இரண்டு வகைப்படும்"},{"key":"B","text":"நான்கு வகைப்படும் (பெயர், வினை, இடை, உரி)"},{"key":"C","text":"ஆறு வகைப்படும்"},{"key":"D","text":"ஐந்து வகைப்படும்"}],"explanation":"இலக்கண அடிப்படையில் சொற்கள் பெயர்ச்சொல், வினைச்சொல், இடைச்சொல், உரிச்சொல் என நான்கு வகைப்படும்."}}}
{"id":"b-tam-6t3-102","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 34"},"texts":{"ta":{"blocks":[{"type":"text","text":"பெயர்ச்சொல்லையும் வினைச்சொல்லையும் சார்ந்து வரும் சொல் எது? (இது தனித்து இயங்காது)"}],"options":[{"key":"A","text":"உரிச்சொல்"},{"key":"B","text":"தொழிற்பெயர்"},{"key":"C","text":"இடைச்சொல்"},{"key":"D","text":"வினையெச்சம்"}],"explanation":"பெயரையும் வினையையும் சார்ந்து வரும் சொல் இடைச்சொல் ஆகும்; இது தனித்து இயங்கும் ஆற்றல் அற்றது (எ.கா: உம், மற்று, ஐ)."}}}
{"id":"b-tam-6t3-103","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 34"},"texts":{"ta":{"blocks":[{"type":"text","text":"பெயர்ச்சொல், வினைச்சொல் ஆகியவற்றின் தன்மையை ‘மிகுதிப்படுத்த’ வருவது எவ்வகைச் சொல்?"}],"options":[{"key":"A","text":"இடைச்சொல்"},{"key":"B","text":"உரிச்சொல் (எ.கா: மாநகரம், சாலச்சிறந்தது)"},{"key":"C","text":"பண்புப்பெயர்"},{"key":"D","text":"முற்றுச்சொல்"}],"explanation":"பெயர் மற்றும் வினையின் தன்மையை மிகுதிப்படுத்த வருவது உரிச்சொல் ஆகும் (மா, சால, உறு, தவ போன்றவை)."}}}
{"id":"b-tam-6t3-104","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":true,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘படித்தாள், ஐ, மற்று, கு’ - இவற்றுள் சொல் வகையறிந்து பொருந்தாச் சொல்லைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"படித்தாள் (வினைச்சொல்; மற்றவை இடைச்சொற்கள்)"},{"key":"B","text":"ஐ"},{"key":"C","text":"மற்று"},{"key":"D","text":"கு"}],"explanation":"ஐ, மற்று, கு ஆகியவை இடைச்சொற்கள்; படித்தாள் என்பது வினைச்சொல் என்பதால் பொருந்தாது."}}}
{"id":"b-tam-6t3-105","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":true,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மதுரை, கால், சித்திரை, ஓடினான்’ - பொருந்தாச் சொல் எது?"}],"options":[{"key":"A","text":"மதுரை"},{"key":"B","text":"கால்"},{"key":"C","text":"சித்திரை"},{"key":"D","text":"ஓடினான் (வினைச்சொல்; மற்றவை பெயர்ச்சொற்கள்)"}],"explanation":"மதுரை (இடம்), கால் (சினை), சித்திரை (காலம்) ஆகிய மூன்றும் பெயர்ச்சொற்கள்; ஓடினான் என்பது வினைச்சொல்."}}}
{"id":"b-tam-6t3-106","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":true,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சென்றாள், வந்த, சித்திரை, நடந்து’ - இவற்றுள் பொருந்தாத சொல் எது?"}],"options":[{"key":"A","text":"சென்றாள்"},{"key":"B","text":"வந்த"},{"key":"C","text":"சித்திரை (பெயர்ச்சொல்; மற்றவை வினைகள்)"},{"key":"D","text":"நடந்து"}],"explanation":"சென்றாள், வந்த, நடந்து ஆகிய மூன்றும் வினைச் சொற்கள்; சித்திரை என்பது காலப்பெயர்ச்சொல்."}}}
{"id":"b-tam-6t3-107","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":true,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மா, ஐ, உம், மற்று’ - பொருந்தாச் சொல் எது?"}],"options":[{"key":"A","text":"மா (உரிச்சொல்; மற்றவை இடைச்சொற்கள்)"},{"key":"B","text":"ஐ"},{"key":"C","text":"உம்"},{"key":"D","text":"மற்று"}],"explanation":"ஐ, உம், மற்று ஆகியவை இடைச்சொற்கள்; 'மா' என்பது உரிச்சொல் ஆகும்."}}}
{"id":"b-tam-6t3-108","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வளவனும் தங்கையும் மாநகரப் பேருந்தில் ஏறினர்’ - இத்தொடரில் இடம்பெற்றுள்ள இடைச்சொல் மற்றும் உரிச்சொல் முறையே எவை?"}],"options":[{"key":"A","text":"பேருந்து, ஏறினர்"},{"key":"B","text":"உம் (வளவனும்), மா (மாநகரம்)"},{"key":"C","text":"வளவன், தங்கை"},{"key":"D","text":"ஏறினர், பேருந்து"}],"explanation":"வளவனும் தங்கையும் என்பதில் உள்ள 'உம்' இடைச்சொல்; மாநகரம் என்பதில் உள்ள 'மா' உரிச்சொல்."}}}
// ==============================================================================
// பாடம் 5: மொழியை ஆள்வோம், கலைச்சொற்கள் & ஒலி வேறுபாடு [Q109 - Q116]
// அன்பினில் இன்பம் காண்போம் (அ. முத்தரையனார்), அரம்/அறம், மனம்/மணம், திங்கள்/நகை இருபொருள்,
// கலைச்சொற்கள் (Charity, Tribes, Desert, President), அகரவரிசை, சொல் இலக்கணம்
// ==============================================================================
{"id":"b-tam-6t3-109","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அன்பினில் இன்பம் காண்போம்; அறத்தினில் நேர்மை காண்போம்... தன்பிறப் புரிமை யாகத் தமிழ்மொழி போற்றக் காண்போம்’ - என்ற பாடலைப் பாடியவர் யார்?"}],"options":[{"key":"A","text":"பாரதிதாசன்"},{"key":"B","text":"அ. முத்தரையனார் (மலேசியக் கவிஞர்)"},{"key":"C","text":"வாணிதாசன்"},{"key":"D","text":"கண்ணதாசன்"}],"explanation":"பக்கம் 35-ல் உள்ள 'அன்பினில் இன்பம் காண்போம்' என்ற பாடலைப் பாடியவர் மலேசியக் கவிஞர் அ. முத்தரையனார் ஆவார்."}}}
{"id":"b-tam-6t3-110","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 36"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அரம்’ மற்றும் ‘அறம்’ ஆகிய ஒலி வேறுபாடுடைய சொற்களின் சரியான பொருள்கள் முறையே எவை?"}],"options":[{"key":"A","text":"தர்மம், கருவி"},{"key":"B","text":"இரும்பை அறுக்கும் கருவி, நற்செயல் (தர்மம்)"},{"key":"C","text":"பாம்பு, ஒளி"},{"key":"D","text":"கோபம், சாந்தம்"}],"explanation":"அரம் = இரும்பை அறுக்கும் அல்லது தேய்க்கும் கருவி; அறம் = தர்மம் அல்லது நற்செயல்."}}}
{"id":"b-tam-6t3-111","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 36"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மனம்’ மற்றும் ‘மணம்’ ஆகிய சொற்களின் பொருள்கள் முறையே எவை?"}],"options":[{"key":"A","text":"நறுமணம், உள்ளம்"},{"key":"B","text":"உள்ளம், நறுமணம் (வாசனை)"},{"key":"C","text":"மகிழ்ச்சி, பூ"},{"key":"D","text":"சாந்தம், கோபம்"}],"explanation":"மனம் = உள்ளம்; மணம் = நறுமணம் அல்லது வாசனை."}}}
{"id":"b-tam-6t3-112","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 37"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘திங்கள்’ என்னும் சொல்லுக்குரிய இரண்டு பொருள்கள் எவை?"}],"options":[{"key":"A","text":"சூரியன், நாள்"},{"key":"B","text":"நிலவு, மாதம்"},{"key":"C","text":"கிழமை, விண்மீன்"},{"key":"D","text":"வானம், மேகம்"}],"explanation":"திங்கள் என்பது வானத்து நிலவையும், கால அளவான மாதத்தையும் குறிக்கும் இருபொருள் சொல்."}}}
{"id":"b-tam-6t3-113","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 37"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நகை’ என்னும் சொல்லுக்குரிய இருவேறு பொருள்கள் எவை?"}],"options":[{"key":"A","text":"அழுகை, துன்பம்"},{"key":"B","text":"சிரிப்பு, அணிகலன்"},{"key":"C","text":"செல்வம், மாளிகை"},{"key":"D","text":"பரிசு, நாணயம்"}],"explanation":"நகை என்பது முகத்தின் புன்னகையையும் (சிரிப்பு), உடலில் அணியும் பொன்னணிகலனையும் குறிக்கும்."}}}
{"id":"b-tam-6t3-114","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"3","C":"4","D":"1"}},"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 37"},"texts":{"ta":{"blocks":[{"type":"text","text":"கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"},{"type":"list","name":"ஆங்கிலச் சொல்","items":[{"label":"A","text":"Charity"},{"label":"B","text":"Tribes"},{"label":"C","text":"Desert"},{"label":"D","text":"President"}]},{"type":"list","name":"தமிழாக்கம்","items":[{"label":"1","text":"குடியரசுத் தலைவர்"},{"label":"2","text":"தொண்டு"},{"label":"3","text":"பழங்குடியினர்"},{"label":"4","text":"பாலைவனம்"}]}],"options":[{"key":"A","text":"A-2, B-3, C-4, D-1","mapping":{"A":"2","B":"3","C":"4","D":"1"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"D","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}}],"explanation":"Charity = தொண்டு; Tribes = பழங்குடியினர்; Desert = பாலைவனம்; President = குடியரசுத் தலைவர்."}}}
{"id":"b-tam-6t3-115","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 36"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பூனை, தையல், தேனீ, ஓணான், மான், வௌவால், கிளி, மாணவன், மனிதன், ஆசிரியர், பழம்’ - சரியான முதல் மூன்று அகரவரிசைச் சொற்கள் எவை?"}],"options":[{"key":"A","text":"பூனை, தேனீ, கிளி"},{"key":"B","text":"ஆசிரியர், ஓணான், கிளி"},{"key":"C","text":"தையல், பழம், மான்"},{"key":"D","text":"வௌவால், மாணவன், பூனை"}],"explanation":"உயிர் எழுத்துகளில் ஆசிரியர், ஓணான் வந்தபின் க வரிசையில் கிளி என அகரவரிசை தொடங்கும்."}}}
{"id":"b-tam-6t3-116","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"6-ஆம் வகுப்பு தமிழ், பருவம் 3, இயல் 2, பக்கம் 34"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஈ, பூ, மை, கல், கடல், தங்கம்’ - ஓர் எழுத்தோ ஒன்றுக்கு மேற்பட்ட எழுத்துகளோ தொடர்ந்து நின்று பொருள் தருவது எவ்வாறு அழைக்கப்படும்?"}],"options":[{"key":"A","text":"எழுத்து"},{"key":"B","text":"அடி"},{"key":"C","text":"சொல்"},{"key":"D","text":"தொடர்"}],"explanation":"தனித்தோ பல எழுத்துகள் சேர்ந்தோ நின்று பொருள் தருவது 'சொல்' எனப்படும்."}}}
