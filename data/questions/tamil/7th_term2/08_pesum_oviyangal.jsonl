// 7-ஆம் வகுப்பு தமிழ் - பருவம் 2 - இயல் 2 - பாடம் 2 (8): பேசும் ஓவியங்கள் (உரைநடை உலகம்)
// வினாக்கள் எண்ணிக்கை: 20
// ==============================================================================
{"id":"b-tam-7t2-077","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 24"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஆயகலைகள் அறுபத்து நான்கனுள் நுண்கலைகளில் முதன்மையான ஒன்றாகக் கருதப்படுவது எது?"}],"options":[{"key":"A","text":"சிற்பக்கலை"},{"key":"B","text":"ஓவியக்கலை"},{"key":"C","text":"நாடகக்கலை"},{"key":"D","text":"இசைக்கலை"}],"explanation":"காண்போரின் கண்ணையும் கருத்தையும் கவரும் ஆற்றல் கொண்டதால் ஓவியத்தை நுண்கலைகளுள் தலையாய ஒன்றாகக் கருதுவர்."}}}
{"id":"b-tam-7t2-078","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 24"},"texts":{"ta":{"blocks":[{"type":"text","text":"பழங்கால மனிதர்கள் குகைகளில் வாழ்ந்தபோது வரைந்த ஓவியங்கள் பெரும்பாலும் எவ்வகையான ஓவியங்களாக இருந்தன?"}],"options":[{"key":"A","text":"வண்ண ஓவியங்கள்"},{"key":"B","text":"கோட்டோவியங்கள்"},{"key":"C","text":"நவீன ஓவியங்கள்"},{"key":"D","text":"தந்த ஓவியங்கள்"}],"explanation":"பழங்காலக் குகை ஓவியங்கள் பெரும்பாலும் கோட்டோவியங்களாகவே அமைந்திருந்தன; மண், கல்துகள்களால் வண்ணம் தீட்டினர்."}}}
{"id":"b-tam-7t2-079","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ்நாட்டில் சுவர் ஓவியங்களை ஏராளமாகக் காணக்கூடிய உலகப்புகழ்பெற்ற வரலாற்றுத் தலங்கள் எவை?"}],"options":[{"key":"A","text":"மாமல்லபுரம், பூம்புகார்"},{"key":"B","text":"மதுரை, கன்னியாகுமரி"},{"key":"C","text":"சித்தன்னவாசல் மற்றும் தஞ்சைப் பெரியகோவில்"},{"key":"D","text":"செஞ்சி, வேலூர்"}],"explanation":"சித்தன்னவாசலிலும் தஞ்சைப் பெரியகோவிலிலும் கருவறைச் சுற்றுச்சுவர் மற்றும் மண்டபங்களில் தலைசிறந்த சுவர் ஓவியங்கள் உள்ளன."}}}
{"id":"b-tam-7t2-080","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"பழங்காலத்தில் ஓவியம் வரையப் பயன்பட்ட துணியைக் குறிக்கும் வேறு பெயர்களுள் பொருந்தாத ஒன்று எது?"}],"options":[{"key":"A","text":"எழினி, திரைச்சீலை"},{"key":"B","text":"அரிச்சுவடி"},{"key":"C","text":"கிழி"},{"key":"D","text":"படாம்"}],"explanation":"துணியை எழினி, திரைச்சீலை, கிழி, படாம் எனப் பல பெயர்களில் அழைப்பர்; அரிச்சுவடி என்பது எழுத்துகளின் வரிசையைக் குறிக்கும்."}}}
{"id":"b-tam-7t2-081","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"குணமாலை என்னும் தலைவி யானையைக் கண்டு அஞ்சிய காட்சியைச் சீவகன் துணியில் வரைந்ததாகக் கூறும் தமிழ்க் காப்பியம் எது?"}],"options":[{"key":"A","text":"சிலப்பதிகாரம்"},{"key":"B","text":"மணிமேகலை"},{"key":"C","text":"சீவகசிந்தாமணி"},{"key":"D","text":"வளையாபதி"}],"explanation":"சீவகசிந்தாமணியில் சீவகன் குணமாலையின் அஞ்சிய காட்சியைத் துணியில் (கிழி) வரைந்த செய்தி இடம்பெற்றுள்ளது."}}}
{"id":"b-tam-7t2-082","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"தற்காலத்தில் துணிகளில் வரையப்படும் ஓவியங்கள் தமிழகத்திலும் ஆந்திராவிலும் எவ்வாறு அழைக்கப்படுகின்றன?"}],"options":[{"key":"A","text":"மதுபானி ஓவியங்கள்"},{"key":"B","text":"கலம்காரி ஓவியங்கள்"},{"key":"C","text":"வார்லி ஓவியங்கள்"},{"key":"D","text":"பட்டச்சித்ரா"}],"explanation":"துணி ஓவியங்கள் தற்காலத்தில் 'கலம்காரி ஓவியங்கள்' என்ற பெயரில் பரவலாக வரையப்பட்டு வருகின்றன."}}}
{"id":"b-tam-7t2-083","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"எழுத்தாணிகளைக் கொண்டு இதிகாச, புராணக் காட்சிகளாக வரையப்பட்ட ஓலைச்சுவடி ஓவியங்களைத் தற்காலத்தில் எங்குச் சென்றால் காணலாம்?"}],"options":[{"key":"A","text":"உ.வே.சா நூலகம்"},{"key":"B","text":"தஞ்சாவூர் சரசுவதி மகால் நூலகம்"},{"key":"C","text":"கன்னிமாரா நூலகம்"},{"key":"D","text":"அண்ணா நூற்றாண்டு நூலகம்"}],"explanation":"தஞ்சாவூர் சரசுவதி மகால் நூலகத்தில் ஓலைச்சுவடி ஓவியங்களைப் பாதுகாப்பாகக் காணலாம்."}}}
{"id":"b-tam-7t2-084","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 25"},"texts":{"ta":{"blocks":[{"type":"text","text":"உளிகொண்டு வரைகோடுகளாக நீர்நிலைகள், செடிகொடிகள், விலங்குகள் போன்றவற்றைப் பொறித்து வரைந்த ஓவியங்கள் எவை?"}],"options":[{"key":"A","text":"சுவர் ஓவியங்கள்"},{"key":"B","text":"செப்பேட்டு ஓவியங்கள்"},{"key":"C","text":"கண்ணாடி ஓவியங்கள்"},{"key":"D","text":"தாள் ஓவியங்கள்"}],"explanation":"முற்காலத்தில் மன்னர்கள் அரசு ஆவணங்களைச் செப்பேடுகளில் பொறித்தபோது உளிகொண்டு செப்பேட்டு ஓவியங்களை வரைந்தனர்."}}}
{"id":"b-tam-7t2-085","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 26"},"texts":{"ta":{"blocks":[{"type":"text","text":"வயது முதிர்ந்து இறந்த யானையின் தந்தங்களின் மீது நீர்வண்ணங்களைப் பயன்படுத்தி வரையப்படும் ‘தந்த ஓவியங்கள்’ எந்த மாநிலத்தில் அதிகம் காணப்படுகின்றன?"}],"options":[{"key":"A","text":"தமிழ்நாடு"},{"key":"B","text":"கேரளா"},{"key":"C","text":"கர்நாடகா"},{"key":"D","text":"ஆந்திரா"}],"explanation":"தந்த ஓவியங்கள் கேரளா மாநிலத்தில் அதிக அளவில் காணப்படுகின்றன."}}}
{"id":"b-tam-7t2-086","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 26"},"texts":{"ta":{"blocks":[{"type":"text","text":"கண்ணாடிகளில் அழகிய வண்ண ஓவியங்களை வரையும் சிறந்த ஓவியர்கள் தமிழ்நாட்டில் எந்த ஊரில் மிகுதியாக உள்ளனர்?"}],"options":[{"key":"A","text":"மதுரை"},{"key":"B","text":"காஞ்சிபுரம்"},{"key":"C","text":"தஞ்சாவூர்"},{"key":"D","text":"கும்பகோணம்"}],"explanation":"கண்ணாடி ஓவியங்களை உருவாக்கும் ஓவியர்கள் தஞ்சாவூரில் மிகுதியாக உள்ளனர்."}}}
{"id":"pyq-tam-7t2-087","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":35},"texts":{"ta":{"blocks":[{"type":"text","text":"அரசியல் கருத்துகளை மக்களிடம் எளிமையாக விளக்குவதற்காகத் தமிழில் முதன்முதலில் ‘இந்தியா’ இதழில் கருத்துப்படங்களை (கேலிச்சித்திரம்) அறிமுகப்படுத்தியவர் யார்?"}],"options":[{"key":"A","text":"பாரதிதாசன்"},{"key":"B","text":"மகாகவி பாரதியார்"},{"key":"C","text":"வ.உ.சி."},{"key":"D","text":"பெரியார்"}],"explanation":"பாரதியார்தான் தமது 'இந்தியா' இதழில் முதன்முதலில் கேலிச்சித்திரங்கள் மற்றும் கருத்துப்படங்களை அறிமுகப்படுத்தினார்."}}}
{"id":"b-tam-7t2-088","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 27"},"texts":{"ta":{"blocks":[{"type":"text","text":"மனித உருவங்களை விந்தையான தோற்றங்களில் நகைச்சுவை தோன்றும்படி வரைவதை எவ்வாறு அழைப்பர்?"}],"options":[{"key":"A","text":"கோட்டோவியம்"},{"key":"B","text":"கேலிச்சித்திரம் (Caricature)"},{"key":"C","text":"சுவர் ஓவியம்"},{"key":"D","text":"நவீன ஓவியம்"}],"explanation":"கருத்துப்படங்களின் மற்றொரு வடிவமாக விளங்குவது கேலிச்சித்திரம் ஆகும்."}}}
{"id":"pyq-tam-7t2-089","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":19},"texts":{"ta":{"blocks":[{"type":"text","text":"ஐரோப்பியக் கலை நுணுக்கத்துடன் இந்தியக் கதை மரபுகளை இணைத்து ஓவியங்களில் புதுமைகளைப் புகுத்திய உலகப் புகழ்பெற்ற ஓவியர் யார்?"}],"options":[{"key":"A","text":"கொண்டையராஜு"},{"key":"B","text":"இராஜா இரவிவர்மா"},{"key":"C","text":"ஜெமினி ராய்"},{"key":"D","text":"நந்தலால் போஸ்"}],"explanation":"இராஜா இரவிவர்மா ஐரோப்பிய பாணியையும் இந்தியப் புராண மரபுகளையும் இணைத்துப் புதுமைகளைப் புகுத்தினார்."}}}
{"id":"b-tam-7t2-090","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 27"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பசார் பெயிண்டிங்’ (Bazaar Painting) என்று அழைக்கப்படும் நாட்காட்டி ஓவியம் வரையும் முறையின் முன்னோடிகளுள் ஒருவராகக் கருதப்படுபவர் யார்?"}],"options":[{"key":"A","text":"இராஜா இரவிவர்மா"},{"key":"B","text":"கொண்டையராஜு"},{"key":"C","text":"மாதவ ராவ்"},{"key":"D","text":"சீனுவாசன்"}],"explanation":"நாட்காட்டி ஓவியங்களின் முன்னோடிகளுள் ஒருவராக விளங்கியவர் கொண்டையராஜு ஆவார்."}}}
{"id":"b-tam-7t2-091","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"3"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 27"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஓவியக்கலை தொடர்பான பழந்தமிழ்ச் சொற்களைச் சரியாகப் பொருத்துக:"},{"type":"list","name":"பிரிவு","items":[{"label":"A","text":"ஓவியம்"},{"label":"B","text":"ஓவியம் வரைபவர்"},{"label":"C","text":"ஓவியக் கூடம்"}]},{"type":"list","name":"வேறு பெயர்கள்","items":[{"label":"1","text":"கண்ணுள் வினைஞர், ஓவமாக்கள், கிளவி வல்லோன்"},{"label":"2","text":"ஓவு, ஓவம், சித்திரம், வட்டிகைச்செய்தி"},{"label":"3","text":"எழுதெழில் அம்பலம், சித்திரமாடம், சித்திர சபை"}]}],"options":[{"key":"A","text":"A-2, B-1, C-3","mapping":{"A":"2","B":"1","C":"3"}},{"key":"B","text":"A-1, B-2, C-3","mapping":{"A":"1","B":"2","C":"3"}},{"key":"C","text":"A-3, B-1, C-2","mapping":{"A":"3","B":"1","C":"2"}},{"key":"D","text":"A-2, B-3, C-1","mapping":{"A":"2","B":"3","C":"1"}}],"explanation":"ஓவியம் = ஓவு, ஓவம், சித்திரம், வட்டிகைச்செய்தி; வரைபவர் = கண்ணுள் வினைஞர், கிளவி வல்லோன், வித்தகர்; கூடம் = எழுதெழில் அம்பலம், சித்திரக்கூடம், சித்திரமாடம்."}}}
{"id":"b-tam-7t2-092","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 26"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘புனையா ஓவியம் கடுப்பப் புனைவில்’ மற்றும் ‘புனையா ஓவியம் புறம் போந்தன்ன’ - என்று வண்ணங்கள் பயன்படுத்தாமல் வரைகோடுகளால் வரையும் புனையா ஓவியங்கள் பற்றிக் கூறும் சங்க இலக்கிய நூல்கள் எவை?"}],"options":[{"key":"A","text":"குறுந்தொகை, நற்றிணை"},{"key":"B","text":"நெடுநல்வாடை, மணிமேகலை"},{"key":"C","text":"அகநானூறு, புறநானூறு"},{"key":"D","text":"பரிபாடல், சிலப்பதிகாரம்"}],"explanation":"புனையா ஓவியம் கடுப்பப் புனைவில் = நெடுநல்வாடை; புனையா ஓவியம் புறம் போந்தன்ன = மணிமேகலை."}}}
{"id":"b-tam-7t2-093","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 28"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கோட்டோவியம்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"கோடு + ஓவியம்"},{"key":"B","text":"கோட்டு + ஓவியம்"},{"key":"C","text":"கோட் + டோவியம்"},{"key":"D","text":"கோடி + ஓவியம்"}],"explanation":"நெடிலோடும் உயிர்த்தொடர்க் குற்றுகரங்களுள் ட ற ஒற்று இரட்டும்: கோடு + ஓவியம் = கோட்டோவியம்."}}}
{"id":"b-tam-7t2-094","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 28"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘செப்பேடு’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"செப்பு + ஈடு"},{"key":"B","text":"செப்பு + ஓடு"},{"key":"C","text":"செப்பு + ஏடு"},{"key":"D","text":"செப்பு + யேடு"}],"explanation":"செப்பு + ஏடு = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'செப்பேடு' எனப் புணரும்."}}}
{"id":"b-tam-7t2-095","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 28"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எழுத்து + ஆணி’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"எழுத்து ஆணி"},{"key":"B","text":"எழுத்தாணி"},{"key":"C","text":"எழுத்துதாணி"},{"key":"D","text":"எழுதாணி"}],"explanation":"உயிர்வரின் உக்குறள் மெய்விட்டோடும்: உகரம் கெட்டு, த் + ஆ = தா ஆகி 'எழுத்தாணி' எனப் புணரும்."}}}
{"id":"b-tam-7t2-157","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 37"},"texts":{"ta":{"blocks":[{"type":"text","text":"பண்டைய தமிழகத்தில் சுவரோவியங்கள் வரைவதற்கு முன் ஆற்று மணலுடன் எதனைச் சேர்த்துச் சுவரைச் சமப்படுத்தினர்?"}],"options":[{"key":"A","text":"களிமண்"},{"key":"B","text":"சுண்ணாம்பு"},{"key":"C","text":"மரப்பிசின்"},{"key":"D","text":"சிமெண்ட்"}],"explanation":"ஆற்று மணலுடன் சுண்ணாம்பைச் சேர்த்துச் சுவரைச் சமப்படுத்தி அதன்மீது சுவர் ஓவியங்களை வரைந்தனர்."}}}
