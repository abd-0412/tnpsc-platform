// 7-ஆம் வகுப்பு தமிழ் - பருவம் 2 - இயல் 2 - பாடம் 1 (7): பூத்தொடுத்தல் (கவிதைப்பேழை - உமா மகேஸ்வரி)
// வினாக்கள் எண்ணிக்கை: 8
// ==============================================================================
{"id":"b-tam-7t2-069","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 22"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இந்தப் பூவைத் தொடுப்பது எப்படி? சாந்தமானதொரு பிரபஞ்சத்தைச் சுமக்கின்றன ஒல்லித் தண்டுகள்...’ - என்ற புதுக்கவிதையைப் பாடியவர் யார்?"}],"options":[{"key":"A","text":"கலாப்ரியா"},{"key":"B","text":"உமா மகேஸ்வரி"},{"key":"C","text":"தாமரை"},{"key":"D","text":"சல்மா"}],"explanation":"பூத்தொடுத்தல் என்னும் அழகியல் கவிதையைப் பாடியவர் கவிஞர் உமா மகேஸ்வரி ஆவார்."}}}
{"id":"b-tam-7t2-070","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"3","C":"4","D":"1"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 23"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பூத்தொடுத்தல்’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"சாந்தம்"},{"label":"B","text":"நுண்மை"},{"label":"C","text":"பிரபஞ்சம்"},{"label":"D","text":"உற்றால்"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"அடைந்தால்"},{"label":"2","text":"அமைதி"},{"label":"3","text":"நுட்பம்"},{"label":"4","text":"அண்டம் (பெருவெளி)"}]}],"options":[{"key":"A","text":"A-2, B-3, C-4, D-1","mapping":{"A":"2","B":"3","C":"4","D":"1"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}}],"explanation":"சாந்தம் = அமைதி; நுண்மை = நுட்பம்; பிரபஞ்சம் = அண்டம்; உற்றால் = அடைந்தால்."}}}
{"id":"b-tam-7t2-071","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 23"},"texts":{"ta":{"blocks":[{"type":"text","text":"கவிஞர் உமா மகேஸ்வரி எந்த மாவட்டத்தில் பிறந்தவர்?"}],"options":[{"key":"A","text":"தேனி"},{"key":"B","text":"மதுரை மாவட்டம்"},{"key":"C","text":"திண்டுக்கல்"},{"key":"D","text":"விருதுநகர்"}],"explanation":"கவிஞர் உமா மகேஸ்வரி மதுரை மாவட்டத்தில் பிறந்தவர்; தற்போது தேனி மாவட்டம் ஆண்டிபட்டியில் வாழ்ந்து வருகிறார்."}}}
{"id":"pyq-tam-7t2-072","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":39},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நட்சத்திரங்களின் நடுவே, வெறும் பொழுது, கற்பாவை’ உள்ளிட்ட கவிதைத் தொகுதிகளைப் படைத்த பெண் கவிஞர் யார்?"}],"options":[{"key":"A","text":"ஆண்டாள் பிரியதர்சினி"},{"key":"B","text":"உமா மகேஸ்வரி"},{"key":"C","text":"கனிமொழி"},{"key":"D","text":"இரா மீனாட்சி"}],"explanation":"நட்சத்திரங்களின் நடுவே, வெறும் பொழுது, கற்பாவை ஆகியவை உமா மகேஸ்வரியின் புகழ்பெற்ற கவிதைத் தொகுதிகள் ஆகும்."}}}
{"id":"b-tam-7t2-073","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 22"},"texts":{"ta":{"blocks":[{"type":"text","text":"மலரைத் தொடுக்கும் போது இறுக்கி முடிச்சிட்டால் காம்புகளுக்கு என்ன நேரும் எனக் கவிஞர் குறிப்பிடுகிறார்?"}],"options":[{"key":"A","text":"இதழ்கள் உதிரும்"},{"key":"B","text":"காம்புகளின் கழுத்து முறியும்"},{"key":"C","text":"மணம் குறையும்"},{"key":"D","text":"நிறம் மாறும்"}],"explanation":"'இறுக்கி முடிச்சிட்டால் காம்புகளின் கழுத்து முறியும்; தளரப் பிணைத்தால் மலர்கள் தரையில் நழுவும்' என்று கவிஞர் கூறுகிறார்."}}}
{"id":"b-tam-7t2-074","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 23"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘முடிச்சிட்டால்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"முடிச்சி + இடல்"},{"key":"B","text":"முடிச்சி + சிட்டால்"},{"key":"C","text":"முடிச்சு + இட்டால்"},{"key":"D","text":"முடிச்சு + இடல்"}],"explanation":"முடிச்சு + இட்டால் = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி உகரம் கெட்டு, ச் + இ = சி ஆகி 'முடிச்சிட்டால்' எனப் புணரும்."}}}
{"id":"b-tam-7t2-075","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 23"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நிற்பது + அறிந்தும்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"நிற்பதறிந்தும்"},{"key":"B","text":"நிற்பதுஅறிந்தும்"},{"key":"C","text":"நிற்பறிந்தும்"},{"key":"D","text":"நிற்பதறிந்தோம்"}],"explanation":"நிற்பது + அறிந்தும் = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி உ கெட்டு, த் + அ = த ஆகி 'நிற்பதறிந்தும்' எனப் புணரும்."}}}
{"id":"b-tam-7t2-076","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 23"},"texts":{"ta":{"blocks":[{"type":"text","text":"போர் இல்லாத உலகில் எது நிலவும் எனப் பாடநூல் மதிப்பீடு வினவுகிறது?"}],"options":[{"key":"A","text":"பதற்றம்"},{"key":"B","text":"சாந்தம் (அமைதி)"},{"key":"C","text":"சோர்வு"},{"key":"D","text":"வெறுப்பு"}],"explanation":"போர் இல்லாத உலகில் அமைதி அதாவது சாந்தம் நிலவும்."}}}
