// 7-ஆம் வகுப்பு தமிழ் - பருவம் 2 - இயல் 1 - பாடம் 6: மொழியை ஆள்வோம் & கலைச்சொற்கள் அறிவோம்
// வினாக்கள் எண்ணிக்கை: 7
// ==============================================================================
{"id":"b-tam-7t2-060","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 18"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கல்லணை கரிகாலன் கட்டப்பட்டது’ - பொருத்தமான இடத்தில் ‘ஆல்’ உருபு சேர்த்து எழுதப்படும் சரியான தொடர் எது?"}],"options":[{"key":"A","text":"கல்லணையால் கரிகாலன் கட்டப்பட்டது"},{"key":"B","text":"கல்லணை கரிகாலனால் கட்டப்பட்டது"},{"key":"C","text":"கல்லணை கரிகாலன் கட்டப்பட்டதுவால்"},{"key":"D","text":"கரிகாலன் கல்லணையில் கட்டப்பட்டது"}],"explanation":"மூன்றாம் வேற்றுமை உருபான 'ஆல்' கரிகாலன் என்னும் எழுவாயோடு இணைந்து 'கரிகாலனால்' என வருதலே முறை."}}}
{"id":"b-tam-7t2-061","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 18"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஒரு குறிப்பிட்ட நோக்கத்திற்காக ஓர் அலுவலகம் அல்லது நிறுவனத்திற்கு எழுதப்படும் விண்ணப்பக் கடிதம் எவ்வாறு அழைக்கப்படும்?"}],"options":[{"key":"A","text":"உறவுமுறைக் கடிதம்"},{"key":"B","text":"அலுவலகக் கடிதம்"},{"key":"C","text":"நட்புக் கடிதம்"},{"key":"D","text":"வணிக அறிக்கை"}],"explanation":"அலுவலகத்திற்கு எழுதும் விண்ணப்பங்கள் அலுவலகக் கடிதம் அல்லது விண்ணப்பக் கடிதம் எனப்படும்."}}}
{"id":"b-tam-7t2-062","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 20"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘________ புல்லை மேயும்; ________ சுடும்’ - பொருத்தமான ஓரெழுத்து ஒருமொழிகள் எவை?"}],"options":[{"key":"A","text":"மா, பூ"},{"key":"B","text":"ஆ, தீ"},{"key":"C","text":"ஈ, தை"},{"key":"D","text":"கோ, கை"}],"explanation":"ஆ (பசு) புல்லை மேயும்; தீ (நெருப்பு) சுடும்."}}}
{"id":"b-tam-7t2-063","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 20"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பா’ மற்றும் ‘வா’ ஆகிய ஓரெழுத்து ஒருமொழிகளின் பொருள்கள் முறையே எவை?"}],"options":[{"key":"A","text":"பாதுகாத்தல், போ"},{"key":"B","text":"பாடல், அழைத்தல்"},{"key":"C","text":"பறவை, வாசல்"},{"key":"D","text":"பரிசு, வருத்தம்"}],"explanation":"பா = பாடல்; வா = அழைத்தல்."}}}
{"id":"b-tam-7t2-064","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 20"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘படி’ என்னும் சொல் தரும் இரண்டு வேறுபட்ட பொருள்கள் எவை?"}],"options":[{"key":"A","text":"பார்த்தல், கேட்டல்"},{"key":"B","text":"புத்தகம் படித்தல், மாடிப் படி (அளக்கும் படி)"},{"key":"C","text":"எழுதுதல், வரைதல்"},{"key":"D","text":"நடத்தல், ஓடுதல்"}],"explanation":"படி என்பது நூலைப் படித்தலையும், ஏறிச்செல்லும் படிக்கட்டையும் குறிக்கும் இருபொருள் சொல்."}}}
{"id":"b-tam-7t2-065","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"4","C":"1","D":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 20"},"texts":{"ta":{"blocks":[{"type":"text","text":"கல்விசார் ஆங்கிலக் கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"},{"type":"list","name":"ஆங்கிலச் சொல்","items":[{"label":"A","text":"Summer Vacation"},{"label":"B","text":"Child Labour"},{"label":"C","text":"Degree"},{"label":"D","text":"Literacy"}]},{"type":"list","name":"தமிழாக்கம்","items":[{"label":"1","text":"பட்டம்"},{"label":"2","text":"எழுத்தறிவு"},{"label":"3","text":"கோடை விடுமுறை"},{"label":"4","text":"குழந்தைத் தொழிலாளர்"}]}],"options":[{"key":"A","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"D","text":"A-4, B-3, C-2, D-1","mapping":{"A":"4","B":"3","C":"2","D":"1"}}],"explanation":"Summer Vacation = கோடை விடுமுறை; Child Labour = குழந்தைத் தொழிலாளர்; Degree = பட்டம்; Literacy = எழுத்தறிவு."}}}
{"id":"b-tam-7t2-066","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"3","C":"4","D":"1"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 20"},"texts":{"ta":{"blocks":[{"type":"text","text":"பள்ளிக் கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"},{"type":"list","name":"ஆங்கிலச் சொல்","items":[{"label":"A","text":"Moral"},{"label":"B","text":"Uniform"},{"label":"C","text":"Guidance"},{"label":"D","text":"Discipline"}]},{"type":"list","name":"தமிழாக்கம்","items":[{"label":"1","text":"ஒழுக்கம்"},{"label":"2","text":"நீதி"},{"label":"3","text":"சீருடை"},{"label":"4","text":"வழிகாட்டுதல்"}]}],"options":[{"key":"A","text":"A-2, B-3, C-4, D-1","mapping":{"A":"2","B":"3","C":"4","D":"1"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-4, B-1, C-2, D-3","mapping":{"A":"4","B":"1","C":"2","D":"3"}}],"explanation":"Moral = நீதி; Uniform = சீருடை; Guidance = வழிகாட்டுதல்; Discipline = ஒழுக்கம்."}}}
