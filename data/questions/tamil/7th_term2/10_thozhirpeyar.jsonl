// 7-ஆம் வகுப்பு தமிழ் - பருவம் 2 - இயல் 2 - பாடம் 4 (10): தொழிற்பெயர் (கற்கண்டு - இலக்கணம்)
// வினாக்கள் எண்ணிக்கை: 8
// ==============================================================================
{"id":"b-tam-7t2-110","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஒரு செயலின் அல்லது வினையின் பெயராக அமைந்து எண், இடம், காலம், பால் ஆகியவற்றைக் காட்டாமல் படர்க்கை இடத்தில் மட்டும் வருவது எது?"}],"options":[{"key":"A","text":"வினையாலணையும் பெயர்"},{"key":"B","text":"தொழிற்பெயர் (எ.கா: உழுதல், தைத்தல்)"},{"key":"C","text":"வினைமுற்று"},{"key":"D","text":"பண்புப்பெயர்"}],"explanation":"தொழிற்பெயர் காலம், திணை, பால், எண் ஆகியவற்றைக் காட்டாது; படர்க்கை இடத்தில் மட்டும் தொழிலின் பெயராய் வரும்."}}}
{"id":"b-tam-7t2-111","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"text","text":"தொழிற்பெயர் எத்தனை வகைகளாக வகைப்படுத்தப்படும்?"}],"options":[{"key":"A","text":"இரண்டு வகைப்படும்"},{"key":"B","text":"மூன்று வகைப்படும் (விகுதி பெற்ற, முதல்நிலை, முதல்நிலை திரிந்த)"},{"key":"C","text":"நான்கு வகைப்படும்"},{"key":"D","text":"ஐந்து வகைப்படும்"}],"explanation":"தொழிற்பெயரை விகுதி பெற்ற தொழிற்பெயர், முதல்நிலைத் தொழிற்பெயர், முதல்நிலை திரிந்த தொழிற்பெயர் என மூவகையாகப் பிரிப்பர்."}}}
{"id":"b-tam-7t2-112","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"4","C":"1","D":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"text","text":"தொழிற்பெயர் விகுதிகளையும் அவற்றுக்குரிய சான்றுகளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"விகுதி","items":[{"label":"A","text":"அம்"},{"label":"B","text":"ஐ"},{"label":"C","text":"கை"},{"label":"D","text":"வை"}]},{"type":"list","name":"சான்று","items":[{"label":"1","text":"வருகை"},{"label":"2","text":"பார்வை"},{"label":"3","text":"ஆட்டம்"},{"label":"4","text":"விலை"}]}],"options":[{"key":"A","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"D","text":"A-4, B-3, C-2, D-1","mapping":{"A":"4","B":"3","C":"2","D":"1"}}],"explanation":"ஆட்டம் = அம்; விலை = ஐ; வருகை = கை; பார்வை = வை; தருதல் = தல்; கூறல் = அல்; நட்பு = பு; மறைவு = வு."}}}
{"id":"b-tam-7t2-113","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வானில் இடி இடித்தது, சோறு கொதி வந்தது’ - இதில் ‘இடி, கொதி’ என்பன எவ்வகைத் தொழிற்பெயர்கள் ஆகும்?"}],"options":[{"key":"A","text":"விகுதி பெற்ற தொழிற்பெயர்"},{"key":"B","text":"முதல்நிலைத் தொழிற்பெயர்"},{"key":"C","text":"முதல்நிலை திரிந்த தொழிற்பெயர்"},{"key":"D","text":"வினையாலணையும் பெயர்"}],"explanation":"இடித்தல், கொதித்தல் ஆகியவற்றின் வினைப்பகுதிகள் எவ்வகை மாற்றமும் பெறாமல் விகுதியின்றித் தொழிற்பெயராய் நிற்பது முதல்நிலைத் தொழிற்பெயர் ஆகும்."}}}
{"id":"pyq-tam-7t2-114","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":85},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பெறு $\\rightarrow$ பேறு, சுடு $\\rightarrow$ சூடு, கெடு $\\rightarrow$ கேடு’ - பகுதியாகிய முதல்நிலை திரிந்து உருவாகும் தொழிற்பெயர் எது?"}],"options":[{"key":"A","text":"விகுதி பெற்ற தொழிற்பெயர்"},{"key":"B","text":"முதல்நிலைத் தொழிற்பெயர்"},{"key":"C","text":"முதல்நிலை திரிந்த தொழிற்பெயர்"},{"key":"D","text":"பண்புப்பெயர்"}],"explanation":"பகுதியின் முதலெழுத்து நீண்டு திரிந்து தொழிற்பெயராக அமைவது 'முதல்நிலை திரிந்த தொழிற்பெயர்' எனப்படும்."}}}
{"id":"b-tam-7t2-115","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 36"},"texts":{"ta":{"blocks":[{"type":"text","text":"தொழிற்பெயர்களைச் சரியான வகையோடு பொருத்துக:"},{"type":"list","name":"தொழிற்பெயர்","items":[{"label":"A","text":"ஓட்டம்"},{"label":"B","text":"பிடி"},{"label":"C","text":"சூடு"}]},{"type":"list","name":"வகை","items":[{"label":"1","text":"முதல்நிலைத் தொழிற்பெயர்"},{"label":"2","text":"முதல்நிலை திரிந்த தொழிற்பெயர்"},{"label":"3","text":"விகுதி பெற்ற தொழிற்பெயர்"}]}],"options":[{"key":"A","text":"A-3, B-1, C-2","mapping":{"A":"3","B":"1","C":"2"}},{"key":"B","text":"A-1, B-2, C-3","mapping":{"A":"1","B":"2","C":"3"}},{"key":"C","text":"A-2, B-3, C-1","mapping":{"A":"2","B":"3","C":"1"}},{"key":"D","text":"A-3, B-2, C-1","mapping":{"A":"3","B":"2","C":"1"}}],"explanation":"ஓட்டம் = விகுதி பெற்ற தொழிற்பெயர் (அம்); பிடி = முதல்நிலைத் தொழிற்பெயர்; சூடு = முதல்நிலை திரிந்த தொழிற்பெயர் (சுடு $\\rightarrow$ சூடு)."}}}
{"id":"b-tam-7t2-116","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 36"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஊறு, நடு, விழு, எழுதல்’ - இவற்றுள் முதல்நிலை திரிந்த தொழிற்பெயர் எது?"}],"options":[{"key":"A","text":"ஊறு (உறு $\\rightarrow$ ஊறு)"},{"key":"B","text":"நடு"},{"key":"C","text":"விழு"},{"key":"D","text":"எழுதல்"}],"explanation":"உறு என்னும் பகுதி நீண்டு 'ஊறு' எனத் திரிந்ததால் இது முதல்நிலை திரிந்த தொழிற்பெயர் ஆகும்."}}}
{"id":"b-tam-7t2-143","kind":"assertion_reason","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"‘படித்தல், ஆடல்’ என்பன தொழிற்பெயர்கள் ஆகும்."},{"type":"reason","text":"இவை ஒரு வினையின் அல்லது தொழிலின் பெயராய் அமைந்து திணை, பால், எண், இடம், காலம் ஆகியவற்றைக் காட்டாமல் வருகின்றன."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"தொழிற்பெயர்கள் தொழிலின் பெயராய் நின்று காலம், பால், எண் காட்டாது; எனவே கூற்றும் காரணமும் சரி."}}}
