// 7-ஆம் வகுப்பு தமிழ் - பருவம் 2 - இயல் 2 - பாடம் 6 (12): திருக்குறள் (வாழ்வியல் / நீதி இலக்கியம்)
// வினாக்கள் எண்ணிக்கை: 38
// ==============================================================================
{"id":"b-tam-7t2-119","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 40"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கற்க கசடறக் கற்பவை கற்றபின் நிற்க அதற்குத் தக’ - இக்குறட்பா உணர்த்தும் வாழ்வியல் நெறி யாது?"}],"options":[{"key":"A","text":"நூல்களைப் பலமுறை படிக்க வேண்டும்"},{"key":"B","text":"கற்க வேண்டிய நூல்களைப் பிழை இல்லாமல் கற்க வேண்டும்; கற்றபின் அக்கல்வி நெறியின் வழியில் வாழ வேண்டும்"},{"key":"C","text":"அனைத்து நூல்களையும் மனப்பாடம் செய்ய வேண்டும்"},{"key":"D","text":"கல்வி கற்றோரைப் போற்ற வேண்டும்"}],"explanation":"பிழையின்றித் தெளிவுறக் கற்பதும், கற்ற நெறியின்படி தன் வாழ்க்கையை அமைத்துக் கொள்வதுமே உண்மையான கல்வியாகும்."}}}
{"id":"b-tam-7t2-120","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 40"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எண்ணென்ப ஏனை எழுத்தென்ப இவ்விரண்டும் கண்என்ப வாழும் உயிர்க்கு’ - மனிதராய்ப் பிறந்தவர்களுக்குக் கண்கள் போன்றவையாக வள்ளுவர் எவற்றைக் கூறுகிறார்?"}],"options":[{"key":"A","text":"அறமும் பொருளும்"},{"key":"B","text":"எண்ணும் எழுத்தும்"},{"key":"C","text":"அன்பும் அருளும்"},{"key":"D","text":"கல்வியும் செல்வமும்"}],"explanation":"எண் என்று சொல்லப்படும் கணிதமும், எழுத்து என்று சொல்லப்படும் இலக்கண இலக்கியங்களும் வாழும் உயிர்களுக்கு இரு கண்கள் போன்றவை."}}}
{"id":"pyq-tam-7t2-121","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":8},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தொட்டனைத்து ஊறும் மணற்கேணி மாந்தர்க்குக் கற்றனைத்து ஊறும் அறிவு’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?"}],"options":[{"key":"A","text":"உவமையணி"},{"key":"B","text":"எடுத்துக்காட்டு உவமை அணி"},{"key":"C","text":"சொற்பொருள் பின்வருநிலை அணி"},{"key":"D","text":"வேற்றுமையணி"}],"explanation":"உவமையும் உவமேயமும் தனித்தனித் தொடராக வந்து, 'அதுபோல' என்னும் உவம உருபு மறைந்து வந்துள்ளதால் இது எடுத்துக்காட்டு உவமை அணி ஆகும்."}}}
{"id":"b-tam-7t2-122","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 40"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘செய்தக்க அல்ல செயக்கெடும் செய்தக்க செய்யாமை யானும் கெடும்’ - ஒருவனுக்கு எப்போது தீமை உண்டாகும் என வள்ளுவர் எச்சரிக்கிறார்?"}],"options":[{"key":"A","text":"பகைவரை அஞ்சும்போது"},{"key":"B","text":"செல்வத்தை இழக்கும்போது"},{"key":"C","text":"செய்யத்தகாத செயல்களைச் செய்வதாலும், செய்யத்தக்க நற்செயல்களைச் செய்யாமல் விடுவதாலும்"},{"key":"D","text":"பொய் பேசும்போது"}],"explanation":"செய்யக்கூடாத தீயவற்றைச் செய்வதாலும், செய்ய வேண்டிய கடமைகளைச் செய்யாது தவிர்ப்பதாலும் ஒருவனுக்குக் கேடு விளையும்."}}}
{"id":"pyq-tam-7t2-123","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":16},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எண்ணித் துணிக கருமம் துணிந்தபின் எண்ணுவம் என்பது இழுக்கு’ - இதில் ‘இழுக்கு’ என்னும் சொல்லின் பொருள் யாது?"}],"options":[{"key":"A","text":"துன்பம்"},{"key":"B","text":"குற்றம் (தவறு)"},{"key":"C","text":"இழிவு"},{"key":"D","text":"தோல்வி"}],"explanation":"நன்கு சிந்தித்த பின்னரே ஒரு செயலில் இறங்க வேண்டும்; தொடங்கிய பின் யோசிக்கலாம் என்பது குற்றமாகும் (இழுக்கு)."}}}
{"id":"b-tam-7t2-124","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 41"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நன்றாற்றல் உள்ளும் தவறுண்டு அவரவர் பண்பறிந்து ஆற்றாக் கடை’ - நன்மை செய்தாலும் தீமையாக முடியும் சூழ்நிலை எது?"}],"options":[{"key":"A","text":"பகைவர்க்கு உதவி செய்தால்"},{"key":"B","text":"உதவி பெறுபவரின் குணத்தையும் இயல்பையும் ஆராய்ந்து செய்யாவிட்டால்"},{"key":"C","text":"செல்வம் இல்லாத போது செய்தால்"},{"key":"D","text":"காலம் தவறிச் செய்தால்"}],"explanation":"ஒருவருடைய பண்பை அறிந்து அவருக்கு நன்மை செய்ய வேண்டும்; இல்லாவிட்டால் நன்மையும் தீமையாய் முடியும்."}}}
{"id":"b-tam-7t2-125","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 41"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘காக்கை கரவா கரைந்துண்ணும் ஆக்கமும் அன்ன நீரார்க்கே உள’ - தனக்குக் கிடைத்த உணவை மறைக்காமல் சுற்றத்தைக் கூவி அழைத்து உண்ணும் காகத்தின் பண்பைப் போன்றவரிடம் எது சேரும்?"}],"options":[{"key":"A","text":"புகழ் மட்டுமே"},{"key":"B","text":"செல்வமும் நல்வாழ்வும் (ஆக்கம்)"},{"key":"C","text":"அரச பதவி"},{"key":"D","text":"சுற்றத்தாரின் பாராட்டு"}],"explanation":"பகிர்ந்து உண்ணும் நற்பண்பு உடையவரிடமே மென்மேலும் செல்வமானது (ஆக்கம்) பெருகிச் சேரும்."}}}
{"id":"b-tam-7t2-126","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 41"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மடியை மடியா ஒழுகல் குடியைக் குடியாக வேண்டு பவர்’ - தன் குடும்பத்தைச் சிறந்த குடியாக உயர்த்த விரும்புபவர் எதனை ஒழிக்க வேண்டும்?"}],"options":[{"key":"A","text":"வறுமையை"},{"key":"B","text":"சோம்பலை (மடி)"},{"key":"C","text":"சினத்தை"},{"key":"D","text":"செருக்கை"}],"explanation":"மடி என்றால் சோம்பல் என்று பொருள்; தன் குடியை உயர்த்த விரும்புபவன் சோம்பலைத் துன்பமாகக் கருதிப் போக்க வேண்டும்."}}}
{"id":"pyq-tam-7t2-127","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2018,"paper":"tamil","no":14},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இடும்பைக்கு இடும்பை படுப்பர் இடும்பைக்கு இடும்பை படாஅ தவர்’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?"}],"options":[{"key":"A","text":"உவமையணி"},{"key":"B","text":"சொற்பொருள் பின்வருநிலை அணி"},{"key":"C","text":"எடுத்துக்காட்டு உவமை அணி"},{"key":"D","text":"வேற்றுமையணி"}],"explanation":"'இடும்பை' என்னும் சொல் 'துன்பம்' என்னும் ஒரே பொருளில் பலமுறை செய்யுளில் மீண்டும் மீண்டும் வந்துள்ளதால் இது சொற்பொருள் பின்வருநிலை அணி ஆகும்."}}}
{"id":"b-tam-7t2-128","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 41"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘துன்பத்திற்கே துன்பம் உண்டாக்கி அதனை வென்று விடுபவர் யார்’ என வள்ளுவர் உரைக்கிறார்?"}],"options":[{"key":"A","text":"அளவற்ற செல்வம் படைத்தவர்"},{"key":"B","text":"துன்பம் வந்தபோது மனந்தளராது கலங்காமல் எதிர்கொள்பவர்"},{"key":"C","text":"அரசனிடம் அடைக்கலம் புகுந்தவர்"},{"key":"D","text":"துறவறம் பூண்டவர்"}],"explanation":"இடுக்கண் வந்த போது கலங்காத உறுதியுடையவரே துன்பத்திற்கே துன்பம் தந்து அதனை வெல்வர்."}}}
{"id":"b-tam-7t2-129","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 42"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எழுத்தென்ப’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"எழுத்து + தென்ப"},{"key":"B","text":"எழுத்து + என்ப"},{"key":"C","text":"எழுத்து + இன்ப"},{"key":"D","text":"எழுத் + தென்ப"}],"explanation":"எழுத்து + என்ப = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'எழுத்தென்ப' எனப் புணரும்."}}}
{"id":"b-tam-7t2-130","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 42"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கரைந்துண்ணும்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"கரைந்து + இன்னும்"},{"key":"B","text":"கரை + துண்ணும்"},{"key":"C","text":"கரைந்து + உண்ணும்"},{"key":"D","text":"கரை + உண்ணும்"}],"explanation":"கரைந்து + உண்ணும் = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி உ கெட்டு, த் + உ = து ஆகி 'கரைந்துண்ணும்' எனப் புணரும்."}}}
{"id":"b-tam-7t2-131","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 42"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கற்றனைத்து + ஊறும்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"கற்றனைத்தூறும்"},{"key":"B","text":"கற்றனைதூறும்"},{"key":"C","text":"கற்றனைத்தீறும்"},{"key":"D","text":"கற்றனைத்தோறும்"}],"explanation":"கற்றனைத்து + ஊறும் = உகரம் கெட்டு, த் + ஊ = தூ ஆகி 'கற்றனைத்தூறும்' எனப் புணரும்."}}}
{"id":"b-tam-7t2-132","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"4","C":"5","D":"1","E":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 42"},"texts":{"ta":{"blocks":[{"type":"text","text":"திருக்குறள் கருத்துகளைப் பொருத்துக:"},{"type":"list","name":"குறட்பகுதி","items":[{"label":"A","text":"கற்கும் முறை"},{"label":"B","text":"உயிர்க்குக் கண்கள்"},{"label":"C","text":"விழுச்செல்வம்"},{"label":"D","text":"எண்ணித் துணிக"},{"label":"E","text":"கரவா கரைந்துண்ணும்"}]},{"type":"list","name":"பொருத்தம்","items":[{"label":"1","text":"செயல்"},{"label":"2","text":"காகம்"},{"label":"3","text":"பிழையில்லாமல் கற்றல்"},{"label":"4","text":"எண்ணும் எழுத்தும்"},{"label":"5","text":"கல்வி"}]}],"options":[{"key":"A","text":"A-3, B-4, C-5, D-1, E-2","mapping":{"A":"3","B":"4","C":"5","D":"1","E":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4, E-5","mapping":{"A":"1","B":"2","C":"3","D":"4","E":"5"}},{"key":"C","text":"A-3, B-1, C-4, D-2, E-5","mapping":{"A":"3","B":"1","C":"4","D":"2","E":"5"}},{"key":"D","text":"A-4, B-3, C-2, D-1, E-5","mapping":{"A":"4","B":"3","C":"2","D":"1","E":"5"}}],"explanation":"கற்கும் முறை = பிழையில்லாமல் கற்றல்; உயிர்க்குக் கண்கள் = எண்ணும் எழுத்தும்; விழுச்செல்வம் = கல்வி; எண்ணித் துணிக = செயல்; கரவா கரைந்துண்ணும் = காகம்."}}}
{"id":"b-tam-7t2-133","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கண்உடையர் என்பவர் கற்றார் முகத்துஇரண்டு புண்உடையர் கல்லா தவர்’ - இக்குறளின்படி முகத்தில் இரண்டு புண்களை உடையவராக வள்ளுவர் யாரைக் கூறுகிறார்?"}],"options":[{"key":"A","text":"பார்வையற்ற குருடர்களை"},{"key":"B","text":"கல்வியறிவில்லாத கல்லாதவர்களை"},{"key":"C","text":"பொய் பேசுபவர்களை"},{"key":"D","text":"பகைவர்களை"}],"explanation":"கற்றவருக்கே கண்கள் உண்டு; கல்லாதவரின் முகத்தில் இருப்பவை கண்கள் அல்ல, வெறும் புண்களே என்கிறார்."}}}
{"id":"b-tam-7t2-134","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஒருமைக்கண் தான்கற்ற கல்வி ஒருவற்கு எழுமையும் ஏமாப்பு உடைத்து’ - இதில் ‘ஏமாப்பு’ என்பதன் பொருள் யாது?"}],"options":[{"key":"A","text":"செல்வம்"},{"key":"B","text":"துன்பம்"},{"key":"C","text":"பாதுகாவல் (அரண்/வலிமை)"},{"key":"D","text":"புகழ்"}],"explanation":"ஏமாப்பு என்றால் பாதுகாப்பு என்று பொருள்; ஒரு பிறப்பில் கற்ற கல்வியானது ஒருவனுக்கு ஏழு பிறப்புகளிலும் கூடவே வந்து பாதுகாக்கும்."}}}
{"id":"b-tam-7t2-135","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தெரிந்த இனத்தொடு தேர்ந்தெண்ணிச் செய்வார்க்கு அரும்பொருள் யாதொன்றும் இல்’ - இக்குறளின்படி எவருக்கு முடிக்க முடியாத கடினமான செயல் என்று ஒன்றுமே இல்லை?"}],"options":[{"key":"A","text":"அளவற்ற படைபலம் கொண்ட அரசனுக்கு"},{"key":"B","text":"தக்க துணைவர்களோடு கலந்து ஆராய்ந்து செயலாற்றுபவர்க்கு"},{"key":"C","text":"அதிக செல்வம் உள்ளவர்க்கு"},{"key":"D","text":"துணிவுடைய இளைஞனுக்கு"}],"explanation":"ஆராய்ந்து அறியும் சிறந்தோருடன் கூடி எண்ணிச் செயலாற்றுவோருக்குச் சாதிக்க முடியாத அரிய செயல் என்று உலகில் எதுவுமில்லை."}}}
{"id":"b-tam-7t2-136","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வகையறச் சூழாது எழுதல் பகைவரைப் பாத்திப் படுப்பதோர் ஆறு’ - முறையான திட்டமிடல் இல்லாமல் ஒரு செயலில் இறங்குவது எதற்குச் சமம் என வள்ளுவர் கூறுகிறார்?"}],"options":[{"key":"A","text":"கடலில் விழுவதற்குச் சமம்"},{"key":"B","text":"பகைவரைத் தன் கைகளாலேயே வளர்த்து வெற்றிக்கு வழிவகுத்துக் கொடுப்பதற்குச் சமம்"},{"key":"C","text":"பொருளை இழப்பதற்குச் சமம்"},{"key":"D","text":"காற்றில் அலைவதற்குச் சமம்"}],"explanation":"முழுமையாக ஆராயாமல் காரியத்தில் இறங்குவது பகைவனை வலுப்படுத்தி அவனுக்கு வெற்றிப் பாத்தி பிடிப்பதாகும்."}}}
{"id":"b-tam-7t2-137","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அளவளாவு இல்லாதான் வாழ்க்கை குளவளாக் கோடுஇன்றி நீர்நிறைந் தற்று’ - பிறரோடு கலந்து பழகாதவனின் செல்வ வாழ்க்கை எதைப் போன்றது?"}],"options":[{"key":"A","text":"மழையற்ற மேகம் போன்றது"},{"key":"B","text":"கரையில்லாத குளம் நீர் நிரம்ப முயல்வது போல வீணே அழியும்"},{"key":"C","text":"விளக்கில்லாத இருள் போன்றது"},{"key":"D","text":"காற்றற்ற வெளி போன்றது"}],"explanation":"கரையில்லாத குளத்தில் நீர் தங்காது வீணாவது போல, சுற்றத்தாரோடு அளவளாவிப் பழகாதவனின் செல்வமும் தங்காது அழியும்."}}}
{"id":"b-tam-7t2-138","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘குடியென்னும் குன்றா விளக்கம் மடியென்னும் மாசுஊர மாய்ந்து கெடும்’ - பரம்பரை குடும்பப் பெருமை என்னும் அணையாத ஒளிவிளக்கு எதனால் அணைந்து போகும்?"}],"options":[{"key":"A","text":"வறுமையால்"},{"key":"B","text":"சோம்பல் (மடி) என்னும் இருள் புகுந்தால்"},{"key":"C","text":"பகைவரால்"},{"key":"D","text":"நோயினால்"}],"explanation":"குடும்பம் என்னும் விளக்கினைச் சோம்பல் என்னும் அழுக்கு இருள் சூழ்ந்து அணைத்துவிடும்."}}}
{"id":"b-tam-7t2-139","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நெடுநீர் மறவி மடிதுயில் நான்கும் கெடுநீரார் காமக் கலன்’ - அழியும் குணம் கொண்டவர்கள் விரும்பி அணியும் அணிகலன்கள் என வள்ளுவர் எவற்றைக் கூறுகிறார்?"}],"options":[{"key":"A","text":"பொன், பொருள், ஆடை, நிலம்"},{"key":"B","text":"காலந்தாழ்த்தல் (நெடுநீர்), மறதி, சோம்பல், அளவுக்கு மீறிய தூக்கம்"},{"key":"C","text":"பொய், திருட்டு, சூது, கோபம்"},{"key":"D","text":"அச்சம், மடம், நாணம், பயிர்ப்பு"}],"explanation":"காலத்தாழ்வு, மறதி, சோம்பல், தூக்கம் ஆகிய நான்கும் கெடும் இயல்புடையவர் அணியும் துன்ப அணிகலன்களாகும்."}}}
{"id":"b-tam-7t2-140","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 45"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இடுக்கண் வருங்கால் நகுக அதனை அடுத்துஊர்வது அஃதொப்பது இல்’ - துன்பம் வரும்போது மனிதன் என்ன செய்ய வேண்டும் என வள்ளுவர் வழிகாட்டுகிறார்?"}],"options":[{"key":"A","text":"அழுது புலம்ப வேண்டும்"},{"key":"B","text":"புன்முறுவல் பூத்துச் சிரிக்க வேண்டும் (நகுக)"},{"key":"C","text":"நாட்டை விட்டு ஓட வேண்டும்"},{"key":"D","text":"பிறரிடம் உதவி கேட்க வேண்டும்"}],"explanation":"துன்பம் வரும்போது மனந்தளராது புன்னகையோடு எதிர்கொண்டால் அத்துன்பத்தைக் கடப்பதற்கு இணையான வழி வேறில்லை."}}}
{"id":"b-tam-7t2-141","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 45"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மடுத்தவாய் எல்லாம் பகடுஅன்னான் உற்ற இடுக்கண் இடர்ப்பாடு உடைத்து’ - இதில் ‘பகடு’ என்பதன் பொருள் யாது?"}],"options":[{"key":"A","text":"யானை"},{"key":"B","text":"எருது (வண்டி இழுக்கும் காளை)"},{"key":"C","text":"சிங்கம்"},{"key":"D","text":"குதிரை"}],"explanation":"பகடு என்றால் எருது அல்லது காளை என்று பொருள்; பள்ளத்தில் சிக்கிய வண்டியை இழுத்துச் செல்லும் காளை போன்றவனுக்குத் துன்பமே துன்பப்படும்."}}}
{"id":"b-tam-7t2-158","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘உவப்பத் தலைக்கூடி உள்ளப் பிரிதல் அனைத்தே புலவர் தொழில்’ - இக்குறட்பாவின்படி கற்றறிந்த புலவர்களின் இயல்பு யாது?"}],"options":[{"key":"A","text":"பொருளீட்டுவதில் முனைப்பு காட்டுதல்"},{"key":"B","text":"கூடும்போது எல்லாரும் மகிழுமாறு பழகுவதும், பிரியும்போது எல்லாரும் நினைத்துப் போற்றுமாறு பிரிவதும்"},{"key":"C","text":"தனிமையில் காலம் கழித்தல்"},{"key":"D","text":"அரசர்களிடம் மட்டுமே பழகுதல்"}],"explanation":"மகிழுமாறு பழகுவதும், மீண்டும் எப்போது காண்போம் என்று நெஞ்சில் நினைக்குமாறு பிரிவதும் புலவரின் பண்பாகும்."}}}
{"id":"b-tam-7t2-159","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘உடையார்முன் இல்லார்போல் ஏக்கற்றும் கற்றார் கடையரே கல்லா தவர்’ - யாரிடம் பணிந்து கற்பவரே உயர்ந்தவர் என வள்ளுவர் கூறுகிறார்?"}],"options":[{"key":"A","text":"அரசரிடம் தலைவணங்குபவர்"},{"key":"B","text":"செல்வர் முன் வறியவர் பணிந்து நிற்பது போல ஆசிரியரிடம் பணிந்து நின்றுக் கற்றவர்"},{"key":"C","text":"பெற்றோரிடம் பணிபவர்"},{"key":"D","text":"மூத்தோரிடம் கேட்பவர்"}],"explanation":"செல்வந்தர் முன் எளியவர் நிற்பது போலக் கற்றவர் முன் பணிவோடு நின்று கற்றவரே உயர்ந்தவர்; கல்லாதவர் இழிந்தவர்."}}}
{"id":"b-tam-7t2-160","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘யாதானும் நாடாமால் ஊராமால் என்னொருவன் சாந்துணையும் கல்லாத வாறு’ - கற்றவனுக்கு எந்நாடும் சொந்த நாடாகும்போது ஒருவன் எந்நாள் வரை கற்காமல் இருப்பது அறியாமை?"}],"options":[{"key":"A","text":"இளமைப் பருவம் வரை"},{"key":"B","text":"சாகும் வரை (சாந்துணையும்)"},{"key":"C","text":"முதுமைப் பருவம் வரை"},{"key":"D","text":"பொருளீட்டும் வரை"}],"explanation":"கற்றவனுக்கு எந்நாடும் சொந்த நாடாகும்; அவ்வாறிருக்க ஒருவன் சாகும் வரையிலும் கல்வி கற்காமல் இருப்பது ஏன் என வியக்கிறார்."}}}
{"id":"b-tam-7t2-161","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஆக்கம் கருதி முதலிழக்கும் செய்வினை ஊக்கார் அறிவுடை யார்’ - அறிவுடையவர்கள் எந்தச் செயலில் ஒருபோதும் ஈடுபட மாட்டார்கள்?"}],"options":[{"key":"A","text":"பயனற்ற சொற்களைப் பேசும் செயலில்"},{"key":"B","text":"பின்வரும் லாபத்தை எதிர்பார்த்து உள்ள முதலையே இழந்துவிடும் ஆபத்தான செயலில்"},{"key":"C","text":"பிறருக்குக் கடன் கொடுக்கும் செயலில்"},{"key":"D","text":"வணிகம் செய்யும் செயலில்"}],"explanation":"வரும் லாபத்தைக் கருதித் தன்னிடம் உள்ள முதலையே இழக்க நேரிடும் செயலில் அறிவுடையோர் இறங்க மாட்டார்கள்."}}}
{"id":"b-tam-7t2-162","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஆற்றின் வருந்தா வருத்தம் பலர்நின்று போற்றினும் பொத்துப் படும்’ - முறையோடு செய்யப்படாத ஒரு முயற்சியின் விளைவு யாது?"}],"options":[{"key":"A","text":"வெற்றி தரும்"},{"key":"B","text":"பலர் துணை நின்று காத்தாலும் ஓட்டைக் குடத்து நீர் போல வீணே அழியும்"},{"key":"C","text":"செல்வம் பெருகும்"},{"key":"D","text":"புகழ் நிலைக்கும்"}],"explanation":"முறையான திட்டமும் வழியும் இல்லாமல் செய்யப்படும் முயற்சி பலர் கூடிப் பாதுகாத்தாலும் பாழாகிவிடும்."}}}
{"id":"b-tam-7t2-163","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பற்றற்ற கண்ணும் பழைமைபா ராட்டுதல் சுற்றத்தார் கண்ணே உள’ - ஒருவன் வறுமையால் செல்வப் பற்றற்று நின்ற காலத்திலும் பழைய உறவைப் பாராட்டும் குணம் யாரிடம் மட்டுமே உண்டு?"}],"options":[{"key":"A","text":"அரசனிடம்"},{"key":"B","text":"உண்மைச் சுற்றத்தாரிடம்"},{"key":"C","text":"அயலாரிடம்"},{"key":"D","text":"வணிகரிடம்"}],"explanation":"பொருள் இல்லாத வறுமை வந்த காலத்திலும் பழைய பாசத்தைப் பாராட்டி நிற்கும் குணம் சுற்றத்தாரிடமே உண்டு."}}}
{"id":"b-tam-7t2-164","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சுற்றத்தால் சுற்றப் படஒழுகல் செல்வம்தான் பெற்றத்தால் பெற்ற பயன்’ - ஒருவன் பெரும் செல்வம் பெற்றதனால் அடையும் உண்மையான பயன் எது?"}],"options":[{"key":"A","text":"மாளிகைகள் கட்டுவது"},{"key":"B","text":"சுற்றத்தார்கள் தன்னைச் சூழ்ந்து மகிழுமாறு அவர்களுக்குக் கொடுத்து உதவுவது"},{"key":"C","text":"அரசாங்கப் பதவிகளைப் பெறுவது"},{"key":"D","text":"நிலங்களை வாங்குவது"}],"explanation":"சுற்றத்தாரைத் தன்னோடு அரவணைத்துக் கொண்டு வாழ்வதே செல்வம் பெற்றதனால் அடையும் தலையாய பயன்."}}}
{"id":"b-tam-7t2-165","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கொடுத்தலும் இன்சொலும் ஆற்றின் அடுக்கிய சுற்றத்தால் சுற்றப் படும்’ - ஒருவனைச் சுற்றத்தார் என்றும் விட்டு விலகாமல் சூழ்ந்து வாழத் தேவையான இரண்டு பண்புகள் எவை?"}],"options":[{"key":"A","text":"வீரமும் கல்வியும்"},{"key":"B","text":"பிறருக்குக் கொடுத்தலும் (கொடை), இன்சொல் பேசுதலும்"},{"key":"C","text":"அதிகாரமும் செல்வமும்"},{"key":"D","text":"அமைதியும் பொறுமையும்"}],"explanation":"தேவைப்படுவோர்க்குக் கொடுத்தலும், இன்முகத்தோடு இன்சொல் கூறுதலும் உடையவனைச் சுற்றத்தார் எப்போதும் சூழ்ந்திருப்பர்."}}}
{"id":"b-tam-7t2-166","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மடிமடிக் கொண்டொழுகும் பேதை பிறந்த குடிமடியும் தன்னினும் முந்து’ - சோம்பலைத் தன் மடியில் கொண்டு வாழும் அறிவற்றவன் பிறந்த குடும்பத்திற்கு என்ன நேரும்?"}],"options":[{"key":"A","text":"செல்வம் குறையும்"},{"key":"B","text":"புகழ் அழியும்"},{"key":"C","text":"அவன் அழிவதற்கு முன்பாகவே அவனது குடும்பமானது அழிந்துவிடும்"},{"key":"D","text":"பகைவர்கள் வெல்வர்"}],"explanation":"சோம்பலை விடாத பேதை அழிவதற்கு முன்பாகவே, அவன் பிறந்த நற்குடி அவனை விட முன்னதாகவே அழிந்துவிடும்."}}}
{"id":"b-tam-7t2-167","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மடிமை குடிமைக்கண் தங்கின்தன் ஒன்னார்க்கு அடிமை புகுத்தி விடும்’ - ஒருவன் குடும்பத்தில் சோம்பல் குடிபுகுந்து விட்டால் அது எங்கு கொண்டு சேர்க்கும்?"}],"options":[{"key":"A","text":"அரசனின் தண்டனைக்கு ஆளாக்கும்"},{"key":"B","text":"தன் பகைவர்க்கே அடிமையாக்கி விடும்"},{"key":"C","text":"நாட்டை விட்டு விரட்டும்"},{"key":"D","text":"நோய்களை உண்டாக்கும்"}],"explanation":"சோம்பல் குடிபுகுந்த குடும்பமானது தன் பகைவர்க்கே அடிமைப்பட்டுத் தலைகுனிய நேரிடும்."}}}
{"id":"b-tam-7t2-168","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மடிஇலா மன்னவன் எய்தும் அடிஅளந்தான் தாஅயது எல்லாம் ஒருங்கு’ - சோம்பல் இல்லாத ஊக்கமுடைய மன்னன் எதனை அடைவான்?"}],"options":[{"key":"A","text":"எட்டாத செல்வங்களை"},{"key":"B","text":"வாமன அவதாரத்தில் திருமால் கால்களால் அளந்த உலகம் முழுவதையும் ஒருங்கே அடைவான்"},{"key":"C","text":"அளவற்ற படைகளை"},{"key":"D","text":"எழுபிறப்பிலும் அழியாப் புகழை"}],"explanation":"மடி இல்லாத சுறுசுறுப்புடைய மன்னன் திருமால் தன் ஓரடியால் அளந்த நிலவுலகம் முழுவதையும் வென்று அடைவான்."}}}
{"id":"b-tam-7t2-169","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 45"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வெள்ளத்து அனைய இடும்பை அறிவுடையான் உள்ளத்தின் உள்ளக் கெடும்’ - வெள்ளம் போல் பெருகி வரும் துன்பமும் அறிவுடையவனின் எதனால் விலகி ஓடும்?"}],"options":[{"key":"A","text":"அவனது படைபலத்தால்"},{"key":"B","text":"மன உறுதியோடு தளராது எதிர்நோக்கும் ஊக்கத்தினால்"},{"key":"C","text":"நண்பர்களின் உதவியால்"},{"key":"D","text":"அரசனின் தயவால்"}],"explanation":"வெள்ளம் போன்ற பெருந்துன்பமும் மனந்தளராத அறிவுடையோனின் திடமான ஊக்கத்தைக் கண்டவுடன் விலகி அழியும்."}}}
{"id":"b-tam-7t2-170","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 45"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அடுக்கி வரினும் அழிவிலான் உற்ற இடுக்கண் இடுக்கண் படும்’ - துன்பங்கள் அடுக்கடுக்காகத் தொடர்ந்து வந்தாலும் மனம் அழியாதவனிடம் நேர்வது யாது?"}],"options":[{"key":"A","text":"அவன் தோற்றுப்போவான்"},{"key":"B","text":"வந்த துன்பமே துன்பப்பட்டுத் தானாக மறைந்துவிடும்"},{"key":"C","text":"அரசன் இரங்குவான்"},{"key":"D","text":"செல்வம் அழியும்"}],"explanation":"துன்பங்கள் ஒன்றன்பின் ஒன்றாக வந்தாலும் மனஉறுதி குன்றாதவனைப் பார்த்தால் வந்த துன்பமே வருந்தி ஓடிவிடும்."}}}
{"id":"b-tam-7t2-171","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 45"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இன்பத்துள் இன்பம் விழையாதான் துன்பத்துள் துன்பம் உறுதல் இலன்’ - இன்பம் வந்த காலத்தில் அளவுக்கு மீறி மகிழாதவன் துன்பம் வந்த காலத்தில் எவ்வாறு இருப்பான்?"}],"options":[{"key":"A","text":"கலங்கி அழுவான்"},{"key":"B","text":"துன்பத்தால் வருந்தாமல் சமநிலையில் இருப்பான்"},{"key":"C","text":"பிறரை நொந்து கொள்வான்"},{"key":"D","text":"நாட்டை விட்டு விலகுவான்"}],"explanation":"மகிழ்ச்சி வந்த போது இன்பத்தை விரும்பாத பக்குவமுடையவன் துன்பம் வந்த காலத்திலும் துயரப்பட மாட்டான்."}}}
{"id":"b-tam-7t2-172","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 2, பக்கம் 45"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இன்னாமை இன்பம் எனக்கொளின் ஆகும்தன் ஒன்னார் விழையுஞ் சிறப்பு’ - இதில் ‘ஒன்னார்’ என்னும் சொல் குறிப்பது யாரை?"}],"options":[{"key":"A","text":"நண்பர்களை"},{"key":"B","text":"பகைவர்களை"},{"key":"C","text":"உறவினர்களை"},{"key":"D","text":"அரசர்களை"}],"explanation":"ஒன்னார் என்றால் பகைவர் என்று பொருள்; துன்பத்தையும் இன்பமாக ஏற்கும் மாண்புடையவனுக்கு அவனது பகைவரும் போற்றும் பெருமை உண்டாகும்."}}}
