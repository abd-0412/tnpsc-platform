// 7-ஆம் வகுப்பு தமிழ் - பருவம் 2 - இயல் 1 - பாடம் 5: இலக்கிய வகைச் சொற்கள் (கற்கண்டு - இலக்கணம்)
// வினாக்கள் எண்ணிக்கை: 18
// ==============================================================================
{"id":"b-tam-7t2-043","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 15"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மொழி, பதம், கிளவி’ என்பன எதனைக் குறிக்கும் வேறு பெயர்களாகும்?"}],"options":[{"key":"A","text":"எழுத்து"},{"key":"B","text":"சொல்"},{"key":"C","text":"வாக்கியம்"},{"key":"D","text":"பொருள்"}],"explanation":"மொழி, பதம், கிளவி என்பன 'சொல்' என்னும் பொருள் தரும் வெவ்வேறு சொற்களாகும்."}}}
{"id":"pyq-tam-7t2-044","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":71},"texts":{"ta":{"blocks":[{"type":"text","text":"இலக்கிய வகையில் சொற்கள் எத்தனை வகைகளாகப் பிரிக்கப்படும்?"}],"options":[{"key":"A","text":"இரண்டு வகைப்படும்"},{"key":"B","text":"நான்கு வகைப்படும் (இயற்சொல், திரிசொல், திசைச்சொல், வடசொல்)"},{"key":"C","text":"ஆறு வகைப்படும்"},{"key":"D","text":"எட்டு வகைப்படும்"}],"explanation":"இலக்கண அடிப்படையில் பெயர், வினை, இடை, உரி; இலக்கிய அடிப்படையில் இயற்சொல், திரிசொல், திசைச்சொல், வடசொல் என 4 வகைப்படும்."}}}
{"id":"b-tam-7t2-045","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 15"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கடல், கப்பல், எழுதினான், படித்தான்’ - இவை போன்று இயல்பாகவே எளிதில் பொருள் விளங்கும் வகையில் அமைந்த சொற்கள் எவை?"}],"options":[{"key":"A","text":"இயற்சொற்கள்"},{"key":"B","text":"திரிசொற்கள்"},{"key":"C","text":"திசைச்சொற்கள்"},{"key":"D","text":"வடசொற்கள்"}],"explanation":"எல்லோருக்கும் எளிதில் பொருள் விளங்கும் சொற்கள் இயற்சொற்கள் எனப்படும்."}}}
{"id":"b-tam-7t2-046","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"4","C":"1","D":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 15"},"texts":{"ta":{"blocks":[{"type":"text","text":"இயற்சொல்லின் நான்கு வகைகளுக்குரிய சான்றுகளைச் சரியாகப் பொருத்துக:"},{"type":"list","name":"இயற்சொல் வகை","items":[{"label":"A","text":"பெயர் இயற்சொல்"},{"label":"B","text":"வினை இயற்சொல்"},{"label":"C","text":"இடை இயற்சொல்"},{"label":"D","text":"உரி இயற்சொல்"}]},{"type":"list","name":"சான்று","items":[{"label":"1","text":"அவனை, அவனால்"},{"label":"2","text":"மாநகர்"},{"label":"3","text":"மண், பொன்"},{"label":"4","text":"நடந்தான், வந்தான்"}]}],"options":[{"key":"A","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"D","text":"A-4, B-3, C-2, D-1","mapping":{"A":"4","B":"3","C":"2","D":"1"}}],"explanation":"மண், பொன் = பெயர் இயற்சொல்; நடந்தான், வந்தான் = வினை இயற்சொல்; அவனை, அவனால் = இடை இயற்சொல்; மாநகர் = உரி இயற்சொல்."}}}
{"id":"b-tam-7t2-047","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 15"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வங்கூழ், அழுவம், சாற்றினான், உறுபயன்’ - இச்சொற்கள் முறையே தரும் பொருள்கள் எவை?"}],"options":[{"key":"A","text":"கடல், காற்று, சென்றான், குறைந்த பயன்"},{"key":"B","text":"காற்று, கடல், சொன்னான், மிகுந்த பயன்"},{"key":"C","text":"மழை, பூமி, பாடினான், நற்பயன்"},{"key":"D","text":"நெருப்பு, ஆகாயம், அழுதான், சிறுபயன்"}],"explanation":"வங்கூழ் = காற்று; அழுவம் = கடல்; சாற்றினான் = சொன்னான்; உறுபயன் = மிகுந்த பயன்."}}}
{"id":"b-tam-7t2-048","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 15"},"texts":{"ta":{"blocks":[{"type":"text","text":"கற்றோர்க்கு மட்டுமே விளங்குவதாகவும் இலக்கியங்களில் மட்டுமே பயின்று வருவதாகவும் அமையும் சொற்கள் எவை?"}],"options":[{"key":"A","text":"இயற்சொற்கள்"},{"key":"B","text":"திரிசொற்கள்"},{"key":"C","text":"திசைச்சொற்கள்"},{"key":"D","text":"வடசொற்கள்"}],"explanation":"கற்றறிந்த புலவர்க்கு மட்டுமே விளங்கும் செய்யுள் சொற்கள் திரிசொற்கள் எனப்படும்."}}}
{"id":"b-tam-7t2-049","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"4","C":"1","D":"3"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 16"},"texts":{"ta":{"blocks":[{"type":"text","text":"திரிசொல்லின் நான்கு வகைகளுக்குரிய சான்றுகளைச் சரியாகப் பொருத்துக:"},{"type":"list","name":"திரிசொல் வகை","items":[{"label":"A","text":"பெயர்த் திரிசொல்"},{"label":"B","text":"வினைத் திரிசொல்"},{"label":"C","text":"இடைத் திரிசொல்"},{"label":"D","text":"உரித் திரிசொல்"}]},{"type":"list","name":"சான்று","items":[{"label":"1","text":"அன்ன, மான"},{"label":"2","text":"அழுவம், வங்கம்"},{"label":"3","text":"கூர், கழி"},{"label":"4","text":"இயம்பினான், பயின்றாள்"}]}],"options":[{"key":"A","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"D","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}}],"explanation":"அழுவம், வங்கம் = பெயர்த் திரிசொல்; இயம்பினான் = வினைத் திரிசொல்; அன்ன, மான = இடைத் திரிசொல்; கூர், கழி = உரித் திரிசொல்."}}}
{"id":"b-tam-7t2-050","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 16"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வங்கம், அம்பி, நாவாய்’ என்பன கப்பல் என்னும் ஒரே பொருளைத் தருவதால் இது எவ்வகைத் திரிசொல் ஆகும்?"}],"options":[{"key":"A","text":"பல பொருள் குறித்த ஒரு திரிசொல்"},{"key":"B","text":"ஒரு பொருள் குறித்த பல திரிசொற்கள்"},{"key":"C","text":"பெயர் இயற்சொல்"},{"key":"D","text":"திசைச்சொல்"}],"explanation":"பல திரிசொற்கள் சேர்ந்து ஒரே பொருளைத் தருவதால் 'ஒரு பொருள் குறித்த பல திரிசொற்கள்' எனப்படும்."}}}
{"id":"b-tam-7t2-051","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 16"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இதழ்’ என்னும் சொல் பூவின் இதழ், உதடு, கண் இமை, பனையேடு, நாளிதழ் ஆகிய பொருள்களைத் தருவதால் இது எவ்வகைத் திரிசொல்?"}],"options":[{"key":"A","text":"ஒரு பொருள் குறித்த பல திரிசொல்"},{"key":"B","text":"பல பொருள் குறித்த ஒரு திரிசொல்"},{"key":"C","text":"வினைத் திரிசொல்"},{"key":"D","text":"வடசொல்"}],"explanation":"ஒரே ஒரு சொல் பல பொருள்களைக் குறித்து வருவதால் 'பல பொருள் குறித்த ஒரு திரிசொல்' எனப்படும்."}}}
{"id":"b-tam-7t2-052","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 16"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சாவி, சன்னல், பண்டிகை, இரயில்’ முதலிய வடமொழி தவிரப் பிற மொழிகளிலிருந்து வந்து தமிழில் வழங்கும் சொற்கள் எவை?"}],"options":[{"key":"A","text":"இயற்சொற்கள்"},{"key":"B","text":"திசைச்சொற்கள்"},{"key":"C","text":"திரிசொற்கள்"},{"key":"D","text":"வடசொற்கள்"}],"explanation":"வடமொழி தவிர பிற மொழிகளிலிருந்து வந்து வழங்கும் சொற்களும், பாண்டிநாடு தவிர பிற தமிழகப் பகுதிச் சொற்களும் திசைச்சொற்கள் எனப்படும்."}}}
{"id":"b-tam-7t2-053","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 16"},"texts":{"ta":{"blocks":[{"type":"text","text":"முற்காலத்தில் பாண்டிநாட்டைத் தவிர, தமிழ்நாட்டின் பிற பகுதிகளில் வழங்கிய ‘கேணி’ மற்றும் ‘பெற்றம்’ ஆகியவற்றின் பொருள்கள் முறையே எவை?"}],"options":[{"key":"A","text":"குளம், காளை"},{"key":"B","text":"கிணறு, பசு"},{"key":"C","text":"ஏரி, ஆடு"},{"key":"D","text":"வயல், எருமை"}],"explanation":"கேணி = கிணறு; பெற்றம் = பசு. இவை பிற பகுதி திசைச்சொற்கள் ஆகும்."}}}
{"id":"b-tam-7t2-054","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 16"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வருடம், மாதம், கமலம், விடம், சக்கரம்’ முதலிய வடமொழியிலிருந்து (சமஸ்கிருதம்) வந்து தமிழில் இடம்பெறும் சொற்கள் எவை?"}],"options":[{"key":"A","text":"திசைச்சொற்கள்"},{"key":"B","text":"வடசொற்கள்"},{"key":"C","text":"திரிசொற்கள்"},{"key":"D","text":"இயற்சொற்கள்"}],"explanation":"வடமொழியிலிருந்து வந்து தமிழில் வழங்கும் சொற்கள் வடசொற்கள் எனப்படும்."}}}
{"id":"pyq-tam-7t2-055","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":83},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கமலம், அலங்காரம்’ என வடமொழியில் இருப்பது போன்றே எவ்வித மாற்றமும் இன்றித் தமிழில் எழுதுவது எவ்வாறு அழைக்கப்படும்?"}],"options":[{"key":"A","text":"தற்பவம்"},{"key":"B","text":"தற்சமம்"},{"key":"C","text":"திசைச்சொல்"},{"key":"D","text":"திரிசொல்"}],"explanation":"வடமொழியில் உள்ளவாறே சமமாகத் தமிழில் எழுதுவது 'தற்சமம்' எனப்படும்."}}}
{"id":"pyq-tam-7t2-056","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":78},"texts":{"ta":{"blocks":[{"type":"text","text":"‘லக்ஷ்மி என்பதை இலக்குமி என்றும், விஷம் என்பதை விடம் என்றும்’ தமிழ் எழுத்துகளால் மாற்றி எழுதுவது எவ்வகை வடசொல்?"}],"options":[{"key":"A","text":"தற்சமம்"},{"key":"B","text":"தற்பவம்"},{"key":"C","text":"திசைச்சொல்"},{"key":"D","text":"திரிசொல்"}],"explanation":"வடமொழி எழுத்துகளை நீக்கித் தமிழ் எழுத்துகளுக்கு ஏற்பத் திரித்து எழுதுவது 'தற்பவம்' எனப்படும்."}}}
{"id":"b-tam-7t2-057","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 17"},"texts":{"ta":{"blocks":[{"type":"text","text":"எல்லார்க்கும் எளிதில் பொருள் விளங்கும் சொல் எது?"}],"options":[{"key":"A","text":"இயற்சொல்"},{"key":"B","text":"திரிசொல்"},{"key":"C","text":"திசைச்சொல்"},{"key":"D","text":"வடசொல்"}],"explanation":"பாடநூல் மதிப்பீட்டு வினா: எளிதில் பொருள் விளங்குவது இயற்சொல்."}}}
{"id":"b-tam-7t2-058","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 17"},"texts":{"ta":{"blocks":[{"type":"text","text":"பலபொருள் தரும் ஒருசொல் என்பது ________ வகையுள் அடங்கும்."}],"options":[{"key":"A","text":"இயற்சொல்"},{"key":"B","text":"திரிசொல்"},{"key":"C","text":"திசைச்சொல்"},{"key":"D","text":"வடசொல்"}],"explanation":"பல பொருள் தரும் ஒரு சொல் என்பது திரிசொல் வகையுள் அடங்கும் (எ.கா: இதழ்)."}}}
{"id":"b-tam-7t2-059","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"4","B":"3","C":"1","D":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 17"},"texts":{"ta":{"blocks":[{"type":"text","text":"சொல் வகைகளை அவற்றுக்குரிய சான்றுகளோடு சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல் வகை","items":[{"label":"A","text":"இயற்சொல்"},{"label":"B","text":"திரிசொல்"},{"label":"C","text":"திசைச்சொல்"},{"label":"D","text":"வடசொல்"}]},{"type":"list","name":"சான்று","items":[{"label":"1","text":"பெற்றம்"},{"label":"2","text":"இரத்தம்"},{"label":"3","text":"அழுவம்"},{"label":"4","text":"சோறு"}]}],"options":[{"key":"A","text":"A-4, B-3, C-1, D-2","mapping":{"A":"4","B":"3","C":"1","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-4, B-1, C-3, D-2","mapping":{"A":"4","B":"1","C":"3","D":"2"}},{"key":"D","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}}],"explanation":"சோறு = இயற்சொல்; அழுவம் = திரிசொல்; பெற்றம் = திசைச்சொல்; இரத்தம் = வடசொல்."}}}
{"id":"b-tam-7t2-068","kind":"assertion_reason","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 16"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"‘சாவி, சன்னல், இரயில்’ என்பன திசைச்சொற்கள் எனப்படுகின்றன."},{"type":"reason","text":"வடமொழி எனப்படும் சமஸ்கிருதம் தவிர்த்து, பிற மொழிகளிலிருந்து தமிழில் வந்து வழங்கும் சொற்கள் திசைச்சொற்கள் எனப்படும்."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"திசைச்சொல் விதியின்படி வடமொழி நீங்கலாகப் பிற மொழியிலிருந்து வந்து வழங்கும் சொற்கள் திசைச்சொற்களாகும்; கூற்றும் காரணமும் சரி."}}}
