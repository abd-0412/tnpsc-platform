// 7-ஆம் வகுப்பு தமிழ் - பருவம் 2 - இயல் 1 - பாடம் 2: தேயிலைத் தோட்டப் பாட்டு (கவிதைப்பேழை - முகம்மது இராவுத்தர்)
// வினாக்கள் எண்ணிக்கை: 12
// ==============================================================================
{"id":"b-tam-7t2-011","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"19-ஆம் நூற்றாண்டில் ஏற்பட்ட பஞ்சத்தின் காரணமாகக் கூலித் தொழிலாளர்களாகத் தமிழர்கள் கப்பலேறிச் சென்ற ஆங்கிலேயக் குடியேற்றத் தீவுகள் எவை?"}],"options":[{"key":"A","text":"மாலத்தீவு, லட்சத்தீவு"},{"key":"B","text":"இலங்கை, அந்தமான் தீவுகள்"},{"key":"C","text":"மடகாஸ்கர், சிஷெல்ஸ்"},{"key":"D","text":"சுமத்ரா, ஜாவா"}],"explanation":"'அக்கரை தேசத்தின் லங்கைத் தீவுக்குள்ளே அந்தமான் தீவு போன்ற இடத்தில்' தேயிலைத் தோட்டத் தொழிலாளர்களாகக் கொண்டு சேர்க்கப்பட்டனர்."}}}
{"id":"b-tam-7t2-012","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 5"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தேயிலைத் தோட்டப் பாட்டு’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"ராஜரீகம்"},{"label":"B","text":"ரட்சித்து"},{"label":"C","text":"அருஞ்சேகரம்"},{"label":"D","text":"பாக்கி"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"காப்பாற்றி"},{"label":"2","text":"ஆட்சிமுறை"},{"label":"3","text":"கடன்"},{"label":"4","text":"அரிய சேமிப்பு"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}}],"explanation":"ராஜரீகம் = ஆட்சிமுறை; ரட்சித்து = காப்பாற்றி; அருஞ்சேகரம் = அரிய சேமிப்பு; பாக்கி = கடன்; பிராணி = விலங்கு; லங்கைத்தீவு = இலங்கை; கட்டுப்பாடு = உறுதி."}}}
{"id":"b-tam-7t2-013","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"தேயிலைத் தோட்டக் கூலித் தொழிலாளர்கள் பெண்டு பிள்ளைகளுடன் எந்தப் பாம்பைப் போல ஒடுங்கி வாழ்ந்து வருவதாகப் பாடல் வரிகள் கூறுகின்றன?"}],"options":[{"key":"A","text":"நல்ல பாம்பு"},{"key":"B","text":"சாரைப் பாம்பு"},{"key":"C","text":"மண்ணுளிப் பாம்பு"},{"key":"D","text":"பச்சைப்பாம்பு"}],"explanation":"'உண்ண உணவுக்கும் உள்ள செலவுக்கும் ஒவ்வொரு நாளும் அரிதாகி - சிறு மண்ணுளிப் பாம்புபோல் பெண்டு பிள்ளையுடன் வாழ்ந்து வருவதைக் காணீரோ!' என விவரிக்கப்பட்டுள்ளது."}}}
{"id":"b-tam-7t2-014","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"இந்தியத் தொழிலாளர்கள் அந்நிய நாட்டில் சென்று இத்தகைய கொடுமைகளை அனுபவிப்பதற்கான அடிப்படைக் காரணமாகப் பாடல் குறிப்பிடுவது எது?"}],"options":[{"key":"A","text":"பணமின்மை மட்டுமே"},{"key":"B","text":"மனதுக்கு ஒப்பிய கல்வி, ஒழுக்கம், நாகரிகம் ஆகியவை இல்லாக் குறை"},{"key":"C","text":"விவசாயத் தொழில் தெரியாமை"},{"key":"D","text":"வானிலை மாறுபாடுகள்"}],"explanation":"'இந்தியர் துன்பப் படுவதற்கு - மனது ஒப்பிய கல்வியொழுக்கம் நாகரீகம் ஒன்றேனும் இல்லாக் குறையெனவே' என்று கவிஞர் கூறுகிறார்."}}}
{"id":"b-tam-7t2-015","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"பாடப்பகுதியில் இடம்பெற்றுள்ள ‘தேயிலைத் தோட்டப் பாட்டு’ பாடலை இயற்றிய ஆசிரியர் யார்?"}],"options":[{"key":"A","text":"கவி கா.மு. ஷெரீப்"},{"key":"B","text":"முகம்மது இராவுத்தர்"},{"key":"C","text":"உமறுப்புலவர்"},{"key":"D","text":"செய்குதம்பிப் பாவலர்"}],"explanation":"இப்பாடலின் ஆசிரியர் முகம்மது இராவுத்தர் ஆவார்."}}}
{"id":"b-tam-7t2-016","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 5"},"texts":{"ta":{"blocks":[{"type":"text","text":"19-ஆம் Centuries இறுதியில் தோன்றிய மக்கள் இலக்கியங்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"மக்கள் வாழ்வில் ஏற்படும் தாக்கங்களைப் பாடல்களாகவும் கதைப்பாடல்களாகவும் வெளியிட்ட சிறுசிறு நூல்கள் வெளியிடப்பட்டன."},{"type":"statement","label":"II","text":"இந்நூல்கள் வெகுசன இலக்கியம், முச்சந்தி இலக்கியம், குஜிலி நூல்கள், பெரிய எழுத்துப் புத்தகங்கள் எனப் பலவாறாக அழைக்கப்பட்டன."},{"type":"statement","label":"III","text":"பாடப்பகுதி ‘பாரத மக்களின் பரிதாபச் சிந்து’ என்ற ‘தேயிலைத் தோட்டப் பாட்டு’ என்னும் நூலிலிருந்து தரப்பட்டுள்ளது."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"நூல் வெளிப் பகுதியின்படி மூன்று கூற்றுகளும் வரலாற்றுத் துல்லியத்துடன் அமைந்த சரியான தகவல்களாகும்."}}}
{"id":"b-tam-7t2-017","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"முற்காலத்தில் இந்திய மக்களுக்கு வருமானம் கொடுத்து அவர்களைக் காப்பாற்றி வந்தவை எவை?"}],"options":[{"key":"A","text":"பற்றுவரவு"},{"key":"B","text":"பன்னாட்டு வணிகம்"},{"key":"C","text":"கைத்தொழில்கள்"},{"key":"D","text":"தேயிலைத் தோட்டங்கள்"}],"explanation":"மக்களுக்கு வருமானம் கொடுத்துக் காப்பாற்றி வந்த கைத்தொழில்களை அந்நியர்கள் சமயம் பார்த்து அழித்தனர்."}}}
{"id":"b-tam-7t2-018","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"முற்காலத்தில் இந்திய மக்கள் அந்நிய நாடுகளில் துன்பப்பட்டதற்குக் காரணமாக அமைந்தது எது?"}],"options":[{"key":"A","text":"விளையாட்டு இன்மை"},{"key":"B","text":"கல்வி இல்லாமை"},{"key":"C","text":"கலைகள் இன்மை"},{"key":"D","text":"இயற்கை வளமின்மை"}],"explanation":"கல்வி, ஒழுக்கம், நாகரிகம் ஆகியவற்றின் இன்மையே தொழிலாளர்களின் இழிநிலைக்கு முதன்மைக் காரணமாக அமைந்தது."}}}
{"id":"b-tam-7t2-019","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நாடெங்கும்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"நா + டெங்கும்"},{"key":"B","text":"நாடு + டெங்கும்"},{"key":"C","text":"நா + எங்கும்"},{"key":"D","text":"நாடு + எங்கும்"}],"explanation":"நாடு + எங்கும் = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'நாடெங்கும்' எனப் புணரும்."}}}
{"id":"b-tam-7t2-020","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘குறை + எனவே’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"குறையெனவே"},{"key":"B","text":"குறைஎனவே"},{"key":"C","text":"குறையனவே"},{"key":"D","text":"குறைவெனவே"}],"explanation":"'இ ஈ ஐ வழி யவ்வும்' விதிப்படி உடம்படுமெய் ய் தோன்றி, 'குறையெனவே' எனப் புணரும்."}}}
{"id":"b-tam-7t2-021","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"கூலித் தொழிலாளர்கள் மீது வெள்ளை முதலாளிகள் எதனை எழுதி வாழ்நாள் முழுவதும் தலைச்சுமையாக்கி வைத்தனர்?"}],"options":[{"key":"A","text":"வரி விதிப்பை"},{"key":"B","text":"ஒன்றுக்குப் பத்து நூறாயிரமாகத் தண்டுமுண்டுமாய்க் கணக்கு எழுதி பாக்கியை (கடனை)"},{"key":"C","text":"நில பத்திரங்களை"},{"key":"D","text":"அடிமை சாசனங்களை"}],"explanation":"தொழிலாளர்கள் மீது ஒன்றுக்குப் பத்தாகப் பொய்க் கணக்கு எழுதி அவர்களைச் சாகும் வரை தலைச்சுமை கடனாளியாக்கினர்."}}}
{"id":"b-tam-7t2-022","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"தொழிலாளர்கள் துன்பம் நீங்கி ஒற்றுமையாக வாழ்வதற்குத் தேயிலைத் தோட்டப் பாட்டு காட்டும் நல்வழி எது?"}],"options":[{"key":"A","text":"ஆயுதம் ஏந்திப் போரிடுவது"},{"key":"B","text":"பிள்ளைகளுக்கெல்லாம் ஏற்றமுள்ள கல்வியைப் புகட்டி நீங்கள் ஒன்றும் குறையில்லா ஒற்றுமையாகவே ஊரில் கட்டுப்பாடு செய்குவீரே"},{"key":"C","text":"பிற நாடுகளுக்குக் குடிபெயர்வது"},{"key":"D","text":"கைத்தொழில்களைக் கைவிடுவது"}],"explanation":"'பிள்ளைகளுக்கெல்லாம் ஏற்றமுள்ள கல்வியைப் புகட்டி நீங்கள் ஒன்றும் குறையில்லா ஒற்றுமையாகவே ஊரில் கட்டுப்பாடு செய்குவீரே' என அறிவுறுத்துகிறது."}}}
