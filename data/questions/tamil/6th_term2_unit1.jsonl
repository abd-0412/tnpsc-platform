// ==============================================================================
// பாடம் 1: ஆசாரக்கோவை (கவிதைப்பேழை - பெருவாயின் முள்ளியார்) [Q001 - Q008]
// ஒப்புரவு, நல்லொழுக்க விதைகள் (8), நட்டல், வண்கயத்தூர், 100 வெண்பாக்கள், புணர்ச்சி
// ==============================================================================
{"id": "b-tam-6t2-001", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 2"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஆசாரக்கோவை பாடலில் இடம்பெற்றுள்ள ‘ஒப்புரவு’ என்னும் சொல்லின் பொருள் யாது?"}], "options": [{"key": "A", "text": "பிறர் செய்த உதவியை மறவாமை"}, {"key": "B", "text": "எல்லோரையும் சமமாகப் பேணுதல்"}, {"key": "C", "text": "நற்பண்புடையவரோடு நட்புக் கொள்ளுதல்"}, {"key": "D", "text": "பிறர் செய்யும் தீமைகளைப் பொறுத்துக் கொள்ளுதல்"}], "explanation": "ஆசாரக்கோவை சொல்லும் பொருளும் பகுதியில் 'ஒப்புரவு' என்பது 'எல்லோரையும் சமமாகப் பேணுதல்' எனக் குறிப்பிடப்பட்டுள்ளது."}}}
{"id": "b-tam-6t2-002", "kind": "statements", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": false}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 2"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஆசாரக்கோவை குறிப்பிடும் நல்லொழுக்க விதைகள் தொடர்பான பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "பிறர் செய்த உதவியை மறவாதிருத்தல் மற்றும் பிறர் செய்யும் தீமைகளைப் பொறுத்துக் கொள்ளுதல் நல்லொழுக்க வித்துகள் ஆகும்."}, {"type": "statement", "label": "II", "text": "இனிய சொற்களைப் பேசுதல் மற்றும் எவ்வுயிர்க்கும் துன்பம் செய்யாதிருத்தல் நல்லொழுக்க வித்துகள் ஆகும்."}, {"type": "statement", "label": "III", "text": "ஆசாரக்கோவை மொத்தம் பத்து நல்லொழுக்க விதைகளைக் குறிப்பிடுகிறது."}], "options": [{"key": "A", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "B", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "C", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "கூற்றுகள் I மற்றும் II சரி. ஆசாரக்கோவை நல்லொழுக்கத்தின் விதைகளாக மொத்தம் எட்டு நற்பண்புகளைக் குறிப்பிடுகிறது (இவையெட்டும் சொல்லிய ஆசார வித்து); பத்து அல்ல."}}}
{"id": "b-tam-6t2-003", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "3", "B": "1", "C": "4", "D": "2"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 2"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஆசாரக்கோவை நூலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "சொல்", "items": [{"label": "A", "text": "நன்றியறிதல்"}, {"label": "B", "text": "ஒப்புரவு"}, {"label": "C", "text": "நட்டல்"}, {"label": "D", "text": "பொறை"}]}, {"type": "list", "name": "பொருள்", "items": [{"label": "1", "text": "எல்லோரையும் சமமாகப் பேணுதல்"}, {"label": "2", "text": "பொறுமை"}, {"label": "3", "text": "பிறர் செய்த உதவியை மறவாமை"}, {"label": "4", "text": "நட்புக் கொள்ளுதல்"}]}], "options": [{"key": "A", "text": "A-3, B-1, C-4, D-2", "mapping": {"A": "3", "B": "1", "C": "4", "D": "2"}}, {"key": "B", "text": "A-1, B-3, C-2, D-4", "mapping": {"A": "1", "B": "3", "C": "2", "D": "4"}}, {"key": "C", "text": "A-3, B-4, C-1, D-2", "mapping": {"A": "3", "B": "4", "C": "1", "D": "2"}}, {"key": "D", "text": "A-4, B-1, C-2, D-3", "mapping": {"A": "4", "B": "1", "C": "2", "D": "3"}}], "explanation": "நன்றியறிதல் = பிறர் செய்த உதவியை மறவாமை; ஒப்புரவு = எல்லோரையும் சமமாகப் பேணுதல்; நட்டல் = நட்புக் கொள்ளுதல்; பொறை = பொறுமை."}}}
{"id": "b-tam-6t2-004", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 2"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஆசாரக்கோவையின் ஆசிரியர் பெருவாயின் முள்ளியார் பிறந்த ஊர் எது?"}], "options": [{"key": "A", "text": "வண்கயத்தூர்"}, {"key": "B", "text": "இடலாக்குடி"}, {"key": "C", "text": "செங்கப்படுத்தான்காடு"}, {"key": "D", "text": "மோகனூர்"}], "explanation": "ஆசாரக்கோவையின் ஆசிரியர் பெருவாயின் முள்ளியார் பிறந்த ஊர் வண்கயத்தூர் ஆகும்."}}}
{"id": "b-tam-6t2-005", "kind": "statements", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 2"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஆசாரக்கோவை நூல் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "ஆசாரக்கோவை என்பதற்கு 'நல்ல ஒழுக்கங்களின் தொகுப்பு' என்பது பொருள்."}, {"type": "statement", "label": "II", "text": "இந்நூல் பதினெண்கீழ்க்கணக்கு நூல்களுள் ஒன்றாகும்."}, {"type": "statement", "label": "III", "text": "இந்நூல் நூறு வெண்பாக்களைக் கொண்டது."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "C", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "மூன்று கூற்றுகளும் சரியானவை. ஆசாரக்கோவை = நல்ல ஒழுக்கங்களின் தொகுப்பு; பதினெண்கீழ்க்கணக்கு நூல்; 100 வெண்பாக்களை உடையது."}}}
{"id": "b-tam-6t2-006", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 2"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘நன்றியறிதல் பொறையுடைமை இன்சொல்லோடு... நல்லினத் தாரோடு நட்டல் - இவையெட்டும்...’ - இவ்வடிகளில் அமைந்துள்ள தொடை நயம் யாது?"}], "options": [{"key": "A", "text": "மோனைத்தொடை"}, {"key": "B", "text": "எதுகைத்தொடை"}, {"key": "C", "text": "இயைபுத்தொடை"}, {"key": "D", "text": "முரண்டொடை"}], "explanation": "அடிகளின் முதலெழுத்து அளவொத்து நிற்க, இரண்டாம் எழுத்து 'ன் / ல்' ஒன்றி அமைவதால் இது எதுகைத்தொடை ஆகும்."}}}
{"id": "b-tam-6t2-007", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "D", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 3"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பொறையுடைமை’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}], "options": [{"key": "A", "text": "பொறுமை + உடைமை"}, {"key": "B", "text": "பொறை + யுடைமை"}, {"key": "C", "text": "பொறு + யுடைமை"}, {"key": "D", "text": "பொறை + உடைமை"}], "explanation": "பொறை + உடைமை = பொறையுடைமை ('இ ஈ ஐ வழி யவ்வும்' விதிப்படி உடம்படுமெய் ய் தோன்றிப் புணர்ந்தது)."}}}
{"id": "b-tam-6t2-008", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 3"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘இவை + எட்டும்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}], "options": [{"key": "A", "text": "இவை எட்டும்"}, {"key": "B", "text": "இவையெட்டும்"}, {"key": "C", "text": "இவ்வெட்டும்"}, {"key": "D", "text": "இவ்எட்டும்"}], "explanation": "இவை + எட்டும் = இவையெட்டும் (உடம்படுமெய் 'ய்' தோன்றி புணர்ந்தது)."}}}

// ==============================================================================
// பாடம் 2: கண்மணியே கண்ணுறங்கு (நாட்டுப்புறப் பாடல் / தாலாட்டு) [Q009 - Q016]
// முத்தேன், மூவேந்தர் சிறப்புகள், தால்+ஆட்டு, நந்தவனம், சோழ நாடு, வாழையிலை
// ==============================================================================
{"id": "b-tam-6t2-009", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": true, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கண்மணியே கண்ணுறங்கு தாலாட்டுப் பாடலில் இடம்பெற்றுள்ள சொற்பொருள்களுள் தவறான இணையைத் தேர்வு செய்க:"}], "options": [{"key": "A", "text": "நந்தவனம் - பூஞ்சோலை"}, {"key": "B", "text": "பண் - இசை"}, {"key": "C", "text": "பார் - உலகம்"}, {"key": "D", "text": "இழைத்து - இழந்து"}], "explanation": "'இழைத்து' என்பதன் பொருள் 'பதித்து' (தங்கத்தில் பூ பதித்து) என்பதாகும்; இழந்து என்பது தவறு."}}}
{"id": "b-tam-6t2-010", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தாலாட்டுப் பாடலில் இடம்பெற்றுள்ள ‘முத்தேன்’ என்னும் தொகைச்சொல்லின் சரியான விளக்கம் எது?"}], "options": [{"key": "A", "text": "கொம்புத்தேன், மலைத்தேன், கொசுத்தேன்"}, {"key": "B", "text": "மரத்தேன், மனைத்தேன், மலர்த்தேன்"}, {"key": "C", "text": "பாறைத்தேன், காட்டுத்தேன், பூத்தேன்"}, {"key": "D", "text": "செந்தேன், கொம்புத்தேன், மலைத்தேன்"}], "explanation": "முத்தேன் என்பது கொம்புத்தேன், மலைத்தேன், கொசுத்தேன் ஆகியவற்றைக் குறிக்கும்."}}}
{"id": "b-tam-6t2-011", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "3", "B": "1", "C": "2"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கண்மணியே கண்ணுறங்கு பாடலில் குழந்தையை மூவேந்தர் நாட்டுச் சிறப்புகளோடு தாய் ஒப்பிடுவதைச் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "நாடு", "items": [{"label": "A", "text": "சேர நாடு"}, {"label": "B", "text": "சோழ நாடு"}, {"label": "C", "text": "பாண்டி நாடு"}]}, {"type": "list", "name": "சிறப்பு", "items": [{"label": "1", "text": "முக்கனி (சுவையான விருந்து)"}, {"label": "2", "text": "முத்தமிழ் (குளம் வெட்டி, அணை கட்டிப் பசி போக்கல்)"}, {"label": "3", "text": "முத்தேன் (தந்தத் தொட்டில், தங்கப் பூ)"}]}], "options": [{"key": "A", "text": "A-3, B-1, C-2", "mapping": {"A": "3", "B": "1", "C": "2"}}, {"key": "B", "text": "A-1, B-2, C-3", "mapping": {"A": "1", "B": "2", "C": "3"}}, {"key": "C", "text": "A-2, B-3, C-1", "mapping": {"A": "2", "B": "3", "C": "1"}}, {"key": "D", "text": "A-3, B-2, C-1", "mapping": {"A": "3", "B": "2", "C": "1"}}], "explanation": "சேர நாட்டு முத்தேன், சோழ நாட்டு முக்கனி, பாண்டி நாட்டு முத்தமிழ் எனத் தாய் பாராட்டுகிறாள்."}}}
{"id": "b-tam-6t2-012", "kind": "statements", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 5"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தாலாட்டுப் பாடல் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "தாலாட்டு வாய்மொழி இலக்கியங்களுள் ஒன்றாகும்."}, {"type": "statement", "label": "II", "text": "'தால்' என்பதற்கு 'நாக்கு' என்று பொருள்."}, {"type": "statement", "label": "III", "text": "நாக்கை அசைத்துப் பாடுவதால் தாலாட்டு (தால் + ஆட்டு) என்று பெயர்பெற்றது."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "C", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "கொடுக்கப்பட்டுள்ள மூன்று கூற்றுகளும் சரியானவை. தால் = நாக்கு; நாக்கை அசைத்துப் பாடுவதால் தாலாட்டு எனப்படும்."}}}
{"id": "b-tam-6t2-013", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 5"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘வாழை + இலை’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}], "options": [{"key": "A", "text": "வாழையிலை"}, {"key": "B", "text": "வாழைஇலை"}, {"key": "C", "text": "வாழைலை"}, {"key": "D", "text": "வாழிலை"}], "explanation": "வாழை + இலை = வாழையிலை ('இ ஈ ஐ வழி யவ்வும்' விதிப்படி உடம்படுமெய் 'ய்' தோன்றி வாழையிலை எனப் புணரும்)."}}}
{"id": "b-tam-6t2-014", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 5"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘உதித்த’ என்ற சொல்லிற்குரிய எதிர்ச்சொல் யாது?"}], "options": [{"key": "A", "text": "மறைந்த"}, {"key": "B", "text": "நிறைந்த"}, {"key": "C", "text": "குறைந்த"}, {"key": "D", "text": "தோன்றிய"}], "explanation": "உதித்த என்றால் தோன்றிய என்று பொருள்; எனவே அதன் எதிர்ச்சொல் 'மறைந்த' ஆகும்."}}}
{"id": "b-tam-6t2-015", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘நந்தவனம் கண் திறந்து நற்றமிழ்ப் பூ எடுத்து...’ - இவ்வடியில் பயின்று வந்துள்ள மோனைச் சொற்கள் எவை?"}], "options": [{"key": "A", "text": "நந்தவனம் - நற்றமிழ்"}, {"key": "B", "text": "கண் - திறந்து"}, {"key": "C", "text": "பூ - எடுத்து"}, {"key": "D", "text": "நந்தவனம் - எடுத்து"}], "explanation": "சீர்களின் முதல் எழுத்து 'ந' ஒன்றி வருவதால் நந்தவனம் - நற்றமிழ் என்பது மோனை நயம் ஆகும்."}}}
{"id": "b-tam-6t2-016", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 4"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "வாழை இலை பரப்பி வந்தாரை இன்முகத்தோடு உபசரித்து அறுசுவை விருந்து வைக்கும் நாடாகத் தாலாட்டுப் பாடல் எதனைக் கூறுகிறது?"}], "options": [{"key": "A", "text": "சேர நாடு"}, {"key": "B", "text": "சோழ நாடு"}, {"key": "C", "text": "பாண்டிய நாடு"}, {"key": "D", "text": "பல்லவ நாடு"}], "explanation": "'வாழை இலை பரப்பி வந்தாரைக் கை அமர்த்திச் சுவையான விருந்து வைக்கும் சோழநாட்டு முக்கனியோ!' என சோழ நாட்டைக் குறிப்பிடுகிறது."}}}

// ==============================================================================
// பாடம் 3: தமிழர் பெருவிழா (உரைநடை உலகம்) [Q017 - Q032]
// ஆடி விதைப்பு - தை அறுவடை, போகி / இந்திர விழா, திருவள்ளுவர் ஆண்டு/நாள், மாடு=செல்வம்,
// மஞ்சுவிரட்டு/ஜல்லிக்கட்டு, லோரி, உத்தராயன், மகர சங்கராந்தி, காணும் பொங்கல்
// ==============================================================================
{"id": "b-tam-6t2-017", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 6"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "உழவர்கள் எந்த மாதத்தில் பயிர் விதைத்து, எந்த மாதத்தில் அறுவடை செய்து பயன் அடைவர்?"}], "options": [{"key": "A", "text": "சித்திரையில் விதைத்து, கார்த்திகையில் அறுவடை செய்வர்"}, {"key": "B", "text": "ஆடித்திanglesில் விதைத்து, தைத்திங்களில் அறுவடை செய்வர்"}, {"key": "C", "text": "வைகாசியில் விதைத்து, தையில் அறுவடை செய்வர்"}, {"key": "D", "text": "ஆவணியில் விதைத்து, பங்குனியில் அறுவடை செய்வர்"}], "explanation": "உழவர்கள் ஆடித்திங்களில் விதைப்பர்; தைத்திங்களில் அறுவடை செய்து பயனடைவர்."}}}
{"id": "b-tam-6t2-018", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 7"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பழையன கழிதலும் புதியன புகுதலும்’ - என்ற பாடல் வரி இடம்பெற்றுள்ள இலக்கண நூல் மற்றும் நூற்பா எண் எது?"}], "options": [{"key": "A", "text": "தொல்காப்பியம் (நூற்பா 120)"}, {"key": "B", "text": "நன்னூல் (நூற்பா 462)"}, {"key": "C", "text": "அகத்தியம் (நூற்பா 50)"}, {"key": "D", "text": "வீரசோழியம் (நூற்பா 180)"}], "explanation": "'பழையன கழிதலும் புதியன புகுதலும்' என்பது நன்னூல் நூற்பா 462-ல் இடம்பெற்றுள்ள ஆன்றோர் மொழி."}}}
{"id": "b-tam-6t2-019", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 7"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "வாழ்க்கைக்கு வளம் தரும் மழைக் கடவுளை வழிபடும் நோக்கில் அக்காலத்தில் போகிப்பண்டிகை எவ்வாறு கொண்டாடப்பட்டது?"}], "options": [{"key": "A", "text": "வருண விழா"}, {"key": "B", "text": "இந்திர விழா"}, {"key": "C", "text": "காமன் விழா"}, {"key": "D", "text": "கதிரவன் விழா"}], "explanation": "மழைக்கடவுளான இந்திரனை வழிபடும் நோக்கில் அக்காலத்தில் போகிப்பண்டிகை 'இந்திர விழாவாகக்' கொண்டாடப்பட்டது."}}}
{"id": "b-tam-6t2-020", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 7"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பொங்கல்’ என்னும் சொல்லின் பொருள் யாது?"}], "options": [{"key": "A", "text": "இனிமையான உணவு"}, {"key": "B", "text": "பொங்கிப் பெருகி வருவது"}, {"key": "C", "text": "அறுவடை தானியம்"}, {"key": "D", "text": "மங்கலப் பொருள்"}], "explanation": "பொங்கல் என்பதற்குப் 'பொங்கிப் பெருகி வருவது' என்று பொருள்."}}}
{"id": "pyq-tam-6t2-021", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 14}, "texts": {"ta": {"blocks": [{"type": "text", "text": "திருவள்ளுவர் ஆண்டு மற்றும் திருவள்ளுவர் நாள் கொண்டாடப்படும் சரியான நாள்கள் எவை?"}], "options": [{"key": "A", "text": "தை முதல் நாளில் திருவள்ளுவராண்டு தொடங்குகிறது; தை இரண்டாம் நாள் திருவள்ளுவர் நாள் கொண்டாடப்படுகிறது."}, {"key": "B", "text": "தை முதல் நாளில் திருவள்ளுவர் நாள்; தை இரண்டாம் நாளில் திருவள்ளுவராண்டு தொடங்குகிறது."}, {"key": "C", "text": "மார்கழி இறுதி நாளில் திருவள்ளுவராண்டு தொடங்குகிறது; தை முதல் நாள் திருவள்ளுவர் நாள்."}, {"key": "D", "text": "சித்திரை முதல் நாளில் திருவள்ளுவராண்டு தொடங்குகிறது; தை முதல் நாள் திருவள்ளுவர் நாள்."}], "explanation": "தை முதல் நாளில் திருவள்ளுவர் ஆண்டு தொடங்குகிறது; தை இரண்டாம் நாள் திருவள்ளுவர் நாளாகக் கொண்டாடப்படுகிறது."}}}
{"id": "pyq-tam-6t2-022", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 27}, "texts": {"ta": {"blocks": [{"type": "text", "text": "திருவள்ளுவர் பிறந்த ஆண்டாக ஏற்றுக்கொள்ளப்பட்டுள்ள காலம் மற்றும் திருவள்ளுவராண்டைக் கணக்கிடும் முறை யாது?"}], "options": [{"key": "A", "text": "கி.பி 31; நடைமுறை ஆண்டிலிருந்து 31-ஐக் கழிக்க வேண்டும்"}, {"key": "B", "text": "கி.மு (பொ.ஆ.மு) 31; நடைமுறை ஆண்டுடன் 31-ஐக் கூட்டிக் கொள்ள வேண்டும்"}, {"key": "C", "text": "கி.மு 50; நடைமுறை ஆண்டுடன் 50-ஐக் கூட்டிக் கொள்ள வேண்டும்"}, {"key": "D", "text": "கி.பி 1; நடைமுறை ஆண்டுடன் 1-ஐக் கூட்டிக் கொள்ள வேண்டும்"}], "explanation": "திருவள்ளுவர் கி.மு 31-ல் பிறந்தவர் என்பதால், நடைமுறை ஆண்டுடன் 31-ஐக் கூட்ட வேண்டும்."}}}
{"id": "b-tam-6t2-023", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 7"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘மாடு’ என்ற சொல்லுக்கு உள்ள மற்றொரு சிறப்புப் பொருள் யாது?"}], "options": [{"key": "A", "text": "உயிரினம்"}, {"key": "B", "text": "செல்வம்"}, {"key": "C", "text": "உழைப்பு"}, {"key": "D", "text": "வீரம்"}], "explanation": "'மாடு' என்ற சொல்லுக்குச் 'செல்வம்' என்னும் பொருளும் உண்டு."}}}
{"id": "b-tam-6t2-024", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": true, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 8"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "மாடுகளை அடக்கித் தழுவும் வீர விளையாட்டான மஞ்சுவிரட்டின் வேறு பெயர்களுள் பொருந்தாத ஒன்று எது?"}], "options": [{"key": "A", "text": "மாடுபிடித்தல்"}, {"key": "B", "text": "ஜல்லிக்கட்டு"}, {"key": "C", "text": "ஏறுதழுவுதல்"}, {"key": "D", "text": "வேலிவிரட்டு"}], "explanation": "மஞ்சுவிரட்டு என்பது மாடுபிடித்தல், ஜல்லிக்கட்டு, ஏறுதழுவுதல் என்றும் அழைக்கப்படுகிறது; வேலிவிரட்டு என்பது பொருந்தாது."}}}
{"id": "b-tam-6t2-025", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 8"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "அறுவடைத் திருநாள் பஞ்சாப் மாநிலத்தில் எந்தப் பெயரில் கொண்டாடப்படுகிறது?"}], "options": [{"key": "A", "text": "மகர சங்கராந்தி"}, {"key": "B", "text": "லோரி"}, {"key": "C", "text": "உத்தராயன்"}, {"key": "D", "text": "பைசாகி"}], "explanation": "அறுவடைத் திருநாள் பஞ்சாப் மாநிலத்தில் 'லோரி' என்ற பெயரில் கொண்டாடப்படுகிறது."}}}
{"id": "b-tam-6t2-026", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 8"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "குஜராத் மற்றும் இராஜஸ்தான் மாநிலங்களில் அறுவடைத் திருநாள் எவ்வாறு கொண்டாடப்படுகிறது?"}], "options": [{"key": "A", "text": "மகர சங்கராந்தி"}, {"key": "B", "text": "லோரி"}, {"key": "C", "text": "உத்தராயன்"}, {"key": "D", "text": "பொங்கல்"}], "explanation": "குஜராத், இராஜஸ்தான் மாநிலங்களில் அறுவடைத் திருநாள் 'உத்தராயன்' என்று கொண்டாடப்படுகிறது."}}}
{"id": "b-tam-6t2-027", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "2", "B": "3", "C": "1"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 8"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "அறுவடைத் திருநாள் கொண்டாடப்படும் மாநிலங்களையும் அவற்றின் திருவிழாப் பெயர்களையும் பொருத்துக:"}, {"type": "list", "name": "மாநிலங்கள்", "items": [{"label": "A", "text": "ஆந்திரா, கர்நாடகா, உ.பி"}, {"label": "B", "text": "பஞ்சாப்"}, {"label": "C", "text": "குஜராத், இராஜஸ்தான்"}]}, {"type": "list", "name": "திருவிழாப் பெயர்", "items": [{"label": "1", "text": "உத்தராயன்"}, {"label": "2", "text": "மகர சங்கராந்தி"}, {"label": "3", "text": "லோரி"}]}], "options": [{"key": "A", "text": "A-2, B-3, C-1", "mapping": {"A": "2", "B": "3", "C": "1"}}, {"key": "B", "text": "A-1, B-2, C-3", "mapping": {"A": "1", "B": "2", "C": "3"}}, {"key": "C", "text": "A-3, B-1, C-2", "mapping": {"A": "3", "B": "1", "C": "2"}}, {"key": "D", "text": "A-2, B-1, C-3", "mapping": {"A": "2", "B": "1", "C": "3"}}], "explanation": "ஆந்திரா, கர்நாடகா, மராட்டியம், உத்திரப் பிரதேசம் - மகர சங்கராந்தி; பஞ்சாப் - லோரி; குஜராத், இராஜஸ்தான் - உத்தராயன்."}}}
{"id": "b-tam-6t2-028", "kind": "assertion_reason", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "assertion_reason", "a_true": true, "r_true": true, "r_explains_a": true}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 8"}, "texts": {"ta": {"blocks": [{"type": "assertion", "text": "மாட்டுப் பொங்கலுக்கு அடுத்த நாள் காணும் பொங்கல் கொண்டாடப்படுகிறது."}, {"type": "reason", "text": "இந்நாளில் மக்கள் உற்றார் உறவினர் மற்றும் நண்பர் வீடுகளுக்குச் சென்று கண்டு மகிழ்வதோடு கலைநிகழ்ச்சிகளையும் விளையாட்டுப் போட்டிகளையும் நடத்துவர்."}], "options": [{"key": "A", "text": "(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்", "semantic": "both_true_explains"}, {"key": "B", "text": "(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல", "semantic": "both_true_not_explains"}, {"key": "C", "text": "(A) சரி ஆனால் (R) தவறு", "semantic": "a_true_r_false"}, {"key": "D", "text": "(A) தவறு ஆனால் (R) சரி", "semantic": "a_false_r_true"}], "explanation": "மாட்டுப் பொங்கலுக்கு அடுத்த நாள் உறவினர்களைக் கண்டு மகிழும் நாளாக அமைவதால் அது காணும் பொங்கல் எனப்படுகிறது."}}}
{"id": "b-tam-6t2-029", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 9"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பொங்கல் + அன்று’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}], "options": [{"key": "A", "text": "பொங்கலன்று"}, {"key": "B", "text": "பொங்கல் அன்று"}, {"key": "C", "text": "பொங்கலென்று"}, {"key": "D", "text": "பொங்கஅன்று"}], "explanation": "உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி (ல் + அ = ல) பொங்கலன்று எனப் புணரும்."}}}
{"id": "b-tam-6t2-030", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 9"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘போகிப்பண்டிகை’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}], "options": [{"key": "A", "text": "போகி + பண்டிகை"}, {"key": "B", "text": "போ + பண்டிகை"}, {"key": "C", "text": "போகு + பண்டிகை"}, {"key": "D", "text": "போகிப் + பண்டிகை"}], "explanation": "போகி + பண்டிகை = போகிப்பண்டிகை (இயல்பினும் விதியினும் நின்ற உயிர்முன் கசதப மிகும் விதிப்படி 'ப்' மிகுந்தது)."}}}
{"id": "b-tam-6t2-031", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 9"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பச்சைப் பசேல் என்ற வயலைக் காண இன்பம் தரும்; பட்டுப்போன மரத்தைக் காண ________ தரும்."}], "options": [{"key": "A", "text": "அயர்வு"}, {"key": "B", "text": "கனவு"}, {"key": "C", "text": "துன்பம்"}, {"key": "D", "text": "சோர்வு"}], "explanation": "பச்சைப்பசேல் என்ற வயல் இன்பம் தரும்; பட்டுப்போன மரம் துன்பம் தரும்."}}}
{"id": "b-tam-6t2-032", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 6"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பொங்கல் திருநாள் எத்தனை நாள்கள் முதல் எத்தனை நாள்கள் வரை வட்டாரத்திற்கு ஏற்பக் கொண்டாடப்படுகிறது?"}], "options": [{"key": "A", "text": "ஒரு நாள் முதல் இரண்டு நாள்கள் வரை"}, {"key": "B", "text": "இரண்டு நாள்கள் முதல் நான்கு நாள்கள் வரை"}, {"key": "C", "text": "மூன்று நாள்கள் முதல் ஐந்து நாள்கள் வரை"}, {"key": "D", "text": "நான்கு நாள்கள் முதல் ஏழு நாள்கள் வரை"}], "explanation": "பொங்கல் திருநாள் வட்டாரத்திற்கு ஏற்ப இரண்டு நாள்கள் முதல் நான்கு நாள்கள் வரை கொண்டாடப்படுகிறது."}}}

// ==============================================================================
// பாடம் 4: அறிவுசால் ஔவையார் (விரிவானம் - நாடகம்) [Q033 - Q040]
// அதியமான் - ஔவையார் நெல்லிக்கனி, தொண்டைமான் படைக்கலக் கொட்டில், உலைக்கள ஆயுதங்கள், வஞ்சப்புகழ்ச்சியணி
// ==============================================================================
{"id": "b-tam-6t2-033", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 10"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அறிவுசால் ஔவையார்’ நாடகத்தில் மலையுச்சியில் இருந்த அரிதான நெல்லிக்கனியைத் தான் உண்ணாமல் ஔவையாருக்குக் கொடுத்து மகிழ்ந்த மன்னன் யார்?"}], "options": [{"key": "A", "text": "தொண்டைமான்"}, {"key": "B", "text": "அதியமான் நெடுமான் அஞ்சி"}, {"key": "C", "text": "பாரி"}, {"key": "D", "text": "பேகன்"}], "explanation": "அதியமான் நெடுமான் அஞ்சி தான் பெற்ற சாகா மூவாப் பேராற்றல் கொண்ட அருநெல்லிக்கனியைத் தான் உண்ணாமல் ஔவைக்கு அளித்தார்."}}}
{"id": "b-tam-6t2-034", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 11"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘சிறியிலை நெல்லித் தீங்கனி குறியாது ஆதல் நின்னகத்து அடக்கிச் சாதல் நீங்க எமக்கீந் தனையே’ - இவ்வடிகளை அதியமானைப் போற்றிப் பாடியவர் யார்?"}], "options": [{"key": "A", "text": "காக்கை பாடினியார்"}, {"key": "B", "text": "ஔவையார்"}, {"key": "C", "text": "வெள்ளிவீதியார்"}, {"key": "D", "text": "நச்செள்ளையார்"}], "explanation": "அதியமானின் கொடைத்தன்மையை வியந்து ஔவையார் பாடிய சங்கப் பாடல் அடி இதுவாகும்."}}}
{"id": "b-tam-6t2-035", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 11"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "அதியமானின் நாட்டின் மீது படையெடுத்து வர ஏற்பாடு செய்திருந்த பகை மன்னன் யார்?"}], "options": [{"key": "A", "text": "சேரன் செங்குட்டுவன்"}, {"key": "B", "text": "தொண்டைமான்"}, {"key": "C", "text": "நெடுஞ்செழியன்"}, {"key": "D", "text": "இளஞ்சேட்சென்னி"}], "explanation": "அதியமானோடு பகைமை கொண்டு போர் தொடுக்கத் திட்டமிட்டவன் காஞ்சியை ஆண்ட மன்னன் தொண்டைமான் ஆவான்."}}}
{"id": "b-tam-6t2-036", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 11"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "நீராடும் இடத்தில் சிறுவர்கள் மீது விளையாடும் யானை போலப் புலவர்களிடம் பணிவாகவும், போர்க்களத்தில் பகைவரை வெருண்டோடச் செய்வது போலவும் விளங்குபவன் யார் என ஔவையார் குறிப்பிடுகிறார்?"}], "options": [{"key": "A", "text": "தொண்டைமான்"}, {"key": "B", "text": "அதியமான்"}, {"key": "C", "text": "படைத்தலைவர்"}, {"key": "D", "text": "அமைச்சர்"}], "explanation": "அதியமானின் ஈரத்தையும் வீரத்தையும் யானையின் தன்மையோடு உவமித்து ஔவையார் போற்றுகிறார்."}}}
{"id": "b-tam-6t2-037", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 13"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தொண்டைமானின் படைக்கலக் கொட்டிலில் இருந்த ஆயுதங்கள் எவ்வாறு காட்சியளித்ததாக ஔவையார் கூறுகிறார்?"}], "options": [{"key": "A", "text": "நுனி ஒடிந்தும் கூர் மழுங்கியும் கொல்லனின் உலைக்களத்தில் கிடந்தன"}, {"key": "B", "text": "புத்தம்புதியனவாக, நெய் பூசப்பெற்று, மாலையும் மயில்தோகைகளும் அணிவிக்கப்பட்டு எழிலாகக் காட்சியளித்தன"}, {"key": "C", "text": "துருப்பிடித்து மண்ணில் புதைந்து கிடந்தன"}, {"key": "D", "text": "போர்க்களத்தில் உடைந்த நிலையில் குவிக்கப்பட்டிருந்தன"}], "explanation": "தொண்டைமான் இதுவரை போரே கண்டிராததால் அவனது ஆயுதங்கள் நெய் பூசி, மாலை சூட்டப்பட்டுப் பளபளப்பாகப் படைக்கலக் கொட்டிலில் இருந்தன."}}}
{"id": "b-tam-6t2-038", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 13"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "அதியமானின் போர்க்கருவிகள் எங்கு எந்நிலையில் கிடப்பதாக ஔவையார் தொண்டைமானிடம் நுட்பமாகக் குறிப்பிட்டார்?"}], "options": [{"key": "A", "text": "அரண்மனையில் பூட்டி வைக்கப்பட்டிருந்தன"}, {"key": "B", "text": "பகைவர் உடலைத் துளைத்த குருதிக்கறைகளுடன் நுனி ஒடிந்தும் கூர் மழுங்கியும் கொல்லனின் உலைக்களத்தில் கிடக்கின்றன"}, {"key": "C", "text": "கடலில் வீசப்பட்டுக் கிடந்தன"}, {"key": "D", "text": "மயில்தோகையுடன் மாளிகையில் வைக்கப்பட்டிருந்தன"}], "explanation": "அதியமான் பல போர்களைக் கண்டு வெற்றிபெற்ற மாவீரன் என்பதை உணர்த்தவே, அவன் கருவிகள் உலைக்களத்தில் உள்ளன என்றார்."}}}
{"id": "b-tam-6t2-039", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 14"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஔவையார் தொண்டைமானின் ஆயுதங்களைப் புகழ்வது போலப் பாராட்டி, உண்மையில் அதியமானின் தொடர் போர் வீரத்தை உணர்த்தியதன் மூலம் அமைந்த அணி நயம் எது?"}], "options": [{"key": "A", "text": "வேற்றுமையணி"}, {"key": "B", "text": "வஞ்சப்புகழ்ச்சியணி"}, {"key": "C", "text": "உவமையணி"}, {"key": "D", "text": "இல்பொருள் உவமையணி"}], "explanation": "புகழ்வது போலப் பழித்தும் பழிப்பது போலப் புகழ்வதும் வஞ்சப்புகழ்ச்சியணி எனப்படும்."}}}
{"id": "b-tam-6t2-040", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 14"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஔவையாரின் உட்பொருளை உணர்ந்துகொண்ட தொண்டைமான் இறுதியாக எடுத்த முடிவு யாது?"}], "options": [{"key": "A", "text": "அதியமானைச் சிறைபிடிக்க உத்தரவிட்டான்"}, {"key": "B", "text": "போரைக் கைவிட்டுவிடுவதாகக் கூறினான்"}, {"key": "C", "text": "கூடுதல் படைக்கலங்களைத் தயாரித்தான்"}, {"key": "D", "text": "வேறு நாட்டின் மீது படையெடுத்தான்"}], "explanation": "அதியமானோடு போரிடுவது பேரழிவைத் தரும் என்பதை உணர்ந்து, தொண்டைமான் போரைக் கைவிட்டுவிட்டான்."}}}

// ==============================================================================
// பாடம் 5: மொழி இறுதி எழுத்துகள் (கற்கண்டு - இலக்கணம்) [Q041 - Q048]
// இறுதி மெய்கள் (11), இறுதி வராத மெய்கள் (7: க், ங், ச், ட், த், ப், ற்), 'நொ' ஓரெழுத்து ஒருமொழி,
// எகர உயிர்மெய் இறுதியில் வராமை, ஆய்த எழுத்து
// ==============================================================================
{"id": "b-tam-6t2-041", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 15"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தமிழ் மொழியில் மெய்யெழுத்துகளில் எத்தனை எழுத்துகள் மட்டுமே சொல்லின் இறுதியில் வரும்?"}], "options": [{"key": "A", "text": "ஏழு மெய்கள்"}, {"key": "B", "text": "பதினொரு மெய்கள்"}, {"key": "C", "text": "பதினெட்டு மெய்கள்"}, {"key": "D", "text": "ஆறு மெய்கள்"}], "explanation": "ஞ், ண், ந், ம், ய், ர், ல், வ், ழ், ள், ன் ஆகிய 11 மெய்யெழுத்துகள் மட்டுமே சொல்லின் இறுதியில் வரும்."}}}
{"id": "b-tam-6t2-042", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 15"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பழங்காலத்தில் மெய்யெழுத்துகள் சொல்லின் இறுதியில் வந்ததற்குப் பாடநூலில் தரப்பட்டுள்ள சான்றுகளுள் சரியானவை எவை?"}], "options": [{"key": "A", "text": "உரிஞ், வெரிந், அவ்"}, {"key": "B", "text": "கார்த்திக், சுஜித், திலீப்"}, {"key": "C", "text": "மண், கண், பொன்"}, {"key": "D", "text": "பால், வேல், கால்"}], "explanation": "ஞ் ஈற்றுக்கு 'உரிஞ்', ந் ஈற்றுக்கு 'வெரிந்', வ் ஈற்றுக்கு 'அவ்' ஆகியவை பாடநூலில் பழஞ்சான்றுகளாகத் தரப்பட்டுள்ளன."}}}
{"id": "b-tam-6t2-043", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 15"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "உயிர் எழுத்துகள் சொல்லின் இறுதியில் இடம்பெறும் முறை பற்றிய சரியான கூற்று எது?"}], "options": [{"key": "A", "text": "சொல்லின் இறுதியில் உயிரெழுத்துகள் எப்போதும் தனித்து மட்டுமே வரும்"}, {"key": "B", "text": "உயிர் எழுத்துகள் மெய்யெழுத்துடன் இணைந்து உயிர்மெய்யாக மட்டுமே சொல்லின் இறுதியில் வரும்; அளபெடையில் மட்டும் தனித்து வரும்"}, {"key": "C", "text": "உயிரெழுத்துகள் சொல்லின் இறுதியில் ஒருபோதும் இடம்பெறாது"}, {"key": "D", "text": "ஆய்த எழுத்துடன் சேர்ந்தே சொல்லின் இறுதியில் வரும்"}], "explanation": "சொல்லின் இறுதியில் உயிரெழுத்துகள் தனித்து வருவதில்லை; மெய்யுடன் இணைந்து உயிர்மெய்யாக மட்டுமே வரும்; அளபெடையில் மட்டும் நெடிலைத் தொடர்ந்து வரும்."}}}
{"id": "b-tam-6t2-044", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 16"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தமிழ் இலக்கண மரபின்படி சொல்லின் இறுதியில் வராத மெய்யெழுத்துகள் மொத்தம் எத்தனை?"}], "options": [{"key": "A", "text": "ஆறு மெய்கள்"}, {"key": "B", "text": "ஏழு மெய்கள்"}, {"key": "C", "text": "பத்து மெய்கள்"}, {"key": "D", "text": "பதினொரு மெய்கள்"}], "explanation": "க், ங், ச், ட், த், ப், ற் ஆகிய 7 மெய் எழுத்துகளும் சொல்லின் இறுதியில் வருவதில்லை."}}}
{"id": "b-tam-6t2-045", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 16"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஒகர வரிசையில் எந்த ஓர் எழுத்து மட்டுமே ஓரெழுத்து ஒருமொழியாகத் ‘துன்பம்’ என்னும் பொருளில் மொழி இறுதியில் வரும்?"}], "options": [{"key": "A", "text": "கொ"}, {"key": "B", "text": "நொ"}, {"key": "C", "text": "தொ"}, {"key": "D", "text": "பொ"}], "explanation": "ஒகர வரிசையில் 'நொ' தவிர பிற உயிர்மெய் எழுத்துகள் மொழி இறுதியில் வருவதில்லை. 'நொ' என்பது துன்பம் என்னும் பொருளில் வரும்."}}}
{"id": "b-tam-6t2-046", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 16"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "எகர வரிசையில் (கெ முதல் னெ முடிய) எத்தனை உயிர்மெய் எழுத்துகள் மொழி இறுதியில் வரும்?"}], "options": [{"key": "A", "text": "அனைத்து எழுத்துகளும் வரும்"}, {"key": "B", "text": "எந்த உயிர்மெய் எழுத்தும் மொழி இறுதியில் வருவதில்லை"}, {"key": "C", "text": "ஐந்து எழுத்துகள் மட்டுமே வரும்"}, {"key": "D", "text": "ஒரு எழுத்து மட்டுமே வரும்"}], "explanation": "எகர வரிசையில் கெ முதல் னெ முடிய எந்த உயிர்மெய் எழுத்தும் மொழி இறுதியில் வருவதில்லை."}}}
{"id": "b-tam-6t2-047", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 16"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "சொல்லின் இடையில் மட்டுமே வரும் தனித்தன்மை வாய்ந்த தமிழ் எழுத்து எது?"}], "options": [{"key": "A", "text": "உயிரெழுத்து"}, {"key": "B", "text": "மெய்யெழுத்து"}, {"key": "C", "text": "ஆய்த எழுத்து (ஃ)"}, {"key": "D", "text": "உயிர்மெய் எழுத்து"}], "explanation": "ஆய்த எழுத்து சொல்லின் முதலில் வராது, இறுதியிலும் வராது; சொல்லின் இடையில் மட்டுமே வரும்."}}}
{"id": "b-tam-6t2-048", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 16"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கார்த்திக், சுஜித், மார்க்கெட், திலீப்’ போன்ற சொற்களின் இறுதியில் க், த், ட், ப் போன்ற மெய்கள் வரக் காரணம் என்ன?"}], "options": [{"key": "A", "text": "பழந்தமிழ் இலக்கியச் சொற்கள்"}, {"key": "B", "text": "அவை தமிழில் ஒலிபெயர்த்து எழுதப்படும் பிறமொழிப் பெயர்ச்சொற்கள்"}, {"key": "C", "text": "அளபெடைச் சொற்கள்"}, {"key": "D", "text": "இடைச்சொற்கள்"}], "explanation": "இவை பிறமொழிப் பெயர்ச்சொற்கள் என்பதால் இறுதியில் மெய்யெழுத்துகளாக வந்துள்ளன."}}}

// ==============================================================================
// பாடம் 6: மொழியை ஆள்வோம் & கலைச்சொற்கள் [Q049 - Q056]
// மதிப்புக்கூட்டுதல், வாக்கிய நீட்டிப்பு, பல்லுண்டு, Harvest, Gratitude, Cradle, Palace,
// Locality, Mountain Top, மொழி இறுதி மெய் (ஞ்)
// ==============================================================================
{"id": "b-tam-6t2-049", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 17"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கிடைக்கும் பொருள்களின் மதிப்பைக்கூட்டிப் புதிய பொருளாக மாற்றுவதற்கு வணிகத்தில் என்ன பெயர்?"}], "options": [{"key": "A", "text": "இணைய வணிகம்"}, {"key": "B", "text": "மதிப்புக் கூட்டுதல்"}, {"key": "C", "text": "பண்டமாற்று"}, {"key": "D", "text": "மொத்தக் கொள்முதல்"}], "explanation": "கல் என்பதைச் சிலையாகவும், கல் தூளைக் கோலமாவாகவும் மாற்றுவது போல மதிப்புக்கூட்டிப் புதிய பொருளாக்குவது 'மதிப்புக் கூட்டுதல்' எனப்படும்."}}}
{"id": "b-tam-6t2-050", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 18"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அவள் ஊருக்குச் ________’ - சரியான வினைமுற்றைத் தேர்வு செய்க:"}], "options": [{"key": "A", "text": "சென்றேன்"}, {"key": "B", "text": "சென்றாய்"}, {"key": "C", "text": "சென்றாள்"}, {"key": "D", "text": "சென்றார்"}], "explanation": "அவள் என்பது படர்க்கைப் பெண்பால் பெயர்ச்சொல்; எனவே 'சென்றாள்' என்ற வினைமுற்றே பொருந்தும்."}}}
{"id": "b-tam-6t2-051", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 19"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பல் + ல் + உண்டு’ மற்றும் ‘பல் + ல் + இல்லை’ ஆகியவை புணர்ந்து உருவாகும் புதிய சொற்கள் எவை?"}], "options": [{"key": "A", "text": "பல்லுண்டு, பல்லில்லை"}, {"key": "B", "text": "பலுண்டு, பலில்லை"}, {"key": "C", "text": "பல்லு உண்டு, பல்லு இல்லை"}, {"key": "D", "text": "பல்உண்டு, பல்இல்லை"}], "explanation": "தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும் விதிப்படி பல்லுண்டு, பல்லில்லை எனப் புணரும்."}}}
{"id": "b-tam-6t2-052", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": true, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 19"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பாடநூல் கட்டங்களில் மறைந்துள்ள சுற்றுலாத் தலங்களுள் பொருந்தாத ஒன்று எது?"}], "options": [{"key": "A", "text": "தஞ்சாவூர்"}, {"key": "B", "text": "கல்லணை"}, {"key": "C", "text": "மதுரை"}, {"key": "D", "text": "கொடைக்கானல்"}], "explanation": "பக்கம் 19 கட்டங்களில் தஞ்சாவூர், கல்லணை, குற்றாலம், சுருளி, மதுரை, மாமல்லபுரம் உள்ளன; கொடைக்கானல் இல்லை."}}}
{"id": "b-tam-6t2-053", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 20"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘நான் சென்றேன்’ என்ற தொடரை அடைப்புக்குறிச் சொற்களைக் கொண்டு (ஊருக்கு, நேற்று, பேருந்தில்) நீட்டித்து எழுதப்படும் சரியான வடிவம் எது?"}], "options": [{"key": "A", "text": "நான் நேற்று பேருந்தில் ஊருக்குச் சென்றேன்"}, {"key": "B", "text": "ஊருக்கு நேற்று பேருந்தில் சென்றேன்"}, {"key": "C", "text": "நான் சென்றேன் ஊருக்கு பேருந்தில் நேற்று"}, {"key": "D", "text": "பேருந்தில் நான் சென்றேன் நேற்று"}], "explanation": "நான் நேற்று பேருந்தில் ஊருக்குச் சென்றேன் என்பது சரியான வாக்கிய அமைப்பாகும்."}}}
{"id": "b-tam-6t2-054", "kind": "match", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "2", "B": "1", "C": "4", "D": "3"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 20"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஆங்கிலக் கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"}, {"type": "list", "name": "ஆங்கிலக் கலைச்சொல்", "items": [{"label": "A", "text": "Harvest"}, {"label": "B", "text": "Gratitude"}, {"label": "C", "text": "Cradle"}, {"label": "D", "text": "Palace"}]}, {"type": "list", "name": "தமிழாக்கம்", "items": [{"label": "1", "text": "நன்றியுணர்வு"}, {"label": "2", "text": "அறுவடை"}, {"label": "3", "text": "அரண்மனை"}, {"label": "4", "text": "தொட்டில்"}]}], "options": [{"key": "A", "text": "A-2, B-1, C-4, D-3", "mapping": {"A": "2", "B": "1", "C": "4", "D": "3"}}, {"key": "B", "text": "A-1, B-2, C-3, D-4", "mapping": {"A": "1", "B": "2", "C": "3", "D": "4"}}, {"key": "C", "text": "A-2, B-4, C-1, D-3", "mapping": {"A": "2", "B": "4", "C": "1", "D": "3"}}, {"key": "D", "text": "A-4, B-1, C-2, D-3", "mapping": {"A": "4", "B": "1", "C": "2", "D": "3"}}], "explanation": "Harvest = அறுவடை; Gratitude = நன்றியுணர்வு; Cradle = தொட்டில்; Palace = அரண்மனை; Locality = வட்டாரம்; Mountain Top = மலையுச்சி."}}}
{"id": "b-tam-6t2-055", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 20"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘Locality’ மற்றும் ‘Mountain Top’ ஆகிய ஆங்கிலச் சொற்களுக்கு இணையான தமிழ்ச் சொற்கள் முறையே எவை?"}], "options": [{"key": "A", "text": "அரண்மனை, மலையடிவாரம்"}, {"key": "B", "text": "வட்டாரம், மலையுச்சி"}, {"key": "C", "text": "மாவட்டம், மலைக்குன்று"}, {"key": "D", "text": "நகரம், முகடு"}], "explanation": "Locality = வட்டாரம்; Mountain Top = மலையுச்சி."}}}
{"id": "b-tam-6t2-056", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 15"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கீழ்க்காணும் மெய்யெழுத்துகளில் மொழி இறுதியில் வரக்கூடிய மெய் எது?"}], "options": [{"key": "A", "text": "க்"}, {"key": "B", "text": "த்"}, {"key": "C", "text": "ஞ்"}, {"key": "D", "text": "ற்"}], "explanation": "க், த், ற் ஆகியவை மொழி இறுதியில் வராத 7 மெய்களுள் அடங்கும்; 'ஞ்' என்பது மொழி இறுதியில் வரும் 11 மெய்களுள் ஒன்றாகும் (எ.கா: உரிஞ்)."}}}

// ==============================================================================
// பாடம் 7: திருக்குறள் (வாழ்வியல்) [Q057 - Q072]
// விருந்தோம்பல் (மோப்பக் குழையும் அனிச்சம், அமிழ்தம்), கள்ளாமை, ஊக்கமுடைமை (அசைவுஇலா ஊக்கம்,
// வெள்ளத்து அனைய மலர்நீட்டம் - எடுத்துக்காட்டு உவமையணி, உள்ளுவதெல்லாம் உயர்வுள்ளல்),
// பயனில சொல்லாமை, ஆத்திசூடி ஒப்பீடு
// ==============================================================================
{"id": "b-tam-6t2-057", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 21"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘விருந்து புறத்ததாத் தானுண்டல் சாவா மருந்தெனினும் வேண்டற்பாற்று அன்று’ - இக்குறட்பாவில் ‘சாவா மருந்து’ என்று வள்ளுவர் எதனைக் குறிப்பிடுகிறார்?"}], "options": [{"key": "A", "text": "தேன்"}, {"key": "B", "text": "அமிழ்தம்"}, {"key": "C", "text": "பால்"}, {"key": "D", "text": "கனி"}], "explanation": "சாவா மருந்தாகிய அமிழ்தமே ஆனாலும் விருந்தினர் வெளியே இருக்கும்போது தான் மட்டும் உண்பது விரும்பத்தக்கது அன்று."}}}
{"id": "b-tam-6t2-058", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 21"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘மோப்பக் குழையும் அனிச்சம் முகந்திரிந்து நோக்கக் குழையும் விருந்து’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?"}], "options": [{"key": "A", "text": "உவமையணி"}, {"key": "B", "text": "எடுத்துக்காட்டு உவமையணி"}, {"key": "C", "text": "சொற்பொருள் பின்வருநிலையணி"}, {"key": "D", "text": "வேற்றுமையணி"}], "explanation": "மோந்து பார்த்தால் அனிச்ச மலர் வாடுவது போல, முகம் மாறினாலே விருந்தினர் உள்ளம் வாடிவிடும் என்று உவமைப்படுத்தப்பட்டுள்ளதால் இது உவமையணி ஆகும்."}}}
{"id": "b-tam-6t2-059", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 21"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "அடுத்தவர் பொருளைக் களவாடலாம் என உள்ளத்தால் நினைப்பது கூடத் தீமையானது என்று கூறும் திருக்குறள் அதிகாரம் எது?"}], "options": [{"key": "A", "text": "அன்புடைமை"}, {"key": "B", "text": "கள்ளாமை"}, {"key": "C", "text": "ஊக்கமுடைமை"}, {"key": "D", "text": "பயனில சொல்லாமை"}], "explanation": "'உள்ளத்தால் உள்ளலும் தீதே பிறன்பொருளைக் கள்ளத்தால் கள்வேம் எனல்' என்பது கள்ளாமை அதிகாரக் குறளாகும்."}}}
{"id": "b-tam-6t2-060", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 21"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘களவினால் ஆகிய ஆக்கம் அளவிறந்து ஆவது போலக் கெடும்’ - இதில் ‘ஆக்கம்’ என்னும் சொல் எதனைக் குறிக்கிறது?"}], "options": [{"key": "A", "text": "செல்வம்"}, {"key": "B", "text": "துன்பம்"}, {"key": "C", "text": "புகழ்"}, {"key": "D", "text": "பகை"}], "explanation": "களவு மூலம் சேர்க்கப்படும் ஆக்கம் (செல்வம்) வளர்வது போலத் தோன்றினாலும் முடிவில் அழிந்துவிடும்."}}}
{"id": "b-tam-6t2-061", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 22"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "திருவள்ளுவரின் கூற்றுப்படி ஒருவருக்கு அழிவில்லாத ‘நிலையான செல்வம்’ எது?"}], "options": [{"key": "A", "text": "பொன் செல்வம்"}, {"key": "B", "text": "பொருளுடைமை"}, {"key": "C", "text": "ஊக்கமுடைமை"}, {"key": "D", "text": "நில உடைமை"}], "explanation": "'உள்ளம் உடைமை உடைமை பொருளுடைமை நில்லாது நீங்கி விடும்' - ஊக்கமே ஒருவருக்கு நிலையான செல்வம் ஆகும்."}}}
{"id": "b-tam-6t2-062", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 22"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘ஆக்கம் அதர்வினாய்ச் செல்லும் ________ ஊக்கம் உடையான் உழை’ - விடுபட்ட சரியான சீரைத் தேர்வு செய்க:"}], "options": [{"key": "A", "text": "உள்ளத்து"}, {"key": "B", "text": "அசைவுஇலா"}, {"key": "C", "text": "பயனுடைய"}, {"key": "D", "text": "பெருமகிழ்ச்சி"}], "explanation": "ஆக்கம் அதர்வினாய்ச் செல்லும் அசைவுஇலா ஊக்கம் உடையான் உழை (தளராத ஊக்கம் உடையவனிடம் செல்வமானது தானே வழிகேட்டுச் செல்லும்)."}}}
{"id": "b-tam-6t2-063", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 22"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘வெள்ளத்து அனைய மலர்நீட்டம் மாந்தர்தம் உள்ளத்து அனையது உயர்வு’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?"}], "options": [{"key": "A", "text": "வேற்றுமையணி"}, {"key": "B", "text": "எடுத்துக்காட்டு உவமையணி"}, {"key": "C", "text": "தொழிலுவமையணி"}, {"key": "D", "text": "பிறிது மொழிதலணி"}], "explanation": "தண்ணீரின் உயரத்திற்கு ஏற்ப நீர்ப்பூக்கள் வளரும்; அதுபோல மனிதர்களின் ஊக்கத்திற்கு ஏற்ப உயர்வு உண்டாகும். உவம உருபு மறைந்து வந்துள்ளதால் எடுத்துக்காட்டு உவமையணி ஆகும்."}}}
{"id": "b-tam-6t2-064", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 22"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘உள்ளுவது எல்லாம் உயர்வுள்ளல் மற்றது தள்ளினும் தள்ளாமை நீர்த்து’ - இக்குறட்பா உணர்த்தும் வாழ்வியல் நெறி யாது?"}], "options": [{"key": "A", "text": "பொருளைப் பாதுகாப்பதே வாழ்வின் நோக்கம்"}, {"key": "B", "text": "எண்ணுவதை உயர்வாகவே எண்ண வேண்டும்; எண்ணியதை அடையாவிட்டாலும் அந்த எண்ணத்தைக் கைவிடக்கூடாது"}, {"key": "C", "text": "எல்லாரிடமும் இன்சொல் பேச வேண்டும்"}, {"key": "D", "text": "துன்பம் வரும்போது கலங்கக் கூடாது"}], "explanation": "உள்ளுவதெல்லாம் உயர்வுள்ளல் - நாம் எண்ணும் எண்ணங்களை எப்போதும் உயர்வாகவே எண்ண வேண்டும்."}}}
{"id": "b-tam-6t2-065", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 22"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "நன்மை எது என ஆராயும் அறிவு உடையவர்கள் எத்தகைய சொற்களைப் பேசமாட்டார்கள்?"}], "options": [{"key": "A", "text": "கடுஞ்சொற்களை"}, {"key": "B", "text": "பயன்தராத வீண் சொற்களை (பெரும்பயன் இல்லாத சொல்)"}, {"key": "C", "text": "இனிய சொற்களை"}, {"key": "D", "text": "உயர்ந்த சொற்களை"}], "explanation": "'அரும்பயன் ஆயும் அறிவினார் சொல்லார் பெரும்பயன் இல்லாத சொல்' - பயனற்ற வீண் சொற்களை அறிவுடையோர் பேச மாட்டார்கள்."}}}
{"id": "b-tam-6t2-066", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 22"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘சொல்லுக சொல்லில் ________ சொல்லற்க சொல்லில் பயன்இலாச் சொல்’ - விடுபட்ட சரியான சீர் எது?"}], "options": [{"key": "A", "text": "பயனுடைய"}, {"key": "B", "text": "இனியவை"}, {"key": "C", "text": "உயர்வுடைய"}, {"key": "D", "text": "இன்னாச்சொல்"}], "explanation": "'சொல்லுக சொல்லில் பயனுடைய சொல்லற்க சொல்லில் பயன்இலாச் சொல்'."}}}
{"id": "b-tam-6t2-067", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 23"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பொருளுடைமை’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}], "options": [{"key": "A", "text": "பொருளு + டைமை"}, {"key": "B", "text": "பொரு + ளுடைமை"}, {"key": "C", "text": "பொருள் + உடைமை"}, {"key": "D", "text": "பொருள் + ளுடைமை"}], "explanation": "பொருள் + உடைமை = பொருளுடைமை (உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே: ள் + உ = ளு)."}}}
{"id": "b-tam-6t2-068", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 23"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘உள்ளுவது + எல்லாம்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}], "options": [{"key": "A", "text": "உள்ளுவதுஎல்லாம்"}, {"key": "B", "text": "உள்ளுவதெல்லாம்"}, {"key": "C", "text": "உள்ளுவத்தெல்லாம்"}, {"key": "D", "text": "உள்ளுவதுதெல்லாம்"}], "explanation": "உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'த்' நின்று, பின் உடல்மேல் உயிர்வந்து ஒன்றி 'உள்ளுவதெல்லாம்' எனப் புணரும்."}}}
{"id": "b-tam-6t2-069", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 23"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘உள்ளத்தால் உள்ளலும் தீதே பிறன்பொருளைக் கள்ளத்தால் கள்வேம் எனல்’ - இக்குறட்பாவில் அமைந்துள்ள எதுகைச் சொற்களைத் தேர்வு செய்க:"}], "options": [{"key": "A", "text": "உள்ளத்தால் - உள்ளலும்"}, {"key": "B", "text": "உள்ளத்தால் - கள்ளத்தால்"}, {"key": "C", "text": "தீதே - கள்வேம்"}, {"key": "D", "text": "பிறன்பொருளை - எனல்"}], "explanation": "முதல் அடியிலும் இரண்டாம் அடியிலும் இரண்டாம் எழுத்து 'ள்' ஒன்றி வருவதால் உள்ளத்தால் - கள்ளத்தால் என்பது அடி எதுகை நயம் ஆகும்."}}}
{"id": "b-tam-6t2-070", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 24"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "இடம் மாறியுள்ள சீர்களைச் சரியான வரிசையில் அமைத்து எழுதுக: ‘ஆக்கம் அதர்வினாய்ச் செல்லும் ஊக்கம் அசைவுஇலா உடையான் உழை’"}], "options": [{"key": "A", "text": "ஆக்கம் அதர்வினாய்ச் செல்லும் அசைவுஇலா ஊக்கம் உடையான் உழை"}, {"key": "B", "text": "ஊக்கம் உடையான் உழை செல்லும் ஆக்கம் அதர்வினாய்ச் அசைவுஇலா"}, {"key": "C", "text": "அசைவுஇலா ஊக்கம் உடையான் உழை செல்லும் ஆக்கம் அதர்வினாய்ச்"}, {"key": "D", "text": "செல்லும் ஆக்கம் அதர்வினாய்ச் அசைவுஇலா ஊக்கம் உடையான் உழை"}], "explanation": "குறளின் சரியான சீரமைப்பு: 'ஆக்கம் அதர்வினாய்ச் செல்லும் அசைவுஇலா ஊக்கம் உடையான் உழை'."}}}
{"id": "b-tam-6t2-071", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 24"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘ஊக்கமது கைவிடேல்’ என்பது ஔவையாரின் ஆத்திசூடி. இக்கருத்துடன் நேரடித் தொடர்புடைய திருக்குறள் எது?"}], "options": [{"key": "A", "text": "விருந்து புறத்ததாத் தானுண்டல் சாவா மருந்தெனினும் வேண்டற்பாற்று அன்று"}, {"key": "B", "text": "உள்ளம் உடைமை உடைமை பொருளுடைமை நில்லாது நீங்கி விடும்"}, {"key": "C", "text": "சொல்லுக சொல்லில் பயனுடைய சொல்லற்க சொல்லில் பயன்இலாச் சொல்"}, {"key": "D", "text": "மோப்பக் குழையும் அனிச்சம் முகந்திரிந்து நோக்கக் குழையும் விருந்து"}], "explanation": "ஔவையாரின் ஊக்கமது கைவிடேல் என்ற நெறிக்கு இணையான குறள் 'உள்ளம் உடைமை உடைமை பொருளுடைமை நில்லாது நீங்கி விடும்' என்பதாகும்."}}}
{"id": "b-tam-6t2-072", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 2, இயல் 1, பக்கம் 24"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பேச்சுப்போட்டியில் வெற்றி தோல்வியைப் பற்றிக் கவலைப்படாமல் முழு ஊக்கத்துடன் கலந்துகொள்ளுமாறு தந்தை மகனுக்குக் கூறும் பாடநூல் கதைக்குப் பொருத்தமான திருக்குறள் எது?"}], "options": [{"key": "A", "text": "மோப்பக் குழையும் அனிச்சம் முகந்திரிந்து நோக்கக் குழையும் விருந்து"}, {"key": "B", "text": "வெள்ளத்து அனைய மலர்நீட்டம் மாந்தர்தம் உள்ளத்து அனையது உயர்வு"}, {"key": "C", "text": "அரும்பயன் ஆயும் அறிவினார் சொல்லார் பெரும்பயன் இல்லாத சொல்"}, {"key": "D", "text": "களவினால் ஆகிய ஆக்கம் அளவிறந்து ஆவது போலக் கெடும்"}], "explanation": "ஊக்கத்தின் அளவுக்கு ஏற்பவே மனிதர்களின் வெற்றி அமையும் என்பதை விளக்கும் 'வெள்ளத்து அனைய மலர்நீட்டம் மாந்தர்தம் உள்ளத்து அனையது உயர்வு' என்னும் குறளே இக்கதைக்குப் பொருந்தும்."}}}
