// 6-ஆம் வகுப்பு தமிழ் - பருவம் 1 - இயல் 1: தமிழ்த்தேன் (மொத்த வினாக்கள்: 54)
// ==============================================================================

// ==============================================================================
// பாடம் 1: இன்பத்தமிழ் (கவிதைப்பேழை - பாவேந்தர் பாரதிதாசன்) [Q001 - Q012]
// பாடநூல் வினாக்கள், முந்தைய ஆண்டு வினாக்கள் (PYQ), மற்றும் கூடுதல் வினாக்கள்
// ==============================================================================
{"id": "b-tam-6t1-001", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 2"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘தமிழுக்கும் அமுதென்று பேர்! - அந்தத் தமிழ் இன்பத் தமிழ் எங்கள் உயிருக்கு நேர்!’ - இவ்வடிகளை இயற்றிய பாவலர் யார்?"}], "options": [{"key": "A", "text": "மகாகவி பாரதியார்"}, {"key": "B", "text": "பாவேந்தர் பாரதிதாசன்"}, {"key": "C", "text": "கவிமணி தேசிக விநாயகம்"}, {"key": "D", "text": "நாமக்கல் கவிஞர் வெ. இராமலிங்கம்"}], "explanation": "இன்பத்தமிழ் பாடலில் 'தமிழுக்கும் அமுதென்று பேர் - அந்தத் தமிழ் இன்பத் தமிழ் எங்கள் உயிருக்கு நேர்' என்று பாடியவர் பாரதிதாசன்."}}}
{"id": "b-tam-6t1-002", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 2"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘தமிழுக்கு மணமென்று பேர்! - இன்பத் தமிழ் எங்கள் வாழ்வுக்கு நிருமித்த ஊர்!’ - இவ்வடியில் ‘நிருமித்த’ என்பதன் பொருள் யாது?"}], "options": [{"key": "A", "text": "மக்கள் குழு"}, {"key": "B", "text": "உருவாக்கிய"}, {"key": "C", "text": "வளர்ச்சி"}, {"key": "D", "text": "நீடித்த"}], "explanation": "நிருமித்த என்றால் 'உருவாக்கிய' என்று பொருள். சமூகம் = மக்கள் குழு, விளைவு = வளர்ச்சி, அசதி = சோர்வு."}}}
{"id": "b-tam-6t1-003", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "2", "B": "1", "C": "4", "D": "3"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 2, 4"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "இன்பத்தமிழ் பாடலில் பாரதிதாசன் தமிழுக்குக் கூறியுள்ள உவமைகளைச் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "பட்டியல் I", "items": [{"label": "A", "text": "இளமைக்கு"}, {"label": "B", "text": "புலவர்க்கு"}, {"label": "C", "text": "உயர்வுக்கு"}, {"label": "D", "text": "அறிவுக்கு"}]}, {"type": "list", "name": "பட்டியல் II", "items": [{"label": "1", "text": "வேல்"}, {"label": "2", "text": "பால்"}, {"label": "3", "text": "தோள்"}, {"label": "4", "text": "வான்"}]}], "options": [{"key": "A", "text": "A-2, B-1, C-4, D-3", "mapping": {"A": "2", "B": "1", "C": "4", "D": "3"}}, {"key": "B", "text": "A-1, B-2, C-3, D-4", "mapping": {"A": "1", "B": "2", "C": "3", "D": "4"}}, {"key": "C", "text": "A-2, B-4, C-1, D-3", "mapping": {"A": "2", "B": "4", "C": "1", "D": "3"}}, {"key": "D", "text": "A-4, B-1, C-2, D-3", "mapping": {"A": "4", "B": "1", "C": "2", "D": "3"}}], "explanation": "பாரதிதாசன்: இளமைக்கு - பால், புலவர்க்கு - வேல், உயர்வுக்கு - வான், அறிவுக்கு - தோள் என உவமித்துள்ளார்."}}}
{"id": "b-tam-6t1-004", "kind": "assertion_reason", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "assertion_reason", "a_true": true, "r_true": true, "r_explains_a": true}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 2"}, "texts": {"ta": {"blocks": [{"type": "assertion", "text": "பாரதிதாசன் இன்பத்தமிழைச் 'சமூகத்தின் விளைவுக்கு நீர்' என்று ஒப்பிடுகிறார்."}, {"type": "reason", "text": "நீர் எவ்வாறு ஒரு பயிரின் வளர்ச்சிக்கு இன்றியமையாததோ, அதுபோலத் தமிழ் மக்களின் சமூக வளர்ச்சிக்கு அடிப்படையானது."}], "options": [{"key": "A", "text": "(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்", "semantic": "both_true_explains"}, {"key": "B", "text": "(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல", "semantic": "both_true_not_explains"}, {"key": "C", "text": "(A) சரி ஆனால் (R) தவறு", "semantic": "a_true_r_false"}, {"key": "D", "text": "(A) தவறு ஆனால் (R) சரி", "semantic": "a_false_r_true"}], "explanation": "விளைவு என்றால் வளர்ச்சி; சமூகம் தழைத்து வளர நீர் போன்ற இன்றியமையாதது தமிழ் என்பதால் கூற்று, காரணம் இரண்டும் சரி."}}}
{"id": "b-tam-6t1-005", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 2"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "இன்பத்தமிழ் பாடலில் பாரதிதாசன் தமிழர்களின் 'அசதி' மற்றும் 'கவிதை' ஆகியவற்றிற்கு உவமித்துள்ளவை முறையே எவை?"}], "options": [{"key": "A", "text": "தேன், தோள்"}, {"key": "B", "text": "வான், வாள்"}, {"key": "C", "text": "தேன், வாள்"}, {"key": "D", "text": "பால், வேல்"}], "explanation": "'தமிழ் எங்கள் அசதிக்குச் சுடர்தந்த தேன்; தமிழ் எங்கள் கவிதைக்கு வயிரத்தின் வாள்' என்று பாரதிதாசன் பாடியுள்ளார்."}}}
{"id": "pyq-tam-6t1-006", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 12}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பாவேந்தர் பாரதிதாசனின் இயற்பெயர் யாது?"}], "options": [{"key": "A", "text": "சுப்பிரமணியன்"}, {"key": "B", "text": "துரைராசு"}, {"key": "C", "text": "சுப்புரத்தினம்"}, {"key": "D", "text": "கனகசுப்புரத்தினம்"}], "explanation": "பாரதிதாசனின் இயற்பெயர் சுப்புரத்தினம். பாரதியாரின் கவிதைகள் மீது கொண்ட பற்றின் காரணமாகத் தம் பெயரைப் பாரதிதாசன் என மாற்றிக்கொண்டார்."}}}
{"id": "pyq-tam-6t1-007", "kind": "statements", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": false}}, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 18}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பாரதிதாசன் பற்றிய பின்வரும் கூற்றுகளை ஆராய்ந்து சரியானவற்றைத் தேர்ந்தெடுக்க:"}, {"type": "statement", "label": "I", "text": "இவர் தம் கவிதைகளில் பெண்கல்வி, கைம்பெண் மறுமணம், பொதுவுடைமை, பகுத்தறிவு போன்ற புரட்சிகர கருத்துகளைப் பாடியுள்ளார்."}, {"type": "statement", "label": "II", "text": "இவர் 'புரட்சிக்கவி', 'பாவேந்தர்' என்று போற்றப்படுகிறார்."}, {"type": "statement", "label": "III", "text": "இவர் 'மக்கள் கவிஞர்' என்னும் சிறப்புப் பெயரால் போற்றப்படுகிறார்."}], "options": [{"key": "A", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "B", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "C", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "'மக்கள் கவிஞர்' என அழைக்கப்படுபவர் பட்டுக்கோட்டை கல்யாணசுந்தரம் ஆவார். எனவே கூற்று III தவறானது."}}}
{"id": "b-tam-6t1-008", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 3"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பாடப்பகுதியில் அமைந்துள்ள 'இன்பத்தமிழ்' என்னும் பாடல் பாரதிதாசன் கவிதைகள் என்னும் நூலில் எந்தத் தலைப்பின்கீழ் இடம்பெற்றுள்ளது?"}], "options": [{"key": "A", "text": "தமிழ்ப்பற்று"}, {"key": "B", "text": "தமிழ்த்தாய்"}, {"key": "C", "text": "தமிழ்"}, {"key": "D", "text": "செந்தமிழ்"}], "explanation": "இப்பாடல் 'பாரதிதாசன் கவிதைகள்' என்ற நூலில் 'தமிழ்' என்னும் தலைப்பின்கீழ் இடம்பெற்றுள்ளது."}}}
{"id": "b-tam-6t1-009", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 3"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘தமிழை உயிரே! வணக்கம்! தாய்பிள்ளை உறவம்மா உனக்கும் எனக்கும்!’ - என்று பாடிய கவிஞர் யார்?"}], "options": [{"key": "A", "text": "பாரதிதாசன்"}, {"key": "B", "text": "காசி ஆனந்தன்"}, {"key": "C", "text": "பெருஞ்சித்திரனார்"}, {"key": "D", "text": "கவிஞர் அறிவுமதி"}], "explanation": "6-ஆம் வகுப்பு இயல் 1 கற்பவை கற்றபின் பகுதியில் இடம்பெற்றுள்ள 'தாய்பிள்ளை உறவம்மா உனக்கும் எனக்கும்' என்ற பாடலை இயற்றியவர் கவிஞர் காசி ஆனந்தன்."}}}
{"id": "b-tam-6t1-010", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 3"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "இன்பத்தமிழ் பாடலில் 'பேர் - நேர்', 'பால் - வேல்' என அடிகளின் இறுதியில் வரும் சொற்கள் ஒரே ஓசையில் முடிந்துள்ள தொடை நயம் எது?"}], "options": [{"key": "A", "text": "மோனைத்தொடை"}, {"key": "B", "text": "எதுகைத்தொடை"}, {"key": "C", "text": "இயைபுத்தொடை"}, {"key": "D", "text": "முரண்டொடை"}], "explanation": "அடிகளின் அல்லது சீர்களின் இறுதியில் சொற்கள் ஒரே ஓசையில் முடிவதை இயைபுத்தொடை என்பர்."}}}
{"id": "extra-tam-6t1-011", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "other", "note": "பாரதிதாசன் கூடுதல் தகவல்"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பாரதிதாசன் சாகித்திய அகாதெமி விருது பெற்ற நாடக நூல் எது?"}], "options": [{"key": "A", "text": "பாண்டியன் பரிசு"}, {"key": "B", "text": "பிசிராந்தையார்"}, {"key": "C", "text": "இருண்ட வீடு"}, {"key": "D", "text": "குடும்ப விளக்கு"}], "explanation": "பாரதிதாசனின் 'பிசிராந்தையார்' என்னும் நாடக நூலுக்கு 1969-ஆம் ஆண்டு சாகித்திய அகாதெமி விருது வழங்கப்பட்டது."}}}
{"id": "extra-tam-6t1-012", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "other", "note": "பாரதிதாசன் இதழியல் குறிப்பு"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பாரதிதாசன் நடத்திய இலக்கிய இதழின் பெயர் யாது?"}], "options": [{"key": "A", "text": "இந்தியா"}, {"key": "B", "text": "சுதேசமித்திரன்"}, {"key": "C", "text": "குயில்"}, {"key": "D", "text": "தென்றல்"}], "explanation": "பாரதிதாசன் நடத்திய புகழ்பெற்ற கவிதை/இலக்கிய இதழ் 'குயில்' ஆகும்."}}}

// ==============================================================================
// பாடம் 2: வளர்தமிழ் (உரைநடை உலகம்) [Q013 - Q031]
// தொன்மை, சீர்மை, பூவின் 7 நிலைகள், தாவர இலைப்பெயர்கள், தமிழ் எண்கள், மேற்கோள்கள்
// ==============================================================================
{"id": "b-tam-6t1-013", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 5"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘யாமறிந்த மொழிகளிலே தமிழ்மொழி போல் இனிதாவது எங்கும் காணோம்’ - என்று பாடியவர் யார்?"}], "options": [{"key": "A", "text": "பாரதிதாசன்"}, {"key": "B", "text": "பாரதியார்"}, {"key": "C", "text": "கவிமணி"}, {"key": "D", "text": "நாமக்கல் கவிஞர்"}], "explanation": "பல மொழிகள் கற்ற கவிஞர் பாரதியார் தமிழ்மொழியின் இனிமையை வியந்து இவ்வாறு பாடியுள்ளார்."}}}
{"id": "b-tam-6t1-014", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 5"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘என்று பிறந்தவள் என்று உணராத இயல்பினளாம் எங்கள் தாய்!’ - என்று பாரதியார் குறிப்பிட்டது எதனை?"}], "options": [{"key": "A", "text": "தமிழ்த்தாய்"}, {"key": "B", "text": "பாரதத்தாய்"}, {"key": "C", "text": "இயற்கைத் தாய்"}, {"key": "D", "text": "நிலமகள்"}], "explanation": "பாரதியார் பாரதத்தாயின் தொன்மையை உரைத்த போதிலும், அது தமிழ்த்தாயின் பழமைக்கும் பொருந்துவதாகப் பாடப்பகுதி விளக்குகிறது."}}}
{"id": "b-tam-6t1-015", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 5"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "வளர்தமிழ் பாடப்பகுதியின்படி உலகில் எத்தனைக்கும் மேற்பட்ட மொழிகள் உள்ளன?"}], "options": [{"key": "A", "text": "3000-க்கும் மேற்பட்ட"}, {"key": "B", "text": "5000-க்கும் மேற்பட்ட"}, {"key": "C", "text": "6000-க்கும் மேற்பட்ட"}, {"key": "D", "text": "8000-க்கும் மேற்பட்ட"}], "explanation": "உலகில் ஆறாயிரத்திற்கும் மேற்பட்ட மொழிகள் உள்ளன. அவற்றுள் சில மொழிகள் மட்டுமே பேச்சு மற்றும் எழுத்து வடிவம் இரண்டையும் பெற்றுள்ளன."}}}
{"id": "b-tam-6t1-016", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 5"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தமிழில் நமக்குக் கிடைத்துள்ள மிகப்பழமையான இலக்கண நூல் எது?"}], "options": [{"key": "A", "text": "நன்னூல்"}, {"key": "B", "text": "தொல்காப்பியம்"}, {"key": "C", "text": "அகத்தியம்"}, {"key": "D", "text": "வீரசோழியம்"}], "explanation": "தமிழில் நமக்குக் கிடைத்துள்ள மிகப் பழமையான இலக்கண நூல் தொல்காப்பியம் ஆகும்."}}}
{"id": "pyq-tam-6t1-017", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "3", "B": "1", "C": "2"}}, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 25}, "texts": {"ta": {"blocks": [{"type": "text", "text": "சொல் முதன்முதலில் ஆளப்படும் இலக்கிய நூல்களைச் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "பட்டியல் I (சொல்)", "items": [{"label": "A", "text": "தமிழ்"}, {"label": "B", "text": "தமிழ்நாடு"}, {"label": "C", "text": "தமிழன்"}]}, {"type": "list", "name": "பட்டியல் II (இலக்கியம்)", "items": [{"label": "1", "text": "சிலப்பதிகாரம் (வஞ்சிக்காண்டம்)"}, {"label": "2", "text": "அப்பர் தேவாரம்"}, {"label": "3", "text": "தொல்காப்பியம்"}]}], "options": [{"key": "A", "text": "A-3, B-1, C-2", "mapping": {"A": "3", "B": "1", "C": "2"}}, {"key": "B", "text": "A-1, B-2, C-3", "mapping": {"A": "1", "B": "2", "C": "3"}}, {"key": "C", "text": "A-3, B-2, C-1", "mapping": {"A": "3", "B": "2", "C": "1"}}, {"key": "D", "text": "A-2, B-1, C-3", "mapping": {"A": "2", "B": "1", "C": "3"}}], "explanation": "தமிழ் - தொல்காப்பியம்; தமிழ்நாடு - சிலப்பதிகாரம் வஞ்சிக்காண்டம்; தமிழன் - அப்பர் தேவாரம்."}}}
{"id": "b-tam-6t1-018", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 6"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘இமிழ்கடல் வேலியைத் தமிழ்நாடு ஆக்கிய இதுநீ கருதினை ஆயின்’ - என்ற வரிகள் இடம்பெற்றுள்ள காப்பியம் எது?"}], "options": [{"key": "A", "text": "மணிமேகலை"}, {"key": "B", "text": "சிலப்பதிகாரம்"}, {"key": "C", "text": "சீவக சிந்தாமணி"}, {"key": "D", "text": "குண்டலகேசி"}], "explanation": "சிலப்பதிகாரத்தின் வஞ்சிக்காண்டத்தில் (வஞ்சி : 165) தமிழ்நாடு என்ற சொல் முதன்முதலில் ஆளப்பட்டுள்ளது."}}}
{"id": "b-tam-6t1-019", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 6"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘... தமிழன் கண்டாய்’ - என்ற மேற்கோள் வரி இடம்பெற்றுள்ள நூல் எது?"}], "options": [{"key": "A", "text": "திருவாசகம்"}, {"key": "B", "text": "தொல்காப்பியம்"}, {"key": "C", "text": "அப்பர் தேவாரம்"}, {"key": "D", "text": "நாலாயிரத் திவ்வியப் பிரபந்தம்"}], "explanation": "திருநாவுக்கரசர் (அப்பர்) பாடிய தேவாரத் திருத்தாண்டகத்தில் (பாடல் 23) 'தமிழன் கண்டாய்' என்று குறிப்பிடப்பட்டுள்ளது."}}}
{"id": "b-tam-6t1-020", "kind": "statements", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": false, "II": true, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 6"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தமிழ் எழுத்துகளின் எழுதும் முறை குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "தமிழ் எழுத்துகள் பெரும்பாலும் இடஞ்சுழி எழுத்துகளாகவே அமைந்துள்ளன."}, {"type": "statement", "label": "II", "text": "அ, எ, ஔ, ண, ஞ ஆகியவை வலஞ்சுழி எழுத்துகள் ஆகும்."}, {"type": "statement", "label": "III", "text": "ட, ய, ழ ஆகியவை இடஞ்சுழி எழுத்துகள் ஆகும்."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "C", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "தமிழ் எழுத்துகள் பெரும்பாலும் 'வலஞ்சுழி' எழுத்துகளாகவே அமைந்துள்ளன. எனவே கூற்று I தவறானது."}}}
{"id": "b-tam-6t1-021", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 6"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "உயர்திணையின் எதிர்ச்சொல்லைத் தாழ்திணை என்று கூறாமல் ‘அஃறிணை’ என்று பெயரிட்டனர். அஃறிணை என்பதன் சரியான பிரிப்பு யாது?"}], "options": [{"key": "A", "text": "அஃது + திணை"}, {"key": "B", "text": "அல் + திணை"}, {"key": "C", "text": "அக + திணை"}, {"key": "D", "text": "அருமை + திணை"}], "explanation": "அல் + திணை = அஃறிணை (உயர்வு அல்லாத திணை). சீர்மை மிக்க சொல்மரபுக்கு இது சிறந்த சான்றாகும்."}}}
{"id": "b-tam-6t1-022", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 6"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பாகற்காய் என்னும் சொல் எவ்வவாறு பொருள் நயத்தோடு பிரித்துப் பெயரிடப்பட்டுள்ளது?"}], "options": [{"key": "A", "text": "பாகர் + காய்"}, {"key": "B", "text": "பாகு + அல் + காய்"}, {"key": "C", "text": "பாகு + காய்"}, {"key": "D", "text": "பாகன் + அல் + காய்"}], "explanation": "கசப்புச் சுவையுடைய காயைக் கசப்புக்காய் எனக் கூறாமல், இனிப்பு அல்லாத காய் எனப் பொருள் தரும்படி 'பாகு + அல் + காய் = பாகற்காய்' எனப் பெயரிட்டனர்."}}}
{"id": "b-tam-6t1-023", "kind": "arrange", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "arrange", "order": ["I", "III", "II", "V", "IV", "VII", "VI"]}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 7"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பூவின் தோற்றம் முதல் உதிர்தல் வரையிலான ஏழு நிலைகளைச் சரியான காலவரிசைப்படி ஒழுங்குபடுத்துக:"}, {"type": "list", "name": "பூவின் நிலைகள்", "items": [{"label": "I", "text": "அரும்பு"}, {"label": "II", "text": "முகை"}, {"label": "III", "text": "மொட்டு"}, {"label": "IV", "text": "அலர்"}, {"label": "V", "text": "மலர்"}, {"label": "VI", "text": "செம்மல்"}, {"label": "VII", "text": "வீ"}]}], "options": [{"key": "A", "text": "I, III, II, V, IV, VII, VI", "sequence": ["I", "III", "II", "V", "IV", "VII", "VI"]}, {"key": "B", "text": "I, II, III, V, IV, VI, VII", "sequence": ["I", "II", "III", "V", "IV", "VI", "VII"]}, {"key": "C", "text": "III, I, II, IV, V, VII, VI", "sequence": ["III", "I", "II", "IV", "V", "VII", "VI"]}, {"key": "D", "text": "I, III, II, IV, V, VII, VI", "sequence": ["I", "III", "II", "IV", "V", "VII", "VI"]}], "explanation": "பூவின் 7 நிலைகள்: அரும்பு (தோற்றம்) -> மொட்டு -> முகை -> மலர் -> அலர் (மலர் விரிந்த நிலை) -> வீ (கீழே விழுந்த நிலை) -> செம்மல் (வாடிய நிலை)."}}}
{"id": "pyq-tam-6t1-024", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": true, "source": {"type": "past_paper", "exam": "g4", "year": 2018, "paper": "tamil", "no": 33}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘மா’ என்னும் ஓரெழுத்து ஒருமொழி தரும் பொருள்களுள் தவறான ஒன்றைத் தேர்வு செய்க:"}], "options": [{"key": "A", "text": "பெரிய, திருமகள்"}, {"key": "B", "text": "அழகு, அறிவு"}, {"key": "C", "text": "அளவு, அழைத்தல், துகள்"}, {"key": "D", "text": "வானம், நிலவு"}], "explanation": "'மா' என்பதற்கு மரம், விலங்கு, பெரிய, திருமகள், அழகு, அறிவு, அளவு, அழைத்தல், துகள், மேன்மை, வயல், வண்டு போன்ற பொருள்கள் உண்டு; வானம், நிலவு என்பது தவறானது."}}}
{"id": "b-tam-6t1-025", "kind": "match", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "2", "B": "1", "C": "4", "D": "3"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 7"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தாவரங்களின் இலைப்பெயர்களைச் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "தாவரம்", "items": [{"label": "A", "text": "நெல், வரகு"}, {"label": "B", "text": "கரும்பு, நாணல்"}, {"label": "C", "text": "பனை, தென்னை"}, {"label": "D", "text": "கமுகு (பாக்கு)"}]}, {"type": "list", "name": "இலைப்பெயர்", "items": [{"label": "1", "text": "தோகை"}, {"label": "2", "text": "தாள்"}, {"label": "3", "text": "கூந்தல்"}, {"label": "4", "text": "ஓலை"}]}], "options": [{"key": "A", "text": "A-2, B-1, C-4, D-3", "mapping": {"A": "2", "B": "1", "C": "4", "D": "3"}}, {"key": "B", "text": "A-1, B-2, C-3, D-4", "mapping": {"A": "1", "B": "2", "C": "3", "D": "4"}}, {"key": "C", "text": "A-2, B-4, C-1, D-3", "mapping": {"A": "2", "B": "4", "C": "1", "D": "3"}}, {"key": "D", "text": "A-3, B-1, C-4, D-2", "mapping": {"A": "3", "B": "1", "C": "4", "D": "2"}}], "explanation": "நெல்/வரகு = தாள்; கரும்பு/நாணல் = தோகை; பனை/தென்னை = ஓலை; கமுகு = கூந்தல்; சப்பாத்திக்கள்ளி/தாழை = மடல்; அருகு/கோரை = புல்; மல்லி = தழை."}}}
{"id": "b-tam-6t1-026", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 7"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "சப்பாத்திக்கள்ளி, தாழை ஆகியவற்றின் இலைப்பெயர் எவ்வாறு அழைக்கப்படுகிறது?"}], "options": [{"key": "A", "text": "தோகை"}, {"key": "B", "text": "ஓலை"}, {"key": "C", "text": "மடல்"}, {"key": "D", "text": "கூந்தல்"}], "explanation": "சப்பாத்திக்கள்ளி மற்றும் தாழையின் இலைகளை 'மடல்' என்று அழைப்பர்."}}}
{"id": "b-tam-6t1-027", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 8"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தமிழ் எண்களில் ‘அ’ மற்றும் ‘கூ’ குறிக்கும் எண்கள் முறையே எவை?"}], "options": [{"key": "A", "text": "7 மற்றும் 8"}, {"key": "B", "text": "8 மற்றும் 9"}, {"key": "C", "text": "6 மற்றும் 8"}, {"key": "D", "text": "8 மற்றும் 10"}], "explanation": "1-க, 2-உ, 3-ங, 4-ச, 5-ரு, 6-சா, 7-எ, 8-அ, 9-கூ, 10-க0. எனவே 'அ' என்பது 8, 'கூ' என்பது 9."}}}
{"id": "extra-tam-6t1-028", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "other", "note": "செம்மொழி தகுதி கூடுதல் வினா"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தமிழ்மொழி இந்திய அரசால் அதிகாரப்பூர்வமாகச் செம்மொழியாக அறிவிக்கப்பட்ட ஆண்டு எது?"}], "options": [{"key": "A", "text": "2002"}, {"key": "B", "text": "2003"}, {"key": "C", "text": "2004"}, {"key": "D", "text": "2005"}], "explanation": "தமிழ் மொழி 2004-ஆம் ஆண்டு நடுவண் அரசால் முதல் செம்மொழியாக அறிவிக்கப்பட்டது."}}}
{"id": "b-tam-6t1-029", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 9"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘வானம் தீண்டும் தூரம் நீ வளர்ந்து வாழ வேண்டும்! சர்க்கரைத் தமிழ் அள்ளி தாலாட்டு நாள் சொல்லி வாழ்த்துகிறோம்!’ - என்ற பிறந்தநாள் வாழ்த்துப் பாடலை இயற்றியவர் யார்?"}], "options": [{"key": "A", "text": "பாரதிதாசன்"}, {"key": "B", "text": "கவிஞர் அறிவுமதி"}, {"key": "C", "text": "கவிஞர் வைரமுத்து"}, {"key": "D", "text": "கவிஞர் கண்ணதாசன்"}], "explanation": "இயல் 1 கற்பவை கற்றபின் பகுதியில் அமைந்த பிறந்தநாள் வாழ்த்துப் பாடலை இயற்றியவர் கவிஞர் அறிவுமதி."}}}
{"id": "b-tam-6t1-030", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 9"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘தொன்மை’ என்னும் சொல்லின் பொருள் யாது?"}], "options": [{"key": "A", "text": "புதுமை"}, {"key": "B", "text": "பழமை"}, {"key": "C", "text": "பெருமை"}, {"key": "D", "text": "சீர்மை"}], "explanation": "தொன்மை என்னும் சொல்லின் பொருள் பழமை ஆகும்."}}}
{"id": "b-tam-6t1-031", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 9"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘சீரிளமை’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}], "options": [{"key": "A", "text": "சிறு + இளமை"}, {"key": "B", "text": "சீர்மை + இளமை"}, {"key": "C", "text": "சீரி + இளமை"}, {"key": "D", "text": "சீற் + இளமை"}], "explanation": "சீர்மை + இளமை = ஈறுபோதல் விதிப்படி 'மை' கெட்டு, சீரிளமை எனப் புணரும்."}}}

// ==============================================================================
// பாடம் 3: கனவு பலித்தது / ஏ.பி.ஜே. அப்துல் கலாம் (விரிவானம் / நேர்காணல்) [Q032 - Q037]
// ஆசிரியர் விளக்கம், Lights from many lamps, கார்பன் இழை, ஆளில்லாச் செயற்கைக்கோள்
// ==============================================================================
{"id": "b-tam-6t1-032", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 11"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "டாக்டர் ஏ.பி.ஜே. அப்துல் கலாம் அவர்களுக்கு அறிவியல் மீது ஆர்வம் ஏற்படக் காரணமான தொடக்கக்கால பள்ளி நிகழ்வு எது?"}], "options": [{"key": "A", "text": "வானியல் ஆய்வகத்திற்குச் சென்றது"}, {"key": "B", "text": "பத்து வயதில் ஆசிரியர் பறவைகள் எப்படிப் பறக்கின்றன என விளக்கியது"}, {"key": "C", "text": "கணிதத் தேர்வில் முதல் மதிப்பெண் பெற்றது"}, {"key": "D", "text": "செயற்கைக்கோள் ஏவுதலைப் பார்த்தது"}], "explanation": "கலாம் 10 வயதுச் சிறுவனாக இருந்தபோது அவரது அறிவியல் ஆசிரியர் பறவைகள் பறக்கும் விதத்தை விளக்கியதே அவரது அறிவியல் குறிக்கோளின் தொடக்கம்."}}}
{"id": "b-tam-6t1-033", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 12"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "அப்துல் கலாம் அவர்களுக்கு அறிவு, தன்னம்பிக்கை, மகிழ்ச்சி ஆகிய மூன்றையும் பெற்றுத்தந்த ஆங்கில நூல் எது?"}], "options": [{"key": "A", "text": "விங்ஸ் ஆஃப் பயர் (Wings of Fire)"}, {"key": "B", "text": "விளக்குகள் பல தந்த ஒளி (Lights from many lamps)"}, {"key": "C", "text": "இந்தியா 2020"}, {"key": "D", "text": "மை ஜெர்னி (My Journey)"}], "explanation": "லிலியன் வாட்சன் எழுதிய 'விளக்குகள் பல தந்த ஒளி' (Lights from many lamps) என்ற நூலே கலாமுக்கு அம்மூன்றையும் தந்தது."}}}
{"id": "b-tam-6t1-034", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 12"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "போலியோவால் பாதிக்கப்பட்ட குழந்தைகளுக்குப் பாதுகாப்பு உபகரணங்களில் பயன்படும் எப்பொருளைக் கொண்டு 300 கிராம் எடையில் செயற்கைக்கால்கள் உருவாக்கப்பட்டன?"}], "options": [{"key": "A", "text": "டைட்டானியம் கலவை"}, {"key": "B", "text": "கார்பன் இழை (Carbon fiber)"}, {"key": "C", "text": "அலுமினியம் இழை"}, {"key": "D", "text": "கண்ணாடியிழை (Glass fiber)"}], "explanation": "பாதுகாப்புக் கருவிகளில் பயன்படுத்தப்படும் கார்பன் இழையைக் கொண்டு 3 கிலோ எடையுள்ள செயற்கைக்கால்கள் 300 கிராமாக உருவாக்கப்பட்டது கலாமுக்குப் பெருமகிழ்வளித்தது."}}}
{"id": "b-tam-6t1-035", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 12"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "இந்தியா நிலவுக்கு அனுப்பிய ஆளில்லாச் செயற்கைக்கோளின் எடை எத்தனை கிலோகிராம் என அப்துல் கலாம் குறிப்பிடுகிறார்?"}], "options": [{"key": "A", "text": "300 கிலோ"}, {"key": "B", "text": "450 கிலோ"}, {"key": "C", "text": "525 கிலோ"}, {"key": "D", "text": "600 கிலோ"}], "explanation": "525 கிலோ எடையுள்ள ஆளில்லாச் செயற்கைக்கோளை இந்தியா நிலவுக்கு அனுப்பியுள்ளதாக அப்துல் கலாம் கூறுகிறார்."}}}
{"id": "b-tam-6t1-036", "kind": "statements", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "D", "is_negative": false, "structure": {"kind": "statements", "truth": {"I": true, "II": true, "III": true}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 12"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "நூறு ஆண்டுகளுக்குப் பிறகு இந்தியா எவ்வாறு இருக்கும் என்று அப்துல் கலாம் கணித்த கூற்றுகளை ஆராய்க:"}, {"type": "statement", "label": "I", "text": "ஆயிரம் வருடங்களுக்கு முன்பு நாளந்தா பல்கலைக்கழகத்தில் இருந்ததைப் போல வலுவான கல்வி முறை இருக்கும்."}, {"type": "statement", "label": "II", "text": "அனைத்து இயற்கை வளங்களும் தீர்ந்து போயினும் நாம் அனுப்பிய செயற்கைக்கோள்கள் சூரிய சக்தியைப் பெற்று அளிக்கும்."}, {"type": "statement", "label": "III", "text": "செவ்வாய்க்கோளில் மனித இனம் குடியேறி இருக்கும்."}], "options": [{"key": "A", "text": "I மற்றும் II சரி", "selects": ["I", "II"]}, {"key": "B", "text": "II மற்றும் III சரி", "selects": ["II", "III"]}, {"key": "C", "text": "I மற்றும் III சரி", "selects": ["I", "III"]}, {"key": "D", "text": "அனைத்தும் சரி", "selects": "all"}], "explanation": "அப்துல் கலாம் கூறிய மூன்று எதிர்காலக் கணிப்புகளும் சரியானவை."}}}
{"id": "b-tam-6t1-037", "kind": "direct", "unit_id": "ta-literature", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 12"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அறிவியலின் அடிப்படை கேள்வி கேட்கும் மனப்பான்மைதான்; எனவே குழந்தைகளாகிய நீங்கள்தான் இவ்வுலகின் முதல் விஞ்ஞானிகள்’ - என்று கூறியவர் யார்?"}], "options": [{"key": "A", "text": "சர் சி.வி. இராமன்"}, {"key": "B", "text": "மயில்சாமி அண்ணாதுரை"}, {"key": "C", "text": "டாக்டர் ஏ.பி.ஜே. அப்துல் கலாம்"}, {"key": "D", "text": "டாக்டர் சிவன்"}], "explanation": "கேள்வி கேட்கும் திறனால்தான் அறிவியல் வளர்கிறது, குழந்தைகளின் கேள்விகளுக்கு முடிவே இல்லாததால் குழந்தைகளே முதல் விஞ்ஞானிகள் என்றார் அப்துல் கலாம்."}}}

// ==============================================================================
// பாடம் 4: தமிழ் எழுத்துகளின் வகை தொகையும் மாத்திரையும் (கற்கண்டு - இலக்கணம்) [Q038 - Q047]
// உயிர், மெய், ஆய்தம், மாத்திரை அளவுகள், சொல் மாத்திரை கணக்கீடு
// ==============================================================================
{"id": "b-tam-6t1-038", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 14"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "தமிழ் மொழியின் இலக்கண வகைகள் மொத்தம் எத்தனை?"}], "options": [{"key": "A", "text": "மூன்று"}, {"key": "B", "text": "நான்கு"}, {"key": "C", "text": "ஐந்து"}, {"key": "D", "text": "ஆறு"}], "explanation": "தமிழ் மொழியின் இலக்கண வகைகள் ஐந்து: எழுத்து, சொல், பொருள், யாப்பு, அணி."}}}
{"id": "b-tam-6t1-039", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 14"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "ஒலி வடிவமாக எழுப்பப்படுவதும் வரிவடிவமாக எழுதப்படுவதும் எவ்வாறு அழைக்கப்படுகிறது?"}], "options": [{"key": "A", "text": "சொல்"}, {"key": "B", "text": "எழுத்து"}, {"key": "C", "text": "பொருள்"}, {"key": "D", "text": "யாப்பு"}], "explanation": "ஒலி வடிவமாக எழுப்பப்படுவதும் வரிவடிவமாக எழுதப்படுவதும் எழுத்து எனப்படுகிறது."}}}
{"id": "b-tam-6t1-040", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 14, 15"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "உயிர் எழுத்துகளில் குறில் மற்றும் நெடில் எழுத்துகளின் எண்ணிக்கை முறையே எவை?"}], "options": [{"key": "A", "text": "5 மற்றும் 7"}, {"key": "B", "text": "7 மற்றும் 5"}, {"key": "C", "text": "6 மற்றும் 6"}, {"key": "D", "text": "5 மற்றும் 8"}], "explanation": "அ, இ, உ, எ, ஒ ஆகிய ஐந்தும் குறில் எழுத்துகள்; ஆ, ஈ, ஊ, ஏ, ஐ, ஓ, ஔ ஆகிய ஏழும் நெடில் எழுத்துகள்."}}}
{"id": "pyq-tam-6t1-041", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2019, "paper": "tamil", "no": 41}, "texts": {"ta": {"blocks": [{"type": "text", "text": "இலக்கணத்தில் 'மாத்திரை' என்பது எதனைக் குறிக்கும் அளவாகும்?"}], "options": [{"key": "A", "text": "எழுத்துகளை உச்சரிக்கும் கால அளவு"}, {"key": "B", "text": "எழுத்துகளின் வரிவடிவ அளவு"}, {"key": "C", "text": "எழுத்துகளின் ஒலிப்பு விசை"}, {"key": "D", "text": "சொற்களின் நீள அளவு"}], "explanation": "மாத்திரை என்பது இங்குக் கால அளவைக் குறிக்கிறது. ஒருமுறை கண் இமைக்கவோ கைநொடிக்கவோ ஆகும் கால அளவு ஒரு மாத்திரை."}}}
{"id": "b-tam-6t1-042", "kind": "match", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "2", "B": "1", "C": "3", "D": "3"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 15, 16"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "எழுத்துகளையும் அவற்றின் மாத்திரை அளவுகளையும் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "எழுத்து வகை", "items": [{"label": "A", "text": "குறில் எழுத்து"}, {"label": "B", "text": "நெடில் எழுத்து"}, {"label": "C", "text": "மெய் எழுத்து"}, {"label": "D", "text": "ஆய்த எழுத்து"}]}, {"type": "list", "name": "மாத்திரை அளவு", "items": [{"label": "1", "text": "இரண்டு மாத்திரை"}, {"label": "2", "text": "ஒரு மாத்திரை"}, {"label": "3", "text": "அரை மாத்திரை"}, {"label": "4", "text": "கால் மாத்திரை"}]}], "options": [{"key": "A", "text": "A-2, B-1, C-3, D-3", "mapping": {"A": "2", "B": "1", "C": "3", "D": "3"}}, {"key": "B", "text": "A-1, B-2, C-3, D-3", "mapping": {"A": "1", "B": "2", "C": "3", "D": "3"}}, {"key": "C", "text": "A-2, B-1, C-4, D-3", "mapping": {"A": "2", "B": "1", "C": "4", "D": "3"}}, {"key": "D", "text": "A-1, B-2, C-4, D-3", "mapping": {"A": "1", "B": "2", "C": "4", "D": "3"}}], "explanation": "குறில் = 1 மாத்திரை, நெடில் = 2 மாத்திரை, மெய் = அரை மாத்திரை, ஆய்தம் = அரை மாத்திரை."}}}
{"id": "b-tam-6t1-043", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 15"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "வன்மையாகவும் இல்லாமல், மென்மையாகவும் இல்லாமல் இரண்டிற்கும் இடைப்பட்டு ஒலிக்கும் 'இடையின' மெய்யெழுத்துகள் எவை?"}], "options": [{"key": "A", "text": "க், ச், ட், த், ப், ற்"}, {"key": "B", "text": "ங், ஞ், ண், ந், ம், ன்"}, {"key": "C", "text": "ய், ர், ல், வ், ழ், ள்"}, {"key": "D", "text": "க், ங், ச், ஞ், ட், ண்"}], "explanation": "ய், ர், ல், வ், ழ், ள் ஆகிய ஆறும் வன்மையாகவும் மென்மையாகவும் இல்லாமல் இடைப்பட்டு ஒலிப்பதால் இடையினம் எனப்படும்."}}}
{"id": "b-tam-6t1-044", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 16"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "மெய் எழுத்துகள் பதினெட்டுடன் உயிர் எழுத்துகள் பன்னிரண்டும் சேர்வதால் தோன்றும் உயிர்மெய் எழுத்துகளின் மொத்த எண்ணிக்கை யாது?"}], "options": [{"key": "A", "text": "30 எழுத்துகள்"}, {"key": "B", "text": "216 எழுத்துகள்"}, {"key": "C", "text": "247 எழுத்துகள்"}, {"key": "D", "text": "108 எழுத்துகள்"}], "explanation": "18 x 12 = 216 உயிர்மெய் எழுத்துகள் தோன்றுகின்றன."}}}
{"id": "pyq-tam-6t1-045", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "past_paper", "exam": "g4", "year": 2022, "paper": "tamil", "no": 47}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘கபிலர்’ என்னும் சொல்லிற்குரிய மொத்த மாத்திரை அளவு யாது?"}], "options": [{"key": "A", "text": "4 மாத்திரை"}, {"key": "B", "text": "3 மாத்திரை"}, {"key": "C", "text": "3.5 மாத்திரை"}, {"key": "D", "text": "2.5 மாத்திரை"}], "explanation": "க (குறில் = 1) + பி (குறில் = 1) + ல (குறில் = 1) + ர் (மெய் = 0.5) = 1 + 1 + 1 + 0.5 = 3.5 மாத்திரை."}}}
{"id": "b-tam-6t1-046", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 16"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பாடநூல் மதிப்பீட்டின்படி, ஆய்த எழுத்து இடம்பெறும் இரண்டரை (2½) மாத்திரை அளவுள்ள சொல்லுக்குச் சரியான எடுத்துக்காட்டு எது?"}], "options": [{"key": "A", "text": "அஃது"}, {"key": "B", "text": "எஃகு"}, {"key": "C", "text": "அஃறிணை"}, {"key": "D", "text": "கஃசு"}], "explanation": "எ (குறில் = 1) + ஃ (ஆய்தம் = 0.5) + கு (குறில் = 1) = 2.5 மாத்திரை."}}}
{"id": "b-tam-6t1-047", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 16"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "இரண்டு மாத்திரை அளவு கொண்ட ஓரெழுத்துச் சொல்லுக்கு எடுத்துக்காட்டு எது?"}], "options": [{"key": "A", "text": "அ"}, {"key": "B", "text": "தீ"}, {"key": "C", "text": "க்"}, {"key": "D", "text": "ஃ"}], "explanation": "நெடில் எழுத்துகள் தனித்து நிற்கும் போது இரண்டு மாத்திரை பெறும். (எ.கா: தீ, பூ, கை, மா)."}}}

// ==============================================================================
// பாடம் 5: மொழியை ஆள்வோம், மொழி விளையாட்டு & கலைச்சொற்கள் [Q048 - Q054]
// புதிய சொற்கள் உருவாக்கம், கடித வகைகள், கலைச்சொற்கள் (Clockwise, Internet, etc.)
// ==============================================================================
{"id": "b-tam-6t1-048", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 18"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘பதிற்றுப்பத்து’ என்னும் சொல்லிலுள்ள எழுத்துகளை மட்டுமே பயன்படுத்தி உருவாக்க இயலாத சொல் எது?"}], "options": [{"key": "A", "text": "பத்து"}, {"key": "B", "text": "பதி"}, {"key": "C", "text": "பரி"}, {"key": "D", "text": "பற்று"}], "explanation": "'பதிற்றுப்பத்து' என்னும் சொல்லில் 'ரி' என்ற எழுத்து இல்லை. எனவே 'பரி' என்ற சொல்லை உருவாக்க முடியாது."}}}
{"id": "b-tam-6t1-049", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 18"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பாடநூல் மொழி விளையாட்டின்படி 'விண்' என்ற சொல்லோடு பொருந்தும் மற்றொரு சொல் இணைந்து உருவாகும் புதிய சொல் எது?"}], "options": [{"key": "A", "text": "விண்வெளி"}, {"key": "B", "text": "விண்மீன்"}, {"key": "C", "text": "விண்மழை"}, {"key": "D", "text": "விண்கோள்"}], "explanation": "பக்கம் 18-ல் இரண்டு சொற்களை இணைத்துப் புதிய சொல் உருவாக்குக பயிற்சியில் 'விண் + மீன் = விண்மீன்' எடுத்துக்காட்டாகத் தரப்பட்டுள்ளது."}}}
{"id": "b-tam-6t1-050", "kind": "match", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "2", "B": "1", "C": "4", "D": "3"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 18"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"}, {"type": "list", "name": "ஆங்கிலக் கலைச்சொல்", "items": [{"label": "A", "text": "Clock wise"}, {"label": "B", "text": "Anti Clock wise"}, {"label": "C", "text": "Search engine"}, {"label": "D", "text": "Voice Search"}]}, {"type": "list", "name": "தமிழாக்கம்", "items": [{"label": "1", "text": "இடஞ்சுழி"}, {"label": "2", "text": "வலஞ்சுழி"}, {"label": "3", "text": "குரல்தேடல்"}, {"label": "4", "text": "தேடுபொறி"}]}], "options": [{"key": "A", "text": "A-2, B-1, C-4, D-3", "mapping": {"A": "2", "B": "1", "C": "4", "D": "3"}}, {"key": "B", "text": "A-1, B-2, C-4, D-3", "mapping": {"A": "1", "B": "2", "C": "4", "D": "3"}}, {"key": "C", "text": "A-2, B-1, C-3, D-4", "mapping": {"A": "2", "B": "1", "C": "3", "D": "4"}}, {"key": "D", "text": "A-4, B-3, C-2, D-1", "mapping": {"A": "4", "B": "3", "C": "2", "D": "1"}}], "explanation": "Clock wise = வலஞ்சுழி, Anti Clock wise = இடஞ்சுழி, Search engine = தேடுபொறி, Voice Search = குரல்தேடல்."}}}
{"id": "b-tam-6t1-051", "kind": "match", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "A", "structure": {"kind": "match", "pairs": {"A": "3", "B": "1", "C": "4", "D": "2"}}, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 18"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "கலைச்சொற்களைச் சரியாகப் பொருத்துக:"}, {"type": "list", "name": "ஆங்கிலக் கலைச்சொல்", "items": [{"label": "A", "text": "Internet"}, {"label": "B", "text": "Touch Screen"}, {"label": "C", "text": "App"}, {"label": "D", "text": "E-mail"}]}, {"type": "list", "name": "தமிழாக்கம்", "items": [{"label": "1", "text": "தொடுதிரை"}, {"label": "2", "text": "மின்னஞ்சல்"}, {"label": "3", "text": "இணையம்"}, {"label": "4", "text": "செயலி"}]}], "options": [{"key": "A", "text": "A-3, B-1, C-4, D-2", "mapping": {"A": "3", "B": "1", "C": "4", "D": "2"}}, {"key": "B", "text": "A-1, B-3, C-4, D-2", "mapping": {"A": "1", "B": "3", "C": "4", "D": "2"}}, {"key": "C", "text": "A-3, B-1, C-2, D-4", "mapping": {"A": "3", "B": "1", "C": "2", "D": "4"}}, {"key": "D", "text": "A-4, B-1, C-3, D-2", "mapping": {"A": "4", "B": "1", "C": "3", "D": "2"}}], "explanation": "Internet = இணையம், Touch Screen = தொடுதிரை, App = செயலி, E-mail = மின்னஞ்சல்."}}}
{"id": "b-tam-6t1-052", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "C", "is_negative": false, "source": {"type": "book", "ref": "6-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 17"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "பாடநூல் கடிதம் எழுதும் முறையின்படி கடிதத்தின் இரு முக்கிய வகைகள் யாவை?"}], "options": [{"key": "A", "text": "நட்புக் கடிதம், வணிகக் கடிதம்"}, {"key": "B", "text": "விண்ணப்பக் கடிதம், புகார்க் கடிதம்"}, {"key": "C", "text": "உறவுமுறைக் கடிதம், அலுவலகக் கடிதம்"}, {"key": "D", "text": "அழைப்புக் கடிதம், வாழ்த்துக் கடிதம்"}], "explanation": "கடிதம் இரண்டு வகைப்படும். அவை உறவுமுறைக் கடிதம், அலுவலகக் கடிதம் என்பவையாகும்."}}}
{"id": "extra-tam-6t1-053", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "other", "note": "இலக்கண மாத்திரை கணக்கீடு தேர்வு வினா"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘அஃது’ என்னும் சொல்லின் மொத்த மாத்திரை அளவு யாது?"}], "options": [{"key": "A", "text": "இரண்டரை மாத்திரை"}, {"key": "B", "text": "இரண்டு மாத்திரை (குற்றியலுகர விதிப்படி) / இரண்டரை மாத்திரை (இயல்புப்படி)"}, {"key": "C", "text": "மூன்று மாத்திரை"}, {"key": "D", "text": "ஒன்றரை மாத்திரை"}], "explanation": "அ (குறில் = 1) + ஃ (ஆய்தம் = 0.5) + து (குற்றியலுகரம் = 0.5) = 2 மாத்திரை. (இயல்பு மாத்திரை எனில் 2.5)."}}}
{"id": "extra-tam-6t1-054", "kind": "direct", "unit_id": "ta-grammar", "level": "SSLC", "correct_key": "B", "is_negative": false, "source": {"type": "other", "note": "வளர்தமிழ் நுட்ப வினா"}, "texts": {"ta": {"blocks": [{"type": "text", "text": "‘மொழியைக் கணினியில் பயன்படுத்த வேண்டும் எனில் அஃது எதன் அடிப்படையில் வடிவமைக்கப்பட வேண்டும்?’ என்று வளர்தமிழ் பாடம் குறிப்பிடுகிறது?"}], "options": [{"key": "A", "text": "எழுத்துகளின்"}, {"key": "B", "text": "எண்களின்"}, {"key": "C", "text": "ஒலிகளின்"}, {"key": "D", "text": "குறியீடுகளின்"}], "explanation": "மொழியைக் கணினியில் பயன்படுத்த வேண்டும் என்றால் அஃது எண்களின் (Numbers/Binary) அடிப்படையில் வடிவமைக்கப்பட வேண்டும்."}}}
