// ==============================================================================
// 8-ஆம் வகுப்பு தமிழ் - இயல் 5
// பாடம் 2: கொங்குநாட்டு வணிகம் (உரைநடை உலகம் - கொங்கு மண்டலம்)
// வினாக்கள் எண்ணிக்கை: 15
// கொங்கு மண்டலம் (பண்டைய சேர நாட்டுப் பகுதி, கார்மேகக் கவிஞர் இயற்றிய கொங்கு மண்டல சதகம்),
// நான்கு எல்லைகள் (வடக்கே பெரும்பாலை, தெற்கே பழனிமலை, மேற்கே வெள்ளிமலை, கிழக்கே மதிற்கூரை),
// தாலமி (கரூர்/வஞ்சி உள்நாட்டு வணிக மையம்), உமணர் உப்பு-நெல் பண்டமாற்று (அகநானூறு 390),
// முசிறி துறைமுகம் (மிளகு, முத்து, தந்தம் ஏற்றுமதி, அரபு/ரோமானியக் கப்பல்கள்),
// உரோமானிய நாணயங்கள் அகழ்வு (வெள்ளலூர், கோவை), கொங்கு நாட்டு கைத்தறி நெசவு (ஈரோடு, சென்னிமலை, திருப்பூர்),
// பாலக்காட்டுக் கணவாய் மற்றும் தாராபுரம் பெருவழி
// ==============================================================================
{"id":"b-tam-8t5-004","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 97"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கொங்குநாட்டு வணிகம்’ என்னும் உரைநடைப் பகுதி எந்த மண்டலத்தின் வர்த்தகச் சிறப்பை விளக்குகிறது?"}],"options":[{"key":"A","text":"சோழ மண்டலம்"},{"key":"B","text":"பாண்டிய மண்டலம்"},{"key":"C","text":"கொங்கு மண்டலம்"},{"key":"D","text":"தொண்டை மண்டலம்"}],"explanation":"பண்டைய சேர நாட்டுப் பகுதியான கொங்கு மண்டலத்தின் உள்நாட்டு மற்றும் வெளிநாட்டு வணிகச் சிறப்புகளை இப்பாடம் விளக்குகிறது."}}}
{"id":"b-tam-8t5-005","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 97"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நான்கு எல்லைகளுக்கு உட்பட்ட பகுதியாகக் கொங்கு மண்டலம் விளங்கியது’ எனக் கூறும் நூல் எது?"}],"options":[{"key":"A","text":"சிலப்பதிகாரம்"},{"key":"B","text":"கொங்கு மண்டல சதகம் (கார்மேகக் கவிஞர்)"},{"key":"C","text":"பெரியபுராணம்"},{"key":"D","text":"மணிமேகலை"}],"explanation":"வடக்கே பெரும்பாலை, தெற்கே பழனிமலை, மேற்கே வெள்ளிமலை, கிழக்கே மதிற்கூரை என எல்லைகளைக் கூறும் நூல் கொங்கு மண்டல சதகம் ஆகும்."}}}
{"id":"pyq-tam-8t5-006","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":35},"texts":{"ta":{"blocks":[{"type":"text","text":"கிரேக்க அறிஞர் தாலமி தமிழகத்தின் முதன்மை உள்நாட்டு வணிக மையமாகக் குறிப்பிட்ட நகரம் எது?"}],"options":[{"key":"A","text":"மதுரை"},{"key":"B","text":"கரூர் (வஞ்சிமா நகரம்)"},{"key":"C","text":"உறையூர்"},{"key":"D","text":"காஞ்சிபுரம்"}],"explanation":"கிரேக்க அறிஞர் தாலமி கரூரைத் தமிழகத்தின் முதன்மை உள்நாட்டு வணிக மையமாகக் குறிப்பிட்டுள்ளார்."}}}
{"id":"b-tam-8t5-007","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 98"},"texts":{"ta":{"blocks":[{"type":"text","text":"பண்டைய காலத்தில் சேர நாட்டில் பொருள்களின் விலையைக் கணக்கிட அடிப்படையாக விளங்கிய பொருள் எது?"}],"options":[{"key":"A","text":"தங்கம்"},{"key":"B","text":"நெல் (உப்பும் நெல்லும் ஒரே மதிப்புடையன)"},{"key":"C","text":"செம்பு நாணயம்"},{"key":"D","text":"முத்து"}],"explanation":"பண்டமாற்று முறையில் நெல்லே விலையைக் கணக்கிட அடிப்படையாக இருந்தது என்பதை அகநானூற்றுப் பாடல்கள் (390) உறுதிப்படுத்துகின்றன."}}}
{"id":"b-tam-8t5-008","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 99"},"texts":{"ta":{"blocks":[{"type":"text","text":"சேரர்களின் சிறந்த துறைமுகங்களில் ஒன்றாக விளங்கியதும், வெளிநாட்டு வணிகம் சிறப்பிடம் பெற்றதுமான துறைமுகம் எது?"}],"options":[{"key":"A","text":"பூம்புகார்"},{"key":"B","text":"முசிறி துறைமுகம்"},{"key":"C","text":"கொற்கை"},{"key":"D","text":"நாகப்பட்டினம்"}],"explanation":"முசிறி துறைமுகத்திலிருந்து மிளகு, முத்து, யானைத் தந்தங்கள் போன்றவை வெளிநாடுகளுக்கு ஏற்றுமதி செய்யப்பட்டன."}}}
{"id":"b-tam-8t5-022","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 97"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கொங்கு மண்டல சதகம்’ என்னும் நூலை இயற்றியவர் யார்?"}],"options":[{"key":"A","text":"கம்பர்"},{"key":"B","text":"கார்மேகக் கவிஞர்"},{"key":"C","text":"ஒட்டக்கூத்தர்"},{"key":"D","text":"புகழேந்தி"}],"explanation":"கொங்கு மண்டலத்தின் எல்லைகளைக் கூறும் நூலான 'கொங்கு மண்டல சதகத்தை' இயற்றியவர் கார்மேகக் கவிஞர் ஆவார்."}}}
{"id":"b-tam-8t5-023","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 98"},"texts":{"ta":{"blocks":[{"type":"text","text":"பண்டைய காலத்தில் கொங்கு நாட்டில் உற்பத்தியாகி வெளிநாடுகளுக்கு ஏற்றுமதி செய்யப்பட்ட உணவுப் பொருள் மற்றும் மசாலாப் பொருள் எது?"}],"options":[{"key":"A","text":"அரிசி மற்றும் மஞ்சள்"},{"key":"B","text":"மிளகு, மஞ்சள் மற்றும் அரிசி வகைகள்"},{"key":"C","text":"கரும்பு மற்றும் பருத்தி"},{"key":"D","text":"ஏலக்காய் மற்றும் கிராம்பு"}],"explanation":"கொங்கு மண்டலத்தில் விளைந்த மிளகு, மஞ்சள், அரிசி ஆகியவை ரோமாபுரி உள்ளிட்ட நாடுகளுக்கு ஏற்றுமதி செய்யப்பட்டன."}}}
{"id":"b-tam-8t5-024","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 98"},"texts":{"ta":{"blocks":[{"type":"text","text":"கொங்கு நாட்டுப் பகுதிகளில் எந்தெந்த ஊர்கள் கைத்தறி நெசவுக்கும் ஆடைகளுக்கும் புகழ்பெற்றவை?"}],"options":[{"key":"A","text":"மதுரை, திருநெல்வேலி"},{"key":"B","text":"ஈரோடு, சென்னிமலை, திருப்பூர், காஞ்சிபுரம்"},{"key":"C","text":"தஞ்சாவூர், கும்பகோணம்"},{"key":"D","text":"நாகை, மயிலாடுதுறை"}],"explanation":"ஈரோடு, சென்னிமலை, திருப்பூர் போன்ற கொங்குப் பகுதிகள் கைத்தறி மற்றும் ஆடை உற்பத்திற்குக் காலம்காலமாகப் புகழ்பெற்றவை."}}}
{"id":"b-tam-8t5-025","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 99"},"texts":{"ta":{"blocks":[{"type":"text","text":"கொங்கு நாட்டின் வழியாகச் சென்று மேற்குத் கடற்கரைத் துறைமுகங்களை இணைத்த பெருவழி எது?"}],"options":[{"key":"A","text":"மதராஸ் பெருவழி"},{"key":"B","text":"பாலக்காட்டுக் கணவாய் மற்றும் தாராபுரம் பெருவழி"},{"key":"C","text":"காவிரிப் பூம்புகார் சாலை"},{"key":"D","text":"தென்மதுரைச் சாலை"}],"explanation":"கொங்கு நாட்டிலிருந்து மேற்குத் திசையிலுள்ள முசிறி உள்ளிட்ட துறைமுகங்களுக்குச் செல்லப் பல வணிகப் பெருவழிகள் பயன்பட்டன."}}}
{"id":"b-tam-8t5-038","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 97"},"texts":{"ta":{"blocks":[{"type":"text","text":"சங்க காலத்தில் கொங்கு மண்டலம் எந்தெந்த மன்னர்களால் ஆளப்பட்ட பகுதியாகும்?"}],"options":[{"key":"A","text":"சோழர்கள்"},{"key":"B","text":"சேர மன்னர்கள்"},{"key":"C","text":"பாண்டியர்கள்"},{"key":"D","text":"பல்லவர்கள்"}],"explanation":"கொங்கு மண்டலம் என்பது பழந்தமிழகத்தில் சேர மன்னர்களின் ஆட்சியின் கீழ் இருந்த பகுதியாகும்."}}}
{"id":"b-tam-8t5-039","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 98"},"texts":{"ta":{"blocks":[{"type":"text","text":"அகநானூற்றுப் பாடல்களில் (390) கொங்கு நாட்டு வணிகம் குறித்து உமணர்கள் எதனைப் பரிமாறிக்கொண்டதாகக் கூறப்பட்டுள்ளது?"}],"options":[{"key":"A","text":"பொன்னும் மணியும்"},{"key":"B","text":"உப்புடன் நெல்லை விற்றுப் பரிமாறிக் கொண்டது"},{"key":"C","text":"பட்டுத் துணிகள்"},{"key":"D","text":"மிளகும் சந்தனமும்"}],"explanation":"உமணர் வண்டிகளில் உப்பை ஏற்றிச் சென்று நெல்லுடன் மாற்றிப் பெற்றனர்."}}}
{"id":"b-tam-8t5-040","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 99"},"texts":{"ta":{"blocks":[{"type":"text","text":"கொங்கு நாட்டின் எந்தப் பகுதியில் உரோமானியர்களின் தங்க நாணயங்கள் அதிகளவில் கண்டெடுக்கப்பட்டுள்ளன?"}],"options":[{"key":"A","text":"ஈரோடு மற்றும் சேலம்"},{"key":"B","text":"கோயம்புத்தூர் பகுதி (வெள்ளலூர்)"},{"key":"C","text":"திருப்பூர் மற்றும் கரூர்"},{"key":"D","text":"நீலகிரி மலை"}],"explanation":"கொங்கு நாட்டுடன் ரோமாபுரி வணிகம் சிறந்து விளங்கியதற்கு வெள்ளலூர் உள்ளிட்ட பகுதிகளில் கிடைத்த உரோமானிய நாணயங்கள் சான்றாகும்."}}}
{"id":"b-tam-8t5-049","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 97"},"texts":{"ta":{"blocks":[{"type":"text","text":"கொங்கு நாட்டின் வடக்கேயுள்ள எல்லையாகக் ‘கொங்கு மண்டல சதகம்’ கூறுவது எது?"}],"options":[{"key":"A","text":"பழனிமலை"},{"key":"B","text":"பெரும்பாலை"},{"key":"C","text":"வெள்ளிமலை"},{"key":"D","text":"மதிற்கூரை"}],"explanation":"வடக்கே பெரும்பாலை, தெற்கே பழனிமலை, மேற்கே வெள்ளிமலை, கிழக்கே மதிற்கூரை என்பன கொங்கு மண்டலத்தின் எல்லைகளாகும்."}}}
{"id":"b-tam-8t5-050","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 99"},"texts":{"ta":{"blocks":[{"type":"text","text":"பண்டைய சேர நாட்டின் தலைநகரமாக விளங்கியது எது?"}],"options":[{"key":"A","text":"முசிறி"},{"key":"B","text":"வஞ்சி (கரூர்)"},{"key":"C","text":"தொண்டை"},{"key":"D","text":"கொற்கை"}],"explanation":"சேர மன்னர்களின் தலைநகரம் வஞ்சி (தற்கால கரூர்) ஆகும்."}}}
{"id":"b-tam-8t5-051","kind":"assertion_reason","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 97"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"பண்டைய கொங்கு நாடு உள்நாட்டு மற்றும் வெளிநாட்டு வணிகத்தில் மிகச்சிறந்து விளங்கியது."},{"type":"reason","text":"இப்பகுதியில் உரோமானிய நாணயங்கள் அகழ்வில் கிடைத்தமையும், முசிறி துறைமுகத்தின் வழியாக மிளகு உள்ளிட்ட பொருள்கள் ஏற்றுமதி செய்யப்பட்டமையும் சான்றாகும்."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"கொங்கு நாட்டின் வணிகச் சிறப்பை தொல்லியல் சான்றுகள் மெய்ப்பிக்கின்றன; கூற்றும் காரணமும் சரி."}}}
