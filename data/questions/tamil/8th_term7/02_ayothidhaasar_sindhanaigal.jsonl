// பன்மொழிப் புலமை (தமிழ், சமஸ்கிருதம், பாலி, ஆங்கிலம்), திராவிட மகா சபை
// ==============================================================================
{"id":"b-tam-8t7-005","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 136"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அயோத்திதாசர் சிந்தனைகள்’ என்னும் உரைநடைப் பகுதி எத்தகைய சீர்திருத்தச் சிந்தனைகளை விளக்குகிறது?"}],"options":[{"key":"A","text":"அரசியல் போராட்டம்"},{"key":"B","text":"கல்வி, சமத்துவம், பகுத்தறிவு மற்றும் சமூகச் சீர்திருத்தம்"},{"key":"C","text":"சினிமாத்துறை வளர்ச்சி"},{"key":"D","text":"வெளிநாட்டு வணிகம்"}],"explanation":"பண்டித அயோத்திதாசரின் சமூக சீர்திருத்தம் மற்றும் கல்விப் பணிகள் இப்பாடலில் விளக்கப்பட்டுள்ளன."}}}
{"id":"b-tam-8t7-006","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 137"},"texts":{"ta":{"blocks":[{"type":"text","text":"பண்டித அயோத்திதாசர் தொடங்கிய வார இதழ் மற்றும் நாளிதழின் பெயர் என்ன?"}],"options":[{"key":"A","text":"இந்தியா, விஜயா"},{"key":"B","text":"ஒருபைசாத் தமிழன் (வார இதழ்) மற்றும் தமிழன் (நாளிதழ்)"},{"key":"C","text":"குடியரசு, விடுதலை"},{"key":"D","text":"கலைமகள், அமுது"}],"explanation":"அயோத்திதாசர் 1907-இல் 'ஒருபைசாத் தமிழன்' வார இதழைத் தொடங்கிப் பின்னர் 'தமிழன்' என மாற்றினார்."}}}
{"id":"b-tam-8t7-007","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 138"},"texts":{"ta":{"blocks":[{"type":"text","text":"அயோத்திதாசர் பதிப்பித்த நூல்களுள் பொருந்தாத ஒன்றைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"போகர் எழுநூறு"},{"key":"B","text":"திருக்குறள் மெய்ப்பொருளுரை"},{"key":"C","text":"அகத்தியர் இருநூறு"},{"key":"D","text":"இலக்கண விளக்கம்"}],"explanation":"அயோத்திதாசர் போகர் எழுநூறு, அகத்தியர் இருநூறு உள்ளிட்ட மருத்துவ நூல்களைப் பதிப்பித்துள்ளார்."}}}
{"id":"b-tam-8t7-020","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 136"},"texts":{"ta":{"blocks":[{"type":"text","text":"பண்டித அயோத்திதாசர் எம்மொழியிலும் ஆங்கிலத்திலும் சிறந்த புலமை பெற்றிருந்தார்?"}],"options":[{"key":"A","text":"தெலுங்கு மற்றும் பிராகிருதம்"},{"key":"B","text":"சமஸ்கிருதம், பாலி மற்றும் ஆங்கிலம்"},{"key":"C","text":"இந்தி மற்றும் உருது"},{"key":"D","text":"மலையாளம் மற்றும் கன்னடம்"}],"explanation":"அயோத்திதாசர் தமிழ் மட்டுமன்றிச் சமஸ்கிருதம், பாலி, ஆங்கிலம் ஆகிய மொழிகளிலும் தேர்ச்சி பெற்றவர்."}}}
{"id":"b-tam-8t7-024","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 137"},"texts":{"ta":{"blocks":[{"type":"text","text":"பண்டித அயோத்திதாசர் நிறுவிய அமைப்பின் பெயர் என்ன?"}],"options":[{"key":"A","text":"சமத்துவச் சங்கம்"},{"key":"B","text":"அத்துஆவைத் சங்கம் / திராவிட மகா சபை"},{"key":"C","text":"நீதிக்கட்சி"},{"key":"D","text":"சுயமரியாதை இயக்கம்"}],"explanation":"அயோத்திதாசர் சாதி மறுப்பு மற்றும் சமூக முன்னேற்றத்திற்காகத் திராவிட மகா சபை போன்ற அமைப்புகளை உருவாக்க உதவினார்."}}}
