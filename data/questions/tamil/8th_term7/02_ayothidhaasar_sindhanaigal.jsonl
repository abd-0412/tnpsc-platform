// 8-ஆம் வகுப்பு - இயல் 7: அயோத்திதாசர் சிந்தனைகள் (உரைநடை)
// Total Questions: 6
// ==============================================================================
{"id":"b-tam-8t7-009","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 136"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அயோத்திதாசர் சிந்தனைகள்’ என்னும் உரைநடைப் பகுதி எத்தகைய சீர்திருத்தச் சிந்தனைகளை விளக்குகிறது?"}],"options":[{"key":"A","text":"அரசியல் போராட்டம்"},{"key":"B","text":"கல்வி, சமத்துவம், பகுத்தறிவு மற்றும் சமூகச் சீர்திருத்தம்"},{"key":"C","text":"சினிமாத்துறை வளர்ச்சி"},{"key":"D","text":"வெளிநாட்டு வணிகம்"}],"explanation":"பண்டித அயோத்திதாசரின் சமூக சீர்திருத்தம் மற்றும் கல்விப் பணிகள் இப்பாடலில் விளக்கப்பட்டுள்ளன."}}}
{"id":"b-tam-8t7-010","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 137"},"texts":{"ta":{"blocks":[{"type":"text","text":"பண்டித அயோத்திதாசர் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"இவர் 1907-இல் 'ஒருபைசாத் தமிழன்' என்னும் வார இதழைத் தொடங்கினார்."},{"type":"statement","label":"II","text":"பின்னர் அந்த இதழின் பெயர் 'தமிழன்' என மாற்றப்பட்டது."},{"type":"statement","label":"III","text":"இவர் சமஸ்கிருதம், பாலி, ஆங்கிலம் ஆகிய மொழிகளிலும் புலமை பெற்றவர்."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"அயோத்திதாசர் பற்றிய மேற்கண்ட மூன்று கூற்றுகளும் முற்றிலும் சரியானவை."}}}
{"id":"b-tam-8t7-011","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 138"},"texts":{"ta":{"blocks":[{"type":"text","text":"அயோத்திதாசர் பதிப்பித்த மருத்துவ நூல்களுள் ஒன்று எது?"}],"options":[{"key":"A","text":"திருக்குறள் மெய்ப்பொருளுரை"},{"key":"B","text":"போகர் எழுநூறு மற்றும் அகத்தியர் இருநூறு"},{"key":"C","text":"அகநானூறு"},{"key":"D","text":"மணிமேகலை"}],"explanation":"அயோத்திதாசர் போகர் எழுநூறு, அகத்தியர் இருநூறு உள்ளிட்ட பல மருத்துவ நூல்களைப் பதிப்பித்துள்ளார்."}}}
{"id":"b-tam-8t7-012","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 136"},"texts":{"ta":{"blocks":[{"type":"text","text":"பண்டித அயோத்திதாசர் எந்தெந்த மொழிகளில் புலமை பெற்றிருந்தார்?"}],"options":[{"key":"A","text":"தமிழ் மட்டும்"},{"key":"B","text":"தமிழ், சமஸ்கிருதம், பாலி, ஆங்கிலம்"},{"key":"C","text":"தெலுங்கு, இந்தி"},{"key":"D","text":"மலையாளம், உருது"}],"explanation":"அயோத்திதாசர் தமிழ் மட்டுமின்றிச் சமஸ்கிருதம், பாலி, ஆங்கிலம் ஆகிய மொழிகளிலும் தேர்ச்சி பெற்றவர்."}}}
{"id":"b-tam-8t7-013","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 137"},"texts":{"ta":{"blocks":[{"type":"text","text":"பண்டித அயோத்திதாசர் தொடங்கிய வார இதழ் எது?"}],"options":[{"key":"A","text":"இந்தியா"},{"key":"B","text":"ஒருபைசாத் தமிழன்"},{"key":"C","text":"குடியரசு"},{"key":"D","text":"விடுதலை"}],"explanation":"அயோத்திதாசர் 1907-இல் 'ஒருபைசாத் தமிழன்' வார இதழைத் தொடங்கினார்."}}}
{"id":"b-tam-8t7-014","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 137"},"texts":{"ta":{"blocks":[{"type":"text","text":"பண்டித அயோத்திதாசர் நிறுவிய அமைப்புகளில் ஒன்று எது?"}],"options":[{"key":"A","text":"சுயமரியாதை இயக்கம்"},{"key":"B","text":"திராவிட மகா சபை (அத்துஆவைத் சங்கம்)"},{"key":"C","text":"நீதிக்கட்சி"},{"key":"D","text":"சமத்துவச் சங்கம்"}],"explanation":"அயோத்திதாசர் சாதி மறுப்பு மற்றும் சமூக முன்னேற்றத்திற்காகத் திராவிட மகா சபை போன்ற அமைப்புகளை உருவாக்க உதவினார்."}}}
