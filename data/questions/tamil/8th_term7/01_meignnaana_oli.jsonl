// 8-ஆம் வகுப்பு தமிழ் - இயல் 7
// பாடம் 1: மெய்ஞ்ஞான ஒளி (கவிதைப்பேழை - தாயுமானவர்)
// வினாக்கள் எண்ணிக்கை: 6
// மெய்ஞ்ஞான ஒளி - தாயுமானவர் (பராபரக்கண்ணி),
// திருச்சி ஆண்ட விஜய ரகுநாத சொக்கலிங்க நாயக்கரிடம் தலைமைப் கணக்கர்,
// சொல்லும் பொருளும் (செந்நாப் போதார்: வள்ளுவர், வையகம்: உலகம், ஓதும்: சொல்லும், பொச்சாப்பு: சோம்பல்),
// எல்லாரும் இன்புற்றிருக்க நினைப்பதுவே அல்லாமல் வேறொன்றறியேன் பராபரமே (PYQ 2019),
// ஆன்மீகச் சமத்துவம், மெய்ஞ்ஞான ஜோதி
// ==============================================================================
{"id":"b-tam-8t7-001","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 132"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஒன்றே குலமும் ஒருவனே தேவனும் நன்றே நினைமின் நமக்குள் நமமில்லை...’ - என்னும் ‘மெய்ஞ்ஞான ஒளி’ பாடலை இயற்றியவர் யார்?"}],"options":[{"key":"A","text":"திருமூலர்"},{"key":"B","text":"தாயுமானவர்"},{"key":"C","text":"பட்டினத்தார்"},{"key":"D","text":"இராமலிங்க அடிகளார்"}],"explanation":"பராபரக் கண்ணி பாடல்கள் மூலம் அனைத்துயிர்களையும் ஒன்றாய் எண்ணும் தாயுமானவர் இப்பாடலை இயற்றியுள்ளார்."}}}
{"id":"b-tam-8t7-002","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 133"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மெய்ஞ்ஞான ஒளி’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"செந்நாப் போதார்"},{"label":"B","text":"வையகம்"},{"label":"C","text":"ஓதும்"},{"label":"D","text":"பொச்சாப்பு"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"உலகம்"},{"label":"2","text":"சோம்பல் / சோர்வு"},{"label":"3","text":"நூல்களைச் சொன்ன சான்றோர் (திருவள்ளுவர்)"},{"label":"4","text":"சொல்லும்"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}}],"explanation":"செந்நாப் போதார் = செவ்விய நாவினை உடைய சான்றோர் (வள்ளுவர்); வையம் = உலகம்; ஓதும் = சொல்லும்; பொச்சாப்பு = சோம்பல்; மடி = சோம்பல்; மையல் = மயக்கம்; தார் = மாலை."}}}
{"id":"b-tam-8t7-003","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 133"},"texts":{"ta":{"blocks":[{"type":"text","text":"திருச்சி விஜய ரகுநாத சேரிடம் தலைமைப் கணக்கராகப் பணிபுரிந்த ஆன்மீகக் கவிஞர் யார்?"}],"options":[{"key":"A","text":"பட்டினத்தார்"},{"key":"B","text":"தாயுமானவர்"},{"key":"C","text":"குமரகுருபரர்"},{"key":"D","text":"சிவவாக்கியார்"}],"explanation":"தாயுமானவர் திருச்சிராப்பள்ளி ஆண்ட விஜய ரகுநாத சேதுபதி மன்னரிடம் தலைமைப் கணக்கராகப் பணியாற்றியவர்."}}}
{"id":"pyq-tam-8t7-004","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":18},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எல்லாரும் இன்புற்றிருக்க நினைப்பதுவே அல்லாமல் வேறொன்றறியேன் பராபரமே’ - என்று பாடியவர் யார்?"}],"options":[{"key":"A","text":"இராமலிங்க அடிகளார்"},{"key":"B","text":"பாரதியார்"},{"key":"C","text":"தாயுமானவர்"},{"key":"D","text":"திருமூலர்"}],"explanation":"அனைத்து உயிர்களையும் தன் உயிர் போல் நேசிக்கும் பராபரக் கண்ணி பாடல்களை இயற்றியவர் தாயுமானவர் ஆவார்."}}}
{"id":"b-tam-8t7-019","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 132"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மெய்ஞ்ஞான ஒளி’ பாடலில் தாயுமானவர் இறைவனை எவ்வாறாகக் குறிப்பிடுகிறார்?"}],"options":[{"key":"A","text":"போர்க்கள வீரனாக"},{"key":"B","text":"எல்லா உயிர்களுக்கும் ஒளியாக விளங்கும் மெய்ஞ்ஞான ஜோதியாக"},{"key":"C","text":"அரசனாக"},{"key":"D","text":"வணிகனாக"}],"explanation":"அனைத்து உயிர்களிலும் ஊடுருவி நிற்கும் இறைவனை மெய்ஞ்ஞான ஒளியாகக் குறிப்பிடுகிறார்."}}}
{"id":"b-tam-8t7-023","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 7, பக்கம் 132"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மெய்ஞ்ஞான ஒளி’ பாடலில் தாயுமானவர் கூறும் சமத்துவக் கருத்து யாது?"}],"options":[{"key":"A","text":"அனைவரும் செல்வந்தர்களாக இருக்க வேண்டும்"},{"key":"B","text":"ஒன்றே குலமும் ஒருவனே தேவனும் என உணர்ந்து மனிதர்கள் பேதமின்றி வாழ்தல்"},{"key":"C","text":"அரசியல் சுதந்திரம் பெறுதல்"},{"key":"D","text":"மொழிகள் அனைத்தையும் கற்றல்"}],"explanation":"சாதி, மத பேதங்களைக் கடந்து அனைத்து உயிர்களும் சமம் என்ற ஆன்மீகச் சமத்துவத்தைத் தாயுமானவர் போற்றுகிறார்."}}}
