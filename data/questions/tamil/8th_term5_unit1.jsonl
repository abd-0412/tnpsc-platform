// பாடம் 3: காலம் உடன் வரும் (விரிவானம் / துணைப்பாடம் - கி. ராஜநாராயணன் / கி.ரா.) [5 வினாக்கள்: Q009, Q010, Q026, Q027, Q041]
// காலம் உடன் வரும் சிறுகதை - கி. ராஜநாராயணன் (கி.ரா.),
// கரிசல் இலக்கியத்தின் தந்தை, கிராமிய வட்டார வழக்கு இலக்கியம்,
// கரிசல் மண்ணின் எளிய மனிதர்களின் வாழ்வியல், உழைப்பு, மனிதநேயம்
// ==============================================================================
{"id":"b-tam-8t5-009","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 102"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘காலம் உடன் வரும்’ என்னும் சிறுகதையின் ஆசிரியர் யார்?"}],"options":[{"key":"A","text":"ஜெயகாந்தன்"},{"key":"B","text":"கி. ராஜநாராயணன் (கி.ரா.)"},{"key":"C","text":"சுப்ரபாரதிமணியன்"},{"key":"D","text":"வண்ணதாசன்"}],"explanation":"கிராமிய வட்டார இலக்கியத்தின் முன்னோடியான கி. ராஜநாராயணன் (கி.ரா.) எழுதிய சிறுகதை 'காலம் உடன் வரும்' ஆகும்."}}}
{"id":"b-tam-8t5-010","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 107"},"texts":{"ta":{"blocks":[{"type":"text","text":"கி. ராஜநாராயணன் எந்த வட்டார இலக்கிய வடிவத்தின் மூலம் புகழ்பெற்றவர்?"}],"options":[{"key":"A","text":"கொங்கு வட்டார இலக்கியம்"},{"key":"B","text":"கிடை வட்டாரக் கரிசல் இலக்கியம்"},{"key":"C","text":"நாஞ்சில் நாட்டு இலக்கியம்"},{"key":"D","text":"தொண்டை நாட்டு இலக்கியம்"}],"explanation":"கரிசல் வட்டார மக்களின் வாழ்வியலைப் படைப்புகளில் கொண்டுவந்தவர் கி. ராஜநாராயணன் ஆவார்."}}}
{"id":"b-tam-8t5-026","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 102"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘காலம் உடன் வரும்’ என்னும் சிறுகதையில் இடம்பெறும் முதன்மைக் கதாபாத்திரங்கள் யாவை?"}],"options":[{"key":"A","text":"மதிவாணன், கவின்"},{"key":"B","text":"வேலுச்சாமி மற்றும் அவரது குடும்பத்தினர் / கரிசல் கிராம மக்கள்"},{"key":"C","text":"சகாதேவன், சிகாமணி"},{"key":"D","text":"எழிலன், அறிவழகன்"}],"explanation":"கி. ராஜநாராயணனின் கரிசல் இலக்கியச் சூழலில் எளிய மனிதர்களின் வாழ்வியலைப் பேசும் கதாபாத்திரங்கள் இடம்பெற்றுள்ளன."}}}
{"id":"b-tam-8t5-027","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 107"},"texts":{"ta":{"blocks":[{"type":"text","text":"கரிசல் இலக்கியத்தின் தந்தை என்று போற்றப்படும் எழுத்தாளர் கி. ராஜநாராயணன் எந்தப் பெயரால் சுருக்கமாக அழைக்கப்படுகிறார்?"}],"options":[{"key":"A","text":"ராஜன்"},{"key":"B","text":"கி.ரா."},{"key":"C","text":"நாராயணன்"},{"key":"D","text":"கி.ரா.நா."}],"explanation":"எழுத்தாளர் கி. ராஜநாராயணன் பரவலாக 'கி.ரா.' என்றே அழைக்கப்படுகிறார்."}}}
{"id":"b-tam-8t5-041","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 102"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘காலம் உடன் வரும்’ கதையில் வெளிப்படும் கிராமிய மக்களின் பண்பாடு எத்தகையது?"}],"options":[{"key":"A","text":"நகர நாகரிகம்"},{"key":"B","text":"உழைப்பும் மனிதநேயமும் நிறைந்த கரிசல் காட்டு வாழ்வியல்"},{"key":"C","text":"வணிக மனப்பான்மை"},{"key":"D","text":"அரண்மனை வாழ்க்கை"}],"explanation":"கரிசல் மண்ணின் எளிய மக்களின் உழைப்பையும் எதிர்பார்ப்பையும் விளக்குவதாகக்கதை அமைந்துள்ளது."}}}

