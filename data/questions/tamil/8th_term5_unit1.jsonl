// ==============================================================================
// பாடம் 1: கோணக்காத்துப் பாட்டு (கவிதைப்பேழை - வெங்கம்பூர் சாமிநாத கவிராயர்) [8 வினாக்கள்: Q001, Q002, Q003, Q019, Q020, Q021, Q037, Q048]
// கோணக்காத்துப் பாட்டு - வெங்கம்பூர் சாமிநாத கவிராயர்,
// புயல் சீற்றம், பெருமழை அழிவு, வீடுகள் மாடங்கள் கூரைகள் பெயர்ந்தமை,
// தெத்துக்காடு, பருத்தி செடிகள் அழிவு, வைக்கோல் கூளங்கள் பறந்தமை,
// சொல்லும் பொருளும் (முகில்: மேகம், தெத்துக்காடு: மேட்டுக்காடு/காட்டுப்பகுதி, புத்து: புற்று, நாசம்: அழிவு, பகட்டு: அழகு, கூளங்கள்: வைக்கோல்போர்),
// நாட்டுப்புறப் பாடல் வடிவம், பஞ்சக்கும்மிகள் (புலவர் சே. இராசு தொகுத்த பஞ்சக்கும்மிகள் நூல்)
// ==============================================================================
{"id":"b-tam-8t5-001","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 94"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கோணக்காத்துப் பாட்டு’ என்னும் பாடலை இயற்றியவர் யார்?"}],"options":[{"key":"A","text":"கடிகைமுத்துப் புலவர்"},{"key":"B","text":"வெங்கம்பூர் சாமிநாத கவிராயர்"},{"key":"C","text":"அண்ணாமலையார்"},{"key":"D","text":"செட்டிநாட்டுப் புலவர்"}],"explanation":"நாட்டில் வீசிய புயல் காற்று மற்றும் மழையால் ஏற்பட்ட அழிவைக் கூறும் 'கோணக்காத்துப் பாட்டு' பாடலை இயற்றியவர் வெங்கம்பூர் சாமிநாத கவிராயர் ஆவார்."}}}
{"id":"b-tam-8t5-002","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"4","C":"1","D":"3"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 95"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கோணக்காத்துப் பாட்டு’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"தெத்துக்காடு"},{"label":"B","text":"புத்து"},{"label":"C","text":"நாசம்"},{"label":"D","text":"முகில்"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"அழிவு"},{"label":"2","text":"காட்டுப்பகுதி"},{"label":"3","text":"மேகம்"},{"label":"4","text":"புற்று"}]}],"options":[{"key":"A","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-3, C-1, D-4","mapping":{"A":"2","B":"3","C":"1","D":"4"}},{"key":"D","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}}],"explanation":"தெத்துக்காடு = காட்டுப்பகுதி; புத்து = புற்று; நாசம் = அழிவு; முகில் = மேகம்; பகட்டு = அழகு; கூளங்கள் = வைக்கோல்போர்."}}}
{"id":"b-tam-8t5-003","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 96"},"texts":{"ta":{"blocks":[{"type":"text","text":"பதிமூன்றாம் நூற்றாண்டில் இந்தியாவில் வீசியதாகக் கூறப்படும் பெருங்காற்றுடன் கூடிய புயலைச் சாமிநாத கவிராயர் எந்தப் பெயரில் குறிப்பிடுகிறார்?"}],"options":[{"key":"A","text":"மிக்ஜாம் புயல்"},{"key":"B","text":"கோணக்காத்து (கூத்தாளப் புயல்)"},{"key":"C","text":"ஒக்கி புயல்"},{"key":"D","text":" கஜா புயல்"}],"explanation":"தென்பகுதியில் வீசிய கோணக்காத்து மற்றும் புயலின் சீற்றத்தைக் கவிராயர் நாட்டுப்புறப் பாடலாகப் பாடியுள்ளார்."}}}
{"id":"b-tam-8t5-019","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 95"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கோணக்காத்துப் பாட்டு’ பாடலில் குறிப்பிடப்படும் ‘பகட்டு’ என்னும் சொல்லின் பொருள் யாது?"}],"options":[{"key":"A","text":"பயணம்"},{"key":"B","text":"அழகு"},{"key":"C","text":"பகைமை"},{"key":"D","text":"பரிசு"}],"explanation":"பகட்டு என்றால் அழகு என்று பொருள்; புயல் காற்றால் அழகிய மாடங்களும் வீடுகளும் அழிந்தன."}}}
{"id":"b-tam-8t5-020","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 95"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கூளங்கள்’ என்னும் சொல் கோணக்காத்துப் பாட்டில் எதனைக் குறிக்கிறது?"}],"options":[{"key":"A","text":"குப்பைகள்"},{"key":"B","text":"வைக்கோல்போர் / குப்பைக் கூளங்கள்"},{"key":"C","text":"தானியமணிகள்"},{"key":"D","text":"மரக்கிளைகள்"}],"explanation":"புயல் காற்றால் வைக்கோல்போர்கள் (கூளங்கள்) பறந்து சென்றதாகப் பாடலில் கூறப்பட்டுள்ளது."}}}
{"id":"b-tam-8t5-021","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 96"},"texts":{"ta":{"blocks":[{"type":"text","text":"புயல் காற்றால் வீடுகள் மற்றும் மாடங்கள் இடிந்து விழுந்ததை எந்தப் பாடலின் வழி சாமிநாத கவிராயர் விளக்குகிறார்?"}],"options":[{"key":"A","text":"தேவாரப் பாடல்"},{"key":"B","text":"சிலப்பதிகாரப் பாடல்"},{"key":"C","text":"கோணக்காத்துப் பாட்டு"},{"key":"D","text":"முக்கூடல் பள்ளு"}],"explanation":"தென்பகுதியில் வீசிய கோணக்காற்று வீடுகளின் கூரைகளையும் மாடங்களையும் எப்படிப் பேர்த்தெடுத்தது என்பதை இப்பாட்டு விவரிக்கிறது."}}}
{"id":"b-tam-8t5-037","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 94"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கோணக்காத்துப் பாட்டு’ என்னும் நாட்டுப்புறப் பாடலில் எதனால் ஏற்பட்ட துயரங்கள் விவரிக்கப்பட்டுள்ளன?"}],"options":[{"key":"A","text":"பஞ்சம் மற்றும் பசி"},{"key":"B","text":"புயல் காற்று மற்றும் பெருமழை அழிவு"},{"key":"C","text":"போர் மூண்டதால்"},{"key":"D","text":"நிலநடுக்கத்தால்"}],"explanation":"புயல் காற்றாலும் மழையினாலும் வீடுகளும் பயிர்களும் நாசமானதைப் பாட்டு விவரிக்கிறது."}}}
{"id":"b-tam-8t5-048","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 5, பக்கம் 94"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கோணக்காத்துப் பாட்டு’ நூலின்படி புயல் காற்றால் எங்குள்ள மரங்கள் வேரோடு சாய்ந்தன?"}],"options":[{"key":"A","text":"தெத்துக்காட்டுப் பகுதி"},{"key":"B","text":"நாட்டின் பல பகுதிகளிலும் உள்ள காடுகளும் ஊர்களும்"},{"key":"C","text":"மலைப் பகுதிகள்"},{"key":"D","text":"நதிக்கரைகள்"}],"explanation":"புயலின் கோரத் தாண்டவத்தால் ஊர்ப்பகுதிகளிலும் காடுகளிலும் மரங்கள் வேரோடு சாய்ந்தன."}}}

