// 8-ஆம் வகுப்பு தமிழ் - பருவம் 2
// பாடம் 4: வெட்டுக்கிளியும் சருகுமானும் (துணைப்பாடம் - காடர்கள் / வ. கீதா) [Q027 - Q031, Q057, Q058, Q075, Q076]
// வினாக்கள் எண்ணிக்கை: 9
// ==============================================================================
{"id":"b-tam-8t2-027","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வெட்டுக்கிளியும் சருகுமானும்’ என்னும் கதையின் பின்னணியாக உள்ள பழங்குடி மக்கள் யார்?"}],"options":[{"key":"A","text":"தோடர்"},{"key":"B","text":"காடர்கள் (பரம்பிக்குளம், ஆனைமலைப் பகுதி)"},{"key":"C","text":"இருளர்"},{"key":"D","text":"பளியர்"}],"explanation":"தமிழ்நாடு, கேரள எல்லைப் பகுதியான பரம்பிக்குளம், ஆனைமலைக் காடுகளில் வாழும் காடர்களின் செவிவழிச் கதை இதுவாகும்."}}}
{"id":"b-tam-8t2-028","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வெட்டுக்கிளியும் சருகுமானும்’ கதையில் சிறிய பிராணியாகவும் கூச்சப்படும் விலங்காகவும் குறிப்பிடப்படும் ‘கூரன்’ என்பது எது?"}],"options":[{"key":"A","text":"வெட்டுக்கிளி"},{"key":"B","text":"சருகுமான்"},{"key":"C","text":"புனுகுப்பூனை"},{"key":"D","text":"மான் குட்டி"}],"explanation":"பெரிய வீட்டுப்பூனை அளவுள்ள கூச்சப்படும் சிறிய பிராணியான சருகுமானின் பெயர் 'கூரன்' ஆகும்."}}}
{"id":"b-tam-8t2-029","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வெட்டுக்கிளியும் சருகுமானும்’ கதையில் சருகுமானைத் துரத்திச் சென்ற பெரிய மஞ்சள் கண்களையுடைய சிறுத்தை விலங்கின் பெயர் என்ன?"}],"options":[{"key":"A","text":"காளையன்"},{"key":"B","text":"பித்தக்கண்ணு"},{"key":"C","text":"கருப்பன்"},{"key":"D","text":"வேங்கை"}],"explanation":"காட்டின் மிகச்சிறந்த வேட்டை விலங்கான சிறுத்தையின் பெயர் 'பித்தக்கண்ணு' ஆகும்."}}}
{"id":"b-tam-8t2-030","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 36"},"texts":{"ta":{"blocks":[{"type":"text","text":"காடர்கள் தற்பொழுது பேசிவரும் தங்களுக்கே உரிய பழங்குடி மொழியை எவ்வாறு அழைக்கின்றனர்?"}],"options":[{"key":"A","text":"மலைத் தமிழ்"},{"key":"B","text":"ஆல்அலப்பு"},{"key":"C","text":"காடர் பாசை"},{"key":"D","text":"திராவிட மொழி"}],"explanation":"பரம்பிக்குளம் ஆனைமலைக் காடர்கள் தாங்கள் பேசும் மொழியை 'ஆல்அலப்பு' என்று அழைக்கின்றனர்."}}}
{"id":"b-tam-8t2-031","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 37"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வெட்டுக்கிளியும் சருகுமானும்’ கதையைத் தொகுத்து ‘யானையோடு பேசுதல்’ என்னும் தலைப்பில் தமிழில் மொழிபெயர்த்தவர் யார்?"}],"options":[{"key":"A","text":"பாவண்ணன்"},{"key":"B","text":"வ. கீதா (மனிஷ் சாண்டி, மாதுரி ரமேஷ் கதைகள்)"},{"key":"C","text":"தமிழவன்"},{"key":"D","text":"நாஞ்சில் நாடன்"}],"explanation":"மனிஷ் சாண்டி மற்றும் மாதுரி ரமேஷ் தொகுத்த காடர்களின் கதைகளை வ. கீதா 'யானையோடு பேசுதல்' எனத் தமிழாக்கம் செய்துள்ளார்."}}}
{"id":"b-tam-8t2-057","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வெட்டுக்கிளியும் சருகுமானும்’ கதையில் ஓடைப் பக்கத்தில் சருகுமானைத் துரத்தி வந்த சிறுத்தையின் கண்கள் எவ்வாறு வர்ணிக்கப்பட்டுள்ளன?"}],"options":[{"key":"A","text":"நீல நிறக் கண்கள்"},{"key":"B","text":"பெரிய, மஞ்சள் கண்களையுடைய சிறுத்தை"},{"key":"C","text":"சிவப்பு நிறக் கண்கள்"},{"key":"D","text":"பச்சை நிறக் கண்கள்"}],"explanation":"பித்தக்கண்ணு எனப்படும் சிறுத்தை பெரிய, மஞ்சள் கண்களையுடைய சிறந்த வேட்டை விலங்காகச் சித்திரிக்கப்பட்டுள்ளது."}}}
{"id":"b-tam-8t2-058","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 36"},"texts":{"ta":{"blocks":[{"type":"text","text":"சருகுமான் பதுங்கியிருந்த மரத்தடியில் முதல் நாள் இரவு தங்கியிருந்ததால் துர்நாற்றம் வீசக் காரணமான விலங்கு எது?"}],"options":[{"key":"A","text":"நரி"},{"key":"B","text":"புனுகுப்பூனை"},{"key":"C","text":"கரடி"},{"key":"D","text":"காட்டுப்பன்றி"}],"explanation":"புனுகுப்பூனை தங்கியிருந்த இடத்தின் வாடை வீசியதால் சிறுத்தையின் மோப்பத்திலிருந்து கூரன் (சருகுமான்) தப்பியது."}}}
{"id":"b-tam-8t2-075","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 35"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வெட்டுக்கிளியும் சருகுமானும்’ கதையில் ஓடைப் பக்கத்தில் சருகுமானைத் துரத்தி வந்த சிறுத்தையின் கண்கள் எவ்வாறு வர்ணிக்கப்பட்டுள்ளன?"}],"options":[{"key":"A","text":"நீல நிறக் கண்கள்"},{"key":"B","text":"பெரிய, மஞ்சள் கண்களையுடைய சிறுத்தை"},{"key":"C","text":"சிவப்பு நிறக் கண்கள்"},{"key":"D","text":"பச்சை நிறக் கண்கள்"}],"explanation":"பித்தக்கண்ணு எனப்படும் சிறுத்தை பெரிய, மஞ்சள் கண்களையுடைய சிறந்த வேட்டை விலங்காகச் சித்திரிக்கப்பட்டுள்ளது."}}}
{"id":"b-tam-8t2-076","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 36"},"texts":{"ta":{"blocks":[{"type":"text","text":"சருகுமான் பதுங்கியிருந்த மரத்தடியில் முதல் நாள் இரவு தங்கியிருந்ததால் துர்நாற்றம் வீசக் காரணமான விலங்கு எது?"}],"options":[{"key":"A","text":"நரி"},{"key":"B","text":"புனுகுப்பூனை"},{"key":"C","text":"கரடி"},{"key":"D","text":"காட்டுப்பன்றி"}],"explanation":"புனுகுப்பூனை தங்கியிருந்த இடத்தின் வாடை வீசியதால் சிறுத்தையின் மோப்பத்திலிருந்து கூரன் (சருகுமான்) தப்பியது."}}}
