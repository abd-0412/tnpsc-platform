// 8-ஆம் வகுப்பு தமிழ் - பருவம் 2
// பாடம் 3: தமிழர் மருத்துவம் (உரைநடை உலகம் - மருத்துவர் கு. சிவராமன்) [Q016 - Q026, Q056, Q073, Q074]
// வினாக்கள் எண்ணிக்கை: 14
// ==============================================================================
{"id":"b-tam-8t2-016","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 30"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தமிழர் மருத்துவம்’ என்னும் உரைநடைப் பகுதி யாருடைய நேர்காணலாக அமைக்கப்பட்டுள்ளது?"}],"options":[{"key":"A","text":"மருத்துவர் சாந்தாராம்"},{"key":"B","text":"சித்த மருத்துவர் கு. சிவராமன்"},{"key":"C","text":"மருத்துவர் புகழேந்தி"},{"key":"D","text":"மருத்துவர் மாரிமுத்து"}],"explanation":"மாணவர்கள் பள்ளி ஆண்டுமலருக்காகச் சித்த மருத்துவர் கு. சிவராமன் அவர்களைச் சந்தித்து நிகழ்த்திய நேர்காணல் இதுவாகும்."}}}
{"id":"b-tam-8t2-017","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 30"},"texts":{"ta":{"blocks":[{"type":"text","text":"தொடக்க காலத்தில் மனிதன் நோயைத் தீர்க்க முதன்முதலில் எவற்றைப் பயன்படுத்தினான்?"}],"options":[{"key":"A","text":"தாவரங்களை (வேர், பட்டை, இலை, பூ, கனி)"},{"key":"B","text":"விலங்குகளின் கொழுப்பை"},{"key":"C","text":"ரசாயன மருந்துகளை"},{"key":"D","text":"உலோகப் பொடிகளை"}],"explanation":"தொடக்க காலத்தில் மனிதன் தனக்கு அருகில் கிடைத்த தாவரங்களின் வேர், இலை, பட்டை ஆகியவற்றைக் கொண்டு நோயைத் தீர்த்தான்."}}}
{"id":"b-tam-8t2-018","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 31"},"texts":{"ta":{"blocks":[{"type":"text","text":"சித்த மருத்துவத்தில் மூலிகைகளால் குணமாகாத நாட்பட்ட நோய்களுக்குத் தாவரங்களுடன் எவற்றைப் பயன்படுத்தினர்?"}],"options":[{"key":"A","text":"விலங்கு உறுப்புகளை"},{"key":"B","text":"உலோகங்களையும் பாஷாணங்களையும்"},{"key":"C","text":"நச்சுப் பொருள்களை"},{"key":"D","text":"செயற்கை இரசாயனங்களை"}],"explanation":"'வேர்பாரு தழைபாரு மிஞ்சினக்கால் பற்பசெந்தூரம் பாரே' - மூலிகைகளோடு உலோகங்களையும் பாஷாணங்களையும் மருந்தாக மாற்றினர்."}}}
{"id":"b-tam-8t2-019","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 32"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழர் மருத்துவத்தில் பக்கவிளைவுகள் ஏற்படாததற்குக் காரணமாக மருத்துவர் கூறுவது யாது?"}],"options":[{"key":"A","text":"மருந்துகள் விலை மலிவானவை என்பதால்"},{"key":"B","text":"மருந்து என்பதே உணவின் நீட்சியாக இருப்பதால்"},{"key":"C","text":"மருந்துகள் கசக்காது என்பதால்"},{"key":"D","text":"அவை வெளிநாடுகளிலிருந்து இறக்குமதி செய்யப்படுவதால்"}],"explanation":"உணவு எப்படிப் பக்கவிளைவுகளைத் தருவதில்லையோ, அதேபோலச் சித்த மருத்துவ மருந்தும் உணவின் நீட்சியாக இருப்பதால் பக்கவிளைவுகள் தருவதில்லை."}}}
{"id":"b-tam-8t2-020","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 32"},"texts":{"ta":{"blocks":[{"type":"text","text":"திருக்குறளின்படி நோய்க்கான காரணத்தைக் கண்டறிந்து ஒருவரை நோயில்லாத மனிதராக்கும் முறையைக் பின்பற்றுவது எது?"}],"options":[{"key":"A","text":"அலோபதி மருத்துவம்"},{"key":"B","text":"தமிழர் மருத்துவம் (சித்த மருத்துவம்)"},{"key":"C","text":"யுனானி மருத்துவம்"},{"key":"D","text":"இயற்கை மருத்துவம்"}],"explanation":"'நோய்நாடி நோய் முதல்நாடி' என்ற திருக்குறளின்படி நோயையும் அதன் காரணிகளையும் கண்டறிந்து குணப்படுத்துவது தமிழர் மருத்துவத்தின் சிறப்பாகும்."}}}
{"id":"b-tam-8t2-021","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 32"},"texts":{"ta":{"blocks":[{"type":"text","text":"நடைமுறையில் உள்ள மருத்துவ முறைகளுள் தவறான ஒன்றைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"சித்த மருத்துவம், ஆயுர்வேத மருத்துவம்"},{"key":"B","text":"மந்திர மருத்துவம் (பெட்டகச் செய்திப்படி)"},{"key":"C","text":"யுனானி மருத்துவம்"},{"key":"D","text":"அலோபதி மருத்துவம்"}],"explanation":"பெட்டகச் செய்தியின்படி சித்த, ஆயுர்வேத, யுனானி மற்றும் அலோபதி மருத்துவ முறைகள் நடைமுறையில் உள்ளன."}}}
{"id":"b-tam-8t2-022","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 33"},"texts":{"ta":{"blocks":[{"type":"text","text":"உடல் நலத்திற்காக மருத்துவர் சிவராமன் பரிந்துரைக்கும் தினசரி நடைப்பயிற்சியின் தூரம் மற்றும் நேரம் எவ்வளவு?"}],"options":[{"key":"A","text":"20 நிமிடத்தில் 1 கி.மீ."},{"key":"B","text":"45 நிமிடத்தில் 3 கி.மீ. நடைப்பயணம்"},{"key":"C","text":"1 மணி நேரத்தில் 5 கி.மீ."},{"key":"D","text":"30 நிமிடத்தில் 2 கி.மீ."}],"explanation":"நாள்தோறும் 45 நிமிடத்தில் 3 கி.மீ. நடைப்பயணம், 15 நிமிடம் யோகா மற்றும் 7 மணி நேரத் தூக்கம் அவசியம்."}}}
{"id":"b-tam-8t2-023","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 34"},"texts":{"ta":{"blocks":[{"type":"text","text":"தொடக்க காலத்தில் மனிதன் மருத்துவத்திற்கு எவற்றைப் பயன்படுத்தினான்?"}],"options":[{"key":"A","text":"விலங்குகளை"},{"key":"B","text":"உலோகங்களை"},{"key":"C","text":"தாவரங்களை"},{"key":"D","text":"இரசாயனங்களை"}],"explanation":"மதிப்பீட்டு வினா: தொடக்க காலத்தில் மனிதன் மருத்துவத்திற்குத் தாவரங்களைப் பயன்படுத்தினான்."}}}
{"id":"b-tam-8t2-024","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 34"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழர் மருத்துவத்தில் மருந்து என்பது ________ நீட்சியாகவே உள்ளது."}],"options":[{"key":"A","text":"மருந்தின்"},{"key":"B","text":"உடற்பயிற்சியின்"},{"key":"C","text":"உணவின்"},{"key":"D","text":"வாழ்வின்"}],"explanation":"தமிழர் மருத்துவத்தில் மருந்து என்பது உணவின் நீட்சியாகவே அமைகிறது."}}}
{"id":"b-tam-8t2-025","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 34"},"texts":{"ta":{"blocks":[{"type":"text","text":"நோய்கள் பெருக மனிதன் ________ விட்டு விலகியதுதான் முதன்மைக் காரணமாகும்."}],"options":[{"key":"A","text":"வீட்டை"},{"key":"B","text":"உணவை"},{"key":"C","text":"நாட்டை"},{"key":"D","text":"இயற்கையை"}],"explanation":"மனிதன் இயற்கையைவிட்டு விலகிச் சென்றதே இன்றைய நோய்ப் பெருக்கத்திற்கு மூலக் காரணமாகும்."}}}
{"id":"b-tam-8t2-026","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 34"},"texts":{"ta":{"blocks":[{"type":"text","text":"சமையலறையில் செலவிடும் நேரம் ________ செலவிடும் நேரமாகும்."}],"options":[{"key":"A","text":"சுவைக்காக"},{"key":"B","text":"சிக்கனத்திற்காக"},{"key":"C","text":"நல்வாழ்வுக்காக"},{"key":"D","text":"உணவுக்காக"}],"explanation":"சமையலறையில் செலவிடும் நேரத்தைத் தன் நல்வாழ்விற்காகச் செலவிடும் நேரமாகக் கருத வேண்டும்."}}}
{"id":"b-tam-8t2-056","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 30"},"texts":{"ta":{"blocks":[{"type":"text","text":"திருவள்ளுவர் எக்குறளின் மூலம் நோயையும் அதன் காரணிகளையும் கண்டறிந்து குணப்படுத்தும் முறையைக் கூறினார் என மருத்துவர் குறிப்பிடுகிறார்?"}],"options":[{"key":"A","text":"மருந்தென வேண்டாவாம் யாக்கைக்கு"},{"key":"B","text":"நோய்நாடி நோய்முதல் நாடி அதுதணிக்கும் வாய்நாடி வாய்ப்பச் செயல்"},{"key":"C","text":"அற்றால் வளவளக்கும் நோய்"},{"key":"D","text":"இன்பம் விழையான் இடும்பை"}],"explanation":"'நோய்நாடி நோய்முதல் நாடி' என்ற திருக்குறளின் வழியே தமிழர் மருத்துவம் நோயின் காரணத்தை ஆராய்கிறது."}}}
{"id":"b-tam-8t2-073","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 30"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நோய்நாடி நோய்முதல் நாடி அதுதணிக்கும் வாய்நாடி வாய்ப்பச் செயல்’ - இக்குறட்பா எதற்கு வழிகாட்டுகிறது?"}],"options":[{"key":"A","text":"அரசாட்சி முறைக்கு"},{"key":"B","text":"மருத்துவ முறைக்கும் நோய் தீர்க்கும் வழிக்கும்"},{"key":"C","text":"போர்க்கள உத்திகளுக்கு"},{"key":"D","text":"வணிக நெறிகளுக்கு"}],"explanation":"நோய் என்ன, அதன் காரணம் என்ன, அதனைத் தணிக்கும் வழி என்ன என்பதை ஆராய்ந்து மருத்துவம் செய்ய வேண்டும்."}}}
{"id":"b-tam-8t2-074","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 32"},"texts":{"ta":{"blocks":[{"type":"text","text":"மருத்துவர் சிவராமன் கூற்றுப்படி நல்வாழ்விற்காகத் தினமும் குடிக்க வேண்டிய நீரின் அளவு எவ்வளவு?"}],"options":[{"key":"A","text":"1 லிட்டர்"},{"key":"B","text":"3 லிட்டர்"},{"key":"C","text":"2 லிட்டர்"},{"key":"D","text":"5 லிட்டர்"}],"explanation":"நாள்தோறும் 3 லிட்டர் தண்ணீர் அருந்துவதும், 7 மணி நேரத் தூக்கமும் உடல்நலத்திற்கு அவசியமாகும்."}}}
