// ==============================================================================
// 8-ஆம் வகுப்பு தமிழ் - பருவம் 2
// பாடம் 5: மயங்கொலிகள் (கற்கண்டு - இலக்கணம்) [Q032 - Q038, Q059 - Q064, Q077]
// வினாக்கள் எண்ணிக்கை: 14
// ==============================================================================
{"id":"b-tam-8t2-032","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 38"},"texts":{"ta":{"blocks":[{"type":"text","text":"உச்சரிப்பில் சிறிதளவு மட்டுமே வேறுபாடு உள்ள எழுத்துகள் எவ்வாறு அழைக்கப்படுகின்றன?"}],"options":[{"key":"A","text":"இன எழுத்துகள்"},{"key":"B","text":"மயங்கொலி எழுத்துகள் (8 எழுத்துகள்: ண, ன, ந, ல, ழ, ள, ர, ற)"},{"key":"C","text":"சார்பெழுத்துகள்"},{"key":"D","text":"சுட்டு எழுத்துகள்"}],"explanation":"உச்சரிப்பில் சிறிய வேறுபாடு உள்ள ண, ன, ந, ல, ழ, ள, ர, ற என்பவை மயங்கொலி எழுத்துகள் எனப்படும்."}}}
{"id":"b-tam-8t2-033","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 38"},"texts":{"ta":{"blocks":[{"type":"text","text":"டகர எழுத்துக்கு முன் எந்த ணகரம் வரும்?"}],"options":[{"key":"A","text":"றன்னகரம்"},{"key":"B","text":"டண்ணகரம் (ண்) (எ.கா: கண்டம், வண்டி)"},{"key":"C","text":"தந்நகரம்"},{"key":"D","text":"மூவழி நகரம்"}],"explanation":"டகரத்தை அடுத்து வரும் ணகரம் 'டண்ணகரம்' எனப்படும் (ண்)."}}}
{"id":"b-tam-8t2-034","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 38"},"texts":{"ta":{"blocks":[{"type":"text","text":"றகர எழுத்துக்கு முன் எந்த னகரம் வரும்?"}],"options":[{"key":"A","text":"டண்ணகரம்"},{"key":"B","text":"தந்நகரம்"},{"key":"C","text":"றன்னகரம் (ன்) (எ.கா: மன்றம், நன்றி)"},{"key":"D","text":"மூவழி நகரம்"}],"explanation":"றகரத்தை அடுத்து வரும் னகரம் 'றன்னகரம்' எனப்படும் (ன்)."}}}
{"id":"b-tam-8t2-035","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 39"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ் மொழிக்கே உரிய தனிச்சிறப்பு மிக்க சிறப்பு ழகரம் எது?"}],"options":[{"key":"A","text":"ளகரம்"},{"key":"B","text":"ழகரம் (ழ)"},{"key":"C","text":"லகரம்"},{"key":"D","text":"நகரம்"}],"explanation":"நாவின் நுனி மேல்நோக்கி வளைந்து வருடுவதால் பிறக்கும் 'ழ' தமிழ் மொழிக்கே உரிய சிறப்பு ழகரம் ஆகும்."}}}
{"id":"b-tam-8t2-036","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 39"},"texts":{"ta":{"blocks":[{"type":"text","text":"வல்லின மெய்யெழுத்தான ‘றகரம்’ எங்குப் பிறக்கிறது?"}],"options":[{"key":"A","text":"நாவின் நுனி அண்ணத்தின் முதல் பகுதியைத் தொடுவதால்"},{"key":"B","text":"நாவின் நுனி மேல் அண்ணத்தில் மையப்பகுதியை உரசுவதால்"},{"key":"C","text":"மேல்வாய்ப்பல்லைக் கீழ் உதடு பொருந்துவதால்"},{"key":"D","text":"மூக்கினை இடமாகக் கொண்டு"}],"explanation":"நாவின் நுனி மேல் அண்ணத்தில் மையப்பகுதியை உரசுவதால் வல்லின றகரம் தோன்றும்; ரகரம் இடையினமாகும்."}}}
{"id":"b-tam-8t2-037","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 40"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சிரம்’ என்னும் சொல்லின் பொருள் யாது?"}],"options":[{"key":"A","text":"உடல்"},{"key":"B","text":"தலை"},{"key":"C","text":"கழுத்து"},{"key":"D","text":"கால்"}],"explanation":"சிரம் என்றால் தலை என்று பொருள் (தலை / தளை மதிப்பீட்டு வினா)."}}}
{"id":"b-tam-8t2-038","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 40"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பரவை’ என்னும் சொல்லின் சரியான பொருள் எது?"}],"options":[{"key":"A","text":"பறவை"},{"key":"B","text":"கடல்"},{"key":"C","text":"வானம்"},{"key":"D","text":"காடு"}],"explanation":"பரவை என்பது கடலைக் குறிக்கும் (பறவை என்பது பறக்கும் உயிரினம்)."}}}
{"id":"b-tam-8t2-059","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 38"},"texts":{"ta":{"blocks":[{"type":"text","text":"நாவின் நுனி மேல்வாய் அண்ணத்தின் நடுப் பகுதியைத் தொடுவதால் பிறக்கும் எழுத்து எது?"}],"options":[{"key":"A","text":"னகரம்"},{"key":"B","text":"ணகரம் (டண்ணகரம்)"},{"key":"C","text":"நகரம்"},{"key":"D","text":"லகரம்"}],"explanation":"நாவின் நுனி அண்ணத்தின் நடுப்பகுதியைத் தொடுவதால் ணகரம் பிறக்கிறது; முன் பகுதியைத் தொட்டால் னகரம் பிறக்கும்."}}}
{"id":"b-tam-8t2-060","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 39"},"texts":{"ta":{"blocks":[{"type":"text","text":"நாவின் இருபக்கங்கள் தடித்து மேல் அண்ணத்தின் நடுப்பகுதியைத் தொடுவதால் பிறக்கும் எழுத்து எது?"}],"options":[{"key":"A","text":"லகரம்"},{"key":"B","text":"ளகரம்"},{"key":"C","text":"ழகரம்"},{"key":"D","text":"ரகரம்"}],"explanation":"நாவின் இருபக்கங்கள் தடித்து மேல் அண்ணத்தின் நடுப்பகுதியைத் தொடுவதால் ளகரம் தோன்றும்."}}}
{"id":"b-tam-8t2-061","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 39"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வாணம்’ மற்றும் ‘வானம்’ ஆகிய மயங்கொலிச் சொற்களின் சரியான பொருள்கள் முறையே எவை?"}],"options":[{"key":"A","text":"ஆகாயம், வெடி"},{"key":"B","text":"வெடி, ஆகாயம்"},{"key":"C","text":"குளிர்ச்சி, வேலை"},{"key":"D","text":"மதிப்பு, இலை"}],"explanation":"வாணம் = வெடி; வானம் = ஆகாயம்."}}}
{"id":"b-tam-8t2-062","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 39"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘விலை, இலை, விழை, இளை’ - இவற்றில் பொருளின் மதிப்பைக் குறிக்கும் சொல் எது?"}],"options":[{"key":"A","text":"விளை"},{"key":"B","text":"விலை"},{"key":"C","text":"இலை"},{"key":"D","text":"இளை"}],"explanation":"விலை = பொருளின் மதிப்பு; இலை = செடியின் இலை; விழை = விரும்பு; இளை = மெலிந்து போதல்."}}}
{"id":"b-tam-8t2-063","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 40"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சிரம்’ என்னும் சொல்லின் சரியான பொருள் யாது?"}],"options":[{"key":"A","text":"கால்"},{"key":"B","text":"தலை"},{"key":"C","text":"கழுத்து"},{"key":"D","text":"உடல்"}],"explanation":"சிரம் என்றால் தலை என்று பொருள் (தலை / தளை மதிப்பீட்டு வினா)."}}}
{"id":"b-tam-8t2-064","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 40"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பரவை’ என்னும் சொல்லின் சரியான பொருள் எது?"}],"options":[{"key":"A","text":"பறவை"},{"key":"B","text":"கடல்"},{"key":"C","text":"வானம்"},{"key":"D","text":"காடு"}],"explanation":"பரவை என்பது கடலைக் குறிக்கும் (பறவை என்பது பறக்கும் உயிரினம்)."}}}
{"id":"b-tam-8t2-077","kind":"assertion_reason","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 38"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"‘ண, ன, ந’ ஆகிய எழுத்துகள் மயங்கொலி எழுத்துகள் என அழைக்கப்படுகின்றன."},{"type":"reason","text":"இவை உச்சரிக்கும்போது சிறிதளவு மட்டுமே வேறுபாடு கொண்டு ஒன்றுபோல ஒலிப்பதால் பொருள் மாறுபாட்டை உணர்ந்து எழுத வேண்டும்."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"உச்சரிப்பில் சிறிய வேறுபாடு கொண்டு மயக்கத்தைத் தருவதால் இவை மயங்கொலி எழுத்துகள் எனப்படும்; கூற்றும் காரணமும் சரி."}}}
