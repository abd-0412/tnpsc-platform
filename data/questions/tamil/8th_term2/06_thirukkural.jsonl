// ==============================================================================
// 8-ஆம் வகுப்பு தமிழ் - பருவம் 2
// பாடம் 6: திருக்குறள் (வாழ்வியல் / நடுவுநிலைமை & கூடா ஒழுக்கம் & கல்லாமை & குற்றங்கடிதல்) [Q039 - Q052, Q065 - Q072, Q078]
// வினாக்கள் எண்ணிக்கை: 23
// ==============================================================================
{"id":"b-tam-8t2-039","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தக்கார் தகவிலர் என்பது அவரவர் எச்சத்தால் காணப் படும்’ - நடுவுநிலைமையை அறியும் வழியாக வள்ளுவர் எதனைக் குறிப்பிடுகிறார்?"}],"options":[{"key":"A","text":"அரசின் தீர்ப்பு"},{"key":"B","text":"அவரவருக்குப் பின் எஞ்சி நிற்கும் புகழினாலும் பழியினாலும்"},{"key":"C","text":"அவர்களின் செல்வப் பெருக்கினால்"},{"key":"D","text":"அவர்களின் குடும்பப் பாரம்பரியத்தால்"}],"explanation":"நடுவுநிலைமை உடையவரா இல்லையா என்பது அவர்க்குப் பின் மிஞ்சும் புகழாலும் பழியாலும் அறியப்படும்."}}}
{"id":"b-tam-8t2-040","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சமன்செய்து சீர்தூக்கும் கோல்போல் அமைந்துஒருபால் கோடாமை சான்றோர்க்கு அணி’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?"}],"options":[{"key":"A","text":"உருவக அணி"},{"key":"B","text":"உவமையணி (போல் என்னும் உவம உருபு வெளிப்படையாக வந்தது)"},{"key":"C","text":"பிறிதுமொழிதல் அணி"},{"key":"D","text":"இல்பொருள் உவமையணி"}],"explanation":"துலாக்கோல் போல நடுவுநிலைமையுடன் கோடாமை சான்றோர்க்கு அழகு என வந்துள்ளதால் இது உவமையணி ஆகும்."}}}
{"id":"b-tam-8t2-041","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வலியில் நிலைமையான் வல்லுருவம் பெற்றம் புலியின்தோல் போர்த்துமேய்ந் தற்று’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?"}],"options":[{"key":"A","text":"உவமையணி"},{"key":"B","text":"இல்பொருள் உவமையணி (புலியின் தோலைப் போர்த்திய பசு உலகில் இல்லை)"},{"key":"C","text":"தற்கேற்ற அணி"},{"key":"D","text":"ஏகதேச உவமையணி"}],"explanation":"புலியின் தோலைப் போர்த்திய பசு என்பது உலகில் இல்லாத ஒன்றை உவமையாகக் கூறுவதால் இது இல்பொருள் உவமையணி ஆகும்."}}}
{"id":"b-tam-8t2-042","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கணைகொடிது யாழ்கோடு செவ்விதுஆங்கு அன்ன வினைபடு பாலால் கொளல்’ - மக்களின் பண்புகளை எதன் மூலம் உணர வேண்டும் என வள்ளுவர் கூறுகிறார்?"}],"options":[{"key":"A","text":"அவர்களின் வெளிப்புறத் தோற்றத்தால்"},{"key":"B","text":"அவர்களின் செயல்வகையால் (வினைபடு பாலால்)"},{"key":"C","text":"அவர்களின் குடும்பப் பெயரால்"},{"key":"D","text":"அவர்களின் செல்வத்தால்"}],"explanation":"அம்பு நேராக இருப்பினும் கொடியது; யாழ் வளைந்திருப்பினும் இனியது; எனவே மக்களின் பண்புகளைத் தோற்றத்தால் அல்லாமல் செயலால் கொள்ள வேண்டும்."}}}
{"id":"b-tam-8t2-043","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘உளர்என்னும் மாத்திரையர் அல்லால் பயவாக் களர்அனையர் கல்லா தவர்’ - கல்லாதவர்களை வள்ளுவர் எதனுடன் ஒப்பிடுகிறார்?"}],"options":[{"key":"A","text":"வெறும் மரங்களுடன்"},{"key":"B","text":"பயனில்லாத களர்நிலத்துடன்"},{"key":"C","text":"விலங்குகளுடன் மட்டும்"},{"key":"D","text":"இருண்ட வீடுகளுடன்"}],"explanation":"கல்லாதவர் உயிரோடு இருக்கிறார் என்பதைத் தவிர, பயனில்லாத களர்நிலம் போன்றவர் ஆவார்."}}}
{"id":"b-tam-8t2-044","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வருமுன்னர்க் காவாதான் வாழ்க்கை எரிமுன்னர் வைத்துப் போலக் கெடும்’ - பழிவருமுன் காவாவிட்டல் வாழ்க்கை எதனைப் போலக் கெடும்?"}],"options":[{"key":"A","text":"காற்றில் பறக்கும் தூசு போல"},{"key":"B","text":"நெருப்பின் அருகில் வைக்கப்பட்ட வைக்கோல்போர் போல"},{"key":"C","text":"நீரில் விழுந்த பனி போல"},{"key":"D","text":"வெயிலில் உருகும் மெழுகு போல"}],"explanation":"பழிவருமுன் காக்காதவனின் வாழ்க்கை நெருப்புக்கு முன் வைக்கப்பட்ட வைக்கோல்போர் (வைத்தூறு) போல வேகமாக அழிந்துவிடும் (உவமையணி)."}}}
{"id":"b-tam-8t2-045","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கடல்ஓடா கால்வல் நெடுந்தேர் கடல்ஓடும் நாவாயும் ஓடா நிலத்து’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?"}],"options":[{"key":"A","text":"உவமையணி"},{"key":"B","text":"பிறிதுமொழிதல் அணி"},{"key":"C","text":"உருவக அணி"},{"key":"D","text":"இல்பொருள் உவமையணி"}],"explanation":"தேர் கடலிலும் கப்பல் நிலத்திலும் ஓடாது என்ற உவமையைக் கூறி, அவரவர் தமக்குரிய இடத்தில் மட்டுமே சிறப்பாகச் செயல்பட முடியும் என்ற கருத்தைக் குறிப்பால் உணர்த்துவதால் இது பிறிதுமொழிதல் அணி ஆகும்."}}}
{"id":"pyq-tam-8t2-046","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":15},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தண்கடலில் மீன்விலைஞ்டர் உப்புடன் நெல்லை விற்றுத் தங்களின் வாழ்வை ஓட்டினர்’ - என்னும் பொருளில் வரும் சங்ககால ஊர் எது?"}],"options":[{"key":"A","text":"கொற்கை"},{"key":"B","text":"அக்ககால நெய்தல் நில ஊர்கள்"},{"key":"C","text":"உமணர்கள் செல்லும் வழி"},{"key":"D","text":"புகார்"}],"explanation":"சங்க இலக்கியப் பாடல்களில் உமணர்கள் உப்பை விற்று நெல்லைப் பெற்ற செய்தி இடம்பெற்றுள்ளது."}}}
{"id":"b-tam-8t2-047","kind":"assertion_reason","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"‘வலியில் நிலைமையான் வல்லுருவம் பெற்றம் புலியின்தோல் போர்த்துமேய்ந் தற்று’ - இக்குறளில் இல்பொருள் உவமையணி பயின்று வந்துள்ளது."},{"type":"reason","text":"புலியின் தோலைப் போர்த்திக் கொண்ட பசு பயிரை மேய்ந்தது என்னும் நிகழ்வு உலகில் இல்லாத ஒன்றாகும்."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"உலகில் இல்லாத ஒன்றை உவமையாகக் கூறுவது இல்பொருள் உவமையணி ஆகும்; கூற்றும் காரணமும் சரி."}}}
{"id":"b-tam-8t2-048","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 46"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வல்லுருவம்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"வல் + உருவம்"},{"key":"B","text":"வன்மை + உருவம்"},{"key":"C","text":"வல்ல + உருவம்"},{"key":"D","text":"வல்லு + உருவம்"}],"explanation":"வன்மை + உருவம் = ஈறுபோதல் விதிப்படி 'மை' கெட்டு, இனவெல்லேத்தாகி 'வல்லுருவம்' எனப் புணரும்."}}}
{"id":"b-tam-8t2-049","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 46"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நெடுமை + தேர்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"நெடுதேர்"},{"key":"B","text":"நெடுத்தேர்"},{"key":"C","text":"நெடுந்தேர்"},{"key":"D","text":"நெடுமைதேர்"}],"explanation":"ஈறுபோதல் விதிப்படி 'மை' கெட்டு, இனவெல்லெழுத்து மிகுந்து 'நெடுந்தேர்' எனப் புணரும்."}}}
{"id":"b-tam-8t2-050","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 46"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கடல்ஓடா’ எனத் தொடங்கும் குறளில் பயின்று வந்துள்ள அணி எது?"}],"options":[{"key":"A","text":"எடுத்துக்காட்டு உவமை அணி"},{"key":"B","text":"தற்குறிப்பேற்ற அணி"},{"key":"C","text":"உவமை அணி"},{"key":"D","text":"பிறிதுமொழிதல் அணி"}],"explanation":"தேரும் கப்பலும் தங்கள் உரிய இடத்தில் மட்டுமே ஓடும் என்ற உவமையைக் கொண்டு கருத்தை உணர்த்துவதால் இது பிறிதுமொழிதல் அணி ஆகும்."}}}
{"id":"b-tam-8t2-051","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"புகழாலும் பழியாலும் அறியப்படுவது எது?"}],"options":[{"key":"A","text":"அடக்கமுடைமை"},{"key":"B","text":"நடுவுநிலைமை"},{"key":"C","text":"நாணுடைமை"},{"key":"D","text":"பொருளுடைமை"}],"explanation":"மதிப்பீட்டு வினா: நடுவுநிலைமை உடையவரா இல்லையா என்பது புகழாலும் பழியாலும் அறியப்படும்."}}}
{"id":"b-tam-8t2-052","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"பயனில்லாத களர்நிலத்திற்கு ஒப்பானவர்கள் யார்?"}],"options":[{"key":"A","text":"வலிமையற்றவர்"},{"key":"B","text":"கல்லாதவர்"},{"key":"C","text":"ஒழுக்கமற்றவர்"},{"key":"D","text":"அன்பில்லாதவர்"}],"explanation":"மதிப்பீட்டு வினா: கல்லாதவர்கள் பயனில்லாத களர்நிலம் போன்றவர் ஆவர்."}}}
{"id":"b-tam-8t2-065","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"திருக்குறள் அதிகாரங்களை அவற்றின் குறட்பா களோடு சரியாகப் பொருத்துக:"},{"type":"list","name":"அதிகாரம்","items":[{"label":"A","text":"நடுவுநிலைமை"},{"label":"B","text":"கூடா ஒழுக்கம்"},{"label":"C","text":"கல்லாமை"},{"label":"D","text":"குற்றங்கடிதல்"}]},{"type":"list","name":"குறள் குறிப்பு","items":[{"label":"1","text":"வலியில் நிலைமையான் வல்லுருவம்"},{"label":"2","text":"வருமுன்னர்க் காவாதான் வாழ்க்கை"},{"label":"3","text":"சமன்செய்து சீர்தூக்கும் கோல்போல்"},{"label":"4","text":"உளர்என்னும் மாத்திரையர் அல்லால்"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}}],"explanation":"நடுவுநிலைமை = சமன்செய்து சீர்தூக்கும்; கூடா ஒழுக்கம் = வலியில் நிலைமையான்; கல்லாமை = உளர்என்னும் மாத்திரையர்; குற்றங்கடிதல் = வருமுன்னர்க் காவாதான்."}}}
{"id":"b-tam-8t2-066","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 44"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கடல்ஓடா கால்வல் நெடுந்தேர் கடல்ஓடும் நாவாயும் ஓடா நிலத்து’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?"}],"options":[{"key":"A","text":"உவமையணி"},{"key":"B","text":"பிறிதுமொழிதல் அணி"},{"key":"C","text":"உருவக அணி"},{"key":"D","text":"இல்பொருள் உவமையணி"}],"explanation":"தேரும் கப்பலும் தங்கள் உரிய இடத்தில் மட்டுமே ஓடும் என்ற உவமையைக் கொண்டு கருத்தை உணர்த்துவதால் இது பிறிதுமொழிதல் அணி ஆகும்."}}}
{"id":"b-tam-8t2-067","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 46"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வல்லுருவம்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"வல் + உருவம்"},{"key":"B","text":"வன்மை + உருவம்"},{"key":"C","text":"வல்ல + உருவம்"},{"key":"D","text":"வல்லு + உருவம்"}],"explanation":"வன்மை + உருவம் = ஈறுபோதல் விதிப்படி 'மை' கெட்டு, இனவெல்லேத்தாகி 'வல்லுருவம்' எனப் புணரும்."}}}
{"id":"b-tam-8t2-068","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 46"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நெடுமை + தேர்’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"நெடுதேர்"},{"key":"B","text":"நெடுத்தேர்"},{"key":"C","text":"நெடுந்தேர்"},{"key":"D","text":"நெடுமைதேர்"}],"explanation":"ஈறுபோதல் விதிப்படி 'மை' கெட்டு, இனவெல்லெழுத்து மிகுந்து 'நெடுந்தேர்' எனப் புணரும்."}}}
{"id":"b-tam-8t2-069","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 46"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கடல்ஓடா’ எனத் தொடங்கும் குறளில் பயின்று வந்துள்ள அணி எது?"}],"options":[{"key":"A","text":"எடுத்துக்காட்டு உவமை அணி"},{"key":"B","text":"தற்குறிப்பேற்ற அணி"},{"key":"C","text":"உவமை அணி"},{"key":"D","text":"பிறிதுமொழிதல் அணி"}],"explanation":"தேரும் கப்பலும் தங்கள் உரிய இடத்தில் மட்டுமே ஓடும் என்ற உவமையைக் கொண்டு கருத்தை உணர்த்துவதால் இது பிறிதுமொழிதல் அணி ஆகும்."}}}
{"id":"b-tam-8t2-070","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"புகழாலும் பழியாலும் அறியப்படுவது எது?"}],"options":[{"key":"A","text":"அடக்கமுடைமை"},{"key":"B","text":"நடுவுநிலைமை"},{"key":"C","text":"நாணுடைமை"},{"key":"D","text":"பொருளுடைமை"}],"explanation":"மதிப்பீட்டு வினா: நடுவுநிலைமை உடையவரா இல்லையா என்பது புகழாலும் பழியாலும் அறியப்படும்."}}}
{"id":"b-tam-8t2-071","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"text","text":"பயனில்லாத களர்நிலத்திற்கு ஒப்பானவர்கள் யார்?"}],"options":[{"key":"A","text":"வலிமையற்றவர்"},{"key":"B","text":"கல்லாதவர்"},{"key":"C","text":"ஒழுக்கமற்றவர்"},{"key":"D","text":"அன்பில்லாதவர்"}],"explanation":"மதிப்பீட்டு வினா: கல்லாதவர்கள் பயனில்லாத களர்நிலம் போன்றவர் ஆவர்."}}}
{"id":"b-tam-8t2-072","kind":"assertion_reason","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"‘வலியில் நிலைமையான் வல்லுருவம் பெற்றம் புலியின்தோல் போர்த்துமேய்ந் தற்று’ - இக்குறளில் இல்பொருள் உவமையணி பயின்று வந்துள்ளது."},{"type":"reason","text":"புலியின் தோலைப் போர்த்திக் கொண்ட பசு பயிரை மேய்ந்தது என்னும் நிகழ்வு உலகில் இல்லாத ஒன்றாகும்."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"உலகில் இல்லாத ஒன்றை உவமையாகக் கூறுவது இல்பொருள் உவமையணி ஆகும்; கூற்றும் காரணமும் சரி."}}}
{"id":"b-tam-8t2-078","kind":"assertion_reason","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 43"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"‘சமன்செய்து சீர்தூக்கும் கோல்போல் அமைந்துஒருபால் கோடாமை சான்றோர்க்கு அணி’ - இக்குறட்பாவில் உவமையணி பயின்று வந்துள்ளது."},{"type":"reason","text":"துலாக்கோல் சமமாக இருந்து எடை காட்டுவது போலச் சான்றோர்கள் நடுவுநிலைமையுடன் செயல்படுவது அழகாகும் என உவம உருபு வெளிப்படையாக வந்துள்ளது."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"உவமையும் உவமேயமும் வந்து 'போல்' என்னும் உவம உருபு வெளிப்படையாக வந்துள்ளதால் இது உவமையணி ஆகும்; கூற்றும் காரணமும் சரி."}}}
