// ==============================================================================
// 8-ஆம் வகுப்பு தமிழ் - பருவம் 2
// பாடம் 2: பட்ட மரம் (கவிதைப்பேழை - கவிஞர் தமிழ்ஒளி) [Q010 - Q015, Q054, Q055]
// வினாக்கள் எண்ணிக்கை: 8
// ==============================================================================
{"id":"b-tam-8t2-010","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 27"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மொட்டைக் கிளையொடு நின்று தினம்பெரும் மூச்சு விடும்மரமே!...’ - என்னும் ‘பட்ட மரம்’ கவிதையை இயற்றியவர் யார்?"}],"options":[{"key":"A","text":"சுரதா"},{"key":"B","text":"தமிழ்ஒளி"},{"key":"C","text":"வாணிதாசன்"},{"key":"D","text":"முடியரசன்"}],"explanation":"பட்டுப்போன மரத்தின் வருத்தத்தைக் கவிதையாகப் பாடியவர் கவிஞர் தமிழ்ஒளி ஆவார்."}}}
{"id":"b-tam-8t2-011","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 28"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பட்ட மரம்’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"விசனம்"},{"label":"B","text":"குந்த"},{"label":"C","text":"கந்தம்"},{"label":"D","text":"குமைந்தனை"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"உட்கார"},{"label":"2","text":"வருந்தினாய்"},{"label":"3","text":"கவலை"},{"label":"4","text":"மணம்"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}}],"explanation":"விசனம் = கவலை; குந்த = உட்கார; கந்தம் = மணம்; எய்தி = அடைந்து; குமைந்தனை = வருந்தினாய்; புவி = உலகம்; இற்று = அழிந்து; மிசை = மேல்."}}}
{"id":"b-tam-8t2-012","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 29"},"texts":{"ta":{"blocks":[{"type":"text","text":"கவிஞர் தமிழ்ஒளி யாருடைய கவிமரபு வழித்தோன்றலாகவும் மாணவராகவும் விளங்கியவர்?"}],"options":[{"key":"A","text":"பாரதியார்"},{"key":"B","text":"பாரதிதாசன்"},{"key":"C","text":"நாமக்கல் கவிஞர்"},{"key":"D","text":"கவிமணி"}],"explanation":"தமிழ்ஒளி பாரதியாரின் கவிமரபு வழித்தோன்றலாகவும் பாரதிதாசனின் மாணவராகவும் விளங்கியவர்."}}}
{"id":"b-tam-8t2-013","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 29"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கந்தம்’ என்னும் சொல்லுக்குரிய பொருள் யாது?"}],"options":[{"key":"A","text":"உடம்பு"},{"key":"B","text":"கவலை"},{"key":"C","text":"அழகு"},{"key":"D","text":"மணம்"}],"explanation":"கந்தம் என்றால் மணம் என்று பொருள்; மலர்களிலிருந்து வரும் கந்தம் வண்டுகளை ஈர்க்கும்."}}}
{"id":"b-tam-8t2-014","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 29"},"texts":{"ta":{"blocks":[{"type":"text","text":"மரத்தின் உடையாகக் கவிஞர் தமிழ்ஒளியால் குறிப்பிடப்படுவது எது?"}],"options":[{"key":"A","text":"இலைகள்"},{"key":"B","text":"பட்டை"},{"key":"C","text":"கிளைகள்"},{"key":"D","text":"வேர்கள்"}],"explanation":"உடையாகிய பட்டை கிழிந்ததால் மரம் தன் முழு அழகையும் இழந்தது எனக் கவிஞர் பாடுகிறார்."}}}
{"id":"b-tam-8t2-015","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 29"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வரும் + என்று’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"வருஎன்று"},{"key":"B","text":"வருமன்று"},{"key":"C","text":"வருமென்று"},{"key":"D","text":"வருமின்று"}],"explanation":"வரும் + என்று = உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி 'வருமென்று' எனப் புணரும்."}}}
{"id":"b-tam-8t2-054","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 27"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பட்ட மரம்’ கவிதையில் காலமென்னும் புயல் சீறி எதிர்க்கும்போது கலங்கும் மனிதன் எதனைச் செய்வதாகக் கவிஞர் கூறுகிறார்?"}],"options":[{"key":"A","text":"கை கூப்புவதாக"},{"key":"B","text":"ஓலமிடக் கரம் நீட்டியது போல் இருப்பதாக"},{"key":"C","text":"மண்மேல் வீழ்வதாக"},{"key":"D","text":"அழுது புலம்புவதாக"}],"explanation":"புயலால் கலங்கும் மனிதன் ஓலமிடக் கரம் நீட்டியது போல் மரம் துன்புற்று உழன்றதாகத் தமிழ்ஒளி பாடுகிறார்."}}}
{"id":"b-tam-8t2-055","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 2, பக்கம் 29"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பட்ட மரம்’ பாடலின் நயம் சார்ந்த பொருத்துகளை இணைக்க:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"குந்த"},{"label":"B","text":"வெந்து"},{"label":"C","text":"மிசை"},{"label":"D","text":"இற்று"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"தீயில் கருகிய"},{"label":"2","text":"உட்கார"},{"label":"3","text":"அழிந்து"},{"label":"4","text":"மேல்"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-2, D-4","mapping":{"A":"3","B":"1","C":"2","D":"4"}}],"explanation":"குந்த = உட்கார; வெந்து = தீயில் கருகிய; மிசை = மேல்; இற்று = அழிந்து."}}}
