// பாடம் 4: சொலவடைகள் (விரிவானம் / பொம்மலாட்டக் கதை - ஆளுக்கு ஒரு வேலை) [Q035 - Q040]
// சொலவடைகள் தனிச்சிறப்பு, எறும்பு சொலவடை, தேனீ சொலவடை, ஆமை சொலவடை, பழைய குட்டிச்சுவர், வாழ்வியல் பாடம்
// ==============================================================================
{"id":"b-tam-7t1-035","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 13"},"texts":{"ta":{"blocks":[{"type":"text","text":"சிறுசிறு தொடர்களாக வட்டாரப் பேச்சு வழக்கில் வழங்கி வரும் பொருட்செறிவுமிக்க சொலவடைகள் எதற்குரிய தனிச்சிறப்பாகும்?"}],"options":[{"key":"A","text":"பிறமொழிச் சொற்களுக்கு"},{"key":"B","text":"தொன்மை வாய்ந்த மொழிகளுக்கே உரிய தனிச்சிறப்பு"},{"key":"C","text":"நாடகங்களுக்கு மட்டுமே"},{"key":"D","text":"அறிவியல் நூல்களுக்கு"}],"explanation":"சொலவடைகள் பேச்சுமொழியின் அழகியலையும் பண்பாட்டுக் கூறுகளையும் வெளிப்படுத்தும் தொன்மையான மொழிகளுக்கே உரிய சிறப்பம்சம்."}}}
{"id":"b-tam-7t1-036","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 14"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஆளுக்கு ஒரு வேலை’ கதையில் படிக்காமல் ஊர் சுற்றிய பையனிடம் எறும்பு கூறிய சொலவடை எது?"}],"options":[{"key":"A","text":"அணை உடைஞ்சு போன வெள்ளம் அழுதாலும் வராது"},{"key":"B","text":"குடல் கூழுக்கு அழுவுதாம் கொண்டை பூவுக்கு அழுவுதாம்; சொப்பனத்தில் கண்ட அரிசி சோத்துக்கு ஆகுமா?"},{"key":"C","text":"அதிர அடிச்சா உதிர விளையும்"},{"key":"D","text":"குத்துக்கல்லுக்கு என்ன குளிரா வெயிலா"}],"explanation":"எறும்பு குழந்தைகளுக்குத் தீனி சேகரிக்க வேண்டும் எனக் கூறி இச்சொலவடையைச் சொல்லிச் சென்றது."}}}
{"id":"b-tam-7t1-037","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 14"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஆள் கூடுனா பாம்பு சாகுமா? கைய ஊனித்தான் கரணம் போட முடியும்’ - என்று சிறுவனிடம் விளையாட மறுத்துக் கூறியது எது?"}],"options":[{"key":"A","text":"எறும்பு"},{"key":"B","text":"தேனீ"},{"key":"C","text":"பொதிமாடு"},{"key":"D","text":"ஆமை"}],"explanation":"பூக்கள் மூடுவதற்குள் தேன் எடுக்க வேண்டும் என்று கூறித் தேனீ விளையாட மறுத்துவிட்டது."}}}
{"id":"b-tam-7t1-038","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 15"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அவப்பொழுது போக்குவதிலும் தவப்பொழுது நல்லது; அதிர அடிச்சா உதிர விளையும்’ - என்று தொடர் முயற்சியை வலியுறுத்தியது எது?"}],"options":[{"key":"A","text":"முயல்"},{"key":"B","text":"ஆமை"},{"key":"C","text":"மாடு"},{"key":"D","text":"தேனீ"}],"explanation":"முயலோடு பந்தயம் வைத்துள்ளதால் ஒரு நொடியும் வீணாக்க முடியாது என்று ஆமை கூறியது."}}}
{"id":"b-tam-7t1-039","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 17"},"texts":{"ta":{"blocks":[{"type":"text","text":"கதையில் சோம்பேறிப் பையன் ஏறி விளையாடி உடைத்ததால் வண்டுகளும் பூச்சிகளும் கடித்துக்குதறிய இடம் எது?"}],"options":[{"key":"A","text":"மரக்கிளை"},{"key":"B","text":"வைக்கோல் போர்"},{"key":"C","text":"மழையில் ஊறிய பழைய குட்டிச்சுவர்"},{"key":"D","text":"ஆற்றங்கரை மேடு"}],"explanation":"பழைய குட்டிச்சுவர் இடிந்து விழுந்ததும் அதிலிருந்த எறும்புகளும் பூச்சிகளும் பையனைக் கடித்துக் கதற வைத்தன."}}}
{"id":"b-tam-7t1-040","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 17"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஆளுக்கு ஒரு வேலை’ பொம்மலாட்டக் கதை உணர்த்தும் முதன்மை வாழ்வியல் பாடம் யாது?"}],"options":[{"key":"A","text":"விலங்குகளோடு நட்புக் கொள்ள வேண்டும்"},{"key":"B","text":"உலகில் சிறு உயிரினங்களும் தம் வேலையைச் செய்கின்றன; சோம்பலின்றித் தன் கடமையை (படிப்பை) ஒழுங்காகச் செய்ய வேண்டும்"},{"key":"C","text":"பழைய சுவர்களில் ஏறக்கூடாது"},{"key":"D","text":"அதிகாலையில் எழ வேண்டும்"}],"explanation":"உலகில் எல்லோருக்கும் ஒரு வேலை உண்டு; மாணவனின் கடமை படிப்பதே என்பதைப் பையன் உணர்ந்தான்."}}}
