// ==============================================================================
// 7-ஆம் வகுப்பு தமிழ் - பருவம் 1 - இயல் 1: எங்கள் தமிழ் / மொழி / கலை, அழகியல் (மொத்த வினாக்கள்: 66)
// ==============================================================================
// ==============================================================================
// பாடம் 1: எங்கள் தமிழ் (கவிதைப்பேழை - நாமக்கல் கவிஞர் வெ. இராமலிங்கனார்) [Q001 - Q012]
// அருள்நெறி அறிவைத் தரலாகும், சொல்-பொருள், காந்தியக் கவிஞர், முதல் அரசவைக் கவிஞர்,
// கொல்லா விரதம், நூல்கள்/கூற்றுகள், கத்தியின்றி ரத்தமின்றி, புணர்ச்சி (குரலாகும், வானொலி), நெறி, இயைபுத்தொடை, தமிழ் கற்றோர் பண்பு
// ==============================================================================
{"id":"b-tam-7t1-001","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அருள்நெறி அறிவைத் தரலாகும் அதுவே தமிழன் குரலாகும்...’ - என்னும் ‘எங்கள் தமிழ்’ பாடலை இயற்றிய கவிஞர் யார்?"}],"options":[{"key":"A","text":"பாரதிதாசன்"},{"key":"B","text":"நாமக்கல் கவிஞர் வெ. இராமலிங்கனார்"},{"key":"C","text":"உடுமலை நாராயணகவி"},{"key":"D","text":"முடியரசன்"}],"explanation":"7-ஆம் வகுப்பு முதல் இயலின் தொடக்கப் பாடலான 'எங்கள் தமிழ்' பாடலை இயற்றியவர் நாமக்கல் கவிஞர் வெ. இராமலிங்கனார் ஆவார்."}}}
{"id":"b-tam-7t1-002","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எங்கள் தமிழ்’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"ஊக்கிவிடும்"},{"label":"B","text":"விரதம்"},{"label":"C","text":"குறி"},{"label":"D","text":"பொழிகிற"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"நோன்பு"},{"label":"2","text":"ஊக்கப்படுத்தும்"},{"label":"3","text":"தருகின்ற"},{"label":"4","text":"குறிக்கோள்"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}}],"explanation":"ஊக்கிவிடும் = ஊக்கப்படுத்தும்; விரதம் = நோன்பு; குறி = குறிக்கோள்; பொழிகிற = தருகின்ற."}}}
{"id":"b-tam-7t1-003","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 3"},"texts":{"ta":{"blocks":[{"type":"text","text":"காந்தியடிகளின் கொள்கைகளால் ஈர்க்கப்பட்டுக் காந்தியத்தைப் பின்பற்றியதால் ‘காந்தியக் கவிஞர்’ என்று அழைக்கப்படுபவர் யார்?"}],"options":[{"key":"A","text":"கவிமணி தேசிக விநாயகனார்"},{"key":"B","text":"நாமக்கல் கவிஞர் வெ. இராமலிங்கனார்"},{"key":"C","text":"பாரதியார்"},{"key":"D","text":"உடுமலை நாராயணகவி"}],"explanation":"காந்தியடிகளின் கொள்கைகளால் பெரிதும் ஈர்க்கப்பட்டதால் நாமக்கல் கவிஞர் 'காந்தியக் கவிஞர்' என அழைக்கப்படுகிறார்."}}}
{"id":"pyq-tam-7t1-004","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":18},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழகத்தின் ‘முதல் அரசவைக் கவிஞராக’ விளங்கிய பெருமைக்குரியவர் யார்?"}],"options":[{"key":"A","text":"பாரதிதாசன்"},{"key":"B","text":"கண்ணதாசன்"},{"key":"C","text":"நாமக்கல் கவிஞர் வெ. இராமலிங்கனார்"},{"key":"D","text":"வாணிதாசன்"}],"explanation":"தமிழ்நாடு அரசின் முதல் அரசவைக் கவிஞராகப் பணியாற்றிய பெருமை நாமக்கல் கவிஞருக்கு உரியது."}}}
{"id":"b-tam-7t1-005","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"text","text":"நாமக்கல் கவிஞரின் கூற்றுப்படி, தமிழர்கள் எதனைக் குறிக்கோளாகவும் கொள்கையாகவும் கொண்டு வாழ வேண்டும்?"}],"options":[{"key":"A","text":"அன்பைக் குறிக்கோளாகவும், அறத்தைக் கொள்கையாகவும்"},{"key":"B","text":"கொல்லாமையைக் குறிக்கோளாகவும், பொய்யாமையைக் கொள்கையாகவும்"},{"key":"C","text":"பொருளீட்டுவதைக் குறிக்கோளாகவும், புகழைக் கொள்கையாகவும்"},{"key":"D","text":"கல்வியைக் குறிக்கோளாகவும், வீரத்தைக் கொள்கையாகவும்"}],"explanation":"'கொல்லா விரதம் குறியாகக் கொள்கை பொய்யா நெறியாக' - கொல்லாமையைக் குறிக்கோளாகவும் பொய்யாமையைக் கொள்கையாகவும் கொள்ள வேண்டும் என்கிறார்."}}}
{"id":"b-tam-7t1-006","kind":"statements","unit_id":"ta-literature","level":"SSLC","correct_key":"D","is_negative":false,"structure":{"kind":"statements","truth":{"I":true,"II":true,"III":true}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 3"},"texts":{"ta":{"blocks":[{"type":"text","text":"நாமக்கல் கவிஞர் வெ. இராமலிங்கனார் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:"},{"type":"statement","label":"I","text":"இவர் தமிழறிஞர், கவிஞர், ஓவியர், விடுதலைப் போராட்ட வீரர் எனப் பன்முகத் தன்மை கொண்டவர்."},{"type":"statement","label":"II","text":"மலைக்கள்ளன், தமிழன் இதயம், என்கதை, சங்கொலி உள்ளிட்ட பல்வேறு நூல்களை எழுதியுள்ளார்."},{"type":"statement","label":"III","text":"பாடப்பகுதியில் இடம்பெற்றுள்ள ‘எங்கள் தமிழ்’ பாடல் ‘நாமக்கல் கவிஞர் பாடல்கள்’ என்னும் நூலிலிருந்து தரப்பட்டுள்ளது."}],"options":[{"key":"A","text":"I மற்றும் II சரி","selects":["I","II"]},{"key":"B","text":"II மற்றும் III சரி","selects":["II","III"]},{"key":"C","text":"I மற்றும் III சரி","selects":["I","III"]},{"key":"D","text":"அனைத்தும் சரி","selects":"all"}],"explanation":"நூல் வெளிப் பகுதியின்படி நாமக்கல் கவிஞர் குறித்த மூன்று கூற்றுகளும் முற்றிலும் சரியானவை."}}}
{"id":"pyq-tam-7t1-007","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":21},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கத்தியின்றி ரத்தமின்றி யுத்தமொன்று வருகுது; சத்தியத்தின் நித்தியத்தை நம்பும்யாரும் சேருவீர்!’ - என்று பாடிய தேசியக் கவிஞர் யார்?"}],"options":[{"key":"A","text":"மகாகவி பாரதியார்"},{"key":"B","text":"நாமக்கல் கவிஞர் வெ. இராமலிங்கனார்"},{"key":"C","text":"பாரதிதாசன்"},{"key":"D","text":"கவிமணி"}],"explanation":"உப்புச் சத்தியாகிரகப் போராட்டத்தின்போது வழிநடைப் பாடலாக இப்பாடலை நாமக்கல் கவிஞர் பாடினார்."}}}
{"id":"b-tam-7t1-008","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘குரலாகும்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"குரல் + யாகும்"},{"key":"B","text":"குரல் + ஆகும்"},{"key":"C","text":"குர + லாகும்"},{"key":"D","text":"குர + ஆகும்"}],"explanation":"உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி (ல் + ஆ = லா) குரல் + ஆகும் = குரலாகும் எனப் புணரும்."}}}
{"id":"b-tam-7t1-009","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வான் + ஒலி’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"வான்ஒலி"},{"key":"B","text":"வானொலி"},{"key":"C","text":"வாவொலி"},{"key":"D","text":"வானெலி"}],"explanation":"உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி (ன் + ஒ = நொ) வான் + ஒலி = வானொலி எனப் புணரும்."}}}
{"id":"b-tam-7t1-010","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 4"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நெறி’ என்னும் சொல்லின் சரியான பொருள் யாது?"}],"options":[{"key":"A","text":"வழி"},{"key":"B","text":"குறிக்கோள்"},{"key":"C","text":"கொள்கை"},{"key":"D","text":"அறம்"}],"explanation":"நெறி என்றால் 'வழி' என்று பொருள்; அருள்நெறி = அருள் வழிகள்."}}}
{"id":"b-tam-7t1-011","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 3"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தரலாகும் - குரலாகும்’, ‘புகழாது - இகழாது’ ஆகிய அடிகளின் இறுதியில் வரும் சொற்களில் அமைந்துள்ள தொடை நயம் யாது?"}],"options":[{"key":"A","text":"மோனைத்தொடை"},{"key":"B","text":"எதுகைத்தொடை"},{"key":"C","text":"இயைபுத்தொடை"},{"key":"D","text":"முரண்தொடை"}],"explanation":"அடிகளின் இறுதியில் சொற்கள் ஒரே ஓசையிலோ ஒரே எழுத்திலோ முடிவது இயைபுத்தொடை எனப்படும்."}}}
{"id":"b-tam-7t1-012","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 2"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ்மொழியைக் கற்ற அறிவார்ந்த சான்றோரின் இயல்பாக நாமக்கல் கவிஞர் எதனைக் கூறுகிறார்?"}],"options":[{"key":"A","text":"செல்வத்திற்காக எவரையும் புகழ்ந்து பாடுவர்"},{"key":"B","text":"பொருள் பெறுவதற்காக யாரையும் புகழ மாட்டார்; தம்மைப் போற்றாதவர்களையும் இகழ மாட்டார்"},{"key":"C","text":"பகைவரை அஞ்சி ஒதுங்குவர்"},{"key":"D","text":"அரசனின் தயவை மட்டுமே நாடுவர்"}],"explanation":"'பொருள்பெற யாரையும் புகழாது போற்றாதாரையும் இகழாது' என்பதே தமிழ் கற்றோரின் பண்பாகும்."}}}
// ==============================================================================
// பாடம் 2: ஒன்றல்ல இரண்டல்ல (கவிதைப்பேழை - உடுமலை நாராயணகவி) [Q013 - Q022]
// ஒன்றல்ல இரண்டல்ல, சொல்-பொருள், பகுத்தறிவுக் கவிராயர், பரணி, முகில், புணர்ச்சி (இரண்டல்ல, தந்துதவும், ஒப்புமையில்லாத),
// குமண வள்ளல் (கவிச்சொல்லுக்குத் தலை), உடுமலை நாராயணகவி குறித்த கூற்று
// ==============================================================================
{"id":"b-tam-7t1-013","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 5"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஒன்றல்ல இரண்டல்ல தம்பி - சொல்ல ஒப்புமை இல்லாத அற்புதம் தமிழ்நாட்டில்’ - என்ற பாடலை இயற்றியவர் யார்?"}],"options":[{"key":"A","text":"பட்டுக்கோட்டை கல்யாணசுந்தரம்"},{"key":"B","text":"உடுமலை நாராயணகவி"},{"key":"C","text":"மருதகாசி"},{"key":"D","text":"கண்ணதாசன்"}],"explanation":"தமிழ்நாட்டின் இயற்கை, இலக்கிய மற்றும் வள்ளல்களின் பெருமையைப் போற்றி 'ஒன்றல்ல இரண்டல்ல' பாடலை இயற்றியவர் உடுமலை நாராயணகவி."}}}
{"id":"b-tam-7t1-014","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"4","C":"1","D":"3"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 5"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஒன்றல்ல இரண்டல்ல’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"ஒப்புமை"},{"label":"B","text":"அற்புதம்"},{"label":"C","text":"முகில்"},{"label":"D","text":"உபகாரி"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"மேகம்"},{"label":"2","text":"இணை"},{"label":"3","text":"வள்ளல்"},{"label":"4","text":"வியப்பு"}]}],"options":[{"key":"A","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"D","text":"A-4, B-3, C-2, D-1","mapping":{"A":"4","B":"3","C":"2","D":"1"}}],"explanation":"ஒப்புமை = இணை; அற்புதம் = Viewப்பு; முகில் = மேகம்; உபகாரி = வள்ளல்."}}}
{"id":"pyq-tam-7t1-015","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2018,"paper":"tamil","no":42},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பகுத்தறிவுக் கவிராயர்’ என்று தமிழக மக்களால் போற்றிப் புகழப்படுபவர் யார்?"}],"options":[{"key":"A","text":"நாமக்கல் கவிஞர்"},{"key":"B","text":"பாரதிதாசன்"},{"key":"C","text":"உடுமலை நாராயணகவி"},{"key":"D","text":"புலவர் குழந்தை"}],"explanation":"தமது பாடல்கள் மூலம் பகுத்தறிவுக் கருத்துகளைப் பரப்பிய உடுமலை நாராயணகவி 'பகுத்தறிவுக் கவிராயர்' எனப் புகழப்படுகிறார்."}}}
{"id":"b-tam-7t1-016","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 7"},"texts":{"ta":{"blocks":[{"type":"text","text":"பகைவரைப் போரில் வென்ற சிறப்பைப் பாடும் இலக்கிய வகை எது?"}],"options":[{"key":"A","text":"கலம்பகம்"},{"key":"B","text":"பரிபாடல்"},{"key":"C","text":"பரணி"},{"key":"D","text":"அந்தாதி"}],"explanation":"ஆயிரம் யானைகளை அமரிடை வென்ற வீரனைப் பாடுவது 'பரணி' இலக்கியம் ஆகும்."}}}
{"id":"b-tam-7t1-017","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 7"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வானில் ________ கூட்டம் திரண்டால் மழை பொழியும்’ - பொருத்தமான சொல்லைத் தேர்வு செய்க:"}],"options":[{"key":"A","text":"அகில்"},{"key":"B","text":"முகில்"},{"key":"C","text":"துகில்"},{"key":"D","text":"துயில்"}],"explanation":"முகில் என்றால் மேகம் என்று பொருள்; வானில் முகில் கூட்டம் திரண்டால் மழை பொழியும்."}}}
{"id":"b-tam-7t1-018","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 7"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இரண்டல்ல’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"இரண்டு + டல்ல"},{"key":"B","text":"இரண் + அல்ல"},{"key":"C","text":"இரண்டு + இல்ல"},{"key":"D","text":"இரண்டு + அல்ல"}],"explanation":"உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி உ கெட்டு, ட் + அ = ட ஆகி 'இரண்டல்ல' எனப் புணரும்."}}}
{"id":"b-tam-7t1-019","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 7"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தந்துதவும்’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"தந்து + உதவும்"},{"key":"B","text":"தா + உதவும்"},{"key":"C","text":"தந்து + தவும்"},{"key":"D","text":"தந்த + உதவும்"}],"explanation":"தந்து + உதவும் = உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி 'தந்துதவும்' எனப் புணரும்."}}}
{"id":"b-tam-7t1-020","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 7"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஒப்புமை + இல்லாத’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"ஒப்புமை இல்லாத"},{"key":"B","text":"ஒப்பில்லாத"},{"key":"C","text":"ஒப்புமையில்லாத"},{"key":"D","text":"ஒப்புஇல்லாத"}],"explanation":"'இ ஈ ஐ வழி யவ்வும்' விதிப்படி உடம்படுமெய் ய் தோன்றி (ய் + இ = யி), 'ஒப்புமையில்லாத' எனப் புணரும்."}}}
{"id":"b-tam-7t1-021","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 5"},"texts":{"ta":{"blocks":[{"type":"text","text":"புலவர் பெருந்தலைச் சாத்தனாரின் தமிழ்ச் சொல்லுக்காகத் தன் தலையையே தரத் துணிந்த கடையெழு வள்ளல்களுக்குப் பின்வந்த வள்ளல் யார்?"}],"options":[{"key":"A","text":"வேள்பாரி"},{"key":"B","text":"குமண வள்ளல்"},{"key":"C","text":"அதியமான்"},{"key":"D","text":"பேகன்"}],"explanation":"'கவிச்சொல்லுக்குத் தலைகொடுத்தான் அருள்மீறி இந்த வள்ளலாம் குமணன்' என்று உடுமலை நாராயணகவி பாடியுள்ளார்."}}}
{"id":"b-tam-7t1-022","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 6"},"texts":{"ta":{"blocks":[{"type":"text","text":"உடுமலை நாராயணகவி குறித்த சரியான கூற்று எது?"}],"options":[{"key":"A","text":"இவர் காந்தியக் கவிஞர் எனப் போற்றப்பட்டவர்"},{"key":"B","text":"தமிழ்த் திரைப்படப் பாடலாசிரியராகவும் நாடக எழுத்தாளராகவும் நாட்டுப்புற இசையின் எளிமையைக் கையாண்டு கவிதைகள் எழுதியவர்"},{"key":"C","text":"தமிழக அரசின் முதல் அரசவைக் கவிஞர்"},{"key":"D","text":"சாகித்திய அகாதெமி விருது பெற்ற நாவலாசிரியர்"}],"explanation":"உடுமலை நாராயணகவி திரைப்படப் பாடலாசிரியராகவும் நாடக எழுத்தாளராகவும் பகுத்தறிவுக் கருத்துகளைப் பரப்பியவர்."}}}
