{"id":"b-tam-7t1-023","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 8"},"texts":{"ta":{"blocks":[{"type":"text","text":"மொழியின் ‘முதல் நிலை’ என்று எவற்றைக் குறிப்பிடுகிறோம்?"}],"options":[{"key":"A","text":"படித்தலும் எழுதுதலும்"},{"key":"B","text":"கேட்டலும் பேசுதலும்"},{"key":"C","text":"எண்ணுதலும் வரைதலும்"},{"key":"D","text":"பார்த்தலும் உணர்தலும்"}],"explanation":"வாயினால் பேசப்பட்டுப் பிறரால் கேட்டு உணரப்படுவது பேச்சுமொழி; இவ்வாறு கேட்பதும் பேசுவதும் மொழியின் முதல் நிலை ஆகும்."}}}
{"id":"b-tam-7t1-024","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 8"},"texts":{"ta":{"blocks":[{"type":"text","text":"கண்ணால் கண்டு உணருமாறு வரிவடிவமாக எழுதப்பட்டுப் படிக்கப்படும் மொழியின் இரண்டாம் நிலை எது?"}],"options":[{"key":"A","text":"பேச்சுமொழி"},{"key":"B","text":"எழுத்துமொழி"},{"key":"C","text":"வட்டாரமொழி"},{"key":"D","text":"கிளைமொழி"}],"explanation":"வரிவடிவமாக எழுதப்பட்டுப் படிக்கப்படுவது எழுத்துமொழி; இது மொழியின் இரண்டாம் நிலை ஆகும்."}}}
{"id":"pyq-tam-7t1-025","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":48},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பேசப்படுவதும் கேட்கப்படுவதுமே உண்மையான மொழி; எண்ணப்படுவது, நினைக்கப்படுவது, கனவு காணப்படுவது ஆகியவையும் மொழியே ஆகும்’ - எனக் கூறிய தமிழறிஞர் யார்?"}],"options":[{"key":"A","text":"திரு.வி.க."},{"key":"B","text":"முனைவர் மு. வரதராசனார்"},{"key":"C","text":"பாரதிதாசன்"},{"key":"D","text":"தேவநேயப் பாவாணர்"}],"explanation":"பக்கம் 9 தெரிந்து தெளிவோம் பகுதியில் டாக்டர் மு. வரதராசனாரின் இக்கூற்று தெளிவாக இடம்பெற்றுள்ளது."}}}
{"id":"b-tam-7t1-026","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 9"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எடுத்தல் படுத்தல் நலிதல் உழப்பில் திரிபும் தத்தமில் சிறிது உள வாகும்’ - என்ற நூற்பா வரிகள் இடம்பெற்றுள்ள இலக்கண நூல் எது?"}],"options":[{"key":"A","text":"தொல்காப்பியம்"},{"key":"B","text":"நன்னூல்"},{"key":"C","text":"வீரசோழியம்"},{"key":"D","text":"நேமிநாதம்"}],"explanation":"சொல்லை ஒலிப்பதில் ஏற்படும் ஏற்ற இறக்கத்தால் பொருள் வேறுபடும் என்பதை நன்னூல் நூற்பா விளக்குகிறது."}}}
{"id":"b-tam-7t1-027","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 9"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஒரே மொழியின் வெவ்வேறு வடிவங்கள் மனிதர்களின் வாழ்வியல் சூழலுக்கு ஏற்பவும் இடத்திற்கு இடம் மாறுபட்டு உருவாவது எவ்வாறு அழைக்கப்படும்?"}],"options":[{"key":"A","text":"எழுத்துமொழி"},{"key":"B","text":"வட்டார மொழி"},{"key":"C","text":"கிளைமொழி"},{"key":"D","text":"இரட்டை வழக்கு"}],"explanation":"இடத்திற்கு இடம் மாறுபடும் பேச்சுமொழியின் வெவ்வேறு வடிவங்களை 'வட்டார மொழி' என்பர் (எ.கா: இருக்கிறது - இருக்கு, கீது)."}}}
{"id":"b-tam-7t1-028","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 10"},"texts":{"ta":{"blocks":[{"type":"text","text":"வாழும் இடத்தின் நில அமைப்பு, இயற்கைத் தடைகள் காரணமாகத் தொடர்புகள் குறையும்போது மூல மொழியிலிருந்து திராவிட மொழிகள் பிரிந்து உருவானவை எவை?"}],"options":[{"key":"A","text":"உயர் மொழிகள்"},{"key":"B","text":"வட்டார வழக்குகள்"},{"key":"C","text":"கிளைமொழிகள் (கன்னடம், தெலுங்கு, மலையாளம்)"},{"key":"D","text":"எழுத்து மொழிகள்"}],"explanation":"கன்னடம், தெலுங்கு, மலையாளம் முதலிய திராவிட மொழிகள் தமிழிலிருந்து பிரிந்து சென்ற கிளைமொழிகள் ஆகும்."}}}
{"id":"b-tam-7t1-029","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 10"},"texts":{"ta":{"blocks":[{"type":"text","text":"பேச்சுமொழிக்கும் எழுத்துமொழிக்கும் இடையே பெரிய அளவில் வேறுபாடு இருந்தால் அஃது எவ்வாறு அழைக்கப்படும்?"}],"options":[{"key":"A","text":"முரண் மொழி"},{"key":"B","text":"இரட்டை வழக்கு மொழி (Diglossic Language)"},{"key":"C","text":"இயல்பு மொழி"},{"key":"D","text":"செம்மொழி"}],"explanation":"தமிழில் பேச்சுமொழிக்கும் எழுத்துமொழிக்கும் இடையே வேறுபாடு உள்ளதால் தமிழை 'இரட்டை வழக்கு மொழி' என்பர்."}}}
{"id":"pyq-tam-7t1-030","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":52},"texts":{"ta":{"blocks":[{"type":"text","text":"தொல்காப்பியர் பேச்சுமொழியையும் எழுத்துமொழியையும் முறையே எவ்வாறு குறிப்பிட்டுள்ளார்?"}],"options":[{"key":"A","text":"இயல் வழக்கு, தகுதி வழக்கு"},{"key":"B","text":"உலக வழக்கு, செய்யுள் வழக்கு"},{"key":"C","text":"உரைநடை வழக்கு, கவிதை வழக்கு"},{"key":"D","text":"செந்தமிழ், கொடுந்தமிழ்"}],"explanation":"தொல்காப்பியர் பேச்சுமொழியை 'உலக வழக்கு' என்றும், எழுத்துமொழியைச் 'செய்யுள் வழக்கு' என்றும் கூறியுள்ளார்."}}}
{"id":"b-tam-7t1-031","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 11"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘எளியநடையில் தமிழ்நூல் எழுதிடவும் வேண்டும்... செந்தமிழைச் செழுந்தமிழாய்ச் செய்வதுவும் வேண்டும்’ - என்று பாடிய புரட்சிக் கவிஞர் யார்?"}],"options":[{"key":"A","text":"பாரதியார்"},{"key":"B","text":"பாவேந்தர் பாரதிதாசன்"},{"key":"C","text":"நாமக்கல் கவிஞர்"},{"key":"D","text":"வாணிதாசன்"}],"explanation":"தமிழ்மொழியை எளிய நடையில் வளர்த்துச் செழுந்தமிழாக்க வேண்டும் என்று விரும்பியவர் பாவேந்தர் பாரதிதாசன் ஆவார்."}}}
{"id":"b-tam-7t1-032","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 12"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஒலியின் வரிவடிவம் ________ ஆகும்."}],"options":[{"key":"A","text":"பேச்சு"},{"key":"B","text":"எழுத்து"},{"key":"C","text":"குரல்"},{"key":"D","text":"பாட்டு"}],"explanation":"ஒலியின் வரிவடிவமே எழுத்து எனப்படுகிறது; பேச்சின் ஒலிவடிவமே பேச்சுமொழி."}}}
{"id":"b-tam-7t1-033","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 12"},"texts":{"ta":{"blocks":[{"type":"text","text":"கீழ்க்கண்டவற்றுள் தமிழின் கிளைமொழிகளுள் ஒன்று எது?"}],"options":[{"key":"A","text":"உருது"},{"key":"B","text":"இந்தி"},{"key":"C","text":"தெலுங்கு"},{"key":"D","text":"ஆங்கிலம்"}],"explanation":"கன்னடம், தெலுங்கு, மலையாளம் போன்றவை தமிழிலிருந்து பிரிந்து சென்ற கிளைமொழிகள் ஆகும்."}}}
{"id":"b-tam-7t1-034","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 12"},"texts":{"ta":{"blocks":[{"type":"text","text":"பேச்சுமொழியை ________ வழக்கு என்றும் கூறுவர்."}],"options":[{"key":"A","text":"இலக்கிய"},{"key":"B","text":"உலக"},{"key":"C","text":"நூல்"},{"key":"D","text":"செய்யுள்"}],"explanation":"பேச்சுமொழியை உலக வழக்கு என்றும், எழுத்துமொழியை இலக்கிய வழக்கு என்றும் அழைப்பர்."}}}
