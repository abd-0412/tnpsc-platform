// பாடம் 6: மொழியை ஆள்வோம், கலைச்சொற்கள் & தொகைச்சொல் [Q060 - Q066]
// ஐந்திணை விரிவு, அறுசுவை விரிவு, இருபொருள் சொற்கள் (மொழி, நடை, நட),
// கலைச்சொற்கள் (Media, Linguistics, Phonology, Journalism, Periodical, Puppetry, Orthography, Dialogue)
// ==============================================================================
{"id":"b-tam-7t1-060","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 23"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஐந்திணை’ என்னும் தொகைச்சொல்லின் விரிவு யாது?"}],"options":[{"key":"A","text":"அகத்திணை, புறத்திணை, கைக்கிளை, பெருந்திணை, பொதுவியல்"},{"key":"B","text":"குறிஞ்சி, முல்லை, மருதம், நெய்தல், பாலை"},{"key":"C","text":"நன்செய், புன்செய், வன்புலம், மென்புலம், உவர்"},{"key":"D","text":"நாடு, நகரம், ஊர், குளம், காடு"}],"explanation":"ஐந்திணை என்பது குறிஞ்சி, முல்லை, மருதம், நெய்தல், பாலை என்னும் நால்வகை நில ஒழுக்கங்களைக் குறிக்கும்."}}}
{"id":"b-tam-7t1-061","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 23"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அறுசுவை’ என்னும் தொகைச்சொல்லில் அமைந்த ஆறு சுவைகள் எவை?"}],"options":[{"key":"A","text":"இனிப்பு, புளிப்பு, காரம், கசப்பு, உவர்ப்பு, தேன்"},{"key":"B","text":"இனிப்பு, கசப்பு, கார்ப்பு, உவர்ப்பு, புளிப்பு, துவர்ப்பு"},{"key":"C","text":"இனிமை, வன்மை, மென்மை, அருமை, பெருமை, சிறுமை"},{"key":"D","text":"பால், பழம், தேன், நெய், சர்க்கரை, பருப்பு"}],"explanation":"அறுசுவை: இனிப்பு, கசப்பு, கார்ப்பு, உவர்ப்பு, புளிப்பு, துவர்ப்பு."}}}
{"id":"b-tam-7t1-062","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 23"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மழலை பேசும் ________ அழகு; இனிமைத் தமிழ் ________ எமது’ - இருபொருள் தரும் ஒரே சொல்லால் நிரப்புக:"}],"options":[{"key":"A","text":"பாடல்"},{"key":"B","text":"மொழி"},{"key":"C","text":"சொல்"},{"key":"D","text":"குரல்"}],"explanation":"'மொழி' என்பது மழலையின் பேச்சையும், தாய்மொழியையும் குறிக்கும் இருபொருள் சொல்லாகும்."}}}
{"id":"b-tam-7t1-063","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 23"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘அன்னை தந்தையின் கைப்பிடித்துக் குழந்தை ________ பழகும்; அறிஞர் அண்ணாவின் சிறப்பு அவரது அடுக்குமொழி ________’ - சரியான சொல் எது?"}],"options":[{"key":"A","text":"பேச்சு"},{"key":"B","text":"நடை"},{"key":"C","text":"உரை"},{"key":"D","text":"ஓட்டம்"}],"explanation":"நடை என்பது குழந்தையின் நடை பழகுதலையும், அண்ணாவின் அடுக்குமொழி இலக்கிய நடையையும் குறிக்கும்."}}}
{"id":"b-tam-7t1-064","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 23"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘உழவர்கள் நாற்று ________ வயலுக்குச் செல்வர்; குழந்தையை மெதுவாக ________ என்போம்’ - சரியான இருபொருள் சொல் எது?"}],"options":[{"key":"A","text":"பறிக்க"},{"key":"B","text":"நட"},{"key":"C","text":"பார்க்க"},{"key":"D","text":"எடுக்க"}],"explanation":"நட என்பது வயலில் நாற்று நடுதலையும், குழந்தையைக் காலால் நடந்து செல்லக் கூறுதலையும் குறிக்கும்."}}}
{"id":"b-tam-7t1-065","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 23"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஊடகம் மற்றும் மொழியியல் கலைச்சொற்களைச் சரியாகப் பொருத்துக:"},{"type":"list","name":"ஆங்கிலக் கலைச்சொல்","items":[{"label":"A","text":"Media"},{"label":"B","text":"Linguistics"},{"label":"C","text":"Phonology"},{"label":"D","text":"Journalism"}]},{"type":"list","name":"தமிழாக்கம்","items":[{"label":"1","text":"மொழியியல்"},{"label":"2","text":"ஊடகம்"},{"label":"3","text":"இதழியல்"},{"label":"4","text":"ஒலியியல்"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"D","text":"A-4, B-1, C-2, D-3","mapping":{"A":"4","B":"1","C":"2","D":"3"}}],"explanation":"Media = ஊடகம்; Linguistics = மொழியியல்; Phonology = ஒலியியல்; Journalism = இதழியல்."}}}
{"id":"b-tam-7t1-066","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"7-ஆம் வகுப்பு தமிழ், பருவம் 1, இயல் 1, பக்கம் 23"},"texts":{"ta":{"blocks":[{"type":"text","text":"கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"},{"type":"list","name":"ஆங்கிலக் கலைச்சொல்","items":[{"label":"A","text":"Periodical"},{"label":"B","text":"Puppetry"},{"label":"C","text":"Orthography"},{"label":"D","text":"Dialogue"}]},{"type":"list","name":"தமிழாக்கம்","items":[{"label":"1","text":"பொம்மலாட்டம்"},{"label":"2","text":"உரையாடல்"},{"label":"3","text":"பருவ இதழ்"},{"label":"4","text":"எழுத்து இலக்கணம்"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}}],"explanation":"Periodical = பருவ இதழ்; Puppetry = பொம்மலாட்டம்; Orthography = எழுத்து இலக்கணம்; Dialogue = உரையாடல்."}}}
