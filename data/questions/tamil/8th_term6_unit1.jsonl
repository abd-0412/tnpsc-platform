{"id":"b-tam-8t6-049","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 131"},"texts":{"ta":{"blocks":[{"type":"text","text":"சமூகவியல் கலைச்சொற்களைச் சரியாகப் பொருத்துக:"},{"type":"list","name":"ஆங்கிலச் சொல்","items":[{"label":"A","text":"Literacy"},{"label":"B","text":"Empathy"}]},{"type":"list","name":"தமிழாக்கம்","items":[{"label":"1","text":"அனுதாபம்"},{"label":"2","text":"எழுத்தறிவு"},{"label":"3","text":"அறக்கொடை"}]}],"options":[{"key":"A","text":"A-2, B-1","mapping":{"A":"2","B":"1"}},{"key":"B","text":"A-1, B-2","mapping":{"A":"1","B":"2"}},{"key":"C","text":"A-2, B-3","mapping":{"A":"2","B":"3"}},{"key":"D","text":"A-3, B-1","mapping":{"A":"3","B":"1"}}],"explanation":"Literacy = எழுத்தறிவு; Empathy = அனுதாபம்."}}}
