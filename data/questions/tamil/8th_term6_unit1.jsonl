// ==============================================================================
// பாடம் 1: சிங்கி பெற்ற பரிசு (கவிதைப்பேழை - காவடிச்சிந்து / அண்ணாமலையார்) [11 வினாக்கள்: Q001, Q002, Q003, Q015, Q021, Q022, Q031, Q032, Q039, Q043, Q046]
// சிங்கி பெற்ற பரிசு - சென்னிக்குளம் அண்ணாமலையார் (காவடிச்சிந்து),
// காவடிச்சிந்து மரபு, கழுகுமலை முருகன் திருத்தலம்,
// சொல்லும் பொருளும் (தெண்டன்: தண்டனைக்குரியவன், சண்டாளன்: தீயவன், காணி: நில அளவு, பாரம்பரியம்: மரபுவழிச் சொத்து),
// 19-ஆம் நூற்றாண்டு கவிஞர் சென்னிக்குளம் அண்ணாமலையார்
// ==============================================================================
{"id":"b-tam-8t6-001","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 114"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சிங்கி பெற்ற பரிசு’ என்னும் கவிதைப் பகுதி எந்த நூலிலிருந்து எடுக்கப்பட்டுள்ளது?"}],"options":[{"key":"A","text":"முக்கூடல் பள்ளு"},{"key":"B","text":"காவடிச்சிந்து (அண்ணாமலையார்)"},{"key":"C","text":"குற்றாலக் குறவஞ்சி"},{"key":"D","text":"அழகர்கள்ளை நாடகம்"}],"explanation":"சென்னிக்குளம் அண்ணாமலையார் பாடிய 'காவடிச்சிந்து' நூலிலிருந்து 'சிங்கி பெற்ற பரிசு' பகுதி பாடமாகத் தரப்பட்டுள்ளது."}}}
{"id":"b-tam-8t6-002","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"4","C":"1","D":"3"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 115"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சிங்கி பெற்ற பரிசு’ பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"தெண்டன்"},{"label":"B","text":"சண்டாளன்"},{"label":"C","text":"காணி"},{"label":"D","text":"பாரம்பரியம்"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"நில அளவை முறை / நிலம்"},{"label":"2","text":"தண்டனைக்குரியவன் / கொடியவன்"},{"label":"3","text":"மரபுவழிச் சொத்து"},{"label":"4","text":"தீயவன் / கீழ ானவன்"}]}],"options":[{"key":"A","text":"A-2, B-4, C-1, D-3","mapping":{"A":"2","B":"4","C":"1","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-3, C-1, D-4","mapping":{"A":"2","B":"3","C":"1","D":"4"}},{"key":"D","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}}],"explanation":"தெண்டன் = தண்டனைக்குரியவன்; சண்டாளன் = தீயவன்; காணி = நில அளவு; சிங்கி = குறத்தி; சிங்ஜன் = குறவன்."}}}
{"id":"b-tam-8t6-003","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 116"},"texts":{"ta":{"blocks":[{"type":"text","text":"தென்னிந்தியாவில் காவடிச் சிந்து பாடும் மரபுக்கு வித்திட்டவரும், கழுகுமலை முருகன் மீது காவடிச்சிந்து பாடியவருமான கவிஞர் யார்?"}],"options":[{"key":"A","text":"அழகிய சொக்கநாதர்"},{"key":"B","text":"சென்னிக்குளம் அண்ணாமலையார்"},{"key":"C","text":"கடிகைமுத்துப் புலவர்"},{"key":"D","text":"முன்றுறை அரையனார்"}],"explanation":"காவடிச்சிந்து பாடல்களின் தந்தை என அழைக்கப்படும் சென்னிக்குளம் அண்ணாமலையார் இந்நூலின் ஆசிரியர் ஆவார்."}}}
{"id":"b-tam-8t6-015","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 114"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சிங்கி பெற்ற பரிசு’ பாடலில் சிங்கிடம் குறவன் கூறிய பரிசுப் பொருள்கள் எவை?"}],"options":[{"key":"A","text":"பொன்னும் மணியும்"},{"key":"B","text":"காவடிச் சிந்து பாடும் முறையும் நில உரிமையும்"},{"key":"C","text":"பட்டு ஆடைகளும் அணிகலன்களும்"},{"key":"D","text":"வேட்டைப் பொருள்களும்"}],"explanation":"காவடிச்சிந்து கலை மற்றும் நாட்டிலுள்ள மரபுச் சொத்துகள் சிங்கிக்குச் பரிசாக வழங்கப்பட்டதாகக் கூறப்பட்டுள்ளது."}}}
{"id":"b-tam-8t6-021","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 114"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சிங்கி பெற்ற பரிசு’ பாடலில் இடம்பெற்றுள்ள ‘தெண்டன்’ என்னும் சொல்லின் பொருள் யாது?"}],"options":[{"key":"A","text":"அன்பானவன்"},{"key":"B","text":"தண்டனைக்குரியவன் / கொடியவன்"},{"key":"C","text":"செல்வந்தன்"},{"key":"D","text":"அரசன்"}],"explanation":"தெண்டன் என்னும் சொல் தண்டனைக்குரியவன் என்னும் பொருளில் பாடலில் பயின்று வந்துள்ளது."}}}
{"id":"b-tam-8t6-022","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 115"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘காணி’ என்னும் சொல் எதனைக் குறிக்கிறது?"}],"options":[{"key":"A","text":"பணம்"},{"key":"B","text":"நில அளவை முறை / நிலம்"},{"key":"C","text":"தங்கம்"},{"key":"D","text":"தானியம்"}],"explanation":"காணி என்பது பழந்தமிழர் பயன்படுத்திய நில அளவைக் குறிக்கும் சொல்லாகும்."}}}
{"id":"b-tam-8t6-031","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 114"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சிங்கி பெற்ற பரிசு’ பாடலில் குறவன் சிங்கியை எங்கு அழைத்துச் செல்வதாகக் கூறுகிறான்?"}],"options":[{"key":"A","text":"மலைப் பகுதிக்கு"},{"key":"B","text":"கழுகுமலைத் திருத்தலத்திற்கு"},{"key":"C","text":"மதுரை நகருக்கு"},{"key":"D","text":"கடற்கரைக்கு"}],"explanation":"கழுகுமலை முருகனைத் தரிசிக்கச் செல்லும் முறையைக் குறவன் சிங்கிடம் கூறுவது பாடலின் கருத்தாகும்."}}}
{"id":"b-tam-8t6-032","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 115"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சிங்கி பெற்ற பரிசு’ பாடலில் குறிப்பிடப்படும் ‘சண்டாளன்’ என்னும் சொல் எத்தகையோரைக் குறிக்கிறது?"}],"options":[{"key":"A","text":"அன்பானவன்"},{"key":"B","text":"தீயவன் / கீழானவன்"},{"key":"C","text":"வீரன்"},{"key":"D","text":"அரசன்"}],"explanation":"சண்டாளன் என்னும் சொல் பாடலில் தீயவன் என்னும் பொருளில் பயன்படுத்தப்பட்டுள்ளது."}}}
{"id":"b-tam-8t6-039","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 116"},"texts":{"ta":{"blocks":[{"type":"text","text":"சென்னிக்குளம் அண்ணாமலையார் எந்தத் திருத்தலத்தின் முருகன் மீது காவடிச்சிந்து பாடினார்?"}],"options":[{"key":"A","text":"பழனி முருகன்"},{"key":"B","text":"கழுகுமலை முருகன்"},{"key":"C","text":"திருச்செந்தூர் முருகன்"},{"key":"D","text":"திருப்பரங்குன்றம் முருகன்"}],"explanation":"அண்ணாமலையார் கழுகுமலை முருகன் மீதே காவடிச்சிந்து பாடல்களைப் படைத்துள்ளார்."}}}
{"id":"b-tam-8t6-043","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 116"},"texts":{"ta":{"blocks":[{"type":"text","text":"சென்னிக்குளம் அண்ணாமலையார் எந்தக் காலத்தில் வாழ்ந்த கவிஞர்?"}],"options":[{"key":"A","text":"17-ஆம் நூற்றாண்டு"},{"key":"B","text":"19-ஆம் நூற்றாண்டு"},{"key":"C","text":"15-ஆம் நூற்றாண்டு"},{"key":"D","text":"21-ஆம் நூற்றாண்டு"}],"explanation":"காவடிச்சிந்து பாடிய அண்ணாமலையார் 19-ஆம் நூற்றாண்டைச் சேர்ந்த கவிஞர் ஆவார்."}}}
{"id":"b-tam-8t6-046","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 115"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சிங்கி பெற்ற பரிசு’ பாடலின்படி குறவர்களின் வாழ்வியலில் எதற்கு முதலிடம் கொடுக்கப்பட்டுள்ளது?"}],"options":[{"key":"A","text":"நகர நாகரிகத்திற்கு"},{"key":"B","text":"இயற்கை வழிபாடும் முருகப் பெருமானின் பக்தியும்"},{"key":"C","text":"வணிக முறைகளுக்கு"},{"key":"D","text":"போர்க் கலைகளுக்கு"}],"explanation":"முருகன் மீது பக்தி கொண்டு காவடி எடுத்து வழிபடும் மரபு குறவர்களின் வாழ்வியலில் சிறப்பிடம் பெற்றுள்ளது."}}}

// ==============================================================================
// பாடம் 2: பாரத ரத்னா எம்.ஜி. இராமச்சந்திரன் (உரைநடை உலகம்) [13 வினாக்கள்: Q004, Q005, Q006, Q007, Q016, Q023, Q024, Q033, Q034, Q040, Q041, Q044, Q048]
// பாரத ரத்னா எம்.ஜி. இராமச்சந்திரன் (எம்.ஜி.ஆர்) வாழ்க்கை வரலாறு & மக்கள் நலப்பணிகள்,
// சத்துணவுத் திட்டம் (மதிய உணவுத் திட்ட விரிவாக்கம் - 1980களில்),
// தஞ்சாவூர் தமிழ்ப் பல்கலைக்கழகம் தோற்றுவித்தல்,
// திரைப்படப் பயணம் (சதிலீலாவதி 1936, மலைக்கள்ளன், நாடோடி மன்னன் - ஐந்து பத்தாண்டுகளுக்கும் மேலான திரையுலகச் சாதனை),
// பட்டங்கள் & விருதுகள்: மக்கள் திலகம், புரட்சி நடிகர், பொன்மனச் செம்மல், பாரத ரத்னா விருது (1988 - PYQ 2022)
// ==============================================================================
{"id":"b-tam-8t6-004","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 117"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பாரத ரத்னா எம்.ஜி. இராமச்சந்திரன்’ என்னும் உரைநடைப் பகுதி எதைக் குறிக்கோளாகக் கொண்டது?"}],"options":[{"key":"A","text":"அரசியல் வரலாறு"},{"key":"B","text":"சினிமா வாழ்க்கை"},{"key":"C","text":"ஏழை எளியோரின் நலனுக்காக அவர் ஆற்றிய மக்கள் நலப்பணிகள்"},{"key":"D","text":"வெளிநாட்டுப் பயணம்"}],"explanation":"எம்.ஜி.ஆர் அவர்களின் புரட்சிகரமான திட்டங்கள் மற்றும் ஏழைகளின் தோழனாக அவர் ஆற்றிய தொண்டுகளை விளக்குகிறது."}}}
{"id":"b-tam-8t6-005","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 118"},"texts":{"ta":{"blocks":[{"type":"text","text":"எம்.ஜி.ஆர் அவர்களின் பெருமுயற்சியால் தமிழகத்தில் பள்ளிக் குழந்தைகளுக்கு வழங்கப்பட்ட புரட்சிகரமான திட்டம் எது?"}],"options":[{"key":"A","text":"இலவசக் கல்வித் திட்டம்"},{"key":"B","text":"சத்துணவுத் திட்டம் (மதிய உணவுத் திட்டம் விரிவாக்கம்)"},{"key":"C","text":"விலையில்லாச் சீருடை"},{"key":"D","text":"இலவசப் பேருந்து அட்டை"}],"explanation":"குழந்தைகள் பள்ளியில் கல்வி கற்கத் தொடர வேண்டும் என்பதற்காக எம்.ஜி.ஆர் சத்துணவுத் திட்டத்தை விரிவுபடுத்தினார்."}}}
{"id":"b-tam-8t6-006","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 119"},"texts":{"ta":{"blocks":[{"type":"text","text":"எம்.ஜி.ஆர் அவர்களின் முயற்சியால் தமிழ்நாட்டில் தொடங்கப்பட்ட பிரத்யேகப் பல்கலைக்கழகம் எது?"}],"options":[{"key":"A","text":"அண்ணா பல்கலைக்கழகம்"},{"key":"B","text":"தமிழ்ப் பல்கலைக்கழகம் (தஞ்சாவூர்)"},{"key":"C","text":"மதுரை காமராசர் பல்கலைக்கழகம்"},{"key":"D","text":"மத்தியப் பல்கலைக்கழகம்"}],"explanation":"தமிழின் உயர் ஆய்வுக்காகத் தஞ்சையில் தமிழ்ப் பல்கலைக்கழகத்தை எம்.ஜி.ஆர் உருவாக்கினார்."}}}
{"id":"pyq-tam-8t6-007","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":48},"texts":{"ta":{"blocks":[{"type":"text","text":"ஏழை எளியோரின் வாழ்வை உயர்த்தியதற்காக இந்தியாவின் உயரிய விருதான ‘பாரத ரத்னா’ விருது எம்.ஜி.ஆர் அவர்களுக்கு வழங்கப்பட்ட ஆண்டு எது?"}],"options":[{"key":"A","text":"1985"},{"key":"B","text":"1988"},{"key":"C","text":"1990"},{"key":"D","text":"1995"}],"explanation":"எம்.ஜி.ஆர் அவர்களின் மக்கள் சேவையைப் போற்றும் வகையில் 1988-ஆம் ஆண்டு இந்தியாவின் உயரிய விருதான பாரத ரத்னா வழங்கப்பட்டது."}}}
{"id":"b-tam-8t6-016","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 118"},"texts":{"ta":{"blocks":[{"type":"text","text":"எம்.ஜி.ஆர் அவர்களின் சினிமாப் பெயராகவும் அரசியலில் புகழ்பெற்ற அடையாளமாகவும் விளங்கிய சொல் எது?"}],"options":[{"key":"A","text":"புரட்சித் தலைவர்"},{"key":"B","text":"பொன்மனச் செம்மல் / புரட்சி நடிகர்"},{"key":"C","text":"மக்கள் திலகம்"},{"key":"D","text":"அறிவு ஆசான்"}],"explanation":"மக்கள் திலகம் என்றும் புரட்சி நடிகர் என்றும் எம்.ஜி.ஆர் அன்போடு அழைக்கப்பட்டார்."}}}
{"id":"b-tam-8t6-023","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 117"},"texts":{"ta":{"blocks":[{"type":"text","text":"எம்.ஜி.ஆர் அவர்களின் திரைத்துறையில் முதல் படமான ‘சதிலீலாவதி’ வெளியான ஆண்டு மற்றும் கதாநாயகன் யார்?"}],"options":[{"key":"A","text":"1935 - என்.எஸ். கிருஷ்ணன்"},{"key":"B","text":"1936 - எம்.ஜி.ஆர் (சதிலீலாவதி படத்தில் அறிமுகம்)"},{"key":"C","text":"1940 - சிவா கணேசன்"},{"key":"D","text":"1950 - பி.யு. சின்னப்பா"}],"explanation":"எம்.ஜி.ஆர் திரைப்படங்களில் சிறு வேடங்களில் நடித்துப் பின்னர் 1936-இல் வெளியான 'சதிலீலாவதி' மூலம் பரவலாக அறியப்பட்டார்."}}}
{"id":"b-tam-8t6-024","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 119"},"texts":{"ta":{"blocks":[{"type":"text","text":"எம்.ஜி.ஆர் அவர்களின் கல்விப் பணியை நினைவுபடுத்தும் வகையில் சென்னையில் எந்த அமைப்பின் பெயரில் மையம் உள்ளது?"}],"options":[{"key":"A","text":"எம்.ஜி.ஆர் மருத்துவப் பல்கலைக்கழகம்"},{"key":"B","text":"டாக்டர் எம்.ஜி.ஆர். மருத்துவப் பல்கலைக்கழகம் மற்றும் அரசுத் திரைப்படக் கல்லூரி"},{"key":"C","text":"அறிவியல் கழகம்"},{"key":"D","text":"தொழில்நுட்பப் பூங்கா"}],"explanation":"மருத்துவக் கல்வி மற்றும் கலைத்துறை வளர்ச்சிக்கு எம்.ஜி.ஆர் செய்த தொண்டு மகத்தானது."}}}
{"id":"b-tam-8t6-033","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 118"},"texts":{"ta":{"blocks":[{"type":"text","text":"எம்.ஜி.ஆர் அவர்கள் தன் திரைப்படங்கள் மூலமாக எத்தகைய கருத்துகளை மக்களிடம் பரப்பினார்?"}],"options":[{"key":"A","text":"போர்க் கருத்துகளை"},{"key":"B","text":"ஏழைகளின் முன்னேற்றம், சமூக நீதி, பகுத்தறிவு மற்றும் மனிதநேயம்"},{"key":"C","text":"அரசியல் வன்முறையை"},{"key":"D","text":"வரலாற்றுப் புனைகதைகளை"}],"explanation":"சமூக சீர்திருத்தக் கருத்துகளையும் ஏழைகளின் வாழ்வையும் தனது பாடல்கள் மற்றும் படங்கள் மூலம் விதைத்தார்."}}}
{"id":"b-tam-8t6-034","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 120"},"texts":{"ta":{"blocks":[{"type":"text","text":"எம்.ஜி.ஆர் அவர்களின் திரையுலகப் பயணம் எத்தகைய சாதனைகளைக் கொண்டது?"}],"options":[{"key":"A","text":"குறுகிய கால சாதனை"},{"key":"B","text":"ஐந்து பத்தாண்டுகளுக்கும் மேலான சாதனைப் பயணம்"},{"key":"C","text":"நாடகத் துறை மட்டுமே"},{"key":"D","text":"இயக்குநர் பணி மட்டும்"}],"explanation":"ஐந்து பத்தாண்டுகளுக்குும் மேலாகத் தமிழ் சினிமாவில் முன்னணி நடிகராகவும் மக்கள் தலைவராகவும் கொடிகட்டிப் பறந்தார்."}}}
{"id":"b-tam-8t6-040","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 121"},"texts":{"ta":{"blocks":[{"type":"text","text":"எம்.ஜி.ஆர் அவர்களின் ஆட்சிக் காலத்தில் தமிழ்நாட்டில் எந்த இயக்கம் மூலம் ஏழை மாணவர்களுக்குப் பயன் கிட்டியது?"}],"options":[{"key":"A","text":"மதிய உணவு / சத்துணவு இயக்கம்"},{"key":"B","text":"சத்துணவுத் திட்டம் மற்றும் ஏழை எளியோருக்கான நலத்திட்டங்கள்"},{"key":"C","text":"இலவசக் கணினித் திட்டம்"},{"key":"D","text":"பால்கடினத் திட்டம்"}],"explanation":"சத்துணவுத் திட்டம் தமிழகத்தில் குழந்தைகளின் ஊட்டச்சட்டப் பாதுகாப்பிற்கு வழிவகுத்தது."}}}
{"id":"b-tam-8t6-041","kind":"assertion_reason","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 117"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"எம்.ஜி.ஆர் அவர்கள் மக்கள் திலகம் எனப் போற்றப்பட்டார்."},{"type":"reason","text":"அவர் திரைப்படங்கள் வாயிலாகவும் அரசியல் ரீதியாகவும் ஏழை எளிய மக்களின் நலனுக்காகவும் கல்வி வளர்ச்சிக்காகவும் தன் வாழ்நாள் முழுவதும் உழைத்தார்."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"எம்.ஜி.ஆர் மக்களின் தலைவர் என்பதால் மக்கள் திலகம் என அழைக்கப்பட்டார்; கூற்றும் காரணமும் சரி."}}}
{"id":"b-tam-8t6-044","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 119"},"texts":{"ta":{"blocks":[{"type":"text","text":"எம்.ஜி.ஆர் அவர்களின் நடிப்பில் வெளிவந்து மிகப்பெரிய வெற்றி பெற்ற, ஏழைகளின் வாழ்வைச் சொன்ன திரைப்படம் எது?"}],"options":[{"key":"A","text":"மஞ்சமலை"},{"key":"B","text":"மலைக்கள்ளன் / நாடோடி மன்னன்"},{"key":"C","text":"சந்திரலேகா"},{"key":"D","text":"சிவகங்கை சீமை"}],"explanation":"மலைக்கள்ளன், நாடோடி மன்னன் உள்ளிட்ட பல படங்கள் மக்கள் மத்தியில் பெரும் வரவேற்பைப் பெற்றன."}}}
{"id":"b-tam-8t6-048","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 118"},"texts":{"ta":{"blocks":[{"type":"text","text":"எம்.ஜி.ஆர் அவர்களின் தலைமையிலான அரசு தமிழகத்தில் எப்போது இலவசக் கல்வி மற்றும் மதிய உணவுத் திட்டத்தை வலுப்படுத்தியது?"}],"options":[{"key":"A","text":"1950களில்"},{"key":"B","text":"1980களில் (முதல்வரகப் பதவி வகித்த காலத்தில்)"},{"key":"C","text":"1970களில்"},{"key":"D","text":"1990களில்"}],"explanation":"முதல்வராக இருந்த காலத்தில் கல்வி மற்றும் ஊட்டச்சத்துத் திட்டங்களுக்கு எம்.ஜி.ஆர் முக்கியத்துவம் அளித்தார்."}}}

// ==============================================================================
// பாடம் 3: ஒருவன் இருக்கிறான் (விரிவானம் / துணைப்பாடம் - கு. அழகிரிசாமி) [4 வினாக்கள்: Q008, Q017, Q025, Q035]
// ஒருவன் இருக்கிறான் சிறுகதை - கு. அழகிரிசாமி,
// கரிசல் இலக்கிய முன்னோடி, எளிய மக்களின் துன்பமும் சக மனிதநேயமும்,
// பசியால் வாடும் எளிய உழைப்பாளி மக்களுக்குத் தன் உணவைப் பகிர்ந்து உதவும் கருணை உள்ளம்
// ==============================================================================
{"id":"b-tam-8t6-008","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 122"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஒருவன் இருக்கிறான்’ என்னும் சிறுகதையின் ஆசிரியர் யார்?"}],"options":[{"key":"A","text":"ஜெயகாந்தன்"},{"key":"B","text":"கு. அழகிரிசாமி"},{"key":"C","text":"கந்தர்வன்"},{"key":"D","text":"மேலாண்மை பொன்னுச்சாமி"}],"explanation":"மனிதநேயத்தை விளக்கும் 'ஒருவன் இருக்கிறான்' என்னும் சிறுகதையை எழுதியவர் கு. அழகிரிசாமி ஆவார்."}}}
{"id":"b-tam-8t6-017","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 122"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஒருவன் இருக்கிறான்’ கதையில் தொழிலாளர்களின் பசியைப் போக்க உதவிய மனிதநேயமிக்க பாத்திரம் எது?"}],"options":[{"key":"A","text":"வேலுச்சாமி"},{"key":"B","text":"படியளக்கும் கடவுளான எளிய மனிதர் / சக தொழிலாளி"},{"key":"C","text":"முதலாளி"},{"key":"D","text":"காவல் ஆய்வாளர்"}],"explanation":"துன்பத்திலும் சக மனிதனுக்கு உதவும் உயர்ந்த மனிதநேயம் இக்கதையில் விவரிக்கப்பட்டுள்ளது."}}}
{"id":"b-tam-8t6-025","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 122"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஒருவன் இருக்கிறான்’ கதையில் தொழிலாளர்களின் அவல நிலையை மாற்றும் கருணை உள்ளம் கொண்டவராகச் சித்தரிக்கப்படுபவர் யார்?"}],"options":[{"key":"A","text":"பெரியவர்"},{"key":"B","text":"சக தொழிலாளி / எளிய மனிதர்"},{"key":"C","text":"அதிகாரி"},{"key":"D","text":"மருத்துவர்"}],"explanation":"பசியால் வாடும் சக மனிதனுக்குத் தன் படியிலிருந்து உணவு வழங்கும் மனிதநேயத்தை இக்கதை பேசுகிறது."}}}
{"id":"b-tam-8t6-035","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 123"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஒருவன் இருக்கிறான்’ கதையில் தொழிலாளர்கள் படும் துயரங்களைக் கண்டு மனம் உருகும் நிகழ்வு எங்கு நடைபெறுகிறது?"}],"options":[{"key":"A","text":"அரண்மனையில்"},{"key":"B","text":"தொழிற்சாலை / பணிபுரியும் சூழல்"},{"key":"C","text":"பள்ளிக்கூடத்தில்"},{"key":"D","text":"சந்தையில்"}],"explanation":"எளிய உழைப்பாளி மக்களின் அன்றாடப் பசியையும் வறுமையையும் கதை விவரிக்கிறது."}}}

// ==============================================================================
// பாடம் 4: இடைச்சொல் & உரிச்சொல் (கற்கண்டு - இலக்கணம்) [16 வினாக்கள்: Q009, Q010, Q011, Q012, Q013, Q018, Q019, Q020, Q026, Q027, Q028, Q036, Q037, Q042, Q045, Q050]
// இடைச்சொல் & உரிச்சொல் இலக்கணம் (தொல்காப்பியம் & நன்னூல்),
// இடைச்சொல்: பெயரையும் வினையையும் சார்ந்து இயங்குவது, தனித்து இயங்காதது (வேற்றுமை உருபுகள், தத்தம் பொருளன, வினா/சுட்டு, அளபெடை, வியங்கோள் விகுதிகள்),
// எ.கா: மன்னும் இமயம், தம்கேள்,
// உரிச்சொல்: பெயரையும் வினையையும் சார்ந்து அவற்றின் தன்மையை மிகுதிப்படுத்துவது ('உரிச்சொல் எல்லாமே பொருள் குறித்தனவே'),
// எ.கா: சால, தவ, நனி (மிகுதி - தவநூறு, நனிபேதை), கடிநகர் (காவல்/சிறப்பு)
// ==============================================================================
{"id":"b-tam-8t6-009","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 127"},"texts":{"ta":{"blocks":[{"type":"text","text":"பெயர்ச்சொல்லையும் வினைச்சொல்லையும் சார்ந்து வந்து பொருள் உணர்த்துவதுடன், தனித்து இயங்க முடியாத சொல் எது?"}],"options":[{"key":"A","text":"உரிச்சொல்"},{"key":"B","text":"இடைச்சொல் (எ.கா: மற்றும், ஐ, ஆல்)"},{"key":"C","text":"பகாப்பதம்"},{"key":"D","text":"வினையெச்சம்"}],"explanation":"பெயர்ச்சொல்லையும் வினைச்சொல்லையும் சார்ந்துவரும் சொல் இடைச்சொல் எனப்படும்."}}}
{"id":"b-tam-8t6-010","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 128"},"texts":{"ta":{"blocks":[{"type":"text","text":"இசைநிறைப்பதற்காகவும் அளபெடுப்பதற்காகவும் செய்யுளில் வரும் இடைச்சொல் எவ்வாறு அழைக்கப்படும்?"}],"options":[{"key":"A","text":"இயைபுச் சொல்"},{"key":"B","text":"அளபெடை இடைச்சொல் (எ.கா: தழீஇய)"},{"key":"C","text":"சுட்டு இடைச்சொல்"},{"key":"D","text":"வினா இடைச்சொல்"}],"explanation":"செய்யுளில் ஓசை குறையும்போது அதனை நிறைவு செய்ய வருவது அளபெடை இடைச்சொல் ஆகும்."}}}
{"id":"b-tam-8t6-011","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 129"},"texts":{"ta":{"blocks":[{"type":"text","text":"செய்தியின் தன்மையை ஐயமின்றி உணர்த்தும் வியங்கோள் வினைமுற்று இடைச்சொல் எது?"}],"options":[{"key":"A","text":"மன், கொல்"},{"key":"B","text":"கிய, இயர் (வியங்கோள் விகுதிகள்)"},{"key":"C","text":"ஏ, ஓ"},{"key":"D","text":"தான், மட்டும்"}],"explanation":"வியங்கோள் வினைமுற்று விகுதிகள் இடைச்சொல் வகையுள் அடங்கிச் செய்தியின் தன்மையை உணர்த்தும்."}}}
{"id":"b-tam-8t6-012","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 129"},"texts":{"ta":{"blocks":[{"type":"text","text":"பெயர்ச்சொல், வினைச்சொல் ஆகியவற்றின் தன்மையை மிகுதிப்படுத்த (உயர்த்தி அல்லது தாழ்த்தி) வருவது எது?"}],"options":[{"key":"A","text":"இடைச்சொல்"},{"key":"B","text":"உரிச்சொல் (எ.கா: மாநகர், கடிநநகர்)"},{"key":"C","text":"வினையெச்சம்"},{"key":"D","text":"பெயரெச்சம்"}],"explanation":"இசை, குறிப்பு, பண்பு எனப் பலபொருள்களில் வந்து பெயரையும் வினையையும் மிகுதிப்படுத்துவது உரிச்சொல் ஆகும்."}}}
{"id":"b-tam-8t6-013","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 130"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘சால, தவ, நனி’ என்னும் உரிச்சொற்கள் உணர்த்தும் பொதுவான பொருள் யாது?"}],"options":[{"key":"A","text":"சிறுமை"},{"key":"B","text":"மிகுதி (சாலப் பேசினான், தவப்பெரியது)"},{"key":"C","text":"அழகு"},{"key":"D","text":"விரைவு"}],"explanation":"சால, தவ, நனி என்பன மிகுதி என்னும் பொருளில் வரும் உரிச்சொற்கள் ஆகும்."}}}
{"id":"b-tam-8t6-018","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 127"},"texts":{"ta":{"blocks":[{"type":"text","text":"இடைச்சொற்கள் குறித்துத் தொல்காப்பியர் கூறும் இலக்கணக் கருத்து யாது?"}],"options":[{"key":"A","text":"தனித்து இயங்கும்"},{"key":"B","text":"இடைச்சொற்கள் பெயரையும் வினையையும் சார்ந்து இயங்கும் இயல்புடையன"},{"key":"C","text":"பொருளைத் தராது"},{"key":"D","text":"விகுதிகளை மட்டும் காட்டும்"}],"explanation":"இடைச்சொற்கள் தனித்து நின்று பொருள் தராமல் பெயரையும் வினையையும் சார்ந்து மட்டுமே இயங்கும்."}}}
{"id":"b-tam-8t6-019","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 129"},"texts":{"ta":{"blocks":[{"type":"text","text":"உரிச்சொற்கள் குறித்துத் தொல்காப்பியர் கூறும் இலக்கணம் யாது?"}],"options":[{"key":"A","text":"தனித்துப் பொருள் தரும்"},{"key":"B","text":"‘உரிச்சொல் எல்லாமே பொருள் குறித்தனவே’ (ஒவ்வொரு உரிச்சொல்லும் தனிப்பொருள் உடையது)"},{"key":"C","text":"வினைச் சொற்களை மட்டும் சார்ந்து வரும்"},{"key":"D","text":"இடைச்சொற்களின் விகாரமாகும்"}],"explanation":"உரிச்சொல் அனைத்தும் பொருள் குறித்தனவே எனத் தொல்காப்பியம் விளக்குகிறது."}}}
{"id":"b-tam-8t6-020","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 127"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மன்னும் இமயம்’ என்னும் தொடரில் வந்துள்ள ‘மன்னும்’ என்பது எவ்வகைச் சொல்?"}],"options":[{"key":"A","text":"இடைச்சொல்"},{"key":"B","text":"உரிச்சொல்"},{"key":"C","text":"பெயர்ச்சொல்"},{"key":"D","text":"வினைச்சொல்"}],"explanation":"நிலைபெற்ற என்னும் பொருளில் வரும் 'மன்' என்னும் இடைச்சொல் இங்கு வந்துள்ளது."}}}
{"id":"b-tam-8t6-026","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 127"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தம்கேள்’ என்பதில் வந்துள்ள இடைச்சொல் எவ்வகைச் சொல்லைச் சார்ந்தது?"}],"options":[{"key":"A","text":"வினைச்சொல்"},{"key":"B","text":"பெயர்ச்சொல்லைச் சார்ந்து வரும் இடைச்சொல்"},{"key":"C","text":"உரிச்சொல்"},{"key":"D","text":"இடைநிலை"}],"explanation":"தம்கேள் என்பதில் உள்ள அஃது என்பது பெயர்ச்சொல்லைச் சார்ந்துவரும் இடைச்சொல் ஆகும்."}}}
{"id":"b-tam-8t6-027","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 129"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘உரிச்சொல் தொடர்’ இலக்கணத்தின்படி ‘நூறு’ என்பதன் முன் ‘தவ’ வந்தால் என்ன பொருள்படும்?"}],"options":[{"key":"A","text":"குறைவு"},{"key":"B","text":"மிகுதி (தவநூறு - மிகநூறு)"},{"key":"C","text":"பழமை"},{"key":"D","text":"புதிது"}],"explanation":"தவ, நனி, சால என்பன மிகுதிப் பொருளைத் தரும் உரிச்சொற்கள் ஆகும்."}}}
{"id":"b-tam-8t6-028","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 130"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கடிநகர்’ என்னும் சொல்லில் வந்துள்ள ‘கடி’ என்னும் உரிச்சொல் குறிக்கும் பொருள் யாது?"}],"options":[{"key":"A","text":"பழமை"},{"key":"B","text":"காவல் / கூர்மை / புதுமை / அச்சம்"},{"key":"C","text":"மிகுதி"},{"key":"D","text":"சிறுமை"}],"explanation":"கடிநகர் என்பதில் கடி என்பது காவல் அல்லது சிறப்புப் பொருளைத் தரும் உரிச்சொல் ஆகும்."}}}
{"id":"b-tam-8t6-036","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 127"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ் இலக்கணத்தில் இடைச்சொற்கள் எத்தனை வகையாகப் பிரிக்கப்படுகின்றன?"}],"options":[{"key":"A","text":"இரண்டு வகை"},{"key":"B","text":"பல வகை (வேற்றுமை உருபுகள், தத்திசைகள், வினா, சுட்டு, விகுதிகள்)"},{"key":"C","text":"நான்கு வகை"},{"key":"D","text":"மூன்று வகை"}],"explanation":"இடைச்சொற்கள் வேற்றுமை உருபுகள், பகாப்பதங்கள், விகுதிகள் எனப் பல இலக்கணப் பணிகளைச் செய்கின்றன."}}}
{"id":"b-tam-8t6-037","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 130"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நனிபேதை’ என்னும் சொல்லில் வந்துள்ள ‘நனி’ என்னும் உரிச்சொல் குறிக்கும் பொருள் யாது?"}],"options":[{"key":"A","text":"சிறுமை"},{"key":"B","text":"மிகுதி (மிகப் பேதை)"},{"key":"C","text":"அழகு"},{"key":"D","text":"குறைவு"}],"explanation":"நனி என்னும் உரிச்சொல் மிகுதி என்னும் பொருளைத் தரும் (நனிபேதை = மிகப்பேதை)."}}}
{"id":"b-tam-8t6-042","kind":"assertion_reason","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 127"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"‘இடைச்சொல்’ என்பது தனித்து இயங்காமல் பெயரையும் வினையையும் சார்ந்து வரும் சொல்லாகும்."},{"type":"reason","text":"இடைச்சொற்கள் தமிழ் இலக்கணத்தில் வேற்றுமை உருபுகள், வினா மற்றும் சுட்டு எழுத்துகள் வடிவில் வெளிப்படுகின்றன."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"இடைச்சொல்லின் இலக்கணம் மற்றும் வடிவங்கள் இவைதாம்; கூற்றும் காரணமும் சரியானவையே."}}}
{"id":"b-tam-8t6-045","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 129"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘உரிச்சொல்’ குறித்த தொல்காப்பியரின் நூற்பா இலக்கணம் எதனை விளக்குகிறது?"}],"options":[{"key":"A","text":"செயல் முறைகளை"},{"key":"B","text":"செய்தியின் தன்மையும் பொருளின் செறிவையும் மிகுதிப்படுத்தும் சொற்கள்"},{"key":"C","text":"எழுத்துகளின் பிறப்பை"},{"key":"D","text":"கால வேறுபாட்டை"}],"explanation":"பெயரையும் வினையையும் சார்ந்து அவற்றின் தன்மையை மிகுதிப்படுத்துவது உரிச்சொல் ஆகும்."}}}
{"id":"b-tam-8t6-050","kind":"assertion_reason","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"assertion_reason","a_true":true,"r_true":true,"r_explains_a":true},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 129"},"texts":{"ta":{"blocks":[{"type":"assertion","text":"‘உரிச்சொல்’ என்பது பெயரையும் வினையையும் சார்ந்து அவற்றின் தன்மையை மிகுதிப்படுத்தும் சொல்லாகும்."},{"type":"reason","text":"உரிச்சொற்கள் தனித்து இயங்காமல் பெயரடை மற்றும் வினையடை போல வந்து பொருளுக்குச் செறிவூட்டும்."}],"options":[{"key":"A","text":"(A) மற்றும் (R) இரண்டும் சரி, மேலும் (R) என்பது (A) விற்கு சரியான விளக்கம்","semantic":"both_true_explains"},{"key":"B","text":"(A) மற்றும் (R) இரண்டும் சரி, ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கமல்ல","semantic":"both_true_not_explains"},{"key":"C","text":"(A) சரி ஆனால் (R) தவறு","semantic":"a_true_r_false"},{"key":"D","text":"(A) தவறு ஆனால் (R) சரி","semantic":"a_false_r_true"}],"explanation":"உரிச்சொல்லின் இலக்கணப் பயன்பாடு இதுவே; கூற்றும் காரணமும் முற்றிலும் சரியானவையே."}}}

// ==============================================================================
// பாடம் 5: சமூகவியல் கலைச்சொற்கள் (மொழியை ஆள்வோம்) [6 வினாக்கள்: Q014, Q029, Q030, Q038, Q047, Q049]
// சமூகவியல் கலைச்சொற்கள்:
// Philanthropy (அறக்கொடை / மனிதநேயம்),
// Empathy (அனுதாபம் / மைகாண்பு),
// Literacy (எழுத்தறிவு),
// Migration (இடபெயர்வு)
// ==============================================================================
{"id":"b-tam-8t6-014","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 131"},"texts":{"ta":{"blocks":[{"type":"text","text":"சமூகக் கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"},{"type":"list","name":"ஆங்கிலச் சொல்","items":[{"label":"A","text":"Philanthropy"},{"label":"B","text":"Empathy"},{"label":"C","text":"Literacy"},{"label":"D","text":"Migration"}]},{"type":"list","name":"தமிழாக்கம்","items":[{"label":"1","text":"அனுதாபம் / மைகாண்பு"},{"label":"2","text":"இடபெயர்வு"},{"label":"3","text":"அறக்கொடை / மனிதநேயம்"},{"label":"4","text":"எழுத்தறிவு"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-3, C-1, D-4","mapping":{"A":"2","B":"3","C":"1","D":"4"}}],"explanation":"Philanthropy = அறக்கொடை; Empathy = அனுதாபம்; Literacy = எழுத்தறிவு; Migration = இடபெயர்வு."}}}
{"id":"b-tam-8t6-029","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 131"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘Empathy’ என்னும் ஆங்கிலச் சொல்லுக்கான சரியான தமிழ்ச் சொல் எது?"}],"options":[{"key":"A","text":"அனுதாபம் / மைகாண்பு"},{"key":"B","text":"இரக்கம்"},{"key":"C","text":"அறக்கொடை"},{"key":"D","text":"மனிதநேயம்"}],"explanation":"Empathy என்பது அனுதாபம் / மைகாண்பு என அழைக்கப்படும்."}}}
{"id":"b-tam-8t6-030","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 131"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘Migration’ என்னும் ஆங்கிலச் சொல்லுக்குரிய தமிழ்ச் சொல் எது?"}],"options":[{"key":"A","text":"பயணம்"},{"key":"B","text":"இடபெயர்வு"},{"key":"C","text":"சுற்றுலா"},{"key":"D","text":"குடியேற்றம்"}],"explanation":"Migration என்றால் இடபெயர்வு என்று பொருள்."}}}
{"id":"b-tam-8t6-038","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 6, பக்கம் 131"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘Literacy’ என்னும் ஆங்கிலச் சொல்லுக்கான சரியான தமிழ்ச் சொல் எது?"}],"options":[{"key":"A","text":"கல்வி"},{"key":"B","text":"எழுத்தறிவு"},{"key":"C","text":"படித்தவர்"},{"key":"D","text":"அறிவு"}],"explanation":"Literacy என்பது எழுத்தறிவு எனப்படும்."}}}
