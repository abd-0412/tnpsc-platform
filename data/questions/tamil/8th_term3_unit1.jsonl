// ==============================================================================
// பாடம் 1: பாடறிந்து ஒழுகுதல் (கவிதைப்பேழை - கலித்தொகை / நல்லந்துவனார்) [Q001 - Q007, Q040, Q053]
// ஆற்றுதல் என்பது ஒன்று அலந்தவர்க்கு உதவுதல், கலித்தொகை (150 பாடல்கள், கலிப்பா),
// நெய்தற்கலி ஆசிரியர் நல்லந்துவனார் (PYQ 2022), சொல்லும் பொருளும் (அலந்தவர், கிளை, செறாஅமை, நோன்றல், போற்றார், பொறை),
// பொறை (பகைவரைப் பொறுத்தல்), புணர்ச்சி (பாடறிந்து: பாடு + அறிந்து, முறையெனப்படுவது)
// ==============================================================================
{"id":"b-tam-8t3-001","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 48"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘ஆற்றுதல் என்பது ஒன்று அலந்தவர்க்கு உதவுதல் போற்றுதல் என்பது புணர்ந்தாரைப் பிரியாமை...’ - என்னும் வரிகள் இடம்பெற்றுள்ள நூல் எது?"}],"options":[{"key":"A","text":"நற்றிணை"},{"key":"B","text":"கலித்தொகை"},{"key":"C","text":"புறநானூறு"},{"key":"D","text":"அகநானூறு"}],"explanation":"மனிதன் வளர்த்துக்கொள்ள வேண்டிய உயர்பண்புகளை விளக்கும் இப்பாடல் கலித்தொகை நூலிலிருந்து தரப்பட்டுள்ளது."}}}
{"id":"b-tam-8t3-002","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 48"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பாடறிந்து ஒழுகுதல்’ கலித்தொகைப் பாடலின் சொல்லும் பொருளையும் சரியாகப் பொருத்துக:"},{"type":"list","name":"சொல்","items":[{"label":"A","text":"அலந்தவர்"},{"label":"B","text":"கிளை"},{"label":"C","text":"செறாஅமை"},{"label":"D","text":"நோன்றல்"}]},{"type":"list","name":"பொருள்","items":[{"label":"1","text":"உறவினர்"},{"label":"2","text":"பொறுத்தல்"},{"label":"3","text":"வறியவர்"},{"label":"4","text":"வெறுக்காமை"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}}],"explanation":"அலந்தவர் = வறியவர்; கிளை = உறவினர்; செறாஅமை = வெறுக்காமை; பேதையார் = அறிவற்றவர்; நோன்றல் = பொறுத்தல்; மறாஅமை = மறுக்காமை; போற்றார் = பகைவர்; பொறை = பொறுமை."}}}
{"id":"b-tam-8t3-003","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 49"},"texts":{"ta":{"blocks":[{"type":"text","text":"எட்டுத்தொகை நூல்களுள் ஒன்றான ‘கலித்தொகை’ எத்தனை பாடல்களைக் கொண்டது?"}],"options":[{"key":"A","text":"400 பாடல்கள்"},{"key":"B","text":"150 பாடல்கள்"},{"key":"C","text":"500 பாடல்கள்"},{"key":"D","text":"120 பாடல்கள்"}],"explanation":"கலித்தொகை நூறு ஐம்பது (150) பாடல்களைக் கொண்டது; இது கலிப்பா என்னும் பாவகையால் ஆனது."}}}
{"id":"pyq-tam-8t3-004","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"C","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2022,"paper":"tamil","no":18},"texts":{"ta":{"blocks":[{"type":"text","text":"கலித்தொகையைத் தொகுத்த நல்லந்துவனார் சங்ககாலப் புலவர்களுள் எக்கலியைப் பாடுவதில் வல்லவர்?"}],"options":[{"key":"A","text":"குறிஞ்சிக்கலி"},{"key":"B","text":"முல்லைக்கலி"},{"key":"C","text":"நெய்தற்கலி"},{"key":"D","text":"பாலைக்கலி"}],"explanation":"கலித்தொகையைத் தொகுத்த நல்லந்துவனார் நெய்தற்கலிப் பாடல்களை இயற்றியவராவார்."}}}
{"id":"b-tam-8t3-005","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 49"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘நம்மைக் கொடுமைப்படுத்துபவர்களை (பகைவர்களை) நாம் என்ன செய்ய வேண்டும்’ என நல்லந்துவனார் கூறுகிறார்?"}],"options":[{"key":"A","text":"பொறுத்துக்கொள்ள வேண்டும் (பொறை)"},{"key":"B","text":"பழிவாங்க வேண்டும்"},{"key":"C","text":"புறக்கணிக்க வேண்டும்"},{"key":"D","text":"அடிமைப்படுத்த வேண்டும்"}],"explanation":"பொறை எனப்படுவது போற்றாரைப் (பகைவரைப்) பொறுத்தல் ஆகும்."}}}
{"id":"b-tam-8t3-006","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 49"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பாடறிந்து’ என்னும் சொல்லைப் பிரித்து எழுதக் கிடைப்பது யாது?"}],"options":[{"key":"A","text":"பாட் + அறிந்து"},{"key":"B","text":"பாடு + அறிந்து"},{"key":"C","text":"பா + அறிந்து"},{"key":"D","text":"பாட்டு + அறிந்து"}],"explanation":"பாடு + அறிந்து = 'உயிர்வரின் உக்குறள் மெய்விட்டோடும்' விதிப்படி உகரம் கெட்டு, ட் + அ = ட ஆகி 'பாடறிந்து' எனப் புணரும்."}}}
{"id":"b-tam-8t3-007","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 49"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘முறை + எனப்படுவது’ என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}],"options":[{"key":"A","text":"முறையப்படுவது"},{"key":"B","text":"முறையெனப்படுவது"},{"key":"C","text":"முறைஎனப்படுவது"},{"key":"D","text":"முறைப்படுவது"}],"explanation":"உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி ய் + எ = யெ ஆகி 'முறையெனப்படுவது' எனப் புணரும்."}}}
{"id":"b-tam-8t3-040","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 48"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘வறியவர்களுக்கு உதவி செய்தல்’ என்பது கலித்தொகைப் பாடலில் எவ்வாறு குறிப்பிடப்படுகிறது?"}],"options":[{"key":"A","text":"போற்றுதல்"},{"key":"B","text":"ஆற்றுதல்"},{"key":"C","text":"செறாஅமை"},{"key":"D","text":"நோன்றல்"}],"explanation":"கலித்தொகையின்படி 'ஆற்றுதல் என்பது ஒன்று அலந்தவர்க்கு உதவுதல்' ஆகும்."}}}
{"id":"b-tam-8t3-053","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 48"},"texts":{"ta":{"blocks":[{"type":"text","text":"வறியவர்களுக்கு உதவி செய்தல் என்பது கலித்தொகை பாடலில் எவ்வாறு குறிப்பிடப்படுகிறது?"}],"options":[{"key":"A","text":"போற்றுதல்"},{"key":"B","text":"ஆற்றுதல்"},{"key":"C","text":"செறாமை"},{"key":"D","text":"நோன்றல்"}],"explanation":"மதிப்பீட்டு வினா: கலித்தொகையின்படி 'ஆற்றுதல் என்பது ஒன்று அலந்தவர்க்கு உதவுதல்' ஆகும்."}}}

