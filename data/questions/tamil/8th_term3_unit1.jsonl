// பாடம் 6: மொழியை ஆள்வோம் - நிறுத்தக்குறிகள் & கலைச்சொற்கள் [Q037, Q038, Q048 - Q052, Q062]
// நிறுத்தக்குறிகள் பொருத்துக (, காற்புள்ளி, ; அரைப்புள்ளி, : முக்காற்புள்ளி, ? வினாக்குறி, ! வியப்புக்குறி, " " இரட்டை மேற்கோள்),
// நிறுத்தக்குறிகள் பயன்படும் இடங்கள் (தொகைச்சொல் விரிவு: முக்காற்புள்ளி, பல வாக்கியங்கள் தொடரும் இடம்: அரைப்புள்ளி, உணர்ச்சி: வியப்புக்குறி, நேர்கூற்று: இரட்டை மேற்கோள்),
// கலைச்சொற்கள் (Punctuation: நிறுத்துக்குறி, Translation: மொழிபெயர்ப்பு, Reform: சீர்திருத்தம், Talent: திறமை)
// ==============================================================================
{"id":"b-tam-8t3-037","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 63"},"texts":{"ta":{"blocks":[{"type":"text","text":"இலக்கண நிறுத்தக்குறிகளை அவற்றின் பெயரோடு சரியாகப் பொருத்துக:"},{"type":"list","name":"குறி","items":[{"label":"A","text":","},{"label":"B","text":";"},{"label":"C","text":":"},{"label":"D","text":"?"}]},{"type":"list","name":"பெயர்","items":[{"label":"1","text":"அரைப்புள்ளி"},{"label":"2","text":"வினாக்குறி"},{"label":"3","text":"காற்புள்ளி"},{"label":"4","text":"முக்காற்புள்ளி"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}}],"explanation":", = காற்புள்ளி; ; = அரைப்புள்ளி; : = முக்காற்புள்ளி; ? = வினாக்குறி; ! = வியப்புக்குறி; ' ' = ஒற்றை மேற்கோள்; \" \" = இரட்டை மேற்கோள்."}}}
{"id":"b-tam-8t3-038","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"3","C":"1"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 66"},"texts":{"ta":{"blocks":[{"type":"text","text":"கல்வி மற்றும் இலக்கணக் கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"},{"type":"list","name":"ஆங்கிலச் சொல்","items":[{"label":"A","text":"Punctuation"},{"label":"B","text":"Translation"},{"label":"C","text":"Reform"}]},{"type":"list","name":"தமிழாக்கம்","items":[{"label":"1","text":"சீர்திருத்தம்"},{"label":"2","text":"நிறுத்துக்குறி"},{"label":"3","text":"மொழிபெயர்ப்பு"}]}],"options":[{"key":"A","text":"A-2, B-3, C-1","mapping":{"A":"2","B":"3","C":"1"}},{"key":"B","text":"A-1, B-2, C-3","mapping":{"A":"1","B":"2","C":"3"}},{"key":"C","text":"A-2, B-1, C-3","mapping":{"A":"2","B":"1","C":"3"}},{"key":"D","text":"A-3, B-2, C-1","mapping":{"A":"3","B":"2","C":"1"}}],"explanation":"Punctuation = நிறுத்துக்குறி; Translation = மொழிபெயர்ப்பு; Reform = சீர்திருத்தம்; Talent = திறமை."}}}
{"id":"b-tam-8t3-048","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 63"},"texts":{"ta":{"blocks":[{"type":"text","text":"சிறு தலைப்பான தொகைச் சொல்லை விரித்துக் கூறும் இடத்தில் எந்த நிறுத்தக்குறி இடப்படும்?"}],"options":[{"key":"A","text":"காற்புள்ளி"},{"key":"B","text":"முக்காற்புள்ளி (:)"},{"key":"C","text":"அரைப்புள்ளி"},{"key":"D","text":"முற்றுப்புள்ளி"}],"explanation":"சிறு தலைப்பான தொகைச் சொல்லை விரித்துக் கூறும் இடத்தில் முக்காற்புள்ளி (:) பயன்படுத்தப்படும்."}}}
{"id":"b-tam-8t3-049","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 63"},"texts":{"ta":{"blocks":[{"type":"text","text":"ஒரே எழுவாயில் பல வாக்கியங்கள் தொடரும் இடத்தில் எந்த நிறுத்தக்குறி இடப்படும்?"}],"options":[{"key":"A","text":"காற்புள்ளி"},{"key":"B","text":"அரைப்புள்ளி (;)"},{"key":"C","text":"வினாக்குறி"},{"key":"D","text":"முற்றுப்புள்ளி"}],"explanation":"ஒரே எழுவாயில் பல வாக்கியங்கள் தொடரும் இடத்திலும் உடன்பாடு எதிர்மறைக் கருத்துகளைக் கூறும் இடத்திலும் அரைப்புள்ளி வரும்."}}}
{"id":"b-tam-8t3-050","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 64"},"texts":{"ta":{"blocks":[{"type":"text","text":"மகிழ்ச்சி, வியப்பு, அச்சம், அவலம் போன்ற உணர்ச்சிகளை வெளிப்படுத்தும் குறியீடு எது?"}],"options":[{"key":"A","text":"வினாக்குறி"},{"key":"B","text":"வியப்புக்குறி (!)"},{"key":"C","text":"முக்காற்புள்ளி"},{"key":"D","text":"அரைப்புள்ளி"}],"explanation":"வியப்புக்குறி (!) மகிழ்ச்சி, வியப்பு, அச்சம், அவலம், இரங்கல் போன்ற உணர்ச்சிகளை வெளிப்படுத்தும்."}}}
{"id":"b-tam-8t3-051","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 64"},"texts":{"ta":{"blocks":[{"type":"text","text":"நேர்கூற்றுகளிலும் செய்யுள் அடிகளையும் குறிப்பிடும் இடத்திலும் பயன்படுத்தப்படும் குறி எது?"}],"options":[{"key":"A","text":"ஒற்றை மேற்கோள் குறி"},{"key":"B","text":"இரட்டை மேற்கோள் குறி (\" \")"},{"key":"C","text":"அடைப்புக்குறி"},{"key":"D","text":"காற்புள்ளி"}],"explanation":"நேர்கூற்றுகளிலும் பொன்மொழிகளைக் குறிப்பிடும் இடத்திலும் இரட்டை மேற்கோள் குறி பயன்படுத்தப்படும்."}}}
{"id":"b-tam-8t3-052","kind":"match","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"2","B":"1","C":"4","D":"3"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 66"},"texts":{"ta":{"blocks":[{"type":"text","text":"கலைச்சொற்களைச் சரியான தமிழாக்கத்தோடு பொருத்துக:"},{"type":"list","name":"ஆங்கிலச் சொல்","items":[{"label":"A","text":"Punctuation"},{"label":"B","text":"Translation"},{"label":"C","text":"Talent"},{"label":"D","text":"Reform"}]},{"type":"list","name":"தமிழாக்கம்","items":[{"label":"1","text":"மொழிபெயர்ப்பு"},{"label":"2","text":"நிறுத்துக்குறி"},{"label":"3","text":"சீர்திருத்தம்"},{"label":"4","text":"திறமை"}]}],"options":[{"key":"A","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-2, B-3, C-4, D-1","mapping":{"A":"2","B":"3","C":"4","D":"1"}},{"key":"D","text":"A-4, B-2, C-1, D-3","mapping":{"A":"4","B":"2","C":"1","D":"3"}}],"explanation":"Punctuation = நிறுத்துக்குறி; Translation = மொழிபெயர்ப்பு; Talent = திறமை; Reform = சீர்திருத்தம்."}}}
{"id":"b-tam-8t3-062","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 64"},"texts":{"ta":{"blocks":[{"type":"text","text":"மகிழ்ச்சி, வியப்பு, அச்சம், அவலம் போன்ற உணர்ச்சிகளை வெளிப்படுத்தும் குறியீடு எது?"}],"options":[{"key":"A","text":"வினாக்குறி"},{"key":"B","text":"வியப்புக்குறி (!)"},{"key":"C","text":"முக்காற்புள்ளி"},{"key":"D","text":"அரைப்புள்ளி"}],"explanation":"வியப்புக்குறி (!) மகிழ்ச்சி, வியப்பு, அச்சம், அவலம், இரங்கல் போன்ற உணர்ச்சிகளை வெளிப்படுத்தும்."}}}
