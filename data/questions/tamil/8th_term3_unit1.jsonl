// பாடம் 3: பல்துறைக் கல்வி (உரைநடை உலகம் - திரு.வி. கல்யாணசுந்தரனார்) [Q014 - Q023, Q042 - Q044, Q055, Q056]
// தமிழ்த்தென்றல் திரு.வி.க. ('இளமை விருந்து'), இளமையில் கல் (அறிவோம்பல்), ஐ.நா. முதல் பெண் தலைவர் விஜயலட்சுமி பண்டிட் பொன்மொழி,
// தமிழ்க்காப்பியக் கருவூலங்கள் சிறப்புகள் (இயற்கை ஓவியம்: பத்துப்பாட்டு, இயற்கை இன்பக்கலம்: கலித்தொகை, இயற்கை வாழ்வில்லம்: திருக்குறள்,
// இயற்கை அன்பு: பெரியபுராணம், இயற்கைத் தவம்: சிந்தாமணி, இயற்கைப் பரிணாமம்: கம்பராமாயணம்),
// கவிஞர் குலோத்துங்கன் கல்விப் பாடல், திரு.வி.க. நூல்கள் (PYQ 2019), புற உலக ஆராய்ச்சிக்கு அறிவியல் கொழுகொம்பு
// ==============================================================================
{"id":"b-tam-8t3-014","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 52"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பல்துறைக் கல்வி’ என்னும் உரைநடைப் பகுதியின் ஆசிரியர் யார்?"}],"options":[{"key":"A","text":"தந்தை பெரியார்"},{"key":"B","text":"திரு.வி. கல்யாணசுந்தரனார் (திரு.வி.க.)"},{"key":"C","text":"பாரதியார்"},{"key":"D","text":"மறைமலையடிகள்"}],"explanation":"தமிழ்த்தென்றல் என்று போற்றப்படும் திரு.வி.க. அவர்களின் 'இளமை விருந்து' நூலிலிருந்து இக்கட்டுரை தரப்பட்டுள்ளது."}}}
{"id":"b-tam-8t3-015","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 52"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘இளமையில் கல்’ என்னும் முதுமொழிக்கு ஏற்பக் கல்விப் பயிற்சிக்குரிய பருவம் எது?"}],"options":[{"key":"A","text":"முதுமை"},{"key":"B","text":"இளமை"},{"key":"C","text":"இளைஞர் பருவம்"},{"key":"D","text":"வாழ்நாள் முழுவதும்"}],"explanation":"அறிவோம்பலுக்குக் கல்வி தேவை; அக்கல்விப் பயிற்சிக்குரிய பருவம் இளமையாகும்."}}}
{"id":"b-tam-8t3-016","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 52"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘கல்வி என்பது வருவாய் ஈட்டும் வழிமுறை மட்டும் அன்று; அது மெய்ம்மையைத் தேடவும் அறநெறியைப் பயிலவும் பயிற்சியளிக்கும் நெறிமுறையாகும்’ எனக் கூறிய ஐ.நா. அவையின் முதல் பெண் தலைவர் யார்?"}],"options":[{"key":"A","text":"சரோஜினி நாயுடு"},{"key":"B","text":"விஜயலட்சுமி பண்டிட்"},{"key":"C","text":"இந்திரா காந்தி"},{"key":"D","text":"அன்னி பெசன்ட்"}],"explanation":"ஐ.நா. அவையின் முதல் பெண் தலைவரான விஜயலட்சுமி பண்டிட் கல்வியின் மேன்மையை இவ்வாறு குறிப்பிட்டுள்ளார்."}}}
{"id":"b-tam-8t3-017","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"1","C":"4","D":"2"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 53"},"texts":{"ta":{"blocks":[{"type":"text","text":"தமிழ்க் காப்பியத் தமிழ்க் கருவூலங்களை அவற்றின் சிறப்புகளோடு சரியாகப் பொருத்துக:"},{"type":"list","name":"கருவூலம்","items":[{"label":"A","text":"பத்துப்பாட்டு"},{"label":"B","text":"கலித்தொகை"},{"label":"C","text":"திருக்குறள்"},{"label":"D","text":"பெரியபுராணம்"}]},{"type":"list","name":"சிறப்புப் பெயர்","items":[{"label":"1","text":"இயற்கை இன்பக்கலம்"},{"label":"2","text":"இயற்கை அன்பு"},{"label":"3","text":"இயற்கை ஓவியம்"},{"label":"4","text":"இயற்கை வாழ்வில்லம்"}]}],"options":[{"key":"A","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"D","text":"A-2, B-1, C-4, D-3","mapping":{"A":"2","B":"1","C":"4","D":"3"}}],"explanation":"பத்துப்பாட்டு = இயற்கை ஓவியம்; கலித்தொகை = இயற்கை இன்பக்கலம்; திருக்குறள் = இயற்கை வாழ்வில்லம்; பெரியபுராணம் = இயற்கை அன்பு; கம்பராமாயணம் = இயற்கைப் பரிணாமம்."}}}
{"id":"b-tam-8t3-018","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 54"},"texts":{"ta":{"blocks":[{"type":"text","text":"“ஏடன்று கல்வி; சிலர் எழுதும் பேசும் இயலன்று கல்வி; பலர்க் கெட்டா தென்னும் வீடன்று கல்வி...” என்று பாடிய கவிஞர் யார்?"}],"options":[{"key":"A","text":"பாரதிதாசன்"},{"key":"B","text":"குலோத்துங்கன்"},{"key":"C","text":"வாணிதாசன்"},{"key":"D","text":"முடியரசன்"}],"explanation":"கல்வியின் உண்மையான பரிமாணத்தைக் கூறும் வரிகளை எழுதியவர் கவிஞர் குலோத்துங்கன் ஆவார்."}}}
{"id":"pyq-tam-8t3-019","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"past_paper","exam":"g4","year":2019,"paper":"tamil","no":37},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தமிழ்த்தென்றல்’ என்று போற்றப்படும் திரு.வி. கல்யாணசுந்தரனார் இயற்றிய நூல்களில் பொருந்தாத ஒன்று எது?"}],"options":[{"key":"A","text":"பெண்ணின் பெருமை, தமிழ்ச்சோலை"},{"key":"B","text":"தமிழ் இயக்கம்"},{"key":"C","text":"பொதுமை வேட்டல், முருகன் அல்லது அழகு"},{"key":"D","text":"மனித வாழ்க்கையும் காந்தியடிகளும்"}],"explanation":"'தமிழ் இயக்கம்' என்பது பாரதிதாசனின் நூலாகும்; மற்றவை திரு.வி.க.வின் புகழ்பெற்ற நூல்களாகும்."}}}
{"id":"b-tam-8t3-020","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 55"},"texts":{"ta":{"blocks":[{"type":"text","text":"அறியாமையை நீக்கி அறிவை விளக்குவது ________ ஆகும்."}],"options":[{"key":"A","text":"கல்வி"},{"key":"B","text":"விளக்கு"},{"key":"C","text":"விளையாட்டு"},{"key":"D","text":"பாட்டு"}],"explanation":"மதிப்பீட்டு வினா: அறியாமையைப் போக்கி அறிவொளி தருவது கல்வி ஆகும்."}}}
{"id":"b-tam-8t3-021","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"A","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 55"},"texts":{"ta":{"blocks":[{"type":"text","text":"கல்விப் பயிற்சிக்குரிய பருவம் ________ ஆகும்."}],"options":[{"key":"A","text":"இளமை"},{"key":"B","text":"முதுமை"},{"key":"C","text":"இளைஞர் பருவம்"},{"key":"D","text":"வாழ்நாள் முழுவதும்"}],"explanation":"மதிப்பீட்டு வினா: கல்வி பயில ஏற்றது இளமைப் பருவமாகும்."}}}
{"id":"b-tam-8t3-022","kind":"direct","unit_id":"ta-grammar","level":"SSLC","correct_key":"D","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 55"},"texts":{"ta":{"blocks":[{"type":"text","text":"இன்றைய கல்வி ________ நுழைவதற்குக் கருவியாகக் கொள்ளப்பட்டு வருகிறது."}],"options":[{"key":"A","text":"வீட்டில்"},{"key":"B","text":"நாட்டில்"},{"key":"C","text":"பள்ளியில்"},{"key":"D","text":"தொழிலில்"}],"explanation":"மதிப்பீட்டு வினா: பட்டங்கள் பெற்றுத் தொழிலில் நுழைவதற்குக் கருவியாக மட்டுமே கல்வி மாற்றப்பட்டுள்ளது எனத் திரு.வி.க. கவலைப்படுகிறார்."}}}
{"id":"b-tam-8t3-023","kind":"match","unit_id":"ta-literature","level":"SSLC","correct_key":"A","structure":{"kind":"match","pairs":{"A":"3","B":"4","C":"1","D":"2"}},"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 55"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘பல்துறைக் கல்வி’ மதிப்பீட்டுப் பொருத்துகளை இணைக்க:"},{"type":"list","name":"இலக்கியம்","items":[{"label":"A","text":"இயற்கை ஓவியம்"},{"label":"B","text":"இயற்கைத் தவம்"},{"label":"C","text":"இயற்கைப் பரிணாமம்"},{"label":"D","text":"இயற்கை அன்பு"}]},{"type":"list","name":"நூல்","items":[{"label":"1","text":"கம்பராமாயணம்"},{"label":"2","text":"பெரியபுராணம்"},{"label":"3","text":"பத்துப்பாட்டு"},{"label":"4","text":"சிந்தாமணி"}]}],"options":[{"key":"A","text":"A-3, B-4, C-1, D-2","mapping":{"A":"3","B":"4","C":"1","D":"2"}},{"key":"B","text":"A-1, B-2, C-3, D-4","mapping":{"A":"1","B":"2","C":"3","D":"4"}},{"key":"C","text":"A-3, B-1, C-4, D-2","mapping":{"A":"3","B":"1","C":"4","D":"2"}},{"key":"D","text":"A-2, B-3, C-1, D-4","mapping":{"A":"2","B":"3","C":"1","D":"4"}}],"explanation":"இயற்கை ஓவியம் = பத்துப்பாட்டு; இயற்கைத் தவம் = சிந்தாமணி; இயற்கைப் பரிணாமம் = கம்பராமாயணம்; இயற்கை அன்பு = பெரியபுராணம்."}}}
{"id":"b-tam-8t3-042","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 52"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘மனிதர்களின் வாழ்வில் உடலோம்பலுடன் அறிவோம்பலும் நிகழ்ந்து வரல் வேண்டும்’ எனக் கூறிய கல்விச் சீர்திருத்தவாதி யார்?"}],"options":[{"key":"A","text":"தந்தை பெரியார்"},{"key":"B","text":"திரு.வி. கல்யாணசுந்தரனார்"},{"key":"C","text":"பாரதியார்"},{"key":"D","text":"வ.உ.சி."}],"explanation":"பல்துறைக் கல்வி கட்டுரையில் திரு.வி.க. அறிவோம்பலின் தேவையை வலியுறுத்துகிறார்."}}}
{"id":"b-tam-8t3-043","kind":"direct","unit_id":"ta-literature","level":"SSLC","correct_key":"B","is_negative":false,"source":{"type":"book","ref":"8-ஆம் வகுப்பு தமிழ், இயல் 3, பக்கம் 54"},"texts":{"ta":{"blocks":[{"type":"text","text":"‘தமிழ்த்தென்றல்’ என்று போற்றப்படும் திரு.வி.க. அவர்களின் எந்த நூலிலிருந்து ‘பல்துறைக் கல்வி’ பகுதி தொகுக்கப்பட்டுள்ளது?"}],"options":[{"key":"A","text":"பெண்ணின் பெருமை"},{"key":"B","text":"இளமை விருந்து"},{"key":"C","text":"பொதுமை வேட்டல்"},{"key":"D","text":"தமிழ்ச்சோலை"}],"explanation":"திரு.வி.க. எழுதிய 'இளமை விருந்து' நூலிலிருந்து பல்துறைக் கல்வி கட்டுரை எடுக்கப்பட்டுள்ளது."}}}
