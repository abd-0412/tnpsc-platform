{"id": "11th_tamil_rev1_q113", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_supp_grammar", "chapter_id": null, "topic_id": "vadivasal_author_chellappa", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜல்லிக்கட்டு (ஏறுதழுவுதல்) விளையாட்டின் வீரத்தையும் மனித-மிருக உளவியல் போராட்டத்தையும் சித்திரிக்கும் 'வாடிவாசல்' குறுநாவலின் ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "சி. சு. செல்லப்பா", "B": "கி. ராஜநாராயணன்", "C": "தி. ஜானகிராமன்", "D": "சுந்தர ராமசாமி"}, "explanation": "'வாடிவாசல்' குறுநாவலை எழுதியவர் எழுத்தாளரும் 'எழுத்து' இதழின் நிறுவனருமான சி. சு. செல்லப்பா ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the celebrated Jallikattu novella 'Vaadivaasal' capturing the intense psychological duel between man and ferocious bull?", "media_id": null}], "options": {"A": "C. S. Chellappa", "B": "Ki. Rajanarayanan", "C": "Thi. Janakiraman", "D": "Sundara Ramaswamy"}, "explanation": "C. S. Chellappa authored the iconic Tamil novella 'Vaadivaasal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 64, "chapter": null, "section": null, "r