{"id": "11th_tamil_rev1_q086", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "seerapuranam_patron_seethakkathi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உமறுப்புலவரை ஆதரித்துச் சீறாப்பூராணத்தை இயற்றத் தூண்டிய பெருவள்ளல் யார்?", "media_id": null}], "options": {"A": "சடையப்ப வள்ளல்", "B": "வள்ளல் சீதக்காதி (மற்றும் அபுல்காசிம் மரைக்காயர்)", "C": "சந்திரன் சுவர்க்கி", "D": "பாரி வள்ளல்"}, "explanation": "காயல்பட்டினம் வள்ளல் சீதக்காதி உமறுப்புலவரை ஆதரித்தார்; அவர் மறைந்த பின் அபுல்காசிம் மரைக்காயர் ஆதரவுடன் காப்பியம் நிறைவுபெற்றது."}, "en": {"blocks": [{"type": "text", "content": "Which illustrious philanthropist patronized Umaru Pulavar and sponsored the composition of Seerapuranam?", "media_id": null}], "options": {"A": "Sadaiyappa Vallal", "B": "Vallal Seethakkathi (and Abul Kasim Marakkayar)", "C": "Chandran Suvarkki", "D": "Paari Vallal"}, "explanation": "Philanthropist Seethakkathi, and subsequently Abul Kasim Marakkayar, supported the creation of Seerapuranam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025