{"id": "11th_tamil_rev1_q009", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "indiran_translation_award", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் இந்திரன் ஒரிய மொழிக் கவிஞர் மனோரமா பிஸ்வாசின் எந்த நூலைத் தமிழில் 'பறவைகள் ஒருவேளை தூங்கிப் போயிருக்கலாம்' என்று மொழிபெயர்த்துச் சாகித்திய அகாதெமி விருது பெற்றார்?", "media_id": null}], "options": {"A": "பறவைகள் ஒருவேளை தூங்கிப் போயிருக்கலாம் (2011)", "B": "மழைக்காலக் கவிதைகள்", "C": "நள்ளிரவுப் பறவை", "D": "சூரியப் பறவை"}, "explanation": "2011-ஆம் ஆண்டு கவிஞர் இந்திரன் மனோரமா பிஸ்வாசின் ஒரியக் கவிதைகளைத் தமிழில் மொழிபெயர்த்தமைக்காகச் சாகித்திய அகாதெமி விருது பெற்றார்."}, "en": {"blocks": [{"type": "text", "content": "For translating which Odia poetry collection by Manorama Biswas did poet Indiran win the Sahitya Akademi Translation Prize in 2011?", "media_id": null}], "options": {"A": "Paravaigal Oruvealai Thoongip Poyirukkalaam (2011)", "B": "Mazhaikkaalak Kavithaigal", "C": "Nalliravup Paravai", "D": "Sooriyap Paravai"}, "explanation": "Indiran won the Sahitya Akademi award for translating 'Paravaigal Oruvealai Thoongip Poyirukkalaam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher