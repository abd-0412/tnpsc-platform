{"id": "11th_tamil_rev1_q188", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_pyq_model", "chapter_id": null, "topic_id": "pyq_chellappa_manikkodi_movement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] சி. சு. செல்லப்பா அவர்களால் 1959-ல் தொடங்கப்பட்ட 'எழுத்து' இதழில் அறிமுகமாகிப் பின்னர் தலைசிறந்த நவீனக் கவிஞர்களாகத் திகழ்ந்தவர்களுள் பொருந்தாத ஒருவர் யார்?", "media_id": null}], "options": {"A": "சி. மணி", "B": "நகுலன்", "C": "தருமு சிவராமு (பிரமிள்)", "D": "காளமேகப் புலவர்"}, "explanation": "'எழுத்து' இதழ் நவீனப் புதுக்கவிஞர்களான சி. மணி, நகுலன், பிரமிள், சுந்தர ராமசாமி உள்ளிட்டோருக்குக் களம் அமைத்தது; காளமேகப் புலவர் 15-ஆம் நூற்றாண்டுச் செவ்வியல் புலவர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Who among the following was NOT associated with C. S. Chellappa's modern poetry vanguard journal 'Ezhuthu'?", "media_id": null}], "options": {"A": "C. Mani", "B": "Nakulan", "C": "Dharmu Sivaramu (Pramil)", "D": "Kalamegap Pulavar"}, "explanation": "Kalamegap Pulavar was a 15th-century classical poet, unrelated to 20th-century Ezhuthu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "cl