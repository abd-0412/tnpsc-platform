{"id": "11th_tamil_rev1_q122", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_supp_grammar", "chapter_id": null, "topic_id": "pagupatham_split_kanndan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கண்டான்' என்னும் வினைமுற்றுச் சொல்லின் சரியான பகுபத உறுப்பிலக்கணப் பகுப்பு எது?", "media_id": null}], "options": {"A": "கண் + ட் + ஆன்", "B": "காண்(கண்) + ட் + ஆன் (காண் - பகுதி, கண் என குறுகியது விகாரம்; ட் - இறந்தகால இடைநிலை; ஆன் - படர்க்கை ஆண்பால் வினைமுற்று விகுதி)", "C": "கண்டா + ன்", "D": "காண் + தான்"}, "explanation": "'கண்டான்' = காண்(கண்) + ட் + ஆன். இதில் காண் என்பது பகுதி; அது கண் என விகாரமானது; ட் - இறந்தகால இடைநிலை; ஆன் - ஆண்பால் வினைமுற்று விகுதி."}, "en": {"blocks": [{"type": "text", "content": "What is the precise morphological dissection of the finite verb 'Kandaan' (He saw)?", "media_id": null}], "options": {"A": "Kan + t + aan", "B": "Kaan(kan) + t + aan (Kaan: root shortened to kan as vikaram; t: past tense; aan: masculine singular suffix)", "C": "Kandaa + n", "D": "Kaan + thaan"}, "explanation": "Kaan(kan) + t + aan precisely maps root shortening, past infix, and masculine suffix."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Servi