{"id": "11th_tamil_rev1_q045", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_supp_grammar", "chapter_id": null, "topic_id": "elephant_doctor_death_memorial", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "டாக்டர் கிருஷ்ணமூர்த்தி அவர்கள் இயற்கை எய்தியபோது, காட்டு யானைகள் வந்து அவருக்கு அஞ்சலி செலுத்திய நெகிழ்ச்சியான நிகழ்வு எங்கு பதிவு செய்யப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "டாப் ஸ்லிப்பில் அவரது இறுதிச் சடங்கின் போது காட்டின் காட்டு யானைகள் பிளிறி அஞ்சலி செலுத்தின", "B": "சென்னையில்", "C": "மதுரையில்", "D": "தில்லியில்"}, "explanation": "டாக்டர் கிருஷ்ணமூர்த்தி மறைந்தபோது, அவர் சிகிச்சை அளித்த வளர்ப்பு மற்றும் காட்டு யானைகள் வரிசையாக வந்து கண்ணீர் மல்கத் துதிக்கை உயர்த்தி அஞ்சலி செலுத்தியது உலகையே உலுக்கிய நெகிழ்வான நிகழ்வாகும்."}, "en": {"blocks": [{"type": "text", "content": "Where did the profoundly moving tribute occur when elephants gathered to salute Dr. Krishnamoorthy upon his demise?", "media_id": null}], "options": {"A": "At Top Slip during his funeral where wild and camp elephants raised trunks in mournful salute", "B": "In Chennai", "C": "In Madurai", "D": "In Delhi"}, "explanation": "Trained and wild elephants trumpeted in collective mourning during his last rites at Top Slip."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source":