{"id": "11th_tamil_rev1_q100", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "umarup_pulavar_guru_kadikai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உமறுப்புலவருக்குத் தமிழிலக்கண இலக்கியங்களை முறையாகக் கற்பித்த ஆசான் யார்?", "media_id": null}], "options": {"A": "மீனாட்சி சுந்தரம்பிள்ளை", "B": "சிவப்பிரகாசர்", "C": "வீரமாமுனிவர்", "D": "கடிகைமுத்துப் புலவர்"}, "explanation": "எட்டயபுரத்து அரசவைக் கவிஞரான 'கடிகைமுத்துப் புலவர்' அவர்களின் தலைசிறந்த மாணவராக உமறுப்புலவர் திகழ்ந்தார்."}, "en": {"blocks": [{"type": "text", "content": "Who was the preceptor under whom Umaru Pulavar mastered Tamil classical poetics and grammar?", "media_id": null}], "options": {"A": "Meenakshisundaram Pillai", "B": "Sivaprakasar", "C": "Constanzo Beschi", "D": "Kadigaimuthup Pulavar"}, "explanation": "Kadigaimuthup Pulavar served as Umaru Pulavar's venerable guru."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 93, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 93", "url": null, "sour