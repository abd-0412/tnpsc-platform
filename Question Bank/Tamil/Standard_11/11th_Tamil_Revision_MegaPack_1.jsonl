{"id": "11th_tamil_rev1_q061", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "balakrishnan_books_journey", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆர். பாலகிருஷ்ணன் ஐ.ஏ.எஸ் அவர்களின் சிந்துவெளி மற்றும் திராவிடப் பண்பாட்டுத் தொடர்பை விளக்கும் பெருநூல் எது?", "media_id": null}], "options": {"A": "சிந்துவெளிப் பண்பாட்டின் திராவிட அடித்தளம் (Journey of a Civilization: Indus to Vaigai)", "B": "காவிரி முதல் வைகை வரை", "C": "பண்டைத் தமிழகம்", "D": "கீழடி அகழாய்வு"}, "explanation": "'Journey of a Civilization: Indus to Vaigai' என்னும் உலகத்தரம் வாய்ந்த வரலாற்று ஆய்வு நூலை எழுதி சிந்துவெளிக்கும் வைகைப் பண்பாட்டிற்கும் உள்ள தொடர்பை பாலகிருஷ்ணன் மெய்ப்பித்தார்."}, "en": {"blocks": [{"type": "text", "content": "What is the title of the masterwork authored by R. Balakrishnan IAS establishing the Dravidian foundation of the Indus Valley Civilization?", "media_id": null}], "options": {"A": "Journey of a Civilization: Indus to Vaigai", "B": "Kaveri Mudhal Vaigai Varai", "C": "Pandai Thamizhagam", "D": "Keeladi Excavations"}, "explanation": "R. Balakrishnan IAS authored the magnum opus 'Journey of a Civilization: Indus to Vaigai'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Sa