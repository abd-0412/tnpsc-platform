{"id": "11th_tamil_rev1_q193", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_pyq_model", "chapter_id": null, "topic_id": "pyq_vilvarathinam_uyirthazhum", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] \"எழுக என் தோழா! எழுந்து வா என் கவிதையே!\" என்று பாடிய கவிஞர் சு. வில்வரத்தினத்தின் கவிதை எம்மொழியின் பெருமையை மீட்டெடுக்கும் வரலாற்றுத் தாகமாக அமைகிறது?", "media_id": null}], "options": {"A": "தமிழ் மொழி (யுகத்தின் பாடல்)", "B": "சிங்கள மொழி", "C": "ஆங்கில மொழி", "D": "சமஸ்கிருதம்"}, "explanation": "ஈழ மண்ணில் தமிழ் நூலகம் எரிக்கப்பட்டு, பண்பாட்டு ஒடுக்குமுறை நிகழ்ந்த சூழலில் தமிழின் உயிர்ப்பையும் தொடர்ச்சியையும் வில்வரத்தினம் பாடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] In 'Yugathin Paadal', whose enduring cultural rebirth and linguistic immortality does Su. Vilvarathinam passionately champion?", "media_id": null}], "options": {"A": "The Tamil language and cultural soul", "B": "Sinhalese", "C": "English", "D": "Sanskrit"}, "explanation": "Vilvarathinam champions the immortal resurgence of the Tamil language."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": 