{"id": "11th_tamil_rev1_q072", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "kurunthogai_first_print_year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறுந்தொகை நூலை முதன்முதலில் பதிப்பித்துத் தமிழ்கூறும் நல்லுலகிற்கு அளித்த தமிழறிஞர் யார்? எந்த ஆண்டு?", "media_id": null}], "options": {"A": "உ. வே. சாமிநாதையர் (1894)", "B": "தாமோதரம் பிள்ளை (1885)", "C": "மறைமலையடிகள் (1900)", "D": "சி. வை. தாமோதரம்பிள்ளை அல்ல, சௌரிப் பெருமாள் அரங்கனார் (1915)"}, "explanation": "குறுந்தொகை முதன்முதலில் 1915-ல் 'சௌரிப் பெருமாள் அரங்கனார்' அவர்களால் மிக நேர்த்தியாகப் பதிப்பித்து வெளியிடப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Who was the pioneering Tamil savant to edit and print the very first printed edition of Kurunthogai in 1915?", "media_id": null}], "options": {"A": "U. Ve. Swaminatha Iyer (1894)", "B": "C. W. Damodaram Pillai (1885)", "C": "Maraimalai Adigal (1900)", "D": "Sowri Perumal Aranganar (in 1915)"}, "explanation": "Sowri Perumal Aranganar published the first print edition of Kurunthogai in 1915."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "t