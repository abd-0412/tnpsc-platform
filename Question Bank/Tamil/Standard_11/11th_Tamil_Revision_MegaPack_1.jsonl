{"id": "11th_tamil_rev1_q073", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "purananuru_philosophy_kadalul", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"தமக்கென முயலா நோன்தாள்\nபிறர்க்கென முயலுநர் உண்மை யானே\"\n- இப்புறநானூற்று வரிகள் வலியுறுத்தும் மாண்பு யாது?", "media_id": null}], "options": {"A": "சுயநலமின்றிப் பிறர் நன்மைக்காக மட்டுமே வாழும் உயர்ந்த தியாக நெறி", "B": "வீரம்", "C": "அரசியல் வெற்றி", "D": "கல்விப் பெருமை"}, "explanation": "தமக்கென வாழாமல் பிறருக்காக வாழும் தன்னலமற்ற சான்றோர்கள் உலகில் வாழ்வதால்தான் இந்த உலகம் உயிர்ப்போடு இயங்குகிறது என்று கடலுள் மாய்ந்த இளம்பெருவழுதி பாடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What noble moral conduct is eulogized in 'Thamakkana Muyalaa Nondhaal Pirarkkena Muyalunar Unmaiyaanae'?", "media_id": null}], "options": {"A": "Sublime selfless altruism living entirely for the welfare of others without egoism", "B": "Physical valour", "C": "Political domination", "D": "Intellectual pride"}, "explanation": "The verse honors altruistic human beings who toil solely for the happiness of others."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educati