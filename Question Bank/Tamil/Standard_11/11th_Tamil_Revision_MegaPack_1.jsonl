{"id": "11th_tamil_rev1_q127", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_supp_grammar", "chapter_id": null, "topic_id": "thirukkural_kaalam_crane", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"கொக்கொக்க கூம்பும் பருவத்து மற்றதன்\nகுத்தொக்க சீர்த்த இடத்து\" - இக்குறட்பாவில் பயின்றுவந்துள்ள அணி எது?", "media_id": null}], "options": {"A": "வேற்றுமையணி", "B": "வஞ்சப்புகழ்ச்சியணி", "C": "உவமையணி (கொக்கின் பொறுமையும் விரைவும் உவமை)", "D": "சிலேடை அணி"}, "explanation": "வாய்ப்பு வரும் வரை கொக்கைப் போல அமைதியாகக் காத்திருக்க வேண்டும்; வாய்ப்பு கிடைத்தவுடன் கொக்கு மீனைத் துல்லியமாகக் குத்துவது போலச் செய்து முடிக்க வேண்டும் என 'ஒக்க' என்ற உவம உருபு வெளிப்பட்டு வந்ததால் 'உவமையணி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What poetic figure (Ani) is deployed in 'Kokkokka Koombum Paruvathu Mattrathan Kuthokka Seertha Idathu'?", "media_id": null}], "options": {"A": "Vettrumaiyani", "B": "Vanchappuhazhchiyani", "C": "Uvamaiyani (Simile with comparative particle Okka)", "D": "Siledai Ani"}, "explanation": "Uvamaiyani is deployed through the explicit comparative particle 'okka'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporati