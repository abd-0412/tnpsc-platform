{"id": "11th_tamil_rev1_q145", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_grammar", "chapter_id": null, "topic_id": "vowels_mathirai_count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கணம்: குறில் எழுத்துகள் ஒலிக்கும் மாத்திரை அளவு மற்றும் நெடில் எழுத்துகள் ஒலிக்கும் மாத்திரை அளவு முறையே எவை?", "media_id": null}], "options": {"A": "குறில் - 1 மாத்திரை; நெடில் - 2 மாத்திரை", "B": "குறில் - 2 மாத்திரை; நெடில் - 1 மாத்திரை", "C": "குறில் - அரை மாத்திரை; நெடில் - 1 மாத்திரை", "D": "இரண்டுக்கும் 3 மாத்திரை"}, "explanation": "குறில் எழுத்து ஒலிக்கும் கால அளவு ஒரு மாத்திரை; நெடில் எழுத்து ஒலிக்கும் கால அளவு இரண்டு மாத்திரைகள் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Grammar: What are the canonical metrical durations (Maathirai) for short vowels (Kuril) and long vowels (Nedil) respectively?", "media_id": null}], "options": {"A": "Kuril - 1 maathirai; Nedil - 2 maathirai", "B": "Kuril - 2 maathirai; Nedil - 1 maathirai", "C": "Kuril - half maathirai; Nedil - 1 maathirai", "D": "3 maathirai for both"}, "explanation": "Short vowels carry 1 mora (maathirai); long vowels carry 2 morae."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Ser