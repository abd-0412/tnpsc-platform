{"id": "11th_tamil_rev1_q069", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "purananuru_definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைத் தமிழர்களின் வீரம், கொடை, ஆட்சிமுறை, போர் நெறிகள் மற்றும் சமுதாய வாழ்வை உள்ளவாறு காட்டும் வரலாற்றுப் பெட்டகமாகத் திகழும் நூல் எது?", "media_id": null}], "options": {"A": "புறநானூறு", "B": "அகநானூறு", "C": "கலித்தொகை", "D": "பரிபாடல்"}, "explanation": "புறநானூறு தமிழர்களின் வாழ்வியல் பண்பாட்டை, போர்க்கள ஒழுக்கங்களை, மன்னர்களின் ஈகைத் திறனைப் பதிவுசெய்த வரலாற்று ஆவணமாகத் திகழ்கிறது."}, "en": {"blocks": [{"type": "text", "content": "Which Sangam anthology serves as the supreme historical sociological archive of ancient Tamil polity, chivalry, ethics, and philanthropy?", "media_id": null}], "options": {"A": "Purananuru", "B": "Akananuru", "C": "Kalithogai", "D": "Paripadal"}, "explanation": "Purananuru is celebrated as the authentic historical and cultural encyclopedia of ancient Tamils."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 62, "chapter": null, "secti