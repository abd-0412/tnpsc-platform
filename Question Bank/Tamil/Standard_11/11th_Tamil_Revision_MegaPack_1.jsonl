{"id": "11th_tamil_rev1_q185", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_pyq_model", "chapter_id": null, "topic_id": "pyq_thirukkural_adakkam_mountain", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] \"நிலையின் திரியாது அடங்கியான் தோற்றம்\nமலையினும் மாணப் பெரிது\" - இக்குறட்பாவின்படி ஒருவனது அடக்கம் எதைவிடப் பெரியதாக மதிக்கப்படும்?", "media_id": null}], "options": {"A": "மலையை விடப் பெரியதாக", "B": "வானத்தை விடப் பெரியதாக", "C": "கடலை விடப் பெரியதாக", "D": "பூமியை விடப் பெரியதாக"}, "explanation": "தன் நன்னெறியிலிருந்து வழுவாமல் அடக்கத்தோடு வாழ்பவனின் தோற்றம் மற்றும் பெருமை இந்த உலகத்து மலையைக் காட்டிலும் மிகப் பெரிதாகப் போற்றப்படும்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] According to Valluvar, the stature of one who remains steadfast in moral discipline without straying is greater than what?", "media_id": null}], "options": {"A": "Greater than a majestic mountain (Malai)", "B": "Greater than the sky", "C": "Greater than the vast ocean", "D": "Greater than the entire earth"}, "explanation": "Steadfast humble rectitude is vaster than a mountain."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpo