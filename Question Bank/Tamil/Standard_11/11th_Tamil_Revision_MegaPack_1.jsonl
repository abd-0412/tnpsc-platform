{"id": "11th_tamil_rev1_q148", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_grammar", "chapter_id": null, "topic_id": "aakkappeyar_marapu_vazhu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்கண்ட சொற்களுள் சரியான மரபுசார் எழுத்துப்பிழையற்ற ஆக்கப்பெயர் எது?", "media_id": null}], "options": {"A": "ஓட்டுனர் (னகரப் பயன்பாடு)", "B": "இயக்குனர்", "C": "பயிற்சினர்", "D": "ஓட்டுநர், இயக்குநர் (தன்னகர 'ந'கரப் பயன்பாடு)"}, "explanation": "அரசுப் பயன்பாட்டிலும் இலக்கண மரபிலும் பலர்பால்/மரியாதைப் பன்மை ஆக்கப்பெயர்களில் 'ஓட்டுநர்', 'இயக்குநர்' எனத் தன்னகர 'நர்' அமைவதே சரியானது."}, "en": {"blocks": [{"type": "text", "content": "Which option represents the grammatically standard orthographic form of epicene agentive nouns in official Tamil?", "media_id": null}], "options": {"A": "Ottunar (with alveolar na)", "B": "Iyakkunar (with alveolar na)", "C": "Payirtsinar", "D": "Ottunar and Iyakkunar (with standard dental na / நர்)"}, "explanation": "Standard Tamil orthography mandates dental 'nar' for honorific agentives."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 1