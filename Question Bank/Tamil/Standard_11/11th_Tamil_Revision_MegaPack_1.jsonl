{"id": "11th_tamil_rev1_q076", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "purananuru_english_translation_pope", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புறநானூற்றின் தேர்ந்தெடுக்கப்பட்ட பாடல்களை ஆங்கிலத்தில் 'The 400 Songs of War and Wisdom' என்ற தலைப்பில் மொழிபெயர்த்த மேலைநாட்டுத் தமிழறிஞர் யார்?", "media_id": null}], "options": {"A": "கால்டுவெல்", "B": "வீரமாமுனிவர்", "C": "எல்லிஸ்", "D": "ஜார்ஜ் எல். ஹார்ட் (George L. Hart - மற்றும் ஜி. யு. போப்)"}, "explanation": "ஜி. யு. போப் புறநானூற்றின் பல பாடல்களை ஆங்கிலத்தில் மொழிபெயர்த்தார்; நவீன காலத்தில் அமெரிக்கத் தமிழறிஞர் பேராசிரியர் ஜார்ஜ் எல். ஹார்ட் 'The 400 Songs of War and Wisdom' என முழுமையாக மொழிபெயர்த்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which distinguished scholar translated the Puram corpus into English titled 'The 400 Songs of War and Wisdom'?", "media_id": null}], "options": {"A": "Robert Caldwell", "B": "Constanzo Beschi", "C": "Francis Whyte Ellis", "D": "Prof. George L. Hart (alongside earlier translations by G. U. Pope)"}, "explanation": "Prof. George L. Hart masterfully translated Purananuru as 'The 400 Songs of War and Wisdom'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu