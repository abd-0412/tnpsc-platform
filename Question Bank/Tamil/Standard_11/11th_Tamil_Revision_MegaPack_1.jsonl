{"id": "11th_tamil_rev1_q120", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_supp_grammar", "chapter_id": null, "topic_id": "thirukkural_kaakka_porula", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"காக்க பொருளா அடக்கத்தை ஆக்கம்\nஅதனினூஉங் கில்லை உயிர்க்கு\" - இத்திருக்குறளில் பயின்றுவந்துள்ள அளபெடை எது?", "media_id": null}], "options": {"A": "இன்னிசை அளபெடை", "B": "சொல்லிசை அளபெடை", "C": "ஒற்றளபெடை", "D": "செய்யுளிசை அளபெடை (இசைநிறை அளபெடை - அதனினூஉங்கு)"}, "explanation": "'அதனினூஉங்கு' என்பதில் ஓசை குறையாத இடத்திலும் செய்யுள் ஓசையை நிறைவு செய்ய நெடில் எழுத்து நீண்டு அளபெடுத்ததால் இது 'செய்யுளிசை அளபெடை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What type of vocalic elongation (Alapedai) is featured in 'Athaninooungu' in the Kural on self-control?", "media_id": null}], "options": {"A": "Innisai Alapedai", "B": "Solliisai Alapedai", "C": "Otrralapedai", "D": "Seyyulisai / Isainirai Alapedai"}, "explanation": "'Athaninooungu' demonstrates Seyyulisai Alapedai to satisfy metrical length."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 78, "chapte