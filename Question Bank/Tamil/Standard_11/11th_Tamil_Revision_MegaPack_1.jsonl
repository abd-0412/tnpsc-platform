{"id": "11th_tamil_rev1_q099", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "pillaip_perumal_thiruvarangam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிள்ளைப் பெருமாள் ஐயங்கார் 'திருவரங்கத்து அந்தாதி' நூலில் பாட்டுடைத் தெய்வமாகப் போற்றிப் பாடிய வைணவப் பெருந்தலம் எது?", "media_id": null}], "options": {"A": "திருப்பதி வேங்கடாசலபதி", "B": "காஞ்சி வரதராஜப் பெருமாள்", "C": "ஸ்ரீரங்கம் திருவரங்கநாதர் திருக்கோயில்", "D": "மதுரை கூடலழகர்"}, "explanation": "பூலோக வைகுண்டம் என்று போற்றப்படும் ஸ்ரீரங்கம் அரங்கநாதப் பெருமாள் மீது 100 அந்தாதிப் பாடல்களால் திருவரங்கத்து அந்தாதியை இயற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Which sacred Vaishnavite Divya Desam is eulogized in Pillai Perumal Aiyangar's 'Thiruvarangathu Anthathi'?", "media_id": null}], "options": {"A": "Tirupati Venkateswara", "B": "Kanchipuram Varadharaja", "C": "Srirangam Sri Ranganathaswamy Temple", "D": "Madurai Koodalazhagar"}, "explanation": "The poem eulogizes Lord Ranganatha of Srirangam in 100 anthathi stanzas."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year