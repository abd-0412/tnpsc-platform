{"id": "11th_tamil_rev1_q092", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "bharathi_chakravarthini_women", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெண்களின் முன்னேற்றத்திற்காகவும் பெண் விடுதலைக்காகவும் பாரதியார் பிரத்யேகமாக ஆசிரியராக இருந்து நடத்திய மாத இதழ் எது?", "media_id": null}], "options": {"A": "இந்தியா", "B": "விஜயா", "C": "பாலபாரதி", "D": "சக்கரவர்த்தினி (Chakravarthini - 1905)"}, "explanation": "1905-ல் தொடங்கப்பட்ட 'சக்கரவர்த்தினி' மாத இதழில் பெண்கல்வி, பெண் விடுதலை, விதவை மறுமணம் உள்ளிட்ட முற்போக்குக் கருத்துகளை பாரதி தீவிரமாக எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "Which progressive monthly magazine was edited by Bharati exclusively for women's emancipation and rights?", "media_id": null}], "options": {"A": "India", "B": "Vijaya", "C": "Bala Bharathi", "D": "Chakravarthini (1905)"}, "explanation": "Chakravarthini was launched in 1905 under Bharati's editorship dedicated to women's empowerment."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 96, "chapter": null, "se