{"id": "11th_tamil_rev1_q074", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "midday_meal_scheme_origins", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்நாட்டில் பள்ளிக் குழந்தைகளுக்கு முதன்முதலில் மதிய உணவுத் திட்டத்தை (Midday Meal Scheme) 1920-ல் சென்னை மாநகராட்சியில் அறிமுகப்படுத்திய இயக்கம்/அரசு எது?", "media_id": null}], "options": {"A": "பிரிட்டிஷ் கவர்னர் அரசு", "B": "நீதிக் கட்சி (Justice Party - தியாகராய செட்டியார் தலைமையில்)", "C": "காங்கிரஸ் கட்சி", "D": "சுயமரியாதை இயக்கம்"}, "explanation": "1920-ல் நீதிக்கட்சி ஆட்சியில் சென்னை ஆயிரம் விளக்குப் பகுதியில் சர் பி. தியாகராய செட்டியாரால் மதிய உணவுத் திட்டம் முதன்முதலில் தொடங்கப்பட்டது; பின்னர் காமராசரால் தமிழகம் முழுவதும் விரிவாக்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which progressive political administration pioneered the Midday Meal Scheme for school children in Madras in 1920?", "media_id": null}], "options": {"A": "Direct British Crown Rule", "B": "The Justice Party (under Sir P. Theagaraya Chetty)", "C": "The Indian National Congress", "D": "The Self-Respect Movement"}, "explanation": "The Justice Party government launched the historic Midday Meal Scheme at Thousand Lights, Madras in 1920."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 86, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 86", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 1", "Prose", "Education"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev1_q075", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "kurunthogai_total_verses", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறுந்தொகை நூலில் கடவுள் வாழ்த்து நீங்கலாக மொத்தம் எத்தனை பாடல்கள் இடம்பெற்றுள்ளன?", "media_id": null}], "options": {"A": "500 பாடல்கள்", "B": "300 பாடல்கள்", "C": "400 பாடல்கள் (401 பாடல்கள் கடவுள் வாழ்த்துடன்)", "D": "150 பாடல்கள்"}, "explanation": "குறுந்தொகையில் மொத்தம் 401 பாடல்கள் உள்ளன (400 அகப்பாடல்கள் + 1 கடவுள் வாழ்த்துப் பாடல்)."}, "en": {"blocks": [{"type": "text", "content": "How many classical verses are anthologized in Kurunthogai excluding the invocatory verse?", "media_id": null}], "options": {"A": "500 verses", "B": "300 verses", "C": "400 verses (401 verses including invocation)", "D": "150 verses"}, "explanation": "Kurunthogai comprises exactly 400 verses plus one invocatory verse."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 58, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 58", "url": null, "sourc