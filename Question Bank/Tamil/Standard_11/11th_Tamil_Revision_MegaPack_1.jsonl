{"id": "11th_tamil_rev1_q178", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_pyq_model", "chapter_id": null, "topic_id": "pyq_thirukkural_kooda_ozhukkam_valiyin", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] \"வலியின் நிலைமையான் வல்லுருவம் பெற்றம்\nபுலியின்தோல் போர்த்துமேய்ந் தற்று\" - இத்திருக்குறளில் பயின்றுவந்துள்ள அணி எது?", "media_id": null}], "options": {"A": "உவமையணி", "B": "இல்பொருள் உவமையணி (புலியின் தோலைப் போர்த்திய பசு உலகில் இல்லை என்பதால்)", "C": "வேற்றுமையணி", "D": "வஞ்சப்புகழ்ச்சியணி"}, "explanation": "பசு புலியின் தோலைப் போர்த்துக்கொண்டு மேய்வது என்பது உலகில் இல்லாத ஒன்று; ஆகவே இல்லாத பொருளை உவமித்ததால் இது 'இல்பொருள் உவமையணி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Which figure of speech (Ani) is deployed in the verse where a hypocrite's ascetic garb is compared to a cow wearing a tiger's skin?", "media_id": null}], "options": {"A": "Uvamaiyani", "B": "Ilporul Uvamaiyani (Fancy simile based on a physically non-existent premise)", "C": "Vettrumaiyani", "D": "Vanchappuhazhchiyani"}, "explanation": "Ilporul Uvamaiyani is deployed because a cow wearing a tiger skin does not exist in nature."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalv