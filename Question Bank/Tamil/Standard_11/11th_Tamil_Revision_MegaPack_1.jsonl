{"id": "11th_tamil_rev1_q070", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "madras_university_founding_year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வுட்ஸ் கல்வி அறிக்கையின் பரிந்துரையின்படி தென்னிந்தியாவின் முதல் பல்கலைக்கழகமான 'சென்னை பல்கலைக்கழகம்' (University of Madras) எந்த ஆண்டு நிறுவப்பட்டது?", "media_id": null}], "options": {"A": "1854", "B": "1857-ஆம் ஆண்டு", "C": "1882", "D": "1905"}, "explanation": "1857-ஆம் ஆண்டு சென்னை, கொல்கத்தா, மும்பை ஆகிய மூன்று பெருநகரங்களில் பல்கலைக்கழகங்கள் நிறுவப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "In which historic year was the University of Madras established pursuant to the Wood Despatch recommendations?", "media_id": null}], "options": {"A": "1854", "B": "1857", "C": "1882", "D": "1905"}, "explanation": "The University of Madras was founded in 1857 alongside universities in Calcutta and Bombay."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 85, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 85", "ur