{"id": "11th_tamil_rev1_q043", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_supp_grammar", "chapter_id": null, "topic_id": "thirukkural_valiyarithal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"பீலிபெய் சாகாடும் அச்சிறும் அப்பண்டஞ்\nசால மிகுத்துப் பெயின்\" - இத்திருக்குறள் உணர்த்தும் பாடம் யாது?", "media_id": null}], "options": {"A": "மயிலிறகு மிகக் கனமானது", "B": "வண்டி வேகமாக ஓடும்", "C": "மென்மையான மயிலிறகே ஆயினும் அளவுக்கு அதிகமாக ஏற்றினால் வண்டியின் அச்சு முறியும்; எனவே வலிமை அறிந்து எச்செயலையும் செய்ய வேண்டும்", "D": "பொருட்களைச் சேமிக்கக் கூடாது"}, "explanation": "மயிலிறகு மிகவும் மெலிதானதுதான்; ஆயினும் அளவுக்கு மீறி ஏற்றினால் வண்டியின் அச்சும் முறிந்துவிடும். எனவே பகைவரின் வலிமையையும் தன் வலிமையையும் அறிந்து செயல்பட வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "What timeless geopolitical wisdom is distilled in 'Peelipey Saagaadum Achirum Appandanj Saala Mihuthup Peyin'?", "media_id": null}], "options": {"A": "Peacock feathers are excessively dense", "B": "Chariots run fast", "C": "Even feather-light peacock plumes, if overloaded beyond limit, will shatter the cart axle; hence measure all actions by limits of strength", "D": "Never stockpile goods"}, "explanation": "Even the lightest burden overloaded beyond capacity will break the strongest axle."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "