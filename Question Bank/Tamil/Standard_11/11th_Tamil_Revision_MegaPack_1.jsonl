{"id": "11th_tamil_rev1_q166", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_grammar", "chapter_id": null, "topic_id": "pagupatham_ethirmarai_idainilai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பகுபத உறுப்புகளில் 'எதிர்மறை இடைநிலைகளாக' (Negative tense infixes) வரும் எழுத்துகள் எவை?", "media_id": null}], "options": {"A": "த், ட், ற்", "B": "இல், அல், ஆ (எ.கா: காணலன், வாரா, செய்யான்)", "C": "கிறு, கின்று", "D": "ப், வ்"}, "explanation": "எதிர்மறைப் பொருளைத் தரும் இடைநிலைகளாக 'இல், அல், ஆ' ஆகியவை அமைகின்றன (செய்தான் என்பதற்கு மாறாகச் செய்யான், செய்யலன், செய்திலன்)."}, "en": {"blocks": [{"type": "text", "content": "Grammar: Which morphemes function as negative infixes (Ethirmarai Idainilai) in classical Pagupatham?", "media_id": null}], "options": {"A": "th, t, tr", "B": "il, al, aa (e.g., Kaanalan, Vaaraa, Seyyaan)", "C": "kiru, kindru", "D": "p, v"}, "explanation": "'il', 'al', and 'aa' function as negative verbal infixes."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 73, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megap