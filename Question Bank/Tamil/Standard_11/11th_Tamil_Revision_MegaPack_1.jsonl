{"id": "11th_tamil_rev1_q040", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_supp_grammar", "chapter_id": null, "topic_id": "jeyamohan_aram_short_stories", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜெயமோகனின் 'அறம்' சிறுகதைத் தொகுப்பில் மனிதநேயத்தையும் அற விழுமியங்களையும் போற்றும் பிற கதைகளுள் பொருந்தாதது எது?", "media_id": null}], "options": {"A": "நூறு நாற்காலிகள்", "B": "பெருவழிக் கன்னியாகுமரி", "C": "மத்தகம்", "D": "கீதாஞ்சலி"}, "explanation": "'கீதாஞ்சலி' தாகூரின் கவிதை நூல்; 'நூறு நாற்காலிகள்', 'பெருவழிக் கன்னியாகுமரி', 'மத்தகம்', 'யானை டாக்டர்' போன்றவை ஜெயமோகனின் 'அறம்' சிறுகதைகளாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following does NOT belong to Jeyamohan's ethical short story anthology 'Aram'?", "media_id": null}], "options": {"A": "Nooru Naarkaaligal", "B": "Peruvazhik Kanniyakumari", "C": "Mathagam", "D": "Gitanjali"}, "explanation": "Gitanjali was authored by Rabindranath Tagore, whereas the others are stories from Jeyamohan's 'Aram'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 38, "chapter": null, "section": n