{"id": "11th_tamil_rev1_q027", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "aingurunooru_peyanar_mullai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஐங்குறுநூற்றில் முல்லைத் திணையைப் பாடிய புலவர் யார்? அத்திணையின் உரிப்பொருள் யாது?", "media_id": null}], "options": {"A": "கபிலர் - புணர்தலும் புணர்தல் நிமித்தமும்", "B": "ஓரம்போகியார் - ஊடலும் ஊடல் நிமித்தமும்", "C": "பேயனார் - இருத்தலும் இருத்தல் நிமித்தமும் (காத்திருத்தல்)", "D": "அம்மூவனார் - இரங்கலும் இரங்கல் நிமித்தமும்"}, "explanation": "ஐங்குறுநூற்றில் முல்லைத் திணையைப் பாடியவர் பேயனார்; முல்லையின் உரிப்பொருள் தலைவனின் வருகைக்காகத் தலைவி பொறுமையுடன் காத்திருத்தல் (இருத்தல்) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Who composed Mullai tinai in Aingurunooru, and what is its canonical thematic mood (Uripporul)?", "media_id": null}], "options": {"A": "Kapilar - Union and its anticipation", "B": "Orambogiyar - Sulking and feigned lovers quarrel", "C": "Peyanaar - Patient waiting in separation (Iruthalum Iruthal Nimithamum)", "D": "Ammoovanaar - Lamentation over ocean"}, "explanation": "Peyanaar sang Mullai tinai, characterizing loving patience and faithful waiting."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_na