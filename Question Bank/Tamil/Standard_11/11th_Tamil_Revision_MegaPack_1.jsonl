{"id": "11th_tamil_rev1_q093", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "pillaip_perumal_ashta_prabandham", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'அழகிய மணவாளதாசர்' என்று போற்றப்படும் பிள்ளைப் பெருமாள் ஐயங்கார் இயற்றிய எட்டு வைணவ நூல்களின் தொகுப்பு எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "அஷ்டப் பிரபந்தம் (Ashta Prabandham)", "B": "நாலாயிர திவ்வியப் பிரபந்தம்", "C": "பன்னிரு திருமுறை", "D": "சைவ சித்தாந்த சாத்திரங்கள்"}, "explanation": "திருவரங்கத்து மாலை, திருவரங்கத்து அந்தாதி உள்ளிட்ட எட்டு நூல்களை இயற்றியதால் அவை 'அஷ்டப் பிரபந்தம்' எனப் போற்றப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What collective title designates the eight classical Vaishnavite devotional texts composed by Pillai Perumal Aiyangar?", "media_id": null}], "options": {"A": "Ashta Prabandham", "B": "Nalayira Divya Prabandham", "C": "Panniru Thirumurai", "D": "Saiva Siddhanta Saathirangal"}, "explanation": "His eight devotional works are collectively hailed as Ashta Prabandham."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_