{"id": "11th_tamil_rev1_q126", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_supp_grammar", "chapter_id": null, "topic_id": "thirukkural_kaalam_arithal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"பகல்வெல்லும் கூகையைக் காக்கை இகல்வெல்லும்\nவேந்தர்க்கு வேண்டும் பொழுது\" - இத்திருக்குறளில் 'கூகை' என்பது எதனைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "கழுகு", "B": "கோட்டான் (ஆந்தை)", "C": "மயில்", "D": "புறா"}, "explanation": "'கூகை' என்பது ஆந்தையைக் குறிக்கும். பகல் நேரத்தில் வலிமையற்ற காக்கையானது தன்னை விட வலிமையான ஆந்தையை வென்றுவிடும்; அதுபோல அரசன் தகுந்த காலத்தை அறிந்து செயல்பட வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "In the Kural 'Pagalvellum Koogaiyaik Kaakkai', what bird does 'Koogai' signify?", "media_id": null}], "options": {"A": "Eagle", "B": "Owl (Kottaan / Horned owl)", "C": "Peacock", "D": "Dove"}, "explanation": "'Koogai' signifies an owl, vanquished by a crow during bright daylight."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 79, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_me