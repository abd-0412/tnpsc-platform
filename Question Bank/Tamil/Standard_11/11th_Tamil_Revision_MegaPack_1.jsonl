{"id": "11th_tamil_rev1_q190", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_pyq_model", "chapter_id": null, "topic_id": "pyq_hunter_commission_1882", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] இந்தியாவில் தொடக்கக் கல்வியை உள்ளாட்சி அமைப்புகளிடம் (Municipality & Local Boards) ஒப்படைக்கப் பரிந்துரைத்த வரலாற்றுச் சிறப்புமிக்க பிரிட்டிஷ் கல்விக்குழு எது?", "media_id": null}], "options": {"A": "மெக்காலே குழு", "B": "ஹண்டர் கல்விக்குழு (Hunter Commission - 1882)", "C": "வுட்ஸ் குழு", "D": "சாட்லர் குழு"}, "explanation": "1882-ல் அமைக்கப்பட்ட சர் வில்லியம் ஹண்டர் தலைமையிலான கல்விக்குழு தொடக்கக் கல்வியை நகராட்சி மற்றும் மாவட்ட வாரியங்களிடம் ஒப்படைக்கப் பரிந்துரைத்தது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Which historic commission recommended transferring elementary education to local self-government municipalities in 1882?", "media_id": null}], "options": {"A": "Macaulay Committee", "B": "Hunter Education Commission (1882)", "C": "Wood Committee", "D": "Sadler Commission"}, "explanation": "The Hunter Commission of 1882 devolved primary education to local municipal boards."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and