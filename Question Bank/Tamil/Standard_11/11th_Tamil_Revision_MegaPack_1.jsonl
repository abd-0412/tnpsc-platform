{"id": "11th_tamil_rev1_q044", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_supp_grammar", "chapter_id": null, "topic_id": "ina_ezhuthu_ai_au", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நெடில் எழுத்துகளான 'ஐ' மற்றும் 'ஔ' ஆகியவற்றுக்கு இன எழுத்துகளாக முறையே அமைவன எவை?", "media_id": null}], "options": {"A": "அ மற்றும் ஆ", "B": "ஏ மற்றும் ஓ", "C": "உ மற்றும் இ", "D": "இ மற்றும் உ (ஐ - இ; ஔ - உ)"}, "explanation": "'ஐ' என்னும் நெடிலுக்கு 'இ' என்பதும், 'ஔ' என்னும் நெடிலுக்கு 'உ' என்பதும் இன எழுத்துகளாக அமைகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Which short vowel characters serve as the cognate vowel pairs (Ina Ezhuthu) for diphthongs 'Ai' and 'Au' respectively?", "media_id": null}], "options": {"A": "a and aa", "B": "e and o", "C": "u and i", "D": "i and u (for Ai - i; for Au - u)"}, "explanation": "'i' is cognate to 'Ai', and 'u' is cognate to 'Au'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 17, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 17", "url": null, "source_notes": null}, "previous_ye