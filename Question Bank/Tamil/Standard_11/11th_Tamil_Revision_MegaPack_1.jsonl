{"id": "11th_tamil_rev1_q090", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "bharathi_first_cartoon_journal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் இதழியல் வரலாற்றில் முதன்முதலில் அரசியல் கேலிச்சித்திரங்களை (Political Cartoons) அச்சிட்டு வெளியிட்ட பெருமைக்குரிய பாரதியின் இதழ் எது?", "media_id": null}], "options": {"A": "சுதேசமித்திரன்", "B": "இந்தியா (வார இதழ்)", "C": "சக்கரவர்த்தினி", "D": "சுதேச கீதங்கள்"}, "explanation": "1906 முதல் வெளிவந்த 'இந்தியா' வார இதழில் பாரதியார் முதல் பக்கத்திலேயே வண்ணக் கேலிச்சித்திரங்களை வெளியிட்டு ஆங்கிலேய ஆதிக்கத்தை நகைச்சுவையோடு சாடினார்."}, "en": {"blocks": [{"type": "text", "content": "Which historic journal edited by Bharati pioneered political cartoon caricatures in Tamil journalism?", "media_id": null}], "options": {"A": "Swadesamitran", "B": "India (Weekly)", "C": "Chakravarthini", "D": "Swadesa Geethangal"}, "explanation": "Bharati introduced front-page political cartoons in his weekly journal 'India'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 9