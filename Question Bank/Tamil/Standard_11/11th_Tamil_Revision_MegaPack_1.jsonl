{"id": "11th_tamil_rev1_q010", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "nannool_pavanandhi_patron", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பவணந்தி முனிவர் யாருடைய வேண்டுகோளை ஏற்றுத் தமிழிலக்கண நூலான 'நன்னூல்' இயற்றினார்?", "media_id": null}], "options": {"A": "முதலாம் குலோத்துங்க சோழன்", "B": "சீயகங்கன் என்னும் சிற்றரசன்", "C": "சடையப்ப வள்ளல்", "D": "பாண்டியன் நெடுஞ்செழியன்"}, "explanation": "கங்க நாட்டுச் சிற்றரசனான 'சீயகங்கன்' கேட்டுக்கொண்டதற்கு இணங்கவே பவணந்தி முனிவர் நன்னூலை இயற்றினார் என்று சிறப்புப்பாயிரம் உரைக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "At the behest of which patron king did Pavanandhi Munivar compose the monumental grammar Nannool?", "media_id": null}], "options": {"A": "Kulothunga Chola I", "B": "King Seeyagangan of the Ganga dynasty", "C": "Patron Sadaiyappa Vallal", "D": "Pandya Nedunchezhian"}, "explanation": "Pavanandhi Munivar composed Nannool at the request of King Seeyagangan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 8, "chapter": null, "sectio