{"id": "11th_tamil_rev1_q013", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "vilvarathinam_native_island", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் சு. வில்வரத்தினம் இலங்கை யாழ்ப்பாணத்தின் எந்தத் தீவில் பிறந்தார்?", "media_id": null}], "options": {"A": "புங்குடுதீவு", "B": "காரைநகர்", "C": "நெடுந்தீவு", "D": "மன்னார்"}, "explanation": "சு. வில்வரத்தினம் யாழ்ப்பாணத்தின் புங்குடுதீவில் பிறந்தவர்; இவரது கவிதைகள் ஈழ மண்ணின் விடுதலை வேட்கையையும் தாய்மொழியின் ஆழத்தையும் பறைசாற்றுபவை."}, "en": {"blocks": [{"type": "text", "content": "On which island off Jaffna Peninsula, Sri Lanka was poet Su. Vilvarathinam born?", "media_id": null}], "options": {"A": "Pungudutivu island", "B": "Karainagar island", "C": "Neduntivu island", "D": "Mannar island"}, "explanation": "Vilvarathinam was born on the island of Pungudutivu, Jaffna."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 3", "url": null, "source_notes": null}, "pre