{"id": "11th_tamil_rev1_q104", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "pillaip_perumal_patron_thirumalai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிள்ளைப் பெருமாள் ஐயங்கார் எந்த நாயக்க மன்னரின் அரசவையில் அலுவலராகப் பணியாற்றியதாக வரலாறு கூறுகிறது?", "media_id": null}], "options": {"A": "விசுவநாத நாயக்கர்", "B": "ராணி மங்கம்மாள்", "C": "முத்துவீரப்ப நாயக்கர்", "D": "மதுரை திருமலை நாயக்கர்"}, "explanation": "பிள்ளைப் பெருமாள் ஐயங்கார் 17-ஆம் நூற்றாண்டில் மதுரை திருமலை நாயக்கர் மன்னரின் அரசவையில் முக்கியப் பொறுப்பில் பணியாற்றியவர்."}, "en": {"blocks": [{"type": "text", "content": "Under which historic Nayak ruler of Madurai did Pillai Perumal Aiyangar serve as an official during the 17th Century?", "media_id": null}], "options": {"A": "Viswanatha Nayak", "B": "Rani Mangammal", "C": "Muthuveerappa Nayak", "D": "King Thirumalai Nayak of Madurai"}, "explanation": "Pillai Perumal Aiyangar was an officer in the court of Thirumalai Nayak of Madurai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 94, "chapt