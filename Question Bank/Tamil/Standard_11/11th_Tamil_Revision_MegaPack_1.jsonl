{"id": "11th_tamil_rev1_q141", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_grammar", "chapter_id": null, "topic_id": "panbupeyar_punarchi_eeyru_pothal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கணம்: பண்புப்பெயர்ப் புணர்ச்சியில் அனைத்துப் பண்புப்பெயர்களுக்கும் பொதுவாக முதன்மையாக அமையும் விதி எது?", "media_id": null}], "options": {"A": "ஈறு போதல் (மை விகுதி நீங்குதல்)", "B": "இடையுகரம் இய்யாதல்", "C": "முன்னின்ற மெய்திரிதல்", "D": "ஆதி நீடல்"}, "explanation": "பண்புப்பெயர்ப் புணர்ச்சியில் முதலில் 'ஈறு போதல்' என்ற விதிப்படி நிலைமொழி ஈற்றில் உள்ள 'மை' விகுதி கெடுவதே முதல் விதியாகும் (எ.கா: செம்மை + ஆம்பல் = செவ்வாம்பல்)."}, "en": {"blocks": [{"type": "text", "content": "Grammar: In qualitative nominal sandhi (Panbupeyar Punarchi), which universal primary rule operates first?", "media_id": null}], "options": {"A": "Eeru Pothal (Elision of the terminal -mai formative suffix)", "B": "Idaiyugaram Iyyaathal", "C": "Munnindra Meythirithal", "D": "Aadhi Needal"}, "explanation": "Eeru Pothal elides the abstract suffix -mai before further euphonic mutations take place."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class"