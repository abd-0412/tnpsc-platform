{"id": "11th_tamil_rev1_q036", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_supp_grammar", "chapter_id": null, "topic_id": "thirukkural_samaisainthu_ani", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"சமஞ்செய்து சீர்தூக்கும் கோல்போல் அமைந்தொருபால்\nகோடாமை சான்றோர்க் கணி\" - இத்திருக்குறளில் பயின்றுவந்துள்ள அணி எது?", "media_id": null}], "options": {"A": "வேற்றுமையணி", "B": "வஞ்சப்புகழ்ச்சியணி", "C": "பிறிது மொழிதலணி", "D": "உவமையணி (தராசுக் கோல் உவமை)"}, "explanation": "தான் சமமாக இருந்து தன்மீது வைக்கப்படும் எடையைத் துல்லியமாக நிறுக்கும் தராசுக் கோல் போல, சான்றோர் எந்தப் பக்கமும் சாயாமல் நடுவுநிலைமை காக்க வேண்டும் என 'போல்' வெளிப்பட்டு வந்ததால் 'உவமையணி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What figure of speech (Ani) is deployed in 'Samancheithu Seerthookkum Kolpol Amaindhorupaal Kodaamai Saandrorkk Ani'?", "media_id": null}], "options": {"A": "Vettrumaiyani", "B": "Vanchappuhazhchiyani", "C": "Pirithu Mozhithalani", "D": "Uvamaiyani (Simile comparing an impartial sage to a balance scale)"}, "explanation": "Uvamaiyani is deployed through the explicit comparative particle 'pol' invoking the balance beam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nad