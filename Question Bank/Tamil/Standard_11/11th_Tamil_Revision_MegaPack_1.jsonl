{"id": "11th_tamil_rev1_q144", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_grammar", "chapter_id": null, "topic_id": "panbupeyar_munnindra_meythirithal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"முன்னின்ற மெய்திரிதல்\" என்ற விதியின்படி புணர்ந்த சொல் எது?", "media_id": null}], "options": {"A": "பைங்கூழ்", "B": "பெரியன்", "C": "வெட்டவெளி", "D": "செந்தமிழ் (செம்மை + தமிழ் -> செம் + தமிழ் -> செந் + தமிழ்)"}, "explanation": "செம்மை + தமிழ் -> ஈறுபோதல் படி 'செம் + தமிழ்' என்றாகி, வருமொழி வல்லினத் தகரத்திற்கு ஏற்ப 'ம்' என்பது 'ந்' எனத் திரிந்தது."}, "en": {"blocks": [{"type": "text", "content": "Which compound is formed pursuant to the Panbupeyar rule 'Munnindra Meythirithal' (mutation of the standing nasal consonant)?", "media_id": null}], "options": {"A": "Paingoozh", "B": "Periyan", "C": "Vettaveli", "D": "Senthamizh (Semmai + Thamizh -> Sem + Thamizh -> Sen + Thamizh)"}, "explanation": "Senthamizh illustrates mutation of standing nasal 'm' to homorganic nasal 'n'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 74, "chapter": null, "section": null, "refe