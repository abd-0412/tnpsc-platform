{"id": "11th_tamil_rev1_q109", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "seerapuranam_prophet_grandparent", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சீறாப்பூராணத்தில் நபிகள் நாயகத்தின் பெற்றோர்கள் மற்றும் பாட்டனார் பெயர்களாகக் குறிப்பிடப்படுபவை எவை?", "media_id": null}], "options": {"A": "தந்தை அப்துல்லாஹ், தாய் ஆமினா, பாட்டனார் அப்துல் முத்தலிப்", "B": "தந்தை உமர், தாய் பாத்திமா, பாட்டனார் அலி", "C": "தந்தை இப்ராஹிம், தாய் கதீஜா, பாட்டனார் உஸ்மான்", "D": "தந்தை மூசா, தாய் மரியம், பாட்டனார் தாவூது"}, "explanation": "நபிகள் நாயகத்தின் தந்தை அப்துல்லாஹ், தாய் ஆமினா அம்மையார்; அவரைப் பேணி வளர்த்த பாட்டனார் அப்துல் முத்தலிப் ஆவர்."}, "en": {"blocks": [{"type": "text", "content": "In Seerapuranam, who are recorded as the noble parents and grandfather of Prophet Muhammad?", "media_id": null}], "options": {"A": "Father Abdullah, Mother Aminah, Grandfather Abdul Muttalib", "B": "Father Umar, Mother Fathima, Grandfather Ali", "C": "Father Ibrahim, Mother Khadija, Grandfather Uthman", "D": "Father Musa, Mother Maryam, Grandfather Dawood"}, "explanation": "The Prophet's parents were Abdullah and Aminah; his grandfather was Abdul Muttalib."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "b