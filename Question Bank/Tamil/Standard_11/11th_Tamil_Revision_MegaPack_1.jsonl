{"id": "11th_tamil_rev1_q195", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_pyq_model", "chapter_id": null, "topic_id": "pyq_seerapuranam_umariya_title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] உமறுப்புலவர் சீறாப்பூராணம் தவிர்த்து இயற்றிய பிற சிற்றிலக்கிய நூல்கள் எவை?", "media_id": null}], "options": {"A": "திருப்புகழ், கந்தர் அந்தாதி", "B": "கலிங்கத்துப் பரணி, தக்கயாகப்பரணி", "C": "முதுமொழி மாலை மற்றும் சீதக்காதி திருமண வாழ்த்து", "D": "குற்றாலக் குறவஞ்சி"}, "explanation": "உமறுப்புலவர் நபிகள் நாயகத்தின் பொன்மொழிகளைத் தொகுத்து 'முதுமொழி மாலை' (80 பாடல்கள்) மற்றும் தம் புரவலரான வள்ளல் சீதக்காதிக்குத் 'திருமண வாழ்த்து' ஆகிய நூல்களையும் இயற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Besides the epic Seerapuranam, which classical minor works were authored by Umaru Pulavar?", "media_id": null}], "options": {"A": "Thiruppugazh and Kandar Anthathi", "B": "Kalingathup Bharani and Thakkayagap Bharani", "C": "Muthumozhi Maalai and Seethakkathi Thirumana Vaazhthu", "D": "Kuttralak Kuravanji"}, "explanation": "Umaru Pulavar authored Muthumozhi Maalai (80 stanzas) and Seethakkathi Thirumana Vaazhthu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publis