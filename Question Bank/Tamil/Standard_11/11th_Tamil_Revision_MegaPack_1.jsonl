{"id": "11th_tamil_rev1_q003", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "nannool_paayiram_types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பவணந்தி முனிவரின் நன்னூல் பாயிரவியல் விளக்கப்படி, 'பாயிரம்' எத்தனை பெரும் பிரிவுகளாகப் பிரிக்கப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "நான்கு", "B": "மூன்று", "C": "இரண்டு (பொதுப்பாயிரம் மற்றும் சிறப்புப்பாயிரம்)", "D": "ஐந்து"}, "explanation": "பாயிரம் இருவகைப்படும்; அவை பொதுப்பாயிரம் (நூல், ஆசிரியர், கற்பிக்கும் முறை, கற்கும் முறை) மற்றும் சிறப்புப்பாயிரம் (ஆசிரியர் பெயர், நூல் வழி, எல்லை, பயன் போன்றவை) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "According to Pavanandhi Munivar's Nannool, into how many primary divisions is the 'Paayiram' (Preface) classified?", "media_id": null}], "options": {"A": "Four", "B": "Three", "C": "Two (Pothup-paayiram and Sirappup-paayiram)", "D": "Five"}, "explanation": "Paayiram is bifurcated into General Preface (Pothup-paayiram) and Special Preface (Sirappup-paayiram)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 7, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 7", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 1", "Poetry", "Nannool"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev1_q004", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "organic_farming_nammalvar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல் 2 உரைநடையில் தமிழகத்தில் இயற்கை வேளாண்மையை மக்கள் இயக்கமாக முன்னெடுத்து 'இயற்கை வேளாண்மைப் பேரறிஞர்' எனப் போற்றப்பட்ட சான்றோர் யார்?", "media_id": null}], "options": {"A": "எம். எஸ். சுவாமிநாதன்", "B": "சுந்தர்லால் பகுகுணா", "C": "மேத்தா பட்கர்", "D": "கோ. நம்மாழ்வார்"}, "explanation": "வேதி உரங்களையும் பூச்சிக்கொல்லிகளையும் தவிர்த்து, பாரம்பரிய இயற்கை வேளாண்மை முறைகளை மீட்டெடுத்த வேளாண் விஞ்ஞானி கோ. நம்மாழ்வார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who pioneered organic agriculture as a grassroots mass crusade across Tamil Nadu, celebrated as 'Iyarkai Velaanmai Perarignar'?", "media_id": null}], "options": {"A": "M. S. Swaminathan", "B": "Sunderlal Bahuguna", "C": "Medha Patkar", "D": "G. Nammalvar"}, "explanation": "G. Nammalvar championed zero-chemical ecological natural farming."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 27", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 1", "Prose", "Nammalvar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev1_q005", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "aingurunooru_structure", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஐங்குறுநூறு பற்றிய குறிப்புகளில் சரியான ஒன்றைத் தேர்ந்தெடுக்க:\n(1) மூன்று அடி முதல் ஆறு அடி வரையிலான சிற்றெல்லை பேரெல்லை கொண்டது\n(2) ஐந்து திணைகளுக்கும் தலா நூறு பாடல்கள் வீதம் ஐந்நூறு அகவற்பாக்கள் கொண்டது\n(3) மருதத் திணையைப் பாடியவர் கபிலர்", "media_id": null}], "options": {"A": "1 மற்றும் 2 சரி; 3 தவறு (மருதம் பாடியவர் ஓரம்போகியார்)", "B": "1, 2, 3 ஆகிய அனைத்தும் சரி", "C": "1 மட்டுமே சரி", "D": "2 மற்றும் 3 சரி"}, "explanation": "ஐங்குறுநூற்றில் மருதம் பாடியவர் ஓரம்போகியார்; குறிஞ்சி பாடியவரே கபிலர் ஆவார். மற்ற இரண்டு கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Select the TRUE statement regarding the classical Sangam anthology Aingurunooru:\n(1) Metrical range is 3 to 6 lines\n(2) Contains 500 Agaval poems across 5 landscapes (100 each)\n(3) Marutham was composed by Kapilar", "media_id": null}], "options": {"A": "1 and 2 are true; 3 is false (Marutham was sung by Orambogiyar)", "B": "All 1, 2, and 3 are true", "C": "1 only is true", "D": "2 and 3 are true"}, "explanation": "Marutham tinai was composed by Orambogiyar, whereas Kapilar sang Kurinchi tinai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false,