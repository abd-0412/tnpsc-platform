{"id": "11th_tamil_rev1_q071", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "balakrishnan_dravidian_words_north", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிந்து சமவெளிப் பகுதிகளில் காணப்படும் மலைகளுக்குத் திராவிடப் பெயர்களான 'கோட்டை', 'மலை' ஆகிய பெயர்கள் இன்றும் எங்கு அதிகமாகக் காணப்படுகின்றன?", "media_id": null}], "options": {"A": "இலங்கையில்", "B": "வங்காளத்தில்", "C": "பாகிஸ்தானின் பலுசிஸ்தான் மற்றும் ஆப்கானிஸ்தான் மலைப்பகுதிகளில்", "D": "நேபாளத்தில்"}, "explanation": "பலுசிஸ்தானில் பேசப்படும் 'பிராகுயி' (Brahui) மொழி திராவிட மொழிக் குடும்பத்தைச் சார்ந்தது; அப்பகுதியின் மலைகளுக்கும் கோட்டை, மலை போன்ற பெயர்கள் உள்ளன."}, "en": {"blocks": [{"type": "text", "content": "In which northwestern mountainous regions do Dravidian toponymic suffixes like 'Kottai' and 'Malai' proliferate today?", "media_id": null}], "options": {"A": "In Sri Lanka", "B": "In Bengal", "C": "In Balochistan (Pakistan) and Afghanistan highlands", "D": "In Nepal"}, "explanation": "Dravidian place-name morphemes persist heavily in Balochistan, where Brahui is still spoken."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Servi