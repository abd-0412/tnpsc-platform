{"id": "11th_tamil_rev1_q115", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_supp_grammar", "chapter_id": null, "topic_id": "chellappa_ezhuthu_magazine", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சி. சு. செல்லப்பா தமிழில் புதுக்கவிதை இயக்கத்திற்கும் நவீன இலக்கிய விமர்சனத்திற்கும் களம் அமைத்துக் கொடுத்த எந்தப் புகழ்பெற்ற இதழை நடத்தினார்?", "media_id": null}], "options": {"A": "மணிக்கொடி", "B": "தீபம்", "C": "எழுத்து (Ezhuthu - 1959)", "D": "கணையாழி"}, "explanation": "1959-ல் சி. சு. செல்லப்பாவால் தொடங்கப்பட்ட 'எழுத்து' இதழ் நவீன தமிழ்ப் புதுக்கவிதை மறுமலர்ச்சிக்கும் தீவிர இலக்கிய விமர்சனத்திற்கும் முன்னோடியாகத் திகழ்ந்தது."}, "en": {"blocks": [{"type": "text", "content": "Which avant-garde journal founded by C. S. Chellappa in 1959 spearheaded the modern Tamil poetry renaissance and rigorous literary criticism?", "media_id": null}], "options": {"A": "Manikkodi", "B": "Deepam", "C": "Ezhuthu (1959)", "D": "Kanaiyaazhi"}, "explanation": "C. S. Chellappa founded and edited the historic literary journal 'Ezhuthu'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "pa