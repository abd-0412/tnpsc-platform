{"id": "11th_tamil_rev1_q119", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_supp_grammar", "chapter_id": null, "topic_id": "thirukkural_adakkamudaimai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"அடக்கம் அமரருள் உய்க்கும் அடங்காமை\nஆரிருள் உய்த்து விடும்\" - இத்திருக்குறளின்படி ஒருவனைத் தேவர்களுள் கொண்டு சேர்க்கும் நற்பண்பு எது?", "media_id": null}], "options": {"A": "வீரம்", "B": "செல்வம்", "C": "புலனடக்கம் / அடக்கமுடைமை", "D": "அழகு"}, "explanation": "மன அடக்கமும் நாவடக்கமும் ஒருவனைத் தேவர் நிலைக்கு உயர்த்தும்; அடக்கமில்லாத செருக்கு அவனை நரக இருளில் வீழ்த்திவிடும்."}, "en": {"blocks": [{"type": "text", "content": "In the Kural 'Adakkam Amararul Uykkum Adangaamai Aarirul Uyithu Vidum', what virtue elevates a mortal to divine status?", "media_id": null}], "options": {"A": "Physical valour", "B": "Material wealth", "C": "Self-restraint and humility (Adakkam)", "D": "Physical beauty"}, "explanation": "Self-control and humility exalt man to the celestial realms."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 78, "chapter": null, "section": null, "refer