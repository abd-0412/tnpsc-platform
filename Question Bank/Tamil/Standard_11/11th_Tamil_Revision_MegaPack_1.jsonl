{"id": "11th_tamil_rev1_q142", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_grammar", "chapter_id": null, "topic_id": "panbupeyar_aathi_needal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"ஆதி நீடல்\" என்ற பண்புப்பெயர்ப் புணர்ச்சி விதிக்குப் பொருத்தமான சொல் எது?", "media_id": null}], "options": {"A": "பெருங்கொடை", "B": "மூதூர் (முதுமை + ஊர் -> ஈறுபோதல், ஆதி நீடல் மூலம் 'மு' என்பது 'மூ' ஆனது)", "C": "நல்லாடை", "D": "வெண்சங்கு"}, "explanation": "முதுமை + ஊர் = முது + ஊர் (ஈறுபோதல்) -> மூது + ஊர் (ஆதி நீடல்) -> மூதூர் (உயிர்வரின் உக்குறள் மெய்விட்டோடும்)."}, "en": {"blocks": [{"type": "text", "content": "Which compound exemplifies the Panbupeyar rule 'Aadhi Needal' (lengthening of the initial root vowel)?", "media_id": null}], "options": {"A": "Perunkodai", "B": "Moodhoor (Muthumai + oor: muthu becomes moothu via Aadhi Needal)", "C": "Nallaadai", "D": "Vensangu"}, "explanation": "Moodhoor exemplifies initial vowel lengthening (mu to moo) under Aadhi Needal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 74, "chapter": null, "section": null, "reference": "11