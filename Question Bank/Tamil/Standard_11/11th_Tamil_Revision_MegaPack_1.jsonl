{"id": "11th_tamil_rev1_q098", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "india_newspaper_red_paper", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியார் நடத்திய 'இந்தியா' வார இதழ் எந்த வண்ணத் தாளில் (Paper) அச்சிடப்பட்டு புரட்சியின் அடையாளமாகப் புகழ்பெற்றது?", "media_id": null}], "options": {"A": "பச்சை வண்ணத் தாள்", "B": "சிவப்பு வண்ணத் தாள் (Red paper)", "C": "மஞ்சள் வண்ணத் தாள்", "D": "வெள்ளை வண்ணத் தாள்"}, "explanation": "இந்தியா இதழ் பிரெஞ்சுப் புரட்சியின் உத்வேகத்தில் புரட்சியைக் குறிக்கும் வகையில் 'சிவப்புத் தாளில்' அச்சிடப்பட்டு வெளிவந்தது."}, "en": {"blocks": [{"type": "text", "content": "On what color newsprint was Bharati's revolutionary weekly 'India' printed to symbolize radical liberty?", "media_id": null}], "options": {"A": "Green newsprint", "B": "Red newsprint", "C": "Yellow newsprint", "D": "White newsprint"}, "explanation": "The journal 'India' was uniquely printed on red paper as an emblem of revolution."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 97, "chapter": null, "section":