{"id": "11th_tamil_rev1_q163", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_grammar", "chapter_id": null, "topic_id": "panbupeyar_idaiyugaram_iyyathal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"இடையுகரம் இய்யாதல்\" என்ற விதியினால் புணரும் பண்புப்பெயருக்குச் சரியான எடுத்துக்காட்டு எது?", "media_id": null}], "options": {"A": "செந்தாமரை", "B": "கருங்குதிரை", "C": "பெரியன் (பெரியர்) - பெருமை + அன் -> பெரு + அன் -> பெரி + அன் -> பெரியன்", "D": "வெள்ளிடை"}, "explanation": "பெருமை + அன் = ஈறுபோதல் படி 'பெரு + அன்' ஆகி, 'இடையுகரம் இய்யாதல்' விதியால் 'ரு'வில் உள்ள 'உ'கரம் 'இ'கரமாக மாறி 'பெரி + அன்' ஆகிப் 'பெரியன்' எனப் புணர்ந்தது."}, "en": {"blocks": [{"type": "text", "content": "Which compound operates under the Panbupeyar rule 'Idaiyugaram Iyyaathal' (mutation of medial u to i)?", "media_id": null}], "options": {"A": "Senthaamarai", "B": "Karunkuthirai", "C": "Periyan (Perumai + an -> Peru + an -> Peri + an -> Periyan)", "D": "Vellidai"}, "explanation": "Periyan exemplifies mutation of medial 'u' to 'i' (peru to peri-)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025",