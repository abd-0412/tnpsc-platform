{"id": "11th_tamil_rev1_q095", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "seerapuranam_tamil_culture_blend", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அரேபியப் பாலைவனத்தில் நிகழ்ந்த நபிகள் நாயகத்தின் வரலாற்றை உமறுப்புலவர் சீறாப்பூராணத்தில் எவ்வகைத் தமிழ்ப் பின்னணியோடு அழகுறப் பாடியுள்ளார்?", "media_id": null}], "options": {"A": "மேலைநாட்டுப் பின்னணியில்", "B": "வடநாட்டுப் பின்னணியில்", "C": "தமிழ்நாட்டின் வளம் கொழிக்கும் ஆற்று வளம், வயல்வளம் (மருத நில எழில்) மற்றும் தமிழ்ப் பண்பாட்டு மரபோடு பொருத்தி", "D": "கடற்கரை நாகரிகமாக மட்டுமே"}, "explanation": "மதினா நகரைக் காப்பியத்தில் வர்ணிக்கும் உமறுப்புலவர், தமிழ்நாட்டின் காவிரிப் படுகை வயல்கள், குளங்கள், தாமரை மலர்கள் சூழ்ந்த வளமிக்கத் தமிழ்நாட்டு நகரமாகவே உருவகித்துப் பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "How did Umaru Pulavar uniquely contextualize the Arabian landscape of Prophet Muhammad within Seerapuranam?", "media_id": null}], "options": {"A": "Through European settings", "B": "Through Himalayan scenery", "C": "Transposing lush Tamil agrarian landscapes (Marutham wetlands, lotuses, rivers) and indigenous Tamil metaphors", "D": "Exclusively as sterile maritime coasts"}, "explanation": "Umaru Pulavar indigenized the Arabian narrative, dressing Medina in the lush flora and cultural aesthetics of Tamil Nadu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 92, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 92", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 1", "Poetry", "Seerapuranam"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev1_q096", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "bharathi_sub-editor_swadesamitran", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியார் 1904-ல் முதன்முதலில் சுதேசமித்திரன் இதழில் உதவி ஆசிரியராக இணைந்தபோது, அதன் முதன்மை ஆசிரியராக விளங்கிய தமிழறிஞர் யார்?", "media_id": null}], "options": {"A": "வ. உ. சி.", "B": "சுப்பிரமணிய சிவா", "C": "திரு. வி. க.", "D": "ஜி. சுப்பிரமணிய ஐயர்"}, "explanation": "'தி இந்து' மற்றும் 'சுதேசமித்திரன்' இதழ்களின் நிறுவனரான ஜி. சுப்பிரமணிய ஐயர் பாரதியின் எழுத்தாற்றலைக் கண்டு வியந்து அவருக்கு சுதேசமித்திரனில் வாய்ப்பளித்தார்."}, "en": {"blocks": [{"type": "text", "content": "Who was the visionary editor of Swadesamitran when Bharati joined as assistant editor in 1904?", "media_id": null}], "options": {"A": "V. O. Chidambaranar", "B": "Subramania Siva", "C": "Thiru. Vi. Ka.", "D": "G. Subramania Iyer"}, "explanation": "G. Subramania Iyer mentored Bharati as sub-editor at Swadesamitran in 1904."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 96, "chapter"