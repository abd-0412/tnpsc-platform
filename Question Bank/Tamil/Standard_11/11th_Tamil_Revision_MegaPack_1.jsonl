{"id": "11th_tamil_rev1_q034", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_supp_grammar", "chapter_id": null, "topic_id": "ina_ezhuthukkal_concept", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கணம்: ஒலிக்கும் முயற்சி மற்றும் பிறக்கும் இடம் ஆகியவற்றில் ஒத்த தன்மை கொண்ட எழுத்துகள் எவ்வாறு அழைக்கப்படுகின்றன?", "media_id": null}], "options": {"A": "சுட்டெழுத்துகள்", "B": "இன எழுத்துகள் (நட்பெழுத்துகள் / Cognate letters)", "C": "வினா எழுத்துகள்", "D": "போலி எழுத்துகள்"}, "explanation": "பிறக்கும் இடமும் ஒலிக்கும் முயற்சியும் ஒன்றாக இருக்கும் எழுத்துகள் 'இன எழுத்துகள்' எனப்படும்; வல்லினத்திற்கு மெல்லினம் இனமாகும் (க் - ங், ச் - ஞ் போன்றவை)."}, "en": {"blocks": [{"type": "text", "content": "Grammar: Letters sharing identical places of articulation and articulatory effort are classified as:", "media_id": null}], "options": {"A": "Demonstrative letters", "B": "Cognate / Friendly letters (Ina Ezhuthukkal)", "C": "Interrogative letters", "D": "Allographic letters"}, "explanation": "Ina Ezhuthukkal are phonetically paired cognate characters matching plosives with corresponding nasals."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 17, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 17", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 1", "Grammar", "Phonetics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev1_q035", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_supp_grammar", "chapter_id": null, "topic_id": "thirukkural_naduvunilaimai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"தக்கார் தகவிலர் என்பது அவரவர்\nஎச்சத்தால் காணப் படும்\" - இத்திருக்குறளில் 'எச்சம்' என்பது எதனைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "பணம்", "B": "பாவம்", "C": "ஒருவர் மறைந்த பிறகும் உலகில் எஞ்சி நிற்கும் அவர்தம் புகழ் அல்லது பழி (அவர்தம் வழித்தோன்றல்களின் நற்பெயர்)", "D": "ஆடை"}, "explanation": "ஒருவர் நடுவுநிலைமை உடையவரா இல்லையா என்பது அவர் மறைந்த பிறகு உலகில் எஞ்சி நிற்கும் புகழினாலும் பழியினாலும் அவரது வழித்தோன்றல்களாலும் அறியப்படும்."}, "en": {"blocks": [{"type": "text", "content": "In the Kural 'Thakkaar Thagavilar Enpathu Avaravar Echaththaal Kaanap Padum', what does 'Echam' represent?", "media_id": null}], "options": {"A": "Bank balance", "B": "Sin", "C": "The enduring legacy of fame or infamy (and lineage) left behind after death", "D": "Attire"}, "explanation": "'Echam' denotes the surviving reputational legacy, praise or blame, that endures after one's demise."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Cor