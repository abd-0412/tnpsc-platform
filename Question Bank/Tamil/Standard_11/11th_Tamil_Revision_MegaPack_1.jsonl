{"id": "11th_tamil_rev1_q063", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "purananuru_noble_virtues_list", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கடலுள் மாய்ந்த இளம்பெருவழுதியின் புறநானூற்றுப் பாடலின்படி, சான்றோர்கள் எதற்காகத் தம் உயிரையும் கொடுப்பார்கள்? எதனை உலகமே கிடைத்தாலும் செய்ய மாட்டார்கள்?", "media_id": null}], "options": {"A": "பணத்திற்காக உயிரைக் கொடுப்பர்; போரை ஏற்க மாட்டார்", "B": "அரசனின் புகழுக்காக உயிரைக் கொடுப்பர்", "C": "புகழ் வருமென்றால் தம் உயிரையும் கொடுப்பர்; பழி வருமென்றால் உலகம் முழுவதும் பரிசாகக் கிடைத்தாலும் ஏற்க மாட்டார்", "D": "நாட்டிற்காக உயிரைக் கொடுப்பர்"}, "explanation": "\"புகழெனின் உயிரும் கொடுக்குவர், பழியெனின் உலகுடன் பெறினும் கொள்ளலர்\" என்று சான்றோரின் உயர்ந்த அறநெறியைப் புறநானூறு பறைசாற்றுகிறது."}, "en": {"blocks": [{"type": "text", "content": "According to Ilamperuvazhuthi's Puram verse, for what will noble souls sacrifice life, and what will they spurn even if gifted the entire cosmos?", "media_id": null}], "options": {"A": "Sacrifice for gold; spurn warfare", "B": "Sacrifice for monarch flattery", "C": "Surrender life for honor and virtue; spurn disgraceful dishonor even if offered the universe", "D": "Sacrifice exclusively for land"}, "explanation": "Noble souls gladly offer life for righteousness (Pugazh) but reject infamy (Pazhi) even for worldly dominion."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 61, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 61", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 1", "Poetry", "Purananuru"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev1_q064", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "charter_act_1813_education", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிரிட்டிஷ் கிழக்கிந்தியக் கம்பெனி இந்தியாவில் கல்வி வளர்ச்சிக்காக ஆண்டுக்கு ஒரு இலட்சம் ரூபாய் ஒதுக்கீடு செய்த வரலாற்றுச் சாசனம் எது?", "media_id": null}], "options": {"A": "1857 சாசனம்", "B": "1835 மெக்காலே குறிப்பு", "C": "1854 வுட்ஸ் அறிக்கை", "D": "1813-ஆம் ஆண்டின் பட்டயச் சட்டம் (Charter Act of 1813)"}, "explanation": "1813-ஆம் ஆண்டின் பட்டயச் சட்டம் (Charter Act 1813) இந்திய மக்களின் கல்வி வளர்ச்சிக்காக முதன்முதலில் ஆண்டுதோறும் ரூ. 1 இலட்சம் நிதி ஒதுக்கீடு செய்தது."}, "en": {"blocks": [{"type": "text", "content": "Which British enactment first officially sanctioned an annual budget of one lakh rupees for Indian native education?", "media_id": null}], "options": {"A": "Charter Act of 1857", "B": "Macaulay Minute of 1835", "C": "Wood Despatch of 1854", "D": "Charter Act of 1813"}, "explanation": "The Charter Act of 1813 earmarked 1 lakh rupees annually for native education in India."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporatio