{"id": "11th_tamil_rev1_q089", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "bharathi_journalist_journals", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மகாகவி சுப்பிரமணிய பாரதியார் ஆசிரியராகவும் துணை ஆசிரியராகவும் இருந்து நடத்திய புகழ்பெற்ற இதழ்கள் எவை?", "media_id": null}], "options": {"A": "சுதேசமித்திரன், இந்தியா, சக்கரவர்த்தினி, விஜயா, பாலபாரதி, கர்மயோகி", "B": "மணிக்கொடி, எழுத்து, கணையாழி", "C": "தாமரை, குயில்", "D": "முரசொலி, துக்ளக்"}, "explanation": "பாரதி சுதேசமித்திரனில் துணை ஆசிரியராகத் தொடங்கி, இந்தியா, சக்கரவர்த்தினி (பெண்கள் இதழ்), விஜயா, பாலபாரதி முதலான பல விடுதலைப் போராட்ட இதழ்களை நடத்தினார்."}, "en": {"blocks": [{"type": "text", "content": "Which renowned patriotic journals were edited or co-edited by Mahakavi Subramania Bharati?", "media_id": null}], "options": {"A": "Swadesamitran, India, Chakravarthini, Vijaya, Bala Bharathi, Karmayogi", "B": "Manikkodi, Ezhuthu, Kanaiyaazhi", "C": "Thamarai, Kuyil", "D": "Murasoli, Thuglak"}, "explanation": "Bharati steered Swadesamitran, India, Chakravarthini, Vijaya, and Karmayogi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Cor