{"id": "11th_tamil_rev1_q103", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "bharathi_editorial_creed", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியார் தம்முடைய இதழியல் பணிகளில் கடைப்பிடித்த தலையாய நெறி யாது?", "media_id": null}], "options": {"A": "ஆங்கில அரசைப் புகழ்ந்து எழுதுதல்", "B": "வணிக விளம்பரங்களுக்கு முன்னுரிமை அளித்தல்", "C": "எளிய எவரும் புரிந்துகொள்ளக்கூடிய தெளிவான தமிழ் உரைநடை மற்றும் அஞ்சாத தேசபக்தி உண்மை முழக்கம்", "D": "வடமொழிச் சொற்களை மிகுதியாகப் பெய்தல்"}, "explanation": "கடினமான பண்டித நடையை விடுத்து, பாமர மக்களுக்கும் புரியும் எளிய உரைநடையில் அரசியல் கருத்துகளைத் துணிவுடன் வெளியிட்டதே பாரதியின் இதழியல் சாதனையாகும்."}, "en": {"blocks": [{"type": "text", "content": "What foundational journalistic creed guided Bharati throughout his editorial career?", "media_id": null}], "options": {"A": "Praising the British administration", "B": "Prioritizing commercial advertisements", "C": "Fearless patriotic truth articulated in lucid accessible Tamil prose understandable to common folk", "D": "Inundating prose with archaic loanwords"}, "explanation": "Bharati democratized Tamil journalism with fearless patriotism and accessible everyday prose."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "sour