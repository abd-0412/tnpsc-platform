{"id": "11th_tamil_rev1_q107", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "anthathi_meter_pillaip", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'திருவரங்கத்து அந்தாதி' நூலில் கையாளப்பட்டுள்ள 'அந்தாதித் தொடை' என்பதன் யாப்பிலக்கண விளக்கம் யாது?", "media_id": null}], "options": {"A": "பாடலின் முதல் எழுத்து ஒன்றி வருவது", "B": "இரண்டாம் எழுத்து ஒன்றி வருவது", "C": "ஒரு பாடலின் இறுதிச் சொல், சீர் அல்லது அசை அடுத்த பாடலின் தொடக்கமாக வருவது", "D": "கடைசி எழுத்து மாறுபடுவது"}, "explanation": "அந்தம் (முடிவு) அடுத்த பாடலின் ஆதியாகத் (தொடக்கமாகத்) தொடரும் தொடர்தொடை அமைப்பே 'அந்தாதி' எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What metrical device characterizes the 'Anthathi Thodai' deployed in Thiruvarangathu Anthathi?", "media_id": null}], "options": {"A": "First foot alliteration", "B": "Second letter rhyme", "C": "The concluding word, foot, or syllable of a verse commencing the subsequent stanza", "D": "Varying final letters"}, "explanation": "Anthathi links stanzas anadiplosis-style where the ending of one stanza begins the next."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Service