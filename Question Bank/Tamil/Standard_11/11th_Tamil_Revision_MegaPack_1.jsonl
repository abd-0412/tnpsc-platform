{"id": "11th_tamil_rev1_q018", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "nammalvar_awards_doctorate", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வேளாண் பேரறிஞர் நம்மாழ்வாருக்கு மதிப்புறு முனைவர் (Doctor of Science) பட்டம் வழங்கிச் சிறப்பித்த புகழ்பெற்ற தமிழகப் பல்கலைக்கழகம் எது?", "media_id": null}], "options": {"A": "அண்ணா பல்கலைக்கழகம்", "B": "திண்டுக்கல் காந்திகிராம கிராமியப் பல்கலைக்கழகம் (2007)", "C": "சென்னை பல்கலைக்கழகம்", "D": "மதுரை காமராசர் பல்கலைக்கழகம்"}, "explanation": "2007-ஆம் ஆண்டு காந்திகிராம கிராமியப் பல்கலைக்கழகம் நம்மாழ்வாரின் வாழ்நாள் இயற்கை வேளாண் தொண்டைப் பாராட்டி முனைவர் பட்டம் வழங்கியது."}, "en": {"blocks": [{"type": "text", "content": "Which prestigious Tamil Nadu university conferred an Honorary Doctorate upon G. Nammalvar in 2007?", "media_id": null}], "options": {"A": "Anna University", "B": "Gandhigram Rural Institute, Dindigul (in 2007)", "C": "University of Madras", "D": "Madurai Kamaraj University"}, "explanation": "Gandhigram Rural Institute honored Nammalvar with an Honorary Doctorate in 2007."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpora