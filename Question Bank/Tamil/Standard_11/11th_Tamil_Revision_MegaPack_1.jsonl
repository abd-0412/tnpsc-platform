{"id": "11th_tamil_rev1_q097", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "seerapuranam_meaning_of_title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'சீறா' என்னும் அரபுச் சொல்லின் சரியான பொருள் யாது?", "media_id": null}], "options": {"A": "வரலாறு அல்லது வாழ்க்கை முறை (Biography / Life journey)", "B": "அரண்மனை", "C": "போர்க்களம்", "D": "மகுடம்"}, "explanation": "'சீறா' என்பது 'சீரத்' (Seerah) என்ற அரபுச் சொல்லின் தமிழ் வடிவம்; இதற்கு 'வரலாறு' அல்லது 'வாழ்க்கைப் பயணம்' என்பது பொருளாகும். சீறா + புராணம் = நபிகள் நாயகத்தின் புனித வரலாறு."}, "en": {"blocks": [{"type": "text", "content": "What does the Arabic root word 'Seera' (from Seerat) in Seerapuranam literally denote?", "media_id": null}], "options": {"A": "Biography / Sacred life history (Seerat)", "B": "Imperial Palace", "C": "Martial Battlefield", "D": "Golden Crown"}, "explanation": "'Seerah' in Arabic signifies life trajectory or biography."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 92, "chapter": null, "section": null, "reference": "11th T