{"id": "11th_tamil_rev1_q033", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_supp_grammar", "chapter_id": null, "topic_id": "elephant_doctor_glass_bottles", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'யானை டாக்டர்' கதையில் காடுகளில் சுற்றுலாப் பயணிகள் வீசி எறியும் எப்பொருளினால் காட்டு யானைகள் பாதங்களில் புண் ஏற்பட்டுப் பரிதாபமாக உயிரிழக்கின்றன?", "media_id": null}], "options": {"A": "உடைந்த மது பாட்டில்கள் (கண்ணாடித் துண்டுகள்)", "B": "பிளாஸ்டிக் பைகள்", "C": "இரும்புக் கம்பிகள்", "D": "மரக் கட்டைகள்"}, "explanation": "மனிதர்கள் குடிபோதையில் வீசியெறியும் உடைந்த கண்ணாடி பாட்டில்கள் யானைகளின் மென்மையான பாதங்களில் குத்திச் சீழ்பிடித்து, காட்டின் மாபெரும் உயிரினங்கள் மடிகின்றன என்று டாக்டர் கே கதறுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "In Jeyamohan's story, which callous refuse discarded by careless tourists causes agonizing fatal foot injuries to wild elephants?", "media_id": null}], "options": {"A": "Broken liquor glass bottles", "B": "Plastic wraps", "C": "Iron barbed wires", "D": "Wooden logs"}, "explanation": "Shattered glass bottles discarded by tourists lodge deep into elephant feet, triggering sepsis and death."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher