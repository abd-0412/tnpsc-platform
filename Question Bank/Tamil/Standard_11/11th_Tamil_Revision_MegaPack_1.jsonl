{"id": "11th_tamil_rev1_q106", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "bharathi_india_warrant_pondicherry", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிரிட்டிஷ் அரசு 'இந்தியா' இதழின் வெளியீட்டாளரான சீனிவாசனைக் கைதுசெய்து பாரதிக்கும் பிடியாணை பிறப்பித்ததால், பாரதி எங்கு தப்பிச் சென்று இதழைத் தொடர்ந்தார்?", "media_id": null}], "options": {"A": "இலங்கைக்கு", "B": "பிரெஞ்சு ஆளுகைக்குட்பட்ட புதுச்சேரிக்கு (1908)", "C": "லண்டனுக்கு", "D": "மலேசியாவுக்கு"}, "explanation": "1908-ல் ஆங்கில அரசின் கைது நடவடிக்கைக்கு அஞ்சாமல் பாரதியார் புதுச்சேரிக்குச் சென்று அங்கிருந்து 'இந்தியா' மற்றும் 'விஜயா' இதழ்களைத் தடையின்றி நடத்தினார்."}, "en": {"blocks": [{"type": "text", "content": "When British authorities issued arrest warrants against Bharati in 1908, to which French enclave did he relocate to resume printing 'India'?", "media_id": null}], "options": {"A": "To Sri Lanka", "B": "To French Pondicherry (in 1908)", "C": "To London", "D": "To Malaysia"}, "explanation": "Bharati exiled himself to French Pondicherry in 1908, continuing publications defiantly."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational