{"id": "11th_tamil_rev1_q087", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "seerapuranam_kandams", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சீறாப்பூராணம் எத்தனை காண்டங்களையும் எத்தனை விருத்தப் பாடல்களையும் கொண்டு அமைந்துள்ளது?", "media_id": null}], "options": {"A": "இரண்டு காண்டங்கள், 3000 பாடல்கள்", "B": "ஐந்து காண்டங்கள், 4500 பாடல்கள்", "C": "மூன்று காண்டங்கள் (விலாதத்துக் காண்டம், நுபுவ்வத்துக் காண்டம், ஹிஜ்ரத்துக் காண்டம்), 5,027 விருத்தப் பாடல்கள்", "D": "ஆறு காண்டங்கள், 6000 பாடல்கள்"}, "explanation": "சீறாப்பூராணம் விலாதத்துக் காண்டம் (பிறப்பு), நுபுவ்வத்துக் காண்டம் (தீர்க்கதரிசனம்), ஹிஜ்ரத்துக் காண்டம் (மதினா பயணம்) என 3 காண்டங்களையும், 5,027 பாடல்களையும் கொண்டது."}, "en": {"blocks": [{"type": "text", "content": "How many Kandams (Books) and virutham stanzas constitute Umaru Pulavar's Seerapuranam?", "media_id": null}], "options": {"A": "Two Kandams and 3,000 stanzas", "B": "Five Kandams and 4,500 stanzas", "C": "Three Kandams (Vilathathu, Nubuwwathu, Hijrathu) and 5,027 stanzas", "D": "Six Kandams and 6,000 stanzas"}, "explanation": "Seerapuranam comprises three epic Kandams encompassing 5,027 stanzas."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil 