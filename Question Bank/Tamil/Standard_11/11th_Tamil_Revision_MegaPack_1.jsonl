{"id": "11th_tamil_rev1_q011", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "aingurunooru_compilers", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஐங்குறுநூறு நூலைத் தொகுத்தவர் மற்றும் தொகுப்பித்த மன்னன் முறையே யார்?", "media_id": null}], "options": {"A": "உருத்திரசன்மர்; பாண்டியன் உக்கிரப்பெருவழுதி", "B": "பூரிக்கோ; பன்னாடு தந்த பாண்டியன்", "C": "புலத்துறை முற்றிய கூடலூர் கிழார் (தொகுத்தவர்); யானைகட்சேய் மாந்தரஞ்சேரல் இரும்பொறை (தொகுப்பித்தவன்)", "D": "நக்கீரர்; தலையாலங்கானத்துச் செருவென்ற நெடுஞ்செழியன்"}, "explanation": "ஐங்குறுநூற்றைத் தொகுத்தவர் புலத்துறை முற்றிய கூடலூர் கிழார்; தொகுப்பித்த சேர மன்னன் யானைகட்சேய் மாந்தரஞ்சேரல் இரும்பொறை ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who compiled Aingurunooru, and which Chera king sponsored its classical compilation?", "media_id": null}], "options": {"A": "Uruthirasanmar; Pandya Ukkirapperuvazhuthi", "B": "Poorikko; Pannadu Thantha Pandiyan", "C": "Koodaloor Kizhaar (Compiler); Yanaikatchey Mantharanj Cheral Irumporai (Royal Patron)", "D": "Nakkeerar; Talaiyalanganathu Nedunchezhian"}, "explanation": "Koodaloor Kizhaar compiled it under the royal patronage of Chera King Yanaikatchey."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book"