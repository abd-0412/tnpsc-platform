{"id": "11th_tamil_rev1_q006", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "pallu_literature_thirumalai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'திருமலை முருகன் பள்ளு' என்னும் சிற்றிலக்கியத்தை இயற்றிய பெரியவன் கவிராயர் வாழ்ந்த ஊர் எது?", "media_id": null}], "options": {"A": "திருநெல்வேலி", "B": "பெரியகோட்டூர்", "C": "மதுரை", "D": "தென்காசி"}, "explanation": "திருநெல்வேலி மாவட்டம் குற்றாலத்திற்கு அருகிலுள்ள திருமலை முருகன் மீது 'திருமலை முருகன் பள்ளு' பாடிய பெரியவன் கவிராயர் 'பெரியகோட்டூர்' என்னும் ஊரைச் சேர்ந்தவர்."}, "en": {"blocks": [{"type": "text", "content": "In which native town did Periyavan Kavirayar, author of Thirumalai Murugan Pallu, reside?", "media_id": null}], "options": {"A": "Tirunelveli", "B": "Periyakottur", "C": "Madurai", "D": "Tenkasi"}, "explanation": "Periyavan Kavirayar hailed from Periyakottur."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 35", "url": null, "source_notes": null}, 