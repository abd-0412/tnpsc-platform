{"id": "11th_tamil_rev1_q008", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "pallu_meter_types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பள்ளு இலக்கியம் கீழ்க்காணும் எவ்வகை இலக்கியப் பிரிவைச் சார்ந்தது?", "media_id": null}], "options": {"A": "பெருங்காப்பியம்", "B": "சிறுகதை", "C": "புதினம்", "D": "தொண்ணூற்றாறு வகைச் சிற்றிலக்கியங்களுள் ஒன்று (உழத்திப் பாட்டு)"}, "explanation": "பள்ளு என்பது 96 வகைச் சிற்றிலக்கியங்களுள் ஒன்றாகும். இது உழவர்-உழத்தியரின் வேளாண் வாழ்வையும் இயற்கை வளத்தையும் பாடுவதால் 'உழத்திப் பாட்டு' என்றும் அழைக்கப்படும்."}, "en": {"blocks": [{"type": "text", "content": "To which genre of Tamil literature does Pallu poetry belong?", "media_id": null}], "options": {"A": "Major Epic", "B": "Short story", "C": "Novel", "D": "One of the 96 Minor Literary Genres (Prabandham / Uzhatthippaattu)"}, "explanation": "Pallu belongs to the 96 Minor Literary Genres (Chittrilakkiyam)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": "11th Tamil, Unit revisio