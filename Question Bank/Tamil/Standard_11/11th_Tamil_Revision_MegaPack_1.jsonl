{"id": "11th_tamil_rev1_q030", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_supp_grammar", "chapter_id": null, "topic_id": "real_life_krishnamoorthy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'யானை டாக்டர்' கதையின் நிஜ கதாநாயகனாக வாழ்ந்து காட்டுயிர்களைக் காத்த புகழ்பெற்ற வன கால்நடை மருத்துவர் யார்?", "media_id": null}], "options": {"A": "டாக்டர் சலீம் அலி", "B": "டாக்டர் வி. கிருஷ்ணமூர்த்தி (டாக்டர் கே)", "C": "டாக்டர் சிவராமன்", "D": "டாக்டர் ராமதாஸ்"}, "explanation": "டாப் ஸ்லிப் மற்றும் முதுமலைப் புலிகள் காப்பகத்தில் பணியாற்றி பல்லாயிரக்கணக்கான காட்டு யானைகளின் உயிரைக் காப்பாற்றிய டாக்டர் வி. கிருஷ்ணமூர்த்தி (டாக்டர் கே) அவர்களே இதன் நிஜ கதாநாயகர்."}, "en": {"blocks": [{"type": "text", "content": "Who was the real-life veterinary legend who inspired Jeyamohan's protagonist in 'Yaanai Doctor'?", "media_id": null}], "options": {"A": "Dr. Salim Ali", "B": "Dr. V. Krishnamoorthy (famously Dr. K)", "C": "Dr. Sivaraman", "D": "Dr. Ramadoss"}, "explanation": "Dr. V. Krishnamoorthy dedicated his life to treating injured wild elephants across South India."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term