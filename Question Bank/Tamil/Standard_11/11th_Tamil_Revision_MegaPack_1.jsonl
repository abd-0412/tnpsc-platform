{"id": "11th_tamil_rev1_q102", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "seerapuranam_sevilithai_padalam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "11-ஆம் வகுப்புப் பாடப்பகுதியில் இடம்பெற்றுள்ள சீறாப்பூராணப் பாடல் பகுதி எக்காண்டத்தில் எப்படலத்தில் அமைந்துள்ளது?", "media_id": null}], "options": {"A": "விலாதத்துக் காண்டம் - ஆமினா படலம்", "B": "ஹிஜ்ரத்துக் காண்டம் - செவிலித்தாய்க்கு உரைத்த படலம் (மற்றும் மதினம் புக்க படலம்)", "C": "நுபுவ்வத்துக் காண்டம் - தொழுகை படலம்", "D": "பொருட்படலம்"}, "explanation": "பாடப்பகுதியில் ஹிஜ்ரத்துக் காண்டத்தில் இடம்பெற்றுள்ள நபிகள் நாயகம் மதினா நகருக்குள் நுழைந்த 'மதினம் புக்க படலம்' மற்றும் நிகழ்வுகள் அமைந்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "From which Kandam and Padalam is the Seerapuranam excerpt in the Class 11 curriculum drawn?", "media_id": null}], "options": {"A": "Vilathathu Kandam - Amina Padalam", "B": "Hijrathu Kandam - Madinam Pukka Padalam (and Sevilithaikku Uraitha Padalam)", "C": "Nubuwwathu Kandam - Thozhugai Padalam", "D": "Porutpadalam"}, "explanation": "The Class 11 text features verses from Hijrathu Kandam (Madinam Pukka Padalam)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samache