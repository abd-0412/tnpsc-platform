{"id": "11th_tamil_rev1_q094", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "bharathi_pseudonyms", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆங்கிலேய அரசின் தணிக்கை மற்றும் கைது நடவடிக்கைகளிலிருந்து தப்பிக்க பாரதியார் பயன்படுத்திய புனைபெயர்களுள் பொருந்தாத ஒன்றைத் தேர்ந்தெடுக்க:", "media_id": null}], "options": {"A": "காளிதாசன், சக்திதாசன்", "B": "துரைசிங்கம்", "C": "இராமையா, உத்தமதேசாபிமானி", "D": "சாவித்திரி, நித்திய தீரர்"}, "explanation": "பாரதி காளிதாசன், சக்திதாசன், இராமையா, உத்தமதேசாபிமானி, சாவித்திரி, சி. சுப்பிரமணிய பாரதி உள்ளிட்ட பல புனைபெயர்களில் எழுதினார்; 'துரைசிங்கம்' என்பது அவரது புனைபெயர் அல்ல."}, "en": {"blocks": [{"type": "text", "content": "Which of the following was NOT among the covert pseudonyms adopted by Subramania Bharati to evade colonial censorship?", "media_id": null}], "options": {"A": "Kalidasan, Sakthidasan", "B": "Duraisingam", "C": "Ramaiya, Uthamadesabhimani", "D": "Savithri, Nithiya Theerar"}, "explanation": "Duraisingam was not a pseudonym of Bharati."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", 