{"id": "11th_tamil_rev1_q012", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "nammalvar_organization", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நம்மாழ்வார் இயற்கை வேளாண்மைப் பயிற்சிகளையும் விழிப்புணர்வையும் வழங்குவதற்காக நிறுவிய புகழ்பெற்ற சுற்றுச்சூழல் அமைப்பு எது?", "media_id": null}], "options": {"A": "பசுமை தாயகம்", "B": "நாகரிக விடியல்", "C": "இயற்கை அரண்", "D": "வானகம் (நம்மாழ்வார் உயிர்சூழல் நடுவம் - கரூர்)"}, "explanation": "கரூர் மாவட்டம் கடவூர் அருகே நம்மாழ்வார் அமைத்த 'வானகம்' (நம்மாழ்வார் சூழலியல் நடுவம்) இயற்கை வேளாண்மைக்கான முதன்மைப் பயிற்சி மையமாக இன்றும் விளங்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the name of the celebrated ecological training center founded in Karur by G. Nammalvar?", "media_id": null}], "options": {"A": "Pasumai Thaayagam", "B": "Naagariga Vidiyal", "C": "Iyarkai Aran", "D": "Vaanagam (Nammalvar Ecological Foundation, Karur)"}, "explanation": "Nammalvar established 'Vaanagam' in Karur district as an ecological sanctuary."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition":