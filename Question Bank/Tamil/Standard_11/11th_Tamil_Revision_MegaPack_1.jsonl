{"id": "11th_tamil_rev1_q025", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "nammalvar_panchagavya", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயற்கை வேளாண்மையில் பயிர்களைப் பூச்சிகளிடமிருந்து பாதுகாக்கவும் ஊட்டம் அளிக்கவும் பசுவின் ஐந்து பொருட்களைக் கொண்டு தயாரிக்கப்படும் உரம் எது?", "media_id": null}], "options": {"A": "பஞ்சகவ்யா (Panchagavya)", "B": "யூரியா", "C": "டி.ஏ.பி", "D": "பொட்டாஷ்"}, "explanation": "பசுவின் சாணம், சிறுநீர், பால், தயிர், நெய் ஆகிய ஐந்தையும் இளநீர், வாழைப்பழம் சேர்த்துப் பதப்படுத்தித் தயாரிக்கப்படும் 'பஞ்சகவ்யா' தலைசிறந்த இயற்கை ஊக்கியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which five bovine elements constitute the premier organic bio-fertilizer popularized by Nammalvar?", "media_id": null}], "options": {"A": "Panchagavya (cow dung, urine, milk, curd, and ghee)", "B": "Urea", "C": "DAP", "D": "Potash"}, "explanation": "Panchagavya is formulated from five sacred cow by-products."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 28, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 28", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 1", "Prose", "Farming"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev1_q026", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "nannool_asiriyan_attributes", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நன்னூல் பொதுப்பாயிரத்தின்படி, தலைசிறந்த நற்குணங்களைக் கொண்ட ஆசிரியருக்கு உவமையாகக் கூறப்பட்டுள்ள நான்கு பொருட்கள் எவை?", "media_id": null}], "options": {"A": "மலர், கனி, காய், வித்து", "B": "நிலம், மலை, நிறைகோல், மலர்", "C": "ஆறு, குளம், கடல், ஏரி", "D": "சூரியன், சந்திரன், காற்று, நெருப்பு"}, "explanation": "நன்னூலார் நல்லாசிரியருக்கு 'நிலம்' (பொறுமை), 'மலை' (அளக்க முடியாத அறிவு), 'நிறைகோல்' (நடுவுநிலைமை), 'மலர்' (கண்டோர் மகிழும் முகம்) ஆகிய நான்கையும் உவமிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "According to Nannool Pothuppaayiram, which four objects exemplify the peerless virtues of an ideal teacher?", "media_id": null}], "options": {"A": "Flower, ripe fruit, green fruit, seed", "B": "Earth (patience), Mountain (immensity), Balance beam (impartiality), and Flower (graceful welcoming presence)", "C": "River, pond, ocean, lake", "D": "Sun, moon, wind, fire"}, "explanation": "Earth, Mountain, Balance Scale, and Flower are the four classical similes for a noble preceptor."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_