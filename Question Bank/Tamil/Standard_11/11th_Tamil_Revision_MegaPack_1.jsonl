{"id": "11th_tamil_rev1_q028", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "summary_batch1_u1_u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல்கள் 1 மற்றும் 2-ன் ஒட்டுமொத்தக் கவிதை மற்றும் உரைநடைப் பகுதிகள் மாணவர்களுக்கு உணர்த்தும் முதன்மை வாழ்வியல் செய்தி யாது?", "media_id": null}], "options": {"A": "நகர ஆடம்பர வாழ்வு", "B": "பிறமொழி மோகம்", "C": "இயற்கையை வணிகமயமாக்குதல்", "D": "தாய்மொழி மீதான தீராத பற்றும், இயற்கையோடு இயைந்த தற்சார்பு வேளாண் வாழ்வும்"}, "explanation": "மொழி மனிதனின் பண்பாட்டு அடையாளம்; நிலமும் இயற்கையும் மனிதனின் வாழ்வாதாரம். இவ்விரண்டையும் போற்றிக் காப்பதே முதல் இரண்டு இயல்களின் ஒட்டுமொத்தச் செய்தியாகும்."}, "en": {"blocks": [{"type": "text", "content": "What foundational ecological and cultural truth is imparted across the prose and poetry of Units 1 and 2?", "media_id": null}], "options": {"A": "Urban materialistic consumerism", "B": "Alienation from mother tongue", "C": "Commercial exploitation of ecology", "D": "Unyielding reverence for mother tongue and sustainable self-reliant agrarian communion with pristine nature"}, "explanation": "Units 1 and 2 unify cultural linguistic pride with sustainable ecological harmony."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": 