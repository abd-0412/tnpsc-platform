{"id": "11th_tamil_rev1_q123", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_supp_grammar", "chapter_id": null, "topic_id": "thirukkural_ozhukkamudaimai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"ஒழுக்கம் விழுப்பம் தரலான் ஒழுக்கம்\nஉயிரினும் ஓம்பப் படும்\" - இத்திருக்குறளின்படி உயிரை விட மேலாகப் போற்றிக் காக்கப்பட வேண்டியது எது?", "media_id": null}], "options": {"A": "பணம்", "B": "அழகு", "C": "நல் ஒழுக்கம்", "D": "பதவி"}, "explanation": "ஒழுக்கமே ஒருவனுக்கு அனைத்து மேன்மைகளையும் தரும்; ஆதலால் அந்த நல்லொழுக்கத்தைத் தன் உயிரைக் காட்டிலும் மேலானதாகக் கருதிப் பாதுகாக்க வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "According to 'Ozhukkam Vizhuppam Tharalaan Ozhukkam Uyirinum Ombap Padum', what must be cherished above life itself?", "media_id": null}], "options": {"A": "Wealth", "B": "Beauty", "C": "Moral rectitude and virtuous conduct (Ozhukkam)", "D": "Political office"}, "explanation": "Righteous moral conduct must be guarded more dearly than mortal breath."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 78, "chapter": null, "section": nu