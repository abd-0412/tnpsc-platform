{"id": "11th_tamil_rev1_q149", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_grammar", "chapter_id": null, "topic_id": "marabuthodar_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கிணற்றுத் தவளை' என்னும் மரபுத்தொடர் உணர்த்தும் சரியான பொருள் யாது?", "media_id": null}], "options": {"A": "வெளி உலக அறிவு ஏதுமின்றித் தன் குறுகிய வட்டத்திற்குள்ளேயே வாழ்பவர்", "B": "நீரில் நீந்துபவர்", "C": "ஆபத்தில் சிக்கியவர்", "D": "விவசாயம் செய்பவர்"}, "explanation": "'கிணற்றுத் தவளை' என்பது உலக அறிவும் பரந்த பார்வையும் இன்றித் தன் சிறு உலகமே முழு உலகம் என நினைத்து வாழும் குறுகிய மனப்பான்மையைக் குறிக்கும் மரபுத்தொடராகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the idiomatic signification of the classical Tamil idiom 'Kinattruth Thavalai' (Frog in a well)?", "media_id": null}], "options": {"A": "One with narrow parochial horizons utterly oblivious of the wider world", "B": "A skilled swimmer", "C": "One trapped in peril", "D": "An agriculturist"}, "explanation": "'Frog in a well' idioms denote insular parochialism devoid of worldly understanding."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term"