{"id": "11th_tamil_rev1_q146", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_grammar", "chapter_id": null, "topic_id": "mey_ezhuthu_mathirai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கணம்: மெய்யெழுத்துகள் மற்றும் ஆய்த எழுத்து ஒலிக்கும் மாத்திரை அளவு யாது?", "media_id": null}], "options": {"A": "ஒரு மாத்திரை", "B": "அரை (1/2) மாத்திரை", "C": "இரண்டு மாத்திரை", "D": "கால் மாத்திரை"}, "explanation": "மெய்யெழுத்துகளும் (18) மற்றும் ஆய்த எழுத்தும் (ஃ) தமக்குரிய முழுமையான அளவில் ஒலிக்கும் போது 'அரை மாத்திரை' அளவு பெறும்."}, "en": {"blocks": [{"type": "text", "content": "Grammar: What is the metrical duration (Maathirai) allotted to pure consonants (Mey) and the Aayudha letter?", "media_id": null}], "options": {"A": "One maathirai", "B": "Half (1/2) maathirai", "C": "Two maathirai", "D": "Quarter maathirai"}, "explanation": "Pure consonants and the Aayudha letter carry a value of half a mora (1/2 maathirai)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 16, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 16",