{"id": "11th_tamil_rev1_q121", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_supp_grammar", "chapter_id": null, "topic_id": "vadivasal_sangam_link", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வாடிவாசல்' நாவலில் விவரிக்கப்படும் ஏறுதழுவுதல் விழா சங்க இலக்கியத்தின் எந்த நூலில் மிக விரிவாகப் பாடப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "கலித்தொகை (முல்லைக்கலி)", "B": "குறுந்தொகை", "C": "நற்றிணை", "D": "ஐங்குறுநூறு"}, "explanation": "சங்க இலக்கியத்தில் முல்லை நிலத்து ஆயர்கள் காளைகளை அடக்கும் 'ஏறுதழுவுதல்' கலித்தொகையில் முல்லைக்கலிப் பகுதியில் மிக விரிவாகப் பாடப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "In which classical Sangam anthology is the bull-embracing sport (Eeruthazhuvuthal) depicted in Vaadivaasal celebrated extensively?", "media_id": null}], "options": {"A": "Kalithogai (Mullaikkali section)", "B": "Kurunthogai", "C": "Natrinai", "D": "Aingurunooru"}, "explanation": "Kalithogai describes Eeruthazhuvuthal in vivid detail in the Mullai cantos."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 64, "chapter": null, "secti