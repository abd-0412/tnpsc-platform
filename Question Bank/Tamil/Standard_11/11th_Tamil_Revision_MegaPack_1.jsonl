{"id": "11th_tamil_rev1_q110", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "bharathi_young_india_english", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியார் ஆங்கிலத்தில் வெளியிட்ட 'பாலபாரதி' (Bala Bharathi / The Young India) இதழின் முதன்மை நோக்கம் யாது?", "media_id": null}], "options": {"A": "ஆங்கில வணிகர்களுக்கு ஆதரவளிப்பது", "B": "இந்தியாவின் சுதந்திர வேட்கையையும் பண்பாட்டு எழுச்சியையும் சர்வதேச அளவிலும் ஆங்கிலம் படித்த இளைஞர்களிடமும் கொண்டுசேர்ப்பது", "C": "கதை எழுதுவது மட்டுமே", "D": "ஆங்கில இலக்கணம் கற்பிப்பது"}, "explanation": "பாலபாரதி ஆங்கில வார இதழ் மூலம் இந்தியத் தேசிய எழுச்சியை ஆங்கிலம் அறிந்த மேல்தட்டு இளைஞர்களிடமும் உலக அரங்கிலும் பாரதி கொண்டுசேர்த்தார்."}, "en": {"blocks": [{"type": "text", "content": "What was the core mission of the English-language periodical 'Bala Bharathi' (The Young India) steered by Bharati?", "media_id": null}], "options": {"A": "Supporting British merchants", "B": "Projecting India heroic struggle for freedom and cultural renaissance to English-educated youth and global audiences", "C": "Story writing purely", "D": "Teaching English grammar"}, "explanation": "Bala Bharathi channeled Indian nationalist aspirations in English for broader youth and international outreach."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_