{"id": "11th_tamil_rev1_q196", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_pyq_model", "chapter_id": null, "topic_id": "pyq_master_revision1_synthesis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] மேல்நிலை முதலாம் ஆண்டு (11-ஆம் வகுப்பு) இயல்கள் 1 முதல் 4 வரையிலான முழுத் திருப்புதல் பாடப்பகுதிகள் அனைத்தும் ஒருங்கிணைந்து உணர்த்தும் உச்சக்கட்டச் செய்தி யாது?", "media_id": null}], "options": {"A": "போட்டித் தேர்வுகளில் மனப்பாடம் மட்டுமே கை கொடுக்கும்", "B": "பழைய இலக்கியங்களை விட்டுவிட வேண்டும்", "C": "பொருளாதாரம் மட்டுமே மனித வாழ்வின் குறிக்கோள்", "D": "சிந்துவெளித் தொன்மை, நன்னூல்-சங்க இலக்கியத்தின் செவ்வியல் அறம், இயற்கை வேளாண்மை, விடுதலைப் போராட்ட இதழியல் மற்றும் பண்பாட்டு விழுமியங்களை ஆழமாகக் கற்றுத் தேர்ச்சி பெறுதலே தமிழரின் முழுமையான வெற்றி"}, "explanation": "முதல் நான்கு இயல்கள் மொழியியல், சூழலியல், தொன்மை வரலாறு, செவ்வியல் இலக்கியம் மற்றும் தேசிய விடுதலையை உள்ளடக்கிய முழுமையான அறிவுக் கருவூலமாகும்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] What comprehensive civilizational mastery is synthesized across Units 1 through 4 of Class 11 General Tamil?", "media_id": null}], "options": {"A": "Mechanical rote memorization suffices", "B": "Ancient classics should be discarded", "C": "Material economics alone constitutes human purpose", "D": "Mastering Indus civilizational antiquity, classical Sangam-Nannool ethics, organic agro-ecology, patriotic journalism, and cultural integrity guarantees holistic intellectual triumph"}, "explanation": "Units 1 to 4 comprehensively master antiquity, ecological ethics, and literary enlightenment."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 98, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 98", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 1", "PYQ", "Synthesis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
