{"id": "11th_tamil_rev1_q053", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_supp_grammar", "chapter_id": null, "topic_id": "elephant_doctor_human_barbarism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'யானை டாக்டர்' சிறுகதையில் மனிதனின் சுயநலத்தையும் இரக்கமற்ற தன்மையையும் வெளிப்படுத்தும் காட்சி எது?", "media_id": null}], "options": {"A": "யானைகளின் காலில் கண்ணாடி குத்திச் சீழ்பிடித்துத் துடிக்கும் வேளையிலும் சுற்றுலாப் பயணிகள் அலட்சியமாகச் சிரித்து மகிழ்வது", "B": "யானைகளுக்கு உணவளிப்பது", "C": "மரங்களை நடுவது", "D": "காடுகளைப் பாதுகாப்பது"}, "explanation": "காட்டுயிர்களின் துன்பத்தைப் பற்றி எள்ளளவும் கவலைப்படாமல் மனிதர்கள் காடுகளைக் கேளிக்கைக்கூடமாக மாற்றி அழிப்பதே கதையின் மைய வேதனையாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which poignant scene in 'Yaanai Doctor' starkly exposes human cruelty and tourist apathy toward forest wildlife?", "media_id": null}], "options": {"A": "Tourists merrily partying while elephants suffer agonizing gangrene from shattered glass bottles discarded by them", "B": "Feeding wild elephants", "C": "Afforestation programs", "D": "Sanctuary conservation"}, "explanation": "The author powerfully contrasts human hedonistic tourist indifference with the excruciating suffering of wounded elephants."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_mult