{"id": "11th_tamil_rev1_q007", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "fukuoka_one_straw_revolution", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயற்கை வேளாண்மைக்கு உலகளவில் வித்திட்ட 'ஒற்றை வைக்கோல் புரட்சி' (The One-Straw Revolution) என்ற நூலின் ஜப்பானிய ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "அகிரா குரசோவா", "B": "ஹருகி முரகாமி", "C": "மசானோபு ஃபுகோகா (Masanobu Fukuoka)", "D": "யசுனாரி கவாபதா"}, "explanation": "மசானோபு ஃபுகோகா இயற்றிய 'The One-Straw Revolution' உழவு செய்யாமல், உரம் போடாமல், களை எடுக்காமல் இயற்கையை நம்பி வேளாண்மை செய்யும் 'செய்நேர்த்தி அற்ற வேளாண்மை'யை உலகுக்கு அறிமுகப்படுத்தியது."}, "en": {"blocks": [{"type": "text", "content": "Who authored the revolutionary text 'The One-Straw Revolution' that laid the global foundation for natural do-nothing farming?", "media_id": null}], "options": {"A": "Akira Kurosawa", "B": "Haruki Murakami", "C": "Masanobu Fukuoka", "D": "Yasunari Kawabata"}, "explanation": "Japanese agriculturist Masanobu Fukuoka authored The One-Straw Revolution."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11