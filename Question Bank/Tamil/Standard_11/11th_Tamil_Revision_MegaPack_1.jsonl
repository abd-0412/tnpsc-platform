{"id": "11th_tamil_rev1_q014", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "pallu_paddy_varieties", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'திருமலை முருகன் பள்ளு' நூலில் குறிப்பிடப்படும் பாரம்பரிய நெல் வகைகளுள் பொருந்தாத ஒன்றைத் தேர்ந்தெடுக்க:", "media_id": null}], "options": {"A": "சித்திரைக் கார், சீராகச் சம்பா", "B": "பொன்னி ஐ.ஆர். 20 (IR-20 நவீன நெல்)", "C": "செங்கல்பட்டுச் சம்பா, முத்துவெள்ளை", "D": "குண்டுமணி, காளான் சம்பா"}, "explanation": "'IR-20' என்பது பசுமைப்புரட்சிக்குப் பின் வந்த வீரிய ஒட்டு நெல்; மற்றவை அனைத்தும் பள்ளு இலக்கியத்தில் பெரியவன் கவிராயர் பட்டியலிடும் பலநூறு பாரம்பரியத் தமிழ் நெல் ரகங்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following is NOT an indigenous traditional paddy variety enumerated in Thirumalai Murugan Pallu?", "media_id": null}], "options": {"A": "Chithiraikkaar, Seeraga Samba", "B": "Ponni IR-20 (Modern hybrid green revolution grain)", "C": "Chengalpattu Samba, Muthuvellai", "D": "Gundumani, Kaalan Samba"}, "explanation": "IR-20 is a post-green-revolution semi-dwarf laboratory hybrid, unlike classical heritage grains."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publishe