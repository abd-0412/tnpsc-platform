{"id": "11th_tamil_rev1_q042", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_supp_grammar", "chapter_id": null, "topic_id": "elephant_whisperer_forest_topslip", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "டாக்டர் கிருஷ்ணமூர்த்தி அவர்கள் தம்முடைய பணிக்காலத்தில் காடுகளிலேயே தங்கிப் பணியாற்றிய புகழ்பெற்ற தமிழக வனப்பகுதி எது?", "media_id": null}], "options": {"A": "கிண்டி பூங்கா", "B": "ஆனைமலை / டாப்ஸ்லிப் (Top Slip - பொள்ளாச்சி அருகே)", "C": "வண்டலூர்", "D": "முண்டந்துறை மட்டுமே"}, "explanation": "பொள்ளாச்சிக்கு அருகிலுள்ள ஆனைமலை டாப்ஸ்லிப் யானைகள் முகாமில் டாக்டர் கிருஷ்ணமூர்த்தி தம் வாழ்நாளின் பெரும்பகுதியைக் கழித்தார்."}, "en": {"blocks": [{"type": "text", "content": "In which celebrated wildlife sanctuary of the Western Ghats did Dr. Krishnamoorthy reside and treat elephants?", "media_id": null}], "options": {"A": "Guindy Park", "B": "Anaimalai / Top Slip (near Pollachi)", "C": "Vandalur", "D": "Mundanthurai exclusively"}, "explanation": "Top Slip in the Anaimalai Hills served as Dr. Krishnamoorthy's primary wilderness base."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "