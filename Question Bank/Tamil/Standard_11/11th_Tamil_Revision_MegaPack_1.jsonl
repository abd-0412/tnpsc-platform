{"id": "11th_tamil_rev1_q038", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_supp_grammar", "chapter_id": null, "topic_id": "aayudha_ezhuthu_ina_pair", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கணம்: தமிழ் எழுத்துகளில் தனக்கென எந்த ஓர் 'இன எழுத்தும்' இல்லாத தனித்த எழுத்து எது?", "media_id": null}], "options": {"A": "ஔ", "B": "ஆய்த எழுத்து (ஃ)", "C": "ஐ", "D": "இ"}, "explanation": "உயிர் எழுத்துகளுக்கும் மெய் எழுத்துகளுக்கும் இன எழுத்துகள் உண்டு; ஆனால் 'ஆய்த எழுத்துக்கு (ஃ)' எவ்வித இன எழுத்தும் கிடையாது."}, "en": {"blocks": [{"type": "text", "content": "Grammar: Which unique character in the Tamil alphabet possesses absolutely NO cognate pair (Ina Ezhuthu)?", "media_id": null}], "options": {"A": "Au (ஔ)", "B": "Aayudha letter (ஃ)", "C": "Ai (ஐ)", "D": "I (இ)"}, "explanation": "The Aayudha letter (ஃ) stands alone with no phonetic cognate counterpart."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 17, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 17", "url": null, "source_notes": null}, "previous_year": {"is_p