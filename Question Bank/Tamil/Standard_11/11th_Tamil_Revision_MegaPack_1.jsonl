{"id": "11th_tamil_rev1_q192", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_pyq_model", "chapter_id": null, "topic_id": "pyq_thirukkural_kooda_ozhukkam_valangul", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] \"வலியில் நிலைமையான் வல்லுருவம்...\" மற்றும் \"தவமறைந்து அல்லவை செய்தல் புதல்மறைந்து\nவேட்டுவன் புள்புல் மாற்று\" - இக்குறட்பாவில் 'புள்' என்பது எதனைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "புல்வெளி", "B": "மிருகம்", "C": "வேடன்", "D": "பறவை (புள் = பறவை)"}, "explanation": "வேடன் புதரில் மறைந்துகொண்டு பறவைகளைப் பிடிப்பது போல, போலித் துறவி காவியுடைக்குப் பின்னால் மறைந்துகொண்டு பாவங்களைச் செய்கிறான்; இதில் 'புள்' என்றால் பறவை என்று பொருள்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] In the Kural comparing a false ascetic to a hunter snaring birds behind bushes, what does 'Pull' (புள்) signify?", "media_id": null}], "options": {"A": "Grass blade", "B": "Beast", "C": "Fowler", "D": "Bird (Pull = Paravai)"}, "explanation": "'Pull' is an archaic classical Tamil word denoting a bird."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": 