": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 1", "Grammar", "Phonetics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev1_q055", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_supp_grammar", "chapter_id": null, "topic_id": "thirukkural_kooda_ozhukkam_clean", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"மழித்தலும் நீட்டலும் வேண்டா உலகம்\nபழித்தது ஒழித்து விடின்\" - இத்திருக்குறள் வெளிப்படுத்தும் புறவேட எதிர்ப்புச் சிந்தனை யாது?", "media_id": null}], "options": {"A": "தலைமுடியை அழகுபடுத்த வேண்டும்", "B": "தாடியை மழிக்க வேண்டும்", "C": "உலகம் பழிக்கும் தீய ஒழுக்கங்களை விட்டுவிட்டாலே போதுமானது; தலையை மழிப்பதோ அல்லது சடை வளர்ப்பதோ போன்ற புறவேடங்கள் தேவையில்லை", "D": "துறவிகள் மட்டுமே நல்லவர்கள்"}, "explanation": "உலகத்தாரால் பழிக்கப்படும் தீய நடத்தைகளை ஒருவன் மனதிலிருந்து நீக்கிவிட்டாலே போதும்; மொட்டை அடிப்பதோ சடை வளர்ப்பதோ போன்ற போலிப் புறவேடங்களால் எந்தப் பயனும் இல்லை என்று போலிகளை வள்ளுவர் சாடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What blistering critique of religious ostentation is delivered in 'Mazhithalum Neettalum Vaendaa Ulagam Pazhithathu Ozhithu Vidin'?", "media_id": null}], "options": {"A": "Hair grooming is mandatory", "B": "Shaving beards daily is ideal", "C": "Shedding vice shunned by society suffices; external affectations like tonsuring bald or growing matted locks are utterly superfluous", "D": "Monks alone are virtuous"}, "explanation": "True holiness lies in shedding vice; outward bodily austerities like tonsuring or matted locks are futile."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "num