{"id": "11th_tamil_rev1_q081", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "education_tradition_gurukulam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைத் தமிழகத்தில் கற்றலை வாழ்நாள் கடமையாகக் கொண்டு ஆசிரியர் இல்லத்திலேயே தங்கிப் பயின்ற கல்வி முறை எது?", "media_id": null}], "options": {"A": "குருகுலக் கல்வி முறை", "B": "பல்கலைக்கழக முறை", "C": "தொலைதூரக் கல்வி", "D": "திண்ணைப் பள்ளி மட்டுமே"}, "explanation": "மாணவர்கள் குருவின் இல்லத்திலேயே தங்கி அவருக்குத் தொண்டு செய்து கல்வியையும் ஒழுக்கத்தையும் பயின்ற முறை 'குருகுலக் கல்வி முறை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which ancient pedagogical system involved residential discipleship where students resided at the preceptor's hermitage?", "media_id": null}], "options": {"A": "Gurukula system of education", "B": "Collegiate university system", "C": "Distance correspondence system", "D": "Veranda school exclusively"}, "explanation": "The Gurukula tradition featured residential tutelage under the preceptor."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "