{"id": "11th_tamil_rev1_q032", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_supp_grammar", "chapter_id": null, "topic_id": "punarchi_other_vowels_v", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஏனை உயிர் வழி வவ்வும்' என்ற விதியின்படி உடம்படுமெய் 'வ்' தோன்றிப் புணர்ந்த சொல்லுக்குச் சரியான எடுத்துக்காட்டு எது?", "media_id": null}], "options": {"A": "தீ + எரிந்தது = தீயெரிந்தது", "B": "கிளி + அழகு = கிளியழகு", "C": "வாழை + இலை = வாழையிலை", "D": "பல + அணி = பலவணி (அல்லது பூ + அழகு = பூவழகு)"}, "explanation": "இ, ஈ, ஐ தவிர்த்த பிற உயிரெழுத்துகள் (அ, ஆ, உ, ஊ, ஓ போன்றவை) நிலைமொழி ஈற்றில் வரும்போது 'வ்' தோன்றும் (பூ + அழகு = பூவழகு, பல + அணி = பலவணி)."}, "en": {"blocks": [{"type": "text", "content": "Which example demonstrates the appearance of glide 'v' (வ்) under the rule 'Eanai Uyir Vazhi Vavvum'?", "media_id": null}], "options": {"A": "Thee + erinthathu = Theeyerinthathu", "B": "Kili + azhagu = Kiliyazhagu", "C": "Vaazhai + ilai = Vaazhaiyilai", "D": "Pala + ani = Palavani (or Poo + azhagu = Poovazhagu)"}, "explanation": "Poo + azhagu = Poovazhagu exemplifies the labiodental glide 'v'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpora