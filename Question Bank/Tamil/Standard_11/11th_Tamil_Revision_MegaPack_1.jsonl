{"id": "11th_tamil_rev1_q132", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_supp_grammar", "chapter_id": null, "topic_id": "vadivasal_jallikattu_rules", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வாடிவாசலில் தமிழர்களின் ஏறுதழுவுதல் மரபு விதிகளின்படி காளையை அடக்குபவர்கள் எதனைப் பற்றிக்கொண்டு மட்டுமே அடக்க வேண்டும்?", "media_id": null}], "options": {"A": "காளையின் வாலை மட்டுமே", "B": "காளையின் கொம்பை மட்டுமே", "C": "காளையின் கால்களைப் பிடித்து வீழ்த்துதல்", "D": "காளையின் திமிலை (Hump) மட்டுமே இரு கைகளாலும் தழுவிப் பிடித்து அடக்க வேண்டும்"}, "explanation": "ஏறுதழுவுதலில் காளையின் திமிலை மட்டுமே தழுவிப் பிடிக்க வேண்டும்; வாலைப் பிடிப்பதோ, கொம்பைத் திருப்புவதோ கோழைத்தனமான பிழையாகக் கருதப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Under traditional Tamil Jallikattu etiquette portrayed in Vaadivaasal, how must a warrior grip the bull?", "media_id": null}], "options": {"A": "Grasping the tail solely", "B": "Twisting the horns solely", "C": "Tripping its legs", "D": "Embracing and holding steadfast solely onto the muscular hump (Thimil)"}, "explanation": "Warriors must embrace only the bull's muscular hump, never twisting horns or holding tails."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer 