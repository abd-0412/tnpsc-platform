{"id": "11th_tamil_rev1_q091", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_epic_journalism", "chapter_id": null, "topic_id": "chithiravali_cartoon_plan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியார் பிரெஞ்சு ஆதிக்கப் புதுச்சேரியில் இருந்தபோது கேலிச்சித்திரங்களுக்காக மட்டுமே தனியாகத் தொடங்கத் திட்டமிட்ட இதழின் பெயர் யாது?", "media_id": null}], "options": {"A": "விகடச்சித்திரம்", "B": "நகைச்சுவை", "C": "சித்திராவளி (Chithiravali)", "D": "கார்ட்டூன்"}, "explanation": "கேலிச்சித்திரங்களுக்கென்றே தனியாக 'சித்திராவளி' என்ற இதழைத் தொடங்க பாரதி விளம்பரம் செய்தார்; ஆனால் நிதிப் பற்றாக்குறையால் அது வெளிவர இயலாமல் போனது."}, "en": {"blocks": [{"type": "text", "content": "What was the title of the standalone cartoon journal planned by Bharati during his Pondicherry exile?", "media_id": null}], "options": {"A": "Vikadachithiram", "B": "Nagaichuvai", "C": "Chithiravali", "D": "Cartoon"}, "explanation": "Bharati planned a dedicated cartoon periodical titled 'Chithiravali'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 97, "chapter": null, "section": null, "refe