{"id": "11th_tamil_rev1_q118", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_supp_grammar", "chapter_id": null, "topic_id": "chellappa_sahitya_akademi_novel", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சி. சு. செல்லப்பாவிற்கு 2001-ல் சாகித்திய அகாதெமி விருது பெற்றுத்தந்த சுதந்திரப் போராட்ட வரலாற்று நாவல் எது?", "media_id": null}], "options": {"A": "வாடிவாசல்", "B": "சுதந்திர தாகம் (மூன்று பாகங்கள்)", "C": "ஜீவனாம்சம்", "D": "சரஸாவின் பொம்மை"}, "explanation": "செல்லப்பாவின் பெருநாவலான 'சுதந்திர தாகம்' அவரது மறைவுக்குப் பின் 2001-ல் சாகித்திய அகாதெமி விருது வழங்கிச் சிறப்பிக்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which monumental freedom struggle historical novel won C. S. Chellappa the Sahitya Akademi Award in 2001?", "media_id": null}], "options": {"A": "Vaadivaasal", "B": "Suthanthira Dhaagam (in 3 volumes)", "C": "Jeevanaamsam", "D": "Sarasaavin Bommai"}, "explanation": "His historical trilogy 'Suthanthira Dhaagam' won the Sahitya Akademi Award in 2001."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 64, "chapter": null, "section": n