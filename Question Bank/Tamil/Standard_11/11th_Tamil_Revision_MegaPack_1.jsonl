{"id": "11th_tamil_rev1_q083", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "purananuru_altruism_phrase", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"அன்ன மாட்சி அனைய ராகலின்\nதமக்கென வாழாப் பிறர்க்குரியாளர்\nஉண்டா லம்மஇவ் வுலகம்\" - இப்பாடலின் இறுதி வரிகள் எதனை நிலைநாட்டுகின்றன?", "media_id": null}], "options": {"A": "அரசனின் வல்லமையை", "B": "இயற்கையின் கொடையை", "C": "தமக்கென வாழாமல் பிறர்க்கென வாழும் மனிதநேயப் பண்பே உலக இயக்கத்தின் அச்சாணி என்பதை", "D": "மரணத்தின் தவிர்க்க முடியாத தன்மையை"}, "explanation": "இவ்வுலகம் இன்னும் அழியாமல் நிலைபெற்றிருப்பதற்குக் காரணம் சுயநலமற்று வாழும் உயர்ந்த சான்றோர்களின் தியாகமே என்று இளம்பெருவழுதி மெய்ப்பிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "What universal humanist axiom is immortalized in the concluding verses of 'Undalamma Ivvulagam'?", "media_id": null}], "options": {"A": "Monarchical omnipotence", "B": "Bounty of raw nature", "C": "Selfless altruists living solely for others sustain the cosmic existence of our world", "D": "The inevitability of mortality"}, "explanation": "The world survives solely through the virtue of selfless altruists."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kal