{"id": "11th_tamil_u6_q021", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "dravidian_architecture_pinnacle", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெர்சி பிரவுன் (Percy Brown) போன்ற உலகக் கட்டிடக் கலை வல்லுநர்கள் தஞ்சைப் பெரிய கோயிலை எவ்வாறாகப் போற்றுகின்றனர்?", "media_id": null}], "options": {"A": "திராவிடக் கட்டிடக் கலையின் மணிமகுடம் (The Landmark of Dravidian Architecture)", "B": "கிரேக்கக் கலையின் மறுவடிவம்", "C": "மௌரியக் கலையின் எச்சம்", "D": "பண்டைய காப்பிய ஓவியக் கூடம்"}, "explanation": "பெர்சி பிரவுன் உள்ளிட்ட அறிஞர்கள் தஞ்சைப் பெரிய கோயிலைத் திராவிடக் கட்டிடக் கலையின் உச்சக்கட்ட சாதனை என்றும் மாபெரும் மணிமகுடம் என்றும் போற்றியுள்ளனர்."}, "en": {"blocks": [{"type": "text", "content": "How did world architecture historian Percy Brown laud the Thanjavur Big Temple?", "media_id": null}], "options": {"A": "The definitive landmark and crowning glory of Dravidian Architecture", "B": "Facsimile of Greek art", "C": "Remnant of Mauryan craft", "D": "Gallery of epic murals"}, "explanation": "Percy Brown praised it as the touchstone and pinnacle of South Indian Dravidian architecture."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nad