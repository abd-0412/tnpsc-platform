{"id": "11th_tamil_u6_q129", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "mkt_birth_native", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எம். கே. தியாகராஜ பாகவதரின் பூர்வீகம் எது? அவர் வளர்ந்து இசை பயின்ற நகரம் எது?", "media_id": null}], "options": {"A": "மாயவரம் பூர்வீகம்; வளர்ந்தது திருச்சிராப்பள்ளி", "B": "மதுரை பூர்வீகம்; வளர்ந்தது சென்னை", "C": "தஞ்சாவூர் பூர்வீகம்; வளர்ந்தது கோயம்புத்தூர்", "D": "சேலம் பூர்வீகம்; வளர்ந்தது ஈரோடு"}, "explanation": "பாகவதர் மாயவரத்தில் பிறந்தவர்; அவரது குடும்பம் திருச்சிராப்பள்ளிக்குக் குடிபெயர்ந்ததால் திருச்சியிலேயே வளர்ந்து இசை பயின்றார்."}, "en": {"blocks": [{"type": "text", "content": "Where was M. K. Thyagaraja Bhagavathar born, and in which city was he nurtured in music?", "media_id": null}], "options": {"A": "Born in Mayavaram; raised and trained in Tiruchirappalli", "B": "Born in Madurai; raised in Madras", "C": "Born in Thanjavur; raised in Coimbatore", "D": "Born in Salem; raised in Erode"}, "explanation": "Bhagavathar hailed ancestrally from Mayavaram and grew up in Tiruchirappalli."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "