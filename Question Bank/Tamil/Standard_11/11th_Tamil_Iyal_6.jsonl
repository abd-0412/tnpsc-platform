{"id": "11th_tamil_u6_q079", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_athmanam_and_kutralam", "chapter_id": null, "topic_id": "chitra_sabhai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிவபெருமானின் ஐம்பெரும் மன்றங்களுள் (சபைகளுள்) குற்றாலத்தில் அமைந்துள்ள சபை எது?", "media_id": null}], "options": {"A": "பொற்சபை (தில்லை)", "B": "வெள்ளிச்சபை (மதுரை)", "C": "சித்திர சபை (குற்றாலம்)", "D": "இரத்தின சபை (திருவாலங்காடு)"}, "explanation": "சிவனின் பஞ்ச சபைகள்: பொற்சபை - சிதம்பரம், வெள்ளிச்சபை - மதுரை, தாமிரசபை - திருநெல்வேலி, சித்திரசபை - குற்றாலம், இரத்தினசபை - திருவாலங்காடு."}, "en": {"blocks": [{"type": "text", "content": "Among the five sacred dance halls (Pancha Sabha) of Lord Shiva, which Sabha is located at Kutralam?", "media_id": null}], "options": {"A": "Porsabhai (Chidambaram)", "B": "Vellisabhai (Madurai)", "C": "Chitra Sabhai (Kutralam)", "D": "Rathina Sabhai (Thiruvalangadu)"}, "explanation": "Kutralam hosts the Chitra Sabhai (Hall of Murals)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 136, "chapter": null, "section": null, "reference": "11th Tamil, U