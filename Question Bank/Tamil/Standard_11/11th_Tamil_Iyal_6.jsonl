{"id": "11th_tamil_u6_q131", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "kbs_gramophone_pioneer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கே. பி. சுந்தராம்பாளின் குரலில் வெளியான கிராமபோன் இசைத்தட்டுகள் அக்காலத்தில் எத்தகைய தாக்கத்தை ஏற்படுத்தின?", "media_id": null}], "options": {"A": "மக்கள் கேட்க மறுத்தனர்", "B": "அரசாங்கம் அவற்றைத் தடை செய்தது மட்டுமே", "C": "தமிழகத்தின் மூலைமுடுக்குகளிலெல்லாம் கிராமபோன் தட்டுகள் ஒலித்துத் தமிழர்களின் தேசிய உணர்வையும் பக்தி உணர்வையும் தட்டியெழுப்பின", "D": "வெளிநாடுகளில் மட்டுமே விற்கப்பட்டன"}, "explanation": "சுந்தராம்பாளின் கணீரென்ற குரலில் வெளிவந்த கிராமபோன் தட்டுகள் பட்டிதொட்டியெங்கும் ஒலித்து விடுதலை வேட்கையையும் ஆன்மீக நெறியையும் பரப்பின."}, "en": {"blocks": [{"type": "text", "content": "What historical impact did K. B. Sundarambal's gramophone recordings create across society?", "media_id": null}], "options": {"A": "Rejected by the public", "B": "Suppressed with total bans", "C": "Echoed in every corner of Tamil Nadu, galvanizing patriotism and devotional fervor", "D": "Sold exclusively overseas"}, "explanation": "Her gramophone discs became omnipresent cultural catalysts across Tamil households."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "b