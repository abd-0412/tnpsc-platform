{"id": "11th_tamil_u6_q016", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "bharatanatyam_sculptures", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயிலின் முதல் தளச் சுவர்களில் பரதநாட்டிய சாஸ்திரத்தின் எத்தனை கரணங்கள் சிற்பங்களாக வடிக்கப்பட்டுள்ளன?", "media_id": null}], "options": {"A": "64 கரணங்கள்", "B": "81 கரணங்கள்", "C": "100 கரணங்கள்", "D": "108 கரணங்களுள் 81 கரணங்கள் செதுக்கப்பட்டு எஞ்சியவை முழுமை பெறாமல் உள்ளன"}, "explanation": "பரத முனிவரின் நாட்டிய சாஸ்திரத்தில் கூறப்படும் 108 கரணங்களுள் 81 கரணங்கள் தஞ்சைக் கோயில் முதல் தளத்தில் அழகிய புடைப்புச் சிற்பங்களாக வடிக்கப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "How many Bharatanatyam Karanas are sculpted on the upper circumambulatory tier of the Big Temple?", "media_id": null}], "options": {"A": "64 Karanas", "B": "81 Karanas complete", "C": "100 Karanas", "D": "81 sculptured Karanas out of the classical 108 Karanas"}, "explanation": "Out of 108 Natya Karanas, 81 are exquisitely carved in stone reliefs on the sanctum tier."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "fu