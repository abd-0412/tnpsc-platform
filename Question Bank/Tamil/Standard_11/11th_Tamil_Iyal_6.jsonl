{"id": "11th_tamil_u6_q126", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "mkt_philanthropy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தியாகராஜ பாகவதரின் கொடைத்தன்மை மற்றும் பொதுநலப் பண்பு எத்தகையது?", "media_id": null}], "options": {"A": "செல்வத்தைத் தம்மிடம் மட்டுமே பதுக்கி வைத்தவர்", "B": "இரண்டாம் உலகப் போரின் போதும், தேசிய இயக்கத்திற்கும், ஏழை எளியோரின் பசிப்பிணி போக்கவும் வாரி வாரி வழங்கிய மாபெரும் கொடைவள்ளல்", "C": "கொடை எதையும் தராதவர்", "D": "வெளிநாடுகளுக்கு மட்டுமே தானம் செய்தவர்"}, "explanation": "பாகவதர் தம் வருவாயின் பெரும்பகுதியைத் தர்ம காரியங்களுக்கும், விடுதலைப் போராட்ட நிதிக்கும், போர் நிவாரண நிதிக்கும் வாரி வழங்கிய மாபெரும் கொடை வள்ளலாகத் திகழ்ந்தார்."}, "en": {"blocks": [{"type": "text", "content": "What characterized the philanthropy and public generosity of M. K. Thyagaraja Bhagavathar?", "media_id": null}], "options": {"A": "Hoarded wealth entirely", "B": "Magnanimous philanthropist who donated immense wealth to war relief, national movement, and charity", "C": "Gave no donations", "D": "Donated abroad only"}, "explanation": "He was legendary for his boundless open-handed charity toward the destitute and national causes."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "