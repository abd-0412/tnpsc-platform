{"id": "11th_tamil_u6_q142", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "demonstrative_words", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'அந்த, இந்த, எந்த' என்னும் சுட்டு மற்றும் வினாத் திரிபுகளின் பின் வல்லினம் எவ்வாறமையும்?", "media_id": null}], "options": {"A": "வல்லினம் மிகாது", "B": "வல்லினம் மிகும் (எ.கா: அந்தக் காலம், இந்தப் புத்தகம், எந்தச் சட்டை)", "C": "இடையினம் மிகும்", "D": "ஆய்த எழுத்து தோன்றும்"}, "explanation": "'அந்த, இந்த, எந்த' என்னும் சொற்களின் பின் வரும் வல்லெழுத்துகள் கட்டாயமாக மிகும்."}, "en": {"blocks": [{"type": "text", "content": "How does Vallinam behave following demonstrative adjectives 'Antha', 'Intha' and interrogative 'Entha'?", "media_id": null}], "options": {"A": "Does not geminate", "B": "Strictly geminates (e.g., Antha Kaalam, Intha Puthagam)", "C": "Idaiyinam doubles", "D": "Ayutha letter emerges"}, "explanation": "Following 'Antha', 'Intha', and 'Entha', hard consonants always double."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": null, "section": null, "referen