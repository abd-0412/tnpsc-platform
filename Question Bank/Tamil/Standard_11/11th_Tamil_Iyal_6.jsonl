{"id": "11th_tamil_u6_q035", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "odhuvar_patronage", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயிலில் நாள்தோறும் தேவாரம் பாடுவதற்காக இராஜராஜ சோழன் நியமித்த ஓதுவார்களின் (பிடாரர்கள்) எண்ணிக்கை எத்தனை?", "media_id": null}], "options": {"A": "24 ஓதுவார்கள்", "B": "36 ஓதுவார்கள்", "C": "48 ஓதுவார்கள் (மற்றும் உடுக்கை, கொட்டிமத்தளம் வாசிப்போர் இருவர்)", "D": "64 ஓதுவார்கள்"}, "explanation": "கோயிலில் இடைவிடாது தேவாரம் இசைக்க 48 ஓதுவார்களையும், உடுக்கை மற்றும் கொட்டிமத்தளம் வாசிப்போர் இருவரையும் நியமித்து அவர்களுக்கு நிலக்கொடை அளித்தார்."}, "en": {"blocks": [{"type": "text", "content": "How many hymnists (Odhuvars/Pidaras) did Rajaraja Chola permanently appoint to chant Thevaram verses in the temple?", "media_id": null}], "options": {"A": "24 Odhuvars", "B": "36 Odhuvars", "C": "48 Odhuvars (with two percussionists)", "D": "64 Odhuvars"}, "explanation": "He endowed land grants for 48 dedicated Thevaram hymnists and 2 accompanying percussionists."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "e