{"id": "11th_tamil_u6_q039", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "inscription_democratic_spirit", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'நாம் கொடுத்ததும் நம் அக்கன் கொடுத்ததும் நம் பெண்டுகள் கொடுத்ததும் மற்றும் கொடுத்தார் கொடுத்ததும்...' - இக்கல்வெட்டுத் தொடர் முதலாம் இராஜராஜ சோழனின் எத்தகைய பண்பை உணர்த்துகிறது?", "media_id": null}], "options": {"A": "அரச தற்பெருமை", "B": "பிறரை அடக்கி ஆளும் குணம்", "C": "எல்லோரது கொடைகளையும் சமமாக மதித்துப் பதிவு செய்த மாபெரும் மக்களாட்சிப் பண்பும் பெருந்தன்மையும்", "D": "போர்க்கள வெற்றி முழக்கம்"}, "explanation": "தான் அளித்த கொடைகளோடு தமக்கை, மனைவியர் மற்றும் சாதாரண எளிய மக்கள் அளித்த கொடைகளையும் சமமாக மதித்துக் கல்லில் பொறித்த இராஜராஜனின் பரந்த மனம் இதில் மிளிர்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What noble attribute of Rajaraja Chola is reflected in his inscription recording donations made by himself, his sister, his queens, and others?", "media_id": null}], "options": {"A": "Regal vanity", "B": "Authoritarian domination", "C": "Profound democratic humility honoring every contributor equally on stone", "D": "War boast"}, "explanation": "It exemplifies his democratic ethos in memorializing gifts of commoners alongside royal gifts."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_mul