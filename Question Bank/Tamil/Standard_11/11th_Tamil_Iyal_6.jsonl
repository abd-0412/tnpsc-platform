{"id": "11th_tamil_u6_q136", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "kbs_childhood_struggle", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கே. பி. சுந்தராம்பாள் தம் இளமைக் காலத்தில் எங்குப் பாடித் தம் இசைத் திறமையால் அனைவரையும் கவர்ந்தார்?", "media_id": null}], "options": {"A": "அரண்மனை தர்பாரில்", "B": "வானொலி நிலையத்தில்", "C": "கல்லூரிகளில்", "D": "ஈரோடு-திருச்சி இடையே ஓடும் புகைவண்டிகளில் (தொடர்வண்டிகளில்)"}, "explanation": "வறுமையின் காரணமாகச் சுந்தராம்பாள் சிறுமியாக இருந்தபோது புகைவண்டிகளில் பாடிப் பயணிகளிடம் காசு பெற்றார்; அவரது குரல்வளத்தைக் கண்ட நாடகக் குழுவினர் அவரை நாடகத்திற்கு அழைத்துச் சென்றனர்."}, "en": {"blocks": [{"type": "text", "content": "Where did young K. B. Sundarambal sing during her impoverished childhood before being discovered?", "media_id": null}], "options": {"A": "In royal darbars", "B": "On radio stations", "C": "In colleges", "D": "In passenger trains plying between Erode and Tiruchirappalli"}, "explanation": "She sang in moving passenger trains between Erode and Trichy, captivating commuters before entering theater."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Ser