{"id": "11th_tamil_u6_q183", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "glossary_and_pyq", "chapter_id": null, "topic_id": "pyq_kodumudi_kokilam_title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] கே. பி. சுந்தராம்பாளின் ஊரான 'கொடுமுடி' எந்த ஆற்றுப்படுகையில் அமைந்துள்ளது?", "media_id": null}], "options": {"A": "வைகை ஆறு", "B": "தாமிரபரணி ஆறு", "C": "காவிரி ஆறு (ஈரோடு மாவட்டம்)", "D": "பாலாறு"}, "explanation": "கொடுமுடி காவிரியின் தென்கரையில் அமைந்துள்ள பாடல் பெற்ற வைப்புத் தலமாகும்; இது ஈரோடு மாவட்டத்தில் உள்ளது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] On the banks of which river is K. B. Sundarambal's native town 'Kodumudi' situated?", "media_id": null}], "options": {"A": "Vaigai river", "B": "Thamirabarani river", "C": "Kaveri river (Erode district)", "D": "Palar river"}, "explanation": "Kodumudi is situated on the banks of the Kaveri river in Erode district."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 138", "url": null, "source_notes": null}, "previous_year