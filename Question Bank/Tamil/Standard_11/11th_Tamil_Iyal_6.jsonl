{"id": "11th_tamil_u6_q109", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_thiruchazhal", "chapter_id": null, "topic_id": "speech_of_lord_vedas", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பேசுவதும் திருவாயால் மறைபோலுங் காணேடீ' - இதில் 'மறை' என்பது எதனைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "வேதம் (அறநெறி நூல்கள்)", "B": "மந்திரம்", "C": "இரகசியப் பேச்சு", "D": "மறைந்து பேசுவது"}, "explanation": "'மறை' என்பது வேதங்களையும் அறநெறி நெறிகளையும் குறிக்கும். இறைவன் திருவாயால் உரைப்பதெல்லாம் உலகிற்கு வழிகாட்டும் மறைநூல்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "In 'Pesuvathum thiruvaayaal marai polum kaanedi', what does 'Marai' denote?", "media_id": null}], "options": {"A": "Vedas / Sacred Scriptures", "B": "Magic incantation", "C": "Secret speech", "D": "Hidden whispers"}, "explanation": "'Marai' refers to the sacred Vedas and divine revelations."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 137", "url": null, "source_notes": null}, "previous_year": {"is_previous_