{"id": "11th_tamil_u6_q092", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_thiruchazhal", "chapter_id": null, "topic_id": "manikkavasagar_minister", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாணிக்கவாசகர் துறவறம் பூண்பதற்கு முன் பாண்டிய மன்னன் அரிமர்த்தன பாண்டியனிடம் என்ன பொறுப்பில் இருந்தார்?", "media_id": null}], "options": {"A": "படைத்தளபதி", "B": "அரண்மனைப் புலவர்", "C": "கோயில் கண்காணிப்பாளர்", "D": "தலைமை அமைச்சர் (தென்னவன் பிரம்மராயன்)"}, "explanation": "மாணிக்கவாசகர் அரிமர்த்தன பாண்டிய மன்னனிடம் 'தென்னவன் பிரம்மராயன்' என்ற சிறப்புப் பட்டத்துடன் முதன்மை அமைச்சராகப் பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "What prime position did Manikkavasagar occupy under Pandyan King Arimarthana Pandyan prior to his renunciation?", "media_id": null}], "options": {"A": "Army general", "B": "Court poet", "C": "Temple superintendent", "D": "Chief Prime Minister (bearing the title Thennavan Brahmarayan)"}, "explanation": "He was the Chief Minister bearing the exalted title Thennavan Brahmarayan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter