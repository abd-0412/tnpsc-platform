{"id": "11th_tamil_u6_q014", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "karuvur_thevar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இராஜராஜ சோழனின் ஆன்மீக குருவாகவும், தஞ்சைக் கோயில் லிங்கப் பிரதிஷ்டைக்கு உதவியவராகவும் போற்றப்படும் சித்தர் யார்?", "media_id": null}], "options": {"A": "திருமூலர்", "B": "கருவூர்த் தேவர்", "C": "பட்டினத்தார்", "D": "போகர்"}, "explanation": "கருவூர்த் தேவர் இராஜராஜ சோழனின் குருவாக விளங்கி, தஞ்சைப் பெரிய கோயில் லிங்கப் பிரதிஷ்டையின் போது அஷ்டபந்தன மருந்து சாத்த உதவினார்; இவரது திருவிசைப்பா புகழ்பெற்றது."}, "en": {"blocks": [{"type": "text", "content": "Which revered Saivite siddha and preceptor was the spiritual guru of Rajaraja Chola and composed hymns on Thanjavur?", "media_id": null}], "options": {"A": "Thirumoolar", "B": "Karuvur Thevar", "C": "Pattinathar", "D": "Bogar"}, "explanation": "Karuvur Thevar was the spiritual preceptor to Rajaraja Chola and composed Thiruvisaipa."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 133, "chapter": null, "section": null, "reference": "11th T