{"id": "11th_tamil_u6_q072", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_athmanam_and_kutralam", "chapter_id": null, "topic_id": "athmanam_literary_place", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நவீனத் தமிழ் புதுக்கவிதை உலகில் ஆத்மாநாமின் கவிதைகள் எத்தகைய பண்பினால் தனித்து நிற்கின்றன?", "media_id": null}], "options": {"A": "கடினமான வடமொழிச் சொற்கள் நிறைந்திருப்பதால்", "B": "அரசியல் மேடைப் பேச்சுகள் போலிருப்பதால்", "C": "எதுகை மோனை அணிகள் மட்டுமே நிறைந்திருப்பதால்", "D": "எளிய மொழி, படிம நேர்த்தி, மனித வாழ்வின் தனிமை மற்றும் இருத்தலியல் சிக்கல்களைப் பேசியதால்"}, "explanation": "ஆத்மாநாமின் கவிதைகள் மிக எளிமையான அன்றாடச் சொற்கள் வழியாக நவீன மனிதனின் தனிமை, சுதந்திரம், இருத்தலியல் வேதனைகளை ஆழமாகப் பதிவு செய்தன."}, "en": {"blocks": [{"type": "text", "content": "What distinctive attribute characterizes Athmanam's contribution to modern Tamil free verse?", "media_id": null}], "options": {"A": "Heavy Sanskrit loanwords", "B": "Resembling political speeches", "C": "Ornamental rhyming only", "D": "Deceptively simple diction capturing existential angst, alienation, and surrealist subtlety"}, "explanation": "Athmanam's poetry is renowned for lucid minimalist diction articulating modern existential realities."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book"