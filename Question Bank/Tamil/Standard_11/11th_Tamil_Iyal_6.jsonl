{"id": "11th_tamil_u6_q082", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_athmanam_and_kutralam", "chapter_id": null, "topic_id": "singan_singi_dialogue_style", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குற்றாலக் குறவஞ்சியின் இறுதியில் சிங்கனுக்கும் சிங்கிக்கும் இடையே நடைபெறும் உரையாடல் எத்தகைய சுவை ததும்பப் பாடப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "அவலம்", "B": "மகிழ்ச்சியும் அங்கதமும் கூடிய காதல் ஊடல் நயம் (ஹாஸ்யம் மற்றும் சிருங்காரம்)", "C": "பயானகம்", "D": "வீரம்"}, "explanation": "நீ எங்கே சென்றாய் என்று சிங்கன் ஐயத்துடன் வினவ, சிங்கி சாதுரியமாக விடையளிக்கும் உரையாடல் நகைச்சுவையும் காதல் சுவையும் ததும்பும் அருமையான பகுதியாகும்."}, "en": {"blocks": [{"type": "text", "content": "What poetic sentiment animates the celebrated concluding dialogue between Singan and Singi?", "media_id": null}], "options": {"A": "Pathos (Avalam)", "B": "Playful witty lovers quarrel filled with humor and romantic banter", "C": "Terror (Bhayanakam)", "D": "Heroism (Veeram)"}, "explanation": "The exchange is celebrated for its sparkling wit, romantic teasing, and humorous charm."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "te