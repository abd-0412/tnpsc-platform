{"id": "11th_tamil_u6_q071", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_athmanam_and_kutralam", "chapter_id": null, "topic_id": "courtallam_natural_scenes", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திரிகூட மலை (குற்றால மலை) எந்த மாவட்டத்தின் இயற்கை எழிலாகத் திகழ்கிறது?", "media_id": null}], "options": {"A": "கன்னியாகுமரி", "B": "மதுரை", "C": "தென்காசி (பழைய திருநெல்வேலி மாவட்டம்)", "D": "நீலகிரி"}, "explanation": "திரிகூட மலை அல்லது குற்றால மலை மேற்குத் தொடர்ச்சி மலையில் தென்காசி மாவட்டத்தில் அமைந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "In which modern district of Tamil Nadu is Mount Thirikoodam (Kutralam Hill) situated?", "media_id": null}], "options": {"A": "Kanyakumari", "B": "Madurai", "C": "Tenkasi (formerly Tirunelveli district)", "D": "Nilgiris"}, "explanation": "Mount Thirikoodam is situated in the Western Ghats within Tenkasi district."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 135, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 135", "url": null, "source_notes": null}, "previous_year": {"is_previous_year"