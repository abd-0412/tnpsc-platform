{"id": "11th_tamil_u6_q111", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_thiruchazhal", "chapter_id": null, "topic_id": "manikkavasagar_liberation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாணிக்கவாசகர் சிவபெருமானோடு இரண்டறக் கலந்து முக்தி அடைந்த தலம் எது?", "media_id": null}], "options": {"A": "மதுரை", "B": "திருப்பெருந்துறை", "C": "தில்லை சிதம்பரம்", "D": "திருவண்ணாமலை"}, "explanation": "மாணிக்கவாசகர் தில்லை சிதம்பரம் நடராஜர் சந்நிதியில் ஜோதியோடு இரண்டறக் கலந்து முக்தி அடைந்தார் என்று சைவ மரபு கூறுகிறது."}, "en": {"blocks": [{"type": "text", "content": "At which sacred shrine did saint Manikkavasagar attain final liberation (Mukti) merging into the divine effulgence?", "media_id": null}], "options": {"A": "Madurai", "B": "Thirupperunthurai", "C": "Thillai Chidambaram", "D": "Thiruvannamalai"}, "explanation": "According to Saivite tradition, Manikkavasagar merged into the divine light at Chidambaram."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 137", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 6", "Poetry", "Thiruchazhal"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u6_q112", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_thiruchazhal", "chapter_id": null, "topic_id": "chazhal_educational_significance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருச்சாழல் பாடல்கள் உணர்த்தும் ஆன்மீக மற்றும் அழகியல் சிறப்பு யாது?", "media_id": null}], "options": {"A": "கடினமான வடமொழித் தத்துவங்கள் மட்டுமே அமைந்திருப்பது", "B": "நாட்டுப்புற விளையாட்டு வடிவம் வழிபாட்டுக்கு ஏற்றதல்ல என்பது", "C": "மக்களை அச்சுறுத்தும் சமயம் என்பது", "D": "மக்களின் எளிய விளையாட்டுப் பண்பாட்டின் ஊடாக ஆழமான வேதாந்த-சித்தாந்த மெய்ப்பொருளை எளிமையாகப் புகட்டிய கலைப் பேரழகு"}, "explanation": "பெண்களின் எளிய நாட்டுப்புற விளையாட்டுப் பாடல் வழியாகவே இறைவனின் மெய்ப்பொருளையும் உயர்ந்த தத்துவங்களையும் விளக்கிய உன்னத அழகியலைத் திருச்சாழல் வெளிப்படுத்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the supreme literary and spiritual brilliance of Thiruchazhal?", "media_id": null}], "options": {"A": "Abstruse Sanskrit metaphysics only", "B": "Discarding folk forms as unworthy", "C": "Invoking fearful superstition", "D": "Transmitting profound philosophical truths through the joyful medium of women folk gameplay"}, "explanation": "It democratized profound theology through vibrant folk gaming poetry."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "so