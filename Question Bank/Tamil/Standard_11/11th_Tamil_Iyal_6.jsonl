{"id": "11th_tamil_u6_q095", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_thiruchazhal", "chapter_id": null, "topic_id": "holy_ash_significance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பூசுவதும் வெண்ணீறு' - சிவபெருமான் திருமேனி முழுவதும் திருநீறு பூசியிருப்பதன் மெய்யியல் கருத்து யாது?", "media_id": null}], "options": {"A": "வெயிலில் இருந்து தற்காத்துக் கொள்ள", "B": "அழகாகத் தோன்றுவதற்கு", "C": "முடிவில் அனைத்தும் சாம்பலாகும் என்னும் நிலையாமைத் தத்துவத்தை உணர்த்த", "D": "வெண்மை நிறத்தை விரும்பியதால்"}, "explanation": "இறைவன் பூசியுள்ள வெண்ணீறு என்பது இவ்வுலகப் பொருட்கள் அனைத்தும் இறுதியில் அழியக்கூடிய நிலையற்றவை என்னும் நிலையாமைத் தத்துவத்தை நினைவூட்டுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What esoteric truth is conveyed by Shiva smearing sacred white ash (Poosuvathum Venneeru)?", "media_id": null}], "options": {"A": "Sunscreen protection", "B": "Cosmetic enhancement", "C": "Reminder of universal transience: all empirical matter ultimately reduces to ash", "D": "Preference for white color"}, "explanation": "Sacred ash represents absolute purity and the profound philosophical truth of universal transience."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textboo