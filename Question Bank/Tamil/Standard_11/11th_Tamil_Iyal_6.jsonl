{"id": "11th_tamil_u6_q004", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "temple_historic_name", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இராஜராஜ சோழன் கல்வெட்டுகளில் இக்கோயிலுக்குச் சூட்டியுள்ள இயற்பெயர் யாது?", "media_id": null}], "options": {"A": "பிரகதீஸ்வரர் கோயில்", "B": "கங்கை கொண்ட சோழீஸ்வரம்", "C": "ஐராவதேஸ்வரர் கோயில்", "D": "இராஜராஜேச்சுரம்"}, "explanation": "மாமன்னன் இராஜராஜ சோழன் கல்வெட்டுகளில் இக்கோயிலைத் தான் அமைத்த 'இராஜராஜேச்சுரம்' என்றே பதிவு செய்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "What was the original historical name assigned to the temple in Rajaraja Chola's inscriptions?", "media_id": null}], "options": {"A": "Brihadisvara Temple", "B": "Gangaikonda Choleswaram", "C": "Airavatesvara Temple", "D": "Rajarajeswaram"}, "explanation": "Rajaraja Chola designated this temple in contemporary lithic records as 'Rajarajeswaram'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 130, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 130", "url": null, "sourc