{"id": "11th_tamil_u6_q036", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "talicheri_penduggal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயிலில் கலைப் பணியாற்றுவதற்காகத் தமிழகத்தின் பல்வேறு கோயில்களிலிருந்து வரவழைக்கப்பட்ட நாட்டியப் பெண்களின் (தளிச்சேரிப் பெண்கள்) எண்ணிக்கை எத்தனை?", "media_id": null}], "options": {"A": "100 பேர்", "B": "200 பேர்", "C": "300 பேர்", "D": "400 பேர்"}, "explanation": "கோயில் திருப்பணிக்காக 400 தளிச்சேரிப் பெண்கள் நியமிக்கப்பட்டு, அவர்கள் தங்குவதற்குக் கோயிலைச் சுற்றிலும் மனைகளும் வீடுகளும் வழங்கப்பட்டு அவர்தம் பெயர்கள் கல்வெட்டுகளில் பதியப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "How many accomplished classical dancers (Thalicheri Pendugal) were invited and settled around the Big Temple?", "media_id": null}], "options": {"A": "100 dancers", "B": "200 dancers", "C": "300 dancers", "D": "400 dancers"}, "explanation": "400 temple dancers were endowed with residential houses and their names engraved on the temple walls."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-202