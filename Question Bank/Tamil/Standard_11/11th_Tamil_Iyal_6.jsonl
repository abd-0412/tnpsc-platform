{"id": "11th_tamil_u6_q103", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_thiruchazhal", "chapter_id": null, "topic_id": "manikkavasagar_century", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வரலாற்று ஆய்வாளர்களின்படி மாணிக்கவாசகர் வாழ்ந்த காலம் எது?", "media_id": null}], "options": {"A": "கி.பி. 6-ஆம் நூற்றாண்டு", "B": "கி.பி. 7-ஆம் நூற்றாண்டு", "C": "கி.பி. 9-ஆம் நூற்றாண்டு (வரகுண பாண்டியன் காலம்)", "D": "கி.பி. 12-ஆம் நூற்றாண்டு"}, "explanation": "மாணிக்கவாசகர் கி.பி. 9-ஆம் நூற்றாண்டில் வரகுண பாண்டியனின் சமகாலத்தில் வாழ்ந்தவர் என்பது பெரும்பான்மை வரலாற்று அறிஞர்களின் முடிவாகும்."}, "en": {"blocks": [{"type": "text", "content": "According to predominant historical consensus, in which century did Manikkavasagar flourish?", "media_id": null}], "options": {"A": "6th century CE", "B": "7th century CE", "C": "9th century CE (era of Varaguna Pandya)", "D": "12th century CE"}, "explanation": "He is historically placed in the 9th century CE under King Varaguna Pandya."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "11th Tam