{"id": "11th_tamil_u6_q147", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "vantodar_kutriyalukaram", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வன்தொடர்க் குற்றியலுகரச் சொற்களின் பின் வல்லினம் எவ்வாறமையும்?", "media_id": null}], "options": {"A": "வல்லினம் மிகாது", "B": "ஆய்தம் மிகும்", "C": "வல்லினம் மிகும் (எ.கா: பத்துப் பாட்டு, சுக்குத் தூள், கற்றுக் கொடுத்தான், எட்டுத் தொகை)", "D": "மெல்லினம் மிகும்"}, "explanation": "க, ச, த, ப, ற, ட ஆகிய வல்லெழுத்துகளைத் தொடர்ந்து வரும் வன்தொடர்க் குற்றியலுகரத்தின் பின் வல்லினம் மிகும்."}, "en": {"blocks": [{"type": "text", "content": "How does Vallinam behave after hard-consonant shortened 'U' roots (Vantodar Kutriyalukaram)?", "media_id": null}], "options": {"A": "Does not double", "B": "Ayutham doubles", "C": "Strictly geminates (e.g., Pathup paattu, Sukkut thool, Ettuth thokai)", "D": "Nasal doubles"}, "explanation": "Vantodar Kutriyalukaram words demand gemination of following hard consonants."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": null, "section": n