{"id": "11th_tamil_u6_q108", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_thiruchazhal", "chapter_id": null, "topic_id": "thiruchazhal_literary_merit", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாட்டுப்புற மகளிர் விளையாட்டு வடிவத்தைப் பக்தி இலக்கியத்திற்குள் முதன்முதலாகப் புகுத்தி ஆன்மீகப் புரட்சி செய்த பெருமை யாருக்குரியது?", "media_id": null}], "options": {"A": "அப்பர்", "B": "சம்பந்தர்", "C": "சுந்தரர்", "D": "மாணிக்கவாசகர் (அம்மானை, சாழல், ஊசல், தெள்ளேணம், பூவல்லி என நாட்டுப்புற மகளிர் பாடல்களைப் பாடியவர்)"}, "explanation": "மாணிக்கவாசகர் மகளிர் விளையாட்டுகளான அம்மானை, சாழல், ஊசல், சுண்ணம் இடித்தல் முதலான நாட்டுப்புற வடிவங்களைப் பக்தி இலக்கியத்தில் புகுத்திப் பாடிய பெரும் முன்னோடி ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who pioneered integrating folk games of women (such as Ammanai, Chazhal, Oonjal) into devotional classical poetry?", "media_id": null}], "options": {"A": "Appar", "B": "Sambanthar", "C": "Sundarar", "D": "Manikkavasagar"}, "explanation": "Manikkavasagar uniquely elevated traditional feminine folk games into spiritual literature."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "f