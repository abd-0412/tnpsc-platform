{"id": "11th_tamil_u6_q046", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "meikeerthi_tradition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கல்வெட்டுகளின் தொடக்கத்தில் மன்னனின் போர் வெற்றிகளையும் அவனது ஆட்சிக் காலச் சிறப்புகளையும் கவிதை வடிவில் பதிவு செய்யும் 'மெய்க்கீர்த்தி' மரபைத் தோற்றுவித்த பெருமைக்குரிய மன்னன் யார்?", "media_id": null}], "options": {"A": "முதலாம் பராந்தக சோழன்", "B": "முதலாம் இராஜராஜ சோழன் (\"திருமகள் போல பெருநிலச் செல்வியும்...\" தொடங்கும் மெய்க்கீர்த்தி)", "C": "விஜயாலய சோழன்", "D": "இரண்டாம் குலோத்துங்க சோழன்"}, "explanation": "முதலாம் இராஜராஜ சோழனே தன் கல்வெட்டுகளின் தொடக்கத்தில் 'திருமகள் போல...' எனத் தொடங்கும் முறையான வரலாற்று மெய்க்கீர்த்தியை அமைக்கும் மரபைத் தோற்றுவித்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which emperor pioneered the royal poetic preamble 'Meikeerthi' detailing genealogical and military history on stone?", "media_id": null}], "options": {"A": "Parantaka Chola I", "B": "Rajaraja Chola I (beginning with \"Thirumagal pola...\")", "C": "Vijayalaya Chola", "D": "Kulothunga Chola II"}, "explanation": "Rajaraja Chola I inaugurated the historical Meikeerthi tradition in epigraphy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Ta