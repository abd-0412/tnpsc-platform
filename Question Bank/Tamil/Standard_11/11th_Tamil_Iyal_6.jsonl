{"id": "11th_tamil_u6_q012", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "chief_architects", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயிலின் தலைமைத் தச்சர்களாகவும் சிற்பிகளாகவும் கல்வெட்டுகளில் குறிப்பிடப்படுபவர்கள் யார்?", "media_id": null}], "options": {"A": "கருவூர்த் தேவர் மற்றும் சேந்தனார்", "B": "குணவன் மற்றும் கூத்தன்", "C": "அடியார்க்குநல்லார் மற்றும் பரிமேலழகர்", "D": "வீரசோழன் குஞ்சர மல்லன் ஆன இராஜராஜப் பெருந்தச்சன் மற்றும் நித்தவிநோதப் பெருந்தச்சன்"}, "explanation": "கல்வெட்டுகள் 'வீரசோழன் குஞ்சர மல்லன் ஆன இராஜராஜப் பெருந்தச்சன்', 'இளங்கோவன் ஆன நித்தவிநோதப் பெருந்தச்சன்' ஆகியோரைத் தலைமைச் சிற்பிகளாகக் குறிப்பிடுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Who are honored in the temple inscriptions as the master architects and chief sculptors?", "media_id": null}], "options": {"A": "Karuvur Thevar and Senthanar", "B": "Gunavan and Koothan", "C": "Adiyarkkunallar and Parimelazhagar", "D": "Veeracholan Kunjara Mallan alias Rajaraja Perunthachan and Nitthavinotha Perunthachan"}, "explanation": "Rajaraja Perunthachan and Nitthavinotha Perunthachan are recorded as chief architects."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samach