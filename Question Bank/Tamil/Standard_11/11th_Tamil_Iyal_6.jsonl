{"id": "11th_tamil_u6_q110", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_thiruchazhal", "chapter_id": null, "topic_id": "universal_grace", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஆய பெருங்கருணை யாரறிவார் சாழலோ' - இத்தொடர் உணர்த்தும் முடிவான கருத்து யாது?", "media_id": null}], "options": {"A": "இறைவன் கொடுமையானவன்", "B": "இறைவனின் அளப்பரிய பெருங்கருணையை எளிய மனித அறிவால் முழுமையாக அளந்தறிய முடியாது", "C": "கருணை தேவையற்றது", "D": "இறைவன் மனிதர்களை வெறுக்கிறான்"}, "explanation": "இறைவன் புறத்தோற்றத்தில் சுடுகாட்டில் இருந்தாலும் அவனது பேரருளும் பெருங்கருணையும் எவராலும் அளவிட முடியாத விந்தையானது என்பதை உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the profound philosophical culmination of 'Aaya perungarunai yaararivaar chazhalo'?", "media_id": null}], "options": {"A": "God is merciless", "B": "The infinite boundless compassion of the Supreme Divine transcends finite mortal intellect", "C": "Mercy is superfluous", "D": "God dislikes humanity"}, "explanation": "It underscores that the boundless divine mercy surpasses human comprehension."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "