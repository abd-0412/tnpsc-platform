{"id": "11th_tamil_u6_q010", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "stone_quarry_distance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சாவூர்ப் பகுதியில் பாறைகளே இல்லாத நிலையில், பெரிய கோயிலைக் கட்டத் தேவையான கருங்கற்கள் எங்கிருந்து கொண்டு வரப்பட்டன?", "media_id": null}], "options": {"A": "ஆந்திர மலைகளிலிருந்து", "B": "நார்த்தாமலை, மாம்மலை மற்றும் திருச்சி குன்னாண்டார்கோவில் பாறைகளிலிருந்து", "C": "தஞ்சையின் அருகிலுள்ள கொள்ளிட ஆற்றுப்படுகையிலிருந்து", "D": "கேரளக் காடுகளிலிருந்து"}, "explanation": "தஞ்சைச் சமவெளியில் பாறைகள் இல்லாததால், புதுக்கோட்டை நார்த்தாமலை மற்றும் திருச்சி வட்டாரப் பாறைகளிலிருந்து யானைகள், படகுகள் மூலம் கற்கள் கொண்டுவரப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "Since Thanjavur delta has no rocks, from where were the granite blocks transported to build the Big Temple?", "media_id": null}], "options": {"A": "Andhra hills", "B": "Narthamalai, Mammalai, and Kunnamalai granite quarries near Trichy and Pudukkottai", "C": "Kollidam river bed", "D": "Kerala forests"}, "explanation": "Granite was quarried from Narthamalai and Trichy hills and transported via rafts and elephants."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 131, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 131", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 6", "Prose", "Thanjavur Big Temple"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u6_q011", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "upapeedam_dimension", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயிலின் மாபெரும் அடித்தளம் (உபபீடம் மற்றும் அதிட்டானம்) எத்தனை அடுக்குக் கருங்கற்களால் தாங்கப்படுகிறது?", "media_id": null}], "options": {"A": "ஒற்றை அடுக்கு", "B": "இரு அடுக்கு", "C": "பல அடுக்குக் கருங்கல் தளம் (செவ்வக மாபெரும் தளம்)", "D": "செங்கல் தளம் மட்டுமே"}, "explanation": "216 அடி உயர விமானத்தின் பெரும் பாரத்தைத் தாங்குவதற்காக அகலமான, மிக ஆழமான, பல அடுக்குக் கருங்கற்களால் ஆன உபபீட அடித்தளம் அமைக்கப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "How is the monumental base foundation (Upapeedam & Adhisthana) of the Big Temple constructed to bear the 216-foot Vimana?", "media_id": null}], "options": {"A": "Single-course rubble", "B": "Double-layered masonry", "C": "Massive multi-tiered interlocking granite plinth", "D": "Brick mortar base only"}, "explanation": "It is engineered on a colossal multi-tiered interlocking granite plinth of unmatched stability."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "clas