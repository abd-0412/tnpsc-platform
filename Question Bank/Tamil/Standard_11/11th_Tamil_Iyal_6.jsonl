{"id": "11th_tamil_u6_q013", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "unesco_heritage_year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "யுனெஸ்கோ (UNESCO) நிறுவனம் தஞ்சைப் பெரிய கோயிலை உலகப் பாரம்பரியச் சின்னமாக அறிவித்த ஆண்டு எது?", "media_id": null}], "options": {"A": "1987", "B": "1995", "C": "2004", "D": "2010"}, "explanation": "யுனெஸ்கோ நிறுவனம் 1987-ஆம் ஆண்டு தஞ்சைப் பெரிய கோயிலை 'உலகப் பண்பாட்டுப் பாரம்பரியச் சின்னமாக' (World Heritage Site) அறிவித்தது."}, "en": {"blocks": [{"type": "text", "content": "In which year did UNESCO designate the Thanjavur Big Temple as a World Heritage Site?", "media_id": null}], "options": {"A": "1987", "B": "1995", "C": "2004", "D": "2010"}, "explanation": "UNESCO inscribed Thanjavur Big Temple as a World Heritage Monument in 1987."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 133, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 133", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year"