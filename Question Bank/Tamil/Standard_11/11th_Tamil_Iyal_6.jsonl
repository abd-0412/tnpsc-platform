{"id": "11th_tamil_u6_q025", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "sculptor_respect", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இராஜராஜ சோழன் தமக்கும் தம் அரச குடும்பத்தாருக்கும் கொடை தந்தவர்களுக்கும் கல்வெட்டுப் பொறித்தது போல, தச்சர்களுக்கும் சிற்பிகளுக்கும் எத்தகைய அங்கீகாரம் தந்தார்?", "media_id": null}], "options": {"A": "தலைமைத் தச்சர்களின் பெயர்களையும் கொடைகளையும் கோயில் சுவர்களிலேயே கல்வெட்டுகளாகப் பொறித்துப் போற்றினார்", "B": "பொற்காசுகள் மட்டுமே தந்து அனுப்பினார்", "C": "நாட்டை விட்டு வெளியேற்றினார்", "D": "எந்தக் கல்வெட்டிலும் பெயர் பொறிக்கவில்லை"}, "explanation": "இராஜராஜ சோழன் கட்டிடக் கலை வல்லுநர்களான தலைமைத் தச்சர்களின் பெயர்களைக் கோயில் சுவரில் கல்வெட்டாகப் பொறித்து வரலாற்றுச் சிறப்புமிக்க கௌரவத்தை அளித்தார்."}, "en": {"blocks": [{"type": "text", "content": "How did Rajaraja Chola uniquely honor the master sculptors and architects?", "media_id": null}], "options": {"A": "Inscribing the master architects names indelibly on the temple walls alongside royalty", "B": "Paid gold coins only without inscription", "C": "Exiled them from the kingdom", "D": "Omitted their names entirely"}, "explanation": "Rajaraja honored master craftsmen by engraving their names and titles on the temple stones."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0,