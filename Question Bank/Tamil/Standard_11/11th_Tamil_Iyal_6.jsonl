{"id": "11th_tamil_u6_q018", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "nandi_mandapam_period", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயிலின் முகப்பில் அமைந்துள்ள பிரம்மாண்டமான நந்தி மற்றும் நந்தி மண்டபம் எந்தக் காலத்தைச் சேர்ந்தது?", "media_id": null}], "options": {"A": "சோழர் காலம்", "B": "நாயக்கர் காலம்", "C": "மராட்டியர் காலம்", "D": "பல்லவர் காலம்"}, "explanation": "தற்போது நாம் காணும் பெரிய ஒற்றைக்கல் நந்தியும் நந்தி மண்டபமும் பிற்காலத்தில் தஞ்சையை ஆண்ட நாயக்க மன்னர்களால் அமைக்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "To which historical dynasty does the current colossal monolithic Nandi and its pavilion belong?", "media_id": null}], "options": {"A": "Chola period", "B": "Nayaka period", "C": "Maratha period", "D": "Pallava period"}, "explanation": "The monolithic Nandi pavilion seen today was constructed during the Thanjavur Nayaka rule."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 132, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 132", 