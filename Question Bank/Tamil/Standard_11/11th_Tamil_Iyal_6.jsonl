{"id": "11th_tamil_u6_q005", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "dakshina_meru", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயிலின் மாபெரும் விமானத்தை வடநாட்டுக் கைலாய மலைக்கு ஒப்பாகக் கருதி எவ்வாறு அழைத்தனர்?", "media_id": null}], "options": {"A": "தட்சிண மேரு", "B": "உத்தர மேரு", "C": "பூர்வ மேரு", "D": "மேற்கு மேரு"}, "explanation": "இமயத்தின் மேருமலைக்கு ஒப்பாகத் தென்னகத்தில் உயர்ந்தோங்கி நின்ற காரணத்தால் இராஜராஜ சோழன் இதனைத் 'தட்சிண மேரு' எனப் போற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Considering its monumental height comparable to Mount Meru, how was the Thanjavur Vimana praised?", "media_id": null}], "options": {"A": "Dakshina Meru", "B": "Utthara Meru", "C": "Poorva Meru", "D": "Paschima Meru"}, "explanation": "The Vimana was venerated as 'Dakshina Meru' (Meru of the South)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 131, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 131", "url": null, "source_notes": null}, "previous_year": {"is_previo