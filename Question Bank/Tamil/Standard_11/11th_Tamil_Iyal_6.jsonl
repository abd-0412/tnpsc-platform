{"id": "11th_tamil_u6_q148", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "ezhuvai_non_gemination", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எழுவாய்த் தொடரில் (பெயர்ச்சொல் எழுவாயாக நிற்கும் தொடரில்) வல்லினம் எவ்வாறமையும்?", "media_id": null}], "options": {"A": "எப்போதும் மிகும்", "B": "சில இடங்களில் மிகும்", "C": "இரட்டிக்கும்", "D": "வல்லினம் ஒருபோதும் மிகாது (எ.கா: தம்பி படித்தான், குதிரை தாண்டியது, கிளி பேசியது)"}, "explanation": "எழுவாயைத் தொடர்ந்து பயனிலை வரும் எழுவாய்த் தொடரில் வல்லினம் மிகாது (தம்பி படித்தான், நிலவு காய்ந்தது)."}, "en": {"blocks": [{"type": "text", "content": "What is the rule regarding Vallinam in nominative subject-predicate phrases (Ezhuvai Thodar)?", "media_id": null}], "options": {"A": "Always geminates", "B": "Geminates randomly", "C": "Doubles unconditionally", "D": "Never geminates (e.g., Thambi padithaan, Kuthirai thaandiyathu)"}, "explanation": "Nominative subject noun phrases do not permit hard consonant doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 142, "chapter": null