{"id": "11th_tamil_u6_q144", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "vinai_thogai_non_gemination", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வினைத்தொகையில் வல்லினம் மிகுமா, மிகாதா? பொருத்தமான சான்றைத் தேர்க:", "media_id": null}], "options": {"A": "வல்லினம் மிகும் (எ.கா: ஊறுக் காய்)", "B": "சில இடங்களில் மிகும் (எ.கா: குடித்தத் தண்ணீர்)", "C": "எப்போதும் மிகும் (எ.கா: சுடுஞ் சோறு)", "D": "வினைத்தொகையில் வல்லினம் ஒருபோதும் மிகாது (எ.கா: ஊறுகாய், சுடுசோறு, பாய்புலி, அலைகடல்)"}, "explanation": "முக்காலமும் தொக்கி நிற்கும் வினைத்தொகையில் வல்லினம் ஒருபோதும் மிகக் கூடாது (ஊறுகாய், சுடுசோறு, கொள்புலி)."}, "en": {"blocks": [{"type": "text", "content": "Does Vallinam geminate in a verb compound (Vinai Thogai)? Select the accurate rule and example:", "media_id": null}], "options": {"A": "Geminates always", "B": "Geminates selectively", "C": "Doubles unconditionally", "D": "Never geminates in Vinai Thogai (e.g., Oorukai, Sudusoru, Paaypuli)"}, "explanation": "In Vinai Thogai (tense-embedded verbal compounds), hard consonants never double."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "cl