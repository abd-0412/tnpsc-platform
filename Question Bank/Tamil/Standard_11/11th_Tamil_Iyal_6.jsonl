{"id": "11th_tamil_u6_q139", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "kbs_honor_title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கே. பி. சுந்தராம்பாளின் இசையையும் நடிப்பையும் கண்டு பாராட்டி அவருக்கு 'இசைக்குயில்' என்ற பட்டத்தை வழங்கியவர் யார்?", "media_id": null}], "options": {"A": "மகாத்மா காந்தி", "B": "ஜவஹர்லால் நேரு", "C": "அறிஞர் அண்ணா மற்றும் தமிழ் சான்றோர் பெருமக்கள்", "D": "வ. உ. சி."}, "explanation": "அறிஞர் அண்ணா உள்ளிட்ட தமிழ்ச் சான்றோர்கள் சுந்தராம்பாளை 'இசைக்குயில்' என்றும் 'கொடுமுடி கோகிலம்' என்றும் போற்றிக் கொண்டாடினர்."}, "en": {"blocks": [{"type": "text", "content": "Who hailed K. B. Sundarambal as 'Isaikkuyil' in recognition of her peerless voice?", "media_id": null}], "options": {"A": "Mahatma Gandhi", "B": "Jawaharlal Nehru", "C": "Perarignar Anna and Tamil literary savants", "D": "V. O. Chidambaranar"}, "explanation": "Tamil scholars and Perarignar Anna celebrated her with the title 'Isaikkuyil'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "re