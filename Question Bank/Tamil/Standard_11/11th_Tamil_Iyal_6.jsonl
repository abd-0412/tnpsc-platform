{"id": "11th_tamil_u6_q069", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_athmanam_and_kutralam", "chapter_id": null, "topic_id": "genre_definition_kuravanji", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் சிற்றிலக்கியங்களில் 'குறவஞ்சி' எவ்வகை இலக்கிய வடிவில் பாடப்படும் நாடக நூலாகும்?", "media_id": null}], "options": {"A": "பாட்டும் உரையாடலும் தாளமும் இணைந்த இசை நாடக வடிவம் (குறத்திப்பாட்டு)", "B": "தனிப்பாடல் வடிவம் மட்டுமே", "C": "வெண்பாக்களால் ஆன அறநூல்", "D": "உரைநடை நூல் மட்டுமே"}, "explanation": "குறவஞ்சி என்பது பாட்டும், தாளமும், சிந்துப் பாடல்களும், உரையாடல்களும் விரவி வரும் தமிழின் உன்னதமான மரபுவழி இசை நாடக வடிவமாகும்."}, "en": {"blocks": [{"type": "text", "content": "To which dramatic genre of Tamil minor literature (Prabandham) does Kuravanji belong?", "media_id": null}], "options": {"A": "Musical dance drama (Kurathippattu) blending lyric, rhythm, and lively dialogue", "B": "Stray solitary verses", "C": "Didactic Venba verses only", "D": "Prose narrative only"}, "explanation": "Kuravanji is a musical dance-drama genre combining song, dance, rhythm, and dramatic dialogue."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "