{"id": "11th_tamil_u6_q054", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "sculpture_nandi_weight", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயிலின் நாயக்கர் காலத்து ஒற்றைக்கல் நந்தியின் பரிமாணங்கள் எத்தகையவை?", "media_id": null}], "options": {"A": "5 அடி நீளம், 3 அடி உயரம்", "B": "ஏறத்தாழ 19 அடி நீளம், 12 அடி உயரம், 25 டன் எடை", "C": "50 அடி நீளம்", "D": "10 அடி நீளம், 5 அடி உயரம்"}, "explanation": "இப்பெரிய நந்தியானது ஏறத்தாழ 19 அடி நீளமும் 12 அடி உயரமும் கொண்டு ஒற்றைக் கருங்கல்லால் செதுக்கப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "What are the approximate dimensions of the monolithic Nandi statue at Thanjavur?", "media_id": null}], "options": {"A": "5 ft length, 3 ft height", "B": "Approx. 19 feet in length, 12 feet in height, weighing 25 tonnes", "C": "50 ft length", "D": "10 ft length, 5 ft height"}, "explanation": "The monolithic Nandi is 19 feet long and 12 feet high, carved from a single granite block."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 132, "chapter": null, "se