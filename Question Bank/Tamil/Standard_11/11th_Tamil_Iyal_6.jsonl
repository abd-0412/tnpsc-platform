{"id": "11th_tamil_u6_q149", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "uruvagam_and_thisai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உருவகத் தொடர்களிலும் திசைப்பெயர்களின் பின்னும் வல்லினம் _____?", "media_id": null}], "options": {"A": "கட்டாயமாக மிகும் (எ.கா: தமிழ்த்தாய், முகத்தாமரை; கிழக்குப் பக்கம், வடக்குத் திசை)", "B": "வல்லினம் மிகாது", "C": "திசைப்பெயர்களில் மட்டும் மிகும்", "D": "உருவகத்தில் மட்டும் மிகும்"}, "explanation": "உருவகத் தொடர்களிலும் (தமிழ்த்தாய், மலர்க்கை) திசைப்பெயர்களின் பின்னும் (கிழக்குப் பக்கம், தெற்குத் தெரு) வல்லினம் கட்டாயமாக மிகும்."}, "en": {"blocks": [{"type": "text", "content": "In metaphorical compounds (Uruvagam) and directional names (Thisaippeyar), do plosives geminate?", "media_id": null}], "options": {"A": "Strictly geminate (e.g., Thamizhth thaai, Mugath thaamarai; Kizhakkup pakkam)", "B": "Never geminate", "C": "Geminate in directions only", "D": "Geminate in metaphors only"}, "explanation": "Both metaphorical compound phrases and cardinal directions mandate hard consonant doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 141", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 6", "Grammar", "Sandhi"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u6_q150", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "ummai_thogai_non_gemination", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உம்மைத்தொகையில் வல்லினம் எவ்வாறமையும்?", "media_id": null}], "options": {"A": "வல்லினம் மிகும்", "B": "வல்லினம் மிகாது (எ.கா: தாய்தந்தை, இரவுபகல், கபிலபரணர், சேரசோழபாண்டியர்)", "C": "சில இடங்களில் மிகும்", "D": "மெல்லினம் மிகும்"}, "explanation": "'உம்' என்னும் உருபு மறைந்து வரும் உம்மைத்தொகையில் வல்லினம் மிகக் கூடாது (தாய்தந்தை, அண்ணன்தம்பி)."}, "en": {"blocks": [{"type": "text", "content": "How does Vallinam behave in coordinate copulative compounds (Ummaithogai)?", "media_id": null}], "options": {"A": "Geminates strictly", "B": "Does not geminate (e.g., Thaai-thanthai, Iravu-pagal, Kabila-paranar)", "C": "Geminates optionally", "D": "Mellinam doubles"}, "explanation": "In coordinate compounds where 'um' is elided, plosives never double."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 142, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 142", "ur