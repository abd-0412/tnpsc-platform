{"id": "11th_tamil_u6_q161", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "aththanai_iththanai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'அத்தனை, இத்தனை, எத்தனை' என்னும் சொற்களின் பின் வல்லினம் எவ்வாறமையும்?", "media_id": null}], "options": {"A": "வல்லினம் மிகாது (எ.கா: அத்தனை பெரிய, இத்தனை புத்தகம், எத்தனை கோடி)", "B": "வல்லினம் கட்டாயமாக மிகும்", "C": "மெல்லினம் மிகும்", "D": "ஆய்தம் தோன்றும்"}, "explanation": "'அத்தனை, இத்தனை, எத்தனை' ஆகியவற்றின் பின் வல்லினம் மிகாது. (ஆனால் 'அப்படி, இப்படி, எப்படி' ஆகியவற்றின் பின் வல்லினம் மிகும்)."}, "en": {"blocks": [{"type": "text", "content": "What is the Sandhi rule following quantifiers 'Aththanai', 'Iththanai', 'Eththanai'?", "media_id": null}], "options": {"A": "Vallinam does not geminate (e.g., Aththanai periya, Eththanai kodi)", "B": "Vallinam strictly geminates", "C": "Mellinam doubles", "D": "Ayutham appears"}, "explanation": "Unlike 'Appadi', the quantifiers 'Aththanai', 'Iththanai', 'Eththanai' do not double following plosives."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-20