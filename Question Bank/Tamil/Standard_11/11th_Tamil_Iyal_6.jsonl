{"id": "11th_tamil_u6_q099", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_thiruchazhal", "chapter_id": null, "topic_id": "naripariyakkal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாணிக்கவாசகருக்காகச் சிவபெருமான் நரிகளைக் குதிரைகளாக்கி (பரிகளாக்கி) மதுரைக்கு ஓட்டி வந்த அற்புதம் நிகழ்ந்த திருத்தலம் எது?", "media_id": null}], "options": {"A": "சிதம்பரம்", "B": "திருவண்ணாமலை", "C": "திருப்பெருந்துறை (ஆவுடையார்கோவில்)", "D": "திருச்சி"}, "explanation": "திருப்பெருந்துறையில் (ஆவுடையார்கோவில்) குருந்த மரத்தடியில் மாணிக்கவாசகருக்குச் சிவபெருமான் குருவாகக் காட்சியளித்து உபதேசித்தார்; பின்னர் நரியைப் பரியாக்கினார்."}, "en": {"blocks": [{"type": "text", "content": "At which sacred shrine did Lord Shiva manifest as guru under the Kuruntha tree to initiate Manikkavasagar?", "media_id": null}], "options": {"A": "Chidambaram", "B": "Thiruvannamalai", "C": "Thirupperunthurai (Avudayarkoil)", "D": "Tiruchirappalli"}, "explanation": "At Thirupperunthurai, Shiva appeared as divine guru under the Kuruntha tree."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section