{"id": "11th_tamil_u6_q093", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_thiruchazhal", "chapter_id": null, "topic_id": "popular_proverb", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'திருவாசகத்திற்கு உருகார் ஒரு வாசகத்திற்கும் உருகார்' என்னும் முதுமொழி எதனைப் போற்றுகிறது?", "media_id": null}], "options": {"A": "திருவாசகப் பாடல்களின் மனதை உருக்கும் அளப்பரிய பக்திச் சுவையையும் நெகிழ்ச்சியையும்", "B": "திருவாசகம் படிக்கக் கடினமானது என்பதை", "C": "இலக்கணத்தின் கடினத் தன்மையை", "D": "புலவர்களின் புலமையை மட்டுமே"}, "explanation": "திருவாசகப் பாடல்கள் கல்லையும் கரைக்கும் பக்தியூறும் சொற்களால் ஆனவை என்பதால் 'திருவாசகத்திற்கு உருகார் ஒரு வாசகத்திற்கும் உருகார்' என்ற முதுமொழி வழங்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "What does the ancient adage 'Those unmoved by Thiruvasagam will melt at no word' celebrate?", "media_id": null}], "options": {"A": "The heart-melting devotional sweetness and soul-stirring pathos of Thiruvasagam", "B": "Its severe grammatical complexity", "C": "Difficult vocabulary", "D": "Scholarly pedantry"}, "explanation": "It celebrates the unparalleled emotional and spiritual tenderness of Thiruvasagam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textb