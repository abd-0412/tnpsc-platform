{"id": "11th_tamil_u6_q094", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_thiruchazhal", "chapter_id": null, "topic_id": "g_u_pope_english_translation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருவாசகத்தை முழுமையாக ஆங்கிலத்தில் மொழிபெயர்த்து உலகறியச் செய்த மேற்கத்திய அறிஞர் யார்?", "media_id": null}], "options": {"A": "வீரமாமுனிவர்", "B": "ஜி. யு. போப் (Rev. G. U. Pope)", "C": "கால்டுவெல்", "D": "எல்லிஸ்"}, "explanation": "மேற்கத்திய அறிஞர் ஜி. யு. போப் (G. U. Pope) 1900-இல் திருவாசகத்தை முழுமையாக ஆங்கிலத்தில் மொழிபெயர்த்துத் தம் கல்லறையில் 'ஒரு தமிழ் மாணவன்' எனப் பொறிக்கச் சொன்னார்."}, "en": {"blocks": [{"type": "text", "content": "Which Western scholar translated Thiruvasagam into English in 1900, immortalizing it in the West?", "media_id": null}], "options": {"A": "Veeramamunivar", "B": "Rev. G. U. Pope", "C": "Robert Caldwell", "D": "Francis Whyte Ellis"}, "explanation": "Rev. G. U. Pope translated Thiruvasagam into English verse in 1900."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 1