{"id": "11th_tamil_u6_q076", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_athmanam_and_kutralam", "chapter_id": null, "topic_id": "glossary_kural", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மந்திசிந்து கனிகளுக்கு வான்கவிகள் கெஞ்சும்' - இதில் 'வான்கவிகள்' என்பது யாரைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "வானத்தில் பாடும் தேவர்கள்", "B": "விண்வெளிப் பயணிகள்", "C": "பறவைகள்", "D": "விண்ணுலகில் வாழும் தேவர்கள் / வானவர்"}, "explanation": "பெண் குரங்குகள் தின்று சிதறும் அரிய கனிகளைப் பெறுவதற்காக வானுலகில் வாழும் தேவர்களே கெஞ்சுவார்கள் என்று மலையின் பெருமையைக் கவிராயர் கற்பனை செய்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "In the line 'Manthisinthu kanigalukku vaankavigal kenjum', who does 'vaankavigal' denote?", "media_id": null}], "options": {"A": "Celestial bards", "B": "Astronauts", "C": "Birds", "D": "Celestials / Devas dwelling in heaven"}, "explanation": "'Vaankavigal' hyperbolically refers to celestials pleading for the delicious fruits dropped by monkeys."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 135, "chapter": null, "section"