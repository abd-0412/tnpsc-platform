{"id": "11th_tamil_u6_q006", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "sikhara_stone_weight", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயில் விமானத்தின் உச்சியில் அமைந்துள்ள ஒற்றைக்கல் போன்ற பிரம்மாண்டத் தளக்கல்லின் (சிகரம் / பிரம்மமந்திரக் கல்) எடை ஏறத்தாழ எவ்வளவு?", "media_id": null}], "options": {"A": "50 டன்கள்", "B": "80 டன்கள்", "C": "100 டன்கள்", "D": "120 டன்கள்"}, "explanation": "விமானத்தின் உச்சியில் வைக்கப்பட்டுள்ள பிரம்மமந்திரக் கல் எனப்படும் கலசத் தளக்கல் ஏறத்தாழ 80 டன் எடை கொண்டதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the approximate weight of the massive octagonal monolithic capstone (Brahmarandhra-sila) crowning the Vimana?", "media_id": null}], "options": {"A": "50 tonnes", "B": "80 tonnes", "C": "100 tonnes", "D": "120 tonnes"}, "explanation": "The massive capstone atop the Vimana weighs approximately 80 tonnes."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 131, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 131", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 6", "Prose", "Thanjavur Big Temple"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u6_q007", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "entrance_gopuram", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயிலின் பிரதான நுழைவாயிலில் அமைந்துள்ள இரு கோபுரங்களின் பெயர்கள் எவை?", "media_id": null}], "options": {"A": "இராஜராஜன் திருவாயில், சுந்தரபாண்டியன் திருவாயில்", "B": "விக்கிரமசோழன் திருவாயில், குலோத்துங்கன் திருவாயில்", "C": "கேரளாந்தகன் திருவாயில், இராஜராஜன் திருவாயில்", "D": "கிழக்கு வாயில், மேற்கு வாயில்"}, "explanation": "தஞ்சைக் கோயிலின் வெளிக்கோபுரம் 'கேரளாந்தகன் திருவாயில்' (சேரனை வென்ற நினைவாக) என்றும், உட்கோபுரம் 'இராஜராஜன் திருவாயில்' என்றும் அழைக்கப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What are the names of the two magnificent eastern gateway Gopurams of the Thanjavur Big Temple?", "media_id": null}], "options": {"A": "Rajarajan Gate and Sundarapandiyan Gate", "B": "Vikramacholan Gate and Kulothungan Gate", "C": "Keralanthakan Thiruvayil and Rajarajan Thiruvayil", "D": "East Gate and West Gate"}, "explanation": "The outer gateway is Keralanthakan Thiruvayil and the inner one is Rajarajan Thiruvayil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 131, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 131", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 6", "Prose", "Thanjavur Big Temple"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u6_q008", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "sandhara_corridor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கருவறையைச் சுற்றி இருதள அமைப்போடு காற்றோட்டமும் வெளிச்சமும் நிலவும் வகையில் அமைக்கப்பட்டுள்ள சுற்றுவழி எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "மகா மண்டபம்", "B": "முக மண்டபம்", "C": "அந்தராளம்", "D": "சாந்தார நாழிகை (உள்சுற்று மாளிகை)"}, "explanation": "தஞ்சைக் கோயிலின் கருவறைச் சுவரைச் சுற்றி இரு அடுக்குகளாகச் செல்லும் நடைபாதை 'சாந்தார நாழிகை' என அழைக்கப்படுகிறது; இங்கு அரிய ஓவியங்கள் உள்ளன."}, "en": {"blocks": [{"type": "text", "content": "What is the architectural inner circumambulatory passage flanking the sanctum sanctorum called?", "media_id": null}], "options": {"A": "Maha Mandapam", "B": "Mukha Mandapam", "C": "Antarala", "D": "Saandhara Nazhigai (Inner Ambulatory Corridor)"}, "explanation": "The double-storied inner circumambulatory passage around the sanctum is called Saandhara Nazhigai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 132, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 132", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 6", "Prose", "Thanjavur Big Temple"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u6_q009", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "researcher_author", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயில் மற்றும் சோழர் காலக் கலை வரலாற்றை நுட்பமாக ஆய்வு செய்து 'தஞ்சைப் பெரிய கோயில்' ஆய்வு நூலை எழுதிய புகழ்பெற்ற கல்வெட்டியல் வரலாற்று அறிஞர் யார்?", "media_id": null}], "options": {"A": "குடவாயில் பாலசுப்பிரமணியன்", "B": "மயிலை சீனி. வேங்கடசாமி", "C": "எஸ். இராமச்சந்திரன்", "D": "டாக்டர் மா. இராசமாணிக்கனார்"}, "explanation": "வரலாற்று அறிஞர் குடவாயில் பாலசுப்பிரமணியன் அவர்கள் தஞ்சைப் பெரிய கோயிலின் கட்டிடக் கலை, சிற்பம், கல்வெட்டுகளை விரிவாக ஆராய்ந்து உலகறியச் செய்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which eminent epigraphist and historian conducted exhaustive research on the Big Temple and authored foundational monographs?", "media_id": null}], "options": {"A": "Kudavayil Balasubramanian", "B": "Mayilai Seeni Venkatasamy", "C": "S. Ramachandran", "D": "Dr. M. Rajamanikkanar"}, "explanation": "Kudavayil Balasubramanian is the acclaimed scholar and author of seminal works on Thanjavur Big Temple."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educ