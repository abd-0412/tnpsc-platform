{"id": "11th_tamil_u6_q003", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "vimanam_height", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயிலின் வானுயர்ந்த விமானத்தின் மொத்த உயரம் எத்தனை அடிகள்?", "media_id": null}], "options": {"A": "180 அடிகள்", "B": "196 அடிகள்", "C": "216 அடிகள்", "D": "240 அடிகள்"}, "explanation": "தஞ்சைப் பெரிய கோயிலின் ஸ்ரீவிமானமானது தரைமட்டத்திலிருந்து 216 அடிகள் உயரமுடைய பிரம்மாண்டமான அமைப்பாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the total height of the towering Vimana of the Thanjavur Big Temple?", "media_id": null}], "options": {"A": "180 feet", "B": "196 feet", "C": "216 feet", "D": "240 feet"}, "explanation": "The main Vimana of Thanjavur Big Temple rises to a majestic height of 216 feet."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 131, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 131", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "pape