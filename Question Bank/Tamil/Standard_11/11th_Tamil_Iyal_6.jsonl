{"id": "11th_tamil_u6_q055", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "conservation_asi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயிலைப் பாதுகாத்துப் பராமரிக்கும் மத்திய அரசு அமைப்பு எது?", "media_id": null}], "options": {"A": "யுனெஸ்கோ நேரடி நிர்வாகம்", "B": "தமிழக வனத்துறை", "C": "இந்தியத் தொல்லியல் துறை (Archaeological Survey of India - ASI)", "D": "இந்து சமய அறநிலையத் துறை மட்டுமே"}, "explanation": "தஞ்சைப் பெரிய கோயில் தேசிய முக்கியத்துவம் வாய்ந்த பாதுகாக்கப்பட்ட நினைவுச் சின்னமாகும்; இதனை இந்தியத் தொல்லியல் துறை (ASI) போற்றிப் பராமரித்து வருகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which central governmental authority is tasked with the architectural conservation of the Thanjavur Big Temple?", "media_id": null}], "options": {"A": "Direct UNESCO administrative bureau", "B": "Tamil Nadu Forest Department", "C": "Archaeological Survey of India (ASI)", "D": "HR&CE department only"}, "explanation": "The monument is conserved as a monument of national importance by the Archaeological Survey of India."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 133, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 133", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 6", "Prose", "Thanjavur Big Temple"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u6_q056", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "prose_summary_assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயில் உரைநடைப் பகுதி தரும் வரலாற்றுச் செய்திகளுள் சரியான முடிவைத் தேர்க:\n1. இது தமிழர்களின் உலகத்தரம் வாய்ந்த பொறியியல், கட்டிடக் கலை நுணுக்கங்களை வெளிப்படுத்துகிறது.\n2. கல்வெட்டுகள் சமூக, பண்பாட்டு, பொருளாதார வாழ்வின் முழுமையான ஆவணமாகத் திகழ்கின்றன.\n3. சோழர் கால ஓவியங்களும் செப்புத் திருமேனிகளும் உலகக் கலை வரலாற்றில் தனித்தனி சிகரங்கள் ஆகும்.", "media_id": null}], "options": {"A": "1 மற்றும் 2 மட்டுமே சரி", "B": "2 மற்றும் 3 மட்டுமே சரி", "C": "1 மற்றும் 3 மட்டுமே சரி", "D": "1, 2, 3 ஆகிய மூன்று கூற்றுகளும் முற்றிலும் சரியானவை"}, "explanation": "தஞ்சைப் பெரிய கோயில் தமிழர் கட்டிடக்கலை, ஆவணப்படுத்தல், செப்புத்திருமேனி மற்றும் ஓவியக் கலைகளின் சிகரமாக விளங்குவதை இப்பாடப்பகுதி முழுமையாக நிறுவுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Select the correct deduction synthesizing the Big Temple study:\n1. Demonstrates Tamil engineering and architectural mastery.\n2. Inscriptions form an encyclopedic record of socio-economic life.\n3. Murals and bronzes represent supreme peaks of global aesthetic history.", "media_id": null}], "options": {"A": "1 and 2 only", "B": "2 and 3 only", "C": "1 and 3 only", "D": "1, 2, and 3 are all completely accurate"}, "explanation": "All three statements accurately synthesize the architectural, epigraphical, and sculptural grandeur of the temple."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 133, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 133", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 6", "Prose", "Thanjavur Big Temple"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
