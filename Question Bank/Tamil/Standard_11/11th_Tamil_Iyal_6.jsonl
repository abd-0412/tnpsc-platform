{"id": "11th_tamil_u6_q104", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_thiruchazhal", "chapter_id": null, "topic_id": "kesavan_foot_search", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கேசவன்றான் காண்கிலாக் கேழிலாப் பொற்கழற்கே / ஆசையினால் ஆழ்த்துகின்றான் காணடி சாழலோ' - இதில் 'கேசவன்' என்று மாணிக்கவாசகர் யாரைக் குறிப்பிடுகிறார்?", "media_id": null}], "options": {"A": "சிவனை", "B": "பிரம்மனை", "C": "இந்திரனை", "D": "திருமாலை (விஷ்ணுவை)"}, "explanation": "கேசவன் என்பது திருமாலைக் குறிக்கும். அடிமுடி தேடியபொழுது திருமால்கூடக் காண முடியாத ஒப்பற்ற திருவடிகளை உடையவன் சிவன் என்பது இதன் பொருளாகும்."}, "en": {"blocks": [{"type": "text", "content": "In the verse 'Kesavan thaan kaankila...', who is referred to as 'Kesavan' by Manikkavasagar?", "media_id": null}], "options": {"A": "Lord Shiva", "B": "Lord Brahma", "C": "Lord Indra", "D": "Lord Thirumal (Vishnu)"}, "explanation": "'Kesavan' refers to Lord Vishnu, whose vision could not fathom Shiva's lotus feet during the Lingodbhava manifestation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null