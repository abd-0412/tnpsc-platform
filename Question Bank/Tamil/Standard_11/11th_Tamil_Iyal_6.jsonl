{"id": "11th_tamil_u6_q159", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "error_detection_sandhi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்காணும் தொடர்களுள் வல்லினம் மிக வேண்டிய இடத்தில் மிகாமல் பிழையாக எழுதப்பட்டுள்ள தொடர் எது?", "media_id": null}], "options": {"A": "பாடம் படித்தான்", "B": "கதவைத் திறந்தான்", "C": "திசை எட்டும் சென்று புகழ் கொண்டான் (திசை + எட்டும்)", "D": "பத்துப் பாட்டு"}, "explanation": "பாடத்தைப் படித்தான் என்பதில் இரண்டாம் வேற்றுமை விரிந்து வரும்போது 'பாடத்தைப் படித்தான்' என வல்லினம் மிக வேண்டும்; 'பாடம் படித்தான்' என்பதில் உருபு மறைந்துள்ளதால் மிகவில்லை. ஆனால் வினாக்களில் 'கதவைத் திறந்தான்' சரியானது; 'ஈறுகெட்ட எதிர்மறை'களில் மிக வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the grammatically correct phrase adhering to Sandhi rules:", "media_id": null}], "options": {"A": "Paadam padithaan", "B": "Kadhavai thiranthaan (without gemination)", "C": "Kadhavaith thiranthaan (accurate gemination after 2nd case marker)", "D": "Pathu paattu"}, "explanation": "After the explicit 2nd case marker 'Ai', Vallinam strictly doubles: Kadhavaith thiranthaan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tam