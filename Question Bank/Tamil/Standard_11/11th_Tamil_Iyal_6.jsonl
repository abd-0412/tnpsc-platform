{"id": "11th_tamil_u6_q001", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "builder_king", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயிலைக் கட்டிய சோழப் பேரரசர் யார்?", "media_id": null}], "options": {"A": "முதலாம் இராஜராஜ சோழன்", "B": "முதலாம் இராஜேந்திர சோழன்", "C": "முதலாம் குலோத்துங்க சோழன்", "D": "சுந்தர சோழன்"}, "explanation": "தஞ்சைப் பெரிய கோயில் கி.பி. 11-ஆம் நூற்றாண்டின் தொடக்கத்தில் மாமன்னன் முதலாம் இராஜராஜ சோழனால் கட்டப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which Chola emperor constructed the Great Temple (Brihadisvara Temple) of Thanjavur?", "media_id": null}], "options": {"A": "Rajaraja Chola I", "B": "Rajendra Chola I", "C": "Kulothunga Chola I", "D": "Sundara Chola"}, "explanation": "The Thanjavur Big Temple was built by Emperor Rajaraja Chola I in the early 11th century CE."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 130, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 130", "url": null, "source_notes": null}, "previous_year": {"is_previou