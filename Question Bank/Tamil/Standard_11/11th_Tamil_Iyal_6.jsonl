{"id": "11th_tamil_u6_q137", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "kbs_film_titles", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கே. பி. சுந்தராம்பாள் நடித்த பிற புகழ்பெற்ற திரைப்படங்களுள் சரியான வரிசையைக் கண்டறிக:", "media_id": null}], "options": {"A": "நந்தனார், மணிமேகலை, ஔவையார், திருவிளையாடல், கந்தன் கருணை, காரைக்கால் அம்மையார்", "B": "ஹரிதாஸ், சிந்தாமணி, அசோக்குமார்", "C": "பராசக்தி, மனோகரா, வீரபாண்டிய கட்டபொம்மன்", "D": "கர்ணன், கப்பலோட்டிய தமிழன்"}, "explanation": "சுந்தராம்பாள் நந்தனார், மணிமேகலை, ஔவையார், திருவிளையாடல், கந்தன் கருணை, காரைக்கால் அம்மையார் ஆகிய புகழ்பெற்ற படங்களில் நடித்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Identify the correct filmography associated with K. B. Sundarambal:", "media_id": null}], "options": {"A": "Nandanar, Manimekalai, Avvaiyar, Thiruvilaiyadal, Kandhan Karunai, Karaikkal Ammaiyar", "B": "Haridas, Chinthamani, Ashok Kumar", "C": "Parasakthi, Manohara", "D": "Karnan, Kappalottiya Thamizhan"}, "explanation": "Option A correctly lists the celebrated films starring K. B. Sundarambal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Servic