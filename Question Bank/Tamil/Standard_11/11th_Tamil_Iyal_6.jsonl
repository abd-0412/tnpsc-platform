{"id": "11th_tamil_u6_q155", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "adverbial_participle_rule", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'இ' என்னும் எழுத்தில் முடியும் வினையெச்சங்களின் பின்னும், 'அக' என முடியும் வினையெச்சங்களின் பின்னும் வல்லினம் _____?", "media_id": null}], "options": {"A": "ஒருபோதும் மிகாது", "B": "சில இடங்களில் மிகும்", "C": "கட்டாயமாக மிகும் (எ.கா: ஓடிக் களைத்தான், பாடிக் காட்டினான், வரக் கண்டேன்)", "D": "ஆய்தம் தோன்றும்"}, "explanation": "'இ' ஈற்று வினையெச்சங்களின் பின்னும் (ஓடிக் களைத்தான், சொல்லிக் கொடுத்தான்) 'அ' ஈற்று வினையெச்சங்களின் பின்னும் (வரக் கண்டேன்) வல்லினம் மிகும்."}, "en": {"blocks": [{"type": "text", "content": "Following verbal participles ending in 'i' and infinitive participles ending in 'a', does Vallinam geminate?", "media_id": null}], "options": {"A": "Never geminates", "B": "Geminates optionally", "C": "Strictly geminates (e.g., Odik kalaithaan, Paadik kaattinaan, Varak kanden)", "D": "Ayutham appears"}, "explanation": "Participles ending in 'i' and infinitives in 'a' mandate hard consonant doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services C