{"id": "11th_tamil_u6_q127", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "kbs_khadi_vow", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எஸ். ஜி. கிட்டப்பாவின் மறைவுக்குப் பின்னர் கே. பி. சுந்தராம்பாள் தம் வாழ்நாள் முழுவதும் மேற்கொண்ட விரதம் யாது?", "media_id": null}], "options": {"A": "பாடுவதையே நிறுத்துவது", "B": "நாட்டை விட்டு வெளியேறுவது", "C": "எளிமையான வெள்ளை நிறக் கதர் ஆடையை மட்டுமே அணிவது", "D": "திரைப்படங்களில் மட்டுமே நடிப்பது"}, "explanation": "கிட்டப்பாவின் மறைவுக்குப் பின் சுந்தராம்பாள் ஆடம்பரங்களை முற்றிலும் துறந்து, வாழ்நாள் இறுதி வரை வெள்ளை நிறக் கதர் புடவை மட்டுமே அணிந்து வாழ்ந்தார்."}, "en": {"blocks": [{"type": "text", "content": "What lifelong austerity vow did K. B. Sundarambal uphold following the demise of S. G. Kittappa?", "media_id": null}], "options": {"A": "Abandoning music completely", "B": "Migrating abroad", "C": "Wearing strictly pure white Khadi sarees for the remainder of her life", "D": "Acting exclusively in cinema"}, "explanation": "She renounced worldly vanity and dressed exclusively in pristine white Khadi sarees until her demise."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 138", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 6", "Supplementary", "K. B. Sundarambal"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u6_q128", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "mkt_famous_songs", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்கண்டவற்றுள் எம். கே. தியாகராஜ பாகவதர் பாடிப் புகழ்பெற்ற பாடல்களின் தொகுப்பு எது?", "media_id": null}], "options": {"A": "பழம் நீயப்பா ஞானப்பழம் நீயப்பா", "B": "ஆடுவோமே பள்ளுப் பாடுவோமே", "C": "தாயின் மணிக்கொடி பாரீர்", "D": "'மன்மத லீலையை வென்றார் உண்டோ', 'ராதே உனக்கு கோபம் ஆகாதடி', 'ஞானக்கண் ஒன்று இருந்திடும் போதினிலே'"}, "explanation": "'மன்மத லீலையை வென்றார் உண்டோ' (ஹரிதாஸ்), 'ராதே உனக்கு கோபம் ஆகாதடி' (சிந்தாமணி), 'ஞானக்கண் ஒன்று' (சிவகவி) ஆகியவை பாகவதரின் புகழ்பெற்ற பாடல்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following anthologies represents celebrated songs immortalized by M. K. Thyagaraja Bhagavathar?", "media_id": null}], "options": {"A": "Pazham Neeyappa", "B": "Aaduvome Pallu Paaduvome", "C": "Thaayin Manikodi Pareer", "D": "'Manmatha Leelaiyai Vendraar Undo', 'Radhe Unakku Kobam Aagathadi', 'Gnanakkan Ondru'"}, "explanation": "All three songs in option D are evergreen classical hits rendered by Bhagavathar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tam