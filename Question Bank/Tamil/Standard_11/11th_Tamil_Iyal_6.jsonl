{"id": "11th_tamil_u6_q195", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "glossary_and_pyq", "chapter_id": null, "topic_id": "pyq_kutrala_kuravanji_characters", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] குற்றாலக் குறவஞ்சியில் பறவை பிடிக்கும் குறவனாக வரும் சிங்கனின் நண்பன் யார்?", "media_id": null}], "options": {"A": "மருதன்", "B": "கண்ணன்", "C": "நுவன்", "D": "வேலன்"}, "explanation": "குற்றாலக் குறவஞ்சியில் பறவைகளைப் பிடிக்கும் சிங்கனின் உற்ற தோழனாக வருபவன் 'நுவன்' ஆவான்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Who features as the loyal companion and confidant of the bird-catcher Singan in Kutrala Kuravanji?", "media_id": null}], "options": {"A": "Maruthan", "B": "Kannan", "C": "Nuvan", "D": "Velan"}, "explanation": "Singan's hunter friend and companion is Nuvan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 136, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 136", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4", "exam_name": "General Tamil", "year": 2019, "pape