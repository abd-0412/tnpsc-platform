{"id": "11th_tamil_u6_q091", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_thiruchazhal", "chapter_id": null, "topic_id": "tiger_skin_symbolism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இறைவன் கொடிய புலியின் தோலை ஆடையாக அணிந்துள்ளதன் குறியீட்டுப் பொருள் யாது?", "media_id": null}], "options": {"A": "காட்டு விலங்குகளை வேட்டையாட விரும்புவது", "B": "குளிரைத் தாங்குவதற்காக", "C": "மனித மனத்தின் அகங்காரம், ஆணவம், அறியாமை முதலான விலங்குணர்வினை அடக்கி வென்றதன் அடையாளம்", "D": "ஆடைகள் கிடைக்காத நிலை"}, "explanation": "கொடிய புலியின் தோலை உடுத்தியது என்பது உயிர்களின் செருக்கு, கொடிய ஆணவம், புலன்களின் வெறி ஆகியவற்றை இறைவன் அடக்கி வென்றதன் குறியீடாகும்."}, "en": {"blocks": [{"type": "text", "content": "What esoteric symbolism lies behind Lord Shiva donning the skin of a ferocious tiger (Kolpulithol)?", "media_id": null}], "options": {"A": "Fondness for game hunting", "B": "Protection against cold weather", "C": "Subjugation of human egoism, arrogance, and primal animalistic passions", "D": "Lack of woven garments"}, "explanation": "The tiger skin represents the divine vanquishing of primal ego and uncontrolled sensory passions."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educati