{"id": "11th_tamil_u6_q063", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_athmanam_and_kutralam", "chapter_id": null, "topic_id": "mountain_fertility_line", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வானரங்கள் கனிகொடுத்து மந்தியொடு கொஞ்சும் / மந்திசிந்து கனிகளுக்கு வான்கவிகள் கெஞ்சும்' - இவ்வடிகள் இடம்பெற்றுள்ள நூல் எது? இதில் 'மந்தி' என்பது எதனைக் குறிக்கும்?", "media_id": null}], "options": {"A": "கம்பராமாயணம்; பெண் குதிரை", "B": "மீனாட்சியம்மை பிள்ளைத்தமிழ்; மான்", "C": "குற்றாலக் குறவஞ்சி; பெண் குரங்கு", "D": "முக்கூடற்பள்ளு; பெண் பறவை"}, "explanation": "குற்றால மலையின் இயற்கை வளத்தைப் பாடும் திரிகூடராசப்பக் கவிராயரின் புகழ்பெற்ற பாடல் இது. இதில் 'மந்தி' என்பது பெண் குரங்கைக் குறிக்கும் (வானரம் = ஆண் குரங்கு)."}, "en": {"blocks": [{"type": "text", "content": "In the lines 'Vaanarangal kanikodutthu manthiyodu konjum...', which work do they belong to, and what does 'manthi' denote?", "media_id": null}], "options": {"A": "Kambaramayanam; Mare", "B": "Pillaithamil; Deer", "C": "Kutrala Kuravanji; Female monkey", "D": "Mukkoodarpallu; Female bird"}, "explanation": "From Kutrala Kuravanji; 'Manthi' denotes a female monkey (while 'Vaanaram' is male)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher