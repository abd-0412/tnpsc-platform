{"id": "11th_tamil_u6_q163", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "sandhi_meaning_difference", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வல்லினம் மிகுதலும் மிகாமையும் பொருளை எவ்வாறு மாற்றும் என்பதற்குச் சரியான எடுத்துக்காட்டு எது?", "media_id": null}], "options": {"A": "தம்பி பார்த்தான் - தம்பிப் பார்த்தான்", "B": "படித்த பையன் - படித்தப் பையன்", "C": "வேலை கொடுத்தான் (பணி தந்தான்) - வேலைக் கொடுத்தான் (வேல் என்னும் ஆயுதத்தைத் தந்தான்)", "D": "நாடு கண்டான் - நாட்டுக் கண்டான்"}, "explanation": "வல்லினம் மிகும்போது ஒரு பொருளும், மிகாதபோது வேறு பொருளும் தோன்றும்: 'வேலை கொடுத்தான்' = பணி தந்தான்; 'வேலைக் கொடுத்தான்' = வேல் என்னும் ஆயுதத்தைத் தந்தான்."}, "en": {"blocks": [{"type": "text", "content": "Which example accurately demonstrates how plosive gemination fundamentally alters semantic meaning?", "media_id": null}], "options": {"A": "Thambi paarthaan vs Thambip paarthaan", "B": "Paditha paiyan vs Padithap paiyan", "C": "Velai kodutthaan (offered employment) vs Velaik kodutthaan (handed over a spear)", "D": "Naadu kandaan vs Naattuk kandaan"}, "explanation": "Gemination denotes the objective accusative 'spear', while non-gemination denotes employment."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "