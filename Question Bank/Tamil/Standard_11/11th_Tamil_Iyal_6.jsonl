{"id": "11th_tamil_u6_q134", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "dual_biographies_synthesis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'இசைத்தமிழர் இருவர்' பாடப்பகுதி மூலம் நாம் அறியும் முதன்மையான செய்தி யாது?", "media_id": null}], "options": {"A": "இசை என்பது வணிகத்திற்கு மட்டுமே பயன்படும்", "B": "இசைக் கலை வெறும் பொழுதுபோக்கு மட்டுமல்ல; அது தேச விடுதலை, சமூக எழுச்சி, பக்தி நெறி மற்றும் மக்கள் நலனுக்கு உறுதுணையாக நின்ற வரலாற்று ஆயுதம்", "C": "திரைப்படத் துறையே முதன்மையானது", "D": "நாடகம் அழியக்கூடிய கலை"}, "explanation": "இசை வெறும் கேளிக்கை அல்ல; அது நாட்டின் விடுதலைக்கும், தமிழிசை மீட்சிக்கும், ஆன்மீக நெறிக்கும் பயன்பட்ட ஒப்பற்ற கலை என்பதை இவ்விரு ஆளுமைகளும் நிரூபித்தனர்."}, "en": {"blocks": [{"type": "text", "content": "What cardinal insight is revealed through the dual biographical study 'Isaitthamizhar Iruvar'?", "media_id": null}], "options": {"A": "Music serves commercial ends exclusively", "B": "Music is not merely entertainment, but an instrument of national liberation, social awakening, and devotional uplift", "C": "Cinema is supreme", "D": "Theater is ephemeral"}, "explanation": "It highlights how sublime musical artistry served as an engine of national liberation and cultural renaissance."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0