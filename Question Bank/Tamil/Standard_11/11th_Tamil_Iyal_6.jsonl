{"id": "11th_tamil_u6_q157", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "adverbial_words_gemination", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'அங்கு, இங்கு, எங்கு, ஆண்டு, ஈண்டு, யாண்டு, அப்படி, இப்படி, எப்படி' என்னும் சொற்களின் பின் வல்லினம் _____?", "media_id": null}], "options": {"A": "கட்டாயமாக மிகும் (எ.கா: அங்குக் கண்டேன், இப்படிச் சொன்னான், எப்படிப் பேசுவது)", "B": "ஒருபோதும் மிகாது", "C": "மெல்லினம் மிகும்", "D": "இடையினம் மிகும்"}, "explanation": "அங்கு, இங்கு, எங்கு, அப்படி, இப்படி, எப்படி முதலான சுட்டு, வினா இடைச்சொற்களின் பின் வல்லினம் மிகும்."}, "en": {"blocks": [{"type": "text", "content": "Following adverbial roots 'Angu', 'Ingu', 'Engu', 'Appadi', 'Ippadi', 'Eppadi', does Vallinam geminate?", "media_id": null}], "options": {"A": "Strictly geminates (e.g., Anguk kanden, Ippadic chonnaan, Eppadip pesuvathu)", "B": "Never geminates", "C": "Nasal doubles", "D": "Medial doubles"}, "explanation": "These adverbial particles strictly mandate doubling of following plosives."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-