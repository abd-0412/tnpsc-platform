{"id": "11th_tamil_u6_q070", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_athmanam_and_kutralam", "chapter_id": null, "topic_id": "poetic_simile_kutralam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'முழங்கு திரைப்புனல் அருவி கழங்கென முத்தாடும் / முளரிமிசைப் பறந்துழலும் புள்ளினங்கள் ஆர்ப்பாடும்' - இப்பாடலில் கவிராயர் அருவி நீர்த்துளிகளை எதற்கு ஒப்பிடுகிறார்?", "media_id": null}], "options": {"A": "வைரக் கற்களுக்கு", "B": "கழங்கு விளையாடும் முத்துக்களுக்கு (முத்தாடும்)", "C": "வானத்து விண்மீன்களுக்கு", "D": "வெள்ளி நாணயங்களுக்கு"}, "explanation": "மலையிலிருந்து ஆர்ப்பரித்து விழும் அருவியின் அழகிய நீர்த்துளிகள் முத்துக்கள் போலக் கழங்கு விளையாடுகின்றன என்று கவிராயர் உவமிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "In the lines describing Kutralam waterfalls, what does the poet compare the sparkling spray droplets to?", "media_id": null}], "options": {"A": "Diamonds", "B": "Pearls tossed during ball play (Muthadum Kazhangu)", "C": "Celestial stars", "D": "Silver coins"}, "explanation": "The splashing waterfall sprays are likened to pearls tossed during traditional pearl games."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "cl