{"id": "11th_tamil_u6_q096", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_thiruchazhal", "chapter_id": null, "topic_id": "manikkavasagar_place", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாணிக்கவாசகர் பிறந்த ஊர் எது?", "media_id": null}], "options": {"A": "திருவாலங்காடு", "B": "திருவதிகை", "C": "திருவெண்ணெய்நல்லூர்", "D": "திருவாதவூர் (மதுரைக்கு அருகில்)"}, "explanation": "மாணிக்கவாசகர் மதுரைக்கு அருகிலுள்ள 'திருவாதவூர்' என்னும் ஊரில் பிறந்தார்; இதனால் 'வாதவூரார்' என்றும் அழைக்கப்பட்டார்."}, "en": {"blocks": [{"type": "text", "content": "What was the sacred birthplace of saint Manikkavasagar?", "media_id": null}], "options": {"A": "Thiruvalangadu", "B": "Thiruvadhigai", "C": "Thiruvennainallur", "D": "Thiruvathavur (near Madurai)"}, "explanation": "He was born in Thiruvathavur near Madurai, hence known as Vathavoorar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 137", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year":