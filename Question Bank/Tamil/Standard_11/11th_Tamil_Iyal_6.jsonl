{"id": "11th_tamil_u6_q145", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "eeruketta_ethirmarai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஈறுகெட்ட எதிர்மறைப் பெயரெச்சத்தின் பின் வல்லினம் எவ்வாறமையும்?", "media_id": null}], "options": {"A": "கட்டாயமாக மிகும் (எ.கா: ஓடாக் குதிரை, பாடாக் குயில், கூவாக் கோழி, கேளாக் காது)", "B": "ஒருபோதும் மிகாது", "C": "மெல்லினம் மிகும்", "D": "உயிரெழுத்து மிகும்"}, "explanation": "ஈறுகெட்ட எதிர்மறைப் பெயரெச்சத்தின் இறுதி கெட்டு 'ஆ' என முடிவதால், அதன் பின் வரும் வல்லினம் மிகும் (ஓடாக் குதிரை)."}, "en": {"blocks": [{"type": "text", "content": "How does Vallinam behave following a truncated negative relative participle (Eeruketta Ethirmarai Peyarechcham)?", "media_id": null}], "options": {"A": "Strictly geminates (e.g., Oodaak kuthirai, Paadaak kuyil)", "B": "Never geminates", "C": "Mellinam doubles", "D": "Vowel doubles"}, "explanation": "Truncated negative participles ending in long 'Aa' strictly double the following hard consonant."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 141, "ch