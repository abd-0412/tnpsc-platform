{"id": "11th_tamil_u6_q135", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "mkt_carnatic_mastery", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எம். கே. தியாகராஜ பாகவதரின் இசை பாணியின் தனிப்பெரும் சிறப்பு யாது?", "media_id": null}], "options": {"A": "மெல்லிய கிசுகிசுப்பான குரல்", "B": "மேற்கத்திய பாப் இசை நடை", "C": "உயர்ந்த ஸ்தாயியில் (தாரா ஸ்தாயி) அனாயாசமாகப் பாடும் கம்பீரமான மணி போன்ற வெண்கலக் குரல் வளம்", "D": "பேசுவது போன்ற எளிய நடை"}, "explanation": "பாகவதர் உயர்ந்த சுருதியில் (தாரா ஸ்தாயி) கம்பீரமாக, மணி ஒலிப்பது போல இனிமையாகப் பாடும் வெண்கலக் குரல் வளம் கொண்டவராகத் திகழ்ந்தார்."}, "en": {"blocks": [{"type": "text", "content": "What was the signature hallmark of M. K. Thyagaraja Bhagavathar's vocal virtuosity?", "media_id": null}], "options": {"A": "Whispering undertone", "B": "Western pop styling", "C": "Resonant bell-like bronze timbre reaching effortless heights in upper octave (Thara Sthayi)", "D": "Casual monotone"}, "explanation": "He was celebrated for his ringing, bell-like timbre ascending effortlessly into upper registers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporati