{"id": "11th_tamil_u6_q068", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_athmanam_and_kutralam", "chapter_id": null, "topic_id": "author_other_works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திரிகூடராசப்பக் கவிராயர் குற்றால நாதர் மீது பாடியுள்ள பிற நூல்களுள் தவறான ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "திருக்குற்றாலத் தலபுராணம் & திருக்குற்றால மாலை", "B": "குற்றால சிலேடை வெண்பா & குற்றால ஊடல்", "C": "குற்றாலப் பரணி & திருக்குற்றாலப் பிள்ளைத்தமிழ்", "D": "மீனாட்சியம்மை பிள்ளைத்தமிழ்"}, "explanation": "'மீனாட்சியம்மை பிள்ளைத்தமிழ்' குமரகுருபரர் பாடியது. ஏனைய குற்றாலத் தலபுராணம், மாலை, சிலேடை வெண்பா, ஊடல், பரணி, பிள்ளைத்தமிழ் ஆகியவை திரிகூடராசப்பக் கவிராயரின் படைப்புகள்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following works was NOT composed by Thirikoodarasappa Kavirayar?", "media_id": null}], "options": {"A": "Thirukutrala Thala Puranam and Thirukutrala Malai", "B": "Kutrala Siledai Venba and Kutrala Oodal", "C": "Kutrala Parani and Thirukutrala Pillaithamil", "D": "Meenakshiyammai Pillaithamil"}, "explanation": "'Meenakshiyammai Pillaithamil' was authored by Kumaraguruparar, whereas the others are by Kavirayar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publish