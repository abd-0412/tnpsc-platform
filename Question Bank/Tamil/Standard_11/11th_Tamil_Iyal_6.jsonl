{"id": "11th_tamil_u6_q113", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "kodumudi_kokilam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கொடுமுடி கோகிலம்' என்றும் 'இசைக்குயில்' என்றும் தமிழக மக்களால் அன்போடு போற்றப்பட்ட இசைப் பேரரசி யார்?", "media_id": null}], "options": {"A": "கே. பி. சுந்தராம்பாள்", "B": "எம். எஸ். சுப்புலட்சுமி", "C": "டி. கே. பட்டம்மாள்", "D": "எம். எல். வசந்தகுமாரி"}, "explanation": "ஈரோடு மாவட்டம் கொடுமுடியில் பிறந்து தம் கணீரென்ற குரல்வளத்தால் நாட்டையே கவர்ந்த கே. பி. சுந்தராம்பாள் 'கொடுமுடி கோகிலம்' எனப் போற்றப்பட்டார்."}, "en": {"blocks": [{"type": "text", "content": "Which legendary vocalist was affectionately revered as 'Kodumudi Kokilam' (The Nightingale of Kodumudi)?", "media_id": null}], "options": {"A": "K. B. Sundarambal", "B": "M. S. Subbulakshmi", "C": "D. K. Pattammal", "D": "M. L. Vasanthakumari"}, "explanation": "K. B. Sundarambal from Kodumudi in Erode was celebrated as 'Kodumudi Kokilam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 138", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 6", "Supplementary", "K. B. Sundarambal"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u6_q114", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "ezhisai_mannar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் திரையுலகின் முதல் சூப்பர் ஸ்டாரான எம். கே. தியாகராஜ பாகவதருக்கு 'ஏழிசை மன்னர்' என்ற பட்டத்தை வழங்கிய தலைவர் யார்?", "media_id": null}], "options": {"A": "பெரியார் ஈ. வெ. ரா.", "B": "பேரறிஞர் அண்ணா", "C": "காமராசர்", "D": "கலைஞர் மு. கருணாநிதி"}, "explanation": "எம். கே. தியாகராஜ பாகவதரின் அபார இசைப் புலமையைப் பாராட்டிப் பேரறிஞர் அண்ணா அவர்கள் அவருக்கு 'ஏழிசை மன்னர்' என்ற பட்டத்தை வழங்கிக் கௌரவித்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which statesman conferred the illustrious title 'Ezhisai Mannar' (Monarch of Seven Musical Notes) upon M. K. Thyagaraja Bhagavathar?", "media_id": null}], "options": {"A": "Periyar E. V. R.", "B": "Perarignar Anna (C. N. Annadurai)", "C": "Kamarajar", "D": "Kalaignar M. Karunanidhi"}, "explanation": "Perarignar Anna bestowed the title 'Ezhisai Mannar' upon M. K. Thyagaraja Bhagavathar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 139, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 139", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 6", "Supplementary", "M. K. Thyagaraja Bhagavathar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u6_q115", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "first_female_mlc", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியாவிலேயே முதன்முதலாக ஒரு சட்டமன்ற மேலவைக்கு (Legislative Council) உறுப்பினராக நியமிக்கப்பட்ட முதல் பெண் கலைஞர் யார்?", "media_id": null}], "options": {"A": "ருக்மிணி தேவி அருண்டேல்", "B": "முத்துலட்சுமி ரெட்டி", "C": "கே. பி. சுந்தராம்பாள் (1951-இல் சென்னை மாகாண சட்டமன்ற மேலவை உறுப்பினர்)", "D": "எம். எஸ். சுப்புலட்சுமி"}, "explanation": "1951-ஆம் ஆண்டு சென்னை மாகாண சட்ட மேலவை உறுப்பினராக (MLC) நியமிக்கப்பட்டதன் மூலம், இந்திய வரலாற்றிலேயே சட்டமன்ற உறுப்பினரான முதல் திரை/நாடகப் பெண் கலைஞர் என்ற பெருமையை கே. பி. சுந்தராம்பாள் பெற்றார்."}, "en": {"blocks": [{"type": "text", "content": "Who became the very first female performing artist in India to be appointed as a Member of the Legislative Council (MLC)?", "media_id": null}], "options": {"A": "Rukmini Devi Arundale", "B": "Muthulakshmi Reddy", "C": "K. B. Sundarambal (nominated to Madras Legislative Council in 1951)", "D": "M. S. Subbulakshmi"}, "explanation": "K. B. Sundarambal was the first Indian female stage and screen artist nominated to a state legislative council (1951)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 138", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 6", "Supplementary", "K. B. Sundarambal"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u6_q116", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "haridas_box_office_record", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எம். கே. தியாகராஜ பாகவதர் நடித்து 1944-இல் வெளியாகி, சென்னை பிராட்வே திரையரங்கில் தொடர்ந்து மூன்று தீபாவளிகளைக் கடந்து 110 வாரங்கள் ஓடி இமாலய சாதனை படைத்த திரைப்படம் எது?", "media_id": null}], "options": {"A": "பவளக்கொடி", "B": "அம்பிகாபதி", "C": "சிந்தாமணி", "D": "ஹரிதாஸ்"}, "explanation": "'ஹரிதாஸ்' திரைப்படம் தொடர்ந்து 110 வாரங்கள் ஓடி, தமிழ் சினிமா வரலாற்றில் மூன்று தீபாவளிகளைக் கண்ட ஒரே படம் என்ற உலக சாதனையைப் படைத்தது."}, "en": {"blocks": [{"type": "text", "content": "Which 1944 film starring M. K. Thyagaraja Bhagavathar created an all-time box-office record running for 110 consecutive weeks across three Diwalis?", "media_id": null}], "options": {"A": "Pavazhakkodi", "B": "Ambikapathi", "C": "Chinthamani", "D": "Haridas"}, "explanation": "'Haridas' ran uninterrupted for 110 weeks at the Broadway Theatre in Madras, spanning three Diwalis."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 140, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 140", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 6", "Supplementary", "M. K. Thyagaraja Bhagavathar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u6_q117", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "highest_paid_actress", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "1935-இல் வெளியான 'நந்தனார்' திரைப்படத்தில் நந்தனாராக நடித்ததற்காக அன்றைய காலத்திலேயே ஒரு லட்சம் ரூபாய் ஊதியம் பெற்று சாதனை படைத்தவர் யார்?", "media_id": null}], "options": {"A": "கே. பி. சுந்தராம்பாள்", "B": "டி. பி. ராஜலட்சுமி", "C": "எம். எஸ். சுப்புலட்சுமி", "D": "பானுமதி"}, "explanation": "'நந்தனார்' படத்தில் நடிக்க கே. பி. சுந்தராம்பாளுக்கு ஒரு லட்சம் ரூபாய் ஊதியமும், ஒரு வெள்ளைக்காரன் தயாரித்த கிராமபோன் இசைத்தட்டும் வழங்கப்பட்டது; அக்காலத்தில் இந்தியாவிலேயே அதிக ஊதியம் பெற்ற நடிகை இவரே."}, "en": {"blocks": [{"type": "text", "content": "Who became India's highest-paid actress in 1935 by commanding a historic salary of one lakh rupees for starring as Nandanar?", "media_id": null}], "options": {"A": "K. B. Sundarambal", "B": "T. P. Rajalakshmi", "C": "M. S. Subbulakshmi", "D": "P. Bhanumathi"}, "explanation": "K. B. Sundarambal received a record Rs 1,00,000 remuneration for 'Nandanar' in 1935."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 138", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 6", "Supplementary", "K. B. Sundarambal"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u6_q118", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "freedom_movement_songs", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கே. பி. சுந்தராம்பாள் விடுதலைப் போராட்டக் காலத்தில் மேடைகளிலும் இசைத்தட்டுகளிலும் பாடி மக்களிடையே தேசபக்தியை ஊட்டிய பாடல்கள் யாருடையவை?", "media_id": null}], "options": {"A": "கவிமணி தேசிக விநாயகம் பிள்ளை பாடல்கள்", "B": "மகாகவி பாரதியாரின் விடுதலைப் பாடல்கள்", "C": "நாமக்கல் கவிஞர் பாடல்கள் மட்டுமே", "D": "பாரதிதாசன் பாடல்கள்"}, "explanation": "சுந்தராம்பாள் பாரதியாரின் 'ஆடுவோமே பள்ளுப் பாடுவோமே', 'தாயின் மணிக்கொடி பாரீர்' போன்ற விடுதலைப் பாடல்களைத் தம் கணீரென்ற குரலில் இசைத்தட்டாகப் பாடி விடுதலைத் தீயை மூட்டினார்."}, "en": {"blocks": [{"type": "text", "content": "Whose patriotic compositions did K. B. Sundarambal immortalize on gramophone records to inspire freedom movement rallies?", "media_id": null}], "options": {"A": "Kavimani Desika Vinayakam Pillai", "B": "Mahakavi Bharathiyar (patriotic and freedom songs)", "C": "Namakkal Kavignar only", "D": "Bharathidasan"}, "explanation": "She recorded Bharathiyar's stirring nationalist songs, igniting mass patriotic fervor across Tamil Nadu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 138", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 6", "Supplementary", "K. B. Sundarambal"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u6_q119", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "mkt_debut_film", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எம். கே. தியாகராஜ பாகவதர் 1934-இல் அறிமுகமான முதல் திரைப்படம் எது?", "media_id": null}], "options": {"A": "சிந்தாமணி", "B": "அம்பிகாபதி", "C": "பவளக்கொடி (இயக்குநர் கே. சுப்பிரமணியம்)", "D": "ஹரிதாஸ்"}, "explanation": "1934-இல் இயக்குநர் கே. சுப்பிரமணியம் இயக்கத்தில் எஸ். டி. சுப்புலட்சுமியுடன் இணைந்து பாகவதர் நடித்த 'பவளக்கொடி' அவரது முதல் திரைப்படமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which was the debut film of M. K. Thyagaraja Bhagavathar released in 1934?", "media_id": null}], "options": {"A": "Chinthamani", "B": "Ambikapathi", "C": "Pavazhakkodi (directed by K. Subrahmanyam)", "D": "Haridas"}, "explanation": "Bhagavathar debuted on the silver screen with 'Pavazhakkodi' in 1934."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 139, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 139", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 6", "Supplementary", "M. K. Thyagaraja Bhagavathar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u6_q120", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "avvaiyar_role", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "1953-இல் ஜெமினி எஸ். எஸ். வாசன் தயாரிப்பில் வெளியாகி, கே. பி. சுந்தராம்பாளைத் தமிழ் கூறும் நல்லுலகில் காலத்தால் அழியாத 'ஔவையாராகவே' நிலைநிறுத்திய திரைப்படம் எது?", "media_id": null}], "options": {"A": "மணிமேகலை", "B": "நந்தனார்", "C": "திருவிளையாடல்", "D": "ஔவையார்"}, "explanation": "1953-இல் வெளியான 'ஔவையார்' திரைப்படத்தில் சுந்தராம்பாள் முதுமைத் தோற்றம் பூண்டு பாடிய பாடல்களும் நடிப்பும் உலகளாவிய பாராட்டைப் பெற்றன."}, "en": {"blocks": [{"type": "text", "content": "Which 1953 cinematic epic produced by S. S. Vasan etched K. B. Sundarambal indelibly in Tamil hearts as the legendary poetess Avvaiyar?", "media_id": null}], "options": {"A": "Manimekalai", "B": "Nandanar", "C": "Thiruvilaiyadal", "D": "Avvaiyar"}, "explanation": "Gemini's magnum opus 'Avvaiyar' (1953) immortalized Sundarambal as the ancient saint-poetess."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 138", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 6", "Supplementary", "K. B. Sundarambal"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u6_q121", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "stage_pair_sgk", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாடக மேடைகளில் கே. பி. சுந்தராம்பாளுடன் இணைந்து நடித்து, இசை உலகில் புகழ்பெற்ற தம்பதியராக விளங்கிய இணையற்ற இசைப் பாடகர் யார்?", "media_id": null}], "options": {"A": "எஸ். ஜி. கிட்டப்பா", "B": "எம். கே. தியாகராஜ பாகவதர்", "C": "பி. யு. சின்னப்பா", "D": "சங்கரதாஸ் சுவாமிகள்"}, "explanation": "எஸ். ஜி. கிட்டப்பாவும் கே. பி. சுந்தராம்பாளும் இணைந்து நடித்த வள்ளி திருமணம் உள்ளிட்ட நாடகங்கள் அன்றைய தமிழகத்தில் மாபெரும் இசைப் புரட்சியை ஏற்படுத்தின."}, "en": {"blocks": [{"type": "text", "content": "Which legendary stage vocalist performed as K. B. Sundarambal's celebrated theatrical partner and husband?", "media_id": null}], "options": {"A": "S. G. Kittappa", "B": "M. K. Thyagaraja Bhagavathar", "C": "P. U. Chinnappa", "D": "Sankaradas Swamigal"}, "explanation": "S. G. Kittappa and K. B. Sundarambal formed the most sensational theatrical duo of their era."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2