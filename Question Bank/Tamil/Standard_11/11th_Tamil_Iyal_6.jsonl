{"id": "11th_tamil_u6_q090", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_thiruchazhal", "chapter_id": null, "topic_id": "parentless_nature", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தாயுமிலி தந்தையிலி தான்தனியன் காணேடீ' - இத்தொடர் இறைவனின் எத்தகைய முழுமுதற்பண்பை உணர்த்துகிறது?", "media_id": null}], "options": {"A": "அனாதையாக வாழ்கிறான்", "B": "பிறப்பும் இறப்பும் அற்றவன்; எவராலும் படைக்கப்படாத சுயம்புவான தனிமுதல் தலைவன்", "C": "குடும்பத்தை வெறுத்த துறவி", "D": "சுற்றத்தார் அற்ற ஏழை"}, "explanation": "இறைவனுக்குத் தாயோ தந்தையோ இல்லை என்பது அவன் பிறப்பற்றவன், தொடக்கமும் முடிவும் இல்லாத முழுமுதல் தனிப்பெரும் தலைவன் என்பதை உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What divine attribute is illustrated by 'Thaayumili Thanthaiyili Thaanthaniyan' (Having neither mother nor father)?", "media_id": null}], "options": {"A": "Destitute orphanhood", "B": "Unborn, eternal, self-existent Supreme Being without origin or end", "C": "Ascetic wandering", "D": "Abandonment by kin"}, "explanation": "It highlights that the Supreme Divine is uncreated, unborn, and self-manifesting."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "cl