{"id": "11th_tamil_u6_q002", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "consecration_year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயிலின் கட்டுமானப் பணிகள் நிறைவுற்று, குடமுழுக்கு நடைபெற்ற ஆண்டு எது?", "media_id": null}], "options": {"A": "கி.பி. 1000", "B": "கி.பி. 1010", "C": "கி.பி. 1025", "D": "கி.பி. 1050"}, "explanation": "முதலாம் இராஜராஜ சோழனின் 25-ஆம் ஆட்சி ஆண்டான கி.பி. 1010-இல் தஞ்சைப் பெரிய கோயிலின் குடமுழுக்குச் சிறப்புற நடைபெற்றது."}, "en": {"blocks": [{"type": "text", "content": "In which year was the consecration (Kudamuzhukku) of the Thanjavur Big Temple celebrated upon completion?", "media_id": null}], "options": {"A": "1000 CE", "B": "1010 CE", "C": "1025 CE", "D": "1050 CE"}, "explanation": "The consecration ceremony was held in 1010 CE, marking the 25th regnal year of Rajaraja Chola I."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 130, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 130", "url": null, "source_notes": null}, "previous_year": {"is_p