{"id": "11th_tamil_u6_q052", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "temple_hospital", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இராஜராஜ சோழனின் கல்வெட்டுகளில் தஞ்சைப் பெரிய கோயிலோடு இணைந்து செயல்பட்ட மருத்துவமனை (ஆதுலர் சாலை) எவ்வாறு குறிப்பிடப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "மருத்துவ மனை", "B": "சுவர்ண சாலை", "C": "அறச்சாலை", "D": "ஆதுலர் சாலை (குந்தவை பிராட்டியார் அமைத்த விண்ணகர் ஆதுலர் சாலை)"}, "explanation": "குந்தவை பிராட்டியார் ஆதுலர் சாலை (மருத்துவமனை) அமைத்து மருத்துவர், மருந்தாளுநர், அறுவை சிகிச்சை நிபுணர்களுக்கு ஊதிய நிலங்கள் வழங்கிய செய்தி கல்வெட்டில் உள்ளது."}, "en": {"blocks": [{"type": "text", "content": "How was the hospital and infirmary associated with the royal family described in contemporary records?", "media_id": null}], "options": {"A": "Maruthuva Manai", "B": "Swarna Saalai", "C": "Arasaalai", "D": "Aathular Saalai (endowed by Princess Kundavai)"}, "explanation": "Hospitals were termed 'Aathular Saalai', staffed with physicians and subsidized with land grants."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "f