{"id": "11th_tamil_u6_q053", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "chola_architecture_phase", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சோழர் கட்டிடக் கலையின் வளர்ச்சியில் தஞ்சைப் பெரிய கோயில் எந்தக் காலகட்டத்தைச் சேர்ந்தது?", "media_id": null}], "options": {"A": "மத்திய சோழர் காலம் (Mature / Middle Chola Phase)", "B": "முற்காலச் சோழர் காலம்", "C": "பிற்காலச் சோழர் காலம்", "D": "நாயக்கர் காலம்"}, "explanation": "முதலாம் இராஜராஜன் மற்றும் இராஜேந்திரன் காலம் சோழர் கட்டிடக் கலையின் 'மத்திய சோழர் காலம்' (பொற்காலம்) என அழைக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "To which evolutionary phase of Chola temple architecture does the Big Temple belong?", "media_id": null}], "options": {"A": "Mature / Middle Chola Phase (Golden Era)", "B": "Early Chola Phase", "C": "Late Chola Phase", "D": "Post-Chola Phase"}, "explanation": "The Thanjavur temple represents the zenith of the Mature / Middle Chola architectural phase."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 130, "chapter": null, "section":