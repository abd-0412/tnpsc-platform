{"id": "11th_tamil_u6_q164", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "fifth_case_elision", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஐந்தாம் வேற்றுமை உருபாகிய 'இல், இன்' ஆகியவை ஒப்புப் பொருளில் வரும்போது வல்லினம் _____? ஏதுப் பொருளில் வரும்போது வல்லினம் _____?", "media_id": null}], "options": {"A": "இரண்டிலும் மிகாது", "B": "இரண்டிலும் மிகும்", "C": "ஏதுப் பொருளில் மிகும்; ஒப்புப் பொருளில் மிகாது", "D": "ஒப்புப் பொருளில் மிகும் (காக்கையின் கரியது); ஏதுப் பொருளில் மிகாது (மின்னலின் சிறிது)"}, "explanation": "ஐந்தாம் வேற்றுமை ஒப்புப் பொருளில் வரும்போது வல்லினம் மிகும்; பிற பொருள்களில் வரும்போது வல்லினம் மிகாது."}, "en": {"blocks": [{"type": "text", "content": "In the 5th case marker (Il, In), how does gemination behave under comparison vs cause?", "media_id": null}], "options": {"A": "Never geminates in either", "B": "Geminates in both", "C": "Geminates under cause only", "D": "Geminates under comparison (Kaakkaiyin kariyathu); does not geminate under cause"}, "explanation": "Fifth case comparative context causes gemination, while causal context does not."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Serv