{"id": "11th_tamil_u6_q168", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "sandhi_mastery_summary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வல்லினம் மிகும் மற்றும் மிகா இடங்களை அறிவதன் மூலமாக ஏற்படும் முதன்மையான மொழியியல் பயன் யாது?", "media_id": null}], "options": {"A": "பாடல்களை மனனம் செய்ய மட்டும்", "B": "சமஸ்கிருதச் சொற்களை நீக்க மட்டும்", "C": "புதிய சொற்களைப் படைக்க மட்டும்", "D": "பொருண்மைக் குழப்பம் இன்றி, சொற்களின் சரியான பொருளை உணர்ந்து பிழையற எழுதவும் பேசவும் இயலுதல்"}, "explanation": "வல்லினம் மிகல்-மிகாமை விதிகளை அறிவதால் பொருண்மைக் குழப்பம் தவிர்க்கப்பட்டு, எழுத்துப் பிழைகளின்றித் தெளிவான தமிழ் நடையை உருவாக்க முடியும்."}, "en": {"blocks": [{"type": "text", "content": "What is the cardinal linguistic benefit of mastering Sandhi rules of plosive gemination and non-gemination?", "media_id": null}], "options": {"A": "Facilitating rote memorization only", "B": "Eliminating loanwords only", "C": "Coining neologisms only", "D": "Eliminating semantic ambiguity and writing flawless, unambiguous, elegant Tamil prose"}, "explanation": "Mastering Sandhi eliminates syntactic and semantic confusion, ensuring precise prose communication."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "T