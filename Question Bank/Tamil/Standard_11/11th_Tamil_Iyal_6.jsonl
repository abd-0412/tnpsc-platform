{"id": "11th_tamil_u6_q143", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "second_case_marker", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரண்டாம் வேற்றுமை உருபாகிய 'ஐ' மற்றும் நான்காம் வேற்றுமை உருபாகிய 'கு' வெளிப்பட்டு வரும் தொடர்களில் வல்லினம் _____?", "media_id": null}], "options": {"A": "இரண்டிலும் மிகாது", "B": "இரண்டாம் வேற்றுமையில் மட்டும் மிகும்", "C": "இரண்டிலும் கட்டாயமாக மிகும் (எ.கா: பாடத்தைப் படி, ஊருக்குச் சென்றான்)", "D": "நான்காம் வேற்றுமையில் மட்டும் மிகும்"}, "explanation": "இரண்டாம் வேற்றுமை உருபு (ஐ) மற்றும் நான்காம் வேற்றுமை உருபு (கு) வெளிப்படையாக வரும்போது வல்லினம் மிகும்."}, "en": {"blocks": [{"type": "text", "content": "In phrases where the 2nd case marker 'Ai' and 4th case marker 'Ku' appear explicitly, does Vallinam geminate?", "media_id": null}], "options": {"A": "Never geminate in both", "B": "Geminates only in 2nd case", "C": "Strictly geminates in both (e.g., Paadathaip padi, Oorukkuc chendran)", "D": "Geminates only in 4th case"}, "explanation": "Explicit 2nd (Ai) and 4th (Ku) case markers mandate hard consonant doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services