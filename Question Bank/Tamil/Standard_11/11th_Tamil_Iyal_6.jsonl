{"id": "11th_tamil_u6_q017", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "vimanam_levels", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயில் விமானம் எத்தனை நிலைகளை (அடுக்குகளைக்) கொண்டு அமைந்துள்ளது?", "media_id": null}], "options": {"A": "13 நிலைகள் (தளங்கள்)", "B": "9 நிலைகள்", "C": "11 நிலைகள்", "D": "7 நிலைகள்"}, "explanation": "தஞ்சைப் பெரிய கோயிலின் ஸ்ரீவிமானம் மாபெரும் 13 நிலைகளைக் (அடுக்குகளைக்) கொண்டு உயர்ந்து கம்பீரமாகக் காட்சியளிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "How many tiers (Talams/storeys) constitute the main Vimana of Thanjavur Big Temple?", "media_id": null}], "options": {"A": "13 storeys (tiers)", "B": "9 storeys", "C": "11 storeys", "D": "7 storeys"}, "explanation": "The majestic Vimana is built in 13 distinct receding tiers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 131, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 131", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_nam