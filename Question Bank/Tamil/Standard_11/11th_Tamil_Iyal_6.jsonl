{"id": "11th_tamil_u6_q102", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_thiruchazhal", "chapter_id": null, "topic_id": "thiruchazhal_refrain", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருச்சாழல் பாடல்களின் இறுதிச் சீராக அடிகள்தோறும் பயின்று வரும் மரபுத் தொடர் எது?", "media_id": null}], "options": {"A": "அம்மானை", "B": "சாழலோ", "C": "தெள்ளேணம்", "D": "உந்தீபற"}, "explanation": "திருச்சாழல் பதிகத்தின் ஒவ்வொரு பாடலின் இறுதியிலும் 'சாழலோ' என்ற முத்தாய்ப்புச் சொல் மங்கல ஒலியாக நிறைவு பெறுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What recurring refrain concludes every verse in the Thiruchazhal hymn?", "media_id": null}], "options": {"A": "Ammaanai", "B": "Chazhalo", "C": "Thellenam", "D": "Untheepara"}, "explanation": "Every verse culminates with the melodic refrain 'Chazhalo'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 137", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session":