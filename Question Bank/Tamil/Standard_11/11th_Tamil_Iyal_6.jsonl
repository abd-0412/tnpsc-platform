{"id": "11th_tamil_u6_q153", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "uri_words_gemination", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'சால, தவ, நனி' முதலான உரிச்சொற்களின் பின் வல்லினம் எவ்வாறமையும்?", "media_id": null}], "options": {"A": "வல்லினம் மிகும் (எ.கா: சாலப் பேசினான், தவப் பெரிது)", "B": "வல்லினம் மிகாது", "C": "மெல்லினம் தோன்றும்", "D": "இடையினம் தோன்றும்"}, "explanation": "'சால, தவ, உறு' முதலான உரிச்சொற்களின் பின் வரும் வல்லினம் மிகும் (சாலப் பேசினான், தவப் பெரிது)."}, "en": {"blocks": [{"type": "text", "content": "What is the rule following intensifying particles (Urichol) like 'Saala', 'Thava'?", "media_id": null}], "options": {"A": "Strictly geminates (e.g., Saalap pesinaan, Thavap perithu)", "B": "Never geminates", "C": "Nasal doubles", "D": "Medial doubles"}, "explanation": "Urichol intensifying roots require gemination of following plosives."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 141", "url": null, "source_notes"