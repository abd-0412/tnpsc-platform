{"id": "11th_tamil_u6_q077", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_athmanam_and_kutralam", "chapter_id": null, "topic_id": "thirikoodam_three_peaks", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'திரிகூடம்' என்பதன் பொருள் யாது? அம்மலையின் மூன்று சிகரங்கள் எவை?", "media_id": null}], "options": {"A": "மூன்று சிகரங்களைக் கொண்ட மலை (சிவசிகரம், சக்திசிகரம், விஷ்ணுசிகரம்)", "B": "மூன்று நதிகள் கூடும் இடம்", "C": "மூன்று கடல்கள் சங்கமிக்கும் இடம்", "D": "மூன்று காடுகள் இணையும் இடம்"}, "explanation": "'திரி' என்றால் மூன்று; 'கூடம்' என்றால் உச்சி / சிகரம். மூன்று சிகரங்களை உடைய மலை என்பதால் குற்றால மலைக்குத் 'திரிகூட மலை' என்று பெயர் ஏற்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "What does the geological name 'Thirikoodam' signify?", "media_id": null}], "options": {"A": "Mountain bearing three majestic peaks", "B": "Confluence of three rivers", "C": "Meeting point of three seas", "D": "Junction of three forests"}, "explanation": "'Thirikoodam' literally translates to three-peaked mountain."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 136, "chapter": null, "se