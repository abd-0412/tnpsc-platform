{"id": "11th_tamil_u6_q146", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "peyarechcham_non_gemination", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெயரெச்சத் தொடரில் வல்லினம் எவ்வாறமையும்?", "media_id": null}], "options": {"A": "வல்லினம் மிகும்", "B": "வல்லினம் மிகாது (எ.கா: படித்த பையன், எழுதிய பாடல், வந்த குதிரை)", "C": "சில இடங்களில் மிகும்", "D": "மெல்லினம் தோன்றும்"}, "explanation": "தெரிநிலை மற்றும் குறிப்புப் பெயரெச்சங்களின் பின் வரும் வல்லினம் மிகாது (படித்த பையன், நல்ல புத்தகம்)."}, "en": {"blocks": [{"type": "text", "content": "What is the Sandhi rule for standard relative participles (Peyarechcham)?", "media_id": null}], "options": {"A": "Vallinam geminates", "B": "Vallinam never geminates (e.g., Paditha paiyan, Ezhuthiya paadal)", "C": "Geminates optionally", "D": "Nasal consonants emerge"}, "explanation": "Standard relative participles ending in 'a' do not cause gemination of following plosives."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 142, "chapter": null, "section": null, "reference": "11th Tami