{"id": "11th_tamil_u6_q132", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "mkt_death_year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஏழிசை மன்னர் எம். கே. தியாகராஜ பாகவதர் மறைந்த ஆண்டு எது?", "media_id": null}], "options": {"A": "1945", "B": "1950", "C": "1955", "D": "1959"}, "explanation": "எம். கே. தியாகராஜ பாகவதர் 1910-இல் பிறந்து, 1959 நவம்பர் 1 அன்று தம் 49-ஆம் அகவையில் காலமானார்."}, "en": {"blocks": [{"type": "text", "content": "In which year did the singing idol M. K. Thyagaraja Bhagavathar pass away?", "media_id": null}], "options": {"A": "1945", "B": "1950", "C": "1955", "D": "1959"}, "explanation": "He passed away prematurely on November 1, 1959, at the age of 49."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 140, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 140", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags"