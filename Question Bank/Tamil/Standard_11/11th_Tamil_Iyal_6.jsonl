{"id": "11th_tamil_u6_q162", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "irupeyarottu_panbuthogai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இருபெயரொட்டுப் பண்புத்தொகையில் வல்லினம் எவ்வாறமையும்?", "media_id": null}], "options": {"A": "வல்லினம் மிகாது", "B": "வல்லினம் மிகும் (எ.கா: மல்லிகைப் பூ, சாரைப் பாம்பு, மார்கழித் திங்கள்)", "C": "சில இடங்களில் மட்டுமே மிகும்", "D": "மெல்லினம் மிகும்"}, "explanation": "சிறப்புப் பெயரும் பொதுப் பெயரும் இணைந்து வரும் இருபெயரொட்டுப் பண்புத்தொகையில் வல்லினம் கட்டாயமாக மிகும் (மல்லிகைப் பூ, மார்கழித் திங்கள்)."}, "en": {"blocks": [{"type": "text", "content": "How does Vallinam behave in binomial appositional compounds (Irupeyarottu Panbuthogai)?", "media_id": null}], "options": {"A": "Does not geminate", "B": "Strictly geminates (e.g., Malligaip poo, Saaraip paambu, Margazhit thingal)", "C": "Geminates optionally", "D": "Nasal doubles"}, "explanation": "Appositional binomial compounds strictly mandate hard consonant doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 141, "c