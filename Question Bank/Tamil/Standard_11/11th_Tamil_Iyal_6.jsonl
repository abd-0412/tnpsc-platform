{"id": "11th_tamil_u6_q156", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "adukku_thodar_non_gemination", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அடுக்குத்தொடர் மற்றும் இரட்டைக் கிளவியில் வல்லினம் எவ்வாறமையும்?", "media_id": null}], "options": {"A": "இரண்டிலும் மிகும்", "B": "அடுக்குத்தொடரில் மட்டும் மிகும்", "C": "இரட்டைக் கிளவியில் மட்டும் மிகும்", "D": "இரண்டிலும் வல்லினம் மிகாது (எ.கா: பாம்பு பாம்பு, தீ தீ; சலசல, படபட, கலகல)"}, "explanation": "அடுக்குத்தொடரிலும் இரட்டைக் கிளவியிலும் வல்லினம் மிகக் கூடாது (பாம்பு பாம்பு, சலசல)."}, "en": {"blocks": [{"type": "text", "content": "What is the rule governing reiterative words (Adukku Thodar) and onomatopoeic pairs (Irattai-k-kilavi)?", "media_id": null}], "options": {"A": "Geminates in both", "B": "Geminates in Adukku Thodar only", "C": "Geminates in Irattai-k-kilavi only", "D": "Never geminates in either (e.g., Paambu paambu, Theethee; Sala-sala, Pada-pada)"}, "explanation": "Neither repetitive pairs nor echo words permit plosive gemination."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition