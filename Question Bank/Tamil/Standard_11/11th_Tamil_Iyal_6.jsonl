{"id": "11th_tamil_u6_q073", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_athmanam_and_kutralam", "chapter_id": null, "topic_id": "ball_play_rhyme_scheme", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'செம்பொன்செய் சுண்ணமும் தண்தரளத் திரளும் / பம்பிய பூம்பொழில் தும்பிகள் சூழ்ந்து நுகர...' - குற்றாலக் குறவஞ்சியின் பந்தடிப் பாடலில் அமைந்த சந்த நயம் எத்தகையது?", "media_id": null}], "options": {"A": "பந்து துள்ளி விழுவது போன்ற வேகமான தாள நடை கொண்ட சந்த விருத்தம்", "B": "மெல்ல உறங்கும் தூங்கல் நடை", "C": "அறவுரை கூறும் செப்பல் நடை", "D": "அகவல் நடை மட்டுமே"}, "explanation": "பந்து மேலே எழும்பி கீழே துள்ளி விழுவதற்கேற்பச் சொற்கள் துள்ளி ஓடும் வேகமான தாள சந்த நடையில் இப்பாடல் அமைக்கப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "What is the rhythmic cadence of the ball-play song ('Pandadithal') in Kutrala Kuravanji?", "media_id": null}], "options": {"A": "Fast leaping percussive Sandham rhythm mimicking bouncing balls", "B": "Slow somnolent cadence", "C": "Didactic sermon tone", "D": "Agaval blank verse"}, "explanation": "The meter features a dynamic, rhythmic tempo echoing the physical bouncing of balls."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational S