{"id": "11th_tamil_u2_q127", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "supplementary_yanai_doctor", "chapter_id": null, "topic_id": "assertion_reason_yanai_doctor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): ‘யானை டாக்டர்’ சிறுகதை மனிதனின் குரூரத்திற்கும், ஒரு தன்னலமற்ற மனிதனின் எல்லையற்ற கருணைக்கும் இடையிலான மோதலைப் பேசுகிறது.\nகாரணம் (R): ஒருபுறம் மனிதர்கள் வீசிய உடைந்த கண்ணாடி பாட்டில்களால் யானைகள் மடிகின்றன; மறுபுறம் டாக்டர் கே போன்ற மகத்தான மனிதர் காடுகளிலேயே தங்கி தன் வாழ்நாளையே அவற்றைக் குணப்படுத்த அர்ப்பணிக்கிறார்.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றை மிகச்சரியாக விளக்குகிறது", "D": "கூற்று மற்றும் காரணம் இரண்டும் தவறு"}, "explanation": "மனிதனின் சுயநலக் கொடுமைக்கும் டாக்டர் கே-வின் தியாகத்திற்கும் இடையிலான அறப் போராட்டத்தை இக்கதை விவரிப்பதால் இரண்டும் சரியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'Yanai Doctor' portrays the profound moral conflict between reckless human cruelty and saintly altruistic compassion.\nReason (R): While tourists kill elephants by discarding broken glass, Dr. K dedicates his entire mortal existence in hazardous jungles healing them.", "media_id": null}], "options": {"A": "Assertion is true, Reason is false", "B": "Assertion is false, Reason is true", "C": "Both Assertion and Reason are true; Reason is the correct explanation", "D": "Both Assertion and Reason are false"}, "explanation": "Both assertion and reason are true as the story contrasts thoughtless anthropocentric cruelty with transcendent compassion."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 32, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 32", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 2", "Supplementary", "Assertion-Reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
