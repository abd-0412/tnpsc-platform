{"id": "11th_tamil_u2_q094", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aingurunooru", "chapter_id": null, "topic_id": "meaning_aadamai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஆடமைப் பணைத்தோள் அரிவை தன்முகைத்து...’ - இதில் ‘ஆடமை’ என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "அழகான ஆடை", "B": "காற்றில் அசையும் மூங்கில்", "C": "ஆடும் மயில்", "D": "அழகிய மேகம்"}, "explanation": "ஆடு (அசையும்) + அமை (மூங்கில்) = ஆடமை, அதாவது காற்றில் அசைகின்ற மூங்கில் என்று பொருள்படும்."}, "en": {"blocks": [{"type": "text", "content": "What does the classical poetic compound 'Aadamai' signify in the opening verse?", "media_id": null}], "options": {"A": "Beautiful woven garment", "B": "Wind-swayed bamboo (Asaiyum Moongil)", "C": "Dancing peacock", "D": "Graceful raincloud"}, "explanation": "'Aadamai' (Aadu + Amai) means bamboo swaying gracefully in the breeze."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 30", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam