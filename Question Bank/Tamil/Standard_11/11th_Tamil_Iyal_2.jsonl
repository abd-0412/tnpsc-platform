{"id": "11th_tamil_u2_q081", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_thirumalai_murugan_pallu", "chapter_id": null, "topic_id": "peacock_sound_word", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மழையைக் கண்டு மகிழ்ந்து மயில் எழுப்பும் ஒலி மரபுச்சொல் எது?", "media_id": null}], "options": {"A": "அகவும்", "B": "கத்தும்", "C": "கூவும்", "D": "பிளிறும்"}, "explanation": "மயில் ‘அகவும்’ என்பது மரபுச்சொல்லாகும். (குயில் கூவும், யானை பிளிறும்)."}, "en": {"blocks": [{"type": "text", "content": "What is the traditional idiomatic acoustic verb for the call of a peacock?", "media_id": null}], "options": {"A": "Agavum (அகவும்)", "B": "Kaththum", "C": "Koovum", "D": "Pilirum"}, "explanation": "The idiomatic Tamil sound word for peacock call is 'Agavum'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 28, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 28", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}