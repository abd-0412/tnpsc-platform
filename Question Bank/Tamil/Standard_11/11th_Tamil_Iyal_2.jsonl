{"id": "11th_tamil_u2_q035", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aethilik_kuruvigal", "chapter_id": null, "topic_id": "poetic_line_koondugal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கூடுகட்ட வைக்கோல் இல்லை / குடிக்கத் தூய நீர் இல்லை...’ - இக்கவிதை வரிகள் எதனைப் படம் பிடிக்கின்றன?", "media_id": null}], "options": {"A": "விவசாயக் கருவிகளின் பற்றாக்குறையை", "B": "மனிதர்களின் ஆடம்பர வாழ்வை", "C": "காடுகள் அழிப்பு, இரசாயனப் பயன்பாடு மற்றும் கான்கிரீட் காடுகளால் பறவைகளின் வாழ்விடம் அழிக்கப்பட்ட அவலத்தை", "D": "பறவைகளின் சோம்பேறித்தனத்தை"}, "explanation": "நவீன நகரமயமாக்கலும், மரங்கள் வெட்டப்பட்டதும், நீர்நிலைகள் தூர்க்கப்பட்டதும் பறவைகளை அகதிகளாக மாற்றிவிட்டன என்பதை இது சுட்டுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What ecological crisis is mirrored in the lines 'No straw left to weave a nest, no pure drop of water left to sip...'?", "media_id": null}], "options": {"A": "Shortage of agricultural farm implements", "B": "Human lavish consumerism", "C": "Destruction of bird habitats wrought by deforestation, agrochemicals, and concrete urban jungles", "D": "Avian indolence"}, "explanation": "It laments the brutal habitat destruction driving common sparrows to extinction."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "