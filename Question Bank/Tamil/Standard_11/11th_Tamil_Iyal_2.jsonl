{"id": "11th_tamil_u2_q082", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_thirumalai_murugan_pallu", "chapter_id": null, "topic_id": "river_reference_pallu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருமலை முருகன் பள்ளு பாடலில் செழித்து ஓடுவதாகக் குறிப்பிடப்படும் ஆறு எது?", "media_id": null}], "options": {"A": "காவிரி ஆறு", "B": "சிற்றாறு (குற்றாலச் சிற்றாறு)", "C": "வைகை ஆறு", "D": "பாலாறு"}, "explanation": "தென்காசி, பண்பொழிப் பகுதியில் குற்றால மலையிலிருந்து பாய்ந்து வரும் சிற்றாறே இப்பாடலின் பாடுபொருளாகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which perennial river is celebrated as irrigating the fields of Thirumalai Murugan in the poem?", "media_id": null}], "options": {"A": "Cauvery River", "B": "Chittaar River (Courtallam Chittaaru)", "C": "Vaigai River", "D": "Palaar River"}, "explanation": "The pristine Chittaar River flowing from Courtallam cascades through this agricultural tract."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 28, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 28", "url": null, "source_notes": null}, "pr