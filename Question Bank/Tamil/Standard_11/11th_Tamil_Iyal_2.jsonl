{"id": "11th_tamil_u2_q154", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "grammar_punarchi_vithigal", "chapter_id": null, "topic_id": "kurriyallukaram_six_types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குற்றியலுகரம் எத்தனை வகைப்படும்?", "media_id": null}], "options": {"A": "நான்கு", "B": "ஆறு வகை (நெடில்தொடர், ஆய்தத்தொடர், உயிர்த்தொடர், வன்தொடர், மென்தொடர், இடைத்தொடர்)", "C": "எட்டு வகை", "D": "பத்து வகை"}, "explanation": "குற்றியலுகரம் 6 வகைப்படும்: நெடில்தொடர் (பாகு), ஆய்தத்தொடர் (எஃகு), உயிர்த்தொடர் (வரகு), வன்தொடர் (பட்டு), மென்தொடர் (பந்து), இடைத்தொடர் (மார்பு)."}, "en": {"blocks": [{"type": "text", "content": "Into how many types is Kurriyallukaram classified in Tamil grammar?", "media_id": null}], "options": {"A": "Four types", "B": "Six types (Nedildhodar, Aaydhadhodar, Uyirthodar, Vanthodar, Menthodar, Idaithodar)", "C": "Eight types", "D": "Ten types"}, "explanation": "Kurriyallukaram is categorized into 6 types based on the preceding phonemic environment."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 37", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 2", "Grammar", "Kurriyallukaram Types"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
