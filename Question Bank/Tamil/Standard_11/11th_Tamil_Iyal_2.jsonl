{"id": "11th_tamil_u2_q183", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "revision_unit_2", "chapter_id": null, "topic_id": "assertion_reason_unit2_overall", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 11-ஆம் வகுப்பு இயல் 2 ‘மாமழை போற்றுதும்’ இயற்கை, சுற்றுச்சூழல் மற்றும் வேளாண்மை ஆகியவற்றை ஒருங்கிணைக்கும் சூழலியல் பெட்டகமாகும்.\nகாரணம் (R): இயற்கை வேளாண்மையின் விஞ்ஞானத் தேவை, அழியும் சிட்டுக்குருவிகளின் சூழலியல் எச்சரிக்கை, சங்க இலக்கிய ஐங்குறுநூற்றின் நிலவளம், உழவு வாழ்வின் பள்ளு இலக்கியப் பெருமை, மற்றும் வனவிலங்குப் பாதுகாப்பு என அனைத்துக் கூறுகளையும் இது முழுமையாகப் பேசுகிறது.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றை மிகச்சரியாக விளக்குகிறது", "D": "கூற்று மற்றும் காரணம் இரண்டும் தவறு"}, "explanation": "இயல் 2 மனிதனுக்கும் இயற்கைக்குமான பிணைப்பை அனைத்து பரிமாணங்களிலும் ஆழமாக விவரிப்பதால் இரண்டும் சரியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Unit 2 'Maamazhai Poatrudhum' stands as a comprehensive ecological repository integrating organic farming, biodiversity, and pastoral literature.\nReason (R): It seamlessly addresses agroecology, sparrow extinction, Sangam agricultural geography, peasant folk heritage, and wildlife conservation.", "media_id": null}], "options": {"A": "Assertion is true, Reason is false", "B": "Assertion is false, Reason is true", "C": "Both Assertion and Reason are true; Reason is the correct explanation", "D": "Both Assertion and Reason are false"}, "explanation": "Both assertion and reason are true as Unit 2 presents a holistic ecological curriculum."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 24, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 24", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 2", "Curriculum", "Assertion-Reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u2_q184", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "revision_unit_2", "chapter_id": null, "topic_id": "pyq_kurinji_poet", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] ஐங்குறுநூற்றில் குறிஞ்சித் திணையைப் பாடிய புலவர் யார்?", "media_id": null}], "options": {"A": "ஓரம்போகியார்", "B": "அம்மூவனார்", "C": "பேயனார்", "D": "கபிலர்"}, "explanation": "ஐங்குறுநூற்றில் குறிஞ்சித் திணையைப் பாடியவர் கபிலர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Who composed the Kurinji Thinai in Aingurunooru?", "media_id": null}], "options": {"A": "Oarampoakiyaar", "B": "Ammoovanaar", "C": "Peyanaar", "D": "Kabilar"}, "explanation": "Kabilar composed the Kurinji Thinai in Aingurunooru."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 30", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC", "exam_name": "Group 4", "year": 2024, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "U