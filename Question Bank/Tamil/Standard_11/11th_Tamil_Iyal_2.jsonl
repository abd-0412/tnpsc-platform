{"id": "11th_tamil_u2_q093", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aingurunooru", "chapter_id": null, "topic_id": "ten_subdivisions", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஐங்குறுநூற்றில் ஒவ்வொரு திணையிலும் உள்ள 100 பாடல்கள் எவ்வாறு பிரிக்கப்பட்டுள்ளன?", "media_id": null}], "options": {"A": "தலா 10 பாடல்கள் கொண்ட பத்து பகுதிகளாக (பத்து பத்துகளாக)", "B": "தலா 20 பாடல்கள் கொண்ட ஐந்து பகுதிகளாக", "C": "தலா 50 பாடல்களாக", "D": "பிரிவுகள் ஏதுமின்றி"}, "explanation": "ஒவ்வொரு திணையிலும் தலா 10 பாடல்களைக் கொண்ட 10 பத்துகள் உள்ளன (எ.கா: வேட்கைப் பத்து, வேழப் பத்து போன்றவை). 10 × 10 = 100."}, "en": {"blocks": [{"type": "text", "content": "How are the 100 songs in each Thinai of Aingurunooru internally categorized?", "media_id": null}], "options": {"A": "Into ten decads (Paththu) of 10 songs each", "B": "Into five sections of 20 songs", "C": "Into two sections of 50 songs", "D": "Without any subdivisions"}, "explanation": "Each Thinai comprises ten themed decads (Paththu), totaling 100 poems per landscape."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter":