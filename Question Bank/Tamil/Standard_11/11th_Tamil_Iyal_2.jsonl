{"id": "11th_tamil_u2_q034", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aethilik_kuruvigal", "chapter_id": null, "topic_id": "sparrow_day", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உலக சிட்டுக்குருவிகள் தினம் (World Sparrow Day) கடைப்பிடிக்கப்படும் நாள் எது?", "media_id": null}], "options": {"A": "ஜூன் 5", "B": "மார்ச் 20", "C": "ஏப்ரல் 22", "D": "டிசம்பர் 2"}, "explanation": "ஒவ்வொரு ஆண்டும் மார்ச் 20-ஆம் நாள் உலக சிட்டுக்குருவிகள் தினமாகக் கொண்டாடப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "On which date is World Sparrow Day officially commemorated globally?", "media_id": null}], "options": {"A": "June 5", "B": "March 20", "C": "April 22", "D": "December 2"}, "explanation": "World Sparrow Day is observed internationally every year on March 20."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 27", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_med