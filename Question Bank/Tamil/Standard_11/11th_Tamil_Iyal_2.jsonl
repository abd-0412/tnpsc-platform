{"id": "11th_tamil_u2_q163", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "grammar_punarchi_vithigal", "chapter_id": null, "topic_id": "glides_count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் இலக்கணத்தில் உடம்படுமெய்களாக ஏற்றுக்கொள்ளப்பட்ட மெய்யெழுத்துகள் எத்தனை?", "media_id": null}], "options": {"A": "நான்கு (க், ச், த், ப்)", "B": "மூன்று (ர், ல், ழ்)", "C": "இரண்டு (ய், வ்)", "D": "ஒன்று (ஃ)"}, "explanation": "தமிழ் மொழியில் 'ய்' மற்றும் 'வ்' ஆகிய இரண்டு மெய்கள் மட்டுமே உடம்படுமெய்களாக இலக்கண அறிஞர்களால் ஏற்றுக்கொள்ளப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "How many consonants are officially sanctioned as Udampadumei glides in Tamil grammar?", "media_id": null}], "options": {"A": "Four (K, Ch, Th, P)", "B": "Three (R, L, Zh)", "C": "Two (Y and V: ய், வ்)", "D": "One (Aaytham)"}, "explanation": "Only two consonants, 'y' (ய்) and 'v' (வ்), serve as phonetic bridging glides."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 36", "url": null, "source_notes": null}, "previous_yea