{"id": "11th_tamil_u2_q004", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "prose_iyarkai_velanmai", "chapter_id": null, "topic_id": "panchagavya_ingredients", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயற்கை வேளாண்மையில் பயிர் ஊக்கியாகவும் பூச்சி விரட்டியாகவும் பயன்படும் ‘பஞ்சகவ்யா’ தயாரிக்கப் பயன்படும் பசுவின் ஐந்து பொருள்கள் எவை?", "media_id": null}], "options": {"A": "சாணம், எலும்பு, தோல், கொம்பு, வால்", "B": "பால், தயிர், நெய், தோல், இரத்தம்", "C": "சாணம், கோமியம், எலும்பு, மயிர், கொம்பு", "D": "சாணம், கோமியம் (சிறுநீர்), பால், தயிர், நெய்"}, "explanation": "பஞ்சகவ்யா என்பது பசுவிலிருந்து பெறப்படும் சாணம், கோமியம், பால், தயிர், நெய் ஆகிய ஐந்து பொருள்களோடு கரும்புச்சாறு, இளநீர், வாழைப்பழம் சேர்த்துத் தயாரிக்கப்படும் இயற்கை உரம்."}, "en": {"blocks": [{"type": "text", "content": "Which five sacred bovine derivatives form the basis of the organic growth-promoter and pest-repellent 'Panchagavya'?", "media_id": null}], "options": {"A": "Dung, bone, skin, horn, tail", "B": "Milk, curd, ghee, hide, blood", "C": "Dung, urine, bone, hair, horn", "D": "Cow dung, cow urine, milk, curd, and ghee"}, "explanation": "Panchagavya derives from five cow products: dung, urine, milk, curd, and ghee, enriched with jaggery and coconut water."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 25, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 25", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 2", "Prose", "Panchagavya"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u2_q005", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "prose_iyarkai_velanmai", "chapter_id": null, "topic_id": "earthworm_friend", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உழவனின் நண்பன்’ என்று போற்றப்படும் உயிரினம் எது?", "media_id": null}], "options": {"A": "மண்புழு", "B": "வெட்டுக்கிளி", "C": "எலி", "D": "நத்தை"}, "explanation": "மண்ணைத் தின்று செரித்து உரமாக மாற்றுவதாலும், மண்ணைத் துளையிட்டு காற்றோட்டம் தருவதாலும் மண்புழு ‘உழவனின் நண்பன்’ எனப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which living creature is universally revered as the 'Farmer's Best Friend' in agroecology?", "media_id": null}], "options": {"A": "Earthworm (Manpuzhu)", "B": "Locust", "C": "Rat", "D": "Snail"}, "explanation": "The earthworm aerates the soil and produces nutrient-rich vermicompost, making it the farmer's indispensable ally."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 25, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 25", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 2", "Prose", "Ecology"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u2_q006", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "prose_iyarkai_velanmai", "chapter_id": null, "topic_id": "herbal_pest_repellent", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயற்கைப் பூச்சி விரட்டி தயாரிக்கப் பயன்படும் ஐந்து இலைகளுள் பொருந்தாத ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "வேப்பிலை, நொச்சி", "B": "யூகலிப்டஸ் (தைல இலை)", "C": "புங்கன், ஆடாதோடை", "D": "எருக்கு"}, "explanation": "வேப்பிலை, நொச்சி, புங்கன், ஆடாதோடை, எருக்கு ஆகிய கசப்பு, காரத்தன்மை கொண்ட ஐந்து இலைகளே இயற்கைப் பூச்சி விரட்டிக்கு உகந்தவை; யூகலிப்டஸ் இதில் சேராது."}, "en": {"blocks": [{"type": "text", "content": "Which of the following leaves is NOT traditionally used in preparing the five-leaf herbal pest repellent (Ainthilai Karisal)?", "media_id": null}], "options": {"A": "Neem and Nochi", "B": "Eucalyptus", "C": "Pungam and Aadaathodai", "D": "Erukku (Calotropis)"}, "explanation": "The traditional five leaves are Neem, Nochi, Pungam, Aadaathodai, and Erukku; Eucalyptus is excluded."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 25, "chapter": null, "section": nu