{"id": "11th_tamil_u2_q047", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aethilik_kuruvigal", "chapter_id": null, "topic_id": "assertion_reason_sparrow", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): சிட்டுக்குருவிகள் மனிதன் வாழும் வீடுகளின் கூரை இடுக்குகளிலேயே கூடு கட்டி வாழும் பழக்கமுடையவை.\nகாரணம் (R): நவீன கான்கிரீட் கட்டட அமைப்புகளும், கண்ணாடி மாளிகைகளும் குருவிகள் கூடுகட்டுவதற்கான சூழலை முற்றிலும் அகற்றிவிட்டன.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றை மிகச்சரியாக விளக்குகிறது", "D": "கூற்று மற்றும் காரணம் இரண்டும் தவறு"}, "explanation": "பழைய ஓட்டு வீடுகள் கூடுகட்ட இடம் தந்தன; நவீன கான்கிரீட் சுவர்கள் அவற்றுக்கு இடமில்லாமல் செய்துவிட்டன. எனவே இரண்டும் சரியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): House sparrows historically coexisted intimately with humans, nesting within roof crevices of traditional tiled houses.\nReason (R): Modern concrete architecture and sealed glass facades have totally eliminated nesting cavities for sparrows.", "media_id": null}], "options": {"A": "Assertion is true, Reason is false", "B": "Assertion is false, Reason is true", "C": "Both Assertion and Reason are true; Reason is the correct explanation", "D": "Both Assertion and Reason are false"}, "explanation": "Both assertion and reason are true as architectural shifts dismantled the sparrow's urban habitat."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 27", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 2", "Poetry", "Assertion-Reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u2_q048", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aethilik_kuruvigal", "chapter_id": null, "topic_id": "nature_sympathy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஏதிலிக்குருவிகள்’ கவிதை மனிதர்களிடம் எத்தகைய மாற்றத்தை எதிர்பார்க்கிறது?", "media_id": null}], "options": {"A": "அனைத்து பறவைகளையும் கூண்டில் அடைக்க வேண்டும்", "B": "பறவைகளை நகரங்களிலிருந்து விரட்ட வேண்டும்", "C": "இயற்கையை மனிதனின் சுயநலத்திற்கு மட்டுமே பயன்படுத்த வேண்டும்", "D": "மற்ற உயிர்களையும் தன்னைப் போல மதித்து, சூழலியல் பல்லுயிர் பாதுகாப்பிற்கு உறுதுணையாக இருக்க வேண்டும்"}, "explanation": "பறவைகள் மற்றும் சிற்றுயிர்கள் மீது பரிவு கொண்டு, மரங்களை நட்டு, நீர்நிலைகளைப் பாதுகாத்து சகவாழ்வு வாழ வேண்டும் என்று இக்கவிதை அறைகூவல் விடுக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What moral transformation in human consciousness does 'Aethilik Kuruvigal' advocate?", "media_id": null}], "options": {"A": "Caging all free birds in zoos", "B": "Banishing birds from municipal cities", "C": "Exploiting ecosystems exclusively for human hedonism", "D": "Respecting other living beings as co-inheritors of Earth, nurturing trees, and preserving biodiversity"}, "explanation": "It advocates biophilic empathy, urging humanity to preserve ecosystems for all co-existing species."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "