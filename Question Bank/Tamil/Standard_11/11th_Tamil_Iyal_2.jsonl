{"id": "11th_tamil_u2_q090", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aingurunooru", "chapter_id": null, "topic_id": "marutham_poet", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடப்பகுதியில் இடம்பெற்றுள்ள ஐங்குறுநூற்றின் மருதத் திணைப் பாடல்களைப் பாடிய புலவர் யார்?", "media_id": null}], "options": {"A": "கபிலர்", "B": "ஓரம்போகியார்", "C": "பேயனார்", "D": "அம்மூவனார்"}, "explanation": "மருதத் திணையின் 100 பாடல்களையும் பாடியவர் ஓரம்போகியார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Which Sangam poet composed the 100 verses of Marutham Thinai featured in the textbook?", "media_id": null}], "options": {"A": "Kabilar", "B": "Oarampoakiyaar", "C": "Peyanaar", "D": "Ammoovanaar"}, "explanation": "Oarampoakiyaar composed all 100 songs belonging to the Marutham riverine landscape."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 30", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null