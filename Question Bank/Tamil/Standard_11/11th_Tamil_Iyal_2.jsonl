{"id": "11th_tamil_u2_q056", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aethilik_kuruvigal", "chapter_id": null, "topic_id": "poem_core_warning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஏதிலிக்குருவிகள்’ கவிதையின் இறுதி எச்சரிக்கை மனித சமுதாயத்திற்கு உணர்த்துவது யாது?", "media_id": null}], "options": {"A": "பறவைகள் மனிதர்களைத் தாக்கும்", "B": "இயற்கையை முற்றிலும் அழித்துவிட வேண்டும்", "C": "பறவைகளுக்குப் பதிலாக எந்திரங்களை வைக்க வேண்டும்", "D": "இன்று குருவிகள் அகதிகள்; இயற்கையை நாம் தொடர்ந்து அழித்தால் நாளை மனித இனமே பூமியில் ஏதிலியாக (அகதியாக) அலைய நேரிடும்"}, "explanation": "பறவைகளின் அழிவு என்பது பூமி அழியத் தொடங்குவதன் அறிகுறி; இயற்கையைக் காக்காவிட்டால் மனிதனே வீடற்ற அகதியாவான் என்பதே இக்கவிதையின் எச்சரிக்கை."}, "en": {"blocks": [{"type": "text", "content": "What ultimate ecological admonition does 'Aethilik Kuruvigal' sound to contemporary human civilization?", "media_id": null}], "options": {"A": "Birds will attack humans violently", "B": "Nature must be eradicated entirely", "C": "Robots must replace avian wildlife", "D": "Today sparrows are displaced refugees; if humans persist in ecocide, tomorrow humanity itself will wander homeless across a desolate Earth"}, "explanation": "The poem warns that if ecocide continues, humanity will soon find itself homeless on a devastated planet."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "ma