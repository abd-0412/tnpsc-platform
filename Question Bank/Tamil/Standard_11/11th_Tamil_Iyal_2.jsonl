{"id": "11th_tamil_u2_q097", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aingurunooru", "chapter_id": null, "topic_id": "turai_explanation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடப்பகுதி ஐங்குறுநூற்றுப் பாடலின் துறை விளக்கம் யாது?", "media_id": null}], "options": {"A": "தலைவன் சிறைப்புறத்தானாக, தோழி தலைவிக்குச் சொல்லுவாளாய் தலைவனுக்குக் கூறியது", "B": "தலைவி தோழியிடம் தன் காதலைக் கூறியது", "C": "பாணன் தலைவனிடம் தூது சென்றது", "D": "செவிலித்தாய் நற்றாய்க்கு உரைத்தது"}, "explanation": "வேலியின் மறுபுறம் தலைவன் நின்று கேட்டுக் கொண்டிருப்பதை அறிந்த தோழி, தலைவிக்கு ஆறுதல் கூறுவது போலத் தலைவனின் காதில் படுமாறு எடுத்துரைக்கிறாள்."}, "en": {"blocks": [{"type": "text", "content": "What is the dramatic context (Thurai) of the textbook Aingurunooru poem?", "media_id": null}], "options": {"A": "With the hero listening secretly behind the fence (Siraippuraththaan), the maid addresses the heroine so that the hero overhears the counsel", "B": "Heroine confessing love to maid", "C": "Bard carrying diplomatic message", "D": "Foster mother speaking to biological mother"}, "explanation": "The maid speaks aloud to the heroine, deliberately ensuring the hidden hero hears her words."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Ka