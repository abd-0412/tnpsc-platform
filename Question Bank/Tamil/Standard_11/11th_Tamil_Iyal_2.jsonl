{"id": "11th_tamil_u2_q050", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aethilik_kuruvigal", "chapter_id": null, "topic_id": "author_awards_general", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அழகிய பெரியவன் எந்த இலக்கிய அமைப்புகளின் பரிசுகளையும் பெற்றுள்ளார்?", "media_id": null}], "options": {"A": "நோபல் பரிசு", "B": "தமிழ்நாடு அரசு விருது மற்றும் திருப்பூர் தமிழ்ச் சங்க விருது", "C": "புலிட்சர் பரிசு", "D": "மேன் புக்கர் பரிசு"}, "explanation": "அழகிய பெரியவன் தமிழ்நாடு அரசு விருது, திருப்பூர் தமிழ்ச் சங்க விருது உள்ளிட்ட பல மதிப்புமிக்க விருதுகளைப் பெற்றுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which prestigious literary honors were conferred upon author Azhagiya Periyavan?", "media_id": null}], "options": {"A": "Nobel Prize", "B": "Government of Tamil Nadu State Award and Tiruppur Tamil Sangam Award", "C": "Pulitzer Prize", "D": "Man Booker Prize"}, "explanation": "He was awarded the Tamil Nadu State Award and the prestigious Tiruppur Tamil Sangam Award."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "referen