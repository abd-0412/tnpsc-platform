{"id": "11th_tamil_u2_q009", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "prose_iyarkai_velanmai", "chapter_id": null, "topic_id": "crop_rotation_benefit", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பயறு வகை பயிர்களை (உளுந்து, பாசிப்பயறு) சுழற்சி முறையில் பயிரிடுவதால் மண்ணுக்குக் கிடைக்கும் முதன்மை நன்மை என்ன?", "media_id": null}], "options": {"A": "வேர் முடிச்சுகளில் உள்ள ரைசோபியம் பாக்டீரியா மூலம் வளிமண்டல நைட்ரஜனை (தழைச்சத்து) மண்ணில் நிலைநிறுத்துகிறது", "B": "மண்ணின் ஈரப்பதத்தை முற்றிலும் உறிஞ்சிவிடும்", "C": "களைகளை அளவுக்கு அதிகமாக வளர்க்கும்", "D": "மண்ணின் அமிலத்தன்மையை அதிகரிக்கும்"}, "explanation": "பயறு வகைப் பயிர்களின் வேர் முடிச்சுகளில் உள்ள பாக்டீரியாக்கள் காற்றில் உள்ள தழைச்சத்தை (நைட்ரஜன்) கிரகித்து மண்ணை உரமாக்குகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What is the prime agronomic advantage of practicing crop rotation with leguminous pulses (such as black gram and green gram)?", "media_id": null}], "options": {"A": "Rhizobium bacteria in root nodules fix atmospheric nitrogen directly into the soil structure", "B": "Completely dehydrates soil moisture", "C": "Spurs uncontrollable weed growth", "D": "Increases soil acidity dangerously"}, "explanation": "Symbiotic Rhizobium bacteria in pulse nodules fix atmospheric nitrogen, naturally fertilizing the topsoil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "