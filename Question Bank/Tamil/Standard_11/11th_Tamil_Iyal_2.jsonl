{"id": "11th_tamil_u2_q037", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aethilik_kuruvigal", "chapter_id": null, "topic_id": "radiation_and_sparrows", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிட்டுக்குருவிகள் போன்ற சிற்றுயிர்கள் பெருமளவில் அழிந்துபோவதற்கு நவீன காலத்தில் காரணமாக அமைந்த முதன்மைக் காரணி எது?", "media_id": null}], "options": {"A": "கைப்பேசி கோபுரங்களின் கதிர்வீச்சு (Cell tower radiation), பூச்சிக்கொல்லிகள் மற்றும் காற்று மாசுபாடு", "B": "பறவைகளின் இடம்பெயர்வு விருப்பம்", "C": "அதிகளவில் மரங்கள் நடப்பட்டது", "D": "இயற்கை உரப் பயன்பாடு"}, "explanation": "செல்போன் டவர்களின் மின்காந்தக் கதிர்வீச்சு, பூச்சிக்கொல்லிகளால் புழுக்கள் அழிந்தது மற்றும் கூடுகட்ட இடமில்லாத கான்கிரீட் வீடுகள் குருவிகளை அழித்துவிட்டன."}, "en": {"blocks": [{"type": "text", "content": "What modern anthropogenic technological factor has severely decimated sparrow populations alongside pesticides?", "media_id": null}], "options": {"A": "Cellular telephone tower electromagnetic radiation, chemical pesticides, and toxic pollution", "B": "Spontaneous migratory wanderlust", "C": "Excessive afforestation", "D": "Organic compost usage"}, "explanation": "Cellular microwave radiation, pesticide toxicity, and modern architecture have destroyed urban sparrow ecosystems."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers"