{"id": "11th_tamil_u2_q007", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "prose_iyarkai_velanmai", "chapter_id": null, "topic_id": "nammazhvar_ashram", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நம்மாழ்வார் இயற்கை வேளாண்மைப் பயிற்சிகளுக்காக கரூர் மாவட்டம் வானகத்தில் அமைத்த சுற்றுச்சூழல் பண்ணையின் பெயர் என்ன?", "media_id": null}], "options": {"A": "காந்தி பண்ணை", "B": "பாரதி வனம்", "C": "வானகம் (நம்மாழ்வார் உயிர்ச்சூழல் நடுவம்)", "D": "அறம் பண்ணை"}, "explanation": "கரூர் மாவட்டம் கடவூர் அருகே அமைந்துள்ள ‘வானகம்’ பண்ணை நம்மாழ்வாரால் இயற்கை வேளாண்மைப் பயிற்சிக்காக உருவாக்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "What is the name of the ecological research and training farm established by Nammazhvar at Karur district?", "media_id": null}], "options": {"A": "Gandhi Farm", "B": "Bharathi Vanam", "C": "Vaanagam (Nammazhvar Ecological Centre)", "D": "Aram Farm"}, "explanation": "'Vaanagam' near Kadavur in Karur district was founded by Nammazhvar as an ecological living university."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 26, "chapter": null, "section": null