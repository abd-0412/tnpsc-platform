{"id": "11th_tamil_u2_q041", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aethilik_kuruvigal", "chapter_id": null, "topic_id": "aethili_metaphor_depth", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஏதிலிக்குருவிகள்’ கவிதையில் குருவிகள் எதனால் ‘ஏதிலிகள்’ (அகதிகள்) ஆகிவிட்டன என்று கவிஞர் வருந்துகிறார்?", "media_id": null}], "options": {"A": "மரங்கள் வெட்டப்பட்டு, மண் நஞ்சாக்கப்பட்டு, காடுகள் அழிக்கப்பட்டதால் கூடுகட்ட இடமின்றி அலையும் நிலைக்குத் தள்ளப்பட்டதால்", "B": "வேட்டையாடப்பட்டதால் மட்டுமே", "C": "வானிலை மாறியதால் மட்டுமே", "D": "குருவிகளுக்கு பறக்கத் தெரியாததால்"}, "explanation": "மனிதர்களின் பேராசையால் இயற்கை எழில் அழிக்கப்பட்டு, மரங்களும் கூடுகளும் சிதைக்கப்பட்டதால் பறவைகள் தங்கள் சொந்த மண்ணிலேயே வீடற்ற அகதிகளாகிவிட்டன."}, "en": {"blocks": [{"type": "text", "content": "Why does the poet grieve that sparrows have been reduced to 'Aethiligal' (refugees)?", "media_id": null}], "options": {"A": "Because trees were chopped, soil poisoned, and forests cleared, leaving them homeless in their native land", "B": "Solely due to hunting", "C": "Solely due to seasonal climate shifts", "D": "Because sparrows forgot how to fly"}, "explanation": "Aggressive urbanization has stripped birds of nesting trees and sustenance, turning them into refugees."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers"