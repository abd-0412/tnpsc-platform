{"id": "11th_tamil_u2_q095", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aingurunooru", "chapter_id": null, "topic_id": "panai_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பணைத்தோள்’ என்பதில் ‘பணை’ என்பதன் பொருள் என்ன?", "media_id": null}], "options": {"A": "பனைமரம்", "B": "பறை இசைக்கருவி", "C": "பருத்த / மூங்கில் போன்ற திரண்ட தோள்", "D": "பனை ஓலை"}, "explanation": "பணை என்றால் பருத்த அல்லது தடித்த என்று பொருள்; பணைத்தோள் என்றால் மூங்கில் போலத் திரண்ட அழகான தோள் என்று பொருள்."}, "en": {"blocks": [{"type": "text", "content": "What does 'Panai' mean in the classical epithet 'Panai-thoaal'?", "media_id": null}], "options": {"A": "Palmyra palm tree", "B": "Percussion drum", "C": "Plump, bamboo-like shapely shoulders", "D": "Palm leaf"}, "explanation": "'Panai' signifies shapely, plump fullness like tender bamboo stems."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 30", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year