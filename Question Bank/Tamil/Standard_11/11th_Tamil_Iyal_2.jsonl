{"id": "11th_tamil_u2_q140", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "supplementary_yanai_doctor", "chapter_id": null, "topic_id": "final_moral_lesson", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘யானை டாக்டர்’ சிறுகதை ஒவ்வொரு மனிதனுக்கும் விடுக்கும் உடனடி வேண்டுகோள் யாது?", "media_id": null}], "options": {"A": "விலங்குகளை வேட்டையாட வேண்டும்", "B": "வனத்துறைப் பணியில் சேர வேண்டும்", "C": "யானைகளை வீடுகளில் வளர்க்க வேண்டும்", "D": "இயற்கைச் சூழல்களுக்குச் செல்லும்போது பிளாஸ்டிக் மற்றும் கண்ணாடி பாட்டில்களைக் காடுகளுக்குள் எறியாமல், பூமி அனைத்து உயிர்களுக்கும் பொதுவானது என்பதை உணர வேண்டும்"}, "explanation": "காடுகளுக்குள் குப்பைகளையும் பாட்டில்களையும் வீசாமல், மற்ற உயிரினங்களின் வாழ்வுரிமையை மதிப்பதே இக்கதை கற்பிக்கும் மகத்தான வாழ்க்கைப் பாடம்."}, "en": {"blocks": [{"type": "text", "content": "What urgent, practical civic responsibility does 'Yanai Doctor' demand from every citizen?", "media_id": null}], "options": {"A": "Hunting wild beasts", "B": "Compulsorily joining the forest service", "C": "Domesticating elephants in private backyards", "D": "Never littering plastic, glass bottles, or toxic trash in wilderness sanctuaries, recognizing that Earth belongs equally to all non-human species"}, "explanation": "It demands strict environmental ethics: zero littering in wild habitats and acknowledging the equal right of all beings to live."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_setting