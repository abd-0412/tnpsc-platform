{"id": "11th_tamil_u2_q086", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aingurunooru", "chapter_id": null, "topic_id": "line_limits", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஐங்குறுநூறு பாடல்களின் அடி எல்லை (சிற்றெல்லை, பேரெல்லை) யாது?", "media_id": null}], "options": {"A": "4 அடி சிற்றெல்லை, 8 அடி பேரெல்லை", "B": "3 அடி சிற்றெல்லை, 6 அடி பேரெல்லை", "C": "9 அடி சிற்றெல்லை, 12 அடி பேரெல்லை", "D": "13 அடி சிற்றெல்லை, 31 அடி பேரெல்லை"}, "explanation": "ஐங்குறுநூறு மிகக் குறுகிய அடிகளான 3 அடி சிற்றெல்லையும், 6 அடி பேரெல்லையும் கொண்ட அகவற்பாக்களால் ஆனது."}, "en": {"blocks": [{"type": "text", "content": "What is the line boundary (minimum and maximum meter lines) of verses in Aingurunooru?", "media_id": null}], "options": {"A": "4 lines minimum, 8 lines maximum", "B": "3 lines minimum, 6 lines maximum", "C": "9 lines minimum, 12 lines maximum", "D": "13 lines minimum, 31 lines maximum"}, "explanation": "Aingurunooru features the shortest Agaval verse limits: 3 lines minimum to 6 lines maximum."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter": null, "section"