{"id": "11th_tamil_u2_q087", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aingurunooru", "chapter_id": null, "topic_id": "total_poems", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஐங்குறுநூறு எத்தனை திணைகளையும், எத்தனை பாடல்களையும் உள்ளடக்கியது?", "media_id": null}], "options": {"A": "நான்கு திணைகள், 400 பாடல்கள்", "B": "ஐந்து திணைகள், 100 பாடல்கள்", "C": "ஐந்து திணைகள் (தலா 100 பாடல்கள் வீதம்), 500 பாடல்கள்", "D": "ஆறு திணைகள், 600 பாடல்கள்"}, "explanation": "ஐந்து + குறுமை + நூறு = ஐங்குறுநூறு. குறிஞ்சி, முல்லை, மருதம், நெய்தல், பாலை ஆகிய ஐந்து திணைகளுக்கும் தலா 100 பாடல்கள் வீதம் 500 பாடல்கள் உள்ளன."}, "en": {"blocks": [{"type": "text", "content": "How many Thinais and total verses are incorporated into Aingurunooru?", "media_id": null}], "options": {"A": "Four Thinais, 400 verses", "B": "Five Thinais, 100 verses", "C": "Five Thinais (100 verses per Thinai), Total 500 verses", "D": "Six Thinais, 600 verses"}, "explanation": "Aingurunooru contains 500 verses distributed equally as 100 poems across each of the 5 Thinais."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 3