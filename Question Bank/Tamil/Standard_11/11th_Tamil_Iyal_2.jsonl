{"id": "11th_tamil_u2_q054", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aethilik_kuruvigal", "chapter_id": null, "topic_id": "salim_ali_sparrow", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியாவின் பறவை மனிதர் (Birdman of India) என்று அழைக்கப்படுபவர் யார்?", "media_id": null}], "options": {"A": "சுவாமிநாதன்", "B": "டாக்டர் சலீம் அலி (Dr. Salim Ali)", "C": "நம்மாழ்வார்", "D": "சுந்தர்லால் பகுகுணா"}, "explanation": "டாக்டர் சலீம் அலி இந்தியாவின் தலைசிறந்த பறவையியல் அறிஞரும் 'இந்தியாவின் பறவை மனிதர்' எனவும் போற்றப்படுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Who is internationally venerated as the 'Birdman of India'?", "media_id": null}], "options": {"A": "Swaminathan", "B": "Dr. Salim Ali", "C": "Nammazhvar", "D": "Sunderlal Bahuguna"}, "explanation": "Dr. Salim Ali was India's foremost ornithologist, celebrated as the 'Birdman of India'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 27", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam