{"id": "11th_tamil_u2_q158", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "grammar_punarchi_vithigal", "chapter_id": null, "topic_id": "kalai_azhagu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கலை + அழகு = கலையழகு’ - இதில் நிலைமொழி ஈறு எந்த எழுத்தாக உள்ளது?", "media_id": null}], "options": {"A": "அகரம்", "B": "ஐகாரம் (ல் + ஐ)", "C": "இகரம்", "D": "உகரம்"}, "explanation": "கலை என்பதில் நிலைமொழி ஈறு 'ஐ'காரம் (ல்+ஐ); எனவே 'இ ஈ ஐ வழி யவ்வும்' விதிப்படி யகர உடம்படுமெய் தோன்றி 'கலையழகு' என்றானது."}, "en": {"blocks": [{"type": "text", "content": "What is the terminal phoneme of the preceding word in 'Kalai + azhagu = Kalaiyazhagu'?", "media_id": null}], "options": {"A": "Short vowel A", "B": "Diphthong Ai (ல் + ஐ)", "C": "Short vowel I", "D": "Short vowel U"}, "explanation": "'Kalai' ends in diphthong 'Ai', triggering the Y-glide insertion rule."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 36", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": n