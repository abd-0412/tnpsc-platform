{"id": "11th_tamil_u2_q045", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aethilik_kuruvigal", "chapter_id": null, "topic_id": "wetland_day", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உலக ஈரநில தினம் (World Wetlands Day) எப்போது கடைப்பிடிக்கப்படுகிறது?", "media_id": null}], "options": {"A": "பிப்ரவரி 2", "B": "மார்ச் 3", "C": "அக்டோபர் 4", "D": "நவம்பர் 14"}, "explanation": "ஒவ்வொரு ஆண்டும் பிப்ரவரி 2-ஆம் நாள் உலக ஈரநில தினமாகக் கடைப்பிடிக்கப்படுகிறது (ராம்சார் மாநாடு நினைவாக)."}, "en": {"blocks": [{"type": "text", "content": "When is World Wetlands Day commemorated internationally?", "media_id": null}], "options": {"A": "February 2", "B": "March 3", "C": "October 4", "D": "November 14"}, "explanation": "World Wetlands Day is celebrated on February 2 marking the Ramsar Convention."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 27", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "m