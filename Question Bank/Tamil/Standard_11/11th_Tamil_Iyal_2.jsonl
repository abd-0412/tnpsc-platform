{"id": "11th_tamil_u2_q124", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "supplementary_yanai_doctor", "chapter_id": null, "topic_id": "dr_k_personality", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "டாக்டர் கே-வின் அன்றாட உடையும் தோற்றமும் எவ்வாறு இருந்ததாக ஆசிரியர் விவரிக்கிறார்?", "media_id": null}], "options": {"A": "பளபளக்கும் பட்டு ஆடை", "B": "கழுத்தில் தங்கச் சங்கிலி மற்றும் கோட் சூட்", "C": "ஆடம்பர உடைகள்", "D": "எளிய காக்கி அரைக்கால் சட்டை, காக்கிச் சட்டை மற்றும் கரடுமுரடான பூட்ஸ் காலணி"}, "explanation": "காட்டுக்குள் அலைந்து திரிய ஏதுவான எளிய காக்கி உடையும், புழுதி படிந்த பூட்ஸ்களுமே டாக்டர் கே-வின் நிரந்தர அடையாளமாக இருந்தது."}, "en": {"blocks": [{"type": "text", "content": "How is Dr. K's everyday forest attire and unpretentious appearance depicted in the story?", "media_id": null}], "options": {"A": "Gleaming silk robes", "B": "Gold chains and formal business suit", "C": "Luxurious designer apparel", "D": "Simple khaki shorts, rugged khaki bush shirt, and sturdy worn-out field boots"}, "explanation": "He lived unpretentiously in rugged khaki field shorts, shirts, and dust-covered work boots."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpo