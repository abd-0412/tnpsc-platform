{"id": "11th_tamil_u2_q106", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aingurunooru", "chapter_id": null, "topic_id": "kurinji_poet_traits", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘குறிஞ்சிக் கலி, குறிஞ்சிப் பாட்டு, ஐங்குறுநூற்றுக் குறிஞ்சி’ என குறிஞ்சித் திணையைப் பாடுவதில் வல்லவர் யார்?", "media_id": null}], "options": {"A": "பரணர்", "B": "கபிலர்", "C": "நக்கீரர்", "D": "ஔவையார்"}, "explanation": "மலையும் மலை சார்ந்த குறிஞ்சித் திணையைப் பாடுவதில் நிகரற்ற மேதையாக விளங்கியவர் கபிலர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who was universally celebrated as the supreme master of Kurinji mountainous poetry across Sangam literature?", "media_id": null}], "options": {"A": "Paranar", "B": "Kabilar", "C": "Nakkeerar", "D": "Avvaiyar"}, "explanation": "Kabilar is celebrated as the undisputed sovereign poet of Kurinji landscape."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 30", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name