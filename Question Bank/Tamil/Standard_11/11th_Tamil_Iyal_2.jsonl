{"id": "11th_tamil_u2_q139", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "supplementary_yanai_doctor", "chapter_id": null, "topic_id": "jeyamohan_aram_philosophy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜெயமோகன் ‘அறம்’ சிறுகதைத் தொகுப்பில் முன்வைக்கும் மைய வாழ்க்கை விழுமியம் யாது?", "media_id": null}], "options": {"A": "பணக்காரனாக மாறுவது", "B": "அரசியல் செல்வாக்கு பெறுவது", "C": "எந்தச் சூழலிலும் பிற உயிர்களுக்காகவும், உண்மைக்காகவும் தன்னலமின்றித் தன் கடமையைச் செய்யும் உன்னதமான மானுட அறம் (Ethical Duty)", "D": "துறவறம் பூண்டு காடுகளுக்குச் செல்வது"}, "explanation": "சமூகத்தில் அமைதியாக வாழும் உண்மை மனிதர்களின் சுயநலமற்ற அறச்செயல்களே மனித குலத்தைக் காப்பாற்றுகின்றன என்பதை 'அறம்' தொகுப்பு எடுத்துரைக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What core philosophical value of human existence does Jeyamohan celebrate through his short story anthology 'Aram'?", "media_id": null}], "options": {"A": "Amassing extreme material wealth", "B": "Gaining political hegemony", "C": "Uncompromising altruistic virtue (Aram) and dedicated service to fellow living beings without seeking self-glory", "D": "Renouncing domesticity for asceticism"}, "explanation": "'Aram' eulogizes quiet everyday saints whose selfless ethical convictions uphold moral humanity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_