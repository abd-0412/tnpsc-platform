{"id": "11th_tamil_u2_q159", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "grammar_punarchi_vithigal", "chapter_id": null, "topic_id": "valavuyir_analysis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வளவுயிர்’ என்னும் புணர்ச்சியில் இடம்பெற்றுள்ள உடம்படுமெய் எது?", "media_id": null}], "options": {"A": "ய்", "B": "ர்", "C": "வ் (வகர உடம்படுமெய்)", "D": "ள்"}, "explanation": "வள + உயிர்: வள (ள்+அ) என அகரம் ஈறாக உள்ளதால் 'ஏனை உயிர் வழி வவ்வும்' விதிப்படி 'வ்' உடம்படுமெய்யாக வந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Which transitional glide is embedded in the sandhi compound 'Valavuyir' (வள + உயிர்)?", "media_id": null}], "options": {"A": "Y (ய்)", "B": "R (ர்)", "C": "V (வகர உடம்படுமெய் - வ்)", "D": "Ll (ள்)"}, "explanation": "'Vala' ends in vowel 'a', taking the V-glide 'v' to form 'Valavuyir'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 36", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null,