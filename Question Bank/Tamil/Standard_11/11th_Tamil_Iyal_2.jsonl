{"id": "11th_tamil_u2_q079", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_thirumalai_murugan_pallu", "chapter_id": null, "topic_id": "grammatical_category_kulaam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘செங்கயல்’ - இச்சொல்லின் இலக்கணக் குறிப்பு யாது?", "media_id": null}], "options": {"A": "வினையெச்சம்", "B": "உவமைத்தொகை", "C": "பண்புத்தொகை", "D": "உம்மைத்தொகை"}, "explanation": "செம்மை + கயல் = செங்கயல் (செந்நிற மீன்). ‘மை’ விகுதி பெற்றுப் பண்பை உணர்த்தி நிற்பதால் இது பண்புத்தொகை ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the grammatical classification of the Tamil compound 'Sengayal'?", "media_id": null}], "options": {"A": "Adverbial participle", "B": "Metaphorical compound", "C": "Panpuththogai (Qualitative compound)", "D": "Copulative compound"}, "explanation": "'Sengayal' (Semmai + Kayal - red fish) is a qualitative adjectival compound (Panpuththogai)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 29, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 29", "url": null, "source_notes": null}, "previous_year": {"is_previou