{"id": "11th_tamil_u2_q123", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "supplementary_yanai_doctor", "chapter_id": null, "topic_id": "pyq_jeyamohan_works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] ‘விஷ்ணுபுரம், கொற்றவை’ ஆகிய புகழ்பெற்ற பெருநாவல்களை எழுதியவர் யார்?", "media_id": null}], "options": {"A": "சுந்தர ராமசாமி", "B": "சி. சு. செல்லப்பா", "C": "ஜெயமோகன்", "D": "பிரபஞ்சன்"}, "explanation": "ஜெயமோகன் விஷ்ணுபுரம், கொற்றவை, வெண்முரசு போன்ற பிரம்மாண்ட நாவல்களை எழுதியவர்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Who authored the acclaimed monumental Tamil novels 'Vishnupuram' and 'Kotravai'?", "media_id": null}], "options": {"A": "Sundara Ramaswamy", "B": "C. S. Chellappa", "C": "Jeyamohan", "D": "Prapanchan"}, "explanation": "Jeyamohan authored 'Vishnupuram' and 'Kotravai'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 31, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 31", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC", "exam_name": "Group 2", "year": 2024, "paper