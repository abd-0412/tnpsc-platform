{"id": "11th_tamil_u2_q027", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "prose_iyarkai_velanmai", "chapter_id": null, "topic_id": "fukuoka_seed_balls", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மசானோபு ஃபுகோகா காடுகளை உருவாக்கவும், வறண்ட நிலங்களில் மரம் வளர்க்கவும் கண்டறிந்த எளிய உத்தி எது?", "media_id": null}], "options": {"A": "ஆழ்துளைக் கிணறுகள்", "B": "ஹெலிகாப்டர் தெளிப்பு", "C": "விதைப் பந்துகள் (Seed balls / Tsuchi dango)", "D": "பிளாஸ்டிக் பூந்தொட்டிகள்"}, "explanation": "மண் மற்றும் சாண உருண்டைகளுக்குள் விதைகளை வைத்து உலர்த்தி வறண்ட நிலங்களில் வீசி எறியும் 'விதைப் பந்து' உத்தியை ஃபுகோகா உலகிற்கு அறிமுகப்படுத்தினார்."}, "en": {"blocks": [{"type": "text", "content": "Which ingenious, low-cost reforestation innovation was popularized globally by Masanobu Fukuoka?", "media_id": null}], "options": {"A": "Deep borewells", "B": "Helicopter spraying", "C": "Seed balls (Earth clay seed pellets / Tsuchi Dango)", "D": "Plastic nursery pots"}, "explanation": "Fukuoka pioneered clay seed balls (Tsuchi Dango) to reforest arid landscapes without plowing."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition"