{"id": "11th_tamil_u2_q077", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_thirumalai_murugan_pallu", "chapter_id": null, "topic_id": "assertion_reason_pallu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): பள்ளு இலக்கியம் தமிழக உழவர் பெருமக்களின் கலைக் களஞ்சியமாகத் திகழ்கிறது.\nகாரணம் (R): அக்கால நாட்டு மாடுகளின் வகைகள், நெல் விதைகள், மீன் வகைகள், உழவுக் கருவிகள் மற்றும் வானிலை சமிக்ஞைகள் அனைத்தையும் துல்லியமாக அது ஆவணப்படுத்தியுள்ளது.", "media_id": null}], "options": {"A": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றை மிகச்சரியாக விளக்குகிறது", "B": "கூற்று சரி, காரணம் தவறு", "C": "கூற்று தவறு, காரணம் சரி", "D": "கூற்று மற்றும் காரணம் இரண்டும் தவறு"}, "explanation": "பள்ளு பாடல்கள் உழவு வாழ்வின் அத்தனை கூறுகளையும் கலைக்களஞ்சியம் போலப் பதிவு செய்துள்ளதால் கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Pallu literature serves as an indispensable folk encyclopedia of ancient Tamil agrarian civilization.\nReason (R): It meticulously chronicles indigenous cattle breeds, heritage paddy varieties, freshwater fishes, tools, and meteorological omens.", "media_id": null}], "options": {"A": "Both Assertion and Reason are true; Reason is the correct explanation", "B": "Assertion is true, Reason is false", "C": "Assertion is false, Reason is true", "D": "Both Assertion and Reason are false"}, "explanation": "Both assertion and reason are true as Pallu acts as an ecological and ethnographic archive."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 28, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 28", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 2", "Poetry", "Assertion-Reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u2_q078", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_thirumalai_murugan_pallu", "chapter_id": null, "topic_id": "valan_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பள்ளு இலக்கியங்களில் உழவுத் தலைவனான பள்ளன் எவ்வாறு விளிக்கப்படுகிறான்?", "media_id": null}], "options": {"A": "வேந்தன்", "B": "குடும்பன் / பண்ணைக்காரன்", "C": "சிங்கன்", "D": "பிச்சி"}, "explanation": "பள்ளு இலக்கியங்களில் உழவுப் பணிகளுக்குத் தலைமை தாங்கும் பள்ளன் ‘குடும்பன்’ என்றும் அழைக்கப்படுகிறான்."}, "en": {"blocks": [{"type": "text", "content": "By which respectful community title is the chief peasant hero Pallan addressed in Pallu literature?", "media_id": null}], "options": {"A": "Vendhan", "B": "Kudumban / Pannaikkaaran", "C": "Singan", "D": "Pichi"}, "explanation": "The chief peasant protagonist is classically termed 'Kudumban'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 28, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 28", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "y