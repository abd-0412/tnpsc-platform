{"id": "11th_tamil_u2_q157", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "grammar_punarchi_vithigal", "chapter_id": null, "topic_id": "kaatru_adiththathu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘காற்று + அடித்தது’ என்பதைச் சரியான விதிகளின்படி புணர்த்துக:", "media_id": null}], "options": {"A": "காற்றடித்தது (உயிர்வரின் உக்குறள் மெய்விட்டு ஓடும், உடல்மேல் உயிர் வந்து ஒன்றுவது இயல்பே)", "B": "காற்று அடித்தது", "C": "காற்றுவடித்தது", "D": "காற்றையடித்தது"}, "explanation": "காற்று (ற்+உ): உயிர்வரின் உக்குறள் மெய்விட்டு ஓடும் விதிப்படி உகரம் நீங்கி (காற்ற்+அடித்தது), உடல்மேல் உயிர்வந்து ஒன்றி 'காற்றடித்தது' என்றானது."}, "en": {"blocks": [{"type": "text", "content": "Combine 'Kaatru + adiththathu' using valid grammatical sandhi rules:", "media_id": null}], "options": {"A": "Kaattradiththathu (காற்றடித்தது via Uyirvarin ukkural meivittu odum)", "B": "Kaatru adiththathu (unfused)", "C": "Kaatruvaddiththathu", "D": "Kaatraiyadiththathu"}, "explanation": "'Kaatru + adiththathu' drops 'u' before vowel 'a' and merges 'rr + a = rra' yielding 'Kaattradiththathu'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edit