{"id": "11th_tamil_u2_q085", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aingurunooru", "chapter_id": null, "topic_id": "anthology_classification", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஐங்குறுநூறு’ சங்க இலக்கியங்களில் எந்தத் தொகுப்பு நூலுள் அடங்கும்?", "media_id": null}], "options": {"A": "எட்டுத்தொகை", "B": "பத்துப்பாட்டு", "C": "பதினெண்கீழ்க்கணக்கு", "D": "ஐஞ்சிறுங்காப்பியம்"}, "explanation": "ஐங்குறுநூறு சங்க இலக்கியத்தின் எட்டுத்தொகை நூல்களுள் ஒன்றாகும் (நற்றிணை, குறுந்தொகை, ஐங்குறுநூறு, பதிற்றுப்பத்து, பரிபாடல், கலித்தொகை, அகநானூறு, புறநானூறு)."}, "en": {"blocks": [{"type": "text", "content": "Under which Sangam classical anthology does 'Aingurunooru' belong?", "media_id": null}], "options": {"A": "Ettuthogai (Eight Anthologies)", "B": "Pathuppaattu", "C": "Pathinenkeezhkanakku", "D": "Ainjirungaappiyam"}, "explanation": "'Aingurunooru' is one of the celebrated Eight Anthologies (Ettuthogai)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 30", "url": null, "source_notes": null}, "prev