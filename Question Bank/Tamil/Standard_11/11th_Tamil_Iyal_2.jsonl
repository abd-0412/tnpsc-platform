{"id": "11th_tamil_u2_q064", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_thirumalai_murugan_pallu", "chapter_id": null, "topic_id": "fish_varieties", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பள்ளுப் பாடலில் நீர்நிலைகளில் துள்ளி விளையாடுவதாகக் கூறப்படும் மீன் வகைகளில் பொருந்தாதது எது?", "media_id": null}], "options": {"A": "வரால், வாளை", "B": "கெண்டை, கெளுத்தி", "C": "ஆரல், விலாங்கு", "D": "திமிங்கலம், சுறா"}, "explanation": "வயல்வெளி நீர்நிலைகளில் துள்ளும் நன்னீர் மீன்களாக வாளை, வரால், கெண்டை, கெளுத்தி, ஆரல், விலாங்கு ஆகியவை கூறப்பட்டுள்ளன; திமிங்கலம் கடல் வாழ் உயிரினம்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following marine fishes does NOT belong to the freshwater field fish varieties listed in the poem?", "media_id": null}], "options": {"A": "Varaal and Vaalai", "B": "Kendai and Keluthi", "C": "Aaral and Vilaangu", "D": "Whale and Shark (Thimingalam & Suraa)"}, "explanation": "Freshwater canal fishes in the poem include Vaalai, Varaal, Kendai, Keluthi, Aaral, and Vilaangu; Whales/Sharks are marine."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page"