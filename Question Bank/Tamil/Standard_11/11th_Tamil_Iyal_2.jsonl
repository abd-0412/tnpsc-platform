{"id": "11th_tamil_u2_q024", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "prose_iyarkai_velanmai", "chapter_id": null, "topic_id": "bee_role", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வேளாண்மையில் மகரந்தச் சேர்க்கைக்கும் (Pollination) அதிக விளைச்சலுக்கும் இன்றியமையாத இயற்கை நண்பன் எது?", "media_id": null}], "options": {"A": "கொசு", "B": "ஈ", "C": "கரப்பான்", "D": "தேனீ"}, "explanation": "பூச்சிகொல்லிகள் அடிக்கப்படாத இயற்கை பண்ணைகளில் தேனீக்கள் தடையின்றி மகரந்தச் சேர்க்கை செய்து விளைச்சலை 30% வரை அதிகரிக்கின்றன."}, "en": {"blocks": [{"type": "text", "content": "Which pollinating insect is indispensable for cross-pollination and bountiful crop harvest in natural ecosystems?", "media_id": null}], "options": {"A": "Mosquito", "B": "Housefly", "C": "Cockroach", "D": "Honeybee (Thaenee)"}, "explanation": "Honeybees perform essential pollination, increasing crop yields by up to 30% in pesticide-free fields."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 25, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 25", "url": null, "source_notes": null}, "previous