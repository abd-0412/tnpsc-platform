{"id": "11th_tamil_u2_q003", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "prose_iyarkai_velanmai", "chapter_id": null, "topic_id": "fukuoka_principles", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஃபுகோகா முன்வைத்த இயற்கை வேளாண்மையின் நான்கு முக்கிய அடிப்படைகளில் பொருந்தாத ஒன்று எது?", "media_id": null}], "options": {"A": "உழவு செய்யாதிருத்தல் (No plowing)", "B": "இரசாயன உரம் இடாதிருத்தல் (No chemical fertilizers)", "C": "அதிகளவில் செயற்கைப் பூச்சிக்கொல்லிகளைப் பயன்படுத்துதல்", "D": "களை எடுக்காதிருத்தல் (No weeding) மற்றும் பூச்சிக்கொல்லி தவிர்த்தல்"}, "explanation": "ஃபுகோகாவின் 4 கோட்பாடுகள்: உழாமை, உரம் இடாமை, களை எடுக்காமை, பூச்சிக்கொல்லி இடாமை. செயற்கைப் பூச்சிக்கொல்லி பயன்பாட்டை அவர் முற்றிலும் எதிர்த்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following does NOT conform to the four foundational tenets of natural farming formulated by Masanobu Fukuoka?", "media_id": null}], "options": {"A": "No cultivation (No plowing)", "B": "No chemical fertilizers", "C": "Excessive application of synthetic chemical insecticides", "D": "No weeding and no pesticides"}, "explanation": "Fukuoka advocated: No cultivation, No chemical fertilizer, No weeding, and No chemical pesticides."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name"