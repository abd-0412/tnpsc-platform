{"id": "11th_tamil_u2_q084", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_thirumalai_murugan_pallu", "chapter_id": null, "topic_id": "summary_pallu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘திருமலை முருகன் பள்ளு’ பாடலின் ஒட்டுமொத்தக் கலை நேர்த்தி எதனை வெளிப்படுத்துகிறது?", "media_id": null}], "options": {"A": "அரசியல் சூழ்ச்சிகளை", "B": "போர்க்களத்துக் குருதி வெள்ளத்தை", "C": "வெளிநாட்டுப் பயணக் குறிப்புகளை", "D": "மழையின் வரவு, மண்ணின் வாசம், உழவு மாடுகளின் பெருமிதம் மற்றும் உழவர் பெருமக்களின் மங்கல வேளாண் வாழ்வு"}, "explanation": "இயற்கையின் மழையழகும், மாடுகளின் கம்பீரமும், நாட்டு நெல் விதைகளும், உழவுத் தொழிலின் ஆன்மாவும் இப்பாடலில் உன்னதமாய் மிளிர்கின்றன."}, "en": {"blocks": [{"type": "text", "content": "What overarching aesthetic tapestry is unveiled by 'Thirumalai Murugan Pallu'?", "media_id": null}], "options": {"A": "Dynastic court intrigue", "B": "Bloody battlefield slaughter", "C": "Overseas travel logs", "D": "The advent of monsoon rains, fragrance of tilled earth, pride of plowing cattle, and the sacred agrarian ethos of Tamil peasants"}, "explanation": "It paints an immortal portrait of monsoon bounty, plowing cattle, and sacred peasant labor."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publ