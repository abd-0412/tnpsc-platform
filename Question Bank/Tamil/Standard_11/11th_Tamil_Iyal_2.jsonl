{"id": "11th_tamil_u2_q166", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "grammar_punarchi_vithigal", "chapter_id": null, "topic_id": "pon_aadai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பொன் + ஆடை = பொன்னாடை’ - இதில் செயல்பட்டுள்ள புணர்ச்சி விதி யாது?", "media_id": null}], "options": {"A": "இ ஈ ஐ வழி யவ்வும்", "B": "தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும், உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே", "C": "உயிர்வரின் உக்குறள் மெய்விட்டு ஓடும்", "D": "ஏனை உயிர் வழி வவ்வும்"}, "explanation": "பொன் என்பதில் 'பொ' தனிக்குறில்; அதன் முன் நின்ற 'ன்' ஒற்று, வருமொழி உயிர் (ஆ) வர இரட்டித்துப் 'பொன்னாடை' என்றானது."}, "en": {"blocks": [{"type": "text", "content": "Which sandhi rule operates in 'Pon + aadai = Ponnaadai'?", "media_id": null}], "options": {"A": "I Ee Ai vazhi yavvum", "B": "Tanikkuril mun otru uyirvarin irattum, followed by Udalmel uyirvanthu ondruvathu iyalbe", "C": "Uyirvarin ukkural meivittu odum", "D": "Eanai uyir vazhi vavvum"}, "explanation": "'Po' is an isolated short vowel, causing terminal 'n' (ன்) to double before vowel 'Aa'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-202