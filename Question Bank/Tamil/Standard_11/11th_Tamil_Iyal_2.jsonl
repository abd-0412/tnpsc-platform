{"id": "11th_tamil_u2_q018", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "prose_iyarkai_velanmai", "chapter_id": null, "topic_id": "maappillai_samba_trait", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மாப்பிள்ளைச் சம்பா’ நெல் யாருக்கு அதிக உடல் பலத்தையும் நரம்பு வலிமையையும் தரும் பாரம்பரிய உணவாகக் கருதப்படுகிறது?", "media_id": null}], "options": {"A": "வயதானவர்களுக்கு மட்டுமே", "B": "இளவட்டக் கல்லைத் தூக்கும் மணமகனுக்கும், உடல் உழைப்பாளிகளுக்கும் அளப்பரிய ஆற்றல் தரும்", "C": "குழந்தைகளுக்கு மட்டுமே", "D": "பயன்பாடற்றது"}, "explanation": "பண்டைய காலத்தில் இளவட்டக் கல்லைத் தூக்கி வீரத்தை நிரூபிக்கும் மணமகனுக்கு அளப்பரிய பலத்தைத் தந்ததால் இந்நெல் 'மாப்பிள்ளைச் சம்பா' எனப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Why was the heritage red rice variety 'Mappillai Samba' historically fed to young men?", "media_id": null}], "options": {"A": "Exclusively for geriatric elderly care", "B": "Bestowed immense muscular and nervous stamina to prospective grooms lifting heavy Ilavattakkal boulder stones", "C": "Solely for infant nutrition", "D": "Lacked nutritional value"}, "explanation": "'Mappillai Samba' bestows tremendous physical stamina and nervous vigor to youth."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kal