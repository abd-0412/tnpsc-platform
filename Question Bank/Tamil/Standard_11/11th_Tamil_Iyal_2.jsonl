{"id": "11th_tamil_u2_q016", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "prose_iyarkai_velanmai", "chapter_id": null, "topic_id": "assertion_reason_organic", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): இயற்கை வேளாண்மை என்பது வெறும் உழவு முறை மட்டுமல்ல; அது ஒரு முழுமையான வாழ்க்கை நெறி.\nகாரணம் (R): அது மனிதனை இயற்கையோடு முரண்படாமல், நிலத்தையும் நீரையும் நஞ்சாக்காமல் வாழ வழிகாட்டுகிறது.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று மற்றும் காரணம் இரண்டும் தவறு", "D": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றை மிகச்சரியாக விளக்குகிறது"}, "explanation": "இயற்கை வேளாண்மை என்பது மண்ணையும் உயிர்களையும் பாதுகாக்கும் வாழ்க்கை அறம் என்பதால் கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Natural farming is not merely an agronomic technique; it is a holistic philosophy of life.\nReason (R): It guides humankind to live harmoniously with nature without polluting soil and water ecosystems.", "media_id": null}], "options": {"A": "Assertion is true, Reason is false", "B": "Assertion is false, Reason is true", "C": "Both Assertion and Reason are false", "D": "Both Assertion and Reason are true; Reason is the correct explanation"}, "explanation": "Both assertion and reason are true as organic farming embodies an ecological worldview."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": 