{"id": "11th_tamil_u2_q019", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "prose_iyarkai_velanmai", "chapter_id": null, "topic_id": "soil_salinity_cause", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நிலத்தடி நீரை அளவுக்கு அதிகமாக இறைத்து, இரசாயன உரங்களைத் தொடர்ந்து இடுவதால் நிலத்திற்கு ஏற்படும் பாதிப்பு என்ன?", "media_id": null}], "options": {"A": "நிலம் வளம் கொழிக்கும் நிலமாக மாறும்", "B": "நிலத்தடி நீர் இனிக்கும்", "C": "மண் உவர் நிலமாக (சவுடு நிலமாக) மாறி பயிர் செய்யத் தகுதியற்றுப் போகும்", "D": "மண்ணில் தங்கம் விளையும்"}, "explanation": "தொடர் இரசாயன உரங்கள் மற்றும் ஆழ்மட்ட உவர்நீர்ப் பாசனத்தால் மண் உவர்த்தன்மை பெற்று (Salinity) மலட்டுப் பாழ்நிலமாக மாறுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What destructive pedological condition occurs when deep aquifers are over-exploited and chemical fertilizers are relentlessly applied?", "media_id": null}], "options": {"A": "Soil becomes eternally fertile", "B": "Groundwater turns sweet like honey", "C": "Soil degrades into alkaline/saline wasteland (Uvar Nilam) unfit for agriculture", "D": "Soil sprouts gold veins"}, "explanation": "Relentless synthetic chemical inputs and deep borewell irrigation induce severe soil salinization."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu