{"id": "11th_tamil_u2_q065", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_thirumalai_murugan_pallu", "chapter_id": null, "topic_id": "cloud_omens", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பள்ளுப் பாடலில் மழை வருவதற்கான இயற்கை அறிகுறிகளாக எவை கூறப்படுகின்றன?", "media_id": null}], "options": {"A": "கொண்மூ (மேகங்கள்) வானில் மின்னி முழங்குவதும், தவளைகள் கத்துவதும், மயில்கள் அகவி ஆடுவதும்", "B": "சூரியன் சுட்டெரிப்பது", "C": "புழுதிப் புயல் வீசுவது", "D": "இலைகள் உதிர்வது"}, "explanation": "மழைக்கால தொடக்கத்தில் வானில் மின்னல் மின்னுவதும், கார்மேகம் சூழ்வதும், தவளைகள் கரைகின்ற ஒலியும் மழையின் நற்குறியாகப் பாடப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What meteorological natural omens of impending rain are poetically celebrated in the Pallu verse?", "media_id": null}], "options": {"A": "Lightning flashing across storm clouds (Konmoo), croaking frogs, and dancing peacocks", "B": "Blistering solar heatwaves", "C": "Blinding dust storms", "D": "Autumnal shedding of leaves"}, "explanation": "The arrival of monsoon clouds, thunder, croaking frogs, and jubilant peacocks signal rainfall."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpor