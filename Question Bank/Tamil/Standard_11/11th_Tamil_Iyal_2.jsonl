{"id": "11th_tamil_u2_q062", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_thirumalai_murugan_pallu", "chapter_id": null, "topic_id": "bullock_names", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடலில் உழவுக்குப் பயன்படும் மாடுகளின் பெயர்களுள் பொருந்தாத ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "காரிக் காளை, வெள்ளைக்காளை", "B": "காரி காளை (சி. சு. செல்லப்பாவின் ஜல்லிக்கட்டு மாடு மட்டுமே)", "C": "செம்மறையான், கருமறையான், மயிலைக்காளை", "D": "மழைக் காளை, பூம்பொறி"}, "explanation": "செம்மறையான், கருமறையான், மயிலை, பூம்பொறி, வெள்ளைக்காளை ஆகியவை உழவு மாடுகளின் பெயர்களாகப் பாடலில் வருகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Which of the following does NOT represent the names of indigenous plowing bullocks enumerated in the poem?", "media_id": null}], "options": {"A": "Kaarikkaalai and Vellaikkaalai", "B": "Kaari Kaalai (Solely C. S. Chellappa's Jallikattu bull)", "C": "Semmaraiyaan, Karumaraiyaan, Mayilaikkaalai", "D": "Mazhaikkaalai, Poompori"}, "explanation": "Semmaraiyaan, Karumaraiyaan, Mayilai, and Poompori represent the native plowing bullocks celebrated in Pallu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation"