{"id": "11th_tamil_u2_q052", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aethilik_kuruvigal", "chapter_id": null, "topic_id": "forest_conservation_day", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உலக காடுகள் தினம் (World Forestry Day) எந்த நாளில் கொண்டாடப்படுகிறது?", "media_id": null}], "options": {"A": "மார்ச் 20", "B": "ஏப்ரல் 22", "C": "மே 22", "D": "மார்ச் 21"}, "explanation": "ஒவ்வொரு ஆண்டும் மார்ச் 21-ஆம் நாள் உலக காடுகள் தினமாகக் கடைப்பிடிக்கப்படுகிறது. (மார்ச் 20 சிட்டுக்குருவி தினம்; மார்ச் 21 காடுகள் தினம்; மார்ச் 22 தண்ணீர் தினம்)."}, "en": {"blocks": [{"type": "text", "content": "On which date is World Forestry Day officially celebrated across the globe?", "media_id": null}], "options": {"A": "March 20", "B": "April 22", "C": "May 22", "D": "March 21"}, "explanation": "March 20 is Sparrow Day, March 21 is Forestry Day, and March 22 is Water Day."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 27", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exa