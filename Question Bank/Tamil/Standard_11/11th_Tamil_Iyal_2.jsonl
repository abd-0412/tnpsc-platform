{"id": "11th_tamil_u2_q092", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aingurunooru", "chapter_id": null, "topic_id": "god_invocation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஐங்குறுநூறு நூலின் கடவுள் வாழ்த்துப் பாடலைப் பாடியவர் யார்?", "media_id": null}], "options": {"A": "கபிலர்", "B": "நக்கீரர்", "C": "ஔவையார்", "D": "பாரதம் பாடிய பெருந்தேவனார்"}, "explanation": "ஐங்குறுநூற்றின் தொடக்கத்தில் சிவபெருமானைப் போற்றும் கடவுள் வாழ்த்துப் பாடலைப் பாடியவர் பாரதம் பாடிய பெருந்தேவனார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who composed the invocatory God prayer song (Kadavul Vaazhthu) of Aingurunooru?", "media_id": null}], "options": {"A": "Kabilar", "B": "Nakkeerar", "C": "Avvaiyar", "D": "Bharatham Paadiya Perundhevanaar"}, "explanation": "Bharatham Paadiya Perundhevanaar composed the invocatory prayer to Lord Shiva."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 30", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name":