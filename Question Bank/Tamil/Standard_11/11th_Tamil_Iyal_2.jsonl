{"id": "11th_tamil_u2_q046", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aethilik_kuruvigal", "chapter_id": null, "topic_id": "biodiversity_day", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சர்வதேச உயிர்ப்பன்மை தினம் (International Day for Biological Diversity) எப்போது அனுசரிக்கப்படுகிறது?", "media_id": null}], "options": {"A": "மார்ச் 21", "B": "மே 22", "C": "ஜூலை 29", "D": "செப்டம்பர் 28"}, "explanation": "ஒவ்வொரு ஆண்டும் மே 22-ஆம் நாள் உலக உயிர்ப்பன்மை தினமாகக் கடைப்பிடிக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "When is the International Day for Biological Diversity observed worldwide?", "media_id": null}], "options": {"A": "March 21", "B": "May 22", "C": "July 29", "D": "September 28"}, "explanation": "International Day for Biological Diversity is observed on May 22."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 27", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session"