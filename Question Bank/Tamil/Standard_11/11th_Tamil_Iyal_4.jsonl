{"id": "11th_tamil_u4_q146", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "grammar_padaippaakka_uthigal", "chapter_id": null, "topic_id": "thonmam_definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழங்காலப் புராண, இதிகாசக் கதைகள், மாந்தர்கள் மற்றும் வரலாற்றுக் குறிப்புகளைத் தற்காலப் புதிய வாழ்வியல் சூழலோடு இணைத்துப் பாடும் உத்தி எது?", "media_id": null}], "options": {"A": "படிமம்", "B": "தொன்மம் (Myth / Mythological archetype)", "C": "குறியீடு", "D": "உவமை"}, "explanation": "பழங்கதை அல்லது தொன்மக் கதாபாத்திரங்களை (கர்ணன், அரிச்சந்திரன், அகலிகை) நவீனப் படைப்புகளில் குறியீடாகப் பயன்படுத்துவது 'தொன்மம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which creative device employs ancient mythical archetypes, puranic tales, or legendary heroes to illuminate modern human conditions?", "media_id": null}], "options": {"A": "Imagery", "B": "Thonmam (Myth / Archetypal Allusion)", "C": "Symbol", "D": "Simile"}, "explanation": "Thonmam refers to utilizing mythic archetypes to contextualize contemporary themes."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 89, "chapter":