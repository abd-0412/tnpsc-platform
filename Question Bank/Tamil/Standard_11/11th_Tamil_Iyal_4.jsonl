{"id": "11th_tamil_u4_q056", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "summary_thamizhaga_kalvi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தமிழகக் கல்வி வரலாறு’ பாடம் உணர்த்தும் முதன்மையான செய்தி யாது?", "media_id": null}], "options": {"A": "ஆங்கிலம் மட்டுமே உயர்ந்தது", "B": "பழைய முறையே சிறந்தது", "C": "கல்வி அரசாங்கத்திற்கு மட்டும் உரியது", "D": "சங்க காலத்தின் சமத்துவ விழுமியங்களையும், மரபுவழிக் கல்வியின் நன்மைகளையும் உள்வாங்கி, அனைவருக்கும் சமமான, படைப்பாற்றல் மிக்க நவீன ஜனநாயகக் கல்வியை உருவாக்குதல்"}, "explanation": "கல்வி என்பது தனிமனிதனை உயர்த்துவதுடன் சமூக நீதியையும் படைப்பாற்றலையும் வளர்க்கும் ஜனநாயகக் கருவியாகத் திகழ வேண்டும் என்பதே இப்பாடத்தின் மையக்கருத்து."}, "en": {"blocks": [{"type": "text", "content": "What core overarching vision does the lesson 'History of Education in Tamil Nadu' impart to modern students?", "media_id": null}], "options": {"A": "English alone guarantees intellect", "B": "Rote ancient systems are without flaw", "C": "Education is the monopoly of bureaucratic rulers", "D": "Integrating classical egalitarian values and indigenous strengths to forge an equitable, creative, and democratic modern education for all"}, "explanation": "It advocates democratic, creative, and universally accessible modern education rooted in heritage."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"