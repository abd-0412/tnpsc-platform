{"id": "11th_tamil_u4_q124", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "supplementary_ithazhaalar_bharathi", "chapter_id": null, "topic_id": "editorial_style_tamil", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியார் தமிழ் இதழியலுக்கு வழங்கிய மாபெரும் உரைநடைச் சீர்திருத்தம் யாது?", "media_id": null}], "options": {"A": "கடினமான வடமொழிச் சொற்களைப் புகுத்தியது", "B": "செய்யுள் நடையிலேயே செய்திகளை எழுதியது", "C": "ஆங்கிலச் சொற்களை அப்படியே பயன்படுத்தியது", "D": "எளிய நடையில் பாமர மக்களும் எளிதில் புரிந்து கொள்ளும் ‘மக்கள் உரைநடையை’ (எளிய தமிழ் நடை) இதழ்களில் உருவாக்கியமை"}, "explanation": "பண்டிதர்களுக்கே உரியதாக இருந்த தமிழ் உரைநடையைப் பாமர மக்களும் படித்துணரும் எளிய, உயிரோட்டமுள்ள மக்கள் நடையாக மாற்றியவர் பாரதி."}, "en": {"blocks": [{"type": "text", "content": "What revolutionary stylistic reform did Bharati introduce to modern Tamil journalistic prose?", "media_id": null}], "options": {"A": "Injecting abstruse Sanskritized archaic terms", "B": "Composing news dispatches in rigid metric verse", "C": "Direct transliteration of English jargon", "D": "Democratizing journalistic prose into lucid, vibrant, everyday Tamil intelligible to ordinary citizens"}, "explanation": "Bharati democratized Tamil journalistic prose, creating accessible modern newspaper diction."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_mul