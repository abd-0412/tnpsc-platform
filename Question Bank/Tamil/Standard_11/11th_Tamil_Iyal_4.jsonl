{"id": "11th_tamil_u4_q168", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "grammar_padaippaakka_uthigal", "chapter_id": null, "topic_id": "purpose_of_poetic_devices", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "படிமம், குறியீடு, தொன்மம் போன்ற படைப்பாக்க உத்திகள் ஒரு கவிதைக்கு எத்தகைய அழகையும் ஆழத்தையும் சேர்க்கின்றன?", "media_id": null}], "options": {"A": "கவிதையை விளங்காமல் செய்கின்றன", "B": "பக்கங்களை நிரப்ப உதவுகின்றன", "C": "கவிதையின் பொருளைக் குறைக்கின்றன", "D": "சொற்களின் எல்லையைக் கடந்து உணர்வுகளை வாசகனின் மனத்தில் ஆழமாகப் பதிய வைத்து, கவிதைக்கு அழியாத கலைப் பரிமாணத்தை அளிக்கின்றன"}, "explanation": "இப்படைப்பாக்க உத்திகள் சாதாரண உரைநடையைக் கடந்து, கவிதைக்கு ஆழமான தத்துவப் பரிமாணத்தையும் உணர்ச்சிப் பெருக்கையும் ஊட்டுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What overarching aesthetic power do poetic devices like imagery, symbolism, and myth impart to literature?", "media_id": null}], "options": {"A": "Render verses deliberately incomprehensible", "B": "Pad out empty pages", "C": "Diminish lyrical meaning", "D": "Transcend literal semantic limits, indelibly imprinting profound emotional resonances and multi-layered artistic dimensions in reader's consciousness"}, "explanation": "They elevate literal discourse into timeless multi-layered aesthetic art."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.