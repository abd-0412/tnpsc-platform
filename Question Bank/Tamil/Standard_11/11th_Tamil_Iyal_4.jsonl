{"id": "11th_tamil_u4_q097", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_tholkappiya_paayiram", "chapter_id": null, "topic_id": "porulathikaaram_uniqueness", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உலக மொழிகளில் எந்த மொழியிலும் இல்லாத வகையில் தமிழ் மொழிக்கே உரிய தனிச்சிறப்பாகத் தொல்காப்பியத்தில் அமைந்துள்ள அதிகாரம் எது?", "media_id": null}], "options": {"A": "பொருளதிகாரம் (அகத்திணை, புறத்திணை, வாழ்வியல் இலக்கணம்)", "B": "எழுத்ததிகாரம்", "C": "சொல்லதிகாரம்", "D": "யாப்பிலக்கணம் மட்டுமே"}, "explanation": "சொற்களுக்கு மட்டுமன்றி மக்களின் அகம், புறம் சார்ந்த வாழ்க்கைக்கே இலக்கணம் வகுத்த 'பொருளதிகாரம்' உலக மொழிகளிலேயே தமிழுக்கு மட்டுமே உரிய தனிச்சிறப்பாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which major division of Tholkappiyam stands unique in world linguistics, framing grammar for human life and emotions alongside language?", "media_id": null}], "options": {"A": "Porulathikaaram (Poetics, Akam-Puram sociology, and aesthetics)", "B": "Ezhuthathikaaram", "C": "Sollathikaaram", "D": "Prosody solely"}, "explanation": "Porulathikaaram is an unmatched global grammatical innovation codifying human emotional and social life."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Te