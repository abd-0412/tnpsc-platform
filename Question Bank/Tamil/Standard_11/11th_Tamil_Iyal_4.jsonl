{"id": "11th_tamil_u4_q033", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "madras_university_1857", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சென்னை பல்கலைக்கழகம் (University of Madras) எந்த ஆண்டு தொடங்கப்பட்டது?", "media_id": null}], "options": {"A": "1857-ஆம் ஆண்டு (செப்டம்பர் 1857)", "B": "1835-ஆம் ஆண்டு", "C": "1905-ஆம் ஆண்டு", "D": "1947-ஆம் ஆண்டு"}, "explanation": "1857-ஆம் ஆண்டு உட் அறிக்கையின் வழிகாட்டுதலில் கல்கத்தா, பம்பாய் மற்றும் சென்னை ஆகிய மூன்று மாகாணத் தலைநகரங்களிலும் பல்கலைக்கழகங்கள் நிறுவப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "In which historic year was the University of Madras formally established?", "media_id": null}], "options": {"A": "1857 (September 1857)", "B": "1835", "C": "1905", "D": "1947"}, "explanation": "The University of Madras was established in 1857 alongside Calcutta and Bombay universities."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 81, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 81", "url": null, "source_notes": null}, "pre