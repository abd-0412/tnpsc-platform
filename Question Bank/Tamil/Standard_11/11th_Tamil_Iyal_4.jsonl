{"id": "11th_tamil_u4_q009", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "jain_buddhist_education", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழகத்தில் சாதி, மத பேதமின்றி அனைத்துத் தரப்பு மக்களுக்கும் தொடக்கக் கல்வியை ஜனநாயகப்படுத்திய துறவிகள் யார்?", "media_id": null}], "options": {"A": "சமண மற்றும் பௌத்தத் துறவிகள் (சமணப் பள்ளிகள்)", "B": "அயல்நாட்டு வணிகர்கள்", "C": "நிலப்பிரபுக்கள்", "D": "கிரேக்க அறிஞர்கள்"}, "explanation": "சமணர்களும் பௌத்தர்களும் தம் மடங்களைச் 'சமணப் பள்ளிகள்' என அமைத்து ஆண், பெண் அனைவருக்கும் கல்வி கற்பித்தனர்; 'பள்ளி' என்ற சொல்லே சமண மரபிலிருந்து வந்தது."}, "en": {"blocks": [{"type": "text", "content": "Which monastic tradition pioneered universal democratic elementary education across all social classes in Tamil Nadu?", "media_id": null}], "options": {"A": "Jain and Buddhist monks (Jaina Palligal)", "B": "Foreign merchant syndicates", "C": "Feudal landlords", "D": "Hellenic scholars"}, "explanation": "Jain and Buddhist monasteries (Palligal) democratized education, welcoming all segments of society."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation"