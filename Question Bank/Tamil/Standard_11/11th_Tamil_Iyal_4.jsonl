{"id": "11th_tamil_u4_q041", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "sarva_shiksha_abhiyan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அனைத்துக் குழந்தைகளுக்கும் 14 வயது வரை கட்டாய இலவசக் கல்வி வழங்கும் ‘கல்வி உரிமைச் சட்டம்’ (RTE Act) இந்திய நாடாளுமன்றத்தில் எந்த ஆண்டு இயற்றப்பட்டது?", "media_id": null}], "options": {"A": "2009-ஆம் ஆண்டு (செயலுக்கு வந்தது ஏப்ரல் 1, 2010)", "B": "1986-ஆம் ஆண்டு", "C": "1950-ஆம் ஆண்டு", "D": "2020-ஆம் ஆண்டு"}, "explanation": "இலவச கட்டாயக் கல்வி உரிமைச் சட்டம் (RTE Act) 2009-இல் இயற்றப்பட்டு, 2010 ஏப்ரல் 1 முதல் இந்தியா முழுவதும் நடைமுறைக்கு வந்தது."}, "en": {"blocks": [{"type": "text", "content": "In which year was the landmark Right of Children to Free and Compulsory Education (RTE Act) enacted by the Indian Parliament?", "media_id": null}], "options": {"A": "2009 (Enforced from April 1, 2010)", "B": "1986", "C": "1950", "D": "2020"}, "explanation": "The Right to Education Act was enacted in 2009 guaranteeing education for ages 6-14."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2