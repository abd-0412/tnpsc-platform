{"id": "11th_tamil_u4_q072", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "natrinai_epithet", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எட்டுத்தொகை நூல்களுள் ‘நல்’ என்னும் அடைமொழி பெற்றுச் சிறப்பிக்கப்படும் நூல் எது?", "media_id": null}], "options": {"A": "குறுந்தொகை", "B": "ஐங்குறுநூறு", "C": "கலித்தொகை", "D": "நற்றிணை (நல் + திணை = நற்றிணை)"}, "explanation": "‘நற்றினை நல்ல குறுந்தொகை ஐங்குறுநூறு...’ - நல் என்னும் அடைமொழியோடு தொடங்கும் முதல் நூல் நற்றிணை ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which Sangam anthology is celebrated with the auspicious honorific prefix 'Nal' (நல்)?", "media_id": null}], "options": {"A": "Kurunthogai", "B": "Aingurunooru", "C": "Kalithogai", "D": "Natrinai (Nal + Thinai = Natrinai)"}, "explanation": "Natrinai is canonized with the honorific epithet 'Nal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 84, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 84", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "ex