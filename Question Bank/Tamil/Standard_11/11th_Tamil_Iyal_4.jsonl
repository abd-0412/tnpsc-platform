{"id": "11th_tamil_u4_q038", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "kamarajar_education_revolution", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்நாடு முழுவதும் பட்டிதொட்டியெங்கும் தொடக்கப் பள்ளிகளைத் திறந்து, இலவச மதிய உணவுத் திட்டத்தை மாநிலம் தழுவிய அளவில் செயல்படுத்திய கல்விக்கண் திறந்த பெருந்தலைவர் யார்?", "media_id": null}], "options": {"A": "ராஜாஜி", "B": "பெருந்தலைவர் காமராசர்", "C": "அண்ணா", "D": "பக்தவத்சலம்"}, "explanation": "கிராமங்கள்தோறும் தொடக்கப் பள்ளிகளைத் திறந்து இலவச மதிய உணவு வழங்கி ஏழைக் குழந்தைகள் பள்ளிக்கு வர வழிசெய்தவர் காமராசர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Which visionary Chief Minister opened thousands of rural schools and expanded the free Midday Meal Scheme statewide?", "media_id": null}], "options": {"A": "Rajaji", "B": "Perunthalaivar K. Kamaraj", "C": "C. N. Annadurai", "D": "M. Bhaktavatsalam"}, "explanation": "K. Kamaraj revolutionized education in Tamil Nadu through universal school access and midday meals."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-202