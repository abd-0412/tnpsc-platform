{"id": "11th_tamil_u4_q147", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "grammar_padaippaakka_uthigal", "chapter_id": null, "topic_id": "thonmam_karnan_example", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் இலக்கியத்தில் எல்லையற்ற கொடைப் பண்பிற்குத் தொன்மக் குறியீடாக ஆளப்படும் இதிகாசக் கதாபாத்திரம் யார்?", "media_id": null}], "options": {"A": "அர்ச்சுனன்", "B": "துரியோதனன்", "C": "கர்ணன் (வள்ளல் கர்ணன்)", "D": "பீமன்"}, "explanation": "தன்னிடம் உள்ள கவச குண்டலங்கள் வரை எதையும் இல்லை என்று சொல்லாது ஈயும் மாபெரும் கொடைக்குக் 'கர்ணன்' தொன்மமாகப் பயன்படுத்தப்படுகிறான்."}, "en": {"blocks": [{"type": "text", "content": "Which epic character serves as the quintessential mythic archetype for peerless generosity in Tamil literature?", "media_id": null}], "options": {"A": "Arjuna", "B": "Duryodhana", "C": "Karna (Vallal Karnan)", "D": "Bhima"}, "explanation": "Karna is the universal mythic archetype of boundless generosity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 89, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 89", "url": null, "source_notes":