{"id": "11th_tamil_u4_q065", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "meaning_pirasam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பிரசம் கலந்த வெண்சுவை தீம்பால்...’ - இதில் ‘பிரசம்’ என்னும் சொல்லின் பொருள் யாது?", "media_id": null}], "options": {"A": "தேன் (Honey)", "B": "சர்க்கரை", "C": "நெய்", "D": "பழச்சாறு"}, "explanation": "பிரசம் என்றால் 'தேன்' என்று பொருள். பொற்கிண்ணத்தில் தேன் கலந்த இனிய பாலைச் செவிலியர் ஊட்ட ஓடிய தலைவி என்று பாடல் தொடங்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "In the opening line 'Pirasam kalantha vensuvai theembaal...', what does the classical word 'Pirasam' mean?", "media_id": null}], "options": {"A": "Wild pure Honey (தேன்)", "B": "Cane sugar", "C": "Clarified butter (Ghee)", "D": "Fruit nectar"}, "explanation": "'Pirasam' means honey mixed with sweet white milk in a golden chalice."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 84, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 84", "url": null, "source_notes": null}, "previous_year": {"i