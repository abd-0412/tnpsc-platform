{"id": "11th_tamil_u4_q101", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_tholkappiya_paayiram", "chapter_id": null, "topic_id": "paayiram_illathu_paanuval", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பாயிரம் இல்லது பனுவல் அன்றே’ - என்று பாயிரத்தின் இன்றியமையாமையை வலியுறுத்தும் இலக்கண நூல் எது?", "media_id": null}], "options": {"A": "நன்னூல் (பவணந்தி முனிவர்)", "B": "தொல்காப்பியம்", "C": "நேமிநாதம்", "D": "யாப்பருங்கலக்காரிகை"}, "explanation": "பாயிரம் இல்லாத நூல் ஒரு முழுமையான நூலாகக் கருதப்பட மாட்டாது என்பதை 'பாயிரம் இல்லது பனுவல் அன்றே' என நன்னூல் கூறுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which medieval grammatical work proclaims that a book without a preface cannot be considered a genuine work ('Paayiram illathu panuval anre')?", "media_id": null}], "options": {"A": "Nannool (by Pavanandhi Munivar)", "B": "Tholkappiyam", "C": "Neminatham", "D": "Yapparungalakkarigai"}, "explanation": "Nannool states: 'Paayiram illathu panuval anre'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 85, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4,