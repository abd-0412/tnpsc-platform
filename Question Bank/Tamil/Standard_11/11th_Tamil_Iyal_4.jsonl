{"id": "11th_tamil_u4_q054", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "women_education_woods_despatch", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உட் அறிக்கையில் (1854) பெண்கல்வி மற்றும் ஆசிரியர் பயிற்சிக் கல்வி குறித்துக் கூறப்பட்டுள்ள முக்கிய அம்சம் யாது?", "media_id": null}], "options": {"A": "பெண்கல்வியைத் தடை செய்தது", "B": "பெண்கல்விக்குத் தனி மானியமும் ஊக்கமும் அளிப்பதுடன், ஆசிரியர்களுக்கு முறையான பயிற்சிப் பள்ளிகள் நிறுவப் பரிந்துரைத்தது", "C": "ஆசிரியர் பயிற்சி தேவையற்றது என்றது", "D": "பள்ளிகளை மூடச் சொன்னது"}, "explanation": "உட் அறிக்கை பெண்கல்வியை தீவிரமாக ஆதரித்ததுடன், ஆசிரியர்களுக்கு முறையான பயிற்சிப் பள்ளிகள் (Normal Schools) அமைக்கப் பரிந்துரைத்தது."}, "en": {"blocks": [{"type": "text", "content": "What progressive recommendation regarding women's education and teacher training was advanced in Wood's Despatch?", "media_id": null}], "options": {"A": "Prohibiting female education", "B": "Providing special financial grants for female schooling and establishing teacher training normal schools", "C": "Declaring teacher training redundant", "D": "Closing schools"}, "explanation": "It championed female education and systematic institutional teacher training normal schools."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multipl