{"id": "11th_tamil_u4_q090", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_tholkappiya_paayiram", "chapter_id": null, "topic_id": "tholkappiyam_three_sections", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘எழுத்தும் சொல்லும் பொருளும் நாடி...’ - தொல்காப்பியத்தில் அமைந்துள்ள மூன்று பெரும் பிரிவுகள் (அதிகாரங்கள்) எவை?", "media_id": null}], "options": {"A": "அறம், பொருள், இன்பம்", "B": "எழுத்ததிகாரம், சொல்லதிகாரம், பொருளதிகாரம்", "C": "இயல், இசை, நாடகம்", "D": "யாப்பு, அணி, பாட்டு"}, "explanation": "தொல்காப்பியம் எழுத்து, சொல், பொருள் என மூன்று அதிகாரங்களைக் கொண்டுள்ளது; ஒவ்வோர் அதிகாரமும் 9 இயல்களாகப் பகுக்கப்பட்டு மொத்தம் 27 இயல்களைக் கொண்டது."}, "en": {"blocks": [{"type": "text", "content": "Which three grand foundational divisions (Athikaarangal) constitute the treatise Tholkappiyam?", "media_id": null}], "options": {"A": "Aram, Porul, and Inbam", "B": "Ezhuthathikaaram (Phonology/Orthography), Sollathikaaram (Morphology/Syntax), and Porulathikaaram (Poetics/Sociology)", "C": "Iyal, Isai, and Naadagam", "D": "Prosody, Rhetoric, and Poetry"}, "explanation": "Tholkappiyam contains three master books: Ezhuthu, Sol, and Porul, each with 9 chapters totaling 27."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 85, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 85", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 4", "Grammar", "Tholkappiyam Structure"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u4_q091", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_tholkappiya_paayiram", "chapter_id": null, "topic_id": "ainthiram_mastery", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மல்குநீர் வரைப்பின் ஐந்திரம் நிறைந்த / தொல்காப்பியன் எனத் தன்பெயர் தோற்றி...’ - இதில் ‘ஐந்திரம்’ என்பது எதனைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "ஐந்து நிலங்கள்", "B": "ஐந்து இந்திரியங்கள்", "C": "இந்திரனால் உருவாக்கப்பட்டதாகக் கருதப்படும் தொன்மையான வடமொழி இலக்கண நூல் (ஐந்திர வியாகரணம்)", "D": "ஐம்பெருங்காப்பியம்"}, "explanation": "ஐந்திரம் என்பது பாணினியின் அஷ்டாத்தியாயிக்கு முற்பட்ட தொன்மையான வடமொழி இலக்கண நூலாகும்; தொல்காப்பியர் அதிலும் வல்லவர் என்பதைப் பாயிரம் கூறுகிறது."}, "en": {"blocks": [{"type": "text", "content": "In the verse 'Ainthiram niraintha Tholkappiyan...', what does 'Ainthiram' specifically signify?", "media_id": null}], "options": {"A": "The five classical landscapes", "B": "The five physical human senses", "C": "Ainthiram (Aindra Vyakarana), an ancient pre-Paninian Sanskrit grammatical system", "D": "The Five Great Epics"}, "explanation": "Ainthiram refers to the ancient Aindra grammatical system, which Tholkappiyar had thoroughly mastered."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kal