{"id": "11th_tamil_u4_q111", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_tholkappiya_paayiram", "chapter_id": null, "topic_id": "tholkappiyam_chapters_count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொல்காப்பியத்தில் உள்ள மொத்த நூற்பாக்களின் எண்ணிக்கை தோராயமாக எத்தனை?", "media_id": null}], "options": {"A": "500 நூற்பாக்கள்", "B": "1000 நூற்பாக்கள்", "C": "1610-க்கும் மேற்பட்ட நூற்பாக்கள் (1612 நூற்பாக்கள்)", "D": "3000 நூற்பாக்கள்"}, "explanation": "தொல்காப்பியத்தில் எழுத்து, சொல், பொருள் ஆகிய மூன்றிலும் சேர்த்து மொத்தம் 1612 நூற்பாக்கள் அமைந்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Approximately how many aphoristic metric sutras (Noorpaakkal) comprise the entire Tholkappiyam?", "media_id": null}], "options": {"A": "500 sutras", "B": "1000 sutras", "C": "Over 1610 sutras (1612 sutras)", "D": "3000 sutras"}, "explanation": "Tholkappiyam contains 1,612 aphoristic sutras across its 27 chapters."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 85, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 85", "url": null, "source_notes": n