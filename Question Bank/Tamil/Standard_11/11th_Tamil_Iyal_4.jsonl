{"id": "11th_tamil_u4_q008", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "sangam_educational_institutions", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க காலத்தில் கற்பிக்கும் இடங்களை என்னவென்று இலக்கியங்கள் குறிப்பிடுகின்றன?", "media_id": null}], "options": {"A": "கல்லூரி", "B": "பல்கலைக்கழகம்", "C": "ஆலயம்", "D": "மன்றம், சான்றோர் அவை, ஓதுவார்கூடம், பள்ளி"}, "explanation": "சங்க காலத்தில் கல்வி பயிற்றுவிக்கப்பட்ட இடங்கள் மன்றம், அவை, பள்ளி என்று பல்வேறு பெயர்களால் குறிக்கப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "How did classical Sangam literature designate public centers of instruction and learning?", "media_id": null}], "options": {"A": "Colleges", "B": "Modern universities", "C": "Temples solely", "D": "Manram, Saanroor Avai, Othuvaarkoodam, and Palli"}, "explanation": "Institutions were referred to as Manram, Avai, and Palli in ancient texts."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 78, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 78", "url": null, "sou