{"id": "11th_tamil_u4_q063", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "bothanaar_exception_rule", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நற்றிணை நூலின் அடி எல்லை 9 முதல் 12 அடிகள் ஆகும். ஆனால் போதனார் பாடிய 110-ஆம் பாடல் மட்டும் விதிவிலக்காக எத்தனை அடிகளைக் கொண்டுள்ளது?", "media_id": null}], "options": {"A": "10 அடிகள்", "B": "12 அடிகள்", "C": "13 அடிகள் (விதிவிலக்கான பாடல்)", "D": "15 அடிகள்"}, "explanation": "நற்றிணையின் சிற்றெல்லை 9 அடி, பேரெல்லை 12 அடி. ஆனால் போதனார் பாடிய 110-ஆம் பாடல் மட்டுமே நற்றிணையில் விதிவிலக்காக 13 அடிகளைக் கொண்டுள்ளது! (மிக முக்கியமான TNPSC வினா)."}, "en": {"blocks": [{"type": "text", "content": "Natrinai strictly spans 9 to 12 metric lines. However, how many lines does Bothanaar's exceptional verse 110 contain?", "media_id": null}], "options": {"A": "10 lines", "B": "12 lines", "C": "13 lines (The sole solitary exception in Natrinai)", "D": "15 lines"}, "explanation": "Bothanaar's poem 110 is the only verse in the entire 400-poem Natrinai anthology spanning 13 lines."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 84, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 84", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 4", "Sangam Metrics", "Bothanaar Exception"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u4_q064", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "natrinai_110_thinai_thurai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நற்றிணை 110-ஆம் பாடலின் திணையும் துறையும் எவை?", "media_id": null}], "options": {"A": "குறிஞ்சித் திணை; பாங்கி கூற்று", "B": "நெய்தல் திணை; நற்றாய் கூற்று", "C": "மருதத் திணை; தோழி கூற்று", "D": "பாலைத் திணை; மகள் நிலை உரைத்தல் (செவிலித்தாய் கூற்று)"}, "explanation": "இப்பாடல் பாலைத் திணையில், தலைவனோடு சென்ற தலைவியின் இல்லற மாண்பைக் கண்டு வியந்து கூறும் 'மகள் நிலை உரைத்தல்' (செவிலித்தாய் கூற்று) துறையில் அமைந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "What are the Thinai (Landscape) and Thurai (Situational context) of Natrinai 110?", "media_id": null}], "options": {"A": "Kurinji Thinai; Friend's speech", "B": "Neithal Thinai; Birth-mother's lament", "C": "Marutham Thinai; Maid's plea", "D": "Paalai Thinai; Magal Nilai Uraithal (Foster-mother reflecting on heroine's domestic maturity)"}, "explanation": "It is set in Paalai Thinai under the sub-theme Magal Nilai Uraithal spoken by the foster-mother."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educationa