{"id": "11th_tamil_u4_q109", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_tholkappiya_paayiram", "chapter_id": null, "topic_id": "tholkappiyam_commentators", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொல்காப்பியப் பொருளதிகாரத்திற்குச் சிறந்த உரை எழுதிய பழைய உரையாசிரியர்களுள் முதன்மையானவர் யார்?", "media_id": null}], "options": {"A": "இளம்பூரணர் (மற்றும் பேராசிரியர், நச்சினார்க்கினியர்)", "B": "அடியார்க்கு நல்லார்", "C": "பரிமேலழகர்", "D": "மணக்குடவர்"}, "explanation": "தொல்காப்பிய முழுமைக்கும் உரை எழுதியவர் இளம்பூரணர் ஆவார்; இவரே 'உரையாசிரியர்' எனத் தனிப்பெரும் சிறப்போடு அழைக்கப்படுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Who holds the pre-eminent distinction of writing the earliest complete classical commentary on all three books of Tholkappiyam?", "media_id": null}], "options": {"A": "Ilampooranar (known simply as 'The Commentator' - Uraiaasiriyar)", "B": "Adiyaarkkunallaar", "C": "Parimelazhagar", "D": "Manakkudavar"}, "explanation": "Ilampooranar is revered as the foremost commentator of Tholkappiyam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page":