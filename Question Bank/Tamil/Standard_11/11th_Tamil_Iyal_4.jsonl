{"id": "11th_tamil_u4_q088", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_tholkappiya_paayiram", "chapter_id": null, "topic_id": "chief_examiner_athangodu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொல்காப்பியத்தை முழுமையாகக் கேட்டு, ஐயங்களை வினாவி அரங்கேற்றத்திற்குத் தலைமை தாங்கிய அறிஞர் யார்?", "media_id": null}], "options": {"A": "பனம்பாரனார்", "B": "தொல்காப்பியர்", "C": "அகத்தியர்", "D": "அறங்கரைக் நாவின் நான்மறை முற்றிய அதங்கோட்டு ஆசான்"}, "explanation": "கன்னியாகுமரி மாவட்டம் விளவங்கோடு வட்டத்தில் உள்ள அதங்கோடு என்ற ஊரைச் சேர்ந்த அதங்கோட்டாசான் தலைமை ஏற்று நூலை ஆராய்ந்து அரங்கேற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Which eminent master scholar presided over the academic defense and critical examination of Tholkappiyam?", "media_id": null}], "options": {"A": "Panampaaranaar", "B": "Tholkappiyar", "C": "Agathiyar", "D": "Athangottu Aasaan (of Athangodu)"}, "explanation": "Sage Athangottu Aasaan, hailing from Athangodu in Kanyakumari district, presided over its critical defense."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 85, "chapter": null, "