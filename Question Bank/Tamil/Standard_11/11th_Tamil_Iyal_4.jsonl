{"id": "11th_tamil_u4_q082", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "natrinai_first_published_year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நற்றிணை நூலை முதன்முதலில் பதிப்பித்து வெளியிட்ட தமிழறிஞர் மற்றும் வெளியிடப்பட்ட ஆண்டு எது?", "media_id": null}], "options": {"A": "உ. வே. சாமிநாதையர் (1894)", "B": "பின்னத்தூர் அ. நாராயணசாமி ஐயர் (1915)", "C": "சி. வை. தாமோதரம்பிள்ளை (1881)", "D": "மறைமலையடிகள் (1905)"}, "explanation": "நற்றிணை நூலை முதன்முதலில் சிறந்த உரையுடன் 1915-இல் பதிப்பித்து வெளியிட்ட பெருமை பின்னத்தூர் அ. நாராயணசாமி ஐயர் அவர்களையே சாரும்."}, "en": {"blocks": [{"type": "text", "content": "Who pioneered the first scholarly print edition with commentary of Natrinai in 1915?", "media_id": null}], "options": {"A": "U. V. Swaminatha Iyer (1894)", "B": "Pinnathur A. Narayanasamy Iyer (1915)", "C": "C. W. Damodaram Pillai (1881)", "D": "Maraimalai Adigal (1905)"}, "explanation": "Pinnathur A. Narayanasamy Iyer published the editio princeps of Natrinai in 1915."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "pag