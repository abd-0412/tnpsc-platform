{"id": "11th_tamil_u4_q005", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "thinnai_pallikkoodam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைய தமிழகத்தில் கிராமப்புறங்களில் வீட்டுத் திண்ணைகளில் இயங்கி வந்த தொடக்கப் பள்ளிகள் எவ்வாறு அழைக்கப்பட்டன?", "media_id": null}], "options": {"A": "திண்ணைப் பள்ளிகள் (நாட்டுப் பள்ளிக்கூடங்கள்)", "B": "சர்ச் பள்ளிகள்", "C": "ஆங்கிலப் பள்ளிகள்", "D": "பல்கலைக்கழகங்கள்"}, "explanation": "ஊர்தோறும் வீட்டுத் திண்ணைகளில் ஆசிரியரால் கற்பிக்கப்பட்ட மரபுவழிப் பள்ளிகள் 'திண்ணைப் பள்ளிகள்' அல்லது நாட்டுப் பள்ளிக்கூடங்கள் எனப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "What were the traditional community elementary schools operating on the verandas of village homes called?", "media_id": null}], "options": {"A": "Thinnai Palligal (Village Veranda Schools / Naattu Pallikkoodangal)", "B": "Church convent academies", "C": "English grammar schools", "D": "Collegiate universities"}, "explanation": "Indigenous elementary community schools were termed Thinnai Palligal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 79, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 79", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 4", "Education History", "Thinnai Schools"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
