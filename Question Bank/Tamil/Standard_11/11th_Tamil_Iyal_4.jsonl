{"id": "11th_tamil_u4_q145", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "grammar_padaippaakka_uthigal", "chapter_id": null, "topic_id": "symbol_examples_dove", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உலக இலக்கியங்களிலும் பண்பாட்டிலும் ‘வெண்புறா’ என்பது எதன் உலகளாவிய குறியீடாகப் போற்றப்படுகிறது?", "media_id": null}], "options": {"A": "அமைதி (Peace)", "B": "போர்", "C": "செல்வம்", "D": "கோபம்"}, "explanation": "வெண்புறா என்பது உலகெங்கிலும் சமாதானம் மற்றும் அமைதியின் புனிதக் குறியீடாகப் பயன்படுத்தப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "In global literature and cultural iconography, what does the 'White Dove' universally symbolize?", "media_id": null}], "options": {"A": "Peace and tranquility (அமைதி)", "B": "Warfare", "C": "Avarice", "D": "Wrath"}, "explanation": "The white dove is the universal symbol of peace."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 89, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 89", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year"