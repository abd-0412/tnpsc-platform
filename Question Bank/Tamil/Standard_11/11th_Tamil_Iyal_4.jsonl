{"id": "11th_tamil_u4_q112", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_tholkappiya_paayiram", "chapter_id": null, "topic_id": "paayiram_cultural_significance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பனம்பாரனாரின் தொல்காப்பியப் பாயிரம் தமிழ்ச் சமூக வரலாற்றுக்கு வழங்கும் மாபெரும் கொடை யாது?", "media_id": null}], "options": {"A": "போர் வியூகங்களை விவரிப்பது", "B": "வணிகக் கணக்குகளைத் தருவது", "C": "அரசர்களின் மரபு வழியைப் பாடுவது", "D": "சங்க காலத் தமிழகத்தின் நில எல்லைகள், மொழி பயன்பாட்டு நெறிகள் மற்றும் இலக்கண அரங்கேற்ற கல்வி மரபினை வரலாற்றுச் சான்றாக நிலைநிறுத்தியமை"}, "explanation": "பனம்பாரனாரின் பாயிரமே தமிழகத்தின் தொன்மையான புவியியல் எல்லைகளையும், தொல்காப்பியத்தின் வரலாற்று அரங்கேற்றத்தையும் பதிவு செய்த ஈடுஇணையற்ற வரலாற்று ஆவணமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the supreme historical gift bequeathed by Panampaaranaar's preface to Tamil historiography?", "media_id": null}], "options": {"A": "Cataloguing military battle formations", "B": "Furnishing mercantile ledgers", "C": "Listing royal dynastic genealogies", "D": "Documenting the territorial boundaries, dual registers of living speech, and rigorous peer-review academic defense tradition of ancient Tamilagam"}, "explanation": "It is the definitive charter of Tamil territoriality, living language registers, and ancient peer-review defense."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settin