{"id": "11th_tamil_u4_q066", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "heroine_character_natrinai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தந்தையின் வீட்டில் தேன் கலந்த பாலை உண்ண மறுத்து அடம் பிடித்த தலைவி, கணவன் வீட்டில் எத்தகைய சூழலிலும் மனநிறைவோடு வாழ்கிறாள்?", "media_id": null}], "options": {"A": "அரண்மனை உணவை உண்டு", "B": "ஒருவேளை உணவு கூடக் கிடைக்காத கடுமையான வறுமைச் சூழலிலும் கணவனின் அன்பையே பெரிதாகக் கொண்டு இன்முகத்தோடு", "C": "தந்தை வீட்டுச் செல்வத்தை வரவழைத்து", "D": "கணவனை விட்டுப் பிரிந்து"}, "explanation": "வளர்ப்பு வீட்டில் பொற்கிண்ணத்துப் பாலை மறுத்த தலைவி, கணவன் வறுமையுற்ற போதும் ஒருவேளை உணவோடு தன் பசியைப் பொறுத்துக் கொண்டு இல்லறம் நடத்தும் மாண்பைக் கண்டு செவிலித்தாய் வியக்கிறாள்."}, "en": {"blocks": [{"type": "text", "content": "How does the young heroine adapt to her newly wedded husband's household in Natrinai 110?", "media_id": null}], "options": {"A": "Demanding royal feasts", "B": "Embracing even severe poverty and skipped meals with joyful dignity, valuing marital love above material luxury", "C": "Importing gold from her father", "D": "Abandoning her spouse"}, "explanation": "She endures hardship gracefully, refusing to let her father's wealth overshadow her husband's dignity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0