{"id": "11th_tamil_u4_q031", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "woods_despatch_1854", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியக் கல்வியின் ‘மகாசாசனம்’ (Magna Carta of English Education in India) என்று வரலாற்று அறிஞர்களால் போற்றப்படும் கல்வி அறிக்கை எது?", "media_id": null}], "options": {"A": "ஹண்டர் குழு அறிக்கை (1882)", "B": "மெக்காலே குறிப்பு (1835)", "C": "சார்லஸ் உட் அறிக்கை (Wood's Despatch, 1854)", "D": "ராதாகிருஷ்ணன் அறிக்கை (1948)"}, "explanation": "1854-ஆம் ஆண்டு வெளியான சர் சார்லஸ் உட் அவர்களின் கல்வி அறிக்கை 'இந்தியக் கல்வியின் மகாசாசனம்' என அழைக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which milestone document is universally acclaimed as the 'Magna Carta of Modern Education in India'?", "media_id": null}], "options": {"A": "Hunter Commission Report (1882)", "B": "Macaulay's Minute (1835)", "C": "Charles Wood's Despatch (1854)", "D": "Radhakrishnan Commission (1948)"}, "explanation": "Wood's Despatch of 1854 is celebrated as the Magna Carta of modern Indian education."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11