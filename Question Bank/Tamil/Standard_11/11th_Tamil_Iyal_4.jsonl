{"id": "11th_tamil_u4_q098", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_tholkappiya_paayiram", "chapter_id": null, "topic_id": "eight_elements_of_sirappupayiram", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நன்னூலார் கூறும் சிறப்புப் பாயிரத்திற்குரிய எட்டுச் செய்திகளுள் பொருந்தாத ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "ஆக்கியோன் பெயர், நூல் வந்த வழி", "B": "நூலின் அச்சு விலை மற்றும் விற்பனை விவரம்", "C": "எல்லை, நூற்பெயர், யாப்பு", "D": "நுதலிய பொருள், கேட்போர், பயன்"}, "explanation": "நூலாசிரியர் பெயர், வழி, எல்லை, பெயர், யாப்பு, பாடுபொருள், கேட்போர், பயன் ஆகிய எட்டும் பாயிர உறுப்புகள்; அச்சு விலை என்பது இதில் இடம்பெறாது."}, "en": {"blocks": [{"type": "text", "content": "Which of the following is NOT one of the eight canonical components of a Special Preface according to Nannool?", "media_id": null}], "options": {"A": "Author's name and origin lineage", "B": "Printed retail cost and bookstore ledger data", "C": "Territorial boundary, title, and metric verse form", "D": "Subject matter, audience, and ultimate benefit"}, "explanation": "Commercial book costs are not part of classical Paayiram canons."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educatio