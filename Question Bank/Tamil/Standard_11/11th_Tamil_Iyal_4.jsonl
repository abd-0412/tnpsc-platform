{"id": "11th_tamil_u4_q089", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_tholkappiya_paayiram", "chapter_id": null, "topic_id": "twofold_language_usage", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வழக்குஞ் செய்யுளும் ஆயிரு முதலின்...’ - தொல்காப்பியம் ஆராய்ந்த இருவகை மொழிப் பயன்பாடுகள் எவை?", "media_id": null}], "options": {"A": "உலக வழக்கு (பேச்சு வழக்கு) மற்றும் செய்யுள் வழக்கு (இலக்கிய வழக்கு)", "B": "சமஸ்கிருதம் மற்றும் பிராகிருதம்", "C": "பாட்டு மற்றும் உரைநடை", "D": "எழுத்து மற்றும் பேச்சு மட்டுமே"}, "explanation": "மக்கள் அன்றாடம் பேசும் உலக வழக்கையும், கவிஞர்கள் பாடும் செய்யுள் வழக்கையும் ஆதாரமாகக் கொண்டே தொல்காப்பியம் இலக்கணம் வகுத்தது."}, "en": {"blocks": [{"type": "text", "content": "What two primary modes of linguistic usage are highlighted by 'Vazhakkum seyyulum aayiru muthalin'?", "media_id": null}], "options": {"A": "Ulaga Vazhakku (Colloquial spoken idiom) and Seyyul Vazhakku (Formal literary poetic register)", "B": "Sanskrit and Prakrit", "C": "Song and prose", "D": "Script and sound solely"}, "explanation": "Tholkappiyar synthesized both spoken dialect (Ulaga Vazhakku) and literary convention (Seyyul Vazhakku)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbo