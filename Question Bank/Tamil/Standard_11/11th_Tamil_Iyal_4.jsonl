{"id": "11th_tamil_u4_q085", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_tholkappiya_paayiram", "chapter_id": null, "topic_id": "author_paayiram", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொல்காப்பிய நூலுக்குச் சிறப்புப் பாயிரம் இயற்றி அளித்த புலவர் யார்?", "media_id": null}], "options": {"A": "பனம்பாரனார்", "B": "அதங்கோட்டாசான்", "C": "கபிலர்", "D": "நக்கீரர்"}, "explanation": "தொல்காப்பியத்திற்குத் தற்கால முன்னுரை போல அமைந்த புகழ்பெற்ற சிறப்புப் பாயிரத்தை இயற்றியவர் தொல்காப்பியரின் ஒருசாலை மாணாக்கரான பனம்பாரனார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who composed the historic invocatory Special Preface (Sirappup Paayiram) for the monumental grammar Tholkappiyam?", "media_id": null}], "options": {"A": "Panampaaranaar", "B": "Athangottaasaan", "C": "Kapilar", "D": "Nakkeerar"}, "explanation": "Panampaaranaar, a fellow disciple of Tholkappiyar under sage Agathiyar, composed the preface."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 85, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 85", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 4", "Poetry", "Author Profile"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u4_q086", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_tholkappiya_paayiram", "chapter_id": null, "topic_id": "boundary_of_tamil_land", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வடவேங்கடம் தென்குமரி ஆயிடைத் / தமிழ்கூறும் நல்லுலகத்து...’ - பனம்பாரனார் குறிப்பிடும் தமிழ்நாட்டின் வடக்கு மற்றும் தெற்கு எல்லைகள் எவை?", "media_id": null}], "options": {"A": "இமயமலை; இலங்கை", "B": "வடக்கில் வேங்கட மலை (திருப்பதி); தெற்கில் குமரி முனை", "C": "விந்திய மலை; காவிரி", "D": "கோதாவரி; வைகை"}, "explanation": "பண்டைய தமிழ்நாட்டின் வட எல்லை வேங்கட மலையாகவும் (திருப்பதி), தென் எல்லை குமரி முனையாகவும் விளங்கியதை இப்பாயிரம் அறுதியிட்டுக் கூறுகிறது."}, "en": {"blocks": [{"type": "text", "content": "According to the famous verse 'Vadavengadam Thenkumari aayidaith...', what were the northern and southern geographic borders of ancient Tamil land?", "media_id": null}], "options": {"A": "Himalayas in north; Sri Lanka in south", "B": "Mount Vengadam (Tirupati) in the north; Cape Kumari in the south", "C": "Vindhyas in north; Kaveri in south", "D": "Godavari in north; Vaigai in south"}, "explanation": "Mount Vengadam in the north and Cape Kumari in the south demarcated the linguistic borders of ancient Tamilagam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 85, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 85", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 4", "Geography", "Tamil Boundaries"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u4_q087", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_tholkappiya_paayiram", "chapter_id": null, "topic_id": "royal_assembly_king", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொல்காப்பியம் எந்தப் பாண்டிய மன்னனின் முன்னிலையில் அவையில் அரங்கேற்றப்பட்டது?", "media_id": null}], "options": {"A": "நெடுஞ்செழியன்", "B": "முடத்திருமாறன்", "C": "நிலந்தரு திருவிற் பாண்டியன்", "D": "பூதப்பாண்டியன்"}, "explanation": "தொல்காப்பிய இலக்கண நூல் 'நிலந்தரு திருவிற் பாண்டியன்' அவையத்தில் புலவர்கள் முன்னிலையில் அரங்கேற்றப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "In the royal court of which Pandyan monarch was the grammatical treatise Tholkappiyam formally inaugurated?", "media_id": null}], "options": {"A": "Nedunchezhian", "B": "Mudathirumaaran", "C": "Nilantharu Thiruvir Pandiyan", "D": "Boothappandiyan"}, "explanation": "Tholkappiyam was presented in the royal academy of the Pandyan king Nilantharu Thiruvir Pandiyan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 85, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 85", "url": 