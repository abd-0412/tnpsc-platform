{"id": "11th_tamil_u4_q058", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "meenakshi_literary_movement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் இரா. மீனாட்சி எந்த இலக்கிய இயக்கத்தின் முன்னோடிக் கவிஞர்களுள் ஒருவராகத் திகழ்ந்தார்?", "media_id": null}], "options": {"A": "மணிக்கொடி இயக்கம்", "B": "வானம்பாடி கவிதை இயக்கம் (மற்றும் எழுத்து இதழ் கவிஞர்)", "C": "தனித்தமிழ் இயக்கம்", "D": "செம்மொழி இயக்கம்"}, "explanation": "இரா. மீனாட்சி 1970-களில் எழுத்து மற்றும் வானம்பாடி இயக்கத்தின் முன்னணிப் புதுக்கவிஞர்களுள் ஒருவராகத் திகழ்ந்தார்."}, "en": {"blocks": [{"type": "text", "content": "To which dynamic modern Tamil poetry vanguard movement did poetess R. Meenakshi belong?", "media_id": null}], "options": {"A": "Manikkodi movement", "B": "Vaanambadi Poetry Movement (and Ezhuthu circle)", "C": "Pure Tamil Movement", "D": "Semmozhi movement"}, "explanation": "R. Meenakshi was a distinguished voice of the Vaanambadi movement."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 83, "chapter": null, "section": null, "refe