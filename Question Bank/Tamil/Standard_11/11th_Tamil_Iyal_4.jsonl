{"id": "11th_tamil_u4_q084", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "natrinai_110_virtue_synthesis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நற்றிணை 110-ஆம் பாடல் உணர்த்தும் பண்டைத் தமிழ்ப் பெண்ணின் விழுமிய இல்லறப் பண்பு யாது?", "media_id": null}], "options": {"A": "பெற்றோரை மட்டுமே மதித்தல்", "B": "அரண்மனையை விரும்புதல்", "C": "பிறரிடம் கையேந்துதல்", "D": "தந்தை வீட்டுப் பெருஞ்செல்வத்தை நாடாது, கணவனின் வறிய நிலையிலும் அவனது தன்மானத்தைக் காத்து, இன்முகத்தோடு இல்லறம் பேணும் மனப்பக்குவம்"}, "explanation": "கணவனின் வறுமையைப் பெற்றோருக்குக் காட்டிக் கொடுக்காமல், அவனது கௌரவத்தைக் காத்து, பசியையும் பொறுத்து வாழும் சங்கப் பெண்ணின் தன்னிகரற்ற தன்மானத்தை இப்பாடல் போற்றுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What sublime ethical dignity of classical Tamil womanhood is enshrined in Natrinai 110?", "media_id": null}], "options": {"A": "Revering only maternal family", "B": "Longing for palace vanity", "C": "Begging for dowry subsidies", "D": "Guarding her husband's self-respect amidst grinding poverty without seeking paternal charity, maintaining domestic grace"}, "explanation": "She preserves her spouse's dignity and bears adversity with uncomplaining nobility."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "