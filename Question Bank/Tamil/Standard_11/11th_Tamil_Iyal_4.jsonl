{"id": "11th_tamil_u4_q055", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "downward_filtration_theory", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மேல்தட்டு மக்களுக்குக் கல்வி கற்பித்தால் அது தானாகவே அடிமட்ட மக்களுக்கு வடிந்து செல்லும் என்ற பிரிட்டிஷாரின் போலி ‘வடிகட்டும் கல்விக் கொள்கை’ (Downward Filtration Theory) யாரால் முன்னெடுக்கப்பட்டது?", "media_id": null}], "options": {"A": "தாமஸ் மன்றோ", "B": "ரிப்பன் பிரபு", "C": "மெக்காலே", "D": "காமராசர்"}, "explanation": "மெக்காலேயின் கொள்கை வடிகட்டும் கொள்கை (Downward Filtration Theory) எனப்பட்டது; இது மக்கள் அனைவருக்கும் கல்வி வழங்கும் ஜனநாயகக் கொள்கைக்கு எதிரானது."}, "en": {"blocks": [{"type": "text", "content": "Which colonial figure championed the flawed 'Downward Filtration Theory' assuming education would filter down from the elite to the masses?", "media_id": null}], "options": {"A": "Thomas Munro", "B": "Lord Ripon", "C": "Lord Macaulay", "D": "Kamaraj"}, "explanation": "Macaulay advocated the elitist Downward Filtration Theory."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2