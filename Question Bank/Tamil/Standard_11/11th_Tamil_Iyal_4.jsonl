{"id": "11th_tamil_u4_q034", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "hunter_commission_1882", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "1882-ஆம் ஆண்டு தொடக்கக் கல்வியின் நிலையை ஆராய்ந்து, உள்ளாட்சி அமைப்புகள் (நகராட்சி, மாவட்ட வாரியம்) தொடக்கப் பள்ளிகளை நடத்த வேண்டும் எனப் பரிந்துரைத்த குழு எது?", "media_id": null}], "options": {"A": "சார்ஜென்ட் குழு", "B": "ஹண்டர் கல்விக் குழு (Hunter Commission, 1882)", "C": "கோத்தாரி குழு", "D": "முதலியார் குழு"}, "explanation": "1882-ஆம் ஆண்டின் சர் வில்லியம் ஹண்டர் கல்விக் குழு உள்ளாட்சி அமைப்புகள் தொடக்கக் கல்வியை விரிவாக்க வேண்டும் எனப் பரிந்துரைத்தது."}, "en": {"blocks": [{"type": "text", "content": "Which 1882 commission recommended transferring primary education management to local municipalities and district boards?", "media_id": null}], "options": {"A": "Sargent Committee", "B": "Hunter Education Commission (1882)", "C": "Kothari Commission", "D": "Mudaliar Commission"}, "explanation": "The Hunter Commission of 1882 mandated local-body administration of primary schools."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class