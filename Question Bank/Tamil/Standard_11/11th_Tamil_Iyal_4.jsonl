{"id": "11th_tamil_u4_q100", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_tholkappiya_paayiram", "chapter_id": null, "topic_id": "tholkappiyam_oldest_grammar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இன்று நமக்குக் கிடைத்துள்ள தமிழ் இலக்கண நூல்களுள் மிகவும் பழமையான முதல் இலக்கண நூல் எது?", "media_id": null}], "options": {"A": "நன்னூல்", "B": "வீரசோழியம்", "C": "இலக்கண விளக்கம்", "D": "தொல்காப்பியம்"}, "explanation": "இன்று முழுமையாகக் கிடைத்துள்ள தமிழ் நூல்களுள் காலத்தால் முற்பட்ட தலைசிறந்த இலக்கணப் பெட்டகம் தொல்காப்பியம் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which is the oldest extant complete grammatical and literary treatise surviving in the Tamil language?", "media_id": null}], "options": {"A": "Nannool", "B": "Veerasozhiyam", "C": "Ilakkana Vilakkam", "D": "Tholkappiyam"}, "explanation": "Tholkappiyam is the oldest surviving literary monument in Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 85, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 85", "url": null, "source_notes": null}, "previous_year": {"is_previous_y