{"id": "11th_tamil_u4_q007", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "writing_materials_ancient", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திண்ணைப் பள்ளிகளில் குழந்தைகள் தொடக்கத்தில் எதன் மீது விரலால் எழுதிப் பழகினர்?", "media_id": null}], "options": {"A": "காகிதத்தில்", "B": "மரப்பலகையில்", "C": "மணலில் (மணல் பரப்பி விரலால் எழுதுதல்)", "D": "சுவற்றில்"}, "explanation": "மணலைத் தரையில் பரப்பி, அதில் மாணவர்கள் தம் ஆள்காட்டி விரலால் எழுத்துகளை எழுதிப் பழகியதால் அவர்களின் விரல்கள் வலிமை பெற்றன."}, "en": {"blocks": [{"type": "text", "content": "On what surface did young children in traditional Thinnai schools initially trace letters with their fingers?", "media_id": null}], "options": {"A": "Parchment paper", "B": "Wooden slate", "C": "Spread fine sand (Manal)", "D": "Stone brick walls"}, "explanation": "Children first practiced orthography by writing with their fingers in fine sand."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 79, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page