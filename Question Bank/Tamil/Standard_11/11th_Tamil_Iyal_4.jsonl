{"id": "11th_tamil_u4_q035", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "grant_in_aid_system", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தனியார் மற்றும் மிஷினரி பள்ளிகளுக்கு அரசு நிதி உதவி வழங்கும் ‘மானிய முறை’ (Grant-in-Aid System) எந்த அறிக்கையால் அறிமுகமானது?", "media_id": null}], "options": {"A": "மன்றோ அறிக்கை", "B": "மெக்காலே அறிக்கை", "C": "சார்லஸ் உட் அறிக்கை (1854)", "D": "ஹார்டாக் குழு"}, "explanation": "சார்லஸ் உட் அறிக்கை தனியார் கல்வி நிறுவனங்களை ஊக்குவிக்க அரசு மான்ய முறையை (Grant-in-Aid) நடைமுறைப்படுத்தியது."}, "en": {"blocks": [{"type": "text", "content": "Which milestone document institutionalized the Grant-in-Aid system funding private and missionary educational ventures?", "media_id": null}], "options": {"A": "Munro Minutes", "B": "Macaulay Minutes", "C": "Charles Wood's Despatch (1854)", "D": "Hartog Committee"}, "explanation": "Wood's Despatch instituted the Grant-in-Aid scheme for schools."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 81, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 81", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 4", "Policy", "Grant-in-Aid"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u4_q036", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "printed_books_revolution", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஓலைச்சுவடிகளிலிருந்து நவீன அச்சுப் புத்தகங்களுக்குத் தமிழ் கல்வி முறை மாறுவதற்கு முதன்மைக் காரணியாக அமைந்தது எது?", "media_id": null}], "options": {"A": "எழுத்தாணி தயாரிப்பு குறைந்தது", "B": "பனை மரங்கள் அழிந்தது", "C": "சுவடிகள் தடை செய்யப்பட்டது", "D": "அச்சு இயந்திரங்களின் வரவு மற்றும் தமிழ் நூல்கள் அச்சேறியமை (சீகன் பால்கு தரங்கம்பாடி அச்சுக்கூடம்)"}, "explanation": "தரங்கம்பாடியில் சீகன்பால்கு அமைத்த அச்சுக்கூடம் மற்றும் 19-ஆம் நூற்றாண்டு அச்சுப் புரட்சி ஏட்டுச் சுவடியிலிருந்து புத்தகக் கல்விக்கு வழிகோலியது."}, "en": {"blocks": [{"type": "text", "content": "What historical technological revolution facilitated the transition from brittle palm-leaf manuscripts to modern textbooks?", "media_id": null}], "options": {"A": "Scarcity of iron styluses", "B": "Extinction of palmyra trees", "C": "Prohibition of palm leaves", "D": "Arrival of printing press technology (e.g. Ziegenbalg's Tranquebar press) and modern typography"}, "explanation": "Printing presses in Tranquebar and Madras revolutionized mass education via printed books."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 81, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 81", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 4", "Publishing History", "Printing Press"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u4_q037", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "midday_meal_pioneers_madras", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியாவிலேயே முதன்முதலாக 1920-ஆம் ஆண்டு சென்னை ஆயிரம் விளக்கு மாநகராட்சிப் பள்ளியில் ஏழை மாணவர்களுக்கு மதிய உணவுத் திட்டத்தை அறிமுகப்படுத்திய முன்னோடி அமைப்பு எது?", "media_id": null}], "options": {"A": "நீதிக்கட்சி அரசு (சர் பி. தியாகராயர் தலைமை)", "B": "கிழக்கிந்திய கம்பெனி", "C": "சுயாட்சி இயக்கம்", "D": "இந்திய தேசிய காங்கிரஸ்"}, "explanation": "1920-இல் நீதிக்கட்சி ஆட்சியில் சர் பி. தியாகராயரின் முயற்சியால் சென்னை ஆயிரம் விளக்குப் பகுதியில் முதன்முதலில் இலவச மதிய உணவுத் திட்டம் தொடங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which pioneering political administration introduced India's first municipal free Midday Meal Scheme at Thousand Lights, Madras in 1920?", "media_id": null}], "options": {"A": "Justice Party Administration (under Sir P. Theagaraya Chetty)", "B": "East India Company", "C": "Home Rule League", "D": "Indian National Congress"}, "explanation": "The Justice Party government pioneered the Midday Meal Scheme in Madras in 1920."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Ka