{"id": "11th_tamil_u4_q001", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "author_intro", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தமிழகக் கல்வி வரலாறு’ என்னும் உரைநடைக் கட்டுரையை எழுதிய கல்வியாளர் யார்?", "media_id": null}], "options": {"A": "முனைவர் ச. மாடசாமி", "B": "முனைவர் வ. சுப. மாணிக்கம்", "C": "பேராசிரியர் ந. சஞ்சீவி", "D": "மு. வரதராசனார்"}, "explanation": "பாடப்பகுதியில் இடம்பெற்றுள்ள 'தமிழகக் கல்வி வரலாறு' என்னும் கட்டுரையை எழுதியவர் புகழ்பெற்ற கல்வியாளரான முனைவர் ச. மாடசாமி ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the comprehensive pedagogical essay 'History of Education in Tamil Nadu'?", "media_id": null}], "options": {"A": "Dr. S. Madasamy", "B": "Dr. V. Sp. Manickam", "C": "Prof. N. Sanjeevi", "D": "Mu. Varadarajan"}, "explanation": "Dr. S. Madasamy authored the essay 'History of Education in Tamil Nadu'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 78, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 78", "url": null, "source_notes": null