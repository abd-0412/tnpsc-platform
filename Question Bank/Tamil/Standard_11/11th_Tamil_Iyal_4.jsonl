{"id": "11th_tamil_u4_q003", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "purananooru_author_king", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உற்றுழி உதவியும் உறுபொருள் கொடுத்தும்...’ என்ற புறநானூற்றுப் பாடலைப் பாடிய அரசர் யார்?", "media_id": null}], "options": {"A": "சேரன் செங்குட்டுவன்", "B": "கரிகால் சோழன்", "C": "ஆரியப்படை கடந்த நெடுஞ்செழியன்", "D": "அதியமான் நெடுமான் அஞ்சி"}, "explanation": "இப்பாடலைப் பாடியவர் பாண்டிய மன்னரான 'ஆரியப்படை கடந்த நெடுஞ்செழியன்' ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Which royal poet authored the famous Purananooru verse emphasizing that education elevates human dignity above birth?", "media_id": null}], "options": {"A": "Cheran Senguttuvan", "B": "Karikala Cholan", "C": "Aariyappadai Kadantha Nedunchezhian", "D": "Athiyaman Neduman Anji"}, "explanation": "Pandyan monarch Aariyappadai Kadantha Nedunchezhian composed this immortal verse."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 78, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4,