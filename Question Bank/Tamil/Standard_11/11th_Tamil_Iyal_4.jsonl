{"id": "11th_tamil_u4_q119", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "supplementary_ithazhaalar_bharathi", "chapter_id": null, "topic_id": "pseudonyms_bharathi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிரிட்டிஷ் அரசின் கடுமையான தணிக்கையிலிருந்து தப்பிக்க பாரதியார் பயன்படுத்திய புனைபெயர்களுள் பொருந்தாத ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "காளிதாசன், சக்திதாசன்", "B": "செல்லம்மா, சாவித்திரி", "C": "வானம்பாடி, தமிழ்நாடன்", "D": "நித்திய தீரர், உத்தம தேசாபிமானி"}, "explanation": "காளிதாசன், சக்திதாசன், செல்லம்மா, சாவித்திரி, நித்திய தீரர், உத்தம தேசாபிமானி, பிஞ்சுக் காளிதாசன் போன்றவை பாரதியின் புனைபெயர்கள்; வானம்பாடி என்பது பிற்பட்ட இயக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following was NOT an authentic journalistic pseudonym (pen-name) used by Subramania Bharati?", "media_id": null}], "options": {"A": "Kalidasan, Sakthidasan", "B": "Chellamma, Savithri", "C": "Vaanambadi, Tamilnaadan", "D": "Nithiya Theerar, Uthama Desabhimani"}, "explanation": "'Vaanambadi' was a 1970s poetry movement, not a pen-name of Bharati."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_yea