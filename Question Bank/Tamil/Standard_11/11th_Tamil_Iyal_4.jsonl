{"id": "11th_tamil_u4_q061", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "pillaikkoodam_central_theme", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பிள்ளைக்கூடம்’ கவிதையில் கவிஞர் விரும்பும் பள்ளி எத்தகைய அமைப்பைக் கொண்டது?", "media_id": null}], "options": {"A": "சுவர்களற்ற, மரங்களும் பறவைகளும் அணில்களும் குழந்தைகளோடு சேர்ந்து கற்கும் சுதந்திரமான இயற்கை வெளி", "B": "இரும்பு வேலி சூழ்ந்த சிறை போன்ற பள்ளி", "C": "கணிப்பொறி மட்டுமே உள்ள குளிரூட்டப்பட்ட அறை", "D": "தேர்வுகளும் தண்டனைகளும் நிறைந்த பள்ளி"}, "explanation": "சுவர்களற்ற, இயற்கையோடு இயைந்த, குருவிகளோடும் அணில்களோடும் குழந்தைகள் கொஞ்சிப் பேசி மகிழும் சுதந்திரமான பள்ளியையே கவிஞர் கனவு காண்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "What utopian educational environment does poetess R. Meenakshi envision in 'Pillaikkoodam'?", "media_id": null}], "options": {"A": "A boundless wall-less open space where children learn freely alongside trees, chirping birds, and squirrels", "B": "A fortified prison surrounded by iron bars", "C": "An air-conditioned hall with only computers", "D": "A punitive regime of continuous examinations"}, "explanation": "She envisions a wall-less natural haven where flora, fauna, and children learn in joyous harmony."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "a