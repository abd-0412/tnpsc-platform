{"id": "11th_tamil_u4_q057", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "author_pillaikkoodam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பிள்ளைக்கூடம்’ என்னும் புதுக்கவிதையை இயற்றிய நவீனத் தமிழ்க் கவிஞர் யார்?", "media_id": null}], "options": {"A": "இரா. மீனாட்சி", "B": "கவிஞர் சிற்பி", "C": "இன்குலாப்", "D": "நா. காமராசன்"}, "explanation": "இயற்கையோடு இணைந்த மழலையர் பள்ளிச் சூழலை அழகுறச் சித்தரிக்கும் 'பிள்ளைக்கூடம்' கவிதையை இயற்றியவர் இரா. மீனாட்சி ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who composed the modern Tamil free-verse poem 'Pillaikkoodam' (Children's School)?", "media_id": null}], "options": {"A": "R. Meenakshi", "B": "Kavignar Sirpi", "C": "Inqulab", "D": "Na. Kamarasan"}, "explanation": "Eminent poetess R. Meenakshi composed 'Pillaikkoodam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 83, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 83", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "