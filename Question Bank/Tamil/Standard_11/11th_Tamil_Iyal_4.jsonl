{"id": "11th_tamil_u4_q110", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_tholkappiya_paayiram", "chapter_id": null, "topic_id": "tholkappiyar_master_agathiyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொல்காப்பியரும் பனம்பாரனாரும் யாருடைய பன்னிரு மாணாக்கர்களுள் முதன்மையானவர்களாக மரபில் கூறப்படுகின்றனர்?", "media_id": null}], "options": {"A": "போக முனிவர்", "B": "அகத்திய முனிவர் (அகத்தியர்)", "C": "திருவள்ளுவர்", "D": "நக்கீரர்"}, "explanation": "இலக்கிய மரபின்படி அகத்தியரின் பன்னிரண்டு சீடர்களுள் முதன்மையான மாணவர்களாகத் தொல்காப்பியரும் பனம்பாரனாரும் கருதப்படுகின்றனர்."}, "en": {"blocks": [{"type": "text", "content": "According to grammatical tradition, under which primordial sage did Tholkappiyar and Panampaaranaar study as fellow disciples?", "media_id": null}], "options": {"A": "Sage Bogar", "B": "Sage Agathiyar", "C": "Thiruvalluvar", "D": "Nakkeerar"}, "explanation": "They were pre-eminent among the twelve disciples of sage Agathiyar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 85, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 85", "ur