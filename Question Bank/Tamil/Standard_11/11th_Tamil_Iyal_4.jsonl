{"id": "11th_tamil_u4_q073", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "natrinai_total_verses", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நற்றிணையில் கடவுள் வாழ்த்து நீங்கலாக மொத்தம் உள்ள பாடல்களின் எண்ணிக்கை எத்தனை?", "media_id": null}], "options": {"A": "400 பாடல்கள்", "B": "500 பாடல்கள்", "C": "300 பாடல்கள்", "D": "100 பாடல்கள்"}, "explanation": "நற்றிணை கடவுள் வாழ்த்து நீங்கலாக 400 அகவற்பாக்களால் ஆனது."}, "en": {"blocks": [{"type": "text", "content": "Excluding the invocatory prayer, how many total poems constitute the Natrinai anthology?", "media_id": null}], "options": {"A": "400 verses", "B": "500 verses", "C": "300 verses", "D": "100 verses"}, "explanation": "Natrinai comprises 400 classical verses in Agaval meter."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 84, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 84", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "medi