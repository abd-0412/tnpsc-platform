{"id": "11th_tamil_u4_q068", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "natrinai_patron_compiler", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘நற்றிணை நானூறு’ என்னும் நூலைத் தொகுப்பித்த அரசன் யார்?", "media_id": null}], "options": {"A": "உக்கிரப் பெருவழுதி", "B": "பூரிக்கோ", "C": "சேரன் செங்குட்டுவன்", "D": "பன்னாடு தந்த பாண்டியன் மாறன் வழுதி"}, "explanation": "நற்றிணையைத் தொகுப்பித்தவன் பன்னாடு தந்த பாண்டியன் மாறன் வழுதி ஆவார்; தொகுத்தவர் பெயர் அறியப்படவில்லை."}, "en": {"blocks": [{"type": "text", "content": "Who was the royal Pandyan patron who sponsored the compilation of the anthology Natrinai?", "media_id": null}], "options": {"A": "Ukkirap Peruvaluthi", "B": "Poorikko", "C": "Cheran Senguttuvan", "D": "Pannaadu Thantha Pandiyan Maaran Vazhuthi"}, "explanation": "Pannaadu Thantha Pandiyan Maaran Vazhuthi was the royal sponsor of Natrinai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 84, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 84", "url": null, "source_notes": null}, "pre