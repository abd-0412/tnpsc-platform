{"id": "11th_tamil_u4_q069", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "natrinai_god_prayer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நற்றிணை நூலுக்குக் கடவுள் வாழ்த்துப் பாடிய புலவர் யார்?", "media_id": null}], "options": {"A": "பாரதம் பாடிய பெருந்தேவனார்", "B": "கபிலர்", "C": "நக்கீரர்", "D": "ஔவையார்"}, "explanation": "எட்டுத்தொகை நூல்களுள் நற்றிணை, குறுந்தொகை, ஐங்குறுநூறு, பதிற்றுப்பத்து, அகநானூறு, புறநானூறு ஆகியவற்றிற்குக் கடவுள் வாழ்த்து பாடியவர் பாரதம் பாடிய பெருந்தேவனார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who composed the invocatory hymn praising Lord Vishnu (Thirumaal) for Natrinai?", "media_id": null}], "options": {"A": "Bharatham Paadiya Perundhevanaar", "B": "Kapilar", "C": "Nakkeerar", "D": "Avvaiyar"}, "explanation": "Bharatham Paadiya Perundhevanaar composed the invocatory hymn of Natrinai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 84, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 84", "url": null, "source_notes": null}, "previous_year": {"is_