{"id": "11th_tamil_u4_q059", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "meenakshi_poetry_collections", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் இரா. மீனாட்சி இயற்றிய கவிதைத் தொகுப்புகளுள் ஒன்று எது?", "media_id": null}], "options": {"A": "நிலவுப்பூ", "B": "சூரிய நிழல்", "C": "சுடுமண் சிலைகள் (மற்றும் நெருஞ்சி, கொடிவிளக்கு)", "D": "கருப்பு மலர்கள்"}, "explanation": "சுடுமண் சிலைகள், நெருஞ்சி, கொடிவிளக்கு, தீபாவளிப் பகல் போன்றவை இரா. மீனாட்சியின் புகழ்பெற்ற கவிதைத் தொகுப்புகள் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following celebrated poetry collections was authored by R. Meenakshi?", "media_id": null}], "options": {"A": "Nilavuppoo", "B": "Sooriya Nizhal", "C": "Suduman Silaigal (along with Nerunji and Kodivilakku)", "D": "Karuppu Malargal"}, "explanation": "'Suduman Silaigal' is an acclaimed poetry collection by R. Meenakshi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 83, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 83", "url": null, "sou