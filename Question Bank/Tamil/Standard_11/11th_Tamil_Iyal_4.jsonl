{"id": "11th_tamil_u4_q060", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "auroville_association", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் இரா. மீனாட்சி புதுச்சேரி அருகிலுள்ள எந்த சர்வதேசப் பண்பாட்டுச் சமூகத்தில் ஆசிரியராகவும் ஆய்வாளராகவும் பணியாற்றி வருகிறார்?", "media_id": null}], "options": {"A": "சாந்திநிகேதன்", "B": "சபர்மதி", "C": "வார்தா", "D": "ஆரோவில் (Auroville சர்வதேசக் குடியிருப்பு)"}, "explanation": "இரா. மீனாட்சி ஆரோவில் சர்வதேசக் குடியிருப்பில் கல்வி, சூழலியல் மற்றும் கிராம மேம்பாட்டுப் பணிகளில் பல பத்தாண்டுகளாக ஈடுபட்டு வருகிறார்."}, "en": {"blocks": [{"type": "text", "content": "In which international township near Puducherry does poetess R. Meenakshi reside, engaging in educational and ecological research?", "media_id": null}], "options": {"A": "Santiniketan", "B": "Sabarmati", "C": "Wardha", "D": "Auroville International Township"}, "explanation": "R. Meenakshi has been an integral educator and thinker at Auroville."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 83, "chapter": null, "sect