{"id": "11th_tamil_u4_q067", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "bothanaar_other_songs", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க இலக்கிய எட்டுத்தொகை நூல்களில் போதனார் பாடியதாகக் கிடைத்துள்ள மொத்தப் பாடல்களின் எண்ணிக்கை எத்தனை?", "media_id": null}], "options": {"A": "பத்து பாடல்கள்", "B": "ஐந்து பாடல்கள்", "C": "ஒரே ஒரு பாடல் மட்டுமே (நற்றிணை 110)", "D": "இருபது பாடல்கள்"}, "explanation": "சங்க இலக்கியத்தில் புலவர் போதனார் பாடியதாக நற்றிணையின் 110-ஆம் பாடல் மட்டுமே இன்று நமக்கக் கிடைத்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "How many surviving poems attributed to poet Bothanaar exist across the entire classical Sangam corpus?", "media_id": null}], "options": {"A": "Ten poems", "B": "Five poems", "C": "Only one single poem (Natrinai 110)", "D": "Twenty poems"}, "explanation": "Bothanaar is represented in the Sangam canon by this solitary gem (Natrinai 110)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 84, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 84",