{"id": "11th_tamil_u4_q070", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "pillaikkoodam_imagery", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பிள்ளைக்கூடம்’ கவிதையில் பள்ளிக்குச் செல்லும் குழந்தைகளை எதனுடன் இணைத்துக் கவிஞர் பாடுகிறார்?", "media_id": null}], "options": {"A": "இயந்திரங்கள்", "B": "வானத்துப் பறவைகள், வண்ணத்துப்பூச்சிகள் மற்றும் மலரும் மலர்கள்", "C": "போர் வீரர்கள்", "D": "வணிகர்கள்"}, "explanation": "குழந்தைகளைச் சிறகடிக்கும் பறவைகளோடும், வண்ணத்துப்பூச்சிகளோடும் ஒப்பிட்டு, அவர்களின் இயற்கை சுதந்திரம் பள்ளிகளில் பறிக்கப்படக் கூடாது என்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "With what organic imagery does R. Meenakshi metaphorically identify schoolchildren in 'Pillaikkoodam'?", "media_id": null}], "options": {"A": "Factory clockwork gears", "B": "Free soaring birds, dancing butterflies, and blossoming wildflowers", "C": "Martial soldiers", "D": "Mercantile traders"}, "explanation": "Children are envisioned as winged birds and blossoms blossoming in nature's embrace."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "