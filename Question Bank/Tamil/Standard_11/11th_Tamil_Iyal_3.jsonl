{"id": "11th_tamil_u3_q055", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kaavadichindu", "chapter_id": null, "topic_id": "annamalaiyar_poetic_style", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அண்ணாமலையாரின் காவடிச்சிந்துப் பாடல்களில் மிளிரும் முதன்மையான நயம் எது?", "media_id": null}], "options": {"A": "வெற்று உரைநடை நயம்", "B": "மறைபொருள் தத்துவம் மட்டுமே", "C": "சந்த நயம், எதுகை, மோனை மற்றும் துள்ளல் ஓசை", "D": "ஆங்கிலச் சொல் கலப்பு"}, "explanation": "காவடிச்சிந்தின் வரிகளில் எதுகை, மோனை நயங்களும், துள்ளும் சந்த தாள ஓசையும் அருவியெனப் பாய்வது தனித்துவமான சிறப்பாகும்."}, "en": {"blocks": [{"type": "text", "content": "What aesthetic literary qualities predominantly illuminate Annamalaiyar's Kaavadichindu verses?", "media_id": null}], "options": {"A": "Pedestrian flat prose", "B": "Esoteric dark riddles", "C": "Metric cadence, alliteration (Monai), rhyme (Ethugai), and buoyant galloping rhythm", "D": "Anglicized vocabulary"}, "explanation": "The verses sparkle with acoustic alliteration, internal rhymes, and an intoxicating galloping meter."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2