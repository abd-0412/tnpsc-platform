{"id": "11th_tamil_u3_q161", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "naakaakka_rhyme_scheme", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘யாகாவார் ஆயினும் நாகாக்க காவாக்கால் / சோகாப்பர் சொல்லிழுக்குப் பட்டு’ - இக்குறளின் எதுகை நயம் யாது?", "media_id": null}], "options": {"A": "யாகாவார் - நாகாக்க - சோகாப்பர் (இரண்டாம் எழுத்து ‘கா’ ஒன்றி வரும் எதுகை)", "B": "முரண் தொடை", "C": "இயைபுத் தொடை மட்டுமே", "D": "அளபெடை எதுகை மட்டுமே"}, "explanation": "முதல் அடியிலும் இரண்டாம் அடியிலும் இரண்டாம் எழுத்து நெடில் 'கா' என ஒன்றி வந்து எதுகை நயம் பயக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What metric rhyme (Ethugai) binds the lines of 'Yaakaavaaraayinum naakaakka soagaappar...'?", "media_id": null}], "options": {"A": "Yaakaavaar - Naakaakka - Soagaappar (Second letter 'kaa' rhyme agreement)", "B": "Antithetical Muran", "C": "Iyaibu rhyme solely", "D": "Alabedai rhyme only"}, "explanation": "The second consonant 'kaa' matches across metric feet establishing Ethugai harmony."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "pa