{"id": "11th_tamil_u3_q108", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "chellappa_theatre_efforts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சி. சு. செல்லப்பா நவீனத் தமிழ் நாடகத் துறைக்கு ஆற்றிய முக்கியப் பங்களிப்பு யாது?", "media_id": null}], "options": {"A": "சங்கீத நாடக சபாக்கள் அமைத்தது", "B": "தெருக்கூத்து கலைஞர்களைத் தடை செய்தது", "C": "திரைப்படத் தயாரிப்பு மட்டுமே", "D": "தமிழ் நாடக வடிவங்களை ஆராய்ந்து நவீன சோதனை நாடகங்களை முன்னெடுத்தமை"}, "explanation": "செல்லப்பா கதைகள் மட்டுமன்றி நாடகங்களையும் எழுதித் தமிழ் சோதனை நாடக அரங்கிற்குப் புதிய வீச்சை அளித்தார்."}, "en": {"blocks": [{"type": "text", "content": "What significant contribution did C. S. Chellappa make toward modern Tamil theatrical literature?", "media_id": null}], "options": {"A": "Forming commercial musical sabhas", "B": "Banning traditional folk street-plays", "C": "Film financing solely", "D": "Experimenting with avant-garde modern stage drama scripts and theatrical criticism"}, "explanation": "Chellappa wrote experimental plays and stimulated modern avant-garde theatrical thought."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Servi