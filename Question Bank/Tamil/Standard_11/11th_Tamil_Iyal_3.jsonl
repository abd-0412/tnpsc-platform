{"id": "11th_tamil_u3_q083", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "purananooru_commentators", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புறநானூற்றுக்குக் கிடைத்துள்ள பழைய உரை எந்தப் பாடல் வரை மட்டுமே கிடைத்துள்ளது?", "media_id": null}], "options": {"A": "முதல் 100 பாடல்கள்", "B": "முதல் 200 பாடல்கள்", "C": "முதல் 266 பாடல்கள் வரை மட்டுமே", "D": "400 பாடல்களுக்கும் முழுமையாகக் கிடைத்துள்ளது"}, "explanation": "புறநானூற்றுக்கு எழுதப்பட்ட பழைய உரையாசிரியரின் உரை 1 முதல் 266 பாடல்களுக்கு மட்டுமே கிடைத்துள்ளது; எஞ்சிய பாடல்களுக்குப் பழைய உரை கிடைக்கவில்லை."}, "en": {"blocks": [{"type": "text", "content": "Up to which poem does the ancient classical commentary (Pazhaya Urai) of Purananooru survive today?", "media_id": null}], "options": {"A": "First 100 poems only", "B": "First 200 poems only", "C": "First 266 poems only", "D": "Complete commentary for all 400 poems"}, "explanation": "The anonymous ancient classical commentary survives only for verses 1 through 266."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5