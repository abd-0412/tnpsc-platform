{"id": "11th_tamil_u3_q056", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kaavadichindu", "chapter_id": null, "topic_id": "chindu_folk_renaissance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியார் தமது தேசிய இயக்கப் பாடல்களுக்கு (எ.கா. வந்தே மாதரம், பாப்பா பாட்டு) எந்த நாட்டுப்புறப் பாவகையை விரும்பி எடுத்தாண்டார்?", "media_id": null}], "options": {"A": "கலிப்பா", "B": "வஞ்சிப்பா", "C": "நேரிசை வெண்பா", "D": "சிந்துப் பா வகை (காவடிச்சிந்து, பாரதியார் சிந்து)"}, "explanation": "அண்ணாமலையாரின் காவடிச்சிந்து ஏற்படுத்திய பெரும் தாக்கத்தால் பாரதியாரும் 'சிந்துக்குத் தந்தை' எனப் போற்றப்பட்டுச் சிந்துப் பாடல்களைப் பெருமளவில் பாடினார்."}, "en": {"blocks": [{"type": "text", "content": "Which vibrant folk lyrical genre inspired by Kaavadichindu was famously adopted by Mahakavi Subramania Bharati for his patriotic hymns?", "media_id": null}], "options": {"A": "Kalippa", "B": "Vanchippa", "C": "Nerisaivenba", "D": "Chindu meter (Bharathiyar Chindu / Kaavadichindu rhythms)"}, "explanation": "Mahakavi Bharati adopted the galloping Chindu meter, earning the epithet 'Sindhukku Thanthai'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 49, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 49", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Literature", "Bharathiyar Influence"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
