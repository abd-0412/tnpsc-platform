{"id": "11th_tamil_u3_q109", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "bull_thimil_hold", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிச்சி காரிக் காளையை அடக்கும் போது அதன் எந்தப் பகுதியைத் தன் நெஞ்சோடு அணைத்துப் பிடித்து அடக்கினான்?", "media_id": null}], "options": {"A": "காளையின் தசைப்பற்றுள்ள உயர்ந்த திமிலை (திமில்)", "B": "காளையின் முன்னங்காலை", "C": "காளையின் வாலை", "D": "காளையின் கூரிய கொம்புகளை"}, "explanation": "காளையின் கொம்புகளின் தாக்குதலில் இருந்து தப்பித்து, அதன் திமிலை நெஞ்சோடு இறுகப் பற்றிக் கொண்டு சில அடிகள் தாக்குப் பிடித்து அடக்கினான்."}, "en": {"blocks": [{"type": "text", "content": "Which anatomical part of the Kaari bull did Pitchi clamp against his chest to master the ferocious animal?", "media_id": null}], "options": {"A": "The prominent muscular dorsal hump (Thimil)", "B": "The front hooves", "C": "The tail tip", "D": "The sharp piercing horns"}, "explanation": "Pitchi clamped the bull's muscular dorsal hump to his chest, riding out its violent bucking."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-20