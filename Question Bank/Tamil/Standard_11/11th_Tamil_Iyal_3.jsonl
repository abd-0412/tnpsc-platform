{"id": "11th_tamil_u3_q196", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "unit_consolidation_pyq", "chapter_id": null, "topic_id": "unit_3_grand_synthesis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மேல்நிலை முதலாம் ஆண்டு தமிழ் இயல் 3 உணர்த்தும் மையப் பண்பாட்டுச் செய்தி யாது?", "media_id": null}], "options": {"A": "வணிக வளர்ச்சி மட்டுமே பண்பாடு", "B": "போர் வெற்றிகளே மனிதப் பெருமை", "C": "தனிமை வாழ்க்கையே மேன்மை", "D": "தமிழரின் மலை சார்ந்த தொன்மை இடப்பெயர் வேர்கள், ஏறுதழுவல் வீர மரபு, பிறர்க்கென வாழும் தன்னலமற்ற சான்றாண்மை அறம் மற்றும் நாவடக்கம் நிறைந்த வாழ்க்கை நெறி"}, "explanation": "இயல் 3 தமிழரின் தொன்மையான நில அடையாளங்களையும், வீர விளையாட்டு மரபையும், பிறர்க்கென வாழும் சங்க அறத்தையும் வாழ்வியல் குறளோடு இணைத்து விளக்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "What grand thematic synthesis anchors Unit 3 ('Peedu Pera Nil - Panbaadu') of Class 11 General Tamil?", "media_id": null}], "options": {"A": "Commercial greed is civilization", "B": "Imperial warfare is human glory", "C": "Reclusive isolationism", "D": "Ancient toponymic roots of Dravidian civilization, heroic bull-taming heritage, selfless altruistic virtue living for others, and disciplined self-restraint"}, "explanation": "Unit 3 synthesizes prehistoric roots, folk heroic heritage, and classical altruistic ethics."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "