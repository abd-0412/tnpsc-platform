{"id": "11th_tamil_u3_q087", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "ezhuthu_magazine", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழில் நவீன இலக்கிய மறுமலர்ச்சிக்கும், புதுக்கவிதை இயக்கத்திற்கும் வித்திட்ட சி. சு. செல்லப்பாவின் வரலாற்றுச் சிறப்புமிக்க இதழ் எது?", "media_id": null}], "options": {"A": "மணிக்கொடி", "B": "சரஸ்வதி", "C": "எழுத்து (1959)", "D": "தீபம்"}, "explanation": "சி. சு. செல்லப்பா 1959-இல் தொடங்கிய 'எழுத்து' இதழ் நவீனத் தமிழ் இலக்கிய விமர்சனத்திற்கும் புதுக்கவிதை இயக்கத்திற்கும் வழிகாட்டியாக அமைந்தது."}, "en": {"blocks": [{"type": "text", "content": "Which historic literary magazine founded by C. S. Chellappa catalyzed the modern Tamil poetry movement and literary criticism?", "media_id": null}], "options": {"A": "Manikkodi", "B": "Saraswathi", "C": "Ezhuthu (1959)", "D": "Deepam"}, "explanation": "'Ezhuthu', launched in 1959 by Chellappa, was the pioneering vanguard of modern Tamil free-verse poetry."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "re