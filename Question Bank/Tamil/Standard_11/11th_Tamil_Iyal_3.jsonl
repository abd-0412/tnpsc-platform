{"id": "11th_tamil_u3_q057", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "author_kurunthogai_27", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடப்பகுதியில் உள்ள குறுந்தொகையின் 27-ஆம் பாடலான ‘அம்ம வாழி தோழி...’ என்ற பாடலை இயற்றிய சங்கப் பெண்பாற் புலவர் யார்?", "media_id": null}], "options": {"A": "வெள்ளிவீதியார்", "B": "ஔவையார்", "C": "காக்கைப்பாடினியார்", "D": "நச்செள்ளையார்"}, "explanation": "குறுந்தொகையின் 27-ஆம் பாடலை இயற்றியவர் சங்க காலத் தலைசிறந்த பெண்பாற் புலவரான வெள்ளிவீதியார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who composed song 27 of Kurunthogai ('Amma vaazhi thozhi...') featured in the curriculum?", "media_id": null}], "options": {"A": "Velliveethiyaar", "B": "Avvaiyar", "C": "Kaakkaipaadiniyaar", "D": "Nachchellaiyaar"}, "explanation": "The celebrated Sangam poetess Velliveethiyaar composed verse 27 of Kurunthogai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 50, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 50", "url": null, "source_notes": null}, "previ