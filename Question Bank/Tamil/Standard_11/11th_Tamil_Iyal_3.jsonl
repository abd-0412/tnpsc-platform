{"id": "11th_tamil_u3_q093", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "father_ambasi_backstory", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிச்சியின் தந்தை அம்பாசி எவ்வாறு மரணமடைந்தார்?", "media_id": null}], "options": {"A": "இதே காரிக் காளையின் கொம்புக் குத்தப்பட்டு உயிரிழந்தார்", "B": "போரில் மரணமடைந்தார்", "C": "நோய்வாய்ப்பட்டு இறந்தார்", "D": "புலி தாக்கி இறந்தார்"}, "explanation": "கடந்த காலத்தில் இதே காரிக் காளையை அடக்க முயன்றபோது அதன் கூரிய கொம்புகளால் குத்தப்பட்டு பிச்சியின் தந்தை அம்பாசி களத்திலேயே மடிந்தார்."}, "en": {"blocks": [{"type": "text", "content": "How did Pitchi's father Ambasi meet his tragic demise in the past?", "media_id": null}], "options": {"A": "Fatally gored by the horns of this very same Kaari bull", "B": "Fell in military battle", "C": "Succumbed to epidemic illness", "D": "Killed by a wild tiger"}, "explanation": "Ambasi was fatally gored years earlier by the very same Kaari bull in the arena."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "refer