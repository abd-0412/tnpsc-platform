{"id": "11th_tamil_u3_q061", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "purananooru_author_182", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உண்டால் அம்ம இவ்வுலகம்...’ என்ற புறநானூற்றின் 182-ஆம் புகழ்பெற்ற பாடலை இயற்றியவர் யார்?", "media_id": null}], "options": {"A": "கடலுள் மாய்ந்த இளம்பெருவழுதி", "B": "பாண்டியன் நெடுஞ்செழியன்", "C": "கோப்பெருஞ்சோழன்", "D": "அதியமான்"}, "explanation": "புறநானூற்றின் 182-ஆம் பாடலைப் பாடியவர் பாண்டிய மன்னரான 'கடலுள் மாய்ந்த இளம்பெருவழுதி' ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who composed the legendary Purananooru hymn 182 ('Undaal amma ivvulagam...')?", "media_id": null}], "options": {"A": "Kadalul Maaintha Ilamperuvaluthi", "B": "Pandiyan Nedunchezhian", "C": "Kopperunchozhan", "D": "Athiyaman"}, "explanation": "It was composed by the noble Pandyan king-poet Kadalul Maaintha Ilamperuvaluthi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 51", "url": null, "source_notes": null}, "previ