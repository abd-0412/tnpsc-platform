{"id": "11th_tamil_u3_q101", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "chellappa_short_story_anthology", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சி. சு. செல்லப்பாவின் புகழ்பெற்ற முதல் சிறுகதைத் தொகுதி எது?", "media_id": null}], "options": {"A": "சரஸாவின் பொம்மை", "B": "மணிக்கொடி கதைகள்", "C": "அக்னிப் பிரவேசம்", "D": "ஒரு கிராமத்து நதி"}, "explanation": "சி. சு. செல்லப்பாவின் முதல் புகழ்பெற்ற சிறுகதைத் தொகுப்பு 'சரஸாவின் பொம்மை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which is the celebrated debut short-story anthology of C. S. Chellappa?", "media_id": null}], "options": {"A": "Sarasavin Bommai", "B": "Manikkodi Kathaigal", "C": "Agnipravesam", "D": "Oru Gramathu Nadhi"}, "explanation": "'Sarasavin Bommai' was Chellappa's distinguished first short-story collection."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 52", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name