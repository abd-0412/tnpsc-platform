{"id": "11th_tamil_u3_q158", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "kaakka_porulaa_adakkam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘காக்க பொருளா அடக்கத்தை ஆக்கம் / அதனினூஉங்கு இல்லை உயிர்க்கு’ - இக்குறளில் ‘பொருளா’ என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "பணம்", "B": "உறுதியான ஒரு விழுமிய செல்வமாக (முக்கியமாகக் கருதி)", "C": "பொருளற்றதாக", "D": "பொருட்களின் பட்டியல்"}, "explanation": "அடக்கத்தை ஒருவன் போற்றத்தக்க உறுதிப் பொருளாகக் கருதிப் பாதுகாக்க வேண்டும்; அதைவிடச் சிறந்த ஆக்கம் உயிருக்கு வேறு இல்லை."}, "en": {"blocks": [{"type": "text", "content": "In 'Kaakka porulaa adakkathai aakkam athaninooungu illai uyirkku', what does 'Porulaa' signify?", "media_id": null}], "options": {"A": "Currency coins", "B": "As a priceless, paramount moral treasure to be cherished", "C": "Worthless", "D": "A commodity catalogue"}, "explanation": "'Porulaa' means regarding self-restraint as a cherished, indispensable treasure."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 56", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Thirukkural", "Semantics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q159", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "oppuravu_definition_valluvar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளில் ‘ஒப்புரவு’ என்னும் சொல் எதனை உணர்த்துகிறது?", "media_id": null}], "options": {"A": "அரசருக்கு வரி கட்டுதல்", "B": "சமமானவர்களோடு மட்டும் பழகுதல்", "C": "உலக நடையறிந்து, சக மனிதர்களுக்குத் தன்னால் இயன்ற நன்மைகளைச் செய்து வாழ்தல் (சமூக நல்லிணக்க உதவி)", "D": "ஒப்பந்தம் செய்தல்"}, "explanation": "ஒப்புரவு என்பது உலக நடைமுறையை அறிந்து, தன்னலமற்று மக்களுக்கு நல்வழியில் உபகரித்து வாழும் உயர்ந்த சமூக அறமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What profound ethical concept is designated by the Valluvam term 'Oppuravu'?", "media_id": null}], "options": {"A": "Paying imperial tribute to monarchs", "B": "Associating solely with peers of equal social rank", "C": "Harmonious civic benevolence, living attuned to human needs and selflessly assisting fellow beings", "D": "Signing commercial treaties"}, "explanation": "'Oppuravu' signifies civic benevolence and social munificence tailored to uplift humanity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational S