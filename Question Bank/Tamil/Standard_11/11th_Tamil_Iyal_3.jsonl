{"id": "11th_tamil_u3_q005", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "prose_malai_idappeyargal", "chapter_id": null, "topic_id": "rivers_pakistan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாகிஸ்தானில் உள்ள எந்த ஆறுகள் முறையே கொற்கை மற்றும் வஞ்சி என்னும் தமிழ் இடப்பெயர்களைக் கொண்டுள்ளன?", "media_id": null}], "options": {"A": "கோர்கை, வாஞ்சி", "B": "நர்மதா, தபதி", "C": "சட்லஜ், செனாப்", "D": "கிருஷ்ணா, கோதாவரி"}, "explanation": "பாகிஸ்தானில் உள்ள பல சிற்றாறுகளும் சிற்றூர்களும் 'கோர்கை', 'வாஞ்சி' என்று அழைக்கப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Which river and place names in Pakistan directly reflect the Tamil port names Korkai and Vanji?", "media_id": null}], "options": {"A": "Korkai and Vanji", "B": "Narmada and Tapti", "C": "Sutlej and Chenab", "D": "Krishna and Godavari"}, "explanation": "Pakistan features riverways and localities precisely retaining the names Korkai and Vanji."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 47, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 47", "url": null, "source_notes": null}, "pre