{"id": "11th_tamil_u3_q103", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "chellappa_literary_criticism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சி. சு. செல்லப்பா ‘எழுத்து’ இதழின் வாயிலாக ஆழமாக முன்னெடுத்த இலக்கியப் பணி யாது?", "media_id": null}], "options": {"A": "திரைப்படப் பாடல்கள் எழுதுவது", "B": "அரசியல் பொதுக்கூட்டப் பேச்சுகள்", "C": "நவீன இலக்கியத் திறனாய்வு (Modern Literary Criticism)", "D": "சோதிடக் கணிப்புகள்"}, "explanation": "எழுத்து இதழின் மூலம் சி. சு. செல்லப்பா தீவிரமான, சமரசமற்ற இலக்கியத் திறனாய்வுக் கோட்பாடுகளைத் தமிழில் வளர்த்தெடுத்தார்."}, "en": {"blocks": [{"type": "text", "content": "What vital literary field did C. S. Chellappa vigorously champion and nurture through his magazine 'Ezhuthu'?", "media_id": null}], "options": {"A": "Cinema lyric ghost-writing", "B": "Partisan political soapbox speeches", "C": "Rigorous modern literary criticism", "D": "Astrological divinations"}, "explanation": "Chellappa championed serious, uncompromising modern literary criticism in Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "editi