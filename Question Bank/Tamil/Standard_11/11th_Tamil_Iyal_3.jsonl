{"id": "11th_tamil_u3_q020", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "prose_malai_idappeyargal", "chapter_id": null, "topic_id": "dravidian_languages_count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திராவிட மொழிக் குடும்பத்தில் உள்ள மொத்த மொழிகளின் எண்ணிக்கை தற்போதைய ஆய்வுகளின்படி எத்தனைக்கும் மேற்பட்டவை?", "media_id": null}], "options": {"A": "10 மொழிகள்", "B": "15 மொழிகள்", "C": "20 மொழிகள்", "D": "28-க்கும் மேற்பட்ட மொழிகள் (அண்மைய ஆய்வில் 30+)"}, "explanation": "திராவிட மொழிக் குடும்பத்தில் தமிழ், தெலுங்கு, கன்னடம், மலையாளம் உள்ளிட்ட 28-க்கும் மேற்பட்ட மொழிகள் உள்ளன."}, "en": {"blocks": [{"type": "text", "content": "According to modern comparative linguistics, how many languages belong to the Dravidian language family?", "media_id": null}], "options": {"A": "10 languages", "B": "15 languages", "C": "20 languages", "D": "More than 28 languages (30+ in recent classifications)"}, "explanation": "The Dravidian language family comprises more than 28 distinct tongues across three sub-branches."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 46, "chapter": null, "section"