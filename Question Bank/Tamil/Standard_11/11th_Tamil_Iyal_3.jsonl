{"id": "11th_tamil_u3_q059", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "kurunthogai_lines_compiler", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறுந்தொகையின் அடி எல்லை மற்றும் இந்நூலைத் தொகுத்தவர் யார்?", "media_id": null}], "options": {"A": "3 முதல் 6 அடி; கூடலூர் கிழார்", "B": "9 முதல் 12 அடி; உருத்திரசன்மன்", "C": "4 முதல் 8 அடி; பூரிக்கோ", "D": "13 முதல் 31 அடி; நக்கீரர்"}, "explanation": "குறுந்தொகை 4 அடி சிற்றெல்லையும் 8 அடி பேரெல்லையும் கொண்டது; இந்நூலைத் தொகுத்தவர் பூரிக்கோ ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "What are the line limits of Kurunthogai and who was its compiler?", "media_id": null}], "options": {"A": "3 to 6 lines; Koodaloor Kizhaar", "B": "9 to 12 lines; Uruthirasanman", "C": "4 to 8 lines; compiled by Poorikko", "D": "13 to 31 lines; Nakkeerar"}, "explanation": "Kurunthogai spans 4 to 8 lines and was compiled by Poorikko."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 50, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 50", "url": null, "sou