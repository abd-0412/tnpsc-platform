{"id": "11th_tamil_u3_q152", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "thirukkural_divisions_atharams", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல் 3-இல் இடம்பெற்றுள்ள அடக்கமுடைமை, ஒப்புரவறிதல், புகழ் ஆகிய மூன்று அதிகாரங்களும் திருக்குறளின் எந்தப் பாலில் அமைந்துள்ளன?", "media_id": null}], "options": {"A": "பொருட்பால்", "B": "காமத்துப்பால்", "C": "அரசியல்", "D": "அறத்துப்பால் (இல்லறவியல் / துறவறவியல்)"}, "explanation": "அடக்கமுடைமை, ஒப்புரவறிதல், புகழ் ஆகிய மூன்று அதிகாரங்களும் திருக்குறளின் முதல் பாலான அறத்துப்பாலில் அமைந்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Under which major division (Paal) of Thirukkural do the three chapters Adakkamudaimai, Oppuravarithal, and Pugazh fall?", "media_id": null}], "options": {"A": "Porutpaal", "B": "Kaamathuppaal", "C": "Arasiyal", "D": "Arathuppaal (Book of Virtue)"}, "explanation": "All three chapters belong to Arathuppaal (the Book of Virtue)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "11th Tamil, Unit 