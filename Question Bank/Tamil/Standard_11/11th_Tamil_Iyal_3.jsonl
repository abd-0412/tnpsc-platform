{"id": "11th_tamil_u3_q112", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "vaadivaasal_cinematic_adaptation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வாடிவாசல்’ குறுநாவல் தமிழ் இலக்கிய வரலாற்றில் எத்தகைய மைல்கல்லாகக் கருதப்படுகிறது?", "media_id": null}], "options": {"A": "ஒரு துப்பறியும் நாவல்", "B": "ஒரு மொழிபெயர்ப்புக் கதை", "C": "ஒரு புராண இதிகாசம்", "D": "மண்ணின் மணத்தையும், மாந்தர் வீரத்தையும், விலங்கு-மனித மோதலையும் இணைத்து எழுதப்பட்ட தமிழ் செவ்வியல் புனைகதை"}, "explanation": "மனித மனத்தின் ஆழம், கிராமத்து வீரம், விலங்குக்கும் மனிதனுக்கும் இடையிலான மரபுப் போராட்டம் ஆகியவற்றைச் சித்தரித்த தமிழ் செவ்வியல் குறுநாவல் வாடிவாசல் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What canonical status does the novella 'Vaadivaasal' occupy in Tamil literary history?", "media_id": null}], "options": {"A": "A detective suspense thriller", "B": "A translated European fairy tale", "C": "A mythological puranic fable", "D": "A classic milestone celebrating native soil realism, raw courage, and the primal conflict between man and beast"}, "explanation": "'Vaadivaasal' is an enduring classic embodying rural valor and primal man-versus-nature dynamics."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "