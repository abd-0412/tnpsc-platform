{"id": "11th_tamil_u3_q037", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kaavadichindu", "chapter_id": null, "topic_id": "chindu_song_lines", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சென்னிக்குள நகர் வாசன்... வளநாடுடைய / மருதப்ப பூபதி பாடும் சீலன்...’ - இவ்வடிகளில் குறிப்பிடப்படும் பூபதி யார்?", "media_id": null}], "options": {"A": "இருதயாலய மருதப்ப தேவர்", "B": "கட்டபொம்மன்", "C": "மருது சகோதரர்", "D": "வள்ளல் பாரி"}, "explanation": "சென்னிக்குளம் நகரில் வாழ்ந்த அண்ணாமலையார், தம் புரவலரான ஊற்றுமலை மருதப்ப பூபதியைப் போற்றி இப்பாடலைப் பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who is the patron chieftain extolled in the verse 'Chennikula nagar vaasan... Maruthappa boopathi paadum seelan'?", "media_id": null}], "options": {"A": "Iruthayalaya Maruthappa Devar", "B": "Kattabomman", "C": "Maruthu Brothers", "D": "Vallal Paari"}, "explanation": "The verse eulogizes the poet's patron, chieftain Maruthappa Devar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 49, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 49", "url": null,