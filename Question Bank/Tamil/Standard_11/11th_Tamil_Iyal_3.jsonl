{"id": "11th_tamil_u3_q001", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "prose_malai_idappeyargal", "chapter_id": null, "topic_id": "author_intro", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மலை இடப்பெயர்கள்: ஓர் ஆய்வு’ என்னும் உரைநடைக் கட்டுரையை எழுதிய ஆய்வாளர் யார்?", "media_id": null}], "options": {"A": "ஆர். பாலகிருஷ்ணன் இ.ஆ.ப.", "B": "ம. பொ. சிவஞானம்", "C": "மு. வரதராசனார்", "D": "தேவநேயப் பாவாணர்"}, "explanation": "‘மலை இடப்பெயர்கள்: ஓர் ஆய்வு’ என்ற கட்டுரை இந்திய ஆட்சிப் பணி அதிகாரியும் மானுடவியல் ஆய்வாளருமான ஆர். பாலகிருஷ்ணன் அவர்களால் எழுதப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Who authored the research essay 'Mountain Place Names: A Study'?", "media_id": null}], "options": {"A": "R. Balakrishnan IAS", "B": "M. P. Sivagnanam", "C": "Mu. Varadarajan", "D": "Devaneya Pavanar"}, "explanation": "The research paper 'Mountain Place Names: A Study' was authored by retired IAS officer and researcher R. Balakrishnan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 46, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 46", "url": null,