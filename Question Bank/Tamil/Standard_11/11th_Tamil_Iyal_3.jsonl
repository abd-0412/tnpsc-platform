{"id": "11th_tamil_u3_q058", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "velliveethiyaar_songs_count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க இலக்கியங்களில் புலவர் வெள்ளிவீதியார் பாடிய மொத்தப் பாடல்களின் எண்ணிக்கை எத்தனை?", "media_id": null}], "options": {"A": "ஐந்து பாடல்கள்", "B": "பதின்மூன்று பாடல்கள் (13 பாடல்கள்)", "C": "இருபது பாடல்கள்", "D": "முப்பது பாடல்கள்"}, "explanation": "சங்க இலக்கியத்தில் வெள்ளிவீதியார் பாடியதாக நற்றிணை, குறுந்தொகை, அகநானூறு உள்ளிட்ட நூல்களில் 13 பாடல்கள் உள்ளன."}, "en": {"blocks": [{"type": "text", "content": "How many total poems composed by poetess Velliveethiyaar survive across Sangam anthologies?", "media_id": null}], "options": {"A": "Five poems", "B": "Thirteen poems (13 verses)", "C": "Twenty poems", "D": "Thirty poems"}, "explanation": "Velliveethiyaar authored 13 surviving poems across the Sangam Akam corpus."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 50, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 50", "url": null, "source_not