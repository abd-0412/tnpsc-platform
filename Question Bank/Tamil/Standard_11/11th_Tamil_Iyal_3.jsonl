{"id": "11th_tamil_u3_q075", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "porunmozhik_kanchi_definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பொருண்மொழிக் காஞ்சி’ துறையின் இலக்கணம் யாது?", "media_id": null}], "options": {"A": "மன்னனின் வீரத்தைப் பாடுவது", "B": "பரிசில் வேண்டி நிற்பது", "C": "மனித வாழ்க்கைக்கு நன்மை பயக்கும் நல் அறங்களை நிலையாக எடுத்துரைப்பது", "D": "இறந்த வீரர்க்கு நடுகல் நடுவது"}, "explanation": "மக்களுக்கு நல்வழிகாட்டும் நீதிகளையும் அறவுரைகளையும் தொகுத்துரைப்பதே 'பொருண்மொழிக் காஞ்சி' துறையாகும்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the classical definition of 'Porunmozhik Kanchi' Thurai?", "media_id": null}], "options": {"A": "Eulogizing royal martial victories", "B": "Begging for royal gifts", "C": "Articulating timeless moral verities, virtue, and ethical wisdom for the upliftment of human society", "D": "Erecting hero stones for martyrs"}, "explanation": "'Porunmozhik Kanchi' designates ethical instruction guiding humanity toward noble living."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year