{"id": "11th_tamil_u3_q070", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "kurunthogai_first_published", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எட்டுத்தொகை நூல்களுள் முதன்முதலில் தொகுக்கப்பட்டதாகக் கருதப்படும் நூல் எது?", "media_id": null}], "options": {"A": "நற்றிணை", "B": "குறுந்தொகை", "C": "அகநானூறு", "D": "ஐங்குறுநூறு"}, "explanation": "‘நல்ல குறுந்தொகை’ எனச் சிறப்பிக்கப்படும் குறுந்தொகையே எட்டுத்தொகை நூல்களுள் முதன்முதலாகத் தொகுக்கப்பட்ட நூலாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which anthology among the Ettuthogai corpus is traditionally considered the very first to be compiled?", "media_id": null}], "options": {"A": "Natrinai", "B": "Kurunthogai", "C": "Akananooru", "D": "Aingurunooru"}, "explanation": "Kurunthogai is widely regarded as the first Sangam work to be anthologized."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 50, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 50", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false,