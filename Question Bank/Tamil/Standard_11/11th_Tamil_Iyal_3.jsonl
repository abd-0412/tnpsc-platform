{"id": "11th_tamil_u3_q164", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "thirukkural_english_poet", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளை ஆங்கிலத்தில் முழுமையாக செய்யுள் வடிவில் மொழிபெயர்த்த ஜி. யு. போப் அவர்கள் அதன் பெருமையை என்னவென்று போற்றினார்?", "media_id": null}], "options": {"A": "கிரேக்கக் காவியம் போன்றது", "B": "மன்னர்களின் வரலாறு", "C": "ஒரு வட்டார நூல்", "D": "தமிழ் மொழியின் உயர்ந்த அறக் கருவூலம் (A crown jewel of universal ethics)"}, "explanation": "ஜி. யு. போப் திருக்குறளை உலக மாந்தர் அனைவருக்கும் பொதுவான உயர்ந்த அறக் கருவூலம் எனப் போற்றி ஆங்கிலத்தில் மொழிபெயர்த்தார்."}, "en": {"blocks": [{"type": "text", "content": "How did Rev. G. U. Pope characterize the monumental status of Thirukkural while rendering it into English verse?", "media_id": null}], "options": {"A": "Equivalent to Homeric battle epics", "B": "Court chronicle of kings", "C": "Regional ethnic folklore", "D": "A crown jewel of universal ethics and humanity's common heritage"}, "explanation": "G. U. Pope hailed it as a peerless world classic of ethical literature."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Co