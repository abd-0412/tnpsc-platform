{"id": "11th_tamil_u3_q076", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "summary_two_poems", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறுந்தொகை 27 மற்றும் புறநானூறு 182 ஆகிய இரு பாடல்களும் முறையே எவற்றை விவரிக்கின்றன?", "media_id": null}], "options": {"A": "இரண்டும் போர்ச் செய்திகளை மட்டுமே விவரிக்கின்றன", "B": "இரண்டும் இயற்கை அழகை மட்டுமே விவரிக்கின்றன", "C": "இரண்டும் வாணிபத்தை விவரிக்கின்றன", "D": "குறுந்தொகை தனிமனித அக உணர்வின் (காதலின்) ஆழத்தையும், புறநானூறு உலகளாவிய பொதுநல அறத்தின் (சமூக அறத்தின்) உன்னதத்தையும் விவரிக்கின்றன"}, "explanation": "குறுந்தொகை அகத்தின் காதல் தவிப்பையும், புறநானூறு புறத்தின் சமூக அறத்தையும் (அகம் + புறம்) இணைத்து விளக்குகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What complementary dimensions of Sangam civilization do Kurunthogai 27 and Purananooru 182 portray together?", "media_id": null}], "options": {"A": "Both portray military campaigns exclusively", "B": "Both describe landscape flora solely", "C": "Both chronicle trade commerce", "D": "Kurunthogai portrays the depth of intimate subjective interiority (Akam love), while Purananooru champions universal altruistic ethics (Puram virtue)"}, "explanation": "They present the quintessential Akam (interior love) and Puram (public virtue) balance of Sangam culture."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 51", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Poetry", "Akam-Puram Synthesis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q077", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "purananooru_first_print_year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புறநானூறு நூலை முதன்முதலில் சுவடியிலிருந்து பதிப்பித்து அச்சேற்றிய தமிழறிஞர் மற்றும் பதிப்பிக்கப்பட்ட ஆண்டு எது?", "media_id": null}], "options": {"A": "உ. வே. சாமிநாதையர் (1894)", "B": "சி. வை. தாமோதரம்பிள்ளை (1881)", "C": "ஆறுமுக நாவலர் (1860)", "D": "பரிதிமாற்கலைஞர் (1901)"}, "explanation": "புறநானூற்றை ஏட்டுச் சுவடியிலிருந்து முழுமையாக ஆராய்ந்து முதன்முதலில் 1894-இல் அச்சேற்றி வெளியிட்டவர் தமிழ்த்தாத்தா உ. வே. சாமிநாதையர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Which eminent scholar first collated palm-leaf manuscripts and published Purananooru in print, and in which year?", "media_id": null}], "options": {"A": "U. V. Swaminatha Iyer (1894)", "B": "C. W. Damodaram Pillai (1881)", "C": "Arumuga Navalar (1860)", "D": "Parithimaar Kalaignar (1901)"}, "explanation": "U. V. Swaminatha Iyer published the definitive first print edition of Purananooru in 1894."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 51", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Publishing History", "U.V. Swaminatha Iyer"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q078", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "meaning_ayarvilar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உண்டால் அம்ம இவ்வுலகம்...’ பாடலில் வரும் ‘அயர்விலர்’ என்னும் சொல்லின் பொருள் யாது?", "media_id": null}], "options": {"A": "அஞ்சாதவர்", "B": "சோம்பல் / சோர்வு இல்லாதவர்", "C": "பகைமை அற்றவர்", "D": "அறிவில்லாதவர்"}, "explanation": "அயர்வு என்றால் சோர்வு அல்லது சோம்பல். அயர்விலர் என்றால் சோம்பலின்றி சுறுசுறுப்புடன் நற்பணிகளை மேற்கொள்பவர் என்று பொருள்."}, "en": {"blocks": [{"type": "text", "content": "In the hymn 'Undaal amma ivvulagam', what is the exact meaning of the term 'Ayarvilar'?", "media_id": null}], "options": {"A": "Those without fear", "B": "Those devoid of sloth, lethargy, or despondency", "C": "Those without enmity", "D": "Ignorant persons"}, "explanation": "'Ayarvilar' signifies people free from sloth, laziness, or fatigue in virtuous action."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page