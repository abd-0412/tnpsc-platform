{"id": "11th_tamil_u3_q063", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "purananooru_thinai_turai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உண்டால் அம்ம இவ்வுலகம்...’ பாடலின் திணையும் துறையும் எவை?", "media_id": null}], "options": {"A": "வெட்சித் திணை; பாணாற்றுப்படை", "B": "வாகைத் திணை; அரசவாகை", "C": "பொதுவியல் திணை; பொருண்மொழிக் காஞ்சித் துறை", "D": "காஞ்சித் திணை; பெருங்காஞ்சி"}, "explanation": "இப்பாடல் பொதுவியல் திணையிலும், மக்களுக்கு உறுதியான உலக அறங்களை அறிவுறுத்தும் 'பொருண்மொழிக் காஞ்சி' துறையிலும் அமைந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "What are the Thinai and Thurai classifications of Purananooru verse 182?", "media_id": null}], "options": {"A": "Vetchi Thinai; Paanaatruppadai", "B": "Vaagai Thinai; Arasavaagai", "C": "Pothuviyal Thinai; Porunmozhik Kanchi Thurai", "D": "Kanchi Thinai; Perunkanchi"}, "explanation": "The poem is set in Pothuviyal Thinai under Porunmozhik Kanchi Thurai (moral instruction)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "sect