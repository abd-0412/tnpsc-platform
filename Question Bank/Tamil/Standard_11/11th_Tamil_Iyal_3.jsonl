{"id": "11th_tamil_u3_q017", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "prose_malai_idappeyargal", "chapter_id": null, "topic_id": "balakrishnan_poetry_books", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆர். பாலகிருஷ்ணன் அவர்கள் எழுதிய கவிதை நூல்களுள் ஒன்று எது?", "media_id": null}], "options": {"A": "சிறகுக்குள் வைத்த நெருப்பு", "B": "அவன் அவள் அது", "C": "நிலவுப்பூ", "D": "கருப்பு மலர்கள்"}, "explanation": "‘சிறகுக்குள் வைத்த நெருப்பு’ என்பது ஆர். பாலகிருஷ்ணன் அவர்களின் புகழ்பெற்ற கவிதைத் தொகுப்பாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following poetry collections was penned by R. Balakrishnan IAS?", "media_id": null}], "options": {"A": "Siragukkul Vaitha Neruppu", "B": "Avan Aval Athu", "C": "Nilavuppoo", "D": "Karuppu Malargal"}, "explanation": "'Siragukkul Vaitha Neruppu' is an acclaimed poetry anthology authored by R. Balakrishnan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 46, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 46", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false,