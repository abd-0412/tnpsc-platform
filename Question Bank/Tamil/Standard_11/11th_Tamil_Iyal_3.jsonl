{"id": "11th_tamil_u3_q157", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "cherivarinthu_seermai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘செறிவறிந்து சீர்மை பயக்கும் அறிவறிந்து / ஆற்றின் அடங்கப் பெறின்’ - எதனை அறிந்து அடங்கி வாழ்பவனுக்குப் பெருமை சேரும்?", "media_id": null}], "options": {"A": "அறிய வேண்டிய நல்லறிவை அறிந்து, நல்வழியில் தன் புலன்களை அடக்கி வாழ்பவனுக்கு", "B": "போர்க் கலையை அறிந்தவனுக்கு", "C": "சூதாட்டத்தை அறிந்தவனுக்கு", "D": "வணிகப் பாதையை அறிந்தவனுக்கு"}, "explanation": "நன்மையான அறிவை உணர்ந்து, நன்னெறி வழியில் அடங்கி வாழ்வோரின் அடக்கமே அவனுக்குப் பெரும் நன்மையும் பெருமையும் சேர்க்கும்."}, "en": {"blocks": [{"type": "text", "content": "What brings radiant honor and dignity to an individual in 'Cherivarinthu seermai payakkum...'?", "media_id": null}], "options": {"A": "Knowing the true knowledge of virtue and walking the path of disciplined self-restraint", "B": "Mastering martial archery", "C": "Knowing dice gambling", "D": "Mastering sea trade routes"}, "explanation": "True knowledge pursued with self-discipline yields lasting glory and peerless nobility."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook an