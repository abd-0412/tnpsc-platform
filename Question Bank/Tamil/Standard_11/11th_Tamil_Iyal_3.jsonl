{"id": "11th_tamil_u3_q106", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "chellappa_freedom_struggle", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சி. சு. செல்லப்பா காந்தியடிகளின் கொள்கைகளால் ஈர்க்கப்பட்டு எந்த தேசிய இயக்கத்தில் ஈடுபட்டு சிறை சென்றார்?", "media_id": null}], "options": {"A": "சுயமரியாதை இயக்கம்", "B": "இந்திய விடுதலைப் போராட்டம் (வெள்ளையனே வெளியேறு இயக்கம்)", "C": "ரஷ்ய புரட்சி இயக்கம்", "D": "பிரெஞ்சுப் புரட்சி"}, "explanation": "சி. சு. செல்லப்பா காந்திய வழியில் இந்திய விடுதலைப் போராட்டத்தில் தீவிரம் காட்டி சிறைவாசம் அனுபவித்த தியாகி ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Inspired by Mahatma Gandhi, in which national movement did C. S. Chellappa actively participate, courting imprisonment?", "media_id": null}], "options": {"A": "Self-Respect movement", "B": "Indian National Freedom Struggle (Quit India Movement)", "C": "Russian Revolution", "D": "French Revolution"}, "explanation": "Chellappa was a passionate freedom fighter who suffered imprisonment during the Quit India struggle."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term":