{"id": "11th_tamil_u3_q107", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "pyq_chellappa_works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC] ‘சுதந்திர தாகம்’ என்னும் புதினத்திற்காக சி. சு. செல்லப்பாவிற்கு எந்த விருது வழங்கப்பட்டது?", "media_id": null}], "options": {"A": "ஞானபீட விருது", "B": "தாமரைத்திரு விருது", "C": "சாகித்திய அகாதெமி விருது", "D": "சரஸ்வதி சம்மான் விருது"}, "explanation": "‘சுதந்திர தாகம்’ புதினத்திற்காக சி. சு. செல்லப்பாவிற்கு சாகித்திய அகாதெமி விருது (2001) வழங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC] Which prestigious literary award was conferred upon C. S. Chellappa for his novel 'Suthanthira Dhaagam'?", "media_id": null}], "options": {"A": "Jnanpith Award", "B": "Padma Shri", "C": "Sahitya Akademi Award", "D": "Saraswati Samman"}, "explanation": "He was awarded the Sahitya Akademi Award for 'Suthanthira Dhaagam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 52", "url": null, "so