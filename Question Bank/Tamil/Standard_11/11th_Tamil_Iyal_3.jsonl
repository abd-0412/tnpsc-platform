{"id": "11th_tamil_u3_q094", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "jallikattu_sacred_rule", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஏறுதழுவுதலில் தமிழர்களின் அறம் சார்ந்த வீர விதிமுறை யாது?", "media_id": null}], "options": {"A": "காளையைக் கயிறுகளால் கட்டி இழுப்பது", "B": "காளையின் கொம்புகளையோ வாலையோ பிடிக்காமல், அதன் திமிலை மட்டுமே பற்றித் தழுவி அடக்குதல்", "C": "காளையைக் கூரிய ஆயுதங்களால் தாக்குவது", "D": "காளையை வீழ்த்த மருந்துகளைப் பயன்படுத்துவது"}, "explanation": "தமிழர் ஏறுதழுவலில் மாட்டின் கொம்பையோ வாலையோ தொடாமல் அதன் திமிலை மட்டுமே நெஞ்சோடு தழுவி அடக்குவதே வீர மரபாகும்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the cardinal, ethical rule of engagement in traditional Tamil bull-taming (Eru Thazhuvuthal)?", "media_id": null}], "options": {"A": "Tying the bull with heavy ropes", "B": "Grasping only the muscular hump (Thimil) in a firm embrace without touching the horns or twisting the tail", "C": "Striking the beast with iron weapons", "D": "Sedating the bull with narcotics"}, "explanation": "Traditional ethos strictly mandates embracing only the hump without harming horns or tail."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 52", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Culture", "Eru Thazhuvuthal Ethics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q095", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "definition_vaadivaasal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வாடிவாசல்’ என்பதன் சரியான பொருள் விளக்கம் யாது?", "media_id": null}], "options": {"A": "ஊரின் நுழைவாயில்", "B": "கோவில் கோபுர வாசல்", "C": "ஜல்லிக்கட்டுக் காளைகள் களத்திற்குள் சீறிப் பாய்ந்து வரும் குறுகிய தடுப்பு வழி/வாசல்", "D": "அரண்மனை வாயில்"}, "explanation": "ஜல்லிக்கட்டுப் பந்தயத்தில் காளைகளை ஒவ்வொன்றாக அவிழ்த்து விடும் குறுகிய மரப் பலகை அடைப்பு வாயிலுக்கு 'வாடிவாசல்' என்று பெயர்."}, "en": {"blocks": [{"type": "text", "content": "What is the precise architectural-functional definition of 'Vaadivaasal'?", "media_id": null}], "options": {"A": "Village gateway", "B": "Temple tower entrance", "C": "The narrow gated chute or barricaded portal through which spirited bulls surge out into the open arena", "D": "Palace gate"}, "explanation": "Vaadivaasal is the narrow gated chute through which bulls explode into the sporting arena."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 52", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Culture", "Terminology"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q096", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "manikkodi_movement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சி. சு. செல்லப்பா எந்த வரலாற்றுச் சிறப்புமிக்க இலக்கியக் குழுவினரோடு நெருங்கிய தொடர்புடைய எழுத்தாளர்?", "media_id": null}], "options": {"A": "வானம்பாடி இயக்கம்", "B": "மறுமலர்ச்சி சங்கம்", "C": "திராவிட இயக்க எழுத்தாளர்கள்", "D": "மணிக்கொடி கால எழுத்தாளர்கள் (மணிக்கொடி பரம்பரை)"}, "explanation": "சி. சு. செல்லப்பா மணிக்கொடி இதழில் சிறுகதைகள் எழுதி இலக்கிய உலகிற்கு அறிமுகமான மணிக்கொடி பரம்பரை எழுத்தாளர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "To which legendary literary vanguard movement did C. S. Chellappa historically belong?", "media_id": null}], "options": {"A": "Vaanambadi movement", "B": "Marumalarichi Sangam", "C": "Dravidian writers", "D": "The Manikkodi Generation of literary trailblazers"}, "explanation": "Chellappa was an illustrious stalwart of the landmark Manikkodi literary renaissance."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 52", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Literature", "Manikkodi"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q097", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "chellappa_other_works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சி. சு. செல்லப்பா எழுதிய நூல்களுள் ‘ஜீவனாம்சம்’ என்பது எவ்வகை இலக்கியப் படைப்பு?", "media_id": null}], "options": {"A": "குறுநாவல்", "B": "நாடகம்", "C": "கவிதை நூல்", "D": "வரலாற்று உரைநடை"}, "explanation": "‘வாடிவாசல்’ போலவே 'ஜீவனாம்சம்' என்பதும் சி. சு. செல்லப்பாவின் புகழ்பெற்ற முற்போக்கான குறுநாவலாகும்."}, "en": {"blocks": [{"type": "text", "content": "What literary genre does C. S. Chellappa's critically acclaimed work 'Jeevanamsam' represent?", "media_id": null}], "options": {"A": "Novella (Short Novel)", "B": "Drama play", "C": "Poetry collection", "D": "Historical biography"}, "explanation": "'Jeevanamsam' is an acclaimed realistic novella authored by Chellappa."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 52", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Literature", "Genre Analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q098", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "climax_of_vaadivaasal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வாடிவாசலில் காரிக் காளையை அடக்கிய பிறகு பிச்சி காட்டிய பண்பு யாது?", "media_id": null}], "options": {"A": "காளையைக் கொன்று பழிதீர்த்தல்", "B": "காளையைத் தன் கட்டுப்பாட்டுக்குள் கொண்டுவந்து அடக்கிவிட்டு, அதற்கு எவ்வித காயமும் இன்றி விடுவித்து மரியாதை செலுத்துதல்", "C": "மைனரின் காலில் விழுந்து பணம் பெறுதல்", "D": "காளையை ஊருக்குள் இழுத்துச் சென்று விற்றல்"}, "explanation": "பிச்சி தன் தந்தையைக் கொன்ற காளையை வஞ்சம் தீர்த்து அழிக்காமல், வீரத் தழுவலால் அடக்கி மாட்டின் பெருமையையும் தன் மரபு வீரத்தையும் நிலைநிறுத்தினான்."}, "en": {"blocks": [{"type": "text", "content": "What noble sportsmanship and virtue does Pitchi demonstrate after subduing the lethal Kaari bull?", "media_id": null}], "options": {"A": "Slaughtering the beast in vendetta", "B": "Mastering the bull through pure skill, releasing it uninjured, and honoring the noble spirit of the contest", "C": "Groveling before the landlord for prize money", "D": "Auctioning off the captured bull"}, "explanation": "Pitchi triumphs purely through chivalry, subduing the beast without malice or cruelty."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 52", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Supplementary", "Themes"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q099", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "jallikattu_sangam_literature_root", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஏறுதழுவுதல் குறித்த மிக விரிவான காட்சி வர்ணனைகள் சங்க இலக்கியத்தில் எந்த நூலில் பெருமளவில் காணப்படுகின்றன?", "media_id": null}], "options": {"A": "நற்றிணை", "B": "குறுந்தொகை", "C": "கலித்தொகை (முல்லைக்கலி)", "D": "ஐங்குறுநூறு"}, "explanation": "கலித்தொகையின் முல்லைக்கலிப் பாடல்களில் (பாடியவர் சோழன் நல்லுருத்திரன்) ஏறுதழுவுதல் குறித்த மெய்சிலிர்க்கும் வர்ணனைகள் நிறைந்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "In which classical Sangam anthology do we find elaborate, vivid descriptions of ancient bull-taming contests?", "media_id": null}], "options": {"A": "Natrinai", "B": "Kurunthogai", "C": "Kalithogai (Mullaikkali)", "D": "Aingurunooru"}, "explanation": "Mullaikkali in Kalithogai contains the most vivid eyewitness accounts of Sangam bull-taming."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": "11th Tami