{"id": "11th_tamil_u3_q153", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "adakkam_chelvarkke_chelvam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘எல்லார்க்கும் நன்றாம் பணிதல் அவருள்ளும் / செல்வர்க்கே செல்வம் தகைத்து’ - பணிவு யாருக்கு மேலும் ஒரு தனிப்பெரும் செல்வமாகத் திகழ்கிறது?", "media_id": null}], "options": {"A": "செல்வம் படைத்த செல்வந்தர்களுக்கு", "B": "ஏழைகளுக்கு", "C": "நாடோடிகளுக்கு", "D": "குழந்தைகளுக்கு"}, "explanation": "பணிவுடைமை எல்லோருக்கும் நன்மையைத் தரும்; அதிலும் குறிப்பாகச் செல்வம் உள்ளவர்க்கு அது செல்வத்தினும் சிறந்த அணிகலனாகும்."}, "en": {"blocks": [{"type": "text", "content": "According to 'Ellaarkkum nanraam panithal avarullum chelvarkkae chelvam thagaithu', to whom does humility serve as an unmatched jewel?", "media_id": null}], "options": {"A": "To wealthy individuals possessing great fortune", "B": "To destitute mendicants", "C": "To nomads", "D": "To young infants"}, "explanation": "Humility is good for all, but in the wealthy, it shines as an unparalleled crowning glory."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 56", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Thirukkural", "Humility"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q154", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "pugazhpada_vaazhaathaar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘புகழ்பட வாழாதார் தந்நோவார் தம்மை / இகழ்வாரை நோவது எவன்’ - புகழ் இல்லாமல் வாழ்பவர் யாரை நொந்து கொள்ளக் கூடாது?", "media_id": null}], "options": {"A": "மன்னனை", "B": "தன்னை இகழ்ந்து பேசுபவர்களை (தம்மையே நொந்து கொள்ள வேண்டும்)", "C": "கடவுளை", "D": "உறவினர்களை"}, "explanation": "புகழுடன் வாழ முடியாதவர்கள் தம்மைப் பழிப்பவர்களைக் குறை கூறாமல், புகழுடன் வாழத் தவறிய தங்களையே நொந்து கொள்ள வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "In 'Pugazhpada vaazhaathaar than noavaar...', who should those living without renown NOT blame?", "media_id": null}], "options": {"A": "The reigning monarch", "B": "Those who deride or criticize them (they must blame only themselves)", "C": "The gods", "D": "Their kinfolk"}, "explanation": "Those who fail to live renowned have only themselves to blame, not those who censure them."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "s