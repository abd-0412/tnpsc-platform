{"id": "11th_tamil_u3_q104", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "jallikattu_other_names", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழகத்தின் பல்வேறு வட்டாரங்களில் ஏறுதழுவுதலுக்கு வழங்கப்படும் பெயர்களுள் பொருந்தாதது எது?", "media_id": null}], "options": {"A": "மஞ்சுவிரட்டு", "B": "மாடு பிடித்தல்", "C": "பொல்லெருது பிடித்தல்", "D": "குதிரையேற்றம்"}, "explanation": "மஞ்சுவிரட்டு, மாடு பிடித்தல், ஏறுதழுவல், சல்லிக்கட்டு, எருதுகட்டு போன்றவை ஏறுதழுவலின் பெயர்கள்; குதிரையேற்றம் என்பது முற்றிலும் வேறுபட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which of the following is NOT an authentic regional variant name for the bull-taming festival in Tamil Nadu?", "media_id": null}], "options": {"A": "Manjuvirattu", "B": "Maadu Pidithal", "C": "Polleruthu Pidithal", "D": "Horse Equestrian Riding (Kuthiraiyetram)"}, "explanation": "Horse riding is a separate equestrian activity unrelated to cattle taming."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": "11th 