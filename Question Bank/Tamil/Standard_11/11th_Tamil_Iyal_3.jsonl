{"id": "11th_tamil_u3_q002", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "prose_malai_idappeyargal", "chapter_id": null, "topic_id": "dravidian_base_indus", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிந்துவெளி நாகரிகத்தின் திராவிட அடித்தளத்தை நிறுவியதில் முதன்மைப் பங்கு வகிக்கும் ஆர். பாலகிருஷ்ணனின் முக்கிய ஆய்வு நூல் எது?", "media_id": null}], "options": {"A": "தமிழர் மானிடவியல்", "B": "சிந்துவெளிப் பண்பாட்டின் திராவிட அடித்தளம்", "C": "பண்டைத் தமிழகம்", "D": "தொல்பழங்காலம்"}, "explanation": "ஆர். பாலகிருஷ்ணன் அவர்கள் சிந்துவெளி நாகரிகத்திற்கும் திராவிடப் பண்பாட்டிற்கும் உள்ள தொடர்பை 'சிந்துவெளிப் பண்பாட்டின் திராவிட அடித்தளம்' என்னும் விரிவான நூலில் நிறுவியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which magnum opus research work by R. Balakrishnan establishes the Dravidian substratum of the Indus Valley Civilization?", "media_id": null}], "options": {"A": "Anthropology of Tamils", "B": "Dravidian Substratum of the Indus Civilization", "C": "Ancient Tamil Land", "D": "Prehistoric Age"}, "explanation": "His landmark monograph is titled 'Dravidian Substratum of the Indus Civilization'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpo