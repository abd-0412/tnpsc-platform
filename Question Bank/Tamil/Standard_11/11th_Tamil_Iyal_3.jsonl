{"id": "11th_tamil_u3_q036", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kaavadichindu", "chapter_id": null, "topic_id": "author_lifespan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சென்னிக்குளம் அண்ணாமலையார் வாழ்ந்த காலம் மற்றும் அவரது ஆயுள் யாது?", "media_id": null}], "options": {"A": "பதினெட்டாம் நூற்றாண்டு; 80 ஆண்டுகள்", "B": "பதினைந்தாம் நூற்றாண்டு; 65 ஆண்டுகள்", "C": "பன்னிரண்டாம் நூற்றாண்டு; 40 ஆண்டுகள்", "D": "பத்தொன்பதாம் நூற்றாண்டு; இளமையிலேயே (30 ஆண்டுகளுக்கும் குறைவாக) மறைந்தவர்"}, "explanation": "அண்ணாமலையார் 19-ஆம் நூற்றாண்டில் வாழ்ந்து, இளம்பருவத்திலேயே மறைந்த அற்புதமான சந்தக் கவிஞர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "In which century did Chennikulam Annamalaiyar live and what was notable about his lifespan?", "media_id": null}], "options": {"A": "18th century; lived 80 years", "B": "15th century; lived 65 years", "C": "12th century; lived 40 years", "D": "19th century; passed away at an extraordinarily young age (under 30)"}, "explanation": "Annamalaiyar flourished in the 19th century and had an astonishingly brief lifespan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_