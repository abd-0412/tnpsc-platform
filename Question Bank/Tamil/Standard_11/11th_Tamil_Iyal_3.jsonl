{"id": "11th_tamil_u3_q004", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "prose_malai_idappeyargal", "chapter_id": null, "topic_id": "rivers_afghanistan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆப்கானிஸ்தானில் உள்ள எந்த இரு ஆறுகளின் பெயர்கள் தமிழின் 'காவிரி', 'பொருநை' ஆறுகளை நினைவூட்டுகின்றன?", "media_id": null}], "options": {"A": "சிந்து, ஜீலம்", "B": "ராவி, பியாஸ்", "C": "கங்கை, யமுனை", "D": "காப்ரி (காவிரி), போருனே (பொருநை)"}, "explanation": "ஆப்கானிஸ்தானில் 'காவிரி', 'பொருநை' என்னும் பெயர்களோடு அச்சுப்பிசகாமல் ஒத்திருக்கும் காப்ரி, போருனே ஆறுகள் ஓடுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Which two river names in Afghanistan correspond phonetically to the ancient Tamil rivers Kaveri and Porunai?", "media_id": null}], "options": {"A": "Indus and Jhelum", "B": "Ravi and Beas", "C": "Ganges and Yamuna", "D": "Kafri (Kaveri) and Porune (Porunai)"}, "explanation": "Kafri and Porune in Afghanistan preserve the exact names of Tamil Nadu's Kaveri and Porunai rivers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 47, "chapter": null, "section": null, "reference"