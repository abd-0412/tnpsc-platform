{"id": "11th_tamil_u3_q102", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "spectators_in_arena", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வாடிவாசல் கதையில் களத்தின் இருபுறமும் மூங்கில் படல்களில் ஏறி அமர்ந்து ஆரவாரம் செய்யும் மனிதர்கள் யார்?", "media_id": null}], "options": {"A": "அயல்நாட்டு பயணிகள்", "B": "பார்வையாளர்களான ஊர் மக்கள் மற்றும் வீரர்கள்", "C": "காவல்துறையினர் மட்டுமே", "D": "வணிகர்கள் மட்டுமே"}, "explanation": "வாடிவாசல் திடலின் தடுப்புப் படல்களில் ஏறி நின்று ஊர் மக்கள் பல்லாயிரக்கணக்கில் ஆர்ப்பரித்துக் காளையையும் வீரர்களையும் உற்சாகப்படுத்துவர்."}, "en": {"blocks": [{"type": "text", "content": "Who filled the barricaded bamboo galleries flanking the Vaadivaasal arena cheering thunderously?", "media_id": null}], "options": {"A": "Foreign tourists", "B": "Village spectators, village elders, and aspiring bull-tamers", "C": "Police force exclusively", "D": "Mercantile traders only"}, "explanation": "Crowds of cheering rural folk crowded the raised bamboo scaffolding around the arena."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edi