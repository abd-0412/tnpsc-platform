{"id": "11th_tamil_u3_q016", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "prose_malai_idappeyargal", "chapter_id": null, "topic_id": "tholkappiyam_quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மாயோன் மேய காடுறை உலகமும் / சேயோன் மேய மைவரை உலகமும்...’ என்ற தொல்காப்பிய வரிகள் குறிப்பிடும் மலை உலகம் எது?", "media_id": null}], "options": {"A": "முல்லை", "B": "மருதம்", "C": "நெய்தல்", "D": "குறிஞ்சி நிலம்"}, "explanation": "மைவரை உலகம் (மை = மேகம் தவழும்/கருமையான, வரை = மலை) என்பது குறிஞ்சி நிலத்தைக் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "Which ecological eco-zone is designated by Tholkappiyar's phrase 'Seyon meya maivarai ulagamum'?", "media_id": null}], "options": {"A": "Mullai", "B": "Marutham", "C": "Neithal", "D": "Kurinji landscape"}, "explanation": "'Maivarai Ulagam' explicitly designates the mountainous Kurinji landscape in Tholkappiyam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 46, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 46", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "ex