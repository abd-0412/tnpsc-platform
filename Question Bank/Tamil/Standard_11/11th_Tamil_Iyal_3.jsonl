{"id": "11th_tamil_u3_q015", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "prose_malai_idappeyargal", "chapter_id": null, "topic_id": "murugan_god_of_mountains", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைத் தமிழரின் திணை நில அமைப்பில் குறிஞ்சி நிலத்தின் தெய்வம் எது?", "media_id": null}], "options": {"A": "திருமால்", "B": "இந்திரன்", "C": "சேயோன் (முருகன்)", "D": "வருணன்"}, "explanation": "குறிஞ்சி நிலத்திற்குரிய தெய்வம் சேயோன் எனப்படும் முருகன் ஆகும் (சேயோன் மேய மைவரை உலகமும்)."}, "en": {"blocks": [{"type": "text", "content": "In the ancient Sangam five-fold landscape (Ainthinai), who is the presiding deity of the Kurinji (mountain) tract?", "media_id": null}], "options": {"A": "Thirumaal", "B": "Indhiran", "C": "Seyon (Murugan)", "D": "Varunan"}, "explanation": "Murugan (Seyon) is the presiding deity of the montane Kurinji realm."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 46, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 46", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "ye