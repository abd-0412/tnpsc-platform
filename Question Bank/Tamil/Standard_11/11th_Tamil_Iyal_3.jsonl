{"id": "11th_tamil_u3_q163", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "thirukkural_trans_latin", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளை லத்தீன் மொழியில் முதன்முதலில் மொழிபெயர்த்து வெளியிட்ட வெளிநாட்டுத் தமிழறிஞர் யார்?", "media_id": null}], "options": {"A": "ஜி. யு. போப்", "B": "கால்டுவெல்", "C": "வீரமாமுனிவர் (Constanzo Beschi)", "D": "சீகன் பால்கு"}, "explanation": "திருக்குறளின் அறத்துப்பாலையும் பொருட்பாலையும் வீரமாமுனிவர் 1730-இல் லத்தீன் மொழியில் மொழிபெயர்த்தார்."}, "en": {"blocks": [{"type": "text", "content": "Who pioneered the very first Latin translation of Thirukkural (Virtue and Wealth books) in 1730?", "media_id": null}], "options": {"A": "G. U. Pope", "B": "Robert Caldwell", "C": "Veeramamunivar (Constanzo Beschi)", "D": "Bartholomaeus Ziegenbalg"}, "explanation": "Veeramamunivar translated Thirukkural into Latin in 1730."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 56", "url": null, "source_notes": null}, "previ