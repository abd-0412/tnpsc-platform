{"id": "11th_tamil_u3_q092", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "zamindar_character", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காரிக் காளையின் உரிமையாளராகவும், காளையை அடக்குவோருக்குச் சவால் விடும் பண்ணையாராகவும் கதையில் வருபவர் யார்?", "media_id": null}], "options": {"A": "சின்ன மைனர்", "B": "திவான்", "C": "நாகப்ப செட்டியார்", "D": "பெரிய மைனர் (கிழக்கிளந்தான்)"}, "explanation": "காளையின் திமிரையும் கர்வத்தையும் தன் அதிகாரத்தின் அடையாளமாகக் கொண்டு வாழும் பண்ணையார் பெரிய மைனர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who is the arrogant landlord and owner of the formidable Kaari bull in the novella?", "media_id": null}], "options": {"A": "Chinna Minor", "B": "Diwan", "C": "Nagappa Chettiar", "D": "Periya Minor (Kizhakilanthān)"}, "explanation": "Periya Minor is the wealthy landlord whose prestige is fiercely tied to the unbeatable record of his bull."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 52", "url": null