{"id": "11th_tamil_u3_q141", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "adakkam_amararul", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அடக்கம் அமரருள் உய்க்கும் அடங்காமை / ஆர்இருள் உய்த்து விடும்’ - இக்குறள் உணர்த்தும் உண்மை யாது?", "media_id": null}], "options": {"A": "அடக்கம் ஒருவனைத் தேவருள் சேர்க்கும்; அடக்கமின்மை நரகப் பெருந்துன்பத்தில் ஆழ்த்தும்", "B": "செல்வம் மட்டுமே உயர்ந்தது", "C": "அடக்கம் கோழைத்தனம்", "D": "பேச்சாளரே சிறந்தவர்"}, "explanation": "மன அடக்கம் மனிதனைத் தேவர் நிலைக்கு உயர்த்தும்; புலனடக்கம் இல்லாத அறியாமை இருள் நரகத்தில் தள்ளும்."}, "en": {"blocks": [{"type": "text", "content": "What timeless ethical truth is encapsulated in 'Adakkam amararul uykkum adangaamai aarirul uythu vidum'?", "media_id": null}], "options": {"A": "Self-restraint elevates mortals to divine immortality; lack of restraint plunges one into utter darkness", "B": "Wealth alone is supreme", "C": "Restraint is cowardice", "D": "Orators are paramount"}, "explanation": "Self-control raises one among the immortals, whereas unrestrained conduct plunges into abyss."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 56", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Thirukkural", "Adakkamudaimai"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q142", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "nilaiyin_thiriyaathu_ani", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘நிலையின் திரியாது அடங்கியான் தோற்றம் / மலையினும் மாணப் பெரிது’ - இக்குறளில் பயின்று வந்துள்ள அணி எது?", "media_id": null}], "options": {"A": "வஞ்சப்புகழ்ச்சி அணி", "B": "உயர்வு நவிற்சி அணி (பொருட்பெயர் உவமம்)", "C": "வேற்றுமை அணி", "D": "சிலேடை அணி"}, "explanation": "தன் நன்னெறி நிலையில் பிறழாமல் அடங்கி வாழ்பவனின் பெருமை, விண்ணை முட்டும் இமய மலையைக் காட்டிலும் மிகப் பெரியதாகும் என மிகைப்படுத்திப் போற்றுவதால் உயர்வு நவிற்சி அணியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which rhetorical figure of speech (Ani) is deployed in the couplet 'Nilaiyin thiriyaathu adangiyaan thotram malaiyinum maanap perithu'?", "media_id": null}], "options": {"A": "Vanchappugazhchi Ani (Irony)", "B": "Uyarvu Navirtchi Ani (Hyperbolic eulogy / Sublime grandeur beyond a mountain)", "C": "Vaetrumai Ani (Contrast)", "D": "Siledai Ani (Pun)"}, "explanation": "The greatness of a steadfast self-controlled person is portrayed as grander than a mountain."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 56", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Thirukkural", "Figure of Speech"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q143", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "aamai_simile", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஒருமையுள் ஆமைபோல் ஐந்தடக்கல் ஆற்றின் / எழுமையும் ஏமாப்பு உடைத்து’ - இதில் ஆமை எதற்கு உவமையாகக் கூறப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "மெதுவாக நடப்பதற்கு", "B": "நீரில் வாழ்வதற்கு", "C": "ஆபத்து வரும்போது தன் ஐந்து உறுப்புகளையும் ஓட்டுக்குள் அடக்கிக் கொள்வது போல ஒருவன் மெய், வாய், கண், மூக்கு, செவி ஆகிய ஐம்பொறிகளையும் அடக்குவதற்கு", "D": "நீண்ட ஆயுளுக்கு"}, "explanation": "ஆமை தன் உறுப்புகளை ஓட்டுக்குள் அடக்குவது போல, ஒரு பிறவியில் ஐம்பொறிகளையும் அடக்கிக் காத்தால் அது ஏழு பிறவிக்கும் பாதுகாப்பாக அமையும்."}, "en": {"blocks": [{"type": "text", "content": "In the couplet comparing self-control to a tortoise withdrawing its five limbs, what is the exact analogy?", "media_id": null}], "options": {"A": "Slow movement", "B": "Aquatic habitat", "C": "Withdrawing the five sensory faculties into restraint just as a tortoise retreats into its shell against danger", "D": "Longevity"}, "explanation": "A person who masters the five senses like a tortoise drawing in its limbs secures lifelong protection."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 56", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Thirukkural", "Simile"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q144", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "yaakaavaaraayinum_naakaakka", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘யாகாவார் ஆயினும் நாகாக்க காவாக்கால் / சோகாப்பர் சொல்லிழுக்குப் பட்டு’ - வள்ளுவர் எதனைப் பாதுகாப்பாக அடக்க வேண்டும் என்கிறார்?", "media_id": null}], "options": {"A": "கண்களை", "B": "கால்களை", "C": "கைகளை", "D": "நாவை (நாக்கு / சொல்)"}, "explanation": "எவற்றை அடக்க முடியாவிட்டாலும் நாவையாவது அடக்கிக் காக்க வேண்டும்; தவறினால் தவறான சொல்லால் துன்பப்படுவர்."}, "en": {"blocks": [{"type": "text", "content": "According to the famous verse 'Yaakaavaaraayinum naakaakka...', which organ must be guarded at all costs?", "media_id": null}], "options": {"A": "Eyes", "B": "Feet", "C": "Hands", "D": "The Tongue (Speech / Words)"}, "explanation": "Whatever else you fail to control, master your tongue, or bitter words will bring ruin."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 56", "url": null, "source_notes": null}, "p