{"id": "11th_tamil_u3_q033", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kaavadichindu", "chapter_id": null, "topic_id": "other_works_annamalaiyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அண்ணாமலையார் இயற்றிய பிற சிற்றிலக்கிய நூல்களுள் பொருந்தாத ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "குற்றாலக் குறவஞ்சி", "B": "காவடிச்சிந்து", "C": "கோமதி அந்தாதி", "D": "வீரைத் தலபுராணம், வீரைக் கவிராச முறைமை"}, "explanation": "குற்றாலக் குறவஞ்சி என்பது திரிகூடராசப்பக் கவிராயரின் நூல்; காவடிச்சிந்து, கோமதி அந்தாதி, வீரைக் கவிராச முறைமை ஆகியவை அண்ணாமலையாரின் நூல்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the work which was NOT composed by Annamalaiyar:", "media_id": null}], "options": {"A": "Kutraalak Kuravanji", "B": "Kaavadichindu", "C": "Gomathi Anthathi", "D": "Veerai Thala Puranam, Veerai Kaviraasa Muraimai"}, "explanation": "'Kutraalak Kuravanji' was composed by Thirukoodaraasappa Kavirayar, not Annamalaiyar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 49, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 49", "url