{"id": "11th_tamil_u3_q014", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "prose_malai_idappeyargal", "chapter_id": null, "topic_id": "balakrishnan_native_district", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆர். பாலகிருஷ்ணன் ஐ.ஏ.எஸ் தமிழ்நாட்டில் எந்த மாவட்டத்தைச் சேர்ந்தவர்?", "media_id": null}], "options": {"A": "மதுரை மாவட்டம்", "B": "திண்டுக்கல் மாவட்டம் (நத்தம்)", "C": "திருநெல்வேலி மாவட்டம்", "D": "தஞ்சாவூர் மாவட்டம்"}, "explanation": "ஆர். பாலகிருஷ்ணன் திண்டுக்கல் மாவட்டம் நத்தத்தைச் சேர்ந்தவர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Which district of Tamil Nadu is the native birthplace of researcher-administrator R. Balakrishnan IAS?", "media_id": null}], "options": {"A": "Madurai district", "B": "Dindigul district (Natham)", "C": "Tirunelveli district", "D": "Thanjavur district"}, "explanation": "R. Balakrishnan hails from Natham in Dindigul district."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 46, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 46", "url": null, "source_notes": null}, "previous_year": {"is_previous_yea