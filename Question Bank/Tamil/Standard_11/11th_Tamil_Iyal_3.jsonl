{"id": "11th_tamil_u3_q111", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "archaeological_proof_jallikattu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிந்துவெளி நாகரிக முத்திரைகளிலும் எதனைச் சித்தரிக்கும் கல் முத்திரைகள் கிடைத்துள்ளன?", "media_id": null}], "options": {"A": "யானைச் சண்டை", "B": "குதிரைப் பந்தயம்", "C": "திமில் கொண்ட காளையை அடக்கும் மனித உருவம் (ஏறுதழுவல் முத்திரை)", "D": "ஒட்டகப் பந்தயம்"}, "explanation": "சிந்துவெளியில் கண்டெடுக்கப்பட்ட முத்திரைகளில் திமில் கொண்ட காளையை மனிதன் அடக்குவது போன்ற சித்தரிப்புகள் தமிழரின் ஏறுதழுவலோடு ஒப்பிடப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What prehistoric artifact discovered in the Indus Valley excavations directly corroborates the antiquity of bull-taming?", "media_id": null}], "options": {"A": "Elephant combat seal", "B": "Equestrian horse race talisman", "C": "Steatite seal depicting a human grappling with a humped bull", "D": "Camel race plaque"}, "explanation": "Indus seals vividly depict figures grappling with majestic humped zebu bulls."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "