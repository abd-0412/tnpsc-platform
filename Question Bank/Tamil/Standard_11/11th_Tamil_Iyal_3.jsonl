{"id": "11th_tamil_u3_q139", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "grammar_pagupatham", "chapter_id": null, "topic_id": "parsing_valarnthathu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வளர்ந்தது’ என்ற சொல்லில் சந்தி மற்றும் விகாரமாக அமைந்த உறுப்புகள் எவை?", "media_id": null}], "options": {"A": "வளர், து", "B": "அன், து", "C": "த் என்பது சந்தி; அது ‘ந்’ எனத் திரிந்தது விகாரம்", "D": "வளர், த்"}, "explanation": "வளர் + த்(ந்) + த் + அன் + து. இதில் முதல் 'த்' சந்தி; அது மெல்லெழுத்தாக 'ந்' எனத் திரிந்தது விகாரமாகும்."}, "en": {"blocks": [{"type": "text", "content": "In the word 'Valarnthathu' (வளர் + த்(ந்) + த் + அன் + து), which entity forms the Sandhi and its mutation?", "media_id": null}], "options": {"A": "Valar and Thu", "B": "An and Thu", "C": "Th is Sandhi; its nasalization into N is Vikaram", "D": "Valar and Th"}, "explanation": "Th functions as Sandhi, mutated euphoincally into N (Vikaram)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 55, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 55", "url": null, "source_notes": null}, "previou