{"id": "11th_tamil_u3_q084", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "purananooru_universal_appeal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உண்டால் அம்ம இவ்வுலகம்...’ பாடல் எந்தக் காலத்திற்கும் பொருந்தும் உலகப் பொதுமைப் பாடலாகத் திகழக் காரணம் என்ன?", "media_id": null}], "options": {"A": "போர்க் கருவிகளைப் பட்டியலிடுவதால்", "B": "ஒரு மதக் கோட்பாட்டை மட்டுமே வலியுறுத்துவதால்", "C": "ஒரு குறிப்பிட்ட மன்னனின் வெற்றியைப் பாடுவதால்", "D": "சுயநலமின்றி பிறர்க்கென வாழும் மனித நேயமே உலகை நிலைநிறுத்துகிறது என்ற உலகளாவிய அறத்தை உணர்த்துவதால்"}, "explanation": "எந்த ஒரு சாதி, மதம், எல்லைகளுக்கு உட்படாமல் மனிதநேயத்தையும் தன்னலமற்ற தியாகத்தையுமே உலகின் ஆதார சுருதியாகக் காட்டுவதால் இப்பாடல் எக்காலத்துக்கும் உரிய உலகப் பொதுப்பாடலாக விளங்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "Why does Purananooru 182 ('Undaal amma ivvulagam') stand as a timeless universal manifesto across millennia?", "media_id": null}], "options": {"A": "Because it chronicles iron weaponry", "B": "Because it propagates sectarian dogmas", "C": "Because it panegyrizes a specific dynastic monarch", "D": "Because it affirms that selfless altruistic humanism is the sole foundation that sustains planetary human existence"}, "explanation": "It transcends geographic borders to proclaim that unselfish love and virtue are what sustain civilization."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, 