{"id": "11th_tamil_u3_q071", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "kurunthogai_first_print_year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறுந்தொகை நூலை முதன்முதலில் பதிப்பித்து வெளியிட்ட அறிஞர் யார்?", "media_id": null}], "options": {"A": "உ. வே. சாமிநாதையர்", "B": "சி. வை. தாமோதரம்பிள்ளை", "C": "சௌரிப் பெருமாள் அரங்கனார் (1915)", "D": "மறைமலையடிகள்"}, "explanation": "குறுந்தொகையை 1915-ஆம் ஆண்டு முதன்முதலில் பதிப்பித்து வெளியிட்டவர் வித்துவான் சௌரிப் பெருமாள் அரங்கனார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who pioneered the first modern printed edition of Kurunthogai in the year 1915?", "media_id": null}], "options": {"A": "U. V. Swaminatha Iyer", "B": "C. W. Damodaram Pillai", "C": "Sowri Perumal Aranganar (1915)", "D": "Maraimalai Adigal"}, "explanation": "Vidwan Sowri Perumal Aranganar edited and printed Kurunthogai for the first time in 1915."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 50, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 50", "url": null