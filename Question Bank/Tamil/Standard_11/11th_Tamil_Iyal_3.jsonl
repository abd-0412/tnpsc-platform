{"id": "11th_tamil_u3_q003", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "prose_malai_idappeyargal", "chapter_id": null, "topic_id": "kvt_complex", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வடமேற்கு இந்தியாவில் (பாகிஸ்தான், ஆப்கானிஸ்தான்) இன்றும் காணப்படும் சங்க காலத் தமிழ் இடப்பெயர்த் தொகுதி எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "சேர-சோழ வளாகம்", "B": "பாண்டிய வளாகம்", "C": "கொற்கை - வஞ்சி - தொண்டி (KVT) வளாகம்", "D": "மதுரை வளாகம்"}, "explanation": "பாகிஸ்தான், ஆப்கானிஸ்தான் நிலப்பரப்பில் சங்க காலத் துறைமுக நகரப் பெயர்களான கொற்கை, வஞ்சி, தொண்டி ஆகியவற்றைக் குறிக்கும் KVT (Korkai-Vanji-Thondi Complex) வளாகம் உள்ளது."}, "en": {"blocks": [{"type": "text", "content": "What acronym designates the cluster of Sangam Tamil toponyms (Korkai, Vanji, Thondi) found today in Northwestern India, Pakistan, and Afghanistan?", "media_id": null}], "options": {"A": "Chera-Chola Complex", "B": "Pandya Complex", "C": "KVT (Korkai - Vanji - Thondi) Complex", "D": "Madurai Complex"}, "explanation": "It is termed the KVT (Korkai-Vanji-Thondi) Complex."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "