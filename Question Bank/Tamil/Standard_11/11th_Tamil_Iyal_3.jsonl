{"id": "11th_tamil_u3_q053", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kaavadichindu", "chapter_id": null, "topic_id": "kaavadi_symbolism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காவடி சுமந்து ஆடும் மரபில் ‘காவடி’ என்ற சொல்லின் நேரடிப் பொருள் யாது?", "media_id": null}], "options": {"A": "இரு முனைகளிலும் பாரத்தைத் தாங்கித் தோளில் சுமக்கப்படும் வளைந்த தண்டு", "B": "தலையில் சூடும் கிரீடம்", "C": "கையில் ஏந்தும் வில்", "D": "காலில் கட்டும் சலங்கை"}, "explanation": "கா (தோளில் சுமக்கும் தண்டு) + அடி = காவடி. இரு முனைகளிலும் காணிக்கைப் பொருள்களைக் கட்டித் தோளில் தாங்கும் மரத் தண்டு காவடியாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the literal etymological meaning of the sacred pole designated as 'Kaavadi'?", "media_id": null}], "options": {"A": "A curved wooden shoulder-yoke balanced across shoulders bearing weights on both ends", "B": "A divine crown", "C": "A hunting war bow", "D": "Ankle brass bells"}, "explanation": "Kaavadi denotes a curved yoke balanced on the shoulders bearing offerings suspended at both terminals."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition":