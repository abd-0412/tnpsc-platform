{"id": "11th_tamil_u3_q155", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "onra_ulagathu_uyarntha", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஒன்றா உலகத்து உயர்ந்த புகழல்லால் / பொன்றாது நிற்பதொன் றில்’ - இவ்வுலகில் அழியாமல் நிலைத்து நிற்பது எது ஒன்றே?", "media_id": null}], "options": {"A": "பொன் பொருள்", "B": "கல் அரண்மனைகள்", "C": "உயர்ந்த நற்புகழ் ஒன்றே (புகழ்)", "D": "அரசாட்சி"}, "explanation": "இவ்வுலகில் மனிதன் சேர்த்த செல்வம், கட்டடங்கள் அனைத்தும் அழிந்துவிடும்; ஒப்பற்ற உயர்ந்த நற்புகழ் மட்டுமே என்றும் அழியாது நிற்கும்."}, "en": {"blocks": [{"type": "text", "content": "In 'Onra ulagathu uyarntha pugazhallal ponraathu nirpathonril', what alone stands immortal in this world?", "media_id": null}], "options": {"A": "Gold and gemstones", "B": "Granite castles", "C": "Sublime ethical renown and virtuous glory (Pugazh)", "D": "Dynastic empires"}, "explanation": "Nothing endures immortal in this fleeting universe except lofty unblemished renown."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 56", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Thirukkural", "Immortality of Fame"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q156", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "uraipaar_uraipavai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உரைப்பார் உரைப்பவை எல்லாம் இரப்பார்க்கொன் / றீவார்மேல் நிற்கும் புகழ்’ - புகழ் யாரிடத்தில் வந்து நிலைக்கும்?", "media_id": null}], "options": {"A": "அதிகாரம் செலுத்துவோரிடம்", "B": "நூல்களை எழுதுவோரிடம்", "C": "செல்வத்தைப் பதுக்குவோரிடம்", "D": "வறியவர்க்கு இல்லை எனாது ஈயும் வள்ளல்களிடம்"}, "explanation": "உலகத்தில் சான்றோர்கள் பேசும் புகழுரைகள் அனைத்தும், வறியவர்க்கு ஈந்து உதவும் வள்ளல்களின் மீதே என்றும் நிலைத்து நிற்கும்."}, "en": {"blocks": [{"type": "text", "content": "Upon whom does all human praise and eulogy permanently settle according to 'Uraippaar uraipavai...'?", "media_id": null}], "options": {"A": "Upon oppressive rulers", "B": "Upon encyclopedic scribes", "C": "Upon miserly hoarders", "D": "Upon generous patrons who give freely to the destitute"}, "explanation": "All worthy eulogies praised by humanity dwell upon those who give bountifully to the needy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "editio