{"id": "11th_tamil_u3_q080", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "purananooru_anthology_classification", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புறநானூறு என்பது பதினெண்மேற்கணக்கு நூல்களுள் எவ்வகைத் தொகுப்பில் அடங்கும்?", "media_id": null}], "options": {"A": "பத்துப்பாட்டு", "B": "பதினெண்கீழ்க்கணக்கு", "C": "ஐஞ்சிறுங்காப்பியம்", "D": "எட்டுத்தொகை"}, "explanation": "புறநானூறு என்பது சங்க இலக்கியப் பதினெண்மேற்கணக்கின் எட்டுத்தொகை நூல்களுள் ஒன்றாகும்."}, "en": {"blocks": [{"type": "text", "content": "Under which major canonical group of Pathinenmelkanakku does Purananooru belong?", "media_id": null}], "options": {"A": "Pathuppaattu", "B": "Pathinenkeezhkanakku", "C": "Ainchirukaappiyam", "D": "Ettuthogai"}, "explanation": "Purananooru is one of the Eight Anthologies (Ettuthogai) belonging to the Sangam canon."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 51", "url": null, "source_notes": null}, "previous_year": {"is_previous_year"