{"id": "11th_tamil_rev2_q029", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "athmanam_real_name", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஆத்மாநாம்’ என்ற புனைபெயரில் கவிதைகள் எழுதிய கவிஞரின் இயற்பெயர் என்ன?", "media_id": null}], "options": {"A": "எஸ். மதுசூதனன்", "B": "சி. சு. செல்லப்பா", "C": "எஸ். வைத்தீஸ்வரன்", "D": "ரா. மீனாட்சி"}, "explanation": "‘ஆத்மாநாம்’ என்ற பெயரில் நவீனக் கவிதைகள் படைத்த கவிஞரின் இயற்பெயர் எஸ். மதுசூதனன் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What was the original name of the poet who wrote under the pseudonym 'Athmanam'?", "media_id": null}], "options": {"A": "S. Madhusoodhanan", "B": "C. S. Chellappa", "C": "S. Vaitheeswaran", "D": "R. Meenakshi"}, "explanation": "The real name of modern poet Athmanam was S. Madhusoodhanan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 135, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 135", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam"