{"id": "11th_tamil_rev2_q168", "schema_version": "1.0", "kind": "grammar_identification", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u8_grammar_mega_test", "chapter_id": null, "topic_id": "aakkappeyar_overall_importance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மொழி வளர்ச்சியில் ஆக்கப்பெயர்களின் முதன்மையான பங்களிப்பு யாது?", "media_id": null}], "options": {"A": "பழைய இலக்கணத்தைக் கைவிடச் செய்வது", "B": "வடமொழிச் சொற்களை மிகுதியாகப் புகுத்துவது", "C": "மொழியின் ஒலிகளைக் குறைப்பது", "D": "காலந்தோறும் தோன்றும் புதிய அறிவியல், சமூகக் கருத்துகளுக்கு ஏற்ப மொழியில் புதிய புதிய சொற்களை உருவாக்கி மொழிக்கு வளம் சேர்ப்பது"}, "explanation": "ஆக்கப்பெயர்கள் புதிய அறிவியல், தொழில்நுட்ப, சமூகக் கருத்துகளைத் தமிழில் எளிமையாகப் படைக்க உதவும் சொல்லாக்கக் கருவூலமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the vital linguistic importance of derivative nominals (Aakkappeyar) in language growth?", "media_id": null}], "options": {"A": "Discarding ancient grammar", "B": "Flooding the language with loan words", "C": "Reducing phonemic inventory", "D": "Coining fresh indigenous terminology to enrich language across emerging scientific and social eras"}, "explanation": "Derivative morphology continually renews the language by enabling lexical innovation without syntactic distortion."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_m