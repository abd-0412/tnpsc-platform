{"id": "11th_tamil_rev2_q155", "schema_version": "1.0", "kind": "grammar_identification", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u8_grammar_mega_test", "chapter_id": null, "topic_id": "vallinam_migum_exceptions", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் சொற்களுள் வல்லினம் மிகும் இடத்திற்குரிய சரியான தொடரைத் தேர்க:", "media_id": null}], "options": {"A": "கயல்விழி பேசினாள்", "B": "காய்கறி வாங்கினான்", "C": "நாலாபக்கமும் பார்த்தான்", "D": "இரவுபகல் பாராது"}, "explanation": "நாலாபக்கம் என்பதில் 'நாலா' என்பது எண்ணுப்பெயர்த் திரிபு / ஈறுகெட்ட வடிவம், எனவே 'ப்' மிகும் (நாலாபக்கமும்). ஏனையவற்றில் உவமைத்தொகை, உம்மைத்தொகைகளில் வல்லினம் மிகாது."}, "en": {"blocks": [{"type": "text", "content": "Identify the phrase where sandhi hard doubling correctly occurs:", "media_id": null}], "options": {"A": "Kayalvizhi pesinaal", "B": "Kaikari vaanginaan", "C": "Naalaap pakkamum paarthaan", "D": "Iravupagal paaraathu"}, "explanation": "'Naalaa' is an elided numeral form necessitating plosive doubling ('Naalaap pakkamum')."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": null, "section": null, "re