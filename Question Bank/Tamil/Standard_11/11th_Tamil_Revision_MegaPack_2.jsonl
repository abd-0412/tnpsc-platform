{"id": "11th_tamil_rev2_q046", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "pichamurthi_first_story", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ந. பிச்சமூர்த்தியின் முதல் சிறுகதை எது?", "media_id": null}], "options": {"A": "விஞ்ஞானத்திற்குப் பலி", "B": "லேசான சண்டை", "C": "மோகினி", "D": "பதினெட்டாம் பெருக்கு"}, "explanation": "ந. பிச்சமூர்த்தியின் முதல் சிறுகதை 1932-இல் மணிக்கொடி இதழில் வெளிவந்த 'லேசான சண்டை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What was the first short story authored by Na. Pichamurthi?", "media_id": null}], "options": {"A": "Vinjnanathirku Bali", "B": "Lesaana Sandai", "C": "Mohini", "D": "Pathinettam Perukku"}, "explanation": "Na. Pichamurthi's maiden published short story was 'Lesaana Sandai' in 1932."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 156", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "