{"id": "11th_tamil_rev2_q006", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_prose_classics", "chapter_id": null, "topic_id": "anandarangar_diary_facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆனந்தரங்கர் நாட்குறிப்பு பற்றிய கூற்றுகளில் தவறானது எது?", "media_id": null}], "options": {"A": "இது 1736 முதல் 1761 வரையிலான 25 ஆண்டு காலத் தென்னிந்திய வரலாற்று ஆவணமாகும்.", "B": "ஆனந்தரங்கர் ஆங்கிலேயக் கிழக்கிந்தியக் கம்பெனியின் நேரடி ஆளுநராகப் பணியாற்றினார்.", "C": "துய்ப்ளே ஆளுநராக இருந்த காலத்தின் அரசியல் நிகழ்வுகள் இதில் விரிவாகப் பதிவாகியுள்ளன.", "D": "ஆனந்தரங்கர் ‘இந்தியாவின் பெப்பிசு’ என்று வரலாற்றாசிரியர்களால் போற்றப்படுகிறார்."}, "explanation": "ஆனந்தரங்கர் பிரெஞ்சுக் கிழக்கிந்தியக் கம்பெனியின் தலைமைத் துபாஷியாகப் பணியாற்றினாரே அன்றி ஆங்கிலேயக் கம்பெனியின் ஆளுநர் அல்ல. எனவே கூற்று B தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Which statement about Anandarangar's diary is INCORRECT?", "media_id": null}], "options": {"A": "It documents South Indian history across 25 years from 1736 to 1761.", "B": "Anandarangar served as the direct Governor of the English East India Company.", "C": "Political events during Governor Dupleix's tenure are elaborately recorded.", "D": "Historians describe Anandarangar as the 'Pepys of India'."}, "explanation": "Anandarangar was the Chief Dubash of the French East India Company under French governors, not an English Governor."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 122, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 122", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 2", "Anandarangar", "History"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev2_q007", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_prose_classics", "chapter_id": null, "topic_id": "thanjavur_paintings", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயிலின் கருவறைச் சுவரில் அமைக்கப்பட்ட சுவரோவியங்கள் எந்தக் காலத்தைச் சேர்ந்தவை?", "media_id": null}], "options": {"A": "பல்லவர் மற்றும் சேரர் காலம்", "B": "பாண்டியர் மற்றும் விஜயநகர காலம்", "C": "சோழர் காலம் மற்றும் நாயக்கர் காலம்", "D": "மராட்டியர் மற்றும் ஆங்கிலேயர் காலம்"}, "explanation": "தஞ்சைப் பெரிய கோயில் கருவறையின் சாந்தார நாழி சுவர்களில் சோழர் காலத்து மூல ஓவியங்களும், அதன் மேல் நாயக்கர் காலத்து ஓவியங்களும் இரு அடுக்குகளாகக் காணப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "To which two periods do the prominent layered mural paintings on the sanctum walls of Thanjavur Big Temple belong?", "media_id": null}], "options": {"A": "Pallava and Chera periods", "B": "Pandya and Vijayanagara periods", "C": "Chola period and Nayaka period", "D": "Maratha and British periods"}, "explanation": "The circumambulatory corridor walls preserve pristine 11th-century Chola murals beneath 17th-century Nayaka over-paintings."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher":