{"id": "11th_tamil_rev2_q030", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "pillaikkoodam_pichamurthi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பிள்ளைக்கூடம்’ என்னும் நவீனக் கவிதையை இயற்றியவர் யார்?", "media_id": null}], "options": {"A": "பாரதிதாசன்", "B": "ந. பிச்சமூர்த்தி", "C": "இன்குலாப்", "D": "நா. முத்துக்குமார்"}, "explanation": "இயற்கையோடு இணைந்த மழலையின் கற்பனை உலகை பள்ளிச் சுவர்கள் முடக்குவதை ‘பிள்ளைக்கூடம்’ கவிதையில் ந. பிச்சமூர்த்தி அழகுறச் சித்திரித்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the modern poem 'Pillaikkoodam' questioning rigid school education?", "media_id": null}], "options": {"A": "Bharathidasan", "B": "Na. Pichamurthi", "C": "Inquilab", "D": "Na. Muthukumar"}, "explanation": "Na. Pichamurthi, pioneer of modern Tamil free verse (Pudhukkavithai), composed 'Pillaikkoodam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 155, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 155", "url": null, "source_notes"