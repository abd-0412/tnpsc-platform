{"id": "11th_tamil_rev2_q138", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_interview_proof_names", "chapter_id": null, "topic_id": "aakkappeyar_types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆக்கப்பெயர்கள் பொதுவாக எவ்வகை இலக்கணக் கூறுகளின் அடிப்படையில் பகுக்கப்படுகின்றன?", "media_id": null}], "options": {"A": "அடிச்சொல் மற்றும் வேற்றுமை உருபுகள் மட்டுமே", "B": "பெயர்-அடி ஆக்கப்பெயர்கள், வினை-அடி ஆக்கப்பெயர்கள், இடைச்சொல்-அடி ஆக்கப்பெயர்கள்", "C": "எழுத்து மற்றும் அசை மட்டுமே", "D": "பொருளற்ற ஒலிகள்"}, "explanation": "ஆக்கப்பெயர்கள் அவை உருவாகும் வேர்ச் சொல்லின் அடிப்படையில் பெயர்-அடி, வினை-அடி, இடை-அடி எனப் பகுக்கப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "How are derivative nominal stems classified in modern Tamil grammatical theory?", "media_id": null}], "options": {"A": "Solely case inflections", "B": "Noun-based, Verb-based, and Particle-based derivative stems", "C": "Only letters and syllables", "D": "Arbitrary acoustic noise"}, "explanation": "Derivatives are categorized into denominative (noun-root), deverbative (verb-root), and particle-derived nominals."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services