{"id": "11th_tamil_rev2_q122", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_interview_proof_names", "chapter_id": null, "topic_id": "narthaki_nataraj_dance_institution", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நர்த்தகி நடராஜ் சென்னையில் நிறுவி நடத்தி வரும் புகழ்பெற்ற நாட்டியப் பள்ளியின் பெயர் என்ன?", "media_id": null}], "options": {"A": "கலாசேத்திரம்", "B": "வெள்ளியம்பலம் நாட்டியக் கலைக்கூடம் (Velliyambalam Trust)", "C": "நாட்டியரங்கம்", "D": "தஞ்சை அரங்கம்"}, "explanation": "நர்த்தகி நடராஜ் தஞ்சாவூர் பாணி நாட்டியத்தைப் பயிற்றுவிக்கவும் பரப்பவும் சென்னையில் நிறுவிய அமைப்பு 'வெள்ளியம்பலம் நாட்டியக் கலைக்கூடம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the name of the dance institution established in Chennai by Narthaki Nataraj?", "media_id": null}], "options": {"A": "Kalakshetra", "B": "Velliyambalam School of Dance (Trust)", "C": "Nattyarangam", "D": "Thanjai Arangam"}, "explanation": "She founded the 'Velliyambalam Trust' to preserve and propagate the pristine Thanjavur Bani."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 216, "