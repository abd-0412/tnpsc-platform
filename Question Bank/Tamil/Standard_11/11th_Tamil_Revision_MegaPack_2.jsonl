{"id": "11th_tamil_rev2_q151", "schema_version": "1.0", "kind": "matching", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u8_grammar_mega_test", "chapter_id": null, "topic_id": "proofreading_master_matching", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அச்சக மெய்ப்புத் திருத்தக் குறியீடுகளைப் பொருத்துக:\n(a) # - 1. எழுத்து அல்லது சொல் நீக்கல்\n(b) ^ - 2. இடைவெளி விடுக\n(c) dele - 3. விடுபட்டதைச் சேர்க்க\n(d) ¶ - 4. புதிய பத்தி தொடங்க", "media_id": null}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-3, b-4, c-1, d-2", "C": "a-2, b-3, c-1, d-4", "D": "a-4, b-1, c-2, d-3"}, "explanation": "# என்பது இடைவெளி (2), ^ என்பது விடுபட்டதைச் சேர்க்க (3), dele என்பது நீக்கல் (1), ¶ என்பது பத்தி தொடங்க (4). நேர் பொருத்தம் a-2, b-3, c-1, d-4."}, "en": {"blocks": [{"type": "text", "content": "Match the proofreading symbols with their exact typographical directions:\n(a) # - 1. Delete word/character\n(b) ^ - 2. Insert space\n(c) dele - 3. Insert omitted word\n(d) ¶ - 4. Begin new paragraph", "media_id": null}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-3, b-4, c-1, d-2", "C": "a-2, b-3, c-1, d-4", "D": "a-4, b-1, c-2, d-3"}, "explanation": "# (insert space), ^ (insert omission), dele (delete), ¶ (paragraph)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi",