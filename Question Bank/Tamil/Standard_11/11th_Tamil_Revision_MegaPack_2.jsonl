{"id": "11th_tamil_rev2_q042", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "pichamurthi_career", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ந. பிச்சமூர்த்தி வழக்கறிஞராகவும் பின்னர் எந்தத் துறையில் அலுவலராகவும் பணியாற்றினார்?", "media_id": null}], "options": {"A": "வனத்துறை", "B": "இந்து சமய அறநிலையத்துறை (கோயில் நிர்வாக அலுவலர்)", "C": "வருவாய்த்துறை", "D": "கல்வித்துறை"}, "explanation": "ந. பிச்சமூர்த்தி வழக்கறிஞராகப் பணியாற்றிய பின் இந்து சமய அறநிலையத்துறையில் செயல் அலுவலராக (Executive Officer) பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "In addition to practicing law, in which department did Na. Pichamurthi serve as an officer?", "media_id": null}], "options": {"A": "Forest Department", "B": "Hindu Religious and Charitable Endowments (HR&CE temple executive officer)", "C": "Revenue Department", "D": "Education Department"}, "explanation": "Na. Pichamurthi practiced law before serving as an Executive Officer in the Hindu Religious Endowments Department."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 156", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 2", "Pichamurthi", "Biography"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev2_q043", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "vinaithogai_vallinam_migaa", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வினைத்தொகையில் வல்லினம் மிகாது’ - இவிதிக்கான சரியான சான்றுகளைக் கொண்ட தொடர் எது?", "media_id": null}], "options": {"A": "சுடுசோறு, பாய்புலி", "B": "வீசுதென்றல், அலைகடல்", "C": "மேற்கண்ட இரண்டும் வினைத்தொகைகளே மற்றும் வல்லினம் மிகவில்லை", "D": "எதுவுமில்லை"}, "explanation": "சுடுசோறு, பாய்புலி, வீசுதென்றல், அலைகடல் ஆகியவை மூன்று காலமும் உணர்த்தும் வினைத்தொகைகள். இவற்றில் வல்லினம் மிகாது."}, "en": {"blocks": [{"type": "text", "content": "Which option contains valid examples of the rule 'Vallinam does NOT double in Vinaithogai'?", "media_id": null}], "options": {"A": "Sudusoru, Paaypuli", "B": "Veesuthendral, Alaikadal", "C": "Both the above are Vinaithogai and lack Vallinam doubling", "D": "None of the above"}, "explanation": "All listed words are compressed verbal compounds where hard consonant doubling is strictly prohibited."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "202