{"id": "11th_tamil_rev2_q022", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_prose_classics", "chapter_id": null, "topic_id": "thanjavur_kattrali", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயிலைக் கட்ட சோழ மன்னன் பயன்படுத்திய முதன்மைக் கட்டுமானப் பொருள் எது?", "media_id": null}], "options": {"A": "சுண்ணாம்புக் கல் மற்றும் செங்கல்", "B": "கருங்கல் (கருங்கற்களாலான கற்றளி)", "C": "மணற்கல்", "D": "பளிங்குக்கல்"}, "explanation": "தஞ்சைச் சமவெளிப் பகுதியில் கருங்கற்கள் கிடைக்காத போதிலும், தொலைதூரத்திலிருந்து கருங்கற்களைக் கொண்டுவந்து முற்றிலும் கருங்கல்லாலேயே பெரிய கோயில் கட்டப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "What was the primary construction stone material utilized for the Thanjavur Big Temple?", "media_id": null}], "options": {"A": "Limestone and brick", "B": "Granite stone (Kattrali construction)", "C": "Sandstone", "D": "Marble"}, "explanation": "The Brihadisvara temple is an entirely monolithic granite edifice, transported from quarries kilometres away."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 145, "chapt