{"id": "11th_tamil_rev2_q113", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_interview_proof_names", "chapter_id": null, "topic_id": "narthaki_nataraj_padma_shri", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியாவில் பத்மஸ்ரீ விருது பெற்ற முதல் திருநங்கை நடனக் கலைஞர் யார்? இவர் எந்த ஆண்டு அவ்விருதைப் பெற்றார்?", "media_id": null}], "options": {"A": "நர்த்தகி நடராஜ் - 2019", "B": "கல்கி சுப்பிரமணியம் - 2015", "C": "ரேவதி - 2018", "D": "பிரியா பாபு - 2020"}, "explanation": "தஞ்சாவூர் பாணி பரதநாட்டியக் கலைஞரான நர்த்தகி நடராஜ் 2019-ஆம் ஆண்டு இந்திய அரசின் உயரிய 'பத்மஸ்ரீ' விருது பெற்ற முதல் திருநங்கை ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who was the first transgender classical dancer in India to be conferred the prestigious Padma Shri award, and in which year?", "media_id": null}], "options": {"A": "Narthaki Nataraj - 2019", "B": "Kalki Subramaniam - 2015", "C": "Revathi - 2018", "D": "Priya Babu - 2020"}, "explanation": "Narthaki Nataraj became the first transgender artist honored with the Padma Shri in 2019 for Bharatanatyam excellence."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term"