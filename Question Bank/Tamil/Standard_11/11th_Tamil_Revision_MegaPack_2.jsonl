{"id": "11th_tamil_rev2_q021", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_prose_classics", "chapter_id": null, "topic_id": "anandarangar_diary_timeline", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆனந்தரங்கர் எந்த ஆண்டு முதல் எந்த ஆண்டு வரை தனது நாட்குறிப்பைத் தொடர்ந்து எழுதினார்?", "media_id": null}], "options": {"A": "1736 செப்டம்பர் 6 முதல் 1761 ஜனவரி 11 வரை", "B": "1720 முதல் 1745 வரை", "C": "1750 முதல் 1775 வரை", "D": "1740 முதல் 1765 வரை"}, "explanation": "ஆனந்தரங்கர் 1736 செப்டம்பர் 6 முதல் அவர் மறையும் ஆண்டான 1761 ஜனவரி 11 வரை ஏறத்தாழ 25 ஆண்டுகள் நாட்குறிப்பு எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "During which span of years did Anandarangar continuously keep his diary?", "media_id": null}], "options": {"A": "From 6 September 1736 to 11 January 1761", "B": "From 1720 to 1745", "C": "From 1750 to 1775", "D": "From 1740 to 1765"}, "explanation": "Anandarangar recorded entries from 6 September 1736 until 11 January 1761."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 121, "chapter": null, "section": null, "reference": "11th