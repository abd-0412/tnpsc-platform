{"id": "11th_tamil_rev2_q044", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "ms_subbulakshmi_meera", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எம். எஸ். சுப்புலட்சுமி அவர்கள் திரைப்படங்களில் நடித்துப் புகழ்பெற்ற காவியக் கதாபாத்திரம் எது?", "media_id": null}], "options": {"A": "ஔவையார்", "B": "கண்ணகி", "C": "மணிமேகலை", "D": "மீரா"}, "explanation": "1945-இல் வெளியான ‘மீரா’ திரைப்படத்தில் பக்த மீராவாக நடித்துப் பாடி நாடெங்கிலும் இசைப் பேரரசியாகப் புகழ்பெற்றார்."}, "en": {"blocks": [{"type": "text", "content": "Which iconic cinematic role portrayal immortalized M. S. Subbulakshmi across India?", "media_id": null}], "options": {"A": "Avvaiyar", "B": "Kannagi", "C": "Manimekalai", "D": "Meera"}, "explanation": "Her divine portrayal of Saint Meera in the 1945 film made her a legendary household name nationwide."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 137", "url": null, "source_notes": null}, "previous_year": {"i