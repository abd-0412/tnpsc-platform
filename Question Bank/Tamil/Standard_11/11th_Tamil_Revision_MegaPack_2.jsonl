{"id": "11th_tamil_rev2_q108", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_sangam_modern_theatre", "chapter_id": null, "topic_id": "pammal_sambandhar_shakespeare", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஷேக்ஸ்பியரின் உலகப் புகழ்பெற்ற ஆங்கில நாடகங்களைத் தமிழில் மொழிபெயர்த்து மேடையேற்றிய தமிழ் நாடக முன்னோடி யார்?", "media_id": null}], "options": {"A": "பரிதிமாற்கலைஞர்", "B": "சங்கரதாஸ் சுவாமிகள்", "C": "சுந்தரனார்", "D": "பம்மல் சம்பந்த முதலியார் (அசிம்பரா, வாணீபுர வணிகன் போன்ற நாடகங்கள்)"}, "explanation": "பம்மல் சம்பந்த முதலியார் ஷேக்ஸ்பியரின் Merchant of Venice நாடகத்தை 'வாணீபுரத்து வணிகன்' என்றும், Hamlet நாடகத்தை 'அமலாதித்யன்' என்றும் மொழிபெயர்த்து மேடையேற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Which pioneer translated and staged Shakespeare's masterworks such as Merchant of Venice and Hamlet into Tamil?", "media_id": null}], "options": {"A": "Parithimaar Kalaignar", "B": "Sankaradas Swamigal", "C": "Sundaranar", "D": "Pammal Sambandha Mudaliar (Vaneepurathu Vanigan, Amaladityan)"}, "explanation": "Pammal translated and adapted Shakespeare's iconic dramas faithfully onto the Tamil proscenium."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu