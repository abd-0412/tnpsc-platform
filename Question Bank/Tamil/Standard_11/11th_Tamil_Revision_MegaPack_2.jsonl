{"id": "11th_tamil_rev2_q038", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "pichamurthi_father_pudhukkavithai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘புதுக்கவிதையின் தந்தை’ என்று தமிழிலக்கிய வரலாற்றில் சிறப்பிக்கப்படுபவர் யார்?", "media_id": null}], "options": {"A": "பாரதியார்", "B": "ந. பிச்சமூர்த்தி", "C": "கு. ப. ராஜகோபாலன்", "D": "புதுமைப்பித்தன்"}, "explanation": "பாரதியாரின் வசன கவிதையைத் தொடர்ந்து தமிழில் புதுக்கவிதை இயக்கத்தைத் தோற்றுவித்து வளர்த்த ந. பிச்சமூர்த்தி 'புதுக்கவிதையின் தந்தை' எனப்படுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Who is venerated as the 'Father of Modern Tamil Free Verse' (Pudhukkavithai)?", "media_id": null}], "options": {"A": "Subramania Bharati", "B": "Na. Pichamurthi", "C": "Ku. Pa. Rajagopalan", "D": "Pudumaipithan"}, "explanation": "Na. Pichamurthi is celebrated as the Father of modern Tamil free verse for establishing it as a distinct literary medium."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 156", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 2", "Pichamurthi", "Title"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev2_q039", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "athmanam_lines", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘காற்றின் தீராத பக்கங்களில் எதையோ எழுதிப் போகிறது சிறகுகள்’ - என்ற கவிதை வரிகளைப் படைத்த நவீனக் கவிஞர் யார்?", "media_id": null}], "options": {"A": "வைரமுத்து", "B": "நா. காமராசன்", "C": "ஆத்மாநாம்", "D": "மு. மேத்தா"}, "explanation": "இயற்கையையும் பறவையின் பறத்தலையும் கவித்துவமாக வெளிப்படுத்தும் இக்கவிதை வரிகள் ஆத்மாநாமின் கவிதைகளில் இடம்பெற்றுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Who penned the evocative lines 'Kaatrin theeraatha pakkangalil ethaiyo ezhudhip pogirathu...'?", "media_id": null}], "options": {"A": "Vairamuthu", "B": "Na. Kamarasan", "C": "Athmanam", "D": "Mu. Metha"}, "explanation": "These minimalist lines were composed by the sensitive modern poet Athmanam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 135, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 135", "url": null, "source_notes": nu