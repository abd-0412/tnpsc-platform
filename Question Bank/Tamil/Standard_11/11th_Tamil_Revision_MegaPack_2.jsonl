{"id": "11th_tamil_rev2_q123", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_interview_proof_names", "chapter_id": null, "topic_id": "proofreading_hash_space", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மெய்ப்புத் திருத்தத்தில் சொற்களுக்கிடையே ‘இடைவெளி விடுக’ (Insert Space) என்பதைக் குறிக்கும் குறியீடு எது?", "media_id": null}], "options": {"A": "Caret (^)", "B": "Dele", "C": "ஹேஷ்டேக் / எண் குறியீடு (#)", "D": "Trans (tr)"}, "explanation": "சொற்களுக்கு இடையில் இடைவெளி விடாமல் ஒட்டி அடித்துவிட்ட பிழையைத் திருத்த '#' (Hash) குறியீடு பயன்படுத்தப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which editorial symbol designates the insertion of space between conjoined words?", "media_id": null}], "options": {"A": "Caret (^)", "B": "Dele", "C": "Hash mark (#)", "D": "Trans (tr)"}, "explanation": "A hash symbol (#) in proofreading indicates that a space must be inserted between words."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 220, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 220", "url": null, "s