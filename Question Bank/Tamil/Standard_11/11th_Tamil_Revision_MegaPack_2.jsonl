{"id": "11th_tamil_rev2_q110", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_sangam_modern_theatre", "chapter_id": null, "topic_id": "inquilab_sirpi_award", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் இன்குலாப்பிற்கு வழங்கப்பட்ட சிறப்பு விருதுகளுள் ஒன்று எது?", "media_id": null}], "options": {"A": "பாரதிதாசன் விருது", "B": "சிற்பி இலக்கிய விருது", "C": "கலைமாமணி விருது மட்டுமே", "D": "தாமரைத்திரு விருது"}, "explanation": "இன்குலாப்பிற்கு இலக்கியத் துறையில் ஆற்றிய தன்னலமற்ற பணிக்காகச் 'சிற்பி இலக்கிய விருது' வழங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which major literary recognition was conferred upon poet Inquilab?", "media_id": null}], "options": {"A": "Bharathidasan Award", "B": "Sirpi Literary Award", "C": "Kalaimamani Award only", "D": "Padma Shri"}, "explanation": "Inquilab was honored with the distinguished Sirpi Literary Award for his outstanding poetry."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 206, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 206", "url": null, "sou