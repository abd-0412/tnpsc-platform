{"id": "11th_tamil_rev2_q057", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_leaders_epic", "chapter_id": null, "topic_id": "jeeva_biography_author", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தோழர் ஜீவானந்தத்தின் வாழ்க்கை வரலாற்றைச் சுவைபட விவரிக்கும் ‘காற்றில் கலந்த பேரோசை’ என்ற நூலை எழுதியவர் யார்?", "media_id": null}], "options": {"A": "சுந்தர ராமசாமி (பசுவய்யா)", "B": "ஜெயகாந்தன்", "C": "வல்லிக்கண்ணன்", "D": "கி. ராஜநாராயணன்"}, "explanation": "தோழர் ஜீவானந்தத்தின் எளிய வாழ்வையும் மேடைப் பேச்சின் ஆளுமையையும் போற்றி சுந்தர ராமசாமி எழுதிய உன்னத நூல் 'காற்றில் கலந்த பேரோசை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Who authored 'Kaattril Kalantha Perosai', the celebrated biographical tribute on Comrade Jeevanandham?", "media_id": null}], "options": {"A": "Sundara Ramaswamy (Pasuvayya)", "B": "Jayakanthan", "C": "Vallikkannan", "D": "Ki. Rajanarayanan"}, "explanation": "Sundara Ramaswamy penned the classic biographical work 'Kaattril Kalantha Perosai' depicting the charismatic life of Comrade Jeeva."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "pa