{"id": "11th_tamil_rev2_q152", "schema_version": "1.0", "kind": "grammar_rule", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u8_grammar_mega_test", "chapter_id": null, "topic_id": "vvanthodar_kutriyalukaram", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வன்தொடர்க் குற்றியலுகரத்தின் பின் வரும் வல்லினம் மிகும்’ - இவிதிக்கான எடுத்துக்காட்டு எது?", "media_id": null}], "options": {"A": "சுக்குத்தூள்", "B": "பட்டுச்சேலை", "C": "பாக்குத்தோட்டம்", "D": "மேற்கண்ட அனைத்தும்"}, "explanation": "சுக்கு, பட்டு, பாக்கு ஆகியவை வன்தொடர்க் குற்றியலுகரங்கள். இவற்றின் பின் வல்லினம் கண்டிப்பாக மிகும் (சுக்குத்தூள், பட்டுச்சேலை, பாக்குத்தோட்டம்)."}, "en": {"blocks": [{"type": "text", "content": "Which of the following serves as an example for 'Vallinam doubles following hard-series Kutriyalukaram'?", "media_id": null}], "options": {"A": "Sukkuth thool", "B": "Pattuch chelaii", "C": "Paakkuth thottam", "D": "All the above"}, "explanation": "All three examples represent Vanthodark Kutriyalukaram which mandatorily double subsequent voiceless stops."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": null, "section": nul