{"id": "11th_tamil_rev2_q014", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_prose_classics", "chapter_id": null, "topic_id": "thanjavur_vimana_weight", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயிலின் விமானத்தின் உச்சியில் வைக்கப்பட்டுள்ள கல்லின் எடை எத்தனை டன்கள் என்று கணக்கிடப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "50 டன்கள்", "B": "80 டன்கள்", "C": "100 டன்கள்", "D": "120 டன்கள்"}, "explanation": "தஞ்சைப் பெரிய கோயிலின் 216 அடி உயர விமானத்தின் உச்சியில் ஏறத்தாழ 80 டன் எடையுள்ள பிரம்மாண்டமான ஒற்றைக் கல் கலசம் நிறுவப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "What is the estimated weight of the single granite block positioned at the peak of the Brihadisvara vimana?", "media_id": null}], "options": {"A": "50 tonnes", "B": "80 tonnes", "C": "100 tonnes", "D": "120 tonnes"}, "explanation": "The monolithic dome capstone sitting atop the 216-foot vimana weighs approximately 80 tonnes."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 146, "chapter": null, "section": null, "reference": "11th Tamil, Unit revisio