{"id": "11th_tamil_rev2_q068", "schema_version": "1.0", "kind": "statement_analysis", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_leaders_epic", "chapter_id": null, "topic_id": "udharan_scaffold_speech", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘புரட்சிக்கவி’ காப்பியத்தில் உதாரன் தூக்கிலிடப்படும் தருவாயில் மக்களிடம் உரைக்கும் எழுச்சி முழக்கம் எது?", "media_id": null}], "options": {"A": "மன்னனை வாழ்த்துங்கள்", "B": "போருக்குச் செல்லுங்கள்", "C": "என்னை மன்னித்து விடுங்கள்", "D": "‘எங்கள் வாழ்வும் எங்கள் வளமும் மங்காத தமிழென்று சங்கே முழங்கு... சாதி மதப் பேதங்களை ஒழித்து குடியாட்சி அமைப்பீர்!’"}, "explanation": "உதாரன் மரண மேடையில் நின்று மன்னனின் கொடுங்கோன்மையை எதிர்த்து மக்களை விழித்தெழச் செய்து குடியாட்சியை நிலைநாட்ட அறைகூவல் விடுக்கிறான்."}, "en": {"blocks": [{"type": "text", "content": "What impassioned slogan does Udharan address to the masses on the scaffold in 'Puratchikkavi'?", "media_id": null}], "options": {"A": "Hail the feudal monarch", "B": "Take up arms for external war", "C": "Forgive my transgressions", "D": "Sound the conch of eternal Tamil prosperity; abolish feudal caste divides and establish republican democracy!"}, "explanation": "Udharan transforms his execution into a political rally demanding sovereign democracy and people's rule."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "sourc