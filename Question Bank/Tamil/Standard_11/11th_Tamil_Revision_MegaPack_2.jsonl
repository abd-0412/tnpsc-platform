{"id": "11th_tamil_rev2_q082", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_leaders_epic", "chapter_id": null, "topic_id": "nandalal_bose_kala_bhavana", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாகூரின் சாந்திநிகேதன் பள்ளியில் கலை மற்றும் ஓவியப் பிரிவை வழிநடத்திப் புகழ்பெற்ற வங்கக் கலைஞர் யார்?", "media_id": null}], "options": {"A": "ஜாமினி ராய்", "B": "நந்தலால் போஸ் (Nandalal Bose)", "C": "அபனிந்திரநாத் தாகூர் மட்டுமே", "D": "ராஜா ரவிவர்மா"}, "explanation": "தாகூரின் அழைப்பை ஏற்று நந்தலால் போஸ் சாந்திநிகேதனின் கலைப் பிரிவான 'கலா பவனத்திற்கு' தலைமை தாங்கி இந்திய மரபுக் கலையை உலகறியச் செய்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which eminent Bengal renaissance master artist headed the Kala Bhavana art department at Shantiniketan?", "media_id": null}], "options": {"A": "Jamini Roy", "B": "Nandalal Bose", "C": "Abanindranath Tagore only", "D": "Raja Ravi Varma"}, "explanation": "Nandalal Bose, master of the Bengal School, shaped Kala Bhavana at Shantiniketan into a world-renowned arts sanctuary."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "p