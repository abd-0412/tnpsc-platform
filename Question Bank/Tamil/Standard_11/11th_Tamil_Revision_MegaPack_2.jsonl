{"id": "11th_tamil_rev2_q134", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_interview_proof_names", "chapter_id": null, "topic_id": "proofreading_transpose_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மெய்ப்புத் திருத்தத்தில் ‘tr’ (Transpose) என்று குறிக்கப்பட்டால் அச்சுக் கோப்பாளர் என்ன செய்ய வேண்டும்?", "media_id": null}], "options": {"A": "எழுத்துகளை நீக்க வேண்டும்", "B": "வரிசை மாறியுள்ள எழுத்துகள் அல்லது சொற்களை இடம் மாற்றி சரியான வரிசையில் வைக்க வேண்டும்", "C": "அச்செழுத்தை தடிமனாக்க வேண்டும்", "D": "அப்படியே விட்டுவிட வேண்டும்"}, "explanation": "'tr' என்பது Transpose என்பதன் சுருக்கம். இடம் மாறி அச்சிடப்பட்ட எழுத்துகள் அல்லது சொற்களை சரியான இடத்திற்கு மாற்றுமாறு அது கட்டளையிடுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What action must a compositor take upon noticing the editorial instruction 'tr' (Transpose)?", "media_id": null}], "options": {"A": "Delete the letter entirely", "B": "Invert or swap transposed letters/words into their proper chronological order", "C": "Make font bold", "D": "Ignore and proceed"}, "explanation": "'tr' commands the reordering of adjacent transposed characters or phrases."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 220, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 220", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 2", "Proofreading", "Transpose"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev2_q135", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_interview_proof_names", "chapter_id": null, "topic_id": "aakkappeyar_agam_place_suffix", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அகம்’ என்னும் இடப்பெயர் பின்னொட்டால் உருவாகும் ஆக்கப்பெயர்களுக்குப் பொருத்தமான சான்று எது?", "media_id": null}], "options": {"A": "பொன்னன்", "B": "கண்ணன்", "C": "நூலகம், மருந்தகம், பதிப்பகம், உணவகம்", "D": "கல்லூரி"}, "explanation": "நூல் + அகம் = நூலகம்; மருந்து + அகம் = மருந்தகம்; பதிப்பு + அகம் = பதிப்பகம்; உணவு + அகம் = உணவகம் என இடம் உணர்த்தும் 'அகம்' பின்னொட்டு இணைந்து பல ஆக்கப்பெயர்களை உருவாக்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which set illustrates location nouns derived by appending the spatial suffix '-Agam'?", "media_id": null}], "options": {"A": "Ponnan", "B": "Kannan", "C": "Noolagam, Marunthagam, Pathippagam, Unavagam", "D": "Kalloori"}, "explanation": "The locative suffix '-Agam' productively forms institutional designations like library, pharmacy, publishing house, restaurant."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024