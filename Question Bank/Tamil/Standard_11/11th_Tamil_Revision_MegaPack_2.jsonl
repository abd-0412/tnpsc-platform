{"id": "11th_tamil_rev2_q059", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_leaders_epic", "chapter_id": null, "topic_id": "puratchikkavi_source", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘புரட்சிக்கவி’ என்னும் காப்பிய நாடகத்தை பாரதிதாசன் எந்த வடமொழி நூலின் கதையைத் தழுவி இயற்றினார்?", "media_id": null}], "options": {"A": "காளிதாசனின் சாகுந்தலம்", "B": "பாஸனின் ஸ்வப்னவாசவதத்தம்", "C": "பில்கணனின் ‘பில்கணீயம்’ (சௌரசுரத பஞ்சாசிகா)", "D": "ஹர்ஷரின் நாகானந்தம்"}, "explanation": "பில்கணனின் காவியக் கதையைத் தழுவி, அரசன்-புலவன்-இளவரசி காதலை ஜனநாயகப் புரட்சியாகவும் சமூக விடுதலையாகவும் மாற்றி பாரதிதாசன் 'புரட்சிக்கவி'யைப் படைத்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which Sanskrit work was adapted by Bharathidasan to compose the revolutionary poem 'Puratchikkavi'?", "media_id": null}], "options": {"A": "Kalidasa's Shakuntala", "B": "Bhasa's Swapnavasavadatta", "C": "Bilhana's 'Bilhaneeyam' (Chaurapanchasika)", "D": "Harsha's Nagananda"}, "explanation": "Bharathidasan adapted the story of Bilhana into a revolutionary anti-feudal narrative of democratic empowerment."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 180, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 180", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 2", "Puratchikkavi", "Bharathidasan"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev2_q060", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_leaders_epic", "chapter_id": null, "topic_id": "tamil_thai_valthu_source", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்த்தாய் வாழ்த்தாக அரசு ஏற்றுக்கொண்ட ‘நீராருங் கடலுடுத்த நிலமடந்தை...’ பாடல் இடம்பெற்ற நாடக நூல் எது?", "media_id": null}], "options": {"A": "சாகுந்தலம்", "B": "பிரதாப முதலியார் சரித்திரம்", "C": "ரூபாவதி", "D": "மனோன்மணீயம்"}, "explanation": "பேராசிரியர் பெ. சுந்தரனார் 1891-இல் இயற்றிய 'மனோன்மணீயம்' என்னும் செய்யுள் நாடக நூலின் தொடக்கப் பாயிரப் பாடலே தமிழக அரசின் தமிழ்த்தாய் வாழ்த்தாகும்."}, "en": {"blocks": [{"type": "text", "content": "In which dramatic work does the Tamil Nadu State Anthem 'Neeraarum Kadaludutha' appear?", "media_id": null}], "options": {"A": "Shakuntalam", "B": "Prathapa Mudaliar Charithiram", "C": "Roopavathi", "D": "Manonmaneeyam"}, "explanation": "The invocation to Tamil in 'Manonmaneeyam' written by Prof. P. Sundaranar in 1891 was adopted as the official State Anthem of Tamil Nadu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 200, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 200", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 2", "Manonmaneeyam", "State Anthem"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev2_q061", "schema_version": "1.0", "kind": "statement_analysis", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_leaders_epic", "chapter_id": null, "topic_id": "manonmaneeyam_structure", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மனோன்மணீயம்’ நாடக நூல் குறித்த கூற்றுகளை ஆராய்க:\n(i) இது லார்ட் லிட்டன் எழுதிய 'The Secret Way' (மறைவழி) என்னும் ஆங்கிலக் கதையைத் தழுவி எழுதப்பட்டது.\n(ii) இது தமிழில் தோன்றிய முதல் பா-வடிவ (செய்யுள்) நாடக நூலாகும்.\n(iii) இந்நாடகம் ஐந்து அங்கங்களையும் இருபது களங்களையும் கொண்டது.", "media_id": null}], "options": {"A": "(i), (ii), (iii) ஆகிய அனைத்தும் சரி", "B": "(i) மற்றும் (ii) மட்டுமே சரி", "C": "(ii) மற்றும் (iii) மட்டுமே சரி", "D": "(i) மற்றும் (iii) மட்டுமே சரி"}, "explanation": "மனோன்மணீயம் ஆசிரியர் பெ. சுந்தரனார். இது லார்ட் லிட்டனின் 'The Secret Way' தழுவல்; 5 அங்கங்கள், 20 களங்கள் கொண்ட செய்யுள் நாடகம். அனைத்தும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements on 'Manonmaneeyam':\n(i) Adapted from Lord Lytton's English work 'The Secret Way'.\n(ii) It is the first verse play written in modern Tamil.\n(iii) It comprises five acts and twenty scenes.", "media_id": null}], "options": {"A": "All (i), (ii), and (iii) are correct", "B": "Only (i) and (ii) are correct", "C": "Only (ii) and (iii) are correct", "D": "Only (i) and (iii) are correct"}, "explanation": "All three facts are fully accurate regarding Sundaranar's landmark verse drama Manonmaneeyam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 201, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 201", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 2", "Manonmaneeyam", "Drama Analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
