{"id": "11th_tamil_rev2_q087", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_sangam_modern_theatre", "chapter_id": null, "topic_id": "muthukumar_tolainthu_ponavargal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தொலைந்து போனவர்கள்’ என்னும் கவிதையில் நவீன மனிதனின் இயந்திரமயமான வாழ்வை விமர்சித்த கவிஞர் யார்?", "media_id": null}], "options": {"A": "நா. காமராசன்", "B": "மு. மேத்தா", "C": "நா. முத்துக்குமார்", "D": "வைரமுத்து"}, "explanation": "நவீன நகர வாழ்க்கையில் மனிதர்கள் தம் அடையாளங்களையும் இயற்கையுடனான உறவையும் தொலைத்துவிட்டு இயந்திரம்போல் வாழ்வதை நா. முத்துக்குமார் 'தொலைந்து போனவர்கள்' கவிதையில் உருக்கமாகப் பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which poet critiqued the alienated, mechanized existence of urban humans in 'Tolainthu Ponavargal'?", "media_id": null}], "options": {"A": "Na. Kamarasan", "B": "Mu. Metha", "C": "Na. Muthukumar", "D": "Vairamuthu"}, "explanation": "Na. Muthukumar poignantly encapsulated modern alienation in his poem 'Tolainthu Ponavargal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 210, "chapter"