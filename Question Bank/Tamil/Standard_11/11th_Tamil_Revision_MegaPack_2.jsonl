{"id": "11th_tamil_rev2_q091", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_sangam_modern_theatre", "chapter_id": null, "topic_id": "inquilab_avvai_drama", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இன்குலாப் சங்க காலப் பெண் புலவர் ஔவையாரின் வாழ்வை மறுவாசிப்பு செய்து படைத்த புகழ்பெற்ற நாடகம் எது?", "media_id": null}], "options": {"A": "மனுசங்கடா", "B": "குரல்கள்", "C": "ஔவை", "D": "காந்தள் நாட்கள்"}, "explanation": "இன்குலாப் பெண்ணிய மற்றும் விளிம்புநிலை நோக்கில் சங்க கால ஔவையை ஒரு சுதந்திரமான நாடோடிப் பாடகியாக மீளுருவாக்கம் செய்து எழுதிய நாடகம் 'ஔவை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which celebrated play by Inquilab radically reinterpreted the Sangam poet Avvaiyar from a feminist perspective?", "media_id": null}], "options": {"A": "Manusangada", "B": "Kuralkal", "C": "Avvai", "D": "Kaanthal Naatkal"}, "explanation": "Inquilab authored the pathbreaking subaltern feminist drama titled 'Avvai'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 206, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2,