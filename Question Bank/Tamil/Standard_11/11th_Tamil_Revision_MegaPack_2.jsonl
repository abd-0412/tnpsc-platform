{"id": "11th_tamil_rev2_q090", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_sangam_modern_theatre", "chapter_id": null, "topic_id": "muthukumar_national_awards", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் நா. முத்துக்குமார் சிறந்த திரைப்படப் பாடலாசிரியருக்கான தேசிய விருதை எத்தனை முறை வென்றுள்ளார்?", "media_id": null}], "options": {"A": "ஒரு முறை", "B": "இரண்டு முறை (தங்க மீன்கள், சைவம்)", "C": "மூன்று முறை", "D": "நான்கு முறை"}, "explanation": "நா. முத்துக்குமார் 'தங்க மீன்கள்' (ஆனந்த யாழை மீட்டுகிறாய்), 'சைவம்' (அழகே அழகே) ஆகிய படங்களின் பாடல்களுக்காக இருமுறை சிறந்த பாடலாசிரியருக்கான தேசிய விருது பெற்றார்."}, "en": {"blocks": [{"type": "text", "content": "How many times did poet Na. Muthukumar win the National Film Award for Best Lyricist?", "media_id": null}], "options": {"A": "Once", "B": "Twice (Thanga Meengal, Saivam)", "C": "Three times", "D": "Four times"}, "explanation": "Na. Muthukumar received two National Film Awards for Best Lyrics for 'Thanga Meengal' and 'Saivam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 211, "chapter": null, "s