{"id": "11th_tamil_rev2_q067", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_leaders_epic", "chapter_id": null, "topic_id": "jeeva_janasakthi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தோழர் ஜீவா எந்த இதழின் ஆசிரியராகப் பணியாற்றி சமூக சமத்துவச் சிந்தனைகளை விதைத்தார்?", "media_id": null}], "options": {"A": "குடியரசு", "B": "விடுதலை", "C": "ஜனசக்தி", "D": "சுதேசமித்திரன்"}, "explanation": "தோழர் ஜீவா தொழிலாளர்கள் மற்றும் ஒடுக்கப்பட்ட மக்களின் குரலாக விளங்கிய 'ஜனசக்தி' நாளிதழின் ஆசிரியராகப் பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Which newspaper/periodical was edited by Comrade Jeeva to champion social equality and labor rights?", "media_id": null}], "options": {"A": "Kudi Arasu", "B": "Viduthalai", "C": "Janasakthi", "D": "Swadesamitran"}, "explanation": "Comrade Jeeva served as the fearless chief editor of the progressive daily 'Janasakthi'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 176, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 176", "url": null, "source_notes": null}, "pr