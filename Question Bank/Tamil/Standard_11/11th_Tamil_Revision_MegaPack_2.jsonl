{"id": "11th_tamil_rev2_q140", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_interview_proof_names", "chapter_id": null, "topic_id": "thirukkural_kudi_uyarvu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘குற்றம் இலனாய்க் குடிசெய்து வாழ்வானைச்\nசுற்றமாச் சூழும் உலகு’ - இக்குறட்பா உணர்த்தும் கருத்து யாது?", "media_id": null}], "options": {"A": "செல்வம் உள்ளவரை உலகம் போற்றும்", "B": "அரசன் அனைவரையும் காப்பான்", "C": "பகைவரை வீழ்த்த வேண்டும்", "D": "குற்றமற்றவனாய்த் தன் குடும்பத்தை மேன்மையுறச் செய்து வாழ்பவனை உலகத்தார் உறவாகக் கொண்டு கொண்டாடுவர்"}, "explanation": "தவறான செயல்கள் எதையும் செய்யாமல் தன் குடும்பத்தையும் நாட்டையும் உயர்த்த உழைக்கும் உயர்ந்த மனிதனை உலக மக்கள் அனைவரும் தம் சொந்த உறவாக ஏற்றுப் போற்றுவர்."}, "en": {"blocks": [{"type": "text", "content": "What profound moral truth is articulated in the verse on uplifting one's family without blemish?", "media_id": null}], "options": {"A": "The world respects only rich hoarders", "B": "The king guards all souls", "C": "Defeat all enemies", "D": "The world warmly embraces as kin one who lives blamelessly while elevating their family and society"}, "explanation": "All the world enthusiastically adopts as family one who lives a spotless life devoted to social elevation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": f