{"id": "11th_tamil_rev2_q133", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_interview_proof_names", "chapter_id": null, "topic_id": "narthaki_nataraj_tamil_music_dance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நர்த்தகி நடராஜ் பரதநாட்டியத்தில் எவ்வகைப் பாடல்களுக்கு முதன்மை அளித்து நடனமாடி வருகிறார்?", "media_id": null}], "options": {"A": "தேவாரம், திருவாசகம், சங்க இலக்கியம், பாரதியார் பாடல்கள் உள்ளிட்ட தமிழ்ப் பாடல்களுக்கு", "B": "மேற்கத்திய இசைக்கு மட்டுமே", "C": "சமஸ்கிருத சுலோகங்களுக்கு மட்டுமே", "D": "திரைப்பட மெட்டுகளுக்கு மட்டுமே"}, "explanation": "நர்த்தகி நடராஜ் தமிழ்ச் செவ்வியல் பக்தி இலக்கியங்களான தேவாரம், திருவாசகம், திவ்வியப் பிரபந்தம், சங்கப் பாடல்களுக்கு நடன அமைப்பினை வழங்கித் தமிழின் மேன்மையை உலகரங்கில் பரப்பி வருகிறார்."}, "en": {"blocks": [{"type": "text", "content": "To which lyrical tradition does Narthaki Nataraj give primary choreographic performance expression?", "media_id": null}], "options": {"A": "Classical Tamil literature including Thevaram, Thiruvasagam, Sangam verses, and Bharathiyar's poetry", "B": "Western pop music only", "C": "Sanskrit slokas only", "D": "Cinema tunes only"}, "explanation": "She champions authentic Tamil classical hymns and Sangam poetry in her worldwide Bharatanatyam recitals."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_