{"id": "11th_tamil_rev2_q045", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "uvamaithogai_vallinam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உவமைத் தொகையில் வல்லினம் மிகும்’ - இவிதிக்குப் பொருத்தமான எடுத்துக்காட்டு எது?", "media_id": null}], "options": {"A": "தாமரைக்கண், மலர்க்கை", "B": "மலரடி, கயல்விழி", "C": "தேன்மொழி, பவளவாய்", "D": "முத்துப்பல், வில்புருவம்"}, "explanation": "உவமைத் தொகையில் வருமொழி வல்லினமாக இருக்கும்போது வல்லினம் மிகும் (தாமரை + கண் = தாமரைக்கண்; மலர் + கை = மலர்க்கை)."}, "en": {"blocks": [{"type": "text", "content": "Which phrase exemplifies the rule 'Vallinam doubles in simile compounds (Uvamai Thogai)'?", "media_id": null}], "options": {"A": "Thamaraikkan, Malarkkai", "B": "Malaradi, Kayalvizhi", "C": "Thenmozhi, Pavazhavaai", "D": "Muthuppal, Vilpuruvam"}, "explanation": "Vallinam doubles in metaphorical simile compounds when encountering voiceless plosives."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": null, "section": null, "reference": "11th Tamil, Unit