{"id": "11th_tamil_rev2_q109", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_sangam_modern_theatre", "chapter_id": null, "topic_id": "pathitrupathu_poets_kings_count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பதிற்றுப்பத்தில் இடம்பெற்றுள்ள மொத்தப் பாடல்களின் எண்ணிக்கை மற்றும் பாடப்பட்ட மன்னர்களின் எண்ணிக்கை எத்தனை?", "media_id": null}], "options": {"A": "கிடைத்த பாடல்கள் 80 (மொத்தம் 100) - பாடப்பட்ட சேர மன்னர்கள் 10 பேர்", "B": "மொத்தம் 400 பாடல்கள் - பாண்டிய மன்னர்கள்", "C": "மொத்தம் 50 பாடல்கள் - சோழ மன்னர்கள்", "D": "மொத்தம் 150 பாடல்கள் - பல்லவ மன்னர்கள்"}, "explanation": "பத்துப் பத்துகளாக 100 பாடல்கள் கொண்ட இந்நூலில் 10 சேர மன்னர்கள் பாடப்பட்டனர்; தற்போது 80 பாடல்கள் மட்டுமே கிடைக்கின்றன."}, "en": {"blocks": [{"type": "text", "content": "What is the total song count and the number of Chera sovereigns panegyrized in Pathitrupathu?", "media_id": null}], "options": {"A": "Surviving 80 songs (out of 100) - praising 10 Chera kings", "B": "400 songs - Pandya kings", "C": "50 songs - Chola kings", "D": "150 songs - Pallava kings"}, "explanation": "Ten Chera kings were originally eulogized across 100 poems arranged in decads, of which 80 verses survive."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samachee