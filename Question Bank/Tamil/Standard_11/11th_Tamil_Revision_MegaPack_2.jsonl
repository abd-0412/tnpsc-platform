{"id": "11th_tamil_rev2_q106", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_sangam_modern_theatre", "chapter_id": null, "topic_id": "inquilab_nature_humanity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஒவ்வொரு புல்லையும் பெயர் சொல்லி அழைப்பேன்’ என்ற கவிதையில் இன்குலாப் வெளிப்படுத்தும் முதன்மை உணர்வு எது?", "media_id": null}], "options": {"A": "மன்னர் மீதான பக்தி", "B": "இயற்கையின் மீதான பேரன்பும் உலகளாவிய உயிரின சமத்துவமும்", "C": "பொருளாதார பேராசை", "D": "தனிமைத் துயர்"}, "explanation": "புல், பூண்டு, பறவை, எளிய மனிதர்கள் அனைவரையும் சமமாக நேசிக்கும் இயற்கையியல் சமத்துவ உணர்வை இன்குலாப் இக்கவிதையில் பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "What primary philosophical sentiment is articulated in Inquilab's 'Ovvoru Pullaiyum Peyar Solli Azhaippen'?", "media_id": null}], "options": {"A": "Devotion to royal monarchs", "B": "Profound ecological love and universal egalitarian compassion", "C": "Economic greed", "D": "Desolate isolation"}, "explanation": "The poem articulates a radical ecological humanism embracing every blade of grass and living creature."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation"