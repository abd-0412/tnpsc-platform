{"id": "11th_tamil_rev2_q056", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "urichol_vallinam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சால, உறு, தவ, நனி’ முதலிய உரிச்சொற்களின் பின் வல்லினம் என்னவாகும்?", "media_id": null}], "options": {"A": "இயல்பாகும்", "B": "மெல்லினமாக மாறும்", "C": "எப்போதும் மிகாது", "D": "வல்லினம் கண்டிப்பாக மிகும்"}, "explanation": "சால, உறு, தவ, நனி முதலிய உரிச்சொற்களின் பின் வல்லினம் கண்டிப்பாக மிகும் (எ.கா: சாலப் பேசினான், தவப் பெரிது)."}, "en": {"blocks": [{"type": "text", "content": "What occurs to Vallinam following qualifying particle prefixes (Urichorkal) such as Saala, Uru, Thava, Nani?", "media_id": null}], "options": {"A": "Remains unchanged", "B": "Transforms to soft nasal", "C": "Never doubles", "D": "Mandatorily doubles"}, "explanation": "Vallinam always doubles after qualifying adverbial particles (Urichol) like Saala, Thava."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2,