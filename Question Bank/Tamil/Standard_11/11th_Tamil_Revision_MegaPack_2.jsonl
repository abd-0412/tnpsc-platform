{"id": "11th_tamil_rev2_q088", "schema_version": "1.0", "kind": "statement_analysis", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_sangam_modern_theatre", "chapter_id": null, "topic_id": "theatre_pioneers_analysis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் நாடக முன்னோடிகள் குறித்த கூற்றுகளை ஆராய்க:\n(i) 'தமிழ் நாடகத் தந்தை' என்று போற்றப்படுபவர் பம்மல் சம்பந்த முதலியார்.\n(ii) 'தமிழ் நாடகத் தலைமை ஆசிரியர்' என்று அழைக்கப்படுபவர் சங்கரதாஸ் சுவாமிகள்.\n(iii) தமிழில் முதன்முதலில் அறிவியல் முறையில் நாடக இலக்கணம் வகுத்து 'நாடகவியல்' என்னும் நூலை எழுதியவர் பரிதிமாற்கலைஞர்.", "media_id": null}], "options": {"A": "(i) மற்றும் (ii) மட்டுமே சரி", "B": "(ii) மற்றும் (iii) மட்டுமே சரி", "C": "(i) மற்றும் (iii) மட்டுமே சரி", "D": "(i), (ii), (iii) ஆகிய அனைத்தும் சரி"}, "explanation": "தமிழ் நாடக வரலாற்றில் மூவரும் தனிப்பெரும் பங்களிப்பை வழங்கிய முன்னோடிகள் ஆவர். அனைத்துக் கூற்றுகளும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on pioneers of Tamil theatre:\n(i) Pammal Sambandha Mudaliar is celebrated as the Father of Tamil Drama.\n(ii) Sankaradas Swamigal is revered as the Headmaster of Tamil Theatre.\n(iii) Parithimaar Kalaignar formulated classical dramatic theory in his work 'Natagaviyal'.", "media_id": null}], "options": {"A": "Only (i) and (ii) are correct", "B": "Only (ii) and (iii) are correct", "C": "Only (i) and (iii) are correct", "D": "All (i), (ii), and (iii) are correct"}, "explanation": "All statements regarding the revered titles and scholarly contributions to Tamil theatre are accurate."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 188, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 188", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 2", "Tamil Theatre", "Pioneers"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
