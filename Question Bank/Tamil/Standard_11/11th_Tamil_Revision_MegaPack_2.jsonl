{"id": "11th_tamil_rev2_q013", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_prose_classics", "chapter_id": null, "topic_id": "anandarangar_manuscripts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆனந்தரங்கரின் நாட்குறிப்பை முதன்முதலில் தமிழில் பதிப்பித்து வெளியிட்ட வரலாற்று முயற்சிகள் எங்கு தொடங்கின?", "media_id": null}], "options": {"A": "பாண்டிச்சேரி ஆவணக் காப்பகக் கையெழுத்துப் பிரதிகளை அடிப்படையாகக் கொண்டு அறிஞர்களால் பதிப்பிக்கப்பட்டது", "B": "இலண்டன் பிரிட்டிஷ் அருங்காட்சியகத்தில் மட்டும்", "C": "தஞ்சை சரசுவதி மகாலில் மட்டும்", "D": "மதுரைத் தமிழ்ச் சங்கத்தில் மட்டும்"}, "explanation": "ஆனந்தரங்கரின் நாட்குறிப்பு கையெழுத்துப் பிரதிகள் பாண்டிச்சேரி நூலகத்திலிருந்து கண்டெடுக்கப்பட்டு பின்னர் வரலாற்று அறிஞர்களால் தொகுத்துப் பதிப்பிக்கப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "Where did the foundational archival and editorial efforts to publish Anandarangar's diary begin?", "media_id": null}], "options": {"A": "Published by scholars based on archival manuscripts discovered in Pondicherry archives", "B": "Solely in the British Museum, London", "C": "Solely in Thanjavur Saraswathi Mahal", "D": "Solely in Madurai Tamil Sangam"}, "explanation": "The historical diaries were preserved in archival collections in Pondicherry and published by dedicated manuscript scholars."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "mar