{"id": "11th_tamil_rev2_q124", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_interview_proof_names", "chapter_id": null, "topic_id": "aakkappeyar_maan_suffix", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மான்’ என்னும் பின்னொட்டு பெற்று வரும் ஆக்கப்பெயருக்குச் சான்று எது?", "media_id": null}], "options": {"A": "வருமானம்", "B": "தேய்மானம்", "C": "கட்டுமானம்", "D": "மேற்கண்ட அனைத்தும்"}, "explanation": "வரு + மான் = வருமானம்; தேய் + மான் = தேய்மானம்; கட்டு + மான் = கட்டுமானம் என வினை வேர்களோடு 'மான்' பின்னொட்டு இணைந்து தொழிற்பெயர் ஆக்கப்பெயர்களாகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Which words exemplify derived nominals ending in the deverbal suffix '-Maan'?", "media_id": null}], "options": {"A": "Varumaanam (Income)", "B": "Theiymaanam (Depreciation)", "C": "Kattumaanam (Construction)", "D": "All the above"}, "explanation": "The nominalizing suffix '-Maan' derives abstract verbal nouns from verb roots."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 191, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 191", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 2", "Aakkappeyar", "Maan Suffix"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev2_q125", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_interview_proof_names", "chapter_id": null, "topic_id": "thirukkural_marunthu_kural", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மருந்தென வேண்டாவாம் யாக்கைக்கு அருந்தியது\nஅற்றது போற்றி உணின்’ - இக்குறட்பா உணர்த்தும் அடிப்படை வாழ்வியல் உண்மை யாது?", "media_id": null}], "options": {"A": "முன் உண்ட உணவு செரித்ததை அறிந்து பின்னரே உண்ண வேண்டும்; அவ்வாறு உண்டால் உடலுக்கு மருந்தே தேவையில்லை", "B": "மருந்து தினமும் உண்ண வேண்டும்", "C": "பசியோடு இருக்க வேண்டும்", "D": "சுவையான உணவை மட்டுமே உண்ண வேண்டும்"}, "explanation": "முன்பு சாப்பிட்ட உணவு செரித்துவிட்டதை உறுதி செய்துவிட்டு அடுத்த வேளை உணவை உண்பவனுக்கு எந்த மருந்தும் தேவைப்படாது என்று திருவள்ளுவர் தெளிவுறுத்துகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What foundational health guideline is proclaimed in the Thirukkural chapter on Medicine (Marunthu)?", "media_id": null}], "options": {"A": "Wait till previous food is fully digested before dining again; then no medicine is ever required", "B": "Medicines must be taken daily", "C": "Remain starving forever", "D": "Eat only rich delicacies"}, "explanation": "Valluvar states that one who waits until previous digestion is complete needs no pharmacopeia."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 226, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 226", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 2", "Thirukkural", "Health"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
