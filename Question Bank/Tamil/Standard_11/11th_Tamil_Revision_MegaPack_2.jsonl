{"id": "11th_tamil_rev2_q008", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_prose_classics", "chapter_id": null, "topic_id": "thirukoodarasappar_birthplace", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘திரிகூடராசப்பக் கவிராயர்’ எந்த ஊரில் பிறந்தார்?", "media_id": null}], "options": {"A": "எட்டயபுரம்", "B": "மதுரை", "C": "திருநெல்வேலி", "D": "மேலகரம்"}, "explanation": "குற்றாலக் குறவஞ்சியை இயற்றிய திரிகூடராசப்பக் கவிராயர் திருநெல்வேலி மாவட்டம் தென்காசிக்கு அருகிலுள்ள 'மேலகரம்' என்னும் ஊரில் பிறந்தார்."}, "en": {"blocks": [{"type": "text", "content": "In which place was Thirukoodarasappa Kavirayar born?", "media_id": null}], "options": {"A": "Ettayapuram", "B": "Madurai", "C": "Tirunelveli", "D": "Melagaram"}, "explanation": "Thirukoodarasappa Kavirayar, author of Thirukuttrala Kuravanji, was born in Melagaram near Tenkasi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 131, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 131", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam":