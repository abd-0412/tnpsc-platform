{"id": "11th_tamil_rev2_q093", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_sangam_modern_theatre", "chapter_id": null, "topic_id": "pathitrupathu_gift_kannanaar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரண்டாம் பத்தைப் பாடிய குமட்டூர்க் கண்ணனாருக்கு இமயவரம்பன் நெடுஞ்சேரலாதன் பரிசாக வழங்கியது எது?", "media_id": null}], "options": {"A": "உம்பற்காட்டு ஐந்நூறு ஊர்களும், தென்னாட்டு வருவாயில் பாகமும்", "B": "பொன் நாணயங்கள் மட்டுமே", "C": "யானைப்படை மட்டுமே", "D": "தங்க மணிமுடி"}, "explanation": "பதிற்றுப்பத்து பதிகத்தின்படி குமட்டூர்க் கண்ணனாருக்கு உம்பற்காட்டு 500 ஊர்களையும், தென்னாட்டு வருவாயில் பாதியையும் நெடுஞ்சேரலாதன் பரிசாக அளித்தான்."}, "en": {"blocks": [{"type": "text", "content": "What lavish royal gift did Imayavaramban Neduncheralathan grant poet Kumattur Kannanar?", "media_id": null}], "options": {"A": "500 villages in the Umbarkadu territory and a share of southern kingdom revenues", "B": "Gold coins only", "C": "Elephant contingent only", "D": "Golden crown"}, "explanation": "The pathigam records that the king rewarded the poet with 500 villages in Umbarkadu and revenue endowments."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational