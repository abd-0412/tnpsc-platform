{"id": "11th_tamil_rev2_q027", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_prose_classics", "chapter_id": null, "topic_id": "thirukoodarasappar_land_grant", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘திரிகூடராசப்பக் கவிராயருக்குக் குற்றாலக் குறவஞ்சியைப் பாராட்டி வழங்கப்பட்ட நிலக்கொடை எவ்வாறு அழைக்கப்பட்டது?", "media_id": null}], "options": {"A": "வீரகேரளப் புறவு", "B": "பவளக்குன்றுப் புறவு", "C": "குறவஞ்சிமேடு (குறவஞ்சிப் புறவு)", "D": "செண்பகப் புறவு"}, "explanation": "மதுரை சொக்கநாத நாயக்கர் திரிகூடராசப்பக் கவிராயருக்குக் குறவஞ்சியைப் பாராட்டி குற்றாலத்திற்கு அருகில் நிலக்கொடை வழங்கி அதை 'குறவஞ்சிமேடு' என்று அழைத்தனர்."}, "en": {"blocks": [{"type": "text", "content": "How was the land grant bestowed upon Thirukoodarasappa Kavirayar for composing Kutrala Kuravanji known?", "media_id": null}], "options": {"A": "Veerakeralappuravu", "B": "Pavalakkuntruppuravu", "C": "Kuravanjimedu (Kuravanji Puravu)", "D": "Shenbagappuravu"}, "explanation": "Madurai ruler bestowed revenue land in honor of the work, known as Kuravanjimedu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2