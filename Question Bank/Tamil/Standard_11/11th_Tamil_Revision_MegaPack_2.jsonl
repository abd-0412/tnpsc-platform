{"id": "11th_tamil_rev2_q051", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "pichamurthi_pseudonym", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ந. பிச்சமூர்த்தி தன் படைப்புகளுக்குப் பயன்படுத்திய புனைபெயர்களுள் ஒன்று எது?", "media_id": null}], "options": {"A": "வேளூர் கிழார்", "B": "பானுசந்திரன்", "C": "பிக்ஷு", "D": "பசுவய்யா"}, "explanation": "ந. பிச்சமூர்த்தி 'பிக்ஷு', 'ரேவதி' ஆகிய புனைபெயர்களில் பல புகழ்பெற்ற கதைகளையும் கவிதைகளையும் எழுதியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following was a well-known pseudonym used by Na. Pichamurthi?", "media_id": null}], "options": {"A": "Velur Kizhar", "B": "Bhanuchandran", "C": "Bhikshu", "D": "Pasuvayya"}, "explanation": "Na. Pichamurthi wrote under pseudonyms including 'Bhikshu' and 'Revathi'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 156", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam"