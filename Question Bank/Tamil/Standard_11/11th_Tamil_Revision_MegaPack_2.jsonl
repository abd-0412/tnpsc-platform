{"id": "11th_tamil_rev2_q147", "schema_version": "1.0", "kind": "statement_analysis", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u8_grammar_mega_test", "chapter_id": null, "topic_id": "punctuation_rules", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நிறுத்தற்குறிகள் பற்றிய கூற்றுகளில் சரியானதைத் தேர்க:\n(i) வினாப் பொருளைத் தரும் வாக்கியத்தின் இறுதியில் வினாக்குறி (?) இட வேண்டும்.\n(ii) வியப்பு, அச்சம், மகிழ்ச்சி போன்ற உணர்ச்சிகளை வெளிப்படுத்தும் தொடரின் இறுதியில் உணர்ச்சிக்குறி (!) இட வேண்டும்.\n(iii) பிறர் கூறியதை அப்படியே மேற்கோளாகக் காட்டும் போது ஒற்றை அல்லது இரட்டை மேற்கோள்குறி (“...”) பயன்படுத்த வேண்டும்.", "media_id": null}], "options": {"A": "(i) மற்றும் (ii) மட்டுமே சரி", "B": "(ii) மற்றும் (iii) மட்டுமே சரி", "C": "(i), (ii), (iii) ஆகிய அனைத்தும் சரி", "D": "(i) மட்டுமே சரி"}, "explanation": "நிறுத்தற்குறிகள் வாக்கியங்களின் பொருளைத் தெளிவுபடுத்தும் இன்றியமையாத கூறுகளாகும். மேற்கண்ட மூன்று விதிகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Select the correct rules regarding standard punctuation usage:\n(i) Interrogative sentences terminate with a question mark (?).\n(ii) Sentences expressing intense emotion or surprise end with an exclamation mark (!).\n(iii) Direct quotations must be enclosed within quotation marks (“...”).", "media_id": null}], "options": {"A": "Only (i) and (ii) are correct", "B": "Only (ii) and (iii) are correct", "C": "All (i), (ii), and (iii) are correct", "D": "Only (i) is correct"}, "explanation": "All three statements accurately state standard grammatical punctuation protocols."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 222, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 222", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 2", "Punctuation", "Grammar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev2_q148", "schema_version": "1.0", "kind": "grammar_identification", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u8_grammar_mega_test", "chapter_id": null, "topic_id": "aakkappeyar_suffix_identification", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உடைமை, உறவு, தொடர்பு’ ஆகியவற்றை உணர்த்தும் ஆக்கப்பெயர்ப் பின்னொட்டு எது?", "media_id": null}], "options": {"A": "அகம்", "B": "இயல்", "C": "மான்", "D": "காரன், காரி, உடையவர்"}, "explanation": "பொருளின் உடமையையோ அல்லது தொடர்பையோ உணர்த்த 'காரன், காரி' போன்ற பின்னொட்டுகள் பயன்படுகின்றன (எ.கா: நிலக்காரன், பால்காரி)."}, "en": {"blocks": [{"type": "text", "content": "Which nominalizing suffixes indicate possession, kinship, or professional connection?", "media_id": null}], "options": {"A": "-Agam", "B": "-Iyal", "C": "-Maan", "D": "-Kaaran, -Kaari, -Udaiyavar"}, "explanation": "Suffixes '-Kaaran' and '-Kaari' signify possession, association, or trade."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 191, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 191", "url": null, "source_notes": null}, "previous_yea