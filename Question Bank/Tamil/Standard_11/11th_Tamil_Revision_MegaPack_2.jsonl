{"id": "11th_tamil_rev2_q146", "schema_version": "1.0", "kind": "grammar_identification", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u8_grammar_mega_test", "chapter_id": null, "topic_id": "vallinam_migum_check", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் தொடர்களுள் வல்லினம் மிக வேண்டிய இடத்தில் மிகாமல் வந்துள்ள பிழையான தொடர் எது?", "media_id": null}], "options": {"A": "செம்பவளம்", "B": "கடைக்கு சென்றான்", "C": "மண்பாண்டம்", "D": "பொன்வண்டு"}, "explanation": "‘கடைக்கு’ என்பது நான்காம் வேற்றுமை உருபு (கு) வெளிப்பட்டு வந்த தொடர். நான்காம் வேற்றுமை விரியின் பின் வல்லினம் மிக வேண்டும். 'கடைக்குச் சென்றான்' என்றே எழுத வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the phrase that incorrectly OMITS required sandhi doubling:", "media_id": null}], "options": {"A": "Sempavazham", "B": "Kadaikku sentraan", "C": "Manpaandam", "D": "Ponvandu"}, "explanation": "'Kadaikku' carries the overt 4th case marker '-ku' which mandatorily demands doubling ('Kadaikku-ch chentraan')."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": null, "section": null, "reference": "11th Tamil, Uni