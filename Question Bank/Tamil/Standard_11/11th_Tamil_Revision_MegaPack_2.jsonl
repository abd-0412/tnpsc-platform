{"id": "11th_tamil_rev2_q026", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_prose_classics", "chapter_id": null, "topic_id": "anandarangar_dupleix", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆனந்தரங்கர் நாட்குறிப்பில் குறிப்பிடப்படும் ‘துய்ப்ளே’ (Dupleix) என்பவர் யார்?", "media_id": null}], "options": {"A": "ஆங்கிலேயக் கப்பல் படைத் தளபதி", "B": "பிரெஞ்சு இந்திய ஒன்றியத்தின் கவர்னர் (ஆளுநர்)", "C": "டச்சுக் கிழக்கிந்திய வணிகத் தலைவர்", "D": "போர்ச்சுகீசிய மதப் போதகர்"}, "explanation": "ஜோசப் பிரான்சுவா துய்ப்ளே என்பவர் பாண்டிச்சேரியின் பிரெஞ்சு கவர்னராக 1742 முதல் 1754 வரை திறம்பட ஆட்சி செய்தவர்; ஆனந்தரங்கர் இவரது தலைமைத் துபாஷியாக இருந்தார்."}, "en": {"blocks": [{"type": "text", "content": "Who was Dupleix, frequently chronicled in Anandarangar's diary?", "media_id": null}], "options": {"A": "English naval captain", "B": "Governor-General of French India", "C": "Dutch commercial director", "D": "Portuguese missionary"}, "explanation": "Joseph Francois Dupleix was the prominent Governor-General of French establishments in India."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "editio