{"id": "11th_tamil_rev2_q058", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_leaders_epic", "chapter_id": null, "topic_id": "tagore_letters_recipient", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாகூர் தன் கடிதங்களை யாருக்கு எழுதினார்? அக்கடிதங்கள் இயற்கையோடு இணைந்த எந்தப் பள்ளியின் உருவாக்கத்தை விளக்குகின்றன?", "media_id": null}], "options": {"A": "தன் மகனுக்கு - கொல்கத்தா கல்லூரி", "B": "தன் உடன்பிறந்தாரின் மகள் இந்திரா தேவிக்கு - சாந்திநிகேதன் (விஸ்வபாரதி)", "C": "மகாத்மா காந்திக்கு - சபர்மதி ஆசிரமம்", "D": "சுபாஷ் சந்திர போஸுக்கு - தேசிய இராணுவம்"}, "explanation": "தாகூர் தன் அண்ணன் மகள் இந்திரா தேவிக்கு பத்மா நதிக்கரையில் படகில் வாழ்ந்த காலங்களில் எழுதிய கடிதங்கள் சாந்திநிகேதன் உருவாவதற்கான சிந்தனைக் கருவூலமாகும்."}, "en": {"blocks": [{"type": "text", "content": "To whom did Rabindranath Tagore address his reflective letters, and which alternative forest institution do they describe?", "media_id": null}], "options": {"A": "To his son - Calcutta College", "B": "To his niece Indira Devi - Shantiniketan (Visva-Bharati)", "C": "To Mahatma Gandhi - Sabarmati Ashram", "D": "To Subhas Chandra Bose - Indian National Army"}, "explanation": "Tagore wrote poetic, observational letters from the Padma river to his niece Indira Devi, reflecting the core ideals of Shantiniketan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5,