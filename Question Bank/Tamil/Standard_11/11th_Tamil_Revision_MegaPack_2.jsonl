{"id": "11th_tamil_rev2_q139", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_interview_proof_names", "chapter_id": null, "topic_id": "narthaki_nataraj_foreign_lectures", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நர்த்தகி நடராஜ் பரதநாட்டியக் கலை குறித்து சொற்பொழிவுகளும் செயல்முறை விளக்கங்களும் ஆற்றிய உலக நாடுகள் எவை?", "media_id": null}], "options": {"A": "அமெரிக்கா மற்றும் கனடா மட்டுமே", "B": "இலங்கை மற்றும் மலேசியா மட்டுமே", "C": "அமெரிக்கா, இங்கிலாந்து, பிரான்ஸ், ஜெர்மனி உள்ளிட்ட ஐரோப்பிய, ஆசிய நாடுகள்", "D": "ஆப்பிரிக்க நாடுகள் மட்டுமே"}, "explanation": "நர்த்தகி நடராஜ் உலகெங்கிலும் உள்ள பல்கலைக்கழகங்கள் மற்றும் கலாச்சார மையங்களில் தஞ்சை நாட்டியக் கலை குறித்து உரையாற்றி அரங்கேற்றியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Across which global regions has Narthaki Nataraj delivered lecture-demonstrations and classical performances?", "media_id": null}], "options": {"A": "Only the USA and Canada", "B": "Only Sri Lanka and Malaysia", "C": "USA, UK, France, Germany, and numerous European and Asian nations", "D": "Only African nations"}, "explanation": "She has conducted lecture-demonstrations across premier cultural institutions in North America, Europe, and Asia."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_