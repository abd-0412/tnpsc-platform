{"id": "11th_tamil_rev2_q049", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "athmanam_anthology", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆத்மாநாமின் முழுமையான கவிதைகள் எந்தத் தலைப்பில் தொகுக்கப்பட்டு வெளிவந்துள்ளன?", "media_id": null}], "options": {"A": "ஆத்மாநாம் கவிதைகள்", "B": "காகிதத்தில் ஒரு கோடு", "C": "ழ தொகுப்பு", "D": "மௌனத்தின் குரல்"}, "explanation": "அவரது மறைவுக்குப் பின் அவர் எழுதிய அனைத்துக் கவிதைகளும் 'ஆத்மாநாம் கவிதைகள்' என்னும் பெயரில் முழுத்தொகுப்பாக வெளியிடப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Under which title was the complete collection of Athmanam's poems published?", "media_id": null}], "options": {"A": "Athmanam Kavithaigal", "B": "Kaagithathil Oru Kodu", "C": "Zha Thoguppu", "D": "Mounathin Kural"}, "explanation": "His poetic corpus was posthumously compiled and brought out comprehensively under the title 'Athmanam Kavithaigal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 135, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_meg