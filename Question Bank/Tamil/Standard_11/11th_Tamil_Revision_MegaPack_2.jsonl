{"id": "11th_tamil_rev2_q053", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "athmanam_border_poem", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘காகிதத்தில் ஒரு கோடு கிழித்தால் அது எல்லையாகி விடுகிறது’ - என்ற நவீனச் சிந்தனையைத் தரும் கவிதையைப் படைத்தவர் யார்?", "media_id": null}], "options": {"A": "ஆத்மாநாம்", "B": "இன்குலாப்", "C": "சிற்பி பாலசுப்பிரமணியம்", "D": "ஞானக்கூத்தன்"}, "explanation": "மனிதர்கள் நிலங்களை எல்லைகளாகப் பிரித்துச் சண்டையிடும் விசித்திரத்தை 'ஒரு கோடு' என்னும் உருவகத்தால் ஆத்மாநாம் உணர்த்தியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who penned the thought-provoking modern lines about lines on paper turning into political frontiers?", "media_id": null}], "options": {"A": "Athmanam", "B": "Inquilab", "C": "Sirpi Balasubramaniam", "D": "Gnanakoothan"}, "explanation": "Athmanam used the simple metaphor of drawing a line on paper to critique arbitrary political borders."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 135, "chapter": null, "section": null, "reference": "11t