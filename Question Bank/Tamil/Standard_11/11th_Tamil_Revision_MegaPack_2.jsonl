{"id": "11th_tamil_rev2_q095", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_sangam_modern_theatre", "chapter_id": null, "topic_id": "muthukumar_essay_collections", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அணிலாடும் முன்றில்’ என்னும் உன்னதமான உறவுமுறை நினைவுக் கட்டுரைகளை எழுதியவர் யார்?", "media_id": null}], "options": {"A": "ஜெயமோகன்", "B": "எஸ். ராமகிருஷ்ணன்", "C": "நா. முத்துக்குமார்", "D": "வண்ணதாசன்"}, "explanation": "குடும்ப உறவுகளின் அன்பையும் இழப்புகளையும் நெகிழ்ச்சியுடன் சித்திரிக்கும் 'அணிலாடும் முன்றில்' நூலை நா. முத்துக்குமார் எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "Who penned 'Anilaadum Muntreil', the deeply moving personal memoirs celebrating familial bonds?", "media_id": null}], "options": {"A": "Jeyamohan", "B": "S. Ramakrishnan", "C": "Na. Muthukumar", "D": "Vannadasan"}, "explanation": "Na. Muthukumar authored the celebrated non-fiction volume of family memories titled 'Anilaadum Muntreil'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 211, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_