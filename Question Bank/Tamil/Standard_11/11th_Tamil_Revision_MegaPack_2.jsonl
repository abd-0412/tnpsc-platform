{"id": "11th_tamil_rev2_q111", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_sangam_modern_theatre", "chapter_id": null, "topic_id": "muthukumar_kavithai_varigal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘முகவரி தொலைத்த முகங்களோடு நகர வீதிகளில் அலைகிறோம்’ - என்று நவீன நகர நெரிசலைச் சாடியவர் யார்?", "media_id": null}], "options": {"A": "வைரமுத்து", "B": "கலாப்ரியா", "C": "நா. முத்துக்குமார்", "D": "ஞானக்கூத்தன்"}, "explanation": "நகர வாழ்வின் அடையாள இழப்பையும் நெரிசலையும் 'தொலைந்து போனவர்கள்' கவிதையில் நா. முத்துக்குமார் இவ்வாறு படம் பிடிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "Who penned the critique 'We wander down city avenues with faces that have forgotten their own addresses'?", "media_id": null}], "options": {"A": "Vairamuthu", "B": "Kalapriya", "C": "Na. Muthukumar", "D": "Gnanakoothan"}, "explanation": "Na. Muthukumar depicted the tragic loss of personal rootedness in contemporary hyper-urban life."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 210, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_m