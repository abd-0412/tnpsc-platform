{"id": "11th_tamil_rev2_q031", "schema_version": "1.0", "kind": "statement_analysis", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "ms_subbulakshmi_honours", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எம். எஸ். சுப்புலட்சுமி குறித்த கூற்றுகளை ஆராய்க:\n(i) இவர் 1966-இல் ஐ.நா. பொதுச்சபையில் பாடி பெருமை சேர்த்தார்.\n(ii) இந்தியாவின் உயரிய விருதான ‘பாரத ரத்னா’ விருது பெற்ற முதல் இசைக்கலைஞர் இவரே ஆவார்.\n(iii) இவர் மகசேசே விருது பெற்ற முதல் இந்திய இசைக் கலைஞர் ஆவார்.", "media_id": null}], "options": {"A": "(i) மற்றும் (ii) மட்டுமே சரி", "B": "(ii) மற்றும் (iii) மட்டுமே சரி", "C": "(i), (ii), (iii) ஆகிய அனைத்தும் சரி", "D": "(i) மட்டுமே சரி"}, "explanation": "எம். எஸ். சுப்புலட்சுமி 1966 ஐ.நா. இசைக்கச்சேரி, 1974 மகசேசே விருது, 1998 பாரத ரத்னா விருது என அனைத்திலும் முதன்மையான சாதனை படைத்தவர்."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on M. S. Subbulakshmi:\n(i) She performed at the UN General Assembly in 1966.\n(ii) She was the first musician ever to be awarded the Bharat Ratna.\n(iii) She was the first Indian musician to receive the Ramon Magsaysay Award.", "media_id": null}], "options": {"A": "Only (i) and (ii) are correct", "B": "Only (ii) and (iii) are correct", "C": "All (i), (ii), and (iii) are correct", "D": "Only (i) is correct"}, "explanation": "All statements are historically accurate regarding Carnatic legend M. S. Subbulakshmi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 138", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 2", "Subbulakshmi", "Music"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev2_q032", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "vallinam_migum_rules", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வருவனவற்றுள் வல்லினம் மிகும் இடத்திற்குரிய சரியான விதி எது?", "media_id": null}], "options": {"A": "எழுவாய்த் தொடரில் வல்லினம் மிகும்", "B": "இரண்டாம் வேற்றுமைத் தொகையில் வல்லினம் மிகும்", "C": "சில/பல என்னும் சொற்களின் பின் வல்லினம் மிகாது", "D": "இரண்டாம் வேற்றுமை உருபும் (ஐ), நான்காம் வேற்றுமை உருபும் (கு) வெளிப்படும் தொடர்களில் வல்லினம் மிகும்"}, "explanation": "இரண்டாம் வேற்றுமை விரி (ஐ), நான்காம் வேற்றுமை விரி (கு) ஆகியவற்றின் பின் வல்லினம் கண்டிப்பாக மிகும் (எ.கா: நூலைக் கொடுத்தான், ஊருக்குச் சென்றான்)."}, "en": {"blocks": [{"type": "text", "content": "Which is a correct grammatical rule where Vallinam MUST double (hard consonant doubling)?", "media_id": null}], "options": {"A": "Vallinam doubles in nominative subject compounds", "B": "Vallinam doubles in implicit accusative compounds", "C": "Vallinam never doubles after sila/pala", "D": "Vallinam doubles after explicit 2nd (ai) and 4th (ku) case markers"}, "explanation": "Vallinam must double when following overt 2nd case marker '-ai' and 4th case marker '-ku'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, 