{"id": "11th_tamil_rev2_q012", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_prose_classics", "chapter_id": null, "topic_id": "thiruchazhal_location", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாணிக்கவாசகர் திருச்சாழல் பதிகத்தை எந்தப் புனிதத் தலத்தில் அருளிச்செய்தார்?", "media_id": null}], "options": {"A": "திருவாதவூர்", "B": "திருப்பெருந்துறை", "C": "திருவண்ணாமலை", "D": "தில்லை (சிதம்பரம்)"}, "explanation": "மாணிக்கவாசகர் தில்லை சிதம்பரம் நடராஜர் சந்நிதியில் ஈழத்து பௌத்தர்களை வாதில் வென்றபோது திருச்சாழல் பதிகத்தை அருளிச்செய்தார்."}, "en": {"blocks": [{"type": "text", "content": "At which sacred shrine did Manikkavasagar compose the Thiruchazhal hymns?", "media_id": null}], "options": {"A": "Thiruvathavur", "B": "Thirupperunthurai", "C": "Thiruvannamalai", "D": "Thillai (Chidambaram)"}, "explanation": "Manikkavasagar composed Thiruchazhal during his philosophical discourse with Buddhist scholars at Thillai Chidambaram."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 150, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack