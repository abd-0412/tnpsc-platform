{"id": "11th_tamil_rev2_q081", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_leaders_epic", "chapter_id": null, "topic_id": "jeeva_gandhi_meeting", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஜீவா’ அவர்கள் காந்தியடிகளை முதன்முதலில் சந்தித்து உரையாடிய வரலாற்று நிகழ்வு எந்த ஆண்டு எங்கு நிகழ்ந்தது?", "media_id": null}], "options": {"A": "1927-இல் காரைக்குடியில்", "B": "1930-இல் வேதாரண்யத்தில்", "C": "1920-இல் சென்னையில்", "D": "1942-இல் மதுரையில்"}, "explanation": "1927-இல் காந்தியடிகள் காரைக்குடிக்கு வருகை தந்தபோது ஜீவா அவரைச் சந்தித்து எளிய ஆடை அணிந்து வாழ்நாள் தொண்டராக உறுதியேற்றார்."}, "en": {"blocks": [{"type": "text", "content": "Where and in which year did young Jeeva first meet and converse with Mahatma Gandhi in Tamil Nadu?", "media_id": null}], "options": {"A": "In 1927 at Karaikudi", "B": "In 1930 at Vedaranyam", "C": "In 1920 at Chennai", "D": "In 1942 at Madurai"}, "explanation": "In 1927 at Karaikudi, young Jeeva met Mahatma Gandhi, profoundly shaping his lifelong commitment to austerity and public service."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-20