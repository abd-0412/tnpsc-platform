{"id": "11th_tamil_rev2_q163", "schema_version": "1.0", "kind": "grammar_rule", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u8_grammar_mega_test", "chapter_id": null, "topic_id": "sandhi_migaa_vinaiyecham", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மென்தொடர்க் குற்றியலுகர வினையெச்சங்களின் பின் வல்லினம் மிகாது’ - இவிதிக்கான எடுத்துக்காட்டு எது?", "media_id": null}], "options": {"A": "ஓடிப் போனான்", "B": "சுட்டுப் போட்டான்", "C": "வந்து போனான், தின்று தீர்த்தான்", "D": "பாடக் கேட்டான்"}, "explanation": "'வந்து', 'தின்று' என்பவை மென்தொடர்க் குற்றியலுகர வினையெச்சங்கள். இவற்றின் பின் வல்லினம் மிகாது (வந்து போனான்)."}, "en": {"blocks": [{"type": "text", "content": "Which phrase illustrates the rule 'Vallinam DOES NOT double after nasal-series Kutriyalukaram verbal participles'?", "media_id": null}], "options": {"A": "Odip ponaan", "B": "Suttup pottaan", "C": "Vanthu ponaan, Thintru theerthaan", "D": "Paadak kettaan"}, "explanation": "'Vanthu' and 'thintru' are soft-nasal verbal participles which prohibit initial hard plosive doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "sect