{"id": "11th_tamil_rev2_q121", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_interview_proof_names", "chapter_id": null, "topic_id": "thirukkural_padai_maatchi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உறுப்பமைந்து ஊறஞ்சா வெல்படை வேந்தன்\nவெறுக்கையுள் எல்லாம் தலை’ - இக்குறட்பாவில் ‘வெறுக்கை’ என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "செல்வம் (அரசனுடைய செல்வங்கள் அனைத்திலும் தலைசிறந்தது)", "B": "வெறுப்பு", "C": "பகைமை", "D": "வறுமை"}, "explanation": "இக்குறளில் ‘வெறுக்கை’ என்பது ‘செல்வம்’ என்னும் பொருளில் ஆளப்பட்டுள்ளது. வேந்தனின் செல்வங்கள் அனைத்திலும் சிறந்த செல்வம் அஞ்சாத படைவீரர்களைக் கொண்ட படையே ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the meaning of the archaic word 'Verukkai' in the Thirukkural on army prowess (Padai Maatchi)?", "media_id": null}], "options": {"A": "Wealth / Treasure (paramount among all wealth possessed by a ruler)", "B": "Disgust", "C": "Enmity", "D": "Poverty"}, "explanation": "'Verukkai' signifies 'wealth' or 'treasure'; Valluvar identifies an invincible army as a king's greatest treasure."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "1