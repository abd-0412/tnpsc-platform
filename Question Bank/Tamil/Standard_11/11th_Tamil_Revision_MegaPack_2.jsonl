{"id": "11th_tamil_rev2_q005", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_prose_classics", "chapter_id": null, "topic_id": "thiruchazhal_nature", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சாழல்’ என்பது மகளிர் விளையாடும் விளையாட்டுகளில் எவ்வகையைச் சார்ந்தது?", "media_id": null}], "options": {"A": "ஒரு பெண் வினா எழுப்ப, மற்றொரு பெண் அதற்கு விடையளித்துப் பாடும் உரையாடல் விளையாட்டு", "B": "பந்து வீசி விளையாடும் விளையாட்டு", "C": "கழங்கு கொண்டு ஆடும் விளையாட்டு", "D": "ஊஞ்சலில் அமர்ந்து பாடும் விளையாட்டு"}, "explanation": "சாழல் என்பது ஒரு பெண் இறைவனின் செயலை வினாவாகக் கேட்க, மற்றொரு பெண் அதன் உட்கருத்தை விளக்கி விடை கூறும் வினா-விடை விளையாட்டுப் பாடலாகும்."}, "en": {"blocks": [{"type": "text", "content": "What type of women's game is 'Chazhal' as portrayed in devotional literature?", "media_id": null}], "options": {"A": "A conversational riddle game where one girl asks a question and another replies", "B": "A ball tossing game", "C": "A pebble tossing game", "D": "A swinging song game"}, "explanation": "Chazhal is a poetic dialogue game where one woman poses a question challenging God's deeds and another offers a profound devotional reply."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "pu