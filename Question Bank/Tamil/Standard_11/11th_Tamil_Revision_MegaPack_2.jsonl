{"id": "11th_tamil_rev2_q028", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_prose_classics", "chapter_id": null, "topic_id": "thanjavur_millennium", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயிலின் ஆயிரமாவது ஆண்டு நிறைவு விழா எந்த ஆண்டு கோலாகலமாகக் கொண்டாடப்பட்டது?", "media_id": null}], "options": {"A": "1995", "B": "2000", "C": "2005", "D": "2010"}, "explanation": "கி.பி. 1010-இல் கட்டி முடிக்கப்பட்ட தஞ்சைப் பெரிய கோயிலின் ஆயிரமாவது ஆண்டு நிறைவு விழா 2010 செப்டம்பரில் தமிழக அரசால் சிறப்பாகக் கொண்டாடப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "In which year was the 1000th anniversary celebration of Thanjavur Big Temple commemorated?", "media_id": null}], "options": {"A": "1995", "B": "2000", "C": "2005", "D": "2010"}, "explanation": "The millennium (1000th year) celebration of Thanjavur Big Temple was celebrated with grand state honors in September 2010."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 148, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 148", "url": null, "source_no