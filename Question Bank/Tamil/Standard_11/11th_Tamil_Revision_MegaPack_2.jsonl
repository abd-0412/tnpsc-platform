{"id": "11th_tamil_rev2_q052", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "eeruketta_ethirmarai_vallinam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஈறுகெட்ட எதிர்மறைப் பெயரெச்சத்தின் பின் வல்லினம் மிகும்’ - என்பதற்குப் பொருத்தமான சான்று எது?", "media_id": null}], "options": {"A": "ஓடா குதிரை", "B": "வாடா மாலை", "C": "தீரா துயர்", "D": "ஓடாக் குதிரை, வாடாக் கொடி"}, "explanation": "ஓடாத குதிரை -> ஓடாக்குதிரை; வாடாத கொடி -> வாடாக்கொடி என ஈறுகெட்ட எதிர்மறைப் பெயரெச்சத்தின் பின் வல்லினம் கண்டிப்பாக மிகும்."}, "en": {"blocks": [{"type": "text", "content": "Which is a correct example for 'Vallinam doubles after a negative relative participle with truncated ending'?", "media_id": null}], "options": {"A": "Oda kuthirai", "B": "Vada maalai", "C": "Theera thuyar", "D": "Odaak kuthirai, Vaadaak kodi"}, "explanation": "Negative relative participles with elided final syllable mandatorily trigger doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": null, "section": null, "reference": "11th Tam