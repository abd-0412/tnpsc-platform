{"id": "11th_tamil_rev2_q158", "schema_version": "1.0", "kind": "grammar_identification", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u8_grammar_mega_test", "chapter_id": null, "topic_id": "aakkappeyar_panpu_suffix", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மை’ என்னும் பண்புப்பெயர் பின்னொட்டு பெற்று வரும் ஆக்கப்பெயர்களுக்குச் சான்று எது?", "media_id": null}], "options": {"A": "படித்தான்", "B": "இனிமை, பெருமை, சிறுமை, உண்மை", "C": "மரம், கல்", "D": "ஓடினான்"}, "explanation": "இனிது + மை = இனிமை; பெரு + மை = பெருமை என 'மை' விகுதி பெற்றுப் பண்புப்பெயர் ஆக்கப்பெயர்களாக மலர்கின்றன."}, "en": {"blocks": [{"type": "text", "content": "Which group illustrates abstract quality nouns derived via the nominalizing suffix '-Mai'?", "media_id": null}], "options": {"A": "Padithaan", "B": "Inimai, Perumai, Sirumai, Unmai", "C": "Maram, Kal", "D": "Odinaan"}, "explanation": "The stative/qualitative suffix '-Mai' abstracts qualities into canonical conceptual nouns."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 191, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 191", "url": nu