{"id": "11th_tamil_rev2_q073", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_leaders_epic", "chapter_id": null, "topic_id": "jeeva_speech_metaphor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தோழர் ஜீவாவின் மேடைப்பேச்சுக்கு உவமையாகச் சுந்தர ராமசாமி கூறுவது எது?", "media_id": null}], "options": {"A": "காற்றில் கலந்த பேரோசை மற்றும் பெருவெள்ளம்", "B": "தேன் துளிகள்", "C": "சிறு தென்றல்", "D": "மழைச்சாரல்"}, "explanation": "ஜீவாவின் பேச்சு வானொலி அலைகளைப் போலவும் காற்றுவெளியில் கலந்த மாபெரும் புயல் முழக்கம் போலவும் அமைந்ததால் 'காற்றில் கலந்த பேரோசை' என்று உவமித்தார்."}, "en": {"blocks": [{"type": "text", "content": "What metaphor did Sundara Ramaswamy employ to portray Comrade Jeeva's electrifying public oratory?", "media_id": null}], "options": {"A": "Mighty resonance mingled in the wind (storm surge)", "B": "Drops of honey", "C": "Gentle breeze", "D": "Light drizzle"}, "explanation": "Sundara Ramaswamy characterized Jeeva's captivating mass eloquence as an irresistible primordial roar carried on the wind."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 17