{"id": "11th_tamil_rev2_q037", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "peyarecham_vallinam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் சொற்களுள் பெயரெச்சத்தின் பின் வல்லினம் மிகாது என்பதற்குச் சான்றான தொடர் எது?", "media_id": null}], "options": {"A": "பாயும் புலி", "B": "சுட்டுப் போட்டான்", "C": "ஓடிப் போனான்", "D": "கண்டு பிடித்தான்"}, "explanation": "‘பாயும்’ என்பது பெயரெச்சம். பெயரெச்சத்தின் பின் வல்லினம் மிகாது (பாயும் புலி). ஏனையவை வினையெச்சங்கள் ஆதலின் வல்லினம் மிகும்."}, "en": {"blocks": [{"type": "text", "content": "Which word is grammatically written WITHOUT doubling of Vallinam following a relative participle?", "media_id": null}], "options": {"A": "Paayum puli", "B": "Suttup pottaan", "C": "Odip ponaan", "D": "Kandu pidithaan"}, "explanation": "'Paayum' is a relative participle; Vallinam does not double after relative participles."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 161"