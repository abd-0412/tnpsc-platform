{"id": "11th_tamil_rev2_q094", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_sangam_modern_theatre", "chapter_id": null, "topic_id": "inquilab_sahitya_akademi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இன்குலாப்பிற்கு மரணத்திற்குப் பின் வழங்கப்பட்டு அவரது குடும்பத்தினரால் ஏற்க மறுக்கப்பட்ட விருது எது?", "media_id": null}], "options": {"A": "பத்மஸ்ரீ விருது", "B": "காந்தள் நாட்கள் நூலுக்கான சாகித்திய அகாதெமி விருது (2017)", "C": "கலைமாமணி விருது", "D": "ஞானபீட விருது"}, "explanation": "2017-இல் இன்குலாப்பின் 'காந்தள் நாட்கள்' நூலுக்கு சாகித்திய அகாதெமி விருது அறிவிக்கப்பட்டது. ஆனால் ஒடுக்கப்பட்ட மக்கள் மீதான வன்முறையைக் கண்டித்து அவரது குடும்பத்தினர் அவ்விருதை ஏற்க மறுத்தனர்."}, "en": {"blocks": [{"type": "text", "content": "Which prestigious literary accolade announced posthumously in 2017 was declined by Inquilab's family?", "media_id": null}], "options": {"A": "Padma Shri", "B": "Sahitya Akademi Award for 'Kaanthal Naatkal' (2017)", "C": "Kalaimamani Award", "D": "Jnanpith Award"}, "explanation": "In 2017, the Sahitya Akademi award for 'Kaanthal Naatkal' was declined by Inquilab's family in protest against atrocities."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Na