{"id": "11th_tamil_rev2_q072", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_leaders_epic", "chapter_id": null, "topic_id": "manonmaneeyam_sivagami_charitham", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மனோன்மணீயம் நாடகத்தில் இடம்பெறும் கிளைக்கதையின் (நாடகத்துள் நாடகம்) பெயர் என்ன?", "media_id": null}], "options": {"A": "சகுந்தலா கதை", "B": "நளவெண்பா கதை", "C": "சந்திரவதனா கதை", "D": "சிவகாமி சரிதம்"}, "explanation": "மனோன்மணீயத்தில் இரண்டாம் அங்கத்தில் நாடகத்துள் நாடகமாக ஆசிரியர் அமைத்த கிளைக்கதை 'சிவகாமி சரிதம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the title of the allegorical sub-play (play-within-a-play) embedded inside Manonmaneeyam?", "media_id": null}], "options": {"A": "Sakuntala story", "B": "Nalavenba story", "C": "Chandravadhana story", "D": "Sivagami Charitham"}, "explanation": "'Sivagami Charitham' is the famous interpolated romantic allegory woven within Act II of Manonmaneeyam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 201, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack