{"id": "11th_tamil_rev2_q154", "schema_version": "1.0", "kind": "grammar_identification", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u8_grammar_mega_test", "chapter_id": null, "topic_id": "aakkappeyar_negative_prefix", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘எதிர்மறை முன்னொட்டுகள்’ பெற்று வரும் ஆக்கப்பெயர்களுக்குச் சான்றான இணை எது?", "media_id": null}], "options": {"A": "நன்மதிப்பு, நற்செயல்", "B": "அறிவின்மை, தவறான, பயனின்மை", "C": "பெருவளம், செந்தமிழ்", "D": "மாமனிதன், நெடுந்தெரு"}, "explanation": "இன்மை, தவறு முதலிய எதிர்மறைக் கூறுகள் இணைந்து உருவானவை எதிர்மறை ஆக்கப்பெயர்கள் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which pair demonstrates derivative nouns carrying negative prefixes or bound morphemes?", "media_id": null}], "options": {"A": "Nanmathippu, Narseval", "B": "Arivinmai, Thavarana, Payaninmai", "C": "Peruvalam, Senthamizh", "D": "Maamanithan, Neduntheru"}, "explanation": "Roots taking negative bound morphemes form privative or contrary derivative nominals."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 191, "chapter": null, "section": null, "reference": "11th Tamil, Unit