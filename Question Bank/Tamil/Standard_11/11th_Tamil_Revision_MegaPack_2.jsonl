{"id": "11th_tamil_rev2_q136", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_interview_proof_names", "chapter_id": null, "topic_id": "thirukkural_manam_chapter", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மயிர்நீப்பின் வாழாக் கவரிமா அன்னார்\nஉயிர்நீப்பர் மானம் வரின்’ - இக்குறட்பா உணர்த்தும் விழுமியம் யாது?", "media_id": null}], "options": {"A": "செல்வத்தின் பெருமை", "B": "அறிவின் சிறப்பு", "C": "கல்வியின் பெருமை", "D": "மானமே உயிரை விட மேலானது"}, "explanation": "தன் உடம்பிலிருந்து ஒரு மயிர் நீங்கினாலும் உயிர் வாழாத கவரிமானைப் போல, மானத்திற்குக் கேடு நேர்ந்தால் உயிரையும் துறப்பவரே மானமுடைய சான்றோர் ஆவர்."}, "en": {"blocks": [{"type": "text", "content": "What supreme moral virtue is illuminated in the Thirukkural chapter on Honor (Maanam)?", "media_id": null}], "options": {"A": "Excellence of wealth", "B": "Grandeur of intellect", "C": "Glory of erudition", "D": "Self-respect and honor surpass life itself"}, "explanation": "Noble people forfeit their physical lives before compromising personal honor, just as a musk-deer dies if it sheds its fur."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full