{"id": "11th_tamil_rev2_q011", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_prose_classics", "chapter_id": null, "topic_id": "kutrala_kuravanji_famous_quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஓடக் காண்பதுமே எல்லை வெள்ளமே... ஆடக் காண்பது மந்தியே...’ என்று தொடங்கும் பாடல் வரிகள் இடம்பெற்ற நூல் எது?", "media_id": null}], "options": {"A": "முக்கூடற்பள்ளு", "B": "திருமலை முருகன் பள்ளு", "C": "குற்றாலக் குறவஞ்சி", "D": "மீனாட்சியம்மை பிள்ளைத்தமிழ்"}, "explanation": "குற்றால நாட்டின் வளத்தை நயம்பட விவரிக்கும் இப்பாடல் திரிகூடராசப்பக் கவிராயர் இயற்றிய குற்றாலக் குறவஞ்சியில் நாட்டுவளப் பகுதியில் அமைந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "In which work do the famous lines 'Odak kaanpadhume ellai vellame... Aadak kaanpadhu mandhiye...' appear?", "media_id": null}], "options": {"A": "Mukkoodar Pallu", "B": "Thirumalai Murugan Pallu", "C": "Kutrala Kuravanji", "D": "Meenakshiyammai Pillaithamizh"}, "explanation": "These celebratory verses depicting nature without social suffering belong to Kutrala Kuravanji by Thirukoodarasappa Kavirayar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11",