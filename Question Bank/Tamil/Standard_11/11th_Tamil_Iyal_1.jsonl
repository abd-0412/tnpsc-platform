{"id": "11th_tamil_u1_q115", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "supplementary_aaraam_thinai", "chapter_id": null, "topic_id": "sri_lanka_award", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அ. முத்துலிங்கத்தின் எந்த சிறுகதைத் தொகுதிக்கு இலங்கை சாகித்திய அகாதெமி விருது (1999) கிடைத்தது?", "media_id": null}], "options": {"A": "குதிரைக்காரன்", "B": "கொழுந்தாடை", "C": "வடக்கு வீதி", "D": "உண்மை கலந்த நாவல்"}, "explanation": "அ. முத்துலிங்கத்தின் 'வடக்கு வீதி' சிறுகதைத் தொகுதிக்கு 1999-ஆம் ஆண்டின் இலங்கை அரசின் சாகித்திய அகாதெமி பரிசு வழங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which short story collection of A. Muthulingam was awarded the Sri Lankan Sahitya Akademi Award in 1999?", "media_id": null}], "options": {"A": "Kuthiraikkaaran", "B": "Kozhunthaadai", "C": "Vadakku Veethi", "D": "Unmai Kalantha Naaval"}, "explanation": "'Vadakku Veethi' was conferred the prestigious Sri Lankan Sahitya Akademi Award in 1999."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 10, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 10", "url": n