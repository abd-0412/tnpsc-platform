{"id": "11th_tamil_u1_q043", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "assertion_reason_poet", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): ‘யுகத்தின் பாடல்’ கவிதை ஈழப் போராட்டத்தின் வலிகளுக்கிடையே தமிழின் மீளெழுச்சியைப் பாடுகிறது.\nகாரணம் (R): வன்முறையாலும் நெருப்பினாலும் ஒரு மொழியையோ, பண்பாட்டையோ ஒருபோதும் சாம்பலாக்கிவிட முடியாது என்ற அசைக்க முடியாத நம்பிக்கையை அது முன்வைக்கிறது.", "media_id": null}], "options": {"A": "கூற்று தவறு, காரணம் சரி", "B": "கூற்று மற்றும் காரணம் இரண்டும் தவறு", "C": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றை மிகச்சரியாக விளக்குகிறது", "D": "கூற்று சரி, காரணம் தவறு"}, "explanation": "எரித்து அழிக்கப்பட்டாலும் மொழியின் வேர் மீண்டும் துளிர்க்கும் என்ற வரலாற்று உண்மையை இக்கவிதை பாடுவதால் இரண்டும் சரியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'Yugathin Paadal' sings the resurrection of Tamil amidst the harrowing trauma of Eelam.\nReason (R): It asserts the indomitable truth that violence and fire can never annihilate a language and its living culture.", "media_id": null}], "options": {"A": "Assertion is false, Reason is true", "B": "Both Assertion and Reason are false", "C": "Both Assertion and Reason are true; Reason is the correct explanation", "D": "Assertion is true, Reason is false"}, "explanation": "Both assertion and reason are true as cultural roots defy annihilation by physical violence."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Poetry", "Assertion-Reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q044", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "paaduvoam_grammar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பாடுவோம்’ என்னும் சொல்லின் இலக்கணக் குறிப்பு யாது?", "media_id": null}], "options": {"A": "படர்க்கை வினைமுற்று", "B": "முன்னிலை ஒருமை", "C": "வியங்கோள் வினைமுற்று", "D": "தன்மைப் பன்மை எதிர்கால வினைமுற்று"}, "explanation": "பாடு + வ் + ஓம்: ‘ஓம்’ விகுதி பெற்றுத் தன்மைப் பன்மையிலும், ‘வ்’ இடைநிலை பெற்று எதிர்காலத்திலும் வந்துள்ள வினைமுற்று."}, "en": {"blocks": [{"type": "text", "content": "What is the grammatical classification of the verb 'Paaduvoam'?", "media_id": null}], "options": {"A": "Third-person finite verb", "B": "Second-person singular", "C": "Optative mood finite verb", "D": "First-person plural future finite verb"}, "explanation": "'Paaduvoam' features the future marker 'v' and first-person plural suffix 'oam' (We shall sing)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null, "source_not