{"id": "11th_tamil_u1_q187", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "revision_unit_1", "chapter_id": null, "topic_id": "monolingualism_term", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘Monolingualism’ என்ற கலைச்சொல்லின் தமிழாக்கம் என்ன?", "media_id": null}], "options": {"A": "பன்மொழியாளன்", "B": "இருமொழிப் பயன்பாடு", "C": "ஒருமொழிப் பயன்பாடு (ஒருமொழியியம்)", "D": "மொழியியல்"}, "explanation": "Monolingualism என்பது ‘ஒருமொழிப் பயன்பாடு’ அல்லது ‘ஒருமொழியியம்’ எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What is the Tamil technical equivalent for 'Monolingualism'?", "media_id": null}], "options": {"A": "Multilingualism", "B": "Bilingualism", "C": "Orumozhiyiyam (Monolingualism)", "D": "Linguistics"}, "explanation": "'Monolingualism' corresponds to 'Orumozhiyiyam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 18", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media"