{"id": "11th_tamil_u1_q055", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "rhyme_scheme", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘காற்றிலேறிப் புவிமுழுதும் பாடுவோம் / எமது யுகத்தின் பாடலை’ - இவ்வடிகளில் அமைந்துள்ள தொடை நயம் யாது?", "media_id": null}], "options": {"A": "முதல் எழுத்து ஒன்றிவரும் மோனை மட்டுமே", "B": "இரண்டாம் எழுத்து ஒன்றிவரும் எதுகை மட்டுமே", "C": "சீர்மொழி இயைபு மற்றும் சந்த நயம் (Rhythmic Cadence)", "D": "முரண் தொடை மட்டுமே"}, "explanation": "இவ்வடிகளில் சொல்லமைப்பின் சந்த ஒழுங்கும், ஓசை நயமும் தாள லயத்தோடு கூடி இயைபு நயத்தைத் தருகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What primary prosodic/acoustic aesthetic features in the lines 'Kaatrilearip Puvimuzhuthum Paaduvoam / Emathu Yugathin Paadalai'?", "media_id": null}], "options": {"A": "Only Alliteration (Monai)", "B": "Only Rhyme (Ethugai)", "C": "Internal rhythmic cadence and acoustic flow (Santham & Iyaibu)", "D": "Only Antithesis (Muran)"}, "explanation": "The lines exhibit an internal musical harmony, rhythmic pulse, and end-flow cadence."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Poetry", "Prosody"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q056", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "poet_devotion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘யுகத்தின் பாடல்’ உணர்த்தும் ஒட்டுமொத்தப் பேருண்மை யாது?", "media_id": null}], "options": {"A": "பொருளாதார வளர்ச்சியே வாழ்வின் இறுதி இலக்கு", "B": "மனிதர்கள் ஒருவருக்கொருவர் பேசாமல் இருப்பதே அமைதி", "C": "நாடுகளின் எல்லைகளே நிரந்தரமானவை", "D": "பண்பாட்டுக் கருவூலமான தாய்மொழியைப் போற்றிப் பாதுகாப்பதே ஓர் இனத்தின் நிலையான இருப்புக்கு அடிப்படை"}, "explanation": "மொழி அழிந்தால் ஓர் இனம் அழியும்; மொழியை உயிர்ப்போடு காப்பதே ஓர் இனத்தின் விடுதலையும் உலக இருப்பும் ஆகும் என்பதை இக்கவிதை பறைசாற்றுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What overarching universal truth is enshrined in 'Yugathin Paadal'?", "media_id": null}], "options": {"A": "Economic capital alone is life sole objective", "B": "Human silence is the ultimate peace", "C": "Political borders alone are immortal", "D": "Safeguarding one mother tongue as a cultural fortress is paramount for the eternal survival of a people"}, "explanation": "Language is the lifeblood of cultural identity and existential resilience."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi