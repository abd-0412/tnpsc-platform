{"id": "11th_tamil_u1_q070", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "three_extra_items", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிறப்புப்பாயிரத்தின் எட்டுப் பொருள்களோடு பின்னர் சேர்க்கப்பட்ட கூடுதல் மூன்று கூறுகள் எவை?", "media_id": null}], "options": {"A": "அரசன், அமைச்சர், படைத்தளபதி", "B": "காலம், களம், காரணம்", "C": "மலர், மாலை, சந்தனம்", "D": "பொருளாதாரம், சமூகம், அரசியல்"}, "explanation": "நூல் இயற்றப்பட்ட காலம், அரங்கேற்றப்பட்ட களம், இயற்றப்பட்டதற்கான காரணம் ஆகிய மூன்றும் பின்னர் சிறப்புப்பாயிரத்தில் சேர்க்கப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "What are the three additional contextual components incorporated into Chirappuppaayiram alongside the primary eight?", "media_id": null}], "options": {"A": "Monarch, Minister, Commander", "B": "Kaalam (Time), Kalam (Forum/Court), Kaaranam (Reason/Purpose)", "C": "Flower, Garland, Sandal", "D": "Economics, Society, Politics"}, "explanation": "Time, forum/assembly, and motivating cause constitute the three supplementary dimensions."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_yea