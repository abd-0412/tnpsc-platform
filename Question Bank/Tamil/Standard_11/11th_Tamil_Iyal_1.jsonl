{"id": "11th_tamil_u1_q052", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "viralthani_metaphor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘விரல் நுனியில் ததும்பி நிற்கும் அமுதினை...’ - கவிதை வரிகளில் உணர்த்தப்படுவது எது?", "media_id": null}], "options": {"A": "இயற்கை மூலிகையின் சாறு", "B": "கடலின் உவர்ப்பு நீர்", "C": "மேகத்தின் மழைத்துளி", "D": "சொற்களின் வழியே வடியும் கவிதையமுதம்"}, "explanation": "கவிஞரின் விரல் நுனியில் சொற்களாக வடிந்து நிற்கும் கவிதையின் சுவையையே ‘அமுது’ என்று உருவகிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "What is conveyed by 'the nectar brimming at the fingertip' in the poem?", "media_id": null}], "options": {"A": "Extract of medicinal herbs", "B": "Saline ocean water", "C": "Raindrop from cloud", "D": "The immortal nectar of poetic creation flowing through writing fingers"}, "explanation": "It metaphorically invokes the sublime sweetness of poetic words flowing from the pen."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th