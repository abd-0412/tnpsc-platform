{"id": "11th_tamil_u1_q033", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "vilvarathinam_year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஈழத்துக் கவிஞர் சு. வில்வரத்தினம் மறைந்த ஆண்டு எது?", "media_id": null}], "options": {"A": "2006", "B": "2001", "C": "1995", "D": "2012"}, "explanation": "கவிஞர் சு. வில்வரத்தினம் 2006-ஆம் ஆண்டில் மறைந்தார். அவருடைய கவிதைகள் தமிழ்த் தேசிய வாழ்வின் வலியையும் எழுச்சியையும் பாடுபவை."}, "en": {"blocks": [{"type": "text", "content": "In which year did Sri Lankan Tamil poet Su. Vilvarathinam pass away?", "media_id": null}], "options": {"A": "2006", "B": "2001", "C": "1995", "D": "2012"}, "explanation": "Poet Su. Vilvarathinam passed away in 2006."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 1