{"id": "11th_tamil_u1_q117", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "supplementary_aaraam_thinai", "chapter_id": null, "topic_id": "library_burning_1981", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஆறாம் திணை’ பாடப்பகுதியில் குறிப்பிடப்படும் யாழ்ப்பாணப் பொது நூலகம் எந்த ஆண்டு எரிக்கப்பட்டது?", "media_id": null}], "options": {"A": "1981 ஜூன்", "B": "1975 ஆகஸ்ட்", "C": "1983 ஜூலை", "D": "1990 நவம்பர்"}, "explanation": "1981-ஆம் ஆண்டு ஜூன் மாதத்தில் ஆசியாவிலேயே மிகப்பெரிய நூலகங்களில் ஒன்றான யாழ்ப்பாணப் பொது நூலகம் வன்முறையாளர்களால் தீக்கிரையாக்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "In which year and month was the historic Jaffna Public Library burnt down as narrated in 'Aaraam Thinai'?", "media_id": null}], "options": {"A": "June 1981", "B": "August 1975", "C": "July 1983", "D": "November 1990"}, "explanation": "The monumental Jaffna Public Library was burnt down in June 1981."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 11, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 11", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "History", "Jaffna Library"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q118", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "supplementary_aaraam_thinai", "chapter_id": null, "topic_id": "library_books_count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "யாழ்ப்பாணப் பொது நூலகம் எரிக்கப்பட்ட போது எத்தனைக்கும் மேற்பட்ட அரிய சுவடிகளும் புத்தகங்களும் தீக்கிரையாகின?", "media_id": null}], "options": {"A": "50,000-க்கும் மேற்பட்ட", "B": "97,000-க்கும் மேற்பட்ட", "C": "25,000-க்கும் மேற்பட்ட", "D": "1,50,000-க்கும் மேற்பட்ட"}, "explanation": "சுமார் 97,000-க்கும் மேற்பட்ட ஈடுசெய்ய முடியாத அரிய ஓலைச்சுவடிகள், வரலாற்று நூல்கள் சாம்பலாயின."}, "en": {"blocks": [{"type": "text", "content": "How many invaluable rare manuscripts and books were reduced to ashes during the burning of the Jaffna Public Library?", "media_id": null}], "options": {"A": "Over 50,000", "B": "Over 97,000", "C": "Over 25,000", "D": "Over 150,000"}, "explanation": "Over 97,000 priceless manuscripts and books were incinerated during the cultural catastrophe."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 11, "chapter": null, "section": null, "reference": "11th Tamil, U