{"id": "11th_tamil_u1_q111", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "nannool_grammar_impact", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொல்காப்பியத்திற்குப் பின்னர் தமிழகத்தில் மிக விரிவாகவும் எளிமையாகவும் பயிலப்பட்டு வரும் முதன்மை இலக்கண நூல் எது?", "media_id": null}], "options": {"A": "யாப்பருங்கலக்காரிகை", "B": "வீரசோழியம்", "C": "நன்னூல்", "D": "நேமிநாதம்"}, "explanation": "நன்னூல் தொல்காப்பியக் கருத்துகளைப் பிற்கால வளர்ச்சிக்கு ஏற்ப எளிமையாகவும் தெளிவாகவும் எடுத்துரைப்பதால் தமிழகத்தில் முதன்மை இலக்கண நூலாகப் பயிலப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Following Tholkappiyam, which grammatical text has been most universally studied and adopted across Tamil Nadu?", "media_id": null}], "options": {"A": "Yaapparungala Kaarikai", "B": "Veerasozhiyam", "C": "Nannool", "D": "Neminatham"}, "explanation": "'Nannool' has historically served as the definitive, lucid standard textbook for Tamil grammar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 6", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Literature", "Significance"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q112", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "assertion_reason_pedagogy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): நன்னூல் மாணாக்கர்களைத் தலை, இடை, கடை என அவர்களின் கற்கும் மனப்பான்மை மற்றும் அறிவின் வெளிப்பாட்டின் அடிப்படையில் பிரிக்கிறது.\nகாரணம் (R): ஒரு வகுப்பறையில் அனைத்து மாணவர்களும் ஒரே முறையில் அறிவை உள்வாங்குவதில்லை; அவர்களுக்கேற்ப ஆசிரியர் கற்பிக்கும் உத்தியை மாற்றிக்கொள்ள வேண்டும் என்பதே இதன் நோக்கம்.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று மற்றும் காரணம் இரண்டும் தவறு", "D": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றை மிகச்சரியாக விளக்குகிறது"}, "explanation": "பண்டைய காலத்திலேயே மாணவர்களின் கற்கும் உளவியலை உணர்ந்து அவர்களை வகைப்படுத்தியிருப்பது நன்னூலின் தனிச்சிறப்பாகும். இரண்டும் சரியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Nannool categorizes learners into superior, mediocre, and base based on their cognitive reception and reflective attitudes.\nReason (R): In any learning space, students process knowledge differently, mandating that instructors adapt their pedagogical methods accordingly.", "media_id": null}], "options": {"A": "Assertion is true, Reason is false", "B": "Assertion is false, Reason is true", "C": "Both Assertion and Reason are false", "D": "Both Assertion and Reason are true; Reason is the correct explanation"}, "explanation": "Both assertion and reason are true as ancient Tamil pedagogy pioneered differentiated psychological learning frameworks."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 9, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 9", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Grammar", "Assertion-Reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
