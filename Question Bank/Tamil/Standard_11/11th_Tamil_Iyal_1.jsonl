{"id": "11th_tamil_u1_q120", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "supplementary_aaraam_thinai", "chapter_id": null, "topic_id": "muthulingam_career", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எழுத்தாளர் அ. முத்துலிங்கம் எந்த சர்வதேச நிறுவனங்களில் பணியாற்றிய அனுபவம் கொண்டவர்?", "media_id": null}], "options": {"A": "நாசா (NASA)", "B": "சர்வதேச நாணய நிதியம் (IMF) மட்டுமே", "C": "கிரீன் பீஸ் (Greenpeace)", "D": "உலக வங்கி (World Bank) மற்றும் ஐக்கிய நாடுகள் சபை (UN)"}, "explanation": "அ. முத்துலிங்கம் உலக வங்கி மற்றும் ஐ.நா. சபையின் பல்வேறு திட்டப் பணிகளுக்காகப் பல உலக நாடுகளில் பணியாற்றியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "In which international global institutions did author A. Muthulingam serve professionally across continents?", "media_id": null}], "options": {"A": "NASA", "B": "IMF exclusively", "C": "Greenpeace", "D": "The World Bank and the United Nations (UN)"}, "explanation": "He served as a senior professional with the World Bank and various United Nations development initiatives."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 10, "chap