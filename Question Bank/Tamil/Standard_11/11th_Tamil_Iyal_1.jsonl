{"id": "11th_tamil_u1_q010", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "prose_speech_and_poem", "chapter_id": null, "topic_id": "books_by_indiran", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்கண்டவற்றுள் கவிஞர் இந்திரன் எழுதிய கலை, திறனாய்வு நூல் எது?", "media_id": null}], "options": {"A": "மழைக்காலக் குறிப்புகள்", "B": "தமிழ் அழகியல், நவீன ஓவியம்", "C": "காற்றின் தீராப் பாடல்", "D": "மௌனத்தின் சப்தங்கள்"}, "explanation": "கவிஞர் இந்திரன் ‘தமிழ் அழகியல்’, ‘நவீன ஓவியம்’ போன்ற முக்கிய கலை, அழகியல் ஆய்வு நூல்களை எழுதியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following art and aesthetic criticism books was authored by poet Indiran?", "media_id": null}], "options": {"A": "Mazhaikkaala Kurippugal", "B": "Thamizh Azhagiyal, Naveena Oviyam", "C": "Kaatrin Theera Paadal", "D": "Maunathin Sabthangal"}, "explanation": "Poet Indiran authored acclaimed critical works including 'Thamizh Azhagiyal' and 'Naveena Oviyam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 2", "url": nul