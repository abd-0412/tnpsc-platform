{"id": "11th_tamil_u1_q092", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "thalai_maanaakkar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முதன்மாணாக்கருக்கு (தலைமாணாக்கர்) நன்னூலில் கூறப்பட்டுள்ள இரண்டு உவமைகள் எவை?", "media_id": null}], "options": {"A": "நிலம், மலை", "B": "மண், கிளி", "C": "ஆடு, எருமை", "D": "அன்னம், ஆ (பசு)"}, "explanation": "முதன்மாணாக்கருக்கு அன்னப்பறவையும், ஆ (பசு)வும் உவமைகளாகக் கூறப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Which two allegorical living beings are assigned as similes for superior students (Thalai Maanaakkar) in Nannool?", "media_id": null}], "options": {"A": "Earth and Mountain", "B": "Soil and Parrot", "C": "Goat and Buffalo", "D": "Annam (Swan) and Aa (Cow)"}, "explanation": "The discerning Swan and the ruminating Cow represent the ideal first-tier disciples."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 9, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 9", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Grammar", "Student Similes"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q093", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "annam_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தலைமாணாக்கருக்கு ‘அன்னம்’ உவமையாக்கப்பட்டதன் நுட்பமான காரணம் யாது?", "media_id": null}], "options": {"A": "நீரையும் பாலையும் கலந்து வைத்தாலும் பாலை மட்டும் பிரித்து உண்பது போல, ஆசிரியர் கற்பித்தவற்றில் நல்லவற்றை மட்டும் தேர்ந்தெடுத்துக் கற்பதால்", "B": "அன்னம் வெண்மையாக இருப்பதால்", "C": "அன்னம் அழகாக நீந்துவதால்", "D": "அன்னம் பறக்க முடிவதால்"}, "explanation": "அன்னப்பறவை பாலையும் நீரையும் பகுத்தறிந்து பாலை மட்டும் ஏற்பது போல், சிறந்த மாணவன் ஆசிரியரின் சொற்களில் சாரமான நன்மைகளை மட்டும் உள்ளத்தில் இருத்துவான்."}, "en": {"blocks": [{"type": "text", "content": "Why is the 'Swan' (Annam) metaphorically attributed to the superior student?", "media_id": null}], "options": {"A": "Like the mythical swan separating milk from water, the student sifts pure essence from superfluity", "B": "Because the swan has white feathers", "C": "Because the swan swims elegantly", "D": "Because the swan can fly high"}, "explanation": "The discriminating swan filters milk from water; the superior disciple absorbs supreme truth."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil