{"id": "11th_tamil_u1_q045", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "pungudutheevu_district", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் சு. வில்வரத்தினம் பிறந்த புங்குடுதீவு எந்த தீவுக்கூட்டத்தைச் சேர்ந்தது?", "media_id": null}], "options": {"A": "யாழ்ப்பாணக் குடாநாட்டின் தீவுகள்", "B": "மன்னார் தீவு", "C": "கச்சத்தீவு", "D": "நெடுந்தீவு ஒன்றியம்"}, "explanation": "புங்குடுதீவு என்பது இலங்கை யாழ்ப்பாணக் குடாநாட்டின் மேற்கே அமைந்துள்ள வரலாற்றுச் சிறப்புமிக்க ஏழு தீவுகளில் ஒன்றாகும்."}, "en": {"blocks": [{"type": "text", "content": "To which archipelago does Pungudutheevu, birthplace of poet Su. Vilvarathinam, belong?", "media_id": null}], "options": {"A": "Islands of the Jaffna Peninsula", "B": "Mannar Island", "C": "Kachchatheevu", "D": "Delft Island Union"}, "explanation": "Pungudutheevu is one of the key islands situated off the Jaffna Peninsula in northern Sri Lanka."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null