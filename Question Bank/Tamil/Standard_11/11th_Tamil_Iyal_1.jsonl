{"id": "11th_tamil_u1_q041", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "sung_recitation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சு. வில்வரத்தினத்தின் கவிதை பாடும் முறை குறித்த சிறப்பு என்ன?", "media_id": null}], "options": {"A": "தமது கவிதைகளை உணர்ச்சி ததும்ப இசையுடன் பாடும் தனித்துவமான குரல் வளம் கொண்டவர்", "B": "அமைதியாகப் படிப்பவர் மட்டுமே", "C": "பாடல்களை ஒருபோதும் பொதுவெளியில் பாடாதவர்", "D": "ஆங்கிலத்தில் மட்டுமே பாடியவர்"}, "explanation": "சு. வில்வரத்தினம் தம் கவிதைகளை மேடைகளில் மிக உருக்கமாகவும், தாள லயத்துடனும் பாடி அவையோரை மெய்சிலிர்க்க வைக்கும் தனிச்சிறப்பு மிக்கவர்."}, "en": {"blocks": [{"type": "text", "content": "What unique performing characteristic distinguished poet Su. Vilvarathinam's poetry recitations?", "media_id": null}], "options": {"A": "A distinct melodious and emotionally electrifying chanting of verses with musical cadence", "B": "Strictly silent reading only", "C": "Never reciting verses in public forums", "D": "Chanting exclusively in English"}, "explanation": "Vilvarathinam possessed a legendary resonant voice, chanting his poems rhythmically with profound emotional intensity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalv