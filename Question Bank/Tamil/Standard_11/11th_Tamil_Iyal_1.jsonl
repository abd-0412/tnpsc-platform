{"id": "11th_tamil_u1_q066", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "pavanandhi_century", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பவணந்தி முனிவர் வாழ்ந்த காலம் எது?", "media_id": null}], "options": {"A": "கி.பி. 10-ஆம் நூற்றாண்டு", "B": "கி.பி. 13-ஆம் நூற்றாண்டு", "C": "கி.பி. 7-ஆம் நூற்றாண்டு", "D": "கி.பி. 16-ஆம் நூற்றாண்டு"}, "explanation": "பவணந்தி முனிவர் கி.பி. 13-ஆம் நூற்றாண்டில் (மூன்றாம் குலோத்துங்க சோழன் மற்றும் சீயகங்கன் சமகாலத்தில்) வாழ்ந்தவர்."}, "en": {"blocks": [{"type": "text", "content": "Which century is ascribed to the era of grammarian Pavanandhi Munivar?", "media_id": null}], "options": {"A": "10th Century CE", "B": "13th Century CE", "C": "7th Century CE", "D": "16th Century CE"}, "explanation": "Pavanandhi Munivar flourished during the 13th Century CE."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 6", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null