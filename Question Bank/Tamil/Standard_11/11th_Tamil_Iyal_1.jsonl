{"id": "11th_tamil_u1_q137", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "supplementary_aaraam_thinai", "chapter_id": null, "topic_id": "snow_experience", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கனடாவில் உறைய வைக்கும் குளிரில் மைனஸ் 20, 30 டிகிரி பனி பெய்யும் போது ஆசிரியருக்கு நினைவுக்கு வருவது எது?", "media_id": null}], "options": {"A": "கொக்குவில் கிராமத்து வெயிலும், புழுதி பறக்கும் வேப்பமர நிழலும்", "B": "கனடிய குளிர்கால உடைகள்", "C": "அமெரிக்க டாலர்கள்", "D": "பனிச்சறுக்கு விளையாட்டு"}, "explanation": "கடும் பனியில் உறைந்து நடுங்கும் போது, யாழ்ப்பாணத்து வெப்பமும், தனது சொந்த ஊரான கொக்குவில் கிராமத்தின் புழுதி நிறைந்த தெருக்களுமே அவரது ஏக்க நினைவாக எழுகிறது."}, "en": {"blocks": [{"type": "text", "content": "When sub-zero temperatures plunge to minus 20-30 degrees in Canadian blizzards, what memories instinctively flood the author's mind?", "media_id": null}], "options": {"A": "The tropical sun of Kokkuvil village, dusty country paths, and the fragrant shade of neem trees", "B": "Canadian winter overcoats", "C": "American currency bills", "D": "Ice-skiing competitions"}, "explanation": "The freezing blizzards instantly invoke poignant nostalgic visions of his sunny native Jaffna village."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "T