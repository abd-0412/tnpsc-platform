{"id": "11th_tamil_u1_q105", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "learning_method_rule", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நன்னூல் கூறும் கற்கும் முறைமையில், ‘ஒருவன் ஆசிரியரிடம் ஒருமுறை கற்றால் பெறுவது எத்துணை பங்கு அறிவு?’", "media_id": null}], "options": {"A": "கால் பங்கு (25%)", "B": "முக்கால் பங்கு (75%)", "C": "முழுப் பங்கு (100%)", "D": "அரை பங்கு (50%)"}, "explanation": "ஆசிரியரிடம் ஒருமுறை கேட்பதால் கால்பங்கு அறிவும்; உடன் பயில்வோருடன் உரையாடுவதால் கால்பங்கும்; பிறருக்குக் கற்பிப்பதால் முழு அறிவும் விளங்கும் என்பது மரபு."}, "en": {"blocks": [{"type": "text", "content": "According to the classical learning epistemology recorded in grammatical traditions, how much mastery is gained upon hearing the teacher once?", "media_id": null}], "options": {"A": "One quarter (25%)", "B": "Three quarters (75%)", "C": "Complete mastery (100%)", "D": "One half (50%)"}, "explanation": "Hearing from the master yields 25% (one quarter); peer discourse and teaching yield the remainder."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2