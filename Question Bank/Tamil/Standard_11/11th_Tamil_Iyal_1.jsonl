{"id": "11th_tamil_u1_q084", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "assertion_reason_paayiram", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): ‘பாயிரம் இல்லது பனுவல் அன்றே’ என்பது நன்னூலின் கோட்பாடு.\nகாரணம் (R): ஒரு நூலின் ஆசிரியர் யார், அதன் நோக்கம் என்ன, அது யாருக்காக இயற்றப்பட்டது என்பதை வாசகன் அறியாவிட்டால் அந்நூலின் பயனை முழுமையாக உணர முடியாது.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று மற்றும் காரணம் இரண்டும் தவறு", "D": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றை மிகச்சரியாக விளக்குகிறது"}, "explanation": "பாயிரமே ஒரு நூலின் தகுதியை உறுதிசெய்வதால் கூற்றும் அதற்கான காரணமும் முழுமையாகச் சரியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'A book without preface is not an authoritative book' is Nannool's axiom.\nReason (R): If a reader cannot ascertain the author credentials, purpose, and audience, the true utility of the treatise cannot be comprehended.", "media_id": null}], "options": {"A": "Assertion is true, Reason is false", "B": "Assertion is false, Reason is true", "C": "Both Assertion and Reason are false", "D": "Both Assertion and Reason are true; Reason is the correct explanation"}, "explanation": "A prolegomenon grounds the work's credibility; both assertion and reason are true."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 6", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Grammar", "Assertion-Reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
