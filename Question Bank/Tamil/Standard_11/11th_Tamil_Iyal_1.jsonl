{"id": "11th_tamil_u1_q030", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "poetry_collection", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சு. வில்வரத்தினத்தின் அனைத்துக் கவிதைகளும் எந்தத் தலைப்பில் ஒட்டுமொத்தத் தொகுப்பாக 2001-ல் வெளிவந்தது?", "media_id": null}], "options": {"A": "காலத்தின் குரல்", "B": "உயிர்த்தெழும் காலத்துக்காக", "C": "எரியும் நினைவுகள்", "D": "புலம்பெயர் பறவைகள்"}, "explanation": "சு. வில்வரத்தினத்தின் கவிதைகள் 2001-ல் ‘உயிர்த்தெழும் காலத்துக்காக’ என்னும் தலைப்பில் முழுத் தொகுப்பாக வெளியிடப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "Under which title was the complete collection of Su. Vilvarathinam's poems published in 2001?", "media_id": null}], "options": {"A": "Kaalathin Kural", "B": "Uyirtthezhum Kaalathukkaaga", "C": "Eriyum Ninaivugal", "D": "Pulampeyar Paravaigal"}, "explanation": "His poetic oeuvre was brought out under the title 'Uyirtthezhum Kaalathukkaaga' in 2001."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Poetry", "Book Title"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q031", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "poetic_line_ammai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘என் அம்மை ஒற்றி வைத்தாள் / உதட்டில் விரல் வைத்து...’ - இப்பாடல் வரியில் ‘அம்மை’ என்று கவிஞர் யாரைக் குறிப்பிடுகிறார்?", "media_id": null}], "options": {"A": "பெற்ற தாய்", "B": "இயற்கைத் தாய்", "C": "தமிழ்த்தாய் (தாய்மொழி)", "D": "பூமித்தாய்"}, "explanation": "கவிஞர் சு. வில்வரத்தினம் தமது தாய்மொழியாகிய தமிழ்த்தாயையே ‘என் அம்மை’ என்று போற்றி உருகுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "'En ammai ottri vaithaal...' - Whom does the poet revere as 'Ammai' in this verse?", "media_id": null}], "options": {"A": "Biological Mother", "B": "Mother Nature", "C": "Mother Tamil (Mother Tongue)", "D": "Mother Earth"}, "explanation": "The poet reverentially invokes Mother Tamil (his mother tongue) as 'Ammai'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null, "source_notes": null}, "previous_y