{"id": "11th_tamil_u1_q108", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "paruthikoal_depth", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பருத்திக்குண்டிகை’ (பருத்திகோல்) போன்ற ஆசிரியர் மாணவர்க்கு எத்தகைய விளைவை ஏற்படுத்துகிறார்?", "media_id": null}], "options": {"A": "மாணவரை மேதையாக்குகிறார்", "B": "அமைதி ஏற்படுத்துகிறார்", "C": "செல்வம் தருகிறார்", "D": "தூய்மையான பஞ்சைக் கிழித்துக் குதறுவது போல, மாணவரின் நல்ல சிந்தனைகளைக் குழப்பிக் குலைத்துவிடுகிறார்"}, "explanation": "பருத்தி நூற்கப் பயன்படும் கருவி பஞ்சைச் சிதைத்து வீணடிப்பது போல, தகுதியற்ற ஆசிரியர் மாணவரின் அறிவுக் கூர்மையைக் குழப்பிப் பாழாக்கி விடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What damaging outcome does an instructor compared to 'Paruthikkundigai' (Cotton Spindle) inflict on learners?", "media_id": null}], "options": {"A": "Transforms students into geniuses", "B": "Induces tranquil serenity", "C": "Bestows abundant wealth", "D": "Muddles and shreds the pristine cognitive faculties of students, like an erratic spindle tangling pure cotton"}, "explanation": "Like a defective spindle tearing apart pure cotton, a bad teacher wrecks student potential."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 8, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 8", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Grammar", "Teacher Similes"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q109", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "soil_simile_student", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இடைமாணாக்கருக்கு ‘மண்’ (நிலம்) உவமையாக்கப்பட்டதன் நுட்பம் யாது?", "media_id": null}], "options": {"A": "உழவன் எவ்வளவு பாடுபட்டு உழுகிறானோ அவ்வளவே பலன் தருவது போல, ஆசிரியர் எவ்வளவு வருந்தி கற்பிக்கிறாரோ அவ்வளவு மட்டுமே கற்பதால்", "B": "மண் எப்போதும் ஈரமாக இருப்பதால்", "C": "மண் தூசியாக மாறுவதால்", "D": "மண்ணில் வீடு கட்டுவதால்"}, "explanation": "நிலமானது உழவன் உழுது பண்படுத்திய அளவுக்கு மட்டுமே பயிர் விளையும்; அதுபோல ஆசிரியர் வருந்திச் சொல்லித் தந்த அளவிற்கு மேல் சுயமாக அறிவைப் பெருக்காதவன் இடைமாணாக்கன்."}, "en": {"blocks": [{"type": "text", "content": "Why is 'Mann' (Tilled Soil) the precise simile for a middle-tier (Idai) student?", "media_id": null}], "options": {"A": "Yielding grain strictly in proportion to how deeply the farmer plows, the student absorbs only as much as the teacher toils to drill into him", "B": "Because soil is always damp", "C": "Because soil turns to dust", "D": "Because houses are erected on soil"}, "explanation": "Soil yields harvest strictly proportional to farmer's plowing effort; the mediocre student shows no self-propelled inquiry."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multip