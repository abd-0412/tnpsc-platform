{"id": "11th_tamil_u1_q168", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "grammar_first_last_letters", "chapter_id": null, "topic_id": "total_phonological_system", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் மொழி முதல் மற்றும் இறுதி எழுத்துகளின் விதிகளால் பாதுகாக்கப்படுவது எது?", "media_id": null}], "options": {"A": "மரக்கட்டைகளின் தரம்", "B": "கடற்கரை எல்லைகள்", "C": "நாணயங்களின் மதிப்பு", "D": "தமிழ் மொழியின் தனித்துவமான ஒலிப்பு முறை மற்றும் உச்சரிப்புத் தூய்மை (Phonological Integrity)"}, "explanation": "எந்தெந்த ஒலிகள் முதலில் வர வேண்டும், இறுதியில் வர வேண்டும் என்ற இலக்கண வரையறையே தமிழ் மொழியின் இனிமையையும் ஒலிப்புத் தூய்மையையும் பல்லாயிரம் ஆண்டுகளாகப் பாதுகாத்து வருகிறது."}, "en": {"blocks": [{"type": "text", "content": "What foundational dimension of Tamil is safeguarded across millennia by these strict initial and terminal phonological rules?", "media_id": null}], "options": {"A": "Wood quality", "B": "Coastal boundaries", "C": "Currency exchange rates", "D": "The distinct phonological integrity, acoustic beauty, and pristine pronunciation purity of the language"}, "explanation": "These phonetic canons preserve the melodic and acoustic identity of classical Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samache