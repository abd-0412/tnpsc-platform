{"id": "11th_tamil_u1_q091", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "student_three_grades", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நன்னூல் மாணாக்கர்களை எத்தனை பிரிவுகளாக வகைப்படுத்துகிறது?", "media_id": null}], "options": {"A": "இரண்டு பிரிவுகள்", "B": "நான்கு பிரிவுகள்", "C": "மூன்று பிரிவுகள் (தலை, இடை, கடை)", "D": "ஐந்து பிரிவுகள்"}, "explanation": "நன்னூலார் மாணவர்களைத் தலைமாணாக்கர் (முதல்), இடைமாணாக்கர் (இரண்டாம் நிலை), கடைமாணாக்கர் (கீழ்நிலை) என மூவகையாகப் பிரிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "Into how many tiers does Nannool classify students according to their learning faculties?", "media_id": null}], "options": {"A": "Two tiers", "B": "Four tiers", "C": "Three tiers (Thalai, Idai, Kadai)", "D": "Five tiers"}, "explanation": "Nannool categorizes learners into three grades: superior (Thalai), mediocre (Idai), and substandard (Kadai)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 9, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 9", "url": null, "sour