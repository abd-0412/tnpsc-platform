{"id": "11th_tamil_u1_q103", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "madarpannai_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆசிரியராகாதாரில் ‘மடற்பனை’ என்பது எதனால் உவமையாயிற்று?", "media_id": null}], "options": {"A": "பனைமரம் குளிர்ச்சி தருவதால்", "B": "பனைமரம் பழம் தருவதால்", "C": "முட்கள் நிறைந்து, தன்னை அண்டியவர்க்கு எளிதில் உதவாமல் உயர்ந்து நின்று துன்பம் தருவதால்", "D": "பனைமரம் ஓலை தருவதால்"}, "explanation": "மடற்பனை கூர்மையான முட்களை உடையது; ஏறிப் பயன் பெற முயல்வோரைக் காயப்படுத்துவது போல அணுக முடியாத கடின நெஞ்ச ஆசிரியருக்கு உவமையாயிற்று."}, "en": {"blocks": [{"type": "text", "content": "Why does the thorny 'Palmyra' (Madarpannai) serve as a metaphor for an unworthy instructor?", "media_id": null}], "options": {"A": "Because palm trees provide shade", "B": "Because palm trees yield sweet fruit", "C": "Because its trunk is bristling with sharp thorns, wounding those who approach instead of readily offering benefit", "D": "Because palm leaves are used for writing"}, "explanation": "The wild palmyra is barbed and inaccessible; mirroring an abrasive teacher who rebuffs eager students."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publis