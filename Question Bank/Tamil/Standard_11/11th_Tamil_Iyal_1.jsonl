{"id": "11th_tamil_u1_q085", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "nallasiriyar_four", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நன்னூலில் நல்லாசிரியருக்கு உவமையாகக் கூறப்பட்டுள்ள நான்கு பொருள்கள் எவை?", "media_id": null}], "options": {"A": "நிலம், மலை, நிறைகோல், மலர்", "B": "மழை, காற்று, கடல், தீ", "C": "அன்னம், பசு, கிளி, மயில்", "D": "தங்கம், வைரம், முத்து, பவளம்"}, "explanation": "நன்னூலார் நல்லாசிரியர்க்கு உவமையாக நிலம், மலை, நிறைகோல் (தராசு), மலர் ஆகிய நான்கினையும் குறிப்பிடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Which four entities are metaphorically invoked as ideal paragons of an exemplary teacher in Nannool?", "media_id": null}], "options": {"A": "Nilam (Earth), Malai (Mountain), Niraikoal (Balance scales), Malar (Flower)", "B": "Rain, Wind, Ocean, Fire", "C": "Swan, Cow, Parrot, Peacock", "D": "Gold, Diamond, Pearl, Coral"}, "explanation": "Nannool establishes Earth, Mountain, Balance Scale, and Flower as archetypes of a great teacher."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page"