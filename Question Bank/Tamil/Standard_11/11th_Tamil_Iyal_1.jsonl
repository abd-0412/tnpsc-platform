{"id": "11th_tamil_u1_q018", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "prose_speech_and_poem", "chapter_id": null, "topic_id": "pyq_indiran_award", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] கவிஞர் இந்திரன் சாகித்திய அகாதெமி விருது பெற்ற ஆண்டு எது?", "media_id": null}], "options": {"A": "2008", "B": "2011", "C": "2015", "D": "2019"}, "explanation": "கவிஞர் இந்திரன் 2011-ஆம் ஆண்டில் மொழிபெயர்ப்புக்கான சாகித்திய அகாதெமி விருதினைப் பெற்றார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] In which year did poet Indiran receive the Sahitya Akademi Award for Translation?", "media_id": null}], "options": {"A": "2008", "B": "2011", "C": "2015", "D": "2019"}, "explanation": "Poet Indiran won the prestigious Sahitya Akademi Award in the year 2011."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC", "exam_name": "Group 2/2A", "year": 2022, "paper": null, "session": null}, "media": {"has_med