{"id": "11th_tamil_u1_q097", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "kadai_maanaakkar_four", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கடைமாணாக்கருக்கு (கீழ்நிலை மாணவர்) நன்னூலில் கூறப்பட்டுள்ள நான்கு உவமைகள் எவை?", "media_id": null}], "options": {"A": "இல்லிக்குடம், ஆடு, எருமை, பன்னாடை", "B": "நிலம், மலை, தராசு, மலர்", "C": "மடற்பனை, குடம், கோல், தெங்கு", "D": "அன்னம், பசு, மண், கிளி"}, "explanation": "கடைமாணாக்கர்க்குரிய உவமைகள்: 1. இல்லிக்குடம் (ஓட்டைக்குடம்), 2. ஆடு, 3. எருமை, 4. பன்னாடை (கள்ளின் கசடைத் தேக்கும் வடிகட்டி)."}, "en": {"blocks": [{"type": "text", "content": "Which four deficient entities serve as metaphors for substandard students (Kadai Maanaakkar) in Nannool?", "media_id": null}], "options": {"A": "Illikkudam (Perforated pot), Aadu (Goat), Erumai (Buffalo), Pannaadai (Toddy strainer)", "B": "Earth, Mountain, Scale, Flower", "C": "Palmyra, Jar, Spindle, Coconut", "D": "Swan, Cow, Soil, Parrot"}, "explanation": "Leaky pot, roaming goat, wallowing buffalo, and coarse toddy-strainer typify third-tier learners."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 9, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 9", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Grammar", "Student Similes"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q098", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "illikkudam_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஆசிரியர் கற்பிக்கும் போது கேட்டுக் கொண்டேயிருந்து, அவர் முடித்தவுடன் அனைத்தையும் மறந்து வெற்றிடமாகும் மாணவன்’ எதற்கு உவமை?", "media_id": null}], "options": {"A": "பன்னாடை", "B": "இல்லிக்குடம் (ஓட்டைக்குடம்)", "C": "ஆடு", "D": "எருமை"}, "explanation": "இல்லிக்குடம் (அடிப்புறம் ஓட்டையுள்ள குடம்) நீர் நிரப்ப நிரப்ப வெளியேறி காலியாவது போல, ஆசிரியர் கற்பிக்கக் கற்பிக்க மறந்துவிடுபவன் இல்லிக்குட மாணவன்."}, "en": {"blocks": [{"type": "text", "content": "Which simile depicts a student into whose ears wisdom is poured, yet it leaks away entirely leaving him completely empty?", "media_id": null}], "options": {"A": "Pannaadai (Strainer)", "B": "Illikkudam (Perforated leaky pot)", "C": "Goat", "D": "Buffalo"}, "explanation": "A perforated pot cannot hold water; an inattentive learner retains nothing after the lecture."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 9, "chapter": null, "section"