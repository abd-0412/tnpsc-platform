{"id": "11th_tamil_u1_q050", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "meaning_puvi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘புவிமுழுதும்’ என்னும் சொல்லில் இடம்பெற்றுள்ள ‘புவி’ என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "வானம்", "B": "பூமி (உலகம்)", "C": "கடல்", "D": "நெருப்பு"}, "explanation": "புவி என்றால் பூமி அல்லது உலகம் என்று பொருள்படும்."}, "en": {"blocks": [{"type": "text", "content": "What does the word 'Puvi' signify in the verse compound 'Puvimuzhuthum'?", "media_id": null}], "options": {"A": "Sky", "B": "Earth (World)", "C": "Ocean", "D": "Fire"}, "explanation": "'Puvi' is the classical word for Earth / Globe."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Poetry", "Vocab