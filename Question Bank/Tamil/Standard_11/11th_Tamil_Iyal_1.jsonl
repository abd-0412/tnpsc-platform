{"id": "11th_tamil_u1_q067", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "nannool_sections", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நன்னூல் எத்தனை அதிகாரங்களைக் கொண்ட இலக்கண நூலாகும்?", "media_id": null}], "options": {"A": "ஐந்து அதிகாரங்கள்", "B": "மூன்று அதிகாரங்கள்", "C": "இரண்டு அதிகாரங்கள் (எழுத்ததிகாரம், சொல்லதிகாரம்)", "D": "நான்கு அதிகாரங்கள்"}, "explanation": "தொல்காப்பியம் 3 அதிகாரங்களைக் கொண்டது; நன்னூல் எழுத்ததிகாரம், சொல்லதிகாரம் என்னும் 2 அதிகாரங்களை மட்டுமே கொண்டது."}, "en": {"blocks": [{"type": "text", "content": "How many major Adhikarams (books/sections) constitute the treatise Nannool?", "media_id": null}], "options": {"A": "Five sections", "B": "Three sections", "C": "Two sections (Ezhuthu and Sol)", "D": "Four sections"}, "explanation": "Nannool contains two major sections: Orthography (Ezhuthu) and Morphology/Syntax (Sol)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 6", "url": null, "source_notes": null}, "previous_yea