{"id": "11th_tamil_u1_q016", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "prose_speech_and_poem", "chapter_id": null, "topic_id": "assertion_reason_speech", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): பேச்சு மொழி நேரடித் தன்மையையும், உடனடி உணர்வுப் பரிமாற்றத்தையும் தருகிறது.\nகாரணம் (R): பேசுபவரின் குரல்வளம், உடல்மொழி, முகம் ஆகியவற்றின் வழியே சொற்கள் உயிருள்ள கூறுகளாக வெளிப்படுகின்றன.", "media_id": null}], "options": {"A": "கூற்று (A) தவறு, காரணம் (R) சரி", "B": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) கூற்றை விளக்கவில்லை", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்"}, "explanation": "பேச்சு மொழி உடலோடும் குரலோடும் இணைந்து வருவதால் அது உடனடி உணர்வுப் பரிமாற்றத்தைத் தருகிறது. எனவே கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Spoken language provides directness and immediate emotional communion.\nReason (R): Words emerge as living elements through the speaker vocal tone, bodily presence, and facial expressions.", "media_id": null}], "options": {"A": "Assertion (A) is false, Reason (R) is true", "B": "Both Assertion (A) and Reason (R) are false", "C": "Assertion (A) is true, but Reason (R) does not explain it", "D": "Both Assertion (A) and Reason (R) are true; Reason is the correct explanation"}, "explanation": "Spoken communication embodies somatic and vocal cues, creating instant emotional resonance."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 3", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Prose", "Assertion-Reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q017", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "prose_speech_and_poem", "chapter_id": null, "topic_id": "odia_translation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் இந்திரன் சாகித்திய அகாதெமி விருது பெற்ற மொழிபெயர்ப்பு நூல் எந்த மாநிலக் கவிதைகளின் தொகுப்பாகும்?", "media_id": null}], "options": {"A": "ஒடிசா (ஒரியக் கவிதைகள்)", "B": "வங்கம் (வங்காளக் கவிதைகள்)", "C": "கேரளம் (மலையாளக் கவிதைகள்)", "D": "ஆந்திரம் (தெலுங்குக் கவிதைகள்)"}, "explanation": "மனோரமா பிஸ்வாலின் ஒரிய மொழி கவிதைகளைத் தமிழாக்கம் செய்ததற்காகவே அவருக்கு சாகித்திய அகாதெமி விருது வழங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "From which language were the poems translated by Indiran that won the Sahitya Akademi Award?", "media_id": null}], "options": {"A": "Odia (Oriya poetry)", "B": "Bengali", "C": "Malayalam", "D": "Telugu"}, "explanation": "The poems translated were by renowned Odia poet Manorama Biswal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 2", "url": null, "source_note