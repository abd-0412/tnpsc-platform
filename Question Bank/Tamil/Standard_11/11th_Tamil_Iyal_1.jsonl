{"id": "11th_tamil_u1_q027", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "prose_speech_and_poem", "chapter_id": null, "topic_id": "indiran_genre", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் இந்திரன் ‘பறவைகள் ஒருவேளை தூங்கப் போயிருக்கலாம்’ என்னும் நூலை எந்த இலக்கிய வகைமையில் படைத்தார்?", "media_id": null}], "options": {"A": "வரலாற்று நாவல்", "B": "சுயசரிதை", "C": "மொழிபெயர்ப்புக் கவிதை நூல்", "D": "நாடக நூல்"}, "explanation": "இது மனோரமா பிஸ்வாலின் ஒரியக் கவிதைகளைத் தமிழில் மொழிபெயர்த்த மொழிபெயர்ப்புக் கவிதை நூலாகும்."}, "en": {"blocks": [{"type": "text", "content": "Under which literary genre was Indiran's work 'Paravaigal Oruvelai Thoongap Poyirukkalaam' produced?", "media_id": null}], "options": {"A": "Historical Novel", "B": "Autobiography", "C": "Translated Poetry Collection", "D": "Dramatic Play"}, "explanation": "It is a translated volume of contemporary Odia poetry into Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_p