{"id": "11th_tamil_u1_q009", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "prose_speech_and_poem", "chapter_id": null, "topic_id": "neruda_language", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலி நாட்டுக் கவிஞரான பாப்லோ நெருடா எந்த மொழியில் தமது உலகப் புகழ்பெற்ற கவிதைகளை எழுதினார்?", "media_id": null}], "options": {"A": "ஸ்பானிஷ் (Spanish)", "B": "போர்ச்சுகீசியம் (Portuguese)", "C": "பிரெஞ்சு (French)", "D": "ஜெர்மன் (German)"}, "explanation": "பாப்லோ நெருடா தமது தாய்மொழியான ஸ்பானிஷ் (Spanish) மொழியில் கவிதைகளை எழுதினார்; சொற்களின் வண்ணங்களையும் ஒலிகளையும் அவர் கொண்டாடினார்."}, "en": {"blocks": [{"type": "text", "content": "In which language did Chilean Nobel laureate poet Pablo Neruda compose his world-renowned poetry?", "media_id": null}], "options": {"A": "Spanish", "B": "Portuguese", "C": "French", "D": "German"}, "explanation": "Pablo Neruda wrote in Spanish, passionately celebrating the sensory colors and music of words."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 4, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 4", "url": null, "source_