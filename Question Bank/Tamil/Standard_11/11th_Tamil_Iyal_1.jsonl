{"id": "11th_tamil_u1_q012", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "prose_speech_and_poem", "chapter_id": null, "topic_id": "valery_metaphor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பால் வலேரியின் கூற்றுப்படி, நடை (Walking) எதனை இலக்காகக் கொண்டது?", "media_id": null}], "options": {"A": "உடலின் தாள அழகை மட்டுமே", "B": "தன்னையே ரசித்து மகிழ்வதை", "C": "காற்றின் திசையில் அலைவதை", "D": "ஓர் இடத்தை அடைவது என்னும் குறிப்பிட்ட பயன்பாட்டை (Utility)"}, "explanation": "நடை (உரைநடை) என்பது ஒரு குறிப்பிட்ட இடத்தை அடைவதற்கான செயல்; ஆனால் நடனம் (கவிதை) என்பது இலக்கை விட அதன் இயக்கம், தாளம், அழகியல் அனுபவத்தையே நோக்கமாகக் கொண்டது."}, "en": {"blocks": [{"type": "text", "content": "According to Paul Valery, what is the prime target of walking (representing prose)?", "media_id": null}], "options": {"A": "Only the rhythmic beauty of body", "B": "Self-admiration and enjoyment", "C": "Aimless wandering in the wind", "D": "A specific utility of reaching a destination"}, "explanation": "Prose walking aims to reach a utilitarian destination, while poetic dancing focuses on intrinsic aesthetic motion and rhythm."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 3", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Prose", "Paul Valery"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q013", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "prose_speech_and_poem", "chapter_id": null, "topic_id": "symbolism_concept", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறியீட்டியல் (Symbolism) கவிஞர்கள் ஒரு பொருளை நேரடியாக விவரிக்காமல் எதன் மூலம் உணர்த்த முற்படுகின்றனர்?", "media_id": null}], "options": {"A": "குறிப்பு, மறைமுகப் படிமம் மற்றும் குறியீடுகள் மூலம்", "B": "நீண்ட உரைநடை விளக்கங்கள் மூலம்", "C": "சந்தப் பாடல்களின் ஓசை மூலம் மட்டுமே", "D": "அகராதிப் பொருள் மூலமாக மட்டுமே"}, "explanation": "குறியீட்டுவாதிகள் ஒரு பொருளைப் பட்டவர்த்தனமாக விவரிக்காமல், குறியீடுகள் மற்றும் குறிப்புப் பொருள் மூலமாக வாசகரின் கற்பனைக்கு விரிவடைய விடுகின்றனர்."}, "en": {"blocks": [{"type": "text", "content": "How do symbolist poets communicate an experience rather than describing it directly?", "media_id": null}], "options": {"A": "Through suggestions, indirect imagery, and symbols", "B": "Through long prose elaborations", "C": "Solely through musical sound patterns", "D": "Exclusively through literal dictionary definitions"}, "explanation": "Symbolists evoke mood and essence through evocative suggestions, imagery, and symbols rather than direct literal description."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer 