{"id": "11th_tamil_u1_q029", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "author_origin", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘யுகத்தின் பாடல்’ என்னும் கவிதையை இயற்றிய சு. வில்வரத்தினம் இலங்கையில் எந்த ஊரில் பிறந்தார்?", "media_id": null}], "options": {"A": "யாழ்ப்பாணம் புங்குடுதீவு", "B": "மட்டக்களப்பு ஆரையம்பதி", "C": "கொழும்பு பம்பலப்பிட்டி", "D": "திருகோணமலை சம்பூர்"}, "explanation": "சு. வில்வரத்தினம் யாழ்ப்பாணத்தின் புங்குடுதீவில் பிறந்த ஈழத்துக் கவிஞர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "In which town in Sri Lanka was poet Su. Vilvarathinam, author of 'Yugathin Paadal', born?", "media_id": null}], "options": {"A": "Pungudutheevu, Jaffna", "B": "Arayampathy, Batticaloa", "C": "Bambalapitiya, Colombo", "D": "Sampoor, Trincomalee"}, "explanation": "Su. Vilvarathinam was born in Pungudutheevu, Jaffna, Sri Lanka."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null, "source_notes": null}, "previous_year": {"i