{"id": "11th_tamil_u1_q054", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "correct_statement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சு. வில்வரத்தினம் பற்றிய கீழ்க்கண்ட கூற்றுகளில் எது சரியானது?", "media_id": null}], "options": {"A": "இவர் தமிழகத்தின் தஞ்சாவூரில் பிறந்தவர்", "B": "இவர் 2001-ல் ‘உயிர்த்தெழும் காலத்துக்காக’ என்னும் கவிதைத் தொகுப்பை வெளியிட்ட ஈழத்துக் கவிஞர்", "C": "இவர் திரைப்படப் பாடல்களை மட்டுமே எழுதியவர்", "D": "இவர் 2011-ல் சாகித்திய அகாதெமி விருது பெற்றார்"}, "explanation": "கூற்று B மிகச்சரியானது. இவர் யாழ்ப்பாணம் புங்குடுதீவில் பிறந்த ஈழத்துக் கவிஞர்; 2001-ல் இத்தொகுப்பு வெளிவந்தது."}, "en": {"blocks": [{"type": "text", "content": "Which of the following statements about Su. Vilvarathinam is strictly accurate?", "media_id": null}], "options": {"A": "He was born in Thanjavur, Tamil Nadu", "B": "He was a Sri Lankan Tamil poet whose compilation 'Uyirtthezhum Kaalathukkaaga' came out in 2001", "C": "He exclusively composed cinema lyrics", "D": "He won the Sahitya Akademi Award in 2011"}, "explanation": "Statement B is correct: He was an Eelam poet whose major collection appeared in 2001."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "