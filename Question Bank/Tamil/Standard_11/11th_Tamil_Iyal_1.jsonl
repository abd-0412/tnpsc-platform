{"id": "11th_tamil_u1_q039", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "grammatical_category", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘எரிகின்ற’ - இச்சொல்லின் இலக்கணக் குறிப்பு யாது?", "media_id": null}], "options": {"A": "வினையெச்சம்", "B": "தொழிற்பெயர்", "C": "பெயரெச்சம் (தெரிநிலை பெயரெச்சம்)", "D": "முற்றெச்சம்"}, "explanation": "எரிகின்ற என்பது ‘அ’ என்னும் விகுதி பெற்றுப் பெயரை எதிர்பார்த்து நிற்கும் நிகழ்காலப் பெயரெச்சம் (எரிகின்ற தணல் / எரிகின்ற தீ)."}, "en": {"blocks": [{"type": "text", "content": "What is the grammatical classification of the Tamil word 'Erigindra'?", "media_id": null}], "options": {"A": "Vinaiyecham (Adverbial participle)", "B": "Thozhirpeyar (Verbal noun)", "C": "Peyarecham (Relative adjectival participle)", "D": "Muttrecham"}, "explanation": "'Erigindra' ending in 'a' modifies a succeeding noun as a present relative adjectival participle."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null, "source_n