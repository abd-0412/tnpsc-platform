{"id": "11th_tamil_u1_q075", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "pothupaayiram_details", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்கண்டவற்றுள் பொதுப்பாயிரத்தின் 5 கூறுகளில் இடம்பெறாத ஒன்று எது?", "media_id": null}], "options": {"A": "ஆசிரியர் வரலாறு", "B": "கற்பிக்கும் முறைமை", "C": "நூல் அரங்கேற்றப்பட்ட நாட்டின் எல்லை", "D": "மாணவர் வரலாறு"}, "explanation": "எல்லை என்பது சிறப்புப்பாயிரத்திற்குரிய கூறாகும்; பொதுப்பாயிரத்தில் நூலின் இயல்பு, ஆசிரியர் இயல்பு, கற்பித்தல், மாணவர் இயல்பு, கற்கும் முறைமை ஆகிய ஐந்தே இடம்பெறும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following does NOT belong to the 5 elements of Pothuppaayiram?", "media_id": null}], "options": {"A": "Nature of the teacher", "B": "Methodology of teaching", "C": "Geographical border of the country", "D": "Nature of the student"}, "explanation": "Territorial boundary (Ellai) is an attribute of Chirappuppaayiram, not Pothuppaayiram."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "referen