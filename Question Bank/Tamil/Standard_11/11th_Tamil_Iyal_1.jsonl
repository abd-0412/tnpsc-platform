{"id": "11th_tamil_u1_q106", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "full_knowledge_method", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நன்னூலின் வழி மாணவன் ஒருவன் முழுமையான அறிவைப் பெறுவதற்கு அவசியமான வழிமுறை யாது?", "media_id": null}], "options": {"A": "புத்தகங்களை வாங்குவது மட்டுமே", "B": "ஆசிரியரிடம் கற்றல், ஒருசாலை மாணாக்கருடன் விவாதித்தல் மற்றும் பிறருக்குத் தான் கற்றதை உரைத்தல்", "C": "தேர்வுகளைத் தவிர்ப்பது", "D": "மனனம் செய்து மறப்பது"}, "explanation": "ஆசான் உரைத்தது அமைவரக் கொளினும் கால் கூfraction; தம்முடன் பயில்வோரொடு வினவிப் பயிலின் கால்; பிறர்க்கு உணர்த்தின் முக்கால் என முழுமை பெறும்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the holistic methodology to achieve 100% intellectual fruition according to grammatical pedagogy?", "media_id": null}], "options": {"A": "Merely purchasing manuscripts", "B": "Learning from teacher, rigorous debate with peers, and pedagogical dissemination to others", "C": "Avoiding formal assessments", "D": "Rote cramming and forgetting"}, "explanation": "Mastery culminates through teacher instruction, intense peer debate, and instructing others."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 9, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 9", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Pedagogy", "Holistic Learning"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q107", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "mountain_simile_depth", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நல்லாசிரியருக்கு உவமையான ‘மலை’ உணர்த்தும் மூன்று முதன்மைப் பண்புகள் எவை?", "media_id": null}], "options": {"A": "குளிர்ச்சி, நிழல், காற்று", "B": "பனி, மழை, மேகம்", "C": "அளக்க முடியாத பெருமை (தோற்றம்), அளப்பரிய பொருள் வளம் (அறிவு), தன்னை நாடி வந்தோர்க்கு வாரி வழங்கும் கருணை", "D": "உயரம், பாறை, கற்கள்"}, "explanation": "மலை தோற்றத்தால் கம்பீரமானது, அளவில்லா வளங்களை உள்ளடக்கியது, தன்னை அண்டி வந்தோர்க்கு வாரி வழங்குவது. அதுபோலவே நல்லாசிரியரும் திகழ வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "Which three quintessential virtues are symbolized by the 'Mountain' (Malai) archetype of a noble instructor?", "media_id": null}], "options": {"A": "Coolness, shadow, and breeze", "B": "Snow, rain, and cloud", "C": "Majestic moral stature, inexhaustible treasure of wisdom, and unconditional generosity to seekers", "D": "Sheer height, granite, and gravel"}, "explanation": "A mountain possesses vast grandeur, inexhaustible mineral treasures, and bestows bounty on all seekers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi",