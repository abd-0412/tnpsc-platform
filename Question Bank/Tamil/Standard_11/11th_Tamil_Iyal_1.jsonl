{"id": "11th_tamil_u1_q096", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "parrot_analogy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஆசிரியர் சொல்லிக் கொடுத்ததை அப்படியே திரும்பச் சொல்வதைத் தவிர, சுயமாகச் சிந்திக்கும் ஆற்றல் இல்லாத மாணவன்’ - எந்த உவமையால் குறிக்கப்படுகிறான்?", "media_id": null}], "options": {"A": "பசு", "B": "அன்னம்", "C": "மண்", "D": "கிளி"}, "explanation": "கிளி தான் கேட்ட சொற்களைத் திரும்பக் கூறுமே தவிர சுயமாகச் சிந்திக்காது; அதுபோல ஆசிரியர் கற்பித்ததை மட்டுமே மனனம் செய்து ஒப்புவிப்பவன் இடைமாணாக்கன்."}, "en": {"blocks": [{"type": "text", "content": "Which simile designates a student who mechanically repeats what the teacher recited without spontaneous individual cognition?", "media_id": null}], "options": {"A": "Cow", "B": "Swan", "C": "Soil", "D": "Parrot (Kili)"}, "explanation": "A parrot echoes words mechanically without comprehension; matching the rote memorizer."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 9, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 9", "url