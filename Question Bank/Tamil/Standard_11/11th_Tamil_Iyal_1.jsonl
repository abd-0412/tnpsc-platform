{"id": "11th_tamil_u1_q124", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "supplementary_aaraam_thinai", "chapter_id": null, "topic_id": "novel_thigadasakkaram", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அ. முத்துலிங்கம் எழுதிய பிற நூல்களுள் பொருந்தாத ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "குதிரைக்காரன்", "B": "கொழுந்தாடை", "C": "திகடசக்கரம்", "D": "வாடிவாசல்"}, "explanation": "வாடிவாசல் என்பது சி. சு. செல்லப்பா எழுதிய குறுநாவல்; குதிரைக்காரன், கொழுந்தாடை, திகடசக்கரம், உண்மை கலந்த நாவல் ஆகியவை அ. முத்துலிங்கத்தின் படைப்புகளாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the work which was NOT authored by A. Muthulingam:", "media_id": null}], "options": {"A": "Kuthiraikkaaran", "B": "Kozhunthaadai", "C": "Thigadasakkaram", "D": "Vaadivaasal"}, "explanation": "'Vaadivaasal' was authored by C. S. Chellappa; the other three are celebrated works of A. Muthulingam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 10, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 10", "url": null, "source_notes": null}, "previous_year": {"is_p