{"id": "11th_tamil_u1_q051", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "vilvarathinam_collection_year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சு. வில்வரத்தினத்தின் கவிதைத் தொகுப்பான ‘உயிர்த்தெழும் காலத்துக்காக’ எந்த ஆண்டு சென்னையில் உள்ள காலச்சுவடு பதிப்பகத்தால் வெளியிடப்பட்டது?", "media_id": null}], "options": {"A": "1991", "B": "1996", "C": "2001", "D": "2008"}, "explanation": "2001-ஆம் ஆண்டில் காலச்சுவடு பதிப்பகம் மூலம் இத்தொகுப்பு வெளிவந்தது."}, "en": {"blocks": [{"type": "text", "content": "In which year was Su. Vilvarathinam's anthology 'Uyirtthezhum Kaalathukkaaga' published by Kalachuvadu in Chennai?", "media_id": null}], "options": {"A": "1991", "B": "1996", "C": "2001", "D": "2008"}, "explanation": "The comprehensive anthology was published in the year 2001."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": nul