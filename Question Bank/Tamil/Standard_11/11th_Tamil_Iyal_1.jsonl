{"id": "11th_tamil_u1_q100", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "goat_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒரு பாடத்தை முழுமையாகக் கற்காமல், ஒரு செடியின் நுனியை மேய்ந்துவிட்டு அடுத்த செடிக்குத் தாவும் ஆடு போல மனம் அலைபாய்பவன் யார்?", "media_id": null}], "options": {"A": "தலைமாணாக்கன்", "B": "இடைமாணாக்கன்", "C": "நல்லாசிரியர்", "D": "ஆடு போன்ற கடைமாணாக்கன்"}, "explanation": "ஆடு ஓர் இடத்தில் நிலைக்காமல் அலைந்து மேய்வது போல, நிலையான கவனமின்றி பல பாடங்களிலும் மேலோட்டமாகத் தாவி எதையும் முழுமையாகக் கற்காதவன் ஆடு போன்ற மாணவன்."}, "en": {"blocks": [{"type": "text", "content": "Who is characterized as fleeting superficially from one topic to another without thorough mastery, like a goat nibbling one bush and leaping to another?", "media_id": null}], "options": {"A": "Superior student", "B": "Mediocre student", "C": "Great teacher", "D": "Goat-like third-tier student (Aadu)"}, "explanation": "A goat flits erratically from plant to plant; an undisciplined student skims topics without mastering anything."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term