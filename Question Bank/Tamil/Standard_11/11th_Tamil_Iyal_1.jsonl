{"id": "11th_tamil_u1_q024", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "prose_speech_and_poem", "chapter_id": null, "topic_id": "prose_summary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பேச்சுமொழியும் கவிதைமொழியும்’ பாடத்தின் இறுதி மையக் கருத்து யாது?", "media_id": null}], "options": {"A": "எழுத்து மொழியே எப்போதும் முதன்மையானது", "B": "கவிதைகளில் பிறமொழிச் சொற்களே ஆதிக்கம் செலுத்த வேண்டும்", "C": "பேச்சு மொழியை இலக்கியத்தில் முற்றிலும் தவிர்க்க வேண்டும்", "D": "பேச்சுமொழியின் உயிர்ப்பையும் நேரடித்தன்மையையும் உட்கொண்டு படைக்கப்படும் கவிதையே காலத்தை வென்று நிற்கும்"}, "explanation": "மக்களின் உயிரோட்டமான பேச்சுமொழியின் வலிமையை உள்வாங்கி படைக்கப்படும் கவிதைகளே அதிக தாக்கத்தை ஏற்படுத்தி காலத்தை வென்று நிற்கும் என்பது இப்பாடத்தின் மையக் கருத்தாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the central takeaway of the essay 'Pechumozhiyum Kavithaimozhiyum'?", "media_id": null}], "options": {"A": "Written language is always inherently superior", "B": "Foreign words must dominate poetry", "C": "Spoken language must be totally eradicated from literature", "D": "Poetry that harnesses the living immediacy and authenticity of spoken idiom endures through time"}, "explanation": "Poetry drawn from the living, direct vitality of genuine speech resonates across generations."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_