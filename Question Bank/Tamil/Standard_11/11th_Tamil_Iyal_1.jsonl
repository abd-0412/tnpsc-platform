{"id": "11th_tamil_u1_q037", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "eelam_literature", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஈழத்துக் கவிதைகளின் முதன்மையான தனித்துவ அடையாளமாகக் கருதப்படுவது எது?", "media_id": null}], "options": {"A": "மண்ணின் விடுதலை வேட்கை, போர் அவலங்கள் மற்றும் புலம்பெயர் வாழ்வின் வலி", "B": "அரண்மனை அந்தப்புர வருணனைகள்", "C": "காதல் கேளிக்கைகள் மட்டுமே", "D": "புராணக் கதைகளை மீளுருவாக்கம் செய்வது மட்டுமே"}, "explanation": "ஈழத்து இலக்கியங்கள் அங்குள்ள மக்களின் வரலாற்றுத் துயரங்களையும், விடுதலைப் போராட்டத்தையும், புலம்பெயர்ந்து வாழ நேரிட்ட அகதி வாழ்வின் வலியையும் தீவிரமாகப் பதிவு செய்கின்றன."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the primary hallmark of Sri Lankan Tamil Eelam poetry?", "media_id": null}], "options": {"A": "Thirst for homeland liberation, war atrocities, and existential anguish of diaspora", "B": "Imperial palace romances", "C": "Mere hedonistic escapism", "D": "Exclusive mythical retellings"}, "explanation": "Eelam Tamil poetry is deeply rooted in the crucible of war, homeland aspirations, and diasporic trauma."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu T