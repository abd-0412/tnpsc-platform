{"id": "11th_tamil_u1_q195", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "revision_unit_1", "chapter_id": null, "topic_id": "seventh_thinai_concept", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஆறாம் திணை’ கதையின் படி, தமிழர்களின் புதிய வாழ்விடமாக மாறிய நாடு எது?", "media_id": null}], "options": {"A": "எகிப்து", "B": "பிரேசில்", "C": "கனடா உள்ளிட்ட பனிப் பிரதேச நாடுகள்", "D": "மடகாஸ்கர்"}, "explanation": "கனடா போன்ற கடும் குளிர் பிரதேசங்களில் தமிழர்கள் பெருமளவில் குடியேறி வாழ்வதால் அதனைப் பனிநிலமான ஆறாம் திணை என்கிறார் ஆசிரியர்."}, "en": {"blocks": [{"type": "text", "content": "According to the story 'Aaraam Thinai', which cold country has become a prominent new homeland of the Tamil diaspora?", "media_id": null}], "options": {"A": "Egypt", "B": "Brazil", "C": "Canada and sub-zero arctic diaspora realms", "D": "Madagascar"}, "explanation": "Canada exemplifies the snow-bound Sixth Thinai inhabited by millions in the diaspora."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 10, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 10", "url": null, "source_n