{"id": "11th_tamil_u1_q110", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "all_analogies_summary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நன்னூல் பாயிரத்தில் ஆசிரியருக்கும் மாணவருக்கும் உவமையாகக் கூறப்பட்டுள்ள மொத்த உவமைப் பொருள்களின் எண்ணிக்கை யாது?", "media_id": null}], "options": {"A": "ஆசிரியர் 4, மாணவர் 4 = மொத்தம் 8", "B": "ஆசிரியர் 8 (4 நல் + 4 கடை), மாணவர் 8 (2 தலை + 2 இடை + 4 கடை) = மொத்தம் 16", "C": "ஆசிரியர் 5, மாணவர் 5 = மொத்தம் 10", "D": "ஆசிரியர் 10, மாணவர் 10 = மொத்தம் 20"}, "explanation": "நல்லாசிரியர் 4 + கடையாசிரியர் 4 = 8; தலைமாணாக்கர் 2 + இடைமாணாக்கர் 2 + கடைமாணாக்கர் 4 = 8. மொத்தம் 16 உவமைகள் மிக நுட்பமாக விவரிக்கப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "What is the grand total of allegorical similes detailed across teachers and students in Nannool's pedagogy section?", "media_id": null}], "options": {"A": "4 Teachers, 4 Students = Total 8", "B": "8 Teachers (4 noble + 4 base) and 8 Students (2 top + 2 mid + 4 base) = Total 16 similes", "C": "5 Teachers, 5 Students = Total 10", "D": "10 Teachers, 10 Students = Total 20"}, "explanation": "Nannool marshals exactly 16 similes: 8 for instructors (4 exemplary + 4 unworthy) and 8 for disciples (2 first + 2 mid + 4 base)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow