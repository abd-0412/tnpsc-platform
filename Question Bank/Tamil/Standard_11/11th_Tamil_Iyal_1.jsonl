{"id": "11th_tamil_u1_q014", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "prose_speech_and_poem", "chapter_id": null, "topic_id": "indiran_contribution", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் இந்திரன் எந்தெந்தத் துறைகளில் தனது ஆளுமையைச் செலுத்தியுள்ளார்?", "media_id": null}], "options": {"A": "நாடக நடிகர் மற்றும் பின்னணிப் பாடகர்", "B": "கலை விமர்சகர், கவிஞர், மொழிபெயர்ப்பாளர் மற்றும் இதழாளர்", "C": "திரைப்படத் தயாரிப்பாளர் மற்றும் தொல்லியல் ஆய்வாளர்", "D": "அரசியல் தலைவர் மற்றும் கல்வெட்டாய்வாளர்"}, "explanation": "கவிஞர் இந்திரன் நவீன கலை விமர்சகராகவும், சிறந்த கவிஞராகவும், சாகித்திய அகாதெமி பெற்ற மொழிபெயர்ப்பாளராகவும் பல்துறை ஆளுமை கொண்டவர்."}, "en": {"blocks": [{"type": "text", "content": "In which fields has poet Indiran exerted his multifaceted contributions?", "media_id": null}], "options": {"A": "Stage actor and playback singer", "B": "Art critic, poet, translator, and editor", "C": "Film producer and archaeologist", "D": "Political diplomat and epigraphist"}, "explanation": "Indiran is well-known as a modern art critic, renowned poet, Sahitya Akademi winning translator, and literary magazine editor."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Prose", "Biography"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q015", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "prose_speech_and_poem", "chapter_id": null, "topic_id": "living_language", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மொழியின் முதன்மையான உயிர்ப்பு எங்கு நிகழ்கிறது?’ என்று ஆசிரியர் இந்திரன் குறிப்பிடுகிறார்?", "media_id": null}], "options": {"A": "அகராதிகளின் பக்கங்களில்", "B": "பழங்காலக் கல்வெட்டுகளில்", "C": "மக்களின் அன்றாடப் பேச்சு வழக்கில்", "D": "அரசாணை ஆவணங்களில்"}, "explanation": "மொழியின் உண்மையான உயிரோட்டம் மற்றும் தொடர்ச்சியான மாற்றம் என்பது அன்றாடம் மக்கள் பேசும் பேச்சு வழக்கிலேயே நிகழ்கிறது."}, "en": {"blocks": [{"type": "text", "content": "Where does the primary vitality of a living language occur, according to author Indiran?", "media_id": null}], "options": {"A": "In dictionary pages", "B": "In ancient stone inscriptions", "C": "In the everyday spoken discourse of common people", "D": "In official government gazettes"}, "explanation": "A language's true pulse and evolutionary freshness dwell in the daily living speech of human speakers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 