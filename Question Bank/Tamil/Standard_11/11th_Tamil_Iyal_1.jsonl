{"id": "11th_tamil_u1_q136", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "supplementary_aaraam_thinai", "chapter_id": null, "topic_id": "sinhala_friend_role", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "1958 கலவரத்தில் கொழும்பு இரயில் நிலையத்தில் ஆசிரியர் அ. முத்துலிங்கத்தைக் காப்பாற்றிய நண்பர் எந்த இனத்தைச் சேர்ந்தவர்?", "media_id": null}], "options": {"A": "ஆங்கிலேயர்", "B": "போர்ச்சுகீசியர்", "C": "மலாய்க்காரர்", "D": "சிங்கள நண்பர்"}, "explanation": "இனவெறி வெறிச்சோடிய அந்த இரயில் நிலையத்தில் சக மனிதநேயமிக்க ஒரு சிங்கள நண்பரே ஆசிரியரைத் தன் வீட்டில் மறைத்து வைத்துக் காப்பாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "During the violent 1958 riots, which community did the compassionate friend who sheltered and saved author A. Muthulingam at Colombo station belong to?", "media_id": null}], "options": {"A": "British", "B": "Portuguese", "C": "Malay", "D": "Sinhalese friend"}, "explanation": "A compassionate Sinhalese friend courageously sheltered him, exemplifying human compassion above hatred."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 11, "chapter": null