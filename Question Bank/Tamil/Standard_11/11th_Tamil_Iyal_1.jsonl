{"id": "11th_tamil_u1_q049", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "eelam_writers_contemporary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சு. வில்வரத்தினத்தோடு சமகாலத்தில் இயங்கிய மற்றொரு தலைசிறந்த ஈழத்து நவீனக் கவிஞர் யார்?", "media_id": null}], "options": {"A": "சேரன் (Cheran)", "B": "கண்ணதாசன்", "C": "வாலி", "D": "வைரமுத்து"}, "explanation": "சேரன், வ. ஐ. ச. ஜெயபாலன், சு. வில்வரத்தினம் ஆகியோர் ஈழத்துப் போர்க்கால நவீனக் கவிதைக் களத்தின் முன்னோடிச் சிற்பிகள்."}, "en": {"blocks": [{"type": "text", "content": "Who among the following was a renowned contemporary Eelam modern poet alongside Su. Vilvarathinam?", "media_id": null}], "options": {"A": "Cheran", "B": "Kannadasan", "C": "Vaali", "D": "Vairamuthu"}, "explanation": "Poet Cheran along with Vilvarathinam shaped the vibrant modern anti-war poetic movement of Eelam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null, "source_notes": null}, "previous_year": {"is_previous_ye