{"id": "11th_tamil_u1_q088", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "teacher_simile_malar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மங்கலப் பொருளாகி, காண்போர் மகிழுமாறு முகம் மலர்ந்து மென்மையாக இன்சொல்லுடன் கற்பிப்பவர்’ - நன்னூலின் இவ்வணி எதனைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "மலை", "B": "நிலம்", "C": "நிறைகோல்", "D": "மலர்"}, "explanation": "மலர் போன்ற மென்மையான இன்சொல்லும், முகம் மலர்ந்த கனிவும் கொண்டவரே மலருக்கு ஒப்பான நல்லாசிரியர்."}, "en": {"blocks": [{"type": "text", "content": "In Nannool, which metaphor characterizes a teacher whose face radiates joyful warmth and who teaches with tender, auspicious sweetness?", "media_id": null}], "options": {"A": "Mountain", "B": "Earth", "C": "Scale", "D": "Flower (Malar)"}, "explanation": "A flower blooms auspiciously delighting beholders; an inspiring teacher imparts knowledge with gracious warmth."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 8, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 8", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Grammar", "Teacher Similes"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q089", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "bad_teacher_four", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நன்னூலில் ஆசிரியராகாதார் (கடையாசிரியர்) ஆகியோருக்கு உவமையாகக் கூறப்பட்டுள்ள நான்கு பொருள்கள் எவை?", "media_id": null}], "options": {"A": "மொழிக்குடம், மடற்பனை, பருத்திக்குண்டிகை, முடத்தெங்கு", "B": "பாம்பு, தேள், காகம், நரி", "C": "எருமை, ஆடு, பன்னாடை, இல்லிக்குடம்", "D": "கல்லு, முள்ளு, கள்ளி, புதர்"}, "explanation": "ஆசிரியராகாதார் நால்வர்க்குரிய உவமைகள்: 1. மொழிக்குடம் (மழைக்குடம்), 2. மடற்பனை, 3. பருத்திக்குண்டிகை (பருத்திகோல்), 4. முடத்தெங்கு."}, "en": {"blocks": [{"type": "text", "content": "Which four flawed objects are invoked in Nannool as similes for incompetent/unworthy teachers (Kadaiyasiriyar)?", "media_id": null}], "options": {"A": "Mozhikkudam (Inverted pot), Madarpannai (Palmyra), Paruthikkundigai (Cotton spindle), Mudaththengu (Crooked coconut tree)", "B": "Snake, Scorpion, Crow, Fox", "C": "Buffalo, Goat, Sieve, Leaky pot", "D": "Stone, Thorn, Cactus, Bush"}, "explanation": "Inverted jar, thorny palmyra, cotton spindle, and crooked coconut palm typify unqualified instructors."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 8, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 8", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Grammar", "Unworthy Teachers"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q090", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "simile_mudaththengu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தன்னை வளர்த்தவருக்கு நேராகப் பயன் தராமல், தன் தலையில் ஏறிப் பறிப்பவருக்கு மட்டுமே காய்களைத் தரும் மரம்’ என்ற உவமை யாரைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "நல்லாசிரியர்", "B": "முடத்தெங்கு போன்ற கடையாசிரியர்", "C": "முதன்மாணாக்கர்", "D": "கடைமாணாக்கர்"}, "explanation": "முடத்தெங்கு (வளைந்த தென்னை) நீர் ஊற்றிப் பாதுகாத்தவர்க்குப் பயன்படாமல் அடுத்தவர் வீட்டுப் பகுதியில் காய்ப்பது போல, எளிய மாணவருக்கு உதவாமல் சிரமப்படுத்துவோரைக் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "Which simile describes a teacher who benefits only those who go through severe physical travail, yielding nothing to the devoted caretaker like a crooked palm leaning into a neighbor yard?", "media_id": null}], "options": {"A": "Exemplary teacher", "B": "Mudaththengu (Crooked coconut palm instructor)", "C": "First-rank student", "D": "Third-rank student"}, "explanation": "'Mudaththengu' signifies an unhelpful teacher who yields knowledge only through painful hardship."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "pub