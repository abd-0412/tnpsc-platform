{"id": "11th_tamil_u1_q114", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "supplementary_aaraam_thinai", "chapter_id": null, "topic_id": "tamil_nadu_award_1996", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அ. முத்துலிங்கத்தின் எந்தச் சிறுகதைத் தொகுதிக்கு 1996-ஆம் ஆண்டின் தமிழ்நாடு அரசு விருது வழங்கப்பட்டது?", "media_id": null}], "options": {"A": "அக்கா", "B": "வம்சவிருத்தி", "C": "வடக்கு வீதி", "D": "திகடசக்கரம்"}, "explanation": "அ. முத்துலிங்கம் எழுதிய 'வம்சவிருத்தி' என்னும் சிறுகதைத் தொகுதி 1996-ல் தமிழ்நாடு அரசின் சிறந்த சிறுகதைக்கான விருதைப் பெற்றது."}, "en": {"blocks": [{"type": "text", "content": "For which short story collection did A. Muthulingam receive the Government of Tamil Nadu Award in 1996?", "media_id": null}], "options": {"A": "Akka", "B": "Vamsaviruththi", "C": "Vadakku Veethi", "D": "Thigadasakkaram"}, "explanation": "His acclaimed anthology 'Vamsaviruththi' won the Government of Tamil Nadu Best Book Award in 1996."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 10, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 10", "url": null, "