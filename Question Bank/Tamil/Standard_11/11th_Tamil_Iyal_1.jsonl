{"id": "11th_tamil_u1_q053", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "genre_yugam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘யுகத்தின் பாடல்’ எந்தக் கவிதை வகையைச் சார்ந்தது?", "media_id": null}], "options": {"A": "புதுக்கவிதை (Modern Free Verse)", "B": "வெண்பா", "C": "கலிப்பா", "D": "வஞ்சிப்பா"}, "explanation": "சு. வில்வரத்தினத்தின் யுகத்தின் பாடல் மரபு யாப்புக் கட்டுப்பாடின்றி தாள லயத்தோடு அமைந்த நவீனப் புதுக்கவிதையாகும்."}, "en": {"blocks": [{"type": "text", "content": "To which poetic genre does 'Yugathin Paadal' belong?", "media_id": null}], "options": {"A": "Puthukkavithai (Modern Free Verse)", "B": "Venba", "C": "Kalippa", "D": "Vanjippa"}, "explanation": "'Yugathin Paadal' is a modern free verse poem marked by internal lyrical rhythm."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session