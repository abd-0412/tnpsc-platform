{"id": "11th_tamil_u8_q148", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "grammar_proofreading_symbols", "chapter_id": null, "topic_id": "stet_symbol_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மெய்ப்புத் திருத்தத்தில் தவறுதலாகத் திருத்தப்பட்ட ஒரு சொல் திருத்தம் தேவையின்றி 'ஏற்கனவே உள்ளவாறே இருக்கட்டும்' (Let it stand) என்பதைக் குறிக்கும் இலத்தீன் சொல் குறியீடு எது?", "media_id": null}], "options": {"A": "tr", "B": "lc", "C": "bf", "D": "stet (சொல்லின் கீழே புள்ளிகள் இடப்படும்)"}, "explanation": "'stet' என்பது இலத்தீன் சொல்லாகும்; இதற்கு 'அப்படியே இருக்கட்டும்' என்பது பொருள். திருத்தப்பட்ட சொல்லின் கீழே புள்ளிகள் இட்டு ஓரத்தில் 'stet' என எழுதுவர்."}, "en": {"blocks": [{"type": "text", "content": "Which Latin proofreading term accompanied by dots beneath characters instructs the printer to 'Let it stand' (cancel previous correction)?", "media_id": null}], "options": {"A": "tr", "B": "lc", "C": "bf", "D": "stet"}, "explanation": "'Stet' (Latin for let it stand) directs compositors to disregard a mistakenly marked deletion."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 1