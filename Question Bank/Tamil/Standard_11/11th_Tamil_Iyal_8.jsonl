{"id": "11th_tamil_u8_q075", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "jeevakan_fort_city", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாடகத்தில் ஜீவக மன்னனின் கோட்டை அமைந்திருந்த வரலாற்றுச் சிறப்புமிக்க நதிக்கரை நகரம் எது?", "media_id": null}], "options": {"A": "காவிரிப்பூம்பட்டினம்", "B": "மதுரை (வைகைக் கரை)", "C": "திருநெல்வேலி (தாமிரபரணிக் கரை)", "D": "தஞ்சாவூர்"}, "explanation": "மனோன்மணீயம் நாடகத்தில் பாண்டிய நாட்டின் தலைநகராகவும், போர்க்களக் கோட்டையாகவும் விளங்குவது தாமிரபரணி ஆற்றங்கரையில் அமைந்த 'திருநெல்வேலி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "On the banks of which river is King Jeevakan fortified capital city situated in the drama Manonmaniyam?", "media_id": null}], "options": {"A": "Kaveripoompattinam", "B": "Madurai (Vaigai)", "C": "Tirunelveli (Thamirabarani river)", "D": "Thanjavur"}, "explanation": "The primary citadel of King Jeevakan is situated in Tirunelveli on the Thamirabarani."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 180, "chapter": null, "section": null, "reference":