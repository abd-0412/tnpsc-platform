{"id": "11th_tamil_u8_q157", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "grammar_proofreading_symbols", "chapter_id": null, "topic_id": "tamil_santhi_correction", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் மெய்ப்புத் திருத்தத்தில் முதன்மையாகக் கவனிக்கப்பட வேண்டிய சந்திப் பிழைகள் (Orthographic errors) எவை?", "media_id": null}], "options": {"A": "வல்லினம் மிக வேண்டிய இடத்தில் மிகாமல் இருத்தலும், மிகக் கூடாத இடத்தில் மிகுந்து வருதலும் (க், ச், த், ப்)", "B": "எண்களைத் தவறாக எழுதுவது", "C": "படங்களை மாற்றி அமைப்பது", "D": "பக்க எண்களை மாற்றுவது"}, "explanation": "தமிழில் 'க, ச, த, ப' ஆகிய வல்லெழுத்துகள் மிக வேண்டிய மற்றும் மிகக் கூடாத இடங்களைச் சரியாகத் திருத்துவதே மெய்ப்புத் திருத்துநரின் மிக இன்றியமையாத பணியாகும்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the primary phonetic/grammatical correction in Tamil proofreading regarding sandhi rules?", "media_id": null}], "options": {"A": "Correcting erroneous presence or omission of hard plosives (k, ch, th, p) under Vallinam sandhi rules", "B": "Correcting numeral digits", "C": "Realigning photographs", "D": "Changing page numbering"}, "explanation": "Rigorous checking of Vallinam sandhi doubling (k, ch, th, p) is central to Tamil proofreading."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"typ