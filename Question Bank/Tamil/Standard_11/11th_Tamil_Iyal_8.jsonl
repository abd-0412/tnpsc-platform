{"id": "11th_tamil_u8_q193", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "pyq_unit8", "chapter_id": null, "topic_id": "pyq_narthaki_transgender_welfare_board", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] இந்தியாவில் முதன்முதலில் திருநங்கைகளுக்கெனத் தனி 'திருநங்கையர் நல வாரியம்' (Transgender Welfare Board) அமைத்த பெருமைக்குரிய மாநிலம் எது?", "media_id": null}], "options": {"A": "தமிழ்நாடு (2008-ஆம் ஆண்டு)", "B": "கேரளா", "C": "மகாராஷ்டிரா", "D": "கர்நாடகா"}, "explanation": "2008-ல் தமிழ்நாடு அரசு இந்தியாவில் முதன்முறையாகத் திருநங்கையர் நல வாரியத்தை அமைத்து வரலாற்றுச் சாதனை படைத்தது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Which Indian state holds the trailblazing historic honor of establishing the first Transgender Welfare Board in 2008?", "media_id": null}], "options": {"A": "Tamil Nadu (in 2008)", "B": "Kerala", "C": "Maharashtra", "D": "Karnataka"}, "explanation": "Tamil Nadu pioneered the first Transgender Persons Welfare Board in India in 2008."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 190, "chapter": null, "section": null, "r