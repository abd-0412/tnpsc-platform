{"id": "11th_tamil_u8_q188", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "pyq_unit8", "chapter_id": null, "topic_id": "pyq_tagore_visva_bharati_central_univ", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] சுதந்திரத்திற்குப் பின் தாகூரின் 'விஸ்வபாரதி' நிறுவனம் இந்திய அரசால் எந்த ஆண்டு மத்தியப் பல்கலைக்கழகமாக (Central University) அறிவிக்கப்பட்டது?", "media_id": null}], "options": {"A": "1947", "B": "1950", "C": "1948", "D": "1951"}, "explanation": "1951-ஆம் ஆண்டு நாடாளுமன்றச் சட்டத்தின் மூலம் விஸ்வபாரதி ஒரு மத்தியப் பல்கலைக்கழகமாகவும் தேசிய முக்கியத்துவம் வாய்ந்த நிறுவனமாகவும் அறிவிக்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] In which year was Tagore's Visva-Bharati declared an Institution of National Importance and Central University by Parliament?", "media_id": null}], "options": {"A": "1947", "B": "1950", "C": "1948", "D": "1951"}, "explanation": "Parliament enacted legislation in 1951 designating Visva-Bharati a Central University."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 178, "chapter": null, "section": null, "reference"