{"id": "11th_tamil_u8_q153", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "grammar_proofreading_symbols", "chapter_id": null, "topic_id": "proofreading_matching_symbols", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மெய்ப்புத் திருத்தக் குறியீடுகளையும் அவற்றின் பொருளையும் பொருத்துக:\n(அ) ₰ (d) - 1. விடுபட்டதைச் சேர்க்க\n(ஆ) ^ - 2. நீக்குக\n(இ) # - 3. இடைவெளி விடுக\n(ஈ) tr - 4. இடம் மாற்றுக", "media_id": null}], "options": {"A": "அ-2, ஆ-1, இ-3, ஈ-4", "B": "அ-1, ஆ-2, இ-4, ஈ-3", "C": "அ-3, ஆ-4, இ-1, ஈ-2", "D": "அ-4, ஆ-3, இ-2, ஈ-1"}, "explanation": "₰ = நீக்குக; ^ = விடுபட்டதைச் சேர்க்க; # = இடைவெளி விடுக; tr = இடம் மாற்றுக என்பதே சரியான பொருத்தமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Match the proofreading marks with their functions:\n(a) ₰ (d) - 1. Insert missing element\n(b) ^ - 2. Delete\n(c) # - 3. Insert space\n(d) tr - 4. Transpose", "media_id": null}], "options": {"A": "a-2, b-1, c-3, d-4", "B": "a-1, b-2, c-4, d-3", "C": "a-3, b-4, c-1, d-2", "D": "a-4, b-3, c-2, d-1"}, "explanation": "Dele (2), Caret (1), Hash (3), Transpose (4)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition"