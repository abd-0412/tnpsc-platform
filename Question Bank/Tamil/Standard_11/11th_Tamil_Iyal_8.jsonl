{"id": "11th_tamil_u8_q122", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "supplementary_narthaki_nataraj", "chapter_id": null, "topic_id": "companion_shakthi_bhaskar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நர்த்தகி நடராஜின் கலைப்பயணத்திலும் வாழ்க்கைப் போராட்டத்திலும் இளமைக்காலம் முதல் உற்ற தோழியாகவும் நாட்டியத் துணையாகவும் உடன்நிற்கும் கலைஞர் யார்?", "media_id": null}], "options": {"A": "மாலதி", "B": "சக்தி பாஸ்கர்", "C": "சுந்தரி", "D": "மீனாட்சி"}, "explanation": "நர்த்தகி நடராஜின் குழந்தைப் பருவத் தோழியான சக்தி பாஸ்கர், அவரோடு இணைந்தே நாட்டியம் பயின்று, அவரது கலை முயற்சிகளுக்கு உற்ற பலமாக இருந்து வருகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Who has been Narthaki Nataraj's lifelong artistic partner, confidante, and co-performer through decades of social adversity?", "media_id": null}], "options": {"A": "Malathi", "B": "Shakthi Bhaskar", "C": "Sundari", "D": "Meenakshi"}, "explanation": "Shakthi Bhaskar has been her steadfast lifelong companion, artistic collaborator, and co-dancer."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 188, "chapter": null, "sect