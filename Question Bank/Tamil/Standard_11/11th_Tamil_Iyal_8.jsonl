{"id": "11th_tamil_u8_q173", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "pyq_unit8", "chapter_id": null, "topic_id": "pyq_tamil_thai_adoption_1970", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] பேராசிரியர் சுந்தரனாரின் மனோன்மணீயம் பாயிரப் பாடலான 'நீராருங் கடலுடுத்த...' பாடல் தமிழக அரசால் அதிகாரப்பூர்வத் 'தமிழ்த்தாய் வாழ்த்தாக' எந்த ஆண்டு அறிவிக்கப்பட்டது?", "media_id": null}], "options": {"A": "1970 (முத்தமிழறிஞர் கலைஞர் மு. கருணாநிதி முதல்வராக இருந்தபோது)", "B": "1967", "C": "1950", "D": "1980"}, "explanation": "1970-ஆம் ஆண்டு அப்போதைய தமிழக முதல்வர் மு. கருணாநிதி தலைமையிலான அரசால் மனோன்மணீயம் சுந்தரனாரின் பாடல் தமிழ்த்தாய் வாழ்த்தாக முறைப்படி அறிவிக்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] In which year was Prof. Sundaranar's verse 'Neeraarum Kadaludutha' officially decreed as the Tamil Nadu State Anthem?", "media_id": null}], "options": {"A": "1970 (under Chief Minister M. Karunanidhi)", "B": "1967", "C": "1950", "D": "1980"}, "explanation": "The Government of Tamil Nadu decreed Neeraarum Kadaludutha as the state anthem in 1970."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11",