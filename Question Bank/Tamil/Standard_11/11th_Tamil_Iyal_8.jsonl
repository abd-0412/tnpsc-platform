{"id": "11th_tamil_u8_q066", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "vaani_character_significance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மனோன்மணீயத்தில் வரும் தோழி வாணி எத்தகைய குணநலன்களைக் கொண்ட பாத்திரமாகச் சித்திரிக்கப்படுகிறாள்?", "media_id": null}], "options": {"A": "அச்சமும் மடமையும் கொண்டவள்", "B": "கூர்மையான அறிவுநுட்பமும், மனோன்மனியின் காதலைப் புரிந்து காக்கும் ஆருயிர் நட்பும், துணிவும் உடையவள்", "C": "குடிலனோடு கூட்டுச் சேருபவள்", "D": "அரண்மனையை விட்டு ஓடுபவள்"}, "explanation": "வாணி வெறும் பணிப்பெண் அல்லள்; மனோன்மனியின் உற்ற தோழியாகவும், கூரிய அறிவும் சமயோசிதப் புத்தியும் கொண்ட பெண்மையின் அடையாளமாகவும் விளங்குகிறாள்."}, "en": {"blocks": [{"type": "text", "content": "How is confidante Vaani portrayed within the dramatic framework of Manonmaniyam?", "media_id": null}], "options": {"A": "Timid and superstitious", "B": "Endowed with acute wit, fearless resourcefulness, and deep devotion to Princess Manonmani", "C": "Colluding with Kudilan", "D": "Fleeing the palace"}, "explanation": "Vaani embodies razor-sharp intellect, fearless loyalty, and psychological sagacity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Te