{"id": "11th_tamil_u8_q105", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_inkulab", "chapter_id": null, "topic_id": "inkulab_awards_returned", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஈழத் தமிழர் படுகொலையைக் கண்டித்து, தமிழ்நாடு அரசு தமக்கு வழங்கிய எந்த விருதை இன்குலாப் திருப்பி அளித்தார்?", "media_id": null}], "options": {"A": "கலைமாமணி விருது", "B": "பாரதிதாசன் விருது", "C": "திருவள்ளுவர் விருது", "D": "பாவேந்தர் விருது"}, "explanation": "ஈழத்தில் அப்பாவித் தமிழர்கள் படுகொலை செய்யப்பட்ட நிகழ்விற்கு எதிர்ப்பு தெரிவித்து, தமக்கு வழங்கப்பட்ட தமிழக அரசின் 'கலைமாமணி' விருதைத் திருப்பி ஒப்படைத்தார்."}, "en": {"blocks": [{"type": "text", "content": "Protesting against atrocities on Eelam Tamils, which state award did Inquilab courageously return to the Government of Tamil Nadu?", "media_id": null}], "options": {"A": "Kalaimamani Award", "B": "Bharathidasan Award", "C": "Thiruvalluvar Award", "D": "Pavendhar Award"}, "explanation": "Inquilab returned the prestigious Kalaimamani award in protest against injustices against Eelam Tamils."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025