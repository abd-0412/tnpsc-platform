{"id": "11th_tamil_u8_q171", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "glossary_unit8", "chapter_id": null, "topic_id": "humanism_tamil", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல் 8-ன் மையத் தலைப்பான 'Humanism' என்னும் ஆங்கிலக் கலைச்சொல்லின் தமிழாக்கம் யாது?", "media_id": null}], "options": {"A": "மனித உடல்", "B": "மனித இனம்", "C": "மனிதநேயம்", "D": "மனித உரிமை"}, "explanation": "'Humanism' என்பதன் சரியான கலைச்சொல் 'மனிதநேயம்' என்பதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the precise Tamil equivalent for the core theme 'Humanism' in Unit 8 glossary?", "media_id": null}], "options": {"A": "Human body", "B": "Human species", "C": "Humanism (Manithanheyam)", "D": "Human rights"}, "explanation": "'Humanism' translates directly as 'Manithanheyam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 198, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 198", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_m