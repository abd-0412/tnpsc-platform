{"id": "11th_tamil_u8_q027", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "prose_tagore_letters", "chapter_id": null, "topic_id": "tagore_shantiniketan_location", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சாந்திநிகேதன் அமைந்துள்ள மாநிலம் எது?", "media_id": null}], "options": {"A": "பீகார்", "B": "ஒடிசா", "C": "மேற்கு வங்காளம் (பொள்ளாப்பூர் அருகே)", "D": "அசாம்"}, "explanation": "சாந்திநிகேதன் மேற்கு வங்காள மாநிலத்தில் பிர்பூம் மாவட்டத்தில் போல்பூர் (Bolpur) அருகே அமைந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "In which state of India is Tagore's Shantiniketan situated?", "media_id": null}], "options": {"A": "Bihar", "B": "Odisha", "C": "West Bengal (near Bolpur, Birbhum district)", "D": "Assam"}, "explanation": "Shantiniketan is located near Bolpur in West Bengal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 178, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 178", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"