{"id": "11th_tamil_u8_q127", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "supplementary_narthaki_nataraj", "chapter_id": null, "topic_id": "thevaram_thiruvasagam_abhinaya", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நர்த்தகி நடராஜ் தம் நாட்டிய நிகழ்ச்சிகளில் தமிழ் செவ்வியல் இலக்கியங்களிலிருந்து சிறப்பாக அபிநயம் பிடித்து ஆடும் பகுதிகள் எவை?", "media_id": null}], "options": {"A": "நவீன ஆங்கிலக் கவிதைகள்", "B": "திரைப்படக் குத்துப் பாடல்கள்", "C": "தேவாரம், திருவாசகம், நாலாயிர திவ்வியப் பிரபந்தம், திருப்புகழ் ஆகிய பக்தி இலக்கியப் பாடல்கள்", "D": "வடமொழி சுலோகங்கள் மட்டுமே"}, "explanation": "நர்த்தகி நடராஜ் தமிழ் செவ்வியல் பக்திப் பாடல்களான தேவாரம், திருவாசகம், ஆழ்வார் பாசுரங்கள் ஆகியவற்றுக்குத் தம்முடைய அபாரமான பாவ-அபிநயங்களால் உயிர் ஊட்டுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Which classical Tamil literary corpus forms the sublime thematic bedrock of Narthaki Nataraj's expressive Abhinaya recitals?", "media_id": null}], "options": {"A": "Modern English free verse", "B": "Cinema pop tracks", "C": "Thevaram, Thiruvasagam, Nalayira Divya Prabandham, and Thiruppugazh hymns", "D": "Sanskrit recitations exclusively"}, "explanation": "She breathes transcendent life into Thevaram, Thiruvasagam, and Divya Prabandham through Thanjavur abhinaya."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answ