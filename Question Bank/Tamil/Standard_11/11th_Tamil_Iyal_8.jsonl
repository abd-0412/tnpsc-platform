{"id": "11th_tamil_u8_q159", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "grammar_proofreading_symbols", "chapter_id": null, "topic_id": "proofreading_pen_ink", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மெய்ப்புத் திருத்துநர்கள் அச்சுப்படியில் திருத்தங்களைச் செய்வதற்குப் பொதுவாக எவ்வண்ண மையினைப் (Ink) பயன்படுத்துகின்றனர்?", "media_id": null}], "options": {"A": "கருப்பு மை", "B": "மஞ்சள் மை", "C": "சிவப்பு மை (அல்லது நீல மை - அச்சுக்குத் தெளிவாகத் தெரியும் வண்ணம்)", "D": "வெள்ளை மை"}, "explanation": "கருப்பு அச்சு எழுத்துகளுக்கு இடையே திருத்தங்கள் பளிச்செனத் தெரிய வேண்டும் என்பதற்காக மரபாகச் 'சிவப்பு மை' அல்லது பளிச்சான வண்ண மைகள் பயன்படுத்தப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Which ink color is traditionally utilized by proofreaders to ensure corrections stand out vividly against black type?", "media_id": null}], "options": {"A": "Black ink", "B": "Yellow ink", "C": "Red ink (or contrasting bright ink)", "D": "White ink"}, "explanation": "Red ink is universally preferred by proofreaders for stark visual contrast against black galley text."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_