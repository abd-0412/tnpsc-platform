{"id": "11th_tamil_u8_q151", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "grammar_proofreading_symbols", "chapter_id": null, "topic_id": "font_style_abbreviations", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆங்கில மற்றும் பொது அச்சுக்குறியீடுகளில் 'தடித்த எழுத்து' (Bold face) மற்றும் 'சாய்வு எழுத்து' (Italics) ஆகியவற்றைக் குறிக்கும் சுருக்கக் குறியீடுகள் எவை?", "media_id": null}], "options": {"A": "caps, lc", "B": "rom, sm caps", "C": "bf (Bold face) மற்றும் ital (Italics)", "D": "tr, dele"}, "explanation": "'bf' என்பது Bold face (தடித்த எழுத்து) என்பதையும், 'ital' என்பது Italics (சாய்வு எழுத்து) என்பதையும் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "Which standard typographical abbreviations denote 'Bold Face' and 'Italics' respectively?", "media_id": null}], "options": {"A": "caps, lc", "B": "rom, sm caps", "C": "bf (Bold face) and ital (Italics)", "D": "tr, dele"}, "explanation": "'bf' stands for boldface, while 'ital' designates italic font style."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 194, "chapter": null, "section": null, "reference": "11th Tami