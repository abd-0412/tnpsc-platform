{"id": "11th_tamil_u8_q018", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "prose_tagore_letters", "chapter_id": null, "topic_id": "tagore_gitanjali_english_intro", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாகூரின் 'கீதாஞ்சலி' நூலை ஆங்கிலத்தில் மொழிபெயர்த்த போது, அதற்குப் புகழ்பெற்ற முன்னுரையை (Introduction) எழுதிய ஐரிஷ் கவிஞர் யார்?", "media_id": null}], "options": {"A": "டி. எஸ். எலியட்", "B": "டபிள்யூ. பி. யேட்ஸ் (W. B. Yeats)", "C": "வில்லியம் வேர்ட்ஸ்வர்த்", "D": "ஜான் கீட்ஸ்"}, "explanation": "கீதாஞ்சலியின் ஆங்கில மொழிபெயர்ப்பைப் படித்து மெய்சிலிர்த்த உலகப் புகழ்பெற்ற கவிஞர் டபிள்யூ. பி. யேட்ஸ் அதற்கு உணர்ச்சிபூர்வமான முன்னுரை எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "Which celebrated Irish poet penned the moving introduction to Tagore's English translation of Gitanjali?", "media_id": null}], "options": {"A": "T. S. Eliot", "B": "W. B. Yeats", "C": "William Wordsworth", "D": "John Keats"}, "explanation": "W. B. Yeats wrote the profound introductory essay for the English edition of Gitanjali."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 178, "chapt