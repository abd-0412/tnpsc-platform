{"id": "11th_tamil_u8_q097", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_muthukumar", "chapter_id": null, "topic_id": "muthukumar_lifespan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மிக இளவயதிலேயே (41 வயதில்) மறைந்து தமிழ் இலக்கிய உலகையும் திரை உலகையும் மீளாத் துயரில் ஆழ்த்திய நா. முத்துக்குமாரின் வாழ்வுக் காலம் எது?", "media_id": null}], "options": {"A": "1975 - 2016", "B": "1965 - 2005", "C": "1980 - 2020", "D": "1970 - 2010"}, "explanation": "நா. முத்துக்குமார் 1975 ஜூலை 12-ல் பிறந்து, 2016 ஆகஸ்ட் 10-ல் தம்முடைய 41-ஆம் வயதில் அகால மரணமடைந்தார்."}, "en": {"blocks": [{"type": "text", "content": "What was the tragic lifespan of Na. Muthukumar who passed away prematurely at the age of 41?", "media_id": null}], "options": {"A": "1975 - 2016", "B": "1965 - 2005", "C": "1980 - 2020", "D": "1970 - 2010"}, "explanation": "Na. Muthukumar lived from 12 July 1975 until 10 August 2016."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 186, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 186", "url": null, "source_notes": null}, "previous_year": {"is_pr