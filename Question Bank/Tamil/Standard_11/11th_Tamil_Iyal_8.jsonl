{"id": "11th_tamil_u8_q155", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "grammar_proofreading_symbols", "chapter_id": null, "topic_id": "out_see_copy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அச்சுப்படியில் ஒரு முழு வாக்கியமோ அல்லது பத்தியோ விடுபட்டிருந்தால், மூலப்படியைப் பார்த்துச் சேர்க்குமாறு குறிக்கும் ஆங்கிலக் குறிப்பு யாது?", "media_id": null}], "options": {"A": "dele", "B": "stet", "C": "Out, see copy (விடுபட்டது, மூலப்படியைப் பார்க்க)", "D": "lc"}, "explanation": "அதிகமான வரிகள் விடுபட்டிருக்கும் போது 'Out, see copy' என்று எழுதி மூலப்படியில் உள்ளதை அச்சுக் கோர்க்குமாறு வழிகாட்டுவர்."}, "en": {"blocks": [{"type": "text", "content": "What standardized directive indicates that substantial text was omitted and must be restored from the original authorial manuscript?", "media_id": null}], "options": {"A": "dele", "B": "stet", "C": "Out, see copy", "D": "lc"}, "explanation": "'Out, see copy' signals large text omissions to be restored directly from source copy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 194, "chapter": null, "section": null, "reference": "11th Tam