{"id": "11th_tamil_u8_q180", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "pyq_unit8", "chapter_id": null, "topic_id": "pyq_sundaranar_lytton_secret_way", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] பேராசிரியர் சுந்தரனாரின் மனோன்மணீயம் எட்வர்ட் புல்வர் லிட்டன் எழுதிய 'The Secret Way' தழுவல். அந்நூல் லிட்டன் பிரபுவின் எந்தக் கவிதைத் தொகுப்பில் இடம்பெற்றிருந்தது?", "media_id": null}], "options": {"A": "Songs of Innocence", "B": "Lays of Ancient Rome", "C": "Leaves of Grass", "D": "தி லாஸ்ட் டேல்ஸ் ஆஃப் மிலேட்டஸ் (The Lost Tales of Miletus - 1866)"}, "explanation": "லிட்டன் பிரபு 1866-ல் வெளியிட்ட 'The Lost Tales of Miletus' என்னும் கதைப் பாடல் தொகுப்பில் உள்ள 'The Secret Way' என்னும் கவிதையே மனோன்மணீயத்திற்கு மூலக்கருவாகும்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] In which 1866 poetic anthology of Lord Lytton was the original narrative 'The Secret Way' published?", "media_id": null}], "options": {"A": "Songs of Innocence", "B": "Lays of Ancient Rome", "C": "Leaves of Grass", "D": "The Lost Tales of Miletus (1866)"}, "explanation": "'The Secret Way' appeared in Lord Lytton's 1866 collection The Lost Tales of Miletus."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tami