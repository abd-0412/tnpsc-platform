{"id": "11th_tamil_u8_q099", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_inkulab", "chapter_id": null, "topic_id": "inkulab_revolutionary_quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இன்குலாப்பின் கவிதைகளில் காணப்படும் பொதுவான பாடுபொருள் (Theme) எது?", "media_id": null}], "options": {"A": "மன்னர்களின் வீரம் மட்டுமே", "B": "செல்வந்தர்களின் புகழ் பாடுதல்", "C": "ஒடுக்கப்பட்ட மக்களின் உரிமைப் போராட்டம், சாதி ஒழிப்பு, சுற்றுச்சூழல் நேயம், புரட்சிகர விடுதலை வேட்கை", "D": "மதச் சடங்குகளின் பெருமை"}, "explanation": "இன்குலாப் தம் வாழ்நாள் முழுவதும் ஒடுக்கப்பட்ட தலித், தொழிலாளர், விவசாயிகள் மற்றும் பெண்களின் உரிமைக்காகவும் சாதியற்ற சமூகத்திற்காகவும் கவிதைகளை ஆயுதமாக்கினார்."}, "en": {"blocks": [{"type": "text", "content": "What overarching thematic focus defines Inquilab's poetic voice across decades?", "media_id": null}], "options": {"A": "Praising feudal kings exclusively", "B": "Eulogizing wealthy patrons", "C": "Rights of the marginalized, anti-caste struggle, ecological empathy, and revolutionary liberation", "D": "Exalting religious rituals"}, "explanation": "Inquilab wielded poetry as an uncompromising instrument for social justice, anti-caste emancipation, and humanism."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu