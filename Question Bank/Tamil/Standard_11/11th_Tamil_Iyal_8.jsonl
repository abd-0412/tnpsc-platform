{"id": "11th_tamil_u8_q001", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "prose_tagore_letters", "chapter_id": null, "topic_id": "tagore_recipient", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல் 8-ல் பாடமாக இடம்பெற்றுள்ள தாகூரின் கடிதங்கள், அவர் தம்முடைய எந்த உறவினருக்கு எழுதிய கடிதங்களின் தொகுப்பாகும்?", "media_id": null}], "options": {"A": "தம்முடைய உடன்பிறந்தாரின் மகளான இந்திரா தேவிக்கு", "B": "தம்முடைய மனைவியான மிருணாளினி தேவிக்கு", "C": "காந்தியடிகளுக்கு", "D": "நேதாஜி சுபாஷ் சந்திர போஸுக்கு"}, "explanation": "இரவீந்திரநாத் தாகூர் தம்முடைய அண்ணன் மகளான இந்திரா தேவிக்கு எழுதிய கடிதங்களே இங்குப் பாடப்பகுதியாகத் தொகுக்கப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "To which relative were Rabindranath Tagore's letters featured in Unit 8 addressed?", "media_id": null}], "options": {"A": "To Indira Devi, his elder brother daughter (niece)", "B": "To his wife Mrinalini Devi", "C": "To Mahatma Gandhi", "D": "To Netaji Subhash Chandra Bose"}, "explanation": "Tagore penned these introspective literary missives to his niece, Indira Devi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2