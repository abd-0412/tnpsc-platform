{"id": "11th_tamil_u8_q133", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "supplementary_narthaki_nataraj", "chapter_id": null, "topic_id": "guru_bhakti_narthaki", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நர்த்தகி நடராஜ் தம் நேர்காணலில் தம்முடைய வெற்றிக்கு முழுமுதற் காரணமாக யாரைக் குறிப்பிடுகிறார்?", "media_id": null}], "options": {"A": "தம் குருநாதர் தஞ்சை கிட்டப்பா பிள்ளையின் ஆசியையும் அவரது கடுமையான பயிற்சியையும்", "B": "விளம்பரங்களை", "C": "பண பலத்தை", "D": "அரசியல் செல்வாக்கை"}, "explanation": "நர்த்தகி நடராஜ் எந்த மேடையிலும் தம்முடைய ஆசான் தஞ்சை கிட்டப்பா பிள்ளையின் பெருமதியையும் குருபக்தியையும் முதன்மையாகப் போற்றுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "To whom does Narthaki Nataraj attribute the supreme foundation of her artistic triumph?", "media_id": null}], "options": {"A": "The blessings, rigorous sadhana, and unsparing training of her Guru Thanjavur Kittappa Pillai", "B": "Media advertisements", "C": "Financial influence", "D": "Political connections"}, "explanation": "She reveres the blessings and rigorous training of her Guru Kittappa Pillai as her greatest asset."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "