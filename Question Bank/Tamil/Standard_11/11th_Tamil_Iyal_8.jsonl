{"id": "11th_tamil_u8_q168", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "grammar_proofreading_symbols", "chapter_id": null, "topic_id": "proofreading_summary_concept", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மெய்ப்புத் திருத்தக் குறியீடுகள் உலகளவில் பொதுமைப்படுத்தப்பட்டு இருப்பதன் முதன்மையான நன்மை யாது?", "media_id": null}], "options": {"A": "அச்சகங்களை மூட உதவுவது", "B": "காகிதச் செலவை அதிகரிப்பது", "C": "ஆசிரியர்களுக்குப் புரியாமல் செய்வது", "D": "மொழி வேறுபாடுகளைக் கடந்து எந்த நாட்டிலும் எந்த மொழியிலும் இயங்கும் அச்சுக் கோர்ப்பாளரும் எளிதில் பிழையைப் புரிந்து திருத்த முடிகிறது"}, "explanation": "சர்வதேச மெய்ப்புத் திருத்தக் குறியீடுகள் பொதுவானவை என்பதால், எந்த மொழி நூலாயினும் அச்சுக் கோர்ப்பாளர் அக்குறியீடுகளைக் கொண்டு துல்லியமாகத் திருத்த முடியும்."}, "en": {"blocks": [{"type": "text", "content": "What is the prime communicative asset of standardizing international proofreading symbols across publishing?", "media_id": null}], "options": {"A": "Closing printing presses", "B": "Inflating paper costs", "C": "Concealing errors from authors", "D": "Enabling typesetters globally to decode and execute corrections unambiguously regardless of language"}, "explanation": "Standardized symbols transcend language barriers, enabling universal compositor comprehension."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allo