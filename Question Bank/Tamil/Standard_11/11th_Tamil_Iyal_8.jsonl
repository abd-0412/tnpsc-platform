{"id": "11th_tamil_u8_q179", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "pyq_unit8", "chapter_id": null, "topic_id": "pyq_proofreading_dele_origin", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] மெய்ப்புத் திருத்தத்தில் பயன்படுத்தப்படும் 'Dele' (₰) என்ற சொல் எந்த மொழியிலிருந்து பெறப்பட்டது?", "media_id": null}], "options": {"A": "கிரேக்கம்", "B": "பிரெஞ்சு", "C": "இலத்தீன் (Latin - delere என்பதன் சுருக்கம்)", "D": "செருமன்"}, "explanation": "'Dele' என்பது இலத்தீன் சொல்லான 'delere' (அழித்தல்/நீக்குதல்) என்பதிலிருந்து உருவான சர்வதேச அச்சுத் திருத்தக் குறியீடாகும்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] From which classical European language is the proofreader's term 'Dele' (₰) derived?", "media_id": null}], "options": {"A": "Greek", "B": "French", "C": "Latin (from delere, to erase/destroy)", "D": "German"}, "explanation": "'Dele' originates from the Latin verb delere."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 193, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 193", "url": null, "source_notes": null}, "pre