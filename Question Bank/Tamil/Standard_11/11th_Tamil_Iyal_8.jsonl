{"id": "11th_tamil_u8_q034", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "character_roles_kings", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மனோன்மணீயத்தில் வரும் பாண்டிய மன்னன் மற்றும் சேர மன்னனின் பெயர்கள் முறையே எவை?", "media_id": null}], "options": {"A": "புருடோத்தமன் மற்றும் ஜீவகன்", "B": "ஜீவகன் (பாண்டிய மன்னன்) மற்றும் புருடோத்தமன் (சேர மன்னன்)", "C": "குடிலன் மற்றும் பலதேவன்", "D": "சுந்தரர் மற்றும் நடராசன்"}, "explanation": "மனோன்மணீயத்தில் திருநெல்வேலியைத் தலைநகராகக் கொண்டு ஆளும் பாண்டிய மன்னன் 'ஜீவகன்'; சேர நாட்டு மன்னன் 'புருடோத்தமன்' ஆவர்."}, "en": {"blocks": [{"type": "text", "content": "What are the names of the Pandya and Chera monarchs depicted in Manonmaniyam respectively?", "media_id": null}], "options": {"A": "Purudothaman and Jeevakan", "B": "Jeevakan (Pandya King) and Purudothaman (Chera King)", "C": "Kudilan and Baladevan", "D": "Sundarar and Natarasan"}, "explanation": "King Jeevakan rules the Pandya kingdom, while Purudothaman rules the Chera country."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page