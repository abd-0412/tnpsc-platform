{"id": "11th_tamil_u8_q163", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "grammar_proofreading_symbols", "chapter_id": null, "topic_id": "line_break_hyphen", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வரியின் இறுதியில் ஒரு சொல் பாதியிலேயே முறிந்து அடுத்த வரிக்குச் செல்லும்போது இடப்பட வேண்டிய குறியீடு எது?", "media_id": null}], "options": {"A": "முற்றுப்புள்ளி", "B": "காற்புள்ளி", "C": "சொல் பிரிப்புக் குறி / இணைப்புக்கோடு (Hyphen / -)", "D": "ஆச்சரியக்குறி"}, "explanation": "சொல் முழுமையடையாமல் அடுத்த வரிக்குத் தொடரும் போது வரியின் இறுதியில் இணைப்புக்கோடு (Hyphen) இடப்பட வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "Which punctuation mark is mandated at the end of a line when a word is hyphenated across lines?", "media_id": null}], "options": {"A": "Full stop", "B": "Comma", "C": "Hyphen / Word break mark ( - )", "D": "Exclamation point"}, "explanation": "A hyphen (-) marks standard line-end syllabic word division."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 193, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 193", "url": null, "so