{"id": "11th_tamil_u8_q129", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "supplementary_narthaki_nataraj", "chapter_id": null, "topic_id": "narthaki_doctorate_degree", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நர்த்தகி நடராஜின் கலைப்பணியைப் பாராட்டி எந்தப் பல்கலைக்கழகம் அவருக்கு மதிப்புறு முனைவர் (Honorary Doctorate) பட்டம் வழங்கிச் சிறப்பித்தது?", "media_id": null}], "options": {"A": "தஞ்சாவூர் தமிழ்ப் பல்கலைக்கழகம் (2016)", "B": "சென்னை பல்கலைக்கழகம்", "C": "மதுரை காமராசர் பல்கலைக்கழகம்", "D": "அண்ணா பல்கலைக்கழகம்"}, "explanation": "2016-ஆம் ஆண்டு தஞ்சாவூர் தமிழ்ப் பல்கலைக்கழகம் நர்த்தகி நடராஜ் அவர்களின் நாட்டியச் சாதனையைப் போற்றி மதிப்புறு முனைவர் பட்டம் வழங்கியது."}, "en": {"blocks": [{"type": "text", "content": "Which esteemed university conferred an Honorary Doctorate upon Narthaki Nataraj in 2016?", "media_id": null}], "options": {"A": "Tamil University, Thanjavur (in 2016)", "B": "University of Madras", "C": "Madurai Kamaraj University", "D": "Anna University"}, "explanation": "Tamil University, Thanjavur awarded her an Honorary Doctorate (D.Litt.) in 2016."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full