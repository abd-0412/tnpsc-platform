{"id": "11th_tamil_u8_q130", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "supplementary_narthaki_nataraj", "chapter_id": null, "topic_id": "humanitarian_dimension_unit8", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நர்த்தகி நடராஜின் வாழ்க்கைப் பதிவு இயல் 8-ன் கருப்பொருளான 'எல்லைகள் நீத்த மனிதநேயம்' என்பதோடு எவ்வாறு பொருந்துகிறது?", "media_id": null}], "options": {"A": "அவர் வெளிநாடுகளில் மட்டும் வாழ்வதால்", "B": "பாலினம், சமூகம் விதித்த குறுகிய எல்லைகளைத் தன் கலைத்திறனாலும் சாதனைகளாலும் உடைத்தெறிந்து உலகளாவிய மனிதநேயத்தை உணர்த்துவதால்", "C": "அரசியலில் தீவிரமாகப் பங்கேற்பதால்", "D": "பணக்காரர்களுக்கு மட்டுமே ஆடுவதால்"}, "explanation": "சமூகம் வகுத்த பாலினப் பாகுபாடுகளையும் தடைகளையும் உடைத்து, கலை மனிதர்களை இணைக்கும் உன்னதப் பாலம் என்பதை நர்த்தகி நடராஜ் மெய்ப்பித்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "How does Narthaki Nataraj's biographical narrative resonate with Unit 8 theme 'Borderless Humanism'?", "media_id": null}], "options": {"A": "By dwelling exclusively in overseas nations", "B": "By dismantling patriarchal gender boundaries through artistic excellence, exemplifying universal human dignity", "C": "Through electoral politics", "D": "Performing solely for elite classes"}, "explanation": "She demolished rigid societal gender barriers, manifesting universal human dignity through sublime artistic discipline."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"i