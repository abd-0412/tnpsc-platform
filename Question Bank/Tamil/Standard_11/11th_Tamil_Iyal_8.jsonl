{"id": "11th_tamil_u8_q137", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "supplementary_narthaki_nataraj", "chapter_id": null, "topic_id": "dance_bhava_raga_tala", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பரதம்' (Bharatham) என்ற சொல்லுக்கு நாட்டிய சாஸ்திர மரபில் கூறப்படும் முப்பெரும் கூறுகளின் சுருக்க விளக்கம் யாது?", "media_id": null}], "options": {"A": "ப - பாவம் (உணர்ச்சி), ர - ராகம் (இசை), த - தாளம் (கால அளவு)", "B": "ப - பாட்டு, ர - ரசனை, த - தவம்", "C": "ப - பார்வை, ர - ராகம், த - தத்துவம்", "D": "ப - படைப்பு, ர - ரகசியம், த - தியாகம்"}, "explanation": "பாவம் (Bhava), ராகம் (Raga), தாளம் (Tala) ஆகிய மூன்றின் முதல் எழுத்துகளின் சேர்க்கையே 'பரதம்' என மரபுரையாகக் குறிக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "According to classical Natyashastra traditions, what three fundamental aesthetic elements form the acronym 'Bha-Ra-Tham'?", "media_id": null}], "options": {"A": "Bha - Bhava (emotion/expression), Ra - Raga (melody), Tha - Tala (rhythm)", "B": "Bha - Paattu, Ra - Rasam, Tha - Thavam", "C": "Bha - Vision, Ra - Tune, Tha - Philosophy", "D": "Bha - Creation, Ra - Secret, Tha - Sacrifice"}, "explanation": "Bharatanatyam symbolically derives from Bhava (expression), Raga (melody), and Tala (rhythm)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 189, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 189", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 8", "Supplementary", "NarthakiNataraj"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u8_q138", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "supplementary_narthaki_nataraj", "chapter_id": null, "topic_id": "textbook_curriculum_inclusion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நர்த்தகி நடராஜின் வாழ்வும் நேர்காணலும் 11-ஆம் வகுப்புப் பொதுத்தமிழ் பாடப்புத்தகத்தில் விரிவானப் பகுதியாகச் சேர்க்கப்பட்டதன் முதன்மை நோக்கம் யாது?", "media_id": null}], "options": {"A": "பரீட்சை வினாக்களைக் கடினமாக்குவதற்கு", "B": "மாணவர்களிடையே விளிம்புநிலை மக்கள் மற்றும் திருநங்கையர் மீதான மனிதாபிமானப் பார்வையையும் பாலின சமத்துவ உணர்வையும் வளர்ப்பதற்கு", "C": "அனைவரையும் நடனம் ஆட வைப்பதற்கு", "D": "பழைய பாடங்களை நீக்குவதற்கு"}, "explanation": "பள்ளிப் பருவத்திலேயே மாணவர்களுக்குத் திருநங்கையர் மீதான பாலியல் சமத்துவ உணர்வையும், சாதனை மனிதர்களை மதிக்கும் மனிதநேயப் பண்பையும் பயிற்றுவிப்பதே இதன் நோக்கமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What was the progressive pedagogical purpose behind incorporating Narthaki Nataraj's interview into the Class 11 General Tamil curriculum?", "media_id": null}], "options": {"A": "To make examination questions more difficult", "B": "To inculcate gender equality, constitutional empathy, and deep humanitarian respect for marginalized transgender citizens", "C": "To mandate dance training for all", "D": "To eliminate older chapters arbitrarily"}, "explanation": "The curriculum aims to foster gender sensitivity, empathy, and social justice among young learners."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_