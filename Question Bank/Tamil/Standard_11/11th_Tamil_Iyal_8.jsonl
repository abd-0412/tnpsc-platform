{"id": "11th_tamil_u8_q109", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_muthukumar", "chapter_id": null, "topic_id": "muthukumar_newspaper_columns", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நா. முத்துக்குமார் ஆனந்த விகடன் இதழில் எழுதிய மிக நெகிழ்ச்சியான நாவல் வடிவிலான தொடர் எது?", "media_id": null}], "options": {"A": "வேடிக்கை பார்ப்பவன்", "B": "பொன்னியின் செல்வன்", "C": "மோகமுள்", "D": "பார்த்திபன் கனவு"}, "explanation": "'வேடிக்கை பார்ப்பவன்' என்ற தலைப்பில் மனிதர்களின் பலதரப்பட்ட விசித்திர வாழ்க்கையை ஆனந்த விகடனில் தொடராக எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "Which poignant observational prose series was penned by Na. Muthukumar in Ananda Vikatan?", "media_id": null}], "options": {"A": "Veedikkai Paarppavan", "B": "Ponniyin Selvan", "C": "Mogamul", "D": "Parthiban Kanavu"}, "explanation": "'Veedikkai Paarppavan' was his celebrated human interest column in Ananda Vikatan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 186, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 186", "url": null, "source_notes": null}, "previo