{"id": "11th_tamil_u8_q079", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "play_dialogue_naturalness", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மனோன்மணீயத்தில் இடம்பெறும் உரையாடல்கள் செய்யுள் வடிவில் அமைந்திருந்தாலும், அவை எவ்வாறு கேட்கப்படுகின்றன?", "media_id": null}], "options": {"A": "கடினமான கல்வெட்டு மொழி போல", "B": "புரிந்துகொள்ள முடியாத புதிர்கள் போல", "C": "இயல்பான பேச்சுத்தமிழின் சுவையும் ஓசை நயமும் ததும்பும் எளிய கவிதை உரையாடல்களாக", "D": "வடமொழி சுலோகங்கள் போல"}, "explanation": "செய்யுள் வடிவில் இருந்தாலும், பாத்திரங்களின் உணர்ச்சிகளை மிக இயல்பாக வெளிப்படுத்தும் எளிய இனிய ஓசை நயத்தோடு சுந்தரனார் அமைத்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Despite being structured in strict classical meter, how do the dramatic dialogues in Manonmaniyam register to the listener?", "media_id": null}], "options": {"A": "Arduous archaic stone inscriptions", "B": "Incomprehensible riddles", "C": "Natural dramatic speech pulsating with conversational ease and rhythmic fluidity", "D": "Sanskrit chants"}, "explanation": "The verses flow with spontaneous dramatic conversational naturalness while preserving metrical discipline."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil N