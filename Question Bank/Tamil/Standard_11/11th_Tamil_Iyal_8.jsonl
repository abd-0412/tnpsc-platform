{"id": "11th_tamil_u8_q107", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_inkulab", "chapter_id": null, "topic_id": "inkulab_posthumous_sahitya_refusal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "2017-ல் இன்குலாப்பின் 'காந்தள் நாட்கள்' நூலுக்குச் சாகித்திய அகாதெமி விருது அறிவிக்கப்பட்டபோது, அவரது குடும்பத்தினர் அதனை ஏற்க மறுத்ததன் காரணம் யாது?", "media_id": null}], "options": {"A": "விருதுத் தொகை குறைவு என்பதால்", "B": "குடும்பத்திற்குள் ஏற்பட்ட கருத்து வேறுபாடு", "C": "இன்குலாப் தம் வாழ்நாளில் எத்தகைய அரசு சலுகைகளையும் விருதுகளையும் நாடாத மக்கள் போராளியாக வாழ்ந்த கொள்கை நெறியைப் போற்றும் வகையில்", "D": "வேறு விருது தருமாறு கோரி"}, "explanation": "இன்குலாப் எப்போதுமே மக்கள் மன்றத்தையே உயர்ந்த விருதாகக் கருதினார்; அரசின் ஒடுக்குமுறைகளுக்கு எதிராக வாழ்ந்த அவரது லட்சியத்திற்கு மதிப்பளித்துக் குடும்பத்தினர் அவ்விருதை ஏற்க மறுத்தனர்."}, "en": {"blocks": [{"type": "text", "content": "When the Sahitya Akademi award was announced for Inquilab's 'Kandhal Naatkal' in 2017, why did his family decline it?", "media_id": null}], "options": {"A": "Prize purse was inadequate", "B": "Intra-family disputes", "C": "Honoring Inquilab lifelong steadfast anti-establishment ethos of never seeking or accepting state patronage", "D": "Demanding an alternate prize"}, "explanation": "His family respectfully declined the award to honor Inquilab's principled lifelong defiance of state accolades."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 184, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 184", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 8", "Poetry", "Inkulab"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u8_q108", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_muthukumar", "chapter_id": null, "topic_id": "muthukumar_nature_imagery", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நா. முத்துக்குமாரின் 'தொலைந்து போனவர்கள்' கவிதையில் கிராமத்து இயற்கை எழிலை விவரிக்கும் கூறுகளாக வருபவை எவை?", "media_id": null}], "options": {"A": "தொழிற்சாலைப் புகைகள்", "B": "வாகன நெரிசல்கள்", "C": "வணிக வளாகங்கள்", "D": "பச்சை வயல்வெளிகள், பாய்ந்தோடும் சிற்றாறுகள், பறவைகளின் பாடல்கள், தாய்மையின் பாசம்"}, "explanation": "கிராமத்தின் தூய காற்றையும், உறவுகளின் கனிவையும் மறந்து மனிதன் இயந்திரக் கூண்டில் மாட்டிக்கொண்டதைப் பச்சை வயல்களோடு ஒப்பிடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What pastoral pastoral imagery of rural harmony is contrasted with sterile urbanity in 'Tholainthu Ponavargal'?", "media_id": null}], "options": {"A": "Industrial chimneys", "B": "Traffic gridlocks", "C": "Shopping complexes", "D": "Lush green paddy fields, gurgling streams, birdsong melodies, and maternal tenderness"}, "explanation": "The poem contrasts lost pastoral innocence with mechanical urban alienation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpora