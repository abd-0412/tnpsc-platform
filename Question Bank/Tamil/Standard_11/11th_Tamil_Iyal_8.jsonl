{"id": "11th_tamil_u8_q149", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "grammar_proofreading_symbols", "chapter_id": null, "topic_id": "run_on_no_paragraph", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அச்சில் புதிய பத்தி தேவையில்லை, முந்தைய வரியோடு 'தொடர்ந்து எழுதுக' (Run on / No paragraph) என்பதைக் குறிக்க எக்குறியீடு பயன்படும்?", "media_id": null}], "options": {"A": "பத்திகளை இணைக்கும் வளைவுக் கோடு (Run on / No ¶)", "B": "#", "C": "d", "D": "caps"}, "explanation": "பத்தி பிரிக்காமல் முந்தைய பத்தியோடு தொடர்ந்து சேர்க்க வளைந்த இணைப்புக்கோடு அல்லது 'No ¶' (No Paragraph) பயன்படும்."}, "en": {"blocks": [{"type": "text", "content": "Which symbol directs typesetters to suppress an erroneous paragraph break and 'Run on' continuously?", "media_id": null}], "options": {"A": "Curved connecting stroke (Run on / No ¶)", "B": "#", "C": "d", "D": "caps"}, "explanation": "A connecting line or 'No ¶' instructs the printer to continue setting text without a paragraph indent."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 193, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8