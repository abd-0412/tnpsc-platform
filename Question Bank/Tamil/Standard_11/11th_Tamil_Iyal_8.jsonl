{"id": "11th_tamil_u8_q015", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "prose_tagore_letters", "chapter_id": null, "topic_id": "tagore_father_devendranath", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாகூரின் தந்தை மகரிஷி தேவேந்திரநாத் தாகூர் பிரம்ம சமாஜத்தின் தலைவராக இருந்தவர். அவர் தியானம் செய்வதற்காக வாங்கிய அமைதிப் பூமிதான் பின்னர் எதுவாக மாறியது?", "media_id": null}], "options": {"A": "பேலூர் மடம்", "B": "தட்சிணேசுவரம்", "C": "சாந்திநிகேதன்", "D": "சாபர்மதி"}, "explanation": "மகரிஷி தேவேந்திரநாத் தாகூர் தியானம் செய்ய அமைத்த ஆசிரமமே 1901-ல் இரவீந்திரநாத் தாகூரால் சாந்திநிகேதன் பள்ளியாகப் பரிணமித்தது."}, "en": {"blocks": [{"type": "text", "content": "The serene retreat acquired by Maharishi Debendranath Tagore for spiritual meditation eventually blossomed into which world-renowned institution?", "media_id": null}], "options": {"A": "Belur Math", "B": "Dakshineswar", "C": "Shantiniketan", "D": "Sabarmati"}, "explanation": "Debendranath Tagore's meditation retreat formed the physical sanctuary of Shantiniketan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 178, "chapter