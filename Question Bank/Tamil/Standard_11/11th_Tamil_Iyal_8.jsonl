{"id": "11th_tamil_u8_q029", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "author_sundaranar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழின் முதல் பா-வடிவ நாடக நூலான 'மனோன்மணீயம்' என்னும் பெருநூலை இயற்றிய ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "பேராசிரியர் பெ. சுந்தரனார் (சுந்தரம் பிள்ளை)", "B": "பம்மல் சம்பந்த முதலியார்", "C": "சங்கரதாஸ் சுவாமிகள்", "D": "பரிதிமாற்கலைஞர்"}, "explanation": "1891-ஆம் ஆண்டு பேராசிரியர் பெ. சுந்தரனார் அவர்களால் 'மனோன்மணீயம்' என்னும் காலத்தால் அழியாத செய்யுள் நாடக நூல் இயற்றப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Who authored the landmark Tamil verse play 'Manonmaniyam' published in 1891?", "media_id": null}], "options": {"A": "Prof. P. Sundaranar (Sundaram Pillai)", "B": "Pammal Sambandha Mudaliar", "C": "Sankaradas Swamigal", "D": "Parithimaar Kalaignar"}, "explanation": "Professor P. Sundaranar authored Manonmaniyam, the first major verse play in modern Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 180, "chapter": null, "section": null, "referen