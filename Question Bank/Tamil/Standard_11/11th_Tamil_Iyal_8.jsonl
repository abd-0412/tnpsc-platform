{"id": "11th_tamil_u8_q101", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_muthukumar", "chapter_id": null, "topic_id": "muthukumar_record_songs", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நா. முத்துக்குமார் தமிழ் சினிமாவில் எத்தனைக்கும் மேற்பட்ட பாடல்களை இயற்றித் தலைசிறந்த பாடலாசிரியராக முத்திரை பதித்துள்ளார்?", "media_id": null}], "options": {"A": "1500-க்கும் மேற்பட்ட பாடல்கள்", "B": "500 பாடல்கள்", "C": "200 பாடல்கள்", "D": "100 பாடல்கள்"}, "explanation": "நா. முத்துக்குமார் குறுகிய காலத்தில் 1,500-க்கும் மேற்பட்ட காலத்தால் அழியாத திரைப்படப் பாடல்களை இயற்றிக் சாதனை படைத்தார்."}, "en": {"blocks": [{"type": "text", "content": "Approximately how many film songs did Na. Muthukumar compose during his prolific career?", "media_id": null}], "options": {"A": "Over 1,500 songs", "B": "Around 500 songs", "C": "200 songs", "D": "100 songs"}, "explanation": "Muthukumar authored more than 1,500 memorable songs across a span of barely two decades."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 186, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 186", "url