{"id": "11th_tamil_u8_q065", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "kudilan_character_archetype", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உலக இலக்கியங்களில் வரும் ஷேக்ஸ்பியரின் 'இயாகோ' (Iago) மற்றும் சாணக்கியன் ஆகிய பாத்திரங்களோடு ஒப்பிடத்தக்க மனோன்மணீயப் பாத்திரம் எது?", "media_id": null}], "options": {"A": "குடிலன்", "B": "ஜீவகன்", "C": "நடராசன்", "D": "பலதேவன்"}, "explanation": "குடிலன் ஷேக்ஸ்பியரின் 'ஒத்தெல்லோ'வில் வரும் வஞ்சகக் கதாநாயகன் இயாகோவைப் போன்ற நயவஞ்சகத்திற்கும், சூழ்ச்சிக்கும் உலகளாவிய அடையாளமாகத் திகழ்கிறான்."}, "en": {"blocks": [{"type": "text", "content": "Which character in Manonmaniyam is universally compared by literary critics to Shakespeare's archetype of malevolence, Iago?", "media_id": null}], "options": {"A": "Kudilan", "B": "Jeevakan", "C": "Natarasan", "D": "Baladevan"}, "explanation": "Kudilan is widely regarded as the Tamil equivalent of Shakespeare's machiavellian villain Iago."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 181, "chapter": null, "section": null, "reference": "11th