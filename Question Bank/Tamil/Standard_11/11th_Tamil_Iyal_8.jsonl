{"id": "11th_tamil_u8_q086", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_inkulab", "chapter_id": null, "topic_id": "inkulab_word_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'இன்குலாப்' (Inquilab) என்னும் அரபு/உருதுச் சொல்லின் தமிழ்ப் பொருள் யாது?", "media_id": null}], "options": {"A": "சுதந்திரம்", "B": "புரட்சி (Revolution)", "C": "அமைதி", "D": "அன்பு"}, "explanation": "'இன்குலாப்' என்பது 'புரட்சி' என்று பொருள்படும் சொல்லாகும்; பகத்சிங் போன்ற விடுதலைப் போராட்ட வீரர்கள் 'இன்குலாப் ஜிந்தாபாத்' (புரட்சி ஓங்குக) என முழங்கினர்."}, "en": {"blocks": [{"type": "text", "content": "What is the precise literal meaning of the Urdu/Arabic word 'Inquilab' adopted as his pen name?", "media_id": null}], "options": {"A": "Independence", "B": "Revolution (Puratchi)", "C": "Tranquility", "D": "Compassion"}, "explanation": "'Inquilab' translates directly as 'Revolution' (Puratchi)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 184, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 184", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 8", "Poetry", "Inkulab"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u8_q087", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_inkulab", "chapter_id": null, "topic_id": "inkulab_plays_dalit", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இன்குலாப் விளிம்புநிலை மக்கள், தலித் மற்றும் பெண்ணியப் பார்வையில் நவீனக் கண்ணோட்டத்தோடு இயற்றிய புகழ்மிக்க நாடகங்கள் எவை?", "media_id": null}], "options": {"A": "மனோன்மணீயம், சபாபதி", "B": "பாண்டியன் பரிசு, இருண்ட வீடு", "C": "ஔவை, மணிமேகலை, குறிஞ்சிப்பாட்டு", "D": "சத்தியவான் சாவித்திரி, வள்ளி திருமணம்"}, "explanation": "இன்குலாப் மரபான பெண் ஆளுமைகளை நவீன விளிம்புநிலை அரசியலோடு மறுவாசிப்பு செய்து 'ஔவை', 'மணிமேகலை', 'குறிஞ்சிப்பாட்டு' ஆகிய நாடகங்களை இயற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Which radical modern plays were penned by Inquilab reinterpreting classical Tamil archetypes from subaltern and feminist perspectives?", "media_id": null}], "options": {"A": "Manonmaniyam, Sabapathy", "B": "Pandiyan Parisu, Irunda Veedu", "C": "Avvai, Manimekalai, Kurinchippaattu", "D": "Sathyavan Savithri, Valli Thirumanam"}, "explanation": "Inquilab revolutionized modern Tamil drama with progressive reinterpretations in Avvai, Manimekalai, and Kurinchippaattu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 184, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 184", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 8", "Poetry", "Inkulab"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u8_q088", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_inkulab", "chapter_id": null, "topic_id": "inkulab_medical_body_donation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மதச்சடங்குகளை மறுத்து வாழ்ந்த இன்குலாப், தம் மறைவிற்குப் பிறகு தன் உடலை எங்கு மருத்துவ ஆராய்ச்சிக்காகத் தானமாக ஒப்படைக்குமாறு உயில் எழுதினார்?", "media_id": null}], "options": {"A": "சென்னை பொது மருத்துவமனை", "B": "மதுரை அரசு ராஜாஜி மருத்துவமனை", "C": "தஞ்சாவூர் மருத்துவக் கல்லூரி", "D": "செங்கல்பட்டு அரசு மருத்துவக் கல்லூரி"}, "explanation": "இன்குலாப் தம் மறைவிற்குப் பிறகு எவ்வித மதச் சடங்குகளும் இன்றி, தம் உடலைச் செங்கல்பட்டு அரசு மருத்துவக் கல்லூரிக்கு மாணவர்களின் ஆய்வுக்காக வழங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "Rejecting sectarian religious rituals, to which medical institution did Inquilab bequeath his mortal remains for anatomical study?", "media_id": null}], "options": {"A": "Madras General Hospital", "B": "Madurai Government Rajaji Hospital", "C": "Thanjavur Medical College", "D": "Chengalpattu Government Medical College"}, "explanation": "Inquilab bequeathed his body to Chengalpattu Government Medical College for scientific research."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publis