{"id": "11th_tamil_u8_q081", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "sundaranar_fellow_frhs", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பேராசிரியர் பெ. சுந்தரனார் லண்டன் அரச கழகத்தின் (Royal Historical Society) எந்தப் பெருமைக்குரிய உறுப்பினர் தகுதியைப் பெற்றார்?", "media_id": null}], "options": {"A": "F.R.H.S (Fellow of the Royal Historical Society)", "B": "F.R.S (Royal Society of Science)", "C": "F.A.S", "D": "F.L.S"}, "explanation": "அவரது வரலாற்று ஆய்வு மேன்மையை ஏற்று லண்டன் ராயல் ஹிஸ்டாரிகல் சொசைட்டி அவருக்கு 'F.R.H.S' என்ற சர்வதேசப் பட்டத்தை வழங்கியது."}, "en": {"blocks": [{"type": "text", "content": "Which prestigious international fellowship was conferred upon Prof. P. Sundaranar by the Royal Historical Society of London?", "media_id": null}], "options": {"A": "F.R.H.S (Fellow of the Royal Historical Society)", "B": "F.R.S (Royal Society of Science)", "C": "F.A.S", "D": "F.L.S"}, "explanation": "Sundaranar was elected a Fellow of the Royal Historical Society (F.R.H.S), London."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "202