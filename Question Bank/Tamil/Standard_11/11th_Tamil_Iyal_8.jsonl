{"id": "11th_tamil_u8_q045", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "sundaranar_lifespan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பேராசிரியர் பெ. சுந்தரனாரின் வாழ்வுக் காலம் எது?", "media_id": null}], "options": {"A": "1855 - 1897", "B": "1860 - 1920", "C": "1840 - 1900", "D": "1875 - 1935"}, "explanation": "பேராசிரியர் சுந்தரனார் 1855 ஏப்ரல் 5-ல் பிறந்து, மிக இளவயதிலேயே (42 வயதில்) 1897 ஏப்ரல் 26-ல் இயற்கை எய்தினார்."}, "en": {"blocks": [{"type": "text", "content": "What is the brief but monumental lifespan of Prof. P. Sundaranar?", "media_id": null}], "options": {"A": "1855 - 1897 (lived only 42 years)", "B": "1860 - 1920", "C": "1840 - 1900", "D": "1875 - 1935"}, "explanation": "Sundaranar lived from 5 April 1855 to 26 April 1897, passing away at the young age of 42."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 182, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 182", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "yea