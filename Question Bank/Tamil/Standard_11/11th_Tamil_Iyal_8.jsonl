{"id": "11th_tamil_u8_q145", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "grammar_proofreading_symbols", "chapter_id": null, "topic_id": "close_up_symbol", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சொற்களுக்கு இடையே தேவைக்கு அதிகமாக உள்ள இடைவெளியை நீக்கி, 'சேர்த்து எழுதுக' (Close up / Delete space) என்பதைக் குறிக்கும் குறியீடு எது?", "media_id": null}], "options": {"A": "மேலேயும் கீழேயும் வளைந்த பிறைக் கோடுகள் ( ⁀‿ / Close up mark)", "B": "#", "C": "¶", "D": "bf"}, "explanation": "இடைவெளியை நீக்கிச் சொற்களை நெருக்கமாக இணைக்க வேண்டும் என்பதைக் குறிக்க எதிரெதிர் வளைந்த பிறைக் குறியீடுகள் (Close up) பயன்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Which proofreader mark signifies 'Close up' to eliminate extraneous whitespace between characters?", "media_id": null}], "options": {"A": "Close-up curved loops ( ⁀‿ )", "B": "#", "C": "¶", "D": "bf"}, "explanation": "The close-up symbol comprises complementary horizontal arcs connecting divided characters."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 193, "chapter": null, "section": null, "reference": "11th Tamil, Uni