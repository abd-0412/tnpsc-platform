{"id": "11th_tamil_u8_q147", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "grammar_proofreading_symbols", "chapter_id": null, "topic_id": "transpose_symbol_tr", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அடுத்தடுத்துள்ள இரண்டு எழுத்துகள் அல்லது சொற்கள் இடம் மாறி அச்சிடப்பட்டிருந்தால், அவற்றை 'இடம் மாற்றுக' (Transpose) என்பதைக் குறிக்கும் குறியீடு எது?", "media_id": null}], "options": {"A": "dele", "B": "#", "C": "tr அல்லது அலைவடிவ S-வளைவுக் கோடு (Transpose)", "D": "ital"}, "explanation": "எழுத்துகள் அல்லது சொற்களை இடம் மாற்றிச் சரிசெய்ய 'tr' (Transpose) என்ற சொல்லையோ அல்லது அவ்விரண்டையும் இணைக்கும் அலைவடிவ வளைவுக் கோட்டையோ பயன்படுத்துவர்."}, "en": {"blocks": [{"type": "text", "content": "Which mark signals 'Transpose' (tr) when adjacent letters or words are mistakenly inverted?", "media_id": null}], "options": {"A": "dele", "B": "#", "C": "tr or curved S-shaped transposition line", "D": "ital"}, "explanation": "'tr' indicates transposition of adjacent characters or words."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 193, "chapter": null, "section": null, "reference": "11th