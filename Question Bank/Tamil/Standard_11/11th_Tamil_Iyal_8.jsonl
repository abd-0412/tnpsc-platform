{"id": "11th_tamil_u8_q057", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "textbook_excerpt_act_scene", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "11-ஆம் வகுப்புப் பாடப்பகுதியில் மனோன்மணீயம் நாடகத்தில் இடம்பெற்றுள்ள காட்சிப் பகுதி எந்த அங்கத்தைச் சேர்ந்தது?", "media_id": null}], "options": {"A": "அங்கம் 5, களம் 2 (அரண்மனை அந்தப்புரமும் ரகசிய வழியும்)", "B": "அங்கம் 1, களம் 1", "C": "அங்கம் 2, களம் 3", "D": "அங்கம் 3, களம் 4"}, "explanation": "பாடப்பகுதியில் அங்கம் ஐந்து, களம் இரண்டு காட்சியாக இடம்பெற்றுள்ளது; இதில் ஜீவக மன்னன் கோட்டையிலிருந்து சுரங்க வழி வழியே தப்புவதும், குடிலனின் சதி வெளிப்படுவதும் காட்சிப்படுத்தப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Which specific Act and Scene from Manonmaniyam is excerpted in the Standard 11 textbook?", "media_id": null}], "options": {"A": "Act 5, Scene 2 (The royal chamber and the subterranean secret passage)", "B": "Act 1, Scene 1", "C": "Act 2, Scene 3", "D": "Act 3, Scene 4"}, "explanation": "Act 5, Scene 2 forms the dramatic core of the Class 11 textbook excerpt."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", 