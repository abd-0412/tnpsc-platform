{"id": "11th_tamil_u8_q042", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "sundaranar_other_works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பேராசிரியர் சுந்தரனார் இயற்றிய பிற வரலாற்று மற்றும் இலக்கண நூல்களுள் பொருந்தாத ஒன்றைத் தேர்ந்தெடுக்க:", "media_id": null}], "options": {"A": "நூற்தொகை விளக்கம்", "B": "சேக்கிழார் பிள்ளைத்தமிழ்", "C": "திருவிதாங்கூர் பண்டை மன்னர் கால ஆராய்ச்சி (Early Sovereigns of Travancore)", "D": "மதுரை சொக்கநாதர் உலா"}, "explanation": "'நூற்தொகை விளக்கம்' மற்றும் கல்வெட்டு ஆராய்ச்சியாளராக அவர் எழுதிய 'Early Sovereigns of Travancore' ஆகியவை சுந்தரனாரின் படைப்புகள்; 'சேக்கிழார் பிள்ளைத்தமிழ்' மகாவித்துவான் மீனாட்சிசுந்தரம்பிள்ளையின் நூலாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following was NOT authored by Prof. P. Sundaranar?", "media_id": null}], "options": {"A": "Nootrogai Vilakkam", "B": "Sekkizhar Pillaithamizh", "C": "Early Sovereigns of Travancore", "D": "Madurai Chokkanathar Ula"}, "explanation": "Sekkizhar Pillaithamizh was composed by Mahavidwan Meenakshisundaram Pillai, not Sundaranar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpor