{"id": "11th_tamil_u8_q064", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "poetic_diction_sundaranar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பேராசிரியர் சுந்தரனாரின் மனோன்மணீயச் செய்யுள் நடையின் முதன்மையான இலக்கியச் சிறப்பு யாது?", "media_id": null}], "options": {"A": "கொச்சை நடை", "B": "எதுகையற்ற அடுக்குமொழி உரைநடை", "C": "பொருளற்ற ஒலி நயம் மட்டுமே", "D": "சங்க இலக்கியச் சொல்லாட்சியும், நாடகத்திற்குரிய வேகமும், உணர்ச்சி வெளிப்பாடும் ஒருங்கே இணைந்த செவ்வியல் ஆசிரியப்பா நடை"}, "explanation": "பழைய சங்க இலக்கியத்தின் வளமான சொற்களையும், கதை நகர்வுக்குரிய நாடக உணர்ச்சியையும் ஆசிரியப்பாவில் அநாயாசமாகக் கையாண்டுள்ளதே சுந்தரனாரின் தனிப்பெரும் சிறப்பு."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the prime literary hallmark of Sundaranar's poetic diction in Manonmaniyam?", "media_id": null}], "options": {"A": "Vulgar colloquialisms", "B": "Rhymeless bombastic oratory", "C": "Empty auditory jingles", "D": "Classical Sangam vocabulary blended with dramatic momentum and psychological pathos in elevated Aasiriyappa verse"}, "explanation": "Sundaranar synthesized classical Sangam lexical depth with modern dramatic pacing and emotional intensity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book",