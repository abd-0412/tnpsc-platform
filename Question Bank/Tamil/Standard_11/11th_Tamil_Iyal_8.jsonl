{"id": "11th_tamil_u8_q026", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "prose_tagore_letters", "chapter_id": null, "topic_id": "tagore_art_quote_nature", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"கலை என்பது மனிதன் இயற்கையின் மகத்தான ரகசியங்களை உணர்ந்து தன் ஆன்மாவை வெளிப்படுத்தும் மொழி\" - தாகூரின் இக்கருத்து கடிதங்களில் எதனை வலியுறுத்துகிறது?", "media_id": null}], "options": {"A": "வியாபாரக் கலையை", "B": "இயற்கையோடு இணைந்து மலரும் உள்ளுணர்வுக் கலையின் மேன்மையை", "C": "அரசியல் மேடைப் பேச்சை", "D": "தொழில்நுட்ப முன்னேற்றத்தை"}, "explanation": "தாகூரைப் பொறுத்தவரை கலை என்பது செயற்கையான அலங்காரம் அன்று; அது இயற்கையோடு இணைந்த உள்ளத்தின் தன்னுணர்ச்சி வெளிப்பாடாகும்."}, "en": {"blocks": [{"type": "text", "content": "What does Tagore emphasize by asserting that 'Art is the language through which man expresses his soul discovering nature's sublime secrets'?", "media_id": null}], "options": {"A": "Commercial marketing art", "B": "The supremacy of intuitive art blossoming in communion with nature", "C": "Political demagoguery", "D": "Technological mechanization"}, "explanation": "Tagore viewed authentic art as an organic spiritual expression harmonized with the natural world."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kal