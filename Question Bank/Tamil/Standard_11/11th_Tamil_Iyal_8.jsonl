{"id": "11th_tamil_u8_q102", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_inkulab", "chapter_id": null, "topic_id": "inkulab_avvai_drama_insight", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இன்குலாப் இயற்றிய 'ஔவை' நாடகத்தின் தனித்துவமான முற்போக்குப் பார்வை எது?", "media_id": null}], "options": {"A": "ஔவையை ஒரு முதிய பாட்டியாக மட்டுமே காட்டுவது", "B": "ஔவையை அரண்மனைப் புலவராக மட்டும் பார்க்காமல், பாணர்கள், கூத்தர்கள் மற்றும் உழைக்கும் மக்களிடையே அமைதித் தூதுவராக வாழ்ந்த இளந்துடிப்புள்ள சமூகப் போராளியாகச் சித்திரிப்பது", "C": "ஔவையை மாயாஜாலக் கிழவியாகக் காட்டுவது", "D": "ஔவையை அதியமானின் எதிரியாகச் சித்திரிப்பது"}, "explanation": "இன்குலாப் தம் 'ஔவை' நாடகத்தில் பழமைவாதக் கூன்விழுந்த கிழவி என்ற பிம்பத்தை உடைத்து, போர் தடுத்து அமைதி நாடும் மக்கள் கவிஞராக ஔவையை நவீனப்படுத்தினார்."}, "en": {"blocks": [{"type": "text", "content": "What revolutionary historicist revision characterizes Inquilab's award-winning drama 'Avvai'?", "media_id": null}], "options": {"A": "Portraying Avvai merely as a feeble mythological grandmother", "B": "Dismantling archaic stereotypes to present Avvai as a dynamic young subaltern poet-activist and peace diplomat among folk bards", "C": "Depicting Avvai as a magical sorceress", "D": "Casting Avvai as Athiyaman mortal foe"}, "explanation": "Inquilab reinvented Avvai as a progressive organic intellectual advocating peace and anti-war subaltern fraternity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 184, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 184", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 8", "Poetry", "Inkulab"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u8_q103", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_inkulab", "chapter_id": null, "topic_id": "inkulab_man_equality_verse", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"சாதி மத பேதமற்ற ஒரு மானுடக் குடும்பத்தை உருவாக்குவதே உண்மையான கவிதை\" - இன்குலாப்பின் இக்கருத்தோடு இயைந்து நிற்கும் இயல் 8-ன் பொதுக்கருத்து எது?", "media_id": null}], "options": {"A": "வரலாற்றுப் போர்", "B": "தொழில்நுட்ப முன்னேற்றம்", "C": "எல்லைகள் நீத்த மனிதநேயம்", "D": "வியாபார உத்திகள்"}, "explanation": "இயல் 8 'எல்லைகள் நீத்த மனிதநேயம்' என்னும் கருப்பொருளைக் கொண்டது; இன்குலாப்பின் கவிதைகளும் எல்லைகளைக் கடந்த மனித விடுதலையைப் போற்றுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "With which central theme of Unit 8 does Inquilab's conviction of creating a borderless casteless human family harmonize?", "media_id": null}], "options": {"A": "Dynastic militarism", "B": "Technological innovation", "C": "Borderless Humanism (Ellaigal Neetha Manithanheyam)", "D": "Commercial strategies"}, "explanation": "It aligns perfectly with the overarching ethos of Unit 8: Borderless Humanism."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 184, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 184", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 8", "Poetry", "Inkulab"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u8_q104", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_muthukumar", "chapter_id": null, "topic_id": "pattampoochi_virpavan_form", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நா. முத்துக்குமாரின் 'பட்டாம்பூச்சி விற்பவன்' எவ்வகை இலக்கிய நூலாகும்?", "media_id": null}], "options": {"A": "வரலாற்று நாவல்", "B": "நாடக நூல்", "C": "சுயசரிதை", "D": "கவிதைத் தொகுப்பு"}, "explanation": "'பட்டாம்பூச்சி விற்பவன்' நா. முத்துக்குமாரின் எழில்மிகு புதுக்கவிதைகள் அடங்கிய கவிதைத் தொகுப்பாகும்."}, "en": {"blocks": [{"type": "text", "content": "To which literary genre does Na. Muthukumar's work 'Pattampoochi Virpavan' belong?", "media_id": null}], "options": {"A": "Historical Novel", "B": "Theatrical Script", "C": "Autobiography", "D": "Poetry Collection (Kavithai Thoguppu)"}, "explanation": "Pattampoochi Virpavan is a modern Tamil poetry collection."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 186, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 186", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "