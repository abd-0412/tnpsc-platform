{"id": "11th_tamil_u8_q030", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "adaptation_secret_way", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மனோன்மணீயம் ஆங்கில எழுத்தாளர் எட்வர்ட் புல்வர் லிட்டன் (Lord Lytton) எழுதிய எந்த நூலைத் தழுவி இயற்றப்பட்டது?", "media_id": null}], "options": {"A": "தி லாஸ்ட் டேஸ் ஆஃப் பாம்பே", "B": "தி சீக்ரெட் வே (The Secret Way / ரகசிய வழி)", "C": "ஹாம்லெட்", "D": "மேக்பத்"}, "explanation": "லிட்டன் பிரபு ஆங்கிலத்தில் எழுதிய 'The Secret Way' (மறைவழி / ரகசிய வழி) என்னும் நூலின் கதைக் கருவைத் தழுவித் தமிழ் மரபுக்கேற்ப மனோன்மணீயம் படைக்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which English work by Edward Bulwer-Lytton served as the narrative inspiration for Sundaranar's Manonmaniyam?", "media_id": null}], "options": {"A": "The Last Days of Pompeii", "B": "The Secret Way", "C": "Hamlet", "D": "Macbeth"}, "explanation": "Sundaranar adapted the core storyline from Lord Lytton's poetic tale 'The Secret Way'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 182, "chapter": null, "sect