{"id": "11th_tamil_u8_q143", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "grammar_proofreading_symbols", "chapter_id": null, "topic_id": "insert_caret_symbol", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அச்சுப்படியில் விடுபட்ட ஓர் எழுத்து, சொல் அல்லது நிறுத்தற்குறியைச் 'சேர்க்க' (Insert) வேண்டும் என்பதைக் குறிக்கப் பயன்படும் குறியீடு எது?", "media_id": null}], "options": {"A": "#", "B": "¶", "C": "^ (காக்கைக்கால் / Caret mark)", "D": "tr"}, "explanation": "விடுபட்டவற்றை அந்த இடத்தில் சேர்க்க வேண்டும் என்பதைக் குறிக்க மேநோக்கிய அம்பு போன்ற '^' (Caret / காக்கைக்கால் குறியீடு) பயன்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which standard proofreader's mark indicates that an omitted letter, word, or punctuation must be 'Inserted'?", "media_id": null}], "options": {"A": "#", "B": "¶", "C": "^ (Caret mark)", "D": "tr"}, "explanation": "The Caret mark (^) indicates insertion of missing text at that exact location."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 193, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 193", "url": null, "source_