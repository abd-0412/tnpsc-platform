{"id": "11th_tamil_u8_q170", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "thirukkural_unit8", "chapter_id": null, "topic_id": "oozh_effort_triumph", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"ஊழையும் உப்பக்கம் காண்பர் உலைவின்றித்\nதாழாது உஞற்று பவர்\" - இக்குறட்பா உணர்த்தும் வாழ்வியல் உண்மை யாது?", "media_id": null}], "options": {"A": "விதியை யாராலும் வெல்ல முடியாது", "B": "மனம் தளராமல் சோர்வின்றித் தொடர்ந்து முயல்பவர், தமக்கு வரக்கூடிய முன்வினையையும் (விதியையும்) புறமுதுகிட்டு ஓடச் செய்வர்", "C": "முயற்சியைக் கைவிட வேண்டும்", "D": "விதியை மட்டுமே நம்பி வாழ வேண்டும்"}, "explanation": "தளராமல் அயராது உழைக்கும் ஊக்கமுடைய மனிதன், வெல்ல முடியாத விதியையும் தன் விடாமுயற்சியினால் தோற்றுப் பின்வாங்கச் செய்வான்."}, "en": {"blocks": [{"type": "text", "content": "What resolute philosophy is proclaimed in 'Oozhaiyum Uppakkam Kaanbar Ulaivindrith Thaazhaathu Ujnatru Pavar'?", "media_id": null}], "options": {"A": "Destiny is insurmountable", "B": "Those who toil untiringly without flinching will see even relentless fate turn its back in defeat", "C": "One should surrender effort", "D": "Blind fatalism should rule life"}, "explanation": "Undaunted persistent toil triumphs over even cosmic destiny (Oozh)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil 