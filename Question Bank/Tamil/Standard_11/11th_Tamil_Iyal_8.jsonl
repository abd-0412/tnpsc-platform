{"id": "11th_tamil_u8_q123", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "supplementary_narthaki_nataraj", "chapter_id": null, "topic_id": "social_stigma_overcome", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இளமைப் பருவத்தில் குடும்பத்தினராலும் சமூகத்தினராலும் ஒதுக்கப்பட்ட போதிலும், நர்த்தகி நடராஜ் எதனைத் தன் உயிராகப் பற்றிக்கொண்டு வெற்றி கண்டார்?", "media_id": null}], "options": {"A": "வணிகத்தை", "B": "அரசியலை", "C": "நாட்டியக் கலையையும் தணியாத உழைப்பையும்", "D": "வேற்று நாடு செல்வதை"}, "explanation": "சமூகத்தின் அவமதிப்புகளையும் புறக்கணிப்புகளையும் பொருட்படுத்தாமல், நடனக் கலையையே தன் தவமாக ஏற்று அரும்பாடுபட்டு நர்த்தகி நடராஜ் வென்றுகாட்டினார்."}, "en": {"blocks": [{"type": "text", "content": "Despite ostracism and humiliation in her youth, what did Narthaki Nataraj cling to as her singular lifeline to triumph?", "media_id": null}], "options": {"A": "Commercial business", "B": "Party politics", "C": "The divine discipline of dance and relentless perseverance", "D": "Emigrating abroad"}, "explanation": "She transformed the art of dance into an ascetical sadhana, turning social stigma into historic global triumph."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Ser