{"id": "11th_tamil_u8_q146", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "grammar_proofreading_symbols", "chapter_id": null, "topic_id": "new_paragraph_pilcrow", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அச்சுக் கோர்ப்பில் ஒரு குறிப்பிட்ட இடத்திலிருந்து 'புதிய பத்தி தொடங்குக' (New Paragraph) என்பதைக் குறிக்கப் பயன்படும் மரபுக் குறியீடு எது?", "media_id": null}], "options": {"A": "^", "B": "¶ (Pilcrow) அல்லது [ குறியீடு", "C": "#", "D": "tr"}, "explanation": "புதிய பத்தி தொடங்குவதை உணர்த்த '¶' (Pilcrow) அல்லது இடப்பக்க அடைப்புக் குறியீடு '[' பயன்படுத்தப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which traditional typographical symbol instructs the typesetter to begin a 'New Paragraph'?", "media_id": null}], "options": {"A": "^", "B": "¶ (Pilcrow) or bracket symbol [", "C": "#", "D": "tr"}, "explanation": "The Pilcrow mark (¶) designates paragraph inception."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 193, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 193", "url": null, "source_notes": null}, "previous_year": {"is_previous_year"