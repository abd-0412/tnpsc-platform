{"id": "11th_tamil_u8_q082", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "chera_pandya_unity_message", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மனோன்மணீயம் நாடகத்தின் வாயிலாகச் சுந்தரனார் உணர்த்தும் வரலாற்று மற்றும் சமூக ஒற்றுமைச் செய்தி யாது?", "media_id": null}], "options": {"A": "தமிழரசர்கள் தங்களுக்குள் ஓயாமல் போரிட வேண்டும்", "B": "சேரரும் பாண்டியரும் (தமிழ் மன்னர்கள்) தங்களுக்குள் போரிடாமல் ஒற்றுமையுடன் வாழ்ந்தால் மட்டுமே தமிழகம் வலிமை பெறும்", "C": "அந்நியப் படையெடுப்பை வரவேற்றல்", "D": "மன்னராட்சி முறையை உடனடியாக வீழ்த்துதல்"}, "explanation": "சேர-பாண்டிய அரசுகளின் திருமணம் மூலம் தமிழக அரசுகளிடையே நிலவ வேண்டிய ஒற்றுமையையும் சகோதரத்துவத்தையும் சுந்தரனார் தேசிய ஒருமைப்பாட்டுச் செய்தியாக விடுக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "What overarching socio-historical message of political unity is underscored through Manonmaniyam?", "media_id": null}], "options": {"A": "Tamil rulers should perpetuate fratricidal wars", "B": "Fraternal solidarity and alliance between Chera and Pandya realms are vital for sovereign strength and cultural renaissance", "C": "Welcoming colonial subjugation", "D": "Violent overthrow of kingdoms"}, "explanation": "Sundaranar championed pan-Tamil solidarity through the symbolic matrimony of Chera and Pandya dynasties."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 181, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 181", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 8", "Poetry", "Manonmaniyam"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u8_q083", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "manonmaniyam_critic_tiru_vi_ka", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"தமிழன்னைக்குச் சுந்தரனார் சூட்டிய வைர மணிமுடியாம் மனோன்மணீயம்\" என்று புகழாரம் சூட்டிய தமிழ்ப் பெரியார் யார்?", "media_id": null}], "options": {"A": "பெரியார் ஈ. வெ. ரா.", "B": "அறிஞர் அண்ணா", "C": "திரு. வி. கலியாணசுந்தரனார்", "D": "ம. பொ. சிவஞானம்"}, "explanation": "தமிழ்த்தென்றல் திரு. வி. க அவர்கள் மனோன்மணீய நூலைத் தமிழன்னையின் மணிமுடியில் பதித்த ஒளிவீசும் மாணிக்கம் எனப் போற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Which iconic scholar eulogized Manonmaniyam as the radiant diamond crown adorned upon Mother Tamil by Prof. Sundaranar?", "media_id": null}], "options": {"A": "Periyar E. V. R.", "B": "Arignar Anna", "C": "Thiru. Vi. Kalyanasundaranar (Thiru. Vi. Ka.)", "D": "Ma. Po. Si."}, "explanation": "Thiru. Vi. Ka. celebrated Manonmaniyam as a crown jewel in the treasury of Tamil literature."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 182, "chapte