{"id": "11th_tamil_u8_q089", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_inkulab", "chapter_id": null, "topic_id": "poetry_central_theme_grass", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"ஒவ்வொரு புல்லையும் பெயர் சொல்லி அழைப்பேன்\nபறவைகளோடு உரையாடுவேன்...\"\n- இன்குலாப்பின் இக்கவிதைக் வரிகளில் வெளிப்படும் முதன்மையான உணர்வு யாது?", "media_id": null}], "options": {"A": "அனைத்து உயிர்களையும் தன் உயிரெனக் கருதும் பேரன்பும் சூழலியல் மனிதநேயமும்", "B": "வேட்டையாடும் ஆசை", "C": "காடுகளை அழித்து நகரமாக்கும் வேட்கை", "D": "பொருளாதார வளர்ச்சி மட்டுமே"}, "explanation": "எளிய புல்லையும் பறவையையும் பெயரிட்டு அழைப்பதன் மூலம், இயற்கைக்கும் அனைத்து விளிம்புநிலை உயிரினங்களுக்கும் அங்கீகாரமும் பேரன்பும் அளிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "What sublime sensibility resonates through Inquilab's lines 'I shall address every blade of grass by name; I shall commune with birds'?", "media_id": null}], "options": {"A": "Universal ecological humanism and tender kinship treating every living organism as sovereign self", "B": "Passion for sport hunting", "C": "Zeal for deforestation", "D": "Narrow consumer economics"}, "explanation": "The verse radiates deep ecological empathy, recognizing dignity and life in the humblest blade of grass."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 184, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 184", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 8", "Poetry", "Inkulab"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u8_q090", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_inkulab", "chapter_id": null, "topic_id": "inkulab_poetry_collections", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்கண்டவற்றுள் கவிஞர் இன்குலாப்பின் கவிதைத் தொகுப்பு அல்லாத ஒன்றைத் தேர்ந்தெடுக்க:", "media_id": null}], "options": {"A": "சூரியனைச் சுமப்பவர்கள்", "B": "அழகின் சிரிப்பு", "C": "ஒவ்வொரு புல்லையும் பெயர் சொல்லி அழைப்பேன்", "D": "துடி"}, "explanation": "'அழகின் சிரிப்பு' என்பது பாவேந்தர் பாரதிதாசனின் கவிதை நூல்; மற்றவை அனைத்தும் இன்குலாப்பின் கவிதைத் தொகுப்புகளாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following is NOT a poetry anthology composed by poet Inquilab?", "media_id": null}], "options": {"A": "Sooriyanai Sumappavargal", "B": "Azhagin Sirippu", "C": "Ovvoru Pullaiyum Peyar Solli Azhaippen", "D": "Thudi"}, "explanation": "Azhagin Sirippu was authored by Pavendhar Bharathidasan, not Inquilab."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 184, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 184", "url": null, "source_notes