{"id": "11th_tamil_u8_q021", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "prose_tagore_letters", "chapter_id": null, "topic_id": "tagore_gandhi_title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மோகன்தாஸ் கரம்சந்த் காந்திக்கு முதன்முதலில் 'மகாத்மா' (பெருந்தகையாளர்) என்ற பட்டத்தை வழங்கி அழைத்தவர் யார்?", "media_id": null}], "options": {"A": "இரவீந்திரநாத் தாகூர்", "B": "சுபாஷ் சந்திர போஸ்", "C": "கோபால கிருஷ்ண கோகலே", "D": "ஜவஹர்லால் நேரு"}, "explanation": "தாகூரே காந்தியடிகளை முதன்முதலில் 'மகாத்மா' என அன்போடு விளித்தார்; பதிலுக்குக் காந்தியடிகள் தாகூரை 'குருதேவ்' (Gurudev) என்று அழைத்தார்."}, "en": {"blocks": [{"type": "text", "content": "Who bestowed the venerable title 'Mahatma' (Great Soul) upon Mohandas Karamchand Gandhi?", "media_id": null}], "options": {"A": "Rabindranath Tagore", "B": "Subhash Chandra Bose", "C": "Gopal Krishna Gokhale", "D": "Jawaharlal Nehru"}, "explanation": "Tagore conferred the title Mahatma upon Gandhi, while Gandhi affectionately called him Gurudev."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 178, "chapter": null, "section": null, "referenc