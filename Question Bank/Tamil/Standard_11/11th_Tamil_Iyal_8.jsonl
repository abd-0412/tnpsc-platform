{"id": "11th_tamil_u8_q154", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "grammar_proofreading_symbols", "chapter_id": null, "topic_id": "align_straighten_symbol", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அச்சுப்படியில் வரிகள் நேராக அமையாமல் கோணலாக இருக்கும்போது 'வரியை நேராக்குக' என்பதைக் குறிக்கும் குறியீடு எது?", "media_id": null}], "options": {"A": "^", "B": "இணை இணையான இரண்டு கிடைமட்டக் கோடுகள் (Straighten lines)", "C": "tr", "D": "dele"}, "explanation": "வரிகள் சமச்சீராக நேராக அமைய வேண்டும் என்பதை உணர்த்த இரண்டு இணையான கிடைமட்டக் கோடுகள் (Straighten lines) இடப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Which mark signals the compositor to 'Straighten' misaligned, uneven horizontal lines of type?", "media_id": null}], "options": {"A": "^", "B": "Two parallel horizontal rules (= / Straighten mark)", "C": "tr", "D": "dele"}, "explanation": "Two parallel rules instruct typesetters to level crooked lines horizontally."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 194, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 194", "url": null, "s