{"id": "11th_tamil_u8_q058", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "jeevakan_inner_conflict", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "போர்க்களத்தில் சேரர் படையிடம் தோல்வியடையும் தறுவாயில், பாண்டிய மன்னன் ஜீவகன் தன் அமைச்சர் குடிலனை எவ்வாறு முழுமையாக நம்புகிறான்?", "media_id": null}], "options": {"A": "குடிலன் போர்க்களத்தில் பலரைக் கொன்றதால்", "B": "குடிலனின் முகஸ்துதியையும் போலி விசுவாசத்தையும் மெய்யென நம்பி, அவனது நச்சுப் பேச்சை உண்மை என்று ஏற்றுக்கொண்டதால்", "C": "குடிலன் தன் உயிரைக் காப்பாற்றியதால்", "D": "சுந்தர முனிவர் குடிலனைப் பாராட்டியதால்"}, "explanation": "ஜீவகன் நல்ல மன்னனாயினும், மனிதர்களின் உள்ளத்தை உய்த்துணரும் கூர்மை இல்லாத காரணத்தால் குடிலனின் வஞ்சக நயவஞ்சக முகஸ்துதியை முழுமையாக நம்பி ஏமாறுகிறான்."}, "en": {"blocks": [{"type": "text", "content": "Why does King Jeevakan blindly place absolute faith in minister Kudilan during their dire military crisis?", "media_id": null}], "options": {"A": "Kudilan slew many on the battlefield", "B": "He was beguiled by Kudilan fawning flattery and simulated loyalty, mistaking venomous sycophancy for fidelity", "C": "Kudilan saved his life", "D": "Sage Sundara endorsed Kudilan"}, "explanation": "Jeevakan's tragic flaw was his gullibility in falling for Kudilan's deceitful flattery."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 180, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 180", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 8", "Poetry", "Manonmaniyam"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u8_q059", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "secret_path_betrayal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுரங்கப் பாதையின் வாயிலை அடைக்காமல் திறந்து வைத்துச் சேரப் படைகளை அரண்மனைக்குள் எளிதாகப் புகவிடக் குடிலன் யாருக்கு உத்தரவிடுகிறான்?", "media_id": null}], "options": {"A": "நடராசனுக்கு", "B": "சுந்தர முனிவருக்கு", "C": "தன் மகன் பலதேவனுக்கு", "D": "ஜீவக மன்னனுக்கு"}, "explanation": "குடிலன் தன் மகன் பலதேவனிடம் சுரங்கப் பாதையின் வாயிலைத் திறந்துவைத்துச் சேரப் படைகளை உள்ளே விட்டு ஜீவகனைப் பிடிக்கச் சதி செய்கிறான்."}, "en": {"blocks": [{"type": "text", "content": "To whom does Kudilan whisper covert instructions to leave the secret tunnel unbarred so the Chera forces may enter?", "media_id": null}], "options": {"A": "To Natarasan", "B": "To Sundara Munivar", "C": "To his conspirator son Baladevan", "D": "To King Jeevakan"}, "explanation": "Kudilan instructs Baladevan to unlock the secret subterranean gate for enemy troops."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 181, "chapter": null,