{"id": "11th_tamil_u8_q013", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "prose_tagore_letters", "chapter_id": null, "topic_id": "tagore_village_reconstruction", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சாந்திநிகேதனுக்கு அருகே கிராமப்புறக் கைவினைக் கலைஞர்களுக்காகவும் கிராம மறுமலர்ச்சிக்காகவும் தாகூரால் நிறுவப்பட்ட மையம் எது?", "media_id": null}], "options": {"A": "சீனிகேதன் (Sriniketan)", "B": "சேவாகிராமம்", "C": "சபர்மதி", "D": "பாண்டிச்சேரி ஆசிரமம்"}, "explanation": "1922-ல் லியோனார்ட் எல்ம்ஹர்ஸ்ட் உடன் இணைந்து கிராமப்புற மக்களின் சுயசார்புக்காகத் தாகூர் 'சீனிகேதன்' என்னும் கிராம மறுசீரமைப்பு மையத்தைத் தொடங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "Which rural reconstruction institute was founded near Shantiniketan by Tagore for rural cottage artisans?", "media_id": null}], "options": {"A": "Sriniketan", "B": "Sevagram", "C": "Sabarmati", "D": "Pondicherry Ashram"}, "explanation": "Sriniketan was founded in 1922 to foster grassroots rural development and handicrafts."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 177, "chapter": null, "section": null, "r