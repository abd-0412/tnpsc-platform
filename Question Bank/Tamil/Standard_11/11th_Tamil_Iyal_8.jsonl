{"id": "11th_tamil_u8_q032", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "manonmaniyam_structure_acts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மனோன்மணீயம் நாடக நூல் எத்தனை அங்கங்களையும் (Acts) எத்தனை களங்களையும் (Scenes) கொண்டமைந்துள்ளது?", "media_id": null}], "options": {"A": "மூன்று அங்கங்கள், 15 களங்கள்", "B": "நான்கு அங்கங்கள், 20 களங்கள்", "C": "ஆறு அங்கங்கள், 35 களங்கள்", "D": "ஐந்து அங்கங்கள், 29 களங்கள்"}, "explanation": "மனோன்மணீயம் ஆங்கில ஷேக்ஸ்பியர் நாடக அமைப்பைப் பின்பற்றி 5 அங்கங்களையும், மொத்தம் 29 களங்களையும் கொண்டு அமைந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "How many Acts (Angangal) and Scenes (Kalangal) constitute the structural framework of the play Manonmaniyam?", "media_id": null}], "options": {"A": "Three Acts and 15 Scenes", "B": "Four Acts and 20 Scenes", "C": "Six Acts and 35 Scenes", "D": "Five Acts and 29 Scenes"}, "explanation": "Manonmaniyam is structured classically into 5 Acts and 29 Scenes."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 182, "chapter": null, "section": 