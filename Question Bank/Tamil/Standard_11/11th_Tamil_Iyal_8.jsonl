{"id": "11th_tamil_u8_q016", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "prose_tagore_letters", "chapter_id": null, "topic_id": "tagore_letters_style", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாகூரின் கடித இலக்கிய நடையின் தனிச்சிறப்பாகப் பாடப்பகுதி முன்னுரை சுட்டுவது யாது?", "media_id": null}], "options": {"A": "அரசியல் சண்டைகள் மற்றும் அதிகாரப் போட்டி", "B": "கடினமான வடமொழிச் சொற்கள் நிறைந்த உரைநடை", "C": "வரலாற்றுப் போர்க்களக் குறிப்புகள் மட்டுமே", "D": "கவிதை நயமும், நுட்பமான தத்துவப் பார்வையும், இயற்கையைத் தன் தோழனாகக் காணும் கனிவான உணர்வும்"}, "explanation": "தாகூரின் கடிதங்கள் வெறும் தகவல்கள் அல்ல; அவை கவிதை நயமும், தத்துவ ஒளியும், இயற்கை மீதான பேரன்பும் பொங்கும் செவ்வியல் இலக்கியப் பெட்டகங்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "What distinctive literary hallmark characterizes Tagore's epistolary style in his published correspondence?", "media_id": null}], "options": {"A": "Partisan political rancor", "B": "Arduous archaic Sanskritized prose", "C": "Martial chronicles of war", "D": "Poetic elegance, penetrating metaphysical insight, and tender kinship with nature"}, "explanation": "Tagore's letters sparkle with poetic lyricism, aesthetic communion with nature, and philosophical depth."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 176, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 176", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 8", "Prose", "Tagore"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u8_q017", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "prose_tagore_letters", "chapter_id": null, "topic_id": "tagore_childhood_memories", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாகூர் தம்முடைய சிறுவயதுக் கல்வி பற்றித் தன் கடிதங்களில் குறிப்பிடும் போது எத்தகைய அதிருப்தியை வெளியிடுகிறார்?", "media_id": null}], "options": {"A": "பள்ளிக்கூடங்கள் சிறைச்சாலைகளைப் போலவும், ஆசிரியர்கள் சிறைக் காவலர்களைப் போலவும் குழந்தைகளை அடக்கிவைத்திருந்தனர்", "B": "விளையாட்டு மைதானங்கள் பெரிதாக இருந்தன", "C": "நூல்கள் எதுவும் அச்சிடப்படவில்லை", "D": "தேர்வுகளே நடத்தப்படவில்லை"}, "explanation": "சுவர் சூழ்ந்த பள்ளிக்கூடங்களைச் சிறைக்கூடங்களாகவும், மாணவர்களின் இயல்பான கற்பனையை முடக்கும் இயந்திரக் கல்வியாகவும் தாகூர் கடுமையாக விமர்சித்தார்."}, "en": {"blocks": [{"type": "text", "content": "How does Tagore critically characterize conventional schools in his childhood recollections?", "media_id": null}], "options": {"A": "Schools were like penitentiaries and pedantic teachers like prison wardens stifling children spontaneous curiosity", "B": "Playgrounds were overly spacious", "C": "No printed books were available", "D": "Examinations were never conducted"}, "explanation": "Tagore famously compared traditional schooling to a joyless mechanical prison house."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multip