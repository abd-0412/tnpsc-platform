{"id": "11th_tamil_u8_q134", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "supplementary_narthaki_nataraj", "chapter_id": null, "topic_id": "transgender_rights_history", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்திய உச்ச நீதிமன்றம் எந்த வரலாற்றுத் தீர்ப்பில் (NALSA Judgment) திருநங்கைகளை 'மூன்றாம் பாலினத்தவர்' (Third Gender) என அங்கீகரித்து அவர்தம் அடிப்படை உரிமைகளை உறுதிசெய்தது?", "media_id": null}], "options": {"A": "2010", "B": "2014 (நல்சா தீர்ப்பு - NALSA vs Union of India)", "C": "2000", "D": "2020"}, "explanation": "2014-ல் உச்ச நீதிமன்றம் வழங்கிய நல்சா (NALSA) தீர்ப்பு திருநங்கைகளுக்குத் தங்களது பாலின அடையாளத்தைத் தாங்களே தீர்மானிக்கும் உரிமையையும் கல்வி, வேலைவாய்ப்பில் சம உரிமையையும் வழங்கியது."}, "en": {"blocks": [{"type": "text", "content": "In which historic landmark judgment did the Supreme Court of India officially recognize transgender citizens as 'Third Gender'?", "media_id": null}], "options": {"A": "2010", "B": "2014 (NALSA vs Union of India)", "C": "2000", "D": "2020"}, "explanation": "The Supreme Court delivered the historic NALSA judgment in 2014 affirming fundamental constitutional rights for transgender individuals."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 190, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 190", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 8", "Supplementary", "NarthakiNataraj"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u8_q135", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "supplementary_narthaki_nataraj", "chapter_id": null, "topic_id": "madurai_velliyambalam_name_link", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நர்த்தகி நடராஜ் தாம் நிறுவிய நடனப் பள்ளிக்கு 'வெள்ளியம்பலம்' என்று பெயரிடக் காரணம் என்ன?", "media_id": null}], "options": {"A": "வெள்ளி நிறத்தில் பள்ளி அமைந்திருப்பதால்", "B": "வெள்ளிக்கிழமையில் தொடங்கியதால்", "C": "சிவபெருமான் மதுரையில் கால் மாறி ஆடிய திருத்தலம் 'வெள்ளியம்பலம்' (மதுரை மீனாட்சி சுந்தரேசுவரர் திருக்கோயில்) என்பதால்", "D": "வெள்ளிப் பதக்கம் வென்றதால்"}, "explanation": "மதுரையில் நடராஜப் பெருமான் தன் இடது காலை ஊன்றி வலது காலைத் தூக்கிக் கால் மாறி ஆடிய சபை 'வெள்ளியம்பலம்' ஆகும்; தாம் பிறந்த மதுரையின் அடையாளமாக அப்பெயரை வைத்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Why did Narthaki Nataraj christen her dance institution 'Velliyambalam'?", "media_id": null}], "options": {"A": "The building was painted silver", "B": "Inaugurated on a Friday", "C": "Velliyambalam is the sacred shrine in Madurai where Lord Nataraja shifted his dancing feet", "D": "Commemorating a silver medal"}, "explanation": "Velliyambalam invokes the historic silver hall at Madurai Meenakshi temple where Lord Nataraja danced alternating feet."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_a