{"id": "11th_tamil_u8_q182", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "pyq_unit8", "chapter_id": null, "topic_id": "pyq_thirukkural_manithaneyam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] \"அன்பிலார் எல்லாம் தமக்குரியர் அன்புடையார்\nஎன்பும் உரியர் பிறர்க்கு\" - இக்குறட்பா உணர்த்தும் அடிப்படை அறம் யாது?", "media_id": null}], "options": {"A": "அறிவின் சிறப்பு", "B": "அன்பின் வழியிலான தன்னலமற்ற மனிதநேயம்", "C": "பொருளீட்டும் முறை", "D": "போர்க்கள வெற்றி"}, "explanation": "அன்பு இல்லாதவர் எல்லாவற்றையும் தமக்கே உரியது என்பர்; அன்பு உடையவரோ தம் எலும்பையும் பிறர்க்கு உரிமையாக்கி வாழ்வர் என்ற உன்னத மனிதநேயத்தை வள்ளுவர் போற்றுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] What foundational virtue is celebrated in 'Anbilaar Ellaam Thamakuriyar Anbudaiyaar Enbum Uriyar Pirarkku'?", "media_id": null}], "options": {"A": "Intellectual superiority", "B": "Selfless altruistic humanism rooted in cosmic love", "C": "Commercial wealth gathering", "D": "Battlefield glory"}, "explanation": "The verse crystallizes transcendent humanist empathy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "fu