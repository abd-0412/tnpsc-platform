{"id": "11th_tamil_u8_q189", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "pyq_unit8", "chapter_id": null, "topic_id": "pyq_sundaranar_mother_chera_roots", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] பேராசிரியர் சுந்தரனார் தம் வாழ்நாளில் இயற்றிய மனோன்மணீயம் நாடகத்தை யாருக்குக் காணிக்கையாக (Dedication) அர்ப்பணித்தார்?", "media_id": null}], "options": {"A": "தம்முடைய ஞானாசிரியர் கோடகநல்லூர் சுந்தர சுவாமிகளுக்கு", "B": "திருவிதாங்கூர் மகாராஜாவுக்கு", "C": "தம் பெற்றோருக்கு", "D": "பிரிட்டிஷ் கவர்னருக்கு"}, "explanation": "பேராசிரியர் சுந்தரனார் மனோன்மணீயம் நூலைத் தமக்கு ஆன்மிக நெறி புகட்டிய ஞானாசிரியர் 'கோடகநல்லூர் சுந்தர சுவாமிகள்' அவர்தம் திருவடிகளுக்கே காணிக்கையாக்கினார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] To whom did Prof. P. Sundaranar formally dedicate his monumental masterpiece Manonmaniyam?", "media_id": null}], "options": {"A": "To his spiritual preceptor Kodaganallur Sundara Swamigal", "B": "To the Maharaja of Travancore", "C": "To his parents", "D": "To the British Governor"}, "explanation": "Sundaranar consecrated Manonmaniyam to his spiritual guru Kodaganallur Sundara Swamigal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Ed