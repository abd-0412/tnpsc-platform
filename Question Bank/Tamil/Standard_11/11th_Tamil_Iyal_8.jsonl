{"id": "11th_tamil_u8_q093", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_muthukumar", "chapter_id": null, "topic_id": "muthukumar_national_awards", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் நா. முத்துக்குமார் திரைப்படப் பாடலாசிரியராக எத்தனை முறை சிறந்த பாடலாசிரியருக்கான இந்திய தேசிய விருது பெற்றுள்ளார்?", "media_id": null}], "options": {"A": "இரண்டு முறை (தங்க மீன்கள் - 'ஆனந்த யாழை', சைவம் - 'அழகே அழகே')", "B": "மூன்று முறை", "C": "ஒரு முறை", "D": "நான்கு முறை"}, "explanation": "நா. முத்துக்குமார் 'தங்க மீன்கள்' மற்றும் 'சைவம்' ஆகிய திரைப்படப் பாடல்களுக்காக இருமுறை தேசிய விருது வென்ற பெருமைக்குரியவர்."}, "en": {"blocks": [{"type": "text", "content": "How many times was poet Na. Muthukumar honored with the prestigious Indian National Film Award for Best Lyrics?", "media_id": null}], "options": {"A": "Two times (for Thanga Meenkal and Saivam)", "B": "Three times", "C": "One time", "D": "Four times"}, "explanation": "He won the National Film Award twice for the timeless songs 'Aanandha Yaazhai' and 'Azhagae Azhagae'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page