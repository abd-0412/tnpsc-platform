{"id": "11th_tamil_u8_q167", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "grammar_proofreading_symbols", "chapter_id": null, "topic_id": "margin_align_justify", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பக்கத்தின் வலது மற்றும் இடது பக்க ஓரங்கள் சீராக ஒரே நேர்கோட்டில் அமைய வேண்டும் என்பதைக் குறிக்கும் அச்சுச் சொல் எது?", "media_id": null}], "options": {"A": "வலப்பக்கம் ஒதுக்கு (Right align)", "B": "இடப்பக்கம் ஒதுக்கு (Left align)", "C": "இருபுறமும் நேராக்கு / சீரமை (Justify)", "D": "மையப்படுத்து (Center)"}, "explanation": "'Justify' என்பது பத்தியின் இருபுறமும் (இடது மற்றும் வலது ஓரங்கள்) சமச்சீராக நேர்கோட்டில் அமையச் செய்யும் அச்சு அமைப்பாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which typesetting term specifies that text margins on both left and right sides must align flush into even vertical columns?", "media_id": null}], "options": {"A": "Right align", "B": "Left align", "C": "Justify (Full Justification)", "D": "Center"}, "explanation": "'Justify' aligns both left and right margins evenly."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 194, "chapter": null, "s