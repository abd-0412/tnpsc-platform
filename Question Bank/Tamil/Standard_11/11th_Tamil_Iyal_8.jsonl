{"id": "11th_tamil_u8_q156", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "grammar_proofreading_symbols", "chapter_id": null, "topic_id": "caps_lc_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆங்கில அச்சு மெய்ப்புத் திருத்தத்தில் 'Caps' மற்றும் 'lc' என்பன எவற்றைக் குறிக்கின்றன?", "media_id": null}], "options": {"A": "நீக்குக, சேர்க்க", "B": "புதிய பத்தி, பழைய பத்தி", "C": "இடைவெளி விடுக, குறைக்க", "D": "Caps - பேரெழுத்து (Capital letter); lc - சிற்றெழுத்து (Lower case)"}, "explanation": "'Caps' என்பது பெரிய எழுத்தையும் (தலைப்பெழுத்து), 'lc' என்பது சிறிய எழுத்தையும் (Lower case) குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "What typographical operations are specified by 'Caps' and 'lc' in proofreading?", "media_id": null}], "options": {"A": "Delete and Insert", "B": "New paragraph and Run on", "C": "Space and Close-up", "D": "Caps - Capitalize (Uppercase); lc - Lower case"}, "explanation": "Caps denotes capitalization while lc denotes lowercase conversion."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 194, "chapter": null, "section": null, "reference": "1