{"id": "11th_tamil_u8_q062", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "kudilan_unmasking", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாடகத்தின் இறுதிக் களத்தில் குடிலனின் சதியை மன்னன் ஜீவகனின் முன்னிலையில் வெளிச்சத்திற்குக் கொண்டுவந்து சாட்டையடி போல அம்பலப்படுத்தியவர் யார்?", "media_id": null}], "options": {"A": "பலதேவன்", "B": "சுந்தர முனிவர் மற்றும் நடராசன்", "C": "மனோன்மனி", "D": "அரண்மனைக் காவலன்"}, "explanation": "சுந்தர முனிவரின் வழிகாட்டலில் நடராசன் குடிலன் எழுதிய துரோகக் கடிதங்களையும் ஆதாரங்களையும் நடுநிலையாக வெளிப்படுத்தி ஜீவகனின் கண்களைத் திறக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "Who decisively unmasks Kudilan's treacherous conspiracies before King Jeevakan in the climax?", "media_id": null}], "options": {"A": "Baladevan", "B": "Sage Sundara and the upright youth Natarasan", "C": "Manonmani", "D": "Palace sentry"}, "explanation": "Sundara Munivar and Natarasan expose the traitorous documentary proofs of Kudilan's treason."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 181, "chapter": null,