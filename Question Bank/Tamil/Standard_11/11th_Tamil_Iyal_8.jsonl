{"id": "11th_tamil_u8_q139", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "supplementary_narthaki_nataraj", "chapter_id": null, "topic_id": "narthaki_identity_pride", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நர்த்தகி நடராஜ் தமக்குக் கிடைத்த விருதுகள் மற்றும் அங்கீகாரங்களை எதற்குச் சமர்ப்பிப்பதாகக் கூறுகிறார்?", "media_id": null}], "options": {"A": "தனிப்பட்ட புகழுக்கு மட்டும்", "B": "தம் குடும்பத்தினருக்கு மட்டும்", "C": "தம்முடைய நாட்டியக் கலைக்கும், தாம் சார்ந்த திருநங்கையர் சமூகத்தின் சுயமரியாதைக்கும்", "D": "அரசியல் தலைவர்களுக்கு"}, "explanation": "தமக்குக் கிடைத்த பெருமைகள் அனைத்தும் ஒட்டுமொத்தத் திருநங்கை சமூகத்தின் கௌரவத்திற்கும் தமிழ் நாட்டியக் கலைக்கும் கிடைத்த அங்கீகாரமே என்று நர்த்தகி நடராஜ் பெருமிதத்தோடு உரைக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "To what does Narthaki Nataraj dedicate all her national awards and global accolades?", "media_id": null}], "options": {"A": "Personal fame exclusively", "B": "Her immediate biological family", "C": "To the glory of classical Tamil dance and the collective dignity of the transgender community", "D": "To partisan politicians"}, "explanation": "She dedicates her triumphs to the sacred art of dance and the collective dignity of transgender citizens."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type":