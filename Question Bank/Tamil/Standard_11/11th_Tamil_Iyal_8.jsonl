{"id": "11th_tamil_u8_q056", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "play_conclusion_morals", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மனோன்மணீயம் நாடகத்தின் இறுதி முடிவில் நிலைநாட்டப்படும் அறக்கருத்து யாது?", "media_id": null}], "options": {"A": "வஞ்சகமும் சூழ்ச்சியுமே இறுதியில் வெல்லும்", "B": "நாடகங்கள் அறத்தைப் போதிக்கக் கூடாது", "C": "மன்னராட்சி மக்கள் புரட்சியால் அழிய வேண்டும்", "D": "அறமே வெல்லும்; பாவம் ஒருபோதும் வெற்றியைத் தராது (தர்மத்தின் வாழ்வுதனைச் சூது கவ்வும், தர்மம் மறுபடியும் வெல்லும்)"}, "explanation": "குடிலனின் துரோகமும் வஞ்சகமும் முறியடிக்கப்பட்டு, நேர்மையும் அன்பும் கொண்ட மனோன்மனி-புருடோத்தமன் மணம் நிகழ, அறமே வெல்லும் என்ற உயரிய வாழ்வியல் உண்மை நிலைநாட்டப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What moral and ethical truth triumphs at the resolution of the play Manonmaniyam?", "media_id": null}], "options": {"A": "Chicanery and cynicism inevitably prevail", "B": "Plays should remain amoral", "C": "Monarchy must fall violently", "D": "Righteousness ultimately conquers; deceit cannot permanently extinguish virtue"}, "explanation": "The play concludes with the poetic and moral triumph of virtue, exposing Kudilan's treason and crowning true love."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers