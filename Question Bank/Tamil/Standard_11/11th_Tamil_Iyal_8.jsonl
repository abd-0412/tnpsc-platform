{"id": "11th_tamil_u8_q035", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "female_characters_heroine", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மனோன்மணீயத்தின் கதாநாயகி யார்? அவளது தோழியின் பெயர் யாது?", "media_id": null}], "options": {"A": "அமுதவல்லி, வசந்தவை", "B": "மாதவி, சித்திராபதி", "C": "மனோன்மனி (ஜீவகனின் மகள்) மற்றும் வாணி (தோழி)", "D": "கண்ணகி, தேவந்தி"}, "explanation": "ஜீவக மன்னனின் மகள் மனோன்மனி கதாநாயகி; அவளது ஆருயிர் தோழி வாணி ஆவாள்."}, "en": {"blocks": [{"type": "text", "content": "Who is the titular heroine of Manonmaniyam, and what is her confidante companion name?", "media_id": null}], "options": {"A": "Amuthavalli and Vasanthavai", "B": "Madhavi and Chithirapathi", "C": "Manonmani (King Jeevakan daughter) and Vaani (her companion)", "D": "Kannagi and Devanthi"}, "explanation": "Princess Manonmani is the protagonist, closely accompanied by her confidante Vaani."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 180, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 180", "url": nul