{"id": "11th_tamil_u8_q187", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "thirukkural_unit8", "chapter_id": null, "topic_id": "oppuravu_arital", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"ஊருணி நீர்நிறைந் தற்றே உலகவாம்\nபேரறி வாளன் திரு\" - இக்குறட்பாவில் பயின்றுவந்துள்ள அணி யாது?", "media_id": null}], "options": {"A": "வேற்றுமையணி", "B": "தற்குறிப்பேற்ற அணி", "C": "உவமையணி", "D": "பின்வருநிலையணி"}, "explanation": "ஊர்மக்கள் அனைவருக்கும் பொதுவான ஊருணியில் நீர் நிறைவது போல, உலகநலம் நாடும் பேரறிவாளனின் செல்வம் அனைவருக்கும் பயன்படும் என 'அற்று' என்னும் உவம உருபு வெளிப்பட்டு வந்ததால் இது 'உவமையணி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which poetic figure of speech (Ani) is deployed in 'Ooruni Neerniraindhattrae Ulagavaam Paerarivaalan Thiru'?", "media_id": null}], "options": {"A": "Vettrumaiyani", "B": "Tharkurippaettra Ani", "C": "Uvamaiyani (Simile with explicit comparative particle Attru)", "D": "Pinvarunilaiyani"}, "explanation": "The verse deploys Uvamaiyani through the comparative particle 'attru'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 196, "chap