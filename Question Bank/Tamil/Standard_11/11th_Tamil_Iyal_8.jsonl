{"id": "11th_tamil_u8_q132", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "supplementary_narthaki_nataraj", "chapter_id": null, "topic_id": "narthaki_periyar_award", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சமூக நீதிக்கும் சுயமரியாதைக்கும் ஆற்றிய பங்களிப்பிற்காக நர்த்தகி நடராஜ் அவர்களுக்குத் திராவிடர் கழகத்தால் வழங்கப்பட்ட விருது எது?", "media_id": null}], "options": {"A": "அண்ணா விருது", "B": "கலைஞர் விருது", "C": "பாரதிதாசன் விருது", "D": "பெரியார் விருது"}, "explanation": "சுயமரியாதையோடு வாழ்ந்து ஒடுக்கப்பட்ட சமூகத்தின் அடையாளமாகத் திகழ்ந்தமைக்காக நர்த்தகி நடராஜுக்குப் 'பெரியார் விருது' வழங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which award was conferred upon Narthaki Nataraj by Dravidar Kazhagam for championing self-respect and social justice?", "media_id": null}], "options": {"A": "Anna Award", "B": "Kalaignar Award", "C": "Bharathidasan Award", "D": "Periyar Award"}, "explanation": "She was felicitated with the Periyar Award for upholding self-respect and subverting gender orthodoxy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 190, "chapter":