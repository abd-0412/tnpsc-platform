{"id": "11th_tamil_u8_q192", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "pyq_unit8", "chapter_id": null, "topic_id": "pyq_sundaranar_motto_chaste_tamil", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] மனோன்மணீயத்தில் பேராசிரியர் சுந்தரனார் தமிழின் தனித்தன்மையை விளக்கும் போது கூறிய புகழ்பெற்ற கருத்து எது?", "media_id": null}], "options": {"A": "தமிழ் பிறமொழிகளுக்கு அடங்கியது", "B": "தமிழ் வடமொழியிலிருந்து பிறந்தது", "C": "தமிழுக்கு இலக்கணம் இல்லை", "D": "எத்திசையும் புகழ்மணக்க இருந்தபெரும் தமிழணங்கே! - கன்னடமும் களிதெலுங்கும் மலையாளமும் துளுவும் உன்னுதரத்து உதித்தெழுந்த மொழிகள்"}, "explanation": "திராவிட மொழிக் குடும்பத்தின் தாய்மொழி தமிழே என்பதை நாடகப் பாயிரத்தில் 'உன்னுதரத்து உதித்தெழுந்த மொழிகள்' என்று சுந்தரனார் அழுத்தமாகப் பதிவு செய்தார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] How does Prof. Sundaranar immortalize the maternal primacy of Tamil over sister Dravidian languages in the Manonmaniyam invocation?", "media_id": null}], "options": {"A": "Tamil is subordinate to foreign tongues", "B": "Tamil derived from Sanskrit", "C": "Tamil lacks indigenous grammar", "D": "Kannada, sweet Telugu, Malayalam, and Tulu all emerged organically from your maternal womb, O Goddess Tamil!"}, "explanation": "Sundaranar proclaimed that Kannada, Telugu, Malayalam, and Tulu emerged from the womb of Mother Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_