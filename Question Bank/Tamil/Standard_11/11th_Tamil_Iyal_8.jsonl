{"id": "11th_tamil_u8_q061", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "manonmani_steadfast_love", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மனோன்மனி தன் தந்தை கட்டாயப்படுத்திய போதிலும் அமைச்சர் குடிலனின் மகன் பலதேவனை மணக்க மறுப்பதன் காரணம் என்ன?", "media_id": null}], "options": {"A": "கனவில் தான் கண்ட சேர மன்னன் புருடோத்தமனையே தன் ஆருயிர்க் காதலனாக உளமார ஏற்றுக்கொண்ட கற்பின் திண்மை", "B": "பலதேவன் ஏழை என்பதால்", "C": "தான் துறவியாக வாழ விரும்புவதால்", "D": "வாணி தடுத்ததால்"}, "explanation": "மனோன்மனி தன் உள்ளத்தில் வரித்த காதலன் புருடோத்தமனே தவிரப் பிறிதொருவனைத் தன் உயிர்போயினும் மணக்க மாட்டேன் என்ற கற்பின் திண்மையோடு திகழ்கிறாள்."}, "en": {"blocks": [{"type": "text", "content": "Why does Manonmani resolutely defy marriage to Baladevan despite intense paternal compulsion?", "media_id": null}], "options": {"A": "Her unyielding spiritual chastity committed exclusively to King Purudothaman beheld in her dream", "B": "Because Baladevan was impoverished", "C": "She desired monastic asceticism", "D": "Vaani discouraged her"}, "explanation": "Manonmani's steadfast devotion belongs solely to Purudothaman, preferring death to coerced marriage."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "T