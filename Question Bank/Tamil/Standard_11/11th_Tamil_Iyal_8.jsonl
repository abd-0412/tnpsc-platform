{"id": "11th_tamil_u8_q095", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_muthukumar", "chapter_id": null, "topic_id": "muthukumar_prose_books", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் நா. முத்துக்குமாரின் கட்டுரைகளும் கவிதைகளும் அடங்கிய நூல்களுள் பொருந்தாத ஒன்றைக் கண்டறிக:", "media_id": null}], "options": {"A": "அணிலாடும் முன்றில்", "B": "பட்டாம்பூச்சி விற்பவன்", "C": "சேரமான் காதலி", "D": "கிராமம் நகரம் மாநகரம்"}, "explanation": "'சேரமான் காதலி' கண்ணதாசன் எழுதிய புகழ்பெற்ற சாகித்திய அகாதெமி பரிசு பெற்ற புதினமாகும்; மற்றவை நா. முத்துக்குமாரின் நூல்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following works was NOT written by poet Na. Muthukumar?", "media_id": null}], "options": {"A": "Anilaadum Mundril", "B": "Pattampoochi Virpavan", "C": "Cheraman Kadhali", "D": "Graamam Nagaram Maanagaram"}, "explanation": "Cheraman Kadhali was written by Kannadasan, while the rest are celebrated works by Na. Muthukumar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 186, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page