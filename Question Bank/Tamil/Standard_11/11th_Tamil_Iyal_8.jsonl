{"id": "11th_tamil_u8_q063", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "jeevakan_remorse", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குடிலனின் உண்மை வஞ்சக முகத்தை அறிந்தவுடன் பாண்டிய மன்னன் ஜீவகன் எவ்வாறு துடிக்கிறான்?", "media_id": null}], "options": {"A": "குடிலனைத் தப்பியோட விடுகிறான்", "B": "தன்னைத்தானே பாராட்டுகிறான்", "C": "தன் குருடான நம்பிக்கையை நொந்து, அரியணைப் பொறுப்பில் தவறிவிட்டதை எண்ணி மனம் குமுறி வெதும்புகிறான்", "D": "சேர மன்னனுடன் மீண்டும் போர் தொடுக்கிறான்"}, "explanation": "நயவஞ்சகனை நம்பி உத்தமர்களைத் தண்டித்த தன் மடமையை எண்ணி ஜீவகன் பெருந்துயரிலும் குற்றவுணர்ச்சியிலும் மூழ்குகிறான்."}, "en": {"blocks": [{"type": "text", "content": "How does King Jeevakan react upon realizing the monstrous extent of Kudilan's perfidy?", "media_id": null}], "options": {"A": "He permits Kudilan to flee", "B": "He applauds his own judgment", "C": "He is racked with bitter remorse, agonizing over his gullibility and dereliction of sovereign duty", "D": "He launches another war against the Cheras"}, "explanation": "Jeevakan undergoes profound remorse, painfully realizing how his blind trust compromised his realm."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi"