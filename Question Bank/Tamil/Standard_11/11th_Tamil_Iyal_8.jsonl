{"id": "11th_tamil_u8_q028", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "prose_tagore_letters", "chapter_id": null, "topic_id": "tagore_letters_summary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாகூரின் கடிதங்களைப் படிப்பதனால் மாணவர்களுக்கு ஏற்படும் முதன்மையான மனப்பாங்கு மாற்றம் யாது?", "media_id": null}], "options": {"A": "ஆடம்பரப் பொருட்களின் மீது பற்று", "B": "போட்டித் தேர்வு மதிப்பெண்களை மட்டுமே நினைத்தல்", "C": "இயற்கையை அலட்சியம் செய்தல்", "D": "சுற்றுச்சூழல் மீதான பரிவும், பரந்த மனிதநேயமும், கலை நயமும் வளர்தல்"}, "explanation": "இயற்கையைப் போற்றுதல், அனைத்து உயிர்களிடத்தும் அன்பு செலுத்துதல், சாதி, மத எல்லைகளைக் கடந்த மனிதநேயம் ஆகியவையே இக்கடிதங்கள் மாணவர்களுக்குத் தரும் பெரும் பேறாகும்."}, "en": {"blocks": [{"type": "text", "content": "What fundamental mindset transformation is cultivated in students by studying Tagore's letters?", "media_id": null}], "options": {"A": "Craving for material luxury", "B": "Obsession solely with competitive marks", "C": "Disdain for environmental preservation", "D": "Nurturing deep environmental empathy, boundless humanism, and refined aesthetic sensibility"}, "explanation": "Tagore's writings instill reverence for nature, aesthetic awareness, and borderless humanist values."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type"