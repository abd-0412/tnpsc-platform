{"id": "11th_tamil_u8_q169", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "thirukkural_unit8", "chapter_id": null, "topic_id": "thaalaanmai_kural", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"தாளாண்மை என்னும் தகைமைக்கண் தங்கிற்றே\nவேளாண்மை என்னும் செருக்கு\" - இத்திருக்குறளில் 'தாளாண்மை' என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "விடாமுயற்சி / தன் உழைப்பு", "B": "தாளம் போடுதல்", "C": "அடிபணிதல்", "D": "செல்வச் செருக்கு"}, "explanation": "இக்குறளில் 'தாளாண்மை' என்றால் 'தன் முயற்சி / கடின உழைப்பு' என்று பொருள். விடாமுயற்சி என்னும் சிறந்த குணத்தில்தான் பிறருக்கு உதவும் 'வேளாண்மை' என்னும் பெருமை நிலைபெறுகிறது."}, "en": {"blocks": [{"type": "text", "content": "In the Kural 'Thaalaanmai Ennum Thagaimaikkan Thangittrae Vealaanmai Ennum Serukku', what does 'Thaalaanmai' signify?", "media_id": null}], "options": {"A": "Persevering self-effort / Indefatigable industry", "B": "Beating musical rhythms", "C": "Subservience", "D": "Arrogance of riches"}, "explanation": "'Thaalaanmai' denotes diligent self-effort and industrious labor."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-202