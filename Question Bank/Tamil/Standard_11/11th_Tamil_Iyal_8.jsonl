{"id": "11th_tamil_u8_q067", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "purudothaman_speech_honour", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"பகைவனுக்கும் அருளும் வீரம்\" என்னும் தமிழரின் தொல் மரபு மனோன்மணீயத்தில் எந்த மன்னனின் உரையாடலில் முழுமையாக மிளிர்கிறது?", "media_id": null}], "options": {"A": "ஜீவக மன்னன்", "B": "குடிலன்", "C": "சேர மன்னன் புருடோத்தமன்", "D": "பலதேவன்"}, "explanation": "புருடோத்தமன் ஜீவகனைச் சிறைபிடிக்க வாய்ப்பிருந்தும், துரோக வழியில் வந்த வெற்றியைத் துறந்து, ஜீவகனிடம் பகை மறந்து பெருந்தன்மையோடு நடந்து கொள்கிறான்."}, "en": {"blocks": [{"type": "text", "content": "In which monarch's dialogue does the classical Tamil ideal of chivalric magnanimity towards a defeated adversary shine most brilliantly?", "media_id": null}], "options": {"A": "King Jeevakan", "B": "Kudilan", "C": "Chera King Purudothaman", "D": "Baladevan"}, "explanation": "Purudothaman manifests the highest chivalric magnanimity, spurning unearned battlefield advantage."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 181, "chapter": n