{"id": "11th_tamil_u8_q126", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "supplementary_narthaki_nataraj", "chapter_id": null, "topic_id": "international_dance_performances", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நர்த்தகி நடராஜ் பரதநாட்டியக் கலை நிகழ்ச்சிகளை நிகழ்த்திய வெளிநாடுகளுள் பொருந்தாத ஒன்றைத் தேர்ந்தெடுக்க:", "media_id": null}], "options": {"A": "அமெரிக்கா மற்றும் கனடா", "B": "அண்டார்டிகா", "C": "பிரிட்டன் மற்றும் பிரான்ஸ்", "D": "ஜப்பான் மற்றும் சிங்கப்பூர்"}, "explanation": "நர்த்தகி நடராஜ் அமெரிக்கா, இங்கிலாந்து, பிரான்ஸ், ஜெர்மனி, ஜப்பான், சிங்கப்பூர் உள்ளிட்ட 30-க்கும் மேற்பட்ட நாடுகளில் நாட்டியப் பயணம் மேற்கொண்டுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "In which of the following regions has Narthaki Nataraj NOT staged classical Bharatanatyam recitals?", "media_id": null}], "options": {"A": "USA and Canada", "B": "Antarctica", "C": "Britain and France", "D": "Japan and Singapore"}, "explanation": "She has performed across more than 30 nations across Europe, the Americas, and Asia."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 190, "chapter