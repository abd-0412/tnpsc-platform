{"id": "11th_tamil_u8_q152", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "grammar_proofreading_symbols", "chapter_id": null, "topic_id": "proofreading_two_places", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மெய்ப்புத் திருத்தக் குறியீடுகளை இடும்போது முறையான மரபுப்படி எங்கு எங்கு குறிகள் இடப்பட வேண்டும்?", "media_id": null}], "options": {"A": "புத்தகத்தின் அட்டைப் படத்தில் மட்டும்", "B": "பின்புறப் பக்கத்தில் மட்டும்", "C": "எந்த இடத்திலும் குறிக்கத் தேவையில்லை", "D": "பிழை உள்ள வரியிலும், அதே வரியின் இடது அல்லது வலது பக்க ஓரப் பகுதியிலும் (Margin)"}, "explanation": "அச்சுக் கோர்ப்பாளர் எளிதில் கவனிக்க ஏதுவாகப் பிழையான எழுத்தின் மீதும் குறியிட்டு, அதற்குரிய திருத்தக் குறியீட்டைப் பக்க ஓரத்திலும் (Margin) தெளிவாக இட வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "According to standard publishing practice, where must proofreader marks be physically inscribed on galley sheets?", "media_id": null}], "options": {"A": "On the cover jacket only", "B": "On blank endpapers only", "C": "No markings are necessary", "D": "In-line at the error location AND mirrored in the corresponding side margin"}, "explanation": "Corrections must be signaled within the body text and detailed in adjacent margins for compositor visibility."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"