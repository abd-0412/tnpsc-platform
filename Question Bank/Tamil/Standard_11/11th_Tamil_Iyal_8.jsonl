{"id": "11th_tamil_u8_q033", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "verse_form_aasiriyappa", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மனோன்மணீயம் நாடகம் பெரும்பாலும் எவ்வகை யாப்பு / பா வடிவத்தில் இயற்றப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "ஆசிரியப்பா (நேரிசை ஆசிரியப்பா / நிலமண்டில ஆசிரியப்பா)", "B": "வெண்பா", "C": "கலிப்பா", "D": "வஞ்சிப்பா"}, "explanation": "ஆங்கிலத்தில் நாடகங்களுக்குப் பயன்படும் 'Blank Verse' (அளவொத்த எதுகையற்ற ஆசிரிய யாப்பு) என்பதற்கு இணையாகத் தமிழில் ஆசிரியப்பாவைக் கையாண்டு சுந்தரனார் மனோன்மணீயத்தைப் படைத்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "In which classical Tamil metrical form is the poetic play Manonmaniyam predominantly composed?", "media_id": null}], "options": {"A": "Aasiriyappa (matching English blank verse)", "B": "Venba", "C": "Kalippa", "D": "Vanchippa"}, "explanation": "Sundaranar deployed Aasiriyappa as the ideal indigenous medium equivalent to English dramatic blank verse."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 182, "chapter": null,