{"id": "11th_tamil_u8_q025", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "prose_tagore_letters", "chapter_id": null, "topic_id": "kumaraswamy_works_tnpsc", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாகூரின் நூல்களைத் தமிழில் மொழியாக்கம் செய்த தா. நா. குமாரசுவாமி அவர்களுக்கு வழங்கப்பட்ட புகழ்பெற்ற விருது எது?", "media_id": null}], "options": {"A": "சாகித்திய அகாதெமியின் சிறந்த மொழிபெயர்ப்பாளர் விருது", "B": "நோபல் பரிசு", "C": "ஞானபீட விருது", "D": "சரஸ்வதி சம்மான்"}, "explanation": "தா. நா. குமாரசுவாமி வங்க இலக்கியங்களைத் தமிழில் கொணர்ந்த சிறந்த பங்களிப்பிற்காக சாகித்திய அகாதெமி உள்ளிட்ட பல முதன்மை விருதுகளைப் பெற்றார்."}, "en": {"blocks": [{"type": "text", "content": "Which distinguished literary honor was conferred upon T. N. Kumaraswamy for his outstanding translations of Bengali classics into Tamil?", "media_id": null}], "options": {"A": "Sahitya Akademi Translation Prize", "B": "Nobel Prize", "C": "Jnanpith Award", "D": "Saraswati Samman"}, "explanation": "T. N. Kumaraswamy received the Sahitya Akademi award for his seminal literary translations."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition":