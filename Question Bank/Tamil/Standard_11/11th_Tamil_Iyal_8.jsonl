{"id": "11th_tamil_u8_q084", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "summary_batch3_concept", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மனோன்மணீயம் நாடகத்தில் மனித இயல்பின் இரு பெரும் முரண்பட்ட பக்கங்களை ஒருங்கே காட்டும் பாத்திர இணையாக எதனைக் குறிப்பிடலாம்?", "media_id": null}], "options": {"A": "ஜீவகன் - நடராசன்", "B": "வாணி - மனோன்மனி", "C": "புருடோத்தமன் - சுந்தரர்", "D": "குடிலன் (தீய வஞ்சகம்) மற்றும் சுந்தர முனிவர் / புருடோத்தமன் (தூய அறம்)"}, "explanation": "குடிலன் சுயநலமும் நயவஞ்சகமும் நிறைந்த தீமையின் உருவமாகவும், சுந்தர முனிவரும் புருடோத்தமனும் அறமும் தன்னலமற்ற நன்மையின் உருவமாகவும் நின்று நாடக முரணைத் தோற்றுவிக்கின்றனர்."}, "en": {"blocks": [{"type": "text", "content": "Which pair best exemplifies the grand dramatic antithesis of human nature between sinister treachery and sublime virtue in Manonmaniyam?", "media_id": null}], "options": {"A": "Jeevakan and Natarasan", "B": "Vaani and Manonmani", "C": "Purudothaman and Sundarar", "D": "Kudilan (sinister deceit) versus Sage Sundara / Purudothaman (sublime righteousness)"}, "explanation": "Kudilan and Sundara Munivar/Purudothaman represent the eternal cosmic clash between villainy and moral virtue."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 180, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 180", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 8", "Poetry", "Manonmaniyam"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
