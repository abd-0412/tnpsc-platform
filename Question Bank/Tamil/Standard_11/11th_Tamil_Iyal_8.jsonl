{"id": "11th_tamil_u8_q196", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "pyq_unit8", "chapter_id": null, "topic_id": "pyq_unit8_comprehensive_humanism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] 11-ஆம் வகுப்புப் பொதுத்தமிழ் இயல் 8 முழுவதும் (தாகூரின் கடிதங்கள், மனோன்மணீயம், இன்குலாப், நா. முத்துக்குமார், நர்த்தகி நடராஜ்) மாணவர்களுக்கு உணர்த்தும் உச்சக்கட்ட அறநெறி யாது?", "media_id": null}], "options": {"A": "பொருள் ஈட்டுவதே முதன்மையானது", "B": "எல்லைகளை வகுத்துத் தனிமைப்பட்டு வாழ்வது", "C": "பழைய மரபுகளைக் கண்ணை மூடிக்கொண்டு ஏற்பது", "D": "சாதி, மதம், பாலினம், நாடு கடந்த பரந்த உலகளாவிய மனிதநேயமே வாழ்வின் உன்னதமான அறம் (யாதும் ஊரே யாவரும் கேளிர்)"}, "explanation": "இயல் 8 முழுமையும் மனிதநேயம் எல்லைகளைக் கடந்து அனைத்து உயிர்களையும் சமத்துவத்தோடும் நேயத்தோடும் தழுவ வேண்டும் என்ற புறநானூற்று 'யாதும் ஊரே யாவரும் கேளிர்' பண்பாட்டை நிலைநிறுத்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] What crowning ethical truth does Unit 8 of Class 11 General Tamil impart through its collective literary corpus?", "media_id": null}], "options": {"A": "Accumulation of riches is supreme", "B": "Retreating into sectarian geopolitical enclaves", "C": "Blind adherence to dead feudal conventions", "D": "Universal borderless humanism transcending caste, creed, gender, and nation: All the world is our hamlet, and all humanity our kin!"}, "explanation": "Unit 8 culminates in universal borderless humanism echoing 'Yaathum Oorae Yaavarum Kaelir'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 198, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 198", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 8", "PYQ", "Humanism"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
