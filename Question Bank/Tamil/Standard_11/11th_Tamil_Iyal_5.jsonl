{"id": "11th_tamil_u5_q140", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "supplementary_bimbam", "chapter_id": null, "topic_id": "moral_message", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பிம்பம்' என்ற கதையின் மூலம் எழுத்தாளர் பிரபஞ்சன் மனித குலத்திற்கு உணர்த்தும் உன்னதமான அறம் யாது?", "media_id": null}], "options": {"A": "செல்வமும் அதிகாரமுமே சமூகத்தில் ஒரு மனிதனுக்கு நிலையான பிம்பத்தைத் தருகின்றன", "B": "மனிதர்கள் அனைவரும் ஒரே மாதிரியான திறமைகளையே கொண்டிருக்க வேண்டும்", "C": "வெளிவேடப் பிம்பங்களை விடத் தந்திரமாக வாழ்வதே வெற்றிக்கு வழி", "D": "போலியான பிம்பங்களைத் தகர்த்து உள்ளன்போடும் பரிவோடும் மற்றவர்களின் தனித்துவத்தை மதிப்பதே உண்மையான மனித மாண்பு"}, "explanation": "போலியான பிம்பங்களைக் கடந்து சக மனிதர்களின் தனித்துவத்தையும் உணர்வுகளையும் மதித்து பரிவுடன் வாழ்வதே மனித மாண்பு என்பதை இக்கதை உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What noble moral truth does Prabanjan communicate through 'Bimbam'?", "media_id": null}], "options": {"A": "Wealth and power create lasting images", "B": "All humans should possess identical talents", "C": "Cunningness surpasses true character", "D": "Shattering artificial masks and revering the authentic individuality of others with empathy is true human dignity"}, "explanation": "True dignity lies in transcending false projected masks and respecting fellow beings with genuine empathy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings"