{"id": "11th_tamil_u5_q084", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poem_seerapuraanam", "chapter_id": null, "topic_id": "summary_seerapuraanam_significance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சீறாப்புராணம் தமிழ் இலக்கிய வரலாற்றில் எத்தகைய ஒப்பற்ற பெருமையைப் பெறுகிறது?", "media_id": null}], "options": {"A": "ஒரு சாதாரண மொழிபெயர்ப்பு நூல்", "B": "நாடக நூல்", "C": "சட்ட நூல்", "D": "இசுலாமிய அறநெறிகளையும் நபிகள் நாயகத்தின் புனித வாழ்வையும் கம்பனின் காப்பிய நயத்தோடு இணைத்துத் தமிழுக்கு வழங்கிய முதல் பெருங்காப்பியம்"}, "explanation": "சீறாப்புராணம் இசுலாமியப் பண்பாட்டின் சாரத்தைத் தமிழின் தலைசிறந்த காப்பிய அழகியலோடு இணைத்துப் படைக்கப்பட்ட முதல் மாபெரும் தமிழ்க் காப்பியமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What canonical status does Seerapuraanam occupy in the long continuum of Tamil literary history?", "media_id": null}], "options": {"A": "An ordinary literal translation", "B": "A theatrical play", "C": "A legal penal code", "D": "The premier classical Tamil epic synthesizing Islamic divine ethics and the holy life of Prophet Muhammad with the majestic literary aesthetic of Kamban"}, "explanation": "Seerapuraanam is the premier classical epic synthesizing Islamic revelation with Tamil poetics."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"ty