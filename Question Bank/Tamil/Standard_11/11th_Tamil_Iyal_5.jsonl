{"id": "11th_tamil_u5_q174", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thirukkural_and_pyq", "chapter_id": null, "topic_id": "pyq_seerappuranam_sections", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] சீறாப்புராணத்தில் உள்ள காண்டங்கள், படலங்கள் மற்றும் பாடல்களின் எண்ணிக்கை முறையே யாது?", "media_id": null}], "options": {"A": "3 காண்டங்கள், 80 படலங்கள், 4000 பாடல்கள்", "B": "3 காண்டங்கள், 92 படலங்கள், 5027 பாடல்கள்", "C": "6 காண்டங்கள், 100 படலங்கள், 5000 பாடல்கள்", "D": "5 காண்டங்கள், 92 படலங்கள், 5027 பாடல்கள்"}, "explanation": "சீறாப்புராணம் மூன்று காண்டங்களையும் (விலாதத்துக் காண்டம், நுபுவ்வத்துக் காண்டம், ஹிஜ்ரத்துக் காண்டம்), 92 படலங்களையும், 5,027 விருத்தப் பாடல்களையும் கொண்டது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] What are the counts of Kandams, Patalams, and songs in Seerappuranam?", "media_id": null}], "options": {"A": "3 Kandams, 80 Patalams, 4000 songs", "B": "3 Kandams, 92 Patalams, 5027 songs", "C": "6 Kandams, 100 Patalams, 5000 songs", "D": "5 Kandams, 92 Patalams, 5027 songs"}, "explanation": "Seerappuranam consists of 3 Kandams, 92 Patalams, and 5,027 verses."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Servi