{"id": "11th_tamil_u5_q090", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poetry_agananuru", "chapter_id": null, "topic_id": "compilation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அகநானூற்றைத் தொகுத்தவர் மற்றும் தொகுப்பித்த அரசன் முறையே யார்?", "media_id": null}], "options": {"A": "பூரிக்கோ; உக்கிரப் பெருவழுதி", "B": "மதுரை உப்பூரிகுடி கிழார் மகனார் உருத்திரசன்மன்; பாண்டியன் உக்கிரப் பெருவழுதி", "C": "உருத்திரசன்மன்; பன்னாடு தந்த மாறன் வழுதி", "D": "கூடலூர் கிழார்; சேரமான் யானைகட்சேய்"}, "explanation": "அகநானூற்றைத் தொகுத்தவர் மதுரை உப்பூரிகுடி கிழார் மகனார் உருத்திரசன்மன்; தொகுப்பித்தவர் பாண்டியன் உக்கிரப் பெருவழுதி ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who compiled Agananuru and who was the patron king who commissioned its compilation?", "media_id": null}], "options": {"A": "Purikko; Ukkirap Peruvaluthi", "B": "Madurai Uppurikkudi Kizhar son Uruthirasanman; Pandiyan Ukkirap Peruvaluthi", "C": "Uruthirasanman; Maran Valuthi", "D": "Kudalur Kizhar; Cheraman Yanaikatchey"}, "explanation": "Compiled by Uruthirasanman and patronized by Pandiyan Ukkirap Peruvaluthi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11",