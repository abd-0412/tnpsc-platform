{"id": "11th_tamil_u5_q153", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "grammar_paa_vagaigal", "chapter_id": null, "topic_id": "venba_metrical_check", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கற்க கசடறக் கற்பவை கற்றபின் / நிற்க அதற்குத் தக' - இக்குறளில் 'கற்க' மற்றும் 'கசடறக்' ஆகிய சீர்களுக்கு இடையே அமைந்துள்ள தளை எது?", "media_id": null}], "options": {"A": "இயற்சீர் வெண்டளை (விளமுன் நேர்)", "B": "வெண்சீர் வெண்டளை", "C": "நேரொன்றிய ஆசிரியத்தளை", "D": "நிரையொன்றிய ஆசிரியத்தளை"}, "explanation": "'கற்க' = நேர் நேர் = தேமா; 'கசடறக்' = நிரை நிரை நேர் = கருவிளங்காய் அல்ல; க-ச-ட-றக் = நிரை நேர் = புளிமா. மாமுன் நிரை = இயற்சீர் வெண்டளை."}, "en": {"blocks": [{"type": "text", "content": "In the Kural 'Karka kasadarak karpavai...', what meter linkage (Thalai) connects the first two feet?", "media_id": null}], "options": {"A": "Iyarseer Vendhalai (Maa followed by Nirai)", "B": "Venseer Vendhalai", "C": "Nerondriya Asiriyathalai", "D": "Niraiyondriya Asiriyathalai"}, "explanation": "'Karka' (Themaa) followed by 'Kasadara' (Nirai syllable) forms Iyarseer Vendhalai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "editi