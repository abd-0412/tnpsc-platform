{"id": "11th_tamil_u5_q134", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "supplementary_bimbam", "chapter_id": null, "topic_id": "author_statements_check", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிரபஞ்சன் பற்றிய கீழ்க்கண்ட கூற்றுகளை ஆராய்க:\nகூற்று 1: இவர் புதுச்சேரியைச் சேர்ந்தவர்; சிறுகதை, நாவல், நாடகம் எனப் பல துறைகளில் முத்திரை பதித்தவர்.\nகூற்று 2: இவரது வரலாற்று நாவலான 'வானம் வசப்படும்' 1995-இல் சாகித்திய அகாதெமி விருது பெற்றது.\nகூற்று 3: இவரது படைப்புகள் ஆங்கிலம், இந்தி, தெலுங்கு, ஜெர்மன், பிரெஞ்சு மொழிகளில் மொழிபெயர்க்கப்பட்டுள்ளன.", "media_id": null}], "options": {"A": "கூற்று 1 மற்றும் 2 மட்டுமே சரி", "B": "கூற்றுகள் 1, 2, 3 ஆகிய மூன்றும் சரியானவை", "C": "கூற்று 2 மற்றும் 3 மட்டுமே சரி", "D": "கூற்று 1 மட்டுமே சரி"}, "explanation": "பாடநூல் குறிப்பில் உள்ள இம்மூன்று கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements regarding writer Prabanjan:\n1. Native of Puducherry; wrote stories, novels, plays.\n2. 'Vaanam Vasappadum' won Sahitya Akademi in 1995.\n3. Works translated into English, Hindi, Telugu, German, French.", "media_id": null}], "options": {"A": "Statements 1 and 2 only", "B": "Statements 1, 2, 3 are all correct", "C": "Statements 2 and 3 only", "D": "Statement 1 only"}, "explanation": "All three biographical statements are fully accurate."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question"