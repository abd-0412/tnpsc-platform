{"id": "11th_tamil_u5_q091", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poetry_agananuru", "chapter_id": null, "topic_id": "glossary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பெருங்கடல் முகந்த இருங்கிளைக் கொண்மூ / இருண்டுயர் விசும்பின் வலனேர்பு வளைஇ' - இப்பாடலடிகளில் 'கொண்மூ' மற்றும் 'விசும்பு' என்னும் சொற்களின் பொருள் யாது?", "media_id": null}], "options": {"A": "கடல், மலை", "B": "மின்னல், காற்று", "C": "மேகம், வானம்", "D": "மழை, பூமி"}, "explanation": "'கொண்மூ' என்றால் மேகம் என்றும், 'விசும்பு' என்றால் வானம் என்றும் பொருள்படும்."}, "en": {"blocks": [{"type": "text", "content": "In the lines 'Perunkadal mukandha irungilai konmoo / irunduyar visumbin valanerbu valaii', what are the meanings of 'konmoo' and 'visumbu'?", "media_id": null}], "options": {"A": "Sea, Mountain", "B": "Lightning, Wind", "C": "Cloud, Sky", "D": "Rain, Earth"}, "explanation": "'Konmoo' means cloud, and 'visumbu' means sky."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 113, "chapter": null, "section": null, "reference": "11th Tamil, Unit 5, Page 113", "url": null, "source_notes": null}, "previo