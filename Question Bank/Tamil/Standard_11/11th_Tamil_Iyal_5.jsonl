{"id": "11th_tamil_u5_q026", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "prose_anandarangar_naatkurippu", "chapter_id": null, "topic_id": "historical_source_south_india", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆனந்தரங்கரின் நாட்குறிப்பு வரலாற்று ஆய்வாளர்களால் எத்தகைய முதன்மைச் சான்றாகப் போற்றப்படுகிறது?", "media_id": null}], "options": {"A": "கற்பனை இலக்கியம்", "B": "18-ஆம் நூற்றாண்டு தென்னிந்திய அரசியல், சமூகம், பண்பாடு, பொருளாதாரம் மற்றும் காலனித்துவ மோதல்களை நேரில் கண்ட சமகால நேரடி வரலாற்று ஆவணம் (Contemporary Primary Source)", "C": "புராண இதிகாசம்", "D": "சட்டப் புத்தகம்"}, "explanation": "ஆனந்தரங்கரின் நாட்குறிப்பே 18-ஆம் நூற்றாண்டின் தென்னிந்திய வரலாற்று ஆய்வுகளுக்கு இன்றியமையாத முதன்மைச் சான்றாக விளங்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "How is Anandarangar's diary esteemed among modern professional South Indian historians?", "media_id": null}], "options": {"A": "Fictional poetry", "B": "An indispensable contemporary primary source chronicling 18th-century politics, colonial wars, society, and maritime economy", "C": "Puranic myth", "D": "Penal code manual"}, "explanation": "It is the premier primary documentary source for 18th-century South India."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samach