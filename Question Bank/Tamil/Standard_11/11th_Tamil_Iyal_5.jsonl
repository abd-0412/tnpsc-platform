{"id": "11th_tamil_u5_q093", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poetry_agananuru", "chapter_id": null, "topic_id": "simile_analysis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'போர்ப்புஉறு முரசின் இரங்கி முறைபுரிந்து / அரநெறி பிழையாத் திறனறி மன்னர்...' - இப்பாடலில் மேகத்தின் இடிமுழக்கத்திற்குப் புலவர் எதனை உவமையாகக் கூறுகிறார்?", "media_id": null}], "options": {"A": "நீதி வழுவா மன்னரின் போர்ப்பறை (முரசு) முழக்கம்", "B": "கடலின் பெருவலை அலைகளின் ஓசை", "C": "யானைக் கூட்டங்களின் பிளிறல் ஓசை", "D": "மன்னனின் தேரோடும் பெருவழியின் சத்தம்"}, "explanation": "அறநெறி பிறழாத மன்னரின் போர்க்களத்தில் முழங்கும் வெற்றி முரசு போல மேகங்கள் முழங்கின என்று உவமிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "In the lines describing the thunder, what does the poet compare the rumbling clouds to?", "media_id": null}], "options": {"A": "War drum (murasu) of a righteous king", "B": "Roar of oceanic waves", "C": "Trumpeting of elephant herds", "D": "Rattling sound of royal chariots"}, "explanation": "The thunderous roar of rain clouds is compared to the war drum of a king who strictly abides by justice."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporatio