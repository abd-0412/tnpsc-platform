{"id": "11th_tamil_u5_q087", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poetry_agananuru", "chapter_id": null, "topic_id": "thinai_arrangement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அகநானூற்றில் 10, 20, 30, 40... எனப் பத்தின் மடங்குகளாக (பூச்சியத்தில் முடியும் எண்களில்) வரும் பாடல்கள் எந்தத் திணைக்குரியவை?", "media_id": null}], "options": {"A": "பாலைத் திணை", "B": "மருதத் திணை", "C": "நெய்தல் திணை", "D": "முல்லைத் திணை"}, "explanation": "அகநானூற்றில் 10, 20, 30... என 10-இல் முடியும் 40 பாடல்கள் நெய்தல் திணைக்குரியவை."}, "en": {"blocks": [{"type": "text", "content": "In Agananuru, which Thinai corresponds to poems numbered 10, 20, 30, 40... (multiples of 10)?", "media_id": null}], "options": {"A": "Palai", "B": "Marutham", "C": "Neythal", "D": "Mullai"}, "explanation": "Poems ending in 10 in Agananuru belong to Neythal thinai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": "11th Tamil, Unit 5, Page 114", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "ye