{"id": "11th_tamil_u5_q143", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "grammar_paa_vagaigal", "chapter_id": null, "topic_id": "venba_rules_seer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெண்பா இலக்கணத்தில் வாராத (இடம் பெறக்கூடாத) சீர் எது?", "media_id": null}], "options": {"A": "ஈரசை மாச்சீர்", "B": "ஈரசை விளச்சீர்", "C": "மூவசை கனிச்சீர்", "D": "மூவசை காய்ச்சீர்"}, "explanation": "வெண்பாவில் ஈரசைச் சீர்களான மாச்சீர், விளச்சீர் மற்றும் மூவசைச் சீரான காய்ச்சீர் (வெண்சீர்) மட்டுமே வரும். கனிச்சீர் (வஞ்சிச்சீர்) வெண்பாவில் வாராது."}, "en": {"blocks": [{"type": "text", "content": "Which metrical foot (Seer) is strictly prohibited in Venba verse?", "media_id": null}], "options": {"A": "Two-syllable Maa seer", "B": "Two-syllable Vila seer", "C": "Three-syllable Kani seer", "D": "Three-syllable Kaai seer"}, "explanation": "Kani seer (Vanchi seer) is strictly forbidden in Venba; only Maa, Vila, and Kaai seers are permissible."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 122, "chapter": null, "section": null, "reference": "11th Tamil, Unit 5, Page 122", "url": null, "source_