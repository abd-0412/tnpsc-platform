{"id": "11th_tamil_u5_q059", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poem_seerapuraanam", "chapter_id": null, "topic_id": "medina_reception_scene", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நபிகள் நாயகம் மக்காவிலிருந்து மதீனா நகருக்குள் பிரவேசித்த போது மதீனா நகர மக்கள் அவரை எவ்வாறு வரவேற்றனர்?", "media_id": null}], "options": {"A": "போர்க் கருவிகளோடு", "B": "கதவடைத்து", "C": "மகிழ்ச்சிப் பெருக்குடன் வீதிகள்தோறும் தோரணங்கள் கட்டி, பன்னீர் தெளித்து, மலர் தூவி", "D": "அமைதியாக"}, "explanation": "மதீனா நகர மக்கள் தங்கள் நீண்டநாள் தவப்பயனாய் வந்த அருள்ஜோதியான நபிகள் நாயகத்தை மலர் மாரி பொழிந்து வாழ்த்தொலியோடு வரவேற்றனர்."}, "en": {"blocks": [{"type": "text", "content": "How did the inhabitants of Medina welcome Prophet Muhammad during the historic Hijrah entry depicted in the poem?", "media_id": null}], "options": {"A": "With martial weapons", "B": "By bolting city gates", "C": "With ecstatic joy, festooning city avenues, sprinkling rosewater, and showering blossoms", "D": "In solemn silence"}, "explanation": "The citizens rejoiced, strewing the path with fragrant blossoms and festoons."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class"