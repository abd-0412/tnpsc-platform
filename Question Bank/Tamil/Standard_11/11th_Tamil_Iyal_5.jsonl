{"id": "11th_tamil_u5_q124", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "supplementary_bimbam", "chapter_id": null, "topic_id": "title_significance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இச்சிறுகதைக்கு ஆசிரியர் 'பிம்பம்' எனப் பெயரிட்டதன் தத்துவார்த்தப் பின்னணி யாது?", "media_id": null}], "options": {"A": "கண்ணாடியில் முகம் பார்க்கும் பழக்கத்தைக் குறிக்க", "B": "நிழற்படக் கலையின் நுணுக்கங்களை விளக்க", "C": "நாடக நடிகர்களின் ஒப்பனையைக் குறிக்க", "D": "மனிதர்கள் உலகிற்குத் தங்களைக் காட்டிக் கொள்ளும் போலியான பிம்பங்களையும் உண்மை முகங்களையும் உணர்த்த"}, "explanation": "சமூகத்தில் மனிதர்கள் காட்டும் போலியான பிம்பங்களையும் அதன் பின்னாலுள்ள உண்மை உணர்வுகளையும் உணர்த்தவே 'பிம்பம்' எனப் பெயரிடப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "What is the philosophical rationale behind naming the story 'Bimbam' (Image/Illusion)?", "media_id": null}], "options": {"A": "Gazing into mirrors", "B": "Techniques of photography", "C": "Actor makeup", "D": "Revealing the projected masks versus authentic inner selves of human beings"}, "explanation": "It highlights how humans construct superficial images that mask their authentic feelings."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textb