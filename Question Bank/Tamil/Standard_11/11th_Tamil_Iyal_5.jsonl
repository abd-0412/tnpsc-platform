{"id": "11th_tamil_u5_q100", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poetry_agananuru", "chapter_id": null, "topic_id": "context_thurai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அகநானூற்றின் 188-ஆம் பாடலின் துறை எது?", "media_id": null}], "options": {"A": "தலைவன் பாசறைக்கண் இருந்து தலைவியை நினைந்து வருந்தியது", "B": "தோழி தலைவனை உடன்போக்குக்கு ஆற்றுப்படுத்தியது", "C": "பகற்குறி வந்த தலைவனிடம் வரைவு கடாயது", "D": "தலைமகன் சிறைப்புறத்தானாகத் தோழிக்குச் சொல்லுவாளாய் தலைமகள் சொல்லியது"}, "explanation": "தலைமகன் மறைந்திருக்கத் தோழிக்குச் சொல்வது போலத் தலைவி தம் பிரிவின் துயரத்தை வெளிப்படுத்திய துறையாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the Thurai (context) of poem 188 of Agananuru?", "media_id": null}], "options": {"A": "Hero pining in military camp", "B": "Companion comforting hero", "C": "Urging marriage at day meeting", "D": "Heroine addressing confidante while hero listens secretly outside"}, "explanation": "The heroine addresses her friend while the hero listens outside in secrecy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 113, "chapt