{"id": "11th_tamil_u5_q170", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thirukkural_and_pyq", "chapter_id": null, "topic_id": "marunthu_four_limbs", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'உற்றான் அளவும் பிணியளவும் காலமும் / கற்றான் கருதிச் செயல்' - இக்குறட்பாவில் 'கற்றான்' என்னும் சொல் யாரைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "மன்னன்", "B": "மருத்துவன் (மருத்துவ நூல் கற்றவன்)", "C": "அமைச்சர்", "D": "நோயாளி"}, "explanation": "நோய்வாய்ப்பட்டவனின் உடலளவு, நோயின் அளவு, பருவ காலம் ஆகியவற்றை நன்கு ஆராய்ந்து மருத்துவ நூல் கற்ற மருத்துவன் சிகிச்சை அளிக்க வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "In the Kural 'Utraan alavum piniyalavum kaalamum katraan...', who does 'Katraan' refer to?", "media_id": null}], "options": {"A": "King", "B": "Physician (one learned in medicine)", "C": "Minister", "D": "Patient"}, "explanation": "'Katraan' denotes the learned physician diagnosing patient strength, disease intensity, and season."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 126, "chapter": null, "section": null, "reference": "11th Tamil, Unit 5,