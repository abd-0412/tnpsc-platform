{"id": "11th_tamil_u5_q107", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poetry_agananuru", "chapter_id": null, "topic_id": "palai_thinai_count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அகநானூற்றில் ஒற்றைப்படை எண்களாக (1, 3, 5, 7, 9...) வரும் பாலைத் திணைப் பாடல்களின் மொத்த எண்ணிக்கை எத்தனை?", "media_id": null}], "options": {"A": "80 பாடல்கள்", "B": "120 பாடல்கள்", "C": "200 பாடல்கள்", "D": "100 பாடல்கள்"}, "explanation": "மொத்தமுள்ள 400 பாடல்களில் 200 பாடல்கள் ஒற்றைப்படை எண்களைக் கொண்ட பாலைத் திணைப் பாடல்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the total number of Palai thinai poems in Agananuru appearing on odd numbers?", "media_id": null}], "options": {"A": "80 poems", "B": "120 poems", "C": "200 poems", "D": "100 poems"}, "explanation": "Exactly 200 odd-numbered poems belong to Palai thinai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": "11th Tamil, Unit 5, Page 114", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": n