{"id": "11th_tamil_u5_q015", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "prose_anandarangar_naatkurippu", "chapter_id": null, "topic_id": "madame_dupleix_conflict", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆனந்தரங்கரின் செல்வாக்கைக் கண்டு பொறாமை கொண்டு அவருக்கு எதிராகச் சதி செய்த துய்ப்ளேவின் மனைவி யார்?", "media_id": null}], "options": {"A": "மேரி", "B": "விக்டோரியா", "C": "மேடம் துய்ப்ளே (ஜோசபீன்)", "D": "எலிசபெத்"}, "explanation": "துய்ப்ளேவின் மனைவியான மேடம் துய்ப்ளே ஆனந்தரங்கரின் அதிகாரத்தைப் பறிக்க முயன்றதையும் தன் நாட்குறிப்பில் பாரபட்சமின்றிப் பதிவு செய்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which ambitious spouse of Governor Dupleix harbored intense jealousy against Anandarangar's court influence?", "media_id": null}], "options": {"A": "Mary", "B": "Victoria", "C": "Madame Dupleix (Jeanne Albert / Josephine)", "D": "Elizabeth"}, "explanation": "Madame Dupleix frequently plotted against Anandarangar, as candidly chronicled in his diary."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 107, "chapter": null, "section": null, "reference": "11th Ta