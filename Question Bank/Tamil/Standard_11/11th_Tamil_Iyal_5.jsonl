{"id": "11th_tamil_u5_q142", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "grammar_paa_vagaigal", "chapter_id": null, "topic_id": "seppal_sound_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெண்பாவுக்குரிய 'செப்பல் ஓசை' என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "பாடி அழைப்பது போன்ற ஓசை", "B": "இருவர் உரையாடுவது போன்றும் விடை கூறுவது போன்றும் அமையும் ஓசை", "C": "கன்று துள்ளினாற் போன்ற தாள ஓசை", "D": "மெல்ல உறங்குவது போன்று தளர்ந்த ஓசை"}, "explanation": "செப்பல் என்றால் விடை தருதல் அல்லது சொல்வது என்று பொருள். இருவர் உரையாடுவது போன்றும் ஒருவர் வினவ மற்றொருவர் விடை சொல்வது போன்றும் அமைவது செப்பல் ஓசையாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the intrinsic nature of 'Seppal Osai' (conversational cadence) characteristic of Venba?", "media_id": null}], "options": {"A": "Chanting or calling out aloud", "B": "Resembling a conversational discourse or answering tone", "C": "Leaping cadence like a dancing calf", "D": "Languid cadence like drooping into slumber"}, "explanation": "'Seppal' means conversing or answering, characteristic of didactic discourse like Thirukkural."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services 