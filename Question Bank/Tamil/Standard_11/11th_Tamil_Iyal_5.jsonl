{"id": "11th_tamil_u5_q186", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thirukkural_and_pyq", "chapter_id": null, "topic_id": "pyq_agananuru_commentator", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] அகநானூற்றின் முதல் 90 பாடல்களுக்கு மட்டுமே பழைய உரை உள்ளது. பிற்காலத்தில் முழுமைக்கும் உரை வரைந்த கரந்தைக் கவியரசு யார்?", "media_id": null}], "options": {"A": "உ. வே. சாமிநாதையர்", "B": "வே. துரைசாமிப் பிள்ளை (மற்றும் நாவலர் நா. மு. வேங்கடசாமி நாட்டார்)", "C": "கா. சு. பிள்ளை", "D": "மறைமலையடிகள்"}, "explanation": "அகநானூறு முழுமைக்கும் நாவலர் நா. மு. வேங்கடசாமி நாட்டாரும் கரந்தைக் கவியரசு வே. துரைசாமிப் பிள்ளையும் இணைந்து சிறந்த உரை இயற்றினர்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Who was the scholar from Karanthai who completed the full commentary on Agananuru alongside Na. Mu. Venkatasamy Nattar?", "media_id": null}], "options": {"A": "U. Ve. Swaminatha Iyer", "B": "R. Duraisamy Pillai", "C": "K. S. Pillai", "D": "Maraimalai Adigal"}, "explanation": "Karanthai Kaviyarasu R. Duraisamy Pillai co-authored the comprehensive commentary on Agananuru."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "te