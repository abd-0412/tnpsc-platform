{"id": "11th_tamil_u5_q056", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "prose_anandarangar_naatkurippu", "chapter_id": null, "topic_id": "economic_price_history", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆனந்தரங்கரின் நாட்குறிப்பு சமூக வரலாற்று ஆய்வாளர்களுக்கு எத்தகைய விலைமதிப்பற்ற பொருளாதார விவரங்களை வழங்குகிறது?", "media_id": null}], "options": {"A": "அயல்நாட்டு சுற்றுலா விவரங்கள்", "B": "விளையாட்டுப் போட்டிகள்", "C": "சினிமா செய்திகள்", "D": "அரிசி, நெல், பருத்தி, தங்கம் உள்ளிட்ட பண்டங்களின் சந்தை விலை நிலவரங்கள், பஞ்சக் கால துயரங்கள் மற்றும் வரி விதிப்பு முறைகள்"}, "explanation": "18-ஆம் நூற்றாண்டின் விலைவாசி நிலவரம், பஞ்சம், வர்த்தகப் பண்டமாற்று முறைகள் ஆகிய பொருளாதாரத் தரவுகள் நாட்குறிப்பில் கொட்டிக்கிடக்கின்றன."}, "en": {"blocks": [{"type": "text", "content": "What invaluable socio-economic economic data does Anandarangar's diary provide to modern historians?", "media_id": null}], "options": {"A": "Foreign tourism guidebooks", "B": "Athletic sports scores", "C": "Cinema reports", "D": "Fluctuating commodity prices of rice, cotton, and gold, alongside famine distress records and taxation tariffs"}, "explanation": "It chronicles market prices of food grains, gold, tariffs, and famine conditions."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "bo