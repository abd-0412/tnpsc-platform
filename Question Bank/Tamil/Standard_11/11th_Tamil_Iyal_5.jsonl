{"id": "11th_tamil_u5_q101", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poetry_agananuru", "chapter_id": null, "topic_id": "thinai_patterns", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அகநானூற்றில் 14, 24, 34, 44... என 4-இல் முடியும் எண்கள் கொண்ட பாடல்கள் _____ திணைக்கும், 16, 26, 36, 46... என 6-இல் முடியும் எண்கள் கொண்ட பாடல்கள் _____ திணைக்கும் உரியவை.", "media_id": null}], "options": {"A": "முல்லைத் திணை; மருதத் திணை", "B": "மருதத் திணை; நெய்தல் திணை", "C": "பாலைத் திணை; குறிஞ்சித் திணை", "D": "நெய்தல் திணை; முல்லைத் திணை"}, "explanation": "4 என முடியும் எண்கள் முல்லைத் திணை (40 பாடல்கள்); 6 என முடியும் எண்கள் மருதத் திணை (40 பாடல்கள்)."}, "en": {"blocks": [{"type": "text", "content": "In Agananuru, songs ending in 4 belong to _____ and songs ending in 6 belong to _____.", "media_id": null}], "options": {"A": "Mullai; Marutham", "B": "Marutham; Neythal", "C": "Palai; Kurinji", "D": "Neythal; Mullai"}, "explanation": "Ending in 4 signifies Mullai, ending in 6 signifies Marutham."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference