{"id": "11th_tamil_u5_q105", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poetry_agananuru", "chapter_id": null, "topic_id": "poet_corpus", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வீரை வெளியன் தித்தனார் சங்க இலக்கியங்களில் பாடியுள்ள பிற பாடல்கள் எவை?", "media_id": null}], "options": {"A": "நற்றிணை 58 மற்றும் அகநானூறு 188", "B": "குறுந்தொகை 23 மற்றும் கலித்தொகை 15", "C": "புறநானூறு 182 மற்றும் பதிற்றுப்பத்து 50", "D": "ஐங்குறுநூறு 10 மற்றும் நற்றிணை 100"}, "explanation": "வீரை வெளியன் தித்தனார் நற்றிணையில் ஒரு பாடலும் (பாடல் 58), அகநானூற்றில் ஒரு பாடலும் (பாடல் 188) பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which other poems were composed by Veerai Veliyan Thithanar in Sangam literature?", "media_id": null}], "options": {"A": "Narrinai 58 and Agananuru 188", "B": "Kurunthokai 23 and Kalithokai 15", "C": "Purananuru 182 and Pathitrupathu 50", "D": "Ainkurunuru 10 and Narrinai 100"}, "explanation": "Veerai Veliyan Thithanar composed poem 58 of Narrinai and poem 188 of Agananuru."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section"