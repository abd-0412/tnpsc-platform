{"id": "11th_tamil_u5_q058", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poem_seerapuraanam", "chapter_id": null, "topic_id": "seera_supplement_chinnaseera", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உமறுப்புலவர் மறைவால் சீறாப்புராணத்தின் விடுபட்ட இறுதிப் பகுதியை ‘சின்னச்சீறா’ என்ற பெயரில் பாடி முடித்த புலவர் யார்?", "media_id": null}], "options": {"A": "செய்கு தம்பிப் பாவலர்", "B": "பனி அகமது மரைக்காயர்", "C": "குணங்குடி மஸ்தான்", "D": "சவ்வாதுப் புலவர்"}, "explanation": "சீறாப்புராணம் ஹிஜ்ரத்துக் காண்டத்தோடு நின்றதால், நபிகள் நாயகத்தின் இறுதி வாழ்க்கை வரலாற்றைப் 'பனி அகமது மரைக்காயர்' சின்னச்சீறாவாகப் பாடி முடித்தார்."}, "en": {"blocks": [{"type": "text", "content": "Who composed the supplementary sequel 'Chinna Seera' covering the concluding years of the Prophet's life?", "media_id": null}], "options": {"A": "Seygu Thambi Paavalar", "B": "Pani Ahmad Maraikkayar (பனி அகமது மரைக்காயர்)", "C": "Gunangudi Masthan", "D": "Javvaadhu Pulavar"}, "explanation": "Pani Ahmad Maraikkayar authored 'Chinna Seera' as the sequel."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 109, "chapte