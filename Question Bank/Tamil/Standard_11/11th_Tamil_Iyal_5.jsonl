{"id": "11th_tamil_u5_q145", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "grammar_paa_vagaigal", "chapter_id": null, "topic_id": "venba_ending_seer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெண்பாவின் ஈற்றடியின் ஈற்றுச்சீர் எந்தெந்த வாய்பாடுகளுள் ஏதேனும் ஒன்றைக் கொண்டு மட்டுமே முடிய வேண்டும்?", "media_id": null}], "options": {"A": "நாள், மலர், காசு, பிறப்பு", "B": "தேமா, புளிமா, கூவிளம், கருவிளம்", "C": "தேமாங்காய், புளிமாங்காய், கூவிளங்காய், கருவிளங்காய்", "D": "நேர், நிரை, நேர்பு, தளை"}, "explanation": "வெண்பாவின் இறுதியடி ஈற்றுச்சீர் நாள் (நேர்), மலர் (நிரை), காசு (நேர்பு), பிறப்பு (நிரைபு) என்னும் ஓரசை வாய்பாடுகளுள் ஒன்றைக் கொண்டு முடிதல் வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "With which terminal feet mnemonics must the concluding word of a Venba stanza end?", "media_id": null}], "options": {"A": "Naal, Malar, Kaasu, Pirappu", "B": "Themaa, Pulimaa, Koovilam, Karuvilam", "C": "Themaangai, Pulimaangai, Koovilangai, Karuvilangai", "D": "Ner, Nirai, Nerbu, Thalai"}, "explanation": "A Venba must terminate with one of the single-foot patterns: Naal, Malar, Kaasu, or Pirappu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", 