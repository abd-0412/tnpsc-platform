{"id": "11th_tamil_u5_q185", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thirukkural_and_pyq", "chapter_id": null, "topic_id": "thirukkural_pocchavaamai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பொச்சாவாமை' என்னும் அதிகாரத் தலைப்பின் பொருள் யாது?", "media_id": null}], "options": {"A": "மறதி இல்லாமை (விழிப்புணர்வோடு இருத்தல்)", "B": "பொய் கூறாமை", "C": "கோபம் கொள்ளாமை", "D": "பிறர் பொருளை விரும்பாமை"}, "explanation": "'பொச்சாப்பு' என்றால் மறதி; 'பொச்சாவாமை' என்றால் கடமையிலும் வினையிலும் மறதி கொள்ளாமல் எப்பொழுதும் விழிப்புடன் இருத்தல் என்று பொருள்."}, "en": {"blocks": [{"type": "text", "content": "What is the meaning of the Thirukkural chapter title 'Pocchavaamai'?", "media_id": null}], "options": {"A": "Freedom from forgetfulness / Vigilance and heedfulness", "B": "Never uttering lies", "C": "Refraining from anger", "D": "Not coveting others property"}, "explanation": "'Pocchavaamai' signifies unswerving vigilance and absence of heedlessness/forgetfulness."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 126, "chapter": null, "section": null, "reference": "11th Tamil, Uni