{"id": "11th_tamil_u5_q088", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poetry_agananuru", "chapter_id": null, "topic_id": "author_info", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "11-ஆம் வகுப்புப் பாடப்பகுதியில் இடம்பெற்றுள்ள அகநானூற்றின் 188-ஆம் பாடலை இயற்றிய புலவர் யார்?", "media_id": null}], "options": {"A": "மதுரை உப்பூரிகுடி கிழார்", "B": "உருத்திரசன்மன்", "C": "பெருந்தேவனார்", "D": "வீரை வெளியன் தித்தனார்"}, "explanation": "பாடப்பகுதியில் உள்ள அகநானூற்றுப் பாடலான 'பெருங்கடல் முகந்த இருங்கிளைக் கொண்மூ...' (பாடல் 188) வீரை வெளியன் தித்தனாரால் பாடப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Who authored poem 188 of Agananuru in the Class 11 textbook?", "media_id": null}], "options": {"A": "Madurai Uppurikkudi Kizhar", "B": "Uruthirasanman", "C": "Perundhevanar", "D": "Veerai Veliyan Thithanar"}, "explanation": "Poem 188 of Agananuru was composed by Veerai Veliyan Thithanar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 113, "chapter": null, "section": null, "reference": "11th Tamil, Unit 5, Page 113", "url": null, "source_notes": null}, "previous_year"