{"id": "11th_tamil_u5_q194", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thirukkural_and_pyq", "chapter_id": null, "topic_id": "glossary_merchant_terms", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'Commission' மற்றும் 'Document' என்னும் ஆங்கிலச் சொற்களுக்குரிய நேரடித் தமிழ்ச் சொற்கள் எவை?", "media_id": null}], "options": {"A": "வட்டி; வரி", "B": "தரகு; ஆவணம்", "C": "முதலீடு; சான்றிதழ்", "D": "பங்கு; கடன்"}, "explanation": "Commission என்றால் 'தரகு' என்றும், Document என்றால் 'ஆவணம்' என்றும் தமிழாக்கப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What are the Tamil translations for 'Commission' and 'Document'?", "media_id": null}], "options": {"A": "Interest; Tax", "B": "Tharagu (Brokerage/Commission); Aavanam (Document)", "C": "Investment; Certificate", "D": "Share; Debt"}, "explanation": "Commission translates to Tharagu, and Document translates to Aavanam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 125, "chapter": null, "section": null, "reference": "11th Tamil, Unit 5, Page 125", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": fal