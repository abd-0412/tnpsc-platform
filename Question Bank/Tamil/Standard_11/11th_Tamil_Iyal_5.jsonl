{"id": "11th_tamil_u5_q168", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "grammar_paa_vagaigal", "chapter_id": null, "topic_id": "thullal_kalippa", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கலிப்பாவுக்குரிய துள்ளல் ஓசையின் முக்கியப் பண்பு யாது?", "media_id": null}], "options": {"A": "அடிதோறும் குரல் தாழ்ந்து ஒலித்தல்", "B": "ஒரே சீரான குரலில் ஓதுதல்", "C": "விடை சொல்வது போல அமைதல்", "D": "சீர்தோறும் துள்ளித் தாள நடை கொண்டு உயர்ந்து ஒலித்தல்"}, "explanation": "துள்ளல் ஓசை என்பது சீர்தோறும் துள்ளி உயர்ந்து வரும் நடையைக் கொண்டது; இது கலிப்பாவிற்குரியது."}, "en": {"blocks": [{"type": "text", "content": "What is the defining characteristic of 'Thullal Osai' found in Kalippa?", "media_id": null}], "options": {"A": "Tone descending line by line", "B": "Monotone chanting", "C": "Conversational responding", "D": "Lively rhythmic leaping tone rising with each metrical foot"}, "explanation": "Thullal cadence features dynamic, rising leaps across rhythmic feet, characteristic of Kalippa."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 121, "chapter": null, "section": null, "reference": "11