{"id": "11th_tamil_u5_q106", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poetry_agananuru", "chapter_id": null, "topic_id": "thinai_uripporul", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அகப்பொருள் இலக்கணத்தின்படி குறிஞ்சித் திணைக்குரிய உரிப்பொருள் யாது?", "media_id": null}], "options": {"A": "பிரிதலும் பிரிவு நிமித்தமும்", "B": "புணர்தலும் புணர்தல் நிமித்தமும்", "C": "இருத்தலும் இருத்தல் நிமித்தமும்", "D": "ஊடலும் ஊடல் நிமித்தமும்"}, "explanation": "குறிஞ்சித் திணையின் உரிப்பொருள் 'புணர்தலும் புணர்தல் நிமித்தமும்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the Uripporul (thematic essence) of Kurinji thinai?", "media_id": null}], "options": {"A": "Separation (Pirithal)", "B": "Union of lovers (Punarthal)", "C": "Waiting patiently (Iruthal)", "D": "Lovers spat (Oodal)"}, "explanation": "Kurinji thinai has Punarthalum Punarthal Nimithamum as its essence."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": "11th Tamil, Unit 5, Page 114", "url": null, "source_notes": null}, "previous_year": {"is_previous_year