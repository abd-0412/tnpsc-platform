{"id": "11th_tamil_u5_q016", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "prose_anandarangar_naatkurippu", "chapter_id": null, "topic_id": "unflinching_objectivity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆனந்தரங்கரின் நாட்குறிப்பிற்கு உலகளாவிய தனிச்சிறப்பை அளிக்கும் முதன்மையான பண்பு யாது?", "media_id": null}], "options": {"A": "அரசியல்வாதிகளைப் புகழ்ந்து பாடியமை", "B": "கற்பனைக் கதைகளை எழுதியமை", "C": "மறைபொருளில் எழுதியமை", "D": "நிகழ்வுகளை எவ்வித விருப்பு வெறுப்புமின்றி, உள்ளதை உள்ளபடியே நடுநிலையோடு ஒளிவுமறைவின்றிப் பதிவு செய்தமை (வரலாற்று உண்மைத்தன்மை)"}, "explanation": "தன்னை ஆதரித்த துய்ப்ளேவின் பலவீனங்கள், தனது சொந்தக் குடும்பச் சச்சரவுகள், ஆளுநரின் தவறுகள் என அனைத்தையும் ஒளிவுமறைவின்றிப் பதிவு செய்ததே இந்நூலின் தலையாய சிறப்பம்சமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What supreme journalistic-historical virtue endows Anandarangar's diary with peerless global authenticity?", "media_id": null}], "options": {"A": "Flattery of imperial masters", "B": "Romanticized myth-making", "C": "Cryptic obscure codes", "D": "Unflinching objectivity, candid unvarnished recording of reality without fear, favor, or partisan bias"}, "explanation": "Its unsparing honesty, recording flaws of patrons and self alike, gives it supreme historical value."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple