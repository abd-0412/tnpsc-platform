{"id": "11th_tamil_u5_q089", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poetry_agananuru", "chapter_id": null, "topic_id": "division_and_thinai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அகநானூற்றின் 188-ஆம் பாடல் எந்தப் பிரிவிலும் எந்தத் திணையிலும் அமைந்துள்ளது?", "media_id": null}], "options": {"A": "மணிமிடை பவளம் - குறிஞ்சித் திணை", "B": "களிற்றியானை நிரை - பாலைத் திணை", "C": "நித்திலக் கோவை - மருதத் திணை", "D": "மணிமிடை பவளம் - முல்லைத் திணை"}, "explanation": "பாடல் 188 என்பது 121-300 வரம்புக்குள் வருவதால் மணிமிடை பவளம்; எண் 8-இல் முடிவதால் இது குறிஞ்சித் திணைக்குரியது."}, "en": {"blocks": [{"type": "text", "content": "Under which section and Thinai does poem 188 of Agananuru fall?", "media_id": null}], "options": {"A": "Manimidaipavalam - Kurinji thinai", "B": "Kalitriyanaipirai - Palai thinai", "C": "Nithilakkovai - Marutham thinai", "D": "Manimidaipavalam - Mullai thinai"}, "explanation": "Poem 188 is in Manimidaipavalam (121-300) and belongs to Kurinji thinai (ending in 8)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "re