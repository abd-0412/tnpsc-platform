{"id": "11th_tamil_u5_q193", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thirukkural_and_pyq", "chapter_id": null, "topic_id": "thirukkural_medicinal_causes", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மிகினும் குறையினும் நோய்செய்யும் நூலோர் / வளிமுதலா எண்ணிய மூன்று' - இக்குறளில் 'வளிமுதலா எண்ணிய மூன்று' எவை?", "media_id": null}], "options": {"A": "வாதம் (வளி), பித்தம் (தீ), கபம்/சீதம் (ஐயம்)", "B": "அறம், பொருள், இன்பம்", "C": "நிலம், நீர், காற்று", "D": "கல்வி, செல்வம், வீரம்"}, "explanation": "மருத்துவ நூலோர் கூறுகின்ற வாதம் (வளி), பித்தம் (அழல்), கபம் (ஐயம்) என்னும் மூன்று தாதுக்களும் உணவாலும் செயலாலும் அளவுக்கு மிகினும் குறையினும் உடலுக்கு நோய் செய்யும்."}, "en": {"blocks": [{"type": "text", "content": "In the Kural 'Miginum kuraiyinum noiseyyum...', what are the three bodily humors counted starting with 'Vali'?", "media_id": null}], "options": {"A": "Vata (wind), Pitta (bile), and Kapha (phlegm)", "B": "Virtue, Wealth, and Pleasure", "C": "Earth, Water, and Air", "D": "Learning, Wealth, and Valor"}, "explanation": "The three humors are Vata, Pitta, and Kapha; imbalance in any causes illness."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporat