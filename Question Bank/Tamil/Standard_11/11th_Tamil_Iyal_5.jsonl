{"id": "11th_tamil_u5_q099", "schema_version": "1.0", "kind": "matching", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poetry_agananuru", "chapter_id": null, "topic_id": "line_limits_comparison", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்காணும் சங்க நூல்களையும் அவற்றின் அடி எல்லைகளையும் பொருத்துக:\n(அ) ஐங்குறுநூறு - 1. 13 முதல் 31 அடிகள்\n(ஆ) குறுந்தொகை - 2. 9 முதல் 12 அடிகள்\n(இ) நற்றிணை - 3. 4 முதல் 8 அடிகள்\n(ஈ) அகநானூறு - 4. 3 முதல் 6 அடிகள்", "media_id": null}], "options": {"A": "அ-4, ஆ-2, இ-3, ஈ-1", "B": "அ-3, ஆ-4, இ-2, ஈ-1", "C": "அ-4, ஆ-3, இ-2, ஈ-1", "D": "அ-2, ஆ-3, இ-4, ஈ-1"}, "explanation": "ஐங்குறுநூறு: 3-6 அடி; குறுந்தொகை: 4-8 அடி; நற்றிணை: 9-12 அடி; அகநானூறு: 13-31 அடி. சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": "Match the Sangam works with their line limits:\n(a) Ainkurunuru - 1. 13 to 31 lines\n(b) Kurunthokai - 2. 9 to 12 lines\n(c) Narrinai - 3. 4 to 8 lines\n(d) Agananuru - 4. 3 to 6 lines", "media_id": null}], "options": {"A": "a-4, b-2, c-3, d-1", "B": "a-3, b-4, c-2, d-1", "C": "a-4, b-3, c-2, d-1", "D": "a-2, b-3, c-4, d-1"}, "explanation": "Matching line counts: Ainkurunuru (3-6), Kurunthokai (4-8), Narrinai (9-12), Agananuru (13-31). Sequence: 4, 3, 2, 1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "pu