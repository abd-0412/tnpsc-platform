{"id": "11th_tamil_u5_q171", "schema_version": "1.0", "kind": "matching", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thirukkural_and_pyq", "chapter_id": null, "topic_id": "glossary_matching", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்காணும் கலைச்சொற்களையும் அவற்றின் தமிழாக்கத்தையும் பொருத்துக:\n(அ) Trade - 1. கடல் வணிகம்\n(ஆ) Ledger - 2. வணிகக் குழு\n(இ) Maritime Trade - 3. வணிகம்\n(ஈ) Merchant Guild - 4. பேரேடு", "media_id": null}], "options": {"A": "அ-3, ஆ-2, இ-1, ஈ-4", "B": "அ-1, ஆ-4, இ-3, ஈ-2", "C": "அ-3, ஆ-4, இ-1, ஈ-2", "D": "அ-4, ஆ-3, இ-2, ஈ-1"}, "explanation": "Trade - வணிகம் (3); Ledger - பேரேடு (4); Maritime Trade - கடல் வணிகம் (1); Merchant Guild - வணிகக் குழு (2). சரியான வரிசை: 3, 4, 1, 2."}, "en": {"blocks": [{"type": "text", "content": "Match the technical terms with their Tamil meanings:\n(a) Trade - 1. Maritime Trade\n(b) Ledger - 2. Merchant Guild\n(c) Maritime Trade - 3. Trade\n(d) Merchant Guild - 4. Ledger", "media_id": null}], "options": {"A": "a-3, b-2, c-1, d-4", "B": "a-1, b-4, c-3, d-2", "C": "a-3, b-4, c-1, d-2", "D": "a-4, b-3, c-2, d-1"}, "explanation": "Matching: Trade - Vanigam (3), Ledger - Peredu (4), Maritime Trade - Kadal Vanigam (1), Merchant Guild - Vaniga Kuzhu (2). Sequence: 3, 4, 1, 2."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 125, "chapter": null, "section": null, "reference": "11th Tamil, Unit 5, Page 125", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 5", "Glossary", "Vocabulary"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
