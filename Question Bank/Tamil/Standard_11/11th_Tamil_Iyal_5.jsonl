{"id": "11th_tamil_u5_q048", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "prose_anandarangar_naatkurippu", "chapter_id": null, "topic_id": "summary_prose_naatkurippu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆனந்தரங்கர் நாட்குறிப்பு உணர்த்தும் தலையாய வரலாற்று உண்மை யாது?", "media_id": null}], "options": {"A": "பிரெஞ்சுக்காரர்கள் மட்டுமே ஆண்டனர்", "B": "வணிகம் நடைபெறவில்லை", "C": "பழைய தமிழகம் அமைதியாக இருந்தது", "D": "18-ஆம் நூற்றாண்டுத் தென்னிந்தியாவில் ஐரோப்பியக் காலனியாதிக்கப் போட்டியும், சுதேச மன்னர்களின் அரசியல் சூழ்ச்சிகளும், தமிழர்களின் உலகளாவிய கடல் வணிகச் செழிப்பும்"}, "explanation": "காலனிய ஆதிக்கப் போட்டிகள், அரசியல் நிகழ்வுகள், கடல் வணிகம், சமூக வாழ்க்கை ஆகியவற்றை அப்பட்டமாகப் படம் பிடித்துக் காட்டும் வரலாற்றுச் சுரங்கமே ஆனந்தரங்கர் நாட்குறிப்பாகும்."}, "en": {"blocks": [{"type": "text", "content": "What grand historical tapestry is unveiled by Anandarangar's remarkable chronicle?", "media_id": null}], "options": {"A": "French ruled without opposition", "B": "Trade was non-existent", "C": "Complete peace prevailed", "D": "Colonial rivalries, political machinations of regional Nawabs, vibrant Tamil maritime trade, and everyday life in 18th-century South India"}, "explanation": "It unveils colonial rivalries, regional politics, and maritime commerce."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "all