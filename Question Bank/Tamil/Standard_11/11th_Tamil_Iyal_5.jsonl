{"id": "11th_tamil_u5_q157", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "grammar_paa_vagaigal", "chapter_id": null, "topic_id": "venba_feet_terms", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெண்பாவில் வரும் சீர்களை எவ்வாறு அழைக்கிறோம்?", "media_id": null}], "options": {"A": "வெண்சீர்கள் மற்றும் இயற்சீர்கள் (இயற்சீர் வெண்டளை & வெண்சீர் வெண்டளை)", "B": "வஞ்சிச் சீர்கள்", "C": "கனிச்சீர்கள்", "D": "அகவற் சீர்கள் மட்டுமே"}, "explanation": "வெண்பாவில் வரும் ஈரசைச் சீர்கள் இயற்சீர்கள் என்றும், காய்ச்சீர்கள் வெண்சீர்கள் என்றும் அழைக்கப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "How are the metrical feet appearing in Venba designated?", "media_id": null}], "options": {"A": "Venseer and Iyarseer", "B": "Vanchiseer", "C": "Kaniseer", "D": "Agavarseer only"}, "explanation": "Venba permits only two-syllable Iyarseer and three-syllable Venseer (Kaai seers)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 122, "chapter": null, "section": null, "reference": "11th Tamil, Unit 5, Page 122", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam