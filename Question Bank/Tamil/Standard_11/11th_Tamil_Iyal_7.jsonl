{"id": "11th_tamil_u7_q009", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "sundara_ramasamy_novels", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுந்தர ராமசாமி எழுதிய புகழ்பெற்ற நாவல்களுள் சரியான தொகுப்பு எது?", "media_id": null}], "options": {"A": "ஒரு புளியமரத்தின் கதை, ஜே. ஜே. சில குறிப்புகள், குழந்தைகள் பெண்கள் ஆண்கள்", "B": "வானம் வசப்படும், மானுடம் வெல்லும்", "C": "கோபல்ல கிராமம், அந்தமான் நாயக்கர்", "D": "வாடிவாசல், சுதந்திர தாகம்"}, "explanation": "'ஒரு புளியமரத்தின் கதை', 'ஜே. ஜே. சில குறிப்புகள்', 'குழந்தைகள் பெண்கள் ஆண்கள்' ஆகியவை சுந்தர ராமசாமியின் புகழ்பெற்ற நாவல்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the correct set of acclaimed novels authored by Sundara Ramasamy:", "media_id": null}], "options": {"A": "Oru Puliyamarathin Kathai, J. J. Sila Kurippugal, Kuzhanthaigal Pengal Aangal", "B": "Vaanam Vasappadum, Maanudam Vellum", "C": "Gopalla Gramam, Andaman Naayakar", "D": "Vadivasal, Suthanthira Thaagam"}, "explanation": "These three novels represent landmark achievements of Sundara Ramasamy in modern Tamil fiction."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Cor