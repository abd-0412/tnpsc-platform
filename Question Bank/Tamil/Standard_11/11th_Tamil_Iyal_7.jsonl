{"id": "11th_tamil_u7_q068", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "bharathidasan_ideology_in_bilhana", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வடமொழிப் 'பில்கணீய'த்தில் உள்ள கதையிலிருந்து பாரதிதாசனின் 'புரட்சிக்கவி' எவ்வாறு மாறுபடுகிறது?", "media_id": null}], "options": {"A": "வடமொழியில் கதை சோகமாக முடியும்", "B": "வடமொழியில் பில்கணன் தப்பித்து ஓடுவான்", "C": "வடமொழியில் போர் நடக்கும்", "D": "வடமொழி மூலக்கதையில் மன்னன் மன்னித்துத் தன் மகளைத் திருமணம் செய்து வைப்பான்; ஆனால் பாரதிதாசன் கதையில் மக்களே திரண்டு புரட்சி செய்து மன்னராட்சியை ஒழித்து மக்களாட்சியை மலரச் செய்வர்"}, "explanation": "பாரதிதாசன் நிலப்பிரபுத்துவ மன்னராட்சியை வீழ்த்தி, பாமர மக்கள் திரண்டு மன்னனைப் பதவியிறக்கி மக்களாட்சியை (குடியரசை) அமைப்பதாகப் புரட்சிகரமான முடிவை அமைத்தார்."}, "en": {"blocks": [{"type": "text", "content": "How does Bharathidasan's 'Puratchikkavi' radically diverge from the original Sanskrit 'Bilhaneeyam'?", "media_id": null}], "options": {"A": "Sanskrit ends in tragic despair", "B": "Bilhana flees in cowardice", "C": "Features foreign invasion", "D": "In Sanskrit the king relents and pardons; Bharathidasan transforms it into a mass revolution overthrowing monarchy for democracy"}, "explanation": "Bharathidasan transforms a court romance into an anti-monarchical proletarian revolution instituting democracy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "que