{"id": "11th_tamil_u7_q035", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "jeeva_imprisonment_history", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "விடுதலைப் போராட்டத்திற்காகவும் பொதுவுடைமை இயக்கத்திற்காகவும் ஜீவா எத்தனை ஆண்டுகள் சிறைவாசம் அனுபவித்தார்?", "media_id": null}], "options": {"A": "2 ஆண்டுகள்", "B": "5 ஆண்டுகள்", "C": "ஏறத்தாழ 10 ஆண்டுகளுக்கும் மேல் சிறைவாசமும் நாடு கடத்தலும்", "D": "சிறைக்கே செல்லவில்லை"}, "explanation": "பிரிட்டிஷ் ஆட்சிக் காலத்திலும், சுதந்திரத்திற்குப் பின்னரும் தொழிலாளர் உரிமைகளுக்காகப் போராடி ஜீவா பத்தாண்டுகளுக்கு மேல் கொடுஞ்சிறை வாழ்வை அனுபவித்தார்."}, "en": {"blocks": [{"type": "text", "content": "How many years of harsh imprisonment and exile did Comrade Jeeva endure for freedom and labor rights?", "media_id": null}], "options": {"A": "2 years", "B": "5 years", "C": "Over 10 years of rigorous imprisonment and external exile", "D": "Never went to prison"}, "explanation": "He endured over a decade of prison sentences and banishments under colonial and post-colonial regimes."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "e