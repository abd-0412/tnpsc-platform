{"id": "11th_tamil_u7_q034", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "jeeva_socialist_singing", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தோழர் ஜீவா தாமே பல புரட்சிகரப் பாடல்களை எழுதிப் பாடியுள்ளார். அவரது கவிதைகள் எவ்வகையான உணர்வை ஊட்டின?", "media_id": null}], "options": {"A": "தனிநபர் துதி", "B": "தொழிலாளர் ஒற்றுமை, சாதி ஒழிப்பு, சமதர்ம சமுதாய உருவாக்கம் மற்றும் விடுதலை வேட்கை", "C": "மதவாத வெறி", "D": "சுயநல உணர்வு"}, "explanation": "ஜீவாவின் பாடல்கள் சமதர்மம், தீண்டாமை ஒழிப்பு, பாட்டாளி வர்க்க ஒற்றுமை ஆகியவற்றை வலியுறுத்தும் போர்க்குரலாக ஒலித்தன."}, "en": {"blocks": [{"type": "text", "content": "Comrade Jeeva composed and sang many revolutionary lyrics. What spirit did his verses instill?", "media_id": null}], "options": {"A": "Individual sycophancy", "B": "Worker solidarity, abolition of caste, socialist society, and anti-imperialist freedom", "C": "Communal fanaticism", "D": "Selfish individualism"}, "explanation": "His songs rallied working-class solidarity and anti-feudal social justice."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edi