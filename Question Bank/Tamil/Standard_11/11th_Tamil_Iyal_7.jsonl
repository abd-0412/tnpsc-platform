{"id": "11th_tamil_u7_q133", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "supplementary_natakakkalai", "chapter_id": null, "topic_id": "theatre_elements_three", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாடகக் கலையின் இன்றியமையாத மூன்று முதன்மைக் கூறுகள் எவை?", "media_id": null}], "options": {"A": "நாடகப் பிரதி (உரை/கதை), நடிகர்கள் (அரங்கு), பார்வையாளர்கள் (ரசிகர்கள்)", "B": "ஒலிபெருக்கி, விளக்கு, திரைச்சீலை", "C": "டிக்கெட், மண்டபம், நாற்காலி", "D": "இசைக்கருவிகள் மட்டுமே"}, "explanation": "நாடகக் கலை முழுமை பெறுவதற்கு நாடக உரை (கதை), அதனை நடித்துக் காட்டும் நடிகர்கள், அதனை உணர்ந்து சுவைக்கும் பார்வையாளர்கள் ஆகிய மூன்றும் அவசியமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What constitute the three indispensable constitutive elements of dramatic art?", "media_id": null}], "options": {"A": "Play text (script), Actors (stage), and Audience (spectators)", "B": "Microphone, spotlight, and curtain", "C": "Tickets, auditorium, chairs", "D": "Orchestra only"}, "explanation": "The playwright's script, performing actors, and receptive audience are the trinity of drama."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term"