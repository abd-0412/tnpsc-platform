{"id": "11th_tamil_u7_q004", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "jeeva_oratory_style", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தோழர் ஜீவாவின் மேடைப் பேச்சின் தனித்துவமான ஆற்றல் எத்தகையது எனச் சுந்தர ராமசாமி வியந்து போற்றுகிறார்?", "media_id": null}], "options": {"A": "அமைதியாகப் படித்துச் செல்வது", "B": "ஆங்கிலச் சொற்களை அதிகம் பயன்படுத்துவது", "C": "சிறு கூட்டங்களில் மட்டுமே பேசுவது", "D": "கம்பீரமான குரல்வளத்தோடு, பாரதியின் கவிதைகளையும் பாமரர்களின் உணர்வுகளையும் தட்டி எழுப்பி மணித்துளிக் கணக்கில் கூட்டத்தை மெய்மறக்க வைக்கும் வசீகரப் பேச்சாற்றல்"}, "explanation": "ஜீவாவின் பேச்சு பாமர மக்களையும் சிந்திக்க வைக்கும் கவித்துவமும், பாரதியின் கவிதை முழக்கமும், அனல் பறக்கும் வாதத் திறமையும் கொண்ட பேரோசையாக விளங்கியது."}, "en": {"blocks": [{"type": "text", "content": "How does Sundara Ramasamy depict the peerless charismatic oratory of Comrade Jeeva?", "media_id": null}], "options": {"A": "Subdued manuscript reading", "B": "Frequent English jargon", "C": "Speaking to tiny intimate gatherings only", "D": "Majestic resonance, reciting Bharathi with fiery conviction, mesmerizing massive crowds for hours"}, "explanation": "Jeeva's speeches were electrifying torrents blending Bharathi's verses with socialist passion."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 