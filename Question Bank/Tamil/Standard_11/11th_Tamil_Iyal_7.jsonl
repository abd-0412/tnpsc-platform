{"id": "11th_tamil_u7_q043", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "jeeva_books_nationalized", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தோழர் ஜீவாவின் படைப்புகள் எந்த ஆண்டு தமிழக அரசால் நாட்டுடைமை ஆக்கப்பட்டன?", "media_id": null}], "options": {"A": "1985", "B": "1990", "C": "2007 (நூற்றாண்டு விழாவின் போது)", "D": "2015"}, "explanation": "ஜீவாவின் நூற்றாண்டு விழாவையொட்டி 2007-இல் அவரது நூல்கள் அனைத்தும் தமிழக அரசால் நாட்டுடைமை ஆக்கப்பட்டுப் பொதுமக்களுக்கு வழங்கப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "In which year were Comrade Jeeva's literary works nationalized by the Government of Tamil Nadu?", "media_id": null}], "options": {"A": "1985", "B": "1990", "C": "2007 (on his centenary)", "D": "2015"}, "explanation": "His literary corpus was nationalized by the Tamil Nadu Government in 2007."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 150, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 150", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false,