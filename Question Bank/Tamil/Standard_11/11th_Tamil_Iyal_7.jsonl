{"id": "11th_tamil_u7_q044", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "jeeva_family_hardship", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜீவாவின் குடும்பப் பொருளாதார நிலை அவரது இறுதிக்காலம் வரை எவ்வாறு நீடித்தது?", "media_id": null}], "options": {"A": "மிகப்பெரும் கோடீஸ்வரராக வாழ்ந்தார்", "B": "அரண்மனை போன்ற மாளிகை வைத்திருந்தார்", "C": "பல நிறுவனங்களின் பங்குதாரராக இருந்தார்", "D": "மறைவு வரை ஒரு வாடகை வீட்டில், எவ்விதச் சொந்த சொத்தும் இன்றித் தூய வறுமையிலும் மன நிறைவோடும் வாழ்ந்தார்"}, "explanation": "ஜீவா பலமுறை சட்டமன்ற உறுப்பினராகவும், மாபெரும் தேசியத் தலைவராகவும் இருந்தபோதிலும் சொந்த வீடு கூட இன்றி எளிய வாடகை வீட்டிலேயே காலமானார்."}, "en": {"blocks": [{"type": "text", "content": "What was Comrade Jeeva's personal financial situation until his final breath?", "media_id": null}], "options": {"A": "Multi-millionaire", "B": "Owned lavish estates", "C": "Shareholder in corporate firms", "D": "Lived in an unassuming rented house without any private property, embracing noble poverty with profound contentment"}, "explanation": "He passed away in a small rented house, leaving behind no personal property or bank balance."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samachee