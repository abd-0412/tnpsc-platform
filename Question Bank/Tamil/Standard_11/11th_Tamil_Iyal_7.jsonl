{"id": "11th_tamil_u7_q090", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "fate_of_king", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மக்களின் மாபெரும் புரட்சிப் பேரெழுச்சியைக் கண்ட மன்னன் மதனமன்னன் என்ன செய்தான்?", "media_id": null}], "options": {"A": "மக்களை எதிர்த்துப் போரிட்டு வென்றான்", "B": "மக்களின் பேராற்றலுக்கு அஞ்சி, முடிதுறந்து நாட்டை விட்டு ஓடினான் (மன்னராட்சி வீழ்ந்தது)", "C": "உதாரனைக் கொன்றான்", "D": "அமுதவல்லியைச் சிறையிலிட்டான்"}, "explanation": "மக்கள் வெள்ளத்தின் புரட்சிக்கு முன் நிற்க முடியாத மன்னன் அஞ்சி நடுங்கி மணிமுடியை இழந்து ஓடினான்; கொடுங்கோல் மன்னராட்சி முடிவுக்கு வந்தது."}, "en": {"blocks": [{"type": "text", "content": "Confronted by the tsunami of popular uprising, what fate befell King Madhanamannan?", "media_id": null}], "options": {"A": "Defeated the crowds in battle", "B": "Terrified by the people irresistible wrath, lost his crown and fled in disgrace (monarchy collapsed)", "C": "Executed Udharan", "D": "Imprisoned Amuthavalli"}, "explanation": "The tyrant fled in terror, bringing an end to monarchical rule."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation",