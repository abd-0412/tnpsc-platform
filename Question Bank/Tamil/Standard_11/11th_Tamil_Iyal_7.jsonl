{"id": "11th_tamil_u7_q115", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_pathitrupathu", "chapter_id": null, "topic_id": "poet_endowment_gift", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரண்டாம் பத்தைப் பாடிய குமட்டூர்க் கண்ணனாருக்கு இமயவரம்பன் நெடுஞ்சேரலாதன் வழங்கிய அளப்பரிய கொடை யாது?", "media_id": null}], "options": {"A": "100 பொற்காசுகள் மட்டுமே", "B": "ஒரு யானைப்படை", "C": "உம்பற்காட்டு 500 ஊர்களையும், தென்னாட்டு வருவாயில் பாதியையும் (500 ஊர்கள் மற்றும் 38 ஆண்டு வருவாய் பாகம்)", "D": "தன் மணிமுடி"}, "explanation": "இமயவரம்பன் நெடுஞ்சேரலாதன் குமட்டூர்க் கண்ணனாருக்கு உம்பற்காட்டில் 500 ஊர்களையும், தென்னாட்டு வருவாயில் பாதியையும் பரிசாக வழங்கிச் சிறப்பித்தான்."}, "en": {"blocks": [{"type": "text", "content": "What lavish royal bounty did King Imayavaramban Neduncheralathan grant to poet Kumattur Kannanar?", "media_id": null}], "options": {"A": "100 gold coins only", "B": "An elephant brigade", "C": "500 villages in Umbarkkadu and half the royal revenues of the southern realm for 38 years", "D": "His crown"}, "explanation": "He endowed 500 villages in Umbarkkadu and half the southern realm revenues."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Co