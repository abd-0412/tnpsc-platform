{"id": "11th_tamil_u7_q022", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "jeeva_youth_education", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜீவா பள்ளிப் பருவத்திலேயே எதில் அதிக ஈடுபாடு கொண்டு விளங்கினார்?", "media_id": null}], "options": {"A": "விளையாட்டில் மட்டுமே", "B": "தமிழ் இலக்கியம், கவிதை எழுதுதல் மற்றும் சொற்பொழிவாற்றுவதில்", "C": "வணிகக் கணக்குகளில்", "D": "அரசுப் பணிகளில்"}, "explanation": "ஜீவா தம் இளமைப் பருவத்திலேயே சிறந்த தமிழ் ஆர்வமும், கவிதை எழுதும் ஆற்றலும், கம்பீரமாகப் பேசும் திறமையும் பெற்றுத் திகழ்ந்தார்."}, "en": {"blocks": [{"type": "text", "content": "In which pursuits was young Jeeva deeply immersed during his school days?", "media_id": null}], "options": {"A": "Athletics only", "B": "Tamil literature, writing poetry, and public speaking", "C": "Commercial accounting", "D": "Civil service"}, "explanation": "From his school years, Jeeva excelled in classical Tamil literature, poetry, and debate."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 148, "chapter": null, "section": null, "reference": "11