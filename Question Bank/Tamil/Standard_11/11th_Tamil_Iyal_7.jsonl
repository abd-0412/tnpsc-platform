{"id": "11th_tamil_u7_q054", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "sundara_ramasamy_death_year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எழுத்தாளர் சுந்தர ராமசாமி மறைந்த ஆண்டு எது?", "media_id": null}], "options": {"A": "2000", "B": "2005 (அக்டோபர் 15)", "C": "2010", "D": "2015"}, "explanation": "சுந்தர ராமசாமி 1931-இல் பிறந்து, 2005 அக்டோபர் 15 அன்று அமெரிக்காவில் சிகிச்சை பலனின்றி மறைந்தார்."}, "en": {"blocks": [{"type": "text", "content": "In which year did writer Sundara Ramasamy pass away?", "media_id": null}], "options": {"A": "2000", "B": "2005 (October 15)", "C": "2010", "D": "2015"}, "explanation": "Sundara Ramasamy passed away on October 15, 2005."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 148, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 148", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "U