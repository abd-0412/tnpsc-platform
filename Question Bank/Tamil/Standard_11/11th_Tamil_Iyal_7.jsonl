{"id": "11th_tamil_u7_q166", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "grammar_aakkappeyarkal", "chapter_id": null, "topic_id": "tamil_tradition_vs_slang", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆக்கப்பெயர்கள் ஆக்கப்படும் போது கடைப்பிடிக்க வேண்டிய நெறிகளில் தவறான கூற்றைத் தேர்ந்தெடுக்க:", "media_id": null}], "options": {"A": "பொருத்தமான தமிழ் வினையடிகளுடனும் பெயர்ச்சொற்களுடனும் மட்டுமே விகுதிகள் சேர்க்கப்பட வேண்டும்", "B": "எந்த வேற்றுமொழிச் சொல்லுடனும் விருப்பம்போல ஆக்க விகுதிகளைச் சேர்த்துத் தமிழ்ச்சொல்லாக்கலாம்", "C": "சொல்லமைப்பில் தமிழின் ஒலிப்புமுறை மற்றும் இலக்கணப் புணர்ச்சி விதிகள் மீறப்படக் கூடாது", "D": "பொருளுணர்த்தும் திறன் துல்லியமாகவும் எளிமையாகவும் இருக்க வேண்டும்"}, "explanation": "ஆக்கப்பெயர் உருவாக்கத்தில் வேற்றுமொழிச் சொற்களுடன் தாறுமாறாக விகுதிகளைச் சேர்ப்பது (எ.கா: பில்லுக்காரன், பஸ்சுக்காரன் போன்றவை பேச்சுவழக்கே தவிர) தூய கலைச்சொல்லாக்க நெறியாகாது; மரபார்ந்த தமிழ் வேர்களிலிருந்தே உருவாக்கப்பட வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the FALSE statement concerning the principles of coining derivative nouns in standard Tamil:", "media_id": null}], "options": {"A": "Suffixes must attach organically to appropriate Tamil verbal roots and noun stems", "B": "Formative suffixes may be indiscriminately appended to any foreign loanwords to create standard vocabulary", "C": "Phonotactic and morphophonemic rules of Tamil must be strictly preserved", "D": "Semantic precision and conceptual clarity must be upheld"}, "explanation": "Indiscriminate attachment to foreign slang undermines morphological purity; native stems are preferred."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 164, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 164", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Grammar", "Aakkappeyarkal"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u7_q167", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "grammar_aakkappeyarkal", "chapter_id": null, "topic_id": "plural_aakkappeyar_gal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆக்கப்பெயர்கள் பன்மை உருபேற்கும் பொழுது எவ்வாறு வடிவம் பெறுகின்றன? (எ.கா: தொழிலாளி)", "media_id": null}], "options": {"A": "தொழிலாளிகள் மட்டுமே", "B": "தொழிலாளர்கள் மட்டுமே", "C": "தொழிலாளிகள் அல்லது தொழிலாளர்கள் எனப் பன்மை விகுதிகளை ஏற்றுப் பலர்பால்/அஃறிணைப் பன்மையாக மாறும்", "D": "பன்மை விகுதியை ஏற்காது"}, "explanation": "தொழிலாளி + கள் = தொழிலாளிகள்; தொழிலாளர் + கள் = தொழிலாளர்கள் என ஆக்கப்பெயர்கள் பன்மை உருபுகளை ஏற்று வழங்கி வருகின்றன."}, "en": {"blocks": [{"type": "text", "content": "How do derivative nouns inflect when acquiring plural suffixes? (e.g., Thozhilaali):", "media_id": null}], "options": {"A": "Thozhilaaligal exclusively", "B": "Thozhilaalargal exclusively", "C": "Taking plural morphemes as either Thozhilaaligal or Thozhilaalargal", "D": "They cannot accept plural endings"}, "explanation": "Derivative nouns readily take plural markers such as -gal or -ar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 163, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 163", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Grammar", "Aakkappeyarkal"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u7_q168", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "grammar_aakkappeyarkal", "chapter_id": null, "topic_id": "aakkappeyar_summary_match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்காணும் தொடர்களில் 'ஆக்கப்பெயர்' இடம்பெறாத தொடரைக் கண்டறிக:", "media_id": null}], "options": {"A": "பயிற்சிப் பணியகத்தில் கூட்டம் நடைபெற்றது", "B": "நூலகத்தில் நல்ல நூல்கள் உள்ளன", "C": "பேருந்து நடத்துநர் பயணச்சீட்டு வழங்கினார்", "D": "மரம் செழித்து வளர்ந்து பூத்துக் குலுங்கியது"}, "explanation": "'பணியகம்', 'நூலகம்', 'நடத்துநர்' ஆகியவை ஆக்கப்பெயர்கள். 'மரம் செழித்து வளர்ந்து...' என்ற தொடரில் எந்த ஆக்கப்பெயரும் இடம்பெறவில்லை (மரம் என்பது இடுகுறிப் பெயர்ச்சொல்)."}, "en": {"blocks": [{"type": "text", "content": "Identify the sentence that does NOT contain a derivative noun:", "media_id": null}], "options": {"A": "Meeting took place in the training bureau (Panniyaham)", "B": "Good books exist in the library (Noolaham)", "C": "Bus conductor (Nadathunar) issued tickets", "D": "The tree flourished and blossomed lushly"}, "explanation": "Sentence D contains native root words (Maram) without any derivative suffixations."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Ser