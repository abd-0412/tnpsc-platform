{"id": "11th_tamil_u7_q117", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_pathitrupathu", "chapter_id": null, "topic_id": "anthathi_poetic_feature", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பதிற்றுப்பத்தின் இரண்டாம் பத்தில் அமைந்துள்ள அனைத்துப் பாடல்களும் எவ்வகைத் தொடை அமைப்பால் தொடுக்கப்பட்டுள்ளன?", "media_id": null}], "options": {"A": "அந்தாதித் தொடை (முந்தைய பாடலின் இறுதிச் சீர் அடுத்த பாடலின் தொடக்கமாக வருவது)", "B": "முரண் தொடை மட்டுமே", "C": "இயைபுத் தொடை மட்டுமே", "D": "எதுகைத் தொடை அற்றவை"}, "explanation": "இரண்டாம் பத்தின் சிறப்பம்சம் என்னவெனில், அதன் பத்து பாடல்களும் ஒன்றன்பின் ஒன்றாக 'அந்தாதித் தொடை' அமைப்பில் பாடப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "What distinctive poetic device connects all the verses of the Second Decade of Pathitrupathu?", "media_id": null}], "options": {"A": "Anthathi Thodai (anadiplosis: the concluding foot of one song begins the next)", "B": "Muran rhyme exclusively", "C": "Iyaibu end-rhyme only", "D": "Lacking all rhymes"}, "explanation": "The verses of the Second Decade are linked through the Anthathi device."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11",