{"id": "11th_tamil_u7_q165", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "grammar_aakkappeyarkal", "chapter_id": null, "topic_id": "suffix_combination_analysis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தோட்டக்காரி' என்ற ஆக்கப்பெயரின் பகுப்பாய்வு எது?", "media_id": null}], "options": {"A": "தோட்டம் (பெயர்) + க் + காரி (பெண்பால் ஆக்க விகுதி)", "B": "தோட்டம் + ஆரி", "C": "தோட்ட + கரி", "D": "தோட்டம் + இ"}, "explanation": "தோட்டம் என்னும் பெயர்ச்சொல்லுடன் '-காரி' என்ற பெண்பால் ஆக்கப்பெயர் விகுதி சேர்ந்து 'தோட்டக்காரி' என உருவானது."}, "en": {"blocks": [{"type": "text", "content": "What is the structural breakdown of the feminine derivative noun 'Thottakkari'?", "media_id": null}], "options": {"A": "Thottam (noun) + k + kari (feminine agentive suffix)", "B": "Thottam + aari", "C": "Thotta + kari", "D": "Thottam + i"}, "explanation": "Thottam + kari = Thottakkari (female gardener)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 162, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 162", "url": null, "source_notes": null}, "previous_year": {"is_previous_