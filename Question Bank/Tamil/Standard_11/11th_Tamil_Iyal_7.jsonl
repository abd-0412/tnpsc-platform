{"id": "11th_tamil_u7_q039", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "jeeva_memorial_stamp", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்திய அரசு தோழர் ஜீவாவின் பொதுத்தொண்டைப் பாராட்டி எந்த ஆண்டு சிறப்பு அஞ்சல் தலை வெளியிட்டது?", "media_id": null}], "options": {"A": "1990", "B": "1995", "C": "2007 (ஜீவாவின் நூற்றாண்டு விழா நினைவு அஞ்சல் தலை)", "D": "2015"}, "explanation": "ஜீவாவின் நூற்றாண்டு விழாவையொட்டி இந்திய அரசு 2007 ஆகஸ்ட் 21 அன்று அவரது நினைவாக அஞ்சல் தலையை வெளியிட்டுச் சிறப்பித்தது."}, "en": {"blocks": [{"type": "text", "content": "In which year did the Government of India issue a commemorative postage stamp honoring Comrade Jeeva?", "media_id": null}], "options": {"A": "1990", "B": "1995", "C": "2007 (Centenary commemorative postage stamp)", "D": "2015"}, "explanation": "A commemorative postal stamp was released on his birth centenary in 2007."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 150, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 150", "url": null, "source_notes": null