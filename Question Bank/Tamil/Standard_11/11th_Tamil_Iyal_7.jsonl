{"id": "11th_tamil_u7_q157", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "grammar_aakkappeyarkal", "chapter_id": null, "topic_id": "aakkappeyar_spotting", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்காணும் வாக்கியத்தில் இடம்பெற்றுள்ள ஆக்கப்பெயரைக் கண்டறிக:\n'அரசுப் பேருந்து ஓட்டுநர் கவனமுடன் வாகனத்தைச் செலுத்தினார்.'", "media_id": null}], "options": {"A": "ஓட்டுநர்", "B": "பேருந்து", "C": "கவனமுடன்", "D": "செலுத்தினார்"}, "explanation": "இவ்வாக்கியத்தில் 'ஓட்டு' என்ற வினையுடன் 'நர்' என்ற ஆக்க விகுதி சேர்ந்து உருவான 'ஓட்டுநர்' என்பதே ஆக்கப்பெயராகும்."}, "en": {"blocks": [{"type": "text", "content": "Spot the derivative noun in the sentence:\n'The state transport bus driver (Ottunar) steered the vehicle with vigilance.'", "media_id": null}], "options": {"A": "Ottunar", "B": "Paerunthu", "C": "Kavanmudan", "D": "Seluthinaar"}, "explanation": "'Ottunar' (driver) is the derivative noun formed from root 'Ottu' + suffix 'nar'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 162, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 162", "url": null, "source_not