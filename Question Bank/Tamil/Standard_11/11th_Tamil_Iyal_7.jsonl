{"id": "11th_tamil_u7_q135", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "supplementary_natakakkalai", "chapter_id": null, "topic_id": "street_theatre_therukoothu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழகத்தின் கிராமப்புறங்களில் விடிய விடிய மக்கள் முன்னிலையில் ஆடப்படும் தொன்மையான நாடகக் கலை வடிவம் எது?", "media_id": null}], "options": {"A": "கரகாட்டம்", "B": "ஒயிலாட்டம்", "C": "தெருக்கூத்து (மகாபாரதக் கூத்து)", "D": "காவடியாட்டம்"}, "explanation": "தெருக்கூத்து தமிழகத்தின் மிகத் தொன்மையான பாரம்பரிய நாடகக் கலையாகும்; திறந்தவெளி அரங்கில் விடிய விடிய மகாபாரதக் கதைகளை மக்கள் முன்னிலையில் நிகழ்த்துவர்."}, "en": {"blocks": [{"type": "text", "content": "Which traditional folk theatrical art is performed overnight in open rural squares across Tamil Nadu?", "media_id": null}], "options": {"A": "Karakattam", "B": "Oyilaattam", "C": "Therukkoothu (Street Theater / Mahabharata Koothu)", "D": "Kavadiyaattam"}, "explanation": "Therukkoothu is the vibrant traditional street theater of rural Tamil Nadu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 155, "chapter": null, "section"