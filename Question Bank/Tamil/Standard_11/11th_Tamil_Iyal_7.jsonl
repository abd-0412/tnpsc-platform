{"id": "11th_tamil_u7_q040", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "sundara_ramasamy_quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஜீவாவை ஒருமுறை நேரில் பார்த்தவர்கள், அவரது கம்பீரப் பேச்சைக் கேட்டவர்கள் ஒருபோதும் அவரை மறக்க முடியாது' எனச் சுந்தர ராமசாமி குறிப்பிடுவது எதனைக் காட்டுகிறது?", "media_id": null}], "options": {"A": "ஜீவாவின் பயமுறுத்தும் தோற்றத்தை", "B": "அரசியல் சண்டையை", "C": "விடுதிச் செலவை", "D": "ஜீவாவின் ஆளுமையின் ஈர்ப்பு விசையையும், அவர் மனித உள்ளங்களில் ஏற்படுத்திய ஆழமான ஆன்மீக-சமூகத் தாக்கத்தையும்"}, "explanation": "ஜீவாவின் தூய அன்பு, எளிமை, பேச்சாற்றல் ஆகியவை ஒருவரை வாழ்நாள் முழுவதும் கவர்ந்திழுக்கும் பேரிலக்கிய ஈர்ப்பாக அமைந்ததை இது காட்டுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What does Sundara Ramasamy's observation 'Whoever saw Jeeva in person could never forget him' demonstrate?", "media_id": null}], "options": {"A": "His intimidating physique", "B": "Political disputes", "C": "Hostel expenditure", "D": "The indelible magnetic charisma of Jeeva and the profound transformative imprint he cast upon human souls"}, "explanation": "It testifies to his unforgettable moral magnetism and radiant human warmth."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "