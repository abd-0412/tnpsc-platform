{"id": "11th_tamil_u7_q089", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "people_declaration", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மக்கள் திரண்டு அரசன் மதனமன்னனைப் பார்த்து விடுத்த இறுதி எச்சரிக்கை யாது?", "media_id": null}], "options": {"A": "\"மன்னனே! எங்கள் கவிஞனையும் உன் அன்பு மகளையும் தொடாதே; இந்நாடு உனக்குரியதல்ல, இது மக்களுக்குரியது!\"", "B": "\"வரிப்பணத்தைக் குறைக்க வேண்டும்\"", "C": "\"அரண்மனையை மாற்ற வேண்டும்\"", "D": "\"புதிய அமைச்சரை நியமிக்க வேண்டும்\""}, "explanation": "மக்கள் மன்னனை நோக்கி, 'இந்நாடு ஒரு தனிமனிதனின் உடைமை அல்ல; தமிழ்க் கவிஞனைக் கொல்லும் அதிகாரம் உனக்கில்லை' என எச்சரித்தனர்."}, "en": {"blocks": [{"type": "text", "content": "What final ultimatum did the risen multitude declare to King Madhanamannan?", "media_id": null}], "options": {"A": "\"Monarch! Lay not a finger on our poet and your noble daughter; this realm belongs not to you, but to the sovereign people!\"", "B": "\"Reduce taxes\"", "C": "\"Relocate the palace\"", "D": "\"Appoint a new minister\""}, "explanation": "They warned that sovereignty resided with the people, not the monarch."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook 