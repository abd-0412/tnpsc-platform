{"id": "11th_tamil_u7_q085", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "udharan_execution_ground", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கொலைக்களத்தில் வேட்டுவன் வாள்தூக்கி நிற்கும் வேளையில், உதாரன் மன்னனைப் பாராது யாரை நோக்கித் தன் இறுதி உரையை ஆற்றுகிறான்?", "media_id": null}], "options": {"A": "திரண்டு நின்ற தன் அன்புத் தமிழ் மக்களையும் நாட்டு மக்களையும் நோக்கி", "B": "மன்னனின் காலில் விழுந்து மன்றாடினான்", "C": "அமைச்சரிடம் மட்டும் பேசினான்", "D": "மௌனமாகத் தலைகுனிந்து நின்றான்"}, "explanation": "உதாரன் மன்னனைப் பொருட்படுத்தாது, தன்னைச் சூழ்ந்து நின்ற பாமரத் தமிழ் மக்களை நோக்கித் தன் கம்பீரமான விடைபெறும் புரட்சி உரையை நிகழ்த்துகிறான்."}, "en": {"blocks": [{"type": "text", "content": "At the execution site with the headsman sword poised, to whom does Udharan address his defiant farewell address?", "media_id": null}], "options": {"A": "Directly to his beloved assembled Tamil citizens and commoners", "B": "Begged at the king feet", "C": "Spoke to the minister only", "D": "Stood in bowed silence"}, "explanation": "Udharan addresses the assembled common folk, bypassing the tyrant king."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil 