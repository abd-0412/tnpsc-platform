{"id": "11th_tamil_u7_q038", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "jeeva_literary_criticism_method", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜீவா முன்னெடுத்த இலக்கியத் திறனாய்வு முறை எத்தகையது?", "media_id": null}], "options": {"A": "மரபை முற்றிலும் தூக்கி எறிவது", "B": "பழைய செவ்வியல் மரபின் நற்குணங்களைப் போற்றிப் பாதுகாத்து, முற்போக்குச் சிந்தனைகளை இணைக்கும் வரலாற்றுப் பொருள்முதல்வாதத் திறனாய்வு", "C": "மேற்கத்திய பாப் பாணியை அப்படியே ஏற்பது", "D": "இலக்கணங்களை மட்டுமே பார்ப்பது"}, "explanation": "ஜீவா சிலப்பதிகாரம், கம்பராமாயணம், திருக்குறள் போன்ற மரபிலக்கியங்களின் அழகியலை மதித்து, அதனோடு உழைக்கும் மக்கள் சார்பான முற்போக்குக் கருத்துகளை இணைத்தார்."}, "en": {"blocks": [{"type": "text", "content": "What characterized Comrade Jeeva's method of literary criticism?", "media_id": null}], "options": {"A": "Total rejection of classical heritage", "B": "Historical materialist criticism synthesizing the humanist treasures of classical lore with progressive socialist aesthetics", "C": "Blind imitation of western pop", "D": "Narrow grammatical parsing"}, "explanation": "He synthesized the ethical grandeur of classical Tamil literature with Marxist aesthetics."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "