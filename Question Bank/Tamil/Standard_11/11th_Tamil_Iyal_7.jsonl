{"id": "11th_tamil_u7_q109", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "amuthavalli_scaffold_speech", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அமுதவல்லி கொலைக்களத்தில் நின்ற மக்களுக்கு விடுத்த உணர்ச்சிமிகு வேண்டுகோள் யாது?", "media_id": null}], "options": {"A": "\"என் உயிரைப் பற்றிக் கவலையில்லை; தமிழ்க் கவிஞனான உதாரனைக் காப்பாற்றுங்கள்!\"", "B": "\"மன்னனை மன்னியுங்கள்\"", "C": "\"நாட்டை விட்டு ஓடிவிடுங்கள்\"", "D": "\"போர் செய்யாதீர்கள்\""}, "explanation": "அமுதவல்லி மக்களிடம், 'என் உயிர் போனாலும் போகட்டும்; தமிழுக்கும் சமுதாயத்திற்கும் தேவையான புரட்சிக் கவிஞன் உதாரனின் உயிரைக் காத்திடுங்கள்' என வேண்டினாள்."}, "en": {"blocks": [{"type": "text", "content": "What stirring plea did Princess Amuthavalli direct to the citizens gathered at the scaffold?", "media_id": null}], "options": {"A": "\"Mourn not for my life; rise up and preserve the life of our supreme Tamil poet Udharan!\"", "B": "\"Forgive the king\"", "C": "\"Flee the nation\"", "D": "\"Refrain from resistance\""}, "explanation": "She urged the multitude to save the poet Udharan who embodied their voice."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Education