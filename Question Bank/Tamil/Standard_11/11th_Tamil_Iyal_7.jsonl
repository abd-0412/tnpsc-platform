{"id": "11th_tamil_u7_q033", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "jeeva_bharathi_centenary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியாரின் பெருமையை உலகறியச் செய்ய ஜீவா ஆற்றிய மாபெரும் பணி யாது?", "media_id": null}], "options": {"A": "பாரதி நினைவு நூற்றாண்டு மற்றும் விழாக்கள்தோறும் பாரதியின் கவிதைகளை எளிய மக்களிடம் கொண்டு சென்று \"பாரதி வழி\" காட்டியது", "B": "பாரதி நூல்களைத் தடை செய்யக் கோரியது", "C": "பாரதியை மட்டுமே விமர்சித்தது", "D": "பாரதியின் கவிதைகளை ஆங்கிலத்தில் மட்டும் மாற்றியது"}, "explanation": "பாரதியை ஒரு தேசியக் கவிஞராகவும், உலகளாவிய மக்கள் கவிஞராகவும் பாமரர்களிடம் கொண்டு சேர்த்ததில் ஜீவாவின் பங்கு வரலாற்று முக்கியத்துவம் வாய்ந்தது."}, "en": {"blocks": [{"type": "text", "content": "What monumental historic service did Comrade Jeeva render to Bharathiyar's legacy?", "media_id": null}], "options": {"A": "Carried Bharathi poetry to working-class masses through oratory and organized centenary commemorations", "B": "Advocated banning Bharathi poems", "C": "Criticized Bharathi exclusively", "D": "Translated Bharathi into English only"}, "explanation": "Jeeva was the foremost champion who embedded Bharathi into the hearts of Tamil working classes."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source":