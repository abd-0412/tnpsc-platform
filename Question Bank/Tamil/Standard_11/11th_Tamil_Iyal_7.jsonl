{"id": "11th_tamil_u7_q103", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "bharathidasan_song_state_anthem", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புதுச்சேரி அரசின் தமிழ்த்தாய் வாழ்த்துப் பாடலாக ஏற்றுக்கொள்ளப்பட்டுள்ள பாரதிதாசனின் பாடல் எது?", "media_id": null}], "options": {"A": "நீராரும் கடலுடுத்த (மனோன்மணீயம்)", "B": "செந்தமிழ் நாடெனும் போதினிலே", "C": "வாழ்வினில் செம்மையைச் செய்பவள் நீயே (புதுவை தமிழ்த்தாய் வாழ்த்து)", "D": "தமிழுக்கும் அமுதென்று பேர்"}, "explanation": "புதுச்சேரி அரசின் அதிகாரப்பூர்வத் தமிழ்த்தாய் வாழ்த்துப் பாடலாகப் பாரதிதாசன் இயற்றிய 'வாழ்வினில் செம்மையைச் செய்பவள் நீயே' என்னும் பாடல் விளங்கி வருகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which composition by Bharathidasan was adopted as the official State Anthem of Puducherry Government?", "media_id": null}], "options": {"A": "Neeraarum Kadaluduttha", "B": "Senthamizh Naadenum Pothinile", "C": "Vaazhvinil Semmaiyaic Cheybaval Neeye", "D": "Thamizhukkum Amuthendru Per"}, "explanation": "'Vaazhvinil Semmaiyaic Cheybaval Neeye' is the official invocation anthem of Puducherry."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 151, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 151", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Poetry", "Bharathidasan"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u7_q104", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "puratchikkavi_rhetoric_scaffold", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கொலைக்களத்தில் உதாரன் பேசும் கவிதைகளில் ஒலிக்கும் முதன்மையான முழக்கம் எத்தகையது?", "media_id": null}], "options": {"A": "மன்னனின் செங்கோல் வாழ்க", "B": "விதியை யாராலும் வெல்ல முடியாது", "C": "மௌனமே சிறந்தது", "D": "\"எங்கள் தமிழ் வாழ்க! எங்கள் மக்கள் உரிமை வாழ்க! சாதி குலங்களை மாய்ப்போம்! மனிதநேய சமதர்மம் மலர்க!\""}, "explanation": "உதாரனின் கொலைக்களப் பேச்சு தமிழின் மாண்பையும், உழைக்கும் மக்களின் சமத்துவ விடுதலையையும் முழங்கும் புரட்சிப் பிரகடனமாக அமைகிறது."}, "en": {"blocks": [{"type": "text", "content": "What supreme manifesto resonates through Udharan's scaffold verses?", "media_id": null}], "options": {"A": "Long live the royal sceptre", "B": "None can conquer fate", "C": "Silence is supreme", "D": "\"Long live glorious Tamil! Long live people freedom! Eradicate caste hierarchy! Let egalitarian socialist humanism bloom!\""}, "explanation": "His speech constitutes a soaring manifesto for human equality and linguistic pride."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 152, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 152", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Poetry", "Puratchikkavi"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u7_q105", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "bharathidasan_honors_universities", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருச்சிராப்பள்ளியில் அமைந்துள்ள தமிழகத்தின் முன்னணிப் பல்கலைக்கழகத்திற்கு யாருடைய பெயர் சூட்டப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "பாரதிதாசன் பல்கலைக்கழகம் (Bharathidasan University)", "B": "பாரதியார் பல்கலைக்கழகம்", "C": "அழகப்பா பல்கலைக்கழகம்", "D": "அண்ணா பல்கலைக்கழகம்"}, "explanation": "பாவேந்தர் பாரதிதாசனின் நினைவாகத் திருச்சிராப்பள்ளியில் உள்ள மாநிலப் பல்கலைக்கழகத்திற்குப் 'பாரதிதாசன் பல்கலைக்கழகம்' எனப் பெயரிடப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Which major state university in Tiruchirappalli is named in honor of Paventhar Bharathidasan?", "media_id": null}], "options": {"A": "Bharathidasan University", "B": "Bharathiar University", "C": "Alagappa University", "D": "Anna University"}, "explanation": "Bharathidasan University in Tiruchirappalli commemorates the poet."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 151, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 151", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Poetry", "Bharathidasan"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u7_q106", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "puratchikkavi_meter_sound", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கொலைக்களக் காட்சியில் பாரதிதாசன் கையாண்டுள்ள சந்த நடையின் உணர்ச்சி எத்தகையது?", "media_id": null}], "options": {"A": "தாலாட்டுப் பாடும் அமைதியான நடை", "B": "போர்க்கள முரசு முழங்குவது போன்ற வேகமும் அனலும் தெறிக்கும் வீர உணர்ச்சி நடை", "C": "அழுகை நடை", "D": "சந்தேக நடை"}, "explanation": "பாவேந்தரின் சந்த நடை போர்க்கள முரசொலி போலவும், எரிமலை வெடிப்பது போலவும் வேகமும் வீர உணர்ச்சியும் ததும்பும் வண்ணம் அமைந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "What emotional cadence does Bharathidasan's rhythmic meter evoke in the scaffold scene?", "media_id": null}], "options": {"A": "Lullaby tranquility", "B": "Roaring cadence resonant like battle drums and volcanic upheaval charged with heroic passion", "C": "Lamentation", "D": "Hesitant cadence"}, "explanation": "The tempo echoes the thunderous percussive fury of war drums."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 152, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 152", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Poetry", "Puratchikkavi"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u7_q107", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "bharathidasan_posthumous_title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதிதாசன் தம் கவிதைகளில் பெண்களின் முன்னேற்றத்திற்காகப் பாடிய புகழ்பெற்ற வரிகள் எவை?", "media_id": null}], "options": {"A": "பெண்கள் சமைக்க மட்டுமே பிறந்தவர்கள்", "B": "பெண்கள் வீட்டை விட்டு வெளியேறலாகாது", "C": "\"கல்வி இல்லாத பெண்கள் களர்நிலம்... கல்வி கற்ற பெண்கள் பண்பட்ட நிலம்\"", "D": "பெண்களுக்குச் சொத்துரிமை தேவையில்லை"}, "explanation": "பாரதிதாசன் பெண்கல்வியின் இன்றியமையாமையை வலியுறுத்தி, 'கல்வி இல்லாத பெண்கள் பண்படாத களர்நிலம் போன்றவர்கள்; கல்வி கற்ற பெண்களே திருந்திய நிலம்' எனப் பாடினார்."}, "en": {"blocks": [{"type": "text", "content": "Which famous lines were composed by Bharathidasan championing female education?", "media_id": null}], "options": {"A": "Women are meant only for cooking", "B": "Women should never step outside", "C": "\"Uneducated women are like barren alkaline soil... Educated women are fertile cultivated earth\"", "D": "Women need no property"}, "explanation": "He famously declared that uneducated women are barren soil, whereas educated women are fertile earth."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 151, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 151", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Poetry", "Bharathidasan"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u7_q108", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "puratchikkavi_overall_message", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'புரட்சிக்கவி' குறுங்காவியம் தரும் ஒட்டுமொத்தப் புரட்சிகரச் செய்தி யாது?", "media_id": null}], "options": {"A": "மன்னர்களின் பெருமை", "B": "காதல் தோல்வியடைய வேண்டும்", "C": "அதிகாரத்திற்கு அஞ்ச வேண்டும்", "D": "மக்களின் ஒற்றுமையே பேராற்றல்; மொழியுணர்வும் உண்மைக் காதலும் சமூக விடுதலையும் இணையும்போது எப்பேர்ப்பட்ட கொடுங்கோல் ஆட்சிகளும் சுக்குநூறாக உடைந்து மக்களாட்சி மலரும்"}, "explanation": "மக்கள் ஒன்றுபட்டு நின்றால் எத்தகைய எதேச்சதிகார அரசும் வீழ்ந்து மக்களாட்சி மலரும் என்பதை உணர்த்துவதே 'புரட்சிக்கவி'யின் மாறாத பேருண்மையாகும்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the ultimate revolutionary manifesto of the epic 'Puratchikkavi'?", "media_id": null}], "options": {"A": "Glorification of royalty", "B": "Love must perish", "C": "Submission to authority", "D": "Solidarity of the people is invincible; when linguistic pride, authentic love, and egalitarian aspiration unite, the mightiest despotisms crumble before democracy"}, "explanation": "It stands as an immortal testament to the invincible power of united sovereign people over autocracy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow