{"id": "11th_tamil_u7_q098", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "puratchikkavi_lines_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வாழ்விற்காக நான் அமுதவல்லியை விரும்பவில்லை; அமுதவல்லிக்காகவே என் உயிரையும் வாழ்வையும் தருகிறேன்' - உதாரனின் இவ்வார்த்தைகள் உணர்த்துவது யாது?", "media_id": null}], "options": {"A": "அரண்மனை ஆசை", "B": "தன்னலமற்ற தூய காதலின் உன்னத தியாக மாண்பு", "C": "பயந்த சுபாவம்", "D": "அரசியல் தந்திரம்"}, "explanation": "உதாரன் அமுதவல்லியின் அரச பதவியையோ செல்வத்தையோ விரும்பவில்லை; அவளது தூய ஆன்மாவை நேசித்ததால் உயிரையும் ஈயத் துணிகிறான்."}, "en": {"blocks": [{"type": "text", "content": "What does Udharan's declaration that he sought Amuthavalli not for personal gain but would lay down his life for her exemplify?", "media_id": null}], "options": {"A": "Craving for palace luxury", "B": "The noble supreme self-sacrifice of authentic, selfless love", "C": "Cowardice", "D": "Machiavellian cunning"}, "explanation": "It illustrates the selfless purity and sacrificial dignity of true love."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_yea