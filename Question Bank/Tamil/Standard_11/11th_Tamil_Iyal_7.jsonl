{"id": "11th_tamil_u7_q027", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "jeeva_compassion_cadre", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கட்சித் தொண்டர்கள் ஜீவாவை எவ்வாறு கண்டனர்?", "media_id": null}], "options": {"A": "அதிகாரம் செலுத்தும் எஜமானராக", "B": "அணுக முடியாத பெரிய மனிதராக", "C": "தங்கள் குடும்பத்தில் ஒருவராக, தந்தை போன்ற வழிகாட்டியாக, தோழராக", "D": "சம்பளம் தரும் முதலாளியாக"}, "explanation": "தொண்டர்கள் ஜீவாவைத் தங்களின் சொந்தக் குடும்பத் தலைவராகவும், பாசமிகு தோழராகவும், ஆன்ம வழிகாட்டியாகவும் போற்றினர்."}, "en": {"blocks": [{"type": "text", "content": "How did the grassroots cadre and workers perceive Comrade Jeeva?", "media_id": null}], "options": {"A": "An authoritarian boss", "B": "An aloof inaccessible celebrity", "C": "A member of their own family, a fatherly mentor, and loving comrade", "D": "A wage-paying employer"}, "explanation": "They revered him as an elder brother, father figure, and affectionate comrade."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 149, "chapter": null, "section": null, "r