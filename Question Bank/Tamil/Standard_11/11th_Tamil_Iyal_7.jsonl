{"id": "11th_tamil_u7_q112", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "puratchikkavi_part2_climax_summary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புரட்சிக்கவி காப்பியத்தின் இறுதி வெற்றியாக நிலைநிறுத்தப்படுவது எது?", "media_id": null}], "options": {"A": "அரண்மனைச் சட்டம்", "B": "காவலர்களின் வீரம்", "C": "மன்னனின் வாரிசு", "D": "அனைத்து மனிதர்களும் சமம் என்னும் குடியரசுத் தத்துவமும், பாமர மக்களின் ஜனநாயக இறையாண்மையும்"}, "explanation": "எந்த மனிதனும் பிறப்பால் உயர்ந்தவனோ தாழ்ந்தவனோ அல்லன்; மக்கள் அனைவரும் சம உரிமையுடைய குடிமக்களே என்னும் குடியரசுத் தத்துவத்தின் வெற்றியே புரட்சிக்கவியின் உச்சமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is enshrined as the supreme triumph at the climax of 'Puratchikkavi'?", "media_id": null}], "options": {"A": "Palace decrees", "B": "Sentry valor", "C": "Dynastic succession", "D": "The sovereign republican principle that all humans are born equal, establishing the democratic supremacy of the people"}, "explanation": "The eternal triumph of popular democratic sovereignty over despotic feudalism."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpora