{"id": "11th_tamil_u7_q066", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "king_wrath_sentence", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இருவரும் காதலிப்பதை அறிந்த மன்னன் மதனமன்னன் ஏழைப் புலவன் உதாரனுக்கு விதித்த தண்டனை யாது?", "media_id": null}], "options": {"A": "நாடுகடத்தல் தண்டனை", "B": "கொலைக்களத்தில் தலை துண்டித்துக் கொலை செய்ய வேண்டும் என்ற மரண தண்டனை", "C": "சிறைத்தண்டனை", "D": "அபராதம்"}, "explanation": "அரசிளங்குமரியை ஓர் ஏழைப் புலவன் காதலிக்கத் துணிந்ததா எனக் கடும் சினமுற்ற மன்னன், உதாரனைக் கொலைக்களத்தில் வைத்துத் தலை துண்டித்துக் கொல்ல ஆணையிட்டான்."}, "en": {"blocks": [{"type": "text", "content": "Upon discovering their love, what draconian punishment did King Madhanamannan inflict upon poet Udharan?", "media_id": null}], "options": {"A": "Exile from the kingdom", "B": "Capital punishment: beheading at the execution grounds", "C": "Life imprisonment", "D": "Monetary fine"}, "explanation": "Enraged by an impoverished poet courting royal royalty, he decreed public beheading."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-