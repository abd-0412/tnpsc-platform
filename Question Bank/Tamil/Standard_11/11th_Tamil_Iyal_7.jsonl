{"id": "11th_tamil_u7_q072", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "sahitya_akademi_bharathidasan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதிதாசனின் எந்த நாடக நூலுக்கு 1969-இல் சாகித்திய அகாதெமி விருது வழங்கப்பட்டது?", "media_id": null}], "options": {"A": "பாண்டியன் பரிசு", "B": "குடும்ப விளக்கு", "C": "இருண்ட வீடு", "D": "பிசிராந்தையார் (நாடக நூல்)"}, "explanation": "பாரதிதாசனின் மறைவுக்குப் பின் 1969-ஆம் ஆண்டு அவரது 'பிசிராந்தையார்' என்னும் வரலாற்று நாடக நூலுக்குச் சாகித்திய அகாதெமி விருது வழங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "For which dramatic work was Bharathidasan posthumously awarded the Sahitya Akademi Award in 1969?", "media_id": null}], "options": {"A": "Pandiyan Parisu", "B": "Kudumba Vilakku", "C": "Irunda Veedu", "D": "Pisiranthaiyar (Play)"}, "explanation": "His play 'Pisiranthaiyar' was awarded the Sahitya Akademi Award in 1969."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 151, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 151", "url": null