{"id": "11th_tamil_u7_q196", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "pyq_unit7", "chapter_id": null, "topic_id": "pyq_jeeva_bharathi_propagation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] பாரதியாரின் கவிதைகளையும் அவரது தேசபக்தி, விடுதலை, சமூக சமத்துவக் கருத்துகளையும் தமிழ்நாடு முழுவதும் பட்டிதொட்டியெங்கும் பாமர மக்களிடமும் முழங்கிப் பரப்பிய பெருமை யாருக்கு உண்டு?", "media_id": null}], "options": {"A": "வ. உ. சிதம்பரனார்", "B": "சுப்பிரமணிய சிவா", "C": "நாமக்கல் கவிஞர்", "D": "தோழர் ஜீவானந்தம்"}, "explanation": "பாரதியின் இலக்கியத்தை அடித்தட்டு உழைக்கும் மக்களிடம் கொண்டுசேர்த்துப் பாரதி விழாக்களையும் பாரதி வழியையும் தமிழகமெங்கும் வளர்த்தெடுத்தவர் தோழர் ப. ஜீவானந்தம் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Who holds the monumental credit of taking Mahakavi Bharathi's verses and revolutionary egalitarian ideals to grassroots rural masses across Tamil Nadu?", "media_id": null}], "options": {"A": "V. O. Chidambaranar", "B": "Subramania Siva", "C": "Namakkal Kavignar", "D": "Comrade Jeevanandham"}, "explanation": "Comrade Jeeva was instrumental in popularizing Bharathi's literature among working-class masses across Tamil Nadu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kal