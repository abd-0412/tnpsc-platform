{"id": "11th_tamil_u7_q031", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "janasakthi_newspaper", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியக் கம்யூனிஸ்ட் கட்சியின் அதிகாரப்பூர்வ நாளிதழான 'ஜனசக்தி' இதழின் நிறுவன ஆசிரியராகப் பணியாற்றியவர் யார்?", "media_id": null}], "options": {"A": "சிங்காரவேலர்", "B": "கல்யாணசுந்தரம்", "C": "தோழர் ப. ஜீவானந்தம்", "D": "ராமமூர்த்தி"}, "explanation": "1937-இல் தொடங்கப்பட்ட கம்யூனிஸ்ட் கட்சியின் நாளேடான 'ஜனசக்தி'யின் ஆசிரியராக இருந்து உழைக்கும் மக்களின் குரலாக ஒலித்தவர் ஜீவா ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who served as the founding editor of 'Janasakthi', the organ of the Communist Party launched in 1937?", "media_id": null}], "options": {"A": "Singaravelar", "B": "M. Kalyanasundaram", "C": "Comrade P. Jeevanandham", "D": "P. Ramamurthi"}, "explanation": "Comrade Jeeva was the founding editor of the working-class daily 'Janasakthi'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 150, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 150", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Prose", "Janasakthi"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u7_q032", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "jeeva_tagore_translation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரவீந்திரநாத் தாகூரின் நோபல் பரிசு பெற்ற எந்தப் புகழ்பெற்ற நூலைத் தோழர் ஜீவா தமிழில் மொழிபெயர்த்தார்?", "media_id": null}], "options": {"A": "கோரா", "B": "கபோலகல்பனா", "C": "தபால்காரன்", "D": "கீதாஞ்சலி (தாகூரின் கீதாஞ்சலி தமிழாக்கம்)"}, "explanation": "தோழர் ஜீவா இரவீந்திரநாத் தாகூரின் உலகப் புகழ்பெற்ற 'கீதாஞ்சலி' நூலைத் தமிழில் அழகுற மொழிபெயர்த்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which Nobel Prize-winning masterpiece of Rabindranath Tagore was translated into Tamil by Comrade Jeeva?", "media_id": null}], "options": {"A": "Gora", "B": "Kapalkundala", "C": "The Post Office", "D": "Gitanjali"}, "explanation": "Comrade Jeeva translated Tagore's 'Gitanjali' into Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 150, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 150", "url": null, "source_notes": null}, "previous_year": {"is_previous_ye