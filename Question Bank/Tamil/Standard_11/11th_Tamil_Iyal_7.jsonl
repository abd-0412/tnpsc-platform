{"id": "11th_tamil_u7_q120", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "supplementary_natakakkalai", "chapter_id": null, "topic_id": "theatre_sankaradas_swamigal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் நாடக மேடையின் 'தலைமை ஆசிரியர்' என்றும், தமிழ் நாடக உலகின் இமயமலை என்றும் போற்றப்படும் நாடகப் பேரறிஞர் யார்?", "media_id": null}], "options": {"A": "பம்மல் சம்பந்த முதலியார்", "B": "தி. க. சண்முகம்", "C": "நவாப் ராஜமாணிக்கம்", "D": "சங்கரதாஸ் சுவாமிகள் (1867 - 1922)"}, "explanation": "சங்கரதாஸ் சுவாமிகள் தமிழ் நாடகத் தலைமை ஆசிரியராகப் போற்றப்படுகிறார்; இவர் சிறுவர்களைக் கொண்டு 'பால விநோத சபா' உள்ளிட்ட நாடகக் குழுக்களை உருவாக்கித் தமிழ் நாடகத்திற்குப் புத்துயிர் ஊட்டினார்."}, "en": {"blocks": [{"type": "text", "content": "Who is venerated as the 'Thalaimai Aasiriyar' (Chief Patriarch/Headmaster) of the Tamil stage?", "media_id": null}], "options": {"A": "Pammal Sambandha Mudaliar", "B": "T. K. Shanmugam", "C": "Nawab Rajamanickam", "D": "Sankaradas Swamigal (1867-1922)"}, "explanation": "Sankaradas Swamigal is celebrated as the Chief Master of Tamil theatrical drama."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "te