{"id": "11th_tamil_u7_q013", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "ashram_life", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜீவா இளைஞராக இருந்தபோது சேரன்மாதேவி மற்றும் சிராவயல் ஆகிய இடங்களில் எங்குத் தங்கிச் சமூகத் தொண்டாற்றினார்?", "media_id": null}], "options": {"A": "காந்தி ஆசிரமம் (வ. வே. சு. ஐயர் ஆசிரமம் & காந்திஜி கொள்கைகள்)", "B": "மடாலயம்", "C": "அரண்மனை", "D": "வணிக வளாகம்"}, "explanation": "ஜீவா இளைஞராக இருந்தபோது வ. வே. சு. ஐயரின் சேரன்மாதேவி குருகுலத்திலும், பின்னர் சிராவயல் காந்தி ஆசிரமத்திலும் தங்கி ஏழை எளியோர்க்குக் கல்வி கற்பித்துத் தொண்டாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "In which ashrams did young Jeeva reside and serve the impoverished during his formative years?", "media_id": null}], "options": {"A": "Cheranmadevi Gurukulam of V. V. S. Iyer and Siravayal Gandhi Ashram", "B": "Monastery", "C": "Palace", "D": "Commercial guild"}, "explanation": "He stayed at Cheranmadevi and Siravayal ashrams, teaching underprivileged children."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "pag