{"id": "11th_tamil_u7_q156", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "grammar_aakkappeyarkal", "chapter_id": null, "topic_id": "suffix_ar_an", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வினையடியுடன் '-அன்' அல்லது '-அர்' சேர்ந்து ஆக்கப்பெயர் உருவாவதற்குச் சரியான எடுத்துக்காட்டைக் கண்டறிக:", "media_id": null}], "options": {"A": "நூலகம்", "B": "வண்டிக்காரன்", "C": "மருந்தகம்", "D": "கொல் + அன் = கொல்லன்; நெய் + அர் = நெசவர்"}, "explanation": "கொல் (வினை) + அன் = கொல்லன்; நெய் (வினை) + அர் = நெசவர் போன்றவை தொழிலைக் குறிக்கும் வினை ஆக்கப்பெயர்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the derivative noun formed by uniting a verbal root with the suffix '-an' or '-ar':", "media_id": null}], "options": {"A": "Noolaham", "B": "Vandikkaran", "C": "Marunthaham", "D": "Kollan (from Kol + an); Nesavar (from Ney + ar)"}, "explanation": "Kollan (blacksmith) and Nesavar (weaver) derive from the verbal roots kol and ney."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 163, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 163", "url": null,