{"id": "11th_tamil_u7_q153", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "grammar_aakkappeyarkal", "chapter_id": null, "topic_id": "suffix_identification_udan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கூட்டாளி' என்ற சொல்லில் இணைந்துள்ள ஆக்கப்பெயர் விகுதி யாது?", "media_id": null}], "options": {"A": "-ஆளி", "B": "-அளி", "C": "-ஆள்", "D": "-இ"}, "explanation": "கூட்டு + ஆளி = கூட்டாளி; இதில் இடம்பெற்றுள்ள ஆக்கப்பெயர் விகுதி '-ஆளி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What derivative suffix is present in the compound agentive noun 'Koottaali' (partner/associate)?", "media_id": null}], "options": {"A": "-aali", "B": "-ali", "C": "-aall", "D": "-i"}, "explanation": "Koottaali = Koottu + aali, where '-aali' is the operative formative suffix."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 163, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 163", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "i