{"id": "11th_tamil_u7_q086", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "udharan_speech_sentiment", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கொலைக்கள உரையில் உதாரன் தன் மரணம் குறித்து வெளிப்படுத்தும் உணர்வு யாது?", "media_id": null}], "options": {"A": "சாவைக் கண்டு அஞ்சி நடுங்குதல்", "B": "தான் மடிவது தனக்கல்ல; தமிழ் மக்களின் விடுதலைக்கும், மொழியின் மாண்பிற்கும், உண்மைக் காதலுக்கும் செய்யும் ஈகப்பலி என்ற பெருமிதம்", "C": "மன்னனை மன்னிக்குமாறு கெஞ்சுதல்", "D": "அழுது புலம்புதல்"}, "explanation": "உதாரன் 'நான் சாவதற்கு அஞ்சவில்லை; என் தமிழ் மொழிக்கும், என் அன்பு மக்களுக்கும், தூய காதலுக்கும் என் உயிரைத் தருவதில் பெருமிதம் கொள்கிறேன்' என முழங்குகிறான்."}, "en": {"blocks": [{"type": "text", "content": "What sentiment does Udharan express regarding his impending death at the scaffold?", "media_id": null}], "options": {"A": "Trembling with mortal terror", "B": "Sublime pride that his martyrdom is an offering for Tamil dignity, freedom of the people, and authentic love", "C": "Pleading for clemency", "D": "Weeping in agony"}, "explanation": "He proclaims that offering his life for Tamil and freedom is his supreme honor."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Ka