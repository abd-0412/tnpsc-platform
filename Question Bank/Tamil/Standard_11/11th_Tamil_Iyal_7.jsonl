{"id": "11th_tamil_u7_q159", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "grammar_aakkappeyarkal", "chapter_id": null, "topic_id": "suffix_karar_respect", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'-காரன்', '-காரி' என்ற விகுதிகளின் மரியாதைப் பன்மை வடிவமாகத் தற்காலத் தமிழில் வழங்கும் ஆக்கப்பெயர் விகுதி எது?", "media_id": null}], "options": {"A": "-மார்", "B": "-கள்", "C": "-காரர் (எ.கா: வீட்டுக்காரர், பால்காரர்)", "D": "-அர்கள்"}, "explanation": "ஆண்பால், பெண்பால் ஒருமைகளுக்கு மாற்றாக மரியாதைப் பன்மையாக '-காரர்' (வீட்டுக்காரர், கடைக்காரர்) என்ற விகுதி தற்காலத்தில் பரவலாக வழங்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which honorific suffix serves as the polite common plural counterpart to '-karan' and '-kari' in contemporary Tamil?", "media_id": null}], "options": {"A": "-maar", "B": "-gal", "C": "-kaarar (e.g., Veattukkaarar, Paalkkaarar)", "D": "-argal"}, "explanation": "'-kaarar' operates as the common respectful honorific suffix."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 163, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 163", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Grammar", "Aakkappeyarkal"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u7_q160", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "grammar_aakkappeyarkal", "chapter_id": null, "topic_id": "aakkappeyar_vs_thozhirpeyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொழிற்பெயருக்கும் (Verbal Noun) ஆக்கப்பெயருக்கும் (Derivative Noun) இடையிலான முதன்மையான வேறுபாடு யாது?", "media_id": null}], "options": {"A": "இரண்டுக்கும் எவ்வித வேறுபாடும் இல்லை", "B": "தொழிற்பெயர் காலத்தைக் காட்டும்; ஆக்கப்பெயர் காட்டாது", "C": "ஆக்கப்பெயர் வினையடியாக மட்டுமே தோன்றும்", "D": "தொழிற்பெயர் தொழிலின் பொதுப் பெயராக நிற்க, ஆக்கப்பெயர் அத்தொழிலைச் செய்யும் கருத்தாவையோ, இடத்தையோ, உடைமையையோ விகுதி ஏற்று வெளிப்படுத்துகிறது"}, "explanation": "எடுத்துக்காட்டாக, 'ஓட்டுதல்' என்பது தொழில் மட்டுமே; 'ஓட்டுநர்' என்பது தொழிலைச் செய்யும் நபரை உணர்த்தும் ஆக்கப்பெயராகும். 'கற்பித்தல்' என்பது தொழிற்பெயர்; 'கற்பிப்பாளர்' என்பது ஆக்கப்பெயர்."}, "en": {"blocks": [{"type": "text", "content": "What is the primary morphological/functional distinction between a verbal noun (Thozhirpeyar) and an agentive derivative noun (Aakkappeyar)?", "media_id": null}], "options": {"A": "There is no difference whatsoever", "B": "Verbal nouns show tense while derivative nouns do not", "C": "Derivative nouns originate purely from verbal roots", "D": "Verbal nouns express the action abstractly, whereas derivative nouns specify the agent, instrument, place, or possessor through suffixation"}, "explanation": "A verbal noun denotes the action itself (Ottuthal), whereas a derivative noun denotes the agent who performs it (Ottunar)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 164, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 164", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Grammar", "Aakkappeyarkal"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u7_q161", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "grammar_aakkappeyarkal", "chapter_id": null, "topic_id": "marunthaham_compound", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மருந்தகம்' என்னும் சொல் எவ்வாறு பிரிக்கப்பட்டு ஆக்கப்பெயராக உருவாகிறது?", "media_id": null}], "options": {"A": "மருந்து + அகம்", "B": "மரு + அந்தகம்", "C": "மருந்து + கம்", "D": "மருந்தன் + அகம்"}, "explanation": "மருந்து (பெயர்) + அகம் (இட விகுதி) = மருந்தகம் (Pharmacy) என ஆக்கப்பெயர் உருவாகிறது."}, "en": {"blocks": [{"type": "text", "content": "How is the locational derivative noun 'Marunthaham' (Pharmacy) analytically split?", "media_id": null}], "options": {"A": "Marunthu + aham", "B": "Maru + anthaham", "C": "Marunthu + kam", "D": "Marunthan + aham"}, "explanation": "Marunthu (medicine) + aham (place/establishment) = Marunthaham."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 163, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 163", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year":