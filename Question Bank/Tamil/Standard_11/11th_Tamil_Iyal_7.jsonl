{"id": "11th_tamil_u7_q137", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "supplementary_natakakkalai", "chapter_id": null, "topic_id": "modern_tamil_theatre_movement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நவீனத் தமிழ் நாடக இயக்கத்தில் சமூக விழிப்புணர்வையும், உழைக்கும் மக்களின் பிரச்சினைகளையும் முன்னெடுத்த நவீன நாடக அமைப்புகள் எவை?", "media_id": null}], "options": {"A": "கூத்துப்பட்டறை, நிஜ நாடக இயக்கம், சென்னை கலைக்குழு", "B": "அரண்மனை நாடகங்கள்", "C": "சமஸ்கிருத நாடகங்கள்", "D": "திரைப்படக் குழுக்கள்"}, "explanation": "கூத்துப்பட்டறை (ந. முத்துசாமி), நிஜ நாடக இயக்கம் (மு. ராமசுவாமி), சென்னை கலைக்குழு போன்ற அமைப்புகள் நவீன வீதி நாடகங்களை முன்னெடுத்தன."}, "en": {"blocks": [{"type": "text", "content": "Which pioneering troupes spearheaded social consciousness in modern Tamil experimental theater?", "media_id": null}], "options": {"A": "Koothu-p-pattarai, Nija Naadaga Iyakkam, and Chennai Kalai Kuzhu", "B": "Palace troupes", "C": "Sanskrit drama circles", "D": "Film production units"}, "explanation": "Koothu-p-pattarai and modern troupes revitalized contemporary Tamil theater."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11",