{"id": "11th_tamil_u7_q129", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "supplementary_natakakkalai", "chapter_id": null, "topic_id": "manonmaniyam_play", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழில் தோன்றிய முதல் பா-வடிவ நாடக நூல் (கவிதை நாடக நூல்) எது?", "media_id": null}], "options": {"A": "பேராசிரியர் பெ. சுந்தரனார் இயற்றிய 'மனோன்மணீயம்' (1891)", "B": "சபாபதி", "C": "இரங்கேச வெண்பா", "D": "திருக்கோவையார்"}, "explanation": "பேராசிரியர் பெ. சுந்தரனார் 1891-இல் இயற்றிய 'மனோன்மணீயம்' தமிழில் தோன்றிய முதல் பா-வடிவ நாடக நூலாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which work is celebrated as the first verse-drama (verse play) in Tamil literature?", "media_id": null}], "options": {"A": "Manonmaniyam by Prof. P. Sundaranar (1891)", "B": "Sabapathy", "C": "Rangesa Venba", "D": "Thirukkovaiyar"}, "explanation": "'Manonmaniyam' (1891) is the first full-fledged poetic verse play in Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 155, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 155", "url": null, "source_notes": null}, "previo