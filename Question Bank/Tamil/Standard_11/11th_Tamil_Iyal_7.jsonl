{"id": "11th_tamil_u7_q151", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "grammar_aakkappeyarkal", "chapter_id": null, "topic_id": "pure_tamil_substitutes", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிறமொழி விகுதியான '-காரன்' என்பதனைத் தவிர்த்து தூய தமிழ்ச் சொல் ஆக்கங்களை அமைக்கும் முயற்சியில் 'நாடகக்காரன்' என்பதற்குப் பொருத்தமான தூய தமிழ் ஆக்கப்பெயர் எது?", "media_id": null}], "options": {"A": "நாடகவான்", "B": "நாடகக்காரர்", "C": "நாடகக் கலைஞர் / கூத்தர்", "D": "நாடக மனிதர்"}, "explanation": "மொழித்தூய்மை மற்றும் கலைச்சொல்லாக்க நெறியில் '-காரன்' விகுதிக்குப் பதிலாகக் 'கலைஞர்', 'கூத்தர்', 'நடிகர்' போன்ற தூய தமிழ்ச் சொற்கள் பரிந்துரைக்கப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "In puristic modernization seeking indigenous alternatives to '-karan', what authentic Tamil derivative term replaces 'Naadakakkaran'?", "media_id": null}], "options": {"A": "Naadakavaan", "B": "Naadakakkarar", "C": "Naadakak Kalaignar / Koothar", "D": "Naadaga manithar"}, "explanation": "Indigenous standard forms replace foreign suffixations with Kalaignar or Nadigar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "