{"id": "11th_tamil_u7_q136", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_pathitrupathu", "chapter_id": null, "topic_id": "pathitrupathu_old_commentary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பதிற்றுப்பத்துக்குக் கிடைத்துள்ள பழைய உரை யாருடையது எனக் கருதப்படுகிறது?", "media_id": null}], "options": {"A": "நச்சினார்க்கினியர்", "B": "பேராசிரியர்", "C": "இளம்பூரணர்", "D": "பெயர் தெரியாத பழங்கால உரையாசிரியர்"}, "explanation": "பதிற்றுப்பத்துக்குக் கிடைத்துள்ள அரிய பழைய உரையை எழுதிய ஆசிரியர் யார் என்று பெயர் தெரியவில்லை; எனினும் மிகச் செறிவான உரை மரபைக் கொண்டது."}, "en": {"blocks": [{"type": "text", "content": "Whose ancient commentary is extant for the anthologized verses of Pathitrupathu?", "media_id": null}], "options": {"A": "Nachinarkiniyar", "B": "Perasiriyar", "C": "Ilampooranar", "D": "An anonymous ancient commentator"}, "explanation": "The extant ancient commentary of Pathitrupathu is by an anonymous classical scholar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 154, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 154", "url": null, "so