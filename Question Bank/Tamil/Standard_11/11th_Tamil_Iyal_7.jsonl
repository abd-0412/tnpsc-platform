{"id": "11th_tamil_u7_q186", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "glossary_unit7", "chapter_id": null, "topic_id": "theatrical_terms_greenroom", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாடகத்துறையில் நடிகர்கள் வேடமிட்டுத் தங்களை ஒப்பனை செய்துகொள்ளும் 'Green room' என்பதற்குரிய தூய தமிழ்க் கலைச்சொல் எது?", "media_id": null}], "options": {"A": "பச்சை அறை", "B": "ஒப்பனை அறை", "C": "ஓய்வு அறை", "D": "காத்திருப்பு அறை"}, "explanation": "'Green room' என்பதன் துறைசார் தமிழ்க் கலைச்சொல் 'ஒப்பனை அறை' என்பதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the standard Tamil theatrical equivalent for the technical term 'Green room'?", "media_id": null}], "options": {"A": "Pachai arai", "B": "Oppanai arai (Make-up/Dressing room)", "C": "Oyvu arai", "D": "Kaathiruppu arai"}, "explanation": "'Green room' refers specifically to 'Oppanai arai' in theatrical terminology."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 170, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 170", "url": null, "source_notes": null}, "previous_year": {"is_previous_