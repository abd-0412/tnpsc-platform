{"id": "11th_tamil_u7_q178", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "pyq_unit7", "chapter_id": null, "topic_id": "pyq_theatre_headmaster", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] சிறுவர்களைக் கொண்டு முதன்முதலில் 'பால நந்தன சபா' போன்ற நாடகக் குழுக்களை உருவாக்கி, நாடக மேடை ஒழுக்கத்தை வகுத்துத் 'தமிழ் நாடகத் தலைமை ஆசிரியர்' எனப் போற்றப்படுபவர் யார்?", "media_id": null}], "options": {"A": "தி. க. சண்முகம்", "B": "சங்கரதாஸ் சுவாமிகள்", "C": "பம்மல் சம்பந்தனார்", "D": "நவாப் ராஜமாணிக்கம்"}, "explanation": "சங்கரதாஸ் சுவாமிகள் பால நாடக சபைகளைத் தோற்றுவித்து ஏராளமான நாடகங்களை இயற்றி, நாடகத் தலைமை ஆசிரியராகத் திகழ்ந்தார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Who founded Boys Drama Companies like 'Baala Nandhana Sabha' and is revered as the 'Headmaster of Tamil Theatre'?", "media_id": null}], "options": {"A": "T. K. Shanmugam", "B": "Sankaradas Swamigal", "C": "Pammal Sambandhanar", "D": "Nawab Rajamanikkam"}, "explanation": "Sankaradas Swamigal is venerated as the Headmaster (Thalaimai Aasiriyar) of Tamil drama."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edit