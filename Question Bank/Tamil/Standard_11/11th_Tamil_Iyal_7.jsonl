{"id": "11th_tamil_u7_q130", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_pathitrupathu", "chapter_id": null, "topic_id": "kumattur_kannanar_corpus", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குமட்டூர்க் கண்ணனார் சங்க இலக்கியங்களில் பதிற்றுப்பத்துத் தவிர வேறு எந்த நூலில் ஒரு பாடல் பாடியுள்ளார்?", "media_id": null}], "options": {"A": "நற்றிணை", "B": "அகநானூறு (பாடல் 54)", "C": "குறுந்தொகை", "D": "கலித்தொகை"}, "explanation": "குமட்டூர்க் கண்ணனார் பதிற்றுப்பத்தின் இரண்டாம் பத்து (10 பாடல்கள்) தவிர, அகநானூற்றில் ஒரு பாடலையும் (பாடல் 54) பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Besides the Second Decade of Pathitrupathu, in which other Sangam text did Kumattur Kannanar contribute a poem?", "media_id": null}], "options": {"A": "Narrinai", "B": "Agananuru (Poem 54)", "C": "Kurunthokai", "D": "Kalithokai"}, "explanation": "Kumattur Kannanar also composed Poem 54 in Agananuru."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 154, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 154", "url": null, "source_notes": null}, "previous_year"