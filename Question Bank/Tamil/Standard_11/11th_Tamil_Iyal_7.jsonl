{"id": "11th_tamil_u7_q138", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_pathitrupathu", "chapter_id": null, "topic_id": "neduncheralathan_brother", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இமயவரம்பன் நெடுஞ்சேரலாதனின் தம்பியும், பதிற்றுப்பத்தின் மூன்றாம் பத்தில் பாடப்பட்டவனுமான சேர மன்னன் யார்?", "media_id": null}], "options": {"A": "சேரன் செங்குட்டுவன்", "B": "பல்யானைச் செல்கெழு குட்டுவன் (பாலைக்கௌதமனாரால் பாடப்பட்டவர்)", "C": "பெருஞ்சேரலிரும்பொறை", "D": "ஆடுகோட்பாட்டுச் சேரலாதன்"}, "explanation": "இமயவரம்பனின் தம்பியான பல்யானைச் செல்கெழு குட்டுவனைப் பாலைக்கௌதமனார் மூன்றாம் பத்தில் பாடினார்."}, "en": {"blocks": [{"type": "text", "content": "Which Chera king was the brother of Imayavaramban Neduncheralathan and the subject of the Third Decade?", "media_id": null}], "options": {"A": "Cheran Senguttuvan", "B": "Palyanaic Chelkezhu Kuttuvan (eulogized by Palaikkauthmanar)", "C": "Peruncheral Irumporai", "D": "Aadukotpattuc Cheralathan"}, "explanation": "Palyanaic Chelkezhu Kuttuvan was eulogized in the Third Decade."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 153,