{"id": "11th_tamil_u7_q028", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "prose_lesson_takeaway", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'காற்றில் கலந்த பேரோசை' உரைநடை நமக்குக் கற்பிக்கும் முதன்மையான வாழ்க்கை நெறி யாது?", "media_id": null}], "options": {"A": "புகழும் பணமுமே வாழ்வின் உச்சம்", "B": "சமூகப் பிரச்சினைகளைப் புறக்கணிக்க வேண்டும்", "C": "மேடைப் பேச்சே போதுமானது", "D": "பதவி, பணம், ஆடம்பரங்களைத் துறந்து, எளிய மனிதர்களுக்காகத் தன்னை அர்ப்பணிக்கும் தியாக வாழ்வே வரலாற்றில் அழியாத இடத்தைப் பெறுகிறது"}, "explanation": "ஜீவாவின் வாழ்க்கை எளிய வாழ்வும், கொள்கைப்பிடிப்பும், பொதுநல அர்ப்பணிப்புமே ஒரு மனிதனை வரலாற்றில் என்றும் வாழச் செய்யும் என்பதை உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What supreme life lesson does 'Kaatril Kalantha Perosai' impart to future generations?", "media_id": null}], "options": {"A": "Wealth and fame are the zenith of existence", "B": "Social problems should be ignored", "C": "Rhetoric suffices", "D": "A life of self-sacrifice dedicated to the downtrodden, renouncing wealth and luxury, endures forever in history"}, "explanation": "Selfless dedication to humanity and uncompromised simplicity immortalize a leader."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type"