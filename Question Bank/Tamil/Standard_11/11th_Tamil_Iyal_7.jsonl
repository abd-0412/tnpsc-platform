{"id": "11th_tamil_u7_q127", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "supplementary_natakakkalai", "chapter_id": null, "topic_id": "theatre_sabha_history", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பம்மல் சம்பந்த முதலியார் 1891-இல் சென்னையில் படித்த இளைஞர்களையும் உயர் அலுவலர்களையும் நாடகத்தில் நடிக்க வைப்பதற்காகத் தொடங்கிய புகழ்பெற்ற நாடக சபை எது?", "media_id": null}], "options": {"A": "பால விநோத சபா", "B": "மதுரை ஒரிஜினல் பாய்ஸ் கம்பெனி", "C": "சுகுண விலாச சபா (Suguna Vilasa Sabha)", "D": "சேவா ஸ்டேஜ்"}, "explanation": "பம்மல் சம்பந்த முதலியார் 1891-இல் 'சுகுண விலாச சபா'வைத் தொடங்கி, அவமதிப்புக்கு உள்ளாகியிருந்த நாடகக் கலைக்குப் படித்த மேட்டுக்குடியினரிடையே நன்மதிப்பை உருவாக்கினார்."}, "en": {"blocks": [{"type": "text", "content": "Which prestigious theatrical society was founded in Madras in 1891 by Pammal Sambandha Mudaliar to bring educated elites to the stage?", "media_id": null}], "options": {"A": "Bala Vinodha Sabha", "B": "Madurai Original Boys Company", "C": "Suguna Vilasa Sabha", "D": "Seva Stage"}, "explanation": "He founded Suguna Vilasa Sabha in 1891, revolutionizing theatrical respectability."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Servi