{"id": "11th_tamil_u7_q055", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "jeeva_oratory_memory", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜீவாவின் உரையை மக்கள் மணிக்கணக்கில் கேட்டுக் கொண்டு அசையாமல் நின்றதன் இரகசியம் யாது?", "media_id": null}], "options": {"A": "பயமுறுத்தியதால்", "B": "பரிசுகள் கொடுத்ததால்", "C": "உள்ளத்திலிருந்து பொங்கி வந்த உண்மையும், கவிதை நயமும், பாமர மக்களின் துயர் தீர்க்கும் வழியைத் தெளிவுபடுத்திய நேர்மையும்", "D": "பாட்டு மட்டுமே பாடியதால்"}, "explanation": "ஜீவாவின் சொல்லில் கள்ளமில்லை; அவரது சொற்கள் இதயத்தின் ஆழத்திலிருந்து உண்மையாகப் புறப்பட்டு மக்களின் இதயங்களைத் தொட்டதால் மக்கள் மெய்மறந்து நின்றனர்."}, "en": {"blocks": [{"type": "text", "content": "What was the secret behind crowds listening spellbound to Jeeva's speeches for hours without stirring?", "media_id": null}], "options": {"A": "Intimidation", "B": "Gifts distributed", "C": "Absolute emotional sincerity from the heart, poetic lyricism, and luminous moral integrity offering hope to the oppressed", "D": "Singing alone"}, "explanation": "His words flowed straight from deep conviction, striking a profound chord in common hearts."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalv