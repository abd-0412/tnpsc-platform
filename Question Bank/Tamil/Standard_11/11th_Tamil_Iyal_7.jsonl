{"id": "11th_tamil_u7_q030", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "progressive_writers_association", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழகத்தில் முற்போக்கு எழுத்தாளர்களையும் கலைஞர்களையும் ஒருங்கிணைத்து 'தமிழ்நாடு கலை இலக்கியப் பெருமன்றம்' அமைப்பைத் தோற்றுவித்தவர் யார்?", "media_id": null}], "options": {"A": "தி. க. சிவசங்கரன்", "B": "தோழர் ஜீவானந்தம்", "C": "ஜெயகாந்தன்", "D": "புதுமைப்பித்தன்"}, "explanation": "ஜீவா 1961-இல் எழுத்தாளர்கள், கலைஞர்களை ஒருங்கிணைத்துத் 'தமிழ்நாடு கலை இலக்கியப் பெருமன்றம்' என்னும் மாபெரும் இலக்கிய அமைப்பைத் தோற்றுவித்தார்."}, "en": {"blocks": [{"type": "text", "content": "Who established the 'Tamil Nadu Kalai Ilakkiya Perumandram' unifying progressive writers and artists in 1961?", "media_id": null}], "options": {"A": "T. K. Sivasankaran", "B": "Comrade Jeevanandham", "C": "Jayakanthan", "D": "Pudhumaipithan"}, "explanation": "Comrade Jeevanandham founded Tamil Nadu Kalai Ilakkiya Perumandram in 1961."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 150, "chapter": null, "sec