{"id": "11th_tamil_u7_q176", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "pyq_unit7", "chapter_id": null, "topic_id": "pyq_pathitrupathu_chera_kings", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] பதிற்றுப்பத்தில் இரண்டாம் பத்து இமயவரம்பன் நெடுஞ்சேரலாதனைப் பாடியவர் குமட்டூர்க் கண்ணனார். அப்பாடலுக்குப் பரிசாக மன்னன் குமட்டூர்க் கண்ணனாருக்கு வழங்கியது எது?", "media_id": null}], "options": {"A": "ஆயிரம் பொற்காசுகள்", "B": "ஒரு யானைப்படை", "C": "தங்கக் கிரீடம்", "D": "உம்பற்காட்டு ஐந்நூறு ஊர்களும், தென்னாட்டு வருவாயுள் முப்பத்தெட்டாண்டுகளுக்குப் பாகமும்"}, "explanation": "பதிற்றுப்பத்துப் பதிகத்தின்படி குமட்டூர்க் கண்ணனாருக்கு உம்பற்காட்டு 500 ஊர்களையும் தென்னாட்டு வருவாயில் 38 ஆண்டுப் பங்கையும் மன்னன் நெடுஞ்சேரலாதன் பரிசாக வழங்கினான்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] What unprecedented royal bounty did King Neduncheralathan confer upon poet Kumattur Kannanar for composing the 2nd Decade of Pathitrupathu?", "media_id": null}], "options": {"A": "One thousand gold sovereigns", "B": "An elephant brigade", "C": "Golden crown", "D": "Five hundred villages in Umbarkkadu and a share of southern realm revenues for 38 years"}, "explanation": "Kannanar received 500 villages in Umbarkkadu and revenue rights for 38 years."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answer