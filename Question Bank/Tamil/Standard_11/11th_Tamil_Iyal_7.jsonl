{"id": "11th_tamil_u7_q084", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "puratchikkavi_part1_synthesis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'புரட்சிக்கவி' பகுதி 1 (கதை தொடக்கம் முதல் கொலைக்களம் வரை) உணர்த்தும் முதன்மைச் செய்தி யாது?", "media_id": null}], "options": {"A": "மன்னனின் ஆணையை எதிர்க்கக் கூடாது", "B": "ஏழைகள் காதலிக்கக் கூடாது", "C": "திரைச்சீலைகள் ஆபத்தானவை", "D": "கலை, கல்வி, உண்மைக் காதல் ஆகியவை வர்க்க, சாதிய எல்லைகளைக் கடந்து நிற்கும் வல்லமை படைத்தவை; அவற்றை அடக்க நினைக்கும் கொடுங்கோன்மை வீழ்ச்சியை நோக்கியே செல்லும்"}, "explanation": "உண்மைக் காதலும் தமிழ்க் கவிதையும் அதிகாரத்தின் திரைச்சீலைகளைக் கிழித்தெறிந்து தன்மானத்தோடு நிமிர்ந்து நிற்கும் பேராற்றலை இப்பகுதி நிறுவுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What fundamental truth is illustrated in Part 1 of 'Puratchikkavi' leading up to the execution site?", "media_id": null}], "options": {"A": "Royal edicts must never be opposed", "B": "The poor should not love", "C": "Curtains are dangerous", "D": "Art, wisdom, and genuine love possess power transcending feudal barriers; tyranny seeking to crush them heads for inevitable ruin"}, "explanation": "True love and artistic dignity shatter aristocratic barriers, heralding the doom of tyranny."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 151, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 151", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Poetry", "Puratchikkavi"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
