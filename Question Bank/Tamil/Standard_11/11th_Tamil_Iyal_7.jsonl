{"id": "11th_tamil_u7_q150", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "grammar_aakkappeyarkal", "chapter_id": null, "topic_id": "gender_suffix_pair", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்கண்டவற்றுள் ஆண்பால் மற்றும் பெண்பால் ஆக்கப்பெயர் இணைகளுள் பொருந்தாத ஒன்றைக் கண்டறிக:", "media_id": null}], "options": {"A": "வண்டிக்காரன் - வண்டிக்காரி", "B": "உடைமையாளன் - உடைமையகம்", "C": "கூடைக்காரன் - கூடைக்காரி", "D": "வேலைக்காரன் - வேலைக்காரி"}, "explanation": "'உடைமையாளன்' என்பது உயர்திணை ஆண்பால்; 'உடைமையகம்' என்பது அஃறிணை இடப்பெயர். மற்றவை அனைத்தும் ஆண்பால் - பெண்பால் ஆக்கப்பெயர் இணைகளாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the odd pair among masculine and feminine derivative noun pairs:", "media_id": null}], "options": {"A": "Vandikkaran - Vandikkari", "B": "Udaimaiyaalan - Udaimaiyaham", "C": "Koodaikkaran - Koodaikkari", "D": "Velaikkaran - Velaikkari"}, "explanation": "Udaimaiyaham is an impersonal locational noun, whereas Udaimaiyaalan is personal masculine."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 163, "chapter": null, "section": 