{"id": "11th_tamil_u7_q121", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "supplementary_natakakkalai", "chapter_id": null, "topic_id": "pammal_sambandhar_title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தமிழ் நாடகத் தந்தை' என்று தமிழ் அறிஞர்களால் போற்றப்படும் நாடகப் பேராசிரியர் யார்?", "media_id": null}], "options": {"A": "பம்மல் சம்பந்த முதலியார்", "B": "சங்கரதாஸ் சுவாமிகள்", "C": "பரிதிமாற்கலைஞர்", "D": "பேராசிரியர் சுந்தரனார்"}, "explanation": "பம்மல் சம்பந்த முதலியார் வழக்கறிஞராக இருந்து கொண்டே ஏறத்தாழ 100-க்கும் மேற்பட்ட நாடகங்களை எழுதி மேடையேற்றியதால் 'தமிழ் நாடகத் தந்தை' எனப் போற்றப்படுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Who is hailed as the 'Father of Modern Tamil Drama' (Thamizh Naadagath Thanthai)?", "media_id": null}], "options": {"A": "Pammal Sambandha Mudaliar", "B": "Sankaradas Swamigal", "C": "Parithimaarkalaignar", "D": "Prof. Sundaranar"}, "explanation": "Pammal Sambandha Mudaliar authored over 100 plays, earning the title Father of Modern Tamil Drama."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 155, "chapter": null, "section": null,