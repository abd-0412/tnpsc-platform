{"id": "11th_tamil_u7_q140", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_pathitrupathu", "chapter_id": null, "topic_id": "chera_history_monograph_synthesis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பதிற்றுப்பத்தும் நாடகக்கலையும் இணைந்து உணர்த்தும் பண்டைய தமிழரின் பண்பாட்டுப் பெருமை யாது?", "media_id": null}], "options": {"A": "போரில் மட்டுமே நாட்டம்கொண்டனர்", "B": "கலைகளைப் புறக்கணித்தனர்", "C": "நாடகங்கள் அயல்நாட்டிலிருந்து வந்தவை", "D": "தமிழர்கள் போரிலும் அறநெறியிலும் தலைசிறந்து விளங்கியதுடன், முத்தமிழில் நாடகத் தமிழையும் செழுமையாக வளர்த்து உலக அரங்கில் கலை ஆளுமையை நிலைநாட்டினர்"}, "explanation": "பதிற்றுப்பத்து தமிழரின் புறவாழ்வு வீரத்தையும், நாடகக்கலை தமிழரின் கலைநுட்ப அழகியலையும் ஒருங்கே வெளிப்படுத்தித் தமிழரின் முழுமையான நாகரிகப் பெருமிதத்தை நிறுவுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What overarching cultural truth is demonstrated through Pathitrupathu and Theatre Arts?", "media_id": null}], "options": {"A": "Tamils engaged solely in warfare", "B": "Arts were neglected", "C": "Drama was imported from abroad", "D": "Tamils combined supreme martial valor with righteous governance, while nurturing performing dramatic arts to sublime heights"}, "explanation": "It testifies to the harmonious confluence of heroic martial ideals and refined dramatic arts."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 154, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 154", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Synthesis", "Full Lesson"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
