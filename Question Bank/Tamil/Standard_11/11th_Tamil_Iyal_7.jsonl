{"id": "11th_tamil_u7_q016", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "perosai_title_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இப்பாடப்பகுதிக்குச் சுந்தர ராமசாமி 'காற்றில் கலந்த பேரோசை' எனப் பெயரிட்டதன் ஆழமான காரணம் யாது?", "media_id": null}], "options": {"A": "காற்று பலமாக வீசியதால்", "B": "வானொலிப் பெட்டியின் சத்தத்தைக் குறிக்க", "C": "இயற்கைப் பேரிடரைக் குறிக்க", "D": "ஜீவாவின் கம்பீரமான மக்கள் குரல், அவரது மறைவுக்குப் பின்னும் காற்றில் கலந்த அழியாப் பேரோசையாகத் தலைமுறைகள் தோறும் எதிரொலித்துக் கொண்டிருப்பதால்"}, "explanation": "ஜீவா மறைந்தாலும் அவரது உன்னதமான இலட்சிய முழக்கமும், மனிதநேயக் குரலும் காலத்தை வென்று காற்றில் கலந்து என்றென்றும் ஒலித்துக் கொண்டே இருக்கும் என்பதை உணர்த்தவே இப்பெயர் வைக்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Why did Sundara Ramasamy title this biographical essay 'Kaatril Kalantha Perosai' (A Great Voice Mingled in the Wind)?", "media_id": null}], "options": {"A": "Gusts of high winds", "B": "Noise of a radio box", "C": "Natural storm", "D": "Jeeva reverberating voice for social justice transcends mortal demise, echoing eternally through generations"}, "explanation": "It symbolizes that Jeeva's prophetic voice for oppressed humanity remains alive in the winds of time."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negat