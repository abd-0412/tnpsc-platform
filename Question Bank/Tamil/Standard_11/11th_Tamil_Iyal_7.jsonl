{"id": "11th_tamil_u7_q012", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "sundara_ramasamy_birth_place", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுந்தர ராமசாமியின் பூர்வீகம் மற்றும் அவர் வாழ்ந்த ஊர் எது?", "media_id": null}], "options": {"A": "மதுரை", "B": "சென்னை", "C": "தஞ்சாவூர்", "D": "நாகர்கோவில் (தட்டச்சுக் கருவியகம் நடத்தி இலக்கியப் பணி புரிந்தவர்)"}, "explanation": "சுந்தர ராமசாமி நாகர்கோவிலில் வாழ்ந்து, அங்கிருந்தபடியே இலக்கிய இதழ்களையும் நாவல்களையும் நவீனத் தமிழ் உலகிற்குப் படைத்தளித்தார்."}, "en": {"blocks": [{"type": "text", "content": "What was the hometown where writer Sundara Ramasamy lived and engaged in his literary endeavors?", "media_id": null}], "options": {"A": "Madurai", "B": "Chennai", "C": "Thanjavur", "D": "Nagercoil"}, "explanation": "Sundara Ramasamy lived in Nagercoil and nurtured modern Tamil literary discourse from there."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 148, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 148", "url": null, "source_notes": null}, "prev