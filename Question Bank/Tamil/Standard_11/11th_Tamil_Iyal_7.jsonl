{"id": "11th_tamil_u7_q158", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "grammar_aakkappeyarkal", "chapter_id": null, "topic_id": "suffix_function_types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆக்கப்பெயர் விகுதிகள் எவற்றை உணர்த்தும் வகையில் அமைகின்றன?\n(1) ஆள்வினை அல்லது தொழில்\n(2) உடமை அல்லது உரிமை\n(3) இடம் அல்லது இருப்பிடம்", "media_id": null}], "options": {"A": "1 மற்றும் 2 மட்டுமே", "B": "1, 2, 3 ஆகிய அனைத்தும்", "C": "2 மற்றும் 3 மட்டுமே", "D": "1 மட்டுமே"}, "explanation": "ஆக்கப்பெயர்கள் தொழிலையும் (வேலைக்காரன், தொழிலாளி), உடைமையையும் (உடைமையாளன், பணக்காரன்), இடத்தையும் (நூலகம், மருந்தகம்) குறிக்கும் வகையில் பன்முகத்தன்மையுடன் அமைகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Which semantic dimensions do derivative suffixes signify in Tamil?\n(1) Agency or occupation\n(2) Possession or ownership\n(3) Location or institutional establishment", "media_id": null}], "options": {"A": "1 and 2 only", "B": "All 1, 2, and 3", "C": "2 and 3 only", "D": "1 only"}, "explanation": "Derivative suffixes encapsulate occupation, ownership, and location."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year