{"id": "11th_tamil_u7_q162", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "grammar_aakkappeyarkal", "chapter_id": null, "topic_id": "peyar_aakkappeyar_examples", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்காண்பவற்றுள் 'பெயர் ஆக்கப்பெயர்' (பெயர்ச்சொல்லிலிருந்து உருவான ஆக்கப்பெயர்) மட்டுமே அடங்கிய வரிசை எது?", "media_id": null}], "options": {"A": "ஓட்டுநர், நடத்துநர், பயிற்றுநர்", "B": "பணக்காரன், அறிவாளி, நாட்டாமையாளர்", "C": "கட்டுமானம், தேய்மானம், பெறுமானம்", "D": "கொல்லன், தட்டான், உழவன்"}, "explanation": "பணம், அறிவு, நாட்டாமை என்பவை பெயர்ச்சொற்கள். அவற்றுடன் -காரன், -ஆளி, -ஆளர் இணைந்து உருவானவை பெயர் ஆக்கப்பெயர்கள் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which group consists exclusively of 'Noun-derived Agentive Nouns' (Peyar Aakkappeyar)?", "media_id": null}], "options": {"A": "Ottunar, Nadathunar, Payittrunar", "B": "Panakkaran, Arivaali, Naattaamaiyaalar", "C": "Kattumaanam, Theymaanam, Perumaanam", "D": "Kollan, Thattaan, Uzhavan"}, "explanation": "Panakkaran, Arivaali, and Naattaamaiyaalar are derived from underlying nominal stems."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 162, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 162", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Grammar", "Aakkappeyarkal"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u7_q163", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "grammar_aakkappeyarkal", "chapter_id": null, "topic_id": "suffix_aalar_dignity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தற்காலத் தமிழில் தொழில்சார் அமைப்புகளிலும் கல்வித் துறையிலும் பெருமளவில் பயன்படுத்தப்படும் கண்ணியமிக்க ஆக்கப்பெயர் விகுதி '-ஆளர்' என்பதற்கான எடுத்துக்காட்டுகளுள் பொருந்தாதது எது?", "media_id": null}], "options": {"A": "செயலாளர்", "B": "பேச்சாளர்", "C": "வண்டிக்காரன்", "D": "பொருளாளர்"}, "explanation": "'வண்டிக்காரன்' என்பது -காரன் விகுதி ஏற்ற சொல்; செயலாளர், பேச்சாளர், பொருளாளர் என்பவை -ஆளர் விகுதி ஏற்ற கண்ணியமிக்க ஆக்கப்பெயர்கள்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following is NOT an example of the dignified professional suffix '-aalar'?", "media_id": null}], "options": {"A": "Seyalaalar (Secretary)", "B": "Peechaalar (Orator)", "C": "Vandikkaran (Cart driver)", "D": "Porulaalar (Treasurer)"}, "explanation": "Vandikkaran utilizes the suffix -karan rather than -aalar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 163, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 163", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Grammar", "Aakkappeyarkal"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u7_q164", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "grammar_aakkappeyarkal", "chapter_id": null, "topic_id": "aakkappeyar_significance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆக்கப்பெயர்கள் ஒரு மொழியில் பெருகுவதனால் ஏற்படும் முதன்மையான நற்பயன் யாது?", "media_id": null}], "options": {"A": "இலக்கண விதிகளின் சுமை குறையும்", "B": "பழைய இலக்கியங்கள் வழக்கொழிந்து போகும்", "C": "வேற்றுமொழிச் சொற்கள் மட்டுமே நிறையும்", "D": "காலத்திற்கேற்ப அறிவியல், தொழில், கலை சார்ந்த புதிய கருத்துகளுக்குத் துல்லியமான புதிய சொற்கள் உருவாகி மொழி வளம் பெறும்"}, "explanation": "ஆக்கப்பெயர்கள் புதுப்புதுக் கருத்துகளுக்கும் தொழில்களுக்கும் அறிவியல் கூறுகளுக்கும் தமிழிலேயே புதிய கலைச்சொற்களை உருவாக்கித் தமிழ் மொழியின் சொல்வளத்தைப் பெருக்க உதவுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What is the prime communicative advantage of developing derivative nouns in a living language?", "media_id": null}], "options": {"A": "Grammar rules diminish", "B": "Ancient literatures disappear", "C": "Foreign loanwords flood the tongue", "D": "Precise neologisms for modern science, technology, and professions enrich lexical repertoire"}, "explanation": "Derivative morphology empowers the coining of authentic vocabulary suited to modern technological and civic life."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_