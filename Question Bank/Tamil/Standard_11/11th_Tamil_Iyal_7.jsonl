{"id": "11th_tamil_u7_q113", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_pathitrupathu", "chapter_id": null, "topic_id": "chera_kings_anthology", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க இலக்கிய எட்டுத்தொகை நூல்களுள் சேர மன்னர்களின் வீரம், கொடை, பண்பாட்டை மட்டுமே பாடும் வரலாற்றுப் பெட்டக நூல் எது?", "media_id": null}], "options": {"A": "பதிற்றுப்பத்து", "B": "புறநானூறு", "C": "அகநானூறு", "D": "ஐங்குறுநூறு"}, "explanation": "பதிற்றுப்பத்து சேர மன்னர்கள் பதின்மரின் வீரம், கொடை, ஆட்சிச் சிறப்புகளைப் பத்து புலவர்கள் பாடிய புறப்பொருள் சார்ந்த எட்டுத்தொகை நூலாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which Ettuthokai anthology is exclusively dedicated to celebrating the valor, munificence, and lineage of Chera monarchs?", "media_id": null}], "options": {"A": "Pathitrupathu", "B": "Purananuru", "C": "Agananuru", "D": "Ainkurunuru"}, "explanation": "Pathitrupathu is exclusively dedicated to the genealogy and heroism of ten Chera kings."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 153, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Pag