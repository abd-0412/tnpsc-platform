{"id": "11th_tamil_u7_q011", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "vanchinathan_incident_early_life", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தோழர் ஜீவா தம் இளமைக் காலத்தில் எத்தகைய சமூக அநீதிகளுக்கு எதிராகக் குரல் கொடுத்தார்?", "media_id": null}], "options": {"A": "வரி செலுத்துவதற்கு எதிராக", "B": "மொழிபெயர்ப்புகளுக்கு எதிராக", "C": "சாதிப் பாகுபாடுகள், தீண்டாமை மற்றும் கோவில் நுழைவுத் தடைகளுக்கு எதிராக", "D": "பள்ளிப் படிப்பிற்கு எதிராக"}, "explanation": "ஜீவா இளம் வயதிலேயே தீண்டாமைக்கு எதிராகவும், தாழ்த்தப்பட்ட மக்களின் கோயில் நுழைவு உரிமைக்காகவும், சாதி ஆதிக்கத்திற்கு எதிராகவும் சமரசமின்றிப் போராடினார்."}, "en": {"blocks": [{"type": "text", "content": "Against which social injustices did young Jeeva crusade relentlessly in his youth?", "media_id": null}], "options": {"A": "Taxation only", "B": "Against literary translation", "C": "Caste discrimination, untouchability, and denial of temple entry", "D": "Against schooling"}, "explanation": "He fought vigorously against caste hierarchy, untouchability, and social exclusion."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "clas