{"id": "11th_tamil_u7_q005", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "karaikudi_incident", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காரைக்குடியில் ஒரு கூட்டத்திற்குச் சென்றபோது, ஜீவாவைத் தங்க வைத்த விடுதி அல்லது வீட்டின் சூழலைச் சுந்தர ராமசாமி எவ்வாறாக விவரிக்கிறார்?", "media_id": null}], "options": {"A": "எவ்வித ஆடம்பரமும் இன்றி, வெறும் பாயில் படுத்து உறங்கி எளிய உணவை மனமுவந்து ஏற்ற தூய எளிமையின் திருவுருவம்", "B": "மாளிகையில் தங்க விரும்பியவர்", "C": "சிறப்பு உணவுகளைக் கோரியவர்", "D": "பொருளாதார வசதிகளை நாடியவர்"}, "explanation": "ஜீவா எந்த ஊருக்குச் சென்றாலும் ஆடம்பர விடுதிகளை நாடாமல், எளிய தொண்டர்களின் வீடுகளிலோ சாதாரண அறைகளிலோ தங்கிப் பாயில் உறங்கும் துறவு மனப்பான்மை கொண்டவராக விளங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "How does the Karaikudi episode recorded by Sundara Ramasamy highlight Jeeva's lifestyle?", "media_id": null}], "options": {"A": "Pure embodiment of simplicity, sleeping peacefully on a straw mat and relishing simple frugal meals without luxury", "B": "Demanded palatial accommodation", "C": "Insisted on gourmet banquets", "D": "Sought monetary comforts"}, "explanation": "He lived as an ascetic revolutionary, shunning luxury and sleeping on plain woven mats."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multi