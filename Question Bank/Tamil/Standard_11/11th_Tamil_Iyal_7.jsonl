{"id": "11th_tamil_u7_q067", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "amuthavalli_defiance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உதாரனுக்கு மரண தண்டனை விதிக்கப்பட்டதைக் கேட்ட அமுதவல்லியின் எதிர்வினை யாது?", "media_id": null}], "options": {"A": "அமைதியாக ஏற்றுக்கொண்டாள்", "B": "மன்னனின் விருப்பப்படி வேறு ஒருவனை மணந்தாள்", "C": "உதாரனைக் கொன்றால் அவனோடு சேர்ந்து தானும் உயிர்விடுவேன் என அரசனிடம் அறைகூவல் விடுத்துக் கொலைக்களம் நோக்கி விரைந்தாள்", "D": "மயங்கி விழுந்தாள்"}, "explanation": "அமுதவல்லி அஞ்சாது மன்னனை எதிர்த்து, 'உதாரன் மடிந்தால் நானும் மடிவேன்' என வீர முழக்கமிட்டுக் கொலைக்களத்திற்குச் சென்றாள்."}, "en": {"blocks": [{"type": "text", "content": "What was Princess Amuthavalli's bold reaction to the royal death sentence decreed on Udharan?", "media_id": null}], "options": {"A": "Silently accepted it", "B": "Married another suitor", "C": "Defied the king, declaring she would perish with Udharan, and rushed to the execution site", "D": "Fainted away"}, "explanation": "She fiercely defied patriarchal tyranny, proclaiming she would embrace death alongside Udharan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook a