{"id": "11th_tamil_u7_q078", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "bharathidasan_paventhar_title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதிதாசனுக்குப் 'பாவேந்தர்' என்ற சிறப்புப் பெயரை வழங்கிப் போற்றிய அறிஞர் யார்?", "media_id": null}], "options": {"A": "பெரியார்", "B": "கழக அறிஞர் பெருமக்கள் மற்றும் அறிஞர் அண்ணா (\"பாவேந்தர் பாரதிதாசன்\")", "C": "வ. உ. சி.", "D": "திரு. வி. க."}, "explanation": "பாரதிதாசனின் கவிதை ஆளுமையைப் போற்றி அறிஞர் அண்ணா உள்ளிட்ட தமிழ்ச் சான்றோர்கள் அவரைப் 'பாவேந்தர்' (கவிதை மன்னர்) எனப் போற்றினர்."}, "en": {"blocks": [{"type": "text", "content": "Who popularized the reverential title 'Paventhar' (Sovereign of Verse) for Bharathidasan?", "media_id": null}], "options": {"A": "Periyar", "B": "Perarignar Anna and Tamil literary savants", "C": "V. O. C.", "D": "Thiru. Vi. Ka."}, "explanation": "He was hailed as Paventhar (Monarch of Poetry) by Perarignar Anna and Tamil scholars."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 151, "chapter": null, "section": null, "reference": "11th Tam