{"id": "11th_tamil_u7_q015", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "sundara_ramasamy_awards", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுந்தர ராமசாமிக்குத் தமிழ் இலக்கியச் சேவையைப் பாராட்டி வழங்கப்பட்ட புகழ்பெற்ற விருதுகள் எவை?", "media_id": null}], "options": {"A": "நோபல் பரிசு", "B": "ஞானபீட விருது", "C": "இயல் விருது (கனடா தமிழ் இலக்கியத் தோட்டம்) மற்றும் குமரகுருபரர் விருது", "D": "தாதாசாகேப் பால்கே விருது"}, "explanation": "சுந்தர ராமசாமிக்குக் கனடா தமிழ் இலக்கியத் தோட்டத்தின் 'இயல் விருது' உள்ளிட்ட சர்வதேச மற்றும் தேசிய இலக்கிய விருதுகள் வழங்கப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "Which prestigious literary accolade was conferred upon Sundara Ramasamy for his lifelong contribution?", "media_id": null}], "options": {"A": "Nobel Prize", "B": "Jnanpith Award", "C": "Iyal Award (Canada Tamil Literary Garden) and Kumaraguruparar Award", "D": "Dadasaheb Phalke Award"}, "explanation": "He was honored with the prestigious Iyal Lifetime Achievement Award from Canada."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-