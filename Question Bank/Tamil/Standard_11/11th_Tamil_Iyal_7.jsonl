{"id": "11th_tamil_u7_q152", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "grammar_aakkappeyarkal", "chapter_id": null, "topic_id": "vinai_aakkappeyar_sample", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்கண்டவற்றுள் 'வினை ஆக்கப்பெயர்' (Verbal derivative noun) வகைக்குச் சரியான சான்று எது?", "media_id": null}], "options": {"A": "நாட்டுப்புறத்தான்", "B": "வீட்டுக்காரன்", "C": "பணக்காரன்", "D": "ஆட்சியாளர் (ஆள் + சி + ஆளர்)"}, "explanation": "'ஆள்' என்ற வினையடியிலிருந்து 'ஆட்சி' என்ற தொழிற்பெயரும், அதிலிருந்து 'ஆட்சியாளர்' என்ற ஆக்கப்பெயரும் தோன்றியதால் இது வினை ஆக்கப்பெயராகும்; மற்றவை பெயர் ஆக்கப்பெயர்கள்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following is a classic example of a 'Verb-derived Agentive Noun' (Vinai Aakkappeyar)?", "media_id": null}], "options": {"A": "Naattuppurathaan", "B": "Veettukkaran", "C": "Panakkaran", "D": "Aatchiyaalar (from verbal root Aall)"}, "explanation": "Aatchiyaalar originates from the verbal root 'Aall' (to govern/rule)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 162, "chapter": null, "section": null, "referenc