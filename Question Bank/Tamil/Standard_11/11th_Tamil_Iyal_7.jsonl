{"id": "11th_tamil_u7_q183", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "pyq_unit7", "chapter_id": null, "topic_id": "pyq_pathitrupathu_structure", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] எட்டுத்தொகை நூல்களுள் ஒன்றான பதிற்றுப்பத்து பற்றிய சரியான கூற்றைத் தேர்ந்தெடுக்க:", "media_id": null}], "options": {"A": "இது சோழ மன்னர்களை மட்டுமே பாடும் நூல்", "B": "பத்து பத்துகளும் இன்று முழுமையாகக் கிடைக்கின்றன", "C": "சேர மன்னர்கள் பத்து பேரின் புகழைப் பாடும் புறநூல்; இதில் முதற்பத்தும் பத்தாம் பத்தும் கிடைக்கவில்லை", "D": "பாண்டிய மன்னர்களின் கொடைத்திறனைப் பாடுவது"}, "explanation": "பதிற்றுப்பத்து சேர மன்னர்களின் வரலாறு, வீரம், கொடையைப் பாடும் நூல். மொத்தம் 10 பத்துகளில் முதற்பத்தும் இறுதிப் பத்தும் கிடைக்காமல் இடைப்பட்ட 8 பத்துகளே கிடைத்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Select the TRUE statement regarding the Sangam anthology Pathitrupathu:", "media_id": null}], "options": {"A": "Celebrates Chola emperors exclusively", "B": "All ten decades survive intact today", "C": "Puram anthology eulogizing ten Chera monarchs; the 1st and 10th decades are lost, leaving decades 2 to 9 available", "D": "Praises Pandya patronage exclusively"}, "explanation": "Pathitrupathu eulogizes Chera rulers; only decades 2 through 9 are extant."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, 