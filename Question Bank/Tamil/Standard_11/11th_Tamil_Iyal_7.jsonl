{"id": "11th_tamil_u7_q187", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "pyq_unit7", "chapter_id": null, "topic_id": "pyq_bharathidasan_awards_dates", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] பாரதிதாசன் அவர்களின் எந்த நாடக நூலுக்குச் சாகித்திய அகாதெமி விருது வழங்கப்பட்டது? அவ்விருது எப்போது வழங்கப்பட்டது?", "media_id": null}], "options": {"A": "புரட்சிக்கவி (1960)", "B": "பாண்டியன் பரிசு (1965)", "C": "பிசிராந்தையார் (1969 - மறைவுக்குப் பின்)", "D": "சௌமியன் (1972)"}, "explanation": "பாரதிதாசனின் மறைவுக்குப் பின்னர், 1969-ல் அவரது 'பிசிராந்தையார்' என்னும் நாடக நூலுக்குச் சாகித்திய அகாதெமி விருது வழங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] For which dramatic work was Bharathidasan posthumously honored with the Sahitya Akademi Award in 1969?", "media_id": null}], "options": {"A": "Puratchikkavi (1960)", "B": "Pandiyan Parisu (1965)", "C": "Pisiranthaiyar (1969 - Posthumous)", "D": "Sowmiyan (1972)"}, "explanation": "Bharathidasan received the Sahitya Akademi Award posthumously in 1969 for 'Pisiranthaiyar'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edit