{"id": "11th_tamil_u7_q189", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thirukkural_unit7", "chapter_id": null, "topic_id": "padaicherukku_veera_kaliru", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"பேராண்மை என்ப தறுகண்ஒன்று உற்றக்கால்\nஊராண்மை மற்றதன் எஃகு\" - இக்குறட்பாவில் 'ஊராண்மை' என்பதற்கு உரை ஆசிரியர்கள் தரும் விளக்கம் யாது?", "media_id": null}], "options": {"A": "பகைவருக்குத் துன்பம் வந்தவிடத்து உதவி செய்தல் / புறமுதுகிட்டு ஓடும் பகைவர்மீது வேல் எறியாது அருள் புரிதல்", "B": "ஊரை ஆளும் திறமை", "C": "ஊர் மக்களோடு இணங்கி வாழ்தல்", "D": "ஊர்ப் பஞ்சாயத்து அமைத்தல்"}, "explanation": "பகைவரை எதிர்த்துப் போரிடும் வீரம் பேராண்மை; ஆனால் பகைவனுக்கு ஒரு துன்பம் அல்லது அழிவு நேரும்போது அவனுக்கு உதவுதலும் புறமுதுகிட்டோடும் பகைவனைத் தாக்காதிருத்தலும் அந்த வீரத்தின் கூர்மையான முனையாகும்."}, "en": {"blocks": [{"type": "text", "content": "In the Kural 'Paeraanmai Enba Tharukannondru Utrakkaal Ooraanmai Matttrathan Ekhu', what is the profound definition of 'Ooraanmai'?", "media_id": null}], "options": {"A": "Magnanimous chivalry towards an afflicted foe / abstaining from spearing a fleeing enemy", "B": "Administrative governance of towns", "C": "Living harmoniously with villagers", "D": "Panchayat arbitration"}, "explanation": "'Ooraanmai' represents noble chivalry: sparing or assisting a defeated/retreating enemy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 169, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 169", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Thirukkural", "Padaicherukku"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
