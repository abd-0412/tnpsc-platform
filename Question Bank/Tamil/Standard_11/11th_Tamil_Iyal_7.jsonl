{"id": "11th_tamil_u7_q029", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "thamarai_magazine", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் இலக்கிய உலகில் முற்போக்கு இலக்கியப் புரட்சியை ஏற்படுத்திய 'தாமரை' இலக்கிய இதழைத் தொடங்கியவர் யார்?", "media_id": null}], "options": {"A": "தோழர் ப. ஜீவானந்தம் (1958)", "B": "வ. உ. சி.", "C": "பாரதிதாசன்", "D": "கண்ணதாசன்"}, "explanation": "தோழர் ஜீவா 1958-இல் 'தாமரை' என்னும் முற்போக்கு இலக்கியத் திங்களிதழைத் தொடங்கி அதன் ஆசிரியராக இருந்து வழிநடத்தினார்."}, "en": {"blocks": [{"type": "text", "content": "Who founded and edited the progressive literary monthly magazine 'Thamarai' in 1958?", "media_id": null}], "options": {"A": "Comrade P. Jeevanandham (1958)", "B": "V. O. Chidambaranar", "C": "Bharathidasan", "D": "Kannadasan"}, "explanation": "Comrade Jeeva launched the progressive literary monthly 'Thamarai' in 1958."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 150, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 150", "url": null, "source_notes": null}, "pr