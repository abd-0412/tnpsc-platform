{"id": "11th_tamil_u7_q134", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_pathitrupathu", "chapter_id": null, "topic_id": "chera_navy_kadalpirakkottiya", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பதிற்றுப்பத்தில் ஐந்தாம் பத்தில் பாடப்படும் 'கடல்பிறக்கோட்டிய செங்குட்டுவன்' யாரால் பாடப்பட்டார்?", "media_id": null}], "options": {"A": "கபிலர்", "B": "பரணர்", "C": "காவேரிப்பூம்பட்டினத்துக் காரிக்கண்ணனார்", "D": "நக்கீரர்"}, "explanation": "பதிற்றுப்பத்தின் ஐந்தாம் பத்தில் கடல் பிறக்கோட்டிய செங்குட்டுவனைப் பாடிய மாபெரும் சங்கப் புலவர் பரணர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who composed the Fifth Decade of Pathitrupathu praising Cheran Senguttuvan?", "media_id": null}], "options": {"A": "Kapilar", "B": "Paranar", "C": "Karikkannanar", "D": "Nakkirar"}, "explanation": "Paranar composed the Fifth Decade celebrating Cheran Senguttuvan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 153, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 153", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null