{"id": "11th_tamil_u7_q102", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "puratchikkavi_youth_awakening", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'புரட்சிக்கவி' குறுங்காவியம் தமிழக அரசியல் மற்றும் சமுதாய வரலாற்றில் ஆற்றிய முதன்மையான வரலாற்றுப் பங்கு யாது?", "media_id": null}], "options": {"A": "மன்னர்களுக்கு ஆதரவு திரட்டியது", "B": "திராவிட இயக்கத்திற்கும், சுயமரியாதை இயக்கத்திற்கும், சமூக நீதிக்கும் இலட்சக்கணக்கான தமிழ் இளைஞர்களை ஈர்த்த புரட்சிப் பாசறையாகத் திகழ்ந்தது", "C": "சமஸ்கிருதத்தை வளர்த்தது", "D": "ஆன்மீக மடங்களை நிறுவியது"}, "explanation": "புரட்சிக்கவி காப்பியம் சுயமரியாதை, சாதி எதிர்ப்பு, மக்களாட்சி மலர்ச்சிக்கு வித்திட்டுத் தமிழக இளைஞர்களைப் பெருமளவில் கவர்ந்தது."}, "en": {"blocks": [{"type": "text", "content": "What pivotal socio-political role did 'Puratchikkavi' play in modern Tamil intellectual history?", "media_id": null}], "options": {"A": "Rallied support for kings", "B": "Served as an inspiring catalyst drawing millions of youth into social justice, anti-caste, and self-respect movements", "C": "Promoted Sanskrit", "D": "Founded monasteries"}, "explanation": "It served as a manifesto galvanizing youth toward rationalism and social democracy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"t