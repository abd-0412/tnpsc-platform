{"id": "11th_tamil_u7_q111", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "poet_weapon_pen", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதிதாசனின் 'புரட்சிக்கவி' கவிஞனின் எழுத்தாணியை எதற்கு ஒப்பாக உருவகிக்கிறது?", "media_id": null}], "options": {"A": "பூக்களுக்கு", "B": "பணப்பைகளுக்கு", "C": "மக்களை விழிப்படையச் செய்து அநீதியை வேரறுக்கும் புரட்சி வாளுக்கு", "D": "சாதாரண எழுத்துக்களுக்கு"}, "explanation": "கவிஞனின் எழுதுகோல் வாளைவிடக் கூர்மையானது; அது பாமர மக்களின் சிந்தனையைத் தட்டி எழுப்பி மாபெரும் புரட்சியை உருவாக்கும் பேராற்றல் கொண்டது என்பதை உதாரனின் பாத்திரம் உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What does Bharathidasan's 'Puratchikkavi' equate the poet's pen to?", "media_id": null}], "options": {"A": "Flowers", "B": "Money bags", "C": "A revolutionary sword awakening the masses and extirpating tyranny", "D": "Ordinary scribbling"}, "explanation": "The poet's pen is celebrated as a mighty revolutionary weapon awakening the masses."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 152, "chap