{"id": "11th_tamil_u7_q169", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thirukkural_unit7", "chapter_id": null, "topic_id": "padaimaatchi_kural", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"உறுப்பமைந்து ஊறஞ்சா வெல்படை வேந்தன்\nவெறுக்கையுள் எல்லாம் தலை\" - இத்திருக்குறளில் 'வெறுக்கை' என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "செல்வம்", "B": "வெறுப்பு", "C": "வீரம்", "D": "படைக்கலன்"}, "explanation": "இக்குறளில் 'வெறுக்கை' என்பதற்குச் 'செல்வம்' என்பது பொருளாகும். எல்லா உறுப்புகளும் நிறைந்து, போரில் அழிவுக்கு அஞ்சாமல் வெற்றி பெறும் படையே ஒரு மன்னனின் செல்வங்கள் அனைத்திலும் முதன்மையானது."}, "en": {"blocks": [{"type": "text", "content": "In the Kural verse 'Uruppamainthu Ooranjaa Velpadai Vendhan Verukkaiyul Ellaam Thalai', what does 'Verukkai' denote?", "media_id": null}], "options": {"A": "Wealth / Treasure", "B": "Disgust / Aversion", "C": "Valour", "D": "Weaponry"}, "explanation": "'Verukkai' signifies 'wealth/treasure'; an undaunted victorious army is the monarch's prime treasure."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 168, "chapter": null, "sec