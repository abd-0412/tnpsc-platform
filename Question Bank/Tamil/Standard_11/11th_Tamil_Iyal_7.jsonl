{"id": "11th_tamil_u7_q007", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "bharathi_admiration", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தோழர் ஜீவா எந்த மகாகவியின் கவிதைகளைத் தம் வாழ்நாளெல்லாம் மேடைகள்தோறும் முழங்கித் தமிழ் மக்களிடையே கொண்டு சேர்த்தார்?", "media_id": null}], "options": {"A": "கம்பன்", "B": "வள்ளுவர்", "C": "மகாகவி சுப்பிரமணிய பாரதியார்", "D": "காளமேகப் புலவர்"}, "explanation": "ஜீவா பாரதியாரின் தீவிர பக்தர்; பாரதியின் தேசிய, சமுதாய, பெண் விடுதலைக் கவிதைகளைத் தம் ಕಂಚுக் குரலால் தமிழகமெங்கும் கொண்டு சேர்த்த பெருமைக்குரியவர்."}, "en": {"blocks": [{"type": "text", "content": "Whose poetic verses did Comrade Jeeva recite with passionate thunder throughout his public life?", "media_id": null}], "options": {"A": "Kamban", "B": "Valluvar", "C": "Mahakavi Subramania Bharathiyar", "D": "Kalamegap Pulavar"}, "explanation": "Jeeva was an ardent champion who popularized Bharathi's radical poetry across the state."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 149, "chapter": null, "section": null, "reference": "11