{"id": "11th_tamil_u7_q181", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "pyq_unit7", "chapter_id": null, "topic_id": "pyq_kudumba_vilakku_contrast", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] பாரதிதாசனின் நூல்களுள் குடும்ப அமைப்பில் பெண்ணின் சிறப்பையும் கல்வியையும் வலியுறுத்தும் நூல் எது?", "media_id": null}], "options": {"A": "குடும்ப விளக்கு", "B": "இருண்ட வீடு", "C": "பாண்டியன் பரிசு", "D": "அழகின் சிரிப்பு"}, "explanation": "'குடும்ப விளக்கு' பெண் கல்வி, குடும்ப நிர்வாகம், இல்லற மேன்மையை விளக்குகிறது; கல்வி இல்லாத பெண்ணின் வீட்டை 'இருண்ட வீடு' என்று சித்திரித்தார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Which classic work of Bharathidasan extols female education and ideal family management?", "media_id": null}], "options": {"A": "Kudumba Vilakku", "B": "Irunda Veedu", "C": "Pandiyan Parisu", "D": "Azhagin Sirippu"}, "explanation": "Kudumba Vilakku highlights women's education and enlightened domestic harmony."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 150, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, P