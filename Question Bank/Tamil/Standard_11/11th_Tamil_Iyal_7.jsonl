{"id": "11th_tamil_u7_q071", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "puratchikkavignar_title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதிதாசனுக்குப் 'புரட்சிக் கவிஞர்' என்ற பட்டத்தை வழங்கிச் சிறப்பித்த தலைவர் யார்?", "media_id": null}], "options": {"A": "மகாத்மா காந்தி", "B": "திரு. வி. க.", "C": "தந்தை பெரியார் (ஈ. வெ. ரா.)", "D": "மு. வரதராசனார்"}, "explanation": "1946-இல் தந்தை பெரியார் அவர்கள் பாரதிதாசனுக்குத் தலைசிறந்த பகுத்தறிவுப் புரட்சிக் கவிதைகளுக்காகப் 'புரட்சிக் கவிஞர்' என்ற பட்டத்தையும் ரூ. 25,000 பொற்கிழியையும் வழங்கிச் சிறப்பித்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which leader conferred the title 'Puratchik Kavignar' (Revolutionary Poet) upon Bharathidasan?", "media_id": null}], "options": {"A": "Mahatma Gandhi", "B": "Thiru. Vi. Ka.", "C": "Thanthai Periyar (E. V. Ramasamy)", "D": "Mu. Varadarajanar"}, "explanation": "Thanthai Periyar honored him with the title 'Puratchik Kavignar' and a purse of Rs 25,000 in 1946."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 151, "chapter