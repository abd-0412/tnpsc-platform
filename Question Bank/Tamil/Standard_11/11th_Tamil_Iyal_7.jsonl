{"id": "11th_tamil_u7_q053", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "jeeva_poetic_quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'உழைக்கும் மக்களின் கண்ணீரைத் துடைப்பதே உண்மையான கவிதை' என்று நம்பி வாழ்ந்த மக்கள் கவிஞர் யார்?", "media_id": null}], "options": {"A": "தோழர் ப. ஜீவானந்தம்", "B": "முடியரசன்", "C": "வாணிதாசன்", "D": "சுரதா"}, "explanation": "ஜீவா இலக்கியமும் கவிதையும் அரண்மனை அந்தப்புரங்களை விட்டு வெளியேறி ஏழை உழைப்பாளியின் கண்ணீரைத் துடைக்க வேண்டும் என முழங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "Who lived by the conviction that genuine poetry must wipe away the tears of the laboring masses?", "media_id": null}], "options": {"A": "Comrade P. Jeevanandham", "B": "Mudiyarasan", "C": "Vanidasan", "D": "Suradha"}, "explanation": "Comrade Jeeva believed that true literature must serve the emancipation of the laboring poor."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 148, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 148", "url": null, "source_notes": null}, "pre