{"id": "11th_tamil_u7_q188", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "pyq_unit7", "chapter_id": null, "topic_id": "pyq_jeeva_kanniyakumari", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] தோழர் ஜீவானந்தம் அவர்கள் கன்னியாகுமரி மாவட்டம் பூதப்பாண்டியில் பிறந்தவர். இவரது இயற்பெயர் யாது?", "media_id": null}], "options": {"A": "ஜீவா", "B": "கனகலிங்கம்", "C": "பொன்னுரங்கம்", "D": "சொரிமுத்து"}, "explanation": "தோழர் ஜீவாவின் பெற்றோர் அவருக்கு இட்ட இயற்பெயர் 'சொரிமுத்து' என்பதாகும். பின்னர் மூத்தோர் அறிவுரைப்படி ஜீவானந்தம் என மாற்றிக்கொண்டார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Comrade Jeevanandham was born in Boothapandi, Kanyakumari. What was his original given birth name?", "media_id": null}], "options": {"A": "Jeeva", "B": "Kanakalingam", "C": "Ponnurangam", "D": "Sorimuthu"}, "explanation": "Comrade Jeeva's original birth name was Sorimuthu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 146, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 146", "url": null, "source_notes": null}, "previous_year": {"is_previ