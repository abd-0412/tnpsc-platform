{"id": "11th_tamil_u7_q008", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "jeeva_selfless_attire", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜீவாவின் புறத்தோற்ற ஆடை எத்தகையது எனப் பாடப்பகுதியில் பதிவு செய்யப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "விலைமதிப்பற்ற பட்டு ஆடை", "B": "மேற்கத்திய கோட் சூட் ஆடை", "C": "தங்கச் சங்கிலி அணிந்த ஆடை", "D": "எளிய கதர் வேட்டி, கதர்ச் சட்டை, தோளில் ஒரு துண்டு"}, "explanation": "ஜீவா எப்பொழுதும் எளிய கதர் வேட்டியும், கதர்ச் சட்டையும், தோளில் ஒரு கதர்த் துண்டும் மட்டுமே அணிந்து மக்கள் தலைவராக எளிமையின் சிகரமாகத் திகழ்ந்தார்."}, "en": {"blocks": [{"type": "text", "content": "How was Comrade Jeeva's characteristic outward attire depicted in the biographical text?", "media_id": null}], "options": {"A": "Expensive silk robes", "B": "Western suit and tie", "C": "Adorned with gold jewellery", "D": "Simple handloom Khadi dhoti, Khadi shirt, and an unpretentious upper cloth across his shoulder"}, "explanation": "Jeeva invariably wore simple white handspun Khadi garments with an upper cloth."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11"