{"id": "11th_tamil_u7_q047", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "jeeva_inter_caste_marriage", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சாதி மறுப்புத் திருமணங்களைத் தாமே முன்னின்று நடத்தியதோடு, தாமும் சாதி மறுப்புத் திருமணம் செய்து முன்மாதிரியாகத் திகழ்ந்தவர் யார்?", "media_id": null}], "options": {"A": "சுந்தர ராமசாமி", "B": "வ. உ. சி.", "C": "தோழர் ப. ஜீவானந்தம்", "D": "பாரதியார்"}, "explanation": "ஜீவா பல சாதிமறுப்புத் திருமணங்களை நடத்தி வைத்ததோடு, தாமும் சாதி மறுப்புத் திருமணம் புரிந்து சமூகச் சீர்திருத்தத்திற்கு முன்னோடியாக வாழ்ந்தார்."}, "en": {"blocks": [{"type": "text", "content": "Who not only officiated numerous inter-caste marriages but exemplified social reform through his own inter-caste marriage?", "media_id": null}], "options": {"A": "Sundara Ramasamy", "B": "V. O. C.", "C": "Comrade P. Jeevanandham", "D": "Bharathiyar"}, "explanation": "Comrade Jeeva actively championed and entered into an inter-caste marriage."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 148, "chapter": null, "section": null