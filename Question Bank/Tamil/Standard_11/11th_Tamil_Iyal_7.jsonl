{"id": "11th_tamil_u7_q118", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_pathitrupathu", "chapter_id": null, "topic_id": "imayavaramban_title_reason", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சேர மன்னன் நெடுஞ்சேரலாதனுக்கு 'இமயவரம்பன்' என்ற சிறப்புப் பெயர் வரக் காரணம் யாது?", "media_id": null}], "options": {"A": "இமயமலையில் பிறந்ததால்", "B": "வடதிசை நோக்கிப் படையெடுத்துச் சென்று இமயமலையைத் தன் நாட்டின் எல்லையாகக் கொண்டு, இமயத்தில் சேரரின் 'வில்' சின்னத்தைப் பொறித்ததால்", "C": "இமயமலையில் தவம் செய்ததால்", "D": "இமயத்தில் வணிகம் செய்ததால்"}, "explanation": "நெடுஞ்சேரலாதன் வடநாட்டின் மீது படையெடுத்துச் சென்று இமயமலை வரை வென்று, மலையில் சேரரின் வில் பொறித்ததால் 'இமயவரம்பன்' எனப் புகழ்பெற்றான்."}, "en": {"blocks": [{"type": "text", "content": "Why was King Neduncheralathan crowned with the exalted cognomen 'Imayavaramban'?", "media_id": null}], "options": {"A": "Born in Himalayas", "B": "Marched northward, establishing Himalayas as his boundary and engraving the Chera Bow emblem upon Himalayan rock face", "C": "Meditated in Himalayas", "D": "Traded in Himalayas"}, "explanation": "He carved the Chera bow insignia on the Himalayas, making them his northern boundary."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 153, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 153", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Poetry", "Pathitrupathu"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u7_q119", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_pathitrupathu", "chapter_id": null, "topic_id": "yavana_capture", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இமயவரம்பன் நெடுஞ்சேரலாதன் மேற்குக் கடற்கரையில் அத்துமீறிய யவனர்களைச் (ரோமானியர்/கிரேக்கர்) சிறைபிடித்து என்ன செய்ததாகப் பதிற்றுப்பத்துப் பதிகம் குறிப்பிடுகிறது?", "media_id": null}], "options": {"A": "கொன்றான்", "B": "தன் நாட்டில் குடியேற்றினான்", "C": "யவனர்களின் கைகளைப் பின்னால் கட்டிக் தலையில் நெய் ஊற்றி இழுத்து வந்து அவர்தம் செல்வங்களைப் பறித்தான்", "D": "கப்பலில் ஏற்றி அனுப்பினான்"}, "explanation": "கடற்கொள்ளையில் ஈடுபட்ட யவனர்களை அடக்கிச் சிறைபிடித்து, அவர்களது கைகளைப் பிணித்து நெய் ஊற்றி அவமானப்படுத்திச் சேரநாட்டிற்குக் கொண்டுவந்தான் என்று பதிற்றுப்பத்துப் பதிகம் பாடுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What does the Pathigam of Pathitrupathu record regarding Neduncheralathan's punitive capture of arrogant Yavana seafarers?", "media_id": null}], "options": {"A": "Executed them", "B": "Settled them as citizens", "C": "Bound their arms behind, poured ghee over their heads, paraded them in humiliation, and confiscated their treasures", "D": "Repatriated them"}, "explanation": "He captured predatory Yavanas, humiliated them by pouring ghee on their heads, and confiscated their wealth."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, 