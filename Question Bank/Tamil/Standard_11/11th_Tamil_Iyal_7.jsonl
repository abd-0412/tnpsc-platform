{"id": "11th_tamil_u7_q088", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "mass_revolution_erupts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உதாரனின் உரையும் அமுதவல்லியின் தியாகமும் அங்குத் திரண்டிருந்த மக்களிடையே எத்தகைய மாற்றத்தை ஏற்படுத்தியது?", "media_id": null}], "options": {"A": "மக்கள் அமைதியாக கலைந்து சென்றனர்", "B": "மன்னனின் ஆணையை ஆதரித்தனர்", "C": "அச்சத்தில் கண்களை மூடிக்கொண்டனர்", "D": "மக்களின் உள்ளங்களில் அடக்கி வைக்கப்பட்டிருந்த கோபம் எரிமலையாக வெடித்து, மன்னராட்சிக்கு எதிராகப் பெரும் புரட்சியாக உருவெடுத்தது"}, "explanation": "காதலர்களின் தியாகத்தைக் கண்ட மக்கள் கூட்டம் கொதித்தெழுந்து, 'அரசனே நிறுத்து உன் கொடுங்கோன்மையை!' என ஆயுதங்களைத் தூக்கிக் கொண்டு புரட்சியில் குதித்தது."}, "en": {"blocks": [{"type": "text", "content": "What seismic reaction did Udharan's speech and Amuthavalli's heroism ignite among the gathered masses?", "media_id": null}], "options": {"A": "Crowd dispersed in silence", "B": "Cheered the royal decree", "C": "Shut their eyes in panic", "D": "Latent popular outrage erupted like a volcano into a full-scale proletarian revolution against monarchical autocracy"}, "explanation": "The multitude rose in thunderous revolt against the tyrant king."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "sourc