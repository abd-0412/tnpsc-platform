{"id": "11th_tamil_u7_q172", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "glossary_unit7", "chapter_id": null, "topic_id": "vocabulary_matching_unit7", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல் 7-ல் இடம்பெற்றுள்ள ஆங்கிலக் கலைச்சொல்லான 'Playwright' என்பதற்கு இணையான தமிழ்ச்சொல் எது?", "media_id": null}], "options": {"A": "நடிகர்", "B": "இயக்குநர்", "C": "ஒப்பனையாளர்", "D": "நாடக ஆசிரியர்"}, "explanation": "'Playwright' என்பதன் சரியான தமிழ்க் கலைச்சொல் 'நாடக ஆசிரியர்' என்பதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the standard Tamil equivalent for the English literary term 'Playwright' in Unit 7 glossary?", "media_id": null}], "options": {"A": "Actor (Nadigar)", "B": "Director (Iyakkunar)", "C": "Make-up artist (Oppanaiyaalar)", "D": "Playwright / Dramatist (Naadaga Aasiriyar)"}, "explanation": "'Playwright' translates directly as 'Naadaga Aasiriyar'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 170, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 170", "url": null, "source_notes": null}, "previous_year": {"is_previous_year":