{"id": "12th_tamil_u7_q1225", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "athisaya_malar", "chapter_id": null, "topic_id": "nature_healing_concept", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அதிசய மலர்’ கவிதையில் இயற்கை எத்தகைய ஆற்றல் கொண்டதாகக் காட்டப்படுகிறது?", "media_id": null}], "options": {"A": "மனிதன் நிகழ்த்திய போர்க் காயங்களை ஆற்றி மீண்டும் உயிர்ப்பிக்கும் தாயுள்ளம் கொண்ட ஆற்றல்", "B": "மனிதனை அழிக்கும் கொடிய ஆற்றல்", "C": "செயலற்ற தன்மை", "D": "வெறும் பாறை நிலம்"}, "explanation": "மனிதனின் குண்டு வீச்சுகளால் புண்பட்ட நிலத்தை, தன் மடியில் மலர்களைப் பூக்கச் செய்து மீண்டும் அழகுபடுத்தும் இயற்கையின் குணப்படுத்தும் பேராற்றல் இக்கவிதையில் போற்றப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "How is Nature personified in Thamizhnathi's poem 'Athisaya Malar'?", "media_id": null}], "options": {"A": "As a compassionate maternal force healing man-made wartime scars through floral rebirth", "B": "As a vindictive destructive fury", "C": "As passive inert matter", "D": "As barren rock"}, "explanation": "Nature is portrayed as a maternal healing presence restoring beauty over human destruction."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpor