{"id": "12th_tamil_u7_q1345", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "tnpsc_model_iyal7", "chapter_id": null, "topic_id": "tnpsc_pyq_iraiyanbu_ias", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC Group 4 2019] தமிழ் இலக்கிய நூல்களை நவீன நிருவாக இயலோடு ஒப்பிட்டு நூல்களைப் படைத்த முன்னாள் தலைமைச் செயலாளர் யார்?", "media_id": null}], "options": {"A": "முனைவர் வெ. இறையன்பு இ.ஆ.ப.", "B": "முனைவர் கா. மீனாட்சிசுந்தரம்", "C": "மு. வரதராசனார்", "D": "தெ.பொ. மீனாட்சிசுந்தரனார்"}, "explanation": "வெ. இறையன்பு அவர்கள் இலக்கிய மேலாண்மை, நேர மேலாண்மை, தலைமைப் பண்பு குறித்துப் பல சிறந்த நூல்களை எழுதியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Group 4 2019] Who is the former Chief Secretary who authored works comparing Tamil classical literature with modern management?", "media_id": null}], "options": {"A": "Dr. V. Irai Anbu I.A.S.", "B": "Dr. K. Meenakshisundaram", "C": "Mu. Varadarajanar", "D": "T.P. Meenakshisundaranar"}, "explanation": "Dr. V. Irai Anbu I.A.S. pioneered comparative studies between Tamil literature and modern corporate governance."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_yea