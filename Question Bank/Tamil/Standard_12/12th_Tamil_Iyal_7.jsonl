{"id": "12th_tamil_u7_q1220", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "theyilai_thotta_paattu", "chapter_id": null, "topic_id": "raavuthar_period", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பாரத மக்களின் பரிதாபச் சிந்து’ பாடல் எந்தக் காலகட்டத்தில் அச்சிடப்பட்டு மக்களிடையே விழிப்புணர்வை ஏற்படுத்தியது?", "media_id": null}], "options": {"A": "இருபத்தோராம் நூற்றாண்டு", "B": "பதினெட்டாம் நூற்றாண்டு", "C": "பதினாறாம் நூற்றாண்டு", "D": "இருபதாம் நூற்றாண்டின் தொடக்கத்தில் (பிரிட்டிஷ் காலனி ஆதிக்கக் காலம்)"}, "explanation": "இருபதாம் நூற்றாண்டின் தொடக்கத்தில் ஆங்கிலேயர் ஆட்சியில் தமிழர்கள் பட்ட அவலங்களை வெளிக்கொணரும் வண்ணம் இச்சிந்துப் பாடல்கள் நூலாகப் பதிப்பிக்கப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "During which historical period was Mohamed Raavuthar's 'Parithaapach Sinthu' printed to arouse public conscience?", "media_id": null}], "options": {"A": "21st century", "B": "18th century", "C": "16th century", "D": "Early twentieth century under British colonial rule"}, "explanation": "The folk ballad was printed and distributed in the early 20th century."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_