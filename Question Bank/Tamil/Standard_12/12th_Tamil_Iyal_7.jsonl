{"id": "12th_tamil_u7_q1214", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "theyilai_thotta_paattu", "chapter_id": null, "topic_id": "indenture_historical_context", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிரிட்டிஷ் ஆட்சியில் பத்தொன்பதாம் நூற்றாண்டில் எந்தக் கொடுமையான பஞ்சத்தின் காரணமாகத் தமிழக மக்கள் இலங்கைக்குத் தோட்டத் தொழிலாளர்களாகக் கொண்டுசெல்லப்பட்டனர்?", "media_id": null}], "options": {"A": "வங்காளப் பஞ்சம்", "B": "தாது வருடப் பஞ்சம் (1876-1878 பெரும் பஞ்சம்)", "C": "ஒடிசா பஞ்சம்", "D": "பீகார் பஞ்சம்"}, "explanation": "1876-1878-இல் தமிழகத்தைப் புரட்டிப் போட்ட 'தாது வருடப் பஞ்சத்தின்' போது உணவின்றித் தவித்த மக்களை கங்காணிகள் ஆசை காட்டி இலங்கைக்குக் கொண்டு சென்றனர்."}, "en": {"blocks": [{"type": "text", "content": "During which devastating 19th-century famine were masses of starving Tamil peasants exported to Ceylon tea estates?", "media_id": null}], "options": {"A": "Bengal famine", "B": "Great Famine of 1876-1878 (Thaathu Varuda Panjam)", "C": "Orissa famine", "D": "Bihar famine"}, "explanation": "The Great Famine of 1876-78 drove starving peasants into indentured labor across Ceylon."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "c