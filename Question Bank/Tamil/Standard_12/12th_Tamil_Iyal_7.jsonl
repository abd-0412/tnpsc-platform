{"id": "12th_tamil_u7_q1203", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "conflict_resolution", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நிறுவனங்களில் எழும் கருத்து மோதல்களைத் தீர்க்கும் ‘முரண்பாடு மேலாண்மைக்கு’ (Conflict Management) வள்ளுவர் கூறும் அறிவுரை யாது?", "media_id": null}], "options": {"A": "பகைவரை உடனே அழித்தல்", "B": "அமைதியாக விலகி விடுதல்", "C": "பகைவனுக்கும் அருளும் இன்சொல்லும் நடுவுநிலைமையும் கடைப்பிடித்தல்", "D": "காவல்துறையை நாடுதல்"}, "explanation": "இன்சொல் பேசுதல், நடுவுநிலை தவறாமை, பகையுணர்வைக் கனிவோடு மாற்றுதல் ஆகியவற்றின் வழியே முரண்பாடுகளைச் சுமுகமாகத் தீர்க்கலாம் என்கிறார் வள்ளுவர்."}, "en": {"blocks": [{"type": "text", "content": "What classical advice does Thirukkural offer for constructive Conflict Management and negotiation?", "media_id": null}], "options": {"A": "Immediate violent destruction of adversaries", "B": "Passive surrender", "C": "Sweet conciliatory speech, scrupulous impartiality, and transforming foes through magnanimity", "D": "Police litigations"}, "explanation": "Constructive conflict resolution hinges upon gracious speech and unswerving equity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher":