{"id": "12th_tamil_u7_q1272", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sangkakala_kalvettu", "chapter_id": null, "topic_id": "epigraphy_pioneer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கல்வெட்டுகளின் அரசி’ என்றும் ‘தமிழ்க் கல்வெட்டியலின் தந்தை’ என்றும் போற்றப்படும் முன்னோடி அறிஞர் யார்?", "media_id": null}], "options": {"A": "ஐராவதம் மகாதேவன்", "B": "ராபர்ட் புரூஸ் பூட்", "C": "யுவான் சுவாங்", "D": "கே.வி. சுப்பிரமணிய ஐயர்"}, "explanation": "கே.வி. சுப்பிரமணிய ஐயர் தமிழ்க் கல்வெட்டியலின் அறிவியல் பூர்வ ஆய்வுகளுக்கு அடித்தளமிட்ட முன்னோடி ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who is hailed as the pioneer and father figure of Tamil epigraphy who first decoded cave records?", "media_id": null}], "options": {"A": "Iravatham Mahadevan", "B": "Robert Bruce Foote", "C": "Hiuen Tsang", "D": "K.V. Subramaniya Iyer"}, "explanation": "K.V. Subramaniya Iyer laid the scientific foundation for Tamil epigraphy by first deciphering cave scripts as Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 181, "chapter": null, "section": null, "reference": "12th Tamil