{"id": "12th_tamil_u7_q1279", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sangkakala_kalvettu", "chapter_id": null, "topic_id": "cave_rock_shelters", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்-பிராமிக் கல்வெட்டுகள் பெரும்பாலும் எவ்வகையான இடங்களில் பொறிக்கப்பட்டுள்ளன?", "media_id": null}], "options": {"A": "மண் சுவர்கள் மீது", "B": "மரப்பலகைகள் மீது", "C": "இயற்கையான மலைக் குகைகளில் அமைந்த வழவழப்பான பாறை விளிம்புகள் மற்றும் படுக்கைகள்", "D": "ஆற்றங்கரைப் படிவுகள்"}, "explanation": "இயற்கையான மலைக் குகைகளில் மழை நீர் படுக்கைகளுக்குள் புகாதவாறு பாறை விளிம்புகளை வெட்டி (Drip-ledge) சமணத் துறவிகளின் படுக்கைகளில் பொறிக்கப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "In what type of natural settings are Tamil-Brahmi inscriptions predominantly found?", "media_id": null}], "options": {"A": "On earthen walls", "B": "On wooden planks", "C": "Smooth natural rock shelters and cave beds (drip-ledges)", "D": "River bed silts"}, "explanation": "They are chiseled on smooth rock cut beds and overhang drip-ledges of natural hill caves where Jain monks took shelter."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_