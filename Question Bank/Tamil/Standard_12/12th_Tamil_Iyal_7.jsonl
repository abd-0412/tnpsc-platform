{"id": "12th_tamil_u7_q1273", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sangkakala_kalvettu", "chapter_id": null, "topic_id": "dinamani_editor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஐராவதம் மகாதேவன் தினமணி நாளிதழின் ஆசிரியராகப் பணியாற்றிய காலக்கட்டம் எது?", "media_id": null}], "options": {"A": "1987 முதல் 1991 வரை", "B": "1970 முதல் 1975 வரை", "C": "1995 முதல் 2000 வரை", "D": "1960 முதல் 1965 வரை"}, "explanation": "ஐ.ஏ.எஸ் பணியிலிருந்து விருப்ப ஓய்வு பெற்ற பின்னர் அவர் 1987 முதல் 1991 வரை தினமணி நாளிதழின் ஆசிரியராகப் பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "During which period did Iravatham Mahadevan serve as the Editor of the renowned daily newspaper 'Dinamani'?", "media_id": null}], "options": {"A": "1987 to 1991", "B": "1970 to 1975", "C": "1995 to 2000", "D": "1960 to 1965"}, "explanation": "After taking voluntary retirement from the IAS, he served as the Editor of Dinamani newspaper from 1987 to 1991."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 184, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 184", "url": nul