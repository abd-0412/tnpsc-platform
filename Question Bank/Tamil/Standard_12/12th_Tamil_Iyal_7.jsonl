{"id": "12th_tamil_u7_q1202", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "uraiyanbu_chief_secretary_tenure", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முனைவர் வெ. இறையன்பு அவர்கள் தமிழ்நாடு அரசின் எத்தனையாவது தலைமைச் செயலாளராகப் பணியாற்றி ஓய்வு பெற்றார்?", "media_id": null}], "options": {"A": "நாற்பதாவது", "B": "நாற்பத்தேழாவது (47-ஆவது தலைமைச் செயலாளர்)", "C": "ஐம்பதாவது", "D": "முப்பத்தைந்தாவது"}, "explanation": "வெ. இறையன்பு தமிழ்நாடு அரசின் 47-ஆவது தலைமைச் செயலாளராக 2021 முதல் 2023 வரை மிகச் சிறப்பாகப் பணியாற்றி ஓய்வு பெற்றார்."}, "en": {"blocks": [{"type": "text", "content": "As which Chief Secretary of the Government of Tamil Nadu did Dr. V. Irai Anbu I.A.S. serve with distinction?", "media_id": null}], "options": {"A": "40th Chief Secretary", "B": "47th Chief Secretary (2021 to 2023)", "C": "50th Chief Secretary", "D": "35th Chief Secretary"}, "explanation": "Dr. Irai Anbu served as the 47th Chief Secretary of Tamil Nadu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "ref