{"id": "12th_tamil_u7_q1326", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mozhippayirchi_iyal7", "chapter_id": null, "topic_id": "marabuththodar_mudhalai_kanneer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘முதலைக் கண்ணீர்’ என்னும் மரபுத் தொடர் உணர்த்தும் உட்கருத்து என்ன?", "media_id": null}], "options": {"A": "உண்மையான அழுகை", "B": "போலியான வருத்தம் / ஏமாற்று வித்தை", "C": "முதலையின் உணவுப் பழக்கம்", "D": "ஆழ்கடல் பயணம்"}, "explanation": "'முதலைக் கண்ணீர் வடித்தல்' என்பது உள்ளத்தில் இரக்கமின்றிப் புறத்தே மட்டும் நடிப்பவர்களின் போலி வருத்தத்தைக் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "What underlying meaning is conveyed by the idiom 'Muthalai Kanneer' (Crocodile tears)?", "media_id": null}], "options": {"A": "Genuine weeping", "B": "Feigned sorrow / Hypocritical pretense", "C": "Crocodile's eating habit", "D": "Deep sea voyage"}, "explanation": "'Crocodile tears' represents insincere, hypocritical display of sorrow."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 189, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 189", "url"