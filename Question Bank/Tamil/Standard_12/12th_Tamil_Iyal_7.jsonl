{"id": "12th_tamil_u7_q1305", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "indira_parthasarathy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அசுவத்தாமன்’ என்னும் மகாபாரதக் கதாபாத்திரத்தின் தீராத சாபத்தை நவீன மனிதனின் தார்மீகக் குற்ற உணர்ச்சிக்கு ஒப்பிட்டு நாடகம் எழுதியவர் யார்?", "media_id": null}], "options": {"A": "இந்திரா பார்த்தசாரதி (ஔரங்கசீப் / தர்மம் நாடகங்கள்)", "B": "சுஜாதா", "C": "நா. பார்த்தசாரதி", "D": "ஜெயகாந்தன்"}, "explanation": "இந்திரா பார்த்தசாரதி தொன்மங்களையும் வரலாற்றுக் கதைமாந்தர்களையும் நவீன மனிதனின் அகமுரண்களை ஆராயும் நாடகக் குறியீடுகளாகப் பயன்படுத்தியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who deployed the Mahabharata figure of Ashwatthama cursed with incurable wounds to signify modern man's moral guilt?", "media_id": null}], "options": {"A": "Indira Parthasarathy", "B": "Sujatha", "C": "Na. Parthasarathy", "D": "Jayakanthan"}, "explanation": "Indira Parthasarathy effectively employed mythic characters to dissect the ethical angst and guilt of contemporary human civilization."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_