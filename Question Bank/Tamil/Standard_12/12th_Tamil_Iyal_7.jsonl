{"id": "12th_tamil_u7_q1251", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "purananooru_pisiranthaiyar", "chapter_id": null, "topic_id": "gu_pope_purananooru_extracts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜி.யு. போப் புறநானூற்றுப் பாடல்களில் சிலவற்றை எந்த மொழியில் மொழிபெயர்த்து வெளியிட்டார்?", "media_id": null}], "options": {"A": "ஜெர்மன்", "B": "பிரெஞ்சு", "C": "ஆங்கிலம்", "D": "இலத்தீன்"}, "explanation": "ஜி.யு. போப் அவர்கள் புறநானூற்றுப் பாடல்களின் அறக்கருத்துகளை வியந்து போற்றி ஆங்கில மொழியில் மொழிபெயர்த்து வெளியிட்டார்."}, "en": {"blocks": [{"type": "text", "content": "Into which language did missionary-scholar G.U. Pope translate selected ethical gems of Purananooru?", "media_id": null}], "options": {"A": "German", "B": "French", "C": "English", "D": "Latin"}, "explanation": "Rev. G.U. Pope translated selected verses of Purananooru into English verse."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 166, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 166", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "ex