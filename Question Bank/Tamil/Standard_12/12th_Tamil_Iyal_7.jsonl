{"id": "12th_tamil_u7_q1215", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "theyilai_thotta_paattu", "chapter_id": null, "topic_id": "ceylon_tea_geography", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலங்கையில் தமிழ்த் தொழிலாளர்கள் பெருமளவில் குடியேற்றப்பட்ட தேயிலைத் தோட்ட மலைப் பகுதிகள் எவை?", "media_id": null}], "options": {"A": "கொழும்பு கடற்கரை", "B": "யாழ்ப்பாணம்", "C": "கண்டி, நுவரெலியா, பதுளை போன்ற மத்திய மலைநாட்டுப் பகுதிகள்", "D": "மன்னார் தீவு"}, "explanation": "இலங்கையின் மத்திய மலைநாடான கண்டி, நுவரெலியா, இரத்தினபுரி, பதுளை ஆகிய மலைப்பிரதேசங்களில் அமைந்த தேயிலைத் தோட்டங்களில்தான் தமிழர்கள் கொத்தடிமைகளாக உழைத்தனர்."}, "en": {"blocks": [{"type": "text", "content": "In which central highland hill districts of Ceylon were Tamil indentured laborers concentrated?", "media_id": null}], "options": {"A": "Colombo coast", "B": "Jaffna peninsula", "C": "Kandy, Nuwara Eliya, Badulla, and central highland ranges", "D": "Mannar Island"}, "explanation": "Workers cleared dense montane jungles across Kandy, Nuwara Eliya, and Badulla for British tea estates."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition