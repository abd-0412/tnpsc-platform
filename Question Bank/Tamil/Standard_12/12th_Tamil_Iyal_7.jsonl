{"id": "12th_tamil_u7_q1366", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "tnpsc_model_iyal7", "chapter_id": null, "topic_id": "tnpsc_pyq_thathuvuruda_panjam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC Group 4 2019] தமிழகத்தில் பல்லாயிரக்கணக்கான மக்கள் பட்டினியால் மடியக் காரணமான ‘தாது வருடப் பஞ்சம்’ ஏற்பட்ட ஆங்கில ஆண்டு எது?", "media_id": null}], "options": {"A": "1857", "B": "1876 - 1877", "C": "1905", "D": "1947"}, "explanation": "1876-1877 ஆம் ஆண்டுகளில் ஆங்கிலேயர் ஆட்சிக்காலத்தில் ஏற்பட்ட கோரப் பஞ்சமே 'தாது வருடப் பஞ்சம்' என அழைக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Group 4 2019] In which English calendar years did the tragic 'Thathu Varuda Famine' strike Tamil Nadu?", "media_id": null}], "options": {"A": "1857", "B": "1876 - 1877", "C": "1905", "D": "1947"}, "explanation": "The Great Famine of 1876-1877 under colonial British administration is historically known as 'Thathu Varuda Panjam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 174, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 174", "url": null, "s