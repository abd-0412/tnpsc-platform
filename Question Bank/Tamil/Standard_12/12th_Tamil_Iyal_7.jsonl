{"id": "12th_tamil_u7_q1372", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "tnpsc_model_iyal7", "chapter_id": null, "topic_id": "tnpsc_pyq_iyal7_synthesis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC Group 1 2020] ‘பழமை என்பது இறந்த காலம் அன்று; அது நிகழ் காலத்திலும் எதிர்காலத்திலும் ஒளிவீசும் வழிகாட்டி’ - 12-ஆம் வகுப்பு இயல் 7 உணர்த்தும் ஒருங்கிணைந்த மையக்கருத்து யாது?", "media_id": null}], "options": {"A": "பழைய முறைகளை மாற்றாமல் பின்பற்றுவது", "B": "நவீன கண்டுபிடிப்புகளை நிராகரிப்பது", "C": "எழுத்துக்களை மட்டும் சேமிப்பது", "D": "இலக்கியம், கல்வெட்டுகள், தொன்மங்கள் ஆகியவற்றில் உள்ள மேலாண்மைக் கோட்பாடுகளை உள்வாங்கி இன்றைய மனித வாழ்வைச் செழுமைப்படுத்துதல்"}, "explanation": "இயல் 7 இலக்கிய மேலாண்மை, கல்வெட்டுகள், மரபுத் தொன்மங்கள் வழியாக நம் முன்னோர்களின் அறிவார்ந்த அனுபவங்களை இன்றைய மேலாண்மைக்கும் வாழ்விற்கும் பயன்படுத்த வழிகாட்டுகிறது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Group 1 2020] 'The past is not dead; it is a radiant torch illuminating the present and future' - What is the synoptic synthesis of Unit 7?", "media_id": null}], "options": {"A": "Blindly clinging to old ways", "B": "Rejecting modern scientific progress", "C": "Merely stockpiling stone inscriptions", "D": "Assimilating ancient managerial wisdom from literature, epigraphs, and archetypal myths to enrich modern human civilization"}, "explanation": "Unit 7 synthesizes historical epigraphs, literature, and archetypes to guide modern administrative and humanitarian excellence."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 187, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 187", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "TNPSC PYQ", "Unit Synthesis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
