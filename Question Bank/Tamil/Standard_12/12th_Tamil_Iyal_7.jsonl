{"id": "12th_tamil_u7_q1240", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "purananooru_pisiranthaiyar", "chapter_id": null, "topic_id": "righteous_king_reason", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிசிராந்தையார் வாழ்ந்த நாட்டின் மன்னன் எத்தகைய நல்லாட்சியை வழங்கியதாகக் குறிப்பிடுகிறார்?", "media_id": null}], "options": {"A": "வரி அதிகப்படுத்தினான்", "B": "போர்களை மட்டுமே நடத்தினான்", "C": "மக்களைக் கண்டுகொள்ளவில்லை", "D": "‘வேந்தனும் அல்லவை செய்யான் காக்கும்’ - மன்னன் அறநெறி தவறித் தீய செயல்களைச் செய்யாமல் நன்னெறியில் மக்களைக் காத்தான்"}, "explanation": "நாட்டை ஆளும் மன்னன் அறநெறியிலிருந்து வழுவாமல், தீமைகளைச் செய்யாமல் குடிமக்களை நீதியோடு காத்து நின்றதால் கவலையின்றி வாழ்ந்ததாகப் புலவர் கூறுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "How is the sovereign ruler described in the verse regarding good governance ('Vaenthanum allavai seiyaan kaakkum')?", "media_id": null}], "options": {"A": "Imposed crushing taxes", "B": "Waged constant wars", "C": "Neglected his subjects", "D": "The king refrained from unrighteous deeds and shielded the subjects with justice"}, "explanation": "The monarch shunned injustice and governed with equity, sparing subjects from distress."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Sama