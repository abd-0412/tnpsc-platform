{"id": "12th_tamil_u7_q1242", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "purananooru_pisiranthaiyar", "chapter_id": null, "topic_id": "thinai_and_thurai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இப்புறநானூற்றுப் பாடல் எந்தத் திணையையும் துறையையும் சார்ந்தது?", "media_id": null}], "options": {"A": "வாகைத் திணை; அரச வாகைத் துறை", "B": "பொதுவியல் திணை; பொருண்மொழிக் காஞ்சித் துறை", "C": "காஞ்சித் திணை; பெருங்காஞ்சித் துறை", "D": "கரந்தைத் திணை; போர்க்களத் துறை"}, "explanation": "எல்லாத் திணைகளுக்கும் பொதுவான நீதியை உரைப்பதால் 'பொதுவியல் திணை' எனவும்; மக்களுக்கு நலம் பயக்கும் உறுதிப் பொருள்களைக் கூறுவதால் 'பொருண்மொழிக் காஞ்சித் துறை' எனவும் அமைகிறது."}, "en": {"blocks": [{"type": "text", "content": "What Thinai (poetic genre) and Thurai (sub-category) classify this Purananooru philosophical verse?", "media_id": null}], "options": {"A": "Vaagai Thinai; Arasa Vaagai Thurai", "B": "Pothuviyal Thinai; Porunmozhik Kaanji Thurai", "C": "Kaanji Thinai; Perungkaanji Thurai", "D": "Karanthhai Thinai; Battle Thurai"}, "explanation": "Classified under Pothuviyal Thinai (General Ethics) and Porunmozhik Kaanji Thurai (Words of Truth)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educati