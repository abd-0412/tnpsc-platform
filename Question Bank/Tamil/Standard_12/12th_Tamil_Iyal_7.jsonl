{"id": "12th_tamil_u7_q1330", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mozhippayirchi_iyal7", "chapter_id": null, "topic_id": "noolveli_tamilnadhi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அதிசய மலர்’ கவிதையின் ஆசிரியர் தமிழ்நதி (கலைவாணி) பிறந்த மண் எது?", "media_id": null}], "options": {"A": "தமிழ்நாடு தஞ்சாவூர்", "B": "இலங்கை யாழ்ப்பாணம் (திருகோணமலை)", "C": "மலேசியா பினாங்கு", "D": "சிங்கப்பூர்"}, "explanation": "ஈழத்துப் பெண் கவிஞரான தமிழ்நதி (இயற்பெயர்: கலைவாணி) இலங்கையின் திருகோணமலையில் பிறந்து யாழ்ப்பாணப் பல்கலைக்கழகத்தில் பயின்றவர்."}, "en": {"blocks": [{"type": "text", "content": "What is the birthplace of Tamilnadhi (Kalaivani), author of the poem 'Athisaya Malar'?", "media_id": null}], "options": {"A": "Thanjavur in Tamil Nadu", "B": "Trincomalee / Jaffna in Sri Lanka", "C": "Penang in Malaysia", "D": "Singapore"}, "explanation": "Eelam poet Tamilnadhi was born in Trincomalee, Sri Lanka, and graduated from the University of Jaffna."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 171, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 1