{"id": "12th_tamil_u7_q1329", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mozhippayirchi_iyal7", "chapter_id": null, "topic_id": "noolveli_ve_iraiyanbu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முனைவர் வெ. இறையன்பு இ.ஆ.ப. அவர்கள் எழுதியவற்றுள் தமிழ்நாடு அரசின் சிறந்த நூலுக்கான பரிசு பெற்ற நூல் எது?", "media_id": null}], "options": {"A": "வாய்க்கால் மீன்கள்", "B": "படிப்பது சுகமே", "C": "உள்ளொளிப் பயணம்", "D": "மேலாண்மைப் பொன்மொழிகள்"}, "explanation": "வெ. இறையன்பு எழுதிய 'வாய்க்கால் மீன்கள்' என்னும் கவிதைத் தொகுப்பு 1995-ஆம் ஆண்டிற்கான தமிழ்நாடு அரசின் சிறந்த நூலுக்கான பரிசைப் பெற்றது."}, "en": {"blocks": [{"type": "text", "content": "Which work authored by Dr. V. Irai Anbu I.A.S. won the Tamil Nadu State Government Best Book Award?", "media_id": null}], "options": {"A": "Vaikkaal Meengal", "B": "Padippadhu Sugame", "C": "Ullolip Payanam", "D": "Melaanmai Ponmozhigal"}, "explanation": "His acclaimed poetry volume 'Vaikkaal Meengal' won the prestigious Tamil Nadu State Government Award in 1995."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 165, "chapter": null, "section": n