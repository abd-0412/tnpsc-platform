{"id": "12th_tamil_u7_q1276", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sangkakala_kalvettu", "chapter_id": null, "topic_id": "pittan_kotran", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புகழூர்க் கல்வெட்டில் குறிப்பிடப்படும் 'பிட்டன் கொற்றன்' என்பவன் சங்ககாலத்தில் எத்தகைய சிறப்பு வாய்ந்த தலைவன்?", "media_id": null}], "options": {"A": "பாண்டிய அரசன்", "B": "சோழ மன்னன்", "C": "சமண ஆசாரியர்", "D": "சேர மன்னனின் படைத்தலைவன் / குறுநில மன்னன்"}, "explanation": "பிட்டன், கொற்றன் என்ற பெயர்கள் சங்க இலக்கியங்களில் சேர நாட்டின் படைத்தலைவர்களாகவும் குறுநிலத் தலைவர்களாகவும் பேசப்படுகின்றனர்."}, "en": {"blocks": [{"type": "text", "content": "Who was Pittan Kotran mentioned in the Pugalur inscription in the context of Sangam history?", "media_id": null}], "options": {"A": "Pandya king", "B": "Chola king", "C": "Jain monk", "D": "Chera commander / Sangam chieftain"}, "explanation": "Pittan and Kotran are celebrated in Sangam anthologies as valiant military commanders and chieftains under the Cheras."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 182, "chapter": null, "section": null, "refe