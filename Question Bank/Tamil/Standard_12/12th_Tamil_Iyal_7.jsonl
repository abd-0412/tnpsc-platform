{"id": "12th_tamil_u7_q1270", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sangkakala_kalvettu", "chapter_id": null, "topic_id": "padma_shri_award", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மத்திய அரசு ஐராவதம் மகாதேவனின் வரலாற்று ஆய்வுகளைப் பாராட்டி 2009-ஆம் ஆண்டு வழங்கிய உயரிய குடிமக்கள் விருது எது?", "media_id": null}], "options": {"A": "பத்ம விபூஷண்", "B": "பத்மஸ்ரீ", "C": "பாரத ரத்னா", "D": "பத்ம பூஷண்"}, "explanation": "ஐராவதம் மகாதேவனின் தொல்லியல் மற்றும் கல்வெட்டியல் பணிகளுக்காக 2009-இல் மத்திய அரசு அவருக்கு 'பத்மஸ்ரீ' விருது வழங்கிச் சிறப்பித்தது."}, "en": {"blocks": [{"type": "text", "content": "Which prestigious civilian honor was conferred upon Iravatham Mahadevan by the Government of India in 2009 in recognition of his historical research?", "media_id": null}], "options": {"A": "Padma Vibhushan", "B": "Padma Shri", "C": "Bharat Ratna", "D": "Padma Bhushan"}, "explanation": "The Government of India conferred the prestigious 'Padma Shri' award on Iravatham Mahadevan in 2009."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 184, "chapter": null, "section": null, "refer