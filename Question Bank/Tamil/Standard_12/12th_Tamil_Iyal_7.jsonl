{"id": "12th_tamil_u7_q1249", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "purananooru_pisiranthaiyar", "chapter_id": null, "topic_id": "purananooru_english_translation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புறநானூற்றுப் பாடல்களை ஆங்கிலத்தில் ‘The 400 Songs of War and Wisdom’ என்னும் தலைப்பில் மொழிபெயர்த்த அறிஞர் யார்?", "media_id": null}], "options": {"A": "ஏ.கே. ராமானுஜன் மற்றும் ஜார்ஜ் எல். ஹார்ட் (George L. Hart)", "B": "ஜி.யு. போப் மட்டும்", "C": "வீரமாமுனிவர்", "D": "கால்டுவெல்"}, "explanation": "பேராசிரியர் ஜார்ஜ் எல். ஹார்ட் மற்றும் ஹாங்க் ஹெயிஃபெட்ஸ் இணைந்து புறநானூற்றை ஆங்கிலத்தில் முழுமையாக மொழிபெயர்த்துள்ளனர்."}, "en": {"blocks": [{"type": "text", "content": "Which international Indologist scholar translated Purananooru into English under 'The 400 Songs of War and Wisdom'?", "media_id": null}], "options": {"A": "George L. Hart (with Hank Heifetz)", "B": "G.U. Pope solely", "C": "Constanzo Beschi", "D": "Robert Caldwell"}, "explanation": "Professor George L. Hart published the acclaimed translation 'The 400 Songs of War and Wisdom'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "