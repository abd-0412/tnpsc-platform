{"id": "12th_tamil_u7_q1300", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "myth_characteristics", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்கண்டவற்றுள் தொன்மத்தின் சிறப்பியல்புகளில் தவறானது எது?", "media_id": null}], "options": {"A": "தொன்மம் மனிதர்களின் ஆழமான நம்பிக்கைகளையும் அனுபவங்களையும் வெளிப்படுத்துகிறது.", "B": "இலக்கியத்தில் புதிய பொருளை உணர்த்தும் படிமமாகவும் குறியீடாகவும் செயல்படுகிறது.", "C": "காலம் கடந்தும் புதிய படைப்புகளில் நவீனப் பொருளுடன் மறுபிறவி எடுக்கிறது.", "D": "தொன்மம் என்பது அறிவியல் சான்றுகளுடன் கூடிய சரித்திர வரலாற்று ஆவணம் மட்டுமே ஆகும்."}, "explanation": "தொன்மம் என்பது வரலாற்றுக் கால வரிசை ஆவணம் அன்று; அது பண்பாட்டுக் குறியீடுகளாலும் படிமங்களாலும் அமைந்த இலக்கிய உத்தியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following is INCORRECT regarding the characteristics of a literary myth?", "media_id": null}], "options": {"A": "Myth expresses deep human convictions and archetypal experiences.", "B": "It functions as an evocative image and symbol conveying fresh meaning in literature.", "C": "It transcends historical time and reincarnates with modernist nuances in contemporary art.", "D": "A myth is purely a scientifically verified chronological history document."}, "explanation": "Statement D is wrong because a myth is a symbolic, cultural metaphor and imaginative archetype, not a literal scientific chronicle."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 185, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 185", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Grammar", "Myth Characteristics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1301", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "oedipus_complex", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஈடிபஸ் காம்ப்ளக்ஸ்’ (Oedipus Complex) முதலான உளவியல் கோட்பாடுகளுக்குப் பெயரிட எந்த நாட்டுத் தொன்மங்கள் அடிப்படையாக அமைந்தன?", "media_id": null}], "options": {"A": "கிரேக்கத் தொன்மங்கள்", "B": "எகிப்தியத் தொன்மங்கள்", "C": "சீனத் தொன்மங்கள்", "D": "பாரசீகத் தொன்மங்கள்"}, "explanation": "சிக்மண்ட் பிராய்டு தனது உளப்பகுப்பாய்வுக் கோட்பாடுகளுக்குக் கிரேக்கப் புராணக் கதையான சோஃபோக்ளீஸின் 'ஈடிபஸ்' தொன்மத்தையே பயன்படுத்தினார்."}, "en": {"blocks": [{"type": "text", "content": "The myths of which ancient civilization formed the foundation for naming psychological constructs like the Oedipus Complex?", "media_id": null}], "options": {"A": "Greek myths", "B": "Egyptian myths", "C": "Chinese myths", "D": "Persian myths"}, "explanation": "Sigmund Freud utilized the classical Greek tragedy and myth of King Oedipus by Sophocles to articulate his psychoanalytic theory."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "