{"id": "12th_tamil_u7_q1313", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "aputhiran_amudhasurabi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மணிமேகலை காப்பியத்தில் ‘ஆபுத்திரன் கையில் அமுதசுரபி கிடைத்த தொன்மம்’ எதனைப் புலப்படுத்துகிறது?", "media_id": null}], "options": {"A": "பசிப்பிணி நீக்கும் அன்னதானத்தின் மேன்மையும் உலகப் பசி ஒழிப்பும்", "B": "அரசாளும் ஆசை", "C": "பொன் பொருள் சேர்க்கும் வேட்கை", "D": "கடல் வாணிபம் புரிதல்"}, "explanation": "ஆபுத்திரன் அமுதசுரபியைக் கொண்டு 'மண்டிணி ஞாலத்து வாழ்வோர்க்கெல்லாம் உண்டி கொடுத்தோர் உயிர் கொடுத்தோரே' என்ற அறத்தை நிறைவேற்றினான்."}, "en": {"blocks": [{"type": "text", "content": "What moral archetype is highlighted in Manimekalai through the myth of Aputhiran receiving the Amudhasurabi?", "media_id": null}], "options": {"A": "Eradication of universal hunger and sanctity of feeding the destitute", "B": "Craving for royal dominion", "C": "Accumulation of gold and wealth", "D": "Undertaking maritime trade"}, "explanation": "The inexhaustible bowl Amudhasurabi symbolizes the ethical imperative of banishing hunger across the universe."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educat