{"id": "12th_tamil_u7_q1323", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mozhippayirchi_iyal7", "chapter_id": null, "topic_id": "punarchi_vidhi_malarkann", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மலர்க்கண்’ - புணர்ச்சி விதியைத் தேர்ந்தெடுக்க:\n(மலர் + கண் = மலர்க்கண்)", "media_id": null}], "options": {"A": "இடனறிந்து புணர்தல்", "B": "உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே", "C": "இயல்பினும் விதியினும் நின்ற உயிர்முன் கசதப மிகும்", "D": "திசைப்பெயர் புணர்ச்சி"}, "explanation": "நிலைமொழி ஈற்றில் 'மலர்' என உயிர் நிற்க (ர் என்ற மெய் நின்றாலும் இயல்பாக), வருமொழி முதலில் 'க' வருவதால் 'இயல்பினும் விதியினும் நின்ற உயிர்முன் கசதப மிகும்' விதிப்படி க் மிகுந்தது."}, "en": {"blocks": [{"type": "text", "content": "Select the sandhi rule for the combination 'Malar + Kann = Malarkkann'.", "media_id": null}], "options": {"A": "Contextual combination", "B": "Consonant joining vowel naturally", "C": "Plosives (k, c, th, p) doubling before standing vowel/stem", "D": "Direction noun sandhi"}, "explanation": "By the rule of plosive doubling after noun stems, 'k' doubles to give 'மலர்க்கண்'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term"