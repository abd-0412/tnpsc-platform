{"id": "12th_tamil_u7_q1184", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "pari_water_management", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க காலத்தில் கபிலர் பாரியின் பறம்பு மலையை வர்ணிக்கும்போது, அங்கு எத்தகைய நீர் மேலாண்மை இயற்கை வளமாக அமைந்திருந்ததாகக் குறிப்பிடுகிறார்?", "media_id": null}], "options": {"A": "ஆற்றுப் பாசனம்", "B": "கிணற்றுப் பாசனம்", "C": "ஏரிப் பாசனம்", "D": "மழையையும் சுனையையும் மட்டுமே நம்பி உழவர் உழாமலேயே நான்கு வளங்களைத் தரும் இயற்கை நீர் மேலாண்மை"}, "explanation": "பறம்பு மலையில் மூங்கில் நெல், பலாச்சுளை, வள்ளிக்கிழங்கு, தேன் ஆகிய நான்கு வளங்களும் உழவர் உழாமலேயே சுனை நீரால் இயற்கையாக விளைந்த நீர் மேலாண்மையைக் கபிலர் போற்றுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "In Sangam poetry, how did Kapilar characterize the sustainable water ecology of Paari's Parambu hills?", "media_id": null}], "options": {"A": "Canal networks", "B": "Deep dug wells", "C": "Artificial reservoir tanks", "D": "Natural spring-fed mountain hydro-ecology yielding four bounties without tillers' ploughing"}, "explanation": "Parambu hills featured natural perennial springs that nourished bamboo rice, jackfruit, tubers, and honey without tilling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 160", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Prose", "Parambu Water Management"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1185", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "planning_importance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘எண்ணித் துணிக கருமம் துணிந்தபின், எண்ணுவம் என்பது இழுக்கு’ - இக்குறள் எதன் இன்றியமையாமையை வலியுறுத்துகிறது?", "media_id": null}], "options": {"A": "முழுமையான முன் திட்டமிடல் (Planning before execution)", "B": "அவசரமாக முடிவெடுத்தல்", "C": "பயந்து பின்வாங்குதல்", "D": "தாமதப்படுத்துதல்"}, "explanation": "நன்றாக ஆய்ந்து திட்டமிட்ட பிறகே ஒரு செயலில் இறங்க வேண்டும்; இறங்கிய பிறகு யோசிக்கலாம் என்பது குற்றமாகும் என்று முன் திட்டமிடலை வள்ளுவர் வலியுறுத்துகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What cardinal corporate principle does 'Ennith thuniga karumam thuninthapin ennuvam enpathu izhukku' enforce?", "media_id": null}], "options": {"A": "Rigorous advance planning before execution (Planning before Action)", "B": "Hasty impulse action", "C": "Retreating in fear", "D": "Procrastination"}, "explanation": "Action must be preceded by meticulous planning; hesitating after commencing is disastrous."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 159, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 159", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Prose", "Planning Principle"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1186", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "uraiyanbu_literary_awards", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெ. இறையன்பு அவர்களின் எந்தக் கவிதை நூல் தமிழக அரசின் சிறந்த நூலுக்கான விருதைப் பெற்றது?", "media_id": null}], "options": {"A": "படிப்பது சுகமே", "B": "வாய்க்கால் மீன்கள்", "C": "உள்ளொளிப் பயணம்", "D": "சிந்தனை அரங்கம்"}, "explanation": "வெ. இறையன்பு இயற்றிய ‘வாய்க்கால் மீன்கள்’ என்னும் கவிதைத் தொகுதி தமிழக அரசின் சிறந்த நூலுக்கான விருதினைப் பெற்றது."}, "en": {"blocks": [{"type": "text", "content": "Which poetry anthology authored by Dr. V. Irai Anbu was awarded the Tamil Nadu State Government Best Book Award?", "media_id": null}], "options": {"A": "Padippathu Sugamae", "B": "Vaaikkaal Meengal", "C": "Ullolip Payanam", "D": "Chinthani Arangam"}, "explanation": "His poetic collection 'Vaaikkaal Meengal' won the Tamil Nadu State Government Award."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 160", "u