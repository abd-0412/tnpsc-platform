{"id": "12th_tamil_u7_q1302", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "kaduvan_mallanar_agananooru", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அகநானூற்றில் இராமன் சீதையை மீட்கச் செல்லும்போது ஆலமரத்தடியில் அமைதி ஏற்படுத்திய தொன்மச் செய்தி எந்தப் புலவரால் பாடப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "கபிலர்", "B": "கடுவன் மள்ளனார் (அகம் 70)", "C": "நக்கீரர்", "D": "மாமூலனார்"}, "explanation": "அகநானூறு 70-ஆம் பாடலில் கடுவன் மள்ளனார் 'வெல்போர் இராமன் அருமறைக்கு அவித்த காதில் வீழும் ஒலிஅவிந்தன்ன' என்று இராமன் தொன்மத்தைப் பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which Sangam poet mentioned the mythic incident of Rama silencing chirping birds under a banyan tree at Dhanushkodi in Agananuru?", "media_id": null}], "options": {"A": "Kabilar", "B": "Kaduvan Mallanar (Agananuru 70)", "C": "Nakkeerar", "D": "Mamulanar"}, "explanation": "Kaduvan Mallanar recorded this myth in Agananuru verse 70 where birds silenced their chirping as Rama held counsel."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 186,