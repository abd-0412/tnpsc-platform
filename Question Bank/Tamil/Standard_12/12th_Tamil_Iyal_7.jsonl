{"id": "12th_tamil_u7_q1310", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "myth_nature_explanations", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தொன்மங்கள் என்பவை பழங்கால மனிதர்களின் அறிவியல் விளக்கங்கள்’ என்று மானுடவியல் ஆய்வாளர்கள் கூறுவது எதனால்?", "media_id": null}], "options": {"A": "அவர்கள் நவீனக் கருவிகளைப் பயன்படுத்தியதால்", "B": "இயற்கை நிகழ்வுகளான மழை, இடி, மின்னல், பருவகால மாற்றங்கள் ஆகியவற்றுக்குக் காரணங்களை அறிய முற்பட்ட மனிதர்களின் கற்பனைக் கதைகளாக அவை அமைந்ததால்", "C": "அவர்கள் பல்கலைக்கழகங்களை நிறுவியதால்", "D": "அவற்றில் எண்கணிதச் சமன்பாடுகள் இருந்ததால்"}, "explanation": "இயற்கையின் புதிரான சக்திகளையும் மாற்றங்களையும் விளக்குவதற்குத் தொன்மை மனிதர்கள் உருவாக்கிய கதைகளே பிற்காலத்தில் தொன்மங்களாக மாறின."}, "en": {"blocks": [{"type": "text", "content": "Why do anthropologists describe myths as the scientific explanations of early human societies?", "media_id": null}], "options": {"A": "Because early humans used modern lab tools", "B": "Because they represented primitive humanity's attempts to comprehend natural phenomena like thunder, rain, lightning, and seasons", "C": "Because they founded universities", "D": "Because they contained mathematical calculus equations"}, "explanation": "Early human beings devised mythological narratives to explain cosmic occurrences such as rainfall, lightning, thunder, and seasonal shifts."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 185, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 185", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Grammar", "Anthropology Myth"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1311", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "panchali_sabatham", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘திரௌபதியின் சபதம்’ என்ற பாரதியின் பாஞ்சாலி சபதத்தில் பாஞ்சாலி எதற்கான தொன்மக் குறியீடாகப் படைக்கப்பட்டுள்ளாள்?", "media_id": null}], "options": {"A": "வெறும் குடும்பத் தலைவி", "B": "அமைதியான துறவி", "C": "அடிமைப்பட்டுத் தவிக்கும் பாரத அன்னையும் அவளது விடுதலைச் சீற்றமும்", "D": "செல்வத்தின் தெய்வம் லக்குமி"}, "explanation": "பாரதி மகாபாரதத் திரௌபதியை அடிமைப்பட்டுத் தவிக்கும் பாரத மாதாவின் உருவகமாகவும், அவளது சபதத்தை இந்திய விடுதலைப் போரின் சபதமாகவும் உருமாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "In Bharathi's epic 'Panchali Sabatham', what does Draupadi mythologically symbolize?", "media_id": null}], "options": {"A": "Ordinary housewife", "B": "Tranquil ascetic", "C": "Enslaved Mother India and her uncontainable revolutionary fury for emancipation", "D": "Goddess of wealth Lakshmi"}, "explanation": "Bharathiyar allegorized Draupadi as Mother India trapped in colonial bondage, vowing to break her chains."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corp