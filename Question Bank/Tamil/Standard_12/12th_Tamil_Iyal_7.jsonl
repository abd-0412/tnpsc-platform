{"id": "12th_tamil_u7_q1222", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "theyilai_thotta_paattu", "chapter_id": null, "topic_id": "hill_country_tamils", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலங்கையில் தேயிலைத் தோட்டங்களில் உழைத்து அந்நாட்டின் பொருளாதாரத் தூண்களாக விளங்கும் தமிழர்கள் எவ்வாறு அழைக்கப்படுகின்றனர்?", "media_id": null}], "options": {"A": "யாழ்ப்பாணத் தமிழர்", "B": "மலையகத் தமிழர் (இந்திய வம்சாவளித் தமிழர்)", "C": "மட்டக்களப்புத் தமிழர்", "D": "கொழும்புத் தமிழர்"}, "explanation": "இலங்கையின் மத்திய மலைப்பகுதிகளில் தேயிலைத் தோட்டங்களில் குடியேறிய தமிழர்கள் 'மலையகத் தமிழர்' (Up-country Tamils) என்று அழைக்கப்படுகின்றனர்."}, "en": {"blocks": [{"type": "text", "content": "By what sociopolitical designation are the descendants of Tamil plantation workers in Sri Lanka known?", "media_id": null}], "options": {"A": "Jaffna Tamils", "B": "Malaiyagath Thamizhar (Hill-Country / Up-Country Tamils of Indian Origin)", "C": "Batticaloa Tamils", "D": "Colombo urbanites"}, "explanation": "They are historically known as 'Malaiyagath Thamizhar' (Hill-Country Tamils)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full