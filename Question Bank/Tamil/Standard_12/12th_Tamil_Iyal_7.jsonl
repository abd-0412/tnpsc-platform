{"id": "12th_tamil_u7_q1287", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sangkakala_kalvettu", "chapter_id": null, "topic_id": "ancestral_breath", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கல்வெட்டுகள் வெறும் எழுத்துக்கள் அல்ல; அவை நம் முன்னோர்களின் மூச்சுக்காற்று’ - ஐராவதம் மகாதேவனின் இப்பார்வை எதை உணர்த்துகிறது?", "media_id": null}], "options": {"A": "கல்வெட்டுகளில் காற்று அடைக்கப்பட்டிருக்கும் தன்மை", "B": "எழுத்துக்கள் மிக மென்மையானவை என்ற கருத்து", "C": "பண்டைத் தமிழரின் மொழி, பண்பாடு, வாழ்வியல் உண்மைகளின் நேரடி வரலாற்றுச் சான்று", "D": "கல்வெட்டுகள் கற்பனை இலக்கியங்கள் என்ற கருத்து"}, "explanation": "கல்வெட்டுகள் புனையப்படாத நேரடி ஆவணங்கள் ஆதலால் அவை பண்டைய மக்களின் உண்மையான பண்பாட்டையும் வரலாற்றையும் உயிர்ப்புடன் தாங்கி நிற்கின்றன."}, "en": {"blocks": [{"type": "text", "content": "'Inscriptions are not mere chiseled letters; they are the living breath of our ancestors' - What does this perspective convey?", "media_id": null}], "options": {"A": "Air is trapped inside rocks", "B": "Letters are soft physical entities", "C": "They serve as unvarnished, authentic direct historical testimonies of ancient Tamil life, language, and culture", "D": "Inscriptions are works of fantasy"}, "explanation": "Because stone inscriptions are non-fictional contemporaneous primary records, they preserve authentic human culture and history."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_n