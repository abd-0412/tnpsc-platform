{"id": "12th_tamil_u7_q1337", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mozhippayirchi_iyal7", "chapter_id": null, "topic_id": "sollurubu_udan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அறிவுடையோன் ஆறு அரசும் செல்லும்’ - இதில் பயின்றுவந்துள்ள ‘ஆறு’ என்னும் சொல்லின் பொருள் யாது?", "media_id": null}], "options": {"A": "வழி (நெறி)", "B": "நதி", "C": "ஆறு என்னும் எண்", "D": "தணிதல்"}, "explanation": "புறநானூற்று வரிகளில் 'ஆறு' என்பது 'வழி' அல்லது 'நன்னெறி' என்னும் பொருளில் ஆளப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "What does the word 'Aaru' mean in the classical maxim 'Arivudaiyon aaru arasum sellum'?", "media_id": null}], "options": {"A": "Path / Righteous course (Vazhi)", "B": "River", "C": "Number six", "D": "Calming down"}, "explanation": "'Aaru' here conveys the meaning of 'path' or 'guided conduct'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 188, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 188", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "ye