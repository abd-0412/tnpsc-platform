{"id": "12th_tamil_u7_q1193", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "uraiyanbu_birthplace", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முனைவர் வெ. இறையன்பு அவர்கள் பிறந்த ஊர் மற்றும் மாவட்டம் எது?", "media_id": null}], "options": {"A": "சேலம் மாவட்டம் காடையாம்பட்டி", "B": "மதுரை", "C": "திருச்சிராப்பள்ளி", "D": "தஞ்சாவூர்"}, "explanation": "வெ. இறையன்பு சேலம் மாவட்டம் ஓமலூருக்கு அருகிலுள்ள 'காடையாம்பட்டி' என்னும் ஊரில் பிறந்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which hometown and district is the birthplace of Dr. V. Irai Anbu I.A.S.?", "media_id": null}], "options": {"A": "Kaadaiyampatti in Salem district", "B": "Madurai", "C": "Tiruchirappalli", "D": "Thanjavur"}, "explanation": "Dr. Irai Anbu was born in Kaadaiyampatti near Omalur in Salem district."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 160", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "ye