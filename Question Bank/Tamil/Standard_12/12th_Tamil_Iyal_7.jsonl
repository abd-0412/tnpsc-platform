{"id": "12th_tamil_u7_q1289", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "tholkappiyam_thonmai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தொன்மை தானே உரையொடு புணர்ந்த பழமை மேற்றே’ என்று தொன்மத்திற்கு இலக்கணம் வகுத்த பண்டைய தமிழ்ப் பேரறிஞர் யார்?", "media_id": null}], "options": {"A": "தொல்காப்பியர்", "B": "பவணந்தி முனிவர்", "C": "அகத்தியர்", "D": "குணவீர பண்டிதர்"}, "explanation": "தொல்காப்பியர் செய்யுளியலில் (நூற்பா 237) செய்யுளின் எண்வகை வனப்புகளில் ஒன்றாகிய 'தொன்மை' என்பதற்கு உரையொடு கூடிய பழங்கதை என இலக்கணம் உரைத்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who was the ancient Tamil grammarian who defined myth in the sutra 'Thonmai thaane uraiyodu punarntha pazhamai metre'?", "media_id": null}], "options": {"A": "Tholkappiyar", "B": "Pavanandhi Munivar", "C": "Agathiyar", "D": "Gunaveera Pandithar"}, "explanation": "Tholkappiyar defined 'Thonmai' in Seyyuliyal as ancient legendary narratives intermingled with prose."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 185, "chapter": null, "section": null, "ref