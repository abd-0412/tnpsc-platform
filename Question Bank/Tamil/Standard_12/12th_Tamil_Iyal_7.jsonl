{"id": "12th_tamil_u7_q1328", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mozhippayirchi_iyal7", "chapter_id": null, "topic_id": "valimigum_idangal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்கண்டவற்றுள் வல்லினம் மிகும் இடத்தில் அமைந்த சரியான தொடர் எது?", "media_id": null}], "options": {"A": "பெரிய களிறு", "B": "வந்த பையன்", "C": "வாழ்க தமிழ்", "D": "திட்டமிட்டுச் செயல்படு"}, "explanation": "'திட்டமிட்டு' என்னும் 'இட்டு' என முடியும் வினையெச்சத்தின் பின் 'செ' வருவதால் வல்லினம் மிக்கு 'திட்டமிட்டுச் செயல்படு' என வரும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following phrases correctly exemplifies the rule of hard consonant doubling (Vallinam Migum)?", "media_id": null}], "options": {"A": "Periya kaliru", "B": "Vantha paiyan", "C": "Vaazhga thamizh", "D": "Thittamittuch seyalpadu"}, "explanation": "Following an adverbial participle ending in 'u/itu', hard consonant doubling applies, yielding 'திட்டமிட்டுச் செயல்படு'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 188, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 188", "ur