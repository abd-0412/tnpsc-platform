{"id": "12th_tamil_u7_q1296", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "silambu_kannagi_kotravai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரத்தில் மதுரையை எரித்த கண்ணகியின் சீற்றம் எந்தத் தொன்மத்தின் வெளிப்பாடாக இலக்கிய ஆய்வாளர்களால் கருதப்படுகிறது?", "media_id": null}], "options": {"A": "மழைத் தெய்வத்தின் அருள்", "B": "வருண பகவானின் கோபம்", "C": "சரசுவதியின் வாக்கு", "D": "தீத்தெய்வமும் அநீதிக்கு எதிரான இயற்கைச் சீற்றமும் கொண்ட கொற்றவைத் தொன்மம்"}, "explanation": "கண்ணகியின் கற்புக் கனலும் அநீதிக்கு எதிரான ஆவேசமும் பழையோள் கொற்றவையின் தொன்மத்தோடு இணைத்துப் பார்க்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Kannagi's righteous wrath burning the city of Madurai in Silappathikaram is identified with which ancient archetypal myth?", "media_id": null}], "options": {"A": "Grace of rain deity", "B": "Wrath of Varuna", "C": "Speech of Saraswati", "D": "The archetype of Kotravai and elemental cosmic fire rebelling against injustice"}, "explanation": "Kannagi's unyielding chastity and retaliatory fury against royal injustice align with the fierce Kotravai mother archetype."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 186, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 186", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Grammar", "Kannagi Kotravai"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1297", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "kupa_rajagopalan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘குருசேத்திரப் போரில் வீழ்ந்த கர்ணன்’ என்ற தொன்மத்தைக் கொண்டு கு.ப. ராஜகோபாலன் எழுதிய சிறுகதை எது?", "media_id": null}], "options": {"A": "கர்ணன் மற்றும் அகலிகை பற்றிய நவீனப் பார்வைகள்", "B": "நளவெண்பா உரை", "C": "வில்லிபாரதச் சுருக்கம்", "D": "கண்ணன் பாட்டு உரை"}, "explanation": "கு.ப.ரா அவர்கள் அகலிகை மற்றும் மகாபாரதக் கதாபாத்திரங்களின் உள்ளார்ந்த மன உணர்வுகளைத் தொன்ம மறுவாசிப்பாக எழுதியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which renowned work/theme was explored using Mahabharata mythological archetypes by Ku. Pa. Rajagopalan?", "media_id": null}], "options": {"A": "Modernist perspectives on Karna and Agaligai archetypes", "B": "Nalavenba commentary", "C": "Villibharatam abridgment", "D": "Kannan Pattu notes"}, "explanation": "Ku. Pa. Rajagopalan creatively explored psychological dilemmas using the Agaligai and Mahabharata mythic motifs."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "20