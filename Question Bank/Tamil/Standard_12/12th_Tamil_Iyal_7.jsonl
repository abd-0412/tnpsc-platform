{"id": "12th_tamil_u7_q1343", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mozhippayirchi_iyal7", "chapter_id": null, "topic_id": "nool_aayvu_early_tamil", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘Early Tamil Epigraphy’ நூலின் இரண்டாவது பதிப்பு எந்த ஆண்டு வெளியிடப்பட்டது?", "media_id": null}], "options": {"A": "2005", "B": "2010", "C": "2014", "D": "2018"}, "explanation": "ஐராவதம் மகாதேவனின் 'Early Tamil Epigraphy' நூலின் விரிவாக்கப்பட்ட இரண்டாம் பதிப்பு 2014-இல் செம்மொழித் தமிழாய்வு மத்திய நிறுவனத்தால் வெளியிடப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "In which year was the revised and enlarged second edition of 'Early Tamil Epigraphy' published?", "media_id": null}], "options": {"A": "2005", "B": "2010", "C": "2014", "D": "2018"}, "explanation": "The revised second edition of Mahadevan's masterpiece was published by CICT in 2014."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 183, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 183", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam