{"id": "12th_tamil_u7_q1241", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "purananooru_pisiranthaiyar", "chapter_id": null, "topic_id": "wise_elders_in_town", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிசிராந்தையார் தம் ஊரில் வாழும் சான்றோர்களைப் பற்றிக் குறிப்பிடும் புகழ்பெற்ற அடி எது?", "media_id": null}], "options": {"A": "‘ஆன்றவிந்து அடங்கிய கொள்கைச் சான்றோர் பலர்யான் வாழும் ஊரே’", "B": "செல்வத்துப் பயனே ஈதல்", "C": "யாதும் ஊரே யாவரும் கேளிர்", "D": "உண்டி கொடுத்தோர் உயிர் கொடுத்தோரே"}, "explanation": "நான் வாழும் ஊரில் கல்வி கேள்விகளில் சிறந்து, ஐம்புலன்களை அடக்கி, பழுத்த ஞானத்தோடு வாழும் சான்றோர்கள் பலர் வாழ்கின்றனர் என்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "Which immortal line describes the wise elders living in Pisiraanthaiyaar's town?", "media_id": null}], "options": {"A": "'Aandravingthu adangiya kolkaich chaandror palaryaan vaazhum oorae'", "B": "Selvaththu payanae eethal", "C": "Yaathum oorae yaavarum kaelir", "D": "Undi koduthtthor uyir koduthtthorae"}, "explanation": "'Aandravingthu adangiya kolkaich chaandror palaryaan vaazhum oorae' celebrates the serene sages living in his town."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Servi