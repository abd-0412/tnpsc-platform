{"id": "12th_tamil_u7_q1252", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "purananooru_pisiranthaiyar", "chapter_id": null, "topic_id": "maanda_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மாண்ட என் மனைவியொடு மக்களும் நிரம்பினர்’ - இவ்வடியில் 'மாண்ட' என்னும் சொல்லின் பொருள் யாது?", "media_id": null}], "options": {"A": "இறந்துபோன", "B": "அழகிய", "C": "கோபமுடைய", "D": "மாண்புடைய / சிறந்த நற்குணங்கள் நிறைந்த"}, "explanation": "இங்கு 'மாண்ட' என்பது மாண்புடைய, பெருமைமிக்க நற்குணங்கள் நிறைந்த என்னும் பொருளில் ஆளப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "In the line 'Maanda en manaiviyodu makkalum nirambinar', what does the classical word 'Maanda' denote?", "media_id": null}], "options": {"A": "Deceased", "B": "Cosmetically fair", "C": "Wrathful", "D": "Maanbudaiya (Noble / Possessing exalted virtues)"}, "explanation": "'Maanda' signifies noble, endowed with exalted moral character."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 165, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 165", "url": null, "source_notes": null}, "previou