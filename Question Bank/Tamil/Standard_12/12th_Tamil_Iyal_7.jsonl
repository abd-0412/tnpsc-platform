{"id": "12th_tamil_u7_q1256", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "purananooru_pisiranthaiyar", "chapter_id": null, "topic_id": "poet_king_parity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கோப்பெருஞ்சோழனுக்கும் பிசிராந்தையாரின் நட்பிற்கும் சங்க இலக்கியத்தில் கூறப்படும் ஒப்புயர்வற்ற பெருமை யாது?", "media_id": null}], "options": {"A": "பரிசுகளைப் பரிமாறிக்கொண்டமை", "B": "போரில் ஒன்றாகப் போரிட்டமை", "C": "திருமண உறவு கொண்டமை", "D": "ஒருவரையொருவர் நேரில் பார்த்திராமலேயே உள்ளத்தால் ஒன்றி, ஒருவருக்காக மற்றொருவர் உயிரையே துறந்த நட்பின் சிகரம்"}, "explanation": "கண்ணால் நேரில் காணாமலேயே கேள்வியுற்று அன்பால் பிணைந்து, அரசன் இறந்த செய்தி கேட்டுப் புலவனும் வடக்கிருந்து உயிர்நீத்த உன்னதமான நட்பின் அடையாளம் இதுவாகும்."}, "en": {"blocks": [{"type": "text", "content": "What unique legendary distinction immortalizes the friendship between Kopperunchozhan and Pisiraanthaiyaar in Tamil annals?", "media_id": null}], "options": {"A": "Exchanging lavish diplomatic gifts", "B": "Fighting together on the battlefield", "C": "Marital alliance", "D": "A soulmate bond formed purely by reputation without ever meeting, culminating in dying together in solidarity"}, "explanation": "They shared an immortal spiritual friendship without ever meeting, culminating in mutual death through Vada-iruthal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks":