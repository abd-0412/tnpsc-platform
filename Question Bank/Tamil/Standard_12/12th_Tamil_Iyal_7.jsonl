{"id": "12th_tamil_u7_q1239", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "purananooru_pisiranthaiyar", "chapter_id": null, "topic_id": "servants_and_citizens_quality", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிசிராந்தையார் கூறும் இரண்டாவது மற்றும் மூன்றாவது காரணங்கள் யாவை?", "media_id": null}], "options": {"A": "அதிக செல்வமும் நிலங்களும்", "B": "பகைவர்கள் இல்லாதிருத்தல்", "C": "சொல்வதை உணர்ந்து நடக்கும் நல்ல பணியாளர்களும், நெறி தவறாத நற்குடிமக்களும் அமையப்பெற்றமை", "D": "நீண்ட தூரப் பயணம்"}, "explanation": "‘யான்கண் டனையர்என் இளையர்; வேந்தனும் அல்லவை செய்யான் காக்கும்’ - தான் நினைப்பதை உணர்ந்து ஏவல் கேட்கும் நல்ல பணியாளர்களும், நாட்டில் குடிமக்கள் நல்லொழுக்கம் கொண்டவர்களாக இருப்பதும் என்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "What are the second and third blessings contributing to Pisiraanthaiyaar's youthful vigor?", "media_id": null}], "options": {"A": "Abundant gold reserves", "B": "Total absence of enemies", "C": "Dutiful servants who anticipate his wishes and virtuous citizens dwelling in harmony", "D": "Far-flung voyages"}, "explanation": "Dutiful servants who heed his intent and upright fellow citizens who walk the path of virtue."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publis