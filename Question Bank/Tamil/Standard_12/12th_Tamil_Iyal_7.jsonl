{"id": "12th_tamil_u7_q1317", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mozhippayirchi_iyal7", "chapter_id": null, "topic_id": "glossary_epigraphy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘Epigraphy’ என்ற ஆங்கிலச் சொல்லுக்கு இணையான சரியான தமிழ்ச் சொல் எது?", "media_id": null}], "options": {"A": "கல்வெட்டியல்", "B": "அகழாய்வியல்", "C": "நாணயவியல்", "D": "சுவடியியல்"}, "explanation": "'Epigraphy' என்பதற்குத் தமிழில் 'கல்வெட்டியல்' என்று பொருள். கல்வெட்டுகளைப் படித்து ஆராயும் அறிவியல் துறையாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the correct Tamil equivalent for the English terminology 'Epigraphy'?", "media_id": null}], "options": {"A": "Epigraphy (Kalvettiyal)", "B": "Archaeology (Agazhaayviyal)", "C": "Numismatics (Nanayaviyal)", "D": "Manuscriptology (Suvadiyiyal)"}, "explanation": "'Epigraphy' translates directly to 'கல்வெட்டியல்' (the study and interpretation of ancient inscriptions)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 189, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 189", "url": null, "source_notes": nul