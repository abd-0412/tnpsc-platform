{"id": "12th_tamil_u7_q1250", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "purananooru_pisiranthaiyar", "chapter_id": null, "topic_id": "purananooru_first_print_u_ve_sa", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புறநானூற்றை முதன்முதலில் 1894-ஆம் ஆண்டு அச்சு வடிவில் பதிப்பித்து வெளியிட்ட பதிப்பியல் மேதை யார்?", "media_id": null}], "options": {"A": "சி.வை. தாமோதரம்பிள்ளை", "B": "தமிழ்த்தாத்தா உ.வே. சாமிநாதையர் (1894)", "C": "மறைமலையடிகள்", "D": "வ.உ. சிதம்பரனார்"}, "explanation": "உ.வே. சாமிநாதையர் அவர்கள் 1894-ஆம் ஆண்டு புறநானூற்றை மிக நுட்பமான பழைய உரையோடு முதன்முதலில் அச்சு வடிவில் பதிப்பித்து வெளியிட்டார்."}, "en": {"blocks": [{"type": "text", "content": "Who critically edited and published the historic first print edition of Purananooru in 1894?", "media_id": null}], "options": {"A": "C.W. Damodaram Pillai", "B": "U.V. Swaminatha Iyer (1894)", "C": "Maraimalai Adigal", "D": "V.O. Chidambaranar"}, "explanation": "U.V. Swaminatha Iyer brought out the landmark first print edition of Purananooru in 1894."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 166, "chapter": null, "sec