{"id": "12th_tamil_u7_q1219", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "athisaya_malar", "chapter_id": null, "topic_id": "botanical_resilience_allegory", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அதிசய மலர்’ கவிதையில் பூத்த மலர் எந்த நிறத்தில் இருந்ததாக விவரிக்கப்படுகிறது?", "media_id": null}], "options": {"A": "கருப்பு", "B": "மஞ்சள்", "C": "சாம்பல் நிற இடிபாடுகளுக்கு இடையே பிரகாசமான வண்ணம் கொண்ட மலர்", "D": "பழுப்பு"}, "explanation": "போரின் கரிய புகையும் சாம்பலும் படிந்த புழுதிப் பரப்பில், காண்போரின் கண்ணைப் பறிக்கும் அழகிய வண்ணத்தில் மலர்ந்ததாகக் கவிதை விவரிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "How is the aesthetic contrast of the miraculous flower painted against the war wreckage in 'Athisaya Malar'?", "media_id": null}], "options": {"A": "Charcoal black", "B": "Faded yellow", "C": "A vibrant, radiant burst of blooming color shining amidst grey ash and rubble", "D": "Dull brown"}, "explanation": "The radiant flower shines with brilliant color against scorched grey ruins."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "sec