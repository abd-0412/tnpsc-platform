{"id": "12th_tamil_u7_q1259", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "purananooru_pisiranthaiyar", "chapter_id": null, "topic_id": "vadakku_direction_symbolism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க காலத்தில் அரசர்களும் முனிவர்களும் 'வடக்கு நோக்கி' அமர்ந்து உயிர்நீத்ததன் ஆன்மிகக் காரணம் என்ன?", "media_id": null}], "options": {"A": "வடக்கு குளிர்ச்சியானது என்பதால்", "B": "வடக்கு திசையில் கடல் இல்லை என்பதால்", "C": "வடதிசை என்பது முக்திக்குரிய புண்ணிய திசையாகவும் தேவ திசையாகவும் கருதப்பட்டதால்", "D": "காற்று குறைவாக வீசும் என்பதால்"}, "explanation": "பண்டைய இந்திய மரபில் வடக்கு திசை என்பது இமயமலை மற்றும் மேரு மலையை நோக்கிய புண்ணிய திசையாகக் கருதப்பட்டதால் முக்தி வேண்டி வடக்கிருந்தனர்."}, "en": {"blocks": [{"type": "text", "content": "What sacred spiritual significance underlay the practice of fasting to death facing the North in ancient India?", "media_id": null}], "options": {"A": "Because the north was cold", "B": "Absence of ocean", "C": "The North was regarded as the auspicious direction of Devas and spiritual liberation (Mukti)", "D": "Absence of wind"}, "explanation": "The North was venerated as the celestial direction of cosmic ascension and liberation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 166, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 166", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Poetry", "North Direction Symbolism"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1260", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "purananooru_pisiranthaiyar", "chapter_id": null, "topic_id": "pisiranthaiyar_total_songs", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்கத் தொகை நூல்களில் பிசிராந்தையார் பாடியதாகக் கிடைத்துள்ள மொத்தப் பாடல்களின் எண்ணிக்கை யாது?", "media_id": null}], "options": {"A": "50 பாடல்கள்", "B": "25 பாடல்கள்", "C": "10 பாடல்கள்", "D": "எட்டு பாடல்கள் (நற்றிணை 1, அகநானூறு 1, புறநானூறு 6)"}, "explanation": "சங்க இலக்கியத் தொகை நூல்களில் பிசிராந்தையார் பாடியதாக நற்றிணையில் ஒன்றும், அகநானூற்றில் ஒன்றும், புறநானூற்றில் ஆறுமாக மொத்தம் 8 பாடல்கள் மட்டுமே கிடைத்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "What is the total count of surviving classical poems attributed to Pisiraanthaiyaar across Sangam corpora?", "media_id": null}], "options": {"A": "50 poems", "B": "25 poems", "C": "10 poems", "D": "Eight poems (Natrinai 1, Agananooru 1, Purananooru 6)"}, "explanation": "Only eight surviving poems by Pisiraanthaiyaar are extant across Sangam literature."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 166, "ch