{"id": "12th_tamil_u7_q1187", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "administrative_communication", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நிருவாகத்தில் தகவல் தொடர்பு (Communication) எவ்வாறு இருக்க வேண்டும் என்று வெ. இறையன்பு குறிப்பிடுகிறார்?", "media_id": null}], "options": {"A": "மிக நீண்ட பக்கங்களைக் கொண்டதாக இருக்க வேண்டும்", "B": "கடினமான சொற்கள் நிறைந்ததாக இருக்க வேண்டும்", "C": "தெளிவாகவும், சுருக்கமாகவும், கேட்பவர் உள்ளத்தில் ஐயத்திற்கிடமின்றிப் பதியும் வண்ணமும் அமைதல் வேண்டும்", "D": "ரகசியமாக மட்டுமே இருக்க வேண்டும்"}, "explanation": "அனுமன் இராமனிடம் பேசியது போல, தகவலைத் தெளிவாகவும், துல்லியமாகவும், தேவையற்ற சொற்களின்றி வெளிப்படுத்துவதே சிறந்த நிர்வாகத் தகவல் தொடர்பாகும்."}, "en": {"blocks": [{"type": "text", "content": "How should administrative communication be structured according to Dr. V. Irai Anbu?", "media_id": null}], "options": {"A": "Spread across dozens of verbose pages", "B": "Dense with arcane terminology", "C": "Crisp, transparent, precise, and instantly eliminating ambiguity in the recipient's mind", "D": "Confined to clandestine whispers"}, "explanation": "Communication must be succinct, unambiguous, and laser-focused on clarity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source"