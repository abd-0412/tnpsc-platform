{"id": "12th_tamil_u7_q1290", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "mythos_greek_origin", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆங்கிலத்தில் ‘Myth’ என்று அழைக்கப்படும் சொல்லின் மூலமான ‘Muthos’ (முதோஸ்) என்பது எந்த மொழிச் சொல்?", "media_id": null}], "options": {"A": "இலத்தீன்", "B": "கிரேக்கம்", "C": "ஹீப்ரு", "D": "பிரெஞ்சு"}, "explanation": "'Myth' என்ற ஆங்கிலச் சொல் 'Muthos' என்ற கிரேக்கச் சொல்லிலிருந்து உருவானது. இதற்கு 'சொல்', 'உரை', 'கதை' என்று பொருள்."}, "en": {"blocks": [{"type": "text", "content": "From which classical language is the word 'Muthos', the etymological root of the English term 'Myth', derived?", "media_id": null}], "options": {"A": "Latin", "B": "Greek", "C": "Hebrew", "D": "French"}, "explanation": "The word 'Myth' is derived from the ancient Greek word 'Muthos', signifying speech, utterance, or tale."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 185, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 185", "url": null, "source_notes": null}, "previous_year": {"is_previo