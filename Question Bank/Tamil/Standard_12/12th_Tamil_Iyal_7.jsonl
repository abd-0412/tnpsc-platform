{"id": "12th_tamil_u7_q1274", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sangkakala_kalvettu", "chapter_id": null, "topic_id": "ichr_fellowship", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஐராவதம் மகாதேவன் அவர்கள் இந்திய வரலாற்று ஆராய்ச்சி மன்றத்தின் (ICHR) பேராசிரியராக இருந்து ஆய்வு மேற்கொண்ட தலைப்பு எது?", "media_id": null}], "options": {"A": "பல்லவர் காலக் கட்டிடக்கலை", "B": "சங்ககாலத் தமிழ் பிராமிக் கல்வெட்டுகள் (Early Tamil Epigraphy)", "C": "சோழர் காலச் செப்பேடுகள்", "D": "பாண்டியர் காலக் குடைவரைக் கோயில்கள்"}, "explanation": "சங்ககாலத் தமிழ்-பிராமிக் கல்வெட்டுகள் மற்றும் தொல்லியல் ஆய்வுக்காக ஐ.சி.எச்.ஆர் தேசியப் பேராசிரியர் தகுதியை வழங்கி உதவியது."}, "en": {"blocks": [{"type": "text", "content": "Under which research fellowship title did Iravatham Mahadevan conduct advanced research at the Indian Council of Historical Research (ICHR)?", "media_id": null}], "options": {"A": "Pallava architecture", "B": "Early Tamil Epigraphy / Sangam Inscriptions", "C": "Chola copper plates", "D": "Pandya rock-cut temples"}, "explanation": "He was awarded a national fellowship by the Indian Council of Historical Research (ICHR) for his definitive work on early Tamil epigraphy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi