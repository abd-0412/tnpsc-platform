{"id": "12th_tamil_u7_q1275", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sangkakala_kalvettu", "chapter_id": null, "topic_id": "paazhi_stone_beds", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கல்வெட்டுகளில் காணப்படும் சமண முனிவர்களின் படுக்கைகளைக் குறிக்கும் சங்ககாலத் தமிழ்ச் சொல் எது?", "media_id": null}], "options": {"A": "பள்ளி", "B": "அமணம்", "C": "பாழி (அதிட்டானம்)", "D": "கூடம்"}, "explanation": "சமண முனிவர்கள் தங்கித் தவமிருந்த குகைப் பாறைப் படுக்கைகள் கல்வெட்டுகளில் 'பாழி' அல்லது 'அதிட்டானம்' எனக் குறிப்பிடப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Which Sangam Tamil term found in cave inscriptions refers to the stone beds of Jain ascetics?", "media_id": null}], "options": {"A": "Palli", "B": "Amanam", "C": "Paazhi (Athittanam)", "D": "Koodam"}, "explanation": "Stone beds chiseled for Jain ascetics are referred to as 'Paazhi' or 'Athittanam' in the rock inscriptions."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 182, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 182", "url": null, "source_notes": null}, "previous_year