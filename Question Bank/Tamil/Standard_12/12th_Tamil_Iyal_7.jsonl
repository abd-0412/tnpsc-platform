{"id": "12th_tamil_u7_q1258", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "purananooru_pisiranthaiyar", "chapter_id": null, "topic_id": "purananooru_sangam_classification", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புறநானூறு எந்தச் சங்க இலக்கியத் தொகுப்பினுள் அடங்கிய நூலாகும்?", "media_id": null}], "options": {"A": "பத்துப்பாட்டு", "B": "எட்டுத்தொகை", "C": "பதினெண்கீழ்க்கணக்கு", "D": "ஐஞ்சிறுங்காப்பியம்"}, "explanation": "நற்றிணை, குறுந்தொகை, ஐங்குறுநூறு, பதிற்றுப்பத்து, பரிபாடல், கலித்தொகை, அகநானூறு, புறநானூறு ஆகிய எட்டும் 'எட்டுத்தொகை' நூல்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "To which canonical Sangam anthology corpus does Purananooru belong?", "media_id": null}], "options": {"A": "Paththuppaattu", "B": "Ettuthogai (Eight Anthologies)", "C": "Pathinenkeelkanakku", "D": "Ainjirukaappiyam"}, "explanation": "Purananooru is one of the classic Ettuthogai (Eight Anthologies)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 166, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 166", "url": null, "source_notes": null}, "previous_year"