{"id": "12th_tamil_u7_q1344", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mozhippayirchi_iyal7", "chapter_id": null, "topic_id": "thirukkural_kootru_iyal7", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பொருள்கருவி காலம் வினையிடனொடு ஐந்தும் இருள்தீர எண்ணிச் செயல்’ - இக்குறளில் இடம்பெறும் மேலாண்மை உத்தி யாது?", "media_id": null}], "options": {"A": "பணியாளர் நலம்", "B": "நிதி மேலாண்மை", "C": "விளம்பர மேலாண்மை", "D": "முழுமையான செயல் திட்டமிடல் (Comprehensive Strategic Planning)"}, "explanation": "பொருள், கருவி, காலம், செயல், இடம் ஆகிய ஐந்தையும் ஐயமற ஆராய்ந்து திட்டமிட்டுச் செயல்பட வேண்டும் என்பதை இக்குறள் அறிவுறுத்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What management methodology is emphasized in Kural: 'Porulkaruvi kaalam vinaiyidanodu ainthum irultheera ennnich seyal'?", "media_id": null}], "options": {"A": "Staff welfare", "B": "Financial budget", "C": "Public relations", "D": "Comprehensive Strategic Planning"}, "explanation": "It prescribes holistic strategic planning analyzing five essential components before launching any enterprise."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "