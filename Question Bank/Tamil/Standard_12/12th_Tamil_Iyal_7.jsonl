{"id": "12th_tamil_u7_q1197", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "quality_control_management", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தயாரிக்கப்படும் பொருளின் தரத்தை உறுதி செய்யும் ‘தரக் கட்டுப்பாடு’ (Quality Control) கோட்பாட்டிற்கு இக்கட்டுரையில் எந்த சங்க இலக்கியக் குறிப்பு காட்டப்படுகிறது?", "media_id": null}], "options": {"A": "பொன்னை உரைகல்லில் உரசி மாற்றுப் பார்க்கும் தமிழரின் பொன் உரைத்தல் மரபு", "B": "மீன் பிடித்தல்", "C": "மண்பாண்டம் செய்தல்", "D": "நெசவு செய்தல்"}, "explanation": "பொன்னின் தரத்தை உரைகல்லில் உரசி அதன் மாற்றுக் குறையாத தரத்தை உறுதி செய்யும் சங்க காலப் பொற்கொல்லர் மரபு, தரக் கட்டுப்பாட்டு மேலாண்மைக்கு (Quality Control) உன்னத உதாரணமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which Sangam metallurgical custom illustrates the industrial doctrine of Quality Control?", "media_id": null}], "options": {"A": "Testing gold purity against a traditional touchstone (Uraikal) to certify carat quality", "B": "Deep-sea fishing", "C": "Pottery baking", "D": "Cotton spinning"}, "explanation": "Assaying gold purity against a touchstone exemplifies ancient quality control systems."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 159, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 159", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Prose", "Quality Control"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1198", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "uraiyanbu_radio_broadcasts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெ. இறையன்பு அவர்கள் அகில இந்திய வானொலியில் ஆற்றிய உரைகள் எந்தத் தலைப்பில் நூலாகத் தொகுக்கப்பட்டுள்ளன?", "media_id": null}], "options": {"A": "வானொலி விருந்து", "B": "சிந்தனை அரங்கம் / ஒலிக்கும் அமைதி", "C": "வானொலிக் கதைகள்", "D": "இனிய காலை"}, "explanation": "வெ. இறையன்பு வானொலியில் இளைஞர்களுக்கு தன்னம்பிக்கை ஊட்டும் வண்ணம் ஆற்றிய பல்வேறு சிந்தனை உரைகள் நூல்களாக வெளிவந்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Under what thematic publications were Dr. Irai Anbu's motivational All India Radio broadcasts compiled?", "media_id": null}], "options": {"A": "Radio Feast", "B": "Chinthani Arangam / Thought Spectrum Essays", "C": "Radio Fiction", "D": "Sweet Dawn"}, "explanation": "His motivational radio lectures were compiled into reflective philosophical essays."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": "12t