{"id": "12th_tamil_u7_q1192", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "team_work_unity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குழுப் பணி (Team Work) வெற்றி பெறுவதற்குத் தேவையான முதன்மைப் பண்பு எது?", "media_id": null}], "options": {"A": "தனிநபர் ஆதிக்கம்", "B": "பொறாமை", "C": "ரகசியம் பேணல்", "D": "ஒத்த நோக்கமும் பரஸ்பர நம்பிக்கையும் ஒருங்கிணைப்பும் (Shared vision & Coordination)"}, "explanation": "குழுவில் உள்ள ஒவ்வொருவரும் பொதுவான ஒரு நோக்கத்திற்காக இணைந்து, ஒருவரையொருவர் நம்பி ஒருங்கிணைந்து செயல்படுவதே குழுப்பணியின் வெற்றியாகும்."}, "en": {"blocks": [{"type": "text", "content": "What foundational attribute underpins organizational success in Team Work and Collective Management?", "media_id": null}], "options": {"A": "Autocratic individual ego", "B": "Interpersonal jealousy", "C": "Secrecy", "D": "Shared vision, mutual trust, and seamless cross-functional coordination"}, "explanation": "Team success relies upon a shared vision, mutual trust, and integrated coordination."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2