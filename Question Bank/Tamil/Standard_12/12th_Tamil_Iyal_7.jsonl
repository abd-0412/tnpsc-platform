{"id": "12th_tamil_u7_q1271", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sangkakala_kalvettu", "chapter_id": null, "topic_id": "script_stages", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்-பிராமி எழுத்துக்களின் வளர்ச்சி நிலைகளை ஐராவதம் மகாதேவன் எத்தனை கட்டங்களாகப் பகுத்துள்ளார்?", "media_id": null}], "options": {"A": "ஐந்து கட்டங்கள்", "B": "இரண்டு கட்டங்கள்", "C": "மூன்று கட்டங்கள்", "D": "நான்கு கட்டங்கள்"}, "explanation": "முற்காலத் தமிழி, இடைக்காலத் தமிழி, பிற்காலத் தமிழி என மூன்று வளர்ச்சி நிலைகளாக அவர் வகைப்படுத்தியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Into how many evolutionary stages did Iravatham Mahadevan classify the Tamil-Brahmi script system?", "media_id": null}], "options": {"A": "Five stages", "B": "Two stages", "C": "Three stages", "D": "Four stages"}, "explanation": "He classified the script into three evolutionary stages: Early Tamil-Brahmi, Middle Tamil-Brahmi, and Late Tamil-Brahmi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 183, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 183", "url": null, "so