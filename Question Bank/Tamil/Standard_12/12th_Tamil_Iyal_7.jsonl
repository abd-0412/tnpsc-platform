{"id": "12th_tamil_u7_q1218", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "theyilai_thotta_paattu", "chapter_id": null, "topic_id": "kangani_wage_fraud", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கங்காணிகள் தொழிலாளர்களுக்குக் கொடுத்த கூலியில் செய்த கொடுஞ்செயல் யாது?", "media_id": null}], "options": {"A": "அதிகப் பணம் கொடுத்தனர்", "B": "கடன் கொடுத்ததாகப் பொய்க் கணக்கு எழுதி, கூலியைக் கொடுக்காமல் தலைமுறை தலைமுறையாகக் கொத்தடிமைகளாக வைத்திருந்தனர்", "C": "நிலங்களை எழுதிக் கொடுத்தனர்", "D": "சொந்த ஊருக்கு அனுப்பி வைத்தனர்"}, "explanation": "பயணச் செலவு மற்றும் உணவுச் செலவு என்று கூறி தொழிலாளர்களின் கூலியைப் பிடித்தம் செய்து, அவர்களைக் கடனாளிகளாக்கி வாழ்நாளெல்லாம் அடிமைப்படுத்தினர்."}, "en": {"blocks": [{"type": "text", "content": "How did the Kangaanis systematically defraud indentured tea workers of their hard-earned wages?", "media_id": null}], "options": {"A": "By paying lavish bonus wages", "B": "By forging fraudulent debt ledgers, deducting exorbitant food/travel loans, keeping them in generational debt bondage", "C": "By gifting freehold land", "D": "By paying return passage"}, "explanation": "Kangaanis fabricated debts for travel and provisions to trap families in perpetual debt bondage."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil N