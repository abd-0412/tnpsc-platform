{"id": "12th_tamil_u7_q1280", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sangkakala_kalvettu", "chapter_id": null, "topic_id": "mahadevan_fact_check", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்கண்டவற்றுள் ஐராவதம் மகாதேவன் பற்றிய கூற்றுகளில் தவறானது எது?", "media_id": null}], "options": {"A": "இவர் இந்திய ஆட்சிப் பணியில் (IAS) பணியாற்றியவர்.", "B": "சிந்துவெளி எழுத்துகள் மற்றும் தமிழ் பிராமி ஆகியவற்றில் ஆழமான ஆய்வு செய்தவர்.", "C": "Early Tamil Epigraphy என்ற உலகத்தரம் வாய்ந்த நூலை எழுதியவர்.", "D": "இவர் தமிழ் பிராமிக் கல்வெட்டுகள் சமஸ்கிருத மொழியிலானது என்று நிறுவினார்."}, "explanation": "ஐராவதம் மகாதேவன் குகைக் கல்வெட்டுகள் அசோகன் பிராகிருதம் அல்ல, தூய சங்ககாலத் தமிழ் என்று நிறுவியவர். சமஸ்கிருதம் என்று கூறவில்லை."}, "en": {"blocks": [{"type": "text", "content": "Which of the following statements regarding Iravatham Mahadevan is INCORRECT?", "media_id": null}], "options": {"A": "He served in the Indian Administrative Service (IAS).", "B": "He conducted pioneering research on the Indus script and Tamil-Brahmi.", "C": "He authored the landmark treatise 'Early Tamil Epigraphy'.", "D": "He established that Tamil-Brahmi inscriptions were written in Sanskrit."}, "explanation": "Statement D is incorrect because Mahadevan proved they were inscribed in Sangam Tamil, not Sanskrit or Prakrit."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.