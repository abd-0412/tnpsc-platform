{"id": "12th_tamil_u5_q815", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "deivamani_maalai", "chapter_id": null, "topic_id": "thiruvarutpaa_thirumuraigal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இராமலிங்க அடிகளாரின் அனைத்துப் பாடல்களும் தொகுக்கப்பட்ட ‘திருவருட்பா’ எத்தனை திருமுறைகளாகப் பகுக்கப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "நான்கு திருமுறைகள்", "B": "பன்னிரண்டு திருமுறைகள்", "C": "ஆறு திருமுறைகள்", "D": "எட்டு திருமுறைகள்"}, "explanation": "வள்ளலாரின் திருவருட்பா மொத்தம் ஆறு திருமுறைகளாகத் தொகுக்கப்பட்டுள்ளது. தெய்வமணிமாலை ஐந்தாம் திருமுறையில் இடம்பெற்றுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Into how many canonical books (Thirumuraigal) are the sacred poetic works of Vallalar in 'Thiruvarutpa' compiled?", "media_id": null}], "options": {"A": "Four books", "B": "Twelve books", "C": "Six books (Aaru Thirumuraigal)", "D": "Eight books"}, "explanation": "Thiruvarutpa is compiled into six Thirumuraigal; Deivamani Maalai is featured in the 5th Thirumurai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 110, "chapter": null, "section": nul