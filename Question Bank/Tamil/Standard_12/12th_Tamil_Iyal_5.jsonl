{"id": "12th_tamil_u5_q814", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "deivamani_maalai", "chapter_id": null, "topic_id": "kandakottam_murugan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வள்ளலார் ‘தெய்வமணிமாலை’ பாடல்களை எந்தத் தலத்தில் உறையும் முருகப் பெருமானைப் போற்றிப் பாடினார்?", "media_id": null}], "options": {"A": "சுவாமிமலை", "B": "சென்னை கந்தக்கோட்டம்", "C": "திருச்செந்தூர்", "D": "பழனி"}, "explanation": "வள்ளலார் சென்னையில் வாழ்ந்த காலத்தில் பாரிமுனை அருகிலுள்ள சென்னை கந்தக்கோட்டம் முருகப்பெருமானின் மீது 'தெய்வமணிமாலை'யைப் பாடினார்."}, "en": {"blocks": [{"type": "text", "content": "On which sacred shrine of Lord Murugan did Vallalar compose the devotional hymn 'Deivamani Maalai'?", "media_id": null}], "options": {"A": "Swamimalai", "B": "Chennai Kandakottam", "C": "Thiruchendur", "D": "Palani"}, "explanation": "Vallalar composed the Deivamani Maalai dedicated to Lord Murugan presiding at Kandakottam, Chennai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 110, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 110", "url": null, "source_notes":