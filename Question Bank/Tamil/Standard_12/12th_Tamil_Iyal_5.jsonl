{"id": "12th_tamil_u5_q924", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "padimam", "chapter_id": null, "topic_id": "padimam_reader_response", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "படிமக் கவிதையைப் படிக்கும் வாசகனின் உள்ளத்தில் நிகழும் முதன்மை மாற்றம் என்ன?", "media_id": null}], "options": {"A": "சொல்லின் அகராதிப் பொருளை மட்டும் அறிதல்", "B": "இலக்கண அமைப்பை ஆராய்தல்", "C": "மனனம் செய்தல் மட்டும்", "D": "தன் சொந்த அனுபவத்தோடு அக்காட்சியை இணைத்துப் புதுவிதமான அழகியல் உணர்வை உருவாக்குதல்"}, "explanation": "படிமம் என்பது வாசகனின் கற்பனையையும் முந்தைய அனுபவங்களையும் தூண்டி, கவிஞன் காட்டிய காட்சிக்கு அப்பால் ஒரு புதிய உணர்வுத் தளத்தை அவனுள் தோற்றுவிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What primary psychological experience occurs in a reader engaging with authentic poetic imagery?", "media_id": null}], "options": {"A": "Simply referencing lexical dictionary definitions", "B": "Parsing grammatical morphology", "C": "Rote memorization", "D": "Synthesizing the image with personal lived experience to co-create a fresh aesthetic epiphany"}, "explanation": "Poetic imagery triggers the reader's imagination to co-create subjective aesthetic meaning."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publis