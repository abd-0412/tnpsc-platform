{"id": "12th_tamil_u5_q911", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "padimam", "chapter_id": null, "topic_id": "modern_poet_kalyanji_image", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வெயில் மழை... பூனை மடியில் சுருண்டு தூங்கும் பூனைக்குட்டி’ - இக்கவிதை வரிகளில் அமைந்த படிமம் எது?", "media_id": null}], "options": {"A": "அச்சப் படிமம்", "B": "கோபப் படிமம்", "C": "அமைதியான குடும்பப் பாசத்தையும் பாதுகாப்பையும் உணர்த்தும் காட்சிப் படிமம்", "D": "போராட்டப் படிமம்"}, "explanation": "மழைக் குளிரில் தாய்ப்பூனையின் கதகதப்பான மடியில் சுருண்டு தூங்கும் பூனைக்குட்டி என்பது அன்பையும் பாதுகாப்பையும் காட்சிப்படுத்தும் படிமமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What emotional nuance is encapsulated by the visual image of a kitten curling asleep in its mother's lap amidst a sunshower?", "media_id": null}], "options": {"A": "Terror and dread", "B": "Belligerence", "C": "Peaceful domestic tenderness, warmth, and safe maternal refuge", "D": "Social revolution"}, "explanation": "The image captures tender domestic security and maternal refuge."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024