{"id": "12th_tamil_u5_q906", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "padimam", "chapter_id": null, "topic_id": "sangam_padimam_velli_veethiyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கன்றும் உண்ணாது கலத்தினும் படாது... நல்ஆன் தீம்பால் நிலத்து உக்காஅங்கு...’ என்னும் வெள்ளிவீதியாரின் நற்றிணைப் பாடலில் பயின்று வரும் படிமம் எது?", "media_id": null}], "options": {"A": "ஒலிப் படிமம்", "B": "உவமை வழி அமைந்த காட்சிப் படிமம் (Visual Image through simile)", "C": "மணப் படிமம் மட்டும்", "D": "தொடு படிமம் மட்டும்"}, "explanation": "பசுவின் இனிய பால் கன்றுக்கும் பயன்படாமல், பாத்திரத்திலும் சேராமல் நிலத்தில் சிந்தி வீணாவது போன்ற காட்சிப் படிமம் தலைவியின் காதல் துயரத்தை விளக்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which poetic imagery is deployed in poet Velli Veethiyar's Natrinai verse depicting milk spilling onto the bare ground?", "media_id": null}], "options": {"A": "Auditory image", "B": "Visual Image wrought through simile (Uvamai Kaatchip Padimam)", "C": "Olfactory image only", "D": "Tactile image only"}, "explanation": "Velli Veethiyar uses a vivid visual image of wasted milk flowing onto parched ground."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educat