{"id": "12th_tamil_u5_q792", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "madarasapattinam", "chapter_id": null, "topic_id": "madras_medical_college", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆசியாவிலேயே முதன்முதலில் பெண் மருத்துவ மாணவியைப் (டாக்டர் மேரி ஷார்லிப்) பயிற்றுவித்த பெருமைக்குரிய சென்னை மருத்துவக் கல்லூரி எந்த ஆண்டு தொடங்கப்பட்டது?", "media_id": null}], "options": {"A": "1857", "B": "1840", "C": "1870", "D": "1835"}, "explanation": "மெட்ராஸ் மருத்துவக் கல்லூரி 1835-இல் தொடங்கப்பட்டது. இது ஆசியாவின் மிகத் தொன்மையான மருத்துவக் கல்லூரிகளுள் ஒன்றாகும்."}, "en": {"blocks": [{"type": "text", "content": "In which year was the Madras Medical College (MMC), one of Asia's earliest modern medical schools, established?", "media_id": null}], "options": {"A": "1857", "B": "1840", "C": "1870", "D": "1835"}, "explanation": "Madras Medical College was established in 1835 and admitted the first female medical student in Asia."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 107, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 107", "url": null, "source_notes":