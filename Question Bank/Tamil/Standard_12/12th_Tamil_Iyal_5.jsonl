{"id": "12th_tamil_u5_q890", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thalaikkulam", "chapter_id": null, "topic_id": "contemporary_relevance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தலைக்குளம்’ சிறுகதை உணர்த்தும் சமகாலச் சுற்றுச்சூழல் சீர்கேடு எது?", "media_id": null}], "options": {"A": "காற்று மாசுபாடு", "B": "ரியல் எஸ்டேட் வணிகத்தால் ஏரி, குளம் உள்ளிட்ட நீர்நிலைகள் ஆக்கிரமிக்கப்பட்டு அழிக்கப்படுதல்", "C": "ஒலி மாசுபாடு", "D": "நெகிழிப் பயன்பாடு"}, "explanation": "இன்றைய காலகட்டத்தில் தீவிரமடைந்துள்ள ரியல் எஸ்டேட் வணிகத்தால் ஏரி, குளங்கள் ஆக்கிரமிக்கப்பட்டுப் பெருவெள்ளத்திற்கும் வறட்சிக்கும் வழிவகுப்பதை இக்கதை படம் பிடிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What grave contemporary ecological abuse does 'Thalaikkulam' presciently mirror?", "media_id": null}], "options": {"A": "Atmospheric air pollution", "B": "Real estate encroachment, filling up, and annihilation of wetlands and reservoirs", "C": "Noise pollution", "D": "Single-use plastic disposal"}, "explanation": "The story mirrors real estate encroachment over wetlands leading to artificial floods and droughts."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "cl