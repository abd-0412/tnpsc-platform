{"id": "12th_tamil_u5_q807", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "madarasapattinam", "chapter_id": null, "topic_id": "chennai_harbour_artificial", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சென்னைத் துறைமுகம் (Chennai Port) இயற்கைத் துறைமுகமா அல்லது செயற்கைத் துறைமுகமா?", "media_id": null}], "options": {"A": "இயற்கைத் துறைமுகம்", "B": "ஆற்றுத் துறைமுகம்", "C": "செயற்கைத் துறைமுகம் (Artificial All-weather Port)", "D": "ஏரித் துறைமுகம்"}, "explanation": "இயற்கையான வளைகுடா அமையாத சென்னை கடற்கரையில் அலைதாங்கிக் கற்களைக் கொண்டு உருவாக்கப்பட்ட முழுமையான செயற்கைத் துறைமுகமே சென்னைத் துறைமுகமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What maritime category does the commercial Chennai Port (formerly Madras Port) classify as?", "media_id": null}], "options": {"A": "Natural deepwater ria port", "B": "Riverine estuary haven", "C": "Artificial all-weather breakwater port", "D": "Freshwater lake port"}, "explanation": "Chennai Port is entirely man-made, engineered with artificial breakwaters constructed off the Coromandel coast."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "p