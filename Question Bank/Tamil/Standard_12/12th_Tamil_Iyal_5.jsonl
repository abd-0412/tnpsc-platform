{"id": "12th_tamil_u5_q868", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "aganaanooru_ammuvanar", "chapter_id": null, "topic_id": "salt_cart_journey", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உமணர்கள் குடும்பத்தோடு மாட்டு வண்டிகளில் உப்பு மூட்டைகளை ஏற்றிச் செல்லும் பயண முறை எவ்வாறு அழைக்கப்பட்டது?", "media_id": null}], "options": {"A": "உமணர் உலா", "B": "உமணர் சந்தை", "C": "உமணர் ஊர்வலம்", "D": "உமணர் சாத்து (வணிகக் குழுவின் கூட்டுப் பயணம்)"}, "explanation": "வணிகர்கள் திருடர்களிடமிருந்து தங்களைப் பாதுகாத்துக்கொள்ளக் கூட்டமாகச் செல்லும் வணிகக் குழுவிற்கு 'சாத்து' என்று பெயர். உமணர்கள் கூட்டமாகச் சென்றது 'உமணர் சாத்து' எனப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "What was the collective caravan convoy journey undertaken by salt merchants with families and oxen termed?", "media_id": null}], "options": {"A": "Umanar Ula", "B": "Umanar Sandhai", "C": "Umanar Oorvalam", "D": "Umanar Saaththu (Merchant Caravan)"}, "explanation": "Commercial trade caravans travelling together for security were termed 'Saaththu' (Umanar Saaththu)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025