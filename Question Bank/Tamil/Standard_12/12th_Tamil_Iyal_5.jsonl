{"id": "12th_tamil_u5_q786", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "madarasapattinam", "chapter_id": null, "topic_id": "francis_day_grant", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "1639-இல் சந்திரகிரி அரசரின் பிரதிநிதியான தமர்லா சென்னப்ப நாயக்கரிடமிருந்து நிலம் பெற்ற ஆங்கிலேயக் கிழக்கிந்தியக் கம்பெனி அதிகாரி யார்?", "media_id": null}], "options": {"A": "இராபர்ட் கிளைவ்", "B": "பிரான்சிஸ் டே (Francis Day)", "C": "ஆர்தர் காட்டன்", "D": "சர் தாமஸ் மன்றோ"}, "explanation": "ஆங்கிலேயக் கிழக்கிந்தியக் கம்பெனியின் முகவரான பிரான்சிஸ் டே, தமர்லா சென்னப்ப நாயக்கரின் சகோதரர்களிடமிருந்து 1639 ஆகஸ்ட் 22 அன்று நிலத்தை வாங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "Which British East India Company factor secured the historic Madraspatnam land parcel in 1639?", "media_id": null}], "options": {"A": "Robert Clive", "B": "Francis Day", "C": "Arthur Cotton", "D": "Sir Thomas Munro"}, "explanation": "Francis Day, an officer of the British East India Company, acquired the strip of coastal land in 1639."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 105, "chapter": null, "sectio