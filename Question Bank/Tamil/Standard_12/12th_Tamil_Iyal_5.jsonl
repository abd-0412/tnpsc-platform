{"id": "12th_tamil_u5_q827", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thevaaram_mayilai", "chapter_id": null, "topic_id": "thevaaram_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தேவாரம்’ என்னும் சொல்லின் இருவேறு சரியான பொருள் விளக்கங்கள் எவை?", "media_id": null}], "options": {"A": "தெய்வப் பாடல், அரசன் பாடல்", "B": "அகவல் பாடல், துள்ளல் பாடல்", "C": "தே + ஆரம் (இறைவனுக்குச் சூட்டப்படும் பாமாலை), தே + வாரம் (இனிய இசையோடு பாடப்படும் பாடல்)", "D": "கோவில் மாலை, திருவுலா மாலை"}, "explanation": "தேவாரம் என்பது தே + ஆரம் (இறைவனுக்குச் சூட்டப்படும் மாலை) எனவும், தே + வாரம் (இறைவன் மீது அன்போடு பாடப்படும் இன்னிசைப் பாடல்) எனவும் பொருள்படும்."}, "en": {"blocks": [{"type": "text", "content": "What are the two dual etymological interpretations of the sacred Saivite term 'Thevaaram'?", "media_id": null}], "options": {"A": "Divine song and Royal ode", "B": "Agaval song and Leaping melody", "C": "The + Aaram (Wreath of songs for God) and The + Vaaram (Melodious devotional song)", "D": "Temple garland and Processional march"}, "explanation": "'Thevaaram' etymologically resolves as garland of hymns for God (The + Aaram) or melodious rhythmic song (The + Vaaram)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publi