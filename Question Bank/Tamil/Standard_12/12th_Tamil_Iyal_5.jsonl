{"id": "12th_tamil_u5_q796", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "madarasapattinam", "chapter_id": null, "topic_id": "rayapuram_railway_station", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தென்னிந்தியாவின் மிகத் தொன்மையான முதல் ரயில் நிலையம் எங்கு 1856-இல் அமைக்கப்பட்டது?", "media_id": null}], "options": {"A": "சென்னை சென்ட்ரல்", "B": "எழும்பூர்", "C": "தாம்பரம்", "D": "இராயபுரம் (Royapuram)"}, "explanation": "தென்னிந்தியாவின் முதல் ரயில் பாதை 1856-இல் இராயபுரத்திலிருந்து ஆற்காடு (வாலாஜா சாலை) வரை இயக்கப்பட்டது. இராயபுரமே தென்னிந்தியாவின் முதல் ரயில் நிலையமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Where was South India's very first operational railway terminus opened in 1856?", "media_id": null}], "options": {"A": "Chennai Central", "B": "Egmore", "C": "Tambaram", "D": "Royapuram"}, "explanation": "South India's first passenger railway terminus commenced operations from Royapuram to Walajah Road in 1856."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 107, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 107", "url": null, "sour