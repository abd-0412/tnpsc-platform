{"id": "12th_tamil_u5_q900", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "padimam", "chapter_id": null, "topic_id": "sensory_padimam_types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "படிமங்கள் மனிதனின் ஐம்புலன்களின் அடிப்படையில் எத்தனை வகைகளாகப் பகுக்கப்படுகின்றன?", "media_id": null}], "options": {"A": "இரண்டு", "B": "மூன்று", "C": "நான்கு", "D": "ஐந்து (காட்சிப் படிமம், ஒலிப் படிமம், சுவைப் படிமம், மணப் படிமம், தொடு படிமம்)"}, "explanation": "படிமம் கண் (பார்வை), செவி (கேட்டல்), நாக்கு (சுவை), மூக்கு (மணம்), மெய் (தொடுதல்) ஆகிய ஐம்புலன் உணர்வுகளின் அடிப்படையில் ஐந்து வகைப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Into how many classifications are poetic images divided based on human sensory perceptions?", "media_id": null}], "options": {"A": "Two", "B": "Three", "C": "Four", "D": "Five (Visual, Auditory, Gustatory, Olfactory, Tactile images)"}, "explanation": "Poetic images map to the five senses: Visual, Auditory, Gustatory, Olfactory, and Tactile."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 120, "chapter": null, "section": null, "reference": "12th Tami