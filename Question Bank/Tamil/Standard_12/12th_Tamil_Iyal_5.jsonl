{"id": "12th_tamil_u5_q808", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "madarasapattinam", "chapter_id": null, "topic_id": "madras_first_newspaper", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சென்னையில் முதன்முதலில் 1785-இல் தொடங்கப்பட்ட ஆங்கில நாளிதழ் எது?", "media_id": null}], "options": {"A": "தி இந்து", "B": "சுதேசமித்திரன்", "C": "மெட்ராஸ் டைம்ஸ்", "D": "மெட்ராஸ் கூரியர் (Madras Courier)"}, "explanation": "1785-ஆம் ஆண்டு சென்னையில் ரிச்சர்ட் ஜான்ஸ்டன் என்பவரால் வெளியிடப்பட்ட 'மெட்ராஸ் கூரியர்' சென்னை மாகாணத்தின் முதல் செய்தித்தாளாகும்."}, "en": {"blocks": [{"type": "text", "content": "What was the title of the very first English newspaper launched in Madras in 1785?", "media_id": null}], "options": {"A": "The Hindu", "B": "Swadesamitran", "C": "Madras Times", "D": "Madras Courier"}, "explanation": "The Madras Courier, launched in October 1785, was the first official newspaper published in Madras."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 106, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 106", "url": null, "source_notes": null}, "previ