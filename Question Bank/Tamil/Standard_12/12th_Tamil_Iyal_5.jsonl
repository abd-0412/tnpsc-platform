{"id": "12th_tamil_u5_q795", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "madarasapattinam", "chapter_id": null, "topic_id": "ripon_building", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சென்னை மாநகராட்சியின் தலைமை அலுவலகமான வெண்ணிற மாளிகை யாருடைய பெயரால் 'ரிப்பன் கட்டிடம்' என அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "வெல்லெஸ்லி பிரபு", "B": "கர்சன் பிரபு", "C": "ரிப்பன் பிரபு (உள்ளாட்சி அமைப்புகளின் தந்தை)", "D": "மவுண்ட்பேட்டன் பிரபு"}, "explanation": "இந்தியாவில் உள்ளாட்சித் தேர்தல் முறையை அறிமுகப்படுத்தி 'உள்ளாட்சி அமைப்புகளின் தந்தை' எனப் போற்றப்பட்ட ரிப்பன் பிரபுவின் நினைவாக இக்கட்டிடம் பெயர் பெற்றது."}, "en": {"blocks": [{"type": "text", "content": "After which British Viceroy, hailed as the 'Father of Local Self-Government in India', is Ripon Building named?", "media_id": null}], "options": {"A": "Lord Wellesley", "B": "Lord Curzon", "C": "Lord Ripon", "D": "Lord Mountbatten"}, "explanation": "The headquarters of the Greater Chennai Corporation is named after Lord Ripon, advocate of local self-governance."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page":