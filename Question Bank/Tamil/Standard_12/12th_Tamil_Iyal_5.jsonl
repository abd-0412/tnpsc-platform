{"id": "12th_tamil_u5_q897", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "padimam", "chapter_id": null, "topic_id": "padimam_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கியத்தில் ‘படிமம்’ (Image) என்னும் சொல் எதனைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "காட்சி / மனக்கண்ணில் தோன்றும் உருவம் (Mental Image)", "B": "ஒலி நயம் மட்டும்", "C": "எதுகை மோனை", "D": "இலக்கண விதி"}, "explanation": "படிமம் என்பது காட்சியை அல்லது ஒரு கருத்தை வாசகனின் மனக்கண்ணில் படமாக வரைந்து காட்டும் அழகியல் உத்தியாகும். ஆங்கிலத்தில் இதனை 'Image' என்பர்."}, "en": {"blocks": [{"type": "text", "content": "What does the literary-aesthetic term 'Padimam' (Image) signify in poetic theory?", "media_id": null}], "options": {"A": "Visual representation / Mental Image evoked before the reader's eye", "B": "Acoustic rhyme only", "C": "Prosodic meter", "D": "Grammar rule"}, "explanation": "'Padimam' signifies a sensory depiction or mental image vividly projected in the reader's mind."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 119, "chapter": null, "section": null, "reference": "12th Tami