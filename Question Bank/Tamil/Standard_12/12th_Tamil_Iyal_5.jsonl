{"id": "12th_tamil_u5_q853", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "aganaanooru_ammuvanar", "chapter_id": null, "topic_id": "ainkurunooru_neythal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஐங்குறுநூறு’ என்னும் எட்டுத்தொகை நூலில் நெய்தல் திணையை முழுமையாகப் பாடிய சங்கப் புலவர் யார்?", "media_id": null}], "options": {"A": "அம்மூவனார் (100 பாடல்கள்)", "B": "ஓரம்போகியார்", "C": "பே hisயனார்", "D": "ஓதலாந்தையார்"}, "explanation": "ஐங்குறுநூற்றில் மருதத்தை ஓரம்போகியாரும், நெய்தலை அம்மூவனாரும், குறிஞ்சியைக் கபிலரும், பாலையை ஓதலாந்தையாரும், முல்லையைப் பேயனாரும் பாடியுள்ளனர்."}, "en": {"blocks": [{"type": "text", "content": "Which Sangam poet composed the entire 100 coastal Neythal verses in the classic anthology 'Ainkurunooru'?", "media_id": null}], "options": {"A": "Ammoovanaar (100 verses)", "B": "Orambogiyar", "C": "Peyanaar", "D": "Odhalaanthaiyar"}, "explanation": "Ammoovanaar authored all 100 Neythal verses of Ainkurunooru."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 114", "url": null, "sourc