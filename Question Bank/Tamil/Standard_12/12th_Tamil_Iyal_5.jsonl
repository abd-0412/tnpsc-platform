{"id": "12th_tamil_u5_q920", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "padimam", "chapter_id": null, "topic_id": "purananooru_padimam_example", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘நரைமுடி இல்லாமைக்குக் காரணம்... மாண்ட என் மனைவியோடு மக்களும் நிரம்பினர்...’ என்னும் பிசிராந்தையார் பாடலில் வெளிப்படும் படிமம் எதனைச் சித்தரிக்கிறது?", "media_id": null}], "options": {"A": "போர்க்களக் காட்சி", "B": "வறுமையின் கோலம்", "C": "அரசவையின் ஆடம்பரம்", "D": "நல்லொழுக்கமும் அன்பும் நிறைந்த நல்ல குடும்ப வாழ்வின் நிறைவான காட்சிப் படிமம்"}, "explanation": "அன்பான மனைவி, பண்புடைய பிள்ளைகள், ஏவல் கேட்கும் நல்ல பணியாளர்கள் ஆகியோரைக் கொண்ட மனநிறைவான குடும்பப் படிமமே முதுமையிலும் நரையின்றி வாழ்வதற்குக் காரணம் என்கிறார் புலவர்."}, "en": {"blocks": [{"type": "text", "content": "What domestic scene is projected in Pisiranthaiyar's Purananooru verse explaining the absence of grey hair in old age?", "media_id": null}], "options": {"A": "Battlefield combat", "B": "Bleak poverty", "C": "Palace luxury", "D": "An idyllic visual portrait of virtuous domestic harmony, dutiful children, and tranquil contentment"}, "explanation": "The poem creates a portrait of domestic harmony shielding against aging."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 120, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 120", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 5", "Grammar", "Purananooru Image"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u5_q921", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "padimam", "chapter_id": null, "topic_id": "symbol_vs_padimam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "படிமத்திற்கும் குறியீட்டிற்கும் (Symbol) இடையிலான நுட்பமான வேறுபாடு யாது?", "media_id": null}], "options": {"A": "படிமம் காட்சியைக் கண்முன் நிறுத்துகிறது; குறியீடு குறிப்பிட்ட ஒரு காட்சியின் வழி மற்றொரு ஆழமான மறைமுகக் கருத்தை உணர்த்துகிறது", "B": "இரண்டும் முற்றிலும் ஒன்றே", "C": "படிமத்தில் பொருள் இருக்காது", "D": "குறியீட்டில் உருவம் இருக்காது"}, "explanation": "படிமம் என்பது காட்சியைத் துல்லியமாக மனக்கண்ணில் நிறுத்துவது; குறியீடு (Symbol) என்பது ஒரு பொருளின் வழி மற்றொரு கருத்தை மறைமுகமாகச் சுட்டுவது (எ.கா: புறா அமைதியின் குறியீடு)."}, "en": {"blocks": [{"type": "text", "content": "What is the subtle distinction separating an Image (Padimam) from a Symbol (Kuriyeedu)?", "media_id": null}], "options": {"A": "An image visualizes a sensory scene directly; a symbol stands as an emblem representing an abstract secondary concept", "B": "They are completely identical", "C": "An image carries zero meaning", "D": "A symbol possesses no form"}, "explanation": "An image sensory-renders an object, whereas a symbol points to an abstract reality beyond itself."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source":