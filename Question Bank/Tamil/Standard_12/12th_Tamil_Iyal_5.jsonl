{"id": "12th_tamil_u5_q811", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "madarasapattinam", "chapter_id": null, "topic_id": "theosophical_society", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அடையாற்றின் கரையில் 1882-இல் தலைமையகத்தை அமைத்து உலகளாவிய ஆன்மிகத் தாக்கத்தை ஏற்படுத்திய அமைப்பு எது?", "media_id": null}], "options": {"A": "பிரம்ம சமாஜம்", "B": "ஆரிய சமாஜம்", "C": "பிரம்மஞான சபை (Theosophical Society)", "D": "இராமகிருஷ்ண மடம்"}, "explanation": "மேடம் பிளவாட்ஸ்கி மற்றும் கர்னல் ஆல்காட் ஆகியோரால் தொடங்கப்பட்ட பிரம்மஞான சபையின் உலகத் தலைமையகம் 1882-இல் அடையாற்றில் அமைக்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which global esoteric movement set up its international headquarters on the banks of the Adyar River in 1882?", "media_id": null}], "options": {"A": "Brahmo Samaj", "B": "Arya Samaj", "C": "Theosophical Society", "D": "Ramakrishna Math"}, "explanation": "The Theosophical Society established its international headquarters in Adyar in 1882."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 106, "chapter": null, "section": null, "reference": "12th Ta