{"id": "12th_tamil_u5_q914", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "padimam", "chapter_id": null, "topic_id": "complex_image_combination", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒரே கவிதையில் காட்சியும் ஒலியும் சுவையும் இணைந்து வரும் படிமக் கூட்டமைப்பு எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "தனிப் படிமம்", "B": "கூட்டுப் படிமம் / கலவைப் படிமம் (Complex / Composite Image)", "C": "எதிர் படிமம்", "D": "வெற்றுப் படிமம்"}, "explanation": "ஒன்றுக்கும் மேற்பட்ட புலன் உணர்வுகளை ஒரே கவிதை வரிகளில் ஒன்றிணைத்துக் காட்டும் படிம உத்தி 'கூட்டுப் படிமம்' எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What is a multi-layered poetic image combining visual, auditory, and tactile elements in unison termed?", "media_id": null}], "options": {"A": "Isolated image", "B": "Composite / Complex Image (Kootup Padimam)", "C": "Anti-image", "D": "Blank image"}, "explanation": "A composite image synchronizes multiple sensory perceptions into a single unified aesthetic experience."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 120, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 120", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 5", "Grammar", "Composite Image"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u5_q915", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "padimam", "chapter_id": null, "topic_id": "kurunthogai_padimam_example", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘யாயும் ஞாயும் யார் ஆகியரோ... செம்புலப் பெயல்நீர் போல...’ என்னும் குறுந்தொகைப் பாடலில் அன்பை விளக்கும் படிமம் எது?", "media_id": null}], "options": {"A": "கடல் அலை", "B": "காற்று", "C": "செம்மண் நிலத்தில் பெய்த மழைநீர் அம்மண்ணோடு கலந்து ஒன்றுபடும் காட்சி", "D": "நெருப்பு"}, "explanation": "செம்மண் நிலத்தில் பெய்த மழைநீர் பிரித்தெடுக்க முடியாதவாறு கலந்து செந்நிறமாவது போல, தலைவனும் தலைவியும் அன்பால் கலந்தனர் என்னும் உன்னதமான காட்சிப் படிமம் இது."}, "en": {"blocks": [{"type": "text", "content": "What evocative sensory image symbolizes inseparable love in the classic Kurunthogai lyric 'Sembula Peyal Neer Pola'?", "media_id": null}], "options": {"A": "Crashing sea breakers", "B": "Brisk gale wind", "C": "Rain pouring onto red loam soil merging into inseparable oneness", "D": "Flaring fire"}, "explanation": "Rainwater mingling indistinguishably with red soil forms an immortal Sangam image of unified souls."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class"