{"id": "12th_tamil_u5_q787", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "madarasapattinam", "chapter_id": null, "topic_id": "fort_st_george", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சென்னையில் ஆங்கிலேயர்களால் 1640-ஆம் ஆண்டு கட்டி முடிக்கப்பட்ட கோட்டையின் பெயர் என்ன?", "media_id": null}], "options": {"A": "புனித டேவிட் கோட்டை", "B": "செஞ்சிக் கோட்டை", "C": "புனித ஜார்ஜ் கோட்டை (Fort St. George)", "D": "வட்டக்கோட்டை"}, "explanation": "சென்னையில் கிழக்கிந்திய கம்பெனியார் 1640 ஏப்ரல் 23 (புனித ஜார்ஜ் திருநாள்) அன்று கட்டி முடித்த கோட்டை 'புனித ஜார்ஜ் கோட்டை' என அழைக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the historical fortress completed by the British East India Company in Madras in 1640 named?", "media_id": null}], "options": {"A": "Fort St. David", "B": "Gingee Fort", "C": "Fort St. George", "D": "Vattakottai"}, "explanation": "Fort St. George, consecrated on St. George's Day in 1640, formed the nucleus of modern Madras."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 105, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page