{"id": "12th_tamil_u5_q798", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "madarasapattinam", "chapter_id": null, "topic_id": "chennai_printing_press", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சென்னையில் ஆங்கிலேயர்களால் அச்சு இயந்திரங்கள் கொண்டுவரப்பட்டு, தமிழ் நூல்கள் அச்சிடுவதில் முன்னோடியாகத் திகழ்ந்த அச்சுக்கூடம் எது?", "media_id": null}], "options": {"A": "சரசுவதி மகால் அச்சுக்கூடம்", "B": "வேப்பேரி அச்சுக்கூடம் (SPCK Press - 1761)", "C": "கலைமகள் அச்சகம்", "D": "சாந்தி அச்சகம்"}, "explanation": "1761-இல் பாண்டிச்சேரியில் கைப்பற்றப்பட்ட அச்சு இயந்திரங்களைக் கொண்டு வேப்பேரியில் கிறித்துவ அறிவு பரப்பும் சங்கம் (SPCK) அச்சுக்கூடத்தைத் தொடங்கியது."}, "en": {"blocks": [{"type": "text", "content": "Which historic printing establishment established in Vepery in 1761 spearheaded early commercial typography in Madras?", "media_id": null}], "options": {"A": "Saraswathi Mahal Press", "B": "Vepery SPCK Press (1761)", "C": "Kalaimagal Press", "D": "Santhi Press"}, "explanation": "The SPCK Press at Vepery was founded in 1761 utilizing presses captured from Pondicherry."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "