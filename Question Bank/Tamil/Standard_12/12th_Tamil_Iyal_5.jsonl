{"id": "12th_tamil_u5_q898", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "padimam", "chapter_id": null, "topic_id": "english_equivalent", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘படிமம்’ என்பதற்கு இணையான ஆங்கிலச் சொல் எது?", "media_id": null}], "options": {"A": "Metaphor", "B": "Image (Imagism)", "C": "Symbol", "D": "Myth"}, "explanation": "‘படிமம்’ என்பதற்கு இணையான ஆங்கில இலக்கியச் சொல் 'Image' என்பதாகும். உருவகம் என்பது Metaphor; குறியீடு என்பது Symbol; தொன்மம் என்பது Myth."}, "en": {"blocks": [{"type": "text", "content": "What is the standard English literary equivalent for the Tamil critical concept 'Padimam'?", "media_id": null}], "options": {"A": "Metaphor", "B": "Image (Imagism)", "C": "Symbol", "D": "Myth"}, "explanation": "'Padimam' corresponds to 'Image' in Anglo-American literary criticism."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 119, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 119", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "ses