{"id": "12th_tamil_u5_q951", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "unit5_exercises", "chapter_id": null, "topic_id": "mayangoli_variations", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்கண்டவற்றுள் சரியான மயங்கொலிப் பயன்பாடு அமைந்த வாக்கியத்தைத் தேர்வு செய்க:", "media_id": null}], "options": {"A": "அவன் உளவு செய்து நெல் அறுத்தான்", "B": "உப்பலத்தில் அலம் விளைந்தது", "C": "போர்க்களத்தில் கலம் கொண்டு போரிட்டனர்", "D": "அவன் கடலில் களம் ஓட்டினான்"}, "explanation": "போர்க்களம் (களம்) என்பதும், பாத்திரம் அல்லது கலம் (போர்க்கருவிகள்/கலன்கள்) என்பதும் சரியான முறையில் ஆளப்பட்டுள்ளது. பிற வாக்கியங்களில் ள/ல எழுத்துப் பிழைகள் உள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Select the grammatically accurate sentence exhibiting correct usage of homophonic letters (La/Zha/La):", "media_id": null}], "options": {"A": "He conducted espionage (Ulavu) and harvested paddy", "B": "In the salt pan grief (Alam) was harvested", "C": "In the martial arena (Kalam) they fought wielding vessels/weapons (Kalam)", "D": "He navigated an arena (Kalam) across the ocean"}, "explanation": "Option C maintains pristine homophonic precision."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educati