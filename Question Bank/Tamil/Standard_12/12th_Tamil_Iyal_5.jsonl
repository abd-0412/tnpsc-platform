{"id": "12th_tamil_u5_q922", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "padimam", "chapter_id": null, "topic_id": "modern_haiku_padimam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜப்பானிய ‘ஹைக்கூ’ (Haiku) கவிதைகள் பெரும்பாலும் எந்த இலக்கிய உத்தியை அடிப்படையாகக் கொண்டு இயங்குகின்றன?", "media_id": null}], "options": {"A": "நீண்ட உரைநடை விளக்கம்", "B": "சுருக்கமான, மின்னல் போன்ற ஒரு கணக் காட்சிப் படிமம் (Instant Flash Image)", "C": "அரசியல் முழக்கம்", "D": "கதை சொல்லும் பாங்கு"}, "explanation": "ஹைக்கூ கவிதைகள் மூன்றே வரிகளில் இயற்கை சார்ந்த ஒரு கணக் காட்சிப் படிமத்தை வாசகனின் மனதில் மின்னல் போல் பதிய வைக்கும் இயல்புடையவை."}, "en": {"blocks": [{"type": "text", "content": "On which core aesthetic device do Japanese Haiku poems predominantly rely to deliver poetic insight?", "media_id": null}], "options": {"A": "Elaborate prose exposition", "B": "A lightning-like, instantaneous visual Image (Instant Flash Image)", "C": "Political propaganda", "D": "Epic storytelling"}, "explanation": "Haiku relies fundamentally on presenting an instantaneous flash of nature imagery."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 121, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 121", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 5", "Grammar", "Haiku Imagery"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
