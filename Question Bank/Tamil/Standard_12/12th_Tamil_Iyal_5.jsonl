{"id": "12th_tamil_u5_q871", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thalaikkulam", "chapter_id": null, "topic_id": "first_novel", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தோப்பில் முகம்மது மீரானின் புகழ்பெற்ற முதல் நாவல் எது?", "media_id": null}], "options": {"A": "துறைமுகம்", "B": "சாய்வு நாற்காலி", "C": "ஒரு கடலோரக் கிராமத்தின் கதை (1988)", "D": "அனந்தசயனம் காலனி"}, "explanation": "1988-ஆம் ஆண்டு வெளியான ‘ஒரு கடலோரக் கிராமத்தின் கதை’ தோப்பில் முகம்மது மீரானின் முதல் நாவலாகும். இது பல இந்திய மொழிகளில் மொழிபெயர்க்கப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "What was the debut novel of Thoppil Mohamed Meeran published in 1988 that established his literary stature?", "media_id": null}], "options": {"A": "Thuraimugam", "B": "Saaivu Naarkaali", "C": "Oru Kadalora Grammathin Kathai (1988)", "D": "Ananthasayanam Colony"}, "explanation": "'Oru Kadalora Grammathin Kathai' was Meeran's groundbreaking debut novel published in 1988."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 117, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 1