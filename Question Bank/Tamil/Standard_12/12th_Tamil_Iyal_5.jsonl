{"id": "12th_tamil_u5_q831", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "deivamani_maalai", "chapter_id": null, "topic_id": "vallalar_samarasam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சாதி, மதம், இனம் கடந்த ஆன்மநேய ஒருமைப்பாட்டை வலியுறுத்திய வள்ளலார் நிறுவிய கொள்கை இயக்கம் எது?", "media_id": null}], "options": {"A": "சுயமரியாதை இயக்கம்", "B": "சைவ சித்தாந்த சபை", "C": "சமரச சுத்த சன்மார்க்க சங்கம்", "D": "ராமகிருஷ்ண இயக்கம்"}, "explanation": "எல்லா மதங்களின் உண்மையும் ஒன்றே என்னும் சமரச சுத்த சன்மார்க்க நெறியை வள்ளலார் உலகிற்குப் போதித்தார்."}, "en": {"blocks": [{"type": "text", "content": "What universal fellowship movement transcending caste, creed, and dogma was founded by Vallalar?", "media_id": null}], "options": {"A": "Self-Respect Movement", "B": "Saiva Siddhanta Sabha", "C": "Samarasa Suddha Sanmarga Sangam", "D": "Ramakrishna Mission"}, "explanation": "Vallalar founded the Samarasa Suddha Sanmarga movement advocating universal spiritual egalitarianism."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 110, "chapter": null, "section": null, "reference": "12th Tam