{"id": "12th_tamil_u5_q894", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thalaikkulam", "chapter_id": null, "topic_id": "pond_water_clarity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழைய காலத்துத் தலைக்குளத்து நீரின் தூய்மையை ஆசிரியர் எவ்வாறு உவமிக்கிறார்?", "media_id": null}], "options": {"A": "பன்னீர் போல", "B": "கண்ணாடி போன்ற தெளிந்த நீர்", "C": "பால் போன்ற வெண்மை", "D": "மழைத்துளி போல"}, "explanation": "குளத்தின் அடியில் கிடக்கும் மணலும் சிறு கூழாங்கற்களும் தெரியும் அளவிற்குத் தலைக்குளத்தின் நீர் 'கண்ணாடி போன்று' பளிச்சென்று துலங்கியதாக ஆசிரியர் விவரிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "How does the author describe the immaculate crystalline purity of the ancestral pond waters in its prime?", "media_id": null}], "options": {"A": "Like scented rosewater", "B": "Crystalline and clear as polished glass (Kannaadi)", "C": "Milky white", "D": "Like a fresh raindrop"}, "explanation": "The water was so crystalline like clear glass that pebbles on the pond bed were clearly visible."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 115, "chapter": null, "s