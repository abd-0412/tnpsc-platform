{"id": "12th_tamil_u5_q907", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "padimam", "chapter_id": null, "topic_id": "modern_poetry_padimam_pramil", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சுடுமணலில் நெளியும் புழு’ என்னும் நவீனக் கவிதைப் படிமம் எதனை உணர்த்தப் பயன்படுகிறது?", "media_id": null}], "options": {"A": "இயற்கையின் பசுமை", "B": "மழைக்கால வளம்", "C": "வாழ்க்கைப் போராட்டத்தில் துன்புறும் மனிதனின் தவிப்பு மற்றும் துன்பம்", "D": "குழந்தையின் விளையாட்டு"}, "explanation": "சுட்ட மணலின் தணலில் சிக்கிய புழு துடிப்பது போன்ற படிமம், கொடிய வறுமையிலும் துன்பத்திலும் அல்லலுறும் சாமானிய மனிதனின் துயரத்தை உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What existential condition is evoked by the modern poetic image of an earthworm writhing on scorching sand?", "media_id": null}], "options": {"A": "Verdant pastoral bliss", "B": "Monsoon bounty", "C": "Human agony and torment struggling amidst harsh existential realities", "D": "Childhood games"}, "explanation": "The image captures existential agony and human distress under punishing societal conditions."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 121, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 121", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 5", "Grammar", "Modern Image"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u5_q908", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "padimam", "chapter_id": null, "topic_id": "uvamai_padimam_difference", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உவமைக்கும் படிமத்திற்கும் இடையிலான முதன்மைத் தொடர்பு யாது?", "media_id": null}], "options": {"A": "இரண்டும் ஒன்றுக்கொன்று தொடர்பில்லாதவை", "B": "உவமையில் காட்சி இருக்காது", "C": "படிமத்தில் உவம உருபு வெளிப்படையாக வரும்", "D": "உவமையே படிமம் தோன்றுவதற்குக் காரணமாக அமைகிறது; உவம உருபின்றி காட்சியே நேரடியாக நிற்பது படிமம்"}, "explanation": "உவம உருபுகள் இன்றி ஒரு காட்சி தன் இயல்பான படமாக மனக்கண்ணில் உருப்பெற்று நிற்பதே படிமம் ஆகும். உவமையே படிமத்தின் அடிப்படையாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the intrinsic aesthetic relationship between a classical Simile (Uvamai) and an Image (Padimam)?", "media_id": null}], "options": {"A": "They are mutually contradictory", "B": "Similes never contain visual elements", "C": "Images always include explicit simile markers", "D": "Simile forms the bedrock of imagery; an image presents the visual scene directly without relying on overt simile markers"}, "explanation": "An image distills simile into an immediate sensory visual perception without overt grammatical connectors."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 119, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 119", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 5", "Grammar", "Simile vs Image"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u5_q909", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "padimam", "chapter_id": null, "topic_id": "padimam_function_poetry", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிதையில் ‘படிமம்’ ஆற்றுப்படுத்தும் முதன்மைப் பணி யாது?", "media_id": null}], "options": {"A": "கருத்தை நேரடியாகச் சொல்லாமல், ஒரு காட்சியின் வழி வாசகனின் உணர்வில் ஆழமாகப் பதிய வைத்தல்", "B": "பாடலின் அளவை நீட்டுவது", "C": "கடினமான சொற்களை அமைப்பது", "D": "எழுத்துகளின் எண்ணிக்கையைக் கூட்டுவது"}, "explanation": "படிமம் என்பது கருத்தைத் தட்டையாகக் கூறாமல், காட்சியின் வாயிலாக வாசகனின் உள்ளத்தில் உணர்வைத் தூண்டிப் புதிய தரிசனத்தை அளிப்பதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the primary aesthetic function of an Image (Padimam) in poetry?", "media_id": null}], "options": {"A": "Inscribing an idea deeply through a vivid sensory picture rather than flat abstract exposition", "B": "Artificially lengthening stanza size", "C": "Inserting esoteric vocabulary", "D": "Maximizing syllable count"}, "explanation": "An image communicates poetic nuance vividly through evocative sensory visualization."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 119, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 119", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 5", "Grammar", "Padimam Function"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u5_q910", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "padimam", "chapter_id": null, "topic_id": "padimam_tholkappiyam_origin", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொல்காப்பியர் படிமம் என்பதற்கு இணையான எந்த இலக்கணக் கூறினை உவமவியலில் குறிப்பிட்டுள்ளார்?", "media_id": null}], "options": {"A": "உள்ளுறை மட்டும்", "B": "‘வண்ணம்’, ‘படிவம்’ அல்லது வடிவம் சார்ந்த உவமக் கூறுகள்", "C": "இறைச்சி மட்டும்", "D": "மெய்ப்பாடு மட்டும்"}, "explanation": "தொல்காப்பிய உவமவியலில் வினை, பயன், மெய், உரு ஆகிய நான்கின் அடிப்படையில் தோன்றும் உவமைகளே படிமத்தின் மூலவேர்களாக விளங்குகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Which theoretical basis in Tolkappiyam's Uvamaviyal anticipates modern poetic imagery?", "media_id": null}], "options": {"A": "Ullurai alone", "B": "The fourfold bases of comparison: Action (Vinai), Effect (Payan), Form/Shape (Mey), and Color/Hue (Uru)", "C": "Iraichi alone", "D": "Meyppaadu alone"}, "explanation": "Tolkappiyar's fourfold comparison criteria (Vinai, Payan, Mey, Uru) laid the theoretical roots of Tamil imagery."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "e