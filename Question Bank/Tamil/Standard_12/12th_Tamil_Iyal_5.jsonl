{"id": "12th_tamil_u5_q816", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "deivamani_maalai", "chapter_id": null, "topic_id": "oru_maiyudan_song", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஒருமையுடன் நினது திருமலரடி நினைக்கின்ற உத்தமர்தம் உறவு வேண்டும்...’ என்று தொடங்கும் பாடலின் ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "தாயுமானவர்", "B": "பட்டினத்தார்", "C": "பாரதியார்", "D": "திருவருட்பிரகாச வள்ளலார்"}, "explanation": "இப்பாடல் வள்ளலார் கந்தக்கோட்டத்து முருகனை நோக்கித் தூய மனம் கொண்ட நல்லோரின் நட்பை வேண்டிப் பாடிய புகழ்பெற்ற பாடலாகும்."}, "en": {"blocks": [{"type": "text", "content": "Who penned the immortal ethical prayer 'Oru maiyudan ninathu thirumalaradi ninaikindra uthamartham uravu vendum...'?", "media_id": null}], "options": {"A": "Thaayumaanavar", "B": "Pattinathar", "C": "Bharathiyar", "D": "Thiruvarutprakasa Vallalar"}, "explanation": "Vallalar composed this celebrated prayer imploring fellowship with the noble-hearted."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 109, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 109",