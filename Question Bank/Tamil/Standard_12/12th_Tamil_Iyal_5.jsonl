{"id": "12th_tamil_u5_q899", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "padimam", "chapter_id": null, "topic_id": "imagism_movement_poets", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இருபதாம் நூற்றாண்டின் தொடக்கத்தில் மேலைநாடுகளில் படிமக் கவிதை இயக்கத்தைத் (Imagism) தோற்றுவித்த முன்னோடிகளுள் ஒருவர் யார்?", "media_id": null}], "options": {"A": "ஷேக்ஸ்பியர்", "B": "வேர்ட்ஸ்வொர்த்", "C": "டி.இ. ஹியூம் மற்றும் எஸ்ரா பவுண்ட் (T.E. Hulme & Ezra Pound)", "D": "ஜான் கீட்ஸ்"}, "explanation": "20-ஆம் நூற்றாண்டின் தொடக்கத்தில் டி.இ. ஹியூம், எஸ்ரா பவுண்ட், எமி லோவல் போன்ற கவிஞர்கள் 'படிமவியல்' (Imagism) இயக்கத்தை முன்னெடுத்தனர்."}, "en": {"blocks": [{"type": "text", "content": "Who among the following was a leading founder of the 20th-century Anglo-American Imagist poetry movement?", "media_id": null}], "options": {"A": "William Shakespeare", "B": "William Wordsworth", "C": "T.E. Hulme and Ezra Pound", "D": "John Keats"}, "explanation": "T.E. Hulme and Ezra Pound spearheaded the celebrated Imagist movement in modern literature."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 119, "cha