{"id": "12th_tamil_u5_q895", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thalaikkulam", "chapter_id": null, "topic_id": "human_nature_contrast", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கதையில் வெளிப்படும் இரண்டு தலைமுறைகளுக்கு இடையிலான முரண்பாடு யாது?", "media_id": null}], "options": {"A": "உணவுப் பழக்க முரண்பாடு", "B": "உடை மாற்ற முரண்பாடு", "C": "இயற்கையையும் பாரம்பரியத்தையும் போற்றிய பழைய தலைமுறை vs பணத்தையும் நுகர்வையும் மட்டுமே போற்றும் புதிய தலைமுறை", "D": "மொழிகளுக்கிடையிலான முரண்பாடு"}, "explanation": "இயற்கையோடு இணைந்து குளத்தையும் மரங்களையும் போற்றிய மூத்த தலைமுறையினருக்கும், அனைத்தையும் பண மதிப்பாக மட்டுமே பார்க்கும் புதிய நுகர்வு கலாச்சாரத்தினருக்கும் இடையிலான முரண்பாடே கதையாகிறது."}, "en": {"blocks": [{"type": "text", "content": "What generational ideological divergence is foregrounded throughout the story 'Thalaikkulam'?", "media_id": null}], "options": {"A": "Dietary choices", "B": "Sartorial fashion differences", "C": "Reverence for nature and communal roots among elders vs mercenary consumerist materialism among the young", "D": "Linguistic divergence"}, "explanation": "The story contrasts ecological reverence for heritage against modern commodification of living space."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tam