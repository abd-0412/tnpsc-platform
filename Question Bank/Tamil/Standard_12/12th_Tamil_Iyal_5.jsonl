{"id": "12th_tamil_u5_q888", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thalaikkulam", "chapter_id": null, "topic_id": "village_elders_attitude", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குளத்தை விற்க முற்படும் இளைய தலைமுறையின் முடிவை ஊர் பெரியவர்கள் எவ்வாறு எதிர்கொள்கின்றனர்?", "media_id": null}], "options": {"A": "ஆரவாரத்தோடு வரவேற்கின்றனர்", "B": "கண்டுகொள்ளாமல் விலகி நிற்கின்றனர்", "C": "மகிழ்ச்சியுடன் பங்கிட்டுக் கொள்கின்றனர்", "D": "தடுக்க இயலாத இயலாமையுடன் கண்ணீர் சிந்துகின்றனர்"}, "explanation": "பழைய தலைமுறையைச் சேர்ந்த பெரியவர்கள் குளத்தை விற்பதைத் தங்களின் உயிரையே பறிப்பது போல் உணர்ந்தாலும், மாற்றத்தைத் தடுக்க முடியாமல் வேதனையுடன் கையறு நிலையில் நிற்கின்றனர்."}, "en": {"blocks": [{"type": "text", "content": "How do the village elders react to the commercial decision to parcel off and sell the ancestral pond?", "media_id": null}], "options": {"A": "They welcome it enthusiastically", "B": "They remain completely indifferent", "C": "They divide the profits happily", "D": "They watch in helpless anguish, shedding silent tears over the destruction of their heritage"}, "explanation": "The village elders are heartbroken and powerless against the tide of commercialization."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Sam