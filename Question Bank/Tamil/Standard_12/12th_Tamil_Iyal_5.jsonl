{"id": "12th_tamil_u5_q793", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "madarasapattinam", "chapter_id": null, "topic_id": "connemara_public_library", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சென்னையில் அமைந்துள்ள புகழ்பெற்ற கன்னிமாரா பொது நூலகம் (Connemara Library) எந்த ஆண்டு திறக்கப்பட்டது?", "media_id": null}], "options": {"A": "1896", "B": "1857", "C": "1905", "D": "1920"}, "explanation": "சென்னை ஆளுநராக இருந்த கன்னிமாரா பிரபுவின் பெயரால் எழும்பூர் அருங்காட்சியக வளாகத்தில் 1896-இல் கன்னிமாரா பொது நூலகம் தொடங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "In which year was the historic Connemara Public Library opened to the public in Egmore, Chennai?", "media_id": null}], "options": {"A": "1896", "B": "1857", "C": "1905", "D": "1920"}, "explanation": "The Connemara Public Library was opened in 1896, named after Lord Connemara, Governor of Madras."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 107, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 107", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false