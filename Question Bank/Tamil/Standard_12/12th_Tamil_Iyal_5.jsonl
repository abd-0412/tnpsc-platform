{"id": "12th_tamil_u5_q794", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "madarasapattinam", "chapter_id": null, "topic_id": "indo_saracenic_architecture", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சென்னை சென்ட்ரல் ரயில் நிலையம், சென்னை உயர்நீதிமன்றம், விக்டோரியா அரங்கு போன்றவை எந்த கட்டிடக்கலைப் பாணியில் கட்டப்பட்டுள்ளன?", "media_id": null}], "options": {"A": "திராவிடக் கட்டிடக்கலை", "B": "இந்தோ-சாராசனிக் பாணி (Indo-Saracenic)", "C": "கோதிக் கட்டிடக்கலை மட்டும்", "D": "ரோமானியப் பாணி"}, "explanation": "பிரிட்டிஷ் கட்டிடக் கலைஞர் ராபர்ட் சிஷோம், ஹென்றி இர்வின் ஆகியோரால் முகலாய மற்றும் ஐரோப்பியக் கூறுகளை இணைத்து 'இந்தோ-சாராசனிக்' கட்டிடக்கலைப் பாணியில் சென்னையின் பாரம்பரியக் கட்டிடங்கள் உருவாக்கப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "In which distinctive hybrid architectural style are landmarks like the Madras High Court and Central Station constructed?", "media_id": null}], "options": {"A": "Dravidian architecture", "B": "Indo-Saracenic revival style", "C": "Pure Gothic architecture", "D": "Roman classicism"}, "explanation": "Chennai's historic colonial monuments are world-renowned examples of Indo-Saracenic architecture."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Tex