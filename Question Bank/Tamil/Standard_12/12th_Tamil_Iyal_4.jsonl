{"id": "12th_tamil_u4_q590", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "uve_sa_expansion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உ.வே. சாமிநாதையரின் முழுப் பெயர் விரிவாக்கம் யாது?", "media_id": null}], "options": {"A": "உறையூர் வேங்கடசுப்பையர் சாமிநாதன்", "B": "உத்தமதானபுரம் வேங்கடசுப்பையர் சாமிநாதன்", "C": "உடையார்பாளையம் வேங்கடசுப்பையர் சாமிநாதன்", "D": "உத்திரமேரூர் வேங்கடசுப்பையர் சாமிநாதன்"}, "explanation": "உ.வே.சா என்பதன் விரிவாக்கம் ‘உத்தமதானபுரம் வேங்கடசுப்பையர் சாமிநாதன்’ என்பதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the full expansion of the acronym 'U. V. Sa'?", "media_id": null}], "options": {"A": "Uraiyur Venkatasubbaiyer Swaminathan", "B": "Uthamadhanapuram Venkatasubbaiyer Swaminathan", "C": "Udayarpalayam Venkatasubbaiyer Swaminathan", "D": "Utthiramerur Venkatasubbaiyer Swaminathan"}, "explanation": "U. V. Sa stands for Uthamadhanapuram Venkatasubbaiyer Swaminathan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 70, "chapter": null, "section": null, "reference":