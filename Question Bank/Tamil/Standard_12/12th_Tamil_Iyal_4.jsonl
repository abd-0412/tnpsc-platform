{"id": "12th_tamil_u4_q603", "schema_version": "1.0", "kind": "matching", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "ancient_school_terms_match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைய கல்விச் சொற்களைப் பொருத்துக:\n1. கணக்காயர் - அ) மாணவர் தலைவர்\n2. சட்டம் பிள்ளை - ஆ) ஆசிரியர்\n3. எழுத்தாணி - இ) கணிதச் சுவடி\n4. எண்சுவடி - ஈ) எழுதும் கருவி", "media_id": null}], "options": {"A": "1-அ, 2-ஆ, 3-இ, 4-ஈ", "B": "1-ஈ, 2-இ, 3-ஆ, 4-அ", "C": "1-ஆ, 2-அ, 3-ஈ, 4-இ", "D": "1-இ, 2-ஈ, 3-அ, 4-ஆ"}, "explanation": "கணக்காயர் - ஆசிரியர் (ஆ); சட்டம் பிள்ளை - மாணவர் தலைவர் (அ); எழுத்தாணி - எழுதும் கருவி (ஈ); எண்சுவடி - கணிதச் சுவடி (இ). சரியான பொருத்தம்: 1-ஆ, 2-அ, 3-ஈ, 4-இ."}, "en": {"blocks": [{"type": "text", "content": "Match the ancient educational terms:\n1. Kanakkayar - a) Senior student monitor\n2. Sattam Pillai - b) Instructor / Schoolmaster\n3. Ezhutthaani - c) Mathematics palm-leaf primer\n4. En-suvadi - d) Iron stylus", "media_id": null}], "options": {"A": "1-a, 2-b, 3-c, 4-d", "B": "1-d, 2-c, 3-b, 4-a", "C": "1-b, 2-a, 3-d, 4-c", "D": "1-c, 2-d, 3-a, 4-b"}, "explanation": "Kanakkayar: b; Sattam Pillai: a; Ezhutthaani: d; En-suvadi: c."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "T