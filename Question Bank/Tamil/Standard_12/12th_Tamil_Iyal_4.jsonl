{"id": "12th_tamil_u4_q755", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "unit4_exercises", "chapter_id": null, "topic_id": "sandhi_kadavul_arull", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கடவுளருள்’ என்னும் சொல்லின் சரியான புணர்ச்சி விதி யாது?", "media_id": null}], "options": {"A": "இடனொற்று இரட்டல்", "B": "ஈறுபோதல்", "C": "தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும் (கடவுள் + அருள் = கடவுள்ளருள் அல்ல; தனிக்குறில் அல்லாததால் ‘உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே’)", "D": "ஆதிநீடல்"}, "explanation": "‘கடவுள்’ என்பதில் ‘வுள்’ தனிக்குறில் முன் ஒற்று அன்று. எனவே ‘உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே’ என்னும் பொது விதிப்படி ள் + அ = ள ஆகி ‘கடவுளருள்’ எனப் புணர்ந்தது."}, "en": {"blocks": [{"type": "text", "content": "Which morphophonemic rule applies to unite 'Kadavul + Arul' into 'Kadavularul'?", "media_id": null}], "options": {"A": "Doubling of final consonant after mono-short syllable", "B": "Deletion of coda consonant", "C": "Direct union of consonant and following vowel (Udalmael Uyirvanthu Ondruvathu Iyalbae)", "D": "Elongation of initial radical"}, "explanation": "'Kadavul + Arul' fuses cleanly under the universal rule 'Udalmael Uyirvanthu Ondruvathu Iyalbae' (l + a = la)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Ka