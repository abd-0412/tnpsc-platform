{"id": "12th_tamil_u4_q716", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "paa_iyatra_pazhagalam", "chapter_id": null, "topic_id": "nerisai_venpaa_thanicheer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நான்கு அடிகளைக் கொண்டு, இரண்டாம் அடியின் இறுதியில் 'தனிச்சீர்' பெற்று, முதலிரண்டு அடிகளும் பின்னிரண்டு அடிகளும் தனித்தனி எதுகை பெற்று வருவது எது?", "media_id": null}], "options": {"A": "இன்னிசை வெண்பா", "B": "கலிவெண்பா", "C": "பஃறொடை வெண்பா", "D": "நேரிசை வெண்பா"}, "explanation": "இரண்டாம் அடியின் ஈற்றில் தனிச்சீர் பெற்று, முதல் இரண்டு அடி ஒரு எதுகையாகவும், பின் இரண்டு அடி வேறொரு எதுகையாகவும் வருவது 'நேரிசை வெண்பா' எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Which 4-line Venpa features a isolated bridging foot (Thanicheer) at the end of line 2, linking two rhyming couplets?", "media_id": null}], "options": {"A": "Innisaivenpa", "B": "Kalivenpa", "C": "Pakrodai Venpa", "D": "Nerisaivenpa"}, "explanation": "Nerisaivenpa has 4 lines with a detached foot (Thanicheer) at the end of line 2 and dual rhyming couplets."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 90, "c