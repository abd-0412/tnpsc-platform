{"id": "12th_tamil_u4_q758", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "u4_pyq_integration", "chapter_id": null, "topic_id": "suratha_pseudonym", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உவமைக் கவிஞர் சுரதா எந்தக் கவிஞர் மீது கொண்ட பற்றினால் தன் இயற்பெயரை மாற்றிக்கொண்டார்?", "media_id": null}], "options": {"A": "மகாகவி பாரதியார்", "B": "பாரதிதாசன்", "C": "கவிமணி தேசிக விநாயகம்", "D": "வாணிதாசன்"}, "explanation": "சுரதா (ராசகோபாலன்) புரட்சிக் கவிஞர் பாரதிதாசன் மீது கொண்ட மாறாப் பற்றினால் ‘சுப்புரத்தினதாசன்’ (சுரதா) என்று தன் பெயரை மாற்றிக்கொண்டார்."}, "en": {"blocks": [{"type": "text", "content": "Out of deep devotion to which master poet did Suradha adopt his enduring literary pseudonym?", "media_id": null}], "options": {"A": "Mahakavi Bharati", "B": "Bharathidasan", "C": "Kavimani Desika Vinayagam", "D": "Vanidasan"}, "explanation": "Suradha (Rasagopalan) adopted the pen name Subburathina-dasan (Suradha) out of adoration for Subburathinam (Bharathidasan)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 80, "chapter": null, "section": null, "reference": "12th Tamil, Unit