{"id": "12th_tamil_u4_q690", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pathukaapaai_oru_payanam", "chapter_id": null, "topic_id": "speed_limit_school_zone", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பள்ளிகள் மற்றும் கல்வி நிலையங்கள் அமைந்துள்ள சாலைகளில் வாகனங்களின் அதிகபட்ச வேக வரம்பு பொதுவாக எவ்வளவாக நிர்ணயிக்கப்படுகிறது?", "media_id": null}], "options": {"A": "மணிக்கு 50 கி.மீ.", "B": "மணிக்கு 25 முதல் 30 கி.மீ.", "C": "மணிக்கு 60 கி.மீ.", "D": "மணிக்கு 80 கி.மீ."}, "explanation": "மாணவர்களின் பாதுகாப்பைக் கருதி பள்ளி வளாகப் பகுதிகளில் வாகனங்கள் மணிக்கு 25 முதல் 30 கி.மீ. வேகத்திற்கு மேல் செல்லக்கூடாது என்ற வேக வரம்பு நிர்ணயிக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the general prescribed speed ceiling for motorized vehicular traffic traversing school and institutional zones?", "media_id": null}], "options": {"A": "50 km/h", "B": "25 to 30 km/h", "C": "60 km/h", "D": "80 km/h"}, "explanation": "School zones mandate a reduced speed limit of 25-30 km/h to safeguard children."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 85, "chapter": null, "