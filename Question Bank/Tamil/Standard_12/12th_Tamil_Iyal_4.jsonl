{"id": "12th_tamil_u4_q698", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pathukaapaai_oru_payanam", "chapter_id": null, "topic_id": "right_of_way_emergency", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆம்புலன்ஸ் (108) மற்றும் தீயணைப்பு வாகனங்கள் வரும்போது பிற வாகன ஓட்டுநர்களின் முதன்மைக் கடமை யாது?", "media_id": null}], "options": {"A": "அவற்றுக்கு முன்னால் வேகமாக ஓட்ட வேண்டும்", "B": "வாகனத்தைச் சாலையின் இடப்பக்கமாக ஒதுக்கி அவற்றுக்கு உடனடியாக வழிவிட வேண்டும்", "C": "அவற்றைப் பின்தொடர்ந்து செல்ல வேண்டும்", "D": "அதிவேகமாக முந்திச் செல்ல முயல வேண்டும்"}, "explanation": "அவசர ஊர்திகள் (ஆம்புலன்ஸ், தீயணைப்பு வாகனம்) வரும்போது மற்ற அனைத்து வாகனங்களும் தத்தம் வாகனத்தை இடப்புறமாக ஒதுக்கி வழிவிட்டு நிற்க வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "What is the statutory obligation of motorists when emergency vehicles (Ambulance 108, Fire Engines) approach with sirens?", "media_id": null}], "options": {"A": "Race ahead of them rapidly", "B": "Steer leftwards to clear the lane and provide immediate right-of-way", "C": "Tailgate tightly behind them", "D": "Overtake them aggressively"}, "explanation": "Motorists are legally required to draw immediately to the left side and stop, yielding unhindered passage."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book"