{"id": "12th_tamil_u4_q725", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "paa_iyatra_pazhagalam", "chapter_id": null, "topic_id": "nilaimandila_asiriyappaa", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எல்லா அடிகளும் நான்கு சீர்களைப் பெற்று சமமாக அளவடியாய் வருவது எந்த வகை ஆசிரியப்பாவாகும்?", "media_id": null}], "options": {"A": "நிலைமண்டில ஆசிரியப்பா", "B": "இணைக்குறள் ஆசிரியப்பா", "C": "நேரிசை ஆசிரியப்பா", "D": "அடிமறி மண்டில ஆசிரியப்பா"}, "explanation": "பாடலின் எல்லா அடிகளும் நான்கு சீர்களைக் கொண்டு சமமாக அளவடியாய் வருவது நிலைமண்டில ஆசிரியப்பா எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Which type of Asiriyappa poem maintains exactly four feet (Alavadi) uniformly across every single line?", "media_id": null}], "options": {"A": "Nilaimandila Asiriyappa", "B": "Inaikural Asiriyappa", "C": "Nerisai Asiriyappa", "D": "Adimarimandila Asiriyappa"}, "explanation": "Nilaimandila Asiriyappa features all lines of uniform equal length of four feet each."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 90, "chapter": null, "section": null, "reference": "12th Tamil, Unit 4,