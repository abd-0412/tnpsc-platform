{"id": "12th_tamil_u4_q612", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "manuscript_preservation_oil", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஓலைகள் முறிந்து போகாமல் நெகிழ்வோடு இருக்க எதனைத் தடவிப் பாதுகாத்தனர்?", "media_id": null}], "options": {"A": "நீர் மட்டும்", "B": "பால்", "C": "தேன்", "D": "வேப்பெண்ணெய், நல்லெண்ணெய் அல்லது வாசனைத் தைலங்கள்"}, "explanation": "பனையோலைகள் காய்ந்து உடையாமல் நெகிழ்வாக இருப்பதற்காக அவ்வப்போது நல்லெண்ணெய், வேப்பெண்ணெய் தடவிப் பாதுகாத்தனர்."}, "en": {"blocks": [{"type": "text", "content": "With what herbal oils were dry palm leaves treated to preserve flexibility and prevent brittleness?", "media_id": null}], "options": {"A": "Water only", "B": "Milk", "C": "Honey", "D": "Neem oil, sesame oil, and fragrant herbal balsams"}, "explanation": "Manuscripts were regularly seasoned with sesame or neem oil to keep the fibers supple."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 73, "chapter": null, "section": null, "reference": "12th Tamil, Unit 4, Page 73", "url": null, "sou