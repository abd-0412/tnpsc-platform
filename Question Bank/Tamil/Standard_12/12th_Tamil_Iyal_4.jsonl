{"id": "12th_tamil_u4_q715", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "paa_iyatra_pazhagalam", "chapter_id": null, "topic_id": "kural_venpaa_lines", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரண்டு அடிகளால் அமைந்த வெண்பா எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "நேரிசை வெண்பா", "B": "இன்னிசை வெண்பா", "C": "குறள் வெண்பா", "D": "பஃறொடை வெண்பா"}, "explanation": "முதல் அடி நான்கு சீராகவும், இரண்டாம் அடி மூன்று சீராகவும் கொண்டு இரண்டு அடிகளில் அமைவது குறள் வெண்பா (திருக்குறள்) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is a two-line Venpa composition canonically termed?", "media_id": null}], "options": {"A": "Nerisaivenpa", "B": "Innisaivenpa", "C": "Kuralvenpa", "D": "Pakrodai Venpa"}, "explanation": "A two-line Venpa consisting of seven feet across two lines is designated a Kuralvenpa (e.g., Thirukkural)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 89, "chapter": null, "section": null, "reference": "12th Tamil, Unit 4, Page 89", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam