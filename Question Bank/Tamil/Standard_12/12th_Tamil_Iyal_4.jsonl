{"id": "12th_tamil_u4_q591", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "uve_sa_guru", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உ.வே. சாமிநாதையரின் தமிழாசிரியராக விளங்கிய பெரும் புலவர் யார்?", "media_id": null}], "options": {"A": "மகாவித்துவான் சபாபதி முதலியார்", "B": "மறைமலையடிகள்", "C": "மகாவித்துவான் மீனாட்சிசுந்தரம் பிள்ளை", "D": "சுவாமி வேதாசலம்"}, "explanation": "உ.வே.சா அவர்கள் திருச்சிராப்பள்ளி மகாவித்துவான் மீனாட்சிசுந்தரம் பிள்ளையிடம் பல ஆண்டுகள் தங்கித் தமிழ் பயின்றார்."}, "en": {"blocks": [{"type": "text", "content": "Who was the illustrious scholar-guru who instructed U. V. Swaminatha Iyer in classical Tamil literature?", "media_id": null}], "options": {"A": "Sabapathi Mudaliar", "B": "Maraimalai Adigal", "C": "Mahavidwan Meenakshisundaram Pillai", "D": "Swami Vedhachalam"}, "explanation": "Mahavidwan Meenakshisundaram Pillai was the guru of U. V. Swaminatha Iyer."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 70, "chapter": null, "section": null, "reference": "12th Tamil, Unit 4, Page 70",