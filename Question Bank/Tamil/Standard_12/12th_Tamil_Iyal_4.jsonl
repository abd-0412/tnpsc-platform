{"id": "12th_tamil_u4_q610", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "gurukula_discipline", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைய பள்ளிக்கூடங்களில் ஆசிரியருக்கும் மாணவருக்கும் இடையே நிலவிய உறவு எத்தகையது?", "media_id": null}], "options": {"A": "வணிக ரீதியானது", "B": "தந்தையும் மகனும் போன்ற ஆன்மீக மற்றும் ஒழுக்க நெறி சார்ந்த தூய பக்தி உறவு", "C": "அதிகாரி மற்றும் ஊழியர் போன்றது", "D": "அரசியல் சார்ந்தது"}, "explanation": "ஆசிரியரைத் தந்தையாகவும் இறைவனாகவும் மதித்துக் கீழ்ப்படிதலோடு கல்வி கற்ற உன்னத உறவே குரு-சீட மரபாகும்."}, "en": {"blocks": [{"type": "text", "content": "What was the sacred nature of the bond binding preceptor and pupil in ancient indigenous academies?", "media_id": null}], "options": {"A": "Pure commercial contractualism", "B": "Sacred paternal affection, deep reverence, and lifelong moral mentorship", "C": "Bureaucratic master-servant dynamic", "D": "Partisan politics"}, "explanation": "The teacher-disciple relationship was rooted in paternal guidance and mutual moral reverence."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12",