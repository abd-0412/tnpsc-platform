{"id": "12th_tamil_u4_q597", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "sand_writing_pedagogy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைய காலப் பள்ளிகளில் சிறுவர்கள் எழுத்துக்களைக் கற்க முதன்முதலில் எதில் எழுதிப் பழகினர்?", "media_id": null}], "options": {"A": "தரையில் பரப்பப்பட்ட மணலில் விரலால் எழுதிப் பழகினர்", "B": "வெள்ளைத்தாளில் பேனாவால்", "C": "கரும்பலகையில் சுண்ணக்கட்டியால்", "D": "கணினியில் விசைப்பலகை மூலம்"}, "explanation": "தொடக்கத்தில் தரையில் மணலைப் பரப்பி, ஆசிரியர் கையோடு கை பிடித்து விரலால் மணலில் எழுத்துக்களை எழுதிக் கற்பித்தனர்."}, "en": {"blocks": [{"type": "text", "content": "How did young pupils in ancient Tamil academies initially practice writing alphabetic characters?", "media_id": null}], "options": {"A": "Tracing letters with fingers on fine river sand spread across the classroom floor", "B": "With pens on white parchment paper", "C": "With chalk sticks on blackboards", "D": "On computer keyboards"}, "explanation": "Pupils traced letters with their index fingers on sand beds spread across the floor."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpora