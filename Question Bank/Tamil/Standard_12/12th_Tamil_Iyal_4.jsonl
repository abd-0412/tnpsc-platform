{"id": "12th_tamil_u4_q766", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "u4_pyq_integration", "chapter_id": null, "topic_id": "road_sign_overtaking_prohibited", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிவப்பு நிற வட்டத்திற்குள் இரண்டு கார்கள் அருகருகே வரையப்பட்டு, ஒன்று கருப்பாகவும் மற்றொன்று சிவப்பாகவும் காட்டப்பட்டிருக்கும் குறியீட்டின் பொருள் என்ன?", "media_id": null}], "options": {"A": "இருவழிப் பாதை", "B": "முந்திச் செல்லத் தடை (No Overtaking)", "C": "வாகனப் பந்தயம்", "D": "கார்கள் மட்டும் செல்லலாம்"}, "explanation": "வட்ட வடிவ உத்தரவுக் குறியீட்டில் இரண்டு கார்கள் காட்டப்பட்டு ஒன்று சிவப்பாக அமைக்கப்பட்டிருந்தால் அது 'முந்திச் செல்லக் கூடாது' (Overtaking Prohibited) என்பதைக் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "What traffic regulation is conveyed by a circular mandatory sign displaying two cars side by side with one rendered in red?", "media_id": null}], "options": {"A": "Two-way traffic flow", "B": "Overtaking Prohibited (No Overtaking)", "C": "Motor car racing track", "D": "Exclusive car zone"}, "explanation": "The circular regulatory sign with a red vehicle silhouette signifies 'Overtaking Prohibited'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textb