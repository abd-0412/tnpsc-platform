{"id": "12th_tamil_u4_q761", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "u4_pyq_integration", "chapter_id": null, "topic_id": "c_mani_ezhuthu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘எழுத்து’ இதழில் கவிதைகள் எழுதி புதுக்கவிதை இயக்கத்தில் பெரும்பங்கு ஆற்றிய சி. மணியின் இயற்பெயர் என்ன?", "media_id": null}], "options": {"A": "சி. பழனிச்சாமி", "B": "சி. மாணிக்கம்", "C": "சி. சுப்பிரமணியன்", "D": "சி. நடராசன்"}, "explanation": "புதுக்கவிஞர் சி. மணி அவர்களின் இயற்பெயர் சி. பழனிச்சாமி என்பதாகும். இவர் பழனிசிவம் என்னும் புனைப்பெயரிலும் எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "What was the original given birth name of modernist poet C. Mani who gained fame writing in 'Ezhuthu' magazine?", "media_id": null}], "options": {"A": "C. Palanisamy", "B": "C. Manickam", "C": "C. Subramanian", "D": "C. Natarajan"}, "explanation": "C. Mani's original name was C. Palanisamy; he also wrote poetry under the pseudonym Palanisivam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 82, "chapter": null, "section": null, "reference": "12th Tamil, Unit 4, Page 82", "url": null, "