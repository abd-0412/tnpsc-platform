{"id": "12th_tamil_u4_q589", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "author_uve_sa", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பண்டைய காலத்துப் பள்ளிக்கூடங்கள்’ என்னும் கட்டுரையை எழுதிய ‘தமிழ்த்தாத்தா’ எனப் போற்றப்படும் அறிஞர் யார்?", "media_id": null}], "options": {"A": "உ.வே. சாமிநாதையர்", "B": "மயிலை சீனி. வேங்கடசாமி", "C": "பரிதிமாற்கலைஞர்", "D": "மறைமலையடிகள்"}, "explanation": "பண்டைய காலத் தமிழகக் கல்வி முறையை விரிவாக ஆய்ந்து ‘பண்டைய காலத்துப் பள்ளிக்கூடங்கள்’ கட்டுரையை எழுதியவர் உ.வே.சா ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the informative historical essay 'Pandaiya Kaalathu Pallikkoodangal'?", "media_id": null}], "options": {"A": "U. V. Swaminatha Iyer (Thamizhtthaatha)", "B": "Mayilai Seeni. Venkatasamy", "C": "Parithimaar Kalaignar", "D": "Maraimalai Adigal"}, "explanation": "U. V. Swaminatha Iyer authored the historical essay 'Pandaiya Kaalathu Pallikkoodangal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 70, "chapter": null, "section": null, "reference": "1