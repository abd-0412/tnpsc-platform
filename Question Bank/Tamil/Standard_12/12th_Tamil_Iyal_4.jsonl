{"id": "12th_tamil_u4_q646", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "idaiyeedu_purananuru", "chapter_id": null, "topic_id": "ci_mani_real_name", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் சி. மணியின் இயற்பெயர் யாது?", "media_id": null}], "options": {"A": "மாணிக்கம்", "B": "சி. பழனிச்சாமி", "C": "செல்வராஜ்", "D": "சுப்பிரமணியன்"}, "explanation": "சி. மணி என்ற புனைப்பெயரில் எழுதிய கவிஞரின் இயற்பெயர் சி. பழனிச்சாமி என்பதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What was the original given name of modernist poet Ci. Mani?", "media_id": null}], "options": {"A": "Manickam", "B": "Ci. Palanisamy", "C": "Selvaraj", "D": "Subramaniyan"}, "explanation": "Ci. Mani's original birth name is Ci. Palanisamy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 78, "chapter": null, "section": null, "reference": "12th Tamil, Unit 4, Page 78", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 4",