{"id": "12th_tamil_u4_q691", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pathukaapaai_oru_payanam", "chapter_id": null, "topic_id": "overtaking_rule", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியச் சாலை விதிகளின்படி, முன்னால் செல்லும் வாகனத்தை எந்தப் பக்கமாக மட்டுமே முந்திச் செல்ல (Overtake) வேண்டும்?", "media_id": null}], "options": {"A": "இடது புறமாக மட்டும்", "B": "எந்தப் புறமும் முந்தலாம்", "C": "வலது புறமாக மட்டும்", "D": "நடைபாதை வழியாக"}, "explanation": "இந்தியாவில் இடப்பக்கப் போக்குவரத்து நடைமுறையில் உள்ளதால், முன்னால் செல்லும் வாகனத்தை வலப்பக்கமாக மட்டுமே முந்திச் செல்ல வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "Under Indian road traffic conventions, from which side alone should a motorist overtake a vehicle moving ahead?", "media_id": null}], "options": {"A": "Only from the left side", "B": "From either side indiscriminately", "C": "Only from the right side", "D": "Along the pedestrian verge"}, "explanation": "In left-hand drive road conventions, overtaking must strictly be performed from the right side."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025"