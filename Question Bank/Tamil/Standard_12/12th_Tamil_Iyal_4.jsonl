{"id": "12th_tamil_u4_q757", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "u4_pyq_integration", "chapter_id": null, "topic_id": "u_ve_sa_birth_details", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தமிழ்த்தாத்தா’ உ.வே. சாமிநாதையரின் பெற்றோர் அவருக்கு இட்ட இயற்பெயர் யாது?", "media_id": null}], "options": {"A": "வேங்கடரமணன்", "B": "சாமிநாதன்", "C": "மீனாட்சிசுந்தரம்", "D": "சுப்பையர்"}, "explanation": "உ.வே. சாமிநாதையரின் இயற்பெயர் வேங்கடரமணன். இவருடைய ஆசிரியர் மீனாட்சிசுந்தரம் பிள்ளை இவரைச் ‘சாமிநாதன்’ என்று அழைத்தார்."}, "en": {"blocks": [{"type": "text", "content": "What was the original given birth name of 'Tamizh Thaathaa' U.V. Swaminatha Iyer bestowed by his parents?", "media_id": null}], "options": {"A": "Venkat Ramanan", "B": "Swaminathan", "C": "Meenakshisundaram", "D": "Subbaiyar"}, "explanation": "U.V.S.'s parents named him Venkat Ramanan; his revered guru Maha Vidwan Meenakshisundaram Pillai renamed him Swaminathan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 78, "chapter": null, "section": null, "reference": "12th Tamil, Unit 4, Page 78", "url": null, "source_no