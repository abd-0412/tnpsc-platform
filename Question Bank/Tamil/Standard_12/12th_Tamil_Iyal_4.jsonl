{"id": "12th_tamil_u4_q711", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "paa_iyatra_pazhagalam", "chapter_id": null, "topic_id": "venpaa_ending_vaaypaadu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெண்பாவின் ஈற்றுச் சீர் (இறுதிச் சீர்) கீழ்க்கண்ட எந்த வாய்ப்பாடுகளில் ஒன்றைக் கொண்டு முடிவடைய வேண்டும்?", "media_id": null}], "options": {"A": "தேமா, புளிமா, கூவிளம், கருவிளம்", "B": "கூவிளங்காய், தேமாங்கனி, மலர், காசு", "C": "நாள், மலர், காசு, பிறப்பு", "D": "அகவல், செப்பல், துள்ளல், தூங்கல்"}, "explanation": "வெண்பாவின் இறுதிச் சீர் ஓரசைச் சீர்களான 'நாள்', 'மலர்' அல்லது ஈரசைச் சீர்களான 'காசு', 'பிறப்பு' ஆகிய நான்கு வாய்ப்பாடுகளில் ஒன்றைக் கொண்டு மட்டுமே முடியும்."}, "en": {"blocks": [{"type": "text", "content": "With which terminal mnemonic patterns (Vaaypaadu) must the final foot of any Venpa poem conclude?", "media_id": null}], "options": {"A": "Themaa, Pulimaa, Koovilam, Karuvilam", "B": "Koovilankaai, Themaankani, Malar, Kaasu", "C": "Naal, Malar, Kaasu, Pirappu", "D": "Agaval, Seppal, Thullal, Thoongal"}, "explanation": "The final foot of a Venpa must terminate in one of four patterns: Naal (Ner), Malar (Nirai), Kaasu (Nerpu), or Pirappu (Niraipu)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 89, "chapter": null, "section": null, "reference": "12th Tamil, Unit 4, Page 89", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 4", "Grammar", "Venpa Ending"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u4_q712", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "paa_iyatra_pazhagalam", "chapter_id": null, "topic_id": "nerpu_vaaypaadu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெண்பாவின் ஈற்றுச் சீரில் 'நேர்பு' என்னும் அசை அமைப்பிற்குரிய வாய்பாடு எது?", "media_id": null}], "options": {"A": "நாள்", "B": "மலர்", "C": "பிறப்பு", "D": "காசு"}, "explanation": "நேர் = நாள்; நிரை = மலர்; நேர்பு = காசு; நிரைபு = பிறப்பு ஆகும். எனவே நேர்பு என்பது 'காசு' என்னும் வாய்பாட்டைக் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "Which terminal mnemonic label corresponds to the 'Nerpu' metrical syllable structure in Venpa?", "media_id": null}], "options": {"A": "Naal", "B": "Malar", "C": "Pirappu", "D": "Kaasu"}, "explanation": "Ner corresponds to Naal; Nirai to Malar; Nerpu to Kaasu; and Niraipu to Pirappu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 89, "chapter": null, "section": null, "reference": "12th Tamil, Unit 4, Page 89", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "pape