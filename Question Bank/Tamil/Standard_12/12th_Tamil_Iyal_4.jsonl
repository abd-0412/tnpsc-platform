{"id": "12th_tamil_u4_q607", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "mahamahopadhyaya_title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உ.வே.சா அவர்களுக்கு 1906-ஆம் ஆண்டு நடுவண் அரசு (பிரிட்டிஷ் அரசு) வழங்கிய உயரிய விருது எது?", "media_id": null}], "options": {"A": "பாரத ரத்னா", "B": "பத்மபூஷண்", "C": "மகா மகோபாத்தியாய (Mahamahopadhyaya)", "D": "சர் பட்டம்"}, "explanation": "1906-ஆம் ஆண்டு உ.வே.சாவிற்கு ‘மகா மகோபாத்தியாய’ (பேராசிரியர் திலகம்) என்னும் அரிய விருது வழங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which exalted title was conferred on U. V. Swaminatha Iyer in 1906 in recognition of his scholarship?", "media_id": null}], "options": {"A": "Bharat Ratna", "B": "Padma Bhushan", "C": "Mahamahopadhyaya", "D": "Knighthood"}, "explanation": "U. V. Sa was decorated with the title 'Mahamahopadhyaya' in 1906."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 70, "chapter": null, "section": null, "reference": "12th Tamil, Unit 4, Page 70", "url": null, "source_notes": null}, "previous_year":