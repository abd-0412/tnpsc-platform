{"id": "12th_tamil_u4_q605", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "uve_sa_library_chennai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உ.வே.சா அவர்களின் நினைவாகச் சென்னையில் அமைந்துள்ள நூல் நிலையம் எது?", "media_id": null}], "options": {"A": "உ.வே.சா நூல்நிலையம், பெசன்ட் நகர்", "B": "கன்னிமாரா பொது நூலகம்", "C": "அண்ணா நூற்றாண்டு நூலகம்", "D": "மறைமலையடிகள் நூலகம்"}, "explanation": "உ.வே.சா அவர்களின் அரிய சுவடிகள் மற்றும் புத்தகங்களைப் பாதுகாக்கச் சென்னை பெசன்ட் நகரில் ‘உ.வே.சா நூல்நிலையம்’ அமைக்கப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Which library in Chennai preserves the invaluable manuscript archives and personal collections of U. V. Swaminatha Iyer?", "media_id": null}], "options": {"A": "U. V. Swaminatha Iyer Library, Besant Nagar", "B": "Connemara Public Library", "C": "Anna Centenary Library", "D": "Maraimalai Adigal Library"}, "explanation": "The U. V. Swaminatha Iyer Library is located at Besant Nagar, Chennai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 70, "cha