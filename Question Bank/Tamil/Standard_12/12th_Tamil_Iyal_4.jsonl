{"id": "12th_tamil_u4_q764", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "u4_pyq_integration", "chapter_id": null, "topic_id": "suratha_award_thenmazhai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுரதாவின் எந்தக் கவிதை நூல் தமிழக அரசின் முதல் பரிசைப் பெற்றது?", "media_id": null}], "options": {"A": "துறைமுகம்", "B": "சுவரும் சுண்ணாம்பும்", "C": "அமுதும் தேனும்", "D": "தேன்மழை"}, "explanation": "சுரதா இயற்றிய ‘தேன்மழை’ என்னும் கவிதைத் தொகுப்பு தமிழக அரசின் முதற்பரிசைப் பெற்ற பெருமைக்குரியது."}, "en": {"blocks": [{"type": "text", "content": "Which anthologized poetic masterwork of Suradha was awarded the Tamil Nadu State Government's prestigious First Prize?", "media_id": null}], "options": {"A": "Thuraimugam", "B": "Suvarum Sunnaambum", "C": "Amuthum Thaenum", "D": "Thaenmazhai"}, "explanation": "Suradha's collection 'Thaenmazhai' won the prestigious First Prize from the Tamil Nadu State Government."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 80, "chapter": null, "section": null, "reference": "12th Tamil, Unit 4, Page 80", "url": null, "source_notes": null}, "previous_year":