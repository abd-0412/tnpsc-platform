{"id": "12th_tamil_u4_q765", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "u4_pyq_integration", "chapter_id": null, "topic_id": "venpaa_thodai_seer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெண்பாவில் பயின்று வரும் அடிகளின் எண்ணிக்கைக்கு ஏற்ப வகைப்படுத்தப்படும் போது, 'குறள் வெண்பா' எத்தனை அடிகளைக் கொண்டிருக்கும்?", "media_id": null}], "options": {"A": "இரண்டு அடிகள்", "B": "மூன்று அடிகள்", "C": "நான்கு அடிகள்", "D": "ஐந்து அடிகள்"}, "explanation": "குறள் வெண்பா இரண்டு அடிகளைக் கொண்டது. முதல் அடி நான்கு சீராகவும், இரண்டாம் அடி மூன்று சீராகவும் (மொத்தம் 7 சீர்கள்) அமையும்."}, "en": {"blocks": [{"type": "text", "content": "When classifying Venpa meters based on line length, how many metric lines form a 'Kural Venpa'?", "media_id": null}], "options": {"A": "Two lines", "B": "Three lines", "C": "Four lines", "D": "Five lines"}, "explanation": "A Kural Venpa strictly consists of two lines comprising seven metrical feet (4 + 3)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 89, "chapter": null, "section": null, "reference": "12th Tamil, Unit 4, Page 89", "url": null, "source_no