{"id": "12th_tamil_u4_q763", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "u4_pyq_integration", "chapter_id": null, "topic_id": "u_ve_sa_maiyadal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைய திண்ணைப் பள்ளிகளில் ஏட்டுச் சுவடிகளைப் படிப்பதற்காகச் சுவடிகளில் தடவப்பட்ட திரவக் கலவை எது?", "media_id": null}], "options": {"A": "சந்தனக் கலவை", "B": "குங்குமப் பொடி", "C": "வசம்பு, மாவிலைக்கரி மற்றும் செம்பருத்தி இலைச்சாறு சேர்ந்த மை (மையாடல்)", "D": "எண்ணெய் மற்றும் விளக்குக்கரி"}, "explanation": "ஏட்டுச் சுவடியின் எழுத்துகள் தெளிவாகத் தெரிவதற்காகவும் கண்ணுக்குக் குளிர்ச்சி தருவதற்காகவும் வசம்பு, மாவிலைக்கரி, செம்பருத்தி இலைச்சாறு சேர்த்த மையைத் தடவுவர். இது 'மையாடல்' எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What botanical herbal concoction was smeared across palm-leaf manuscripts to enhance legibility in ancient indigenous schools?", "media_id": null}], "options": {"A": "Sandalwood paste", "B": "Vermilion powder", "C": "Herbal ink formulation of sweet flag (Vasambu), mango leaf charcoal, and hibiscus extract (Maiyaadal)", "D": "Castor oil and lamp soot"}, "explanation": "Palm-leaf manuscripts were anointed with a medicinal soot blend (Maiyaadal) to protect eyes and clarify script."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_nam