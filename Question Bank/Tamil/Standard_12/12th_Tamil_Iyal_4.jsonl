{"id": "12th_tamil_u4_q606", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "uve_sa_honorary_doctorate", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உ.வே.சா அவர்களுக்கு ‘டாக்டர்’ (Doctor of Literature) பட்டமளித்துப் பெருமைப்படுத்திய பல்கலைக்கழகம் எது?", "media_id": null}], "options": {"A": "அண்ணாமலைப் பல்கலைக்கழகம்", "B": "சென்னைப் பல்கலைக்கழகம் (1932)", "C": "மதுரை காமராசர் பல்கலைக்கழகம்", "D": "பாரதியார் பல்கலைக்கழகம்"}, "explanation": "சென்னைப் பல்கலைக்கழகம் 1932-ஆம் ஆண்டு உ.வே.சா அவர்களின் தமிழ்ப் பணியைப் போற்றி ‘டி.லிட்’ (D.Litt) டாக்டர் பட்டம் வழங்கியது."}, "en": {"blocks": [{"type": "text", "content": "Which prestigious university conferred the honorary Doctorate of Literature (D.Litt) upon U. V. Swaminatha Iyer in 1932?", "media_id": null}], "options": {"A": "Annamalai University", "B": "Madras University (1932)", "C": "Madurai Kamaraj University", "D": "Bharathiar University"}, "explanation": "Madras University conferred an honorary D.Litt on U. V. Swaminatha Iyer in 1932."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2