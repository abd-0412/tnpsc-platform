{"id": "12th_tamil_u4_q596", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "sattam_pillai_monitor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திண்ணைப் பள்ளிக்கூடங்களில் ஆசிரியருக்கு உதவியாக வகுப்பைக் கவனித்துக் கொள்ளும் மூத்த மாணவன் எவ்வாறு அழைக்கப்பட்டான்?", "media_id": null}], "options": {"A": "வகுப்புத் தலைவர்", "B": "மாணவர் தலைவர்", "C": "சீடன்", "D": "சட்டம் பிள்ளை"}, "explanation": "ஆசிரியருக்குத் துணையாகச் சிறுவர்களுக்குப் பாடம் சொல்லிக் கொடுத்து வகுப்பைக் கண்காணிக்கும் மாணவன் ‘சட்டம் பிள்ளை’ எனப்பட்டான்."}, "en": {"blocks": [{"type": "text", "content": "What was the senior student monitor who assisted the preceptor in maintaining class discipline and teaching juniors called?", "media_id": null}], "options": {"A": "Class representative", "B": "School prefect", "C": "Novice disciple", "D": "Sattam Pillai (Student Monitor)"}, "explanation": "The senior student monitor assisting the master was designated as Sattam Pillai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 71, "chapter": null, "section": nul