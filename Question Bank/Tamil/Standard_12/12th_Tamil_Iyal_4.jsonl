{"id": "12th_tamil_u4_q624", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "idhil_vetri_pera", "chapter_id": null, "topic_id": "poetic_theme_rhyme_craft", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘இதில் வெற்றி பெற’ கவிதையின் மையக்கரு எதனை அறிவுறுத்துகிறது?", "media_id": null}], "options": {"A": "போரில் வெல்லும் தந்திரங்கள்", "B": "வியாபாரத் திறன்கள்", "C": "அரசியல் மேடைப் பேச்சு", "D": "மரபுக் கவிதையின் எதுகை, மோனை, சந்தக் கட்டமைப்பு மற்றும் உவமைகளைச் சரியாகக் கையாண்டு கவிதை படைப்பதன் வெற்றி நெறிகள்"}, "explanation": "இலக்கண மரபுகளைக் கற்று, உவமைகளை அழகுற அமைத்துத் தளராது முயன்றால் மட்டுமே கவிதை உலகில் வெற்றி பெற முடியும் என்பதைச் சுரதா விளக்குகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the central aesthetic message of the poem 'Idhil Vetri Pera'?", "media_id": null}], "options": {"A": "Maneuvers to win armed combat", "B": "Tactics for commercial enterprise", "C": "Political platform rhetoric", "D": "Principles of poetic craftsmanship, metric cadence, alliteration, and imaginative similes required to achieve triumph in literature"}, "explanation": "Suradha lays down the disciplined poetic rules, metric cadence, and simile craft essential to mastering classical Tamil poetry."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "bo