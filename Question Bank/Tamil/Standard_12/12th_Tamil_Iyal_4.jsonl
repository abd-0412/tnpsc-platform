{"id": "12th_tamil_u4_q602", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "memory_lexicon_nikandu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சொற்பொருள்களையும் அருஞ்சொற்களையும் மனனம் செய்து நினைவில் நிறுத்த மாணவர்கள் பயின்ற நூல்கள் எவை?", "media_id": null}], "options": {"A": "அகராதிகள்", "B": "நிகண்டுகள் (திவாகர நிகண்டு, பிங்கல நிகண்டு)", "C": "காப்பியங்கள்", "D": "புராணங்கள்"}, "explanation": "அக்காலத்தில் சொல்வளம் பெருக ‘திவாகரம்’, ‘பிங்கலந்தை’ போன்ற நிகண்டுச் செய்யுள்களை மாணவர்கள் மனனம் செய்தனர்."}, "en": {"blocks": [{"type": "text", "content": "Which rhymed versified thesauruses were memorized by students to master expansive vocabulary and polysemous meanings?", "media_id": null}], "options": {"A": "Modern dictionaries", "B": "Nikandu treatises (such as Thivaakara Nikandu and Pingala Nikandu)", "C": "Epics", "D": "Puranas"}, "explanation": "Students committed classical verse lexicons like Thivaagaram and Pingalandhai to memory."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 73, "chapter": null, "sectio