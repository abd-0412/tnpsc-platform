{"id": "12th_tamil_u4_q762", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "u4_pyq_integration", "chapter_id": null, "topic_id": "suratha_magazines", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுரதா நடத்திய கவிதை இதழ்களில் அடங்காத ஒன்றைத் தேர்வு செய்க:", "media_id": null}], "options": {"A": "காவியம்", "B": "மணிக்கொடி", "C": "இலக்கியம்", "D": "விண்மீன்"}, "explanation": "சுரதா காவியம், இலக்கியம், ஊர்வலம், விண்மீன், சுரதா ஆகிய இதழ்களை நடத்தினார். ‘மணிக்கொடி’ இதழை நடத்தியவர் கே. சீனிவாசன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Select the literary periodical that was NOT edited or founded by poet Suradha:", "media_id": null}], "options": {"A": "Kaaviyam", "B": "Manikkodi", "C": "Ilakkiyam", "D": "Vinmeen"}, "explanation": "Suradha published Kaaviyam, Ilakkiyam, Oorvalam, Vinmeen, and Suradha. Manikkodi was founded by K. Srinivasan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 80, "chapter": null, "section": null, "reference": "12th Tamil, Unit 4, Page 80", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC", "exam_name":