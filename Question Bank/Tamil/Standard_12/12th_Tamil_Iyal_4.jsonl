{"id": "12th_tamil_u4_q600", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "basic_textbooks_studied", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திண்ணைப் பள்ளிக்கூடங்களில் தொடக்கக் கல்வியில் கற்பிக்கப்பட்ட முதன்மை நீதி நூல்கள் எவை?", "media_id": null}], "options": {"A": "நாவல்கள்", "B": "வரலாற்றுப் புத்தகங்கள்", "C": "நாடகங்கள்", "D": "ஆத்திசூடி, கொன்றைவேந்தன், வெற்றிவேற்கை, மூதுரை, நல்வழி, உலகநீதி"}, "explanation": "சிறுவர்களுக்கு ஒழுக்கமும் மொழியறிவும் புகட்ட ஔவையார் இயற்றிய ஆத்திசூடி, கொன்றைவேந்தன், மூதுரை, நல்வழி முதலிய நீதிநூல்கள் கற்பிக்கப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "Which fundamental ethical and didactic primers were mastered by pupils in primary portico academies?", "media_id": null}], "options": {"A": "Modern novels", "B": "Dynastic history texts", "C": "Plays", "D": "Aathisoodi, Kondraivendhan, Vetrivegai, Moodhurai, Nalvazhi, and Ulaganeedhi"}, "explanation": "Ethical verse primers by Avvaiyar and other poets formed the basic curriculum."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024