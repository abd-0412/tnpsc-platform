{"id": "12th_tamil_u4_q601", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "memory_tables_en_suvadi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைய பள்ளிகளில் கணித வாய்பாடுகளையும் கணக்கீடுகளையும் மனனம் செய்யப் பயன்பட்ட நூல் எது?", "media_id": null}], "options": {"A": "எண்சுவடி (நெல் இலக்கம், குழி மாற்று முதலிய வாய்பாடுகள்)", "B": "நிகண்டு", "C": "திவாகரம்", "D": "நன்னூல்"}, "explanation": "கணிதம் கற்க ‘எண்சுவடி’ பயன்பட்டது; இதில் நெல்லிலக்கம், கீழ்வாயிலக்கம், குழிமாற்று போன்ற வாய்பாடுகள் அடங்கியிருந்தன."}, "en": {"blocks": [{"type": "text", "content": "Which mathematical palm-leaf ledger was memorized by students for mental arithmetic, land surveying, and commercial transactions?", "media_id": null}], "options": {"A": "En-suvadi (fractional tables, area surveying multipliers, grain metrics)", "B": "Nikandu", "C": "Thivaagaram", "D": "Nannool"}, "explanation": "'En-suvadi' contained oral tables for fractions, land measures, and grain counts."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 73, "chapter": nu