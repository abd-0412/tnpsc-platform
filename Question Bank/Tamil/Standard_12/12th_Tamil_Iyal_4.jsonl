{"id": "12th_tamil_u4_q598", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "stylus_types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஓலைச்சுவடிகளில் எழுதுவதற்குப் பயன்படுத்தப்பட்ட ‘எழுத்தாணி’யின் வகைகள் எவை?", "media_id": null}], "options": {"A": "மை பேனா, பென்சில்", "B": "மடக்கெழுத்தாணி, குண்டெழுத்தாணி, வாரெழுத்தாணி", "C": "இரும்பு ஆணி மட்டும்", "D": "மரக் குச்சி"}, "explanation": "சுவடிகளில் எழுத மடக்கெழுத்தாணி, குண்டெழுத்தாணி, வாரெழுத்தாணி போன்ற பல்வேறு எழுத்தாணிகள் பயன்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "What varieties of iron styluses (Ezhutthaani) were deployed to incise letters onto palm-leaf manuscripts?", "media_id": null}], "options": {"A": "Fountain pens and graphite pencils", "B": "Madakku-ezhutthaani (folding stylus), Gundu-ezhutthaani, Vaar-ezhutthaani", "C": "Ordinary iron nails only", "D": "Wooden twigs"}, "explanation": "Styluses included folding styluses (Madakku), rounded-head styluses (Gundu), and trimming styluses (Vaar)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page