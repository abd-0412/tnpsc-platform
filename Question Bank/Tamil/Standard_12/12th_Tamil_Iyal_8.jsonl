{"id": "12th_tamil_u8_q1519", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "punarchi_vidhi_perunkodai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பெருங்கொடை’ - புணர்ச்சி விதியைத் தேர்ந்தெடுக்க:\n(பெருமை + கொடை = பெருங்கொடை)", "media_id": null}], "options": {"A": "உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே", "B": "தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும்", "C": "ஈறு போதல், முன்னின்ற மெய் திரிதல் (இனமெல்லெழுத்து மிகல்)", "D": "திசைப்பெயர் புணர்ச்சி"}, "explanation": "‘ஈறு போதல்’ விதிப்படி 'மை' கெட்டுப் 'பெரு + கொடை' என்றாகி, 'முன்னின்ற மெய் திரிதல்' அல்லது இனமெல்லெழுத்து மிகும் விதிப்படி 'ங்' தோன்றிப் 'பெருங்கொடை' என்றானது."}, "en": {"blocks": [{"type": "text", "content": "Identify the sandhi rules for the compound 'Perumai + Kodai = Perunkodai'.", "media_id": null}], "options": {"A": "Consonant joining vowel naturally", "B": "Gemination of consonant after short vowel", "C": "Eeru podhal (dropping of -mai suffix) followed by homorganic nasal assimilation ('ng')", "D": "Direction noun sandhi"}, "explanation": "Dropping the suffix -mai leaves 'Peru', followed by nasal insertion yielding 'பெருங்கொடை'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tami