{"id": "12th_tamil_u8_q1454", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sirubanaatruppadai", "chapter_id": null, "topic_id": "marungoorppattinam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிறுபாணாற்றுப்படையில் விவரிக்கப்படும் ஓய்மாநாட்டின் வளமிக்க கடற்கரைத் துறைமுகப் பட்டினம் எது?", "media_id": null}], "options": {"A": "பூம்புகார்", "B": "மரக்கோணம் / மருங்கூர்ப்பட்டினம்", "C": "முசிறி", "D": "கொற்கை"}, "explanation": "ஓய்மாநாட்டின் கடலோரத் துறைமுகமான மருங்கூர்ப்பட்டினத்தில் உப்பு வணிகமும் கடல் வாணிபமும் கொழித்து விளங்கியதை நத்தத்தனார் பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which bustling coastal port of Oymaanadu is graphically portrayed in Sirubanaatruppadai?", "media_id": null}], "options": {"A": "Poompuhar", "B": "Marungoorppattinam (near Marakkanam)", "C": "Musiri", "D": "Korkai"}, "explanation": "The bustling port town of Marungoorppattinam (present-day Marakkanam salt-pan area) is vividly described."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 204, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 204", "url": nul