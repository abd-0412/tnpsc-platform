{"id": "12th_tamil_u8_q1503", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kuriyeedu_grammar", "chapter_id": null, "topic_id": "kuriyeedu_merits", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிதையில் குறியீடுகளைப் பயன்படுத்துவதால் ஏற்படும் முதன்மையான கலை நயம் யாது?", "media_id": null}], "options": {"A": "கவிதையின் பொருள் அனைவருக்கும் ஒரே மாதிரியாக மட்டுமே இருக்கும்", "B": "இலக்கண விதிகளை எளிமையாக்குகிறது", "C": "கவிதைக்கு பன்முக வாசிப்புத் தளங்களையும், கற்பனை விரிவையும், சொல்ல முடியாத ஆழமான தத்துவார்த்தப் பொருளையும் தருகிறது", "D": "பக்க அளவைக் குறைப்பது மட்டுமே"}, "explanation": "குறியீடுகள் வாசகனுக்குப் புதிய சிந்தனைப் பரப்புகளையும், பல்வேறு கோணங்களில் பொருள் கொள்ளும் பன்முகத்தன்மையையும் (Multi-layered meaning) வழங்குகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What is the foremost artistic advantage of employing symbols in poetry?", "media_id": null}], "options": {"A": "Fixes a single uniform literal reading for all", "B": "Simplifies parsing grammatical rules", "C": "Endows verse with multi-layered interpretative depth, imaginative expansiveness, and evocative resonance", "D": "Merely saves print paper"}, "explanation": "Symbols introduce multi-layered ambiguity and philosophical richness, inviting polysemic readings."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "so