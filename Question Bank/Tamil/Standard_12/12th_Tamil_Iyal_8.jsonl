{"id": "12th_tamil_u8_q1406", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ratchanya_yathirigam", "chapter_id": null, "topic_id": "paruvangal_paadalkal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரட்சணிய யாத்திரிகம் எத்தனை பருவங்களையும், எத்தனை பாடல்களையும் கொண்ட பெருங்காப்பியமாகும்?", "media_id": null}], "options": {"A": "6 பருவங்கள், 4000 பாடல்கள்", "B": "5 பருவங்கள், 3,766 பாடல்கள்", "C": "7 பருவங்கள், 2,500 பாடல்கள்", "D": "4 பருவங்கள், 3,000 பாடல்கள்"}, "explanation": "இரட்சணிய யாத்திரிகம் ஆதி பருவம், குமார பருவம், நிதான பருவம், ஆரணிய பருவம், இரட்சணிய பருவம் என 5 பருவங்களையும், 3,766 விருத்தப் பாடல்களையும் கொண்டது."}, "en": {"blocks": [{"type": "text", "content": "How many cantos (Paruvangal) and verses comprise the epic Ratchanya Yaathirigam?", "media_id": null}], "options": {"A": "6 Cantos, 4,000 verses", "B": "5 Cantos, 3,766 verses", "C": "7 Cantos, 2,500 verses", "D": "4 Cantos, 3,000 verses"}, "explanation": "Ratchanya Yaathirigam consists of 5 Paruvangal and exactly 3,766 Virutham stanzas."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 200, "chapter": null, "s