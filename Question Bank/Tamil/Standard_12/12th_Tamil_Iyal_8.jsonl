{"id": "12th_tamil_u8_q1516", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "ilakkana_kurippu_kottan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஈத்த’ - இலக்கணக் குறிப்புத் தருக.", "media_id": null}], "options": {"A": "வினையெச்சம்", "B": "தொழிற்பெயர்", "C": "வியங்கோள் வினைமுற்று", "D": "இறந்தகாலப் பெயரெச்சம்"}, "explanation": "'ஈத்த பாழி' எனப் பெயரைக்கொண்டு முடிவதாலும், இறந்தகாலத்தை உணர்த்துவதாலும் 'ஈத்த' என்பது இறந்தகாலப் பெயரெச்சம் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Give the grammatical note (Ilakkana Kurippu) for the Sangam word 'Eetha'.", "media_id": null}], "options": {"A": "Adverbial participle (Vinaiyechcham)", "B": "Verbal noun (Thozhirpeyar)", "C": "Optative verb (Viyangol)", "D": "Past adjectival participle (Iranthakaala Peyarechcham)"}, "explanation": "'Eetha' functions as a past adjectival participle modifying an ensuing noun."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 205, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 205", "url": null, "source_notes": n