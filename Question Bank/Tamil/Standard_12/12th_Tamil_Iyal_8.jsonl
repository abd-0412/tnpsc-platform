{"id": "12th_tamil_u8_q1445", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sirubanaatruppadai", "chapter_id": null, "topic_id": "seeriyaazh_varnanai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிறுபாணாற்றுப்படையில் சீறியாழின் அமைப்பை நத்தத்தனார் எதற்கு உவமையாக வர்ணிக்கிறார்?", "media_id": null}], "options": {"A": "பச்சை நிறப் பாம்பின் படம் போலவும், உடும்புத் தோல் போர்த்திய வடிவம் போலவும்", "B": "யானையின் தும்பிக்கை போல", "C": "குதிரையின் முகம் போல", "D": "தாமரை மலர் போல"}, "explanation": "யாழின் பத்தர் உடும்பின் தோலால் போர்த்தப்பட்டு, செவ்வழியாகிய நரம்புகள் அமைந்த அழகிய பாம்பின் படம்போல் விளங்குவதாக வர்ணிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "How does Nathathanar visually describe the craft of the Seeriyaazh harp in Sirubanaatruppadai?", "media_id": null}], "options": {"A": "Resembling the hood of a cobra and covered with smooth monitor lizard skin", "B": "Like an elephant trunk", "C": "Like a horse head", "D": "Like a lotus flower"}, "explanation": "The wooden bowl of the lute is depicted as clasped with monitor lizard skin, fashioned gracefully like an expanded serpent hood."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporati