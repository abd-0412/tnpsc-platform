{"id": "12th_tamil_u8_q1448", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sirubanaatruppadai", "chapter_id": null, "topic_id": "seeru_pathuppaattu_comparison", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பத்துப்பாட்டில் உள்ள ஐந்து ஆற்றுப்படை நூல்களுள் மிகக் குறைந்த அடிகளைக் கொண்ட நூல் எது?", "media_id": null}], "options": {"A": "திருமுருகாற்றுப்படை (317 அடிகள்)", "B": "பொருநராற்றுப்படை (248 அடிகள்)", "C": "பெரும்பாணாற்றுப்படை (500 அடிகள்)", "D": "பொருநராற்றுப்படை (248 அடிகள்) - [சிறுபாணாற்றுப்படை 269 அடிகள்]"}, "explanation": "பத்துப்பாட்டு ஆற்றுப்படைகளில் பொருநராற்றுப்படை 248 அடிகளுடன் மிகச் சிறியது; சிறுபாணாற்றுப்படை 269 அடிகளுடன் இரண்டாவது சிறிய ஆற்றுப்படையாகும்."}, "en": {"blocks": [{"type": "text", "content": "Among the five Aatruppadai works in Pathuppaattu, what is the relative line position of Sirubanaatruppadai?", "media_id": null}], "options": {"A": "Longest work with 782 lines", "B": "Shortest work with 200 lines", "C": "Equal to Maduraikkanji", "D": "Second shortest at 269 lines (after Porunaraatruppadai's 248 lines)"}, "explanation": "At 269 lines, Sirubanaatruppadai is the second most compact Aatruppadai work after Porunaraatruppadai (248 lines)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publishe