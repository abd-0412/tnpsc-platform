{"id": "12th_tamil_u8_q1536", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "nalliyakkodan_titles", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிறுபாணாற்றுப்படையில் ஓய்மாநாட்டு நல்லியக்கோடனுக்கு நத்தத்தனார் சூட்டும் சிறப்புப் பட்டப் பெயர்களுள் பொருந்தாதது எது?", "media_id": null}], "options": {"A": "நன்மாவிலங்கைத் தலைவன்", "B": "புறவெதிர்த்தோர்க்குப் புலி", "C": "இரவலர்க்கு இனியன்", "D": "கடல் பிறக்கோட்டிய செங்குட்டுவன்"}, "explanation": "'கடல் பிறக்கோட்டிய செங்குட்டுவன்' என்பது சேரன் செங்குட்டுவனின் பட்டப் பெயராகும்; இது நல்லியக்கோடனுக்குரியதன்று."}, "en": {"blocks": [{"type": "text", "content": "Which of the following titles does NOT belong to Oymaanattu Nalliyakkodan in Sirubanaatruppadai?", "media_id": null}], "options": {"A": "Lord of Nanmaavilangkai", "B": "Tiger to retreating battlefield foes", "C": "Benevolent solace to suppliants", "D": "Kadal Pirakkottiya Senguttuvan (Cheran Senguttuvan's epithet)"}, "explanation": "'Kadal Pirakkottiya Senguttuvan' is an epithet of Chera king Senguttuvan, not Nalliyakkodan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full