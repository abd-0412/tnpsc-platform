{"id": "12th_tamil_u8_q1439", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sirubanaatruppadai", "chapter_id": null, "topic_id": "valvil_oari", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கொல்லிமலை நாடனாய், தன் நாட்டையே கூத்தர்களுக்குப் பரிசாகத் தந்த வில்லாற்றல் மிக்க வள்ளல்’ யார்?", "media_id": null}], "options": {"A": "பேகன்", "B": "ஆய்", "C": "வல்வில் ஓரி", "D": "அதியன்"}, "explanation": "கொல்லிமலையை ஆண்ட வல்வில் ஓரி, தன்னைப் பாடிவந்த கூத்தர்களுக்குத் தனது முழு நாட்டையுமே பரிசாக வாரி வழங்கிய வில்லாற்றல் மிக்க மன்னன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Which master archer and chieftain of Kolli hills gifted his entire kingdom to wandering bards and dancers?", "media_id": null}], "options": {"A": "Pegan", "B": "Aay", "C": "Valvil Oari", "D": "Athiyan"}, "explanation": "Valvil Oari, master archer ruling Kolli hills, bestowed his entire mountainous realm upon performing dancers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 204, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 204", "url": null, "source_notes": null}, "previous_ye