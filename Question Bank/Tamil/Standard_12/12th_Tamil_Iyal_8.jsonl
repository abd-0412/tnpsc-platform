{"id": "12th_tamil_u8_q1447", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sirubanaatruppadai", "chapter_id": null, "topic_id": "food_hospitality", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஓய்மாநாட்டின் வழியில் உள்ள எயிற்றியர் (பாலைநிலப் பெண்கள்) பாணர்களுக்கு அளித்த விருந்தோம்பல் உணவு எது?", "media_id": null}], "options": {"A": "பால் சோறு", "B": "தேன் மற்றும் கிழங்கு", "C": "புளிப்பு ஏறிய கூழும், கானக்கோழி வறுத்த இறைச்சியும் (ஆமான் சூடு)", "D": "நெய்யொடு கூடிய வெண்சோறு"}, "explanation": "வழியில் உள்ள மருங்கூர்ப் பட்டினத்திலும் பாலைநிலக் குடிகளிலும் பாணர்களுக்குப் புளிங்கூழும், சுட்ட இறைச்சியும் அன்போடு விருந்தாகப் பரிமாறப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "What hearty native fare did the desert maidens (Eyitriyarp) serve to the traveling minstrels?", "media_id": null}], "options": {"A": "Milk porridge", "B": "Honey and tubers", "C": "Fermented tangy gruel and roasted fowl meat", "D": "Steamed white rice with ghee"}, "explanation": "The pastoral desert women welcomed travelers with nourishing spiced gruel and roasted game."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2