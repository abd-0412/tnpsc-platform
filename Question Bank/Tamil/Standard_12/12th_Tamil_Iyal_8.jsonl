{"id": "12th_tamil_u8_q1455", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sirubanaatruppadai", "chapter_id": null, "topic_id": "pathuppaattu_compilation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிறுபாணாற்றுப்படை இடம்பெற்றுள்ள ‘பத்துப்பாட்டு’ தொகுப்பில் உள்ள ஆற்றுப்படை நூல்களின் எண்ணிக்கை எத்தனை?", "media_id": null}], "options": {"A": "இரண்டு", "B": "மூன்று", "C": "ஐந்து", "D": "எட்டு"}, "explanation": "பத்துப்பாட்டில் திருமுருகாற்றுப்படை, பொருநராற்றுப்படை, பெரும்பாணாற்றுப்படை, சிறுபாணாற்றுப்படை, கூத்தராற்றுப்படை (மலைபடுகடாம்) என 5 ஆற்றுப்படை நூல்கள் உள்ளன."}, "en": {"blocks": [{"type": "text", "content": "How many of the ten long poems comprising the Pathuppaattu anthology belong to the Aatruppadai guidebook genre?", "media_id": null}], "options": {"A": "Two", "B": "Three", "C": "Five", "D": "Eight"}, "explanation": "Exactly 5 of the 10 poems in Pathuppaattu are Aatruppadai guidebooks."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 202, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 202", "url": null, "source_notes": null}, "previous_year": {"is_p