{"id": "12th_tamil_u8_q1407", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ratchanya_yathirigam", "chapter_id": null, "topic_id": "ratchanya_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘இரட்சணிய யாத்திரிகம்’ என்பதில் ‘இரட்சணியம்’ மற்றும் ‘யாத்திரிகம்’ என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "போர்க்களம் - வீரம்", "B": "அரண்மனை - ஆட்சி", "C": "ஆன்ம மீட்பு (இரட்சிப்பு) - பயணம் (யாத்திரை)", "D": "இயற்கை - அழகு"}, "explanation": "இரட்சணியம் என்றால் ஆன்ம ஈடேற்றம் அல்லது ஆன்ம மீட்பு; யாத்திரிகம் என்றால் ஆன்மீகப் பயணம் என்று பொருள் (ஆன்ம மீட்புக்கான நெடும் பயணம்)."}, "en": {"blocks": [{"type": "text", "content": "What is the precise literal meaning of the terms 'Ratchanyam' and 'Yaathirigam'?", "media_id": null}], "options": {"A": "Battlefield - Valor", "B": "Palace - Governance", "C": "Salvation / Spiritual Redemption (Ratchanyam) - Pilgrimage / Journey (Yaathirigam)", "D": "Nature - Splendor"}, "explanation": "'Ratchanyam' means divine salvation/redemption of the soul, and 'Yaathirigam' denotes a spiritual pilgrimage."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2