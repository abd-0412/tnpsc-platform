{"id": "12th_tamil_u8_q1514", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "glossary_cultural_heritage", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘Cultural Heritage’ என்ற ஆங்கிலத் தொடரின் சரியான தமிழாக்கம் எது?", "media_id": null}], "options": {"A": "சமூக மாற்றம்", "B": "பண்பாட்டுப் பாரம்பரியம் (பண்பாட்டு மரபுவழிச் செல்வம்)", "C": "அரசியல் சட்டம்", "D": "மொழி வளர்ச்சி"}, "explanation": "'Cultural Heritage' என்பதற்குத் தமிழில் 'பண்பாட்டுப் பாரம்பரியம்' அல்லது 'கலாச்சார மரபு' என்று பொருள்."}, "en": {"blocks": [{"type": "text", "content": "What is the precise Tamil translation for the phrase 'Cultural Heritage'?", "media_id": null}], "options": {"A": "Social Change", "B": "Cultural Heritage (Panbaattup Paarambariyam)", "C": "Constitutional Law", "D": "Linguistic Evolution"}, "explanation": "'Cultural Heritage' is translated into Tamil as 'பண்பாட்டுப் பாரம்பரியம்'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 213, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 213", "url": null, "source_notes": nul