{"id": "12th_tamil_u8_q1399", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "pallar_kalavetti", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயிலை சீனி. வேங்கடசாமி கல்வெட்டுகளைப் படிப்பதற்காக எந்தெந்த மொழி எழுத்து வடிவங்களைக் கற்றுத் தேர்ந்தார்?", "media_id": null}], "options": {"A": "லத்தீன், கிரேக்கம்", "B": "இந்தி, உருது", "C": "தமிழ் பிராமி, வட்டெழுத்து மற்றும் கிரந்த எழுத்துகள்", "D": "சீனம், ஜப்பானியம்"}, "explanation": "பண்டைய கல்வெட்டுகளைத் தாமே படித்து ஆராயத் தமிழ் பிராமி, வட்டெழுத்து, கிரந்த எழுத்து ஆகிய பழங்கால வரிவடிவங்களைத் திறம்படக் கற்றார்."}, "en": {"blocks": [{"type": "text", "content": "Which paleographical scripts did Mayilai Seeni. Venkatasamy master to directly decode ancient inscriptions?", "media_id": null}], "options": {"A": "Latin and Greek", "B": "Hindi and Urdu", "C": "Tamil-Brahmi, Vatteluttu, and Grantha paleographical scripts", "D": "Chinese and Japanese"}, "explanation": "He mastered Tamil-Brahmi, Vatteluttu, and Grantha scripts to directly transcribe ancient lithic and copper records."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term":