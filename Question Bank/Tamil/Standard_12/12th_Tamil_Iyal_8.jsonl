{"id": "12th_tamil_u8_q1404", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ratchanya_yathirigam", "chapter_id": null, "topic_id": "author_krishnapillai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கிறித்தவக் கம்பர்’ என்று போற்றப்படும் தலைசிறந்த தமிழ்ப் புலவர் யார்?", "media_id": null}], "options": {"A": "வீரமாமுனிவர்", "B": "வேதநாயக சாஸ்திரியார்", "C": "மாயூரம் வேதநாயகம் பிள்ளை", "D": "எச்.ஏ. கிருஷ்ணபிள்ளை"}, "explanation": "கம்பரின் காப்பிய நயத்தை அடியொற்றி கிறித்தவக் காப்பியமான இரட்சணிய யாத்திரிகத்தைப் படைத்ததால் எச்.ஏ. கிருஷ்ணபிள்ளை 'கிறித்தவக் கம்பர்' எனப்படுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Who is celebrated with the honorific title 'Kiriththavak Kambar' (Christian Kambar)?", "media_id": null}], "options": {"A": "Veeramamunivar", "B": "Vedhanayaga Sasthiriyar", "C": "Mayuram Vedhanayagam Pillai", "D": "H.A. Krishna Pillai"}, "explanation": "H.A. Krishna Pillai is hailed as 'Christian Kambar' for composing the epic Ratchanya Yaathirigam in Kambar's sublime style."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 199, "chapter": null, "section": null, "