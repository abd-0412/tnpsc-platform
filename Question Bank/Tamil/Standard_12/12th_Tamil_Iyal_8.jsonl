{"id": "12th_tamil_u8_q1538", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "idiom_kai_kalandhal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கை கொடுத்தல்’ என்னும் மரபுத் தொடரின் பொருள் யாது?", "media_id": null}], "options": {"A": "கை குலுக்குதல் மட்டும்", "B": "ஆபத்தில் அல்லது இக்கட்டான சூழலில் தக்க சமயத்தில் உதவி செய்தல்", "C": "பணம் கடன் வாங்குதல்", "D": "பொருட்களை விற்றல்"}, "explanation": "'கை கொடுத்தல்' என்பது ஒருவர் துன்புறும் போது அவருக்கு ஆதரவாக நின்று உதவி செய்வதைக் குறிக்கும் மரபுத் தொடர் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the idiomatic meaning of the Tamil phrase 'Kai Koduththal' (Lending a hand)?", "media_id": null}], "options": {"A": "Shaking hands casually", "B": "Extending timely support, rescue, or assistance in hours of peril", "C": "Borrowing money on credit", "D": "Selling merchandise"}, "explanation": "'Kai Koduththal' means extending timely, lifesaving help to someone in trouble."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 213, "chapter": null, "section": null, "ref