{"id": "12th_tamil_u8_q1384", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "death_year_mayilai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயிலை சீனி. வேங்கடசாமி அவர்கள் இயற்கை எய்திய ஆண்டு எது?", "media_id": null}], "options": {"A": "1975", "B": "1978", "C": "1985", "D": "1980 (ஆகஸ்ட் 24)"}, "explanation": "மயிலை சீனி. வேங்கடசாமி தமது 80-வது வயதில் 1980-ஆம் ஆண்டு ஆகஸ்ட் 24 அன்று மறைந்தார்."}, "en": {"blocks": [{"type": "text", "content": "In which year did Mayilai Seeni. Venkatasamy pass away?", "media_id": null}], "options": {"A": "1975", "B": "1978", "C": "1985", "D": "1980 (August 24)"}, "explanation": "Mayilai Seeni. Venkatasamy passed away at the age of 80 on August 24, 1980."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 196, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 196", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags"