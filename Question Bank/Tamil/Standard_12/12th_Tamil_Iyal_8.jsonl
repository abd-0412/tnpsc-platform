{"id": "12th_tamil_u8_q1506", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kuriyeedu_grammar", "chapter_id": null, "topic_id": "tree_shadow_symbol", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘நிழல் தரும் பெருமரம்’ என்னும் குறியீடு இலக்கியத்தில் எத்தகைய ஆளுமையை உணர்த்துகிறது?", "media_id": null}], "options": {"A": "சுயநலக்காரனை", "B": "தன்னை நாடி வருவோரின் துயரைப் போக்கி அடைக்கலமும் ஆதரவும் நல்கும் பெருந்தகைமை கொண்ட கொடையாளனை", "C": "பயந்த சுபாவம் உள்ளவனை", "D": "வணிகனை"}, "explanation": "பெருங்குடை போன்ற நிழல்மரம் தன்னை அடைந்த அனைவருக்கும் எவ்விதப் பாகுபாடுமின்றி அடைக்கலம் தரும் வள்ளல்களுக்கு உவமையாகவும் குறியீடாகவும் ஆளப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What moral character does the symbol of a 'Shady Giant Tree' (Nizhal tharum perumaram) signify?", "media_id": null}], "options": {"A": "Selfish miser", "B": "A noble, sheltering benefactor offering solace and protection to all who seek shelter", "C": "Timid coward", "D": "Merchant"}, "explanation": "The shady tree denotes a magnanimous benefactor sheltering and nourishing all unconditionally."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "