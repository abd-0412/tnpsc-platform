{"id": "12th_tamil_u8_q1413", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ratchanya_yathirigam", "chapter_id": null, "topic_id": "teaching_career", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எச்.ஏ. கிருஷ்ணபிள்ளை அவர்கள் தமிழாசிரியராகப் பணியாற்றிய புகழ்பெற்ற கல்லூரி எது?", "media_id": null}], "options": {"A": "சென்னை மாநிலக் கல்லூரி (Presidency College)", "B": "மதுரை அமெரிக்கன் கல்லூரி", "C": "திருச்சி தூய வளனார் கல்லூரி", "D": "சென்னை கிறித்துவக் கல்லூரி"}, "explanation": "பாளையங்கோட்டை சி.எம்.எஸ் பள்ளியிலும், பின்னர் புகழ்பெற்ற சென்னை மாநிலக் கல்லூரியிலும் தலைமைத் தமிழாசிரியராகப் பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "At which premier institution did H.A. Krishna Pillai serve as the head Tamil professor?", "media_id": null}], "options": {"A": "Presidency College, Chennai", "B": "American College, Madurai", "C": "St. Joseph's College, Tiruchirappalli", "D": "Madras Christian College"}, "explanation": "He served as the Chief Tamil Professor at the prestigious Presidency College, Chennai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 201, "chapter"