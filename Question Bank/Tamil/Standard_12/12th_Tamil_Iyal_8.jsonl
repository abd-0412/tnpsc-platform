{"id": "12th_tamil_u8_q1518", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "pagupatham_thozhuthanan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தொழுதனன்’ - பகுபத உறுப்பிலக்கணப் பிரிப்பில் சரியான முறை எது?", "media_id": null}], "options": {"A": "தொழு + த் + அனன்", "B": "தொழு + த் + அன் + அன்", "C": "தொழுத + அனன்", "D": "தொழுத் + அன் + அன்"}, "explanation": "தொழு - பகுதி; த் - இறந்தகால இடைநிலை; அன் - சாரியை; அன் - படர்க்கை ஆண்பால் வினைமுற்று விகுதி."}, "en": {"blocks": [{"type": "text", "content": "What is the accurate morphological parsing of the finite verb 'Thozhuthanan'?", "media_id": null}], "options": {"A": "Thozhu + t + anan", "B": "Thozhu (root) + t (past tense) + an (sarai) + an (masculine singular suffix)", "C": "Thozhutha + anan", "D": "Thozhut + an + an"}, "explanation": "Thozhu (root) + 't' (past tense marker) + 'an' (inflectional linker) + 'an' (third person masculine singular)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 205, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 205", "u