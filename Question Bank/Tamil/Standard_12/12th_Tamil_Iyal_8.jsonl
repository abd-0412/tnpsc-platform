{"id": "12th_tamil_u8_q1524", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "glossary_secularism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘Secularism’ என்ற ஆங்கிலச் சொல்லுக்கு இணையான அரசியலமைப்புத் தமிழ்ச் சொல் எது?", "media_id": null}], "options": {"A": "மதவாத ஆட்சி", "B": "பொருளாதார வளர்ச்சி", "C": "குடிமக்கள் சட்டம்", "D": "மதச்சார்பின்மை (சமயச் சார்பின்மை)"}, "explanation": "'Secularism' என்பது அனைத்து மதங்களையும் சமமாக மதித்து, அரசு எந்தவொரு மதத்தின் பக்கமும் சாயாமல் இருக்கும் 'மதச்சார்பின்மை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the constitutional Tamil terminology for the concept of 'Secularism'?", "media_id": null}], "options": {"A": "Theocratic governance", "B": "Economic growth", "C": "Civilian code", "D": "Secularism (Madach chaarbinmai / Samayach chaarbinmai)"}, "explanation": "'Secularism' is translated as 'மதச்சார்பின்மை' in Indian constitutional Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 213, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 213", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 8", "Language Skills", "Constitutional Terms"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u8_q1525", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "pazhamozhi_thaan_aadaavittaalum", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தான் ஆடாவிட்டாலும் தன் சதை ஆடும்’ என்னும் பழமொழி எதனை உணர்த்துகிறது?", "media_id": null}], "options": {"A": "இயற்கையான குருதித் தொடர்பும் பாசப் பிணைப்பும் எந்தச் சூழலிலும் வெளிப்படும் தன்மை", "B": "நாட்டியத்தின் வேகம்", "C": "உடல் பருமன்", "D": "விளையாட்டுப் பயிற்சி"}, "explanation": "மனக்கசப்புகள் இருப்பினும் நெருங்கிய உறவினருக்குத் துன்பம் நேரும் போது தானாகவே இரக்கமும் ஆதரவும் சுரக்கும் பாச உணர்வை இப்பழமொழி உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What underlying truth is articulated by the proverb 'Thaan aadaavittaalum than sadhai aadum'?", "media_id": null}], "options": {"A": "Innate kinship bonds and familial affection instinctively reveal themselves during crises", "B": "Dance choreography cadence", "C": "Physical obesity", "D": "Athletic gymnastics"}, "explanation": "This folk proverb conveys the instinctive pull of blood kinship and deep emotional solidarity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 213, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 213", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 8", "Language Skills", "Proverbs"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u8_q1526", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "irattaikizhavi_iyal8", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மழை படபடவெனப் பெய்தது’ - இதில் ‘படபட’ என்பது எவ்வகைச் சொல்?", "media_id": null}], "options": {"A": "அடுக்குத்தொடர்", "B": "இரட்டைக்கிளவி", "C": "வினையெச்சம்", "D": "பெயரெச்சம்"}, "explanation": "'படபட' என்பதைப் பிரித்தால் தனியே பொருள் தராது; ஒலியைக் குறிப்பாக உணர்த்தி இரட்டையாய் மட்டுமே நிற்பதால் இது இரட்டைக்கிளவி ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the lexical category of 'Pada-pada' in the sentence describing rain pouring heavily.", "media_id": null}], "options": {"A": "Adukkuththodar", "B": "Irattaikkilavi (Echo word)", "C": "Vinaiyechcham", "D": "Peyarechcham"}, "explanation": "Because 'Pada-pada' loses its meaning when separated, it is an Irattaikkilavi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 205, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 205", "url": null, "source_notes": null}, "previous_year": {"is_previ