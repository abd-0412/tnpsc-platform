{"id": "12th_tamil_u8_q1539", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "author_iyal8_review", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தமிழ்ப் பேரவைச் செம்மல்’ மயிலை சீனி. வேங்கடசாமியின் ஆய்வுகள் எவ்வகையான தமிழ்ப் பண்பை மீட்டெடுத்தன?", "media_id": null}], "options": {"A": "மதவாதப் போக்கு", "B": "மூடநம்பிக்கை", "C": "மதச்சார்பற்ற, அறிவியல் பூர்வமான பண்டைய தமிழரின் கலை மற்றும் வரலாற்றுப் பெருமை", "D": "அன்னிய மோகம்"}, "explanation": "மயிலையாரின் நடுநிலையான ஆய்வுகள் தமிழரின் உண்மையான வரலாற்று ஆவணங்களையும் கலைப் பெருமைகளையும் மீட்டெடுத்து உலகுக்கு உணர்த்தின."}, "en": {"blocks": [{"type": "text", "content": "What authentic heritage dimension was resurrected by the scholarship of Mayilai Seeni. Venkatasamy?", "media_id": null}], "options": {"A": "Sectarian dogmatism", "B": "Superstitious myths", "C": "Secular, empirical, and scientific legacy of ancient Tamil arts, epigraphs, and historiography", "D": "Fascination with foreign customs"}, "explanation": "He resurrected the objective, secular, and scientifically grounded glory of classical Tamil history."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corp