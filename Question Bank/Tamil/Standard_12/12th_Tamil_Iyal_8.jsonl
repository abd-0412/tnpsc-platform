{"id": "12th_tamil_u8_q1449", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sirubanaatruppadai", "chapter_id": null, "topic_id": "nalliyakkodan_capital", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஓய்மாநாட்டு நல்லியக்கோடனின் தலைநகரமாகச் சிறுபாணாற்றுப்படையில் போற்றப்படும் ஊர் எது?", "media_id": null}], "options": {"A": "நன்மாவிலங்கை (மாவிலங்கை)", "B": "தகடூர்", "C": "உறையூர்", "D": "புகார்"}, "explanation": "நல்லியக்கோடன் இலங்கை போன்ற பெருவளம் மிக்க 'நன்மாவிலங்கை' என்னும் நகரைத் தலைநகராகக் கொண்டு ஆட்சி புரிந்தான்."}, "en": {"blocks": [{"type": "text", "content": "Which prosperous capital city was ruled by Oymaanattu Nalliyakkodan in Sirubanaatruppadai?", "media_id": null}], "options": {"A": "Nanmaavilangkai (Mavilangkai)", "B": "Tagadur", "C": "Uraiyur", "D": "Puhar"}, "explanation": "Nalliyakkodan ruled from his capital city Nanmaavilangkai, famed for maritime abundance."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 204, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 204", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": fa