{"id": "12th_tamil_u8_q1475", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kodai_mazhai", "chapter_id": null, "topic_id": "character_selflessness", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கதையில் பிறருக்கு உதவும் எளிய மனிதர்களின் செயலில் வெளிப்படுவது யாது?", "media_id": null}], "options": {"A": "விளம்பர ஆசை", "B": "பரிசு பெறும் எண்ணம்", "C": "தன்னலமற்ற தூய தியாகப் பண்பு", "D": "அரசு வேலை வாய்ப்பு"}, "explanation": "எந்தப் பலனையும் எதிர்பாராமல் தானாக முன்வந்து செய்யும் தன்னலமற்ற சேவையே மனித வாழ்வை மகத்துவப்படுத்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What virtue shines forth from the spontaneous actions of ordinary helpers in the story?", "media_id": null}], "options": {"A": "Craving for public recognition", "B": "Hope of winning cash awards", "C": "Pure, uncalculated, selfless altruism", "D": "Desire for government recruitment"}, "explanation": "Their deeds demonstrate pure, selfless charity without seeking reward or fame."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 207, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 207", "url