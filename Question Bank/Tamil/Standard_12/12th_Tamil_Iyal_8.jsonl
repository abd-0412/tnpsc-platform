{"id": "12th_tamil_u8_q1534", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "thodar_amaippu_iyal8", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘எல்லா உயிர்களிடத்தும் அன்பு செலுத்துங்கள்’ - இத்தொடரின் வகை யாது?", "media_id": null}], "options": {"A": "வினாத்தொடர்", "B": "விழைவுத்தொடர் / நன்னெறி அறிவுறுத்தும் கட்டளைத்தொடர்", "C": "உணர்ச்சித்தொடர்", "D": "செய்தித்தொடர்"}, "explanation": "அறநெறியை வலியுறுத்திச் செயல்படுமாறு வேண்டுதலோடு கட்டளையிடுவதால் இது விழைவு அல்லது கட்டளைத்தொடர் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the type of sentence: 'Show unconditional love toward all living creatures'.", "media_id": null}], "options": {"A": "Interrogative sentence", "B": "Optative / Imperative ethical directive sentence", "C": "Exclamatory sentence", "D": "Declarative sentence"}, "explanation": "Directing moral action toward universal benevolence makes it an imperative/optative sentence."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 205, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8,