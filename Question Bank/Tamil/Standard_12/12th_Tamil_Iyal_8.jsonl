{"id": "12th_tamil_u8_q1408", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ratchanya_yathirigam", "chapter_id": null, "topic_id": "kristiyan_character", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரட்சணிய யாத்திரிகக் காப்பியத்தின் முதன்மைக் கதைத்தலைவன் (Hero) யார்?", "media_id": null}], "options": {"A": "இயேசு பெருமான்", "B": "யோவான்", "C": "பவுல்", "D": "கிறித்தியான் (Christian)"}, "explanation": "பாவச் சுமையைத் தலையில் சுமந்து, அழிவு நகரத்திலிருந்து விடுபட்டு வான்நகரம் (பரலோக நகரம்) நோக்கிப் பயணிக்கும் 'கிறித்தியான்' என்பவனே தலைவன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who is the primary allegorical protagonist of the epic Ratchanya Yaathirigam?", "media_id": null}], "options": {"A": "Jesus Christ", "B": "John", "C": "Paul", "D": "Kristiyan (The Pilgrim / Christian)"}, "explanation": "Kristiyan, carrying a heavy burden of sin and journeying from the City of Destruction to the Celestial City, is the protagonist."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 200, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 200", "url": null, "sou