{"id": "12th_tamil_u8_q1377", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "religious_studies", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழகத்தில் பௌத்தமும் சமணமும் ஆற்றிய இலக்கிய, சமயப் பணிகளை நடுநிலையோடு ஆராய்ந்து மயிலை சீனி. வேங்கடசாமி எழுதிய நூல்கள் எவை?", "media_id": null}], "options": {"A": "பௌத்தமும் தமிழும், சமணமும் தமிழும்", "B": "கிறித்தவமும் தமிழும், இசுலாமும் தமிழும்", "C": "சைவமும் தமிழும், வைணவமும் தமிழும்", "D": "ஆசிவகம் தமிழும்"}, "explanation": "‘பௌத்தமும் தமிழும்’ (1940) மற்றும் ‘சமணமும் தமிழும்’ (1954) ஆகிய நூல்கள் தமிழியல் ஆய்வில் மதச்சார்பற்ற அறிவியல் பார்வையை ஏற்படுத்தின."}, "en": {"blocks": [{"type": "text", "content": "Which objective research books were written by Mayilai Seeni. Venkatasamy analyzing Buddhist and Jain contributions to Tamil?", "media_id": null}], "options": {"A": "Buddhism and Tamil, Jainism and Tamil", "B": "Christianity and Tamil, Islam and Tamil", "C": "Saivism and Tamil, Vaishnavism and Tamil", "D": "Ajivika and Tamil"}, "explanation": "'Buddhism and Tamil' and 'Jainism and Tamil' set rigorous standards for secular historical inquiry in Tamil studies."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publi