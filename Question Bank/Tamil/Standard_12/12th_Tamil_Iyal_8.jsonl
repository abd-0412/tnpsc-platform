{"id": "12th_tamil_u8_q1425", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ratchanya_yathirigam", "chapter_id": null, "topic_id": "thembavani_comparison", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழில் தோன்றிய தலைசிறந்த இரு பெரும் கிறித்தவக் காப்பியங்கள் எவை?", "media_id": null}], "options": {"A": "வீரமாமுனிவரின் தேம்பாவணி & எச்.ஏ. கிருஷ்ணபிள்ளையின் இரட்சணிய யாத்திரிகம்", "B": "சீறாப்புராணம் & இரட்சணிய யாத்திரிகம்", "C": "கம்பராமாயணம் & தேம்பாவணி", "D": "சிலப்பதிகாரம் & மணிமேகலை"}, "explanation": "வீரமாமுனிவர் இயற்றிய 'தேம்பாவணி' மற்றும் எச்.ஏ. கிருஷ்ணபிள்ளை இயற்றிய 'இரட்சணிய யாத்திரிகம்' ஆகியவையே தமிழில் உருவான இரு பெரும் கிறித்தவக் காப்பியங்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which two magnificent works represent the twin epic summits of Christian Tamil literature?", "media_id": null}], "options": {"A": "Veeramamunivar's Thembavani and H.A. Krishna Pillai's Ratchanya Yaathirigam", "B": "Seerapuranam and Ratchanya Yaathirigam", "C": "Kamba Ramayanam and Thembavani", "D": "Silappathikaram and Manimekalai"}, "explanation": "'Thembavani' and 'Ratchanya Yaathirigam' stand as the twin towering peaks of Christian epic poetry in Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publishe