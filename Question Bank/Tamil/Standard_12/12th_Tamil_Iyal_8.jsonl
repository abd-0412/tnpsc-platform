{"id": "12th_tamil_u8_q1376", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "marainthupona_noolgal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழில் முற்காலத்தில் இயற்றப்பட்டுப் பின் காலவெள்ளத்தில் வழக்கொழிந்துபோன நூல்களைப் பட்டியலிட்டு மயிலை சீனி. வேங்கடசாமி எழுதிய ஆய்வு நூல் எது?", "media_id": null}], "options": {"A": "பௌத்தமும் தமிழும்", "B": "சமணமும் தமிழும்", "C": "சாசனச் செய்யுள் மஞ்சரி", "D": "மறைந்துபோன தமிழ் நூல்கள்"}, "explanation": "உரையாசிரியர்களின் மேற்கோள்களில் மட்டுமே பெயர் காணப்பட்ட 30-க்கும் மேற்பட்ட நூல்களைத் திரட்டி 'மறைந்துபோன தமிழ் நூல்கள்' என்னும் அரிய நூலை வெளியிட்டார்."}, "en": {"blocks": [{"type": "text", "content": "Which landmark research monograph was written by Mayilai Seeni. Venkatasamy cataloging ancient lost Tamil texts?", "media_id": null}], "options": {"A": "Buddhism and Tamil", "B": "Jainism and Tamil", "C": "Sasana Seyyul Manjari", "D": "Maraindhupona Thamizh Noolgal (Lost Tamil Books)"}, "explanation": "He painstakingly gathered lost literary fragments from medieval commentaries to write 'Maraindhupona Thamizh Noolgal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Ser