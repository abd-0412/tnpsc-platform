{"id": "12th_tamil_u8_q1443", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sirubanaatruppadai", "chapter_id": null, "topic_id": "oymaanadu_region", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஓய்மாநாடு என்பது தற்காலத்தில் எந்தப் பகுதியை உள்ளடக்கிய நிலப்பரப்பாகும்?", "media_id": null}], "options": {"A": "மதுரை மற்றும் திண்டுக்கல் பகுதிகள்", "B": "கோயம்புத்தூர் மற்றும் திருப்பூர் பகுதிகள்", "C": "திண்டிவனம், மரக்காணம் உள்ளிட்ட விழுப்புரம் மற்றும் புதுச்சேரி கடற்கரைப் பகுதிகள்", "D": "திருநெல்வேலி பகுதிகள்"}, "explanation": "ஓய்மாநாடு என்பது திண்டிவனம், மரக்காணம், நல்லூர் உள்ளிட்ட விழுப்புரம் மற்றும் புதுச்சேரி கடலோரப் பகுதிகளைக் குறிப்பதாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which modern geographical region corresponds to the ancient Sangam territory of Oymaanadu?", "media_id": null}], "options": {"A": "Madurai and Dindigul region", "B": "Coimbatore and Tiruppur belt", "C": "Tindivanam, Marakkanam, Villupuram, and Puducherry coastal belt", "D": "Tirunelveli region"}, "explanation": "Oymaanadu corresponds to the coastal and inland belt encompassing modern Tindivanam, Marakkanam, and Villupuram."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Cor