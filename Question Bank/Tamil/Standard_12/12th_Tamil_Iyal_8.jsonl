{"id": "12th_tamil_u8_q1527", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "solliisai_alabedai_iyal8", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தழீஇ’ - இலக்கணக் குறிப்புத் தருக.", "media_id": null}], "options": {"A": "செய்யுளிசை அளபெடை", "B": "இன்னிசை அளபெடை", "C": "சொல்லிசை அளபெடை", "D": "ஒற்றளபெடை"}, "explanation": "'தழுவி' என்னும் வினையெச்சப் பொருளைத் தருவதற்காக 'தழுவு' என்ற பெயர்ச்சொல் 'தழீஇ' என 'இ' பெற்று அளபெடுத்ததால் இது சொல்லிசை அளபெடை ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the grammatical categorization for 'Thazheei'.", "media_id": null}], "options": {"A": "Seyyulisai Alabedai", "B": "Innisai Alabedai", "C": "Solliisai Alabedai (Elongation changing nominal form to adverbial participle)", "D": "Otralabedai"}, "explanation": "'Thazheei' elongates with the vowel 'i' to function as an adverbial participle, making it Solliisai Alabedai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 205, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 205", "url": null, "source_not