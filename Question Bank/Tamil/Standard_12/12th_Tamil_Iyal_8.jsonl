{"id": "12th_tamil_u8_q1412", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ratchanya_yathirigam", "chapter_id": null, "topic_id": "birth_palayamkottai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எச்.ஏ. கிருஷ்ணபிள்ளை அவர்கள் பிறந்த ஊர் மற்றும் மாவட்டம் எது?", "media_id": null}], "options": {"A": "தஞ்சாவூர் மாவட்டம் கும்பகோணம்", "B": "தூத்துக்குடி மாவட்டம் எட்டயபுரம்", "C": "கன்னியாகுமரி மாவட்டம் நாகர்கோவில்", "D": "திருநெல்வேலி மாவட்டம் கரையிருப்பு (பாளையங்கோட்டை)"}, "explanation": "எச்.ஏ. கிருஷ்ணபிள்ளை 1827-இல் திருநெல்வேலி மாவட்டம் பாளையங்கோட்டைக்கு அருகிலுள்ள கரையிருப்பில் பிறந்தார்."}, "en": {"blocks": [{"type": "text", "content": "What is the native birthplace and district of H.A. Krishna Pillai?", "media_id": null}], "options": {"A": "Kumbakonam in Thanjavur district", "B": "Ettayapuram in Thoothukudi district", "C": "Nagercoil in Kanyakumari district", "D": "Karaiyiruppu near Palayamkottai in Tirunelveli district"}, "explanation": "He was born in 1827 at Karaiyiruppu near Palayamkottai, Tirunelveli district."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 201, "chapte