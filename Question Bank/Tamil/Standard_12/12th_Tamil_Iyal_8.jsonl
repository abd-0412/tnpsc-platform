{"id": "12th_tamil_u8_q1375", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "profession_teacher", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயிலை சீனி. வேங்கடசாமி அவர்கள் தம் வாழ்நாளில் எத்தனை ஆண்டுகள் தொடக்கப்பள்ளி ஆசிரியராகப் பணியாற்றினார்?", "media_id": null}], "options": {"A": "15 ஆண்டுகள்", "B": "20 ஆண்டுகள்", "C": "25 ஆண்டுகள்", "D": "30 ஆண்டுகள்"}, "explanation": "சென்னைப் மாநகராட்சிப் பள்ளிகளில் சுமார் 25 ஆண்டுகள் எளிய தொடக்கப்பள்ளி ஆசிரியராகப் பணியாற்றியவாறே பேருழைப்பால் வரலாற்று நூல்களை எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "For how many years did Mayilai Seeni. Venkatasamy serve as an elementary school teacher while researching?", "media_id": null}], "options": {"A": "15 years", "B": "20 years", "C": "25 years", "D": "30 years"}, "explanation": "He served as an elementary school teacher in Chennai Corporation schools for 25 years while writing monumental works."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 193, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Pag