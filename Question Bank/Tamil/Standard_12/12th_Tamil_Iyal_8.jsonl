{"id": "12th_tamil_u8_q1391", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "sangam_literature_research", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்ககால மூவேந்தர்களின் வரலாற்றைத் தொகுத்து மயிலையார் எழுதிய நூல்களுள் தவறானது எது?", "media_id": null}], "options": {"A": "சேரன் செங்குட்டுவன்", "B": "கொங்கு நாட்டு வரலாறு", "C": "முகலாயர் பேரரசு", "D": "துளுநாட்டு வரலாறு"}, "explanation": "சேரன் செங்குட்டுவன், கொங்கு நாட்டு வரலாறு, துளுநாட்டு வரலாறு ஆகிய அனைத்தையும் மயிலையார் எழுதினார்; முகலாயர் பேரரசு அவர் எழுதியதன்று."}, "en": {"blocks": [{"type": "text", "content": "Which of the following regional history works was NOT authored by Mayilai Seeni. Venkatasamy?", "media_id": null}], "options": {"A": "Cheran Senguttuvan", "B": "History of Kongu Nadu", "C": "Mughal Empire", "D": "History of Tulu Nadu"}, "explanation": "He wrote extensively on Cheran Senguttuvan, Kongu Nadu, and Tulu Nadu, but not on the Mughal Empire."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 195, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 195", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 8", "Prose", "Regional History"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u8_q1392", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "nationalization_books", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயிலை சீனி. வேங்கடசாமியின் படைப்புகள் மற்றும் நூல்கள் தமிழ்நாடு அரசால் எந்த ஆண்டு நாட்டுடைமை ஆக்கப்பட்டன?", "media_id": null}], "options": {"A": "1990", "B": "1995", "C": "2000", "D": "2006 (மற்றும் அரசு நூல்களாகப் பதிப்பித்தல்)"}, "explanation": "மயிலை சீனி. வேங்கடசாமியின் அரிய நூல்கள் அனைத்தும் தமிழ்நாடு அரசால் நாட்டுடைமை ஆக்கப்பட்டு உலகெங்கும் உள்ள தமிழர்களுக்குக் கிடைக்க வழிவகை செய்யப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "In which decade were Mayilai Seeni. Venkatasamy's literary and historical works nationalized by the Tamil Nadu Government?", "media_id": null}], "options": {"A": "1990", "B": "1995", "C": "2000", "D": "2006 (Nationalized as public domain treasures)"}, "explanation": "The Government of Tamil Nadu nationalized all works of Mayilai Seeni. Venkatasamy in 2006."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 196, "chapter": null, "section"