{"id": "12th_tamil_u8_q1477", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kodai_mazhai", "chapter_id": null, "topic_id": "humanity_above_all", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கோடை மழை’ சிறுகதையின் மூலம் ஆசிரியர் சாந்தா தத் முன்வைக்கும் மானுட தரிசனம் யாது?", "media_id": null}], "options": {"A": "அன்பும் கருணையுமே இந்த உலகை இயக்கும் அச்சாணிகள்; அவை இருக்கும் வரை மனிதகுலம் ஒருபோதும் அழியாது", "B": "இயற்கையை மனிதன் வெல்ல வேண்டும்", "C": "பணமே வாழ்வின் ஒரே இலக்கு", "D": "தனித்து வாழ்வதே சிறந்தது"}, "explanation": "மனிதநேயமும் கருணையுமே உலகை நிலைநிறுத்தும் தூண்கள் என்பதை ஆசிரியர் அழுத்தமாகப் பதிவு செய்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "What humanist philosophy does author Shanta Dutt articulate through 'Kodai Mazhai'?", "media_id": null}], "options": {"A": "Love and empathy are the foundational linchpins sustaining the universe; as long as they endure, humanity will never perish", "B": "Humans must conquer nature ruthlessly", "C": "Money is the sole purpose of life", "D": "Solitary self-centered life is best"}, "explanation": "Empathy and selfless love are affirmed as the foundational linchpins sustaining human existence."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher":