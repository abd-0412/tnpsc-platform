{"id": "12th_tamil_u8_q1385", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "nool_aasi_quotes", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஆராய்ச்சிப் பேரறிஞர் மயிலை சீனி. வேங்கடசாமி தமிழ் ஆய்வுலகில் ஒரு தனிப் பல்கலைக்கழகமாகச் செயல்பட்டார்’ என்று புகழ்ந்தவர் யார்?", "media_id": null}], "options": {"A": "தமிழறிஞர்கள் மற்றும் வரலாற்றாய்வாளர்கள்", "B": "ஆங்கிலக் கவிஞர்கள்", "C": "நாடக நடிகர்கள்", "D": "வணிகர்கள்"}, "explanation": "எந்தவிதப் பல்கலைக்கழகப் பின்புலமும் இன்றி தனி ஒரு மனிதராக நின்று ஒரு பல்கலைக்கழகம் செய்ய வேண்டிய ஆய்வுகளைச் செய்த பெருமை மயிலையாருக்கு உண்டு."}, "en": {"blocks": [{"type": "text", "content": "How is Mayilai Seeni. Venkatasamy celebrated in the academic realm for his monumental solo achievements?", "media_id": null}], "options": {"A": "As functioning as a one-man research university in the domain of Tamil studies", "B": "As an English dramatist", "C": "As a stage actor", "D": "As an international trader"}, "explanation": "Working independently without institutional funding, he virtually functioned as a solitary university in Tamil scholarship."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Edu