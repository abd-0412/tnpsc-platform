{"id": "12th_tamil_u8_q1537", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "punarchi_mannuyir", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மன்னுயிர்’ - பிரித்தெழுதுக:\n(மன்னுயிர் = ?)", "media_id": null}], "options": {"A": "மன்னு + உயிர்", "B": "மண் + உயிர்", "C": "மன் + உயிர்", "D": "மன்னன் + உயிர்"}, "explanation": "'மன்னுயிர்' என்பதைப் பிரித்தால் 'மன்னு + உயிர்' என வரும். 'உயிர்வரிற் குறுகும்' அல்லது 'உயிர்வரின் உக்குறள் மெய்விட் டோடும்' விதிப்படி 'மன்னுயிர்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "How is the classical compound 'Mannuyir' split grammatically?", "media_id": null}], "options": {"A": "Mannu + Uyir", "B": "Mann + Uyir", "C": "Man + Uyir", "D": "Mannan + Uyir"}, "explanation": "'Mannuyir' splits cleanly into 'Mannu + Uyir' (abiding living beings)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 205, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 205", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null,