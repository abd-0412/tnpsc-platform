{"id": "12th_tamil_u8_q1520", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "marabuththodar_karkottai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கானல் நீர்’ என்னும் மரபுத் தொடரின் பொருள் யாது?", "media_id": null}], "options": {"A": "கடற்கரை நீர்", "B": "மழை நீர்", "C": "குடிநீர்", "D": "இருப்பது போல் தோன்றி உண்மையில் இல்லாத ஏமாற்றம் / போலித் தோற்றம் (Illusion)"}, "explanation": "'கானல் நீர்' என்பது பாலைவனத்தில் நீர் இருப்பது போல் தோன்றி அருகில் சென்றால் ஏமாற்றத்தைத் தரும் போலியான மாயையைக் குறிக்கும் மரபுத் தொடர்."}, "en": {"blocks": [{"type": "text", "content": "What is the idiomatic signification of the phrase 'Kaanal Neer' (Mirage water)?", "media_id": null}], "options": {"A": "Coastal seaside water", "B": "Fresh rainwater", "C": "Potable spring water", "D": "An optical illusion or deceptive hope appearing real from afar but non-existent upon approach"}, "explanation": "'Kaanal Neer' idiomatically denotes an illusion or false hope."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 213, "chapter": null, "section": null,