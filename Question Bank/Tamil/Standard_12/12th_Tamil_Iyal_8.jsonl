{"id": "12th_tamil_u8_q1458", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kodai_mazhai", "chapter_id": null, "topic_id": "central_theme", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கோடை மழை’ சிறுகதையின் மையக் கருப்பொருள் எதனைப் பேசுகிறது?", "media_id": null}], "options": {"A": "விவசாய உத்திகள்", "B": "சுயநலமும் வறண்ட மனமும் கொண்ட உலகில் எதிர்பாராத கருணையும் மனிதநேயமும் கோடை மழையைப் போல மனங்களில் பொழியும் விதம்", "C": "நகரப் போக்குவரத்து நெரிசல்", "D": "அரசியல் தேர்தல் பிரச்சாரம்"}, "explanation": "வறண்ட கோடை காலத்தில் பெய்யும் எதிர்பாராத மழையைப் போல, இக்கட்டான சூழலில் மனிதர்களிடையே வெளிப்படும் உண்மையான அன்பு வாழ்வை மலரச் செய்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the central philosophical theme explored in the short story 'Kodai Mazhai'?", "media_id": null}], "options": {"A": "Agrarian harvesting methods", "B": "How spontaneous compassion and selfless human empathy shower like summer rain upon parched, selfish human hearts", "C": "Urban vehicular traffic congestion", "D": "Political election campaigns"}, "explanation": "The story allegorizes spontaneous compassion showering upon weary human souls just like unexpected summer rain."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publish