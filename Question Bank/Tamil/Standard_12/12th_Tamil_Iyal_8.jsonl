{"id": "12th_tamil_u8_q1508", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kuriyeedu_grammar", "chapter_id": null, "topic_id": "olive_branch", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உலக அளவில் அமைதி உடன்படிக்கையின் அடையாளமாகக் கையில் ஏந்தி நிற்கும் இலை எது?", "media_id": null}], "options": {"A": "வேப்பிலை", "B": "மாவிலை", "C": "துளசி இலை", "D": "ஆலிவ் இலைக் கொத்து (Olive branch)"}, "explanation": "ஆலிவ் இலைக் கொத்து என்பது போரை நிறுத்தி அமைதியை நிலைநாட்டும் சமாதானத்தின் உலகளாவிய குறியீடாகும்."}, "en": {"blocks": [{"type": "text", "content": "What botanical emblem is universally held as a symbol of truce, peace, and reconciliation?", "media_id": null}], "options": {"A": "Neem sprig", "B": "Mango leaf", "C": "Tulsi sprig", "D": "Olive branch"}, "explanation": "The olive branch is the globally recognized archetype of peace, treaty, and goodwill."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 210, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 210", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_nam