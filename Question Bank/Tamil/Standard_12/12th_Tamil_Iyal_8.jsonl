{"id": "12th_tamil_u8_q1380", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "madurai_university_title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மதுரை காமராசர் பல்கலைக்கழகம் மயிலை சீனி. வேங்கடசாமி அவர்களுக்கு வழங்கிச் சிறப்பித்த உயரிய பட்டப் பெயர் எது?", "media_id": null}], "options": {"A": "தமிழ்ப் பேரவைச் செம்மல்", "B": "மகாவித்துவான்", "C": "செந்தமிழ்க் கலாநிதி", "D": "தமிழ்ப் பேரவைச் செம்மல் (1980)"}, "explanation": "மயிலையாரின் வாழ்நாள் தமிழ்ப்பணியைப் போற்றி 1980-ஆம் ஆண்டு மதுரை காமராசர் பல்கலைக்கழகம் 'தமிழ்ப் பேரவைச் செம்மல்' என்ற பட்டத்தை வழங்கிச் சிறப்பித்தது."}, "en": {"blocks": [{"type": "text", "content": "Which prestigious scholarly title was conferred on Mayilai Seeni. Venkatasamy by Madurai Kamaraj University in 1980?", "media_id": null}], "options": {"A": "Kalaimamani", "B": "Mahavidwan", "C": "Senthamizh Kalanidhi", "D": "Thamizh Peravai Chemmal (1980)"}, "explanation": "Madurai Kamaraj University honored him with the esteemed title 'Thamizh Peravai Chemmal' in 1980."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024