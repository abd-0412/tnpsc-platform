{"id": "12th_tamil_u8_q1457", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kodai_mazhai", "chapter_id": null, "topic_id": "author_shanta_dutt", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கோடை மழை’ என்னும் நெகிழ்ச்சியான மனிதநேயச் சிறுகதையை எழுதியவர் யார்?", "media_id": null}], "options": {"A": "சாந்தா தத்", "B": "அம்பை", "C": "திலகவதி", "D": "சுஜாதா"}, "explanation": "சமூகத்தில் எளிய மனிதர்களின் துயரத்தையும், கருணையின் ஈரத்தையும் உணர்த்தும் 'கோடை மழை' சிறுகதையை சாந்தா தத் எழுதியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the heartwarming humanitarian short story 'Kodai Mazhai' (Summer Rain)?", "media_id": null}], "options": {"A": "Shanta Dutt", "B": "Ambai", "C": "Thilagavathi", "D": "Sujatha"}, "explanation": "Shanta Dutt authored the moving short story 'Kodai Mazhai' portraying human empathy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 206, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 206", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "