{"id": "12th_tamil_u8_q1513", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "glossary_humanism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘Humanism’ என்ற ஆங்கிலச் சொல்லுக்கு இணையான சரியான தமிழ்ச் சொல் எது?", "media_id": null}], "options": {"A": "மனிதநேயம் (மனிதப்பண்பு)", "B": "அறிவியல் வாதம்", "C": "பொருளாதார வாதம்", "D": "இயற்கை வாதம்"}, "explanation": "'Humanism' என்பது மனிதனின் மேன்மையை, உரிமையை, தார்மீகப் பண்புகளை மையமாகக் கொள்ளும் 'மனிதநேயம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the accurate Tamil equivalent for the English terminology 'Humanism'?", "media_id": null}], "options": {"A": "Humanism (Manitha Neyam)", "B": "Scientism", "C": "Economism", "D": "Naturalism"}, "explanation": "'Humanism' translates directly to 'மனிதநேயம்' in academic and standard Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 213, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 213", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_na