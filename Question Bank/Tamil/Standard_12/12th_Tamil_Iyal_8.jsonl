{"id": "12th_tamil_u8_q1388", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "manuscript_hunting", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயிலை சீனி. வேங்கடசாமியின் ஆய்வுகள் முதன்மையாக எதனை அடிப்படையாகக் கொண்டிருந்தன?", "media_id": null}], "options": {"A": "புனைகதைகள்", "B": "வாய்மொழி வதந்திகள்", "C": "மேற்கத்திய பயணக் குறிப்புகள் மட்டுமே", "D": "கல்வெட்டுகள், செப்பேடுகள், ஓலைச்சுவடிகள் மற்றும் தொல்லியல் சான்றுகள்"}, "explanation": "அறிவியல் முறையிலான நேரடிக் கல்வெட்டு வாசிப்பு, செப்பேடுகள், சுவடிகள் ஆகியவற்றின் அகச்சான்றுகளையே அவர் தம் ஆய்வுக்கு அடித்தளமாக்கினார்."}, "en": {"blocks": [{"type": "text", "content": "What primary foundational evidence formed the core of Mayilai Seeni. Venkatasamy's research methodology?", "media_id": null}], "options": {"A": "Fictional folklore", "B": "Oral hearsay", "C": "Western traveler notes exclusively", "D": "Epigraphs, copper plates, palm-leaf manuscripts, and primary archaeological records"}, "explanation": "He based his assertions firmly on empirical scrutiny of inscriptions, copper plate charters, and primary textual sources."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educa