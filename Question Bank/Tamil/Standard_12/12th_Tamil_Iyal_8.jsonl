{"id": "12th_tamil_u8_q1428", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mugam_sukanthi", "chapter_id": null, "topic_id": "feminist_existentialism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுகந்தி சுப்பிரமணியனின் ‘முகம்’ கவிதை உணர்த்தும் இறுதிச் செய்தி யாது?", "media_id": null}], "options": {"A": "பெண்கள் கண்ணாடியைப் பார்க்கக் கூடாது", "B": "பெண்கள் வீட்டை விட்டு வெளியேற வேண்டும்", "C": "முக ஒப்பனைகள் வீணானது", "D": "பெண்கள் தங்கள் தனித்துவமான ஆளுமையையும் சுதந்திரமான சுய அடையாளத்தையும் எச்சூழலிலும் இழந்துவிடாமல் மீட்டெடுக்க வேண்டும்"}, "explanation": "குடும்பச் சூழலிலும் சமூகத்திலும் பெண்கள் தங்களது தனித்த ஆளுமையையும் சுய அடையாளத்தையும் இழந்துவிடாமல் தற்காத்துக் கொள்ள வேண்டும் என்பதை உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the ultimate message delivered by Suganthi Subramanian's feminist poem 'Mugam'?", "media_id": null}], "options": {"A": "Women should avoid looking at mirrors", "B": "Women should abandon their homes", "C": "Facial cosmetics are wasteful", "D": "Women must reclaim and safeguard their authentic voice, individual agency, and self-identity under all circumstances"}, "explanation": "It issues an urgent clarion call for women to reclaim their autonomous agency and authentic individuality."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false},