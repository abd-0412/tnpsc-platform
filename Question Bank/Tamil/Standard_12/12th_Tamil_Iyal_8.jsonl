{"id": "12th_tamil_u8_q1453", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sirubanaatruppadai", "chapter_id": null, "topic_id": "thinai_aatruppadai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிறுபாணாற்றுப்படை நூலின் பெரும்பகுதி எந்தத் திணைக்குரிய பாடலாக அமைகிறது?", "media_id": null}], "options": {"A": "பாடாண்திணை (மன்னனின் வீரம், கொடை, புகழைப் பாடுதல்)", "B": "குறிஞ்சித்திணை", "C": "முல்லைத்திணை", "D": "மருதத்திணை"}, "explanation": "ஒரு மனிதனின் வீரம், ஈகை, புகழ், ஆற்றல் ஆகியவற்றைப் புகழ்ந்து பாடுவதால் ஆற்றுப்படை நூல்கள் பாடாண்திணையில் அடங்கும்."}, "en": {"blocks": [{"type": "text", "content": "Under which classical grammatical Thinai does the panegyric poem Sirubanaatruppadai fall?", "media_id": null}], "options": {"A": "Paadaan Thinai (Eulogizing a ruler's munificence, valor, and lineage)", "B": "Kurinji Thinai", "C": "Mullai Thinai", "D": "Marutham Thinai"}, "explanation": "Because it celebrates the royal charity, courage, and virtue of a chieftain, it belongs to Paadaan Thinai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 202, "chapter": null, "section": null, "referenc