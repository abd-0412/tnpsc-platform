{"id": "12th_tamil_u8_q1446", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sirubanaatruppadai", "chapter_id": null, "topic_id": "viraliyar_aadal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிறுபாணனுடன் பயணம் செய்யும் பாடல் மற்றும் நாட்டியத்தில் சிறந்த பெண்கலைஞர் எவ்வாறு அழைக்கப்படுகிறார்?", "media_id": null}], "options": {"A": "தலைவி", "B": "விறலி", "C": "தோழி", "D": "செவிலி"}, "explanation": "பண்களைப் பாடி நரம்புகளை மீட்டி, விரல்களால் மெய்ப்பாடுகளைக் காட்டி ஆடும் பெண்கலைஞர் சங்க இலக்கியத்தில் 'விறலி' எனப்படுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What is the traditional Sangam designation for the female dancer and minstrel accompanying the bard?", "media_id": null}], "options": {"A": "Thalaivi", "B": "Virali", "C": "Thozhi", "D": "Sevili"}, "explanation": "A female artist proficient in singing ragas and demonstrating exquisite abhinaya through facial and finger mudras is called a 'Virali'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 203, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 203", "url": null, "source_notes": null}, "pre