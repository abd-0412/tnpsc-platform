{"id": "12th_tamil_u8_q1374", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "birth_details", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயிலை சீனி. வேங்கடசாமி அவர்கள் பிறந்த இடம் மற்றும் ஆண்டு எது?", "media_id": null}], "options": {"A": "திருநெல்வேலி, 1890", "B": "சென்னை மயிலாப்பூர், 1900 (டிசம்பர் 16)", "C": "தஞ்சாவூர், 1905", "D": "மதுரை, 1895"}, "explanation": "மயிலை சீனி. வேங்கடசாமி 1900-ஆம் ஆண்டு டிசம்பர் 16 அன்று சென்னை மயிலாப்பூரில் சீனிவாசன் - மரகதவல்லி தம்பதியருக்கு மகனாகப் பிறந்தார்."}, "en": {"blocks": [{"type": "text", "content": "What is the birthplace and birth year of Mayilai Seeni. Venkatasamy?", "media_id": null}], "options": {"A": "Tirunelveli, 1890", "B": "Mylapore, Chennai, 1900 (December 16)", "C": "Thanjavur, 1905", "D": "Madurai, 1895"}, "explanation": "Mayilai Seeni. Venkatasamy was born on December 16, 1900, in Mylapore, Chennai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 193, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 193", "url": null, "source_notes": null