{"id": "12th_tamil_u8_q1540", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "unit8_synoptic_moral", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "12-ஆம் வகுப்பு பொதுத்தமிழ் பாடநூலின் எட்டாம் இயல் (இயல் 8) உணர்த்தும் பொதுவான வாழ்வியல் நெறி யாது?", "media_id": null}], "options": {"A": "பணத்தை மட்டுமே போற்றுவது", "B": "போர்களில் வெற்றி பெறுவது", "C": "நாடுகளைக் கைப்பற்றுவது", "D": "மனிதநேயம், சமத்துவம், அறநெறி மற்றும் சுய அடையாளத்தைக் காத்து உலக உயிர்களைத் தன்னுயிர்போல் போற்றுதல்"}, "explanation": "மயிலையாரின் அர்ப்பணிப்பு, சுகந்தியின் அடையாளத் தேடல், எச்.ஏ.கிருஷ்ணபிள்ளையின் அருள் நெறி, நத்தத்தனாரின் கொடை மாண்பு, சாந்தா தத்தின் மனிதநேயம் ஆகிய அனைத்தும் இணைந்த உன்னத அறமே இயல் 8 ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What overarching moral virtue does Unit 8 ('Ellaigal Aayiram') synthesized across its prose, poetry, and grammar inculcate?", "media_id": null}], "options": {"A": "Hoarding monetary wealth", "B": "Waging triumphant imperial wars", "C": "Annexing sovereign territories", "D": "Humanitarianism, equality, ethical integrity, reclaiming authentic identity, and cherishing universal life as one's own"}, "explanation": "Unit 8 synthesizes selfless scholarship, female agency, redemptive grace, philanthropy, and universal humanitarian love."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 213, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 213", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 8", "Literature", "Unit Synthesis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
