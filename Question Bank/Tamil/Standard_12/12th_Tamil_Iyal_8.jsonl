{"id": "12th_tamil_u8_q1379", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "art_treatises", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயிலை சீனி. வேங்கடசாமி எழுதிய தமிழர் கலைகள் தொடர்பான நூல்களுள் பொருந்தாதது எது?", "media_id": null}], "options": {"A": "தமிழர் வளர்த்த அழகுக் கலைகள்", "B": "இறைவன் ஆடிய எண்வகை நடனம்", "C": "திரைப்படக்கலை வரலாறு", "D": "நுண்கலைகள்"}, "explanation": "‘தமிழர் வளர்த்த அழகுக் கலைகள்’, ‘இறைவன் ஆடிய எண்வகை நடனம்’, ‘நுண்கலைகள்’ ஆகியவற்றை மயிலையார் எழுதினார்; திரைப்படக்கலை வரலாறு இவர் எழுதியதன்று."}, "en": {"blocks": [{"type": "text", "content": "Which of the following art books was NOT authored by Mayilai Seeni. Venkatasamy?", "media_id": null}], "options": {"A": "Thamizhar Valartha Azhaguk Kalaigal", "B": "Iraivan Aadiya Envagai Nadanam", "C": "Thiraippadakkalai Varalaaru (Cinema History)", "D": "Nunkalaigal (Fine Arts)"}, "explanation": "He authored classic treatises on indigenous Tamil fine arts and dance, but not on cinema history."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 195, "ch