{"id": "12th_tamil_u8_q1394", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "manimekalai_buddhism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மணிமேகலை காப்பியத்தில் இடம்பெற்றுள்ள பௌத்த தத்துவங்களையும் சமய வழக்குகளையும் தெளிவாக விளக்கிய மயிலையாரின் ஆய்வு நூல் எது?", "media_id": null}], "options": {"A": "சமணமும் தமிழும்", "B": "பௌத்தமும் தமிழும்", "C": "சாசனச் செய்யுள் மஞ்சரி", "D": "தமிழர் நாகரிகம்"}, "explanation": "மணிமேகலையின் பௌத்த தத்துவக் கோட்பாடுகளையும், தமிழகத்தில் பௌத்தப் பள்ளிகள் விளங்கிய வரலாற்றையும் 'பௌத்தமும் தமிழும்' நூலில் விரிவாக விளக்கினார்."}, "en": {"blocks": [{"type": "text", "content": "In which monograph did Mayilai Seeni. Venkatasamy elucidate Buddhist philosophical tenets found in Manimekalai?", "media_id": null}], "options": {"A": "Jainism and Tamil", "B": "Buddhism and Tamil (Boudhamum Thamizhum)", "C": "Sasana Seyyul Manjari", "D": "Tamil Civilization"}, "explanation": "In 'Boudhamum Thamizhum', he systematically analyzed the Buddhist doctrines and monasteries depicted in Manimekalai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_