{"id": "12th_tamil_u8_q1535", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "glossary_epigraphist_def", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘Epigraphist’ என்ற சொல்லின் சரியான தமிழாக்கம் எது?", "media_id": null}], "options": {"A": "நாணயவியல் அறிஞர்", "B": "அகழாய்வாளர்", "C": "கல்வெட்டியலாளர் (கல்வெட்டு ஆய்வாளர்)", "D": "வானியலாளர்"}, "explanation": "'Epigraphist' என்பது கல்வெட்டுகளைப் படித்து ஆராயும் 'கல்வெட்டியலாளர்' அல்லது 'கல்வெட்டறிஞர்' ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "What is the precise Tamil translation for the profession 'Epigraphist'?", "media_id": null}], "options": {"A": "Numismatist", "B": "Excavator", "C": "Epigraphist (Kalvettiyalaalar)", "D": "Astronomer"}, "explanation": "'Epigraphist' translates directly to 'கல்வெட்டியலாளர்'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 213, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 213", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null