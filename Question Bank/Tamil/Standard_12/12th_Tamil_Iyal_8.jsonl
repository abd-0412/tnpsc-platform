{"id": "12th_tamil_u8_q1381", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "historical_kings_books", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மகேந்திரவர்மன், நரசிம்மவர்மன் முதலான பல்லவ மன்னர்களின் வரலாற்றை விரிவாக ஆய்வு செய்து மயிலை சீனி. வேங்கடசாமி எழுதிய நூல் எது?", "media_id": null}], "options": {"A": "மகேந்திரவர்மன் (மற்றும் மூன்றாம் நந்திவர்மன்)", "B": "சோழர் வரலாறு", "C": "சேர வேந்தர் மரபு", "D": "பாண்டியர் செப்பேடுகள்"}, "explanation": "பல்லவர் வரலாற்றை ஆவணப்படுத்த 'மகேந்திரவர்மன்', 'நரசிம்மவர்மன்', 'மூன்றாம் நந்திவர்மன்' ஆகிய தனித்தனி வரலாற்று நூல்களை எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "Which historical monographs did Mayilai Seeni. Venkatasamy write detailing the reign of Pallava monarchs?", "media_id": null}], "options": {"A": "Mahendravarman (and Nandivarman III)", "B": "History of the Cholas", "C": "Chera Dynastic Lineage", "D": "Pandya Copper Plates"}, "explanation": "He wrote definitive monographs on Pallava emperors including 'Mahendravarman' and 'Nandivarman III'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_