{"id": "12th_tamil_u8_q1409", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ratchanya_yathirigam", "chapter_id": null, "topic_id": "other_works_krishnapillai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எச்.ஏ. கிருஷ்ணபிள்ளை இயற்றிய பிற பக்தி இலக்கிய நூல்களுள் பொருத்தமானது எது?", "media_id": null}], "options": {"A": "இரட்சணிய மனோகரம், இரட்சணிய சமய நிர்ணயம், தேவமாதா அந்தாதி", "B": "தேம்பாவணி, சதுரகராதி", "C": "இயேசு காவியம், அர்த்தமுள்ள இந்துமதம்", "D": "கிறித்தவப் பாமாலை, பெத்லகேம் குறவஞ்சி"}, "explanation": "எச்.ஏ. கிருஷ்ணபிள்ளை 'இரட்சணிய மனோகரம்', 'இரட்சணிய சமய நிர்ணயம்', 'தேவமாதா அந்தாதி' முதலான சீரிய நூல்களை இயற்றியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following sets of spiritual works was authored by H.A. Krishna Pillai?", "media_id": null}], "options": {"A": "Ratchanya Manoharam, Ratchanya Samaya Nirnayam, Devamatha Anthathi", "B": "Thembavani, Chathuragarathi", "C": "Yesu Kaviyam, Arthamulla Indhumatham", "D": "Christian Hymnal, Bethleheam Kuravanji"}, "explanation": "His other classical works include 'Ratchanya Manoharam', 'Ratchanya Samaya Nirnayam', and 'Devamatha Anthathi'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational 