{"id": "12th_tamil_u8_q1437", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sirubanaatruppadai", "chapter_id": null, "topic_id": "athiyaman_nelli", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சாவு தரும் நஞ்சையும் நீக்கும் அரிய சாகா நெல்லிக்கனியைத் தான் உண்ணாமல் ஔவையாருக்குக் கொடுத்த தகடூர் வள்ளல்’ யார்?", "media_id": null}], "options": {"A": "அதியமான் நெடுமான் அஞ்சி", "B": "ஓரி", "C": "பேகன்", "D": "நல்லியக்கோடன்"}, "explanation": "தகடூர் மன்னனான அதியமான் நெடுமான் அஞ்சி மலைப்பிளப்பில் கிடைத்த சாகா மூவா அருங்கனியான நெல்லிக்கனியைத் தமிழ்ப் புலவர் ஔவையாருக்கு அளித்தான்."}, "en": {"blocks": [{"type": "text", "content": "Which Tagadur chieftain gifted the immortality-bestowing rare black gooseberry to poetess Avvaiyar instead of eating it himself?", "media_id": null}], "options": {"A": "Adiyaman Neduman Anji", "B": "Oari", "C": "Pegan", "D": "Nalliyakkodan"}, "explanation": "Adiyaman Neduman Anji gifted the miraculous life-prolonging gooseberry to Avvaiyar for the preservation of Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 204, "chapter": null, "section": null, "reference":