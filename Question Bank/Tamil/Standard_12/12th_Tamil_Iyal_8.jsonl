{"id": "12th_tamil_u8_q1528", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "sentence_conversion_iyal8", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மயிலை சீனி. வேங்கடசாமி தமிழ் ஆய்வுலகில் பெரும் புரட்சியை ஏற்படுத்தினார்’ - இதனை வினாத்தொடராக மாற்றுக:", "media_id": null}], "options": {"A": "மயிலை சீனி. வேங்கடசாமி சிறந்த அறிஞர்.", "B": "மயிலை சீனி. வேங்கடசாமி ஆய்வு செய்தார்!", "C": "மயிலை சீனி. வேங்கடசாமி ஆய்வு செய்யவில்லை.", "D": "மயிலை சீனி. வேங்கடசாமி தமிழ் ஆய்வுலகில் பெரும் புரட்சியை ஏற்படுத்தினாரா?"}, "explanation": "செய்தித்தொடரை வினாப்பொருளைத் தரும் வகையில் 'ஆ' என்னும் வினா உருபு சேர்த்து அமைப்பதே சரியான வினாத்தொடராகும்."}, "en": {"blocks": [{"type": "text", "content": "Convert the declarative statement 'Mayilai Seeni. Venkatasamy triggered a revolution in Tamil research' into an interrogative sentence:", "media_id": null}], "options": {"A": "Mayilai Seeni. Venkatasamy was a great scholar.", "B": "Mayilai Seeni. Venkatasamy researched!", "C": "Mayilai Seeni. Venkatasamy did not conduct research.", "D": "Did Mayilai Seeni. Venkatasamy trigger a revolution in Tamil research?"}, "explanation": "Appending the interrogative suffix creates the proper interrogative sentence form."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "so