{"id": "12th_tamil_u8_q1502", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kuriyeedu_grammar", "chapter_id": null, "topic_id": "ship_voyage_life", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘புயலில் ஆடும் கப்பல்’ என்னும் குறியீடு நவீன இலக்கியத்தில் எதனை உணர்த்துகிறது?", "media_id": null}], "options": {"A": "சுற்றுலாப் பயணத்தின் இன்பம்", "B": "துன்பங்களும் நெருக்கடிகளும் நிறைந்த மனித வாழ்வின் நிலையற்ற போராட்டமும், துணிச்சலான பயணமும்", "C": "மீன்பிடித் தொழில்", "D": "கடல் வணிக ஒப்பந்தம்"}, "explanation": "புயலில் சிக்கும் கப்பல் என்பது சவால்களும் ஆபத்துகளும் நிறைந்த மனிதனின் வாழ்க்கை ஓட்டத்திற்கும் அவனது விடாமுயற்சிக்கும் குறியீடாகும்."}, "en": {"blocks": [{"type": "text", "content": "What does the symbol 'A ship weathering a tempest' represent in existential literature?", "media_id": null}], "options": {"A": "Pleasure tourist cruise", "B": "Precarious human existential struggle, endurance, and navigation through crisis-ridden life", "C": "Commercial fisheries", "D": "Maritime trade pacts"}, "explanation": "The storm-tossed vessel symbolizes the precarious journey of human life navigating trials."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation",