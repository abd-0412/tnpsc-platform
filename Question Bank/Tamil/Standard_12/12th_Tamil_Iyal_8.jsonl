{"id": "12th_tamil_u8_q1483", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kodai_mazhai", "chapter_id": null, "topic_id": "compassion_virtue", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கோடை மழை’ சிறுகதை சுட்டிக்காட்டும் உண்மையான செல்வம் எது?", "media_id": null}], "options": {"A": "வங்கி இருப்பு", "B": "மாளிகைகள்", "C": "சக மனிதரின் துயர் துடைக்கும் ஈரநெஞ்சம் (அன்பு)", "D": "விலைமதிப்பற்ற நகைகள்"}, "explanation": "‘அன்புடையார் என்பும் உரியர் பிறர்க்கு’ என்பது போலப் பிறருக்கு உதவும் இரக்கமுள்ள ஈரநெஞ்சமே மனிதனின் உண்மையான செல்வம் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes true, authentic wealth according to 'Kodai Mazhai'?", "media_id": null}], "options": {"A": "Bank deposit balances", "B": "Palatial mansions", "C": "A compassionate heart that melts to alleviate fellow human suffering", "D": "Priceless gem jewelry"}, "explanation": "True wealth is a compassionate heart that rushes to relieve human adversity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 208, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 208", "url": null