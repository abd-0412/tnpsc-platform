{"id": "12th_tamil_u8_q1402", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mugam_sukanthi", "chapter_id": null, "topic_id": "kavithai_collections", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுகந்தி சுப்பிரமணியனின் கவிதைகள் எந்தெந்தத் தலைப்புகளில் கவிதைத் தொகுப்புகளாக வெளிவந்துள்ளன?", "media_id": null}], "options": {"A": "சூரிய வம்சம், இரண்டாவது பிறவி", "B": "புதையுண்ட வாழ்க்கை, மீண்டெழும் கோடுகள்", "C": "நெருஞ்சி, காகிதச் சிறகுகள்", "D": "நிலவுப் பூ, ஒளிப்பறவை"}, "explanation": "சுகந்தி சுப்பிரமணியனின் படைப்புகள் 'புதையுண்ட வாழ்க்கை', 'மீண்டெழும் கோடுகள்' ஆகிய இரு கவிதைத் தொகுப்புகளாக வெளிவந்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Under which titles were the anthologized poetry collections of Suganthi Subramanian published?", "media_id": null}], "options": {"A": "Sooriya Vamsam, Irandavadhu Piravi", "B": "Pudhaiyunda Vaazhkkai, Meendelum Kodugal", "C": "Nerunji, Kaagidhach Chiragugal", "D": "Nilavup Poo, Oloop Paravai"}, "explanation": "Her evocative poetic volumes were titled 'Pudhaiyunda Vaazhkkai' and 'Meendelum Kodugal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "202