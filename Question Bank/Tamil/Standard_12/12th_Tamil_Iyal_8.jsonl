{"id": "12th_tamil_u8_q1533", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "mayangoli_sol_iyal8", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பொருள் வேறுபாடு அறிக: ‘அரி’ - ‘அரி’", "media_id": null}], "options": {"A": "நெல் கதிர் (திருமால் / அரிவாள்) - அறுத்தல் / அரித்தல்", "B": "காற்று - நீர்", "C": "பூமி - வானம்", "D": "சூரியன் - சந்திரன்"}, "explanation": "'அரி' (சின்ன ரி) என்றால் நெற்கதிர், திருமால், சிங்கம் என்று பொருள்; 'அரி' என்பது அரிவாளால் அறுத்தல், தானியங்களைச் சலித்து அரித்தல் போன்ற வினைகளையும் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "Distinguish the semantic meaning of the homophone 'Ari' across contexts.", "media_id": null}], "options": {"A": "Paddy sheaf / Vishnu / Sieve - To harvest / To slice / To sift", "B": "Wind - Water", "C": "Earth - Sky", "D": "Sun - Moon"}, "explanation": "'Ari' encompasses meanings such as paddy ear, Lord Vishnu, and the action of harvesting or sifting."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 205, "chapter": null, "section": null, "reference": "12th Tami