{"id": "12th_tamil_u8_q1410", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ratchanya_yathirigam", "chapter_id": null, "topic_id": "serial_publication", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரட்சணிய யாத்திரிகம் முதன்முதலில் எந்த மாத இதழில் 13 ஆண்டுகள் தொடராக வெளிவந்தது?", "media_id": null}], "options": {"A": "ஞானசூரியன்", "B": "நற்போதகம்", "C": "அமிர்தவசனி", "D": "தத்துவபோதினி"}, "explanation": "கிறித்தவ மாத இதழான 'நற்போதகம்' இதழில் 1878 முதல் 13 ஆண்டுகள் இரட்சணிய யாத்திரிகம் தொடர்ந்து வெளிவந்து பின்னர் 1894-இல் நூலாக வெளியிடப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "In which Christian periodical was Ratchanya Yaathirigam serially published over a span of 13 years?", "media_id": null}], "options": {"A": "Gnanasooriyan", "B": "Narpodhagam", "C": "Amirthavasani", "D": "Thathuvabodhini"}, "explanation": "It was published serially in the monthly journal 'Narpodhagam' for 13 years before being printed as a book in 1894."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 201, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 201", "url": null,