{"id": "12th_tamil_u8_q1393", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "marainthupona_authors", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மறைந்துபோன தமிழ் நூல்கள்’ என்ற நூலில் மயிலையார் மீட்டெடுத்த நூல்களுள் பொருந்தாதது எது?", "media_id": null}], "options": {"A": "கம்பராமாயணம்", "B": "தகடூர் யாத்திரை", "C": "குண்டலகேசி (கிடைத்த பாடல்கள்)", "D": "வளையாபதி (கிடைத்த பாடல்கள்)"}, "explanation": "கம்பராமாயணம் அழியாமல் முழுமையாக உள்ள பெருங்காப்பியமாகும்; தகடூர் யாத்திரை, குண்டலகேசி, வளையாபதி முதலான மறைந்துபோன நூல்களின் சுவடுகளையே அவர் திரட்டினார்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following books is NOT among the lost/partially lost works compiled in 'Maraindhupona Thamizh Noolgal'?", "media_id": null}], "options": {"A": "Kamba Ramayanam (Fully extant epic)", "B": "Tagadur Yaathirai", "C": "Kundalakesi (Surviving verses)", "D": "Valaiyapathi (Surviving verses)"}, "explanation": "Kamba Ramayanam is a completely extant epic, whereas Tagadur Yaathirai, Kundalakesi, and Valaiyapathi were lost texts reconstructed by him."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corp