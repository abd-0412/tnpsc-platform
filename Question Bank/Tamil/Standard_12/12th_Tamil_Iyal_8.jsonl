{"id": "12th_tamil_u8_q1386", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "tamil_nattu_varalaaru", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்நாடு அரசு அமைத்த தமிழ்நாடு வரலாற்றுப் பேரவையின் கீழ் மயிலையார் எழுதிய தொகுதி எது?", "media_id": null}], "options": {"A": "சேரர் வரலாறு", "B": "பல்லவர் வரலாறு", "C": "நாயக்கர் வரலாறு", "D": "மராட்டியர் வரலாறு"}, "explanation": "தமிழ்நாடு வரலாற்றுக் குழு வெளியிட்ட தொகுதிகளுள் 'பல்லவர் வரலாறு' எழுதும் பொறுப்பு மயிலை சீனி. வேங்கடசாமியிடம் ஒப்படைக்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which volume was entrusted to Mayilai Seeni. Venkatasamy under the Tamil Nadu History Congress series?", "media_id": null}], "options": {"A": "History of Cheras", "B": "History of the Pallavas", "C": "History of the Nayaks", "D": "History of the Marathas"}, "explanation": "He was officially invited by the Government of Tamil Nadu to draft the definitive volume on 'History of the Pallavas'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 195, "chapter": null, "section": null, "