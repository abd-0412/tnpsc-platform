{"id": "12th_tamil_u8_q1378", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "sasana_seyyul_manjari", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கல்வெட்டுகளில் காணப்படும் செய்யுள் நயமிக்க தமிழ்ப் பாடல்களைத் தொகுத்து ‘சாசனச் செய்யுள் மஞ்சரி’ என்ற நூலை எந்த ஆண்டு வெளியிட்டார்?", "media_id": null}], "options": {"A": "1930", "B": "1940", "C": "1950", "D": "1960"}, "explanation": "கல்வெட்டுகளில் உள்ள வரலாற்றுச் செய்யுள்களை ஆராய்ந்து 'சாசனச் செய்யுள் மஞ்சரி' என்ற அரிய நூலை 1940-இல் மயிலையார் வெளியிட்டார்."}, "en": {"blocks": [{"type": "text", "content": "In which year did Mayilai Seeni. Venkatasamy publish 'Sasana Seyyul Manjari' compiling poetic epigraphs?", "media_id": null}], "options": {"A": "1930", "B": "1940", "C": "1950", "D": "1960"}, "explanation": "He published 'Sasana Seyyul Manjari' in 1940, compiling verses found across stone and copper inscriptions."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 195, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 195", "url": null, "source_notes": null},