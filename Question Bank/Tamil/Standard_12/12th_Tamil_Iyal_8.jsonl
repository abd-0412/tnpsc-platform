{"id": "12th_tamil_u8_q1532", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "valimigaa_idangal_vinaiyechcham", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மென்தொடர்க் குற்றியலுகர வினையெச்சத்தின் பின் வல்லினம் மிகாது என்பதற்குரிய சரியான சான்று எது?", "media_id": null}], "options": {"A": "படித்துப் பார்த்தான் (வன்தொடர்)", "B": "தேடிச் சென்றான் (இகர ஈறு)", "C": "ஓடிப் போனான் (இகர ஈறு)", "D": "வந்து சேர்ந்தான் (மென்தொடர்க் குற்றியலுகரம்)"}, "explanation": "‘வந்து’ என்பது மென்தொடர்க் குற்றியலுகர வினையெச்சம். இதன் பின் வல்லினம் மிகாது (எ.கா. வந்து சேர்ந்தான்)."}, "en": {"blocks": [{"type": "text", "content": "Which option correctly exemplifies that plosives do NOT double following a soft-series (Menthodar) kurriyalugaram participle?", "media_id": null}], "options": {"A": "Padiththup paarththaan (Hard series)", "B": "Thedich chendraan (Participle in 'i')", "C": "Odip ponaan (Participle in 'i')", "D": "Vanthu serndhaan (Soft series Kurriyalugaram)"}, "explanation": "Following soft-series (Menthodark kurriyalugaram) participles like 'Vanthu', plosives do not double."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Co