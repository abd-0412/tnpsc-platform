{"id": "12th_tamil_u8_q1452", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sirubanaatruppadai", "chapter_id": null, "topic_id": "nalliyakkodan_hospitality_treat", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நல்லியக்கோடனிடம் செல்லும் பாணர்களுக்குக் கிடைக்கும் பரிசில்களாகப் பாடல் குறிப்பிடுவது எவை?", "media_id": null}], "options": {"A": "கற்களும் களிமண்ணும்", "B": "பழைய துணிகள்", "C": "மண்பாண்டங்கள்", "D": "பொன்னால் செய்த தாமரை மலர், முத்து மாலைகள், கொழுத்த யானைகள் மற்றும் அணிகலன்கள்"}, "explanation": "நல்லியக்கோடன் வறிய பாணர்களின் வறுமையைப் போக்கிப் பொற்றாமரை சூட்டி, யானைகளையும் வண்டிகளையும் பரிசாக அள்ளித் தருவான்."}, "en": {"blocks": [{"type": "text", "content": "What lavish rewards await destitute musicians entering the gates of Nalliyakkodan?", "media_id": null}], "options": {"A": "Stones and clay", "B": "Worn-out clothes", "C": "Earthen pots", "D": "Golden lotus ornaments (Potraamarai), pearls, caparisoned elephants, and royal attire"}, "explanation": "He festoons them with golden lotus coronets, pearl chains, fine raiment, and royal tusker elephants."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edit