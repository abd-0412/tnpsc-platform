{"id": "12th_tamil_u8_q1456", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sirubanaatruppadai", "chapter_id": null, "topic_id": "ethical_legacy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிறுபாணாற்றுப்படை உணர்த்தும் உன்னதமான மானுடப் பண்பாடு எது?", "media_id": null}], "options": {"A": "செல்வத்தை ஒளித்து வைத்தல்", "B": "போரிட்டு பிற நாட்டை அழித்தல்", "C": "வறியோரைப் புறக்கணித்தல்", "D": "மனிதநேயமும், கலைகளைப் போற்றுதலும், தன்னிடம் உள்ளதைப் பிறருக்குக் கொடுத்து மகிழும் ஈகை அறமும்"}, "explanation": "எளிய கலைஞர்களை ஆதரித்தலும், பிற உயிர்களிடத்தும் கருணை காட்டி ஈத்துவக்கும் மாண்புமே சிறுபாணாற்றுப்படையின் மையச் செய்தியாகும்."}, "en": {"blocks": [{"type": "text", "content": "What sublime cultural virtue is immortalized in Sirubanaatruppadai for posterity?", "media_id": null}], "options": {"A": "Hoarding wealth secretly", "B": "Waging aggressive warfare", "C": "Disdaining the impoverished", "D": "Humanitarianism, patronizing fine arts, and joy in sharing one's wealth with the needy"}, "explanation": "The timeless message of Sirubanaatruppadai is unconditional hospitality, empathy for all life, and selfless charity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services