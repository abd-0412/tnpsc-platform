{"id": "12th_tamil_u8_q1529", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mozhippayirchi_iyal8", "chapter_id": null, "topic_id": "glossary_allegory_def", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘Allegory’ என்ற இலக்கிய உத்திக்கு இணையான தமிழ்ச் சொல் எது?", "media_id": null}], "options": {"A": "உருவகக்கதை (மறைபொருள் புனைவு)", "B": "வரலாற்றுக் கதை", "C": "துப்பறியும் கதை", "D": "அறிவியல் புதினம்"}, "explanation": "'Allegory' என்பது மேலோட்டமான கதையினூடே ஆழ்ந்த தத்துவார்த்த அல்லது தார்மீக உட்கருத்தை மறைபொருளாக உணர்த்தும் 'உருவகக்கதை' ஆகும் (எ.கா. இரட்சணிய யாத்திரிகம்)."}, "en": {"blocks": [{"type": "text", "content": "What is the Tamil literary equivalent for the term 'Allegory'?", "media_id": null}], "options": {"A": "Allegory (Uruvakkakkathai)", "B": "Historical tale", "C": "Detective fiction", "D": "Science fiction"}, "explanation": "'Allegory' translates into Tamil as 'உருவகக்கதை' (symbolic narrative with dual layers of meaning)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 213, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 213", "url": null, "sou