{"id": "12th_tamil_u8_q1411", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ratchanya_yathirigam", "chapter_id": null, "topic_id": "kristu_siluvai_paadu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "12-ஆம் வகுப்புப் பாடப்பகுதியில் இடம்பெற்றுள்ள இரட்சணிய யாத்திரிகப் பாடல் இயேசு பெருமானின் எந்த நிகழ்வை விவரிக்கிறது?", "media_id": null}], "options": {"A": "இயேசுவின் பிறப்பு", "B": "கடல் மீது நடத்தல்", "C": "சிலுவைப்பாடுகள் (கொல்கொதா மலையில் இயேசு பட்ட கொடிய துயரங்களும் பெருங்கருணையும்)", "D": "விண்ணேற்றம்"}, "explanation": "இயேசு பெருமான் மக்களின் பாவங்களுக்காகக் கொல்கொதா மலையில் முள்முடி சூட்டப்பட்டு, சிலுவை சுமந்து சிந்திய இரத்தமும் இன்னல்களும் பாடப்பகுதியில் வந்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Which poignant event in the life of Jesus Christ is depicted in the Class 12 excerpt of Ratchanya Yaathirigam?", "media_id": null}], "options": {"A": "The Nativity of Jesus", "B": "Walking upon the sea", "C": "The Passion of Christ (Crucifixion agony and divine compassion on Mount Golgotha)", "D": "The Ascension"}, "explanation": "The textbook verses depict the Passion, crowning of thorns, bearing the cross, and crucifixion of Jesus Christ."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": 