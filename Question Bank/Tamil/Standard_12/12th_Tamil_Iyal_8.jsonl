{"id": "12th_tamil_u8_q1405", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ratchanya_yathirigam", "chapter_id": null, "topic_id": "pilgrims_progress", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘இரட்சணிய யாத்திரிகம்’ என்னும் காப்பியம் ஜான் பன்யன் (John Bunyan) ஆங்கிலத்தில் எழுதிய எந்த நூலின் தழுவலாகும்?", "media_id": null}], "options": {"A": "The Pilgrim's Progress", "B": "Paradise Lost", "C": "The Divine Comedy", "D": "The Holy War"}, "explanation": "ஜான் பன்யன் எழுதிய 'The Pilgrim's Progress' என்னும் உருவகப் புதினத்தை தழுவி, தமிழ்க் காப்பிய மரபில் எச்.ஏ. கிருஷ்ணபிள்ளை இரட்சணிய யாத்திரிகத்தை இயற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "'Ratchanya Yaathirigam' is a grand Tamil epic adaptation of which English classic by John Bunyan?", "media_id": null}], "options": {"A": "The Pilgrim's Progress", "B": "Paradise Lost", "C": "The Divine Comedy", "D": "The Holy War"}, "explanation": "It is an epic poetic transcreation of John Bunyan's world-famous allegorical work 'The Pilgrim's Progress'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 199, "chapter": null, "s