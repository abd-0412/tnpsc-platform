{"id": "12th_tamil_u8_q1436", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sirubanaatruppadai", "chapter_id": null, "topic_id": "aay_podhigai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘நீலநாகம் அளித்த அருமையான ஆடையை சிவபெருமானின் ஆலமர் செல்வனுக்கு அணிவித்து மகிழ்ந்த பொதியமலை வள்ளல்’ யார்?", "media_id": null}], "options": {"A": "நள்ளி", "B": "பாரி", "C": "அதியன்", "D": "ஆய் அண்டிரன்"}, "explanation": "பொதியமலைத் தலைவனான ஆய் அண்டிரன், நீலநாகம் தந்த ஒளி பொருந்திய அரிய ஆடையைத் தான் அணியாமல் சிவபெருமானுக்கு அணிவித்து மகிழ்ந்தான்."}, "en": {"blocks": [{"type": "text", "content": "Which chieftain of the Pothigai hills presented a radiant celestial robe bestowed by a blue serpent to Lord Shiva?", "media_id": null}], "options": {"A": "Nalli", "B": "Pari", "C": "Athiyan", "D": "Aay Andiran"}, "explanation": "Aay Andiran of Pothigai hills dedicated the celestial blue serpent garment to Lord Shiva under the banyan tree."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 204, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 204", "url": null, "source_notes": null}