{"id": "12th_tamil_u8_q1478", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kodai_mazhai", "chapter_id": null, "topic_id": "compassion_symbolism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கோடை மழை பொழிந்தது... பூமி குளிர்ந்தது... மனங்களும் குளிர்ந்தன’ - இத்தொடர் உணர்த்தும் உட்கருத்து யாது?", "media_id": null}], "options": {"A": "குளிர்சாதனப் பெட்டியின் செயல்பாடு", "B": "புற உலக இயற்கையின் மாற்றமும், அக உலக மனங்களின் இரக்க மாற்றமும் ஒருங்கே நிகழ்ந்தமை", "C": "பனிக்காலத்தின் தொடக்கம்", "D": "மழைக்கால நோய்கள் பரவுதல்"}, "explanation": "வெப்பம் தணிந்து மண் குளிர்ந்த அதே வேளையில், மனிதர்களின் மன வறட்சியும் தணிந்து அன்புத் தளிர் பூத்தது என்பதை உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "'The summer rain showered... the earth cooled... and human hearts were soothed' - What does this phrase express?", "media_id": null}], "options": {"A": "Air conditioner cooling", "B": "Simultaneous physical transformation of the outer natural environment and emotional rejuvenation of human consciousness", "C": "Onset of arctic winter", "D": "Spread of seasonal ailments"}, "explanation": "The physical cooling of the earth poetically coincides with the soothing of human suffering through empathy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "