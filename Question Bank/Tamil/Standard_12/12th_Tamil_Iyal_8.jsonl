{"id": "12th_tamil_u8_q1415", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ratchanya_yathirigam", "chapter_id": null, "topic_id": "john_bunyan_imprisonment", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘The Pilgrim's Progress’ நூலை எழுதிய ஜான் பன்யன் எந்த நாட்டைச் சேர்ந்தவர்?", "media_id": null}], "options": {"A": "அமெரிக்கா", "B": "பிரான்ஸ்", "C": "இங்கிலாந்து", "D": "ஜெர்மனி"}, "explanation": "ஜான் பன்யன் 17-ஆம் நூற்றாண்டில் இங்கிலாந்தில் பெட்ஃபோர்டு சிறையில் அடைக்கப்பட்டிருந்த காலத்தில் இந்நூலை எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "Which country did John Bunyan, the original author of 'The Pilgrim's Progress', belong to?", "media_id": null}], "options": {"A": "United States", "B": "France", "C": "England", "D": "Germany"}, "explanation": "John Bunyan was an English preacher and author who penned 'The Pilgrim's Progress' while imprisoned in Bedford jail."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 199, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 199", "url": null, "source_notes": null}, "previous_year": {"is_previous_y