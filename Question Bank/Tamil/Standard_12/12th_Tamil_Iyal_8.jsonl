{"id": "1400", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "centenary_celebration", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயிலை சீனி. வேங்கடசாமியின் நூற்றாண்டு விழா எந்த ஆண்டு தமிழக அறிஞர் பெருமக்களால் சிறப்பாகக் கொண்டாடப்பட்டது?", "media_id": null}], "options": {"A": "1980", "B": "1990", "C": "2005", "D": "2000"}, "explanation": "1900-இல் பிறந்த மயிலை சீனி. வேங்கடசாமியின் நூற்றாண்டு நிறைவு விழா 2000-ஆம் ஆண்டு தமிழ் அறிஞர் பெருமக்களால் நாடெங்கும் கொண்டாடப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "In which year was the birth centenary of Mayilai Seeni. Venkatasamy commemorated across Tamil Nadu?", "media_id": null}], "options": {"A": "1980", "B": "1990", "C": "2005", "D": "2000"}, "explanation": "His birth centenary was celebrated with scholarly seminars and tributes in the year 2000."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 196, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 196", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam