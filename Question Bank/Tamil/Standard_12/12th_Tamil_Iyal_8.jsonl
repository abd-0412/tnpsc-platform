{"id": "12th_tamil_u8_q1568", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "tnpsc_model_iyal8", "chapter_id": null, "topic_id": "tnpsc_pyq_iyal8_grand_synthesis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC Group 1 2021] ‘எல்லைகள் ஆயிரம் இருப்பினும் அனைத்தையும் இணைப்பது மனிதநேயமும் அறமுமே’ - 12-ஆம் வகுப்பு பொதுத்தமிழ் பாடத்தின் இறுதி இயல் (இயல் 8) உணர்த்தும் முழுமையான உட்கருத்து யாது?", "media_id": null}], "options": {"A": "பழைய நூல்களை மட்டுமே படிப்பது", "B": "அயல்நாட்டு இலக்கியங்களை நிராகரிப்பது", "C": "சமூக பேதங்களைப் பாதுகாப்பது", "D": "இலக்கியம், வரலாறு, கலைகள், தியாகம், ஈகை மற்றும் குறியீடுகள் வழியாக மாந்தநேயக் கூட்டுப் பண்பாட்டை வளர்த்து உலகளாவிய மனித ஒற்றுமையை நிலைநாட்டுதல்"}, "explanation": "இயல் 8 மயிலையாரின் ஆய்வு, கிறித்தவக் கம்பரின் தியாகம், வள்ளல்களின் ஈகை, பெண்களின் சுயமரியாதை, குறியீட்டு நயம் ஆகியவற்றின் வழி மானுட ஒருமைப்பாட்டை நிலைநிறுத்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Group 1 2021] 'Though divided by a thousand boundaries, humanity is unified by love and ethics' - What is the synoptic synthesis of Unit 8?", "media_id": null}], "options": {"A": "Reading ancient palm leaves exclusively", "B": "Rejecting foreign classics outright", "C": "Preserving caste and feudal divides", "D": "Cultivating universal humanist solidarity, artistic integrity, female agency, redemptive empathy, and selfless benevolence across all artificial boundaries"}, "explanation": "Unit 8 synthesizes selfless scholarship, redemptive empathy, philanthropic charity, female dignity, and universal love uniting humanity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 213, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 213", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 8", "TNPSC PYQ", "Grand Synthesis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
