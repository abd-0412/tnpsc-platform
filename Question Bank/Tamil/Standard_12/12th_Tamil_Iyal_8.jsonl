{"id": "12th_tamil_u8_q1373", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "author_title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இருளடைந்த தமிழ் வரலாற்றின் பக்கங்களை வெளிச்சத்திற்குத் கொண்டுவந்து ‘நமது அடையாளங்களை மீட்டவர்’ என்று போற்றப்படும் தலைசிறந்த தமிழறிஞர் யார்?", "media_id": null}], "options": {"A": "மயிலை சீனி. வேங்கடசாமி", "B": "உ.வே. சாமிநாதையர்", "C": "சி.வை. தாமோதரம்பிள்ளை", "D": "மறைமலையடிகள்"}, "explanation": "தமிழ் மொழியின் சமயம், கலை, வரலாறு, கல்வெட்டியல் ஆகிய துறைகளில் மறைந்துபோன உண்மைகளை வெளிக்கொணர்ந்தவர் மயிலை சீனி. வேங்கடசாமி ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who is the eminent Tamil scholar acclaimed as 'The Restorer of Our Identities' for illuminating forgotten chapters of Tamil history?", "media_id": null}], "options": {"A": "Mayilai Seeni. Venkatasamy", "B": "U.V. Swaminatha Iyer", "C": "C.W. Damodaram Pillai", "D": "Maraimalai Adigal"}, "explanation": "Mayilai Seeni. Venkatasamy pioneered rediscovering lost aspects of ancient Tamil arts, religions, and history."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "fu