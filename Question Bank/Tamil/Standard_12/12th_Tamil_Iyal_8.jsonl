{"id": "12th_tamil_u8_q1485", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kuriyeedu_grammar", "chapter_id": null, "topic_id": "definition_symbol", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தான் கூறவந்த ஒரு கருத்தை நேரடியாகக் கூறாமல், வேறொரு பொருளின் மூலமாக உணர்த்தும் இலக்கிய உத்தி’ எது?", "media_id": null}], "options": {"A": "குறியீடு (Symbol)", "B": "படிமம் (Image)", "C": "தொன்மம் (Myth)", "D": "அங்கதம் (Satire)"}, "explanation": "ஒரு குறிப்பிட்ட கருத்தை மறைமுகமாக உணர்த்தி ஆழமான பொருளைத் தரும் அடையாள உத்திக்கு இலக்கியத்தில் 'குறியீடு' (Symbol) என்று பெயர்."}, "en": {"blocks": [{"type": "text", "content": "What is the literary device called where an idea is communicated indirectly through a concrete representative sign rather than direct statement?", "media_id": null}], "options": {"A": "Symbol (Kuriyeedu)", "B": "Image (Padimam)", "C": "Myth (Thonmam)", "D": "Satire (Angatham)"}, "explanation": "A 'Symbol' (குறியீடு) conveys an abstract concept or emotional truth indirectly through a tangible representative sign."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 209, "chapter"