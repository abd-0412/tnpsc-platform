{"id": "12th_tamil_u8_q1442", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sirubanaatruppadai", "chapter_id": null, "topic_id": "sirubanan_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சிறுபாணன்’ என்பவர் கையில் ஏந்தி இசைக்கும் யாழ் எது?", "media_id": null}], "options": {"A": "பேரியாழ்", "B": "சீறியாழ் (சிறிய யாழ்)", "C": "மகரயாழ்", "D": "சகோடயாழ்"}, "explanation": "சீறியாழை மீட்டிப் பாடும் பாணன் 'சிறுபாணன்' எனப்படுவான்; பேரியாழை மீட்டும் பாணன் 'பெரும்பாணன்' எனப்படுவான்."}, "en": {"blocks": [{"type": "text", "content": "Which specific stringed harp (Yaazh) was carried and played by a 'Sirubanan'?", "media_id": null}], "options": {"A": "Periyaazh (Grand 21-string harp)", "B": "Seeriyaazh (Little 7-string harp)", "C": "Makarayaazh", "D": "Sakodayaazh"}, "explanation": "A Sirubanan played the delicate small lute called 'Seeriyaazh', whereas a Perumbanan wielded the grand 'Periyaazh'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 202, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 202", "url": null, "source_notes": null}, "previous_year": {"is_