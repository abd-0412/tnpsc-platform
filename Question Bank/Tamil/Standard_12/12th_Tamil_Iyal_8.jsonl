{"id": "12th_tamil_u8_q1416", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ratchanya_yathirigam", "chapter_id": null, "topic_id": "conversion_vaishnavism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எச்.ஏ. கிருஷ்ணபிள்ளை கிறித்தவ மதத்தைத் தழுவுவதற்கு முன்பாக எந்தச் சமய மரபில் தீவிரப் புலமை பெற்றிருந்தார்?", "media_id": null}], "options": {"A": "சமணம்", "B": "பௌத்தம்", "C": "இசுலாம்", "D": "வைணவம்"}, "explanation": "இவர் தொடக்கத்தில் வைணவ சமயத்தில் ஆழ்ந்த ஈடுபாடும் கம்பராமாயணத்தில் இணையற்ற புலமையும் பெற்றிருந்தார். பின்னர் கிறித்தவத்தைத் தழுவினார்."}, "en": {"blocks": [{"type": "text", "content": "In which religious literary tradition did H.A. Krishna Pillai possess profound mastery prior to embracing Christianity?", "media_id": null}], "options": {"A": "Jainism", "B": "Buddhism", "C": "Islam", "D": "Vaishnavism"}, "explanation": "He was originally steeped in Sri Vaishnavism and Kamba Ramayanam before converting to Christianity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 201, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 201", "url": null, "sour