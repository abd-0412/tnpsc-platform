{"id": "12th_tamil_mp2_q1873", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "grammar_poetics_masterclass", "chapter_id": null, "topic_id": "punarchi_thee_vallinam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தீ + சுடர்’ என்பது புணர்ச்சியில் எவ்வாறு அமையும்?", "media_id": null}], "options": {"A": "தீச்சுடர் (வல்லினம் மிகுதல்)", "B": "தீசுடர்", "C": "தீஞ்சுடன்", "D": "தீஞ்சுடர்"}, "explanation": "ஓரெழுத்து ஒருமொழியான 'தீ' என்னும் சொல்லின் முன் வல்லினம் வரின் மிகும் (தீ + சுடர் = தீச்சுடர்)."}, "en": {"blocks": [{"type": "text", "content": "Under Tamil sandhi rules, how does the monosyllabic noun 'Thee' combine with 'Sudar'?", "media_id": null}], "options": {"A": "Theeccudar (plosive gemination)", "B": "Theesudar", "C": "Theenchudan", "D": "Theenchudar"}, "explanation": "Monosyllabic base words like 'Thee' duplicate following hard plosives (k, c, t, p) -> Theeccudar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 43, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 43", "url": null, "source_notes": null}, "previous_year": {"is_previous_year