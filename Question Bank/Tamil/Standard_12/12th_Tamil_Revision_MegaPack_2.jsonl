{"id": "12th_tamil_mp2_q1813", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "padimam_uvamai_distinction", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'உவமை என்பது ஒப்புமையைக் காட்டுகிறது; படிமம் என்பது எதனைக் காட்டுகிறது?'", "media_id": null}], "options": {"A": "காட்சியை அல்லது உருவத்தை மனத்தில் வரைகிறது", "B": "இலக்கண விதியை விளக்குகிறது", "C": "சொல் நயத்தை மட்டும் உருவாக்குகிறது", "D": "வரலாற்று உண்மைகளை மறைக்கிறது"}, "explanation": "உவமை ஒப்புமையைக் காட்டிப் பொருளை விளக்குகிறது; படிமம் என்பது ஒரு கருத்தையோ உணர்வையோ மனக்கண் முன் காட்சியாகச் செதுக்கிக் காட்டுகிறது."}, "en": {"blocks": [{"type": "text", "content": "'Simile presents a comparison; what does poetic Imagery (Padimam) distinctly present?'", "media_id": null}], "options": {"A": "It sketches a vivid sensory image or picture in the mind", "B": "It explains grammatical morphology", "C": "It produces mere phonetic alliteration", "D": "It conceals historical facts"}, "explanation": "Imagery projects concrete sensory pictures directly onto the reader's mental canvas."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term