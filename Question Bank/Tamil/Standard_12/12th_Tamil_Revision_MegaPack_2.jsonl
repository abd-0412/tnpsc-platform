{"id": "12th_tamil_mp2_q1780", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "voc_books_published", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கப்பலோட்டிய தமிழர் வ.உ.சிதம்பரனார் இயற்றிய உரைநடை நூல்கள் எவை?", "media_id": null}], "options": {"A": "தாய், சேய்", "B": "குடும்ப விளக்கு, இருண்ட வீடு", "C": "பாஞ்சாலி சபதம், கண்ணன் பாட்டு", "D": "மெய்யறிவு, மெய்யறம்"}, "explanation": "வ.உ.சிதம்பரனார் 'மெய்யறிவு', 'மெய்யறம்' ஆகிய அரிய அறநூல்களை இயற்றியதுடன் திருக்குறளுக்கு மணக்குடவர் உரையையும் பதிப்பித்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which notable ethical books were authored by V.O. Chidambaranar?", "media_id": null}], "options": {"A": "Thaai, Sei", "B": "Kudumba Vilakku, Irunda Veedu", "C": "Panchali Sabatham, Kannan Paattu", "D": "Meiyyarivu, Meiyyaram"}, "explanation": "V.O. Chidambaranar authored 'Meiyyarivu' and 'Meiyyaram', and edited Manakkudavar's commentary on Thirukkural."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 103, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2,