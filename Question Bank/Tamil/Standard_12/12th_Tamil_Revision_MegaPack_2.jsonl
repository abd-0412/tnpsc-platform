{"id": "12th_tamil_mp2_q1837", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "sirupanattruppadai_yazh", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிறுபாணாற்றுப்படையில் பாணன் மீட்டிய யாழ் எந்த வகையைச் சேர்ந்தது?", "media_id": null}], "options": {"A": "செங்கோட்டுச் சீறியாழ்", "B": "பேரியாழ் (21 நரம்புகள்)", "C": "சகோடயாழ் (14 நரம்புகள்)", "D": "மகரயாழ் (19 நரம்புகள்)"}, "explanation": "சிறுபாணன் கையில் ஏந்தி இசைத்தது செங்கோட்டுச் சீறியாழ் ஆகும்; பேரியாழ் மீட்டுபவன் பெரும்பாணன் எனப்படுவான்."}, "en": {"blocks": [{"type": "text", "content": "Which specific stringed instrument was played by the minstrel in Sirupanattruppadai?", "media_id": null}], "options": {"A": "Sengottu Seeriyazh (Small Harp)", "B": "Periyazh (21-stringed Grand Harp)", "C": "Sakodayazh (14-stringed Harp)", "D": "Makarayazh (19-stringed Dolphin Harp)"}, "explanation": "The minstrel in Sirupanattruppadai held and plucked the Sengottu Seeriyazh (compact harp)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 165, "chapter": null, "section": null, "reference": "12th