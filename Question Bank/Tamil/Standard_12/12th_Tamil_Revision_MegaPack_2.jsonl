{"id": "12th_tamil_mp2_q1946", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "meyppattiyal_ilakkiya_payanpadu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘இழிவரல்’ என்னும் மெய்ப்பாட்டிற்குப் பொருத்தமான இலக்கியக் காட்சி எது?", "media_id": null}], "options": {"A": "இராமனின் வில்லாற்றலைக் கண்டு வியப்பது", "B": "தன் உடல் தளர்ந்து மூப்பும் நோயும் அடைந்த நிலையை எண்ணி முதியவர் வருந்துவது", "C": "போர்க்களத்தில் பகைவரை வென்று ஆர்ப்பரிப்பது", "D": "அரங்கில் மாதவி நடனமாடுவது"}, "explanation": "மூப்பு, பிணி, மென்மை ஆகியவற்றால் தனக்கு ஏற்படும் இயலாமையையும் தாழ்வுநிலையையும் கண்டு இரங்குவது இளிவரல் மெய்ப்பாடாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which textual scenario accurately embodies the aesthetic emotion 'Ilivaral' (pathos / self-pity / abjection)?", "media_id": null}], "options": {"A": "Astonishment witnessing Rama stringing the bow", "B": "An elder lamenting their decrepitude, bodily infirmity, and helplessness", "C": "Warriors cheering their battlefield triumph", "D": "Madhavi performing at the royal theater"}, "explanation": "Lamenting physical infirmity, decrepitude, and abject helplessness perfectly manifests Ilivaral."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "T