{"id": "12th_tamil_mp2_q1953", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "purananooru_kakkai_padiniyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "விருந்தினர் வருவதைக் காக்கை கரைந்து முன்னறிவித்தது எனப் பாடியதால் 'காக்கைப் பாடினியார்' என்று பெயர் பெற்ற சங்கப் புலவர் யார்?", "media_id": null}], "options": {"A": "நச்செள்ளையார்", "B": "ஔவையார்", "C": "வெள்ளிவீதியார்", "D": "பூங்கணுத்திரையார்"}, "explanation": "காக்கை கரைந்து விருந்தினர் வரவை அறிவிக்கும் பண்பினை நயம்படப் பாடியதால் நச்செள்ளையார் 'காக்கைப் பாடினியார் நச்செள்ளையார்' என அழைக்கப்பட்டார்."}, "en": {"blocks": [{"type": "text", "content": "Which Sangam poetess acquired the epithet 'Kakkaip Paadiniyar' for her verse celebrating a crow heralding a guest's arrival?", "media_id": null}], "options": {"A": "Nachellaiyar", "B": "Avvaiyar", "C": "Velliveethiyar", "D": "Poonganutthiraiyar"}, "explanation": "Nachellaiyar was bestowed the honorific 'Kakkaip Paadiniyar' for her song on the crow heralding guests."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 153, "ch