{"id": "12th_tamil_mp2_q1815", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "kalithogai_prosody", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எட்டுத்தொகை நூல்களுள் கலிப்பாவால் இயற்றப்பட்டு, நாடகப் பாங்கில் உரையாடல் வடிவில் அமைந்த நூல் எது?", "media_id": null}], "options": {"A": "நற்றிணை", "B": "குறுந்தொகை", "C": "கலித்தொகை", "D": "பதிற்றுப்பத்து"}, "explanation": "கலித்தொகை துள்ளல் ஓசை கொண்ட கலிப்பாவால் ஆன நூல்; இது காதல் உணர்வுகளையும் ஒழுக்கப் பண்புகளையும் நாடகப் பாங்கில் சித்திரிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "Among the Ettuthogai anthologies, which work is composed entirely in Kali meter with dramatic dialogues?", "media_id": null}], "options": {"A": "Natrinai", "B": "Kurunthogai", "C": "Kalithogai", "D": "Pathitrupathu"}, "explanation": "Kalithogai is composed in bouncy Kali meter and structured as dramatic dialogues depicting Sangam landscapes."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 154, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 154", "url": n