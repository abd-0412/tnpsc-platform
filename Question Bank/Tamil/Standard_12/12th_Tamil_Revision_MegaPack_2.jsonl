{"id": "12th_tamil_mp2_q1768", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "agananooru_palai_numbers", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அகநானூற்றில் பாலைத்திணைப் பாடல்கள் எந்தெந்த எண்களாகத் தொகுக்கப்பட்டுள்ளன?", "media_id": null}], "options": {"A": "2, 8, 12, 18 என முடியும் எண்கள்", "B": "4, 14, 24, 34 என முடியும் எண்கள்", "C": "10, 20, 30, 40 என முடியும் எண்கள்", "D": "1, 3, 5, 7, 9 என வரும் ஒற்றைப்படை எண்கள்"}, "explanation": "அகநானூற்றில் 1, 3, 5, 7 முதலிய ஒற்றைப்படை எண்களைக் கொண்ட 200 பாடல்களும் பாலைத்திணைப் பாடல்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "In Agananooru, which verse numbers represent Palai Thinai songs?", "media_id": null}], "options": {"A": "Numbers ending in 2, 8, 12, 18", "B": "Numbers ending in 4, 14, 24, 34", "C": "Numbers ending in 10, 20, 30, 40", "D": "Odd numbers such as 1, 3, 5, 7, 9"}, "explanation": "In Agananooru, 200 odd-numbered songs (1, 3, 5, 7...) belong exclusively to Palai Thinai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 112, "chapter": null, "secti