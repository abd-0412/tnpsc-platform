{"id": "12th_tamil_mp2_q1844", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "sirupanattruppadai_author_lineage", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிறுபாணாற்றுப்படையை இயற்றிய இடைக்கழிநாட்டு நல்லூர் நத்தத்தனார் வாழ்ந்த பகுதி எது?", "media_id": null}], "options": {"A": "கொங்கு நாடு", "B": "பாண்டிய நாடு", "C": "சோழ நாடு", "D": "தொண்டை நாடு (இடைக்கழிநாடு)"}, "explanation": "நத்தத்தனார் தொண்டை நாட்டுக்குட்பட்ட இடைக்கழிநாட்டு நல்லூர் என்னும் ஊரில் வாழ்ந்த சங்கப் புலவராவார்."}, "en": {"blocks": [{"type": "text", "content": "To which ancient geographical region did Nallur Nathathanar, the composer of Sirupanattruppadai, belong?", "media_id": null}], "options": {"A": "Kongu Nadu", "B": "Pandiya Nadu", "C": "Chola Nadu", "D": "Thondai Nadu (Idaikkazhinadu)"}, "explanation": "Nallur Nathathanar resided in Idaikkazhinadu Nallur within ancient Thondai Nadu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 165, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 165", "url": null, "source_notes": n