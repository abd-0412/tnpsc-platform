{"id": "12th_tamil_mp2_q1940", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "silappathikaram_author_heritage", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரத்தை இயற்றிய இளங்கோவடிகள் எந்த அரச மரபைச் சேர்ந்தவர்?", "media_id": null}], "options": {"A": "பாண்டிய மரபு", "B": "சோழ மரபு", "C": "பல்லவ மரபு", "D": "சேர மரபு (சேரன் செங்குட்டுவனின் தம்பி)"}, "explanation": "இளங்கோவடிகள் சேர மன்னன் இமயவரம்பன் நெடுஞ்சேரலாதனின் மகனும், சேரன் செங்குட்டுவனின் தம்பியும் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "To which royal lineage did Ilango Adigal, the author of Silappathikaram, belong?", "media_id": null}], "options": {"A": "Pandya royal dynasty", "B": "Chola royal dynasty", "C": "Pallava royal dynasty", "D": "Chera royal dynasty (younger brother of Cheran Senguttuvan)"}, "explanation": "Ilango Adigal was a Chera royal prince, brother of Cheran Senguttuvan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 128, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 128", "url": n