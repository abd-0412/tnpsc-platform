{"id": "12th_tamil_mp2_q1811", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "sculpture_unesco_monuments", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாமல்லபுரக் கடற்கரைக் கோயில் வளாகம் எந்த ஆண்டில் யுனெஸ்கோ (UNESCO) உலகப் பாரம்பரியக் களமாக அறிவிக்கப்பட்டது?", "media_id": null}], "options": {"A": "1972", "B": "1980", "C": "1984", "D": "1992"}, "explanation": "மாமல்லபுரத்தின் வரலாற்றுச் சிறப்புமிக்க பாறைச் சிற்பங்களும் கோயில்களும் 1984 ஆம் ஆண்டு யுனெஸ்கோ அமைப்பால் உலகப் பாரம்பரியச் சின்னமாக ஏற்கப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "In which year were the rock-cut monuments at Mamallapuram inscribed as a UNESCO World Heritage Site?", "media_id": null}], "options": {"A": "1972", "B": "1980", "C": "1984", "D": "1992"}, "explanation": "Mamallapuram monuments were recognized as a UNESCO World Heritage Site in 1984."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 124, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 124", "url": null, "source_notes": null}, "previous_year": {"