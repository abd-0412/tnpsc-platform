{"id": "12th_tamil_mp2_q1833", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "mayilai_seeni_religions_trio", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயிலை சீனி. வேங்கடசாமி சமய வரலாற்று ஆய்வில் இயற்றிய முப்பெரும் நூல்கள் எவை?", "media_id": null}], "options": {"A": "பௌத்தமும் தமிழும், சமணமும் தமிழும், கிறித்தவமும் தமிழும்", "B": "சைவமும் தமிழும், வைணவமும் தமிழும், சாக்தமும் தமிழும்", "C": "வேதமும் தமிழும், ஆகமமும் தமிழும், புராணமும் தமிழும்", "D": "இஸ்லாமும் தமிழும், பௌத்தமும் தமிழும், காப்பியமும் தமிழும்"}, "explanation": "மயிலை சீனி. வேங்கடசாமி 'பௌத்தமும் தமிழும்', 'சமணமும் தமிழும்', 'கிறித்தவமும் தமிழும்' ஆகிய மூன்று நூல்களையும் வரலாற்று நோக்கில் எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "Which famous trio of religious history monographs did Mayilai Seeni. Venkatasamy author?", "media_id": null}], "options": {"A": "Bouddhamum Thamizhum, Samanamum Thamizhum, Kirithavamum Thamizhum", "B": "Saivamum Thamizhum, Vainavamum Thamizhum, Sakthamum Thamizhum", "C": "Vedhamum Thamizhum, Aagamamum Thamizhum, Puranamum Thamizhum", "D": "Islamum Thamizhum, Bouddhamum Thamizhum, Kappiyamum Thamizhum"}, "explanation": "Mayilai Seeni. Venkatasamy authored the historic religious trilogy: Buddhism, Jainism, and Christianity in Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "