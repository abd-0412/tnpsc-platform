{"id": "12th_tamil_mp2_q1958", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "padimam_modern_criticism_kailasapathy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழில் 'ஒப்பியல் இலக்கியம்', 'தமிழ் நாவல் இலக்கியம்' உள்ளிட்ட திறனாய்வு நூல்களை எழுதிய ஈழத்து மார்க்சியத் தமிழறிஞர் யார்?", "media_id": null}], "options": {"A": "கா. சிவத்தம்பி", "B": "க. கைலாசபதி", "C": "மு. வரதராசனார்", "D": "தெ.பொ. மீனாட்சிசுந்தரனார்"}, "explanation": "பேராசிரியர் க. கைலாசபதி தமிழ் இலக்கியத் திறனாய்வில் அறிவியல் பூர்வமான சமூகவியல் மற்றும் ஒப்பீட்டு ஆய்வு முறைகளை அறிமுகப்படுத்திய முன்னோடி அறிஞராவார்."}, "en": {"blocks": [{"type": "text", "content": "Which pioneering Marxist Tamil critic from Sri Lanka authored monumental critical treatises like 'Oppiyal Ilakkiyam'?", "media_id": null}], "options": {"A": "K. Sivathamby", "B": "K. Kailasapathy", "C": "Mu. Varadarajanar", "D": "T.P. Meenakshisundaranar"}, "explanation": "Prof. K. Kailasapathy pioneered socio-historical and comparative methodologies in modern Tamil literary criticism."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 114", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 7", "Tamil Literary Criticism"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp2_q1959", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "thirukkural_sengonmai_kodiya", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கொலையிற் கொடியாரை வேந்துஒறுத்தல் பைங்கூழ் களைகட் டதனோடு நேர்’ - இதில் கொடியவர்களை மன்னன் தண்டிப்பது எதற்கு ஒப்பிடப்படுகிறது?", "media_id": null}], "options": {"A": "காட்டை அழிப்பதற்கு", "B": "மழையைப் பொழிவிப்பதற்கு", "C": "பயிரைக் காக்கக் களையெடுப்பதற்கு நேர்", "D": "கல்லில் சிற்பம் செதுக்குவதற்கு"}, "explanation": "வளரும் நெற்பயிரைக் காப்பாற்றக் களைகளைப் பிடுங்கி எறிவது போல, சமுதாயத்தில் உள்ள நல்ல மக்களைக் காக்கக் கொடிய குற்றவாளிகளைத் தண்டிப்பது அரசின் கடமை என்கிறார் வள்ளுவர்."}, "en": {"blocks": [{"type": "text", "content": "'Kolaiyir kodiyaarai vendhorutthal paingoozh kalaikat dadhanodu ner' - To what agricultural practice does Valluvar compare capital punishment of vicious felons?", "media_id": null}], "options": {"A": "Clearing dense forests", "B": "Seeding rain clouds", "C": "Weeding out noxious weeds (Kalaiedutthal) to protect tender green crops", "D": "Carving idols out of stone"}, "explanation": "Punishing unrepentant violent criminals is compared to pulling out noxious weeds to safeguard healthy crops."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 175, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 175", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 7", "Thirukkural Penology"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp2_q1960", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "grand_finale_class12_tamil_mastery", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மேல்நிலை இரண்டாம் ஆண்டு (12-ஆம் வகுப்பு) பொதுத்தமிழ் பாடநூல் முழுவதையும் நிறைவு செய்யும் இறுதி வினா:\nதமிழை 'உயர்தனிச் செம்மொழி' என்று முதன்முதலில் நிறுவிய பரிதிமாற்கலைஞரின் இயற்பெயர் யாது?", "media_id": null}], "options": {"A": "வேங்கடரமணன்", "B": "சுப்பிரமணியன்", "C": "கந்தசாமி", "D": "வி.கோ. சூரியநாராயண சாஸ்திரியார்"}, "explanation": "பரிதிமாற்கலைஞரின் இயற்பெயர் வி.கோ. சூரியநாராயண சாஸ்திரியார் ஆகும். இவர் தூய தமிழ்ப் பற்றால் தன் பெயரைப் 'பரிதிமாற்கலைஞர்' என மாற்றிக்கொண்டு தமிழை உயர்தனிச் செம்மொழி என முதன்முதலில் நிறுவினார்."}, "en": {"blocks": [{"type": "text", "content": "Final Question capping the 12th Standard Tamil Grand Master Question Bank:\nWhat was the original personal name of Parithimaar Kalaignar, who first historically established Tamil as an 'Uyar Thani Semmozhi' (Autonomous Classical Language)?", "media_id": null}], "options": {"A": "Venkataramanan", "B": "Subramanian", "C": "Kandasamy", "D": "V.G. Sooryanarayana Sastriar"}, "explanation": "V.G. Sooryanarayana Sastriar adopted the pure Tamil name 'Parithimaar Kalaignar' and pioneered the recognition of Tamil as a classical language."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 180, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 180", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 7", "Grand Finale Parithimaar Kalaignar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
