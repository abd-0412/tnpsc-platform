{"id": "12th_tamil_mp2_q1794", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "governance_thirukkural_amaichu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வள்ளுவர் அமைச்சு அதிகாரத்தில் ஒரு சிறந்த அமைச்சருக்குரிய இன்றியமையாத ஐந்து குணங்களாக எவற்றைக் குறிப்பிடுகிறார்?", "media_id": null}], "options": {"A": "வலி, காலம், இடம், தொழில், பொருள்", "B": "இயற்கை அறிவு, செயற்கை அறிவு, விடாமுயற்சி, அமைதி, துணிவு", "C": "அறம், பொருள், இன்பம், வீடு, புகழ்", "D": "அன்பு, அறிவு, வீரம், செல்வம், கொடை"}, "explanation": "'கருவியும் காலமும் செய்கையும் செய்யும் அருவினையும் மாண்ட தமைச்சு' மற்றும் அமைச்சருக்குரிய அறிவாற்றலையும் வள்ளுவர் சிறப்பித்துக் கூறுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Which qualities does Valluvar emphasize for an exceptional minister in the 'Amaichu' chapter of Thirukkural?", "media_id": null}], "options": {"A": "Power, time, territory, enterprise, wealth", "B": "Inherent intellect, acquired knowledge, relentless perseverance, composure, courage", "C": "Virtue, wealth, love, liberation, fame", "D": "Affection, intelligence, courage, affluence, charity"}, "explanation": "Thiruvalluvar underscores native wisdom, deep learning, decisive action, and perseverance as ministerial essentials."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_mul