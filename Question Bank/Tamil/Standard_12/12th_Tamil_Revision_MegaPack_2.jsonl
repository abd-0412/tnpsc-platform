{"id": "12th_tamil_mp2_q1952", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "silappathikaram_three_truths", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரம் உணர்த்தும் முப்பெரும் உண்மைகளுள் பொருந்தாதது எது?", "media_id": null}], "options": {"A": "அரசியல் பிழைத்தோர்க்கு அறங்கூற்றாவதூஉம்", "B": "உரைசால் பத்தினியை உயர்ந்தோர் ஏத்துவதூஉம்", "C": "ஊழ்வினை உருத்துவந்து ஊட்டும் என்பதூஉம்", "D": "செல்வமே உலகில் தலைசிறந்தது என்பதூஉம்"}, "explanation": "சிலப்பதிகாரப் பதிகம் உணர்த்தும் மூன்று உண்மைகள்: (1) அரசியல் பிழைத்தோர்க்கு அறங்கூற்றாவது, (2) பத்தினியை உயர்ந்தோர் ஏத்துவது, (3) ஊழ்வினை வந்து ஊட்டுவது ஆகும். செல்வம் பற்றியது இதில் இல்லை."}, "en": {"blocks": [{"type": "text", "content": "Which of the following is NOT one of the three foundational moral maxims proclaimed in the prologue of Silappathikaram?", "media_id": null}], "options": {"A": "Dharma becomes the lethal retribution for monarchs who err in justice", "B": "The virtuous chaste wife is universally worshipped by the noble", "C": "Inexorable Karma pursues and relentlessly bears fruit", "D": "Material wealth is supreme above all worldly virtues"}, "explanation": "Silappathikaram's threefold maxims are: justice avenges unjust rulers, chaste wives are venerated, and karma takes its toll."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, 