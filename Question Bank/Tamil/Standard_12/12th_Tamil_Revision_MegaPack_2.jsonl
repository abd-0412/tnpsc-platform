{"id": "12th_tamil_mp2_q1806", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "mu_va_epistolary_literature", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் மொழியின் இனிமையையும் பண்பாட்டையும் விளக்கும் 'தம்பிக்கு', 'தங்கைக்கு' என்னும் கடித இலக்கியங்களை எழுதிய அறிஞர் யார்?", "media_id": null}], "options": {"A": "திரு. வி. கலியாணசுந்தரனார்", "B": "டாக்டர் மு. வரதராசனார் (மு.வ.)", "C": "பேரறிஞர் அண்ணா", "D": "ரா.பி. சேதுப்பிள்ளை"}, "explanation": "மு.வ. அவர்கள் இளைஞர்களுக்கும் பெண்களுக்கும் அறிவுரைகளும் மொழிப்பற்றும் ஊட்டும் வண்ணம் 'தம்பிக்கு', 'தங்கைக்கு' என்ற கடித நூல்களை எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "Which eminent scholar authored the celebrated epistolary works 'Thambikku' and 'Thangaikku'?", "media_id": null}], "options": {"A": "Thiru. V. Kalyanasundaranar", "B": "Dr. Mu. Varadarajanar (Mu.Va)", "C": "Perarignar Anna", "D": "R.P. Sethu Pillai"}, "explanation": "Dr. M. Varadarajanar penned the inspiring epistolary essays 'Thambikku' and 'Thangaikku'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "