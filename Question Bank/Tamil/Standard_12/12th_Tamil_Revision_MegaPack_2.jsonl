{"id": "12th_tamil_mp2_q1868", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "grammar_poetics_masterclass", "chapter_id": null, "topic_id": "thonmam_modern_poets", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியார் பாஞ்சாலி சபதத்தில் பாஞ்சாலியை எதன் தொன்மக் குறியீடாகப் படைத்துள்ளார்?", "media_id": null}], "options": {"A": "செல்வத்தின் குறியீடு", "B": "இயற்கையின் குறியீடு", "C": "கல்வியின் குறியீடு", "D": "அடிமைப்பட்ட பாரத அன்னையின் குறியீடு"}, "explanation": "பாரதியார் மகாபாரதப் பாஞ்சாலியை ஆங்கிலேயரின் ஆட்சியில் அடிமைப்பட்டுக் கிடந்த பாரத மாதாவின் உருவகத் தொன்மமாகப் படைத்துப் புரட்சித் தீயை மூட்டினார்."}, "en": {"blocks": [{"type": "text", "content": "In Panchali Sabatham, Mahakavi Bharati used Draupadi (Panchali) as a mythical archetype symbolizing?", "media_id": null}], "options": {"A": "Symbol of wealth", "B": "Symbol of nature", "C": "Symbol of education", "D": "Enslaved Mother India suffering under British colonial subjugation"}, "explanation": "Bharati revitalized the epic archetype of Draupadi to represent enslaved Mother India fighting for emancipation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_