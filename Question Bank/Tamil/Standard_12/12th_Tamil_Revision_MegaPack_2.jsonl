{"id": "12th_tamil_mp2_q1950", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "thirukkural_kannottam_nectar_noble", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வள்ளுவர் கூறும் நாகரிகம் உடைய சான்றோர்கள் எதனைத் தமக்குத் தரினும் புன்னகையோடு ஏற்பர்?", "media_id": null}], "options": {"A": "அமுதத்தை", "B": "நஞ்சை (விஷத்தை)", "C": "பழத்தை", "D": "பாலை"}, "explanation": "'பெயக்கண்டும் நஞ்சுண்டு அமைவர் நயத்தக்க நாகரிகம் வேண்டு பவர்' - நஞ்சையே எதிரில் இட்டாலும் கண்ணோட்டம் உடைய சான்றோர் மறுக்காமல் உண்பர்."}, "en": {"blocks": [{"type": "text", "content": "What will noble civilized individuals consume with serene grace according to Valluvar's ethic of Kannottam?", "media_id": null}], "options": {"A": "Ambrosia", "B": "Poison (Nanchu)", "C": "Sweet fruit", "D": "Fresh milk"}, "explanation": "Cultured persons imbued with graceful empathy will accept even deadly poison knowingly."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 176, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 176", "url": null, "s