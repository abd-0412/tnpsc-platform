{"id": "12th_tamil_mp2_q1856", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "grammar_poetics_masterclass", "chapter_id": null, "topic_id": "ani_ilakkanam_niralnirai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சொல்லையும் பொருளையும் வரிசையாக நிறுத்தி நேரே பொருள் கொள்வது’ எந்த அணி எனப்படும்?", "media_id": null}], "options": {"A": "வேற்றுமை அணி", "B": "தற்குறிப்பேற்ற அணி", "C": "வஞ்சப்புகழ்ச்சி அணி", "D": "நிரல்நிறை அணி"}, "explanation": "சொற்களையும் அவற்றின் பொருள்களையும் நேர் வரிசையாக நிறுத்திப் பொருள் கொள்வது நிரல்நிறை அணி எனப்படும் (நிரல் = வரிசை, நிறை = நிறுத்துதல்)."}, "en": {"blocks": [{"type": "text", "content": "'Arranging words and their corresponding meanings in direct parallel sequences' defines which figure of speech?", "media_id": null}], "options": {"A": "Vetttrumai Ani", "B": "Tharkurippetra Ani", "C": "Vanchappugazhchi Ani", "D": "Niralnirai Ani (Parallel Series)"}, "explanation": "Niralnirai Ani places nouns and their actions in aligned parallel matching order."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 134, "chapter": null, "section": null, "referenc