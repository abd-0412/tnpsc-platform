{"id": "12th_tamil_mp2_q1888", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_uzhavu_freedom", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உழுதுண்டு வாழ்வாரே வாழ்வார்மற் றெல்லாம் தொழுதுண்டு பின்செல் பவர்’ - இதில் உழவர்களின் எந்தப் பெருமை போற்றப்படுகிறது?", "media_id": null}], "options": {"A": "அவர்களது உடற்பயிற்சி", "B": "அவர்களது எளிய வாழ்க்கை", "C": "அவர்களது கல்வி", "D": "யாருக்கும் அடிமையாகாமல் தலைநிமிர்ந்து வாழும் தற்சார்பும் விடுதலையும்"}, "explanation": "உழவு செய்து உணவை உற்பத்தி செய்து வாழ்பவரே சுதந்திரமாக வாழ்பவர்; மற்றவர்கள் அனைவரும் அவர்களைத் தொழுது பின்செல்லும் சார்பு வாழ்க்கை வாழ்கின்றனர்."}, "en": {"blocks": [{"type": "text", "content": "'Uludhundu vaazhvaare vaazhvaarmat rellaam...' - What supreme sovereign virtue of farmers is extolled here?", "media_id": null}], "options": {"A": "Their physical fitness", "B": "Their rustic simplicity", "C": "Their formal literacy", "D": "Their self-reliant freedom and dignity, while others dependently follow them"}, "explanation": "Farming represents true sovereign self-reliance; all other professions survive dependently bowing to food producers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 176, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 176", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 5", "Thirukkural Agriculture"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
