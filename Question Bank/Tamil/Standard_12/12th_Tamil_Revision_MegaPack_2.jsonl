{"id": "12th_tamil_mp2_q1886", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_arivudaimai_armor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அறிவற்றங் காக்கும் கருவி செறுவார்க்கும் உள்ளழிக்க லாகா அரண்’ - இதில் அழிவு வராமல் காக்கும் கருவியாக வள்ளுவர் எதனைக் கூறுகிறார்?", "media_id": null}], "options": {"A": "வாள் மற்றும் கேடயம்", "B": "அறிவு", "C": "செல்வம்", "D": "நட்பு"}, "explanation": "அறிவு என்பது அழிவு வராமல் காக்கும் பாதுகாப்புக் கருவியாகும்; பகைவராலும் அழிக்க முடியாத சிறந்த கோட்டை போன்ற அரணாகும்."}, "en": {"blocks": [{"type": "text", "content": "'Arivatrang kaakkum karuvi...' - What does Valluvar identify as the ultimate weapon that guards against destruction?", "media_id": null}], "options": {"A": "Sword and shield", "B": "Arivu (True Wisdom/Intellect)", "C": "Material wealth", "D": "Loyal friends"}, "explanation": "Wisdom is an inner protective weapon against ruin and an impregnable fortress against adversaries."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 175, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 175", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 5", "Thirukkural Wisdom"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp2_q1887", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_kannottam_nectar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பெயக்கண்டும் நஞ்சுண்டு அமைவர் நயத்தக்க நாகரிகம் வேண்டு பவர்’ - இக்குறள் உணர்த்தும் உயரிய பண்பு எது?", "media_id": null}], "options": {"A": "வீரம்", "B": "கல்வி", "C": "கண்ணோட்டம் (பிறர் நலம் கருதி நஞ்சையும் உண்ணும் பண்பட்ட நாகரிகம்)", "D": "செல்வச் செருக்கு"}, "explanation": "பிறர் தமக்கு நஞ்சே தருகிறார் எனத் தெரிந்தும், அவரிடம் உள்ள அன்பினாலும் முகதாட்சணியத்தினாலும் அதனை உண்டு அமைதி காப்பது சான்றோரின் நாகரிகப் பண்பாகும்."}, "en": {"blocks": [{"type": "text", "content": "'Peyakkandum nanjundu amaivar...' - What sublime virtue of courteous benignity is exalted in this verse?", "media_id": null}], "options": {"A": "Martial valor", "B": "Erudition", "C": "Kannottam (Graceful civil forbearance even when offered poison knowingly)", "D": "Arrogance of riches"}, "explanation": "Noble souls who cherish courteous empathy will gracefully partake even poison offered knowingly, preserving relations."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpor