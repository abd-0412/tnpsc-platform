{"id": "12th_tamil_mp2_q1802", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "sculpture_monolithic_rathas", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாமல்லபுரத்தில் அமைந்துள்ள ஒற்றைக்கல் இரதங்களின் எண்ணிக்கை யாது?", "media_id": null}], "options": {"A": "மூன்று இரதங்கள்", "B": "ஐந்து இரதங்கள் (பஞ்சபாண்டவர் இரதம்)", "C": "ஏழு இரதங்கள்", "D": "ஒன்பது இரதங்கள்"}, "explanation": "மாமல்லபுரத்தில் ஒரே பாறையில் செதுக்கப்பட்ட ஐந்து தனித்தனி இரதக் கோயில்கள் உள்ளதால் இவை 'பஞ்சபாண்டவர் இரதங்கள்' என அழைக்கப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "How many monolithic rock-cut rathas are located together at Mamallapuram?", "media_id": null}], "options": {"A": "Three Rathas", "B": "Five Rathas (Pancha Pandava Rathas)", "C": "Seven Rathas", "D": "Nine Rathas"}, "explanation": "Mamallapuram features five monolithic rock shrines collectively known as the Pancha Pandava Rathas."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 124, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 124", "ur