{"id": "12th_tamil_mp2_q1783", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "theivamanimaalai_metaphor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஒருமையுடன் நினது திருமலரடி நினைக்கின்ற உத்தமர்தம் உறவு வேண்டும்' - என்று பாடியவர் யார்?", "media_id": null}], "options": {"A": "பாரதியார்", "B": "தாயுமானவர்", "C": "இராமலிங்க அடிகளார்", "D": "பட்டினத்தார்"}, "explanation": "இவ்வரி தெய்வமணிமாலையில் வள்ளலார் கந்தக்கோட்ட முருகனை நோக்கிப் பாடிய உலகப் புகழ்பெற்ற பாடல் வரியாகும்."}, "en": {"blocks": [{"type": "text", "content": "'Orumaiyudan ninadhu thirumalaradi ninaikkinra utthamardham uravu vendum' - Who sang this verse?", "media_id": null}], "options": {"A": "Subramania Bharati", "B": "Thayumanavar", "C": "Ramalinga Adigal (Vallalar)", "D": "Pattinathar"}, "explanation": "This famous prayer verse is from Ramalinga Adigal's Theivamanimaalai at Kandhakottam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 105, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 105", "url": null, "source_notes": null