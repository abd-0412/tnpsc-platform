{"id": "12th_tamil_mp2_q1785", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "sculpture_somaskandar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பல்லவர் காலக் குடைவரைக் கோயில்களின் பின்பக்கச் சுவரில் தவறாமல் இடம்பெறும் புடைப்புச் சிற்பம் எது?", "media_id": null}], "options": {"A": "சோமாஸ்கந்தர் சிற்பம் (சிவன், உமை, முருகன்)", "B": "நடராஜர் நடனச் சிற்பம்", "C": "அர்த்தநாரீசுவரர் சிற்பம்", "D": "கஜலட்சுமி சிற்பம்"}, "explanation": "பல்லவர் காலக் குடைவரைக் கோயில்களில் கருவறையின் பின்பக்கச் சுவரில் சிவன், பார்வதி, குழந்தையாக முருகன் உள்ள சோமாஸ்கந்தர் புடைப்புச் சிற்பம் செதுக்கப்படுவது தனி மரபாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which bas-relief panel consistently graces the back sanctuary wall of Pallava cave temples?", "media_id": null}], "options": {"A": "Somaskanda panel (Siva, Uma, and infant Murugan)", "B": "Nataraja dance panel", "C": "Ardhanariswara panel", "D": "Gajalakshmi panel"}, "explanation": "Pallava cave sanctums typically feature the Somaskanda bas-relief carving behind the Lingam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_