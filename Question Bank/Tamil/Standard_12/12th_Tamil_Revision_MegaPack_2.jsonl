{"id": "12th_tamil_mp2_q1775", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "thevaram_poompavai_incident", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருஞானசம்பந்தர் மயிலையில் சாம்பலாக இருந்த யாரை உயிர்ப்பித்து எழுப்பினார்?", "media_id": null}], "options": {"A": "காரைக்கால் அம்மையாரை", "B": "மங்கையர்க்கரசியாரை", "C": "சிவனேசனின் மகள் பூம்பாவையை", "D": "திலகவதியாரை"}, "explanation": "மயிலாப்பூரில் பாம்பு கடித்து இறந்த வணிகன் சிவநேசரின் மகள் பூம்பாவையின் எலும்புக் குடத்திலிருந்து அவளைத் திருஞானசம்பந்தர் உயிர்ப்பித்தார்."}, "en": {"blocks": [{"type": "text", "content": "Whom did Thirugnanasambandar miraculously resurrect from ashes at Mylapore Kapaleeshwarar temple?", "media_id": null}], "options": {"A": "Karaikkal Ammaiyar", "B": "Mangayarkkarasiyar", "C": "Poompavai, daughter of merchant Sivanesan", "D": "Thilagavathiyar"}, "explanation": "Thirugnanasambandar miraculously restored Sivanesan's deceased daughter Poompavai back to life through his Thevaram hymn."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 108, "chapter":