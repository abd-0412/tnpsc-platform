{"id": "12th_tamil_mp2_q1951", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "sculpture_granite_heritage", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்நாட்டில் கருங்கற்கள் கொண்டு கட்டப்பட்ட உலகப் புகழ்பெற்ற தஞ்சைப் பெருவுடையார் கோயிலைக் கட்டிய பேரரசர் யார்?", "media_id": null}], "options": {"A": "முதலாம் இராஜேந்திர சோழன்", "B": "இரண்டாம் குலோத்துங்கன்", "C": "முதலாம் இராஜராஜ சோழன்", "D": "சுந்தர சோழன்"}, "explanation": "முதலாம் இராஜராஜ சோழனால் கி.பி. 1010-இல் கட்டி முடிக்கப்பட்ட தஞ்சைப் பெருவுடையார் கோயில் முழுக்கவும் கருங்கற்களால் ஆன திராவிடக் கட்டடக் கலையின் சிகரமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which Chola emperor erected the monumental all-granite Brihadisvara Temple (Peruvudaiyar Koil) at Thanjavur in 1010 CE?", "media_id": null}], "options": {"A": "Rajendra Chola I", "B": "Kulothunga Chola II", "C": "Rajaraja Chola I", "D": "Sundara Chola"}, "explanation": "Rajaraja Chola I commissioned the world-renowned monolithic granite Brihadisvara Temple at Thanjavur."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition"