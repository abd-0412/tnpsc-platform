{"id": "12th_tamil_mp2_q1834", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "ay_andiran_blue_serpent_garment", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நீல நாகம் தனக்கு அளித்த அரிய நச்சிலா ஆடையை ஆலமரத்தின் கீழ் வீற்றிருந்த இறைவனுக்கு அணிவித்து மகிழ்ந்த வள்ளல் யார்?", "media_id": null}], "options": {"A": "பாரி", "B": "ஆய் அண்டிரன்", "C": "காரி", "D": "நள்ளி"}, "explanation": "பொதியமலைப் பகுதியை ஆண்ட ஆய் அண்டிரன், நீலநாகம் தந்த ஒளிவீசும் ஆடையைத் தான் அணியாமல் இறைவனுக்கு அணிவித்து மகிழ்ந்தான்."}, "en": {"blocks": [{"type": "text", "content": "Which chieftain offered the luminous celestial blue snake garment to Lord Shiva beneath the banyan tree?", "media_id": null}], "options": {"A": "Paari", "B": "Aay Andiran", "C": "Kaari", "D": "Nalli"}, "explanation": "Aay Andiran of the Pothigai hills presented the divine radiant serpent robe to Lord Shiva."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 166, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 166", "url": null, "source_notes": null}, "pr