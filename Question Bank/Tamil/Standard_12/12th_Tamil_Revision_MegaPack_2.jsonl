{"id": "12th_tamil_mp2_q1793", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "silappathikaram_dance_types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரத்தில் ஆடப்படும் ஆடல்கள் 'வேத்தியல்', 'பொதுவியல்' என எத்தனை பிரிவுகளாகப் பிரிக்கப்பட்டுள்ளன?", "media_id": null}], "options": {"A": "இரண்டு பிரிவுகள்", "B": "மூன்று பிரிவுகள்", "C": "நான்கு பிரிவுகள்", "D": "ஐந்து பிரிவுகள்"}, "explanation": "அரசவையில் ஆடப்படுவது 'வேத்தியல்' என்றும், பொதுமக்கள் மன்றங்களில் ஆடப்படுவது 'பொதுவியல்' என்றும் இருவகைப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Into how many broad categories were classical dances split in Silappathikaram (Vethiyal and Podhuviyal)?", "media_id": null}], "options": {"A": "Two categories", "B": "Three categories", "C": "Four categories", "D": "Five categories"}, "explanation": "Dances were classified into two streams: Vethiyal (royal court style) and Podhuviyal (popular public style)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 128, "chapter": null, "section": null, "reference": "12th Tamil