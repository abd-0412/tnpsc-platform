{"id": "12th_tamil_mp2_q1825", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "mayilai_seeni_titles", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயிலை சீனி. வேங்கடசாமியின் வாழ்நாள் தமிழ்ப் பணிகளைப் பாராட்டி மதுரைப் பல்கலைக்கழகம் வழங்கிய சிறப்புப் பட்டம் யாது?", "media_id": null}], "options": {"A": "தமிழ்ப் பேரவைச் செம்மல்", "B": "தமிழ்த் தென்றல்", "C": "தமிழ்க்காவலர்", "D": "தமிழ் மாமணி"}, "explanation": "மதுரைப் பல்கலைக்கழகம் மயிலை சீனி. வேங்கடசாமிக்குத் 'தமிழ்ப் பேரவைச் செம்மல்' என்ற மிக உயரிய பட்டத்தை வழங்கிச் சிறப்பித்தது."}, "en": {"blocks": [{"type": "text", "content": "Which prestigious honorific title was conferred upon Mayilai Seeni. Venkatasamy by Madurai Kamaraj University?", "media_id": null}], "options": {"A": "Thamizh Peravai Semmal", "B": "Thamizh Thendral", "C": "Thamizhk Kaavalar", "D": "Thamizh Maamani"}, "explanation": "Madurai University honored Mayilai Seeni. Venkatasamy with the title 'Thamizh Peravai Semmal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "refer