{"id": "12th_tamil_mp2_q1895", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_translations_languages", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறள் உலகில் அதிக மொழிகளில் மொழிபெயர்க்கப்பட்ட நூல்களுள் பைபிளுக்கு அடுத்தபடியாக எத்தனையாவது இடத்தில் உள்ளது?", "media_id": null}], "options": {"A": "முதல் இடம்", "B": "இரண்டாம் இடம்", "C": "மூன்றாம் இடம்", "D": "ஐந்தாம் இடம்"}, "explanation": "உலகப் பொதுமறையான திருக்குறள் உலகின் 107-க்கும் மேற்பட்ட மொழிகளில் மொழிபெயர்க்கப்பட்டு பைபிள், குரான் ஆகியவற்றுக்கு அடுத்தபடியாக உலகளவில் போற்றப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Thirukkural ranks prominently among the most translated books globally, holding which ranking among global ethical treatises?", "media_id": null}], "options": {"A": "First position", "B": "Second position", "C": "Third position (following the Bible and Quran)", "D": "Fifth position"}, "explanation": "Thirukkural is celebrated worldwide, ranking in the top three most translated books in human history."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_