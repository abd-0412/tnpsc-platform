{"id": "12th_tamil_mp2_q1843", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "sukanthi_subramaniyan_anthologies", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுகந்தி சுப்பிரமணியனின் கவிதைத் தொகுப்புகள் எவை?", "media_id": null}], "options": {"A": "சூரிய நிழல், காற்றுவெளி", "B": "நிலவுப்பூ, சிற்பியின் கவிதைகள்", "C": "புதையுண்ட வாழ்க்கை, மீண்டெழும் சுடர்கள்", "D": "மழைக்காலக் குறிப்புகள், நகுலன் கவிதைகள்"}, "explanation": "சுகந்தி சுப்பிரமணியனின் கவிதைகள் 'புதையுண்ட வாழ்க்கை', 'மீண்டெழும் சுடர்கள்' ஆகிய தொகுப்புகளாக வெளிவந்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Which poetry collections were published by feminist poetess Sukanthi Subramaniyan?", "media_id": null}], "options": {"A": "Sooriya Nizhal, Kaattruveli", "B": "Nilavup Poo, Sirpiyin Kavithaigal", "C": "Pudhaiyunda Vaazhkkai, Meendelzhum Sudargal", "D": "Mazhaikkaala Kurippugal, Nakulan Kavithaigal"}, "explanation": "Sukanthi Subramaniyan's poems appeared in 'Pudhaiyunda Vaazhkkai' and 'Meendelzhum Sudargal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "pa