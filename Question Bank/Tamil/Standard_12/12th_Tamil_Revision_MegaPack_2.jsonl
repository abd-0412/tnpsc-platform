{"id": "12th_tamil_mp2_q1819", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "silappathikaram_madhavi_gift_price", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சோழ மன்னன் மாதவிக்குத் தலைக்கோலுடன் பரிசாக வழங்கிய பொற்காசுகளின் (கழஞ்சு) மதிப்பு யாது?", "media_id": null}], "options": {"A": "500 பொற்கழஞ்சுகள்", "B": "800 பொற்கழஞ்சுகள்", "C": "1008 பொற்கழஞ்சுகள்", "D": "2000 பொற்கழஞ்சுகள்"}, "explanation": "மாதவியின் நாட்டியத்தைக் கண்ட மன்னன் அவளுக்கு ஆயிரத்தெட்டு (1008) பொற்கழஞ்சுகளை மாலையாகப் பரிசளித்தான்."}, "en": {"blocks": [{"type": "text", "content": "What was the gold coin valuation (Kalanju) of the royal garland bestowed on Madhavi by the Chola monarch?", "media_id": null}], "options": {"A": "500 gold Kalanju", "B": "800 gold Kalanju", "C": "1008 gold Kalanju", "D": "2000 gold Kalanju"}, "explanation": "The Chola king honored Madhavi with a golden garland valued at exactly 1008 gold Kalanju coins."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 129, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_