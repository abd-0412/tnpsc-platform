{"id": "12th_tamil_mp2_q1955", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "thirukkural_arivudaimai_summary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சென்ற இடத்தால் செலவிடா தீதொரீஇ நன்றின்பால் உய்ப்ப தறிவு’ - இக்குறள் அறிவின் முதன்மையான செயலாக எதனைக் கூறுகிறது?", "media_id": null}], "options": {"A": "செல்வத்தை ஈட்டுவது", "B": "பல ஊர்களுக்குச் செல்வது", "C": "மனம் விரும்பும் தீய வழிகளில் செல்லவிடாமல் தடுத்து நல்வழியில் செலுத்துவது", "D": "பகைவரை அழிப்பது"}, "explanation": "மனம் போன போக்கிலெல்லாம் செல்ல விடாமல், தீமையிலிருந்து விலக்கி நன்மையான நல்வழியில் மனத்தைச் செலுத்துவதே உண்மையான அறிவுடைமையாகும்."}, "en": {"blocks": [{"type": "text", "content": "'Senra idatthaal selavidaa theedhoreei nanrinbaal uyppa dharivu' - What is the cardinal duty of intellect according to this Kural?", "media_id": null}], "options": {"A": "Amassing riches", "B": "Traveling to diverse regions", "C": "Restraining the fickle mind from straying into harmful paths and directing it toward righteous good", "D": "Vanquishing adversaries"}, "explanation": "Intellect must govern the sensory impulses, turning the mind away from evil and steering it towards virtue."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 175, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 175", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 7", "Thirukkural Intellect"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
