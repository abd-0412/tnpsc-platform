{"id": "12th_tamil_mp2_q1769", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "meyppattiyal_eight_emotions", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொல்காப்பியர் குறிப்பிடும் எண்வகை மெய்ப்பாடுகளுள் முதலாவதாக அமைந்த மெய்ப்பாடு எது?", "media_id": null}], "options": {"A": "நகை", "B": "அழுகை", "C": "பெருமிதம்", "D": "வெகுளி"}, "explanation": "'பண்ணைத் தோன்றிய எண்வகைப் பொருளும்' என்று தொடங்கும் தொல்காப்பிய நூற்பாவில் 'நகையே அழுகை இளிவரல் மருட்கை...' என நகை முதலாவதாகக் குறிப்பிடப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Which is the first aesthetic emotion (Meyppadu) listed in Tholkappiyar's Meyppattiyal?", "media_id": null}], "options": {"A": "Nagai (Laughter/Wit)", "B": "Azhugai (Pathos/Sorrow)", "C": "Perumidham (Pride/Heroism)", "D": "Veguli (Wrath/Anger)"}, "explanation": "Tholkappiyar begins the catalog of 8 aesthetic emotions with 'Nagai' (laughter/wit)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 137", "url"