{"id": "12th_tamil_mp2_q1826", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "kadaiyezhu_vallal_kari_region", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கடையேழு வள்ளல்களுள் ஒருவனான 'மலையமான் திருமுடிக் காரி' ஆட்சி செய்த நிலப்பகுதி எது?", "media_id": null}], "options": {"A": "பறம்பு மலை", "B": "மலையமான் நாடு (திருக்கோவலூர்)", "C": "கொல்லி மலை", "D": "தோட்டி மலை"}, "explanation": "மலையமான் திருமுடிக் காரி திருக்கோவலூரைத் தலைநகராகக் கொண்ட மலையமான் நாட்டை ஆண்டு, இரவலர்களுக்குக் குதிரைகளையும் ஊர்களையும் வாரி வழங்கிய வள்ளல்."}, "en": {"blocks": [{"type": "text", "content": "Which territory was ruled by Malaiyaman Thirumudi Kaari, one of the seven great munificent patrons (Kadaiyezhu Vallalgal)?", "media_id": null}], "options": {"A": "Parambu Malai", "B": "Malaiyaman Nadu (Thirukkovaloor)", "C": "Kolli Hills", "D": "Thotti Malai"}, "explanation": "Malaiyaman Thirumudi Kaari governed Malaiyaman Nadu centered at Thirukkovaloor."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 166, "chapter": null, "section": null, "reference": "12th