{"id": "12th_tamil_mp2_q1877", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_arivudaimai_kural", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அறிவுடையார் ஆவ தறிவார் அறிவிலார் அஃதறி கல்லா தவர்’ - இக்குறள் இடம்பெற்றுள்ள அதிகாரம் எது?", "media_id": null}], "options": {"A": "அறிவுடைமை", "B": "கல்வி", "C": "ஒழுக்கமுடைமை", "D": "பெரியாரைத் துணைக்கோடல்"}, "explanation": "வருங்காலத்தில் நிகழப்போவதை முன்கூட்டியே அறிந்து செயல்படுபவரே அறிவுடையவர் என்பதை அறிவுடைமை அதிகாரத்தில் வள்ளுவர் கூறுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "In which chapter of Thirukkural is the verse 'Arivudaiyaar aavadhu arivaar...' featured?", "media_id": null}], "options": {"A": "Arivudaimai (Possession of Wisdom)", "B": "Kalvi (Learning)", "C": "Olukkamudaimai (Good Character)", "D": "Periyaraith Thunaikkodal (Associating with Great Men)"}, "explanation": "This verse defining the discerning foresight of the wise belongs to chapter 'Arivudaimai'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 175, "chapter": null, "s