{"id": "12th_tamil_mp2_q1824", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "kuriyedu_symbol_definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கியத்தில் ஓர் அருவமான கருத்தை அல்லது உணர்வை உருவப் பொருளின் வழியாக வெளிப்படுத்தும் உத்தி எது?", "media_id": null}], "options": {"A": "எதுகை", "B": "மோனை", "C": "இயைபு", "D": "குறியீடு (Symbol)"}, "explanation": "குறியீடு என்பது வெளிப்படையாகச் சொல்லாமல் ஒரு காட்சி அல்லது பொருளின் வாயிலாக ஆழ்ந்த கருத்தை உணர்த்தும் அழகியல் உத்தியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which aesthetic literary device communicates abstract concepts or sentiments through concrete physical objects?", "media_id": null}], "options": {"A": "Edhugai (Rhyme)", "B": "Monai (Alliteration)", "C": "Iyaibu (End rhyme)", "D": "Kuriyedu (Symbol)"}, "explanation": "Kuriyedu (Symbolism) channels deep abstract philosophical or emotive meanings through tangible motifs."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 172, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_