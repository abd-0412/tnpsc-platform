{"id": "12th_tamil_mp2_q1821", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "mayilai_seeni_buddhism_research", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயிலை சீனி. வேங்கடசாமி எழுதிய ஆய்வு நூல்களுள் தமிழகத்தில் பௌத்த மதம் நிலவிய வரலாற்றை விளக்கும் நூல் எது?", "media_id": null}], "options": {"A": "பௌத்தமும் தமிழும்", "B": "சமணமும் தமிழும்", "C": "கிறித்தவமும் தமிழும்", "D": "இறை கோட்பாடும் தமிழும்"}, "explanation": "மயிலை சீனி. வேங்கடசாமி 'பௌத்தமும் தமிழும்' என்ற புகழ்பெற்ற வரலாற்று ஆய்வு நூலை எழுதி மறைந்துபோன பௌத்தச் சான்றுகளை வெளிக்கொணர்ந்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which pioneering research work by Mayilai Seeni. Venkatasamy systematically documented Buddhism's historic presence in Tamil Nadu?", "media_id": null}], "options": {"A": "Bouddhamum Thamizhum", "B": "Samanamum Thamizhum", "C": "Kirithavamum Thamizhum", "D": "Irai Kotpaadum Thamizhum"}, "explanation": "Mayilai Seeni. Venkatasamy authored the landmark historical treatise 'Bouddhamum Thamizhum'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025"