{"id": "12th_tamil_mp2_q1807", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "silappathikaram_shiva_dances", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரத்தில் சிவபெருமான் திரிபுரத்தை எரித்தபோது ஆடிய கூத்தாகக் கூறப்படுவது எது?", "media_id": null}], "options": {"A": "அல்லியம்", "B": "பாண்டரங்கம்", "C": "கொடுகொட்டி", "D": "மரக்கால் கூத்து"}, "explanation": "சிவபெருமான் முப்புரங்களை எரித்த பின்னர் கைகொட்டி ஆடிய கூத்து 'கொடுகொட்டி' என்றும், சாம்பல் நிறைந்த களத்தில் ஆடியது 'பாண்டரங்கம்' என்றும் அழைக்கப்படும்."}, "en": {"blocks": [{"type": "text", "content": "In Silappathikaram, which dance did Lord Shiva perform clapping his hands after incinerating the three demon cities (Tripura)?", "media_id": null}], "options": {"A": "Alliyam", "B": "Pandarangam", "C": "Kodukotti", "D": "Marakkal Koothu"}, "explanation": "Lord Shiva danced the ferocious celebratory 'Kodukotti' dance upon the destruction of Tripura."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 130, "chapter": null, "section": null, "reference": "12th Tamil, Unit meg