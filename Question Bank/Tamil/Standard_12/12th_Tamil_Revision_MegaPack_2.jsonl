{"id": "12th_tamil_mp2_q1854", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "grammar_poetics_masterclass", "chapter_id": null, "topic_id": "porul_mayakkam_spacing", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பொருள் மயக்கத்தைத் தவிர்க்கச் சொற்களைப் பிரித்து எழுதுவதில் சரியான தொடர் எது?", "media_id": null}], "options": {"A": "அவன் சோ றுண்டான்", "B": "அவன் சோறு உண்டான்", "C": "அவன்சோ றுண்டான்", "D": "அவன் சோறுண்டான்"}, "explanation": "'அவன் சோ றுண்டான்' எனப் பிரித்தால் பொருள் சிதையும்; 'அவன் சோறு உண்டான்' என்பதே பொருள் துலங்கும் சரியான தொடர் அமைப்பாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which sentence is spaced correctly to prevent semantic confusion (Porul Mayakkam)?", "media_id": null}], "options": {"A": "Avan so rundaan", "B": "Avan soru undaan", "C": "Avansho rundaan", "D": "Avan sorundaan (joined improperly)"}, "explanation": "'Avan soru undaan' (He ate rice) is properly spaced without awkward semantic distortion."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 67, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 67", "u