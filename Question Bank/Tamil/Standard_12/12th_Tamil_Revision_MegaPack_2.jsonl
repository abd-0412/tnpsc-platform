{"id": "12th_tamil_mp2_q1782", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "agananooru_divisions", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அகநானூற்றின் மூன்று பிரிவுகளுள் நடுவில் உள்ள 'மணிமிடை பவளம்' பகுதியில் உள்ள பாடல்களின் எண்ணிக்கை யாது?", "media_id": null}], "options": {"A": "120 பாடல்கள்", "B": "180 பாடல்கள்", "C": "100 பாடல்கள்", "D": "200 பாடல்கள்"}, "explanation": "அகநானூறு: களிற்றியானை நிரை (120), மணிமிடை பவளம் (180), நித்திலக்கோவை (100) என மொத்தம் 400 பாடல்களைக் கொண்டது."}, "en": {"blocks": [{"type": "text", "content": "How many songs are contained in 'Manimidai Pavalam', the central section of Agananooru?", "media_id": null}], "options": {"A": "120 songs", "B": "180 songs", "C": "100 songs", "D": "200 songs"}, "explanation": "Agananooru consists of Kalitriyana Nirai (120), Manimidai Pavalam (180), and Nithilakkovai (100)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 112, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 112", "url": null, "source_notes": null}, "previous_