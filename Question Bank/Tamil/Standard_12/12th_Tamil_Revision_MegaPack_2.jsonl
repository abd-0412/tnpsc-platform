{"id": "12th_tamil_mp2_q1941", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "sirupanattruppadai_athiyaman_nellikkani", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தனக்குக் கிடைத்த சாகா மூவா மருந்தான அரிய கருநெல்லிக்கனியைத் தான் உண்ணாமல் ஔவைக்கு ஈந்த வள்ளல் யார்?", "media_id": null}], "options": {"A": "அதியமான் நெடுமான் அஞ்சி", "B": "பாரி", "C": "பேகன்", "D": "வல்வில் ஓரி"}, "explanation": "தகடூரை ஆண்ட அதியமான் நெடுமான் அஞ்சி, தனக்குக் கிடைத்த நீண்ட ஆயுளைத் தரும் அரிய நெல்லிக்கனியைத் தமிழ் வாழ ஔவையாருக்கு ஈந்தான்."}, "en": {"blocks": [{"type": "text", "content": "Which chieftain offered the rare ambrosial black gooseberry of immortality to poetess Avvaiyar?", "media_id": null}], "options": {"A": "Athiyaman Nedumaan Anji", "B": "Paari", "C": "Pegan", "D": "Valvil Ori"}, "explanation": "Athiyaman Nedumaan Anji generously presented the life-prolonging celestial gooseberry to Avvaiyar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 166, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 16