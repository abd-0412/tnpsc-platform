{"id": "12th_tamil_mp2_q1846", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "kadaiyezhu_valvil_ori", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கொல்லி மலையை ஆண்டவனும், ஒரே அம்பில் யானை, புலி, மான், பன்றி ஆகியவற்றை வீழ்த்திய வில்லாற்றல் மிக்கவனுமான வள்ளல் யார்?", "media_id": null}], "options": {"A": "பாரி", "B": "வல்வில் ஓரி", "C": "காரி", "D": "பேகன்"}, "explanation": "கொல்லி மலை நாட்டுத் தலைவனான வல்வில் ஓரி, தன் ஒப்பற்ற வில்லாற்றலால் புகழ்பெற்றதுடன், தன் நாட்டைப் பாணர்களுக்குப் பரிசாக ஈந்த வள்ளலாவான்."}, "en": {"blocks": [{"type": "text", "content": "Which chieftain ruled Kolli Hills, renowned for piercing an elephant, tiger, deer, and boar with a single arrow and gifting his kingdom to bards?", "media_id": null}], "options": {"A": "Paari", "B": "Valvil Ori", "C": "Kaari", "D": "Pegan"}, "explanation": "Valvil Ori ruled the Kolli Hills, renowned for legendary archery and gifting his kingdom to wandering minstrels."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 166, "chapter": null, "section": null, "reference": "12th Ta