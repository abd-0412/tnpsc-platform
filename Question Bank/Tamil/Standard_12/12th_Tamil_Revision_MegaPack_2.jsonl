{"id": "12th_tamil_mp2_q1795", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "thonmam_myth_concept", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கியத்தில் பழங்கதைகளையும் வழிவழியாக வரும் நம்பிக்கைகளையும் புதிய பொருளில் பயன்படுத்தும் உத்தி எது?", "media_id": null}], "options": {"A": "உவமை", "B": "படிமம்", "C": "தொன்மம் (Myth)", "D": "சிலேடை"}, "explanation": "தொன்மம் என்பது பழங்காலக் கதைகள், புராண நிகழ்வுகள் அல்லது வரலாற்று மரபுகளைத் தற்காலப் படைப்புகளில் குறியீடாகப் பயன்படுத்தும் இலக்கிய உத்தியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which literary device repurposes ancient mythical narratives and legendary beliefs to convey contemporary meaning?", "media_id": null}], "options": {"A": "Simile (Uvamai)", "B": "Image (Padimam)", "C": "Myth (Thonmam)", "D": "Double Entendre (Siledai)"}, "explanation": "Thonmam (Myth) repurposes legendary mythological narratives as symbolic allegories in creative literature."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 139, "chapter": null, "section": null, "reference": "1