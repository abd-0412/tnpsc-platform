{"id": "12th_tamil_mp2_q1781", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "madhavi_eleven_dances", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகார அரங்கேற்று காதையில் கூறப்படும் பதினோராடலில், மாயவன் (கண்ணன்) ஆடிய கூத்துகள் எவை?", "media_id": null}], "options": {"A": "அல்லியம் மற்றும் குடக்கூத்து", "B": "கொடுகொட்டி மற்றும் பாண்டரங்கம்", "C": "பேடு மற்றும் மரக்கால் கூத்து", "D": "துடிக்கூத்து மற்றும் கடையக் கூத்து"}, "explanation": "மாயவன் ஆடிய ஆடல்கள்: யானையின் தந்தத்தை ஒடித்தபோது ஆடிய அல்லியம், மற்றும் பாணனைக் காக்க ஆடிய குடக்கூத்து ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Among the eleven classical dances described in Silappathikaram, which were performed by Lord Krishna (Mayavan)?", "media_id": null}], "options": {"A": "Alliyam and Kudakkoothu", "B": "Kodukotti and Pandarangam", "C": "Pedu and Marakkal Koothu", "D": "Thudikkoothu and Kadaiyakkoothu"}, "explanation": "Lord Krishna performed Alliyam (breaking elephant tusk) and Kudakkoothu (pot dance)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 1