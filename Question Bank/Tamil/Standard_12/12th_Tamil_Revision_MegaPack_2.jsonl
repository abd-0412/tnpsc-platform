{"id": "12th_tamil_mp2_q1798", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "translation_bharati_quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பிறநாட்டு நல்லறிஞர் சாத்திரங்கள் தமிழ்மொழியிற் பெயர்த்தல் வேண்டும்' - என்று முழங்கிய கவிஞர் யார்?", "media_id": null}], "options": {"A": "பாரதிதாசன்", "B": "மகாகவி பாரதியார்", "C": "கவிமணி தேசிக விநாயகம் பிள்ளை", "D": "நாமக்கல் கவிஞர்"}, "explanation": "உலக இலக்கியங்களையும் அறிவியல் நூல்களையும் தமிழில் மொழிபெயர்க்க வேண்டும் என்பதை 'சென்றிடுவீர் எட்டுத் திக்கும்...' பாடலில் பாரதியார் வலியுறுத்தினார்."}, "en": {"blocks": [{"type": "text", "content": "'Piranattu nallarignar saathirangal thamizhmozhiyil peyartthal vendum' - Which poet gave this call for translating global wisdom into Tamil?", "media_id": null}], "options": {"A": "Bharathidasan", "B": "Mahakavi Subramania Bharati", "C": "Kavimani Desika Vinayagam Pillai", "D": "Namakkal Kavignar"}, "explanation": "Mahakavi Bharati urged the Tamil community to translate world treatises and knowledge texts into Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year"