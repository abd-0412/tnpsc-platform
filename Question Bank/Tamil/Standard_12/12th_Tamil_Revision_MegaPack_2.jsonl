{"id": "12th_tamil_mp2_q1937", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "purananooru_avvaiyar_athiyaman_weapons", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘இவ்வே பீலி அணிந்து மாலை சூட்டி... அவ்வே பகைவர்குத்தி கோடுசிதைந்து’ - ஔவையார் அதியமானின் ஆயுதங்களை எங்கே இருப்பதாகப் பாடுகிறார்?", "media_id": null}], "options": {"A": "கருமாரன் (கொல்லன்) உலையில்", "B": "அரண்மனைப் பொக்கிஷத்தில்", "C": "கோயில் திருமுற்றத்தில்", "D": "கடற்கரைக் கோட்டையில்"}, "explanation": "பகைவனின் ஆயுதங்கள் அரண்மனையில் பளபளப்பாக இருக்க, அதியமானின் ஆயுதங்களோ போர்க்களத்தில் உடைந்து கொல்லன் உலையில் செப்பனிடக் கிடக்கின்றன என ஔவையார் பாடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "In Avvaiyar's Purananooru verse comparing weapons, where do Athiyaman's battle-scarred weapons lie?", "media_id": null}], "options": {"A": "In the blacksmith's forge (Kollan ulai) undergoing repairs after fierce battle", "B": "In the royal treasury display", "C": "In the temple courtyard", "D": "In the coastal fortress"}, "explanation": "Athiyaman's dented weapons were kept in the blacksmith's smithy for repairs, while the adversary's lay polished in armories."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Sam