{"id": "12th_tamil_mp2_q1835", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "krishna_pillai_other_works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எச்.ஏ. கிருஷ்ணபிள்ளை இயற்றிய பக்திப் பாடல்களின் திரட்டான நூல் எது?", "media_id": null}], "options": {"A": "இரட்சணிய யாத்திரிகம்", "B": "இரட்சணிய சமயம்", "C": "இரட்சணிய மனோகரம்", "D": "இரட்சணிய காவியம்"}, "explanation": "எச்.ஏ. கிருஷ்ணபிள்ளை இயற்றிய பிற நூல்கள் 'இரட்சணிய மனோகரம்', 'இரட்சணிய சமய நிர்ணயம்' ஆகியவையாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which devotional poetry collection was composed by H.A. Krishna Pillai?", "media_id": null}], "options": {"A": "Ratchanya Yaathirigam", "B": "Ratchanya Samayam", "C": "Ratchanya Manoharam", "D": "Ratchanya Kaaviyam"}, "explanation": "H.A. Krishna Pillai composed the devotional lyrical work 'Ratchanya Manoharam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 168, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 168", "url": null, "source_notes": null}, "previous_year": {"is_previo