{"id": "12th_tamil_mp2_q1796", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "keeladi_archaeology_century", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழடி அகழாய்வு முடிவுகள் தமிழர்களின் எழுத்தறிவும் நகர நாகரிகமும் எந்தக் காலத்தைச் சேர்ந்தது என்பதை அறிவியல் பூர்வமாக நிறுவியுள்ளன?", "media_id": null}], "options": {"A": "கி.பி. 10-ஆம் நூற்றாண்டு", "B": "கி.பி. 2-ஆம் நூற்றாண்டு", "C": "கி.மு. 2-ஆம் நூற்றாண்டு", "D": "கி.மு. 6-ஆம் நூற்றாண்டு (பொ.ஆ.மு. 580)"}, "explanation": "கீழடியில் கிடைத்த கரித்துப் பகுப்பாய்வு முடிவுகள், வைகை நதிக்கரை நகர நாகரிகமும் தமிழ் பிராமி எழுத்தறிவும் கி.மு. 6-ஆம் நூற்றாண்டைச் சேர்ந்தவை என்பதை உறுதி செய்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Scientific carbon-dating of Keeladi excavations proved that ancient Tamil urban literate civilization dates back to which era?", "media_id": null}], "options": {"A": "10th Century CE", "B": "2nd Century CE", "C": "2nd Century BCE", "D": "6th Century BCE (c. 580 BCE)"}, "explanation": "Beta Analytic accelerator mass spectrometry confirmed Keeladi artifacts date back to the 6th century BCE."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educati