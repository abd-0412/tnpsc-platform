{"id": "12th_tamil_mp2_q1805", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "agananooru_palai_count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அகநானூற்றில் பாலைத் திணைக்குரிய மொத்தப் பாடல்களின் எண்ணிக்கை யாது?", "media_id": null}], "options": {"A": "200 பாடல்கள்", "B": "100 பாடல்கள்", "C": "80 பாடல்கள்", "D": "40 பாடல்கள்"}, "explanation": "அகநானூற்றில் பாலைத்திணைப் பாடல்கள் 200, குறிஞ்சி 80, முல்லை 40, மருதம் 40, நெய்தல் 40 என மொத்தம் 400 பாடல்கள் அமைந்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "How many verses are dedicated to Palai Thinai in Agananooru?", "media_id": null}], "options": {"A": "200 verses", "B": "100 verses", "C": "80 verses", "D": "40 verses"}, "explanation": "In Agananooru, Palai Thinai contains exactly 200 verses (all odd numbers)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 112, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 112", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "ye