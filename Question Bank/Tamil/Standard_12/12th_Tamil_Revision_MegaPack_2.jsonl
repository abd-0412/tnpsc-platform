{"id": "12th_tamil_mp2_q1820", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "thirukkural_olukkamudaimai_life", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஒழுக்கம் விழுப்பம் தரலான் ஒழுக்கம் உயிரினும் ஓம்பப் படும்’ - என்பதில் வள்ளுவர் எதை உயிரை விட மேலாகக் காக்க வேண்டும் என்கிறார்?", "media_id": null}], "options": {"A": "செல்வத்தை", "B": "கல்வியை", "C": "வீரத்தை", "D": "நல் ஒழுக்கத்தை"}, "explanation": "ஒழுக்கம் ஒருவனுக்கு அனைத்து உயர்வுகளையும் தருவதால், அதனைத் தன் உயிரை விட மேலானதாகக் கருதிப் பாதுகாக்க வேண்டும் என்பது வள்ளுவர் வாக்கு."}, "en": {"blocks": [{"type": "text", "content": "'Olukkam vizhuppam tharalaan olukkam uyirinum ombap padum' - What does Valluvar mandate must be preserved above one's life?", "media_id": null}], "options": {"A": "Material wealth", "B": "Academic erudition", "C": "Martial valor", "D": "Moral rectitude / Good character (Olukkam)"}, "explanation": "Thiruvalluvar declares moral character (Olukkam) must be treasured and guarded more preciously than life itself."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2