{"id": "12th_tamil_mp2_q1954", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "mayilai_seeni_samanamum_thamizhum", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயிலை சீனி. வேங்கடசாமியின் 'சமணமும் தமிழும்' நூல் வெளிக்கொணர்ந்த முக்கியச் செய்தி யாது?", "media_id": null}], "options": {"A": "சமணர்கள் தமிழைப் புறக்கணித்தனர் என்பது", "B": "சமணத் துறவிகள் தமிழ் இலக்கண, இலக்கிய, காப்பிய வளர்ச்சிக்குப் பெரும்பங்காற்றினர் என்பது", "C": "சமணர்கள் தமிழகத்திற்கு வரவேயில்லை என்பது", "D": "சமணர்கள் கோயில்களை மட்டுமே கட்டினர் என்பது"}, "explanation": "நாலடியார், சீவகசிந்தாமணி, நன்னூல் உள்ளிட்ட எண்ணற்ற செவ்விலக்கியங்களையும் இலக்கணங்களையும் தமிழருக்குத் தந்து தமிழ் வளர்த்தவர்கள் சமண முனிவர்கள் என்பதை இந்நூல் நிறுவியது."}, "en": {"blocks": [{"type": "text", "content": "What historic thesis was established by Mayilai Seeni. Venkatasamy in his seminal work 'Samanamum Thamizhum'?", "media_id": null}], "options": {"A": "Jains boycotted the Tamil language", "B": "Jain ascetics contributed monumentally to Tamil grammar, classical epics, and ethical literature", "C": "Jains never entered Tamil country", "D": "Jains only built temples without literary works"}, "explanation": "Mayilai Seeni proved that Jain scholars composed foundational Tamil works like Naladiyar, Seevaka Chinthamani, and Nannool."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_nega