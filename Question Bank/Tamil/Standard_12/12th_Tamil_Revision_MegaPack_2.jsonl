{"id": "12th_tamil_mp2_q1797", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "silappathikaram_stage_intercolumniation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகார அரங்கேற்று காதையில் ஆடல் மேடையின் தூண்களுக்கு இடையே விடப்பட்ட இடைவெளி எவ்வளவு?", "media_id": null}], "options": {"A": "நான்கு கோல் அளவு", "B": "ஐந்து கோல் அளவு", "C": "ஆறு கோல் அளவு", "D": "எட்டு கோல் அளவு"}, "explanation": "ஆடல் மேடையின் தூண்களுக்கு இடையே விடப்படும் இடைவெளி நான்கு கோல் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "In the dance stage architecture of Silappathikaram, what was the intercolumnar spacing between stage pillars?", "media_id": null}], "options": {"A": "Span of four standard measuring rods (4 Kole)", "B": "Span of five measuring rods (5 Kole)", "C": "Span of six measuring rods (6 Kole)", "D": "Span of eight measuring rods (8 Kole)"}, "explanation": "The spacing between columns across the performance stage was stipulated as four Kole units."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 129, "chapter": null, "section":