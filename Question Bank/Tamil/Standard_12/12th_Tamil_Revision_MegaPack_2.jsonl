{"id": "12th_tamil_mp2_q1947", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "thirukkural_kural_venba_syllables", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறள் வெண்பா எத்தனை அடிகளையும் எத்தனை சீர்களையும் கொண்டு அமையும்?", "media_id": null}], "options": {"A": "நான்கு அடிகள், 16 சீர்கள்", "B": "மூன்று அடிகள், 10 சீர்கள்", "C": "இரண்டு அடிகள், 7 சீர்கள் (முதல் அடி 4 சீர், இரண்டாம் அடி 3 சீர்)", "D": "ஐந்து அடிகள், 20 சீர்கள்"}, "explanation": "குறள் வெண்பா என்பது முதல் அடியில் 4 சீர்களும், இரண்டாம் அடியில் 3 சீர்களும் கொண்டு மொத்தம் இரண்டு அடிகளில் 7 சீர்களாய் அமையும்."}, "en": {"blocks": [{"type": "text", "content": "How many lines (Adi) and metrical feet (Seer) constitute a classical Kural Venba stanza?", "media_id": null}], "options": {"A": "4 lines, 16 feet", "B": "3 lines, 10 feet", "C": "2 lines, 7 feet (4 feet in first line, 3 feet in second line)", "D": "5 lines, 20 feet"}, "explanation": "A Kural Venba comprises 2 metrical lines containing precisely 7 feet (4 in the first line, 3 in the second)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_ye