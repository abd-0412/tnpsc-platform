{"id": "12th_tamil_mp2_q1892", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_sengonmai_rain", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வானோக்கி வாழும் உலகெல்லாம் மன்னவன் கோல்நோக்கி வாழுங் குடி’ - இக்குறளில் பயின்று வந்துள்ள உவமை உருபு எது?", "media_id": null}], "options": {"A": "போல", "B": "புரைய", "C": "அன்ன", "D": "உவம உருபு இன்றி அமைந்துள்ள எடுத்துக்காட்டு உவமை அணி"}, "explanation": "வானத்து மழையை நோக்கி உயிர்கள் வாழ்வது போல, அரசனின் செங்கோல் நீதியை நோக்கி மக்கள் வாழ்கின்றனர்; உவம உருபு மறைந்து வந்ததால் எடுத்துக்காட்டு உவமை அணி."}, "en": {"blocks": [{"type": "text", "content": "'Vaannokki vaazhum ulagellaam mannavan kolnokki vaazhung kudi' - Why is this verse classified as Edutthukkattu Uvamai Ani?", "media_id": null}], "options": {"A": "Contains particle Pola", "B": "Contains particle Puraiya", "C": "Contains particle Anna", "D": "The comparative particle is implied without explicit mention (Edutthukkattu Uvamai Ani)"}, "explanation": "Because the comparative particle 'pola' is implied rather than explicitly stated, it is an exemplary simile."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Ed