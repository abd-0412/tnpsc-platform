{"id": "12th_tamil_mp2_q1809", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "athiveeraramapandiyar_vetriverkai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வெற்றிவேற்கை' என்று அழைக்கப்படும் நறுந்தொகையை இயற்றிய மன்னர் புலவர் யார்?", "media_id": null}], "options": {"A": "அதிவீரராம பாண்டியர்", "B": "நெடுஞ்செழியன்", "C": "குலசேகரப் பாண்டியன்", "D": "இராசராச சோழன்"}, "explanation": "கொற்கை வேந்தரான அதிவீரராம பாண்டியர் வெற்றிவேற்கை, நைடதம், கூர்மபுராணம், இலிங்கபுராணம் ஆகிய நூல்களை இயற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Which royal poet-king authored the ethical work 'Vetri Verkai' (also known as Narunthogai)?", "media_id": null}], "options": {"A": "Athiveerarama Pandiyar", "B": "Nedunchezhiyan", "C": "Kulasekara Pandiyan", "D": "Rajaraja Chola"}, "explanation": "King Athiveerarama Pandiyar authored Vetri Verkai, Naidadham, and Koorma Puranam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 156", "url": null, "source_no