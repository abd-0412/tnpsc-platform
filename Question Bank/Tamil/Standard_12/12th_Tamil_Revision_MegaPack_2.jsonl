{"id": "12th_tamil_mp2_q1770", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "sculpture_pallava_kings", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாமல்லபுரத்துக் குடைவரைக் கோயில்களையும் ஒற்றைக்கல் இரதங்களையும் அமைத்த பல்லவ மன்னர்கள் யார்?", "media_id": null}], "options": {"A": "சிம்மவிஷ்ணு மற்றும் இரண்டாம் நந்திவர்மன்", "B": "முதலாம் மகேந்திரவர்மன் மற்றும் முதலாம் நரசிம்மவர்மன் (மாமல்லன்)", "C": "இரண்டாம் விக்கிரமாதித்தன் மற்றும் அபராசிதன்", "D": "முதலாம் குலோத்துங்கன் மற்றும் இராஜராஜன்"}, "explanation": "பல்லவ மன்னர்களான முதலாம் மகேந்திரவர்மனும், அவரது மகன் முதலாம் நரசிம்மவர்மனும் (மாமல்லன்) குடைவரைக் கோயில்களையும் மாமல்லபுரத்து ஒற்றைக்கல் இரதங்களையும் உருவாக்கினர்."}, "en": {"blocks": [{"type": "text", "content": "Which Pallava monarchs initiated cave rock-cut temples and monolithic rathas at Mamallapuram?", "media_id": null}], "options": {"A": "Simhavishnu and Nandivarman II", "B": "Mahendravarman I and Narasimhavarman I (Mamallan)", "C": "Vikramaditya II and Aparajitha", "D": "Kulothunga I and Rajaraja"}, "explanation": "Mahendravarman I and his son Narasimhavarman I (Mamallan) created the magnificent rock-cut temples and monolithic rathas at Mamallapuram."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "b