{"id": "12th_tamil_mp2_q1849", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "grammar_poetics_masterclass", "chapter_id": null, "topic_id": "padimam_definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘காட்சியையோ கருத்தையோ காட்சிப்படுத்தி மனக்கண் முன் நிறுத்தும் இலக்கிய உத்தி’ எது?", "media_id": null}], "options": {"A": "படிமம் (Image)", "B": "தொன்மம் (Myth)", "C": "குறியீடு (Symbol)", "D": "சிலேடை (Pun)"}, "explanation": "படிமம் என்பது மனக் காட்சியை உருவாக்கும் கவிதை உத்தியாகும்; இது சொல்லப்படும் கருத்தை அல்லது உணர்வை வாசகரின் மனக்கண் முன் உருவகப்படுத்திக் காட்டுகிறது."}, "en": {"blocks": [{"type": "text", "content": "'A poetic device that visualizes sensory ideas and brings them vividly before the reader's mental eye' is called?", "media_id": null}], "options": {"A": "Padimam (Image/Imagery)", "B": "Thonmam (Myth)", "C": "Kuriyedu (Symbol)", "D": "Siledai (Pun)"}, "explanation": "Padimam (Imagery) projects concrete sensory scenes before the reader's mind's eye."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": "12th T