{"id": "12th_tamil_mp2_q1869", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "grammar_poetics_masterclass", "chapter_id": null, "topic_id": "padimam_gustatory_sound", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தண்ணீரில் எறிந்த கூழாங்கல்லின் ஓசை காற்றில் கரைகிறது’ - இதில் அமைந்துள்ள படிமம் எது?", "media_id": null}], "options": {"A": "கேட்டல் படிமம் (Auditory Image)", "B": "காட்சிப் படிமம்", "C": "சுவைப் படிமம்", "D": "தொடு உணர்வுப் படிமம்"}, "explanation": "கூழாங்கல் தண்ணீரில் விழும் ஒலியைக் கேட்பது போன்று விவரிப்பதால் இது கேட்டல் படிமம் (Auditory Image) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "'The splash sound of the pebble dropped into water dissolves in the breeze' - Which sensory image is deployed?", "media_id": null}], "options": {"A": "Auditory Image (Keettal Padimam)", "B": "Visual Image", "C": "Gustatory Image", "D": "Tactile Image"}, "explanation": "Appealing to the sense of hearing through acoustic description creates an auditory poetic image."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 115, "chapter": null, "section": null, "reference": "12t