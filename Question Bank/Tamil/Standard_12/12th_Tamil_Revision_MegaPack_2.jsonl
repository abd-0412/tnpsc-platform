{"id": "12th_tamil_mp2_q1831", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "pegan_peacock_blanket", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குளிரால் நடுங்கிய மயிலுக்குத் தன் விலைமதிப்பற்ற நீலப் போர்வையை ஈந்த கடையேழு வள்ளல் யார்?", "media_id": null}], "options": {"A": "பாரி", "B": "காரி", "C": "பேகன் (பொதினி / பழனி மலைத் தலைவன்)", "D": "ஓரி"}, "explanation": "பொதினி எனப்படும் பழனிமலை நாட்டுத் தலைவனான பேகன், மயிலின் குளிரைப் போக்கத் தன் போர்வையை ஈந்து புகழ்பெற்றான்."}, "en": {"blocks": [{"type": "text", "content": "Which of the seven munificent patrons gifted his precious royal mantle to a shivering peacock?", "media_id": null}], "options": {"A": "Paari", "B": "Kaari", "C": "Pegan (chieftain of Pothini / Palani hills)", "D": "Ori"}, "explanation": "Pegan, king of the Palani hill tract, compassionately wrapped his royal mantle around a shivering peacock."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 166, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 166", "url": null, "source_notes":