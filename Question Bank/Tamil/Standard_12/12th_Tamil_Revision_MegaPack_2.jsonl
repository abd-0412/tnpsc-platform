{"id": "12th_tamil_mp2_q1848", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "thirukkural_kudiseyalvagai_effort", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘குடிமடிந்து குற்றம் பெருகும் மடிமடிந்து மான உரன்மாணாக் கடை’ - திருக்குறளில் ‘மடி’ என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "ஆடை", "B": "மடிவு (மரணம்)", "C": "பயணம்", "D": "சோம்பல்"}, "explanation": "திருக்குறளில் 'மடி' என்பது சோம்பலைக் குறிக்கும்; ஒருவன் சோம்பலில் மூழ்கி மானமும் வலிமையும் இழக்கும்போது அவனது குடி அழியும்."}, "en": {"blocks": [{"type": "text", "content": "In the Kural verse 'Kudimadindhu kutram perugum...', what is the precise meaning of 'Madi'?", "media_id": null}], "options": {"A": "Garment", "B": "Demise (Death)", "C": "Journey", "D": "Sloth / Indolence (Lethargy)"}, "explanation": "In Thirukkural, 'Madi' explicitly denotes sloth/indolence, which ruins noble families."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 175, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 175", "url": null, "source_note