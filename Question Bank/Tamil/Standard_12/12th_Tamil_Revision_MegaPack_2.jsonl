{"id": "12th_tamil_mp2_q1776", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "madhavi_title_thalaimai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அரங்கேற்றம் முடிந்தபின் சோழ மன்னன் மாதவிக்கு வழங்கிய கௌரவப் பட்டம் யாது?", "media_id": null}], "options": {"A": "நாட்டியப் பேரரசி", "B": "நாட்டிய கலாநிதி", "C": "ஆடலரசி", "D": "தலைக்கோலரிவை"}, "explanation": "மாதவியின் ஆடலைக் கண்டு மகிழ்ந்த சோழ மன்னன் அவளுக்குப் பொன்னாலான தலைக்கோலையும் 'தலைக்கோலரிவை' என்ற பட்டத்தையும் வழங்கிப் பாராட்டினான்."}, "en": {"blocks": [{"type": "text", "content": "Which royal honorific title was conferred upon Madhavi by the Chola monarch after her debut performance?", "media_id": null}], "options": {"A": "Nattiya Perarasi", "B": "Nattiya Kalanidhi", "C": "Aadalarasi", "D": "Thalaikkolariwai"}, "explanation": "The Chola king conferred upon Madhavi the golden sacred staff (Thalaikkol) and the esteemed title 'Thalaikkolariwai'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 129, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2,