{"id": "12th_tamil_mp2_q1777", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "meyppattiyal_ilivaral", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொல்காப்பிய மெய்ப்பாட்டியலில் 'இளிவரல்' என்ற மெய்ப்பாடு தோன்றுவதற்குரிய காரணங்கள் எவை?", "media_id": null}], "options": {"A": "மூப்பு, பிணி, வருத்தம், மென்மை", "B": "கல்வி, தறுகண், இசைமை, கொடை", "C": "புதுமை, பெருமை, சிறுமை, ஆக்கம்", "D": "அச்சம், வெகுளி, வியப்பு, அமைதி"}, "explanation": "'மூப்பே பிணியே வருத்தம் மென்மையோடு ஆனாப் பொருள் அவை இளிவரல் நான்கே' என்பது தொல்காப்பிய நூற்பா (மெய்ப்பாட்டியல் 5)."}, "en": {"blocks": [{"type": "text", "content": "According to Tholkappiyam Meyppattiyal, which four causes trigger 'Ilivaral' (pity/abjection)?", "media_id": null}], "options": {"A": "Mooppu (Old age), Pini (Disease), Varuttham (Distress), Menmai (Weakness)", "B": "Kalvi (Learning), Tharugan (Bravery), Isaimai (Fame), Kodai (Charity)", "C": "Pudhumai (Novelty), Perumai (Grandeur), Sirumai (Baseness), Aakkam (Growth)", "D": "Fear, Anger, Surprise, Calm"}, "explanation": "Tholkappiyam lists old age, affliction/disease, sorrow/distress, and extreme fragility as the four triggers of Ilivaral."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 138", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 1", "Meyppattiyal"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
