{"id": "12th_tamil_mp2_q1829", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "sukanthi_subramaniyan_poetry", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'முகம்' என்ற கவிதையின் மூலம் குடும்ப அமைப்பில் தொலைந்துபோன பெண்ணின் அடையாளத்தைத் தேடிய கவிஞர் யார்?", "media_id": null}], "options": {"A": "சுகந்தி சுப்பிரமணியன்", "B": "சல்மா", "C": "குட்டி ரேவதி", "D": "தாமரை"}, "explanation": "சுகந்தி சுப்பிரமணியன் எழுதிய 'முகம்' கவிதை குடும்பச் சுமைகளுக்குள் தன் சொந்த முகத்தையும் அடையாளத்தையும் இழந்து தவிக்கும் பெண்ணின் நிலையை உருக்கமாகப் பேசுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which poetess voiced the lost identity of women within domestic households in her poem 'Mugam'?", "media_id": null}], "options": {"A": "Sukanthi Subramaniyan", "B": "Salma", "C": "Kutti Revathi", "D": "Thamarai"}, "explanation": "Sukanthi Subramaniyan wrote 'Mugam', reflecting on female identity obscured by familial obligations."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 164, "chapter": null, "section": null, "reference": "12th Tamil, Un