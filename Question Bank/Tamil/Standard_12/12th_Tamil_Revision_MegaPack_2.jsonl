{"id": "12th_tamil_mp2_q1767", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "silappathikaram_madhavi_age", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகார அரங்கேற்று காதையின்படி மாதவி எத்தனை ஆண்டுகள் ஆடல் கலை பயின்று எந்த வயதில் மன்னன் முன் அரங்கேற்றினாள்?", "media_id": null}], "options": {"A": "ஐந்து ஆண்டுகள் பயின்று பத்தாம் வயதில் அரங்கேற்றினாள்", "B": "ஆறு ஆண்டுகள் பயின்று பதினொன்றாம் வயதில் அரங்கேற்றினாள்", "C": "ஏழு ஆண்டுகள் பயின்று பன்னிரண்டாம் வயதில் அரங்கேற்றினாள்", "D": "எட்டு ஆண்டுகள் பயின்று பதினான்காம் வயதில் அரங்கேற்றினாள்"}, "explanation": "மாதவி ஐந்தாம் வயதில் ஆடற்பயிற்சி தொடங்கி ஏழு ஆண்டுகள் தொடர்ந்து பயின்று, தன் பன்னிரண்டாம் வயதில் சோழ மன்னன் முன் அரங்கேற்றினாள்."}, "en": {"blocks": [{"type": "text", "content": "According to Silappathikaram Arangetru Kaathai, for how many years did Madhavi train in dance, and at what age did she perform her debut?", "media_id": null}], "options": {"A": "Trained for 5 years and debuted at age 10", "B": "Trained for 6 years and debuted at age 11", "C": "Trained for 7 years and debuted at age 12", "D": "Trained for 8 years and debuted at age 14"}, "explanation": "Madhavi commenced dance training at age 5, trained rigorously for 7 years, and debuted before the Chola king at age 12."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "nega