{"id": "12th_tamil_mp2_q1766", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "thevaram_raga", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருஞானசம்பந்தர் மயிலைக் கபாலீச்சரப் பதிகத்தைப் பாடிய பண் எது?", "media_id": null}], "options": {"A": "பழந்தக்கராகம்", "B": "நட்டராகம்", "C": "செவ்வழிப்பண்", "D": "காந்தார பஞ்சமம்"}, "explanation": "திருஞானசம்பந்தர் மயிலாப்பூரில் பூம்பாவையை உயிர்ப்பித்த போது பாடிய 'மட்டிட்ட புன்னையங் கானல் மடமயிலை' பதிகம் 'நட்டராகம்' பண்ணில் பாடப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which musical scale (Pann) was used by Thirugnanasambandar in his Thirumayilai Pathigam?", "media_id": null}], "options": {"A": "Pazhanthakkaragam", "B": "Nattaragam", "C": "Sevvazhippan", "D": "Gandhara Panchamam"}, "explanation": "Thirugnanasambandar composed the Mayilai Kapaleeswarar hymn in Nattaragam pann."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 107, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 107", "url": null, "source_notes": null}, "previous_year": {"is