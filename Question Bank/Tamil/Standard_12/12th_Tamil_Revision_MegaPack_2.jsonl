{"id": "12th_tamil_mp2_q1773", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "chennai_history_francis_day", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கிழக்கிந்தியக் கம்பெனியின் பிரான்சிஸ் டே சென்னைக் கடற்கரையில் நிலம் வாங்கிய ஆண்டு எது?", "media_id": null}], "options": {"A": "1639 ஆகஸ்ட் 22", "B": "1650 செப்டம்பர் 15", "C": "1700 ஜனவரி 1", "D": "1757 ஜூன் 23"}, "explanation": "1639 ஆம் ஆண்டு ஆகஸ்ட் 22-இல் கிழக்கிந்தியக் கம்பெனியின் பிரான்சிஸ் டே என்பவரால் சென்னைப் பட்டணம் உருவாவதற்கான நிலம் வாங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "In which year did Francis Day of the East India Company acquire coastal land that led to the founding of Madras/Chennai?", "media_id": null}], "options": {"A": "August 22, 1639", "B": "September 15, 1650", "C": "January 1, 1700", "D": "June 23, 1757"}, "explanation": "Francis Day acquired land for the East India Company on August 22, 1639, marking the foundation day of Madras/Chennai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 102, "chapter": null, "section": null, "refe