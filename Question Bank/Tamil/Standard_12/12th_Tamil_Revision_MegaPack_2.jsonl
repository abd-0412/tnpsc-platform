{"id": "12th_tamil_mp2_q1789", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "chola_bronze_sculptures", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சோழர் காலச் சிற்பக்கலையின் சிகரமாக உலகப் புகழ் பெற்று விளங்குவது எது?", "media_id": null}], "options": {"A": "ஆனந்தத் தாண்டவ நடராஜர் வெண்கலத் திருமேனி", "B": "மாமல்லபுர மகிசாசுரமர்த்தினி புடைப்புச் சிற்பம்", "C": "சித்தன்னவாசல் ஓவியங்கள்", "D": "கழுகுமலை வெட்டுவான் கோயில்"}, "explanation": "சோழர் காலத்திய மெழுகு வார்ப்பு முறையிலான வெண்கலச் சிற்பங்களுள் நடராஜர் சிலை உலகளவில் கலைப் பேரதிசயமாகப் போற்றப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which artwork is universally celebrated as the zenith of Chola bronzecasting sculpture?", "media_id": null}], "options": {"A": "Nataraja Ananda Thandavam bronze icon", "B": "Mahisasuramardini bas-relief of Mamallapuram", "C": "Sittannavasal Cave frescoes", "D": "Kazhugumalai Vettuvan Koil"}, "explanation": "The cosmic dance Nataraja bronze of the Chola era is recognized worldwide as a masterpiece of metal casting."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_y