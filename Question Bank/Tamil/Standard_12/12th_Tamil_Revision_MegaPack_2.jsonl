{"id": "12th_tamil_mp2_q1851", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "grammar_poetics_masterclass", "chapter_id": null, "topic_id": "kuriyedu_types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘புறா அமைதியின் சின்னம்; சிலுவை தியாகத்தின் சின்னம்’ - இவை இலக்கியத்தில் எவ்வகை உத்தியைக் குறிக்கின்றன?", "media_id": null}], "options": {"A": "உவமை", "B": "படிமம்", "C": "குறியீடு (Symbol)", "D": "உருவகம்"}, "explanation": "ஒரு பருப்பொருள் (புறா, சிலுவை) மற்றொரு பண்பையோ தத்துவத்தையோ (அமைதி, தியாகம்) சுட்டி நிற்பது 'குறியீடு' எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "'A dove signifies peace; a cross symbolizes sacrifice' - These signify which literary technique?", "media_id": null}], "options": {"A": "Simile", "B": "Image", "C": "Kuriyedu (Symbol)", "D": "Metaphor"}, "explanation": "Tangible representations signifying deeper abstract qualities or philosophical ideals constitute Symbols (Kuriyedu)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 172, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 172", "url": null, "source_