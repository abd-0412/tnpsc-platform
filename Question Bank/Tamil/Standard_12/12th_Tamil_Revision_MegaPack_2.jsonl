{"id": "12th_tamil_mp2_q1944", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "kodaimazhai_child_character", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கோடை மழை' சிறுகதையில் ஆசிரியர் மீது மிகுந்த அன்பும் மரியாதையும் காட்டும் பள்ளி மாணவன் யார்?", "media_id": null}], "options": {"A": "கண்ணன்", "B": "முருகன்", "C": "வேலு", "D": "சபாபதி"}, "explanation": "சாந்தா தத்தின் கோடை மழை கதையில் கிராமத்து எளிய மாணவன் சபாபதி ஆசிரியரின் மீது காட்டும் தூய பாசம் கதையின் மையமாக அமைகிறது."}, "en": {"blocks": [{"type": "text", "content": "In Shantha Dutt's story 'Kodai Mazhai', which devoted student portrays profound affection toward his teacher?", "media_id": null}], "options": {"A": "Kannan", "B": "Murugan", "C": "Velu", "D": "Sabhapathi"}, "explanation": "The rural schoolboy Sabhapathi expresses selfless devotion to his school teacher in 'Kodai Mazhai'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 170, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 170", "url": null, "source_notes": null}, "prev