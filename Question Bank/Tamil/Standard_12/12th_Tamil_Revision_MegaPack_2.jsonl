{"id": "12th_tamil_mp2_q1850", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "grammar_poetics_masterclass", "chapter_id": null, "topic_id": "thonmam_types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கர்ணன் போன்ற கொடைவள்ளல்', 'அரிச்சந்திரன் போன்ற வாய்மையாளன்' - எனப் பழங்கதைக் கதாபாத்திரங்களை உவமிப்பது எந்த உத்தி?", "media_id": null}], "options": {"A": "படிமம்", "B": "தொன்மம் (Myth)", "C": "குறியீடு", "D": "இயற்கை நவிற்சி"}, "explanation": "புராண, இதிகாசக் கதாபாத்திரங்களையும் வரலாற்றுக் கதைகளையும் இலக்கியத்தில் ஒரு குணத்திற்கு அடையாளமாகக் கையாள்வது 'தொன்மம்' எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Comparing characters like 'Karna for charity' or 'Harishchandra for truth' exemplifies which poetic device?", "media_id": null}], "options": {"A": "Padimam (Image)", "B": "Thonmam (Myth)", "C": "Kuriyedu (Symbol)", "D": "Naturalism"}, "explanation": "Invoking legendary archetypal personalities from epic lore represents Thonmam (Mythological Archetype)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 139, "chapter": null, "section": null, "reference": "12th Ta