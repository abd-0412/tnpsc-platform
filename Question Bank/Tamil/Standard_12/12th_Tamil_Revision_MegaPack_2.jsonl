{"id": "12th_tamil_mp2_q1812", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "nammazhvar_organic_farming", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழகத்தில் இயற்கை வேளாண்மை இயக்கத்தை மக்களிடம் கொண்டு சென்று விதைப்பாதுகாப்பை வலியுறுத்திய இயற்கை வேளாண் விஞ்ஞானி யார்?", "media_id": null}], "options": {"A": "எம்.எஸ். சுவாமிநாதன்", "B": "ஜி.டி. நாயுடு", "C": "மயிலை சீனி. வேங்கடசாமி", "D": "கோ. நம்மாழ்வார்"}, "explanation": "கோ. நம்மாழ்வார் நஞ்சில்லா இயற்கை வேளாண்மை, நாட்டு விதைப்பாதுகாப்பு, மரபுசார் நீர்ப்பாசனம் ஆகியவற்றை வாழ்நாள் முழுவதும் பரப்பினார்."}, "en": {"blocks": [{"type": "text", "content": "Who pioneered and championed the organic farming movement and traditional seed conservation throughout Tamil Nadu?", "media_id": null}], "options": {"A": "M.S. Swaminathan", "B": "G.D. Naidu", "C": "Mayilai Seeni. Venkatasamy", "D": "G. Nammazhvar"}, "explanation": "Ecologist and agricultural scientist G. Nammazhvar spearheaded the grassroots organic farming revolution."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 119, "ch