{"id": "12th_tamil_mp2_q1891", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_arivudaimai_truth", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘எப்பொருள் யார்யார்வாய்க் கேட்பினும் அப்பொருள் மெய்ப்பொருள் காண்ப தறிவு’ - இக்குறள் வலியுறுத்துவது எது?", "media_id": null}], "options": {"A": "சொல் அலங்காரம்", "B": "பேசும் நபரின் தகுதி", "C": "மெய்ப்பொருளை ஆராய்ந்து அறியும் பகுத்தறிவு", "D": "பழைய நம்பிக்கைகளை அப்படியே ஏற்றுக்கொள்வது"}, "explanation": "யார் எந்தக் கருத்தைச் சொன்னாலும் அதன் உண்மைத் தன்மையை நடுநிலையோடு ஆய்ந்து உணர்வதே உண்மையான அறிவு என வள்ளுவர் கூறுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "'Epporul yaaryaarvaaik ketpinum apporul meipporul kaanba dharivu' - What critical intellectual virtue does this prescribe?", "media_id": null}], "options": {"A": "Rhetorical oratory", "B": "Authority or status of the speaker", "C": "Rational critical inquiry into the objective truth regardless of the speaker", "D": "Blind acceptance of ancestral orthodoxies"}, "explanation": "Rational objective discernment of core reality irrespective of whoever speaks it is the hallmark of wisdom."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "p