{"id": "12th_tamil_mp2_q1866", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "grammar_poetics_masterclass", "chapter_id": null, "topic_id": "pagupadham_participle_rules", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘செய்த’ என்னும் பெயரெச்சச் சொல்லின் பகுபத உறுப்பிலக்கணப் பிரிப்பு முறை யாது?", "media_id": null}], "options": {"A": "செய் + த", "B": "செய் + த் + அ", "C": "செய்து + அ", "D": "செய் + த் + ஆன்"}, "explanation": "செய் (பகுதி) + த் (இறந்தகால இடைநிலை) + அ (பெயரெச்ச விகுதி) = செய்த."}, "en": {"blocks": [{"type": "text", "content": "What is the morphological structural division of the relative participle 'Seidha' (did/done)?", "media_id": null}], "options": {"A": "Sei + tha", "B": "Sei (root) + th (past infix) + a (participle suffix)", "C": "Seidhu + a", "D": "Sei + th + aan"}, "explanation": "'Seidha' resolves into Sei (root) + th (past tense marker) + a (relative participle suffix)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 92, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 92", "url": null, "source_notes": null}, "previous_yea