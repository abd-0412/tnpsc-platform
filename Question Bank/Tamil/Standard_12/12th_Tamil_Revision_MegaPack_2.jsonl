{"id": "12th_tamil_mp2_q1841", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "ratchanya_verses_count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எச்.ஏ. கிருஷ்ணபிள்ளையின் 'இரட்சணிய யாத்திரிகம்' காப்பியத்தில் உள்ள மொத்தப் பாடல்களின் எண்ணிக்கை யாது?", "media_id": null}], "options": {"A": "3,766 பாடல்கள்", "B": "4,120 பாடல்கள்", "C": "2,500 பாடல்கள்", "D": "5,000 பாடல்கள்"}, "explanation": "இரட்சணிய யாத்திரிகம் 5 பருவங்களையும் 3766 விருத்தப் பாடல்களையும் கொண்டு கம்பராமாயணத்திற்கு இணையான காப்பியமாகத் திகழ்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the total verse count in H.A. Krishna Pillai's epic 'Ratchanya Yaathirigam'?", "media_id": null}], "options": {"A": "3,766 verses", "B": "4,120 verses", "C": "2,500 verses", "D": "5,000 verses"}, "explanation": "Ratchanya Yaathirigam contains exactly 3,766 majestic virutham stanzas."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 168, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 168", "url": null, "source_notes": null}, "previous