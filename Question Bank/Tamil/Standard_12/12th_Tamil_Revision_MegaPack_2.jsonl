{"id": "12th_tamil_mp2_q1948", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "padimam_concept_ezhuthu_movement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழில் 'படிமக் கவிதைகள்' (Imagist Poetry) தீவிரமாக எழுதப்பட்டு விவாதிக்கப்பட்ட இதழ் இயக்கம் எது?", "media_id": null}], "options": {"A": "மணிக்கொடி", "B": "கலாமோகினி", "C": "ஆனந்த விகடன்", "D": "எழுத்து (சி.சு. செல்லப்பா காலம்)"}, "explanation": "சி.சு. செல்லப்பாவின் 'எழுத்து' இதழில் பிரமிள், நகுலன், தருமு சிவராமு போன்ற பல நவீனக் கவிஞர்கள் படிமவாதக் கவிதைகளைத் தீவிரமாக எழுதினர்."}, "en": {"blocks": [{"type": "text", "content": "During which literary periodical movement was modernist Imagist poetry (Padimam) actively fostered and theorized in Tamil?", "media_id": null}], "options": {"A": "Manikkodi", "B": "Kalamohini", "C": "Ananda Vikatan", "D": "Ezhuthu movement (edited by C.S. Chellappa)"}, "explanation": "C.S. Chellappa's magazine 'Ezhuthu' served as the vanguard for Imagist modern Tamil poetry."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": n