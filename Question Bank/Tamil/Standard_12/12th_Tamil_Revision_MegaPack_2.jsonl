{"id": "12th_tamil_mp2_q1828", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "kodaimazhai_author", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கோடை மழை' என்ற உருக்கமான துணைப்பாடச் சிறுகதையின் ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "அம்பை", "B": "திலகவதி", "C": "சு. சமுத்திரம்", "D": "சாந்தா தத்"}, "explanation": "'கோடை மழை' சிறுகதையின் ஆசிரியர் சாந்தா தத் ஆவார்; கிராமத்து எளிய மக்களின் அன்பையும் ஆசிரியர்-மாணவர் பாசத்தையும் இக்கதை விவரிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "Who is the author of the moving supplementary short story 'Kodai Mazhai'?", "media_id": null}], "options": {"A": "Ambai", "B": "Thilagavathi", "C": "Su. Samuthiram", "D": "Shantha Dutt"}, "explanation": "Shantha Dutt authored the poignant story 'Kodai Mazhai', portraying rural affection and human empathy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 170, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 170", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": fal