{"id": "12th_tamil_mp2_q1880", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_kannottam_benignity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கண்ணோட்டம் இல்லாத கண் எதற்கு ஒப்பானது?’ என்று வள்ளுவர் வினவுகிறார்?", "media_id": null}], "options": {"A": "குருட்டுக் கண்ணுக்கு", "B": "பளிங்கு மணி போன்ற கண்ணுக்கு", "C": "சுவரில் வரைந்த ஓவியத்திற்கு", "D": "முகத்தில் உள்ள வெறும் புண்ணுக்கு ஒப்பானது"}, "explanation": "'கண்ணிற்கு அணிகலம் கண்ணோட்டம் அஃதின்றேல் புண்ணென்று உணரப் படும்' - இரக்க உணர்வில்லாத கண் முகத்தில் உள்ள புண்ணாகவே கருதப்படும்."}, "en": {"blocks": [{"type": "text", "content": "To what does Thiruvalluvar compare an eye devoid of benign grace and empathy (Kannottam)?", "media_id": null}], "options": {"A": "A blind eye", "B": "A crystal gem", "C": "A painted mural", "D": "A mere festering sore upon the human countenance"}, "explanation": "Without gracious empathy, eyes are merely sores upon the face ('Punnendru unarap padum')."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 176, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 176", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 5", "Thirukkural Benignity"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp2_q1881", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_uzhavu_primacy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சுழன்றும் ஏர்ப்பின்னது உலகம் அதனால் உழந்தும் உழவே தலை’ - இக்குறள் உணர்த்தும் முதன்மைத் தொழில் எது?", "media_id": null}], "options": {"A": "உழவுத் தொழில் (வேளாண்மை)", "B": "வணிகத் தொழில்", "C": "நெசவுத் தொழில்", "D": "போர்த் தொழில்"}, "explanation": "பல தொழில்களால் உலகம் சுழன்று இயங்கினாலும், உணவுக்காக உழவர்களின் ஏருக்குப் பின்னாலேயே நிற்க வேண்டும்; எனவே உழவே தலையாய தொழில் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "'Suzhandrum erppinnadhu ulagam...' - Which profession is crowned as supreme by Valluvar in this Kural?", "media_id": null}], "options": {"A": "Uzhavu (Agriculture / Farming)", "B": "Commerce / Trade", "C": "Weaving", "D": "Warfare"}, "explanation": "Though the world engages in countless enterprises, it revolves around the plow; hence farming is paramount."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 176, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 176", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 5", "Thirukkural Agriculture"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp2_q1882", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_kudiseyalvagai_nobility", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஆள்வினையும் ஆன்ற அறிவும் எனஇரண்டின் நீள்வினையால் நீளும் குடி’ - இதில் ‘ஆள்வினை’ என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "ஆட்சி செய்யும் முறை", "B": "விடாமுயற்சி (ஊக்கம்)", "C": "அடிமைத் தொழில்", "D": "பகைவரை அழிக்கும் வீரம்"}, "explanation": "திருக்குறளில் 'ஆள்வினை' என்பது தளராத விடாமுயற்சியைக் குறிக்கும்; முயற்சியும் சிறந்த அறிவும் ஒரு குடும்பத்தை உயர்த்தும்."}, "en": {"blocks": [{"type": "text", "content": "In the Kural 'Aalvinaiyum aanra arivum...', what does 'Aalvinai' specifically denote?", "media_id": null}], "options": {"A": "Administrative governance", "B": "Relentless perseverance / Indomitable human effort", "C": "Bonded menial labor", "D": "Martial victory over adversaries"}, "explanation": "'Aalvinai' means industrious effort and tireless enterprise which elevates a noble family."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 177, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 177", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 5", "Thirukkural Vocabulary"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp2_q1883", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_nalkuravu_poverty", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘இன்மையின் இன்னாதது யாதெனின் இன்மையின் இன்மையே இன்னா தது’ - இதில் வள்ளுவர் வறுமைக்கு இணையாக எதனைக் கூறுகிறார்?", "media_id": null}], "options": {"A": "தீராத நோயை", "B": "கொடிய பகையை", "C": "வறுமையைப் போன்று கொடியது வறுமை ஒன்றே", "D": "மரணம்"}, "explanation": "வறுமையைப் போன்று துன்பம் தருவது உலகில் வேறு எதுவுமே இல்லை; வறுமைக்கு இணையான கொடுமை வறுமையே ஆகும் என வள்ளுவர் அழுத்தமாகக் கூறுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "'Inmaiyin innaadhadhu yaadhenin inmaiyin inmaiye innaa dhadhu' - What does Valluvar equate to the agony of extreme poverty (Inmai)?", "media_id": null}], "options": {"A": "Incurable disease", "B": "Lethal enmity", "C": "Nothing is as excruciatingly cruel as poverty itself except poverty", "D": "Physical death"}, "explanation": "Valluvar states that nothing in the world matches the bitter torment of poverty except poverty itself."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "t