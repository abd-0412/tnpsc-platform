{"id": "12th_tamil_mp2_q1876", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "grammar_poetics_masterclass", "chapter_id": null, "topic_id": "kuriyedu_national_emblem", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியக் குடியரசின் அதிகாரப்பூர்வ இலச்சினையில் அமைந்துள்ள நான்கு சிங்கங்கள் எதன் குறியீடாகும்?", "media_id": null}], "options": {"A": "நான்கு வேதங்களின் குறியீடு", "B": "நான்கு திசைகளின் குறியீடு", "C": "நான்கு கடல்களின் குறியீடு", "D": "வலிமை, துணிவு, நம்பிக்கை, பெருமிதம் ஆகியவற்றின் குறியீடு (சாரநாத் தூண்)"}, "explanation": "சாரநாத் அசோகர் தூணில் உள்ள நான்கு சிங்க முகங்கள் அதிகாரத்தையும், துணிவையும், வலிமையையும், அறவழியிலான பெருமிதத்தையும் குறிக்கின்றன."}, "en": {"blocks": [{"type": "text", "content": "What do the four Asiatic lions adapted from Ashoka's Sarnath Pillar represent in the National Emblem of India?", "media_id": null}], "options": {"A": "Four Vedas", "B": "Four cardinal directions", "C": "Four oceans", "D": "Power, courage, pride, and supreme confidence grounded in righteousness (Dharma)"}, "explanation": "The Lion Capital of Ashoka symbolizes power, courage, pride, and moral truth (Satyameva Jayate)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Edu