{"id": "12th_tamil_mp2_q1870", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "grammar_poetics_masterclass", "chapter_id": null, "topic_id": "ani_ilakkanam_sorporul_pinvaru", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘செய்யுளில் முன்னர் வந்த சொல்லும் பொருளும் பின்னரும் பலமுறை வந்து சிறப்பது’ எந்த அணி எனப்படும்?", "media_id": null}], "options": {"A": "சொல் பின்வரு நிலையணி", "B": "சொற்பொருள் பின்வரு நிலையணி", "C": "பொருள் பின்வரு நிலையணி", "D": "வஞ்சப்புகழ்ச்சியணி"}, "explanation": "முன்னர் வந்த அதே சொல் அதே பொருளில் மீண்டும் மீண்டும் பலமுறை செய்யுளில் வருவது 'சொற்பொருள் பின்வரு நிலையணி' எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "'The recurrence of the same word conveying the identical meaning multiple times across a stanza' is called?", "media_id": null}], "options": {"A": "Sol Pinvaru Nilaiyani (repetition of word only)", "B": "Sorporul Pinvaru Nilaiyani (repetition of both word and meaning)", "C": "Porul Pinvaru Nilaiyani (repetition of meaning only)", "D": "Vanchappugazhchiyani"}, "explanation": "Sorporul Pinvaru Nilaiyani occurs when both the identical lexical token and semantic meaning recur in a verse."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and E