{"id": "12th_tamil_mp2_q1852", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "grammar_poetics_masterclass", "chapter_id": null, "topic_id": "meyppattiyal_count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொல்காப்பியர் மெய்ப்பாட்டியலில் சுட்டும் எட்டுவகை மெய்ப்பாடுகளின் வரிசையில் தவறான இணை எது?", "media_id": null}], "options": {"A": "நகை - அழுகை", "B": "இளிவரல் - மருட்கை", "C": "அச்சம் - பெருமிதம்", "D": "சாந்தம் - தியானம்"}, "explanation": "தொல்காப்பியர் கூறும் எண்வகை மெய்ப்பாடுகள்: நகை, அழுகை, இளிவரல், மருட்கை, அச்சம், பெருமிதம், வெகுளி, உவகை ஆகும். சாந்தம்-தியானம் இதில் இல்லை."}, "en": {"blocks": [{"type": "text", "content": "Which pair is NOT part of Tholkappiyar's canonical 8 Meyppadus in Meyppattiyal?", "media_id": null}], "options": {"A": "Nagai - Azhugai", "B": "Ilivaral - Marutkai", "C": "Acham - Perumidham", "D": "Saantham - Dhyanam"}, "explanation": "Tholkappiyar catalogs Nagai, Azhugai, Ilivaral, Marutkai, Acham, Perumidham, Veguli, Uvagai; Saantham-Dhyanam are not among them."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null