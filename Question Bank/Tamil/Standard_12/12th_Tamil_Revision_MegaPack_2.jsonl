{"id": "12th_tamil_mp2_q1818", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "purananooru_ponmudiyar_duty", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஈன்று புறந்தருதல் என்தலைக் கடனே; சான்றோன் ஆக்குதல் தந்தைக்குக் கடனே' - என்ற புறநானூற்றுப் பாடலைப் பாடிய பெண் புலவர் யார்?", "media_id": null}], "options": {"A": "ஔவையார்", "B": "பொன்முடியார்", "C": "வெள்ளிவீதியார்", "D": "காக்கைப்பாடினியார்"}, "explanation": "சங்க காலத்துப் பெண்பாற்புலவர் பொன்முடியார் பாடிய புறநானூற்றுப் பாடல் இதுவாகும் (புறம் 312)."}, "en": {"blocks": [{"type": "text", "content": "'Eendru purantharudhal endhalaik kadane; Saanron aakkudhal thandhaikku kadane' - Which Sangam poetess composed this verse?", "media_id": null}], "options": {"A": "Avvaiyar", "B": "Ponmudiyar", "C": "Velliveethiyar", "D": "Kakkaipaadiniyar"}, "explanation": "Sangam poetess Ponmudiyar composed this famous verse defining mutual familial and martial obligations (Purananooru 312)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 153, "chapter": null, "section": null, "reference": "12th