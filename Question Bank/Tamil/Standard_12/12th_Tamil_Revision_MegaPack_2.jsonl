{"id": "12th_tamil_mp2_q1885", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_structure_pal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளில் அறத்துப்பால், பொருட்பால், காமத்துப்பால் ஆகியவற்றில் உள்ள மொத்த இயல்களின் எண்ணிக்கை யாது?", "media_id": null}], "options": {"A": "9 இயல்கள்", "B": "10 இயல்கள்", "C": "12 இயல்கள்", "D": "15 இயல்கள்"}, "explanation": "திருக்குறளில் அறத்துப்பாலில் 4, பொருட்பாலில் 3, காமத்துப்பாலில் 2 என மொத்தம் 9 இயல்கள் உள்ளன."}, "en": {"blocks": [{"type": "text", "content": "What is the total number of Iyals (sub-sections) across Arathuppal, Porutpal, and Kamatthuppal in Thirukkural?", "media_id": null}], "options": {"A": "9 Iyals (4 + 3 + 2)", "B": "10 Iyals", "C": "12 Iyals", "D": "15 Iyals"}, "explanation": "Thirukkural is structured into 9 Iyals: 4 in Arathuppal, 3 in Porutpal, and 2 in Kamatthuppal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 174, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 174", "url": null, "source_notes"