{"id": "12th_tamil_mp2_q1943", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "mayilai_seeni_epigraphy_shasanam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயிலை சீனி. வேங்கடசாமி கல்வெட்டுகள் மற்றும் செப்பேடுகளை ஆய்வு செய்து வெளியிட்ட புகழ்பெற்ற வரலாற்று நூல் எது?", "media_id": null}], "options": {"A": "துளுவ நாட்டு வரலாறு", "B": "மறைந்துபோன தமிழ் நூல்கள்", "C": "சாசனச் செய்யுள் மஞ்சரி", "D": "கொங்கு நாட்டு வரலாறு"}, "explanation": "கல்வெட்டுகளிலும் செப்பேடுகளிலும் உள்ள பழம்பாடல்களைத் தேடித் தொகுத்து 'சாசனச் செய்யுள் மஞ்சரி' என்ற நூலாக மயிலையார் வெளியிட்டார்."}, "en": {"blocks": [{"type": "text", "content": "Which valuable epigraphical volume was compiled by Mayilai Seeni. Venkatasamy collecting poetic verses found in inscriptions and copper plates?", "media_id": null}], "options": {"A": "Thuluva Naattu Varalaaru", "B": "Maraindhupona Thamizh Noolgal", "C": "Saasana Seyyul Manjari", "D": "Kongu Naattu Varalaaru"}, "explanation": "Mayilai Seeni. Venkatasamy compiled poetic epigraphs from stone and copper charters into 'Saasana Seyyul Manjari'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpor