{"id": "12th_tamil_mp2_q1875", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "grammar_poetics_masterclass", "chapter_id": null, "topic_id": "thonmam_modern_fiction", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புதுமைப்பித்தனின் ‘சாப விமோசனம்’ சிறுகதை எந்தப் புராணத் தொன்மத்தை அடிப்படையாகக் கொண்டது?", "media_id": null}], "options": {"A": "மகாபாரதக் கர்ணன் கதை", "B": "நளவெண்பா கதை", "C": "இராமாயணத்து அகலிகை கதை", "D": "அரிச்சந்திரன் கதை"}, "explanation": "புதுமைப்பித்தன் அகலிகையின் சாப விமோசனத்திற்குப் பின் அவளது மன உளைச்சல்களையும் சமூகப் பார்வையையும் விவரித்து 'சாப விமோசனம்' கதையை எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "Pudhumaipithan's groundbreaking short story 'Saaba Vimochanam' reinterprets which mythical legend?", "media_id": null}], "options": {"A": "Mahabharata Karna episode", "B": "Nalavenba legend", "C": "Ramayana Ahalya's liberation episode", "D": "Harishchandra episode"}, "explanation": "'Saaba Vimochanam' psychologically deconstructs the post-redemption trauma of Ramayana's Ahalya."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 140, "chapter"