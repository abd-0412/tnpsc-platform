{"id": "12th_tamil_mp2_q1784", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "silappathikaram_structure", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரம் முழுவதிலும் உள்ள மொத்தக் காண்டங்கள் மற்றும் காதைகளின் எண்ணிக்கை யாது?", "media_id": null}], "options": {"A": "5 காண்டங்கள், 50 காதைகள்", "B": "6 காண்டங்கள், 118 காதைகள்", "C": "4 காண்டங்கள், 24 காதைகள்", "D": "3 காண்டங்கள், 30 காதைகள்"}, "explanation": "சிலப்பதிகாரம் புகார், மதுரை, வஞ்சி ஆகிய 3 காண்டங்களையும், 30 காதைகளையும் கொண்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "What is the total number of Kandams (cantos) and Kaathais (episodes) in Silappathikaram?", "media_id": null}], "options": {"A": "5 Kandams, 50 Kaathais", "B": "6 Kandams, 118 Kaathais", "C": "4 Kandams, 24 Kaathais", "D": "3 Kandams, 30 Kaathais"}, "explanation": "Silappathikaram comprises 3 Kandams (Puhar, Madurai, Vanchi) and 30 Kaathais."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 128, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 128", "