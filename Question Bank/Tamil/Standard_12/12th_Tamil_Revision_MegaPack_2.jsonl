{"id": "12th_tamil_mp2_q1787", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "chennai_libraries", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சென்னையில் அமைந்துள்ள கன்னிமாரா பொது நூலகம் தொடங்கப்பட்ட ஆண்டு எது?", "media_id": null}], "options": {"A": "1857", "B": "1869", "C": "1896", "D": "1914"}, "explanation": "சென்னையில் உள்ள வரலாற்றுச் சிறப்புமிக்க கன்னிமாரா பொது நூலகம் 1896 ஆம் ஆண்டு தொடங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "In which year was the historic Connemara Public Library established in Chennai?", "media_id": null}], "options": {"A": "1857", "B": "1869", "C": "1896", "D": "1914"}, "explanation": "The Connemara Public Library in Chennai was officially opened to the public in 1896."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 103, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 103", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"ha