{"id": "12th_tamil_mp2_q1791", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "silappathikaram_stage_curtains", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகார நாட்டிய அரங்கில் பயன்படுத்தப்பட்ட மூன்று வகையான திரைகள் எவை?", "media_id": null}], "options": {"A": "வெள்ளைத் திரை, சிவப்பைத் திரை, பச்சைத் திரை", "B": "முன்திரை, இடைத்திரை, பின்திரை", "C": "ஒருமுக எழினி, பொருமுக எழினி, கரந்துவரல் எழினி", "D": "வட்ட எழினி, நீள் எழினி, குறு எழினி"}, "explanation": "நாட்டிய அரங்கில் மேடையின் ஒரு பக்கத்திலிருந்து மறுபக்கம் செல்லும் 'ஒருமுக எழினி', இரு பக்கத்திலிருந்தும் நடுவில் இணையும் 'பொருமுக எழினி', மேலிருந்து கீழே இறங்கும் 'கரந்துவரல் எழினி' ஆகியவை பயன்படுத்தப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "Which three types of stage curtains were utilized in the classical Tamil theater described in Silappathikaram?", "media_id": null}], "options": {"A": "White curtain, Red curtain, Green curtain", "B": "Front screen, Middle screen, Back screen", "C": "Orymukha Ezhini, Porumukha Ezhini, Karanthuvaral Ezhini", "D": "Circular screen, Long screen, Short screen"}, "explanation": "The stage featured single-draw curtains (Orymukha), double-center parting curtains (Porumukha), and overhead drop-curtains (Karanthuvaral)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, 