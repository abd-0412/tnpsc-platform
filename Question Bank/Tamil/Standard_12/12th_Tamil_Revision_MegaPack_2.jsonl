{"id": "12th_tamil_mp2_q1804", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "kambar_other_works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கம்பராமாயணத்தைத் தவிர கம்பர் இயற்றிய பிற நூல்களுள் தவறானது எது?", "media_id": null}], "options": {"A": "சடகோபரந்தாதி", "B": "ஏரெழுபது", "C": "சரசுவதி அந்தாதி", "D": "இரட்சணிய யாத்திரிகம்"}, "explanation": "இரட்சணிய யாத்திரிகம் எச்.ஏ. கிருஷ்ணபிள்ளையால் இயற்றப்பட்டது; கம்பர் சடகோபரந்தாதி, ஏரெழுபது, சரசுவதி அந்தாதி, திருக்கை வழக்கம் ஆகியவற்றை இயற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following books was NOT authored by Kambar?", "media_id": null}], "options": {"A": "Sadagopar Anthadhi", "B": "Erezhubathu", "C": "Saraswathi Anthadhi", "D": "Ratchanya Yaathirigam"}, "explanation": "Ratchanya Yaathirigam was authored by H.A. Krishna Pillai, not Kambar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 155, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 155", "url": null, "source_notes": null}, "previous_year": {"is_previous_