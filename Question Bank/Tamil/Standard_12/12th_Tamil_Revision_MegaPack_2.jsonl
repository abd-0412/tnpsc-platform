{"id": "12th_tamil_mp2_q1938", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "u_ve_sa_manuscripts_palm_leaves", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உ.வே. சாமிநாதையர் சுவடி தேடிச் சென்றபோது அவருக்கு முதன்முதலில் 'சீவக சிந்தாமணி' சுவடியை அறிமுகப்படுத்திய சேலம் வழக்கறிஞர் யார்?", "media_id": null}], "options": {"A": "ஆறுமுக நாவலர்", "B": "இராமசுவாமி முதலியார்", "C": "சி.வை. தாமோதரம்பிள்ளை", "D": "பூண்டி அரங்கநாத முதலியார்"}, "explanation": "1880-இல் கும்பகோணம் கல்லூரிக்கு வந்த சேலம் முன்சீப் இராமசுவாமி முதலியார் உ.வே.சாவிடம் சீவக சிந்தாமணிச் சுவடியைத் தந்து பதிப்பிக்கத் தூண்டினார்."}, "en": {"blocks": [{"type": "text", "content": "Which Salem munsif/advocate first handed palm-leaf manuscripts of Seevaka Chinthamani to U.Ve.Sa in 1880, urging him to publish them?", "media_id": null}], "options": {"A": "Arumuga Navalar", "B": "Ramaswamy Mudaliar", "C": "C.W. Damodaram Pillai", "D": "Poondi Ranganatha Mudaliar"}, "explanation": "Salem Munsif Ramaswamy Mudaliar presented U.Ve.Sa with Seevaka Chinthamani palm leaves in 1880."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 72, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 72", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 7", "U.Ve.Sa Career"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp2_q1939", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "bharathi_letter_nellaiyappar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியார் பரலி சு. நெல்லையப்பருக்கு எழுதிய கடிதத்தில் 'தமிழை வளர்ப்பதற்கு எது மிக மிக முக்கியம்' என்று குறிப்பிடுகிறார்?", "media_id": null}], "options": {"A": "பழைய இலக்கணங்களை மட்டுமே பயில்வது", "B": "வெளிநாட்டு மொழிகளைப் புறக்கணிப்பது", "C": "தொழில், அறிவியல், புதிய கலைகளைத் தமிழில் வளர்த்தலும் எளிய நடை அமைத்தலும்", "D": "சமஸ்கிருத சொற்களை மிகுதியாகக் கலப்பது"}, "explanation": "பாரதியார் நெல்லையப்பருக்கு எழுதிய கடிதத்தில் தமிழ் வாழத் தொழிற்கல்வியும் புதிய அறிவியல் சிந்தனைகளும் எளிய உரைநடையும் வேண்டும் என வற்புறுத்துகிறார்."}, "en": {"blocks": [{"type": "text", "content": "In his historical letters to Parali S. Nellaiyappar, what does Bharati prioritize for revitalizing the Tamil language?", "media_id": null}], "options": {"A": "Studying only ancient archaic grammar", "B": "Boycotting all foreign languages", "C": "Developing modern industries, technical sciences, and accessible simple prose in Tamil", "D": "Increasing Sanskrit borrowings"}, "explanation": "Bharati advocated for technical vocations, scientific learning, and simple lucidity in Tamil prose."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "al