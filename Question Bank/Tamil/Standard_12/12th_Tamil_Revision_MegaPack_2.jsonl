{"id": "12th_tamil_mp2_q1845", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "krishna_pillai_professorship", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எச்.ஏ. கிருஷ்ணபிள்ளை தமிழாசிரியராகப் பணியாற்றிய புகழ்பெற்ற கல்லூரி எது?", "media_id": null}], "options": {"A": "திருவனந்தபுரம் மகாராஜா கல்லூரி", "B": "சென்னை மாநிலக் கல்லூரி", "C": "மதுரை அமெரிக்கன் கல்லூரி", "D": "திருச்சி தூய வளனார் கல்லூரி"}, "explanation": "எச்.ஏ. கிருஷ்ணபிள்ளை திருவனந்தபுரம் மகாராஜா கல்லூரியிலும், பாளையங்கோட்டையிலும் தமிழ்ப் பேராசிரியராகப் பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "At which prestigious institution did H.A. Krishna Pillai serve as Tamil Professor?", "media_id": null}], "options": {"A": "Thiruvananthapuram Maharaja College", "B": "Madras Presidency College", "C": "Madurai American College", "D": "Tiruchirappalli St. Joseph's College"}, "explanation": "H.A. Krishna Pillai served as Tamil Professor at Thiruvananthapuram Maharaja's College."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 168, "chapter": null, "section"