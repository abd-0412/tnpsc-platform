{"id": "12th_tamil_mp2_q1901", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thiruvalluva_maalai_panegyric", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளின் பெருமையையும் திருவள்ளுவரின் சிறப்பையும் உலகறியப் போற்றி 53 புலவர்கள் பாடிய 55 பாடல்களைக் கொண்ட பாராட்டு நூல் எது?", "media_id": null}], "options": {"A": "திருவள்ளுவ மாலை", "B": "கலிங்கத்துப்பரணி", "C": "நீதிநெறி விளக்கம்", "D": "நளவெண்பா"}, "explanation": "திருக்குறளைப் போற்றிப் புகழ்ந்து மாங்குடி மருதனார், நக்கீரர், கபிலர் உள்ளிட்ட 53 புலவர்கள் பாடிய 55 பாடல்களின் தொகுப்பே 'திருவள்ளுவ மாலை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which famous panegyric anthology comprises 55 eulogistic verses composed by 53 poets celebrating the divine greatness of Thirukkural?", "media_id": null}], "options": {"A": "Thiruvalluva Maalai", "B": "Kalingathupparani", "C": "Needhineri Vilakkam", "D": "Nalavenba"}, "explanation": "'Thiruvalluva Maalai' compiles 55 celebratory verses composed by 53 poets praising Thirukkural's unparalleled wisdom."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "