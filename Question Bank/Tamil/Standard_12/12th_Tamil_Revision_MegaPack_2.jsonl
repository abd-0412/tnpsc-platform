{"id": "12th_tamil_mp2_q1832", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "ratchanya_yaathirigam_paruvangal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எச்.ஏ. கிருஷ்ணபிள்ளையின் 'இரட்சணிய யாத்திரிகம்' காப்பியம் எத்தனை பருவங்களாகப் பிரிக்கப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "3 பருவங்கள்", "B": "4 பருவங்கள்", "C": "6 பருவங்கள்", "D": "5 பருவங்கள்"}, "explanation": "இரட்சணிய யாத்திரிகம் ஆதி பருவம், குமார பருவம், நிதான பருவம், ஆரணிய பருவம், இரட்சணிய பருவம் என 5 பருவங்களைக் கொண்டது."}, "en": {"blocks": [{"type": "text", "content": "Into how many Paruvams (major sections) is H.A. Krishna Pillai's 'Ratchanya Yaathirigam' divided?", "media_id": null}], "options": {"A": "3 Paruvams", "B": "4 Paruvams", "C": "6 Paruvams", "D": "5 Paruvams"}, "explanation": "Ratchanya Yaathirigam comprises 5 major sections (Aadhi, Kumara, Nidhana, Aaranya, Ratchanya)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 168, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 168", "url": null, "source_not