{"id": "12th_tamil_mp2_q1817", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "porunarattruppadai_hero", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முடத்தாமக் கண்ணியார் பாடிய 'பொருநராற்றுப்படை' நூலின் பாட்டுடைத் தலைவன் யார்?", "media_id": null}], "options": {"A": "கரிகால் பெருவளத்தான் (கரிகால் சோழன்)", "B": "சேரன் செங்குட்டுவன்", "C": "பாண்டியன் நெடுஞ்செழியன்", "D": "தொண்டைமான் இளந்திரையன்"}, "explanation": "பொருநராற்றுப்படை சோழ மன்னன் கரிகால் பெருவளத்தானின் கொடையையும் வெண்ணிப்போர் வெற்றியையும் சிறப்பித்துப் பாடப்பெற்றது."}, "en": {"blocks": [{"type": "text", "content": "Who is the celebrated patron hero of 'Porunarattruppadai' sung by Mudatthamakkanniyar?", "media_id": null}], "options": {"A": "Karikala Peruvalathan (Karikala Chola)", "B": "Cheran Senguttuvan", "C": "Pandiyan Nedunchezhiyan", "D": "Thondaiman Ilanthiraiyan"}, "explanation": "Mudatthamakkanniyar eulogized Karikala Chola's peerless munificence and military victory at Venni."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 152, "chapter": null, "section": null