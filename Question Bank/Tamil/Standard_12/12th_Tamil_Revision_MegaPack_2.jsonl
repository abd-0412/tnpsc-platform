{"id": "12th_tamil_mp2_q1827", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "ratchanya_pilgrim_progress_source", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எச்.ஏ. கிருஷ்ணபிள்ளை இயற்றிய 'இரட்சணிய யாத்திரிகம்' ஜான் பனியன் எழுதிய எந்த ஆங்கில நூலின் தழுவல் ஆகும்?", "media_id": null}], "options": {"A": "Paradise Lost", "B": "The Holy War", "C": "The Pilgrim's Progress", "D": "Grace Abounding"}, "explanation": "ஜான் பனியன் (John Bunyan) ஆங்கிலத்தில் எழுதிய 'தி பில்கிரிம்ஸ் புரோகிரசு' (The Pilgrim's Progress) என்ற உருவக நூலின் தமிழ் வழிநூலே இரட்சணிய யாத்திரிகம் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "H.A. Krishna Pillai's epic 'Ratchanya Yaathirigam' is a poetic Tamil adaptation of which English classic by John Bunyan?", "media_id": null}], "options": {"A": "Paradise Lost", "B": "The Holy War", "C": "The Pilgrim's Progress", "D": "Grace Abounding"}, "explanation": "Ratchanya Yaathirigam is the classical Tamil verse adaptation of John Bunyan's allegorical masterpiece 'The Pilgrim's Progress'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edi