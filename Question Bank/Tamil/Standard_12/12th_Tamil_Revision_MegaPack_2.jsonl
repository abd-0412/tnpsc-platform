{"id": "12th_tamil_mp2_q1772", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "silappathikaram_stage_dimensions", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகார அரங்கேற்று காதையில் ஆடல் அரங்கு அமைப்பதற்குரிய தகுந்த மூங்கில் கோலின் அளவு யாது?", "media_id": null}], "options": {"A": "பன்னிரண்டு விரல் நீளம் கொண்ட மூங்கில்", "B": "பதினாறு விரல் நீளம் கொண்ட மூங்கில்", "C": "இருபது விரல் நீளம் கொண்ட மூங்கில்", "D": "இருபத்து நான்கு விரல் நீளம் கொண்ட மூங்கில்"}, "explanation": "நூலோர் விதித்த இயல்பினையுடைய ஒரு சாண் அல்லது இருபத்து நான்கு விரல் இடைப்பகுதி கொண்ட மூங்கிலைக் கொண்டு ஆடல் அரங்கு அமைக்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "According to Silappathikaram Arangetru Kaathai, what was the measuring bamboo rod's specified dimension?", "media_id": null}], "options": {"A": "Bamboo rod span of 12 fingers length", "B": "Bamboo rod span of 16 fingers length", "C": "Bamboo rod span of 20 fingers length", "D": "Bamboo rod span of 24 finger breadths (one Saan)"}, "explanation": "The dance theater was designed based on a bamboo rod measuring twenty-four finger breadths (one Saan)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Na