{"id": "12th_tamil_mp2_q1788", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "silappathikaram_epic_trio", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரத்தை முதன்முதலில் 'உரையிடையிட்ட பாட்டுடைச் செய்யுள்' என்று குறிப்பிட்டவர் யார்?", "media_id": null}], "options": {"A": "சீத்தலைச் சாத்தனார்", "B": "அடியார்க்குநல்லார்", "C": "உ.வே. சாமிநாதையர்", "D": "இளங்கோவடிகள் (பதிகத்தில்)"}, "explanation": "சிலப்பதிகார பதிகத்திலேயே இளங்கோவடிகள் இந்நூலை உரைநடையும் பாடலும் கலந்த 'உரையிடையிட்ட பாட்டுடைச் செய்யுள்' எனக் குறிப்பிடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Who designated Silappathikaram as 'Uraiyidaiyitta Paattudai Seyyul' in its prologue?", "media_id": null}], "options": {"A": "Seethalai Saathanar", "B": "Adiyarkkunallar", "C": "U.V. Swaminatha Iyer", "D": "Ilango Adigal (in Pathigam)"}, "explanation": "Ilango Adigal himself describes the epic as 'Uraiyidaiyitta Paattudai Seyyul' in the epic's Pathigam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 128, "chapter": null, "section": null, "reference"