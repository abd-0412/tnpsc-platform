{"id": "12th_tamil_mp2_q1771", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "thalaikkulam_author", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தலைக்குளம்' என்ற நெகிழ்ச்சியான சிறுகதையின் ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "தி. ஜானகிராமன்", "B": "அசோகமித்திரன்", "C": "தோப்பில் முகமது மீரான்", "D": "சு. சமுத்திரம்"}, "explanation": "'தலைக்குளம்' சிறுகதையின் ஆசிரியர் சாகித்திய அகாதெமி விருது பெற்ற தோப்பில் முகமது மீரான் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the poignant short story 'Thalaikkulam'?", "media_id": null}], "options": {"A": "T. Janakiraman", "B": "Ashokamitran", "C": "Thoppil Mohamed Meeran", "D": "Su. Samuthiram"}, "explanation": "Sahitya Akademi laureate Thoppil Mohamed Meeran authored the touching short story 'Thalaikkulam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 117, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 117", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exa