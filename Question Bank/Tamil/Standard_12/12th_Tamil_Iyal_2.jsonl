{"id": "12th_tamil_u2_q241", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "piragoru_naal_kodai", "chapter_id": null, "topic_id": "philosophical_reflection", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இக்கவிதையின் வழி கவிஞர் வெளிப்படுத்தும் மனித வாழ்வியல் தத்துவம் என்ன?", "media_id": null}], "options": {"A": "துன்பமும் இன்பமும் மழையும் கோடையும் போல அடுத்தடுத்து மாறக்கூடியவை", "B": "வாழ்க்கை நிலையானது", "C": "துன்பம் மட்டுமே நிலையானது", "D": "மனிதனால் இயற்கையை வெல்ல முடியும்"}, "explanation": "மழை நின்றவுடன் கோடை தோன்றுவது போல மனித வாழ்வில் இன்பமும் துன்பமும் மாறி மாறி வரக்கூடியவை என்பதை இயற்கை வழியே உணர்த்துகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What subtle humanistic philosophical truth is reflected through the poem's contemplation of nature?", "media_id": null}], "options": {"A": "Joy and sorrow alternate in life just as monsoon rain yields to summer sunshine", "B": "Human mundane life is eternal and immutable", "C": "Suffering alone is permanent", "D": "Man can completely conquer nature"}, "explanation": "Like the alternating sequence of showers and sunshine, sorrow and delight are transient phases in human life."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook