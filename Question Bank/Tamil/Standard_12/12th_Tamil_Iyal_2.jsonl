{"id": "12th_tamil_u2_q271", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "nedunalvaadai", "chapter_id": null, "topic_id": "shepherd_cold_reaction", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நெடுநல்வாடையில் ஆயர்கள் (இடையர்கள்) குளிரைப் போக்க எதனைச் செய்தனர்?", "media_id": null}], "options": {"A": "சூடான பாலைக் குடித்தனர்", "B": "வீடுகளுக்குள் சென்று கதவை அடைத்துக் கொண்டனர்", "C": "கொள்ளி நெருப்பினால் கைகளைச் சூடாக்கிக் கன்னங்களில் வைத்துக் குளிரைப் போக்க முயன்றனர்", "D": "கம்பளி ஆடைகளை வாங்கினர்"}, "explanation": "ஆயர்கள் கொள்ளி நெருப்பைக் கைகளில் ஏந்தி, தம் கைகளை அனலில் காட்டி, நடுங்கும் கன்னங்களில் வைத்து வெப்பமேற்ற முயன்றனர்."}, "en": {"blocks": [{"type": "text", "content": "How did pastoral cowherds attempt to stave off the biting freeze in Nedunalvaadai?", "media_id": null}], "options": {"A": "Drinking piping hot milk", "B": "Locking themselves indoors", "C": "Kindling burning embers to warm their palms and pressing them against freezing cheeks", "D": "Purchasing woolen blankets"}, "explanation": "Cowherds ignited embers to warm their frostbitten palms, pressing them against their shivering cheeks."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corp