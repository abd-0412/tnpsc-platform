{"id": "12th_tamil_u2_q209", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "perumazhaikaalam", "chapter_id": null, "topic_id": "water_bodies_conservation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மாமழை போற்றுதும் மாமழை போற்றுதும்’ என்று பாடிய இளங்கோவடிகளின் கூற்றிற்கேற்ப, நீரைச் சேமிக்கத் தமிழக முன்னோர்கள் உருவாக்கிய நீர்நிலைகளுள் அடங்காதது எது?", "media_id": null}], "options": {"A": "செயற்கை நீரூற்று (பாறை வெடிப்பு)", "B": "ஏரி, குளம், கண்மாய்", "C": "தாங்கல், ஏந்தல், ஊருணி", "D": "குட்டை, கேணி, சுனை"}, "explanation": "தமிழர்கள் ஏரி, குளம், கண்மாய், தாங்கல், ஏந்தல், ஊருணி, குட்டை, கேணி போன்ற எண்ணற்ற நீர்நிலைகளை உருவாக்கினர்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following was NOT among the traditional water storage structures created by ancient Tamils?", "media_id": null}], "options": {"A": "Artificial water fountains via rock blasting", "B": "Eri, Kulam, Kanmai", "C": "Thaangal, Eanthal, Ooruni", "D": "Kuttai, Keni, Sunai"}, "explanation": "Ancient Tamils designed organic surface water systems like Eri, Kanmai, Thaangal, Ooruni, Kulam, and Keni."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term