{"id": "12th_tamil_u2_q260", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "nedunalvaadai", "chapter_id": null, "topic_id": "season_koodhir", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நெடுநல்வாடை விவரிக்கும் முதன்மையான பருவம் (காலம்) எது?", "media_id": null}], "options": {"A": "இளவேனில் பருவம்", "B": "முதுவேனில் பருவம்", "C": "கார் காலம் மட்டும்", "D": "கூதிர் பருவம் (ஐப்பசி, கார்த்திகை மாதங்களின் குளிர்காலம்)"}, "explanation": "நெடுநல்வாடை ஐப்பசி, கார்த்திகை மாதங்களுக்குரிய கூதிர் பருவத்தின் கடும் குளிர் நடுக்கத்தைப் படம் பிடித்துக் காட்டுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which major climatic season of the classical Tamil calendar forms the atmospheric backdrop of Nedunalvaadai?", "media_id": null}], "options": {"A": "Iilavenil (Early Spring)", "B": "Mudhuvenil (High Summer)", "C": "Kar Kaalam (Early Rains)", "D": "Koodhir Kaalam (Late rainy chilly winter - Aippasi, Kaarthigai)"}, "explanation": "Nedunalvaadai vividly captures Koodhir season spanning the Tamil months of Aippasi and Kaarthigai with piercing cold."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 31, "chapter": null, "section": null, "reference": "12th Tamil, Unit 2, Page 31", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 2", "Nedunalvaadai", "Season"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u2_q261", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "nedunalvaadai", "chapter_id": null, "topic_id": "cow_cold_reaction", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூதிர் பருவத்தின் கடும் குளிரால் பசுக்கள் எத்தகைய நிலையை அடைந்ததாக நக்கீரர் பாடுகிறார்?", "media_id": null}], "options": {"A": "மேய்ச்சலை மறந்து, கன்றுகளுக்குப் பாலூட்டாமல் கால்களை மாற்றி மாற்றி வைத்து நடுங்கின", "B": "ஆற்றைக் கடந்து ஓடின", "C": "புற்களை வேகமாக மேய்ந்தன", "D": "மகிழ்ச்சியுடன் துள்ளிக்குதித்தன"}, "explanation": "கடும் குளிரினால் பசுக்கள் புல் மேய்வதையும் மறந்து, தம்மை நாடி வந்த கன்றுகளைக் குளிரினால் உதைத்துத் தள்ளி நடுங்கின என நக்கீரர் வருணிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "How does Nakkirar poignantly depict cattle suffering under the relentless freeze of the winter gale?", "media_id": null}], "options": {"A": "Forgetting pasture, kicking away suckling calves, and shifting hooves in shivering chill", "B": "Splashing swimming across swollen rivers", "C": "Voraciously grazing green grass", "D": "Prancing with joyous abandon"}, "explanation": "Cows forget grazing on pastures and even kick away their own calves due to the unbearable shuddering cold."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 31, "chapter": null, "section": null, "reference": "12th Tamil, Unit 2, Page 31", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 2", "Nedunalvaadai", "Cattle Description"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
