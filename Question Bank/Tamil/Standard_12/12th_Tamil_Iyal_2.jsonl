{"id": "12th_tamil_u2_q347", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mozhi_thiran_u2", "chapter_id": null, "topic_id": "proverb_completion_well", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழமொழியை நிறைவு செய்க: ‘நீர் அடித்து _________ விலகாது.’", "media_id": null}], "options": {"A": "மண்", "B": "மீன்", "C": "நீர்", "D": "பாறை"}, "explanation": "‘நீர் அடித்து நீர் விலகாது’ என்பது ஒற்றுமையையும் உற்றார் உறவுகளின் பிரிக்க முடியாத அன்பையும் குறிக்கும் மரபுப் பழமொழியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Complete the traditional proverb: 'Neer adithu ________ vilagaadhu':", "media_id": null}], "options": {"A": "Mann (Soil)", "B": "Meen (Fish)", "C": "Neer (Water)", "D": "Paarai (Rock)"}, "explanation": "The proverb is 'Neer adithu neer vilagaadhu' (Striking water will not sever water)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "reference": "12th Tamil, Unit 2, Page 41", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "se