{"id": "12th_tamil_u2_q340", "schema_version": "1.0", "kind": "matching", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mozhi_thiran_u2", "chapter_id": null, "topic_id": "glossary_matching_weather", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கலைச்சொற்களைப் பொருத்துக:\n1. Weather - அ) சூழலியல் சமநிலை\n2. Climate - ஆ) நீடித்த வளர்ச்சி\n3. Ecological balance - இ) காலநிலை\n4. Sustainable development - ஈ) வானிலை", "media_id": null}], "options": {"A": "1-அ, 2-ஆ, 3-இ, 4-ஈ", "B": "1-இ, 2-ஈ, 3-அ, 4-ஆ", "C": "1-ஆ, 2-இ, 3-ஈ, 4-அ", "D": "1-ஈ, 2-இ, 3-அ, 4-ஆ"}, "explanation": "Weather - வானிலை; Climate - காலநிலை; Ecological balance - சூழலியல் சமநிலை; Sustainable development - நீடித்த வளர்ச்சி. சரியான பொருத்தம்: 1-ஈ, 2-இ, 3-அ, 4-ஆ."}, "en": {"blocks": [{"type": "text", "content": "Match the environmental technical terms:\n1. Weather - a) Ecological balance\n2. Climate - b) Sustainable development\n3. Ecological balance - c) Climate (Kaalanilai)\n4. Sustainable development - d) Weather (Vaanilai)", "media_id": null}], "options": {"A": "1-a, 2-b, 3-c, 4-d", "B": "1-c, 2-d, 3-a, 4-b", "C": "1-b, 2-c, 3-d, 4-a", "D": "1-d, 2-c, 3-a, 4-b"}, "explanation": "Weather: d, Climate: c, Ecological balance: a, Sustainable development: b."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher"