{"id": "12th_tamil_u2_q299", "schema_version": "1.0", "kind": "matching", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "short_stories_authors_match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நவீனத் தமிழ் சிறுகதைகளையும் அவற்றின் ஆசிரியர்களையும் பொருத்துக:\n1. முதல் கல் - அ) தோப்பில் முகம்மது மீரான்\n2. உரிமைத்தாகம் - ஆ) உத்தமசோழன்\n3. தலைக்குளம் - இ) அ. முத்துலிங்கம்\n4. ஆறாம் திணை - ஈ) பூமணி", "media_id": null}], "options": {"A": "1-அ, 2-ஆ, 3-இ, 4-ஈ", "B": "1-ஈ, 2-இ, 3-ஆ, 4-அ", "C": "1-ஆ, 2-ஈ, 3-அ, 4-இ", "D": "1-இ, 2-அ, 3-ஈ, 4-ஆ"}, "explanation": "முதல் கல் - உத்தமசோழன்; உரிமைத்தாகம் - பூமணி; தலைக்குளம் - தோப்பில் முகம்மது மீரான்; ஆறாம் திணை - அ. முத்துலிங்கம். சரியான பொருத்தம்: 1-ஆ, 2-ஈ, 3-அ, 4-இ."}, "en": {"blocks": [{"type": "text", "content": "Match the prescribed supplementary stories with their respective authors:\n1. Mudhal Kal - a) Thoppil Mohamed Meeran\n2. Urimaithagam - b) Uthamasozhan\n3. Thalaikkulam - c) A. Muthulingam\n4. Aaraam Thinai - d) Poomani", "media_id": null}], "options": {"A": "1-a, 2-b, 3-c, 4-d", "B": "1-d, 2-c, 3-b, 4-a", "C": "1-b, 2-d, 3-a, 4-c", "D": "1-c, 2-a, 3-d, 4-b"}, "explanation": "Mudhal Kal: Uthamasozhan; Urimaithagam: Poomani; Thalaikkulam: Thoppil Meeran; Aaraam Thinai: A. Muthulingam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type