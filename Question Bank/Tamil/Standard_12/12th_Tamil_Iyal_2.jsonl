{"id": "12th_tamil_u2_q291", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "villagers_hesitation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெள்ள நீரை வடிக்க ஊர் மக்கள் ஏன் உடனடியாக முன்வரவில்லை?", "media_id": null}], "options": {"A": "ஊருக்குள் யாருக்கும் பயிர்கள் இல்லை என்பதால்", "B": "அரசு இழப்பீடு தரும் என்று நம்பியதால்", "C": "‘யாராவது இறங்கினால் பார்த்துக் கொள்ளலாம்’ என்ற தயக்கமும், தன்னலப் போக்கும், முதல் அடியை எடுத்துவைக்கத் தயங்கியதும்", "D": "அவர்களுக்கு நீச்சல் தெரியாது என்பதால்"}, "explanation": "எல்லாரும் வேடிக்கை பார்த்தார்களே தவிர, ‘நாம் ஏன் முதலில் இறங்க வேண்டும்’ என்ற தயக்கமும் அலட்சியமுமே மக்களைத் தடுத்தது."}, "en": {"blocks": [{"type": "text", "content": "Why were the gathered villagers initially reluctant to step into the swirling water to clear the sluice?", "media_id": null}], "options": {"A": "None of them owned any crops in the inundated fields", "B": "Awaiting official government relief subsidies", "C": "Collective hesitation, bystander apathy, and reluctance of anyone to initiate the first move", "D": "Inability to swim in water"}, "explanation": "Bystander apathy held the villagers back: each stood watching on the bank, waiting for someone else to plunge in first."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}