{"id": "12th_tamil_u2_q294", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "crowd_reaction_to_alli", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மருதனும் அல்லியும் இணைந்து கல்லைத் தூக்குவதைக் கண்ட ஊர் மக்களிடையே ஏற்பட்ட மனமாற்றம் என்ன?", "media_id": null}], "options": {"A": "அவர்களைப் பார்த்து ஏளனமாகச் சிரித்தனர்", "B": "குற்ற உணர்வும் வெட்கமும் கொண்டு, ஒருவர் பின் ஒருவராக ஊரே வெள்ளத்தில் இறங்கிக் கற்களை அகற்றத் தொடங்கியது", "C": "அவர்களைக் கரையேறும்படி திட்டினர்", "D": "ஊரை விட்டு ஓடிப்போயினர்"}, "explanation": "ஒரு பெண்ணும் அவளது கணவனும் உழைப்பதைக் கண்ட மக்கள் வெட்கித் தலைகுனிந்து, தாமும் வெள்ளத்தில் குதித்து வேலையை முடித்தனர்."}, "en": {"blocks": [{"type": "text", "content": "What psychological transformation took place among the onlookers upon witnessing Marudhan and Alli working together in the torrent?", "media_id": null}], "options": {"A": "They mocked them derisively from the bank", "B": "Overwhelmed with shame and collective conscience, one after another leaped into the waters to heave the stones", "C": "Ordered them to climb out immediately", "D": "Fled from the village"}, "explanation": "Stirred by shame and awakened solidarity, the entire village plunged into the water, transforming isolation into community triumph."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.