{"id": "12th_tamil_u2_q292", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "marudhan_action", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மக்கள் தயங்கி நின்ற சூழலில் மருதன் செய்த புரட்சிகரமான செயல் என்ன?", "media_id": null}], "options": {"A": "ஊர் பஞ்சாயத்தைக் கூட்டினான்", "B": "அரசு அதிகாரிகளுக்கு மனு எழுதினான்", "C": "வீட்டிற்குத் திரும்பிச் சென்று கதவை அடைத்தான்", "D": "யாரையும் எதிர்பாராமல் தானே வேட்டியை வரிந்துகட்டி வெள்ளத்தில் இறங்கி அடைத்திருந்த முதல் கல்லைத் தூக்கினான்"}, "explanation": "மருதன் யாருடைய உதவிக்கும் காத்திருக்காமல் வெள்ளத்தில் குதித்து, தனியொருவனாக அந்த அடைப்புக் கல்லை அகற்றத் தொடங்கினான்."}, "en": {"blocks": [{"type": "text", "content": "What bold initiative did Marudhan take when the entire crowd stood hesitant on the bank?", "media_id": null}], "options": {"A": "Convened an urgent village panchayat council", "B": "Drafted a petition to district revenue officers", "C": "Walked back home in exasperation", "D": "Girded his waistcloth and plunged alone into the surging floodwaters to dislodge the first heavy stone"}, "explanation": "Without waiting for others, Marudhan jumped straight into the swirling deluge and single-handedly wrestled the first boulder."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"typ