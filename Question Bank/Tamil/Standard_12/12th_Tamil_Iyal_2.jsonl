{"id": "12th_tamil_u2_q272", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "nedunalvaadai", "chapter_id": null, "topic_id": "neem_garland_reference", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நெடுநல்வாடையில் பாண்டியனின் அடையாள மலராகக் குறிப்பிடப்பட்டுள்ள மலர் எது?", "media_id": null}], "options": {"A": "அத்தி மலர்", "B": "பனம்பூ மலர்", "C": "வஞ்சி மலர்", "D": "வேப்பம்பூ மலர்"}, "explanation": "சேரனுக்குப் பனம்பூ, சோழனுக்கு அத்திப்பூ, பாண்டியனுக்கு வேப்பம்பூ அடையாள மலர்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which floral garland is explicitly identified as the royal insignia of the Pandya dynasty in Nedunalvaadai?", "media_id": null}], "options": {"A": "Athipoo (Fig flower)", "B": "Panampoo (Palmyra flower)", "C": "Vanchipoo", "D": "Veppampoo (Neem flower garland)"}, "explanation": "The royal insignia flower of the Pandyas is the Neem flower (Veppampoo), which appears in the text."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 32, "chapter": null, "section": null, "reference": "12th Tamil, Unit 2, Page 32", "url": null, "source_notes": null}, "previous_year