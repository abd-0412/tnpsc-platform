{"id": "12th_tamil_u2_q310", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "naalvagai_poruthangal", "chapter_id": null, "topic_id": "thinai_types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் இலக்கணத்தில் ‘திணை’ எத்தனை வகைப்படும்? அவை யாவை?", "media_id": null}], "options": {"A": "மூன்று வகைப்படும் (அகம், புறம், அகப்புறம்)", "B": "இரண்டு வகைப்படும் (உயர்திணை, அஃறிணை)", "C": "ஐந்து வகைப்படும் (குறிஞ்சி, முல்லை, மருதம், நெய்தல், பாலை)", "D": "நான்கு வகைப்படும்"}, "explanation": "சொல் இலக்கணத்தில் திணை இரண்டு வகைப்படும்; அவை: 1. உயர்திணை (மக்கள், தேவர், நரகர்), 2. அஃறிணை (மக்களல்லாத பிற உயிர்களும் உயிரற்ற பொருட்களும்)."}, "en": {"blocks": [{"type": "text", "content": "How many categories of 'Thinai' (Noun Class) are recognized in Tamil grammar?", "media_id": null}], "options": {"A": "Three types (Akam, Puram, Akappuram)", "B": "Two types (Uyar Thinai - Higher Class, Ahri-nai - Non-rational Class)", "C": "Five types (Kurinji, Mullai, Marudham, Neidhal, Paalai)", "D": "Four types"}, "explanation": "Thinai divides into Uyar Thinai (humans/rational beings) and Ahri-nai (non-human animals and inanimate objects)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpo