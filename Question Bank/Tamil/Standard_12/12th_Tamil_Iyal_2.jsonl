{"id": "12th_tamil_u2_q213", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "perumazhaikaalam", "chapter_id": null, "topic_id": "disaster_management_stages", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பேரிடர் மேலாண்மையின் மூன்று முக்கியக் கட்டங்கள் எவை?", "media_id": null}], "options": {"A": "பேரிடருக்கு முந்தைய முன்னெச்சரிக்கை, பேரிடரின் போது மீட்பு, பேரிடருக்குப் பிந்தைய மறுசீரமைப்பு", "B": "மழை அளவிடுதல், அணை கட்டுதல், வரி வசூலித்தல்", "C": "நகர விரிவாக்கம், காடழிப்பு, கட்டடம் கட்டுதல்", "D": "சுற்றுலா திட்டமிடல், நிதி திரட்டுதல், விளம்பரம் செய்தல்"}, "explanation": "பேரிடர் மேலாண்மை: 1. பேரிடர் முன்னெச்சரிக்கை, 2. பேரிடரின் போதான மீட்புப் பணிகள், 3. பேரிடருக்குப் பிந்தைய நிவாரணம் மற்றும் மறுவாழ்வு."}, "en": {"blocks": [{"type": "text", "content": "What are the three fundamental chronological phases of disaster management?", "media_id": null}], "options": {"A": "Pre-disaster preparedness, During-disaster rescue, Post-disaster rehabilitation", "B": "Rain gauge recording, Dam construction, Tax collection", "C": "Urban sprawl, Deforestation, High-rise construction", "D": "Tourism planning, Fundraising, Advertising"}, "explanation": "The three pillars are pre-disaster mitigation/readiness, emergency response during calamity, and post-disaster recovery/restoration."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_