{"id": "12th_tamil_u2_q317", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "naalvagai_poruthangal", "chapter_id": null, "topic_id": "concord_error_identification", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திணை மற்றும் பால் வழுவமைதியற்ற ‘தவறான’ தொடரைக் கண்டறிக:", "media_id": null}], "options": {"A": "பசுக்கள் புல் மேய்ந்தது.", "B": "பசுக்கள் புல் மேய்ந்தன.", "C": "மாணவர்கள் தேர்வு எழுதினர்.", "D": "நிலா வந்தாள்."}, "explanation": "‘பசுக்கள்’ என்பது அஃறிணைப் பன்மை (பலவின்பால்); எனவே ‘மேய்ந்தன’ என வருதலே சரி. ‘மேய்ந்தது’ (ஒன்றன்பால்) என்பது வழுவாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the grammatically incorrect sentence containing a concord error:", "media_id": null}], "options": {"A": "Pasukkal pul meindhadhu.", "B": "Pasukkal pul meindhana.", "C": "Maanavargal thervu ezhudhinar.", "D": "Nila vandhaal."}, "explanation": "'Pasukkal' is neuter plural; hence the verb must be 'meindhana', not singular 'meindhadhu'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 39, "chapter": null, "section": null, "reference": "12th Tamil, Unit 2, Page 39", "url": null,