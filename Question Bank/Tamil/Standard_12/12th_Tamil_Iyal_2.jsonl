{"id": "12th_tamil_u2_q264", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "nedunalvaadai", "chapter_id": null, "topic_id": "king_encampment_duty", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நெடுநல்வாடையில் பாண்டிய மன்னன் கூதிர்ப்பாசறையில் நள்ளிரவிலும் என்ன செய்து கொண்டிருக்கிறான்?", "media_id": null}], "options": {"A": "அரண்மனையில் உறங்கிக் கொண்டிருக்கிறான்", "B": "விருந்துண்டு மகிழ்கிறான்", "C": "வேட்டையாடச் சென்றுள்ளான்", "D": "போரில் புண்பட்ட வீரர்களையும் குதிரைகளையும் நள்ளிரவிலும் தாமே நேரில் சென்று நலம் விசாரித்துத் தேற்றுகிறான்"}, "explanation": "மன்னன் நெடுஞ்செழியன் போர்க்களத்தில் காயமுற்ற போர்வீரர்களையும் குதிரைகளையும் நள்ளிரவிலும் குளிர் பாராது நேரில் சென்று ஆறுதல் கூறிப் போற்றுகிறான்."}, "en": {"blocks": [{"type": "text", "content": "What exalted royal duty does Pandya King Nedunchezhian carry out during the freezing midnight in his military encampment?", "media_id": null}], "options": {"A": "Sleeping comfortably inside a fortified citadel", "B": "Feasting at a royal banquet", "C": "Embarking on a royal hunting expedition", "D": "Personally inspecting wounded warriors and warhorses at midnight to console and inspire them"}, "explanation": "The king braves the freezing midnight wind carrying a torch to comfort his wounded soldiers and ailing horses."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_mul