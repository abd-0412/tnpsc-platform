{"id": "12th_tamil_u2_q321", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "naalvagai_poruthangal", "chapter_id": null, "topic_id": "paal_vazhuvamaidhi_example", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாயானவள் தன் பெண் குழந்தையைப் பார்த்து ‘வாடா என் செல்லக் கண்ணா’ என ஆண்பாலாக விளிப்பது எவ்வகை வழுவமைதி?", "media_id": null}], "options": {"A": "பால் வழுவமைதி (உவப்பின் காரணமாகப் பெண்பாலை ஆண்பாலாகக் கூறுதல்)", "B": "திணை வழுவமைதி", "C": "மரபு வழுவமைதி", "D": "எண் வழுவமைதி"}, "explanation": "பெண் குழந்தையை அன்பின் மிகுதியால் ஆண்பாலாக விளித்து அழைப்பது ‘பால் வழுவமைதி’ எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "A mother affectionately addressing her infant daughter as 'Vaadaa en Chella Kanna' (masculine call) is an instance of what?", "media_id": null}], "options": {"A": "Paal Vazhuvamaidhi (Gender anomaly tolerated through love)", "B": "Thinai Vazhuvamaidhi", "C": "Marabu Vazhuvamaidhi", "D": "En Vazhuvamaidhi"}, "explanation": "Addressing a female child in the masculine gender due to intense motherly affection is Paal Vazhuvamaidhi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "