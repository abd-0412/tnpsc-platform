{"id": "12th_tamil_u2_q207", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "perumazhaikaalam", "chapter_id": null, "topic_id": "chennai_floods_year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சென்னையில் ஒரே நாளில் வரலாறு காணாத பெருமழை பெய்து பெரும் வெள்ளப் பேரிடர் ஏற்பட்ட ஆண்டு எது?", "media_id": null}], "options": {"A": "2010 டிசம்பர்", "B": "2012 நவம்பர்", "C": "2015 டிசம்பர்", "D": "2018 ஆகஸ்ட்"}, "explanation": "2015-ஆம் ஆண்டு டிசம்பர் மாதம் சென்னையில் வரலாறு காணாத பெருமழை பெய்து பெரும் வெள்ளப்பெருக்கு ஏற்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "In which year and month did Chennai experience unprecedented torrential deluge and catastrophic urban floods?", "media_id": null}], "options": {"A": "December 2010", "B": "November 2012", "C": "December 2015", "D": "August 2018"}, "explanation": "Chennai witnessed record-breaking historic deluge and catastrophic urban flooding in December 2015."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 24, "chapter": null, "section": null, "reference": "12th Tamil, Unit 2, Page 24", "url": null, "source_notes": null}, "previ