{"id": "12th_tamil_u2_q240", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "piragoru_naal_kodai", "chapter_id": null, "topic_id": "poetic_contrast", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பிறகொரு நாள் கோடை’ கவிதையில் முரண்பட்டு நிற்கும் இரு இயற்கை நிலைகள் எவை?", "media_id": null}], "options": {"A": "இரவு மற்றும் விடியல்", "B": "புயல் மற்றும் சுனாமி", "C": "நிலநடுக்கம் மற்றும் எரிமலை", "D": "மழைக்காலக் குளிர்ச்சியும் சுட்டெரிக்கும் கோடை வெயிலும்"}, "explanation": "மழைக்காலத்தின் குளிர்ந்த நீர்மைத் தன்மையும், அதன் பின் உடனடியாக எழும் கோடை வெயிலின் வெம்மையும் முரண்பாடாக விவரிக்கப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Which two contrasting states of the natural elements are juxtapositioned in the poem?", "media_id": null}], "options": {"A": "Nocturnal darkness and golden dawn", "B": "Cyclone and tsunami", "C": "Earthquake and volcanic eruption", "D": "Monsoon coolness and blazing summer heat"}, "explanation": "The poem contrasts the tranquil coolness of retreating rain with the sudden searing blaze of summer heat."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "pa