{"id": "12th_tamil_u2_q269", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "nedunalvaadai", "chapter_id": null, "topic_id": "valan_erbu_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வையகம் பனிப்ப வலனேர்பு வளைஇப்\nபொய்யா வானம் புதுப்பெயல் பொழிந்தென’ - இப்பாடல் வரியில் ‘வலனேர்பு’ என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "வலப்பக்கமாக எழுந்து (மேகம் மலையை வலமாகச் சூழ்ந்து)", "B": "வலது கையை உயர்த்தி", "C": "வலப்புறம் பார்த்து", "D": "வெற்றி பெற்று"}, "explanation": "வலனேர்பு என்றால் மேகம் மலையை வலப்பக்கமாகச் சூழ்ந்து எழுந்து நின்று என்பது பொருளாகும்."}, "en": {"blocks": [{"type": "text", "content": "What does 'Valanerpu' signify in the opening line 'Vaiyagam panippa valanerpu valaii...'?", "media_id": null}], "options": {"A": "Rising clockwise / circumambulating mountain towards the right", "B": "Raising the right palm", "C": "Gazing toward the right", "D": "Achieving conquest"}, "explanation": "'Valanerpu' denotes rain clouds ascending and circling the mountains to the right (clockwise)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 31, "chapter": nul