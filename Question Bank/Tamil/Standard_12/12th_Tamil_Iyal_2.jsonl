{"id": "12th_tamil_u2_q231", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "piragoru_naal_kodai", "chapter_id": null, "topic_id": "poem_lines_water_drop", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மழை நின்ற பிறகும் இலைகளின் நுனிகளில்\nதுளிர்த்து நிற்கும் நீர்மப் பளிங்குகள்’ - இக்கவிதை வரிகள் வெளிப்படுத்தும் உணர்வு எது?", "media_id": null}], "options": {"A": "அச்ச உணர்வு", "B": "கோப உணர்வு", "C": "இயற்கையின் நுண்ணிய அழகியல் நயம்", "D": "விரக்தி உணர்வு"}, "explanation": "மழை நின்ற பின் இலை நுனிகளில் தங்கி நிற்கும் நீர்த்துளிகளை ‘நீர்மப் பளிங்குகள்’ என அழகியல் நயத்தோடு கவிஞர் வருணிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "What aesthetic sentiment is evoked by the lines describing water droplets lingering on leaf tips after rainfall?", "media_id": null}], "options": {"A": "Sense of terror", "B": "Vengeful rage", "C": "Subtle aesthetic appreciation of natural stillness", "D": "Despair and hopelessness"}, "explanation": "The lingering raindrops on foliage are poetically likened to liquid crystals reflecting nature's tranquil beauty."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "20