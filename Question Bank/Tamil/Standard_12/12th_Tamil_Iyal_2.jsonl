{"id": "12th_tamil_u2_q208", "schema_version": "1.0", "kind": "statement", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "perumazhaikaalam", "chapter_id": null, "topic_id": "greenhouse_gases", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பசுமைக்குடில் வாயுக்கள் குறித்த பின்வரும் கூற்றுகளில் சரியானது எது?\nகூற்று 1: கார்பன் டை ஆக்சைடு, மீத்தேன், நைட்ரஸ் ஆக்சைடு போன்றவை பசுமைக்குடில் வாயுக்கள் ஆகும்.\nகூற்று 2: இவை புவியிலிருந்து வெளியேறும் வெப்பத்தை வளிமண்டலத்திலேயே தடுத்து நிறுத்துகின்றன.", "media_id": null}], "options": {"A": "கூற்று 1 மட்டும் சரி", "B": "கூற்று 2 மட்டும் சரி", "C": "இரண்டு கூற்றுகளும் தவறு", "D": "இரண்டு கூற்றுகளும் சரி"}, "explanation": "கார்பன் டை ஆக்சைடு, மீத்தேன் உள்ளிட்டவை பசுமைக்குடில் வாயுக்கள்; இவை புவியின் கதிர்வீச்சு வெப்பத்தைத் தக்கவைத்து வெப்பத்தை உயர்த்துகின்றன. இரண்டும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the statements regarding greenhouse gases:\nStatement 1: Carbon dioxide, methane, and nitrous oxide are primary greenhouse gases.\nStatement 2: They trap thermal radiation radiated from Earth within the atmosphere.", "media_id": null}], "options": {"A": "Statement 1 only is correct", "B": "Statement 2 only is correct", "C": "Both statements are incorrect", "D": "Both statements are correct"}, "explanation": "Both statements accurately describe greenhouse gases and their infrared heat-trapping mechanism."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": f