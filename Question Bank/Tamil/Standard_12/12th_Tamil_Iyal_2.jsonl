{"id": "12th_tamil_u2_q239", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "piragoru_naal_kodai", "chapter_id": null, "topic_id": "grammatical_split", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘நீர்வழிப்படூஉம்’ என்னும் தொடரில் இடம்பெற்றுள்ள ‘படூஉம்’ என்பது எவ்வகை அளபெடை?", "media_id": null}], "options": {"A": "செய்யுளிசை அளபெடை", "B": "இன்னிசை அளபெடை", "C": "சொல்லிசை அளபெடை அன்று, செய்யுளிசை (இசைநிறை) அளபெடை", "D": "ஒற்றளபெடை"}, "explanation": "படும் என்பது படூஉம் என நீண்டு ஓசை குறையாத இடத்திலும் செய்யுள் ஓசைக்காக அளபெடுத்ததால் ‘செய்யுளிசை அளபெடை’ (இசைநிறை அளபெடை) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What type of metrical elongation (Alabedai) is found in the verbal form 'Padooum' (படூஉம்)?", "media_id": null}], "options": {"A": "Sol-lisai Alabedai", "B": "Innisai Alabedai", "C": "Seyyulisai Alabedai (Isainirai Alabedai)", "D": "Otralabedai"}, "explanation": "'Padooum' exhibits Seyyulisai (Isainirai) Alabedai preserving poetic metric rhythm."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": "12th Tamil, Unit