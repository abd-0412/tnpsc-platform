{"id": "12th_tamil_u2_q259", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "nedunalvaadai", "chapter_id": null, "topic_id": "thinai_and_thurai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நெடுநல்வாடையின் திணையும் துறையும் எவை?", "media_id": null}], "options": {"A": "வெட்சித் திணை, பாசறை நிலை", "B": "வஞ்சித் திணை, கொற்றவள்ளை", "C": "வாகைத் திணை, கூதிர்ப்பாசறை துறை", "D": "காஞ்சித் திணை, கையறுநிலை"}, "explanation": "நெடுநல்வாடை வாகைத் திணையையும், போர்க்களத்தில் கூதிர்காலத்தில் அரசன் பாசறையில் தங்கியிருக்கும் ‘கூதிர்ப்பாசறை’ துறையையும் சார்ந்தது."}, "en": {"blocks": [{"type": "text", "content": "What are the specific Thinai (poetic landscape) and Thurai (situational context) of Nedunalvaadai?", "media_id": null}], "options": {"A": "Vetchi Thinai, Paasarai Nilai", "B": "Vanchi Thinai, Kotravallai", "C": "Vaagai Thinai, Koodhirp Paasarai Thurai", "D": "Kanchi Thinai, Kaiyaru Nilai"}, "explanation": "The poem is set in Vaagai Thinai (victory/duty) and the specific sub-theme is Koodhirp Paasarai (monarch in rainy winter encampment)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 32,