{"id": "12th_tamil_u2_q300", "schema_version": "1.0", "kind": "statement", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "author_evaluation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எழுத்தாளர் உத்தமசோழன் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\nகூற்று 1: இவரது இயற்பெயர் செல்வராஜ்; திருவாரூர் மாவட்டம் தீவாம்பாள்புரத்தைச் சேர்ந்தவர்.\nகூற்று 2: இவர் ‘கிழக்கு வாசல் உதயம்’ என்ற திங்களிதழை நடத்தி வருகிறார்.", "media_id": null}], "options": {"A": "கூற்று 1 மட்டும் சரி", "B": "கூற்று 2 மட்டும் சரி", "C": "இரண்டு கூற்றுகளும் தவறு", "D": "இரண்டு கூற்றுகளும் சரி"}, "explanation": "உத்தமசோழனின் இயற்பெயர் செல்வராஜ்; சொந்த ஊர் தீவாம்பாள்புரம்; ‘கிழக்கு வாசல் உதயம்’ இதழின் ஆசிரியர். இரண்டு கூற்றுகளும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the statements regarding author Uthamasozhan:\nStatement 1: His birth name is Selvaraj and he hails from Theevambalpuram, Tiruvarur.\nStatement 2: He edits and runs the monthly literary journal 'Kizhakku Vaasal Udhayam'.", "media_id": null}], "options": {"A": "Statement 1 only is correct", "B": "Statement 2 only is correct", "C": "Both statements are incorrect", "D": "Both statements are correct"}, "explanation": "Both statements accurately profile Uthamasozhan's background and literary editorship."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}