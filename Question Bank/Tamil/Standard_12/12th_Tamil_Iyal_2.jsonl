{"id": "12th_tamil_u2_q198", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "perumazhaikaalam", "chapter_id": null, "topic_id": "cop_summit", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உலக நாடுகள் இணைந்து பருவநிலை மாற்ற ஒப்பந்தத்தை (பாரிஸ் ஒப்பந்தம்) மேற்கொண்ட மாநாடு எது?", "media_id": null}], "options": {"A": "ரியோ மாநாடு 1992", "B": "பாரிஸ் காலநிலை மாற்ற மாநாடு (COP 21 - 2015)", "C": "கியோட்டோ நெறிமுறை 1997", "D": "கோபன்ஹேகன் உச்சிமாநாடு 2009"}, "explanation": "2015-ஆம் ஆண்டு பிரான்ஸ் நாட்டின் பாரிஸ் நகரில் நடைபெற்ற ஐ.நா பருவநிலை மாற்ற மாநாட்டில் (COP 21) வரலாற்றுச் சிறப்புமிக்க பாரிஸ் ஒப்பந்தம் உருவானது."}, "en": {"blocks": [{"type": "text", "content": "At which landmark international climate summit was the historic Paris Agreement adopted?", "media_id": null}], "options": {"A": "Rio Earth Summit 1992", "B": "Paris Climate Conference (COP 21 - 2015)", "C": "Kyoto Protocol 1997", "D": "Copenhagen Summit 2009"}, "explanation": "The Paris Agreement was formulated at the COP 21 climate conference held in Paris in 2015."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 25, "chapter