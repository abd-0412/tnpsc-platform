{"id": "12th_tamil_u2_q348", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mozhi_thiran_u2", "chapter_id": null, "topic_id": "proverb_completion_bund", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழமொழியை நிறைவு செய்க: ‘வருமுன்னர்க் காவாதான் வாழ்க்கை _________ முன்னின்று கெடும்.’", "media_id": null}], "options": {"A": "காற்று", "B": "வெள்ளம்", "C": "மழை", "D": "எரிமுன்னம் வைத்தூறு போலக் கெடும் (எரிமுன்னர் வைதூறு)"}, "explanation": "துன்பம் வருவதற்கு முன்பே காத்துக் கொள்ளாதவன் வாழ்க்கை, நெருப்பின் முன்னால் வைக்கப்பட்ட வைக்கோல் போர் போல எரிந்து அழியும்."}, "en": {"blocks": [{"type": "text", "content": "Complete the famous Thirukkural adage on disaster preparedness: 'Varumunnar kaavaadhaan vaazhkkai...':", "media_id": null}], "options": {"A": "Like wind", "B": "Like flood", "C": "Like rain", "D": "Erimunnam vaithooru pola (like haystack caught before raging fire)"}, "explanation": "The life of one who does not foresee calamity burns away like a stack of straw before fire."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "reference": "12th Tamil, U