{"id": "12th_tamil_u2_q344", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mozhi_thiran_u2", "chapter_id": null, "topic_id": "error_correction_thinai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திணை வழுவை நீக்கிச் சரியான தொடரைத் தேர்க: ‘மயில்கள் தோகை விரித்து ஆடியது.’", "media_id": null}], "options": {"A": "மயில்கள் தோகை விரித்து ஆடியவன்.", "B": "மயில்கள் தோகை விரித்து ஆடியவள்.", "C": "மயில்கள் தோகை விரித்து ஆடுவான்.", "D": "மயில்கள் தோகை விரித்து ஆடின."}, "explanation": "மயில்கள் என்பது அஃறிணைப் பன்மை (பலவின்பால்); எனவே ‘ஆடின’ என முடிவதே வழுவற்ற சரியான தொடராகும்."}, "en": {"blocks": [{"type": "text", "content": "Rectify the Thinai concord error: 'Mayilgal thogai virithu aadiyadhu':", "media_id": null}], "options": {"A": "Option A", "B": "Option B", "C": "Option C", "D": "Mayilgal thogai virithu aadina."}, "explanation": "'Mayilgal' (neuter plural) strictly agrees with 'aadina'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "reference": "12th Tamil, Unit 2, Page 41", "url": null, "source_notes": null}, "previous_year": {"is_previous_ye