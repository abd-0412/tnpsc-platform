{"id": "12th_tamil_u2_q232", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "piragoru_naal_kodai", "chapter_id": null, "topic_id": "poem_source_book", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடப்பகுதியில் அமைந்துள்ள ‘பிறகொரு நாள் கோடை’ என்னும் கவிதை எந்தக் கவிதைத் தொகுப்பிலிருந்து எடுக்கப்பட்டது?", "media_id": null}], "options": {"A": "நான் என்பது வேறொருவன்", "B": "நீர்வழிப்படூஉம்", "C": "இன்று", "D": "அய்யப்ப மாதவன் கவிதைகள்"}, "explanation": "இக்கவிதை ‘அய்யப்ப மாதவன் கவிதைகள்’ என்னும் முழுமைத் தொகுப்பிலிருந்து பாடமாக வைக்கப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "From which poetry anthology is the prescribed poem 'Piragoru Naal Kodai' excerpted?", "media_id": null}], "options": {"A": "Naan Enbadhu Veroruvan", "B": "Neervazhip Padooum", "C": "Indru", "D": "Ayyappa Madhavan Kavithaigal"}, "explanation": "The verse is drawn from the comprehensive compilation 'Ayyappa Madhavan Kavithaigal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": "12th Tamil, Unit 2, Page 30", "url": null, "source_notes": null}, "pre