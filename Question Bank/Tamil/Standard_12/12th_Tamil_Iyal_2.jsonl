{"id": "12th_tamil_u2_q360", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mozhi_thiran_u2", "chapter_id": null, "topic_id": "homophone_manam_manam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயங்கொலி வேறுபாடறிந்து பொருத்துக: ‘மணம்’ - ‘மனம்’", "media_id": null}], "options": {"A": "மணம் - உள்ளம்; மனம் - வாசனை", "B": "மணம் - காற்று; மனம் - பூமி", "C": "மணம் - நீர்; மனம் - நெருப்பு", "D": "மணம் - நறுமணம் / திருமணம்; மனம் - உள்ளம் (மனசு)"}, "explanation": "மணம் (டண்ணகரம்) = நறுமணம் அல்லது திருமணம்; மனம் (தன்னகரம்) = உள்ளம் / சிந்தனை."}, "en": {"blocks": [{"type": "text", "content": "Distinguish homophones and choose the correct pair of meanings for 'Manam' (மணம்) and 'Manam' (மனம்):", "media_id": null}], "options": {"A": "Manam - Heart; Manam - Scent", "B": "Manam - Wind; Manam - Earth", "C": "Manam - Water; Manam - Fire", "D": "Manam - Fragrance / Marriage; Manam - Heart / Mind"}, "explanation": "மணம் denotes scent or matrimony; மனம் denotes the human mind/heart."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 42, "chapter": null, "section": null, "reference": "12th Tamil, Unit