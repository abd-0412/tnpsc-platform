{"id": "12th_tamil_u2_q303", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "cart_track_water_flow", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மடை அடைக்கப்பட்டிருந்த வண்டிப்பாதை எதற்குப் பயன்பட்டு வந்தது?", "media_id": null}], "options": {"A": "ரயில் செல்வதற்கு", "B": "விமானம் இறங்குவதற்கு", "C": "கிராமத்து மாட்டு வண்டிகளும் மனிதர்களும் சென்று வரும் வரப்பு வழிப் பாதை", "D": "போர்க்களப் பாதை"}, "explanation": "கிராம மக்கள் வயல்களுக்குச் செல்லவும் விளைபொருட்களை மாட்டுவண்டியில் ஏற்றிச் செல்லவும் அமைக்கப்பட்ட வழிப்பாதையாகும்."}, "en": {"blocks": [{"type": "text", "content": "What was the regular utility of the cart track bridge under which the sluice was located?", "media_id": null}], "options": {"A": "Railway line track", "B": "Airstrip runway", "C": "Rural embankment cart road for bullock carts and farmers transporting farm harvest", "D": "Military warfare route"}, "explanation": "It was a rural field track used by farmers and bullock carts transporting produce."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 34, "chapter": null, "section": null, "reference": "12th Tamil, Unit 2, Page 34", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 2", "Supplementary", "Cart Track"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u2_q304", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "alli_gender_significance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அல்லி வெள்ளத்தில் இறங்கி உதவியதன் மூலம் ஆசிரியர் உணர்த்தும் சமுதாயக் கருத்து யாது?", "media_id": null}], "options": {"A": "பெண்கள் வீட்டில் மட்டுமே இருக்க வேண்டும்", "B": "ஆண்களுக்கு வலிமை குறைவு", "C": "விவசாயம் பெண்களுக்குப் பொருத்தமற்றது", "D": "பொதுப்பணிகளில் பெண்களும் ஆண்களுக்குச் சமமாகத் துணிச்சலுடன் களம் காணும் ஆற்றல் படைத்தவர்கள்"}, "explanation": "அல்லியின் துணிச்சல் பொதுநலப் பணிகளிலும் விவசாயப் பேரிடர் மீட்பிலும் பெண்களின் சரிநிகர் பங்களிப்பை வெளிப்படுத்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What progressive social insight is demonstrated through Alli wading into the flood alongside her husband?", "media_id": null}], "options": {"A": "Women should be confined strictly to domestic chores", "B": "Men lack physical stamina", "C": "Farming is unsuitable for women", "D": "Women possess equal fortitude and courage to participate side-by-side with men in community crises"}, "explanation": "Alli's decisive action underscores gender equality and female agency in community survival."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil