{"id": "12th_tamil_u2_q307", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "story_literary_value", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘முதல் கல்’ சிறுகதை தமிழ்ச் சிறுகதை உலகில் எவ்வகை எழுத்து மரபிற்குச் சிறந்த எடுத்துக்காட்டு?", "media_id": null}], "options": {"A": "மர்மக் கதை மரபு", "B": "வரலாற்றுப் புனைவு மரபு", "C": "மண் மணக்கும் யதார்த்தவாத வட்டார வழக்கு இலக்கிய மரபு (Realism)", "D": "அறிவியல் புனைவு"}, "explanation": "டெல்டா வட்டார வழக்கும் மக்களின் வாழ்வியல் எதார்த்தமும் இழையோடும் முற்போக்கு யதார்த்தவாதச் சிறுகதையாகும்."}, "en": {"blocks": [{"type": "text", "content": "To which distinguished tradition of Tamil short fiction does 'Mudhal Kal' belong?", "media_id": null}], "options": {"A": "Detective suspense mystery", "B": "Historical romance fiction", "C": "Earthy regional dialect and social realism tradition (Yadhaarthavaadham)", "D": "Science fiction"}, "explanation": "'Mudhal Kal' stands as a classic specimen of regional dialect realism reflecting Cauvery delta peasant realities."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-20