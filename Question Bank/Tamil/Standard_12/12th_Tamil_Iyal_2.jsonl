{"id": "12th_tamil_u2_q211", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "perumazhaikaalam", "chapter_id": null, "topic_id": "biodiversity_day", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சர்வதேச பல்லுயிர் நாள் (International Day for Biological Diversity) எந்த நாளில் கடைப்பிடிக்கப்படுகிறது?", "media_id": null}], "options": {"A": "மார்ச் 3", "B": "ஏப்ரல் 7", "C": "மே 22", "D": "ஜூலை 28"}, "explanation": "பல்லுயிர் வளத்தைப் பாதுகாக்கும் நோக்கில் மே 22-ஆம் நாள் சர்வதேச பல்லுயிர் நாளாகக் கடைப்பிடிக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "When is the International Day for Biological Diversity celebrated globally?", "media_id": null}], "options": {"A": "March 3", "B": "April 7", "C": "May 22", "D": "July 28"}, "explanation": "May 22 is commemorated globally as the International Day for Biological Diversity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 26, "chapter": null, "section": null, "reference": "12th Tamil, Unit 2, Page 26", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": nul