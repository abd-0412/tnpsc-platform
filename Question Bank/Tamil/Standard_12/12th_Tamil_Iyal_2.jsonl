{"id": "12th_tamil_u2_q270", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "nedunalvaadai", "chapter_id": null, "topic_id": "pathuppaattu_classification", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பத்துப்பாட்டு நூல்களில் மிகக் குறைந்த அடிகளைக் கொண்ட நூல் எது?", "media_id": null}], "options": {"A": "நெடுநல்வாடை (188 அடிகள்)", "B": "முல்லைப்பாட்டு (103 அடிகள்)", "C": "பட்டினப்பாலை (301 அடிகள்)", "D": "மதுரைக்காஞ்சி (782 அடிகள்)"}, "explanation": "பத்துப்பாட்டில் மிகக் குறைந்த அடிகளைக் கொண்டது முல்லைப்பாட்டு (103 அடிகள்); மிக நீண்ட அடிகளைக் கொண்டது மதுரைக்காஞ்சி (782 அடிகள்)."}, "en": {"blocks": [{"type": "text", "content": "Which is the shortest poem in terms of metrical line count among the Pathuppaattu anthology?", "media_id": null}], "options": {"A": "Nedunalvaadai (188 lines)", "B": "Mullaippaattu (103 lines)", "C": "Pattinappaalai (301 lines)", "D": "Maduraikkanchi (782 lines)"}, "explanation": "Mullaippaattu is the shortest with 103 lines, whereas Maduraikkanchi is the longest with 782 lines."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 32, "chapter": null, "section": null