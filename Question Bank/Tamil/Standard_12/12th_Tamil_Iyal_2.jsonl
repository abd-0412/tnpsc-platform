{"id": "12th_tamil_u2_q306", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "story_climax_emotion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெள்ள நீர் வடிந்து ஓடியபோது கிராம மக்களின் முகங்களில் மலர்ந்த உணர்ச்சி எது?", "media_id": null}], "options": {"A": "பெருங்கோபம்", "B": "உழைப்பின் வெற்றியை உணர்ந்த அளப்பரிய நிம்மதியும் கூட்டு மகிழ்ச்சியும்", "C": "விரக்தி", "D": "பொறாமை"}, "explanation": "தங்கள் ஒன்றுபட்ட உழைப்பால் பயிர்கள் காப்பாற்றப்பட்டதை உணர்ந்த மக்களின் உள்ளத்தில் கூட்டுணர்வின் வெற்றிப் பெருமிதம் பொங்கியது."}, "en": {"blocks": [{"type": "text", "content": "What collective emotional state illuminated the faces of the villagers when the torrent burst free through the cleared culvert?", "media_id": null}], "options": {"A": "Fierce wrath", "B": "Immense relief and jubilant communal joy realizing the triumph of united labor", "C": "Hopeless despair", "D": "Bitter jealousy"}, "explanation": "A profound sense of collective euphoria and relief washed over the villagers seeing their joint labor save the harvest."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "e