{"id": "12th_tamil_u2_q230", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "piragoru_naal_kodai", "chapter_id": null, "topic_id": "poetic_theme", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பிறகொரு நாள் கோடை’ கவிதையின் மையக்கரு எதனை அழகாகப் படம் பிடித்துக் காட்டுகிறது?", "media_id": null}], "options": {"A": "போர்க்களக் கொடுமைகள்", "B": "மழைக்காலத்திற்கும் கோடைக்காலத்திற்குமான திடீர் இயற்கை மாறுதலும் மனித மன உணர்வுகளும்", "C": "தொழிலாளர்களின் உழைப்புச் சுரண்டல்", "D": "மன்னர்களின் கொடைத்தன்மை"}, "explanation": "மழை பெய்து ஓய்ந்த பிறகு தோன்றும் குளிரும், திடீரென வெயில் அடிக்கும் கோடை மாற்றமும் கவிதையில் நுட்பமாக விவரிக்கப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "What is the central aesthetic motif captured in the poem 'Piragoru Naal Kodai'?", "media_id": null}], "options": {"A": "Horrors of ancient warfare", "B": "Sudden seasonal transition between retreating rain, emerging summer sun, and human psyche", "C": "Exploitation of industrial labor", "D": "Munificence of medieval monarchs"}, "explanation": "The poem depicts the sudden meteorological shift from fresh post-rain stillness to sudden radiant summer sunshine."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook a