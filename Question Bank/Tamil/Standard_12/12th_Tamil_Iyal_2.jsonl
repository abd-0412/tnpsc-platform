{"id": "12th_tamil_u2_q280", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "nedunalvaadai", "chapter_id": null, "topic_id": "moral_king_virtue", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நெடுநல்வாடைப் பாடல் மன்னன் நெடுஞ்செழியனின் எந்த உயர்ந்த குணத்தைப் படம்பிடித்துக் காட்டுகிறது?", "media_id": null}], "options": {"A": "செல்வத்தை மட்டுமே சேமிக்கும் பேராசை", "B": "போருக்கு அஞ்சி நடுங்கும் கோழைத்தனம்", "C": "அரண்மனை சுகபோகங்களில் திளைக்கும் மனப்பான்மை", "D": "வீரர்களையும் எளிய உயிர்களையும் குளிரிலும் நேரில் சென்று அரவணைக்கும் தாயன்பு கொண்ட கடமை உணர்ச்சி"}, "explanation": "பாண்டியன் குளிரையும் பொருட்படுத்தாது நள்ளிரவிலும் காயம் பட்ட வீரர்களைத் தாய்போல் சென்று நலம் விசாரிக்கும் பெருவீரமும் கடமை மாண்பும் போற்றப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What sublime monarchical virtue of King Nedunchezhian is celebrated in Nedunalvaadai?", "media_id": null}], "options": {"A": "Greedy hoarding of treasury wealth", "B": "Cowardly fear of battlefield peril", "C": "Indulging in palace luxuries", "D": "Maternal empathy and profound sense of duty, comforting wounded troops braving the freezing midnight gale"}, "explanation": "The poem extols the king's selfless devotion to his warriors, personally inspecting and inspiring them in the freezing camp."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_ans