{"id": "12th_tamil_u2_q236", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "piragoru_naal_kodai", "chapter_id": null, "topic_id": "metaphor_summer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிதையில் ‘திடீரெனப் புகுந்து கொண்ட கோடை’ எதன் வருகையைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "இரவின் வருகையை", "B": "பனிக்காலத்தின் தொடக்கத்தை", "C": "மழை மேகங்களின் வருகையை", "D": "சூரியனின் கடுமையான வெயில் மற்றும் வாழ்வின் அடுத்த பருவ மாற்றம்"}, "explanation": "மழை நின்றவுடன் திடீரென வந்து தாக்கும் சுட்டெரிக்கும் வெயிலையும் வாழ்வின் இயங்கு நிலையையும் இது உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What does the sudden intrusion of 'summer' signify in the poem?", "media_id": null}], "options": {"A": "Onset of nocturnal darkness", "B": "Beginning of chilly winter frost", "C": "Arrival of dark rain clouds", "D": "Intense blaze of the sun and cyclical change of life's seasons"}, "explanation": "It symbolizes the sudden, blinding arrival of harsh summer sunshine, illustrating the rapid flux in nature and human experience."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 29, "chapter": null, "section": null, "reference": "12th Tamil, Unit 2, Page 29", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 2", "Poetry", "Metaphor"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u2_q237", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "piragoru_naal_kodai", "chapter_id": null, "topic_id": "visual_imagery", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிதையில் பயின்று வரும் முதன்மையான அழகியல் உத்தி எது?", "media_id": null}], "options": {"A": "காட்சிப் படிமம் (Visual Image)", "B": "ஒலிப் படிமம் மட்டும்", "C": "சுவைப் படிமம் மட்டும்", "D": "உயர்வு நவிற்சி அணி"}, "explanation": "மழைத்துளிகள், நனைந்த சுவர்கள், இலை நுனிகள், வெயிலின் பரவல் என மனக்கண் முன் காட்சிகளை நிறுத்தும் ‘காட்சிப் படிமம்’ முதன்மையாக உள்ளது."}, "en": {"blocks": [{"type": "text", "content": "What is the predominant poetic device (Aesthetics) deployed throughout the poem?", "media_id": null}], "options": {"A": "Visual Imagery (Kaatchip Padimam)", "B": "Auditory imagery alone", "C": "Gustatory imagery alone", "D": "Hyperbole (Uyarvu Navirtchi)"}, "explanation": "The poem primarily harnesses vivid visual imagery (Kaatchip Padimam) rendering raindrops, wet walls, and glowing sunlight tangible."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 29, "chapter": null, "section": nul