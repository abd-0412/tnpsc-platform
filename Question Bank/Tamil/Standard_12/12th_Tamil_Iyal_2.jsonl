{"id": "12th_tamil_u2_q206", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "perumazhaikaalam", "chapter_id": null, "topic_id": "urban_flooding_cause", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நகரங்களில் பெரும் மழைக்காலத்தில் வெள்ளப்பெருக்கு ஏற்படுவதற்கு முதன்மைக் காரணம் யாது?", "media_id": null}], "options": {"A": "மழைப்பொழிவு முற்றிலும் குறைந்து போதல்", "B": "நீர்நிலைகள், சதுப்பு நிலங்கள் ஆக்கிரமிக்கப்பட்டு வடிகால் வழிகள் அடைபடுதல்", "C": "அதிகப்படியான மரங்களை நடுதல்", "D": "மண் அரிப்பு தடுப்புச் சுவர்கள் கட்டுதல்"}, "explanation": "இயற்கையான நீர்வழிப்பாதைகள், ஏரிகள், சதுப்பு நிலங்கள் ஆக்கிரமிக்கப்பட்டு கான்கிரீட் தளங்களாக மாறியதே நகர வெள்ளப்பெருக்குக்குக் காரணம்."}, "en": {"blocks": [{"type": "text", "content": "What is the foremost root cause of severe urban flooding during monsoons as analysed in the text?", "media_id": null}], "options": {"A": "Total reduction in rainfall precipitation", "B": "Encroachment of waterbodies and wetlands blocking natural storm runoff drains", "C": "Afforestation drives planting excess trees", "D": "Construction of check dams preventing soil erosion"}, "explanation": "Encroachment on wetlands and natural floodplains with impervious concrete prevents stormwater infiltration."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", 