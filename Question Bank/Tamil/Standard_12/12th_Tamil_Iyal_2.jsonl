{"id": "12th_tamil_u2_q197", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "perumazhaikaalam", "chapter_id": null, "topic_id": "global_warming_cause", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பெருமழைக்காலம்’ உரைநடைப் பகுதியில் புவி வெப்பமயமாதலுக்கு முதன்மைக் காரணமாகக் குறிப்பிடப்படுவது எது?", "media_id": null}], "options": {"A": "மனிதனின் இயற்கைக்கு முரணான செயல்பாடுகளால் வெளியிடப்படும் பசுமைக்குடில் வாயுக்கள்", "B": "சூரியனின் ஒளிக்கதிர்கள் குறைதல்", "C": "நிலநடுக்கங்கள் தொடர்ச்சியாக ஏற்படுதல்", "D": "காடுகளின் பரப்பளவு பெருமளவு அதிகரித்தல்"}, "explanation": "மனிதனின் முறையற்ற இயற்கைச் சுரண்டலால் வளிமண்டலத்தில் கார்பன் டை ஆக்சைடு முதலிய பசுமைக்குடில் வாயுக்கள் மிகுந்து புவி வெப்பமடைகிறது."}, "en": {"blocks": [{"type": "text", "content": "What is highlighted in the prose 'Perumazhaikaalam' as the primary cause of global warming?", "media_id": null}], "options": {"A": "Greenhouse gases emitted by anthropocentric activities violating nature", "B": "Diminishing intensity of solar radiation", "C": "Recurrent tectonic earthquakes", "D": "Exponential increase in forest cover"}, "explanation": "Unchecked human exploitation emits excessive greenhouse gases like carbon dioxide, driving global warming."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil