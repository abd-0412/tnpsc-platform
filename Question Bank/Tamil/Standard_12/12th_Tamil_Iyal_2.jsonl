{"id": "12th_tamil_u2_q214", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "perumazhaikaalam", "chapter_id": null, "topic_id": "cyclone_origin", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வங்கக்கடலில் புயல்கள் அதிகமாக உருவாவதற்குக் காரணியாக விளங்குவது எது?", "media_id": null}], "options": {"A": "கடல்நீர் உறைந்து பனிக்கட்டியாதல்", "B": "கடல் மேற்பரப்பு வெப்பநிலை 26.5° செல்சியசுக்கு மேல் உயர்ந்து குறைந்த காற்றழுத்தத் தாழ்வு மண்டலம் உருவாதல்", "C": "பூமியின் சுழற்சி வேகம் குறைதல்", "D": "கடல் அலைகள் முற்றிலும் ஓய்ந்துபோதல்"}, "explanation": "கடல் மேற்பரப்பு வெப்பநிலை 26.5°C ஐ விட உயரும்போது தீவிர ஆவியாதல் ஏற்பட்டு காற்றழுத்தத் தாழ்வு மண்டலங்கள் புயல்களாக மாறுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What meteorological condition triggers frequent tropical cyclones over the Bay of Bengal?", "media_id": null}], "options": {"A": "Freezing of sea water into sheets of ice", "B": "Sea surface temperature exceeding 26.5°C causing low pressure depressions", "C": "Deceleration of Earth's rotational speed", "D": "Complete cessation of marine tidal currents"}, "explanation": "Sea surface temperatures crossing 26.5°C generate thermal convection and intense tropical low-pressure depressions."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tami