{"id": "12th_tamil_u2_q210", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "perumazhaikaalam", "chapter_id": null, "topic_id": "earth_day", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உலகப் பூமி நாள் (World Earth Day) கடைப்பிடிக்கப்படும் நாள் எது?", "media_id": null}], "options": {"A": "மார்ச் 22", "B": "ஏப்ரல் 22", "C": "மே 22", "D": "ஜூன் 22"}, "explanation": "ஒவ்வொரு ஆண்டும் ஏப்ரல் 22-ஆம் நாள் உலகப் பூமி நாளாகக் கடைப்பிடிக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "On which date is World Earth Day celebrated internationally?", "media_id": null}], "options": {"A": "March 22", "B": "April 22", "C": "May 22", "D": "June 22"}, "explanation": "World Earth Day is observed internationally on April 22."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 26, "chapter": null, "section": null, "reference": "12th Tamil, Unit 2, Page 26", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 2", "Pros