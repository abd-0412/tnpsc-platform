{"id": "12th_tamil_u2_q212", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "perumazhaikaalam", "chapter_id": null, "topic_id": "disaster_reduction_day", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயற்கைப் பேரிடர் குறைப்பு நாள் (International Day for Disaster Risk Reduction) எந்த நாளில் அனுசரிக்கப்படுகிறது?", "media_id": null}], "options": {"A": "ஜனவரி 15", "B": "ஆகஸ்ட் 29", "C": "செப்டம்பர் 5", "D": "அக்டோபர் 13"}, "explanation": "ஐ.நா அவையின் வழிகாட்டுதல்படி அக்டோபர் 13-ஆம் நாள் சர்வதேச இயற்கைப் பேரிடர் குறைப்பு நாளாக அனுசரிக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "On which date is the International Day for Disaster Risk Reduction observed?", "media_id": null}], "options": {"A": "January 15", "B": "August 29", "C": "September 5", "D": "October 13"}, "explanation": "October 13 is designated as the International Day for Disaster Risk Reduction."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 26, "chapter": null, "section": null, "reference": "12th Tamil, Unit 2, Page 26", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "ex