{"id": "12th_tamil_u2_q301", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "character_marudhan_trait", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மருதனின் பாத்திரப் படைப்பு வெளிப்படுத்தும் உன்னதப் பண்பு எது?", "media_id": null}], "options": {"A": "பொதுநலனுக்காகத் தன்னலமின்றி முன்நிற்கும் தலைமைப் பண்பும் செயலூக்கமும்", "B": "பணத்தின் மீதான அளவற்ற ஆசை", "C": "பிறரை ஏமாற்றி வாழும் தந்திரம்", "D": "அரசாங்கத்தை மட்டுமே சார்ந்திருக்கும் இயலாமை"}, "explanation": "மருதன் சுயநலமின்றி, பயிர்களைக் காக்கத் துணிந்து முன்னிற்கும் தன்னலமற்ற தலைமைப் பண்பின் அடையாளமாகத் திகழ்கிறான்."}, "en": {"blocks": [{"type": "text", "content": "What noble character trait does Marudhan exemplify in the story?", "media_id": null}], "options": {"A": "Proactive civic leadership and selfless initiative for communal welfare", "B": "Insatiable greed for wealth", "C": "Deceptive exploitation of others", "D": "Helpless dependence on state machinery"}, "explanation": "Marudhan embodies civic initiative, courage, and selfless leadership in times of community crisis."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 34, "chapter": null, "section": null, "reference": "12th Tamil, Unit 2, Page 34", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 2", "Supplementary", "Character Trait"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u2_q302", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "anthology_source", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘முதல் கல்’ சிறுகதை உத்தமசோழனின் எந்தச் சிறுகதைத் தொகுப்பில் இடம்பெற்றுள்ளது?", "media_id": null}], "options": {"A": "மனித தீவுகள்", "B": "உத்தமசோழன் சிறுகதைகள்", "C": "கசக்கும் இனிமை", "D": "சதுரங்க வேட்டை"}, "explanation": "பாடப்பகுதியில் உள்ள சிறுகதை ‘உத்தமசோழன் சிறுகதைகள்’ என்னும் முழுமைத் தொகுப்பிலிருந்து எடுக்கப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "From which anthology of Uthamasozhan's works is the prescribed story 'Mudhal Kal' selected?", "media_id": null}], "options": {"A": "Manidha Theevugal", "B": "Uthamasozhan Sirukadhaigal", "C": "Kasakkum Inimai", "D": "Saduranga Vettai"}, "explanation": "The prescribed text is anthologized in 'Uthamasozhan Sirukadhaigal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": "12th Tamil, Unit 2, Page 36", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false