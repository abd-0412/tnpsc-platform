{"id": "12th_tamil_u3_q555", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_u3", "chapter_id": null, "topic_id": "proverb_patience", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பொறுத்தார் பூமி ஆள்வார்; பொங்கினார் _________ ஆள்வார்’ - பழமொழியை நிறைவு செய்க:", "media_id": null}], "options": {"A": "வானம்", "B": "கடல்", "C": "காடு (காடாள்வார்)", "D": "நாடு"}, "explanation": "‘பொறுத்தார் பூமி ஆள்வார்; பொங்கினார் காடாள்வார்’ என்பது சினம் தவிர்த்துப் பொறுமை காப்பதன் மாண்பைப் புகட்டும் தமிழ்ப் பழமொழியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Complete the traditional proverb on patience: 'Porutthaar bhoomi aalvaar; ponginaar _________ aalvaar':", "media_id": null}], "options": {"A": "Vaanam", "B": "Kadal", "C": "Kaadu (the wilderness)", "D": "Naadu"}, "explanation": "The proverb is 'Porutthaar bhoomi aalvaar; ponginaar kaadaalvaar' (The patient shall inherit the earth; the furious shall flee to the wild)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 66, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 66", "url": null, "source_notes