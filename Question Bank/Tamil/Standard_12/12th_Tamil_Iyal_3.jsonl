{"id": "12th_tamil_u3_q532", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "porul_mayakkam", "chapter_id": null, "topic_id": "chapter_pedagogical_aim", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல் 3 இலக்கணப் பகுதியில் ‘பொருள் மயக்கம்’ பாடத்தை வைத்ததன் முதன்மை நோக்கம் யாது?", "media_id": null}], "options": {"A": "கடினமான சொற்களைக் கற்பிக்க", "B": "பழைய செய்யுள்களை மனனம் செய்ய", "C": "பிறமொழியில் எழுதப் பயிற்றுவிக்க", "D": "மாணவர்கள் நடைமுறைத் தமிழ் எழுத்திலும் பேச்சிலும் எவ்விதக் குழப்பமும் மயக்கமுமின்றித் தெளிவான தொடர்களை அமைக்கப் பயிற்றுவித்தல்"}, "explanation": "எழுத்து மற்றும் பேச்சு வழக்கில் பிழையின்றித் தெளிவான வாக்கியங்களை உருவாக்க மாணவர்களைத் தயார்படுத்துவதே இதன் நோக்கமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the prime educational objective behind teaching 'Porul Mayakkam' in Unit 3?", "media_id": null}], "options": {"A": "Teaching archaic vocabulary", "B": "Rote memorization of verses", "C": "Training in foreign languages", "D": "Equipping students to compose lucid, flawless, and unambiguous Tamil prose in speech and writing"}, "explanation": "Training learners to write and speak lucid, articulate, and semantically unambiguous Tamil sentences."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer K