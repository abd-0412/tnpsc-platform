{"id": "12th_tamil_u3_q399", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thamizhar_kudumba_murai", "chapter_id": null, "topic_id": "nuclear_family_sangam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க காலத்தில் தலைவனும் தலைவியும் மணம் முடித்துத் தனியாக வாழும் ‘தனிக்குடும்ப முறை’ எவ்வாறு அழைக்கப்பட்டது?", "media_id": null}], "options": {"A": "கூட்டுக் குடும்பம்", "B": "பெரிய குடும்பம்", "C": "இளமணத் தம்பதியர் தனிக் குடித்தனம் அமைத்தல் (தனிக்குடும்பத்தின் தொடக்கம்)", "D": "அரண்மனை வாழ்வு"}, "explanation": "மணமான புதுமணத் தம்பதியர் பெற்றோரை விட்டுப் பிரிந்து தனியாக வாழும் முறை தனிக்குடும்ப உருவாக்கத்தின் தொடக்கமாக இருந்தது."}, "en": {"blocks": [{"type": "text", "content": "What marked the emergence of nuclear family units (Thani Kudumbam) in ancient Tamil society?", "media_id": null}], "options": {"A": "Joint family patriarchal clans", "B": "Multi-generational agrarian communes", "C": "Newly wedded young couples setting up independent separate households", "D": "Palace community halls"}, "explanation": "Newly wed couples setting up their own independent domestic hearth marked the genesis of early nuclear families."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational S