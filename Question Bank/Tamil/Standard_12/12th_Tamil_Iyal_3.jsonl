{"id": "12th_tamil_u3_q509", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "porul_mayakkam", "chapter_id": null, "topic_id": "thaan_particle_effect", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தான்’ என்னும் இடைச்சொல் வாக்கியத்தில் இடம்பெறும் இடத்தைப் பொறுத்துப் பொருள் எவ்வாறு மாறுகிறது?\n1. ‘மணிதான் நேற்று வந்தான்’\n2. ‘மணி நேற்றுதான் வந்தான்’", "media_id": null}], "options": {"A": "1-ல் மணி மட்டுமே வந்தான் (வேறு யாரும் வரவில்லை); 2-ல் நேற்று மட்டுமே வந்தான் (முன்போ பின்போ வரவில்லை)", "B": "இரண்டும் ஒரே பொருள்தான்", "C": "1-ல் நேற்று வரவில்லை", "D": "2-ல் மணி வரவில்லை"}, "explanation": "‘தான்’ என்னும் அழுத்தம் தரும் இடைச்சொல் எந்தச் சொல்லோடு சேர்கிறதோ அதற்கேற்ப வாக்கியத்தின் ஒட்டுமொத்தப் பொருளும் மாறும்."}, "en": {"blocks": [{"type": "text", "content": "How does the focusing particle 'thaan' alter sentence meaning in:\n1. 'Manithaan netru vandhaan'\n2. 'Mani netruthaan vandhaan'?", "media_id": null}], "options": {"A": "In 1: Only Mani came (exclusive subject); In 2: Mani came only yesterday (exclusive time)", "B": "Both convey identical meaning", "C": "In 1 he didn't arrive", "D": "In 2 Mani didn't come"}, "explanation": "Attaching 'thaan' to Mani isolates the actor; attaching it to netru isolates the temporal day."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 60, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 60", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 3", "Grammar", "Thaan Particle"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u3_q510", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "porul_mayakkam", "chapter_id": null, "topic_id": "mattum_particle", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மட்டும்’ என்னும் இடைச்சொல் உணர்த்தும் முதன்மைப் பொருள் யாது?", "media_id": null}], "options": {"A": "எல்லாரையும் குறிப்பது", "B": "வரம்பு / எல்லை (குறிப்பிட்ட ஒன்றுக்கு மட்டுமே உரித்தாக்குதல்)", "C": "எதிர்மறைப் பொருள்", "D": "வியப்புப் பொருள்"}, "explanation": "‘மட்டும்’ என்பது எல்லை அல்லது வரம்பைக் குறிக்கும் இடைச்சொல்லாகும் (எ.கா: அவன் மட்டும் வந்தான் = அவன் ஒருவன் மட்டுமே வந்தான்)."}, "en": {"blocks": [{"type": "text", "content": "What syntactic function does the limiting particle 'mattum' serve in Tamil sentences?", "media_id": null}], "options": {"A": "Universal inclusion", "B": "Delimitation / Exclusivity (restricting scope to a specific entity)", "C": "Negative negation", "D": "Exclamatory wonder"}, "explanation": "'Mattum' acts as a restrictive limiter establishing exclusivity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 60, "chapter": null, "section": null, "reference": "12th Ta