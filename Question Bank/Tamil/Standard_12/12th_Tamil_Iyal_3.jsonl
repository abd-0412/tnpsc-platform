{"id": "12th_tamil_u3_q584", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "tnpsc_pyq_u3", "chapter_id": null, "topic_id": "meaning_kaasu_pirappu_eetru", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெண்பாவின் ஈற்றுச் சீர் வாய்பாடுகளில் ஒன்றான ‘காசு’ என்பது எவ்வகை அசைகளின் சேர்க்கையால் பிறக்கிறது?", "media_id": null}], "options": {"A": "நேர் நேர்", "B": "நிரை நேர்", "C": "நேர் நிரை", "D": "நேர்பு (நேர் அசைக்குப்பின் குற்றியலுகரம் வருதல்)"}, "explanation": "நேர்பு என்னும் அசைக்குரிய வாய்பாடே ‘காசு’ என்பதாகும் (நேர் + உகரம் = நேர்பு / காசு)."}, "en": {"blocks": [{"type": "text", "content": "In Tamil prosody, which metrical combination yields the terminal formula 'Kaasu'?", "media_id": null}], "options": {"A": "Ner Ner", "B": "Nirai Ner", "C": "Ner Nirai", "D": "Nerbu (A Ner syllable followed by a shorter u-glide / Kutriyalugaram)"}, "explanation": "Nerbu resolves to the terminal metric formula 'Kaasu'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 66, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 66", "url": null, "source_notes": null}, "previous_year"