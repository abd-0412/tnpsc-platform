{"id": "12th_tamil_u3_q468", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "kambaramayanam_u3", "chapter_id": null, "topic_id": "vibhishana_surrender_virtue", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வீடணன் இராவணனை விட்டு விலகி இராமனிடம் அடைக்கலம் புகக் காரணம் என்ன?", "media_id": null}], "options": {"A": "இலங்கையின் அரச பதவியைப் பறிப்பதற்காக", "B": "போருக்கு அஞ்சிய கோழைத்தனத்தால்", "C": "இராமனிடம் இருந்த செல்வத்தைக் கண்டு", "D": "பிறன்மனை நயத்தலாகிய அதர்மத்தைச் செய்த இராவணனைக் கண்டித்தும் அவன் கேட்காததால், அறத்தின் பக்கம் நிற்கத் துணிந்தமை"}, "explanation": "இராவணனின் அதர்மமான செயலை எதிர்த்து, அறத்தின் வழியே வெல்லும் என்பதற்காக வீடணன் தமையனைத் துறந்து இராமனிடம் அடைக்கலமானான்."}, "en": {"blocks": [{"type": "text", "content": "What noble ethical motive impelled Vibhishana to desert Ravana and seek refuge at Rama's feet?", "media_id": null}], "options": {"A": "Greed to usurp the throne of Lanka", "B": "Cowardly fear of battlefield slaughter", "C": "Coveting Rama's wealth", "D": "Repudiating Ravana's unrighteous abduction of Sita and choosing to stand uncompromisingly on the side of Dharma"}, "explanation": "Vibhishana counseled Ravana to return Sita, and upon refusal, chose righteous Dharma over fraternal allegiance."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "