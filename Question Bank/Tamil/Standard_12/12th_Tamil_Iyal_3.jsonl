{"id": "12th_tamil_u3_q410", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thamizhar_kudumba_murai", "chapter_id": null, "topic_id": "manai_word_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மனை’ என்னும் சொல் எதனடிப்படையில் உருவானது?", "media_id": null}], "options": {"A": "மண் என்பதிலிருந்து உண்டானது", "B": "மன்னுதல் (நிலைபெற்று வாழ்தல்) என்னும் சொல்லிலிருந்து உருவானது", "C": "மழை என்பதிலிருந்து உருவானது", "D": "மரம் என்பதிலிருந்து உருவானது"}, "explanation": "‘மன்னுதல்’ என்றால் நிலைபெற்று இருத்தல்; குடும்பமாக ஓரிடத்தில் நிலைபெற்று வாழ்வதைக் குறிக்க ‘மனை’ என்ற சொல் பிறந்தது."}, "en": {"blocks": [{"type": "text", "content": "From which etymological verbal root did the noun 'Manai' (Hearth/Home) originate?", "media_id": null}], "options": {"A": "From Mann (Soil)", "B": "From Mannudhal (to abide perpetually / establish stably)", "C": "From Mazhai (Rain)", "D": "From Maram (Tree)"}, "explanation": "'Manai' derives from 'Mannudhal', signifying stable settlement and lasting habitation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 47, "chapter": null, "section": null, "referen