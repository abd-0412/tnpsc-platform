{"id": "12th_tamil_u3_q579", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "tnpsc_pyq_u3", "chapter_id": null, "topic_id": "masnavi_literary_status", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜலாலுத்தீன் ரூமியின் ‘மஸ்னவி’ நூல் பாரசீக இலக்கிய உலகில் எவ்வாறாகப் போற்றப்படுகிறது?", "media_id": null}], "options": {"A": "போர்க் காப்பியம்", "B": "அரசியல் சட்ட நூல்", "C": "‘பாரசீக மொழியின் குரான்’ என்று போற்றப்படும் ஆன்மீகக் களஞ்சியம்", "D": "நாடக நூல்"}, "explanation": "ரூமியின் மஸ்னவி அதன் பரந்த ஆன்மீகச் செழுமையின் காரணமாக அறிஞர்களால் ‘பாரசீக மொழியின் குரான்’ என்று போற்றிப் புகழப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "How is Rumi's 'Masnavi' celebrated in the annals of Persian literary mysticism?", "media_id": null}], "options": {"A": "War epic", "B": "Legal constitution", "C": "Hailed reverently as 'The Quran in the Persian tongue'", "D": "Theatrical drama"}, "explanation": "Poet Jami acclaimed Rumi's Masnavi as 'The Quran in the Persian tongue'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": "12th Tamil, Uni