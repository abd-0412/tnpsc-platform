{"id": "12th_tamil_u3_q487", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "urimaithaagam", "chapter_id": null, "topic_id": "muthaiyan_noble_action", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தம்பியின் நிலம் அன்னியன் கைக்குப் போகவிருப்பதை அறிந்த அண்ணன் முத்தையன் என்ன செய்தான்?", "media_id": null}], "options": {"A": "மகிழ்ச்சியடைந்து கைதட்டினான்", "B": "பண்ணையாருக்கு ஆதரவாக நின்றான்", "C": "பழைய பகையை மறந்து, தன் மனைவி மூக்கம்மாவின் நகையையும் சேமிப்பையும் கொண்டு சென்று பண்ணையாரிடம் கடனை அடைத்துத் தம்பியின் நிலத்தை மீட்டான்", "D": "ஊரை விட்டு வெளியேறினான்"}, "explanation": "இரத்த பாசமும் நிலத்தின் மதிப்பும் உணர்ந்த முத்தையன், தன் குடும்பப் பணத்தையும் நகையையும் கொடுத்துப் பண்ணையாரிடமிருந்து தம்பியின் நிலத்தை மீட்டான்."}, "en": {"blocks": [{"type": "text", "content": "What noble brotherly action did elder brother Muthaiyan take upon hearing that his estranged brother was losing his land?", "media_id": null}], "options": {"A": "Celebrated in malicious glee", "B": "Colluded with the landlord", "C": "Buried past animosity, sold/pledged his wife Mookkamma's jewelry and family savings to clear the debt and redeem the land", "D": "Fled the village"}, "explanation": "Muthaiyan forgave all bitterness, rallied family gold and savings, and paid off the landlord to save his brother's land."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks"