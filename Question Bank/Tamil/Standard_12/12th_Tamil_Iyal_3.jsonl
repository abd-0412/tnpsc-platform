{"id": "12th_tamil_u3_q578", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "tnpsc_pyq_u3", "chapter_id": null, "topic_id": "porul_mayakkam_prevention_method", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வாக்கியத்தில் பொருள் மயக்கத்தைத் தவிர்க்க மிக இன்றியமையாத நடைமுறை எது?", "media_id": null}], "options": {"A": "நீளமான வாக்கியங்களை மட்டுமே அமைத்தல்", "B": "சொற்களைப் பொருத்தமான இடைவெளியுடன் எழுதுதல் மற்றும் நிறுத்தற்குறிகளை உரிய இடத்தில் இடுதல்", "C": "சந்தச் சொற்களைப் பயன்படுத்துதல்", "D": "எழுத்துகளைச் சிறிதாக எழுதுதல்"}, "explanation": "சரியான சொல் பிரிப்பும், தேவையான இடங்களில் நிறுத்தற்குறிகளை இடுவதும் தொடரமைப்பில் பொருள் மயக்கத்தை முற்றிலும் போக்கும்."}, "en": {"blocks": [{"type": "text", "content": "What practical typographical rule is indispensable to avert Porul Mayakkam in written Tamil?", "media_id": null}], "options": {"A": "Composing only marathon multi-clause sentences", "B": "Deploying appropriate word spacing and inserting punctuation marks accurately", "C": "Rhyming meters", "D": "Writing in minuscule fonts"}, "explanation": "Accurate word separation and judicious punctuation eradicate semantic ambiguity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational