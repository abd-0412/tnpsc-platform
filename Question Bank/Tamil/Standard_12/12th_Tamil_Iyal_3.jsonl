{"id": "12th_tamil_u3_q490", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "urimaithaagam", "chapter_id": null, "topic_id": "story_theme_blood_relation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உரிமைத்தாகம்’ சிறுகதை வலியுறுத்தும் மிக உன்னதமான வாழ்வியல் செய்தி என்ன?", "media_id": null}], "options": {"A": "பணமே வாழ்க்கையில் முதன்மையானது", "B": "சொத்துத் தகராறுகளை விட உடன்பிறந்த இரத்த பாசமும் குடும்ப ஒற்றுமையுமே மேலானது", "C": "நிலத்தை எப்போதும் விற்க வேண்டும்", "D": "வட்டிக்குக் கடன் வாங்குவது சிறந்தது"}, "explanation": "எல்லை வரப்புகள் பிரித்தாலும் இரத்த பாசத்தைப் பிரிக்க முடியாது; உடன்பிறப்பு உறவே நிரந்தரமானது என்பதை இக்கதை உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What paramount emotional message does 'Urimaithaagam' impart to contemporary society?", "media_id": null}], "options": {"A": "Wealth surpasses all bonds", "B": "Fraternal blood kinship and familial solidarity transcend all petty property feuds", "C": "Agrarian land must be auctioned", "D": "Usury is commendable"}, "explanation": "Blood ties and fraternal solidarity are far more sacred and enduring than material possessions."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Service