{"id": "12th_tamil_u3_q553", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_u3", "chapter_id": null, "topic_id": "kural_meter_kural_venba", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறள் முழுமையும் எவ்வகை பாவகையால் இயற்றப்பட்டது?", "media_id": null}], "options": {"A": "குறள் வெண்பா (ஈரடி வெண்பா - முதன் மூன்று சீர்கள், ஈற்றடி நான்கு சீர்கள்)", "B": "நேரிசை ஆசிரியப்பா", "C": "கலிப்பா", "D": "வஞ்சிப்பா"}, "explanation": "திருக்குறள் முதலடி நான்கு சீர்களும், இரண்டாமடி மூன்று சீர்களுமாக மொத்தம் ஏழு சீர்களைக் கொண்ட ‘குறள் வெண்பா’வால் இயற்றப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "What classical metrical form is employed throughout the 1,330 couplets of Thirukkural?", "media_id": null}], "options": {"A": "Kural Venba (Two-line Venba: 4 feet in line 1, 3 feet in line 2 = 7 feet)", "B": "Nerisai Asiriyappa", "C": "Kalippa", "D": "Vanchippa"}, "explanation": "Thirukkural is composed exclusively in Kural Venba, having 4 cirs in the first line and 3 cirs in the second."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 66, "chapter": null, "section": nul