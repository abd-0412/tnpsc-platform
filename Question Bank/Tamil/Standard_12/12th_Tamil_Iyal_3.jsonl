{"id": "12th_tamil_u3_q446", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "virundhinar_illam", "chapter_id": null, "topic_id": "sheb_i_arus", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ரூமி இறந்த நாள் அவருடைய சீடர்களால் எவ்வாறு கொண்டாடப்படுகிறது?", "media_id": null}], "options": {"A": "துக்க நாள்", "B": "‘ஷெப்-இ-அரூஸ்’ (Sheb-i Arus - இறைவனோடு ஆன்மா இணையும் மணநாள்)", "C": "போர் நாள்", "D": "மௌன நாள்"}, "explanation": "ரூமியின் மறைவு நாள் ‘இறைவனோடு ஆன்மா கலக்கும் திருமண இரவு’ (Sheb-i Arus) என இன்றும் கொன்யாவில் விழாவாகக் கொண்டாடப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "How is the annual death anniversary of Jalaluddin Rumi observed by his followers in Konya?", "media_id": null}], "options": {"A": "A day of dark mourning", "B": "Sheb-i Arus (The Wedding Night - the union of the soul with the Divine)", "C": "A day of battle victory", "D": "A day of silence"}, "explanation": "Rumi's death anniversary is celebrated as 'Sheb-i Arus' (The Nuptial Night of divine reunion)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "refere