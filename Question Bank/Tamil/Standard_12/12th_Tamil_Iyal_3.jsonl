{"id": "12th_tamil_u3_q518", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "porul_mayakkam", "chapter_id": null, "topic_id": "sentence_ordering_ambiguity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மருத்துவர் நோயாளிக்கு மருந்து கொடுத்தார்’ என்ற தொடரை ‘நோயாளிக்கு மருத்துவர் மருந்து கொடுத்தார்’ என மாற்றும்போது ஏற்படும் மாற்றம் என்ன?", "media_id": null}], "options": {"A": "வாக்கியத்தின் பொருள் முற்றிலும் கெட்டுவிடும்", "B": "அடிப்படைப் பொருள் மாறாவிடினும் முதன்மை அழுத்தம் எழுவாயிலிருந்து (மருத்துவர்) ஏற்பவருக்கு (நோயாளிக்கு) மாறுகிறது", "C": "இலக்கண வழு உண்டாகும்", "D": "எதிர்கால வாக்கியமாக மாறும்"}, "explanation": "சொல் இடம் மாறுவதால் இலக்கணப் பிழை ஏற்படாவிடினும், வாக்கியத்தின் முக்கியத்துவ அழுத்த மையம் மாறுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What functional shift occurs when 'Maruthuvar noyaalikku marundhu kodutthaar' is rewritten with recipient first?", "media_id": null}], "options": {"A": "Meaning is totally corrupted", "B": "Core meaning is intact, but focal topical emphasis shifts from agent (doctor) to beneficiary (patient)", "C": "Concord error occurs", "D": "Shifts to future tense"}, "explanation": "Syntactic rearrangement preserves truth value but shifts topicalized focus."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_n