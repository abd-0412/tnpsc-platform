{"id": "12th_tamil_u3_q548", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_u3", "chapter_id": null, "topic_id": "thirukkural_structure", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளின் முப்பால்களில் அமைந்துள்ள மொத்த இயல்கள் மற்றும் அதிகாரங்களின் எண்ணிக்கை யாது?", "media_id": null}], "options": {"A": "5 இயல்கள், 100 அதிகாரங்கள்", "B": "7 இயல்கள், 120 அதிகாரங்கள்", "C": "12 இயல்கள், 150 அதிகாரங்கள்", "D": "9 இயல்கள், 133 அதிகாரங்கள் (1330 குறட்பாக்கள்)"}, "explanation": "திருக்குறள் அறத்துப்பால் (4 இயல்), பொருட்பால் (3 இயல்), காமத்துப்பால் (2 இயல்) என 9 இயல்களையும் 133 அதிகாரங்களையும் கொண்டது."}, "en": {"blocks": [{"type": "text", "content": "What are the total number of Iyals (sub-sections) and Adhikarams (chapters) in Thirukkural?", "media_id": null}], "options": {"A": "5 sections, 100 chapters", "B": "7 sections, 120 chapters", "C": "12 sections, 150 chapters", "D": "9 sections (Iyals), 133 chapters (1330 couplets)"}, "explanation": "Thirukkural comprises 9 Iyals and 133 chapters totaling 1,330 couplets across 3 books."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025",