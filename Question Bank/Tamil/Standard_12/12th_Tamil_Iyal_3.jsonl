{"id": "12th_tamil_u3_q409", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thamizhar_kudumba_murai", "chapter_id": null, "topic_id": "il_word_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘இல்’ என்னும் சொல்லின் வேர்ப்பொருள் எதனைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "இருப்பிடம் / உறைவிடம் / வீடு", "B": "வானம்", "C": "கடல்", "D": "மலை"}, "explanation": "இல் என்பது மனிதன் தங்கி வாழும் இருப்பிடம் அல்லது வீட்டைக் குறிக்கும் சங்கச் சொல்லாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the primal root meaning of the classical Tamil word 'Il'?", "media_id": null}], "options": {"A": "Abode / Hearth / House (Iruppidam)", "B": "Atmospheric sky", "C": "Ocean depths", "D": "Mountain range"}, "explanation": "'Il' denotes home, domestic residence, or family dwelling place."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 47, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 47", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session":