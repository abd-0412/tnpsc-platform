{"id": "12th_tamil_u3_q580", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "tnpsc_pyq_u3", "chapter_id": null, "topic_id": "brotherhood_seven_names", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இராமனின் சகோதரர்களாகக் கம்பராமாயணத்தில் இணையும் ‘எழுவர்’ வரிசையில் பொருந்தாதவர் யார்?", "media_id": null}], "options": {"A": "இராமன், இலக்குவன், பரதன், சத்துருக்கனன்", "B": "குகன்", "C": "சுக்கிரீவன், வீடணன்", "D": "கும்பகர்ணன்"}, "explanation": "நால்வர் தம்பியரோடு குகன், சுக்கிரீவன், வீடணன் இணைந்து எழுவர் ஆயினர்; கும்பகர்ணன் போரில் இராமனை எதிர்த்து உயிர்நீத்தவன்."}, "en": {"blocks": [{"type": "text", "content": "Who among the following is NOT part of the fraternal group of seven brothers (Ezhuvar) in Kambaramayanam?", "media_id": null}], "options": {"A": "Rama, Lakshmana, Bharata, Shatrughna", "B": "Guha", "C": "Sugriva and Vibhishana", "D": "Kumbhakarna"}, "explanation": "Kumbhakarna remained loyal to Ravana and died in battle; he is not counted among the seven brothers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "12th Tamil, Unit