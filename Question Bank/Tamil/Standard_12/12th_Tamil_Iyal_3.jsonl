{"id": "12th_tamil_u3_q534", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_u3", "chapter_id": null, "topic_id": "seyndrandri_kural_1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘செய்யாமல் செய்த உதவிக்கு வையகமும்\nவானகமும் ஆற்றல் அரிது’ - இக்குறள் உணர்த்தும் பொருள் யாது?", "media_id": null}], "options": {"A": "உதவி செய்யக்கூடாது", "B": "தான் ஒரு பயனும் செய்யாதிருக்கத் தனக்குச் செய்த உதவிக்கு விண்ணுலகையும் மண்ணுலகையும் ஈடாகத் தந்தாலும் ஈடாகாது", "C": "மண்ணுலகம் மட்டுமே பெரியது", "D": "வானகம் மட்டுமே சிறந்தது"}, "explanation": "முன்பு எந்த உதவியும் செய்யாத ஒருவருக்குத் தானாக முன்வந்து செய்யும் பேருதவிக்கு மூவுலகையும் தந்தாலும் ஈடாகாது."}, "en": {"blocks": [{"type": "text", "content": "What universal ethical truth is enshrined in 'Seyyaamal seidha udhavikku vaiyagamum vaanagamum aatral aridhu'?", "media_id": null}], "options": {"A": "Assistance should never be rendered", "B": "To a favor done without previous obligation, neither earth nor heaven is adequate recompense", "C": "Earth alone is boundless", "D": "Heaven alone is sublime"}, "explanation": "Unprompted assistance rendered without prior obligation cannot be equalled even by offering earth and heaven."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "pu