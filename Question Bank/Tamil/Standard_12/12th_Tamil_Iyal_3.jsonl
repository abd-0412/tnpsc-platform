{"id": "12th_tamil_u3_q577", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "tnpsc_pyq_u3", "chapter_id": null, "topic_id": "brotherhood_quote_kamban", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘குகனொடும் ஐவர் ஆனேம் முன்பு; பின் குன்று சூழ்வான்\nமகனொடும் அறுவர் ஆனேம்; எம்முழை அன்பின் வந்த\nஅகனமர் காதலைய! நின்னொடும் எழுவர் ஆனேம்!’ - இதில் ‘குன்று சூழ்வான் மகன்’ என்று இராமன் யாரைக் குறிப்பிடுகிறான்?", "media_id": null}], "options": {"A": "சுக்கிரீவன் (சூரியனின் மகன்)", "B": "வாலி", "C": "அங்கதன்", "D": "அனுமன்"}, "explanation": "குன்று சூழ்வான் என்பது மேரு மலையைச் சுற்றி வரும் கதிரவனைக் (சூரியன்) குறிக்கும்; அவனது மகன் சுக்கிரீவன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "In the verse 'Guhanodum aivar aanem... kundru soozhvaan maganodum aruvar aanem', who is designated as 'Kundru soozhvaan magan'?", "media_id": null}], "options": {"A": "Sugriva (son of the Sun who circles the mountain)", "B": "Vali", "C": "Angada", "D": "Hanuman"}, "explanation": "'Kundru soozhvaan' refers to the Sun circumambulating Mount Meru, whose son is Sugriva."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "20