{"id": "12th_tamil_u3_q513", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "porul_mayakkam", "chapter_id": null, "topic_id": "kalai_maadu_spacing", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘காளை மாடு’ மற்றும் ‘காளைமாடு’ - பொருள் மயக்கமின்றித் தொடரில் ஆளும் முறை யாது?", "media_id": null}], "options": {"A": "பிரித்து எழுதினால் காளையாகிய மாடு (இணைப்புப் பெயர்); சேர்த்து எழுதினால் ஓர் இனத்தின் பெயர்", "B": "இரண்டும் பசு மாட்டைக் குறிக்கும்", "C": "சேர்த்து எழுதினால் கன்றுக்குட்டி", "D": "பிரித்து எழுதினால் குதிரை"}, "explanation": "காளை மாடு எனப் பிரித்தால் காளை ஆகிய மாடு எனப் பண்பையும், காளைமாடு எனச் சேர்த்தால் பொதுவான மாட்டின் வகையையும் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "How does compounding vs spacing distinguish meaning in 'Kaalai maadu' vs 'Kaalaimaadu'?", "media_id": null}], "options": {"A": "Separated: descriptive junction (the bovine which is a bull); compounded: generic species noun", "B": "Both mean a milking cow", "C": "Compounded means a calf", "D": "Separated means a horse"}, "explanation": "Separated indicates descriptive apposition; joined forms a single generic compound noun."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 59, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 59", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 3", "Grammar", "Kaalai Maadu Spacing"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u3_q514", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "porul_mayakkam", "chapter_id": null, "topic_id": "avan_than_thanthai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அவன் தன் தந்தை வீட்டிற்குச் சென்றான்’ மற்றும் ‘அவன் தந்தையின் வீட்டிற்குச் சென்றான்’ - பொருள் வேறுபாடு யாது?", "media_id": null}], "options": {"A": "இரண்டும் ஒரே வீட்டிற்குச் சென்றதைக் குறிக்கும்", "B": "முதல் தொடரில் அவன் தன் சொந்தத் தந்தை வீட்டிற்குச் சென்றான்; இரண்டாவது தொடரில் பிறிதொருவனின் தந்தையின் வீட்டிற்குச் சென்றான் என்ற மயக்கம் ஏற்பட வாய்ப்புள்ளது", "C": "முதல் தொடரில் தந்தை இல்லை", "D": "இரண்டாவது தொடரில் அவன் போகவில்லை"}, "explanation": "‘தன்’ என்ற தற்சுட்டுப் பெயர் தன் சொந்தத் தந்தையைக் குறிக்கும்; ‘தந்தையின்’ எனப் பொதுவாகக் கூறும்போது பிறிதொருவனின் தந்தையைக் குறிக்கும் பொருள் மயக்கம் நேரிடலாம்."}, "en": {"blocks": [{"type": "text", "content": "What subtle distinction exists between 'Avan than thandhai veettirkuch chendraan' and 'Avan thandhaiyin veettirkuch chendraan'?", "media_id": null}], "options": {"A": "Identical house", "B": "First sentence strictly refers to his own father's house; second leaves ambiguity that it could mean another person's father", "C": "Father absent in first", "D": "Did not travel in second"}, "explanation": "The reflexive pronoun 'than' guarantees reference to his own father; omitting it can leave ambiguity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings":