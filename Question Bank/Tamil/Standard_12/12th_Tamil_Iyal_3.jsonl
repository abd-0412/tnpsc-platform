{"id": "12th_tamil_u3_q575", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "tnpsc_pyq_u3", "chapter_id": null, "topic_id": "thiruvalluvar_year_calculation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்நாடு அரசு அதிகாரப்பூர்வமாக ஏற்றுக்கொண்டுள்ள திருவள்ளுவர் ஆண்டைக் கணக்கிடக் கிறித்து ஆண்டுடன் எத்தனை ஆண்டுகளைக் கூட்ட வேண்டும்?", "media_id": null}], "options": {"A": "50 ஆண்டுகள்", "B": "25 ஆண்டுகள்", "C": "31 ஆண்டுகள்", "D": "100 ஆண்டுகள்"}, "explanation": "திருவள்ளுவர் ஆண்டு என்பது கிறித்து பிறப்பதற்கு 31 ஆண்டுகளுக்கு முற்பட்டது; எனவே தற்போதைய ஆங்கில ஆண்டுடன் 31-ஐக் கூட்ட வேண்டும் (எ.கா: 2026 + 31 = 2057)."}, "en": {"blocks": [{"type": "text", "content": "To compute the official Thiruvalluvar Year adopted by the Tamil Nadu Government, how many years must be added to the Gregorian year?", "media_id": null}], "options": {"A": "50 years", "B": "25 years", "C": "31 years", "D": "100 years"}, "explanation": "Add 31 years to the Gregorian calendar year to determine the Thiruvalluvar Year."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 66, "chapter": null, "section": null, "reference