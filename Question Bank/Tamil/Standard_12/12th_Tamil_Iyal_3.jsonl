{"id": "12th_tamil_u3_q493", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "urimaithaagam", "chapter_id": null, "topic_id": "land_sentiment", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "விவசாயிகளுக்கு நிலம் என்பது வெறும் மண்தானமா அல்லது அதற்கும் மேலானதா என்பதை ஆசிரியர் எவ்வாறு காட்டுகிறார்?", "media_id": null}], "options": {"A": "நிலம் என்பது விவசாயிகளின் உயிர், மானம், தாய்மை மற்றும் கௌரவத்தின் அடையாளம்", "B": "வெறும் விற்பனைப் பொருள் மட்டுமே", "C": "பயனற்ற ஒரு சொத்து", "D": "பொழுதுபோக்கு இடம்"}, "explanation": "விவசாயிகளுக்குத் தன் பூர்வீக நிலம் என்பது மானத்தோடும் பரம்பரை கௌரவத்தோடும் தாய்மையோடும் தொடர்புடைய உயிர்ப்பொருள்."}, "en": {"blocks": [{"type": "text", "content": "How does Poomani articulate the peasant's psychological bond with agricultural soil?", "media_id": null}], "options": {"A": "Land is the peasant's very life, dignity, maternal heritage, and inviolable honor", "B": "Mere disposable real estate merchandise", "C": "Worthless burden", "D": "Leisure ground"}, "explanation": "Ancestral soil represents identity, motherly sustenance, and family honor to rural peasants."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "t