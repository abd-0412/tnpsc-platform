{"id": "12th_tamil_u3_q476", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "kambaramayanam_u3", "chapter_id": null, "topic_id": "moral_significance_epic", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கம்பராமாயணத்தின் மூலமாக நாம் அறியும் தலையாய அறநெறி யாது?", "media_id": null}], "options": {"A": "ஆயுத பலத்தால் மட்டுமே உலகை ஆள முடியும்", "B": "பகைவரை எப்போதும் அழிக்க வேண்டும்", "C": "உறவுகளைப் பிரித்து வாழ வேண்டும்", "D": "அன்பும் அறமுமே நிலையான வெற்றியைத் தரும்; தர்மம் ஒருபோதும் தோற்பதில்லை; எல்லைகளற்ற சகோதரத்துவமே வாழ்வின் சிகரம்"}, "explanation": "அறத்தின் வாழ்வே இறுதியில் வெல்லும்; அனைவரையும் நேசிக்கும் சகோதரத்துவமே வாழ்வின் விழுமியம் என்பதை இக்காவியம் நிலைநிறுத்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What supreme moral verity is immortalized through the epic narrative of Kambaramayanam?", "media_id": null}], "options": {"A": "Physical armaments alone conquer the earth", "B": "Enemies must always be wiped out mercilessly", "C": "Kinship must be severed", "D": "Dharma and unconditional love ultimately triumph; boundless universal fraternity is the pinnacle of human life"}, "explanation": "Righteousness and love triumph over evil, and universal fraternity represents the summit of human perfection."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "bo