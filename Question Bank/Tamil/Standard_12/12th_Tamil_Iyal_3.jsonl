{"id": "12th_tamil_u3_q542", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_u3", "chapter_id": null, "topic_id": "arudchelvam_kural", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அருட்செல்வம் செல்வத்துள் செல்வம் பொருட்செல்வம்\nபூரியார் கண்ணும் உள’ - இக்குறளில் ‘பூரியார்’ என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "புலவர்கள்", "B": "இழிந்தவர்கள் (கீழான குணம் கொண்ட எளிய குணத்தவர்)", "C": "அரசர்கள்", "D": "வணிகர்கள்"}, "explanation": "பூரியார் என்றால் இழிந்த குணமுடையவர்கள் என்று பொருள். பொருட்செல்வம் இழிந்தோரிடமும் இருக்கும்; அருட்செல்வமே உண்மையான பெருஞ்செல்வம்."}, "en": {"blocks": [{"type": "text", "content": "What does 'Pooriyaar' denote in Kural 241?", "media_id": null}], "options": {"A": "Scholarly poets", "B": "Base, ignoble, or degraded persons", "C": "Sovereign monarchs", "D": "Wealthy merchants"}, "explanation": "'Pooriyaar' designates ignoble, morally base individuals."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 65, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 65", "url": null, "source_notes": null}, "previous_y