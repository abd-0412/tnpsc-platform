{"id": "12th_tamil_u3_q547", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_u3", "chapter_id": null, "topic_id": "thiruvalluvar_titles", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருவள்ளுவருக்கு வழங்கும் சிறப்புப் பெயர்களுள் பொருந்தாதது எது?", "media_id": null}], "options": {"A": "நாயனார், முதற்பாவலர்", "B": "தெய்வப்புலவர், செந்நாப்போதார்", "C": "கவிச்சக்கரவர்த்தி", "D": "பொய்யில் புலவர், பெருநாவலர்"}, "explanation": "நாயனார், முதற்பாவலர், தெய்வப்புலவர், செந்நாப்போதார், பொய்யில் புலவர், பெருநாவலர் ஆகியவை திருவள்ளுவரின் பெயர்கள்; ‘கவிச்சக்கரவர்த்தி’ கம்பரின் பெயராகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following titles does NOT apply to Thiruvalluvar?", "media_id": null}], "options": {"A": "Nayanar, Mudhatpaavalar", "B": "Theivappulavar, Sennaappodhaar", "C": "Kavichakravarti (laurel of Kambar)", "D": "Poyyil Pulavar, Perunaavalar"}, "explanation": "Kavichakravarti belongs to Kambar, whereas the others are classical titles of Thiruvalluvar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 66, "chapter": null, "section": null, "reference": "