{"id": "12th_tamil_u3_q554", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_u3", "chapter_id": null, "topic_id": "kural_terminating_feet", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெண்பாவின் ஈற்றுச் சீர் (கடைசிச் சீர்) எவ்வகை வாய்பாடுகளுள் ஏதேனும் ஒன்றாக மட்டுமே முடிதல் வேண்டும்?", "media_id": null}], "options": {"A": "தேமா, புளிமா, கூவிளம், கருவிளம்", "B": "நாள், மலர், காசு, பிறப்பு", "C": "அசை, சீர், அடி, தொடை", "D": "காய், கனி"}, "explanation": "வெண்பாவின் ஈற்றுச் சீர் ‘நாள், மலர், காசு, பிறப்பு’ என்னும் வாய்பாடுகளில் ஒன்றைக் கொண்டே முடிதல் வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "In Tamil metrics, the terminal foot (Eetru Seer) of any Venba must conclude in which metric formulas?", "media_id": null}], "options": {"A": "Thema, Pulima, Koovizham, Karuvizham", "B": "Naal, Malar, Kaasu, or Pirappu", "C": "Asai, Seer, Adi, Thodai", "D": "Kaai and Kani"}, "explanation": "The final foot of a Venba must resolve to Naal, Malar, Kaasu, or Pirappu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 66, "chapter": null, "section": null, "reference": "12th