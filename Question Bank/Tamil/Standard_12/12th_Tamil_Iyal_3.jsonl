{"id": "12th_tamil_u3_q489", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "urimaithaagam", "chapter_id": null, "topic_id": "story_climax", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அண்ணன் முத்தையன் செய்த உதவியைக் கண்டு தம்பி வெள்ளைச்சாமி அடைந்த மனநிலை எது?", "media_id": null}], "options": {"A": "தன் தவறை உணர்ந்து வெட்கித் தலைகுனிந்து, அண்ணனின் கால்களில் விழுந்து கண்ணீர் மல்கக் கட்டித்தழுவி இணைந்தான்", "B": "அண்ணனை மேலும் திட்டினான்", "C": "பணத்தை வாங்க மறுத்தான்", "D": "நிலத்தை விட்டு ஓடினான்"}, "explanation": "தன் மீது அண்ணன் வைத்திருந்த ஆழ்ந்த பாசத்தை உணர்ந்த வெள்ளைச்சாமி கண்ணீர் மல்க அண்ணனைத் தழுவிக்கொண்டான்; குடும்பம் மீண்டும் இணைந்தது."}, "en": {"blocks": [{"type": "text", "content": "How did younger brother Vellaisami react when he realized his elder brother had saved his land from ruin?", "media_id": null}], "options": {"A": "Overwhelmed with remorse and gratitude, fell at his brother's feet weeping and embraced him in tearful reconciliation", "B": "Berated his brother further", "C": "Refused the redemption deed", "D": "Fled abandoning the farm"}, "explanation": "Vellaisami broke down in tears, touched by his brother's selfless love, sealing their reconciliation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kal