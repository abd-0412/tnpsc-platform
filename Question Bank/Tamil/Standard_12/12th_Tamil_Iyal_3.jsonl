{"id": "12th_tamil_u3_q512", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "porul_mayakkam", "chapter_id": null, "topic_id": "sandhi_meaning_change", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வல்லினம் மிகுதலும் மிகாமையும் வாக்கியத்தின் பொருளை முற்றிலும் மாற்றும் என்பதற்குச் சான்றான இணை எது?", "media_id": null}], "options": {"A": "அங்கு போனான் - அங்குப் போனான்", "B": "பாடம் படித்தான் - பாடத்தைப் படித்தான்", "C": "நூல் வாங்கினான் - புத்தகம் வாங்கினான்", "D": "‘வேலை கிடைத்தது’ (பணி கிடைத்தது) - ‘வேலைக் கிடைத்தது’ (வேல் என்னும் ஆயுதம் கிடைத்தது)"}, "explanation": "வேலை கிடைத்தது என்றால் பணி கிடைத்தது; ‘க்’ மிக்கு ‘வேலைக் கிடைத்தது’ என எழுதினால் வேல் என்னும் ஆயுதத்தைப் பெற்றான் எனப் பொருள் முற்றிலும் மாறுபடும்."}, "en": {"blocks": [{"type": "text", "content": "Which pair demonstrates how the doubling vs non-doubling of a hard consonant radically alters sentence semantics?", "media_id": null}], "options": {"A": "Option A", "B": "Option B", "C": "Option C", "D": "'Vélai kidaithadhu' (Employment obtained) vs 'Vélai-k kidaithadhu' (A spear was obtained)"}, "explanation": "'Vélai kidaithadhu' means got a job; inserting 'k' ('Vélai-k kidaithadhu') transforms meaning to 'received a spear'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samach