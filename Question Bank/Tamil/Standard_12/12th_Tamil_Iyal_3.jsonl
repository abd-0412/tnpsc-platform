{"id": "12th_tamil_u3_q432", "schema_version": "1.0", "kind": "statement", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "virundhinar_illam", "chapter_id": null, "topic_id": "rumi_statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜலாலுத்தீன் ரூமி குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\nகூற்று 1: ரூமி 13-ஆம் நூற்றாண்டில் வாழ்ந்த பாரசீகச் சூபி கவிஞர்.\nகூற்று 2: இவரது ‘மஸ்னவி’ என்னும் நூல் 25,600 பாடல்களைக் கொண்ட ஆன்மீகக் களஞ்சியம்.", "media_id": null}], "options": {"A": "கூற்று 1 மட்டும் சரி", "B": "கூற்று 2 மட்டும் சரி", "C": "இரண்டு கூற்றுகளும் தவறு", "D": "இரண்டு கூற்றுகளும் சரி"}, "explanation": "ரூமி 13-ஆம் நூற்றாண்டு பாரசீகச் சூபி கவிஞர்; மஸ்னவி 25,600 பாடல்களைக் கொண்டது. இரண்டு கூற்றுகளும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the statements regarding Jalaluddin Rumi:\nStatement 1: Rumi was a 13th-century Persian Sufi mystic poet.\nStatement 2: His masterpiece 'Masnavi' encompasses 25,600 spiritual verses.", "media_id": null}], "options": {"A": "Statement 1 only is correct", "B": "Statement 2 only is correct", "C": "Both statements are incorrect", "D": "Both statements are correct"}, "explanation": "Both statements accurately profile Rumi's era and literary monument."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tam