{"id": "12th_tamil_u3_q574", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "tnpsc_pyq_u3", "chapter_id": null, "topic_id": "matrilineal_inheritance_kudumbam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைய தமிழர் சமூகத்தில் தாய்வழி முறை நிலவியபோது தாயின் சொத்துக்கள் யாருக்குச் சென்று சேர்ந்தன?", "media_id": null}], "options": {"A": "மூத்த மகனுக்கு மட்டும்", "B": "பெண் பிள்ளைகளுக்கு (மகள்களுக்கு)", "C": "அரசருக்கு", "D": "கிராமப் பஞ்சாயத்திற்கு"}, "explanation": "தாய்வழிச் சமூகத்தின் அடிப்படை விதியின்படி குடும்பத்தின் சொத்துரிமை பெண் வழியிலேயே (மகள்களுக்கே) உரிமை கொண்டதாக இருந்தது."}, "en": {"blocks": [{"type": "text", "content": "Under ancient Tamil matrilineal traditions, to whom did ancestral domestic property devolve?", "media_id": null}], "options": {"A": "Eldest son exclusively", "B": "Female daughters of the household", "C": "The reigning king", "D": "Village council"}, "explanation": "In matrilineal inheritance, family property and heirloom assets passed down to daughters."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 48, "chapter": null, "section": null, "referenc