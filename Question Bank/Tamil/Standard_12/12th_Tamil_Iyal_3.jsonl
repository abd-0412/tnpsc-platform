{"id": "12th_tamil_u3_q558", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_u3", "chapter_id": null, "topic_id": "meaning_maanap_peridhu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஞாலத்தின் மாணப் பெரிது’ என்பதில் ‘மாண’ என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "மாணவன்", "B": "மிகவும் / பெரிதும் (மாண்புடையதாக)", "C": "குறைவாக", "D": "விரைவாக"}, "explanation": "மாண என்பது ‘மிகவும்’ அல்லது ‘மிகப் பெரியதாக’ என்னும் பொருளைத் தரும் உரிச்சொல்லாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the grammatical meaning of 'Maana' in 'Gnaalathin maanap peridhu'?", "media_id": null}], "options": {"A": "Student", "B": "Exceedingly / vastly / supremely", "C": "Minimally", "D": "Swiftly"}, "explanation": "'Maana' is an intensifying particle meaning exceedingly or vastly."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 64, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 64", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "sessi