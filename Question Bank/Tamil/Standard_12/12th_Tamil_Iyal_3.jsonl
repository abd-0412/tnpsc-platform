{"id": "12th_tamil_u3_q573", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "tnpsc_pyq_u3", "chapter_id": null, "topic_id": "guha_boatman_river", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கம்பராமாயணத்தில் குகன் படகோட்டியாக விளங்கிய புண்ணிய நதி எது?", "media_id": null}], "options": {"A": "கங்கை நதி", "B": "யமுனை நதி", "C": "சரயு நதி", "D": "கோதாவரி நதி"}, "explanation": "குகன் கங்கை நதிக்கரையில் அமைந்துள்ள சிருங்கிபேரபுரத்தின் வேட்டுவத் தலைவனாகவும் படகோட்டியாகவும் விளங்கினான்."}, "en": {"blocks": [{"type": "text", "content": "On which sacred river did Guha operate as the master ferryman in Kambaramayanam?", "media_id": null}], "options": {"A": "River Ganges (Gangai)", "B": "River Yamuna", "C": "River Sarayu", "D": "River Godavari"}, "explanation": "Guha was the lord of the boatsmen across River Ganges at Sringiberapura."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 54, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 54", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4", "exam_name": "Group IV Serv