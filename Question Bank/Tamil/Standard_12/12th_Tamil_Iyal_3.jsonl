{"id": "12th_tamil_u3_q546", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_u3", "chapter_id": null, "topic_id": "arutchelvam_superiority", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வள்ளுவர் ‘அருட்செல்வத்தை’ செல்வத்துள் தலையாய செல்வமாகக் குறிப்பிடக் காரணம் என்ன?", "media_id": null}], "options": {"A": "அருள் இல்லாதவன் வாழ முடியாது", "B": "பொருட்செல்வம் அழியக்கூடியது மற்றும் கீழ்மக்களிடமும் இருப்பது; அருட்செல்வம் மட்டுமே அழியாத ஆன்ம மாண்பைத் தருவது", "C": "அருளுக்கு வரி இல்லை", "D": "அருள் இருந்தால் உணவு தேவையில்லை"}, "explanation": "பொருட்செல்வம் எவராலும் பெறப்படலாம்; ஆனால் அனைத்து உயிர்களிடத்தும் கருணை காட்டும் அருட்செல்வமே மனிதனைத் தெய்வ நிலைக்கு உயர்த்தும் உயர்ந்த செல்வம்."}, "en": {"blocks": [{"type": "text", "content": "Why does Valluvar extol the 'Wealth of Grace/Compassion' (Arutchelvam) as the supreme treasure above material wealth?", "media_id": null}], "options": {"A": "Lack of grace brings physical death", "B": "Material wealth is perishable and possessed even by base scoundrels, whereas compassionate grace uniquely elevates the soul", "C": "Grace is tax-exempt", "D": "Grace eliminates physical hunger"}, "explanation": "Material wealth is transient and common to base men; compassionate grace alone confers transcendent spiritual nobility."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_mu