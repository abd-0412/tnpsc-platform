{"id": "12th_tamil_u3_q517", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "porul_mayakkam", "chapter_id": null, "topic_id": "pin_varum_spacing", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பின் வரும்’ மற்றும் ‘பின்வரும்’ - இவ்விரண்டில் எது சரியான பயன்பாடு?", "media_id": null}], "options": {"A": "தொடர்ந்து வரும் வினாக்களைக் குறிக்க ‘பின்வரும் வினாக்கள்’ எனச் சேர்த்து எழுதுவதே சரியானது", "B": "எப்போதும் பிரித்து மட்டுமே எழுத வேண்டும்", "C": "இரண்டுமே தவறானவை", "D": "சேர்த்து எழுதக் கூடாது"}, "explanation": "‘பின்வரும் வினாக்களுக்கு விடையளி’ எனச் சேர்த்து எழுதுவதே மரபு. ‘பின் வரும்’ என்றால் காலத்தால் தாமதமாகப் பின்னால் வரும் எனப் பொருள் தரும்."}, "en": {"blocks": [{"type": "text", "content": "Which is the grammatically correct orthographic usage when introducing subsequent questions: 'Pin varum' vs 'Pinvarum'?", "media_id": null}], "options": {"A": "'Pinvarum vinaakkal' compounded together is standard orthography", "B": "Always separated", "C": "Both are erroneous", "D": "Never compounded"}, "explanation": "'Pinvarum' compounded functions as an adjective meaning 'the following/ensuing'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "1