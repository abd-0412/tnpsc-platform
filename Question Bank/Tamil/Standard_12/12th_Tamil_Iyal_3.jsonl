{"id": "12th_tamil_u3_q431", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "virundhinar_illam", "chapter_id": null, "topic_id": "gratitude_philosophy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிதையின் இறுதியில் ‘வருபவர் யாராயினும் நன்றி செலுத்துங்கள்’ என்று கூறக் காரணம் என்ன?", "media_id": null}], "options": {"A": "அவர்கள் பணம் கொடுத்துச் செல்வார்கள்", "B": "அவர்கள் நம் உறவினர்கள்", "C": "ஒவ்வொரு விருந்தினரும் மறுமை உலகத்திலிருந்து நமக்கு ஒரு வழிகாட்டியாகவே அனுப்பி வைக்கப்படுகிறார்கள்", "D": "அவர்கள் புகழ் பாடுவார்கள்"}, "explanation": "ஒவ்வொரு உணர்வும் அனுபவமும் மனிதனைப் பக்குவப்படுத்தி வழிநடத்த இறைவனால் அனுப்பப்படும் வழிகாட்டிகளே ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Why does Rumi urge gratitude to whoever arrives at our door at the close of the poem?", "media_id": null}], "options": {"A": "They pay heavy lodging fees", "B": "They are close blood relatives", "C": "Each visitor has been dispatched from beyond as an ordained guide for spiritual growth", "D": "They sing our praises"}, "explanation": "Be grateful to whoever comes, because each has been sent as a guide from beyond."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporat