{"id": "12th_tamil_u3_q411", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thamizhar_kudumba_murai", "chapter_id": null, "topic_id": "sangam_hospitality_quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘செல்வத்துப் பயனே ஈதல்\nதுய்ப்பேம் எனினே தப்புந பலவே’ - இப்பாடல் உணர்த்தும் உயரிய தமிழர் பண்பாடு எது?", "media_id": null}], "options": {"A": "செல்வத்தைச் சேர்த்து வைப்பது", "B": "போரிட்டு வெல்வது", "C": "தாம் ஈட்டிய செல்வத்தைப் பிறருக்குக் கொடுத்து உதவும் பகிர்வு நெறி", "D": "துறவு மேற்கொள்வது"}, "explanation": "செல்வத்தின் உண்மையான பயனே பிறருக்குக் கொடுத்து மகிழ்வதாகும் என்று நக்கீரர் புறநானூற்றில் (பாடல் 189) கூறுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What noble cultural value is proclaimed in the Purananuru verse 'Selvathup payane eedhal...'?", "media_id": null}], "options": {"A": "Hoarding vast treasures", "B": "Waging aggressive warfare", "C": "Sharing one's wealth through selfless munificence (Eedhal)", "D": "Total ascetic renunciation"}, "explanation": "The true purpose of possessing wealth is sharing it munificently with society."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "ed