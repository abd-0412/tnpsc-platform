{"id": "12th_tamil_u3_q585", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "tnpsc_pyq_u3", "chapter_id": null, "topic_id": "chola_empire_zenith_literature", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் இலக்கிய வரலாற்றில் ‘கம்பர், ஒட்டக்கூத்தர், புகழேந்தி, ஜெயங்கொண்டார், சேக்கிழார்’ வாழ்ந்த சோழர் காலம் எவ்வாறு போற்றப்படுகிறது?", "media_id": null}], "options": {"A": "தமிழ்க் காப்பியங்களின் பொற்காலம் (செவ்வியல் இலக்கிய மறுமலர்ச்சிக் காலம்)", "B": "இருண்ட காலம்", "C": "பக்தி இலக்கியக் காலம் மட்டும்", "D": "உரைநடை காலம்"}, "explanation": "சோழர் காலம் கம்பராமாயணம், பெரியபுராணம், கலிங்கத்துப் பரணி போன்ற தலைசிறந்த பெருங்காப்பியங்கள் தோன்றிய ‘பொற்காலம்’ எனப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "How is the Chola era of Kambar, Sekkizhar, and Jeyamkondar celebrated in Tamil literary history?", "media_id": null}], "options": {"A": "The Golden Age of Tamil Epic Literature (Porkaalam)", "B": "Dark Age", "C": "Hymnal era only", "D": "Prose era"}, "explanation": "The Imperial Chola period is celebrated as the Golden Age of monumental Tamil narrative epics."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_y