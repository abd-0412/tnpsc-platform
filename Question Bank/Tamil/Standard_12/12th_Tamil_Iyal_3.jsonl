{"id": "12th_tamil_u3_q400", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thamizhar_kudumba_murai", "chapter_id": null, "topic_id": "author_other_books", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பக்தவத்சல பாரதி இயற்றிய பிற புகழ்பெற்ற மானிடவியல் ஆய்வு நூல்களுள் பொருந்தாதது எது?", "media_id": null}], "options": {"A": "பண்பாட்டு மானிடவியல்", "B": "பழங்குடிகள்", "C": "தமிழகப் பழங்குடிகள்", "D": "கொற்கை"}, "explanation": "பண்பாட்டு மானிடவியல், பழங்குடிகள், தமிழகப் பழங்குடிகள், பாணர் இன வரைவியல் போன்றவை பக்தவத்சல பாரதியின் நூல்கள்; ‘கொற்கை’ ஜோ டி குரூஸின் நாவல்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following research treatises was NOT written by anthropologist Bhakthavatsala Bharathi?", "media_id": null}], "options": {"A": "Panbaattu Maanidaviyal", "B": "Pazhangudigal", "C": "Thamizhaga Pazhangudigal", "D": "Korkai"}, "explanation": "'Korkai' is a novel by Joe D'Cruz, whereas the others are anthropological treatises by Bhakthavatsala Bharathi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 50, "chapter": null, "section": null, "reference": "12th Tamil,