{"id": "12th_tamil_u3_q497", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "urimaithaagam", "chapter_id": null, "topic_id": "karisal_pioneer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கரிசல் இலக்கியத்தின் தந்தை என்று போற்றப்படுபவர் யார்?", "media_id": null}], "options": {"A": "கி. ராஜநாராயணன் (கி.ரா.)", "B": "கு. அழகிரிசாமி", "C": "பூமணி", "D": "மேலாண்மை பொன்னுச்சாமி"}, "explanation": "கரிசல் இலக்கியத்தின் முன்னோடியாகவும் தந்தையாகவும் திகழ்ந்தவர் எழுத்தாளர் கி. ராஜநாராயணன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who is universally acclaimed as the Patriarch / Pioneer of Karisal Literature?", "media_id": null}], "options": {"A": "Ki. Rajanarayanan (Ki. Ra.)", "B": "Ku. Alagirisamy", "C": "Poomani", "D": "Melanmai Ponnusamy"}, "explanation": "Ki. Rajanarayanan is the pioneer and father figure of Karisal literature."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 58, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 58", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": n