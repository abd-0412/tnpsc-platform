{"id": "12th_tamil_u3_q494", "schema_version": "1.0", "kind": "statement", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "urimaithaagam", "chapter_id": null, "topic_id": "author_statements_poomani", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எழுத்தாளர் பூமணி குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\nகூற்று 1: இவரது இயற்பெயர் பூ. மாணிக்கவாசகம்; தூத்துக்குடி மாவட்டம் கோவில்பட்டி வட்டாரத்தைச் சேர்ந்தவர்.\nகூற்று 2: இவர் ‘அஞ்ஞாடி’ நாவலுக்காக 2014-ஆம் ஆண்டு சாகித்திய அகாதெமி விருது பெற்றார்.", "media_id": null}], "options": {"A": "கூற்று 1 மட்டும் சரி", "B": "இரண்டு கூற்றுகளும் சரி", "C": "கூற்று 2 மட்டும் சரி", "D": "இரண்டு கூற்றுகளும் தவறு"}, "explanation": "பூமணியின் இயற்பெயர் பூ. மாணிக்கவாசகம்; கோவில்பட்டியைச் சேர்ந்தவர்; அஞ்ஞாடி நாவலுக்கு சாகித்திய அகாதெமி விருது பெற்றார். இரண்டும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the statements about author Poomani:\nStatement 1: His given name is Poo. Manickavasagam and he hails from Kovilpatti.\nStatement 2: He won the Sahitya Akademi Award in 2014 for 'Agnjaadi'.", "media_id": null}], "options": {"A": "Statement 1 only is correct", "B": "Both statements are correct", "C": "Statement 2 only is correct", "D": "Both statements are incorrect"}, "explanation": "Both statements accurately profile Poomani's biographical background and achievements."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_