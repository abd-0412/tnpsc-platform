{"id": "12th_tamil_u3_q445", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "virundhinar_illam", "chapter_id": null, "topic_id": "meaning_meanness_verse", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஒரு கணம் தோன்றும் அற்பத்தனம்...’ - இத்தொடரில் ‘அற்பத்தனம்’ என்பது மனிதனின் எக்குணத்தைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "குறுகிய மனம் / தாழ்ந்த கீழான எண்ணம்", "B": "பெருந்தன்மை", "C": "வீரம்", "D": "அறிவு"}, "explanation": "அற்பத்தனம் என்பது மனித உள்ளத்தில் தோன்றும் கீழ்த்தரமான, சுயநலமான குறுகிய சிந்தனையைக் குறிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What trait is designated by the expression 'Meanness' (Arppathanam) in the poem?", "media_id": null}], "options": {"A": "Petty, narrow-minded, or base thoughts", "B": "Magnanimity", "C": "Valor", "D": "Intellect"}, "explanation": "'Meanness' refers to sudden flash of petty, base, or selfish impulses."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 51", "url": null, "source_notes": null}, "previous_year": {"is_previous_year