{"id": "12th_tamil_u3_q491", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "urimaithaagam", "chapter_id": null, "topic_id": "poomani_source_anthology", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உரிமைத்தாகம்’ சிறுகதை பூமணியின் எந்தச் சிறுகதைத் தொகுப்பிலிருந்து பாடமாக வைக்கப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "அறுப்பு", "B": "வயிறுகள்", "C": "பூமணியின் சிறுகதைகள்", "D": "ரீதி"}, "explanation": "இக்கதை ‘பூமணியின் சிறுகதைகள்’ என்னும் ஒட்டுமொத்தத் தொகுப்பிலிருந்து பாடநூலில் இடம்பெற்றுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "From which anthology is the prescribed story 'Urimaithaagam' drawn?", "media_id": null}], "options": {"A": "Aruppu", "B": "Vayirugal", "C": "Poomaniyin Sirukadhaigal", "D": "Reethi"}, "explanation": "The story is excerpted from 'Poomaniyin Sirukadhaigal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 58, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 58", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session"