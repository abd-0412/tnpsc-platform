{"id": "12th_tamil_u3_q557", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_u3", "chapter_id": null, "topic_id": "meaning_nayan_thookkin", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பயன்தூக்கார் செய்த உதவி நயன்தூக்கின்’ என்பதில் ‘நயன்’ என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "நன்மை / ஈகைத்தன்மை (உதவியின் சிறப்பு)", "B": "கண்", "C": "நீர்", "D": "நிலம்"}, "explanation": "நயன் என்றால் ‘நன்மை’ அல்லது ‘ஈகைக் குணத்தின் சிறப்பு’ என்று பொருள்படும்."}, "en": {"blocks": [{"type": "text", "content": "What does 'Nayan' denote in the verse line 'Payanthookkaar seidha udhavi nayanthookkin'?", "media_id": null}], "options": {"A": "Goodness / Magnanimous virtue of the favor", "B": "Eye", "C": "Water", "D": "Land"}, "explanation": "'Nayan' denotes goodness, intrinsic virtue, or gracious benevolence."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 64, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 64", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper"