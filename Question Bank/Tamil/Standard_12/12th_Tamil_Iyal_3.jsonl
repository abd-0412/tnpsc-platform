{"id": "12th_tamil_u3_q444", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "virundhinar_illam", "chapter_id": null, "topic_id": "sufi_universalism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ரூமியின் பாடல்கள் உலக அளவில் பல மொழிகளில் மொழிபெயர்க்கப்பட்டு இன்றும் கொண்டாடப்படுவதன் காரணம் என்ன?", "media_id": null}], "options": {"A": "அரசியல் கருத்துக்கள் நிரம்பியிருப்பதால்", "B": "போர் முறைகளை விவரிப்பதால்", "C": "கடினமான மொழியில் அமைந்திருப்பதால்", "D": "மதம், இனம், மொழி எல்லைகளைக் கடந்து மனித ஆன்மாவின் வலிகளையும் மானுட நேயத்தையும் உலகளாவிய நோக்கில் பாடியிருப்பதால்"}, "explanation": "ரூமியின் கவிதைகள் அனைத்து எல்லைகளையும் கடந்து மானுட ஆன்மாவின் விடுதலையையும் தூய அன்பையும் பாடுவதால் உலகெங்கும் போற்றப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Why does Rumi's poetry continue to captivate millions across global languages today?", "media_id": null}], "options": {"A": "It advocates partisan political ideologies", "B": "It details military conquests", "C": "It is written in obscure impenetrable jargon", "D": "It transcends dogma, race, and creed, addressing universal human angst and divine love"}, "explanation": "Rumi speaks directly to the universal human condition, soul liberation, and divine unconditional love."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"t