{"id": "12th_tamil_u3_q556", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_u3", "chapter_id": null, "topic_id": "error_detection_porul_clarity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பொருள் மயக்கத்தைத் தவிர்த்துச் சரியான வாக்கியத்தைத் தேர்க:", "media_id": null}], "options": {"A": "அவன் தந்தையின் வீட்டிற்குப் போனான் இல்லை", "B": "வீட்டிற்குப் போனான் தந்தை அவன்", "C": "போனான் அவன் தன் தந்தை வீட்டுக்கு", "D": "அவன் தன் தந்தையினது இல்லத்திற்குச் சென்றான்"}, "explanation": "‘தன்’ என்னும் தற்சுட்டுப் பெயரும் முறைப்படியான எழுவாய்-பயனிலை அமைப்பும் கொண்ட நான்காவது தொடரே பொருள் மயக்கமற்ற தெளிவான தொடராகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the grammatically articulate and unambiguous sentence:", "media_id": null}], "options": {"A": "Option A", "B": "Option B", "C": "Option C", "D": "Avan than thandhaiyinadhu illathirkuch chendraan."}, "explanation": "Option D resolves pronoun ambiguity through the reflexive pronoun 'than' in proper syntactic order."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 61, "chapter": null, "section": null, "reference"