{"id": "12th_tamil_u3_q451", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "kambaramayanam_u3", "chapter_id": null, "topic_id": "original_title_ramavataram", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கம்பர் தம் காப்பியத்திற்கு இட்ட மூலப் பெயர் யாது?", "media_id": null}], "options": {"A": "கம்பராமாயணம்", "B": "இராம சரிதம்", "C": "இராமாவதாரம்", "D": "இராகவ காவியம்"}, "explanation": "கம்பர் தாம் இயற்றிய நூலுக்கு ‘இராமாவதாரம்’ என்றே பெயரிட்டார்; பிற்காலத்தில் மக்கள் அதனை ‘கம்பராமாயணம்’ என வழங்கலாயினர்."}, "en": {"blocks": [{"type": "text", "content": "What was the original title bestowed upon his epic by Kambar himself?", "media_id": null}], "options": {"A": "Kambaramayanam", "B": "Rama Charitham", "C": "Ramavatharam", "D": "Raghava Kaviyam"}, "explanation": "Kambar originally named his epic masterwork 'Ramavatharam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 53, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 53", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper":