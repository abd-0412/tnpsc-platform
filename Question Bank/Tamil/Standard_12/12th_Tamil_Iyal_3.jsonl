{"id": "12th_tamil_u3_q528", "schema_version": "1.0", "kind": "statement", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "porul_mayakkam", "chapter_id": null, "topic_id": "porul_mayakkam_rules", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பொருள் மயக்கத்தைத் தவிர்க்கும் வழிகள் குறித்த கூற்றுகளை ஆராய்க:\nகூற்று 1: சொற்களைச் சேர்த்து எழுத வேண்டிய இடங்களில் சேர்த்தும், பிரித்து எழுத வேண்டிய இடங்களில் பிரித்தும் எழுத வேண்டும்.\nகூற்று 2: அடைமொழிகளையும் இடைச்சொற்களையும் உரிய சொல்லுக்கு முன்னால் சரியாக நிறுத்த வேண்டும்.", "media_id": null}], "options": {"A": "கூற்று 1 மட்டும் சரி", "B": "கூற்று 2 மட்டும் சரி", "C": "இரண்டு கூற்றுகளும் தவறு", "D": "இரண்டு கூற்றுகளும் சரி"}, "explanation": "சொற்களை உரிய இடத்தில் வைப்பதும், சரியான சேர்க்கை-பிரிப்பை மேற்கொள்வதும் பொருள் மயக்கத்தை முற்றிலுமாக அகற்றும். இரண்டு கூற்றுகளும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the rules for eliminating semantic ambiguity in Tamil composition:\nRule 1: Compound words where required, and space words where distinct autonomy is intended.\nRule 2: Position modifiers and particles directly adjacent to the words they qualify.", "media_id": null}], "options": {"A": "Rule 1 only is correct", "B": "Rule 2 only is correct", "C": "Both rules are incorrect", "D": "Both rules are correct"}, "explanation": "Both rules represent core guidelines for lucid, unambiguous Tamil syntax."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 61, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 61", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 3", "Grammar", "Clarity Rules"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u3_q529", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "porul_mayakkam", "chapter_id": null, "topic_id": "faulty_sentence_identification", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் வாக்கியங்களுள் பொருள் மயக்கமற்ற ‘தெளிவான’ வாக்கியத்தைத் தேர்க:", "media_id": null}], "options": {"A": "அரசர் புலவருக்குப் பொற்காசுகளை அன்போடு பரிசளித்தார்.", "B": "அரசர் புலவருக்கு அன்போடு பொற்காசுகளைப் பரிசளித்தார் இல்லை", "C": "புலவருக்கு அரசர் பொற்காசுகளை அன்போடு இல்லை", "D": "பொற்காசுகள் அரசர் புலவருக்குப் பரிசளித்தார்"}, "explanation": "எழுவாய் (அரசர்), செயப்படுபொருள் (பொற்காசுகளை), பயனிலை (பரிசளித்தார்) முறைப்படி அமைந்துள்ள முதல் வாக்கியமே பொருள் மயக்கமற்ற தெளிவான தொடராகும்."}, "en": {"blocks": [{"type": "text", "content": "Select the sentence completely free from semantic ambiguity and syntactic distortion:", "media_id": null}], "options": {"A": "Arasar pulavarukkup potkaasugalai anbodu parisalitthaar.", "B": "Option B", "C": "Option C", "D": "Option D"}, "explanation": "Option A presents seamless, logical subject-object-verb word order."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 60, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 60", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 3", "Grammar", "Flawless Sentence"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u3_q530", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "porul_mayakkam", "chapter_id": null, "topic_id": "adverb_placement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வேகமாக ஓடிய குதிரை விழுந்தது’ - இத்தொடரில் ‘வேகமாக’ என்னும் வினையடை எதனை விவரிக்கிறது?", "media_id": null}], "options": {"A": "விழுந்த வேகத்தை", "B": "குதிரை ஓடிய வேகத்தை", "C": "குதிரையின் நிறத்தை", "D": "நிலத்தின் தன்மையை"}, "explanation": "‘வேகமாக’ என்பது ‘ஓடிய’ என்னும் பெயரெச்சத்திற்கு அடைமொழியாக நின்று குதிரையின் ஓட்ட வேகத்தை விளக்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "In 'Vegamaaga odiya kudhirai vizhundhadhu', what does the adverbial modifier 'vegamaaga' qualify?", "media_id": null}], "options": {"A": "Speed of falling", "B": "Speed of running (Odiya)", "C": "Color of horse", "D": "Nature of ground"}, "explanation": "'Vegamaaga' directly modifies the participial running motion of the horse."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 60, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 60", "url": null, "source_notes": null}, "previous_y