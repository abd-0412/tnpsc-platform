{"id": "12th_tamil_u3_q453", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "kambaramayanam_u3", "chapter_id": null, "topic_id": "guhas_friendship_verse", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஆயிரம் இராமர் நின்கேழ் ஆவரோ தெரியின் அம்மா!’ என்று குகனின் வடிவழகையும் மாண்பையும் வியந்து பாராட்டியவர் யார்?", "media_id": null}], "options": {"A": "இலக்குவன் (இலக்குவனின் பார்வையிலும் வசிட்டனின் வாய்மொழியாகவும் கம்பர் அமைத்தது)", "B": "பரதன்", "C": "இராமன்", "D": "சத்துருக்கனன்"}, "explanation": "கங்கைக் கரையில் குகனின் தூய அன்பையும் வீரத்தையும் கண்ட பரதன், ‘ஆயிரம் இராமர் கூடினாலும் இக்குகைனுக்கு இணையாக மாட்டார்கள்’ என்று நெக்குருகிப் போற்றுகிறான்."}, "en": {"blocks": [{"type": "text", "content": "Who ecstatically proclaims of Guha: 'Even a thousand Ramas cannot match your peerless loyal grace'?", "media_id": null}], "options": {"A": "Bharata (marveling at Guha's pristine soul)", "B": "Lakshmana", "C": "Rama", "D": "Shatrughna"}, "explanation": "Bharata extols Guha declaring that a thousand Ramas cannot equate Guha's sublime devotion."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page":