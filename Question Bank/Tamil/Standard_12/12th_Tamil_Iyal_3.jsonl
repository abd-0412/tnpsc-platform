{"id": "12th_tamil_u3_q396", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thamizhar_kudumba_murai", "chapter_id": null, "topic_id": "kudi_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க காலத்தில் ‘குடும்பம்’ என்ற சொல்லுக்கு மாற்றாக குடும்ப அமைப்பைக் குறிக்கப் பயன்படுத்தப்பட்ட முதன்மைச் சொற்கள் எவை?", "media_id": null}], "options": {"A": "நாடு, நகரம்", "B": "சேரி, பாக்கம்", "C": "பட்டி, பாடி", "D": "குடி, இல், மனை"}, "explanation": "சங்க இலக்கியங்களில் குடும்ப அமைப்பைக் குறிக்க ‘குடி’, ‘இல்’, ‘மனை’ ஆகிய சொற்களே பெருமளவில் ஆளப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Which cardinal words were predominantly employed in Sangam literature to denote family and household?", "media_id": null}], "options": {"A": "Naadu, Nagaram", "B": "Cheri, Paakkam", "C": "Patti, Paadi", "D": "Kudi, Il, and Manai"}, "explanation": "Sangam literature referred to family units using 'Kudi', 'Il', and 'Manai'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 47, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 47", "url": null, "source_notes": null},