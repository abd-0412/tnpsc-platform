{"id": "12th_tamil_u3_q434", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "virundhinar_illam", "chapter_id": null, "topic_id": "sufi_whirling_dervishes", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ரூமியின் ஆன்மீகப் பாடல்களோடு தொடர்புடைய உலகப் புகழ்பெற்ற நடனம் எது?", "media_id": null}], "options": {"A": "பரதநாட்டியம்", "B": "சுழலும் துறவிகளின் ஆன்மீக நடனம் (Whirling Dervishes / மெவ்லவி சுஃபி நடனம்)", "C": "கதகளி", "D": "குச்சிப்புடி"}, "explanation": "ரூமியின் சீடர்களால் தோற்றுவிக்கப்பட்ட ‘சுழலும் துறவிகள்’ (Whirling Dervishes) நடனம் துருக்கியில் இன்றும் புகழ்பெற்றது."}, "en": {"blocks": [{"type": "text", "content": "Which internationally acclaimed mystical dance is intrinsically associated with Rumi's spiritual order?", "media_id": null}], "options": {"A": "Bharatanatyam", "B": "Whirling Dervishes (Mevlevi Sufi Sema dance)", "C": "Kathakali", "D": "Kuchipudi"}, "explanation": "The Mevlevi Order founded by Rumi's followers practices the iconic Whirling Dervishes spiritual meditation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference":