{"id": "12th_tamil_u3_q427", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "virundhinar_illam", "chapter_id": null, "topic_id": "how_to_treat_guests", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "துன்பமோ ஏமாற்றமோ உள்ளத்தில் நுழையும் போது மனிதன் எவ்வாறு எதிர்கொள்ள வேண்டும் என்று ரூமி வழிகாட்டுகிறார்?", "media_id": null}], "options": {"A": "கதவை அடைத்துத் துரத்த வேண்டும்", "B": "அழுது புலம்ப வேண்டும்", "C": "அனைவரையும் இன்முகத்தோடு வரவேற்று உபசரிக்க வேண்டும்; ஏனெனில் அவை ஒரு புதிய வெளிச்சத்திற்காக நம்மைத் தூய்மைப்படுத்த வந்திருக்கலாம்", "D": "தற்கொலை செய்து கொள்ள வேண்டும்"}, "explanation": "எந்த உணர்வு வந்தாலும் இன்முகத்தோடு ஏற்று உபசரிக்க வேண்டும்; அவை வீட்டைத் துடைத்துத் தூய்மை செய்து புதிய மகிழ்ச்சிக்கு வழிவகுக்கும்."}, "en": {"blocks": [{"type": "text", "content": "How does Rumi counsel humankind to receive unpleasant emotions like sorrow and despair?", "media_id": null}], "options": {"A": "Bar the doors and banish them violently", "B": "Weep uncontrollably in self-pity", "C": "Welcome and entertain them all hospitably, for they may be clearing your house for some new delight", "D": "Surrender to hopelessness"}, "explanation": "Welcome each visitor with gratitude, even a crowd of sorrows violently sweeping your house, as they prepare you for fresh delight."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multip