{"id": "12th_tamil_u3_q467", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "kambaramayanam_u3", "chapter_id": null, "topic_id": "guha_offerings_to_rama", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கங்கைக் கரையில் இராமனைச் சந்தித்த போது குகன் அன்போடு கொண்டு வந்து அளித்த பொருட்கள் எவை?", "media_id": null}], "options": {"A": "தங்கமும் வைரமும்", "B": "பட்டு ஆடைகள்", "C": "தேனும் மீனும் (அன்பின் அடையாளமாக எளிய காணிக்கை)", "D": "குதிரைகளும் தேர்களும்"}, "explanation": "குகன் இராமன் மீது கொண்ட அளவிலா அன்பினால் தான் சுவைத்த மீனும் தேனும் கொண்டு வந்து படைத்தான்; இராமனும் அதனை அமுதமாக ஏற்றான்."}, "en": {"blocks": [{"type": "text", "content": "What forest offerings did Guha lovingly present to Rama upon meeting him on the banks of the Ganges?", "media_id": null}], "options": {"A": "Gold and diamonds", "B": "Silken raiment", "C": "Honey and fresh fish (wild honey and river fish presented with pristine love)", "D": "Warhorses and chariots"}, "explanation": "Guha brought fresh fish and wild honey as rustic offerings of unadulterated love, which Rama accepted warmly."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition