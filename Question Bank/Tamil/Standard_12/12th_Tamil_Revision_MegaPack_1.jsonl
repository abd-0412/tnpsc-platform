{"id": "12th_tamil_mp1_q1697", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "bharathi_nellaiyappar_ideology", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஆண் பெண் சமம் என்று எண்ணும் மனிதனே மனிதன்’ - பாரதியாரின் இச்சிந்தனை எதனை வெளிப்படுத்துகிறது?", "media_id": null}], "options": {"A": "முற்போக்கான பெண்ணியச் சமத்துவச் சிந்தனை", "B": "பழமைவாதக் கட்டுப்பாடு", "C": "குடும்பத்தை நிராகரித்தல்", "D": "பொருளாதார வாதம்"}, "explanation": "பாரதியார் ஆண்களுக்கு இணையான சம உரிமையும் கல்வியும் பெண்களுக்கு வழங்கப்பட வேண்டும் என்பதைத் தீவிரமாக வலியுறுத்தினார்."}, "en": {"blocks": [{"type": "text", "content": "'Only he who regards man and woman as absolute equals is truly a human being' - What does this Bharathi maxim reflect?", "media_id": null}], "options": {"A": "Progressive feminist egalitarianism and gender justice", "B": "Orthodox patriarchal conservatism", "C": "Rejection of family life", "D": "Pure economic calculation"}, "explanation": "This aphorism encapsulates Bharathi's passionate advocacy for unconditional gender equality."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term":