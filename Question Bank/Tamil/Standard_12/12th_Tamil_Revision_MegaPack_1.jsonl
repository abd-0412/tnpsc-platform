{"id": "12th_tamil_mp1_q1625", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "u_ve_sa_ancient_schools", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பண்டைய காலத்துப் பள்ளிக்கூடங்கள்’ என்ற வரலாற்று உரைநடைப் பகுதியை எழுதிய தமிழ்த்தாத்தா யார்?", "media_id": null}], "options": {"A": "உ.வே. சாமிநாதையர்", "B": "மயிலை சீனி. வேங்கடசாமி", "C": "சி.வை. தாமோதரம்பிள்ளை", "D": "கா. நமச்சிவாய முதலியார்"}, "explanation": "பண்டைய தமிழ்நாட்டில் நிலவிய திண்ணைப் பள்ளிக்கூடங்கள் மற்றும் கல்வி முறைகளை ஆவணப்படுத்தி உ.வே.சா இக்கட்டுரையை எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "Who is the revered patriarch of Tamil scholarship ('Tamizhppaatta') who authored 'Pandaiya Kaalathup Pallikkoodangal'?", "media_id": null}], "options": {"A": "U.V. Swaminatha Iyer", "B": "Mayilai Seeni. Venkatasamy", "C": "C.W. Damodaram Pillai", "D": "K. Namachivaya Mudaliar"}, "explanation": "U.V. Swaminatha Iyer authored this definitive memoir documenting indigenous Thinnai schools."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 72, "chapter": null, "sec