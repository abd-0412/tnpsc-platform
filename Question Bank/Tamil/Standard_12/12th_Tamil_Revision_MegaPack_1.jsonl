{"id": "12th_tamil_mp1_q1695", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "purananooru_avvai_weapons_irony", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அவ்வே பகைவர்குத்தி கோடுசிதைந்து... கொல்லன் உலையிற் கிடப்பனவே’ - இதில் ‘கொல்லன் உலை’ எதனை உணர்த்துகிறது?", "media_id": null}], "options": {"A": "ஆயுதங்கள் துருப்பிடித்ததை", "B": "ஆயுதங்கள் விற்றுத் தீர்ந்ததை", "C": "அதியமானின் படைகள் தொடர் போர்களில் வென்று, மீண்டும் மீண்டும் கூர்மைப்படுத்தப் பட்டறைக்கு வந்து நிற்கும் போர்க்கள அனுபவத்தை", "D": "ஆயுதங்களை அழிக்க நினைப்பதை"}, "explanation": "அதியமானின் வேல்கள் போர்க்களத்தில் வீரத்தோடு மோதி முனை மழுங்கி, மீண்டும் கூர்தீட்டுவதற்காகக் கொல்லன் உலையில் கிடக்கின்றன என ஔவையார் புகழ்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "In Avvaiyar's verse, what does the blacksmith's forge (Kollan Ulai) repair of Adiyaman's weapons signify?", "media_id": null}], "options": {"A": "Weapons rusting from disuse", "B": "Weapons being sold out", "C": "Adiyaman's relentless battle experience, where blunt, scarred spears are continually reforged for victory", "D": "Attempt to scrap weapons"}, "explanation": "The blacksmith's forge signifies non-stop combat readiness, where chipped spears are continually honed."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 87, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 87", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 5", "Avvaiyar Metaphors"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp1_q1696", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "climate_change_tamilnadu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழகத்தில் புவி வெப்பமயமாதலால் கடலோர மாவட்டங்கள் எதிர்கொள்ளும் முதன்மையான அச்சுறுத்தல் எது?", "media_id": null}], "options": {"A": "பனிப்புயல் வீசுதல்", "B": "எரிமலை வெடிப்பு", "C": "நிலநடுக்கம்", "D": "கடல்மட்டம் உயர்தல், தீவிரப் புயல்கள் மற்றும் நிலத்தடி நீர் உவர்ப்பாதல்"}, "explanation": "கடல் மட்டம் உயர்வதால் கடலோர ஊர்கள் மூழ்குதல், தீவிரப் புயல்கள் மற்றும் குடிநீர் உப்பாக மாறுதல் ஆகியவை முக்கிய அச்சுறுத்தல்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "What primary environmental vulnerability do coastal districts of Tamil Nadu confront due to global climate change?", "media_id": null}], "options": {"A": "Sub-zero blizzard snowstorms", "B": "Active volcanic eruptions", "C": "Tectonic fault rifts", "D": "Sea level rise, severe cyclones, coastal erosion, and saltwater intrusion into freshwater aquifers"}, "explanation": "Sea level rise and violent cyclonic surges threaten coastal habitats and freshwater aquifers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educati