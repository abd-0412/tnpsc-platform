{"id": "12th_tamil_mp1_q1644", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "pedestrian_crossing_zebra", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாதசாரிகள் சாலையைக் கடப்பதற்காக வெள்ளைக் கோடுகளால் குறிக்கப்பட்ட பகுதிக்கு என்ன பெயர்?", "media_id": null}], "options": {"A": "சதுரக் கோடு", "B": "வட்டக் கோடு", "C": "நடைபாதை மட்டும்", "D": "வரிக்குதிரைக் கோடுகள் (Zebra Crossing)"}, "explanation": "பாதசாரிகள் பாதுகாப்பாகச் சாலையைக் கடக்க வெள்ளை மற்றும் கறுப்புக் கோடுகளால் அமைக்கப்பட்ட பகுதி 'வரிக்குதிரைக் கோடு' எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What is the pedestrian roadway crossing marked with alternating white and dark transverse stripes called?", "media_id": null}], "options": {"A": "Box crossing", "B": "Circular crossing", "C": "Pavement strip", "D": "Zebra Crossing (Varikkuthirai Kodu)"}, "explanation": "Zebra crossings designate designated safe zones for pedestrian road-crossing."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 91, "chapter": null, "section": null, "reference": "12th Tamil, Uni