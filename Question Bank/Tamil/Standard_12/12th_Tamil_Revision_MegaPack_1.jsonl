{"id": "12th_tamil_mp1_q1677", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "porul_mayakkam_verb_split", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அவன் கவிதை பாடினான்’ என்பதை ‘அவன் கவி தைபாடினான்’ எனப் பிரித்து எழுதினால் ஏற்படும் தவறான பொருள் யாது?", "media_id": null}], "options": {"A": "கவிதை என்பது 'தை' மாதத்தில் பாடிய குரங்கு (கவி) என்ற பொருள்பட்டுப் பெரும் நகைப்பை உண்டாக்கும்", "B": "அவன் பாடல் பாடவில்லை என்றாகும்", "C": "அவன் நடனம் ஆடினான் என்றாகும்", "D": "அவன் கவிதை எழுதினான் என்றாகும்"}, "explanation": "'கவிதை' என்பதைத் தவறாகப் பிரித்து 'தை' மாதத்தையும், 'கவி' (குரங்கு) என்பதையும் குறிக்குமாறு பிரிப்பது சொல் பிளப்பால் வரும் நகைப்புக்குரிய பொருள் மயக்கமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Erroneously splitting 'Avan kavithai paadinaan' into 'Avan kavi thaipaadinaan' distorts meaning into which absurd interpretation?", "media_id": null}], "options": {"A": "Distorts 'Kavithai' (Poem) into 'Kavi' (Monkey) singing in the month of 'Thai', causing ludicrous confusion", "B": "Signifies he never sang songs", "C": "Signifies he performed a classical dance", "D": "Signifies he inscribed poetry"}, "explanation": "Splitting 'Kavithai' turns it into 'A monkey sang in the month of Thai', illustrating absurd syntactic breakdown."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 67, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 67", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 4", "Syntactic Distortion"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp1_q1678", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "purananooru_athi_warrior", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அதியமான் போர்க்களத்தில் காட்டிய வீரத்தின் சிறப்பினை ஔவையார் எவ்வாறு பாராட்டுகிறார்?", "media_id": null}], "options": {"A": "அவன் அரண்மனையை விட்டு வெளிவர மாட்டான்", "B": "பகைவர்களின் யானைப் படைகளையும் பெரும்படைகளையும் தடுத்து நிறுத்தி, களத்தில் மார்பிலும் முகத்திலும் புண்பட்ட வீரத்தழும்புகளை உடையவன்", "C": "அவன் போரை வெறுப்பவன்", "D": "அவன் அண்டை நாட்டிடம் சரணடைந்தவன்"}, "explanation": "அதியமான் பகைவரின் கொடிய படைகளை நேருக்கு நேர் சந்தித்துப் புறமுதுகு காட்டாது நெஞ்சில் விழுப்புண் தாங்கிய தலைசிறந்த போர்வீரன் ஆவான்."}, "en": {"blocks": [{"type": "text", "content": "How does Avvaiyar extol the battlefield bravery of Adiyaman Neduman Anji in Purananuru?", "media_id": null}], "options": {"A": "He never steps outside palace walls", "B": "He confronts enemy tuskers face-to-face, bearing heroic scars on his chest without ever turning his back in retreat", "C": "He disdains all warfare", "D": "He surrendered to neighboring powers"}, "explanation": "She honors him as a fearless titan whose scars on chest and brow testify to confronting war tuskers head-on."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 86, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 86", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 4", "Adiyaman Valor"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp1_q1679", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "ancient_schools_curriculum_values", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பண்டைய காலத்துப் பள்ளிக்கூடங்கள்’ கட்டுரையில் உ.வே.சா குறிப்பிடும் குருகுலக் கல்வியின் உன்னதப் பண்பு யாது?", "media_id": null}], "options": {"A": "அதிகக் கட்டணம் வசூலிப்பது", "B": "பணக்காரர்களுக்கு மட்டுமே கல்வி தருவது", "C": "ஆசிரியருக்கும் மாணவருக்கும் இடையே அமைந்த தந்தை-மகன் போன்ற ஆத்மார்த்தமான அன்பும், நன்னடத்தையும் வாழ்வியல் ஒழுக்கமும் புகட்டுதல்", "D": "வெளிநாட்டு மொழிகளை மட்டுமே கற்பித்தல்"}, "explanation": "பண்டைய கல்வி முறையில் கட்டண வணிகமன்றி, ஆசிரியர் மாணவரைத் தன் சொந்தக் குழந்தையாக எண்ணி ஒழுக்கத்தையும் அறத்தையும் பயிற்றுவித்தார்."}, "en": {"blocks": [{"type": "text", "content": "What sublime moral virtue of indigenous Gurukula schooling does U.V. Swaminatha Iyer celebrate in his memoir?", "media_id": null}], "options": {"A": "Extorting exorbitant commercial tuition fees", "B": "Restricting literacy solely to affluent oligarchs", "C": "Deep paternal spiritual bond between preceptor and pupil, grounding students in moral integrity and civic rectitude", "D": "Teaching foreign tongues exclusively"}, "explanation": "The master-pupil relationship was rooted in selfless paternal devotion, shaping students into ethically grounded citizens."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 75, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 75", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 4", "Pedagogical Ethics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp1_q1680", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "mock4_grand_synthesis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருப்புதல் மாதிரித் தேர்வு 4 (இயல்கள் 3 & 4) உணர்த்தும் முழுமையான உட்கருத்து யாது?", "media_id": null}], "options": {"A": "பொருளீட்டுதலே தலையாய குறிக்கோள்", "B": "சமூகப் பிளவுகளை நியாயப்படுத்துதல்", "C": "மொழியைப் புறக்கணிப்பது", "D": "வள்ளுவர் காட்டிய சினமின்மையும் நல்வாழ்வும், கம்பரின் சமத்துவம், உ.வே.சாவின் தமிழ்ப் பாதுகாப்பு, சுரதாவின் கவிதை நெறி மற்றும் அன்றாட வாழ்வின் விழிப்புணர்வும் பாதுகாப்பும்"}, "explanation": "மாதிரித் தேர்வு 4 அறநெறி, கல்வி மரபு, இலக்கிய நயம், வரலாற்று ஆவணம் மற்றும் பொது ஒழுக்கத்தை ஒருங்கே இணைத்து முழுமையான ஆளுமையை உருவாக்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "What holistic civilizational synthesis is articulated in Synoptic Revision Mock Test 4?", "media_id": null}], "options": {"A": "Accumulating capital is life's sole ambition", "B": "Justifying social fractures", "C": "Discarding native vernaculars", "D": "Thiruvalluvar's mastery over anger and righteous living, Kambar's cosmic brotherhood, U.Ve.Sa's archival rescue, Suradha's poetic discipline, and vigilant civic safety"}, "explanation": "Mock 4 integrates ethics, classical pedagogy, literary metrics, archival heritage, and civic road discipline into a unified whole."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 95, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 95", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 4", "Grand Synthesis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
