{"id": "12th_tamil_mp1_q1626", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "suradha_idhil_vetri_pera", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘இதில் வெற்றி பெற’ என்னும் மரபுக் கவிதையைப் பாடிய உவமைக் கவிஞர் யார்?", "media_id": null}], "options": {"A": "பாரதிதாசன்", "B": "சுரதா (இராசகோபாலன்)", "C": "வாணிதாசன்", "D": "கண்ணதாசன்"}, "explanation": "உவமைக் கவிஞர் சுரதா 'இதில் வெற்றி பெற' என்ற கவிதையில் கவிதை இயற்றுவதற்கான அழகியல் மற்றும் உழைப்பின் மேன்மையை விளக்கியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who is the celebrated 'Uvamai Kavignar' who composed the traditional metered verse 'Idhil Vetri Pera'?", "media_id": null}], "options": {"A": "Bharathidasan", "B": "Suradha (Rajagopalan)", "C": "Vanidasan", "D": "Kannadasan"}, "explanation": "Uvamai Kavignar Suradha composed 'Idhil Vetri Pera' instructing on poetic creativity and discipline."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 78, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 78", "url": null, "source_notes"