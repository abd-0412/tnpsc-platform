{"id": "12th_tamil_mp1_q1654", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "thirukkural_ilvaazhkkai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அன்பும் அறனும் உடைத்தாயின் இல்வாழ்க்கை பண்பும் பயனும் அது’ - இக்குறளில் பயின்றுவந்துள்ள அணி எது?", "media_id": null}], "options": {"A": "வேற்றுமையணி", "B": "நிரல்நிறை அணி (அன்பு - பண்பு, அறன் - பயன் என முறைபட நிறுத்தியமை)", "C": "தற்குறிப்பேற்ற அணி", "D": "வஞ்சப்புகழ்ச்சி அணி"}, "explanation": "அன்பும் அறமும் ஆகிய சொற்களை முன்நிறுத்தி, அவற்றிற்குரிய விளைவுகளாகப் பண்பையும் பயனையும் நேரே நிரல்படுத்தியதால் இது நிரல்நிறை அணி ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which figure of speech (Ani) is employed in Kural: 'Anbum aranum udaithaayin ilvaazhkkai panbum payanum adhu'?", "media_id": null}], "options": {"A": "Vetrumai Ani", "B": "Niral Nirai Ani (Symmetrical Parallelism of words and their corresponding attributes)", "C": "Tharkurippetra Ani", "D": "Vanchappugazhchi Ani"}, "explanation": "Because Love and Virtue are placed in symmetrical sequence with their respective results Culture and Fruit, it is Niral Nirai Ani."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and