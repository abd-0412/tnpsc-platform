{"id": "12th_tamil_mp1_q1648", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "helmets_seatbelts_law", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இருசக்கர மற்றும் நான்கு சக்கர வாகன ஓட்டிகள் கட்டாயம் அணிய வேண்டிய உயிர் காக்கும் கவசங்கள் எவை?", "media_id": null}], "options": {"A": "கடிகாரம் மற்றும் கண்ணாடி", "B": "கைக்கவச்சம் மட்டும்", "C": "விலை உயர்ந்த ஆடைகள்", "D": "தலைக்கவசம் (Helmet) மற்றும் இருக்கைப் பட்டை (Seat belt)"}, "explanation": "இருசக்கர வாகன ஓட்டிகளுக்குத் தலைக்கவசமும் (Helmet), மகிழுந்து ஓட்டுநர்களுக்கு இருக்கைப் பட்டையும் (Seat belt) சட்டப்படி கட்டாயமான உயிர்காக்கும் சாதனங்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "What mandatory safety gear must two-wheeler riders and four-wheeler drivers wear to prevent fatal injuries?", "media_id": null}], "options": {"A": "Wristwatches and sunglasses", "B": "Gloves only", "C": "Designer outfits", "D": "Crash Helmets and Seat Belts"}, "explanation": "Helmets and seatbelts are legally mandated safety restraints protecting motorists from trauma."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year