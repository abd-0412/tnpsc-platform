{"id": "12th_tamil_mp1_q1701", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "thirukkural_sinam_metaphor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சினமென்னும் சேர்ந்தாரைக் கொல்லி இனமென்னும் ஏமப் புணையைச் சுடும்’ - இக்குறளில் பயின்றுவந்துள்ள அணி எது?", "media_id": null}], "options": {"A": "ஏகதேச உருவக அணி", "B": "முழு உருவக அணி", "C": "வேற்றுமையணி", "D": "உவமையணி"}, "explanation": "சினத்தைச் சேர்ந்தாரைக் கொல்லும் நெருப்பாகவும், சுற்றத்தை ஏமப்புணையாகவும் உருவகித்துவிட்டு, பிறவற்றை உருவகிக்காமல் விட்டதால் இது ஏகதேச உருவக அணி ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which rhetorical figure of speech (Ani) is deployed in the Kural: 'Sinamennum serndhaaraik kolli inamennum emap punaiyais sudum'?", "media_id": null}], "options": {"A": "Ekadhesa Uruwaga Ani (Partial / Asymmetrical Metaphor)", "B": "Complete Metaphor (Muzhu Uruwagam)", "C": "Vetrumai Ani", "D": "Uvamai Ani"}, "explanation": "Because anger is allegorized as fire and kinship as a lifeboat without allegorizing the sea, it is Ekadhesa Uruwaga Ani."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term"