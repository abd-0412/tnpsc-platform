{"id": "12th_tamil_mp1_q1573", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "nedunalvaadai_nakkeerar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வையகம் பனிப்ப வலனேர்பு வளைஇப் பொய்யா வானம் புதுப்பெயல் பொழிந்தென’ - நெடுநல்வாடையின் இவ்வடிகளில் விவரிக்கப்படும் பருவம் எது?", "media_id": null}], "options": {"A": "கூதிர்ப் பருவம் (ஐப்பசி, கார்த்திகை மாதங்களின் குளிர்காலம்)", "B": "இளவேனில் பருவம்", "C": "முதுவேனில் பருவம்", "D": "கார்ப் பருவம்"}, "explanation": "நக்கீரர் நெடுநல்வாடையில் கூதிர்ப் பருவத்தின் வாடைக்காற்று வீசும் கடும் குளிர் காலத்தைப் பின்னணியாக அமைத்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which seasonal transition is described in the opening lines of Nakkeerar's Nedunalvaadai: 'Vaiyagam panippa valanerpu valaii...'?", "media_id": null}], "options": {"A": "Koodhir season (Chilly dewy late-autumn / winter season during Aippasi and Karthigai)", "B": "Early Spring (Ilavenil)", "C": "Late Summer (Mudhuvenil)", "D": "Monsoon rainy season (Kaar)"}, "explanation": "It portrays Koodhir Kaalam (chilly dewy winter season) with howling northerly winds."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 32, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 32", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 1", "Nedunalvaadai"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp1_q1574", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "muthal_kal_uthamacholan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘முதல் கல்’ சிறுகதையில் ஊர்மக்கள் அனைவரையும் ஒன்றிணைத்து வெள்ளத்திலிருந்து பயிர்களைக் காப்பாற்றத் தனி மனிதனாக முதன்முதலில் களமிறங்கியவர் யார்?", "media_id": null}], "options": {"A": "கிராமத் தலைவர்", "B": "மருதன் (மற்றும் அவனது மனைவி அல்லி)", "C": "காளியப்பன்", "D": "முத்து"}, "explanation": "உத்தமசோழன் எழுதிய 'முதல் கல்' கதையில் மருதன் என்னும் இளைஞனே தயங்கி நின்ற ஊராரை வழிநடத்தி முதற்கல்லாக நின்று மதகின் அடைப்பை நீக்கினான்."}, "en": {"blocks": [{"type": "text", "content": "In the short story 'Mudhal Kal' by Uthamacholan, who took the heroic individual initiative to clear the flooded canal breach?", "media_id": null}], "options": {"A": "Village headman", "B": "Maruthan (and his wife Alli)", "C": "Kaaliyappan", "D": "Muthu"}, "explanation": "Maruthan acted as the metaphorical 'first stone' inspiring the entire village to unite and clear the clogged sluice."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "editio