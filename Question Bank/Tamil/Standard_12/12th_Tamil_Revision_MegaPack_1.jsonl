{"id": "12th_tamil_mp1_q1673", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "avvaiyar_moral_courage", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஔவையாரின் தூது உரையில் வெளிப்படும் தலையாய பண்பு எது?", "media_id": null}], "options": {"A": "அஞ்சாமை, வாய்மை, நடுவுநிலைமை மற்றும் மாசற்ற புலமைத் துணிவு", "B": "அரசனைப் போற்றிப் புகழ்ந்து பிழைப்பது", "C": "பகை மன்னனை ஏமாற்றுதல்", "D": "தற்பெருமை பேசுதல்"}, "explanation": "ஔவையார் எத்தகைய கொடிய மன்னனின் முன்பும் அஞ்சாமல் உண்மையை எடுத்துரைக்கும் பெரும் புலமைத் துணிவும் அறநெறியும் கொண்டவர்."}, "en": {"blocks": [{"type": "text", "content": "What paramount moral trait distinguishes Avvaiyar's fearless diplomatic discourse before King Thondaiman?", "media_id": null}], "options": {"A": "Fearless moral fortitude, unflinching truth, upright impartiality, and uncompromising poetic integrity", "B": "Obsequious sycophancy to flatter sovereigns for survival", "C": "Treacherous deception of enemy rulers", "D": "Vainglorious boastfulness"}, "explanation": "Avvaiyar epitomized fearless moral integrity and diplomatic candor before absolute power."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educ