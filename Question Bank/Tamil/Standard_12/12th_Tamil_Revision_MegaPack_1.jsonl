{"id": "12th_tamil_mp1_q1659", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "porul_mayakkam_identification", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்கண்டவற்றுள் பொருள் மயக்கமின்றித் தெளிவாக அமைந்துள்ள வாக்கியம் எது?", "media_id": null}], "options": {"A": "அவன் பாடம் படித்தான் அல்லன்", "B": "களிறு தன் கன்றை அழைத்துக் கொண்டு போன து", "C": "மருத்துவர் நோயாளியைப் பரிசோதித்து உரிய மருந்து கொடுத்தார்", "D": "தமிழ்நாட்டின் தலைநகர் சென்னை யாகும்"}, "explanation": "வாக்கியத்தில் சொற்கள் சரியான இடைவெளியோடும் திணை பால் எண் இடப் பொருத்தத்தோடும் பிழையின்றி அமைந்துள்ள தொடர் 'மருத்துவர் நோயாளியைப் பரிசோதித்து உரிய மருந்து கொடுத்தார்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following sentences is structured clearly without semantic ambiguity or syntax flaws (Porul Mayakkam)?", "media_id": null}], "options": {"A": "Avan paadam padiththaan allan", "B": "Kaliru than kantrai azhaiththuk kondu pona thu", "C": "The physician examined the patient and prescribed appropriate medication (Flawless syntax)", "D": "Thamizhnaattin thalainagar chennai yaagum"}, "explanation": "Sentence C features flawless spacing, correct grammatical concord, and unambiguous semantics."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 67, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 67", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 4", "Syntax Scrutiny"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp1_q1660", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "kambar_avatar_purpose", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கம்பராமாயணத்தில் இராமாவதாரத்தின் முதன்மை நோக்கமாகக் கம்பர் காட்டுவது எதனை?", "media_id": null}], "options": {"A": "அரண்மனை வாழ்வை அனுபவிப்பது", "B": "காட்டில் வேட்டையாடுவது", "C": "சுயநல ஆசை", "D": "அறத்தை நிலைநாட்டி, அசுரர்களை அழித்து, அனைத்து உயிர்களுக்கும் அருள்பாலித்து மானுட தர்மத்தை நிலைநாட்டுதல்"}, "explanation": "இராமாவதாரம் என்பது அதர்மத்தை வீழ்த்தி, அறத்தையும் மானுடப் பண்புகளையும் உலகில் நிலைநிறுத்தவே நிகழ்ந்தது என்பதை கம்பர் காப்பியம் முழுதும் நிறுவுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What does Kambar define as the supreme divine purpose of the Rama avatar in Kamba Ramayanam?", "media_id": null}], "options": {"A": "Enjoying royal luxuries", "B": "Wild game hunting in forests", "C": "Selfish territorial conquest", "D": "Upholding cosmic righteousness (Dharma), destroying demonic tyranny, and exemplifying universal virtue and empathy"}, "explanation": "The Rama avatar incarnated to vanquish demonic oppression and enshrine universal compassion and righteousness."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 52", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 4", "Kamba Ramayanam"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp1_q1661", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "purananooru_95_thinai_thurai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஔவையார் அதியமானின் ஆயுதங்களைப் புகழ்ந்து பாடிய புறநானூற்றுப் பாடலின் (பாடல் 95) திணை மற்றும் துறை எவை?", "media_id": null}], "options": {"A": "பாடாண்திணை - வாண்மங்கலம்", "B": "வெட்சித்திணை - கரந்தை", "C": "வஞ்சித்திணை - பேராண்வஞ்சி", "D": "உழிஞைத்திணை - நொச்சி"}, "explanation": "மன்னனின் வாளையும் வேற்படைகளையும் வாழ்த்திப் பாடுவதால் இப்பாடல் பாடாண்திணையில் 'வாண்மங்கலம்' என்னும் துறையில் அடங்கும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the classical Thinai and Thurai of Avvaiyar's Purananuru verse 95 eulogizing Adiyaman's weapons.", "media_id": null}], "options": {"A": "Paadaan Thinai - Vaanmangalam (Blessing of the royal sword/arms)", "B": "Vetchi - Karanthai", "C": "Vanji - Peraanvanji", "D": "Uzhinjai - Nochi"}, "explanation": "It belongs to Paadaan Thinai and Vaanmangalam thurai, celebrating the scarred combat weapons of the king."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edit