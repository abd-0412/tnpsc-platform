{"id": "12th_tamil_mp1_q1702", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "suradha_original_metaphor_poetry", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுரதாவின் கவிதைகளில் புதுமை மிளிர்வதற்குக் காரணமாக அமைவது எது?", "media_id": null}], "options": {"A": "பழைய உவமைகளை அப்படியே திருப்பிச் சொல்வது", "B": "முன்பு யாரும் கையாளாத புதுமையான ஒப்பீடுகளையும், இயற்கைப் படிமங்களையும் தமக்கே உரிய முறையில் படைப்பது", "C": "எதுகைகளை மட்டும் அடுக்குவது", "D": "ஆங்கிலக் கலப்பு"}, "explanation": "சுரதா மரபு யாப்பில் நின்றவாறே, முற்றிலும் புதிய உவமைகளையும் உருவகங்களையும் படைத்து புதுக்கவிஞர்களுக்கும் முன்னோடியாகத் திகழ்ந்தார்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the hallmark originality animating Suradha's poetic craft?", "media_id": null}], "options": {"A": "Recycling clichéd medieval metaphors", "B": "Inventing unprecedented fresh similes and sparkling natural imagery while adhering to metered classical prosody", "C": "Mechanically stacking rhyming syllables", "D": "Mixing English loanwords"}, "explanation": "He preserved pure classical meters while inventing dazzlingly fresh, unprecedented visual metaphors."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 78, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 78", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 5", "Suradha Craft"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp1_q1703", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "poomani_childhood_innocence", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பூமணியின் கதைகளில் மனித உறவுகளை நிலைநிறுத்தும் உன்னத விசையாகச் செயல்படுவது எது?", "media_id": null}], "options": {"A": "வங்கிப் பணம்", "B": "அரசியல் அதிகாரம்", "C": "மண் சார்ந்த அன்பும், இரத்தப் பாசமும், பகிர்தல் மனப்பான்மையும்", "D": "நீதிமன்ற வழக்குகள்"}, "explanation": "பூமணியின் கதைகளில் மனிதர்களின் வறுமைக்கு நடுவிலும் மண்பாசமும் குடும்ப உறவுகளின் நேசமும் கெடாமல் துளிர்த்து நிற்கின்றன."}, "en": {"blocks": [{"type": "text", "content": "What vitalizing force safeguards and restores human relations in Poomani's fiction?", "media_id": null}], "options": {"A": "Bank capital", "B": "Political authority", "C": "Deep connection to the soil, fraternal blood affection, and uncalculated sharing", "D": "Litigation in judicial courts"}, "explanation": "In Poomani's fictional universe, primal connection to the earth and blood kinship transcend destitution."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 61, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 61", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 5", "Poomani Philosophy"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp1_q1704", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "nedunalvaadai_structure_balance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நெடுநல்வாடையில் அரண்மனை அந்தப்புரத்தின் நள்ளிரவு அமைதியை நக்கீரர் எதனோடு ஒப்பிடுகிறார்?", "media_id": null}], "options": {"A": "போர்க்கள முழக்கம்", "B": "சந்தைப் பேரிரைச்சல்", "C": "கடல் கொந்தளிப்பு", "D": "தூங்கும் பெண்களின் ஆழ்ந்த அமைதியும், சுவர்களில் தீட்டிய சித்திரங்களும், வாடைக் குளிரில் உறைந்த நிசப்தமும்"}, "explanation": "அந்தப்புரத்தின் நிசப்தத்தை, குளிர் நடுங்கும் பெண்களின் அசைவின்மையோடும் உறங்கும் சேடிப் பெண்களின் அமைதியோடும் கவிஞர் நேர்த்தியாகப் பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "How does Nakkeerar balance the chilling midnight silence of the royal palace apartments in Nedunalvaadai?", "media_id": null}], "options": {"A": "With clamorous battle drums", "B": "With market bazaar commotion", "C": "With stormy ocean swells", "D": "With the hushed stillness of sleeping attendants, vibrant frescoed wall murals, and profound freezing silence"}, "explanation": "Nakkeerar vividly depicts the freezing nocturnal stillness of the palace apartments adorned with paintings."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_na