{"id": "12th_tamil_mp1_q1686", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "suradha_kavithai_books", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுரதா இயற்றிய புகழ்பெற்ற கவிதை நூல்களுள் தமிழக அரசின் பரிசு பெற்ற நூல் எது?", "media_id": null}], "options": {"A": "துறைமுகம்", "B": "தேன்மழை", "C": "சுவரும் சுண்ணாம்பும்", "D": "மங்கையர்க்கரசி"}, "explanation": "சுரதாவின் 'தேன்மழை' கவிதைத் தொகுதி 1969-ஆம் ஆண்டு தமிழ்நாடு அரசின் சிறந்த நூலுக்கான பரிசைப் பெற்றது."}, "en": {"blocks": [{"type": "text", "content": "Which poetry collection authored by Suradha was awarded the Tamil Nadu State Government Best Book Prize in 1969?", "media_id": null}], "options": {"A": "Thuraimugam", "B": "Thenmazhai", "C": "Suvarum Sunnaambum", "D": "Mangaiyarkkarasi"}, "explanation": "His lyrical anthology 'Thenmazhai' was awarded the prestigious Tamil Nadu State Government Award in 1969."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 79, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 79", "url": null, "source_notes":