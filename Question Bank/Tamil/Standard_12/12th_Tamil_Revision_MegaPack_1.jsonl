{"id": "12th_tamil_mp1_q1606", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "urimaithaagam_characters", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உரிமைத்தாகம்’ சிறுகதையில் வரும் பாத்திரங்கள் எவை?", "media_id": null}], "options": {"A": "மருதன், அல்லி", "B": "முத்தையன், வெள்ளைச்சாமி (அண்ணன் - தம்பி)", "C": "கந்தசாமி, செல்லம்மாள்", "D": "சவரி, குகன்"}, "explanation": "பூமணியின் 'உரிமைத்தாகம்' கதையில் முத்தையன், வெள்ளைச்சாமி ஆகிய இரு அண்ணன் தம்பிகளுக்கு இடையே உள்ள நில உரிமைப் போராட்டமும் பாசமும் பேசப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Who are the primary fraternal protagonists in Poomani's story 'Urimai Thaagam'?", "media_id": null}], "options": {"A": "Maruthan and Alli", "B": "Mutthaiyan and Vellaichami (Brothers)", "C": "Kandhasami and Chellammal", "D": "Shabari and Guha"}, "explanation": "The story pivots around the estranged brothers Mutthaiyan and Vellaichami reunited by their bond to ancestral land."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 61, "chapter": null, "section": null, "referenc