{"id": "12th_tamil_mp1_q1691", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "purananooru_athi_weapons_quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கடாஅக் களிற்றின் மேல் கட்கொண்டு எறிந்த நறும்புண்’ - இத்தொடர் அதியமானின் எத்தகைய போர்க்கள வீரத்தை உணர்த்துகிறது?", "media_id": null}], "options": {"A": "அவன் மது அருந்தியதை", "B": "அவன் காட்டில் வேட்டையாடியதை", "C": "மதம்பிடித்த யானையின் மீது வாளை வீசிப் போரிட்டபோது அவனது மார்பில் ஏற்பட்ட வீரத்தின் நறுமணப் புண்களை", "D": "அவன் தோற்று ஓடியதை"}, "explanation": "பகைவரின் மதயானையின் மேல் பாய்ந்து வீழ்த்தியபோது அதியமானின் உடம்பில் ஏற்பட்ட தழும்புகளை ஔவையார் வீரத்தின் அடையாளமாகப் புகழ்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "What battlefield valor of Adiyaman is depicted in the line describing fragrant wounds sustained while attacking charging war elephants?", "media_id": null}], "options": {"A": "His imbibing of intoxicating wine", "B": "His hunting deer in thickets", "C": "Heroic battle scars sustained on his chest while bringing down furious rutting war elephants", "D": "His retreat in defeat"}, "explanation": "The verse celebrates Adiyaman's chest scars earned while bringing down charging armored war tuskers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 86, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 86", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 5", "Avvaiyar Imagery"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp1_q1692", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "u_ve_sa_library_chennai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உ.வே. சாமிநாதையர் தேடித் தொகுத்த பல்லாயிரக்கணக்கான ஓலைச்சுவடிகளும் அரிய நூல்களும் தற்போது சென்னையில் எங்குப் பாதுகாக்கப்பட்டு வருகின்றன?", "media_id": null}], "options": {"A": "அண்ணா நூற்றாண்டு நூலகம்", "B": "கன்னிமாரா நூலகம்", "C": "சென்னைப் பல்கலைக்கழகம்", "D": "டாக்டர் உ.வே.சா. நூல்நிலையம் (பெசன்ட் நகர், சென்னை)"}, "explanation": "சென்னைப் பெசன்ட் நகரில் உள்ள 'டாக்டர் உ.வே.சா. நூல்நிலையம்' அவரது சுவடிக் கருவூலங்களை இன்றளவும் பாதுகாத்து வருகிறது."}, "en": {"blocks": [{"type": "text", "content": "Where are the priceless palm-leaf manuscripts and rare books collated by U.V. Swaminatha Iyer preserved today in Chennai?", "media_id": null}], "options": {"A": "Anna Centenary Library", "B": "Connemara Public Library", "C": "Madras University Archives", "D": "Dr. U.V. Swaminatha Iyer Memorial Library (Besant Nagar, Chennai)"}, "explanation": "They are preserved at the Dr. U.Ve.Sa. Library in Besant Nagar, Chennai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Cor