{"id": "12th_tamil_mp1_q1596", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "mock1_synthesis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல்கள் 1 & 2 ஒருங்கிணைப்பில் வெளிப்படும் தமிழரின் முதன்மையான பண்பாட்டு அடையாளம் யாது?", "media_id": null}], "options": {"A": "போர்க் குணமும் ஆதிக்கமும்", "B": "இயற்கையை அழித்துப் பெருநகரங்களை உருவாக்குதல்", "C": "அன்னிய மொழிகளை மட்டுமே போற்றுதல்", "D": "மொழியின் அழகியலையும் தூய்மையையும் காத்தல், இயற்கையோடு இயைந்து வாழும் சூழலியல் அறம் மற்றும் பெண் விடுதலைச் சிந்தனை"}, "explanation": "இயல்கள் 1 & 2 மொழி நடை அழகியல், மரபுப் பெருமை, பாரதியின் சமத்துவப் பார்வை, சூழலியல் பாதுகாப்பு மற்றும் எளிய மக்களின் கூட்டுழைப்பை இணைக்கின்றன."}, "en": {"blocks": [{"type": "text", "content": "What primary civilizational core emerges from the synthesis of Units 1 and 2 in Class 12 General Tamil?", "media_id": null}], "options": {"A": "Militaristic conquest and dominance", "B": "Razing ecosystems to construct concrete metropolises", "C": "Exclusively glorifying non-native tongues", "D": "Preserving linguistic aesthetics and heritage, ecological harmony with nature, female emancipation, and grassroots collective solidarity"}, "explanation": "Units 1 & 2 synthesize poetic aesthetics, environmental guardianship, gender justice, and grassroots community solidarity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negat