{"id": "12th_tamil_mp1_q1605", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "masnavi_jalaluddin_rumi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரசீகக் கவிஞர் ஜலாலுத்தீன் ரூமியின் 25,600 பாடல்களைக் கொண்ட உலகப்புகழ்பெற்ற தத்துவக் காவியம் எது?", "media_id": null}], "options": {"A": "மஸ்னவி (Masnavi)", "B": "ருபாயியாத்", "C": "ஷா நாமா", "D": "குலிஸ்தான்"}, "explanation": "ரூமியின் 'மஸ்னவி' என்னும் ஆன்மீகக் கவிதைத் தொகுப்பு சூஃபி தத்துவத்தின் பைபிள் என்று போற்றப்படும் உலகப் புகழ்பெற்ற நூலாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which monumental Persian philosophical poetic masterpiece comprising 25,600 verses was composed by Jalaluddin Rumi?", "media_id": null}], "options": {"A": "The Masnavi (Mathnawi)", "B": "Rubaiyat", "C": "Shahnameh", "D": "Gulistan"}, "explanation": "Rumi's 'Masnavi' is revered globally as one of the greatest mystical spiritual poems ever penned."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 48, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 48", "url"