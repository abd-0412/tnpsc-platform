{"id": "12th_tamil_mp1_q1687", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "poomani_other_works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பூமணி எழுதிய சிறுகதைத் தொகுப்புகளுள் பொருந்தாதது எது?", "media_id": null}], "options": {"A": "வயிறுகள்", "B": "ரீதி", "C": "ஒரு கிராமத்து நதி", "D": "நொறுங்கல்கள்"}, "explanation": "‘வயிறுகள்’, ‘ரீதி’, ‘நொறுங்கல்கள்’ ஆகியவை பூமணியின் சிறுகதைத் தொகுப்புகள்; ‘ஒரு கிராமத்து நதி’ சிற்பி பாலசுப்பிரமணியத்தின் கவிதை நூல்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following books is NOT a short story collection authored by Poomani?", "media_id": null}], "options": {"A": "Vayirugal", "B": "Reethi", "C": "Oru Gramathu Nadhi (Poetry by Sirpi Balasubramaniam)", "D": "Norungalgal"}, "explanation": "'Oru Gramathu Nadhi' is a Sahitya Akademi award-winning poetry volume by Sirpi Balasubramaniam, not Poomani."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 61, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 61", "url": null, "source_notes": null