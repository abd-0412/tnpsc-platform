{"id": "12th_tamil_mp1_q1609", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "rumi_translator_tamil", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜலாலுத்தீன் ரூமியின் கவிதைகளைத் தமிழில் ‘தாகங்கொண்ட மீன் ஒன்று’ என்ற தலைப்பில் மொழிபெயர்த்தவர் யார்?", "media_id": null}], "options": {"A": "என். சத்யமூர்த்தி", "B": "புவியரசு", "C": "சிற்பி", "D": "வைரமுத்து"}, "explanation": "ரூமியின் ஆங்கிலக் கவிதைகளைத் தமிழில் நேர்த்தியாக என். சத்யமூர்த்தி மொழிபெயர்த்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who translated Jalaluddin Rumi's mystical poetry into Tamil under the title 'Dhaagang Konda Meen Ondru'?", "media_id": null}], "options": {"A": "N. Sathyamurthy", "B": "Puviarasu", "C": "Sirpi", "D": "Vairamuthu"}, "explanation": "N. Sathyamurthy translated Rumi's poems into Tamil under the title 'Dhaagang Konda Meen Ondru'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 48, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 48", "url": null, "source_notes": null}, "previous_year": {"is_pre