{"id": "12th_tamil_mp1_q1642", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "u_ve_sa_curriculum", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திண்ணைப் பள்ளிக்கூடங்களில் கணிதக் கணக்குகளை மனப்பாடமாகச் செய்யப் பயிற்றுவிக்கப்பட்ட வாய்ப்பாடுகளுக்கு என்ன பெயர்?", "media_id": null}], "options": {"A": "ஆல்ஜீப்ரா", "B": "எண் சுவடி (நெல் இலக்கம், குழி மாற்று வாய்ப்பாடு போன்றவை)", "C": "வடிவியல்", "D": "புள்ளிவிவரம்"}, "explanation": "திண்ணைப் பள்ளிகளில் பெருக்கல், கூட்டல், நில அளவை ஆகியவற்றை மனக்கணக்காகப் போட 'எண் சுவடி', 'குழி மாற்று' வாய்ப்பாடுகள் கற்பிக்கப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "What were the traditional mnemonic mental arithmetic tables taught in Thinnai schools for calculating grain tallies and land acreage called?", "media_id": null}], "options": {"A": "Algebra", "B": "Enn Suvadi (Nellilakkam, Kuzhi Maatru multiplication manuals)", "C": "Geometry", "D": "Statistics"}, "explanation": "'Enn Suvadi' and 'Kuzhi Maatru' were traditional mnemonic rhyming tables used to calculate fractions and acreage rapidly."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12"