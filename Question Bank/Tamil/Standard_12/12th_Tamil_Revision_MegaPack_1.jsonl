{"id": "12th_tamil_mp1_q1627", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "ci_mani_idaiyeedu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சொல்ல நினைத்ததெல்லாம் சொல்லிவிட முடிவதில்லை... இடையில் விழுந்து குறுக்கிடும் தடைகள்’ - ‘இடையீடு’ கவிதையின் ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "ந. பிச்சமூர்த்தி", "B": "பிரமிள்", "C": "சி. மணி (பழனிச்சாமி)", "D": "ஞானக்கூத்தன்"}, "explanation": "எழுத்து இதழில் புதுக்கவிதைகள் எழுதிய முன்னோடிக் கவிஞர் சி. மணி படைப்பாக்கத்தின் போது ஏற்படும் மனத் தடைகளை 'இடையீடு' கவிதையில் விளக்கியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the modernist metacritical poem 'Idaiyeedu' exploring psychological blocks in poetic expression?", "media_id": null}], "options": {"A": "Na. Pichamoorthy", "B": "Pramil", "C": "C. Mani (Palanichamy)", "D": "Gnanakoothan"}, "explanation": "Pioneering Ezhuthu-era modernist poet C. Mani authored 'Idaiyeedu'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 82, "chapter": null, "section": null, "reference": "12th Tamil, Unit me