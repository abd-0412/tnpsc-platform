{"id": "12th_tamil_mp1_q1611", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "kambar_veedanan_adaikkalam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஆழியான் அவனை நோக்கி... என்னுடைத் தம்பி நீ’ என்று இராமன் வீடணனை எந்தப் படலத்தில் அடைக்கலமாக ஏற்றுக்கொண்டான்?", "media_id": null}], "options": {"A": "குகப் படலம்", "B": "சடாயு காண் படலம்", "C": "வீடணன் அடைக்கலப் படலம்", "D": "நாகபாசப் படலம்"}, "explanation": "வீடணன் அடைக்கலப் படலத்தில், பகைவனான இராவணனின் தம்பியாயினும் அடைக்கலம் என்று வந்தவனைத் தன் தம்பியாக இராமன் ஏற்றுக் கொண்டான்."}, "en": {"blocks": [{"type": "text", "content": "In which Canto of Kamba Ramayanam does Rama accept Vibhishana with unconditional asylum declaring 'Thou art my brother'?", "media_id": null}], "options": {"A": "Guha Padalam", "B": "Jatayu Kaan Padalam", "C": "Veedanan Adaikkalap Padalam", "D": "Nagapaasa Padalam"}, "explanation": "Rama grants absolute refuge (Abhaya) to Ravana's brother Vibhishana in Veedanan Adaikkalap Padalam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "se