{"id": "12th_tamil_mp1_q1579", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "climate_change_conference", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புவி வெப்பமயமாதலைக் கட்டுப்படுத்த 2015-ஆம் ஆண்டு உலக நாடுகள் ஒன்றுகூடி வரலாற்றுச் சிறப்புமிக்க ஒப்பந்தம் மேற்கொண்ட இடம் எது?", "media_id": null}], "options": {"A": "கியோட்டோ", "B": "கோபன்ஹேகன்", "C": "பாரிஸ் (Paris Climate Accord)", "D": "ரியோ டி ஜெனிரோ"}, "explanation": "2015-இல் பிரான்ஸ் தலைநகர் பாரிசில் நடைபெற்ற ஐக்கிய நாடுகள் காலநிலை மாநாட்டில் 195 நாடுகள் பாரிஸ் ஒப்பந்தத்தை ஏற்றுக்கொண்டன."}, "en": {"blocks": [{"type": "text", "content": "Where did 195 nations convene in 2015 to adopt the landmark global climate agreement mitigating global warming?", "media_id": null}], "options": {"A": "Kyoto", "B": "Copenhagen", "C": "Paris (Paris Climate Accord)", "D": "Rio de Janeiro"}, "explanation": "The landmark 2015 UN Climate Change Conference produced the historic Paris Accord."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": "12t