{"id": "12th_tamil_mp1_q1630", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "u_ve_sa_thinnai_school", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைய காலத்துத் திண்ணைப் பள்ளிக்கூடங்களில் மணலில் விரலால் எழுதிப் பழகிய பழக்கத்திற்கு என்ன பெயர்?", "media_id": null}], "options": {"A": "கணினிப் பயிற்சி", "B": "மணல் கல்வி / எழுத்து வரிவடிவப் பயிற்சி", "C": "சுவடிப் படிப்பு", "D": "மனனப் பயிற்சி"}, "explanation": "தொடக்கத்தில் தரையில் மணலைப் பரப்பி விரல்களால் எழுத்துகளை எழுதிப் பழகினர்; இதனால் விரல்கள் வளைந்து அழகிய கையெழுத்து அமைந்தது."}, "en": {"blocks": [{"type": "text", "content": "What was the traditional pedagogical practice of tracing Tamil letters with fingers upon sand in indigenous Thinnai schools called?", "media_id": null}], "options": {"A": "Computer practice", "B": "Manal Kalvi (Tracing letterforms upon fine riverbed sand)", "C": "Palm leaf scribing", "D": "Rote chanting"}, "explanation": "Children traced primary scripts onto spread sand to master curvilinear Tamil letterforms before writing on palm leaves."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "fu