{"id": "12th_tamil_mp1_q1613", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "poomani_cinema_vekkai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பூமணியின் ‘வெக்கை’ என்ற நாவலைத் தழுவி வெற்றிமாறன் இயக்கிய புகழ்பெற்ற தமிழ்த் திரைப்படம் எது?", "media_id": null}], "options": {"A": "அசுரன்", "B": "ஆடுகளம்", "C": "வடசென்னை", "D": "விசாரணை"}, "explanation": "பூமணியின் 'வெக்கை' நாவலை அடிப்படையாகக் கொண்டு தனுஷ் நடித்து வெற்றிமாறன் இயக்கிய 'அசுரன்' திரைப்படம் தேசிய விருது பெற்றது."}, "en": {"blocks": [{"type": "text", "content": "Which National Award-winning Tamil feature film directed by Vetrimaaran was adapted from Poomani's novel 'Vekkai'?", "media_id": null}], "options": {"A": "Asuran", "B": "Aadukalam", "C": "Vada Chennai", "D": "Visaranai"}, "explanation": "Vetrimaaran's acclaimed film 'Asuran' was adapted from Poomani's novel 'Vekkai'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 61, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 61", "url": null, "source_notes": null}, "previous_year": {"is_p