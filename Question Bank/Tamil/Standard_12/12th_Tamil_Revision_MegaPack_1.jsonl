{"id": "12th_tamil_mp1_q1581", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "nedunalvaadai_prosody_poet", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பத்துப்பாட்டு நூல்களுள் 188 அடிகளைக் கொண்ட ஆசிரியப்பாவால் அமைந்த 'நெடுநல்வாடை' நூலை இயற்றிய சங்கப் புலவர் யார்?", "media_id": null}], "options": {"A": "மதுரைக் கணக்காயனார் மகனார் நக்கீரர்", "B": "கபிலர்", "C": "மாங்குடி மருதனார்", "D": "உருத்திரங்கண்ணனார்"}, "explanation": "நெடுநல்வாடை 188 அடிகளைக் கொண்ட ஆசிரியப்பாவால் அமைந்த பத்துப்பாட்டு நூலாகும்; இதனை இயற்றியவர் மதுரைக் கணக்காயனார் மகனார் நக்கீரர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Which Sangam poet composed 'Nedunalvaadai', a 188-line Pathuppaattu work in Asiriyappa meter?", "media_id": null}], "options": {"A": "Madurai Kanakkayanar Maganar Nakkeerar", "B": "Kabilar", "C": "Mangudi Marudhanar", "D": "Urutthirangannanar"}, "explanation": "Nakkeerar composed Nedunalvaadai consisting of 188 lines in Asiriyappa meter."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 32, "chapter": null, "section": null, "