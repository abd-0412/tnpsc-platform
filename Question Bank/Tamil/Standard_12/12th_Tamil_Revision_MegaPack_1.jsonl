{"id": "12th_tamil_mp1_q1583", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "ti_su_na_kavithai_mozhi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி.சு. நடராசன் அவர்களின் கூற்றுப்படி, இலக்கியத்தின் முதன்மையான ஊடகம் எது?", "media_id": null}], "options": {"A": "காகிதம் மற்றும் மை", "B": "அச்சு இயந்திரம்", "C": "மொழி (Language)", "D": "கணினித் திரை"}, "explanation": "ஓவியத்திற்கு வண்ணமும், சிற்பத்திற்கு கல்லும் ஊடகமாவது போல, இலக்கியப் படைப்பிற்கு மொழியே முதன்மையான கலை ஊடகமாகும்."}, "en": {"blocks": [{"type": "text", "content": "According to Prof. T.S. Natarajan's poetics, what constitutes the fundamental medium of literary art?", "media_id": null}], "options": {"A": "Paper and ink", "B": "Printing press", "C": "Language (Mozhi)", "D": "Computer screen"}, "explanation": "Just as stone is the medium for sculpture and color for painting, language itself is the primary medium of literature."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 5", "ur