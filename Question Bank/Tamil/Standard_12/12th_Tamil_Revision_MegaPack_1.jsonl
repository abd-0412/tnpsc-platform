{"id": "12th_tamil_mp1_q1746", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_7", "chapter_id": null, "topic_id": "tnpsc_pyq_avvai_athiyan_friendship", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC Group 4 2014] அதியமான் நெடுமான் அஞ்சியின் உற்ற தோழியாகவும் அரசியல் ஆலோசகராகவும் விளங்கிய சங்கப் புலவர் யார்?", "media_id": null}], "options": {"A": "\"வெள்ளிவீதியார்", "B": "\"ஔவையார்", "C": "\"காக்கைப் பாடினியார்", "D": "\"நச்செள்ளையார்"}, "explanation": "அதியமான் மீது அளப்பரிய நட்பு பூண்டு, அவனது அரசவையில் அமைச்சராகவும் தூதுவராகவும் செயல்பட்டவர் ஔவையார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Group 4 2014] Which Sangam poetess served as the intimate confidante and diplomatic advisor to chieftain Adiyaman?", "media_id": null}], "options": {"A": "\"Velliveethiyar", "B": "\"Avvaiyar", "C": "\"Kakkaip Paadiniyar", "D": "\"Nachellaiyar"}, "explanation": "Avvaiyar shared legendary friendship with Adiyaman, serving as his envoy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 86, "chapter": null, "section": null, "reference": "12th Tamil, Uni