{"id": "12th_tamil_mp1_q1586", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "antho_kavidhai_movement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நெடுநல்வாடையில் வேப்பம்பூ மாலையைச் சூடியவனாக நக்கீரரால் மறைமுகமாகச் சுட்டப்படும் மன்னன் யார்?", "media_id": null}], "options": {"A": "சேரன்", "B": "பாண்டியன் (வேப்பம்பூ மாலைக்குரியவன்)", "C": "சோழன்", "D": "பல்லவன்"}, "explanation": "பாண்டியரின் அடையாள மலர் வேப்பம்பூ ஆகும். 'வேப்பந்தாரோன்' எனக் குறிப்பாகச் சுட்டப்படுவதால் இது பாண்டிய மன்னனையே குறிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "Which monarch is indirectly identified in Nedunalvaadai by his signature neem flower garland (Veppampoo)?", "media_id": null}], "options": {"A": "Chera king", "B": "Pandya king (adorned with the neem blossom garland)", "C": "Chola king", "D": "Pallava king"}, "explanation": "The neem blossom garland is the hereditary floral insignia of the Pandya dynasty."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 33, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack