{"id": "12th_tamil_mp1_q1763", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_7", "chapter_id": null, "topic_id": "tnpsc_pyq_nedunalvaadai_season_koodhir", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC Group 2 2016] நெடுநல்வாடையில் வர்ணிக்கப்படும் கூதிர்காலம் தமிழ் மாதங்களில் எவற்றைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "\"சித்திரை, வைகாசி", "B": "\"ஆனி, ஆடி", "C": "\"ஐப்பசி, கார்த்திகை", "D": "\"மார்கழி, தை"}, "explanation": "கூதிர்ப்பருவம் என்பது தமிழ் மாதங்களில் ஐப்பசி மற்றும் கார்த்திகை மாதங்களைக் குறிக்கும் வாடைக் குளிர்காலமாகும்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Group 2 2016] Which Tamil calendar months correspond to the chilly Koodhir season portrayed in Nedunalvaadai?", "media_id": null}], "options": {"A": "\"Chithirai and Vaikasi", "B": "\"Aani and Aadi", "C": "\"Aippasi and Karthigai", "D": "\"Margazhi and Thai"}, "explanation": "Koodhir corresponds to the late autumn cold months of Aippasi and Karthigai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 32, "chapter": null, "section": null, "reference": "12