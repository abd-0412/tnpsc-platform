{"id": "12th_tamil_mp1_q1656", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "pagupatham_arasu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘செய்தான்’ - பகுபத உறுப்பிலக்கணப் பிரிப்பில் சரியான முறை எது?", "media_id": null}], "options": {"A": "செய் + தான்", "B": "செய் + த் + ஆன் (செய் - பகுதி, த் - இறந்தகால இடைநிலை, ஆன் - படர்க்கை ஆண்பால் வினைமுற்று விகுதி)", "C": "செய்து + ஆன்", "D": "செய் + த் + ஆன்"}, "explanation": "செய் - பகுதி; த் - இறந்தகால இடைநிலை; ஆன் - படர்க்கை ஆண்பால் வினைமுற்று விகுதி."}, "en": {"blocks": [{"type": "text", "content": "What is the accurate morphological parsing of the finite verb 'Seithaan'?", "media_id": null}], "options": {"A": "Sei + thaan", "B": "Seithu + aan", "C": "Sei + t + thaan", "D": "Sei (root) + t (past tense) + aan (third person masculine singular suffix)"}, "explanation": "Sei (verbal root) + 't' (past tense marker) + 'aan' (third person masculine singular marker)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 88, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapac