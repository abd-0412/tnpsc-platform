{"id": "12th_tamil_mp1_q1629", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "suradha_pen_name", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுரதா என்ற புனைப்பெயரின் விரிவாக்கம் யாது?", "media_id": null}], "options": {"A": "சுப்புரத்தினதாசன் (பாரதிதாசனின் இயற்பெயரான சுப்புரத்தினத்தின் தாசன்)", "B": "சுந்தர ராமன் தாசன்", "C": "சுப்பையா ரத்தினம் தாசன்", "D": "சுரேஷ் தாசன்"}, "explanation": "பாரதிதாசன் மீது கொண்ட அளப்பரிய பற்றினால் தம் இயற்பெயரான இராசகோபாலன் என்பதை மாற்றிச் 'சுப்புரத்தினதாசன்' (சுரதா) என்று வைத்துக்கொண்டார்."}, "en": {"blocks": [{"type": "text", "content": "What is the full expansion and origin of the acclaimed pen-name 'Suradha'?", "media_id": null}], "options": {"A": "Subburathina-dasan (Devotee of Subburathinam / Bharathidasan)", "B": "Sundara Raman Dasan", "C": "Subbaiah Rathinam Dasan", "D": "Suresh Dasan"}, "explanation": "Out of deep reverence for mentor Bharathidasan (Subburathinam), he styled himself 'Subburathinadasan' (Suradha)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 79, "chapter": null, "s