{"id": "12th_tamil_mp1_q1587", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "parali_nellaiyappar_journals", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பரலி சு. நெல்லையப்பர் நடத்திய இதழ்கள் எவை?", "media_id": null}], "options": {"A": "சுதேசமித்திரன், இந்தியா", "B": "ஆனந்த விகடன், கல்கி", "C": "சூரியோதயம், லோகோபகாரி", "D": "குயில், முல்லை"}, "explanation": "விடுதலைப் போராட்ட வீரரான பரலி சு. நெல்லையப்பர் 'சூரியோதயம்', 'லோகோபகாரி' முதலான இதழ்களுக்கு ஆசிரியராக இருந்து தேசப்பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Which nationalist journals were edited and published by Parali Su. Nellaiyappar?", "media_id": null}], "options": {"A": "Swadesamitran and India", "B": "Ananda Vikatan and Kalki", "C": "Sooriyodhayam and Lokobagaari", "D": "Kuyil and Mullai"}, "explanation": "Nellaiyappar edited the nationalist periodicals 'Sooriyodhayam' and 'Lokobagaari'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 13, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 13", "url": null, "source_