{"id": "12th_tamil_mp1_q1744", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_7", "chapter_id": null, "topic_id": "tnpsc_pyq_kambar_ramayanam_canto_count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC Group 2 2015] கம்பராமாயணத்தில் உள்ள மொத்தக் காண்டங்களின் எண்ணிக்கை எத்தனை?", "media_id": null}], "options": {"A": "\"நான்கு", "B": "\"ஐந்து", "C": "\"ஏழு", "D": "\"ஆறு காண்டங்கள் (பால, அயோத்திய, ஆரணிய, கிட்கிந்தை, சுந்தர, யுத்த காண்டங்கள்)"}, "explanation": "கம்பராமாயணம் பாலகாண்டம் முதல் யுத்தகாண்டம் வரை 6 காண்டங்களைக் கொண்டது (ஏழாவது உத்தர காண்டத்தை ஒட்டக்கூத்தர் இயற்றினார்)."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Group 2 2015] How many major books/cantos (Kaandangal) comprise Kambar's epic Kamba Ramayanam?", "media_id": null}], "options": {"A": "\"Four", "B": "\"Five", "C": "\"Seven", "D": "\"Six Cantos (Bala, Ayodhya, Aranya, Kishkindha, Sundara, and Yuddha)"}, "explanation": "Kambar composed 6 Cantos (the 7th Uttara Kanda was penned separately by Ottakkoothar)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "secti