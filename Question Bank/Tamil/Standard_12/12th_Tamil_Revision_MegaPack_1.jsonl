{"id": "12th_tamil_mp1_q1694", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "kambar_birthplace", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிச்சக்கரவர்த்தி கம்பர் பிறந்த ஊர் மற்றும் நூற்றாண்டு எது?", "media_id": null}], "options": {"A": "மதுரை, கி.பி. 8-ஆம் நூற்றாண்டு", "B": "தேரழுந்தூர் (மயிலாடுதுறை அருகே), கி.பி. 12-ஆம் நூற்றாண்டு", "C": "தஞ்சாவூர், கி.பி. 10-ஆம் நூற்றாண்டு", "D": "எட்டயபுரம், கி.பி. 15-ஆம் நூற்றாண்டு"}, "explanation": "கம்பர் சோழ நாட்டில் மயிலாடுதுறைக்கு அருகிலுள்ள தேரழுந்தூரில் 12-ஆம் நூற்றாண்டில் வாழ்ந்த பெருங்கவிஞர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "What is the historical birthplace and era of Kavichakravarti Kambar?", "media_id": null}], "options": {"A": "Madurai, 8th Century CE", "B": "Therazhundur (near Mayiladuthurai), 12th Century CE", "C": "Thanjavur, 10th Century CE", "D": "Ettayapuram, 15th Century CE"}, "explanation": "Kambar was born in Therazhundur in the Cauvery delta during the 12th century CE."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null,