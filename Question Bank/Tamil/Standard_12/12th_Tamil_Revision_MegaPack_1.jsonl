{"id": "12th_tamil_mp1_q1698", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "rumi_life_dates", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மௌலானா ஜலாலுத்தீன் ரூமி வாழ்ந்த காலக்கட்டம் எது?", "media_id": null}], "options": {"A": "கி.பி. 10-ஆம் நூற்றாண்டு", "B": "கி.பி. 13-ஆம் நூற்றாண்டு (1207 - 1273)", "C": "கி.பி. 16-ஆம் நூற்றாண்டு", "D": "கி.பி. 18-ஆம் நூற்றாண்டு"}, "explanation": "ரூமி 1207 முதல் 1273 வரை 13-ஆம் நூற்றாண்டில் வாழ்ந்த பாரசீக ஞானியாவார். இவரது சமாதி துருக்கியில் கோன்யாவில் உள்ளது."}, "en": {"blocks": [{"type": "text", "content": "During which historical period did Sufi master Mawlana Jalaluddin Rumi live?", "media_id": null}], "options": {"A": "10th Century CE", "B": "13th Century CE (1207 - 1273)", "C": "16th Century CE", "D": "18th Century CE"}, "explanation": "Jalaluddin Rumi lived in the 13th century (1207-1273 CE), centered in Konya (modern Turkey)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 48, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 48", "url": null, "sou