{"id": "12th_tamil_mp1_q1706", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "traffic_helmet_safety_statistic", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியாவில் சாலை விபத்துகளில் உயிரிழப்போரில் பெரும்பாலானோர் தலைக்கவசம் அணியாததால் ஏற்படும் காயம் எது?", "media_id": null}], "options": {"A": "கை எலும்பு முறிவு", "B": "தலையில் ஏற்படும் தீவிர உள் இரத்தக்கசிவு மற்றும் மூளைக் காயம் (Traumatic Brain Injury)", "C": "கால் எலும்பு முறிவு", "D": "கண் பார்வை இழப்பு"}, "explanation": "இருசக்கர விபத்துகளில் தலைக்கவசம் அணியாததால் தலையிலும் மூளையிலும் ஏற்படும் கொடிய காயங்களே 80%-க்கும் அதிகமான உயிரிழப்புகளுக்குக் காரணமாகின்றன."}, "en": {"blocks": [{"type": "text", "content": "In motor vehicular collisions, what primary trauma causes the majority of two-wheeler fatalities when helmets are not worn?", "media_id": null}], "options": {"A": "Arm fracture", "B": "Traumatic Brain Injury and severe intracranial hemorrhage", "C": "Leg bone fracture", "D": "Loss of eyesight"}, "explanation": "Traumatic brain injuries and intracranial hemorrhage account for the overwhelming majority of two-wheeler deaths."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 93, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 93", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 5", "Road Safety Trauma"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp1_q1707", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "kambar_brothers_equality", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘குகனொடும் ஐவரானோம்... எம்பின் ஏழிருவர் ஆனோம்’ - இப்பாடல் கம்பரின் எந்த முற்போக்குச் சிந்தனையை வெளிப்படுத்துகிறது?", "media_id": null}], "options": {"A": "சமூகத்தில் வர்ணாசிரமத்தை நிலைநிறுத்துதல்", "B": "அரசியல் கூட்டு அமைத்தல்", "C": "இனம், பிறப்பு, வர்க்கம் கடந்த உலகளாவிய மானுட சகோதரத்துவமும் சமத்துவமும்", "D": "நாடுகளை இணைத்தல்"}, "explanation": "வேடன், வானரன், அரக்கன் என்ற எவ்வித வேற்றுமையும் பாராமல் அனைவரையும் உடன் பிறந்த சகோதரர்களாக ஏற்கும் கம்பரின் மானுட ஒருமைப்பாடே இதன் உட்கருத்து."}, "en": {"blocks": [{"type": "text", "content": "What radical progressive egalitarian vision of Kambar is crystallized in the verse 'With Guha we became five... with Vibhishana seven'?", "media_id": null}], "options": {"A": "Preserving feudal social stratification", "B": "Forming tactical geopolitical pacts", "C": "Universal human equality and cosmic fraternity transcending clan, species, and caste barriers", "D": "Territorial annexation"}, "explanation": "Kambar propounds a revolutionary fraternity embracing forest hunter, monkey, and demon prince as equal brothers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 56", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 5", "Kambar Humanism"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp1_q1708", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "mock5_grand_synthesis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருப்புதல் மாதிரித் தேர்வு 5-இன் ஒட்டுமொத்த ஒருங்கிணைப்பு உணர்த்தும் முழுமையான உட்கருத்து யாது?", "media_id": null}], "options": {"A": "பழைய முறைகளை மாற்றாமல் இருப்பது", "B": "போர்களில் வெற்றி பெறுவது", "C": "சுயநல வாழ்க்கை", "D": "மொழியின் அழகியல், சூழலியல் விழிப்புணர்வு, குடும்ப உறவுகளின் மேன்மை, கல்வி மரபு, இலக்கிய நயம் மற்றும் மானுட சமத்துவம் ஆகியவற்றை உள்ளடக்கிய முழுமையான தமிழ்ப் பண்பாட்டு விழிப்புணர்வு"}, "explanation": "இயல்கள் 1 முதல் 4 வரையிலான மாதிரித் தேர்வுகள் மொழியியல், சூழலியல், குடும்பம், கல்வி மற்றும் அறநெறியை முழுமையாகத் தொகுத்து மாணவருக்குத் தருகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What comprehensive civilizational understanding does the synoptic integration of Units 1 to 4 in Mock Test 5 impart?", "media_id": null}], "options": {"A": "Clinging uncritically to obsolete customs", "B": "Triumph in martial warfare", "C": "Individualistic self-absorption", "D": "A holistic mastery of Tamil cultural consciousness encompassing linguistic poetics, ecological stewardship, familial sanctities, traditional pedagogy, and egalitarian humanism"}, "explanation": "It imparts a comprehensive civilizational mastery across language poetics, ecological care, family ethics, indigenous education, and human equality."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 95, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 95", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 5", "Grand Synthesis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
