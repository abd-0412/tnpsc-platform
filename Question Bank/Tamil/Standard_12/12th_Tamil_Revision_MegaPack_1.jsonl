{"id": "12th_tamil_mp1_q1655", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "ilakkana_kurippu_arundhiral", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அருந்திறல்’ - இலக்கணக் குறிப்புத் தருக.", "media_id": null}], "options": {"A": "வினையெச்சம்", "B": "உம்மைத்தொகை", "C": "பண்புத்தொகை (அருமை + திறல்)", "D": "பெயரெச்சம்"}, "explanation": "'அருமை + திறல் = அருந்திறல்'. 'மை' விகுதி பெற்றுப் பண்பை உணர்த்தி நிற்பதால் இது பண்புத்தொகை ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Provide the grammatical classification for the compound 'Arunthiral'.", "media_id": null}], "options": {"A": "Vinaiyechcham", "B": "Ummaiththogai", "C": "Panbuththogai (Compound of quality: Arumai + Thiral)", "D": "Peyarechcham"}, "explanation": "'Arunthiral' is a quality compound (Panbuththogai) formed from 'Arumai' and 'Thiral'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 35", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false