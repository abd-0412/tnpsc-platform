{"id": "12th_tamil_mp1_q1638", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "educational_monasteries_tamil", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைய தமிழ்நாட்டில் திண்ணைப் பள்ளிகளுக்கு அடுத்தபடியாக உயர்கல்வியை வழங்கிய சமய அமைப்புகள் எவை?", "media_id": null}], "options": {"A": "வணிக வளாகங்கள்", "B": "சமணப் பள்ளிகளும், பௌத்தப் பள்ளிகளும், சைவ-வைணவ மடங்களும்", "C": "அரண்மனைப் படைகள்", "D": "நீதிமன்றங்கள்"}, "explanation": "சமணப் பள்ளிகள், பௌத்த விகாரங்கள் மற்றும் சைவ-வைணவக் குருமடங்களே பண்டைத் தமிழகத்தில் சமயக் கல்விக்கும் இலக்கண, இலக்கியக் கல்விக்கும் களமாக அமைந்தன."}, "en": {"blocks": [{"type": "text", "content": "Which monastic institutions served as the premier hubs of higher learning in ancient Tamil Nadu following elementary Thinnai schooling?", "media_id": null}], "options": {"A": "Mercantile bazaars", "B": "Jain Pallis, Buddhist Viharas, and Saiva-Vaishnava Mutts", "C": "Palace garrisons", "D": "Judicial courts"}, "explanation": "Jain, Buddhist, and Hindu monasteries functioned as collegiate residential academies of classical learning."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corp