{"id": "12th_tamil_mp1_q1675", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "speed_limits_traffic", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பள்ளி மற்றும் மருத்துவமனை வளாகங்களின் அருகே வாகனங்கள் செல்ல அனுமதிக்கப்பட்டுள்ள உச்ச வேகம் என்ன?", "media_id": null}], "options": {"A": "மணிக்கு 60 கி.மீ", "B": "மணிக்கு 45 கி.மீ", "C": "மணிக்கு 25 முதல் 30 கி.மீ வரை", "D": "மணிக்கு 80 கி.மீ"}, "explanation": "பள்ளிகள், மருத்துவமனைகள் அமைந்துள்ள பகுதிகளில் மாணவர்கள் மற்றும் நோயாளிகளின் பாதுகாப்பிற்காக 25-30 கி.மீ மட்டுமே வேகம் அனுமதிக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the permissible statutory speed limit for motor vehicles adjacent to school zones and hospital premises?", "media_id": null}], "options": {"A": "60 km/h", "B": "45 km/h", "C": "25 to 30 km/h (Slow speed zone)", "D": "80 km/h"}, "explanation": "School and hospital safety buffer zones mandate restricted speeds of 25 to 30 km/h."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 92, "chapter": null, "section": null, "reference": "12th Ta