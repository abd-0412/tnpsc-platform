{"id": "12th_tamil_mp1_q1645", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "ci_mani_kavithai_ezhuthu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சி. மணி எந்த இதழின் வாயிலாகத் தமிழ்ப் புதுக்கவிதை உலகில் பெரும் தாக்கத்தை ஏற்படுத்தினார்?", "media_id": null}], "options": {"A": "எழுத்து (சி.சு. செல்லப்பாவின் இதழ்)", "B": "மணிக்கொடி", "C": "சரஸ்வதி", "D": "தீபம்"}, "explanation": "சி.சு. செல்லப்பாவால் தொடங்கப்பட்ட 'எழுத்து' இதழில் சி. மணியின் புகழ்பெற்ற புதுக்கவிதைகள் வெளிவந்து புதிய திருப்பத்தை உண்டாக்கின."}, "en": {"blocks": [{"type": "text", "content": "Through which seminal literary periodical did C. Mani make his transformative impact on modernist Tamil free verse?", "media_id": null}], "options": {"A": "Ezhuthu (edited by C.S. Chellappa)", "B": "Manikkodi", "C": "Saraswathi", "D": "Deepam"}, "explanation": "C. Mani was one of the central pillars of C.S. Chellappa's trailblazing magazine 'Ezhuthu'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 83, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapac