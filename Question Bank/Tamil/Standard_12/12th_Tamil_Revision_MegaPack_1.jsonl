{"id": "12th_tamil_mp1_q1617", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "kambar_punitha_son", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சடாயுவின் உடலுக்குத் தன் கைகளாலேயே ஈமக்கடன்களைச் செய்து மகனாக நின்று மோட்சம் அளித்தவர் யார்?", "media_id": null}], "options": {"A": "இராமன்", "B": "இலக்குவன்", "C": "பரதன்", "D": "வீடணன்"}, "explanation": "தந்தை தயரதனைப் போலவே சடாயுவை மதித்த இராமன், அவனுக்குரிய இறுதிக் கடன்களைத் தன் கைகளாலேயே செய்து மகனின் கடமையை ஆற்றினான்."}, "en": {"blocks": [{"type": "text", "content": "In Kamba Ramayanam, who performed the last funerary rites for vulture king Jatayu as his own devoted son?", "media_id": null}], "options": {"A": "Rama", "B": "Lakshmana", "C": "Bharata", "D": "Vibhishana"}, "explanation": "Rama performed the filial obsequies for Jatayu with his own hands, treating him with the same reverence as his father Dasharatha."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 53, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 53", "url": null, "source_notes":