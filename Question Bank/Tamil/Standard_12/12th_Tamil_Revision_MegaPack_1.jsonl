{"id": "12th_tamil_mp1_q1591", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "greenhouse_gases_mix", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புவி வெப்பமயமாதலை உருவாக்கும் பசுமைக்குடில் வாயுக்களுள் (Greenhouse Gases) மிக முதன்மையானது எது?", "media_id": null}], "options": {"A": "ஆக்சிஜன்", "B": "நைட்ரஜன்", "C": "கார்பன் டை ஆக்சைடு (கரிம அமிலம்)", "D": "ஹீலியம்"}, "explanation": "தொழிற்சாலைகள், வாகனங்கள் மற்றும் காடழிப்பால் வளிமண்டலத்தில் சேரும் கார்பன் டை ஆக்சைடே புவி வெப்பமயமாதலுக்கு முக்கியக் காரணமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which gas constitutes the predominant driver among anthropogenic greenhouse gases causing global warming?", "media_id": null}], "options": {"A": "Oxygen", "B": "Nitrogen", "C": "Carbon Dioxide (CO2)", "D": "Helium"}, "explanation": "Carbon dioxide generated from fossil fuels is the primary greenhouse gas driving global climate change."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 27",