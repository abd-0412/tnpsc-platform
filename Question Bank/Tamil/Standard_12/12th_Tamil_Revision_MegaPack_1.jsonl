{"id": "12th_tamil_mp1_q1667", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "kambar_brotherhood_sugriva", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கம்பராமாயணத்தில் கிட்கிந்தைக் காண்டத்தில் இராமன் சுக்ரீவனிடம் நட்புக் கொண்டபோது எதனை அவனுக்கு உறுதியளித்தான்?", "media_id": null}], "options": {"A": "பொன் பொருளைத் தருவதாக", "B": "அயோத்திக்கு அழைத்துச் செல்வதாக", "C": "‘உன் துன்பம் என் துன்பம், உன் பகைவன் என் பகைவன்’ என்று கூறி அடைக்கலம் தந்து நட்புக் காப்பதாக", "D": "வானரப் படைகளைத் தனக்குத் தருமாறு"}, "explanation": "இராமன் சுக்ரீவனிடம் 'உன் இன்னல் என் இன்னல்' எனத் தன் தோழனாக ஏற்று அவனது துன்பத்தைப் போக்க உறுதிபூண்டான்."}, "en": {"blocks": [{"type": "text", "content": "In the Kishkindha Canto of Kamba Ramayanam, what solemn oath does Rama forge with Sugriva?", "media_id": null}], "options": {"A": "Bestowing treasures of gold", "B": "Escorting him to Ayodhya", "C": "Pledging 'Thy sorrow is my sorrow, thy foe my foe', offering absolute sanctuary and unwavering fraternity", "D": "Demanding Vanara legions"}, "explanation": "Rama seals sacred friendship pledging that Sugriva's tribulations and adversaries are his own."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "