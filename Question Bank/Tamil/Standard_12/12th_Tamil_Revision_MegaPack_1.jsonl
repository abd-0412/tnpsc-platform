{"id": "12th_tamil_mp1_q1688", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "thirukkural_structure", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறள் எந்தப் பாவகையால் இயற்றப்பட்ட உலகப் பொதுமறையாகும்?", "media_id": null}], "options": {"A": "ஆசிரியப்பா", "B": "கலிப்பா", "C": "வஞ்சிப்பா", "D": "குறள் வெண்பா (இரண்டடி வெண்பா)"}, "explanation": "திருக்குறள் முதன்முதலில் குறள் வெண்பா என்னும் யாப்பு வடிவத்தால் இயற்றப்பட்ட 1,330 அருங்குறள்களைக் கொண்ட அறநூலாகும்."}, "en": {"blocks": [{"type": "text", "content": "In which classical poetic meter is the universal scripture Thirukkural composed?", "media_id": null}], "options": {"A": "Asiriyappa", "B": "Kalippa", "C": "Vanjippa", "D": "Kural Venba (Two-line rhymed couplet meter)"}, "explanation": "Thirukkural is composed in concise two-line Kural Venba couplet meters."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 63, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 63", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false,