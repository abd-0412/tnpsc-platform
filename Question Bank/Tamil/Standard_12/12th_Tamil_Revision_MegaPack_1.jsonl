{"id": "12th_tamil_mp1_q1657", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "punarchi_chemparithi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘செம்பரிதி’ - புணர்ச்சி விதியைத் தேர்ந்தெடுக்க:\n(செம்மை + பரிதி = செம்பரிதி)", "media_id": null}], "options": {"A": "ஈறு போதல், முன்னின்ற மெய் திரிதல் (இனமெல்லெழுத்தாதல்)", "B": "உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே", "C": "தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும்", "D": "திசைப்பெயர் புணர்ச்சி"}, "explanation": "‘ஈறு போதல்’ விதிப்படி 'மை' கெட்டு 'செம் + பரிதி = செம்பரிதி' என்றானது."}, "en": {"blocks": [{"type": "text", "content": "Select the sandhi rules operating in 'Semmai + Parithi = Semparithi'.", "media_id": null}], "options": {"A": "Eeru podhal (dropping of -mai suffix) leaving homorganic nasal consonant 'm'", "B": "Consonant joining vowel naturally", "C": "Gemination of consonant after short vowel", "D": "Direction noun sandhi"}, "explanation": "'Eeru podhal' drops the suffix -mai, directly yielding 'Semparithi'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 3, "chapter"