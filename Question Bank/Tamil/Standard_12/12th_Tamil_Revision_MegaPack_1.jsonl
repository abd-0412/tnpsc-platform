{"id": "12th_tamil_mp1_q1751", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_7", "chapter_id": null, "topic_id": "tnpsc_pyq_rumi_sufi_saint", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC Group 2 2017] ஜலாலுத்தீன் ரூமி தோற்றுவித்த புகழ்பெற்ற சூஃபி ஆன்மீக நடன வழிபாட்டு முறை எது?", "media_id": null}], "options": {"A": "\"கதக்", "B": "\"பரதநாட்டியம்", "C": "\"சுழலும் துறவிகளின் நடனம் (Whirling Dervishes)", "D": "\"ஒடிசி"}, "explanation": "ரூமியின் நினைவாக உருவான மெவ்லவி சூஃபி மரபினர் இறைவனை அடையும் ஆன்மீகப் பரவச நடனமாகச் 'சுழலும் நடனத்தை' (Whirling Dervishes) ஆடினர்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Group 2 2017] Which celebrated Sufi ecstatic spiritual dance tradition was inspired by the mysticism of Jalaluddin Rumi?", "media_id": null}], "options": {"A": "\"Kathak", "B": "\"Bharatanatyam", "C": "\"Whirling Dervishes (Mevlevi Order dance)", "D": "\"Odissi"}, "explanation": "The Mevlevi Order founded upon Rumi's teachings is internationally renowned for the Whirling Dervishes dance."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 48, "ch