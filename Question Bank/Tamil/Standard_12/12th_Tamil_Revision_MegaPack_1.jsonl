{"id": "12th_tamil_mp1_q1740", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_7", "chapter_id": null, "topic_id": "tnpsc_pyq_u_ve_sa_birth_village", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC Group 4 2017] உ.வே. சாமிநாதையர் பிறந்த உத்தமதானபுரம் எந்த மாவட்டத்தில் அமைந்துள்ளது?", "media_id": null}], "options": {"A": "\"தஞ்சாவூர் மாவட்டம்", "B": "\"நாகப்பட்டினம் மாவட்டம்", "C": "\"மயிலாடுதுறை மாவட்டம்", "D": "\"திருவாரூர் மாவட்டம் (கும்பகோணம் அருகே)"}, "explanation": "உ.வே.சா பழைய தஞ்சை மாவட்டத்தைச் சேர்ந்த (தற்போதைய திருவாரூர் மாவட்டம்) உத்தமதானபுரத்தில் 1855-இல் பிறந்தார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Group 4 2017] In which district is Uthamadhanapuram, the historic birthplace of U.V. Swaminatha Iyer, situated?", "media_id": null}], "options": {"A": "\"Thanjavur District", "B": "\"Nagapattinam District", "C": "\"Mayiladuthurai District", "D": "\"Tiruvarur District (near Kumbakonam)"}, "explanation": "U.Ve.Sa was born in Uthamadhanapuram in 1855, situated near Kumbakonam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 72, "chapte