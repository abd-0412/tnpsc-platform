{"id": "12th_tamil_mp1_q1662", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "thinnai_school_hierarchy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திண்ணைப் பள்ளிக்கூடங்களில் மாணவர்களைக் கண்காணித்து வழிநடத்தும் மூத்த மாணவன் எவ்வாறு அழைக்கப்பட்டான்?", "media_id": null}], "options": {"A": "கண்காணிப்பாளர்", "B": "சட்டம்பிள்ளை (மற்றும் முதன்மை மாணவன்)", "C": "அமைச்சன்", "D": "காரியக்காரன்"}, "explanation": "ஆசிரியருக்கு உதவியாக இளைய மாணவர்களுக்குப் பாடம் சொல்லிக் கொடுத்து மேற்பார்வையிடும் மூத்த மாணவன் 'சட்டம்பிள்ளை' என அழைக்கப்பட்டான்."}, "en": {"blocks": [{"type": "text", "content": "What was the senior student monitor who assisted the master and tutored junior pupils in Thinnai schools termed?", "media_id": null}], "options": {"A": "Superintendent", "B": "Sattampillai (Senior pupil monitor)", "C": "Minister", "D": "Overseer"}, "explanation": "A gifted senior student monitor who guided younger peers was traditionally called a 'Sattampillai'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 73, "chapter": null, "section": null, "re