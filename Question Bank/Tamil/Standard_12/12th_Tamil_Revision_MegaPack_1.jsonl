{"id": "12th_tamil_mp1_q1603", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "sangam_kudumbam_term", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘குடும்பம்’ என்னும் சொல் முதன்முதலில் எந்தப் பண்டைய தமிழ் இலக்கிய நூலில் இடம்பெற்றுள்ளது?", "media_id": null}], "options": {"A": "தொல்காப்பியம்", "B": "நற்றிணை", "C": "திருக்குறள் (குடிசெய்வல் என்னும் ஒருவற்குத் தெய்வம் மடிதற்றுத் தான்முந் துறும்)", "D": "சிலப்பதிகாரம்"}, "explanation": "‘குடும்பம்’ என்ற சொல்லாட்சி முதன்முதலில் திருக்குறளில் (குறள் 1029) ‘இடும்பைக்கு இடும்பை படுப்பர் குடும்பத்தை குன்றாமல் காப்பவர்’ என்ற பகுதியில் ஆளப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "In which ancient classical Tamil work does the specific term 'Kudumbam' (Family) appear for the very first time?", "media_id": null}], "options": {"A": "Tholkappiyam", "B": "Natrinai", "C": "Thirukkural (Kural 1029)", "D": "Silappathikaram"}, "explanation": "The specific lexical word 'Kudumbam' makes its historic debut in Thirukkural verse 1029."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 43