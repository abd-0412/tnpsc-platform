{"id": "12th_tamil_mp1_q1572", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "bharathi_nellaiyappar_letter", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியார் ‘தம்பி நெல்லையப்பருக்கு’ எழுதிய கடிதத்தில் எதனை முதன்மையாக வலியுறுத்துகிறார்?", "media_id": null}], "options": {"A": "அரசியல் பதவிகளை அடைவது", "B": "பொருளீட்டுவது மட்டுமே", "C": "வெளிநாடு சென்று வாழ்வது", "D": "தமிழ்நாட்டை உயர்த்தப் பாடுபடுதல், பெண்களை இழிவாகக் கருதாமல் உயர்த்துதல், தொழில்களைப் பெருக்குதல்"}, "explanation": "பாரதியார் பரலி சு. நெல்லையப்பருக்கு எழுதிய கடிதத்தில் பெண் விடுதலை, தொழில் வளர்ச்சி, தமிழுக்கு உழைத்தல் ஆகியவற்றை வலியுறுத்தினார்."}, "en": {"blocks": [{"type": "text", "content": "What primary nationalist imperative does Bharathiyar urge in his intimate epistle to Parali Su. Nellaiyappar?", "media_id": null}], "options": {"A": "Securing political offices", "B": "Accumulating private wealth solely", "C": "Migrating to foreign lands", "D": "Uplifting Tamil Nadu, liberating women, eradicating gender oppression, and advancing indigenous industries"}, "explanation": "Bharathi impassionedly urged women's emancipation, expanding modern industries, and revitalizing Tamil language."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_