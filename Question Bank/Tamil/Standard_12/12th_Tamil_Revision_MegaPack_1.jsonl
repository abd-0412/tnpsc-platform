{"id": "12th_tamil_mp1_q1682", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "thandi_author_period", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தண்டியலங்காரம்’ என்ற வடமொழி இலக்கண நூலைத் தழுவித் தமிழில் தண்டியலங்காரம் இயற்றப்பட்ட நூற்றாண்டு எது?", "media_id": null}], "options": {"A": "கி.பி. 8-ஆம் நூற்றாண்டு", "B": "கி.பி. 12-ஆம் நூற்றாண்டு (தண்டி ஆசிரியர்)", "C": "கி.பி. 16-ஆம் நூற்றாண்டு", "D": "கி.பி. 5-ஆம் நூற்றாண்டு"}, "explanation": "தண்டியலங்காரம் கி.பி. 12-ஆம் நூற்றாண்டில் சோழர் காலத்தில் தண்டி என்பவரால் காவியாதர்சம் என்னும் வடமொழி நூலைத் தழுவி இயற்றப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "In which century was the Tamil rhetorical treatise 'Thandi Alankaram' composed by grammarian Thandi?", "media_id": null}], "options": {"A": "8th Century CE", "B": "12th Century CE (Chola Period)", "C": "16th Century CE", "D": "5th Century CE"}, "explanation": "Thandi Alankaram was composed in the 12th century CE during the imperial Chola era."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 8, "chapter": null, "