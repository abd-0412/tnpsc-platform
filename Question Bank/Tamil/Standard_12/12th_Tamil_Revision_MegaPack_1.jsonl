{"id": "12th_tamil_mp1_q1637", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "suradha_magazines", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுரதா அவர்கள் முழுக்கவும் கவிதைகளுக்காகவே நடத்திய புகழ்பெற்ற கவிதை இதழ் எது?", "media_id": null}], "options": {"A": "காவியம்", "B": "குயில்", "C": "தென்றல்", "D": "முல்லை"}, "explanation": "சுரதா 'காவியம்' என்ற கவிதை இதழைத் தொடங்கி முழுக்க முழுக்கக் கவிதைகளாலேயே அவ்விதழை நடத்தி சாதனை படைத்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which pioneering literary journal dedicated exclusively to publishing poetry was founded and edited by Suradha?", "media_id": null}], "options": {"A": "Kaaviyam", "B": "Kuyil", "C": "Thendral", "D": "Mullai"}, "explanation": "Suradha founded 'Kaaviyam', an innovative periodical devoted entirely to verse."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 79, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 79", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name"