{"id": "12th_tamil_mp1_q1685", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "nedunalvaadai_lines_total", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நக்கீரர் இயற்றிய ‘நெடுநல்வாடை’ எத்தனை அடிகளைக் கொண்ட ஆசிரியப்பாவால் பாடப்பட்ட நூல்?", "media_id": null}], "options": {"A": "188 அடிகள்", "B": "269 அடிகள்", "C": "317 அடிகள்", "D": "103 அடிகள்"}, "explanation": "பத்துப்பாட்டு நூல்களுள் ஒன்றான நெடுநல்வாடை 188 அடிகளைக் கொண்ட ஆசிரியப்பாவால் நக்கீரரால் பாடப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "How many poetic lines comprise Nakkeerar's classical masterpiece Nedunalvaadai?", "media_id": null}], "options": {"A": "188 lines", "B": "269 lines", "C": "317 lines", "D": "103 lines"}, "explanation": "Nedunalvaadai consists of exactly 188 lines composed in pristine Asiriyappa meter."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 32, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 32", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_n