{"id": "12th_tamil_mp1_q1668", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "palm_leaf_seasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஓலைச்சுவடிகள் பல நூற்றாண்டுகள் அழியாமல் இருப்பதற்காகப் பழந்தமிழர்கள் அவற்றின் மீது பூசிய இயற்கைக் கலவை எது?", "media_id": null}], "options": {"A": "இரசாயனக் களிம்பு", "B": "சுண்ணாம்பு நீர்", "C": "வர்ணப் பூச்சு", "D": "மஞ்சள் அல்லது வசம்பு மற்றும் வேப்பிலைச் சாறு கலந்த மைப்பூச்சு"}, "explanation": "பூச்சிகள் சுவடிகளை அரிக்காமல் இருக்கவும், எழுத்துகள் தெளிவாகத் தெரியவும் மஞ்சள், வசம்பு, மாவிலைக்கரி முதலானவற்றைப் பூசிப் பாதுகாத்தனர்."}, "en": {"blocks": [{"type": "text", "content": "What indigenous preservation concoction was coated over palm-leaf manuscripts to protect them from insects across centuries?", "media_id": null}], "options": {"A": "Synthetic chemical ointment", "B": "Limewater wash", "C": "Lacquer varnish", "D": "Turmeric, sweet flag (Vasambu), and carbon soot paste infused with herbal extracts"}, "explanation": "Herbal infusions of turmeric, calamus (Vasambu), and charcoal soot protected manuscripts from pests."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Servi