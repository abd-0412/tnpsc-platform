{"id": "12th_tamil_mp1_q1689", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "kambar_goddess_saraswathi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கம்பர் தம்மை ஆதரித்த வள்ளலான சடையப்ப வள்ளலைப் போற்றி எத்தனை பாடல்களுக்கு ஒருமுறை பாடியுள்ளார்?", "media_id": null}], "options": {"A": "ஆயிரம் பாடல்களுக்கு ஒருமுறை", "B": "நூறு பாடல்களுக்கு ஒருமுறை", "C": "பத்து பாடல்களுக்கு ஒருமுறை", "D": "ஐநூறு பாடல்களுக்கு ஒருமுறை"}, "explanation": "கம்பராமாயணத்தை இயற்றப் பொருளுதவி செய்து ஆதரித்த திருவெண்ணெய்நல்லூர் சடையப்ப வள்ளலை ஆயிரம் பாடல்களுக்கு ஒருமுறை கம்பர் நன்றிப் பெருக்கோடு பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "How frequently does Kambar gratefully commemorate his generous patron, Sadaiyappa Vallal of Thiruvennainallur, in Kamba Ramayanam?", "media_id": null}], "options": {"A": "Once every thousand verses", "B": "Once every hundred verses", "C": "Once every ten verses", "D": "Once every five hundred verses"}, "explanation": "Kambar paid grateful homage to patron Sadaiyappa Vallal once in every one thousand verses."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "1