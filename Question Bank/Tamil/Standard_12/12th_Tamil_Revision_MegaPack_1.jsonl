{"id": "12th_tamil_mp1_q1604", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "kambar_shabari_padalam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கம்பராமாயணத்தில் வயோதிக மூதாட்டியான சவரி இராமனுக்கு எத்தகைய அன்பை வெளிப்படுத்தினாள்?", "media_id": null}], "options": {"A": "அரண்மனை ஆபரணங்களை அளித்தல்", "B": "போர்ப் பயிற்சி தருதல்", "C": "நாட்டை ஆள வேண்டுதல்", "D": "கனிந்த பழங்களைச் சுவைத்து, இனிமையானவற்றைத் தேடித் தந்து தாய்மைப் பேரன்பைப் பொழிதல்"}, "explanation": "சவரி பிறப்பு நீங்கு படலத்தில், சவரி இராம-இலக்குவரைத் தன் சொந்தக் குழந்தைகளாக எண்ணி இனிமையான கனிகளைப் பரிவுடன் ஊட்டினாள்."}, "en": {"blocks": [{"type": "text", "content": "In Kamba Ramayanam, how did the ascetic elderly tribal woman Shabari express her devotion to Rama?", "media_id": null}], "options": {"A": "Gifting royal jewelry", "B": "Teaching military strategy", "C": "Pleading to rule kingdoms", "D": "Offering sweet forest berries tested with boundless maternal tenderness"}, "explanation": "Shabari welcomed Rama with pure maternal affection, feeding him sweet fruits gathered in the wilderness."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services C