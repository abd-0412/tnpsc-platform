{"id": "12th_tamil_mp1_q1683", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "kudumba_murai_kootru", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மனித சமூகம் அடைந்த மிகப்பெரிய நாகரிகப் படிநிலைகளுள் ஒன்று குடும்ப அமைப்பாகும்’ - இக்கூற்றை நிறுவிய மானுடவியல் ஆய்வாளர் யார்?", "media_id": null}], "options": {"A": "மாலினோவ்ஸ்கி", "B": "லெவி ஸ்ட்ராஸ்", "C": "பக்தவத்சல பாரதி", "D": "இரா. நாகசாமி"}, "explanation": "பக்தவத்சல பாரதி தமது 'தமிழர் குடும்ப முறை' நூலில் குடும்பம் என்பது மனித நாகரிக வளர்ச்சியின் உச்சகட்ட சாதனை என நிறுவியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which anthropologist established that the 'institution of the family represents one of the crowning developmental milestones of human civilization'?", "media_id": null}], "options": {"A": "Bronislaw Malinowski", "B": "Claude Levi-Strauss", "C": "Bhakthavatsala Bharathi", "D": "R. Nagaswamy"}, "explanation": "Bhakthavatsala Bharathi elucidated the evolution of the family as an evolutionary summit of human culture."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 43, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 43", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 5", "Anthropology"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp1_q1684", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "u_ve_sa_publication_chronology", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உ.வே. சாமிநாதையர் முதன்முதலில் ஓலைச்சுவடியிலிருந்து அச்சில் பதிப்பித்து வெளியிட்ட பெருங்காப்பியம் எது?", "media_id": null}], "options": {"A": "சிலப்பதிகாரம் (1892)", "B": "மணிமேகலை (1898)", "C": "புறநானூறு (1894)", "D": "சீவகசிந்தாமணி (1887)"}, "explanation": "உ.வே.சா அவர்கள் 1887-ஆம் ஆண்டு 'சீவகசிந்தாமணி' காப்பியத்தையே முதன்முதலில் முழுமையான உரையுடன் அச்சேற்றித் தமிழ் உலகை வியப்பில் ஆழ்த்தினார்."}, "en": {"blocks": [{"type": "text", "content": "Which major classical epic did U.V. Swaminatha Iyer critically edit and publish in print for the very first time in 1887?", "media_id": null}], "options": {"A": "Silappathikaram (1892)", "B": "Manimekalai (1898)", "C": "Purananuru (1894)", "D": "Seevaga Chinthamani (1887)"}, "explanation": "U.Ve.Sa heralded the modern Tamil renaissance by publishing Seevaga Chinthamani in 1887."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 72, "chap