{"id": "12th_tamil_mp1_q1595", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "sirpi_sahithya_general_council", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிற்பி பாலசுப்பிரமணியம் எந்த இலக்கிய அமைப்பின் செயற்குழு உறுப்பினராகவும் ஒருங்கிணைப்பாளராகவும் நீண்ட காலம் பணியாற்றினார்?", "media_id": null}], "options": {"A": "சங்கீத நாடக அகாதெமி", "B": "தமிழ் வளர்ச்சித் துறை", "C": "சாகித்திய அகாதெமி (புதுதில்லி)", "D": "தேசிய புத்தக அறக்கட்டளை"}, "explanation": "சிற்பி பாலசுப்பிரமணியம் தில்லி சாகித்திய அகாதெமியின் தமிழ்ப் பிரிவின் ஒருங்கிணைப்பாளராகவும் செயற்குழு உறுப்பினராகவும் பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "In which national literary institution did poet Sirpi Balasubramaniam serve as an executive council member and Tamil advisory convener?", "media_id": null}], "options": {"A": "Sangeet Natak Akademi", "B": "Directorate of Tamil Development", "C": "Sahitya Akademi (New Delhi)", "D": "National Book Trust"}, "explanation": "He served as the convener of the Tamil advisory board at the Sahitya Akademi, New Delhi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class":