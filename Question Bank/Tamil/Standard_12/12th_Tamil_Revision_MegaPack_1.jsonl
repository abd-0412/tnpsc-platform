{"id": "12th_tamil_mp1_q1705", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "u_ve_sa_honorary_doctorate", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சென்னைப் பல்கலைக்கழகம் உ.வே. சாமிநாதையருக்கு எந்த ஆண்டு கௌரவ டாக்டர் (டி.லிட்) பட்டம் வழங்கிச் சிறப்பித்தது?", "media_id": null}], "options": {"A": "1932 (மார்ச் மாதம்)", "B": "1920", "C": "1940", "D": "1910"}, "explanation": "சென்னைப் பல்கலைக்கழகம் உ.வே.சாவின் அரும்பெரும் தமிழ்ப் பணிகளைப் போற்றி 1932-இல் மதிப்புறு முனைவர் (D.Litt) பட்டம் வழங்கிக் கௌரவித்தது."}, "en": {"blocks": [{"type": "text", "content": "In which year did the University of Madras confer the prestigious Honorary Doctorate (D.Litt) upon U.V. Swaminatha Iyer?", "media_id": null}], "options": {"A": "1932 (March)", "B": "1920", "C": "1940", "D": "1910"}, "explanation": "The University of Madras conferred the Honorary Doctor of Literature (D.Litt) on him in March 1932."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 72, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 72", "url"