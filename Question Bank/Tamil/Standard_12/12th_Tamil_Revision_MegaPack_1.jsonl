{"id": "12th_tamil_mp1_q1631", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "ci_mani_awards", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் சி. மணி அவர்கள் இயற்றிய புகழ்பெற்ற நூல்களுள் பொருந்தாதது எது?", "media_id": null}], "options": {"A": "வரும் போகும்", "B": "ஒளிச்சேர்க்கை", "C": "சுதந்திர தாகம்", "D": "யாப்பும் நோக்கும்"}, "explanation": "‘வரும் போகும்’, ‘ஒளிச்சேர்க்கை’, ‘யாப்பும் நோக்கும்’ ஆகியவற்றை சி. மணி எழுதினார்; ‘சுதந்திர தாகம்’ சி.சு. செல்லப்பாவின் நாவலாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following works was NOT authored by poet C. Mani?", "media_id": null}], "options": {"A": "Varum Pogum", "B": "Olicheerkkai", "C": "Sudhanthira Thaagam (Novel by C.S. Chellappa)", "D": "Yaappum Nokkum"}, "explanation": "'Sudhanthira Thaagam' was written by C.S. Chellappa, whereas the other three are celebrated works by C. Mani."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 83, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 83", "url": null, "source_notes": n