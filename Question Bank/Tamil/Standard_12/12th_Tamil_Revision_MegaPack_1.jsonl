{"id": "12th_tamil_mp1_q1690", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "porul_mayakkam_prevention", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொடரில் பொருள் மயக்கம் ஏற்படாமல் தடுக்க நாம் எவற்றில் கவனமாக இருக்க வேண்டும்?", "media_id": null}], "options": {"A": "பெரிய எழுத்துக்களை மட்டுமே பயன்படுத்துதல்", "B": "சொற்களை உரிய இடத்தில் சேர்த்தும் பிரித்தும் எழுதுதல், சரியான நிறுத்தற்குறிகளை இடுதல் மற்றும் திணை-பால்-இடப் பொருத்தங்களை அறிதல்", "C": "எதுகை மோனைகளை மட்டுமே கவனித்தல்", "D": "ஆங்கிலக் குறியீடுகளைப் பயன்படுத்துதல்"}, "explanation": "சொல் சேர்க்கை, சொல் பிரிப்பு, ஒற்றுப் பிழையின்மை, நிறுத்தற்குறிகள் ஆகியவற்றை முறையாகக் கையாள்வதே பொருள் மயக்கத்தைத் தவிர்க்கும் வழி."}, "en": {"blocks": [{"type": "text", "content": "What syntax precautions must be exercised to prevent semantic ambiguity (Porul Mayakkam) in written Tamil?", "media_id": null}], "options": {"A": "Using capital letters exclusively", "B": "Proper spacing, precise compounding and splitting, correct punctuation, and maintaining grammatical concord", "C": "Focusing purely on rhyming cadences", "D": "Inserting foreign symbols"}, "explanation": "Semantic clarity requires rigorous adherence to proper spacing, punctuation, and syntactic concord."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_m