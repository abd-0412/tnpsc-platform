{"id": "12th_tamil_mp1_q1669", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "purananooru_ambassador_code", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க இலக்கியத்தில் அரசர்களுக்கு இடையே போர் மூளாமல் தடுக்கும் தூதுவர்களாக பெரும்பாலும் யார் செயல்பட்டனர்?", "media_id": null}], "options": {"A": "அறிவு முதிர்ந்த சங்கப் புலவர்கள் (ஔவையார் போன்றோர்)", "B": "படைத்தளபதிகள் மட்டுமே", "C": "வணிகர்கள்", "D": "ஒற்றர்கள்"}, "explanation": "சங்கப் புலவர்கள் மன்னர்களுக்கு நல்லுரை கூறி, போரினால் ஏற்படும் பேரழிவைத் தடுத்து சமாதானத்தை நிலைநாட்டும் மாண்புமிக்க தூதுவர்களாக விளங்கினர்."}, "en": {"blocks": [{"type": "text", "content": "In classical Sangam history, who predominantly functioned as revered peace envoys averting war between rival monarchs?", "media_id": null}], "options": {"A": "Eminent wise Sangam bards and poet-philosophers (such as Avvaiyar)", "B": "Military infantry generals exclusively", "C": "Itinerant merchants", "D": "Espionage spies"}, "explanation": "Learned bards like Avvaiyar commanded immense moral authority to dissuade kings from devastating warfare."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 87, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 87", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 4", "Sangam Diplomacy"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp1_q1670", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "rumi_human_mind_metaphor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘விருந்தினர் இல்லம்’ கவிதையில் கசப்பு, வஞ்சனை, அவமானம் முதலான உணர்வுகளை வாசகன் எவ்வாறு எதிர்கொள்ள வேண்டும் என்று ரூமி கூறுகிறார்?", "media_id": null}], "options": {"A": "அவற்றை எதிர்த்துப் போரிட வேண்டும்", "B": "அவற்றை வாசற்படிக்கே சென்று சிரித்த முகத்தோடு வரவேற்று உள்ளே அழைக்க வேண்டும்", "C": "அவற்றைக் கண்டு ஓடி ஒளிய வேண்டும்", "D": "மனதில் பூட்டி வைக்க வேண்டும்"}, "explanation": "அனைத்து உணர்வுகளையும் மதிக்க வேண்டும்; அவை ஏதோ ஒரு மேலான விழிப்புணர்வை மனிதனுக்கு ஊட்டவே இறைவனால் அனுப்பப்படுகின்றன என்கிறார் ரூமி."}, "en": {"blocks": [{"type": "text", "content": "In 'The Guest House', how does Rumi advise confronting dark emotions such as malice, shame, and sorrow?", "media_id": null}], "options": {"A": "Vigorously wage violent war against them", "B": "Meet them at the doorway laughing and warmly invite them in as honor guests", "C": "Flee and hide in dread", "D": "Lock them up secretly in mental dungeons"}, "explanation": "He advises welcoming every emotion with open arms, for each may be clearing the house for a new delight."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"t