{"id": "12th_tamil_mp1_q1571", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "ti_su_natarajan_aesthetics", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தமிழ் மொழி நடை அழகியல்’ என்ற நூலை எழுதிய பேராசிரியரும் திறனாய்வாளருமான அறிஞர் யார்?", "media_id": null}], "options": {"A": "க. கைலாசபதி", "B": "கா. சிவத்தம்பி", "C": "தி.சு. நடராசன்", "D": "முனைவர் தமிழண்ணல்"}, "explanation": "பேராசிரியர் தி.சு. நடராசன் தமிழ் கவிதை மொழியின் அழகியலையும் நடையியலையும் ஆராய்ந்து 'தமிழ் அழகியல்' என்ற நூலை எழுதியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who is the scholar and literary critic who authored the treatise 'Thamizh Mozhi Nadai Azhagiyal'?", "media_id": null}], "options": {"A": "K. Kailasapathy", "B": "K. Sivathambi", "C": "T.S. Natarajan", "D": "Dr. Thamizhannal"}, "explanation": "Prof. T.S. Natarajan authored the foundational aesthetic critique 'Thamizh Azhagiyal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 4, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 4", "url": null, "sourc