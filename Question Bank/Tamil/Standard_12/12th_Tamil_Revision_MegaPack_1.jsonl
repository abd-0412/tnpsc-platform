{"id": "12th_tamil_mp1_q1672", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "thirukkural_kodai_arvalam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வறியார்க்கொன்று ஈவதே ஈகை மற்றெல்லாம் குறியெதிர்ப்பை நீர துடைத்து’ - இக்குறள் உணர்த்தும் ஈகை இலக்கணம் யாது?", "media_id": null}], "options": {"A": "செல்வந்தர்களுக்குப் பரிசு தருவது", "B": "கைம்மாறு எதிர்பார்த்துக் கொடுப்பது", "C": "வட்டிக்குக் கடன் கொடுப்பது", "D": "இல்லாத ஏழை எளியவர்க்குக் கொடுப்பதே உண்மையான ஈகை; மற்றதெல்லாம் கைம்மாறு கருதிச் செய்யும் வணிகமே ஆகும்"}, "explanation": "வறியவருக்குக் கொடுப்பதே தூய ஈகை; பிறருக்குப் பிரதிபலன் எதிர்பார்த்துக் கொடுப்பது கடன் கொடுத்தலைப் போன்றதே ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the authentic definition of charity according to Kural: 'Variyaarkkontru eevadhe eegai matrellam kuriyethirppai neera thudaiththu'?", "media_id": null}], "options": {"A": "Offering gifts to wealthy dignitaries", "B": "Giving with calculated expectation of reciprocal return", "C": "Lending money on compound interest", "D": "Bestowing upon the destitute who have nothing is true charity; all other giving is merely a transactional trade of reciprocal barter"}, "explanation": "True charity is giving solely to the destitute; all else is mere transactional exchange expecting future payback."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negat