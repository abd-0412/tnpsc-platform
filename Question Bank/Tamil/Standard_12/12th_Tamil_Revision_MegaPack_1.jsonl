{"id": "12th_tamil_mp1_q1650", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "u_ve_sa_guru", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உ.வே. சாமிநாதையருக்குத் தமிழ்க் கல்வி புகட்டி வளர்த்தெடுத்த அவரது புகழ்பெற்ற ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "கா. நமச்சிவாய முதலியார்", "B": "மகாவித்துவான் மீனாட்சிசுந்தரம் பிள்ளை", "C": "மறைமலையடிகள்", "D": "பேராசிரியர் சதாசிவ பண்டாரத்தார்"}, "explanation": "மகாவித்துவான் மீனாட்சிசுந்தரம் பிள்ளையிடம் உ.வே.சா பல ஆண்டுகள் குருகுல வாச முறையில் பயின்று பெரும் தமிழ்ப் புலமை பெற்றார்."}, "en": {"blocks": [{"type": "text", "content": "Who was the legendary Tamil scholar who mentored and trained U.V. Swaminatha Iyer in the traditional Gurukula method?", "media_id": null}], "options": {"A": "K. Namachivaya Mudaliar", "B": "Mahavidwan Meenakshisundaram Pillai", "C": "Maraimalai Adigal", "D": "T.V. Sadasiva Pandarathar"}, "explanation": "U.V. Swaminatha Iyer was trained for years under the legendary titan Mahavidwan Meenakshisundaram Pillai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", 