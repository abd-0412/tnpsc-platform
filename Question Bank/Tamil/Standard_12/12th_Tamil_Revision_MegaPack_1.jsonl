{"id": "12th_tamil_mp1_q1612", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "kambar_seven_brothers", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கம்பராமாயணத்தில் இராமனுடன் உடன்பிறந்த சகோதரர்களின் எண்ணிக்கை இறுதியில் எத்தனையாய்ப் பெருகுகிறது?", "media_id": null}], "options": {"A": "நான்கு சகோதரர்கள்", "B": "ஐந்து சகோதரர்கள்", "C": "ஆறு சகோதரர்கள்", "D": "ஏழு சகோதரர்கள் (இராமன், இலக்குவன், பரதன், சத்துருக்கனன், குகன், சுக்ரீவன், வீடணன்)"}, "explanation": "முதலில் நால்வராகப் பிறந்து, குகனோடு ஐவராகி, சுக்ரீவனோடு அறுவராகி, வீடணனோடு எழுவரானோம் என்று இராமன் சகோதரத்துவத்தை விரிவுபடுத்துகிறான்."}, "en": {"blocks": [{"type": "text", "content": "In Kamba Ramayanam, how many brothers does Rama's expansive universal family ultimately encompass?", "media_id": null}], "options": {"A": "Four brothers", "B": "Five brothers", "C": "Six brothers", "D": "Seven brothers (Rama, Lakshmana, Bharata, Shatrughna, Guha, Sugriva, and Vibhishana)"}, "explanation": "Born four, joined by Guha as five, Sugriva as six, and Vibhishana as seven, creating an expansive egalitarian brotherhood."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Service