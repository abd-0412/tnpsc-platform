{"id": "12th_tamil_mp1_q1651", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "ci_mani_pseudonym", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் சி. மணி அவர்கள் புதுக்கவிதைகள் எழுதிய மற்றொரு புனைப்பெயர் யாது?", "media_id": null}], "options": {"A": "அன்பாதவன்", "B": "பானுசந்திரன்", "C": "வேDevice (வே. மாலி)", "D": "சுஜாதா"}, "explanation": "சி. மணி அவர்கள் 'சி. மணி' என்ற பெயரிலும் 'வே. மாலி' என்ற புனைப்பெயரிலும் புகழ்மிக்க புதுக்கவிதைகளைப் படைத்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Under which prominent alternate pseudonym did poet C. Mani publish landmark modern verses?", "media_id": null}], "options": {"A": "Anbadhavan", "B": "Bhanuchandran", "C": "Ve. Maali", "D": "Sujatha"}, "explanation": "C. Mani frequently published avant-garde verses under the pen name 'Ve. Maali'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 83, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 83", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": nu