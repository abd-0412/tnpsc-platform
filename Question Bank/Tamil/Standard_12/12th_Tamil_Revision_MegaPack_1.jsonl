{"id": "12th_tamil_mp1_q1588", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "uthamacholan_magazines", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எழுத்தாளர் உத்தமசோழன் தொடர்ந்து 12 ஆண்டுகள் நடத்திவந்த மனிதநேய மற்றும் இலக்கிய இதழ் எது?", "media_id": null}], "options": {"A": "கணையாழி", "B": "தீபம்", "C": "எழுத்து", "D": "கிழக்கு வாசல் உதயம்"}, "explanation": "உத்தமசோழன் 'கிழக்கு வாசல் உதயம்' என்ற இலக்கிய மாத இதழைப் பன்னிரண்டு ஆண்டுகளுக்கும் மேலாகத் தொடர்ந்து நடத்தினார்."}, "en": {"blocks": [{"type": "text", "content": "Which literary monthly journal was edited and published for over 12 years by Uthamacholan?", "media_id": null}], "options": {"A": "Kanaiyazhi", "B": "Deepam", "C": "Ezhuthu", "D": "Kizhakku Vaasal Udhayam"}, "explanation": "He published and edited the monthly literary journal 'Kizhakku Vaasal Udhayam' for 12 years."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 39, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 39", "url": null, "source_notes": null}, "previous_year": {"is_p