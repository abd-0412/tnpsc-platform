{"id": "12th_tamil_mp1_q1576", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "piragoru_naal_kodai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மழை நின்றவுடன் வெயில் முளைக்கிறது... பிறகொரு நாள் கோடை வந்துவிட்டது’ - இக்கவிதையை எழுதிய நவீனக் கவிஞர் யார்?", "media_id": null}], "options": {"A": "சுஜாதா", "B": "கல்யாண்ஜி", "C": "பிரமிள்", "D": "ஐயப்ப மாதவன்"}, "explanation": "வானம் மற்றும் மழையின் விசித்திர மாற்றங்களைப் பேசும் 'பிறகொரு நாள் கோடை' கவிதையை ஐயப்ப மாதவன் இயற்றியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the evocative nature poem 'Piragoru Naal Kodai' capturing the capricious shifts of rain and sudden summer?", "media_id": null}], "options": {"A": "Sujatha", "B": "Kalyanji", "C": "Pramil", "D": "Ayyappa Madhavan"}, "explanation": "Ayyappa Madhavan authored 'Piragoru Naal Kodai' illustrating urban ecological perceptions."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 30", "url": null, "source_notes": nu