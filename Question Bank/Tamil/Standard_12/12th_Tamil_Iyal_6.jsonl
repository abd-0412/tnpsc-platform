{"id": "12th_tamil_u6_q986", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thiraimozhi", "chapter_id": null, "topic_id": "camera_angles_low_angle", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒரு கதாபாத்திரத்தை வலிமையானதாகவும் கம்பீரமானதாகவும் காட்ட கேமராவை கீழே வைத்து மேல்நோக்கிப் படம்பிடிக்கும் கோணம் எது?", "media_id": null}], "options": {"A": "உயர் கோணம்", "B": "தாழ் கோணம் (Low-angle shot)", "C": "கண் மட்டக் கோணம்", "D": "அண்மைக் காட்சி"}, "explanation": "கதாபாத்திரத்தின் பெருமை, வலிமை, ஆதிக்கம் ஆகியவற்றை வெளிப்படுத்தக் கேமராவைக் கீழிருந்து மேல்நோக்கிப் படம் பிடிப்பது 'தாழ் கோணம்' (Low-angle shot) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which camera angle shoots upwards from below eye level to project authority, stature, dominance, or intimidation?", "media_id": null}], "options": {"A": "High-angle shot", "B": "Low-angle shot (Thaazh Konam)", "C": "Eye-level shot", "D": "Extreme close-up"}, "explanation": "A Low-angle shot frames the subject from below to emphasize imposing power, grandeur, and authority."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 133,