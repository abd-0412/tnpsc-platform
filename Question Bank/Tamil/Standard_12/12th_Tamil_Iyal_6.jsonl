{"id": "12th_tamil_u6_q1014", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "three_kandams", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரம் எத்தனை காண்டங்களையும் காதைகளையும் கொண்டுள்ளது?", "media_id": null}], "options": {"A": "இரண்டு காண்டங்கள், 20 காதைகள்", "B": "மூன்று காண்டங்கள் (புகார், மதுரை, வஞ்சி), 30 காதைகள்", "C": "ஆறு காண்டங்கள், 100 காதைகள்", "D": "ஐந்து காண்டங்கள், 50 காதைகள்"}, "explanation": "சிலப்பதிகாரம் புகார் காண்டம் (10 காதைகள்), மதுரை காண்டம் (13 காதைகள்), வஞ்சிக் காண்டம் (7 காதைகள்) என மொத்தம் 30 காதைகளைக் கொண்டது."}, "en": {"blocks": [{"type": "text", "content": "How many major books (Kandams) and cantos (Kaathaigal) comprise the epic Silappathikaram?", "media_id": null}], "options": {"A": "2 Kandams and 20 Cantos", "B": "3 Kandams (Puhar, Madurai, Vanji) and 30 Cantos", "C": "6 Kandams and 100 Cantos", "D": "5 Kandams and 50 Cantos"}, "explanation": "Silappathikaram comprises 3 books (Puhar, Madurai, Vanji) and exactly 30 poetic cantos."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 138,