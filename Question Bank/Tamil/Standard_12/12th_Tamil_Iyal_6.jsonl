{"id": "12th_tamil_u6_q1025", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nakulan_kavithaigal", "chapter_id": null, "topic_id": "nakulan_style", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நகுலன் கவிதைகளின் தனித்துவமான பாணி எது?", "media_id": null}], "options": {"A": "மிகச் சுருங்கிய வரிகளில் மனித மனத்தின் ஆழமான தனிமையையும் இருப்பையும் வெளிப்படுத்துதல்", "B": "அதிக எதுகை மோனைகள் கொண்ட மரபுப்பாடல்", "C": "நீண்ட காப்பிய நடை", "D": "வரலாற்றுப் போர் வர்ணனை"}, "explanation": "நகுலன் மிகச் சில சொற்களைக் கொண்டு, தத்துவார்த்தமான சிந்தனைகளையும் தனிமையின் கனத்தையும் வெளிப்படுத்தும் நவீன உத்தியைக் கையாண்டார்."}, "en": {"blocks": [{"type": "text", "content": "What distinctive hallmark characterizes the modernist poetic style of Nakulan?", "media_id": null}], "options": {"A": "Austere minimalism projecting profound psychological solitude and existential transience", "B": "Florid classical rhymed couplets", "C": "Sprawling epic narratives", "D": "Martial chronicles"}, "explanation": "Nakulan was a minimalist who distilled deep existential questions into brief verses."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edit