{"id": "12th_tamil_u6_q1148", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "unit6_exercises", "chapter_id": null, "topic_id": "glossary_wide_angle", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திரைப்படத்தில் ஒரு பரந்த நிலப்பரப்பை முழுமையாகக் காட்டும் ‘Wide Angle’ என்பதன் தமிழாக்கம் எது?", "media_id": null}], "options": {"A": "குறுகிய கோணம்", "B": "அண்மைக் கோணம்", "C": "செங்குத்துக் கோணம்", "D": "பரந்த கோணம் / அகலக் கோணம்"}, "explanation": "‘Wide Angle’ என்பது கேமரா லென்சின் மூலம் பரந்த நிலப்பரப்பை அகலமாகப் படம்பிடிக்கும் ‘பரந்த கோணம்’ ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the Tamil technical term for 'Wide Angle' in cinematography?", "media_id": null}], "options": {"A": "Narrow angle", "B": "Close angle", "C": "Vertical angle", "D": "Parantha Konam / Agalak Konam (Wide Angle)"}, "explanation": "'Wide Angle' translates to 'Parantha Konam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 150, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 150", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam"