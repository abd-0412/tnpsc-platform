{"id": "12th_tamil_u6_q1110", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "urupparai_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெகுளிக்குரிய காரணங்களில் ஒன்றாகிய ‘உறுப்பறை’ என்பது எதனைக் குறிக்கும்?", "media_id": null}], "options": {"A": "அறையில் அடைத்தல்", "B": "உடலின் உறுப்புகளை வெட்டிச் சிதைத்தல் (அங்கச்சேதம்)", "C": "உறுதியான சொல்", "D": "உணவு மறுத்தல்"}, "explanation": "‘உறுப்பறை’ என்பது பகைவனால் ஒருவருடைய கை, கால், காது போன்ற உடல் உறுப்புகள் துண்டிக்கப்பட்டுச் சிதைக்கப்படுவதைக் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "What does the legal-somatic term 'Urupparai' mean in the provocative causes of Wrath (Veguli)?", "media_id": null}], "options": {"A": "Confinement in a cell", "B": "Mutilation / Dismemberment of bodily limbs and organs", "C": "Resolute speech", "D": "Denial of food"}, "explanation": "'Urupparai' denotes physical dismemberment or violent mutilation of bodily limbs."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 144, "chapter": null, "section": null, "reference": "12th Tamil, Unit