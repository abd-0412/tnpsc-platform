{"id": "12th_tamil_u6_q1027", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nakulan_kavithaigal", "chapter_id": null, "topic_id": "nakulan_novels_kotstand", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கோட் ஸ்டாண்ட்’ (Coat Stand), ‘நினைவுப் பாதை’ ஆகிய நாவல்களை எழுதியவர் யார்?", "media_id": null}], "options": {"A": "சுந்தர ராமசாமி", "B": "அசோகமித்திரன்", "C": "நகுலன்", "D": "தி. ஜானகிராமன்"}, "explanation": "நகுலன் நவீனத் தமிழ் நாவல் உலகில் 'கோட் ஸ்டாண்ட்', 'நினைவுப் பாதை', 'நிழல்கள்' போன்ற புதுமையான பரிசோதனை நாவல்களைப் படைத்தார்."}, "en": {"blocks": [{"type": "text", "content": "Who penned the avant-garde experimental novels 'Coat Stand' and 'Ninaivup Paathai'?", "media_id": null}], "options": {"A": "Sundara Ramaswamy", "B": "Ashokamitran", "C": "Nakulan", "D": "T. Janakiraman"}, "explanation": "Nakulan penned experimental landmark novels like 'Coat Stand' and 'Ninaivup Paathai'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 135, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 135", "url": null, "source_notes": null}, "previous_year": {"is_previous_y