{"id": "12th_tamil_u6_q1117", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "kannagi_madurai_erithal_veguli", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாண்டிய மன்னனின் அவையில் சிலம்பை உடைத்து உண்மையை நிறுவி, மதுரையை எரிக்க முற்பட்ட கண்ணகியின் சீற்றம் எந்த மெய்ப்பாட்டிற்குரியது?", "media_id": null}], "options": {"A": "வெகுளி (சினம்)", "B": "நகை", "C": "மருட்கை", "D": "இளிவரல்"}, "explanation": "நீதி தவறிய மன்னனின் அவையில் உண்மையை முழங்கி மதுரையை எரிக்கக் கட்டளையிட்ட கண்ணகியின் பொங்கு சீற்றம் 'வெகுளி' மெய்ப்பாடாகும்."}, "en": {"blocks": [{"type": "text", "content": "Kannagi's blazing fury in shattering her anklet before the Pandyan throne and razing Madurai demonstrates which sentiment?", "media_id": null}], "options": {"A": "Veguli (Righteous Wrath / Fury)", "B": "Nagai", "C": "Marutkai", "D": "Ilivaral"}, "explanation": "Kannagi's righteous anger epitomizes Veguli (fury/wrath)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 144, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 144", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Grammar", "Kannagi Wrath"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1118", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "trivikrama_marutkai_example", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வாமனன் திரிவிக்ரமனாக விசுவரூபம் எடுத்து விண்ணையும் மண்ணையும் ஓரடியால் அளந்த பிரம்மாண்டக் காட்சியைக் கண்டவர்கள் அடைந்த மெய்ப்பாடு எது?", "media_id": null}], "options": {"A": "அழுகை", "B": "மருட்கை (வியப்பு)", "C": "இளிவரல்", "D": "நகை"}, "explanation": "சிற்றுருவாக வந்த வாமனன் விண்ணளக்கும் மாபெரும் விசுவரூபம் எடுத்த வியக்கத்தக்க ஆக்கத்தைக் கண்டோர் அடைந்த உணர்ச்சி 'மருட்கை' (வியப்பு) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "The awestruck wonder experienced by spectators witnessing dwarf Vamana expand cosmic Trivikrama proportions illustrates which emotion?", "media_id": null}], "options": {"A": "Azhugai", "B": "Marutkai (Astonishment / Wonder)", "C": "Ilivaral", "D": "Nagai"}, "explanation": "Witnessing cosmic expansion elicits Marutkai (wonder/astonishment)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 144, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 144", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Grammar", "Vamana Wonder"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1119", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "madan_meaning_simplicity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நகை மெய்ப்பாட்டில் ‘மடன்’ என்பது எத்தகைய இயல்பைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "பெருங்கோபம்", "B": "கொடிய பகைமை", "C": "எளிதில் எதையும் நம்பி ஏமாறும் மடமை / கொளுத்தக் கொண்டு கொண்டது விடாமை", "D": "அளவற்ற அறிவு"}, "explanation": "‘மடன்’ என்பது உலக அனுபவமின்றி எதையும் எளிதில் உண்மை என்று நம்பி ஏமாறும் வெகுளித்தனத்தைக் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "What human disposition is signified by 'Madan' in the genesis of Laughter (Nagai)?", "media_id": null}], "options": {"A": "Blinding rage", "B": "Violent enmity", "C": "Gullible simplicity / Naive credulity easily duped by appearances", "D": "Profound omniscience"}, "explanation": "'Madan' signifies naive gullibility or credulity easily exploited to comedic effect."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 144, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 144", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Grammar", "Madan Meaning"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1120", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "isaimai_meaning_fame", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெருமிதத்தின் நான்கு கூறுகளுள் ‘இசைமை’ என்பது எதனைக் குறிக்கும்?", "media_id": null}], "options": {"A": "இசைக்கருவி", "B": "பாடல் பாடுதல்", "C": "இணங்கிப் போதல்", "D": "உலகளாவிய பெரும் புகழ் (கீர்த்தி)"}, "explanation": "‘இசைமை’ என்பது நற்செயல்களாலும் பெருவீரத்தாலும் ஈட்டிய உயர்ந்த உலகப் புகழைக் (கீர்த்தி) குறிக்கும் சொல்லாகும்."}, "en": {"blocks": [{"type": "text", "content": "What does the classical attribute 'Isaimai' denote as a cornerstone of Heroic Dignity (Perumitham)?", "media_id": null}], "options": {"A": "Musical instrument", "B": "Vocal singing", "C": "Passive compromise", "D": "Enduring renown, glory, and widespread virtuous fame"}, "explanation": "'Isaimai' denotes radiant fame and enduring moral renown."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 144, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 144", "url": null, "source_notes": null}, "previous_