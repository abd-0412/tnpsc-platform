{"id": "12th_tamil_u6_q1033", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nakulan_kavithaigal", "chapter_id": null, "topic_id": "nakulan_bilingual_writing", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நகுலன் தமிழோடு எந்த மொழியிலும் கவிதைகளையும் நாவல்களையும் படைக்கும் ஆற்றல் பெற்றிருந்தார்?", "media_id": null}], "options": {"A": "ஆங்கிலம்", "B": "பிரெஞ்சு", "C": "ஜெர்மன்", "D": "மலையாளம் மட்டும்"}, "explanation": "நகுலன் ஆங்கிலப் பேராசிரியராகப் பணியாற்றியதால் தமிழிலும் ஆங்கிலத்திலும் பல நவீன இலக்கியப் படைப்புகளை உருவாக்கினார்."}, "en": {"blocks": [{"type": "text", "content": "Alongside Tamil, in which language did Nakulan write acclaimed modernist poetry and experimental fiction?", "media_id": null}], "options": {"A": "English", "B": "French", "C": "German", "D": "Malayalam exclusively"}, "explanation": "Nakulan was a bilingual author who wrote poetry and literary criticism in both Tamil and English."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 135, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 135", "url": null, "source_notes": null}, "previous_