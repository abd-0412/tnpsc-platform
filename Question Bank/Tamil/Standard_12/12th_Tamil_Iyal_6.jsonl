{"id": "12th_tamil_u6_q1008", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thiraimozhi", "chapter_id": null, "topic_id": "chaplin_autobiography", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சார்லி சாப்ளின்’ தன் ஏழ்மையான குழந்தைப் பருவத்தையும் உலகப் புகழ்பெற்ற கலைப் பயணத்தையும் விவரித்து எழுதிய தன்வரலாற்று நூல் எது?", "media_id": null}], "options": {"A": "என் கலை வாழ்க்கை", "B": "திரைப்பட நினைவுகள்", "C": "சிரிப்பின் கதை", "D": "மை ஆட்டோபயோகிராபி (My Autobiography)"}, "explanation": "சாப்ளின் எழுதிய 'மை ஆட்டோபயோகிராபி' (My Autobiography) என்னும் நூல் அவரது வறுமை, கலையுலகப் போராட்டம் மற்றும் சாதனைகளை விளக்கும் உலகப் புகழ்பெற்ற நூலாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the title of Charlie Chaplin's acclaimed personal memoir documenting his childhood destitution and cinematic ascension?", "media_id": null}], "options": {"A": "My Art Life", "B": "Cinematic Memories", "C": "Story of Laughter", "D": "My Autobiography"}, "explanation": "Chaplin penned his acclaimed memoir titled 'My Autobiography'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 133, "chapter"