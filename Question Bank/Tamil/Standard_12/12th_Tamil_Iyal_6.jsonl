{"id": "12th_tamil_u6_q1028", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "kaathai_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரத்தில் உட்பிரிவுகளைக் குறிக்கப் பயன்படுத்தப்பட்டுள்ள ‘காதை’ என்னும் சொல்லின் பொருள் யாது?", "media_id": null}], "options": {"A": "பாடல் மட்டும்", "B": "மேடை நாடகம்", "C": "கவிதை வரி", "D": "பாட்டுடைச் செய்யுள் வடிவில் அமையும் கதைப் பகுதி (பாட்டுருவக் கதை)"}, "explanation": "‘காதை’ என்பது காப்பியத்தில் ஒரு கதைக் கூறினைப் பாட்டுடைச் செய்யுளாக விவரிக்கும் உட்பிரிவாகும்."}, "en": {"blocks": [{"type": "text", "content": "What does the classical structural subdivision term 'Kaathai' mean in ancient Tamil epics?", "media_id": null}], "options": {"A": "Short song only", "B": "Playhouse stage", "C": "Metric hemistich", "D": "Narrative episode rendered in poetic verse (Paatturuva Kathai)"}, "explanation": "'Kaathai' denotes a narrative story episode composed in classical poetic verse."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": "