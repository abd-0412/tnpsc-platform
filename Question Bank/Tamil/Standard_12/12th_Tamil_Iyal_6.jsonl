{"id": "12th_tamil_u6_q1086", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nadigar_thilagam", "chapter_id": null, "topic_id": "kattabomman_famous_dialogue", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "“வரி, வட்டி, திறை, கிஸ்தி... எங்களோடு வயலுக்கு வந்தாயா? ஏற்றம் இறைத்தாயா?” - என்று சிவாஜி முழங்கிய உலகப் புகழ்பெற்ற வசனம் இடம்பெற்ற படம் எது?", "media_id": null}], "options": {"A": "கர்ணன்", "B": "வீரபாண்டிய கட்டபொம்மன்", "C": "மனோகரா", "D": "சிவகங்கைச் சீமை"}, "explanation": "வீரபாண்டிய கட்டபொம்மன் திரைப்படத்தில் ஆங்கிலேயத் தளபதி ஜாக்சன் துரையை நோக்கி சிவாஜி கணேசன் கர்ஜித்த இவ்வசனம் தமிழ்த் திரையுலகின் வரலாற்று முத்திரையாகும்."}, "en": {"blocks": [{"type": "text", "content": "In which historical epic does Sivaji roar the immortal defiance 'Vari, Vatti, Thirai, Kisthi... Did you sow our fields? Did you lift water?'?", "media_id": null}], "options": {"A": "Karnan", "B": "Veerapandiya Kattabomman", "C": "Manohara", "D": "Sivagangai Seemai"}, "explanation": "Sivaji delivered this legendary confrontation against British Collector Jackson in 'Veerapandiya Kattabomman'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year"