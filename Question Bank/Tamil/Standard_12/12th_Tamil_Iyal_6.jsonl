{"id": "12th_tamil_u6_q1005", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thiraimozhi", "chapter_id": null, "topic_id": "persistence_of_vision", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திரைப்படத்தில் வினாடிக்கு 24 படங்கள் நகரும்போது மனிதக் கண் அதனைத் தொடர்ச்சியான அசைவாக உணர்வதற்குக் காரணமான அறிவியல் விதி எது?", "media_id": null}], "options": {"A": "பார்வை நீடிப்பு விதி (Persistence of Vision)", "B": "ஒளி விலகல் விதி", "C": "ஒளி எதிரொளிப்பு விதி", "D": "நியூட்டனின் மூன்றாம் விதி"}, "explanation": "கண்ணின் விழித்திரையில் ஒரு பிம்பம் மறைந்த பிறகும் ஒரு நொடியில் பத்தில் ஒரு பங்கு நேரம் அப்பார்வை நீடிப்பதே (Persistence of vision) அசையும் படங்களைத் தொடர் அசைவாகக் காட்டுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which optical physiological principle allows the human brain to perceive 24 sequential still frames per second as continuous motion?", "media_id": null}], "options": {"A": "Persistence of Vision (Paarvai Neerippu Vithi)", "B": "Optical refraction", "C": "Optical reflection", "D": "Newton's third law"}, "explanation": "Persistence of Vision enables the illusion of continuous cinematic motion from rapidly alternating stills."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Tex