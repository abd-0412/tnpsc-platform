{"id": "12th_tamil_u6_q1009", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nakulan_kavithaigal", "chapter_id": null, "topic_id": "author_nakulan_name", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘நகுலன்’ என்னும் புனைப்பெயரில் நவீனக் கவிதைகளை எழுதிய கவிஞரின் இயற்பெயர் யாது?", "media_id": null}], "options": {"A": "டி.கே. துரைசுவாமி", "B": "சி. பழனிச்சாமி", "C": "ராசகோபாலன்", "D": "மாணிக்கவாசகம்"}, "explanation": "நகுலன் என்ற புனைப்பெயரில் எழுதிய நவீனக் கவிஞரின் இயற்பெயர் டி.கே. துரைசுவாமி என்பதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What was the original given birth name of modern avant-garde poet who wrote under the pseudonym 'Nakulan'?", "media_id": null}], "options": {"A": "T.K. Doraiswamy", "B": "C. Palanisamy", "C": "Rasagopalan", "D": "Manickavasagam"}, "explanation": "Nakulan was the literary pseudonym of acclaimed modern Tamil writer T.K. Doraiswamy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 135, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 135", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": fal