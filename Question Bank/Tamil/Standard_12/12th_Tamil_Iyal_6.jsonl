{"id": "12th_tamil_u6_q1065", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nadigar_thilagam", "chapter_id": null, "topic_id": "original_name", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘நடிகர் திலகம்’ என்று போற்றப்படும் சிவாஜி கணேசனின் இயற்பெயர் யாது?", "media_id": null}], "options": {"A": "வி.சி. கணேசன் (விழுப்புரம் சின்னையா கணேசன்)", "B": "ராசகோபாலன்", "C": "சுப்பிரமணியன்", "D": "துரைராசு"}, "explanation": "சிவாஜி கணேசனின் இயற்பெயர் விழுப்புரம் சின்னையா மன்றாயர் கணேசன் (வி.சி. கணேசன்) என்பதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What was the original given birth name of the iconic thespian 'Nadigar Thilagam' Sivaji Ganesan?", "media_id": null}], "options": {"A": "V.C. Ganesan (Villupuram Chinnaiya Ganesan)", "B": "Rasagopalan", "C": "Subramanian", "D": "Durairasu"}, "explanation": "Sivaji Ganesan's given birth name was Villupuram Chinnaiya Ganesan (V.C. Ganesan)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 140, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 140", "url": null, "source_notes": null}, "previous_year": {"is_previous_