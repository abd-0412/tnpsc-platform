{"id": "12th_tamil_u6_q1104", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "veguli_four_causes", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வெகுளி’ (கோபம் / சினம்) தோன்றுவதற்குரிய நான்கு காரணங்கள் எவை?", "media_id": null}], "options": {"A": "கல்வி, தறுகண், இசைமை, கொடை", "B": "அணங்கு, விலங்கு, கள்வர், இறை", "C": "மூப்பு, பிணி, வருத்தம், மென்மை", "D": "உறுப்பறை, குடிகோள், அலை (அலைக்கழித்தல்), கொலை"}, "explanation": "‘உறுப்பறை குடிகோள் அலையே கொலையென, வெறுத்த வெகுளி நான்கென்ப’ - உடலின் உறுப்புகளைச் சிதைத்தல், குடும்பத்தைக் கெடுத்தல், அலைக்கழித்துத் துன்புறுத்தல், கொன்றுவிடுதல் ஆகிய நான்கால் தீராத கோபம் (வெகுளி) உண்டாகும்."}, "en": {"blocks": [{"type": "text", "content": "What four brutal provocations ignite the destructive sentiment of 'Veguli' (Wrath / Fury) in human nature?", "media_id": null}], "options": {"A": "Education, courage, renown, and charity", "B": "Spirits, beasts, thieves, and monarchs", "C": "Old age, sickness, sorrow, and frailty", "D": "Urupparai (Mutilation of limbs), Kudikol (Destruction of lineage/household), Alai (Cruel harassment), and Kolai (Murder)"}, "explanation": "Veguli is provoked by Urupparai (mutilation), Kudikol (lineage destruction), Alai (torment), and Kolai (slaughter)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 144, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 144", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Grammar", "Veguli Triggers"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1105", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "uvagai_four_causes", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உவகை’ (மகிழ்ச்சி / பேரின்பம்) தோன்றுவதற்குரிய நான்கு நிலைகள் எவை?", "media_id": null}], "options": {"A": "செல்வம், புலன், புணர்வு, விளையாட்டு", "B": "புதுமை, பெருமை, சிறுமை, ஆக்கம்", "C": "கல்வி, தறுகண், இசைமை, கொடை", "D": "இழிவு, இழவு, அசைவு, வறுமை"}, "explanation": "‘செல்வம் புலனே புணர்வே விளையாட்டென, அல்லல் நீத்த உவகை நான்கென்ப’ - செல்வ வளம், ஐம்புலன் நுகர்ச்சி, காதலர் சேர்க்கை (புணர்வு), இன்ப விளையாட்டு ஆகிய நான்கால் உவகை (மகிழ்ச்சி) பிறக்கும்."}, "en": {"blocks": [{"type": "text", "content": "What four joyous circumstances evoke the sublime sentiment of 'Uvagai' (Joy / Ecstasy / Delight)?", "media_id": null}], "options": {"A": "Selvam (Prosperity), Pulan (Sensory gratification), Punarvu (Erotic union of lovers), and Vilaiyaattu (Playful recreation)", "B": "Novelty, vastness, littleness, and growth", "C": "Learning, bravery, glory, and munificence", "D": "Humiliation, bereavement, debility, and penury"}, "explanation": "Uvagai springs from Selvam (wealth), Pulan (sensory enjoyment), Punarvu (amorous union), and Vilaiyaattu (sport)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type"