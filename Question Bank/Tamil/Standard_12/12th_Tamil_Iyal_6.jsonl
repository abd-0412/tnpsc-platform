{"id": "12th_tamil_u6_q1141", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thirukkural_part2", "chapter_id": null, "topic_id": "thirukkural_enpathathaal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘எண்பதத்தால் எய்தல் எளிதென்ப யார்மாட்டும், பண்புடைமை என்னும் வழக்கு’ - இதில் 'எண்பதம்' என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "யாவரிடமும் எளிமையாக அணுகக்கூடிய சுபாவம் (எளிமை)", "B": "எண்பது ஆண்டுகள்", "C": "எட்டு வழிகள்", "D": "பதப்படுத்தப்பட்ட உணவு"}, "explanation": "‘எண்பதம்’ என்பது பிறர் தன்னை எளிதில் அணுகக்கூடிய எளிய இனிய குணத்தைக் குறிக்கும். எளிமையாகப் பழகும் தன்மையால் பண்புடைமை எளிதில் கைகூடும்."}, "en": {"blocks": [{"type": "text", "content": "What is the meaning of 'Enpatham' in the verse 'Enpathaththaal eithal elithenba yaarmaattum panpudaimai ennum vazhakku'?", "media_id": null}], "options": {"A": "Gentle approachability / Amiable, unpretentious demeanor", "B": "Eighty years", "C": "Eight paths", "D": "Preserved food"}, "explanation": "'Enpatham' denotes gentle approachability and affability."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 148, "cha