{"id": "12th_tamil_u6_q1030", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "saanthikkoothu_four_types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகார உரையாசிரியர்கள் குறிப்பிடும் ‘சாந்திக்கூத்து’ எத்தனை வகைப்படும்?", "media_id": null}], "options": {"A": "இரண்டு", "B": "நான்கு (சொக்கம், மெய்க்கூத்து, அவிநயக்கூத்து, நாடகக்கூத்து)", "C": "ஆறு", "D": "எட்டு"}, "explanation": "சாந்திக்கூத்து சொக்கம், மெய்க்கூத்து, அவிநயம், நாடகம் என நான்கு வகைப்படும் என அடியார்க்குநல்லார் விளக்குகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Into how many sub-genres is the refined courtly 'Saanthikkoothu' classified by epic commentators?", "media_id": null}], "options": {"A": "Two", "B": "Four (Chokkam, Meikkoothu, Avinayakkoothu, Naadagakkoothu)", "C": "Six", "D": "Eight"}, "explanation": "Saanthikkoothu comprises Chokkam (pure dance), Meikkoothu, Avinayam, and Naadagam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 136, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 136", "url": null, "source