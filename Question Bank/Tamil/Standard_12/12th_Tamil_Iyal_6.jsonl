{"id": "12th_tamil_u6_q1012", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nakulan_kavithaigal", "chapter_id": null, "topic_id": "iruppathu_sila_thodargal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘இருப்பது சில தொடர்கள், இடையில் சில தசாப்தங்கள்...’ என்று மனித வாழ்வின் நிலையாமையையும் சுருக்கத்தையும் பாடியவர் யார்?", "media_id": null}], "options": {"A": "கண்ணதாசன்", "B": "வாலி", "C": "மீரா", "D": "நகுலன்"}, "explanation": "மனித வாழ்வின் கணநேர இருப்பையும் காலக் கடப்பையும் மிகக் கூர்மையாக நகுலன் தம் கவிதையில் இவ்வாறு பதிவு செய்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who penned the reflective existential lines 'Iruppathu sila thodargal, idaiyil sila thasaabthangal...'?", "media_id": null}], "options": {"A": "Kannadasan", "B": "Vaali", "C": "Meera", "D": "Nakulan"}, "explanation": "Nakulan penned this existential modern poem on transient life."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 135, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 135", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam