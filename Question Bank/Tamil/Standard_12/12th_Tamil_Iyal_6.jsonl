{"id": "12th_tamil_u6_q1114", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "manimekalai_azhugai_example", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கோவலன் கொலையுண்ட செய்தி கேட்டு கண்ணகி நிலத்தில் விழுந்து கதறி அழுத காட்சி எந்த மெய்ப்பாட்டிற்குச் சிறந்த எடுத்துக்காட்டு?", "media_id": null}], "options": {"A": "வெகுளி மட்டும்", "B": "அழுகை (துன்ப மெய்ப்பாடு)", "C": "மருட்கை", "D": "நகை"}, "explanation": "கணவனை அநியாயமாக இழந்த கண்ணகியின் தீராத பெருந்துயரம் 'அழுகை' என்னும் மெய்ப்பாட்டிற்கு இலக்கியச் சான்றாகத் திகழ்கிறது."}, "en": {"blocks": [{"type": "text", "content": "Kannagi collapsing onto the earth weeping upon hearing of Kovalan's wrongful execution exemplifies which sentiment?", "media_id": null}], "options": {"A": "Wrath alone", "B": "Azhugai (Pathos / Sorrow)", "C": "Marutkai", "D": "Nagai"}, "explanation": "Kannagi's heart-rending lamentation embodies the aesthetic sentiment of Azhugai (pathos)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 144, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 14