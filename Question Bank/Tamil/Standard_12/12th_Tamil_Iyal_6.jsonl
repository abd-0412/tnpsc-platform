{"id": "12th_tamil_u6_q1047", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "kovalan_buys_garland", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாதவியின் மாலையை 1008 கழஞ்சு பொன் கொடுத்து வாங்கி அவளுடன் வாழத் தொடங்கியவர் யார்?", "media_id": null}], "options": {"A": "மாசாத்துவான்", "B": "மாநாயக்கன்", "C": "கோவலன்", "D": "சேரன் செங்குட்டுவன்"}, "explanation": "கண்ணகியின் கணவனான வணிகர் குலச் செல்வன் கோவலன் அம்மாலையை வாங்கி மாதவியின் அழகில் மயங்கி அவளோடு இணைந்தான்."}, "en": {"blocks": [{"type": "text", "content": "Who purchased the royal garland for 1,008 Kalanju of gold and united with maiden Madhavi?", "media_id": null}], "options": {"A": "Maasaaththuvaan", "B": "Maanaayakkan", "C": "Kovalan", "D": "Cheran Senguttuvan"}, "explanation": "Kovalan paid the 1,008 Kalanju of gold and entered Madhavi's household."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 138", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exa