{"id": "12th_tamil_u6_q1045", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "chola_king_reward", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாதவியின் நாட்டிய அரங்கேற்றத்தைக் கண்டு மகிழ்ந்த சோழ மன்னன் அவளுக்குப் பரிசாக வழங்கியது எது?", "media_id": null}], "options": {"A": "பச்சை மாலை மற்றும் தலைக்கோல் பட்டம் (மற்றும் 1008 கழஞ்சு பொன்)", "B": "அரண்மனை மாளிகை", "C": "நாட்டின் ஒரு பகுதி", "D": "யானைப் படை"}, "explanation": "மாதவியின் ஆடலைக் கண்டு வியந்த சோழ மன்னன் அவளுக்குத் 'தலைக்கோலரிவை' என்னும் பட்டத்தையும், பச்சை மாலையோடு 1008 கழஞ்சு பொன்னையும் பரிசளித்தான்."}, "en": {"blocks": [{"type": "text", "content": "What royal honors and prizes did the Chola monarch bestow upon Madhavi following her peerless premiere?", "media_id": null}], "options": {"A": "Emerald garland, the title 'Thalaikkol Arivai', and 1,008 Kalanju of pure gold", "B": "A royal palace", "C": "A province of the realm", "D": "An elephant cavalry"}, "explanation": "The Chola king honored Madhavi with the Thalaikkol title, an emerald garland, and 1,008 Kalanju of gold."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class"