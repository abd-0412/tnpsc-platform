{"id": "12th_tamil_u6_q1010", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nakulan_kavithaigal", "chapter_id": null, "topic_id": "nakulan_residence", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் நகுலன் தம் வாழ்நாளின் பெரும் பகுதியை எந்த ஊரில் கழித்து இலக்கியப் பணியாற்றினார்?", "media_id": null}], "options": {"A": "மதுரை", "B": "திருவனந்தபுரம் (கேரளா)", "C": "சென்னை", "D": "திருநெல்வேலி"}, "explanation": "நகுலன் கேரள மாநிலத் தலைநகரான திருவனந்தபுரத்தில் வாழ்ந்து ஆங்கிலப் பேராசிரியராகப் பணியாற்றியவாறே தமிழிலும் ஆங்கிலத்திலும் இலக்கியப் படைப்புகளை உருவாக்கினார்."}, "en": {"blocks": [{"type": "text", "content": "In which city did modern Tamil poet Nakulan reside for most of his life working as a professor of English?", "media_id": null}], "options": {"A": "Madurai", "B": "Thiruvananthapuram (Kerala)", "C": "Chennai", "D": "Tirunelveli"}, "explanation": "Nakulan lived in Thiruvananthapuram, serving as an English professor and literary pioneer."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 135, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 135", "u