{"id": "12th_tamil_u6_q1075", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nadigar_thilagam", "chapter_id": null, "topic_id": "voc_historical_role", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கப்பலோட்டிய தமிழன்’ திரைப்படத்தில் வ.உ. சிதம்பரனாராக சிவாஜி நடித்த நடிப்பைப் பார்த்து, “வ.உ.சி-யை நேரில் பார்த்திராத நாங்கள் சிவாஜியின் முகத்தில்தான் அவரைக் காண்கிறோம்” என்று பாராட்டிய தலைவர் யார்?", "media_id": null}], "options": {"A": "நேரு", "B": "அண்ணா", "C": "மூதறிஞர் ராஜாஜி (சி. ராஜகோபாலாச்சாரி)", "D": "காமராசர்"}, "explanation": "வ.உ.சி-யோடு இணைந்து விடுதலைப் போராட்டத்தில் ஈடுபட்ட மூதறிஞர் ராஜாஜி, சிவாஜியின் தத்ரூப நடிப்பைக் கண்டு வியந்து பாராட்டினார்."}, "en": {"blocks": [{"type": "text", "content": "Which statesman remarked that posterity would see V.O. Chidambaram Pillai through Sivaji's embodiment in 'Kappalottiya Thamizhan'?", "media_id": null}], "options": {"A": "Jawaharlal Nehru", "B": "C.N. Annadurai", "C": "Mootharignar Rajaji (C. Rajagopalachari)", "D": "Kamarajar"}, "explanation": "Rajaji commended Sivaji stating that future generations would visualize V.O.C. only through Sivaji's portrayal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 141", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Supplementary", "Rajaji Commendation"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
