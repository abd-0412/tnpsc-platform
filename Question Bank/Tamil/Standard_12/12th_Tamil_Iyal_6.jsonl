{"id": "12th_tamil_u6_q1103", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "perumitham_four_causes", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பெருமிதம்’ (வீரம் / பெருமை) தோன்றுவதற்குரிய நான்கு களங்கள் எவை?", "media_id": null}], "options": {"A": "செல்வம், புலன், புணர்வு, விளையாட்டு", "B": "புதுமை, பெருமை, சிறுமை, ஆக்கம்", "C": "கல்வி, தறுகண் (வீரம்), இசைமை (புகழ்), கொடை (ஈகை)", "D": "எள்ளல், இளமை, பேதைமை, மடன்"}, "explanation": "‘கல்வி தறுகண் இசைமை கொடையெனச், சொல்லப்பட்ட பெருமிதம் நான்கென்ப’ - கல்வியறிவு, அஞ்சாமை (வீரம்), உலகப் புகழ், வாரி வழங்கும் கொடை ஆகிய நான்கால் பெருமிதம் (வீரவுணர்வு) தோன்றும்."}, "en": {"blocks": [{"type": "text", "content": "Which four exalted virtues induce the heroic sentiment of 'Perumitham' (Valour / Magnificence / Dignity)?", "media_id": null}], "options": {"A": "Wealth, sensory pleasures, union, and games", "B": "Novelty, vastness, minuteness, and growth", "C": "Kalvi (Learning), Tharukan (Courage/Heroism), Isaimai (Renown/Glory), and Kodai (Magnanimous charity)", "D": "Derision, youth, foolishness, and gullibility"}, "explanation": "Perumitham arises from Kalvi (erudition), Tharukan (courage), Isaimai (fame), and Kodai (bounteous charity)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": 