{"id": "12th_tamil_u6_q1121", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thirukkural_part2", "chapter_id": null, "topic_id": "uzhavu_superiority", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சுழன்றும்ஏர்ப் பின்னது உலகம் அதனால், உழந்தும் உழவே தலை’ - இக்குறள் உணர்த்தும் முதன்மைக் கருத்து யாது?", "media_id": null}], "options": {"A": "உலகம் பல தொழில்களைச் செய்து சுழன்றாலும் ஏர்த்தொழிலின் பின்னாலேயே நிற்கிறது; அதனால் உழவே முதன்மையான தொழில்", "B": "வணிகமே சிறந்தது", "C": "அரசுப் பணியே மேலானது", "D": "நெசவுத் தொழில் சிறந்தது"}, "explanation": "உலகத்தார் பல்வேறு தொழில்களால் சுழன்று வாழ்ந்தாலும் உணவிற்காக உழவுத் தொழிலையே சார்ந்துள்ளனர்; எனவே வருந்தி உழைத்தாலும் உழவுத் தொழிலே தலைசிறந்தது என்கிறார் வள்ளுவர்."}, "en": {"blocks": [{"type": "text", "content": "What primary universal truth is asserted in the Kural 'Suzhandrum aerp pinnathu ulagam athanaal, uzhanthum uzhavae thalai'?", "media_id": null}], "options": {"A": "Though the world revolves around manifold vocations, it fundamentally trails behind the plough; hence agriculture is supreme", "B": "Commerce is foremost", "C": "State bureaucracy is superior", "D": "Weaving is the best trade"}, "explanation": "Valluvar establishes that all vocations ultimately depend on agriculture for sustenance."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 147, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 147", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Thirukkural", "Uzhavu"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1122", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thirukkural_part2", "chapter_id": null, "topic_id": "uzhuthundu_vaazhvaar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உழுதுண்டு வாழ்வாரே வாழ்வார்மற் றெல்லாம், தொழுதுண்டு பின்செல்ப வர்’ - இக்குறளின்படி உண்மையான தற்சார்பு வாழ்க்கை வாழ்பவர்கள் யார்?", "media_id": null}], "options": {"A": "வணிகர்கள்", "B": "உழவு செய்து அதனால் கிடைத்த உணவை உண்டு வாழ்பவர்களே", "C": "அரசர்கள்", "D": "படைவீரர்கள்"}, "explanation": "பிறரை எதிர்பார்க்காமல் தாமே உழுது உணவு உற்பத்தி செய்து வாழ்பவர்களே சுயமரியாதையோடு வாழ்பவர்கள்; மற்றவர்கள் எல்லாரும் அவர்களைத் தொழுது பின்செல்பவர்கள் என்கிறார் வள்ளுவர்."}, "en": {"blocks": [{"type": "text", "content": "According to the verse 'Uzhuthundu vaazhvaarae vaazhvaarmat rellaam...', who alone leads an authentically independent, self-respecting life?", "media_id": null}], "options": {"A": "Merchants", "B": "Those who till the soil and subsist upon their own agricultural produce", "C": "Monarchs", "D": "Soldiers"}, "explanation": "Farmers who till the soil lead truly sovereign, independent lives while others serve them for food."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 147, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 147", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Thirukkural", "True Independence"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1123", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thirukkural_part2", "chapter_id": null, "topic_id": "thodippuzhuthi_kafsa", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தொடிப்புழுதி கஃசா உணக்கின் பிடித்தெருவும் வேண்டாது சாலப் படும்’ - இக்குறளில் வரும் 'கஃசு' என்னும் சொல்லின் பொருள் யாது?", "media_id": null}], "options": {"A": "ஒரு படி அளவு", "B": "ஒரு மரக்கால்", "C": "கால் பலம் (பண்டைய எடையளவு)", "D": "ஒரு பலம்"}, "explanation": "‘தொடி’ என்பது ஒரு பலம் (நான்கு கஃசு); ‘கஃசு’ என்பது கால் பலம் ஆகும். ஒரு பலம் புழுதி கால் பலமாக உலரும்படி நிலத்தை நன்கு உழுதால் உரம் கூட இடாமல் பயிர் செழிக்கும் என்பதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What does the classical ancient weight measure 'Kafsu' signify in the agricultural Kural 'Thodippuzhuthi kafsa unakkin...'?", "media_id": null}], "options": {"A": "One Padi measure", "B": "One Marakkal volume", "C": "Quarter palam (Kaa-palam / One-fourth of a palam)", "D": "One full palam"}, "explanation": "'Thodi' denotes one palam; 'Kafsu' signifies a quarter palam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 147, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 147", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Thirukkural", "Kafsu Measurement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1124", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thirukkural_part2", "chapter_id": null, "topic_id": "sellaan_kizhavan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘செல்லான் கிழவன் இருப்பின் நிலம்புலந்து, இல்லாளின் ஊடி விடும்’ - இக்குறளில் நிலம் யாரைப் போலப் பிணங்கிக் கொள்ளும் என்று கூறப்படுகிறது?", "media_id": null}], "options": {"A": "பகைவரைப் போல", "B": "அரசனைப் போல", "C": "குழந்தையைப் போல", "D": "கணவன் வராமல் புறக்கணித்தால் கோபித்துக் கொள்ளும் மனையாளைப் (மனைவியைப்) போல"}, "explanation": "நிலத்திற்குரிய உழவன் தினந்தோறும் தன் நிலத்திற்குச் சென்று பராமரிக்காவிட்டால், கணவன் தன்னைக் கவனிக்காத போது பிணங்கும் மனைவியைப் போல நிலம் கோபித்து விளைச்சலைத் தராது."}, "en": {"blocks": [{"type": "text", "content": "In the Kural 'Sellaan kizhavan iruppin...', like whom does untended agricultural land sulk and refuse bounty?", "media_id": null}], "options": {"A": "Like a bitter enemy", "B": "Like a despotic ruler", "C": "Like an unruly child", "D": "Like a neglected wife who sulks when ignored by her husband"}, "explanation": "Land neglected by its owner sulks like a spurned wife refusing affection."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 147, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 147", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Thirukkural", "Neglected Land"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1125", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thirukkural_part2", "chapter_id": null, "topic_id": "panpudaimai_ulagam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பண்புடையார் பட்டுண்டு உலகம் அதுஇன்றேல், மண்புக்கு மாய்வது மன்’ - இக்குறளின்படி இவ்வுலகம் அழியாமல் நிலைத்து நிற்பதற்கு யார் காரணம்?", "media_id": null}], "options": {"A": "நற்பண்புகள் உடைய சான்றோர்கள்", "B": "செல்வந்தர்கள்", "C": "படைபலம் கொண்ட மன்னர்கள்", "D": "விஞ்ஞானிகள்"}, "explanation": "பிறரை மதித்துப் பண்போடு வாழும் சான்றோர்கள் இருப்பதால்தான் இவ்வுலகம் இன்னும் இயங்குகிறது; இல்லையெனில் உலகம் மண்ணோடு மண்ணாகிப் புதைந்து அழிந்திருக்கும் என்கிறார் வள்ளுவர்."}, "en": {"blocks": [{"type": "text", "content": "According to the verse 'Panpudaiyaar pattundu ulagam...', on whose presence does the civilized continuity of the world depend?", "media_id": null}], "options": {"A": "Cultured men of virtuous character and noble fellowship", "B": "Billionaire plutocrats", "C": "Mighty conquerors", "D": "Technological scientists"}, "explanation": "The world continues to exist only because of noble, cultured individuals of virtue."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 148, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 148", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Thirukkural", "Panpudaimai"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1126", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thirukkural_part2", "chapter_id": null, "topic_id": "arambolum_koormai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அரம்போலும் கூர்மைய ரேனும் மரம்போல்வர், மக்கட்பண்பு இல்லாத வர்’ - இக்குறளில் இடம்பெற்றுள்ள அணி எது?", "media_id": null}], "options": {"A": "வேற்றுமையணி", "B": "உவமையணி (மரம் போல்வர்)", "C": "சொற்பொருள் பின்வருநிலையணி", "D": "வஞ்சப்புகழ்ச்சியணி"}, "explanation": "அரத்தைப்போலக் கூர்மையான கூரிய அறிவுடையவராக இருந்தாலும், மனிதப் பண்பு இல்லாதவர்கள் உயிரற்ற மரத்திற்கு ஒப்பாவார்கள் என்று உவமித்ததால் இது 'உவமையணி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which rhetorical figure of speech (Ani) adorns the Kural 'Arambolum koormaiya renum marambolvar makkadpanpu illaatha var'?", "media_id": null}], "options": {"A": "Vaetrumai Ani", "B": "Uvamai Ani (Simile - 'Maram polvar')", "C": "Sorporul Pinvarunilai Ani", "D": "Vanjippugazhchi Ani"}, "explanation": "It employs Uvamai Ani: those without human empathy are compared to inanimate wood despite a razor-sharp intellect."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 148, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 148", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Thirukkural", "Uvamai Ani"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1127", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thirukkural_part2", "chapter_id": null, "topic_id": "arivatraankakkum_karuvi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அறிவற்றங் காக்கும் கருவி செறுவார்க்கும், உள்ளழிக்க லாகா அரண்’ - இக்குறளின்படி ஒருவனுக்கு இறுதிவரை அழிவு வராமல் காக்கும் அரண் எது?", "media_id": null}], "options": {"A": "படைபலம்", "B": "கோட்டைச் சுவர்", "C": "அறிவுடைமை (மெய்யறிவு)", "D": "செல்வ வளம்"}, "explanation": "அறிவு என்பது ஒருவனுக்கு அழிவு நேராமல் காக்கும் சிறந்த கருவியாகும்; பகைவராலும் அழிக்க முடியாத உட்புக முடியாத பாதுகாப்பு அரணாகும் என்கிறார் வள்ளுவர்."}, "en": {"blocks": [{"type": "text", "content": "According to the verse 'Arivatrang kaakkum karuvi...', what serves as the impregnable inner fortress protecting a person from ruin?", "media_id": null}], "options": {"A": "Military armaments", "B": "Granite citadel walls", "C": "Wisdom / Intellect (Arivudaimai)", "D": "Vast material treasure"}, "explanation": "Wisdom is an inner weapon defending against ruin and an impregnable armor against adversaries."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 148, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 148", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Thirukkural", "Arivudaimai"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1128", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thirukkural_part2", "chapter_id": null, "topic_id": "epporul_yaaryaarvaai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘எப்பொருள் யார்யார்வாய்க் கேட்பினும் அப்பொருள், மெய்ப்பொருள் காண்பது அறிவு’ - இக்குறள் உணர்த்தும் மெய்ஞ்ஞான நெறி யாது?", "media_id": null}], "options": {"A": "யார் சொல்வதையும் நம்புவது", "B": "அனைவரிடமும் தர்க்கம் செய்வது", "C": "பேச்சைக் கேட்காமல் இருப்பது", "D": "எந்த ஒரு கருத்தை யார் சொல்லக் கேட்டாலும், அதன் உண்மைத் தன்மையை ஆராய்ந்து அறிவதே அறிவுடைமை"}, "explanation": "சொல்பவரின் நிலை பார்க்காமல், சொல்லப்பட்ட செய்தியில் உள்ள உண்மைப் பொருளைத் தெளிவாக ஆய்ந்து அறிவதே உண்மையான அறிவுடைமையாகும்."}, "en": {"blocks": [{"type": "text", "content": "What intellectual principle is enjoined by 'Epporul yaaryaarvaaik kaetpinum apporul meipporul kaanbathu arivu'?", "media_id": null}], "options": {"A": "Believing everything naively", "B": "Arguing belligerently with all", "C": "Refusing to listen to anyone", "D": "Discerning the underlying truth in any matter regardless of who utters it"}, "explanation": "True intellect lies in discerning the authentic objective truth regardless of the speaker's status."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 148, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 148", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Thirukkural", "Discerning Truth"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1129", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thirukkural_part2", "chapter_id": null, "topic_id": "udukkai_izhanthavan_kai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உடுக்கை இழந்தவன் கைபோல ஆங்கே, இடுக்கண் களைவதாம் நட்பு’ - இக்குறளில் பயின்று வந்துள்ள உலகப் புகழ்பெற்ற உவமை எது?", "media_id": null}], "options": {"A": "ஆடை நெகிழ்ந்தவுடன் கை தானாகவே சென்று மானம் காப்பது போன்ற உவமை", "B": "தாயின் அன்பு போன்ற உவமை", "C": "மழையின் குளிர்ச்சி போன்ற உவமை", "D": "நிழல் போன்ற உவமை"}, "explanation": "உடல் ஆடை நழுவும் போது கை எந்தவித யோசனையும் இன்றி உடனடியாகச் சென்று மானம் காப்பது போல, நண்பனுக்குத் துன்பம் வந்த கணமே சென்று உதவுவதே நட்பு."}, "en": {"blocks": [{"type": "text", "content": "Which timeless simile is employed in 'Udukkai izhanthavan kaipola aangkae idukkan kalaivathaam natpu'?", "media_id": null}], "options": {"A": "Like the instantaneous reflex of the hand catching slipping garments to preserve modesty", "B": "Like maternal tenderness", "C": "Like cooling rain", "D": "Like a soothing shadow"}, "explanation": "True friendship acts instantaneously like the reflexive hand clutching a slipping garment."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 149, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 149", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Thirukkural", "Modesty Simile"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1130", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thirukkural_part2", "chapter_id": null, "topic_id": "navilthorum_noolnayam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘நவில்தொறும் நூல்நயம் போலும் பயில்தொறும், பண்புடை யாளர் தொடர்பு’ - இக்குறளில் இடம்பெற்றுள்ள அணி யாது?", "media_id": null}], "options": {"A": "வேற்றுமையணி", "B": "எடுத்துக்காட்டு உவமையணி / உவமையணி (போலும்)", "C": "சொற்பொருள் பின்வருநிலையணி", "D": "வஞ்சப்புகழ்ச்சியணி"}, "explanation": "நல்ல நூல்களை மீண்டும் மீண்டும் படிக்கும்போது இன்பம் பெருகுவது போல, பண்புடையாரின் நட்பு பழகப் பழக இன்பம் தரும் என உவம உருபு (போலும்) வெளிப்பட்டு வந்ததால் இது 'உவமையணி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which rhetorical figure of speech governs 'Navilthorum noolnayam polum payilthorum panpudai yaalar thodarpu'?", "media_id": null}], "options": {"A": "Vaetrumai Ani", "B": "Uvamai Ani (Simile - overtly featuring 'Polum')", "C": "Sorporul Pinvarunilai Ani", "D": "Vanjippugazhchi Ani"}, "explanation": "Uvamai Ani compares deepening friendship to re-reading profound books."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 149, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 149", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Thirukkural", "Navilthorum Uvamai"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1131", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thirukkural_part2", "chapter_id": null, "topic_id": "theenatpu_seeridam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சீரிடங் காணின் எறிதற்குப் பட்டடை, நேரா நிரந்தவர் நட்பு’ - இக்குறளில் போலி நண்பர்களின் பண்பு எதனுடன் ஒப்பிடப்படுகிறது?", "media_id": null}], "options": {"A": "கூர்மையான வாள்", "B": "நச்சுப் பாம்பு", "C": "கொல்லனின் பட்டடைக்கல் (சமயம் வரும் வரை அமைதியாக இருந்து சமயம் வாய்த்ததும் தாக்கும் இரும்புப் பட்டடை)", "D": "பழைய மரம்"}, "explanation": "மனதில் பொருந்தாமல் முகத்தளவில் பழகும் போலி நண்பர்கள், தக்க சமயம் வரும்வரை அமைதியாகக் காத்திருந்து பழிதீர்க்கும் கொல்லனின் பட்டடை போன்றவர்கள் என்கிறார் வள்ளுவர்."}, "en": {"blocks": [{"type": "text", "content": "In the Kural 'Seeridang kaanin eritharkup pattadai...', to what is the deceitful friendship of hypocrites analogized?", "media_id": null}], "options": {"A": "Razor-sharp rapier", "B": "Venomous viper", "C": "The blacksmith's anvil block (waiting patiently until the iron is positioned to strike the killing blow)", "D": "Withered timber"}, "explanation": "False friends bide their time like a blacksmith's anvil until the opportune moment arrives to strike."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 149, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 149", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Thirukkural", "Anvil Metaphor"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
