{"id": "12th_tamil_u6_q1031", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "yaazh_anatomy_components", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைய தமிழ் இசைக் கருவியான யாழின் முதன்மை உறுப்புகளாகச் சிலப்பதிகாரம் காட்டுபவை எவை?", "media_id": null}], "options": {"A": "குழல், வளை, துளை", "B": "தோல், தளை, கயிறு", "C": "பத்தர், கோடு, திவவு, நரம்பு, உந்தகம்", "D": "முழவு, கழல், மணி"}, "explanation": "யாழின் உறுப்புகள் பத்தர் (உடற்பகுதி), கோடு (தண்டு), திவவு (நரம்புக் கட்டு), நரம்பு, உந்தகம் ஆகியவை ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which anatomical components comprise the structural frame of the ancient Tamil Yaazh lute?", "media_id": null}], "options": {"A": "Flute, reed, and stop", "B": "Hide, strap, and cord", "C": "Paththar (Resonator), Kodu (Neck), Thivavu (Pegs), Narambu (Strings), and Unthagam", "D": "Mridangam and Bell"}, "explanation": "The Yaazh consists of Paththar (resonator body), Kodu (neck), Thivavu (tuning pegs), and Narambu (chords)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 1