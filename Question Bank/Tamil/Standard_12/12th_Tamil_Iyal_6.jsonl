{"id": "12th_tamil_u6_q1082", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nadigar_thilagam", "chapter_id": null, "topic_id": "parathiyar_first_dialogue", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பராசக்தி’ திரைப்படத்தில் சிவாஜி பேசிய முதல் வசனம் எது?", "media_id": null}], "options": {"A": "நீதிமன்றக் கூண்டில் பேசிய நீண்ட உரை", "B": "“வெற்றி வடிவேலன் சந்நிதியில்...” என்று தொடங்கும் வசனம்", "C": "“வாழ்க தமிழ்நாடு!”", "D": "“எங்கள் ஊர் விழுப்புரம்...”"}, "explanation": "பராசக்தி படத்தில் தன் தங்கை கல்யாணியைத் தேடித் தாயகம் திரும்பிய குணசேகரனாகச் சிவாஜி பேசும் முதல் வசனம் 'வெற்றி வடிவேலன் சந்நிதியில்...' என்பதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What was the immortal opening dialogue spoken by Sivaji Ganesan on screen in his debut 'Parasakthi'?", "media_id": null}], "options": {"A": "The climatic courtroom monologue", "B": "'Vetri Vadivelan sannithiyil...' (At the sanctum of victorious Vadivelan...)", "C": "'Long live Tamil Nadu!'", "D": "'My hometown is Villupuram...'"}, "explanation": "Sivaji's first screen lines began with 'Vetri Vadivelan sannithiyil...'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term