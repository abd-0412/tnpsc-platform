{"id": "12th_tamil_u6_q1081", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nadigar_thilagam", "chapter_id": null, "topic_id": "padma_awards", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மத்திய அரசால் சிவாஜி கணேசனுக்கு ‘பத்மஸ்ரீ’ மற்றும் ‘பத்மபூஷண்’ விருதுகள் எந்தெந்த ஆண்டுகளில் வழங்கப்பட்டன?", "media_id": null}], "options": {"A": "1966 மற்றும் 1984", "B": "1950 மற்றும் 1960", "C": "1970 மற்றும் 1980", "D": "1990 மற்றும் 2000"}, "explanation": "சிவாஜி கணேசனுக்கு 1966-இல் பத்மஸ்ரீ விருதும், 1984-இல் பத்மபூஷண் விருதும் இந்திய அரசால் வழங்கி கௌரவிக்கப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "In which years was Sivaji Ganesan decorated with the Padma Shri and Padma Bhushan civilian honors respectively?", "media_id": null}], "options": {"A": "1966 and 1984", "B": "1950 and 1960", "C": "1970 and 1980", "D": "1990 and 2000"}, "explanation": "Sivaji was awarded the Padma Shri in 1966 and the Padma Bhushan in 1984."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 141", "url": null, "source_notes