{"id": "12th_tamil_u6_q1139", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "unit6_exercises", "chapter_id": null, "topic_id": "glossary_climax", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திரைக்கதையின் முடிவில் கதையின் திருப்பமும் முடிவும் நிகழும் ‘Climax’ என்பதன் தமிழாக்கம் எது?", "media_id": null}], "options": {"A": "தொடக்கக் காட்சி", "B": "இடைவேளை", "C": "உச்சக்கட்டம் (நிறைவுக் காட்சி)", "D": "பின்னணிக் காட்சி"}, "explanation": "‘Climax’ என்பது நாடகம் அல்லது திரைப்படத்தின் முடிவில் உணர்ச்சிகளும் கதையும் உச்சியை அடையும் ‘உச்சக்கட்டம்’ ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the Tamil equivalent for the narrative turning point 'Climax'?", "media_id": null}], "options": {"A": "Opening prologue", "B": "Intermission", "C": "Uchchakkattam (Climax / Dramatic peak)", "D": "Backstory"}, "explanation": "'Climax' translates directly to 'Uchchakkattam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 150, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 150", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": fals