{"id": "12th_tamil_u6_q1015", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "madhavi_natya_training_years", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாதவி தனது எத்தனையாவது வயதில் நாட்டியப் பயிற்சியைத் தொடங்கி, எத்தனை ஆண்டுகள் பயின்று அரங்கேற்றினாள்?", "media_id": null}], "options": {"A": "ஐந்தாம் வயதில் தொடங்கி, பத்து ஆண்டுகள்", "B": "பத்தாம் வயதில் தொடங்கி, இரண்டு ஆண்டுகள்", "C": "ஏழாம் வயதில் தொடங்கி, ஏழு ஆண்டுகள் பயின்று பன்னிரண்டாம் வயதில் அரங்கேற்றினாள்", "D": "எட்டாம் வயதில் தொடங்கி, நான்கு ஆண்டுகள்"}, "explanation": "‘ஈரேழ் ஆண்டு அகவை மாதவி’ - மாதவி தன் ஏழாம் வயதில் ஆடல் கற்கத் தொடங்கி, ஏழு ஆண்டுகள் தீவிரமாகப் பயின்று 12-ஆம் வயதில் சோழன் அவையில் அரங்கேற்றினாள்."}, "en": {"blocks": [{"type": "text", "content": "At what age did maiden Madhavi commence her classical dance training, and at what age did she perform her royal debut?", "media_id": null}], "options": {"A": "Commenced at 5, trained for 10 years", "B": "Commenced at 10, trained for 2 years", "C": "Commenced at age 7, trained rigorously for 7 years, debuting at age 12", "D": "Commenced at age 8, trained for 4 years"}, "explanation": "Madhavi commenced training at age 7, trained for 7 years, and performed her royal debut at age 12."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multipl