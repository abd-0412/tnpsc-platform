{"id": "12th_tamil_u6_q1032", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "four_types_of_yaazh", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைய தமிழகத்தில் நரம்புகளின் எண்ணிக்கைக்கு ஏற்ப அமைந்த நால்வகை யாழ்களுள் 21 நரம்புகளைக் கொண்டது எது?", "media_id": null}], "options": {"A": "செங்கோட்டியாழ் (7 நரம்புகள்)", "B": "சகோடயாழ் (14 நரம்புகள்)", "C": "மகரயாழ் (19 நரம்புகள்)", "D": "பேரியாழ் (21 நரம்புகள்)"}, "explanation": "பேரியாழ் 21 நரம்புகளையும், மகரயாழ் 19 நரம்புகளையும், சகோடயாழ் 14 நரம்புகளையும், செங்கோட்டியாழ் 7 நரம்புகளையும் கொண்டவை."}, "en": {"blocks": [{"type": "text", "content": "Among the four ancient Tamil lutes classified by string count, which lute uniquely boasted 21 strings?", "media_id": null}], "options": {"A": "Sengottiyaazh (7 strings)", "B": "Sagodayaazh (14 strings)", "C": "Makarayaazh (19 strings)", "D": "Periyaazh (21 strings)"}, "explanation": "Periyaazh was the grand concert harp equipped with 21 melodic strings."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": n