{"id": "12th_tamil_u6_q1011", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nakulan_kavithaigal", "chapter_id": null, "topic_id": "nakulan_works_list", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மூன்று ஐந்து’, ‘கண்ணாடி முக்கோணம்’, ‘வாக்குமூலம்’, ‘சுருதி’ ஆகிய படைப்புகளை இயற்றியவர் யார்?", "media_id": null}], "options": {"A": "சி. மணி", "B": "சுரதா", "C": "நகுலன் (டி.கே. துரைசுவாமி)", "D": "ஞானக்கூத்தன்"}, "explanation": "இப்படைப்புகள் நவீனத்துவத்தின் முன்னோடியான நகுலன் எழுதிய புகழ்பெற்ற நாவல்கள் மற்றும் கவிதைத் தொகுப்புகளாகும்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the landmark modernist works 'Moondru Ainthu', 'Kannaadi Mukkonam', 'Vaakkumoolam', and 'Suruthi'?", "media_id": null}], "options": {"A": "C. Mani", "B": "Suradha", "C": "Nakulan (T.K. Doraiswamy)", "D": "Gnanakoothan"}, "explanation": "Modernist trailblazer Nakulan authored these acclaimed collections and experimental novels."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 135, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 135", "url": null, "source_notes": null