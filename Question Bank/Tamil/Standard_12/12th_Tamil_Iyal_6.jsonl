{"id": "12th_tamil_u6_q1098", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "nagai_four_causes", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘நகையே’ (சிரிப்பு / நகைச்சுவை) தோன்றுவதற்குக் காரணமான நான்கு பொருட்கள் எவை?", "media_id": null}], "options": {"A": "இழிவு, இழவு, அசைவு, வறுமை", "B": "எள்ளல், இளமை, பேதைமை, மடன்", "C": "புதுமை, பெருமை, சிறுமை, ஆக்கம்", "D": "அணங்கு, விலங்கு, கள்வர், இறை"}, "explanation": "‘எள்ளல் இளமை பேதைமை மடனென்று, உள்ளப்பட்ட நகைநான் கென்ப’ - இகழ்ச்சி (எள்ளல்), அறியாமை (இளமை), அறிவின்மை (பேதைமை), மடமை (மடன்) ஆகியவற்றால் நகை தோன்றும்."}, "en": {"blocks": [{"type": "text", "content": "What four catalytic triggers stimulate the emotional sentiment of 'Nagai' (Laughter / Mockery) in Tolkappiyam?", "media_id": null}], "options": {"A": "Degradation, loss, debility, and poverty", "B": "Ellal (Derision/Mockery), Ilamai (Youthful ignorance), Pethaimai (Foolishness), and Madan (Simplicity)", "C": "Novelty, grandeur, minuteness, and prosperity", "D": "Deities, wild beasts, thieves, and monarchs"}, "explanation": "Nagai arises from Ellal (ridicule), Ilamai (childishness), Pethaimai (folly), and Madan (credulity)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 144, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 144", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Grammar", "Nagai Triggers"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1099", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "azhugai_four_causes", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அழுகை’ (துன்பம் / இரக்கம்) தோன்றுவதற்குரிய நான்கு காரணங்கள் எவை?", "media_id": null}], "options": {"A": "எள்ளல், இளமை, பேதைமை, மடன்", "B": "கல்வி, தறுகண், இசைமை, கொடை", "C": "இழிவு, இழவு, அசைவு, வறுமை", "D": "உறுப்பறை, குடிகோள், அலை, கொலை"}, "explanation": "‘இழிவே இழவே அசைவே வறுமையென, பொழிந்த அழுகை நான் கென்ப’ - பிறரால் இழிவுபடுத்தப்படுதல், உறவை இழத்தல், தளர்ச்சி, வறுமை ஆகியவற்றால் அழுகை தோன்றும்."}, "en": {"blocks": [{"type": "text", "content": "Which four poignant factors induce the sentiment of 'Azhugai' (Pathos / Weeping) according to Tolkappiyam?", "media_id": null}], "options": {"A": "Mockery, youth, foolishness, and simplicity", "B": "Learning, bravery, renown, and charity", "C": "Izhivu (Degradation/Humiliation), Izhavu (Bereavement/Loss), Asaivu (Infirmity/Physical distress), and Varumai (Poverty)", "D": "Mutilation, plunder, torment, and murder"}, "explanation": "Azhugai is triggered by Izhivu (humiliation), Izhavu (bereavement), Asaivu (debility), and Varumai (poverty)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 144, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 144", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Grammar", "Azhugai Triggers"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1100", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "ilivaral_four_causes", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘இளிவரல்’ (அருவருப்பு / தாழ்வு மனப்பான்மை) தோன்றுவதற்குரிய நான்கு களங்கள் எவை?", "media_id": null}], "options": {"A": "செல்வம், புலன், புணர்வு, விளையாட்டு", "B": "அணங்கு, விலங்கு, கள்வர், இறை", "C": "புதுமை, பெருமை, சிறுமை, ஆக்கம்", "D": "மூப்பு, பிணி, வருத்தம், மென்மை"}, "explanation": "‘மூப்பே பிணியே வருத்தமென மென்மையோடு, யாத்த இளிவரல் நான்கென்ப’ - முதிய முதுமை, கொடிய நோய், தாங்கவொணா வருத்தம், ஆற்றலின்மை (மென்மை) ஆகியவற்றால் இளிவரல் தோன்றும்."}, "en": {"blocks": [{"type": "text", "content": "What four debilitating conditions trigger the rasa of 'Ilivaral' (Disgust / Self-contempt / Abjection)?", "media_id": null}], "options": {"A": "Wealth, senses, union, and play", "B": "Spirits, beasts, robbers, and rulers", "C": "Novelty, greatness, littleness, and growth", "D": "Mooppu (Extreme senility/old age), Pini (Disease), Varuththam (Suffering), and Menmai (Helpless vulnerability)"}, "explanation": "Ilivaral arises from Mooppu (decrepitude), Pini (disease), Varuththam (exhaustion), and Menmai (frailty)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 144, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 144", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Grammar", "Ilivaral Triggers"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1101", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "marutkai_four_causes", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மருட்கை’ (வியப்பு / ஆச்சரியம்) தோன்றுவதற்குரிய நான்கு காரணங்கள் எவை?", "media_id": null}], "options": {"A": "புதுமை, பெருமை, சிறுமை, ஆக்கம்", "B": "கல்வி, தறுகண், இசைமை, கொடை", "C": "எள்ளல், இளமை, பேதைமை, மடன்", "D": "மூப்பு, பிணி, வருத்தம், மென்மை"}, "explanation": "‘புதுமை பெருமை சிறுமை ஆக்கமொடு, மதித்த மருட்கை நான்கென்ப’ - இதுவரை காணாத புதிய பொருள் (புதுமை), பிரம்மாண்ட வடிவம் (பெருமை), மிக நுண்ணிய வடிவம் (சிறுமை), பெரும் வளர்ச்சி (ஆக்கம்) ஆகியவற்றால் மருட்கை (வியப்பு) உண்டாகும்."}, "en": {"blocks": [{"type": "text", "content": "What four cognitive triggers arouse the sentiment of 'Marutkai' (Wonder / Astonishment) in classical poetics?", "media_id": null}], "options": {"A": "Puthumai (Novelty), Perumai (Immensity), Sirumai (Microscopic minuteness), and Aakkam (Miraculous growth/transformation)", "B": "Erudition, valor, fame, and philanthropy", "C": "Mockery, youth, folly, and naivety", "D": "Senility, disease, weariness, and weakness"}, "explanation": "Marutkai is evoked by Puthumai (novelty), Perumai (vastness), Sirumai (infinitesimal smallness), and Aakkam (metamorphosis)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 144, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 144", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Grammar", "Marutkai Triggers"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1102", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "achcham_four_causes", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அச்சம்’ (பயம்) தோன்றுவதற்குரிய நான்கு தோற்றுவாய்கள் எவை?", "media_id": null}], "options": {"A": "மூப்பு, பிணி, வருத்தம், மென்மை", "B": "அணங்கு, விலங்கு, கள்வர், தம் இறை (அரசன்)", "C": "இழிவு, இழவு, அசைவு, வறுமை", "D": "உறுப்பறை, குடிகோள், அலை, கொலை"}, "explanation": "‘அணங்கே விலங்கே கள்வரே இறைஎனப், பிணங்கிய அச்சம் நான்கென்ப’ - பேய் தெய்வம் போன்ற தெய்வீக ஆற்றல் (அணங்கு), கொடிய விலங்கு, திருடர் (கள்வர்), கொடுங்கோல் அரசன் (இறை) ஆகியவற்றால் அச்சம் உண்டாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which four existential perils generate the emotion of 'Achcham' (Fear / Dread) in Tolkappiyam?", "media_id": null}], "options": {"A": "Old age, sickness, grief, and frailty", "B": "Anangu (Supernatural deity/spirits), Vilangu (Predatory wild beasts), Kalvar (Robbers/Bandits), and Irai (Formidable ruler/despot)", "C": "Humiliation, loss, debility, and penury", "D": "Mutilation, extortive tyranny, oppression, and murder"}, "explanation": "Achcham is aroused by Anangu (spirits), Vilangu (beasts), Kalvar (robbers), and Irai (despotic sovereigns)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": 