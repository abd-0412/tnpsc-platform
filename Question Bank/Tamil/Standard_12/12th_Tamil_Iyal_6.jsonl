{"id": "12th_tamil_u6_q993", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thiraimozhi", "chapter_id": null, "topic_id": "chaplin_satire_dictator", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இட்லரின் பாசிச கொடுங்கோன்மையை நகைச்சுவையோடு துணிச்சலாக அம்பலப்படுத்திய சாப்ளினின் புகழ்பெற்ற திரைப்படம் எது?", "media_id": null}], "options": {"A": "தி கிரேட் டிக்டேட்டர் (The Great Dictator - 1940)", "B": "தி கோல்ட் ரஷ்", "C": "மாடர்ன் டைம்ஸ்", "D": "தி சர்க்கஸ்"}, "explanation": "1940-இல் சாப்ளின் இயக்கி நடித்த 'தி கிரேட் டிக்டேட்டர்' படம், இட்லரின் பாசிச கொடுங்கோன்மையை நையாண்டி செய்து உலக அமைதியை வலியுறுத்தியது."}, "en": {"blocks": [{"type": "text", "content": "Which 1940 classic political satire boldly parodied Adolf Hitler's fascist regime and preached global humanism?", "media_id": null}], "options": {"A": "The Great Dictator (1940)", "B": "The Gold Rush", "C": "Modern Times", "D": "The Circus"}, "explanation": "Chaplin satirized Hitler and totalitarianism in his masterpiece 'The Great Dictator' (1940)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 133, "chapter": null, "section":