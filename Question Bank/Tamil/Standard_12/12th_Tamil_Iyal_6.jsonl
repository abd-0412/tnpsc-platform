{"id": "12th_tamil_u6_q1074", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nadigar_thilagam", "chapter_id": null, "topic_id": "thillana_mohanambal_role", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தில்லானா மோகனாம்பாள்’ திரைப்படத்தில் சிவாஜி கணேசன் ஏற்ற புகழ்பெற்ற நாதஸ்வரக் கலைஞர் பாத்திரம் எது?", "media_id": null}], "options": {"A": "வீரபாண்டியன்", "B": "சிக்கல் சண்முகசுந்தரம் (நாதசுவர வித்துவான்)", "C": "பத்மநாபன்", "D": "கர்ணன்"}, "explanation": "தில்லானா மோகனாம்பாள் படத்தில் 'சிக்கல் சண்முகசுந்தரம்' என்னும் நாதஸ்வரக் கலைஞராகத் தன் விரல் மற்றும் உதட்டசைவுகளால் அசல் கலைஞராகவே வாழ்ந்து காட்டினார்."}, "en": {"blocks": [{"type": "text", "content": "Which legendary Nadhaswaram maestro character did Sivaji Ganesan immortalize in the classic 'Thillana Mohanambal'?", "media_id": null}], "options": {"A": "Veerapandiyan", "B": "Sikkal Shanmugasundaram (Nadhaswaram Vidwan)", "C": "Padmanabhan", "D": "Karnan"}, "explanation": "Sivaji portrayed Nadhaswaram virtuoso Sikkal Shanmugasundaram in 'Thillana Mohanambal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": null, "