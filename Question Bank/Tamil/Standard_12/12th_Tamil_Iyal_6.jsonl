{"id": "12th_tamil_u6_q1083", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nadigar_thilagam", "chapter_id": null, "topic_id": "early_drama_troupe", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிவாஜி கணேசன் சிறுவயதில் இணைந்து நடிப்புப் பயிற்சி பெற்ற நாடக சபா எது?", "media_id": null}], "options": {"A": "டி.கே.எஸ். நாடக சபா", "B": "மனோகரா சபா", "C": "யதார்த்தம் பொன்னுசாமி பிள்ளை நாடக சபா (மற்றும் சக்தி நாடக சபா)", "D": "பால விநோத சபா"}, "explanation": "சிவாஜி தம்முடைய ஒன்பதாவது வயதில் 'யதார்த்தம் பொன்னுசாமி பிள்ளை நாடக சபா'வில் இணைந்து வேடங்கள் ஏற்று நாடகக் கலையைக் கற்றார்."}, "en": {"blocks": [{"type": "text", "content": "Which professional theater troupe did Sivaji Ganesan join at age nine to train in the dramatic arts?", "media_id": null}], "options": {"A": "T.K.S. Nataka Sabha", "B": "Manohara Sabha", "C": "Yathaartham Ponnusamy Pillai Nataka Sabha (and Sakthi Nataka Sabha)", "D": "Bala Vinodha Sabha"}, "explanation": "Sivaji ran away at age nine to join Yathartham Ponnusamy Pillai's professional drama company."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 140, "chapter": null