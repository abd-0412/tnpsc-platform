{"id": "12th_tamil_u6_q1026", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "two_types_of_koothu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆடலாசான் அறிந்திருக்க வேண்டிய இருவகைக் கூத்துகள் எவை?", "media_id": null}], "options": {"A": "ஆண் கூத்து, பெண் கூத்து", "B": "வசைக்கூத்து, புகழ்க்கூத்து (அல்லது வரிக்கூத்து, வரிசாந்திக்கூத்து / சாந்திக்கூத்து, வினோதக்கூத்து)", "C": "பகற்கூத்து, இராக்கூத்து", "D": "கிராமக்கூத்து, நகரக்கூத்து"}, "explanation": "சிலப்பதிகார உரையாசிரியர்கள் வேத்தியல், பொதுவியல் எனவும்; சாந்திக்கூத்து, வினோதக்கூத்து எனவும் இருவகைக் கூத்துகளை விவரித்துள்ளனர்."}, "en": {"blocks": [{"type": "text", "content": "Which dual classical theatrical dance genres was the Dance Master required to master?", "media_id": null}], "options": {"A": "Male dance and Female dance", "B": "Vethiyal (Royal courtly / Saanthi) and Pothuviyal (Popular folk / Vinodha)", "C": "Daytime and Nighttime performance", "D": "Rural and Urban drama"}, "explanation": "The dance master mastered the elite court style (Vethiyal / Saanthi) and popular folk style (Pothuviyal / Vinodha)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Se