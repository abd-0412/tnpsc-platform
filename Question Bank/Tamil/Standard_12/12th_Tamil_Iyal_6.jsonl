{"id": "12th_tamil_u6_q1048", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "aadarangu_vilakku_system", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆடரங்கில் பார்வையாளர்களுக்குக் கண் கூசாமலும், தூண்களின் நிழல் மேடையில் விழாமலும் வைக்கப்பட்ட விளக்குகள் எவை?", "media_id": null}], "options": {"A": "மின்விளக்குகள்", "B": "பந்தங்கள் மட்டும்", "C": "கண்ணாடி விளக்குகள்", "D": "நிழல் விழாதவாறு நுட்பமாகப் பொருத்தப்பட்ட நிலா விளக்குகள் (அகலிடம் விளக்கும் அணி விளக்குகள்)"}, "explanation": "மேடையில் தூண்களின் நிழல் ஆடலின் மீது விழாதவாறும், பார்வையாளர்களின் கண்களைக் கூசச் செய்யாதவாறும் அமைக்கப்பட்ட அழகிய விளக்குகள் பற்றிச் சிலப்பதிகாரம் கூறுகிறது."}, "en": {"blocks": [{"type": "text", "content": "How were performance oil lamps engineered in the classical theater according to Silappathikaram?", "media_id": null}], "options": {"A": "Electric bulbs", "B": "Torches only", "C": "Glass lanterns", "D": "Shadowless stage lamps positioned so pillar shadows never fell on the stage and light never blinded spectators"}, "explanation": "Lamps were engineered to eliminate shadows across the performance floor and prevent glare."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher":