{"id": "12th_tamil_u6_q985", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thiraimozhi", "chapter_id": null, "topic_id": "camera_angles_eye_level", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மனிதனின் இயல்பான பார்வை உயரத்திலிருந்து காட்சியைப் படம்பிடிக்கும் கோணம் எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "கண் மட்டக் கோணம் (Eye-level shot)", "B": "உயர் கோணம் (High-angle shot)", "C": "தாழ் கோணம் (Low-angle shot)", "D": "பறவைக் கோணம் (Bird's-eye view)"}, "explanation": "மனிதன் தன் கண்களால் எதிரே இருக்கும் காட்சியை நேராகப் பார்ப்பது போன்ற கோணம் 'கண் மட்டக் கோணம்' (Eye-level shot) எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What camera shot angle records the scene directly at the natural eye height of a human observer?", "media_id": null}], "options": {"A": "Eye-level shot (Kanmatta Kaanam)", "B": "High-angle shot", "C": "Low-angle shot", "D": "Bird's-eye view"}, "explanation": "An Eye-level shot simulates neutral, real-world human perspective."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 133, "chapter": null, "section": null, "reference":