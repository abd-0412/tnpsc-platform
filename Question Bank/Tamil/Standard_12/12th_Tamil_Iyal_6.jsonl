{"id": "12th_tamil_u6_q1113", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "purananooru_perumitham_example", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஈன்று புறந்தருதல் என் தலைக்கடனே... வாளோhandle... வீசிப் போர்க்களம் புகுதல் இளைஞர்க்குத் தலைக்கடனே’ - பொன்முடியாரின் இப்பாடலில் விளங்கும் மெய்ப்பாடு எது?", "media_id": null}], "options": {"A": "பெருமிதம் (வீரம்)", "B": "அழுகை", "C": "அச்சம்", "D": "மருட்கை"}, "explanation": "மன்னனுக்கும் தாய்க்கும் இளைஞனுக்கும் உரிய கடமைகளை விளக்கிப் போர்க்கள வீரத்தை உயர்த்திப் பாடுவதால் இது 'பெருமிதம்' (வீர மெய்ப்பாடு) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which cardinal sentiment radiates through the Sangam warrior-mother verse 'Iandru purantharuthal en thalaikkadanae...' by Ponmudiyar?", "media_id": null}], "options": {"A": "Perumitham (Heroic Pride / Valour)", "B": "Azhugai", "C": "Achcham", "D": "Marutkai"}, "explanation": "The poem breathes martial fortitude and heroic pride (Perumitham)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 144, "chapter": null, "section": nu