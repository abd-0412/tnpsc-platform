{"id": "12th_tamil_u6_q1064", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "first_printed_silambu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரத்தை முதன்முதலில் ஏட்டுச் சுவடியிலிருந்து அச்சு வடிவில் பதிப்பித்து வெளியிட்டவர் யார்?", "media_id": null}], "options": {"A": "சி.வை. தாமோதரம்பிள்ளை", "B": "மறைமலையடிகள்", "C": "திரு. வி. க.", "D": "தமிழ்த்தாத்தா உ.வே. சாமிநாதையர் (1892)"}, "explanation": "உ.வே. சாமிநாதையர் அவர்கள் ஏட்டுச் சுவடிகளை ஆய்ந்து 1892-ஆம் ஆண்டு சிலப்பதிகாரத்தை அரும்பதவுரை மற்றும் அடியார்க்குநல்லார் உரையுடன் முதன்முதலில் பதிப்பித்து வெளியிட்டார்."}, "en": {"blocks": [{"type": "text", "content": "Who critically collated palm-leaf manuscripts and published the first printed edition of Silappathikaram in 1892?", "media_id": null}], "options": {"A": "C.W. Damodaram Pillai", "B": "Maraimalai Adigal", "C": "Thiru. Vi. Ka.", "D": "U.V. Swaminatha Iyer (1892)"}, "explanation": "U.V. Swaminatha Iyer published the first print edition of Silappathikaram in 1892."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "p