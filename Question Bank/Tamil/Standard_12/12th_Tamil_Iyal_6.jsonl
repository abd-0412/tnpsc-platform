{"id": "12th_tamil_u6_q991", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thiraimozhi", "chapter_id": null, "topic_id": "sound_in_cinema_1927", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உலகத் திரைப்பட வரலாற்றில் பேசும் படங்கள் (Talkies) எந்த ஆண்டு அறிமுகமாகின?", "media_id": null}], "options": {"A": "1895", "B": "1910", "C": "1927 (தி ஜாஸ் சிங்கர் - The Jazz Singer)", "D": "1940"}, "explanation": "1927-ஆம் ஆண்டு வெளியான 'தி ஜாஸ் சிங்கர்' (The Jazz Singer) திரைப்படத்தின் மூலம் பேசும் படங்கள் அறிமுகமாகி மௌனப் படங்களின் சகாப்தம் முடிவுக்கு வந்தது."}, "en": {"blocks": [{"type": "text", "content": "In which milestone year did synchronized sound revolutionize cinema with the release of 'The Jazz Singer'?", "media_id": null}], "options": {"A": "1895", "B": "1910", "C": "1927 (The Jazz Singer)", "D": "1940"}, "explanation": "Synchronized dialogue and musical soundtrack arrived in 1927 with Warner Bros' 'The Jazz Singer'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 132, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 132", "url": null, "source_notes": nul