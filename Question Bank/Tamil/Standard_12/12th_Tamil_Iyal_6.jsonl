{"id": "12th_tamil_u6_q1085", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nadigar_thilagam", "chapter_id": null, "topic_id": "rajya_sabha_mp", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிவாஜி கணேசன் இந்திய நாடாளுமன்றத்தின் எந்த அவைக்கு நியமன உறுப்பினராக (எம்.பி.) நியமிக்கப்பட்டார்?", "media_id": null}], "options": {"A": "மாநிலங்களவை (ராஜ்யசபா - 1982 முதல் 1988 வரை)", "B": "மக்களவை (லோக்சபா)", "C": "சட்டமன்ற மேலவை", "D": "சட்டமன்றம்"}, "explanation": "சிவாஜி கணேசன் தம் கலைச்சேவைக்காக 1982-இல் குடியரசுத் தலைவரால் மாநிலங்களவை (Rajya Sabha) நியமன உறுப்பினராகத் தேர்ந்தெடுக்கப்பட்டார்."}, "en": {"blocks": [{"type": "text", "content": "To which house of the Indian Parliament was Sivaji Ganesan nominated as an honorary Member of Parliament in 1982?", "media_id": null}], "options": {"A": "Rajya Sabha (Council of States - 1982 to 1988)", "B": "Lok Sabha", "C": "Legislative Council", "D": "Legislative Assembly"}, "explanation": "Sivaji was nominated to the Rajya Sabha from 1982 to 1988 for his eminent contributions to the arts."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 141, "chapte