{"id": "12th_tamil_u6_q1097", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "total_manifestation_states", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எட்டு மெய்ப்பாடுகளுக்கும் தலா நான்கு காரணங்கள் (களங்கள்) வீதம் மொத்தம் எத்தனை மெய்ப்பாட்டு நிலைகள் தொல்காப்பியத்தில் வகுக்கப்பட்டுள்ளன?", "media_id": null}], "options": {"A": "முப்பத்திரண்டு நிலைகள் (8 × 4 = 32)", "B": "பதினாறு நிலைகள்", "C": "அறுபத்து நான்கு நிலைகள்", "D": "இருபத்து நான்கு நிலைகள்"}, "explanation": "எட்டு மெய்ப்பாடுகள் ஒவ்வொன்றிற்கும் நான்கு நான்கு தோற்றுவாய்கள் வகுக்கப்பட்டு மொத்தம் 8 × 4 = 32 களங்கள் விளக்கப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "With each of the eight primary rasas generated by four distinct psychological stimuli, how many total situational conditions are formulated?", "media_id": null}], "options": {"A": "Thirty-two situational states (8 × 4 = 32)", "B": "Sixteen states", "C": "Sixty-four states", "D": "Twenty-four states"}, "explanation": "Tolkappiyar delineates 32 distinct situational stimuli (8 primary rasas × 4 triggers each)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", 