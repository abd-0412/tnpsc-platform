{"id": "12th_tamil_u6_q981", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thiraimozhi", "chapter_id": null, "topic_id": "cinema_inventors_lumiere", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "1895-ஆம் ஆண்டு பாரிஸ் நகரில் முதன்முதலில் அசையும் படக்காட்சியைப் பொதுமக்களுக்குத் திரையிட்டுக் காட்டியவர்கள் யார்?", "media_id": null}], "options": {"A": "லூமியர் சகோதரர்கள் (Lumière Brothers)", "B": "தாமஸ் ஆல்வா எடிசன்", "C": "சார்லி சாப்ளின்", "D": "டி.டபிள்யூ. கிரிஃபித்"}, "explanation": "1895 டிசம்பர் 28 அன்று பிரான்சின் பாரிஸ் நகரில் லூமியர் சகோதரர்கள் முதன்முதலில் திரைப்படத் திரையிடலை நிகழ்த்தினர்."}, "en": {"blocks": [{"type": "text", "content": "Who famously projected the first commercial motion picture screening to a paying audience in Paris in 1895?", "media_id": null}], "options": {"A": "Lumière Brothers (Auguste and Louis Lumière)", "B": "Thomas Alva Edison", "C": "Charlie Chaplin", "D": "D.W. Griffith"}, "explanation": "The Lumière Brothers hosted the historic first public motion picture screening in Paris on December 28, 1895."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 132