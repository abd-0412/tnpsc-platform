{"id": "12th_tamil_u6_q1049", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "silambu_three_virtues", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரம் உணர்த்தும் முப்பெரும் உண்மைகள் எவை?", "media_id": null}], "options": {"A": "அரசியல் பிழைத்தோர்க்கு அறம் கூற்றாகும்; உரைசால் பத்தினியை உயர்ந்தோர் ஏத்துவர்; ஊழ்வினை உருத்துவந்து ஊட்டும்", "B": "அறம், பொருள், இன்பம்", "C": "கொல்லாமை, பொய்யாமை, புலால் மறுத்தல்", "D": "கல்வி, செல்வம், வீரம்"}, "explanation": "சிலப்பதிகாரப் பதிகத்தில் கூறப்படும் முப்பெரும் உண்மைகள்: 1. அரசியல் பிழைத்தோர்க்கு அறம் கூற்றாவதூஉம், 2. உரைசால் பத்தினியை உயர்ந்தோர் ஏத்தலும், 3. ஊழ்வினை உருத்துவந்து ஊட்டும் என்பதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What are the three cardinal ethical axioms proclaimed in the foundational prologue of Silappathikaram?", "media_id": null}], "options": {"A": "Dharma slays unrighteous kings; The virtuous chaste woman is venerated by the exalted; Karmic fate inexorably manifests to exact retribution", "B": "Virtue, wealth, and pleasure", "C": "Non-killing, truthfulness, and vegetarianism", "D": "Education, prosperity, and valor"}, "explanation": "The epic's 3 axioms: Dharma slays unjust rulers, the chaste chaste heroine is worshipped, and karma is inescapable."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 138", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Poetry", "Three Truths"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1050", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "muththamizh_kaappiyam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல், இசை, நாடகம் என்னும் முத்தமிழின் கூறுகளும் ஒருங்கே அமையப்பெற்ற முதல் தமிழ்க் காப்பியம் எது?", "media_id": null}], "options": {"A": "மணிமேகலை", "B": "சிலப்பதிகாரம் (முத்தமிழ்க் காப்பியம்)", "C": "சீவக சிந்தாமணி", "D": "குண்டலகேசி"}, "explanation": "சிலப்பதிகாரத்தில் உரைநடை (இயல்), தேவாரம் போன்ற இசைப்பாடல்கள் (இசை), நாட்டிய நாடகக் கூறுகள் (நாடகம்) மூன்றும் இணைந்திருப்பதால் இது 'முத்தமிழ்க் காப்பியம்' எனப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which epic is celebrated as Tamil literature's first composite 'Muththamizh Kaappiyam' synthesizing literature, music, and dramatic arts?", "media_id": null}], "options": {"A": "Manimekalai", "B": "Silappathikaram (Muththamizh Epic)", "C": "Seevaka Chinthamani", "D": "Kundalakesi"}, "explanation": "Silappathikaram synthesizes poetry (Iyal), music (Isai), and theater (Naadagam)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-202