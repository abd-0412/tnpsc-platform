{"id": "12th_tamil_u6_q1041", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "three_curtains_types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகார ஆடரங்கில் அமைக்கப்பட்ட மூன்று வகைத் திரைகள் எவை?", "media_id": null}], "options": {"A": "ஒருமுக எழினி, பொருமுக எழினி, கரந்துவரல் எழினி", "B": "முன் திரை, பின் திரை, பக்கத் திரை", "C": "வெண்திரை, கறுப்புத்திரை, செந்திரை", "D": "பட்டுத்திரை, பருத்தித்திரை, கம்பளித்திரை"}, "explanation": "நாட்டிய அரங்கில் மேடையின் ஒருபுறத்திலிருந்து மறுபுறம் இழுக்கும் 'ஒருமுக எழினி', இருபுறமிருந்தும் நடுவில் இணையும் 'பொருமுக எழினி', மேலிருந்து கீழ் இறங்கும் 'கரந்துவரல் எழினி' அமைக்கப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "What three mechanical theatrical stage curtains (Ezhini) adorned the Silappathikaram dance stage?", "media_id": null}], "options": {"A": "Orumuga Ezhini (Single-draw), Porumuga Ezhini (Split center-draw), and Karanthuvaral Ezhini (Drop curtain)", "B": "Front, rear, and side curtains", "C": "White, black, and red curtains", "D": "Silk, cotton, and wool drapes"}, "explanation": "The stage featured Orumuga Ezhini, Porumuga Ezhini, and Karanthuvaral Ezhini."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samachee