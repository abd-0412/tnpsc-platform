{"id": "12th_tamil_u6_q1109", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "tharukan_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெருமிதத்தின் தோற்றுவாய்களில் ஒன்றான ‘தறுகண்’ என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "அஞ்சாமை / பேராண்மை (வீரம்)", "B": "கண் பார்வை", "C": "கொடைத் தன்மை", "D": "கல்வி அறிவு"}, "explanation": "‘தறுகண்’ என்பது போர்க்களத்தில் எதிரிக்கு அஞ்சாது நின்று போராடும் பேராண்மையைக் (அஞ்சாமை / வீரம்) குறிக்கும் சொல்லாகும்."}, "en": {"blocks": [{"type": "text", "content": "What does the classical heroic term 'Tharukan' signify in the formulation of Heroic Pride (Perumitham)?", "media_id": null}], "options": {"A": "Dauntless physical courage / Unflinching bravery in battle", "B": "Sharp ocular vision", "C": "Charitable nature", "D": "Literary scholarship"}, "explanation": "'Tharukan' denotes unflinching, fearless martial fortitude."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 144, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 144", "url": null, "source_notes": n