{"id": "12th_tamil_u6_q982", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thiraimozhi", "chapter_id": null, "topic_id": "edison_kinetoscope", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒருவர் மட்டுமே கண்வைத்து அசையும் படங்களைப் பார்க்கும் ‘கினட்டோஸ்கோப்’ (Kinetoscope) கருவியைக் கண்டுபிடித்தவர் யார்?", "media_id": null}], "options": {"A": "கிரகாம் பெல்", "B": "தாமஸ் ஆல்வா எடிசன்", "C": "சார்லி சாப்ளின்", "D": "ஜார்ஜ் மெலியஸ்"}, "explanation": "அமெரிக்கக் கண்டுபிடிப்பாளர் தாமஸ் ஆல்வா எடிசன் 1891-இல் ஒரு நபர் மட்டும் பார்க்கும் 'கினட்டோஸ்கோப்' கருவியை உருவாக்கினார்."}, "en": {"blocks": [{"type": "text", "content": "Who invented the 'Kinetoscope' peep-hole viewer device allowing an individual to view moving images?", "media_id": null}], "options": {"A": "Alexander Graham Bell", "B": "Thomas Alva Edison", "C": "Charlie Chaplin", "D": "Georges Méliès"}, "explanation": "Thomas Alva Edison developed the Kinetoscope in 1891 for individual viewing of motion pictures."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 132, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Pa