{"id": "12th_tamil_u6_q1063", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "aadarangu_kole_measurement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆடரங்கு அமைப்பதற்குப் பயன்படுத்தப்பட்ட ‘கோல்’ என்பது யாருடைய கை விரல் அளவால் அளக்கப்பட்டது?", "media_id": null}], "options": {"A": "மன்னனின் கரம்", "B": "மாதவியின் விரல்", "C": "சிற்ப நூலறிந்தோனின் (நூலோர்) பெருவிரலில் இருபத்து நான்கு விரல் அளவு", "D": "ஆடலாசானின் விரல்"}, "explanation": "நூலோர் மரபின்படி பெருவிரலின் 24 விரல் அளவு கொண்ட நீளமே ஒரு 'கோல்' என அளவு கோலாகக் கொள்ளப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "How was the standard measurement unit 'Kole' calibrated when measuring the dance theater in Silappathikaram?", "media_id": null}], "options": {"A": "The king's hand span", "B": "Madhavi's index finger", "C": "Twenty-four finger widths measured according to the architect's thumb span (Peruviral)", "D": "The dance master's wrist"}, "explanation": "The measuring rod was calibrated as twenty-four finger breadths based on architectural treatises."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "