{"id": "12th_tamil_u1_q019", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamil_nadai_azhagiyal", "chapter_id": null, "topic_id": "semantic_density", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘செவ்விலக்கியக் கவிதைகள் குறைவான சொற்களில் அதிகப் பொருளைத் தருகின்றன’ - இதற்கு வழங்கப்படும் தமிழ்ச் சொல் எது?", "media_id": null}], "options": {"A": "சொல் விரயம்", "B": "சொல் அடுப்பு", "C": "செறிவான மொழிநடை (Economy of expression)", "D": "வெற்று நடை"}, "explanation": "குறைந்த சொற்களில் ஆழமான அகப் பொருளையும் புறப் பொருளையும் பொதிந்து வைப்பது செறிவான மொழிநடை எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What technical descriptor denotes the capacity to convey immense semantic depth with minimal words?", "media_id": null}], "options": {"A": "Sol Virayam", "B": "Sol Aduppu", "C": "Serivaana Mozhinadai (Economy of expression)", "D": "Vettru Nadai"}, "explanation": "Serivaana Mozhinadai captures the essence of classicism's semantic economy and density."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 3"