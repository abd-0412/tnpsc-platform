{"id": "12th_tamil_u1_q060", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "thanner_ilaatha_tamil", "chapter_id": null, "topic_id": "figure_of_speech", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஓங்கலிடை வந்து... தன்னேர் இலாத தமிழ்!’ - இப்பாடலில் பயின்றுவந்துள்ள அணி எது?", "media_id": null}], "options": {"A": "உவமை அணி", "B": "வேற்றுப்பொருள் வைப்பணி", "C": "தற்குறிப்பேற்ற அணி", "D": "பொருள் வேற்றுமை அணி"}, "explanation": "கதிரவனையும் தமிழையும் முதலில் ஒப்பிட்டு, பின்னர் கதிரவன் புற இருளை மட்டுமே போக்கும்; தமிழோ மக்களின் அறியாமை என்னும் அக இருளைப் போக்கி நிகரற்று விளங்கும் என வேறுபடுத்திக் காட்டியதால் இது 'பொருள் வேற்றுமை அணி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which figure of speech (Ani) is deployed in the verse 'Oongalidai vanthu... Thanneer ilaatha Tamil!'?", "media_id": null}], "options": {"A": "Uvamai Ani (Simile)", "B": "Vettruporul Vaippani", "C": "Tharkurippetra Ani", "D": "Porul Vetttrumai Ani (Contrastive Distributive figure)"}, "explanation": "Because it compares the sun and Tamil and then contrasts Tamil's unique dispelling of ignorance, it is Porul Vetttrumai Ani."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporatio