{"id": "12th_tamil_u1_q133", "schema_version": "1.0", "kind": "grammar_identification", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamizhaai_ezhuthuvom", "chapter_id": null, "topic_id": "valai_valhai_vazhai_triad", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வலை, வளை, வழை’ ஆகிய சொற்களின் சரியான பொருள் யாது?", "media_id": null}], "options": {"A": "வலை = மீன்பிடி வலை ; வளை = வளையல் / எலிவளை ; வழை = சுரபுன்னை மரம்", "B": "வலை = மரம் ; வளை = ஆடை ; வழை = நீர்", "C": "வலை = பாம்பு ; வளை = மீன் ; வழை = காற்று", "D": "வலை = நிலம் ; வளை = ஆகாயம் ; வழை = கடல்"}, "explanation": "வலை (மீன்வலை), வளை (கைவளையல்/எலியின் வளை), வழை (சங்க இலக்கியச் சுரபுன்னை மரம்)."}, "en": {"blocks": [{"type": "text", "content": "Match the meanings of the homophonic triad 'Valai' (லை), 'Valhai' (ளை), and 'Vazhai' (ழை):", "media_id": null}], "options": {"A": "Valai = Net ; Valhai = Bangle / Burrow ; Vazhai = Surapunna tree", "B": "Valai = Tree ; Valhai = Attire ; Vazhai = Water", "C": "Valai = Snake ; Valhai = Fish ; Vazhai = Wind", "D": "Valai = Earth ; Valhai = Sky ; Vazhai = Ocean"}, "explanation": "Valai signifies net; Valhai signifies bangle or animal burrow; Vazhai denotes the fragrant Surapunna tree."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educa