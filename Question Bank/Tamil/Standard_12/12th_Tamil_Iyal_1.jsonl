{"id": "12th_tamil_u1_q014", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamil_nadai_azhagiyal", "chapter_id": null, "topic_id": "madurai_kamaraj_prof", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி.சு. நடராசன் தமிழ்நாட்டில் எந்தப் பல்கலைக்கழகத்தில் பேராசிரியராகப் பணியாற்றி ஓய்வு பெற்றார்?", "media_id": null}], "options": {"A": "சென்னை பல்கலைக்கழகம்", "B": "மதுரை காமராசர் பல்கலைக்கழகம்", "C": "பாரதியார் பல்கலைக்கழகம்", "D": "அண்ணாமலைப் பல்கலைக்கழகம்"}, "explanation": "தி.சு. நடராசன் மதுரை காமராசர் பல்கலைக்கழகத்தின் தமிழியற்புலத்தில் பேராசிரியராகவும் தலைவராகவும் பணியாற்றி ஓய்வு பெற்றார்."}, "en": {"blocks": [{"type": "text", "content": "From which premier Tamil Nadu university did Prof. T. S. Natarajan retire as Professor and Head?", "media_id": null}], "options": {"A": "University of Madras", "B": "Madurai Kamaraj University", "C": "Bharathiar University", "D": "Annamalai University"}, "explanation": "He served as Senior Professor and Chair in the School of Tamil Studies at Madurai Kamaraj University."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 4, "chapter": null, "sect