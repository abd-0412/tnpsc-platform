{"id": "12th_tamil_u1_q099", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "thambi_nellaiyapparukku", "chapter_id": null, "topic_id": "fearlessness_quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘நினைப்பதெல்லாம் பெரிதாக நினை! அஞ்சுவது மானுடத்திற்கு அழகல்ல!’ - பாரதி கடிதத்தில் எதனை வலியுறுத்துகிறார்?", "media_id": null}], "options": {"A": "அமைதியாக இருத்தல்", "B": "விதியை நம்புதல்", "C": "அச்சமின்மையும் (Fearlessness) உயர்ந்த பெருநோக்கும் (High aspirations)", "D": "பிறரிடம் கடன் வாங்குதல்"}, "explanation": "இளைஞர்கள் எதற்கும் அஞ்சாமல் பாரதிதாசன் கூறியது போல 'அச்சமும் பேதைமையும் அடிமைச் சிறுமையும்' களைந்து உயர்ந்த நோக்கத்தோடு வாழ வேண்டும் எனப் பாரதி பணிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "What virtues are championed by Bharati in 'Aspire for greatness! Fear is unworthy of human dignity!'?", "media_id": null}], "options": {"A": "Silent withdrawal", "B": "Fatalism", "C": "Fearlessness and lofty, heroic aspirations", "D": "Borrowing from others"}, "explanation": "Bharati commands his young disciple to cultivate unflinching fearlessness and sublime vision."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "ter