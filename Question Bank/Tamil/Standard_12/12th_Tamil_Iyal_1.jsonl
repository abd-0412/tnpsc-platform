{"id": "12th_tamil_u1_q016", "schema_version": "1.0", "kind": "statement_analysis", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamil_nadai_azhagiyal", "chapter_id": null, "topic_id": "reader_participation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிதையில் வாசகனின் பங்கு குறித்து தி.சு. நடராசன் கூறும் கருத்து யாது?", "media_id": null}], "options": {"A": "வாசகன் வெறும் பார்வையாளன் மட்டுமே", "B": "கவிஞன் சொன்னதை மனனம் செய்வது மட்டுமே வாசகனின் வேலை", "C": "வாசகனுக்குக் கவிதையில் எந்தப் பங்கும் இல்லை", "D": "கவிதை தரும் குறிப்புப் பொருள்களைக் கொண்டு கவிதையைத் தனக்குள் மறுஉருவாக்கம் செய்யும் படைப்பாளியாக வாசகன் மாறுகிறான்"}, "explanation": "நவீன அழகியலின்படி வாசகன் செயலற்றவன் அல்லன்; கவிதையின் இடைவெளிகளைத் தன் கற்பனையால் நிரப்பி மறுஉருவாக்கம் செய்யும் இணைப்படைப்பாளி ஆவான்."}, "en": {"blocks": [{"type": "text", "content": "What role does Prof. T. S. Natarajan assign to the reader in aesthetic reception?", "media_id": null}], "options": {"A": "The reader is a passive consumer", "B": "The reader's sole duty is rote memorization", "C": "The reader has zero stake in poetic meaning", "D": "The reader transforms into an active co-creator, reconstructing layered connotations within consciousness"}, "explanation": "Reader-response stylistics views the reader as an active collaborator bridging textual lacunae."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_an