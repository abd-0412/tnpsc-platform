{"id": "12th_tamil_u1_q185", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tnpsc_pyq_integration", "chapter_id": null, "topic_id": "natarasan_criticism_core", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி.சு. நடராசன் அவர்களின் திறனாய்வு அணுகுமுறை எதனை முதன்மை மையமாகக் கொண்டது?", "media_id": null}], "options": {"A": "மொழியியல் மற்றும் அழகியல் சார்ந்த இலக்கியக் கட்டமைப்பு", "B": "மதக் கோட்பாடுகள்", "C": "வரலாற்றுப் புனைவுகள் மட்டும்", "D": "சோதிட சாஸ்திரம்"}, "explanation": "தி.சு. நடராசன் மொழியியல் வெளிப்பாட்டுக் கூறுகளையும் நவீன இலக்கிய அழகியலையும் இணைத்துத் திறனாய்வு செய்வதில் வல்லவர்."}, "en": {"blocks": [{"type": "text", "content": "What forms the foundational core of Professor T. S. Natarasan's critical literary approach?", "media_id": null}], "options": {"A": "Linguistic and stylistic aesthetic architecture of literature", "B": "Religious theological dogmas", "C": "Historical fiction alone", "D": "Astrological divination"}, "explanation": "Natarasan pioneers linguistic and aesthetic stylistics in modern Tamil literary criticism."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "p