{"id": "12th_tamil_u1_q097", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "thambi_nellaiyapparukku", "chapter_id": null, "topic_id": "letter_literature_genre", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கடித இலக்கியம்’ (Epistolary Literature) என்னும் இலக்கிய வகைமையில் தமிழின் முன்னோடிகளுள் ஒருவராகக் கருதப்படுபவர் யார்?", "media_id": null}], "options": {"A": "மகாகவி பாரதியார்", "B": "உ.வே.சா", "C": "வீரமாமுனிவர்", "D": "மறைமலையடிகள்"}, "explanation": "பாரதியாரின் கடிதங்கள் வெறும் தனிநபர் தொடர்புகள் அல்லாமல் சமூக விடுதலையும் இலக்கிய நடையும் கொண்ட சிறந்த கடித இலக்கிய ஆவணங்களாகத் திகழ்கின்றன."}, "en": {"blocks": [{"type": "text", "content": "Who stands as a foremost trailblazer of Tamil epistolary prose literature (Kaditha Ilakkiyam)?", "media_id": null}], "options": {"A": "Mahakavi Subramania Bharati", "B": "U. V. Swaminatha Iyer", "C": "Veeramamunivar", "D": "Maraimalai Adigal"}, "explanation": "Bharati's letters elevated private correspondence into an inspirational genre of social literature."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 9, "chapter": null, "section": null,