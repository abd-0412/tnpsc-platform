{"id": "12th_tamil_u1_q066", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "thanner_ilaatha_tamil", "chapter_id": null, "topic_id": "oongal_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஓங்கல்’ என்னும் சொல்லின் பொருள் யாது?", "media_id": null}], "options": {"A": "கடல்", "B": "மலை", "C": "வானம்", "D": "காற்று"}, "explanation": "‘ஓங்கல்’ என்பது உயர்ந்த ‘மலை’யைக் குறிக்கும். இப்பாடலில் உதயகிரி மலையையும் பொதியமலையையும் குறிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the lexical meaning of the poetic word 'Oongal'?", "media_id": null}], "options": {"A": "Ocean", "B": "Mountain / High peak", "C": "Sky", "D": "Wind"}, "explanation": "'Oongal' signifies an imposing mountain peak (referencing Udayagiri and Pothigai)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 7, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 7", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["C