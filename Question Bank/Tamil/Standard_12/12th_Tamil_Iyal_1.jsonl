{"id": "12th_tamil_u1_q144", "schema_version": "1.0", "kind": "matching", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "mozhi_thiran", "chapter_id": null, "topic_id": "glossary_matching", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பொருத்துக:\n1. Phonetics - அ) கையெழுத்துப் பிரதி\n2. Polyglot - ஆ) ஒலியியல்\n3. Phonology - இ) பன்மொழியாளர்\n4. Manuscript - ஈ) ஒலியனியல்", "media_id": null}], "options": {"A": "1-அ, 2-ஆ, 3-இ, 4-ஈ", "B": "1-இ, 2-ஈ, 3-அ, 4-ஆ", "C": "1-ஈ, 2-அ, 3-ஆ, 4-இ", "D": "1-ஆ, 2-இ, 3-ஈ, 4-அ"}, "explanation": "Phonetics - ஒலியியல்; Polyglot - பன்மொழியாளர்; Phonology - ஒலியனியல்; Manuscript - கையெழுத்துப் பிரதி. சரியான பொருத்தம்: 1-ஆ, 2-இ, 3-ஈ, 4-அ."}, "en": {"blocks": [{"type": "text", "content": "Match the technical terms with their Tamil equivalents:\n1. Phonetics - a) Manuscript\n2. Polyglot - b) Phonetics (Oli-yiyal)\n3. Phonology - c) Polyglot (Panmozhiyaalar)\n4. Manuscript - d) Phonology (Oliyan-yiyal)", "media_id": null}], "options": {"A": "1-a, 2-b, 3-c, 4-d", "B": "1-c, 2-d, 3-a, 4-b", "C": "1-d, 2-a, 3-b, 4-c", "D": "1-b, 2-c, 3-d, 4-a"}, "explanation": "Phonetics: b, Polyglot: c, Phonology: d, Manuscript: a. Thus 1-b, 2-c, 3-d, 4-a."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpora