{"id": "12th_tamil_u1_q175", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tnpsc_pyq_integration", "chapter_id": null, "topic_id": "natarasan_warsaw_univ", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி.சு. நடராசன் அவர்கள் பேராசிரியராகப் பணியாற்றிய வெளிநாட்டுப் பல்கலைக்கழகம் எது?", "media_id": null}], "options": {"A": "சிங்கப்பூர் தேசியப் பல்கலைக்கழகம்", "B": "மலேசியப் பல்கலைக்கழகம்", "C": "போலந்து நாட்டின் வார்சா பல்கலைக்கழகம்", "D": "இலண்டன் பல்கலைக்கழகம்"}, "explanation": "தி.சு. நடராசன் போலந்து நாட்டின் தலைநகர் வார்சாவில் உள்ள வார்சா பல்கலைக்கழகத்தில் தமிழ் பேராசிரியராகப் பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "In which foreign university did Professor T. S. Natarasan serve as a Visiting Professor of Tamil?", "media_id": null}], "options": {"A": "National University of Singapore", "B": "University of Malaya", "C": "Warsaw University in Poland", "D": "University of London"}, "explanation": "T.S. Natarasan taught Tamil at Warsaw University in Poland."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": "12