{"id": "12th_tamil_u1_q001", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamil_nadai_azhagiyal", "chapter_id": null, "topic_id": "author_intro", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தமிழ்மொழியின் நடை அழகியல்’ என்னும் உரைநடைக் கட்டுரையை எழுதிய திறனாய்வாளர் யார்?", "media_id": null}], "options": {"A": "தி.சு. நடராசன்", "B": "கா. சிவத்தம்பி", "C": "அ. அ. மணவாளன்", "D": "க. கைலாசபதி"}, "explanation": "தமிழ்மொழியின் நடை அழகியல் கட்டுரையை எழுதியவர் தமிழ்த் திறனாய்வுலகில் புகழ்பெற்ற பேராசிரியர் தி.சு. நடராசன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the critical essay 'Tamil Mozhiyin Nadai Azhagiyal'?", "media_id": null}], "options": {"A": "T. S. Natarajan", "B": "K. Sivathambi", "C": "A. A. Manavalan", "D": "K. Kailasapathy"}, "explanation": "Eminent literary critic and aesthetician Prof. T. S. Natarajan authored 'Tamil Mozhiyin Nadai Azhagiyal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": fal