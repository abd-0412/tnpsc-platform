{"id": "12th_tamil_u1_q002", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamil_nadai_azhagiyal", "chapter_id": null, "topic_id": "aesthetic_book", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பேராசிரியர் தி.சு. நடராசனின் எந்த ஆய்வு நூலிலிருந்து ‘தமிழ்மொழியின் நடை அழகியல்’ கட்டுரை பாடப்பகுதியாகத் தரப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "கவிதை இயல்", "B": "தமிழ் அழகியல்", "C": "திறனாய்வுக் கலை", "D": "இலக்கியக் கோட்பாடுகள்"}, "explanation": "தி.சு. நடராசன் எழுதிய 'தமிழ் அழகியல்' என்னும் நூலிலிருந்து நடை அழகியல் பற்றிய கருத்துகள் பாடப்பகுதியாகத் தொகுக்கப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "From which critical work of Prof. T. S. Natarajan is the textbook essay excerpted?", "media_id": null}], "options": {"A": "Kavithai Iyal", "B": "Tamil Azhagiyal", "C": "Thiranaivu Kalai", "D": "Ilakkiyak Kotpaadugal"}, "explanation": "The essay is extracted from his landmark aesthetic monograph 'Tamil Azhagiyal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 4, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 4", "url": null, "s