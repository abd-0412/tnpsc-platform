{"id": "12th_tamil_u1_q067", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "thanner_ilaatha_tamil", "chapter_id": null, "topic_id": "aazhi_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மின்னேர் தனிஆழி வெங்கதிரொன்று’ - இத்தொடரில் ‘ஆழி’ என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "மோதிரம்", "B": "கடல்", "C": "சக்கரம் (சூரியனின் ஒற்றைச் சக்கரம் / தேருருளை)", "D": "பூமி"}, "explanation": "இவ்விடத்தில் ‘தனிஆழி’ என்பது சூரியனின் ஒற்றைச் சக்கரத் தேரைக் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "In the line 'Minner thaniaazhi venkadhirontru', what does 'Aazhi' denote?", "media_id": null}], "options": {"A": "Signet ring", "B": "Ocean", "C": "Chariot wheel (the solar chariot's single wheel)", "D": "Earth"}, "explanation": "Here 'Aazhi' refers to the mythological single wheel of the Sun god's chariot."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 7, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 7", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year"