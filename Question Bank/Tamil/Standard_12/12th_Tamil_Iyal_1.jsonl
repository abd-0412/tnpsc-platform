{"id": "12th_tamil_u1_q132", "schema_version": "1.0", "kind": "grammar_rule", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamizhaai_ezhuthuvom", "chapter_id": null, "topic_id": "verb_object_plural_concord", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எழுவாயும் பயனிலையும் திணை, பால், எண் ஆகியவற்றில் ஒன்றுபட்டு வர வேண்டும் என்பதற்குச் சரியான சான்று எது?", "media_id": null}], "options": {"A": "மாணவர்கள் தேர்வை எழுதினான்", "B": "மாடு புல் மேய்ந்தனர்", "C": "அவள் பாட்டுப் பாடினார்கள்", "D": "மாணவர்கள் தேர்வை எழுதினார்கள் (பலர்பால் எழுவாய் - பலர்பால் பயனிலை)"}, "explanation": "எழுவாய் பன்மையாக இருக்கும் போது பயனிலையும் பன்மையாகவே அமைய வேண்டும். 'மாணவர்கள் எழுதினார்கள்' என்பதே இலக்கண அமைதியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which sentence exemplifies flawless subject-verb concord in gender, number, and person?", "media_id": null}], "options": {"A": "Maanavarkal thervai ezhuthinaan", "B": "Maadu pul meynthanar", "C": "Aval paattup paadinaarkal", "D": "Maanavarkal thervai ezhuthinaarkal (Epicene plural subject matching epicene plural verb)"}, "explanation": "Plural human subject Maanavarkal correctly commands plural finite verb ezhuthinaarkal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Co