{"id": "12th_tamil_u1_q123", "schema_version": "1.0", "kind": "grammar_identification", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamizhaai_ezhuthuvom", "chapter_id": null, "topic_id": "sandhi_error_sentences", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் வாக்கியங்களுள் சந்திப்பிழையற்ற (ஒற்றுப்பிழையற்ற) வாக்கியம் எது?", "media_id": null}], "options": {"A": "அவன் பாடத்தை படித்து தேர்வில் வென்றான்", "B": "அவன் பாடம் படித்துத் தேர்வில் வென்றான்", "C": "அவன் பாடத்தைப் படித்துத் தேர்வில் வென்றான்", "D": "அவன் பாடத்தை படித்து தேர்வில் வென்றான்"}, "explanation": "‘பாடத்தை’ என்பது இரண்டாம் வேற்றுமை விரி (ஐ), எனவே 'ப்' மிகும் (பாடத்தைப்). 'படித்து' என்பது வன்தொடர்க் குற்றியலுகர வினையெச்சம், எனவே 'த்' மிகும் (படித்துத்)."}, "en": {"blocks": [{"type": "text", "content": "Select the sentence completely free from Sandhi doubling errors:", "media_id": null}], "options": {"A": "Avan paadathai padithu thervil ventraan", "B": "Avan paadam padithuth thervil ventraan", "C": "Avan paadathaip padithuth thervil ventraan", "D": "Avan paadathai padithu thervil ventraan"}, "explanation": "Both the explicit accusative marker '-ai' and hard verbal participle 'padithu' demand mandatory plosive doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textb