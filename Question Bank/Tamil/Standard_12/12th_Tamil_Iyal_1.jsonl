{"id": "12th_tamil_u1_q180", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tnpsc_pyq_integration", "chapter_id": null, "topic_id": "glossary_lexicon", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூல் கலைச்சொல் பகுதியில் இடம்பெற்றுள்ள ‘Lexicon’ என்ற ஆங்கிலச் சொல்லுக்குரிய தமிழ்ச் சொல் எது?", "media_id": null}], "options": {"A": "இலக்கியம்", "B": "ஒலியியல்", "C": "கையெழுத்துப் பிரதி", "D": "பேரகராதி"}, "explanation": "Lexicon என்பதற்குரிய சரியான தமிழ்க் கலைச்சொல் ‘பேரகராதி’ என்பதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the Tamil technical term for 'Lexicon' as given in the textbook glossary?", "media_id": null}], "options": {"A": "Literature", "B": "Phonetics", "C": "Manuscript", "D": "Paeragaraadhi (Lexicon)"}, "explanation": "'Lexicon' translates to 'Paeragaraadhi' in standard Tamil terminology."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 18", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4", "exam_name": "Group IV Servi