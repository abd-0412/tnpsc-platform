{"id": "12th_tamil_u1_q171", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tnpsc_pyq_integration", "chapter_id": null, "topic_id": "sirpi_poetic_craft", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிற்பி பாலசுப்பிரமணியத்தின் கவிதை நடைக்குச் சிறந்த உதாரணமாக அமைவது எது?", "media_id": null}], "options": {"A": "கடினமான வடமொழிச் சொற்கள் மிகுதல்", "B": "வெண்பா வடிவில் மட்டுமே பாடுதல்", "C": "மரபுக் கவிதையின் ஓசை நயமும் புதுக்கவிதையின் உணர்ச்சி வெளிப்பாடும் இணைந்த உருவகப் பாங்கு", "D": "உரைநடை மட்டுமே கையாளுதல்"}, "explanation": "சிற்பியின் கவிதைகள் பாரதி, பாரதிதாசன் மரபு வழியில் சந்த நயமும் நவீனப் புதுக்கவிதையின் உணர்ச்சிச் செறிவும் கொண்டு விளங்குகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the distinctive hallmark of Sirpi Balasubramaniam's poetic craftsmanship?", "media_id": null}], "options": {"A": "Abundant reliance on archaic Sanskrit vocabulary", "B": "Composing strictly in rigid Venba meter", "C": "Harmonious blend of traditional lyrical cadence with modern imagery and passion", "D": "Writing in prose alone"}, "explanation": "Sirpi masterfully combines traditional metric cadence with modern lyrical and imagistic passion."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Ta