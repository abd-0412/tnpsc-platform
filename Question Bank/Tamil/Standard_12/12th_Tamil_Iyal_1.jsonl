{"id": "12th_tamil_u1_q052", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "ilanthamizhe", "chapter_id": null, "topic_id": "title_significance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் பாடலுக்கு ‘இளந்தமிழே!’ என்று தலைப்பிட்டதன் பொருத்தப்பாடு யாது?", "media_id": null}], "options": {"A": "தமிழ் அண்மையில் தோன்றிய மொழி என்பதால்", "B": "சிறுவர்கள் பேசும் மொழி என்பதால்", "C": "தமிழ் வளரவில்லை என்பதால்", "D": "எத்தனை ஆயிரம் ஆண்டுகள் கடந்தாலும் தமிழ் என்றும் இளமையோடு நறுமணத்தோடு திகழ்கிறது என்பதால்"}, "explanation": "தொன்மையான வரலாறு கொண்டிருந்தாலும், காலந்தோறும் புதுமைகளை ஏற்று 'என்றும் இளமையான மொழியாக' விளங்குவதால் 'இளந்தமிழே' என விளிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "Why did the poet entitle the composition 'Ilanthamizhe!' (Ever-Youthful Tamil)?", "media_id": null}], "options": {"A": "Because Tamil was coined recently", "B": "Because it is spoken only by infants", "C": "Because it ceased growing", "D": "Because despite immense antiquity, Tamil perpetually blossoms with youthful vitality"}, "explanation": "Tamil continually rejuvenates itself across millennia, embodying ageless youth."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Servi