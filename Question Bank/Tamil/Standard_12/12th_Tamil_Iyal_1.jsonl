{"id": "12th_tamil_u1_q184", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tnpsc_pyq_integration", "chapter_id": null, "topic_id": "proverbs_reconstruction", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சொற்களை ஒழுங்குபடுத்திப் பழமொழியை நிறைவு செய்க: ‘சுவர் இல்லாமல் சித்திரம் வரைய முடியாது’ என்பதன் மரபுப் பழமொழி வடிவம் யாது?", "media_id": null}], "options": {"A": "சித்திரம் சுவரின்றி இல்லை", "B": "இல்லை சுவரின்றி சித்திரம்", "C": "சுவர் சித்திரம் இன்றி இல்லை", "D": "சுவர் வைத்தே சித்திரம் வரைய வேண்டும்"}, "explanation": "அடிப்படை இருந்தால் மட்டுமே செயலைச் செய்ய இயலும் என்பதை உணர்த்தும் உலகப் பொது மரபுப் பழமொழி ‘சுவர் வைத்தே சித்திரம் வரைய வேண்டும்’ என்பதாகும்."}, "en": {"blocks": [{"type": "text", "content": "Reconstruct the traditional Tamil proverb conveying that solid foundations are required to achieve great things:", "media_id": null}], "options": {"A": "Chithiram suvarindri illai", "B": "Illai suvarindri chithiram", "C": "Suvar chithiram indri illai", "D": "Suvar vaithe chithiram varaya vendum"}, "explanation": "The established proverb is 'Suvar vaithe chithiram varaya vendum'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "t