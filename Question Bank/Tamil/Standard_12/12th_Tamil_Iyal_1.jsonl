{"id": "12th_tamil_u1_q031", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "ilanthamizhe", "chapter_id": null, "topic_id": "first_line", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘செம்பருதி மலைமேட்டில் தலையைச் சாய்ப்பான்...’ - என்று தொடங்கும் கவிதையில் ‘செம்பருதி’ என்பது எதனைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "சந்திரன்", "B": "விண்மீன்", "C": "செந்நிறச் சூரியன் (செஞ்சூரியன்)", "D": "செவ்வாய் கிரகம்"}, "explanation": "பருதி என்றால் சூரியன். மாலையில் மேற்கு மலைமேட்டில் மறையும் செந்நிறக் கதிரவனைச் 'செம்பருதி' என்று கவிஞர் வருணிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "What does 'Sembaruthi' represent in the opening verse 'Sembaruthi malaimettil thalaiyai saippaan...'?", "media_id": null}], "options": {"A": "Moon", "B": "Star", "C": "Crimson setting sun", "D": "Mars planet"}, "explanation": "'Paruthi' signifies the sun; 'Sembaruthi' depicts the crimson setting sun on hillcrests."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 5", "url": null, "source_notes": null}, "previ