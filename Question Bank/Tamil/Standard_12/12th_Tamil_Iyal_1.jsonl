{"id": "12th_tamil_u1_q054", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "ilanthamizhe", "chapter_id": null, "topic_id": "contemporary_relevance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இக்கவிதையின் வழியே கவிஞர் இன்றைய தமிழ்ச் சமூகத்திற்கு விடுக்கும் அறைகூவல் யாது?", "media_id": null}], "options": {"A": "பழைய பெருமைகளைப் பேசிப் பொழுதை வீணடிப்பது", "B": "பழம் பெருமையோடு நிற்காமல் உலக அறிவியல் தளத்தில் தமிழ் வீறுநடை போட வேண்டும்", "C": "பிற மொழிகளைப் புறக்கணிப்பது", "D": "கவிதைகளை மட்டுமே எழுதுவது"}, "explanation": "பழைய இலக்கியச் சிறப்புகளோடு புதிய அறிவியல் மற்றும் நவீன சிந்தனைகளை உள்வாங்கித் தமிழ் தலைநிமிர்ந்து நிற்க வேண்டும் என்பதே கவிஞரின் அறைகூவலாகும்."}, "en": {"blocks": [{"type": "text", "content": "What clarion call does the poet issue to contemporary Tamil society through this poem?", "media_id": null}], "options": {"A": "Idle boast of ancient glories alone", "B": "Transcend nostalgic past to march vigorously on modern scientific and intellectual frontiers", "C": "Chauvinistic rejection of other languages", "D": "Composing only classical verse"}, "explanation": "The poet urges active modernization, wedding ancient prestige with modern scientific advancement."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalv