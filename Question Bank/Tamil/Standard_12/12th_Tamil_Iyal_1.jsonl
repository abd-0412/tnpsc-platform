{"id": "12th_tamil_u1_q173", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tnpsc_pyq_integration", "chapter_id": null, "topic_id": "bharathi_addressed_thambi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மகாகவி பாரதியார் ‘தம்பி’ என்று உரிமையோடு விளித்துக் கடிதங்கள் எழுதிய பெருமைக்குரியவர் யார்?", "media_id": null}], "options": {"A": "பரலி சு. நெல்லையப்பர்", "B": "வ.உ. சிதம்பரனார்", "C": "சுப்பிரமணிய சிவா", "D": "ரா.அ. பத்மநாபன்"}, "explanation": "பாரதியார் தம்மைவிட இளையவரான பரலி சு. நெல்லையப்பரைத் ‘தம்பி’ என விளித்து அளவிலா வாஞ்சையுடன் கடிதங்களை எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "Whom did Mahakavi Bharathiyar affectionately address as 'Thambi' (younger brother) in his epistolary writings?", "media_id": null}], "options": {"A": "Parali S. Nellaiyappar", "B": "V. O. Chidambaranar", "C": "Subramaniya Siva", "D": "R. A. Padmanabhan"}, "explanation": "Bharathiyar addressed Parali S. Nellaiyappar warmly as 'Thambi' in numerous motivational letters."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 11, "chapter": null, "section": null, "reference": "12th Tamil, Un