{"id": "12th_tamil_u1_q053", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "ilanthamizhe", "chapter_id": null, "topic_id": "nature_scenery", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘செந்நிறத்துப் பூக்காடாய்...’ என்று கவிஞர் எதனை உருவகிக்கிறார்?", "media_id": null}], "options": {"A": "வானத்தில் செவ்வானம் சிவந்து பூக்காடு போலத் திகழ்வதை", "B": "ரோஜா தோட்டத்தை", "C": "செங்கல்பட்டு காட்டை", "D": "செம்மண் நிலத்தை"}, "explanation": "சூரியன் மறையும் அந்தி மாலையில் வானம் முழுவதும் செந்நிறமாகப் படர்வதைச் சிவந்த பூக்காடு போலக் காட்சியளிப்பதாகக் கவிஞர் பாடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What natural vista is metaphorically visualized as a 'Crimson Forest of Blossoms'?", "media_id": null}], "options": {"A": "The radiant crimson twilight sky glowing like an expanse of red blossoms", "B": "A rose garden", "C": "A scrub jungle", "D": "Red loam terrain"}, "explanation": "The twilight horizon illuminated by the setting sun is depicted as an ethereal red blossom field."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference":