{"id": "12th_tamil_u1_q178", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tnpsc_pyq_integration", "chapter_id": null, "topic_id": "bharathi_journals_exclusion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியார் ஆசிரியராக அல்லது துணையாசிரியராகப் பணியாற்றிய இதழ்களுள் சேராதது எது?", "media_id": null}], "options": {"A": "இந்தியா", "B": "திராவிடன்", "C": "விஜயா", "D": "கர்மயோகி"}, "explanation": "இந்தியா, விஜயா, கர்மயோகி, பாலபாரதி, சுதேசமித்திரன் ஆகியவற்றில் பாரதி பணியாற்றினார்; ‘திராவிடன்’ நீதிக்கட்சியின் நாளிதழாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following journals was NOT edited by or affiliated with Mahakavi Bharati?", "media_id": null}], "options": {"A": "India", "B": "Dravidan", "C": "Vijaya", "D": "Karmayogi"}, "explanation": "India, Vijaya, Karmayogi were associated with Bharati. Dravidan was an organ of the Justice Party."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 12, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 12", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam":