{"id": "12th_tamil_u1_q069", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "thanner_ilaatha_tamil", "chapter_id": null, "topic_id": "venkadhir_split", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வெங்கதிர்’ - என்னும் சொல்லைப் பிரித்தெழுதக் கிடைப்பது எது?", "media_id": null}], "options": {"A": "வெம்மை + கதிர்", "B": "வெண் + கதிர்", "C": "வெம்பு + கதிர்", "D": "வெம் + கதிர்"}, "explanation": "வெம்மை + கதிர் = வெங்கதிர். 'ஈறுபோதல்' விதியால் 'மை' கெட்டு, 'முன்னின்ற மெய் திரிதல்' விதியால் மகரம் ககரத்திற்கு இனமான ஙகரமானது."}, "en": {"blocks": [{"type": "text", "content": "What is the correct grammatical split for the compound 'Venkadhir'?", "media_id": null}], "options": {"A": "Vemmai + Kadhir", "B": "Ven + Kadhir", "C": "Vembu + Kadhir", "D": "Vem + Kadhir"}, "explanation": "Vemmai (heat) + Kadhir (ray) undergoes suffix elision and nasal assimilation to yield Venkadhir."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 7, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 7", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam":