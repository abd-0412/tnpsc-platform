{"id": "12th_tamil_u1_q025", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamil_nadai_azhagiyal", "chapter_id": null, "topic_id": "thiranayvu_objective", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கியத் திறனாய்வின் முதன்மையான நோக்கம் எதுவெனக் குறிப்பிடப்படுகிறது?", "media_id": null}], "options": {"A": "ஒரு படைப்பின் அழகியல் கூறுகளையும் அதன் ஆழமான பொருண்மையையும் கண்டறிந்து வாசகனுக்கு உணர்த்துவது", "B": "எழுத்தாளரின் குறைகளை மட்டும் தேடுவது", "C": "நூலின் பக்கங்களை எண்ணுவது", "D": "மன்னர்களைப் புகழ்ந்து பேசுவது"}, "explanation": "திறனாய்வு என்பது வெறுமனே குற்றம் காண்பதல்ல; இலக்கியத்தின் உட்கிடக்கையையும் கலை நுட்பங்களையும் வாசகனுக்கு வெளிச்சமிட்டுக் காட்டுவதே அதன் நோக்கமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the cardinal objective of literary aesthetic criticism?", "media_id": null}], "options": {"A": "To uncover aesthetic craftsmanship and thematic depth, guiding the reader toward profound appreciation", "B": "Solely hunting authorial flaws", "C": "Counting book pages", "D": "Eulogizing ancient monarchs"}, "explanation": "True criticism illuminates artistic virtue and thematic integrity for enlightened reading."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Te