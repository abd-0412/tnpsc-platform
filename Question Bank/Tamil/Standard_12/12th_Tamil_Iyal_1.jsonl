{"id": "12th_tamil_u1_q138", "schema_version": "1.0", "kind": "grammar_rule", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamizhaai_ezhuthuvom", "chapter_id": null, "topic_id": "demonstrative_case_sandhi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அது, இது, எது’ என்னும் சுட்டு மற்றும் வினாப் பெயர்களின் பின் வல்லினம் என்னவாகும்?", "media_id": null}], "options": {"A": "கண்டிப்பாக மிகும்", "B": "வல்லினம் மிகாது (எ.கா: அது பறந்தது, இது சென்றது, எது கண்டது)", "C": "மெல்லினமாகும்", "D": "இடைவினையாகும்"}, "explanation": "அது, இது, எது என்னும் சுட்டுப் பெயர்களின் பின் வல்லினம் மிகக் கூடாது (அது சென்றது, இது கண்டது)."}, "en": {"blocks": [{"type": "text", "content": "What occurs to initial plosives following nominative demonstrative pronouns Athu, Ithu, Ethu?", "media_id": null}], "options": {"A": "Mandatorily doubles", "B": "Vallinam DOES NOT double (e.g., Athu paranthathu, Ithu sentrathu)", "C": "Becomes nasal", "D": "Converts to particle"}, "explanation": "Nominative singular neuter pronouns Athu, Ithu, Ethu strictly prohibit subsequent plosive doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 14, "chapter": null, "sectio