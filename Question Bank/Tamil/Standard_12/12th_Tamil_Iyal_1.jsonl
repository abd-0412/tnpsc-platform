{"id": "12th_tamil_u1_q113", "schema_version": "1.0", "kind": "grammar_identification", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamizhaai_ezhuthuvom", "chapter_id": null, "topic_id": "mayangoli_letters_count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் மொழியில் அமைந்த ‘மயங்கொலி எழுத்துகள்’ மொத்தம் எத்தனை?", "media_id": null}], "options": {"A": "8 எழுத்துகள் (ண, ன, ந; ல, ள, ழ; ர, ற)", "B": "6 எழுத்துகள்", "C": "10 எழுத்துகள்", "D": "12 எழுத்துகள்"}, "explanation": "ஒலிப்பில் மிக நுட்பமான வேறுபாடு மட்டுமே கொண்ட ண, ன, ந, ல, ள, ழ, ர, ற ஆகிய எட்டு எழுத்துகளும் மயங்கொலி எழுத்துகள் எனப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "How many homophonous characters (Mayangoli Ezhuthukal) exist in Tamil orthography?", "media_id": null}], "options": {"A": "8 characters (ண, ன, ந; ல, ள, ழ; ர, ற)", "B": "6 characters", "C": "10 characters", "D": "12 characters"}, "explanation": "Tamil possesses exactly eight phonemically proximate characters known as Mayangoli letters."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 12, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 12", "url": null, "source_n