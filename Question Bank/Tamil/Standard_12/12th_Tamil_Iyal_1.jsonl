{"id": "12th_tamil_u1_q096", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "thambi_nellaiyapparukku", "chapter_id": null, "topic_id": "nellaiyappar_native", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பரலி சு. நெல்லையப்பர் எந்த ஊரைச் சேர்ந்தவர்?", "media_id": null}], "options": {"A": "மதுரை", "B": "தூத்துக்குடி", "C": "சென்னை", "D": "பரலி (திருநெல்வேலி மாவட்டம்)"}, "explanation": "நெல்லையப்பர் திருநெல்வேலி மாவட்டத்திலுள்ள 'பரலி' என்னும் ஊரில் பிறந்தவர்; அதனால் பரலி சு. நெல்லையப்பர் என அழைக்கப்பட்டார்."}, "en": {"blocks": [{"type": "text", "content": "What was the ancestral native village of Parali S. Nellaiyappar?", "media_id": null}], "options": {"A": "Madurai", "B": "Thoothukudi", "C": "Chennai", "D": "Parali (Tirunelveli District)"}, "explanation": "He hailed from the village of Parali in Tirunelveli district."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 11, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 11", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": nu