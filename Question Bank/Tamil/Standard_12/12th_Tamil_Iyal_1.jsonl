{"id": "12th_tamil_u1_q070", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "thanner_ilaatha_tamil", "chapter_id": null, "topic_id": "uyarnthor_who", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உயர்ந்தோர் தொழ விளங்கி...’ - இத்தொடரில் யாரால் தொழப்படுவதாகக் கவிதை கூறுகிறது?", "media_id": null}], "options": {"A": "மன்னர்களால் மட்டுமே", "B": "சான்றோர்கள், அறிஞர்கள், முனிவர்களால்", "C": "வணிகர்களால்", "D": "படைவீரர்களால்"}, "explanation": "கதிரவனைத் தவமுனிவர்கள் காலையில் கைதொழுது வணங்குகின்றனர்; தமிழை அறிவுசான்ற புலவர்களும் சான்றோர்களும் தலைவணங்கிப் போற்றுகின்றனர்."}, "en": {"blocks": [{"type": "text", "content": "In 'Uyarnthor thozha vilangi...', who are the venerable beings worshipping the two entities?", "media_id": null}], "options": {"A": "Monarchs alone", "B": "Enlightened sages, noble scholars, and savants", "C": "Merchants", "D": "Soldiers"}, "explanation": "Ascetics worship the physical sun at dawn, while erudite sages venerate Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 7, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 7", "url": null, 