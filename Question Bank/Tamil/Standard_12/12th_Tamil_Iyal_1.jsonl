{"id": "12th_tamil_u1_q059", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "thanner_ilaatha_tamil", "chapter_id": null, "topic_id": "sanskrit_source", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தண்டியலங்காரம் எந்த வடமொழி இலக்கண நூலைத் தழுவித் தமிழில் எழுதப்பட்டது?", "media_id": null}], "options": {"A": "நாட்டிய சாஸ்திரம்", "B": "சாகித்திய தர்ப்பணம்", "C": "காவியாதர்சம் (Kavyadarsa)", "D": "காவிய மீமாம்சை"}, "explanation": "தண்டி வடமொழியில் எழுதிய 'காவியாதர்சம்' (Kavyadarsa) என்னும் நூலைத் தழுவித் தமிழில் தண்டியலங்காரம் இயற்றப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which Sanskrit rhetorical treatise was adapted into Tamil as Thandiyalankaram?", "media_id": null}], "options": {"A": "Natya Sastra", "B": "Sahitya Darpana", "C": "Kavyadarsa", "D": "Kavya Mimamsa"}, "explanation": "Thandiyalankaram is the Tamil adaptation of the Sanskrit treatise 'Kavyadarsa'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 8, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 8", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false