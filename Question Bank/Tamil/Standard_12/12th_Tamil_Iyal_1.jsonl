{"id": "12th_tamil_u1_q192", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tnpsc_pyq_integration", "chapter_id": null, "topic_id": "orthography_error_rectification", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எழுத்துப் பிழையை நீக்கிச் சரியான தொடரைத் தேர்க: ‘கல்லூறி மாநாவர்கள் தங்களின் திரமையை காட்டினர்.’", "media_id": null}], "options": {"A": "கல்லூறி மாணவர்கள் தங்களின் திறமையை காட்டினர்.", "B": "கல்லூரி மாநாவர்கள் தங்களின் திறமையை காட்டினர்.", "C": "கல்லூரி மாணவர்கள் தங்களின் திரமையை காட்டினர்.", "D": "கல்லூரி மாணவர்கள் தங்களின் திறமையைக் காட்டினர்."}, "explanation": "கல்லூரி (ரி), மாணவர்கள் (ண), திறமை (ற), திறமையைக் காட்டினர் (க் சந்தி) எனப் பிழையின்றி அமைவதே சரியான தொடராகும்."}, "en": {"blocks": [{"type": "text", "content": "Rectify all spelling and sandhi errors in the sentence: 'Kalloori maanavargal thangalin thiramayai kaattinar':", "media_id": null}], "options": {"A": "Option A", "B": "Option B", "C": "Option C", "D": "Kalloori maanavargal thangalin thiramaiyaik kaattinar."}, "explanation": "Correct letters: Kalloori (ரி), maanavargal (ண), thiramai (ற), thiramaiyaik (க் junction)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "1