{"id": "12th_tamil_u1_q196", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tnpsc_pyq_integration", "chapter_id": null, "topic_id": "porul_vetrumai_ani_definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தண்டியலங்காரம் கூறும் ‘பொருள் வேற்றுமை அணி’யின் அடிப்படை இலக்கண விளக்கம் யாது?", "media_id": null}], "options": {"A": "பொருள்களுக்கு இடையே உள்ள ஒற்றுமையை மட்டும் கூறுவது", "B": "காரண காரியத் தொடர்பை விளக்குவது", "C": "உயர்வு நவிற்சியாகப் புனைந்துரைப்பது", "D": "இரு பொருள்களுக்கு இடையே உள்ள ஒற்றுமையை முதலில் கூறி, பின் அவற்றுள் ஒன்றை மற்றொன்றிலிருந்து வேறுபடுத்திக் காட்டுவது"}, "explanation": "இரு பொருள்களுக்கு இடையே உள்ள ஒப்புமையை முதலில் கூறி, பின்னர் அவற்றுள் ஒன்றை மற்றொன்றிலிருந்து சிறப்பித்தோ வேறுபடுத்தியோ காட்டுவது பொருள் வேற்றுமை அணி எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What is the precise grammatical definition of 'Porul Vetrumai Ani' in Thandiyalankaram?", "media_id": null}], "options": {"A": "Stating similarities alone between objects", "B": "Delineating cause and effect relations", "C": "Hyperbolic poetic eulogy", "D": "Stating similarities between two entities first, and subsequently distinguishing one from the other"}, "explanation": "Porul Vetrumai Ani establishes commonality first and subsequently distinguishes one entity as having a unique virtue."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "n