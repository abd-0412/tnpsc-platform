{"id": "12th_tamil_u1_q051", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "ilanthamizhe", "chapter_id": null, "topic_id": "rhyme_and_alliteration", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘செம்பருதி மலைமேட்டில்...’\n‘விம்மிவரும் தோள்தோறும்...’\n- இவ்வடிகளில் அமைந்துள்ள தொடை நயம் யாது?", "media_id": null}], "options": {"A": "இயைபுத் தொடை மட்டுமே", "B": "முரண் தொடை மட்டுமே", "C": "இரண்டாம் எழுத்து ஒன்றிவரும் எதுகைத் தொடை (செம்-விம்)", "D": "அளபெடைத் தொடை"}, "explanation": "முதல் சீரின் இரண்டாம் எழுத்து 'ம்' ஒன்றி வந்துள்ளதால் (செம்பருதி - விம்மிவரும்) இது எதுகைத் தொடை நயம் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What prosodic device links 'Sembaruthi' and 'Vimmivarum' in adjacent lines?", "media_id": null}], "options": {"A": "End-rhyme (Iyaibu) only", "B": "Antithesis (Muran) only", "C": "Second-letter rhyming (Ethugai)", "D": "Vowel lengthening (Alabedai)"}, "explanation": "Both lines feature identical consonant 'm' in the second syllable, conforming to Ethugai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference"