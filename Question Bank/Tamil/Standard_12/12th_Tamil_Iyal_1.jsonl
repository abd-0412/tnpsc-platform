{"id": "12th_tamil_u1_q106", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "thambi_nellaiyapparukku", "chapter_id": null, "topic_id": "voc_imprisonment_relief", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வ. உ. சிதம்பரனார் கோவை மற்றும் கண்ணனூர் சிறையில் அடைக்கப்பட்டிருந்த காலத்தில் அவருக்குத் துணைநின்றவர் யார்?", "media_id": null}], "options": {"A": "பாரதிதாசன்", "B": "பரலி சு. நெல்லையப்பர்", "C": "நாமக்கல் கவிஞர்", "D": "கவிமணி"}, "explanation": "வ.உ.சி சிறையில் துயருற்ற போது அவரது குடும்பத்தைப் பாதுகாத்து நூல்களை வெளியிடும் பணிகளுக்கு நெல்லையப்பர் பேருதவி புரிந்தார்."}, "en": {"blocks": [{"type": "text", "content": "Who faithfully stood by V. O. Chidambaranar during his brutal imprisonment at Coimbatore and Cannanore jails?", "media_id": null}], "options": {"A": "Bharathidasan", "B": "Parali S. Nellaiyappar", "C": "Namakkal Kavignar", "D": "Kavimani"}, "explanation": "Nellaiyappar tirelessly aided V.O.C.'s family and supported publication of his prison writings."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 11, "chapter": null, "section": null, "reference": "12th Tamil, Uni