{"id": "12th_tamil_u1_q193", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tnpsc_pyq_integration", "chapter_id": null, "topic_id": "bharathi_letter_blessing", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியார் தம் கடிதத்தில் தம்பி நெல்லையப்பரை வாழ்த்தும்போது எதனைப் பெற்று ஒரு சுடராக வாழ வேண்டும் என்று வாழ்த்துகிறார்?", "media_id": null}], "options": {"A": "பராசக்தியின் அருளால் வீரியமும் தெளிவும் பெற்று ஒரு சுடராக வாழ வேண்டும்", "B": "பிறர் அடிபணிந்து அமைதியாக வாழ வேண்டும்", "C": "காட்டில் துறவியாக வாழ வேண்டும்", "D": "செல்வத்தை மட்டுமே சேர்த்து வாழ வேண்டும்"}, "explanation": "பாரதியார் கடிதத்தில் ‘சக்தி உனக்கு நல்லறிவையும், தீரத்தையும், சுடர்விடும் உணர்வையும் அருளுக!’ என்று நெல்லையப்பரை வாழ்த்துகிறார்."}, "en": {"blocks": [{"type": "text", "content": "With what exalted benediction does Bharathiyar bless brother Nellaiyappar to shine in his letter?", "media_id": null}], "options": {"A": "Endowed with vitality, wisdom, and blazing valor through Goddess Parasakthi's grace", "B": "To live submissively in silence", "C": "To renounce worldly life as a forest ascetic", "D": "To focus exclusively on accumulating wealth"}, "explanation": "Bharathiyar invokes Parasakthi to grant him luminous wisdom, heroism, and an incandescent soul."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source":