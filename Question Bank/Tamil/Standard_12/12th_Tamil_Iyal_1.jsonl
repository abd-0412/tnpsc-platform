{"id": "12th_tamil_u1_q085", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "thambi_nellaiyapparukku", "chapter_id": null, "topic_id": "letter_author", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தம்பி நெல்லையப்பருக்கு’ என்ற வரலாற்றுச் சிறப்புமிக்க கடிதத்தை எழுதியவர் யார்?", "media_id": null}], "options": {"A": "மகாகவி சுப்பிரமணிய பாரதியார்", "B": "வ. உ. சிதம்பரனார்", "C": "சுப்பிரமணிய சிவா", "D": "பாரதிதாசன்"}, "explanation": "மகாகவி பாரதியார் புதுச்சேரியில் வாழ்ந்த காலத்தில் தம் எட்டயபுரத்துத் தோழரும் சீடருமான பரலி சு. நெல்லையப்பருக்கு இக்கடிதத்தை எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "Who penned the historic instructional epistle 'Thambi Nellaiyapparukku'?", "media_id": null}], "options": {"A": "Mahakavi Subramania Bharati", "B": "V. O. Chidambaranar", "C": "Subramania Siva", "D": "Bharathidasan"}, "explanation": "Mahakavi Subramania Bharati addressed this inspiring letter from Puducherry to Parali S. Nellaiyappar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 9, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 9", "url": null, "so