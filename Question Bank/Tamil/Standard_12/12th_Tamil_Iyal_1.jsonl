{"id": "12th_tamil_u1_q018", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamil_nadai_azhagiyal", "chapter_id": null, "topic_id": "literary_criticism_book", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி.சு. நடராசனின் நூல்களுள் தமிழியல் ஆய்வுக்குப் பெரிதும் பயன்படும் மற்றொரு நூல் எது?", "media_id": null}], "options": {"A": "கவிதை உலகம்", "B": "கவிதை இயல்", "C": "நாடக இயல்", "D": "கலை இயல்"}, "explanation": "தி.சு. நடராசன் எழுதிய 'கவிதை இயல்' நூல் கவிதைக் கோட்பாடுகளை விளக்கும் முக்கியத் திறனாய்வு நூலாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which other landmark work by Prof. T. S. Natarajan serves as an essential manual of poetic theory?", "media_id": null}], "options": {"A": "Kavithai Ulagam", "B": "Kavithai Iyal", "C": "Nataga Iyal", "D": "Kalai Iyal"}, "explanation": "'Kavithai Iyal' is his authoritative treatise outlining foundational poetic theories."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 4, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 4", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "