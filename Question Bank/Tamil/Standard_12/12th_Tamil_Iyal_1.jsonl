{"id": "12th_tamil_u1_q007", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamil_nadai_azhagiyal", "chapter_id": null, "topic_id": "sound_and_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஓசையும் பொருளும் இணைந்து கவிதைக்கு உயிர் தருகின்றன’ - இக்கருத்தை விளக்கும் செவ்விலக்கியக் கவிதை வடிவம் எது?", "media_id": null}], "options": {"A": "விருத்தப்பா மட்டுமே", "B": "கலிவெண்பா மட்டுமே", "C": "சங்க ஆசிரியப்பா மற்றும் கலிப்பா பாடல்கள்", "D": "சிந்துப் பாடல்கள்"}, "explanation": "சங்க இலக்கிய ஆசிரியப்பாவின் அகவல் ஓசையும் கலிப்பாவின் துள்ளல் ஓசையும் சொல்லப்படும் உணர்ச்சிக்கு ஏற்ப இசை வடிவம் பெறுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Which classical poetic forms demonstrate acoustic rhythm organically melding with semantic emotional tone?", "media_id": null}], "options": {"A": "Viruttam meter only", "B": "Kalivenba only", "C": "Sangam Asiriyappa and Kalippa verses", "D": "Sindhu verses"}, "explanation": "The cadences of Asiriyappa and Kalippa mirror the emotional contours of the interior landscape."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 3, "chapter": 