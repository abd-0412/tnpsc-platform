{"id": "12th_tamil_u1_q022", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamil_nadai_azhagiyal", "chapter_id": null, "topic_id": "form_definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிதையில் ‘வடிவம்’ (Form) என்பது எவற்றின் கூட்டு அமைப்பாகும்?", "media_id": null}], "options": {"A": "பொருளும் கற்பனையும் மட்டுமே", "B": "சொல், தொடர், ஓசை, யாப்பு ஆகியவற்றின் ஒருமைப்பாடு", "C": "ஏட்டுச் சுவடியின் வடிவம்", "D": "அச்சு எழுத்தின் அளவு"}, "explanation": "சொற்கள், தொடரமைப்பு, யாப்பமைதி, ஓசை ஒழுங்கு ஆகிய மொழியியல் கூறுகளின் முழுமையான ஒருமைப்பாடே 'வடிவம்' எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes poetic 'Form' in literary structuralism?", "media_id": null}], "options": {"A": "Content and imagination only", "B": "The dynamic organic synthesis of diction, syntax, rhythm, and prosody", "C": "Physical palm-leaf geometry", "D": "Typographic font size"}, "explanation": "Form is the total harmonic integration of linguistic signs, prosody, and structural syntax."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "refere