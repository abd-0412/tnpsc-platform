{"id": "12th_tamil_u1_q187", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tnpsc_pyq_integration", "chapter_id": null, "topic_id": "bharathidasan_real_name", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியாரின் கவிதை வழித்தோன்றலாக விளங்கி, ‘புரட்சிக் கவிஞர்’ எனப் போற்றப்பட்ட பாரதிதாசனின் இயற்பெயர் யாது?", "media_id": null}], "options": {"A": "துரைராசு", "B": "இராசகோபாலன்", "C": "கனக சுப்புரத்தினம்", "D": "சுப்பிரமணியன்"}, "explanation": "பாரதிதாசனின் இயற்பெயர் கனக சுப்புரத்தினம் ஆகும். பாரதியார் மீது கொண்ட மாறாப் பற்றினால் ‘பாரதிதாசன்’ எனத் தம் பெயரை மாற்றிக் கொண்டார்."}, "en": {"blocks": [{"type": "text", "content": "What was the given name of Bharathidasan, acclaimed as 'Puratchi Kavignar'?", "media_id": null}], "options": {"A": "Durairasu", "B": "Rajagopalan", "C": "Kanaka Subburathinam", "D": "Subramaniyan"}, "explanation": "Bharathidasan's birth name was Kanaka Subburathinam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 4, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 4", "url": null, "source_notes": null}, "previous_year": {"is_previous_year"