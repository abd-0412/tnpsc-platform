{"id": "12th_tamil_u1_q028", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamil_nadai_azhagiyal", "chapter_id": null, "topic_id": "language_as_art", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கலைஞன் தன் கற்பனையைச் சிற்பத்தில் கல்லால் வடிப்பது போல, கவிஞன் எதனால் தன் கவிதையை வடிக்கிறான்?’", "media_id": null}], "options": {"A": "வண்ணங்களால்", "B": "மரக்கட்டையால்", "C": "தங்கத்தால்", "D": "சொற்களால் (மொழி கூறுகளால்)"}, "explanation": "சிற்பிக்குக் கல் மூலப்பொருளாவது போல, ஓவியனுக்கு வண்ணம் மூலப்பொருளாவது போல, கவிஞனுக்கு மொழியின் சொற்களே மூலப்பொருளாக அமைகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Just as a sculptor shapes imagination using granite, with what medium does a poet sculpt verses?", "media_id": null}], "options": {"A": "Pigments", "B": "Timber", "C": "Gold", "D": "Words (linguistic signs of language)"}, "explanation": "Words serve as the raw clay and granite with which literary artists sculpt poetic architecture."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 2", "url": null, "so