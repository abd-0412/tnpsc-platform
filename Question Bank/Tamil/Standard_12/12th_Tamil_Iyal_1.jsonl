{"id": "12th_tamil_u1_q049", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "ilanthamizhe", "chapter_id": null, "topic_id": "call_for_new_tamil", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘செந்தமிழே! உள்ளக் கனல்மூள உன்பெருமை...’ - இத்தொடரில் கவிஞர் உணர்த்துவது யாது?", "media_id": null}], "options": {"A": "தமிழ் மொழியின் பெருமையை எண்ணும்போது நெஞ்சில் புது உத்வேகக் கனல் மூள்கிறது", "B": "கோபம் உண்டாகிறது", "C": "அச்சம் பிறக்கிறது", "D": "சோர்வு உண்டாகிறது"}, "explanation": "தமிழின் பழம்பெருமையும் வீரமும் நினைவுக்கு வரும்போது உள்ளத்தில் புது எழுச்சித் தீ மூள்கிறது என்று கவிஞர் நெகிழ்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "What sentiment is embodied in 'Senthamizhe! Ullak kanal moola un perumai...'?", "media_id": null}], "options": {"A": "Contemplating Tamil's majestic grandeur kindles a blazing flame of inspiration within the heart", "B": "Sparks bitter anger", "C": "Evokes timidity", "D": "Produces sluggish fatigue"}, "explanation": "Meditating upon Tamil's cultural greatness ignites fiery patriotic inspiration."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 5", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 1", "Poetry", "Poetic Emotion"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u1_q050", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "ilanthamizhe", "chapter_id": null, "topic_id": "editorial_work", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிற்பி பாலசுப்பிரமணியம் எந்தக் கவிதை இதழைத் தொடங்கி நடத்தி இளம் கவிஞர்களை ஊக்குவித்தார்?", "media_id": null}], "options": {"A": "எழுத்து", "B": "வானம்பாடி", "C": "ழ", "D": "கசடதபற"}, "explanation": "சிற்பி பாலசுப்பிரமணியம் கோவையில் 'வானம்பாடி' சிற்றிதழின் ஆசிரியர் குழுவில் முதன்மைப் பங்கு வகித்தார்."}, "en": {"blocks": [{"type": "text", "content": "In editing which landmark modernist journal did Sirpi Balasubramaniam play a chief role?", "media_id": null}], "options": {"A": "Ezhuthu", "B": "Vaanambadi", "C": "Zha", "D": "Kasatathapara"}, "explanation": "He was a pivotal editor and guiding spirit of the Vaanambadi poetry movement periodical."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 6", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "pap