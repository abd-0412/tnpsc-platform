{"id": "12th_tamil_u1_q063", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "thanner_ilaatha_tamil", "chapter_id": null, "topic_id": "thandiyalankaram_sections", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தண்டியலங்காரம் நூல் எத்தனை பிரிவுகளைக் (பகுப்புகளைக்) கொண்டது?", "media_id": null}], "options": {"A": "இரண்டு பிரிவுகள்", "B": "ஐந்து பிரிவுகள்", "C": "மூன்று பிரிவுகள் (பொதுவியல், பொருளணியியல், சொல்லணியியல்)", "D": "நான்கு பிரிவுகள்"}, "explanation": "தண்டியலங்காரம்: 1. பொதுவியல், 2. பொருளணியியல், 3. சொல்லணியியல் என்னும் மூன்று பெரும் பிரிவுகளைக் கொண்டதாகும்."}, "en": {"blocks": [{"type": "text", "content": "Into how many primary canonical divisions is Thandiyalankaram structured?", "media_id": null}], "options": {"A": "Two divisions", "B": "Five divisions", "C": "Three divisions (Pothuviyal, Porulaniyal, Sollaniyal)", "D": "Four divisions"}, "explanation": "It comprises three sections: General Principles (Pothuviyal), Figures of Meaning (Porulaniyal), and Figures of Word (Sollaniyal)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 8, "chapter": null, "section": null, "refer