{"id": "12th_tamil_u1_q170", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tnpsc_pyq_integration", "chapter_id": null, "topic_id": "natarasan_literature_aim", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி.சு. நடராசன் அவர்களின் கூற்றுப்படி, இலக்கியத்தின் தலையாய நோக்கம் எத்தகையது?", "media_id": null}], "options": {"A": "தகவல்களை மட்டுமே சேகரித்துப் பகிர்வது", "B": "அழகியல் இன்பமும் பண்பாட்டு விழுமியங்களும் மனித உணர்வில் கலப்பது", "C": "மன்னர்களைப் புகழ்ந்து பொருள் ஈட்டுவது", "D": "இலக்கண விதிகளை மட்டும் கற்பிப்பது"}, "explanation": "இலக்கியம் மொழியின் நடை அழகியல் வழியே மனித உணர்வில் விழுமியங்களையும் அழகியல் இன்பத்தையும் உருவாக்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "According to Professor T. S. Natarasan, what is the ultimate aim of literature?", "media_id": null}], "options": {"A": "Merely storing and transmitting factual information", "B": "Infusing aesthetic delight and humanistic cultural values into consciousness", "C": "Praising monarchs for patron financial gain", "D": "Teaching formal grammar rules alone"}, "explanation": "Literature elevates human sensibility through aesthetic pleasure and cultural values."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook a