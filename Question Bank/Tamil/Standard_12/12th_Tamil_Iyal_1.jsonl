{"id": "12th_tamil_u1_q011", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamil_nadai_azhagiyal", "chapter_id": null, "topic_id": "purananuru_syntax", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புறநானூற்றுப் பாடல்களில் இடம்பெறும் தொடரமைப்பு எவ்வாறு அமைந்துள்ளதாகக் கட்டுரையில் சுட்டப்படுகிறது?", "media_id": null}], "options": {"A": "எளிய பேச்சு வழக்குத் தொடர்கள் மட்டுமே", "B": "பொருளற்ற அடுக்குச் சொற்கள்", "C": "வினைமுற்றுகள் முன்வரவும் பெயர்கள் பின்வரவும் அமைந்த உணர்ச்சிமிக்க நேர்முகத் தொடர்கள்", "D": "சுருக்கமற்ற நீண்ட வருணனைகள்"}, "explanation": "உணர்ச்சியின் தீவிரத்தை வெளிப்படுத்த புறநானூற்றில் வழக்கமான எழுவாய்-செயப்படுபொருள்-பயனிலை வரிசை மாறி வினைமுற்றுகள் முன்னால் நிற்கும் ஆற்றல்மிக்க நடை கையாளப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "How is syntactical inversion in Purananuru verses analyzed in the essay?", "media_id": null}], "options": {"A": "Simple vernacular colloquial expressions only", "B": "Repetitive meaningless word stacks", "C": "Dynamic sentences where finite verbs precede subjects to project emotional velocity", "D": "Loose wandering descriptions"}, "explanation": "Purananuru employs inverted syntax placing dynamic verbs ahead of subjects to amplify emotional intensity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book"