{"id": "12th_tamil_u1_q009", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamil_nadai_azhagiyal", "chapter_id": null, "topic_id": "foreign_professorship", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பேராசிரியர் தி.சு. நடராசன் எந்தப் புகழ்பெற்ற வெளிநாட்டுப் பல்கலைக்கழகத்தில் பேராசிரியராகப் பணியாற்றித் தமிழ்ப் பணியாற்றினார்?", "media_id": null}], "options": {"A": "போலந்து வார்சா பல்கலைக்கழகம்", "B": "லண்டன் பல்கலைக்கழகம்", "C": "சிங்கப்பூர் தேசிய பல்கலைக்கழகம்", "D": "மலேசியா மலாயா பல்கலைக்கழகம்"}, "explanation": "தி.சு. நடராசன் போலந்து நாட்டின் வார்சா பல்கலைக்கழகத்தில் தமிழ் பேராசிரியராகப் பணியாற்றி சர்வதேச அளவில் தமிழியல் ஆய்வு செய்தார்."}, "en": {"blocks": [{"type": "text", "content": "In which prestigious foreign university did Prof. T. S. Natarajan serve as Professor of Tamil?", "media_id": null}], "options": {"A": "University of Warsaw, Poland", "B": "University of London", "C": "National University of Singapore", "D": "University of Malaya"}, "explanation": "Prof. T. S. Natarajan served as visiting Professor of Tamil at the University of Warsaw, Poland."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "