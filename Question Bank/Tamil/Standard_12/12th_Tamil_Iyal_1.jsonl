{"id": "12th_tamil_u1_q122", "schema_version": "1.0", "kind": "grammar_rule", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamizhaai_ezhuthuvom", "chapter_id": null, "topic_id": "initial_letter_rules", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் மொழியில் சொல்லின் முதல் எழுத்தாக வராத மெய்யெழுத்துகள் எவை?", "media_id": null}], "options": {"A": "க, ச, த, ப", "B": "ட, ண, ர, ல, ழ, ள, ற, ன ஆகிய மெய்கள் தனித்துச் சொல்லின் முதலில் வரா", "C": "ஞ, ய, வ", "D": "அ, ஆ, இ"}, "explanation": "ட, ண, ர, ல, ழ, ள, ற, ன ஆகிய எட்டு மெய்யெழுத்துகளும் அவற்றின் உயிர்மெய் வடிவங்களும் தமிழ்ச் சொல்லின் முதலில் வரா (அவ்வாறு வந்தால் அவை பிறமொழிச் சொற்கள்)."}, "en": {"blocks": [{"type": "text", "content": "Which consonants or their vowel-consonant derivations NEVER initiate native Tamil words?", "media_id": null}], "options": {"A": "Ka, Sa, Tha, Pa", "B": "Ta, Nna, Ra, La, Zha, Lha, Rra, Na (ட, ண, ர, ல, ழ, ள, ற, ன)", "C": "Nja, Ya, Va", "D": "A, Aa, I"}, "explanation": "Native Tamil roots strictly bar retroflex stops, nasals, liquids, and trills from initial word position."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 12, "chapter": null, "section":