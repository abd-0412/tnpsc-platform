{"id": "12th_tamil_u1_q181", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tnpsc_pyq_integration", "chapter_id": null, "topic_id": "bharathi_letters_compiler", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பாரதி கடிதங்கள்’ என்னும் அரிய வரலாற்று ஆவண நூலைத் தொகுத்துப் பதிப்பித்தவர் யார்?", "media_id": null}], "options": {"A": "ரா.அ. பத்மநாபன்", "B": "பரலி சு. நெல்லையப்பர்", "C": "வ.ரா.", "D": "பெ.சு. மணி"}, "explanation": "ரா.அ. பத்மநாபன் அவர்கள் பாரதியாரின் கடிதங்களைத் தேடிக் கண்டறிந்து ‘பாரதி கடிதங்கள்’ என்னும் நூலாகத் தொகுத்துப் பதிப்பித்தார்."}, "en": {"blocks": [{"type": "text", "content": "Who meticulously compiled and published the monumental anthology 'Bharathi Kadithangal'?", "media_id": null}], "options": {"A": "R. A. Padmanabhan", "B": "Parali S. Nellaiyappar", "C": "V. Ramasamy (Va.Ra)", "D": "P. S. Mani"}, "explanation": "R.A. Padmanabhan compiled and published Bharathi Kadithangal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 12, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 12", "url": null, "source_notes": null}, "previous_year": {"is