{"id": "12th_tamil_u1_q119", "schema_version": "1.0", "kind": "grammar_rule", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamizhaai_ezhuthuvom", "chapter_id": null, "topic_id": "la_lha_terminal_rules", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சொல்லின் இறுதியில் ‘லகர, ளகர, ழகர’ மெய்கள் வருவது பற்றிய விதி எது?", "media_id": null}], "options": {"A": "சொல்லின் இறுதியில் லகர மெய் மட்டுமே வரும்", "B": "சொல்லின் இறுதியில் ளகர மெய் வராது", "C": "ல், ள், ழ் ஆகிய மூன்று மெய்களும் சொல்லின் இறுதி எழுத்துகளாக வரலாம் (எ.கா: பால், வாள், தமிழ்)", "D": "எந்த மெய்யும் சொல்லின் இறுதியில் வராது"}, "explanation": "நன்னூல் மொழி இறுதி எழுத்துகள் விதியின்படி ல், ள், ழ் ஆகிய மூன்று மெய் எழுத்துகளும் சொல்லின் இறுதியில் அமையும் (பால், வாள், புகழ்)."}, "en": {"blocks": [{"type": "text", "content": "What grammatical rule governs the terminal occurrence of 'L', 'Lh', and 'Zh' consonants?", "media_id": null}], "options": {"A": "Only 'l' occurs terminally", "B": "'Lh' never terminates a word", "C": "All three consonants (ல், ள், ழ்) legitimately terminate Tamil words (e.g., Paal, Vaal, Tamizh)", "D": "No consonant ever terminates words"}, "explanation": "According to classical phonology, all three lateral/approximant consonants can end words."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "p