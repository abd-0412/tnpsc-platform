{"id": "12th_tamil_u1_q071", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "thanner_ilaatha_tamil", "chapter_id": null, "topic_id": "iru_darkness_types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கதிரவனும் தமிழும் நீக்கும் இரண்டு வகை இருள்கள் எவை?", "media_id": null}], "options": {"A": "குளிரிருள், மழையிருள்", "B": "இரவிருள், பகலிருள்", "C": "கதிரவன் நீக்குவது புற இருள்; தமிழ் நீக்குவது மக்களின் அறியாமை என்னும் அக இருள்", "D": "காட்டிருள், மலையிருள்"}, "explanation": "கதிரவன் உலகத்தின் புறத்தே உள்ள கண்களுக்குத் தெரியும் இருளைப் போக்குகிறது; தமிழோ மனிதர்களின் உள்ளத்தில் உள்ள அறியாமை என்னும் அக இருளை நீக்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "What are the two distinct types of darkness dispelled by the Sun and Tamil?", "media_id": null}], "options": {"A": "Cold darkness and rain darkness", "B": "Night shadow and daytime eclipse", "C": "The Sun dispels external physical darkness; Tamil eliminates internal mental ignorance", "D": "Forest darkness and canyon gloom"}, "explanation": "The Sun eliminates external physical darkness, whereas Tamil purges existential ignorance."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class":