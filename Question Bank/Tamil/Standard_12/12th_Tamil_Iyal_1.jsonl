{"id": "12th_tamil_u1_q146", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "mozhi_thiran", "chapter_id": null, "topic_id": "nellaiyappar_books", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கண்ணன் பாட்டு உரை’, ‘பாரதி வாழ்த்து’ ஆகிய நூல்களை இயற்றியவர் யார்?", "media_id": null}], "options": {"A": "ரா.அ. பத்மநாபன்", "B": "பரலி சு. நெல்லையப்பர்", "C": "வ.உ. சிதம்பரனார்", "D": "சுப்பிரமணிய சிவா"}, "explanation": "பரலி சு. நெல்லையப்பர் பாரதி வாழ்த்து, கண்ணன் பாட்டு உரை போன்ற நூல்களை இயற்றியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the books 'Kannan Paattu Urai' and 'Bharathi Vaazhthu'?", "media_id": null}], "options": {"A": "R. A. Padmanabhan", "B": "Parali S. Nellaiyappar", "C": "V. O. Chidambaranar", "D": "Subramaniya Siva"}, "explanation": "Parali S. Nellaiyappar authored Kannan Paattu Urai and Bharathi Vaazhthu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 13, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 13", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null