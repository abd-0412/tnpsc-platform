{"id": "12th_tamil_u1_q102", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "thambi_nellaiyapparukku", "chapter_id": null, "topic_id": "pondicherry_exile", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியார் புதுச்சேரியில் எத்தனை ஆண்டுகள் பிரிட்டிஷ் அரசின் கைது நடவடிக்கைக்கு அஞ்சித் தலைமறைவு வாழ்வு நடத்தினார்?", "media_id": null}], "options": {"A": "5 ஆண்டுகள்", "B": "சுமார் 10 ஆண்டுகள் (1908 முதல் 1918 வரை)", "C": "15 ஆண்டுகள்", "D": "2 ஆண்டுகள்"}, "explanation": "பாரதியார் ஆங்கிலேய அரசின் பிடியிலிருந்து தப்பிப் பிரெஞ்சு ஆதிக்கத்திலிருந்த புதுச்சேரியில் 1908 முதல் 1918 வரை 10 ஆண்டுகள் வாழ்ந்தார்."}, "en": {"blocks": [{"type": "text", "content": "For approximately how many years did Bharati live in political exile in French Pondicherry?", "media_id": null}], "options": {"A": "5 years", "B": "Approximately 10 years (1908 to 1918)", "C": "15 years", "D": "2 years"}, "explanation": "Bharati stayed in political refuge in French Pondicherry for a decade (1908-1918)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 9, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 9", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 1", "Supplementary", "Pondicherry Exile"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u1_q103", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "thambi_nellaiyapparukku", "chapter_id": null, "topic_id": "nellaiyappar_poems", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பரலி சு. நெல்லையப்பர் இயற்றிய கவிதை நூல் எது?", "media_id": null}], "options": {"A": "நிலவுப்பூ", "B": "கண்ணன் பாட்டு", "C": "நெல்லைத் தென்றல்", "D": "அழகின் சிரிப்பு"}, "explanation": "பரலி சு. நெல்லையப்பர் 'நெல்லைத் தென்றல்' என்னும் கவிதை நூலையும், உய்யும் வழி, பாரதி வாழ்த்து உள்ளிட்ட நூல்களையும் இயற்றியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which poetry collection was authored by Parali S. Nellaiyappar himself?", "media_id": null}], "options": {"A": "Nilavuppoo", "B": "Kannan Paattu", "C": "Nellai-th Thendral", "D": "Azhagin Sirippu"}, "explanation": "Nellaiyappar composed original verses in his collection titled 'Nellai-th Thendral'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 11, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 11", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "ex