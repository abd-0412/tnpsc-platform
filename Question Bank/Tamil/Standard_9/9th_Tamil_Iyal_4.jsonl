{"id": "9th-u4-q057", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l2", "chapter_id": null, "topic_id": "kudumba-vilakku-intro", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதிதாசன் இயற்றிய 'குடும்ப விளக்கு' என்னும் நூல் எத்தனை பகுதிகளாகப் பகுக்கப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "ஐந்து பகுதிகள்", "B": "நான்கு பகுதிகள்", "C": "ஆறு பகுதிகள்", "D": "மூன்று பகுதிகள்"}, "explanation": "பாரதிதாசன் இயற்றிய குடும்ப விளக்கு நூல் ஐந்து பகுதிகளாகப் பகுக்கப்பட்டுள்ளது. பாடப்பகுதி இரண்டாம் பகுதியில் அமைந்துள்ள 'விருந்தோம்பல்' தலைப்பில் உள்ள தலைவியின் பேச்சாகும்."}, "en": {"blocks": [{"type": "text", "content": "How many parts is the work 'Kudumba Vilakku' authored by Bharathidasan divided into?", "media_id": null}], "options": {"A": "Five parts", "B": "Four parts", "C": "Six parts", "D": "Three parts"}, "explanation": "'Kudumba Vilakku' written by Bharathidasan is structured into five parts. The textbook portion is taken from Part 2 under the heading 'Hospitality' (Virundhombal)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 87, "chapter": null, "section": null