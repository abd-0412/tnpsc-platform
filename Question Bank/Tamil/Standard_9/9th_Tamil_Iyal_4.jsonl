{"id": "9th-u4-q070", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l2", "chapter_id": null, "topic_id": "bharathidasan-works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வருவனவற்றுள் பாரதிதாசன் இயற்றாத நூல் எது?", "media_id": null}], "options": {"A": "பாண்டியன் பரிசு", "B": "தேனாறு", "C": "இருண்ட வீடு", "D": "அழகின் சிரிப்பு"}, "explanation": "பாண்டியன் பரிசு, அழகின் சிரிப்பு, இருண்ட வீடு, குடும்ப விளக்கு, தமிழ் இயக்கம், இசையமுது ஆகியவை பாரதிதாசனின் நூல்களாகும். 'தேனாறு' என்பது அவரது படைப்பல்ல."}, "en": {"blocks": [{"type": "text", "content": "Which of the following books was NOT authored by Bharathidasan?", "media_id": null}], "options": {"A": "Pandiyan Parisu", "B": "Thaenaaru", "C": "Irunda Veedu", "D": "Azhagin Sirippu"}, "explanation": "Pandiyan Parisu, Azhagin Sirippu, Irunda Veedu, Tamil Iyakkam, and Kudumba Vilakku were written by Bharathidasan; 'Thaenaaru' is not his work."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 89, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 89", "url": null, "source_notes": null}, "previous_year": {