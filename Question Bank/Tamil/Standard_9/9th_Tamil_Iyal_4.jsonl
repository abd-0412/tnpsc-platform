{"id": "9th-u4-q073", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l2", "chapter_id": null, "topic_id": "kudumba-vilakku-content", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"சமைப்பது தாழ்வென எண்ணலாகாது; இன்பம் சமைப்பவர் சமையல் செய்வார்!\" - இக்கருத்து உணர்த்துவது யாது?", "media_id": null}], "options": {"A": "சமையல் பணி இன்பம் தரக்கூடியது, அதனை இழிவாக எண்ணுதல் தவறு", "B": "சமையல் பணி பெண்களுக்கே உரித்தானது", "C": "சமைப்பவர்கள் மட்டுமே உணவருந்த வேண்டும்", "D": "சமையல் கலையைக் கற்கக் கூடாது"}, "explanation": "சமைப்பது வாழ்வையும் அன்பையும் வளர்க்கும் இன்பமான செயலாகும்; அதனை இழிவான அடிமைப்பணி என எண்ணுதல் தவறு என்பதைப் பாரதிதாசன் இப்பாடல் மூலம் உணர்த்துகிறார்."}, "en": {"blocks": [{"type": "text", "content": "\"Do not deem cooking as demeaning; those who craft joy are the ones who cook!\" - What does this statement convey?", "media_id": null}], "options": {"A": "Cooking brings profound joy and sustaining care; considering it inferior is an error", "B": "Cooking should remain solely a female responsibility", "C": "Only cooks are entitled to partake in meals", "D": "Culinary arts should not be learned"}, "explanation": "Bharathidasan elevates culinary art, showing that cooking sustains and crafts familial joy, debunking the myth that it is an inferior chore."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allo