{"id": "9th-u4-q063", "schema_version": "1.0", "kind": "grammar", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l2", "chapter_id": null, "topic_id": "kudumba-vilakku-grammar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மாக்கடல்' என்பதன் இலக்கணக் குறிப்பு யாது?", "media_id": null}], "options": {"A": "பண்புத்தொகை", "B": "உவமைத்தொகை", "C": "உரிச்சொல் தொடர்", "D": "வினைத்தொகை"}, "explanation": "'மா' என்பது மிகுதி அல்லது பெரியது என்னும் பொருளுணர்த்தும் உரிச்சொல். 'மா + கடல் = மாக்கடல்' என்பது உரிச்சொல் தொடர் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the grammatical classification of the term 'Maakkadal'?", "media_id": null}], "options": {"A": "Quality compound (Panbuth-thogai)", "B": "Metaphorical compound (Uvamaith-thogai)", "C": "Intensifying particle phrase (Urichol Thodar)", "D": "Verbal compound (Vinaith-thogai)"}, "explanation": "'Maa' is an intensifying qualitative particle (urichol) signifying grandeur/vastness. 'Maa + Kadal = Maakkadal' is classified as Urichol Thodar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 88, "chapter": null, "section": null, "reference": "9th Tamil, Unit