{"id": "9th-u4-q105", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l4", "chapter_id": null, "topic_id": "anna-two-language-policy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பேரறிஞர் அண்ணா தமிழகத்தில் நடைமுறைப்படுத்திய மொழிக் கொள்கை எது?", "media_id": null}], "options": {"A": "இருமொழிக் கொள்கை (தமிழ், ஆங்கிலம்)", "B": "மும்மொழிக் கொள்கை (தமிழ், ஆங்கிலம், இந்தி)", "C": "தனித்தமிழ்க் கொள்கை", "D": "செம்மொழிக் கொள்கை"}, "explanation": "பேரறிஞர் அண்ணா 1968 ஆம் ஆண்டு தமிழகச் சட்டமன்றத்தில் வரலாற்றுச் சிறப்புமிக்க 'இருமொழிக் கொள்கை' (தமிழ், ஆங்கிலம்) தீர்மானத்தை நிறைவேற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Which linguistic policy resolution was pioneered and enacted by Perarignar Anna in Tamil Nadu?", "media_id": null}], "options": {"A": "Two-Language Policy (Tamil, English)", "B": "Three-Language Policy (Tamil, English, Hindi)", "C": "Exclusive Tamil Policy", "D": "Classical Language Policy"}, "explanation": "In 1968, Chief Minister Anna enacted the landmark Two-Language Policy resolution mandating Tamil and English for Tamil Nadu administration and schooling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class"