{"id": "9th-u4-q077", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l2", "chapter_id": null, "topic_id": "bharathidasan-works-list", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதிதாசனின் படைப்புகளில் குடும்ப உறவுகளின் மாண்பையும் பெண் கல்வியின் அவசியத்தையும் வலியுறுத்தும் காவியம் எது?", "media_id": null}], "options": {"A": "குடும்ப விளக்கு", "B": "இருண்ட வீடு", "C": "குறிஞ்சித்திட்டு", "D": "கண்ணகி புரட்சிக்காப்பியம்"}, "explanation": "குடும்ப அமைப்பின் மேன்மையையும், விருந்தோம்பல் பண்பையும், பெண்கள் கல்வி கற்பதன் இன்றியமையாமையையும் உணர்த்தும் பாரதிதாசனின் ஒப்பற்ற காவியம் 'குடும்ப விளக்கு' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which poetic epic of Bharathidasan highlights the dignity of familial relationships and the paramount necessity of female education?", "media_id": null}], "options": {"A": "Kudumba Vilakku", "B": "Irunda Veedu", "C": "Kurinji-thittu", "D": "Kannagi Puratchik-kaappiyam"}, "explanation": "'Kudumba Vilakku' is Bharathidasan's monumental poetic work portraying the virtues of family life, hospitality, and female literacy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full