{"id": "9th-u4-q118", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l5", "chapter_id": null, "topic_id": "main-vs-aux-concept", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூட்டுவினையில் தன் அடிப்படைப் பொருளைத் தரும் வினை எது?", "media_id": null}], "options": {"A": "துணைவினை", "B": "முதல் வினை", "C": "சார்பு வினை", "D": "இணைப்பு வினை"}, "explanation": "ஒரு கூட்டுவினையில் இரு உறுப்புகள் இருக்கும்போது, முதல் உறுப்பாக வந்து தன் அடிப்படை அகராதிப் பொருளைத் தரும் வினை 'முதல் வினை' (Main Verb) எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "In a complex compound verb sequence, which constituent retains its primary lexical/dictionary meaning?", "media_id": null}], "options": {"A": "Auxiliary verb", "B": "Main verb (Mudhal-vinai)", "C": "Dependent verb", "D": "Connective verb"}, "explanation": "In a compound verbal phrase, the initial verbal element that denotes the core lexical action is the Main Verb (Mudhal-vinai)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 96, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 96", "url": null, "source_no