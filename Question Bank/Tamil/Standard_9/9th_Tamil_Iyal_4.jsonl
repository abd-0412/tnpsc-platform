{"id": "9th-u4-q110", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l3", "chapter_id": null, "topic_id": "uyir-vagai-quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"நேரிதின் உணர்ந்தோர் நெறிப்படுத்தினரே\" என்னும் தொல்காப்பியத் தொடர் உணர்த்துவது யாது?", "media_id": null}], "options": {"A": "தொல்காப்பியரே அனைத்தையும் புதிதாக உருவாக்கினார்", "B": "முன்னோர்களின் கூரிய அறிவியல் நுட்பத்தை ஆய்ந்து வகைப்படுத்தினர்", "C": "இயற்கையின் விதிகளை யாரும் மாற்ற இயலாது", "D": "இலக்கண விதிகள் மாறாதவை"}, "explanation": "'நேரிதின் உணர்ந்தோர் நெறிப்படுத்தினரே' என்பது, தமக்கு முன்னரே உயிரினங்களின் புலன் உணர்வுகளைத் துல்லியமாக உணர்ந்து வகைப்படுத்திய முன்னோரின் மரபினைப் போற்றி நெறிப்படுத்தியுள்ளார் என்பதை உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What does the classical phrase 'Naeridhin unarndhor nerippaduthinare' from Tholkappiyam imply?", "media_id": null}], "options": {"A": "Tholkappiyar created the entire classification system ex nihilo", "B": "Ancient scientific observers accurately perceived natural stages and codified them into traditional canon", "C": "Laws of nature can never be observed", "D": "Grammar rules are immutable"}, "explanation": "The phrase signifies that earlier discerning scholars/scientists keenly perceived sensory evolution, and Tholkappiyar codified that validated heritage."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 90, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 90", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_4", "uyir_vagai", "phrases"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u4-q111", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l4", "chapter_id": null, "topic_id": "anna-renaming-state", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சென்னை மாகாணத்தை 'தமிழ்நாடு' என்று பேரறிஞர் அண்ணா பெயர் மாற்றம் செய்த ஆண்டு எது?", "media_id": null}], "options": {"A": "1967", "B": "1968", "C": "1969", "D": "1970"}, "explanation": "பேரறிஞர் அண்ணா தலைமையிலான அரசு 1968-ல் தீர்மானம் இயற்றி, 1969 ஜனவரி 14 அன்று 'சென்னை மாகாணம்' என்பதை அதிகாரப்பூர்வமாக 'தமிழ்நாடு' என்று பெயர் மாற்றம் செய்தது."}, "en": {"blocks": [{"type": "text", "content": "In which year was Madras State officially renamed 'Tamil Nadu' under Chief Minister Perarignar Anna?", "media_id": null}], "options": {"A": "1967", "B": "1968", "C": "1969", "D": "1970"}, "explanation": "Madras State was officially renamed 'Tamil Nadu' on January 14, 1969 following the historic resolution spearheaded by Anna."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 95, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 95", "url": null, "source_notes": null}, "previous_year": {"is_prev