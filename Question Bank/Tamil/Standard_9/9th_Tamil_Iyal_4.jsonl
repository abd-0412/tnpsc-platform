{"id": "9th-u4-q068", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l2", "chapter_id": null, "topic_id": "bharathidasan-bio", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதிதாசனின் இயற்பெயர் யாது?", "media_id": null}], "options": {"A": "சுப்பிரமணியன்", "B": "துரைராசு", "C": "இராசகோபாலன்", "D": "கனகசுப்புரத்தினம்"}, "explanation": "பாரதிதாசனின் இயற்பெயர் கனகசுப்புரத்தினம் ஆகும். பாரதியாரின் கவிதைகள் மீது கொண்ட ஈர்ப்பினால் தம் பெயரைப் பாரதிதாசன் என மாற்றிக்கொண்டார்."}, "en": {"blocks": [{"type": "text", "content": "What was the original birth name of poet Bharathidasan?", "media_id": null}], "options": {"A": "Subramanian", "B": "Durairasu", "C": "Rajagopalan", "D": "Kanakasubburathinam"}, "explanation": "Bharathidasan's birth name was Kanakasubburathinam. Due to his reverence for Subramania Bharati, he adopted the pen name Bharathidasan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 89, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 89", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": n