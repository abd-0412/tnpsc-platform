{"id": "9th-u4-q150", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l6", "chapter_id": null, "topic_id": "book-back-evaluation-q3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"மங்கையராய்ப் பிறப்பதற்கே நல்ல மாதவம் செய்திடல் வேண்டுமம்மா!\" - இப்புகழ்பெற்ற வரிகளைப் பாடிய கவிஞர் யார்?", "media_id": null}], "options": {"A": "பாரதியார்", "B": "கவிமணி தேசிக விநாயகம் பிள்ளை", "C": "பாரதிதாசன்", "D": "வாணிதாசன்"}, "explanation": "'மங்கையராய்ப் பிறப்பதற்கே நல்ல மாதவம் செய்திடல் வேண்டுமம்மா' என்று பெண்ணின் பிறவிப் பெருமையை உணர்த்தியவர் கவிமணி தேசிக விநாயகம் பிள்ளை ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "\"To be born as a woman on this earth, one must have performed great penance, O mother!\" - Who wrote these celebrated lines?", "media_id": null}], "options": {"A": "Bharati", "B": "Kavimani Desigavinayagam Pillai", "C": "Bharathidasan", "D": "Vanidasan"}, "explanation": "Kavimani Desigavinayagam Pillai praised womanhood with this evergreen poetic observation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 99, "chapter": null, "section": null, "reference": "9t