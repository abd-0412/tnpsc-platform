{"id": "9th-u4-q115", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l5", "chapter_id": null, "topic_id": "compound-verb-types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூட்டுவினைகள் பொதுவாக எத்தனை முறைகளில் ஆக்கப்படுகின்றன?", "media_id": null}], "options": {"A": "இரண்டு முறைகள்", "B": "நான்கு முறைகள்", "C": "மூன்று முறைகள்", "D": "ஐந்து முறைகள்"}, "explanation": "கூட்டுவினைகள் பொதுவாக 3 முறைகளில் ஆக்கப்படுகின்றன: 1. பெயர் + வினை -> வினை, 2. வினை + வினை -> வினை, 3. இடை + வினை -> வினை."}, "en": {"blocks": [{"type": "text", "content": "In how many standard structural patterns are compound verbs typically formed in Tamil?", "media_id": null}], "options": {"A": "Two patterns", "B": "Four patterns", "C": "Three patterns", "D": "Five patterns"}, "explanation": "Compound verbs are constructed in three patterns: 1. Noun + Verb -> Verb, 2. Verb + Verb -> Verb, 3. Particle + Verb -> Verb."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 96, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 96", "url": null, "source_notes": null}, "previous_year": {"is_pr