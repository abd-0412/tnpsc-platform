{"id": "9th-u4-q092", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l4", "chapter_id": null, "topic_id": "anna-speech", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒன்பதாம் வகுப்புப் பாடப்பகுதியில் இடம் பெற்றுள்ள பேரறிஞர் அண்ணாவின் 'வீட்டிற்கோர் புத்தகசாலை' எந்த ஊடகத்தில் நிகழ்த்திய உரை?", "media_id": null}], "options": {"A": "தொலைக்காட்சி உரை", "B": "சட்டமன்றப் பேச்சு", "C": "பல்கலைக்கழகப் பட்டமளிப்பு உரை", "D": "வானொலி உரை (ஆகாசவாணி)"}, "explanation": "பேரறிஞர் அண்ணா வானொலியில் (Radio) ஆற்றிய உரையின் தொகுப்பே 'வீட்டிற்கோர் புத்தகசாலை' என்னும் பாடப்பகுதியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Through which media platform was Perarignar Anna's discourse 'Veettirkor Puthagasaalai' originally broadcast?", "media_id": null}], "options": {"A": "Television address", "B": "Legislative assembly speech", "C": "University convocation address", "D": "Radio broadcast (Akashvani)"}, "explanation": "'Veettirkor Puthagasaalai' is compiled from Perarignar Anna's renowned radio address emphasizing public literacy and home libraries."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-