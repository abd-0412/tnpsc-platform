{"id": "9th-u4-q043", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u4-kalvi", "lesson_id": "lesson-01-kalviyil-sirantha-pengal", "chapter_id": null, "topic_id": "topic-kalviyil-sirantha-pengal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'முடியாது பெண்ணாலே என்கின்ற மாயையினை முடக்க எழுந்தவர் யாரு... தந்தை பெரியாரு' - இவ்வடிகள் உணர்த்தும் செய்தி யாது?", "media_id": null}], "options": {"A": "பெண்கள் வீட்டு வேலை மட்டுமே செய்ய வேண்டும்", "B": "பெண்களுக்குப் புதிய உடைகள் வாங்கித் தருவது", "C": "பெண்களால் எதையும் சாதிக்க முடியாது என்ற பொய் மாயையை உடைத்தெறிந்த பெரியாரின் புரட்சி", "D": "பெண்கள் திருமணத்திற்காக வாழ வேண்டும்"}, "explanation": "பெண்களால் முடியாது என்று சமூகம் கட்டிவைத்த மாயைகளை உடைத்து, பெண்களின் சம உரிமைக்கும் கல்விக்கும் குரல் கொடுத்த தந்தை பெரியாரின் சிந்தனையை இவ்வடி விளக்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "What social transformation is hailed in 'Mudiyadhu pennalae engindra maayaiyinai mudakka ezhundhavar yaaru... Thanthai Periyaru'?", "media_id": null}], "options": {"A": "Women should restrict themselves to kitchen chores", "B": "Purchasing dresses for girls", "C": "Periyar's radical crusade shattering the misogynist myth that women are incapable of high achievement", "D": "Encouraging early child marriage"}, "explanation": "The song celebrates Periyar's uncompromising championing of women's intellectual power and debunking of gender disabilities."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null