{"id": "9th-u4-q097", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l4", "chapter_id": null, "topic_id": "anna-plays", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பேரறிஞர் அண்ணா இயற்றிய புகழ்பெற்ற வரலாற்று நாடகம் எது?", "media_id": null}], "options": {"A": "சிவாஜி கண்ட இந்து சாம்ராஜ்யம்", "B": "மந்திரி குமாரி", "C": "மனோகரா", "D": "பராசக்தி"}, "explanation": "அண்ணா இயற்றிய புகழ்பெற்ற வரலாற்று நாடகம் 'சிவாஜி கண்ட இந்து சாம்ராஜ்யம்' ஆகும். இதில் சிவாஜியாக நடிகர் திலகம் சிவாஜி கணேசன் நடித்துப் பெரும் புகழ் பெற்றார்."}, "en": {"blocks": [{"type": "text", "content": "Which famous historical play was penned by Perarignar Anna?", "media_id": null}], "options": {"A": "Sivaji Kanda Hindu Saamraajyam", "B": "Manthiri Kumari", "C": "Manohara", "D": "Parasakthi"}, "explanation": "'Sivaji Kanda Hindu Saamraajyam' was Anna's iconic historical drama, in which actor Sivaji Ganesan played Chhatrapati Shivaji and earned his screen name."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 95, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 95", "url": null, "source_n