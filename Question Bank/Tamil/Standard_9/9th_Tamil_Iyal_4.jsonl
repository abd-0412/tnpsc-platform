{"id": "9th-u4-q078", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l2", "chapter_id": null, "topic_id": "kudumba-vilakku-subparts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒன்பதாம் வகுப்புப் பாடப்பகுதியில் இடம்பெற்றுள்ள குடும்ப விளக்கு பாடல் எந்தப் பகுதியில் உள்ள எந்தத் தலைப்பில் அமைந்துள்ளது?", "media_id": null}], "options": {"A": "முதற்பகுதி - மழலைச் செல்வம்", "B": "இரண்டாம் பகுதி - விருந்தோம்பல்", "C": "மூன்றாம் பகுதி - திருமண விருந்து", "D": "நான்காம் பகுதி - மக்கட்பேறு"}, "explanation": "குடும்ப விளக்கு நூல் ஐந்து பகுதிகளைக் கொண்டது. பாடப்பகுதியில் இடம்பெற்றுள்ள தலைவியின் பேச்சு இரண்டாம் பகுதியில் உள்ள 'விருந்தோம்பல்' என்னும் தலைப்பில் அமைந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Under which part and heading is the textbook poem from Kudumba Vilakku situated?", "media_id": null}], "options": {"A": "Part 1 - Mazhalaich Selvam", "B": "Part 2 - Virundhombal (Hospitality)", "C": "Part 3 - Wedding Feast", "D": "Part 4 - Child Bearing"}, "explanation": "Kudumba Vilakku comprises 5 parts; the textbook verses are excerpted from Part 2 under the section 'Virundhombal' (Hospitality)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services C