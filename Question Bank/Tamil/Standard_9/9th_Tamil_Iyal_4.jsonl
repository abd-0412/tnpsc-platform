{"id": "9th-u4-q009", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u4-kalvi", "lesson_id": "lesson-01-kalviyil-sirantha-pengal", "chapter_id": null, "topic_id": "topic-kalviyil-sirantha-pengal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடப்பகுதி வில்லுப்பாட்டில் குறிப்பிடப்படும் சங்க காலப் பெண்பாற் புலவர்களின் வரிசையில் சேராதவர் யார்?", "media_id": null}], "options": {"A": "காரைக்கால் அம்மையார்", "B": "ஔவையார்", "C": "குறமகள் இளவெயினி", "D": "வெண்ணிக் குயத்தியார்"}, "explanation": "ஔவையார், குறமகள் இளவெயினி, வெண்ணிக் குயத்தியார், மாறோக்கத்து நப்பசலையார் ஆகியோர் சங்க காலப் பெண்பாற் புலவர்கள். காரைக்கால் அம்மையார் பக்தி இயக்கக் காலப் புலவர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who among the following was NOT a Sangam-era poetess cited in the opening verse?", "media_id": null}], "options": {"A": "Karaikkal Ammaiyar", "B": "Avvaiyar", "C": "Kuramagal Ilaveyini", "D": "Vennik Kuyathiyar"}, "explanation": "Karaikkal Ammaiyar was an early medieval Saivite devotional poet, unlike Sangam poetesses Avvai, Ilaveyini, and Vennik Kuyathiyar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page":