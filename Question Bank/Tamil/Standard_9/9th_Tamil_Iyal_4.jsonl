{"id": "9th-u4-q002", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u4-kalvi", "lesson_id": "lesson-01-kalviyil-sirantha-pengal", "chapter_id": null, "topic_id": "topic-kalviyil-sirantha-pengal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியாவில் பெண்களுக்காக 1848-ல் தொடங்கப்பட்ட முதல் பள்ளியில் ஆசிரியராகப் பணியாற்றிய நாட்டின் முதல் பெண் ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "பண்டித ரமாபாய்", "B": "சாவித்திரிபாய் பூலே", "C": "மூவலூர் ராமாமிர்தம்", "D": "டாக்டர் முத்துலட்சுமி"}, "explanation": "1848-ஆம் ஆண்டு பெண்களுக்காகத் தொடங்கப்பட்ட பள்ளியில் ஆசிரியராகப் பணியாற்றிய சாவித்திரிபாய் பூலே (1831-1897) இந்தியாவின் முதல் பெண் ஆசிரியர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who served as the headteacher at the girls' school founded in 1848, revered as India's first female schoolteacher?", "media_id": null}], "options": {"A": "Pandita Ramabai", "B": "Savitribai Phule", "C": "Moovalur Ramamirtham", "D": "Dr. Muthulakshmi Reddi"}, "explanation": "Savitribai Phule (1831–1897), who taught at the school started in 1848 in Pune, is celebrated as India's first woman teacher."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "ter