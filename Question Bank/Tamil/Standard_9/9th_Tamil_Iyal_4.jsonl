{"id": "9th-u4-q125", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l5", "chapter_id": null, "topic_id": "verb-irundhaan-aux", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"அவன் தூங்கிக் கொண்டிருந்தான்\" - இதில் துணைவினையாக அமைந்துள்ள சொல் எது?", "media_id": null}], "options": {"A": "கொண்டிருந்தான்", "B": "தூங்கி", "C": "அவன்", "D": "தூங்கு"}, "explanation": "இத்தொடரில் 'தூங்கி' என்பது முதல் வினை (தூங்குதல் தொழில்). 'கொண்டிருந்தான்' என்பது செயல் தொடர்ந்து நிகழ்வதைக் காட்டும் தொடர் காலத் துணைவினையாக அமைந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "In \"Avan thoongik kondirundhaan\" (He was sleeping), which element serves as the auxiliary verb?", "media_id": null}], "options": {"A": "kondirundhaan", "B": "thoongi", "C": "avan", "D": "thoongu"}, "explanation": "'Thoongi' is the main lexical verb; 'kondirundhaan' acts as the progressive aspectual auxiliary verb."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 97, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 97", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_4", "grammar", "thunai_vinai"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u4-q126", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l5", "chapter_id": null, "topic_id": "verb-vidu-aux", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"அப்பா வந்துவிட்டார்\" - இத்தொடரில் 'விட்டார்' என்னும் துணைவினை உணர்த்தும் இலக்கணப் பொருள் யாது?", "media_id": null}], "options": {"A": "முயற்சிப் பொருள்", "B": "முற்றுப் பொருள் (செயல் முடிவடைந்தது)", "C": "தொடர்ச்சிப் பொருள்", "D": "வியப்புப் பொருள்"}, "explanation": "'வந்துவிட்டார்' என்பதில் 'வந்து' முதல் வினை. 'விட்டார்' என்னும் துணைவினை செயல் முழுமையாக முடிந்துவிட்டது என்பதை உணர்த்தும் 'முற்றுப் பொருள்' தரும் துணைவினையாக வந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "In \"Appa vandhuvittaar\", what grammatical nuance does the auxiliary 'vittaar' signify?", "media_id": null}], "options": {"A": "Conative attempt", "B": "Completive aspect (Muttrup-porul)", "C": "Continuative aspect", "D": "Exclamatory sense"}, "explanation": "'Vandhu' is the main verb; the auxiliary 'vittaar' denotes perfective completion of the arrival."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 97, "chapter": null,