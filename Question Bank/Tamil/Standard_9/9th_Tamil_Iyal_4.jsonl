{"id": "9th-u4-q028", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u4-kalvi", "lesson_id": "lesson-01-kalviyil-sirantha-pengal", "chapter_id": null, "topic_id": "topic-kalviyil-sirantha-pengal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மருத்துவம் மற்றும் சமூக சீர்திருத்தப் பணிகளைப் பாராட்டி இந்திய அரசால் டாக்டர் முத்துலட்சுமி ரெட்டிக்கு வழங்கப்பட்ட உயரிய விருது எது?", "media_id": null}], "options": {"A": "பாரத ரத்னா", "B": "பத்மஸ்ரீ", "C": "நோபல் பரிசு", "D": "பத்ம பூஷண் விருது (1956)"}, "explanation": "டாக்டர் முத்துலட்சுமி ரெட்டியின் தன்னலமற்ற மருத்துவ மற்றும் மகளிர் விடுதலைச் சேவைகளைப் பாராட்டி இந்திய அரசு 1956-ஆம் ஆண்டு அவருக்கு 'பத்ம பூஷண்' வழங்கிச் சிறப்பித்தது."}, "en": {"blocks": [{"type": "text", "content": "Which prestigious national civilian honour was conferred upon Dr. Muthulakshmi Reddi by the Government of India in 1956?", "media_id": null}], "options": {"A": "Bharat Ratna", "B": "Padma Shri", "C": "Nobel Prize", "D": "Padma Bhushan (1956)"}, "explanation": "The Government of India honored Dr. Muthulakshmi Reddi with the Padma Bhushan in 1956 for her monumental humanitarian and medical services."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "c