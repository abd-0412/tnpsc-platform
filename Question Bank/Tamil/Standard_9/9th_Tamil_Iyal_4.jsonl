{"id": "9th-u4-q007", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u4-kalvi", "lesson_id": "lesson-01-kalviyil-sirantha-pengal", "chapter_id": null, "topic_id": "topic-kalviyil-sirantha-pengal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சென்னை அடையாற்றில் 1930-ல் 'அவ்வை இல்லம்' என்னும் ஆதரவற்றோர் இல்லத்தையும், 1952-ல் புற்றுநோய் மருத்துவமனையையும் நிறுவியவர் யார்?", "media_id": null}], "options": {"A": "அன்னை தெரசா", "B": "மூவலூர் ராமாமிர்தம்", "C": "டாக்டர் முத்துலட்சுமி ரெட்டி", "D": "டாக்டர் ஐடா ஸ்கடர்"}, "explanation": "டாக்டர் முத்துலட்சுமி ரெட்டி 1930-ல் ஆதரவற்ற பெண்களுக்காக 'அவ்வை இல்லம்' அமைத்தார்; 1952-ல் அடையாறு புற்றுநோய் மருத்துவமனைக்கு அடிக்கல் நாட்டி உருவாக்கினார்."}, "en": {"blocks": [{"type": "text", "content": "Who established the Avvai Home for destitutes in 1930 and the Adyar Cancer Institute in 1952?", "media_id": null}], "options": {"A": "Mother Teresa", "B": "Moovalur Ramamirtham", "C": "Dr. Muthulakshmi Reddi", "D": "Dr. Ida Scudder"}, "explanation": "Dr. Muthulakshmi Reddi founded Avvai Home in 1930 and spearheaded the establishment of the Cancer Institute at Adyar in 1952."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term