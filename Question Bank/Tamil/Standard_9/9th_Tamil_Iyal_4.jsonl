{"id": "9th-u4-q149", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l6", "chapter_id": null, "topic_id": "book-back-evaluation-q2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"பட்டங்கள் ஆள்வதும் சட்டங்கள் செய்வதும் பாரினில் பெண்கள் நடத்த வந்தோம்\" - என்று பாடியவர் யார்?", "media_id": null}], "options": {"A": "பாரதியார்", "B": "பாரதிதாசன்", "C": "கவிமணி", "D": "நாமக்கல் கவிஞர்"}, "explanation": "'பட்டங்கள் ஆள்வதும் சட்டங்கள் செய்வதும் பாரினில் பெண்கள் நடத்த வந்தோம் / எட்டு மறிவினில் ஆணுக் கிங்கேபெண் இளைப்பில்லை காணென்று கும்மியடி' என்று பாடியவர் மகாகவி பாரதியார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "\"To govern titles and enact laws in this world, we women have arrived!\" - Who penned this visionary song?", "media_id": null}], "options": {"A": "Mahakavi Bharati", "B": "Bharathidasan", "C": "Kavimani", "D": "Namakkal Kavignar"}, "explanation": "Mahakavi Subramania Bharati boldly championed women's political empowerment with these lines."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 99, "chapter": null, "section": null, "reference": "9th Tamil, Uni