{"id": "9th-u4-q029", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u4-kalvi", "lesson_id": "lesson-01-kalviyil-sirantha-pengal", "chapter_id": null, "topic_id": "topic-kalviyil-sirantha-pengal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழகத்தின் சமூகச் சீர்திருத்தவாதி, எழுத்தாளர், திராவிட இயக்க அரசியல் செயல்பாட்டாளர் மற்றும் தேவதாசி ஒழிப்புச் சட்டம் நிறைவேறத் துணைநின்றவர் யார்?", "media_id": null}], "options": {"A": "மூவலூர் ராமாமிர்தம் அம்மையார்", "B": "நீலாம்பிகை அம்மையார்", "C": "பண்டித ரமாபாய்", "D": "சாவித்திரிபாய் பூலே"}, "explanation": "மூவலூர் ராமாமிர்தம் அம்மையார் (1883-1962) தமிழகத்தின் சிறந்த சமூகச் சீர்திருத்தவாதியாகவும் எழுத்தாளராகவும் திகழ்ந்து தேவதாசி முறை ஒழிப்புக்குத் தீவிரமாகப் பாடுபட்டார்."}, "en": {"blocks": [{"type": "text", "content": "Who was the eminent social reformer, feminist author, and Dravidian activist who spearheaded the campaign to outlaw the Devadasi system?", "media_id": null}], "options": {"A": "Moovalur Ramamirtham Ammaiyar", "B": "Neelambigai Ammaiyar", "C": "Pandita Ramabai", "D": "Savitribai Phule"}, "explanation": "Moovalur Ramamirtham Ammaiyar (1883–1962) was a trailblazing crusader who campaigned tirelessly across Tamil Nadu to abolish the Devadasi system."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 83, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 83", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_4", "women_education", "villuppattu"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
