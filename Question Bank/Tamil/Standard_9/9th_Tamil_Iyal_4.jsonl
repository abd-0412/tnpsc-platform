{"id": "9th-u4-q076", "schema_version": "1.0", "kind": "grammar", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l2", "chapter_id": null, "topic_id": "kudumba-vilakku-grammar-terms", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஆக்கல், அமைத்தல், சமைத்தல்' ஆகிய சொற்களின் இலக்கணக் குறிப்பு யாது?", "media_id": null}], "options": {"A": "வினையெச்சங்கள்", "B": "பெயரெச்சங்கள்", "C": "முற்றெச்சங்கள்", "D": "தொழிற்பெயர்கள்"}, "explanation": "'தல்', 'அல்' விகுதி பெற்று தொழிலை உணர்த்தி நிற்பதால் ஆக்கல், அமைத்தல், சமைத்தல் என்பவை தொழிற்பெயர்கள் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the grammatical classification of the terms 'Aakkal, Amaithal, Samaithal'?", "media_id": null}], "options": {"A": "Verbal participles", "B": "Adjectival participles", "C": "Finite participles", "D": "Verbal nouns (Thozhir-peyargal)"}, "explanation": "Ending in suffixes like '-al' and denoting actions, 'Aakkal, Amaithal, Samaithal' are verbal nouns (Thozhir-peyargal)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 88, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 88", "url": null, "source_notes