{"id": "9th-u4-q064", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l2", "chapter_id": null, "topic_id": "kudumba-vilakku-lines", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"உணவினை ஆக்கல் மக்கட்கு உயிராக்கல் அன்றோ!\" - இப்பாடல் வரியை இயற்றியவர் யார்?", "media_id": null}], "options": {"A": "பாரதியார்", "B": "கவிமணி தேசிக விநாயகம் பிள்ளை", "C": "நாமக்கல் கவிஞர் வெ. இராமலிங்கம்", "D": "பாரதிதாசன்"}, "explanation": "'உணவினை ஆக்கல் மக்கட்கு உயிராக்கல் அன்றோ!' என்ற புகழ்பெற்ற வரிகள் பாரதிதாசன் இயற்றிய குடும்ப விளக்கு நூலில் உள்ள தலைவியின் பேச்சில் இடம்பெற்றுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "\"Preparing food for humankind is indeed bestowing life itself!\" - Who penned these inspiring poetic lines?", "media_id": null}], "options": {"A": "Subramania Bharati", "B": "Kavimani Desigavinayagam Pillai", "C": "Namakkal Kavignar V. Ramalingam", "D": "Bharathidasan"}, "explanation": "This famous line appears in 'Kudumba Vilakku' authored by Bharathidasan in the monologue of the matriarch."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 88, "chapter": null, "s