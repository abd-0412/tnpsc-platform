{"id": "9th-u4-q104", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l4", "chapter_id": null, "topic_id": "anna-motto", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அறிஞர் அண்ணாவின் வாழ்வியல் தாரக மந்திரமான 'கடமை, கண்ணியம், __________' என்பதில் விடுபட்ட சொல்லைத் தேர்க.", "media_id": null}], "options": {"A": "அமைதி", "B": "பொறுமை", "C": "வீரம்", "D": "கட்டுப்பாடு"}, "explanation": "பேரறிஞர் அண்ணா பொதுவாழ்விற்கும் இளைஞர்களுக்கும் வழங்கிய முழக்கம்: 'கடமை, கண்ணியம், கட்டுப்பாடு'."}, "en": {"blocks": [{"type": "text", "content": "\"Duty, Dignity, __________\" - Select the word completing Perarignar Anna's renowned golden motto.", "media_id": null}], "options": {"A": "Peace", "B": "Patience", "C": "Valour", "D": "Discipline (Kattuppaadu)"}, "explanation": "Anna's universally celebrated tri-fold motto for public life and youth was 'Kadamai, Kanniyam, Kattuppaadu' (Duty, Dignity, Discipline)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 94, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 94", "url": null, "source_notes": null}, "previous_year": {"is_previ