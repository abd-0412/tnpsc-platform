{"id": "9th-u4-q017", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u4-kalvi", "lesson_id": "lesson-01-kalviyil-sirantha-pengal", "chapter_id": null, "topic_id": "topic-kalviyil-sirantha-pengal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஆணும் பெண்ணும் இயற்கைப் படைப்பில் சமம் என்று நினைச்சாங்க முன்னோர்கள்... இடையில் குடிபுகுந்த மூடப்பழக்கங்களால் பெண்களைத் தாழ்த்தினாங்க' - என்று எந்தப் பாடம் விவரிக்கிறது?", "media_id": null}], "options": {"A": "கல்வியில் சிறந்த பெண்கள் (வில்லுப்பாட்டு)", "B": "குடும்ப விளக்கு", "C": "சிறுபஞ்சமூலம்", "D": "வீட்டிற்கோர் புத்தகசாலை"}, "explanation": "ஒன்பதாம் வகுப்பு இயல் 4 உரைநடை உலகமான 'கல்வியில் சிறந்த பெண்கள்' வில்லுப்பாட்டுப் பகுதியில் இவ்வடிகள் இடம்பெற்றுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "'Our ancestors regarded man and woman as equal creations of nature; later superstitions degraded womanhood' is sung in which lesson?", "media_id": null}], "options": {"A": "Kalviyil Sirantha Pengal (Villuppattu)", "B": "Kudumba Vilakku", "C": "Sirupanchamoolam", "D": "Veettirkoar Puthagasaalai"}, "explanation": "The lesson 'Kalviyil Sirantha Pengal' features this exact ballad verse highlighting original gender equality corrupted by medieval prejudices."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Ka