{"id": "9th-u4-q129", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l5", "chapter_id": null, "topic_id": "compound-verb-pattern-noun-verb", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஆணையிடு' என்னும் கூட்டுவினையில் அமைந்துள்ள ஆக்க முறை எது?", "media_id": null}], "options": {"A": "பெயர் + வினை -> வினை", "B": "வினை + வினை -> வினை", "C": "இடை + வினை -> வினை", "D": "பெயர் + பெயர் -> வினை"}, "explanation": "'ஆணை' என்பது பெயர்ச்சொல். 'இடு' என்பது வினைச்சொல். இரண்டும் இணைந்து 'ஆணையிடு' என்னும் கூட்டுவினையாக உருவாவதால் இது 'பெயர் + வினை -> வினை' வகையாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which morphological pattern forms the compound verb 'Aanaiyidu'?", "media_id": null}], "options": {"A": "Noun + Verb -> Verb", "B": "Verb + Verb -> Verb", "C": "Particle + Verb -> Verb", "D": "Noun + Noun -> Verb"}, "explanation": "'Aanai' (Order - Noun) + 'Idu' (Give/Place - Verb) combines to form 'Aanaiyidu' (To command), matching Noun + Verb -> Verb."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 96, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Pa