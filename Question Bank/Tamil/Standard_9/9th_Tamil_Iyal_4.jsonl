{"id": "9th-u4-q130", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l5", "chapter_id": null, "topic_id": "compound-verb-pattern-verb-verb", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'சொல்லிக்கொடு' என்னும் கூட்டுவினையில் அமைந்துள்ள ஆக்க முறை எது?", "media_id": null}], "options": {"A": "பெயர் + வினை -> வினை", "B": "வினை + வினை -> வினை", "C": "இடை + வினை -> வினை", "D": "வினை + பெயர் -> வினை"}, "explanation": "'சொல்லி' (வினையெச்சம்/வினை) + 'கொடு' (வினை) = சொல்லிக்கொடு. இது 'வினை + வினை -> வினை' என்னும் அமைப்பில் அமைந்த கூட்டுவினையாகும்."}, "en": {"blocks": [{"type": "text", "content": "What formation structure produces the compound verb 'Sollikkodu'?", "media_id": null}], "options": {"A": "Noun + Verb -> Verb", "B": "Verb + Verb -> Verb", "C": "Particle + Verb -> Verb", "D": "Verb + Noun -> Verb"}, "explanation": "'Solli' (Verb) + 'Kodu' (Verb) forms the compound verb 'Sollikkodu', fitting Verb + Verb -> Verb."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 96, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 96", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_4", "grammar", "koottu_vinai"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u4-q131", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l5", "chapter_id": null, "topic_id": "compound-verb-pattern-idai-verb", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பின்பற்று' என்னும் கூட்டுவினையில் அமைந்துள்ள ஆக்க முறை எது?", "media_id": null}], "options": {"A": "பெயர் + வினை -> வினை", "B": "வினை + வினை -> வினை", "C": "இடை + வினை -> வினை", "D": "பெயர் + இடை -> வினை"}, "explanation": "'பின்' என்பது இடைச்சொல். 'பற்று' என்பது வினைச்சொல். இரண்டும் இணைந்து 'பின்பற்று' என்னும் கூட்டுவினையாக அமைவதால் இது 'இடை + வினை -> வினை' வகையாகும்."}, "en": {"blocks": [{"type": "text", "content": "Under which pattern is the compound verb 'Pinpatru' derived?", "media_id": null}], "options": {"A": "Noun + Verb -> Verb", "B": "Verb + Verb -> Verb", "C": "Particle + Verb -> Verb", "D": "Noun + Particle -> Verb"}, "explanation": "'Pin' (spatial particle) + 'Patru' (Verb) produces 'Pinpatru', which corresponds to Particle + Verb -> Verb."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 96, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 96", "url": n