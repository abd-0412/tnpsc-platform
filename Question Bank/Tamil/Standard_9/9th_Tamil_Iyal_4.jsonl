{"id": "9th-u4-q093", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l4", "chapter_id": null, "topic_id": "anna-title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பேரறிஞர் அண்ணா எவ்வாறு போற்றப்படுகிறார்?", "media_id": null}], "options": {"A": "தென்னகத்துப் பெர்னாட்ஷா", "B": "தென்னாட்டுத் தாகூர்", "C": "தென்னகத்துக் காந்தி", "D": "தென்னாட்டு போஸ்"}, "explanation": "பேரறிஞர் அண்ணா தனது கூர்மையான அடுக்குமொழி உரைகளாலும், சமூக விழிப்புணர்வு நாடகங்களாலும் 'தென்னகத்துப் பெர்னாட்ஷா' என்று போற்றப்படுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "By which illustrious sobriquet is Perarignar Anna widely hailed?", "media_id": null}], "options": {"A": "South Indian Bernard Shaw (Thennagathu Bernard Shaw)", "B": "Rabindranath Tagore of South", "C": "Gandhi of the South", "D": "Subhas Chandra Bose of South"}, "explanation": "Perarignar Anna is renowned as the 'Bernard Shaw of the South' (Thennagathu Bernard Shaw) for his wit, oratorical brilliance, and socially progressive dramas."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 95, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 95", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_4", "arignar_anna", "titles"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u4-q094", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l4", "chapter_id": null, "topic_id": "anna-quotes", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"எனக்கு மிகவும் பிடித்த தோழன் யார் என்றால், நான் படிக்காத ஒரு நல்ல புத்தகத்தை வாங்கி வந்து என்னிடம் கொடுப்பவனே!\" - என்று கூறிய அமெரிக்க அதிபர் யார்?", "media_id": null}], "options": {"A": "ஜார்ஜ் வாஷிங்டன்", "B": "ஆபிரகாம் லிங்கன்", "C": "ரூஸ்வெல்ட்", "D": "ஜான் எப். கென்னடி"}, "explanation": "அமெரிக்க முன்னாள் குடியரசுத் தலைவர் ஆபிரகாம் லிங்கன், 'நான் படிக்காத ஒரு நல்ல புத்தகத்தை வாங்கி வந்து கொடுப்பவனே என்னுடைய சிறந்த தோழன்' என்று கூறியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "\"My best friend is a person who will give me a book I have not read!\" - Which US President is credited with this quote mentioned in the lesson?", "media_id": null}], "options": {"A": "George Washington", "B": "Abraham Lincoln", "C": "Franklin D. Roosevelt", "D": "John F. Kennedy"}, "explanation": "Abraham Lincoln famously declared that his best friend is someone who gifts him a good book he has not yet read, cited by Anna in his address."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpor