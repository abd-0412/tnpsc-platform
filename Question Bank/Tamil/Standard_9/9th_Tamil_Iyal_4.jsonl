{"id": "9th-u4-q114", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l5", "chapter_id": null, "topic_id": "verb-types-compound", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பகுபதமாக உள்ள வினை அடிகளைக் கொண்ட வினைகள் எவ்வாறு அழைக்கப்படுகின்றன?", "media_id": null}], "options": {"A": "தனிவினை", "B": "கூட்டுவினை", "C": "செயப்பாட்டு வினை", "D": "பிறவினை"}, "explanation": "பகுபதமாக உள்ள வினை அடிகளைக் கொண்ட வினைகள் 'கூட்டுவினை' (Compound Verb) எனப்படும். எ.கா: தந்தியடி, கண்டுபிடி, முன்னேறு."}, "en": {"blocks": [{"type": "text", "content": "What are verbs whose stems consist of analyzable compound structures (Pagu-padham) called?", "media_id": null}], "options": {"A": "Simple verb", "B": "Compound verb (Koottu-vinai)", "C": "Passive verb", "D": "Causative verb"}, "explanation": "Verbs whose root stems are divisible into multiple morphological components are known as compound verbs (Koottu-vinai), e.g., 'thandiyadi', 'kandupidi'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 96, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 96", "url": null, "source_notes