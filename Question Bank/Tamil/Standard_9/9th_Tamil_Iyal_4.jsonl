{"id": "9th-u4-q082", "schema_version": "1.0", "kind": "multi_statement", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l2", "chapter_id": null, "topic_id": "kudumba-vilakku-equality", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதிதாசனின் கல்வி மற்றும் பெண் விடுதலைச் சிந்தனைகள் குறித்த சரியான கருத்துகளைத் தேர்க:\n1. பெண்கள் வானூர்தி ஓட்டுவதற்கும் வைய மாக்கடல் அளப்பதற்கும் உரிமை பெற்றவர்கள்.\n2. சமையல் தொழிலை ஆண்களும் பெண்களும் இணைந்து பகிர வேண்டும்.\n3. பெண்கல்வி சமுதாயத்தின் இருளை நீக்கும் மாபெரும் ஒளிவிளக்கு.\nசரியான விடை எது?", "media_id": null}], "options": {"A": "1 மற்றும் 2 மட்டும் சரி", "B": "1, 2, 3 ஆகிய அனைத்தும் சரி", "C": "2 மற்றும் 3 மட்டும் சரி", "D": "1 மற்றும் 3 மட்டும் சரி"}, "explanation": "பாரதிதாசன் பெண் விடுதலை, இருபாலருக்கும் சமமான வாய்ப்பு, ஆண்-பெண் சமமாக சமையல் மற்றும் வீட்டுப்பணிகளைப் பகிர்தல், பெண்கல்வியின் மேன்மை ஆகிய அனைத்தையும் ஆணித்தரமாக வலியுறுத்துகிறார். எனவே மூன்றும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Choose the correct statements regarding Bharathidasan's progressive thoughts on education and gender equality:\n1. Women have equal rights to pilot airplanes and explore oceanic realms.\n2. Culinary responsibilities should be shared mutually between men and women.\n3. Female education is a magnificent beacon dispelling societal darkness.\nWhich is the correct option?", "media_id": null}], "options": {"A": "1 and 2 only are correct", "B": "All 1, 2, and 3 are correct", "C": "2 and 3 only are correct", "D": "1 and 3 only are correct"}, "explanation": "Bharathidasan advocates all these progressive ideals in Kudumba Vilakku: gender parity in scientific vocations, domestic role sharing, and female education as societal enlightenment."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 87, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 87", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_4", "kudumba_vilakku", "multi_statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
