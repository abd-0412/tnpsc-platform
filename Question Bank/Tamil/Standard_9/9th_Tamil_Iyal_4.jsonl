{"id": "9th-u4-q095", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l4", "chapter_id": null, "topic_id": "anna-journals", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பேரறிஞர் அண்ணா ஆசிரியராகப் பொறுப்பு வகித்த ஆங்கில இதழ்கள் எவை?", "media_id": null}], "options": {"A": "தி ஹிந்து, இந்தியன் எக்ஸ்பிரஸ்", "B": "யங் இந்தியா, ஹரிஜன்", "C": "ஹோம்ரூல் (Home Rule), ஹோம்லேண்ட் (Home Land)", "D": "நியூ இந்தியா, காமன்வீல்"}, "explanation": "பேரறிஞர் அண்ணா 'ஹோம்ரூல்' (Home Rule) மற்றும் 'ஹோம்லேண்ட்' (Home Land) ஆகிய ஆங்கில இதழ்களுக்கு ஆசிரியராகவும் துணை ஆசிரியராகவும் பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Which English periodicals did Perarignar Anna edit / run?", "media_id": null}], "options": {"A": "The Hindu, Indian Express", "B": "Young India, Harijan", "C": "Home Rule, Home Land", "D": "New India, Commonweal"}, "explanation": "Perarignar Anna edited the prominent English weeklies 'Home Rule' and 'Home Land'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 95, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 95", "url": null, "source