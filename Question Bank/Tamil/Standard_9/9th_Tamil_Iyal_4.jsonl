{"id": "9th-u4-q081", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l2", "chapter_id": null, "topic_id": "bharathidasan-other-works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதிதாசன் எழுதிய நூல்களின் இணைகளுள் சரியானதைத் தேர்க:", "media_id": null}], "options": {"A": "தமிழ் இயக்கம், இசையமுது", "B": "கொடிமுல்லை, என் சரிதம்", "C": "குறிஞ்சிப்பாட்டு, குறிஞ்சி மலர்", "D": "மண் சுமந்த பாவை, மலரும் மாலையும்"}, "explanation": "பாரதிதாசன் இயற்றிய நூல்களில் 'தமிழ் இயக்கம்' மற்றும் 'இசையமுது' ஆகியவை குறிப்பிடத்தக்கவை ஆகும். கொடிமுல்லை முடியரசன் நூல்; மலரும் மாலையும் கவிமணி நூல்."}, "en": {"blocks": [{"type": "text", "content": "Identify the correct pair of literary works authored by Bharathidasan:", "media_id": null}], "options": {"A": "Tamil Iyakkam, Isaiyamudhu", "B": "Kodimullai, En Saridham", "C": "Kurinjippaattu, Kurinji Malar", "D": "Man Sumandha Paavai, Malarum Maalaiyum"}, "explanation": "Both 'Tamil Iyakkam' and 'Isaiyamudhu' are celebrated works composed by Pavendhar Bharathidasan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 89, "chapter": null, "section": null, "