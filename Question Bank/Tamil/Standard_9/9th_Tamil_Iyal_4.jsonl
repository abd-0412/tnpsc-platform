{"id": "9th-u4-q112", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l3", "chapter_id": null, "topic_id": "tholkappiyam-porul-scope", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொல்காப்பியத்தின் பொருளதிகாரத்தில் இடம்பெறாத இயல் எது?", "media_id": null}], "options": {"A": "அகத்திணையியல்", "B": "புறத்திணையியல்", "C": "உவமவியல்", "D": "வேற்றுமையியல்"}, "explanation": "வேற்றுமையியல் என்பது 'சொல்லதிகாரத்தில்' உள்ள இயலாகும். அகத்திணையியல், புறத்திணையியல், களவியல், கற்பியல், பொருளியல், மெய்ப்பாட்டியல், உவமவியல், செய்யுளியல், மரபியல் ஆகிய ஒன்பதும் 'பொருளதிகாரத்தில்' இடம்பெற்றுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Which chapter does NOT belong to Porulathikaaram in Tholkappiyam?", "media_id": null}], "options": {"A": "Agathinaiyiyal", "B": "Purathinaiyiyal", "C": "Uvamaviyal", "D": "Vaetrumaiyiyal"}, "explanation": "'Vaetrumaiyiyal' (Case Syntax) belongs to Chollathikaaram. Porulathikaaram comprises Agathinai, Purathinai, Kalaviyal, Karpiyal, Poruliyal, Meyppaattiyal, Uvamaviyal, Cheyyuliyal, and Marabiyal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 91, "chap