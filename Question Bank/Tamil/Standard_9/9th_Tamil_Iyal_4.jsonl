{"id": "9th-u4-q098", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l4", "chapter_id": null, "topic_id": "anna-cm-tenure", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பேரறிஞர் அண்ணா தமிழக முதலமைச்சராகப் பொறுப்பேற்ற ஆண்டு எது?", "media_id": null}], "options": {"A": "1965", "B": "1967", "C": "1969", "D": "1971"}, "explanation": "பேரறிஞர் அண்ணா 1967 ஆம் ஆண்டு சென்னை மாகாணத்தின் முதலமைச்சராகப் பொறுப்பேற்றார். பின்னர் 1969-ல் சென்னை மாகாணத்திற்கு 'தமிழ்நாடு' என்று பெயர் சூட்டினார்."}, "en": {"blocks": [{"type": "text", "content": "In which year did Perarignar Anna assume office as the Chief Minister of Tamil Nadu (then Madras State)?", "media_id": null}], "options": {"A": "1965", "B": "1967", "C": "1969", "D": "1971"}, "explanation": "Perarignar Anna assumed office as Chief Minister in 1967 and subsequently renamed Madras State as 'Tamil Nadu' in 1969."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 95, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 95", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exa