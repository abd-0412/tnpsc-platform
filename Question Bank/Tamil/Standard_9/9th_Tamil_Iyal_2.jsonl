{"id": "9th-u2-q122", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-04-pagupadha-uruppilakkanam", "chapter_id": null, "topic_id": "topic-pagupadha-uruppilakkanam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பகுபதத்தில் பகுதி, விகுதி, இடைநிலைகளைச் சார்ந்து, பெரும்பாலும் இடைநிலைக்கும் விகுதிக்கும் இடையில் வரும் உறுப்பு எது?", "media_id": null}], "options": {"A": "சந்தி", "B": "சாரியை", "C": "எழுத்துப் பேறு", "D": "பகாப்பதம்"}, "explanation": "பகுதி, விகுதி, இடைநிலைகளைச் சார்ந்து வருவது 'சாரியை' ஆகும். இது பெரும்பாலும் இடைநிலைக்கும் விகுதிக்கும் இடையில் வரும் (எ.கா. நடந்தனன் = நட + த்(ந்) + த் + அன் + அன்; இதில் முதல் அன் சாரியை)."}, "en": {"blocks": [{"type": "text", "content": "Which element depends upon other constituents and usually sits between the tense medial and the final suffix?", "media_id": null}], "options": {"A": "Sandhi", "B": "Saariyai (Inflectional increment)", "C": "Ezhutthuppaeru", "D": "Pagaappadham"}, "explanation": "Saariyai is an inflectional particle connecting the medial tense marker to the terminal suffix without carrying semantic weight."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": 