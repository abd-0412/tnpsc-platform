{"id": "9th-u2-q090", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-03-purananuru-thanneer", "chapter_id": null, "topic_id": "topic-purananuru-thanneer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புறநானூற்றுப் பாடலில் வரும் 'புன்புலம்' மற்றும் 'தாட்கு' ஆகியவற்றின் சரியான பொருள் யாது?", "media_id": null}], "options": {"A": "புன்புலம் - பூந்தோட்டம் ; தாட்கு - பாதத்திற்கு", "B": "புன்புலம் - புல்லிய நிலம் (வானம் பார்த்த பூமி) ; தாட்கு - முயற்சி / ஆளுமை", "C": "புன்புலம் - நன்செய் நிலம் ; தாட்கு - தண்டனைக்கு", "D": "புன்புலம் - சதுப்பு நிலம் ; தாட்கு - தலைவனுக்கு"}, "explanation": "சொல்லும் பொருளும்: புன்புலம் - புல்லிய நிலம் (வானம் பார்த்த மென்மையான நிலம்); தாட்கு - முயற்சி (ஆளுமை). வித்தி வான்நோக்கும் புன்புலம் அரசனின் முயற்சிக்கு உதவாது."}, "en": {"blocks": [{"type": "text", "content": "What do 'Punpulam' and 'Thaatku' signify in Kudapulaviyanaar's song?", "media_id": null}], "options": {"A": "Punpulam - Flower garden ; Thaatku - To the feet", "B": "Punpulam - Dry/infertile land dependent on rain ; Thaatku - Enterprise / governance effort", "C": "Punpulam - Wetland ; Thaatku - To punishment", "D": "Punpulam - Marshland ; Thaatku - To the chieftain"}, "explanation": "Glossary: 'Punpulam' means rain-dependent dry ground, and 'Thaatku' means royal enterprise or ruler's endeavor."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "n