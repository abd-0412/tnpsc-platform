{"id": "9th-u2-q093", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-03-purananuru-thanneer", "chapter_id": null, "topic_id": "topic-purananuru-thanneer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குடபுலவியனார் என்ற பெயரில் 'குடபுலம்' என்பது எதனைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "பழந்தமிழகத்தின் பன்னிரு நிலப்பகுதிகளுள் ஒன்றான குடநாடு", "B": "நீர் மொள்ளும் மண்குடம் செய்யும் பகுதி", "C": "மேற்குத் தொடர்ச்சி மலையின் ஒரு சிகரம்", "D": "பாண்டிய நாட்டின் துறைமுகப் பட்டினம்"}, "explanation": "பழஞ்செந்தமிழ் நாட்டின் பன்னிரு பகுதிகளுள் குடநாடும் ஒன்று. இது குடபுலம் எனவும் வழங்கப்படும். குடநாட்டில் பிறந்ததால் இவர் குடபுலவியனார் என அழைக்கப்பட்டார்."}, "en": {"blocks": [{"type": "text", "content": "In the name Kudapulaviyanaar, what does 'Kudapulam' designate?", "media_id": null}], "options": {"A": "Kudanaadu, one of the twelve historical regional divisions of ancient Tamil country", "B": "A settlement where earthen water pots were crafted", "C": "A specific peak of the Western Ghats", "D": "A famous port town of the Pandyan kingdom"}, "explanation": "'Kudanaadu' (Western realm) was one of the twelve ancient regions of Tamilakam; being a native of Kudapulam, he was named Kudapulaviyanaar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book"