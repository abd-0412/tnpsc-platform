{"id": "9th-u2-q058", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-02-periyapuranam", "chapter_id": null, "topic_id": "topic-periyapuranam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'காடெல்லாம் கழைக்கரும்பு காடெல்லாம் குழைக்கரும்பு' - இவ்வடியில் வரும் 'கழை', 'குழை' ஆகியவற்றின் பொருள் யாது?", "media_id": null}], "options": {"A": "கழை - குளம்; குழை - மரம்", "B": "கழை - கரும்பு; குழை - சிறு கிளை (புதிய தளிர்)", "C": "கழை - மூங்கில்; குழை - வேர்", "D": "கழை - மலை; குழை - பழம்"}, "explanation": "பாடலின் சொல்லும் பொருளும்: கழை - கரும்பு; குழை - சிறு கிளை (புதிய தளிர்/கிளை). காடெல்லாம் கரும்புகளும் சிறு கிளைகளில் மலர் அரும்புகளும் நிறைந்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "In the line 'Kaadellam Kazhaikkarumbu Kaadellam Kuzhaikkarumbu', what do 'Kazhai' and 'Kuzhai' mean?", "media_id": null}], "options": {"A": "Kazhai - Pond; Kuzhai - Tree", "B": "Kazhai - Sugarcane; Kuzhai - Small branch (tender shoot)", "C": "Kazhai - Bamboo; Kuzhai - Root", "D": "Kazhai - Mountain; Kuzhai - Fruit"}, "explanation": "Glossary meaning: Kazhai means sugarcane; Kuzhai means tender twigs/shoots bearing flower buds throughout the groves."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Na