{"id": "9th-u2-q066", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-02-periyapuranam", "chapter_id": null, "topic_id": "topic-periyapuranam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'அரிதரு செந்நெற் சூட்டின் அடுக்கிய அடுக்கல் சேர்ப்பார்' - இதில் 'சூடு' என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "வெப்பம்", "B": "நெல் அரிக்கட்டு", "C": "தலையில் சூடும் மாலை", "D": "வைக்கோல் போர்"}, "explanation": "சொல்லும் பொருளும்: சூடு - நெல் அரிக்கட்டு. அறுவடை செய்த செந்நெல் அரிக்கட்டுகளை அடுக்கடுக்காகப் பெரிய போராகக் குவிப்பார்கள்."}, "en": {"blocks": [{"type": "text", "content": "In the line 'Aritharu sennerr sootting adukkiya adukkal serppaar', what does 'Soodu' mean?", "media_id": null}], "options": {"A": "Heat", "B": "Sheaf of harvested paddy", "C": "Garland worn on head", "D": "Straw mound"}, "explanation": "Glossary: 'Soodu' refers to a sheaf / bundle of harvested paddy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 30", "url": null, "source_notes": null}, "previous_year": {"is