{"id": "9th-u2-q105", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-03-purananuru-thanneer", "chapter_id": null, "topic_id": "topic-purananuru-thanneer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வெட்சி முதலிய புறத்திணைகளுக்கெல்லாம் பொதுவான செய்திகளையும், முன்னர் விளக்கப்படாத செய்திகளையும் கூறுவது' எந்தத் திணையாகும்?", "media_id": null}], "options": {"A": "பொதுவியல் திணை", "B": "கைக்கிளைத் திணை", "C": "பாடாண்திணை", "D": "காஞ்சித் திணை"}, "explanation": "வெட்சி முதலாகிய புறத்திணைகள் பலவற்றிற்கும் பொதுவானவற்றையும், அவற்றுள் கூறப்படாத எஞ்சிய செய்திகளையும் தொகுத்துக் கூறுவது 'பொதுவியல் திணை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which poetic landscape summarizes common principles across all exterior landscapes and explains points omitted elsewhere?", "media_id": null}], "options": {"A": "Pothuviyal Thinai", "B": "Kaikkilai Thinai", "C": "Paadaan Thinai", "D": "Kanchi Thinai"}, "explanation": "Pothuviyal Thinai synthesizes universal exterior ethics applicable to all Puram categories while incorporating themes not previously treated."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "