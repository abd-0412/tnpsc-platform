{"id": "9th-u2-q045", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-01-neerindri-amaiyaadhu-ulagu", "chapter_id": null, "topic_id": "topic-vaavi-definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'அழகாகக் கட்டப்பட்ட குளம்' எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "வாவி", "B": "குண்டம்", "C": "மடு", "D": "சிறை"}, "explanation": "பாடநூல் பக். 28: 'வாவி - அழகாகக் கட்டப்பட்ட குளம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is an aesthetically constructed stepped tank termed in traditional Tamil?", "media_id": null}], "options": {"A": "Vaavi (வாவி)", "B": "Kundam", "C": "Madu", "D": "Sirai"}, "explanation": "Page 28 defines 'Vaavi' as an aesthetically constructed tank."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 28, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 28", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["vaavi", "stepped_tank",