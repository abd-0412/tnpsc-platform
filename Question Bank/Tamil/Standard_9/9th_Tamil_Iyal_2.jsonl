{"id": "9th-u2-q019", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-01-neerindri-amaiyaadhu-ulagu", "chapter_id": null, "topic_id": "topic-sani-neeraadu-proverb", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'சனி நீராடு' என்பது யாருடைய பொன்மொழியாகத் தமிழ்நாட்டில் வழங்கி வருகிறது?", "media_id": null}], "options": {"A": "பாரதியார்", "B": "திருவள்ளுவர்", "C": "ஔவையார்", "D": "கபிலர்"}, "explanation": "பாடநூல் பக். 25: 'சனி நீராடு என்பது ஔவையின் வாக்கு' என்று தொ. பரமசிவன் தம் கட்டுரையில் மேற்கோள் காட்டுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "'Sani Neeraadu' (Take an oil bath on Saturdays) is the ancient health proverb authored by which Tamil poetess?", "media_id": null}], "options": {"A": "Bharathiyar", "B": "Thiruvalluvar", "C": "Avvaiyar", "D": "Kapilar"}, "explanation": "Page 25 attributes the classic maxim 'Sani Neeraadu' to Avvaiyar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 25, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 25", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "e