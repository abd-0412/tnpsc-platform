{"id": "9th-u2-q132", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-04-pagupadha-uruppilakkanam", "chapter_id": null, "topic_id": "topic-pagupadha-uruppilakkanam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஓடின', 'வந்தன' என்னும் சொற்களில் இறுதியாக நிற்கும் 'அ' என்பது எவ்வகை விகுதி?", "media_id": null}], "options": {"A": "பெயரெச்ச விகுதி", "B": "தொழிற்பெயர் விகுதி", "C": "ஒன்றன்பால் வினைமுற்று விகுதி", "D": "பலவின்பால் வினைமுற்று விகுதி"}, "explanation": "ஓடின, வந்தன என்பவற்றில் உள்ள 'அ' என்பது அஃறிணைப் பலவின்பால் வினைமுற்று விகுதி ஆகும். (அ, ஆ என்பன பலவின்பால் விகுதிகள்)."}, "en": {"blocks": [{"type": "text", "content": "In finite verbs like 'Oadina' and 'Vandhana', what grammatical suffix does the terminal 'a' represent?", "media_id": null}], "options": {"A": "Relative participle suffix", "B": "Verbal noun suffix", "C": "Neuter singular finite suffix", "D": "Neuter plural finite verb suffix (Palavinpaal Viguthi)"}, "explanation": "The final 'a' in Oadina and Vandhana functions as the neuter plural finite verb suffix (Palavinpaal Vinaimutru Viguthi)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 40, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 40", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_2", "grammar", "pagupadham", "uruppilakkanam"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
