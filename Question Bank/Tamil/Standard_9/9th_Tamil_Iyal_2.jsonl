{"id": "9th-u2-q146", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-05-evaluation-and-pyq", "chapter_id": null, "topic_id": "topic-iyal2-evaluation-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கலைச்சொல் அறிவோம்: 'Conical Stone' என்பதன் சரியான தமிழாக்கம் யாது?", "media_id": null}], "options": {"A": "செதுக்கப்பட்ட கல்", "B": "குமிழிக்கல்", "C": "நடுகல்", "D": "சுண்ணாம்புக்கல்"}, "explanation": "பாடநூல் கலைச்சொல்: Conical Stone - குமிழிக்கல் (ஏரி, குளங்களின் குமிழித்தூம்பில் பொருத்தப்படும் கூம்பு வடிவக் கல்)."}, "en": {"blocks": [{"type": "text", "content": "Vocabulary Terminology: What is the correct Tamil translation of 'Conical Stone'?", "media_id": null}], "options": {"A": "Carved stone", "B": "Kumizhikkal (Conical sluice stone)", "C": "Hero stone", "D": "Limestone"}, "explanation": "As listed in page 48 glossary, 'Conical Stone' translates to 'Kumizhikkal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 48, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 48", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": fal