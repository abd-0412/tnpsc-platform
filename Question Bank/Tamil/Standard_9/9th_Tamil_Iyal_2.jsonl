{"id": "9th-u2-q114", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-04-pagupadha-uruppilakkanam", "chapter_id": null, "topic_id": "topic-pagupadha-uruppilakkanam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிரித்தால் மேலும் பொருள்தரும் உறுப்புகளாகப் பிரிக்க முடியாத சொல் எவ்வகையான பதம் எனப்படும்?", "media_id": null}], "options": {"A": "பகுபதம்", "B": "பகாப்பதம்", "C": "வினையெச்சம்", "D": "தொழிற்பெயர்"}, "explanation": "பிரித்தால் பொருள் தராத சொல் பகாப்பதம் எனப்படும் (எ.கா. மரம், உண், பிற, சால). இதனை மேலும் சிறு கூறுகளாகப் பிரிக்க இயலாது."}, "en": {"blocks": [{"type": "text", "content": "What is a word called that cannot be segmented into further meaningful morphemic units?", "media_id": null}], "options": {"A": "Pagupadham", "B": "Pagaappadham (Indivisible root word)", "C": "Vinaiyechcham", "D": "Thozhirpeyar"}, "explanation": "Pagaappadham is an atomic, unanalyzable morpheme that cannot be subdivided into smaller meaningful components (e.g., maram, un)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 39, "chapter": null, "section": null, "reference": "9th Tamil, Un