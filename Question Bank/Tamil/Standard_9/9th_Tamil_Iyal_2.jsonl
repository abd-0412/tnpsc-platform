{"id": "9th-u2-q060", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-02-periyapuranam", "chapter_id": null, "topic_id": "topic-periyapuranam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சேக்கிழாரை 'பக்திச்சுவை நனி சொட்டச் சொட்டப் பாடிய கவிவலவ' என்று மனமாரப் பாராட்டிய சான்றோர் யார்?", "media_id": null}], "options": {"A": "பாரதியார்", "B": "உ.வே. சாமிநாதையர்", "C": "திரு. வி. கலியாணசுந்தரனார்", "D": "மகாவித்துவான் மீனாட்சிசுந்தரனார்"}, "explanation": "சேக்கிழாரின் பக்திப் பாடல்களை வியந்து மகாவித்துவான் மீனாட்சிசுந்தரனார் 'பக்திச்சுவை நனி சொட்டச் சொட்டப் பாடிய கவிவலவ' என்று போற்றிப் பாராட்டியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who praised Sekkizhar with the celebrated words 'Bhakthi-chuvai nani sottachchotta paadiya kavivalava'?", "media_id": null}], "options": {"A": "Subramania Bharati", "B": "U. V. Swaminatha Iyer", "C": "Thiru. V. Kalyanasundaranar", "D": "Mahavidwan Meenakshisundaranar"}, "explanation": "Mahavidwan Meenakshisundaranar acclaimed poet Sekkizhar as 'Bhakthi-chuvai nani sottachchotta paadiya kavivalava' (a master poet singing verses dripping with deep devotion)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Service