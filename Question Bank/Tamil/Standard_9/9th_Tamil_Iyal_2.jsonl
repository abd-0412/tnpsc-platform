{"id": "9th-u2-q088", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-03-purananuru-thanneer", "chapter_id": null, "topic_id": "topic-purananuru-thanneer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புறநானூற்றுப் பாடலில் இடம்பெறும் 'யாக்கை' மற்றும் 'புணரியோர்' ஆகிய சொற்களின் சரியான பொருள் இணை எது?", "media_id": null}], "options": {"A": "யாக்கை - ஆடை ; புணரியோர் - புலவர்", "B": "யாக்கை - ஆன்மா ; புணரியோர் - நண்பர்", "C": "யாக்கை - எலும்பு ; புணரியோர் - அரசர்", "D": "யாக்கை - உடம்பு ; புணரியோர் - தந்தவர் (ஒன்று சேர்த்தவர்)"}, "explanation": "சொல்லும் பொருளும்: யாக்கை - உடம்பு; புணரியோர் - தந்தவர் (நீரையும் நிலத்தையும் ஒன்று சேர்த்தவர்)."}, "en": {"blocks": [{"type": "text", "content": "Which is the correct pair of definitions for 'Yaakkai' and 'Punariyoar' in Kudapulaviyanaar's poem?", "media_id": null}], "options": {"A": "Yaakkai - Garment ; Punariyoar - Poet", "B": "Yaakkai - Soul ; Punariyoar - Friend", "C": "Yaakkai - Bone ; Punariyoar - King", "D": "Yaakkai - Body/physical frame ; Punariyoar - Those who united / gave (water and earth)"}, "explanation": "Glossary: 'Yaakkai' means human body, and 'Punariyoar' means those who combined/provided land and water."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalv