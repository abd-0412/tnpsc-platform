{"id": "9th-u2-q092", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-03-purananuru-thanneer", "chapter_id": null, "topic_id": "topic-purananuru-thanneer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புறநானூற்றுப் பாடலில் இடம்பெறும் 'அமையா' மற்றும் 'அடுபோர்' ஆகிய சொற்களின் இலக்கணக்குறிப்பு முறையே எவை?", "media_id": null}], "options": {"A": "பெயரெச்சம், பண்புத்தொகை", "B": "வினையெச்சம், உவமைத்தொகை", "C": "தொழிற்பெயர், உம்மைத்தொகை", "D": "ஈறுகெட்ட எதிர்மறைப் பெயரெச்சம், வினைத்தொகை"}, "explanation": "அமையா (அமையாத - த் கெட்டது) = ஈறுகெட்ட எதிர்மறைப் பெயரெச்சம்; அடுபோர் (அடும் போர், அடுகின்ற போர், அடுக்கும் போர்) = வினைத்தொகை."}, "en": {"blocks": [{"type": "text", "content": "What are the grammatical categories of 'Amaiyaa' and 'Adupoar' in the Purananuru text?", "media_id": null}], "options": {"A": "Peyarechcham, Panputhogai", "B": "Vinaiyechcham, Uvamaithogai", "C": "Thozhirpeyar, Ummaithogai", "D": "Eeruketta ethirmarai peyarechcham, Vinaithogai"}, "explanation": "'Amaiyaa' is a negative relative participle with dropped final consonant (Eeruketta ethirmarai peyarechcham), and 'Adupoar' is a verbal compound (Vinaithogai)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and 