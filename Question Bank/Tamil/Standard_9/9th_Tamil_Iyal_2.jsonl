{"id": "9th-u2-q106", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-03-purananuru-thanneer", "chapter_id": null, "topic_id": "topic-purananuru-thanneer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'அறம், பொருள், இன்பம் என்னும் மூன்றினது உறுதியைத் தெரிவிப்பது' எந்தத் துறையாகும்?", "media_id": null}], "options": {"A": "செவியறிவுறூஉத் துறை", "B": "முதுமொழிக்காஞ்சித் துறை", "C": "வாழ்த்தியல் துறை", "D": "இயன்மொழித் துறை"}, "explanation": "அறம், பொருள், இன்பம் என்னும் உறுதிப் பொருள்களின் இயல்பையும் நிலைபேற்றையும் உணர்த்துவது 'முதுமொழிக்காஞ்சித் துறை' எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Which poetic theme (Thurai) conveys the enduring firmness of the three pursuits of life: Virtue, Wealth, and Joy?", "media_id": null}], "options": {"A": "Seviyarivuruu thurai", "B": "Mudhumozhikkanchi thurai", "C": "Vaazhthiyal thurai", "D": "Iyanmozhi thurai"}, "explanation": "Mudhumozhikkanchi thurai expounds the foundational verities of Aram (Dharma), Porul (Artha), and Inbam (Kama)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 34, "chapter": null, "section