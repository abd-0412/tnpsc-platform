{"id": "9th-u2-q113", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-04-pagupadha-uruppilakkanam", "chapter_id": null, "topic_id": "topic-pagupadha-uruppilakkanam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் இலக்கணத்தில் 'சொல்' என்பதற்கு வழங்கப்படும் வேறு பெயர்களுள் பொருந்தாதது எது?", "media_id": null}], "options": {"A": "ஆகுபெயர்", "B": "பதம்", "C": "மொழி", "D": "கிளவி"}, "explanation": "ஓர் எழுத்து தனித்தோ பல எழுத்துகள் சேர்ந்தோ பொருள் தருவது சொல் எனப்படும். சொல் என்பதற்குப் பதம், மொழி, கிளவி என்னும் வேறு பெயர்களும் உண்டு. ஆகுபெயர் என்பது சொல்லின் வகையேயன்றி சொல்லின் மறுபெயர் அன்று."}, "en": {"blocks": [{"type": "text", "content": "Which of the following is NOT an alternate grammatical term for 'word' (Sol) in Tamil?", "media_id": null}], "options": {"A": "Aagupeyar", "B": "Padham", "C": "Mozhi", "D": "Kilavi"}, "explanation": "Sol, Padham, Mozhi, and Kilavi are synonyms for a meaningful word in Tamil grammar. Aagupeyar is a figure of speech (metonymy)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 39, "chapter": null, "section": null, "reference": "9th Tam