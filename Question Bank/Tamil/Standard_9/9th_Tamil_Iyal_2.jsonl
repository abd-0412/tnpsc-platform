{"id": "9th-u2-q068", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-02-periyapuranam", "chapter_id": null, "topic_id": "topic-periyapuranam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சேக்கிழாரின் இயற்பெயர், பிறந்த ஊர் மற்றும் அரசப் பட்டம் குறித்த சரியான வரிசை எது?", "media_id": null}], "options": {"A": "அருண்மொழிவர்மன், தஞ்சாவூர், உத்தம சோழன்", "B": "மருதநாயகன், மதுரை, பல்லவராயன்", "C": "குணசீலன், பூம்புகார், கவிச்சக்கரவர்த்தி", "D": "அருண்மொழித்தேவர், குன்றத்தூர், உத்தம சோழ பல்லவன்"}, "explanation": "சேக்கிழாரின் இயற்பெயர் அருண்மொழித்தேவர். இவர் தொண்டை நாட்டின் குன்றத்தூரில் பிறந்தவர். சோழ மன்னன் அநபாயன் இவருக்கு 'உத்தம சோழ பல்லவன்' என்ற பட்டத்தை வழங்கினான்."}, "en": {"blocks": [{"type": "text", "content": "Which is the correct sequence of Sekkizhar's birth name, birthplace, and title?", "media_id": null}], "options": {"A": "Arunmozhivarman, Thanjavur, Uthama Cholan", "B": "Maruthanayagam, Madurai, Pallavarayan", "C": "Gunaseelan, Poompuhar, Kavichakravarti", "D": "Arunmozhithevar, Kunrathur, Uthama Chola Pallavan"}, "explanation": "Sekkizhar's birth name was Arunmozhithevar, born in Kunrathur. King Anabaya Chola conferred on him the title 'Uthama Chola Pallavan'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Sama