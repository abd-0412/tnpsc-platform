{"id": "9th-u2-q061", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-02-periyapuranam", "chapter_id": null, "topic_id": "topic-periyapuranam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெரியபுராணத்தை இயற்றிய சேக்கிழார் எந்த சோழ மன்னனின் அரசவையில் முதலமைச்சராகப் பணியாற்றினார்?", "media_id": null}], "options": {"A": "இரண்டாம் குலோத்துங்க சோழன் (அநபாய சோழன்)", "B": "முதலாம் இராஜராஜ சோழன்", "C": "முதலாம் இராஜேந்திர சோழன்", "D": "இரண்டாம் இராஜராஜ சோழன்"}, "explanation": "கி.பி. 12-ஆம் நூற்றாண்டைச் சேர்ந்த சேக்கிழார், சோழ அரசன் இரண்டாம் குலோத்துங்கன் (அநபாயன்) அவையில் முதலமைச்சராகப் பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "In whose Chola court did Sekkizhar serve as the Chief Minister?", "media_id": null}], "options": {"A": "Kulottunga Chola II (Anabaya Chola)", "B": "Rajaraja Chola I", "C": "Rajendra Chola I", "D": "Rajaraja Chola II"}, "explanation": "Sekkizhar lived in the 12th century CE and served as Chief Minister in the court of Chola King Kulottunga II (Anabaya Chola)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 31, "chapter": null, "se