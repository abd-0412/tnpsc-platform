{"id": "9th-u2-q138", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-04-pagupadha-uruppilakkanam", "chapter_id": null, "topic_id": "topic-pagupadha-uruppilakkanam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பலவற்றை' என்னும் சொல்லின் பிரிப்பில் இடம்பெற்றுள்ள சாரியை எது?", "media_id": null}], "options": {"A": "அத்து", "B": "அற்று", "C": "இற்று", "D": "இன்"}, "explanation": "பல + அற்று + ஐ = பலவற்றை. இதில் 'அற்று' என்பது சாரியை ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which saariyai particle is present in the inflected form 'Palavatrai'?", "media_id": null}], "options": {"A": "Atthu", "B": "Atru", "C": "Itru", "D": "In"}, "explanation": "In Pala + atru + ai = Palavatrai, 'Atru' acts as the inflectional saariyai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 41", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["