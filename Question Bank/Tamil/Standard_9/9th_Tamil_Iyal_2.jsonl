{"id": "9th-u2-q110", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-03-purananuru-thanneer", "chapter_id": null, "topic_id": "topic-purananuru-thanneer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'சான்றோன் ஆக்குதல் தந்தைக்குக் கடனே / நன்னடை நல்கல் வேந்தற்குக் கடனே' - என்ற புறநானூற்றுப் பாடலைப் (புறம் 312) பாடிய புலவர் யார்?", "media_id": null}], "options": {"A": "ஔவையார்", "B": "பொன்முடியார்", "C": "வெண்ணிக் குயத்தியார்", "D": "காக்கை பாடினியார்"}, "explanation": "புறநானூறு 312-ஆம் பாடலான 'ஈன்று புறந்தருதல் என்தலைக் கடனே / சான்றோன் ஆக்குதல் தந்தைக்குக் கடனே / ... நன்னடை நல்கல் வேந்தற்குக் கடனே' என்ற கடமைப் பாடலைப் பாடிய பெண்பாற்புலவர் பொன்முடியார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who authored Purananuru verse 312: 'Saandroan aakkudhal thandhaikkuk kadanae / Nannadai nalkal vaendharkkuk kadanae'?", "media_id": null}], "options": {"A": "Avvaiyar", "B": "Ponmudiyaar", "C": "Vennik Kuyathiyaar", "D": "Kaakkai Paadiniyaar"}, "explanation": "Poetess Ponmudiyaar composed Puram 312 outlining the respective maternal, paternal, civic, and kingly duties."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", 