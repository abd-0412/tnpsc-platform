{"id": "9th-u2-q115", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-04-pagupadha-uruppilakkanam", "chapter_id": null, "topic_id": "topic-pagupadha-uruppilakkanam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் இலக்கணத்தில் பகுபத உறுப்புகள் மொத்தம் எத்தனை வகைப்படும்?", "media_id": null}], "options": {"A": "நான்கு", "B": "ஐந்து", "C": "ஆறு", "D": "எட்டு"}, "explanation": "பகுபத உறுப்புகள் ஆறு வகைப்படும். அவை: பகுதி, விகுதி, இடைநிலை, சந்தி, சாரியை, விகாரம் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "How many constituent morphemic components (Uruppugal) exist in Tamil divisible words (Pagupadham)?", "media_id": null}], "options": {"A": "Four", "B": "Five", "C": "Six", "D": "Eight"}, "explanation": "There are six morphological constituents in Pagupadham: Paguthi (root), Viguthi (suffix), Idainilai (medial tense marker), Sandhi (euphonic link), Saariyai (inflectional increment), and Vigaaram (phonetic mutation)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 39, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 39", "url": null, "sou