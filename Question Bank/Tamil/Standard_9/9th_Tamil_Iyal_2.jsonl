{"id": "9th-u2-q059", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-02-periyapuranam", "chapter_id": null, "topic_id": "topic-periyapuranam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'அன்னம் ஆடும் அகன்துறைப் பொய்கையில் துன்னும் மேதி படியத் துதைந்தெழும்' - இவ்வடியில் 'மேதி' என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "யானை", "B": "குதிரை", "C": "எருமை", "D": "காளை"}, "explanation": "பாடலின் சொல்லும் பொருள்: மேதி - எருமை; துதைந்து எழும் - கலக்கி எழும்; அன்னங்கள் விளையாடும் அகன்ற நீர்நிலைகளில் எருமைகள் மூழ்கிக் கலக்கி எழுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "In the line 'Annam aadum aganthuraip poigaiyil thunnum meadhip padiyath thuthainthezhum', what does 'Meathi' mean?", "media_id": null}], "options": {"A": "Elephant", "B": "Horse", "C": "Buffalo", "D": "Bull"}, "explanation": "Glossary: 'Meathi' denotes buffalo. Buffaloes plunge and wallow in the broad lotus ponds where swans sport."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 30", "url": null, "sourc