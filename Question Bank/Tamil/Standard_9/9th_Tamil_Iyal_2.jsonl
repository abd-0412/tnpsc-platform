{"id": "9th-u2-q064", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-02-periyapuranam", "chapter_id": null, "topic_id": "topic-periyapuranam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெரியபுராணப் பாடலில் கூறப்படும் 'பகடு' மற்றும் 'சிமயம்' ஆகிய சொற்களின் சரியான பொருள் இணை எது?", "media_id": null}], "options": {"A": "பகடு - யானை ; சிமயம் - பள்ளம்", "B": "பகடு - பசுமாடு ; சிமயம் - மேகம்", "C": "பகடு - எருமை ; சிமயம் - காடு", "D": "பகடு - எருமைக்கடா ; சிமயம் - மலையுச்சி"}, "explanation": "சொல்லும் பொருளும்: பகடு - எருமைக்கடா; பாண்டில் - வட்டம்; சிமயம் - மலையுச்சி. நெற்கற்றை போரின் மீது எருமைக்கடாக்கள் வட்டமாக மிதிக்கும் காட்சி மேகம் மலையுச்சியைச் சுற்றுவது போல் உள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Which is the correct pair of meanings for 'Pagadu' and 'Simayam' from Periyapuranam?", "media_id": null}], "options": {"A": "Pagadu - Elephant ; Simayam - Pit", "B": "Pagadu - Cow ; Simayam - Cloud", "C": "Pagadu - Buffalo ; Simayam - Forest", "D": "Pagadu - Male buffalo (buffalo bull) ; Simayam - Mountain summit"}, "explanation": "Glossary: 'Pagadu' means male buffalo (bull buffalo); 'Simayam' means mountain peak or summit."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tam