{"id": "9th-u2-q117", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-04-pagupadha-uruppilakkanam", "chapter_id": null, "topic_id": "topic-pagupadha-uruppilakkanam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சொல்லின் இறுதியில் நின்று திணை, பால், எண், இடம் ஆகியவற்றை வெளிப்படையாக உணர்த்தும் உறுப்பு எது?", "media_id": null}], "options": {"A": "விகுதி (கடைநிலை)", "B": "பகுதி (முதனிலை)", "C": "சந்தி", "D": "எழுத்துப் பேறு"}, "explanation": "விகுதி சொல்லின் இறுதியில் நிற்கும். இதனைக்கடைநிலை என்றும் அழைப்பர். இது திணை, பால், எண், இடம் ஆகியவற்றை உணர்த்தும் (எ.கா. ஆன் - ஆண்பால், ஆள் - பெண்பால்)."}, "en": {"blocks": [{"type": "text", "content": "Which morphological component stands at the end of a word indicating gender, number, person, and class?", "media_id": null}], "options": {"A": "Viguthi (Kadainilai / Terminal suffix)", "B": "Paguthi (Initial base)", "C": "Sandhi", "D": "Ezhutthuppaeru"}, "explanation": "Viguthi occurs terminally to signify grammatical category, gender, number, and person."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 40, "chapter": null, "section": n