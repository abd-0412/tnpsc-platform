{"id": "9th-u2-q108", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-03-purananuru-thanneer", "chapter_id": null, "topic_id": "topic-purananuru-thanneer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'உண்பது நாழி உடுப்பவை இரண்டே' - என்ற புகழ்பெற்ற புறநானூற்றுப் பாடலைப் (பாடல் 189) பாடியவர் யார்?", "media_id": null}], "options": {"A": "கணியன் பூங்குன்றனார்", "B": "குடபுலவியனார்", "C": "ஒளவையார்", "D": "மதுரைக் கணக்காயனார் மகனார் நக்கீரனார்"}, "explanation": "புறநானூறு 189-ஆம் பாடலான 'உண்பது நாழி உடுப்பவை இரண்டே பிறவும் எல்லாம் ஓர் ஒக்கும்மே...' என்ற பாடலைப் பாடியவர் மதுரைக் கணக்காயனார் மகனார் நக்கீரனார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who sang the iconic Purananuru verse 189: 'Unbadhu naazhi uduppavai irandae'?", "media_id": null}], "options": {"A": "Kaniyan Poongundranaar", "B": "Kudapulaviyanaar", "C": "Avvaiyar", "D": "Madurai Kanakkaayanaar Maganaar Nakkeerar"}, "explanation": "Poem 189 ('One measure to eat, two cloths to wear') was composed by Nakkeerar, son of Madurai Kanakkaayanaar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 34, "c