{"id": "9th-u2-q136", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-04-pagupadha-uruppilakkanam", "chapter_id": null, "topic_id": "topic-pagupadha-uruppilakkanam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வருவனவற்றுள் தொழிற்பெயர் விகுதிகளாக வருபவை எவை?", "media_id": null}], "options": {"A": "அன், ஆன், அள், ஆள்", "B": "கிறு, கின்று, ஆநின்று", "C": "க, இய, இயர்", "D": "தல், அல், ஐ, கை, சி, பு"}, "explanation": "தல், அல், ஐ, கை, சி, பு போன்றவை தொழிற்பெயர் விகுதிகள் ஆகும் (எ.கா. நடத்தல், ஆடல், பார்வை, வாழ்க்கை, ஆட்சி, நடப்பு)."}, "en": {"blocks": [{"type": "text", "content": "Which of the following sets constitutes verbal noun suffixes (Thozhirpeyar Viguthigal)?", "media_id": null}], "options": {"A": "An, Aan, Al, Aal", "B": "Kiru, Kinru, Aanindru", "C": "Ka, Iya, Iyar", "D": "Thal, Al, Ai, Kai, Si, Pu"}, "explanation": "'Thal', 'Al', 'Ai', 'Kai', 'Si', and 'Pu' form nominal action derivatives (Verbal Nouns)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 40, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 40", "url": null, "source_notes