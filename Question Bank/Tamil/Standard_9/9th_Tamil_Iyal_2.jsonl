{"id": "9th-u2-q121", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-04-pagupadha-uruppilakkanam", "chapter_id": null, "topic_id": "topic-pagupadha-uruppilakkanam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உயிரெழுத்துகள் இணையும் போது உடம்படுமெய் சந்தியாக வரும் மெய்யெழுத்துகள் எவை?", "media_id": null}], "options": {"A": "ய், வ்", "B": "க், ச்", "C": "த், ப்", "D": "ட், ற்"}, "explanation": "உயிர் முன் உயிர் வரும்போது உடம்படுமெய் சந்தியாக 'ய்' அல்லது 'வ்' தோன்றும் (எ.கா. பொருந்திய = பொருந்து + ய் + இ + அ)."}, "en": {"blocks": [{"type": "text", "content": "Which consonants function as euphonic glide links (Udambadumei Sandhi) between adjacent vowels?", "media_id": null}], "options": {"A": "Y, V", "B": "K, S", "C": "Th, P", "D": "T, R"}, "explanation": "'Y' and 'V' are the glide consonants (Udambadumei) that prevent vowel hiatus in Tamil phonology."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 41", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null