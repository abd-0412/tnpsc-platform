{"id": "9th-u2-q135", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-04-pagupadha-uruppilakkanam", "chapter_id": null, "topic_id": "topic-pagupadha-uruppilakkanam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வாரான்' மற்றும் 'செய்யான்' ஆகிய சொற்களில் பயின்று வந்துள்ள 'ஆ' என்பது எவ்வகை உறுப்பு?", "media_id": null}], "options": {"A": "எதிர்கால இடைநிலை", "B": "பெயரெச்ச விகுதி", "C": "எதிர்மறை இடைநிலை", "D": "சாரியை"}, "explanation": "இல், அல், ஆ என்பன எதிர்மறை இடைநிலைகள் ஆகும். (எ.கா. செய்யான் = செய் + ய் + ஆ + ஆன்; இதில் 'ஆ' எதிர்மறை இடைநிலை)."}, "en": {"blocks": [{"type": "text", "content": "What type of grammatical constituent is 'aa' in words like 'Vaaraan' and 'Seyyaan'?", "media_id": null}], "options": {"A": "Future tense medial", "B": "Relative participle suffix", "C": "Negative medial marker (Ethirmarai Idainilai)", "D": "Saariyai increment"}, "explanation": "'Il', 'Al', and 'Aa' serve as negative medial infixes; 'aa' indicates negation in Seyyaan (Sey + y + aa + aan)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "refer