{"id": "9th-u2-q079", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-02-periyapuranam", "chapter_id": null, "topic_id": "topic-periyapuranam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கருங்குவளை', 'செந்நெல்' - இவ்விரு சொற்களின் இலக்கணக்குறிப்பு யாது?", "media_id": null}], "options": {"A": "வினைத்தொகைகள்", "B": "உம்மைத்தொகைகள்", "C": "பண்புத்தொகைகள்", "D": "இரட்டைக்கிளவிகள்"}, "explanation": "கருமை + குவளை = கருங்குவளை; செம்மை + நெல் = செந்நெல். மை விகுதியும் நிறப் பண்பும் மறைந்து வந்துள்ளதால் இவை பண்புத்தொகைகள் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the grammatical term for 'Karungkuvalai' and 'Sennel'?", "media_id": null}], "options": {"A": "Vinaithogaigal", "B": "Ummaithogaigal", "C": "Panputhogaigal (Qualitative compounds)", "D": "Irattaikilavigal"}, "explanation": "Both words denote colors (black/deep blue and red) with the elision of 'mai', classifying them as Panputhogaigal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 31, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 31", "url": null, "source_notes": nu