{"id": "9th-u2-q083", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-02-periyapuranam", "chapter_id": null, "topic_id": "topic-periyapuranam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரண்டாம் குலோத்துங்க சோழ மன்னனால் சேக்கிழாருக்கு வழங்கப்பட்ட அரசப் பட்டம் யாது?", "media_id": null}], "options": {"A": "கவிச்சக்கரவர்த்தி", "B": "திராவிட மகாபாஷ்யகாரர்", "C": "உத்தம சோழ பல்லவன்", "D": "தொண்டைமண்டல சதக கர்த்தா"}, "explanation": "இரண்டாம் குலோத்துங்கன் சேக்கிழாரின் அரசியல் மற்றும் நற்பணிகளைப் பாராட்டி அவருக்கு 'உத்தம சோழ பல்லவன்' என்ற சிறப்புப் பட்டத்தை வழங்கி முதலமைச்சராக அமர்த்தினான்."}, "en": {"blocks": [{"type": "text", "content": "Which royal title was conferred upon Sekkizhar by King Kulottunga Chola II?", "media_id": null}], "options": {"A": "Kavichakravarti", "B": "Dravida Mahabhashyakara", "C": "Uthama Chola Pallavan", "D": "Thondaimandala Sathaka Karthaa"}, "explanation": "King Kulottunga II bestowed the royal honorific title 'Uthama Chola Pallavan' upon Sekkizhar when appointing him Prime Minister."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 31, "chapte