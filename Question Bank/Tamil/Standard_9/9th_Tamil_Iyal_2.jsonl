{"id": "9th-u2-q142", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-05-evaluation-and-pyq", "chapter_id": null, "topic_id": "topic-iyal2-evaluation-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூல் பலவுள் தெரிக: நீர்நிலைகளோடு தொடர்பில்லாத சொல் எது?", "media_id": null}], "options": {"A": "அகழி", "B": "புலரி", "C": "இலஞ்சி", "D": "ஆறு"}, "explanation": "அகழி, ஆறு, இலஞ்சி என்பவை நீர்நிலைப் பெயர்கள் ஆகும். 'புலரி' என்பது விடியற்காலையைக் குறிக்கும் சொல், நீர்நிலை அன்று."}, "en": {"blocks": [{"type": "text", "content": "Textbook Evaluation: Which of the following words is NOT associated with water bodies?", "media_id": null}], "options": {"A": "Agazhi (Moat)", "B": "Pulari (Dawn / morning)", "C": "Ilanji (Reservoir)", "D": "Aaru (River)"}, "explanation": "Agazhi, Aaru, and Ilanji are distinct types of water bodies. 'Pulari' denotes dawn, having no connection with water reservoirs."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 43, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 43", "url": null, "source_notes": null}, "previous_year": {"is_