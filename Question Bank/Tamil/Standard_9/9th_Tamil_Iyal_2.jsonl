{"id": "9th-u2-q139", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-04-pagupadha-uruppilakkanam", "chapter_id": null, "topic_id": "topic-pagupadha-uruppilakkanam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'உண்டோம்' என்னும் சொல்லில் வரும் 'ஓம்' என்பது எவ்வகையான விகுதியாகும்?", "media_id": null}], "options": {"A": "தன்மை ஒருமை வினைமுற்று விகுதி", "B": "முன்னிலை பன்மை வினைமுற்று விகுதி", "C": "தன்மைப் பன்மை வினைமுற்று விகுதி", "D": "படர்க்கைப் பன்மை வினைமுற்று விகுதி"}, "explanation": "அம், ஆம், எம், ஏம், ஓம் என்பன தன்மைப் பன்மை வினைமுற்று விகுதிகள் ஆகும். உண்டோம் என்பதில் உள்ள 'ஓம்' தன்மைப் பன்மை விகுதி."}, "en": {"blocks": [{"type": "text", "content": "What grammatical category is the suffix 'oam' in 'Undoam' (We ate)?", "media_id": null}], "options": {"A": "First person singular finite suffix", "B": "Second person plural finite suffix", "C": "First person plural finite verb suffix (Thanmaip Panmai Viguthi)", "D": "Third person epicene plural suffix"}, "explanation": "'Oam' is an exclusive first-person plural finite verb suffix indicating 'we'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edi