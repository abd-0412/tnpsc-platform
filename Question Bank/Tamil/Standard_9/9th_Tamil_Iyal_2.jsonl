{"id": "9th-u2-q069", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-02-periyapuranam", "chapter_id": null, "topic_id": "topic-periyapuranam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'விரிமலர்க் கற்றை வேரி பொழிந்திழி வெற்பு வைப்பார்' - இவ்வடியில் 'வேரி' என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "தேன்", "B": "மழை", "C": "முத்து", "D": "காற்று"}, "explanation": "சொல்லும் பொருளும்: வேரி - தேன்; வெற்பு - மலை. தேன் வடியும் விரிந்த மலர்த் தொகுதியை மலைபோலக் குவித்து வைப்பார்கள் என்பது இதன் பொருளாகும்."}, "en": {"blocks": [{"type": "text", "content": "In the line 'Virimalark kattrai veari pozhinthizhi verppu vaippaar', what does 'Veari' mean?", "media_id": null}], "options": {"A": "Honey / nectar", "B": "Rain", "C": "Pearl", "D": "Breeze"}, "explanation": "Glossary: 'Veari' means honey/nectar; 'Verppu' means hill/mountain."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 30", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name"