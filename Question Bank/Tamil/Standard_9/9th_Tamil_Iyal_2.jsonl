{"id": "9th-u2-q076", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-02-periyapuranam", "chapter_id": null, "topic_id": "topic-periyapuranam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெரியபுராணப் பாடலில் இடம்பெறும் 'கோளி', 'சாலமரம்', 'தமாலம்' ஆகிய சொற்கள் குறிக்கும் மரங்கள் முறையே எவை?", "media_id": null}], "options": {"A": "வேப்பமரம், ஆலமரம், மாமரம்", "B": "தென்னை மரம், பனைமரம், சந்தன மரம்", "C": "நாரத்தை மரம், கொங்கு மரம், கடம்ப மரம்", "D": "அரசமரம், ஆச்சா மரம், பச்சிலை மரம்"}, "explanation": "சொல்லும் பொருளும்: கோளி - அரசமரம்; சாலம் - ஆச்சா மரம்; தமாலம் - பச்சிலை மரம்; இரும்போந்து - பருத்த பனை மரம்; சந்து - சந்தன மரம்; காஞ்சி - ஆற்றுப்பூவரசு."}, "en": {"blocks": [{"type": "text", "content": "Which trees are represented by 'Koli', 'Saalam', and 'Thamalam' in Periyapuranam?", "media_id": null}], "options": {"A": "Neem, Banyan, Mango", "B": "Coconut, Palmyra, Sandalwood", "C": "Citron, Kongu, Kadamba", "D": "Peepal tree (Ficus religiosa), Aacha tree, Pachilai (evergreen) tree"}, "explanation": "Glossary: Koli - Peepal tree; Saalam - Aacha tree; Thamalam - Green-leaved (Pachilai) tree."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation