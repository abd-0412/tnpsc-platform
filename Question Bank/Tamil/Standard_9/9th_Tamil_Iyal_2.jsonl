{"id": "9th-u2-q073", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-02-periyapuranam", "chapter_id": null, "topic_id": "topic-periyapuranam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெரியபுராணத்தில் பாடப்பட்ட அறுபத்து மூன்று தனி அடியார்கள் தவிர, தொகையடியார்கள் (கூட்டு அடியார்கள்) எத்தனை பேர் போற்றப்படுகின்றனர்?", "media_id": null}], "options": {"A": "9 பேர்", "B": "7 பேர்", "C": "12 பேர்", "D": "18 பேர்"}, "explanation": "சுந்தரரின் திருத்தொண்டத்தொகையில் 63 தனி அடியார்களுடன் 9 தொகையடியார்களும் போற்றப்பட்டுள்ளனர். ஆக மொத்தம் 72 அடியார்கள் ஆவர்."}, "en": {"blocks": [{"type": "text", "content": "Apart from the 63 individual Nayanmars, how many collective devotees (Thogaiyadiyargal) are venerated in Periyapuranam?", "media_id": null}], "options": {"A": "9 groups (Thogaiyadiyargal)", "B": "7 groups", "C": "12 groups", "D": "18 groups"}, "explanation": "Sundarar's Thirutthondathogai enumerates 63 individual devotees and 9 collective devotees (Thogaiyadiyargal), totaling 72."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 31, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 31", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_2", "periyapuranam", "sekkizhar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
