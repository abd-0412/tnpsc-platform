{"id": "9th-u1-q114", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-05-eluthu-alapedai", "chapter_id": null, "topic_id": "topic-uyiralapedai-vagaigal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உயிரளபெடை எத்தனை வகைப்படும்?", "media_id": null}], "options": {"A": "இரண்டு", "B": "மூன்று", "C": "நான்கு", "D": "ஐந்து"}, "explanation": "உயிரளபெடை மூன்று வகைப்படும்: 1. செய்யுளிசை அளபெடை (இசைநிறை அளபெடை), 2. இன்னிசை அளபெடை, 3. சொல்லிசை அளபெடை."}, "en": {"blocks": [{"type": "text", "content": "How many distinct types is Uyiralapedai (Vocalic Elongation) classified into?", "media_id": null}], "options": {"A": "Two types", "B": "Three types", "C": "Four types", "D": "Five types"}, "explanation": "Uyiralapedai is classified into three types: Seyyulisai (Isainirai), Innisai, and Sollisai Alapedai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 16, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 16", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "me