{"id": "9th-u1-q097", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-03-tamiloviyam", "chapter_id": null, "topic_id": "topic-agam-puram-lines", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'அகமும் புறமும் இலக்கியமாய் — அவை\nஅமைந்த வாழ்வியலின் இலக்கணமாய்'\nதமிழோவியத்தில் இடம்பெறும் இவ்வடிகள் உணர்த்தும் உண்மை யாது?", "media_id": null}], "options": {"A": "தமிழில் இலக்கியங்கள் படைக்கப்பட்ட பிறகே அவற்றிற்கான இலக்கணங்கள் வகுக்கப்பட்டன", "B": "இலக்கணத்தின் வழியே இலக்கியங்கள் தோன்றின", "C": "அகநூல்கள் மட்டுமே தமிழின் சிறப்பு", "D": "புறநூல்களுக்கு இலக்கணம் கிடையாது"}, "explanation": "பாடநூல் பக். 10 விளக்கம்: தமிழர் தம் அகத்தையும் புறத்தையும் இலக்கியமாக வடித்தனர்; அந்த இலக்கியங்களில் வெளிப்பட்ட வாழ்வியலுக்கு இலக்கணம் அமைத்தனர். இலக்கியம் கண்ட பிறகே இலக்கணம் வகுக்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "What core truth is highlighted in the poetic line 'Agamum Puramum Ilakkiyamaai — Avai Amaindha Vaazhviyalin Ilakkanamaai'?", "media_id": null}], "options": {"A": "Tamil literature sprang naturally from life first, and grammar codified this lived experience afterwards", "B": "Literature was manufactured mechanically following rigid grammatical rules", "C": "Only internal love poems constitute genuine Tamil literature", "D": "Heroic martial poems lack grammatical structure"}, "explanation": "It reflects the foundational axiom that Tamil grammar was derived from organic literature and human life."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 10, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 10", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["tamiloviyam", "literary_theory", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u1-q098", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-04-aaram-thinai", "chapter_id": null, "topic_id": "topic-canada-tamil-life", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆறாம் திணை பாடப்பகுதியில், 'கனடாவில் கடும் குளிர்காலத்தில் பூஜ்ஜியத்திற்குக் கீழே 40 பாகை குளிர் நிலவும் போது எதன் வழியே தமிழர்கள் நடமாடுகிறார்கள்?'", "media_id": null}], "options": {"A": "பனிச்சறுக்கு வண்டிகள் மூலம்", "B": "பூமிக்குக் கீழே உள்ள நிலத்தடிப் பாதைகள் (Underground Walkways) வழியாக", "C": "பனிப்படகுகள் மூலம்", "D": "ஹெலிகாப்டர்கள் மூலம்"}, "explanation": "பாடநூல் பக். 14: கனடாவில் -40 பாகை கடும் குளிர்காலத்தில் மக்கள் வெளியில் நடமாட முடியாத போது நிலத்தடிப் பாதைகள் (Underground PATH system) வழியே பல மைல்கள் பயணம் செய்கின்றனர்."}, "en": {"blocks": [{"type": "text", "content": "In 'Aaram Thinai', how do Tamils in Canada commute during harsh sub-zero temperatures reaching minus 40 degrees?", "media_id": null}], "options": {"A": "Using motorized snow sleds", "B": "Via interconnected underground subterranean walkways", "C": "Via ice boats", "D": "Via helicopters"}, "explanation": "Textbook page 14 describes the underground path networks that shield pedestrians from the blistering -40°C Canadian blizzards."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_nam