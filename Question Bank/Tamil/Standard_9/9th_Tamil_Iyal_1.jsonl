{"id": "9th-u1-q157", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-06-iyal1-eval-pyq", "chapter_id": null, "topic_id": "topic-pyq-semmozhi-year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC Group 4 முந்தைய வினா] தமிழ் மொழி நடுவண் அரசால் 'செம்மொழி'யாக அதிகாரப்பூர்வமாக அறிவிக்கப்பட்ட ஆண்டு எது?", "media_id": null}], "options": {"A": "2004", "B": "2005", "C": "2006", "D": "2008"}, "explanation": "TNPSC தேர்வுகளில் தவறாமல் கேட்கப்படும் வினா: நடுவண் அரசு தமிழ் மொழியை 2004-ஆம் ஆண்டு அக்டோபர் மாதத்தில் செம்மொழியாக அறிவித்தது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Group 4 PYQ] In which year was Tamil officially notified as a Classical Language (செம்மொழி) by the Government of India?", "media_id": null}], "options": {"A": "2004", "B": "2005", "C": "2006", "D": "2008"}, "explanation": "Classic TNPSC repeated question: Tamil was declared a Classical Language in 2004."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 8, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 8", "url": null, "source_notes": null}, "previous_year": {"is_previous_yea