{"id": "9th-u1-q164", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-06-iyal1-eval-pyq", "chapter_id": null, "topic_id": "topic-pyq-erode-tamilanban-district", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC முந்தைய வினா] கவிஞர் தமிழன்பன் தம் பெயருக்கு முன்னால் இணைத்துக் கொண்டுள்ள 'ஈரோடு' என்பது எதனைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "அவரது ஆசிரியர் பெயர்", "B": "அவரது பள்ளியின் பெயர்", "C": "அவர் இயற்றிய முதல் நூலின் பெயர்", "D": "அவர் பிறந்த ஊர் / மாவட்டம்"}, "explanation": "ஈரோடு தமிழன்பன் ஈரோடு மாவட்டத்தில் பிறந்தவர் என்பதால் ஈரோடு தமிழன்பன் என அழைக்கப்படுகிறார்; இவரது இயற்பெயர் ஜெகதீசன்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] What does 'Erode' prefixed to the pen name of poet Erode Tamilanban signify?", "media_id": null}], "options": {"A": "His spiritual mentor", "B": "His alma mater school", "C": "His debut poetry anthology", "D": "His native town and birthplace district"}, "explanation": "Erode is his native district in Tamil Nadu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 11, "chapter": null, "section": null, "referen