{"id": "9th-u1-q075", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-02-tamilvidu-thoothu", "chapter_id": null, "topic_id": "topic-tamilin-perumai-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தமிழ்விடு தூது தமிழில் உள்ள பிற சிற்றிலக்கியங்களை விடச் சொல்நயமும் பொருள்நயமும் மிகுந்து விளங்குகிறது.\nகாரணம் (R): அஃறிணைப் பொருள்களைத் தூது விடுவதற்குப் பதிலாக, உயர்தனிச் செம்மொழியான தமிழையே தூதுப் பொருளாகக் கொண்டு பாடப்பட்ட ஒப்பற்ற நூல் இதுவாகும்.", "media_id": null}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "B": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு"}, "explanation": "பிற தூது நூல்கள் அன்னம், வண்டு ஆகியவற்றைத் தூது விட்டபோது, தமிழ்விடு தூது தமிழை உயர்த்தித் தமிழையே தூதுப் பொருளாக ஆக்கியதால் தனிச்சிறப்புப் பெறுகிறது. கூற்று மற்றும் காரணம் இரண்டும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Tamilvidu Thoothu stands out uniquely among all 96 genres of minor Tamil literature for its poetic resonance and grandeur.\nReason (R): Instead of mundane birds or insects, it elevates the classical Tamil language itself as the sacred celestial emissary.", "media_id": null}], "options": {"A": "(A) is true, but (R) is false", "B": "(A) is false, but (R) is true", "C": "Both (A) and (R) are true, and (R) correctly explains (A)", "D": "Both (A) and (R) are false"}, "explanation": "Choosing the language itself as the beloved messenger imparts peerless literary glory to Tamilvidu Thoothu. Both statements are true."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["tamilvidu_thoothu", "literary_significance", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u1-q076", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-02-tamilvidu-thoothu", "chapter_id": null, "topic_id": "topic-kolvaar-koduppaai-meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'குறமென்றும் பள்ளென்றும் கொள்வார் கொடுப்பாய்க்கு' — இதில் 'கொள்வார் கொடுப்பாய்' என்பதன் விளக்கம் என்ன?", "media_id": null}], "options": {"A": "வணிகர்கள் பண்டமாற்று செய்தல்", "B": "பரிசிலர் அரசரிடம் பொருள் பெறுதல்", "C": "பக்தர்கள் இறைவனிடம் வரம் வேண்டுதல்", "D": "புலவர்கள் பாடிப் பெறவும், அவர்கள் சுவைக்கக் கொடுக்கவும் பெற்ற பெருமை"}, "explanation": "பாடநூல் உரை: குறவஞ்சி, பள்ளு முதலான நூல்களைப் பாடிப் புலவர்கள் பரிசில் பெறுவர்; அத்தகைய நூல்களைப் புலவர்களுக்குத் தந்து சுவைக்கக் கொடுப்பவள் தமிழ்த்தாய்."}, "en": {"blocks": [{"type": "text", "content": "In the line 'Kuramendrum Pallendrum Kolvaar Koduppaaykku', what is the exact literary significance of 'Kolvaar Koduppaai'?", "media_id": null}], "options": {"A": "Merchants bartering commodities", "B": "Bards asking kings for cattle", "C": "Devotees pleading for boons", "D": "Scholars who compose Kuravanji and Pallu receiving rewards, as Tamil generously supplies literary wealth for them"}, "explanation": "It refers to Tamil bountifully yielding dramatic texts like Kuravanji and Pallu for poets to sing, enjoy, and receive accolades."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["tamilvidu_thoothu", "textual_meaning", "direct_mcq"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u1-q077", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-02-tamilvidu-thoothu", "chapter_id": null, "topic_id": "topic-kolvaar-pagupadham", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கொள்வார்' என்னும் சொல்லின் பகுபத உறுப்பிலக்கணம் குறித்த பின்வரும் பிரிப்பை ஆராய்க:\nகொள்வார் = கொள் + வ் + ஆர்\n1. கொள் — பகுதி\n2. வ் — எதிர்கால இடைநிலை\n3. ஆர் — பலர்பால் வினைமுற்று விகுதி\nமேற்கண்ட பிரிப்பில் சரியான உறுப்புகள் எவை?", "media_id": null}], "options": {"A": "அனைத்தும் சரி", "B": "1, 2 மட்டும் சரி", "C": "2, 3 மட்டும் சரி", "D": "1, 3 மட்டும் சரி"}, "explanation": "பாடநூல் பக். 3 பகுபத உறுப்பிலக்கணம்: கொள் (பகுதி) + வ் (எதிர்கால இடைநிலை) + ஆர் (பலர்பால் வினைமுற்று விகுதி). மூன்று உறுப்புகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the morphological parse of the verbal noun 'Kolvaar':\nKolvaar = Kol + v + aar\n1. Kol — Verb root (Pagudhi)\n2. v — Future tense medial marker (Idainilai)\n3. aar — Third person plural suffix (Palarpaal Vikudhi)\nWhich constituent parses are correct?", "media_id": null}], "options": {"A": "All are correct", "B": "1 and 2 only are correct", "C": "2 and 3 only are correct", "D": "1 and 3 only are correct"}, "explanation": "All three morphological segments precisely match the textbook page 3 parse."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 3", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["tamilvidu_thoothu", "pagupadham", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u1-q078", "schema_version": "1.0", "kind": "quote_completion", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-02-tamilvidu-thoothu", "chapter_id": null, "topic_id": "topic-madurai-nagaram-sol", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்விடு தூதில் தலைவி காதல் கொண்ட இறைவன் எழுந்தருளியுள்ள நகரம் எது?", "media_id": null}], "options": {"A": "தஞ்சாவூர்", "B": "மதுரை", "C": "காஞ்சிபுரம்", "D": "திருநெல்வேலி"}, "explanation": "தமிழ்விடு தூது மதுரையில் எழுந்தருளியுள்ள சொக்கநாதப் பெருமான் மீது பாடப்பட்ட நூலாகும்."}, "en": {"blocks": [{"type": "text", "content": "In which ancient sacred temple city does the hero Lord Chokkanathar reside in Tamilvidu Thoothu?", "media_id": null}], "options": {"A": "Thanjavur", "B": "Madurai", "C": "Kanchipuram", "D": "Tirunelveli"}, "explanation": "Lord Chokkanathar is the presiding deity of the historic city of Madurai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["tamilvidu_thoothu", "madurai", "quote_completion"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u1-q079", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-02-tamilvidu-thoothu", "chapter_id": null, "topic_id": "topic-author-anonymity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்விடு தூது நூலை இயற்றிய ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "குமரகுருபரர்", "B": "பலபட்டடைச் சொக்கநாதப் புலவர்", "C": "ஆசிரியர் பெயர் அறியப்படவில்லை", "D": "ஒட்டக்கூத்தர்"}, "explanation": "பாடநூல் பக். 3 நூல் வெளி: 'இந்நூலின் ஆசிரியர் யார் என்பதை அறிய முடியவில்லை'."}, "en": {"blocks": [{"type": "text", "content": "Who is the celebrated author of the classical text Tamilvidu Thoothu?", "media_id": null}], "options": {"A": "Kumaragurubarar", "B": "Balapattadai Chokkanatha Pulavar", "C": "Author is unknown (Anonymous)", "D": "Ottakoothar"}, "explanation": "The author of Tamilvidu Thoothu remains anonymous, as documented on page 3."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 3", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null,