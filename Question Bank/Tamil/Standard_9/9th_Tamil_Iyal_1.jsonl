{"id": "9th-u1-q154", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-06-iyal1-eval-pyq", "chapter_id": null, "topic_id": "topic-bookback-isainirai-alias", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[புத்தக மதிப்பீடு] செய்யுளில் ஓசை குறையும் போது அதனை நிறைவு செய்ய வரும் செய்யுளிசை அளபெடையின் மற்றொரு பெயர் என்ன?", "media_id": null}], "options": {"A": "இன்னிசை அளபெடை", "B": "இசைநிறை அளபெடை", "C": "சொல்லிசை அளபெடை", "D": "ஒற்றளபெடை"}, "explanation": "பாடநூல் பக். 16: செய்யுளிசை அளபெடைக்கு 'இசைநிறை அளபெடை' என்ற மற்றொரு பெயரும் உண்டு."}, "en": {"blocks": [{"type": "text", "content": "[Textbook Evaluation] What is the synonymous alternative name for Seyyulisai Alapedai which fulfills deficient meter in poetry?", "media_id": null}], "options": {"A": "Innisai Alapedai", "B": "Isainirai Alapedai", "C": "Sollisai Alapedai", "D": "Otralapedai"}, "explanation": "Page 16 clearly equates Seyyulisai Alapedai with Isainirai Alapedai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 17, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 17", "url": null, "source_notes": nul