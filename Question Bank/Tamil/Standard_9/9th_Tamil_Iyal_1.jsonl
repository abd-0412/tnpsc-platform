{"id": "9th-u1-q131", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-05-eluthu-alapedai", "chapter_id": null, "topic_id": "topic-passive-transformation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பாண்டியன் நெடுஞ்செழியன் மதுரையை ஆண்டான்' என்ற செய்வினைத் தொடரைச் செயப்பாட்டுவினைத் தொடராக மாற்றுக:", "media_id": null}], "options": {"A": "பாண்டியன் நெடுஞ்செழியனால் மதுரை ஆளப்பட்டது அன்று", "B": "மதுரையைப் பாண்டியன் நெடுஞ்செழியன் ஆண்டான்", "C": "மதுரை பாண்டியன் நெடுஞ்செழியனால் ஆளப்பட்டது", "D": "பாண்டியன் நெடுஞ்செழியன் மதுரையை ஆளச் செய்தான்"}, "explanation": "செய்வினையைச் செயப்பாட்டுவினையாக மாற்றும்போது செயப்படுபொருள் (மதுரை) எழுவாயாகவும், எழுவாய் (பாண்டியன்) மூன்றாம் வேற்றுமை 'ஆல்' ஏற்றும், வினையோடு 'பட்டது' துணைவினையும் சேரும்."}, "en": {"blocks": [{"type": "text", "content": "Transform the active sentence 'Pandiyan Nedunchezhiyan ruled Madurai' into a passive voice sentence:", "media_id": null}], "options": {"A": "It was not Madurai that Pandiyan ruled", "B": "Madurai was what Pandiyan ruled directly", "C": "Madurai was ruled by Pandiyan Nedunchezhiyan (மதுரை பாண்டியன் நெடுஞ்செழியனால் ஆளப்பட்டது)", "D": "Pandiyan caused Madurai to be ruled"}, "explanation": "Passive transformation in Tamil shifts the patient to subject position, adds the instrumental 'aal' to the agent, and attaches 'padu' to the verb."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 18", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["grammar", "passive_voice", "sentence_transformation"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
