{"id": "9th-u1-q096", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-03-tamiloviyam", "chapter_id": null, "topic_id": "topic-vanakkam-valluva-year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஈரோடு தமிழன்பனின் 'வணக்கம் வள்ளுவ' கவிதை நூலுக்குச் சாகித்திய அகாதெமி விருது வழங்கப்பட்ட ஆண்டு எது?", "media_id": null}], "options": {"A": "2001", "B": "2002", "C": "2003", "D": "2004"}, "explanation": "பாடநூல் பக். 11 நூல் வெளி: 'வணக்கம் வள்ளுவ என்னும் கவிதை நூலுக்கு 2004-ஆம் ஆண்டுக்கான சாகித்திய அகாதெமி விருது வழங்கப்பட்டது'."}, "en": {"blocks": [{"type": "text", "content": "In which year was Erode Tamilanban conferred the Sahitya Akademi Award for his poetry work 'Vanakkam Valluva'?", "media_id": null}], "options": {"A": "2001", "B": "2002", "C": "2003", "D": "2004"}, "explanation": "Textbook page 11 explicitly dates the Sahitya Akademi award to the year 2004."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 11, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 11", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exa