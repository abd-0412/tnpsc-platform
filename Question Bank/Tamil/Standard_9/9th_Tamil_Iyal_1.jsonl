{"id": "9th-u1-q160", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-06-iyal1-eval-pyq", "chapter_id": null, "topic_id": "topic-pyq-four-families", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC முந்தைய வினா] இந்தியாவில் பேசப்படும் 1300-க்கும் மேற்பட்ட மொழிகள் எத்தனை மொழிக் குடும்பங்களாகப் பிரிக்கப்பட்டுள்ளன?", "media_id": null}], "options": {"A": "இரண்டு", "B": "மூன்று", "C": "ஐந்து", "D": "நான்கு"}, "explanation": "TNPSC அசல் வினா: இந்தியாவில் பேசப்படும் மொழிகள் இந்தோ-ஆசியன், திராவிடம், ஆஸ்ட்ரோ-ஆசியாடிக், சீன-திபெத்தியன் என நான்கு மொழிக் குடும்பங்களாகப் பிரிக்கப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] The 1,300+ languages spoken across India are classified fundamentally into how many primary linguistic families?", "media_id": null}], "options": {"A": "Two", "B": "Three", "C": "Five", "D": "Four"}, "explanation": "Repeated TNPSC question: Indian tongues are grouped into 4 major families."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 4, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 4", "url": null, "source_notes"