{"id": "9th-rev-q029", "schema_version": "1.0", "kind": "factual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u1", "lesson_id": "9th-tamil-u1-l1", "chapter_id": null, "topic_id": "dravidian-languages-classification", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திராவிட மொழிக் குடும்பத்தின் தென் திராவிட மொழிகள் பிரிவில் அடங்கும் மொழிகளின் சரியான தொகுதி எது?", "media_id": null}], "options": {"A": "தமிழ், மலையாளம், கன்னடம், குடகு (கொடவா), துளு, தோடா, கோத்தா", "B": "தெலுங்கு, குயி, கூவி, கோண்டி", "C": "பிராகுயி, குரூக், மால்தோ", "D": "இந்தி, மராத்தி, குஜராத்தி"}, "explanation": "தென் திராவிட மொழிகள்: தமிழ், மலையாளம், கன்னடம், குடகு, துளு, தோடா, கோத்தா, கொரகா, இருளா. தெலுங்கு, குயி நடு திராவிட மொழிகள்; குரூக், மால்தோ, பிராகுயி வட திராவிட மொழிகள்."}, "en": {"blocks": [{"type": "text", "content": "Which group correctly identifies languages of the South Dravidian branch?", "media_id": null}], "options": {"A": "Tamil, Malayalam, Kannada, Kodagu, Tulu, Toda, Kota (தென் திராவிட மொழிகள்)", "B": "Telugu, Kui, Kuvi, Gondi", "C": "Brahui, Kurukh, Malto", "D": "Hindi, Marathi, Gujarati"}, "explanation": "Tamil, Malayalam, Kannada, Kodava, and Tulu are South Dravidian languages."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Cor