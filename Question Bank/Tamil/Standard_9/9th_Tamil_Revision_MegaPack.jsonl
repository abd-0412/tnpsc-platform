{"id": "9th-rev-q048", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-vaikom-satyagraha-1924-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] 1924-இல் கேரளாவின் வைக்கம் நகரில் தீண்டாமைக்கு எதிரான கோயில் தெரு நுழைவுப் போராட்டத்தை வழிநடத்தி வெற்றி கண்டவர் யார்?", "media_id": null}], "options": {"A": "திரு. வி. க.", "B": "சி. இலக்குவனார்", "C": "அறிஞர் அண்ணா", "D": "தந்தை பெரியார் ('வைக்கம் வீரர்')"}, "explanation": "1924-இல் கேரளாவில் வைக்கம் சத்தியாகிரகப் போராட்டத்தை ஏற்று நடத்தி வெற்றி கண்டதால் பெரியார் 'வைக்கம் வீரர்' எனப் பாராட்டப்பட்டார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Who led the historic 1924 Vaikom temple street entry struggle in Kerala, earning the title 'Vaikom Veerar'?", "media_id": null}], "options": {"A": "Thiru. Vi. Ka.", "B": "C. Ilakkuvanar", "C": "Perarignar Anna", "D": "Thanthai Periyar ('Vaikom Veerar' - தந்தை பெரியார்)"}, "explanation": "Periyar won the Vaikom Satyagraha in 1924, becoming 'Vaikom Veerar'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 152, "cha