{"id": "9th-rev-q031", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l3", "chapter_id": null, "topic_id": "naachiyar-thirumozhi-vaaranam-aayiram-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] \"வாரணம் ஆயிரம் சூழ வலம்செய்து / நாரணன் நம்பி நடக்கின்றான்...\" - நாச்சியார் திருமொழியில் கண்ணனை மணமுடிப்பதாகக் கனவு கண்டவர் யார்?", "media_id": null}], "options": {"A": "காரைக்கால் அம்மையார்", "B": "மங்கையர்க்கரசியார்", "C": "ஆண்டாள் (நாச்சியார் திருமொழி)", "D": "வாசுகி"}, "explanation": "ஆண்டாள் அருளிய நாச்சியார் திருமொழியில் 'வாரணம் ஆயிரம்' என்னும் புகழ்பெற்ற பத்துப் பாடல்களில் கண்ணன் தன்னைத் திருமணம் செய்துகொள்வதாகக் கண்ட கனவை விவரித்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Who dreamt of wedding Lord Krishna in 'Vaaranam aayiram soozha valam seythu' in Naachiyar Thirumozhi?", "media_id": null}], "options": {"A": "Karaikkal Ammaiyar", "B": "Mangayarkkarasiyar", "C": "Andal (ஆண்டாள் - நாச்சியார் திருமொழி)", "D": "Vasuki"}, "explanation": "Andal sang of her dream marriage in Naachiyar Thirumozhi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-202