{"id": "9th-rev-q023", "schema_version": "1.0", "kind": "factual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u3", "lesson_id": "9th-tamil-u3-l5", "chapter_id": null, "topic_id": "vallinam-migum-idangal-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] வல்லினம் மிகும் இடங்களுள் சரியான விதியைத் தேர்ந்தெடுக்குக:", "media_id": null}], "options": {"A": "வினைத்தொகையில் வல்லினம் மிகும்", "B": "உம்மைத்தொகையில் வல்லினம் மிகும்", "C": "அந்த, இந்த என்னும் சுட்டுத் திரிபுகளின் பின்னும்; எந்த என்னும் வினாத்திரிபின் பின்னும் வல்லினம் மிகும் (அந்தப் பையன், இந்தக் குதிரை, எந்தச் சட்டை)", "D": "இரண்டாம் வேற்றுமைத் தொகையில் வல்லினம் மிகும்"}, "explanation": "'அந்த', 'இந்த' என்னும் சுட்டுத் திரிபுகளின் பின்னும், 'எந்த' என்னும் வினாத்திரிபின் பின்னும் வல்லினம் (க், ச், த், ப்) கட்டாயம் மிகும்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Identify the correct orthographic rule governing plosive doubling (Vallinam Migum Idangal):", "media_id": null}], "options": {"A": "Plosives double in Vinaithogai compounds", "B": "Plosives double in Ummaithogai compounds", "C": "Plosives double after demonstrative adjectives 'Antha', 'Intha' and interrogative 'Entha' (அந்த, இந்த, எந்த)", "D": "Plosives double in unmarked accusative compounds"}, "explanation": "Plosives strictly double after demonstrative and interrogative adjectives 'antha', 'intha', and 'entha'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 78, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 78", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4", "exam_name": null, "year": 2018, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "revision", "vallinam_migum", "pyq"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-rev-q024", "schema_version": "1.0", "kind": "factual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l5", "chapter_id": null, "topic_id": "vallinam-migaa-idangal-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] வல்லினம் மிகா இடங்களுள் பொருந்தும் சரியான விதியைக் கண்டறிக:", "media_id": null}], "options": {"A": "இரண்டாம் வேற்றுமை விரிக்குப் பின் வல்லினம் மிகாது", "B": "நான்காம் வேற்றுமை விரிக்குப் பின் வல்லினம் மிகாது", "C": "ஈறுகெட்ட எதிர்மறைப் பெயரெச்சத்தின் பின் வல்லினம் மிகாது", "D": "வினைத்தொகையில் வல்லினம் மிகாது (எ.கா: குடிநீர், பாய்புலி, ஊறுகாய்)"}, "explanation": "வினைத்தொகையில் (முக்காலமும் மறைந்து வரும் தொடரில்) வல்லினம் மிகக் கூடாது. (எ.கா: குடிநீர் - குடித்த நீர், குடிக்கின்ற நீர், குடிக்கும் நீர்; பாய்புலி, சுடுசோறு)."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Identify the correct sandhi rule where plosives DO NOT double (Vallinam Migaa Idangal):", "media_id": null}], "options": {"A": "Plosives do not double after overt accusative suffix", "B": "Plosives do not double after overt dative suffix", "C": "Plosives do not double after negative relative participles with elided endings", "D": "Plosives do NOT double in Vinaithogai compounds (வினைத்தொகையில் மிகாது: குடிநீர், ஊறுகாய்)"}, "explanation": "Vinaithogai compounds strictly forbid plosive doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks