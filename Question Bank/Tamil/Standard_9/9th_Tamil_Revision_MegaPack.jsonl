{"id": "9th-rev-q013", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "muthollayiram-purathirattu-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] முத்தொள்ளாயிரம் நூலில் தற்போது 'புறத்திரட்டு' வாயிலாக நமக்குக் கிடைத்துள்ள பாடல்களின் எண்ணிக்கை எத்தனை?", "media_id": null}], "options": {"A": "108 பாடல்கள் (கடவுள் வாழ்த்துடன் சேர்த்து 109)", "B": "300 பாடல்கள்", "C": "900 பாடல்கள்", "D": "500 பாடல்கள்"}, "explanation": "சேர, சோழ, பாண்டிய மன்னர்களைப் பாடிய முத்தொள்ளாயிரத்தில் முழுமையான நூல் கிடைக்காமல், புறத்திரட்டு என்னும் நூலின் வாயிலாக 108 வெண்பாக்கள் மட்டுமே நமக்குக் கிடைத்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] How many verses of Muthollayiram are currently extant through the medieval anthology Purathirattu?", "media_id": null}], "options": {"A": "108 verses (108 பாடல்கள்)", "B": "300 verses", "C": "900 verses", "D": "500 verses"}, "explanation": "108 verses are preserved in Purathirattu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 151, "chapter": null, "section": null, "reference": "9