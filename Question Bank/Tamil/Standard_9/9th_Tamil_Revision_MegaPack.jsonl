{"id": "9th-rev-q010", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l2", "chapter_id": null, "topic_id": "sirupanchamoolam-kariyaasan-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] பதினெண்கீழ்க்கணக்கு நூல்களுள் ஒன்றான 'சிறுபஞ்சமூலம்' நூலின் ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "கணிமேதாவியார்", "B": "காரியாசான்", "C": "பூதஞ்சேந்தனார்", "D": "புல்லங்காடனார்"}, "explanation": "சிறுபஞ்சமூலம் நூலின் ஆசிரியர் காரியாசான் ஆவார். கண்டங்கத்திரி, சிறுவழுதுணை, சிறுமல்லி, பெருமல்லி, நெருஞ்சி ஆகிய ஐந்து மூலிகைகளின் வேர்கள் உடல்நோய் தீர்ப்பது போல் இந்நூலின் ஐந்து கருத்துகள் மனநோய் தீர்க்கின்றன."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Who authored the ethical work 'Sirupanchamoolam' in the Pathinenkeezhkanakku canon?", "media_id": null}], "options": {"A": "Kanimethaviyar", "B": "Kaariyaasaan (காரியாசான்)", "C": "Boothanjenthanar", "D": "Pullangaadanar"}, "explanation": "Kaariyaasaan authored Sirupanchamoolam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 124, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, P