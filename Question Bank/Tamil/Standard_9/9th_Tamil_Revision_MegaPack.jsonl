{"id": "9th-rev-q009", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "kudumba-vilakku-bharathidasan-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] \"பட்டங்கள் ஆள்வதும் சட்டங்கள் செய்வதும் / பாரினில் பெண்கள் நடத்த வந்தோம்\" என்ற பாரதியின் கனவை மெய்ப்பிக்கும் வகையில் 'குடும்ப விளக்கு' நூலைப் பாடியவர் யார்?", "media_id": null}], "options": {"A": "பாரதிதாசன்", "B": "நாமக்கல் கவிஞர்", "C": "கவிமணி", "D": "முடியரசன்"}, "explanation": "பெண்கல்வியின் இன்றியமையாமையை வலியுறுத்தி ஐந்து பகுதிகளாகப் பகுத்து 'குடும்ப விளக்கு' என்னும் நூலைப் பாடியவர் புரட்சிக் கவிஞர் பாரதிதாசன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Who authored the epic poem 'Kudumba Vilakku' advocating women's education in five cantos?", "media_id": null}], "options": {"A": "Bharathidasan (பாரதிதாசன்)", "B": "Namakkal Kavignar", "C": "Kavimani", "D": "Mudiyarasan"}, "explanation": "Bharathidasan authored 'Kudumba Vilakku'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 120, "chapter": null, "section": null, "reference": "9th Tamil,