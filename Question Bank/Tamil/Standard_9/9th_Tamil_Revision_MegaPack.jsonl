{"id": "9th-rev-q003", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u2", "lesson_id": "9th-tamil-u2-l1", "chapter_id": null, "topic_id": "water-quotes-distinction-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] 'நீரின்றி அமையாது உலகு' என்றவர் திருவள்ளுவர் எனில், 'நீரின்றி அமையாது யாக்கை' என்று பாடிய சங்கப் புலவர் யார்?", "media_id": null}], "options": {"A": "கபிலர்", "B": "ஔவையார்", "C": "குடபுலவியனார் (புறநானூறு 18)", "D": "நக்கீரர்"}, "explanation": "புறநானூறு 18-ஆம் பாடலில் பாண்டியன் நெடுஞ்செழியனை நோக்கி 'நீரின்றி அமையாது யாக்கைக்கு எல்லாம் / உண்டி கொடுத்தோர் உயிர் கொடுத்தோரே' என்று பாடியவர் குடபுலவியனார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] If 'Neerindri amaiyaathu ulagu' was proclaimed by Thiruvalluvar, which Sangam poet sang 'Neerindri amaiyaathu yaakkai' in Purananuru?", "media_id": null}], "options": {"A": "Kapilar", "B": "Avvaiyar", "C": "Kudapulaviyanar (Purananuru 18 - குடபுலவியனார்)", "D": "Nakkeerar"}, "explanation": "Kudapulaviyanar sang this in Purananuru verse 18 to Pandiyan Nedunchezhiyan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025