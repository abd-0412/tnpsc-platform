{"id": "9th-u8-q112", "schema_version": "1.0", "kind": "conceptual", "level": "analysis", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l3", "chapter_id": null, "topic_id": "yasodhara-true-false", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "யசோதர காவியம் பற்றிய கூற்றுகளை ஆராய்க:\nI. இந்நூல் ஐஞ்சிறு காப்பியங்களுள் ஒன்றாகும்.\nII. இது சமண சமயக் கருத்துகளைக் கூறுகிறது.\nIII. இதன் ஆசிரியர் கம்பர் ஆவார்.", "media_id": null}], "options": {"A": "கூற்று I, II, III அனைத்தும் சரி", "B": "கூற்று I மட்டும் சரி", "C": "கூற்று II மட்டும் சரி", "D": "கூற்று I, II சரி; கூற்று III தவறு (ஆசிரியர் பெயர் அறியப்படவில்லை)"}, "explanation": "கூற்று I மற்றும் II சரி. கூற்று III தவறு; ஏனெனில் யசோதர காவியத்தின் ஆசிரியர் பெயர் அறியப்படவில்லை (கம்பர் கம்பராமாயணத்தை இயற்றியவர்)."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Yasodhara Kaaviyam:\nI. It is one of the Five Minor Epics.\nII. It propounds Jain philosophy.\nIII. Its author is Kambar.", "media_id": null}], "options": {"A": "Statements I, II, and III are all correct", "B": "Only statement I is correct", "C": "Only statement II is correct", "D": "Statements I and II are correct; statement III is incorrect (Author is anonymous)"}, "explanation": "Statements I and II are true. Statement III is false because the author is anonymous, not Kambar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers"