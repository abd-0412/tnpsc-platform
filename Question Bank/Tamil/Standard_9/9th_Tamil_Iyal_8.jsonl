{"id": "9th-u8-q052", "schema_version": "1.0", "kind": "conceptual", "level": "analysis", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-humanism-summary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெரியாரின் ஒட்டுமொத்தப் போராட்டங்களும் சிந்தனைகளும் எதை மையமாகக் கொண்டு அமைந்தன?", "media_id": null}], "options": {"A": "மத ஆதிக்கத்தை நிலைநிறுத்துதல்", "B": "பழைய சடங்குகளைப் பாதுகாத்தல்", "C": "சுயலாபம் அடைதல்", "D": "மனிதநேயம், மனித சமத்துவம் மற்றும் மானுட விடுதலை"}, "explanation": "பெரியாரின் சாதி ஒழிப்பு, பெண் விடுதலை, பகுத்தறிவு, எழுத்துச் சீர்திருத்தம் முதலான அனைத்துச் சிந்தனைகளும் 'மனித சமத்துவத்தையும் மனிதநேயத்தையும்' நிலைநிறுத்துவதையே நோக்கமாகக் கொண்டிருந்தன."}, "en": {"blocks": [{"type": "text", "content": "What was the ultimate overarching core around which all of Periyar's agitations and philosophy gravitated?", "media_id": null}], "options": {"A": "Entrenching religious dogmatism", "B": "Preserving ancient rituals", "C": "Personal self-aggrandizement", "D": "Universal humanism, egalitarian social equality, and total human emancipation"}, "explanation": "Periyar's entire life was anchored in unbending humanism, secular equality, and human liberation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 157, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 157", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_8", "periyar", "humanism"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u8-q053", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-vaikom-temple-streets", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "1924-ல் வைக்கம் நகரில் பெரியார் போராடிப் பெற்றுத் தந்த அடிப்படை மனித உரிமை எது?", "media_id": null}], "options": {"A": "கோவிலைச் சுற்றியுள்ள தெருக்களில் அனைத்து மக்களும் நடக்கும் உரிமை", "B": "ரயில்வே கட்டணக் குறைப்பு", "C": "இலவச பேருந்துப் பயணம்", "D": "சுங்கவரி ரத்து"}, "explanation": "கேரளாவின் வைக்கம் மகாதேவர் கோவிலைச் சுற்றியுள்ள வீதிகளில் ஒடுக்கப்பட்ட மக்கள் நடப்பதற்கு விதிக்கப்பட்டிருந்த தடையை எதிர்த்துப் போராடி உரிமை பெற்றுத் தந்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which fundamental civil right did Periyar secure during the historic 1924 Vaikom struggle?", "media_id": null}], "options": {"A": "The right for all oppressed castes to walk freely on the streets surrounding the temple", "B": "Railway fare reduction", "C": "Free public transit", "D": "Toll tax repeal"}, "explanation": "Periyar courted imprisonment in Vaikom to win public pathway access rights around the temple for untouchables."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpo