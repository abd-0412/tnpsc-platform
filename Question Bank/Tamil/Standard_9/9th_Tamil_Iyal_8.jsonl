{"id": "9th-u8-q107", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l3", "chapter_id": null, "topic_id": "yasodhara-origin-language", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழில் உள்ள யசோதர காவியம் எந்த மொழியிலிருந்து தழுவி எழுதப்பட்டதாகும்?", "media_id": null}], "options": {"A": "பாலி மொழி", "B": "பிராகிருதம்", "C": "வடமொழி (சமஸ்கிருதம்)", "D": "கிரேக்கம்"}, "explanation": "பாடநூலில்: 'இந்நூல் வடமொழியிலிருந்து தமிழில் தழுவி எழுதப்பெற்றதாகும்' எனக் குறிப்பிடப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "From which language source was the Tamil epic Yasodhara Kaaviyam adapted?", "media_id": null}], "options": {"A": "Pali", "B": "Prakrit", "C": "Vadamozhi / Sanskrit (வடமொழி)", "D": "Greek"}, "explanation": "Yasodhara Kaaviyam is adapted from Sanskrit Jain hagiographical narratives."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 160", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": n