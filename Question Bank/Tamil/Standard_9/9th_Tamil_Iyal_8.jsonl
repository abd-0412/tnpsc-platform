{"id": "9th-u8-q025", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-caste-eradication", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெரியாரின் சாதி ஒழிப்புச் சிந்தனையின் அடிப்படை நோக்கம் எது?", "media_id": null}], "options": {"A": "பிறப்பொக்கும் எல்லா உயிர்க்கும் என்ற சமத்துவத்தை நிலைநிறுத்தி மனிதனை மனிதனாக மதிப்பது", "B": "புதிய சாதிகளை உருவாக்குவது", "C": "சாதி சங்கங்களை வளர்ப்பது", "D": "ஒரு சாதியை மட்டும் உயர்த்துவது"}, "explanation": "பிறப்பினால் எவரும் உயர்ந்தவரோ தாழ்ந்தவரோ அல்ல; மனிதனை மனிதனாக மதிக்கும் சமத்துவ சமுதாயத்தை உருவாக்குவதே பெரியாரின் சாதி ஒழிப்பு நோக்கமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What was the foundational objective of Periyar's radical campaign for the annihilation of caste?", "media_id": null}], "options": {"A": "Establishing universal equality based on human dignity and mutual respect", "B": "Creating novel caste divisions", "C": "Strengthening caste associations", "D": "Elevating a single dominant community"}, "explanation": "Periyar sought to abolish all birth-based hierarchies to establish absolute social equality and human brotherhood."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "