{"id": "9th-u8-q011", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-periodicals", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தந்தை பெரியார் தமது சீர்திருத்தக் கருத்துகளை மக்களிடையே பரப்ப நடத்திய இதழ்களுள் 'ஆங்கில இதழ்' எது?", "media_id": null}], "options": {"A": "விடுதலை", "B": "குடியரசு", "C": "ரிவோல்ட் (Revolt)", "D": "உண்மை"}, "explanation": "குடியரசு, விடுதலை, உண்மை ஆகிய தமிழ் இதழ்களுடன் 'ரிவோல்ட்' (Revolt) என்னும் புகழ்பெற்ற ஆங்கில இதழையும் பெரியார் நடத்தினார்."}, "en": {"blocks": [{"type": "text", "content": "Which celebrated English periodical was founded and published by Thanthai Periyar to disseminate radical social ideas?", "media_id": null}], "options": {"A": "Viduthalai", "B": "Kudi Arasu", "C": "Revolt (ரிவோல்ட்)", "D": "Unmai"}, "explanation": "Alongside Tamil journals like Kudi Arasu and Viduthalai, Periyar ran the English weekly 'Revolt'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 156", "url": null, "source_notes": null}, "pr