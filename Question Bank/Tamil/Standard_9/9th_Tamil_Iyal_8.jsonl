{"id": "9th-u8-q081", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l2", "chapter_id": null, "topic_id": "pitchamurthi-short-stories-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ந. பிச்சமூர்த்தி இயற்றிய சிறுகதைகளின் மொத்த எண்ணிக்கை தோராயமாக எத்தனை?", "media_id": null}], "options": {"A": "நூற்றுக்கும் மேற்பட்ட சிறுகதைகள் (சுமார் 120)", "B": "பத்து சிறுகதைகள்", "C": "இருபது சிறுகதைகள்", "D": "ஐநூறு சிறுகதைகள்"}, "explanation": "ந. பிச்சமூர்த்தி புதுக்கவிதைகள் மட்டுமன்றி 120-க்கும் மேற்பட்ட தலைசிறந்த உளவியல் மற்றும் வாழ்வியல் சிறுகதைகளையும் படைத்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Approximately how many masterly short stories did Na. Pitchamurthi compose?", "media_id": null}], "options": {"A": "Over a hundred short stories (Approx. 120 stories)", "B": "Ten stories", "C": "Twenty stories", "D": "Five hundred stories"}, "explanation": "Pitchamurthi authored over 120 celebrated psychological and realist short stories."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 168, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 16