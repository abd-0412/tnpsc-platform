{"id": "9th-u8-q047", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-women-education-quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"பெண்களுக்குக் கல்வி இல்லை என்றால் அந்தச் சமூகம் ஒருபோதும் முன்னேற முடியாது\" என்று பெண் கல்வியின் இன்றியமையாமையை வலியுறுத்தியவர் யார்?", "media_id": null}], "options": {"A": "தி. ஜானகிராமன்", "B": "வைரமுத்து", "C": "தந்தை பெரியார்", "D": "கந்தர்வன்"}, "explanation": "பெண்களுக்குக் கல்வி அளிக்கப்பட்டால் மட்டுமே குடும்பமும் சமூகமும் சமத்துவ நிலையை எட்ட முடியும் எனப் பெரியார் பலமுறை மேடைகளில் முழங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "\"Without education for women, no society can ever progress\" - Who forcefully championed this imperative?", "media_id": null}], "options": {"A": "T. Janakiraman", "B": "Vairamuthu", "C": "Thanthai Periyar (தந்தை பெரியார்)", "D": "Kandharvan"}, "explanation": "Periyar declared that female education is the ultimate catalyst for human liberation and societal advancement."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 155, "chapter": null, "s