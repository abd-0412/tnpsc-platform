{"id": "9th-u8-q070", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l2", "chapter_id": null, "topic_id": "oliyin-azhaippu-nature-striving", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஒளியின் அழைப்பு' கவிதையில் 'ஒளி' எதற்கு அடையாளமாகக் காட்டப்படுகிறது?", "media_id": null}], "options": {"A": "தீக்குச்சிக்கு", "B": "அறிவு, வாழ்க்கை விடிவு மற்றும் முன்னேற்றத்திற்கு", "C": "மின்சார விளக்குக்கு", "D": "பகற் பொழுതിന്"}, "explanation": "கவிதையில் 'ஒளி' என்பது மனிதனின் அறியாமை இருளைப் போக்கும் பேரறிவுக்கும், வாழ்வின் முன்னேற்றத்திற்குமான குறியீடாக அமைகிறது."}, "en": {"blocks": [{"type": "text", "content": "In the poem 'Oliyin Azhaippu', what does 'Light' (ஒளி) allegorically symbolize?", "media_id": null}], "options": {"A": "A matchstick flame", "B": "Enlightenment, human wisdom, intellectual awakening, and progressive ascent", "C": "An electric bulb", "D": "Daytime hours"}, "explanation": "Light serves as an archetype of life-force, knowledge, and self-realization piercing through existential darkness."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 168, "chapter":