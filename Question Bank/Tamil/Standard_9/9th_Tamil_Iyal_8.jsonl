{"id": "9th-u8-q124", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l5", "chapter_id": null, "topic_id": "thalai-definition-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நின்ற சீரின் ஈற்றசையும், வரும் சீரின் முதலசையும் பொருந்துவது 'தளை' எனப்படும்; தளை எத்தனை வகைப்படும்?", "media_id": null}], "options": {"A": "ஐந்து", "B": "ஆறு", "C": "எட்டு", "D": "ஏழு"}, "explanation": "நின்ற சீரின் ஈறும் வரும் சீரின் முதலும் தம்மில் கட்டுப்படுவது தளை எனப்படும். இது மொத்தம் 'ஏழு' வகைப்படும்."}, "en": {"blocks": [{"type": "text", "content": "The linkage between the terminal syllable of a preceding foot and the initial syllable of an incoming foot is 'Thalai'. How many types of Thalai exist?", "media_id": null}], "options": {"A": "Five", "B": "Six", "C": "Eight", "D": "Seven (ஏழு வகை)"}, "explanation": "Tamil metrics identifies precisely seven distinct types of Thalai (inter-foot linkages)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 165, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 165", "url": null, "source_notes": null}, "previous_year": {"is_previou