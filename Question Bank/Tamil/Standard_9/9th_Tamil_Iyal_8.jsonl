{"id": "9th-u8-q018", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-language-views", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மொழி குறித்துப் பெரியார் கொண்டிருந்த புரட்சிகரக் கருத்து யாது?", "media_id": null}], "options": {"A": "மொழி மாற்றமே அடையக்கூடாது", "B": "மொழி என்பது மக்களின் தொடர்புச் சாதனம்; அது கால வளர்ச்சிக்கு ஏற்ப வளர வேண்டும்", "C": "பழைய சொற்களை மட்டுமே பேச வேண்டும்", "D": "மொழிக்கும் அறிவியலுக்கும் தொடர்பில்லை"}, "explanation": "'மொழி என்பது மனிதர்களின் கருத்துப் பரிமாற்றத்திற்கான கருவி; காலத்தின் தேவைக்கேற்பவும் அறிவியல் வளர்ச்சிக்கு ஏற்பவும் மொழி தன்னை மாற்றியமைத்துக் கொள்ள வேண்டும்' என்றார் பெரியார்."}, "en": {"blocks": [{"type": "text", "content": "What was Periyar's utilitarian linguistic perspective on language development?", "media_id": null}], "options": {"A": "Language must remain immutable forever", "B": "Language is a tool for human communication that must dynamically evolve with time and scientific progress", "C": "Only archaic vocabulary should be employed", "D": "Language has no connection with science"}, "explanation": "Periyar viewed language as an instrument of communication that must modernize to convey contemporary scientific thought."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, 