{"id": "9th-u8-q009", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "women-rights-property", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெண்களின் பொருளாதார விடுதலைக்காகப் பெரியார் தீவிரமாக வலியுறுத்திய அடிப்படை உரிமை எது?", "media_id": null}], "options": {"A": "குடும்பச் சொத்தில் ஆண்களுக்கு நிகரான சம உரிமை", "B": "இலவச உணவுப் பொருட்கள் பெறுவது", "C": "நகைகள் சேர்ப்பது", "D": "அரண்மனைகளில் வாழ்வது"}, "explanation": "'பெண்களுக்குக் குடும்பச் சொத்தில் ஆண்களுக்கு இணையான சம பங்கு வழங்கப்பட வேண்டும்; அப்போதுதான் பெண்களுக்கு உண்மையான சுதந்திரமும் பாதுகாப்பும் கிடைக்கும்' எனப் பெரியார் வலியுறுத்தினார்."}, "en": {"blocks": [{"type": "text", "content": "Which fundamental economic right did Periyar vigorously champion for the emancipation of women?", "media_id": null}], "options": {"A": "Equal property inheritance rights on par with men in ancestral family wealth", "B": "Receiving free provisions", "C": "Accumulating jewelry", "D": "Residing in palaces"}, "explanation": "Periyar was a pioneer in demanding equal coparcenary property rights for women in ancestral property."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational S