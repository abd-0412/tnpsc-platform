{"id": "9th-u8-q086", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l3", "chapter_id": null, "topic_id": "yasodhara-kaaviyam-author", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "யசோதர காவியத்தை இயற்றிய ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "திருத்தக்கதேவர்", "B": "ஆசிரியர் பெயர் அறியப்படவில்லை (சமண முனிவர் என்பர்)", "C": "தோலாமொழித்தேவர்", "D": "இளங்கோவடிகள்"}, "explanation": "இந்நூல் சமண முனிவர் ஒருவரால் இயற்றப்பட்டது என்பர்; எனினும் இதன் ஆசிரியரின் பெயர் அறியப்படவில்லை."}, "en": {"blocks": [{"type": "text", "content": "Who is the author of the epic poem Yasodhara Kaaviyam?", "media_id": null}], "options": {"A": "Thiruthakkadevar", "B": "Author is anonymous / unknown (attributed to an unnamed Jain monk)", "C": "Tholamozhithevar", "D": "Ilango Adigal"}, "explanation": "The exact identity of the author of Yasodhara Kaaviyam is lost to time, though tradition attributes it to a Jain monk."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 160", "url": null, "source_notes": null}, "previ