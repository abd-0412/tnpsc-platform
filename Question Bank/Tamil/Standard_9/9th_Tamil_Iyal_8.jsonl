{"id": "9th-u8-q002", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-title-year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஈ.வெ.ரா அவர்களுக்கு எந்த ஆண்டு நடைபெற்ற பெண்கள் மாநாட்டில் 'பெரியார்' என்னும் பட்டம் வழங்கப்பட்டது?", "media_id": null}], "options": {"A": "1925", "B": "1938 நவம்பர் 13", "C": "1944", "D": "1970 ஜூன் 27"}, "explanation": "1938-ஆம் ஆண்டு நவம்பர் 13-ஆம் நாள் சென்னையில் நடைபெற்ற பெண்கள் மாநாட்டில் ஈ.வெ.ரா.வுக்குப் 'பெரியார்' என்னும் பட்டம் வழங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "On which historic date was the title 'Periyar' (The Great One) conferred upon E.V. Ramasamy at the Madras Women's Conference?", "media_id": null}], "options": {"A": "1925", "B": "November 13, 1938 (1938 நவம்பர் 13)", "C": "1944", "D": "June 27, 1970"}, "explanation": "On November 13, 1938, the historic Women's Conference held in Chennai officially conferred the title 'Periyar'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 157, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 157", "