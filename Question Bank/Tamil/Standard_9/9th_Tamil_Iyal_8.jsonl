{"id": "9th-u8-q059", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l2", "chapter_id": null, "topic_id": "pitchamurthi-pen-names", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ந. பிச்சமூர்த்தி பயன்படுத்திய புனைப்பெயர்கள் எவை?", "media_id": null}], "options": {"A": "புதுமைப்பித்தன், சொக்கலிங்கம்", "B": "வாணிதாசன், ரமி", "C": "பிசு, ரேவதி", "D": "சுஜாதா, ஈரோடு தமிழன்பன்"}, "explanation": "ந. பிச்சமூர்த்தி 'பிசு', 'ரேவதி' ஆகிய புகழ்பெற்ற புனைப்பெயர்களில் கவிதைகளையும் சிறுகதைகளையும் படைத்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which pen names were utilized by Na. Pitchamurthi in his literary writings?", "media_id": null}], "options": {"A": "Pudumaipithan and Chokkalingam", "B": "Vanidasan and Ramy", "C": "Bisu and Revathi (பிசு, ரேவதி)", "D": "Sujatha and Erode Thamizhanban"}, "explanation": "He wrote prolifically under the pseudonyms 'Bisu' and 'Revathi'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 168, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 168", "url": null, "source_notes": null}, "previous_year": {"is_previous_year":