{"id": "9th-u8-q030", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-women-conference-chennai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "1938 நவம்பர் 13-ல் 'பெரியார்' பட்டம் வழங்கப்பட்ட மாநாட்டின் சிறப்பு என்ன?", "media_id": null}], "options": {"A": "அது ஒரு விவசாயிகள் மாநாடு", "B": "அது பெண்கள் மட்டுமே திரண்டு நடத்திய வரலாற்றுச் சிறப்புமிக்க பெண்கள் மாநாடு", "C": "அது ஓர் இலக்கியப் புலவர் மாநாடு", "D": "அது வணிகர்கள் மாநாடு"}, "explanation": "சென்னையில் பெண்கள் மட்டுமே கூடி நடத்திய புரட்சிகரமான 'பெண்கள் மாநாட்டில்'தான் பெண்களின் விடுதலைக்கு ஆற்றிய தொண்டினைப் பாராட்டி ஈ.வெ.ரா-வுக்குப் 'பெரியார்' பட்டம் வழங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "What was the historic uniqueness of the conference held on November 13, 1938, where the title 'Periyar' was conferred?", "media_id": null}], "options": {"A": "It was an agrarian farmers' convention", "B": "It was an exclusive, historic convention organized and presided over entirely by women (பெண்கள் மாநாடு)", "C": "It was a conference of classical poets", "D": "It was a guild of merchants"}, "explanation": "Women leaders and activists organized this historic women's convention to crown him with the title 'Periyar'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "