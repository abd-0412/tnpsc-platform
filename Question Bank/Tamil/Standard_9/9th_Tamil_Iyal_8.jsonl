{"id": "9th-u8-q041", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-self-respect-marriage-features", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுயமரியாதைத் திருமணத்தின் முதன்மையான சிறப்பம்சமாக அமைவது எது?", "media_id": null}], "options": {"A": "சாதி, மதச் சடங்குகளும் புரோகிதரும் இன்றி வாழ்க்கைத் துணையைச் சமமாக மதித்து உறுதிமொழி ஏற்பது", "B": "அதிக வரதட்சணை கொடுப்பது", "C": "கோவில்களில் மட்டுமே நடத்துவது", "D": "ஜோதிடம் பார்த்து நாள் குறிப்பது"}, "explanation": "புரோகிதர், சடங்குகள், வரதட்சணை ஆகியவற்றை அறவே தவிர்த்து, மணமக்கள் இருவரும் சமத்துவ உணர்வோடு மாலை மாற்றி உறுதிமொழி எடுப்பதே சுயமரியாதைத் திருமணமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the defining hallmark of a Self-Respect Marriage (சுயமரியாதைத் திருமணம்)?", "media_id": null}], "options": {"A": "Mutual equality and solemn pledge without caste rituals, superstitions, dowry, or priestly mediation", "B": "Offering extravagant dowry", "C": "Conducting it solely inside temples", "D": "Fixing dates through astrology"}, "explanation": "Self-Respect marriages are solemnized without priestcraft, mantras, or caste rituals based on egalitarian mutual consent."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "