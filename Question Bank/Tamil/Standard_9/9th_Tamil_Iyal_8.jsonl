{"id": "9th-u8-q051", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-script-reform-typewriter", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழைய தமிழ் எழுத்துகளில் தட்டச்சு செய்யும்போது அதிக விசைகள் (Keys) தேவைப்பட்ட எழுத்துகளைக் குறைத்தவர் யார்?", "media_id": null}], "options": {"A": "பாரதியார்", "B": "வீரமாமுனிவர் மட்டுமே", "C": "தந்தை பெரியார்", "D": "உ.வே.சா"}, "explanation": "வீரமாமுனிவர் எகர, ஒகர எழுத்துகளுக்குப் புள்ளி நீக்கி நெடில் வடிவம் கொடுத்தார்; பிற்காலத்தில் ணா, றா, னா, ணை, லை முதலான எழுத்துகளின் எண்ணிக்கையைத் தட்டச்சுக்கு ஏற்பக் குறைத்துச் சீர்திருத்தியவர் தந்தை பெரியார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who eliminated redundant keys and convoluted ligatures in modern Tamil typewriters through scientific letter standardization?", "media_id": null}], "options": {"A": "Bharathiyar", "B": "Veeramamunivar only", "C": "Thanthai Periyar (தந்தை பெரியார்)", "D": "U.Ve.Sa"}, "explanation": "Periyar rationalized Tamil typographic keys for typewriting and mechanical printing."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edit