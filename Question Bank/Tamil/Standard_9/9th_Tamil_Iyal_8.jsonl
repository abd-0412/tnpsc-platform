{"id": "9th-u8-q069", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l2", "chapter_id": null, "topic_id": "pitchamurthi-manikodi-era", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ந. பிச்சமூர்த்தியின் முதல் சிறுகதையான 'ஸயன்ஸுக்கு பலி' (Science Sacrifice) எப்போது வெளிவந்தது?", "media_id": null}], "options": {"A": "1932-ல் ஆனந்த விகடன் இதழில்", "B": "1947-ல் தினமணியில்", "C": "1920-ல் சுதேசமித்திரனில்", "D": "1950-ல் கலைமகளில்"}, "explanation": "ந. பிச்சமூர்த்தியின் 'ஸயன்ஸுக்கு பலி' என்ற முதல் சிறுகதை 1932-இல் கலைமகள் / விகடன் இதழின் சிறுகதைப் போட்டியில் பரிசு பெற்றது."}, "en": {"blocks": [{"type": "text", "content": "In which era did Na. Pitchamurthi's pioneering short story 'Science-ukku Bali' make its historic mark?", "media_id": null}], "options": {"A": "1932 (1932-ல் வெளிவந்தது)", "B": "1947", "C": "1920", "D": "1950"}, "explanation": "Pitchamurthi won acclaim with his early 1932 short story 'Science-ukku Bali'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 168, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 168", "url": null, "source_notes