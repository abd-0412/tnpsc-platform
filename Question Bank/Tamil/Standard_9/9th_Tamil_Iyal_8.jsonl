{"id": "9th-u8-q140", "schema_version": "1.0", "kind": "conceptual", "level": "analysis", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l5", "chapter_id": null, "topic_id": "yaappu-true-false", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "யாப்பிலக்கணம் பற்றிய கூற்றுகளை ஆராய்க:\nI. யாப்பின் உறுப்புகள் மொத்தம் ஆறு ஆகும்.\nII. குறளடி என்பது இரண்டு சீர்களைக் கொண்டது.\nIII. காய்ச்சீர்கள் வெண்சீர்கள் எனவும் அழைக்கப்படும்.\nIV. வெண்பாவில் கனிச்சீர்கள் தாராளமாக வரலாம்.", "media_id": null}], "options": {"A": "கூற்று I, II, III, IV அனைத்தும் சரி", "B": "கூற்று I, II மட்டும் சரி", "C": "கூற்று III, IV மட்டும் சரி", "D": "கூற்று I, II, III சரி; கூற்று IV தவறு (வெண்பாவில் கனிச்சீர் வரக்கூடாது)"}, "explanation": "கூற்று I, II, III சரி. கூற்று IV தவறு; ஏனெனில் வெண்பாவில் இயற்சீரும் வெண்சீரும் மட்டுமே வர வேண்டும்; கனிச்சீர்கள் வெண்பாவில் வரக்கூடாது."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the prosodic statements on Tamil Yaappilakkanam:\nI. Poetic limbs number six in total.\nII. Kuraladi consists of two feet.\nIII. Kaaychir feet are termed Venchir.\nIV. Kanichir feet are freely permitted in Venba.", "media_id": null}], "options": {"A": "All statements are correct", "B": "Only statements I and II are correct", "C": "Only statements III and IV are correct", "D": "Statements I, II, and III are correct; statement IV is incorrect (Kanichir is strictly forbidden in Venba)"}, "explanation": "Statements I, II, and III are valid prosodic rules. Statement IV is false because Kanichir is disallowed in Venba."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 164, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 164", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_8", "yaappu", "analytical_check"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

