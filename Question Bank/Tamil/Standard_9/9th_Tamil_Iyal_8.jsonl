{"id": "9th-u8-q020", "schema_version": "1.0", "kind": "conceptual", "level": "analysis", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-true-false", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தந்தை பெரியார் பற்றிய கூற்றுகளில் தவறானது எது?", "media_id": null}], "options": {"A": "1924-ல் வைக்கம் போராட்டம் நடத்தி வெற்றி பெற்றார்.", "B": "1938-ல் சென்னையில் நடந்த பெண்கள் மாநாட்டில் 'பெரியார்' பட்டம் வழங்கப்பட்டது.", "C": "1970-ல் யுனெஸ்கோ நிறுவனம் 'தெற்கு ஆசியாவின் சாக்ரடீஸ்' எனப் பாராட்டியது.", "D": "பெண்களுக்குக் குடும்பச் சொத்தில் பங்கு வழங்குவதை அவர் எதிர்த்தார்."}, "explanation": "கூற்று D தவறானது; ஏனெனில் தந்தை பெரியார் பெண்களின் முழுமையான விடுதலைக்குக் குடும்பச் சொத்தில் ஆண்களுக்கு நிகரான சம உரிமை வேண்டும் என்று தீவிரமாக வலியுறுத்தியவர்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following statements concerning Thanthai Periyar is historically FALSE?", "media_id": null}], "options": {"A": "He led the 1924 Vaikom Satyagraha to victory.", "B": "He was conferred the title 'Periyar' at the 1938 Chennai Women's Conference.", "C": "UNESCO recognized him as the 'Socrates of South Asia' in 1970.", "D": "He opposed granting equal ancestral property rights to women."}, "explanation": "Statement D is false because Periyar was the foremost advocate demanding equal property rights for women."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 155, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 155", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_8", "periyar", "true_false"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u8-q021", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-first-magazine", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தந்தை பெரியார் 1925-இல் முதன்முதலில் தொடங்கிய புகழ்பெற்ற தமிழ் இதழ் எது?", "media_id": null}], "options": {"A": "குடியரசு", "B": "விடுதலை", "C": "உண்மை", "D": "ரிவோல்ட்"}, "explanation": "1925-ஆம் ஆண்டு மே 2-ஆம் நாள் தந்தை பெரியார் தமது சுயமரியாதைக் கொள்கைகளைப் பரப்ப 'குடியரசு' வார இதழைத் தொடங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "Which iconic Tamil journal was launched by Thanthai Periyar in 1925 as the flagship mouthpiece of the Self-Respect Movement?", "media_id": null}], "options": {"A": "Kudi Arasu (குடியரசு)", "B": "Viduthalai", "C": "Unmai", "D": "Revolt"}, "explanation": "Kudi Arasu, founded in 1925, was Periyar's premier weekly organ for articulating radical sociopolitical transformation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 156", "url": null, "source_notes": null}, "previous_year"