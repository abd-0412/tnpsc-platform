{"id": "9th-u8-q045", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-eradication-superstition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மூடப்பழக்கவழக்கங்களில் மூழ்கிக் கிடந்த தமிழக மக்களைத் தட்டி எழுப்பப் பெரியார் கையாண்ட கருவி எது?", "media_id": null}], "options": {"A": "பகுத்தறிவுப் பிரச்சாரமும் தன்மான உணர்வும்", "B": "ஆயுதப் போராட்டம்", "C": "மௌன விரதம்", "D": "சட்டமன்றப் பதவிகள்"}, "explanation": "அடிமையாய் உறங்கிக் கிடந்த சமூகம் விழிப்பதற்குச் சுயமரியாதைப் பூபாளம் இசைத்து, பகுத்தறிவுப் பிரச்சாரங்களின் மூலமே மக்களைத் தட்டி எழுப்பினார்."}, "en": {"blocks": [{"type": "text", "content": "Which transformative vehicle did Periyar deploy to awaken Tamil society from slumber and blind superstitions?", "media_id": null}], "options": {"A": "Rationalist advocacy, public debate, and self-respect consciousness (பகுத்தறிவுப் பிரச்சாரம்)", "B": "Armed rebellion", "C": "Vows of silence", "D": "Legislative posts"}, "explanation": "Periyar traveled relentlessly across every hamlet holding thousands of public lectures to ignite rationalism."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9