{"id": "9th-u8-q019", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-child-marriage-opposition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெண்களின் முன்னேற்றத்திற்குத் தடையாக இருந்த எவ்வழக்கங்களைத் தந்தை பெரியார் தீவிரமாக எதிர்த்துக் களமிறங்கினார்?", "media_id": null}], "options": {"A": "யோகாசனம் மற்றும் உடற்பயிற்சி", "B": "தொழில் மற்றும் வர்த்தகம்", "C": "குழந்தைத் திருமணம், கைம்பெண் மறுமணம் மறுப்பு மற்றும் தேவதாசி முறை", "D": "கவிதை பாடுதல் மற்றும் இசை பயில்தல்"}, "explanation": "பெண்களை அடிமைப்படுத்தி வைத்திருந்த குழந்தைத் திருமணம், கைம்பெண் கொடுமை, உடன்கட்டை ஏறுதல் மற்றும் தேவதாசி முறை ஆகிய சமூகக் கொடுமைகளுக்கு எதிராகப் பெரியார் ஓயாது போராடினார்."}, "en": {"blocks": [{"type": "text", "content": "Which oppressive patriarchal practices did Periyar fiercely combat throughout his public career?", "media_id": null}], "options": {"A": "Yoga and physical exercise", "B": "Industrial manufacturing", "C": "Child marriage, prohibition of widow remarriage, and the Devadasi system", "D": "Poetry composition and classical music"}, "explanation": "Periyar spearheaded legislative and social campaigns against child marriage, widow abuse, and the Devadasi system."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "bo