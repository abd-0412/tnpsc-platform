{"id": "9th-u8-q161", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l4", "chapter_id": null, "topic_id": "yasodhara-sargas-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] ஐஞ்சிறு காப்பியங்களுள் ஒன்றான யசோதர காவியம் எத்தனை சருக்கங்களைக் கொண்டது?", "media_id": null}], "options": {"A": "ஐந்து சருக்கங்கள் (320 அல்லது 330 பாடல்கள்)", "B": "ஏழு சருக்கங்கள்", "C": "ஒன்பது சருக்கங்கள்", "D": "பன்னிரண்டு சருக்கங்கள்"}, "explanation": "யசோதர காவியம் அவந்தி நாட்டு மன்னனான யசோதரனின் வரலாற்றைக் கூறும் சமண நூலாகும். இது 5 சருக்கங்களையும் 320 அல்லது 330 பாடல்களையும் கொண்டது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] How many cantos (Sargas) comprise Yasodhara Kaviyam, one of the five minor Tamil epics?", "media_id": null}], "options": {"A": "Five Sargas (5 சருக்கங்கள், containing 320 or 330 verses)", "B": "Seven Sargas", "C": "Nine Sargas", "D": "Twelve Sargas"}, "explanation": "Yasodhara Kaviyam contains 5 cantos (sargas) and approximately 320/330 poems."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "refere