{"id": "9th-u8-q109", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l4", "chapter_id": null, "topic_id": "muthukumar-son-name", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் நா. முத்துக்குமார் இக்கடிதத்தை எந்தப் பாச உணர்வோடு யாருக்கு எழுதினார்?", "media_id": null}], "options": {"A": "தன் அன்பு மகன் ஆதவனுக்கு", "B": "தன் மாணவனுக்கு", "C": "தன் நண்பனுக்கு", "D": "தன் ஆசிரியருக்கு"}, "explanation": "கவிஞர் நா. முத்துக்குமார் தம்முடைய பச்சிளம் மகன் ஆதவனுக்கு வாழ்க்கையின் விழுமியங்களை உணர்த்தும் வகையில் இக்கடிதத்தை எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "To whom was poet Na. Muthukumar's tender paternal letter addressed?", "media_id": null}], "options": {"A": "To his beloved young son Aadhavan (மகன் ஆதவன்)", "B": "To his pupil", "C": "To his friend", "D": "To his schoolteacher"}, "explanation": "Na. Muthukumar penned this letter to his son Aadhavan, imparting timeless paternal counsel."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 161", "url": null, "source_notes": null