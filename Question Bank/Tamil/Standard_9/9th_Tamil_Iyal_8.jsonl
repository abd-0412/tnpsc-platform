{"id": "9th-u8-q071", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l2", "chapter_id": null, "topic_id": "manikodi-movement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ந. பிச்சமூர்த்தி, கு.ப. ராஜகோபாலன், புதுமைப்பித்தன் முதலானோர் தமிழில் நவீன சிறுகதைகளையும் புதுக்கவிதைகளையும் வளர்த்தெடுத்த இதழ் எது?", "media_id": null}], "options": {"A": "குமரிமலர்", "B": "சுதேசமித்திரன்", "C": "மணிக்கொடி", "D": "கிராம ஊழியன்"}, "explanation": "'மணிக்கொடி' இதழ் தமிழ் நவீன இலக்கியத்தில் புதிய மறுமலர்ச்சியை ஏற்படுத்தி புதுக்கவிதைக்கும் சிறுகதைக்கும் களம் அமைத்துக் கொடுத்தது."}, "en": {"blocks": [{"type": "text", "content": "Through which literary magazine did Na. Pitchamurthi, Ku.Pa. Rajagopalan, and Pudumaipithan spark a modern renaissance?", "media_id": null}], "options": {"A": "Kumarimalar", "B": "Swadesamitran", "C": "Manikodi (மணிக்கொடி)", "D": "Grama Oozhiyan"}, "explanation": "The avant-garde journal 'Manikodi' inaugurated the golden modern age of Tamil short stories and free verse."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 168, "chapter": null, "section": null, "referenc