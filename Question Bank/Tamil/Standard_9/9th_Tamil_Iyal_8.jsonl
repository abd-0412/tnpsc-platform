{"id": "9th-u8-q067", "schema_version": "1.0", "kind": "conceptual", "level": "analysis", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l2", "chapter_id": null, "topic_id": "tao-philosophy-form-and-void", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாவோ தே ஜிங் கவிதையின் தலையாய மெய்யியல் முடிவு யாது?", "media_id": null}], "options": {"A": "பொருள் மட்டுமே நிரந்தரமானது", "B": "வெற்றிடம் பயனற்றது", "C": "உருவமுடையவை பயன்பாட்டைத் தருகின்றன; ஆயினும் உருவமற்ற வெற்றிடமே அப்பயன்பாட்டைச் சாத்தியமாக்குகிறது", "D": "அறிவியல் பொய்யானது"}, "explanation": "'உருவம் உடையவை பயன் தருகின்றன; உருவமற்றவையே அந்தப் பயன்பாட்டைச் செயல்படுத்துகின்றன' (Being gives usefulness, but Non-being gives function) என்பதே தாவோயியத்தின் அடிப்படைத் தத்துவமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the profound philosophical deduction of the Tao Te Ching verses?", "media_id": null}], "options": {"A": "Material substance alone is eternal", "B": "Void is useless", "C": "Form/Being (உருவம்) provides utility, yet the Formless Void/Non-being (வெற்றிடம்) realizes that utility", "D": "Science is illusory"}, "explanation": "Taoism teaches that tangible forms create possibility, but the intangible void actualizes true usefulness."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 169, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 169", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_8", "tao_te_ching", "philosophy"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u8-q068", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l2", "chapter_id": null, "topic_id": "tao-te-ching-tamil-translator", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடப்பகுதியில் உள்ள 'தாவோ தே ஜிங்' கவிதையைத் தமிழில் மொழிபெயர்த்தவர் யார்?", "media_id": null}], "options": {"A": "மு. சிவலிங்கம்", "B": "ந. பிச்சமூர்த்தி", "C": "சுஜாதா", "D": "சி. மணி"}, "explanation": "பாடநூலில் இடம்பெற்றுள்ள லா வோட்சுவின் தாவோ தே ஜிங் கவிதையைத் தமிழில் மொழியாக்கம் செய்தவர் புகழ்பெற்ற கவிஞர் 'சி. மணி' ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who translated Lao Tzu's Tao Te Ching verses into Tamil as presented in the textbook?", "media_id": null}], "options": {"A": "Mu. Sivalingam", "B": "Na. Pitchamurthi", "C": "Sujatha", "D": "C. Mani (சி. மணி)"}, "explanation": "Eminent modern poet C. Mani translated Lao Tzu's Tao Te Ching into Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 169, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 169", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": n