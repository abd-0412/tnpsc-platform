{"id": "9th-u8-q082", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l2", "chapter_id": null, "topic_id": "pitchamurthi-award-kalaimagal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ந. பிச்சமூர்த்தியின் 'முள்ளும் ரோஜாவும்' என்ற சிறுகதை எந்த இதழின் போட்டியில் முதல் பரிசு பெற்றது?", "media_id": null}], "options": {"A": "ஆனந்த விகடன்", "B": "கலைமகள் இதழ்", "C": "கல்கி", "D": "குமுதம்"}, "explanation": "கலைமகள் இதழ் நடத்திய சிறுகதைப் போட்டியில் பிச்சமூர்த்தியின் 'முள்ளும் ரோஜாவும்' சிறுகதை முதல் பரிசை வென்றது."}, "en": {"blocks": [{"type": "text", "content": "In which prestigious literary magazine's competition did Pitchamurthi's short story 'Mullum Rojavum' win the first prize?", "media_id": null}], "options": {"A": "Ananda Vikatan", "B": "Kalaimagal (கலைமகள்)", "C": "Kalki", "D": "Kumudam"}, "explanation": "His celebrated story won first prize in Kalaimagal magazine's premier literary contest."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 168, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 168", "url": null, "source_notes": null}, "previous_ye