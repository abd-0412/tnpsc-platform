{"id": "9th-u8-q120", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l5", "chapter_id": null, "topic_id": "eerasai-seer-other-names", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஈரசைச் சீர்களுக்கு வழங்கும் வேறு பெயர்கள் எவை?", "media_id": null}], "options": {"A": "வஞ்சி உரிச்சீர், வெண்சீர்", "B": "கனிச்சீர், காய்ச்சீர்", "C": "நாலசைச்சீர், பொதுச்சீர்", "D": "'இயற்சீர்' மற்றும் 'ஆசிரிய உரிச்சீர்'"}, "explanation": "ஈரசைச் சீர்களான தேமா, புளிமா, கருவிளம், கூவிளம் ஆகிய நான்கிற்கும் 'இயற்சீர்' மற்றும் 'ஆசிரிய உரிச்சீர்' என்னும் சிறப்புப் பெயர்கள் உண்டு."}, "en": {"blocks": [{"type": "text", "content": "What alternate technical designations are accorded to disyllabic metrical feet (Eerasai Seer)?", "media_id": null}], "options": {"A": "Vanji Urichir and Venchir", "B": "Kanichir and Kaaychir", "C": "Naalasai Seer and Pothuchir", "D": "'Iyarchir' and 'Aasiriya Urichir' (இயற்சீர், ஆசிரிய உரிச்சீர்)"}, "explanation": "Disyllabic feet are technically termed Iyarchir (natural feet) and Aasiriya Urichir."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 164, "chapter": null, "sectio