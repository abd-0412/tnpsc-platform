{"id": "9th-u8-q038", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-caste-system-critique", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சாதி அமைப்பை ஒழிக்க வேண்டும் என்று பெரியார் வலியுறுத்தக் காரணம் என்ன?", "media_id": null}], "options": {"A": "அது வரி வசூலைத் தடுக்கிறது", "B": "அது பிறப்பின் அடிப்படையில் மனிதனை இழிவுபடுத்தி, உரிமைகளைப் பறித்து, ஆதிக்கத்தை நிலைநிறுத்துகிறது", "C": "அது வெளிநாட்டு வணிகத்தைத் தடுக்கிறது", "D": "அது விவசாயத்தை அழிக்கிறது"}, "explanation": "சாதி என்பது மனிதர்களைப் பிறப்பின் அடிப்படையில் பிரித்து, ஒருசாரார் மற்றொருசாராரை இழிவுபடுத்தவும் ஆதிக்கம் செலுத்தவும் உதவுவதால் அதனை வேரறுக்க வேண்டும் என்றார்."}, "en": {"blocks": [{"type": "text", "content": "Why did Periyar demand the total eradication of the caste system?", "media_id": null}], "options": {"A": "Because it obstructed tax collection", "B": "Because it degrades humans based on birth, robs their fundamental rights, and entrenches social hegemony", "C": "Because it hampered maritime trade", "D": "Because it hindered farming"}, "explanation": "Periyar identified the caste structure as the root mechanism institutionalizing social degradation and inequality."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_na