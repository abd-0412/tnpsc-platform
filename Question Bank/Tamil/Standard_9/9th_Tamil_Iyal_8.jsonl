{"id": "9th-u8-q094", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l3", "chapter_id": null, "topic_id": "yasodhara-verse-wisdom", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"நோக்குவது ஏதெனில் ஞானம் நோக்குக\" - என்று யசோதர காவியம் எதனை ஆராய வேண்டும் என்று வலியுறுத்துகிறது?", "media_id": null}], "options": {"A": "பொருளாதாரச் சந்தையை", "B": "மெய்யறிவு நூல்களை (உண்மையான ஞானத்தை)", "C": "வானியல் கோள்களை", "D": "பகைவரின் பலத்தை"}, "explanation": "ஒருவன் எதனையாவது ஆராய்ந்து பார்க்க வேண்டும் என்று கருதினால், அவன் மெய்யறிவு தரும் ஞான நூல்களையே ஆராய்ந்து கற்க வேண்டும் என்பது இதன் பொருளாகும்."}, "en": {"blocks": [{"type": "text", "content": "\"Nokkuvathu yethenil gnaanam nokkuga\" - What does the verse urge a person to seek and investigate?", "media_id": null}], "options": {"A": "Commodity trade markets", "B": "True spiritual wisdom and enlightening philosophical treatises (ஞானம் / மெய்யறிவு)", "C": "Celestial planetary bodies", "D": "Enemy army strengths"}, "explanation": "The verse instructs that if one chooses to investigate anything, one should seek true philosophical enlightenment (Gnaanam)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services C