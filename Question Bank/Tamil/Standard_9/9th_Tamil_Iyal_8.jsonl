{"id": "9th-u8-q061", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l2", "chapter_id": null, "topic_id": "oliyin-azhaippu-theme", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஒளியின் அழைப்பு' என்னும் கவிதையின் மையக்கருத்து யாது?", "media_id": null}], "options": {"A": "தாவரங்கள் இருளைக் கிழித்துக்கொண்டு ஒளியை நோக்கி முட்டி மோதி எழுவது போல, மனிதனும் தடைகளைத் தாண்டி முன்னேற வேண்டும்", "B": "காட்டில் மரங்களை வெட்ட வேண்டும் என்பது", "C": "இரவில் தூங்க வேண்டும் என்பது", "D": "விளக்குகளை ஏற்றி வைக்க வேண்டும் என்பது"}, "explanation": "இருளின் சிறையை உடைத்துக்கொண்டு சூரிய ஒளியை நோக்கித் தாவரங்கள் நிமிர்ந்து வளர்வது போல, மனித வாழ்விலும் தடைகளைத் தகர்த்து முன்னேற வேண்டும் என்பதே 'ஒளியின் அழைப்பு' கவிதையின் செய்தியாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the central philosophical theme of Na. Pitchamurthi's poem 'Oliyin Azhaippu' (Call of the Light)?", "media_id": null}], "options": {"A": "Just as saplings breach subterranean darkness striving towards sunlight, humans must overcome obstacles striving for growth", "B": "Felling trees in forests", "C": "Sleeping through the night", "D": "Lighting domestic lamps"}, "explanation": "The poem symbolizes the evolutionary upward striving of living beings breaking through darkness to embrace light."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 168, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 168", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_8", "pitchamurthi", "theme"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u8-q062", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l2", "chapter_id": null, "topic_id": "pitchamurthi-profession", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ந. பிச்சமூர்த்தி கவிதை எழுதுவதற்கு முன்பாக ஆற்றிய அரசுப் பணிகள் எவை?", "media_id": null}], "options": {"A": "காவல்துறை அதிகாரி", "B": "வழக்குரைஞர் (வழக்கறிஞர்) மற்றும் இந்து சமய அறநிலையத் துறை அலுவலர்", "C": "மருத்துவர்", "D": "பொறியாளர்"}, "explanation": "ந. பிச்சமூர்த்தி தொடக்கத்தில் வழக்கறிஞராகவும் (1924-1938), பின்னர் இந்து சமய அறநிலையப் பாதுகாப்புத் துறை அலுவலராகவும் (1938-1954) பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "In which professional vocations did Na. Pitchamurthi serve prior to dedicating himself to literature?", "media_id": null}], "options": {"A": "Police superintendent", "B": "Advocate (Lawyer) and Hindu Religious Endowments Executive Officer", "C": "Physician", "D": "Civil engineer"}, "explanation": "Pitchamurthi practiced law as an advocate and later served as an executive officer in the Hindu Religious Endowments Board."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-