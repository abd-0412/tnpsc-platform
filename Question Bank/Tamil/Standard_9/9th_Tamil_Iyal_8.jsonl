{"id": "9th-u8-q026", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "unesco-citation-words", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "யுனெஸ்கோ மன்றம் பெரியாரைப் பாராட்டி வழங்கிய பாராட்டுரையின் தொடக்கம் யாது?", "media_id": null}], "options": {"A": "இந்தியாவின் தேசத்தந்தை...", "B": "புது உலகத்தின் தொலைநோக்காளர்; தெற்கு ஆசியாவின் சாக்ரடீஸ்...", "C": "ஆசியாவின் அமைதித் தூதர்...", "D": "தமிழினத்தின் தவப்புதல்வர்..."}, "explanation": "யுனெஸ்கோ பாராட்டுரை: 'பெரியார் - புது உலகத்தின் தொலைநோக்காளர்; தெற்கு ஆசியாவின் சாக்ரடீஸ்; சமூகச் சீர்திருத்த இயக்கத்தின் தந்தை; அறியாமை, மூடநம்பிக்கை ஆகியவற்றின் கடும் எதிரி'."}, "en": {"blocks": [{"type": "text", "content": "How does the renowned UNESCO citation honoring Thanthai Periyar commence?", "media_id": null}], "options": {"A": "Father of the Indian nation...", "B": "Prophet of the New Age, Socrates of South Asia, Father of Social Reform Movement...", "C": "Peace ambassador of Asia...", "D": "Noble son of Tamils..."}, "explanation": "The UNESCO citation hails Periyar as the 'Prophet of the New Age, Socrates of South Asia, Father of Social Reform Movement'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Tex