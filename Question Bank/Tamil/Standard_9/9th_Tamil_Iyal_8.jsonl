{"id": "9th-u8-q158", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-vaikom-veerar-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] 1924-ஆம் ஆண்டு கேரளாவில் கோயில் நுழைவுப் போராட்டத்தை வெற்றிகரமாக வழிநடத்தியதால் தந்தை பெரியாருக்குக் கிடைத்த சிறப்புப் பெயர் எது?", "media_id": null}], "options": {"A": "ஈரோட்டுச் சிங்கம்", "B": "வைக்கம் வீரர்", "C": "தென்னாட்டு போஸ்", "D": "பகுத்தறிவுப் பகலவன்"}, "explanation": "கேரளாவில் உள்ள வைக்கம் என்னும் ஊரில் கோயில் வீதிகளில் ஒடுக்கப்பட்ட மக்கள் நடமாட விதிக்கப்பட்ட தடையை எதிர்த்துப் போராடி வெற்றி கண்டதால் பெரியார் 'வைக்கம் வீரர்' எனப் போற்றப்பட்டார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Which title was conferred upon Thanthai Periyar after successfully leading the temple street entry agitation in Kerala in 1924?", "media_id": null}], "options": {"A": "Lion of Erode", "B": "Vaikom Veerar (வைக்கம் வீரர் - Hero of Vaikom)", "C": "Bose of South India", "D": "Pagutharivu Pagalavan"}, "explanation": "For championing temple access for oppressed communities at Vaikom in 1924, Periyar earned the historic title 'Vaikom Veerar'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil N