{"id": "9th-u8-q133", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l5", "chapter_id": null, "topic_id": "muran-thodai-definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சொல்லாலும் பொருளாலும் ஒன்றற்கொன்று எதிரெதிராக முரண்பட்டு வருமாறு பாடலில் தொடுப்பது எது?", "media_id": null}], "options": {"A": "முரண் தொடை", "B": "இரட்டைத் தொடை", "C": "அளபெடைத் தொடை", "D": "செந்தொடை"}, "explanation": "பாடலில் சொல்லாலோ பொருளாலோ முரண்பட்ட சொற்களை (இரவு-பகல், நன்மை-தீமை) அமைத்துப் பாடுவது 'முரண் தொடை' எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "When antithetical words or contrasting concepts are juxtaposed within poetic verses, what Thodai is formed?", "media_id": null}], "options": {"A": "Muran Thodai (முரண் தொடை - Antithesis / Contrast rhyme)", "B": "Irattai Thodai", "C": "Alabedai Thodai", "D": "Sendhodai"}, "explanation": "Muran Thodai weaves verbal or thematic antitheses (light-dark, day-night) across lines."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 166, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 166", "url": null,