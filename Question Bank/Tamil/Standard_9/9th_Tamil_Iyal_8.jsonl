{"id": "9th-u8-q056", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-lesson-grand-summary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெரியாரின் சிந்தனைகள் பாடத்தின் மூலம் மாணவர்கள் கற்றுக்கொள்ள வேண்டிய இன்றியமையாத பண்பு எது?", "media_id": null}], "options": {"A": "பிறரை ஏமாற்றி வாழ்வது", "B": "பழைய மூடநம்பிக்கைகளைத் தொடர்வது", "C": "வீண் ஆடம்பரங்களில் ஈடுபடுவது", "D": "பகுத்தறிவுச் சிந்தனை, சுயமரியாதை உணர்வு, சமத்துவம் மற்றும் மனிதநேயத்தோடு வாழ்வது"}, "explanation": "பகுத்தறிவுப் பார்வையோடு எச்செயலையும் அணுகி, சாதி மதப் பாகுபாடின்றி மனித சமத்துவத்தையும் தன்மானத்தையும் போற்றி வாழ்வதே இப்பாடத்தின் தலையாய நோக்கமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What paramount moral and intellectual takeaway does the lesson on Periyar impart to students?", "media_id": null}], "options": {"A": "Exploiting others for selfish gain", "B": "Perpetuating archaic superstitions", "C": "Indulging in wasteful extravagance", "D": "Living with rational inquiry, self-respect dignity, universal equality, and compassionate humanism"}, "explanation": "The lesson inspires learners to embrace scientific rationalism, human dignity, gender equality, and empathy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book"