{"id": "9th-u8-q147", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l5", "chapter_id": null, "topic_id": "alavadi-four-seers-bookback", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "யாப்பிலக்கணத்தின்படி, நான்கு சீர்களைக் கொண்டு அமையும் அடியின் பெயர் யாது?", "media_id": null}], "options": {"A": "குறளடி", "B": "சிந்தடி", "C": "அளவடி (நேரடி)", "D": "நெடிலடி"}, "explanation": "சீர்கள் எண்ணிக்கையின் அடிப்படையில் அமையும் அடிகள்: 2 சீர் - குறளடி, 3 சீர் - சிந்தடி, 4 சீர் - அளவடி (நேரடி), 5 சீர் - நெடிலடி, 6 அல்லது அதற்கு மேற்பட்டவை - கழிநெடிலடி."}, "en": {"blocks": [{"type": "text", "content": "According to prosodic rules in Tamil, what is a line composed of exactly four feet designated?", "media_id": null}], "options": {"A": "Kuraladi (2 feet)", "B": "Chinthadi (3 feet)", "C": "Alavadi / Naeradi (அளவடி - 4 feet)", "D": "Nediladi (5 feet)"}, "explanation": "A line containing four metrical feet is called Alavadi or Naeradi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 166, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 166", "url": null, "source_not