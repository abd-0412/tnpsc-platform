{"id": "9th-u8-q105", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l3", "chapter_id": null, "topic_id": "ainjiru-kaappiyangal-list", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்கண்டவற்றுள் 'ஐஞ்சிறு காப்பியங்களுள்' சேராத நூல் எது?", "media_id": null}], "options": {"A": "சீவக சிந்தாமணி", "B": "யசோதர காவியம்", "C": "நீலகேசி", "D": "சூளாமணி"}, "explanation": "சீவக சிந்தாமணி என்பது 'ஐம்பெருங்காப்பியங்களுள்' ஒன்று. யசோதர காவியம், உதயணகுமார காவியம், நாககுமார காவியம், நீலகேசி, சூளாமணி ஆகிய ஐந்தும் ஐஞ்சிறு காப்பியங்கள் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following does NOT belong to the Five Minor Epics (Ainjiru Kaappiyangal)?", "media_id": null}], "options": {"A": "Sivaka Chinthamani (சீவக சிந்தாமணி - Major Epic)", "B": "Yasodhara Kaaviyam", "C": "Neelakesi", "D": "Sulamani"}, "explanation": "Sivaka Chinthamani is one of the Five Major Epics (Aimpepumkaappiyangal), not a minor epic."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 160", "url": null, "source_not