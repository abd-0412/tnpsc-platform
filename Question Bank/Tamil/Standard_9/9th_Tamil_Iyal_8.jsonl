{"id": "9th-u8-q083", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l2", "chapter_id": null, "topic_id": "oliyin-azhaippu-photosynthesis-metaphor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஒளியின் அழைப்பு' கவிதையில் தாவரங்களின் எவ்வறிவியல் நிகழ்வு கவிதை நயத்தோடு விவரிக்கப்படுகிறது?", "media_id": null}], "options": {"A": "வேர் அழுகல்", "B": "இலை உதிர்தல்", "C": "ஒளிச்சேர்க்கை மற்றும் ஒளியை நோக்கிய தாவர வளர்ச்சி (Phototropism)", "D": "விதை பரவுதல்"}, "explanation": "தாவரங்கள் சூரிய ஒளியை நாடித் தம் கிளைகளையும் இலைகளையும் நீட்டி வளரும் அறிவியல் உண்மையையே (Phototropism) பிச்சமூர்த்தி கவித்துவமாகப் பாடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Which biological phenomenon of plant growth seeking sunlight (Phototropism) is poetically rendered in 'Oliyin Azhaippu'?", "media_id": null}], "options": {"A": "Root rot", "B": "Leaf senescence", "C": "Phototropism and photosynthetic striving toward solar energy (ஒளியை நோக்கிய வளர்ச்சி)", "D": "Seed dispersal"}, "explanation": "The scientific phenomenon of phototropism is allegorized as nature's unyielding drive toward illumination."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Cor