{"id": "9th-u8-q046", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-thrift-public-funds", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெரியார் பொதுவாழ்வில் கடைப்பிடித்த சிக்கன உணர்வுக்கு மிகச் சிறந்த சான்று எது?", "media_id": null}], "options": {"A": "அரசு நிதியைப் பயன்படுத்தியமை", "B": "அஞ்சல் உறைகளைத் திருப்பி ஒட்டிப் பயன்படுத்தியது முதல் பொதுப்பணத்தைச் சல்லிக்காசும் வீணடிக்காமல் பாதுகாத்தமை", "C": "விழாக்களுக்கு ஆடம்பரமாகச் செலவிட்டமை", "D": "வெளிநாட்டுப் பயணங்களை ஆடம்பரமாக மேற்கொண்டமை"}, "explanation": "பெரியார் தாம் எழுதிய கடிதங்களுக்குக் கூட பழைய அஞ்சல் உறைகளைத் திருப்பி ஒட்டிப் பயன்படுத்தும் அளவிற்குப் பொதுப்பணத்தில் மிகுந்த சிக்கனத்தைக் கடைப்பிடித்தார்."}, "en": {"blocks": [{"type": "text", "content": "What famous historical practice exemplifies Periyar's legendary personal thrift regarding organizational resources?", "media_id": null}], "options": {"A": "Drawing state treasuries", "B": "Reusing turned-over postal envelopes and accounting for every single coin of public funds with pristine honesty", "C": "Hosting lavish banquets", "D": "Traveling in luxury"}, "explanation": "Periyar was legendary for his scrupulous frugality, famously reversing used postal covers to prevent waste."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_