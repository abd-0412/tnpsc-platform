{"id": "9th-u8-q063", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l2", "chapter_id": null, "topic_id": "lao-tzu-tao-te-ching", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தாவோ தே ஜிங்' (Tao Te Ching) என்னும் மெய்யியல் நூலை இயற்றிய சீனத் தத்துவஞானி யார்?", "media_id": null}], "options": {"A": "கன்ஃபூசியஸ்", "B": "மென்சியஸ்", "C": "லா வோட்சு (Lao Tzu)", "D": "சுவாங் சூ"}, "explanation": "'தாவோ தே ஜிங்' என்னும் உலகப் புகழ் பெற்ற தத்துவ நூலை இயற்றியவர் சீன மெய்யியலாளரான லா வோட்சு ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who is the ancient Chinese philosopher-mystic who authored the timeless philosophical classic 'Tao Te Ching'?", "media_id": null}], "options": {"A": "Confucius", "B": "Mencius", "C": "Lao Tzu (லா வோட்சு)", "D": "Zhuangzi"}, "explanation": "Lao Tzu authored the foundational philosophical text 'Tao Te Ching', establishing Taoism."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 169, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 169", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_8", "lao_tzu", "tao_te_ching"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u8-q064", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l2", "chapter_id": null, "topic_id": "lao-tzu-century-contemporary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாவோயியத்தை நிறுவிய லா வோட்சு வாழ்ந்த காலம் மற்றும் அவருடைய சமகாலத்தவர் யார்?", "media_id": null}], "options": {"A": "கி.மு. முதலாம் நூற்றாண்டு, சாணக்கியர்", "B": "கி.பி. இரண்டாம் நூற்றாண்டு, திருவள்ளுவர்", "C": "கி.மு. மூன்றாம் நூற்றாண்டு, அசோகர்", "D": "கி.மு. ஆறாம் நூற்றாண்டு; கன்ஃபூசியஸின் சமகாலத்தவர்"}, "explanation": "லா வோட்சு கி.மு. (பொ.ஆ.மு.) ஆறாம் நூற்றாண்டைச் சேர்ந்தவர். இவர் மற்றொரு புகழ்பெற்ற சீன ஞானியான கன்ஃபூசியஸின் சமகாலத்தவர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "To which century did Lao Tzu belong, and who was his celebrated philosophical contemporary?", "media_id": null}], "options": {"A": "1st Century BCE, Chanakya", "B": "2nd Century CE, Thiruvalluvar", "C": "3rd Century BCE, Ashoka", "D": "6th Century BCE; Contemporary of Confucius (கி.மு. 6-ஆம் நூற்றாண்டு, கன்ஃபூசியஸ்)"}, "explanation": "Lao Tzu lived in 6th Century BCE China as an elder contemporary of Confucius."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "cl