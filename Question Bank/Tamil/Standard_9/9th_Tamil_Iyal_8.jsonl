{"id": "9th-u8-q060", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l2", "chapter_id": null, "topic_id": "pitchamurthi-books", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ந. பிச்சமூர்த்தியின் புகழ்பெற்ற கவிதைத் தொகுப்புகள் எவை?", "media_id": null}], "options": {"A": "தமிழியக்கம், குடும்ப விளக்கு", "B": "அழகின் சிரிப்பு, பாண்டியன் பரிசு", "C": "தேன்பாவை, எழிலோவியம்", "D": "காட்டுவாத்து, லயம்"}, "explanation": "ந. பிச்சமூர்த்தியின் முதன்மையான கவிதைத் தொகுப்புகள் 'காட்டுவாத்து' மற்றும் 'லயம்' ஆகியவை ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which are the celebrated poetry anthologies authored by Na. Pitchamurthi?", "media_id": null}], "options": {"A": "Thamizhiyakkam and Kudumba Vilakku", "B": "Azhagin Sirippu and Pandiyan Parisu", "C": "Thenpaavai and Ezhil Oviyam", "D": "Kaattuvaathu and Layam (காட்டுவாத்து, லயம்)"}, "explanation": "'Kaattuvaathu' (Wild Duck) and 'Layam' are milestone poetic anthologies by Na. Pitchamurthi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 168, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 168", "