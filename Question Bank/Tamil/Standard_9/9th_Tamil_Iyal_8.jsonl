{"id": "9th-u8-q037", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-century-celebration-1978", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "1978-ஆம் ஆண்டு தமிழ்நாடு அரசு பெரியாரின் எத்தனையாவது பிறந்தநாள் நினைவாக அவரது எழுத்துச் சீர்திருத்தத்தை நடைமுறைப்படுத்தியது?", "media_id": null}], "options": {"A": "நூற்றாண்டு விழா (100-வது ஆண்டு)", "B": "பவள விழா (75-வது ஆண்டு)", "C": "பொன் விழா (50-வது ஆண்டு)", "D": "வைர விழா (60-வது ஆண்டு)"}, "explanation": "தந்தை பெரியார் பிறந்த (1879) நூற்றாண்டு விழாவான 1978-ஆம் ஆண்டில் தமிழ்நாடு அரசு பெரியாரின் எழுத்துச் சீர்திருத்தத்தை ஏற்று நடைமுறைப்படுத்தியது."}, "en": {"blocks": [{"type": "text", "content": "On the occasion of which jubilee anniversary of Periyar in 1978 did the Tamil Nadu Government implement his Tamil script reforms?", "media_id": null}], "options": {"A": "Birth Centenary (நூற்றாண்டு விழா - 100th birth anniversary)", "B": "Platinum Jubilee", "C": "Golden Jubilee", "D": "Diamond Jubilee"}, "explanation": "Periyar's birth centenary year (1978-1979) was commemorated by the state government adopting his modernized orthography."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educ