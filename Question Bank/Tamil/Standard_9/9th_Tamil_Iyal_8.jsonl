{"id": "9th-u8-q127", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l5", "chapter_id": null, "topic_id": "adi-types-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரண்டு அல்லது இரண்டிற்கு மேற்பட்ட சீர்கள் தொடர்ந்து வருவது 'அடி' எனப்படும்; அடி எத்தனை வகைப்படும்?", "media_id": null}], "options": {"A": "மூன்று", "B": "நான்கு", "C": "ஐந்து (குறளடி, சிந்தடி, அளவடி, நெடிலடி, கழிநெடிலடி)", "D": "ஆறு"}, "explanation": "சீர்கள் தொடர்ந்து வரும் அடி குரளடி, சிந்தடி, அளவடி, நெடிலடி, கழிநெடிலடி என ஐந்து வகைப்படும்."}, "en": {"blocks": [{"type": "text", "content": "A metrical line formed by two or more feet is 'Adi'. Into how many types is it categorized?", "media_id": null}], "options": {"A": "Three", "B": "Four", "C": "Five (Kuraladi, Chinthadi, Alavadi, Nediladi, Kazhinediladi)", "D": "Six"}, "explanation": "Tamil metrics divides poetic lines into five categories according to the foot count per line."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 166, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 166", "url": null, "source_notes": null}, "previous_yea