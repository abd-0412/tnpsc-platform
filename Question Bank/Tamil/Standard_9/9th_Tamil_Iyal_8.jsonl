{"id": "9th-u8-q106", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l4", "chapter_id": null, "topic_id": "muthukumar-helping-virtue", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"யாராவது உதவி கேட்டால், இல்லை எனினும் கடன் வாங்கியாவது உதவி செய்; அதில் கிடைக்கும் ஆனந்தம் அலாதியானது\" - என்று வலியுறுத்திய பாடலாசிரியர் யார்?", "media_id": null}], "options": {"A": "கண்ணதாசன்", "B": "நா. முத்துக்குமார்", "C": "பட்டுக்கோட்டை கல்யாணசுந்தரம்", "D": "வாலி"}, "explanation": "கவிஞர் நா. முத்துக்குமார் தன் மகனுக்கு எழுதிய கடிதத்தில், பிறருக்கு உதவும் ஈகை உணர்வின் பெருமையை இவ்வாறு பதிவு செய்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "\"If anyone asks for help, even if you lack means, borrow and assist; the bliss found therein is peerless\" - Who advised this?", "media_id": null}], "options": {"A": "Kannadasan", "B": "Na. Muthukumar (நா. முத்துக்குமார்)", "C": "Pattukkottai Kalyanasundaram", "D": "Vaali"}, "explanation": "Na. Muthukumar emphasizes selfless philanthropy in his memorable advice to his son."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 163, 