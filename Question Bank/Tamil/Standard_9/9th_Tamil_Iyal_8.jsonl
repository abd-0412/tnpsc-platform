{"id": "9th-u8-q024", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-viduthalai-daily", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தந்தை பெரியார் தொடங்கி இன்று வரை வெளிவந்து கொண்டிருக்கும் சமூகச் சீர்திருத்த நாளிதழ் எது?", "media_id": null}], "options": {"A": "சுதேசமித்திரன்", "B": "தினமணி", "C": "நவசக்தி", "D": "விடுதலை"}, "explanation": "தந்தை பெரியாரால் 1935-இல் தொடங்கப்பட்ட 'விடுதலை' நாளிதழ் பகுத்தறிவுக் கொள்கைகளைத் தொடர்ந்து பரப்பி வருகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which social reform daily newspaper founded by Thanthai Periyar continues publication to this day?", "media_id": null}], "options": {"A": "Swadesamitran", "B": "Dinamani", "C": "Navasakti", "D": "Viduthalai (விடுதலை)"}, "explanation": "Periyar founded the Tamil daily 'Viduthalai' in 1935 as a fearless vehicle for rationalist social reform."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 156", "url": null, "source_notes": null}, "previous_year": {"is_previo