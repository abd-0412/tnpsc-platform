{"id": "9th-u8-q118", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l5", "chapter_id": null, "topic_id": "seer-types-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அசைகளின் சேர்க்கையினால் உருவாகும் 'சீர்' எத்தனை வகைப்படும்?", "media_id": null}], "options": {"A": "இரண்டு", "B": "நான்கு (ஓரசை, ஈரசை, மூவசை, நாலசை)", "C": "ஆறு", "D": "எட்டு"}, "explanation": "ஒன்று அல்லது அதற்கு மேற்பட்ட அசைகளின் சேர்க்கை சீர் எனப்படும். இது ஓரசைச்சீர், ஈரசைச்சீர், மூவசைச்சீர், நாலசைச்சீர் என நான்கு வகைப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Into how many structural types is a metrical foot (Seer) classified based on syllable count?", "media_id": null}], "options": {"A": "Two", "B": "Four (Orasai, Eerasai, Moovasai, Naalasai - நான்கு வகை)", "C": "Six", "D": "Eight"}, "explanation": "Seers are categorized into four types: monosyllabic, disyllabic, trisyllabic, and tetrasyllabic feet."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 164, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 164", "url": null, "source_notes": null}, "previous_year": {"is_