{"id": "9th-u8-q162", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l4", "chapter_id": null, "topic_id": "ainchirum-kaapiyangal-jainism-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] ஐஞ்சிறு காப்பியங்கள் (யசோதர காவியம், சூளாமணி, நீலகேசி, உதயணகுமார காவியம், நாககுமார காவியம்) அனைத்தும் எந்த சமயத்தைச் சார்ந்த நூல்களாகும்?", "media_id": null}], "options": {"A": "பௌத்த சமயம்", "B": "சமண சமயம்", "C": "வைணவ சமயம்", "D": "சைவ சமயம்"}, "explanation": "ஐஞ்சிறு காப்பியங்கள் என்று வகைப்படுத்தப்பட்ட ஐந்து காப்பியங்களுமே (யசோதர காவியம், சூளாமணி, நீலகேசி, உதயணகுமார காவியம், நாககுமார காவியம்) சமண சமயக் கருத்துகளை விளக்கும் சமணக் காப்பியங்கள் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] To which religious tradition do all the five minor Tamil epics (Ainchiru Kaapiyangal) belong?", "media_id": null}], "options": {"A": "Buddhism", "B": "Jainism (சமண சமயம்)", "C": "Vaishnavism", "D": "Saivism"}, "explanation": "All five minor Tamil epics are Jain philosophical and literary works."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null,