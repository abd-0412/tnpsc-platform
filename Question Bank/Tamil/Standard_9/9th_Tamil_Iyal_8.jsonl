{"id": "9th-u8-q055", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-education-women-quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"பெண்களுக்குக் கல்வி அளிப்பது என்பது ஒரு குடும்பத்திற்கு மட்டுமல்லாமல் ஒட்டுமொத்தச் சமுதாயத்திற்கும் ஒளி தருவதாகும்\" - இவ்வெண்ணத்தை விதைத்தவர் யார்?", "media_id": null}], "options": {"A": "தி. ஜானகிராமன்", "B": "கந்தர்வன்", "C": "தந்தை பெரியார்", "D": "வைரமுத்து"}, "explanation": "பெண்கல்வியே சமுதாய விடிவிற்கான முதல் திறவுகோல் என்று வாழ்நாளெல்லாம் பிரச்சாரம் செய்தவர் தந்தை பெரியார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "\"Educating a woman illuminates not just a single household but transforms the entire fabric of society\" - Who sowed this ideal?", "media_id": null}], "options": {"A": "T. Janakiraman", "B": "Kandharvan", "C": "Thanthai Periyar (தந்தை பெரியார்)", "D": "Vairamuthu"}, "explanation": "Periyar forcefully championed female education as the paramount engine of societal enlightenment."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 155, "chapter": nu