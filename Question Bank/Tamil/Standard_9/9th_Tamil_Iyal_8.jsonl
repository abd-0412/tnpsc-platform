{"id": "9th-u8-q010", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "family-planning-quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"குழந்தை பெறுவது என்பது பெண்களின் முழுமையான தனிப்பட்ட உரிமை; குடும்பக் கட்டுப்பாடு பெண்களின் சுதந்திரத்திற்கு இன்றியமையாதது\" என்று தொலைநோக்கோடு கூறியவர் யார்?", "media_id": null}], "options": {"A": "ராஜாஜி", "B": "தந்தை பெரியார்", "C": "பாரதியார்", "D": "வ.உ.சி"}, "explanation": "இந்தியாவில் முதன்முதலாகக் குடும்பக் கட்டுப்பாடு (கருத்தடை) பெண்களின் சுதந்திரத்திற்கும் உடல் நலத்திற்கும் மிக மிக அவசியம் என 1930-களிலேயே வலியுறுத்தியவர் தந்தை பெரியார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who pioneered advocacy for family planning and reproductive autonomy as vital components of women's liberation?", "media_id": null}], "options": {"A": "Rajaji", "B": "Thanthai Periyar (தந்தை பெரியார்)", "C": "Bharathiyar", "D": "V.O.C"}, "explanation": "Periyar championed family planning and birth control as essential prerequisites for female autonomy and emancipation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2