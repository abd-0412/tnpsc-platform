{"id": "9th-u8-q113", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l5", "chapter_id": null, "topic_id": "yaappu-uruppukal-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "யாப்பிலக்கணத்தின்படி செய்யுளுக்குரிய உறுப்புகள் எத்தனை?", "media_id": null}], "options": {"A": "ஆறு (எழுத்து, அசை, சீர், தளை, அடி, தொடை)", "B": "நான்கு", "C": "ஐந்து", "D": "எட்டு"}, "explanation": "செய்யுள் இயற்றும் உறுப்புகள் எழுத்து, அசை, சீர், தளை, அடி, தொடை என மொத்தம் ஆறு வகைப்படும்."}, "en": {"blocks": [{"type": "text", "content": "How many constituent limbs (Uruppukal) make up poetic prosody according to Tamil Yaappilakkanam?", "media_id": null}], "options": {"A": "Six (Ezhuthu, Asai, Seer, Thalai, Adi, Thodai - ஆறு உறுப்புகள்)", "B": "Four", "C": "Five", "D": "Eight"}, "explanation": "Tamil classical poetics delineates six structural limbs: phoneme, syllable, foot, linkage, meter line, and rhyme."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 164, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 164", "url": null, "source_notes": null}, "previous_year": {"is_previous_y