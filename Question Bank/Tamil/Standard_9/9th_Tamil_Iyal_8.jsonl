{"id": "9th-u8-q125", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l5", "chapter_id": null, "topic_id": "nerondraasiriya-thalai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மாமுன் நேர்' வருவது எவ்வகைத் தளையாகும்?", "media_id": null}], "options": {"A": "நேரொன்றாசிரியத் தளை", "B": "நிரையொன்றாசிரியத் தளை", "C": "இயற்சீர் வெண்டளை", "D": "வெண்சீர் வெண்டளை"}, "explanation": "மாச்சீரின் முன் (தேமா, புளிமா) வரும் சீரின் முதல் அசையாக 'நேர்' அசை வந்து இணைவது 'நேரொன்றாசிரியத் தளை' எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "When an incoming foot begins with 'Ner' following a Maa foot (Maa-mun Ner), which Thalai is created?", "media_id": null}], "options": {"A": "Nerondraasiriya Thalai (நேரொன்றாசிரியத் தளை)", "B": "Niraiyondraasiriya Thalai", "C": "Iyarchir Vendalai", "D": "Venchir Vendalai"}, "explanation": "Maa-mun Ner yields Nerondraasiriya Thalai, characteristic of Aasiriyappa."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 165, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 165", "url": null, "source_notes": null}, "previous_year