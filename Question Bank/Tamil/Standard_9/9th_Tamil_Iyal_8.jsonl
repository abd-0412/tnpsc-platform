{"id": "9th-u8-q163", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l4b", "chapter_id": null, "topic_id": "muthukumar-national-awards-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] 'தங்க மீன்கள்' மற்றும் 'சைவம்' ஆகிய திரைப்படப் பாடல்களுக்காக இரண்டு முறை சிறந்த பாடலாசிரியருக்கான இந்திய தேசிய விருது பெற்ற கவிஞர் யார்?", "media_id": null}], "options": {"A": "கண்ணதாசன்", "B": "வாலி", "C": "நா. முத்துக்குமார்", "D": "வைரமுத்து"}, "explanation": "பாடநூல் குறிப்பு: கவிஞர் நா. முத்துக்குமார் 'தங்க மீன்கள்' திரைப்படத்தின் 'ஆனந்த யாழை மீட்டுகிறாய்' பாடலுக்காகவும், 'சைவம்' திரைப்படத்தின் 'அழகே அழகே' பாடலுக்காகவும் இரண்டு முறை தேசிய விருது பெற்றார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Which lyricist received the prestigious National Film Award twice for best lyrics for the movies 'Thanga Meengal' and 'Saivam'?", "media_id": null}], "options": {"A": "Kannadasan", "B": "Vaali", "C": "Na. Muthukumar (நா. முத்துக்குமார்)", "D": "Vairamuthu"}, "explanation": "Na. Muthukumar was honored with two National Awards for 'Thanga Meengal' and 'Saivam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "te