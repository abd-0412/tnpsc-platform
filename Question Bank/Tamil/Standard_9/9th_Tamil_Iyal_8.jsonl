{"id": "9th-u8-q087", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l3", "chapter_id": null, "topic_id": "yasodhara-kaaviyam-hero-country", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "யசோதர காவியம் எந்நாட்டு மன்னனின் வாழ்க்கை வரலாற்றைக் கூறுகிறது?", "media_id": null}], "options": {"A": "மகத நாடு", "B": "கோசல நாடு", "C": "அவந்தி நாட்டு மன்னன் யசோதரன்", "D": "பாஞ்சால நாடு"}, "explanation": "யசோதர காவியம், 'யசோதரன்' என்னும் அவந்தி நாட்டு மன்னனின் வாழ்க்கை வரலாற்றையும் அறநெறிகளையும் எடுத்துரைக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "The epic chronicles the life and spiritual transformation of the king of which ancient realm?", "media_id": null}], "options": {"A": "Magadha", "B": "Kosala", "C": "King Yasodhara of Avanti country (அவந்தி நாட்டு மன்னன்)", "D": "Panchala"}, "explanation": "Yasodhara Kaaviyam details the story of King Yasodhara, ruler of the historic kingdom of Avanti."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 160", "url": null, "source_notes": null}, "previous_year"