{"id": "9th-u8-q137", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l5", "chapter_id": null, "topic_id": "venba-rules-seers", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெண்பாவில் அமைய வேண்டிய அனுமதிக்கப்பட்ட சீர்கள் எவை?", "media_id": null}], "options": {"A": "இயற்சீரும் வெண்சீரும் மட்டுமே (கனிச்சீர்கள் வரக்கூடாது)", "B": "கனிச்சீர்கள் மட்டுமே", "C": "வஞ்சி உரிச்சீர்கள் மட்டுமே", "D": "நாலசைச்சீர்கள் மட்டுமே"}, "explanation": "பாடநூலில்: 'வெண்பாவில் இயற்சீரும் (ஈரசைச்சீர்), வெண்சீரும் (காய்ச்சீர்) மட்டுமே வரும்; பிற சீர்கள் வாரா' எனத் தெளிவாகக் குறிப்பிடப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Which metrical feet are exclusively permissible in a classical Venba stanza?", "media_id": null}], "options": {"A": "Only Iyarchir (disyllabic) and Venchir (Kaaychir) - no Kanichir allowed", "B": "Only Kanichir", "C": "Only Vanji Urichir", "D": "Only tetrasyllabic feet"}, "explanation": "Venba strictly allows only Iyarchir and Venchir; Kanichir is forbidden."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 165, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 165", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_8", "venba", "rules"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u8-q138", "schema_version": "1.0", "kind": "application", "level": "application", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l5", "chapter_id": null, "topic_id": "seer-alaku-themaa", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கற்றல்' என்னும் சொல்லை அசை பிரித்தால் வரும் வாய்பாடு எது?", "media_id": null}], "options": {"A": "புளிமா (நிரை நேர்)", "B": "தேமா (நேர் நேர்)", "C": "கூவிளம் (நேர் நிரை)", "D": "கருவிளம் (நிரை நிரை)"}, "explanation": "கற் (தனிக்குறில் ஒற்று = நேர்) + றல் (தனிக்குறில் ஒற்று = நேர்) = நேர் நேர். நேர் நேர் என்பதன் வாய்பாடு 'தேமா' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the prosodic formula when scansion is performed on the word 'Katral' (கற்றல்)?", "media_id": null}], "options": {"A": "Pulima (Nirai Ner)", "B": "Thema (Ner Ner - நேர் நேர்)", "C": "Koovilam (Ner Nirai)", "D": "Karuvilam (Nirai Nirai)"}, "explanation": "'Kat' (short + consonant = Ner) + 'ral' (short + consonant = Ner) = Ner Ner, which is Thema."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 164, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 164", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_8", "alageduthal", "thema"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u8-q139", "schema_version": "1.0", "kind": "application", "level": "application", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l5", "chapter_id": null, "topic_id": "seer-alaku-pulimaa", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'அகரம்' என்னும் சொல்லின் அசை வாய்பாடு யாது?", "media_id": null}], "options": {"A": "தேமா (நேர் நேர்)", "B": "கருவிளம் (நிரை நிரை)", "C": "புளிமா (நிரை நேர்)", "D": "கூவிளம் (நேர் நிரை)"}, "explanation": "அக (இருகுறில் = நிரை) + ரம் (தனிக்குறில் ஒற்று = நேர்) = நிரை நேர். நிரை நேர் என்பதன் வாய்பாடு 'புளிமா' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the scansion formula for the trisyllabic phoneme word 'Agaram' (அகரம்)?", "media_id": null}], "options": {"A": "Thema", "B": "Karuvilam", "C": "Pulima (Nirai Ner - நிரை நேர்)", "D": "Koovilam"}, "explanation": "'A-ga' (two shorts = Nirai) + 'ram' (short with consonant = Ner) = Nirai Ner, which is Pulima."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 164, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 164", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null,