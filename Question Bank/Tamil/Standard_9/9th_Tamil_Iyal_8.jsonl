{"id": "9th-u8-q050", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-self-respect-slogan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"சுயமரியாதை இல்லாத மனிதன் வெறும் பிணம்\" என்று மனித மாண்பை முதன்மைப்படுத்தியவர் யார்?", "media_id": null}], "options": {"A": "காமராசர்", "B": "தந்தை பெரியார்", "C": "வ.உ.சி", "D": "பாரதிதாசன்"}, "explanation": "மனிதனுக்கு மானமும் சுயமரியாதையுமே முதன்மையானது; சுயமரியாதை இல்லாத மனிதன் உயிருடன் இருந்தும் பிணத்திற்கு ஒப்பாவான் என்று பெரியார் முழங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "\"A human being devoid of self-respect is a mere living corpse\" - Who proclaimed this to dignify human worth?", "media_id": null}], "options": {"A": "Kamarajar", "B": "Thanthai Periyar (தந்தை பெரியார்)", "C": "V.O.C", "D": "Bharathidasan"}, "explanation": "Periyar proclaimed that self-respect is the paramount attribute of human dignity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 154, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 154", "url": null, "sourc