{"id": "9th-u9-q116", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l5", "chapter_id": null, "topic_id": "ilporul-uvamai-def", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உலகில் இல்லாத ஒன்றை (இயற்கையில் ஒருபோதும் நிகழாத ஒன்றை) உவமையாகக் கூறிப் பாடுவது எவ்வகை அணியாகும்?", "media_id": null}], "options": {"A": "உருவக அணி", "B": "சொற்பொருள் பின்வருநிலையணி", "C": "சிலேடை அணி", "D": "இல் பொருள் உவமையணி"}, "explanation": "உலகில் இயல்பாக இல்லாத அல்லது ஒருபோதும் நிகழாத கற்பனையான ஒன்றை உவமையாகக் கூறுவது 'இல் பொருள் உவமையணி' (இல் + பொருள் = இல்லாத பொருள்) எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What rhetorical figure compares a subject to an imaginary phenomenon that does not exist in nature?", "media_id": null}], "options": {"A": "Metaphor", "B": "Sorporul Pinvarunilai Ani", "C": "Pun / Double Entendre", "D": "Ilporul Uvamai Ani (இல் பொருள் உவமையணி - Non-existent object simile)"}, "explanation": "Ilporul Uvamai Ani draws comparisons with impossible or fictitious objects."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 189, "chapter": null, "sectio