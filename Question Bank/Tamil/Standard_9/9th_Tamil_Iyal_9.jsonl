{"id": "9th-u9-q123", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l5", "chapter_id": null, "topic_id": "irattura-mozhithal-siledai-def", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒரு செய்யுளில் ஒரு சொல்லோ அல்லது தொடரோ இரு பொருள்படுமாறு பாடுவது எவ்வகை அணி?", "media_id": null}], "options": {"A": "வேற்றுமை அணி", "B": "சொற்பொருள் பின்வருநிலையணி", "C": "இரட்டுற மொழிதல் அணி (சிலேடை அணி)", "D": "வஞ்சப்புகழ்ச்சி அணி"}, "explanation": "ஒரு செய்யுளில் ஒரு சொல்லோ தொடரோ இரண்டு வெவ்வேறு பொருள்களைத் தருமாறு அமையப் பாடுவது 'இரட்டுற மொழிதல் அணி' அல்லது 'சிலேடை அணி' எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "When a single word or phrase is constructed to yield two distinct semantic interpretations, what figure is formed?", "media_id": null}], "options": {"A": "Vaetrumai Ani", "B": "Sorporul Pinvarunilai Ani", "C": "Irattura Mozhithal Ani / Siledai (இரட்டுற மொழிதல் / சிலேடை - Double Entendre / Pun)", "D": "Vanjappugazhchi Ani"}, "explanation": "Irattura Mozhithal (or Siledai) is the deliberate use of double entendre yielding two coherent readings."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "fu