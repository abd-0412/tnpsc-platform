{"id": "9th-u9-q072", "schema_version": "1.0", "kind": "factual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l3", "chapter_id": null, "topic_id": "why-called-paalai-paadiya", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெருங்கடுங்கோவுக்குப் 'பாலை பாடிய பெருங்கடுங்கோ' என்ற சிறப்புப் பெயர் வரக் காரணம் யாது?", "media_id": null}], "options": {"A": "பாலை நிலத்தில் போர் புரிந்த மன்னர் என்பதால்", "B": "பாலைக்காய்களை மிகுதியாக உண்டதால்", "C": "பாலை நிலத்தில் கோயில் கட்டியதால்", "D": "கலித்தொகையில் பாலைத்திணையைப் பாடிய சிறப்பினால்"}, "explanation": "சேர மரபினர் ஆகிய இவர், எட்டுத்தொகை நூல்களுள் ஒன்றான கலித்தொகையில் பாலைத்திணைப் பாடல்களை மிகச் சிறப்பாகப் பாடியதால் 'பாலை பாடிய பெருங்கடுங்கோ' என்று அழைக்கப்பட்டார்."}, "en": {"blocks": [{"type": "text", "content": "Why was Perungadungko specifically epitheted as 'Paalai Paadiya Perungadungko'?", "media_id": null}], "options": {"A": "Because he fought military campaigns in desert terrain", "B": "Because he consumed desert fruits", "C": "Because he constructed a temple in the desert", "D": "Because he masterfully composed the Paalai thinai section in Kalithogai"}, "explanation": "He gained this title because he authored the poignant Paalai verses of Kalithogai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kal