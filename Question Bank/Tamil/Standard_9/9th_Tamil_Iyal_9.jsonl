{"id": "9th-u9-q087", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l4", "chapter_id": null, "topic_id": "singaram-indonesia-employment", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ப. சிங்காரம் இளமைக் காலத்தில் வேலை நிமித்தமாகத் தென்கிழக்காசியாவில் எந்த நாட்டிற்குச் சென்று வாழ்ந்தார்?", "media_id": null}], "options": {"A": "மியான்மர் (பர்மா)", "B": "தாய்லாந்து", "C": "இந்தோனேசியா (சுமாத்ரா, மேடான் தீவு)", "D": "வியட்நாம்"}, "explanation": "ப. சிங்காரம் வேலைக்காக இந்தோனேசியாவுக்குச் சென்று அங்குள்ள சுமாத்ரா தீவின் மேடான் (Medan) நகரில் பல ஆண்டுகள் வாழ்ந்தார்."}, "en": {"blocks": [{"type": "text", "content": "To which Southeast Asian country did Pa. Singaram travel for employment in his youth?", "media_id": null}], "options": {"A": "Myanmar (Burma)", "B": "Thailand", "C": "Indonesia (Sumatra, Medan city - இந்தோனேசியா)", "D": "Vietnam"}, "explanation": "He lived and worked in Medan on Sumatra island in Indonesia."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 186, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 186", "url": null, "source_note