{"id": "9th-u9-q095", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l4", "chapter_id": null, "topic_id": "voyage-waters-malacca-strait", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொங்கான் (மரக்கப்பல்) கடுமையான புயலில் சிக்கிய கடல் பகுதி எது?", "media_id": null}], "options": {"A": "பசிபிக் பெருங்கடல் நடுவே", "B": "அரபிக்கடல்", "C": "இந்தோனேசியாவிற்கும் மலேசியாவிற்கும் இடைப்பட்ட மலாக்கா நீரிணை மற்றும் இந்தியப் பெருங்கடல் பகுதி", "D": "செங்கடல்"}, "explanation": "இந்தோனேசியாவின் சுமாத்ரா தீவிலிருந்து புறப்பட்ட கப்பல், மலாக்கா நீரிணை வழியே மலேசியாவின் பினாங்கு துறைமுகம் நோக்கிச் செல்லும்போது பெருங்கடல் புயலில் சிக்கியது."}, "en": {"blocks": [{"type": "text", "content": "In which waters did the wooden vessel (Thongaan) get trapped in the ferocious storm?", "media_id": null}], "options": {"A": "Middle of the Pacific Ocean", "B": "Arabian Sea", "C": "Strait of Malacca and Indian Ocean waters between Indonesia and Malaysia", "D": "Red Sea"}, "explanation": "The ship was caught in a tempest traversing the Malacca Strait towards Penang."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-202