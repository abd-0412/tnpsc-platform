// ==============================================================================
// பாடம் 2: விரிவாகும் ஆளுமை - பகுதி 2 (உலகளாவிய மனிதநேயம்) [Q029 - Q056]
// சங்கப் புறநானூறு 'யாதும் ஊரே யாவரும் கேளிர்' (கணியன் பூங்குன்றனார்), மேலை மெய்யியலாளர்கள் (செனகா, மார்கஸ் அரேலியஸ், பிளேட்டோ), வள்ளுவர் 'பிறப்பொக்கும் எல்லா உயிர்க்கும்', மேனாட்டுத் தமிழறிஞர்கள் (போப், கால்டுவெல், பெஸ்கி, எல்லிஸ்)
// ==============================================================================
{"id": "9th-u9-q029", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "thaninayagam-degrees-languages", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தனிநாயக அடிகள் தமிழ் தவிர வேறு எந்தெந்த மொழிகளில் ஆழ்ந்த புலமை பெற்றிருந்தார்?", "media_id": null}], "options": {"A": "ஆங்கிலம், இலத்தீன், கிரேக்கம், பிரெஞ்சு, ஜெர்மன் முதலான பல மொழிகள்", "B": "சீனம் மற்றும் ஜப்பானிய மொழிகள் மட்டுமே", "C": "அரபு மற்றும் பாரசீக மொழிகள் மட்டுமே", "D": "இலத்தீன் மற்றும் சமஸ்கிருதம் மட்டுமே"}, "explanation": "தனிநாயக அடிகள் தமிழோடு ஆங்கிலம், இலத்தீன், கிரேக்கம், பிரெஞ்சு, போர்த்துகீசியம், ஜெர்மன் உள்ளிட்ட பல உலக மொழிகளில் புலமைபெற்றுத் தமிழின் பெருமையை மேலைநாடுகளில் சான்றுகளுடன் விளக்கினார்."}, "en": {"blocks": [{"type": "text", "content": "Besides Tamil, in which international languages was Father Thaninayagam profoundly erudite?", "media_id": null}], "options": {"A": "English, Latin, Greek, French, German, and Portuguese (பல்மொழிப் புலவர்)", "B": "Chinese and Japanese only", "C": "Arabic and Persian only", "D": "Latin and Sanskrit only"}, "explanation": "Father Thaninayagam was a polyglot proficient in English, Latin, Greek, French, German, and Portuguese."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samache