{"id": "9th-u9-q027", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "thaninayagam-death-legacy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உலகத் தமிழாராய்ச்சி நிறுவனம் (International Institute of Tamil Studies - IITS) சென்னையில் நிறுவப்படுவதற்கு அடித்தளமிட்டவர் யார்?", "media_id": null}], "options": {"A": "மறைமலையடிகள்", "B": "உ. வே. சாமிநாதையர்", "C": "தனிநாயக அடிகள் (பேரறிஞர் அண்ணாவுடன் இணைந்து)", "D": "சி. இலக்குவனார்"}, "explanation": "1968-இல் சென்னையில் நடைபெற்ற இரண்டாம் உலகத் தமிழாராய்ச்சி மாநாட்டின் தொடர்ச்சியாக சென்னையில் 'உலகத் தமிழாராய்ச்சி நிறுவனம்' தோன்றுவதற்குக் காரணமானவர் தனிநாயகம் அடிகளார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who was instrumental in conceiving and establishing the International Institute of Tamil Studies (IITS) in Chennai?", "media_id": null}], "options": {"A": "Maraimalai Adigal", "B": "U. V. Swaminatha Iyer", "C": "Father Xavier Thaninayagam (in coordination with Perarignar Anna)", "D": "C. Ilakkuvanar"}, "explanation": "Father Thaninayagam, working with Anna, laid the institutional groundwork for IITS in Chennai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational S