{"id": "9th-u9-q143", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l3", "chapter_id": null, "topic_id": "bookback-kurunthogai-adi-ellai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூல் பலவுள் தெரிக: குறுந்தொகைப் பாடல்களின் அடிவரையறை (அடி எல்லை) யாது?", "media_id": null}], "options": {"A": "3 முதல் 6 அடிகள்", "B": "9 முதல் 12 அடிகள்", "C": "4 முதல் 8 அடிகள் (குறைந்த அடி எல்லை)", "D": "13 முதல் 31 அடிகள்"}, "explanation": "குறுந்தொகை 4 அடிச் சிற்றெல்லையும் 8 அடிப் பேரெல்லையும் கொண்ட அகவற்பாக்களால் ஆனது."}, "en": {"blocks": [{"type": "text", "content": "Book Back: What is the poetic line constraint (metrical span) of Kurunthogai?", "media_id": null}], "options": {"A": "3 to 6 lines", "B": "9 to 12 lines", "C": "4 to 8 lines (4 முதல் 8 அடிகள்)", "D": "13 to 31 lines"}, "explanation": "Kurunthogai verses range strictly between 4 and 8 lines."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 181, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 181", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "e