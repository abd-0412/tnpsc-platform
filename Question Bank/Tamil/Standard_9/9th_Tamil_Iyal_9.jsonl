{"id": "9th-u9-q059", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l2", "chapter_id": null, "topic_id": "sahitya-akademi-oru-siru-isai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வண்ணதாசன் எந்தச் சிறுகதைத் தொகுப்பிற்காக 2016-ஆம் ஆண்டிற்கான புகழ்பெற்ற சாகித்திய அகாதெமி விருது பெற்றார்?", "media_id": null}], "options": {"A": "சமவெளி", "B": "கலைக்க முடியாத ஒப்பனைகள்", "C": "'ஒரு சிறு இசை' (2016)", "D": "தோட்டத்துக்கு வெளியிலும் சில பூக்கள்"}, "explanation": "வண்ணதாசன் எழுதிய 'ஒரு சிறு இசை' என்ற சிறுகதைத் தொகுப்பிற்கு 2016-ஆம் ஆண்டுக்கான மதிப்புமிக்க மத்திய சாகித்திய அகாதெமி விருது வழங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "For which short story anthology was Vannadasan conferred the prestigious Sahitya Akademi Award in 2016?", "media_id": null}], "options": {"A": "Samaveli", "B": "Kalaikka Mudiyaatha Oppanaigal", "C": "'Oru Siru Isai' (ஒரு சிறு இசை - 2016)", "D": "Thottathukku Veliyilum Sila Pookkal"}, "explanation": "Vannadasan won the 2016 Sahitya Akademi Award for his short story collection 'Oru Siru Isai'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-20