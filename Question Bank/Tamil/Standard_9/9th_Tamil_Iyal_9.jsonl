{"id": "9th-u9-q166", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l5", "chapter_id": null, "topic_id": "pyq-vaetrumai-ani-definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] செய்யுளில் இரு பொருள்களுக்கு இடையே உள்ள ஒற்றுமையைக் கூறி, பின்னர் அவற்றுள் ஒன்றை வேறுபடுத்திக் காட்டுவது எவ்வகை அணி?", "media_id": null}], "options": {"A": "உவமை அணி", "B": "வேற்றுமை அணி", "C": "உருவக அணி", "D": "வஞ்சப்புகழ்ச்சி அணி"}, "explanation": "இரு பொருள்களுக்கு இடையே உள்ள ஒற்றுமையைக் கூறி, பின்னர் அவற்றுள் ஒன்றை மற்றொன்றிலிருந்து வேறுபடுத்திக் காட்டுவது 'வேற்றுமை அணி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Stating initial similarity between two items and then differentiating one from the other defines which figure of speech?", "media_id": null}], "options": {"A": "Uvamai Ani", "B": "Vaetrumai Ani (வேற்றுமை அணி)", "C": "Uruvaga Ani", "D": "Vanjappugazhchi Ani"}, "explanation": "Antithetical distinction after establishing similarity defines Vaetrumai Ani."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 191, "chapter": null, "section": null, "