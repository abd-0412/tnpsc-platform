{"id": "9th-u9-q089", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l4", "chapter_id": null, "topic_id": "singaram-philanthropic-trust", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாம் ஈட்டிய வாழ்நாள் சேமிப்பான ஏழரை இலட்ச ரூபாயை மாணவர்களின் கல்வி வளர்ச்சிக்காக அறக்கட்டளை அமைத்து வழங்கிய பெருந்தகை யார்?", "media_id": null}], "options": {"A": "எழுத்தாளர் ப. சிங்காரம்", "B": "கல்யாண்ஜி", "C": "புதுமைப்பித்தன்", "D": "கு. அழகிரிசாமி"}, "explanation": "ப. சிங்காரம் எளிய வாழ்க்கை வாழ்ந்ததோடு, தாம் சேர்த்து வைத்த ஏழரை இலட்ச ரூபாயைச் சிங்கம்புணரி பள்ளி மாணவர்களின் கல்வி உதவித்தொகைக்காக அறக்கட்டளையாக வழங்கிச் சமூக அக்கறையை நிலைநாட்டினார்."}, "en": {"blocks": [{"type": "text", "content": "Which author donated his entire life savings of seven and a half lakh rupees to establish an educational trust for students?", "media_id": null}], "options": {"A": "Writer Pa. Singaram (ப. சிங்காரம்)", "B": "Kalyanji", "C": "Pudhumaipithan", "D": "Ku. Alagirisamy"}, "explanation": "Pa. Singaram donated Rs 7.5 lakhs for student educational scholarships in Singampunari."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "editio