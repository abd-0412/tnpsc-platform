{"id": "9th-u9-q100", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l4", "chapter_id": null, "topic_id": "destination-penang-port", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புயலிலிருந்து தப்பிய தொங்கான் இறுதியாக எந்தத் துறைமுகத்தை நோக்கிப் பயணத்தைத் தொடர்ந்தது?", "media_id": null}], "options": {"A": "கொழும்புத் துறைமுகம்", "B": "சிங்கப்பூர் துறைமுகம்", "C": "சென்னைத் துறைமுகம்", "D": "பினாங்கு துறைமுகம் (மலேசியா)"}, "explanation": "புயலில் அலைக்கழிக்கப்பட்ட மரக்கப்பல் திசை அறிந்து மெல்ல மலேசியாவின் 'பினாங்கு' (Penang) துறைமுகத்தை நோக்கி நகர்ந்தது."}, "en": {"blocks": [{"type": "text", "content": "Toward which port of destination did the surviving wooden vessel steer after overcoming the storm?", "media_id": null}], "options": {"A": "Colombo Port", "B": "Singapore Port", "C": "Chennai Port", "D": "Penang Port (Malaysia - பினாங்கு துறைமுகம்)"}, "explanation": "The ship made its way safely towards the port of Penang in Malaysia."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 185, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 185", "url": nu