{"id": "9th-u9-q117", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l5", "chapter_id": null, "topic_id": "uruvaga-ani-def", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உவமிக்கப்படும் பொருளையும் (உவமேயம்), உவமையையும் வேறுபடுத்தாமல் இரண்டும் ஒன்றே என ஒற்றுமைப்படுத்திக் கூறுவது எவ்வகை அணி?", "media_id": null}], "options": {"A": "உருவக அணி (Metaphor)", "B": "உவமை அணி", "C": "வேற்றுமை அணி", "D": "வஞ்சப்புகழ்ச்சி அணி"}, "explanation": "உவமையையும் உவமிக்கப்படும் பொருளையும் வேறுபடுத்தாமல் இரண்டும் ஒன்றே என்று தோன்றுமாறு கூறுவது 'உருவக அணி' ஆகும். இதில் உவமேயம் முன்னும் உவமானம் பின்னும் வரும் (எ.கா: முகத்தாமரை)."}, "en": {"blocks": [{"type": "text", "content": "When the subject of comparison and the standard of comparison are unified as identical without distinction, what figure of speech is formed?", "media_id": null}], "options": {"A": "Uruvaga Ani (உருவக அணி - Metaphor)", "B": "Uvamai Ani", "C": "Vaetrumai Ani", "D": "Vanjappugazhchi Ani"}, "explanation": "A metaphor (Uruvagam) equates the subject directly with the analogue, placing the subject first."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 189, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 189", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_9", "uruvagam", "definition"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u9-q118", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l5", "chapter_id": null, "topic_id": "pinvarunilai-three-types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூலின்படி, பின்வருநிலையணி எத்தனை வகைப்படும்?", "media_id": null}], "options": {"A": "இரண்டு வகைப்படும்", "B": "மூன்று வகைப்படும் (சொல், பொருள், சொற்பொருள் பின்வருநிலையணி)", "C": "நான்கு வகைப்படும்", "D": "ஐந்து வகைப்படும்"}, "explanation": "செய்யுளில் முன்னர்க் கூறப்பட்ட சொல்லோ பொருளோ மீண்டும் மீண்டும் தொடர்ந்து வருவது பின்வருநிலையணி ஆகும். இது சொல் பின்வருநிலையணி, பொருள் பின்வருநிலையணி, சொற்பொருள் பின்வருநிலையணி என மூன்று வகைப்படும்."}, "en": {"blocks": [{"type": "text", "content": "How many classifications does Pinvarunilai Ani (Iterative Figure of Speech) encompass according to the textbook?", "media_id": null}], "options": {"A": "Two types", "B": "Three types (Sol, Porul, and Sorporul Pinvarunilai Ani - மூன்று வகை)", "C": "Four types", "D": "Five types"}, "explanation": "Pinvarunilai Ani is categorized into three types: verbal reiteration, semantic reiteration, and both verbal-semantic reiteration."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class