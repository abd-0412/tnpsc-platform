{"id": "9th-u9-q154", "schema_version": "1.0", "kind": "application", "level": "application", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l7", "chapter_id": null, "topic_id": "thirukkural-makkalae-polvar-kayavar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"மக்களே போல்வர் கயவர் அவரன்ன / ஒப்பாரியாம் கண்ட தில்\" - இக்குறட்பாவில் அமைந்துள்ள அணி யாது?", "media_id": null}], "options": {"A": "உருவக அணி", "B": "உவமை அணி ('போல்வர்', 'அன்ன' ஆகிய உவம உருபுகள் வந்துள்ளன)", "C": "வேற்றுமை அணி", "D": "சொல் பின்வருநிலையணி"}, "explanation": "கயவர்கள் தோற்றத்தில் நன்மக்களைப் போன்றே காணப்படுவர்; இவ்விருவரிடையே உள்ள புறத்தோற்ற ஒற்றுமை போன்ற ஒன்றை வேறு எங்கும் காண முடியாது என 'போல்வர்', 'அன்ன' ஆகிய உவம உருபுகள் வெளிப்படையாக வந்துள்ளதால் இது 'உவமை அணி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What rhetorical figure of speech is embedded in: 'Makkalae polvar kayavar avaranna / oppaariyaam kanda thil'?", "media_id": null}], "options": {"A": "Metaphor", "B": "Uvamai Ani (Simile - utilizing explicit markers 'polvar' and 'anna')", "C": "Vaetrumai Ani", "D": "Sol Pinvarunilai Ani"}, "explanation": "Explicit comparative particles ('polvar', 'anna') make this Uvamai Ani."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Service