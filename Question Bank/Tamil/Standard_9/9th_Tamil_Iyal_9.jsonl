{"id": "9th-u9-q060", "schema_version": "1.0", "kind": "factual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l2", "chapter_id": null, "topic_id": "pen-names-genre-distinction", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கல்யாணசுந்தரம் அவர்கள் சிறுகதைகள் மற்றும் புதினங்களை எந்தப் பெயரிலும், கவிதைகளை எந்தப் பெயரிலும் எழுதியுள்ளார்?", "media_id": null}], "options": {"A": "சிறுகதைகளை சுஜாதா எனவும், கவிதைகளை வண்ணதாசன் எனவும்", "B": "சிறுகதைகளை பிரபஞ்சன் எனவும், கவிதைகளை கல்யாண்ஜி எனவும்", "C": "இரண்டையுமே வண்ணதாசன் என்ற ஒரே பெயரில் மட்டுமே", "D": "சிறுகதைகளை 'வண்ணதாசன்' என்ற பெயரிலும், கவிதைகளை 'கல்யாண்ஜி' என்ற பெயரிலும்"}, "explanation": "பாடநூல் குறிப்பு: கல்யாணசுந்தரம் சிறுகதைகளை 'வண்ணதாசன்' என்ற புனைப்பெயரிலும், கவிதைகளை 'கல்யாண்ஜி' என்ற புனைப்பெயரிலும் எழுதித் தமிழ் இலக்கியத்திற்குச் செழுமை சேர்த்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Under which distinct pseudonyms did Kalyanasundaram publish his short fiction versus his poetry?", "media_id": null}], "options": {"A": "Sujatha for stories, Vannadasan for poetry", "B": "Prapanchan for stories, Kalyanji for poetry", "C": "Vannadasan exclusively for both genres", "D": "'Vannadasan' for short stories and 'Kalyanji' for poetry"}, "explanation": "He adopts the pen name Vannadasan for fiction and Kalyanji for poetry."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 179, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 179", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_9", "kalyanji", "pen_names"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u9-q061", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l2", "chapter_id": null, "topic_id": "kalyanji-poetry-collections", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கல்யாண்ஜியின் புகழ்பெற்ற கவிதைத் தொகுப்புகளுள் சரியான வரிசை எது?", "media_id": null}], "options": {"A": "புலரி, முன்பின், ஆதி, அந்நியமற்ற நதி, மணல் உள்ள ஆறு", "B": "கொடிவழி, சூரியகாந்தி, நிலவுப்பூ", "C": "நெருஞ்சி, காகித மலர், குருவிப்பறவை", "D": "மழைக்காலக் குறிப்புகள், தேன்மழை, தீக்குச்சிகள்"}, "explanation": "பாடநூலில் குறிப்பிடப்பட்டுள்ள கல்யாண்ஜியின் கவிதைத் தொகுப்புகள்: புலரி, முன்பின், ஆதி, அந்நியமற்ற நதி, மணல் உள்ள ஆறு ஆகியவை ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which option accurately lists the celebrated poetry collections authored by Kalyanji as noted in the textbook?", "media_id": null}], "options": {"A": "Pulari, Munpin, Aathi, Anniyamatra Nadhi, Manal Ulla Aaru (புலரி, முன்பின், ஆதி...)", "B": "Kodivazhi, Sooriyakanthi, Nilavuppoo", "C": "Nerunji, Kaagitha Malar, Kuruvipparavai", "D": "Mazhaikkaala Kurippugal, Thaenmazhai, Theekkuchigal"}, "explanation": "Kalyanji's poetry anthologies include Pulari, Munpin, Aathi, Anniyamatra Nadhi, and Manal Ulla Aaru."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samachee