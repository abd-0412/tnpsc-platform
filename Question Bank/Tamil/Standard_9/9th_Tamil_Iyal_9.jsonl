{"id": "9th-u9-q142", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l2", "chapter_id": null, "topic_id": "bookback-vannadasan-sahitya-akademi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூல் பலவுள் தெரிக: எழுத்தாளர் வண்ணதாசனுக்கு 2016-ஆம் ஆண்டு சாகித்திய அகாதெமி விருது பெற்றுத் தந்த படைப்பு எது?", "media_id": null}], "options": {"A": "கலைக்க முடியாத ஒப்பனைகள்", "B": "'ஒரு சிறு இசை' (சிறுகதைத் தொகுப்பு)", "C": "சமவெளி", "D": "மணல் உள்ள ஆறு"}, "explanation": "வண்ணதாசனின் 'ஒரு சிறு இசை' என்னும் சிறுகதைத் தொகுப்பிற்கு 2016-ஆம் ஆண்டுக்கான மதிப்புமிக்க சாகித்திய அகாதெமி விருது வழங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Book Back: Which work conferred the 2016 Sahitya Akademi Award upon writer Vannadasan?", "media_id": null}], "options": {"A": "Kalaikka Mudiyaatha Oppanaigal", "B": "'Oru Siru Isai' (Short story collection - ஒரு சிறு இசை)", "C": "Samaveli", "D": "Manal Ulla Aaru"}, "explanation": "Vannadasan's short fiction anthology 'Oru Siru Isai' won the Sahitya Akademi Award in 2016."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 179, "chapter