{"id": "9th-u9-q090", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l4", "chapter_id": null, "topic_id": "singaram-two-famous-novels", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கடல் வாணிபம் மற்றும் புலம்பெயர் தமிழர் வாழ்வைச் சித்தரிக்கும் ப. சிங்காரத்தின் இரண்டு புகழ்பெற்ற நாவல்கள் எவை?", "media_id": null}], "options": {"A": "'மோகமுள்', 'செம்பருத்தி'", "B": "'புயலிலே ஒரு தோணி', 'கடலுக்கு அப்பால்'", "C": "'கோபல்ல கிராமம்', 'அந்தமான் கைதி'", "D": "'ஒரு புளியமரத்தின் கதை', 'ஜே.ஜே. சில குறிப்புகள்'"}, "explanation": "ப. சிங்காரம் எழுதிய இரண்டு புகழ்பெற்ற காலத்தால் அழியாத நாவல்கள் 'புயலிலே ஒரு தோணி' மற்றும் 'கடலுக்கு அப்பால்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What are the two landmark novels written by Pa. Singaram depicting the seafaring life of the Tamil diaspora?", "media_id": null}], "options": {"A": "'Mogamul' and 'Semparuthi'", "B": "'Puyalilae Oru Thoni' and 'Kadalukku Appaal' (புயலிலே ஒரு தோணி, கடலுக்கு அப்பால்)", "C": "'Gopalla Graamam' and 'Andaman Kaithi'", "D": "'Oru Puliyamarathin Kathai' and 'J.J. Sila Kurippugal'"}, "explanation": "His two acclaimed novels are 'Puyalilae Oru Thoni' and 'Kadalukku Appaal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tam