{"id": "9th-u9-q032", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "iatr-founder-recognition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தனிநாயக அடிகளின் அளப்பரிய தமிழ்த்தொண்டைப் போற்றி அறிஞர்கள் அவரை எவ்வாறு சிறப்பிக்கின்றனர்?", "media_id": null}], "options": {"A": "சிலம்புச் செல்வர்", "B": "சொல்லின் செல்வர்", "C": "மொழிஞாயிறு", "D": "உலகத் தமிழாராய்ச்சியின் தந்தை (முன்னோடித் தூதுவர்)"}, "explanation": "உலகெங்கும் தமிழாராய்ச்சியை நிறுவனமயப்படுத்தி, உலகத் தமிழாராய்ச்சி மன்றத்தை உருவாக்கிய தனிநாயகம் அடிகள் 'உலகத் தமிழாராய்ச்சியின் தந்தை / உலகத் தமிழ் அமைப்பாளர்' என அறிஞர்களால் போற்றப்படுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "How is Father Thaninayagam celebrated by contemporary scholars for institutionalizing Tamil research globally?", "media_id": null}], "options": {"A": "Silambu Chelvar", "B": "Sollin Chelvar", "C": "Mozhignayiru", "D": "Father / Pioneer of International Tamil Research (உலகத் தமிழாராய்ச்சியின் முன்னோடி)"}, "explanation": "He is honored as the founding father and ambassador of modern international Tamil research."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation