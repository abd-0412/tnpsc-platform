{"id": "9th-u9-q107", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l4", "chapter_id": null, "topic_id": "maritime-tradition-tamils", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைத் தமிழரின் கடலாதிக்கப் பெருமையை \"திரைகடலோடியும் திரவியம் தேடு\" என்று சுட்டிய புலவர் யார்?", "media_id": null}], "options": {"A": "கபிலர்", "B": "பாரதியார்", "C": "ஔவையார் (கொன்றை வேந்தன்)", "D": "வள்ளுவர்"}, "explanation": "ஔவையார் தம்முடைய 'கொன்றை வேந்தன்' என்னும் நீதி நூலில் 'திரைகடலோடியும் திரவியம் தேடு' என்று கடல் கடந்து சென்று வாணிபம் செய்து செல்வம் சேர்க்கும் தமிழரின் துணிவை அறிவுறுத்தினார்."}, "en": {"blocks": [{"type": "text", "content": "Which venerable ancient poetess coined the famous adage 'Thiraikadalodiyum thiraviyam thaedu' (Sail the stormy seas to seek wealth)?", "media_id": null}], "options": {"A": "Kapilar", "B": "Subramania Bharati", "C": "Avvaiyar (in Kondrai Vendhan - ஔவையார்)", "D": "Thiruvalluvar"}, "explanation": "Avvaiyar exhorted seafaring enterprise in 'Kondrai Vendhan'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 182, "chapter": null, "section": null,