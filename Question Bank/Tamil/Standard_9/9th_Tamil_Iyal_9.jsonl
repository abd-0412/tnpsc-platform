{"id": "9th-u9-q074", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l3", "chapter_id": null, "topic_id": "kurunthogai-meter-line-limits", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறுந்தொகைப் பாடல்களின் அடி எல்லை (வரிகளின் அளவு) யாது?", "media_id": null}], "options": {"A": "3 அடி முதல் 6 அடி வரை", "B": "4 அடி முதல் 8 அடி வரை (குறைந்த அடி எல்லை)", "C": "9 அடி முதல் 12 அடி வரை", "D": "13 அடி முதல் 31 அடி வரை"}, "explanation": "குறுந்தொகைப் பாடல்கள் குறைந்த அளவாக 4 அடிகளையும், அதிகபட்சமாக 8 அடிகளையும் கொண்டு பாடப்பட்டவை. குறைந்த அடியளவு கொண்டதால் இது 'குறுந்தொகை' எனப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "What is the line limit (metrical span) of the poems in Kurunthogai?", "media_id": null}], "options": {"A": "3 to 6 lines", "B": "4 to 8 lines (4 முதல் 8 அடி எல்லை)", "C": "9 to 12 lines", "D": "13 to 31 lines"}, "explanation": "Kurunthogai verses range strictly between 4 and 8 lines."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 181, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 181", "url": null, "source_notes": null},