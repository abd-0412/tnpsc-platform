{"id": "9th-u9-q096", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l4", "chapter_id": null, "topic_id": "storm-soundscape-depiction", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கடலில் புயல் கொந்தளித்த காட்சியைப் ப. சிங்காரம் எவ்வாறு விவரிக்கிறார்?", "media_id": null}], "options": {"A": "மெல்லிய பூங்காற்று வீசித் தென்றல் தவழ்ந்தது", "B": "தூறல் மழை மட்டுமே பெய்தது", "C": "வானம் மேகமூட்டமின்றித் தெளிவாக இருந்தது", "D": "\"கொளுத்துகிற சுடர்க்காற்று... பாய்களைக் கிழித்துக் கப்பலை அசைத்து... இடி முழக்கமும் கடலின் பிளிறலும் வானமும் கடலும் ஒன்றான பேரிரைச்சல்\""}, "explanation": "பாடப்பகுதி: ஆசிரியர் தன் ஒலிநயமிக்க விவரிப்பால், காற்று ஊளையிட்டுப் பாய்களைக் கிழிப்பதையும், இடி மின்னலோடு அலைகள் ஆக்ரோஷமாக மோதிக் கப்பலைத் தூக்கி எறிவதையும் தத்ரூபமாக விவரித்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "How does Pa. Singaram vividly depict the sensory soundscape of the raging sea storm?", "media_id": null}], "options": {"A": "Gentle aromatic breezes blowing mildly", "B": "Light drizzling rain without wind", "C": "Completely clear cloudless skies", "D": "Scorching blast howling, tearing sails, thunderclaps crashing, and deafening roars blurring sea and sky"}, "explanation": "He evokes the storm with vivid, visceral onomatopoeia portraying towering waves and howling squalls."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 183, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 183", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_9", "singaram", "storm_soundscape"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u9-q097", "schema_version": "1.0", "kind": "factual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l4", "chapter_id": null, "topic_id": "storm-atmospheric-omen", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புயல் தொடங்குவதற்கு முன் கடலில் ஏற்பட்ட அசாதாரண சூழலாகப் பாடப்பகுதியில் குறிப்பிடப்படுவது எது?", "media_id": null}], "options": {"A": "திடீரெனக் காற்று நின்றுபோய்ப் புழுக்கம் மிகுந்து, அடிவானில் கரிய திரையாக மேகங்கள் திரண்டு இருண்டது", "B": "பனிமழை பொழிந்தது", "C": "சூரியன் பிரகாசமாக ஒளிர்ந்தது", "D": "கடல் நீர் பனிக்கட்டியாக உறைந்தது"}, "explanation": "புயலுக்கு முந்தைய அமைதி: காற்று நின்றமைதல், காற்று மண்டலத்தில் அழுத்தம் குறைந்து வெப்பப் புழுக்கம் ஏற்படுதல், அடிவானம் கரிய நிறத்தில் இருண்டு சூழ்வது ஆகியவை இயற்கை விதியாகக் கதையில் சுட்டப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What unnatural meteorological omen foreshadowed the impending cyclone at sea?", "media_id": null}], "options": {"A": "Sudden suffocating stillness of wind, stifling humidity, and horizon darkening like an ominous black shroud", "B": "Sub-zero snowfall", "C": "Bright dazzling sunny day", "D": "Freezing of sea water into ice"}, "explanation": "The uncanny stillness and dense black horizon signaled the approaching tempest."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_n