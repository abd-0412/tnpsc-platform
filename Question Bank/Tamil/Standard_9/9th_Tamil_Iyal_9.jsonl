{"id": "9th-u9-q011", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "thirukkural-universal-humanity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளில் மனித குலம் முழுவதற்கும் பொதுவான சமத்துவக் கொள்கையாக வள்ளுவர் பிரகடனம் செய்தது எது?", "media_id": null}], "options": {"A": "'செல்வத்துப் பயனே ஈதல்'", "B": "'தீதும் நன்றும் பிறர்தர வாரா'", "C": "'பிறப்பொக்கும் எல்லா உயிர்க்கும்' (குறள் 972)", "D": "'அன்பும் அறனும் உடைத்தாயின் இல்வாழ்க்கை'"}, "explanation": "பிறப்பினால் மனிதரிடையே எந்த உயர்வு தாழ்வும் இல்லை; பிறக்கும் எல்லா உயிர்களும் சமமே என்னும் மானுட சமத்துவத்தை 'பிறப்பொக்கும் எல்லா உயிர்க்கும்' என்ற குறள் அடி மூலம் திருவள்ளுவர் ஆணித்தரமாக நிலைநாட்டுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Which cardinal couplet line does Thiruvalluvar proclaim to establish the innate spiritual and social equality of all human beings?", "media_id": null}], "options": {"A": "'Selvathu payanae eethal'", "B": "'Theethum nandrum pirarthara vaaraa'", "C": "'Pirappokkum ella uyirkkum' (All beings are equal by birth - குறள் 972)", "D": "'Anbum aranum udaithayin'"}, "explanation": "'Pirappokkum ella uyirkkum' lays the egalitarian foundation of human dignity across all humanity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "so