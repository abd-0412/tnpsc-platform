{"id": "9th-u9-q010", "schema_version": "1.0", "kind": "factual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "marcus-aurelius-quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"மக்கள் அனைவரும் ஒருவருக்கொருவர் உதவிசெய்து வாழவே படைக்கப்பட்டுள்ளனர்\" என்று குறிப்பிட்ட உரோமப் பேரரசரும் தத்துவஞானியுமான சிந்தனையாளர் யார்?", "media_id": null}], "options": {"A": "ஜூலியஸ் சீசர்", "B": "மார்கஸ் அரேலியஸ் (Marcus Aurelius)", "C": "அலெக்சாண்டர்", "D": "நீரோ"}, "explanation": "உரோமானியப் பேரரசரும் சிறந்த சிந்தனையாளருமான மார்கஸ் அரேலியஸ், மனிதர்கள் ஒருவருக்கொருவர் நலன் கருதி வாழவும் உதவவுமே இயற்கையால் படைக்கப்பட்டுள்ளனர் எனக் கூறியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which Roman Emperor and philosopher stated that human beings were created expressly to aid and support one another?", "media_id": null}], "options": {"A": "Julius Caesar", "B": "Marcus Aurelius (மார்கஸ் அரேலியஸ்)", "C": "Alexander", "D": "Nero"}, "explanation": "Marcus Aurelius emphasized universal mutual support in his philosophical writings."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 1