{"id": "9th-u9-q037", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "stoic-school-seneca-ethics", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உரோமானிய மெய்யியலாளரான செனகா பின்பற்றிய தத்துவப் பிரிவு (School of Philosophy) எது?", "media_id": null}], "options": {"A": "ஸ்டோயிக் தத்துவம் (Stoicism - துன்பத்திலும் மன அமைதி காக்கும் நெறி)", "B": "சோபிச தத்துவம்", "C": "சந்தேகவியல் (Skepticism)", "D": "பயன்வழிக் கொள்கை (Utilitarianism)"}, "explanation": "செனகா உரோமானிய 'ஸ்டோயிக்' (Stoic) தத்துவ மரபின் புகழ்பெற்ற சிந்தனையாளர் ஆவார். இத்தத்துவம் உலகளாவிய சகோதரத்துவம் மற்றும் துன்பத்திலும் தளராத மன உறுதியை வலியுறுத்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "To which classical philosophical school did the Roman philosopher Seneca belong?", "media_id": null}], "options": {"A": "Stoicism (ஸ்டோயிக் நெறி - emphasizing fortitude and cosmopolitan fraternity)", "B": "Sophism", "C": "Skepticism", "D": "Utilitarianism"}, "explanation": "Seneca was a leading Roman exponent of Stoicism."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "p