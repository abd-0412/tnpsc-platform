{"id": "9th-u9-q052", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "world-classical-tamil-conference-cbe", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "2010-ஆம் ஆண்டு தமிழ்நாட்டில் 'உலகத் தமிழ்ச் செம்மொழி மாநாடு' எந்த நகரில் பிரம்மாண்டமாக நடத்தப்பட்டது?", "media_id": null}], "options": {"A": "சென்னை", "B": "மதுரை", "C": "திருச்சிராப்பள்ளி", "D": "கோயம்புத்தூர் (மு. கருணாநிதி தலைமையில்)"}, "explanation": "2010-ஆம் ஆண்டு கோயம்புத்தூரில் தமிழக அரசால் முதலமைச்சர் மு. கருணாநிதி தலைமையில் 'உலகத் தமிழ்ச் செம்மொழி மாநாடு' மிகச் சிறப்பாக நடத்தப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "In which city was the grand 'World Classical Tamil Conference' convened by the Government of Tamil Nadu in 2010?", "media_id": null}], "options": {"A": "Chennai", "B": "Madurai", "C": "Tiruchirappalli", "D": "Coimbatore (கோயம்புத்தூர் - 2010)"}, "explanation": "The World Classical Tamil Conference was celebrated in Coimbatore in 2010."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 176, "chapter": null, "section": null, "reference": "9th Tami