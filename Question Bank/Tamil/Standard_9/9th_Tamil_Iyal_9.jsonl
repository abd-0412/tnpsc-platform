{"id": "9th-u9-q093", "schema_version": "1.0", "kind": "factual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l4", "chapter_id": null, "topic_id": "historical-backdrop-world-war-2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'புயலிலே ஒரு தோணி' நாவலின் கதைக்களம் எந்த வரலாற்றுப் பின்னணியில் நடைபெறுகிறது?", "media_id": null}], "options": {"A": "இரண்டாம் உலகப்போர் (1939-1945) கால தென்கிழக்காசிய அரசியல் கொந்தளிப்பு", "B": "முதலாம் உலகப்போர் காலம்", "C": "இந்திய விடுதலைப் போர் காலம் (1857)", "D": "வியட்நாம் போர் காலம்"}, "explanation": "இரண்டாம் உலகப்போரின் போது ஜப்பானியப் படைகள் தென்கிழக்காசிய நாடுகளைத் தாக்கிய காலக்கட்டத்தில், இந்தோனேசியாவிலிருந்து பினாங்கு நோக்கிச் செல்லும் கப்பல் புயலில் சிக்குவதே இக்கதையின் பின்னணியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Against which tumultuous historical backdrop is the novel 'Puyalilae Oru Thoni' set?", "media_id": null}], "options": {"A": "World War II (1939-1945) turmoil in Southeast Asia (இரண்டாம் உலகப்போர்)", "B": "World War I era", "C": "The Indian Rebellion of 1857", "D": "Vietnam War"}, "explanation": "The story unfolds during World War II amid the Japanese advance across Southeast Asia."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educati