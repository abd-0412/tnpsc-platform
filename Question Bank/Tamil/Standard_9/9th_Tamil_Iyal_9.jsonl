{"id": "9th-u9-q022", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "carthila-first-printed-tamil-book", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ரோமன் எழுத்துருவில் முதன்முதலில் அச்சேறிய தமிழ் நூலான 'தம்பிரான் வணக்கம்' (Cartilha de Lingoa Tamul e Portugues) எந்த ஆண்டு லிஸ்பனில் அச்சிடப்பட்டது?", "media_id": null}], "options": {"A": "1500", "B": "1554 பிப்ரவரி 11", "C": "1654", "D": "1709"}, "explanation": "1554 பிப்ரவரி 11 அன்று போர்ச்சுகலின் லிஸ்பன் நகரில் ரோமன் வரிவடிவில் 'கார்ட்டிலா' (Cartilha) என்னும் தமிழ் நூல் அச்சிடப்பட்டது. இந்திய மொழிகளிலேயே முதன்முதலில் அச்சேறிய பெருமை தமிழ் மொழிக்கே உண்டு."}, "en": {"blocks": [{"type": "text", "content": "In which year was 'Cartilha', the first Tamil book printed in Roman script, published in Lisbon, Portugal?", "media_id": null}], "options": {"A": "1500", "B": "11 February 1554 (1554 பிப்ரவரி 11)", "C": "1654", "D": "1709"}, "explanation": "'Cartilha' was printed in Lisbon on February 11, 1554, marking Tamil as the first Indian language to go into print."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition"