{"id": "9th-u9-q141", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "bookback-iatr-founding", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூல் பலவுள் தெரிக: உலகத் தமிழாராய்ச்சி மன்றம் (IATR) தனிநாயகம் அடிகளாரின் பெருமுயற்சியால் எங்கு, எந்த ஆண்டு தொடங்கப்பட்டது?", "media_id": null}], "options": {"A": "1964 புதுதில்லி (சர்வதேசக் கீழ்த்திசைப் புலவர் மாநாடு)", "B": "1968 சென்னை", "C": "1966 கோலாலம்பூர்", "D": "1970 பாரிஸ்"}, "explanation": "பாடநூல் குறிப்பு: தனிநாயகம் அடிகள் 1964-இல் புதுதில்லியில் நடைபெற்ற கீழ்த்திசைப் புலவர் மாநாட்டில் உலகத் தமிழாராய்ச்சி மன்றத்தைத் (IATR) தொடங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "Book Back: At which conference and in which year did Father Thaninayagam establish the International Association of Tamil Research (IATR)?", "media_id": null}], "options": {"A": "1964 New Delhi (International Congress of Orientalists)", "B": "1968 Chennai", "C": "1966 Kuala Lumpur", "D": "1970 Paris"}, "explanation": "IATR was founded in New Delhi in 1964 through the leadership of Father Thaninayagam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "t