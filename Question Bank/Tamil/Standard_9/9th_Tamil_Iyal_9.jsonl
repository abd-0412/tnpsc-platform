{"id": "9th-u9-q145", "schema_version": "1.0", "kind": "factual", "level": "comprehension", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l5", "chapter_id": null, "topic_id": "bookback-theeyinaal-sutta-ani", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூல் பலவுள் தெரிக: \"தீயினால் சுட்ட புண் உள்ளாறும் ஆறாதே / நாவினால் சுட்ட வடு\" - இக்குறட்பாவில் பயின்றுவந்துள்ள அணி யாது?", "media_id": null}], "options": {"A": "வேற்றுமை அணி", "B": "உவமை அணி", "C": "சொல் பின்வருநிலையணி", "D": "வஞ்சப்புகழ்ச்சி அணி"}, "explanation": "தீப்புண், நாப்புண் இரண்டும் சுடும் என்ற ஒற்றுமையைக் கூறி, பின்னர் தீப்புண் ஆறும் நாவினால் சுட்ட வடு ஆறாது என வேறுபடுத்தியதால் இது 'வேற்றுமை அணி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Book Back: In 'Theeyinaal sutta pun ullaarum aaraadhae / naavinaal sutta vadu', which figure of speech is embedded?", "media_id": null}], "options": {"A": "Vaetrumai Ani (Antithetical Distinction / Contrast - வேற்றுமை அணி)", "B": "Uvamai Ani", "C": "Sol Pinvarunilai Ani", "D": "Vanjappugazhchi Ani"}, "explanation": "Contrast between physical burn and enduring verbal wound establishes Vaetrumai Ani."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "editi