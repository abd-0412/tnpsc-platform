{"id": "9th-u9-q081", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l2", "chapter_id": null, "topic_id": "kalyanji-letter-collection", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் கல்யாண்ஜி எழுதிய கடிதங்களின் தொகுப்பு எந்தத் தலைப்பில் நூலாக வெளிவந்துள்ளது?", "media_id": null}], "options": {"A": "'சில இறகுகள் சில பறவைகள்'", "B": "'அன்புள்ள மகனுக்கு'", "C": "'தம்பிக்கு அண்ணாவின் கடிதங்கள்'", "D": "'நேருவின் கடிதங்கள்'"}, "explanation": "பாடநூல் குறிப்பு: வண்ணதாசன் / கல்யாண்ஜி எழுதிய கடிதங்கள் 'சில இறகுகள் சில பறவைகள்' என்ற தலைப்பில் நூலாகத் தொகுக்கப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Under which poetic title was Kalyanji's collection of personal letters published?", "media_id": null}], "options": {"A": "'Sila Iragugal Sila Paravaigal' (சில இறகுகள் சில பறவைகள்)", "B": "'Anbulla Maganukku'", "C": "'Thambikku Annavin Kadithangal'", "D": "'Nehruvin Kadithangal'"}, "explanation": "His collected letters are titled 'Sila Iragugal Sila Paravaigal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 179, "chapter": null, "section": null, "reference"