{"id": "9th-u9-q094", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l4", "chapter_id": null, "topic_id": "protagonist-pandiyan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இக்கதையில் கடற்பயணம் மேற்கொள்ளும் முதன்மைக் கதாபாத்திரமான தமிழக இளைஞனின் பெயர் யாது?", "media_id": null}], "options": {"A": "கண்ணன்", "B": "பாண்டியன்", "C": "முருகன்", "D": "இளங்கோ"}, "explanation": "நாவலின் முதன்மைக் கதாநாயகன் 'பாண்டியன்' ஆவான். இவன் இந்தோனேசியாவிலிருந்து கப்பலில் தன் தாய்நாட்டை நோக்கிய பயணத்தில் புயலை எதிர்கொள்கிறான்."}, "en": {"blocks": [{"type": "text", "content": "What is the name of the central Tamil youth protagonist undertaking this tempestuous sea voyage?", "media_id": null}], "options": {"A": "Kannan", "B": "Pandiyan (பாண்டியன்)", "C": "Murugan", "D": "Ilango"}, "explanation": "Pandiyan is the protagonist who survives the terrifying sea storm."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 182, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 182", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam