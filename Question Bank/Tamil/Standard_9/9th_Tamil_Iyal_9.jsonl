{"id": "9th-u9-q127", "schema_version": "1.0", "kind": "application", "level": "application", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l5", "chapter_id": null, "topic_id": "kural-vilakku-sorporul-pinvarunilai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"எல்லா விளக்கும் விளக்கல்ல சான்றோர்க்குப் / பொய்யா விளக்கே விளக்கு\" - இக்குறளில் பயின்றுவந்துள்ள அணி யாது?", "media_id": null}], "options": {"A": "வேற்றுமை அணி", "B": "பொருள் பின்வருநிலையணி", "C": "சொற்பொருள் பின்வருநிலையணி ('விளக்கு' என்ற சொல் ஒரே பொருளில் பலமுறை வந்துள்ளது)", "D": "இரட்டுற மொழிதல் அணி"}, "explanation": "'விளக்கு' என்னும் சொல் குறளில் நான்கு முறை வந்து, வெளிச்சம் தரும் 'விளக்கு' என்ற ஒரே பொருளையே தருவதால் இது 'சொற்பொருள் பின்வருநிலையணி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which rhetorical figure of speech is embedded in the Kural: 'Ella vilakkum vilakkalla saandrorkkup / poiyaa vilakkae vilakku'?", "media_id": null}], "options": {"A": "Vaetrumai Ani", "B": "Porul Pinvarunilai Ani", "C": "Sorporul Pinvarunilai Ani (The word 'Vilakku' recurs retaining the same meaning)", "D": "Irattura Mozhithal Ani"}, "explanation": "The word 'Vilakku' recurs multiple times maintaining the same meaning, exemplifying Sorporul Pinvarunilai Ani."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi",