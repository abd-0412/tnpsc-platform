{"id": "9th-u9-q038", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "tamil-identity-humanity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தனிநாயக அடிகள் குறிப்பிடும் 'தமிழ் ஆளுமையின்' தனிச்சிறப்பு யாது?", "media_id": null}], "options": {"A": "பிற நாகரிகங்களை வெறுத்து ஒதுக்குவது", "B": "தன் பண்பாட்டில் வேரூன்றி நின்றுகொண்டே, உலகப் பண்பாடுகளின் நன்மைகளை இருகரம் நீட்டி வரவேற்கும் பரந்த மனப்பான்மை", "C": "உலகத்தொடர்புகளை முற்றிலுமாகத் தவிர்ப்பது", "D": "அரசியல் மேலாதிக்கத்தை நிலைநாட்டுவது"}, "explanation": "தனிநாயக அடிகள்: தமிழ் ஆளுமை என்பது தன் சொந்த மண்ணிலும் மொழியிலும் உறுதியாக வேரூன்றி, அதேவேளையில் உலகெங்கும் உள்ள நற்பண்புகளை வரவேற்று ஏற்கும் பரந்த உள்ளத்தைக் கொண்டதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the unique brilliance of 'Tamil Personality' as highlighted by Father Thaninayagam?", "media_id": null}], "options": {"A": "Antipathy towards alien cultures", "B": "Being deeply anchored in native heritage while embracing with open arms the virtues of world civilizations", "C": "Severing all foreign commercial and intellectual ties", "D": "Enforcing imperialist dominance"}, "explanation": "Rooted firmly in Tamil roots while opening arms to the best of global humanity characterizes true Tamil personality."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.