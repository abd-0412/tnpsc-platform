{"id": "9th-u9-q158", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "pyq-second-conference-anna", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] இரண்டாவது உலகத் தமிழாராய்ச்சி மாநாடு 1968-ஆம் ஆண்டு சென்னையில் யாருடைய தலைமையில் நடைபெற்றது?", "media_id": null}], "options": {"A": "காமராசர்", "B": "பேரறிஞர் அண்ணா", "C": "மு. கருணாநிதி", "D": "எம். ஜி. ஆர்"}, "explanation": "இரண்டாவது உலகத் தமிழாராய்ச்சி மாநாடு 1968-இல் சென்னையில் முதலமைச்சர் பேரறிஞர் அண்ணா அவர்களின் தலைமையில் மிக எழுச்சியாக நடைபெற்றது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Under whose Chief Ministership was the Second World Tamil Conference convened in Chennai in 1968?", "media_id": null}], "options": {"A": "Kamarajar", "B": "Perarignar Anna (பேரறிஞர் அண்ணா)", "C": "M. Karunanidhi", "D": "M. G. Ramachandran"}, "explanation": "Perarignar Anna presided over the 1968 Second World Tamil Conference in Chennai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 176, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 176", "u