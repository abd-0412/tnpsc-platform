{"id": "9th-u9-q036", "schema_version": "1.0", "kind": "factual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "fourth-world-tamil-conference-jaffna", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நான்காவது உலகத் தமிழாராய்ச்சி மாநாடு 1974-ஆம் ஆண்டு எங்கு நடத்தப்பட்டது?", "media_id": null}], "options": {"A": "மதுரை", "B": "மாரிஷியஸ்", "C": "தஞ்சாவூர்", "D": "யாழ்ப்பாணம் (இலங்கை)"}, "explanation": "நான்காவது உலகத் தமிழாராய்ச்சி மாநாடு 1974-ஆம் ஆண்டு இலங்கையின் யாழ்ப்பாணத்தில் நடைபெற்றது. தனிநாயகம் அடிகளார் இதில் முதன்மைப் பங்காற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Where was the Fourth World Tamil Conference convened in the year 1974?", "media_id": null}], "options": {"A": "Madurai", "B": "Mauritius", "C": "Thanjavur", "D": "Jaffna (Sri Lanka - யாழ்ப்பாணம்)"}, "explanation": "The 4th World Tamil Conference took place in Jaffna, Sri Lanka in 1974."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 176, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 176", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": fa