{"id": "9th-u9-q050", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "personality-and-broadmindedness", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூலின்படி, விரிவடையும் ஆளுமை கொண்ட ஒரு மனிதன் எத்தகைய எண்ணத்தை உள்ளத்தில் கொண்டிருப்பான்?", "media_id": null}], "options": {"A": "பிறரை விட நான் உயர்ந்தவன் என்ற இறுமாப்பு", "B": "\"யான் பெற்ற இன்பம் பெறுக இவ்வையகம்\" என்ற பொதுநலப் பகிர்வு", "C": "பகைவரை அடியோடு அழிக்க நினைக்கும் குரோதம்", "D": "பொருளைச் சேமித்து மறைத்து வைக்கும் எண்ணம்"}, "explanation": "விரிவடையும் ஆளுமையின் உன்னத அடையாளம்: தான் பெற்ற அறிவையும் நன்மைகளையும் உலக மாந்தர் அனைவரும் பெற வேண்டும் என்ற பரந்த வள்ளல் தன்மையாகும்."}, "en": {"blocks": [{"type": "text", "content": "According to the text, what mindset characterizes an enlightened individual with an expanding personality?", "media_id": null}], "options": {"A": "Arrogant conceit of being superior to all others", "B": "'May the entire world share the joy I have experienced' (யான் பெற்ற இன்பம் பெறுக இவ்வையகம்)", "C": "Vindictive hostility to annihilate competitors", "D": "Secretive hoarding of material resources"}, "explanation": "An expanding personality selflessly desires that all humanity partake in knowledge and happiness."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answer