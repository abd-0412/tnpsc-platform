{"id": "9th-u9-q030", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "ancient-tamil-global-vision", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைத் தமிழர்களின் ஆளுமைச் சிறப்பு குறித்துப் பாடப்பகுதி கூறும் முதன்மையான பண்பு எது?", "media_id": null}], "options": {"A": "பிற நாடுகளைப் போரினால் வென்று அடக்கியது", "B": "கடல் கடந்து வணிகம் செய்தபோதும் 'யாதும் ஊரே யாவரும் கேளிர்' என்ற உலகளாவிய ஒருமைப்பாட்டுப் பண்பைப் போற்றியது", "C": "வெளிநாட்டினருக்குத் தம் நாட்டில் இடமளிக்காதது", "D": "சொந்த நாட்டு எல்லைக்குள்ளேயே முடங்கிக் கிடந்தது"}, "explanation": "பண்டைத் தமிழர்கள் கிரேக்கம், உரோமம், சீனம், சாவகம் உள்ளிட்ட பல நாடுகளுடன் கடல் வணிகம் புரிந்தனர்; எனினும் 'யாதும் ஊரே யாவரும் கேளிர்' என்ற சமத்துவ நேயத்தையே அவர்கள் உலகிற்கு வழங்கினர்."}, "en": {"blocks": [{"type": "text", "content": "What distinctive hallmark of ancient Tamil civilization's personality is celebrated in the lesson?", "media_id": null}], "options": {"A": "Subjecting foreign nations by aggressive imperial conquest", "B": "Conducting global maritime trade while cherishing the universal ethos 'All towns are my home, all people my kin'", "C": "Denying entry to foreigners into their homeland", "D": "Remaining confined strictly within domestic borders"}, "explanation": "Ancient Tamils engaged in extensive seafaring commerce while upholding profound universal fraternity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 173, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 173", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_9", "ancient_tamils", "maritime_vision"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u9-q031", "schema_version": "1.0", "kind": "factual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "thirukkural-universal-living", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"அன்பிலார் எல்லாம் தமக்குரியர் அன்புடையார் / என்பும் உரியர் பிறர்க்கு\" - இக்குறள் ஆளுமையின் எந்த உன்னதப் பண்பை உணர்த்துகிறது?", "media_id": null}], "options": {"A": "வீரத்தை", "B": "கல்விப் புலமையை", "C": "பிறர்க்கென வாழும் தன்னலமற்ற அன்புடைமையை", "D": "பொருளாதார விவேகத்தை"}, "explanation": "அன்பு இல்லாதவர் எல்லாப் பொருள்களும் தமக்கே உரியது என்பர்; அன்பு உடையவரோ தம் உடலையும் எலும்பையும் கூடப் பிறருக்கு அர்ப்பணிப்பர். இதுவே தன்னலமற்ற பேரன்பின் உன்னத ஆளுமைப் பண்பாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which sublime personality virtue is encapsulated in the Kural: 'Anbilaar ellaam thamakuriyar anbudaiyaar / enbum uriyar pirarkku'?", "media_id": null}], "options": {"A": "Martial physical bravery", "B": "Erudite scholarly pedigree", "C": "Selfless, all-sacrificing altruistic love for others (தன்னலமற்ற அன்பு)", "D": "Shrewd economic frugality"}, "explanation": "The couplet exalts boundless selfless love, where the loving person surrenders their very physical frame for the welfare of others."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name":