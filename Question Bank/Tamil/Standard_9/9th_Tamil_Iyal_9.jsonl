{"id": "9th-u9-q078", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l3", "chapter_id": null, "topic_id": "kurunthogai-first-print-1915", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறுந்தொகை நூலை முதன்முதலில் பதிப்பித்து வெளியிட்ட அறிஞர் யார்? எந்த ஆண்டு அது பதிப்பிக்கப்பட்டது?", "media_id": null}], "options": {"A": "உ. வே. சாமிநாதையர்; 1887", "B": "சௌரிப் பெருமாள் அரங்கனார்; 1915", "C": "சி. வை. தாமோதரம்பிள்ளை; 1883", "D": "மறைமலையடிகள்; 1920"}, "explanation": "பாடநூல் குறிப்பு: இந்நூலை முதன்முதலில் 1915-ஆம் ஆண்டு சௌரிப் பெருமாள் அரங்கனார் பதிப்பித்து வெளியிட்டார்."}, "en": {"blocks": [{"type": "text", "content": "Who first edited and published the classical anthology Kurunthogai in print, and in which year?", "media_id": null}], "options": {"A": "U. V. Swaminatha Iyer; 1887", "B": "Sowri Perumal Aranganar; 1915 (சௌரிப் பெருமாள் அரங்கனார் - 1915)", "C": "C. W. Damodaram Pillai; 1883", "D": "Maraimalai Adigal; 1920"}, "explanation": "Sowri Perumal Aranganar first brought out the printed edition of Kurunthogai in 1915."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page"