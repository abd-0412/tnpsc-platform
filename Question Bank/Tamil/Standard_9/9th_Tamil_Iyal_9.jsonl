{"id": "9th-u9-q034", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "expanding-personality-stages", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆளுமையின் விரிவாக்கம் என்பது படிப்படியாக எவ்வாறு விரிவடைகிறது எனப் பாடநூல் விளக்குகிறது?", "media_id": null}], "options": {"A": "உலகம் -> நாடு -> இனம் -> குடும்பம் -> தான்", "B": "தான் (தனிமனிதன்) -> குடும்பம் -> ஊர் -> நாடு -> உலகம் (முழு மானுடம்)", "C": "நாடு -> உலகம் -> தான்", "D": "தான் -> பணம் -> புகழ் -> அதிகாரம்"}, "explanation": "ஆளுமை விரிவாக்கம் என்பது ஒரு மனிதனின் உணர்வு தன்னில் தொடங்கி, குடும்பம், சமூகம், நாடு என விரிவடைந்து இறுதியாக அனைத்து உலக மாந்தரையும் தழுவும் உலகளாவிய பார்வையாக மலர்வதாகும்."}, "en": {"blocks": [{"type": "text", "content": "How does the concentric expansion of personality unfold according to Father Thaninayagam's treatise?", "media_id": null}], "options": {"A": "World -> Nation -> Clan -> Family -> Self", "B": "Self -> Family -> Village -> Nation -> Entire Humanity (World)", "C": "Nation -> World -> Self", "D": "Self -> Money -> Fame -> Power"}, "explanation": "Personality organically broadens from individual consciousness outwards to encompass all humankind."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil 