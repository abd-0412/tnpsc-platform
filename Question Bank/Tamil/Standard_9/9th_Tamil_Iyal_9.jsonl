{"id": "9th-u9-q075", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l3", "chapter_id": null, "topic_id": "kurunthogai-total-poems", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறுந்தொகையில் கடவுள் வாழ்த்து நீங்கலாக மொத்தம் எத்தனை பாடல்கள் இடம்பெற்றுள்ளன?", "media_id": null}], "options": {"A": "300 பாடல்கள்", "B": "500 பாடல்கள்", "C": "400 பாடல்கள் (கடவுள் வாழ்த்துடன் சேர்த்து 401)", "D": "150 பாடல்கள்"}, "explanation": "குறுந்தொகை 400 அகவற்பாக்களையும், தொடக்கத்தில் கடவுள் வாழ்த்துப் பாடல் ஒன்றையும் சேர்த்து மொத்தம் 401 பாடல்களைக் கொண்டது."}, "en": {"blocks": [{"type": "text", "content": "Excluding the invocatory verse, how many poems comprise the Kurunthogai anthology?", "media_id": null}], "options": {"A": "300 poems", "B": "500 poems", "C": "400 poems (401 including the invocation)", "D": "150 poems"}, "explanation": "Kurunthogai has 400 core love lyrics plus 1 invocatory hymn (total 401)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 181, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 181", "url": null, "source_notes": null}, "previous_