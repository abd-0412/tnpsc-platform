{"id": "9th-u9-q091", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l4", "chapter_id": null, "topic_id": "vocab-thongaan-meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடப்பகுதியில் இடம்பெற்றுள்ள 'தொங்கான்' என்ற கடல்சார் சொல்லின் பொருள் யாது?", "media_id": null}], "options": {"A": "கப்பலின் திசைகாட்டி", "B": "கடல் ஆமை", "C": "மரக்கப்பல் / பெரிய பாய்மரக் கப்பல் / தோணி", "D": "கப்பலின் நங்கூரம்"}, "explanation": "பாடநூல் விளக்கம்: 'தொங்கான்' என்பது இந்தோனேசிய-மலாய் வட்டாரத்தில் பயன்படுத்தப்பட்ட பெரிய மரக்கப்பல் அல்லது படகு (கப்பல்) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What does the maritime term 'Thongaan' (தொங்கான்) signify in this narrative?", "media_id": null}], "options": {"A": "Ship's magnetic compass", "B": "Sea turtle", "C": "Wooden sailing ship / Vessel / Large boat (மரக்கப்பல்)", "D": "Ship's anchor"}, "explanation": "'Thongaan' is a Southeast Asian nautical term referring to a large wooden sailing ship."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 183, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 183",