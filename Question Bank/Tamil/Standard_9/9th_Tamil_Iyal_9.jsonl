{"id": "9th-u9-q113", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l5", "chapter_id": null, "topic_id": "ani-meaning-beauty", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கணத்தில் 'அணி' என்னும் சொல்லின் நேரடிப் பொருள் யாது?", "media_id": null}], "options": {"A": "அழகு", "B": "வீரம்", "C": "இசை", "D": "ஒழுக்கம்"}, "explanation": "'அணி' என்னும் சொல்லுக்கு 'அழகு' என்பது பொருளாகும். செய்யுளுக்குச் சொல்லாலும் பொருளாலும் அழகு சேர்ப்பதே அணி இலக்கணம் எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What is the literal meaning of the grammatical term 'Ani' (அணி) in Tamil rhetoric?", "media_id": null}], "options": {"A": "Beauty / Ornamentation (அழகு)", "B": "Bravery / Valour", "C": "Melody / Music", "D": "Discipline / Morality"}, "explanation": "'Ani' literally means ornament or beauty, denoting poetic tropes and rhetorical figures of speech."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 188, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 188", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": nu