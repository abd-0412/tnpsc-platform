{"id": "9th-u9-q126", "schema_version": "1.0", "kind": "application", "level": "application", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l5", "chapter_id": null, "topic_id": "kural-thottanai-thoorum-eduthukkaattu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"தொட்டனைத் தூறும் மணற்கேணி மாந்தர்க்குக் / கற்றனைத் தூறும் அறிவு\" - இக்குறட்பாவில் அமைந்துள்ள அணி யாது?", "media_id": null}], "options": {"A": "உவமை அணி", "B": "எடுத்துக்காட்டு உவமை அணி (உவம உருபு 'அதுபோல' மறைந்து வந்துள்ளது)", "C": "சொல் பின்வருநிலையணி", "D": "வஞ்சப்புகழ்ச்சி அணி"}, "explanation": "மணற்கேணியைத் தோண்டத் தோண்ட நீர் ஊறும் என்பது உவமை; கற்கக் கற்க அறிவு வளரும் என்பது உவமேயம். 'அதுபோல' என்ற உவம உருபு வெளிப்படாமல் மறைந்து வந்துள்ளதால் இது 'எடுத்துக்காட்டு உவமை அணி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What figure of speech is exemplified in the Kural: 'Thottanaith thoorum manarkaeni maantharkkuk / katranaith thoorum arivu'?", "media_id": null}], "options": {"A": "Direct Simile", "B": "Eduthukkaattu Uvamai Ani (Exemplary Simile - comparative particle 'athupola' is omitted)", "C": "Sol Pinvarunilai Ani", "D": "Vanjappugazhchi Ani"}, "explanation": "The particle 'athupola' (likewise) is omitted between the well analogy and learning, constituting Eduthukkaattu Uvamai Ani."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "bo