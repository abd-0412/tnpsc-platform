{"id": "9th-u9-q016", "schema_version": "1.0", "kind": "factual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "caldwell-comparative-grammar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திராவிட மொழிகளின் ஒப்பிலக்கணம் (A Comparative Grammar of the Dravidian Languages) என்ற நூலை எழுதித் திராவிட மொழிக் குடும்பத்தின் தனித்துவத்தை நிறுவியவர் யார்?", "media_id": null}], "options": {"A": "எல்லிஸ்", "B": "மேக்ஸ் முல்லர்", "C": "வில்லியம் ஜோன்ஸ்", "D": "ராபர்ட் கால்டுவெல் (Robert Caldwell - 1856)"}, "explanation": "ராபர்ட் கால்டுவெல் 1856-இல் 'திராவிட மொழிகளின் ஒப்பிலக்கணம்' என்னும் நூலைப் படைத்துத் தமிழ் உள்ளிட்ட திராவிட மொழிகள் வடமொழியினின்று முற்றிலும் வேறுபட்ட தனித்துவ மொழிக் குடும்பம் என்பதை உலகிற்கு உணர்த்தினார்."}, "en": {"blocks": [{"type": "text", "content": "Who established the linguistic autonomy of Dravidian languages through his epochal work 'A Comparative Grammar of the Dravidian Languages' (1856)?", "media_id": null}], "options": {"A": "Francis Whyte Ellis", "B": "Max Muller", "C": "William Jones", "D": "Robert Caldwell (ராபர்ட் கால்டுவெல் - 1856)"}, "explanation": "Robert Caldwell demonstrated the independent status of the Dravidian family in 1856."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", 