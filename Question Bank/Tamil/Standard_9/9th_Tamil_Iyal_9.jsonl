{"id": "9th-u9-q002", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "thaninayagam-birthplace", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தனிநாயக அடிகள் எங்கு பிறந்தார்? அவருடைய இயற்பெயர் யாது?", "media_id": null}], "options": {"A": "தஞ்சாவூர்; இயற்பெயர் அருள்தாஸ்", "B": "இலங்கையின் யாழ்ப்பாணம்; இயற்பெயர் பஸ்தியான் பிலிப் (Bastiyan Philip)", "C": "திருச்சிராப்பள்ளி; இயற்பெயர் ஜோசப்", "D": "மலேசியா பினாங்கு; இயற்பெயர் ஆரோக்கியசாமி"}, "explanation": "பாடநூல் ஆசிரியர் குறிப்பு: தனிநாயகம் அடிகள் இலங்கையின் யாழ்ப்பாணத்தில் பிறந்தார். இவரது இயற்பெயர் 'பஸ்தியான் பிலிப்' என்பதாகும்."}, "en": {"blocks": [{"type": "text", "content": "Where was Thaninayagam Adigal born, and what was his original given name?", "media_id": null}], "options": {"A": "Thanjavur; given name Aruldas", "B": "Jaffna, Sri Lanka; given name Bastiyan Philip (பஸ்தியான் பிலிப்)", "C": "Tiruchirappalli; given name Joseph", "D": "Penang, Malaysia; given name Arockiasamy"}, "explanation": "Father Thaninayagam was born in Jaffna, Sri Lanka, and named Bastiyan Philip."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "ful