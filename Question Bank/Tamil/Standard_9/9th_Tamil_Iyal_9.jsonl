{"id": "9th-u9-q082", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l2", "chapter_id": null, "topic_id": "kalyanji-artistic-talent", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிதை, சிறுகதை, கட்டுரை மட்டுமன்றி கல்யாண்ஜி வேறு எந்தக் கலைத் துறையிலும் ஈடுபாடு கொண்டவர்?", "media_id": null}], "options": {"A": "சிற்பக்கலை", "B": "ஓவியக்கலை (வண்ண ஓவியங்கள் தீட்டுதல்)", "C": "இசைக்கருவி வாசித்தல்", "D": "நாடக இயக்கம்"}, "explanation": "கல்யாண்ஜி கவிதை, கதை எழுதுவதோடு மட்டுமல்லாமல் மிக அழகிய வண்ண ஓவியங்களை வரையும் சிறந்த ஓவியராகவும் திகழ்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "Besides literature, in which fine art form is Kalyanji remarkably accomplished?", "media_id": null}], "options": {"A": "Sculpture", "B": "Painting / Visual Art (ஓவியக்கலை)", "C": "Carnatic instrumental music", "D": "Theatrical stage directing"}, "explanation": "Kalyanji is also a gifted painter and sketch artist."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 179, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 179", "url": null, "source_notes": null}, "previ