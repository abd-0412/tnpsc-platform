{"id": "9th-u9-q019", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "thaninayagam-third-conference-paris", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மூன்றாவது உலகத் தமிழாராய்ச்சி மாநாடு 1970-ஆம் ஆண்டு எந்த ஐரோப்பிய நகரத்தில் நடைபெற்றது?", "media_id": null}], "options": {"A": "லண்டன் (இங்கிலாந்து)", "B": "ரோம் (இத்தாலி)", "C": "பாரிஸ் (பிரான்ஸ்)", "D": "ஜெனீவா (சுவிட்சர்லாந்து)"}, "explanation": "1970-ஆம் ஆண்டு பிரான்ஸ் நாட்டின் தலைநகரான பாரிசில் மூன்றாவது உலகத் தமிழாராய்ச்சி மாநாடு தனிநாயகம் அடிகளாரின் வழிகாட்டுதலில் வெற்றிகரமாக நடைபெற்றது."}, "en": {"blocks": [{"type": "text", "content": "In which European metropolis was the Third World Tamil Conference hosted in 1970?", "media_id": null}], "options": {"A": "London (England)", "B": "Rome (Italy)", "C": "Paris (France - பாரிஸ்)", "D": "Geneva (Switzerland)"}, "explanation": "The 3rd World Tamil Conference convened in Paris, France in 1970."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 176, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 176", "url": n