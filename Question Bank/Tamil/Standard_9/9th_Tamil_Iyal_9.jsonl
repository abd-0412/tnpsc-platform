{"id": "9th-u9-q056", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "virivaagum-aalumaai-conclusion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தனிநாயக அடிகளின் 'விரிவாகும் ஆளுமை' உரைநடை நமக்குக் கற்பிக்கும் முதன்மையான வாழ்க்கை வழிகாட்டல் எது?", "media_id": null}], "options": {"A": "தன்னுடைய குடும்ப முன்னேற்றமே வாழ்க்கையின் இறுதி இலக்கு", "B": "அயல்நாட்டுப் பண்பாடுகளை கண்மூடித்தனமாகப் பின்பற்றுதல்", "C": "பிற மொழிகளை இழித்துரைத்தல்", "D": "தன் சொந்தப் பண்பாட்டுப் பெருமைகளை உணர்ந்து போற்றி, அனைத்து மாந்தரையும் தழுவும் உலகளாவிய சகோதரத்துவத்தோடு வாழ்வது"}, "explanation": "பாடநூலின் இறுதி முடிவுரை: ஒரு மனிதன் தன் சொந்த மொழி மற்றும் பண்பாட்டின் விழுமியங்களை ஆழமாகக் கற்றுத் தெளிவதோடு, உலகம் தழுவிய ஒருமைப்பாட்டு உணர்வையும் மனிதநேயத்தையும் பெற்று வாழ்வதே பக்குவமடைந்த விரிவான ஆளுமையாகும்."}, "en": {"blocks": [{"type": "text", "content": "What primary philosophical guidance does Father Thaninayagam's 'Virivaagum Aalumaai' bestow upon learners?", "media_id": null}], "options": {"A": "Personal family advancement is the sole objective in life", "B": "Blindly mimicking foreign habits and lifestyle", "C": "Denigrating other languages and traditions", "D": "Cherishing native heritage deeply while living with expansive universal fraternity embracing all human beings"}, "explanation": "It teaches us to cherish our native cultural heritage while living with universal compassion and fraternity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 175, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 175", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_9", "aalumaai", "philosophical_guidance"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

