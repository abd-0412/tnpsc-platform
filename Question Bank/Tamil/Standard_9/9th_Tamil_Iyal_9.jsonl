{"id": "9th-u9-q122", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l5", "chapter_id": null, "topic_id": "vaetrumai-ani-def", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரண்டு பொருள்களுக்கு இடையே உள்ள ஒற்றுமையைக் கூறி, பின்னர் அவற்றுள் ஒன்றை மற்றொன்றிலிருந்து வேறுபடுத்திக் காட்டுவது எவ்வகை அணியாகும்?", "media_id": null}], "options": {"A": "உவமை அணி", "B": "வேற்றுமை அணி", "C": "உருவக அணி", "D": "வஞ்சப்புகழ்ச்சி அணி"}, "explanation": "செய்யுளில் இரு பொருள்களுக்கு இடையே உள்ள பொதுவான ஒற்றுமையை முதலில் விளக்கி, பின்னர் ஒன்றை விட மற்றொன்று எவ்வகையில் வேறுபடுகிறது அல்லது சிறந்தது எனக் காட்டுவது 'வேற்றுமை அணி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What rhetorical figure establishes an initial similarity between two entities and subsequently contrasts one from the other?", "media_id": null}], "options": {"A": "Uvamai Ani", "B": "Vaetrumai Ani (வேற்றுமை அணி - Antithetical Distinction / Contrast)", "C": "Uruvaga Ani", "D": "Vanjappugazhchi Ani"}, "explanation": "Vaetrumai Ani sets up a common attribute between two items before demarcating their crucial contrast."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "clas