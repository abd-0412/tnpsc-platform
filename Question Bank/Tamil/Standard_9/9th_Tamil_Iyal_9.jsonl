{"id": "9th-u9-q099", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l4", "chapter_id": null, "topic_id": "calm-after-storm-imagery", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புயல் ஓய்ந்து சூரியன் உதித்த பிறகு கடலின் காட்சி எவ்வாறு மாறியது?", "media_id": null}], "options": {"A": "கடல் வற்றி நிலமாக மாறியது", "B": "இரண்டாவது புயல் உடனே தாக்கியது", "C": "நீலப்பெருங்கடல் அமைதியடைந்து சாந்தமானது; அலைகள் தணிந்து, பறவைகளும் மீன்களும் துள்ளின", "D": "கப்பல் தரைதட்டி உடைந்தது"}, "explanation": "புயல் அடங்கியதும் கடல் நீல நிறப் பளபளப்புடன் அமைதியானது; வெள்ளைப் பறவைகள் வானில் வட்டமிட்டன; மாலுமிகள் நிம்மதிப் பெருமூச்சு விட்டனர்."}, "en": {"blocks": [{"type": "text", "content": "How was the seascape transformed once the ferocious storm subsided and sunlight broke through?", "media_id": null}], "options": {"A": "The ocean evaporated into dry land", "B": "A second catastrophic hurricane struck instantly", "C": "The deep blue ocean grew serene and calm; swells abated, and fish and sea birds playfully leaped", "D": "The ship ran aground and shattered"}, "explanation": "Calm returned to the cerulean sea, with gentle swells and seabirds circling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tami