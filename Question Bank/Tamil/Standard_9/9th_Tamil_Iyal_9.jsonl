{"id": "9th-u9-q058", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l2", "chapter_id": null, "topic_id": "kalyanji-real-name-birthplace", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் கல்யாண்ஜியின் இயற்பெயர் யாது? இவர் எந்த ஊரைச் சேர்ந்தவர்?", "media_id": null}], "options": {"A": "சுந்தரராமசாமி; நாகர்கோவில்", "B": "கல்யாணசுந்தரம்; திருநெல்வேலி", "C": "கிருஷ்ணமூர்த்தி; தஞ்சாவூர்", "D": "விருத்தாசலம்; விருத்தாசலம்"}, "explanation": "பாடநூல் ஆசிரியர் குறிப்பு: கல்யாண்ஜியின் இயற்பெயர் 'கல்யாணசுந்தரம்' என்பதாகும். இவர் திருநெல்வேலியைச் சேர்ந்தவர்."}, "en": {"blocks": [{"type": "text", "content": "What is poet Kalyanji's real birth name, and what is his hometown?", "media_id": null}], "options": {"A": "Sundararamasamy; Nagercoil", "B": "Kalyanasundaram; Tirunelveli (கல்யாணசுந்தரம்; திருநெல்வேலி)", "C": "Krishnamoorthy; Thanjavur", "D": "Viruthachalam; Virudhachalam"}, "explanation": "Kalyanji's birth name is S. Kalyanasundaram, hailing from Tirunelveli."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 179, "chapter": null, "section": null, "reference": "9th Tamil, Unit