{"id": "9th-u9-q102", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l4", "chapter_id": null, "topic_id": "seabirds-omen-of-land", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கடலில் பறவைகளும் வண்ண மீன்களும் தெரிவதைக் கண்டதும் மாலுமிகள் மகிழ்ச்சியடைந்ததன் காரணம் யாது?", "media_id": null}], "options": {"A": "அவற்றை வேட்டையாடி உண்ணலாம் என்பதால்", "B": "கரை (நிலப்பரப்பு) மிக அருகில் இருப்பதை அவை உணர்த்தியதால்", "C": "மீண்டும் புயல் வரும் அறிகுறி என்பதால்", "D": "அவை கப்பலுக்கு வழிகாட்ட வந்த தேவதைகள் என்பதால்"}, "explanation": "கடலோடிகள் கடலில் பறவைகளைக் காண்பது நிலப்பரப்பு (கரை) அருகில் வந்துவிட்டது என்பதற்கான இயற்கையான நற்குறியாகும். இதனால் மாலுமிகள் மகிழ்ச்சி அடைந்தனர்."}, "en": {"blocks": [{"type": "text", "content": "Why were the battered sailors overjoyed upon spotting fluttering sea birds and coastal fish around the vessel?", "media_id": null}], "options": {"A": "Because they could hunt them for food", "B": "Because coastal birds signified that mainland shore was very near (கரை அருகில் உள்ளது)", "C": "Because they presaged another cyclone", "D": "Because they were mythic guardian angels"}, "explanation": "In classical navigation, sighting coastal birds indicates that dry land is within close reach."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type"