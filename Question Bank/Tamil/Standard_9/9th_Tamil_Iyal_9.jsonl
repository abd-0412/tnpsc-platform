{"id": "9th-u9-q088", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l4", "chapter_id": null, "topic_id": "singaram-dina-thanthi-journalism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தோனேசியாவிலிருந்து தமிழகம் திரும்பிய ப. சிங்காரம் மதுரையில் எந்த நாளிதழில் நீண்ட காலம் பணியாற்றினார்?", "media_id": null}], "options": {"A": "தினமணி", "B": "சுதேசமித்திரன்", "C": "தினமலர்", "D": "தினத்தந்தி (மதுரை பதிப்பு)"}, "explanation": "பாடநூல் குறிப்பு: மீண்டும் இந்தியா வந்த ப. சிங்காரம் மதுரையில் 'தினத்தந்தி' நாளிதழில் நீண்ட காலம் செய்திப் பிரிவில் பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Upon returning to Tamil Nadu from Indonesia, in which prominent daily newspaper did Pa. Singaram work for years in Madurai?", "media_id": null}], "options": {"A": "Dinamani", "B": "Swadesamitran", "C": "Dinamalar", "D": "Dina Thanthi (Madurai edition - தினத்தந்தி)"}, "explanation": "He served on the editorial desk of Dina Thanthi in Madurai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 186, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 186