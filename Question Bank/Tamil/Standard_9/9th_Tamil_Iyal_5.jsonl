{"id": "9th-u5-q132", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l4", "chapter_id": null, "topic_id": "vallinam-correct-identification", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வருவனவற்றுள் சரியான முறையில் வல்லினம் மிகுந்துள்ள தொடர் எது?", "media_id": null}], "options": {"A": "எழுதி பார்த்தான்", "B": "கிழக்கு திசை", "C": "மலர்கை", "D": "படித்துப் பார்த்தான்"}, "explanation": "'படித்து' என்பது வன்தொடர்க் குற்றியலுகர வினையெச்சம். அதன் பின் வல்லினம் மிக வேண்டும் (படித்துப் பார்த்தான்). மற்றவை வல்லினம் மிகாமல் பிழையாக உள்ளன (எழுதிப் பார்த்தான், கிழக்குத் திசை, மலர்க்கை என வர வேண்டும்)."}, "en": {"blocks": [{"type": "text", "content": "Which of the following phrases exhibits correct, rule-compliant plosive gemination?", "media_id": null}], "options": {"A": "Ezhudhi paarthaan", "B": "Kizhakku thisai", "C": "Malarkai", "D": "Padithup paarthaan"}, "explanation": "'Padithu' is a Van-thodar Kuttiyalugaram participle where doubling is mandatory, correctly rendered as 'Padithup paarthaan'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 130, "chapter": null, "section": nul