{"id": "9th-u5-q098", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "janakiraman-other-novels", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் நாவல்களுள் தி. ஜானகிராமன் இயற்றாத நாவல் எது?", "media_id": null}], "options": {"A": "மரப்பசு", "B": "சாய்வு நாற்காலி", "C": "செம்பருத்தி", "D": "மோகமுள்"}, "explanation": "மோகமுள், மரப்பசு, செம்பருத்தி, அம்மா வந்தாள் ஆகியவை தி. ஜானகிராமனின் நாவல்கள். 'சாய்வு நாற்காலி' தோப்பில் முகமது மீரான் எழுதிய நாவலாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following novels was NOT authored by T. Janakiraman?", "media_id": null}], "options": {"A": "Marappasu", "B": "Saaivu Naarkaali", "C": "Sembaruthi", "D": "Mogamul"}, "explanation": "'Saaivu Naarkaali' was written by Thoppil Mohamed Meeran; the others are Janakiraman's novels."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 121, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 121", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "y