{"id": "9th-u5-q152", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l6", "chapter_id": null, "topic_id": "pyq-ravana-kaviyam-anna", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC முந்தைய ஆண்டு வினா] \"இராவண காவியம் காலத்தின் விளைவு; ஆராய்ச்சியின் அறிகுறி; புரட்சிப் பொறி\" என்று புகழ்ந்துரைத்தவர் யார்?", "media_id": null}], "options": {"A": "கலைஞர் மு. கருணாநிதி", "B": "தந்தை பெரியார்", "C": "வ. உ. சிதம்பரம் பிள்ளை", "D": "பேரறிஞர் அண்ணா"}, "explanation": "பேரறிஞர் அண்ணா அவர்கள் இராவண காவியத்தைப் 'புரட்சிப் பொறி, காலத்தின் விளைவு' எனப் புகழ்ந்துள்ளார். இது TNPSC தேர்வுகளில் தொடர்ந்து கேட்கப்படும் முதன்மை வினாவாகும்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Previous Year Question] Who famously commended 'Ravana Kaviyam' as 'the outcome of the epoch, a symptom of research, a spark of revolution'?", "media_id": null}], "options": {"A": "Kalaignar M. Karunanidhi", "B": "Thanthai Periyar", "C": "V. O. Chidambaram Pillai", "D": "Perarignar Anna"}, "explanation": "Perarignar Anna acclaimed 'Ravana Kaviyam' with this iconic endorsement."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition