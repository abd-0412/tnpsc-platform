{"id": "9th-u5-q038", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "swamimalai-bronze", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழகத்தில் பாரம்பரிய வெண்கலச் சிலைகள் மற்றும் செப்புத் திருமேனிகள் தயாரிப்பதற்கு உலகப் புகழ்பெற்ற ஊர் எது?", "media_id": null}], "options": {"A": "நாச்சியார்கோவில்", "B": "சுவாமிமலை", "C": "பத்தமடை", "D": "பவானி"}, "explanation": "கும்பகோணம் அருகில் உள்ள 'சுவாமிமலை' சோழர் காலத்து மெழுகு அச்சு முறைப்படி உலகத்தரம் வாய்ந்த வெண்கலச் சிலைகளை (Bronze icons) வார்க்கும் சிற்பக் கலைக்கூடங்களுக்குப் பெயர் பெற்றது."}, "en": {"blocks": [{"type": "text", "content": "Which heritage town in Tamil Nadu is world-renowned for casting traditional cire-perdue bronze icons and statues?", "media_id": null}], "options": {"A": "Nachiyarkoil", "B": "Swamimalai", "C": "Pattamadai", "D": "Bhavani"}, "explanation": "Swamimalai is internationally celebrated for bronze idol casting inheriting ancient Chola cire-perdue foundry techniques."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 113, "chapter": null, "section": null, "refer