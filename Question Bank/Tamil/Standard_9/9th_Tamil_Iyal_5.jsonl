{"id": "9th-u5-q082", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l2", "chapter_id": null, "topic_id": "ravana-kaviyam-century", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இராவண காவியம் எந்த நூற்றாண்டில் இயற்றப்பட்ட காப்பியமாகும்?", "media_id": null}], "options": {"A": "பத்தொன்பதாம் நூற்றாண்டு", "B": "இருபதாம் நூற்றாண்டு", "C": "பதினெட்டாம் நூற்றாண்டு", "D": "இருபத்தோராம் நூற்றாண்டு"}, "explanation": "இராவண காவியம் இருபதாம் நூற்றாண்டின் முற்பகுதியில் தந்தை பெரியார் காலத்துத் திராவிட இயக்க மறுமலர்ச்சிக் காலத்தில் இயற்றப்பட்ட காப்பியமாகும்."}, "en": {"blocks": [{"type": "text", "content": "In which century was the epic 'Ravana Kaviyam' composed?", "media_id": null}], "options": {"A": "Nineteenth century", "B": "Twentieth century", "C": "Eighteenth century", "D": "Twenty-first century"}, "explanation": "'Ravana Kaviyam' was composed in the 20th century amidst the Dravidian literary renaissance."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 114", "url": null, "source_notes": null}, "previous_yea