{"id": "9th-u5-q101", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "janakiraman-birth-village", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி. ஜானகிராமன் பிறந்த மாவட்டம் எது?", "media_id": null}], "options": {"A": "தஞ்சாவூர் மாவட்டம்", "B": "திருச்சிராப்பள்ளி மாவட்டம்", "C": "மதுரை மாவட்டம்", "D": "திருநெல்வேலி மாவட்டம்"}, "explanation": "தி. ஜானகிராமன் தஞ்சாவூர் மாவட்டம் மன்னார்குடிக்கு அருகிலுள்ள தேவகுடி கிராமத்தில் பிறந்தவர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "In which cultural district of the Cauvery delta was T. Janakiraman born?", "media_id": null}], "options": {"A": "Thanjavur district", "B": "Tiruchirappalli district", "C": "Madurai district", "D": "Tirunelveli district"}, "explanation": "T. Janakiraman was born in Devagudi near Mannargudi in Thanjavur district."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 121, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 121", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "y