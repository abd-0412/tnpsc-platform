{"id": "9th-u5-q011", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "pallava-sculptors-title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாமல்லபுரத்தில் உள்ள ஒற்றைக்கல் ரதங்களில் குறிப்பிடத்தக்க 'பஞ்சபாண்டவர் ரதங்கள்' யாரால் உருவாக்கப்பட்டன?", "media_id": null}], "options": {"A": "மகேந்திரவர்ம பல்லவன்", "B": "இரண்டாம் நந்திவர்மன்", "C": "முதலாம் நரசிம்மவர்மன் (மாமல்லன்)", "D": "தந்திவர்மன்"}, "explanation": "மாமல்லபுரத்து ஒற்றைக்கல் ரதங்களையும் குடைவரைகளையும் உருவாக்கியவர் மாமல்லன் என்று புகழ்பெற்ற முதலாம் நரசிம்மவர்ம பல்லவன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Under which celebrated Pallava monarch were the monolithic Pancha Pandava Rathas sculpted at Mamallapuram?", "media_id": null}], "options": {"A": "Mahendravarman I", "B": "Nandivarman II", "C": "Narasimhavarman I (Mamallan)", "D": "Dantivarman"}, "explanation": "Monolithic Rathas at Mamallapuram were carved during the reign of Narasimhavarman I (Mamallan)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 109, "chapter": null, "section": null, "reference": "