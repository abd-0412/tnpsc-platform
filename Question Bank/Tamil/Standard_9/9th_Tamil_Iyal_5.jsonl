{"id": "9th-u5-q111", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "janakiraman-passed-away", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி. ஜானகிராமன் தம் வாழ்நாளில் தமிழுக்கு ஆற்றிய முதன்மைப் பங்களிப்பாகக் கருதப்படுவது எது?", "media_id": null}], "options": {"A": "அகராதி தயாரிப்பு", "B": "கல்வெட்டு ஆய்வு", "C": "தமிழ் உரைநடையில் இசையையும் உளவியல் நுணுக்கங்களையும் கையாண்டு நவீன சிறுகதை, நாவல்களை உலகத்தரத்திற்கு உயர்த்தியது", "D": "சட்ட நூல்கள் இயற்றியது"}, "explanation": "தி. ஜானகிராமன் தமிழ் நவீன இலக்கியத்தில் உளவியல் ஆழத்தையும் கலை நேர்த்தியையும் இணைத்துத் தமிழ் உரைநடையை உலக இலக்கியத் தளத்திற்கு உயர்த்திய முன்னோடியாவார்."}, "en": {"blocks": [{"type": "text", "content": "What is recognized as T. Janakiraman's pre-eminent contribution to Tamil literary history?", "media_id": null}], "options": {"A": "Lexicographical compilation", "B": "Epigraphical deciphers", "C": "Elevating modern Tamil fiction to world standards through psychological depth and musical cadence", "D": "Drafting legal codices"}, "explanation": "Janakiraman's legacy lies in synthesizing musical sensibility with psychological depth in modern Tamil prose."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "pub