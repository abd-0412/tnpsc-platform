{"id": "9th-u5-q069", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l2", "chapter_id": null, "topic_id": "ravana-kaviyam-kurinji-lines", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"அருவிகள் இன்பக் குரல் எழுப்ப, மயில்கள் நடனமாட, பூக்கள் தேன் சிந்தும்\" நிலமாக இராவண காவியத்தில் வருணிக்கப்படும் நிலம் எது?", "media_id": null}], "options": {"A": "குறிஞ்சி நிலம்", "B": "முல்லை நிலம்", "C": "மருத நிலம்", "D": "நெய்தல் நிலம்"}, "explanation": "மலை சார்ந்த குறிஞ்சி நிலத்தில் அருவியின் இன்னோசையும், மயில்களின் நடனமும், தேன் வழியும் சுனைகளும் இயற்கை எழிலாக விவரிக்கப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Which landscape is depicted in Ravana Kaviyam with cascading waterfalls, dancing peafowls, and honey-dripping springs?", "media_id": null}], "options": {"A": "Kurinji (Montane)", "B": "Mullai (Pastoral)", "C": "Marutham (Agrarian)", "D": "Neithal (Littoral)"}, "explanation": "Kurinji is characterized by scenic mountain cataracts, vibrant peafowls, and natural apiaries."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "