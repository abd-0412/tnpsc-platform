{"id": "9th-u5-q058", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l2", "chapter_id": null, "topic_id": "ravana-kaviyam-structure", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புலவர் குழந்தை இயற்றிய 'இராவண காவியம்' எத்தனை காண்டங்களையும் எத்தனை பாடல்களையும் கொண்டுள்ளது?", "media_id": null}], "options": {"A": "ஆறு காண்டங்கள், 3,000 பாடல்கள்", "B": "ஐந்து காண்டங்கள், 3,100 பாடல்கள்", "C": "நான்கு காண்டங்கள், 2,500 பாடல்கள்", "D": "ஐந்து காண்டங்கள், 3,500 பாடல்கள்"}, "explanation": "இராவண காவியம் 5 காண்டங்களையும் 3,100 பாடல்களையும் கொண்டது. ஐந்து காண்டங்கள்: தமிழகக் காண்டம், இலங்கைக் காண்டம், விந்தக் காண்டம், பழிபுரி காண்டம், போர்க் காண்டம்."}, "en": {"blocks": [{"type": "text", "content": "How many cantos (Kandams) and verses (Padalgal) does Pulavar Kuzhandhai's 'Ravana Kaviyam' comprise?", "media_id": null}], "options": {"A": "Six Kandams, 3,000 verses", "B": "Five Kandams, 3,100 verses", "C": "Four Kandams, 2,500 verses", "D": "Five Kandams, 3,500 verses"}, "explanation": "'Ravana Kaviyam' comprises 5 Kandams (Thamizhaga, Ilangai, Vindha, Pazhipuri, Porkkandam) and 3,100 verses."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class"