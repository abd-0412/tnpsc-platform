{"id": "9th-u5-q091", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "seidhai-central-theme", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'செய்தி' சிறுகதையின் மையக் கருப்பொருள் எதனோடு தொடர்புடையது?", "media_id": null}], "options": {"A": "ஓவியக்கலை", "B": "நாடகக்கலை", "C": "இசைக்கலை (நாதசுவர இசை)", "D": "சிற்பக்கலை"}, "explanation": "'செய்தி' சிறுகதை நாதசுவரக் கலைஞரின் இசைத் தவத்தையும், இசையின் மூலம் மனித மனங்கள் ஒன்றிணையும் செய்திப் பரிமாற்றத்தையும் மையமாகக் கொண்டது."}, "en": {"blocks": [{"type": "text", "content": "What is the central thematic core of the short story 'Seidhi'?", "media_id": null}], "options": {"A": "Painting", "B": "Theatre", "C": "Musical art (Nadaswaram recital)", "D": "Sculpture"}, "explanation": "'Seidhi' centers on the spiritual sublime world of a Nadaswaram instrumental maestro."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 118, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 118", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name":