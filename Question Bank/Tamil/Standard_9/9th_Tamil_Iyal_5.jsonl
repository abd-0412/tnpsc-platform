{"id": "9th-u5-q072", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l2", "chapter_id": null, "topic_id": "ravana-kaviyam-vocab-kadaru", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கடறு' என்னும் சொல்லின் பொருள் யாது?", "media_id": null}], "options": {"A": "கடல்", "B": "பாறை", "C": "மலை", "D": "காடு"}, "explanation": "'கடறு' என்றால் காடு என்று பொருள். கடறும் கழனியும் - காடும் வயலும்."}, "en": {"blocks": [{"type": "text", "content": "What does the ancient Tamil term 'Kadaru' denote?", "media_id": null}], "options": {"A": "Sea", "B": "Rock", "C": "Mountain", "D": "Forest (Kaadu)"}, "explanation": "'Kadaru' translates to forest / woodland wilderness."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 115, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 115", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_5", "ravana_kaviyam", "vocabulary"], "language_status": {"ta": "a