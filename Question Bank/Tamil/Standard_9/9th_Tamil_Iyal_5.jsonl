{"id": "9th-u5-q003", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "pallava-sculptures-cave", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழகத்தில் சுதை மற்றும் மரத்தால் மட்டுமே சிற்பங்கள் செய்துவந்த நிலையை மாற்றி, பாறைகளைக் குடைந்து கருங்கல் குடைவரைக் கோயில்களை உருவாக்கியவர்கள் யார்?", "media_id": null}], "options": {"A": "சேரர்கள்", "B": "சோழர்கள்", "C": "பல்லவர்கள்", "D": "நாயக்கர்கள்"}, "explanation": "பல்லவர் காலத்தில்தான் பாறைகளைக் குடைந்து குடைவரைக் கோயில்களும், ஒற்றைக்கல் ரதங்களும் கருங்கல்லால் வடிவமைக்கும் புதிய சிற்பக்கலை மரபு தமிழகத்தில் வேரூன்றியது."}, "en": {"blocks": [{"type": "text", "content": "Who transformed the sculptural tradition of Tamil Nadu by hewing rock-cut cave temples out of solid granite instead of transient wood and stucco?", "media_id": null}], "options": {"A": "Cheras", "B": "Cholas", "C": "Pallavas", "D": "Nayaks"}, "explanation": "The Pallavas introduced granite rock-cut architecture and monolithic rathas, revolutionizing Tamil structural sculpting."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page"