{"id": "9th-u5-q119", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l4", "chapter_id": null, "topic_id": "vallinam-vantodar-kuttiyalugaram", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உகரத்தில் முடியும் எவ்வகைக் குற்றியலுகர வினையெச்சங்களை அடுத்து வல்லினம் மிகும்?", "media_id": null}], "options": {"A": "மென்தொடர்க் குற்றியலுகரம்", "B": "இடைத்தொடர்க் குற்றியலுகரம்", "C": "வன்தொடர்க் குற்றியலுகரம் (படித்து, கேட்டு போன்றவை)", "D": "உயிர்த்தொடர்க் குற்றியலுகரம்"}, "explanation": "வன்தொடர்க் குற்றியலுகர வினையெச்சங்களின் பின் வல்லினம் மிகும். எ.கா: படித்து + பார்த்தான் = படித்துப் பார்த்தான்; பெற்று + கொண்டான் = பெற்றுக் கொண்டான்."}, "en": {"blocks": [{"type": "text", "content": "Following verbal participles of which Kuttiyalugaram category does plosive gemination occur?", "media_id": null}], "options": {"A": "Men-thodar kuttiyalugaram", "B": "Idai-thodar kuttiyalugaram", "C": "Van-thodar kuttiyalugaram (e.g., padithu, kettu)", "D": "Uyir-thodar kuttiyalugaram"}, "explanation": "Participles rooted in Van-thodar Kuttiyalugaram (hard consonant bases like padithu) obligatorily double following plosives."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporati