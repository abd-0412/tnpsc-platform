{"id": "9th-u5-q137", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l4", "chapter_id": null, "topic_id": "vallinam-salachirandhadhu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'சாலச் சிறந்தது' என்னும் தொடரில் 'ச்' மிகுந்துள்ளதற்கான இலக்கண விதி யாது?", "media_id": null}], "options": {"A": "'சால' என்னும் உரிச்சொல்லின் பின் வல்லினம் மிகும்", "B": "உவமைத்தொகையில் வல்லினம் மிகும்", "C": "வினாத் திரிபில் வல்லினம் மிகும்", "D": "இடைத்தொடர்க் குற்றியலுகரத்தில் வல்லினம் மிகும்"}, "explanation": "'சால' என்பது மிகுதி என்னும் பொருளுணர்த்தும் உரிச்சொல். சால, தவ போன்ற உரிச்சொற்களுக்குப் பின் வல்லினம் மிகும் என்ற விதிப்படி சால + சிறந்தது = சாலச் சிறந்தது என்றானது."}, "en": {"blocks": [{"type": "text", "content": "What rule causes 'ch' doubling in 'Saalach chirandhadhu'?", "media_id": null}], "options": {"A": "Plosives double following the intensive qualifying particle 'Saala'", "B": "Simile compound rule", "C": "Interrogative mutation rule", "D": "Idai-thodar kuttiyalugaram rule"}, "explanation": "'Saala' is an Urichol that obligatorily triggers plosive gemination."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 130, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 130", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_5", "grammar", "urichol"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u5-q138", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l4", "chapter_id": null, "topic_id": "vallinam-parakkum-thattu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"பறக்கும் தட்டு\" மற்றும் \"பறக்கும் தட்டு\" போன்ற தொடர்களில் வல்லினம் மிகாமை எதைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "வினையெச்சப் பொருளைக் குறிக்கிறது", "B": "பெயரெச்சத் தொடராக அமைந்து பொருள் தெளிவைத் தருகிறது", "C": "வேற்றுமைத் தொடராக அமைகிறது", "D": "எந்தப் பொருளையும் உணர்த்தவில்லை"}, "explanation": "'பறக்கும்' என்பது பெயரெச்சம். பெயரெச்சத்தை அடுத்து வல்லினம் மிகாது ('பறக்கும் தட்டு'). இது தட்டின் தன்மையை உணர்த்தும் பெயரெச்சத் தொடராக அமைகிறது."}, "en": {"blocks": [{"type": "text", "content": "In \"Parakkum thattu\" (Flying saucer), why does plosive doubling NOT occur after 'parakkum'?", "media_id": null}], "options": {"A": "It functions as a verbal participle", "B": "Because 'parakkum' is a relative adjectival participle (Peyarechcham), where plosives do not double", "C": "It is a case compound", "D": "It has no semantic function"}, "explanation": "Relative participles (Peyarechcham) ending in '-um' do not trigger plosive doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook a