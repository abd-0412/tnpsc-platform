{"id": "9th-u5-q092", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "janakiraman-dialect", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி. ஜானகிராமனின் படைப்புகளில் எந்த மாவட்டத்து வட்டார மொழி வழக்கு இயல்பாக இழையோடுகிறது?", "media_id": null}], "options": {"A": "கொங்கு வட்டார வழக்கு", "B": "நெல்லை வட்டார வழக்கு", "C": "கரிசல் வட்டார வழக்கு", "D": "தஞ்சாவூர் வட்டார வழக்கு"}, "explanation": "தி. ஜானகிராமன் தஞ்சை மாவட்டத்துப் பண்பாட்டையும் காவிரி பாசனப் பகுதியின் எழிலார்ந்த வட்டார மொழி வழக்கையும் தம் எழுத்துகளில் மிக நுணுக்கமாகப் பதிவு செய்தவர்."}, "en": {"blocks": [{"type": "text", "content": "Which regional dialect and cultural idiom permeate the literary works of T. Janakiraman?", "media_id": null}], "options": {"A": "Kongu dialect", "B": "Nellai dialect", "C": "Karisal dialect", "D": "Thanjavur regional dialect"}, "explanation": "T. Janakiraman is celebrated for capturing the rich Thanjavur dialect and delta ethos."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 121, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 121", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_5", "janakiraman", "dialect"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u5-q093", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "janakiraman-career", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி. ஜானகிராமன் பள்ளியாசிரியராகப் பணியாற்றிய பிறகு எந்த அமைப்பில் கல்வி ஒலிபரப்பு அமைப்பாளராகப் பணியாற்றினார்?", "media_id": null}], "options": {"A": "அகில இந்திய வானொலி (All India Radio)", "B": "தூர்தர்ஷன் தொலைக்காட்சி", "C": "பல்கலைக்கழக மானியக் குழு", "D": "சாகித்திய அகாதெமி"}, "explanation": "தி. ஜானகிராமன் உயர்நிலைப் பள்ளி ஆசிரியராகப் பணியாற்றிய பின்னர், அகில இந்திய வானொலியில் (AIR) கல்வி ஒலிபரப்பு அமைப்பாளராகப் பணியாற்றி ஓய்வு பெற்றார்."}, "en": {"blocks": [{"type": "text", "content": "After teaching in high schools, in which organization did T. Janakiraman serve as Educational Broadcast Producer?", "media_id": null}], "options": {"A": "All India Radio (AIR)", "B": "Doordarshan", "C": "University Grants Commission", "D": "Sahitya Akademi"}, "explanation": "T. Janakiraman served as Producer of Educational Broadcasts at All India Radio."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 121, "chapter": n