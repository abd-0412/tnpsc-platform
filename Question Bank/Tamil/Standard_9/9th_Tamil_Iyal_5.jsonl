{"id": "9th-u5-q044", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "srirangam-sculptures", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருச்சி திருவரங்கம் (ஸ்ரீரங்கம்) அரங்கநாதர் கோயிலில் உள்ள 'வெள்ளைக் கோபுரம்' மற்றும் சேசராயர் மண்டபச் சிற்பங்கள் யாருடைய காலத்தவை?", "media_id": null}], "options": {"A": "பல்லவர் காலம்", "B": "சோழர் காலம்", "C": "பாண்டியர் காலம்", "D": "நாயக்கர் காலம்"}, "explanation": "திருவரங்கம் கோயிலில் உள்ள சேசராயர் மண்டபத்தில் பாய்ந்து எழும் குதிரைகளின் மீது அமர்ந்த வீரர்கள் மற்றும் சிம்ம சிற்பங்கள் நாயக்கர் காலப் பேரழகைப் பறைசாற்றுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "To which era do the dramatic rearing steed pillar statues of Sesharayar Mandapam in Srirangam Temple belong?", "media_id": null}], "options": {"A": "Pallava period", "B": "Chola period", "C": "Pandya period", "D": "Nayak period"}, "explanation": "Sesharayar Mandapam at Srirangam featuring rearing war horses is an iconic masterpiece of Nayak architecture."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 112, "chapter": null, 