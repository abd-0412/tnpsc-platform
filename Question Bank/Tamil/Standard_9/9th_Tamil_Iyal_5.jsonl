{"id": "9th-u5-q071", "schema_version": "1.0", "kind": "grammar", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l2", "chapter_id": null, "topic_id": "ravana-kaviyam-grammar-split", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பொழிந்த' என்னும் சொல்லின் சரியான பகுபத உறுப்பிலக்கணப் பிரிப்பு எது?", "media_id": null}], "options": {"A": "பொழி + ந்த", "B": "பொழி + த் + அ", "C": "பொழி + த்(ந்) + த் + அ", "D": "பொழிந் + த் + அ"}, "explanation": "பொழிந்த = பொழி + த்(ந்) + த் + அ. பொழி - பகுதி, த் - சந்தி ('ந்' ஆனது விகாரம்), த் - இறந்தகால இடைநிலை, அ - பெயரெச்ச விகுதி."}, "en": {"blocks": [{"type": "text", "content": "Identify the morphological decomposition (Pagupadham) of 'Pozhindha' (poured).", "media_id": null}], "options": {"A": "Pozhi + ndha", "B": "Pozhi + th + a", "C": "Pozhi + th(n) + th + a", "D": "Pozhin + th + a"}, "explanation": "Pozhindha = Pozhi (root) + th[n] (sandhi morphed to n) + th (past infix) + a (adjectival participle suffix)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 116, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 116", "url": null, "source_notes": null}, "previous_ye