{"id": "9th-u5-q102", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "janakiraman-prose-style", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி. ஜானகிராமனின் உரைநடை நடை எவ்வாறு சிறப்பிக்கப்படுகிறது?", "media_id": null}], "options": {"A": "கடினமான வடசொல் நடை", "B": "சொல் நயமும், இசை நயமும், நுட்பமான உணர்ச்சி வெளிப்பாடும் கொண்ட தஞ்சை நடை", "C": "விறைப்பான தத்துவ நடை", "D": "மொழிபெயர்ப்பு நடை"}, "explanation": "தி. ஜானகிராமனின் எழுத்துக்கள் வாசிப்போரைக் கிறங்கடிக்கும் இசை நயமும், மென்மையான உணர்ச்சி வெளிப்பாடுகளும் கொண்ட தஞ்சை மண்ணின் உயிர்ப்பான நடையாகும்."}, "en": {"blocks": [{"type": "text", "content": "How is T. Janakiraman's signature prose style critically characterized?", "media_id": null}], "options": {"A": "Rigid Sanskritic diction", "B": "Melodic resonance, rhythmic nuance, and subtle emotional cadence of the Thanjavur soil", "C": "Pedantic philosophical jargon", "D": "Dry translation prose"}, "explanation": "Janakiraman's prose is celebrated for musical fluidity, lyrical delicacy, and authentic Delta colloquial charm."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_