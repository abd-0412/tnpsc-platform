{"id": "9th-u5-q116", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l4", "chapter_id": null, "topic_id": "vallinam-purpose-meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் மொழியில் வல்லினம் மிகுதலின் இன்றியமையா நோக்கம் யாது?", "media_id": null}], "options": {"A": "எழுத்துகளின் எண்ணிக்கையை அதிகரிக்க", "B": "அலங்காரத்திற்காக மட்டுமே", "C": "சுருக்கமாகப் பேச", "D": "வாக்கியத்தில் கருத்துப் பிழையோ பொருள் மயக்கமோ ஏற்படாமல் துல்லியமான பொருளைத் தர"}, "explanation": "வல்லினம் இட்டும் இடாமலும் எழுதும்போது வாக்கியத்தின் பொருள் முற்றிலுமாக மாறிவிடும். எனவே பொருள் குழப்பம் (பொருள் மயக்கம்) நீக்கிச் சரியான பொருளை உணர்த்துவதே வல்லினம் மிகுதலின் முதன்மை நோக்கமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the paramount functional linguistic purpose of hard consonant doubling (Vallinam Migal) in Tamil?", "media_id": null}], "options": {"A": "To increase character count", "B": "For decorative aesthetics only", "C": "To truncate syllables", "D": "To prevent semantic ambiguity and deliver precise syntactic meaning"}, "explanation": "Correct sandhi gemination prevents semantic confusion (Porul Mayakkam) and ensures syntactic clarity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil