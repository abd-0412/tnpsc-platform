{"id": "9th-u5-q097", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "janakiraman-translations", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி. ஜானகிராமனின் சிறுகதைகள் எந்தெந்த உலக மொழிகளில் மொழிபெயர்க்கப்பட்டுள்ளன?", "media_id": null}], "options": {"A": "ஆங்கிலம், ஜெர்மன், செக் முதலான மொழிகள்", "B": "சீனம், ஜப்பானிய மொழிகள் மட்டும்", "C": "இலத்தீன், கிரேக்கம் மட்டும்", "D": "எந்த மொழியிலும் மொழிபெயர்க்கப்படவில்லை"}, "explanation": "தி. ஜானகிராமனின் கதை மாந்தர்களின் உலகளாவிய உணர்வு வெளிப்பாட்டின் காரணமாக அவரது சிறுகதைகள் ஆங்கிலம், ஜெர்மன், செக் உள்ளிட்ட பல்வேறு உலக மொழிகளில் மொழிபெயர்க்கப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Into which major world languages have T. Janakiraman's short stories been translated?", "media_id": null}], "options": {"A": "English, German, Czech, and other languages", "B": "Chinese and Japanese only", "C": "Latin and Greek only", "D": "None at all"}, "explanation": "Janakiraman's literary works have been translated into English, German, Czech, and other world tongues."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "e