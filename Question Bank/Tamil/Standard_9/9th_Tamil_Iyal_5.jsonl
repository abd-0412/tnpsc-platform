{"id": "9th-u5-q059", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l2", "chapter_id": null, "topic_id": "ravana-kaviyam-anna-quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"இராவண காவியம் காலத்தின் விளைவு; ஆராய்ச்சியின் அறிகுறி; புரட்சிப் பொறி; உண்மையை உணர வைக்கும் உன்னத நூல்\" - என்று பாராட்டியவர் யார்?", "media_id": null}], "options": {"A": "தந்தை பெரியார்", "B": "திரு. வி. க.", "C": "பேரறிஞர் அண்ணா", "D": "டாக்டர் மு. வரதராசனார்"}, "explanation": "பேரறிஞர் அண்ணா அவர்கள் இராவண காவியத்தின் இலக்கிய ஆய்வு நெறியையும் புரட்சிகரப் பாங்கையும் போற்றி, 'காலத்தின் விளைவு, ஆராய்ச்சியின் அறிகுறி, புரட்சிப் பொறி' என்று சிறப்பித்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "\"Ravana Kaviyam is the outcome of the epoch, a symptom of rational research, a spark of revolution!\" - Who praised the epic thus?", "media_id": null}], "options": {"A": "Thanthai Periyar", "B": "Thiru. V. Ka.", "C": "Perarignar Anna", "D": "Dr. Mu. Varadarajanar"}, "explanation": "Perarignar Anna acclaimed 'Ravana Kaviyam' as a revolutionary intellectual milestone."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": 