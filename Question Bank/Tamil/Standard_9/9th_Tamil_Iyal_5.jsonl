{"id": "9th-u5-q004", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "mamallapuram-unesco", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பல்லவர் காலக் குடைவரைக் கோயில்கள், ஒற்றைக்கல் ரதங்கள் மற்றும் புடைப்புச் சிற்பங்களுக்கு உலகப் புகழ்பெற்ற தலமாக விளங்குவது எது?", "media_id": null}], "options": {"A": "தஞ்சாவூர்", "B": "மதுரை", "C": "சிதம்பரம்", "D": "மாமல்லபுரம் (மகாபலிபுரம்)"}, "explanation": "பல்லவர்களின் கலைக்கோயிலாகத் திகழும் மாமல்லபுரத்தில் பஞ்சபாண்டவர் ரதங்கள், கடற்கரைக் கோயில் மற்றும் உலகப் புகழ்பெற்ற அர்ச்சுனன் தபசு புடைப்புச் சிற்பங்கள் அமைந்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Which site stands globally celebrated for Pallava monolithic rathas, cave sanctuaries, and open-air bas-relief panels?", "media_id": null}], "options": {"A": "Thanjavur", "B": "Madurai", "C": "Chidambaram", "D": "Mamallapuram (Mahabalipuram)"}, "explanation": "Mamallapuram is the paramount jewel of Pallava architecture, famous for monolithic chariots, cave temples, and relief panels."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 10