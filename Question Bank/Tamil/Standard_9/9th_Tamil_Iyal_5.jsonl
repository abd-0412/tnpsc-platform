{"id": "9th-u5-q124", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l4", "chapter_id": null, "topic_id": "vallinam-urichol", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'சால, தவ' முதலிய உரிச்சொற்களுக்குப் பின் வல்லினம் என்னவாகும்?", "media_id": null}], "options": {"A": "மெல்லினம் மிகும்", "B": "இடையினம் மிகும்", "C": "வல்லினம் மிகாது", "D": "வல்லினம் மிகும் (சாலப் பேசினான், தவப் பெரிது)"}, "explanation": "'சால', 'தவ' என்னும் உரிச்சொற்களுக்குப் பின் வல்லினம் மிகும். எ.கா: சால + சிறந்தது = சாலச் சிறந்தது; தவ + பெரிது = தவப் பெரிது."}, "en": {"blocks": [{"type": "text", "content": "What sandhi rule applies after qualitative qualifying particles (Urichol) like 'Saala' and 'Thava'?", "media_id": null}], "options": {"A": "Nasals double", "B": "Medial consonants double", "C": "Plosives do not double", "D": "Plosives obligatorily double (Saalach chirandhadhu, Thavap peridhu)"}, "explanation": "Following 'Saala' and 'Thava', plosive doubling is mandatory."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 130, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 13