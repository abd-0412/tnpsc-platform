{"id": "9th-u5-q103", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "seidhai-raga-reference", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'செய்தி' கதையில் நாதசுவரத்தில் இசைக்கப்படும் அதிகாலைக்குரிய மங்கல ராகம் எது?", "media_id": null}], "options": {"A": "ஆனந்தபைரவி", "B": "கல்யாணி", "C": "பூபாளம்", "D": "காம்போதி"}, "explanation": "விடியற்காலையின் அமைதியையும் கதிரவனின் உதயத்தையும் உணர்த்தும் வகையில் அதிகாலையில் இசைக்கப்படும் ராகமாக 'பூபாளம்' கதையில் இடம்பெறுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which dawn Raga is played on the Nadaswaram in the story evoking early morning serenity?", "media_id": null}], "options": {"A": "Anandabhairavi", "B": "Kalyani", "C": "Boopalam", "D": "Kambhoji"}, "explanation": "Raga Boopalam is the classical dawn melody referenced in the narrative."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 119, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 119", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null