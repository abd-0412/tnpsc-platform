{"id": "9th-u5-q083", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l2", "chapter_id": null, "topic_id": "ravana-kaviyam-palai-lines", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெயில் கொடுமையால் நிலம் பிளந்து கிடக்க, நிழலின்றி விலங்குகள் தவிக்கும் மணல் சார்ந்த வறண்ட நிலமாக விவரிக்கப்படும் நிலம் எது?", "media_id": null}], "options": {"A": "குறிஞ்சி", "B": "முல்லை", "C": "பாலை", "D": "நெய்தல்"}, "explanation": "குறிஞ்சியும் முல்லையும் முறைமையில் திரிந்து வெப்பம் மிகுந்து காணப்படும் வறண்ட பகுதி 'பாலை நிலம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which arid desolate tract is described with cracked earth and shade-starved creatures under scorching solar heat?", "media_id": null}], "options": {"A": "Kurinji", "B": "Mullai", "C": "Palai (Arid wasteland)", "D": "Neithal"}, "explanation": "Palai is portrayed as the arid wilderness transformed from withered Kurinji and Mullai tracts."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 115, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 115", "url": null, "source_notes": null}, "previous_