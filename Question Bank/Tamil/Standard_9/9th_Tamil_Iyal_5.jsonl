{"id": "9th-u5-q120", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l4", "chapter_id": null, "topic_id": "vallinam-uvamaithogai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'உவமைத்தொகையில்' வல்லினம் மிகுவதற்குச் சரியான எடுத்துக்காட்டு எது?", "media_id": null}], "options": {"A": "பவளவாய்", "B": "கயல்விழி", "C": "மதிமுகம்", "D": "மலர்க்கை (மலர் + கை = மலர்க்கை)"}, "explanation": "உவமைத்தொகையில் வல்லினம் மிகும். எ.கா: மலர் போன்ற கை = மலர்க்கை; தாமரை போன்ற கண் = தாமரைக்கண்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following serves as an accurate exemplar of plosive gemination in a Simile Compound (Uvamaith-thogai)?", "media_id": null}], "options": {"A": "Pavalavaai", "B": "Kayalvizhi", "C": "Mathimugam", "D": "Malarkkai (Malar + kai = Malarkkai)"}, "explanation": "In Uvamaith-thogai, plosives double: Malar + kai = Malarkkai (hand soft like a flower)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 130, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 130", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_5", "grammar", "uvamaithogai"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u5-q121", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l4", "chapter_id": null, "topic_id": "vallinam-irupeyarettu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'இருபெயரொட்டுப் பண்புத்தொகையில்' வல்லினம் மிகுவதற்குரிய சான்று எது?", "media_id": null}], "options": {"A": "மல்லிகைப் பூ (மல்லிகை + பூ)", "B": "செந்தாமரை", "C": "கருங்குவளை", "D": "இன்மொழி"}, "explanation": "சிறப்புப்பெயர் முன்னும் பொதுப்பெயர் பின்னும் அமைந்து வரும் இருபெயரொட்டுப் பண்புத்தொகையில் வல்லினம் மிகும். எ.கா: மல்லிகைப் பூ, சாரைப் பாம்பு, தைத்திங்கள்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following exemplifies mandatory plosive gemination in a Binomial Quality Compound (Irupeyarettu Panbuth-thogai)?", "media_id": null}], "options": {"A": "Malligaip poo (Jasmine flower)", "B": "Senthaamarai", "C": "Karungkuvalai", "D": "Inmozhi"}, "explanation": "Binomial noun combinations (specific name + generic noun) double plosives: Malligai + poo = Malligaip poo."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 130, "chapter": null, "section": null, "reference": "9th Tamil, Uni