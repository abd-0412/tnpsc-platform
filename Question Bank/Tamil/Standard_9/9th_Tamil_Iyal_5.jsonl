{"id": "9th-u5-q135", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l4", "chapter_id": null, "topic_id": "vallinam-fourth-case-example", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"அவனுக்குக் கொடு\" என்னும் தொடரில் 'க்' மிகுந்துள்ளதற்கான காரணம் யாது?", "media_id": null}], "options": {"A": "இரண்டாம் வேற்றுமை விரி", "B": "சுட்டுத் திரிபு", "C": "நான்காம் வேற்றுமை விரி ('கு' உருபு வெளிப்பட்டு வந்துள்ளது)", "D": "உரிச்சொல் தொடர்"}, "explanation": "'அவனுக்கு' என்பதில் 'கு' என்னும் நான்காம் வேற்றுமை உருபு வெளிப்படையாக (விரிந்து) வந்துள்ளதால் அதனை அடுத்து வரும் வல்லினம் மிகுந்தது (அவனுக்குக் கொடு)."}, "en": {"blocks": [{"type": "text", "content": "Why does the plosive stop 'k' double in the phrase \"Avanukkuk kodu\"?", "media_id": null}], "options": {"A": "Accusative case expansion", "B": "Demonstrative mutation", "C": "Overt dative case expansion ('ku' suffix)", "D": "Qualitative particle phrase"}, "explanation": "The dative suffix '-ku' is overtly present, triggering mandatory plosive gemination."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 129, "chapter": null, "sect