{"id": "9th-u5-q070", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l2", "chapter_id": null, "topic_id": "ravana-kaviyam-mullai-lines", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆயர்கள் புல்லாங்குழல் ஊத, மான்களும் மாடுகளும் துள்ளி மகிழும் காடு சார்ந்த நிலமாக இராவண காவியம் எதனை விவரிக்கிறது?", "media_id": null}], "options": {"A": "குறிஞ்சி", "B": "முல்லை", "C": "பாலை", "D": "மருதம்"}, "explanation": "காடும் காடு சார்ந்த முல்லை நிலத்தில் ஆயர்கள் குழலிசைத்து ஆநிரைகளை மேய்க்கும் காட்சியும், முல்லை மலர் மணமும் அழகாகப் பாடப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Which forest-scrub landscape is depicted with shepherds piping flutes while deer and cattle leap merrily?", "media_id": null}], "options": {"A": "Kurinji", "B": "Mullai", "C": "Palai", "D": "Marutham"}, "explanation": "Mullai represents the pastoral tract where flute melodies accompany grazing livestock."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 114", "url": null, "source_notes": null}, "previous_year": {"is_pr