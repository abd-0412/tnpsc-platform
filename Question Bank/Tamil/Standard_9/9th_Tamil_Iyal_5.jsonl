{"id": "9th-u5-q077", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l2", "chapter_id": null, "topic_id": "ravana-kaviyam-hero", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இராவண காவியத்தின் முதன்மைக் காப்பியத் தலைவன் யார்?", "media_id": null}], "options": {"A": "இராவணன்", "B": "இராமன்", "C": "கும்பகர்ணன்", "D": "வீடணன்"}, "explanation": "கம்பராமாயணத்தில் எதிர்நிலைப் பாத்திரமாக வரும் இராவணனையே இந்நூலில் முதன்மைக் கதாநாயகனாகப் புலவர் குழந்தை படைத்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who is the primary central protagonist of the epic 'Ravana Kaviyam'?", "media_id": null}], "options": {"A": "Ravana", "B": "Rama", "C": "Kumbhakarna", "D": "Vibhishana"}, "explanation": "Ravana is the noble hero and central titular figure in Pulavar Kuzhandhai's epic."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 114", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_med