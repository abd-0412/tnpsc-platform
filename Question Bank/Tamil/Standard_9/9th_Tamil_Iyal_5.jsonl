{"id": "9th-u5-q140", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l4", "chapter_id": null, "topic_id": "vallinam-letters-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் இலக்கணத்தில் உள்ள மெய்யெழுத்துகளில் வல்லின மெய்களின் மொத்த எண்ணிக்கை எத்தனை?", "media_id": null}], "options": {"A": "நான்கு", "B": "எட்டு", "C": "பத்து", "D": "ஆறு (க், ச், ட், த், ப், ற்)"}, "explanation": "வல்லின மெய்யெழுத்துகள் மொத்தம் 6 (க், ச், ட், த், ப், ற்). இவற்றுள் சொல்லுக்கு முதலில் வரும் க், ச், த், ப் ஆகிய நான்கு எழுத்துகள் மட்டுமே புணர்ச்சியில் வல்லினம் மிகுதலுக்கு உரியவை ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the total count of hard consonants (Vallinam) in the Tamil phonetic alphabet?", "media_id": null}], "options": {"A": "Four", "B": "Eight", "C": "Ten", "D": "Six (k, c, t, th, p, r - க், ச், ட், த், ப், ற்)"}, "explanation": "There are 6 Vallinam consonants, of which the four initial-occurring stops (k, c, th, p) geminate at word junctions."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 129, "chapter": null, "section": null, "reference": "9th Tamil,