{"id": "9th-u5-q018", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "thirumayam-sculpture", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புதுக்கோட்டை மாவட்டம் திருமயத்தில் உள்ள குடைவரைக் கோயிலில் பாறையில் செதுக்கப்பட்டுள்ள பிரம்மாண்டமான சிற்பம் எது?", "media_id": null}], "options": {"A": "காலசம்ஹார மூர்த்தி", "B": "அனந்தசயனப் பெருமாள் (பள்ளிகொண்ட பெருமாள்)", "C": "கங்காதரர்", "D": "அர்த்தநாரீசுவரர்"}, "explanation": "புதுக்கோட்டை மாவட்டம் திருமயம் குடைவரைக் கோயிலில் பாறையிலேயே வடிக்கப்பட்ட மாபெரும் அனந்தசயன மூர்த்தி (பள்ளிகொண்ட பெருமாள்) சிற்பம் பாண்டியர் காலச் சிற்பக்கலையின் மாபெரும் சாதனையாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which colossal rock-cut reclining posture is sculpted into the cave shrine of Thirumayam in Pudukkottai?", "media_id": null}], "options": {"A": "Kalasamhara Murti", "B": "Ananthasayana Perumal (Reclining Vishnu)", "C": "Gangadhara", "D": "Ardhanarisvara"}, "explanation": "The monumental reclining Ananthasayana Vishnu carved in relief inside the Thirumayam cave is a masterwork of Pandya rock carvers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9",