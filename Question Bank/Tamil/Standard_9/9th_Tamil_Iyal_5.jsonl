{"id": "9th-u5-q006", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "kanchi-kailasanathar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பல்லவர் காலக் கட்டுமானக் கோயில்களில் சுதைச் சிற்பங்களும் கல் சிற்பங்களும் ஒருங்கே அமையப்பெற்ற புகழ்பெற்ற கோயில் எது?", "media_id": null}], "options": {"A": "தஞ்சைப் பெரிய கோயில்", "B": "காஞ்சி கைலாசநாதர் கோயில்", "C": "மதுரை மீனாட்சி கோயில்", "D": "பேரூர் பட்டீசுவரர் கோயில்"}, "explanation": "காஞ்சிபுரத்தில் உள்ள கைலாசநாதர் கோயில் பல்லவர் காலக் கட்டுமானக் கோயிலாகும். இதில் எண்ணற்ற கற்றளிச் சிற்பங்களும், கலைநயம் மிக்க சுதைச் சிற்பங்களும் நிறைந்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Which renowned temple stands as an archetype of Pallava structural sandstone architecture adorned with exquisite stone and stucco sculptures?", "media_id": null}], "options": {"A": "Thanjavur Brihadisvara Temple", "B": "Kanchi Kailasanathar Temple", "C": "Madurai Meenakshi Temple", "D": "Perur Patteeswarar Temple"}, "explanation": "Kanchi Kailasanathar Temple, built by Pallava king Rajasimha, represents the zenith of early stone structural temples enriched with sculptures."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil 