{"id": "9th-u5-q049", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "buddhist-sculptures-tn", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழகத்தில் பௌத்த மதச் சிற்பங்கள் கண்டெடுக்கப்பட்டுள்ள முக்கிய ஊர்களுள் ஒன்று எது?", "media_id": null}], "options": {"A": "நாகப்பட்டினம்", "B": "சேலம்", "C": "ஈரோடு", "D": "திண்டுக்கல்"}, "explanation": "நாகப்பட்டினம் சோழர் காலத்தில் பௌத்த மதத்தின் முக்கிய மையமாக விளங்கியது. அங்கு சூடாமணி விகாரை அமைந்திருந்ததுடன் ஏராளமான புத்தரின் வெண்கலச் சிற்பங்கள் கண்டெடுக்கப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Which historic coastal town in Tamil Nadu is renowned for the archaeological excavation of numerous ancient Buddhist bronze sculptures?", "media_id": null}], "options": {"A": "Nagapattinam", "B": "Salem", "C": "Erode", "D": "Dindigul"}, "explanation": "Nagapattinam flourished as a major Buddhist maritime hub during Chola times, yielding exquisite bronze Buddha statues."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 112, "chapter": null, "section": null, "reference": "9th Tamil,