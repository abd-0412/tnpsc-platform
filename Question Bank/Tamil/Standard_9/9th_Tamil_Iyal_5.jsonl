{"id": "9th-u5-q106", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "seidhai-listener-response", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கலைஞன் வாசிக்கும் நாதசுவர இசையைக் கேட்கும் ரசிகர்கள் எத்தகைய நிலையை அடைகின்றனர்?", "media_id": null}], "options": {"A": "பய உணர்வு அடைகின்றனர்", "B": "தங்களை மறந்து மெய்மறந்து இசைவெள்ளத்தில் திளைக்கின்றனர்", "C": "சலிப்படைந்து வெளியேறுகின்றனர்", "D": "தூங்கி விடுகின்றனர்"}, "explanation": "தூய இசையானது கேட்போரின் உலகியல் கவலைகளை அகற்றி, அவர்களை மெய்மறக்கச் செய்து ஆன்மப் பேரின்பத்தில் திளைக்க வைக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What state of consciousness do listeners experience while immersed in the maestro's Nadaswaram recital?", "media_id": null}], "options": {"A": "Dread and agitation", "B": "Sublime self-forgetfulness and ecstatic aesthetic absorption", "C": "Boredom and departure", "D": "Slumber"}, "explanation": "Authentic artistic music dissolves worldly burdens, transporting listeners into transcendental absorption."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page