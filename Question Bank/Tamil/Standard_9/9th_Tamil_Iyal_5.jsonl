{"id": "9th-u5-q060", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l2", "chapter_id": null, "topic_id": "pulavar-kuzhandhai-thirukkural", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தந்தை பெரியாரின் வேண்டுகோளுக்கு இணங்க, எத்தனை நாள்களில் புலவர் குழந்தை திருக்குறளுக்கு உரை எழுதினார்?", "media_id": null}], "options": {"A": "30 நாள்கள்", "B": "40 நாள்கள்", "C": "50 நாள்கள்", "D": "25 நாள்கள்"}, "explanation": "தந்தை பெரியாரின் விருப்பத்திற்கு இணங்க புலவர் குழந்தை அவர்கள் வெறும் 25 நாள்களில் திருக்குறள் முழுமைக்கும் எளிய இனிய உரை எழுதி முடித்தார்."}, "en": {"blocks": [{"type": "text", "content": "In how many days did Pulavar Kuzhandhai write a complete commentary on the Thirukkural upon the request of Thanthai Periyar?", "media_id": null}], "options": {"A": "30 days", "B": "40 days", "C": "50 days", "D": "25 days"}, "explanation": "Pulavar Kuzhandhai authored a lucid commentary on the entire Thirukkural within a record 25 days following Periyar's request."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 117, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, P