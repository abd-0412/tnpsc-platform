{"id": "9th-u5-q017", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "sculpture-definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கண்ணால் கண்டு ரசிக்கும் கலைகளில் உருவத்தை முப்பரிமாண வடிவில் செதுக்கும் நுண்கலை எது?", "media_id": null}], "options": {"A": "சிற்பக்கலை", "B": "ஓவியக்கலை", "C": "இசைக்கலை", "D": "நாடகக்கலை"}, "explanation": "கல்லிலும் உலோகத்திலும் மரத்திலும் உருவங்களை முப்பரிமாணமாகச் செதுக்கி வடிக்கும் நுட்பமான அழகியல் கலை சிற்பக்கலை ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which fine art renders aesthetic physical forms in three-dimensional dimensional spatial reality?", "media_id": null}], "options": {"A": "Sculptural art (Sirpakkalai)", "B": "Painting", "C": "Music", "D": "Theatre"}, "explanation": "Sculpture is the classical three-dimensional spatial visual art form manifested across rock, metal, and wood."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 108, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 108", "url": null, "source_notes": null}, "previous_year": {"is_previou