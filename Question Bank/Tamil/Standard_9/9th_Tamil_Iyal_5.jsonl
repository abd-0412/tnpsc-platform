{"id": "9th-u5-q127", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l4", "chapter_id": null, "topic_id": "vallinam-fractions", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'அரை, பாதி' போன்ற பின்னச் சொற்களுக்குப் பின் வல்லினம் என்னவாகும்?", "media_id": null}], "options": {"A": "வல்லினம் மிகாது", "B": "மெல்லினம் மிகும்", "C": "வல்லினம் மிகும் (அரைக்கிலோ, பாதிப்பங்கு)", "D": "இடையினம் மிகும்"}, "explanation": "'அரை', 'பாதி' போன்ற பின்னப் பெயர்களுக்குப் பின் வரும் வல்லினம் கண்டிப்பாக மிகும். எ.கா: அரை + கிலோ = அரைக்கிலோ; பாதி + பங்கு = பாதிப்பங்கு."}, "en": {"blocks": [{"type": "text", "content": "What sandhi change occurs after fractional nouns such as 'Arai' (half) and 'Paadhi' (portion)?", "media_id": null}], "options": {"A": "Plosives do not double", "B": "Nasals double", "C": "Plosives obligatorily double (e.g., Araikkilo, Paadhippangu)", "D": "Medials double"}, "explanation": "Fractional terms 'arai' and 'paadhi' cause mandatory plosive doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 130, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 130", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_5", "grammar", "fractions"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u5-q128", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l4", "chapter_id": null, "topic_id": "vallinam-semantic-contrast-velai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"வேலை கொடுத்தான்\" என்பதற்கும் \"வேலைக் கொடுத்தான்\" என்பதற்கும் இடையே உள்ள பொருள் வேறுபாடு யாது?", "media_id": null}], "options": {"A": "இரண்டும் வேலை வாய்ப்பைக் குறிக்கும்", "B": "இரண்டும் வேலாயுதத்தைக் குறிக்கும்", "C": "முதலாவது ஆயுதத்தையும், இரண்டாவது பணியையும் குறிக்கும்", "D": "முதலாவது பணியைக் கொடுத்ததையும் (பணி), இரண்டாவது வேல் என்னும் ஆயுதத்தைக் கொடுத்ததையும் குறிக்கும்"}, "explanation": "வல்லினம் மிகாத 'வேலை கொடுத்தான்' என்பது பணியை (job/work) வழங்கியதைக் குறிக்கும். இரண்டாம் வேற்றுமை உருபு வெளிப்பட்டு வல்லினம் மிகும் 'வேலைக் கொடுத்தான்' என்பது வேல் என்னும் ஆயுதத்தைக் கொடுத்ததைக் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "What is the semantic distinction between \"Vaelai koduthaan\" and \"Vaelaik koduthaan\"?", "media_id": null}], "options": {"A": "Both denote employment", "B": "Both denote spear weapons", "C": "The former denotes weapon, the latter employment", "D": "The former denotes assigning work/employment, while the latter denotes handing over the spear weapon"}, "explanation": "Without doubling, 'vaelai' means job/task; with doubling '-k-', 'vael-ai' signifies the weapon spear in the accusative case."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 129, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 129", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_5", "grammar", "semantic_contrast"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u5-q129", "schema_version": "1.0", "kind": "multi_statement", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l4", "chapter_id": null, "topic_id": "vallinam-statements-rules", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வல்லினம் மிகும் இடங்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'அந்த, இந்த, எந்த' ஆகிய சொற்களுக்குப் பின் வல்லினம் மிகும்.\n2. இரண்டாம் மற்றும் நான்காம் வேற்றுமை விரிகளில் வல்லினம் மிகும்.\n3. உவமைத்தொகையிலும் இருபெயரொட்டுப் பண்புத்தொகையிலும் வல்லினம் மிகும்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?", "media_id": null}], "options": {"A": "1, 2, 3 ஆகிய அனைத்தும் சரி", "B": "1 மற்றும் 2 மட்டும் சரி", "C": "2 மற்றும் 3 மட்டும் சரி", "D": "1 மற்றும் 3 மட்டும் சரி"}, "explanation": "கூறப்பட்டுள்ள மூன்று விதிகளும் தமிழ் இலக்கணத்தின்படி வல்லினம் மிகும் அடிப்படையான சரியான விதிகளாகும். எனவே மூன்றும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on hard consonant doubling rules:\n1. Plosives double after 'andha', 'indha', and 'endha'.\n2. Plosives double in overt second and fourth case expansions.\n3. Plosives double in simile compounds and binomial quality compounds.\nWhich are correct?", "media_id": null}], "options": {"A": "All 1, 2, and 3 are correct", "B": "1 and 2 only are correct", "C": "2 and 3 only are correct", "D": "1 and 3 only are correct"}, "explanation": "All three statements represent fundamental, standard Tamil grammatical sandhi rules."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 129, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 129", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_5", "grammar", "multi_statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u5-q130", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l4", "chapter_id": null, "topic_id": "vallinam-mutriyalugaram", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முற்றியலுகரச் சொற்களின் பின் வல்லினம் மிகும் என்பதற்குரிய சரியான சான்று எது?", "media_id": null}], "options": {"A": "நாடு பார்த்தான்", "B": "திருக்குறள் (திரு + குறள்)", "C": "ஆடு கண்டான்", "D": "பாட்டு பாடினான்"}, "explanation": "'திரு' என்பது முற்றியலுகரச் சொல். திரு + குறள் = திருக்குறள் என வல்லினம் மிகுந்துள்ளது. பொது + பணி = பொதுப்பணி."}, "en": {"blocks": [{"type": "text", "content": "Which of the following serves as an accurate exemplar of plosive gemination following a Mutriyalugaram noun?", "media_id": null}], "options": {"A": "Naadu paarthaan", "B": "Thirukkural (Thiru + kural)", "C": "Aadu kandaan", "D": "Paattu paadinaan"}, "explanation": "'Thiru' is a Mutriyalugaram stem where plosive doubling occurs: Thiru + kural = Thirukkural."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 130, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 130", "url": null, "source_note