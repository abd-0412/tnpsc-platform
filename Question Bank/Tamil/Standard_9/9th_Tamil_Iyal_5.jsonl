{"id": "9th-u5-q009", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "sculpture-types-two", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிற்பங்கள் பொதுவாக அவற்றின் வடிவ அமைப்பின் அடிப்படையில் எத்தனை வகையாகப் பிரிக்கப்படுகின்றன?", "media_id": null}], "options": {"A": "இரண்டு வகைகள் (முழு உருவச் சிற்பங்கள், புடைப்புச் சிற்பங்கள்)", "B": "மூன்று வகைகள்", "C": "நான்கு வகைகள்", "D": "ஐந்து வகைகள்"}, "explanation": "சிற்பங்களை உருவ அமைப்பின் அடிப்படையில் இருவகையாகப் பிரிக்கலாம்: 1. முன்புறமும் பின்புறமும் முழுமையாகக் காணக்கூடிய முழு உருவச் சிற்பங்கள் (Round sculptures), 2. முன்பகுதி மட்டும் தெரியும்படி சுவரோடு ஒட்டிச் செதுக்கப்படும் புடைப்புச் சிற்பங்கள் (Relief sculptures)."}, "en": {"blocks": [{"type": "text", "content": "Into how many principal structural forms are sculptures broadly classified based on dimensional execution?", "media_id": null}], "options": {"A": "Two forms (Full round sculptures, Relief sculptures)", "B": "Three forms", "C": "Four forms", "D": "Five forms"}, "explanation": "Sculptures are classified into two broad categories: Free-standing full three-dimensional statues (Round) and projected shallow surface carvings (Bas/High Relief)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 108, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 108", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_5", "sculpture", "classification"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u5-q010", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "sculpture-materials-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திவாகர நிகண்டு சிற்பத் தொழிலுக்குரிய மூலப்பொருள்களாக எத்தனை பொருள்களைக் குறிப்பிடுகிறது?", "media_id": null}], "options": {"A": "எட்டு பொருள்கள்", "B": "பத்து பொருள்கள்", "C": "பன்னிரண்டு பொருள்கள்", "D": "ஆறு பொருள்கள்"}, "explanation": "'பத்தே சிற்பத் தொழிற்கு உறுப்பாவன' என்று திவாகர நிகண்டு கல், உலோகம், செங்கல், மரம், மண், சுதை, தந்தம், வண்ணம், சர்க்கரை, மெழுகு ஆகிய 10 பொருள்களைக் குறிப்பிடுகிறது."}, "en": {"blocks": [{"type": "text", "content": "How many raw materials are enumerated by Divakara Nikandu as the constituents of sculptural craft?", "media_id": null}], "options": {"A": "Eight materials", "B": "Ten materials", "C": "Twelve materials", "D": "Six materials"}, "explanation": "Divakara Nikandu catalogs exactly ten essential substances used for sculpting."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 108, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 108",