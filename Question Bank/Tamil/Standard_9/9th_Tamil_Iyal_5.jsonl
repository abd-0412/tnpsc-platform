{"id": "9th-u5-q139", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l4", "chapter_id": null, "topic_id": "vallinam-kadhavaith-thira", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"கதவைத் திற\" என்னும் தொடரில் 'த்' மிகுந்துள்ளதன் காரணம் யாது?", "media_id": null}], "options": {"A": "நான்காம் வேற்றுமை விரி", "B": "உவமைத்தொகை", "C": "இரண்டாம் வேற்றுமை உருபு 'ஐ' வெளிப்படையாக வந்துள்ளது (கதவு + ஐ)", "D": "சுட்டுத் திரிபு"}, "explanation": "'கதவு + ஐ = கதவை'. இதில் 'ஐ' என்னும் இரண்டாம் வேற்றுமை உருபு வெளிப்படையாக வந்துள்ளதால் நிலைமொழி இறுதியில் 'த்' மிகுந்தது (கதவைத் திற)."}, "en": {"blocks": [{"type": "text", "content": "Why does the plosive stop 'th' double in \"Kadhavaith thira\" (Open the door)?", "media_id": null}], "options": {"A": "Dative case expansion", "B": "Simile compound", "C": "The accusative case marker '-ai' is overtly present (Kadhavu + ai)", "D": "Demonstrative mutation"}, "explanation": "The overt accusative marker '-ai' triggers mandatory plosive doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 129, "chapter": null, "section": null, "reference": 