{"id": "9th-u5-q109", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "seidhai-title-significance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'செய்தி' என்னும் சிறுகதையின் தலைப்பு உணர்த்தும் உட்கருத்து யாது?", "media_id": null}], "options": {"A": "கலையின் மூலம் ஆன்மா மற்றொரு ஆன்மாவுடன் நிகழ்த்தும் அமைதியான உரையாடல்", "B": "செய்தித்தாளில் வரும் செய்திகள்", "C": "அஞ்சல் வழி வரும் கடிதங்கள்", "D": "வானொலிச் செய்திகள்"}, "explanation": "இங்கு 'செய்தி' என்பது அச்சு ஊடகச் செய்தியன்று; கலையின் வழியாக, இசையின் வழியாக மனித இதயங்கள் தங்களுக்குள் பேசிக்கொள்ளும் உயிர்ப்பான மெய்ஞ்ஞானச் செய்தியாகும்."}, "en": {"blocks": [{"type": "text", "content": "What does the symbolic title 'Seidhi' (The Message) imply in this story?", "media_id": null}], "options": {"A": "The silent spiritual communion transmitted from one soul to another through fine art", "B": "Newspaper headlines", "C": "Postal correspondence", "D": "Radio newscasts"}, "explanation": "'Seidhi' represents the wordless spiritual communication forged between souls through musical communion."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term