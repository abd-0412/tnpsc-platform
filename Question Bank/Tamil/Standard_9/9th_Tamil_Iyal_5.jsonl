{"id": "9th-u5-q055", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "sculpture-preservation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழங்காலச் சிற்பங்களைச் சிதைக்காமலும், அவற்றின் மீது பெயிண்ட் பூசாமலும் பாதுகாப்பது நமது எத்தகைய கடமையாகும்?", "media_id": null}], "options": {"A": "சட்ட ரீதியான தண்டனைக்கு அஞ்சுதல் மட்டும்", "B": "அரசாங்க ஊழியர்களின் கடமை மட்டும்", "C": "வரலாற்றுப் பாரம்பரியத்தைப் போற்றிப் பாதுகாக்கும் ஒவ்வொரு குடிமகனின் தலையாய கடமை", "D": "சுற்றுலாப் பயணிகளின் விருப்பம்"}, "explanation": "நம் முன்னோர்களின் கலையுணர்வும் வரலாறும் மிளிரும் பழங்காலச் சிற்பங்களைச் சிதைக்காமலும் கிறுக்காமலும் பாதுகாப்பது நம் ஒவ்வொருவரின் பண்பாட்டு மற்றும் தேசியக் கடமையாகும்."}, "en": {"blocks": [{"type": "text", "content": "Preserving ancient temple sculptures without vandalism or defacing constitutes what civic responsibility?", "media_id": null}], "options": {"A": "Merely avoiding statutory penal action", "B": "Exclusive duty of government sweepers", "C": "A cardinal constitutional and cultural duty of every enlightened citizen", "D": "An optional hobby for tourists"}, "explanation": "Safeguarding sculptural heritage free from disfigurement is the paramount civic and cultural duty of every citizen."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": 