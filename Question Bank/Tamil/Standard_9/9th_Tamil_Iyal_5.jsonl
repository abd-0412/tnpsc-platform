{"id": "9th-u5-q019", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "round-vs-relief", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒரு சிற்பத்தின் முன்பகுதியும் பின்பகுதியும் முழுமையாகத் தெரியும் வண்ணம் அமைக்கப்பட்ட சிற்பம் எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "புடைப்புச் சிற்பம்", "B": "சுதைச் சிற்பம்", "C": "முழு உருவச் சிற்பம்", "D": "கண்ணாடிச் சிற்பம்"}, "explanation": "உருவத்தின் அனைத்துப் பக்கங்களும் (முன்புறம், பின்புறம், பக்கவாட்டு) தெளிவாகத் தெரியும் வண்ணம் வடிவமைக்கப்படுவது 'முழு உருவச் சிற்பம்' (Round sculpture) எனப்படும். சுவரோடு ஒட்டி முன்பக்கம் மட்டும் தெரிவது புடைப்புச் சிற்பம்."}, "en": {"blocks": [{"type": "text", "content": "What is a sculpture termed whose front, back, and all contours are completely carved in full dimensional visibility?", "media_id": null}], "options": {"A": "Relief sculpture", "B": "Stucco sculpture", "C": "Full round sculpture (Muzhu Uruva Sirpam)", "D": "Mirror sculpture"}, "explanation": "A free-standing statue visible from all sides is termed 'Muzhu Uruva Sirpam' (sculpture in the round)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpo