{"id": "9th-u5-q136", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l4", "chapter_id": null, "topic_id": "vallinam-poo-parithaan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பூப்பறித்தான்' என்னும் சொல்லில் 'ப்' மிகுந்துள்ளதற்கான சரியான காரணம் யாது?", "media_id": null}], "options": {"A": "பெயரெச்சத் தொடர்", "B": "வினையெச்சத் தொடர்", "C": "திசைப் பெயர்", "D": "'பூ' என்னும் ஓரெழுத்து ஒருமொழியின் பின் வல்லினம் மிகுந்துள்ளது"}, "explanation": "'பூ' என்பது ஓரெழுத்து ஒருமொழி. ஓரெழுத்து ஒருமொழியை அடுத்து வரும் வல்லினம் மிகும் என்ற விதிப்படி பூ + பறித்தான் = பூப்பறித்தான் என்றானது."}, "en": {"blocks": [{"type": "text", "content": "What grammatical rule accounts for plosive doubling in 'Poopparithaan' (Poo + parithaan)?", "media_id": null}], "options": {"A": "Adjectival participle phrase", "B": "Verbal participle phrase", "C": "Directional noun phrase", "D": "Plosives double following the monosyllabic root noun 'Poo'"}, "explanation": "'Poo' is an Orezhuthu Orumozhi (monosyllabic noun), after which plosive doubling is obligatory."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 13