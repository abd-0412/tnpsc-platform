{"id": "9th-u5-q088", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "janakiraman-foreign-travelogues", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி. ஜானகிராமன் செக்கோஸ்லோவாக்கியா நாட்டுப் பயண அனுபவங்களை விவரித்து எழுதிய பயண நூல் எது?", "media_id": null}], "options": {"A": "நடந்தாய் வாழி காவேரி", "B": "கருங்கடலும் கலைக்கடலும்", "C": "உயிர்த்தேன்", "D": "அடுத்த வீடு ஐம்பது மைல்"}, "explanation": "தி. ஜானகிராமன் செக்கோஸ்லோவாக்கியா நாட்டுப் பயண அனுபவங்களை 'அடுத்த வீடு ஐம்பது மைல்' என்னும் நூலாகவும், உருமேனியப் பயண அனுபவங்களை 'கருங்கடலும் கலைக்கடலும்' என்னும் நூலாகவும் படைத்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which travelogue penned by T. Janakiraman chronicles his travel experiences across Czechoslovakia?", "media_id": null}], "options": {"A": "Nadandhaai Vaazhi Kaveri", "B": "Karunkadalum Kalaikkadalum", "C": "Uyirtthen", "D": "Adutha Veedu Aimbathu Mile"}, "explanation": "'Adutha Veedu Aimbathu Mile' records Janakiraman's impressions of Czechoslovakia, while 'Karunkadalum Kalaikkadalum' records Romania."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full