{"id": "9th-u5-q033", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "nayak-sculptures-features", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழகக் கோயில்களில் 'ஆயிரங்கால் மண்டபங்கள்' அமைத்து, அவற்றில் மிக நுணுக்கமான ஆடை ஆபரண வேலைப்பாடுகளுடன் கூடிய சிற்பங்களை வடித்தவர்கள் யார்?", "media_id": null}], "options": {"A": "நாயக்க மன்னர்கள்", "B": "பல்லவ மன்னர்கள்", "C": "சேர மன்னர்கள்", "D": "பிற்காலச் சோழர்கள்"}, "explanation": "விஜயநகர மற்றும் நாயக்கர் காலத்தில் கோயில்களில் பிரம்மாண்டமான ஆயிரங்கால் மண்டபங்கள், புதுமண்டபங்கள் கட்டப்பட்டு, தூண்களில் குறவன்-குறத்தி, ரதி-மன்மதன், குதிரை வீரர்கள் போன்ற நுணுக்கமான சிற்பங்கள் வடிக்கப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "Who pioneered building monumental Thousand-Pillared Halls (Aayirankaal Mandapam) displaying intricately ornamented sculptures across Tamil Nadu?", "media_id": null}], "options": {"A": "Nayak rulers", "B": "Pallava kings", "C": "Chera monarchs", "D": "Later Cholas"}, "explanation": "Nayak rulers constructed sprawling hypostyle halls featuring hyper-detailed sculptures of celestial dancers, riders, and folk figures."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textboo