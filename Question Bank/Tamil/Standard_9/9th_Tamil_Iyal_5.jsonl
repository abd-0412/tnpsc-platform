{"id": "9th-u5-q007", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "pandya-sculptures-kazhugumalai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தென்னகத்து எல்லோரா' என்று வரலாற்று ஆய்வாளர்களால் சிறப்பிக்கப்படும் பாண்டியர் காலக் குடைவரைக் கோயில் எது?", "media_id": null}], "options": {"A": "சித்தன்னவாசல்", "B": "திருமயம்", "C": "கழுகுமலை வெட்டுவான் கோயில்", "D": "குன்றக்குடி"}, "explanation": "தூத்துக்குடி மாவட்டத்தில் உள்ள கழுகுமலை வெட்டுவான் கோயில் ஒரே பாறையில் மேலிருந்து கீழ்நோக்கிக் குடைந்து வடிக்கப்பட்ட பாண்டியா் காலத்து ஒற்றைக்கற்றளியாகும். இது 'தென்னகத்து எல்லோரா' என அழைக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which Pandya rock-cut monolithic temple carved downwards out of a living rock hillock is celebrated as the 'Ellora of the South'?", "media_id": null}], "options": {"A": "Sittannavasal", "B": "Thirumayam", "C": "Kazhugumalai Vettuvan Koil", "D": "Kundrakudi"}, "explanation": "Vettuvan Koil in Kazhugumalai, Thoothukudi district, sculpted from the top down by Pandya artisans, is famously dubbed the 'Ellora of the South'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation",