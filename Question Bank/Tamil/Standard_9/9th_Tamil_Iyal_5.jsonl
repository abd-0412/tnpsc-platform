{"id": "9th-u5-q045", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "jaina-beds-madurai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மதுரையைச் சுற்றியுள்ள சமணர் மலை, கீழக்குயில்குடி, ஆனைமலை ஆகிய குன்றுகளில் காணப்படும் சிற்பங்களின் வகை எது?", "media_id": null}], "options": {"A": "சமணத் தீர்த்தங்கரர்களின் புடைப்புச் சிற்பங்கள்", "B": "பௌத்த ஸ்தூபிகள்", "C": "நாயக்கர் குதிரைச் சிற்பங்கள்", "D": "செப்புத் திருமேனிகள்"}, "explanation": "மதுரையைச் சுற்றியுள்ள சமணர் மலை, கீழக்குயில்குடி போன்ற மலைக்குன்றுகளில் சமண முனிவர்களின் படுக்கைகளும், தீர்த்தங்கரர்களின் உருவங்களும் பாறைகளில் புடைப்புச் சிற்பங்களாகச் செதுக்கப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "What category of classical relief carvings is preserved across the hills of Samanarmalai, Keelakuyilkudi, and Anaimalai around Madurai?", "media_id": null}], "options": {"A": "Bas-relief carvings of Jaina Tirthankaras and Yakshas", "B": "Buddhist stupas", "C": "Nayak cavalry figures", "D": "Lost-wax bronzes"}, "explanation": "The hills surrounding Madurai house extensive Jaina rock-cut hermitages featuring seated Tirthankara relief carvings."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil N