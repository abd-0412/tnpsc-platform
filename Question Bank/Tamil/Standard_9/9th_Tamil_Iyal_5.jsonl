{"id": "9th-u5-q108", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "janakiraman-literary-value", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி. ஜானகிராமனின் சிறுகதைகள் தமிழ் இலக்கியத்தில் எதற்குச் சிறந்த சான்றாகத் திகழ்கின்றன?", "media_id": null}], "options": {"A": "துப்பறியும் கதைகளுக்கு", "B": "அறிவியல் புனைகதைகளுக்கு", "C": "திகில் கதைகளுக்கு", "D": "மனிதாபிமானமும் கலை நுணுக்கமும் இணைந்த உளவியல் யதார்த்தவாதக் கதைகளுக்கு"}, "explanation": "தி. ஜானகிராமனின் சிறுகதைகள் மனித மனத்தின் ஆழமான உளவியல் சிக்கல்களையும், கலையுணர்வின் மாண்பையும் இயல்பான எளிய நடையில் உணர்த்தும் யதார்த்தவாதப் படைப்புகளாகும்."}, "en": {"blocks": [{"type": "text", "content": "T. Janakiraman's short fiction serves as a paramount exemplar of which literary school?", "media_id": null}], "options": {"A": "Detective whodunits", "B": "Science fiction", "C": "Horror fiction", "D": "Psychological realism infused with deep humanist empathy and artistic subtlety"}, "explanation": "Janakiraman's fiction is celebrated for nuanced psychological realism and compassionate humanism."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "