{"id": "9th-u5-q110", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "janakiraman-travelogue-partner", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி. ஜானகிராமனுடன் இணைந்து 'நடந்தாய் வாழி காவேரி' பயண நூலை எழுதிய 'சிட்டி' அவர்களின் முழுப்பெயர் என்ன?", "media_id": null}], "options": {"A": "சிதம்பரநாதன்", "B": "பி. ஜி. சுந்தரராஜன் (சிட்டி)", "C": "சிவராமகிருஷ்ணன்", "D": "சிங்காரவேலர்"}, "explanation": "'சிட்டி' என்ற புனைபெயரில் எழுதிய புகழ்பெற்ற தமிழறிஞர் மற்றும் விமர்சகரின் முழுப்பெயர் பி. ஜி. சுந்தரராஜன் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What was the full authentic name of the scholar 'Chitti' who co-authored 'Nadandhaai Vaazhi Kaveri' with T. Janakiraman?", "media_id": null}], "options": {"A": "Chidambaranathan", "B": "P. G. Sundararajan (Chitti)", "C": "Sivaramakrishnan", "D": "Singaravelar"}, "explanation": "'Chitti' was the pen name of renowned literary historian and biographer P. G. Sundararajan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 121, "chapter": null, "section": null, "reference": "9th Tamil, Uni