{"id": "9th-u5-q089", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "janakiraman-romania-travelogue", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி. ஜானகிராமன் உருமேனிய (Romania) நாட்டுப் பயண நினைவுகளை எந்த நூலாகத் தொகுத்துள்ளார்?", "media_id": null}], "options": {"A": "கருங்கடலும் கலைக்கடலும்", "B": "அடுத்த வீடு ஐம்பது மைல்", "C": "நடந்தாய் வாழி காவேரி", "D": "சக்தி வைத்தியம்"}, "explanation": "தி. ஜானகிராமனின் உருமேனிய நாட்டுப் பயண நினைவுகளின் தொகுப்பு 'கருங்கடலும் கலைக்கடலும்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Under which title did T. Janakiraman compile his Romanian travel experiences and artistic encounters?", "media_id": null}], "options": {"A": "Karunkadalum Kalaikkadalum", "B": "Adutha Veedu Aimbathu Mile", "C": "Nadandhaai Vaazhi Kaveri", "D": "Sakthi Vaithiyam"}, "explanation": "'Karunkadalum Kalaikkadalum' encapsulates Janakiraman's cultural journey through Romania and the Black Sea region."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 121, "chapter": null, "section": null, "reference": "9th Tam