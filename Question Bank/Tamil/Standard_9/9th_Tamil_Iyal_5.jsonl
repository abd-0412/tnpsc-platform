{"id": "9th-u5-q090", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "janakiraman-novels", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வருவனவற்றுள் தி. ஜானகிராமன் இயற்றிய உலகப் புகழ்பெற்ற நாவல் எது?", "media_id": null}], "options": {"A": "பொன்னியின் செல்வன்", "B": "மோகமுள்", "C": "கோபல்லபுரத்து மக்கள்", "D": "ஒரு புளியமரத்தின் கதை"}, "explanation": "தி. ஜானகிராமனின் முதன்மையான இலக்கிய நாவல்களில் 'மோகமுள்', 'செம்பருத்தி', 'மரப்பசு', 'அம்மா வந்தாள்' போன்றவை குறிப்பிடத்தகுந்தவை."}, "en": {"blocks": [{"type": "text", "content": "Which of the following acclaimed classic novels was written by T. Janakiraman?", "media_id": null}], "options": {"A": "Ponniyin Selvan", "B": "Mogamul", "C": "Gopallapurathu Makkal", "D": "Oru Puliyamarathin Kathai"}, "explanation": "'Mogamul' is T. Janakiraman's magnum opus novel blending Carnatic musical ethos with intricate human relationships."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 121, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 121", "url": null, "source_notes": nul