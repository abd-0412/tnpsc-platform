{"id": "9th-u5-q086", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "janakiraman-sahitya-akademi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி. ஜானகிராமனின் எந்த சிறுகதைத் தொகுப்பிற்கு 1979 ஆம் ஆண்டு சாகித்திய அகாதெமி விருது வழங்கப்பட்டது?", "media_id": null}], "options": {"A": "அன்பளிப்பு", "B": "சக்தி வைத்தியம்", "C": "மோகமுள்", "D": "செம்பருத்தி"}, "explanation": "தி. ஜானகிராமன் எழுதிய 'சக்தி வைத்தியம்' என்னும் சிறுகதைத் தொகுப்பு 1979 ஆம் ஆண்டு சாகித்திய அகாதெமி விருதைப் பெற்றது."}, "en": {"blocks": [{"type": "text", "content": "For which short story anthology was T. Janakiraman awarded the Sahitya Akademi Award in 1979?", "media_id": null}], "options": {"A": "Anbalippu", "B": "Sakthi Vaithiyam", "C": "Mogamul", "D": "Sembaruthi"}, "explanation": "T. Janakiraman's acclaimed short-story collection 'Sakthi Vaithiyam' won the Sahitya Akademi Award in 1979."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 121, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 121", "url": null, "source_notes": null}, "previou