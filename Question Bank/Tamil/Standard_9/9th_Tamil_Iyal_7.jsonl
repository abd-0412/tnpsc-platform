{"id": "9th-u7-q006", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "netaji-blood-quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"இரத்தம் தாருங்கள், உங்களுக்கு நான் சுதந்திரம் தருகிறேன்\" என்று உணர்ச்சிமிகு முழக்கமிட்ட தேசத்தலைவர் யார்?", "media_id": null}], "options": {"A": "மகாத்மா காந்தி", "B": "நேதாஜி சுபாஷ் சந்திர போஸ்", "C": "பகத் சிங்", "D": "வ.உ. சிதம்பரனார்"}, "explanation": "'சுதந்திரத்திற்காக நீங்கள் எனக்கு இரத்தத்தைத் தாருங்கள்; உங்களுக்கு நான் சுதந்திரத்தைப் பெற்றுத் தருகிறேன்' என்று நேதாஜி முழங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "Which patriot famously proclaimed: 'Give me blood, and I will give you freedom'?", "media_id": null}], "options": {"A": "Mahatma Gandhi", "B": "Netaji Subhas Chandra Bose (நேதாஜி)", "C": "Bhagat Singh", "D": "V.O. Chidambaranar"}, "explanation": "Netaji's unforgettable clarion call to Indians abroad was: 'Give me blood, and I promise you freedom!'"}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 131, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Pag