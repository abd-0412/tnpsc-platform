{"id": "9th-u7-q031", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "tokyo-cadets-training", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நேதாஜியால் டோக்கியோ இராணுவக் கல்லூரிக்கு அனுப்பி வைக்கப்பட்ட 'டோக்கியோ கேடட்ஸ்' பெற்ற பயிற்சிகள் எவை?", "media_id": null}], "options": {"A": "குதிரையேற்றம் மட்டுமே", "B": "வணிக நிர்வாகப் பயிற்சி", "C": "வானூர்தி ஓட்டுநர் மற்றும் நவீனப் போர் உத்திகள் பயிற்சி", "D": "வேளாண்மைப் பயிற்சி"}, "explanation": "டோக்கியோ இராணுவக் கல்லூரியில் தீவிர போர்முறை, நவீன ஆயுதப் பயன்பாடு மற்றும் வானூர்தி ஓட்டுநர் (Fighter pilot) உள்ளிட்ட சிறப்புப் பயிற்சிகளை 45 இளைஞர்கள் பெற்றனர்."}, "en": {"blocks": [{"type": "text", "content": "What sophisticated military skills were imparted to the 45 'Tokyo Cadets' sent by Netaji to Tokyo?", "media_id": null}], "options": {"A": "Only horse riding", "B": "Business administration", "C": "Aviation fighter piloting and modern warfare tactics", "D": "Agricultural training"}, "explanation": "The Tokyo Cadets underwent advanced military academy training including aviation piloting, artillery, and modern tactics."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpor