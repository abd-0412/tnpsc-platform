{"id": "9th-u7-q048", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "netaji-provisional-gov-currency", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நேதாஜியின் ஆசாத் ஹிந்த் தற்காலிக அரசு எவற்றைத் தனக்கெனத் தனித்துவமாக அமைத்து நிர்வகித்தது?", "media_id": null}], "options": {"A": "சொந்த நாணயம் மற்றும் தபால்தலைகள்", "B": "நீதிமன்றங்கள் மற்றும் வானொலி நிலையம்", "C": "இராணுவப் படைகள் மற்றும் தேசியக் கொடி", "D": "மேற்கண்ட அனைத்தும் (நாணயம், தபால்தலை, வானொலி, இராணுவம், அமைச்சரவை)"}, "explanation": "நேதாஜி அமைத்த தற்காலிக அரசு தனக்கென சொந்த நாணயம், அஞ்சல்தலைகள், ஆசாத் ஹிந்த் வானொலி, தேசிய வங்கி மற்றும் முப்படைகளைக் கொண்டு ஒரு முழுமையான இறையாண்மை அரசாகச் செயல்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which sovereign institutions did Netaji's Provisional Government of Free India maintain independently?", "media_id": null}], "options": {"A": "Own currency and postage stamps", "B": "Judicial courts and Azad Hind Radio", "C": "Armed defense forces and national tricolor flag", "D": "All the above (Currency, stamps, radio, armed forces, national bank)"}, "explanation": "The Azad Hind government established complete state infrastructure: its own currency notes, stamps, radio, national bank, and military."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answe