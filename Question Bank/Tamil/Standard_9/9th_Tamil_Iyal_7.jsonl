{"id": "9th-u7-q106", "schema_version": "1.0", "kind": "conceptual", "level": "analysis", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "muthollayiram-true-false", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்தொள்ளாயிரம் பற்றிய கூற்றுகளை ஆராய்க:\nI. இந்நூல் சேர, சோழ, பாண்டிய மூவேந்தர்களைப் பாடுகிறது.\nII. இது ஆசிரியப்பாவால் இயற்றப்பட்டது.\nIII. இதன் 108 பாடல்கள் புறத்திரட்டு வழியாகக் கிடைத்துள்ளன.", "media_id": null}], "options": {"A": "கூற்று I, II, III அனைத்தும் சரி", "B": "கூற்று I, III சரி; கூற்று II தவறு (வெண்பா)", "C": "கூற்று I மட்டும் சரி", "D": "கூற்று II மட்டும் சரி"}, "explanation": "கூற்று I மற்றும் III சரி. கூற்று II தவறு; ஏனெனில் முத்தொள்ளாயிரம் 'வெண்பா' யாப்பால் பாடப்பட்டது (ஆசிரியப்பா அன்று)."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Muthollayiram:\nI. It sings praises of the Three Monarchs.\nII. It is composed in Aasiriyappa meter.\nIII. 108 verses are preserved via Purathirattu.", "media_id": null}], "options": {"A": "Statements I, II, and III are all correct", "B": "Statements I and III are correct; statement II is incorrect (Composed in Venba)", "C": "Only statement I is correct", "D": "Only statement II is correct"}, "explanation": "Statements I and III are true. Statement II is incorrect as Muthollayiram is composed in Venba meter, not Aasiriyappa."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "ne