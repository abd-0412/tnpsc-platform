{"id": "9th-u7-q110", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "pandya-pearl-world-trade", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாண்டிய நாட்டு முத்துகளை விரும்பி வாங்கிய பண்டைய மேலைநாட்டு வணிகர்கள் யார்?", "media_id": null}], "options": {"A": "ஆங்கிலேயர்கள்", "B": "ரோமானிய மற்றும் கிரேக்க (யவன) வணிகர்கள்", "C": "போர்ச்சுகீசியர்கள்", "D": "டச்சுக்காரர்கள்"}, "explanation": "கொற்கைத் துறைமுகத்தில் விளைந்த உயர்ந்த முத்துகளை உரோமானிய, கிரேக்க (யவன) வணிகர்கள் கப்பல்களில் பொன்னைக் கொடுத்து வாங்கிச் சென்றனர்."}, "en": {"blocks": [{"type": "text", "content": "Which ancient Western seafaring merchants avidly imported the prized pearls of the Pandyan coast in exchange for gold?", "media_id": null}], "options": {"A": "The British", "B": "Roman and Greek (Yavana) traders (ரோமானியர், யவனர்)", "C": "Portuguese navigators", "D": "Dutch merchants"}, "explanation": "Classical Greco-Roman (Yavana) records corroborate the immense maritime trade in Korkai pearls."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "sectio