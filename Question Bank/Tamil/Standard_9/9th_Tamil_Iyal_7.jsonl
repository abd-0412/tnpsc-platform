{"id": "9th-u7-q090", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "muthollayiram-century", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்தொள்ளாயிரத்தின் காலம் எதுவென வரலாற்று ஆய்வாளர்கள் கருதுகின்றனர்?", "media_id": null}], "options": {"A": "கி.மு. மூன்றாம் நூற்றாண்டு", "B": "கி.பி. ஐந்தாம் நூற்றாண்டு", "C": "கி.பி. பத்தாம் நூற்றாண்டு", "D": "கி.பி. பதினைந்தாம் நூற்றாண்டு"}, "explanation": "நூலின் நடை, மொழி மற்றும் வரலாற்றுச் சான்றுகளின் அடிப்படையில் முத்தொள்ளாயிரத்தின் காலம் 'கி.பி. ஐந்தாம் நூற்றாண்டு' எனக் கருதப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "To which century do literary historians ascribe the composition of Muthollayiram?", "media_id": null}], "options": {"A": "3rd Century BCE", "B": "5th Century CE (கி.பி. ஐந்தாம் நூற்றாண்டு)", "C": "10th Century CE", "D": "15th Century CE"}, "explanation": "Scholars date Muthollayiram to around the 5th Century CE."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 137", "url": null, "sour