{"id": "9th-u7-q085", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "muthollayiram-meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'முத்தொள்ளாயிரம்' என்னும் நூல் யாரைப் போற்றிப் பாடப்பட்ட பாடல்களின் தொகுப்பாகும்?", "media_id": null}], "options": {"A": "சேர, சோழ, பாண்டியர் என்னும் மூவேந்தர்கள்", "B": "கடை ஏழு வள்ளல்கள்", "C": "பல்லவ மன்னர்கள் மட்டுமே", "D": "நாயக்க மன்னர்கள் மட்டுமே"}, "explanation": "சேரர், சோழர், பாண்டியர் ஆகிய தமிழ் மூவேந்தர்களைப் பற்றி பாடப்பட்ட 900 பாடல்களின் தொகுப்பே முத்தொள்ளாயிரம் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "In praise of which triumvirate rulers was the classical anthology 'Muthollayiram' composed?", "media_id": null}], "options": {"A": "The Three Crowned Kings - Chera, Chola, and Pandya (மூவேந்தர்கள்)", "B": "The Seven Philanthropists (Vallalgal)", "C": "Pallava kings only", "D": "Nayaka rulers only"}, "explanation": "Muthollayiram is an anthology singing the heroic and aesthetic glories of the three Tamil monarchs: Cheras, Cholas, and Pandyas."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024