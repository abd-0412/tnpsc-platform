{"id": "9th-u7-q075", "schema_version": "1.0", "kind": "application", "level": "application", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l2", "chapter_id": null, "topic_id": "ilakkana-kurippu-seikolam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'செய்கோலம்' என்னும் சொல்லின் இலக்கணக் குறிப்பு எது?", "media_id": null}], "options": {"A": "பெயரெச்சம்", "B": "வினையெச்சம்", "C": "வினைத்தொகை", "D": "வேற்றுமைத்தொகை"}, "explanation": "செய்த கோலம், செய்கின்ற கோலம், செய்யும் கோலம் என முக்காலமும் மறைந்து நிற்கும் வினையடியாக வந்ததால் 'செய்கோலம்' என்பது 'வினைத்தொகை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the grammatical designation of the word 'Seikolam' (செய்கோலம்)?", "media_id": null}], "options": {"A": "Peyarecham (Relative participle)", "B": "Vinaiyecham (Adverbial participle)", "C": "Vinaithogai (வினைத்தொகை - Three-tense verb compound)", "D": "Vetttrumaithogai"}, "explanation": "'Seikolam' incorporates past, present, and future verbal nuances, classifying it as Vinaithogai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 136, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 136", "url":