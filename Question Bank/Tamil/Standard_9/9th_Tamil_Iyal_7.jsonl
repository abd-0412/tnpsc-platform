{"id": "9th-u7-q036", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "chennai-jail-hanged-youths-reason", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சென்னை மத்திய சிறையில் 18 இளைஞர்கள் ஆங்கிலேயரால் தூக்கிலிடப்பட்டதன் முக்கிய காரணம் என்ன?", "media_id": null}], "options": {"A": "கொள்ளையடித்ததால்", "B": "வரி கட்ட மறுத்ததால்", "C": "பொதுச்சொத்தை அழித்ததால்", "D": "இந்திய தேசிய இராணுவத்தின் ஒற்றர்படையிலும் விடுதலைப் போரிலும் தாய்நாட்டிற்காகப் பங்காற்றியதால்"}, "explanation": "ஆங்கிலேய இராணுவத்தின் இரகசியங்களை உளவு அறிந்து, இந்திய எல்லைக்குள் புகுந்து விடுதலைக்காகப் போராடிய குற்றத்திற்காக அவர்களை ஆங்கில அரசு தூக்கிலிட்டது."}, "en": {"blocks": [{"type": "text", "content": "What was the reason behind the colonial British government's execution of the 18 INA youths in Chennai jail?", "media_id": null}], "options": {"A": "Dacoity", "B": "Tax evasion", "C": "Vandalism of public assets", "D": "Serving in the INA intelligence corps and waging revolutionary struggle for India's liberation"}, "explanation": "They were tried for treason by British court-martials because they operated as patriotic intelligence operatives for the INA."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Ka