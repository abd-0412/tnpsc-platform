{"id": "9th-u7-q024", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "provisional-gov-year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிங்கப்பூரில் நேதாஜி சுபாஷ் சந்திர போஸ் 'ஆசாத் ஹிந்த்' (சுதந்திர இந்தியாவின் தற்காலிக அரசு) அமைத்த ஆண்டு எது?", "media_id": null}], "options": {"A": "1940", "B": "1941", "C": "1942", "D": "1943 அக்டோபர் 21"}, "explanation": "1943-ஆம் ஆண்டு அக்டோபர் 21-ஆம் நாள் சிங்கப்பூரில் நேதாஜி சுபாஷ் சந்திர போஸ் சுதந்திர இந்தியாவின் தற்காலிக அரசை நிறுவினார்."}, "en": {"blocks": [{"type": "text", "content": "On which date did Netaji establish the Provisional Government of Free India (Azad Hind) in Singapore?", "media_id": null}], "options": {"A": "1940", "B": "1941", "C": "1942", "D": "October 21, 1943 (1943 அக்டோபர் 21)"}, "explanation": "On October 21, 1943, Netaji proclaimed the formation of the Provisional Government of Free India in Singapore."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 132, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 132", "url": null, "source_notes": null},