{"id": "9th-u7-q108", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "three-monarchs-collective-title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் மண்ணை ஆண்ட சேர, சோழ, பாண்டிய மன்னர்களைத் தமிழ் இலக்கியங்கள் ஒன்றிணைத்து எவ்வாறு அழைக்கின்றன?", "media_id": null}], "options": {"A": "கடை ஏழு வள்ளல்கள்", "B": "ஐம்பெருங்குழுவினர்", "C": "எண்பேராயத்தினர்", "D": "மூவேந்தர்கள்"}, "explanation": "பண்டைத் தமிழ்நாட்டின் மூன்று பெரும்பகுதிகளையும் ஆட்சி புரிந்த சேர, சோழ, பாண்டிய மன்னர்கள் 'மூவேந்தர்கள்' என்று அழைக்கப்பட்டனர்."}, "en": {"blocks": [{"type": "text", "content": "What collective honorific title do classical Tamil literary traditions accord to the Chera, Chola, and Pandya monarchs?", "media_id": null}], "options": {"A": "The Seven Philanthropists", "B": "The Fivefold Royal Council", "C": "The Eightfold Executive Body", "D": "Moovendhargal (மூவேந்தர்கள் - The Three Crowned Kings)"}, "explanation": "The Chera, Chola, and Pandya sovereigns are immortalized in Tamil literature as the 'Moovendhargal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025