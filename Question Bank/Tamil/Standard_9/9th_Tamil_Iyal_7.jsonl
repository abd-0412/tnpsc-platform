{"id": "9th-u7-q078", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l2", "chapter_id": null, "topic_id": "mu-va-quote-virutham", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"தமிழிலக்கிய வரலாற்றில் ஒன்பதாம் நூற்றாண்டில் விருத்தம் என்ற புதிய செய்யுள் வகையைப் பயன்படுத்தி மூவாயிரத்துக்கும் மேற்பட்ட பாடல்கள் கொண்ட காப்பியம் பாடியவர் திருத்தக்கதேவர்\" - எனக் குறிப்பிட்ட தமிழறிஞர் யார்?", "media_id": null}], "options": {"A": "உ.வே. சாமிநாதையர்", "B": "டாக்டர் மு. வரதராசனார்", "C": "மறைமலையடிகள்", "D": "பாரதிதாசன்"}, "explanation": "விருத்தப்பாவால் காப்பியம் இயற்றிய திருத்தக்கதேவரின் இலக்கியப் புரட்சியைப் பாடநூலில் புகழ்ந்துரைத்தவர் டாக்டர் மு. வரதராசனார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Which eminent Tamil scholar praised Thiruthakkadevar for introducing Virutham meter to compose over 3,000 epic verses in the 9th Century?", "media_id": null}], "options": {"A": "U.Ve. Swaminatha Iyer", "B": "Dr. Mu. Varadarajanar (மு. வரதராசனார்)", "C": "Maraimalai Adigal", "D": "Bharathidasan"}, "explanation": "Dr. Mu. Varadarajanar documented and commended Thiruthakkadevar's pioneering genius in Virutham verse."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educ