{"id": "9th-u7-q077", "schema_version": "1.0", "kind": "application", "level": "application", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l2", "chapter_id": null, "topic_id": "pagupadham-ombuvar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஓம்புவார்' என்னும் சொல்லின் சரியான பகுபத உறுப்பிலக்கணப் பிரிப்பு எது?", "media_id": null}], "options": {"A": "ஓம்பு + வ் + ஆர்", "B": "ஓம்புவ் + ஆர்", "C": "ஓம் + பு + ஆர்", "D": "ஓம்பு + ஆர்"}, "explanation": "ஓம்புவார் = ஓம்பு + வ் + ஆர். (ஓம்பு - பகுதி; வ் - எதிர்கால இடைநிலை; ஆர் - பலர்பால் வினைமுற்று விகுதி)."}, "en": {"blocks": [{"type": "text", "content": "What is the correct morphological split for the word 'Ombuvaar' (ஓம்புவார்)?", "media_id": null}], "options": {"A": "Ombu + v + Aar (ஓம்பு + வ் + ஆர்)", "B": "Ombuv + Aar", "C": "Om + pu + Aar", "D": "Ombu + Aar"}, "explanation": "Ombu (root) + v (future tense medial) + Aar (epicene third-person plural suffix)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 136, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 136", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null,