{"id": "9th-u7-q082", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l2", "chapter_id": null, "topic_id": "jainism-thiruthakkadevar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருத்தக்கதேவர் எந்தச் சமயத்தைச் சார்ந்த துறவி?", "media_id": null}], "options": {"A": "பௌத்த சமயம்", "B": "சமண சமயம்", "C": "சைவ சமயம்", "D": "வைணவ சமயம்"}, "explanation": "திருத்தக்கதேவர் சமண சமயத்தைச் (Jainism) சார்ந்த துறவி ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "To which ancient religious tradition did the ascetic poet Thiruthakkadevar belong?", "media_id": null}], "options": {"A": "Buddhism", "B": "Jainism (சமண சமயம்)", "C": "Saivism", "D": "Vaishnavism"}, "explanation": "Thiruthakkadevar was a revered Jain monk-poet who composed the epic to prove that ascetic Jainism could yield vibrant poetic art."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 136, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 136", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "se