{"id": "9th-u7-q071", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l2", "chapter_id": null, "topic_id": "sollum-porulum-veri-kazhani-iriya", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வெறி', 'கழனி', 'இரிய' ஆகிய சொற்களுக்குரிய பொருள்களின் சரியான வரிசை எது?", "media_id": null}], "options": {"A": "கோபம், காடு, நின்றுகொள்ள", "B": "வேகம், தோட்டம், பாய", "C": "மணம், வயல், ஓட", "D": "மயக்கம், ஆறு, குதிக்க"}, "explanation": "'வெறி' என்றால் நறுமணம்; 'கழனி' என்றால் வயல்; 'இரிய' என்றால் அஞ்சி ஓட என்பது பொருளாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the correct sequence of meanings for 'Veri' (வெறி), 'Kazhani' (கழனி), and 'Iriya' (இரிய)?", "media_id": null}], "options": {"A": "Anger, Forest, Stand", "B": "Speed, Garden, Leap", "C": "Fragrance, Agricultural field, Run/Flee (மணம், வயல், ஓட)", "D": "Faint, River, Jump"}, "explanation": "'Veri' signifies sweet fragrance, 'Kazhani' means fertile field, and 'Iriya' means to disperse/flee."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 134, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Pag