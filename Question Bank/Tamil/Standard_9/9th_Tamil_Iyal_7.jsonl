{"id": "9th-u7-q042", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "pasumpon-thevar-netaji-statue", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நேதாஜி சுபாஷ் சந்திர போஸ் அவர்கள் மதுரைக்கு வருகை தந்து மாபெரும் பொதுக்கூட்டத்தில் உரையாற்றக் காரணமாக இருந்த தமிழகத் தலைவர் யார்?", "media_id": null}], "options": {"A": "பாரதியார்", "B": "பசும்பொன் முத்துராமலிங்கத் தேவர்", "C": "சுப்பிரமணிய சிவா", "D": "வ.வே.சு. ஐயர்"}, "explanation": "முத்துராமலிங்கத் தேவரின் அழைப்பை ஏற்று நேதாஜி மதுரைக்கு வருகை தந்து மாபெரும் மக்கள் கூட்டத்தில் எழுச்சியுரை ஆற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Which charismatic Tamil Nadu leader invited Netaji to Madurai and hosted his historic mammoth public address?", "media_id": null}], "options": {"A": "Bharathiyar", "B": "Pasumpon Muthuramalingathevar (முத்துராமலிங்கத் தேவர்)", "C": "Subramanya Siva", "D": "V.V.S. Iyer"}, "explanation": "On the personal invitation of Pasumpon Muthuramalingathevar, Netaji visited Madurai where thousands gathered to hear him."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-202