{"id": "9th-u7-q007", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "provisional-gov-tamil-ministers", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நேதாஜி அமைத்த தற்காலிக அரசில் (Provisional Government) அமைச்சர்களாகப் பணியாற்றிய தமிழர்கள் யார்?", "media_id": null}], "options": {"A": "வ.உ.சி மற்றும் சுப்பிரமணிய பாரதியார்", "B": "ராஜாஜி மற்றும் காமராசர்", "C": "கேப்டன் லட்சுமி மற்றும் சிதம்பரம் லோகநாதன்", "D": "பசும்பொன் தேவர் மற்றும் கக்கன்"}, "explanation": "நேதாஜி அமைத்த தற்காலிக அரசில் டாக்டர் கேப்டன் லட்சுமி மற்றும் சிதம்பரம் லோகநாதன் முதலான தமிழர்கள் முக்கிய அமைச்சர்களாகப் பதவி வகித்தனர்."}, "en": {"blocks": [{"type": "text", "content": "Which prominent Tamils served as cabinet ministers in the Provisional Government of Free India established by Netaji?", "media_id": null}], "options": {"A": "V.O.C and Subramanya Bharathiyar", "B": "Rajaji and Kamarajar", "C": "Captain Lakshmi and Chidambaram Lokanathan (கேப்டன் லட்சுமி, சிதம்பரம் லோகநாதன்)", "D": "Pasumpon Muthuramalingathevar and Kakkan"}, "explanation": "Captain Dr. Lakshmi and Chidambaram Lokanathan served as key ministers in Netaji's Azad Hind provisional government."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 132, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 132", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_7", "ina", "ministers"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u7-q008", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "tokyo-cadets-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்திய தேசிய இராணுவத்தில் சிறந்த போர்வீரர்களை உருவாக்கும் நோக்கில் நேதாஜி எத்தனை இளைஞர்களைத் டோக்கியோவிற்குப் போர் பயிற்சிக்கு அனுப்பினார்?", "media_id": null}], "options": {"A": "100 இளைஞர்கள்", "B": "18 இளைஞர்கள்", "C": "25 இளைஞர்கள்", "D": "45 இளைஞர்கள் (டோக்கியோ கேடட்ஸ்)"}, "explanation": "சிறந்த போர் வீரர்களை உருவாக்க நேதாஜி 45 இளைஞர்களைத் டோக்கியோவிற்குப் போர் பயிற்சிக்கு அனுப்பினார். அவர்களுள் பெரும்பாலோர் தமிழர்கள் ஆவர்."}, "en": {"blocks": [{"type": "text", "content": "How many select youth did Netaji dispatch to Tokyo for elite military academy cadet training (Tokyo Cadets)?", "media_id": null}], "options": {"A": "100 cadets", "B": "18 cadets", "C": "25 cadets", "D": "45 cadets (45 இளைஞர்கள் - டோக்கியோ கேடட்ஸ்)"}, "explanation": "Netaji handpicked 45 brilliant youngsters, predominantly Tamils, for rigorous military academy training in Tokyo, known as Tokyo Cadets."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition":