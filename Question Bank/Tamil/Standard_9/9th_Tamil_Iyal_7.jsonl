{"id": "9th-u7-q146", "schema_version": "1.0", "kind": "pyq", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l2", "chapter_id": null, "topic_id": "pyq-mananool-epic", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] 'மணநூல்' என்னும் சிறப்புப் பெயரால் அழைக்கப்பெறும் ஐம்பெருங்காப்பியம் எது?", "media_id": null}], "options": {"A": "சிலப்பதிகாரம்", "B": "சீவக சிந்தாமணி", "C": "மணிமேகலை", "D": "குண்டலகேசி"}, "explanation": "சீவகன் எட்டு மங்கையரை மணமுடித்த காப்பியப் பின்னணியைக் கொண்டுள்ளதால் சீவக சிந்தாமணி 'மணநூல்' எனப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Which of the five great Tamil epics is popularly hailed by the unique title 'Mananool' (The Book of Marriages)?", "media_id": null}], "options": {"A": "Silappadikaram", "B": "Sivaka Chinthamani (சீவக சிந்தாமணி)", "C": "Manimekalai", "D": "Kundalakesi"}, "explanation": "Sivaka Chinthamani is canonically known as 'Mananool' due to the eight marriages celebrated in its cantos."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 136, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 136", "url": null, "source_no