{"id": "9th-u7-q102", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "pandya-king-names", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்தொள்ளாயிரப் பாடல்களில் பாண்டிய மன்னனைக் குறிக்கும் பெயர்கள் எவை?", "media_id": null}], "options": {"A": "கிள்ளி, சோழன்", "B": "மாறன், செழியன், தென்னன்", "C": "சேரலாதன், கோதை", "D": "கரிகாலன், மனுநீதி"}, "explanation": "பாண்டிய மன்னனை மாறன், செழியன், தென்னன், வழுதி ஆகிய பெயர்களால் முத்தொள்ளாயிரம் போற்றுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which regal titles designate the Pandya ruler in Muthollayiram poems?", "media_id": null}], "options": {"A": "Killi and Cholan", "B": "Maaran, Sezhiyan, and Thennan (மாறன், செழியன், தென்னன்)", "C": "Cheralathan and Kodhai", "D": "Karikalan and Manuneethi"}, "explanation": "Pandya kings are apostrophized as Maaran, Sezhiyan, and Thennan (Lord of the South)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 137", "url": null, "source_notes": null}, "previous_year": {"is_pr