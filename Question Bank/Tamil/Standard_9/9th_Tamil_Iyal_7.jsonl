{"id": "9th-u7-q067", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l2", "chapter_id": null, "topic_id": "sollum-porulum-thengu-varukkai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தெங்கு', 'வருக்கை' ஆகிய சொற்களுக்குரிய சரியான பொருள்களைத் தேர்க:", "media_id": null}], "options": {"A": "வாழைப்பழம், மாம்பழம்", "B": "பாக்கு, நெல்", "C": "தேங்காய், பலாப்பழம்", "D": "கரும்பு, தேன்"}, "explanation": "'தெங்கு' என்றால் தேங்காய்; 'வருக்கை' என்றால் பலாப்பழம் என்று பொருள்."}, "en": {"blocks": [{"type": "text", "content": "Select the correct meanings for the classical Tamil words 'Thengu' (தெங்கு) and 'Varukkai' (வருக்கை):", "media_id": null}], "options": {"A": "Banana, Mango", "B": "Areca nut, Paddy", "C": "Coconut, Jackfruit (தேங்காய், பலாப்பழம்)", "D": "Sugarcane, Honey"}, "explanation": "'Thengu' refers to coconut, while 'Varukkai' signifies sweet ripe jackfruit."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 134, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 134", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam"