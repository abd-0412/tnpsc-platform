{"id": "9th-u7-q055", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "seychelles-independent-india", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கேப்டன் தாசன் செசல்ஸ் நாட்டுத் தூதுவராகப் பணியாற்றிய போது இந்தியா எந்நிலையில் இருந்தது?", "media_id": null}], "options": {"A": "பிரிட்டிஷ் காலனி ஆதிக்கத்தில்", "B": "முகலாயர் ஆட்சியில்", "C": "சுதந்திர இந்தியாவில் (விடுதலை பெற்ற இறையாண்மை இந்தியாவில்)", "D": "டச்சுக்காரர் ஆட்சியில்"}, "explanation": "INA வீரரான கேப்டன் தாசன் பின்பு விடுதலை பெற்ற 'சுதந்திர இந்தியாவில்' செசல்ஸ் நாட்டுக்கான இந்தியத் தூதுவராக நியமிக்கப்பட்டுப் பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "During which sovereign era did Captain Dasan serve as the Indian ambassador to Seychelles?", "media_id": null}], "options": {"A": "Under British colonial occupation", "B": "During Mughal rule", "C": "In independent sovereign India (சுதந்திர இந்தியாவில்)", "D": "Under Dutch administration"}, "explanation": "Following national independence, Captain Dasan was appointed as free India's diplomatic ambassador to Seychelles."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class":