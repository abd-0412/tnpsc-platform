{"id": "9th-u7-q111", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "muthollayiram-name-etymology", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'முத்தொள்ளாயிரம்' என்னும் பெயரின் சொற்பிரிப்பு எது?", "media_id": null}], "options": {"A": "முத்து + தொள்ளாயிரம்", "B": "முதுமை + தொள்ளாயிரம்", "C": "மூன்று + தொள்ளாயிரம்", "D": "முழுமை + தொள்ளாயிரம்"}, "explanation": "'முத்தொள்ளாயிரம்' என்பது மூன்று + தொள்ளாயிரம் எனப் பிரியும்; மூன்று மன்னர்களைப் பற்றிய 900 பாடல்கள் என்பது இதன் பொருளாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the precise morphological division of the title compound 'Muthollayiram'?", "media_id": null}], "options": {"A": "Muthu + Thollayiram", "B": "Mudhumai + Thollayiram", "C": "Moondru + Thollayiram (மூன்று + தொள்ளாயிரம்)", "D": "Muzhumai + Thollayiram"}, "explanation": "The compound splits into 'Moondru' (Three) + 'Thollayiram' (Nine hundred), denoting 900 verses on the three monarchs."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 137", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_7", "muthollayiram", "etymology"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u7-q112", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "muthollayiram-summary-lesson", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்தொள்ளாயிரம் கற்பதன் மூலம் நாம் அறிந்துகொள்ளும் தலையாய வரலாறு எது?", "media_id": null}], "options": {"A": "வானியல் ஆய்வுகள்", "B": "மரபணு மாற்றங்கள்", "C": "நவீன கணினித் தொழில்நுட்பம்", "D": "பண்டைத் தமிழ் மூவேந்தர்களின் ஆட்சிச் சிறப்பு, கொடி, சின்னங்கள், போர்த் திறம் மற்றும் இயற்கை வளம்"}, "explanation": "முத்தொள்ளாயிரப் பாடல்கள் பண்டைய தமிழகத்தின் பெருமைக்குரிய சேர, சோழ, பாண்டிய மூவேந்தர்களின் வீரம், தலைநகரங்கள், கொடிகள், மாலைகள் மற்றும் பண்பாட்டுச் சிறப்புகளை அறிய உதவுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What vital historic knowledge is gained through the literary study of Muthollayiram?", "media_id": null}], "options": {"A": "Astronomy research", "B": "Genetics and biotechnology", "C": "Modern computational electronics", "D": "The governance, martial valor, royal emblems, flags, capitals, and natural opulence of the ancient Tamil Three Monarchs"}, "explanation": "Muthollayiram offers authentic historical and literary insights into the power, statecraft, and heraldry of the Cheras, Cholas, and Pandyas."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": 