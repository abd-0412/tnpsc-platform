{"id": "9th-u7-q059", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l2", "chapter_id": null, "topic_id": "sivaka-chinthamani-ilambagam-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சீவக சிந்தாமணி எத்தனை 'இலம்பகங்களை' (உட்பிரிவுகளை)க் கொண்டு அமைந்துள்ளது?", "media_id": null}], "options": {"A": "10 இலம்பகங்கள்", "B": "12 இலம்பகங்கள்", "C": "13 இலம்பகங்கள்", "D": "18 இலம்பகங்கள்"}, "explanation": "சீவக சிந்தாமணி 'இலம்பகம்' என்ற உட்பிரிவுகளைக் கொண்டது; இந்நூல் மொத்தம் 13 இலம்பகங்களைக் கொண்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Into how many 'Ilambagams' (major cantos/sections) is the epic Sivaka Chinthamani structured?", "media_id": null}], "options": {"A": "10 Ilambagams", "B": "12 Ilambagams", "C": "13 Ilambagams (13 இலம்பகங்கள்)", "D": "18 Ilambagams"}, "explanation": "The epic Sivaka Chinthamani is divided into precisely 13 Ilambagams (cantos), starting with Namagal Ilambagam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 136, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 136", "url": null, "source_notes": null}, "prev