{"id": "9th-u7-q043", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "ina-singapore-monument", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிங்கப்பூரில் நேதாஜியால் அடிக்கல் நாட்டப்பட்ட வரலாற்றுப் பெருமை வாய்ந்த நினைவுச் சின்னம் எது?", "media_id": null}], "options": {"A": "காந்தி நினைவு மண்டபம்", "B": "விக்டோரியா அரண்மனை", "C": "இந்திய தேசிய இராணுவ தியாகிகள் நினைவுச் சின்னம் (INA War Memorial)", "D": "அசோக தூண்"}, "explanation": "1945-இல் சிங்கப்பூரில் இந்திய தேசிய இராணுவத்தில் வீரமரணமடைந்த வீரர்களுக்காக நேதாஜியால் INA நினைவுச் சின்னம் நிறுவப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which monument of profound historic significance had its foundation laid by Netaji in Singapore?", "media_id": null}], "options": {"A": "Gandhi Memorial Hall", "B": "Victoria Palace", "C": "INA War Memorial (இந்திய தேசிய இராணுவ தியாகிகள் நினைவுச் சின்னம்)", "D": "Ashoka Pillar"}, "explanation": "Netaji laid the foundation stone for the INA War Memorial in Singapore in 1945 dedicated to fallen martyrs."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025