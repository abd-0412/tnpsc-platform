{"id": "9th-u7-q026", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "netaji-weekly-magazine-thevar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பசும்பொன் முத்துராமலிங்கத் தேவர் விடுதலை வேட்கையை ஊட்டத் தாம் நடத்திய வார இதழுக்கு வைத்த பெயர் என்ன?", "media_id": null}], "options": {"A": "இந்தியா", "B": "நேதாஜி", "C": "விடுதலை", "D": "சுதேசமித்திரன்"}, "explanation": "முத்துராமலிங்கத் தேவர் தம் தலைவரான நேதாஜியின் பெயரிலேயே 'நேதாஜி' என்னும் வார இதழைத் தொடங்கி தேசபக்திக் கருத்துகளை மக்களிடையே பரப்பினார்."}, "en": {"blocks": [{"type": "text", "content": "What was the name of the nationalist weekly periodical founded and run by Pasumpon Muthuramalingathevar to kindle patriotism?", "media_id": null}], "options": {"A": "India", "B": "Netaji (நேதாஜி)", "C": "Viduthalai", "D": "Swadesamitran"}, "explanation": "Pasumpon Muthuramalingathevar published the fiery nationalist journal titled 'Netaji'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 133, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 133", "url": null, "sourc