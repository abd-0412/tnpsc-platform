{"id": "9th-u7-q029", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "ina-women-sacrifice", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜான்சி ராணி படைப்பிரிவில் தமிழ் பெண்கள் ஆற்றிய முதன்மையான பங்களிப்பு யாது?", "media_id": null}], "options": {"A": "ஆண்களுக்கு நிகராகத் துப்பாக்கி ஏந்தி போர்க்களத்தில் வீரப்போர் புரிந்தனர்", "B": "சமையல் பணி மட்டுமே செய்தனர்", "C": "மருத்துவச் சீருடை அணிந்து பார்வையாளர்களாக நின்றனர்", "D": "கடிதங்கள் எழுதும் பணியை மட்டும் செய்தனர்"}, "explanation": "ஜான்சி ராணி மகளிர் படைப்பிரிவில் பெண்கள் துப்பாக்கி ஏந்தி, கடுமையான இராணுவப் பயிற்சிகளைப் பெற்று ஆண்களுக்கு நிகராகப் போர்க்களத்தில் போரிட்டனர்."}, "en": {"blocks": [{"type": "text", "content": "What was the primary frontline contribution of Tamil women in the Rani of Jhansi Regiment?", "media_id": null}], "options": {"A": "Bearing arms and fighting fearlessly on the frontlines on par with male soldiers", "B": "Serving only as kitchen cooks", "C": "Standing by as mere medical spectators", "D": "Engaging purely in clerical letter writing"}, "explanation": "Women soldiers in the Rani of Jhansi Regiment underwent rigorous combat drills and fought valiantly on the battlegrounds."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tam