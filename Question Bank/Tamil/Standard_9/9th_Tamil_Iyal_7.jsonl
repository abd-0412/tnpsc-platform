{"id": "9th-u7-q083", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l2", "chapter_id": null, "topic_id": "sivaka-chinthamani-last-ilambagam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சீவக சிந்தாமணியின் இறுதி இலம்பகம் (13-வது இலம்பகம்) எது?", "media_id": null}], "options": {"A": "நாமகள் இலம்பகம்", "B": "கனகமாலையார் இலம்பகம்", "C": "முத்தி இலம்பகம்", "D": "பதுமையார் இலம்பகம்"}, "explanation": "சீவக சிந்தாமணியின் முதல் இலம்பகம் 'நாமகள் இலம்பகம்'; இறுதி இலம்பகம் சீவகன் முக்தி அடைவதைக் கூறும் 'முத்தி இலம்பகம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the 13th and final concluding Ilambagam of the epic Sivaka Chinthamani?", "media_id": null}], "options": {"A": "Namagal Ilambagam", "B": "Kanakamalaiyar Ilambagam", "C": "Mukthi Ilambagam (முத்தி இலம்பகம்)", "D": "Padumaiyar Ilambagam"}, "explanation": "The epic culminates in Mukthi Ilambagam, which describes king Sivakan's supreme renunciation and attainment of spiritual liberation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 136, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 136", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_7", "sivaka_chinthamani", "mukthi_ilambagam"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u7-q084", "schema_version": "1.0", "kind": "conceptual", "level": "analysis", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l2", "chapter_id": null, "topic_id": "sivaka-chinthamani-true-false", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சீவக சிந்தாமணி பற்றிய கூற்றுகளை ஆராய்க:\nI. இது விருத்தப்பாவால் இயற்றப்பட்ட முதல் காப்பியமாகும்.\nII. இந்நூல் 13 இலம்பகங்களைக் கொண்டுள்ளது.\nIII. இதன் ஆசிரியர் இளங்கோவடிகள் ஆவார்.", "media_id": null}], "options": {"A": "கூற்று I, II, III அனைத்தும் சரி", "B": "கூற்று I மட்டும் சரி", "C": "கூற்று II மட்டும் சரி", "D": "கூற்று I, II சரி; கூற்று III தவறு"}, "explanation": "கூற்று I மற்றும் II சரி. கூற்று III தவறு; ஏனெனில் சீவக சிந்தாமணியின் ஆசிரியர் திருத்தக்கதேவர் ஆவார் (இளங்கோவடிகள் சிலப்பதிகாரத்தின் ஆசிரியர்)."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements regarding Sivaka Chinthamani:\nI. It is the first Tamil epic composed in Virutham meter.\nII. It contains 13 Ilambagams.\nIII. Its author is Ilango Adigal.", "media_id": null}], "options": {"A": "Statements I, II, and III are all correct", "B": "Only statement I is correct", "C": "Only statement II is correct", "D": "Statements I and II are correct; statement III is incorrect (Author is Thiruthakkadevar)"}, "explanation": "Statements I and II are factually correct. Statement III is false because Thiruthakkadevar authored Sivaka Chinthamani, whereas Ilango Adigal authored Silappadikaram."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 136, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 136", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_7", "sivaka_chinthamani", "analytical"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

