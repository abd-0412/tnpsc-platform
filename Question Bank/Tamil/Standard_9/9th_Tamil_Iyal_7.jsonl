{"id": "9th-u7-q039", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "captain-lakshmi-background", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜான்சி ராணி படைப்பிரிவின் தளபதியான டாக்டர் லட்சுமி சுவாமிநாதன் எந்தப் பெருநகரில் பிறந்து வளர்ந்தவர்?", "media_id": null}], "options": {"A": "மதுரை", "B": "கோயம்புத்தூர்", "C": "சென்னை", "D": "திருச்சி"}, "explanation": "டாக்டர் கேப்டன் லட்சுமி சுவாமிநாதன் சென்னையில் புகழ்பெற்ற குடும்பத்தில் பிறந்து, சென்னை மருத்துவக் கல்லூரியில் எம்.பி.பி.எஸ் பட்டம் பெற்றுப் பின்னர் சிங்கப்பூரில் மருத்துவராகப் பணியாற்றியவர்."}, "en": {"blocks": [{"type": "text", "content": "In which historic metropolis was Dr. Captain Lakshmi Swaminathan born and educated in medicine?", "media_id": null}], "options": {"A": "Madurai", "B": "Coimbatore", "C": "Chennai (சென்னை)", "D": "Tiruchirappalli"}, "explanation": "Dr. Captain Lakshmi was born in Chennai, earned her MBBS degree from Madras Medical College, and migrated to Singapore."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 132, "chapter": null, "section": null, "refe