{"id": "9th-u7-q047", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "ina-tamil-martyrs-spirit", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இராமு, அப்துல் காதர் முதலான INA தியாகிகளின் மரண வாக்குமூலங்கள் வெளிப்படுத்தும் பொதுவான உணர்வு யாது?", "media_id": null}], "options": {"A": "மரணம் குறித்த பேரச்சம்", "B": "தனிநபர் புகழ் நாட்டம்", "C": "தாய்நாட்டின் சுதந்திரத்திற்காகத் தன்னுயிரையும் இன்முகத்துடன் துறக்கும் அஞ்சாமை", "D": "ஆங்கிலேயரிடம் மன்னிப்புக் கோருதல்"}, "explanation": "மரணத்தின் வாசலில் நின்றபோதும் சற்றும் அஞ்சாமல் இந்திய விடுதலைக்காக உயிர்த்தியாகம் செய்வதில் பெருமை கொண்ட அஞ்சாத வீரமே அவர்தம் வாக்குமூலமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What overarching sentiment do the final statements of INA martyrs Ramu and Abdul Kader reflect?", "media_id": null}], "options": {"A": "Morbid dread of impending death", "B": "Craving for personal notoriety", "C": "Fearless willingness to lay down their lives joyfully for mother India's liberation", "D": "Petitioning the British for clemency"}, "explanation": "Both martyrs faced the gallows with serene smiles, unyielding dignity, and sublime devotion to India's freedom."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nad