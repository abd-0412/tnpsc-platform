{"id": "9th-u7-q037", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "ina-second-world-war-context", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்திய தேசிய இராணுவத்தின் எழுச்சி உலக வரலாற்றில் எப்போரின் போது நிகழ்ந்தது?", "media_id": null}], "options": {"A": "இரண்டாம் உலகப்போர் (1939-1945)", "B": "முதலாம் உலகப்போர் (1914-1918)", "C": "சிப்பாய்க் கலகம் (1857)", "D": "பிளாசிப் போர் (1757)"}, "explanation": "இரண்டாம் உலகப்போர் காலகட்டத்தில்தான் (1942-1945) கிழக்கு ஆசியாவில் இந்திய தேசிய இராணுவம் மாபெரும் சக்தியாக உருவெடுத்தது."}, "en": {"blocks": [{"type": "text", "content": "During which global military conflict did the historic emergence and zenith of the Indian National Army occur?", "media_id": null}], "options": {"A": "World War II (1939-1945 - இரண்டாம் உலகப்போர்)", "B": "World War I (1914-1918)", "C": "Sepoy Mutiny (1857)", "D": "Battle of Plassey (1757)"}, "explanation": "The INA was mobilized during World War II across Malaya, Singapore, and Burma between 1942 and 1945."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 130, "cha