{"id": "9th-u7-q109", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "chera-kuda-nadu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சேர மன்னன் ஆண்ட மேற்கு நிலப்பகுதி சங்க காலத்தில் எவ்வாறு அழைக்கப்பட்டது?", "media_id": null}], "options": {"A": "குடநாடு", "B": "புனல் நாடு", "C": "தொண்டை நாடு", "D": "பாண்டி நாடு"}, "explanation": "சேர மன்னன் ஆண்ட மேற்குத் தொடர்ச்சி மலை சார்ந்த நிலப்பகுதி 'குடநாடு' (மேற்கு நாடு) என அழைக்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "How was the western coastal and mountainous kingdom of the Cheras designated during the Sangam era?", "media_id": null}], "options": {"A": "Kudanadu (குடநாடு - The Western Realm)", "B": "Punal Nadu", "C": "Thondai Nadu", "D": "Pandya Nadu"}, "explanation": "The Chera dominion was called Kudanadu ('Kuda' meaning West in classical Tamil)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 137", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "