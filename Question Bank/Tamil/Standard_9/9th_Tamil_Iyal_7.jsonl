{"id": "9th-u7-q054", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "tamil-lesson-title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒன்பதாம் வகுப்புத் தமிழ் உரைநடைப் பகுதியான 'இந்திய தேசிய இராணுவத்தில் தமிழர் பங்கு' என்னும் பாடத்தின் ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "தி. ஜானகிராமன்", "B": "மா. சு. அண்ணாமலை", "C": "கந்தர்வன்", "D": "வைரமுத்து"}, "explanation": "'இந்திய தேசிய இராணுவத்தில் தமிழர் பங்கு' என்ற உரைநடைப் பகுதியை எழுதியவர் பேராசிரியர் மா. சு. அண்ணாமலை ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the Class 9 Tamil prose chapter titled 'Role of Tamils in the Indian National Army'?", "media_id": null}], "options": {"A": "T. Janakiraman", "B": "Ma. Su. Annamalai (மா. சு. அண்ணாமலை)", "C": "Kandharvan", "D": "Vairamuthu"}, "explanation": "Professor Ma. Su. Annamalai wrote this chapter celebrating the valiant contribution of Tamils in the INA."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 130, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 130", "url": null, "