{"id": "9th-u7-q023", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "ina-full-form-tamil", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'I.N.A.' என்பதன் முழுமையான தமிழாக்கம் எது?", "media_id": null}], "options": {"A": "இந்திய கடற்படை", "B": "இந்திய அமைதிப்படை", "C": "இந்திய தேசிய இராணுவம்", "D": "இந்திய வான்படை"}, "explanation": "I.N.A. என்பது Indian National Army என்பதன் சுருக்கமாகும்; இதன் தமிழாக்கம் 'இந்திய தேசிய இராணுவம்' என்பதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the exact Tamil translation of the acronym 'I.N.A.' (Indian National Army)?", "media_id": null}], "options": {"A": "Indian Navy", "B": "Indian Peacekeeping Force", "C": "Indiya Desiya Iraanuvam (இந்திய தேசிய இராணுவம்)", "D": "Indian Air Force"}, "explanation": "'INA' stands for the Indian National Army, translated in Tamil as 'இந்திய தேசிய இராணுவம்'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 130, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 130", "url": null, "source_notes": null}, "previous_year": {"is_previous_y