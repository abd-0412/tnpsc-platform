{"id": "9th-u7-q104", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "muthollayiram-literary-value", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்தொள்ளாயிரப் பாடல்கள் தமிழிலக்கியத்தில் எவ்வகைச் சுவைக்கு மிகச் சிறந்த சான்றாகத் திகழ்கின்றன?", "media_id": null}], "options": {"A": "அழுகைச் சுவை மட்டுமே", "B": "அச்சச் சுவை மட்டுமே", "C": "இளிவரல் சுவை மட்டுமே", "D": "வீரம் மற்றும் கற்பனை நயம் மிக்க காதல் (அகம் மற்றும் புறம்) நயங்கள்"}, "explanation": "முத்தொள்ளாயிரம் போர்க்கள வீரத்தையும் மூவேந்தரின் படைச்சிறப்பையும் பாடும் புறச்சுவையும், தலைவன் மீது கொண்ட காதல் நயத்தைப் பாடும் அகச்சுவையும் ஒருங்கே அமையப்பெற்ற நூலாகும்."}, "en": {"blocks": [{"type": "text", "content": "For which literary aesthetic fusion is Muthollayiram predominantly celebrated in classical Tamil literature?", "media_id": null}], "options": {"A": "Melancholy only", "B": "Terror and fear only", "C": "Satirical mockery only", "D": "A sublime blend of heroic martial valor (Puram) and imaginative lyrical romance (Agam)"}, "explanation": "Muthollayiram masterfully integrates martial heroism (Puram) with delicate romantic lyricism (Agam)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "T