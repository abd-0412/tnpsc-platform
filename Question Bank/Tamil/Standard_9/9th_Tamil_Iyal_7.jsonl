{"id": "9th-u7-q101", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "chola-king-names", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்தொள்ளாயிரத்தில் சோழ மன்னனைக் குறிக்கப் பயன்படும் சிறப்புப் பெயர்கள் எவை?", "media_id": null}], "options": {"A": "கிள்ளி, செம்பியன், வளவன்", "B": "செழியன், மாறன், வழுதி", "C": "குடக்கோதை, வானவரம்பன்", "D": "காடவன், பல்லவன்"}, "explanation": "சோழ மன்னன் கிள்ளி, செம்பியன், வளவன் எனப் பல பெயர்களால் சிறப்பிக்கப்படுகிறான். (செழியன், மாறன், வழுதி என்பன பாண்டியன் பெயர்கள்; குடக்கோதை சேரன் பெயர்)."}, "en": {"blocks": [{"type": "text", "content": "Which royal titles are applied to address the Chola monarch in Muthollayiram verses?", "media_id": null}], "options": {"A": "Killi, Sembiyan, and Valavan (கிள்ளி, செம்பியன், வளவன்)", "B": "Sezhiyan, Maaran, and Vazhuthi", "C": "Kudakkodhai and Vaanavaramban", "D": "Kaadavan and Pallavan"}, "explanation": "Killi, Sembiyan, and Valavan are traditional dynastic appellations of the Chola king."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "secti