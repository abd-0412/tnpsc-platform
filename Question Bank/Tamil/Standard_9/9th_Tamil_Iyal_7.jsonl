{"id": "9th-u7-q107", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "chola-war-elephant-sea", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்தொள்ளாயிரத்தில் சோழ நாட்டின் யானைகள் எங்கு சென்று விளையாடுவதாகப் புலவர் கற்பனை நயத்தோடு பாடுகிறார்?", "media_id": null}], "options": {"A": "மணல் மேடுகளில்", "B": "மலை உச்சியில்", "C": "கடல் அலைகளில் பாய்ந்து விளையாடுவதாக", "D": "காட்டு மரங்களின் நிழலில்"}, "explanation": "சோழ நாட்டின் கலிங்கத்துப் போர் யானைகளும் இளம் கன்றுகளும் கடலில் பாயும் அலைகளை எதிர்த்து நின்று விளையாடும் காட்சியைக் கவிஞர் நயம்பட உரைக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "Where does the poet fancifully envision the war elephants and calves of the Chola kingdom frolicking in play?", "media_id": null}], "options": {"A": "On desert dunes", "B": "On mountain peaks", "C": "Surging through ocean surf and coastal sea waves (கடல் அலைகளில்)", "D": "Beneath forest shade"}, "explanation": "The poet depicts Chola elephants frolicking playfully amidst breaking ocean waves along the Coromandel coast."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year",