{"id": "9th-u7-q117", "schema_version": "1.0", "kind": "application", "level": "application", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l4", "chapter_id": null, "topic_id": "kaalavaagupeyar-kaar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கார் அறுத்தான்' - இத்தொடர் எவ்வகை ஆகுபெயருக்குச் சான்றாகும்?", "media_id": null}], "options": {"A": "காலவாகுபெயர்", "B": "சினையாகுபெயர்", "C": "தொழிலாகுபெயர்", "D": "பண்பாகுபெயர்"}, "explanation": "'கார்' (கார்காலம்) என்னும் காலப்பெயர், அக்காலத்தில் விளையும் பயிருக்கு ஆகிவந்ததால் இது 'காலவாகுபெயர்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "'கார் அறுத்தான்' (He harvested the autumn crop) serves as an exemplar for which Aagupeyar?", "media_id": null}], "options": {"A": "Kaalavaagupeyar (காலவாகுபெயர் - Temporal metonymy)", "B": "Sinaiyaagupeyar", "C": "Thozhilaagupeyar", "D": "Panpaagupeyar"}, "explanation": "'Kaar' (monsoon autumn season) refers to the paddy harvested in that season, marking Kaalavaagupeyar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 65, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 65", "url": null, "source_notes": null}, "prev