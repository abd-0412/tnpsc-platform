{"id": "9th-u7-q094", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "pandya-pearls-korkai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாண்டிய நாட்டில் உலகப் புகழ் பெற்ற துறைமுகமாகவும் முத்துக்குளித்தலுக்குப் பெயர் பெற்ற இடமாகவும் விளங்கியது எது?", "media_id": null}], "options": {"A": "பூம்புகார்", "B": "கொற்கை", "C": "முசிறி", "D": "தொண்டி"}, "explanation": "பாண்டிய நாட்டின் புகழ்பெற்ற துறைமுகம் 'கொற்கை' ஆகும்; இங்கு விளைந்த முத்துகள் உலகப் புகழ்பெற்றவை."}, "en": {"blocks": [{"type": "text", "content": "Which coastal emporium of the Pandya realm was internationally renowned for pearl fishery diving?", "media_id": null}], "options": {"A": "Poompuhar", "B": "Korkai (கொற்கை)", "C": "Musiri", "D": "Thondi"}, "explanation": "Korkai harbor in Pandyan territory was world-renowned for its exquisite natural pearls."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 137", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam