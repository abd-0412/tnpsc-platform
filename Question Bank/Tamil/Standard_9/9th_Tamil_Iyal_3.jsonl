{"id": "9th-u3-q007", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-01-eru-thazhuvuthal", "chapter_id": null, "topic_id": "topic-eru-thazhuvuthal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாட்டுப் பொங்கல் விழாவில் உழவர்கள் மாடுகளுக்கு நன்றி தெரிவிக்கும் விதமாக ஊட்டப்படும் பொங்கல் எது?", "media_id": null}], "options": {"A": "சர்க்கரைப் பொங்கல்", "B": "வெண்பொங்கல்", "C": "தளிகைப் பொங்கல்", "D": "கற்கண்டுப் பொங்கல்"}, "explanation": "மாட்டுப் பொங்கலன்று மாடுகளின் கொம்புகளைச் சீவி, எண்ணெய் தடவி, மாலையிட்டுத் தம்மோடு உழைப்பில் ஈடுபட்ட மாடுகளுக்கு நன்றி தெரிவிக்கும் விதத்தில் 'தளிகைப் பொங்கலை' ஊட்டிவிடுவர்."}, "en": {"blocks": [{"type": "text", "content": "During Mattu Pongal, what ceremonial Pongal preparation is fed to cattle in gratitude for their tireless labor?", "media_id": null}], "options": {"A": "Sarkarai Pongal", "B": "Ven Pongal", "C": "Thaligai Pongal", "D": "Karkandu Pongal"}, "explanation": "Farmers feed their decorated cattle 'Thaligai Pongal' as an offering of heartfelt gratitude during the Mattu Pongal festival."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025",