{"id": "9th-u3-q100", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-03-thiruppavai-thiruvempavai", "chapter_id": null, "topic_id": "topic-thiruppavai-thiruvempavai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சு. சமுத்திரத்தின் சிறுகதைத் தொகுப்புகளுள் தமிழக அரசின் பரிசினைப் பெற்ற நூல் எது?", "media_id": null}], "options": {"A": "ஒவ்வொரு கல்லாய்", "B": "சாசனம்", "C": "கொம்பன்", "D": "குற்றம் பார்க்கில்"}, "explanation": "சு. சமுத்திரம் எழுதிய 'குற்றம் பார்க்கில்' என்னும் சிறுகதைத் தொகுதி தமிழக அரசின் சிறந்த சிறுகதைக்கான பரிசினைப் பெற்றது."}, "en": {"blocks": [{"type": "text", "content": "Which short story collection by Su. Samuthiram won the Tamil Nadu State Government Award?", "media_id": null}], "options": {"A": "Ovvoru Kallaai", "B": "Saasanam", "C": "Komban", "D": "Kutram Paarkkil"}, "explanation": "'Kutram Paarkkil' (If Faults Be Counted) won the prestigious Tamil Nadu State Government Annual Literary Award."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 63, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 63", "url": null, "source_not