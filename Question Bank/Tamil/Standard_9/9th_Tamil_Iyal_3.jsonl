{"id": "9th-u3-q112", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-03-thiruppavai-thiruvempavai", "chapter_id": null, "topic_id": "topic-thiruppavai-thiruvempavai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கண்ணன் நினைவில் உணர்வற்று உலகை மறந்து கிடக்கின்றாயா? ஒளிபடைத்த கண்ணழகி! கதவைத் திற, நீராடச் செல்வோம்!' - என்று எந்த நூல் விவரிக்கிறது?", "media_id": null}], "options": {"A": "சிலப்பதிகாரம்", "B": "பெரியபுராணம்", "C": "மணிமேகலை", "D": "ஆண்டாளின் திருப்பாவை பாடல் 7 விளக்கம்"}, "explanation": "பாடநூல் பக்க எண் 58-ல் திருப்பாவை ஏழாவது பாசுர விளக்கத்தில், 'கண்ணன் நினைவில் உணர்வற்று உலகை மறந்து கிடக்கின்றாயா? ஒளிபடைத்த கண்ணழகி! கதவைத் திற! நீராடச் செல்வோம்' என்று குறிப்பிடப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "'Are you lying lost in contemplation of Krishna, oblivious of the world? Open the door, bright-eyed maiden, let us bathe!' explains which verse?", "media_id": null}], "options": {"A": "Silappadikaram", "B": "Periyapuranam", "C": "Manimekalai", "D": "Explanation of verse 7 of Andal's Thiruppavai"}, "explanation": "Textbook page 58 gives this exact poetic commentary elucidating Andal's 7th Thiruppavai hymn."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tam