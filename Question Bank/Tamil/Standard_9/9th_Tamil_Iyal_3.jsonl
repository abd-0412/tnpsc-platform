{"id": "9th-u3-q101", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-03-thiruppavai-thiruvempavai", "chapter_id": null, "topic_id": "topic-thiruppavai-thiruvempavai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சு. சமுத்திரம் அவர்களின் குறிப்பிடத்தகுந்த புதினங்களுள் பொருந்தாத ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "சாசனம்", "B": "வாடாமல்லி", "C": "பாலைப்புறா", "D": "மண்சுமை"}, "explanation": "வாடாமல்லி, பாலைப்புறா, மண்சுமை, சோற்றிராணுவம் ஆகியவை சு. சமுத்திரத்தின் புதினங்கள். 'சாசனம்' என்பது கந்தர்வனின் சிறுகதைத் தொகுப்பாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the work that was NOT authored by Su. Samuthiram:", "media_id": null}], "options": {"A": "Saasanam", "B": "Vaadaamalli", "C": "Paalaippuraa", "D": "Mansumai"}, "explanation": "'Saasanam' is a short story collection by Kandharvan; the rest are acclaimed novels by Su. Samuthiram."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 63, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 63", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_3", "thiruppavai", "thiruvempavai", "samuthiram"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u3-q102", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-03-thiruppavai-thiruvempavai", "chapter_id": null, "topic_id": "topic-thiruppavai-thiruvempavai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தாய்மைக்கு வறட்சி இல்லை' என்னும் சிறுகதையின் மூலம் ஆசிரியர் உணர்த்தும் முதன்மை மனிதநேயக் கருத்து யாது?", "media_id": null}], "options": {"A": "செல்வந்தர்கள் மட்டுமே தானம் செய்ய வேண்டும்", "B": "கொடிய வறுமையிலும் தன் பசியை மறந்து பிற உயிர்களின் பசி தீர்க்கும் உயர்ந்த தாய்மைப் பண்பு", "C": "நகர வாழ்க்கையின் நாகரிக வளர்ச்சி", "D": "விலங்குகளை விரட்டியடிக்க வேண்டும்"}, "explanation": "வறுமையிலும் மனிதமும் மனிதாபிமானமும் வறண்டு போவதில்லை; தனக்கே உணவு இல்லாத சூழ்நிலையிலும் குழந்தையின் கையிலுள்ள ரொட்டித் துண்டை ஒரு வாயில்லா ஜீவனுக்குப் பகிர்ந்தளிக்கும் தாய்மைப் பண்பை இக்கதை விவரிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What poignant humanist theme does Su. Samuthiram illuminate through 'Thaaimaikku Varatchi Illai'?", "media_id": null}], "options": {"A": "Only the affluent should practice charity", "B": "Sublime maternal compassion that feeds other hungry creatures even in the grip of abject poverty", "C": "The material glamour of urban progress", "D": "Animals must be driven away from human settlements"}, "explanation": "The story proves that true compassion never suffers drought; even while starving, genuine maternal warmth shares sustenance with a suffering stray animal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 63, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 63", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_3", "thiruppavai", "thiruvempavai", "samuthiram"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u3-q103", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-03-thiruppavai-thiruvempavai", "chapter_id": null, "topic_id": "topic-thiruppavai-thiruvempavai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைத் தமிழரின் நகர நாகரிகத்தை உலகிற்குப் பறைசாற்றும் புகழ்பெற்ற கீழடி அகழாய்வு எந்த நதிக்கரையில் அமைந்துள்ளது?", "media_id": null}], "options": {"A": "காவிரி நதிக்கரை", "B": "தாமிரபரணி நதிக்கரை", "C": "வைகை நதிக்கரை (சிவகங்கை மாவட்டம்)", "D": "பாலாறு நதிக்கரை"}, "explanation": "கீழடி அகழாய்வு சிவகங்கை மாவட்டத்தில் வைகை நதிக்கரையில் அமைந்துள்ள தொன்மையான சங்க கால நகர நாகரிகப் பகுதியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Along which historic river basin is the ancient Sangam urban excavation site of Keezhadi located?", "media_id": null}], "options": {"A": "Kaveri river basin", "B": "Thamirabarani river basin", "C": "Vaigai river basin (Sivagangai district)", "D": "Palar river basin"}, "explanation": "Keezhadi is situated along the ancient Vaigai river plains in Sivagangai district, revealing urban Sangam civilization."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 52", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_3", "thiruppavai", "thiruvempavai", "samuthiram"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u3-q104", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-03-thiruppavai-thiruvempavai", "chapter_id": null, "topic_id": "topic-thiruppavai-thiruvempavai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழடி அகழாய்வில் கண்டறியப்பட்ட கரிமப் பொருட்களின் அறிவியல் காலக்கணிப்பின்படி கீழடி நாகரிகம் எந்த நூற்றாண்டைச் சேர்ந்தது என நிறுவப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "கி.பி. 10-ஆம் நூற்றாண்டு", "B": "கி.பி. 2-ஆம் நூற்றாண்டு", "C": "கி.மு. 2-ஆம் நூற்றாண்டு", "D": "கி.மு. 6-ஆம் நூற்றாண்டு (பொ.ஆ.மு. 580)"}, "explanation": "அமெரிக்காவின் பீட்டா அனாலிட்டிக் ஆய்வகத்தின் கரிமப் பகுப்பாய்வின்படி, கீழடியின் தொன்மை கி.மு. 6-ஆம் நூற்றாண்டு (பொ.ஆ.மு. 580) என அறிவியல் பூர்வமாக நிறுவப்பட்டு, சங்க காலத்தின் காலம் பின்னோக்கி நகர்த்தப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Carbon dating of organic artifacts from Keezhadi scientifically places the roots of Tamil urban literacy to which era?", "media_id": null}], "options": {"A": "10th century CE", "B": "2nd century CE", "C": "2nd century BCE", "D": "6th century BCE (c. 580 BCE)"}, "explanation": "AMS Carbon dating at Beta Analytic laboratory conclusively dates Keezhadi strata to the 6th century BCE (580 BCE)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 52", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_3", "thiruppavai", "thiruvempavai", "samuthiram"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u3-q105", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-03-thiruppavai-thiruvempavai", "chapter_id": null, "topic_id": "topic-thiruppavai-thiruvempavai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'காசும் பிறப்பும் கலகலப்பக் கைபேர்த்து / வாச நறுங்குழல் ஆய்ச்சியர்' - இதில் 'காசும் பிறப்பும்' என்பவை எவ்வகை அணிகலன்கள்?", "media_id": null}], "options": {"A": "கழுத்தில் அணியும் பொற்காசு மாலை மற்றும் ஐம்படைத் தாலி (ஆபரணங்கள்)", "B": "கை வளையல்கள் மற்றும் கால்கொலுசுகள்", "C": "தலை ஆபரணங்கள்", "D": "காதுத் தோடுகள்"}, "explanation": "ஆய்ச்சியர் தயிர் கடையும்போது அவர்கள் கழுத்தில் அணிந்திருந்த வடமும் (பொற்காசு மாலை) ஐம்படைத் தாலியும் கலகலவென்று ஒலி எழுப்பின என்பது இதன் பொருளாகும்."}, "en": {"blocks": [{"type": "text", "content": "In Andal's verse 'Kaasum pirappum kalagalappa', what ornaments do 'Kaasu' and 'Pirappu' denote?", "media_id": null}], "options": {"A": "Neck gold coin necklace and protective Aimbadai talisman pendant", "B": "Hand bangles and anklets", "C": "Forehead tiaras", "D": "Ear pendants"}, "explanation": "They refer to golden coin necklaces ('Kaasu') and protective talisman pendants ('Pirappu') worn around the neck."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tami