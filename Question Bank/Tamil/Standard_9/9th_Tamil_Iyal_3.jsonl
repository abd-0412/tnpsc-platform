{"id": "9th-u3-q070", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-02-manimekalai", "chapter_id": null, "topic_id": "topic-manimekalai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மணிமேகலையில் குறிப்பிடப்படும் 'சமயக் கணக்கர்' மற்றும் 'பாடை மாக்கள்' என்பவர்கள் முறையே யார்?", "media_id": null}], "options": {"A": "கோவில் அர்ச்சகர்கள், தமிழ் மக்கள்", "B": "சமயத் தத்துவவாதிகள், பல மொழி பேசும் மக்கள்", "C": "கணக்கப்பிள்ளைகள், நடனக் கலைஞர்கள்", "D": "அரண்மனை அமைச்சர்கள், வணிகர்கள்"}, "explanation": "சொல்லும் பொருளும்: சமயக் கணக்கர் - பல்வேறு சமயங்களின் தத்துவங்களை ஆய்ந்த தத்துவவாதிகள்; பாடை மாக்கள் - பல்வேறு மொழிகளைப் பேசும் வேற்றுநாட்டு மக்கள்."}, "en": {"blocks": [{"type": "text", "content": "Who are designated as 'Samayak Kanakkar' and 'Paadai Maakkal' in Manimekalai?", "media_id": null}], "options": {"A": "Temple priests and indigenous Tamils", "B": "Religious philosophers / theologians, and polyglot foreign nationals speaking diverse tongues", "C": "Village accountants and royal court dancers", "D": "State ministers and caravan traders"}, "explanation": "Samayak Kanakkar denotes philosophical theologians of various creeds, while Paadai Maakkal refers to cosmopolitan foreigners speaking foreign languages."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type":