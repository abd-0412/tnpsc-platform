{"id": "9th-u3-q155", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-05-thirukkural-pyq", "chapter_id": null, "topic_id": "topic-thirukkural-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'எண்ணித் துணிக கருமம் துணிந்தபின் / எண்ணுவம் என்பது இழுக்கு' - இக்குறட்பாவில் 'இழுக்கு' என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "வெற்றி", "B": "பயணம்", "C": "குற்றம் (தீராப் பழி)", "D": "இலாபம்"}, "explanation": "சொல்லும் பொருள்: 'இழுக்கு' என்றால் குற்றம் அல்லது அவமானம் என்று பொருள். ஒரு செயலை நன்கு ஆராய்ந்து தொடங்க வேண்டும்; தொடங்கிய பின் எண்ணலாம் என்பது குற்றமாகும்."}, "en": {"blocks": [{"type": "text", "content": "In 'Ennith thuniga karumam thunindhabin ennuvam enbadhu izhukku', what does 'Izhukku' mean?", "media_id": null}], "options": {"A": "Triumph", "B": "Journey", "C": "Kutram (Disgrace / blameworthy fault)", "D": "Profit"}, "explanation": "'Izhukku' denotes a grave fault or shameful ignominy in Thirukkural."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 74, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 74", "url": null, "s