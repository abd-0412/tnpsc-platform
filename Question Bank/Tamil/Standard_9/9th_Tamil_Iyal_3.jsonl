{"id": "9th-u3-q154", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-05-thirukkural-pyq", "chapter_id": null, "topic_id": "topic-thirukkural-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூல் பலவுள் தெரிக: பின்வரும் தொடர்களுள் பொருந்தாத தவறான தொடரைக் கண்டறிக:", "media_id": null}], "options": {"A": "பன்னிரு ஆழ்வார்களுள் ஆண்டாளும் ஒருவர்", "B": "திருவெம்பாவையை இயற்றியவர் ஆண்டாள்", "C": "சூடிக்கொடுத்த சுடர்க்கொடி என்று ஆண்டாள் அழைக்கப்படுகிறார்", "D": "பெரியாழ்வாரின் வளர்ப்பு மகளாவார் ஆண்டாள்"}, "explanation": "தொடர் B முற்றிலும் தவறானது. திருவெம்பாவையை இயற்றியவர் மாணிக்கவாசகர்; ஆண்டாள் இயற்றிய நூல் திருப்பாவை ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Textbook Question: Spot the INCORRECT statement among the following:", "media_id": null}], "options": {"A": "Andal is one among the twelve Alvars", "B": "Thiruvempavai was composed by Andal", "C": "Andal is acclaimed as Soodikkoduttha Sudarkkodi", "D": "Andal was the foster daughter of Periyalvar"}, "explanation": "Statement B is false; Thiruvempavai was authored by Saivite saint Manikkavasagar, while Andal composed Thiruppavai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Servic