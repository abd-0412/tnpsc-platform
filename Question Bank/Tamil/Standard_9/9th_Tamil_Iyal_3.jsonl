{"id": "9th-u3-q061", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-02-manimekalai", "chapter_id": null, "topic_id": "topic-manimekalai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் இலக்கியத்தில் மணிமேகலைக் காப்பியம் மொத்தம் எத்தனை காதைகளைக் கொண்டு கட்டமைக்கப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "முப்பது காதைகள் (30)", "B": "இருபத்தெட்டு காதைகள் (28)", "C": "இருபத்தைந்து காதைகள் (25)", "D": "நாற்பது காதைகள் (40)"}, "explanation": "மணிமேகலைக் காப்பியம் சிலப்பதிகாரத்தைப் போலவே 30 காதைகளைக் கொண்டு அற்புதமாக அமைக்கப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "How many cantos (Kaadhaigal) constitute the epic Manimekalai?", "media_id": null}], "options": {"A": "Thirty cantos (30)", "B": "Twenty-eight cantos (28)", "C": "Twenty-five cantos (25)", "D": "Forty cantos (40)"}, "explanation": "Like its twin epic Silappadikaram, Manimekalai is composed of exactly 30 cantos."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 56", "url": null, "source_notes": null}, "prev