{"id": "9th-u3-q138", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-04-thodar-aagupeyar", "chapter_id": null, "topic_id": "topic-thodar-aagupeyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'இந்திய வீரர்கள் எளிதில் வென்றனர்' என்பதை ஆகுபெயராக மாற்றினால் வரும் சரியான தொடர் எது?", "media_id": null}], "options": {"A": "வீரர்கள் வென்றனர்", "B": "இந்தியா எளிதில் வென்றது (இடவாகுபெயர்)", "C": "எளிதில் வெற்றி கிடைத்தது", "D": "போட்டி முடிந்தது"}, "explanation": "பாடநூல் பக்க எண் 66 பயிற்சி: 'இந்திய வீரர்கள் எளிதில் வென்றனர்' - இதனை ஆகுபெயராக மாற்றினால் 'இந்தியா எளிதில் வென்றது' என மாறும் (இந்தியா என்னும் இடப்பெயர் வீரர்களுக்கு ஆகிவந்தது)."}, "en": {"blocks": [{"type": "text", "content": "How is the sentence 'Indian athletes won easily' transformed into an Aagupeyar construction?", "media_id": null}], "options": {"A": "Athletes won", "B": "India won easily (Idavaagupeyar)", "C": "Victory was achieved easily", "D": "Tournament ended"}, "explanation": "'India won easily' substitutes the country name for its participating team, creating an Idavaagupeyar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edi