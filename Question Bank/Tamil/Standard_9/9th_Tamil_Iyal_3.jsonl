{"id": "9th-u3-q136", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-04-thodar-aagupeyar", "chapter_id": null, "topic_id": "topic-thodar-aagupeyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒன்றன் இயற்பெயர், அதனோடு தொடர்புடைய மற்றொன்றிற்குத் தொன்றுதொட்டு வழங்கி வருவது தமிழ் இலக்கணத்தில் என்ன எனப்படும்?", "media_id": null}], "options": {"A": "இடுகுறிப்பெயர்", "B": "காரணப்பெயர்", "C": "அன்மொழித்தொகை", "D": "ஆகுபெயர்"}, "explanation": "பாடநூல் கூற்று: 'ஒன்றன் இயற்பெயர், அதனோடு தொடர்புடைய மற்றொன்றிற்கு ஆகி (பெயராகி) வருவது ஆகுபெயர் எனப்படும்.'"}, "en": {"blocks": [{"type": "text", "content": "What is the grammatical phenomenon where the primary name of an object designates an associated entity?", "media_id": null}], "options": {"A": "Arbitrary noun", "B": "Causal noun", "C": "Anmozhitthogai", "D": "Aagupeyar (Metonymy / transferred naming)"}, "explanation": "Aagupeyar is the grammatical transfer of a primary designation to an associated object, person, place, or quality."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 65, "chapter": null, "section": null, "reference":