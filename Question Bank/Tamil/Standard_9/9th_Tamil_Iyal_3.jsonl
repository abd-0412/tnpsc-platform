{"id": "9th-u3-q137", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-04-thodar-aagupeyar", "chapter_id": null, "topic_id": "topic-thodar-aagupeyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொல்காப்பியர் தம் சொல்லதிகாரத்தில் எத்தனை வகையான ஆகுபெயர்களைக் குறிப்பிட்டுள்ளார்?", "media_id": null}], "options": {"A": "ஏழு வகைகள் (7)", "B": "பதினாறு வகைகள் (16)", "C": "பத்து வகைகள் (10)", "D": "நான்கு வகைகள் (4)"}, "explanation": "தொல்காப்பியர் சொல்லதிகாரத்தில் 'பொருளொடு புணர்ந்த ஏழனை என்ப' என்று 7 வகையான ஆகுபெயர்களைக் குறிப்பிட்டுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "How many metonymic categories did Tholkappiyar explicitly codify in his Solladhikaram?", "media_id": null}], "options": {"A": "Seven categories (7)", "B": "Sixteen categories (16)", "C": "Ten categories (10)", "D": "Four categories (4)"}, "explanation": "Tholkappiyar identified seven foundational varieties of Aagupeyar in Solladhikaram."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 65, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 65", "url": null, "source_note