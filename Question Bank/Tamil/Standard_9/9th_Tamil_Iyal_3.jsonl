{"id": "9th-u3-q117", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-04-thodar-aagupeyar", "chapter_id": null, "topic_id": "topic-thodar-aagupeyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பவணந்தி முனிவரின் நன்னூல் இலக்கணப்படி ஆகுபெயர் மொத்தம் எத்தனை வகைப்படும்?", "media_id": null}], "options": {"A": "பதினாறு (16 வகைகள்)", "B": "ஏழு (7 வகைகள்)", "C": "எட்டு (8 வகைகள்)", "D": "பன்னிரண்டு (12 வகைகள்)"}, "explanation": "தொல்காப்பியர் 7 வகையான ஆகுபெயர்களைக் குறிப்பிட, நன்னூலார் விரிவாக 16 வகையான ஆகுபெயர்களைக் குறிப்பிட்டுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "According to the medieval grammatical treatise Nannool, into how many types is Aagupeyar classified?", "media_id": null}], "options": {"A": "Sixteen types (16)", "B": "Seven types (7)", "C": "Eight types (8)", "D": "Twelve types (12)"}, "explanation": "Nannool expands the classification of metonymy (Aagupeyar) into sixteen distinct categories."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 65, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 65", "url": null, "source_