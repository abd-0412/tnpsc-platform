{"id": "9th-u3-q067", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-02-manimekalai", "chapter_id": null, "topic_id": "topic-manimekalai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பற்றா மாக்கள் தம்முடன் ஆயினும் செற்றமும் கலாமும் செய்யாது அகலுமின்' - இதில் 'செற்றம்', 'கலாம்' ஆகியவற்றின் பொருள் யாது?", "media_id": null}], "options": {"A": "செற்றம் - நட்பு ; கலாம் - பேச்சு", "B": "செற்றம் - ஏமாற்று ; கலாம் - பொய்", "C": "செற்றம் - சினம் ; கலாம் - போர் (பூசல்)", "D": "செற்றம் - சோம்பல் ; கலாம் - தூக்கம்"}, "explanation": "சொல்லும் பொருளும்: செற்றம் - சினம்; கலாம் - போர் (பூசல்). மாறுபாடு கொண்டவர்களோடு ஆயினும் கோபமும் போரும் கொள்ளாமல் விலகி நில்லுங்கள் என்று சாற்றப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "In 'Settramum kalaamum seyyaadhu agalumin', what do 'Settram' and 'Kalaam' signify?", "media_id": null}], "options": {"A": "Settram - Friendship ; Kalaam - Discourse", "B": "Settram - Fraud ; Kalaam - Falsehood", "C": "Settram - Anger / fury ; Kalaam - Warfare / quarrel", "D": "Settram - Sloth ; Kalaam - Sleep"}, "explanation": "Glossary: 'Settram' means fierce rage/anger, and 'Kalaam' denotes hostility, altercation, or warfare."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publishe