{"id": "9th-u3-q062", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-02-manimekalai", "chapter_id": null, "topic_id": "topic-manimekalai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஐம்பெருங்காப்பியங்களுள் ஒன்றான மணிமேகலை எந்தச் சமயத்தின் அறக் கருத்துக்களை முன்னிறுத்தும் காப்பியமாகும்?", "media_id": null}], "options": {"A": "சமண சமயம்", "B": "பௌத்த சமயம்", "C": "சைவ சமயம்", "D": "வைணவ சமயம்"}, "explanation": "மணிமேகலை பௌத்த சமயச் சார்புடைய காப்பியமாகும். பசிப்பிணி போக்கும் அமுதசுரபி, அறம், துறவு, புத்த பீடிகை வழிபாடுகள் இதில் முன்னிறுத்தப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Which religious philosophy is expounded and championed by the epic Manimekalai?", "media_id": null}], "options": {"A": "Jainism", "B": "Buddhism", "C": "Saivism", "D": "Vaishnavism"}, "explanation": "Manimekalai is the foremost Buddhist epic in Tamil, celebrating compassionate service, alleviation of hunger, and Buddhist dharma."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 56", "url": null, "so