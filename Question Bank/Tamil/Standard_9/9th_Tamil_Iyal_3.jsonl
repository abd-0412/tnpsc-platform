{"id": "9th-u3-q108", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-03-thiruppavai-thiruvempavai", "chapter_id": null, "topic_id": "topic-thiruppavai-thiruvempavai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆண்டாள் அருளிய முப்பது பாசுரங்களைக் கொண்ட திருப்பாவை, நாலாயிர திவ்வியப் பிரபந்தத்தில் எந்தப் பிரிவில் தொகுக்கப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "இரண்டாயிரத்தில்", "B": "இயற்பாவில்", "C": "திருவாய்மொழியில்", "D": "முதலாயிரத்தில் (முதல் ஆயிரத்தில்)"}, "explanation": "நாலாயிர திவ்வியப் பிரபந்தத்தின் நான்கு பிரிவுகளுள் ஆண்டாளின் திருப்பாவையும் நாச்சியார் திருமொழியும் 'முதலாயிரம்' என்னும் முதல் தொகுப்பில் இடம்பெற்றுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Under which major division of the Nalayira Divya Prabandham is Andal's Thiruppavai categorized?", "media_id": null}], "options": {"A": "Irandaayiram", "B": "Iyarpaa", "C": "Thiruvaimozhi", "D": "Mudhalaayiram (First Thousand)"}, "explanation": "Thiruppavai and Nachiyar Thirumozhi are compiled within the opening division 'Mudhalaayiram'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page