{"id": "9th-u3-q060", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-02-manimekalai", "chapter_id": null, "topic_id": "topic-manimekalai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கோவலன்-மாதவி மகளான மணிமேகலையின் துறவு வாழ்க்கையை முதன்மையாகக் கூறுவதால் இந்நூலுக்கு வழங்கும் வேறு பெயர் யாது?", "media_id": null}], "options": {"A": "மணிமேகலை காப்பியம்", "B": "மாதவி காதை", "C": "பௌத்த காவியம்", "D": "மணிமேகலை துறவு"}, "explanation": "மணிமேகலையின் துறவு வாழ்க்கையைக் கூறுவதால் இந்நூலுக்கு 'மணிமேகலை துறவு' என்னும் வேறு பெயரும் உண்டு."}, "en": {"blocks": [{"type": "text", "content": "Because it depicts the ascetic renunciation of Kovalan and Madhavi's daughter, what alternative title is given to Manimekalai?", "media_id": null}], "options": {"A": "Manimekalai Kaappiyam", "B": "Madhavi Kaadhai", "C": "Baudha Kaaviyam", "D": "Manimekalai Thuravu (Renunciation of Manimekalai)"}, "explanation": "Focusing on her spiritual transformation and Buddhist monastic initiation, the epic is historically titled 'Manimekalai Thuravu'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 56, "ch