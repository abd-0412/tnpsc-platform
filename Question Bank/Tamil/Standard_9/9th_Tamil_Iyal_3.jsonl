{"id": "9th-u3-q153", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-05-thirukkural-pyq", "chapter_id": null, "topic_id": "topic-thirukkural-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூல் பலவுள் தெரிக வினா: சொற்கள் முறைமாறி உள்ளவற்றுள் முறையான தொடர் அமைப்பைக் குறிப்பிடுக:", "media_id": null}], "options": {"A": "தமிழர்களின் தொன்மையான வீரவிளையாட்டு ஏறு தழுவுதல்", "B": "தமிழர்களின் வீரவிளையாட்டு ஏறு தழுவுதல் தொன்மையான", "C": "தொன்மையான வீரவிளையாட்டு தமிழர்களின் ஏறு தழுவுதல்", "D": "தமிழர்களின் வீரவிளையாட்டு தொன்மையான ஏறு தழுவுதல்"}, "explanation": "சொற்கள் ஒழுங்கான தொடரியல் மரபுடன் அமைந்த சரியான தொடர் 'தமிழர்களின் தொன்மையான வீரவிளையாட்டு ஏறு தழுவுதல்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Textbook Question: Identify the syntactically correct word order:", "media_id": null}], "options": {"A": "Thamizhargalin thonmaiyaana veeravilaiyaattu eru thazhuvudhal", "B": "Thamizhargalin veeravilaiyaattu eru thazhuvudhal thonmaiyaana", "C": "Thonmaiyaana veeravilaiyaattu thamizhargalin eru thazhuvudhal", "D": "Thamizhargalin veeravilaiyaattu thonmaiyaana eru thazhuvudhal"}, "explanation": "Option A adheres strictly to standard Tamil syntactical hierarchy: possessive determiner + adjectival noun phrase + predicate nominal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answer