{"id": "9th-u3-q168", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-05-thirukkural-pyq", "chapter_id": null, "topic_id": "topic-thirukkural-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] 'பட்டிமண்டபம்' என்னும் சொல்லாட்சி இடம்பெற்றுள்ள இலக்கிய நூல்களுள் பொருந்தாத நூல் எது?", "media_id": null}], "options": {"A": "சிலப்பதிகாரம்", "B": "மணிமேகலை", "C": "திருவாசகம் மற்றும் கம்பராமாயணம்", "D": "கலித்தொகை"}, "explanation": "பட்டிமண்டபம் என்னும் சொல் சிலப்பதிகாரம், மணிமேகலை, திருவாசகம் ('பட்டிமண்டபம் ஏற்றினை ஏற்றினை'), கம்பராமாயணம் ஆகியவற்றில் இடம்பெற்றுள்ளது; ஆனால் 'கலித்தொகையில்' இச்சொல் இடம்பெறவில்லை."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] In which of the following classical works does the term 'Pattimandapam' NOT appear?", "media_id": null}], "options": {"A": "Silappadikaram", "B": "Manimekalai", "C": "Thiruvasagam and Kamba Ramayanam", "D": "Kalithogai"}, "explanation": "'Pattimandapam' occurs in Silappadikaram, Manimekalai, Thiruvasagam, and Kamba Ramayanam, but NOT in Kalithogai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 55