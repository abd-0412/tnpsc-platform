{"id": "9th-u3-q051", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-01-eru-thazhuvuthal", "chapter_id": null, "topic_id": "topic-eru-thazhuvuthal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க காலத்தில் 'நடுகல்' எதற்காக நடப்பட்டது?", "media_id": null}], "options": {"A": "கோவில் கட்டுவதற்காக", "B": "மன்னரின் பிறந்தநாளைக் கொண்டாடுவதற்காக", "C": "ஊரைக் காக்கவோ விலங்கோடு போராடியோ வீரமரணம் அடைந்த வீரரின் நினைவாக", "D": "புலவர்களுக்குப் பரிசு வழங்குவதற்காக"}, "explanation": "நடுகல் என்பது போரிலோ அல்லது விலங்குகளோடு போராடியோ தம் ஊரையும் மக்களையும் காத்து வீரமரணம் எய்திய வீரர்களின் நினைவைப் போற்றும் வகையில் நடப்பட்ட நினைவுக்கல்லாகும்."}, "en": {"blocks": [{"type": "text", "content": "In Sangam antiquity, why were Hero Stones (Nadukal) erected?", "media_id": null}], "options": {"A": "To lay foundation stones for temples", "B": "To celebrate a monarch's birthday", "C": "In commemoration of warriors who died heroically defending their land or fighting wild beasts", "D": "To register royal land gifts to court poets"}, "explanation": "Nadukal (hero stones) were memorial slabs installed to honor warriors who laid down their lives defending cattle or community."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publ