{"id": "9th-u3-q097", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-03-thiruppavai-thiruvempavai", "chapter_id": null, "topic_id": "topic-thiruppavai-thiruvempavai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒன்பதாம் வகுப்பு விரிவானப் பகுதியில் இடம்பெற்றுள்ள 'தாய்மைக்கு வறட்சி இல்லை' என்னும் மனிதநேயச் சிறுகதையின் ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "சு. சமுத்திரம்", "B": "கந்தர்வன்", "C": "அசோகமித்திரன்", "D": "கி. ராஜநாராயணன்"}, "explanation": "'தாய்மைக்கு வறட்சி இல்லை' என்னும் மனிதநேயச் சிறுகதையை எழுதியவர் சமூக எழுத்தாளர் சு. சமுத்திரம் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the heartwarming humanist short story 'Thaaimaikku Varatchi Illai'?", "media_id": null}], "options": {"A": "Su. Samuthiram", "B": "Kandharvan", "C": "Ashokamitran", "D": "Ki. Rajanarayanan"}, "explanation": "Su. Samuthiram authored 'Thaaimaikku Varatchi Illai' (Motherhood Knows No Drought)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 63, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 63", "url": null, "source_notes