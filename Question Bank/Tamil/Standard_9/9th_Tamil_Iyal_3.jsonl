": "9th Tamil, Unit 1, Page 56", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_3", "manimekalai", "seethalai_saathanaar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u3-q076", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-02-manimekalai", "chapter_id": null, "topic_id": "topic-manimekalai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஒட்டிய சமயத்து உறுபொருள் வாதிகள் / பட்டிமண்டபத்துப் பாங்கறிந்து ஏறுமின்' - என்ற அறிவுரை இடம்பெறும் காப்பியம் எது?", "media_id": null}], "options": {"A": "சிலப்பதிகாரம்", "B": "சீவக சிந்தாமணி", "C": "குண்டலகேசி", "D": "மணிமேகலை (விழாவறை காதை)"}, "explanation": "பல்வேறு சமயக் கருத்துகளை அறிந்த வாதிகள் பட்டிமண்டபத்தில் முறையாக விவாதம் செய்யுமாறு முரசு அறைவோன் அறிவித்ததாக மணிமேகலையின் விழாவறை காதையில் (அடி 60-61) இடம்பெற்றுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "In which epic does the exhortation 'Ottiya samayathu uruporul vaadhigal pattimandabatthup paangarindhu aerumin' appear?", "media_id": null}], "options": {"A": "Silappadikaram", "B": "Seevaga Chinthamani", "C": "Kundalakesi", "D": "Manimekalai (Vizhaavarai Kaadhai)"}, "explanation": "In Vizhaavarai Kaadhai (lines 60-61) of Manimekalai, philosophers are encouraged to engage in civilized debate in debating forums (Pattimandapam)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "clas