{"id": "9th-u3-q027", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-01-eru-thazhuvuthal", "chapter_id": null, "topic_id": "topic-eru-thazhuvuthal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழந்தமிழகத்தில் ஏறு தழுவுதலுக்கு வழங்கப்பட்ட மற்றொரு தொன்மையான பெயர் 'ஏறுகோள்' என்பதை உறுதிப்படுத்தும் இலக்கண நூல் எது?", "media_id": null}], "options": {"A": "நன்னூல்", "B": "அகத்தியம்", "C": "புறப்பொருள் வெண்பாமாலை", "D": "வீரசோழியம்"}, "explanation": "புறப்பொருள் வெண்பாமாலை என்னும் இலக்கண நூலில் 'ஏறுகோள்' என்னும் துறையில் காளையைத் தழுவும் வீர முறை விரிவாகக் கூறப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Which grammatical work confirms 'Erugol' as the ancient formal classical name for bull capture?", "media_id": null}], "options": {"A": "Nannool", "B": "Agathiyam", "C": "Purapporul Venbaamaalai", "D": "Veerasozhiyam"}, "explanation": "Purapporul Venbaamaalai explicitly designates this martial theme as 'Erugol' (grasping/taming the bull)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1,