{"id": "9th-u3-q013", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-01-eru-thazhuvuthal", "chapter_id": null, "topic_id": "topic-eru-thazhuvuthal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க காலத்தில் ஏறு தழுவுதல் நிகழ்வில் முல்லை நில ஆயர்களின் காதலும் வீரமும் எவ்விதம் பிணைக்கப்பட்டிருந்தது?", "media_id": null}], "options": {"A": "கொல்லேற்றுக் கோடஞ்சுவானை மறுபிறப்பிலும் ஆயர் மகள் விரும்பமாட்டாள் என்று வீரனுக்கே மகளை மணமுடித்தனர்", "B": "போட்டியில் வெற்றி பெற்றவருக்கு பொற்காசுகள் மட்டுமே வழங்கப்பட்டன", "C": "அரச குடும்பத்தைச் சேர்ந்த பெண்கள் மட்டுமே காளையை அடக்குவோரை மணந்தனர்", "D": "காளைகளை அடக்குவோருக்கு நிலங்கள் மட்டுமே தானமாக அளிக்கப்பட்டன"}, "explanation": "கலித்தொகையில் 'கொல்லேற்றுக் கோடஞ்சுவானை மறுமையும் புல்லாளே ஆய மகள்' என்று குறிப்பிடப்படுகிறது. காளையின் கொம்புக்கு அஞ்சும் கோழையை ஆயர்மகள் விரும்பமாட்டாள்; காளையை அடக்கும் வீரனுக்கே ஆயர்மகள் மாலையிடுவாள்."}, "en": {"blocks": [{"type": "text", "content": "How were romantic love and chivalric courage interwoven in ancient Sangam bull-embracing?", "media_id": null}], "options": {"A": "A pastoral maiden would refuse even in future births to embrace any man who feared a killer bull's horns", "B": "Winners received only monetary gold prizes", "C": "Only royal princesses were allowed to marry victorious tamers", "D": "Bull tamers were compensated solely with agrarian plots"}, "explanation": "Sangam poetry declares that an Aayar maiden would shun any suitor trembling at a bull's horns; victory in the ring was prerequisite for winning her hand."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 50, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 50", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_3", "eru_thazhuvuthal", "sanga_ilakkiyam"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
