{"id": "9th-u3-q121", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-04-thodar-aagupeyar", "chapter_id": null, "topic_id": "topic-thodar-aagupeyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தலைக்கு ஒரு பழம் கொடு' - இத்தொடரில் 'தலை' என்னும் சினைப்பெயர் மனிதருக்கு ஆகிவந்ததால் இது எவ்வகை ஆகுபெயர்?", "media_id": null}], "options": {"A": "சினையாகுபெயர்", "B": "முதலாகுபெயர்", "C": "எண்ணலளவை ஆகுபெயர்", "D": "காரியவாகுபெயர்"}, "explanation": "'தலை' என்னும் உறுப்பின் (சினையின்) பெயர் அதனை உடைய முழு மனிதனுக்கு ஆகிவந்ததால் இது 'சினையாகுபெயர்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "In 'Give one fruit per head', the limb name 'head' stands for the complete human person. What metonymy is this?", "media_id": null}], "options": {"A": "Sinaiyaagupeyar (Synecdoche / part-for-whole metonymy)", "B": "Whole-for-part metonymy", "C": "Numerical metonymy", "D": "Effect metonymy"}, "explanation": "'Thalai' (head), an anatomical member, stands for the complete human being, representing classic Sinaiyaagupeyar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 65, "chapter"