{"id": "9th-u3-q139", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-04-thodar-aagupeyar", "chapter_id": null, "topic_id": "topic-thodar-aagupeyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வள்ளுவர் வாய்மொழி' அல்லது 'நன்னூல் உரைத்தார்' - இதில் சொல் என்னும் பெயர் நூலுக்கு ஆகிவந்ததால் இது எவ்வகை ஆகுபெயர்?", "media_id": null}], "options": {"A": "காரியவாகுபெயர்", "B": "கருவியாகுபெயர்", "C": "சொல்லாகுபெயர்", "D": "பொருளாகுபெயர்"}, "explanation": "'உரை' அல்லது 'சொல்' என்னும் பெயர் அதன் பொருளாகிய நூலுக்கு ஆகிவருவது 'சொல்லாகுபெயர்' எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "In 'He expounded Nannool' or 'Valluvar's oral word', the word/speech stands for the treatise. What metonymy is this?", "media_id": null}], "options": {"A": "Effect metonymy", "B": "Instrument metonymy", "C": "Sollaagupeyar (Speech/word metonymy)", "D": "Substance metonymy"}, "explanation": "When 'Sol' (word/speech) refers metonymically to the treatise carrying that instruction, it is Sollaagupeyar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 65, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 65", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_3", "grammar", "thodar_ilakkanam", "aagupeyar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u3-q140", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-04-thodar-aagupeyar", "chapter_id": null, "topic_id": "topic-thodar-aagupeyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'விளக்கு முறிந்தது' - இதில் இடத்தின் பெயர் இடத்திலுள்ள பொருளுக்கு (திரிக்கு) ஆகிவந்ததால் இது எவ்வகை ஆகுபெயர்?", "media_id": null}], "options": {"A": "இடவாகுபெயர்", "B": "பொருளாகுபெயர்", "C": "கருவியாகுபெயர்", "D": "தானியாகுபெயர்"}, "explanation": "தானம் என்பது இடம்; தானி என்பது அவ்விடத்தில் உள்ள பொருள். விளக்கு என்பது தானம் (தகழி); ஆனால் முறிந்தது அதனுள் இருக்கும் திரி. எனவே இடத்தின் பெயர் பொருளிற்கு ஆகிவந்ததால் இது 'தானியாகுபெயர்' எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "In 'The lamp snapped (Vilakku murindhadhu)', the receptacle stands for the wick inside. What metonymy is this?", "media_id": null}], "options": {"A": "Spatial metonymy", "B": "Substance metonymy", "C": "Instrumental metonymy", "D": "Thaaniyaagupeyar (Container/receptacle-for-contained-content metonymy)"}, "explanation": "When the vessel/receptacle ('Thaani') stands for the inner substance situated within it, it is Thaaniyaagupeyar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational