{"id": "9th-u6-q110", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l4", "chapter_id": null, "topic_id": "space-centre-sriharikota", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியாவில் ஆந்திர மாநிலம் ஸ்ரீஹரிகோட்டாவில் அமைந்துள்ள ராக்கெட் ஏவுதள ஆய்வு மையம் யாருடைய பெயரால் அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "விக்ரம் சாராபாய் விண்வெளி மையம்", "B": "சதீஷ் தவான் விண்வெளி மையம் (SDSC - SHAR)", "C": "அப்துல் கலாம் ஏவுதளம்", "D": "இஸ்ரோ மையம்"}, "explanation": "ஆந்திர மாநிலம் ஸ்ரீஹரிகோட்டாவில் உள்ள இந்தியாவின் முதன்மை ராக்கெட் ஏவுதளம் புகழ்பெற்ற விஞ்ஞானி 'சதீஷ் தவான் விண்வெளி மையம்' (Satish Dhawan Space Centre) என அழைக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "After which renowned aerospace pioneer is the spaceport at Sriharikota in Andhra Pradesh named?", "media_id": null}], "options": {"A": "Vikram Sarabhai Space Centre", "B": "Satish Dhawan Space Centre (SDSC - SHAR)", "C": "Abdul Kalam Launch Base", "D": "ISRO Hub"}, "explanation": "The Sriharikota spaceport is officially designated the Satish Dhawan Space Centre (SDSC)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 110, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 110", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_6", "space_science", "satish_dhawan"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u6-q111", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l3", "chapter_id": null, "topic_id": "nachiyar-vocab-naranan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆண்டாள் நாச்சியார் திருமொழியில் 'நாரணன்', 'மதுசூதனன்' என்று யாரைக் குறிப்பிடுகிறார்?", "media_id": null}], "options": {"A": "சிவபெருமானை", "B": "முருகனை", "C": "திருமாலை (கண்ணனை)", "D": "பிரம்মাকে"}, "explanation": "ஆண்டாள் பாடிய நாச்சியார் திருமொழித் திருமணக் கனவுப் பாடல்களில் நாரணன், மதுசூதனன், கோவிந்தன் என்பவை காக்கும் கடவுளான திருமாலைக் (கண்ணனை) குறிக்கும் பெயர்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "Whom does Andal revere as 'Naaranan' and 'Madhusudhana' in her verses?", "media_id": null}], "options": {"A": "Lord Shiva", "B": "Lord Muruga", "C": "Lord Vishnu / Krishna (திருமால்)", "D": "Brahma"}, "explanation": "'Naaranan' and 'Madhusudhana' designate Lord Vishnu / Krishna."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 108, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 108", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_6", "andal", "deities"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u6-q112", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l4", "chapter_id": null, "topic_id": "gslv-mark3-sivan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியா சொந்தமாக உருவாக்கிய 'கிரையோஜெனிக்' (Cryogenic) இயந்திரத்தைக் கொண்டு விண்ணில் வெற்றிகரமாகப் பாய்ந்த 'ஜி.எஸ்.எல்.வி மார்க் 3' திட்டத்தின் திட்ட இயக்குநராகப் பணியாற்றியவர் யார்?", "media_id": null}], "options": {"A": "விக்ரம் சாராபாய்", "B": "மயில்சாமி அண்ணாதுரை", "C": "வளர்மதி", "D": "டாக்டர் கே. சிவன்"}, "explanation": "கடுங்குளிரூட்டப்பட்ட கிரையோஜெனிக் என்ஜின் தொழில்நுட்பத்தை வெற்றிகரமாக வடிவமைத்து 'GSLV Mark III' திட்ட இயக்குநராகச் செயலாற்றியவர் டாக்டர் கே. சிவன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who served as the Project Director for India's heavy-lift launch vehicle GSLV Mark III powered by an indigenous cryogenic upper stage?", "media_id": null}], "options": {"A": "Vikram Sarabhai", "B": "Mayilsamy Annadurai", "C": "Valarmathi", "D": "Dr. K. Sivan"}, "explanation": "Dr. K. Sivan directed the development and successful test of the indigenous GSLV Mark III cryogenic vehicle."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 111, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 111", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_6", "space_science", "gslv_mark3"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

