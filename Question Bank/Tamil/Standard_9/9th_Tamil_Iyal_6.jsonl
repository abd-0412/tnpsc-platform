{"id": "9th-u6-q005", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "atm-abbreviation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ATM' என்னும் ஆங்கிலக் குறும்பெயரின் சரியான விரிவாக்கம் யாது?", "media_id": null}], "options": {"A": "Automated Teller Machine (தானியங்கி பணப்பரிவர்த்தனை இயந்திரம்)", "B": "Any Time Money", "C": "Automatic Transaction Machine", "D": "All Time Money"}, "explanation": "ATM என்பதன் சரியான விரிவாக்கம் 'Automated Teller Machine' (தானியங்கி பணப்பரிவர்த்தனை இயந்திரம்) என்பதாகும். பேச்சு வழக்கில் உள்ள 'Any Time Money' என்பது தவறான விரிவாக்கம்."}, "en": {"blocks": [{"type": "text", "content": "What is the authentic technical expansion of the acronym 'ATM'?", "media_id": null}], "options": {"A": "Automated Teller Machine", "B": "Any Time Money", "C": "Automatic Transaction Machine", "D": "All Time Money"}, "explanation": "'Automated Teller Machine' is the standard universal engineering designation of an ATM."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 102, "chapter": null, "section": null, "reference": "9th Tami