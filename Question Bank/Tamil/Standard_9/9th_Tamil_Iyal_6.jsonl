{"id": "9th-u6-q113", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l5", "chapter_id": null, "topic_id": "punarchi-definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நிலைமொழியின் இறுதி எழுத்தும், வருமொழியின் முதல் எழுத்தும் இணைவதை இலக்கணத்தில் எவ்வாறு அழைப்பர்?", "media_id": null}], "options": {"A": "புணர்ச்சி", "B": "வழுவமைதி", "C": "தொகைநிலைத்தொடர்", "D": "ஆகுபெயர்"}, "explanation": "நிலைமொழியின் இறுதி எழுத்தும் வருமொழியின் முதல் எழுத்தும் இணைவதைப் புணர்ச்சி என்பர்."}, "en": {"blocks": [{"type": "text", "content": "What is the grammatical term for the coalescing or combination of the final letter of the preceding word and the initial letter of the incoming word?", "media_id": null}], "options": {"A": "Punarchi (புணர்ச்சி - Sandhi / Word coalescence)", "B": "Vazhuvamaithi (Grammatical tolerance)", "C": "Thogainilaithodar (Elliptical compound)", "D": "Aagupeyar (Metonymy)"}, "explanation": "The combination of the final letter of Nilaimozhi (preceding word) and the initial letter of Varumozhi (subsequent word) is called Punarchi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024