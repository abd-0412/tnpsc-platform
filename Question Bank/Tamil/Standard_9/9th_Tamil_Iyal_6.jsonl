{"id": "9th-u6-q114", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l5", "chapter_id": null, "topic_id": "uyireeru-meyyeeru", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நிலைமொழி ஈற்றெழுத்தின் அடிப்படையில் புணர்ச்சி எத்தனை வகைப்படும்?", "media_id": null}], "options": {"A": "நான்கு", "B": "இரண்டு (உயிரீறு, மெய்யீறு)", "C": "மூன்று", "D": "ஆறு"}, "explanation": "நிலைமொழியின் இறுதி எழுத்து உயிரெழுத்தாக இருந்தால் உயிரீறு (மணி = ண் + இ), மெய்யெழுத்தாக இருந்தால் மெய்யீறு (பொன்) என இருவகைப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Based on the terminal letter of the preceding word (Nilaimozhi), into how many types is it classified?", "media_id": null}], "options": {"A": "Four", "B": "Two (Uyireeru - vowel ending, and Meyyeeru - consonant ending)", "C": "Three", "D": "Six"}, "explanation": "Based on the ending letter of Nilaimozhi, it is classified into two types: Uyireeru (vocalic ending) and Meyyeeru (consonantal ending)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 113, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 113", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_6", "punarchi", "classification"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u6-q115", "schema_version": "1.0", "kind": "application", "level": "application", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l5", "chapter_id": null, "topic_id": "varumozhi-mudhal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வாழை + இலை' என்பதில் வருமொழி முதலெழுத்து எவ்வகை எழுத்து?", "media_id": null}], "options": {"A": "மெய்முதல்", "B": "உயிரீறு", "C": "உயிர்முதல்", "D": "மெய்யீறு"}, "explanation": "'இலை' என்ற வருமொழியின் முதல் எழுத்து 'இ' என்ற உயிரெழுத்து என்பதால் இது 'உயிர்முதல்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "In the sandhi combination 'வாழை + இலை', what type of letter is the initial letter of the incoming word (Varumozhi)?", "media_id": null}], "options": {"A": "Meymudhal (Consonant initial)", "B": "Uyireeru (Vowel ending)", "C": "Uyirmudhal (Vowel initial)", "D": "Meyyeeru (Consonant ending)"}, "explanation": "In 'ilai', the initial letter is 'i', which is a vowel, hence it is classified as 'Uyirmudhal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 113, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 113", "url": null, "source_notes": null}, "previous_year"