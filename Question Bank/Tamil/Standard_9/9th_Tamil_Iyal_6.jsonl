{"id": "9th-u6-q047", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "uzhavan-app-agriculture", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "விவசாயிகளுக்கு விதை இருப்பு, உர மானியம், பயிர்க் காப்பீடு போன்ற தகவல்களை வழங்கும் தமிழக அரசின் பிரத்யேகச் செயலி எது?", "media_id": null}], "options": {"A": "காவலன் செயலி", "B": "தீ செயலி", "C": "உழவன் செயலி (Uzhavan App)", "D": "மின்சேவை செயலி"}, "explanation": "விவசாயிகளுக்குத் தேவையான அனைத்துத் துறைசார்ந்த தகவல்களையும், மானியத் திட்டங்களையும் விரல்நுனியில் வழங்கத் தமிழக அரசு 'உழவன் செயலி'யை உருவாக்கியுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Which dedicated mobile portal was launched by the Government of Tamil Nadu providing farmers real-time data on seeds, fertilizers, and crop insurance?", "media_id": null}], "options": {"A": "Kavalan App", "B": "Thee App", "C": "Uzhavan App (உழவன் செயலி)", "D": "Minsevai App"}, "explanation": "'Uzhavan App' delivers agricultural extension, farm subsidies, and machinery hiring information to farmers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "p