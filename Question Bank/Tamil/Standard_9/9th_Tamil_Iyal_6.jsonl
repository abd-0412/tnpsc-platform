{"id": "9th-u6-q023", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "cash-deposit-machine", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வங்கிக்கு நேரில் சென்று படிவங்களை நிரப்பாமல், இயந்திரத்தின் வழியே நேரடியாகப் பணத்தை வங்கிக் கணக்கில் செலுத்தும் இயந்திரம் எது?", "media_id": null}], "options": {"A": "POS இயந்திரம்", "B": "Xerox இயந்திரம்", "C": "பணம் செலுத்தும் இயந்திரம் (Cash Deposit Machine - CDM / BNA)", "D": "Fax இயந்திரம்"}, "explanation": "வங்கி வேலை நேரத்தைக் கடந்து எந்நேரமும் வங்கிக் கணக்கில் பணத்தை உடனடியாக வரவு வைக்கும் தானியங்கி இயந்திரம் CDM (Cash Deposit Machine) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What self-service machine allows bank depositors to credit cash directly into bank accounts 24/7 without counter slips?", "media_id": null}], "options": {"A": "POS machine", "B": "Xerox machine", "C": "Cash Deposit Machine (CDM / BNA)", "D": "Fax machine"}, "explanation": "Cash Deposit Machines (CDM) accept and validate currency notes, instantly crediting the remitter's bank balance."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "ed