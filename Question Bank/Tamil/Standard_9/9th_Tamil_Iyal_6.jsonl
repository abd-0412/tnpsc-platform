{"id": "9th-u6-q099", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l4", "chapter_id": null, "topic_id": "isro-104-satellites-record", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இஸ்ரோ ஒரே ராக்கெட்டில் (PSLV-C37) 104 செயற்கைக்கோள்களை விண்ணில் செலுத்தி உலக சாதனை படைத்தபோது அதற்குத் தலைமை தாங்கிய முக்கியப் பொறியாளர் யார்?", "media_id": null}], "options": {"A": "அப்துல் கலாம்", "B": "விக்ரம் சாராபாய்", "C": "டாக்டர் கே. சிவன்", "D": "சதீஷ் தவான்"}, "explanation": "பி.எஸ்.எல்.வி சி-37 ராக்கெட் மூலம் ஒரே நேரத்தில் 104 செயற்கைக்கோள்களை விண்ணில் நிலைநிறுத்திய உலக சாதனையில் டாக்டர் கே. சிவன் அவர்களின் பங்கு முதன்மையானதாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which leader directed the landmark PSLV-C37 launch that deployed an unprecedented 104 satellites into orbit simultaneously?", "media_id": null}], "options": {"A": "Abdul Kalam", "B": "Vikram Sarabhai", "C": "Dr. K. Sivan", "D": "Satish Dhawan"}, "explanation": "Dr. K. Sivan played a principal leadership role in the historic 104-satellite launch record."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 111, "chap