{"id": "9th-u6-q091", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l4", "chapter_id": null, "topic_id": "mayilsamy-annadurai-book", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயில்சாமி அண்ணாதுரை தனது விண்வெளி அனுபவங்களை இளைய தலைமுறைக்காக எழுதிய புகழ்பெற்ற நூல் எது?", "media_id": null}], "options": {"A": "அக்னிச் சிறகுகள்", "B": "வானமே எல்லை", "C": "கையருகே நிலா", "D": "விண்ணைத் தாண்டி"}, "explanation": "மயில்சாமி அண்ணாதுரை சந்திரயான் 1 நிலவுப் பயண அனுபவங்களையும் அறிவியலையும் எளிய தமிழில் 'கையருகே நிலா' என்னும் நூலாக எழுதியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which famous science popularization book was penned by Mayilsamy Annadurai documenting the lunar mission journey?", "media_id": null}], "options": {"A": "Agni Chiragugal (Wings of Fire)", "B": "Vaanamae Ellai", "C": "Kaiyarugae Nila (கையருகே நிலா)", "D": "Vinnai Thaandi"}, "explanation": "'Kaiyarugae Nila' was authored by Mayilsamy Annadurai detailing India's journey to the Moon."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 110, "chapter": null, "section": null, "reference": "9th Tamil, Unit