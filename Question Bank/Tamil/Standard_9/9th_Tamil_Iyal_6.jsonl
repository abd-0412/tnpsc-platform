{"id": "9th-u6-q010", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "omr-scanner-technology", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "போட்டித் தேர்வுகளின் விடைத்தாள்களை (OMR Sheet) மிக விரைவாகவும் துல்லியமாகவும் மதிப்பீடு செய்யப் பயன்படும் கருவி எது?", "media_id": null}], "options": {"A": "தொலைநகல் கருவி", "B": "ஒளிவழிப் படிக்கும் கருவி (OMR - Optical Mark Reader)", "C": "ஒளிப்படி இயந்திரம்", "D": "அச்சுப்பொறி"}, "explanation": "போட்டித் தேர்வுகளில் தேர்வர்கள் மை தீட்டிய வட்டங்களை ஒளியின் மூலம் மிக விரைவாகப் படித்து மதிப்பெண்களைக் கணக்கிடும் கருவி OMR (Optical Mark Reader) அல்லது 'ஒளிவழிப் படிக்கும் கருவி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which scanning apparatus rapidly scans and scores competitive objective exam answer sheets by detecting shaded pencil/pen bubbles?", "media_id": null}], "options": {"A": "Fax machine", "B": "Optical Mark Reader (OMR)", "C": "Photocopier", "D": "Dot matrix printer"}, "explanation": "Optical Mark Recognition (OMR) scanners evaluate standardized multiple-choice answer sheets automatically."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "clas