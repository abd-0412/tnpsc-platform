{"id": "9th-u6-q002", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "xerox-greek-meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'செரோகிராபி' (Xerography) என்னும் கிரேக்கச் சொல்லின் பொருள் யாது?", "media_id": null}], "options": {"A": "நீர் வழி எழுத்து", "B": "உலர் எழுத்து முறை (Dry Writing)", "C": "மின்னணு எழுத்து", "D": "கண்ணாடி எழுத்து"}, "explanation": "'செரோகிராபி' (Xerography) என்பது கிரேக்க மொழியிலிருந்து வந்த சொல்லாகும். 'Xeros' என்றால் உலர் (Dry) என்றும், 'Graphos' என்றால் எழுத்து (Writing) என்றும் பொருள்படும். எனவே இது 'உலர் எழுத்து முறை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the literal translation of the Greek term 'Xerography'?", "media_id": null}], "options": {"A": "Hydrographic printing", "B": "Dry Writing (உலர் எழுத்து முறை)", "C": "Electronic typing", "D": "Mirror engraving"}, "explanation": "'Xerography' stems from the Greek words 'xeros' meaning dry and 'graphos' meaning writing, signifying a dry photocopying process."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 101, "chapter": 