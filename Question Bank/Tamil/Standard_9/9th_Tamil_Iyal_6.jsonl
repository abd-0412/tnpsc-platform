{"id": "9th-u6-q051", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "internet-banking-security", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இணைய வங்கிப் பரிவர்த்தனைகளின் போது வாடிக்கையாளர்களின் பணத்தைப் பாதுகாக்க வங்கிகளால் கைபேசிக்கு அனுப்பப்படும் தற்காலிகக் கடவுச்சொல் எது?", "media_id": null}], "options": {"A": "PIN", "B": "CVV", "C": "OTP (One Time Password - ஒருமுறை கடவுச்சொல்)", "D": "PAN"}, "explanation": "இணைய வழிப் பணப்பரிவர்த்தனையின் போது மோசடிகளைத் தடுக்க, குறிப்பிட்ட சில வினாடிகளுக்கு மட்டுமே செயல்படும் ஒருமுறை கடவுச்சொல் (OTP) வாடிக்கையாளரின் பதிவான எண்ணிற்கு அனுப்பப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What temporary dynamic authentication password is transmitted to account holders' registered phones during online financial checkout?", "media_id": null}], "options": {"A": "PIN", "B": "CVV", "C": "OTP (One Time Password - ஒருமுறை கடவுச்சொல்)", "D": "PAN"}, "explanation": "One Time Password (OTP) provides two-factor verification safeguarding electronic transactions."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "202