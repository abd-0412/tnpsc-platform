{"id": "9th-u6-q003", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "fax-inventor-bain", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறியீடுகளை மின்னாற்றல் உதவியுடன் அச்சிடுவதில் வெற்றி கண்டு, தொலைநகல் இயந்திரத்தை (Fax machine) 1843-ல் காப்புரிமை பெற்றவர் யார்?", "media_id": null}], "options": {"A": "செஸ்டர் கார்ல்சன்", "B": "ஜியோவானி காசில்லி", "C": "அலெக்சாண்டர் பெயின் (Alexander Bain)", "D": "ஜான் ஷெப்பர்ட் பாரன்"}, "explanation": "ஸ்காட்லாந்தைச் சேர்ந்த அலெக்சாண்டர் பெயின் என்பவர் 1843 ஆம் ஆண்டு குறியீடுகளை மின்னாற்றல் உதவியுடன் தாள்களில் அச்சிடும் முறையைக் கண்டறிந்து தொலைநகல் கருவிக்கான காப்புரிமையைப் பெற்றார்."}, "en": {"blocks": [{"type": "text", "content": "Which Scottish inventor patented an electric printing telegraph, the precursor to the modern Fax machine, in 1843?", "media_id": null}], "options": {"A": "Chester Carlson", "B": "Giovanni Caselli", "C": "Alexander Bain", "D": "John Shepherd-Barron"}, "explanation": "Alexander Bain patented the chemical electric recording telegraph in 1843, pioneering facsimile transmission."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "ter