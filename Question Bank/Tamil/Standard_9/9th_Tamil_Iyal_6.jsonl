{"id": "9th-u6-q159", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "xerox-dry-copying-inventor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒளிப்படி இயந்திரத்தை (Photocopier / Xerography) 1938-இல் முதன்முதலில் கண்டுபிடித்தவர் யார்?", "media_id": null}], "options": {"A": "அலெக்சாண்டர் பெயின்", "B": "ஜான் ஷெப்பர்ட் பாரன்", "C": "செஸ்டர் கார்ல்சன்", "D": "ஜியோவானி காசில்லி"}, "explanation": "1938-இல் அமெரிக்காவின் நியூயார்க்கைச் சேர்ந்த செஸ்டர் கார்ல்சன் என்பவர் கந்தகம் பூசப்பட்ட துத்தநாகத் தகட்டைக் கொண்டு முதல் ஒளிப்படியை எடுத்தார்."}, "en": {"blocks": [{"type": "text", "content": "Who invented the photocopier process (Xerography / Dry writing) in 1938?", "media_id": null}], "options": {"A": "Alexander Bain", "B": "John Shepherd-Barron", "C": "Chester Carlson (செஸ்டர் கார்ல்சன்)", "D": "Giovanni Caselli"}, "explanation": "Chester Carlson invented electrophotography (Xerography) in 1938 using a sulfur-coated zinc plate in New York."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 102, "chapter": null, "section": null, "reference":