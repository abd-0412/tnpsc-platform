{"id": "9th-u6-q006", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "atm-inventor-barron", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தானியங்கி பணப்பரிவர்த்தனை இயந்திரத்தை (ATM) வடிவமைத்து, 1967-ல் லண்டனில் நிறுவிய கண்டுபிடிப்பாளர் யார்?", "media_id": null}], "options": {"A": "செஸ்டர் கார்ல்சன்", "B": "ஜான் ஷெப்பர்ட் பாரன் (John Shepherd-Barron)", "C": "அலெக்சாண்டர் பெயின்", "D": "சார்லஸ் பாபேஜ்"}, "explanation": "ஜான் ஷெப்பர்ட் பாரன் என்பவர் தலைமையிலான குழுவினரே தானியங்கி பணப்பரிவர்த்தனை இயந்திரத்தை (ATM) வடிவமைத்து, 1967 ஜூன் 27 அன்று லண்டனில் பார்க்லேஸ் வங்கியில் முதன்முதலில் பயன்பாட்டிற்குக் கொண்டு வந்தனர்."}, "en": {"blocks": [{"type": "text", "content": "Which British inventor led the team that designed and installed the first operational cash dispensing ATM machine in London in 1967?", "media_id": null}], "options": {"A": "Chester Carlson", "B": "John Shepherd-Barron", "C": "Alexander Bain", "D": "Charles Babbage"}, "explanation": "John Shepherd-Barron conceived the automated cash dispenser deployed at Barclays Bank, Enfield, London on June 27, 1967."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpo