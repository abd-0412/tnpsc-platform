{"id": "9th-u6-q070", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l2", "chapter_id": null, "topic_id": "vairamuthu-state-award", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழக அரசால் கலைஞர்களுக்கு வழங்கப்படும் மிக உயரிய விருதான எவ்விருதினை வைரமுத்து பெற்றுள்ளார்?", "media_id": null}], "options": {"A": "பாரதி விருது", "B": "கலைமாமணி விருது", "C": "திருவள்ளுவர் விருது", "D": "அண்ணா விருது"}, "explanation": "கவிஞர் வைரமுத்து அவர்களின் கலை மற்றும் இலக்கியப் பங்களிப்பைப் பாராட்டித் தமிழக அரசு அவருக்குக் 'கலைமாமணி' விருதினை வழங்கிச் சிறப்பித்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Which prestigious state decoration instituted by the Tamil Nadu Government was conferred upon poet Vairamuthu?", "media_id": null}], "options": {"A": "Bharati Award", "B": "Kalaimamani Award", "C": "Thiruvalluvar Award", "D": "Anna Award"}, "explanation": "Vairamuthu was conferred the State's premier cultural honor 'Kalaimamani'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 107, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 107", "url": null, "sourc