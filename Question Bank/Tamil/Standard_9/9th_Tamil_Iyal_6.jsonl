{"id": "9th-u6-q041", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "uidai-expansion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆதார் அட்டைகளை வழங்கும் இந்திய அரசின் தலைமை அமைப்பான 'UIDAI' என்பதன் விரிவாக்கம் யாது?", "media_id": null}], "options": {"A": "Unique Identification Authority of India (இந்தியத் தனித்துவ அடையாள ஆணையம்)", "B": "Universal Identification Agency of India", "C": "United Information Directorate of India", "D": "Union Identity Development Association"}, "explanation": "UIDAI என்பதன் விரிவாக்கம் 'Unique Identification Authority of India' (இந்தியத் தனித்துவ அடையாள ஆணையம்) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What does the statutory acronym 'UIDAI' expand to?", "media_id": null}], "options": {"A": "Unique Identification Authority of India", "B": "Universal Identification Agency of India", "C": "United Information Directorate of India", "D": "Union Identity Development Association"}, "explanation": "UIDAI expands to 'Unique Identification Authority of India'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025",