{"id": "9th-u6-q157", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l4", "chapter_id": null, "topic_id": "valarmathi-first-satellite", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இஸ்ரோவின் ரிசாட்-1 திட்டத்தின் திட்ட இயக்குநராகப் பணியாற்றிய வளர்மதி பெற்ற அரசு விருது எது?", "media_id": null}], "options": {"A": "அப்துல் கலாம் விருது (2015)", "B": "கல்பனா சாவ்லா விருது", "C": "பாரத ரத்னா விருது", "D": "பத்மஸ்ரீ விருது"}, "explanation": "தமிழ்நாடு அரசு 2015-ஆம் ஆண்டு நிறுவிய முதல் டாக்டர் ஏ.பி.ஜே. அப்துல் கலாம் விருதைப் பெற்ற பெருமைக்குரியவர் விஞ்ஞானி வளர்மதி ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Which prestigious state award was conferred upon ISRO scientist Valarmathi (Project Director of RISAT-1)?", "media_id": null}], "options": {"A": "Dr. A.P.J. Abdul Kalam Award (2015 - First recipient)", "B": "Kalpana Chawla Award", "C": "Bharat Ratna", "D": "Padma Shri"}, "explanation": "Valarmathi was honored as the inaugural recipient of the Tamil Nadu Government's Dr. A.P.J. Abdul Kalam Award in 2015."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 112, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 112", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_6", "valarmathi", "awards"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u6-q158", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l4", "chapter_id": null, "topic_id": "sivan-aerospace-system", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இஸ்ரோவில் செயற்கைக்கோள் ஏவு ஊர்தியின் பாதையைத் துல்லியமாகக் கணக்கிட டாக்டர் கே. சிவன் உருவாக்கிய மென்பொருள் எது?", "media_id": null}], "options": {"A": "விக்ரம் சாப்ட்வேர்", "B": "சித்தாரா (SITARA)", "C": "ரோகிணி கால்குலேட்டர்", "D": "சந்திரயான் டிராக்கர்"}, "explanation": "செயற்கைக்கோள் ஏவு ஊர்தி பற்றிய கணக்கீட்டுச் செயலியை (சித்தாரா - SITARA) உருவாக்கியவர் டாக்டர் கே. சிவன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Which software application was developed by Dr. K. Sivan to compute the real-time trajectories of launch vehicles?", "media_id": null}], "options": {"A": "Vikram Software", "B": "SITARA (சித்தாரா)", "C": "Rohini Calculator", "D": "Chandrayaan Tracker"}, "explanation": "Dr. K. Sivan developed the specialized trajectory calculation software called SITARA."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 111, "chapter": null, "section": null, "reference": "9th Tamil, Un