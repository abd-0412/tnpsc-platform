{"id": "9th-u6-q020", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "smart-card-chip", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தற்கால வங்கி அட்டைகளிலும் குடும்ப அட்டைகளிலும் (Smart card) தகவல்களைப் பாதுகாப்பாகப் பதிவு செய்யப் பொருத்தப்பட்டுள்ள சாதனம் எது?", "media_id": null}], "options": {"A": "கண்ணாடி இழை", "B": "காந்தக் கம்பிகள் மட்டும்", "C": "ஒளி உமிழும் டையோடு", "D": "நுண்சில்லு (Microchip)"}, "explanation": "ஸ்மார்ட் கார்டுகளிலும் வங்கிக் கார்டுகளிலும் தகவல்களைக் குறியீட்டு வடிவில் பாதுகாப்பாகச் சேமித்து வைக்க 'நுண்சில்லு' (Microchip / EMV chip) பொருத்தப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "What secure technological component is embedded into contemporary bank smart cards and electronic ration cards to store encrypted data?", "media_id": null}], "options": {"A": "Optical fiber", "B": "Magnetic wires only", "C": "Light-emitting diode", "D": "Microchip (நுண்சில்லு)"}, "explanation": "Integrated circuit microchips (EMV chips) store encrypted account data securely on smart cards."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edit