{"id": "9th-u6-q106", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l3", "chapter_id": null, "topic_id": "nachiyar-vocab-ammi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆண்டாளின் திருமணக் கனவுப் பாடலில் இடம்பெறும் திருமணச் சடங்கு எது?", "media_id": null}], "options": {"A": "கடல் குளித்தல்", "B": "பொரிமுகந்து தீயிடல் மற்றும் அம்மி மிதித்தல்", "C": "வில் வளைத்தல்", "D": "மலர் பறித்தல்"}, "explanation": "'வரிசிலை வாள்முகத்து என்னை மார்வன் / பொரிமுகந்து தீயிட்டு என் கைமேல் வைத்து / அம்மி மிதிக்கக் கனாக்கண்டேன் தோழீ நான்' என்று ஆண்டாள் திருமணச் சடங்குகளைப் பாடுகிறாள்."}, "en": {"blocks": [{"type": "text", "content": "Which traditional wedding ritual does Andal envision in her matrimonial dream verses?", "media_id": null}], "options": {"A": "Sea immersion", "B": "Offering puffed grain into the sacred fire and treading the grindstone (அம்மி மிதித்தல்)", "C": "Stringing the bow", "D": "Flower gathering"}, "explanation": "Andal describes the Vedic wedding rituals of offering puffed rice (Laja Homa) and treading the grindstone (Ammi Midithal)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "202