{"id": "9th-u6-q096", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l4", "chapter_id": null, "topic_id": "k-sivan-schooling-tamil", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இஸ்ரோ தலைவராக உயர்ந்த டாக்டர் கே. சிவன் அவர்களின் பள்ளிப் படிப்பின் சிறப்பு என்ன?", "media_id": null}], "options": {"A": "வெளிநாட்டில் பயின்றார்", "B": "தனியார் பள்ளியில் ஆங்கில வழியில் பயின்றார்", "C": "வீட்டிலேயே கல்வி பயின்றார்", "D": "கிராமத்து அரசுப் பள்ளியில் தமிழ் வழியில் பயின்றவர்"}, "explanation": "டாக்டர் கே. சிவன் ஏழ்மையான குடும்பத்தில் பிறந்து, கிராமத்து அரசுப் பள்ளியில் தமிழ் வழியில் படித்துக் கடின உழைப்பால் உலகின் தலைசிறந்த விண்வெளி ஆய்வு மையமான இஸ்ரோவின் தலைவராக உயர்ந்தார்."}, "en": {"blocks": [{"type": "text", "content": "What inspiring scholastic hallmark distinguishes the early education of ISRO Chairman Dr. K. Sivan?", "media_id": null}], "options": {"A": "Educated in elite Western academies", "B": "Private English-medium schooling", "C": "Homeschooled", "D": "Educated through Tamil medium in a rural government school"}, "explanation": "Dr. K. Sivan completed his schooling exclusively in Tamil medium at a local government village school in Kanyakumari."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tami