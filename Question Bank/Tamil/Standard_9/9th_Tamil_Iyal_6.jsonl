{"id": "9th-u6-q009", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "pos-machine-swiping", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வணிக வளாகங்களிலும் கடைகளிலும் பற்று அட்டை (Debit card), கடன் அட்டை (Credit card) தேய்த்துக் கட்டணம் செலுத்தும் கருவி எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "POS (Point of Sale) இயந்திரம் / விற்பனை முனையக் கருவி", "B": "ATM இயந்திரம்", "C": "செராக்ஸ் இயந்திரம்", "D": "ஸ்கேனர் கருவி"}, "explanation": "கடைகளில் பணமில்லாப் பரிவர்த்தனை மூலம் கட்டணம் செலுத்தப் பயன்படும் அட்டை தேய்ப்பு இயந்திரம் POS (Point of Sale) இயந்திரம் அல்லது விற்பனை முனையக் கருவி எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What is the electronic terminal utilized at merchant checkouts to swipe debit and credit cards termed?", "media_id": null}], "options": {"A": "POS (Point of Sale) machine", "B": "ATM machine", "C": "Xerox machine", "D": "Scanner machine"}, "explanation": "The terminal is designated as a POS (Point of Sale) terminal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 103, "ch