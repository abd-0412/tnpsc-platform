{"id": "9th-u6-q017", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "hank-telefax-development", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "1902 ஆம் ஆண்டு ஜெர்மனி நாட்டைச் சேர்ந்த ஆர்தர் கார்ன் (Arthur Korn) எந்தத் தொழில்நுட்பத்தின் மூலம் தொலைநகல் முறையில் புகைப்படங்களை அனுப்பினார்?", "media_id": null}], "options": {"A": "ஒளிமின் உறைவு (Photo-electric) தொழில்நுட்பம்", "B": "ரேடியோ அலைகள் மட்டும்", "C": "கரித்தாள் அச்சிடுதல்", "D": "லேசர் தொழில்நுட்பம்"}, "explanation": "1902 ஆம் ஆண்டு ஆர்தர் கார்ன் என்பவர் ஒளிமின் தொழில்நுட்பத்தைப் பயன்படுத்தித் தொலைநகல் வழியாகப் புகைப்படங்களை கம்பியில்லா முறையில் அனுப்பும் நுட்பத்தை உருவாக்கினார்."}, "en": {"blocks": [{"type": "text", "content": "Using which photoelectric breakthrough did German physicist Arthur Korn transmit wireless facsimiles of photographs in 1902?", "media_id": null}], "options": {"A": "Photo-electric technology", "B": "Shortwave radio only", "C": "Carbon paper stamping", "D": "Laser diode technology"}, "explanation": "Arthur Korn utilized photoelectric cells to transmit photographic images electronically over telegraph lines."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educa