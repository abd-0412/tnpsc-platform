{"id": "9th-u6-q095", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l4", "chapter_id": null, "topic_id": "valarmathi-abdul-kalam-award", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழக அரசால் முதன்முதலில் உருவாக்கப்பட்ட 'டாக்டர் ஏ.பி.ஜே. அப்துல் கலாம் விருதினை' (2015) பெற்ற முதல் பெண் விஞ்ஞானி யார்?", "media_id": null}], "options": {"A": "மயில்சாமி அண்ணாதுரை", "B": "டாக்டர் கே. சிவன்", "C": "விஞ்ஞானி வளர்மதி", "D": "ஆனந்தி லட்சுமி"}, "explanation": "2015 ஆம் ஆண்டு தமிழக அரசால் நிறுவப்பட்ட முதல் 'டாக்டர் ஏ.பி.ஜே. அப்துல் கலாம் விருது' விஞ்ஞானி வளர்மதி அவர்களுக்கு வழங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Who became the inaugural recipient of the Dr. A. P. J. Abdul Kalam Award instituted by the Tamil Nadu Government in 2015?", "media_id": null}], "options": {"A": "Mayilsamy Annadurai", "B": "Dr. K. Sivan", "C": "Scientist Valarmathi", "D": "Anandi Lakshmi"}, "explanation": "Scientist Valarmathi received the first Dr. A. P. J. Abdul Kalam Award instituted by the Tamil Nadu Government in 2015."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 112, "