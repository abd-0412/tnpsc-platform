{"id": "9th-u6-q013", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "barcode-scanner", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பொருள்களின் பாக்கெட்டுகளில் உள்ள கருப்பு வெள்ளைக் கோடுகளைப் படித்து, பொருளின் விலை மற்றும் விவரங்களை உடனுக்குடன் கணிணிக்கு அனுப்பும் கருவி எது?", "media_id": null}], "options": {"A": "பட்டைக் குறியீட்டுப் படிப்பான் (Barcode Reader)", "B": "ஒளிப்படி இயந்திரம்", "C": "குரல் வழி உணர் கருவி", "D": "தொலைநகல் கருவி"}, "explanation": "பல்பொருள் அங்காடிகளில் பொருள்களின் மீதான விலைக் குறியீட்டைப் படித்துப் பில் தயாரிப்பதற்குப் பயன்படும் கருவி 'பட்டைக் குறியீட்டுப் படிப்பான்' (Barcode Reader) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which optical device scans the black-and-white parallel stripes printed on retail merchandise to instantaneously retrieve item details and prices?", "media_id": null}], "options": {"A": "Barcode Reader (பட்டைக் குறியீட்டுப் படிப்பான்)", "B": "Photocopier", "C": "Voice sensor", "D": "Fax machine"}, "explanation": "A Barcode Reader optically decodes printed universal product code barcodes to process retail sales."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educationa