{"id": "9th-u6-q036", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "e-commerce-shopping", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இணையதளம் மற்றும் செயலிகள் வழியாகத் தேவையான பொருள்களைத் தேடி, இல்லத்திற்கே வரவழைத்து வாங்கும் வர்த்தக முறை எது?", "media_id": null}], "options": {"A": "நேரடிச் சந்தை வர்த்தகம்", "B": "பண்டமாற்று முறை", "C": "கையிருப்பு விற்பனை", "D": "மின்வணிகம் / இணைய வர்த்தகம் (E-Commerce)"}, "explanation": "மின்வணிகம் (E-Commerce) மூலம் நுகர்வோர் உலகம் முழுவதிலும் உள்ள விற்பனையாளர்களிடமிருந்து பொருள்களைத் தேர்வு செய்து இணைய வழியாகவே பணம் செலுத்திப் பெற்றுக்கொள்ள முடிகிறது."}, "en": {"blocks": [{"type": "text", "content": "What commercial system allows consumers to select and purchase commodities online, receiving doorstep parcel delivery?", "media_id": null}], "options": {"A": "Direct village fair trading", "B": "Barter system", "C": "Warehouse clearance", "D": "E-Commerce (மின்வணிகம்)"}, "explanation": "E-Commerce empowers consumers to browse digital catalogs, pay electronically, and receive home delivery."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "fu