{"id": "9th-u6-q021", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "internet-connectivity-india", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியாவில் இணையப் பயன்பாடும் மின்னணுப் பணப்பரிவர்த்தனைகளும் எந்த நூற்றாண்டின் தொடக்கத்தில் தீவிர வளர்ச்சி கண்டன?", "media_id": null}], "options": {"A": "இருபத்தோராம் நூற்றாண்டு (2000-க்குப் பின்)", "B": "பத்தொன்பதாம் நூற்றாண்டு", "C": "இருபதாம் நூற்றாண்டின் முற்பகுதி", "D": "பதினெட்டாம் நூற்றாண்டு"}, "explanation": "இந்தியாவில் 2000 ஆம் ஆண்டிற்குப் பிறகு இருபத்தோராம் நூற்றாண்டின் தொடக்கத்தில் கணினிமயமாக்கலும் இணையப் பயன்பாடும் மின்னல் வேகத்தில் பரவிப் பெரும் புரட்சியை ஏற்படுத்தின."}, "en": {"blocks": [{"type": "text", "content": "At the onset of which century did internet penetration and electronic digital payments undergo explosive growth across India?", "media_id": null}], "options": {"A": "Twenty-first century (post-2000)", "B": "Nineteenth century", "C": "Early twentieth century", "D": "Eighteenth century"}, "explanation": "The early 21st century heralded widespread digital network expansion and electronic governance across India."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educatio