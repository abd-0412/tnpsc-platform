{"id": "9th-u6-q040", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "digital-tickets-environmental-benefit", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இணைய வழிப் பயணச்சீட்டுகள் மற்றும் மின்சான்றிதழ்கள் பயன்பாட்டின் மூலம் எத்தகைய சுற்றுச்சூழல் நன்மை ஏற்படுகிறது?", "media_id": null}], "options": {"A": "மின்சாரம் மிச்சமாகிறது", "B": "பிளாஸ்டிக் பயன்பாடு கூடுகிறது", "C": "வாகனப் புகை குறைகிறது", "D": "காகிதப் பயன்பாடு குறைந்து, மரங்கள் வெட்டப்படுவது தடுக்கப்படுகிறது"}, "explanation": "பயணச்சீட்டுகளைக் காகிதத்தில் அச்சிடாமல் கைபேசியிலேயே காட்ட அனுமதிப்பதன் மூலம் காகித உற்பத்தி குறைகிறது; இதனால் காகிதத்திற்காகப் பெருமளவில் மரங்கள் வெட்டப்படுவது தடுத்துச் சுற்றுச்சூழல் பாதுகாக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What crucial ecological benefit is achieved by shifting to paperless digital mobile tickets and e-certificates?", "media_id": null}], "options": {"A": "Power saving", "B": "Increased plastic manufacture", "C": "Reduction of vehicular exhaust", "D": "Drastic curtailment of paper consumption, preventing deforestation of trees"}, "explanation": "Paperless digital ticketing reduces wood pulp demand, curbing deforestation and conserving forest ecosystems."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": 