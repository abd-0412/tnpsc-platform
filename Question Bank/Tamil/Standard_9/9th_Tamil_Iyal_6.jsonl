{"id": "9th-u6-q045", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "upi-payment-apps", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கைபேசி மூலம் உடனடிப் பணப்பரிவர்த்தனை செய்ய இந்திய தேசிய கொடுப்பனவுக் கழகத்தால் (NPCI) உருவாக்கப்பட்ட கட்டமைப்பு எது?", "media_id": null}], "options": {"A": "UPI (Unified Payments Interface - ஒருங்கிணைந்த கட்டண இடைமுகம்)", "B": "SWIFT", "C": "POS", "D": "ATM"}, "explanation": "இந்தியாவில் கூகுள் பே, போன்பே, பேடிஎம் போன்ற செயலிகள் வழியாக வங்கிக் கணக்கிலிருந்து நேரடியாகப் பணம் அனுப்ப உதவும் கட்டமைப்பு UPI (Unified Payments Interface) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which digital payment architecture was established by the National Payments Corporation of India (NPCI) for instant mobile fund transfers?", "media_id": null}], "options": {"A": "UPI (Unified Payments Interface)", "B": "SWIFT", "C": "POS", "D": "ATM"}, "explanation": "Unified Payments Interface (UPI) developed by NPCI enables real-time interbank mobile fund transfers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 105,