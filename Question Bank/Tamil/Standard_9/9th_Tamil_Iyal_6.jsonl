{"id": "9th-u6-q054", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "internet-education", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கல்வித் துறையில் மாணவர்கள் பள்ளிக் கட்டணம் செலுத்துதல், நுழைவுத்தேர்வு விண்ணப்பித்தல், மதிப்பெண் சான்றிதழ் பெறுதல் போன்றவற்றை எதன் வழியாக எளிதாக மேற்கொள்கின்றனர்?", "media_id": null}], "options": {"A": "தபால் நிலையம் வழியாக", "B": "இணைய வழிக் கல்வி இணையதளங்கள் (Online Educational Portals)", "C": "தந்தி முறை", "D": "சுவரொட்டிகள்"}, "explanation": "இணைய வழி இணையதளங்கள் வழியே மாணவர்கள் நுழைவுத் தேர்வுகளுக்கு விண்ணப்பித்தல், கட்டணம் செலுத்துதல், தேர்வு முடிவுகள் அறிதல், மதிப்பெண் சான்றிதழ்களைப் பதிவிறக்குதல் போன்றவற்றை இருந்த இடத்திலிருந்தே செய்ய முடிகிறது."}, "en": {"blocks": [{"type": "text", "content": "How do modern students conveniently apply for admissions, pay semester fees, and download marksheets remotely?", "media_id": null}], "options": {"A": "Through post offices", "B": "Through online educational portals and e-learning gateways", "C": "Via telegram", "D": "Through public flyers"}, "explanation": "Digital educational portals streamline college applications, fee remittances, and marksheet verification."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nad