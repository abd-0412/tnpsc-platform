{"id": "9th-u6-q050", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "irctc-growth-comparison", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "2002 ஆம் ஆண்டு ஆகஸ்ட் 3-ல் IRCTC தொடங்கிய முதல் நாளில் பதிவான மொத்த டிக்கெட்டுகளின் எண்ணிக்கை எத்தனை?", "media_id": null}], "options": {"A": "100 டிக்கெட்டுகள்", "B": "29 டிக்கெட்டுகள்", "C": "500 டிக்கெட்டுகள்", "D": "15 டிக்கெட்டுகள்"}, "explanation": "IRCTC இணையதளம் தொடங்கப்பட்ட முதல் நாளான 2002 ஆகஸ்ட் 3 அன்று இந்தியா முழுவதும் வெறும் 29 டிக்கெட்டுகளே பதிவு செய்யப்பட்டன. இன்று அது கோடிக்கணக்கான டிக்கெட்டுகளைப் பதிவு செய்கிறது."}, "en": {"blocks": [{"type": "text", "content": "How many railway tickets in total were booked across India on the maiden day of IRCTC online booking on August 3, 2002?", "media_id": null}], "options": {"A": "100 tickets", "B": "29 tickets", "C": "500 tickets", "D": "15 tickets"}, "explanation": "On its launch day (August 3, 2002), IRCTC booked a modest total of 29 train tickets."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 104, "chapter": null, "section": null, "refere