{"id": "9th-u6-q093", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l4", "chapter_id": null, "topic_id": "k-sivan-sitara-software", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ராக்கெட் ஏவுதலின் போது விண்கலத்தின் பாதையைக் கணிக்கும் 'சித்தாரா' (SITARA) என்னும் மென்பொருளை உருவாக்கியவர் யார்?", "media_id": null}], "options": {"A": "டாக்டர் கே. சிவன்", "B": "மயில்சாமி அண்ணாதுரை", "C": "வளர்மதி", "D": "அப்துல் கலாம்"}, "explanation": "ராக்கெட் ஏவப்படும்போது அதன் சரியான திசையையும் பாதையையும் துல்லியமாகக் கணக்கிடும் 'சித்தாரா' (SITARA) என்னும் மென்பொருளை உருவாக்கிய மென்பொருள் வல்லுநர் டாக்டர் கே. சிவன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who engineered the trajectory calculation software 'SITARA' used during rocket launches in ISRO missions?", "media_id": null}], "options": {"A": "Dr. K. Sivan", "B": "Mayilsamy Annadurai", "C": "Valarmathi", "D": "Abdul Kalam"}, "explanation": "Dr. K. Sivan developed the indigenous trajectory trajectory simulator software SITARA."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 111, "chapter": null, "section": null, "reference