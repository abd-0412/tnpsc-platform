{"id": "9th-u6-q089", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l4", "chapter_id": null, "topic_id": "chandrayaan1-mayilsamy-annadurai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியாவின் முதலாவது நிலவு ஆய்வுத் திட்டமான 'சந்திரயான் 1' (Chandrayaan-1, 2008) திட்ட இயக்குநராகப் பணியாற்றிய தமிழக விஞ்ஞானி யார்?", "media_id": null}], "options": {"A": "மயில்சாமி அண்ணாதுரை", "B": "டாக்டர் கே. சிவன்", "C": "டாக்டர் ஏ.பி.ஜே. அப்துல் கலாம்", "D": "நம்பி நாராயணன்"}, "explanation": "கோவை மாவட்டம் பொள்ளாச்சி அருகிலுள்ள காரைப்பாடி கிராமத்தைச் சேர்ந்த மயில்சாமி அண்ணாதுரை அவர்கள் இந்தியாவின் வரலாற்றுச் சிறப்புமிக்க 'சந்திரயான் 1' திட்ட இயக்குநராகப் பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Which Tamil aerospace scientist served as the Project Director of India's maiden lunar exploration mission, Chandrayaan-1, in 2008?", "media_id": null}], "options": {"A": "Mayilsamy Annadurai", "B": "Dr. K. Sivan", "C": "Dr. A. P. J. Abdul Kalam", "D": "Nambi Narayanan"}, "explanation": "Dr. Mayilsamy Annadurai, hailing from Koraavadi near Pollachi in Coimbatore, served as the Project Director of Chandrayaan-1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational S