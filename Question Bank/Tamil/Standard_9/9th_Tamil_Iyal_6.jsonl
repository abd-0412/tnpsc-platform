{"id": "9th-u6-q118", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l5", "chapter_id": null, "topic_id": "vikara-punarchi-types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "விகாரப் புணர்ச்சி எத்தனை வகைப்படும்?", "media_id": null}], "options": {"A": "இரண்டு", "B": "மூன்று (தோன்றல், திரிதல், கெடுதல்)", "C": "நான்கு", "D": "ஐந்து"}, "explanation": "புணர்ச்சியின் போது ஏற்படும் மாற்றங்களின் அடிப்படையில் விகாரப் புணர்ச்சி தோன்றல், திரிதல், கெடுதல் என மூவகைப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Into how many forms is Vikara Punarchi (transformational sandhi) divided based on phonetic alterations?", "media_id": null}], "options": {"A": "Two", "B": "Three (Thondral - insertion, Thrithal - mutation, Keduthal - elision)", "C": "Four", "D": "Five"}, "explanation": "Vikara Punarchi is divided into three types: Thondral (insertion), Thrithal (mutation/transformation), and Keduthal (elision/deletion)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 114", "url": null, "source_not