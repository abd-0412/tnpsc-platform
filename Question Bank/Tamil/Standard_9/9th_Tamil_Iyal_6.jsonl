{"id": "9th-u6-q059", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l2", "chapter_id": null, "topic_id": "vairamuthu-national-awards-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்திய அரசின் சிறந்த திரைப்படப் பாடலாசிரியருக்கான தேசிய விருதினை (National Award) கவிஞர் வைரமுத்து எத்தனை முறை பெற்றுள்ளார்?", "media_id": null}], "options": {"A": "ஐந்து முறை", "B": "ஆறு முறை", "C": "ஏழு முறை", "D": "எட்டு முறை"}, "explanation": "கவிஞர் வைரமுத்து சிறந்த பாடலாசிரியருக்கான இந்திய அரசின் தேசிய விருதினை 7 முறை வென்று தேசிய அளவில் சாதனை படைத்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "How many times has poet Vairamuthu won the National Film Award for Best Lyrics from the Government of India?", "media_id": null}], "options": {"A": "Five times", "B": "Six times", "C": "Seven times", "D": "Eight times"}, "explanation": "Kavignar Vairamuthu holds the distinguished record of winning the National Film Award for Best Lyricist 7 times."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 107, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 107", "url"