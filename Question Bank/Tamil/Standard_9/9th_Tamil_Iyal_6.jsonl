{"id": "9th-u6-q103", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l4", "chapter_id": null, "topic_id": "mayilsamy-raman-award", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அறிவியல் துறையில் சிறந்த பங்களிப்பை வழங்கியதற்காக மயில்சாமி அண்ணாதுரை அவர்களுக்கு வழங்கப்பட்ட மதிப்புமிக்க அறிவியல் விருது எது?", "media_id": null}], "options": {"A": "சாந்தி ஸ்வரூப் பட்நாகர் விருது", "B": "ஹோமி பாபா விருது", "C": "சர் சி.வி. இராமன் அறிவியல் விருது", "D": "மேக்நாத் சாஹா விருது"}, "explanation": "விஞ்ஞானி மயில்சாமி அண்ணாதுரை அவர்களின் விண்வெளி ஆய்வுகளைப் பாராட்டி அவருக்கு 'சர் சி.வி. இராமன் அறிவியல் விருது' வழங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which prestigious state scientific award was conferred on Mayilsamy Annadurai for his aerospace research contributions?", "media_id": null}], "options": {"A": "Shanti Swarup Bhatnagar Prize", "B": "Homi Bhabha Award", "C": "Sir C. V. Raman Science Award", "D": "Meghnad Saha Award"}, "explanation": "Mayilsamy Annadurai was honored with the Sir C. V. Raman Science Award."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 11