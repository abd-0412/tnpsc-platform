{"id": "9th-u6-q027", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "telefax-telegraph-connection", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொலைநகல் (Fax) என்பது எதன் தொழில்நுட்ப வளர்ச்சியாக உருவானதாகும்?", "media_id": null}], "options": {"A": "வானொலி அலைகள்", "B": "தொலைக்காட்சி ஒளிபரப்பு", "C": "தந்தி (Telegraph) தொடர்பு முறை", "D": "செயற்கைக்கோள் தொலைபேசி"}, "explanation": "தந்தி (Telegraph) மூலம் எழுத்துகளைக் கம்பியில்லா மின்னாற்றல் வழியே அனுப்பிய முறையின் தொடர்ச்சியாகவே, தாள்களில் உள்ள ஆவணங்களையும் படங்களையும் அனுப்பும் தொலைநகல் (Fax) உருவானது."}, "en": {"blocks": [{"type": "text", "content": "Facsimile (Fax) transmission developed as an evolutionary technological successor of which communication system?", "media_id": null}], "options": {"A": "Radio broadcasting", "B": "Television transmission", "C": "Telegraphy (தந்தி)", "D": "Satellite telephony"}, "explanation": "Fax machines evolved directly from electric telegraph transmission systems."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 102, "chapter": null, "section": null, "