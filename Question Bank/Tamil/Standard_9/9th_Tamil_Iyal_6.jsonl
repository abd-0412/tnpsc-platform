{"id": "9th-u6-q094", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l4", "chapter_id": null, "topic_id": "valarmathi-risat1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அரியலூரில் பிறந்து, 2012-ல் வெற்றிகரமாக ஏவப்பட்ட 'ரிசாட்-1' (RISAT-1) ரேடார் இமேஜிங் செயற்கைக்கோள் திட்ட இயக்குநராகப் பணியாற்றிய பெண் விஞ்ஞானி யார்?", "media_id": null}], "options": {"A": "கல்பனா சாவ்லா", "B": "வளர்மதி", "C": "சுனிதா வில்லியம்ஸ்", "D": "ரிது கரிதால்"}, "explanation": "அரியலூரைச் சேர்ந்த வளர்மதி அவர்கள் இஸ்ரோவின் 'ரிசாட் 1' செயற்கைக்கோள் திட்ட இயக்குநராகப் பணியாற்றி, தமிழக அரசின் முதல் 'அப்துல் கலாம் விருது' பெற்ற பெருமைக்குரியவர்."}, "en": {"blocks": [{"type": "text", "content": "Which female scientist from Ariyalur served as Project Director for the radar imaging satellite RISAT-1 launched in 2012?", "media_id": null}], "options": {"A": "Kalpana Chawla", "B": "Valarmathi", "C": "Sunita Williams", "D": "Ritu Karidhal"}, "explanation": "N. Valarmathi from Ariyalur directed the indigenous radar imaging satellite mission RISAT-1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 112, "chapter"