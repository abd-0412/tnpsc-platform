{"id": "9th-u6-q076", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l2", "chapter_id": null, "topic_id": "vairamuthu-vaigai-novel", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வைகை அணை கட்டப்பட்டதால் இடம்பெயர்ந்த 14 கிராம மக்களின் சோக வரலாற்றைப் பேசும் வைரமுத்துவின் நாவல் எது?", "media_id": null}], "options": {"A": "கருவாச்சி காவியம்", "B": "வில்லோடு வா நிலவே", "C": "சிகரங்களை நோக்கி", "D": "கள்ளிக்காட்டு இதிகாசம்"}, "explanation": "வைகை அணை கட்டுமானத்தின் போது நீரில் மூழ்கிய 14 கிராமங்களின் வரலாற்றையும் மக்களின் கண்ணீரையும் இரத்தமும் சதையுமாகப் பதிவு செய்த புதினம் 'கள்ளிக்காட்டு இதிகாசம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which poignant novel of Vairamuthu documents the tragedy of 14 submerged villages during the construction of the Vaigai Dam?", "media_id": null}], "options": {"A": "Karuvaachi Kaaviyam", "B": "Villodu Vaa Nilavae", "C": "Sigarangalai Nokki", "D": "Kallikkaattu Idhigaasam"}, "explanation": "'Kallikkaattu Idhigaasam' depicts the displaced villagers whose native habitats were swallowed by the Vaigai reservoir."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "editio