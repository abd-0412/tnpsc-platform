{"id": "9th-u6-q084", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l2", "chapter_id": null, "topic_id": "vairamuthu-literature-era", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வைரமுத்து நவீனத் தமிழ் இலக்கியத்தில் எவ்வகை இலக்கிய வடிவங்களின் வளர்ச்சிக்கு ஆழமான பங்களிப்பு செய்துள்ளார்?", "media_id": null}], "options": {"A": "பழைய வெண்பாக்கள் மட்டும்", "B": "அந்தாதி இலக்கியம் மட்டும்", "C": "பரணி இலக்கியம் மட்டும்", "D": "புதுக்கவிதை, திரைப்பாடல்கள் மற்றும் வட்டார நாவல்கள்"}, "explanation": "கவிஞர் வைரமுத்து புதுக்கவிதை வடிவிலும், தமிழ் திரைப்படப் பாடல்களிலும், கிராமிய வட்டார நாவல்களிலும் (கள்ளிக்காட்டு இதிகாசம், கருவாச்சி காவியம்) தனிப்பெரும் முத்திரை பதித்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "To which genres of modern Tamil literature has Vairamuthu contributed profound creative works?", "media_id": null}], "options": {"A": "Venba quatrains only", "B": "Anthadhi prosody only", "C": "Parani martial epics only", "D": "Modern free verse (Pudhukkavithai), film lyrics, and regional realist novels"}, "explanation": "Vairamuthu's versatility spans modern free verse, cinematic poetry, and regional socio-realist novels."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Text