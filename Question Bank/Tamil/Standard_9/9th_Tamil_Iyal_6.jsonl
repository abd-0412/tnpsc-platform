{"id": "9th-u6-q007", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l1", "chapter_id": null, "topic_id": "atm-pin-origin", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜான் ஷெப்பர்ட் பாரன் தொடக்கத்தில் ஏ.டி.எம் கார்டுக்கு எத்தனை இலக்கக் கடவுச்சொல்லை (PIN) வைக்க எண்ணியிருந்தார்?", "media_id": null}], "options": {"A": "நான்கு இலக்கங்கள்", "B": "எட்டு இலக்கங்கள்", "C": "ஆறு இலக்கங்கள்", "D": "பத்து இலக்கங்கள்"}, "explanation": "பாரன் முதலில் 6 இலக்கக் கடவுச்சொல்லை வைக்க விரும்பினார். ஆனால் அவரது மனைவி கரோலின் அவர்களால் நான்கு இலக்கங்களுக்கு மேல் நினைவில் வைத்துக்கொள்ள இயலவில்லை என்பதால், அதை 4 இலக்கப் பின் (PIN) எண்ணாக மாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "How many digits did John Shepherd-Barron originally propose for the ATM Personal Identification Number (PIN)?", "media_id": null}], "options": {"A": "Four digits", "B": "Eight digits", "C": "Six digits", "D": "Ten digits"}, "explanation": "Shepherd-Barron originally envisioned a 6-digit PIN, but reduced it to 4 digits because his wife Caroline could comfortably memorize only four figures."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_ye