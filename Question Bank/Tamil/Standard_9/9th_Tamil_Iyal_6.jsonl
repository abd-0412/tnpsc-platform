{"id": "9th-u6-q065", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l2", "chapter_id": null, "topic_id": "vairamuthu-lines-dream", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"கிளிக்கு இறக்கை இருக்கும் வரைக்கும் பறக்கும் நிலா; நிலவுக்குப் போகும் வரைக்கும் __________ வேண்டும்!\" - கவிஞர் வைரமுத்துவின் வரிகளில் விடுபட்ட சொல் எது?", "media_id": null}], "options": {"A": "கனவு இருக்க", "B": "பணம் இருக்க", "C": "வீரம் இருக்க", "D": "நினைவு இருக்க"}, "explanation": "'கிளிக்கு இறக்கை இருக்கும் வரைக்கும் பறக்கும் நிலா; நிலவுக்குப் போகும் வரைக்கும் கனவு இருக்க வேண்டும்' என்று இளைஞர்கள் சளைக்காமல் கனவு கண்டு உழைக்க வேண்டும் என வைரமுத்து ஊக்கப்படுத்துகிறார்."}, "en": {"blocks": [{"type": "text", "content": "\"As long as the parrot retains wings it soars; until reaching the moon one must retain __________!\" - Identify the missing word.", "media_id": null}], "options": {"A": "Kanavu irukka (கனவு இருக்க - Aspiration / Dream)", "B": "Panam irukka", "C": "Veeram irukka", "D": "Ninaivu irukka"}, "explanation": "Vairamuthu inspires relentless pursuit of great scientific aspirations (Kanavu)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9