{"id": "8th-u6-q725", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "textbook-eval-q1-bold-speech", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூல் மதிப்பீட்டு வினா: \"மனதில் தோன்றிய கருத்துகளைத் தயங்காமல் __________ பேச வேண்டும்.\""}], "options": {"A": "அஞ்சாமல்", "B": "அஞ்சி", "C": "அணிகலன்களாக", "D": "மகுடமாக"}, "explanation": "பாடநூல் மதிப்பீடு (பக். 116 வினா 1): 'மனதில் தோன்றிய கருத்துகளை அஞ்சாமல் பேச வேண்டும்'. பாடலில் சிங்கி 'தோணிய காரியம் அஞ்சாமல் சொல்லடா சிங்கா' என்று சிங்கனை உற்சாகப்படுத்துகிறாள்."}, "en": {"blocks": [{"type": "text", "content": "Textbook Evaluation Question: \"Thoughts that arise in the mind must be expressed __________ without hesitation.\""}], "options": {"A": "Anjaamal (Fearlessly)", "B": "Anji (With fear)", "C": "Anigalangalaaga (As ornaments)", "D": "Magudamaaga (As a crown)"}, "explanation": "Textbook Evaluation (Page 116, Q1): 'Thoughts in the mind must be spoken fearlessly (Anjaamal)'. Singi encourages Singan to speak without fear."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "