// 8-ஆம் வகுப்பு தமிழ் - இயல் 6: பாருக்குள்ளே நல்ல நாடு (மொத்த வினாக்கள்: 140)
// ==============================================================================

// ==============================================================================
// பாடம் 1: சிங்கி பெற்ற பரிசு (கவிதைப்பேழை - குற்றாலக் குறவஞ்சி / திரிகூடராசப்பக் கவிராயர்) [Q701 - Q728]
// திரிகூடராசப்பக் கவிராயர் (தென்காசி, திருக்குற்றாலநாதர் கோவில் வித்துவான், கவிதைக் கிரீடம் திருக்குற்றாலக் குறவஞ்சி, திருக்குற்றாலத் தலபுராணம், திருக்குற்றால மாலை, குழல்வாய்மொழி பிள்ளைத்தமிழ்); சிங்கி குறி சொல்லிப் பெற்ற பரிசுகள்: சேலத்து நாடு (சிலம்பு), கலிங்க நாடு (தண்டை), பாண்டியன் மகள் (பாடகம்), குற்றாலநாதர் கோவில் பெண்கள் (மணிக்கச்சம்), கண்டிய நாடு (கால் மோதிரம், பீலி); சிங்கன் வினவிய விலங்கு/பூச்சி உவமைகள்: பாம்பு (காலில் நெளிவது), மண்புழு/நாங்கூழ் (வளைந்து நெளிவது), தவளை (கால் கட்டைவிரலில் குந்தியிருப்பது), குண்டலப்பூச்சி (காதில் தொங்குவது); இயற்கை & பக்தி நயம், எதுகை, மோனை, இயைபு நயங்கள்
// ==============================================================================
{"id": "8th-u6-q701", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "kavirayar-profile-statement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திரிகூடராசப்பக் கவிராயர் மற்றும் அவரது நூல்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. திரிகூடராசப்பக் கவிராயர் தென்காசி மாவட்டத்தில் பிறந்த தமிழ் அறிஞர் ஆவார்.\n2. இவர் 'திருக்குற்றாலநாதர் கோவில் வித்துவான்' என்னும் சிறப்புப் பெயர் பெற்றவர்.\n3. திருக்குற்றாலத் தலபுராணம், திருக்குற்றால மாலை, குழல்வாய்மொழி பிள்ளைத்தமிழ் உள்ளிட்ட பல நூல்களை இவர் இயற்றியுள்ளார்.\n4. இவரது நூல்களுள் 'திருக்குற்றாலக் குறவஞ்சி' திரிகூடராசப்பக் கவிராயரின் 'கவிதைக் கிரீடம்' என்று போற்றப்படுகிறது."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 2, 3 மட்டும் சரி; 4 தவறு", "C": "1, 3, 4 மட்டும் சரி; 2 தவறு", "D": "2, 4 மட்டும் சரி; 1, 3 தவறு"}, "explanation": "நூல் வெளி (பக். 115): திரிகூடராசப்பக் கவிராயர் தென்காசி மாவட்டத்தில் பிறந்தவர். 'திருக்குற்றாலநாதர் கோவில் வித்துவான்' என்னும் சிறப்புப் பெயர் பெற்றவர். திருக்குற்றாலத் தலபுராணம், திருக்குற்றால மாலை, குழல்வாய்மொழி பிள்ளைத்தமிழ் உள்ளிட்ட பல நூல்களை எழுதியுள்ளார். இவரது நூல்களுள் திருக்குற்றாலக் குறவஞ்சி 'திரிகூடராசப்பக் கவிராயரின் கவிதைக் கிரீடம்' என்று போற்றப்படுகிறது. அனைத்தும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding Thirikooda Rasappa Kavirayar and his literary creations:\n1. Thirikooda Rasappa Kavirayar was born in Tenkasi district.\n2. He held the honorary title 'Thirukutralanathar Kovil Vidhwan'.\n3. He authored several texts including Thirukutrala Thala Puranam, Thirukutrala Maalai, and Kuzhalvaaimozhi Pillaithamil.\n4. Among his works, 'Thirukutrala Kuravanji' is celebrated as the 'Poetic Crown' of Thirikooda Rasappa Kavirayar."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "Only 1, 2, 3 are correct; 4 is incorrect", "C": "Only 1, 3, 4 are correct; 2 is incorrect", "D": "Only 2, 4 are correct; 1, 3 are incorrect"}, "explanation": "All statements are direct facts from Page 115 'Author Info': Born in Tenkasi district, titled 'Thirukutralanathar Kovil Vidhwan', authored multiple devotional works, and his Thirukutrala Kuravanji is hailed as his crowning poetic masterpiece."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 115, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "author-info", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q702", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "singi-gifts-countries-statement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிங்கி தான் குறி சொல்லிப் பெற்ற பரிசுகள் பற்றிக் கூறும் விவரங்களை ஆராய்க:\n1. சேலத்து நாட்டில் குறி சொல்லியதற்காகச் சிங்கி சிலம்பினைப் பரிசாகப் பெற்றாள்.\n2. பாண்டியனின் மகளுக்குக் குறி சொன்னதற்காகச் சிங்கிக்குக் கலிங்க நாட்டின் தண்டை பரிசாக வழங்கப்பட்டது.\n3. குற்றாலநாதர் கோவிலைச் சேர்ந்த பெண்கள் சிங்கிக்கு 'மணிக்கச்சம்' என்னும் அணிகலனை அணிவித்துப் பாராட்டினர்.\n4. சிங்கி கண்டிய நாட்டில் குறி சொன்னதற்காகக் கால் மோதிரமும் பீலியும் பரிசாகப் பெற்றாள்."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 3, 4 சரி; 2 தவறு", "C": "2, 3, 4 சரி; 1 தவறு", "D": "1, 2 சரி; 3, 4 தவறு"}, "explanation": "கூற்று 2 தவறானது. பாடலின் பொருள் (பக். 115): பாண்டியனின் மகள் பரிசாக வழங்கிய அணிகலன் 'பாடகம்' ஆகும். 'முறுக்குகள் நிறைந்த தண்டை'யைப் பரிசாக அளித்தது 'கலிங்க நாட்டார்' ஆவர். கூற்று 2-ல் இவை தவறாகக் கலந்து தரப்பட்டுள்ளன. எனவே 1, 3, 4 சரி; 2 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the details regarding the gifts and ornaments received by Singi for fortune-telling:\n1. Singi received anklet Silambu as a gift for fortune-telling in the territory of Salem.\n2. For foretelling the fortune of the Pandya princess, Singi was awarded the Thandai of Kalinga country.\n3. The maiden devotees of Kutralanathar temple adorned Singi with the bell-anklet ornament Manikkaccham.\n4. From Kandy (Sri Lanka), Singi obtained toe-rings (Kaal Modhiram) and Peeli ornaments as gifts."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "1, 3, 4 are correct; 2 is incorrect", "C": "2, 3, 4 are correct; 1 is incorrect", "D": "Only 1, 2 are correct; 3, 4 are incorrect"}, "explanation": "Statement 2 is false. The Pandya princess awarded 'Paadagam'; the coiled 'Thandai' was gifted by the people of Kalinga. Statements 1, 3, and 4 are authentic details from Page 115."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 115, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "singi-gifts", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q703", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "singan-similes-statement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிங்கன் சிங்கியின் அணிகலன்களைப் பார்த்துக் கேட்ட வேடிக்கையான வினாக்கள் பற்றிய கூற்றுகளை ஆராய்க:\n1. சிங்கியின் காலில் கிடந்த சிலம்பைப் பார்த்து, பெரிய விரியன் பாம்பு கடித்துக் கிடக்கிறதோ என்று சிங்கன் மருண்டான்.\n2. சிலம்புக்கு மேலே கிடந்த கலிங்க நாட்டுத் தண்டையைப் பார்த்துத் 'திருகு முறுக்கு' என்று வியந்து வினவினான்.\n3. சிங்கியின் காலில் நெளிந்த பாடகத்தைப் பார்த்து 'மண்டையோட்டுப் பூச்சி சுருண்டு கிடக்கிறது' என்று சிங்கன் வினவினான்.\n4. காலில் கட்டப்பட்டிருந்த மணிக்கச்சத்தைப் பார்த்து 'இறந்துபோன தவளை கட்டப்பட்டிருப்பது ஏன்?' என்று கேட்டான்."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "2, 3, 4 சரி; 1 தவறு", "C": "1, 2, 4 சரி; 3 தவறு", "D": "1, 3 சரி; 2, 4 தவறு"}, "explanation": "கூற்று 3 தவறானது. பாடலில் பாடகத்தைப் பார்த்து 'நீண்டு குறுகியும் நாங்கூழுப் போல (மண்புழுப் போல) நெளிந்த நெளிவு என்னடி?' என்றே சிங்கன் வினவினான். சுண்டு விரலில் இருந்த பீலி/மோதிரத்தைத்தான் 'குண்டலப் பூச்சி' என்றார். எனவே 1, 2, 4 சரி; 3 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements regarding the amusing animal-metaphors used by Singan upon seeing Singi's ornaments:\n1. Looking at the Silambu on Singi's feet, Singan wondered fearfully if a large Russell's viper was biting her.\n2. Inspecting the Kalinga Thandai worn above the Silambu, he questioned its twisted spiral curls.\n3. Observing the undulating Paadagam on her foot, Singan asked why a skull-beetle was coiled around her ankle.\n4. Glancing at the Manikkaccham tied to her feet, he asked why a dead frog appeared strapped to her foot."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "2, 3, 4 are correct; 1 is incorrect", "C": "1, 2, 4 are correct; 3 is incorrect", "D": "Only 1, 3 are correct; 2, 4 are incorrect"}, "explanation": "Statement 3 is incorrect. The Paadagam was compared to an earthworm (Naangoozhu / manpuzhu). The coiled centipede/beetle (Gundalap poochy) was compared to the toe-ring (Peeli). Hence 1, 2, 4 are true; 3 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "similes", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q704", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "kuravanji-genre-statement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குற்றாலக் குறவஞ்சி இலக்கிய வடிவம் மற்றும் தன்மை குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. குற்றாலக் குறவஞ்சி என்பது நாட்டுப்புறப் பாடல் வடிவில் அமைந்த சிறந்த சிற்றிலக்கியமாகும்.\n2. குறவஞ்சி இலக்கியத்தில் குறவன் - குறத்தி உரையாடல் வழியே நாட்டு வளம், மலை வளம் ஆகியவை நயம்பட விவரிக்கப்படுகின்றன.\n3. இப்பாடலில் சிங்கன் சிங்கியிடம் 'மனதில் தோன்றிய கருத்துகளை யாரிடமும் கூறாமல் உள்ளுக்குள் மறைக்க வேண்டும்' என்று அறிவுறுத்தினான்.\n4. குற்றாலக் குறவஞ்சி என்னும் உலகப் புகழ்பெற்ற நூலை இயற்றியவர் கார்மேகக் கவிஞர் ஆவார்."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 3 சரி; 2, 4 தவறு", "C": "3, 4 சரி; 1, 2 தவறு", "D": "1, 2 சரி; 3, 4 தவறு"}, "explanation": "கூற்றுகள் 1, 2 சரியானவை. கூற்றுகள் 3, 4 தவறானவை:\n- பாடலில் 'ஆர்க்கும் பயமில்லை தோன்றிய காரியம் அஞ்சாமல் சொல்லடா' என்று தைரியம் கூறுவது சிங்கி ஆகும் (கூற்று 3 தவறு).\n- குற்றாலக் குறவஞ்சியை இயற்றியவர் திரிகூடராசப்பக் கவிராயர் ஆவார்; கார்மேகக் கவிஞர் அல்ல (கூற்று 4 தவறு). எனவே 1, 2 சரி; 3, 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding the genre and characteristics of Kutrala Kuravanji:\n1. Kutrala Kuravanji is a renowned Minor Literary work (Sitrilakkiyam) composed in folk lyrical ballad form.\n2. Through the playful dialogue between Kuravan (Singan) and Kurathi (Singi), regional culture and mountain landscapes are celebrated.\n3. In the poem, Singan advises Singi that one should suppress all internal thoughts and conceal them from others.\n4. The world-famous text Kutrala Kuravanji was authored by Kaarmega Kavignar."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "1, 3 are correct; 2, 4 are incorrect", "C": "3, 4 are correct; 1, 2 are incorrect", "D": "1, 2 are correct; 3, 4 are incorrect"}, "explanation": "Statements 1 and 2 are correct. Statement 3 is false because Singi tells Singan to speak fearlessly ('Anjaamal sollada'). Statement 4 is false because the author is Thirikooda Rasappa Kavirayar (Kaarmega Kavignar wrote Kongu Mandala Sathakam)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "genre", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q705", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "singi-responses-statement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'சிங்கி பெற்ற பரிசு' பாடலில் சிங்கியின் பதில்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. பூங்கொத்துகள் சூடிய கூந்தலை உடைய பெண்களுக்குக் குறி சொல்வதற்காகத் தான் பல ஊர்களுக்குச் சென்றதாகக் கூறுகிறாள்.\n2. தன் காலில் பாம்பு போல் தோன்றுவது சேலத்து நாட்டில் தான் பரிசாகப் பெற்ற சிலம்பு என்று விளக்குகிறாள்.\n3. பாண்டிய மன்னனின் மகள் தன் கைக்குறிக்காகப் பரிசளித்த அணிகலன் பாடகம் என்று சிங்கனிடம் தெரிவிக்கிறாள்.\n4. குற்றாலநாதரின் கோவில் பெண்கள் அணிவித்த மணிக்கச்சமும், கண்டிய நாட்டின் கால்மோதிரமும் தன் கால்களில் இருப்பதாக உரைக்கிறாள்."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 2, 3 மட்டும் சரி; 4 தவறு", "C": "2, 3, 4 மட்டும் சரி; 1 தவறு", "D": "1, 4 மட்டும் சரி; 2, 3 தவறு"}, "explanation": "பாடநூல் பக். 114-115: கொத்தாரும் குழலார்க்குக் குறி சொல்லச் சென்றதாகக் கூறுதல், சேலத்துச் சிலம்பு, பாண்டியன் மகள் தந்த பாடகம், குற்றாலநாதர் கோவில் பெண்கள் தந்த மணிக்கச்சம், கண்டிய நாட்டின் கால்மோதிரம் ஆகிய அனைத்தும் சிங்கியின் பதில்களாகப் பாடலில் இடம்பெற்றுள்ளன. அனைத்தும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements describing Singi's answers in the poem 'Singi Petra Parisu':\n1. She explains that she visited distant towns to tell fortunes to women adorned with floral bouquets in their tresses.\n2. She clarifies that what looks like a serpent on her foot is the Silambu received as a reward in Salem territory.\n3. She discloses to Singan that the Pandya princess rewarded her palmistry with the anklet called Paadagam.\n4. She reveals that the temple women of Lord Kutralanathar tied the Manikkaccham, and Kandy gifted her toe-rings."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "Only 1, 2, 3 are correct; 4 is incorrect", "C": "Only 2, 3, 4 are correct; 1 is incorrect", "D": "Only 1, 4 are correct; 2, 3 are incorrect"}, "explanation": "All four statements are direct, unadulterated facts from the verses of Thirukutrala Kuravanji recounting Singi's replies to Singan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "singi-replies", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q706", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "kuravanji-metaphors-analysis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிங்கன் - சிங்கி உரையாடலில் இடம்பெற்றுள்ள உவமைகள் மற்றும் அணிகலன்கள் பற்றிய கூற்றுகளை ஆராய்க:\n1. காலில் அணிந்த சிலம்பிற்குப் பெரிய விரியன் பாம்பு உவமையாகக் கூறப்பட்டுள்ளது.\n2. காலில் சுழன்று கிடக்கும் பாடகத்திற்கு விஷமுள்ள தேள் உவமையாகக் கூறப்பட்டுள்ளது.\n3. காலில் கட்டப்பட்ட மணிக்கச்சத்திற்கு இறந்துபோன தவளை உவமையாகக் கூறப்பட்டுள்ளது.\n4. சுண்டு விரலில் நெளிந்த பீலி மற்றும் மோதிரத்திற்குக் குண்டலப் பூச்சி உவமையாகக் கூறப்பட்டுள்ளது."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 3, 4 சரி; 2 தவறு", "C": "2, 3, 4 சரி; 1 தவறு", "D": "1, 2 சரி; 3, 4 தவறு"}, "explanation": "கூற்று 2 தவறானது. பாடலில் பாடகத்திற்குத் 'தேள்' உவமையாகக் கூறப்படவில்லை; 'நீண்டு குறுகியும் நாங்கூழுப் போல' (மண்புழுப் போல) என்று நாங்கூழே உவமையாக்கப்பட்டுள்ளது. ஏனைய 1, 3, 4 கூற்றுகள் சரியானவை. எனவே 1, 3, 4 சரி; 2 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements regarding the creature-metaphors and ornaments in the Singan-Singi dialogue:\n1. A massive Russell's viper is compared to the ankle Silambu.\n2. A venomous scorpion is compared to the sinuous foot ornament Paadagam.\n3. A deceased frog is compared to the jingling Manikkaccham bound to the feet.\n4. A coiled centipede/earwig bug (Gundalap poochy) is compared to the toe-ring (Peeli)."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "1, 3, 4 are correct; 2 is incorrect", "C": "2, 3, 4 are correct; 1 is incorrect", "D": "Only 1, 2 are correct; 3, 4 are incorrect"}, "explanation": "Statement 2 is false. The text explicitly compares Paadagam to an earthworm ('Naangoozhu / manpuzhu'), not a scorpion. Statements 1, 3, and 4 are authentic comparisons."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "similes", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q707", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "kuravanji-significance-statement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குற்றாலக் குறவஞ்சியின் இலக்கியச் சிறப்புகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. குற்றாலக் குறவஞ்சி திருக்குற்றாலத்தின் இயற்கை எழிலையும், குற்றாலநாதரின் சிறப்பையும் பாடும் நூலாகும்.\n2. தமிழ் இலக்கியத்தில் குறவஞ்சி என்பது 96 வகைச் சிற்றிலக்கியங்களுள் ஒன்றாகும்.\n3. திரிகூடராசப்பக் கவிராயர் இயற்றிய 'குழல்வாய்மொழி பிள்ளைத்தமிழ்' மட்டுமே அவரது கவிதைக் கிரீடம் எனப்படுகிறது.\n4. குற்றாலக் குறவஞ்சி நாடக வடிவில் மேடைகளில் ஆடப்பட்டு மக்களின் பெரும் வரவேற்பைப் பெற்ற இலக்கியமாகும்."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 3, 4 சரி; 2 தவறு", "C": "1, 2, 4 சரி; 3 தவறு", "D": "2, 3, 4 சரி; 1 தவறு"}, "explanation": "கூற்று 3 தவறானது. பாடநூல் நூல்வெளி பக். 115: திரிகூடராசப்பக் கவிராயரின் 'திருக்குற்றாலக் குறவஞ்சி'தான் அவரது 'கவிதைக் கிரீடம்' என்று போற்றப்படுகிறது; குழல்வாய்மொழி பிள்ளைத்தமிழ் அல்ல. ஏனைய 1, 2, 4 கூற்றுகள் சரியானவை. எனவே 1, 2, 4 சரி; 3 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements on the literary significance of Kutrala Kuravanji:\n1. Kutrala Kuravanji celebrates the pristine scenic beauty of Kutralam and the glory of Lord Kutralanathar.\n2. In Tamil poetics, Kuravanji is recognized as one of the traditional 96 genres of Minor Literature (Sitrilakkiyam).\n3. 'Kuzhalvaaimozhi Pillaithamil' is the sole text commemorated as the poetic crown of Thirikooda Rasappa Kavirayar.\n4. Kutrala Kuravanji was famously performed in dramatic dance-drama formats across temple stages with immense popularity."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "1, 3, 4 are correct; 2 is incorrect", "C": "1, 2, 4 are correct; 3 is incorrect", "D": "2, 3, 4 are correct; 1 is incorrect"}, "explanation": "Statement 3 is false. Textbook Page 115 notes that 'Thirukutrala Kuravanji' is hailed as his poetic crown (Kavithaik Kireedam), not Pillaithamil. Statements 1, 2, and 4 are accurate."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 115, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "literary-value", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q708", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "singi-serpent-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): சிங்கி கண்டிய நாட்டில் குறி சொன்னதற்காகப் பரிசாக ஒரு பெரிய நச்சு விரியன் பாம்பைப் பெற்றுத் தன் காலில் கட்டியிருந்தாள்.\nகாரணம் (R): குறவர்கள் காடுகளில் நச்சுப் பாம்புகளைப் பிடித்துத் தம் கால்களில் அணிந்து நடனமாடுவது தமிழர் மரபாகும்."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் கூற்றை விளக்கவில்லை", "C": "கூற்று (A) சரி; காரணம் (R) தவறு", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறானவை. சிங்கியின் காலில் இருந்தது பாம்பு அல்ல; அது சேலத்து நாட்டில் குறி சொல்லிப் பரிசாகப் பெற்ற 'சிலம்பு' ஆகும். சிங்கன் வேடிக்கையாக அதனை விரியன் பாம்பு போல் உள்ளதே என்று மருண்டான். எனவே இரண்டும் தவறு."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): As a reward for telling fortunes in Kandy, Singi received a venomous Russell's viper and tied it to her foot.\nReason (R): It is ancient Tamil tradition for hill tribes to catch venomous vipers and tie them around ankles while dancing."}], "options": {"A": "Both (A) and (R) are correct, and (R) explains (A)", "B": "Both (A) and (R) are correct, but (R) does not explain (A)", "C": "(A) is correct; (R) is incorrect", "D": "Both (A) and (R) are incorrect"}, "explanation": "Both (A) and (R) are false. Singi wore an ornate ankle Silambu earned in Salem, which Singan humorously likened to a viper. No live serpent was strapped to her ankles."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "assertion-reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q709", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "kutrala-kuravanji-crown-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தமிழ் இலக்கிய உலகில் திரிகூடராசப்பக் கவிராயரின் 'திருக்குற்றாலக் குறவஞ்சி' அவரது 'கவிதைக் கிரீடம்' என்று போற்றப்படுகிறது.\nகாரணம் (R): நாடகச் சுவையும், இசை நயமும், சந்த அமைப்பும், எளிய மக்கள் மொழியும் இணைந்து குற்றாலக் குறவஞ்சியைத் தமிழின் தலைசிறந்த சிற்றிலக்கியமாக உயர்த்தியுள்ளன."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் கூற்றை விளக்கவில்லை", "C": "கூற்று (A) சரி; காரணம் (R) தவறு", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரியானவை; காரணம் கூற்றை விளக்குகிறது. திரிகூடராசப்பக் கவிராயர் பல நூல்களை இயற்றியிருந்தாலும், திருக்குற்றாலக் குறவஞ்சியின் இணையற்ற கவித்துவமும் நாடகச் சுவையும் காரணமாகவே அது அவரது கவிதைக் கிரீடம் என்று போற்றப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): In Tamil literature, Thirikooda Rasappa Kavirayar's 'Thirukutrala Kuravanji' is celebrated as his 'Poetic Crown'.\nReason (R): The exquisite blend of dramatic flair, melodious rhythm, poetic meter, and lively folk idiom elevates it as a premier masterpiece of Tamil Minor Literature."}], "options": {"A": "Both (A) and (R) are correct, and (R) explains (A)", "B": "Both (A) and (R) are correct, but (R) does not explain (A)", "C": "(A) is correct; (R) is incorrect", "D": "Both (A) and (R) are incorrect"}, "explanation": "Both Assertion and Reason are true and (R) correctly explains (A). The artistic brilliance and musical lyricism of Thirukutrala Kuravanji earned it the coveted title 'Poetic Crown' (Kavithaik Kireedam)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 115, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "assertion-reason", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q710", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "kavirayar-temple-poet-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): சிங்கி தன் குறி சொல்லும் கைத்திறனால் பல நாடுகளுக்கும் சென்று உயர்மதிப்புமிக்க பரிசுகளைப் பெற்றுத் திரும்பினாள்.\nகாரணம் (R): திரிகூடராசப்பக் கவிராயர் மதுரை மீனாட்சியம்மன் கோவிலின் தலைமை அரசவைப் புலவராகப் பணியாற்றிப் பட்டம் பெற்றவர்."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "B": "கூற்று (A) சரி; காரணம் (R) தவறு", "C": "கூற்று (A) தவறு; காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று (A) சரி; காரணம் (R) தவறு. சிங்கி பல நாடுகளுக்கும் சென்று குறி சொல்லிப் பரிசுகள் பெற்றது உண்மை. ஆனால் கவிராயர் பெற்ற சிறப்புப் பெயர் 'திருக்குற்றாலநாதர் கோவில் வித்துவான்' என்பதாகும் (மதுரை மீனாட்சியம்மன் கோவில் அல்ல). எனவே காரணம் தவறு."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): By virtue of her palmistry and fortune-telling skill, Singi traveled across diverse kingdoms and returned with prized ornaments.\nReason (R): Thirikooda Rasappa Kavirayar served as the chief court poet of the Madurai Meenakshi Amman Temple and received titles."}], "options": {"A": "Both (A) and (R) are correct, and (R) explains (A)", "B": "(A) is correct; (R) is incorrect", "C": "(A) is incorrect; (R) is correct", "D": "Both (A) and (R) are incorrect"}, "explanation": "(A) is correct; (R) is false. Singi did travel across kingdoms. However, Kavirayar was the resident scholar of Thirukutralanathar Temple in Tenkasi, not Madurai Meenakshi temple."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 115, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "assertion-reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q711", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "singan-suspicion-ornaments-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): சிங்கியின் காலில் இருந்த சிலம்பை உற்று நோக்கிய சிங்கன், அது சேலத்து நாட்டின் சிலம்பு என்று பார்த்த உடனே சரியாக இனம் கண்டுகொண்டான்.\nகாரணம் (R): சிங்கன் பல காலம் சிங்கியைக் காணாததாலும், அவள் காலில் அணிந்திருந்த புதிய அணிகலன்களின் முறுக்கு அமைப்பாலும் மருண்டுபோய் வேடிக்கையாக வினவினான்."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "B": "கூற்று (A) சரி; காரணம் (R) தவறு", "C": "கூற்று (A) தவறு; காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று (A) தவறு; காரணம் (R) சரி. சிங்கன் சிலம்பை உடனே சிலம்பு என இனம் காணவில்லை; 'காலுக்கு மேலே பெரிய விரியன் கடித்துக் கிடப்பானேன் சிங்கி?' என்று பாம்பாகக் கருதி அஞ்சினான். எனவே கூற்று தவறு, காரணம் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Scrutinizing the Silambu on Singi's feet, Singan immediately recognized it correctly at first glance as the Salem anklet.\nReason (R): Not having seen Singi for many days and bewitched by the coiled patterns of her new ornaments, Singan humorously mistook them for creatures."}], "options": {"A": "Both (A) and (R) are correct, and (R) explains (A)", "B": "(A) is correct; (R) is incorrect", "C": "(A) is incorrect; (R) is correct", "D": "Both (A) and (R) are incorrect"}, "explanation": "(A) is false; (R) is correct. Singan did not recognize the Silambu instantly; he humorously questioned whether a venomous viper was latching onto her ankle."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "assertion-reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q712", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "kandya-peeli-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): சிங்கியின் சுண்டு விரலில் நெளிந்து கிடந்த குண்டலப் பூச்சியைப் பாண்டிய மன்னரின் மகள் நேரில் கண்டு பரிசாக அளித்தாள்.\nகாரணம் (R): பாண்டிய நாட்டின் அரச குடும்பத்தில் உள்ள மகளிர் விஷப் பூச்சிகளை வளர்த்து அணிகலன்களாக மாற்றுவதில் வல்லவர்கள்."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "B": "கூற்று (A) சரி; காரணம் (R) தவறு", "C": "கூற்று (A) தவறு; காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறானவை. பாண்டியன் மகள் பரிசாக அளித்தது 'பாடகம்' ஆகும். சுண்டு விரலில் குண்டலப் பூச்சி போல் இருந்த கால் மோதிரமும் பீலியும் 'கண்டிய நாட்டில்' பரிசாகப் பெறப்பட்டவை ஆகும். பூச்சிகளை அணிகலனாக்கும் வழக்கம் ஏதுமில்லை. எனவே இரண்டும் தவறு."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): The princess of the Pandya kingdom personally awarded the coiled Gundalap poochy found on Singi's little toe.\nReason (R): Royal women of the Pandya dynasty were adept at rearing venomous centipedes and fashioning them into live jewelry."}], "options": {"A": "Both (A) and (R) are correct, and (R) explains (A)", "B": "(A) is correct; (R) is incorrect", "C": "(A) is incorrect; (R) is correct", "D": "Both (A) and (R) are incorrect"}, "explanation": "Both (A) and (R) are false. The Pandya princess gifted the Paadagam. The toe-rings (Peeli) looking like coiled earwigs were awarded in Kandy. The assertions are fictional."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 115, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "assertion-reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q713", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "fortune-telling-gifts-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): சிங்கிக்குக் கலிங்க நாடு, சேலத்து நாடு, கண்டிய நாடு முதலான பல நாடுகளிலிருந்து ஏராளமான அணிகலன்கள் பரிசாகக் கிடைத்தன.\nகாரணம் (R): அந்நாடுகளில் உள்ள பெண்களுக்கு அவர்களின் கைரேகைகளையும் எதிர்கால நல்வாழ்வையும் குறி சொல்லும் திறன் சிங்கிக்கு அமைந்திருந்ததே இதற்குக் காரணமாகும்."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் கூற்றை விளக்கவில்லை", "C": "கூற்று (A) சரி; காரணம் (R) தவறு", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரியானவை; காரணம் கூற்றை விளக்குகிறது. பாடநூல் மதிப்பீடு (பக். 116 வினா 5): சிங்கிக்குப் பலவகைப்பட்ட பரிசுப் பொருள்கள் கிடைக்கக் காரணம் 'குறி சொல்லுதல்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Singi received an abundance of valuable jewelry as gifts from multiple regions including Kalinga, Salem, and Kandy.\nReason (R): Her extraordinary palmistry and fortune-telling expertise in foretelling the prosperous futures of women earned her these honors."}], "options": {"A": "Both (A) and (R) are correct, and (R) explains (A)", "B": "Both (A) and (R) are correct, but (R) does not explain (A)", "C": "(A) is correct; (R) is incorrect", "D": "Both (A) and (R) are incorrect"}, "explanation": "Both Assertion and Reason are true and (R) correctly explains (A). Textbook Evaluation Page 116 Question 5 highlights fortune-telling as the sole reason for her bountiful awards."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 116, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "assertion-reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q714", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "textbook-eval-creature-ornaments-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூல் மதிப்பீட்டுப் பொருத்துக வினாவைச் சரியாகப் பொருத்துக (பக். 116):\n(a) பாம்பு - 1. கால் மோதிரம்\n(b) மண்புழு - 2. மணிக்கச்சம்\n(c) தவளை - 3. பாடகம்\n(d) குண்டலப் பூச்சி - 4. சிலம்பு"}], "options": {"A": "(a)-3, (b)-4, (c)-1, (d)-2", "B": "(a)-4, (b)-3, (c)-2, (d)-1", "C": "(a)-4, (b)-2, (c)-3, (d)-1", "D": "(a)-1, (b)-2, (c)-3, (d)-4"}, "explanation": "பாடநூல் பக். 116 மதிப்பீட்டுப் பொருத்துக:\n- பாம்பு: சிலம்பு (4)\n- மண்புழு (நாங்கூழ்): பாடகம் (3)\n- தவளை: மணிக்கச்சம் (2)\n- குண்டலப் பூச்சி: கால் மோதிரம் (1)\nஎனவே சரியான பொருத்தம் (a)-4, (b)-3, (c)-2, (d)-1 ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Match the creatures perceived by Singan with the actual ornaments worn by Singi (Textbook Page 116):\n(a) Serpent (Paambu) - 1. Kaal Modhiram (Toe-ring)\n(b) Earthworm (Manpuzhu) - 2. Manikkaccham\n(c) Frog (Thavalai) - 3. Paadagam\n(d) Coiled Bug (Gundalap poochy) - 4. Silambu"}], "options": {"A": "(a)-3, (b)-4, (c)-1, (d)-2", "B": "(a)-4, (b)-3, (c)-2, (d)-1", "C": "(a)-4, (b)-2, (c)-3, (d)-1", "D": "(a)-1, (b)-2, (c)-3, (d)-4"}, "explanation": "Textbook Page 116 Matching: Serpent - Silambu (4); Earthworm - Paadagam (3); Frog - Manikkaccham (2); Coiled bug - Kaal Modhiram (1). Correct match: (a)-4, (b)-3, (c)-2, (d)-1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 116, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "matching", "textbook-eval"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q715", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "ornaments-regions-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிங்கி பெற்ற அணிகலன்களையும் அவற்றைப் பரிசாக அளித்த நாடுகளையும் பொருத்துக:\n(a) சிலம்பு - 1. கண்டிய நாடு\n(b) முறுக்குத் தண்டை - 2. பாண்டியன் மகள்\n(c) பாடகம் - 3. கலிங்க நாட்டார்\n(d) கால் மோதிரமும் பீலியும் - 4. சேலத்து நாடு"}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-3, (c)-4, (d)-1", "C": "(a)-4, (b)-3, (c)-2, (d)-1", "D": "(a)-3, (b)-4, (c)-1, (d)-2"}, "explanation": "பாடலின் வரிகள்: சேலத்து நாட்டில் பெற்ற சிலம்பு (4); கலிங்க நாட்டார் கொடுத்த தண்டை (3); பாண்டியன் மகள் தந்த பாடகம் (2); கண்டிய நாட்டில் பெற்ற கால் மோதிரமும் பீலியும் (1). எனவே (a)-4, (b)-3, (c)-2, (d)-1 ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Match the ornaments received by Singi with the kingdoms/persons who gifted them:\n(a) Silambu - 1. Kandy Country\n(b) Murukku Thandai - 2. Pandya Princess\n(c) Paadagam - 3. People of Kalinga\n(d) Kaal Modhiram and Peeli - 4. Salem Country"}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-3, (c)-4, (d)-1", "C": "(a)-4, (b)-3, (c)-2, (d)-1", "D": "(a)-3, (b)-4, (c)-1, (d)-2"}, "explanation": "Matching: Silambu - Salem (4); Thandai - Kalinga (3); Paadagam - Pandya princess (2); Toe-rings - Kandy (1). Correct sequence: (a)-4, (b)-3, (c)-2, (d)-1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 115, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "matching"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q716", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "kavirayar-literary-profile-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திரிகூடராசப்பக் கவிராயரின் இலக்கியக் குறிப்புகளைப் பொருத்துக:\n(a) திருக்குற்றாலக் குறவஞ்சி - 1. பிள்ளைத்தமிழ் நூல்\n(b) பிறந்த மாவட்டம் - 2. கோவில் வித்துவான்\n(c) பெற்ற சிறப்புப் பட்டம் - 3. தென்காசி\n(d) குழல்வாய்மொழி - 4. கவிதைக் கிரீடம்"}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-3, (c)-4, (d)-1", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-4, (b)-3, (c)-2, (d)-1"}, "explanation": "திருக்குற்றாலக் குறவஞ்சி: கவிதைக் கிரீடம் (4); பிறந்த மாவட்டம்: தென்காசி (3); சிறப்புப் பட்டம்: கோவில் வித்துவான் (2); குழல்வாய்மொழி: பிள்ளைத்தமிழ் நூல் (1). எனவே (a)-4, (b)-3, (c)-2, (d)-1 ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Match the literary details associated with Thirikooda Rasappa Kavirayar:\n(a) Thirukutrala Kuravanji - 1. Pillaithamil Text\n(b) Birth District - 2. Kovil Vidhwan\n(c) Conferred Title - 3. Tenkasi\n(d) Kuzhalvaaimozhi - 4. Poetic Crown (Kavithaik Kireedam)"}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-3, (c)-4, (d)-1", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-4, (b)-3, (c)-2, (d)-1"}, "explanation": "Thirukutrala Kuravanji - Poetic crown (4); Birthplace - Tenkasi (3); Title - Kovil Vidhwan (2); Kuzhalvaaimozhi - Pillaithamil (1). Match: (a)-4, (b)-3, (c)-2, (d)-1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 115, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "matching", "author-info"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q717", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "kuravanji-vocabulary-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குற்றாலக் குறவஞ்சிப் பாடலின் அருஞ்சொற்களை அவற்றின் பொருள்களோடு பொருத்துக:\n(a) கொத்தார் குழலார் - 1. பூங்கொத்து அணிந்த கூந்தலுடைய மகளிர்\n(b) நாங்கூழ் - 2. மண்புழு\n(c) ஆர்க்கும் - 3. எவருக்கும்\n(d) பீலி - 4. கால் விரலணி"}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-1, (c)-4, (d)-3", "C": "(a)-4, (b)-3, (c)-2, (d)-1", "D": "(a)-3, (b)-4, (c)-1, (d)-2"}, "explanation": "சொல்லும் பொருளும்: கொத்தார் குழலார் - பூங்கொத்து சூடிய பெண்கள் (1); நாங்கூழ் - மண்புழு (2); ஆர்க்கும் - எவருக்கும் (3); பீலி - கால் விரலணி (4). அனைத்தும் நேருக்கு நேராகப் பொருந்தியுள்ளன (a)-1, (b)-2, (c)-3, (d)-4."}, "en": {"blocks": [{"type": "text", "content": "Match the classical vocabulary from Thirukutrala Kuravanji with their definitions:\n(a) Kotthaar Kuzhalaar - 1. Women with flower-bedecked tresses\n(b) Naangoozhu - 2. Earthworm\n(c) Aarkkum - 3. To anyone / to anyone whatsoever\n(d) Peeli - 4. Toe ornament ring"}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-1, (c)-4, (d)-3", "C": "(a)-4, (b)-3, (c)-2, (d)-1", "D": "(a)-3, (b)-4, (c)-1, (d)-2"}, "explanation": "Glossary: Kotthaar kuzhalaar - Flower-haired women (1); Naangoozhu - Earthworm (2); Aarkkum - To anyone (3); Peeli - Toe-ring (4). Matches: (a)-1, (b)-2, (c)-3, (d)-4."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "glossary", "matching"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q718", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "mountains-kinship-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடலின் 'கற்பவை கற்றபின்' பகுதியில் உள்ள மலைகளையும் குறத்தி கூறும் உறவுமுறைகளையும் பொருத்துக:\n(a) கொல்லிமலை - 1. தமையன் மலை\n(b) பழநிமலை - 2. எந்தை மலை\n(c) விந்தைமலை - 3. கொழுநனுக்குக் காணி மலை\n(d) இமயமலை - 4. எனக்குக் கிளை மலை"}], "options": {"A": "(a)-3, (b)-4, (c)-1, (d)-2", "B": "(a)-4, (b)-3, (c)-2, (d)-1", "C": "(a)-1, (b)-2, (c)-3, (d)-4", "D": "(a)-2, (b)-1, (c)-4, (d)-3"}, "explanation": "பாடநூல் பக். 115 செய்யுள் வரிகள்:\n- 'கொல்லிமலை எனக்குக் கிளை செல்லிமலை அம்மே!' (4)\n- 'கொழுநனுக்குக் காணிமலை பழநிமலை அம்மே!' (3)\n- 'எல்லுலவும் விந்தைமலை எந்தைமலை அம்மே!' (2)\n- 'இமயமலை என்னுடைய தமையன்மலை அம்மே!' (1)\nஎனவே சரியான பொருத்தம் (a)-4, (b)-3, (c)-2, (d)-1 ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Match the mountains with the familial kinship allegiances declared by the Kurathi (Page 115):\n(a) Kolli Malai - 1. Brother's Mountain (Thamaiyan Malai)\n(b) Palani Malai - 2. Father's Mountain (Endhai Malai)\n(c) Vindhya Malai - 3. Husband's Hereditary Mountain (Kozhunanukku Kaani Malai)\n(d) Himalaya Malai - 4. My Maternal Kin Mountain (Enakku Kilai Malai)"}], "options": {"A": "(a)-3, (b)-4, (c)-1, (d)-2", "B": "(a)-4, (b)-3, (c)-2, (d)-1", "C": "(a)-1, (b)-2, (c)-3, (d)-4", "D": "(a)-2, (b)-1, (c)-4, (d)-3"}, "explanation": "Textbook Page 115 verses: Kolli Malai - Kin mountain (4); Palani Malai - Husband's hereditary mountain (3); Vindhya Malai - Father's mountain (2); Himalayas - Elder brother's mountain (1). Match: (a)-4, (b)-3, (c)-2, (d)-1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 115, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "mountains", "matching"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q719", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "ornament-anatomical-locations", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிங்கி அணிந்த அணிகலன்களையும் அவை காலில் அணியப்பட்டுள்ள உறுப்புகளையும் பொருத்துக:\n(a) சிலம்பு - 1. காலின் கீழ்ப்பகுதி மணிக்கட்டு\n(b) தண்டை - 2. காலின் சுண்டு விரல்\n(c) பீலி - 3. சிலம்பிற்கு மேலே உள்ள முறுக்குப் பகுதி\n(d) பாடகம் - 4. பாதத்தின் மேல் நெளியும் பகுதி"}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-3, (b)-4, (c)-1, (d)-2", "C": "(a)-4, (b)-3, (c)-2, (d)-1", "D": "(a)-2, (b)-1, (c)-4, (d)-3"}, "explanation": "அணிகலன் அமைவிடப் பொருத்தம்: சிலம்பு - பாதத்தின் மேல் நெளியும் பகுதி/கால் (4); தண்டை - சிலம்பிற்கு மேல் திருகு முறுக்கான பகுதி (3); பீலி - காலின் சுண்டு விரல் (2); மணிக்கச்சம்/பாடகம் - காலின் மணிக்கட்டுப் பகுதி (1). எனவே (a)-4, (b)-3, (c)-2, (d)-1 ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Match the ornaments worn by Singi with their specific anatomical placements on the leg/foot:\n(a) Silambu - 1. Lower wrist/joint of foot (Manikkattu)\n(b) Thandai - 2. Little toe of the foot\n(c) Peeli - 3. Twisted segment directly above the Silambu\n(d) Paadagam - 4. Undulating curve atop the foot arch"}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-3, (b)-4, (c)-1, (d)-2", "C": "(a)-4, (b)-3, (c)-2, (d)-1", "D": "(a)-2, (b)-1, (c)-4, (d)-3"}, "explanation": "Placement matching: Silambu on the ankle/foot arch (4); Thandai coiled above Silambu (3); Peeli on the little toe (2); Manikkaccham at the ankle joint (1). Sequence: (a)-4, (b)-3, (c)-2, (d)-1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "kuravanji", "ornaments", "matching"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q720", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "sandhi-eval-q3-q4", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூல் மதிப்பீட்டுப் புணர்ச்சி வினாக்களைச் சரியாக விடையளிக்குக:\n1. 'பயமில்லை' என்னும் சொல்லைப் பிரித்தெழுதக் கிடைப்பது எது?\n2. 'கால் + ஆழி' என்பதைச் சேர்த்தெழுதக் கிடைக்கும் சொல் எது?"}], "options": {"A": "பய + இல்லை, கால்ஆழி", "B": "பயம் + மில்லை, காலாஆழி", "C": "பய + மில்லை, காலஆழி", "D": "பயம் + இல்லை, காலாழி"}, "explanation": "பாடநூல் மதிப்பீடு (பக். 116 வினாக்கள் 3 & 4):\n1. பயமில்லை = பயம் + இல்லை (ம் + இ = மி -> பயமில்லை).\n2. கால் + ஆழி = காலாழி ('உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே' என்ற விதிப்படி ல் + ஆ = லா -> காலாழி). எனவே சரியான விடை 'பயம் + இல்லை, காலாழி'."}, "en": {"blocks": [{"type": "text", "content": "Answer the textbook evaluation sandhi questions accurately:\n1. What is the split form of 'Bayamillai'?\n2. What is the combined form of 'Kaal + aazhi'?"}], "options": {"A": "Baya + illai, Kaalaazhi", "B": "Bayam + millai, Kaalaa-aazhi", "C": "Baya + millai, Kaala-aazhi", "D": "Bayam + illai, Kaalaazhi"}, "explanation": "Textbook Evaluation (Page 116, Q3 & Q4):\n1. 'Bayamillai' splits into 'Bayam + illai'.\n2. 'Kaal + aazhi' combines into 'Kaalaazhi' through the standard coalescence rule where consonant 'l' merges with vowel 'aa' to produce 'laa'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 116, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "grammar", "punarchi", "textbook-eval"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q721", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "grammar-anjamal-murukkitta", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடலில் பயின்றுவந்துள்ள 'அஞ்சாமல்', 'முறுக்கிட்ட' ஆகிய சொற்களின் சரியான இலக்கணக் குறிப்பைக் கண்டறிக:"}], "options": {"A": "எதிர்மறை வினையெச்சம், பெயரெச்சம்", "B": "உடன்பாட்டு வினையெச்சம், தொழிற்பெயர்", "C": "குறிப்புப் பெயரெச்சம், வினையாலணையும் பெயர்", "D": "எதிர்மறைத் தொழிற்பெயர், ஈறுகெட்ட பெயரெச்சம்"}, "explanation": "- 'அஞ்சாமல்': அஞ்சுதல் என்னும் வினையின் எதிர்மறையாய் நின்று 'சொல்லடா' என்னும் வினைமுற்றைக் கொண்டு முடிவதால் இது 'எதிர்மறை வினையெச்சம்' ஆகும்.\n- 'முறுக்கிட்ட': முறுக்கிட்ட என்னும் சொல் 'தண்டை' என்னும் பெயர்ச்சொல்லைக் கொண்டு முடிவதால் இது 'பெயரெச்சம்' ஆகும்.\nஎனவே 'எதிர்மறை வினையெச்சம், பெயரெச்சம்' என்பதே சரி."}, "en": {"blocks": [{"type": "text", "content": "Identify the correct grammatical categories for the words 'Anjaamal' and 'Murukkitta' appearing in the poem:"}], "options": {"A": "Negative Adverbial Participle, Relative Participle", "B": "Affirmative Adverbial Participle, Verbal Noun", "C": "Appositional Participle, Participial Noun", "D": "Negative Verbal Noun, Truncated Relative Participle"}, "explanation": "'Anjaamal' modifies the imperative verb 'sollada' in the negative sense, functioning as a Negative Adverbial Participle. 'Murukkitta' modifies the noun 'thandai', functioning as a Relative Participle."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "grammar", "ilakkana-kurippu"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q722", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "poetry-rhyme-adi-monai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குற்றாலக் குறவஞ்சிப் பாடலின் பின்வரும் அடிகளில் பயின்றுவந்துள்ள தொடை நயத்தைக் கண்டறிக:\n\"காலுக்கு மேலே பெரிய விரியன்\n கடித்துக் கிடப்பானேன் சிங்கி?\"\nஇவ்வடிகளில் முதலிரு அடிகளின் முதல் சீர்களான 'காலுக்கு' - 'கடித்துக்' என்பதில் அமைந்துள்ள தொடை எது?"}], "options": {"A": "சீர்மோனை", "B": "அடிமோனை", "C": "இயைபுத் தொடை", "D": "முரண் தொடை"}, "explanation": "முதல் அடியின் முதல் சீரான 'காலுக்கு' என்பதிலும், இரண்டாம் அடியின் முதல் சீரான 'கடித்துக்' என்பதிலும் முதல் எழுத்து ககர வருக்கத்தில் (கா - க) ஒன்றிவந்துள்ளதால் இது 'அடிமோனை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the metric device connecting the initial feet 'Kaalukku' and 'Kaditthuk' in the following lines:\n\"Kaalukku mele periya viriyan\n Kaditthuk kidappaanaen Singi?\""}], "options": {"A": "Seer Monai", "B": "Adi Monai (Line Alliteration)", "C": "Iyaibu Thodai (End Rhyme)", "D": "Muran Thodai (Antithesis)"}, "explanation": "The initial letter of the first foot of line 1 ('Kaalukku') and that of line 2 ('Kaditthuk') share alliteration in the 'ka' class, forming Adi Monai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "grammar", "monai", "poetics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q723", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "grammar-case-suffixes-kuravanji", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'காலுக்கு மேலே', 'சேலத்து நாட்டில்' ஆகிய சொற்றொடர்களில் அடிக்கோடிட்ட 'காலுக்கு', 'நாட்டில்' என்னும் சொற்களில் அமைந்துள்ள வேற்றுமை உருபுகளைக் கண்டறிக:"}], "options": {"A": "இரண்டாம் வேற்றுமை, மூன்றாம் வேற்றுமை", "B": "மூன்றாம் வேற்றுமை, ஐந்தாம் வேற்றுமை", "C": "நான்காம் வேற்றுமை, ஏழாம் வேற்றுமை", "D": "ஆறாம் வேற்றுமை, எட்டாம் வேற்றுமை"}, "explanation": "- 'காலுக்கு' என்பதில் 'கு' என்னும் நான்காம் வேற்றுமை உருபு வெளிப்பட்டு வந்துள்ளது.\n- 'சேலத்து நாட்டில்' என்பதில் 'இல்' என்னும் ஏழாம் வேற்றுமை (இடப்பொருள்) உருபு வெளிப்பட்டு வந்துள்ளது.\nஎனவே 'நான்காம் வேற்றுமை, ஏழாம் வேற்றுமை' என்பது சரியான விடையாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the case markers (Vaetrumai urubugal) present in the words 'Kaalukku' and 'Naattil':"}], "options": {"A": "Second case, Third case", "B": "Third case, Fifth case", "C": "Fourth case, Seventh case", "D": "Sixth case, Eighth case"}, "explanation": "'Kaalukku' contains the fourth dative case suffix 'ku'. 'Naattil' contains the seventh locative case marker 'il'. Hence Fourth case, Seventh case."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "grammar", "vaetrumai"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q724", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l1", "chapter_id": null, "topic_id": "kuravanji-gifts-odd", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிங்கி தான் குறி சொல்லிப் பெற்ற பரிசுகளுள் தவறாகப் பொருந்தியுள்ள இணையைக் கண்டறிக:"}], "options": {"A": "சேலத்து நாடு - சிலம்பு", "B": "கலிங்க நாடு - முறுக்குத் தண்டை", "C": "பாண்டியன் மகள் - பாடகம்", "D": "கண்டிய நாடு - மணிக்கச்சம்"}, "explanation": "கண்டிய நாட்டில் சிங்கி பெற்றது 'கால் மோதிரமும் பீலியும்' ஆகும். 'மணிக்கச்சம்' என்பது குற்றாலநாதர் கோவிலைச் சேர்ந்த பெண்கள் அணிவித்த பரிசாகும். எனவே 'கண்டிய நாடு - மணிக்கச்சம்' என்பது தவறான இணையாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the incorrectly paired gift and donor kingdom from the poem:"}], "options": {"A": "Salem Territory - Silambu", "B": "Kalinga Country - Murukku Thandai", "C": "Pandya Princess - Paadagam", "D": "Kandy Country - Manikkaccham"}, "explanation": "Singi received toe-rings (Kaal modhiram & peeli) in Kandy. The Manikkaccham was presented by the temple women of Kutralam. Hence Option D is the incorrect pair."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil