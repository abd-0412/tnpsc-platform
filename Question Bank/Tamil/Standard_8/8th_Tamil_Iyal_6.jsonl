{"id": "8th-u6-q812", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l3", "chapter_id": null, "topic_id": "sweet-limes-count-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஒருவன் இருக்கிறான்' சிறுகதையில் காஞ்சிபுரத்திலிருந்து வந்த ஆறுமுகம் தன் குழந்தைகளுக்கு வாங்கிய பழங்களிலிருந்து எத்தனை சாத்துக்குடிப் பழங்களைக் குப்புசாமியிடம் சேர்க்கக் கொடுத்தான்?"}], "options": {"A": "ஒரு பழம்", "B": "மூன்று பழங்கள்", "C": "நான்கு பழங்கள்", "D": "இரண்டு பழங்கள்"}, "explanation": "பாடநூல் பக். 124: ஆறுமுகம் தன் கையில் இருந்த துணிப்பையிலிருந்து \"என் பெங்களுக்கு நாலு பழம் வாங்கினேன்... இவரு ஆசுபத்திரில இருக்கிறாரு...\" என்று கூறி இரண்டு சாத்துக்குடிப் பழங்களை எடுத்துக் கொடுத்தான்."}, "en": {"blocks": [{"type": "text", "content": "In 'Oruvan Irukkiran', how many sweet limes out of those purchased for his children did Arumugam hand over for Kuppusamy?"}], "options": {"A": "One fruit", "B": "Three fruits", "C": "Four fruits", "D": "Two fruits"}, "explanation": "Textbook Page 124: Arumugam reached into his cloth bag and gave 2 sweet limes out of 4 he had bought for his kids."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 124, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "direct", "story-detail", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

