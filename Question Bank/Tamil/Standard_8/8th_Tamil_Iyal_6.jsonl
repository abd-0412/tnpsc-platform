{"id": "8th-u6-q811", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l3", "chapter_id": null, "topic_id": "alagirisamy-birthplace-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எழுத்தாளர் கு. அழகிரிசாமி பிறந்த 'இடைசெவல்' என்னும் கிராமம் தமிழ்நாட்டில் எந்த மாவட்டத்தில் அமைந்துள்ளது?"}], "options": {"A": "திருநெல்வேலி மாவட்டம்", "B": "தென்காசி மாவட்டம்", "C": "தூத்துக்குடி மாவட்டம்", "D": "விருதுநகர் மாவட்டம்"}, "explanation": "பாடநூல் பக். 126 நூல் வெளி: கு. அழகிரிசாமி தூத்துக்குடி மாவட்டத்தில் உள்ள இடைசெவல் என்னும் ஊரில் பிறந்தவர்."}, "en": {"blocks": [{"type": "text", "content": "In which district of Tamil Nadu is the village 'Idaiseval', the birthplace of author Ku. Alagirisamy, located?"}], "options": {"A": "Tirunelveli District", "B": "Tenkasi District", "C": "Thoothukudi District", "D": "Virudhunagar District"}, "explanation": "Textbook Page 126: Ku. Alagirisamy was born in Idaiseval village in Thoothukudi district."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 126, "chapter": null, "section"