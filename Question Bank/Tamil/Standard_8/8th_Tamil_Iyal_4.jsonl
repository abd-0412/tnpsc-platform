8", "term": "full_year", "edition": "2024-2025", "page": 81, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["peyareccam", "tenses", "odd-one-out"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q531", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l4", "chapter_id": null, "topic_id": "muttreccam-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒரு வினைமுற்று எச்சப்பொருள் தந்து மற்றொரு வினைமுற்றைக் கொண்டு முடிவது எவ்வாறு அழைக்கப்படும்?"}], "options": ["வினையெச்சம்", "பெயரெச்சம்", "முற்றெச்சம்", "வினைமுற்று"], "explanation": "பாடநூல் பக்கம் 82-இன் படி: 'ஒரு வினைமுற்று எச்சப்பொருள் தந்து மற்றொரு வினைமுற்றைக் கொண்டு முடிவது முற்றெச்சம் எனப்படும்'."}, "en": {"blocks": [{"type": "text", "content": "What is the term for a finite verb that delivers an incomplete participial sense and concludes with another finite verb?"}], "options": ["Vinaiyeccam", "Peyareccam", "Muttreccam", "Vinai Mutru"], "explanation": "As defined on textbook page 82, a finite verb that functions as a participle to conclude with another finite verb is called Muttreccam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 82, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "p