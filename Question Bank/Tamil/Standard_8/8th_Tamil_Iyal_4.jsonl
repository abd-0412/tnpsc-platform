// ==============================================================================
// பாடம் 5: மொழியை ஆள்வோம் (தொடர் வகைகள் & கலைச்சொற்கள்) & பாடம் 6: வாழ்வியல் திருக்குறள் [Q533 - Q560]
// தொடர் வகைகள்: செய்தித் தொடர் (கரிகாலன் கல்லணையைக் கட்டினான்), வினாத்தொடர் (சிலப்பதிகாரத்தை இயற்றியவர் யார்?), விழைவுத் தொடர்: ஏவல் (இளமையில் கல்), வேண்டுதல் (திருக்குறள் நூல் தருக), வாழ்த்துதல் (உழவுத்தொழில் வாழ்க), வைதல் (கல்லாமை ஒழிக); உணர்ச்சித் தொடர்: உவகை (அடடா!), அவலம் (அந்தோ!), அச்சம் (ஆ! புலி வருகிறது!), வியப்பு (என்னே!); இணைச்சொற்கள்: நேரிணை (சீரும் சிறப்பும்), எதிரிணை (இரவுபகல், மேடுபள்ளம்), செறியிணை (பச்சைப்பசேல், வெள்ளைவெளேர்); கலைச்சொற்கள்: Crafts, Knitting, Flute, Horn, Drum, Artisan, Basketry, Rite; திருக்குறள்: தெரிந்து வினையாடல் ('செய்வானை நாடி', 'இதனை இதனால் இவன்முடிக்கும்' - அதிகாரப் பகிர்வு), செங்கோன்மை ('ஓர்ந்துகண்ணோடாது முறைசெய்தல்', 'இறைகாக்கும் வையகம்'), வெருவந்த செய்யாமை ('தக்காங்கு நாடி', 'இறைகடியன் என்றுரைக்கும்' - கொடுங்கோன்மை அழிவு), சொல்வன்மை ('கேட்டார்ப் பிணிக்கும்', 'சொல்லுக சொல்லை' - சொற்பொருள் பின்வருநிலையணி), அவையறிதல் ('அவைஅறிந்து ஆராய்ந்து', 'கற்றறிந்தார் கல்வி விளங்கும்'); யாப்பிலக்கணம்: குறள் முதலடி அளவடி (4 சீர்), இரண்டாமடி சிந்தடி (3 சீர்)
// ==============================================================================
{"id": "8th-u4-q533", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l5", "chapter_id": null, "topic_id": "sentence-four-types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பொருளின் அடிப்படையில் தொடர் வகைகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. ஒரு செய்தியைத் தெளிவாகக் கூறும் தொடர் செய்தித் தொடர் ஆகும் (எ.கா: கரிகாலன் கல்லணையைக் கட்டினான்).\n2. ஒருவரிடம் ஒன்றனை வினவுவதாக அமையும் தொடர் வினாத்தொடர் ஆகும் (எ.கா: சிலப்பதிகாரத்தை இயற்றியவர் யார்?).\n3. ஏவல், வேண்டுதல், வாழ்த்துதல், வைதல் ஆகிய பொருள்களில் வரும் தொடர் விழைவுத் தொடர் ஆகும்.\n4. உவகை, அழுகை, அவலம், அச்சம், வியப்பு முதலான உணர்ச்சிகளை உணர்த்தும் தொடர் உணர்ச்சித் தொடர் ஆகும்."}], "options": ["கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "கூற்றுகள் 1, 2 மட்டும் சரி; 3, 4 தவறு", "கூற்றுகள் 2, 3, 4 மட்டும் சரி; 1 தவறு", "கூற்றுகள் 1, 3 மட்டும் சரி; 2, 4 தவறு"], "explanation": "பாடநூல் பக்கம் 84-இன் படி: தொடர்கள் பொருள் அடிப்படையில் நான்கு வகைப்படும்: செய்தித் தொடர், வினாத்தொடர், விழைவுத் தொடர், உணர்ச்சித் தொடர். நான்கு கூற்றுகளும் இலக்கணப்படி சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding the four semantic classifications of sentences in Tamil:\n1. A sentence clearly stating a fact or message is a Declarative sentence (Seythi-t-thodar).\n2. A sentence interrogating someone is an Interrogative sentence (Vinaa-t-thodar).\n3. A sentence expressing command, request, benediction, or reproof is an Optative/Imperative sentence (Vizhaivu-t-thodar).\n4. A sentence expressing joy, weeping, pathos, fear, or wonder is an Exclamatory sentence (Unarchi-t-thodar)."}], "options": ["All statements 1, 2, 3, 4 are correct", "Statements 1, 2 only are correct; 3, 4 are incorrect", "Statements 2, 3, 4 only are correct; 1 is incorrect", "Statements 1, 3 only are correct; 2, 4 are incorrect"], "explanation": "As explained on page 84, Tamil sentences are semantically divided into four types: Declarative, Interrogative, Optative/Imperative, and Exclamatory. All four statements are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "text_ta": "செய்தியைத் தெளிவாகக் கூறுவது செய்தித் தொடர்.", "text_en": "Declarative states facts clearly."}, {"id": "S2", "text_ta": "வினவுவதாக அமைவது வினாத்தொடர்.", "text_en": "Interrogative asks questions."}, {"id": "S3", "text_ta": "ஏவல், வேண்டுதல், வாழ்த்துதல், வைதல் விழைவுத் தொடர் ஆகும்.", "text_en": "Vizhaivu expresses command, wish, curse."}, {"id": "S4", "text_ta": "உணர்ச்சிகளை உணர்த்துவது உணர்ச்சித் தொடர்.", "text_en": "Exclamatory conveys strong emotions."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 84, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["sentence-types", "grammar", "statement", "8th-tamil"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q534", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l5", "chapter_id": null, "topic_id": "vizhaivu-unarchi-examples", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "விழைவுத் தொடர் மற்றும் உணர்ச்சித் தொடரின் சான்றுகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'இளமையில் கல்' என்பது ஏவற்பொருளில் வந்த விழைவுத் தொடர் ஆகும்.\n2. 'உழவுத்தொழில் வாழ்க' என்பது வேண்டுதல் பொருளில் வந்த விழைவுத் தொடர் ஆகும்.\n3. 'பழந்தமிழ் இலக்கியங்கள் பல அழிந்துவிட்டனவே!' என்பது அவல உணர்வை உணர்த்தும் உணர்ச்சித் தொடர் ஆகும்.\n4. 'கல்லாமை ஒழிக' என்பது வைதல் (இகழ்தல்) பொருளில் அமைந்த விழைவுத் தொடர் ஆகும்."}], "options": ["கூற்றுகள் 1, 2 சரி; 3, 4 தவறு", "கூற்றுகள் 1, 3, 4 சரி; கூற்று 2 தவறு", "கூற்றுகள் 2, 4 சரி; 1, 3 தவறு", "கூற்றுகள் அனைத்தும் சரி"], "explanation": "கூற்றுகள் 1, 3, 4 சரியானவை. கூற்று 2 தவறு; 'உழவுத்தொழில் வாழ்க' என்பது 'வாழ்த்துதல்' பொருளில் வந்த விழைவுத் தொடர் ஆகும் (வேண்டுதல் அல்ல; வேண்டுதலுக்குரிய சான்று: 'உங்கள் திருக்குறள் நூலைத் தருக')."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements on examples of Vizhaivu and Unarchi sentences:\n1. 'இளமையில் கல்' is an imperative/optative sentence expressing command (ஏவல்).\n2. 'உழவுத்தொழில் வாழ்க' is an optative sentence expressing request/plea (வேண்டுதல்).\n3. 'பழந்தமிழ் இலக்கியங்கள் பல அழிந்துவிட்டனவே!' is an exclamatory sentence conveying pathos/grief (அவலம்).\n4. 'கல்லாமை ஒழிக' is an optative sentence expressing reproof/denunciation (வைதல்)."}], "options": ["Statements 1, 2 are correct; 3, 4 are incorrect", "Statements 1, 3, 4 are correct; Statement 2 is incorrect", "Statements 2, 4 are correct; 1, 3 are incorrect", "All statements are correct"], "explanation": "Statements 1, 3, 4 are correct. Statement 2 is false because 'உழவுத்தொழில் வாழ்க' expresses benediction/wishing (வாழ்த்துதல்), not a request (வேண்டுதல்)."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "text_ta": "'இளமையில் கல்' ஏவற்பொருள் விழைவுத் தொடர்.", "text_en": "'இளமையில் கல்' is command optative."}, {"id": "S2", "text_ta": "'உழவுத்தொழில் வாழ்க' வேண்டுதல் பொருள் விழைவுத் தொடர்.", "text_en": "'உழவுத்தொழில் வாழ்க' is request optative."}, {"id": "S3", "text_ta": "இலக்கியங்கள் அழிந்ததை உரைப்பது அவல உணர்ச்சித் தொடர்.", "text_en": "Destruction of literature is pathos exclamation."}, {"id": "S4", "text_ta": "'கல்லாமை ஒழிக' வைதல் பொருள் விழைவுத் தொடர்.", "text_en": "'கல்லாமை ஒழிக' is denunciation optative."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 84, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vizhaivu", "unarchi", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q535", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l5", "chapter_id": null, "topic_id": "paired-words-types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இணைச்சொற்கள் (Paired Words) குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. ஒரே பொருளைத் தரும் இணைச்சொற்கள் 'நேரிணை' எனப்படும் (எ.கா: சீரும் சிறப்பும், பேரும் புகழும்).\n2. எதிரெதிர்ப் பொருளைத் தரும் இணைச்சொற்கள் 'எதிரிணை' எனப்படும் (எ.கா: இரவுபகல், உயர்வுதாழ்வு).\n3. பொருளின் செறிவைக் குறித்து வருவன 'செறியிணை' எனப்படும் (எ.கா: பச்சைப்பசேல், வெள்ளைவெளேர்).\n4. 'மேடுபள்ளம்' என்பது ஒரே பொருளை உணர்த்தும் நேரிணைச் சொல்லுக்குச் சான்றாகும்."}], "options": ["கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "கூற்றுகள் அனைத்தும் சரி"], "explanation": "கூற்றுகள் 1, 2, 3 சரியானவை. கூற்று 4 தவறு; மேடு (உயரம்) மற்றும் பள்ளம் (தாழ்வு) என்பன எதிரெதிர்ப் பொருள் தருவதால் 'மேடுபள்ளம்' என்பது 'எதிரிணை' ஆகும் (நேரிணை அல்ல)."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding paired words (இணைச்சொற்கள்) in Tamil:\n1. Paired words that convey identical meanings are called Neerinai (e.g., சீரும் சிறப்பும், பேரும் புகழும்).\n2. Paired words that convey opposite/contrasting meanings are called Ethirinai (e.g., இரவுபகல், உயர்வுதாழ்வு).\n3. Paired words that convey intensity or concentration of property are called Seriyinai (e.g., பச்சைப்பசேல், வெள்ளைவெளேர்).\n4. 'மேடுபள்ளம்' is an example of Neerinai conveying identical meaning."}], "options": ["Statements 1, 4 are correct; 2, 3 are incorrect", "Statements 2, 3, 4 are correct; 1 is incorrect", "Statements 1, 2, 3 are correct; Statement 4 is incorrect", "All statements are correct"], "explanation": "Statements 1, 2, 3 are correct. Statement 4 is false because 'மேடுபள்ளம்' consists of antonyms (crest and trough), making it Ethirinai, not Neerinai."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "text_ta": "ஒரே பொருள் தருவது நேரிணை.", "text_en": "Identical meaning is Neerinai."}, {"id": "S2", "text_ta": "எதிரெதிர்ப் பொருள் தருவது எதிரிணை.", "text_en": "Antonym pair is Ethirinai."}, {"id": "S3", "text_ta": "பொருளின் செறிவைக் குறிப்பது செறியிணை.", "text_en": "Intensity of quality is Seriyinai."}, {"id": "S4", "text_ta": "'மேடுபள்ளம்' என்பது நேரிணைக்குச் சான்றாகும்.", "text_en": "'மேடுபள்ளம்' is an example of Neerinai."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 85, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["paired-words", "grammar", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q536", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "8th-u4-l6", "chapter_id": null, "topic_id": "kural-sengonmai-vinaiyadal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறள் - 'தெரிந்து வினையாடல்' மற்றும் 'செங்கோன்மை' அதிகாரங்கள் குறித்த கூற்றுகளை ஆராய்க:\n1. செயலாற்றும் திறன் உடையவரையும், செய்ய வேண்டிய செயலையும், காலத்தையும் ஆராய்ந்து அச்செயலை நிறைவேற்ற வேண்டும்.\n2. 'இதனை இதனால் இவன்முடிக்கும் என்றுஆய்ந்து அதனை அவன்கண் விடல்' என்பது தகுதியுடையவரிடம் பொறுப்பை ஒப்படைக்கும் நெறியாகும்.\n3. உலகத்து உயிர்களை எல்லாம் அரசர் காப்பாற்றுவார்; குற்றமற்ற நேர்மையான ஆட்சியே அரசரைக் காப்பாற்றும்.\n4. அரசன் ஒருதலைப்பட்சமாகத் தன் விருப்பத்திற்கு ஏற்ப ஆராயாமல் உடனே தண்டிப்பதே செங்கோன்மை எனப்படும்."}], "options": ["கூற்றுகள் 1, 2 சரி; 3, 4 தவறு", "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு"], "explanation": "கூற்றுகள் 1, 2, 3 சரியானவை. கூற்று 4 முற்றிலும் தவறு; எதனையும் நன்கு ஆராய்ந்து, ஒருபக்கம் சாயாது நடுவுநிலையில் நின்று நடத்துவதே சிறந்த ஆட்சியாகும் ('ஓர்ந்துகண் ணோடாது இறைபுரிந்து யார்மாட்டும் தேர்ந்துசெய் வஃதே முறை')."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements on Thirukkural chapters 'Therinthu Vinaiyadal' and 'Sengonmai':\n1. A task must be undertaken after analyzing the capable person, the nature of the task, and the opportune time.\n2. 'இதனை இதனால் இவன்முடிக்கும்...' directs that duties must be delegated after assessing who can accomplish it by what means.\n3. A king protects all living beings of the world, and his own just and blameless rule protects the king.\n4. Punishing arbitrarily and biasedly according to personal whims constitutes just governance (Sengonmai)."}], "options": ["Statements 1, 2 are correct; 3, 4 are incorrect", "Statements 2, 3, 4 are correct; 1 is incorrect", "Statements 1, 4 are correct; 2, 3 are incorrect", "Statements 1, 2, 3 are correct; Statement 4 is incorrect"], "explanation": "Statements 1, 2, 3 are correct. Statement 4 is false because just rule requires impartial investigation without favoritism or arbitrary punishment."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "text_ta": "செய்பவர், செயல், காலம் ஆராய்ந்து செயலாற்ற வேண்டும்.", "text_en": "Analyze doer, deed, and time."}, {"id": "S2", "text_ta": "ஆராய்ந்து அச்செயலை அவரிடம் ஒப்படைக்க வேண்டும்.", "text_en": "Delegate after assessing capability."}, {"id": "S3", "text_ta": "அரசரை அவரது குற்றமற்ற ஆட்சி காப்பாற்றும்.", "text_en": "Just rule protects the monarch."}, {"id": "S4", "text_ta": "ஆராயாமல் தண்டிப்பதே செங்கோன்மை ஆகும்.", "text_en": "Arbitrary punishment is just rule."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 88, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["thirukkural", "sengonmai", "governance", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q537", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l6", "chapter_id": null, "topic_id": "kural-solvanmai-avaiyarithal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறள் - 'சொல்வன்மை' மற்றும் 'அவையறிதல்' அதிகாரக் கருத்துகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. கேட்பவரைத் தன்வயப்படுத்துவதும் கேளாதவரைக் கேட்கத் தூண்டுவதும் சிறந்த சொல்லாற்றலின் இயல்பாகும்.\n2. நாம் சொல்லும் சொல்லை வேறு சொல்லால் வெல்ல இயலாதவாறு சிறந்த சொற்களைத் தேர்ந்தெடுத்துப் பேச வேண்டும்.\n3. 'சொல்லுக சொல்லைப் பிறிதுஓர்சொல் அச்சொல்லை வெல்லும்சொல் இன்மை அறிந்து' என்ற குறளில் சொற்பொருள் பின்வருநிலை அணி பயின்று வந்துள்ளது.\n4. சொற்களை ஆராயும் அறிஞர்கள் நிறைந்த அவையில்தான் பல நூல்களைக் கற்றவரின் கல்வி பெருமையடையும்."}], "options": ["கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "கூற்றுகள் 1, 2 மட்டும் சரி; 3, 4 தவறு", "கூற்றுகள் 2, 3, 4 மட்டும் சரி; 1 தவறு", "கூற்றுகள் 1, 3 மட்டும் சரி; 2, 4 தவறு"], "explanation": "பாடநூல் பக்கங்கள் 89-90-இன் படி: சொல்லாற்றல் கேட்பவரை ஈர்க்க வேண்டும்; வெல்லும் சொல் இன்மை அறிந்து பேச வேண்டும்; இதில் சொற்பொருள் பின்வருநிலையணி அமைந்துள்ளது; அவை அறிந்து பேசும்போது கல்வி விளங்கும். நான்கு கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements on Thirukkural chapters 'Solvanmai' and 'Avaiyarithal':\n1. Winning over listeners and inspiring non-listeners to listen are the innate qualities of eloquence.\n2. One must speak chosen words such that no other word can defeat or supersede that utterance.\n3. In the Kural 'சொல்லுக சொல்லை...', the figure of speech used is Sorporul Pinvarunilai Ani.\n4. An erudite scholar's learning shines with glory only in an assembly of experts who discern refined words."}], "options": ["All statements 1, 2, 3, 4 are correct", "Statements 1, 2 only are correct; 3, 4 are incorrect", "Statements 2, 3, 4 only are correct; 1 is incorrect", "Statements 1, 3 only are correct; 2, 4 are incorrect"], "explanation": "As explained on pages 89-90, all four statements regarding eloquence, word selection, Sorporul Pinvarunilai Ani, and speaking before a discerning audience are verified."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "text_ta": "கேட்பவரைத் தன்வயப்படுத்துவது சொல்வன்மையின் இயல்பு.", "text_en": "Winning listeners is the nature of eloquence."}, {"id": "S2", "text_ta": "வெல்லும் சொல் இன்மை அறிந்து பேச வேண்டும்.", "text_en": "Speak words that cannot be defeated."}, {"id": "S3", "text_ta": "இக்குறளில் சொற்பொருள் பின்வருநிலை அணி பயின்று வந்துள்ளது.", "text_en": "Sorporul Pinvarunilai Ani is present."}, {"id": "S4", "text_ta": "சொல்தெரிதல் வல்லார் அகத்தில் கல்வி விளங்கும்.", "text_en": "Learning shines before discerning audience."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 89, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["thirukkural", "solvanmai", "avaiyarithal", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q538", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l6", "chapter_id": null, "topic_id": "kural-veruvantha-seiyaamai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறள் - 'வெருவந்த செய்யாமை' அதிகாரக் கருத்துகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. ஒருவர் செய்த குற்றத்தை முறையாக ஆராய்ந்து, அவர் மீண்டும் குற்றம் செய்யாதவாறு தண்டிப்பது அரசனின் கடமையாகும்.\n2. குடிமக்களுக்குக் கொடூரமான கொடுந்தண்டனைகளை வழங்கி அவர்கள் அஞ்சும்படி அரசாள்வதே வெருவந்த செய்யாமை எனப்படும்.\n3. 'கடுமையானவர்' என்று குடிமக்களால் தூற்றப்படும் இழிசொல்லுக்கு ஆளான அரசர், தன் வாழ்நாள் குறைந்து விரைவில் அழிவார்.\n4. 'இறைகடியன் என்றுஉரைக்கும் இன்னாச்சொல் வேந்தன் உறைகடுகி ஒல்லைக் கெடும்' என்னும் குறள் கொடுங்கோன்மையின் அழிவைக் கூறுகிறது."}], "options": ["கூற்றுகள் 1, 2 சரி; 3, 4 தவறு", "கூற்றுகள் 1, 3, 4 சரி; கூற்று 2 தவறு", "கூற்றுகள் 2, 4 சரி; 1, 3 தவறு", "கூற்றுகள் அனைத்தும் சரி"], "explanation": "கூற்றுகள் 1, 3, 4 சரியானவை. கூற்று 2 தவறு; 'வெருவந்த செய்யாமை' என்பது குடிமக்கள் அஞ்சத்தக்க கொடுஞ்செயல்களை அரசன் செய்யாமல் இருப்பதைக் குறிக்குமே தவிர, அச்சுறுத்துவதைக் குறிக்காது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements on the Thirukkural chapter 'Veruvantha Seiyaamai' (Not Acting Tyrannically):\n1. It is a king's duty to impartially examine a crime and punish appropriately so that the offense is not repeated.\n2. Inflicting atrocious cruelties to make citizens live in terror is the definition of Veruvantha Seiyaamai.\n3. A king subjected to the ill repute of being called 'harsh/cruel' by his citizens will suffer shortened life and swift ruin.\n4. The Kural 'இறைகடியன் என்றுஉரைக்கும்...' prophesies the immediate ruin of a tyrannical monarch."}], "options": ["Statements 1, 2 are correct; 3, 4 are incorrect", "Statements 1, 3, 4 are correct; Statement 2 is incorrect", "Statements 2, 4 are correct; 1, 3 are incorrect", "All statements are correct"], "explanation": "Statements 1, 3, 4 are correct. Statement 2 is false because 'Veruvantha Seiyaamai' literally means refraining from tyrannical terror acts."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "text_ta": "மீண்டும் குற்றம் செய்யாதவாறு தண்டிப்பது வேந்தன் கடமை.", "text_en": "Punishing to deter recurrence is duty."}, {"id": "S2", "text_ta": "குடிமக்களை அச்சுறுத்தி அரசாள்வதே வெருவந்த செய்யாமை.", "text_en": "Terrorizing citizens is Veruvantha Seiyaamai."}, {"id": "S3", "text_ta": "கடுமையானவர் எனத் தூற்றப்படும் அரசன் விரைவில் அழிவான்.", "text_en": "King decried as cruel is swiftly ruined."}, {"id": "S4", "text_ta": "'இறைகடியன்...' குறள் கொடுங்கோன்மையின் வீழ்ச்சியைக் கூறுகிறது.", "text_en": "'இறைகடியன்...' warns of tyrant's ruin."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 88, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["thirukkural", "justice", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q539", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l5", "chapter_id": null, "topic_id": "unit4-vocabulary-terms", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல் 4-இன் இறுதியில் இடம்பெற்றுள்ள கலைச்சொற்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. Crafts என்பதன் தமிழ்ச் சொல் 'கைவினைப் பொருள்கள்' ஆகும்.\n2. Flute என்பது 'புல்லாங்குழல்' எனவும், Drum என்பது 'முரசு' எனவும் மொழிபெயர்க்கப்படுகின்றன.\n3. Artisan என்னும் ஆங்கிலச் சொல்லின் சரியான கலைச்சொல் தமிழாக்கம் 'விவசாயி' என்பதாகும்.\n4. Basketry என்பது 'கூடைமுடைதல்' எனவும், Rite என்பது 'சடங்கு' எனவும் வழங்கப்படுகின்றன."}], "options": ["கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "கூற்றுகள் 1, 2, 4 சரி; கூற்று 3 தவறு", "கூற்றுகள் அனைத்தும் சரி"], "explanation": "கூற்றுகள் 1, 2, 4 சரியானவை. கூற்று 3 தவறு; ஏனெனில் 'Artisan' என்பதன் சரியான தமிழாக்கம் 'கைவினைஞர்' ஆகும் (விவசாயி என்பது Farmer)."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding the technical vocabulary in Unit 4:\n1. The Tamil equivalent for Crafts is 'கைவினைப் பொருள்கள்'.\n2. Flute translates to 'புல்லாங்குழல்' and Drum translates to 'முரசு'.\n3. The accurate Tamil translation for Artisan is 'விவசாயி' (Farmer).\n4. Basketry translates to 'கூடைமுடைதல்' and Rite translates to 'சடங்கு'."}], "options": ["Statements 1, 4 are correct; 2, 3 are incorrect", "Statements 2, 3, 4 are correct; 1 is incorrect", "Statements 1, 2, 4 are correct; Statement 3 is incorrect", "All statements are correct"], "explanation": "Statements 1, 2, 4 are correct. Statement 3 is false because 'Artisan' translates to 'கைவினைஞர்', not விவசாயி."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "text_ta": "Crafts என்பது கைவினைப் பொருள்கள் ஆகும்.", "text_en": "Crafts is கைவினைப் பொருள்கள்."}, {"id": "S2", "text_ta": "Flute புல்லாங்குழல்; Drum முரசு.", "text_en": "Flute is புல்லாங்குழல்; Drum is முரசு."}, {"id": "S3", "text_ta": "Artisan என்பது விவசாயி ஆகும்.", "text_en": "Artisan is farmer."}, {"id": "S4", "text_ta": "Basketry கூடைமுடைதல்; Rite சடங்கு.", "text_en": "Basketry is கூடைமுடைதல்; Rite is சடங்கு."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 87, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vocabulary", "terms", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q540", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l5", "chapter_id": null, "topic_id": "exclamatory-sentence-emotion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று மற்றும் காரணத்தை ஆராய்ந்து சரியான விடையைத் தேர்க:\nகூற்று (A): \"ஆ! புலி வருகிறது!\" என்னும் தொடரானது பெருமகிழ்ச்சியையும் உவகையையும் உணர்த்தும் உணர்ச்சித் தொடராகும்.\nகாரணம் (R): உவகை, அழுகை, அவலம், அச்சம், வியப்பு முதலான உள்ளத்து உணர்ச்சிகளை வெளிப்படுத்தும் தொடர் உணர்ச்சித் தொடர் எனப்படும்."}], "options": ["கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்", "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கமல்ல", "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு", "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி"], "explanation": "கூற்று (A) தவறு; 'ஆ! புலி வருகிறது!' என்பது 'அச்ச உணர்வை' உணர்த்தும் தொடர் ஆகும் (மகிழ்ச்சி அல்ல). காரணம் (R) சரி; உணர்ச்சிகளை உணர்த்தும் தொடர் உணர்ச்சித் தொடர் எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Examine the assertion and reason:\nAssertion (A): The sentence 'ஆ! புலி வருகிறது!' is an exclamatory sentence conveying extreme joy and celebration.\nReason (R): Sentences that give voice to inner emotional states like joy, sorrow, pathos, fear, and wonder are called Exclamatory sentences."}], "options": ["Both (A) and (R) are correct; (R) is the correct explanation", "Both (A) and (R) are correct; (R) is not the correct explanation", "(A) is correct; but (R) is incorrect", "(A) is incorrect; but (R) is correct"], "explanation": "Assertion (A) is false; 'ஆ! புலி வருகிறது!' conveys fear (அச்சம்), not joy. Reason (R) is correct."}}, "question_data": {"assertion": "\"ஆ! புலி வருகிறது!\" என்னும் தொடரானது பெருமகிழ்ச்சியையும் உவகையையும் உணர்த்தும் உணர்ச்சித் தொடராகும்.", "reason": "உவகை, அழுகை, அவலம், அச்சம், வியப்பு முதலான உணர்ச்சிகளை வெளிப்படுத்தும் தொடர் உணர்ச்சித் தொடர் எனப்படும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 84, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["unarchi-thodar", "assertion-reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q541", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l6", "chapter_id": null, "topic_id": "sorporul-pinvarunilai-kural", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று மற்றும் காரணத்தை ஆராய்ந்து சரியான விடையைத் தேர்க:\nகூற்று (A): \"சொல்லுக சொல்லைப் பிறிதுஓர்சொல் அச்சொல்லை வெல்லும்சொல் இன்மை அறிந்து\" என்னும் திருக்குறளில் சொற்பொருள் பின்வருநிலை அணி அமைந்துள்ளது.\nகாரணம் (R): ஒரு செய்யுளில் வந்த சொல்லே மீண்டும் மீண்டும் வந்து, 'சொல்' (உரை/வார்த்தை) என்னும் ஒரே பொருளைத் தந்துள்ளதால் இது சொற்பொருள் பின்வருநிலை அணி ஆயிற்று."}], "options": ["கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) கூற்றுக்குச் சரியான விளக்கம் ஆகும்", "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) கூற்றுக்குச் சரியான விளக்கமல்ல", "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு", "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி"], "explanation": "கூற்று மற்றும் காரணம் இரண்டும் சரி. ஒரே சொல் ஒரே பொருளில் மீண்டும் மீண்டும் வந்தால் அது சொற்பொருள் பின்வருநிலையணி; இக்குறளில் 'சொல்' என்னும் சொல் ஒரே பொருளில் மீண்டும் மீண்டும் வந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Examine the assertion and reason:\nAssertion (A): In the Kural 'சொல்லுக சொல்லை...', the figure of speech used is Sorporul Pinvarunilai Ani.\nReason (R): Because the same word 'சொல்' repeats multiple times yielding the exact same meaning ('word/utterance'), it constitutes Sorporul Pinvarunilai Ani."}], "options": ["Both (A) and (R) are correct; (R) is the correct explanation for (A)", "Both (A) and (R) are correct; (R) is not the correct explanation", "(A) is correct; but (R) is incorrect", "(A) is incorrect; but (R) is correct"], "explanation": "Both assertion and reason are correct. Repetition of the identical word with the identical meaning defines Sorporul Pinvarunilai Ani."}}, "question_data": {"assertion": "\"சொல்லுக சொல்லைப் பிறிதுஓர்சொல் அச்சொல்லை வெல்லும்சொல் இன்மை அறிந்து\" என்னும் குறளில் சொற்பொருள் பின்வருநிலை அணி அமைந்துள்ளது.", "reason": "செய்யுளில் வந்த சொல்லே மீண்டும் மீண்டும் வந்து ஒரே பொருளைத் தந்துள்ளதால் இது சொற்பொருள் பின்வருநிலை அணி ஆயிற்று.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 89, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["thirukkural", "ani-ilakkanam", "assertion-reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q542", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l5", "chapter_id": null, "topic_id": "seriyinai-words-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று மற்றும் காரணத்தை ஆராய்ந்து சரியான விடையைத் தேர்க:\nகூற்று (A): \"பச்சைப்பசேல்\", \"வெள்ளைவெளேர்\" ஆகிய சொற்கள் செறியிணைச் சொற்களுக்குச் சிறந்த சான்றுகளாகும்.\nகாரணம் (R): ஒரு பண்பின் அல்லது வண்ணத்தின் அடர்த்தியையும் மிகுதியையும் செறிவாகக் குறித்து நிற்கும் இணைச்சொற்கள் 'செறியிணை' எனப்படும்."}], "options": ["கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி", "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) கூற்றுக்குச் சரியான விளக்கம் ஆகும்", "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு", "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு"], "explanation": "கூற்று மற்றும் காரணம் இரண்டும் சரி. பொருளின் செறிவைக் குறித்து வருவன செறியிணை எனப்படும்; பச்சைப்பசேல், வெள்ளைவெளேர் என்பன பண்பின் செறிவை உணர்த்துவதால் செறியிணைகள். காரணம் கூற்றை சரியாக விளக்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "Examine the assertion and reason:\nAssertion (A): 'பச்சைப்பசேல்' and 'வெள்ளைவெளேர்' are classic examples of Seriyinai words.\nReason (R): Paired words that specifically convey the density, intensity, or depth of a quality/color are termed Seriyinai."}], "options": ["(A) is incorrect; but (R) is correct", "Both (A) and (R) are correct; (R) is the correct explanation of (A)", "(A) is correct; but (R) is incorrect", "Both (A) and (R) are incorrect"], "explanation": "Both assertion and reason are correct. Seriyinai emphasizes the vividness or intensity of a quality/hue."}}, "question_data": {"assertion": "\"பச்சைப்பசேல்\", \"வெள்ளைவெளேர்\" ஆகிய சொற்கள் செறியிணைச் சொற்களுக்குச் சிறந்த சான்றுகளாகும்.", "reason": "ஒரு பண்பின் அல்லது வண்ணத்தின் அடர்த்தியையும் மிகுதியையும் செறிவாகக் குறித்து நிற்கும் இணைச்சொற்கள் செறியிணை எனப்படும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 85, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["paired-words", "seriyinai", "assertion-reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q543", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l6", "chapter_id": null, "topic_id": "kural-sengonmai-justice-rule", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று மற்றும் காரணத்தை ஆராய்ந்து சரியான விடையைத் தேர்க:\nகூற்று (A): அரசன் நடுவுநிலை தவறாது, அனைவரிடமும் குற்றமற்ற முறையில் செங்கோல் ஆட்சி நடத்த வேண்டும்.\nகாரணம் (R): மன்னன் எப்போதும் செல்வந்தர்களுக்கு ஆதரவாகவும், எளிய மக்களுக்குக் கடுமையான தண்டனைகளை வழங்குபவனாகவும் ஆட்சி செய்வதே வள்ளுவர் கூறும் செங்கோன்மை ஆகும்."}], "options": ["கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி", "கூற்று (A) தவறு; காரணம் (R) சரி", "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு", "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு"], "explanation": "கூற்று (A) சரி; நடுவுநிலை தவறாது ஆட்சி செய்வதே முறை. ஆனால் காரணம் (R) முற்றிலும் தவறு; வள்ளுவர் கூறுவது 'ஓர்ந்துகண் ணோடாது இறைபுரிந்து யார்மாட்டும் தேர்ந்துசெய் வஃதே முறை' - அதாவது எவர் பக்கமும் சாயாது நடுவுநிலையில் நின்று ஆள்வதே செங்கோன்மை ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Examine the assertion and reason:\nAssertion (A): A monarch must govern without deviating from neutrality, administering blameless justice to all.\nReason (R): Valluvar defines Sengonmai as ruling with partiality towards the wealthy while inflicting merciless punishments on the poor."}], "options": ["Both (A) and (R) are correct", "(A) is incorrect; (R) is correct", "(A) is correct; but (R) is incorrect", "Both (A) and (R) are incorrect"], "explanation": "Assertion (A) is correct. Reason (R) is absurd and false as Valluvar strictly mandates impartial justice without favoritism."}}, "question_data": {"assertion": "அரசன் நடுவுநிலை தவறாது, அனைவரிடமும் குற்றமற்ற முறையில் செங்கோல் ஆட்சி நடத்த வேண்டும்.", "reason": "மன்னன் செல்வந்தர்களுக்கு ஆதரவாகவும் எளியோருக்குக் கடுமையான தண்டனை வழங்குபவனாகவும் இருப்பதே செங்கோன்மை.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 88, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["thirukkural", "sengonmai", "assertion-reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q544", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l6", "chapter_id": null, "topic_id": "kural-metrics-alavadi-cinthadi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று மற்றும் காரணத்தை ஆராய்ந்து சரியான விடையைத் தேர்க:\nகூற்று (A): திருக்குறள் வெண்பாவில் முதலடியானது மூன்று சீர்களையும், இரண்டாம் அடியானது நான்கு சீர்களையும் கொண்டிருக்கும்.\nகாரணம் (R): யாப்பிலக்கணத்தில் நான்கு சீர்களைக் கொண்ட அடி 'அளவடி' என்றும், மூன்று சீர்களைக் கொண்ட அடி 'சிந்தடி' என்றும் அழைக்கப்படும்."}], "options": ["கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி", "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு", "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு", "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி"], "explanation": "கூற்று (A) தவறு; திருக்குறளில் 'முதலடி நான்கு சீர்களையும்' (அளவடி), 'இரண்டாம் அடி மூன்று சீர்களையும்' (சிந்தடி) கொண்டிருக்கும். காரணம் (R) சரி; நான்கு சீர் அடி அளவடி, மூன்று சீர் அடி சிந்தடி எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Examine the assertion and reason:\nAssertion (A): In Tirukkural venba couplets, the first line consists of three seers and the second line consists of four seers.\nReason (R): In Tamil prosody, a line with four metrical feet is called 'Alavadi' and a line with three feet is called 'Cinthadi'."}], "options": ["Both (A) and (R) are correct", "(A) is correct; but (R) is incorrect", "Both (A) and (R) are incorrect", "(A) is incorrect; but (R) is correct"], "explanation": "Assertion (A) is false; Kural couplets have 4 seers on the 1st line and 3 seers on the 2nd line. Reason (R) is correct."}}, "question_data": {"assertion": "திருக்குறள் வெண்பாவில் முதலடியானது மூன்று சீர்களையும், இரண்டாம் அடியானது நான்கு சீர்களையும் கொண்டிருக்கும்.", "reason": "நான்கு சீர்களைக் கொண்ட அடி 'அளவடி' என்றும், மூன்று சீர்களைக் கொண்ட அடி 'சிந்தடி' என்றும் அழைக்கப்படும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 89, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["thirukkural", "metrics", "assertion-reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q545", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l6", "chapter_id": null, "topic_id": "delegation-kural-modern-management", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று மற்றும் காரணத்தை ஆராய்ந்து சரியான விடையைத் தேர்க:\nகூற்று (A): \"இதனை இதனால் இவன்முடிக்கும் என்றுஆய்ந்து அதனை அவன்கண் விடல்\" என்னும் திருக்குறள் நவீன நிர்வாக மேலாண்மையின் அதிகாரப் பகிர்வுக்கு முன்னோடியாகத் திகழ்கிறது.\nகாரணம் (R): ஒரு குறிப்பிட்ட செயலை எந்த வழிமுறையால் யார் செய்து முடிப்பார் என்று ஆராய்ந்து, அச்செயலை அவரிடம் முழு நம்பிக்கையோடு ஒப்படைக்க வேண்டும் என்று வள்ளுவர் வழிகாட்டுகிறார்."}], "options": ["கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) கூற்றுக்குச் சரியான விளக்கம் ஆகும்", "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) கூற்றுக்குச் சரியான விளக்கமல்ல", "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு", "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி"], "explanation": "கூற்று மற்றும் காரணம் இரண்டும் சரி. ஒரு செயலைத் திறமையுள்ளவரிடம் வழிமுறை ஆராய்ந்து ஒப்படைப்பதே தெரிந்து வினையாடல் ஆகும்; இதுவே நிர்வாகத்தின் சிறந்த அதிகாரப் பகிர்வு முறைமை ஆகும். காரணம் கூற்றை மிகச் சரியாக விளக்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "Examine the assertion and reason:\nAssertion (A): The Kural 'இதனை இதனால் இவன்முடிக்கும்...' stands as an ancient precursor to modern management principles of delegation of authority.\nReason (R): Valluvar advises that after discerning who can accomplish a given deed through what specific means, the responsibility must be entrusted to that capable person."}], "options": ["Both (A) and (R) are correct; (R) is the correct explanation for (A)", "Both (A) and (R) are correct; (R) is not the correct explanation", "(A) is correct; but (R) is incorrect", "(A) is incorrect; but (R) is correct"], "explanation": "Both assertion and reason are correct. Delegating duties after assessing competence and method is the core insight of this couplet."}}, "question_data": {"assertion": "\"இதனை இதனால் இவன்முடிக்கும் என்றுஆய்ந்து அதனை அவன்கண் விடல்\" அதிகாரப் பகிர்வுக்கு முன்னோடியாகும்.", "reason": "ஒரு செயலை யார் எப்படி முடிப்பார் என்று ஆராய்ந்து அவரிடம் ஒப்படைக்க வேண்டும் என்று வள்ளுவர் கூறுகிறார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 88, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["thirukkural", "management", "delegation", "assertion-reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q546", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l5", "chapter_id": null, "topic_id": "sentence-types-examples-matching", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொடர் வகைகளையும் அவற்றுக்குரிய பொருத்தமான எடுத்துக்காட்டுகளையும் பொருத்துக:\nஅ) செய்தித் தொடர் - 1. சிலப்பதிகாரத்தை இயற்றியவர் யார்?\nஆ) வினாத் தொடர் - 2. கரிகாலன் கல்லணையைக் கட்டினான்\nஇ) விழைவுத் தொடர் - 3. அந்தோ! பூனையின் காலில் அடிபட்டுவிட்டதே!\nஈ) உணர்ச்சித் தொடர் - 4. உழவுத்தொழில் வாழ்க!"}], "options": ["அ-1, ஆ-2, இ-3, ஈ-4", "அ-2, ஆ-1, இ-4, ஈ-3", "அ-3, ஆ-4, இ-1, ஈ-2", "அ-4, ஆ-3, இ-2, ஈ-1"], "explanation": "செய்தித் தொடர் = கரிகாலன் கல்லணையைக் கட்டினான் (2); வினாத் தொடர் = சிலப்பதிகாரத்தை இயற்றியவர் யார்? (1); விழைவுத் தொடர் = உழவுத்தொழில் வாழ்க! (4); உணர்ச்சித் தொடர் = அந்தோ! பூனையின் காலில் அடிபட்டுவிட்டதே! (3). சரியான வரிசை: அ-2, ஆ-1, இ-4, ஈ-3."}, "en": {"blocks": [{"type": "text", "content": "Match the sentence categories with their examples:\na) Declarative sentence - 1. Who authored Silappathikaram?\nb) Interrogative sentence - 2. Karikalan built the Kallanai.\nc) Optative sentence - 3. Alas! The cat's leg is injured!\nd) Exclamatory sentence - 4. Long live agriculture!"}], "options": ["a-1, b-2, c-3, d-4", "a-2, b-1, c-4, d-3", "a-3, b-4, c-1, d-2", "a-4, b-3, c-2, d-1"], "explanation": "Declarative = Karikalan built Kallanai (2); Interrogative = Who authored Silappathikaram? (1); Optative = Long live agriculture (4); Exclamatory = Alas! The cat is hurt! (3). Sequence: a-2, b-1, c-4, d-3."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [{"left_ta": "செய்தித் தொடர்", "left_en": "Declarative", "right_ta": "கரிகாலன் கல்லணையைக் கட்டினான்", "right_en": "Karikalan built Kallanai"},