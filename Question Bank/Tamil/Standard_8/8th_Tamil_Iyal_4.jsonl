// பாடம் 3: தமிழர் இசைக்கருவிகள் பகுதி 2 (இசைக்கலைக்களஞ்சியம்) [Q477 - Q504]
// குழல்: புல்லாங்குழல் / வேய்ங்குழல், வண்டு துளைத்த மூங்கில், 7 துளைகள் (7 சுரங்கள்), சந்தனம்/செங்காலி/கருங்காலி, சிலப்பதிகாரம் (கொன்றைக்குழல், முல்லைக்குழல், ஆம்பல்குழல்), திருக்குறள் 'குழல்இனிது யாழ்இனிது'; கொம்பு: விலங்கு கொம்பு, பித்தளை/வெண்கலம், ஊதுகொம்பு, எக்காளம், சிங்கநாதம், துத்தரி; சங்கு: கடலில் எடுக்கும் இயற்கை காற்றுக்கருவி, வலம்புரிச் சங்கு, இலக்கியப் பெயர் 'பணிலம்'; சாலரா: கஞ்சக்கருவி, வெண்கலம்/பித்தளை, பாண்டில் / ஜால்ரா; பறை: விலங்குத்தோல், கோட்பறை (செய்தி), ஆகோட்பறை (ஆநிரை கவர்தல்), தப்பு / தப்பாட்டம்; திமிலை: பலா மரம், மணற்கடிகார வடிவம், விலங்குத்தோல், இலக்கியப் பெயர் 'பாணி'; சேகண்டி: வட்ட மணி, சேமங்கலம், கோயில் / இறுதி ஊர்வலம்; முழவு: ஒருமுக முரசு, பசைமண் தடவுதல், 'மண்ணமை முழவு' (பொருநராற்றுப்படை), நாழிகை/காலை முழவு; முரசு: போர்த்துணை, படைமுரசு, கொடைமுரசு, மணமுரசு, சிலப்பதிகாரம் 36 முரசுகள், 'மாக்கண் முரசம்' (மதுரைக்காஞ்சி); மத்தளம்: மத்து + தளம் (அடியார்க்கு நல்லார்), முதற்கருவி, தஞ்சைப் பெரியகோவில் கல்வெட்டு 'கொட்டி மத்தளம் வாசிப்பவர்'; வீணை: 7 நரம்புகள், 'பரிவாதினி' வீணை (பல்லவன் மகேந்திரவர்மன்); யாழ்: வில் நாண் ஓசை, பேரியாழ் (21 நரம்புகள்), மகரயாழ் (19 நரம்புகள், மீன் வடிவம்), சகோடயாழ் (14 நரம்புகள்)
// ==============================================================================
{"id": "8th-u4-q477", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l3", "chapter_id": null, "topic_id": "kuzhal-flute-details", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புல்லாங்குழல் மற்றும் அதன் இலக்கியக் குறிப்புகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. மூங்கிலில் வண்டு துளையிட, அதன் வழியே காற்று வீசும்போது எழுந்த இன்னிசையே புல்லாங்குழல் தோன்றக் காரணமானது.\n2. புல்லாங்குழல் ஏழு சுரங்களை உண்டாக்குவதற்கு உரிய ஏழு துளைகளைக் கொண்டதாகும்.\n3. மூங்கில் மட்டுமன்றிச் சந்தனம், செங்காலி, கருங்காலி ஆகிய மரங்களாலும் குழல்கள் செய்யப்படுகின்றன.\n4. சிலப்பதிகாரத்தில் கொன்றைக்குழல், முல்லைக்குழல், ஆம்பல்குழல் எனப் பலவகைக் குழல்கள் குறிப்பிடப்பட்டுள்ளன."}], "options": ["கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "கூற்றுகள் 1, 2 மட்டும் சரி; 3, 4 தவறு", "கூற்றுகள் 2, 3, 4 மட்டும் சரி; 1 தவறு", "கூற்றுகள் 1, 3 மட்டும் சரி; 2, 4 தவறு"], "explanation": "பாடநூல் பக்கம் 77-இன் படி: வண்டு துளையிட்ட மூங்கிலில் காற்று வீசியதால் தோன்றியதே குழல்; ஏழு சுரங்களுக்குரிய ஏழு துளைகள் உண்டு; சந்தனம், செங்காலி, கருங்காலி மரங்களாலும் செய்யப்படும்; சிலப்பதிகாரம் கொன்றைக்குழல், முல்லைக்குழல், ஆம்பல்குழல் ஆகியவற்றைக் குறிப்பிடுகிறது. நான்கு கூற்றுகளும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding the flute and its literary mentions:\n1. Natural music produced by wind blowing through beetle-bored holes in bamboo inspired the invention of the flute.\n2. The flute possesses seven finger-holes corresponding to the production of the seven basic musical notes.\n3. Flutes are crafted not only from bamboo, but also from sandalwood, red ebony, and black ebony wood.\n4. Silappathikaram mentions various flutes such as Konrai-k-kuzhal, Mullai-k-kuzhal, and Aambal-k-kuzhal."}], "options": ["All statements 1, 2, 3, 4 are correct", "Statements 1, 2 only are correct; 3, 4 are incorrect", "Statements 2, 3, 4 only are correct; 1 is incorrect", "Statements 1, 3 only are correct; 2, 4 are incorrect"], "explanation": "As per textbook page 77, beetle-bored bamboo inspired flutes, they feature 7 holes for 7 swaras, are crafted from woods like ebony and sandalwood, and Silappathikaram documents Konrai, Mullai, and Aambal flutes. All 4 statements are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "text_ta": "மூங்கிலில் வண்டு துளையிட்டதால் காற்று வீசி இசை எழுந்தது.", "text_en": "Beetle-bored bamboo inspired flute."}, {"id": "S2", "text_ta": "புல்லாங்குழல் ஏழு சுரங்களுக்குரிய ஏழு துளைகள் கொண்டது.", "text_en": "Flute has 7 holes for 7 notes."}, {"id": "S3", "text_ta": "சந்தனம், செங்காலி, கருங்காலி மரங்களாலும் குழல் செய்வர்.", "text_en": "Flutes are made from sandalwood and ebony."}, {"id": "S4", "text_ta": "சிலப்பதிகாரம் கொன்றைக்குழல், முல்லைக்குழல், ஆம்பல்குழல் பற்றிக் கூறுகிறது.", "text_en": "Silappathikaram notes Konrai, Mullai, Aambal flutes."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 77, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["flute", "kuzhal", "silappathikaram", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q478", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l3", "chapter_id": null, "topic_id": "kombu-sangu-details", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காற்றுக்கருவிகளான கொம்பு மற்றும் சங்கு குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. மனிதர்கள் தொடக்க காலத்தில் இறந்த மாடுகளின் கொம்புகளைப் பயன்படுத்தி ஒலி எழுப்பினர்.\n2. இக்காலத்தில் ஊதுகொம்பு, எக்காளம், சிங்கநாதம், துத்தரி போன்ற கொம்புகள் மரத்தினால் மட்டுமே செய்யப்படுகின்றன.\n3. வலமாகச் சுழிந்து இருக்கும் சங்கினை 'வலம்புரிச் சங்கு' என்று அழைப்பர்.\n4. பழந்தமிழ் இலக்கியங்களில் சங்கை 'பணிலம்' என்னும் பெயராலும் குறிப்பிட்டுள்ளனர்."}], "options": ["கூற்றுகள் 1, 2 சரி; 3, 4 தவறு", "கூற்றுகள் 1, 3, 4 சரி; கூற்று 2 தவறு", "கூற்றுகள் 2, 4 சரி; 1, 3 தவறு", "கூற்றுகள் அனைத்தும் சரி"], "explanation": "கூற்றுகள் 1, 3, 4 சரியானவை. கூற்று 2 தவறு; ஏனெனில் இக்காலத்தில் ஊதுகொம்பு, எக்காளம், சிங்கநாதம், துத்தரி போன்ற கொம்புகள் பித்தளை அல்லது வெண்கலத்தால் செய்யப்படுகின்றன (மரத்தினால் அல்ல)."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements on wind instruments Kombu (Horn) and Sangu (Conch):\n1. In early times, humans produced sound using the horns of deceased cattle.\n2. Modern horns such as Oothukombu, Ekkalam, Singanatham, and Thutthari are crafted solely from wood.\n3. A conch that curls/spirals to the right is revered as 'Valampuri Sangu'.\n4. In classical Tamil literature, the conch is also referred to by the term 'Panilam'."}], "options": ["Statements 1, 2 are correct; 3, 4 are incorrect", "Statements 1, 3, 4 are correct; Statement 2 is incorrect", "Statements 2, 4 are correct; 1, 3 are incorrect", "All statements are correct"], "explanation": "Statements 1, 3, 4 are correct. Statement 2 is false because modern horns like Ekkalam, Singanatham, and Thutthari are made of brass or bronze, not wood."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "text_ta": "தொடக்கத்தில் மாடுகளின் கொம்புகளைப் பயன்படுத்தி ஒலி எழுப்பினர்.", "text_en": "Animals' horns were used initially."}, {"id": "S2", "text_ta": "ஊதுகொம்பு, எக்காளம் மரத்தினால் மட்டுமே செய்யப்படுகின்றன.", "text_en": "Horns are made only of wood."}, {"id": "S3", "text_ta": "வலமாகச் சுழிந்த சங்கு வலம்புரிச் சங்கு எனப்படும்.", "text_en": "Right-spiraling conch is Valampuri."}, {"id": "S4", "text_ta": "இலக்கியங்களில் சங்கை 'பணிலம்' என்பர்.", "text_en": "Literature terms conch as Panilam."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 77, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["kombu", "sangu", "wind-instruments", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q479", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l3", "chapter_id": null, "topic_id": "salara-segandi-details", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கஞ்சக்கருவிகளான சாலரா மற்றும் சேகண்டி குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. சாலரா பித்தளை அல்லது வெண்கலத்தால் செய்யப்பட்டு, அதன் உட்புறம் குவிந்திருக்கும்.\n2. சாலராவைத் தாளத்தின் தேவைக்கேற்ப இசைப்பர்; இதனைப் 'பாண்டில்' எனவும் 'ஜால்ரா' எனவும் அழைப்பர்.\n3. வட்டவடிவமான மணி வகையைச் சேர்ந்த சேகண்டியைச் 'சேமங்கலம்' என்றும் அழைப்பர்.\n4. சேகண்டி என்பது விலங்குத் தோலினால் இழுத்துக் கட்டப்படும் தோல்கருவி வகையைச் சேர்ந்ததாகும்."}], "options": ["கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "கூற்றுகள் அனைத்தும் சரி"], "explanation": "கூற்றுகள் 1, 2, 3 சரியானவை. கூற்று 4 தவறு; சேகண்டி என்பது குச்சியாலோ இரும்புத் துண்டாலோ அடித்து ஒலி எழுப்பப்படும் 'கஞ்சக்கருவி' (உலோகக் கருவி) ஆகும்; தோல்கருவி அல்ல."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements on idiophones Salara and Segandi:\n1. Salara is crafted from brass or bronze with an inward convex/concave shape.\n2. Salara is struck according to rhythm; it is also termed 'Paandil' and popularly 'Jaalra'.\n3. Segandi, a circular metallic bell-plate instrument, is also called 'Semangalam'.\n4. Segandi belongs to the class of leather membranophones stretched with animal hide."}], "options": ["Statements 1, 4 are correct; 2, 3 are incorrect", "Statements 2, 3, 4 are correct; 1 is incorrect", "Statements 1, 2, 3 are correct; Statement 4 is incorrect", "All statements are correct"], "explanation": "Statements 1, 2, 3 are correct. Statement 4 is false because Segandi is a metallic idiophone (கஞ்சக்கருவி), not a leather percussion drum."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "text_ta": "சாலரா பித்தளை/வெண்கலத்தால் செய்யப்பட்டு உட்புறம் குவிந்திருக்கும்.", "text_en": "Salara is brass/bronze with hollow inner."}, {"id": "S2", "text_ta": "சாலராவைப் பாண்டில் என்றும் ஜால்ரா என்றும் அழைப்பர்.", "text_en": "Salara is called Paandil and Jaalra."}, {"id": "S3", "text_ta": "சேகண்டியைச் சேமங்கலம் என்றும் அழைப்பர்.", "text_en": "Segandi is called Semangalam."}, {"id": "S4", "text_ta": "சேகண்டி தோல்கருவி வகையைச் சேர்ந்ததாகும்.", "text_en": "Segandi is a leather drum."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 78, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["salara", "segandi", "idiophones", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q480", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l3", "chapter_id": null, "topic_id": "parai-thimilai-details", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தோல்கருவிகளான பறை மற்றும் திமிலை குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. பழங்காலத்தில் செய்திகளை மக்களுக்குத் தெரிவிக்க 'கோட்பறை' முழக்கப்பட்டது.\n2. பகைவர்களின் ஆநிரையைக் கவரச் செல்லும்போது முழக்கப்பட்டது 'ஆகோட்பறை' ஆகும்.\n3. பலா மரத்தினால் செய்யப்பட்டு மணற்கடிகார வடிவத்தில் அமைந்த கருவி 'திமிலை' ஆகும்.\n4. திமிலையை இலக்கியங்களில் 'பாண்டில்' என்னும் பெயரால் அழைப்பர்."}], "options": ["கூற்றுகள் 1, 2 சரி; 3, 4 தவறு", "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு"], "explanation": "கூற்றுகள் 1, 2, 3 சரியானவை. கூற்று 4 தவறு; திமிலையைப் 'பாணி' என்னும் பெயரால் அழைப்பர் (பக்கம் 78). 'பாண்டில்' என்பது சாலராவின் பெயராகும்."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements on percussion drums Parai and Thimilai:\n1. In ancient times, 'Kotparai' was beaten to broadcast messages and royal decrees.\n2. 'Aakotparai' was beaten when soldiers set out to raid the enemy's cattle herds.\n3. Thimilai is crafted from jackfruit wood (பலா மரம்) and shaped like an hourglass.\n4. In ancient literature, Thimilai is referred to by the name 'Paandil'."}], "options": ["Statements 1, 2 are correct; 3, 4 are incorrect", "Statements 2, 3, 4 are correct; 1 is incorrect", "Statements 1, 4 are correct; 2, 3 are incorrect", "Statements 1, 2, 3 are correct; Statement 4 is incorrect"], "explanation": "Statements 1, 2, 3 are correct. Statement 4 is false because Thimilai is named 'Paani' in literature, whereas 'Paandil' refers to Salara."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "text_ta": "செய்தி தெரிவிக்கக் கோட்பறை முழக்கப்பட்டது.", "text_en": "Kotparai announced news."}, {"id": "S2", "text_ta": "ஆநிரை கவரச் செல்லும்போது ஆகோட்பறை முழக்குவர்.", "text_en": "Aakotparai sounded during cattle raids."}, {"id": "S3", "text_ta": "பலா மரத்தினால் ஆன மணற்கடிகார வடிவக் கருவி திமிலை.", "text_en": "Thimilai is an hourglass drum made of jackfruit wood."}, {"id": "S4", "text_ta": "திமிலையைப் பாண்டில் என்று அழைப்பர்.", "text_en": "Thimilai is called Paandil."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 78, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["parai", "thimilai", "percussion", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q481", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l3", "chapter_id": null, "topic_id": "muzhavu-murasu-details", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முழவு மற்றும் முரசு குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. முழவு என்பது ஒரே முகத்தையுடைய முரசு வகையைச் சேர்ந்த ஒரு தோல்கருவியாகும்.\n2. முழவின் தோலில் பசைமண்ணைத் தடவி முழக்கியதை 'மண்ணமை முழவு' என்று பொருநராற்றுப்படை குறிப்பிடுகிறது.\n3. பழந்தமிழகத்தில் படைமுரசு, கொடைமுரசு, மணமுரசு என மூன்று வகையான முரசுகள் புழக்கத்தில் இருந்தன.\n4. தமிழ் மக்களிடம் 36 வகையான முரசுகள் புழக்கத்தில் இருந்ததாகச் சிலப்பதிகாரம் கூறுகிறது; மதுரைக்காஞ்சி 'மாக்கண் முரசம்' எனக் குறிப்பிடுகிறது."}], "options": ["கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "கூற்றுகள் 1, 2 மட்டும் சரி; 3, 4 தவறு", "கூற்றுகள் 2, 3, 4 மட்டும் சரி; 1 தவறு", "கூற்றுகள் 1, 3 மட்டும் சரி; 2, 4 தவறு"], "explanation": "பாடநூல் பக்கம் 79-இன் படி: முழவு ஒருமுக முரசு; மண்ணமை முழவு எனப் பொருநராற்றுப்படை கூறுகிறது; படை, கொடை, மணமுரசு என 3 வகை உண்டு; சிலப்பதிகாரம் 36 வகை முரசுகளையும், மதுரைக்காஞ்சி 'மாக்கண் முரசம்' என்பதையும் குறிப்பிடுகிறது. நான்கு கூற்றுகளும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements on Muzhavu and Murasu:\n1. Muzhavu is a single-faced drum belonging to the Murasu percussion family.\n2. Smearing clay paste on Muzhavu's skin is praised as 'மண்ணமை முழவு' in Porunarattruppadai.\n3. Ancient Tamil society possessed three state drums: Padai Murasu (War), Kodai Murasu (Charity), and Mana Murasu (Marriage).\n4. Silappathikaram records that 36 types of Murasu were used by Tamils; Maduraikkanchi mentions 'மாக்கண் முரசம்'."}], "options": ["All statements 1, 2, 3, 4 are correct", "Statements 1, 2 only are correct; 3, 4 are incorrect", "Statements 2, 3, 4 only are correct; 1 is incorrect", "Statements 1, 3 only are correct; 2, 4 are incorrect"], "explanation": "As per textbook page 79, all four statements regarding Muzhavu, clay application, the three state drums, 36 Murasu types in Silappathikaram, and 'Makkan Murasam' in Maduraikkanchi are factual."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "text_ta": "முழவு ஒரே முகத்தையுடைய முரசு வகை.", "text_en": "Muzhavu is a single-faced drum."}, {"id": "S2", "text_ta": "'மண்ணமை முழவு' என்று பொருநராற்றுப்படை கூறுகிறது.", "text_en": "Porunarattruppadai notes 'மண்ணமை முழவு'."}, {"id": "S3", "text_ta": "படைமுரசு, கொடைமுரசு, மணமுரசு என மூன்று முரசுகள் உண்டு.", "text_en": "Three drums: Padai, Kodai, Mana Murasu."}, {"id": "S4", "text_ta": "36 வகை முரசுகள் இருந்ததாகச் சிலப்பதிகாரம் கூறுகிறது.", "text_en": "Silappathikaram records 36 Murasu types."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 79, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["muzhavu", "murasu", "sangam-literature", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q482", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l3", "chapter_id": null, "topic_id": "maddhalam-details", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மத்தளம் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. மத்து என்பது ஓசையின் பெயர்; இசைக்கருவிகளுக்கு எல்லாம் தளம் அடிப்படை; எனவே 'மத்து + தளம் = மத்தளம்' என்று ஆகியது என்கிறார் அடியார்க்கு நல்லார்.\n2. மத்தளத்தின் நடுப்பகுதி மிகவும் சிறுத்தும், இரு கடைப்பகுதிகளும் பருத்தும் காணப்படும்.\n3. மத்தளம் இரண்டு கைகளாலும் இசைக்கப்படுவதால் இதனை 'முதற்கருவி' என்பர்.\n4. தஞ்சைப் பெரியகோவில் கல்வெட்டில் கோயிலுக்கு நியமிக்கப்பட்ட இசைக் கலைஞர்களுள் 'கொட்டி மத்தளம் வாசிப்பவர்' இடம்பெற்றுள்ளார்."}], "options": ["கூற்றுகள் 1, 2 சரி; 3, 4 தவறு", "கூற்றுகள் 1, 3, 4 சரி; கூற்று 2 தவறு", "கூற்றுகள் 2, 4 சரி; 1, 3 தவறு", "கூற்றுகள் அனைத்தும் சரி"], "explanation": "கூற்றுகள் 1, 3, 4 சரியானவை. கூற்று 2 தவறு; ஏனெனில் மத்தளத்தின் 'நடுப்பகுதி பருத்தும், கடைப்பகுதி சிறுத்தும்' காணப்படும் என்று பாடநூல் பக்கம் 79 தெளிவாகக் கூறுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding Maddhalam:\n1. Adiyarkkunallar states that Mathu is the sound, Thalam is rhythm base, thus Mathu + Thalam = Maddhalam.\n2. Maddhalam's middle portion is very narrow, and its two end faces are very wide.\n3. Because it is played with both hands as the foundational rhythm, it is called 'Mutharkaruvai' (Primary instrument).\n4. Inscriptions of Thanjavur Brihadisvara Temple record that a 'Kotti Maddhalam player' was appointed."}], "options": ["Statements 1, 2 are correct; 3, 4 are incorrect", "Statements 1, 3, 4 are correct; Statement 2 is incorrect", "Statements 2, 4 are correct; 1, 3 are incorrect", "All statements are correct"], "explanation": "Statements 1, 3, 4 are correct. Statement 2 is false because Maddhalam bulges in the middle and tapers at the ends, not vice versa."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "text_ta": "மத்து + தளம் = மத்தளம் என்று அடியார்க்கு நல்லார் கூறுகிறார்.", "text_en": "Adiyarkkunallar derives Mathu + Thalam."}, {"id": "S2", "text_ta": "மத்தளத்தின் நடுப்பகுதி சிறுத்தும் கடைப்பகுதி பருத்தும் இருக்கும்.", "text_en": "Middle is narrow and ends are wide."}, {"id": "S3", "text_ta": "மத்தளத்தை முதற்கருவி என்பர்.", "text_en": "Maddhalam is called Mutharkaruvai."}, {"id": "S4", "text_ta": "தஞ்சைப் பெரியகோவில் கல்வெட்டில் கொட்டி மத்தளம் வாசிப்பவர் இடம்பெற்றுள்ளார்.", "text_en": "Thanjavur inscription mentions maddhalam player."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 79, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["maddhalam", "inscriptions", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u4-q483", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l3", "chapter_id": null, "topic_id": "veena-yazh-details", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நரம்புக்கருவிகளான வீணை மற்றும் யாழ் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. வீணை ஏழு நரம்புகளைக் கொண்டது; 'பரிவாதினி' என்னும் வீணை பல்லவ மன்னன் மகேந்திரவர்மன் காலத்தில் வழக்கில் இருந்தது.\n2. வேட்டுவர் வில்லின் நாணிலிருந்து எழும் ஓசையின் அடிப்படையில் உருவான கருவி யாழ் ஆகும்.\n3. இருபத்தொரு நரம்புகளைக் கொண்டது பேரியாழ்; பதினான்கு நரம்புகளைக் கொண்டது சகோடயாழ்.\n4. பத்தொன்பது நரம்புகளைக் கொண்டு யானை வடிவில் அமைக்கப்பட்ட கருவி மகரயாழ் ஆகும்."}], "options": ["கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "கூற்றுகள் அனைத்தும் சரி"], "explanation": "கூற்றுகள் 1, 2, 3 சரியானவை. கூற்று 4 தவறு; ஏனெனில் மகரயாழ் 19 நரம்புகளைக் கொண்டது சரி, ஆனால் அது 'மீன் வடிவில்' அமைந்ததாகும் (யானை வடிவில் அல்ல)."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements on string instruments Veena and Yazh:\n1. Veena has 7 strings; a Veena named 'Parivadhini' existed during Pallava king Mahendravarman's reign.\n2. Yazh originated from the musical twang of hunters' bowstrings.\n3. Periyazh had 21 strings; Sagodayazh had 14 strings.\n4. Makarazh was a 19-stringed instrument designed in the shape of an elephant."}], "options": ["Statements 1, 4 are correct; 2, 3 are incorrect", "Statements 2, 3, 4 are correct; 1 is incorrect", "Statements 1, 2, 3 are correct; Statement 4 is incorrect", "All statements are correct"], "explanation": "Statements 1, 2, 3 are correct. Statement 4 is false because Makarazh is shaped like a fish (மீன் வடிவம்), not an elephant."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "text_ta": "வீணை ஏழு நரம்புகள் கொண்டது; பரிவாதினி வீணை மகேந்திரவர்மன் காலத்தது.", "text_en": "Veena has 7 strings; Parivadhini is from Mahendravarman's time."}, {"id": "S2", "text_ta": "வில் நாணின் ஓசையிலிருந்து யாழ் உருவானது.", "text_en": "Yazh originated from hunter's bowstring."}, {"id": "S3", "text_ta": "பேரியாழ் 21 நரம்புகள்; சகோடயாழ் 14 நரம்புகள்.", "text_en": "Periyazh 21 strings; Sagodayazh 14 strings."}, {"id": "S4", "text_ta": "மகரயாழ் யானை வடிவில் அமைக்கப்பட்ட கருவி.", "text_en": "Makarazh was shaped like an elephant."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 80, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["veena", "yazh", "chordophones", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "arch