{"id": "8th-u4-q498", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l3", "chapter_id": null, "topic_id": "valampuri-ilakkanakurippu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கணக் குறிப்புத் தேர்க:\n'வலம்புரி' என்னும் சொல்லுக்குப் பொருத்தமான இலக்கணக் குறிப்பு எது?"}], "options": ["பண்புத்தொகை", "வினைத்தொகை", "உவமைத்தொகை", "ஏழாம் வேற்றுமைத்தொகை"], "explanation": "'வலம்புரி' என்பது 'வலம்புரிந்த சங்கு, வலம்புரிகின்ற சங்கு, வலம்புரியும் சங்கு' என முக்காலத்திற்கும் பொருந்துமாறு காலங்காட்டும் இடைநிலை மறைந்து வந்துள்ளதால் இது 'வினைத்தொகை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Choose the correct grammatical category (Ilakkana Kurippu) for the word 'வலம்புரி':"}], "options": ["Panbuthogai", "Vinaithogai", "Uvamaithogai", "Seventh case compound"], "explanation": "'வலம்புரி' embeds past, present, and future action without overt tense markers (Valampurintha, Valampurikindra, Valampuriyum), classifying it as Vinaithogai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 77, "chapter": null,