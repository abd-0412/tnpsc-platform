{"id": "8th-u4-q502", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l3", "chapter_id": null, "topic_id": "yazh-strings-odd-pair", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நரம்புக்கருவிகளும் அவற்றின் நரம்புகளின் எண்ணிக்கையும் குறித்த இணைகளுள் பொருந்தாத ஒன்றைத் தேர்க:"}], "options": ["பேரியாழ் - 21 நரம்புகள்", "மகரயாழ் - 14 நரம்புகள்", "சகோடயாழ் - 14 நரம்புகள்", "வீணை - 7 நரம்புகள்"], "explanation": "மகரயாழ் என்பது '19 நரம்புகளைக்' கொண்டதாகும். 14 நரம்புகளைக் கொண்டது 'சகோடயாழ்' ஆகும். எனவே 'ஆ' பொருந்தாத தவறான இணையாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the mismatched pair among stringed instruments and their string counts:"}], "options": ["Periyazh - 21 strings", "Makarazh - 14 strings", "Sagodayazh - 14 strings", "Veena - 7 strings"], "explanation": "Makarazh has 19 strings, whereas Sagodayazh has 14 strings. Therefore, B is the mismatched pair."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 80, "chapter": null, "section": null, "reference": null, "url": null, "source_no