{"id": "8th-u4-q526", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "8th-u4-l4", "chapter_id": null, "topic_id": "kurippu-vinaiyeccam-tense-omission", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறிப்பு வினையெச்சமானது எதனை வெளிப்படையாகக் காட்டாது?"}], "options": ["வினையை", "காலத்தை", "பண்பினை", "பெயரை"], "explanation": "பாடநூல் பக்கம் 83 மதிப்பீட்டு வினா எண் 3: 'குறிப்பு வினையெச்சம் காலத்தை வெளிப்படையாகக் காட்டாது'. இது பண்பினை மட்டுமே குறிப்பாக உணர்த்தி நிற்கும் (எ.கா: மெல்ல வந்தான்)."}, "en": {"blocks": [{"type": "text", "content": "What does a Kurippu Vinaiyeccam NOT overtly manifest?"}], "options": ["Action/Verb", "Tense/Time (காலத்தை)", "Quality/Property", "Noun"], "explanation": "Textbook page 83 question 3: 'Kurippu Vinaiyeccam does not overtly manifest tense (காலத்தை)'. It merely indicates quality."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 83, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "ex