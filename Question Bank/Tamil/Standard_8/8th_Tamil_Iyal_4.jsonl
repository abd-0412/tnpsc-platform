{"id": "8th-u4-q491", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l3", "chapter_id": null, "topic_id": "instruments-alternative-names", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இசைக்கருவிகளையும் அவற்றின் மாற்று/இலக்கியப் பெயர்களையும் பொருத்துக:\nஅ) சாலரா - 1. பணிலம்\nஆ) சேகண்டி - 2. பாணி\nஇ) திமிலை - 3. பாண்டில்\nஈ) சங்கு - 4. சேமங்கலம்"}], "options": ["அ-1, ஆ-2, இ-3, ஈ-4", "அ-2, ஆ-4, இ-1, ஈ-3", "அ-3, ஆ-4, இ-2, ஈ-1", "அ-4, ஆ-3, இ-2, ஈ-1"], "explanation": "சாலரா = பாண்டில் (3); சேகண்டி = சேமங்கலம் (4); திமிலை = பாணி (2); சங்கு = பணிலம் (1). சரியான வரிசை: அ-3, ஆ-4, இ-2, ஈ-1."}, "en": {"blocks": [{"type": "text", "content": "Match the musical instruments with their alternate/literary names:\na) Salara - 1. Panilam\nb) Segandi - 2. Paani\nc) Thimilai - 3. Paandil\nd) Sangu (Conch) - 4. Semangalam"}], "options": ["a-1, b-2, c-3, d-4", "a-2, b-4, c-1, d-3", "a-3, b-4, c-2, d-1", "a-4, b-3, c-2, d-1"], "explanation": "Salara = Paandil (3); Segandi = Semangalam (4); Thimilai = Paani (2); Sangu = Panilam (1). Sequence: a-3, b-4, c-2, d-1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [{"left_ta": "சாலரா", "left_en": "Salara", "right_ta": "பாண்டில்", "right_en": "Paandil"}, {"left_ta": "சேகண்டி", "left_en": "Segandi", "right_ta": "சேமங்கலம்", "right_en": "Semangalam"}, {"left_ta": "திமிலை", "left_en": "Thimilai", "right_ta": "பாணி", "right_en": "Paani"}, {"left_ta": "சங்கு", "left_en": "Conch", "right_ta": "பணிலம்", "right_en": "Panilam"}], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value"