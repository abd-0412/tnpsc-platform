{"id": "8th-u4-q476", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l3", "chapter_id": null, "topic_id": "panchamahasabdam-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஐந்து முகங்களை உடைய முரசு வகையான குடமுழா எந்தச் சிறப்புப் பெயரால் அழைக்கப்படுகிறது?"}], "options": ["அஷ்டமகாசப்தம்", "திரிசப்தம்", "நாதஸ்வரம்", "பஞ்சமகாசப்தம்"], "explanation": "பாடநூல் பக்கம் 76-இன் படி, குடமுழாவின் ஐந்து முகங்களிலிருந்தும் ஐந்து தனித்தனி இசைகள் பிறப்பதால் இது 'பஞ்சமகாசப்தம்' என்று அழைக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "By what special name is the five-faced drum variety 'Kudamuzha' known?"}], "options": ["Ashtamahasabdam", "Thrisabdam", "Nadaswaram", "Panchamahasabdam"], "explanation": "According to page 76, Kudamuzha produces 5 distinct musical notes from its five mouths and is therefore called 'Panchamahasabdam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 76, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["kudamuzha", "panchamahasabdam", "direct"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

