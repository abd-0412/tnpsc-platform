{"id": "8th-u2-q224", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-09-vettukkiliyum-sarukumaanum", "chapter_id": null, "topic_id": "ta-8th-u2-direct-translator-name", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காடர்களின் கதைகளை 'யானையோடு பேசுதல்' என்னும் தலைப்பில் தமிழாக்கம் செய்தவர் யார்?"}], "options": {"A": "மனிஷ் சாண்டி", "B": "மாதுரி ரமேஷ்", "C": "கி. ராஜநாராயணன்", "D": "வ. கீதா"}, "explanation": "பாடநூல் பக்கம் 37 நூல் வெளி: 'மனிஷ் சாண்டி, மாதுரி ரமேஷ் ஆகியோர் காடர்களின் கதைகளைத் தொகுத்துள்ளனர்; அவற்றை யானையோடு பேசுதல் என்னும் தலைப்பில் வ. கீதா தமிழாக்கம் செய்துள்ளார்.'"}, "en": {"blocks": [{"type": "text", "content": "Who translated the folklore of Kadars into Tamil under the title 'Yaanaiyodu Pesuthal'?"}], "options": {"A": "Manish Chandi", "B": "Madhuri Ramesh", "C": "Ki. Rajanarayanan", "D": "V. Geetha (வ. கீதா)"}, "explanation": "Textbook page 37: V. Geetha translated the anthology into Tamil under the title 'Yaanaiyodu Pesuthal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 37, "chap