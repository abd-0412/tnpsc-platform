{"id": "8th-u2-q162", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-06-iyarkaiyai-pottruvom", "chapter_id": null, "topic_id": "ta-8th-u2-grammar-metrical-maathirai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகார மங்கல வாழ்த்துப் பாடலின் 'திங்களைப் போற்றுதும்' என்னும் முதலடியின் அசை மற்றும் மாத்திரை அமைப்பைக் கணக்கிடுக:\n• 'திங்' (நேர் = 1 மாத்திரை), 'க' (குறில் = 1 மாத்திரை), 'ளைப்' (நேர்/நெடில் ஒற்று = 2 மாத்திரை)\nஇச்சீரில் அமைந்த மொத்த மாத்திரைகளின் அளவு யாது?"}], "options": {"A": "3 மாத்திரைகள்", "B": "4 மாத்திரைகள்", "C": "5 மாத்திரைகள்", "D": "2 மாத்திரைகள்"}, "explanation": "திங் (தி - 1, ங் - 0.5 = குறில் ஒற்று 1 மாத்திரை அலகு); க (குறில் - 1 மாத்திரை); ளைப் (ளை - 2, ப் - 0.5 = 2 மாத்திரை அலகு). எழுத்து வாரியாக: தி (1) + ங் (0.5) + க (1) + ளை (2) + ப் (0.5) = சரியாக 5 மாத்திரைகள். பாடநூல் எளிய அசை மாத்திரை அளவின்படி: 1 + 1 + 2 = 4 மாத்திரைகள்."}, "en": {"blocks": [{"type": "text", "content": "Calculate the prosodic duration (Maathirai) of the metric unit 'Thingalai' (திங்களைப்) from Silappathikaaram's opening line:"}], "options": {"A": "3 Maathirais", "B": "4 Maathirais", "C": "5 Maathirais", "D": "2 Maathirais"}, "explanation": "Accredited meter metrics for the feet count to 4 prosodic time units."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 24, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["grammar", "metrics", "prosody"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
