// 8-ஆம் வகுப்பு தமிழ் - இயல் 2: ஈடில்லா இயற்கை (மொத்த வினாக்கள்: 140)
// ==============================================================================

// ==============================================================================
// பாடம் 1 & 2: இயற்கையைப் போற்றுவோம் & பட்டமரம் (கவிதைப்பேழை - இளங்கோவடிகள் & கவிஞர் தமிழ்ஒளி) [Q141 - Q168]
// சிலப்பதிகாரம் திங்கள்/ஞாயிறு/மாமழை போற்றுதும், சோழன் அத்திமாலை, திகிரி, அலர், மேரு, அங்கண், நாமநீர், கொங்கு; கவிஞர் தமிழ்ஒளி, பாரதியார் வழித்தோன்றல், பாரதிதாசன் மாணவர் (நிலைபெற்ற சிலை, வீராயி, கவிஞனின் காதல், மே-தினப் பூங்கா, தமிழரின் சமயம், சிலப்பதிகாரம் காவிய நாடகம், மாதவி காவியம்); மரங்களின் பெருமூச்சு, வெட்டப்படும் துயர், குந்த நிழல், கூரை விரித்த இலை, கிளை முறிந்த வேதனை, மாத்திரை, புணர்ச்சி
// ==============================================================================
{"id": "8th-u2-q141", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-06-iyarkaiyai-pottruvom", "chapter_id": null, "topic_id": "ta-8th-u2-silambu-mangala-vaazhthu-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரத்தின் தொடக்க மங்கல வாழ்த்துப் பாடல் உணர்த்தும் இயற்கை நயங்கள் பற்றிய கூற்றுகளை ஆராய்க:\n1. திங்கள், ஞாயிறு, மாமழை என இயற்கையை முதன்மையாக வாழ்த்தி இந்நூல் தொடங்குகிறது.\n2. சோழ மன்னனின் குளிர்வெண்குடை போன்று அருளை வழங்குவதால் நிலா போற்றப்படுகிறது.\n3. காவிரி நாடன் சோழனின் ஆணைச் சக்கரம் போல மேரு மலையை வலம் வருவதால் ஞாயிறு போற்றப்படுகிறது.\n4. அச்சம் தரும் கடலால் சூழப்பட்ட உலகிற்கு மன்னன் அருள் பொழிவது போலப் பொழிவதால் மாமழை போற்றப்படுகிறது.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2 மட்டுமே சரியானவை", "C": "கூற்றுகள் 2, 3, 4 மட்டுமே சரியானவை", "D": "கூற்றுகள் 1, 3, 4 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் பக்கம் 24: சிலப்பதிகாரப் பாடல் திங்கள், ஞாயிறு, மாமழை ஆகியவற்றைச் சோழனின் வெண்கொற்றக் குடை, திகிரி, அருள் ஆகியவற்றுடன் உவமித்துப் போற்றுகிறது. நான்கு கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements on the poetic extolling of nature in Silappathikaaram's invocation:\n1. The epic opens with blessings upon nature: Moon, Sun, and Rain.\n2. Moon is celebrated for bestowing grace like the Chola king's cool white umbrella.\n3. Sun is praised as it circumambulates Mount Meru like the royal discus of the Chola king.\n4. Rain is lauded because it pours abundantly just as the monarch showers grace on the sea-girt realm.\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 2 only are correct", "C": "Statements 2, 3, 4 only are correct", "D": "Statements 1, 3, 4 only are correct"}, "explanation": "Textbook page 24: All 4 statements accurately reflect Ilango Adigal's imagery comparing celestial and natural phenomena with royal Chola attributes."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "சிலப்பதிகார மங்கல வாழ்த்துப் பாடலில் திங்கள், ஞாயிறு, மாமழை என இயற்கை முதன்மையாகப் போற்றப்படுகிறது.", "content_en": "In the invocation of Silappathikaaram, nature is primarily extolled through Moon, Sun, and Rain."}, {"id": "S2", "content_ta": "சோழ மன்னனின் குளிர்ந்த வெண்கொற்றக் குடை போன்ற அருளை வழங்குவதால் வான்நிலா போற்றப்படுகிறது.", "content_en": "The Moon is praised as it bestows grace comparable to the Chola king's cool white parasol."}, {"id": "S3", "content_ta": "காவிரி நாடனாகிய சோழனின் ஆணைச் சக்கரத்தைப் போல இமயமலையை வலம் வருவதால் கதிரவன் போற்றப்படுகிறான்.", "content_en": "The Sun is praised because it circles Mount Meru just like the sovereign wheel of the Chola king."}, {"id": "S4", "content_ta": "அச்சம் தரும் கடலால் சூழப்பட்ட உலகிற்கு சோழன் கருணை பொழிவது போல முகில்வழியாகப் பொழிவதால் மாமழை போற்றப்படுகிறது.", "content_en": "Rain is praised as it showers from clouds over the sea-girt world just like the benevolence of the monarch."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 24, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["silappathikaaram", "ilango_adigal", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q142", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-06-iyarkaiyai-pottruvom", "chapter_id": null, "topic_id": "ta-8th-u2-ilango-adigal-bio-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இளங்கோவடிகள் மற்றும் சிலப்பதிகாரக் காப்பியம் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. சிலப்பதிகாரம் என்னும் பெருங்காப்பியத்தை இயற்றியவர் இளங்கோவடிகள்.\n2. இவர் சேர மன்னர் மரபைச் சேர்ந்தவர் எனச் சிலப்பதிகாரப் பதிகம் குறிப்பிடுகிறது.\n3. இளங்கோவடிகளின் காலம் பொ.ஆ.(கி.பி.) ஐந்தாம் நூற்றாண்டு ஆகும்.\n4. இது தமிழின் முதல் காப்பியம்; முத்தமிழ்க் காப்பியம், குடிமக்கள் காப்பியம் எனப் போற்றப்படுகிறது.\nஇவற்றுள் தவறான கூற்று எது?"}], "options": {"A": "கூற்று 2 தவறானது", "B": "கூற்று 3 தவறானது", "C": "கூற்று 1 தவறானது", "D": "கூற்று 4 தவறானது"}, "explanation": "பாடநூல் பக்கம் 25 நூல் வெளி: கூற்று 3 தவறானது. இளங்கோவடிகளின் காலம் 'பொ.ஆ.(கி.பி.) இரண்டாம் நூற்றாண்டு' ஆகும். ஐந்தாம் நூற்றாண்டு என்பது தவறான காலக் குறிப்பீடு."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements regarding Ilango Adigal and Silappathikaaram:\n1. Ilango Adigal authored the epic Silappathikaaram.\n2. The prologue (Pathigam) records him belonging to the royal Chera lineage.\n3. Ilango Adigal's era is the 5th century CE.\n4. It is the maiden Tamil epic, celebrated as Muthamizh Kaappiyam and Kudimakkal Kaappiyam.\nWhich statement is INCORRECT?"}], "options": {"A": "Statement 2 is incorrect", "B": "Statement 3 is incorrect", "C": "Statement 1 is incorrect", "D": "Statement 4 is incorrect"}, "explanation": "Textbook page 25: Statement 3 is incorrect because Ilango Adigal's accepted historical era is the 2nd century CE, not the 5th century."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "சிலப்பதிகாரம் என்னும் காப்பியத்தை இயற்றியவர் இளங்கோவடிகள் ஆவார்.", "content_en": "Silappathikaaram was authored by Ilango Adigal."}, {"id": "S2", "content_ta": "இவர் சேர மன்னர் மரபைச் சேர்ந்தவர் என்று சிலப்பதிகாரப் பதிகம் கூறுகிறது.", "content_en": "The pathigam of Silappathikaaram records that he belonged to the Chera dynasty."}, {"id": "S3", "content_ta": "இளங்கோவடிகளின் காலம் பொ.ஆ.(கி.பி.) ஐந்தாம் நூற்றாண்டு என்று வரலாற்று ஆய்வாளர்கள் முடிவு செய்துள்ளனர்.", "content_en": "Historical scholars have determined Ilango Adigal's era to be the 5th century CE."}, {"id": "S4", "content_ta": "சிலப்பதிகாரம் தமிழின் முதல் காப்பியம்; இது முத்தமிழ்க் காப்பியம், குடிமக்கள் காப்பியம் என்றும் போற்றப்படுகிறது.", "content_en": "Silappathikaaram is Tamil's first epic, hailed as Muthamizh Kaappiyam and Kudimakkal Kaappiyam."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 25, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["silappathikaaram", "ilango_adigal", "era"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q143", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-06-iyarkaiyai-pottruvom", "chapter_id": null, "topic_id": "ta-8th-u2-silambu-glossary-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகார மங்கல வாழ்த்துப் பாடலின் 'சொல்லும் பொருளும்' குறித்த கூற்றுகளை ஆராய்க:\n1. 'கொங்கு' - மகரந்தம்; 'அலர்' - மலர்தல்.\n2. 'சென்னி' - ஆத்திப்பூ மாலை அணிந்த சோழ மன்னன்.\n3. 'திகிரி' - ஆணைச் சக்கரம்; 'மேரு' - இமயமலை.\n4. 'நாம நீர்' - நறுமணமிக்க தாமரைத் தடாகம்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "1, 2 மட்டுமே சரியானவை", "B": "2, 3, 4 மட்டுமே சரியானவை", "C": "1, 2, 3 மட்டுமே சரியானவை; 4 தவறானது", "D": "1, 3, 4 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் பக்கம் 24: கூற்றுகள் 1, 2, 3 சரியானவை. கூற்று 4 தவறானது; 'நாம நீர்' என்பது 'அச்சம் தரும் கடல்' எனப் பொருள்படும் (நாமம் = அச்சம்)."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on word meanings in Silappathikaaram's invocation:\n1. 'Kongu' - Pollen; 'Alar' - Blossoming.\n2. 'Senni' - The Chola king wearing Aathi garland.\n3. 'Thigiri' - Discus of authority; 'Meru' - Mount Meru (Himalayas).\n4. 'Naama neer' - Fragrant lotus pond.\nWhich statements are correct?"}], "options": {"A": "1, 2 only are correct", "B": "2, 3, 4 only are correct", "C": "1, 2, 3 only are correct; 4 is incorrect", "D": "1, 3, 4 only are correct"}, "explanation": "Textbook page 24: Statements 1, 2, and 3 are correct. Statement 4 is incorrect because 'Naama neer' denotes the awe-inspiring, fearsome sea."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'திங்களைப் போற்றுதும்' பாடலில் 'கொங்கு' என்பது 'மகரந்தம்' என்றும், 'அலர்' என்பது 'மலர்தல்' என்றும் பொருள்படும்.", "content_en": "In 'Thingalai Pottrothum', 'Kongu' signifies pollen, and 'Alar' means blossoming."}, {"id": "S2", "content_ta": "'சென்னி' என்பது ஆத்தி மலர் மாலையை அணிந்த சோழ மன்னனைக் குறிக்கும் சொல்லாகும்.", "content_en": "'Senni' denotes the Chola monarch adorned with the Aathi blossom garland."}, {"id": "S3", "content_ta": "'திகிரி' என்பது சோழனின் ஆணைச் சக்கரத்தையும், 'மேரு' என்பது இமயமலையையும் குறிக்கின்றன.", "content_en": "'Thigiri' denotes the royal wheel of command, and 'Meru' signifies the golden peaks of the Himalayas."}, {"id": "S4", "content_ta": "'நாம நீர்' என்பது நறுமணம் கமழும் தாமரைத் தடாகத்தைக் குறிக்கும் சொல்லாகும்.", "content_en": "'Naama neer' signifies a sweet-scented lotus pool."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 24, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["silappathikaaram", "glossary", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q144", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-07-pattamaram", "chapter_id": null, "topic_id": "ta-8th-u2-tamizholi-bio-pattamaram-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் தமிழ்ஒளி மற்றும் 'பட்டமரம்' கவிதை பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. இவர் பாரதியாரின் கவிமரபு வழித்தோன்றலாகவும், பாரதிதாசனின் மாணவராகவும் விளங்கியவர்.\n2. நிலைபெற்ற சிலை, வீராயி, கவிஞனின் காதல், மாதவி காவியம் உள்ளிட்ட படைப்புகளை இயற்றினார்.\n3. 'பட்டமரம்' கவிதை 'தமிழ்ஒளியின் கவிதைகள்' என்னும் நூலில் இடம்பெற்றுள்ளது.\n4. பசுமை இழந்து 'கட்டை' என்னும் பெயருடன் நிற்கும் மரத்தின் துயரத்தை இக்கவிதை படம் பிடிக்கிறது.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "1, 2 மட்டுமே சரியானவை", "B": "2, 3, 4 மட்டுமே சரியானவை", "C": "1, 3, 4 மட்டுமே சரியானவை", "D": "1, 2, 3, 4 அனைத்தும் சரியானவை"}, "explanation": "பாடநூல் பக்கம் 28-29: தமிழ்ஒளியின் இலக்கியப் பின்னணி, பாரதிதாசன் மாணவர் நிலை, அவரது நூல்கள் மற்றும் பட்டமரம் பாடலின் உட்கருத்து குறித்த நான்கு கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements regarding poet Tamizholi and the poem 'Pattamaram':\n1. He was a successor of Bharati's poetic tradition and a disciple of Bharathidasan.\n2. He authored Nilaippetra Silai, Veerayi, Kavignanin Kaathal, and Maathavi Kaaviyam.\n3. 'Pattamaram' is included in 'Tamizholiyin Kavithaigal'.\n4. The verse poignantly delineates the sorrow of a withered tree turned into a log.\nWhich statements are correct?"}], "options": {"A": "1, 2 only are correct", "B": "2, 3, 4 only are correct", "C": "1, 3, 4 only are correct", "D": "All 1, 2, 3, 4 are correct"}, "explanation": "Textbook pages 28-29: All 4 statements accurately encapsulate Tamizholi's lineage, literary works, and the thematic core of Pattamaram."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "கவிஞர் தமிழ்ஒளி பாரதியாரின் கவிமரபு வழித்தோன்றலாகவும், பாரதிதாசனின் மாணவராகவும் விளங்கியவர்.", "content_en": "Poet Tamizholi was a stylistic descendant of Bharati and a direct student of Bharathidasan."}, {"id": "S2", "content_ta": "இவர் 'நிலைபெற்ற சிலை', 'வீராயி', 'கவிஞனின் காதல்', 'மாதவி காவியம்' ஆகிய சிறந்த காவியங்களையும் நூல்களையும் படைத்துள்ளார்.", "content_en": "He authored landmark works including Nilaippetra Silai, Veerayi, Kavignanin Kaathal, and Maathavi Kaaviyam."}, {"id": "S3", "content_ta": "பாடப்பகுதியில் இடம்பெற்றுள்ள 'பட்டமரம்' என்னும் கவிதை 'தமிழ்ஒளியின் கவிதைகள்' என்னும் தொகுப்பு நூலில் இடம் பெற்றுள்ளது.", "content_en": "The poem 'Pattamaram' is excerpted from the anthology titled 'Tamizholiyin Kavithaigal'."}, {"id": "S4", "content_ta": "பட்டுப்போன மரம் ஒன்று தன் அழகையும் பசுமையையும் இழந்து 'கட்டை' என்னும் பெயர் பெற்று நிற்கும் அவலத்தை இக்கவிதை விவரிக்கிறது.", "content_en": "The poem movingly portrays the tragedy of a withered tree reduced to mere deadwood."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 28, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tamizholi", "pattamaram", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q145", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-07-pattamaram", "chapter_id": null, "topic_id": "ta-8th-u2-pattamaram-glossary-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பட்டமரம்' பாடலில் இடம்பெற்றுள்ள அரிய சொற்களின் பொருள் குறித்த கூற்றுகளை ஆராய்க:\n1. 'குந்த' - உட்கார; 'கந்தம்' - மணம்.\n2. 'குமைந்தனை' - வருந்தினாய்; 'விசனம்' - கவலை.\n3. 'இற்று' - அழிந்து; 'மிசை' - மேல்.\n4. 'ஓலம்' - அலறல்; 'எழில்' - அழகு.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2 மட்டுமே சரியானவை", "C": "கூற்றுகள் 2, 3 மட்டுமே சரியானவை", "D": "கூற்றுகள் 1, 3, 4 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் பக்கம் 28 சொல்லும் பொருளும்: குந்த (உட்கார), கந்தம் (மணம்), குமைந்தனை (வருந்தினாய்), விசனம் (கவலை), இற்று (அழிந்து), மிசை (மேல்), ஓலம் (அலறல்), எழில் (அழகு) ஆகிய அனைத்துப் பொருள் விளக்கங்களும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on vocabulary definitions from 'Pattamaram':\n1. 'Kuntha' - To sit; 'Kantham' - Fragrance.\n2. 'Kumainthanai' - Grieved; 'Visanam' - Sorrow.\n3. 'Itru' - Perished; 'Misai' - Above.\n4. 'Olam' - Shrieking cry; 'Ezhil' - Beauty.\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 2 only are correct", "C": "Statements 2, 3 only are correct", "D": "Statements 1, 3, 4 only are correct"}, "explanation": "Textbook page 28 glossary: All definitions are precisely authenticated from the Tamil textbook."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'பட்டமரம்' பாடலில் 'குந்த' என்பது 'உட்கார' என்றும், 'கந்தம்' என்பது 'மணம்' என்றும் பொருள்படும்.", "content_en": "In 'Pattamaram', 'Kuntha' means to sit down, and 'Kantham' means fragrance."}, {"id": "S2", "content_ta": "'குமைந்தனை' என்பது 'வருந்தினாய்' என்றும், 'விசனம்' என்பது 'கவலை' என்றும் பாடநூலில் பொருள்படுகின்றன.", "content_en": "'Kumainthanai' means grieved, and 'Visanam' signifies sorrow/anxiety."}, {"id": "S3", "content_ta": "'இற்று' என்பது 'அழிந்து' என்றும், 'மிசை' என்பது 'மேல்' என்றும் பொருள்தரும் சொற்களாகும்.", "content_en": "'Itru' means ruined/perished, and 'Misai' signifies above/upon."}, {"id": "S4", "content_ta": "'ஓலம்' என்பது மரம் பட்டுப்போய் வெட்டப்படும்போது ஏற்படும் 'அலறல்' ஒலியைக் குறிக்கிறது.", "content_en": "'Olam' denotes the lamenting shriek when the tree is severed."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 28, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pattamaram", "glossary", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q146", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-07-pattamaram", "chapter_id": null, "topic_id": "ta-8th-u2-pattamaram-poem-inner-meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பட்டமரம்' கவிதையின் நயங்களும் கவிஞரின் உள்ளுணர்வும் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. பட்டை என்னும் ஆடையை உடுத்தியிருந்த மரம் தன் எழில் இழந்து நிற்பதாகக் கவிஞர் கூறுகிறார்.\n2. பறவைகள் தங்கிப் பாடியதும், மனிதர் நிழலில் இளைப்பாறியதும் இன்று ஏட்டில் எழுதிய பழங்கதையாயிற்று.\n3. மரம் யாருக்கும் நிழல் தராமல் ஆணவத்தோடு நின்றதால் தான் பட்டுப்போயிற்று என்று கவிஞர் பழிக்கிறார்.\n4. இலைகள் அற்ற கிளைகளுடன் நின்று நாள்தோறும் பெருமூச்சு விடும் மரத்தின் துயரம் விவரிக்கப்படுகிறது.\nஇவற்றுள் தவறான கூற்றைக் கண்டறிக:"}], "options": {"A": "கூற்று 2 தவறானது", "B": "கூற்று 3 தவறானது", "C": "கூற்று 1 தவறானது", "D": "கூற்று 4 தவறானது"}, "explanation": "பாடநூல் பக்கம் 28: கூற்று 3 முற்றிலும் தவறானது. மரம் அனைவருக்கும் குந்த நிழலும், கூரை போன்ற தழலும், நறுமணமும் தந்து உதவியது; ஆனால் இன்று பட்டுப்போய் பெருமூச்சு விடுகிறது என்றே கவிஞர் இரக்கத்தோடு பாடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Examine the inner literary sentiments in 'Pattamaram':\n1. The tree stood stripped of its bark garment, robbed of its natural splendor.\n2. Birds singing and people resting in its shade have now faded into written folktales.\n3. The poet reviles the tree, claiming it withered due to arrogance in denying shade.\n4. The tree sighs daily in grief, standing with barren branches devoid of foliage.\nIdentify the INCORRECT statement:"}], "options": {"A": "Statement 2 is incorrect", "B": "Statement 3 is incorrect", "C": "Statement 1 is incorrect", "D": "Statement 4 is incorrect"}, "explanation": "Textbook page 28: Statement 3 is false because the poet portrays the tree with deep pathos, recalling how generously it once offered cool shade and fragrance."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "மலர் போன்ற மெல்லிய தளிர்களை ஆடையாக உடுத்தியிருந்த மரம் தன் ஆடை கிழிந்து நின்றதாகக் கவிஞர் உருவகிக்கிறார்.", "content_en": "The poet portrays the tree as having worn tender leaves as garments, which are now torn away."}, {"id": "S2", "content_ta": "பறவைகள் வந்து பாட்டுப் பாடியதும், மாடுகள் நிழலில் ஒதுங்கியதும் இன்று பழங்கதையாக முடிந்துவிட்டன என்று வருந்துகிறார்.", "content_en": "Birds singing and oxen taking shelter have now become past folklore, laments the poet."}, {"id": "S3", "content_ta": "மரம் ஒருபோதும் மனிதனுக்கோ விலங்கிற்கோ நிழல் தராமல் ஆணவத்தோடு நின்றதால் பட்டுப்போயிற்று என்று கவிஞர் பழிக்கிறார்.", "content_en": "The poet accuses the tree of withering because it haughtily refused shade to living beings."}, {"id": "S4", "content_ta": "கிளைகளில் அமர்ந்து இளஞ்சிறார் ஆடிய ஊஞ்சலும் இன்று வெற்றுக்கனவாகிவிட்டது எனப் பாடல் விவரிக்கிறது.", "content_en": "Children swinging on branches has now vanished into a hollow daydream."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 28, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pattamaram", "literary_criticism", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q147", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-06-iyarkaiyai-pottruvom", "chapter_id": null, "topic_id": "ta-8th-u2-twin-epics-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரம் மற்றும் இரட்டைக் காப்பியங்கள் குறித்த பின்வரும் வரலாற்று இலக்கியக் கூற்றுகளை ஆராய்க:\n1. சிலப்பதிகாரமும் மணிமேகலையும் இரட்டைக் காப்பியங்கள் என அழைக்கப்படுகின்றன.\n2. சிலப்பதிகாரம் உரையிடையிட்ட பாட்டுடைச் செய்யுள் என்றும் அழைக்கப்படுகிறது.\n3. சேர, சோழ, பாண்டிய மன்னர்கள் மூவரையும் ஒருசேரப் பாடும் பெருமை சிலப்பதிகாரத்திற்கு உண்டு.\n4. மணிமேகலையை இயற்றிய சீத்தலைச் சாத்தனார் இளங்கோவடிகளின் உடன்பிறந்த தம்பியாவார்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "1, 2 மட்டுமே சரியானவை", "B": "2, 3, 4 மட்டுமே சரியானவை", "C": "1, 2, 3 மட்டுமே சரியானவை; 4 தவறானது", "D": "1, 3, 4 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் பக்கம் 25: கூற்றுகள் 1, 2, 3 சரியானவை. கூற்று 4 தவறானது; சீத்தலைச் சாத்தனார் இளங்கோவடிகளின் நண்பரே அன்றி உடன்பிறந்த தம்பி அல்ல. இளங்கோவடிகளே சேரன் செங்குட்டுவனின் தம்பியாவார்."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements on Silappathikaaram and the Twin Epics:\n1. Silappathikaaram and Manimekalai are heralded as the Twin Epics.\n2. Silappathikaaram is characterized by prose interludes (Uraiyidaiyitta Paattudai Seyyul).\n3. Silappathikaaram uniquely covers the triumvirate of Chera, Chola, and Pandya realms.\n4. Seethalai Saathanaar, who authored Manimekalai, was the biological brother of Ilango Adigal.\nWhich statements are correct?"}], "options": {"A": "1, 2 only are correct", "B": "2, 3, 4 only are correct", "C": "1, 2, 3 only are correct; 4 is incorrect", "D": "1, 3, 4 only are correct"}, "explanation": "Textbook page 25: Statements 1, 2, and 3 are correct. Statement 4 is false because Saathanaar was a friend and literary peer, not his biological brother."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "சிலப்பதிகாரமும் மணிமேகலையும் தமிழில் 'இரட்டைக் காப்பியங்கள்' என்று போற்றப்படுகின்றன.", "content_en": "Silappathikaaram and Manimekalai are celebrated as Twin Epics (Irattai Kaappiyangal)."}, {"id": "S2", "content_ta": "இரண்டு காப்பியங்களும் கதைத் தொடர்பினாலும் சமகாலப் புலவர்களாலும் நெருங்கிய தொடர்பு கொண்டவை.", "content_en": "Both epics share narrative continuity and were composed by contemporary literary masters."}, {"id": "S3", "content_ta": "சிலப்பதிகாரம் சோழ, பாண்டிய, சேர ஆகிய மூன்று தமிழ் வேந்தர்களின் நாடுகளையும் பாடும் முத்தமிழ்க் காப்பியமாகும்.", "content_en": "Silappathikaaram is an all-embracing epic singing of the Chola, Pandya, and Chera kingdoms."}, {"id": "S4", "content_ta": "மணிமேகலை காப்பியத்தை இயற்றியவர் இளங்கோவடிகளின் உடன்பிறந்த தம்பியான சீத்தலைச் சாத்தனார் ஆவார்.", "content_en": "Manimekalai was composed by Seethalai Saathanaar, the younger brother of Ilango Adigal."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 25, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["twin_epics", "silappathikaaram", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q148", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-06-iyarkaiyai-pottruvom", "chapter_id": null, "topic_id": "ta-8th-u2-ar-silambu-invocation-sozhan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): இளங்கோவடிகள் தன் காப்பியத் தொடக்கத்தில் பாண்டிய மன்னனின் வேப்பம்பூ மாலையையே முதலில் வைத்துப் பாடுகிறார்.\nகாரணம் (R): சிலப்பதிகாரத்தின் முழு காப்பிய நிகழ்வும் மதுரை மாநகரிலேயே தொடங்கி அங்கேயே நிறைவடைகிறது.\nசரியான விடையைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) சரி, காரணம் (R) சரி", "B": "கூற்று (A) சரி, காரணம் (R) தவறு", "C": "கூற்று (A) தவறு, காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று, காரணம் இரண்டும் தவறு. மங்கல வாழ்த்துப் பாடலில் ஆத்தி மலர் மாலையை அணிந்த 'சோழ மன்னனின்' அருளையே (திங்கள், ஞாயிறு, மாமழை ஆகியவற்றோடு) இளங்கோவடிகள் முன்னிறுத்துகிறார். சிலப்பதிகாரம் சோழ நாட்டின் பூம்புகாரில் தொடங்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Ilango Adigal opens his epic by singing praises first of the Pandya king's neem garland.\nReason (R): The entire narrative of Silappathikaaram initiates and concludes solely in Madurai.\nChoose the correct option:"}], "options": {"A": "Both (A) and (R) are true", "B": "(A) is true, but (R) is false", "C": "(A) is false, but (R) is true", "D": "Both (A) and (R) are false"}, "explanation": "Both assertion and reason are false. Ilango Adigal invokes the Chola king ('Senni' / 'Kaviri Naadan') in the invocation, and the epic originates in Poompuhar."}}, "question_data": {"assertion": "இளங்கோவடிகள் தன் காப்பியத் தொடக்கத்தில் பாண்டிய மன்னனின் வேப்பம்பூ மாலையையே முதலாவதாகப் பாடிப் போற்றுகிறார்.", "reason": "சிலப்பதிகாரத்தின் முழுக் கதையும் மதுரை மாநகரில் மட்டுமே தொடங்கி அங்கேயே நிறைவடைவது இதற்குக் காரணமாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 24, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["silappathikaaram", "assertion_reason", "chola_king"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q149", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-06-iyarkaiyai-pottruvom", "chapter_id": null, "topic_id": "ta-8th-u2-ar-kudimakkal-kaappiyam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): சிலப்பதிகாரம் 'குடிமக்கள் காப்பியம்' என்று சிறப்பித்துப் போற்றப்படுகிறது.\nகாரணம் (R): முடிமன்னர்களையோ கடவுளையோ முதன்மைப்படுத்தாமல், எளிய குடிமக்களான கோவலன் - கண்ணகியைத் தலைவர்களாகக் கொண்டு படைக்கப்பட்டதால் இப்பெயர் பெற்றது.\nசரியான விடையைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; கூற்றிற்குக் காரணம் சரியான விளக்கம்", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் சரியான விளக்கமன்று", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி"}, "explanation": "பாடநூல் பக்கம் 25: மன்னர்களை மட்டுமே காப்பியத் தலைவர்களாகப் பாடிய மரபை மாற்றி, எளிய வணிகக் குடும்பத்துக் குடிமக்களான கோவலன், கண்ணகியைத் தலைவர்களாகக் கொண்டு உருவானதால் சிலப்பதிகாரம் 'குடிமக்கள் காப்பியம்' எனப்படுகிறது. கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Silappathikaaram is celebrated as 'Kudimakkal Kaappiyam' (Commoners' Epic).\nReason (R): It departed from tradition by casting common citizens Kovalan and Kannagi as protagonists rather than monarchs or divinities.\nChoose the correct option:"}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation of (A)", "B": "Both (A) and (R) are true, but (R) is not the correct explanation of (A)", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Textbook page 25: Both statements are true and R precisely explains why Silappathikaaram earned the title 'Kudimakkal Kaappiyam'."}}, "question_data": {"assertion": "சிலப்பதிகாரம் 'குடிமக்கள் காப்பியம்' என்று தமிழ் அறிஞர்களால் ஒருமனதாகப் போற்றப்படுகிறது.", "reason": "அரசனையோ அல்லது தெய்வத்தையோ பாட்டுடைத் தலைவனாகக் கொள்ளாமல், சாதாரண வணிகக் குடிமக்களாகிய கோவலனையும் கண்ணகியையும் காப்பியத் தலைவர்களாகக் கொண்டு பாடப்பட்டதே இதற்குக் காரணமாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 25, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["kudimakkal_kaappiyam", "assertion_reason", "silambu"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q150", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-07-pattamaram", "chapter_id": null, "topic_id": "ta-8th-u2-ar-tamizholi-maathavi-kaaviyam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): கவிஞர் தமிழ்ஒளி பாரதிதாசனின் மாணவராக விளங்கித் தம் இலக்கியப் பணிகளை ஆற்றியவர்.\nகாரணம் (R): 'மாதவி காவியம்' என்னும் காப்பிய நூலை இயற்றியவர் கவிமணி தேசிக விநாயகம் பிள்ளை ஆவார்.\nசரியான விடையைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; சரியான விளக்கம்", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று (A) சரி; தமிழ்ஒளி பாரதிதாசனின் மாணவர். காரணம் (R) தவறு; 'மாதவி காவியம்' என்னும் நூலை இயற்றியவரும் கவிஞர் தமிழ்ஒளியே ஆவார், கவிமணி அல்ல."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Poet Tamizholi flourished as a direct disciple of Bharathidasan, shaping modern verse.\nReason (R): 'Maathavi Kaaviyam' was authored by Kavimani Desigavinayagam Pillai.\nChoose the correct option:"}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation", "B": "(A) is true, but (R) is false", "C": "(A) is false, but (R) is true", "D": "Both (A) and (R) are false"}, "explanation": "Assertion (A) is true. Reason (R) is false because 'Maathavi Kaaviyam' was authored by Tamizholi himself, not Kavimani."}}, "question_data": {"assertion": "கவிஞர் தமிழ்ஒளி பாரதிதாசனின் நேரடி மாணவராக விளங்கிப் புரட்சிகரக் கவிதைகளைப் படைத்தவர்.", "reason": "'மாதவி காவியம்' என்னும் நூலை இயற்றியவர் கவிமணி தேசிக விநாயகம் பிள்ளை ஆவார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 29, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tamizholi", "maathavi_kaaviyam", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q151", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-07-pattamaram", "chapter_id": null, "topic_id": "ta-8th-u2-ar-pattamaram-withering", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'பட்டமரம்' பாடலில் மரம் தன் கிளைகளில் பசுமையான இலைகளைக் குலுக்கி ஆடி மகிழ்வதாகக் கவிஞர் பாடுகிறார்.\nகாரணம் (R): மரம் பட்டுப்போய் இலைகளை இழந்து, நின்ற இடத்திலேயே நாள்தோறும் பெருமூச்சு விட்டு மடிகிறது.\nசரியான விடையைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று (A) தவறு; பட்டமரம் இலைகளை இழந்து மொட்டையாக நிற்கிறது. காரணம் (R) சரி; இலைகளற்ற கிளைகளோடு நின்று நாள்தோறும் பெருமூச்சு விடும் மரத்தின் துயரமே பாடலின் மையக்கருத்து."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): In 'Pattamaram', the poet sings that the tree sways joyfully rustling green foliage on its boughs.\nReason (R): Stripped of foliage due to withering, the tree breathes deep sighs of sorrow in its place of death.\nChoose the correct option:"}], "options": {"A": "Both (A) and (R) are true", "B": "(A) is true, but (R) is false", "C": "(A) is false, but (R) is true", "D": "Both (A) and (R) are false"}, "explanation": "(A) is false because the tree has lost all green leaves. (R) is true as the barren branches sigh daily in agony."}}, "question_data": {"assertion": "'பட்டமரம்' பாடலில் மரம் பட்டுப்போன நிலையிலும் தன் கிளைகளில் பச்சை இலைகளைக் குலுக்கி ஆடுவதாகக் கவிஞர் பாடுகிறார்.", "reason": "மரம் பட்டுப்போய்விட்டதால் இலைகளை இழந்து, நின்ற இடத்திலேயே நாள்தோறும் பெருமூச்சு விட்டு அழிகிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 28, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pattamaram", "assertion_reason", "poetic_imagery"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q152", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-06-iyarkaiyai-pottruvom", "chapter_id": null, "topic_id": "ta-8th-u2-ar-jainism-nature-worship", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): இளங்கோவடிகள் ஒரு சமண முனிவர் என்பதால் காப்பியத்தில் இயற்கையை எங்குமே பாடவில்லை.\nகாரணம் (R): சமணக் கோட்பாட்டின்படி இயற்கை கூறுகளைப் போற்றுதல் மத விதிகளுக்கு எதிரானது.\nசரியான விடையைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) சரி, காரணம் (R) சரி", "B": "கூற்று (A) சரி, காரணம் (R) தவறு", "C": "கூற்று (A) தவறு, காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று, காரணம் இரண்டும் முற்றிலும் தவறு. இளங்கோவடிகள் தன் காப்பியத்தின் முதலிலேயே 'திங்களைப் போற்றுதும், ஞாயிறு போற்றுதும், மாமழை போற்றுதும்' என்று இயற்கையைத் தலைவணங்கிப் போற்றியே தொடங்குகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Because Ilango Adigal was a Jain ascetic, he nowhere extolled nature in his epic.\nReason (R): Extolling natural elements is strictly prohibited by religious canons of Jainism.\nChoose the correct option:"}], "options": {"A": "Both (A) and (R) are true", "B": "(A) is true, but (R) is false", "C": "(A) is false, but (R) is true", "D": "Both (A) and (R) are false"}, "explanation": "Both assertion and reason are false. Ilango Adigal explicitly opens the epic by worshiping the Moon, the Sun, and the Rains."}}, "question_data": {"assertion": "சிலப்பதிகாரத்தை இயற்றிய இளங்கோவடிகள் ஒரு சமண முனிவர் என்பதால், தன் காப்பியத்தில் இயற்கையை எங்கும் போற்றவே இல்லை.", "reason": "சமண சமயக் கோட்பாடுகளில் இயற்கையை வணங்குவதும் போற்றுவதும் முற்றாகத் தடை செய்யப்பட்டுள்ளது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 24, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["silappathikaaram", "assertion_reason", "nature_praise"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q153", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-07-pattamaram", "chapter_id": null, "topic_id": "ta-8th-u2-ar-kattai-identity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): மரம் பட்டுப்போய் நிற்பதை 'கட்டை என்னும் பெயர் உற்று கொடுந்துயர் எய்தி' என்று தமிழ்ஒளி பாடுகிறார்.\nகாரணம் (R): நிழலும் மலர்மணமும் தந்த மரம், வளம் இழந்து வெறும் மரக்கட்டையாகக் கருதப்படும் இழிநிலையே இத்துயரிற்குக் காரணமாகும்.\nசரியான விடையைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; கூற்றிற்குக் காரணம் சரியான விளக்கம்", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் சரியான விளக்கமன்று", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி"}, "explanation": "பாடநூல் பக்கம் 28: பட்டுப்போன மரம் 'கட்டை' என்னும் இழிபெயர் பெற்று துயருறுவதை உணர்ந்து கவிஞர் பாடுகிறார். கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Tamizholi mourns the dead tree as having suffered the indignity of being labeled mere 'Kattai' (log).\nReason (R): The tragic descent of a once fragrant, shade-giving living tree into lifeless deadwood causes this sorrow.\nChoose the correct option:"}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation of (A)", "B": "Both (A) and (R) are true, but (R) is not the correct explanation of (A)", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Textbook page 28: Both assertion and reason are true, explaining the semantic and existential degradation of the withered tree into wood."}}, "question_data": {"assertion": "பட்டுப்போன மரம் கொடுந்துயருடன் நிற்பதைக் கண்ட கவிஞர் தமிழ்ஒளி 'கட்டை என்னும் பெயர் உற்று கொடுந்துயர் எய்தி' என்று நெகிழ்ந்து பாடுகிறார்.", "reason": "ஒரு காலத்தில் உயிர்ப்புடன் திகழ்ந்து நிழலும் மணமும் தந்த பெரும் மரம், இன்று தன் மதிப்பையும் அழகையும் இழந்து வெறும் மரக்கட்டையாக நிற்கும் அவலநிலையே இத்துயரிற்குக் காரணமாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 28, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pattamaram", "assertion_reason", "poetic_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q154", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-06-iyarkaiyai-pottruvom", "chapter_id": null, "topic_id": "ta-8th-u2-match-silambu-metaphors", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகார மங்கல வாழ்த்துப் பாடலில் சுட்டப்படும் இயற்கை கூறுகளையும் உவமைகளையும் பொருத்துக:\nபட்டியல் I\n1. திங்கள்\n2. ஞாயிறு\n3. மாமழை\n4. சென்னி\n\nபட்டியல் II\na) மன்னன் அருள் போல உலகிற்குப் பொழிவது\nb) ஆத்திப்பூ மாலை சூடிய சோழன்\nc) சோழனின் வெண்குடை போன்ற குளிர்ச்சி\nd) ஆணைச் சக்கரம் போல மேருவை வலம் வருவது"}], "options": {"A": "1-d, 2-c, 3-b, 4-a", "B": "1-c, 2-d, 3-a, 4-b", "C": "1-c, 2-a, 3-d, 4-b", "D": "1-b, 2-d, 3-a, 4-c"}, "explanation": "பாடநூல் பக்கம் 24: திங்கள் = வெண்குடை குளிர்ச்சி (c); ஞாயிறு = ஆணைச்சக்கரம் போல் வலம் வருதல் (d); மாமழை = மன்னன் அருள் போல் பொழிதல் (a); சென்னி = ஆத்தி மாலை சோழன் (b). சரியான பொருத்தம்: 1-c, 2-d, 3-a, 4-b."}, "en": {"blocks": [{"type": "text", "content": "Match the natural elements with their royal metaphors in Silappathikaaram:\nList I\n1. Moon\n2. Sun\n3. Rain\n4. Senni\n\nList II\na) Pouring like monarch's grace\nb) Chola wearing Aathi garland\nc) Coolness like royal parasol\nd) Orbiting Meru like royal wheel"}], "options": {"A": "1-d, 2-c, 3-b, 4-a", "B": "1-c, 2-d, 3-a, 4-b", "C": "1-c, 2-a, 3-d, 4-b", "D": "1-b, 2-d, 3-a, 4-c"}, "explanation": "Textbook page 24: Moon->c, Sun->d, Rain->a, Senni->b. Key B."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "திங்கள்", "content_en": "Moon"}, {"id": "L2", "content_ta": "ஞாயிறு", "content_en": "Sun"}, {"id": "L3", "content_ta": "மாமழை", "content_en": "Rain"}, {"id": "L4", "content_ta": "சென்னி", "content_en": "Senni"}], "right": [{"id": 