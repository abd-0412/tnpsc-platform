{"id": "8th-u2-q250", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-10-mayangoligal", "chapter_id": null, "topic_id": "ta-8th-u2-odd-articulation-mismatch", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாவின் முயற்சியால் பிறக்கும் இடங்களின் அடிப்படையில் கீழ்க்கண்ட இணைகளில் பொருந்தாத தவறான ஒன்றைக் கண்டறிக:"}], "options": {"A": "ணகரம் - நாவின் நுனி மேல்வாய் அண்ணத்தின் நடுப்பகுதியைத் தொடுதல்", "B": "னகரம் - நாவின் நுனி மேல்வாய்ப் பல்லின் அடிப்பகுதியைத் தொடுதல்", "C": "நகரம் - நாவின் நுனி மேல்வாய்ப் பல்லின் அடிப்பகுதியைத் தொடுதல்", "D": "ழகரம் - நாவின் நுனி மேல்நோக்கி வளைந்து அண்ணத்தை வருடுதல்"}, "explanation": "பாடநூல் பக்கம் 38: நாவின் நுனி மேல்வாய் அண்ணத்தின் முன்பகுதியைத் தொடுவதால் 'ன'கரம் பிறக்கிறது. மேல்வாய்ப் பல்லின் அடிப்பகுதியைத் தொடுவதால் 'ந'கரம் பிறக்கிறது. எனவே B பொருந்தாத தவறான பொருத்தமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the incorrectly paired articulation movement from the options below:"}], "options": {"A": "ணகரம் - Tongue tip touches middle of the palate", "B": "னகரம் - Tongue tip touches base of upper teeth", "C": "நகரம் - Tongue tip touches base of upper teeth", "D": "ழகரம் - Tongue tip curls upward and grazes palate"}, "explanation": "Textbook page 38: Alveolar ன is produced by touching the front palate, not the base of upper teeth (which produces dental ந). Option B is mismatched."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 38, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["odd_one_out", "articulation_mismatch", "phonetics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q251", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-10-mayangoligal", "chapter_id": null, "topic_id": "ta-8th-u2-direct-sirappu-zhagaram-sound", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாவின் நுனி மேல்நோக்கி வளைந்து வருடுவதால் தோன்றுவதும், தமிழுக்கே உரிய தனிச்சிறப்பு வாய்ந்ததுமான மயங்கொலி எழுத்து எது?"}], "options": {"A": "லகரம் (ல)", "B": "ளகரம் (ள)", "C": "ழகரம் (ழ)", "D": "றகரம் (ற)"}, "explanation": "பாடநூல் பக்கம் 39: நாவின் நுனி மேல்நோக்கி வளைந்து வருடுவதால் ழகரம் தோன்றுகிறது. ழ தமிழுக்கு உரித்தான சிறப்பு ஒலி என்பதால் 'சிறப்பு ழகரம்' எனப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which Mayangoli letter is formed by curling the tongue tip backwards to graze the palate and is uniquely celebrated in Tamil?"}], "options": {"A": "லகரம் (ல)", "B": "ளகரம் (ள)", "C": "ழகரம் (ழ)", "D": "றகரம் (ற)"}, "explanation": "Textbook page 39: ழகரம் is produced by curling the tongue tip upwards to graze the palate, unique to Tamil as 'Sirappu Zhagaram'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition