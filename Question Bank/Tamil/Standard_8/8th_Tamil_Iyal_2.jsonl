{"id": "8th-u2-q275", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-11-thirukkural", "chapter_id": null, "topic_id": "ta-8th-u2-grammar-koodaamai-ilakkana-kurippu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கோடாமை' என்னும் சொல்லின் இலக்கணக் குறிப்பைக் கண்டறிக:"}], "options": {"A": "வினையெச்சம்", "B": "ஈறுகெட்ட எதிர்மறைப் பெயரெச்சம்", "C": "எதிர்மறைத் தொழிற்பெயர்", "D": "பண்புத்தொகை"}, "explanation": "பாடநூல் பக்கம் 43: 'அமைந்துஒருபால் கோடாமை சான்றோர்க்கு அணி' என்பதில் 'கோடாமை' என்பது ஒருபக்கம் சாயாதிருத்தலைக் குறிக்கும். 'மை' விகுதி பெற்று எதிர்மறைப் பொருளில் தொழிற்பெயராக வருவதால் இது 'எதிர்மறைத் தொழிற்பெயர்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the grammatical classification (Ilakkana Kurippu) of 'Kodaamai':"}], "options": {"A": "Adverbial participle (Vinaiyechcham)", "B": "Eeruketta Ethirmarai Peyarechcham", "C": "Negative verbal noun (Ethirmarai Thozhirpeyar)", "D": "Qualitative compound (Panpuththogai)"}, "explanation": "Textbook page 43: 'கோடாமை' denotes non-swaying / impartiality. Bearing the suffix 'மை' and indicating negative action, it functions as a negative verbal noun (Ethirmarai Thozhirpeyar)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "bo