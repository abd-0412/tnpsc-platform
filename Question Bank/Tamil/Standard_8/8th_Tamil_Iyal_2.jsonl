// பாடம் 4: வெட்டுக்கிளியும் சருகுமானும் (விரிவானம் / துணைப்பாடம் - பழங்குடியினர் கதை / மனிஷ் சாண்டி, மாதுரி ரமேஷ், வ. கீதா) [Q197 - Q224]
// காடர் பழங்குடியினர் வாழ்வியல், பரம்பிக்குளம் மற்றும் ஆனைமலைப் பகுதிகள், 'ஆல்-அலப்பு' பேச்சு மொழி (எழுத்து வடிவம் அற்றது), காடுகள் மற்றும் விலங்குகள் பற்றிய வாய்மொழி மரபுக் கதைகள், மனிஷ் சாண்டி & மாதுரி ரமேஷ் தொகுப்பு, வ. கீதா தமிழாக்கம் ('யானையோடு பேசுதல்' நூல்); கூரன் சருகுமான், பித்தன் சிறுத்தை, பச்சை வெட்டுக்கிளி (வாயாடி), மரபுத் தொடர்கள், விலங்குப் பண்புகள்
// ==============================================================================
{"id": "8th-u2-q197", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-09-vettukkiliyum-sarukumaanum", "chapter_id": null, "topic_id": "ta-8th-u2-kadar-anthropology-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காடர் பழங்குடியினரின் வாழ்வியல் மற்றும் 'வெட்டுக்கிளியும் சருகுமானும்' கதைப் பின்னணி குறித்த கூற்றுகளை ஆராய்க:\n1. காடர்கள் பரம்பிக்குளம், ஆனைமலைப் பகுதிகளில் வாழும் பழங்குடியினர் ஆவர்.\n2. காடுகள், விலங்குகள் பற்றிய கதைகளை வாய்மொழியாகவே தலைமுறை தலைமுறையாகக் கூறிவந்தனர்.\n3. காடர்கள் பேசும் பேச்சு மொழி 'ஆல்-அலப்பு' எனப்படுகிறது; இதற்கு எழுத்து வடிவம் இல்லை.\n4. இக்கதைகளை மனிஷ் சாண்டி, மாதுரி ரமேஷ் தொகுக்க, 'யானையோடு பேசுதல்' என வ. கீதா தமிழாக்கம் செய்தார்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2 மட்டுமே சரியானவை", "C": "கூற்றுகள் 2, 3, 4 மட்டுமே சரியானவை", "D": "கூற்றுகள் 1, 3, 4 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் பக்கம் 35-37: காடர்கள் வாழும் இடம் (பரம்பிக்குளம், ஆனைமலை), பேச்சு மொழி (ஆல்-அலப்பு, எழுத்தில்லாதது), தொகுத்தவர்கள் (மனிஷ் சாண்டி, மாதுரி ரமேஷ்), நூல் (யானையோடு பேசுதல்), மொழிபெயர்த்தவர் (வ. கீதா) குறித்த நான்கு கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements on Kadar tribal anthropology and the source background of the story:\n1. Kadars inhabit the Parambikulam and Anaimalai hill regions.\n2. They transmitted folklore regarding forests and animals purely by word of mouth.\n3. Their spoken dialect is 'Aal-Alappu', which possesses no written script.\n4. Compiled by Manish Chandi and Madhuri Ramesh, the Tamil rendition by V. Geetha is 'Yaanaiyodu Pesuthal'.\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 2 only are correct", "C": "Statements 2, 3, 4 only are correct", "D": "Statements 1, 3, 4 only are correct"}, "explanation": "Textbook pages 35-37: All 4 statements accurately detail Kadar ethnography, oral traditions, and publication history."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "தமிழ்நாடு, கேரளா மாநிலங்களின் எல்லைக்கு அருகிலுள்ள பரம்பிக்குளம், ஆனைமலைப் பகுதிகளில் 'காடர்கள்' என்னும் பழங்குடியினர் வாழ்கின்றனர்.", "content_en": "The Kadar tribals inhabit the Parambikulam and Anaimalai border regions between Tamil Nadu and Kerala."}, {"id": "S2", "content_ta": "காடர்கள் காடுகள், செடிகொடிகள், விலங்குகள் தொடர்பான மரபுவழிக் கதைகளைத் தம் தலைமுறையினருக்கு வாய்மொழியாகக் கூறிவந்தனர்.", "content_en": "Kadars preserved traditional lore concerning forests, vegetation, and fauna through oral storytelling."}, {"id": "S3", "content_ta": "காடர்கள் பேசும் மொழி 'ஆல்-அலப்பு' என்று அழைக்கப்படுகிறது; இம்மொழிக்குத் தனியே எழுத்து வடிவம் கிடையாது.", "content_en": "The spoken dialect of Kadars is called 'Aal-Alappu', which lacks an independent written script."}, {"id": "S4", "content_ta": "இக்கதைகளை மனிஷ் சாண்டி, மாதுரி ரமேஷ் ஆகியோர் தொகுக்க, 'யானையோடு பேசுதல்' என்னும் தலைப்பில் வ. கீதா தமிழாக்கம் செய்துள்ளார்.", "content_en": "These tales were anthologized by Manish Chandi and Madhuri Ramesh, and translated into Tamil by V. Geetha as 'Yaanaiyodu Pesuthal'."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["kadars", "ethnography", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q198", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-09-vettukkiliyum-sarukumaanum", "chapter_id": null, "topic_id": "ta-8th-u2-characters-identification-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "துணைப்பாடக் கதையில் வரும் விலங்கு மாந்தர்கள் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'கூரன்' என்பது காட்டில் திரியும் பெரிய காட்டு யானையைக் குறிக்கும்.\n2. 'கூரன்' என்பது ஒரு பெரிய வீட்டுப் பூனை அளவே இருக்கும் கூச்சப்படும் பெண் சருகுமான்.\n3. 'பித்தக்கண்ணு' என்பது பெரிய மஞ்சள் கண்களையுடைய சிறுத்தை வேட்டை விலங்காகும்.\n4. பச்சை வெட்டுக்கிளி குறிஞ்சிப் புதரின் நீலப்பூ இதழ்களுக்கு இடையே வசித்து வந்தது.\nஇவற்றுள் தவறான கூற்றைக் கண்டறிக:"}], "options": {"A": "கூற்று 2 தவறானது", "B": "கூற்று 1 தவறானது", "C": "கூற்று 3 தவறானது", "D": "கூற்று 4 தவறானது"}, "explanation": "பாடநூல் பக்கம் 35: கூற்று 1 தவறானது. 'கூரன்' என்பது யானை அல்ல; அது ஒரு பெண் சருகுமான் (Mouse deer) ஆகும். கூச்சப்படும் சிறிய பிராணி."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements regarding animal characters in the folklore narrative:\n1. 'Kooran' denotes a gigantic wild elephant roaming the jungle.\n2. 'Kooran' is a timid female mouse deer roughly the size of a domestic cat.\n3. 'Piththakkannu' is a predatory leopard sporting large yellow eyes.\n4. The green grasshopper dwelt amidst blue flower petals in the Kurinji thicket.\nIdentify the INCORRECT statement:"}], "options": {"A": "Statement 2 is incorrect", "B": "Statement 1 is incorrect", "C": "Statement 3 is incorrect", "D": "Statement 4 is incorrect"}, "explanation": "Textbook page 35: Statement 1 is false because Kooran is a female mouse deer, not an elephant."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "கதையில் வரும் 'கூரன்' என்பது ஒரு பெரிய காட்டு யானையைக் குறிக்கும் பெயராகும்.", "content_en": "'Kooran' in the tale is the name of a massive wild elephant."}, {"id": "S2", "content_ta": "'கூரன்' என்பது ஒரு பெண் சருகுமான்; இது ஒரு பெரிய வீட்டுப் பூனையின் அளவில் இருக்கும் சிறிய பிராணியாகும்.", "content_en": "'Kooran' is a female mouse deer (Chevrotain); a tiny creature about the size of a domestic cat."}, {"id": "S3", "content_ta": "'பித்தக்கண்ணு' என்பது பெரிய மஞ்சள் கண்களைக் கொண்ட கொடிய சிறுத்தையாகும்; இது மிகச்சிறந்த வேட்டை விலங்கு.", "content_en": "'Piththakkannu' is a fearsome leopard with big yellow eyes; an exceptional predator."}, {"id": "S4", "content_ta": "பச்சை வெட்டுக்கிளி குறிஞ்சிப் புதரின் தாழப் படர்ந்த கிளையில் நீலப்பூவின் இதழ்களுக்கிடையே வசித்து வந்தது.", "content_en": "The green grasshopper lived among petals of a blue flower on a low branch of the Kurinji bush."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["characters", "folktale", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q199", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-09-vettukkiliyum-sarukumaanum", "chapter_id": null, "topic_id": "ta-8th-u2-story-events-betrayal-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கதையின் முக்கிய நிகழ்வுகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. பச்சை வெட்டுக்கிளி எப்போதும் பேசிக்கொண்டே இருக்கும் வாயாடிப் பிராணியாகும்.\n2. கூரன் விழுந்து கிடந்த மரத்தடியில் ஒளிந்து, வெட்டுக்கிளியிடம் அமைதியாக இருக்கும்படி எச்சரித்தது.\n3. வெட்டுக்கிளி தன் வாயைத் திறந்து பித்தக்கண்ணுவிடம் உண்மையை நேரடியாக உரைத்துவிட்டது.\n4. வெட்டுக்கிளி வாயைத் திறக்காவிட்டாலும், பரவசத்தில் கூரன் ஒளிந்திருந்த திசையில் குதித்துக் காட்டியது.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "1, 2 மட்டுமே சரியானவை", "B": "2, 3 மட்டுமே சரியானவை", "C": "1, 2, 4 மட்டுமே சரியானவை; 3 தவறானது", "D": "1, 3, 4 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் பக்கம் 36: கூற்றுகள் 1, 2, 4 சரியானவை. கூற்று 3 தவறானது; வாக்குறுதி நினைவுக்கு வந்ததால் வெட்டுக்கிளி வாயைத் திறக்கவில்லை; மாறாகத் தன் உடலால் குதித்துக் காட்டியே காட்டிக் கொடுத்தது."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements detailing plot developments in the narrative:\n1. The green grasshopper was a talkative chatterbox prone to impulsive chatter.\n2. Kooran concealed herself under a fallen log, begging the grasshopper to stay quiet.\n3. The grasshopper explicitly spoke out loud to Piththakkannu, betraying Kooran verbally.\n4. Though keeping its mouth shut, the grasshopper hopped towards the hiding spot out of excitement.\nWhich statements are correct?"}], "options": {"A": "1, 2 only are correct", "B": "2, 3 only are correct", "C": "1, 2, 4 only are correct; 3 is incorrect", "D": "1, 3, 4 only are correct"}, "explanation": "Textbook page 36: Statements 1, 2, and 4 are correct. Statement 3 is false because the grasshopper clamped its mouth shut, but betrayed Kooran through body jumps."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பச்சை வெட்டுக்கிளி ஒரு வாயாடிப் பிராணி; எப்போதும் பேசிக்கொண்டே இருப்பதால் அடிக்கடி சிக்கல்களில் மாட்டிக்கொள்ளும்.", "content_en": "The green grasshopper was a chatterbox, frequently getting embroiled in trouble due to non-stop blabbering."}, {"id": "S2", "content_ta": "பித்தக்கண்ணு தேடி வந்தபோது, சருகுமான் விழுந்து கிடந்த மரத்தடியில் ஒளிந்துகொண்டு வெட்டுக்கிளியிடம் தன்னைக் காட்டிக் கொடுக்க வேண்டாம் என வேண்டியது.", "content_en": "When Piththakkannu pursued it, the mouse deer hid beneath a fallen log, pleading with the grasshopper not to betray it."}, {"id": "S3", "content_ta": "வெட்டுக்கிளி தன் வாயால் பித்தக்கண்ணுவிடம் கூரன் ஒளிந்திருக்கும் இடத்தை நேரடியாகக் காட்டிக் கொடுத்துவிட்டது.", "content_en": "The grasshopper directly told Piththakkannu with its mouth where Kooran was hiding."}, {"id": "S4", "content_ta": "வெட்டுக்கிளி வாயைத் திறக்காமல் இருந்தபோதிலும், உற்சாகத்தைத் தாங்க முடியாமல் கூரன் ஒளிந்திருந்த இடத்திற்கு நேராகக் குதித்துக் காட்டிக் கொடுத்தது.", "content_en": "Though it kept its mouth shut, unable to contain excitement it jumped right toward Kooran's hiding spot, inadvertently revealing it."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["plot", "story_analysis", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q200", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-09-vettukkiliyum-sarukumaanum", "chapter_id": null, "topic_id": "ta-8th-u2-story-climax-folklore-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கதையின் முடிவு மற்றும் பழங்குடியினர் தரும் இயற்கை விளக்கம் பற்றிய கூற்றுகளை ஆராய்க:\n1. பித்தக்கண்ணுவால் மரத்தடியில் பதுங்கியிருந்த கூரனைப் பிடிக்க முடியாமல் ஏமாந்து சென்றது.\n2. ஆபத்து நீங்கியதும் கூரன் வெட்டுக்கிளியின் பொறுப்பற்ற செயலால் கடும் கோபம் கொண்டது.\n3. 'இனி இப்படிச் செய்தால் என் கால்களால் மிதித்து நசுக்குவேன்' எனக் கூரன் எச்சரித்தது.\n4. கூரனின் கூர்ப்பாதங்கள் பட்டுவிடுமோ என்ற அச்சத்தால்தான் இன்றும் வெட்டுக்கிளிகள் குறிப்பிட்ட திசையுமின்றித் தாவித் திரிகின்றன.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "1, 2 மட்டுமே சரியானவை", "B": "2, 3 மட்டுமே சரியானவை", "C": "1, 3, 4 மட்டுமே சரியானவை", "D": "1, 2, 3, 4 அனைத்தும் சரியானவை"}, "explanation": "பாடநூல் பக்கம் 37: பித்தக்கண்ணு ஏமாந்து சென்றது, கூரனின் ஆத்திரம், தங்கக் கால்களால் மிதித்து நசுக்குவேன் என்ற மிரட்டல் மற்றும் வெட்டுக்கிளி ஓரிடத்தில் நிற்காமல் திசையின்றிக் குதிப்பதற்கான காடர்களின் நாட்டுப்புறக் காரண விளக்கம் ஆகியவை அனைத்தும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the story climax and the tribal etiological myth explaining grasshopper behavior:\n1. Unable to penetrate beneath the log, Piththakkannu left disappointed.\n2. Once danger passed, Kooran was outraged by the grasshopper's reckless breach of trust.\n3. Kooran threatened to stamp and crush it underfoot if it ever repeated such treachery.\n4. Fear of Kooran's sharp hooves is why grasshoppers to this day hop erratically in no fixed direction.\nWhich statements are correct?"}], "options": {"A": "1, 2 only are correct", "B": "2, 3 only are correct", "C": "1, 3, 4 only are correct", "D": "All 1, 2, 3, 4 are correct"}, "explanation": "Textbook page 37: All 4 statements accurately depict the story climax and the etiological myth explaining why grasshoppers hop constantly."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பித்தக்கண்ணு மரத்தடிக்குள் தலையை நுழைக்க முயன்றும் தடிமனான உடலால் உள்ளே செல்ல முடியாமல் திரும்பிச் சென்றது.", "content_en": "Piththakkannu tried to enter beneath the log, but couldn't squeeze its stout body in, and left."}, {"id": "S2", "content_ta": "பித்தக்கண்ணு சென்றபின் வெளியில் வந்த கூரன், வெட்டுக்கிளியின் மீது கடும் சினங்கொண்டது.", "content_en": "Emerging after the leopard departed, Kooran was infuriated with the grasshopper."}, {"id": "S3", "content_ta": "'இனி இப்படிச் செய்தால் என் தங்கக் கால்களால் மிதித்து நசுக்கிவிடுவேன்' என்று கூரன் தன் கூரிய பாதங்களால் நிலத்தை உதைத்து மிரட்டியது.", "content_en": "Kooran stamped its sharp hooves and threatened: 'If you ever do this again, I will crush you under my golden feet!'"}, {"id": "S4", "content_ta": "அச்சத்தின் காரணமாகவே வெட்டுக்கிளிகள் இன்றும் ஓரிடத்தில் நிலைத்து நிற்காமல் திசையற்று எப்போதும் குதித்துக்கொண்டே இருக்கின்றன.", "content_en": "Out of perpetual dread of Kooran's sharp hooves, grasshoppers even today never stay still, hopping erratically."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["folklore", "etiology", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q201", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-09-vettukkiliyum-sarukumaanum", "chapter_id": null, "topic_id": "ta-8th-u2-kadar-culture-nature-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காடர்களின் பண்பாட்டு மரபுகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. ஆனைமலை, பரம்பிக்குளம் காடுகள் காடர்களின் பாரம்பரிய வாழ்விடங்களாகும்.\n2. காட்டின் இயற்கை வளங்களைச் சார்ந்து வாழும் பழங்குடியின மக்கள் காடர்கள் ஆவர்.\n3. காடர்களிடம் அவர்களின் வரலாறு குறித்த எழுத்துப்பூர்வ ஆவணங்கள் ஏதும் இல்லை.\n4. அவர்தம் கதைகளில் காடுகளும் விலங்குகளும் மிக உயிரோட்டமாகச் சித்தரிக்கப்படுகின்றன.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2 மட்டுமே சரியானவை", "C": "கூற்றுகள் 2, 3 மட்டுமே சரியானவை", "D": "கூற்றுகள் 1, 3, 4 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் பக்கம் 35-36: காடர்களின் வாழ்விடம், காட்டு வளம் சார்ந்த வாழ்க்கை, எழுத்து வடிவம் இல்லாத வாய்மொழி மரபு, கதைகளில் இயற்கை மற்றும் விலங்குகளின் முதன்மை ஆகியவை குறித்த நான்கு கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Kadar cultural lifeways and folklore themes:\n1. Anaimalai and Parambikulam forests form the ancestral homeland of Kadars.\n2. Kadars are an indigenous tribal community subsisting in harmony with forest ecosystems.\n3. They possess no written historical documents or literary archives.\n4. In their oral stories, forests and wildlife are depicted with vivid organic vitality.\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 2 only are correct", "C": "Statements 2, 3 only are correct", "D": "Statements 1, 3, 4 only are correct"}, "explanation": "Textbook pages 35-36: All 4 statements correctly reflect the sociological, linguistic, and ecological realities of the Kadar tribe."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "காடர்கள் வாழும் நிலப்பகுதியான ஆனைமலை தென்னிந்தியாவின் மேற்குத் தொடர்ச்சி மலையின் ஒரு பகுதியாகும்.", "content_en": "Anaimalai, where the Kadars dwell, forms part of the Western Ghats of South India."}, {"id": "S2", "content_ta": "காடர்கள் காட்டின் வளங்களைச் சேகரித்துத் தங்களின் வாழ்க்கைத் தேவைகளை நிறைவு செய்து கொள்கின்றனர்.", "content_en": "Kadars fulfill their living needs by gathering forest produce sustainably."}, {"id": "S3", "content_ta": "காடர் பழங்குடியினரிடையே மிக விரிவான வரலாற்று ஆவணங்களும் ஏட்டுச் சுவடிகளும் பாதுகாக்கப்பட்டு வருகின்றன.", "content_en": "Extensive historical chronicles and palm-leaf manuscripts are preserved among the Kadar tribe."}, {"id": "S4", "content_ta": "காடர்களின் கதைகளில் இயற்கையும் விலங்குகளும் மனிதர்களுக்கு இணையான முதன்மைப் பாத்திரங்களாகத் திகழ்கின்றன.", "content_en": "In Kadar tales, nature and wildlife play pivotal roles on equal footing with humans."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["kadars", "culture", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q202", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-09-vettukkiliyum-sarukumaanum", "chapter_id": null, "topic_id": "ta-8th-u2-forest-ecology-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கதையில் விவரிக்கப்படும் காட்டுச் சூழல் மற்றும் சருகுமானின் இயல்பு குறித்த கூற்றுகளை ஆராய்க:\n1. சருகுமான் உருவத்தில் பெரிய காட்டுப்பசு போன்ற உடல்வாகைக் கொண்டது.\n2. சருகுமான் ஒரு பெரிய வீட்டுப் பூனை அளவு மட்டுமே இருக்கும் கூச்ச சுபாவமுடைய சிறிய பிராணி.\n3. விலங்குகள் நீர் அருந்தும் ஓடையின் அருகில் அடர்ந்த குறிஞ்சிப் புதர் அமைந்திருந்தது.\n4. விழுந்து கிடந்த மரத்தின் மீது மெத்துமெத்தென்று பச்சைப்பாசி படர்ந்திருந்தது.\nஇவற்றுள் தவறான கூற்றைக் கண்டறிக:"}], "options": {"A": "கூற்று 2 தவறானது", "B": "கூற்று 1 தவறானது", "C": "கூற்று 3 தவறானது", "D": "கூற்று 4 தவறானது"}, "explanation": "பாடநூல் பக்கம் 35: கூற்று 1 தவறானது. காட்டுப் பசு அளவு இருப்பது 'ஆமா' ஆகும். 'சருகுமான் ஒரு சிறிய பிராணி; ஒரு பெரிய வீட்டுப் பூனை அளவு இருக்கும்; பார்ப்பதற்குக் கூச்சப்படும் விலங்கு' என்று பாடநூல் கூறுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on forest ecology and the nature of the mouse deer:\n1. The mouse deer is a massive beast comparable in stature to a wild cow.\n2. The mouse deer is a tiny, shy animal about the size of a domestic cat.\n3. A dense Kurinji bush stood beside the stream where animals came to quench thirst.\n4. Soft green moss covered the fallen ancient log.\nIdentify the INCORRECT statement:"}], "options": {"A": "Statement 2 is incorrect", "B": "Statement 1 is incorrect", "C": "Statement 3 is incorrect", "D": "Statement 4 is incorrect"}, "explanation": "Textbook page 35: Statement 1 is false because mouse deer are tiny, fragile creatures the size of a cat, not large like wild cattle."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "சருகுமான் (Mouse Deer) என்பது உருவத்தில் பெரிய காட்டுப் பசுவைப் போன்ற உடலமைப்பைக் கொண்டது.", "content_en": "The mouse deer possesses a massive physique resembling a wild cow."}, {"id": "S2", "content_ta": "சருகுமான் மிகவும் சிறியது; மிக எளிதில் அச்சமடையும் கூச்ச சுபாவம் கொண்ட விலங்கு.", "content_en": "The mouse deer is tiny, shy, and extremely timid."}, {"id": "S3", "content_ta": "காட்டில் ஓடைக்கு நீர் அருந்த வரும் விலங்குகள் தாகம் தணிந்ததும் குறிஞ்சிப் புதரில் ஓய்வெடுத்துக் கொள்ளும்.", "content_en": "Forest animals visiting the stream to drink water would rest in the nearby Kurinji thicket."}, {"id": "S4", "content_ta": "விழுந்து கிடந்த பெரிய மரத்தின் மீது பச்சைப்பாசி படர்ந்திருந்தது.", "content_en": "Soft green moss had grown luxuriantly over the fallen log."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["ecology", "sarukumaan", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q203", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-09-vettukkiliyum-sarukumaanum", "chapter_id": null, "topic_id": "ta-8th-u2-literary-value-kadar-lore", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வெட்டுக்கிளியும் சருகுமானும்' கதையின் இலக்கிய மதிப்பீடு குறித்த கூற்றுகளை ஆராய்க:\n1. பழங்குடியினரின் மரபுவழி அறிவை எதிர்காலத் தலைமுறைக்குக் கடத்தும் நோக்கம் கொண்டது.\n2. காட்டின் பல்லுயிர்ச் சூழலையும் விலங்குகளின் நுண்ணிய இயல்புகளையும் விவரிக்கிறது.\n3. 'யானையோடு பேசுதல்' என்பது வட அமெரிக்கப் பழங்குடியினரின் கதையாகும்.\n4. வ. கீதா இந்நூலைத் தமிழாக்கம் செய்து தமிழ்க் குழந்தைகளுக்கு வழங்கியுள்ளார்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "1, 2 மட்டுமே சரியானவை", "B": "2, 3 மட்டுமே சரியானவை", "C": "1, 2, 4 மட்டுமே சரியானவை; 3 தவறானது", "D": "1, 3, 4 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் பக்கம் 37: கூற்றுகள் 1, 2, 4 சரியானவை. கூற்று 3 தவறானது; இது தமிழ்நாட்டின் பரம்பிக்குளம், ஆனைமலைப் பகுதிகளில் வாழும் 'காடர்கள்' என்னும் தென்னிந்தியப் பழங்குடியினரின் நாட்டுப்புறக் கதையாகும்."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements assessing the literary and anthropological merit of the tale:\n1. It seeks to transmit tribal ecological knowledge to future generations.\n2. It portrays forest biodiversity and subtle animal behaviors with insight.\n3. 'Yaanaiyodu Pesuthal' is a folk collection from North American indigenous tribes.\n4. V. Geetha translated this work into Tamil for young readers.\nWhich statements are correct?"}], "options": {"A": "1, 2 only are correct", "B": "2, 3 only are correct", "C": "1, 2, 4 only are correct; 3 is incorrect", "D": "1, 3, 4 only are correct"}, "explanation": "Textbook page 37: Statements 1, 2, and 4 are correct. Statement 3 is false because this folklore belongs strictly to the Kadar tribals of South India."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "காடர்களின் கதைகள் அவர்களின் பண்பாட்டை அடுத்த தலைமுறைக்குக் கடத்தும் பாலமாக அமைகின்றன.", "content_en": "Kadar stories serve as an indispensable bridge passing their cultural heritage to posterity."}, {"id": "S2", "content_ta": "இக்கதைகள் மனிதர்களுக்கும் விலங்குகளுக்குமான பரஸ்பர இயற்கை வாழ்வை நேர்த்தியாகப் புலப்படுத்துகின்றன.", "content_en": "These tales illustrate harmonious coexistence between humans and the natural biosphere."}, {"id": "S3", "content_ta": "'யானையோடு பேசுதல்' என்னும் நூல் ஆங்கிலத்திலிருந்து நேரடியாகத் தமிழாக்கம் செய்யப்பட்ட அமெரிக்கப் பழங்குடிக் கதையாகும்.", "content_en": "'Yaanaiyodu Pesuthal' is an American Amerindian folk story translated into Tamil from English."}, {"id": "S4", "content_ta": "தமிழாக்கம் செய்த வ. கீதா, காடர்களின் கதைகளின் இயற்கை நயமும் மண்வாசனையும் குறையாமல் அழகுறத் தந்துள்ளார்.", "content_en": "Translator V. Geetha masterfully preserved the indigenous earthy flavor of the Kadar narratives."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["anthropology", "translation", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q204", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-09-vettukkiliyum-sarukumaanum", "chapter_id": null, "topic_id": "ta-8th-u2-ar-kadar-script-records", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): காடர்கள் தங்கள் முன்னோர்களின் கதைகளைக் கல்வெட்டுகளிலும் செப்பேடுகளிலும் ஆவணப்படுத்தி வைத்துள்ளனர்.\nகாரணம் (R): காடர்கள் பேசும் 'ஆல்-அலப்பு' என்னும் மொழி வட்டெழுத்து வரிவடிவத்தைக் கொண்ட மொழியாகும்.\nசரியான விடையைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) சரி, காரணம் (R) சரி", "B": "கூற்று (A) சரி, காரணம் (R) தவறு", "C": "கூற்று (A) தவறு, காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று, காரணம் இரண்டும் முற்றிலும் தவறு. காடர்கள் பேசும் 'ஆல்-அலப்பு' மொழிக்கு வரிவடிவம் (எழுத்து) கிடையாது; அவர்கள் எதையும் கல்வெட்டிலோ ஏட்டிலோ எழுதவில்லை. கதைகளைத் தம் பிள்ளைகளுக்கு வாய்மொழியாகவே கூறிவந்தனர்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): The Kadars preserved their ancestral folklore by engraving them on stone epigraphs and copper plates.\nReason (R): The 'Aal-Alappu' dialect spoken by Kadars possesses an archaic Vatteluthu written script.\nChoose the correct option:"}], "options": {"A": "Both (A) and (R) are true", "B": "(A) is true, but (R) is false", "C": "(A) is false, but (R) is true", "D": "Both (A) and (R) are false"}, "explanation": "Both assertion and reason are false. Aal-Alappu is strictly an oral language without written script or inscriptions."}}, "question_data": {"assertion": "காடர்கள் தங்கள் முன்னோர்களின் வாழ்வியலையும் காடுகளின் கதைகளையும் கல்வெட்டுகளிலும் செப்பேடுகளிலும் பொறித்து வைத்துள்ளனர்.", "reason": "காடர்களின் 'ஆல்-அலப்பு' மொழியானது மிகப்பழமையான வட்டெழுத்து வரிவடிவத்தைக் கொண்ட மொழியாகத் திகழ்கிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["kadars", "assertion_reason", "oral_tradition"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q205", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-09-vettukkiliyum-sarukumaanum", "chapter_id": null, "topic_id": "ta-8th-u2-ar-predator-wit", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): வெட்டுக்கிளி வாயால் சொல்லாவிட்டாலும், அது குதித்த செயலே கூரன் ஒளிந்திருந்த இடத்தைப் பித்தக்கண்ணுவுக்குக் காட்டியது.\nகாரணம் (R): அறிவாளியான பித்தக்கண்ணு வெட்டுக்கிளியின் திசை நோக்கிய குதியாட்டத்தின் பொருளை உடனே புரிந்துகொண்டது.\nசரியான விடையைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; கூற்றிற்குக் காரணம் சரியான விளக்கம்", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் சரியான விளக்கமன்று", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி"}, "explanation": "பாடநூல் பக்கம் 36: 'அறிவாளியான பித்தக்கண்ணுவுக்கு வெட்டுக்கிளியின் குதியாட்டத்திற்கான பொருள் புரியாமலா போகும்? உடனே அது கூரன் பதுங்கிக் கிடந்த மரத்தடிப் பக்கம் சென்றது.' கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Though the grasshopper did not utter a word, its hopping revealed Kooran's hiding spot to Piththakkannu.\nReason (R): Being an astute predator, Piththakkannu instantly deciphered the directional meaning behind the grasshopper's frantic jumps.\nChoose the correct option:"}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation of (A)", "B": "Both (A) and (R) are true, but (R) is not the correct explanation of (A)", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Textbook page 36: Both statements are true, and R explains how the predator accurately interpreted the grasshopper's bodily cues."}}, "question_data": {"assertion": "பச்சை வெட்டுக்கிளி வாயைத் திறந்து பேசாதபோதும், அது குதித்துக் குதித்துச் சென்ற செயலே பித்தக்கண்ணுவுக்குக் கூரன் இருக்கும் இடத்தைக் காட்டிக் கொடுத்தது.", "reason": "சிறுத்தையான பித்தக்கண்ணு மிகவும் கூர்மையான புத்திசாலித்தனம் கொண்ட வேட்டை விலங்கு என்பதால், வெட்டுக்கிளியின் அசாதாரணமான குதியாட்டத்தின் உட்பொருளை உடனடியாகப் புரிந்து கொண்டது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["folktale", "assertion_reason", "predator_instinct"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q206", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-09-vettukkiliyum-sarukumaanum", "chapter_id": null, "topic_id": "ta-8th-u2-ar-sarukumaan-physique", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): சருகுமான் தன் கூரிய கொம்புகளாலும் பற்களாலும் சிறுத்தையான பித்தக்கண்ணுவை எதிர்த்துப் போரிட்டது.\nகாரணம் (R): சருகுமான் வீட்டுப் பூனை அளவு மட்டுமே இருக்கும் சிறிய, பார்த்தாலே கூச்சப்படும் எளிய பிராணியாகும்.\nசரியான விடையைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி", "B": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று (A) தவறு; சருகுமான் சிறுத்தையிடம் சண்டையிடவில்லை, பயந்து நடுங்கி மரத்தடியில் பதுங்கியது. காரணம் (R) சரி; சருகுமான் பூனை அளவு மட்டுமே இருக்கும் கூச்சப்படும் சிறிய விலங்கு."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Kooran the mouse deer fought head-on with the leopard using its horns and sharp teeth.\nReason (R): The mouse deer is a tiny creature the size of a cat, extremely shy and timid.\nChoose the correct option:"}], "options": {"A": "Both (A) and (R) are true", "B": "(A) is false, but (R) is true", "C": "(A) is true, but (R) is false", "D": "Both (A) and (R) are false"}, "explanation": "(A) is false because Kooran never battled the leopard, trembling in fear beneath the log. (R) is true."}}, "question_data": {"assertion": "கூரன் என்னும் பெண் சருகுமான் பெரிய கொம்புகளையும் வலிமையான பற்களையும் கொண்டு சிறுத்தையோடு நேருக்கு நேர் போரிட்டது.", "reason": "சருகுமான் ஒரு பெரிய வீட்டுப் பூனையின் அளவு மட்டுமே இருக்கும் மிகவும் சிறிய, கூச்ச சுபாவமுள்ள பிராணியாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["sarukumaan", "assertion_reason", "character_traits"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q207", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-09-vettukkiliyum-sarukumaanum", "chapter_id": null, "topic_id": "ta-8th-u2-ar-grasshopper-erratic-jumping", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): காடர்களின் கதையின்படி, வெட்டுக்கிளிகள் எப்போதுமே குறிப்பிட்ட ஒரே திசையை நோக்கி மட்டுமே தாவுகின்றன.\nகாரணம் (R): கூரனின் கூரிய பாதங்கள் தன்மீது பட்டுவிடுமோ என்ற அச்சத்தால் இன்றும் வெட்டுக்கிளிகள் திசையின்றிக் குதிக்கின்றன.\nசரியான விடையைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று (A) தவறு; வெட்டுக்கிளிகள் எந்தக் குறிப்பிட்ட திசையையும் நோக்கித் தாவுவதில்லை. காரணம் (R) சரி; கூரனின் தங்கக் கால்கள் மிதித்துவிடுமோ என்ற அச்சத்தால்தான் அவை ஓரிடத்தில் நிற்காமல் திசையின்றிக் குதிக்கின்றன எனக் காடர்கள் கூறுகின்றனர்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): According to Kadar myth, grasshoppers always hop strictly in one fixed rectilinear direction.\nReason (R): Fearing Kooran's sharp hooves might crush them, grasshoppers even today hop erratically without a fixed direction.\nChoose the correct option:"}], "options": {"A": "Both (A) and (R) are true", "B": "(A) is true, but (R) is false", "C": "(A) is false, but (R) is true", "D": "Both (A) and (R) are false"}, "explanation": "(A) is false because grasshoppers never hop in a single fixed direction. (R) is true as explained in the tribal myth."}}, "question_data": {"assertion": "காடர்களின் நம்பிக்கையின்படி, வெட்டுக்கிளிகள் குறிப்பிட்ட ஒரு திசையை நோக்கி மட்டுமே நேர்க்கோட்டில் தாவிச் செல்லும் இயல்புடையவை.", "reason": "கூரனின் கூரிய கால்கள் தன் மீது பட்டு நசுக்கிவிடுமோ என்ற அச்சத்தால்தான் இன்றும் வெட்டுக்கிளிகள் எந்தக் குறிப்பிட்ட திசையுமின்றித் தாவித் திரிகின்றன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["grasshopper", "etiology", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q208", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-09-vettukkiliyum-sarukumaanum", "chapter_id": null, "topic_id": "ta-8th-u2-ar-leopard-escape", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): பித்தக்கண்ணு மரத்தடிக்குள் எளிதாக நுழைந்து கூரனைப் பிடித்து ஒரே வாயில் விழுங்கி ஏப்பமிட்டது.\nகாரணம் (R): சிறுத்தைகள் எவ்வளவு சிறிய பொந்தாயினும் தன் உடலைச் சுருக்கி நுழையும் உடலமைப்பு கொண்டவை.\nசரியான விடையைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) சரி, காரணம் (R) சரி", "B": "கூற்று (A) சரி, காரணம் (R) தவறு", "C": "கூற்று (A) தவறு, காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று, காரணம் இரண்டும் முற்றிலும் தவறு. மரத்தடியின் குறுகிய பொந்திற்குள் பித்தக்கண்ணுவால் நுழைய முடியவில்லை; கூரன் தப்பியது. சிறுத்தைகளால் சிறிய பொந்துகளுக்குள் நுழைய முடியாது."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Piththakkannu squeezed effortlessly under the log, seized Kooran, and swallowed her in a single bite.\nReason (R): Leopards possess the unique physiological ability to compress their skeleton into any narrow burrow.\nChoose the correct option:"}], "options": {"A": "Both (A) and (R) are true", "B": "(A) is true, but (R) is false", "C": "(A) is false, but (R) is true", "D": "Both (A) and (R) are false"}, "explanation": "Both assertion and reason are false. Piththakkannu failed to reach Kooran beneath the log, and leopards cannot compress into tiny crevices."}}, "question_data": {"assertion": "பித்தக்கண்ணு மரத்தடிக்குள் எளிதாக நுழைந்து கூரனைப் பிடித்து ஒரே வாயில் விழுங்கிவிட்டது.", "reason": "சிறுத்தைகள் எந்தவொரு சிறிய பொந்திற்குள்ளும் தன் தலையையும் உடலையும் சுருக்கி நுழையும் அபார உடலமைப்பைக் கொண்டவை.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["plot", "assertion_reason", "piththakkannu"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q209", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-09-vettukkiliyum-sarukumaanum", "chapter_id": null, "topic_id": "ta-8th-u2-ar-tribal-ecological-wisdom", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): பழங்குடியினர் தம் வாய்மொழிக் கதைகள் மூலம் இயற்கையையும் காடுகளையும் நேசிக்கும் பண்பாட்டை வளர்த்தனர்.\nகாரணம் (R): காடுகளையும் பல்லுயிர்களையும் காப்பது மனிதகுலத்தின் வாழ்விற்கே அடித்தளம் என்ற உண்மையை அவர்கள் உணர்ந்திருந்தனர்.\nசரியான விடையைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; கூற்றிற்குக் காரணம் சரியான விளக்கம்", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் சரியான விளக்கமன்று", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி"}, "explanation": "பாடநூல் பக்கம் 35: முன்னோர்கள் காடுகளில் வாழ்ந்ததை வருங்காலத் தலைமுறையினர் மறந்துவிடக் கூடாது என்பதற்காகக் கதைகளைக் கூறி இயற்கையைப் போற்றினர். கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Indigenous tribals fostered a culture of deep ecological reverence through their oral storytelling.\nReason (R): They recognized that preserving forests and wildlife was indispensable for the very survival of future human generations.\nChoose the correct option:"}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation of (A)", "B": "Both (A) and (R) are true, but (R) is not the correct explanation of (A)", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Textbook page 35: Both statements are true, explaining the profound conservation ethic underpinning indigenous folklore."}}, "question_data": {"assertion": "பழங்குடியின மக்கள் தங்கள் கதைகள் வழியாக இயற்கை, காடுகள், விலங்குகள் ஆகியவற்றைத் தங்களின் குடும்ப உறுப்பினர்களைப் போல நேசித்துப் பாதுகாக்கும் பண்பாட்டைப் பேணினர்.", "reason": "மனிதர்கள் காடுகளையும் விலங்குகளையும் அழித்தால் மனிதகுலத்தின் எதிர்காலமும் கேள்விக்குறியாகிவிடும் என்ற பேருண்மையைப் பழங்குடியினர் ஆழமாக உணர்ந்திருந்தனர்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["ecology", "conservation", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q210", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-09-vettukkiliyum-sarukumaanum", "chapter_id": null, "topic_id": "ta-8th-u2-match-story-characters", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கதை மாந்தர்களையும் அவர்களின் விளக்கங்களையும் பொருத்துக:\nபட்டியல் I (மாந்தர்)\n1. கூரன்\n2. பித்தக்கண்ணு\n3. பச்சை வெட்டுக்கிளி\n4. காடர்கள்\n\nபட்டியல் II (விளக்கம்)\na) குறிஞ்சிப் புதரில் வாழும் வாயாடிப் பூச்சி\nb) பரம்பிக்குளம், ஆனைமலைப் பழங்குடியினர்\nc) பூனை அளவுள்ள பெண் சருகுமான்\nd) மஞ்சள் கண்களுடைய கொடிய சிறுத்தை"}], "options": {"A": "1-d, 2-c, 3-b, 4-a", "B": "1-c, 2-d, 3-a, 4-b", "C": "1-c, 2-a, 3-d, 4-b", "D": "1-b, 2-d, 3-a, 4-c"}, "explanation": "பாடநூல் பக்கம் 35: கூரன் = பெண் சருகுமான் (c); பித்தக்கண்ணு = சிறுத்தை (d); வெட்டுக்கிளி = வாயாடிப் பூச்சி (a); காடர்கள் = பழங்குடியினர் (b). சரியான பொருத்தம்: 1-c, 2-d, 3-a, 4-b."}, "en": {"blocks": [{"type": "text", "content": "Match the story characters with their descriptions:\nList I (Character)\n1. Kooran\n2. Piththakkannu\n3. Green Grasshopper\n4. Kadars\n\nList II (Description)\na) Chatterbox insect dwelling in Kurinji thicket\nb) Tribals of Parambikulam and Anaimalai\nc) Cat-sized female mouse deer\nd) Yellow-eyed predatory leopard"}], "options": {"A": "1-d, 2-c, 3-b, 4-a", "B": "1-c, 2-d, 3-a, 4-b", "C": "1-c, 2-a, 3-d, 4-b", "D": "1-b, 2-d, 3-a, 4-c"}, "explanation": "Textbook page 35: Kooran->c, Piththakkannu->d, Grasshopper->a, Kadars->b. Key B."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "கூரன்", "content_en": "Kooran"}, {"id": "L2", "content_ta": "பித்தக்கண்ணு", "content_en": "Piththakkannu"}, {"id": "L3", "content_ta": "பச்சை வெட்டுக்கிளி", "content_en": "Green Grasshopper"}, {"id": "L4", "content_ta": "காடர்கள்", "content_en": "Kadars"}], "right": [{"id": "R1", "content_ta": "குறிஞ்சிப் புதரில் வாழும் வாயாடிப் பூச்சி", "content_en": "Chatterbox insect living in Kurinji bush"}, {"id": "R2", "content_ta": "பரம்பிக்குளம், ஆனைமலைப் பழங்குடியினர்", "content_en": "Tribals of Parambikulam and Anaimalai"}, {"id": "R3", "content_ta": "பூனை அளவுள்ள பெண் சருகுமான்", "content_en": "Cat-sized female mouse deer"}, {"id": "R4", "content_ta": "மஞ்சள் கண்களுடைய கொடிய சிறுத்தை", "content_en": "Yellow-eyed predatory leopard"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["characters", "matching", "folktale"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_