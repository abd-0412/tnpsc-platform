{"id": "8th-u7-q865", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l1", "chapter_id": null, "topic_id": "thirumanthiram-quote-completion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருமூலரின் அருள்வாக்கை நிறைவு செய்க:\n\"படமாடக் கோயில் பகவற்கு ஒன்று ஈயில்\nநடமாடக் கோயில் ______ அங்கு ஆகா\""}], "options": {"A": "நம்பர்க்கு", "B": "மன்னர்க்கு", "C": "சித்தர்க்கு", "D": "மாந்தர்க்கு"}, "explanation": "பாடநூல் பக். 132: \"படமாடக் கோயில் பகவற்கு ஒன்று ஈயில் நடமாடக் கோயில் நம்பர்க்கு அங்கு ஆகா\". கோடிட்ட இடத்தில் வர வேண்டிய சொல் 'நம்பர்க்கு' (அடியார்களுக்கு)."}, "en": {"blocks": [{"type": "text", "content": "Complete the sacred verse of Thirumoolar:\n\"Padamaadak koyil bagavarku ondru eeyil\nNadamaadak koyil ______ angu aagaa\""}], "options": {"A": "Nambarkku (To the devotees)", "B": "Mannarkku (To the kings)", "C": "Sitharkku (To the ascetics)", "D": "Maantharkku (To mortals)"}, "explanation": "Textbook Page 132 Verse: '...Nadamaadak koyil nambarkku angu aagaa'. The missing word is 'Nambarkku' (devotees)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 132, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "odd_one_out", "quote-completion", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q866", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l2", "chapter_id": null, "topic_id": "masthan-sahibu-works-odd-one", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குணங்குடி மஸ்தான் சாகிபு அருளிய படைப்புகளுள் பொருந்தாத நூலைத் தேர்க:"}], "options": {"A": "எக்காலக் கண்ணி", "B": "திருக்குற்றால மாலை", "C": "மனோன்மணிக் கண்ணி", "D": "நந்தீசுவரக் கண்ணி"}, "explanation": "எக்காலக் கண்ணி, மனோன்மணிக் கண்ணி, நந்தீசுவரக் கண்ணி ஆகியவை குணங்குடி மஸ்தான் சாகிபுவின் நூல்கள்; 'திருக்குற்றால மாலை' என்பது திரிகூடராசப்பக் கவிராயர் இயற்றிய நூலாகும். எனவே பொருந்தாதது 'திருக்குற்றால மாலை'."}, "en": {"blocks": [{"type": "text", "content": "Select the literary work that does NOT belong to Gunangudi Masthan Sahibu:"}], "options": {"A": "Ekkalak Kanni", "B": "Thirukutrala Maalai", "C": "Manonmanik Kanni", "D": "Nandheeswarak Kanni"}, "explanation": "'Thirukutrala Maalai' was authored by Thirikooda Rasappa Kavirayar, while the other three works were composed by Gunangudi Masthan Sahibu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edit