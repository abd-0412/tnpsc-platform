{"id": "8th-u7-q920", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u7-aram", "lesson_id": "8th-u7-l3", "chapter_id": null, "topic_id": "ayothidhasar-works-odd-one-out", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அயோத்திதாசர் இயற்றிய நூல்களுள் பொருந்தாத ஒன்றைத் தேர்க:"}], "options": {"A": "புத்தரது ஆதிவேதம்", "B": "இந்திரர் தேச சரித்திரம்", "C": "விவாக விளக்கம்", "D": "சீவக சிந்தாமணி"}, "explanation": "பாடநூல் பக். 138 தெரிந்து தெளிவோம்: புத்தரது ஆதிவேதம், இந்திரர் தேச சரித்திரம், விவாக விளக்கம், புத்தர் சரித்திரப்பா ஆகியவை அயோத்திதாசரின் நூல்கள். 'சீவக சிந்தாமணி' என்பது திருத்தக்கதேவர் இயற்றிய ஐம்பெருங் காப்பியங்களுள் ஒன்றாகும். எனவே பொருந்தாதது 'சீவக சிந்தாமணி'."}, "en": {"blocks": [{"type": "text", "content": "Identify the work that does NOT belong to Pandithar Ayothidhasar:"}], "options": {"A": "Buddharthu Aathivedham", "B": "Indhirar Dhesa Sarithiram", "C": "Vivaaga Vilakkam", "D": "Seevaga Chinthamani"}, "explanation": "'Seevaga Chinthamani' is a classical Jain epic composed by Thiruthakkadhevar, while the other three treatises were authored by Ayothidhasar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Serv