{"id": "8th-u7-q924", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l3", "chapter_id": null, "topic_id": "buddhist-hermeneutics-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருவள்ளுவர், ஔவையார் ஆகியோரின் படைப்புகளுக்கு எந்த சமயக் கோட்பாடுகளின் அடிப்படையில் அயோத்திதாசர் புதிய விளக்கங்களை எழுதினார்?"}], "options": {"A": "சைவக் கோட்பாடு", "B": "வைணவக் கோட்பாடு", "C": "சமணக் கோட்பாடு", "D": "பௌத்தக் கோட்பாடு"}, "explanation": "பாடநூல் பக். 138 தெரிந்து தெளிவோம்: \"திருவள்ளுவர், ஔவையார் ஆகியோரின் படைப்புகளுக்குப் பௌத்தக் கோட்பாடுகளின் அடிப்படையில் புதிய விளக்கங்களை எழுதியுள்ளார்\"."}, "en": {"blocks": [{"type": "text", "content": "Based on the tenets of which philosophical tradition did Ayothidhasar author innovative commentaries on Thiruvalluvar and Avvaiyar?"}], "options": {"A": "Saiva philosophy", "B": "Vaishnava philosophy", "C": "Jain philosophy", "D": "Buddhist philosophy (Bautthak kotpaadu)"}, "explanation": "Textbook Page 138: Ayothidhasar authored new commentaries on Thiruvalluvar and Avvaiyar grounded in Buddhist philosophy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Serv