ce": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "grammar", "noun-classification", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q918", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l3", "chapter_id": null, "topic_id": "makkalul-case-marker-analysis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"மக்களுள் மாமனிதராக, அறிவாற்றல் பெற்றவராக... இருக்க வேண்டும்\" - இத்தொடரில் 'மக்களுள்' என்னும் சொல்லில் இடம்பெற்றுள்ள வேற்றுமை உருபு யாது?"}], "options": {"A": "மூன்றாம் வேற்றுமை உருபு (ஆல்)", "B": "ஏழாம் வேற்றுமை உருபு ('உள்' என்னும் ஏழாம் வேற்றுமை இடப்பொருள் உருபு)", "C": "நான்காம் வேற்றுமை உருபு (கு)", "D": "இரண்டாம் வேற்றுமை உருபு (ஐ)"}, "explanation": "கண், கால், மேல், கீழ், உள் முதலியன ஏழாம் வேற்றுமை உருபுகளாகும்; 'மக்களுள்' என்பதில் 'உள்' என்னும் ஏழாம் வேற்றுமை உருபு இணைந்து இடப்பொருளையும் கூட்டத்தில் ஒன்றைப் பிரிக்கும் பொருளையும் உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "Identify the case marker and grammatical case functioning in the word 'Makkalul' (Among the people):"}], "options": {"A": "Third case suffix (aal)", "B": "Seventh locative case marker ('ul' indicating locative enclosure/among)", "C": "Fourth case suffix (ku)", "D": "Second accusative case suffix (ai)"}, "explanation": "'Ul' is an overt seventh locative case marker (Kan, Kaal, Mel, Keel, Ul) signifying 'among/within'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": tr