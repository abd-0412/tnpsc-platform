{"id": "8th-u7-q923", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l3", "chapter_id": null, "topic_id": "dravida-mahajana-sangam-year-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அயோத்திதாசர் 'திராவிட மகாஜன சங்கம்' என்னும் அமைப்பைத் தோற்றுவித்த ஆண்டு எது?"}], "options": {"A": "1845", "B": "1885", "C": "1892", "D": "1907"}, "explanation": "பாடநூல் பக். 138: அயோத்திதாசர் தமது கொள்கைகளை வலியுறுத்தவும் ஒடுக்கப்பட்டோர் உரிமைகளைப் பாதுகாக்கவும் 1892-ஆம் ஆண்டு 'திராவிட மகாஜன சங்கம்' என்னும் அமைப்பைத் தோற்றுவித்தார்."}, "en": {"blocks": [{"type": "text", "content": "In which year did Ayothidhasar establish the organization 'Dravida Mahajana Sangam'?"}], "options": {"A": "1845", "B": "1885", "C": "1892", "D": "1907"}, "explanation": "Textbook Page 138: Ayothidhasar founded the Dravida Mahajana Sangam in 1892."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": nul