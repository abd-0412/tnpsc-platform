{"id": "8th-u7-q895", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u7-aram", "lesson_id": "8th-u7-l3", "chapter_id": null, "topic_id": "ayothidhasar-birth-date-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தென்னிந்திய சமூகச் சீர்திருத்தத்தின் தந்தை என்று போற்றப்படும் பண்டிதர் அயோத்திதாசர் பிறந்த நாள் எது?"}], "options": {"A": "1835 ஜனவரி 17", "B": "1840 ஏப்ரல் 14", "C": "1845 மே 20", "D": "1850 அக்டோபர் 2"}, "explanation": "பாடநூல் பக். 136: அயோத்திதாசர் 1845-ஆம் ஆண்டு மே திங்கள் 20-ஆம் நாள் சென்னையில் பிறந்தார்."}, "en": {"blocks": [{"type": "text", "content": "On which date was Pandithar Ayothidhasar, celebrated as the Father of South Indian Social Reform, born?"}], "options": {"A": "January 17, 1835", "B": "April 14, 1840", "C": "May 20, 1845", "D": "October 2, 1850"}, "explanation": "Textbook Page 136: Ayothidhasar was born on May 20, 1845 in Chennai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 136, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "direct", "ayothidhasar", "birth-date", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q896", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l3", "chapter_id": null, "topic_id": "oru-paisa-tamilan-year-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அயோத்திதாசர் சென்னையில் 'ஒரு பைசா தமிழன்' என்னும் வார இதழைத் தொடங்கிய ஆண்டு எது?"}], "options": {"A": "1892", "B": "1900", "C": "1905", "D": "1907"}, "explanation": "பாடநூல் பக். 137: அயோத்திதாசர் 1907-ஆம் ஆண்டு சென்னையில் 'ஒரு பைசா தமிழன்' என்னும் வார இதழைக் காலணா விலையில் தொடங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "In which year did Ayothidhasar inaugurate the weekly journal 'Oru Paisa Tamilan' in Chennai?"}], "options": {"A": "1892", "B": "1900", "C": "1905", "D": "1907"}, "explanation": "Textbook Page 137: Ayothidhasar launched the weekly journal 'Oru Paisa Tamilan' in 1907."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "direct", "oru-paisa-tamilan", "year", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

