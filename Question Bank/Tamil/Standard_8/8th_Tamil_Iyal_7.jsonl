{"id": "8th-u7-q894", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u7-aram", "lesson_id": "8th-u7-l3", "chapter_id": null, "topic_id": "ayothidhasar-journals-odd-one", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அயோத்திதாசரின் 'ஒரு பைசா தமிழன்' இதழ் விவரங்களுள் பொருந்தாத ஒன்றைத் தேர்க:"}], "options": {"A": "1907-ஆம் ஆண்டு தொடங்கப்பட்டது", "B": "மாதமிருமுறை இதழாக வெளிவந்தது", "C": "காலணா விலையில் விற்கப்பட்டது", "D": "ஓராண்டிற்குப் பின் 'தமிழன்' எனப் பெயர் மாற்றப்பட்டது"}, "explanation": "பாடநூல் பக். 137: 'ஒரு பைசா தமிழன்' என்பது 'வார இதழ்' (வாரந்தோறும் வெளிவந்தது) ஆகும்; மாதமிருமுறை இதழ் அல்ல. எனவே பொருந்தாதது கூற்று B."}, "en": {"blocks": [{"type": "text", "content": "Select the detail that does NOT align with Ayothidhasar's 'Oru Paisa Tamilan':"}], "options": {"A": "Launched in the year 1907", "B": "Published as a fortnightly (bi-monthly) magazine", "C": "Sold at the price of a quarter-anna", "D": "Renamed as 'Tamilan' after one year"}, "explanation": "Textbook Page 137: 'Oru Paisa Tamilan' was a weekly journal (Vaara ithazh), not a fortnightly magazine. Hence statement B is the odd one."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Te