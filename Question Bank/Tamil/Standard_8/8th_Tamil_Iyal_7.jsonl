{"id": "8th-u7-q868", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l2", "chapter_id": null, "topic_id": "masthan-sahibu-real-name-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மெய்ஞ்ஞான ஒளி' பாடலை இயற்றிய குணங்குடி மஸ்தான் சாகிபுவின் இயற்பெயர் யாது?"}], "options": {"A": "அப்துல் ரகுமான்", "B": "உமறுப் புலவர்", "C": "செய்யிது அப்துல் காதிர்", "D": "சுல்தான் அப்துல்காதர்"}, "explanation": "பாடநூல் பக். 135 நூல் வெளி: குணங்குடி மஸ்தான் சாகிபுவின் இயற்பெயர் சுல்தான் அப்துல்காதர் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What was the original given name of Gunangudi Masthan Sahibu, the composer of 'Meignana Oli'?"}], "options": {"A": "Abdul Rahman", "B": "Umarup Pulavar", "C": "Seyyid Abdul Qadir", "D": "Sultan Abdul Khader"}, "explanation": "Textbook Page 135: Gunangudi Masthan Sahibu's real birth name was Sultan Abdul Khader."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 135, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {