// 8-ஆம் வகுப்பு தமிழ் - இயல் 7: அறத்தால் வருவதே இன்பம் (மொத்த வினாக்கள்: 140)
// ==============================================================================

// ==============================================================================
// பாடம் 1 & 2: ஒன்றே குலம் (திருமூலர் / திருமந்திரம்) & மெய்ஞ்ஞான ஒளி (குணங்குடி மஸ்தான் சாகிபு) [Q0841 - Q0868]
// திருமூலர், தமிழ் மூவாயிரம், பத்தாம் திருமுறை, 'ஒன்றே குலமும் ஒருவனே தேவனும்', படமாடக் கோயில், குணங்குடி மஸ்தான் சாகிபு (சுல்தான் அப்துல்காதர்), எக்காலக் கண்ணி, மனோன்மணிக் கண்ணி, நந்தீசுவரக் கண்ணி, பராபரம், ஐம்பொறி அடக்கம்
// ==============================================================================
{"id": "8th-u7-q841", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l1", "chapter_id": null, "topic_id": "thirumoolar-profile-statement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருமூலர் மற்றும் அவரது திருமந்திரம் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. திருமூலர் அறுபத்து மூன்று நாயன்மார்களுள் ஒருவராகப் போற்றப்படுகிறார்.\n2. இவர் பதினெண் சித்தர்களுள் ஒருவராகவும் மதிக்கப்படுகிறார்.\n3. இவர் இயற்றிய திருமந்திரம் மூவாயிரம் பாடல்களைக் கொண்டதால் 'தமிழ் மூவாயிரம்' என அழைக்கப்படுகிறது.\n4. இந்நூல் பன்னிரு திருமுறைகளுள் பத்தாம் திருமுறையாக வைக்கப்பட்டுள்ளது."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 2, 3 மட்டும் சரி; 4 தவறு", "C": "1, 3, 4 மட்டும் சரி; 2 தவறு", "D": "2, 3, 4 மட்டும் சரி; 1 தவறு"}, "explanation": "பாடநூல் பக். 133 நூல் வெளி: திருமூலர் அறுபத்து மூன்று நாயன்மார்களுள் ஒருவராகவும், பதினெண் சித்தர்களுள் ஒருவராகவும் கருதப்படுகிறார். இவர் இயற்றிய திருமந்திரம் மூவாயிரம் பாடல்களைக் கொண்டதால் 'தமிழ் மூவாயிரம்' எனப்படும். இது பத்தாம் திருமுறையாக வைக்கப்பட்டுள்ளது. அனைத்தும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding saint Thirumoolar and his scripture Thirumanthiram:\n1. Thirumoolar is revered as one of the sixty-three canonical Nayanmars.\n2. He is simultaneously venerated as one of the eighteen classical Siddhars.\n3. His Thirumanthiram consists of three thousand verses and is thus celebrated as 'Tamil Moovaayiram'.\n4. In the twelve Saiva canonical scriptures (Thirumuraigal), it is classified as the Tenth Thirumurai."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "Only 1, 2, 3 are correct; 4 is incorrect", "C": "Only 1, 3, 4 are correct; 2 is incorrect", "D": "Only 2, 3, 4 are correct; 1 is incorrect"}, "explanation": "Textbook Page 133 Author Box: Thirumoolar is both a Nayanmar and a Siddhar; Thirumanthiram has 3,000 hymns, is called Tamil Moovaayiram, and forms the 10th Thirumurai. All statements are true."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 133, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "thirumoolar", "author-info", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q842", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u8-manitham", "lesson_id": "8th-u7-l1", "chapter_id": null, "topic_id": "ondre-kulam-meaning-statement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஒன்றே குலம்' பாடலின் உட்கருத்துகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. மனிதர் அனைவரும் ஒரே இனத்தினர்; உலகைக் காக்கும் இறைவன் ஒருவனே ஆவான்.\n2. இறைவனுக்கு நேர்த்திக்கடன் செலுத்துவதன் மூலம் எமனைப் பற்றிய அச்சமின்றி சாகா வரம் பெறலாம்.\n3. படங்கள் அமைந்த மாடக் கோயிலில் வீற்றிருக்கும் இறைவனுக்குக் கொடுக்கும் காணிக்கை நடமாடும் அடியார்களுக்குச் சேராது.\n4. நடமாடும் கோயிலாகிய ஏழை எளிய அடியார்களுக்குக் கொடுப்பது கோயிலில் இருக்கும் இறைவனுக்குப் போய்ச் சேரும்."}], "options": {"A": "1, 2, 3 சரி; 4 தவறு", "B": "1, 3, 4 சரி; 2 தவறு", "C": "2, 3, 4 சரி; 1 தவறு", "D": "1, 2, 3, 4 அனைத்தும் சரி"}, "explanation": "பாடநூல் பக். 132: மனிதர் அனைவரும் ஒரே இனம், இறைவன் ஒருவன் என்ற எண்ணத்தை நெஞ்சில் நிறுத்தி வாழ்வோர்க்கு எமனைப் பற்றிய அச்சம் தேவையில்லை என்று கூறப்பட்டுள்ளதே தவிர, நேர்த்திக்கடனால் சாகா வரம் பெறலாம் என்று கூறப்படவில்லை. கூற்று 2 தவறு; 1, 3, 4 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding the doctrinal concepts of 'Ondre Kulam':\n1. All human beings belong to a single human clan, and the Almighty who protects the universe is One.\n2. Performing sacrificial offerings directly to God guarantees immortality and exemption from death.\n3. Offerings presented to God enshrined in ornate picture-decked stone temples do not reach walking human devotees.\n4. Whatever charity is offered to living human devotees (living walking temples) truly reaches God enshrined in temples."}], "options": {"A": "1, 2, 3 are correct; 4 is incorrect", "B": "1, 3, 4 are correct; 2 is incorrect", "C": "2, 3, 4 are correct; 1 is incorrect", "D": "All 1, 2, 3, 4 are correct"}, "explanation": "Textbook Page 132: Contemplating universal brotherhood and one God dispels fear of death; the hymn does not endorse sacrificial rituals for immortality. Statement 2 is incorrect, while 1, 3, and 4 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 132, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "ondre-kulam", "philosophy", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q843", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l2", "chapter_id": null, "topic_id": "masthan-sahibu-profile-statement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குணங்குடி மஸ்தான் சாகிபு பற்றிய பின்வரும் குறிப்புகளை ஆராய்க:\n1. இவரது இயற்பெயர் சுல்தான் அப்துல்காதர் என்பதாகும்.\n2. இவர் இளம் வயதிலேயே உலகப் பற்றுகளை முற்றும் துறந்த ஞானியாக வாழ்ந்தார்.\n3. சதுரகிரி, புறாமலை, நாகமலை போன்ற இடங்களில் அழகிய அரண்மனைகளைக் கட்டி வாழ்ந்து வந்தார்.\n4. எக்காலக் கண்ணி, மனோன்மணிக் கண்ணி, நந்தீசுவரக் கண்ணி முதலான நூல்களை இயற்றியுள்ளார்."}], "options": {"A": "1, 2, 3 சரி; 4 தவறு", "B": "2, 3, 4 சரி; 1 தவறு", "C": "1, 2, 4 சரி; 3 தவறு", "D": "1, 2, 3, 4 அனைத்தும் சரி"}, "explanation": "பாடநூல் பக். 135 நூல் வெளி: குணங்குடி மஸ்தான் சாகிபு சதுரகிரி, புறாமலை, நாகமலை முதலிய மலைப் பகுதிகளில் தவம் இயற்றி ஞானம் பெற்றார்; அரண்மனைகளைக் கட்டவில்லை. எனவே கூற்று 3 தவறு; 1, 2, 4 ஆகியவை சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the biographical facts regarding Gunangudi Masthan Sahibu:\n1. His original given name was Sultan Abdul Khader.\n2. In his youth itself, he renounced all worldly attachments and lived as an ascetic sage.\n3. He constructed magnificent palaces in mountain ranges like Sathuragiri, Puramalai, and Nagamalai.\n4. He authored spiritual texts including Ekkalak Kanni, Manonmanik Kanni, and Nandheeswarak Kanni."}], "options": {"A": "1, 2, 3 are correct; 4 is incorrect", "B": "2, 3, 4 are correct; 1 is incorrect", "C": "1, 2, 4 are correct; 3 is incorrect", "D": "All 1, 2, 3, 4 are correct"}, "explanation": "Textbook Page 135: Masthan Sahibu meditated in the forests and caves of Sathuragiri, Puramalai, and Nagamalai to attain spiritual enlightenment; he did not build palaces. Statement 3 is false, while 1, 2, and 4 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 135, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "masthan-sahibu", "author-info", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q844", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u8-manitham", "lesson_id": "8th-u7-l2", "chapter_id": null, "topic_id": "meignana-oli-meaning-statement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மெய்ஞ்ஞான ஒளி' பாடலின் தத்துவக் கருத்துகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. தீய எண்ணங்களை அடியோடு நீக்கியவர்களின் உள்ளத்தில் இறைவன் மெய்ஞ்ஞான ஒளியாய் எழுந்தருளியுள்ளான்.\n2. உண்மை அறிவை உணர்ந்தவர்களின் உள்ளத்தில் பராபரன் இன்பப் பெருக்காய்க் கரைபுரண்டு பொங்கும் கடலாக விளங்குகிறான்.\n3. பொருளாசையால் காசை விரும்பி மனம் கலங்கி அலைவதால் இறைவனின் திருவடிப் பற்றை இழக்க நேரிடுகிறது.\n4. அடக்க முடியாத மாய ஐம்பொறிகளையும் கட்டி நல்வழிப்படுத்தும் மெய்யறிவை அருளுமாறு கவிஞர் பராபரனிடம் வேண்டுகிறார்."}], "options": {"A": "1, 2, 3 மட்டுமே சரி", "B": "2, 3, 4 மட்டுமே சரி", "C": "1, 3, 4 மட்டுமே சரி", "D": "1, 2, 3, 4 அனைத்தும் சரி"}, "explanation": "பாடநூல் பக். 134: தீய எண்ணங்களை அறுத்தவர் உள்ளத்து ஒளி, உண்மை உணர்ந்தோர்க்கு இன்பக் கடல், காசின் மீதான ஆசையால் அலைதல், ஐம்பொறியை அடக்கும் கல்வி வேண்டி நிற்றல் ஆகிய நான்கு கருத்துகளும் பாடலின் வரிகளோடு முற்றிலும் ஒத்துப்போகின்றன. அனைத்தும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Analyze the philosophical teachings of the hymn 'Meignana Oli':\n1. The Supreme Divine abides as the inner spiritual light within those who have uprooted evil thoughts entirely.\n2. Within the souls of enlightened beings, the Lord swells as an boundless ocean of blissful flood.\n3. Yearning excessively for money deludes the restless mind, causing one to abandon devotion to the Lord's holy feet.\n4. The poet beseeches the Supreme Being to bestow the higher wisdom required to tame and guide the wild five senses."}], "options": {"A": "Only 1, 2, 3 are correct", "B": "Only 2, 3, 4 are correct", "C": "Only 1, 3, 4 are correct", "D": "All 1, 2, 3, 4 are correct"}, "explanation": "Textbook Page 134: All four statements faithfully reflect the verses of Gunangudi Masthan Sahibu's hymn on inner light, bliss, detachment from greed, and sensory mastery. All are true."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 134, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "meignana-oli", "spiritual-concepts", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q845", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l1", "chapter_id": null, "topic_id": "thirumanthiram-glossary-statement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருமூலரின் 'ஒன்றே குலம்' பாடலின் சொல்லும் பொருளும் குறித்த கூற்றுகளை ஆராய்க:\n1. 'நமன்' என்பதன் பொருள் எமன் ஆகும்.\n2. 'சித்தம்' என்பதன் பொருள் உள்ளம் ஆகும்.\n3. 'நம்பர்' என்பதன் பொருள் இறைவனின் தொண்டர்களாகிய அடியார்கள் ஆகும்.\n4. 'நாணாமே' என்பதன் பொருள் கூசாமல் ஆகும்."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 2, 3 மட்டுமே சரி; 4 தவறு", "C": "2, 3, 4 மட்டுமே சரி; 1 தவறு", "D": "1, 3, 4 மட்டுமே சரி; 2 தவறு"}, "explanation": "பாடநூல் பக். 132: நமன் - எமன், சித்தம் - உள்ளம், நம்பர் - அடியார், நாணாமே - கூசாமல். மேலும் உய்ம்மின் - ஈடேறுங்கள், ஈயில் - வழங்கினால். எனவே அனைத்தும் சரியான இணை கூற்றுகள்."}, "en": {"blocks": [{"type": "text", "content": "Analyze the lexical glosses of words from Thirumoolar's 'Ondre Kulam':\n1. 'Naman' denotes the God of Death (Yama).\n2. 'Sitham' denotes the heart / consciousness (Ullam).\n3. 'Nambar' denotes the devotees / disciples of God (Adiyaar).\n4. 'Naanaamae' denotes unabashedly / without hesitation (Koosaamal)."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "Only 1, 2, 3 are correct; 4 is incorrect", "C": "Only 2, 3, 4 are correct; 1 is incorrect", "D": "Only 1, 3, 4 are correct; 2 is incorrect"}, "explanation": "Textbook Page 132: Naman = Yama, Sitham = Mind/Heart, Nambar = Devotee, Naanaamae = Without hesitation. All statements are completely correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 132, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "thirumanthiram", "vocabulary", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q846", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l2", "chapter_id": null, "topic_id": "meignana-oli-glossary-statement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மெய்ஞ்ஞான ஒளி' பாடலின் அரும்பதப் பொருள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'பகராய்' என்பதன் பொருள் தருவாய் என்பதாகும்.\n2. 'பராபரம்' என்பதன் பொருள் அற்பமான உலகியல் செல்வம் என்பதாகும்.\n3. 'ஆனந்த வெள்ளம்' என்பதன் பொருள் இன்பப் பெருக்கு என்பதாகும்.\n4. 'அறுத்தவருக்கு' என்பதன் பொருள் தீயவற்றை நீக்கியவர்க்கு என்பதாகும்."}], "options": {"A": "1, 2, 3 சரி; 4 தவறு", "B": "1, 3, 4 சரி; 2 தவறு", "C": "2, 3, 4 சரி; 1 தவறு", "D": "1, 2, 4 சரி; 3 தவறு"}, "explanation": "பாடநூல் பக். 134: 'பராபரம்' என்பதன் பொருள் 'மேலான பொருள்' (இறைவன்) ஆகும்; அற்பமான செல்வம் அல்ல. எனவே கூற்று 2 தவறானது; 1, 3, 4 ஆகியவை சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the word-meaning statements from the hymn 'Meignana Oli':\n1. 'Pagarai' denotes bestow / grant (Tharuvai).\n2. 'Paraabaram' denotes trivial worldly material wealth.\n3. 'Aanandha Vellam' denotes a surging flood of divine bliss (Inbap Perukku).\n4. 'Arutthavarukku' denotes to those who have eradicated / purged negative traits."}], "options": {"A": "1, 2, 3 are correct; 4 is incorrect", "B": "1, 3, 4 are correct; 2 is incorrect", "C": "2, 3, 4 are correct; 1 is incorrect", "D": "1, 2, 4 are correct; 3 is incorrect"}, "explanation": "Textbook Page 134: 'Paraabaram' signifies the Supreme Ultimate Reality (God), not trivial worldly wealth. Statement 2 is false, while 1, 3, and 4 are true."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 134, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "meignana-oli", "vocabulary", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q847", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l1", "chapter_id": null, "topic_id": "thirumurai-structure-statement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சைவத் திருமுறைகள் மற்றும் சித்தரியல் மரபு குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. சைவத் திருமுறைகளில் திருஞானசம்பந்தர், அப்பர், சுந்தரர் பாடிய தேவாரம் முதல் ஏழு திருமுறைகளாகத் தொகுக்கப்பட்டுள்ளன.\n2. மாணிக்கவாசகர் அருளிய திருவாசகமும் திருக்கோவையாரும் எட்டாம் திருமுறையாக அமைக்கப்பட்டுள்ளன.\n3. திருமூலரின் திருமந்திரம் பன்னிரண்டாம் திருமுறையாகிய பெரியபுராணத்திற்கு முந்தைய பதினொன்றாம் திருமுறையாக உள்ளது.\n4. குணங்குடி மஸ்தான் சாகிபுவின் பாடல்கள் இஸ்லாமியத் தமிழ் ஞான இலக்கிய மரபின் தலைசிறந்த கண்ணிப் படைப்புகளாகும்."}], "options": {"A": "1, 2, 3 சரி; 4 தவறு", "B": "2, 3, 4 சரி; 1 தவறு", "C": "1, 2, 4 சரி; 3 தவறு", "D": "1, 2, 3, 4 அனைத்தும் சரி"}, "explanation": "திருமூலரின் திருமந்திரம் பத்தாம் திருமுறையாகும்; பதினொன்றாம் திருமுறை அல்ல. பதினொன்றாம் திருமுறையில் பட்டினத்தார், காரைக்கால் அம்மையார் உள்ளிட்ட பலரின் பாடல்கள் உள்ளன. எனவே கூற்று 3 தவறு; 1, 2, 4 ஆகியவை சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the structural organization of Saiva Thirumurai canons and Sufi Siddha traditions:\n1. The Thevaram hymns composed by Sambandar, Appar, and Sundarar comprise the first seven Thirumurais.\n2. Manikkavasagar's Thiruvasagam and Thirukkovaiyar constitute the Eighth Thirumurai.\n3. Thirumoolar's Thirumanthiram is placed as the Eleventh Thirumurai preceding the Periyapuranam.\n4. Gunangudi Masthan Sahibu's hymns represent masterworks of Islamic Tamil Sufi wisdom structured in Kanni meters."}], "options": {"A": "1, 2, 3 are correct; 4 is incorrect", "B": "2, 3, 4 are correct; 1 is incorrect", "C": "1, 2, 4 are correct; 3 is incorrect", "D": "All 1, 2, 3, 4 are correct"}, "explanation": "Thirumanthiram forms the Tenth Thirumurai, not the Eleventh. Hence statement 3 is incorrect, while 1, 2, and 4 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 133, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "thirumurai", "canon-history", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q848", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l1", "chapter_id": null, "topic_id": "thirumoolar-canon-mismatch-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): திருமூலர் பன்னிரு ஆழ்வார்களுள் முதன்மையான ஒருவராகத் தமிழ் வைணவ மரபில் போற்றப்படுகிறார்.\nகாரணம் (R): திருமந்திரம் நாலாயிர திவ்வியப் பிரபந்தத்தின் பத்தாம் பிரிவாக வைத்துத் தொழப்படும் வைணவப் பனுவல் ஆகும்."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி", "B": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு", "C": "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "பாடநூல் பக். 133: திருமூலர் அறுபத்து மூன்று நாயன்மார்களுள் ஒருவரான சைவ அடியார் மற்றும் பதினெண் சித்தர்களில் ஒருவர். திருமந்திரம் சைவப் பன்னிரு திருமுறைகளுள் பத்தாம் திருமுறையாகும். இவர் வைணவ ஆழ்வாரோ, திருமந்திரம் திவ்வியப் பிரபந்த நூலோ அல்ல. எனவே கூற்று, காரணம் இரண்டும் தவறானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following assertion and reason:\nAssertion (A): Thirumoolar is venerated as the primary saint among the twelve Vaishnava Alhwars.\nReason (R): Thirumanthiram is enshrined as the tenth section of the Vaishnava Nalayira Divya Prabandham."}], "options": {"A": "Both (A) and (R) are true", "B": "(A) is true, but (R) is false", "C": "(A) is false, but (R) is true", "D": "Both (A) and (R) are false"}, "explanation": "Textbook Page 133: Thirumoolar is a Saiva Nayanmar and Siddhar; Thirumanthiram belongs to the Saiva Thirumurai canon, not Vaishnavism. Both (A) and (R) are false."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 133, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "assertion-reason", "thirumoolar", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q849", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l1", "chapter_id": null, "topic_id": "temple-human-service-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): \"நடமாடக் கோயில் நம்பர்க்கு ஒன்று ஈயில் படமாடக் கோயில் பகவற்கு அது ஆமே\" என்று திருமூலர் மனிதநேய வழிபாட்டைப் போற்றுகிறார்.\nகாரணம் (R): நடமாடும் கோயிலாகத் திகழும் சக எளிய மனிதர்களுக்கு வழங்கும் உணவு மற்றும் உதவிகளே, உருவக் கோயிலில் எழுந்தருளியிருக்கும் இறைவனுக்குச் செய்யும் உண்மையான வழிபாடாகும்."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; மேலும் காரணம் கூற்றிற்குச் சரியான விளக்கமாகும்", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் கூற்றிற்குச் சரியான விளக்கம் அல்ல", "C": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி"}, "explanation": "பாடநூல் பக். 132: கோயிலில் உள்ள இறைவனுக்குக் காணிக்கை இடுவதை விட, நடமாடும் கோயிலாகிய ஏழை எளிய அடியார்களுக்குக் கொடுப்பதே இறைவனுக்குச் சென்று சேரும் என்று திருமூலர் விளக்குகிறார். கூற்று (A), காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following assertion and reason:\nAssertion (A): Thirumoolar exalts humanitarian charity: 'Offering to living human temples reaches the Lord of ornate stone temples'.\nReason (R): Serving and nourishing impoverished living beings (living temples of God) constitutes the genuine worship of the Divine enshrined in temple sanctums."}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation of (A)", "B": "Both (A) and (R) are true, but (R) is not the correct explanation of (A)", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Textbook Page 132: Thirumoolar explicitly declares that feeding living devotees serves the Supreme enshrined in stone temples. Both are true, and (R) correctly explains (A)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 132, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "assertion-reason", "humanitarian-worship", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q850", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l2", "chapter_id": null, "topic_id": "kanni-meter-structure-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): குணங்குடி மஸ்தான் சாகிபு அருளிய 'மெய்ஞ்ஞான ஒளி' பாடல் 'பராபரமே' என்ற விளிப்பெயருடன் முடியும் கண்ணிப் பாடல் அமைப்பில் பாடப்பட்டுள்ளது.\nகாரணம் (R): அறுபத்து மூன்று நாயன்மார்களுள் ஒருவரான திருமூலர் அருளிய திருமந்திரம் மூவாயிரம் பாடல்களைக் கொண்ட தமிழ்ப் பனுவலாகும்."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் கூற்றிற்குச் சரியான விளக்கம் அல்ல", "C": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி"}, "explanation": "கூற்று குணங்குடியாரின் பாடல் யாப்பமைதி பற்றியது (சரி); காரணம் திருமூலரின் திருமந்திரப் பாடல் தொகை பற்றியது (சரி). இரண்டும் தனித்தனியே உண்மை ஆயினும், திருமந்திரத்தின் பாடல் எண்ணிக்கை குணங்குடியாரின் பாடல் வடிவத்திற்கு விளக்கம் ஆகாது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following assertion and reason:\nAssertion (A): 'Meignana Oli' composed by Gunangudi Masthan Sahibu is structured in couplets (Kanni) terminating with the invocation 'Paraabaramae!'.\nReason (R): Thirumanthiram authored by saint Thirumoolar comprises three thousand sacred Tamil hymns."}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation", "B": "Both (A) and (R) are true, but (R) is not the correct explanation of (A)", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Both statements are independent textbook facts, but the verse count of Thirumanthiram does not explain the poetic meter of Masthan Sahibu's Kanni. Hence (R) is not the explanation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 134, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "assertion-reason", "poetic-meter", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q851", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l2", "chapter_id": null, "topic_id": "senses-control-wisdom-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): மனிதன் தன் ஐம்பொறிகளையும் தன்னிச்சையாக உலகியல் இன்பங்களில் அலைந்து திரிய விடுவதே மெய்ஞ்ஞானம் அடைவதற்கான வழி என்று குணங்குடி மஸ்தான் சாகிபு உபதேசிக்கிறார்.\nகாரணம் (R): அடக்க முடியாத மாய ஐம்பொறிகளைக் கட்டி நல்வழிப்படுத்தும் மெய்யறிவே மனிதனைப் பிறவித் துன்பத்திலிருந்து விடுவிக்கும் நெறியாகும்."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி", "B": "கூற்று (A), காரணம் (R) இரண்டும் தவறு", "C": "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி", "D": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு"}, "explanation": "பாடநூல் பக். 134: \"அடக்கத்தாம் மாய ஐம்பொறியைக் கட்டிப் படிக்கப் படிப்பு எனக்குப் பகராய் பராபரமே!\" என ஐம்பொறியை அடக்கி ஆளவே மஸ்தான் சாகிபு வேண்டுகிறார்; தன்னிச்சையாக விட வேண்டும் என்று கூறவில்லை. எனவே கூற்று (A) தவறு; காரணம் (R) முற்றிலும் சரியானது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following assertion and reason:\nAssertion (A): Gunangudi Masthan Sahibu preaches that indulging the five senses unconditionally in sensory pleasures is the true pathway to enlightenment.\nReason (R): Mastering and disciplining the elusive five senses through spiritual wisdom is the supreme discipline liberating humans from suffering."}], "options": {"A": "Both (A) and (R) are true", "B": "Both (A) and (R) are false", "C": "(A) is false, but (R) is true", "D": "(A) is true, but (R) is false"}, "explanation": "Textbook Page 134: Masthan Sahibu prays for the discipline to restrain the wild senses ('Aimporiyaik katti'); he never advocates sensual hedonism. Thus (A) is false, while (R) is true."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 134, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "assertion-reason", "sensory-mastery", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q852", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l1", "chapter_id": null, "topic_id": "tamil-moovaayiram-title-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): தமிழ் இலக்கியத்தில் 'தமிழ் மூவாயிரம்' என்று போற்றப்படும் ஒப்பற்ற அறநூல் நாலடியார் ஆகும்.\nகாரணம் (R): சமண முனிவர்கள் பலர் பாடிய நானூறு வெண்பாக்களைக் கொண்ட தொகுப்பு நூலே திருமந்திரம் எனப்படுகிறது."}], "options": {"A": "கூற்று (A) சரி; காரணம் (R) தவறு", "B": "கூற்று (A) தவறு; காரணம் (R) சரி", "C": "கூற்று (A), காரணம் (R) இரண்டும் சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "பாடநூல் பக். 133: 'தமிழ் மூவாயிரம்' எனப்படுவது திருமூலர் இயற்றிய திருமந்திரம் ஆகும் (நாலடியார் அல்ல). சமண முனிவர்கள் பாடிய 400 வெண்பாக்களின் தொகுப்பு நாலடியார் ஆகும் (திருமந்திரம் அல்ல). எனவே கூற்று, காரணம் இரண்டும் முற்றிலும் தவறானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following assertion and reason:\nAssertion (A): The sacred work celebrated as 'Tamil Moovaayiram' in Tamil literature is Naladiyar.\nReason (R): Thirumanthiram is an anthology of four hundred venpa verses composed by Jain monks."}], "options": {"A": "(A) is true, but (R) is false", "B": "(A) is false, but (R) is true", "C": "Both (A) and (R) are true", "D": "Both (A) and (R) are false"}, "explanation": "Textbook Page 133: 'Tamil Moovaayiram' refers to Thirumanthiram, not Naladiyar; Naladiyar comprises 400 Jain venpas, not Thirumanthiram. Both assertion and reason are false."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 133, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "assertion-reason", "literary-titles", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q853", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l1", "chapter_id": null, "topic_id": "universal-brotherhood-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): மனிதரிடையே பிறப்பினால் உயர்வு தாழ்வு பாராட்டுவது தவறானது; மானுடர் அனைவரும் ஒரே குலத்தினர்; உலகைக் காக்கும் இறைவன் ஒருவனே என்று திருமூலர் பறைசாற்றுகிறார்.\nகாரணம் (R): 'ஒன்றே குலமும் ஒருவனே தேவனும்' என்ற சமத்துவ அறவுணர்வை உள்ளத்தில் நிறுத்தி வாழும் அடியார்களுக்கு எமனைப் பற்றிய அச்சம் சிறிதும் தேவையில்லை."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; மேலும் காரணம் கூற்றிற்குச் சரியான விளக்கமாகும்", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் கூற்றிற்குச் சரியான விளக்கம் அல்ல", "C": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி"}, "explanation": "பாடநூல் பக். 132: 'ஒன்றே குலமும் ஒருவனே தேவனும் நன்றே நினைமின் நமனில்லை நாணாமே' என்ற பாடலில், மனித சமத்துவத்தை நெஞ்சில் நிறுத்தும்போது இறப்பச்சம் அகலும் எனத் திருமூலர் தெளிவுபடுத்துகிறார். கூற்று (A), காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following assertion and reason:\nAssertion (A): Discriminating by birth is unjust; all humanity belongs to one clan and the protecting God is One, declares Thirumoolar.\nReason (R): Those who firmly anchor the egalitarian truth 'One is the human clan, and One is the Divine' need have no dread of death (Yama)."}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation of (A)", "B": "Both (A) and (R) are true, but (R) is not the correct explanation of (A)", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Textbook Page 132: Realizing that humanity is one and God is one frees the mind from all existential dread. Both (A) and (R) are true, and (R) is the exact explanation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 132, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "assertion-reason", "equality", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q854", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l1", "chapter_id": null, "topic_id": "thirumanthiram-terms-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருமூலரின் திருமந்திர அரும்பதங்களைப் பொருள்களுடன் பொருத்துக:\nஅ) நமன் - 1. உள்ளம்\nஆ) சித்தம் - 2. எமன்\nஇ) நம்பர் - 3. ஈடேறுங்கள்\nஈ) உய்ம்மின் - 4. அடியார்"}], "options": {"A": "அ-1, ஆ-2, இ-3, ஈ-4", "B": "அ-2, ஆ-1, இ-4, ஈ-3", "C": "அ-2, ஆ-4, இ-1, ஈ-3", "D": "அ-3, ஆ-1, இ-4, ஈ-2"}, "explanation": "நமன்: எமன் (2), சித்தம்: உள்ளம் (1), நம்பர்: அடியார் (4), உய்ம்மின்: ஈடேறுங்கள் (3). சரியான வரிசை: 2, 1, 4, 3."}, "en": {"blocks": [{"type": "text", "content": "Match the classical terms from Thirumanthiram with their meanings:\na) Naman - 1. Mind / Heart (Ullam)\nb) Sitham - 2. God of Death (Yama)\nc) Nambar - 3. Attain salvation (Eedaerungal)\nd) Uymmin - 4. Devotees of God (Adiyaar)"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-2, b-4, c-1, d-3", "D": "a-3, b-1, c-4, d-2"}, "explanation": "Naman: Yama (2), Sitham: Heart (1), Nambar: Devotee (4), Uymmin: Attain salvation (3). Correct order: 2, 1, 4, 3."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 132, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "matching", "vocabulary", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q855", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l2", "chapter_id": null, "topic_id": "meignana-oli-terms-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குணங்குடியார் பாடலின் அரும்பதங்களைப் பொருள்களுடன் பொருத்துக:\nஅ) பகராய் - 1. இன்பப் பெருக்கு\nஆ) பராபரம் - 2. நீக்கியவர்க்கு\nஇ) ஆனந்த வெள்ளம் - 3. தருவாய்\nஈ) அறுத்தவருக்கு - 4. மேலான பொருள்"}], "options": {"A": "அ-1, ஆ-2, இ-3, ஈ-4", "B": "அ-2, ஆ-1, இ-4, ஈ-3", "C": "அ-3, ஆ-4, இ-1, ஈ-2", "D": "அ-4, ஆ-3, இ-2, ஈ-1"}, "explanation": "பகராய்: தருவாய் (3), பராபரம்: மேலான பொருள் (4), ஆனந்த வெள்ளம்: இன்பப் பெருக்கு (1), அறுத்தவருக்கு: நீக்கியவர்க்கு (2). சரியான வரிசை: 3, 4, 1, 2."}, "en": {"blocks": [{"type": "text", "content": "Match the terms from Gunangudi Masthan Sahibu's poem with their meanings:\na) Pagarai - 1. Surging flood of bliss\nb) Paraabaram - 2. Unto those who purged vices\nc) Aanandha Vellam - 3. Bestow / grant\nd) Arutthavarukku - 4. Supreme Being"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-3, b-4, c-1, d-2", "D": "a-4, b-3, c-2, d-1"}, "explanation": "Pagarai: Grant (3), Paraabaram: Supreme Being (4), Aanandha Vellam: Flood of bliss (1), Arutthavarukku: Unto those who removed evil (2). Order: 3, 4, 1, 2."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 134, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "matching", "vocabulary", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q856", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l1", "chapter_id": null, "topic_id": "spiritual-works-descriptions-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பக்தி இலக்கிய நூல்களையும் அவற்றின் தனித்துவக் குறிப்புகளையும் பொருத்துக:\nஅ) திருமந்திரம் - 1. குணங்குடியாரின் பராபரக்கண்ணி அடங்கிய நூல் தொகுதி\nஆ) குணங்குடியார் பாடற்கோவை - 2. சுல்தான் அப்துல்காதர் அருளிய கண்ணி நூல்\nஇ) எக்காலக் கண்ணி - 3. பன்னிரண்டாகத் தொகுக்கப்பட்ட சைவத் திருமுறைகள்\nஈ) பன்னிரு திருமுறைகள் - 4. தமிழ் மூவாயிரம் எனப் போற்றப்படும் பத்தாம் திருமுறை"}], "options": {"A": "அ-1, ஆ-2, இ-3, ஈ-4", "B": "அ-2, ஆ-3, இ-4, ஈ-1", "C": "அ-3, ஆ-4, இ-1, ஈ-2", "D": "அ-4, ஆ-1, இ-2, ஈ-3"}, "explanation": "திருமந்திரம்: தமிழ் மூவாயிரம் (4), குணங்குடியார் பாடற்கோவை: பராபரக்கண்ணி நூல் தொகுதி (1), எக்காலக் கண்ணி: மஸ்தான் சாகிபு நூல் (2), பன்னிரு திருமுறைகள்: சைவத் தொகுப்பு (3). சரியான வரிசை: 4, 1, 2, 3."}, "en": {"blocks": [{"type": "text", "content": "Match the spiritual literary works with their distinctive descriptions:\na) Thirumanthiram - 1. Compendium containing Masthan Sahibu's Paraabarak Kanni\nb) Gunangudiyaar Paadarkovai - 2. Sacred Kanni work by Sultan Abdul Khader\nc) Ekkalak Kanni - 3. Twelve canonical Saiva scriptures\nd) Panniru Thirumuraigal - 4. Tenth Thirumurai celebrated as Tamil Moovaayiram"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-3, c-4, d-1", "C": "a-3, b-4, c-1, d-2", "D": "a-4, b-1, c-2, d-3"}, "explanation": "Thirumanthiram: Tamil Moovaayiram (4), Gunangudiyaar Paadarkovai: Masthan Sahibu anthology (1), Ekkalak Kanni: poem by Masthan Sahibu (2), Panniru Thirumuraigal: Saiva canon (3). Sequence: 4, 1, 2, 3."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 135, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "matching", "scriptures", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q857", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l2", "chapter_id": null, "topic_id": "meditation-sites-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குணங்குடி மஸ்தான் சாகிபு தவம் இயற்றிய மலைப்பகுதிகளை அவற்றுடன் பொருத்துக:\nஅ) சதுரகிரி - 1. மஸ்தான் சாகிபு தவம் இயற்றி ஞானம் பெற்ற மலை 1\nஆ) புறாமலை - 2. மஸ்தான் சாகிபு தவம் இயற்றி ஞானம் பெற்ற மலை 2\nஇ) நாகமலை - 3. மஸ்தான் சாகிபு தவம் இயற்றி ஞானம் பெற்ற மலை 3\nஈ) இடைசெவல் - 4. எழுத்தாளர் கு. அழகிரிசாமி பிறந்த கரிசல் கிராமம் (மலையல்லாதது)"}], "options": {"A": "அ-1, ஆ-2, இ-3, ஈ-4", "B": "அ-2, ஆ-1, இ-4, ஈ-3", "C": "அ-3, ஆ-4, இ-1, ஈ-2", "D": "அ-4, ஆ-3, இ-2, ஈ-1"}, "explanation": "சதுரகிரி, புறாமலை, நாகமலை ஆகிய மூன்றும் மஸ்தான் சாகிபு தவம் இயற்றிய மலைகள். இடைசெவல் அழகிரிசாமி பிறந்த ஊர். சரியான வரிசை: 1, 2, 3, 4."}, "en": {"blocks": [{"type": "text", "content": "Match the meditation sanctuaries of Gunangudi Masthan Sahibu:\na) Sathuragiri - 1. Hill sanctuary 1 where Masthan Sahibu attained enlightenment\nb) Puramalai - 2. Hill sanctuary 2 where Masthan Sahibu attained enlightenment\nc) Nagamalai - 3. Hill sanctuary 3 where Masthan Sahibu attained enlightenment\nd) Idaiseval - 4. Birthplace village of author Ku. Alagirisamy (Non-hill)"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-3, b-4, c-1, d-2", "D": "a-4, b-3, c-2, d-1"}, "explanation": "Sathuragiri, Puramalai, and Nagamalai were Masthan Sahibu's hill hermitages; Idaiseval is Ku. Alagirisamy's village. Order: 1, 2, 3, 4."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "ans