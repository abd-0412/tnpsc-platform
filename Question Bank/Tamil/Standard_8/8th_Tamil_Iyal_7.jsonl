{"id": "8th-u7-q952", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l4", "chapter_id": null, "topic_id": "pudhumaipithan-title-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் சிறுகதை இலக்கியத்தில் புதுமைப்பித்தன் எவ்விதம் போற்றப்படுகிறார்?"}], "options": {"A": "புதினப் பேரரசர்", "B": "கவிக்கோ", "C": "சிறுகதைச் சிற்பி", "D": "சிறுகதை மன்னன்"}, "explanation": "பாடநூல் பக். 143: புதுமைப்பித்தன் தமிழ் இலக்கிய உலகில் 'சிறுகதை மன்னன்' என்று போற்றப்படுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "How is Pudhumaipithan celebrated and honored in modern Tamil short story literature?"}], "options": {"A": "Emperor of Novels", "B": "Kavikko", "C": "Sculptor of Short Stories", "D": "King of Short Stories (Sirukadhai Mannan)"}, "explanation": "Textbook Page 143: Pudhumaipithan is revered in Tamil literary circles as 'Sirukadhai Mannan' (King of Short Stories)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 143, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": nul