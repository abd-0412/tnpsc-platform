{"id": "8th-booster-q1204", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u4-kalai", "lesson_id": "8th-booster-grammar", "chapter_id": null, "topic_id": "vaetrumai-types-count-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெயர்ச்சொல்லின் பொருளை வேறுபடுத்தும் வேற்றுமை உருபுகளின் அடிப்படையில் வேற்றுமைகள் எத்தனை வகைப்படும்?"}], "options": {"A": "ஐந்து வகை", "B": "ஆறு வகை", "C": "ஏழு வகை", "D": "எட்டு வகை (முதல் வேற்றுமை முதல் எட்டாம் வேற்றுமை வரை)"}, "explanation": "பாடநூல் பக். 86: வேற்றுமை எட்டு வகைப்படும். அவை: முதல் வேற்றுமை (எழுவாய்), இரண்டாம் வேற்றுமை (செயப்படுபொருள்), மூன்றாம் வேற்றுமை, நான்காம் வேற்றுமை, ஐந்தாம் வேற்றுமை, ஆறாம் வேற்றுமை, ஏழாம் வேற்றுமை, எட்டாம் வேற்றுமை (விளி)."}, "en": {"blocks": [{"type": "text", "content": "Into how many classifications is the case system (Vaetrumai) divided in Tamil grammar?"}], "options": {"A": "Five types", "B": "Six types", "C": "Seven types", "D": "Eight types (First Case to Eighth Case)"}, "explanation": "Textbook Page 86: Tamil grammar establishes exactly eight cases (First to Eighth Case)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 86, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "booster-grammar", "direct", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

