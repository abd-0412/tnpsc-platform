{"id": "8th-booster-q1143", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-booster-thirukkural", "chapter_id": null, "topic_id": "seer-asai-kural-scansion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'இடும்பைக்கு' - இச்சீரின் அசைப் பிரிப்பையும் வாய்பாட்டையும் சரியாகத் தேர்க:\nஇ/டும்/பைக்/கு"}], "options": {"A": "நேர் நேர் நேர் - தேமாங்காய்", "B": "நிரை நேர் நிரை - கூவிளங்கனி", "C": "நிரை நேர் நேர் - புளிமாங்காய்", "D": "நிரை நிரை நேர் - கருவிளங்காய்"}, "explanation": "பாடநூல் பக். 137: இடும் (குறில்-ஒற்று = நேர் அன்று, குறிலிணை ஒற்று 'இடும்' = நிரை), பைக் (நெடில் ஒற்று = நேர்), கு (குறில் தனித்து = நேர்). ஆகவே நிரை + நேர் + நேர் = 'புளிமாங்காய்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the correct metrical scansion (Asai) and pattern name (Vaaypaadu) for the metrical foot 'Idumbaikku':"}], "options": {"A": "Ner Ner Ner - Themaangaai", "B": "Nirai Ner Nirai - Koovilangani", "C": "Nirai Ner Ner - Pulimaangaai", "D": "Nirai Nirai Ner - Karuvilangaai"}, "explanation": "Textbook Page 137: 'Idum' (short+short+consonant = Nirai), 'baik' (long+consonant = Ner), 'ku' (short = Ner). Nirai + Ner + Ner = 'Pulimaangaai'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book