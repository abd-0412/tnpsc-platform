{"id": "8th-booster-q1311", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-booster-scholars", "chapter_id": null, "topic_id": "ilakkana-kurippu-avanoduvandhan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மகனொடு சென்றார்' - இத்தொடரில் பயின்று வந்துள்ள வேற்றுமை உருபும் அதன் பொருளும் யாது?"}], "options": {"A": "இரண்டாம் வேற்றுமை செயப்படுபொருள்", "B": "நான்காம் வேற்றுமை கொடைப்பொருள்", "C": "மூன்றாம் வேற்றுமை உடனிகழ்ச்சிப் பொருள் ('ஒடு' உருபு)", "D": "ஐந்தாம் வேற்றுமை நீங்கல் பொருள்"}, "explanation": "பாடநூல் பக். 87: மகன் + ஒடு = மகனொடு. 'ஒடு' என்பது மூன்றாம் வேற்றுமை உருபு ஆகும். ஒருவருடன் மற்றொருவர் சேர்ந்து செல்லும் உடனிகழ்ச்சிப் பொருளைத் தருவதால் 'மூன்றாம் வேற்றுமை உடனிகழ்ச்சிப் பொருள்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the case marker and syntactic function in 'Maganodu sendraar':"}], "options": {"A": "Second Case objective meaning", "B": "Fourth Case dative meaning", "C": "Third Case sociative accompaniment meaning ('Odu' marker)", "D": "Fifth Case ablative meaning"}, "explanation": "Textbook Page 87: 'Odu' is the 3rd case sociative suffix denoting accompaniment ('Udanigazhchi Porul'). Correct answer is C."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 87, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "booster-scholars", "vaetrumai", "grammar", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
