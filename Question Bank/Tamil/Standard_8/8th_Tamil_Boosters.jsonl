{"id": "8th-booster-q1147", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-booster-bridging", "lesson_id": "8th-booster-thirukkural", "chapter_id": null, "topic_id": "thirukkural-languages-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறள் உலகில் எத்தனைக்கும் மேற்பட்ட மொழிகளில் மொழிபெயர்க்கப்பட்டுள்ளது?"}], "options": {"A": "ஐம்பதுக்கும் மேற்பட்ட மொழிகளில்", "B": "எண்பதுக்கும் மேற்பட்ட மொழிகளில்", "C": "நூற்றுக்கும் மேற்பட்ட மொழிகளில்", "D": "இருநூற்றுக்கும் மேற்பட்ட மொழிகளில்"}, "explanation": "பாடநூல் பக். 66 நூல் வெளி: திருக்குறள் உலக மக்கள் அனைவருக்கும் பொதுவான கருத்துகளைக் கூறுவதால் 'உலகப் பொதுமறை' எனப்படுகிறது. இந்நூல் நூற்றுக்கும் மேற்பட்ட மொழிகளில் மொழிபெயர்க்கப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Thirukkural has been translated into more than how many world languages?"}], "options": {"A": "Over 50 languages", "B": "Over 80 languages", "C": "Over 100 languages", "D": "Over 200 languages"}, "explanation": "Textbook Page 66: Known as the Universal Scripture, Thirukkural has been translated into more than 100 languages worldwide."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Se