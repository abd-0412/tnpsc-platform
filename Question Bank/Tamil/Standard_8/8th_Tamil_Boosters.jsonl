{"id": "8th-booster-q1199", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-booster-grammar", "chapter_id": null, "topic_id": "viyangol-eaval-distinction", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஏவல் வினைமுற்றுக்கும் வியங்கோள் வினைமுற்றுக்கும் இடையே உள்ள வேறுபாடுகளில் சரியான ஒன்றைத் தேர்க:"}], "options": {"A": "ஏவல் வினைமுற்று முன்னிலை, தன்மை, படர்க்கை ஆகிய மூவிடங்களிலும் வரும்; வியங்கோள் முன்னிலையில் மட்டுமே வரும்", "B": "வியங்கோள் வினைமுற்றில் மட்டுமே ஒருமை, பன்மை வேறுபாடு உண்டு; ஏவல் வினைமுற்றில் ஒருமை பன்மை கிடையாது", "C": "ஏவல் வினைமுற்று முன்னிலையில் மட்டுமே வரும் மற்றும் ஒருமை பன்மை வேறுபாடு உண்டு; வியங்கோள் வினைமுற்று இருதிணை ஐம்பால் மூவிடங்களுக்கும் பொதுவாய் வரும் மற்றும் ஒருமை பன்மை வேறுபாடு இல்லை", "D": "இரண்டிற்கும் எந்தவித இலக்கண வேறுபாடும் இல்லை"}, "explanation": "பாடநூல் பக். 43 தெரிந்து தெளிவோம்: ஏவல் வினைமுற்று முன்னிலையில் மட்டுமே வரும் (ஒருமை: எழுது, பன்மை: எழுதுங்கள்). வியங்கோள் வினைமுற்று இருதிணை ஐம்பால் மூவிடங்களுக்கும் பொதுவாய் வரும் (ஒருமை, பன்மை வேறுபாடு இல்லை). ஆப்ஷன் C சரியான வேறுபாடு ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the correct distinction between Eaval Vinaimutru and Viyangol Vinaimutru:"}], "options": {"A": "Eaval occurs in all three persons; Viyangol occurs only in second person", "B": "Viyangol differentiates singular/plural; Eaval does not differentiate number", "C": "Eaval occurs only in second person with singular/plural distinction; Viyangol applies universally across all genders and persons without singular/plural distinction", "D": "There is no grammatical difference between them"}, "explanation": "Textbook Page 43 Info Box: Eaval is strictly second-person with number inflection, whereas Viyangol applies universally across all persons and genders without number inflection. Option C is correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 43, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "booster-grammar", "eaval-viyangol", "grammar", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-booster-q1200", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-booster-grammar", "chapter_id": null, "topic_id": "eluthu-pirappu-odd-one-out", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிறக்கும் இடத்தின் அடிப்படையில் பொருந்தாத மெய்யெழுத்தைத் தேர்க:"}], "options": {"A": "க் (மார்பு - வல்லினம்)", "B": "ச் (மார்பு - வல்லினம்)", "C": "த் (மார்பு - வல்லினம்)", "D": "ண் (மூக்கு - மெல்லினம்; ஏனைய மூன்றும் மார்பில் பிறக்கும் வல்லின மெய்கள்)"}, "explanation": "பாடநூல் பக். 18-19: க், ச், த் ஆகிய மூன்றும் மார்பை இடமாகக் கொண்டு பிறக்கும் வல்லின மெய்கள். 'ண்' என்பது மூக்கை இடமாகக் கொண்டு பிறக்கும் மெல்லின மெய் என்பதால் இது பொருந்தாதது."}, "en": {"blocks": [{"type": "text", "content": "Select the odd consonant based on its anatomical place of articulation:"}], "options": {"A": "k (Chest - Vallinam)", "B": "ch (Chest - Vallinam)", "C": "th (Chest - Vallinam)", "D": "nn (Nose - Mellinam; the other three are chest-origin hard consonants)"}, "explanation": "Textbook Pages 18-19: 'k', 'ch', and 'th' are hard consonants born of the chest. 'nn' is a nasal born of the nose, making it the odd one."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "pu