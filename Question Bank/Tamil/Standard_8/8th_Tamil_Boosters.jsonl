{"id": "8th-booster-q1176", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-booster-thirukkural", "chapter_id": null, "topic_id": "thiruvalluvar-year-reckoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருவள்ளுவர் ஆண்டைக் கணக்கிட தற்போதைய கிறித்து ஆண்டுடன் (கி.பி.) கூட்ட வேண்டிய எண் எது?"}], "options": {"A": "21", "B": "25", "C": "30", "D": "31"}, "explanation": "பாடநூல் பக். 66 & அரசு மரபு: திருவள்ளுவர் கி.மு. 31-இல் பிறந்தவர் எனக் கணக்கிடப்பட்டு, தமிழ்நாடு அரசால் நடைமுறைப்படுத்தப்பட்டுள்ளது. எனவே நடப்பு ஆண்டுடன் 31-ஐக் கூட்டினால் திருவள்ளுவர் ஆண்டு கிடைக்கும் (எ.கா. 2026 + 31 = 2057)."}, "en": {"blocks": [{"type": "text", "content": "What number should be added to the current Gregorian Calendar Year (CE) to reckon the Thiruvalluvar Year?"}], "options": {"A": "21", "B": "25", "C": "30", "D": "31"}, "explanation": "Textbook Page 66: The Government of Tamil Nadu established that Thiruvalluvar was born in 31 BCE; hence 31 is added to the CE year to calculate the Thiruvalluvar year."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "editi