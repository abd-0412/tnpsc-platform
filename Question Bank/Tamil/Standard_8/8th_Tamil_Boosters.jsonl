{"id": "8th-booster-q1339", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-booster-finale", "chapter_id": null, "topic_id": "iyaiybu-rhyme-identification", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வானம் வசப்படும்\nவாழ்க்கை சிறக்கும்\nஎண்ணம் உயரும்' - இவ்வடிகளில் அமைந்துள்ள தொடை நயம் யாது?"}], "options": {"A": "மோனை நயம்", "B": "எதுகை நயம்", "C": "இயைபு நயம் (அடிகளின் இறுதியில் 'உம்' என்னும் ஈற்று ஓசை ஒன்றி வந்துள்ளது)", "D": "முரண் நயம்"}, "explanation": "பாடநூல் பக். 178: அடிகளின் இறுதியிலோ அல்லது சீர்களின் இறுதியிலோ ஒரே எழுத்து அல்லது ஓசை ஒன்றி வரத் தொடுப்பது 'இயைபுத் தொடை' ஆகும். இங்கு வரிகளின் இறுதியில் 'உம்' ஒலி ஒன்றி வந்துள்ளதால் இயைபு நயம்."}, "en": {"blocks": [{"type": "text", "content": "Identify the prosodic device (Thodai Nayam) in the lines ending with 'vasappadum', 'sirakkum', 'uyarum':"}], "options": {"A": "Monai Nayam", "B": "Edhugai Nayam", "C": "Iyaibu Nayam (End cadence consonance of 'um' across line terminations)", "D": "Muran Nayam"}, "explanation": "Textbook Page 178: Terminal rhyme across verse lines defines Iyaibu Thodai. Correct answer is C."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Tex