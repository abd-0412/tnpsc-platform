{"id": "8th-booster-q1148", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-booster-bridging", "lesson_id": "8th-booster-thirukkural", "chapter_id": null, "topic_id": "thirukkural-old-commentators-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளுக்குப் பழங்காலத்தில் உரை எழுதிய சான்றோர்களின் (உரையாசிரியர்களின்) எண்ணிக்கை எத்தனை?"}], "options": {"A": "ஐவர்", "B": "எண்மர்", "C": "பன்னிருவர்", "D": "பதின்மர் (10 பேர்)"}, "explanation": "பாடநூல் பக். 66 நூல் வெளி: 'திருக்குறளுக்குப் பழங்காலத்தில் பதின்மர் உரை எழுதியுள்ளனர். அவர்கள்: தருமர், மணக்குடவர், தாமத்தர், நச்சர், பரிதி, பரிமேலழகர், திருமலையர், மல்லர், பரிப்பெருமாள், காலிங்கர் ஆவர். இவர்களுள் பரிமேலழகர் உரையே சிறந்தது என்பர்'."}, "en": {"blocks": [{"type": "text", "content": "How many ancient commentators (Uraiyasiriyar) wrote authoritative commentaries for Thirukkural?"}], "options": {"A": "Five scholars", "B": "Eight scholars", "C": "Twelve scholars", "D": "Ten scholars (Pathinmar)"}, "explanation": "Textbook Page 66: In ancient times, ten scholars (Pathinmar) penned commentaries for Thirukkural, among which Parimelazhagar's commentary is celebrated as supreme."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 66, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "booster-thirukkural", "direct", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

