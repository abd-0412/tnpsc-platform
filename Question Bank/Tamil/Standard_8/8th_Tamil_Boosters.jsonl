{"id": "8th-booster-q1170", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u6-naadu", "lesson_id": "8th-booster-thirukkural", "chapter_id": null, "topic_id": "kural-sandhi-punarchi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கடலோடா' - இச்சொல்லின் சரியான இலக்கணக் குறிப்பைக் கண்டறிக:"}], "options": {"A": "தெரிநிலை வினையெச்சம்", "B": "ஈறுகெட்ட எதிர்மறைப் பெயரெச்சம் (கடலோடாத தேர் எனப் பெயர்ச்சொல் கொண்டு முடியும்)", "C": "வினையாலணையும் பெயர்", "D": "வியங்கோள் வினைமுற்று"}, "explanation": "பாடநூல் பக். 65: 'கடலோடா நெடுந்தேர்' - 'கடலோடாத' என்ற எதிர்மறைப் பெயரெச்சத்தின் ஈற்றுத் தகர மெய் கெட்டு 'கடலோடா' என நின்றதால் இது 'ஈறுகெட்ட எதிர்மறைப் பெயரெச்சம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the exact grammatical classification for 'Kadalodaa':"}], "options": {"A": "Direct Adverbial Participle", "B": "Negative Relative Participle with dropped terminal consonant (Eeruketta Ethirmarai Peyarecham)", "C": "Participial Noun", "D": "Optative Finite Verb"}, "explanation": "Textbook Page 65: 'Kadalodaa' modifies 'nedundher'; the terminal 'tha' of 'kadalodaatha' has elided, making it Eeruketta Ethirmarai Peyarecham."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 65, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "booster-thirukkural", "ilakkana-kurippu", "grammar", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-booster-q1171", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-booster-thirukkural", "chapter_id": null, "topic_id": "scansion-kural-terminal-foot", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கெடும்' - திருக்குறளின் இந்த ஈற்றுச் சீர் (கடைசிச் சீர்) எந்த வாய்பாட்டின் அடிப்படையில் அமைந்துள்ளது?\nகெ/டும்"}], "options": {"A": "நாள் (நேர்)", "B": "காசு (நேர்பு)", "C": "மலர் (நிரை)", "D": "பிறப்பு (நிரைபு)"}, "explanation": "பாடநூல் பக். 65: 'கெ' (குறில்) + 'டும்' (குறில் ஒற்று) = இரண்டு குறில் எழுத்துகள் இணைந்து ஒற்றெழுத்து பெற்றுள்ளதால் இது 'நிரை' அசை ஆகும். குறள் வெண்பாவின் ஈற்றுச் சீர் நிரை அசை கொண்டு முடிந்தால் அதன் வாய்பாடு 'மலர்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "On which metrical formula (Vaaypaadu) does the terminal foot 'Gedum' conclude:\nGe/dum"}], "options": {"A": "Naal (Ner)", "B": "Kaasu (Nerbu)", "C": "Malar (Nirai)", "D": "Pirappu (Niraibu)"}, "explanation": "Textbook Page 65: 'Ge' (short) + 'dum' (short + consonant) forms a 'Nirai' unit. A Nirai terminal foot in Kural Venba yields the formula 'Malar'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 65, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "booster-thirukkural", "grammar-scansion", "eetru-seer", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-booster-q1172", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-booster-thirukkural", "chapter_id": null, "topic_id": "commentators-odd-one-out", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளுக்கு உரை எழுதிய பழைய பதின்மர் உரையாசிரியர் அல்லாத ஒருவரைத் தேர்வு செய்க:"}], "options": {"A": "மணக்குடவர்", "B": "பரிமேலழகர்", "C": "காலிங்கர்", "D": "அடியார்க்கு நல்லார் (சிலப்பதிகாரத்திற்கு உரை எழுதியவர்; திருக்குறள் பதின்மரில் இல்லை)"}, "explanation": "பாடநூல் பக். 66: பதின்மர் உரையாசிரியர்கள்: தருமர், மணக்குடவர், தாமத்தர், நச்சர், பரிதி, பரிமேலழகர், திருமலையர், மல்லர், பரிப்பெருமாள், காலிங்கர். அடியார்க்கு நல்லார் சிலப்பதிகாரத்தின் சிறந்த உரையாசிரியர்; திருக்குறள் பதின்மரில் ஒருவர் அல்லர்."}, "en": {"blocks": [{"type": "text", "content": "Identify the scholar who is NOT among the traditional ten ancient commentators (Pathinmar) of Thirukkural:"}], "options": {"A": "Manakkudavar", "B": "Parimelazhagar", "C": "Kaalingar", "D": "Adiyaarkkunallaar (Commentator of Silappadhikaaram; not in Kural Pathinmar)"}, "explanation": "Textbook Page 66: Adiyaarkkunallaar is famous for his master commentary on Silappadhikaaram, not Thirukkural. The others are part of the Pathinmar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eli