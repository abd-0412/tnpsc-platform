{"id": "8th-booster-q1287", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-booster-bridging", "lesson_id": "8th-booster-pyq", "chapter_id": null, "topic_id": "pyq-thanjavur-tamil-university-year-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "TNPSC முந்தைய ஆண்டு வினா: எம்.ஜி.ஆரால் தஞ்சைத் தமிழ்ப் பல்கலைக்கழகம் தோற்றுவிக்கப்பட்ட ஆண்டு எது?"}], "options": {"A": "1977", "B": "1979", "C": "1981", "D": "1984"}, "explanation": "TNPSC Group 4 (2022) & பாடநூல் பக். 125: தஞ்சைத் தமிழ்ப் பல்கலைக்கழகம் எம்.ஜி.ஆரால் 1981-ஆம் ஆண்டு நிறுவப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "TNPSC PYQ: In which year was the Tamil University at Thanjavur established by MGR?"}], "options": {"A": "1977", "B": "1979", "C": "1981", "D": "1984"}, "explanation": "TNPSC Group 4 (2022) & Textbook Page 125: Thanjavur Tamil University was founded by MGR in the year 1981."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 125, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": f