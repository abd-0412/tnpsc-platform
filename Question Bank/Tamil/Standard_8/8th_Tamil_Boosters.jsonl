{"id": "8th-booster-q1231", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-booster-grammar", "chapter_id": null, "topic_id": "yappu-elements-count-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "செய்யுள் இயற்றுவதற்குரிய யாப்பிலக்கணத்தின் உறுப்புகள் எத்தனை வகைப்படும்?"}], "options": {"A": "நான்கு", "B": "ஐந்து", "C": "ஆறு (எழுத்து, அசை, சீர், தளை, அடி, தொடை)", "D": "எட்டு"}, "explanation": "பாடநூல் பக். 177: செய்யுளை இயற்றும் யாப்பிலக்கண உறுப்புகள் ஆறு வகைப்படும் (எழுத்து, அசை, சீர், தளை, அடி, தொடை)."}, "en": {"blocks": [{"type": "text", "content": "How many limbs/elements constitute the prosodic framework (Yappu) in Tamil poetry?"}], "options": {"A": "Four", "B": "Five", "C": "Six (Eluthu, Asai, Seer, Thalai, Adi, Thodai)", "D": "Eight"}, "explanation": "Textbook Page 177: Tamil prosody establishes exactly six limbs (Eluthu, Asai, Seer, Thalai, Adi, Thodai)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 177, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "pr