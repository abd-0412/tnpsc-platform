{"id": "8th-u3-q331", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u3-kalvi", "lesson_id": "lesson-14-palthuraikkalvi", "chapter_id": null, "topic_id": "ta-8th-u3-grammar-yettukkalvi-valinam-miguthal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஏட்டுக்கல்வி' என்னும் சொல்லில் வல்லினம் மிகுதற்கான சரியான இலக்கண விதியைக் கண்டறிக:"}], "options": {"A": "இரண்டாம் வேற்றுமைத் தொகையில் வல்லினம் மிகும்", "B": "உரிச்சொல்லின் பின் வல்லினம் மிகும்", "C": "வன்தொடர்க் குற்றியலுகரத்தின் பின் வரும் வல்லினம் மிகும்", "D": "திசைப் பெயர்களின் பின் வரும் வல்லினம் மிகும்"}, "explanation": "பாடநூல் பக்கம் 52: 'ஏடு + கல்வி' என்பதில் நிலைமொழி வன்தொடர்க் குற்றியலுகரத் திரிபாக 'ஏட்டு' என நிற்க, வருமொழி முதல் ககரம் வர 'வன்தொடர்க் குற்றியலுகரத்தின் பின் வல்லினம் மிகும்' விதியால் 'க்' மிகுந்து 'ஏட்டுக்கல்வி' என்றானது."}, "en": {"blocks": [{"type": "text", "content": "Find the accurate grammatical rule governing the gemination of the hard stop in 'Yettukkalvi':"}], "options": {"A": "Hard stop doubles in second case compounds", "B": "Hard stop doubles after Urichchol", "C": "Hard stop geminates after Vanthodark Kuttiyalugaram ('ஏடு' -> 'ஏட்டு')", "D": "Hard stop doubles after directional nouns"}, "explanation": "Textbook page 52: 'ஏட்டு' functions as a Vanthodark Kuttiyalugaram base. Following hard consonant 'ka', the stop doubles into 'kk'. Option C correctly states this rule."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["grammar", "vallinam_miguthal", "sandhi_rules"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u3-q332", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u3-kalvi", "lesson_id": "lesson-14-palthuraikkalvi", "chapter_id": null, "topic_id": "ta-8th-u3-odd-thiruvika-works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திரு.வி. கலியாணசுந்தரனார் இயற்றிய நூல்களுள் பொருந்தாத தவறான ஒன்றைக் கண்டறிக:"}], "options": {"A": "மனித வாழ்க்கையும் காந்தியடிகளும்", "B": "பெண்ணின் பெருமை", "C": "முருகன் அல்லது அழகு", "D": "அழகின் சிரிப்பு"}, "explanation": "பாடநூல் பக்கம் 54: 'அழகின் சிரிப்பு' என்பது பாவேந்தர் பாரதிதாசன் இயற்றிய புகழ்பெற்ற நூலாகும்; திரு.வி.க. இயற்றியது அன்று. திரு.வி.க. இயற்றியது 'முருகன் அல்லது அழகு' ஆகும். எனவே D பொருந்தாத ஒன்றாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the work that was NOT authored by Thiru. Vi. Kalyanasundaranar:"}], "options": {"A": "மனித வாழ்க்கையும் காந்தியடிகளும்", "B": "பெண்ணின் பெருமை", "C": "முருகன் அல்லது அழகு", "D": "அழகின் சிரிப்பு"}, "explanation": "Textbook page 54: 'Azhagin Sirippu' was authored by Bharathidasan, not Thiru. Vi. Ka. (who wrote 'Murugan Allathu Azhagu'). Option D is the odd one out."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Servi