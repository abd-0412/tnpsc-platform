{"id": "8th-u3-q328", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u3-kalvi", "lesson_id": "lesson-14-palthuraikkalvi", "chapter_id": null, "topic_id": "ta-8th-u3-grammar-valarchi-vaayil-compound", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குலோத்துங்கன் கவிதையில் வரும் 'வளர்ச்சி வாயில்' என்னும் தொடரின் இலக்கணக் குறிப்பைக் கண்டறிக:"}], "options": {"A": "இரண்டாம் வேற்றுமைத் தொகை", "B": "பண்புத்தொகைத் தொடர்", "C": "வினைத்தொகை", "D": "ஆறாம் வேற்றுமைத் தொகை (வளர்ச்சியினது வாயில்)"}, "explanation": "பாடநூல் பக்கம் 54 தெரிந்து தெளிவோம்: 'அது வளர்ச்சி வாயில்' என்பதில் 'வளர்ச்சியின் வாயில் / வளர்ச்சியினது வாயில்' என 'அது' என்னும் ஆறாம் வேற்றுமை உருபு மறைந்து வருவதால் இது 'ஆறாம் வேற்றுமைத் தொகை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the grammatical classification (Ilakkana Kurippu) of 'Valarchi Vaayil' from Kulothungan's verse:"}], "options": {"A": "Second case compound", "B": "Qualitative compound", "C": "Verbal compound (Vinai thogai)", "D": "Sixth case genitive compound ('வளர்ச்சியினது வாயில்')"}, "explanation": "Textbook page 54: 'வளர்ச்சி வாயில்' expands into 'வளர்ச்சியின் வாயில்' with the genitive case marker elided, classifying it as a 6th case compound (Aaraam Vetrumaith Thogai)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_el