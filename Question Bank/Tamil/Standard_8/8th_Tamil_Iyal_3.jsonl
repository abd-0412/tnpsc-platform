{"id": "8th-u3-q306", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u3-kalvi", "lesson_id": "lesson-12-paadarinthu-ozhuguthal", "chapter_id": null, "topic_id": "ta-8th-u3-odd-kalithogai-five-sections", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கலித்தொகையின் ஐந்து கலிப்பிரிவுகளுள் பொருந்தாத தவறான ஒன்றைக் கண்டறிக:"}], "options": {"A": "குறிஞ்சிக்கலி", "B": "வஞ்சிக்கலி", "C": "மருதக்கலி", "D": "நெய்தற்கலி"}, "explanation": "பாடநூல் பக்கம் 49: கலித்தொகையின் ஐந்து பிரிவுகள்: குறிஞ்சிக்கலி, முல்லைக்கலி, மருதக்கலி, நெய்தற்கலி, பாலைக்கலி ஆகும். 'வஞ்சிக்கலி' என்பது கலித்தொகையில் இல்லாத, பொருந்தாத தவறான ஒன்றாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the section that DOES NOT belong to the five divisions of Kalithogai:"}], "options": {"A": "Kurinjikkali", "B": "Vanjikkali", "C": "Maruthakkali", "D": "Neitharkali"}, "explanation": "Textbook page 49: The five sections are Kurinji, Mullai, Marutham, Neithal, and Paalai. 'Vanjikkali' does not exist in Kalithogai, making Option B the odd one out."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 49, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["odd_one_out", "kalithogai_divisions", "literature"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u3-q307", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u3-kalvi", "lesson_id": "lesson-12-paadarinthu-ozhuguthal", "chapter_id": null, "topic_id": "ta-8th-u3-direct-marai-porul-kaathal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மறைபொருளைப் பிறர் அறியாமல் காப்பது எவ்வாறு அழைக்கப்படுகிறது என நல்வழிக் கலித்தொகை கூறுகிறது?"}], "options": {"A": "அறை", "B": "சிறை", "C": "நிறை", "D": "கறை"}, "explanation": "பாடநூல் பக்கம் 48, 49 மதிப்பீடு வினா 2: 'மறைபொருளைக் காத்தல் நிறை எனப்படும்'. 'நிறை எனப்படுவது மறை பிறர் அறியாமை' என்பது பாடல் வரி."}, "en": {"blocks": [{"type": "text", "content": "According to Kalithogai, what term designates the virtue of safeguarding confidential secrets?"}], "options": {"A": "அறை", "B": "சிறை", "C": "நிறை", "D": "கறை"}, "explanation": "Textbook pages 48, 49 evaluation question 2: 'Guarding confidential secrets is termed நிறை (Nirai)'. Option C is correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 49, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["direct", "kalithogai", "virtue_definition"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u3-q308", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u3-kalvi", "lesson_id": "lesson-13-puthiyai-theettu", "chapter_id": null, "topic_id": "ta-8th-u3-direct-alangudi-somu-award", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திரைப்படப் பாடல் ஆசிரியரான ஆலங்குடி சோமு தமிழ்நாடு அரசிடமிருந்து பெற்ற உயரிய விருது எது?"}], "options": {"A": "பாரதிதாசன் விருது", "B": "கலைச்செம்மல் விருது", "C": "செம்மொழி விருது", "D": "கலைமாமணி விருது"}, "explanation": "பாடநூல் பக்கம் 51 நூல் வெளி: கவிஞர் ஆலங்குடி சோமு தமிழ்நாடு அரசின் 'கலைமாமணி' விருது பெற்றவர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Which prestigious honor did the film lyricist Alangudi Somu receive from the Government of Tamil Nadu?"}], "options": {"A": "Bharathidasan Award", "B": "Kalaichemmal Award", "C": "Semmozhi Award", "D": "Kalaimamani Award"}, "explanation": "Textbook page 51 author profile: Poet Alangudi Somu was honored with the prestigious 'Kalaimamani' award by the Tamil Nadu Government."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter"