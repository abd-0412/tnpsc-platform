{"id": "8th-u8-q1113", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l4", "chapter_id": null, "topic_id": "manam-magizhchi-keduthal-grammar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மனமகிழ்ச்சி' (மனம் + மகிழ்ச்சி) என்னும் சொல்லில் நிகழ்ந்துள்ள புணர்ச்சி மாற்றம் யாது?"}], "options": {"A": "நிலைமொழி ஈற்று மகர மெய் 'ம்' மறைந்துபோன கெடுதல் விகாரம்", "B": "புதிய எழுத்துத் தோன்றிய தோன்றல் விகாரம்", "C": "ஓர் எழுத்து வேறோர் எழுத்தாகத் திரிந்த திரிதல் விகாரம்", "D": "எவ்வித மாற்றமும் இல்லாத இயல்புப் புணர்ச்சி"}, "explanation": "பாடநூல் பக். 168: மனம் + மகிழ்ச்சி = மனமகிழ்ச்சி. நிலைமொழி ஈற்றில் நின்ற 'ம்' மறைந்துபோனதால் இது 'கெடுதல் விகாரம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What phonetic modification occurs in 'Manamagizhchi' (Manam + Magizhchi)?"}], "options": {"A": "Deletion Mutation (Keduthal) where terminal consonant 'm' disappears", "B": "Insertion Mutation (Thonral)", "C": "Alternation Mutation (Thrithal)", "D": "Natural Sandhi (Iyalbu)"}, "explanation": "Textbook Page 168: Manam + Magizhchi drops the terminal consonant 'm', exemplifying Deletion Mutation (Keduthal Vikaaram)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 168, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "punarchi", "deletion-mutation", "grammar", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1114", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l4", "chapter_id": null, "topic_id": "matpaandam-thrithal-grammar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மண் + பாண்டம்' என்பதனைச் சேர்த்து எழுதும்போது ஏற்படும் சரியான புணர்ச்சி மாற்றம் யாது?"}], "options": {"A": "மண்பாண்டம் (இயல்புப் புணர்ச்சி)", "B": "மட்பாண்டம் ('ண்' மெய் 'ட்' ஆகத் திரியும் திரிதல் விகாரம்)", "C": "மண்ணப்பாண்டம் (தோன்றல் விகாரம்)", "D": "மபாண்டம் (கெடுதல் விகாரம்)"}, "explanation": "பாடநூல் பக். 168: மண் + பாண்டம் = மட்பாண்டம். 'ண்' என்னும் மெய் வல்லினம் வர 'ட்' ஆகத் திரிந்ததால் இது 'திரிதல் விகாரம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the correct sandhi modification when joining 'Mann + Paandam'?"}], "options": {"A": "Mannpaandam (Natural sandhi)", "B": "Matpaandam (Alternation mutation where 'nn' transmutes to 't')", "C": "Mannappaandam (Insertion mutation)", "D": "Mapaandam (Deletion mutation)"}, "explanation": "Textbook Page 168: Mann + Paandam = Matpaandam. The retroflex nasal 'nn' transmutes into retroflex plosive 't', demonstrating Alternation Mutation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 168, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "punarchi", "thrithal-rules", "grammar", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1115", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l4", "chapter_id": null, "topic_id": "thaan-thaam-correction-grammar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மாணவர்கள் தான் போட்டியில் வென்றார்கள்' - இத்தொடரில் உள்ள வழுவை நீக்கிய சரியான தொடர் எது?"}], "options": {"A": "மாணவர்கள் தானே போட்டியில் வென்றார்கள்", "B": "மாணவர்கள் தானா போட்டியில் வென்றார்கள்", "C": "மாணவர்கள் தாம் போட்டியில் வென்றார்கள் ('மாணவர்கள்' பன்மை என்பதால் 'தாம்' வர வேண்டும்)", "D": "மாணவர் தாம் போட்டியில் வென்றார்கள்"}, "explanation": "பாடநூல் பக். 170: 'தான்' ஒருமைக்கும், 'தாம்' பன்மைக்கும் உரியன. 'மாணவர்கள்' என்பது பன்மைப் பெயர் என்பதால் 'மாணவர்கள் தாம் போட்டியில் வென்றார்கள்' என்று எழுதுவதே வழுவற்ற தூய தொடராகும்."}, "en": {"blocks": [{"type": "text", "content": "'Maanavargal thaan pottiyil venraargal' - Which is the grammatically rectified sentence removing the usage error?"}], "options": {"A": "Maanavargal thaanae pottiyil venraargal", "B": "Maanavargal thaanaa pottiyil venraargal", "C": "Maanavargal thaam pottiyil venraargal (since subject is plural, 'thaam' must be used)", "D": "Maanavar thaam pottiyil venraargal"}, "explanation": "Textbook Page 170: 'Thaan' is singular and 'Thaam' is plural. For plural subject 'Maanavargal', 'thaam' is the accurate particle."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 170, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "thaan-thaam", "error-correction", "grammar", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1116", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u6-naadu", "lesson_id": "8th-u8-l4", "chapter_id": null, "topic_id": "iyalbu-punarchi-odd-one", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் புணர்ச்சிச் சொற்களுள் இயல்புப் புணர்ச்சி அல்லாத - பொருந்தாத சொல் எது?"}], "options": {"A": "தாய்மொழி (தாய் + மொழி)", "B": "பல்பொடி (பல் + பொடி)", "C": "உடலோம்பல் (உடல் + ஓம்பல்)", "D": "தமிழ்த்தாய் (தமிழ் + தாய்; இது தோன்றல் விகாரப் புணர்ச்சி)"}, "explanation": "பாடநூல் பக். 167-168: தாய்மொழி, பல்பொடி, உடலோம்பல் ஆகிய மூன்றும் இயல்புப் புணர்ச்சிச் சொற்கள். 'தமிழ்த்தாய்' என்பதில் 'த்' தோன்றியதால் அது தோன்றல் விகாரப் புணர்ச்சியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following compounds is NOT a Natural Sandhi (Iyalbup Punarchi) (Odd one out)?"}], "options": {"A": "Thaaimozhi (Thaai + Mozhi)", "B": "Palpodi (Pal + Podi)", "C": "Udaloombal (Udal + Oombal)", "D": "Thamizhthaai (Thamizh + Thaai; Odd one out - Insertion Mutation Sandhi)"}, "explanation": "Textbook Pages 167-168: Thaaimozhi, Palpodi, and Udaloombal are natural sandhi. Thamizhthaai inserts 'th', making it Mutation Sandhi (Odd one out)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 167, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "punarchi", "odd-one-out", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1117", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u7-aram", "lesson_id": "8th-u8-l4", "chapter_id": null, "topic_id": "thonral-vikaaram-odd-one", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் விகாரப் புணர்ச்சிச் சொற்களுள் தோன்றல் விகாரம் அல்லாத - பொருந்தாத சொல் எது?"}], "options": {"A": "விற்கொடி (வில் + கொடி; இது திரிதல் விகாரம் ஆகும்)", "B": "தமிழ்த்தாய் (தமிழ் + தாய்)", "C": "தலைக்கோல் (தலை + கோல்)", "D": "படிப்பறிவு (படிப்பு + அறிவு வழியில் க் தோன்றுதல்)"}, "explanation": "பாடநூல் பக். 168: 'விற்கொடி' (வில் + கொடி) என்பதில் 'ல்' 'ற்' ஆகத் திரிந்ததால் அது திரிதல் விகாரம் ஆகும். மற்றவை தோன்றல் விகாரச் சான்றுகளாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following is NOT an Insertion Mutation (Thonral Vikaaram) (Odd one out)?"}], "options": {"A": "Virkodi (Vil + Kodi; Odd one out - Alternation Mutation)", "B": "Thamizhthaai (Thamizh + Thaai)", "C": "Thalaikkool (Thalai + Kool)", "D": "Padipparivu"}, "explanation": "Textbook Page 168: In Virkodi, 'l' alternates to 'r', making it Alternation Mutation, not Insertion. Hence (A) is the odd one out."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 168, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "punarchi", "mutation-odd-one", "odd-one-out", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1118", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u4-kalai", "lesson_id": "8th-u8-l4", "chapter_id": null, "topic_id": "kalaisorkkal-odd-pair-iyal8", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கலைச்சொற்கள் இணையில் தவறாகப் பொருத்தப்பட்டுள்ள பொருந்தாத இணை எது?"}], "options": {"A": "Objective - குறிக்கோள்", "B": "Agreement - அரசியலமைப்பு (தவறான இணை; Agreement என்பது ஒப்பந்தம், Constitution என்பது அரசியலமைப்பு)", "C": "University - பல்கலைக்கழகம்", "D": "Double voting - இரட்டை வாக்குரிமை"}, "explanation": "பாடநூல் பக். 173: Agreement என்பதன் சரியான தமிழாக்கம் 'ஒப்பந்தம்' ஆகும். 'அரசியலமைப்பு' என்பது Constitution என்பதன் தமிழாக்கமாகும். எனவே (ஆ) தவறான இணை."}, "en": {"blocks": [{"type": "text", "content": "Which of the following vocabulary translation pairs is INCORRECT (Odd one out)?"}], "options": {"A": "Objective - Kurikkol", "B": "Agreement - Arasiyalamaippu (Incorrect; Agreement = Oppantham, Constitution = Arasiyalamaippu)", "C": "University - Palgalaikkazhagam", "D": "Double voting - Irattai Vaakkurimai"}, "explanation": "Textbook Page 173: Agreement translates as Oppantham. Constitution translates as Arasiyalamaippu. Option (B) is the mismatched pair."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 173, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "kalaisorkkal", "odd-pair", "odd-one-out", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1119", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u6-naadu", "lesson_id": "8th-u8-l4", "chapter_id": null, "topic_id": "punarchi-definition-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நிலைமொழியின் இறுதி எழுத்தும் வருமொழியின் முதல் எழுத்தும் இணைவது எவ்வாறு அழைக்கப்படும்?"}], "options": {"A": "ஆகுபெயர்", "B": "வேற்றுமை", "C": "புணர்ச்சி", "D": "அணி"}, "explanation": "பாடநூல் பக். 167: நிலைமொழி ஈறும் வருமொழி முதலும் இணைவதைப் 'புணர்ச்சி' என்கிறோம்."}, "en": {"blocks": [{"type": "text", "content": "What is the linguistic process of coalescing the final letter of a base word with the initial letter of an incoming word called?"}], "options": {"A": "Aagupeyar", "B": "Vetrrumai", "C": "Punarchi (Sandhi)", "D": "Ani"}, "explanation": "Textbook Page 167: The combination of the final letter of Nilaimozhi and the initial letter of Varumozhi is defined as 'Punarchi'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 167, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year"