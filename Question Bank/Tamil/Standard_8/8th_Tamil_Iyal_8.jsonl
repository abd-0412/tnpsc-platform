// பாடம் 2: சட்டமேதை அம்பேத்கர் பகுதி 2 (வட்டமேசை மாநாடுகள், பூனா ஒப்பந்தம், அரசியலமைப்பு, பௌத்தம் & பாரத ரத்னா) [Q1037 - Q1064]
// இலண்டன் வட்டமேசை மாநாடுகள் (1930-1932), இரட்டைமலை சீனிவாசன், காந்தியடிகள் உண்ணாவிரதம், பூனா ஒப்பந்தம் (1932), சுதந்திர இந்தியாவின் முதல் சட்ட அமைச்சர், இந்திய அரசியலமைப்பு வரைவுக்குழு தலைவர், பௌத்த சமயம் தழுவுதல், 1990 பாரத ரத்னா விருது
// ==============================================================================
{"id": "8th-u8-q1037", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "round-table-conference-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலண்டன் வட்டமேசை மாநாடு குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. இந்தியர்களுக்கு அரசியல் உரிமை வழங்குவது பற்றி முடிவு செய்ய 1930 நவம்பரில் இலண்டனில் முதல் வட்டமேசை மாநாடு நடந்தது.\n2. இம்மாநாட்டில் தமிழகத்தின் சார்பில் இரட்டைமலை சீனிவாசனும் அம்பேத்கருடன் இணைந்து ஒடுக்கப்பட்ட மக்களின் குரலாக முழங்கினார்.\n3. 'என் மக்களுக்கு என்ன கிடைக்க வேண்டுமோ அதற்காகப் போராடுவேன்; அதே சமயம் சுயராஜ்ய கோரிக்கைகளை முழு மனத்துடன் ஆதரிப்பேன்' என்று அம்பேத்கர் கூறினார்.\n4. ஒடுக்கப்பட்டோரின் அரசியல் பிரதிநிதித்துவத்திற்காக அம்பேத்கர் சர்வதேச அளவில் குரல் கொடுத்த வரலாற்று நிகழ்வு இதுவாகும்."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 2 மட்டும் சரி; 3, 4 தவறு", "C": "1, 3, 4 மட்டும் சரி; 2 தவறு", "D": "2, 3, 4 மட்டும் சரி; 1 தவறு"}, "explanation": "பாடநூல் பக். 160: 1930 முதல் வட்டமேசை மாநாடு; தமிழகத்தின் இரட்டைமலை சீனிவாசனும் அம்பேத்கரும் குரல் கொடுத்தமை; சுயராஜ்ய ஆதரவு மற்றும் மக்கள் உரிமை முழக்கம். நான்கு கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding the London Round Table Conferences:\n1. To deliberate on granting political rights to Indians, the First Round Table Conference was convened in London in November 1930.\n2. Representing Tamil Nadu, Rettamalai Srinivasan stood alongside Ambedkar, roaring as the voice of the depressed classes.\n3. Ambedkar proclaimed: 'Whatever is rightfully due to my people, I shall battle for; simultaneously, I shall wholeheartedly support Swaraj'.\n4. This served as a historic global forum where Ambedkar articulated the constitutional representation of marginalized communities."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "Only 1, 2 are correct; 3, 4 are incorrect", "C": "Only 1, 3, 4 are correct; 2 is incorrect", "D": "Only 2, 3, 4 are correct; 1 is incorrect"}, "explanation": "Textbook Page 160: All four statements regarding the 1930 London Round Table Conference, Rettamalai Srinivasan's joint participation, and Ambedkar's quote are accurate."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "round-table-conference", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1038", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "poona-pact-details-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பூனா ஒப்பந்தம் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. இரண்டாவது வட்டமேசை மாநாட்டில் ஒடுக்கப்பட்டோருக்குத் தனி வாக்குரிமையும் விகிதாச்சாரப் பிரதிநிதித்துவமும் வேண்டும் என அம்பேத்கர் வலியுறுத்தினார்.\n2. இதன் விளைவாக பொது வேட்பாளருக்கு ஒரு வாக்கு, ஒடுக்கப்பட்ட வேட்பாளருக்கு ஒரு வாக்கு என 'இரட்டை வாக்குரிமை' வழங்கப்பட்டது.\n3. இரட்டை வாக்குரிமையை காந்தியடிகள் முழு மனத்துடன் வரவேற்று உடனடியாக ஏற்றுக்கொண்டார்.\n4. காந்தியடிகளின் உண்ணாவிரதத்தை அடுத்து 1931 செப்டம்பர் 24-இல் ஏற்பட்ட பூனா ஒப்பந்தப்படி, தனி வாக்குரிமைக்குப் பதில் பொது வாக்கெடுப்பில் 'தனித்தொகுதி' வழங்க முடிவு செய்யப்பட்டது."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 2, 4 மட்டும் சரி; 3 தவறு (காந்தியடிகள் ஏற்க மறுத்து உண்ணாவிரதம் இருந்தார்)", "C": "1, 3, 4 மட்டும் சரி; 2 தவறு", "D": "2, 3 மட்டும் சரி; 1, 4 தவறு"}, "explanation": "பாடநூல் பக். 160: காந்தியடிகள் இரட்டை வாக்குரிமையை ஏற்க மறுத்து உண்ணாவிரதம் மேற்கொண்டார்; எனவே கூற்று 3 தவறு. இதன் முடிவாகவே 1931 செப் 24-இல் பூனா ஒப்பந்தம் உருவானது; 1, 2, 4 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements concerning the Poona Pact:\n1. At the Second Round Table Conference, Ambedkar insisted on separate electorates and proportional representation for the depressed classes.\n2. Consequently, 'Dual Voting System' was conceded, granting one vote for a general candidate and one for a depressed class candidate.\n3. Mahatma Gandhi welcomed the dual voting system wholeheartedly and accepted it immediately.\n4. Following Gandhi's fast unto death, the Poona Pact was signed on Sept 24, 1931, granting 'Reserved Seats' within joint electorates instead of separate electorates."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "Only 1, 2, 4 are correct; 3 is incorrect (Gandhi rejected it and fasted)", "C": "Only 1, 3, 4 are correct; 2 is incorrect", "D": "Only 2, 3 are correct; 1, 4 are incorrect"}, "explanation": "Textbook Page 160: Gandhi opposed separate electorates for depressed classes and undertook a fast unto death. Statement 3 is false; statements 1, 2, and 4 are true."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "poona-pact", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1039", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "independent-labour-party-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுதந்திரத் தொழிலாளர் கட்சி மற்றும் தேர்தல் வெற்றி குறித்த கூற்றுகளை ஆராய்க:\n1. 1935-ஆம் ஆண்டில் மாநில சுயாட்சி வழங்குவதற்கான இந்திய அரசாங்கச் சட்டம் நிறைவேற்றப்பட்டது.\n2. ஏழை விவசாயிகள் மற்றும் தொழிலாளர்களின் நலனைப் பாதுகாக்க அம்பேத்கர் 'சுதந்திரத் தொழிலாளர் கட்சி'யைத் தொடங்கினார்.\n3. நடைபெற்ற பொதுத்தேர்தலில் அம்பேத்கர் மட்டும் தோல்வியடைய, அவரது கட்சியின் பிற வேட்பாளர்கள் அனைவரும் வெற்றி பெற்றனர்.\n4. அத்தேர்தலில் அம்பேத்கரும் வெற்றி பெற்றதோடு, அவரது கட்சியின் வேட்பாளர்கள் பதினைந்து (15) பேரும் வெற்றி பெற்றனர்."}], "options": {"A": "1, 2, 3 அனைத்தும் சரி", "B": "1, 2 மட்டும் சரி; 3, 4 தவறு", "C": "1, 2, 4 மட்டும் சரி; 3 தவறு (அம்பேத்கரும் வெற்றி பெற்றார்)", "D": "2, 3, 4 மட்டும் சரி; 1 தவறு"}, "explanation": "பாடநூல் பக். 160: 1935 சட்டத்தின்படி நடந்த தேர்தலில் அம்பேத்கரும் வெற்றி பெற்றார்; அவரது கட்சியின் 15 வேட்பாளர்களும் வெற்றி பெற்றனர். எனவே கூற்று 3 தவறு; 1, 2, 4 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements regarding the Independent Labour Party and its electoral triumph:\n1. In 1935, the Government of India Act conferring Provincial Autonomy was enacted.\n2. To safeguard the interests of impoverished peasants and working-class labourers, Ambedkar established the 'Independent Labour Party'.\n3. In the ensuing elections, Ambedkar alone lost while all other candidates of his party triumphed.\n4. In that election, Ambedkar triumphed decisively along with fifteen (15) candidates fielded by his party."}], "options": {"A": "1, 2, 3 are correct", "B": "Only 1, 2 are correct; 3, 4 are incorrect", "C": "Only 1, 2, 4 are correct; 3 is incorrect (Ambedkar also won)", "D": "Only 2, 3, 4 are correct; 1 is incorrect"}, "explanation": "Textbook Page 160: In the elections following the 1935 Act, Ambedkar won alongside 15 candidates of his Independent Labour Party. Statement 3 is false; 1, 2, and 4 are true."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "independent-labour-party", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1040", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "drafting-committee-members-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்திய அரசியலமைப்பு வரைவுக்குழு குறித்த கூற்றுகளில் தவறான ஒன்றைத் தேர்வு செய்க:\n1. 1947-ஆம் ஆண்டு ஆகஸ்ட் திங்கள் 29-ஆம் நாள் அரசியல் நிர்ணய மன்றம் தீர்மானம் நிறைவேற்றி வரைவுக்குழுவை உருவாக்கியது.\n2. ஏழு பேர் கொண்ட இச்சட்ட வரைவுக்குழுவின் தலைவராக அம்பேத்கர் தேர்ந்தெடுக்கப்பட்டார்.\n3. இக்குழுவில் என். கோபாலசாமி, அல்லாடி கிருஷ்ணசாமி, கே.எம். முன்ஷி, சையது முகமது சாதுல்லா, என். மாதவராவ், டி.பி. கைத்தான் ஆகியோர் இடம்பெற்றனர்; ஆலோசகராக பி.என். ராவ் நியமிக்கப்பட்டார்.\n4. இக்குழு எவ்வித வெளிநாட்டுச் சட்டங்களையும் ஆராயாமல், வெறும் வாய்மொழி உரையாடல்கள் மூலம் மட்டுமே சட்டத்தை இயற்றியது."}], "options": {"A": "கூற்று 1 தவறானது", "B": "கூற்று 2 தவறானது", "C": "கூற்று 3 தவறானது", "D": "கூற்று 4 தவறானது (இங்கிலாந்து, அமெரிக்கா உள்ளிட்ட பல நாடுகளின் சட்டங்களை ஆராய்ந்தே இயற்றப்பட்டது)"}, "explanation": "பாடநூல் பக். 161: வரைவுக்குழு இங்கிலாந்து, அமெரிக்கா, அயர்லாந்து, ஆஸ்திரேலியா, கனடா, சோவியத் யூனியன், ஜெர்மனி, தென் ஆப்பிரிக்கா போன்ற பல நாடுகளின் சட்டங்களை மிக ஆழமாக ஆராய்ந்தே சட்டத்தை இயற்றியது. எனவே கூற்று 4 தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Identify the incorrect statement among the following concerning the Drafting Committee of the Indian Constitution:\n1. On August 29, 1947, the Constituent Assembly passed a resolution creating the Constitution Drafting Committee.\n2. Ambedkar was elected as the Chairman of this seven-member drafting committee.\n3. The committee included N. Gopalaswami, Alladi Krishnaswami, K.M. Munshi, Saiyid Mohd Saadulla, N. Madhava Rao, D.P. Khaitan, with B.N. Rau as Constitutional Advisor.\n4. The committee scrutinized zero foreign constitutions, drafting the supreme law purely through informal oral conversations."}], "options": {"A": "Statement 1 is incorrect", "B": "Statement 2 is incorrect", "C": "Statement 3 is incorrect", "D": "Statement 4 is incorrect (it was framed after rigorously analyzing constitutions of Britain, USA, Ireland, etc.)"}, "explanation": "Textbook Page 161: The Drafting Committee thoroughly analyzed the constitutions of Britain, USA, Ireland, Australia, Canada, USSR, Germany, and South Africa. Statement 4 is completely false."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "drafting-committee", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1041", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "constitution-submission-social-document", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அரசியலமைப்புச் சட்டம் சமர்ப்பிப்பு மற்றும் அதன் சிறப்புகள் குறித்த கூற்றுகளை ஆராய்க:\n1. அம்பேத்கர் தலைமையிலான வரைவுக்குழு தனது அறிக்கையை 1948 பிப்ரவரி 21-இல் அரசியல் நிர்ணய மன்றத்திடம் சமர்ப்பித்தது.\n2. அம்பேத்கர் உருவாக்கிய இந்த அரசியலமைப்புச் சட்டம் குடிமக்களின் உரிமைகளுக்குப் பல வழிகளில் பாதுகாப்பு அளிப்பதாக அமைந்தது.\n3. இது ஒரு 'மிகச்சிறந்த சமூக ஆவணம்' என வரலாற்று ஆசிரியர்களால் போற்றப்படுகிறது.\n4. உலகின் மிகப்பெரிய குடியரசு நாடான இந்தியாவை வழிநடத்தும் அடிப்படைச் சட்டமாக இது திகழ்கிறது."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரியான கூற்றுகள்", "B": "1, 2 மட்டும் சரி; 3, 4 தவறு", "C": "1, 3, 4 மட்டும் சரி; 2 தவறு", "D": "2, 3, 4 மட்டும் சரி; 1 தவறு"}, "explanation": "பாடநூல் பக். 161: 1948 பிப் 21 அறிக்கை சமர்ப்பிப்பு; உரிமைகள் பாதுகாப்பு; 'மிகச்சிறந்த சமூக ஆவணம்' எனப் போற்றப்படுதல். நான்கு கூற்றுகளும் நூற்படி முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements regarding the submission and distinct features of the Indian Constitution:\n1. The Drafting Committee chaired by Ambedkar submitted its draft report to the Constituent Assembly on February 21, 1948.\n2. The Constitution crafted by Ambedkar guaranteed comprehensive safeguards for fundamental citizen rights in diverse dimensions.\n3. Historians and legal luminaries venerate this Constitution as a monumental 'Social Document'.\n4. It functions as the paramount fundamental law steering India, the world's largest vibrant democracy."}], "options": {"A": "All 1, 2, 3, 4 are correct statements", "B": "Only 1, 2 are correct; 3, 4 are incorrect", "C": "Only 1, 3, 4 are correct; 2 is incorrect", "D": "Only 2, 3, 4 are correct; 1 is incorrect"}, "explanation": "Textbook Page 161: All 4 statements regarding the Feb 21, 1948 draft submission, citizen rights safeguards, and its status as a premier 'Social Document' are accurate."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "constitution-features", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1042", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "buddhism-embrace-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அம்பேத்கரின் பௌத்த சமய ஈடுபாடு குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. அம்பேத்கர் புத்த சமயக் கொள்கைகளின் மீது மிகுந்த ஈடுபாடு கொண்டார்.\n2. இலங்கையில் நடைபெற்ற புத்த துறவிகள் கருத்தரங்கிலும், உலக பௌத்த சமய மாநாடுகளிலும் கலந்து கொண்டார்.\n3. 1956-ஆம் ஆண்டு அக்டோபர் 14-ஆம் நாள் நாக்பூரில் லட்சக்கணக்கான மக்களோடு பௌத்த சமயத்தைத் தழுவினார்.\n4. இவர் எழுதிய 'புத்தரும் அவரின் தம்மமும்' என்னும் புத்தகம் இவரது மறைவுக்குப் பின் 1957-இல் வெளியானது."}], "options": {"A": "1, 2 மட்டும் சரி; 3, 4 தவறு", "B": "1, 2, 3, 4 அனைத்தும் சரியான கூற்றுகள்", "C": "1, 3, 4 மட்டும் சரி; 2 தவறு", "D": "2, 3, 4 மட்டும் சரி; 1 தவறு"}, "explanation": "பாடநூல் பக். 161: அம்பேத்கர் இலங்கை மாநாடு, 1956 அக் 14 நாக்பூர் பௌத்த ஏற்பு, 1957 'புத்தரும் அவரின் தம்மமும்' நூல் வெளியீடு ஆகியவை பாடநூலின்படி முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements concerning Ambedkar's embrace and contributions to Buddhism:\n1. Ambedkar possessed deep spiritual commitment towards the rational egalitarian doctrines of Buddhism.\n2. He participated in Buddhist monastic conferences in Sri Lanka and multiple World Buddhist Conferences.\n3. On October 14, 1956, at Nagpur, he embraced Buddhism along with hundreds of thousands of followers.\n4. His magnum opus 'The Buddha and His Dhamma' was published posthumously in 1957."}], "options": {"A": "Only 1, 2 are correct; 3, 4 are incorrect", "B": "All 1, 2, 3, 4 are correct statements", "C": "Only 1, 3, 4 are correct; 2 is incorrect", "D": "Only 2, 3, 4 are correct; 1 is incorrect"}, "explanation": "Textbook Page 161: Ambedkar's participation in Sri Lankan conferences, Nagpur deeksha on Oct 14, 1956, and posthumous 1957 publication of 'The Buddha and His Dhamma' are all historically factual."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "buddhism", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1043", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "bharat-ratna-demise-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அம்பேத்கரின் இறுதி வாழ்வு, மறைவு மற்றும் பாரத ரத்னா விருது குறித்த கூற்றுகளை ஆராய்க:\n1. விடுதலை பெற்ற இந்தியாவின் முதல் சட்ட அமைச்சராகப் பணியாற்றியவர் அம்பேத்கர் ஆவார்.\n2. ஒடுக்கப்பட்ட மக்களுக்காகத் தம் வாழ்நாள் முழுவதும் உழைத்த இவர் 1956 டிசம்பர் 6-இல் காலமானார்.\n3. இவரது மறைவுக்குப் பின் 1990-ஆம் ஆண்டு இந்திய அரசு நாட்டின் உயரிய 'பாரத ரத்னா' விருதை வழங்கியது.\n4. இவர் இறந்த உடனடியாக 1956-லேயே இவருக்கு பாரத ரத்னா விருது வழங்கப்பட்டது."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 2 மட்டும் சரி; 3, 4 தவறு", "C": "1, 2, 3 மட்டும் சரி; 4 தவறு (1990-இலேயே பாரத ரத்னா வழங்கப்பட்டது)", "D": "2, 3, 4 மட்டும் சரி; 1 தவறு"}, "explanation": "பாடநூல் பக். 158 & 161: முதல் சட்ட அமைச்சர்; 1956 டிசம்பர் 6 மறைவு; 1990-இல் பாரத ரத்னா விருது வழங்கப்பட்டது (1956-இல் அல்ல). எனவே கூற்று 4 தவறு; 1, 2, 3 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements concerning Ambedkar's final years, demise, and the Bharat Ratna conferment:\n1. Ambedkar served with distinction as the first Law Minister of Independent India.\n2. Dedicating his entire lifespan to the upliftment of the oppressed, he passed away on December 6, 1956.\n3. Posthumously, the Government of India conferred the nation's highest civilian honour 'Bharat Ratna' in 1990.\n4. Bharat Ratna was awarded immediately in 1956 upon his demise."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "Only 1, 2 are correct; 3, 4 are incorrect", "C": "Only 1, 2, 3 are correct; 4 is incorrect (Bharat Ratna was conferred in 1990)", "D": "Only 2, 3, 4 are correct; 1 is incorrect"}, "explanation": "Textbook Pages 158 & 161: Ambedkar passed away on Dec 6, 1956, and Bharat Ratna was conferred posthumously in 1990 (not 1956). Statement 4 is false; 1, 2, and 3 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "demise-honours", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1044", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "poona-pact-franchise-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): பூனா ஒப்பந்தத்தின்படி ஒடுக்கப்பட்ட மக்களுக்குத் தனி வாக்குரிமையும் தனி நாடும் வழங்கப்பட்டது.\nகாரணம் (R): இரட்டை வாக்குரிமையை காந்தியடிகள் ஏற்க மறுத்து உண்ணாவிரதம் இருந்ததால், தனி வாக்குரிமைக்குப் பதிலாகப் பொது வாக்கெடுப்பில் 'தனித்தொகுதி' வழங்குவது எனப் பூனா ஒப்பந்தத்தில் முடிவு செய்யப்பட்டது."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; சரியான விளக்கம்", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் சரியான விளக்கம் அல்ல", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி"}, "explanation": "பாடநூல் பக். 160: கூற்று (A) தவறு; பூனா ஒப்பந்தத்தில் தனி நாடு எதையும் வழங்கவில்லை; தனி வாக்குரிமையும் ரத்தாகித் தனித்தொகுதியே வழங்கப்பட்டது. காரணம் (R) முற்றிலும் சரியானது."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Under the terms of the Poona Pact, separate electorates and a separate nation were conceded to depressed classes.\nReason (R): Because Mahatma Gandhi opposed separate electorates and fasted, it was agreed in the Poona Pact to provide reserved seats within joint electorates instead of separate electorates."}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation", "B": "Both (A) and (R) are true, but (R) is not the correct explanation", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Textbook Page 160: Assertion (A) is false; no separate nation was granted, and separate electorates were replaced by reserved seats. Reason (R) is historically accurate."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "poona-pact-ar", "assertion-reason", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1045", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "constitution-father-drafting-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): பீமாராவ் ராம்ஜி அம்பேத்கர் 'இந்திய அரசியல் சாசனத்தின் தந்தை' என்று போற்றப்படுகிறார்.\nகாரணம் (R): இந்திய அரசியல் சாசன வரைவுக்குழுவின் தலைவராக விளங்கி, உலகின் பல்வேறு நாட்டுச் சட்டங்களை ஆராய்ந்து இந்திய நாட்டிற்கான மிகச்சிறந்த அரசியலமைப்புச் சட்டத்தை உருவாக்கியவர் இவரே ஆவார்."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம் ஆகும்", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் சரியான விளக்கமன்று", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி"}, "explanation": "பாடநூல் பக். 158 & 161: வரைவுக்குழுத் தலைவராக இருந்து உலகச் சட்டங்களை ஆராய்ந்து இந்திய அரசியல் சாசனத்தை உருவாக்கியதாலேயே அம்பேத்கர் 'இந்திய அரசியல் சாசனத்தின் தந்தை' எனப்படுகிறார். கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Dr. Bhimrao Ramji Ambedkar is revered as the 'Father of the Indian Constitution'.\nReason (R): Serving as the Chairman of the Constitution Drafting Committee, he analyzed global constitutions and crafted the premier supreme law for the Indian republic."}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation of (A)", "B": "Both (A) and (R) are true, but (R) is not the correct explanation of (A)", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Textbook Pages 158 & 161: As Drafting Chairman, he authored India's Constitution, rightfully earning the title 'Father of the Indian Constitution'. Both (A) and (R) are true and (R) explains (A)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 158, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "father-of-constitution", "assertion-reason", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1046", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "independent-labour-party-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 1935 இந்திய அரசாங்கச் சட்டத்தின்படி நடைபெற்ற தேர்தலில் அம்பேத்கரின் 'சுதந்திரத் தொழிலாளர் கட்சி' வேட்பாளர்கள் பதினைந்து பேர் வெற்றி பெற்றனர்.\nகாரணம் (R): சுதந்திர இந்தியாவின் முதல் சட்ட அமைச்சராக ஜவகர்லால் நேரு தலைமையிலான அரசில் அம்பேத்கர் பொறுப்பேற்றுக் கொண்டார்."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; சரியான விளக்கம்", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் சரியான விளக்கமன்று", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி"}, "explanation": "பாடநூல் பக். 160: கூற்று (A) மற்றும் காரணம் (R) இரண்டும் வரலாற்று ரீதியாகச் சரியானவை. ஆனால் 1947-இல் சட்ட அமைச்சரானது, 1935 தேர்தலில் 15 வேட்பாளர்கள் வெற்றி பெற்றதற்கான விளக்கம் அன்று. எனவே சரியான விளக்கம் அல்ல."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): In the elections held under the Government of India Act 1935, fifteen candidates of Ambedkar's Independent Labour Party triumphed.\nReason (R): Ambedkar assumed office as the first Law Minister in the cabinet of Independent India headed by Jawaharlal Nehru."}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation", "B": "Both (A) and (R) are true, but (R) is not the correct explanation", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Textbook Page 160: Both statements are factually true. However, becoming Law Minister in 1947 does not causally explain his party's 1935 provincial election victory. Hence (R) is not the explanation of (A)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "labour-party-cabinet", "assertion-reason", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1047", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "rettamalai-srinivasan-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 1930-இல் இலண்டனில் நடைபெற்ற முதலாவது வட்டமேசை மாநாட்டில் தமிழகத்தின் சார்பில் இரட்டைமலை சீனிவாசனும் அம்பேத்கருடன் இணைந்து பங்கேற்றார்.\nகாரணம் (R): இரட்டைமலை சீனிவாசன் ஆங்கிலேய அரசுக்கு ஆதரவாக மட்டுமே பேசி, ஒடுக்கப்பட்ட மக்களின் உரிமைகளைப் பற்றி மாநாட்டில் எதையும் பேசவில்லை."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி", "B": "கூற்று (A) தவறு, காரணம் (R) சரி", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு (ஒடுக்கப்பட்ட மக்களின் குரலாக முழங்கினார்)", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "பாடநூல் பக். 160 தெரிந்து தெளிவோம்: கூற்று (A) சரி. காரணம் (R) தவறு; இரட்டைமலை சீனிவாசன் அம்பேத்கரோடு இணைந்து ஒடுக்கப்பட்ட மக்களின் உரிமைக் குரலாக முழங்கினார் என்று பாடநூல் கூறுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): At the First Round Table Conference held in London in 1930, Rettamalai Srinivasan participated representing Tamil Nadu alongside Ambedkar.\nReason (R): Rettamalai Srinivasan spoke solely in favour of the British crown and completely disregarded the rights of depressed classes."}], "options": {"A": "Both (A) and (R) are true", "B": "(A) is false, but (R) is true", "C": "(A) is true, but (R) is false (he roared as the voice of the oppressed)", "D": "Both (A) and (R) are false"}, "explanation": "Textbook Page 160 Info Box: Assertion (A) is true. Reason (R) is false; Rettamalai Srinivasan joined Ambedkar as a resolute champion for depressed class rights."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "rettamalai-srinivasan", "assertion-reason", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1048", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "buddha-and-dhamma-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'புத்தரும் அவரின் தம்மமும்' என்னும் நூலை அம்பேத்கர் 1947 விடுதலை ஆண்டிலேயே அச்சில் வெளியிட்டார்.\nகாரணம் (R): அம்பேத்கர் புத்த சமயம் தொடர்பாக எழுதிய 'புத்தரும் அவரின் தம்மமும்' என்னும் புத்தகம் அவரது மறைவுக்குப் பின் 1957-ஆம் ஆண்டிலேயே வெளியானது."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; சரியான விளக்கம்", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் சரியான விளக்கம் அல்ல", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி"}, "explanation": "பாடநூல் பக். 161: கூற்று (A) தவறு; 1947-இல் இந்நூல் வெளிவரவில்லை. காரணம் (R) சரி; அம்பேத்கர் 1956 டிசம்பரில் மறைந்த பின் 1957-ஆம் ஆண்டிலேயே 'புத்தரும் அவரின் தம்மமும்' நூல் வெளியானது."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Ambedkar published his book 'The Buddha and His Dhamma' in print during the Independence year of 1947.\nReason (R): Ambedkar's authoritative treatise 'The Buddha and His Dhamma' was published posthumously in the year 1957."}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation", "B": "Both (A) and (R) are true, but (R) is not the correct explanation", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Textbook Page 161: Assertion (A) is false; it was not published in 1947. Reason (R) is true; 'The Buddha and His Dhamma' was published posthumously in 1957."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "buddha-and-dhamma", "assertion-reason", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1049", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "constitution-social-document-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): அம்பேத்கரால் உருவாக்கப்பட்ட இந்திய அரசியலமைப்புச் சட்டம் வரலாற்று ஆசிரியர்களால் 'மிகச்சிறந்த சமூக ஆவணம்' எனப் போற்றப்படுகிறது.\nகாரணம் (R): பலதரப்பட்ட இனம், மொழி, சமயம் சார்ந்த இந்திய மக்களை ஒருங்கிணைத்து அவர்களின் அடிப்படை உரிமைகளுக்குப் பல வழிகளில் உத்திரவாதமும் பாதுகாப்பும் அளிப்பதாக இச்சட்டம் அமைந்துள்ளது."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம் ஆகும்", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் சரியான விளக்கமன்று", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி"}, "explanation": "பாடநூல் பக். 161: குடிமக்களின் உரிமைகளுக்குப் பல வழிகளில் பாதுகாப்பு அளித்து சமூக நீதியை நிலைநாட்டுவதாலேயே இது 'மிகச்சிறந்த சமூக ஆவணம்' எனப்படுகிறது. கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): The Indian Constitution framed by Ambedkar is venerated by historians as an exemplary 'Social Document'.\nReason (R): It integrates diverse linguistic, ethnic, and religious demographics, guaranteeing multifaceted constitutional protection for fundamental human rights."}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation of (A)", "B": "Both (A) and (R) are true, but (R) is not the correct explanation of (A)", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Textbook Page 161: Because it guarantees citizens' rights and establishes social justice across pluralistic demographics, it is hailed as a great social document. Both (A) and (R) are true and (R) explains (A)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "social-document", "assertion-reason", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1050", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u8-manitham", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "ambedkar-chronology-match-2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அம்பேத்கர் வாழ்வின் பிற்கால வரலாற்று ஆண்டுகளையும் நிகழ்வுகளையும் பொருத்துக:\nபட்டியல் I:\nஅ) 1930\nஆ) 1931 (செப் 24)\nஇ) 1935\nஈ) 1948 (பிப் 21)\nபட்டியல் II:\n1. பூனா ஒப்பந்தம் கையெழுத்தாதல்\n2. முதலாவது வட்டமேசை மாநாடு மற்றும் நாசிக் கோவில் நுழைவுப் போராட்டம்\n3. அரசியலமைப்பு வரைவுக்குழு அறிக்கை சமர்ப்பித்தல்\n4. சுதந்திரத் தொழிலாளர் கட்சி தொடங்குதல்"}], "options": {"A": "அ-1, ஆ-2, இ-3, ஈ-4", "B": "அ-2, ஆ-1, இ-4, ஈ-3", "C": "அ-2, ஆ-4, இ-1, ஈ-3", "D": "அ-4, ஆ-1, இ-2, ஈ-3"}, "explanation": "பாடநூல் பக். 160-161: 1930 - வட்டமேசை மாநாடு / நாசிக் போராட்டம் (2); 1931 செப் 24 - பூனா ஒப்பந்தம் (1); 1935 - சுதந்திரத் தொழிலாளர் கட்சி (4); 1948 பிப் 21 - வரைவுக்குழு அறிக்கை சமர்ப்பிப்பு (3). சரியான வரிசை: 2, 1, 4, 3."}, "en": {"blocks": [{"type": "text", "content": "Match the significant later years in Ambedkar's life with their historic events:\nList I:\na) 1930\nb) 1931 (Sept 24)\nc) 1935\nd) 1948 (Feb 21)\nList II:\n1. Signing of the historic Poona Pact\n2. First Round Table Conference and Nasik temple entry movement\n3. Submission of Draft Constitution report\n4. Founding of the Independent Labour Party"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-2, b-4, c-1, d-3", "D": "a-4, b-1, c-2, d-3"}, "explanation": "Textbook Pages 160-161: 1930 - Round Table / Nasik (2); 1931 Sept 24 - Poona Pact (1); 1935 - Labour Party (4); 1948 Feb 21 - Draft Constitution report (3). Sequence: 2, 1, 4, 3."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "events-dates", "matching", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1051", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "drafting-committee-roles-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்திய அரசியலமைப்பு உருவாக்கத்தில் பங்கேற்ற ஆளுமைகளையும் அவர்தம் பொறுப்புகளையும் பொருத்துக:\nபட்டியல் I:\nஅ) டாக்டர் பி.ஆர். அம்பேத்கர்\nஆ) பி.என். ராவ்\nஇ) ஜவகர்லால் நேரு\nஈ) அல்லாடி கிருஷ்ணசாமி, கே.எம். முன்ஷி\nபட்டியல் II:\n1. இடைக்கால அரசின் பிரதமர்\n2. வரைவுக்குழுவின் உறுப்பினர்கள்\n3. சட்ட வரைவுக்குழுவின் தலைவர்\n4. அரசியலமைப்புச் சட்ட ஆலோசகர்"}], "options": {"A": "அ-1, ஆ-4, இ-2, ஈ-3", "B": "அ-3, ஆ-1, இ-4, ஈ-2", "C": "அ-3, ஆ-4, இ-1, ஈ-2", "D": "அ-4, ஆ-3, இ-1, ஈ-2"}, "explanation": "பாடநூல் பக். 160-161: அம்பேத்கர் - வரைவுக்குழு தலைவர் (3); பி.என். ராவ் - சட்ட ஆலோசகர் (4); நேரு - இடைக்கால அரசு பிரதமர் (1); அல்லாடி, முன்ஷி - வரைவுக்குழு உறுப்பினர்கள் (2). சரியான வரிசை: 3, 4, 1, 2."}, "en": {"blocks": [{"type": "text", "content": "Match the key historical figures of the Indian Constitution with their responsibilities:\nList I:\na) Dr. B.R. Ambedkar\nb) B.N. Rau\nc) Jawaharlal Nehru\nd) Alladi Krishnaswami, K.M. Munshi\nList II:\n1. Prime Minister of the Interim Government\n2. Members of the Drafting Committee\n3. Chairman of the Constitution Drafting Committee\n4. Constitutional Advisor"}], "options": {"A": "a-1, b-4, c-2, d-3", "B": "a-3, b-1, c-4, d-2", "C": "a-3, b-4, c-1, d-2", "D": "a-4, b-3, c-1, d-2"}, "explanation": "Textbook Pages 160-161: Ambedkar - Drafting Chairman (3); B.N. Rau - Advisor (4); Nehru - Prime Minister (1); Alladi, Munshi - Committee Members (2). Sequence: 3, 4, 1, 2."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "constitution-roles", "matching", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1052", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u8-manitham", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "ambedkar-historic-locations-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அம்பேத்கரின் வரலாற்று நிகழ்வுகளையும் அவை நடைபெற்ற நகரங்களையும் பொருத்துக:\nபட்டியல் I:\nஅ) முதலாவது வட்டமேசை மாநாடு\nஆ) கோவில் நுழைவுப் போராட்டம்\nஇ) பௌத்த சமயம் தழுவுதல் (1956)\nஈ) எல்பின்ஸ்டன் உயர்நிலைப் பள்ளி\nபட்டியல் II:\n1. மும்பை\n2. நாக்பூர்\n3. நாசிக்\n4. இலண்டன்"}], "options": {"A": "அ-1, ஆ-2, இ-3, ஈ-4", "B": "அ-4, ஆ-2, இ-3, ஈ-1", "C": "அ-4, ஆ-1, இ-2, ஈ-3", "D": "அ-4, ஆ-3, இ-2, ஈ-1"}, "explanation": "பாடநூல் பக். 159-161: வட்டமேசை மாநாடு - இலண்டன் (4); கோவில் நுழைவுப் போராட்டம் - நாசிக் (3); பௌத்த தழுவல் - நாக்பூர் (2); எல்பின்ஸ்டன் பள்ளி - மும்பை (1). சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": "Match Ambedkar's historic milestones with the cities where they took place:\nList I:\na) First Round Table Conference\nb) Temple Entry Agitation (1930)\nc) Conversion to Buddhism (1956)\nd) Elphinstone High School\nList II:\n1. Mumbai\n2. Nagpur\n3. Nasik\n4. London"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-4, b-2, c-3, d-1", "C": "a-4, b-1, c-2, d-3", "D": "a-4, b-3, c-2, d-1"}, "explanation": "Textbook Pages 159-161: Round Table - London (4); Temple Entry - Nasik (3); Buddhist Deeksha - Nagpur (2); Elphinstone - Mumbai (1). Matching order: 4, 3, 2, 1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "cities-events", "matching", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1053", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u8-manitham", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "ambedkar-publications-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அம்பேத்கரின் வெளியீடுகளையும் அவற்றின் தன்மைகளையும் பொருத்துக:\nபட்டியல் I:\nஅ) புத்தரும் அவரின் தம்மமும்\nஆ) ஒடுக்கப்பட்ட பாரதம்\nஇ) இந்தியாவில் சாதிகளின் தோற்றமும் வளர்ச்சியும்\nஈ) ரூபாய் பற்றிய பிரச்சனை\nபட்டியல் II:\n1. மறைவுக்குப் பின் 1957-இல் வெளியான பௌத்த சமய நூல்\n2. 1927-இல் தொடங்கப்பட்ட தமிழ்ப்பெயர் கொண்ட சமூக இதழ்\n3. அச்சில் வெளிவந்த முதல் சிறு புத்தகம்\n4. இலண்டனில் முனைவர் பட்டம் பெற்றுத் தந்த ஆய்வேடு"}], "options": {"A": "அ-1, ஆ-2, இ-3, ஈ-4", "B": "அ-2, ஆ-1, இ-4, ஈ-3", "C": "அ-3, ஆ-4, இ-1, ஈ-2", "D": "அ-1, ஆ-3, இ-2, ஈ-4"}, "explanation": "பாடநூல் பக். 159-161: புத்தரும் அவரின் தம்மமும் - 1957 நூல் (1); ஒடுக்கப்பட்ட பாரதம் - 1927 இதழ் (2); சாதிகளின் தோற்றமும் வளர்ச்சியும் - முதல் சிறுபுத்தகம் (3); ரூபாய் பற்றிய பிரச்சனை - இலண்டன் ஆய்வேடு (4). நேரடிப் பொருத்தம்: 1, 2, 3, 4."}, "en": {"blocks": [{"type": "text", "content": "Match Ambedkar's publications with their bibliographic nature:\nList I:\na) The Buddha and His Dhamma\nb) Bahishkrit Bharat (Odukkappatta Bharatham)\nc) Castes in India: Genesis & Development\nd) The Problem of the Rupee\nList II:\n1. Buddhist treatise published posthumously in 1957\n2. Consciousness journal founded in 1927\n3. First printed monograph/booklet\n4. Doctoral dissertation submitted in London"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-3, b-4, c-1, d-2", "D": "a-1, b-3, c-2, d-4"}, "explanation": "Textbook Pages 159-161: Buddha & Dhamma - 1957 (1); Bahishkrit Bharat - 1927 (2); Castes in India - first book (3); Problem of Rupee - London thesis (4). Sequence: 1, 2, 3, 4."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "publications", "matching", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1054", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "foreign-constitutions-studied-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அரசியலமைப்புச் சட்டம் இயற்ற அம்பேத்கர் ஆராய்ந்த நாடுகளையும் அவற்றின் கூறுகளையும் பொருத்துக:\nபட்டியல் I:\nஅ) இங்கிலாந்து\nஆ) அமெரிக்கா\nஇ) அயர்லாந்து\nஈ) சோவியத் ஒன்றியம் (ரஷ்யா)\nபட்டியல் II:\n1. அரசு வழிகாட்டு நெறிமுறைகள்\n2. நாடாளுமன்ற ஆட்சி முறை & சட்டத்தின் ஆட்சி\n3. அடிப்படைக் கடமைகள் & சமதர்மக் கோட்பாடுகள்\n4. அடிப்படை உரிமைகள் & நீதித்துறை தன்னுரிமை"}], "options": {"A": "அ-1, ஆ-4, இ-2, ஈ-3", "B": "அ-2, ஆ-4, இ-1, ஈ-3", "C": "அ-2, ஆ-1, இ-4, ஈ-3", "D": "அ-4, ஆ-2, இ-1, ஈ-3"}, "explanation": "பாடநூல் பக். 161: இங்கிலாந்து - நாடாளுமன்ற ஆட்சிமுறை (2); அமெரிக்கா - அடிப்படை உரிமைகள் (4); அயர்லாந்து - வழிகாட்டு நெறிமுறைகள் (1); சோவியத் ஒன்றியம் - கடமைகள் (3). சரியான வரிசை: 2, 4, 1, 3."}, "en": {"blocks": [{"type": "text", "content": "Match the foreign constitutions studied by Ambedkar with their foundational contributions:\nList I:\na) Britain / United Kingdom\nb) United States of America\nc) Ireland\nd) Soviet Union (USSR)\nList II:\n1. Directive Principles of State Policy\n2. Parliamentary system and Rule of Law\n3. Fundamental Duties and Socialist ideals\n4. Fundamental Rights and Judicial Independence"}], "options": {"A": "a-1, b-4, c-2, d-3", "B": "a-2, b-4, c-1, d-3", "C": "a-2, b-1, c-4, d-3", "D": "a-4, b-2, c-1, d-3"}, "explanation": "Textbook Page 161: Britain - Parliamentary system (2); USA - Fundamental Rights (4); Ireland - Directive Principles (1); USSR - Duties (3). Sequence: 2, 4, 1, 3."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "constitutional-sources", "matching", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1055", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u8-manitham", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "ambedkar-milestones-dates-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அம்பேத்கரின் வாழ்வு நிறைவு மைல்கற்களையும் அவர்தம் ஆண்டுகளையும் பொருத்துக:\nபட்டியல் I:\nஅ) நாக்பூரில் பௌத்தம் தழுவிய நாள்\nஆ) அம்பேத்கர் மறைந்த நாள்\nஇ) 'புத்தரும் அவரின் தம்மமும்' வெளியான ஆண்டு\nஈ) இந்திய அரசு 'பாரத ரத்னா' வழங்கிய ஆண்டு\nபட்டியல் II:\n1. 1957\n2. 1990\n3. 1956 அக்டோபர் 14\n4. 1956 டிசம்பர் 6"}], "options": {"A": "அ-1, ஆ-2, இ-3, ஈ-4", "B": "அ-3, ஆ-1, இ-4, ஈ-2", "C": "அ-3, ஆ-4, இ-1, ஈ-2", "D": "அ-4, ஆ-3, இ-1, ஈ-2"}, "explanation": "பாடநூல் பக். 161: பௌத்தம் தழுவிய நாள் - 1956 அக்டோபர் 14 (3); மறைவு - 1956 டிசம்பர் 6 (4); புத்தரும் தம்மமும் - 1957 (1); பாரத ரத்னா - 1990 (2). சரியான வரிசை: 3, 4, 1, 2."}, "en": {"blocks": [{"type": "text", "content": "Match the concluding milestones of Ambedkar's journey with their dates and years:\nList I:\na) Embraced Buddhism at Nagpur\nb) Demise of Ambedkar\nc) Year 'The Buddha and His Dhamma' was published\nd) Year Bharat Ratna was conferred\nList II:\n1. 1957\n2. 1990\n3. October 14, 1956\n4. December 6, 1956"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-3, b-1, c-4, d-2", "C": "a-3, b-4, c-1, d-2", "D": "a-4, b-3, c-1, d-2"}, "explanation": "Textbook Page 161: Buddhist conversion - Oct 14, 1956 (3); Demise - Dec 6, 1956 (4); Buddha & Dhamma - 1957 (1); Bharat Ratna - 1990 (2). Sequence: 3, 4, 1, 2."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "final-milestones", "matching", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1056", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "swarajya-tamil-equivalent", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அம்பேத்கர் முழங்கிய 'சுயராஜ்யம்' என்னும் வடமொழிச் சொல்லுக்கு இணையான தூய தமிழ்ச் சொல் மற்றும் இலக்கண அமைப்பைத் தேர்வு செய்க:\nஅ) அயல்நாட்டு ஆட்சி\nஆ) முடியாட்சி முறை\nஇ) பண பலம்\nஈ) தன்னாட்சி / தன் சுயாட்சி (சுய + ராஜ்யம்; மக்கள் தங்களைத் தாங்களே ஆளும் இறையாண்மை உரிமை)"}], "options": {"A": "கருத்து (அ)", "B": "கருத்து (ஆ)", "C": "கருத்து (இ)", "D": "கருத்து (ஈ) மட்டுமே முற்றிலும் சரியானது"}, "explanation": "பாடநூல் பக். 160: சுயராஜ்யம் என்பது சுய ஆட்சி அல்லது தன்னாட்சி என்பதாகும். மக்கள் தங்களைத் தாங்களே ஆளும் தன்னுரிமையே இதன் பொருளாகும்."}, "en": {"blocks": [{"type": "text", "content": "Select the authentic Tamil equivalent and conceptual meaning for the term 'Swarajyam' spoken by Ambedkar:\na) Foreign imperial rule\nb) Monarchy\nc) Wealth dominance\nd) Thannaatchi / Suyaatchi (Self-Rule / Sovereign autonomy of citizens governing themselves)"}], "options": {"A": "Concept (a)", "B": "Concept (b)", "C": "Concept (c)", "D": "Concept (d) alone is strictly accurate"}, "explanation": "Textbook Page 160: Swarajyam equates in pure Tamil to Thannaatchi or Suyaatchi, meaning sovereign self-rule."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "political-terms", "grammar", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1057", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "arasiyalamaippu-split-grammar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'அரசியலமைப்பு' என்னும் சொல்லின் பிரித்தல் மற்றும் புணர்ச்சி விதியைத் தேர்வு செய்க:\nஅ) அரசியல் + அமைப்பு எனப் பிரியும்; 'உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே' என்னும் விதிப்படி (ல் + அ = ல) புணரும்\nஆ) அரசு + அமைப்பு எனப் பிரியும்; குற்றியலுகரப் புணர்ச்சி\nஇ) அரசிய + அமைப்பு எனப் பிரியும்; உடம்படுமெய்ப் புணர்ச்சி\nஈ) அரசியல் + நமைப்பு எனப் பிரியும்; திரிதல் விகாரம்"}], "options": {"A": "விளக்கம் (அ) மட்டுமே இலக்கணப்படி சரியானது", "B": "விளக்கம் (ஆ)", "C": "விளக்கம் (இ)", "D": "விளக்கம் (ஈ)"}, "explanation": "அரசியலமைப்பு = அரசியல் + அமைப்பு. நிலைமொழி ஈற்று மெய் 'ல்' வருமொழி முதல் உயிர் 'அ' உடன் இணைந்து 'ல' ஆகி 'அரசியலமைப்பு' என இயல்பாகப் புணர்ந்தது (உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே)."}, "en": {"blocks": [{"type": "text", "content": "Select the correct split form and sandhi rule for the compound word 'Arasiyalamaippu' (Constitution):\na) Splits into Arasiyal + Amaippu; joins as per rule 'Udalmael uyirvanthu onruvathu iyalbae' (l + a = la)\nb) Splits into Arasu + Amaippu; kurriyalugaram sandhi\nc) Splits into Arasiya + Amaippu; glide sandhi\nd) Splits into Arasiyal + Namaippu; mutation sandhi"}], "options": {"A": "Explanation (a) alone is grammatically accurate", "B": "Explanation (b)", "C": "Explanation (c)", "D": "Explanation (d)"}, "explanation": "Arasiyalamaippu = Arasiyal + Amaippu. Final consonant 'l' merges naturally with initial vowel 'a' to yield 'la'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "sandhi-analysis", "grammar", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1058", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u7-aram", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "vigithaachaaram-meaning-grammar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'விகிதாச்சாரப் பிரதிநிதித்துவம்' என்னும் சொல்லாட்சியின் சரியான தமிழ்ப் பொருள் யாது?\nஅ) அனைவருக்கும் சமமான நிதி உதவி வழங்குவது\nஆ) மக்கள் தொகையின் விகிதத்திற்கு ஏற்ப அவர்தம் சமூகத்திற்குச் சட்டமன்றங்களிலும் நிர்வாகத்திலும் உரிய இடப்பங்கீடு அளிப்பது\nஇ) அனைவருக்கும் ஒரே வகையான வரி விதிப்பது\nஈ) எந்தவிதக் கணக்கீடும் இன்றிப் பிரதிநிதிகளைத் தேர்ந்தெடுப்பது"}], "options": {"A": "பொருள் (அ)", "B": "பொருள் (ஆ) மட்டுமே மிகச் சரியானது", "C": "பொருள் (இ)", "D": "பொருள் (ஈ)"}, "explanation": "பாடநூல் பக். 160: விகிதாச்சாரப் பிரதிநிதித்துவம் என்பது மக்கள்தொகை அளவுக்கு ஏற்ப உரிய பிரதிநிதித்துவத்தை சட்டமன்றங்கள் மற்றும் அதிகார அமைப்புகளில் வழங்குவதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the precise socio-political meaning of 'Vigithaachaarap Prathinithithuvam' (Proportional Representation)?\na) Distributing equal financial loans to every citizen\nb) Allocating legislative seats and administrative representation proportionate to community population\nc) Levying identical uniform taxes on all citizens\nd) Selecting representatives randomly without demographic reckoning"}], "options": {"A": "Meaning (a)", "B": "Meaning (b) alone is strictly accurate", "C": "Meaning (c)", "D": "Meaning (d)"}, "explanation": "Textbook Page 160: Proportional Representation signifies allocating legislative representation strictly in proportion to population percentage."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "political-concepts", "grammar", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1059", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "irattai-vaakkurimai-grammar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'இரட்டை வாக்குரிமை' என்னும் தொடரின் இலக்கணக் குறிப்பு யாது?\nஅ) பண்புத்தொகை\nஆ) வினைத்தொகை\nஇ) எண் பெயர் அடங்கிய பெயரடைத் தொடர் / கூட்டுப் பெயர்\nஈ) உவமைத்தொகை"}], "options": {"A": "பண்புத்தொகை", "B": "வினைத்தொகை", "C": "எண் பெயர் அடங்கிய பெயரடைத் தொடர் / கூட்டுப் பெயர்", "D": "உவமைத்தொகை"}, "explanation": "'இரட்டை' என்பது இரண்டு என்னும் எண்ணிக்கையைக் குறிக்கும் எண் பெயரடை; வாக்குரிமை என்னும் பெயர்ச்சொல்லுடன் இணைந்து கூட்டுப் பெயர்ச்சொல்லாக (இரட்டை வாக்குரிமை) நிற்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the grammatical classification of the phrase 'Irattai Vaakkurimai' (Dual Franchise)?\na) Qualitative compound (Panputthogai)\nb) Verbal compound (Vinaitthogai)\nc) Compound noun incorporating numerical adjective (En-peyar adai)\nd) Metaphorical compound (Uvamaitthogai)"}], "options": {"A": "Qualitative compound", "B": "Verbal compound", "C": "Compound noun with numerical adjective", "D": "Metaphorical compound"}, "explanation": "'Irattai' functions as a numerical adjective signifying dual, modifying the noun franchise (vaakkurimai)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "grammar-classification", "grammar", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1060", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "drafting-committee-members-odd-one", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அம்பேத்கர் தலைமையிலான 7 பேர் கொண்ட அரசியல் சாசன வரைவுக்குழுவில் இடம்பெறாத - பொருந்தாத தலைவர் யார்?\nஅ) அல்லாடி கிருஷ்ணசாமி\nஆ) கே.எம். முன்ஷி\nஇ) என். கோபாலசாமி\nஈ) ராஜாஜி (சி. ராஜகோபாலாச்சாரி)"}], "options": {"A": "அல்லாடி கிருஷ்ணசாமி", "B": "கே.எம். முன்ஷி", "C": "என். கோபாலசாமி", "D": "ராஜாஜி (இவர் வரைவுக்குழு உறுப்பினர் அல்லர்)"}, "explanation": "பாடநூல் பக். 161: வரைவுக்குழு உறுப்பினர்கள்: அம்பேத்கர் (தலைவர்), என். கோபாலசாமி, அல்லாடி கிருஷ்ணசாமி, கே.எம். முன்ஷி, சையது முகமது சாதுல்லா, என். மாதவராவ், டி.பி. கைத்தான். ராஜாஜி இதில் இடம்பெறவில்லை."}, "en": {"blocks": [{"type": "text", "content": "Which of the following leaders was NOT a member of the 7-member Constitution Drafting Committee (Odd one out)?\na) Alladi Krishnaswami\nb) K.M. Munshi\nc) N. Gopalaswami\nd) Rajaji (C. Rajagopalachari)"}], "options": {"A": "Alladi Krishnaswami", "B": "K.M. Munshi", "C": "N. Gopalaswami", "D": "Rajaji (Odd one out - not a member of the Drafting Committee)"}, "explanation": "Textbook Page 161: The 7 Drafting Committee members were Ambedkar, Gopalaswami, Alladi, Munshi, Saadulla, Madhava Rao, and Khaitan. Rajaji was not a member."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "drafting-committee", "odd-one-out", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1061", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u8-manitham", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "ambedkar-buddhism-events-odd-one", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அம்பேத்கரின் பௌத்த சமய ஏற்பு தொடர்பான நிகழ்வுகளுள் பொருந்தாத ஒன்றைத் தேர்வு செய்க:\nஅ) 1956-இல் இலண்டன் தேம்ஸ் நதிக்கரையில் பௌத்தத்தைத் தழுவினார்\nஆ) 1956 அக்டோபர் 14-இல் நாக்பூரில் பௌத்த சமயத்தைத் தழுவினார்\nஇ) இலங்கையில் நடைபெற்ற புத்த துறவிகள் கருத்தரங்கில் கலந்து கொண்டார்\nஈ) 'புத்தரும் அவரின் தம்மமும்' என்னும் நூலை எழுதினார்"}], "options": {"A": "1956-இல் இலண்டன் தேம்ஸ் நதிக்கரையில் பௌத்தத்தைத் தழுவினார் (தவறானது; நாக்பூரிலேயே பௌத்தம் தழுவினார்)", "B": "1956 அக்டோபர் 14-இல் நாக்பூரில் பௌத்த சமயத்தைத் தழுவினார்", "C": "இலங்கையில் நடைபெற்ற புத்த துறவிகள் கருத்தரங்கில் கலந்து கொண்டார்", "D": "'புத்தரும் அவரின் தம்மமும்' என்னும் நூலை எழுதினார்"}, "explanation": "பாடநூல் பக். 161: அம்பேத்கர் பௌத்த சமயத்தைத் தழுவியது மகாராட்டிர மாநிலம் நாக்பூரில் ஆகும் (இலண்டனில் அல்ல). எனவே (அ) பொருந்தாதது."}, "en": {"blocks": [{"type": "text", "content": "Which of the following events is INCORRECT regarding Ambedkar's Buddhist affiliation (Odd one out)?\na) Embraced Buddhism on the banks of River Thames in London in 1956\nb) Embraced Buddhism at Nagpur on October 14, 1956\nc) Participated in Buddhist monk symposium in Sri Lanka\nd) Penned the magnum opus 'The Buddha and His Dhamma'"}], "options": {"A": "Embraced Buddhism on Thames bank in London (Odd one out - conversion was at Nagpur)", "B": "Embraced Buddhism at Nagpur on October 14, 1956", "C": "Participated in Buddhist monk symposium in Sri Lanka", "D": "Penned the magnum opus 'The Buddha and His Dhamma'"}, "explanation": "Textbook Page 161: Ambedkar embraced Buddhism at Nagpur (not London). Hence option (a) is the odd one out."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "buddhism-nagpur", "odd-one-out", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1062", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "constitutional-countries-odd-one", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அம்பேத்கர் தலைமையிலான வரைவுக்குழு ஆராய்ந்த உலக நாடுகளின் அரசியலமைப்புகளுள் பாடநூலில் குறிப்பிடப்படாத - பொருந்தாத நாடு எது?\nஅ) இங்கிலாந்து & அமெரிக்கா\nஆ) சீனா & வடகொரியா\nஇ) அயர்லாந்து & ஆஸ்திரேலியா\nஈ) கனடா & தென் ஆப்பிரிக்கா"}], "options": {"A": "இங்கிலாந்து & அமெரிக்கா", "B": "சீனா & வடகொரியா (இவ்விரு நாடுகளின் சட்டங்களை வரைவுக்குழு ஆராயவில்லை)", "C": "அயர்லாந்து & ஆஸ்திரேலியா", "D": "கனடா & தென் ஆப்பிரிக்கா"}, "explanation": "பாடநூல் பக். 161: இங்கிலாந்து, அமெரிக்கா, அயர்லாந்து, ஆஸ்திரேலியா, கனடா, சோவியத் யூனியன், ஜெர்மனி, தென் ஆப்பிரிக்கா ஆகிய நாடுகளின் சட்டங்களே ஆராயப்பட்டன. சீனா, வடகொரியா அதில் இல்லை."}, "en": {"blocks": [{"type": "text", "content": "Which of the following countries is NOT listed in the textbook as studied by the Drafting Committee (Odd one out)?\na) Britain and USA\nb) China and North Korea\nc) Ireland and Australia\nd) Canada and South Africa"}], "options": {"A": "Britain and USA", "B": "China and North Korea (Odd one out - not part of researched constitutions)", "C": "Ireland and Australia", "D": "Canada and South Africa"}, "explanation": "Textbook Page 161: Constitutions of UK, USA, Ireland, Australia, Canada, USSR, Germany, and South Africa were studied. China and North Korea are not on the list."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "constitutional-countries", "odd-one-out", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1063", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "first-law-minister-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "விடுதலை பெற்ற இந்தியாவின் முதல் சட்ட அமைச்சராகப் பணியாற்றியவர் யார்?"}], "options": {"A": "டாக்டர் இராதாகிருஷ்ணன்", "B": "ஜவகர்லால் நேரு", "C": "டாக்டர் பி.ஆர். அம்பேத்கர்", "D": "சர்தார் வல்லபாய் படேல்"}, "explanation": "பாடநூல் பக். 158 & 162: விடுதலை பெற்ற இந்தியாவின் முதல் சட்ட அமைச்சராக விளங்கியவர் பீமாராவ் ராம்ஜி அம்பேத்கர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who served as the very first Law Minister of Independent India?"}], "options": {"A": "Dr. Radhakrishnan", "B": "Jawaharlal Nehru", "C": "Dr. B.R. Ambedkar", "D": "Sardar Vallabhbhai Patel"}, "explanation": "Textbook Pages 158 & 162: Dr. B.R. Ambedkar served as the first Law Minister of Independent India."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 158, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "first-law-minister", "direct", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
