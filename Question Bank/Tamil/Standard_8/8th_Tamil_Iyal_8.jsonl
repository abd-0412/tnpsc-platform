{"id": "8th-u8-q1036", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l2", "chapter_id": null, "topic_id": "odukkappatta-bharatham-year-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அம்பேத்கர் 'ஒடுக்கப்பட்ட பாரதம்' என்னும் இதழைத் தொடங்கிய ஆண்டு எது?"}], "options": {"A": "1920", "B": "1924", "C": "1930", "D": "1927"}, "explanation": "பாடநூல் பக். 160: அம்பேத்கர் 'ஒடுக்கப்பட்ட பாரதம்' என்னும் இதழை 1927-ஆம் ஆண்டு தொடங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "In which year did Ambedkar start the historic journal 'Bahishkrit Bharat' (Odukkappatta Bharatham)?"}], "options": {"A": "1920", "B": "1924", "C": "1930", "D": "1927"}, "explanation": "Textbook Page 160: Ambedkar launched the journal 'Bahishkrit Bharat' in the year 1927."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null