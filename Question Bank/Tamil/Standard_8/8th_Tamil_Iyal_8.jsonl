{"id": "8th-u8-q1003", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l1", "chapter_id": null, "topic_id": "thiriyoga-compound-grammar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'திரியோக மருந்து' என்னும் சொல்லாட்சியின் அமைப்பு மற்றும் இலக்கண முறை குறித்த சரியான விளக்கத்தைத் தேர்வு செய்க:\nஅ) திரி + யோகம் எனப் பிரியும்; வினைத்தொகையாகும்\nஆ) திரியோகம் + மருந்து எனப் பிரியும்; உருவகத் தொடராகும்\nஇ) திரி (மூன்று) என்னும் வடமொழி எண் பெயர் 'யோகம்' (பயிற்சி/வழி) மற்றும் 'மருந்து' என்னும் பெயருடன் இணைந்த எண் பெயர் தொகைத் தொடராகும்\nஈ) திரி + யோக + மருந்து எனப் பிரியும்; பண்புத்தொகையாகும்"}], "options": {"A": "விளக்கம் (அ)", "B": "விளக்கம் (ஆ)", "C": "விளக்கம் (இ) மட்டுமே பொருத்தமானது", "D": "விளக்கம் (ஈ)"}, "explanation": "பாடநூல் பக். 156: 'திரியோக மருந்து' என்பது நல்லறிவு, நற்காட்சி, நல்லொழுக்கம் ஆகிய 'மூன்று யோக மருந்துகள்' என்ற பொருளை உணர்த்தும் எண் அடங்கிய பெயர்ச்சொல் தொடராகும்."}, "en": {"blocks": [{"type": "text", "content": "Select the correct grammatical and morphological explanation of the term 'Triyoga Marunthu':\na) Splits into Thiri + Yogam; verbal compound\nb) Splits into Thiriyogam + Marunthu; metaphorical phrase\nc) Compound where 'Thiri' (numeral three) qualifies 'Yogam' and 'Marunthu', signifying three spiritual remedies\nd) Splits into Thiri + Yoga + Marunthu; qualitative compound"}], "options": {"A": "Explanation (a)", "B": "Explanation (b)", "C": "Explanation (c) alone is accurate", "D": "Explanation (d)"}, "explanation": "Textbook Page 156: 'Triyoga Marunthu' designates the triad of spiritual medicines (Right Knowledge, Right Faith, Right Conduct) where 'Thiri' denotes three."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "neelakesi", "compound-analysis", "grammar", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1004", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l1", "chapter_id": null, "topic_id": "ainchiru-kaappiyangal-odd-one", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் நூல்களுள் ஐஞ்சிறு காப்பியங்களுள் சேராத - பொருந்தாத நூல் எது?\nஅ) சூளாமணி\nஆ) யசோதர காவியம்\nஇ) நாககுமார காவியம்\nஈ) குண்டலகேசி"}], "options": {"A": "சூளாமணி", "B": "யசோதர காவியம்", "C": "நாககுமார காவியம்", "D": "குண்டலகேசி (இது ஐம்பெருங் காப்பியங்களுள் ஒன்று; சிறு காப்பியம் அன்று)"}, "explanation": "பாடநூல் பக். 157: சூளாமணி, யசோதர காவியம், நாககுமார காவியம், உதயணகுமார காவியம், நீலகேசி ஆகியவை ஐஞ்சிறு காப்பியங்கள். குண்டலகேசி என்பது ஐம்பெருங் காப்பியங்களுள் ஒன்றாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following texts does NOT belong to the Five Minor Epics (Odd one out)?\na) Soolamani\nb) Yasodhara Kaviyam\nc) Nagakumara Kaviyam\nd) Kundalakesi"}], "options": {"A": "Soolamani", "B": "Yasodhara Kaviyam", "C": "Nagakumara Kaviyam", "D": "Kundalakesi (Odd one out - belongs to Five Major Epics, not minor epics)"}, "explanation": "Textbook Page 157: Kundalakesi is one of the Five Major Epics (Aimperum Kaappiyangal), whereas the other three are minor epics."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 157, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "neelakesi", "epics-classification", "odd-one-out", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1005", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l1", "chapter_id": null, "topic_id": "triyoga-components-odd-one", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நீலகேசி கூறும் திரியோக மருந்துகளுள் சேராத - பொருந்தாத ஒன்றைத் தேர்வு செய்க:\nஅ) நற்பொருள் (செல்வம் சேர்த்தல்)\nஆ) நல்லறிவு (ஓர்தல்)\nஇ) நற்காட்சி (தெளிவு)\nஈ) நல்லொழுக்கம் (ஒழுக்கம்)"}], "options": {"A": "நற்பொருள் (இது திரியோக மருந்து அன்று; நல்லறிவு, நற்காட்சி, நல்லொழுக்கமே மருந்துகளாகும்)", "B": "நல்லறிவு", "C": "நற்காட்சி", "D": "நல்லொழுக்கம்"}, "explanation": "பாடநூல் பக். 156: நீலகேசி கூறும் மூன்று யோக மருந்துகள்: நல்லறிவு, நற்காட்சி, நல்லொழுக்கம் மட்டுமே. 'நற்பொருள்' (பொருள் சேர்த்தல்) அதில் இல்லை."}, "en": {"blocks": [{"type": "text", "content": "Which of the following is NOT part of the Triyoga remedies in Neelakesi (Odd one out)?\na) Narporul (Accumulation of wealth)\nb) Nallarivu / Orthal (Right Knowledge)\nc) Narkaatchi / Thelivu (Right Vision)\nd) Nallozhukkam / Ozhukkam (Right Conduct)"}], "options": {"A": "Narporul (Odd one out - wealth accumulation is not a Triyoga remedy)", "B": "Nallarivu", "C": "Narkaatchi", "D": "Nallozhukkam"}, "explanation": "Textbook Page 156: The three Triyoga remedies are Right Knowledge, Right Vision, and Right Conduct. Accumulating material wealth is not one of them."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "neelakesi", "triyoga-medicines", "odd-one-out", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1006", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l1", "chapter_id": null, "topic_id": "disease-types-odd-one", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நீலகேசி வகைப்படுத்தும் நோயின் தன்மைகளுள் பொருந்தாத - தவறான வகை எது?\nஅ) மருந்தினால் தீரும் நோய்கள்\nஆ) தெய்வ வழிபாட்டினால் மட்டுமே தீரும் நோய்கள்\nஇ) எதனாலும் தீராத தன்மையுடைய நோய்கள்\nஈ) வெளித்தோற்றத்தில் அடங்கி இருந்தாலும் உள்ளிருந்து துன்பம் தரும் நோய்கள்"}], "options": {"A": "மருந்தினால் தீரும் நோய்கள்", "B": "தெய்வ வழிபாட்டினால் மட்டுமே தீரும் நோய்கள் (இத்தகைய வகை நீலகேசியில் கூறப்படவில்லை)", "C": "எதனாலும் தீராத தன்மையுடைய நோய்கள்", "D": "வெளித்தோற்றத்தில் அடங்கி இருந்தாலும் உள்ளிருந்து துன்பம் தரும் நோய்கள்"}, "explanation": "பாடநூல் பக். 156: நீலகேசி கூறும் நோயின் மூன்று தன்மைகள்: 1. மருந்தால் தீர்பவை, 2. எதனாலும் தீராதவை, 3. அடங்கி இருப்பது போல் உள்ளிருந்து துன்பம் தருபவை. தெய்வ வழிபாட்டு நோய் வகை இதில் இல்லை."}, "en": {"blocks": [{"type": "text", "content": "Which of the following is NOT a disease classification category in Neelakesi (Odd one out)?\na) Diseases curable by medication\nb) Diseases curable solely through divine ritual worship\nc) Incurable diseases that resolve by no means\nd) Diseases that appear subdued outwardly but afflict from within"}], "options": {"A": "Diseases curable by medication", "B": "Diseases curable solely through divine ritual worship (Odd one out - not in Neelakesi)", "C": "Incurable diseases that resolve by no means", "D": "Diseases that appear subdued outwardly but afflict from within"}, "explanation": "Textbook Page 156: Neelakesi categorizes diseases strictly into three classes; divine worship cures are not part of its logical schema."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "neelakesi", "disease-types", "odd-one-out", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1007", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l1", "chapter_id": null, "topic_id": "health-definition-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உடல் நலம் என்பது எவை இல்லாமல் வாழ்தல் ஆகும்?"}], "options": {"A": "அணி", "B": "பணி", "C": "பிணி", "D": "மணி"}, "explanation": "பாடநூல் பக். 157 மதிப்பீடு வினா 1: உடல் நலம் என்பது 'பிணி' (நோய்/துன்பம்) இல்லாமல் வாழ்தல் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Physical well-being (Udal nalam) is defined as living without which of the following?"}], "options": {"A": "Ani (Ornaments)", "B": "Pani (Work/Humility)", "C": "Pini (Disease / Affliction)", "D": "Mani (Gems)"}, "explanation": "Textbook Page 157 Evaluation Q1: Physical well-being is defined as living free from 'Pini' (disease/affliction)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 157, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "neelakesi", "direct", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u8-q1008", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u8-l1", "chapter_id": null, "topic_id": "neelakesi-sarukkam-count-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நீலகேசி காப்பியம் கடவுள் வாழ்த்து நீங்கலாக எத்தனை சருக்கங்களைக் கொண்டுள்ளது?"}], "options": {"A": "ஐந்து சருக்கங்கள்", "B": "எட்டு சருக்கங்கள்", "C": "பன்னிரண்டு சருக்கங்கள்", "D": "பத்துச் சருக்கங்கள்"}, "explanation": "பாடநூல் பக். 157 நூல் வெளி: நீலகேசி காப்பியம் கடவுள் வாழ்த்து நீங்கலாகப் 'பத்துச் சருக்கங்களை'க் கொண்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "How many cantos (sarukkangal) does the epic Neelakesi contain, excluding the invocatory hymn?"}], "options": {"A": "Five cantos", "B": "Eight cantos", "C": "Twelve cantos", "D": "Ten cantos"}, "explanation": "Textbook Page 157 Book Note: Neelakesi contains 'ten cantos' (sarukkangal) excluding the invocatory hymn."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 157, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": nul