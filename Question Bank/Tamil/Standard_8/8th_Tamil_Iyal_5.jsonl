// 8-ஆம் வகுப்பு தமிழ் - இயல் 5: வையம்புகழ் வணிகம் (மொத்த வினாக்கள்: 140)
// ==============================================================================

// ==============================================================================
// பாடம் 1: வளம் பெருகுக (கவிதைப்பேழை - தகடூர் யாத்திரை) & பாடம் 2: கோணக்காத்துப் பாட்டு பகுதி 1 [Q561 - Q588]
// தகடூர் யாத்திரை (ஆசிரியர் பெயர் அறிய முடியாத நூல், தகடூர் இன்று தருமபுரி, புறத்திரட்டு தொகுப்பு நூல்); உழவுத் தொழில் படிநிலைகள் (வித்து, நாறு, கிளை, கதிர், களம்), சேர மன்னனின் நாட்டின் வளம், வாரி (வருவாய்), எஞ்சாமை (குறைவின்றி), முட்டாது (தட்டுப்பாடின்றி), ஒட்டாது (வாட்டமின்றி), வைகுக (தங்குக), ஓதை (ஓசை), வெரீஇ (அஞ்சி - சொல்லிசை அளபெடை), யாணர் (புதுவருவாய்); ஈற்றயலடி சிந்தடி (3 சீர்), ஏனைய அடிகள் அளவடி (4 சீர்); நெற்போர் காவாது வைகுதல் (கள்வர் அச்சமின்மை); கோணக்காத்துப் பாட்டு (வெங்கம்பூர் சாமிநாதன், காத்து நொண்டிச்சிந்து, பஞ்சக்கும்மிகள் தொகுத்தவர் புலவர் செ. ராசு); புயல் சீற்றம்: திரண்டு எழுந்த முகில், கூரைகள் சரிதல், வாங்கல் நகரில் தென்னம்பிள்ளைகள் வீணாதல், காங்கேய நாட்டின் மேட்டுக்காட்டில் பருத்தி கோலாய் மாறுதல், மக்கள் கதறுதல்
// ==============================================================================
{"id": "8th-u5-q561", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l1", "chapter_id": null, "topic_id": "thakadur-yathirai-intro", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தகடூர் யாத்திரை நூல் மற்றும் அதன் சிறப்புகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. தகடூர் யாத்திரை ஆசிரியர் பெயர் அறிய முடியாத நூல்களுள் ஒன்றாகும்.\n2. தகடூர் என்பது இன்று தருமபுரி என்று அழைக்கப்படும் ஊராகும்.\n3. இந்நூல் முழுமையாகக் கிடைக்கவில்லை; இதன் சில பாடல்கள் புறத்திரட்டு என்னும் தொகுப்பு நூலில் கிடைக்கின்றன.\n4. இப்பாடல் சேர மன்னரின் நாட்டின் வளத்தையும் உழவுத் தொழில் சிறப்பையும் எடுத்துரைக்கிறது."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 2, 3 மட்டும் சரி; 4 தவறு", "C": "1, 3 மட்டும் சரி; 2, 4 தவறு", "D": "2, 4 மட்டும் சரி; 1, 3 தவறு"}, "explanation": "நூல் வெளி: ஆசிரியர் பெயர் அறிய முடியாத நூல்களுள் ஒன்று தகடூர் யாத்திரை. தகடூர் இன்று தருமபுரி என்று அழைக்கப்படுகிறது. இந்நூல் முழுமையாகக் கிடைக்கவில்லை. இந்நூலின் சில பாடல்கள் புறத்திரட்டு என்னும் தொகுப்பு நூலில் கிடைக்கின்றன. இப்பாடல் சேர மன்னனின் அகன்ற நாட்டின் உழவு வளத்தைக் கூறுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding the text Thakadur Yathirai:\n1. Thakadur Yathirai is one of the ancient Tamil texts whose author is unknown.\n2. Thakadur is known as Dharmapuri today.\n3. This entire text is not available; some of its poems are found in the anthology Purathirattu.\n4. This poem depicts the fertility and agricultural prosperity of the Chera King's nation."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "Only 1, 2, 3 are correct; 4 is incorrect", "C": "Only 1, 3 are correct; 2, 4 are incorrect", "D": "Only 2, 4 are correct; 1, 3 are incorrect"}, "explanation": "Book Info: Thakadur Yathirai is an ancient work of unknown authorship. Thakadur is present-day Dharmapuri. The complete work is lost; surviving verses are preserved in the anthology Purathirattu. It glorifies the agricultural abundance of the Chera territory."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 93, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-5", "thakadur-yathirai", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u5-q562", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u8-manitham", "lesson_id": "8th-u5-l1", "chapter_id": null, "topic_id": "thakadur-yathirai-meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வளம் பெருகுக' பாடலில் உழவுத் தொழிலின் படிநிலைகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. சேர மன்னரின் அகன்ற நாட்டில் பெருகிய மழைநீரால் வருவாய் சிறந்து விளங்குகிறது.\n2. அகன்ற நிலப்பகுதியில் இடப்பட்ட விதைகள் தட்டுப்பாடின்றி முளைக்க வேண்டும் என்று பாடலில் வாழ்த்தப்படுகிறது.\n3. தகுந்த காலத்தில் மழை பொழிவதால் பயிர்கள் வாட்டமின்றி கிளைத்து வளர்கின்றன.\n4. கிளைத்துச் செழித்த பயிர்கள் பால்முற்றிக் கதிர்களை ஈனுகின்றன."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 3, 4 சரி; 2 தவறு", "C": "2, 3, 4 சரி; 1 தவறு", "D": "1, 2 மட்டும் சரி; 3, 4 தவறு"}, "explanation": "கூற்று 2 தவறானது. பாடலில் 'இருநிலத்து இட்டவித்து எஞ்சாமை நாறுக!' என்றுள்ளது. அதாவது விதைகள் குறைவின்றி (எஞ்சாமை) முளைக்க வேண்டும்; மழைதான் தட்டுப்பாடின்றி (முட்டாது வந்து மழை பெய்க) பெய்ய வேண்டும். எனவே 1, 3, 4 சரி; 2 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding the stages of agriculture in the poem 'Valam Peruguga':\n1. The revenue of the vast Chera realm prospers due to abundant rainwater.\n2. The seeds sown in the broad fields are blessed to sprout without scarcity.\n3. Due to timely rains, the crops branch out luxuriantly without wilting.\n4. The branched lush crops mature with milky sap and yield heavy ears of grain."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "1, 3, 4 are correct; 2 is incorrect", "C": "2, 3, 4 are correct; 1 is incorrect", "D": "Only 1, 2 are correct; 3, 4 are incorrect"}, "explanation": "Statement 2 is incorrect. The text states seeds must sprout 'without deficiency' (enjaamai naaruga), while rain must fall 'without disruption/scarcity' (muttaadhu vandhu mazhai peyga). Hence 1, 3, 4 are correct; 2 is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 92, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-5", "thakadur-yathirai", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u5-q563", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l1", "chapter_id": null, "topic_id": "thakadur-yathirai-metrics", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தகடூர் யாத்திரைப் பாடலின் யாப்பியல் அமைப்பு மற்றும் இலக்கணம் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. இப்பாடலில் இறுதிக்கு முந்தைய அடியான ஈற்றயலடி மூன்று சீர்களைக் கொண்டுள்ளதால் இது சிந்தடி ஆகும்.\n2. ஏனைய அடிகள் அனைத்தும் நான்கு சீர்களைக் கொண்டு அமைந்துள்ளதால் அளவடிகள் (நேரடிகள்) ஆகும்.\n3. பாடலில் இடம்பெற்றுள்ள 'வெரீஇ' என்பது செய்யுளிசை அளபெடை ஆகும்.\n4. பாடலில் உள்ள 'யாணர்' என்னும் சொல் பழமையான செல்வம் என்ற பொருளைத் தருகிறது."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "2, 3 சரி; 1, 4 தவறு", "C": "1, 2 சரி; 3, 4 தவறு", "D": "3, 4 சரி; 1, 2 தவறு"}, "explanation": "கூற்றுகள் 1, 2 சரியானவை. கூற்று 3 தவறு: 'வெரீஇ' என்பது சொல்லிசை அளபெடை (வெருவு என்னும் பெயர்ச்சொல் 'ஈ' பெற்று அஞ்சி என்ற வினையெச்சப் பொருளில் வந்தது). கூற்று 4 தவறு: 'யாணர்' என்பது 'புதுவருவாய்' என்று பொருள்படும். எனவே 1, 2 சரி; 3, 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding the poetic metrics and grammar of Thakadur Yathirai:\n1. The penultimate line consists of three metrical feet, making it a Chinthadi.\n2. All the other lines consist of four metrical feet, making them Alavadigal (Neradigal).\n3. The word 'Veriii' occurring in the poem is a Seyyulisai Alapedai.\n4. The word 'Yaanar' in the poem means ancient wealth."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "2, 3 are correct; 1, 4 are incorrect", "C": "1, 2 are correct; 3, 4 are incorrect", "D": "3, 4 are correct; 1, 2 are incorrect"}, "explanation": "Statements 1 and 2 are correct. Penultimate line has 3 feet (Chinthadi), others have 4 feet (Alavadi). Statement 3 is false: 'Veriii' is Sollissai Alapedai. Statement 4 is false: 'Yaanar' means 'new revenue/fresh yield'. Thus 1, 2 are correct; 3, 4 are incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 92, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-5", "thakadur-yathirai", "grammar", "statement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u5-q564", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l2", "chapter_id": null, "topic_id": "konakkathup-pattu-intro", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கோணக்காத்துப் பாட்டு மற்றும் பஞ்சக்கும்மிகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. நாட்டில் பஞ்சம் ஏற்பட்ட காலங்களில் மக்கள் பட்ட துயரங்களை அக்காலப் புலவர்கள் கும்மிப் பாடல்களாகப் பாடினர்.\n2. பேச்சுத்தமிழில் அமைந்த இப்பாடல்கள் 'பஞ்சக்கும்மிகள்' என்று அழைக்கப்பட்டன.\n3. 'பஞ்சக்கும்மிகள்' என்னும் வரலாற்றுத் தொகுப்பு நூலை இயற்றித் தொகுத்தவர் வெங்கம்பூர் சாமிநாதன் ஆவார்.\n4. கோணக்காத்துப் பாட்டு என்பது புலவர் செ. ராசு இயற்றிய காத்து நொண்டிச்சிந்து நூல் ஆகும்."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 3 சரி; 2, 4 தவறு", "C": "3, 4 சரி; 1, 2 தவறு", "D": "1, 2 சரி; 3, 4 தவறு"}, "explanation": "கூற்றுகள் 1, 2 சரியானவை. கூற்று 3 தவறு: பஞ்சக்கும்மிகள் என்னும் நூலைத் தொகுத்தவர் புலவர் செ. ராசு ஆவார். கூற்று 4 தவறு: கோணக்காத்துப் பாட்டு என்னும் காத்து நொண்டிச்சிந்துப் பாடலை இயற்றியவர் வெங்கம்பூர் சாமிநாதன் ஆவார். எனவே 1, 2 சரி; 3, 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding Konakkathup Pattu and Panjakummigal:\n1. When famine struck the country, contemporary poets sang the miseries faced by people as Kummi songs.\n2. These folk songs composed in colloquial Tamil were known as 'Panjakummigal'.\n3. The anthology titled 'Panjakummigal' was compiled by Venkambur Swaminathan.\n4. Konakkathup Pattu is a wind folk ballad (Kaathu Nondichindhu) written by Pulavar Se. Rasu."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "1, 3 are correct; 2, 4 are incorrect", "C": "3, 4 are correct; 1, 2 are incorrect", "D": "1, 2 are correct; 3, 4 are incorrect"}, "explanation": "Statements 1 and 2 are correct. Statement 3 is false: Panjakummigal was compiled by Pulavar Se. Rasu. Statement 4 is false: Konakkathup Pattu was composed by Venkambur Swaminathan. Hence 1, 2 are correct; 3, 4 are incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 95, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-5", "konakkathu", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u5-q565", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l2", "chapter_id": null, "topic_id": "konakkathup-pattu-destruction", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கோணக்காத்துப் பாட்டு' பாடலில் விவரிக்கப்படும் புயல் காற்று அழிவுகள் குறித்த கூற்றுகளை ஆராய்க:\n1. திரண்டு எழுந்த மேகங்களால் உருவான கோணக்காற்று சுழன்று அடித்ததால் பெரிய வீடுகளின் கூரைகள் பிரிந்து சரிந்தன.\n2. சிங்காரமாய் வாங்கல் நகரில் வைக்கப்பட்டிருந்த தென்னம்பிள்ளைகள் அத்தனையும் புயலால் பாழாயின.\n3. மங்காத காங்கேய நாட்டின் மேட்டுக்காட்டுப் பகுதியில் பயிரிடப்பட்டிருந்த பருத்திச் செடிகள் காற்றில் சிதைந்து கோலாயின.\n4. மக்கள் கெடிகலங்கித் தாரங்களையும் பிள்ளைகளையும் கூட்டிக்கொண்டு கூகூவென்று அலறிக்கொண்டு ஓடினர்."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 2, 3 மட்டும் சரி; 4 தவறு", "C": "2, 3, 4 மட்டும் சரி; 1 தவறு", "D": "1, 4 மட்டும் சரி; 2, 3 தவறு"}, "explanation": "பாடலின் வரிகள்: 'உருமங் கட்டிய முகிலால்... கூரைத்தட்டுச் சரிந்ததங்கே', 'வாங்கல் நகரில் வைத்திருந்த தென்னம்பிள்ளை அத்தனையும் விண்ணாயாச்சுதே', 'காங்கய நாட்டில் மேட்டுக்காட்டில் வாடாத பருத்திஎல்லாம் கோலாகப் போச்சுதே', 'தாரங்களும் பிள்ளைகளுடன் கூட்டிக்கொண்டு கூகூவென்றார்'. அனைத்தும் பாடலில் இடம்பெற்ற நேரடி உண்மைகள்."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements describing the destruction caused by the cyclone in 'Konakkathup Pattu':\n1. The fierce cyclone born of heavy dense clouds whirled powerfully, causing roofs of large houses to rip apart.\n2. In the picturesque town of Vangal, all the planted coconut saplings were devastated.\n3. In the highland fields of the famed Kangeyam region, lush cotton crops were stripped to bare sticks.\n4. Utterly panicked, people gathered their wives and children, fleeing and crying out loudly in despair."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "Only 1, 2, 3 are correct; 4 is incorrect", "C": "Only 2, 3, 4 are correct; 1 is incorrect", "D": "Only 1, 4 are correct; 2, 3 are incorrect"}, "explanation": "All statements are direct factual descriptions from the poem describing the devastating cyclone that struck Vangal coconut farms, Kangeyam cotton fields, house roofs, and displaced families."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 94, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-5", "konakkathu", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u5-q566", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l1", "chapter_id": null, "topic_id": "thakadur-yathirai-field", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தகடூர் யாத்திரைப் பாடலில் களமும் உழவர்களும் விவரிக்கப்படும் முறை பற்றிய கூற்றுகளை ஆராய்க:\n1. ஏரினால் வளம் சிறக்கும் செல்வர்களின் களத்தில் அறுவடை செய்த நெற்கதிர்கள் வந்து நிறைய வேண்டும்.\n2. களத்தில் குவிந்துள்ள நெற்போர்கள் திருட்டுப் பயத்தால் பலத்த காவலுடன் பாதுகாக்கப்பட வேண்டும்.\n3. போரினை அடித்து நெல்லினைக் கொள்ளும் காலத்தில் உழவர்கள் பெருமகிழ்ச்சியால் ஆரவார ஒலி எழுப்புவர்.\n4. உழவர்களின் ஆரவார ஒலியைக் கேட்டு நாரை இனங்கள் அஞ்சித் தம் பெண் பறவைகளோடு பிரிந்து செல்லும் சிறப்புடையது சேர மன்னரின் நாடு."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 3, 4 சரி; 2 தவறு", "C": "2, 3, 4 சரி; 1 தவறு", "D": "1, 2 சரி; 3, 4 தவறு"}, "explanation": "கூற்று 2 தவறானது. பாடலில் 'அக்களத்துப் போரெல்லாம் காவாது வைகுக!' என்றுள்ளது. அதாவது களத்தில் வந்து நிறைந்துள்ள நெற்போர் காவல் இன்றியே தங்க வேண்டும் (அறநெறி ஆட்சி நிலவுவதால் காவல் தேவையில்லை). எனவே 1, 3, 4 சரி; 2 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements regarding the threshing floor and farmers in Thakadur Yathirai:\n1. The harvested ears of paddy should fill the threshing floors of prosperous farmers who plow with oxen.\n2. The piles of harvested paddy sheaves on the threshing floor must be guarded with high security against thieves.\n3. While thrashing the sheaves to separate the grains, farmers raise joyous roaring shouts.\n4. Startled by the loud shouts of the thrashing farmers, male storks fearfully separate and fly away with their females."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "1, 3, 4 are correct; 2 is incorrect", "C": "2, 3, 4 are correct; 1 is incorrect", "D": "Only 1, 2 are correct; 3, 4 are incorrect"}, "explanation": "Statement 2 is false. The text explicitly says 'Kaavaadhu vaiguga' meaning the grain heaps remain safe without any need for guards/watching due to the righteous rule. Hence 1, 3, 4 are correct; 2 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 92, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-5", "thakadur-yathirai", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u5-q567", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l2", "chapter_id": null, "topic_id": "konakkathup-pattu-maritime", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கோணக்காத்துப் பாட்டு' பாடலில் கூறப்படும் பிற சேதங்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. கடலில் கம்பீரமாய் விரைந்து வந்த கப்பல்கள் சுழன்றடித்த கோணக் காற்றினால் எமனே போல வந்து கவிழ்ந்தன.\n2. தொண்டைமான் சீமையிலே அழகாக வைக்கப்பட்டிருந்த மரங்கள் அனைத்தும் சின்னபின்னமாய் ஒடிந்து விழுந்தன.\n3. ஆர்க்காடு முதல் வரைக்கும் அடித்த புயலால் சாலையில் சென்ற மக்கள் எந்தவித அச்சமும் இன்றி விரைந்து சென்றனர்.\n4. மெத்தக்காடு காளப்பநாயக்கன்பட்டியில் ஆடு மாடுகள் புயலின் கொடுமையால் செத்து மடிந்தன."}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 3, 4 சரி; 2 தவறு", "C": "1, 2, 4 சரி; 3 தவறு", "D": "2, 3, 4 சரி; 1 தவறு"}, "explanation": "கூற்று 3 தவறானது. பாடலில் 'ஆர்க்காடு முதல் வரைக்கும் கோணக்காத்து அலறி அலறி மெத்த அடித்ததனால் மார்க்கமான சாலையில் போன சனங்கள் எல்லாம் மயங்கி மயங்கி மெத்தத் தவித்தார்களே' என்றுள்ளது. மக்கள் கலங்கித் தவித்தனர், அச்சமின்றி செல்லவில்லை. எனவே 1, 2, 4 சரி; 3 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding other destructions detailed in 'Konakkathup Pattu':\n1. Sailing majestically across the sea, ships were capsized by the whirlwind that arrived like the God of Death.\n2. In the realm of Thondaiman, all the well-planted shade trees were fractured and splintered.\n3. Due to the violent gale blowing up to Arcot, travelers on the roads proceeded without any fear or distress.\n4. In the fold of Kalappa Nayakkan Patti in Metthakkadu, herds of sheep and cattle died in large numbers."}], "options": {"A": "All 1, 2, 3, 4 are correct", "B": "1, 3, 4 are correct; 2 is incorrect", "C": "1, 2, 4 are correct; 3 is incorrect", "D": "2, 3, 4 are correct; 1 is incorrect"}, "explanation": "Statement 3 is incorrect. The text notes that travelers on the highways up to Arcot were swooning, bewildered, and suffered intensely under the howling winds. Statements 1, 2, and 4 are completely accurate."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 94, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-5", "konakkathu", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u5-q568", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l1", "chapter_id": null, "topic_id": "thakadur-security", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): சேர மன்னரின் நாட்டின் நெற்களத்தில் வந்து குவிந்துள்ள நெற்போர்கள் பலத்த ஆயுதக் காவலுடன் பூட்டி வைக்கப்படுகின்றன.\nகாரணம் (R): சேர நாட்டில் திருட்டு பயம் மிக அதிகமாக இருந்ததால் உழவர்கள் நெற்போர்களை இரவும் பகலும் காவல் காத்தனர்."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் கூற்றை விளக்கவில்லை", "C": "கூற்று (A) தவறு; காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறானவை. பாடலில் 'போரெல்லாம் காவாது வைகுக' என்று குறிப்பிடப்படுகிறது. சேர மன்னனின் நல்லாட்சியில் நாட்டில் கள்வர் அச்சமே இல்லாததால், களத்தில் நெற்போர்கள் எவ்விதக் காவலும் இன்றியே தங்கிப் பொலிந்தன."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): The heaps of harvested paddy on the threshing floors of the Chera kingdom were locked under heavy armed guard.\nReason (R): Because fear of thievery was extremely high in the Chera kingdom, farmers guarded the sheaves day and night."}], "options": {"A": "Both (A) and (R) are correct, and (R) explains (A)", "B": "Both (A) and (R) are correct, but (R) does not explain (A)", "C": "(A) is incorrect; (R) is correct", "D": "Both (A) and (R) are incorrect"}, "explanation": "Both (A) and (R) are false. The poem states 'pōrellām kāvādhu vaiguga' - the grain heaps stay safely without any guarding or protection, reflecting the flawless, crime-free righteous governance in the Chera realm."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 92, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-5", "thakadur-yathirai", "assertion-reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u5-q569", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l1", "chapter_id": null, "topic_id": "thakadur-metrics-chinthadi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'வளம் பெருகுக' பாடலின் இறுதிக்கு முந்தைய அடி (ஈற்றயலடி) சிந்தடி என்று அழைக்கப்படுகிறது.\nகாரணம் (R): செய்யுளில் மூன்று சீர்களைக் கொண்டு அமையும் அடிக்குச் சிந்தடி என்பது இலக்கணப் பெயராகும்."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் கூற்றை விளக்கவில்லை", "C": "கூற்று (A) சரி; காரணம் (R) தவறு", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று மற்றும் காரணம் இரண்டும் சரி. 'வளம் பெருகுக' பாடலில் 'நாரை பிரியும் விளைவயல்' என்னும் ஈற்றயலடி மூன்று சீர்களைக் கொண்டுள்ளதால் சிந்தடி ஆகும். மூன்று சீர்கள் கொண்ட அடிக்குச் சிந்தடி என்று பெயர் என்பது சரியான இலக்கண விளக்கமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): The penultimate line of the poem 'Valam Peruguga' is designated as Chinthadi.\nReason (R): In Tamil poetics, a metrical line composed of exactly three metrical feet (seers) is called Chinthadi."}], "options": {"A": "Both (A) and (R) are correct, and (R) explains (A)", "B": "Both (A) and (R) are correct, but (R) does not explain (A)", "C": "(A) is correct; (R) is incorrect", "D": "Both (A) and (R) are incorrect"}, "explanation": "Both Assertion and Reason are correct and (R) explains (A). The penultimate line 'Naarai piriyum vilaivayal' contains 3 feet, satisfying the classical grammatical definition of Chinthadi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 92, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-5", "thakadur-yathirai", "assertion-reason", "metrics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u5-q570", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l2", "chapter_id": null, "topic_id": "konakkathu-panjakummi-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): கோணக்காத்துப் பாட்டு என்பது பஞ்சக்கும்மி வகையைச் சார்ந்த நாட்டுப்புற வடிவப் பாடலாகும்.\nகாரணம் (R): கோணக்காத்துப் பாட்டை இயற்றிய வெங்கம்பூர் சாமிநாதன் என்பவர் 'கொங்கு மண்டல சதகம்' என்னும் நூலை எழுதியுள்ளார்."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "B": "கூற்று (A) சரி; காரணம் (R) தவறு", "C": "கூற்று (A) தவறு; காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று (A) சரி; காரணம் (R) தவறு. கோணக்காத்துப் பாட்டு பஞ்சக்கும்மி வகை நூல் என்பது உண்மை. ஆனால், 'கொங்கு மண்டல சதகம்' என்னும் நூலை இயற்றியவர் கார்மேகக் கவிஞர் ஆவார்; வெங்கம்பூர் சாமிநாதன் அல்ல. எனவே காரணம் தவறு."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Konakkathup Pattu belongs to the folk category of Panjakummi ballads.\nReason (R): Venkambur Swaminathan, the poet of Konakkathup Pattu, authored the historical work 'Kongu Mandala Sathakam'."}], "options": {"A": "Both (A) and (R) are correct, and (R) explains (A)", "B": "(A) is correct; (R) is incorrect", "C": "(A) is incorrect; (R) is correct", "D": "Both (A) and (R) are incorrect"}, "explanation": "(A) is correct; (R) is false. Konakkathup Pattu is indeed part of the Panjakummi folk tradition. However, 'Kongu Mandala Sathakam' was composed by Kaarmega Kavignar, not Venkambur Swaminathan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 95, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-5", "konakkathu", "assertion-reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u5-q571", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l2", "chapter_id": null, "topic_id": "konakkathu-kangayam-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): கோணக்காற்று வீசியதால் காங்கேய நாட்டின் மேட்டுக்காட்டுப் பகுதியில் பயிரிடப்பட்டிருந்த பருத்திச் செடிகள் செழித்து வளர்ந்து கூடுதல் பஞ்சினைத் தந்தன.\nகாரணம் (R): கோணக்காத்துப் பாடலில் சூறாவளிக் காற்று வீசியதால் வாடாத பருத்திச் செடிகள் அனைத்தும் காற்றில் சிதைந்து வெறும் குச்சிகளாய் (கோலாய்) மாறின என்று குறிப்பிடப்பட்டுள்ளது."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் கூற்றை விளக்கவில்லை", "C": "கூற்று (A) தவறு; காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று (A) தவறு; காரணம் (R) சரி. பருத்திச் செடிகள் செழிக்கவில்லை; புயலின் சீற்றத்தால் 'வாடாத பருத்திஎல்லாம் கோலாகப் போச்சுதே' என்று பஞ்செல்லாம் காற்றில் அடித்துச் செல்லப்பட்டு வெறும் குச்சிகளாயின என்று பாடல் கூறுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Due to the gale winds, cotton crops grown in the highlands of Kangeyam flourished and yielded excessive cotton produce.\nReason (R): In Konakkathup Pattu, it is stated that the lush unwilted cotton plants were stripped bare into mere wooden sticks by the gale."}], "options": {"A": "Both (A) and (R) are correct, and (R) explains (A)", "B": "Both (A) and (R) are correct, but (R) does not explain (A)", "C": "(A) is incorrect; (R) is correct", "D": "Both (A) and (R) are incorrect"}, "explanation": "(A) is false; (R) is correct. Cotton crops were not enriched; rather, the ferocious winds stripped the cotton clean, reducing flourishing crops to barren sticks ('kolagap pochudhe')."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 94, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-5", "konakkathu", "assertion-reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u5-q572", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l1", "chapter_id": null, "topic_id": "thakadur-author-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தகடூர் யாத்திரை என்னும் சங்க கால நூலை இயற்றியவர் கபிலர் என்று தமிழ் அறிஞர்கள் ஒருமனதாக முடிவு செய்துள்ளனர்.\nகாரணம் (R): தகடூரை ஆண்ட மன்னன் அதியமான் நெடுமான் அஞ்சியின் ஒரே அவைக்களப் புலவராகக் கபிலர் மட்டுமே விளங்கியதே இதற்குச் சான்றாகும்."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "B": "கூற்று (A) சரி; காரணம் (R) தவறு", "C": "கூற்று (A) தவறு; காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு. பாடநூல் நூல்வெளி தெளிவாகக் கூறுகிறது: 'ஆசிரியர் பெயர் அறிய முடியாத நூல்களுள் ஒன்று தகடூர் யாத்திரை'. மேலும் அதியமானின் அவைக்களப் புலவராகத் திகழ்ந்தவர் ஔவையார் ஆவார். எனவே இரண்டும் தவறு."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Tamil scholars have unanimously concluded that the Sangam work Thakadur Yathirai was authored by Kapilar.\nReason (R): The evidence for this is that Kapilar served as the sole court poet of Athiyaman Neduman Anji who ruled Thakadur."}], "options": {"A": "Both (A) and (R) are correct, and (R) explains (A)", "B": "(A) is correct; (R) is incorrect", "C": "(A) is incorrect; (R) is correct", "D": "Both (A) and (R) are incorrect"}, "explanation": "Both (A) and (R) are false. The textbook explicitly states that Thakadur Yathirai is an ancient text of unknown author. Furthermore, the premier court poet of Athiyaman was Avvaiyar, not Kapilar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 93, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-5", "thakadur-yathirai", "assertion-reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u5-q573", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l2", "chapter_id": null, "topic_id": "konakkathu-prayer-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): புயல் வெள்ளத்தால் தங்கள் வாழ்வாதாரங்களை இழந்த கொங்கு நாட்டு மக்கள், தங்களைக் காத்தருள வேண்டும் என்று முருகப்பெருமானிடம் முறையிட்டனர்.\nகாரணம் (R): 'இப்படிக்கிச் சேதங்களானால் குமரேசா எப்படிப் பிழைத்து நாங்கள் ஒப்பிதமாவோம்' என்று வேலேந்திய முருகனை நோக்கி மக்கள் பாடலில் மன்றாடுகின்றனர்."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் கூற்றை விளக்கவில்லை", "C": "கூற்று (A) சரி; காரணம் (R) தவறு", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரியானவை; காரணம் கூற்றை விளக்குகிறது. புயலால் வாடிய மக்கள் 'குமரேசா எப்படிப் பிழைத்து நாங்கள் ஒப்பிதமாவோம்... மெய்ப்புடன் வேலாயுதங் கொண்டு வருகின்ற விக்கின சினவேந்தனே' என்று வேலாயுதம் ஏந்திய முருகப்பெருமானிடம் அபயம் கோருகின்றனர்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Deprived of their livelihoods by the cyclone disaster, the people of the Kongu region prayed to Lord Murugan for salvation.\nReason (R): In the ballad, the folk plead before Lord Murugan, crying 'Kumaresa, if such calamities occur, how shall we survive and sustain ourselves?'."}], "options": {"A": "Both (A) and (R) are correct, and (R) explains (A)", "B": "Both (A) and (R) are correct, but (R) does not explain (A)", "C": "(A) is correct; (R) is incorrect", "D": "Both (A) and (R) are incorrect"}, "explanation": "Both Assertion and Reason are true and (R) correctly explains (A). The helpless populace appeals to Lord Murugan ('Kumaresa', 'Velayudham'), asking how they can possibly survive such catastrophe without divine grace."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 94, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-5", "konakkathu", "assertion-reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u5-q574", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l1", "chapter_id": null, "topic_id": "thakadur-vocab-match-1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தகடூர் யாத்திரைப் பாடலின் அரும்பதங்களை அவற்றின் பொருள்களோடு பொருத்துக:\n(a) வாரி - 1. வாட்டமின்றி\n(b) எஞ்சாமை - 2. தட்டுப்பாடின்றி\n(c) முட்டாது - 3. குறைவின்றி\n(d) ஒட்டாது - 4. வருவாய்"}], "options": {"A": "(a)-3, (b)-4, (c)-1, (d)-2", "B": "(a)-4, (b)-3, (c)-2, (d)-1", "C": "(a)-4, (b)-2, (c)-3, (d)-1", "D": "(a)-1, (b)-2, (c)-3, (d)-4"}, "explanation": "சொல்லும் பொருளும்: வாரி - வருவாய்; எஞ்சாமை - குறைவின்றி; முட்டாது - தட்டுப்பாடின்றி; ஒட்டாது - வாட்டமின்றி. எனவே (a)-4, (b)-3, (c)-2, (d)-1 ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Match the classical vocabulary from Thakadur Yathirai with their meanings:\n(a) Vaari - 1. Without wilting\n(b) Enjaamai - 2. Without disruption/scarcity\n(c) Muttaadhu - 3. Without deficiency\n(d) Ottaadhu - 4. Revenue/yield"}], "options": {"A": "(a)-3, (b)-4, (c)-1, (d)-2", "B": "(a)-4, (b)-3, (c)-2, (d)-1", "C": "(a)-4, (b)-2, (c)-3, (d)-1", "D": "(a)-1, (b)-2, (c)-3, (d)-4"}, "explanation": "Glossary: Vaari - Revenue; Enjaamai - Without deficiency; Muttaadhu - Without interruption/scarcity; Ottaadhu - Without wilting. Hence (a)-4, (b)-3, (c)-2, (d)-1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 92, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-5", "thakadur-yathirai", "matching"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u5-q575", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l1", "chapter_id": null, "topic_id": "thakadur-vocab-match-2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தகடூர் யாத்திரைப் பாடலின் அருஞ்சொற்களை அவற்றின் பொருள்களுடன் பொருத்துக:\n(a) வைகுக - 1. புதுவருவாய்\n(b) ஓதை - 2. அஞ்சி\n(c) வெரீஇ - 3. ஓசை\n(d) யாணர் - 4. தங்குக"}], "options": {"A": "(a)-2, (b)-3, (c)-4, (d)-1", "B": "(a)-1, (b)-4, (c)-3, (d)-2", "C": "(a)-4, (b)-3, (c)-2, (d)-1", "D": "(a)-3, (b)-2, (c)-1, (d)-4"}, "explanation": "சொல்லும் பொருளும்: வைகுக - தங்குக; ஓதை - ஓசை; வெரீஇ - அஞ்சி; யாணர் - புதுவருவாய். எனவே சரியான பொருத்தம் (a)-4, (b)-3, (c)-2, (d)-1 ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Match the terms from Thakadur Yathirai with their exact definitions:\n(a) Vaiguga - 1. Fresh revenue\n(b) Oadhai - 2. Having feared\n(c) Veriii - 3. Sound/commotion\n(d) Yaanar - 4. Reside/remain"}], "options": {"A": "(a)-2, (b)-3, (c)-4, (d)-1", "B": "(a)-1, (b)-4, (c)-3, (d)-2", "C": "(a)-4, (b)-3, (c)-2, (d)-1", "D": "(a)-3, (b)-2, (c)-1, (d)-4"}, "explanation": "Glossary: Vaiguga - Reside/stay; Oadhai - Sound; Veriii - Fearing; Yaanar - Fresh revenue. Correct matching is (a)-4, (b)-3, (c)-2, (d)-1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true,