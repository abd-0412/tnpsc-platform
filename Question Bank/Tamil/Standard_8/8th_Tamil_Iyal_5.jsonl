{"id": "8th-u5-q586", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l2", "chapter_id": null, "topic_id": "konakkathu-quote-fill", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கோணக்காத்துப் பாடல் அடிகளில் விடுபட்ட சொல்லைத் தேர்க:\n\"சிங்காரமாய் வாங்கல் நகரில் வைத்திருந்த\n __________ அத்தனையும் விண்ணாயாச்சுதே\n மங்காத காங்கய நாட்டில் மேட்டுக்காட்டில்\n வாடாத பருத்திஎல்லாம் கோலாகப் போச்சுதே!\""}], "options": {"A": "மாம்பிள்ளைகள்", "B": "தென்னம்பிள்ளை", "C": "வாழைக்கன்றுகள்", "D": "பாக்குமரங்கள்"}, "explanation": "பாடலின் வரி: 'சிங்காரமாய் வாங்கல் நகரில் வைத்திருந்த தென்னம்பிள்ளை அத்தனையும் விண்ணாயாச்சுதே'. வாங்கல் நகரில் வைக்கப்பட்டிருந்த தென்னம்பிள்ளைகள் யாவும் புயலால் பாழாயின என்பதை இவ்வரி குறிப்பிடுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Select the missing word from the poetic lines of 'Konakkathup Pattu':\n\"Singaaramaai vaangal nagaril vaitthirundha\n __________ atthanaiyum vinnaayaacchudhe\n Mangaadha kaangaya naattil mettukaattil\n Vaadaadha parutthiyellaam kōlaagap pōcchudhē!\""}], "options": {"A": "Maampillaigal (Mango saplings)", "B": "Thennampillai (Coconut saplings)", "C": "Vazhaikkandrugal (Plantain shoots)", "D": "Paakkumarangal (Areca palms)"}, "explanation": "Text line: 'Singaaramaai vaangal nagaril vaitthirundha thennampillai atthanaiyum vinnaayaacchudhe'. It recounts the devastation of the coconut saplings planted in the town of Vangal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 94, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-5", "quote-completion", "konakkathu"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u5-q587", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l1", "chapter_id": null, "topic_id": "thakadur-purathirattu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முழுமையாகக் கிடைக்காத 'தகடூர் யாத்திரை' என்னும் நூலின் சில பாடல்கள் எந்தத் தொகுப்பு நூலில் பாதுகாக்கப்பட்டு நமக்குக் கிடைத்துள்ளன?"}], "options": {"A": "அகநானூறு", "B": "கலித்தொகை", "C": "புறத்திரட்டு", "D": "நற்றிணை"}, "explanation": "நூல் வெளி: தகடூர் யாத்திரை நூல் முழுமையாகக் கிடைக்கவில்லை. இந்நூலின் சில பாடல்கள் 'புறத்திரட்டு' என்னும் தொகுப்பு நூலில் கிடைக்கின்றன."}, "en": {"blocks": [{"type": "text", "content": "In which anthology are some surviving verses of the lost ancient work 'Thakadur Yathirai' preserved?"}], "options": {"A": "Agananuru", "B": "Kalithogai", "C": "Purathirattu", "D": "Natrinai"}, "explanation": "Textbook Note: Thakadur Yathirai is not available in full. Select surviving verses are compiled and preserved in the anthology titled 'Purathirattu'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 93, "chapter": nu