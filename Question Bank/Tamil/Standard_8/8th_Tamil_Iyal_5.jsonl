{"id": "8th-u5-q588", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l1", "chapter_id": null, "topic_id": "thakadur-dharmapuri", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழங்காலத்தில் சேர மன்னர்களின் வலிமைமிக்க கோட்டையாகத் திகழ்ந்த 'தகடூர்' என்பது தற்காலத்தில் எந்தப் பெயரில் அழைக்கப்படுகிறது?"}], "options": {"A": "கிருஷ்ணகிரி", "B": "சேலம்", "C": "நாமக்கல்", "D": "தருமபுரி"}, "explanation": "நூல் வெளி: தகடூர் என்பது சங்க காலப் பெயர்; இவ்வூர் தற்காலத்தில் 'தருமபுரி' என்று அழைக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the modern name of 'Thakadur', which served as a renowned historic fort of the Cheras in ancient times?"}], "options": {"A": "Krishnagiri", "B": "Salem", "C": "Namakkal", "D": "Dharmapuri"}, "explanation": "Book Info: Thakadur is the historical Sangam-era name; today the region is known as Dharmapuri."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 93, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is