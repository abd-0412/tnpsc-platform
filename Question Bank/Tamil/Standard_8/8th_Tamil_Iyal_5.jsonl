{"id": "8th-u5-q672", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l5", "chapter_id": null, "topic_id": "grammar-aettrinaan-verb-type", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூல் மதிப்பீட்டு வினா: 'ஏற்றினான்' என்பது எவ்வகை வினைச்சொல் ஆகும்? (பக். 109 சிறுவினா 2):"}], "options": {"A": "செய்வினை", "B": "செயப்பாட்டு வினை", "C": "தன்வினை", "D": "பிறவினை"}, "explanation": "பாடநூல் பக். 109 சிறுவினா 2: 'ஏறினான்' என்பது எழுவாய் வினையைத் தானே செய்த தன்வினை ஆகும்; 'ஏற்றினான்' என்பது பிறரைக் கொண்டு செய்வித்த அல்லது வினையைச் செய்வித்த 'பிறவினை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Textbook Evaluation Question: 'Aettrinaan' belongs to which type of verb? (Page 109, Short Question 2):"}], "options": {"A": "Seivinai", "B": "Seyappattu Vinai", "C": "Thanvinai", "D": "Piravinai"}, "explanation": "Textbook Page 109, Short Q2: 'Earinaan' is Thanvinai (he climbed); 'Aettrinaan' is Piravinai (he caused to mount/loaded). Hence Piravinai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 109, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-5", "direct", "grammar", "piravinai", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

