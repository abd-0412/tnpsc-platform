// ==============================================================================
// 8-ஆம் வகுப்பு தமிழ் - இயல் 1: தமிழ் இன்பம் (மொத்த வினாக்கள்: 140)
// ==============================================================================

// ==============================================================================
// பாடம் 1 & 2: தமிழ்மொழி வாழ்த்து & தமிழ்மொழி மரபு (செய்யுள் - பாரதியார் & தொல்காப்பியர்) [Q001 - Q028]
// பாரதியார், பாரதிதாசன் புகழுரை (செந்தமிழ்த் தேனீ, சிந்துக்குத் தந்தை, புதிய அறம்பாட வந்த அறிஞன், நாட்டுக் கவிஞன்), வாழ்க நிரந்தரம், வண்மொழி, தொல்லை வினைதரு தொல்லை, தொல்காப்பியம் மரபியல் நூற்பாக்கள் (635, 636, 637), ஐம்பூதக் கொள்கை, மரபு பிறழ்தல், மாத்திரை, புணர்ச்சி
// ==============================================================================
{"id": "8th-u1-q001", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-01-tamilmozhi-vaazhthu", "chapter_id": null, "topic_id": "ta-8th-u1-bharati-vaazhthu-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மகாகவி பாரதியார் மற்றும் 'தமிழ்மொழி வாழ்த்து' பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'வாழ்க நிரந்தரம் வாழ்க தமிழ்மொழி வாழிய வாழியவே' என்று பாடியவர் பாரதியார் ஆவார்.\n2. 'வானம் அளந்தது அனைத்தும் அளந்திடு வண்மொழி வாழியவே' எனத் தமிழ்மொழியின் அறிவு எல்லையைப் போற்றுகிறார்.\n3. பாரதியார் கவிஞர், எழுத்தாளர், இதழாளர், சமூகச் சீர்திருத்தச் சிந்தனையாளர் எனப் பன்முக ஆற்றல் கொண்டவர்.\n4. இவர் 'இந்தியா', 'விஜயா' இதழ்களை நடத்தியதோடு, 'சந்திரிகையின் கதை', 'தராசு' போன்ற உரைநடை நூல்களையும் படைத்துள்ளார்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2 மட்டுமே சரியானவை", "C": "கூற்றுகள் 1, 3, 4 சரியானவை; 2 தவறானது", "D": "கூற்றுகள் 2, 4 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் இயல் 1 பக்கம் 2-3: பாரதியார் பாடிய தமிழ்மொழி வாழ்த்து, அவரது பன்முக ஆற்றல், இதழியல் பணி (இந்தியா, விஜயா) மற்றும் உரைநடை நூல்கள் (சந்திரிகையின் கதை, தராசு) குறித்த நான்கு கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements regarding Mahakavi Bharati and 'Tamilmozhi Vaazhthu':\n1. 'Vazhga nirantharam vazhga thamizhmorzhi...' was composed by Bharati.\n2. He extols Tamil as encompassing all universal knowledge in 'Vaanam alanthathu...'.\n3. Bharati was a multifaceted luminary: poet, essayist, journalist, and social reformer.\n4. He edited 'India' and 'Vijaya', and authored prose treatises including 'Chandrikaiyin Kathai' and 'Tharasu'.\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 2 only are correct", "C": "Statements 1, 3, 4 are correct; 2 is incorrect", "D": "Statements 2, 4 only are correct"}, "explanation": "Textbook pages 2-3: All 4 statements accurately detail Bharati's verse, journalism, and prose contributions. Key A."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'வாழ்க நிரந்தரம் வாழ்க தமிழ்மொழி வாழிய வாழியவே' என்று தமிழின் அழியாத் தன்மையைப் போற்றிப் பாடியவர் மகாகவி சுப்பிரமணிய பாரதியார் ஆவார்.", "content_en": "'Vazhga nirantharam vazhga thamizhmorzhi...' praising Tamil's eternity was composed by Mahakavi Subramania Bharati."}, {"id": "S2", "content_ta": "'வானம் அளந்தது அனைத்தும் அளந்திடு வண்மொழி வாழியவே' என்று தமிழ்மொழியின் எல்லையற்ற அறிவாற்றலையும் வளத்தையும் பாரதியார் போற்றுகிறார்.", "content_en": "Bharati extols Tamil as the fertile tongue that encompasses all knowledge bounded by the skies."}, {"id": "S3", "content_ta": "பாரதியார் கவிஞர், எழுத்தாளர், இதழாளர், சமூகச் சீர்திருத்தச் சிந்தனையாளர், விடுதலைப் போராட்ட வீரர் எனப் பன்முக ஆற்றல் கொண்டவர்.", "content_en": "Bharati possessed multifaceted genius as poet, essayist, journalist, social reformer, and freedom fighter."}, {"id": "S4", "content_ta": "இவர் 'இந்தியா', 'விஜயா' முதலான இதழ்களை நடத்தி விடுதலைப் போருக்கு வித்திட்டவர்; 'சந்திரிகையின் கதை', 'தராசு' உள்ளிட்ட உரைநடை நூல்களையும் எழுதியுள்ளார்.", "content_en": "He edited 'India' and 'Vijaya' fueling freedom struggle, and authored prose works like 'Chandrikaiyin Kathai' and 'Tharasu'."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bharathiyar", "tamilmozhi_vaazhthu", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q002", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-01-tamilmozhi-vaazhthu", "chapter_id": null, "topic_id": "ta-8th-u1-vaazhthu-vocabulary-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியாரின் 'தமிழ்மொழி வாழ்த்து' பாடலின் சொல்லும் பொருளும் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'நிரந்தரம்' என்பது 'காலம் முழுமையும்' என்றும், 'வைப்பு' என்பது 'நிலப்பகுதி' என்றும் பொருள்படும்.\n2. 'சூழ்கலி' என்பது 'மக்களைச் சூழ்ந்துள்ள அறியாமை இருள்' எனப் பொருள்படும்.\n3. 'தொல்லை வினைதரு தொல்லை' என்பதில் முன்னது 'பழமை' எனவும், பின்னது 'துன்பம்' எனவும் பொருள்படும்.\n4. 'வண்மொழி' என்பது 'வளமற்ற மொழி' என்றும், 'இசை' என்பது 'இசைக்கருவி' என்றும் பாடநூலில் பொருள்படும்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2, 3 சரியானவை; 4 தவறானது", "C": "கூற்றுகள் 1, 4 மட்டுமே சரியானவை", "D": "கூற்றுகள் 2, 3 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் பக்கம் 2: 'வண்மொழி' என்றால் 'வளமிக்க மொழி'; 'இசை' என்றால் 'புகழ்'. எனவே கூற்று 4 தவறானது; கூற்றுகள் 1, 2, 3 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on vocabulary from Bharati's 'Tamilmozhi Vaazhthu':\n1. 'Nirantharam' means 'eternity' and 'Vaippu' means 'land territory'.\n2. 'Soozhgali' denotes 'engulfing darkness of ignorance'.\n3. In 'Thollai vinaitharu thollai...', the first denotes 'antiquity' and second denotes 'distress'.\n4. 'Vanmozhi' denotes 'scanty language' and 'Isai' denotes 'musical instrument'.\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 2, 3 are correct; 4 is incorrect", "C": "Statements 1, 4 only are correct", "D": "Statements 2, 3 only are correct"}, "explanation": "Vanmozhi means 'fertile/resourceful tongue' and Isai means 'fame/glory'. Statement 4 is false; 1, 2, 3 are correct. Key B."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'நிரந்தரம்' என்பது 'காலம் முழுமையும்' என்றும், 'வைப்பு' என்பது 'நிலப்பகுதி' என்றும் பொருள்படும்.", "content_en": "'Nirantharam' signifies 'for all eternity' and 'Vaippu' signifies 'landmass / realm'."}, {"id": "S2", "content_ta": "'சூழ்கலி' என்பது 'மக்களைச் சூழ்ந்துள்ள அறியாமை இருள்' எனப் பொருள்படும்.", "content_en": "'Soozhgali' signifies 'the darkness of ignorance engulfing humanity'."}, {"id": "S3", "content_ta": "'தொல்லை வினைதரு தொல்லை அகன்று சுடர்க தமிழ்நாடு' என்பதில் முன்னுள்ள தொல்லை 'பழமை' எனவும், பின்னுள்ள தொல்லை 'துன்பம்' எனவும் பொருள்படும்.", "content_en": "In 'Thollai vinaitharu thollai...', the former means 'antiquity' and the latter means 'affliction'."}, {"id": "S4", "content_ta": "'வண்மொழி' என்பது 'வளமற்ற எளிய மொழி' என்றும், 'இசை' என்பது 'இசைக்கருவி' என்றும் பாடநூலில் பொருள்படும்.", "content_en": "'Vanmozhi' means 'scanty tongue' and 'Isai' means 'musical instrument' in the textbook glossary."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bharathiyar", "vocabulary", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q003", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-02-aazhikku-inai", "chapter_id": null, "topic_id": "ta-8th-u1-tamilazhaganar-author-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சந்தக்கவிமணி தமிழழகனார் மற்றும் அவரது படைப்பு குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. சந்தக்கவிமணி தமிழழகனாரின் இயற்பெயர் சண்முகசுந்தரம் என்பதாகும்.\n2. இவர் இளம் வயதிலேயே இலக்கணப் புலமை பெற்றுப் பன்னிரண்டு (12) சிற்றிலக்கிய நூல்களைப் படைத்துள்ளார்.\n3. 'ஆழிக்கு இணை' என்னும் இரட்டுற மொழிதல் பாடல் பாரதிதாசன் கவிதைகள் என்னும் நூலில் இருந்து எடுக்கப்பட்டது.\n4. இப்பாடல் இடம்பெற்றுள்ள 'தனிப்பாடல் திரட்டு' என்பது புலவர் பலரின் பாடல்களின் தொகுப்பு நூலாகும்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2 மட்டுமே சரியானவை", "C": "கூற்றுகள் 1, 2, 4 சரியானவை; 3 தவறானது", "D": "கூற்றுகள் 2, 3, 4 சரியானவை"}, "explanation": "பாடநூல் பக்கம் 6: 'ஆழிக்கு இணை' பாடல் 'தனிப்பாடல் திரட்டு' (ஐந்தாம் பகுதி - கழகப் பதிப்பு) என்னும் நூலில் இருந்து எடுத்தாளப்பட்டுள்ளது; பாரதிதாசன் கவிதைகள் அன்று. எனவே கூற்று 3 தவறானது; கூற்றுகள் 1, 2, 4 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements regarding Sandhakkavimani Tamilazhaganar and his work:\n1. His given birth name was Shanmugasundaram.\n2. He mastered grammar at an early age and authored 12 Sitrilakkiyam works.\n3. The verse 'Aazhikku Inai' was culled from Bharathidasan Kavithaigal.\n4. 'Thanippaadal Thirattu' is a classical anthology gathering verses of sundry poets.\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 2 only are correct", "C": "Statements 1, 2, 4 are correct; 3 is incorrect", "D": "Statements 2, 3, 4 are correct"}, "explanation": "'Aazhikku Inai' is from Thanippaadal Thirattu, not Bharathidasan Kavithaigal. Statement 3 is false; 1, 2, 4 are correct. Key C."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "சந்தக்கவிமணி தமிழழகனாரின் இயற்பெயர் சண்முகசுந்தரம் என்பதாகும்.", "content_en": "Sandhakkavimani Tamilazhaganar's birth name is Shanmugasundaram."}, {"id": "S2", "content_ta": "இவர் இளம் வயதிலேயே இலக்கணப் புலமையும் செய்யுள் இயற்றும் ஆற்றலும் பெற்றுப் பன்னிரண்டு (12) சிற்றிலக்கிய நூல்களைப் படைத்துள்ளார்.", "content_en": "Endowed with early mastery of prosody, he authored twelve minor literary works (Sitrilakkiyam)."}, {"id": "S3", "content_ta": "'ஆழிக்கு இணை' என்னும் இரட்டுற மொழிதல் பாடல் பாரதிதாசன் கவிதைகள் என்னும் நூலில் இருந்து எடுக்கப்பட்டது.", "content_en": "'Aazhikku Inai' was extracted from Bharathidasan Kavithaigal."}, {"id": "S4", "content_ta": "இப்பாடல் இடம்பெற்றுள்ள 'தனிப்பாடல் திரட்டு' என்பது பல்வேறு புலவர்கள் வெவ்வேறு காலங்களில் பாடிய தனிப்பாடல்களின் தொகுப்பு நூலாகும்.", "content_en": "'Thanippaadal Thirattu' is an anthology assembling verses by sundry poets across different epochs."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tamilazhaganar", "aazhikku_inai", "thanippaadal_thirattu", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q004", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-02-aazhikku-inai", "chapter_id": null, "topic_id": "ta-8th-u1-aazhikku-inai-siledai-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஆழிக்கு இணை' பாடலில் தமிழையும் கடலையும் ஒப்புநோக்கும் சிலேடை நயங்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. ஒரு சொல்லோ சொற்றொடரோ இரு பொருள்பட வருவது 'இரட்டுற மொழிதல்' (சிலேடை அணி) எனப்படும்.\n2. 'முத்தமிழ் துய்ப்பதால்' என்பது தமிழுக்கு இயல், இசை, நாடகத்தையும்; கடலுக்கு முத்தினை அமிழ்ந்து எடுத்தலையும் குறிக்கும்.\n3. 'முச்சங்கம் கண்டதால்' என்பது தமிழுக்கு முச்சங்கங்களையும்; கடலுக்கு மூன்று வகைச் சங்குகளையும் (வெண்சங்கு, சலஞ்சலம், பாஞ்சசன்யம்) குறிக்கும்.\n4. 'மெத்த வணிகலன்' என்பது கடலுக்கு ஐம்பெருங்காப்பியங்களையும்; தமிழுக்கு வணிகக் கப்பல்களையும் குறிக்கும்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 4 மட்டுமே சரியானவை", "C": "கூற்றுகள் 2, 4 மட்டுமே சரியானவை", "D": "கூற்றுகள் 1, 2, 3 சரியானவை; 4 தவறானது"}, "explanation": "பாடநூல் பக்கம் 6: 'மெத்த வணிகலன்' என்பது தமிழுக்கு 'ஐம்பெருங்காப்பியங்கள்' (மெத்த + அணிகலன்); கடலுக்கு 'மிகுதியான வணிகக் கப்பல்கள்' (மெத்த + வணிக கலம்). கூற்று 4-ல் இவை நேர்மாறாகக் குறிப்பிடப்பட்டுள்ளதால் கூற்று 4 தவறானது; 1, 2, 3 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Siledai parallels between Tamil and the Ocean:\n1. Words conveying dual connotations constitute Irattura Mozhithal (Siledai Ani).\n2. 'Muthamizh thuippathaal' links 3-fold Tamil to diving for ocean pearls.\n3. 'Muchangam kandathaal' links 3 literary Academies to 3 rare conch shells.\n4. 'Metha vanigalan' attributes the 5 Epics to the sea and merchant ships to Tamil.\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 4 only are correct", "C": "Statements 2, 4 only are correct", "D": "Statements 1, 2, 3 are correct; 4 is incorrect"}, "explanation": "'Metha vanigalan' means 5 Great Epics for Tamil and commercial ships for the ocean; Statement 4 inverts them and is false. Statements 1, 2, 3 are correct. Key D."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ஒரு சொல்லோ சொற்றொடரோ இரு பொருள்பட வருவது 'இரட்டுற மொழிதல்' அல்லது 'சிலேடை அணி' எனப்படும்.", "content_en": "When a single word or phrase yields two distinct meanings, it is called Irattura Mozhithal or Siledai."}, {"id": "S2", "content_ta": "'முத்தமிழ் துய்ப்பதால்' என்பது தமிழுக்கு இயல், இசை, நாடகம் என்ற முத்தமிழைக் குறிக்கும்; கடலுக்கு முத்தினை அமிழ்ந்து எடுத்தலைக் குறிக்கும்.", "content_en": "'Muthamizh thuippathaal' denotes Iyal, Isai, Naadagam for Tamil, and pearl retrieval for the ocean."}, {"id": "S3", "content_ta": "'முச்சங்கம் கண்டதால்' என்பது தமிழுக்கு முதற்சங்கம், இடைச்சங்கம், கடைச்சங்கம் ஆகியவற்றைக் குறிக்கும்; கடலுக்கு வெண்சங்கு, சலஞ்சலம், பாஞ்சசன்யம் ஆகிய மூன்று சங்குகளைத் தருதலைக் குறிக்கும்.", "content_en": "'Muchangam kandathaal' denotes 3 Sangams for Tamil, and 3 divine conch types for the sea."}, {"id": "S4", "content_ta": "'மெத்த வணிகலன்' என்பது கடலுக்கு ஐம்பெருங்காப்பியங்களைக் குறிக்கும்; தமிழுக்கு மிகுதியான வணிகக் கப்பல்களைக் குறிக்கும்.", "content_en": "'Metha vanigalan' denotes the 5 Great Epics for the ocean and commercial vessels for Tamil."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tamilazhaganar", "siledai", "irattura_mozhithal", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q005", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-02-aazhikku-inai", "chapter_id": null, "topic_id": "ta-8th-u1-aazhikku-inai-meaning-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழுக்கும் கடலுக்குமான இரட்டுற மொழிதல் சொல்லாட்சி விளக்கங்கள் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'துய்ப்பதால்' என்பதற்குத் தமிழில் 'கற்பதால்' என்பதும், கடலில் 'தருதலால்' என்பதும் பொருளாகும்.\n2. 'மேவலால்' என்பதற்குத் தமிழில் 'பொருந்துதலால்' என்பதும், கடலில் 'பெறுதலால்' என்பதும் பொருளாகும்.\n3. 'சங்கத்தவர் காக்க' என்பது தமிழைக் காக்கச் சங்கப்பலகையில் அமர்ந்திருந்த புலவர்கள் காத்தமையைக் குறிக்கும்.\n4. கடலானது தன் அலையால் சங்கினைத் தடுத்து நிறுத்திக் காப்பதை 'அணை கிடந்தே' என்னும் தொடர் குறிக்கிறது.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2 மட்டுமே சரியானவை", "C": "கூற்றுகள் 1, 3, 4 சரியானவை; 2 தவறானது", "D": "கூற்றுகள் 2, 4 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் பக்கம் 5-6: துய்ப்பதால் (கற்பதால்/தருதலால்), மேவலால் (பொருந்துதலால்/பெறுதலால்), சங்கத்தவர் காக்க (புலவர்கள்/அலைகள் காக்க) ஆகிய சொல்லாட்சி விளக்கங்கள் நான்கும் துல்லியமானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements expounding the dual nuances between Tamil and Ocean:\n1. 'Thuippathaal' translates to 'by learning' for Tamil and 'by yielding' for the sea.\n2. 'Mevalaal' translates to 'by suiting' for Tamil and 'by attaining' for the sea.\n3. 'Sangathavar kaakka' refers to the venerated poets of the Sangam bench guarding Tamil.\n4. 'Anai kidanthey' depicts the ocean restraining and protecting conches with its billows.\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 2 only are correct", "C": "Statements 1, 3, 4 are correct; 2 is incorrect", "D": "Statements 2, 4 only are correct"}, "explanation": "Textbook pages 5-6: All four analytical statements on Siledai vocabulary are completely valid. Key A."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'துய்ப்பதால்' என்பதற்குத் தமிழில் 'கற்பதால்' என்பதும், கடலில் 'தருதலால்' என்பதும் பொருளாகும்.", "content_en": "'Thuippathaal' means 'by learning' for Tamil and 'by yielding' for the ocean."}, {"id": "S2", "content_ta": "'மேவலால்' என்பதற்குத் தமிழில் 'பொருந்துதலால்' என்பதும், கடலில் 'பெறுதலால்' என்பதும் பொருளாகும்.", "content_en": "'Mevalaal' means 'by matching/suiting' for Tamil and 'by receiving/attaining' for the ocean."}, {"id": "S3", "content_ta": "'சங்கத்தவர் காக்க' என்பது தமிழைக் காக்கச் சங்கப்பலகையில் அமர்ந்திருந்த புலவர்கள் காத்தமையைக் குறிக்கும்.", "content_en": "'Sangathavar kaakka' refers to Sangam poets safeguarding Tamil atop the Sangam plank."}, {"id": "S4", "content_ta": "'அணை கிடந்தே ஆழிக்கு இணை கிடந்ததே தமிழ் ஈண்டு' என்பது கடலானது தன் அலையால் சங்கினைத் தடுத்து நிறுத்திக் காப்பதை உவமித்துக் கூறுகிறது.", "content_en": "'Anai kidanthey...' describes the ocean's rolling waves sheltering conches as parallel to Tamil."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tamilazhaganar", "vocabulary", "siledai", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q006", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-01-tamilmozhi-vaazhthu", "chapter_id": null, "topic_id": "ta-8th-u1-bharati-epithets-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியாரின் புகழுரைகள் மற்றும் இலக்கியப் பங்களிப்புகள் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'சிந்துக்குத் தந்தை', 'செந்தமிழ்த் தேனீ', 'புதிய அறம்பாட வந்த அறிஞன்' எனப் பாரதியாரைப் புகழ்ந்தவர் பாரதிதாசன் ஆவார்.\n2. 'பாட்டுக்கொரு புலவன் பாரதி' என்று பாரதியாரைப் போற்றியவர் கவிமணி தேசிக விநாயகம் பிள்ளை ஆவார்.\n3. 'ஏழ்கடல் வைப்பினும் தன்மணம் வீசி இசை கொண்டு வாழியவே' என்று பாரதியார் தமிழை வாழ்த்துகிறார்.\n4. பாரதியார் 'The Light of Asia' என்ற நூலைத் தழுவி 'ஆசிய ஜோதி' என்னும் நூலைத் தமிழில் எழுதினார்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2, 3 சரியானவை; 4 தவறானது", "C": "கூற்றுகள் 1, 4 மட்டுமே சரியானவை", "D": "கூற்றுகள் 2, 3 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் பக்கம் 3: 'ஆசிய ஜோதி' நூலை எழுதியவர் கவிமணி தேசிக விநாயகம் பிள்ளை ஆவார்; பாரதியார் அன்று. எனவே கூற்று 4 தவறானது; கூற்றுகள் 1, 2, 3 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements regarding accolades bestowed upon Bharati and his works:\n1. Bharathidasan eulogized him as 'Sindhukku Thanthai', 'Senthamizh Thenee', and 'New moral philosopher'.\n2. Kavimani Desigavinayagam Pillai hailed him as 'Paattukkoru Pulavan Bharati'.\n3. Bharati sang 'Eazhkadal vaippinum than manam veesi...'.\n4. Bharati authored 'Aasiya Jothi' adapting Edwin Arnold's 'The Light of Asia'.\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 2, 3 are correct; 4 is incorrect", "C": "Statements 1, 4 only are correct", "D": "Statements 2, 3 only are correct"}, "explanation": "'Aasiya Jothi' was authored by Kavimani, not Bharati. Statement 4 is false; 1, 2, 3 are true. Key B."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'சிந்துக்குத் தந்தை', 'செந்தமிழ்த் தேனீ', 'புதிய அறம்பாட வந்த அறிஞன்', 'மறம்பாட வந்த மறவன்' என்றெல்லாம் பாரதியாரைப் புகழ்ந்தவர் பாரதிதாசன் ஆவார்.", "content_en": "Bharathidasan praised Bharati as 'Father of Sindhu', 'Honeybee of Classical Tamil', etc."}, {"id": "S2", "content_ta": "'பாட்டுக்கொரு புலவன் பாரதி' என்று பாரதியாரைப் போற்றிப் பாராட்டியவர் கவிமணி தேசிக விநாயகம் பிள்ளை ஆவார்.", "content_en": "Kavimani Desigavinayagam Pillai lauded Bharati as 'Paattukkoru Pulavan Bharati'."}, {"id": "S3", "content_ta": "'ஏழ்கடல் வைப்பினும் தன்மணம் வீசி இசை கொண்டு வாழியவே' என்று பாரதியார் தமிழ்மொழியைப் போற்றுகிறார்.", "content_en": "Bharati extols Tamil's fragrance resounding across the seven seas."}, {"id": "S4", "content_ta": "பாரதியார் ஆங்கிலக் கவிஞர் எட்வின் அர்னால்டின் 'The Light of Asia' என்ற நூலைத் தழுவி 'ஆசிய ஜோதி' என்னும் நூலை எழுதினார்.", "content_en": "Bharati translated Edwin Arnold's 'The Light of Asia' into 'Aasiya Jothi'."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bharathiyar", "kavimani", "bharathidasan", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q007", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-02-aazhikku-inai", "chapter_id": null, "topic_id": "ta-8th-u1-conch-types-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கடல் தரும் சங்குகள் மற்றும் தமிழழகனாரின் சிறப்புகள் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. கடலானது வெண்சங்கு, சலஞ்சலம், பாஞ்சசன்யம் என்னும் மூன்று வகையான சங்குகளைத் தருகிறது.\n2. 'ஆழி' என்பது கடலையும், 'நித்தம்' என்பது நாள்தோறும் என்பதையும் குறிக்கும்.\n3. 'சலஞ்சலம்' என்பது கடலில் விளையும் ஒருவகை அரிய பவளக் கொடியைக் குறிக்கும் சொல்லாகும்.\n4. தமிழழகனார் செய்யுளிலும் உரைநடையிலும் மேடைப் பேச்சிலும் சிலேடைகளைப் பயன்படுத்துவதில் வல்லவர் ஆவார்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2 மட்டுமே சரியானவை", "C": "கூற்றுகள் 1, 2, 4 சரியானவை; 3 தவறானது", "D": "கூற்றுகள் 3, 4 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் பக்கம் 6: 'சலஞ்சலம்' என்பது கடலில் விளையும் மூன்று வகைச் சங்குகளுள் ஒன்று; பவளக் கொடி அன்று. எனவே கூற்று 3 தவறானது; கூற்றுகள் 1, 2, 4 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on ocean conches and Tamilazhaganar's mastery:\n1. The sea yields 3 distinct conches: Vensangu, Salanjalam, and Paanjajanyam.\n2. 'Aazhi' means ocean and 'Nitham' means everyday.\n3. 'Salanjalam' refers to a precious type of ocean coral.\n4. Tamilazhaganar was renowned for his deft use of puns in poetry, prose, and speech.\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 2 only are correct", "C": "Statements 1, 2, 4 are correct; 3 is incorrect", "D": "Statements 3, 4 only are correct"}, "explanation": "Salanjalam is one of the three prime conch types, not coral. Statement 3 is false; 1, 2, 4 are correct. Key C."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "கடலானது வெண்சங்கு, சலஞ்சலம், பாஞ்சசன்யம் என்னும் மூன்று வகையான சங்குகளைத் தருகிறது.", "content_en": "The ocean yields three prized conch forms: Vensangu, Salanjalam, and Paanjajanyam."}, {"id": "S2", "content_ta": "'ஆழி' என்பது கடலையும், 'நித்தம்' என்பது நாள்தோறும் என்பதையும் குறிக்கும்.", "content_en": "'Aazhi' denotes the sea and 'Nitham' denotes daily/unceasingly."}, {"id": "S3", "content_ta": "'சலஞ்சலம்' என்பது கடலில் விளையும் ஒருவகை அரிய பவளக் கொடியைக் குறிக்கும் சொல்லாகும்.", "content_en": "'Salanjalam' denotes a rare variety of marine coral reef."}, {"id": "S4", "content_ta": "சந்தக்கவிமணி தமிழழகனார் செய்யுளிலும் உரைநடையிலும் மேடைப் பேச்சிலும் சிலேடைகளைப் பயன்படுத்துவதில் வல்லவர் ஆவார்.", "content_en": "Sandhakkavimani excelled in deploying double entendres across poetry, prose, and oratory."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tamilazhaganar", "conch_types", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q008", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-02-aazhikku-inai", "chapter_id": null, "topic_id": "ta-8th-u1-aazhikku-inai-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'மெத்த வணிகலமும் மேவலால்' என்ற தொடரில் தமிழுக்குப் பெருமை சேர்க்கும் அணிகலன்களாகப் பாரதியாரின் நூல்களே சுட்டப்படுகின்றன.\nகாரணம் (R): தமிழழகனாரின் 'ஆழிக்கு இணை' பாடலில் தமிழுக்கும் கடலுக்கும் ஒரே சொல்லமைப்பில் இரு வேறு பொருள்கள் பொருந்துமாறு பாடப்பட்டுள்ளதால் இது இரட்டுற மொழிதல் அணிக்குச் சிறந்த சான்றாகும்.\n\nஇவற்றுள் சரியான தெரிவைத் தேர்வு செய்க:"}], "options": {"A": "கூற்று (A) சரி, காரணம் (R) சரி; கூற்றிற்கான சரியான விளக்கம் காரணம் ஆகும்.", "B": "கூற்று (A) சரி, காரணம் (R) சரி; ஆனால் கூற்றிற்கான சரியான விளக்கம் காரணம் அன்று.", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "D": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி."}, "explanation": "பாடநூல் பக்கம் 6: 'மெத்த வணிகலன்' என்பது தமிழுக்கு ஐம்பெருங்காப்பியங்களை (சிலப்பதிகாரம், மணிமேகலை முதலியன) அணிகலன்களாகக் குறிக்கிறது; பாரதியார் நூல்களை அன்று. எனவே கூற்று (A) தவறு; காரணம் (R) இரட்டுற மொழிதல் அணியின் சரியான விளக்கமாதலால் சரி. சரியான தெரிவு D."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'மெத்த வணிகலமும் மேவலால்' என்ற தொடரில் தமிழுக்குப் பெருமை சேர்க்கும் அணிகலன்களாகப் பாரதியாரின் நூல்களே சுட்டப்படுகின்றன.\nReason (R): தமிழழகனாரின் 'ஆழிக்கு இணை' பாடலில் தமிழுக்கும் கடலுக்கும் ஒரே சொல்லமைப்பில் இரு வேறு பொருள்கள் பொருந்துமாறு பாடப்பட்டுள்ளதால் இது இரட்டுற மொழிதல் அணிக்குச் சிறந்த சான்றாகும்.\n\nSelect the correct option:"}], "options": {"A": "Both (A) and (R) are correct, and (R) is the correct explanation of (A).", "B": "Both (A) and (R) are correct, but (R) is not the correct explanation of (A).", "C": "(A) is correct, but (R) is incorrect.", "D": "(A) is incorrect, but (R) is correct."}, "explanation": "Metha Vanigalan for Tamil refers to the Five Great Epics, not Bharati's poems. Thus Assertion (A) is false; Reason (R) is true. Key D."}}, "question_data": {"assertion": "'மெத்த வணிகலமும் மேவலால்' என்ற தொடரில் தமிழுக்குப் பெருமை சேர்க்கும் அணிகலன்களாகப் பாரதியாரின் நூல்களே சுட்டப்படுகின்றன.", "reason": "தமிழழகனாரின் 'ஆழிக்கு இணை' பாடலில் தமிழுக்கும் கடலுக்கும் ஒரே சொல்லமைப்பில் இரு வேறு பொருள்கள் பொருந்துமாறு பாடப்பட்டுள்ளதால் இது இரட்டுற மொழிதல் அணிக்குச் சிறந்த சான்றாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tamilazhaganar", "siledai", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q009", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-01-tamilmozhi-vaazhthu", "chapter_id": null, "topic_id": "ta-8th-u1-bharati-vaazhthu-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): பாரதியார் தமிழ்மொழியை வாழ்த்தும்போது 'எங்கள் தமிழ்மொழி! எங்கள் தமிழ்மொழி! என்றென்றும் வாழியவே!' என்று நெஞ்சாரப் போற்றுகிறார்.\nகாரணம் (R): தமிழ்மொழி வானம் அறிந்த அனைத்தையும் அறிந்து மேலும் மேலும் நாளும் வளரும் வளமிக்க மொழி என்பதனால் பாரதியார் இவ்வாறு வாழ்த்துகிறார்.\n\nஇவற்றுள் சரியான தெரிவைத் தேர்வு செய்க:"}], "options": {"A": "கூற்று (A) சரி, காரணம் (R) சரி; கூற்றிற்கான சரியான விளக்கம் காரணம் ஆகும்.", "B": "கூற்று (A) சரி, காரணம் (R) சரி; ஆனால் கூற்றிற்கான சரியான விளக்கம் காரணம் அன்று.", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "D": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி."}, "explanation": "பாடநூல் பக்கம் 2: 'வானம் அறிந்ததனைத்தும் அறிந்து வளர்மொழி வாழியவே' என பாரதியார் தமிழ் காலந்தோறும் வளர்ந்து வரும் செழுமையை விளக்கியே வாழ்த்துகிறார். கூற்றும் காரணமும் சரி; காரணம் கூற்றை முழுமையாக விளக்குகிறது. சரியான தெரிவு A."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): பாரதியார் தமிழ்மொழியை வாழ்த்தும்போது 'எங்கள் தமிழ்மொழி! எங்கள் தமிழ்மொழி! என்றென்றும் வாழியவே!' என்று நெஞ்சாரப் போற்றுகிறார்.\nReason (R): தமிழ்மொழி வானம் அறிந்த அனைத்தையும் அறிந்து மேலும் மேலும் நாளும் வளரும் வளமிக்க மொழி என்பதனால் பாரதியார் இவ்வாறு வாழ்த்துகிறார்.\n\nSelect the correct option:"}], "options": {"A": "Both (A) and (R) are correct, and (R) is the correct explanation of (A).", "B": "Both (A) and (R) are correct, but (R) is not the correct explanation of (A).", "C": "(A) is correct, but (R) is incorrect.", "D": "(A) is incorrect, but (R) is correct."}, "explanation": "Bharati hails Tamil because it masters and integrates all universal wisdom through time. Both are correct, and R explains A. Key A."}}, "question_data": {"assertion": "பாரதியார் தமிழ்மொழியை வாழ்த்தும்போது 'எங்கள் தமிழ்மொழி! எங்கள் தமிழ்மொழி! என்றென்றும் வாழியவே!' என்று நெஞ்சாரப் போற்றுகிறார்.", "reason": "தமிழ்மொழி வானம் அறிந்த அனைத்தையும் அறிந்து மேலும் மேலும் நாளும் வளரும் வளமிக்க மொழி என்பதனால் பாரதியார் இவ்வாறு வாழ்த்துகிறார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bharathiyar", "tamilmozhi_vaazhthu", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q010", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-02-aazhikku-inai", "chapter_id": null, "topic_id": "ta-8th-u1-author-and-ocean-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): சந்தக்கவிமணி தமிழழகனார் இளம் வயதிலேயே செய்யுள் இயற்றும் பேராற்றல் கொண்டு பன்னிரண்டு சிற்றிலக்கியங்களைப் படைத்துள்ளார்.\nகாரணம் (R): கடலானது மிகுதியான வணிகக் கப்பல்கள் செல்லும் வண்ணம் தன் பரந்த நீர்ப்பரப்பைக் கொண்டுள்ளது.\n\nஇவற்றுள் சரியான தெரிவைத் தேர்வு செய்க:"}], "options": {"A": "கூற்று (A) சரி, காரணம் (R) சரி; கூற்றிற்கான சரியான விளக்கம் காரணம் ஆகும்.", "B": "கூற்று (A) சரி, காரணம் (R) சரி; ஆனால் கூற்றிற்கான சரியான விளக்கம் காரணம் அன்று.", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "D": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி."}, "explanation": "பாடநூல் பக்கம் 6: கூற்று (A) தமிழழகனாரின் இளமைக்கால சிற்றிலக்கியப் புலமை குறித்த உண்மை. காரணம் (R) கடலின் வணிகப் போக்குவரத்துப் பயன் குறித்த உண்மை. இரண்டும் தனித்தனியே சரியானவை; ஆனால் காரணம் கூற்றிற்கான விளக்கம் அன்று. சரியான தெரிவு B."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): சந்தக்கவிமணி தமிழழகனார் இளம் வயதிலேயே செய்யுள் இயற்றும் பேராற்றல் கொண்டு பன்னிரண்டு சிற்றிலக்கியங்களைப் படைத்துள்ளார்.\nReason (R): கடலானது மிகுதியான வணிகக் கப்பல்கள் செல்லும் வண்ணம் தன் பரந்த நீர்ப்பரப்பைக் கொண்டுள்ளது.\n\nSelect the correct option:"}], "options": {"A": "Both (A) and (R) are correct, and (R) is the correct explanation of (A).", "B": "Both (A) and (R) are correct, but (R) is not the correct explanation of (A).", "C": "(A) is correct, but (R) is incorrect.", "D": "(A) is incorrect, but (R) is correct."}, "explanation": "Both statements are independently true per textbook page 6, but (R) does not explain (A). Key B."}}, "question_data": {"assertion": "சந்தக்கவிமணி தமிழழகனார் இளம் வயதிலேயே செய்யுள் இயற்றும் பேராற்றல் கொண்டு பன்னிரண்டு சிற்றிலக்கியங்களைப் படைத்துள்ளார்.", "reason": "கடலானது மிகுதியான வணிகக் கப்பல்கள் செல்லும் வண்ணம் தன் பரந்த நீர்ப்பரப்பைக் கொண்டுள்ளது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tamilazhaganar", "ocean", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q011", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-01-tamilmozhi-vaazhthu", "chapter_id": null, "topic_id": "ta-8th-u1-thollai-meaning-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'தொல்லை வினைதரு தொல்லை அகன்று சுடர்க தமிழ்நாடே' என்று பாரதியார் தமிழ்நாட்டின் அறியாமைத் துன்பங்கள் நீங்கி ஒளிர வாழ்த்துகிறார்.\nகாரணம் (R): இப்பாடல் அடியில் வரும் முன்னைய 'தொல்லை' என்பது புதிய நாகரிகத்தையும், பின்னைய 'தொல்லை' என்பது செல்வ வளத்தையும் மட்டுமே குறிக்கும்.\n\nஇவற்றுள் சரியான தெரிவைத் தேர்வு செய்க:"}], "options": {"A": "கூற்று (A) சரி, காரணம் (R) சரி; கூற்றிற்கான சரியான விளக்கம் காரணம் ஆகும்.", "B": "கூற்று (A) சரி, காரணம் (R) சரி; ஆனால் கூற்றிற்கான சரியான விளக்கம் காரணம் அன்று.", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "D": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி."}, "explanation": "பாடநூல் பக்கம் 2: 'தொல்லை' என்பதற்குப் பாடநூலில் 'பழமை' மற்றும் 'துன்பம்' என்றே பொருளுரைக்கப்பட்டுள்ளது; புதிய நாகரிகம் அல்லது செல்வ வளம் அன்று. எனவே கூற்று (A) சரி; காரணம் (R) தவறு. சரியான தெரிவு C."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'தொல்லை வினைதரு தொல்லை அகன்று சுடர்க தமிழ்நாடே' என்று பாரதியார் தமிழ்நாட்டின் அறியாமைத் துன்பங்கள் நீங்கி ஒளிர வாழ்த்துகிறார்.\nReason (R): இப்பாடல் அடியில் வரும் முன்னைய 'தொல்லை' என்பது புதிய நாகரிகத்தையும், பின்னைய 'தொல்லை' என்பது செல்வ வளத்தையும் மட்டுமே குறிக்கும்.\n\nSelect the correct option:"}], "options": {"A": "Both (A) and (R) are correct, and (R) is the correct explanation of (A).", "B": "Both (A) and (R) are correct, but (R) is not the correct explanation of (A).", "C": "(A) is correct, but (R) is incorrect.", "D": "(A) is incorrect, but (R) is correct."}, "explanation": "Thollai means antiquity and affliction, not modern civilization or wealth. Assertion (A) is true; Reason (R) is false. Key C."}}, "question_data": {"assertion": "'தொல்லை வினைதரு தொல்லை அகன்று சுடர்க தமிழ்நாடே' என்று பாரதியார் தமிழ்நாட்டின் அறியாமைத் துன்பங்கள் நீங்கி ஒளிர வாழ்த்துகிறார்.", "reason": "இப்பாடல் அடியில் வரும் முன்னைய 'தொல்லை' என்பது புதிய நாகரிகத்தையும், பின்னைய 'தொல்லை' என்பது செல்வ வளத்தையும் மட்டுமே குறிக்கும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bharathiyar", "vocabulary", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q012", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-02-aazhikku-inai", "chapter_id": null, "topic_id": "ta-8th-u1-muchangam-conch-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'முச்சங்கம் கண்டதால்' என்ற தொடரில் கடலானது தமிழ் வளர்த்த முச்சங்கங்களுக்கும் முத்துக்களையும் அணிகலன்களையும் அள்ளிக் கொடையாக வழங்கியதையே குறிக்கிறது.\nகாரணம் (R): சங்க இலக்கியங்கள் மற்றும் உரைகளில் கடல் தரும் சிறந்த சங்குகளாக வெண்சங்கு, சலஞ்சலம், பாஞ்சசன்யம் என்னும் மூன்று வகைச் சங்குகள் குறிப்பிடப்பட்டுள்ளன.\n\nஇவற்றுள் சரியான தெரிவைத் தேர்வு செய்க:"}], "options": {"A": "கூற்று (A) சரி, காரணம் (R) சரி; கூற்றிற்கான சரியான விளக்கம் காரணம் ஆகும்.", "B": "கூற்று (A) சரி, காரணம் (R) சரி; ஆனால் கூற்றிற்கான சரியான விளக்கம் காரணம் அன்று.", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "D": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி."}, "explanation": "பாடநூல் பக்கம் 6: கடலுக்கு 'முச்சங்கம் கண்டதால்' என்பது வெண்சங்கு, சலஞ்சலம், பாஞ்சசன்யம் என்னும் மூன்று வகையான சங்குகளைத் தருவதைக் குறிக்கும்; சங்கங்களுக்கு கொடை கொடுத்ததை அன்று. எனவே கூற்று (A) தவறு; காரணம் (R) சரி. சரியான தெரிவு D."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'முச்சங்கம் கண்டதால்' என்ற தொடரில் கடலானது தமிழ் வளர்த்த முச்சங்கங்களுக்கும் முத்துக்களையும் அணிகலன்களையும் அள்ளிக் கொடையாக வழங்கியதையே குறிக்கிறது.\nReason (R): சங்க இலக்கியங்கள் மற்றும் உரைகளில் கடல் தரும் சிறந்த சங்குகளாக வெண்சங்கு, சலஞ்சலம், பாஞ்சசன்யம் என்னும் மூன்று வகைச் சங்குகள் குறிப்பிடப்பட்டுள்ளன.\n\nSelect the correct option:"}], "options": {"A": "Both (A) and (R) are correct, and (R) is the correct explanation of (A).", "B": "Both (A) and (R) are correct, but (R) is not the correct explanation of (A).", "C": "(A) is correct, but (R) is incorrect.", "D": "(A) is incorrect, but (R) is correct."}, "explanation": "For the sea, Muchangam denotes yielding 3 types of conch shells, not sponsoring literary Sangams. Assertion (A) is false; Reason (R) is true. Key D."}}, "question_data": {"assertion": "'முச்சங்கம் கண்டதால்' என்ற தொடரில் கடலானது தமிழ் வளர்த்த முச்சங்கங்களுக்கும் முத்துக்களையும் அணிகலன்களையும் அள்ளிக் கொடையாக வழங்கியதையே குறிக்கிறது.", "reason": "சங்க இலக்கியங்கள் மற்றும் உரைகளில் கடல் தரும் சிறந்த சங்குகளாக வெண்சங்கு, சலஞ்சலம், பாஞ்சசன்யம் என்னும் மூன்று வகைச் சங்குகள் குறிப்பிடப்பட்டுள்ளன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tamilazhaganar", "siledai", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_a