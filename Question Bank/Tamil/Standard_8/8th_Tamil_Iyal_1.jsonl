// பாடம் 6: இயல் 1 முழுமைத் தொகுப்பு (மொழியோடு விளையாடு, கலைச்சொற்கள் & பாவேந்தர் பாரதிதாசன் சிந்தனைகள்) [Q113 - Q140]
// பாவேந்தர் பாரதிதாசன் (சுப்புரத்தினம், புதுச்சேரி, பாண்டியன் பரிசு, அழகின் சிரிப்பு, குடும்ப விளக்கு, இருண்ட வீடு, இசையமுது; 'பெண்ணடிமை தீராதவரை மண்ணடிமை தீராது', 'கல்வியில்லாப் பெண்கள் களர்நிலம்'); பன்மை விகுதிப் புணர்ச்சி (பூக்கள், மரங்கள், புற்கள், பற்கள்); அகரவரிசைப்படுத்துதல்; பலபொருள் ஒரு சொல் (படி, திங்கள், ஆறு, அணி); சிலேடை (Pun); கலைச்சொற்கள் (Articulatory phonetics, Vowel, Consonant, Nasal sound, Epigraph, Lexicography, Phoneme, Pictograph, Pun)
// ==============================================================================
{"id": "8th-u1-q113", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-05b-iyal1-integration", "chapter_id": null, "topic_id": "ta-8th-u1-bharathidasan-thoughts-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல் 1 மொழித்திறன் பகுதியில் இடம்பெற்றுள்ள பாவேந்தர் பாரதிதாசன் பற்றிய கூற்றுகளை ஆராய்க:\n1. பாரதிதாசனின் இயற்பெயர் சுப்புரத்தினம்; பாரதியார் மீது கொண்ட பற்றால் பாரதிதாசன் எனப் பெயர் மாற்றினார்.\n2. பாண்டியன் பரிசு, அழகின் சிரிப்பு, குடும்ப விளக்கு, இருண்ட வீடு, இசையமுது ஆகியவற்றை இயற்றினார்.\n3. 'பெண்ணடிமை தீராதவரை மண்ணடிமை தீராது' என்று சமூக விடுதலைக்காக முழங்கினார்.\n4. 'கல்வியில்லாப் பெண்கள் களர்நிலம்' என்று பெண் கல்வியின் தேவையை வலியுறுத்தினார்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2 மட்டுமே சரியானவை", "C": "கூற்றுகள் 2, 3, 4 மட்டுமே சரியானவை", "D": "கூற்றுகள் 1, 3, 4 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் பக்கம் 20-21: புரட்சிக் கவிஞர் பாரதிதாசனின் இயற்பெயர் சுப்புரத்தினம், நூல்கள், பெண்ணடிமை தீராதவரை மண்ணடிமை தீராது, கல்வியில்லாப் பெண்கள் களர்நிலம் உள்ளிட்ட நான்கு கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Pavendhar Bharathidasan from Unit 1 language competency:\n1. Bharathidasan's birth name was Subburathinam; changed it out of devotion to Bharati.\n2. He composed Pandiyan Parisu, Azhagin Sirippu, Kudumba Vilakku, Irunda Veedu, Isaiyamudhu.\n3. He declared 'Until women's bondage ends, the nation's bondage will never end'.\n4. He emphasized female education stating 'Uneducated women are alkaline barren lands'.\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 2 only are correct", "C": "Statements 2, 3, 4 only are correct", "D": "Statements 1, 3, 4 only are correct"}, "explanation": "Textbook pages 20-21: All 4 statements correctly represent Bharathidasan's biography, literary works, and social reform philosophy."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "புரட்சிக் கவிஞர் பாரதிதாசனின் இயற்பெயர் சுப்புரத்தினம் என்பதாகும்; பாரதியாரின் மீது கொண்ட பற்றினால் பாரதிதாசன் எனப் பெயர் மாற்றிக்கொண்டார்.", "content_en": "Puratchi Kavignar Bharathidasan's original name was Subburathinam; he adopted Bharathidasan due to devotion to Bharati."}, {"id": "S2", "content_ta": "இவர் 'பாண்டியன் பரிசு', 'அழகின் சிரிப்பு', 'குடும்ப விளக்கு', 'இருண்ட வீடு', 'இசையமுது' உள்ளிட்ட பல சிறந்த நூல்களைப் படைத்துள்ளார்.", "content_en": "He authored celebrated works including Pandiyan Parisu, Azhagin Sirippu, Kudumba Vilakku, Irunda Veedu, and Isaiyamudhu."}, {"id": "S3", "content_ta": "'பெண்ணடிமை தீராதவரை மண்ணடிமை தீராது' என்று பெண்ணுரிமைக்காக ஓங்கி ஒலித்தவர் பாரதிதாசன் ஆவார்.", "content_en": "Bharathidasan proclaimed: 'Until women's subjugation ends, the subjugation of the land will not end.'"}, {"id": "S4", "content_ta": "பெண்கள் கல்வி கற்க வேண்டியதன் இன்றியமையாமையை 'கல்வியில்லாப் பெண்கள் களர்நிலம்' என்று கடிந்து உரைத்துள்ளார்.", "content_en": "He stressed the urgency of female education by declaring: 'Women devoid of education are barren alkaline lands'."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 20, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bharathidasan", "social_reform", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q114", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-05b-iyal1-integration", "chapter_id": null, "topic_id": "ta-8th-u1-script-reform-concepts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உலக மொழிகளில் நிகழும் 'எழுத்துச் சீர்திருத்தம்' பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. ஒரு வரிவடிவத்தை விட்டு மற்றொரு வரிவடிவத்தை ஏற்றுக் கொள்ளுதல்.\n2. இருக்கின்ற வரிவடிவத்தில் தேவையான திருத்தங்களைச் செய்து கொள்ளுதல்.\n3. எழுத்துகளின் எண்ணிக்கையில் மாற்றங்களைச் செய்து கொள்ளுதல்.\n4. எழுத்துச் சீர்திருத்தம் என்பது வரிவடிவ மாற்றத்தை ஒருபோதும் ஏற்காது.\nஇவற்றுள் தவறான கூற்று எது?"}], "options": {"A": "கூற்று 2 தவறானது", "B": "கூற்று 4 தவறானது", "C": "கூற்று 1 தவறானது", "D": "கூற்று 3 தவறானது"}, "explanation": "பாடநூல் பக்கம் 20: கூற்று 4 தவறானது. வரிவடிவ மாற்றம், வரிவடிவத் திருத்தம், எழுத்துகளின் எண்ணிக்கை மாற்றம் ஆகிய மூன்றுமே 'எழுத்துச் சீர்திருத்தம்' என்று அழைக்கப்படுகின்றன எனப் பாடநூல் தெளிவாக விளக்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements regarding 'Script Reform' occurring across global languages:\n1. Transitioning from one graphic script to another.\n2. Introducing necessary systematic corrections in the existing script.\n3. Rationalizing or altering the count and inventory of characters.\n4. Script reform strictly rejects any change to graphic letterforms.\nWhich statement is INCORRECT?"}], "options": {"A": "Statement 2 is incorrect", "B": "Statement 4 is incorrect", "C": "Statement 1 is incorrect", "D": "Statement 3 is incorrect"}, "explanation": "Textbook page 20: Statement 4 is incorrect because script modification is the very essence of script reform."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "எழுத்துச் சீர்திருத்தம் என்பது ஒரு வரிவடிவத்தை விட்டு மற்றொரு வரிவடிவத்தை ஏற்றுக்கொள்வதையும் குறிக்கும்.", "content_en": "Script reform can involve abandoning one script to adopt an entirely different script."}, {"id": "S2", "content_ta": "இருக்கின்ற வரிவடிவத்தில் தேவையான திருத்தங்களைச் செய்து கொள்வதும் எழுத்துச் சீர்திருத்தத்துள் அடங்கும்.", "content_en": "Making necessary typographic and functional corrections in an existing script is part of script reform."}, {"id": "S3", "content_ta": "எழுத்துகளின் எண்ணிக்கையை அதிகரித்துக் கொள்ளுதல் அல்லது குறைத்துக் கொள்ளுதலும் எழுத்துச் சீர்திருத்தத்தின் கூறுகளாகும்.", "content_en": "Modifying, increasing, or rationalizing the inventory of graphemes is an element of script reform."}, {"id": "S4", "content_ta": "எழுத்துச் சீர்திருத்தம் என்பது ஒருபோதும் மொழியின் ஒலியையோ எழுத்து வடிவங்களையோ மாற்ற அனுமதிக்காது.", "content_en": "Script reform strictly prohibits any modification of sounds or grapheme shapes in a language."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 20, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["script_reform", "statement_analysis", "linguistics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q115", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-05b-iyal1-integration", "chapter_id": null, "topic_id": "ta-8th-u1-linguistics-glossary-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல் 1-ல் இடம்பெற்றுள்ள மொழியியல் மற்றும் தமிழியல் கலைச்சொற்கள் குறித்த கூற்றுகளை ஆராய்க:\n1. ஒலிபிறப்பியல் - Articulatory phonetics\n2. ஒலியன் - Phoneme\n3. அகராதியியல் - Lexicography\n4. கல்வெட்டு - Epigraph\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2 மட்டுமே சரியானவை", "B": "கூற்றுகள் 2, 3, 4 மட்டுமே சரியானவை", "C": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "D": "கூற்றுகள் 1, 3 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் பக்கம் 22 கலைச்சொல் அறிவோம்: Articulatory phonetics = ஒலிபிறப்பியல்; Phoneme = ஒலியன்; Lexicography = அகராதியியல்; Epigraph = கல்வெட்டு; Nasal consonant sound = மூக்கொலி; Pictograph = சித்திர எழுத்து; Pun = சிலேடை. நான்கு கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements on linguistic and Tamilological technical terms in Unit 1:\n1. Articulatory phonetics - ஒலிபிறப்பியல்\n2. Phoneme - ஒலியன்\n3. Lexicography - அகராதியியல்\n4. Epigraph - கல்வெட்டு\nWhich statements are correct?"}], "options": {"A": "Statements 1, 2 only are correct", "B": "Statements 2, 3, 4 only are correct", "C": "All statements 1, 2, 3, 4 are correct", "D": "Statements 1, 3 only are correct"}, "explanation": "Textbook page 22: All four glossarial statements are precise translations approved in the curriculum."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ஒலிபிறப்பியல் என்பது மனித உடற்கூற்றியல் உறுப்புகளால் ஒலிகள் உருவாக்கப்படுவதை விளக்கும் 'Articulatory phonetics' ஆகும்.", "content_en": "Articulatory phonetics explains how speech sounds are produced by human anatomical organs."}, {"id": "S2", "content_ta": "ஒலியன் என்பது மொழியின் தனித்துவமான மிகச்சிறிய அடிப்படை ஒலி அலகைக் குறிக்கும் 'Phoneme' ஆகும்.", "content_en": "Phoneme is the minimal distinctive sound unit of a language."}, {"id": "S3", "content_ta": "அகராதியியல் என்பது சொற்களின் பொருளையும் தோற்றத்தையும் முறைப்படுத்தும் 'Lexicography' ஆகும்.", "content_en": "Lexicography is the science and practice of compiling dictionaries."}, {"id": "S4", "content_ta": "கல்வெட்டியல் / கல்வெட்டு என்பது பாறைகளிலும் சுவர்களிலும் பொறிக்கப்பட்ட 'Epigraph' ஆகும்.", "content_en": "Epigraph refers to inscriptions engraved on stone walls and rock faces."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 22, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["glossary", "linguistics", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q116", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-05b-iyal1-integration", "chapter_id": null, "topic_id": "ta-8th-u1-plural-morphology-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல் 1 மொழித்திறன் பயிற்சியில் இடம்பெற்றுள்ள 'பன்மை விகுதிப் புணர்ச்சி' குறித்த கூற்றுகளை ஆராய்க:\n1. பூ + கள் = பூக்கள் (வல்லினம் மிகுதல்)\n2. மரம் + கள் = மரங்கள் (மகரம் கெட்டு மெல்லினம் தோன்றுதல்)\n3. புல் + கள் = புற்கள் (லகரம் றகரமாகத் திரிதல்)\n4. பல் + கள் = பற்கள் (லகரம் றகரமாகத் திரிதல்)\nஇவற்றுள் சரியான புணர்ச்சி மாற்றங்கள் எவை?"}], "options": {"A": "1, 2 மட்டுமே சரியானவை", "B": "2, 3, 4 மட்டுமே சரியானவை", "C": "1, 3, 4 மட்டுமே சரியானவை", "D": "1, 2, 3, 4 அனைத்தும் சரியானவை"}, "explanation": "பாடநூல் பக்கம் 21: பூக்கள் (க்கள்), மரங்கள் (ங்கள்), புற்கள் (ற்கள்), பற்கள் (ற்கள்), வாழ்த்துகள் (கள்), சொற்கள் (ற்கள்) எனப் பாடநூலில் கொடுக்கப்பட்டுள்ள புணர்ச்சி மாற்றங்கள் நான்கும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the plural morphology morphophonemic statements from Unit 1:\n1. Poo + kal = Pookkal (hardening with inserted plosive)\n2. Maram + kal = Marangal (dropping of 'm' and advent of nasal)\n3. Pul + kal = Putrkal (mutation of 'l' to alveolar 'tr')\n4. Pal + kal = Patrkal (mutation of 'l' to alveolar 'tr')\nWhich statements are correct?"}], "options": {"A": "1, 2 only are correct", "B": "2, 3, 4 only are correct", "C": "1, 3, 4 only are correct", "D": "All 1, 2, 3, 4 are correct"}, "explanation": "Textbook page 21: All 4 morphophonemic plural transformations (Pookkal, Marangal, Putrkal, Patrkal) are accurate."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "தமிழில் 'பூ' என்னும் சொல்லுடன் பன்மை விகுதி சேரும்போது 'பூக்கள்' என 'க்' மிகுந்து புணர்கிறது.", "content_en": "When plural suffix joins 'Poo', it becomes 'Pookkal' with an inserted 'k'."}, {"id": "S2", "content_ta": "'மரம்' என்னும் சொல்லுடன் பன்மை சேரும்போது மகர மெய் கெட்டு 'மரங்கள்' என 'ங்' தோன்றிப் புணர்கிறது.", "content_en": "When plural joins 'Maram', terminal 'm' drops and 'ng' appears yielding 'Marangal'."}, {"id": "S3", "content_ta": "'புல்' என்னும் சொல்லுடன் பன்மை சேரும்போது லகரம் றகரமாகத் திரிந்து 'புற்கள்' எனப் புணர்கிறது.", "content_en": "When plural joins 'Pul', 'l' mutates to 'tr' yielding 'Putrkal'."}, {"id": "S4", "content_ta": "'பல்' என்னும் சொல்லுடன் பன்மை சேரும்போது லகரம் றகரமாகத் திரிந்து 'பற்கள்' எனப் புணர்கிறது.", "content_en": "When plural joins 'Pal', 'l' mutates to 'tr' yielding 'Patrkal'."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 21, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["plural_morphology", "punarchi", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q117", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-05b-iyal1-integration", "chapter_id": null, "topic_id": "ta-8th-u1-polysemy-words-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூலில் இடம்பெற்றுள்ள 'ஒரு சொல் பல பொருள்' (Polysemy) பயன்பாடுகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'படி' - படிக்கட்டு (பெயர்), பாடம் படி (வினை).\n2. 'திங்கள்' - நிலவு (சந்திரன்), மாதம் (கால அளவு).\n3. 'ஆறு' - நீர்நிலை (நதி), எண் (ஆறு).\n4. இரு பொருள்படப் பாடும் தமிழ் இலக்கிய மரபு 'சிலேடை' (இரட்டுற மொழிதல்) எனப்படும்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2 மட்டுமே சரியானவை", "C": "கூற்றுகள் 2, 3 மட்டுமே சரியானவை", "D": "கூற்றுகள் 1, 3, 4 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் பக்கம் 22: படி, திங்கள், ஆறு ஆகிய சொற்களின் இருபொருள் தன்மையும், 'இரு பொருள்படப் பாடும் இலக்கியம் சிலேடை ஆகும்' என்ற இலக்கணக் கூற்றும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on polysemy words from Unit 1:\n1. 'Padi' - Step/Stairs (Noun), Read (Verb).\n2. 'Thingal' - Moon (Astronomy), Month (Time measurement).\n3. 'Aaru' - River (Waterbody), Six (Numeral).\n4. The literary device of expressing two meanings simultaneously is called 'Silaidai' (Pun).\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 2 only are correct", "C": "Statements 2, 3 only are correct", "D": "Statements 1, 3, 4 only are correct"}, "explanation": "Textbook page 22: All 4 statements accurately explain polysemic words and the concept of Silaidai (Pun)."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'படி' என்னும் சொல் 'படிக்கட்டு' என்னும் பெயர்ச்சொல்லாகவும், 'புத்தகத்தைப் படி' என்னும் வினைச்சொல்லாகவும் பயின்று வருகிறது.", "content_en": "'Padi' functions both as noun ('step/stairs') and as verb ('read the book')."}, {"id": "S2", "content_ta": "'திங்கள்' என்னும் சொல் 'சந்திரன்' என்னும் விண்பொருளையும், 'மாதம்' என்னும் கால அளவையும் ஒருசேரக் குறிக்கும் சொல்லாகும்.", "content_en": "'Thingal' denotes both the celestial Moon and the calendar unit of Month."}, {"id": "S3", "content_ta": "'ஆறு' என்னும் சொல் 'ஓடும் நதி' என்னும் நீர்நிலைப் பெயரையும், 'ஐந்திற்கு அடுத்த எண்' என்னும் எண்ணுப் பெயரையும் குறிக்கும்.", "content_en": "'Aaru' denotes both a flowing river and the numeral six."}, {"id": "S4", "content_ta": "ஒரே சொல் பல பொருள்களைத் தருமாறு ஒரே தொடரில் அமைத்துப் பாடுவது தமிழ் இலக்கியத்தின் சிலேடை நயத்திற்குச் சிறந்த சான்றாகும்.", "content_en": "Deploying a single word to convey multiple meanings within the same discourse is the essence of Tamil Pun (Silaidai)."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 22, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["polysemy", "silaidai", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q118", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-05b-iyal1-integration", "chapter_id": null, "topic_id": "ta-8th-u1-alphabetization-rules-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல் 1-ல் உள்ள சொற்களை அகரவரிசைப்படுத்துதல் குறித்த விதிகளையும் கூற்றுகளையும் ஆராய்க:\n1. அகரவரிசை என்பது தமிழ் எழுத்துகளின் வரிசைமுறைப்படி சொற்களை அமைப்பதாகும்.\n2. உயிர் எழுத்துகளை அகர, ஆகார... ஔகார வரிசைப்படி முறைப்படுத்த வேண்டும்.\n3. 'ஒ' வரிசை எழுத்து 'ஓ' வரிசை எழுத்திற்கு முன்னரே இடம்பெற வேண்டும்.\n4. 'ஒ' வரிசைச் சொல் 'ஓ' வரிசைச் சொல்லுக்குப் பின்னரே அகரவரிசையில் வரும்.\nஇவற்றுள் தவறான கூற்றைக் கண்டறிக:"}], "options": {"A": "கூற்று 2 தவறானது", "B": "கூற்று 4 தவறானது", "C": "கூற்று 1 தவறானது", "D": "கூற்று 3 தவறானது"}, "explanation": "பாடநூல் பக்கம் 20: கூற்று 4 தவறானது. தமிழ் அகரவரிசையில் குறில் 'ஒ' (ஒலிவடிவம்) முதலிலும், நெடில் 'ஓ' (ஓலைச்சுவடிகள்) அதன் பின்னருமே வரும்."}, "en": {"blocks": [{"type": "text", "content": "Examine the rules and statements regarding alphabetizing words in Unit 1:\n1. Alphabetization orders words according to Tamil phonetic character hierarchy.\n2. Vowels must be sequenced from 'A' through 'Au'.\n3. The short vowel 'O' must strictly precede the long vowel 'Oh'.\n4. Words starting with short 'O' appear AFTER words starting with long 'Oh'.\nIdentify the INCORRECT statement:"}], "options": {"A": "Statement 2 is incorrect", "B": "Statement 4 is incorrect", "C": "Statement 1 is incorrect", "D": "Statement 3 is incorrect"}, "explanation": "Textbook page 20: Statement 4 is incorrect because short 'O' precedes long 'Oh' in Tamil lexicographical order."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "அகரவரிசை என்பது தமிழ் அகர முதலான உயிர் எழுத்துகள் மற்றும் ககர முதலான உயிர்மெய் எழுத்துகளின் மரபுவழி வரிசையாகும்.", "content_en": "Alphabetical order follows the traditional sequence of Tamil vowels from 'A' and consonants from 'K'."}, {"id": "S2", "content_ta": "சொற்களை அகரவரிசைப்படுத்தும்போது முதலில் உயிர் எழுத்துகளையும், பின்னர் உயிர்மெய் எழுத்துகளையும் முறைப்படுத்த வேண்டும்.", "content_en": "When alphabetizing, independent vowels precede consonant-vowel combinations."}, {"id": "S3", "content_ta": "'அழகுணர்ச்சி, ஆரம்நீ, இரண்டல்ல, ஈசன், உரைநடை, ஊழி, எழுத்து, ஏழ்கடல், ஐயம், ஓலைச்சுவடிகள், ஔகாரம், ஒலிவடிவம்' என்பதே சரியான அகரவரிசையாகும்.", "content_en": "Azhagunarchi, Aaramnee, Irandalla, Eesan, Urainadai, Oozhi, Ezhuthu, Eazhkadal, Aiyam, Olaisuvadigal, Oukaaram, Olivadivam is the exact alphabetical order."}, {"id": "S4", "content_ta": "உயிர் எழுத்துகளுள் 'ஒ' வரிசைச் சொல் 'ஓ' வரிசைச் சொல்லுக்குப் பின்னரே வரவேண்டும் என்பது பொது விதியாகும்.", "content_en": "Words starting with short 'O' should strictly follow words starting with long 'Oh'."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 20, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["alphabetization", "lexicography", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q119", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-05b-iyal1-integration", "chapter_id": null, "topic_id": "ta-8th-u1-jumbled-sentences-restoration-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சொற்களை ஒழுங்குபடுத்தி அமைக்கப்பட்ட பின்வரும் பொருள் பொதிந்த தொடர்களை ஆராய்க:\n1. 'வளைந்த கோடுகளால் அமைந்த தமிழ் எழுத்து வட்டெழுத்து எனப்படும்.'\n2. 'உலகம் உள்ளவரையிலும் தமிழ்மொழி வாழட்டும்.'\n3. 'இரு பொருள்படப் பாடும் இலக்கியம் சிலேடை ஆகும்.'\n4. 'அம்புவிடும் கலையை ஏகலை என்றது தமிழ்.'\nஇத்தொடர்கள் குறித்த சரியான முடிவைத் தேர்ந்தெடுக்க:"}], "options": {"A": "1, 2 மட்டுமே சரியானவை", "B": "2, 3, 4 மட்டுமே சரியானவை", "C": "1, 2, 3, 4 அனைத்தும் சரியானவை", "D": "1, 3 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் பக்கம் 22: கலைந்துள்ள சொற்களை ஒழுங்குபடுத்தி உருவாக்கப்பட்ட நான்கு தொடர்களும் இலக்கண மற்றும் கருத்து அமைப்பில் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the correctly reordered meaningful sentences from Unit 1 exercise:\n1. 'Vatteluthu is the Tamil script constituted by curved strokes.'\n2. 'May Tamil language flourish as long as the universe endures.'\n3. 'Literature composed with dual meanings is known as Silaidai (Pun).'\n4. 'Tamil termed the art of shooting arrows as Aegalai.'\nSelect the correct conclusion:"}], "options": {"A": "1, 2 only are correct", "B": "2, 3, 4 only are correct", "C": "All 1, 2, 3, 4 are correct", "D": "1, 3 only are correct"}, "explanation": "Textbook page 22: All four restructured sentences represent correct syntax and textbook themes."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "வட்டெழுத்து என்பது வளைந்த கோடுகளால் அமைந்த மிகப்பழைய தமிழ் எழுத்து வடிவமாகும்.", "content_en": "Vatteluthu is an ancient Tamil script characterized by rounded curves."}, {"id": "S2", "content_ta": "உலகம் உள்ளவரையிலும் நமது தாய்மொழியாகிய தமிழ்மொழி எங்கும் நிலைபெற்று வாழ வேண்டும் என்பது பாரதியாரின் வாழ்த்தாகும்.", "content_en": "Bharati willed that Tamil should live everywhere as long as the cosmos endures."}, {"id": "S3", "content_ta": "இரு பொருள்படப் பாடும் சிலேடை இலக்கியத்தை 'இரட்டுற மொழிதல்' என்றும் அழைப்பர்.", "content_en": "Dual-meaning Silaidai literature is also termed 'Irattura Mozhithal'."}, {"id": "S4", "content_ta": "பண்டைத் தமிழர் அம்புவிடும் கலையை 'ஏகலை' என்று போற்றி வழங்கினர்.", "content_en": "Ancient Tamils celebrated the martial art of archery as 'Aegalai'."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 22, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["syntax", "sentence_formation", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q120", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-05b-iyal1-integration", "chapter_id": null, "topic_id": "ta-8th-u1-ar-glossary-mismatch", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'Articulatory phonetics' என்னும் ஆங்கிலக் கலைச்சொல்லிற்குத் தமிழ்ச் சொல் 'அகராதியியல்' என்பதாகும்.\nகாரணம் (R): அகராதியியல் என்பது உடலின் ஒலிப்பு உறுப்புகளை மட்டுமே ஆராயும் மருத்துவ இயலாகும்.\nசரியான விடையைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) சரி, காரணம் (R) சரி", "B": "கூற்று (A) சரி, காரணம் (R) தவறு", "C": "கூற்று (A) தவறு, காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று, காரணம் இரண்டும் தவறு. 'Articulatory phonetics' என்பது 'ஒலிபிறப்பியல்' ஆகும். 'Lexicography' என்பதே 'அகராதியியல்' (அகராதி உருவாக்கும் கலை) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): The Tamil translation of 'Articulatory phonetics' is 'Lexicography' (Agaraathiyiyal).\nReason (R): Lexicography is the medical science studying the physiological organs of sound production.\nChoose the correct option:"}], "options": {"A": "Both (A) and (R) are true", "B": "(A) is true, but (R) is false", "C": "(A) is false, but (R) is true", "D": "Both (A) and (R) are false"}, "explanation": "Both assertion and reason are false. Articulatory phonetics translates to ஒலிபிறப்பியல்; Lexicography translates to அகராதியியல்."}}, "question_data": {"assertion": "'Articulatory phonetics' என்னும் ஆங்கிலக் கலைச்சொல்லிற்குத் தூய தமிழ்ச் சொல் 'அகராதியியல்' என்பதாகும்.", "reason": "அகராதியியல் என்பது சொற்களின் பிறப்பு உறுப்புகளை மட்டுமே நுட்பமாக ஆராயும் மருத்துவ இயலாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 22, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["glossary", "assertion_reason", "linguistics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q121", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-05b-iyal1-integration", "chapter_id": null, "topic_id": "ta-8th-u1-ar-kalar-nilam-analogy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): பாரதிதாசன் பெண் கல்வியின் இன்றியமையாமையை வலியுறுத்த 'கல்வியில்லாப் பெண்கள் களர்நிலம்' என்று பாடினார்.\nகாரணம் (R): களர்நிலத்தில் பயிர் விளையாதது போலக் கல்வியறிவு இல்லாத பெண்களால் குடும்பத்திற்கும் சமுதாயத்திற்கும் பயன் விளையாது என்பதை உணர்த்தவே இவ்வாறு உவமித்தார்.\nசரியான விடையைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; கூற்றிற்குக் காரணம் சரியான விளக்கம்", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் சரியான விளக்கமன்று", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி"}, "explanation": "பாடநூல் பக்கம் 21: 'கல்வியில்லாப் பெண்கள் களர்நிலம்; அந்நிலத்தில் புல் விளைந்திடலாம் நல்ல புதல்வர்கள் விளைதல் இல்லை' என்பது பாரதிதாசனின் புரட்சிகரக் கவிதை வரியாகும். கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Bharathidasan described uneducated women as barren alkaline soil ('Kalar Nilam').\nReason (R): Just as no crop can grow on alkaline barren soil, society cannot reap progress without educated women.\nChoose the correct option:"}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation of (A)", "B": "Both (A) and (R) are true, but (R) is not the correct explanation of (A)", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Textbook page 21: Both assertion and reason are true, explaining Bharathidasan's famous metaphor on female literacy."}}, "question_data": {"assertion": "பாரதிதாசன் பெண் கல்வியின் இன்றியமையாமையை வலியுறுத்த 'கல்வியில்லாப் பெண்கள் களர்நிலம்' என்று உவமித்துப் பாடினார்.", "reason": "களர்நிலத்தில் எவ்விதப் பயிரும் விளையாதது போலக் கல்வியறிவு இல்லாத பெண்களால் சமுதாயத்திற்கு நற்பயன் விளையாது என்பதை உணர்த்தவே இவ்வாறு கூறினார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 21, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bharathidasan", "kalar_nilam", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q122", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-05b-iyal1-integration", "chapter_id": null, "topic_id": "ta-8th-u1-ar-plural-pookkal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'பூ' என்னும் சொல்லுடன் பன்மை விகுதி சேரும்போது 'பூக்கள்' என வல்லினம் மிக்குப் புணர்கிறது.\nகாரணம் (R): ஓரெழுத்து ஒருமொழியான குறில் எழுத்துகளுக்குப் பின் மட்டுமே வல்லினம் மிகும் என்பது இலக்கண விதியாகும்.\nசரியான விடையைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; சரியான விளக்கம்", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று (A) சரி; பூ + கள் = பூக்கள். காரணம் (R) தவறு; 'பூ' என்பது நெடில் ஓரெழுத்து ஒருமொழி. நெடிலுக்குப் பின்னும் (ஈக்கள், பாக்கள், பூக்கள்) வல்லினம் மிக்குப் புணரும்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): When plural suffix joins 'Poo', it hardens into 'Pookkal' with geminated plosive 'k'.\nReason (R): Plosives geminate strictly after short monosyllabic syllables in Tamil grammar.\nChoose the correct option:"}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation", "B": "(A) is true, but (R) is false", "C": "(A) is false, but (R) is true", "D": "Both (A) and (R) are false"}, "explanation": "Assertion (A) is true (Poo + kal = Pookkal). Reason (R) is false because 'Poo' is a long syllable (Nedil), and plosives regularly geminate after long syllables too (e.g. Eekkal, Paakkal)."}}, "question_data": {"assertion": "'பூ' என்னும் பெயர்ச்சொல்லுடன் பன்மை விகுதி புணரும்போது 'பூக்கள்' என்று வல்லினம் மிக்கு முடிகிறது.", "reason": "ஓரெழுத்து ஒருமொழியான குறில் எழுத்துகளுக்குப் பின்னால் பன்மை விகுதி சேரும்போது மட்டுமே வல்லினம் மிகும் என்பது பொது விதியாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 21, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["plural", "punarchi", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q123", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-05b-iyal1-integration", "chapter_id": null, "topic_id": "ta-8th-u1-ar-lexicography-epigraph", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'அகராதியியல்' என்பது கல்வெட்டுகளைப் படியெடுத்து வரலாற்று உண்மைகளை ஆராயும் துறையாகும்.\nகாரணம் (R): 'கல்வெட்டு' என்னும் கலைச்சொல்லிற்கு இணையான ஆங்கிலச் சொல் 'Epigraph' என்பதாகும்.\nசரியான விடையைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று (A) தவறு; அகராதியியல் (Lexicography) என்பது அகராதி உருவாக்கும் கலை/துறை. கல்வெட்டுகளை ஆராயும் துறை கல்வெட்டியல் (Epigraphy) எனப்படும். காரணம் (R) சரி; கல்வெட்டு = Epigraph."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'Lexicography' (Agaraathiyiyal) is the discipline that deciphers and studies stone inscriptions.\nReason (R): The English technical equivalent for 'Kalvettu' (inscription) is 'Epigraph'.\nChoose the correct option:"}], "options": {"A": "Both (A) and (R) are true", "B": "(A) is true, but (R) is false", "C": "(A) is false, but (R) is true", "D": "Both (A) and (R) are false"}, "explanation": "(A) is false because Lexicography is dictionary-making; studying inscriptions is Epigraphy. (R) is true."}}, "question_data": {"assertion": "'அகராதியியல்' (Lexicography) என்பது பாறைகளிலும் சுவர்களிலும் உள்ள கல்வெட்டுகளைப் படியெடுத்து ஆராயும் துறையாகும்.", "reason": "'கல்வெட்டு' என்னும் ஆங்கிலச் சொல்லுக்கு இணையான துறை 'Epigraph' என்று அழைக்கப்படுகிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 22, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["epigraph", "lexicography", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q124", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-05b-iyal1-integration", "chapter_id": null, "topic_id": "ta-8th-u1-ar-thingal-semantics", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'திங்கள்' என்னும் சொல்லுக்குத் தமிழ் மொழியில் ஒரே ஒரு பொருள் மட்டுமே உண்டு.\nகாரணம் (R): 'திங்கள்' என்பது இலக்கிய வழக்கிலோ அல்லது மக்கள் வழக்கிலோ பல பொருள்களைத் தருவதில்லை.\nசரியான விடையைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி", "B": "கூற்று (A) சரி, காரணம் (R) தவறு", "C": "கூற்று (A) தவறு, காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "கூற்று, காரணம் இரண்டும் தவறு. 'திங்கள்' என்பது நிலவு (சந்திரன்), மாதம் (கால அளவு), கிழமை (திங்கட்கிழமை) எனப் பல பொருள்களைக் கொண்ட ஒரு சொல் பல பொருள் (Polysemy) சொல்லாகும்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): The word 'Thingal' has strictly only one solitary meaning in the Tamil language.\nReason (R): 'Thingal' is never employed with polysemic meanings in either literature or spoken usage.\nChoose the correct option:"}], "options": {"A": "Both (A) and (R) are true", "B": "(A) is true, but (R) is false", "C": "(A) is false, but (R) is true", "D": "Both (A) and (R) are false"}, "explanation": "Both assertion and reason are false. 'Thingal' is a classic polysemic word meaning Moon, Month, and Monday."}}, "question_data": {"assertion": "'திங்கள்' என்னும் சொல்லுக்குத் தமிழ் மொழியில் ஒரே ஒரு பொருள் மட்டுமே உண்டு.", "reason": "'திங்கள்' என்பது எக்காலத்திலும் விண்மீனையோ அல்லது வாரத்தின் முதல் நாளையோ குறிக்கப் பயன்படுவதில்லை.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 22, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["polysemy", "thingal", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q125", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-05b-iyal1-integration", "chapter_id": null, "topic_id": "ta-8th-u1-ar-silaidai-dual-meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): இரு பொருள்படப் பாடும் இலக்கிய வடிவம் 'சிலேடை' (இரட்டுற மொழிதல்) எனப்படும்.\nகாரணம் (R): ஒரே தொடர் அல்லது சொல் இரு வேறு பொருள்களை உணர்த்தி இலக்கியச் சுவையை மிகுவிப்பதே இதன் தனிச்சிறப்பாகும்.\nசரியான விடையைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி; கூற்றிற்குக் காரணம் சரியான விளக்கம்", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் சரியான விளக்கமன்று", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி"}, "explanation": "பாடநூல் பக்கம் 22: 'இரு பொருள்படப் பாடும் இலக்கியம் சிலேடை ஆகும்.' ஆங்கிலத்தில் இது 'Pun' எனப்படும். கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Literature composed to yield two distinct meanings simultaneously is termed 'Silaidai' (Pun).\nReason (R): Delivering two divergent meanings from a single phrase/word to enrich aesthetic enjoyment is the essence of Silaidai.\nChoose the correct option:"}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation of (A)", "B": "Both (A) and (R) are true, but (R) is not the correct explanation of (A)", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Textbook page 22: Both assertion and reason are true and define the figure of speech Silaidai (Pun)."}}, "question_data": {"assertion": "ஒரு சொல்லானது இரு பொருள்படப் பாடப்படுவது தமிழ் இலக்கியத்தில் 'சிலேடை' அல்லது 'இரட்டுற மொழிதல்' எனப்படும்.", "reason": "ஒரே செய்யுளடி அல்லது சொல்லாட்சி இரண்டு வெவ்வேறான பொருண்மைகளை ஒருங்கே தந்து சுவை பயப்பது சிலேடையின் சிறப்பியல்பாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 22, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["silaidai", "pun", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q126", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-05b-iyal1-integration", "chapter_id": null, "topic_id": "ta-8th-u1-match-glossary-part1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல் 1 ஆங்கிலக் கலைச்சொற்களையும் அவற்றுக்குரிய தமிழ்ச் சொற்களையும் பொருத்துக:\nபட்டியல் I\n1. Articulatory phonetics\n2. Consonant\n3. Nasal consonant sound\n4. Epigraph\n\nபட்டியல் II\na) மூக்கொலி\nb) கல்வெட்டு\nc) ஒலிபிறப்பியல்\nd) மெய்யொலி"}], "options": {"A": "1-d, 2-c, 3-b, 4-a", "B": "1-c, 2-d, 3-a, 4-b", "C": "1-c, 2-a, 3-d, 4-b", "D": "1-b, 2-d, 3-a, 4-c"}, "explanation": "பாடநூல் பக்கம் 22: Articulatory phonetics = ஒலிபிறப்பியல் (c); Consonant = மெய்யொலி (d); Nasal consonant sound = மூக்கொலி (a); Epigraph = கல்வெட்டு (b). சரியான பொருத்தம்: 1-c, 2-d, 3-a, 4-b."}, "en": {"blocks": [{"type": "text", "content": "Match English linguistic terms with their official Tamil equivalents:\nList I\n1. Articulatory phonetics\n2. Consonant\n3. Nasal consonant sound\n4. Epigraph\n\nList II\na) மூக்கொலி (Nasal sound)\nb) கல்வெட்டு (Stone inscription)\nc) ஒலிபிறப்பியல் (Physiology of sounds)\nd) மெய்யொலி (Consonant sound)"}], "options": {"A": "1-d, 2-c, 3-b, 4-a", "B": "1-c, 2-d, 3-a, 4-b", "C": "1-c, 2-a, 3-d, 4-b", "D": "1-b, 2-d, 3-a, 4-c"}, "explanation": "Textbook page 22: Articulatory phonetics->c, Consonant->d, Nasal sound->a, Epigraph->b. Key B."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "Articulatory phonetics", "content_en": "Articulatory phonetics"}, {"id": "L2", "content_ta": "Consonant", "content_en": "Consonant"}, {"id": "L3", "content_ta": "Nasal consonant sound", "content_en": "Nasal consonant sound"}, {"id": "L4", "content_