{"id": "8th-u1-q083", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-04-sorpoonga", "chapter_id": null, "topic_id": "ta-8th-u1-direct-nannool-kuril-letters", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நன்னூலார் குறிப்பிட்டுள்ள நாற்பத்திரண்டு ஓரெழுத்து ஒருமொழிகளுள் இடம்பெற்றுள்ள குறில் எழுத்துகள் எவை?"}], "options": {"A": "அ, இ", "B": "உ, எ", "C": "நொ, து", "D": "கெ, செ"}, "explanation": "பாடநூல் பக்கம் 15: நன்னூலார் 42 ஓரெழுத்து ஒருமொழிகளில் 40 நெடில் எழுத்துகளையும், 'நொ', 'து' ஆகிய இரண்டு குறில் உயிர்மெய் எழுத்துகளையும் குறிப்பிட்டுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which short syllables (Kuril letters) are included in the forty-two monosyllabic words by Nannoolar?"}], "options": {"A": "A, I", "B": "U, E", "C": "No, Thu", "D": "Ke, Se"}, "explanation": "Textbook page 15: Nannoolar included two short syllables, 'No' and 'Thu', alongside 40 long syllables."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 15, "chapter": null, "section": null, "reference": null, "url": null, "source_