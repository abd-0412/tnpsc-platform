{"id": "8th-u1-q084", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-04-sorpoonga", "chapter_id": null, "topic_id": "ta-8th-u1-direct-thavassaalai-founder", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருச்சிக்கு அருகில் உள்ள அல்லூரில் 'திருவள்ளுவர் தவச்சாலை' மற்றும் 'பாவாணர் நூலகம்' ஆகியவற்றை நிறுவிய தமிழறிஞர் யார்?"}], "options": {"A": "மறைமலையடிகள்", "B": "தேவநேயப் பாவாணர்", "C": "பெருஞ்சித்திரனார்", "D": "இரா. இளங்குமரனார்"}, "explanation": "பாடநூல் பக்கம் 16: திருச்சிக்கு அருகில் அமைந்துள்ள அல்லூரில் 'திருவள்ளுவர் தவச்சாலை' மற்றும் 'பாவாணர் நூலகம்' ஆகியவற்றை அமைத்தவர் 'செந்தமிழ்ச் அந்தணர்' இரா. இளங்குமரனார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Which Tamil scholar founded the 'Thiruvalluvar Thavassaalai' and 'Paavaanar Library' at Allur near Tiruchirappalli?"}], "options": {"A": "Maraimalai Adigal", "B": "Devaneya Paavaanar", "C": "Perunchithiranaar", "D": "Ra. Ilangkumaranar"}, "explanation": "Textbook page 16: 'Senthamizh Andhanar' Ra. Ilangkumaranar established Thiruvalluvar Thavassaalai and Paavaanar Library in Allur near Trichy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook a