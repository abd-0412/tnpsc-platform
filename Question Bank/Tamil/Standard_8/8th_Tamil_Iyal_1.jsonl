{"id": "8th-u1-q105", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-05-eluthukalin-pirappu", "chapter_id": null, "topic_id": "ta-8th-u1-grammar-oral-actions-types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்காணும் மெய் எழுத்துகளுள் 'வருடுதல்' மற்றும் 'தடவுதல்' ஆகிய இரு வேறு நுட்பமான நாக்கு இயக்கங்களால் முறையே பிறக்கும் இணை எது?"}], "options": {"A": "ர் / ழ் (வருடுதல்) மற்றும் ள் (தடவுதல்)", "B": "க் / ங் (வருடுதல்) மற்றும் ச் (தடவுதல்)", "C": "ட் / ண் (வருடுதல்) மற்றும் ல் (தடவுதல்)", "D": "த் / ந் (வருடுதல்) மற்றும் வ் (தடவுதல்)"}, "explanation": "பாடநூல் பக்கம் 18: 'மேல்வாயை நாவின் நுனி வருடுவதால்' ர், ழ் பிறக்கின்றன. 'மேல்வாயை நாவின் ஓரங்கள் தடித்துத் தடவுதலால்' ள் பிறக்கிறது. எனவே 'வருடுதல்' மற்றும் 'தடவுதல்' முறையே ர்/ழ் மற்றும் ள் எழுத்துகளுக்கு உரியவை."}, "en": {"blocks": [{"type": "text", "content": "Which pair of consonants articulates through the distinct subtle tongue motions of 'Stroking' (Varuduthal) and 'Rubbing' (Thadavuthal) respectively?"}], "options": {"A": "R / Zh (Stroking) and Ll (Rubbing)", "B": "K / Ng (Stroking) and Ch (Rubbing)", "C": "T / Nn (Stroking) and L (Rubbing)", "D": "Th / N (Stroking) and V (Rubbing)"}, "explanation": "Textbook page 18: R and Zh articulate by the tongue tip stroking (Varuduthal), while Ll articulates by the tongue edges rubbing (Thadavuthal)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["grammar", "phonetics", "articulation_mechanics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q106", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-05-eluthukalin-pirappu", "chapter_id": null, "topic_id": "ta-8th-u1-grammar-midatru-total-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழில் முதன்மை எழுத்துகளுள் 'கழுத்தை' (மிடற்றை) மட்டுமே இடமாகக் கொண்டு பிறக்கும் மொத்த எழுத்துகளின் எண்ணிக்கை யாது?"}], "options": {"A": "12 எழுத்துகள்", "B": "18 எழுத்துகள்", "C": "6 எழுத்துகள்", "D": "24 எழுத்துகள்"}, "explanation": "பாடநூல் பக்கம் 17: கழுத்தைத் தலைமை இடமாகக் கொண்டு பிறப்பவை: உயிர் எழுத்துகள் 12 + இடையின மெய் எழுத்துகள் 6 (ய், ர், ல், வ், ழ், ள்). மொத்த எழுத்துகள் = 12 + 6 = 18 எழுத்துகள் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the total number of primary letters in Tamil that articulate exclusively from the throat/neck (Midatru)?"}], "options": {"A": "12 letters", "B": "18 letters", "C": "6 letters", "D": "24 letters"}, "explanation": "Textbook page 17: Letters originating from the neck/throat = 12 Vowels + 6 Medial Consonants = 18 letters."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_ye