{"id": "8th-u1-q055", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-03-varivadiva-valarchi", "chapter_id": null, "topic_id": "ta-8th-u1-printing-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் எழுத்துகள் இப்போதுள்ள நிலையான வரிவடிவத்தைப் பெறக் காரணமாக அமைந்த முதன்மைக் கலை எது?"}], "options": {"A": "ஓவியக் கலை", "B": "சிற்பக் கலை", "C": "அச்சுக் கலை (அச்சு இயந்திரம்)", "D": "செப்பேட்டுக் கலை"}, "explanation": "பாடநூல் பக்கம் 8: தமிழ் எழுத்துகள் இப்போதுள்ள நிலையான வடிவத்தைப் பெற அச்சுக்கலையே காரணமாக அமைந்தது எனப் பாடநூல் மதிப்பீட்டு வினா உறுதிப்படுத்துகிறது. சரியான தெரிவு C."}, "en": {"blocks": [{"type": "text", "content": "Which technological craft served as the primary catalyst for Tamil characters acquiring their permanent standard form?"}], "options": {"A": "Art of painting", "B": "Art of sculpting", "C": "Art of printing (Printing press)", "D": "Art of copper plate engraving"}, "explanation": "Textbook page 8 confirms that the printing press solidified the stable modern typography of Tamil script. Key C."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "cl