{"id": "8th-u1-q023", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-02-aazhikku-inai", "chapter_id": null, "topic_id": "ta-8th-u1-grammar-split-words", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வெண்சங்கு' மற்றும் 'முத்தமிழ்' ஆகிய இரு சொற்களையும் இலக்கண முறைப்படி சரியான முறையில் பிரித்தெழுதும் தெரிவு எது?"}], "options": {"A": "வெண் + சங்கு; முத் + தமிழ்", "B": "வெள் + சங்கு; முப்பத்து + தமிழ்", "C": "வெண்மை + சங்கு; மூன்று + தமிழ்", "D": "வெண்மை + சங்கு; முப்பால் + தமிழ்"}, "explanation": "பண்புப்பெயர்ப் புணர்ச்சியில் 'வெண்சங்கு' என்பது 'வெண்மை + சங்கு' எனப் பிரியும். எண்ணுப் பெயர்ப் புணர்ச்சியில் 'முத்தமிழ்' என்பது 'மூன்று + தமிழ்' எனப் பிரியும். எனவே சரியான தெரிவு C."}, "en": {"blocks": [{"type": "text", "content": "Which option correctly divides the words 'Vensangu' and 'Muthamizh' following standard grammar rules?"}], "options": {"A": "Ven + Sangu; Muth + Thamizh", "B": "Vel + Sangu; Muppathu + Thamizh", "C": "Vemmai + Sangu; Moontru + Thamizh", "D": "Vemmai + Sangu; Muppaal + Thamizh"}, "explanation": "Vensangu splits as Vemmai + Sangu (attributive noun); Muthamizh splits as Moontru + Thamizh (numeral noun). Key C."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": 