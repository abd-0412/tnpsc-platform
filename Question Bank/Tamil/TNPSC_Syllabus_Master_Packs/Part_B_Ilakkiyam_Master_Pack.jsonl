{"id": "7th-t2-u1-q028", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-02-thottapattu", "chapter_id": null, "topic_id": "ta-t2-u1-thottapattu-bookback2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மக்களுக்குப் போதிய வருமானம் கொடுத்து அவர்களைக் காப்பாற்றியது என்று தேயிலைத் தோட்டப் பாட்டு எதனைக் குறிப்பிடுகிறது?"}], "options": {"A": "பற்றுவரவு", "B": "சிக்கனம்", "C": "கைத்தொழில்", "D": "கப்பல்"}, "explanation": "பாடநூல் வினா: மக்களுக்கு வருமானம் கொடுத்து அவர்களைக் காப்பாற்றியது 'கைத்தொழில்' ஆகும் ('கைத்தொழில் தன்னில் சிறந்து...')."}, "en": {"blocks": [{"type": "text", "content": "What does the Tea Garden Song mention as having protected and sustained people historically by providing income?"}], "options": {"A": "Accounting", "B": "Thrift", "C": "Handicrafts / cottage crafts", "D": "Shipping"}, "explanation": "Textbook evaluation answer: 'Kaithozhil' (Handicraft) historically provided livelihood and protection to the people."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": n