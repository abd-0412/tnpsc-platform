{"id": "11th_tamil_u4_q075", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "meenakshi_award_state", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் இரா. மீனாட்சியின் இலக்கியப் பணிகளைப் பாராட்டித் தமிழக அரசு அவருக்கு வழங்கிய சிறப்பு விருது எது?", "media_id": null}], "options": {"A": "கலைமாமணி விருது", "B": "பாரதி விருது", "C": "தமிழ்நாடு அரசின் சிறந்த நூலுக்கான பரிசு (கவிதைப் பிரிவு)", "D": "தாமரைத்திரு விருது"}, "explanation": "இரா. மீனாட்சியின் கவிதைத் தொகுப்புகள் தமிழ்நாடு அரசின் சிறந்த நூல் பரிசினைப் பெற்றுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Which honor was conferred by the Government of Tamil Nadu upon poetess R. Meenakshi's poetry?", "media_id": null}], "options": {"A": "Kalaimamani Award", "B": "Bharathi Award", "C": "Government of Tamil Nadu State Literary Best Book Award", "D": "Padma Shri"}, "explanation": "She received the Government of Tamil Nadu Best Book Award for poetry."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 83, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 83", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 4", "Awards", "R. Meenakshi"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u4_q076", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_pillaikkoodam_natrinai", "chapter_id": null, "topic_id": "natrinai_110_golden_bowl", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பொற்கலத்து ஏந்திய பூந்தலைச் சிறுகோல் / அஞ்சுகொடு அஞ்சுகொடு என...’ - செவிலியர் எதில் பாலை ஏந்தி ஊட்ட வந்தனர்?", "media_id": null}], "options": {"A": "மண் கலத்தில்", "B": "வெள்ளிக் கிண்ணத்தில்", "C": "மரப் பாத்திரத்தில்", "D": "பொற்கலத்தில் (பொன்னாலான கிண்ணத்தில்)"}, "explanation": "தலைவி தன் பிறந்த வீட்டில் செல்வச் செழிப்புடன் வாழ்ந்ததை உணர்த்தப் 'பொற்கலத்தில்' தேன் கலந்த பால் ஏந்தி வந்ததாகக் கூறப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "In what vessel did the foster-maids carry sweet milk to feed the playful heroine in her aristocratic parental home?", "media_id": null}], "options": {"A": "Clay earthen bowl", "B": "Silver saucer", "C": "Wooden ladle", "D": "Golden chalice / Golden vessel (Porkalathu)"}, "explanation": "Milk was served in a golden chalice, underscoring her family's royal affluence."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 84, "ch