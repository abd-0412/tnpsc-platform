{"id": "11th_tamil_u3_q153", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "adakkam_chelvarkke_chelvam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘எல்லார்க்கும் நன்றாம் பணிதல் அவருள்ளும் / செல்வர்க்கே செல்வம் தகைத்து’ - பணிவு யாருக்கு மேலும் ஒரு தனிப்பெரும் செல்வமாகத் திகழ்கிறது?", "media_id": null}], "options": {"A": "செல்வம் படைத்த செல்வந்தர்களுக்கு", "B": "ஏழைகளுக்கு", "C": "நாடோடிகளுக்கு", "D": "குழந்தைகளுக்கு"}, "explanation": "பணிவுடைமை எல்லோருக்கும் நன்மையைத் தரும்; அதிலும் குறிப்பாகச் செல்வம் உள்ளவர்க்கு அது செல்வத்தினும் சிறந்த அணிகலனாகும்."}, "en": {"blocks": [{"type": "text", "content": "According to 'Ellaarkkum nanraam panithal avarullum chelvarkkae chelvam thagaithu', to whom does humility serve as an unmatched jewel?", "media_id": null}], "options": {"A": "To wealthy individuals possessing great fortune", "B": "To destitute mendicants", "C": "To nomads", "D": "To young infants"}, "explanation": "Humility is good for all, but in the wealthy, it shines as an unparalleled crowning glory."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 56", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Thirukkural", "Humility"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q154", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "pugazhpada_vaazhaathaar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘புகழ்பட வாழாதார் தந்நோவார் தம்மை / இகழ்வாரை நோவது எவன்’ - புகழ் இல்லாமல் வாழ்பவர் யாரை நொந்து கொள்ளக் கூடாது?", "media_id": null}], "options": {"A": "மன்னனை", "B": "தன்னை இகழ்ந்து பேசுபவர்களை (தம்மையே நொந்து கொள்ள வேண்டும்)", "C": "கடவுளை", "D": "உறவினர்களை"}, "explanation": "புகழுடன் வாழ முடியாதவர்கள் தம்மைப் பழிப்பவர்களைக் குறை கூறாமல், புகழுடன் வாழத் தவறிய தங்களையே நொந்து கொள்ள வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "In 'Pugazhpada vaazhaathaar than noavaar...', who should those living without renown NOT blame?", "media_id": null}], "options": {"A": "The reigning monarch", "B": "Those who deride or criticize them (they must blame only themselves)", "C": "The gods", "D": "Their kinfolk"}, "explanation": "Those who fail to live renowned have only themselves to blame, not those who censure them."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 56", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Thirukkural", "Self-accountability"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q155", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "onra_ulagathu_uyarntha", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஒன்றா உலகத்து உயர்ந்த புகழல்லால் / பொன்றாது நிற்பதொன் றில்’ - இவ்வுலகில் அழியாமல் நிலைத்து நிற்பது எது ஒன்றே?", "media_id": null}], "options": {"A": "பொன் பொருள்", "B": "கல் அரண்மனைகள்", "C": "உயர்ந்த நற்புகழ் ஒன்றே (புகழ்)", "D": "அரசாட்சி"}, "explanation": "இவ்வுலகில் மனிதன் சேர்த்த செல்வம், கட்டடங்கள் அனைத்தும் அழிந்துவிடும்; ஒப்பற்ற உயர்ந்த நற்புகழ் மட்டுமே என்றும் அழியாது நிற்கும்."}, "en": {"blocks": [{"type": "text", "content": "In 'Onra ulagathu uyarntha pugazhallal ponraathu nirpathonril', what alone stands immortal in this world?", "media_id": null}], "options": {"A": "Gold and gemstones", "B": "Granite castles", "C": "Sublime ethical renown and virtuous glory (Pugazh)", "D": "Dynastic empires"}, "explanation": "Nothing endures immortal in this fleeting universe except lofty unblemished renown."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 56", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Thirukkural", "Immortality of Fame"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q156", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "uraipaar_uraipavai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உரைப்பார் உரைப்பவை எல்லாம் இரப்பார்க்கொன் / றீவார்மேல் நிற்கும் புகழ்’ - புகழ் யாரிடத்தில் வந்து நிலைக்கும்?", "media_id": null}], "options": {"A": "அதிகாரம் செலுத்துவோரிடம்", "B": "நூல்களை எழுதுவோரிடம்", "C": "செல்வத்தைப் பதுக்குவோரிடம்", "D": "வறியவர்க்கு இல்லை எனாது ஈயும் வள்ளல்களிடம்"}, "explanation": "உலகத்தில் சான்றோர்கள் பேசும் புகழுரைகள் அனைத்தும், வறியவர்க்கு ஈந்து உதவும் வள்ளல்களின் மீதே என்றும் நிலைத்து நிற்கும்."}, "en": {"blocks": [{"type": "text", "content": "Upon whom does all human praise and eulogy permanently settle according to 'Uraippaar uraipavai...'?", "media_id": null}], "options": {"A": "Upon oppressive rulers", "B": "Upon encyclopedic scribes", "C": "Upon miserly hoarders", "D": "Upon generous patrons who give freely to the destitute"}, "explanation": "All worthy eulogies praised by humanity dwell upon those who give bountifully to the needy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 56", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Thirukkural", "Munificence"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q157", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "cherivarinthu_seermai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘செறிவறிந்து சீர்மை பயக்கும் அறிவறிந்து / ஆற்றின் அடங்கப் பெறின்’ - எதனை அறிந்து அடங்கி வாழ்பவனுக்குப் பெருமை சேரும்?", "media_id": null}], "options": {"A": "அறிய வேண்டிய நல்லறிவை அறிந்து, நல்வழியில் தன் புலன்களை அடக்கி வாழ்பவனுக்கு", "B": "போர்க் கலையை அறிந்தவனுக்கு", "C": "சூதாட்டத்தை அறிந்தவனுக்கு", "D": "வணிகப் பாதையை அறிந்தவனுக்கு"}, "explanation": "நன்மையான அறிவை உணர்ந்து, நன்னெறி வழியில் அடங்கி வாழ்வோரின் அடக்கமே அவனுக்குப் பெரும் நன்மையும் பெருமையும் சேர்க்கும்."}, "en": {"blocks": [{"type": "text", "content": "What brings radiant honor and dignity to an individual in 'Cherivarinthu seermai payakkum...'?", "media_id": null}], "options": {"A": "Knowing the true knowledge of virtue and walking the path of disciplined self-restraint", "B": "Mastering martial archery", "C": "Knowing dice gambling", "D": "Mastering sea trade routes"}, "explanation": "True knowledge pursued with self-discipline yields lasting glory and peerless nobility."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 56", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Thirukkural", "Self-discipline"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q158", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "kaakka_porulaa_adakkam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘காக்க பொருளா அடக்கத்தை ஆக்கம் / அதனினூஉங்கு இல்லை உயிர்க்கு’ - இக்குறளில் ‘பொருளா’ என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "பணம்", "B": "உறுதியான ஒரு விழுமிய செல்வமாக (முக்கியமாகக் கருதி)", "C": "பொருளற்றதாக", "D": "பொருட்களின் பட்டியல்"}, "explanation": "அடக்கத்தை ஒருவன் போற்றத்தக்க உறுதிப் பொருளாகக் கருதிப் பாதுகாக்க வேண்டும்; அதைவிடச் சிறந்த ஆக்கம் உயிருக்கு வேறு இல்லை."}, "en": {"blocks": [{"type": "text", "content": "In 'Kaakka porulaa adakkathai aakkam athaninooungu illai uyirkku', what does 'Porulaa' signify?", "media_id": null}], "options": {"A": "Currency coins", "B": "As a priceless, paramount moral treasure to be cherished", "C": "Worthless", "D": "A commodity catalogue"}, "explanation": "'Porulaa' means regarding self-restraint as a cherished, indispensable treasure."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null,