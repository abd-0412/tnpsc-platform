{"id": "11th_tamil_u5_q078", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poem_seerapuraanam", "chapter_id": null, "topic_id": "secular_harmony_seera", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சீறாப்புராணம் தமிழ் இலக்கியப் பண்பாட்டிற்கு வழங்கிய மாபெரும் மத நல்லிணக்கக் கொடை யாது?", "media_id": null}], "options": {"A": "அயல்நாட்டு மொழிகளைத் திணித்தது", "B": "இசுலாமிய சமய விழுமியங்களைத் தமிழின் செவ்வியல் காப்பிய யாப்பு மரபோடு இணைத்து மதநல்லிணக்கத் தமிழ்க் காப்பியமாக மிளிர்ந்தமை", "C": "பழைய நூல்களை எதிர்த்தது", "D": "நாடகங்களை மட்டுமே வளர்த்தது"}, "explanation": "இசுலாமிய வாழ்வியல் நெறிகளை கம்பன் வழியிலான தமிழ்ச் செவ்வியல் விருத்த யாப்போடு இணைத்து மதநல்லிணக்கத்தின் சிகரமாக சீறாப்புராணம் திகழ்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What monumental legacy of inter-religious syncretic harmony does Seerapuraanam bequeath to Tamil culture?", "media_id": null}], "options": {"A": "Imposing foreign languages", "B": "Seamlessly synthesizing Islamic sacred history with classical Tamil epic prosody, exemplifying syncretic harmony", "C": "Denouncing older heritage", "D": "Cultivating only plays"}, "explanation": "It represents the harmonic synthesis of Islamic spirituality and Tamil epic poetics."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_n