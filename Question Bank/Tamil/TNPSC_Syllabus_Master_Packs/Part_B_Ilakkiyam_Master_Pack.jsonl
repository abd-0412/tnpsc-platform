{"id": "11th_tamil_u3_q077", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "purananooru_first_print_year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புறநானூறு நூலை முதன்முதலில் சுவடியிலிருந்து பதிப்பித்து அச்சேற்றிய தமிழறிஞர் மற்றும் பதிப்பிக்கப்பட்ட ஆண்டு எது?", "media_id": null}], "options": {"A": "உ. வே. சாமிநாதையர் (1894)", "B": "சி. வை. தாமோதரம்பிள்ளை (1881)", "C": "ஆறுமுக நாவலர் (1860)", "D": "பரிதிமாற்கலைஞர் (1901)"}, "explanation": "புறநானூற்றை ஏட்டுச் சுவடியிலிருந்து முழுமையாக ஆராய்ந்து முதன்முதலில் 1894-இல் அச்சேற்றி வெளியிட்டவர் தமிழ்த்தாத்தா உ. வே. சாமிநாதையர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Which eminent scholar first collated palm-leaf manuscripts and published Purananooru in print, and in which year?", "media_id": null}], "options": {"A": "U. V. Swaminatha Iyer (1894)", "B": "C. W. Damodaram Pillai (1881)", "C": "Arumuga Navalar (1860)", "D": "Parithimaar Kalaignar (1901)"}, "explanation": "U. V. Swaminatha Iyer published the definitive first print edition of Purananooru in 1894."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "t