{"id": "11th_tamil_rev2_q001", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_prose_classics", "chapter_id": null, "topic_id": "anandarangar_diary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆனந்தரங்கர் புதுச்சேரி பிரெஞ்சு அரசில் வகித்த முதன்மைப் பதவி எது?", "media_id": null}], "options": {"A": "தலைமைத் துபாஷி (மொழிபெயர்ப்பாளர்)", "B": "தலைமை நீதிபதி", "C": "கடற்படைத் தளபதி", "D": "வருவாய்த்துறை ஆணையர்"}, "explanation": "ஆனந்தரங்கர் புதுச்சேரி பிரெஞ்சு அரசில் தலைமைத் துபாஷியாக (மொழிபெயர்ப்பாளராகவும் ஆலோசகராகவும்) 1736 முதல் 1761 வரை பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "What was the primary official post held by Anandarangar under the French administration in Puducherry?", "media_id": null}], "options": {"A": "Chief Dubash (Court Interpreter / Agent)", "B": "Chief Justice", "C": "Naval Commander", "D": "Revenue Commissioner"}, "explanation": "Anandarangar served as the Chief Dubash (Interpreter and diplomatic agent) under French governor Dupleix from 1736 to 1761."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 120, "chapter":