{"id": "9th-u8-q088", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l3", "chapter_id": null, "topic_id": "yasodhara-kaaviyam-structure", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "யசோதர காவியம் எத்தனை சருக்கங்களையும், எத்தனை பாடல்களையும் கொண்டுள்ளது?", "media_id": null}], "options": {"A": "மூன்று சருக்கங்கள், 100 பாடல்கள்", "B": "ஏழு சருக்கங்கள், 500 பாடல்கள்", "C": "பத்து சருக்கங்கள், 400 பாடல்கள்", "D": "ஐந்து சருக்கங்கள்; 320 அல்லது 330 பாடல்கள்"}, "explanation": "இந்நூல் ஐந்து சருக்கங்களைக் கொண்டது; பாடல்களின் எண்ணிக்கை 320 எனவும் 330 எனவும் ஆய்வாளர்கள் கருதுவர்."}, "en": {"blocks": [{"type": "text", "content": "How many cantos (Sarukkams) and verses are contained in Yasodhara Kaaviyam?", "media_id": null}], "options": {"A": "3 cantos, 100 verses", "B": "7 cantos, 500 verses", "C": "10 cantos, 400 verses", "D": "Five cantos (Sarukkams); 320 or 330 verses"}, "explanation": "The epic is organized into five Sarukkams comprising either 320 or 330 stanzas."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": "9th Tamil, U