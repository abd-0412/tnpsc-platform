{"id": "10th-u7-q108", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "silappathikaram", "chapter_id": null, "topic_id": "significance_of_chapter", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகார அரங்கேற்று காதை பண்டைத் தமிழரின் எத்தகைய மேன்மையை உலகிற்கு ஆவணப்படுத்துகிறது?", "media_id": null}], "options": {"A": "போர் முறைகளை மட்டுமே", "B": "வணிகக் கப்பல்களை மட்டுமே", "C": "மருத்துவ முறைகளை மட்டுமே", "D": "பண்டைய தமிழரின் மிகச் செழுமையான நாட்டியக் கலை, மேடை வடிவமைப்பு, இசைக் கோட்பாடுகள் மற்றும் நுண்கலைகளின் உன்னத வளர்ச்சி"}, "explanation": "அரங்கேற்று காதை பண்டைத் தமிழரின் ஒப்பற்ற நாட்டிய சாஸ்திரம், இசைக்கலை நுட்பங்கள் மற்றும் அரங்கக் கட்டிடக் கலையை உலகிற்குப் பறைசாற்றும் அரிய வரலாற்றுப் பெட்டகமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What pinnacle of ancient Tamil cultural civilization is documented through Arangaetru Kaathai?", "media_id": null}], "options": {"A": "Military tactics only", "B": "Merchant fleets only", "C": "Medical lore only", "D": "The exquisite advancement of ancient Tamil dance aesthetics, stage engineering, acoustic theories, and fine arts"}, "explanation": "It documents the world-class sophistication of classical Tamil dance, acoustics, and stagecraft."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "