{"id": "11th_tamil_u7_q126", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_pathitrupathu", "chapter_id": null, "topic_id": "chera_royal_emblem", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பதிற்றுப்பத்து போற்றும் சேர மன்னர்களின் அரச சின்னம், மாலை மற்றும் தலைநகரம் எவை?", "media_id": null}], "options": {"A": "புலி; அத்திப்பூ மாலை; உறையூர்", "B": "வில் சின்னம்; பனம்பூ மாலை; வஞ்சி (கரூர்) தலைநகரம்", "C": "மீன்; வேப்பம்பூ மாலை; மதுரை", "D": "யானை; மல்லிகைப்பூ மாலை; காஞ்சி"}, "explanation": "சேர மன்னர்களின் கொடிச்சின்னம் 'வில்'; அவர்கள் சூடும் மாலை 'பனம்பூ மாலை'; அவர்களது தலைநகரம் 'வஞ்சி' மற்றும் துறைமுகம் 'தொண்டி, முசிறி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What are the royal emblem, garland, and capital of the Chera rulers lauded in Pathitrupathu?", "media_id": null}], "options": {"A": "Tiger; Athi garland; Uraiyur", "B": "Bow emblem; Palmyra flower garland; Vanji capital", "C": "Fish; Neem garland; Madurai", "D": "Elephant; Jasmine garland; Kanchi"}, "explanation": "The Cheras bore the Bow flag, donned Palmyra garlands, and ruled from Vanji."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_y