{"id": "8th-u4-q475", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l2", "chapter_id": null, "topic_id": "state-tree-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்நாட்டின் அதிகாரப்பூர்வ மாநில மரமாகத் திகழ்வது எது?"}], "options": ["வேப்பமரம்", "ஆலமரம்", "பனைமரம்", "தென்னைமரம்"], "explanation": "பாடநூல் பக்கம் 73 'தெரிந்து தெளிவோம்' பகுதியில் 'தமிழ்நாட்டின் மாநில மரம் பனை' என்று தெளிவாகக் குறிப்பிடப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Which tree serves as the official State Tree of Tamil Nadu?"}], "options": ["Neem tree", "Banyan tree", "Palmyra tree", "Coconut tree"], "explanation": "As stated in textbook page 73 'Know and Clarify', the official State Tree of Tamil Nadu is the Palmyra tree (பனை)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 73, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_n