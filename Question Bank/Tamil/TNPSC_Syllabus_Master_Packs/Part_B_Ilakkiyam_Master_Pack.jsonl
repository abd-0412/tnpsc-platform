{"id": "9th-u9-q040", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "thirukkural-secular-nature", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளை மேலைநாட்டு அறிஞர்கள் வியந்து பாராட்டுவதற்கு முதன்மையான காரணமாக அமைவது எது?", "media_id": null}], "options": {"A": "அதன் மிக நீண்ட பாடல்கள்", "B": "வரலாற்றுப் போர்களை விவரிப்பது", "C": "கடவுளர்களின் பெயர்களை வரிசையாகக் கூறுவது", "D": "மதச்சார்பற்ற உலகளாவிய அறநெறிகளை எந்தச் சார்புமின்றி நடுநிலையோடு விளக்குவது"}, "explanation": "திருக்குறள் எந்த ஒரு குறிப்பிட்ட சாதி, மதம், இனம், மொழி சாராமல் நடுநிலையோடு மனித வாழ்விற்குத் தேவையான உலகளாவிய பொது அறங்களைப் புகட்டுவதால் மேலைநாட்டு அறிஞர்களால் போற்றப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What primary virtue in Thirukkural commands the universal admiration of Western intellectuals?", "media_id": null}], "options": {"A": "Extremely verbose epic narrative structures", "B": "Depiction of ancient warfare victories", "C": "Catalogue of theological pantheons", "D": "Impartial, non-sectarian, secular ethical principles applicable to all humanity"}, "explanation": "Thirukkural's secular, non-sectarian moral universality earns worldwide reverence."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "b