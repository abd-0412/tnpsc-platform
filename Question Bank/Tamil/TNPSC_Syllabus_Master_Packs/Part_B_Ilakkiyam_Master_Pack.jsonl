{"id": "12th_tamil_mp2_q1879", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_kodungonmai_tax", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வேலொடு நின்றான் இடுவென் றதுபோலும் கோலொடு நின்றான் இரவு’ - இக்குறளில் பயின்று வந்துள்ள அணி யாது?", "media_id": null}], "options": {"A": "வேற்றுமை அணி", "B": "வஞ்சப்புகழ்ச்சி அணி", "C": "உவமை அணி", "D": "நிரல்நிறை அணி"}, "explanation": "ஆயுதத்தோடு வழிப்பறி செய்பவன் மிரட்டுவதைப் போன்றது கொடுங்கோலன் தன் குடிமக்களிடம் அநீதியாக வரி கேட்பது என 'போலும்' என்ற உவம உருபு வெளிப்பட்டு வந்ததால் இது உவமை அணி ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "'Velodu ninraan iduven radhupolum kolodu ninraan iravu' - Which figure of speech is featured in this verse?", "media_id": null}], "options": {"A": "Vetttrumai Ani", "B": "Vanchappugazhchi Ani", "C": "Uvamai Ani (Simile)", "D": "Niralnirai Ani"}, "explanation": "The explicit particle 'polum' directly comparing despotic extortionate taxation to highway armed robbery forms a Simile."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 176, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 176", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 5", "Thirukkural Figures"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp2_q1880", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_kannottam_benignity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கண்ணோட்டம் இல்லாத கண் எதற்கு ஒப்பானது?’ என்று வள்ளுவர் வினவுகிறார்?", "media_id": null}], "options": {"A": "குருட்டுக் கண்ணுக்கு", "B": "பளிங்கு மணி போன்ற கண்ணுக்கு", "C": "சுவரில் வரைந்த ஓவியத்திற்கு", "D": "முகத்தில் உள்ள வெறும் புண்ணுக்கு ஒப்பானது"}, "explanation": "'கண்ணிற்கு அணிகலம் கண்ணோட்டம் அஃதின்றேல் புண்ணென்று உணரப் படும்' - இரக்க உணர்வில்லாத கண் முகத்தில் உள்ள புண்ணாகவே கருதப்படும்."}, "en": {"blocks": [{"type": "text", "content": "To what does Thiruvalluvar compare an eye devoid of benign grace and empathy (Kannottam)?", "media_id": null}], "options": {"A": "A blind eye", "B": "A crystal gem", "C": "A painted mural", "D": "A mere festering sore upon the human countenance"}, "explanation": "Without gracious empathy, eyes are merely sores upon the face ('Punnendru unarap padum')."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 176, "chapter": null,