{"id": "12th_tamil_u3_q474", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "kambaramayanam_u3", "chapter_id": null, "topic_id": "brotherhood_progression", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கம்பராமாயணத்தில் இராமனின் உடன்பிறப்பு வரிசை எவ்வாறு விரிவடைகிறது?", "media_id": null}], "options": {"A": "நால்வர் -> ஐவர் -> அறுவர்", "B": "நால்வர் (அயோத்தி தம்பியர்) -> ஐவர் (குகனோடு) -> அறுவர் (சுக்ரீவனோடு) -> எழுவர் (வீடணனோடு)", "C": "ஐவர் -> அறுவர் -> எழுவர் -> எண்மர்", "D": "இருவர் -> நால்வர்"}, "explanation": "தசரத மைந்தர் நால்வர் -> குகனோடு ஐவர் -> சுக்ரீவனோடு அறுவர் -> வீடணனோடு எழுவர் என இராமனின் சகோதர வட்டம் விரிவடைகிறது."}, "en": {"blocks": [{"type": "text", "content": "How does the progressive arc of fraternal brotherhood expand in Kambaramayanam?", "media_id": null}], "options": {"A": "Four to five to six", "B": "Four (Ayodhya princes) -> Five (with Guha) -> Six (with Sugriva) -> Seven (with Vibhishana)", "C": "Five to six to seven to eight", "D": "Two to four"}, "explanation": "Fraternity steadily broadens: Dasaratha's four sons -> five with Guha -> six with Sugriva -> seven with Vibhishana."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation