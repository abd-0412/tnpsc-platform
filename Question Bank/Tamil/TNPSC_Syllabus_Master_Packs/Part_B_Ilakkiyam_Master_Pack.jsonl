{"id": "12th_tamil_u5_q836", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "deivamani_maalai", "chapter_id": null, "topic_id": "vallalar_prose_works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வள்ளலார் இயற்றிய உரைநடை நூல்களில் சரியான ஒன்றைத் தேர்வு செய்க:", "media_id": null}], "options": {"A": "பெரியபுராண உரை", "B": "சிவஞானபோத உரை", "C": "தொல்காப்பிய உரை", "D": "மனுமுறை கண்ட வாசகம் (மற்றும் ஜீவகாருண்ய ஒழுக்கம்)"}, "explanation": "வள்ளலார் மனுநீதிச் சோழனின் வரலாற்றை 'மனுமுறை கண்ட வாசகம்' என்னும் உரைநடை நூலாகவும், 'ஜீவகாருண்ய ஒழுக்கம்' என்னும் நூலாகவும் படைத்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Identify the celebrated classical prose work authored by Vallalar:", "media_id": null}], "options": {"A": "Periyapurana Commentary", "B": "Sivagnanabodha Bhashya", "C": "Tolkappiyam Vutti", "D": "Manumurai Kanda Vaasagam (and Jeevakaarunya Ozhukkam)"}, "explanation": "Vallalar authored the exemplary prose treatises 'Manumurai Kanda Vaasagam' and 'Jeevakaarunya Ozhukkam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 110, "chapter": null, "section": null, "reference":