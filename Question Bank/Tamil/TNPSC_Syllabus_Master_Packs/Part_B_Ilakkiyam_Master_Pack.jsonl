{"id": "9th-u3-q026", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-01-eru-thazhuvuthal", "chapter_id": null, "topic_id": "topic-eru-thazhuvuthal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஏறு தழுவுதல் விளையாட்டின் தோற்றம் தமிழர்தம் எவ்வகைத் தொழிலோடு பிரிக்க முடியாதவாறு தொடர்புடையது?", "media_id": null}], "options": {"A": "நெசவுத் தொழில்", "B": "வேளாண்மை மற்றும் கால்நடை வளர்ப்பு", "C": "மீன்பிடித் தொழில்", "D": "மரவேலைத் தொழில்"}, "explanation": "ஏறு தழுவுதல் என்பது வேளாண் குடிகளின் வாழ்வோடும் உழைப்போடும் பிணைந்து கிடந்த மாடுகளுடன் அவர்கள் விளையாடி மகிழும் மரபாக உருக்கொண்டதாகும்."}, "en": {"blocks": [{"type": "text", "content": "The origins of Eru Thazhuvuthal are inseparably tied to which foundational occupation of Tamils?", "media_id": null}], "options": {"A": "Textile weaving", "B": "Agriculture and livestock animal husbandry", "C": "Deep-sea fishing", "D": "Wood carpentry"}, "explanation": "Bull embracing evolved directly from the agrarian rhythms and cattle rearing traditions of farming homesteads."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter