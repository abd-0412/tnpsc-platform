{"id": "11th_tamil_u3_q146", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_iyal3", "chapter_id": null, "topic_id": "oppuravu_wealth_purpose", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தாள்ஆற்றித் தந்த பொருளெல்லாம் தக்கார்க்கு / வேளாண்மை செய்தற் பொருட்டு’ - ‘வேளாண்மை’ என்ற சொல்லின் குறள் பொருள் யாது?", "media_id": null}], "options": {"A": "நிலத்தை உழுவது மட்டுமே", "B": "உதவி செய்தல் (ஈகை / பிறர்க்கு உதவுதல்)", "C": "பயிர் நடுதல்", "D": "தானியங்களை விற்பனை செய்தல்"}, "explanation": "இக்குறளில் 'வேளாண்மை' என்பது நிலத்தை உழுவதைக் குறிக்காமல், 'பிறருக்கு உதவி செய்தல்' (உபகாரம் செய்தல்) என்ற பொருளில் ஆளப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "In the couplet 'Thalaatrit thantha porulellam thakkaarkku velaanmai seithar poruttu', what is the exact classical meaning of 'Velaanmai'?", "media_id": null}], "options": {"A": "Plowing agrarian topsoil exclusively", "B": "Benevolent assistance, altruistic charity, and helping the deserving", "C": "Paddy transplantation", "D": "Grain commerce"}, "explanation": "'Velaanmai' here specifically denotes selfless social service and benevolent charity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Ser