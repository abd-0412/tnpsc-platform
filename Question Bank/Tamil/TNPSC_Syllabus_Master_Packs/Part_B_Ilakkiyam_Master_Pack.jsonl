{"id": "12th_tamil_u6_q1053", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "madhavi_first_step", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாதவி அரங்கேற்ற மேடையில் ஏறும் போது தன் எந்தக் காலை முதலில் வைத்து ஏறினாள்?", "media_id": null}], "options": {"A": "வலது காலை முன்வைத்து", "B": "இடது காலை முன்வைத்து", "C": "இரு கால்களையும் சேர்த்து", "D": "குதித்து ஏறினாள்"}, "explanation": "மாதவி மங்கல மரபுப்படி தன் வலது காலை முன்வைத்து நாட்டிய மேடையில் ஏறித் தலைக்கோலின் வலப்பக்கத்தில் நின்றாள்."}, "en": {"blocks": [{"type": "text", "content": "With which foot did maiden Madhavi auspiciously step onto the dance stage for her premier debut?", "media_id": null}], "options": {"A": "Right foot forward (Valathu kaal)", "B": "Left foot forward", "C": "Both feet together", "D": "Leaping forward"}, "explanation": "Adhering to sacred tradition, Madhavi stepped onto the stage leading with her auspicious right foot."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 1