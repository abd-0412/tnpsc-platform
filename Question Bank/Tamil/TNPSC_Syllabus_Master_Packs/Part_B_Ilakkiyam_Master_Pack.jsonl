{"id": "11th_tamil_u7_q131", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "supplementary_natakakkalai", "chapter_id": null, "topic_id": "boys_company_origin", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் நாடக வரலாற்றில் சிறுவர்களை மட்டுமே நடிகர்களாகக் கொண்டு உருவாக்கப்பட்ட நாடகக் குழுக்கள் எவ்வாறு அழைக்கப்பட்டன?", "media_id": null}], "options": {"A": "இளைஞர் சங்கம்", "B": "மாணவர் அரங்கம்", "C": "பாய்ஸ் கம்பெனி (Boys Company)", "D": "சிறுவர் மன்றம்"}, "explanation": "சங்கரதாஸ் சுவாமிகளால் தொடங்கப்பட்ட 'பாய்ஸ் கம்பெனி' நாடக அமைப்பிலிருந்துதான் கே. பி. சுந்தராம்பாள், எம். கே. டி. பாகவதர், எம். ஜி. ஆர்., சிவாஜி கணேசன் உள்ளிட்ட எண்ணற்ற கலைஞர்கள் உருவாயினர்."}, "en": {"blocks": [{"type": "text", "content": "What were the traditional training-cum-performing drama troupes exclusively employing young boys called?", "media_id": null}], "options": {"A": "Youth clubs", "B": "Student stages", "C": "Boys Company", "D": "Children forums"}, "explanation": "'Boys Company' troupes served as the cradle for legendary Tamil actors."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 155, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 155", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Supplementary", "Theatre"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u7_q132", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_pathitrupathu", "chapter_id": null, "topic_id": "first_print_publication_pathitru", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுவடிகளில் உறங்கிக் கிடந்த பதிற்றுப்பத்தை முதன்முதலில் 1889-இல் அச்சேற்றிப் பதிப்பித்து வெளியிட்ட பதிப்புச் செம்மல் யார்?", "media_id": null}], "options": {"A": "சி. வை. தாமோதரம்பிள்ளை", "B": "மயிலை சீனி. வேங்கடசாமி", "C": "ஆறுமுக நாவலர்", "D": "உ. வே. சாமிநாதையர் (தமிழ்த்தாத்தா)"}, "explanation": "தமிழ்த்தாத்தா உ. வே. சாமிநாதையர் அவர்கள் 1889-இல் பதிற்றுப்பத்தை பழைய உரையுடன் முதன்முதலில் பதிப்பித்து வெளியிட்டார்."}, "en": {"blocks": [{"type": "text", "content": "Who critically retrieved, edited, and published Pathitrupathu in print for the first time in 1889?", "media_id": null}], "options": {"A": "C. W. Damodaram Pillai", "B": "Mayilai Seeni Venkatasamy", "C": "Arumuka Navalar", "D": "U. Ve. Swaminatha Iyer (Thamizhtthaathaa)"}, "explanation": "U. Ve. Swaminatha Iyer published the first print edition of Pathitrupathu in 1889."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 154, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 154", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Poetry", "Pathitrupathu"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u7_q133", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "supplementary_natakakkalai", "chapter_id": null, "topic_id": "theatre_elements_three", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாடகக் கலையின் இன்றியமையாத மூன்று முதன்மைக் கூறுகள் எவை?", "media_id": null}], "options": {"A": "நாடகப் பிரதி (உரை/கதை), நடிகர்கள் (அரங்கு), பார்வையாளர்கள் (ரசிகர்கள்)", "B": "ஒலிபெருக்கி, விளக்கு, திரைச்சீலை", "C": "டிக்கெட், மண்டபம், நாற்காலி", "D": "இசைக்கருவிகள் மட்டுமே"}, "explanation": "நாடகக் கலை முழுமை பெறுவதற்கு நாடக உரை (கதை), அதனை நடித்துக் காட்டும் நடிகர்கள், அதனை உணர்ந்து சுவைக்கும் பார்வையாளர்கள் ஆகிய மூன்றும் அவசியமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What constitute the three indispensable constitutive elements of dramatic art?", "media_id": null}], "options": {"A": "Play text (script), Actors (stage), and Audience (spectators)", "B": "Microphone, spotlight, and curtain", "C": "Tickets, auditorium, chairs", "D": "Orchestra only"}, "explanation": "The playwright's script, performing actors, and receptive audience are the trinity of drama."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term"