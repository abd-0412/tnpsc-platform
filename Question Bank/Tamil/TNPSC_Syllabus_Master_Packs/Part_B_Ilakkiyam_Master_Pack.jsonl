{"id": "11th_tamil_rev2_q060", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_leaders_epic", "chapter_id": null, "topic_id": "tamil_thai_valthu_source", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்த்தாய் வாழ்த்தாக அரசு ஏற்றுக்கொண்ட ‘நீராருங் கடலுடுத்த நிலமடந்தை...’ பாடல் இடம்பெற்ற நாடக நூல் எது?", "media_id": null}], "options": {"A": "சாகுந்தலம்", "B": "பிரதாப முதலியார் சரித்திரம்", "C": "ரூபாவதி", "D": "மனோன்மணீயம்"}, "explanation": "பேராசிரியர் பெ. சுந்தரனார் 1891-இல் இயற்றிய 'மனோன்மணீயம்' என்னும் செய்யுள் நாடக நூலின் தொடக்கப் பாயிரப் பாடலே தமிழக அரசின் தமிழ்த்தாய் வாழ்த்தாகும்."}, "en": {"blocks": [{"type": "text", "content": "In which dramatic work does the Tamil Nadu State Anthem 'Neeraarum Kadaludutha' appear?", "media_id": null}], "options": {"A": "Shakuntalam", "B": "Prathapa Mudaliar Charithiram", "C": "Roopavathi", "D": "Manonmaneeyam"}, "explanation": "The invocation to Tamil in 'Manonmaneeyam' written by Prof. P. Sundaranar in 1891 was adopted as the official State Anthem of Tamil Nadu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 200, "ch