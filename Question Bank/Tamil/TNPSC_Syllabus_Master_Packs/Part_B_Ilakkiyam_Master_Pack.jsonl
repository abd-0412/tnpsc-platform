{"id": "12th_tamil_u5_q823", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thevaaram_mayilai", "chapter_id": null, "topic_id": "poompaavai_pathigam_story", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயிலாப்பூரில் பாம்பு கடித்து இறந்த யாருடைய சாம்பல் மற்றும் எலும்புக் குடத்திலிருந்து திருஞானசம்பந்தர் உயிர்ப்பித்துப் பாடினார்?", "media_id": null}], "options": {"A": "திலகவதியார்", "B": "காரைக்கால் அம்மையார்", "C": "பூம்பாவை (சிவநேசச் செட்டியாரின் மகள்)", "D": "மங்கையர்க்கரசியார்"}, "explanation": "சிவநேசச் செட்டியார் தன் மகள் பூம்பாவையைச் சம்பந்தருக்கு மணம் முடிக்க எண்ணியிருந்த நிலையில் அவள் பாம்பு தீண்டி இறக்கவே, அவளது எலும்பைப் பதிகம் பாடி உயிர்ப்பித்தார்."}, "en": {"blocks": [{"type": "text", "content": "Whose mortal ashes and bone casket did Thirugnanasambandar bring back to life through his Thevaram verses at Mylapore?", "media_id": null}], "options": {"A": "Thilagavathiyar", "B": "Karaikkal Ammaiyar", "C": "Poompaavai (Daughter of Sivanesa Chettiyar)", "D": "Mangayarkkarasiyar"}, "explanation": "Thirugnanasambandar miraculously resurrected maiden Poompaavai from a pot of bone relics."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12