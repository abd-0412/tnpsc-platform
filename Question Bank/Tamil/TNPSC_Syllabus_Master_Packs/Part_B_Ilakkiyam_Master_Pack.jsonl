{"id": "10th-u8-q091", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ramanujar", "chapter_id": null, "topic_id": "altruistic_logic", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"நான் ஒருவன் நரகம் சென்றாலும், இந்த மந்திரத்தைக் கேட்ட பல கோடி மக்கள் வைகுண்டம் எய்துவர் என்றால் அதுவே எனக்குப் பேரின்பம்!\" - என்று கூறியவர் யார்?", "media_id": null}], "options": {"A": "வள்ளலார்", "B": "பாரதியார்", "C": "இராமானுசர்", "D": "திருநாவுக்கரசர்"}, "explanation": "பாடநூல் குறிப்பு: தன் ஒருவனின் நரகத் தண்டனையைப் பொருட்படுத்தாது, உலக மாந்தர் அனைவரும் முக்தி பெற வேண்டும் என்ற விசுவப் பேரன்போடு இராமானுசர் ஆசாரியரிடம் விடையளித்தார்."}, "en": {"blocks": [{"type": "text", "content": "Who uttered: \"Even if I alone suffer in hell, if countless souls attain liberation by hearing this, that is supreme bliss for me\"?", "media_id": null}], "options": {"A": "Vallalar", "B": "Bharathiyar", "C": "Ramanuja", "D": "Thirunavukkarasar"}, "explanation": "Ramanuja expressed this matchless self-sacrificing compassion."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 185, "chapter": null, "section": null, "referenc