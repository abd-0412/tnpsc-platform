{"id": "9th-u7-q087", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "muthollayiram-author", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்தொள்ளாயிரத்தை இயற்றிய ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "திருத்தக்கதேவர்", "B": "கபிலர்", "C": "ஆசிரியர் பெயர் அறியப்படவில்லை", "D": "நக்கீரர்"}, "explanation": "முத்தொள்ளாயிரத்தை இயற்றிய புலவரின் பெயர் கால வெள்ளத்தில் அறியப்படாமல் போயிற்று; எனவே ஆசிரியர் பெயர் தெரியவில்லை."}, "en": {"blocks": [{"type": "text", "content": "Who is the author of the classical literary anthology Muthollayiram?", "media_id": null}], "options": {"A": "Thiruthakkadevar", "B": "Kapilar", "C": "Author is unknown (ஆசிரியர் பெயர் அறியப்படவில்லை)", "D": "Nakkirar"}, "explanation": "The author of Muthollayiram remains anonymous in Tamil literary history."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 137", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null