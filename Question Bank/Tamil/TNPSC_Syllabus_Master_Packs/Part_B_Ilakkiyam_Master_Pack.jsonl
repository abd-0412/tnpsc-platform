{"id": "9th-u3-q016", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-01-eru-thazhuvuthal", "chapter_id": null, "topic_id": "topic-eru-thazhuvuthal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழர்களின் பண்பாட்டுத் திருவிழாவாக விளங்கும் ஏறு தழுவுதல் எத்தனையாயிரம் ஆண்டுகாலத் தொன்மையுடையது?", "media_id": null}], "options": {"A": "ஐந்நூறு ஆண்டுகள்", "B": "ஆயிரம் ஆண்டுகள்", "C": "ஆயிரத்தைந்நூறு ஆண்டுகள்", "D": "இரண்டாயிரம் ஆண்டுகள்"}, "explanation": "பாடநூல் கூற்று: 'தமிழர்களின் பண்பாட்டுத் திருவிழாவாக விளங்கும் ஏறு தழுவுதல் இரண்டாயிரம் ஆண்டுகாலத் தொன்மையுடையது.'"}, "en": {"blocks": [{"type": "text", "content": "How many millennia of antiquity does the Tamil cultural tradition of Eru Thazhuvuthal embody?", "media_id": null}], "options": {"A": "500 years", "B": "1000 years", "C": "1500 years", "D": "Two thousand years (2000 years)"}, "explanation": "As attested in the textbook, the cultural bull-embracing sport of Tamils boasts continuous heritage spanning over 2,000 years."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 53, "chapter": null, "section": null, "reference"