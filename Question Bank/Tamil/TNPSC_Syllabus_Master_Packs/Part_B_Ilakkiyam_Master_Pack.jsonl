{"id": "12th_tamil_u2_q278", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "nedunalvaadai", "chapter_id": null, "topic_id": "sangam_weather_realism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க இலக்கியப் பாடல்களில் இயற்கை வருணனை எத்தகையதாக அமைந்துள்ளது?", "media_id": null}], "options": {"A": "முழுக்க முழுக்கப் பொய்யான புனைவு", "B": "மக்களின் புற வாழ்வோடும் அக உணர்வுகளோடும் இயைந்த எதார்த்தமான உண்மைப் பதிவு", "C": "இயற்கையைப் புறக்கணிக்கும் போக்கு", "D": "வடமொழி மரபை அப்படியே தழுவியது"}, "explanation": "சங்கப் புலவர்கள் இயற்கையை வாழ்வோடு இணைந்த எதார்த்தமான அழகியல் பின்புலமாகப் பாடியுள்ளனர்."}, "en": {"blocks": [{"type": "text", "content": "How is nature depicted in classical Sangam literature as demonstrated in Nedunalvaadai?", "media_id": null}], "options": {"A": "Entirely fictitious fantasy", "B": "Realistic depiction seamlessly interwoven with human emotions and societal life", "C": "Total dismissal of ecology", "D": "Blind imitation of Sanskrit conventions"}, "explanation": "Sangam poetry grounds human emotions in meticulously realistic, observed natural environments."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term":