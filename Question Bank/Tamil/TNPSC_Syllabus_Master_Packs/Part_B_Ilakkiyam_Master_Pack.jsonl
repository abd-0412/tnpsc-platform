{"id": "9th-u5-q084", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l2", "chapter_id": null, "topic_id": "pulavar-kuzhandhai-ideology", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புலவர் குழந்தை எத்தகைய கொள்கைகளில் ஆழ்ந்த பற்றுடையவராகத் திகழ்ந்தார்?", "media_id": null}], "options": {"A": "வடமொழி ஆதிக்கம்", "B": "மன்னராட்சி முறை", "C": "சாதிய வேறுபாடுகள்", "D": "தனித்தமிழ் இயக்கம் மற்றும் சுயமரியாதைச் சிந்தனைகள்"}, "explanation": "புலவர் குழந்தை தந்தை பெரியாரின் சுயமரியாதை இயக்கக் கொள்கைகளிலும் மறைமலையடிகளின் தனித்தமிழ்க் கொள்கைகளிலும் ஆழ்ந்த ஈடுபாடு கொண்டு தூய தமிழில் நூல்களைப் படைத்தார்."}, "en": {"blocks": [{"type": "text", "content": "In which philosophical convictions was Pulavar Kuzhandhai deeply anchored?", "media_id": null}], "options": {"A": "Sanskritic dominance", "B": "Feudal monarchy", "C": "Caste hierarchy", "D": "Pure Tamil movement and Self-Respect rationalism"}, "explanation": "Pulavar Kuzhandhai was a dedicated champion of Maraimalai Adigal's Pure Tamil movement and Periyar's Self-Respect ideology."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 117, "chap