{"id": "11th_tamil_u5_q075", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poem_seerapuraanam", "chapter_id": null, "topic_id": "hijrah_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இசுலாமிய வரலாற்றில் ‘ஹிஜ்ரத்’ (Hijrah) என்பதன் வரலாற்றுப் பொருள் யாது?", "media_id": null}], "options": {"A": "போர் புரிதல்", "B": "மக்காவிலேயே தங்குதல்", "C": "இறை வழியில் மக்கா நகரிலிருந்து மதீனா நகரிற்கு இடம் பெயர்தல் (புனிதப் பயணம் / புலம்பெயர்தல்)", "D": "நோன்பிருத்தல்"}, "explanation": "ஹிஜ்ரத் என்பது முகம்மது நபியவர்கள் மக்கா குறைஷியரின் துன்புறுத்தல் தாளாது இறை ஆணைப்படி மக்காவிலிருந்து மதீனாவிற்குப் புலம் பெயர்ந்த வரலாற்று நிகழ்வாகும்."}, "en": {"blocks": [{"type": "text", "content": "What does the foundational Islamic concept 'Hijrah' (ஹிஜ்ரத்) historically signify?", "media_id": null}], "options": {"A": "Waging war", "B": "Remaining permanently in Mecca", "C": "Historic migration from Mecca to Medina for the cause of righteousness", "D": "Observing fasting"}, "explanation": "Hijrah designates the historic prophetic migration from Mecca to Medina."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025"