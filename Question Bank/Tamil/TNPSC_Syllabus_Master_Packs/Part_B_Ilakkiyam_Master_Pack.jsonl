{"id": "9th-u5-q030", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "thanjavur-big-temple", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முதலாம் இராசராச சோழனால் கட்டப்பட்ட தஞ்சைப் பெரிய கோயிலின் விமானத்தின் உயரம் எத்தனை அடி?", "media_id": null}], "options": {"A": "180 அடி", "B": "216 அடி", "C": "250 அடி", "D": "196 அடி"}, "explanation": "தஞ்சைப் பெரிய கோயிலின் விமானம் 216 அடி உயரம் கொண்டது. இதன் உச்சியில் அமைந்துள்ள பிரம்மாண்டமான கல் 80 டன் எடைகொண்ட ஒரே கருங்கல்லாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the height of the grand Vimana of the Thanjavur Brihadisvara Temple built by Rajaraja Chola I?", "media_id": null}], "options": {"A": "180 feet", "B": "216 feet", "C": "250 feet", "D": "196 feet"}, "explanation": "The majestic granite Vimana of Thanjavur Big Temple rises to 216 feet, crowned by an 80-tonne monolithic cupola block."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 110, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 110", "url": null, "source_notes": null}, "previous_year":