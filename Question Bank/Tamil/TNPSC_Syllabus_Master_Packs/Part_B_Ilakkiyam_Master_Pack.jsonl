{"id": "12th_tamil_mp2_q1903", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_english_translation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளை ஆங்கிலத்தில் முழுமையாக மொழிபெயர்த்து 1886-இல் வெளியிட்ட கிறிஸ்தவ அறிஞர் யார்?", "media_id": null}], "options": {"A": "வீரமாமுனிவர்", "B": "கால்டுவெல்", "C": "ஜி.யு. போப் (G.U. Pope)", "D": "வின்சுலோ"}, "explanation": "ஜி.யு. போப் 1886 ஆம் ஆண்டு திருக்குறளை முழுமையாக ஆங்கிலத்தில் மொழிபெயர்த்து உலகறிஞர்களின் கவனத்திற்கு கொண்டு சென்றார்."}, "en": {"blocks": [{"type": "text", "content": "Who published the complete English verse translation of Thirukkural in 1886?", "media_id": null}], "options": {"A": "Veeramamunivar", "B": "Robert Caldwell", "C": "G.U. Pope", "D": "Miron Winslow"}, "explanation": "Rev. G.U. Pope published his complete monumental English translation of Thirukkural in 1886."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 174, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 174", "url": null, "source_no