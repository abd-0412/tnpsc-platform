{"id": "9th-u5-q053", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "nataraja-bronze", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சோழர் காலச் செப்புத் திருமேனிகளுள் உலகப் புகழ்பெற்ற பேரழகு வாய்ந்த வடிவம் எது?", "media_id": null}], "options": {"A": "ஆடவல்லான் (நடராசர்) திருமேனி", "B": "துவாரபாலகர் வடிவம்", "C": "யாளி வடிவம்", "D": "கருடன் வடிவம்"}, "explanation": "சோழர் காலச் செப்புத் திருமேனிகளில் 'ஆடவல்லான்' என்னும் கூத்தபிரான் (நடராசர்) செப்புத் திருமேனி உலகக் கலை வரலாற்றின் இணையற்ற சிகரமாகப் போற்றப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which world-renowned bronze icon stands as the crowning glory of Chola lost-wax metallurgical casting?", "media_id": null}], "options": {"A": "Nataraja (Aadavallan - Cosmic Dancer)", "B": "Dwarapalaka figure", "C": "Yali figure", "D": "Garuda figure"}, "explanation": "The cosmic dance of Shiva (Nataraja / Aadavallan) cast in bronze during the Chola era is celebrated worldwide as an artistic triumph."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 110, "chapter": null, "section":