{"id": "12th_tamil_mp2_q1847", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "kodaimazhai_theme", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சாந்தா தத்தின் 'கோடை மழை' துணைப்பாடக் கதை உணர்த்தும் முதன்மை அறநெறி யாது?", "media_id": null}], "options": {"A": "பணத்தின் வலிமை", "B": "இயற்கைச் சீற்றத்தின் கொடுமை", "C": "எளிய மனிதர்களிடையே விளங்கும் மனிதநேயமும் பாசமும்", "D": "நகர நாகரிகத்தின் ஆடம்பரம்"}, "explanation": "கோடை மழை கதை எளிய கிராமத்து மக்களிடையே உள்ள தூய மனிதநேயத்தையும் அன்பையும் அழகாக எடுத்துரைக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What core humanist virtue is portrayed in Shantha Dutt's supplementary story 'Kodai Mazhai'?", "media_id": null}], "options": {"A": "Supremacy of money", "B": "Severity of natural disasters", "C": "Selfless human compassion and deep affection among ordinary rural folks", "D": "Opulence of urban life"}, "explanation": "'Kodai Mazhai' depicts heartfelt empathy, humanism, and mutual care among simple villagers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 170, "chapter"