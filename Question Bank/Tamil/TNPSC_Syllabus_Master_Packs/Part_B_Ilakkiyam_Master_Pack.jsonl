{"id": "12th_tamil_mp2_q1904", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_gold_coin_ellis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருவள்ளுவரின் உருவம் பொறித்த தங்கக் காசை 1812-இல் வெளியிட்ட சென்னை மாகாண ஆட்சியர் யார்?", "media_id": null}], "options": {"A": "மெக்காலே பிரபு", "B": "ரிப்பன் பிரபு", "C": "வில்லியம் பெண்டிங்", "D": "பிரான்சிஸ் ஒயிட் எல்லிஸ் (எல்லிஸ் துரை)"}, "explanation": "சென்னை மாகாண ஆட்சியராக இருந்த எல்லிஸ் துரை வள்ளுவரின் பெருமையை உணர்ந்து அவரது உருவம் பொறித்த தங்கக் காசுகளை வெளியிட்டார்."}, "en": {"blocks": [{"type": "text", "content": "Which Madras Presidency civil servant and collector minted a commemorative gold coin bearing Thiruvalluvar's image in 1812?", "media_id": null}], "options": {"A": "Lord Macaulay", "B": "Lord Ripon", "C": "Lord William Bentinck", "D": "Francis Whyte Ellis (F.W. Ellis)"}, "explanation": "F.W. Ellis, Collector of Madras and Tamil enthusiast, minted gold coins honoring Thiruvalluvar in 1812."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 174, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 174", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 5", "Ellis Gold Coin"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

