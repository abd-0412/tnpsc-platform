{"id": "12th_tamil_u6_q1024", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "thalaikkol_purification", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாதவியின் அரங்கேற்றத்திற்கு முன்பாகத் தலைக்கோலை எங்கு கொண்டுசென்று புனித நீராட்டுவர்?", "media_id": null}], "options": {"A": "கடற்கரையில்", "B": "கோயில் குளத்தில்", "C": "அரண்மனை அந்தப்புரத்தில்", "D": "காவிரி நதி நீராட்டி, யானையின் பிடரியின் மேல் ஏற்றி நகர்வலம் வருவர்"}, "explanation": "தலைக்கோலைக் காவிரி நதிக்குக் கொண்டுசென்று நீராட்டி, மலர்மாலை சூட்டி, பட்டத்து யானையின் பிடரியின் மீது ஏற்றி மேளதாளங்களுடன் ஊர்வலமாக ஆடரங்கிற்கு எடுத்து வருவர்."}, "en": {"blocks": [{"type": "text", "content": "How was the ceremonial Thalaikkol ritually consecrated prior to Madhavi's royal dance premiere?", "media_id": null}], "options": {"A": "Immersed in sea surf", "B": "Sprinkled with temple holy water", "C": "Stored in the queen's bedchamber", "D": "Bathed in sacred Cauvery waters and paraded atop the state elephant with fanfare to the theater"}, "explanation": "The staff was consecrated in the holy Cauvery and paraded through the city on a royal elephant."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu T