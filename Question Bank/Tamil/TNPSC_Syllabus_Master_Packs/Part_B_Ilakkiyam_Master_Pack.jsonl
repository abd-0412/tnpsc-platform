{"id": "9th-u9-q121", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l5", "chapter_id": null, "topic_id": "sorporul-pinvarunilai-def", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "செய்யுளில் முன்னர் வந்த சொல்லே மீண்டும் மீண்டும் வந்து ஒரே பொருளைத் தருவது எவ்வகை அணி?", "media_id": null}], "options": {"A": "சொற்பொருள் பின்வருநிலையணி", "B": "சொல் பின்வருநிலையணி", "C": "பொருள் பின்வருநிலையணி", "D": "சிலேடை அணி"}, "explanation": "செய்யுளில் முன்னர் வந்த அதே சொல் மீண்டும் மீண்டும் வந்து அதே ஒரே பொருளைத் தருமானால் அது 'சொற்பொருள் பின்வருநிலையணி' (சொல்லும் பொருளும் இரண்டும் பின்வருவது) எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "When the exact same word recurs repeatedly in a stanza and retains the exact same meaning each time, what figure is formed?", "media_id": null}], "options": {"A": "Sorporul Pinvarunilai Ani (சொற்பொருள் பின்வருநிலையணி - Verbal and Semantic Reiteration)", "B": "Sol Pinvarunilai Ani", "C": "Porul Pinvarunilai Ani", "D": "Siledai Ani"}, "explanation": "Sorporul Pinvarunilai Ani features the same word repeating with the identical semantic meaning."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "c