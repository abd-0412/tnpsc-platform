{"id": "12th_tamil_mp2_q1894", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_uzhavu_fertilizer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஏரினும் நன்றால் எருவிடுதல் கட்டபின் நீரினும் நன்றால் காப்பு’ - இக்குறள் வேளாண்மையின் எதனைப் போதிக்கிறது?", "media_id": null}], "options": {"A": "விலை நிர்ணயம் செய்யும் முறை", "B": "உழுதலை விட உரம் இடுதலும், நீர்பாய்ச்சுவதை விடப் பாதுகாத்தலும் இன்றியமையாதது", "C": "வேளாண் கடன் பெறும் வழி", "D": "மழைக்காக யாகம் செய்யும் முறை"}, "explanation": "உழுவதை விட எருவிடுதலும், நீர் பாய்ச்சிய பின்னர் களையெடுத்துப் பயிரைப் பாதுகாத்தலும் உழவுக்கு மிக முக்கியம் என அறிவியல் வேளாண்மையை வள்ளுவர் உணர்த்துகிறார்."}, "en": {"blocks": [{"type": "text", "content": "'Erinum nanraal eruvidudhal kattapin neerinum nanraal kaappu' - What agronomic scientific practice does this teach?", "media_id": null}], "options": {"A": "Grain market pricing", "B": "Manuring is more crucial than plowing, and crop protection/weeding is more essential than merely watering", "C": "Farm credit systems", "D": "Rainmaking rituals"}, "explanation": "Valluvar outlines scientific agriculture: fertilizing outweighs repeated plowing, and pest/weed protection outweighs irrigation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": 