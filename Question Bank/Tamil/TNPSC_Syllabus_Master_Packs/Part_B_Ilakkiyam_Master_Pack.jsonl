{"id": "11th_tamil_u8_q076", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "purudothaman_chera_capital", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சேர மன்னன் புருடோத்தமனின் அரசுத் தலைநகராக மனோன்மணீயத்தில் குறிப்பிடப்படும் இடம் எது?", "media_id": null}], "options": {"A": "முசிறி", "B": "தொண்டி", "C": "கொல்லம்", "D": "வஞ்சி மாநகரம்"}, "explanation": "சேர மன்னர்களின் மரபுசார் தலைநகரான 'வஞ்சி' மாநகரையே புருடோத்தமனின் அரசிருக்கையாகச் சுந்தரனார் அமைத்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "What historical royal seat serves as King Purudothaman capital in Manonmaniyam?", "media_id": null}], "options": {"A": "Musiri", "B": "Thondi", "C": "Kollam", "D": "Vanchi capital (Vanchi Maanagaram)"}, "explanation": "Vanchi represents King Purudothaman imperial capital in the play."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 180, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 180", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "