{"id": "11th_tamil_u3_q081", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "kurunthogai_27_tree_reference", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கழனி மாஅத்து விளைந்து உகு தீம்பழம்...’ என்ற குறுந்தொகைப் பாடலில் ‘மா’ என்பது எந்த மரத்தைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "மாமரம் (Mango tree)", "B": "மாதுளை", "C": "மருத மரம்", "D": "மகிழ மரம்"}, "explanation": "கழனி மாஅத்து என்பதில் 'மா' என்பது வயல் வரப்பில் நின்று இனிய மாம்பழங்களைத் தரும் மாமரத்தைக் குறிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "In the Kurunthogai verse 'Kazhani maathu vilainthu ugu theempazham', what botanical tree does 'Maa' denote?", "media_id": null}], "options": {"A": "Mango tree (Mangifera indica)", "B": "Pomegranate tree", "C": "Marutham tree (Terminalia arjuna)", "D": "Magizham tree"}, "explanation": "'Maa' refers to the sweet mango tree growing beside the fertile agricultural rice fields."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 50, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 50", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Poetry", "Flora"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q082", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "purananooru_182_world_virtue", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘புகழ் எனின் உயிருங் கொடுக்குவர் பழியெனின் / உலகுடன் பெறினும் கொள்ளலர்...’ - இவ்வடிகள் சங்க காலத் தமிழரின் எத்தகைய விழுமியத்தை உணர்த்துகின்றன?", "media_id": null}], "options": {"A": "பொருளாதார பேராசை", "B": "உயிரினும் மேலான மானமும் புகழும் காக்கும் விழுமிய அறம்", "C": "அடிமைத்தனம்", "D": "அச்ச உணர்வு"}, "explanation": "நற்புகழ் வருமெனில் உயிரையும் தரத் துணிவதும், பழி வருமெனில் உலகமே கிடைத்தாலும் வெறுத்தொதுக்குவதும் தமிழரின் தன்னிகரற்ற மான விழுமியமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What sublime moral ethos of Sangam civilization is enshrined in the verse 'Pugazh enin uyirung kodukkuvar pazhiyenin ulagudan perinun kollalar'?", "media_id": null}], "options": {"A": "Commercial greed", "B": "Sacrificing life itself for honor and renouncing the cosmos rather than bearing dishonor", "C": "Feudal servility", "D": "Cowardice"}, "explanation": "It epitomizes supreme ethical dignity where honor outweighs life and dishonor is utterly shunned."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 51", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Philosophy", "Sangam Ethics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q083", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "purananooru_commentators", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புறநானூற்றுக்குக் கிடைத்துள்ள பழைய உரை எந்தப் பாடல் வரை மட்டுமே கிடைத்துள்ளது?", "media_id": null}], "options": {"A": "முதல் 100 பாடல்கள்", "B": "முதல் 200 பாடல்கள்", "C": "முதல் 266 பாடல்கள் வரை மட்டுமே", "D": "400 பாடல்களுக்கும் முழுமையாகக் கிடைத்துள்ளது"}, "explanation": "புறநானூற்றுக்கு எழுதப்பட்ட பழைய உரையாசிரியரின் உரை 1 முதல் 266 பாடல்களுக்கு மட்டுமே கிடைத்துள்ளது; எஞ்சிய பாடல்களுக்குப் பழைய உரை கிடைக்கவில்லை."}, "en": {"blocks": [{"type": "text", "content": "Up to which poem does the ancient classical commentary (Pazhaya Urai) of Purananooru survive today?", "media_id": null}], "options": {"A": "First 100 poems only", "B": "First 200 poems only", "C": "First 266 poems only", "D": "Complete commentary for all 400 poems"}, "explanation": "The anonymous ancient classical commentary survives only for verses 1 through 266."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 51", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Commentary Tradition", "Purananooru Manuscripts"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q084", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "purananooru_universal_appeal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உண்டால் அம்ம இவ்வுலகம்...’ பாடல் எந்தக் காலத்திற்கும் பொருந்தும் உலகப் பொதுமைப் பாடலாகத் திகழக் காரணம் என்ன?", "media_id": null}], "options": {"A": "போர்க் கருவிகளைப் பட்டியலிடுவதால்", "B": "ஒரு மதக் கோட்பாட்டை மட்டுமே வலியுறுத்துவதால்", "C": "ஒரு குறிப்பிட்ட மன்னனின் வெற்றியைப் பாடுவதால்", "D": "சுயநலமின்றி பிறர்க்கென வாழும் மனித நேயமே உலகை நிலைநிறுத்துகிறது என்ற உலகளாவிய அறத்தை உணர்த்துவதால்"}, "explanation": "எந்த ஒரு சாதி, மதம், எல்லைகளுக்கு உட்படாமல் மனிதநேயத்தையும் தன்னலமற்ற தியாகத்தையுமே உலகின் ஆதார சுருதியாகக் காட்டுவதால் இப்பாடல் எக்காலத்துக்கும் உரிய உலகப் பொதுப்பாடலாக விளங்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "Why does Purananooru 182 ('Undaal amma ivvulagam') stand as a timeless universal manifesto across millennia?", "media_id": null}], "options": {"A": "Because it chronicles iron weaponry", "B": "Because it propagates sectarian dogmas", "C": "Because it panegyrizes a specific dynastic monarch", "D": "Because it affirms that selfless altruistic humanism is the sole foundation that sustains planetary human existence"}, "explanation": "It transcends geographic borders to proclaim that unselfish love and virtue are what sustain civilization."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 51", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Philosophy", "Universal Humanism"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

