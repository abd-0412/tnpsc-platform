{"id": "7th-t2-pyq-q332", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-09-tamil-olir-idangal", "chapter_id": null, "topic_id": "ta-t2-bridging-odd-location-places", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் ஒளிர் இடங்களில் 'சென்னையில் அமையாத' ஒன்றை அடையாளம் காண்க:"}], "options": {"A": "கன்னிமாரா நூலகம்", "B": "சரசுவதி மகால் நூலகம்", "C": "வள்ளுவர் கோட்டம்", "D": "உ.வே.சா நூலகம்"}, "explanation": "கன்னிமாரா நூலகம், வள்ளுவர் கோட்டம், உ.வே.சா நூலகம் ஆகியவை சென்னையில் அமைந்துள்ளன. சரசுவதி மகால் நூலகம் தஞ்சாவூரில் அமைந்துள்ளது. எனவே 'B' பொருந்தாதது."}, "en": {"blocks": [{"type": "text", "content": "Identify the Tamil illuminating historic site which is NOT located in Chennai:"}], "options": {"A": "Connemara Library", "B": "Saraswathi Mahal Library", "C": "Valluvar Kottam", "D": "U.Ve.Sa Library"}, "explanation": "Saraswathi Mahal Library is in Thanjavur; the others are in Chennai. B is the odd one."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 34, "chapter": null, "section": null, "reference": null, "url