{"id": "11th_tamil_u5_q094", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poetry_agananuru", "chapter_id": null, "topic_id": "kadavul_vazhthu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அகநானூற்றின் கடவுள் வாழ்த்துப் பாடலைப் பாடியவர் யார்? அப்பாடல் போற்றும் தெய்வம் எது?", "media_id": null}], "options": {"A": "கபிலர்; முருகன்", "B": "பாரதம் பாடிய பெருந்தேவனார்; சிவபெருமான்", "C": "நக்கீரர்; சிவன்", "D": "பெருங்குன்றூர்கிழார்; திருமால்"}, "explanation": "அகநானூற்றின் கடவுள் வாழ்த்துப் பாடலைப் பாடியவர் பாரதம் பாடிய பெருந்தேவனார். அப்பாடல் சிவபெருமானைப் போற்றுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Who sang the Kadavul Vazhthu of Agananuru, and which deity is praised?", "media_id": null}], "options": {"A": "Kapilar; Murugan", "B": "Bharatham Padiya Perundhevanar; Lord Shiva", "C": "Nakkirar; Shiva", "D": "Perunkundrurkizhar; Thirumal"}, "explanation": "Bharatham Padiya Perundhevanar sang the invocation praising Lord Shiva."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": "11th Tamil, Unit 5, Page 114", "url": n