{"id": "12th_tamil_u3_q561", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "tnpsc_pyq_u3", "chapter_id": null, "topic_id": "kambar_sadayappar_gratitude", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கம்பர் தம்மை ஆதரித்த சடையப்ப வள்ளலைப் பெருமைப்படுத்தும் விதமாகக் கம்பராமாயணத்தில் எத்தனை பாடல்களுக்கு ஒரு பாடல் வீதம் பாடியுள்ளார்?", "media_id": null}], "options": {"A": "ஆயிரம் பாடல்களுக்கு ஒரு பாடல் வீதம்", "B": "நூறு பாடல்களுக்கு ஒரு பாடல்", "C": "பத்துப் பாடல்களுக்கு ஒரு பாடல்", "D": "ஐநூறு பாடல்களுக்கு ஒரு பாடல்"}, "explanation": "கம்பர் தம்மைப் புரந்த சடையப்ப வள்ளலுக்கு நன்றி செலுத்தும் வகையில் ஆயிரம் பாடல்களுக்கு ஒரு பாடல் வீதம் அவரைப் புகழ்ந்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "In gratitude to his patron Sadayappa Vallal, at what frequency did Kambar praise him in the verses of Ramavatharam?", "media_id": null}], "options": {"A": "Once in every one thousand verses (Aayiram paadalkalukku oru paadal)", "B": "Once in every 100 verses", "C": "Once in every 10 verses", "D": "Once in every 500 verses"}, "explanation": "Kambar memorialized Sadayappa Vallal once every 1,000 verses throughout the epic."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Serv