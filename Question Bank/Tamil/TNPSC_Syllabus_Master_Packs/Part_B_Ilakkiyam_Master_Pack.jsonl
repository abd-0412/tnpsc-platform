{"id": "9th-u6-q057", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l2", "chapter_id": null, "topic_id": "vairamuthu-contemporary-poem", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"ஓ, என் சமகாலத் தோழர்களே!\" என்னும் தலைப்பில் நவீன அறிவியல் சிந்தனைகளை இளைஞர்களுக்கு ஊட்டும் கவிதையைப் படைத்த கவிஞர் யார்?", "media_id": null}], "options": {"A": "கவிஞர் வைரமுத்து", "B": "கவிக்கோ அப்துல் ரகுமான்", "C": "நா. காமராசன்", "D": "மீரா"}, "explanation": "இளைஞர்களை அறிவியல் கண்டுபிடிப்புகளிலும் விண்வெளி ஆய்விலும் ஈடுபடத் தூண்டும் வகையில் 'ஓ, என் சமகாலத் தோழர்களே!' என்னும் எழுச்சிக் கவிதையைப் படைத்தவர் கவிஞர் வைரமுத்து ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who penned the inspirational modern scientific poem titled 'O, En Samakaalath Thozhargalae!' addressing contemporary youth?", "media_id": null}], "options": {"A": "Kavignar Vairamuthu", "B": "Kavikko Abdul Rahman", "C": "Na. Kamarasan", "D": "Meera"}, "explanation": "Kavignar Vairamuthu composed the visionary poem 'O, En Samakaalath Thozhargalae!' urging youth towards scientific conquests."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition"