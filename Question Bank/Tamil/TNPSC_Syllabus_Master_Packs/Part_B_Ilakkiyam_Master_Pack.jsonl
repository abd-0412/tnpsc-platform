{"id": "9th-u8-q095", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l4", "chapter_id": null, "topic_id": "letter-to-son-author", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மகனுக்கு எழுதிய கடிதம்' என்னும் விரிவானப் பகுதியின் ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "வைரமுத்து", "B": "கண்ணதாசன்", "C": "கவிஞர் நா. முத்துக்குமார்", "D": "வாலி"}, "explanation": "'மகனுக்கு எழுதிய கடிதம்' என்ற உள்ளத்தை உருக்கும் அன்பு மடலை எழுதியவர் புகழ்பெற்ற பாடலாசிரியர் கவிஞர் நா. முத்துக்குமார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who penned the evocative supplementary prose piece 'Letter to My Son' (மகனுக்கு எழுதிய கடிதம்)?", "media_id": null}], "options": {"A": "Vairamuthu", "B": "Kannadasan", "C": "Poet Na. Muthukumar (கவிஞர் நா. முத்துக்குமார்)", "D": "Vaali"}, "explanation": "Poet and lyricist Na. Muthukumar authored the touching paternal letter to his young son."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 161", "url": null, "source_notes": null}, "previous_year": {"is_pre