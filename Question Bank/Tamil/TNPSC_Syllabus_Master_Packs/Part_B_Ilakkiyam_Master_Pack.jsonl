{"id": "8th-u4-q504", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u4-l3", "chapter_id": null, "topic_id": "mannamai-muzhavu-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மண்ணமை முழவு' என்னும் சங்க இலக்கியத் தொடர் இடம்பெற்றுள்ள ஆற்றுப்படை நூல் எது?"}], "options": ["திருமுருகாற்றுப்படை", "சிறுபாணாற்றுப்படை", "பெரும்பாணாற்றுப்படை", "பொருநராற்றுப்படை"], "explanation": "பாடநூல் பக்கம் 79-இன் படி: 'மண்ணமை முழவு எனப் பொருநராற்றுப்படையில் இடம்பெற்றுள்ளது'."}, "en": {"blocks": [{"type": "text", "content": "In which Attruppadai text of Sangam literature does the phrase 'மண்ணமை முழவு' occur?"}], "options": ["Thirumurugattruppadai", "Sirupanattruppadai", "Perumpanattruppadai", "Porunarattruppadai"], "explanation": "According to textbook page 79, the phrase 'மண்ணமை முழவு' is found in Porunarattruppadai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 79, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["porunarattruppadai", "muzhavu", "direct"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

