{"id": "9th-u7-q110", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "pandya-pearl-world-trade", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாண்டிய நாட்டு முத்துகளை விரும்பி வாங்கிய பண்டைய மேலைநாட்டு வணிகர்கள் யார்?", "media_id": null}], "options": {"A": "ஆங்கிலேயர்கள்", "B": "ரோமானிய மற்றும் கிரேக்க (யவன) வணிகர்கள்", "C": "போர்ச்சுகீசியர்கள்", "D": "டச்சுக்காரர்கள்"}, "explanation": "கொற்கைத் துறைமுகத்தில் விளைந்த உயர்ந்த முத்துகளை உரோமானிய, கிரேக்க (யவன) வணிகர்கள் கப்பல்களில் பொன்னைக் கொடுத்து வாங்கிச் சென்றனர்."}, "en": {"blocks": [{"type": "text", "content": "Which ancient Western seafaring merchants avidly imported the prized pearls of the Pandyan coast in exchange for gold?", "media_id": null}], "options": {"A": "The British", "B": "Roman and Greek (Yavana) traders (ரோமானியர், யவனர்)", "C": "Portuguese navigators", "D": "Dutch merchants"}, "explanation": "Classical Greco-Roman (Yavana) records corroborate the immense maritime trade in Korkai pearls."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 137", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_7", "pandya", "pearl_trade"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u7-q111", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "muthollayiram-name-etymology", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'முத்தொள்ளாயிரம்' என்னும் பெயரின் சொற்பிரிப்பு எது?", "media_id": null}], "options": {"A": "முத்து + தொள்ளாயிரம்", "B": "முதுமை + தொள்ளாயிரம்", "C": "மூன்று + தொள்ளாயிரம்", "D": "முழுமை + தொள்ளாயிரம்"}, "explanation": "'முத்தொள்ளாயிரம்' என்பது மூன்று + தொள்ளாயிரம் எனப் பிரியும்; மூன்று மன்னர்களைப் பற்றிய 900 பாடல்கள் என்பது இதன் பொருளாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the precise morphological division of the title compound 'Muthollayiram'?", "media_id": null}], "options": {"A": "Muthu + Thollayiram", "B": "Mudhumai + Thollayiram", "C": "Moondru + Thollayiram (மூன்று + தொள்ளாயிரம்)", "D": "Muzhumai + Thollayiram"}, "explanation": "The compound splits into 'Moondru' (Three) + 'Thollayiram' (Nine hundred), denoting 900 verses on the three monarchs."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "9th Tamil, Unit