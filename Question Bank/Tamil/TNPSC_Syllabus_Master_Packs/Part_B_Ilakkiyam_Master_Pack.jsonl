{"id": "12th_tamil_u3_q533", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_u3", "chapter_id": null, "topic_id": "ilvaazhkkai_kural_1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அன்பும் அறனும் உடைத்தாயின் இல்வாழ்க்கை\nபண்பும் பயனும் அது’ - இக்குறட்பாவில் பயின்று வந்துள்ள அணி எது?", "media_id": null}], "options": {"A": "நிரல் நிறை அணி", "B": "வேற்றுமை அணி", "C": "உவமை அணி", "D": "சொல் பின்வரு நிலையணி"}, "explanation": "அன்பு, அறன் என்னும் சொற்களை வரிசையாக நிறுத்தி, பண்பு, பயன் என்னும் சொற்களோடு நேரே பொருத்துவதால் ‘நிரல் நிறை அணி’ (முறை நிரல் நிறை அணி) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which poetic device (Ani) is deployed in the Thirukkural verse 'Anbum aranum udaithaayin ilvaazhkkai panbum payanum adhu'?", "media_id": null}], "options": {"A": "Niral Nirai Ani (Symmetrical syntactic parallel alignment)", "B": "Vetrumai Ani", "C": "Uvamai Ani", "D": "Sol Pinvaru Nilaiyani"}, "explanation": "Love and righteousness are aligned in parallel with character and benefit, exemplifying Niral Nirai Ani."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 63, "