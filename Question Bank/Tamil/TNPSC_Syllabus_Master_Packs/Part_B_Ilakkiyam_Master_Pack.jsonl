{"id": "12th_tamil_mp2_q1830", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "mayilai_seeni_first_book", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயிலை சீனி. வேங்கடசாமி 1936-ஆம் ஆண்டு வெளியிட்ட அவரது முதல் ஆய்வு நூல் எது?", "media_id": null}], "options": {"A": "பௌத்தமும் தமிழும்", "B": "கிறித்தவமும் தமிழும்", "C": "சமணமும் தமிழும்", "D": "மறைந்துபோன தமிழ் நூல்கள்"}, "explanation": "1936-இல் வெளியான 'கிறித்தவமும் தமிழும்' மயிலை சீனி. வேங்கடசாமியின் முதல் ஆய்வு நூலாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which was the first research monograph published by Mayilai Seeni. Venkatasamy in 1936?", "media_id": null}], "options": {"A": "Bouddhamum Thamizhum", "B": "Kirithavamum Thamizhum", "C": "Samanamum Thamizhum", "D": "Maraindhupona Thamizh Noolgal"}, "explanation": "'Kirithavamum Thamizhum', published in 1936, marked Mayilai Seeni. Venkatasamy's debut scholarly book."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 161", "ur