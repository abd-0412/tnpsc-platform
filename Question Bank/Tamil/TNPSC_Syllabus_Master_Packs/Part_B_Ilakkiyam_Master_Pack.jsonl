{"id": "10th-u4-q080", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "perumal_thirumozhi", "chapter_id": null, "topic_id": "devotional_context", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குலசேகர ஆழ்வாரின் பக்தியில் வெளிப்படும் முக்கிய உணர்வு யாது?", "media_id": null}], "options": {"A": "மன்னனின் ஆணவம்", "B": "போர் வெறி", "C": "பொருளாசை", "D": "இறைவனின் சோதனைக்கு அஞ்சாது அவன் திருவடிகளிலேயே முழுமையாகத் தஞ்சம் அடையும் பக்திச் சமர்ப்பணம்"}, "explanation": "உலக ஆசைகளையும் துன்பங்களையும் புறந்தள்ளி, இறைவனின் திருவருளையே உயிர்மூச்சாகக் கருதும் ஒப்பற்ற பக்தி அர்ப்பணிப்பே இப்பாசுரத்தின் மைய உணர்வாகும்."}, "en": {"blocks": [{"type": "text", "content": "What overarching devotional sentiment permeates this pasuram?", "media_id": null}], "options": {"A": "Royal hubris", "B": "Militaristic aggression", "C": "Material greed", "D": "Steadfast spiritual surrender anchored solely in the Divine Footstool undeterred by worldly affliction"}, "explanation": "Absolute spiritual sanctuary and divine surrender define the emotional core of this hymn."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 78