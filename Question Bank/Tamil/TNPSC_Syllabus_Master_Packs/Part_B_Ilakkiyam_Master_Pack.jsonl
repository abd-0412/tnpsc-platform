{"id": "11th_tamil_rev1_q083", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "purananuru_altruism_phrase", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"அன்ன மாட்சி அனைய ராகலின்\nதமக்கென வாழாப் பிறர்க்குரியாளர்\nஉண்டா லம்மஇவ் வுலகம்\" - இப்பாடலின் இறுதி வரிகள் எதனை நிலைநாட்டுகின்றன?", "media_id": null}], "options": {"A": "அரசனின் வல்லமையை", "B": "இயற்கையின் கொடையை", "C": "தமக்கென வாழாமல் பிறர்க்கென வாழும் மனிதநேயப் பண்பே உலக இயக்கத்தின் அச்சாணி என்பதை", "D": "மரணத்தின் தவிர்க்க முடியாத தன்மையை"}, "explanation": "இவ்வுலகம் இன்னும் அழியாமல் நிலைபெற்றிருப்பதற்குக் காரணம் சுயநலமற்று வாழும் உயர்ந்த சான்றோர்களின் தியாகமே என்று இளம்பெருவழுதி மெய்ப்பிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "What universal humanist axiom is immortalized in the concluding verses of 'Undalamma Ivvulagam'?", "media_id": null}], "options": {"A": "Monarchical omnipotence", "B": "Bounty of raw nature", "C": "Selfless altruists living solely for others sustain the cosmic existence of our world", "D": "The inevitability of mortality"}, "explanation": "The world survives solely through the virtue of selfless altruists."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 61, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 61", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 1", "Poetry", "Purananuru"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev1_q084", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "summary_batch3_u3_u4", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல்கள் 3 மற்றும் 4-ன் உரைநடை மற்றும் செவ்வியல் இலக்கியப் பகுதிகள் மாணவர்களிடம் ஏற்படுத்தும் முழுமையான வரலாற்றுப் பார்வை யாது?", "media_id": null}], "options": {"A": "வரலாற்றை மறக்க வேண்டும் என்ற எண்ணம்", "B": "குறுகிய எல்லைகளுக்குள் முடங்கும் மனப்பாங்கு", "C": "பழைய இலக்கியங்கள் தேவையில்லை என்ற கருத்து", "D": "சிந்துவெளி முதல் கீழடி வரையிலான தமிழரின் தொன்மை நாகரிகப் பெருமிதமும், சங்க இலக்கியத்தின் அறவுணர்வும், அறிவொளி தரும் கல்வியின் இன்றியமையாமையும்"}, "explanation": "சிந்துவெளியின் திராவிட அடித்தளம், சங்க இலக்கியத்தின் மானுட அறம், கல்வி வளர்ச்சியின் வரலாறு ஆகிய மூன்றும் தமிழனின் அறிவியல், இலக்கிய, சமூக மேன்மையை உலக அரங்கில் நிறுவுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What overarching socio-historical consciousness is cultivated by the classical prose and poetry of Units 3 and 4?", "media_id": null}], "options": {"A": "Apathy toward historical heritage", "B": "Narrow chauvinistic parochialism", "C": "Disdain for classical literature", "D": "Pride in Tamil civilization from Indus to Keeladi, sublime ethical humanism of Sangam poetry, and emancipatory power of education"}, "explanation": "Units 3 and 4 celebrate the civilizational continuum from Indus to Keeladi, Sangam ethics, and educational enlightenment."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order