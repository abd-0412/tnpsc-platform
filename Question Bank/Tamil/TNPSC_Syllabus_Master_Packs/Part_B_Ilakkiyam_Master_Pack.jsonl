{"id": "11th_tamil_u2_q109", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aingurunooru", "chapter_id": null, "topic_id": "marutham_landscape_traits", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மருத நிலத்தின் முதன்மையான நிலப்பரப்பு மற்றும் தொழில் எவை?", "media_id": null}], "options": {"A": "வயலும் வயல் சார்ந்த நிலமும்; உழவுத் தொழில்", "B": "மலையும் மலை சார்ந்த நிலமும்; வேட்டையாடுதல்", "C": "காடும் காடு சார்ந்த நிலமும்; ஆநிரை மேய்த்தல்", "D": "கடலும் கடல் சார்ந்த நிலமும்; மீன்பிடித்தல்"}, "explanation": "மருத நிலம் என்பது வயலும் வயல் சார்ந்த பகுதியாகும்; அங்கு வாழும் மக்களின் முதன்மைத் தொழில் வேளாண்மை மற்றும் உழவு."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the geographic landscape and primary occupation of Marutham Thinai?", "media_id": null}], "options": {"A": "Riverine agricultural plains (Vayal); Agrarian farming", "B": "Hilly mountains; Hunting", "C": "Pastoral forests; Cattle rearing", "D": "Maritime coast; Fishing"}, "explanation": "Marutham represents fertile riverine plains centered around agriculture and paddy farming."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "ed