{"id": "7th-t3-u4-q388", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-pyq-bridging", "lesson_id": "lesson-03-tkc", "chapter_id": null, "topic_id": "ta-t3-pyq-thirunelveli-poets-odd-one-out", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருநெல்வேலிச் சீமையோடு தொடர்புடைய கவிஞர்களுள் பொருந்தாத வேறுபட்ட ஒருவர் யார்?"}], "options": {"A": "பாரதியார் (எட்டயபுரம்)", "B": "அண்ணாமலையார் (சென்னிகுளம் காவடிச்சிந்து)", "C": "திரிகூடராசப்பக் கவிராயர் (மேலகரம்)", "D": "கண்ணதாசன் (சிறுகூடல்பட்டி)"}, "explanation": "பாரதியார், அண்ணாமலையார், திரிகூடராசப்பர், அழகிய சொக்கநாதர் ஆகியோர் நெல்லைச் சீமையோடு தொடர்புடையவர்கள். கண்ணதாசன் சிவகங்கை மாவட்டம் சிறுகூடல்பட்டியில் பிறந்தவர் ஆவார். எனவே கண்ணதாசன் பொருந்தாதவர்."}, "en": {"blocks": [{"type": "text", "content": "Who among the following literary figures is NOT historically associated with the Tirunelveli region?"}], "options": {"A": "Bharathiyar (Ettayapuram)", "B": "Annamalaiyar (Chennikulam)", "C": "Thirikoodarasappar (Melagaram)", "D": "Kannadasan (Sirukoodalpatti)"}, "explanation": "Bharathi, Annamalaiyar, and Thirikoodarasappar hail from the greater Tirunelveli seamai. Kannadasan was born in Sirukoodalpatti, Sivaganga district. Hence D is the odd one."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"t