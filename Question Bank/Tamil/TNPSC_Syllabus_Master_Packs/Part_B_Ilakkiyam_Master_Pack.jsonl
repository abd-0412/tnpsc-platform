{"id": "9th-u7-q105", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "purathirattu-significance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'புறத்திரட்டு' என்பது எவ்வகை நூல்?", "media_id": null}], "options": {"A": "பல்வேறு பண்டைய செய்யுள்களிலிருந்து புறப்பொருள் பாடல்களைத் தொகுத்த தொகை நூல்", "B": "மருத்துவ நூல்", "C": "சோதிட நூல்", "D": "கணித நூல்"}, "explanation": "பண்டைய தமிழ் இலக்கியங்களிலிருந்து சிறந்த புறப்பொருள் சார்ந்த வெண்பாக்களைத் தொகுத்து உருவாக்கப்பட்ட தொகை நூலே 'புறத்திரட்டு' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What type of classical literary work is 'Purathirattu'?", "media_id": null}], "options": {"A": "An anthology compiling heroic and moral verses from lost and ancient Tamil poems", "B": "A treatise on Siddha medicine", "C": "An astrological text", "D": "A mathematical manuscript"}, "explanation": "Purathirattu is an invaluable medieval thematic anthology that rescued numerous classical poems from extinction."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null,