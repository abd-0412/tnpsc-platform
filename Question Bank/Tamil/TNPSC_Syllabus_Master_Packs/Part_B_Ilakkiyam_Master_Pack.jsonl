{"id": "10th-u4-q081", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "perumal_thirumozhi", "chapter_id": null, "topic_id": "palakkad_temple", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வித்துவக்கோடு திருத்தலம் அமைந்த பாலக்காடு மாவட்டம் எந்த நதிக்கரையில் அமைந்துள்ளது?", "media_id": null}], "options": {"A": "பாரதப்புழா (பாரதப் புழை ஆறு)", "B": "காவிரி", "C": "வைகை", "D": "பொருநை"}, "explanation": "வித்துவக்கோடு (திருமிற்றக்கோடு) கேரளாவின் புகழ்பெற்ற பாரதப்புழா நதிக்கரையில் அமைந்துள்ள திவ்யதேசமாகும்."}, "en": {"blocks": [{"type": "text", "content": "On the banks of which iconic river is the sacred shrine of Vithuvakkodu located in Palakkad?", "media_id": null}], "options": {"A": "Bharathapuzha River", "B": "Kaveri", "C": "Vaigai", "D": "Thamirabarani"}, "explanation": "Vithuvakkodu sits on the banks of the Bharathapuzha river."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 78, "chapter": null, "section": null, "reference": "10th Tamil, Unit 4, Page 78", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null,