{"id": "12th_tamil_u5_q828", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thevaaram_mayilai", "chapter_id": null, "topic_id": "nambiyandar_nambi_compilation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இராஜராஜ சோழனின் வேண்டுகோளுக்கிணங்க சிதம்பரம் தில்லைக் கோயிலில் பூட்டப்பட்டிருந்த தேவாரப் பதிகங்களை மீட்டெடுத்துத் தொகுத்தவர் யார்?", "media_id": null}], "options": {"A": "சேக்கிழார்", "B": "கச்சியப்ப சிவாச்சாரியார்", "C": "உமாபதி சிவாச்சாரியார்", "D": "நம்பியாண்டார் நம்பி"}, "explanation": "திருநாரையூர் நம்பியாண்டார் நம்பி, முதலாம் இராஜராஜ சோழனின் உதவியுடன் தில்லைக் கோயிலில் கறையான்கள் அரித்த நிலையில் இருந்த தேவாரத் திருமுறைகளை மீட்டெடுத்து முறைப்படுத்தினார்."}, "en": {"blocks": [{"type": "text", "content": "Which scholar-saint retrieved and organized the palm-leaf manuscripts of Thevaram from Chidambaram with Rajaraja Chola I?", "media_id": null}], "options": {"A": "Sekkizhar", "B": "Kachiyappa Sivachariyar", "C": "Umapathi Sivachariyar", "D": "Nambiyandar Nambi"}, "explanation": "Nambiyandar Nambi retrieved and systematically organized the Saivite hymns at the behest of Emperor Rajaraja Chola I."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "c