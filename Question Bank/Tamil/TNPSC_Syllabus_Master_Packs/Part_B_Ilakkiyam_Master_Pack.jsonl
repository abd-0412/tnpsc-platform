{"id": "11th_tamil_u3_q078", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "meaning_ayarvilar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உண்டால் அம்ம இவ்வுலகம்...’ பாடலில் வரும் ‘அயர்விலர்’ என்னும் சொல்லின் பொருள் யாது?", "media_id": null}], "options": {"A": "அஞ்சாதவர்", "B": "சோம்பல் / சோர்வு இல்லாதவர்", "C": "பகைமை அற்றவர்", "D": "அறிவில்லாதவர்"}, "explanation": "அயர்வு என்றால் சோர்வு அல்லது சோம்பல். அயர்விலர் என்றால் சோம்பலின்றி சுறுசுறுப்புடன் நற்பணிகளை மேற்கொள்பவர் என்று பொருள்."}, "en": {"blocks": [{"type": "text", "content": "In the hymn 'Undaal amma ivvulagam', what is the exact meaning of the term 'Ayarvilar'?", "media_id": null}], "options": {"A": "Those without fear", "B": "Those devoid of sloth, lethargy, or despondency", "C": "Those without enmity", "D": "Ignorant persons"}, "explanation": "'Ayarvilar' signifies people free from sloth, laziness, or fatigue in virtuous action."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 51", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Vocabulary", "Sangam Tamil"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q079", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "purananooru_gu_pope_translation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புறநானூற்றின் தேர்ந்தெடுக்கப்பட்ட பாடல்களை ஆங்கிலத்தில் மொழிபெயர்த்து வெளியிட்ட மேலைநாட்டுத் தமிழறிஞர் யார்?", "media_id": null}], "options": {"A": "வீரமாமுனிவர்", "B": "கால்டுவெல்", "C": "ஜி. யு. போப் (G.U. Pope)", "D": "எல்லிஸ்"}, "explanation": "ஜி. யு. போப் அவர்கள் புறநானூறு மற்றும் புறப்பொருள் பாடல்களை ஆங்கிலத்தில் மொழிபெயர்த்து மேலைநாட்டவர்க்குத் தமிழரின் வீரத்தையும் அறத்தையும் அறிவித்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which Western scholar translated selected poems of Purananooru into English verse, highlighting Tamil ethical and heroic values to the world?", "media_id": null}], "options": {"A": "Constanzo Beschi (Veeramamunivar)", "B": "Robert Caldwell", "C": "Rev. G. U. Pope", "D": "Francis Whyte Ellis"}, "explanation": "Rev. G. U. Pope translated heroic and philosophical selections of Purananooru into English."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": 