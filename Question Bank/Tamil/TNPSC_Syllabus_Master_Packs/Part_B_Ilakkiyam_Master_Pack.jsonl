{"id": "10th-u5-q082", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "neethi_venba", "chapter_id": null, "topic_id": "paavalar_multitalented", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கா. ப. செய்குதம்பிப் பாவலர் ஓர் சிறந்த புலவர் மற்றும் உரையாசிரியர் மட்டுமன்றி, எத்தகைய களங்களிலும் தன் திறமையை வெளிப்படுத்தியவர்?", "media_id": null}], "options": {"A": "நாட்டிய நாடகம்", "B": "மேடைப் பேச்சாளர் மற்றும் விடுதலைப் போராட்ட ஆதரவாளர்", "C": "திரைப்படத் தயாரிப்பாளர்", "D": "கப்பல் வணிகர்"}, "explanation": "செய்குதம்பிப் பாவலர் சிறந்த பேச்சாளராகவும் திகழ்ந்து தேசிய இயக்கத்திற்கும் சமுதாய மறுமலர்ச்சிக்கும் உரையாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Besides being an erudite poet and commentator, in which domains did Ka. Pa. Seikuthambi Paavalar actively engage?", "media_id": null}], "options": {"A": "Dance drama choreography", "B": "Eloquent oratory and nationalistic patriotic advocacy", "C": "Film direction", "D": "Maritime trade"}, "explanation": "He was a fiery orator and supported national renaissance causes."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 104, 