{"id": "12th_tamil_u4_q772", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "u4_pyq_integration", "chapter_id": null, "topic_id": "purananooru_padai_kottil", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஔவையார் அதியமானின் படைக்கலன்களைப் பற்றிப் பாடும்போது, அவை எங்கு இருப்பதாகக் குறிப்பிடுகிறார்?", "media_id": null}], "options": {"A": "மன்னரின் மாளிகையில் அழகுற வைக்கப்பட்டுள்ளன", "B": "மன்னரின் படுக்கை அறையில் உள்ளன", "C": "ஆயுதக் கிடங்கில் நெய் பூசப்பட்டுப் பளபளக்கின்றன", "D": "போர்க்களத்தில் பகைவரைக் குத்தி முனை முறிந்து கொல்லன் உலைக்களத்தில் கிடக்கின்றன"}, "explanation": "அதியமானின் ஆயுதங்கள் போர்க்களத்தில் பகைவரைக் குத்திக் குத்தி முனை முறிந்ததால் கொல்லனின் உலைக்களத்தில் (பட்டறையில்) திருத்துவதற்காகக் கிடக்கின்றன என்று ஔவையார் பாடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "How does Avvaiyar depict the battered state and location of Athiyaman's combat weaponry?", "media_id": null}], "options": {"A": "Elegantly showcased within royal chambers", "B": "Stored safely in the bedchamber", "C": "Glistening with protective ghee in the state armory", "D": "Battered on battlefield frontlines with broken tips lying in the blacksmith's forge"}, "explanation": "Athiyaman's weapons are constantly shattered in valiant battle and lie repairing in the blacksmith's forge."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allo