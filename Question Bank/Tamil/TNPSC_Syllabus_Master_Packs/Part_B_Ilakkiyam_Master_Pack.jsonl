{"id": "12th_tamil_mp2_q1810", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "cs_chellappa_ezhuthu_journal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழில் புதுக்கவிதை இயக்கத்திற்குப் பெரும் களம் அமைத்துக் கொடுத்து வழிகாட்டிய 'எழுத்து' இதழைத் தொடங்கி நடத்தியவர் யார்?", "media_id": null}], "options": {"A": "க.நா. சுப்பிரமணியம்", "B": "சி.சு. செல்லப்பா", "C": "சுந்தர ராமசாமி", "D": "வல்லிக்கண்ணன்"}, "explanation": "சி.சு. செல்லப்பா 1959-இல் 'எழுத்து' என்ற இலக்கிய இதழைத் தொடங்கி நவீனத் தமிழ்ப் புதுக்கவிதையை வீரியமாக வளர்த்தெடுத்தார்."}, "en": {"blocks": [{"type": "text", "content": "Who launched and edited the influential literary periodical 'Ezhuthu' (1959) which catalyzed modern Tamil free verse?", "media_id": null}], "options": {"A": "Ka.Naa. Subramaniam", "B": "C.S. Chellappa", "C": "Sundara Ramaswamy", "D": "Vallikkannan"}, "explanation": "C.S. Chellappa founded 'Ezhuthu' in 1959, serving as a cradle for modernist Tamil poetry."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 148, "chapter": null, "section": null, "re