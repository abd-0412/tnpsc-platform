{"id": "12th_tamil_u4_q647", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "idaiyeedu_purananuru", "chapter_id": null, "topic_id": "ci_mani_ezhuthu_journal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சி. மணி எந்த இலக்கிய இதழின் மூலம் புதுக்கவிதை உலகில் பெரும் தாக்கத்தை ஏற்படுத்தினார்?", "media_id": null}], "options": {"A": "மணிக்கொடி", "B": "வானம்பாடி", "C": "சி.சு. செல்லப்பாவின் ‘எழுத்து’ இதழ்", "D": "கணையாழி"}, "explanation": "சி.சு. செல்லப்பா நடத்திய ‘எழுத்து’ இதழில் தொடர்ந்து கவிதைகள் எழுதிப் புதுக்கவிதை இயக்கத்தின் முதன்மைக் கவிஞராக உருவானவர் சி. மணி."}, "en": {"blocks": [{"type": "text", "content": "Through which landmark modern literary magazine edited by Ci. Su. Chellappa did Ci. Mani emerge as a pioneer?", "media_id": null}], "options": {"A": "Manikkodi", "B": "Vaanambadi", "C": "Ci. Su. Chellappa's 'Ezhuthu' magazine", "D": "Kanaiyazhi"}, "explanation": "Ci. Mani rose to prominence through Ci. Su. Chellappa's avant-garde magazine 'Ezhuthu'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 78, "chapter": null, "section": null, "reference": "12th Tamil, Unit 4, Page 78