{"id": "11th_tamil_u7_q125", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "supplementary_natakakkalai", "chapter_id": null, "topic_id": "kootharattruppadai_book", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூத்தர்களின் கலை வாழ்க்கையையும், பரிசில் பெற்றுத் திரும்பும் பாணர்களையும் நாடகக் கலைஞர்களையும் ஆற்றுப்படுத்தும் பத்துப்பாட்டு நூல் எது?", "media_id": null}], "options": {"A": "கூத்தராற்றுப்படை (மலைபடுகடாம்)", "B": "பொருநராற்றுப்படை", "C": "சிறுபாணாற்றுப்படை", "D": "பெரும்பாணாற்றுப்படை"}, "explanation": "இரணியமுட்டத்துப் பெருங்குன்றூர்ப் பெருங்கௌசிகனார் பாடிய 'மலைபடுகடாம்' கூத்தர்களின் வாழ்வியலைப் பேசுவதால் 'கூத்தராற்றுப்படை' என அழைக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which Pattuppattu anthology portraying the lives and art of dramatic bards is titled 'Kootharaattruppadai'?", "media_id": null}], "options": {"A": "Kootharaattruppadai (Malaipadukadaam)", "B": "Porunaraattruppadai", "C": "Sirupanaattruppadai", "D": "Perumpanaattruppadai"}, "explanation": "Malaipadukadaam is celebrated as Kootharaattruppadai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "p