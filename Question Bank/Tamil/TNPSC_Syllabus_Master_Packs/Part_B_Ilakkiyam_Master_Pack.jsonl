{"id": "11th_tamil_u8_q071", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "manonmaniyam_western_influence", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மனோன்மணீயம் நூலில் காணலாகும் மேலைநாட்டு நாடக மரபின் தாக்கம் யாது?", "media_id": null}], "options": {"A": "பாடல்களே இல்லாமல் உரைநடையாக்குதல்", "B": "அங்கங்கள் மற்றும் களங்களின்றித் தொடர் கதையாக எழுதுதல்", "C": "ஐந்து அங்க அமைப்பு, நாடக முரண், தனிமொழி (Soliloquy), பக்கமொழி (Aside) போன்ற உத்திகள் கையாளப்பட்டிருப்பது", "D": "கிரேக்கக் கடவுளர்களைப் பாடுவது"}, "explanation": "ஷேக்ஸ்பியரின் நாடக உத்திகளான Soliloquy (தனிமொழி), Aside (பக்கமொழி) மற்றும் 5 Acts கட்டமைப்பு ஆகியவை சுந்தரனாரால் மிக அழகாகத் தமிழ் மரபுக்கேற்பக் கையாளப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Which Western dramatic conventions were ingeniously synthesized into Tamil poetics by Sundaranar in Manonmaniyam?", "media_id": null}], "options": {"A": "Dispensing with poetry completely", "B": "Writing undivided prose chapters", "C": "Five-act architecture, dramatic irony, soliloquies, and asides adapted into indigenous idiom", "D": "Invoking Greek Olympian deities"}, "explanation": "Sundaranar incorporated Elizabethan structural conventions including soliloquies, asides, and five-act progressions."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_mark