{"id": "9th-u3-q022", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-01-eru-thazhuvuthal", "chapter_id": null, "topic_id": "topic-eru-thazhuvuthal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'சில நிலத்தை நொறுக்கின; சில தம்முள் முரண்பட்டு ஒன்றோடொன்று எதிர்த்துக் கொண்டன; சில மண்டியிட்டுப் பாய்ந்தன' - இவ்வடிகள் விவரிப்பது எதனை?", "media_id": null}], "options": {"A": "யானைகளின் மோதல்", "B": "களத்தில் திமில் பெருத்த காளைகளின் ஆக்ரோஷக் காட்சிகள்", "C": "குதிரைகளின் ஓட்டம்", "D": "ஆட்டுக் கடாக்களின் சண்டை"}, "explanation": "பாடநூல் பக்க எண் 50-ல் கலித்தொகை முல்லைக்கலிப் பாடல் காட்சியை உரைநடை விவரிக்கும் வரிகளாக இவை அமைந்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "What does the narrative passage 'Some crushed the earth, some clashed heads against each other, some lunged kneeling forward' describe?", "media_id": null}], "options": {"A": "A herd of fighting elephants", "B": "The aggressive postures and charges of mighty bulls in the arena", "C": "A stampede of galloping horses", "D": "A clash of horned rams"}, "explanation": "The prose depicts the tempestuous behavior of muscular zebu bulls inside the Sangam bull arena."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Text