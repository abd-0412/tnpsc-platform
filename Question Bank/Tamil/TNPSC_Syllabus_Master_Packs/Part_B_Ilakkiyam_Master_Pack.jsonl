{"id": "12th_tamil_mp2_q1799", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "nakulan_kavithaigal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'சுருங்கி விரிந்த கோட்டிற்குள் வாழ்க்கை அடங்கிவிட்டது' - என்ற நவீன கவிதை வரிகளை எழுதிய புதுக்கவிஞர் யார்?", "media_id": null}], "options": {"A": "விக்ரமாதித்யன்", "B": "பிரமிள்", "C": "நகுலன் (டி.கே. துரைசுவாமி)", "D": "கல்யாண்ஜி"}, "explanation": "புதுக்கவிதை இயக்கத்தில் அகமன உணர்வுகளையும் தத்துவார்த்தச் சிந்தனைகளையும் நகுலன் தம் கவிதைகளில் சுருக்கமான மொழியில் பதிவு செய்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which modernist modern Tamil poet composed minimalist existential verse exploring inner consciousness under the pen-name Nakulan?", "media_id": null}], "options": {"A": "Vikramadityan", "B": "Pramil", "C": "Nakulan (T.K. Doraiswamy)", "D": "Kalyanji"}, "explanation": "T.K. Doraiswamy, known as Nakulan, wrote pioneering experimental modern poetry reflecting existential concerns."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 149, "chapter": null, "section": nul