{"id": "9th-u9-q039", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "fifth-world-tamil-conference-madurai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஐந்தாவது உலகத் தமிழாராய்ச்சி மாநாடு 1981-ஆம் ஆண்டு எம். ஜி. இராமச்சந்திரன் தலைமையில் எங்கு நடைபெற்றது?", "media_id": null}], "options": {"A": "சென்னை", "B": "தஞ்சாவூர்", "C": "மதுரை", "D": "கோயம்புத்தூர்"}, "explanation": "ஐந்தாவது உலகத் தமிழாராய்ச்சி மாநாடு 1981-இல் தமிழக முதலமைச்சர் எம். ஜி. ஆர் தலைமையில் மதுரையில் வரலாற்றுச் சிறப்புடன் நடைபெற்றது."}, "en": {"blocks": [{"type": "text", "content": "Where was the Fifth World Tamil Conference hosted under the auspices of Chief Minister M. G. Ramachandran in 1981?", "media_id": null}], "options": {"A": "Chennai", "B": "Thanjavur", "C": "Madurai (மதுரை)", "D": "Coimbatore"}, "explanation": "The 5th World Tamil Conference took place in Madurai in 1981."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 176, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 176", "url": null, "source_notes": null}, "previous_year": {"