{"id": "11th_tamil_u5_q083", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poem_seerapuraanam", "chapter_id": null, "topic_id": "moral_message_medina", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மதீனம் புக்க படலத்தில் மதீனா நகரம் மக்களுக்கு எத்தகைய நற்பண்புகளைப் போதிக்கிறது?", "media_id": null}], "options": {"A": "சுயநலம்", "B": "போர்வெறி", "C": "அன்பு, ஈகை, இனிய சொல் பேசுதல், விருந்தோம்பல் மற்றும் ஏழைகளுக்கு உதவுதல்", "D": "பகை பாராட்டுதல்"}, "explanation": "அன்பு, விருந்தோம்பல், இன்சொல் பேசுதல், ஏழைகளுக்கு ஈந்து மகிழ்தல் போன்ற மனிதநேய விழுமியங்களை மதீனா மக்கள் கடைப்பிடித்தனர்."}, "en": {"blocks": [{"type": "text", "content": "What noble humanistic virtues are practiced and taught by the people of Medina in Seerapuraanam?", "media_id": null}], "options": {"A": "Avarice and selfishness", "B": "Warmongering", "C": "Love, generosity, sweet speech, hospitality, and caring for the destitute", "D": "Enmity"}, "explanation": "Medina embodies charity, hospitality, sweet speech, and selfless love."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 109, "chapter": null, "section": null, 