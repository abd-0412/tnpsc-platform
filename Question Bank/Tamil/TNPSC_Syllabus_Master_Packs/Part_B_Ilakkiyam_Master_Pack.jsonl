{"id": "12th_tamil_u8_q1450", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sirubanaatruppadai", "chapter_id": null, "topic_id": "pari_flower_quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சுரும்பு முரலும் சுடர்ப்பூங் கொடிக்குத் தன் பெருந்தேர் நல்கிய பாரி’ - இதில் ‘சுரும்பு’ என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "கிளி", "B": "வண்டு", "C": "மயில்", "D": "மான்"}, "explanation": "'சுரும்பு' என்பது மலர்களைச் சுற்றி ரீங்காரமிடும் வண்டைக் குறிக்கும் சொல்லாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the meaning of the Sangam word 'Surumbu' in the description of Pari's chariot gifted to the jasmine?", "media_id": null}], "options": {"A": "Parrot", "B": "Bee / Beetle (Vandu)", "C": "Peacock", "D": "Deer"}, "explanation": "'Surumbu' in Sangam Tamil refers to a buzzing bee or beetle hovering over fragrant flora."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 203, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 203", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam