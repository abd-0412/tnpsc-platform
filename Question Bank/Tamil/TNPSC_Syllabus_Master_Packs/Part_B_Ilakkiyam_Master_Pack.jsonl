{"id": "11th_tamil_u3_q064", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "why_world_exists", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தமக்கென முயலா நோன்தாள் / பிறர்க்கென முயலுநர் உண்மையானே...’ - இவ்வுலகம் யாரால் நிலைபெற்று இயங்குகிறது என்று பாடல் முடிக்கிறது?", "media_id": null}], "options": {"A": "செல்வத்தைச் சேர்ப்பவர்களால்", "B": "போர் வெறி கொண்டவர்களால்", "C": "தனியாக வாழ்வோரால்", "D": "தமக்கென வாழாமல், பிறர் நன்மைக்காகவே தம் வாழ்வை அர்ப்பணிக்கும் உன்னத மனிதர்களால்"}, "explanation": "தமக்கென வாழாமல் உலக நன்மைக்காகவே உழைக்கும் தன்னலமற்ற சான்றோர்கள் இருப்பதனால்தான் இவ்வுலகம் இன்றும் அழியாமல் நிலைபெற்றுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "According to the concluding lines 'Thamakkana muyalaa noanthaal pirarkkena muyalunar unmaiyaanae', why does the world endure?", "media_id": null}], "options": {"A": "Because of avaricious wealth hoarders", "B": "Because of warmongering conquerors", "C": "Because of reclusive hermits", "D": "Because of noble, altruistic souls who live not for selfish gain but entirely for the welfare of others"}, "explanation": "The world survives solely because of unselfish human beings living dedicated to others."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 51", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 3", "Poetry", "Core Philosophy"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u3_q065", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "purananooru_king_name_reason", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இளம்பெருவழுதி மன்னருக்கு ‘கடலுள் மாய்ந்த’ என்ற அடைமொழி வழங்கக் காரணம் என்ன?", "media_id": null}], "options": {"A": "கடற்பயணம் மேற்கொண்ட போது கடலில் மூழ்கி இயற்கை எய்தியதால்", "B": "கடலில் குளித்ததால்", "C": "கடல் போரில் வென்றதால்", "D": "கடற்கரையில் பிறந்ததால்"}, "explanation": "பாண்டிய மன்னனான இளம்பெருவழுதி கடற்பயணத்தின் போது நிகழ்ந்த விபத்தில் கடலிலேயே உயிர்நீத்த காரணத்தால் 'கடலுள் மாய்ந்த இளம்பெருவழுதி' என அழைக்கப்பட்டார்."}, "en": {"blocks": [{"type": "text", "content": "Why was the epithet 'Kadalul Maaintha' prefixed to the name of Pandyan king Ilamperuvaluthi?", "media_id": null}], "options": {"A": "Because he tragically perished at sea during a maritime voyage", "B": "Because he bathed in the ocean", "C": "Because he won a naval engagement", "D": "Because he was born on seashore"}, "explanation": "He earned the epithet because he drowned at sea during an oceanic expedition."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": 