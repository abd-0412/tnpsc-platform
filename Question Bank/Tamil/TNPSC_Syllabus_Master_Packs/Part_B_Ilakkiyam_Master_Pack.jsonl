{"id": "12th_tamil_mp1_q1582", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "nedunalvaadai_title_reason", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நெடுநல்வாடை என்ற பெயர் அமையக் காரணமான இலக்கிய நயம் யாது?", "media_id": null}], "options": {"A": "நீண்ட வாடைக்காற்று வீசுவதால் மட்டுமே", "B": "போர்க்களத்தில் உள்ள தலைவனுக்கு வெற்றி தரும் நல்வாடையாகவும், பிரிவில் வாடும் தலைவிக்குத் துன்பம் தரும் நெடுவாடையாகவும் அமைந்ததால்", "C": "வடக்குத் திசையிலிருந்து காற்று வீசுவதால்", "D": "மன்னன் நெடுந்தூரம் பயணித்ததால்"}, "explanation": "பிரிந்திருக்கும் தலைவிக்கு நெடுவாடை; போர்க்களத்தில் கடமை ஆற்றும் தலைவனுக்கு நல்வாடை என இருவருக்குமான முரண் உணர்வை 'நெடுநல்வாடை' என்ற பெயர் குறிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What poignant dual aesthetic justifies the title 'Nedunalvaadai' (Nedumai + Nanmai + Vaadai)?", "media_id": null}], "options": {"A": "Merely because a prolonged northerly wind blows", "B": "It acts as a cheering auspicious wind (Nalvaadai) to the warring king, but an agonizing, interminably long wind (Neduvaadai) to the pining queen", "C": "Because the gale blows from the north", "D": "Because the king marched a long distance"}, "explanation": "The title captures the contrasting subjective experiences: an agonizing long gale to the queen, and an auspicious breeze of victory to the king."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 32, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 32", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 1", "Literary Critique"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp1_q1586", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "antho_kavidhai_movement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நெடுநல்வாடையில் வேப்பம்பூ மாலையைச் சூடியவனாக நக்கீரரால் மறைமுகமாகச் சுட்டப்படும் மன்னன் யார்?", "media_id": null}], "options": {"A": "சேரன்", "B": "பாண்டியன் (வேப்பம்பூ மாலைக்குரியவன்)", "C": "சோழன்", "D": "பல்லவன்"}, "explanation": "பாண்டியரின் அடையாள மலர் வேப்பம்பூ ஆகும். 'வேப்பந்தாரோன்' எனக் குறிப்பாகச் சுட்டப்படுவதால் இது பாண்டிய மன்னனையே குறிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "Which monarch is indirectly identified in Nedunalvaadai by his signature neem flower garland (Veppampoo)?", "media_id": null}], "options": {"A": "Chera king", "B": "Pandya king (adorned with the neem blossom garland)", "C": "Chola king", "D": "Pallava king"}, "explanation": "The neem blossom garland is the hereditary floral insignia of the Pandya dynasty."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 33, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack