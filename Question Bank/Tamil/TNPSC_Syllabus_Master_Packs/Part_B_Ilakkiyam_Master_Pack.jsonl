{"id": "9th-u9-q073", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l3", "chapter_id": null, "topic_id": "kurunthogai-anthology-category", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறுந்தொகை என்பது பதினெண்மேற்கணக்கு நூல்களுள் எந்தப் பிரிவைச் சேர்ந்த அகப்பொருள் நூலாகும்?", "media_id": null}], "options": {"A": "எட்டுத்தொகை", "B": "பத்துப்பாட்டு", "C": "பதினெண்கீழ்க்கணக்கு", "D": "ஐஞ்சிறு காப்பியங்கள்"}, "explanation": "குறுந்தொகை என்பது பதினெண்மேற்கணக்கு எனப்படும் சங்க இலக்கியத் தொகுப்பில் உள்ள எட்டுத்தொகை நூல்களுள் ஒன்று ஆகும். இது தூய அகப்பொருள் நூல்."}, "en": {"blocks": [{"type": "text", "content": "To which canonical division of Sangam literature does Kurunthogai belong?", "media_id": null}], "options": {"A": "Ettuthogai (Eight Anthologies - எட்டுத்தொகை)", "B": "Pathuppattu", "C": "Pathinenkeezhkanakku", "D": "Ainchiru Kaapiyangal"}, "explanation": "Kurunthogai is one of the Eight Classical Anthologies (Ettuthogai)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 181, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 181", "url": null, "sou