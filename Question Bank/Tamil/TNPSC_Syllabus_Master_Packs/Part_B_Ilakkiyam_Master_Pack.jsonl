{"id": "11th_tamil_u6_q111", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "poetry_thiruchazhal", "chapter_id": null, "topic_id": "manikkavasagar_liberation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாணிக்கவாசகர் சிவபெருமானோடு இரண்டறக் கலந்து முக்தி அடைந்த தலம் எது?", "media_id": null}], "options": {"A": "மதுரை", "B": "திருப்பெருந்துறை", "C": "தில்லை சிதம்பரம்", "D": "திருவண்ணாமலை"}, "explanation": "மாணிக்கவாசகர் தில்லை சிதம்பரம் நடராஜர் சந்நிதியில் ஜோதியோடு இரண்டறக் கலந்து முக்தி அடைந்தார் என்று சைவ மரபு கூறுகிறது."}, "en": {"blocks": [{"type": "text", "content": "At which sacred shrine did saint Manikkavasagar attain final liberation (Mukti) merging into the divine effulgence?", "media_id": null}], "options": {"A": "Madurai", "B": "Thirupperunthurai", "C": "Thillai Chidambaram", "D": "Thiruvannamalai"}, "explanation": "According to Saivite tradition, Manikkavasagar merged into the divine light at Chidambaram."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 137", "url": null, "source_notes": null