{"id": "11th_tamil_u3_q066", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "ilamperuvaluthi_other_song", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கடலுள் மாய்ந்த இளம்பெருவழுதி புறநானூற்றில் இப்பாடலையும், பரிபாடலில் எந்தப் பாடலையும் பாடியுள்ளார்?", "media_id": null}], "options": {"A": "செவ்வவேள் பாடல்", "B": "திருமால் மீதான பாடல் (பரிபாடல் 15)", "C": "வைகைப் பாடல்", "D": "மதுரைப் பாடல்"}, "explanation": "இளம்பெருவழுதி புறநானூற்றில் ஒன்றும் (பாடல் 182), பரிபாடலில் திருமால் மீது ஒரு பாடலும் (பாடல் 15) பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Beyond Purananooru 182, which other poem was composed by Kadalul Maaintha Ilamperuvaluthi in Paripaadal?", "media_id": null}], "options": {"A": "Song on Lord Murugan", "B": "Hymn on Lord Thirumaal (Paripaadal 15)", "C": "Song on Vaigai", "D": "Ode to Madurai"}, "explanation": "He composed hymn 15 dedicated to Thirumaal in Paripaadal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page