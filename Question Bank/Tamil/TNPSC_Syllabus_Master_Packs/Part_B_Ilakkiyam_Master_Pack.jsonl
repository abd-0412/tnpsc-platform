{"id": "10th-u7-q093", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "silappathikaram", "chapter_id": null, "topic_id": "buyer_of_garland", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாதவியின் தோழி மாலையைக் கையில் ஏந்திப் புகார் நகர வீதியில் விற்றபோது, அதனைக் கொடுத்து மாதவியுடன் இணைந்த வணிகர் குல இளைஞன் யார்?", "media_id": null}], "options": {"A": "கோவலன்", "B": "மாசாத்துவான்", "C": "மாநாயக்கன்", "D": "சாதுவன்"}, "explanation": "கோவலன் ஆயிரத்தெட்டுக் கழஞ்சு பொன்னைக் கொடுத்து அம்மாலையை வாங்கி, மாதவியின் மாளிகைக்குச் சென்று அவளுடன் கூடி வாழ்ந்தான்."}, "en": {"blocks": [{"type": "text", "content": "Which affluent young merchant nobleman bought the garland and entered into companionate union with Madhavi?", "media_id": null}], "options": {"A": "Kovalan", "B": "Maasaatthuvaan", "C": "Maanaayakkaan", "D": "Saadhuvan"}, "explanation": "Kovalan purchased the 1,008-Kazhanju garland and partnered with Madhavi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 162, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 162", "url": null, "source_notes": null}, "previous_yea