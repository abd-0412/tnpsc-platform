{"id": "12th_tamil_u6_q1052", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "irattai_kaappiyangal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரமும் மணிமேகலையும் இணைந்து எவ்வாறு அழைக்கப்படுகின்றன?", "media_id": null}], "options": {"A": "ஐம்பெருங்காப்பியங்கள் மட்டும்", "B": "பக்தி நூல்கள்", "C": "சங்க இலக்கியங்கள்", "D": "இரட்டைக் காப்பியங்கள் (Twin Epics)"}, "explanation": "சிலப்பதிகாரத்தின் கதையின் தொடர்ச்சியாகவே மணிமேகலை அமைந்திருப்பதாலும், இரண்டும் ஒரே சமகாலப் பின்னணியைக் கொண்டிருப்பதாலும் அவை 'இரட்டைக் காப்பியங்கள்' எனப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "How are Silappathikaram and Manimekalai together classified in classical Tamil literature?", "media_id": null}], "options": {"A": "Five Greater Epics only", "B": "Devotional scriptures", "C": "Sangam anthologies", "D": "Twin Epics (Irattaik Kaappiyangal)"}, "explanation": "Silappathikaram and Manimekalai form the canonical 'Twin Epics' sharing sequential continuity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": nu