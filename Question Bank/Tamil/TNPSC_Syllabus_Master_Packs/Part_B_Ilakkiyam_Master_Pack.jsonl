{"id": "10th-u6-q047", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nigazhkalai", "chapter_id": null, "topic_id": "paavai_types_four", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழில் பாவைக் கூத்து மரபில் இடம்பெற்றுள்ள முக்கிய பாவை வகைகள் எவை?", "media_id": null}], "options": {"A": "மண்பாவை, கல் பாவை", "B": "காகிதப் பாவை, பஞ்சுப் பாவை", "C": "மரப்பாவை, தோல்பாவை, கையுறைப் பாவை, கயிறுப் பாவை (நூற்பாவை)", "D": "இரும்புப் பாவை, கண்ணாடிப் பாவை"}, "explanation": "தமிழில் மரத்தினால் செய்த மரப்பாவை, தோலினால் செய்த தோல்பாவை, விரல்களில் மாட்டி ஆட்டும் கையுறைப் பாவை மற்றும் நூல்களால் ஆட்டும் நூற்பாவை எனப் பல மரபுகள் உள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Which distinct categories comprise the rich historical puppetry traditions of Tamil culture?", "media_id": null}], "options": {"A": "Clay puppets, Stone idols", "B": "Paper puppets, Cotton dolls", "C": "Marappaavai (wooden), Tholpaavai (leather), Kaiyurai (glove), and Noolpaavai (string marionettes)", "D": "Iron puppets, Glass dolls"}, "explanation": "Wood, leather, glove, and string constitute the core puppetry traditions."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "1