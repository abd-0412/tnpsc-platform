{"id": "12th_tamil_u6_q1046", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "madhavi_garland_price", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாதவி மன்னனிடம் பெற்ற மாலையை அவளது தோழி கூனி (வசந்தமாலை) நகரத்துத் தெருவில் எவ்வளவு விலைக்கு விற்றாள்?", "media_id": null}], "options": {"A": "500 பொன்", "B": "ஆயிரத்தெட்டு (1008) கழஞ்சு பொன்", "C": "2000 பொன்", "D": "100 பொன்"}, "explanation": "‘இம்மாலை வாங்குவார் மாதவிக்குத் தலைவர் ஆவார்’ என்று கூறி 1008 கழஞ்சு பொன்னுக்கு மாலையை விலை கூறினார்."}, "en": {"blocks": [{"type": "text", "content": "At what price did Madhavi's maid Vasanthamaalai auction the royal garland in the broad avenue of Puhar?", "media_id": null}], "options": {"A": "500 gold coins", "B": "1,008 Kalanju of gold (Aayiraththettu Kalanju)", "C": "2,000 gold coins", "D": "100 gold coins"}, "explanation": "The royal garland was auctioned on the public avenue for 1,008 Kalanju of gold."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 138", "