{"id": "11th_tamil_rev1_q061", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "balakrishnan_books_journey", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆர். பாலகிருஷ்ணன் ஐ.ஏ.எஸ் அவர்களின் சிந்துவெளி மற்றும் திராவிடப் பண்பாட்டுத் தொடர்பை விளக்கும் பெருநூல் எது?", "media_id": null}], "options": {"A": "சிந்துவெளிப் பண்பாட்டின் திராவிட அடித்தளம் (Journey of a Civilization: Indus to Vaigai)", "B": "காவிரி முதல் வைகை வரை", "C": "பண்டைத் தமிழகம்", "D": "கீழடி அகழாய்வு"}, "explanation": "'Journey of a Civilization: Indus to Vaigai' என்னும் உலகத்தரம் வாய்ந்த வரலாற்று ஆய்வு நூலை எழுதி சிந்துவெளிக்கும் வைகைப் பண்பாட்டிற்கும் உள்ள தொடர்பை பாலகிருஷ்ணன் மெய்ப்பித்தார்."}, "en": {"blocks": [{"type": "text", "content": "What is the title of the masterwork authored by R. Balakrishnan IAS establishing the Dravidian foundation of the Indus Valley Civilization?", "media_id": null}], "options": {"A": "Journey of a Civilization: Indus to Vaigai", "B": "Kaveri Mudhal Vaigai Varai", "C": "Pandai Thamizhagam", "D": "Keeladi Excavations"}, "explanation": "R. Balakrishnan IAS authored the magnum opus 'Journey of a Civilization: Indus to Vaigai'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 56", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 1", "Prose", "IndusValley"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev1_q062", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "kurunthogai_poet_devakulathar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "11-ஆம் வகுப்புப் பாடப்பகுதியில் தேவகுலத்தார் இயற்றிய குறுந்தொகைப் பாடல் (பாடல் எண் 3) எத்திணைக்குரியது? அதன் பாடுபொருள் யாது?", "media_id": null}], "options": {"A": "முல்லை - காத்திருத்தல்", "B": "குறிஞ்சித் திணை - தலைவனும் தலைவியும் மலையும் மலை சார்ந்த இடத்தில் ஒன்றுபடுதல்", "C": "மருதம் - ஊடல்", "D": "நெய்தல் - இரங்கல்"}, "explanation": "\"நிலத்தினும் பெரிதே வானினும் உயர்ந்தன்று...\" என்று தொடங்கும் தேவகுலத்தாரின் பாடல் குறிஞ்சித் திணைக்குரிய தலைசிறந்த அகப்பாடலாகும்."}, "en": {"blocks": [{"type": "text", "content": "To which landscape (Tinai) does Devakulathaar's Kurunthogai verse (Song 3) belong?", "media_id": null}], "options": {"A": "Mullai tinai", "B": "Kurinchi tinai (Union of lovers in mountainous terrain)", "C": "Marutham tinai", "D": "Neithal tinai"}, "explanation": "Devakulathaar's hymn 'Nilathinum Peridhe' belongs to Kurinchi tinai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_yea