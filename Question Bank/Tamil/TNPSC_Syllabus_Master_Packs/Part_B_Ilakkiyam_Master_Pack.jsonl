{"id": "10th-u7-q011", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "amaravathi_prison_reading", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அமராவதி சிறையில் கடுமையான கொசுக்கடியிலும் கடும் குளிரிலும் ம. பொ. சிவஞானம் அவர்கள் மன அமைதியுடன் வாசித்த இலக்கிய நூல் எது?", "media_id": null}], "options": {"A": "இராமாயணம்", "B": "திருக்குறள்", "C": "சிலப்பதிகாரம் (சிலப்பதிகார நெஞ்சையள்ளும் வரிகள்)", "D": "மகாபாரதம்"}, "explanation": "அமராவதி சிறையின் கொடிய சூழலில் ம. பொ. சி அவர்களுக்கு மனத்துணையாகவும் ஆறுதலாகவும் விளங்கியது இளங்கோவடிகளின் சிலப்பதிகாரமே ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which classical epic comforted M. P. Sivagnanam through freezing cold and mosquito torment in Amaravathi prison?", "media_id": null}], "options": {"A": "The Ramayana", "B": "Thirukkural", "C": "Silappathikaram (Soul-enchanting epic verses)", "D": "The Mahabharata"}, "explanation": "Silappathikaram provided spiritual solace to him during his prison hardships."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 151, "chapter": null, "section":