{"id": "11th_tamil_rev1_q012", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "nammalvar_organization", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நம்மாழ்வார் இயற்கை வேளாண்மைப் பயிற்சிகளையும் விழிப்புணர்வையும் வழங்குவதற்காக நிறுவிய புகழ்பெற்ற சுற்றுச்சூழல் அமைப்பு எது?", "media_id": null}], "options": {"A": "பசுமை தாயகம்", "B": "நாகரிக விடியல்", "C": "இயற்கை அரண்", "D": "வானகம் (நம்மாழ்வார் உயிர்சூழல் நடுவம் - கரூர்)"}, "explanation": "கரூர் மாவட்டம் கடவூர் அருகே நம்மாழ்வார் அமைத்த 'வானகம்' (நம்மாழ்வார் சூழலியல் நடுவம்) இயற்கை வேளாண்மைக்கான முதன்மைப் பயிற்சி மையமாக இன்றும் விளங்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the name of the celebrated ecological training center founded in Karur by G. Nammalvar?", "media_id": null}], "options": {"A": "Pasumai Thaayagam", "B": "Naagariga Vidiyal", "C": "Iyarkai Aran", "D": "Vaanagam (Nammalvar Ecological Foundation, Karur)"}, "explanation": "Nammalvar established 'Vaanagam' in Karur district as an ecological sanctuary."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 29, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 29", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 1", "Prose", "Nammalvar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev1_q013", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "vilvarathinam_native_island", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் சு. வில்வரத்தினம் இலங்கை யாழ்ப்பாணத்தின் எந்தத் தீவில் பிறந்தார்?", "media_id": null}], "options": {"A": "புங்குடுதீவு", "B": "காரைநகர்", "C": "நெடுந்தீவு", "D": "மன்னார்"}, "explanation": "சு. வில்வரத்தினம் யாழ்ப்பாணத்தின் புங்குடுதீவில் பிறந்தவர்; இவரது கவிதைகள் ஈழ மண்ணின் விடுதலை வேட்கையையும் தாய்மொழியின் ஆழத்தையும் பறைசாற்றுபவை."}, "en": {"blocks": [{"type": "text", "content": "On which island off Jaffna Peninsula, Sri Lanka was poet Su. Vilvarathinam born?", "media_id": null}], "options": {"A": "Pungudutivu island", "B": "Karainagar island", "C": "Neduntivu island", "D": "Mannar island"}, "explanation": "Vilvarathinam was born on the island of Pungudutivu, Jaffna."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 3", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 1", "Poetry", "Vilvarathinam"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev1_q014", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "pallu_paddy_varieties", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'திருமலை முருகன் பள்ளு' நூலில் குறிப்பிடப்படும் பாரம்பரிய நெல் வகைகளுள் பொருந்தாத ஒன்றைத் தேர்ந்தெடுக்க:", "media_id": null}], "options": {"A": "சித்திரைக் கார், சீராகச் சம்பா", "B": "பொன்னி ஐ.ஆர். 20 (IR-20 நவீன நெல்)", "C": "செங்கல்பட்டுச் சம்பா, முத்துவெள்ளை", "D": "குண்டுமணி, காளான் சம்பா"}, "explanation": "'IR-20' என்பது பசுமைப்புரட்சிக்குப் பின் வந்த வீரிய ஒட்டு நெல்; மற்றவை அனைத்தும் பள்ளு இலக்கியத்தில் பெரியவன் கவிராயர் பட்டியலிடும் பலநூறு பாரம்பரியத் தமிழ் நெல் ரகங்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following is NOT an indigenous traditional paddy variety enumerated in Thirumalai Murugan Pallu?", "media_id": null}], "options": {"A": "Chithiraikkaar, Seeraga Samba", "B": "Ponni IR-20 (Modern hybrid green revolution grain)", "C": "Chengalpattu Samba, Muthuvellai", "D": "Gundumani, Kaalan Samba"}, "explanation": "IR-20 is a post-green-revolution semi-dwarf laboratory hybrid, unlike classical heritage grains."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publishe