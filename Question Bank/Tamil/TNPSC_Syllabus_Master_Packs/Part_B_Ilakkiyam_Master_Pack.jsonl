{"id": "9th-u7-q097", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l3", "chapter_id": null, "topic_id": "muthollayiram-elephant-imagery", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்தொள்ளாயிரப் பாடல்களில் மூவேந்தர்களின் எப்படைக் காட்சி மிகச் சிறப்பான உவமைகளுடன் வர்ணிக்கப்படுகிறது?", "media_id": null}], "options": {"A": "யானைப் படை (களிறு)", "B": "தேர்ப் படை மட்டுமே", "C": "குதிரைப் படை மட்டுமே", "D": "காலாட்படை மட்டுமே"}, "explanation": "முத்தொள்ளாயிரத்தில் சேர, சோழ, பாண்டிய மன்னர்களின் கம்பீரமான யானைப் படையும், யானைகளின் போர்க் காட்சிகளும் மிக எழிலாகப் பாடப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Which military wing of the Three Monarchs is portrayed with magnificent poetic grandeur throughout Muthollayiram?", "media_id": null}], "options": {"A": "The War Elephant Corps (யானைப் படை / களிறு)", "B": "Chariot regiments only", "C": "Cavalry only", "D": "Infantry only"}, "explanation": "The royal war elephants (Kaliru) of the three Tamil dynasties are colorfully depicted across multiple verses."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "p