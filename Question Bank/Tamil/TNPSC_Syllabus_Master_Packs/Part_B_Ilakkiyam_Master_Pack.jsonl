{"id": "12th_tamil_u5_q851", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "aganaanooru_ammuvanar", "chapter_id": null, "topic_id": "salt_paddy_barter", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க காலத்தில் உப்பு எதனைப் பண்டமாற்றாகப் பெற்று விற்கப்பட்டது?", "media_id": null}], "options": {"A": "பொற்காசுகள்", "B": "கோதுமை", "C": "நெல் (நெல்லும் உப்பும் நேரே ஊரிர்)", "D": "பருத்தி"}, "explanation": "சங்க காலத்தில் 'நெல்லும் உப்பும் ஒரே மதிப்புடையவை' என்னும் வகையில் ஒரு மரக்கால் உப்புக்கு ஒரு மரக்கால் நெல் என நேர் பண்டமாற்று செய்யப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Against which staple agricultural commodity was sea salt directly bartered at equal volume ratio in Sangam Tamilakam?", "media_id": null}], "options": {"A": "Gold bullion", "B": "Wheat grain", "C": "Paddy rice (Nell)", "D": "Raw cotton"}, "explanation": "Salt was bartered directly measure-for-measure against paddy grain ('Nellum Uppum Nerae')."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 113, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 113", "url": null, "sour