{"id": "11th_tamil_u8_q046", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "tamil_thai_omitted_lines", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுந்தரனாரின் மூலத் தமிழ்த்தாய் வாழ்த்துப் பாடலில் இடம்பெற்றுப் பின்னர் அரசுப் பாடலில் பிற மத/மொழி உணர்வுகளை முன்னிட்டு நீக்கப்பட்ட வரிகள் எவை?", "media_id": null}], "options": {"A": "தெக்கணமும் அதிற்சிறந்த திராவிடநல் திருநாடும்", "B": "பல்லுயிரும் பலவுலகும் படைத்தளித்துத் துடைக்கினுமோர்... கன்னடமும் களிதெலுங்கும் கவின்மலையாளமும் துளுவும் உன்னுதரத் துதித்தெழுந்தே...", "C": "நீராருங் கடலுடுத்த நிலமடந்தைக் கெழிலொழுகும்", "D": "உன் சீரிளமைத் திறம்வியந்து செயல்மறந்து வாழ்த்துதுமே"}, "explanation": "ஆரியம் போல உலக வழக்கு அழிந்து சிதையாமல் தமிழ் இளமையோடு திகழ்கிறது என்று ஆரிய மொழியோடு ஒப்பிட்ட வரிகளும், திராவிட மொழிகள் தமிழின் வயிற்றில் உதித்தவை என்ற வரிகளும் அரசுப் பாடலில் நீக்கப்பட்டுப் பொதுமைப்படுத்தப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "Which verses from Sundaranar's original invocation were omitted when officially adopted as the Tamil Nadu state anthem in 1970?", "media_id": null}], "options": {"A": "Thekkanamum athirsirandha dravidanall thirunaadum", "B": "Passages contrasting Tamil vitality with archaic tongues and tracing sister tongues to Tamil womb", "C": "Neeraarum kadaludutha nilamadandhaik kezhilozhugum", "D": "Un seerilamai thiramviyandhu seyalmarandhu vaazhthudhume"}, "explanation": "Verses comparing Tamil with Aryan tongues and enumerating offspring languages were omitted for inclusive state protocol."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 180, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 180", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 8", "Poetry", "Manonmaniyam"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
