{"id": "10th-u7-q098", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "silappathikaram", "chapter_id": null, "topic_id": "three_cardinal_truths", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரம் உணர்த்தும் முப்பெரும் உண்மைகளுள் பொருந்தாத ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "அரசியல் பிழைத்தோர்க்கு அறம் கூற்றாகும்", "B": "அரசன் எவ்வழியோ மக்கள் அவ்வழி மட்டுமே (பாடநூல் முப்பெரும் உண்மை அல்லாதது)", "C": "உரைசால் பத்தினியை உயர்ந்தோர் ஏத்துவர்", "D": "ஊழ்வினை உருத்து வந்து ஊட்டும்"}, "explanation": "சிலப்பதிகாரத்தின் மூன்று நீதிகள்: 1. அரசியல் பிழைத்தோர்க்கு அறம் கூற்றாகும், 2. உரைசால் பத்தினியை உயர்ந்தோர் ஏத்துவர், 3. ஊழ்வினை உருத்து வந்து ஊட்டும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the statement that is NOT one of the Three Cardinal Maxims declared by Silappathikaram:", "media_id": null}], "options": {"A": "Righteousness slays monarchs who swerve from justice", "B": "As is the king, so are the subjects (Non-Silappathikaram dictum)", "C": "The exalted venerate the virtuous chaste wife", "D": "Past destiny inexorably manifests to exact retribution"}, "explanation": "The epic declares justice slays unjust kings, the chaste are revered, and destiny rules."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "T