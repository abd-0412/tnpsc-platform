# ==============================================================================
{"id": "9th-u9-q011", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "thirukkural-universal-humanity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளில் மனித குலம் முழுவதற்கும் பொதுவான சமத்துவக் கொள்கையாக வள்ளுவர் பிரகடனம் செய்தது எது?", "media_id": null}], "options": {"A": "'செல்வத்துப் பயனே ஈதல்'", "B": "'தீதும் நன்றும் பிறர்தர வாரா'", "C": "'பிறப்பொக்கும் எல்லா உயிர்க்கும்' (குறள் 972)", "D": "'அன்பும் அறனும் உடைத்தாயின் இல்வாழ்க்கை'"}, "explanation": "பிறப்பினால் மனிதரிடையே எந்த உயர்வு தாழ்வும் இல்லை; பிறக்கும் எல்லா உயிர்களும் சமமே என்னும் மானுட சமத்துவத்தை 'பிறப்பொக்கும் எல்லா உயிர்க்கும்' என்ற குறள் அடி மூலம் திருவள்ளுவர் ஆணித்தரமாக நிலைநாட்டுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Which cardinal couplet line does Thiruvalluvar proclaim to establish the innate spiritual and social equality of all human beings?", "media_id": null}], "options": {"A": "'Selvathu payanae eethal'", "B": "'Theethum nandrum pirarthara vaaraa'", "C": "'Pirappokkum ella uyirkkum' (All beings are equal by birth - குறள் 972)", "D": "'Anbum aranum udaithayin'"}, "explanation": "'Pirappokkum ella uyirkkum' lays the egalitarian foundation of human dignity across all humanity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 173, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 173", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_9", "thirukkural", "equality"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u9-q023", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "thirukkural-nattodu-porunthum-thanmai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளை உலகப் பொதுமறை எனப் போற்றுவதற்குக் காரணமாகப் பாடப்பகுதியில் கூறப்படும் பண்பு யாது?", "media_id": null}], "options": {"A": "அது ஒரு குறிப்பிட்ட நிலப்பரப்பை மட்டுமே போற்றுவது", "B": "ஒரு குறிப்பிட்ட மதக் கோட்பாட்டை மட்டும் வலியுறுத்துவது", "C": "சாதி, சமயம், நாடு, இனம் ஆகியவற்றைக் கடந்து எக்காலத்திற்கும் அனைத்து மாந்தர்க்கும் பொருந்தும் வாழ்வியல் நெறிகளைக் கூறுவது", "D": "கடினமான இலக்கண விதிகளால் இயற்றப்பட்டது"}, "explanation": "திருக்குறளில் எந்த ஒரு குறிப்பிட்ட மதமோ, நாடோ, மன்னனோ குறிப்பிடப்படாமல் மானுட வாழ்விற்கான பொதுவான அறங்களும் வாழ்வியல் உண்மைகளும் கூறப்பட்டுள்ளதால் அது 'உலகப் பொதுமறை' எனப் போற்றப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Why is Thirukkural hailed universally as 'Ulaga Pothumarai' (Universal Scripture) in this lesson?", "media_id": null}], "options": {"A": "Because it celebrates a single geographic empire", "B": "Because it advocates a specific theological dogma", "C": "Because its timeless moral principles apply universally across all races, creeds, times, and nations", "D": "Because it employs intricate metrical rules"}, "explanation": "Thirukkural transcends all sectional affiliations, speaking universally to human ethics."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 173, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 173", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_9", "thirukkural", "universal_values"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

