{"id": "7th-t3-u1-q084", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-03-tirunelveli-seemaiyum-kavigalum", "chapter_id": null, "topic_id": "ta-t3-u1-direct-bookback-christian-kamban", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்க் கவிதை உலகில் 'கிறித்தவக் கம்பன்' என்று போற்றப்படும் பெருமகனார் யார்?"}], "options": {"A": "வீரமாமுனிவர்", "B": "ஜி.யு. போப்", "C": "கால்டுவெல்", "D": "எச்.ஏ. கிருஷ்ணப்பிள்ளை"}, "explanation": "பாடநூல் பக்கம் 11: 'இரட்சணிய யாத்திரிகம்' இயற்றிய எச்.ஏ. கிருஷ்ணப்பிள்ளை 'கிறித்தவக் கம்பன்' எனப் போற்றப்படுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Who is venerated in the Tamil poetic world as 'Christian Kamban'?"}], "options": {"A": "Veeramamunivar", "B": "G.U. Pope", "C": "Robert Caldwell", "D": "H.A. Krishna Pillai"}, "explanation": "Textbook page 11: H.A. Krishna Pillai is lauded as 'Christian Kamban'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 11, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_y