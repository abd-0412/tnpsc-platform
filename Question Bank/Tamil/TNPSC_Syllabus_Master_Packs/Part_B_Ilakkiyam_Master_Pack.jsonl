{"id": "8th-u5-q615", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u5-vanigam", "lesson_id": "8th-u5-l3", "chapter_id": null, "topic_id": "kongu-mandala-sathakam-author", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கொங்கு மண்டலத்தின் எல்லைகளை விரிவாக விவரிக்கும் 'கொங்கு மண்டல சதகம்' என்னும் நூலின் ஆசிரியர் யார்?"}], "options": {"A": "கபிலர்", "B": "வெங்கம்பூர் சாமிநாதன்", "C": "கார்மேகக் கவிஞர்", "D": "புலவர் செ. ராசு"}, "explanation": "பாடநூல் பக். 97: 'கார்மேகக் கவிஞர் இயற்றிய கொங்கு மண்டல சதகம் என்னும் நூல்... கொங்குமண்டலம் விளங்கியதாகக் கூறுகிறது'."}, "en": {"blocks": [{"type": "text", "content": "Who is the author of 'Kongu Mandala Sathakam', which elaborately delineates the boundaries of Kongu Mandalam?"}], "options": {"A": "Kapilar", "B": "Venkambur Swaminathan", "C": "Kaarmega Kavignar", "D": "Pulavar Se. Rasu"}, "explanation": "Textbook Page 97 explicitly credits Kaarmega Kavignar as the poet of 'Kongu Mandala Sathakam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 97, "chapter": null, "section": null, "reference": null, "