{"id": "11th_tamil_u5_q096", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poetry_agananuru", "chapter_id": null, "topic_id": "historical_references", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க இலக்கிய எட்டுத்தொகை நூல்களுள் அதிகமான வரலாற்றுச் செய்திகளையும், சோழ, பாண்டிய, மௌரிய, நந்த மன்னர்கள் மற்றும் யவனர்கள் பற்றிய குறிப்புகளையும் கொண்டுள்ள நூல் எது?", "media_id": null}], "options": {"A": "நற்றிணை", "B": "ஐங்குறுநூறு", "C": "கலித்தொகை", "D": "அகநானூறு"}, "explanation": "அகநானூறு அகப்பொருள் நூலாக இருப்பினும் வரலாற்றுச் செய்திகள், நந்தர், மௌரியர், யவனர் குறிப்புகள் இதில் மிகுதியாகக் காணப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Which Ettuthokai anthology contains abundant historical references to Maurya, Nanda, and Yavana rulers?", "media_id": null}], "options": {"A": "Narrinai", "B": "Ainkurunuru", "C": "Kalithokai", "D": "Agananuru"}, "explanation": "Agananuru is renowned for its wealth of historical allusions alongside love poetry."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": "11th Tamil, Unit 5, Pa