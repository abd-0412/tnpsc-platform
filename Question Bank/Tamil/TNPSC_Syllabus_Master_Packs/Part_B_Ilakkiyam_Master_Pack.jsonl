{"id": "8th-booster-q1174", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "8th-booster-thirukkural", "chapter_id": null, "topic_id": "kural-completion-therindhu-vinai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அடிக்கோடிட்ட தொடரை நிரப்புக:\n\"இதனை இதனால் இவன்முடிக்கும் என்றாய்ந்து அதனை ______ விடல்\""}], "options": {"A": "அவன்மேல்", "B": "அவன்கண்", "C": "அவனோடு", "D": "அவரிடம்"}, "explanation": "பாடநூல் பக். 136: 'இதனை இதனால் இவன்முடிக்கும் என்றாய்ந்து அதனை அவன்கண் விடல்' என்பது சரியான தொடராகும். விடுபட்ட சொல் 'அவன்கண்'."}, "en": {"blocks": [{"type": "text", "content": "Fill in the blank in the kural verse:\n\"Idhanai idhanaal ivan mudikkum endraayndhu adhanai ______ vidal\":"}], "options": {"A": "Avanmel", "B": "Avankan", "C": "Avanodu", "D": "Avaridam"}, "explanation": "Textbook Page 136: 'Idhanai idhanaal ivan mudikkum endraayndhu adhanai avankan vidal'. The missing word is 'Avankan'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 136, "chapter": null, "section": null, "reference": null, "url": nu