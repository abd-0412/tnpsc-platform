{"id": "11th_tamil_u2_q101", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aingurunooru", "chapter_id": null, "topic_id": "meaning_vaetkaippaththu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடப்பகுதி இடம்பெற்றுள்ள ‘வேட்கைப் பத்து’ என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "விருப்பம் / வேட்கையை வெளிப்படுத்தும் பத்து பாடல்களின் தொகுப்பு", "B": "வேட்டைக்குச் செல்லும் பத்து பாடல்கள்", "C": "கோபத்தை வெளிப்படுத்தும் பத்து பாடல்கள்", "D": "போர்க்களத்துப் பத்து பாடல்கள்"}, "explanation": "வேட்கை என்றால் விருப்பம் அல்லது அன்பு வேட்கை என்று பொருள்; காதலின் நல்விருப்பத்தை வெளிப்படுத்தும் 10 பாடல்களின் தொகுப்பே வேட்கைப் பத்து."}, "en": {"blocks": [{"type": "text", "content": "What does the decad title 'Vaetkaip Paththu' literally denote?", "media_id": null}], "options": {"A": "Decad of Ten Verses articulating heartfelt yearning / auspicious longing", "B": "Hunting expedition songs", "C": "Wrathful curse songs", "D": "Martial battlefield chants"}, "explanation": "'Vaetkaip Paththu' denotes a decad expressing deep mutual longing and conjugal devotion."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_yea