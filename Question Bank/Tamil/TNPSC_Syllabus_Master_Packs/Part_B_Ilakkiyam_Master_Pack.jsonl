{"id": "12th_tamil_u5_q864", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "aganaanooru_ammuvanar", "chapter_id": null, "topic_id": "kadavorul_ammuvanar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அகநானூற்றுக் கடவுள் வாழ்த்துப் பாடலைப் பாடியவர் யார்?", "media_id": null}], "options": {"A": "ஔவையார்", "B": "கபிலர்", "C": "மதுரை உப்பூரிகுடி கிழார்", "D": "பாரதம் பாடிய பெருந்தேவனார்"}, "explanation": "எட்டுத்தொகை நூல்களுள் பெரும்பாலான நூல்களுக்குக் கடவுள் வாழ்த்துப் பாடியவர் 'பாரதம் பாடிய பெருந்தேவனார்' ஆவார். அகநானூற்றுக்கும் இவரே கடவுள் வாழ்த்துப் பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who composed the invocatory dedicatory prologue (Kadavul Vaazhthu) of Agananooru?", "media_id": null}], "options": {"A": "Avvaiyar", "B": "Kapilar", "C": "Madurai Uppoorikudi Kizhaar", "D": "Bharatham Paadiya Perundhevanaar"}, "explanation": "Bharatham Paadiya Perundhevanaar composed the invocatory hymns for Agananooru."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 114", "url": null, "source_notes