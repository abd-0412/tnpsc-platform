{"id": "12th_tamil_u5_q850", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "aganaanooru_ammuvanar", "chapter_id": null, "topic_id": "umanar_trade", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைய தமிழகத்தில் மாட்டு வண்டிகளில் உப்பை ஏற்றிச் சென்று ஊர் ஊராக விற்ற வணிகர்கள் எவ்வாறு அழைக்கப்பட்டனர்?", "media_id": null}], "options": {"A": "கொல்லர்", "B": "உமணர்", "C": "தட்டார்", "D": "பரதவர்"}, "explanation": "கடற்கரையில் விளைந்த வெண்ணிற உப்பை வண்டிகளில் ஏற்றிச் சென்று பிற நிலப்பகுதிகளுக்கு விற்ற உப்பு வணிகர்களை 'உமணர்' என்பர்."}, "en": {"blocks": [{"type": "text", "content": "What were the traditional salt merchants who transported sea salt in bullock carts across ancient Tamilakam termed?", "media_id": null}], "options": {"A": "Kollar", "B": "Umanar (Salt traders)", "C": "Thattar", "D": "Parathavar"}, "explanation": "Salt merchants and itinerant traders were canonically designated 'Umanar' in Sangam Tamil society."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 113, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 113", "url": null, "source_notes": null}, "p