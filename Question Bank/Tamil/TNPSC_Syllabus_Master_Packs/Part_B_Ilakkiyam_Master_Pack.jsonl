{"id": "11th_tamil_u3_q067", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kurunthogai_purananooru", "chapter_id": null, "topic_id": "meaning_thamiyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தமியர்’ என்னும் சங்கத் தமிழ்ச் சொல்லின் பொருள் யாது?", "media_id": null}], "options": {"A": "செல்வந்தர்", "B": "பகைவர்", "C": "தனித்திருப்பவர் (தனித்தவர்)", "D": "முதியவர்"}, "explanation": "தமியர் என்றால் தனித்தவர் (தனியே இருப்பவர்) என்று பொருள் (தமியர் உண்டலும் இலரே = தனியே உண்ண மாட்டார்கள்)."}, "en": {"blocks": [{"type": "text", "content": "What is the literal meaning of the classical Sangam word 'Thamiyar'?", "media_id": null}], "options": {"A": "Wealthy plutocrats", "B": "Vindictive adversaries", "C": "Solitary individuals (Those dwelling in solitude / alone)", "D": "Aged elders"}, "explanation": "'Thamiyar' denotes solitary beings or persons eating all by themselves."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 51", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "