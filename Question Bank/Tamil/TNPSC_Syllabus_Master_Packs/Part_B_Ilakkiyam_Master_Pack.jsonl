{"id": "10th-u5-q112", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thiruviyaiyadal_puranam", "chapter_id": null, "topic_id": "overall_pedagogic_theme", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இடைக்காடன் பிணக்கு தீர்த்த படலம் தரும் வாழ்வியல் அறநெறி என்ன?", "media_id": null}], "options": {"A": "அரசனை எவரும் கேள்வி கேட்கக் கூடாது", "B": "கவிதையை விடப் பொருட்செல்வமே மேலானது", "C": "புலவர்கள் மன்னர்களிடம் செல்லக் கூடாது", "D": "கல்வி மற்றும் கற்றறிந்த சான்றோரை அவமதித்தல் கூடாது; அறிவையும் கலைஞர்களையும் போற்றுவதே ஓர் அரசுக்கும் மனிதனுக்கும் பெருமை தரும்"}, "explanation": "கற்றோரை அவமதித்தால் அரசும் நாடும் அழிவுறும்; சான்றோரைப் போற்றி வணங்குவதே அறம் சார்ந்த ஆட்சியின் மாண்பாகும்."}, "en": {"blocks": [{"type": "text", "content": "What timeless ethical message does \"Idaikkaadan Pinakku Theertha Padalam\" impart to human society?", "media_id": null}], "options": {"A": "Monarchs must never be questioned", "B": "Wealth outranks poetic wisdom", "C": "Scholars should boycott royal courts", "D": "Never disrespect scholars or genuine wisdom; honoring artists and intellects constitutes the true greatness of a nation"}, "explanation": "Honoring intellectual dignity and poets is paramount for righteous governance."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name