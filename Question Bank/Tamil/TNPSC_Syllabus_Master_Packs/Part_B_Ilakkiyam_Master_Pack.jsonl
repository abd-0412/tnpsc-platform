{"id": "11th_tamil_rev2_q072", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_leaders_epic", "chapter_id": null, "topic_id": "manonmaneeyam_sivagami_charitham", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மனோன்மணீயம் நாடகத்தில் இடம்பெறும் கிளைக்கதையின் (நாடகத்துள் நாடகம்) பெயர் என்ன?", "media_id": null}], "options": {"A": "சகுந்தலா கதை", "B": "நளவெண்பா கதை", "C": "சந்திரவதனா கதை", "D": "சிவகாமி சரிதம்"}, "explanation": "மனோன்மணீயத்தில் இரண்டாம் அங்கத்தில் நாடகத்துள் நாடகமாக ஆசிரியர் அமைத்த கிளைக்கதை 'சிவகாமி சரிதம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the title of the allegorical sub-play (play-within-a-play) embedded inside Manonmaneeyam?", "media_id": null}], "options": {"A": "Sakuntala story", "B": "Nalavenba story", "C": "Chandravadhana story", "D": "Sivagami Charitham"}, "explanation": "'Sivagami Charitham' is the famous interpolated romantic allegory woven within Act II of Manonmaneeyam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 201, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 201", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 2", "Manonmaneeyam", "Subplay"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev2_q073", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_leaders_epic", "chapter_id": null, "topic_id": "jeeva_speech_metaphor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தோழர் ஜீவாவின் மேடைப்பேச்சுக்கு உவமையாகச் சுந்தர ராமசாமி கூறுவது எது?", "media_id": null}], "options": {"A": "காற்றில் கலந்த பேரோசை மற்றும் பெருவெள்ளம்", "B": "தேன் துளிகள்", "C": "சிறு தென்றல்", "D": "மழைச்சாரல்"}, "explanation": "ஜீவாவின் பேச்சு வானொலி அலைகளைப் போலவும் காற்றுவெளியில் கலந்த மாபெரும் புயல் முழக்கம் போலவும் அமைந்ததால் 'காற்றில் கலந்த பேரோசை' என்று உவமித்தார்."}, "en": {"blocks": [{"type": "text", "content": "What metaphor did Sundara Ramaswamy employ to portray Comrade Jeeva's electrifying public oratory?", "media_id": null}], "options": {"A": "Mighty resonance mingled in the wind (storm surge)", "B": "Drops of honey", "C": "Gentle breeze", "D": "Light drizzle"}, "explanation": "Sundara Ramaswamy characterized Jeeva's captivating mass eloquence as an irresistible primordial roar carried on the wind."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 177, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 177", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 2", "Jeeva", "Oratory"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev2_q074", "schema_version": "1.0", "kind": "statement_analysis", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_leaders_epic", "chapter_id": null, "topic_id": "shantiniketan_facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாகூரின் ‘சாந்திநிகேதன்’ பற்றிய சரியான கூற்றுகளைத் தேர்க:\n(i) இது மேற்கு வங்காளத்தில் போல்பூர் அருகில் அமைந்துள்ளது.\n(ii) இதன் பொருள் ‘அமைதியின் இல்லம்’ என்பதாகும்.\n(iii) இது பின்னாளில் ‘விஸ்வபாரதி’ என்ற புகழ்பெற்ற மத்தியப் பல்கலைக்கழகமாக உயர்ந்தது.", "media_id": null}], "options": {"A": "(i) மற்றும் (ii) மட்டுமே சரி", "B": "(i), (ii), (iii) ஆகிய அனைத்தும் சரி", "C": "(ii) மற்றும் (iii) மட்டுமே சரி", "D": "(i) மட்டுமே சரி"}, "explanation": "சாந்திநிகேதன் மேற்கு வங்கத்தில் போல்பூரில் தேவேந்திரநாத் தாகூரால் ஆசிரமமாகத் தொடங்கப்பட்டு, ரவீந்திரநாத் தாகூரால் திறந்தவெளிப் பள்ளியாகவும் பின்னர் விஸ்வபாரதி பல்கலைக்கழகமாகவும் மலர்ந்தது."}, "en": {"blocks": [{"type": "text", "content": "Select the correct statements regarding Tagore's Shantiniketan:\n(i) Located near Bolpur in West Bengal.\n(ii) Its name signifies 'Abode of Peace'.\n(iii) It subsequently evolved into the acclaimed Central University named Visva-Bharati.", "media_id": null}], "options": {"A": "Only (i) and (ii) are correct", "B": "All (i), (ii), and (iii) are correct", "C": "Only (ii) and (iii) are correct", "D": "Only (i) is correct"}, "explanation": "All statements regarding the geography, nomenclature, and institutional legacy of Shantiniketan are accurate."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 195, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 195", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 2", "Tagore", "Shantiniketan"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev2_q075", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_leaders_epic", "chapter_id": null, "topic_id": "bharathidasan_kolai_vaalinai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கொலை வாளினை எடடா, மிகு கொடியோர் செயல் அறவே!’ - என்று வீர முழக்கமிட்ட புரட்சிக் கவிஞர் யார்?", "media_id": null}], "options": {"A": "பாரதியார்", "B": "கவிமணி", "C": "பாரதிதாசன்", "D": "முடியரசன்"}, "explanation": "கொடுங்கோன்மைக்கும் அநீதிக்கும் எதிராகப் புரட்சிப் போர்க்குரல் எழுப்பும் இப்பாடலை பாரதிதாசன் இயற்றியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which poet roared 'Kolai vaalinai edada, migu kodiyor seyal arave!' calling for resistance against tyrants?", "media_id": null}], "options": {"A": "Bharathiyar", "B": "Kavimani", "C": "Bharathidasan", "D": "Mudiyarasan"}, "explanation": "This fiery revolutionary verse urging battle against oppression was composed by Puratchikavingar Bharathidasan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 182, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 182"