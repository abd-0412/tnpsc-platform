{"id": "11th_tamil_rev1_q065", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "dravidian_place_names_pakistan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாகிஸ்தானிலும் ஆப்கானிஸ்தானிலும் இன்றும் பாயும் சிந்துவெளித் தொடர்புடைய ஆறுகளின் தமிழ் வடிவப் பெயர்கள் எவை?", "media_id": null}], "options": {"A": "காவிரி (Kavari) மற்றும் பொருநை (Porunai)", "B": "கங்கை மற்றும் யமுனை", "C": "நர்மதை மற்றும் தபதி", "D": "வைகை மற்றும் பாலாறு"}, "explanation": "ஆப்கானிஸ்தானில் பாயும் காவிரியும் (Kavari), பாகிஸ்தானில் உள்ள பொருநையும் (Porunai) தமிழர்களின் இடப்பெயர்கள் வடமேற்கில் பரவியிருந்ததற்கு அசைக்க முடியாத சான்றுகளாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which ancient Tamil hydronyms survive as rivers in Afghanistan and Pakistan reflecting Indus-Dravidian legacy?", "media_id": null}], "options": {"A": "Kavari and Porunai rivers", "B": "Ganges and Yamuna", "C": "Narmada and Tapti", "D": "Vaigai and Palar"}, "explanation": "Hydronyms matching Kavari and Porunai persist in the geography of Afghanistan and Pakistan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", 