{"id": "11th_tamil_rev2_q059", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_leaders_epic", "chapter_id": null, "topic_id": "puratchikkavi_source", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘புரட்சிக்கவி’ என்னும் காப்பிய நாடகத்தை பாரதிதாசன் எந்த வடமொழி நூலின் கதையைத் தழுவி இயற்றினார்?", "media_id": null}], "options": {"A": "காளிதாசனின் சாகுந்தலம்", "B": "பாஸனின் ஸ்வப்னவாசவதத்தம்", "C": "பில்கணனின் ‘பில்கணீயம்’ (சௌரசுரத பஞ்சாசிகா)", "D": "ஹர்ஷரின் நாகானந்தம்"}, "explanation": "பில்கணனின் காவியக் கதையைத் தழுவி, அரசன்-புலவன்-இளவரசி காதலை ஜனநாயகப் புரட்சியாகவும் சமூக விடுதலையாகவும் மாற்றி பாரதிதாசன் 'புரட்சிக்கவி'யைப் படைத்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which Sanskrit work was adapted by Bharathidasan to compose the revolutionary poem 'Puratchikkavi'?", "media_id": null}], "options": {"A": "Kalidasa's Shakuntala", "B": "Bhasa's Swapnavasavadatta", "C": "Bilhana's 'Bilhaneeyam' (Chaurapanchasika)", "D": "Harsha's Nagananda"}, "explanation": "Bharathidasan adapted the story of Bilhana into a revolutionary anti-feudal narrative of democratic empowerment."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation",