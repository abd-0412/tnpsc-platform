{"id": "10th-u6-q052", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nigazhkalai", "chapter_id": null, "topic_id": "folk_art_aesthetic_value", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாட்டுப்புறக் கலைகள் சமூகத்திற்கு வழங்கும் மிகப்பெரிய உளவியல் மற்றும் மனிதநேயப் பயன் யாது?", "media_id": null}], "options": {"A": "மக்களைச் சோம்பேறியாக்குவது", "B": "பணக்காரர்களுக்கு மட்டுமே கேளிக்கை தருவது", "C": "சாதி வேறுபாடுகளை வளர்ப்பது", "D": "கடின உழைப்பினால் ஏற்படும் உடல் சோர்வை நீக்கி, மனமகிழ்ச்சியையும் ஒற்றுமையையும் சகோதரத்துவத்தையும் வளர்ப்பது"}, "explanation": "பகல் முழுவதும் வயல்களிலும் தொழில்களிலும் உழைத்த எளிய மக்களுக்கு இரவில் நிகழ்த்தப்படும் நிகழ்கலைகள் புதிய புத்துணர்ச்சியையும் கூட்டு மகிழ்ச்சியையும் தருகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What paramount humanistic and psychological benefit is bestowed by folk performing arts upon rural society?", "media_id": null}], "options": {"A": "Inducing chronic indolence", "B": "Entertaining oligarchs solely", "C": "Fostering sectarian divides", "D": "Relieving the physical exhaustion of labor, replenishing vitality, and strengthening solidarity"}, "explanation": "Folk arts rejuvenate labor-weary communities with cathartic collective joy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_nam