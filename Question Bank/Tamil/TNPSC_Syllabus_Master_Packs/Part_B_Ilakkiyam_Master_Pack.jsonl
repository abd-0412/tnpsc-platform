{"id": "7th-t3-u3-q332", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u3-maanudam", "lesson_id": "lesson-14-vina-vidai", "chapter_id": null, "topic_id": "ta-t3-u3-velippadai-odd-one-out", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெளிப்படை விடைகளுள் பொருந்தாத வேறுபட்ட ஒன்றைக் கண்டறிக:"}], "options": {"A": "சுட்டு விடை", "B": "மறை விடை", "C": "நேர் விடை", "D": "ஏவல் விடை"}, "explanation": "பாடநூல் பக்கம் 60: 'சுட்டு, மறை, நேர்' ஆகிய மூன்றும் வெளிப்படை விடைகள் ஆகும். 'ஏவல் விடை' என்பது குறிப்பாகப் பொருள் தரும் குறிப்பு விடைகளுள் ஒன்றாகும். எனவே ஏவல் விடை பொருந்தாதது."}, "en": {"blocks": [{"type": "text", "content": "Identify the odd one that does NOT belong to the explicit answers (Velippadai Vidai):"}], "options": {"A": "Suttu Vidai", "B": "Marai Vidai", "C": "Naer Vidai", "D": "Eeval Vidai"}, "explanation": "Page 60: Suttu, Marai, and Naer are explicit (Velippadai) answers. Eeval Vidai is an implied (Kurippu) answer. Thus Eeval Vidai is the odd one."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 60, "chapter": null, "section": null, "reference