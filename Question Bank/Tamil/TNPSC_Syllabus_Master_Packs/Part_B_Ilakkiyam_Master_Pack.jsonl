{"id": "10th-u6-q044", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nigazhkalai", "chapter_id": null, "topic_id": "na_muthusamy_padmasri", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நவீன நாடகத்திற்கு ஆற்றிய சீரிய பணிக்காகக் கூத்துப்பட்டறை ந. முத்துசாமி அவர்களுக்கு இந்திய அரசால் வழங்கப்பட்ட உயரிய விருது எது?", "media_id": null}], "options": {"A": "பாரத ரத்னா", "B": "பத்ம விபூஷண்", "C": "ஞானபீட விருது", "D": "பத்மஸ்ரீ விருது மற்றும் சங்கீத நாடக அகாதெமி விருது"}, "explanation": "பாடநூல் குறிப்பு: ந. முத்துசாமி அவர்களுக்கு இந்திய அரசு தாமரைத்திரு (பத்மஸ்ரீ) விருதையும் சங்கீத நாடக அகாதெமி விருதையும் வழங்கிச் சிறப்பித்தது."}, "en": {"blocks": [{"type": "text", "content": "Which high national civilian honor was conferred upon Koothu-p-pattarai Na. Muthusamy by the Government of India for theater innovation?", "media_id": null}], "options": {"A": "Bharat Ratna", "B": "Padma Vibhushan", "C": "Jnanpith Award", "D": "Padma Shri and Sangeet Natak Akademi Award"}, "explanation": "He was honored with the prestigious Padma Shri for theatrical excellence."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025