{"id": "11th_tamil_u8_q051", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "kudilan_treason_plan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அமைச்சர் குடிலன் பாண்டிய மன்னன் ஜீவகனின் மகள் மனோன்மனியை யாருக்குத் திருமணம் செய்துவைத்து நாட்டைக் கைப்பற்றத் திட்டமிடுகிறான்?", "media_id": null}], "options": {"A": "சேர மன்னனுக்கு", "B": "சுந்தர முனிவருக்கு", "C": "தன் மகன் பலதேவனுக்கு", "D": "சோழ இளவரசனுக்கு"}, "explanation": "குடிலன் தன் மகன் பலதேவனுக்கு மனோன்மனியை மணம் முடித்துவைத்து, பாண்டியப் பேரரசைத் தன் குடும்பத்தின் வசம் ஆக்கக் கொடிய சதி செய்கிறான்."}, "en": {"blocks": [{"type": "text", "content": "To whom does treacherous minister Kudilan scheme to marry Princess Manonmani to capture the kingdom?", "media_id": null}], "options": {"A": "To Chera King Purudothaman", "B": "To Sundara Munivar", "C": "To his own deceitful son Baladevan", "D": "To a Chola prince"}, "explanation": "Kudilan plots to force Manonmani into marriage with his ambitious son Baladevan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 181, "chapter": null,