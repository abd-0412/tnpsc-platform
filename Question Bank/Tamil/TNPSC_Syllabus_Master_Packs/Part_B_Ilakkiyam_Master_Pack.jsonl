{"id": "9th-u7-q061", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l2", "chapter_id": null, "topic_id": "sivaka-chinthamani-lesson-ilambagam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒன்பதாம் வகுப்புப் பாடநூலில் இடம்பெற்றுள்ள நாட்டுவளம் பற்றிய பாடல்கள் சீவக சிந்தாமணியின் எவ்விலம்பகத்தில் இடம்பெற்றுள்ளன?", "media_id": null}], "options": {"A": "நாமகள் இலம்பகம்", "B": "கோவிந்தையார் இலம்பகம்", "C": "காந்தருவதத்தையார் இலம்பகம்", "D": "முத்தி இலம்பகம்"}, "explanation": "சீவக சிந்தாமணியின் முதல் இலம்பகமான 'நாமகள் இலம்பகத்தில்' இடம்பெற்றுள்ள 'ஏமாங்கத நாட்டு வளம்' பாடப்பகுதியாக அமைந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "From which initial Ilambagam of Sivaka Chinthamani are the textbook verses depicting country wealth excerpted?", "media_id": null}], "options": {"A": "Namagal Ilambagam (நாமகள் இலம்பகம்)", "B": "Govindhaiyar Ilambagam", "C": "Kandharvadathaiyar Ilambagam", "D": "Mukthi Ilambagam"}, "explanation": "The verses describing the agricultural and natural abundance of Emangadha country are taken from Namagal Ilambagam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "