{"id": "12th_tamil_u3_q535", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_u3", "chapter_id": null, "topic_id": "kaalathinaal_seidha_nandri", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘காலத்தினாற் செய்த நன்றி சிறிதெனினும்\n_________ மாணப் பெரிது’ - கோடிட்ட இடத்தை நிரப்புக:", "media_id": null}], "options": {"A": "வானகத்தின்", "B": "கடலின்", "C": "ஞாலத்தின்", "D": "மலையின்"}, "explanation": "‘காலத்தினாற் செய்த நன்றி சிறிதெனினும் ஞாலத்தின் மாணப் பெரிது’ (குறள் 102). தக்க காலத்தில் செய்த உதவி சிறிதாயினும் உலகத்தை விடப் பெரியதாகும்."}, "en": {"blocks": [{"type": "text", "content": "Fill in the blank: 'Kaalathinaat cheidha nandri siridheninum _________ maanap peridhu':", "media_id": null}], "options": {"A": "Vaanagathin", "B": "Kadalin", "C": "Gnaalathin (the whole wide Earth)", "D": "Malaiyin"}, "explanation": "Timely assistance, however modest in scale, is vastly greater than the expanse of the entire Earth (Gnaalam)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 64, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 64", "url": null, "source_