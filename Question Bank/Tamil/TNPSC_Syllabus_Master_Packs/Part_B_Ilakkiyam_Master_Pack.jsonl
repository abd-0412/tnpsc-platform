{"id": "12th_tamil_u7_q1236", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "purananooru_pisiranthaiyar", "chapter_id": null, "topic_id": "vada_iruthal_ritual", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கோப்பெருஞ்சோழன் தன் மகன்களின் பிணக்கால் மனம் நொந்து உண்ணாநோன்பிருந்து உயிர்துறக்க மேற்கொண்ட சங்க கால மரபு எது?", "media_id": null}], "options": {"A": "தீப்பாய்தல்", "B": "போர்க்களத்தில் மடிதல்", "C": "துறவறம் பூணுதல்", "D": "வடக்கிருத்தல் (வடக்கு நோக்கி அமர்ந்து உண்ணாநோன்பிருந்து உயிர்நீத்தல்)"}, "explanation": "தன் பிள்ளைகள் அரசுரிமைக்குப் போரிட்டதால் வேதனையடைந்த கோப்பெருஞ்சோழன், வடக்கு நோக்கி அமர்ந்து உண்ணாநோன்பிருந்து உயிர்நீக்கும் 'வடக்கிருத்தல்' நோன்பினை மேற்கொண்டான்."}, "en": {"blocks": [{"type": "text", "content": "Which classical Sangam ritual practice of fasting to death facing north did King Kopperunchozhan undertake?", "media_id": null}], "options": {"A": "Self-immolation", "B": "Dying in battle", "C": "Renouncing world", "D": "Vada-iruthal (Facing north and fasting to death)"}, "explanation": "Kopperunchozhan undertook the vow of 'Vada-iruthal' (ritual fasting unto death facing north)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "c