{"id": "9th-u9-q077", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l3", "chapter_id": null, "topic_id": "kurunthogai-invocatory-deity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறுந்தொகையின் கடவுள் வாழ்த்துப் பாடலைப் பாடியவர் யார்? அது எந்தக் கடவுளைப் பற்றியது?", "media_id": null}], "options": {"A": "பாரதம் பாடிய பெருந்தேவனார்; முருகக் கடவுள்", "B": "கபிலர்; சிவபெருமான்", "C": "பெருங்கடுங்கோ; திருமால்", "D": "நக்கீரர்; விநாயகர்"}, "explanation": "குறுந்தொகையின் கடவுள் வாழ்த்துப் பாடலைப் பாடியவர் 'பாரதம் பாடிய பெருந்தேவனார்' ஆவார். இப்பாடல் 'முருகக் கடவுள்' குறித்துப் பாடப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Who composed the invocatory poem of Kurunthogai, and which deity is praised?", "media_id": null}], "options": {"A": "Bharatham Paadiya Perundhevanar; Lord Murugan", "B": "Kapilar; Lord Shiva", "C": "Perungadungko; Lord Vishnu", "D": "Nakkeerar; Lord Ganesha"}, "explanation": "Bharatham Paadiya Perundhevanar sang the invocation praising Lord Murugan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 181, "chapter": null, "section": nu