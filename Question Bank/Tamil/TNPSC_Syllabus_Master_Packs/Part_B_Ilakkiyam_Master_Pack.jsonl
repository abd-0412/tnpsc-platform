{"id": "8th-booster-q1173", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-booster-thirukkural", "chapter_id": null, "topic_id": "kural-completion-kadaloda", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அடிக்கோடிட்ட தொடரை நிரப்புக:\n\"கடலோடா கால்வல் நெடுந்தேர் கடலோடும் ______ ஓடா நிலத்து\""}], "options": {"A": "நாவாயும்", "B": "தோணியும்", "C": "கப்பலும்", "D": "படstarts"}, "explanation": "பாடநூல் பக். 65: 'கடலோடா கால்வல் நெடுந்தேர் கடலோடும் நாவாயும் ஓடா நிலத்து' என்பது முழுமையான குறள் தொடராகும். விடுபட்ட சொல் 'நாவாயும்'."}, "en": {"blocks": [{"type": "text", "content": "Fill in the blank in the kural verse:\n\"Kadalodaa kaalval nedundher kadalodum ______ odaa nilatthu\":"}], "options": {"A": "Naavaayum", "B": "Thoniyum", "C": "Kappalum", "D": "Padagum"}, "explanation": "Textbook Page 65: 'Kadalodaa kaalval nedundher kadalodum naavaayum odaa nilatthu'. The missing word is 'Naavaayum'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 65, "chapter": null, "section": null, "reference": null, "url": null, "s