{"id": "12th_tamil_u3_q541", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thirukkural_u3", "chapter_id": null, "topic_id": "serndharai_kolli_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சேர்ந்தாரைக் கொல்லி’ என்று வள்ளுவரால் உருவகப்படுத்தப்படுவது எது?", "media_id": null}], "options": {"A": "சினம் (நெருப்பு)", "B": "பொறாமை", "C": "காமம்", "D": "வறுமை"}, "explanation": "நெருப்பு தன்னைத் தொட்ட அனைத்தையும் அழிப்பது போல, சினம் தன்னை அடைக்கலம் கொண்ட மனிதனையும் அவனது சுற்றத்தாரையும் அழித்துவிடும்."}, "en": {"blocks": [{"type": "text", "content": "What human vice is personified by Valluvar as 'Serndhaaraik Kolli' (The Fire that Destroys What It Touches)?", "media_id": null}], "options": {"A": "Wrath / Anger (Sinam - like consuming fire)", "B": "Envy", "C": "Lust", "D": "Poverty"}, "explanation": "'Serndhaaraik kolli' metaphorizes anger as wildfire annihilating the vessel holding it."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 65, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 65", "url": null, "source_notes": null}, "previous_year": {"is_previou