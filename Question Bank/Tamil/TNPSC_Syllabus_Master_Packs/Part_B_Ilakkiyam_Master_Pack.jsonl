{"id": "10th-u5-q102", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thiruviyaiyadal_puranam", "chapter_id": null, "topic_id": "kandams_padalam_count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருவிளையாடற் புராணத்தின் மூன்று காண்டங்களின் படல எண்ணிக்கை முறையே எது?", "media_id": null}], "options": {"A": "மதுரை-20, கூடல்-25, திருவாலவாய்-19", "B": "மதுரைக் காண்டம் (18 படலங்கள்), கூடற் காண்டம் (30 படலங்கள்), திருவாலவாய்க் காண்டம் (16 படலங்கள்)", "C": "மதுரை-16, கூடல்-30, திருவாலவாய்-18", "D": "மதுரை-30, கூடல்-18, திருவாலவாய்-16"}, "explanation": "காண்ட வாரியாகப் படலங்கள்: மதுரைக் காண்டம் = 18 படலங்கள்; கூடற் காண்டம் = 30 படலங்கள்; திருவாலவாய்க் காண்டம் = 16 படலங்கள். மொத்தம் = 18 + 30 + 16 = 64 படலங்கள்."}, "en": {"blocks": [{"type": "text", "content": "What is the precise breakdown of chapter counts (Padalams) across the 3 Kandams of Thiruvalaiyadal Puranam?", "media_id": null}], "options": {"A": "Madurai-20, Koodal-25, Aalavai-19", "B": "Madurai (18), Koodal (30), Thiruvalavai (16)", "C": "Madurai (16), Koodal (30), Thiruvalavai (18)", "D": "Madurai (30), Koodal (18), Thiruvalavai (16)"}, "explanation": "The distribution is 18 (Madurai) + 30 (Koodal) + 16 (Thiruvalavai) = 64."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer 