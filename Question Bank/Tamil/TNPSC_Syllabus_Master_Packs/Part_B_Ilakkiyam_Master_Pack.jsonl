{"id": "8th-u7-q867", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l1", "chapter_id": null, "topic_id": "tamil-moovaayiram-author-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தமிழ் மூவாயிரம்' என்று போற்றப்படும் திருமந்திரம் என்னும் ஒப்பற்ற சைவப் பனுவலை இயற்றிய சித்தர் யார்?"}], "options": {"A": "பட்டினத்தார்", "B": "பாம்பாட்டிச் சித்தர்", "C": "திருமூலர்", "D": "இராமலிங்க அடிகளார்"}, "explanation": "பாடநூல் பக். 133: திருமூலர் இயற்றிய திருமந்திரம் மூவாயிரம் பாடல்களைக் கொண்டது. எனவே இந்நூலைத் தமிழ் மூவாயிரம் என்பர்."}, "en": {"blocks": [{"type": "text", "content": "Who is the revered Siddhar who composed the canonical Saiva scripture Thirumanthiram, celebrated as 'Tamil Moovaayiram'?"}], "options": {"A": "Pattinatthar", "B": "Paambaatti Siddhar", "C": "Thirumoolar", "D": "Ramalinga Adigalar"}, "explanation": "Textbook Page 133: Saint Thirumoolar authored Thirumanthiram, popularly praised as Tamil Moovaayiram."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 133, "chapter": null, "section": null, 