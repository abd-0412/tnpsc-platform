{"id": "12th_tamil_u2_q268", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "nedunalvaadai", "chapter_id": null, "topic_id": "queen_palace_state", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நெடுநல்வாடையில் அரண்மனையில் இருக்கும் அரசி எத்தகைய மனநிலையில் உள்ளாள்?", "media_id": null}], "options": {"A": "நாட்டியம் கண்டு மகிழ்கிறாள்", "B": "தோழியருடன் ஊஞ்சலாடுகிறாள்", "C": "போருக்குச் செல்ல ஆயத்தமாகிறாள்", "D": "பிரிவுத் துயரால் மெலிந்து, அணிகலன்களைத் துறந்து, கட்டிலில் புரண்டு பெருந்துன்பம் அடைகிறாள்"}, "explanation": "பாண்டியன் நெடுஞ்செழியனைப் பிரிந்த அரசி அரண்மனைக் கட்டிலில் புரண்டு, ஒப்பனைகளைத் துறந்து, பெருந்துயரத்தோடு வாடைக் காற்றில் தவிக்கிறாள்."}, "en": {"blocks": [{"type": "text", "content": "How is the lonely Queen depicted enduring separation within her opulent palace chamber?", "media_id": null}], "options": {"A": "Delighting in classical dance recitals", "B": "Swinging merrily with maiden companions", "C": "Arming herself to lead battles", "D": "Languishing in deep pangs of love separation, shedding ornaments and tossing restlessly on her bed"}, "explanation": "The Queen renounces all adornments, tossing sleeplessly on her bed in deep agony during the lonely winter night."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samache