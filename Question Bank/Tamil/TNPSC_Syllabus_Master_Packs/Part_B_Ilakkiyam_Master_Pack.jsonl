{"id": "11th_tamil_u8_q055", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "sundaranar_memorial_stamp", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பேராசிரியர் பெ. சுந்தரனாரின் தமிழ்த் தொண்டினை நினைவுகூர்ந்து இந்திய அஞ்சல் துறை எந்த ஆண்டு நினைவு அஞ்சல்தலை வெளியிட்டது?", "media_id": null}], "options": {"A": "1990", "B": "1995", "C": "2010", "D": "2020"}, "explanation": "இந்திய நடுவண் அரசு பேராசிரியர் சுந்தரனாரின் இலக்கிய, வரலாற்றுத் தொண்டைப் போற்றி 2010-ல் நினைவு அஞ்சல்தலை வெளியிட்டுச் சிறப்பித்தது."}, "en": {"blocks": [{"type": "text", "content": "In which year did the Department of Posts (India) issue a commemorative postage stamp honoring Prof. P. Sundaranar?", "media_id": null}], "options": {"A": "1990", "B": "1995", "C": "2010", "D": "2020"}, "explanation": "India Post honored Prof. P. Sundaranar with a commemorative postage stamp in 2010."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 182, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 182", "url": null, "source_notes": null}, "previous_year": {"