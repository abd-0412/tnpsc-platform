{"id": "11th_tamil_u8_q077", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "kudilan_final_fate", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாடகத்தின் முடிவில் வஞ்சகன் குடிலனுக்கு மன்னன் ஜீவகன் விதித்த தண்டனை யாது?", "media_id": null}], "options": {"A": "கொல்லாமல் சிறைப்படுத்தி வாழ்நாள் முழுவதும் சிறையிலடைத்தல்", "B": "சிரச்சேதம் செய்தல்", "C": "நாடுகடத்துதல்", "D": "மன்னித்து விடுவித்தல்"}, "explanation": "புருடோத்தமனின் பெருந்தன்மையையும் சுந்தர முனிவரின் அருளையும் மதித்து, அவனது உயிரைப் பறிக்காமல் சிறையிலடைக்க மன்னன் உத்தரவிடுகிறான்."}, "en": {"blocks": [{"type": "text", "content": "What final verdict does King Jeevakan pronounce upon the traitor Kudilan at the drama's conclusion?", "media_id": null}], "options": {"A": "Spared from capital execution and consigned to lifelong rigorous imprisonment", "B": "Public beheading", "C": "Expulsion to foreign isles", "D": "Unconditional pardon"}, "explanation": "Tempered by royal clemency and Sage Sundara's counsel, Kudilan is condemned to life imprisonment."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 181, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 181", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 8", "Poetry", "Manonmaniyam"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
