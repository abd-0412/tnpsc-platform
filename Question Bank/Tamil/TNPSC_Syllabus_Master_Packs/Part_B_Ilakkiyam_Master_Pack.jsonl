{"id": "9th-u3-q024", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-01-eru-thazhuvuthal", "chapter_id": null, "topic_id": "topic-eru-thazhuvuthal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கலித்தொகையில் முல்லைக்கலிப் பாடல்களை (ஏறு தழுவுதல் பாடல்கள்) இயற்றிய சங்க காலப் புலவர் யார்?", "media_id": null}], "options": {"A": "நல்லந்துவனார்", "B": "கபிலர்", "C": "மருதன் இளநாகனார்", "D": "சோழன் நல்லுருத்திரன்"}, "explanation": "கலித்தொகையின் ஐந்து பிரிவுகளுள் முல்லைக்கலியைப் பாடியவர் சோழன் நல்லுருத்திரன் ஆவார். (குறிஞ்சிக்கலி - கபிலர்; மருதக்கலி - இளநாகனார்; நெய்தற்கலி - நல்லந்துவனார்; பாலைக்கலி - பெருங்கடுங்கோ)."}, "en": {"blocks": [{"type": "text", "content": "Who composed the Mullaikkali verses containing bull-embracing poems in Kalithogai?", "media_id": null}], "options": {"A": "Nallandhuvanaar", "B": "Kapilar", "C": "Maruthan Ilanaaganaar", "D": "Chola Nalluruthiran"}, "explanation": "King-poet Chola Nalluruthiran authored the 17 hymns of Mullaikkali in Kalithogai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 50, "chapter": null, "section": null, "reference": "