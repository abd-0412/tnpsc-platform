{"id": "12th_tamil_u6_q1035", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "maddalam_thannumai_nature", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரத்தில் ‘தண்ணுமை’ என்பது எவ்வகை இசைக் கருவியாகும்?", "media_id": null}], "options": {"A": "நரம்புக் கருவி", "B": "காற்றுக் கருவி", "C": "தோற் கருவி (மத்தளம் / மிருதங்கம் போன்ற தாளக் கருவி)", "D": "கஞ்சக் கருவி"}, "explanation": "விலங்கின் தோலினால் கட்டப்பட்டுத் தாள ஓசையைத் தரும் மத்தளம், முழவு போன்றவை 'தோற் கருவிகள்' எனப்படும். தண்ணுமை என்பது தோற்கருவியாகும்."}, "en": {"blocks": [{"type": "text", "content": "What classification of musical instrument does the classical 'Thannumai' represent in Tamil organology?", "media_id": null}], "options": {"A": "Chordophone (Stringed)", "B": "Aerophone (Wind)", "C": "Membranophone (Percussion drum covered with animal hide)", "D": "Idiophone"}, "explanation": "'Thannumai' is a classical membranophone percussion drum regulating dance tempo."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "ref