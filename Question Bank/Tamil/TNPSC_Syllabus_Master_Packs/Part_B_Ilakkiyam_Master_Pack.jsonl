{"id": "12th_tamil_mp2_q1821", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "mayilai_seeni_buddhism_research", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயிலை சீனி. வேங்கடசாமி எழுதிய ஆய்வு நூல்களுள் தமிழகத்தில் பௌத்த மதம் நிலவிய வரலாற்றை விளக்கும் நூல் எது?", "media_id": null}], "options": {"A": "பௌத்தமும் தமிழும்", "B": "சமணமும் தமிழும்", "C": "கிறித்தவமும் தமிழும்", "D": "இறை கோட்பாடும் தமிழும்"}, "explanation": "மயிலை சீனி. வேங்கடசாமி 'பௌத்தமும் தமிழும்' என்ற புகழ்பெற்ற வரலாற்று ஆய்வு நூலை எழுதி மறைந்துபோன பௌத்தச் சான்றுகளை வெளிக்கொணர்ந்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which pioneering research work by Mayilai Seeni. Venkatasamy systematically documented Buddhism's historic presence in Tamil Nadu?", "media_id": null}], "options": {"A": "Bouddhamum Thamizhum", "B": "Samanamum Thamizhum", "C": "Kirithavamum Thamizhum", "D": "Irai Kotpaadum Thamizhum"}, "explanation": "Mayilai Seeni. Venkatasamy authored the landmark historical treatise 'Bouddhamum Thamizhum'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 160", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 3", "Mayilai Seeni Buddhism"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp2_q1822", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "sirupanattruppadai_nalliyakkodan_capital", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிறுபாணாற்றுப்படையின் பாட்டுடைத் தலைவனான ஓய்மானாட்டு நல்லியக்கோடனின் தலைநகரம் எது?", "media_id": null}], "options": {"A": "திருக்கோவலூர்", "B": "கிடங்கில் (திண்டிவனம்)", "C": "கொல்லிமலை", "D": "தகடூர்"}, "explanation": "ஓய்மானாட்டு நல்லியக்கோடனின் தலைநகரம் கிடங்கில் (இன்றைய திண்டிவனம்) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What was the capital seat of king Nalliyakkodan of Oymanadu, eulogized in Sirupanattruppadai?", "media_id": null}], "options": {"A": "Thirukkovaloor", "B": "Kidangil (modern Tindivanam)", "C": "Kollimalai", "D": "Thagadoor"}, "explanation": "King Nalliyakkodan of Oymanadu ruled from his ancient fortified capital Kidangil (modern Tindivanam)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 165, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 165", "url": null, "source_notes": null}, "previous