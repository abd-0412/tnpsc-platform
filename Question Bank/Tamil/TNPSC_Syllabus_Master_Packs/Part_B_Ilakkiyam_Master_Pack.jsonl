{"id": "9th-u2-q074", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-02-periyapuranam", "chapter_id": null, "topic_id": "topic-periyapuranam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெரியபுராணம் எத்தனை காண்டங்களையும், எத்தனை சருக்கங்களையும் கொண்ட பெருங்காப்பியமாகத் திகழ்கிறது?", "media_id": null}], "options": {"A": "3 காண்டங்கள், 10 சருக்கங்கள்", "B": "2 காண்டங்கள், 13 சருக்கங்கள்", "C": "6 காண்டங்கள், 118 சருக்கங்கள்", "D": "5 காண்டங்கள், 24 சருக்கங்கள்"}, "explanation": "பெரியபுராணம் இரண்டு காண்டங்களையும் 13 சருக்கங்களையும் 4,286 பாடல்களையும் கொண்டு விளங்கும் சீர்மிகு காப்பியமாகும்."}, "en": {"blocks": [{"type": "text", "content": "How many Kandams (sections) and Sarukkams (cantos) does Periyapuranam comprise?", "media_id": null}], "options": {"A": "3 Kandams, 10 Sarukkams", "B": "2 Kandams, 13 Sarukkams", "C": "6 Kandams, 118 Sarukkams", "D": "5 Kandams, 24 Sarukkams"}, "explanation": "Periyapuranam consists of 2 Kandams, 13 Sarukkams, and 4,286 hymns."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 31, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 31", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_2", "periyapuranam", "sekkizhar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u2-q081", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-02-periyapuranam", "chapter_id": null, "topic_id": "topic-periyapuranam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கரிய மேகங்கள் பெரிய பொன்மலைச் சாரல் மீது வலமாகச் சுற்றுகின்ற காட்சிக்கு உவமையாகப் பெரியபுராணம் எதனைக் குறிப்பிடுகிறது?", "media_id": null}], "options": {"A": "நெற்கற்றைக் குவியலின் மீது கரிய எருமைக்கடாக்கள் சுற்றிச் சுற்றி மிதிக்கும் காட்சி", "B": "ஆற்று வெள்ளத்தில் மிதந்து வரும் கரிய மரக் கட்டைகள் சுழலும் காட்சி", "C": "தாமரை மலர்களை வண்டுகள் வட்டமிட்டு மொய்க்கும் காட்சி", "D": "சோழப் படை வீரர்கள் கோட்டையை வலம் வரும் காட்சி"}, "explanation": "சாலியின் கற்றை துற்ற தடவரை முகடு சாய்த்துக் காலும் எருமைக்கடாக்கள் சுற்றி மிதிக்கும் காட்சி, பெரிய பொன்மலையைச் சுற்றித் திரியும் மேகக்கூட்டம் போல் உள்ளதாகக் கவிஞர் உவமிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "What does Periyapuranam compare to dark rainclouds circling the slopes of the golden Meru mountain?", "media_id": null}], "options": {"A": "Dark buffalo bulls circling and treading atop enormous golden heaps of harvested paddy", "B": "Dark wooden logs swirling in torrential river floods", "C": "Bees buzzing in circles around lotus blossoms", "D": "Chola warriors marching around the fortress walls"}, "explanation": "The poet compares the circular threshing of dark buffalo bulls around massive golden heaps of grain sheaves to dark clouds circling the golden slopes of Mount Meru."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 30", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_2", "periyapuranam", "sekkizhar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

# ==============================================================================
# 9-ஆம் வகுப்பு - 'நீரின்றி அமையாது யாக்கைக்கு எல்லாம்...', பாண்டியன் நெடுஞ்செழியன்; கந்தர்வன் (நாகலிங்கம் - இராமநாதபுரம்), சாசனம், ஒவ்வொரு கல்லாய், கொம்பன், இரயில் தண்ணீர் வேட்கை
# ==============================================================================
{"id": "9th-u2-q096", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-03-purananuru-thanneer", "chapter_id": null, "topic_id": "topic-purananuru-thanneer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எட்டுத்தொகை நூல்களுள் ஒன்றான புறநானூறு பற்றிய பின்வரும் கூற்றுகளில் தவறானது எது?", "media_id": null}], "options": {"A": "பண்டைக்கால மன்னர்களின் வீரம், வெற்றி, கொடை முதலியவற்றைக் கூறுகிறது", "B": "புலவர்கள், சான்றோர்கள் உள்ளிட்டோரின் பெருமைகளையும் அன்றைய மக்களின் புறவாழ்க்கையையும் கூறுகிறது", "C": "பண்டைத் தமிழர்களின் அரிய வரலாற்றுச் செய்திகள் அடங்கிய பண்பாட்டுக் கருவூலமாகத் திகழ்கிறது", "D": "இது அகப்பொருள் சார்ந்த முல்லைத் திணைப் பாடல்களை மட்டுமே முதன்மையாகக் கொண்ட நூலாகும்"}, "explanation": "கூற்று D முற்றிலும் தவறானது. புறநானூறு என்பது அகப்பொருள் நூல் அன்று; இது மன்னர்களின் வீரம், கொடை, மக்கள் வாழ்வியல் போன்ற புறவாழ்க்கை நிகழ்வுகளைக் கூறும் 'புறப்பொருள்' நூலாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which statement regarding the Eight Anthologies classic 'Purananuru' is INCORRECT?", "media_id": null}], "options": {"A": "It depicts the valor, triumphs, and generosity of ancient Tamil monarchs", "B": "It narrates the eminence of poets and scholars and the exterior civic life of ancient society", "C": "It shines as an invaluable cultural treasury reflecting historic insights of ancient Tamils", "D": "It is primarily an interior romance anthology composed strictly in Mullai thinai"}, "explanation": "Statement D is false. Purananuru is an exterior (Puram) work celebrating statecraft, virtue, ethics, and heroism, not an interior romantic work."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 34, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 34", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_2", "purananuru", "thanneer", "kandharvan"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

