{"id": "11th_tamil_rev1_q067", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "woods_despatch_magna_carta", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியக் கல்வியின் 'மகாசாசனம்' (Magna Carta of Indian Education) என்று வரலாற்று ஆய்வாளர்களால் போற்றப்படும் அறிக்கை எது?", "media_id": null}], "options": {"A": "ஹண்டர் கல்விக்குழு அறிக்கை (1882)", "B": "ராதாகிருஷ்ணன் அறிக்கை (1948)", "C": "சார்லஸ் வுட் அறிக்கை (Charles Wood Despatch - 1854)", "D": "கோத்தாரி கல்விக்குழு (1964)"}, "explanation": "1854-ஆம் ஆண்டு வெளியிடப்பட்ட சர் சார்லஸ் வுட்டின் கல்வி அறிக்கை இந்தியாவில் தொடக்கக் கல்வி முதல் பல்கலைக்கழகக் கல்வி வரை முறைப்படுத்தியதால் 'இந்தியக் கல்வியின் மகாசாசனம்' எனப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which historic educational policy document is universally hailed as the 'Magna Carta of Indian Education'?", "media_id": null}], "options": {"A": "Hunter Commission Report (1882)", "B": "Radhakrishnan Commission (1948)", "C": "Charles Wood Despatch of 1854", "D": "Kothari Commission (1964)"}, "explanation": "The Wood Despatch of 1854 is hailed as the Magna Carta of English and modern Indian education."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu S