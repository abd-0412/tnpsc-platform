{"id": "9th-u8-q136", "schema_version": "1.0", "kind": "application", "level": "application", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l5", "chapter_id": null, "topic_id": "thirukkural-eeradi-alavadi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறள் முதன் முதலடி நான்கு சீர்களையும், இரண்டாம் அடி மூன்று சீர்களையும் கொண்டு விளங்குவதால், முறையே அவை எவ்வகை அடிகள்?", "media_id": null}], "options": {"A": "சிந்தடி மற்றும் நெடிலடி", "B": "கழிநெடிலடி மற்றும் குரளடி", "C": "நெடிலடி மற்றும் சிந்தடி", "D": "அளவடி (4 சீர்) மற்றும் சிந்தடி (3 சீர்)"}, "explanation": "நான்கு சீர்களைக் கொண்ட முதல் அடி 'அளவடி' (நேரடி); மூன்று சீர்களைக் கொண்ட இரண்டாம் அடி 'சிந்தடி' எனப்படும். (குறள் வெண்பா)."}, "en": {"blocks": [{"type": "text", "content": "Because Thirukkural features four feet in the first line and three feet in the second, what are these lines designated?", "media_id": null}], "options": {"A": "Chinthadi and Nediladi", "B": "Kazhinediladi and Kuraladi", "C": "Nediladi and Chinthadi", "D": "Alavadi (4 feet) and Chinthadi (3 feet) (அளவடி, சிந்தடி)"}, "explanation": "The standard Kural couplet consists of an Alavadi (tetrameter line) followed by a Chinthadi (trimeter line)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 166, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 166", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_8", "thirukkural", "adi_classification"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

