{"id": "11th_tamil_u8_q073", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "baladevan_confession", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குடிலனின் மகன் பலதேவன் இறுதியில் எதனால் நிலைகுலைந்து தன் தந்தையின் சதியை ஒப்புக்கொள்கிறான்?", "media_id": null}], "options": {"A": "நடராசனின் நேரடி விசாரணையாலும், தான் மாட்டிக்கொண்டோம் என்ற அச்சத்தாலும், மனசாட்சியின் உறுத்தலாலும்", "B": "மன்னன் பொற்காசு கொடுத்ததால்", "C": "வாணி மிரட்டியதால்", "D": "சேர மன்னன் நாடு கடத்தியதால்"}, "explanation": "பலதேவன் தன் தந்தையின் திட்டங்கள் சிதைந்ததையும், சான்றுகள் தமக்கு எதிராக இருப்பதையும் கண்டு நிலைகுலைந்து உண்மைகளை ஒப்புக்கொள்கிறான்."}, "en": {"blocks": [{"type": "text", "content": "Why does Baladevan ultimately collapse under interrogation and confess to the conspiracy?", "media_id": null}], "options": {"A": "Confronted by Natarasan irrefutable proofs, terror of impending retribution, and inner guilt", "B": "Bribed by royal gold", "C": "Intimidated by Vaani", "D": "Exiled by the Cheras"}, "explanation": "Cornered by undeniable documentary evidence and fear of execution, Baladevan breaks down in confession."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Te