{"id": "8th-booster-q1175", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-booster-bridging", "lesson_id": "8th-booster-thirukkural", "chapter_id": null, "topic_id": "thirukkural-porutpal-iyal-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளின் பொருட்பாலில் அமைந்துள்ள இயல்களின் எண்ணிக்கை எத்தனை?"}], "options": {"A": "இரண்டு இயல்கள்", "B": "நான்கு இயல்கள்", "C": "மூன்று இயல்கள் (அரசியல், அமைச்சியல், ஒழிபியல்)", "D": "ஐந்து இயல்கள்"}, "explanation": "பாடநூல் பக். 66 & TNPSC பாடக்குறிப்பு: திருக்குறள் பொருட்பாலில் 3 இயல்கள் (அரசியல் 25, அமைச்சியல் 32, ஒழிபியல் 13) அமைந்துள்ளன. அறத்துப்பாலில் 4 இயல்களும், காமத்துப்பாலில் 2 இயல்களும் உள்ளன."}, "en": {"blocks": [{"type": "text", "content": "How many sections (Iyals) are present in Porutpal of Thirukkural?"}], "options": {"A": "Two sections", "B": "Four sections", "C": "Three sections (Arasiyal, Amaichiyal, Ozhibiyal)", "D": "Five sections"}, "explanation": "Textbook Page 66 & TNPSC syllabus: Porutpal is divided into 3 sections: Arasiyal (25 chapters), Amaichiyal (32 chapters), and Ozhibiyal (13 chapters)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 66, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "booster-thirukkural", "direct", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-booster-q1176", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-booster-thirukkural", "chapter_id": null, "topic_id": "thiruvalluvar-year-reckoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருவள்ளுவர் ஆண்டைக் கணக்கிட தற்போதைய கிறித்து ஆண்டுடன் (கி.பி.) கூட்ட வேண்டிய எண் எது?"}], "options": {"A": "21", "B": "25", "C": "30", "D": "31"}, "explanation": "பாடநூல் பக். 66 & அரசு மரபு: திருவள்ளுவர் கி.மு. 31-இல் பிறந்தவர் எனக் கணக்கிடப்பட்டு, தமிழ்நாடு அரசால் நடைமுறைப்படுத்தப்பட்டுள்ளது. எனவே நடப்பு ஆண்டுடன் 31-ஐக் கூட்டினால் திருவள்ளுவர் ஆண்டு கிடைக்கும் (எ.கா. 2026 + 31 = 2057)."}, "en": {"blocks": [{"type": "text", "content": "What number should be added to the current Gregorian Calendar Year (CE) to reckon the Thiruvalluvar Year?"}], "options": {"A": "21", "B": "25", "C": "30", "D": "31"}, "explanation": "Textbook Page 66: The Government of Tamil Nadu established that Thiruvalluvar was born in 31 BCE; hence 31 is added to the CE year to calculate the Thiruvalluvar year."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 66, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "booster-thirukkural", "direct", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

# ==============================================================================
# 8-ஆம் வகுப்பு - பாரதியார், பாரதிதாசன், வாணிதாசன் (செவாலியர்), திரு.வி. கல்யாணசுந்தரனார் (தமிழ்த்தென்றல்), அயோத்திதாசர் (ஒரு பைசாத் தமிழன்), வீரமாமுனிவர் & பெரியார் எழுத்துச் சீர்திருத்தங்கள், வினா (6) & விடை (8) வகைகள்
# ==============================================================================
{"id": "8th-booster-q1234", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u8-manitham", "lesson_id": "8th-booster-pyq", "chapter_id": null, "topic_id": "pyq-vanidasan-titles-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "TNPSC தேர்வுகளில் கேட்கப்பட்ட கவிஞர் வாணிதாசன் பற்றிய கூற்றுகளில் தவறானது எது?\n1. வாணிதாசனின் இயற்பெயர் 'அரங்கசாமி' என்ற 'எத்திராசலு' ஆகும்; இவர் புதுவையை அடுத்த வில்லியனூரில் பிறந்தார்.\n2. இவர் பாரதிதாசனின் தலைமாணாக்கராக விளங்கியவர்; 'கவிஞரேறு', 'பாவலர் மணி' ஆகிய பட்டங்களைப் பெற்றவர்.\n3. பிரெஞ்சு அரசு இவருக்குச் செவாலியர் (Chevalier) விருதினை வழங்கிச் சிறப்பித்துள்ளது.\n4. வாணிதாசன் எழுதிய நூல்களுள் 'இரட்சணிய யாத்திரிகம்' மற்றும் 'தேம்பாவணி' ஆகியவை மிக முக்கியமானவை ஆகும்."}], "options": {"A": "கூற்று 1 தவறானது", "B": "கூற்று 4 தவறானது ('இரட்சணிய யாத்திரிகம்' எச்.ஏ. கிருட்டிணனாரும், 'தேம்பாவணி' வீரமாமுனிவரும் இயற்றியவை; வாணிதாசனின் நூல்கள் தமிழச்சி, கொடிமுல்லை, தொடுவானம், எழிலோவியம் ஆகும்)", "C": "கூற்று 2 தவறானது", "D": "கூற்று 3 தவறானது"}, "explanation": "TNPSC Group 2 (2015, 2018) & பாடநூல் பக். 27: வாணிதாசன் இயற்றியவை தமிழச்சி, கொடிமுல்லை, தொடுவானம், எழிலோவியம், குழந்தை இலக்கியம் முதலியனவாகும். இரட்சணிய யாத்திரிகமும் தேம்பாவணியும் கிறித்தவக் காப்பியங்கள். எனவே கூற்று 4 தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Which statement is incorrect regarding poet Vanidasan from TNPSC past papers:\n1. Vanidasan's birth name was Rangasamy alias Ethirasalu; he was born in Villianur near Puducherry.\n2. He was the foremost disciple of Bharathidasan, bearing titles 'Kavignareru' and 'Paavalar Mani'.\n3. The French Government honored him with the prestigious Chevalier Award.\n4. Notable works of Vanidasan include 'Ratchanya Yaathrigam' and 'Thembaavani'."}], "options": {"A": "Statement 1 is incorrect", "B": "Statement 4 is incorrect ('Ratchanya Yaathrigam' was by H.A. Krishna Pillai and 'Thembaavani' by Veeramamunivar; Vanidasan wrote Thamizhazhi, Kodimullai, Thoduvaanam)", "C": "Statement 2 is incorrect", "D": "Statement 3 is incorrect"}, "explanation": "TNPSC Group 2 (2015, 2018) & Textbook Page 27: Vanidasan's works are Thamizhazhi, Kodimullai, Thoduvaanam. Ratchanya Yaathrigam is by Krishna Pillai. Statement 4 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "booster-pyq", "vanidasan", "statement", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

