{"id": "6th-t1-u1-045", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மேனாள் குடியரசுத் தலைவர் டாக்டர் ஏ.பி.ஜே. அப்துல் கலாம் அவர்களின் வாழ்க்கைக்குப் பெருவலு சேர்த்ததாக அவரே குறிப்பிட்ட திருக்குறள் எது?", "media_id": null}], "options": {"A": "\"அறிவு அற்றம் காக்கும் கருவி செறுவார்க்கும் உள்ளழிக்கல் ஆகா அரண்\"", "B": "\"அகர முதல எழுத்தெல்லாம் ஆதி பகவன் முதற்றே உலகு\"", "C": "\"துப்பார்க்குத் துப்பாய துப்பாக்கித் துப்பார்க்குத் துப்பாய தூஉம் மழை\"", "D": "\"எப்பொருள் யார்யார்வாய்க் கேட்பினும் அப்பொருள் மெய்ப்பொருள் காண்ப தறிவு\""}, "explanation": "அப்துல் கலாம் அவர்கள் நேர்காணலில், 'அறிவு அற்றம் காக்கும் கருவி செறுவார்க்கும் உள்ளழிக்கல் ஆகா அரண்' என்னும் குறள் என் வாழ்க்கைக்கு வலு சேர்த்தது என்று தெளிவாகக் கூறியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null