{"id": "11th_tamil_rev1_q023", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "pallu_two_wives_allegory", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பள்ளு சிற்றிலக்கியத்தில் மூத்த மனைவி மற்றும் இளைய மனைவி ஆகிய இருவர் முறையே எவ்வகை நிலவளங்களின் குறியீடாகக் காட்டப்படுகின்றனர்?", "media_id": null}], "options": {"A": "காடும் மலையும்", "B": "கடலும் பாலைவனமும்", "C": "முறையே பருவமழை / நன்செய் வளம் மற்றும் கிணற்றுப்பாசனம் / புன்செய் வளம்", "D": "நகரமும் கிராமமும்"}, "explanation": "பள்ளு நாடகத்தில் மூத்த பள்ளி (நன்செய் நீர்நிலைப் பகுதி) மற்றும் இளைய பள்ளி (புன்செய் மேட்டு நிலப் பகுதி) என்ற இரு நிலவளங்களின் குறியீடாகவும் சித்திரிக்கப்படுகின்றனர்."}, "en": {"blocks": [{"type": "text", "content": "In Pallu allegory, what ecological/agricultural landscapes do the senior and junior farmer wives symbolize?", "media_id": null}], "options": {"A": "Forest and mountain", "B": "Ocean and desert", "C": "Wetland (Nanjai / river-fed) and Dryland (Punjai / well-fed) agricultural ecologies", "D": "Town and village"}, "explanation": "The dual wives symbolize fertile river-fed wetlands (Nanjai) and rain-fed dry tracts (Punjai)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi",