{"id": "10th-u8-q090", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ramanujar", "chapter_id": null, "topic_id": "temple_tower_action", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இராமானுசர் திருமந்திரத்தைப் பெற்றவுடன் எங்கு ஏறி நின்று ஊர் மக்கள் அனைவருக்கும் முழங்கினார்?", "media_id": null}], "options": {"A": "அரண்மனை உப்பரிகை", "B": "திருக்கோட்டியூர் சௌமிய நாராயணப் பெருமாள் கோயில் கோபுரம்", "C": "ஸ்ரீரங்கம் ராஜகோபுரம்", "D": "காஞ்சி வரதராஜர் தேர்"}, "explanation": "பாடநூல் குறிப்பு: இராமானுசர் திருக்கோட்டியூர் திருக்கோயில் கோபுரத்தின் மீது ஏறி நின்று, ஊர் மக்கள் அனைவரையும் அழைத்து அனைவருக்கும் அம்மந்திரத்தை உரக்கக் கூறினார்."}, "en": {"blocks": [{"type": "text", "content": "Where did Ramanuja climb to proclaim the sacred mantra to all assembled people?", "media_id": null}], "options": {"A": "Palace terrace", "B": "The temple tower (Gopuram) of Thirukkottiyur Sowmya Narayana Perumal Temple", "C": "Srirangam Rajagopuram", "D": "Kanchi Varadaraja Temple chariot"}, "explanation": "He climbed the tower of Thirukkottiyur Sowmya Narayana temple."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025"