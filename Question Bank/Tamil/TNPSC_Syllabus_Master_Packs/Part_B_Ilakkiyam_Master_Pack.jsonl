{"id": "9th-u3-q015", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-01-eru-thazhuvuthal", "chapter_id": null, "topic_id": "topic-eru-thazhuvuthal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கலித்தொகையைத் தொகுத்த சான்றோரான நல்லந்துவனார் கலித்தொகையில் எந்தக் கலிப் பகுதியை இயற்றியுள்ளார்?", "media_id": null}], "options": {"A": "குறிஞ்சிக்கலி", "B": "முல்லைக்கலி", "C": "நெய்தற்கலி", "D": "பாலைக்கலி"}, "explanation": "கலித்தொகையைத் தொகுத்தவர் நல்லந்துவனார்; இவர் நெய்தற்கலியைப் பாடியுள்ளார். முல்லைக்கலியைப் பாடியவர் சோழன் நல்லுருத்திரன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Which section of Kalithogai was authored by its compiler, Nallandhuvanaar?", "media_id": null}], "options": {"A": "Kurinjikkali", "B": "Mullaikkali", "C": "Neitharkkali", "D": "Paalaikkali"}, "explanation": "Nallandhuvanaar compiled Kalithogai and authored its coastal Neitharkkali section, while Chola Nalluruthiran authored Mullaikkali."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 50, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 50", "url": null, "so