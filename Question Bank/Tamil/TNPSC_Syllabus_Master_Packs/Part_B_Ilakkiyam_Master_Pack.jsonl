{"id": "12th_tamil_u6_q1036", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "indhira_vizha_duration", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரப் புகார் காண்டத்தில் விவரிக்கப்படும் புகழ்பெற்ற ‘இந்திர விழா’ எத்தனை நாட்கள் தொடர்ந்து கொண்டாடப்பட்டது?", "media_id": null}], "options": {"A": "ஏழு நாட்கள்", "B": "பத்து நாட்கள்", "C": "பதினான்கு நாட்கள்", "D": "இருபத்தெட்டு (28) நாட்கள்"}, "explanation": "காவிரிப்பூம்பட்டினத்தில் சோழ மன்னர்களால் பசி, பிணி, பகை நீங்க இந்திரனுக்கு எடுக்கப்பட்ட இந்திர விழா தொடர்ந்து 28 நாட்கள் சிறப்பாக நடைபெற்றது."}, "en": {"blocks": [{"type": "text", "content": "How many continuous days did the monumental 'Indhira Vizha' spring festival span in ancient Puhar?", "media_id": null}], "options": {"A": "7 days", "B": "10 days", "C": "14 days", "D": "Twenty-eight (28) continuous days"}, "explanation": "The royal Indhira Vizha festival in Puhar spanned exactly 28 festive days."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": "12th Tamil, Uni