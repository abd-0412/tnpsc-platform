{"id": "11th_tamil_u2_q112", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aingurunooru", "chapter_id": null, "topic_id": "short_meter_impact", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "3 முதல் 6 அடிகள் கொண்ட மிகக் குறுகிய அடிகளால் பாடப்பட்டதால் ஐங்குறுநூற்றுப் பாடல்களுக்குக் கிடைத்த தனிச்சிறப்பு என்ன?", "media_id": null}], "options": {"A": "நீண்ட கதைகளை விவரிக்க முடிந்தது", "B": "வடமொழிச் சொற்கள் கலந்தன", "C": "பாடல்கள் பொருளற்றதாக மாறின", "D": "செறிவான உணர்ச்சிகளையும் உள்ளுறை உவமைகளையும் மிகச் சுருக்கமாக, மின்னல் வெட்டுப் போல வெளிப்படுத்தும் கவிதை நயம்"}, "explanation": "குறுகிய அடிகள் என்பதால் வீண் சொற்களின்றி மின்னல் வெட்டுப் போன்ற தீவிர உணர்ச்சி வெளிப்பாடும் உள்ளுறை உவமைகளும் இதில் சாத்தியமாயின."}, "en": {"blocks": [{"type": "text", "content": "What unique poetic aesthetic emerges from the compact 3-to-6 line brevity of Aingurunooru verses?", "media_id": null}], "options": {"A": "Permitted long rambling historical chronicles", "B": "Infused heavy Sanskrit vocabulary", "C": "Rendered verses meaningless", "D": "Delivered intense emotional concentration and exquisite implied allegories (Ullurai Uvamai) with lightning-strike poetic economy"}, "explanation": "The extreme concision produces electrifying emotional compression and rich subtext."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers":