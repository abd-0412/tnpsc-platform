{"id": "12th_tamil_u6_q1016", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "thalaikkol_origin", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரத்தில் ஆடலரசிக்கு வழங்கப்படும் உயரிய விருதான ‘தலைக்கோல்’ எதனால் செய்யப்பட்டது?", "media_id": null}], "options": {"A": "தங்கத்தால் செதுக்கப்பட்டது", "B": "வெள்ளித் தடியால் ஆனது", "C": "சந்தன மரத்தால் செய்யப்பட்டது", "D": "பகை மன்னனுடன் போரிட்டு வென்ற வெண்கொற்றக் குடையின் காம்பிலிருந்து (மூங்கிலிலிருந்து) செய்யப்பட்டது"}, "explanation": "பகை மன்னரைக் களத்தில் வென்று கைப்பற்றிய வெண்கொற்றக் குடையின் கணுக்கள் நிறைந்த மூங்கில் தண்டினைக் கொண்டு பொன்னாலும் நவரத்தினங்களாலும் தலைக்கோல் செய்வர்."}, "en": {"blocks": [{"type": "text", "content": "From what historical trophy material was the supreme dance scepter 'Thalaikkol' traditionally fashioned in Silappathikaram?", "media_id": null}], "options": {"A": "Cast pure solid gold", "B": "Polished solid silver staff", "C": "Carved fragrant sandalwood", "D": "Bamboo shaft harvested from the captured victory parasol of a defeated adversary king"}, "explanation": "The Thalaikkol scepter was crafted from the bamboo central staff of a captured royal victory umbrella."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 137", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Poetry", "Thalaikkol Origin"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1017", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "thalaikkol_gold_knots", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தலைக்கோலின் கணுக்களில் எதனைப் பூசி, இடைவெளியில் நவரத்தினங்களை இழைத்திருப்பர்?", "media_id": null}], "options": {"A": "சாம்பூநதம் என்னும் உயர்ந்த பொன் தகடு", "B": "வெள்ளித் தகடு", "C": "செப்புத் தகடு", "D": "பித்தளைத் தகடு"}, "explanation": "தலைக்கோலின் கணுக்களில் 'சாம்பூநதம்' என்னும் மிக உயர்ந்த வகைப் பொன்னைப் பூசி, இடையே உள்ள பகுதிகளில் ஒன்பது மணிகளையும் பதித்திருப்பர்."}, "en": {"blocks": [{"type": "text", "content": "With which premier quality of refined gold were the nodal joints of the Thalaikkol ceremonial staff plated?", "media_id": null}], "options": {"A": "Jambunatha gold (Saamboonatham)", "B": "Silver alloy", "C": "Copper plating", "D": "Brass sheeting"}, "explanation": "The knots of the bamboo scepter were encased in pristine Jambunatha gold inlaid with nine precious gems."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 137", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Poetry", "Saamboonatham Gold"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
