{"id": "12th_tamil_mp2_q1816", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "suradha_uvamaikkavignar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தனது கவிதைகளில் உவமைகளை மிகுதியாகக் கையாண்டதால் 'உவமைக் கவிஞர்' என்று அழைக்கப்படுபவர் யார்?", "media_id": null}], "options": {"A": "வாணிதாசன்", "B": "கண்ணதாசன்", "C": "முடியரசன்", "D": "சுரதா (இராசகோபாலன்)"}, "explanation": "பாரதிதாசன் மீது கொண்ட பற்றினால் சுப்புரத்தினதாசன் எனப் பெயர் மாற்றி, சுருக்கமாகச் சுரதா என வாழ்ந்த இராசகோபாலன் 'உவமைக் கவிஞர்' எனப் போற்றப்படுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Who earned the celebrated epithet 'Uvamaik Kavignar' for his masterful mastery of poetic similes?", "media_id": null}], "options": {"A": "Vanidasan", "B": "Kannadasan", "C": "Mudiyarasan", "D": "Suradha (Rajagopalan)"}, "explanation": "Suradha (Rajagopalan, pen name derived from Subburathina Dasan) is renowned as 'Uvamaik Kavignar'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 155, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 