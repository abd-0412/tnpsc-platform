{"id": "7th-t2-u1-q024", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-01-naladiyar", "chapter_id": null, "topic_id": "ta-t2-u1-naladiyar-quote-fill", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாலடியார் பாடல் அடியை நிறைவு செய்க:\n'எச்சம் எனவொருவன் மக்கட்குச் செய்வன\n___________ மற்று அல்ல பிற.'"}], "options": {"A": "பொன்னே", "B": "நிலமே", "C": "அறிவே", "D": "விச்சை"}, "explanation": "நாலடியார் பாடல் வரி: 'எச்சம் எனவொருவன் மக்கட்குச் செய்வன விச்சைமற்று அல்ல பிற.' இதில் விச்சை என்பது கல்வியைக் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "Complete the verse line from Naladiyar:\n'Echam enavoruvan makkatkuch seyvana\n___________ matru alla pira.'"}], "options": {"A": "Ponne", "B": "Nilame", "C": "Arive", "D": "Vichai"}, "explanation": "The exact poem line is '...seyvana vichaimatru alla pira', where 'vichai' denotes knowledge/education."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["quote_completion", "naladiyar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u1-q025", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-02-thottapattu", "chapter_id": null, "topic_id": "ta-t2-u1-odd-folk-titles", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "19 மற்றும் 20-ஆம் நூற்றாண்டுகளில் பாமர மக்களிடையே செல்வாக்குப் பெற்ற 'சிறு நூல்களின்' வகைகளில் பொருந்தாத ஒன்றைத் தேர்ந்தெடுக்க:"}], "options": {"A": "தொல்காப்பியப் பாயிர நூல்கள்", "B": "முச்சந்தி இலக்கியம்", "C": "குஜிலி நூல்கள்", "D": "பெரிய எழுத்துப் புத்தகங்கள்"}, "explanation": "19-ஆம் நூற்றாண்டின் இறுதியில் பாமர மக்களுக்காக வெளியிடப்பட்ட சிறு நூல்கள் 'வெகுசன இலக்கியம்', 'முச்சந்தி இலக்கியம்', 'குஜிலி நூல்கள்', 'பெரிய எழுத்துப் புத்தகங்கள்' என அழைக்கப்பட்டன. தொல்காப்பியப் பாயிரம் என்பது தொன்மையான செவ்வியல் இலக்கணப் பனுவலாகும்; அது இப்பட்டியலில் பொருந்தாது."}, "en": {"blocks": [{"type": "text", "content": "Identify the odd term that does not belong to the folk publications popular in the 19th-20th centuries:"}], "options": {"A": "Tolkappiya Paayira treatises", "B": "Muchanthi Ilakkiyam", "C": "Gujili Noolgal", "D": "Periya Ezhuthu Puthagangal"}, "explanation": "Muchanthi Ilakkiyam, Gujili Noolgal, and Periya Ezhuthu Puthagangal are 19th-century folk publications. Tolkappiyam preface is ancient classical grammar and thus the odd one."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": fa