# ==============================================================================
# 8-ஆம் வகுப்பு - மருத்துவர் கு. சிவராமன், தமிழர் மரபு மருத்துவம், ஐம்பூதக் கொள்கை, முப்பிணிகள் (வாதம், பித்தம், கபம்/சிலேத்துமம்), 'மருந்தென வேண்டாவாம் யாக்கைக்கு' குறள் நெறி, உணவே மருந்து, மூலிகை மருத்துவம், தாதுக்கள், பாஷாணங்கள், பஸ்பம், செந்தூரம், பக்கவிளைவுகள் அற்ற தன்மை, தொற்றா நோய்கள், பாரம்பரிய உணவு, சிறுதானியங்கள், வாழ்வியல் முறை, சமையலறை நேரம், உலகளாவிய மறுமலர்ச்சி
# ==============================================================================
{"id": "8th-u2-q193", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-08-tamizhar-maruthuvam", "chapter_id": null, "topic_id": "ta-8th-u2-quote-kural-marunthu-942", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மருத்துவர் மேற்கோள் காட்டிய திருக்குறளை நிறைவு செய்க:\n’மருந்தென வேண்டாவாம் யாக்கைக்கு அருந்தியது\n__________ போற்றி உணின்.’"}], "options": {"A": "அற்றது", "B": "சுவைத்தது", "C": "விளைந்தது", "D": "நிறைந்தது"}, "explanation": "பாடநூல் பக்கம் 30 குறள் 942: 'மருந்தென வேண்டாவாம் யாக்கைக்கு அருந்தியது அற்றது போற்றி உணின்' என்பது திருக்குறள் வரிகளாகும். 'அற்றது' என்பது முன் உண்ட உணவு செரித்த தன்மையைக் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "Complete the classical Kural on medicine cited by the physician:\n'Marunthena veandaavaam yaakkaikku arunthiyathu\n__________ potrri unin.'"}], "options": {"A": "Atrathu (that which is fully digested)", "B": "Suvaithathu", "C": "Vilainthathu", "D": "Nirainthathu"}, "explanation": "Textbook page 30 Kural 942: 'Marunthena veandaavaam yaakkaikku arunthiyathu atrathu potrri unin'. 'Atrathu' signifies prior digestion."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["quote_completion", "thirukkural", "medicine"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

