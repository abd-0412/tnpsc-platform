{"id": "12th_tamil_mp2_q1878", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_sengonmai_justice", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அந்தணர் நூற்கும் அறத்திற்கும் ஆதியாய் நின்றது மன்னவன் கோல்’ - இக்குறள் உணர்த்தும் நீதி யாது?", "media_id": null}], "options": {"A": "மன்னன் போர்க்களத்தில் வீரனாய் இருத்தல் வேண்டும்", "B": "மன்னனின் நேர்மையான செங்கோல் ஆட்சியே அறநெறிகளுக்கும் கல்விக்கும் ஆதாரமாய் விளங்குகிறது", "C": "மன்னன் அதிக வரி விதிக்க வேண்டும்", "D": "மன்னன் பல நாடுகளை வெல்ல வேண்டும்"}, "explanation": "அரசனின் செங்கோல் முறை தவறாமல் ஆட்சி செய்தால் மட்டுமே உலகில் அறமும் அறிஞர்களின் நூல்களும் நிலைபெறும் எனச் செங்கோன்மை அதிகாரம் விளக்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "'Andhanar noorkum arathirkum aadhiyaai ninradhu mannavan kole' - What central principle of governance does this state?", "media_id": null}], "options": {"A": "The king must be fierce in battle", "B": "A monarch's righteous and impartial sceptre is the bedrock foundation of all ethical virtues and scholarship", "C": "The king should levy high taxes", "D": "The king must conquer foreign lands"}, "explanation": "The upright sceptre of a just king protects dharma and promotes arts, sciences, and sacred learning."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_mar