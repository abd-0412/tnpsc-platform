{"id": "12th_tamil_mp2_q1899", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "thirukkural_moral_synthesis", "chapter_id": null, "topic_id": "thirukkural_kannottam_world_life", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கண்ணோட்டத் துள்ளது உலகியல் அஃதின்றேல் மண்ணோட்டல் மண்ணாகி விடும்’ - இதில் உலகியலின் உயிரோட்டமாக வள்ளுவர் எதனைக் கூறுகிறார்?", "media_id": null}], "options": {"A": "செல்வத்தை", "B": "அதிகாரத்தை", "C": "கண்ணோட்டம் (இரக்கம் / மனிதநேயம்)", "D": "போராட்டத்தை"}, "explanation": "மனிதர்களிடையே உள்ள இரக்கமும் முகதாட்சணியமுமே இவ்வுலகத்தின் மனித உறவுகளை உயிர்ப்போடு வைத்திருக்கிறது; அது இல்லாவிடில் உலகம் வெறும் மண்ணாகிப் போகும்."}, "en": {"blocks": [{"type": "text", "content": "'Kannottath thulladhu ulagiyal...' - What does Valluvar identify as the very lifeblood sustaining human society?", "media_id": null}], "options": {"A": "Material wealth", "B": "Political authority", "C": "Kannottam (Benign compassion / humane empathy)", "D": "Militant struggle"}, "explanation": "Without compassionate kindness, human life degenerates into dead, lifeless dust."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edit