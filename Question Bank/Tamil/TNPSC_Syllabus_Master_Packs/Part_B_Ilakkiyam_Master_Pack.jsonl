{"id": "12th_tamil_u5_q833", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thevaaram_mayilai", "chapter_id": null, "topic_id": "sambandar_lifespan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருஞானசம்பந்தர் இவ்வுலகில் வாழ்ந்த குறுகிய கால எல்லை யாது?", "media_id": null}], "options": {"A": "பதினாறு ஆண்டுகள் (16 வயது)", "B": "முப்பத்திரண்டு ஆண்டுகள்", "C": "இருபத்தைந்து ஆண்டுகள்", "D": "எண்பத்தொரு ஆண்டுகள்"}, "explanation": "திருஞானசம்பந்தர் பதினாறே ஆண்டுகள் வாழ்ந்து, திருநல்லூர்ப் பெருமணத்தில் திருமணத்தின் போது சோதியுள் கலந்தார்."}, "en": {"blocks": [{"type": "text", "content": "What was the brief physical lifespan of child-saint Thirugnanasambandar on this earth?", "media_id": null}], "options": {"A": "Sixteen years (16 years)", "B": "Thirty-two years", "C": "Twenty-five years", "D": "Eighty-one years"}, "explanation": "Thirugnanasambandar merged into the cosmic divine effulgence at the age of sixteen."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 112, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 112", "url": null, "source_notes": null}, "previous_y