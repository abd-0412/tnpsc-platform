{"id": "11th_tamil_rev1_q020", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u2_prose_poetry", "chapter_id": null, "topic_id": "indiran_visual_art_journal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் இந்திரன் நவீனக் கலை மற்றும் இலக்கியத்தை வளர்ப்பதற்காக நடத்திய புகழ்பெற்ற இதழ்கள் எவை?", "media_id": null}], "options": {"A": "மணிக்கொடி, எழுத்து", "B": "குயில், தாமரை", "C": "கனையாழி, தீபம்", "D": "வெளிச்சம், நுண்கலை"}, "explanation": "கவிஞர் இந்திரன் கலை விமர்சனம் மற்றும் கவிதைக்காக 'வெளிச்சம்', 'நுண்கலை' முதலான அரிய இதழ்களை ஆசிரியராக இருந்து நடத்தினார்."}, "en": {"blocks": [{"type": "text", "content": "Which journals dedicated to modern aesthetic critique and poetry were edited by poet Indiran?", "media_id": null}], "options": {"A": "Manikkodi and Ezhuthu", "B": "Kuyil and Thamarai", "C": "Kanaiyaazhi and Deepam", "D": "Velicham and Nunkalai"}, "explanation": "Indiran edited the avant-garde cultural journals Velicham and Nunkalai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": "11th Tamil, Unit revisi