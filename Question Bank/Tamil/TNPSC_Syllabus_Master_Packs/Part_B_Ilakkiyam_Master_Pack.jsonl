{"id": "9th-u2-q022", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-01-neerindri-amaiyaadhu-ulagu", "chapter_id": null, "topic_id": "topic-speaker-mercy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கருத்தரங்கில் 'இன்றைய வாழ்வில் தண்ணீர்' என்ற தலைப்பில் உரையாற்றிய மாணவர் யார்?", "media_id": null}], "options": {"A": "மாணவர் முகிலன்", "B": "மாணவர் மெர்சி", "C": "மாணவர் ஆமீனா", "D": "மாணவர் வெண்மதி"}, "explanation": "பாடநூல் பக். 27: மாணவர் மெர்சி 'இன்றைய வாழ்வில் தண்ணீர்' என்னும் தலைப்பில் சமகால நீர் நெருக்கடியை விளக்கி உரையாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "In the symposium, which student addressed the audience on the topic 'Water in Contemporary Life'?", "media_id": null}], "options": {"A": "Student Mugilan", "B": "Student Mercy", "C": "Student Ameena", "D": "Student Venmathi"}, "explanation": "Student Mercy presented on 'Water in Contemporary Life' on page 27."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 27", "url": null, "source_notes": null}, "previous_year": {"is_p