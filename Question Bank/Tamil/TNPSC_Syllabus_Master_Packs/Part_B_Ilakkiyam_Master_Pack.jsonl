{"id": "6th-t1-u2-070", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "2016-ஆம் ஆண்டு ரியோ பாராலிம்பிக் போட்டியில் உயரம் தாண்டுதலில் தங்கம் வென்ற தமிழ்நாட்டைச் சேர்ந்த மாரியப்பனின் தாயார் கூறிய கூற்றோடு தொடர்புடைய திருக்குறள் எது?", "media_id": null}], "options": {"A": "செயற்கரிய செய்வார் பெரியர் சிறியர் செயற்கரிய செய்கலா தார்", "B": "ஈன்ற பொழுதின் பெரிதுவக்கும் தன்மகனைச் சான்றோன் எனக்கேட்ட தாய்", "C": "அன்பின் வழியது உயர்நிலை அஃதிலார்க்கு என்புதோல் போர்த்த உடம்பு", "D": "இனிய உளவாக இன்னாத கூறல் கனியிருப்பக் காய்கவர்ந் தற்று"}, "explanation": "பாடநூல் மதிப்பீட்டுப் பகுதி: 'அவனைப் பெற்ற பொழுதைவிட இப்போது அதிகமாக மகிழ்கிறேன்' என்று தாய் கூறியதற்குப் பொருத்தமான குறள் 'ஈன்ற பொழுதின் பெரிதுவக்கும் தன்மகனைச் சான்றோன் எனக்கேட்ட தாய்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025"