{"id": "12th_tamil_u6_q1051", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "silappathikaram_arangetru", "chapter_id": null, "topic_id": "kudimakkal_kaappiyam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அரச குடும்பத்தினரைத் தலைவராகக் கொள்ளாமல் எளிய வணிகக் குடும்பத்தைச் சேர்ந்த கோவலன்-கண்ணகியைத் தலைவர்களாகக் கொண்டதால் சிலப்பதிகாரம் எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "அரசர் காப்பியம்", "B": "சமயக் காப்பியம்", "C": "குடிமக்கள் காப்பியம்", "D": "வீரக் காப்பியம்"}, "explanation": "மன்னர்களை மட்டுமே பாட்டுடைத் தலைவனாகக் கொண்ட பழமரபை உடைத்துச் சாமானிய மக்களை முதன்மைப்படுத்தியதால் இது 'குடிமக்கள் காப்பியம்' எனப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Why is Silappathikaram acclaimed in Tamil literary criticism as 'Kudimakkal Kaappiyam' (The Citizens' Epic)?", "media_id": null}], "options": {"A": "Authored by monarchs", "B": "Purely religious liturgy", "C": "Because ordinary merchant citizens (Kovalan & Kannagi) were elevated as epic protagonists", "D": "Martial epic"}, "explanation": "It replaced royal monarchs with ordinary citizens as the epic's hero and heroine."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Co