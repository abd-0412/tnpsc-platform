{"id": "12th_tamil_mp2_q1937", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "purananooru_avvaiyar_athiyaman_weapons", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘இவ்வே பீலி அணிந்து மாலை சூட்டி... அவ்வே பகைவர்குத்தி கோடுசிதைந்து’ - ஔவையார் அதியமானின் ஆயுதங்களை எங்கே இருப்பதாகப் பாடுகிறார்?", "media_id": null}], "options": {"A": "கருமாரன் (கொல்லன்) உலையில்", "B": "அரண்மனைப் பொக்கிஷத்தில்", "C": "கோயில் திருமுற்றத்தில்", "D": "கடற்கரைக் கோட்டையில்"}, "explanation": "பகைவனின் ஆயுதங்கள் அரண்மனையில் பளபளப்பாக இருக்க, அதியமானின் ஆயுதங்களோ போர்க்களத்தில் உடைந்து கொல்லன் உலையில் செப்பனிடக் கிடக்கின்றன என ஔவையார் பாடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "In Avvaiyar's Purananooru verse comparing weapons, where do Athiyaman's battle-scarred weapons lie?", "media_id": null}], "options": {"A": "In the blacksmith's forge (Kollan ulai) undergoing repairs after fierce battle", "B": "In the royal treasury display", "C": "In the temple courtyard", "D": "In the coastal fortress"}, "explanation": "Athiyaman's dented weapons were kept in the blacksmith's smithy for repairs, while the adversary's lay polished in armories."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 85, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 85", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 7", "Avvaiyar Purananooru"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp2_q1938", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "u_ve_sa_manuscripts_palm_leaves", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உ.வே. சாமிநாதையர் சுவடி தேடிச் சென்றபோது அவருக்கு முதன்முதலில் 'சீவக சிந்தாமணி' சுவடியை அறிமுகப்படுத்திய சேலம் வழக்கறிஞர் யார்?", "media_id": null}], "options": {"A": "ஆறுமுக நாவலர்", "B": "இராமசுவாமி முதலியார்", "C": "சி.வை. தாமோதரம்பிள்ளை", "D": "பூண்டி அரங்கநாத முதலியார்"}, "explanation": "1880-இல் கும்பகோணம் கல்லூரிக்கு வந்த சேலம் முன்சீப் இராமசுவாமி முதலியார் உ.வே.சாவிடம் சீவக சிந்தாமணிச் சுவடியைத் தந்து பதிப்பிக்கத் தூண்டினார்."}, "en": {"blocks": [{"type": "text", "content": "Which Salem munsif/advocate first handed palm-leaf manuscripts of Seevaka Chinthamani to U.Ve.Sa in 1880, urging him to publish them?", "media_id": null}], "options": {"A": "Arumuga Navalar", "B": "Ramaswamy Mudaliar", "C": "C.W. Damodaram Pillai", "D": "Poondi Ranganatha Mudaliar"}, "explanation": "Salem Munsif Ramaswamy Mudaliar presented U.Ve.Sa with Seevaka Chinthamani palm leaves in 1880."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 72, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 72", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 7", "U.Ve.Sa Career"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp2_q1950", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "thirukkural_kannottam_nectar_noble", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வள்ளுவர் கூறும் நாகரிகம் உடைய சான்றோர்கள் எதனைத் தமக்குத் தரினும் புன்னகையோடு ஏற்பர்?", "media_id": null}], "options": {"A": "அமுதத்தை", "B": "நஞ்சை (விஷத்தை)", "C": "பழத்தை", "D": "பாலை"}, "explanation": "'பெயக்கண்டும் நஞ்சுண்டு அமைவர் நயத்தக்க நாகரிகம் வேண்டு பவர்' - நஞ்சையே எதிரில் இட்டாலும் கண்ணோட்டம் உடைய சான்றோர் மறுக்காமல் உண்பர்."}, "en": {"blocks": [{"type": "text", "content": "What will noble civilized individuals consume with serene grace according to Valluvar's ethic of Kannottam?", "media_id": null}], "options": {"A": "Ambrosia", "B": "Poison (Nanchu)", "C": "Sweet fruit", "D": "Fresh milk"}, "explanation": "Cultured persons imbued with graceful empathy will accept even deadly poison knowingly."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 176, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 176", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 7", "Thirukkural Benignity"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp2_q1952", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "silappathikaram_three_truths", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரம் உணர்த்தும் முப்பெரும் உண்மைகளுள் பொருந்தாதது எது?", "media_id": null}], "options": {"A": "அரசியல் பிழைத்தோர்க்கு அறங்கூற்றாவதூஉம்", "B": "உரைசால் பத்தினியை உயர்ந்தோர் ஏத்துவதூஉம்", "C": "ஊழ்வினை உருத்துவந்து ஊட்டும் என்பதூஉம்", "D": "செல்வமே உலகில் தலைசிறந்தது என்பதூஉம்"}, "explanation": "சிலப்பதிகாரப் பதிகம் உணர்த்தும் மூன்று உண்மைகள்: (1) அரசியல் பிழைத்தோர்க்கு அறங்கூற்றாவது, (2) பத்தினியை உயர்ந்தோர் ஏத்துவது, (3) ஊழ்வினை வந்து ஊட்டுவது ஆகும். செல்வம் பற்றியது இதில் இல்லை."}, "en": {"blocks": [{"type": "text", "content": "Which of the following is NOT one of the three foundational moral maxims proclaimed in the prologue of Silappathikaram?", "media_id": null}], "options": {"A": "Dharma becomes the lethal retribution for monarchs who err in justice", "B": "The virtuous chaste wife is universally worshipped by the noble", "C": "Inexorable Karma pursues and relentlessly bears fruit", "D": "Material wealth is supreme above all worldly virtues"}, "explanation": "Silappathikaram's threefold maxims are: justice avenges unjust rulers, chaste wives are venerated, and karma takes its toll."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 128, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 128", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 7", "Silappathikaram Maxims"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp2_q1955", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "thirukkural_arivudaimai_summary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சென்ற இடத்தால் செலவிடா தீதொரீஇ நன்றின்பால் உய்ப்ப தறிவு’ - இக்குறள் அறிவின் முதன்மையான செயலாக எதனைக் கூறுகிறது?", "media_id": null}], "options": {"A": "செல்வத்தை ஈட்டுவது", "B": "பல ஊர்களுக்குச் செல்வது", "C": "மனம் விரும்பும் தீய வழிகளில் செல்லவிடாமல் தடுத்து நல்வழியில் செலுத்துவது", "D": "பகைவரை அழிப்பது"}, "explanation": "மனம் போன போக்கிலெல்லாம் செல்ல விடாமல், தீமையிலிருந்து விலக்கி நன்மையான நல்வழியில் மனத்தைச் செலுத்துவதே உண்மையான அறிவுடைமையாகும்."}, "en": {"blocks": [{"type": "text", "content": "'Senra idatthaal selavidaa theedhoreei nanrinbaal uyppa dharivu' - What is the cardinal duty of intellect according to this Kural?", "media_id": null}], "options": {"A": "Amassing riches", "B": "Traveling to diverse regions", "C": "Restraining the fickle mind from straying into harmful paths and directing it toward righteous good", "D": "Vanquishing adversaries"}, "explanation": "Intellect must govern the sensory impulses, turning the mind away from evil and steering it towards virtue."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "