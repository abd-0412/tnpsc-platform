{"id": "11th_tamil_rev1_q191", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_pyq_model", "chapter_id": null, "topic_id": "pyq_kurunthogai_god_murugan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] குறுந்தொகை நூலின் கடவுள் வாழ்த்துப் பாடலில் போற்றிப் புகழப்படும் தெய்வம் எது?", "media_id": null}], "options": {"A": "சிவபெருமான்", "B": "திருமால்", "C": "முருகப்பெருமான் (பாரதம் பாடிய பெருந்தேவனார் பாடியது)", "D": "கொற்றவை"}, "explanation": "குறுந்தொகை நூலின் கடவுள் வாழ்த்துப் பாடலில் பாரதம் பாடிய பெருந்தேவனார் முருகப்பெருமானைப் போற்றிப் பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Which deity is invoked in the prefatory Kadavul Vaazhthu verse of Kurunthogai composed by Perundhevanaar?", "media_id": null}], "options": {"A": "Lord Shiva", "B": "Lord Vishnu", "C": "Lord Murugan", "D": "Goddess Kotravai"}, "explanation": "Lord Murugan is eulogized in the opening invocatory verse of Kurunthogai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 58, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_m