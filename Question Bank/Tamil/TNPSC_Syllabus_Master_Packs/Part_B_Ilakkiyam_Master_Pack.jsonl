{"id": "11th_tamil_u7_q118", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_pathitrupathu", "chapter_id": null, "topic_id": "imayavaramban_title_reason", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சேர மன்னன் நெடுஞ்சேரலாதனுக்கு 'இமயவரம்பன்' என்ற சிறப்புப் பெயர் வரக் காரணம் யாது?", "media_id": null}], "options": {"A": "இமயமலையில் பிறந்ததால்", "B": "வடதிசை நோக்கிப் படையெடுத்துச் சென்று இமயமலையைத் தன் நாட்டின் எல்லையாகக் கொண்டு, இமயத்தில் சேரரின் 'வில்' சின்னத்தைப் பொறித்ததால்", "C": "இமயமலையில் தவம் செய்ததால்", "D": "இமயத்தில் வணிகம் செய்ததால்"}, "explanation": "நெடுஞ்சேரலாதன் வடநாட்டின் மீது படையெடுத்துச் சென்று இமயமலை வரை வென்று, மலையில் சேரரின் வில் பொறித்ததால் 'இமயவரம்பன்' எனப் புகழ்பெற்றான்."}, "en": {"blocks": [{"type": "text", "content": "Why was King Neduncheralathan crowned with the exalted cognomen 'Imayavaramban'?", "media_id": null}], "options": {"A": "Born in Himalayas", "B": "Marched northward, establishing Himalayas as his boundary and engraving the Chera Bow emblem upon Himalayan rock face", "C": "Meditated in Himalayas", "D": "Traded in Himalayas"}, "explanation": "He carved the Chera bow insignia on the Himalayas, making them his northern boundary."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi