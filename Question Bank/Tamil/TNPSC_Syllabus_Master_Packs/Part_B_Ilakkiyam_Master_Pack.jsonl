{"id": "11th_tamil_rev1_q066", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_prose_poetry", "chapter_id": null, "topic_id": "kurunthogai_compiler_poorikko", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எட்டுத்தொகை நூல்களுள் ஒன்றாகிய 'குறுந்தொகை' நூலை முதன்முதலில் தொகுத்த சான்றோர் யார்?", "media_id": null}], "options": {"A": "உருத்திரசன்மர்", "B": "பூரிக்கோ", "C": "கூடலூர் கிழார்", "D": "புலத்துறை முற்றிய நக்கீரர்"}, "explanation": "குறுந்தொகையைத் தொகுத்தவர் 'பூரிக்கோ' ஆவார்; இந்நூலைத் தொகுப்பித்த மன்னனின் பெயர் அறியப்படவில்லை."}, "en": {"blocks": [{"type": "text", "content": "Who was the classical scholar responsible for compiling the Kurunthogai anthology?", "media_id": null}], "options": {"A": "Uruthirasanmar", "B": "Poorikko", "C": "Koodaloor Kizhaar", "D": "Nakkeerar"}, "explanation": "Kurunthogai was compiled by Poorikko."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 59, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 59", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "ex