{"id": "6th-t1-pyq-025", "schema_version": "1.0", "kind": "quote_completion", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியாரின் பாடலடியை நிரப்புக:\n'காணி நிலம் வேண்டும் - பராசக்தி காணி நிலம் வேண்டும்;\nதங்கு தூணில் அழகியதாய் - நன் மாடங்கள் ______ நிறத்தினதாய்'", "media_id": null}], "options": {"A": "துய்ய", "B": "செம்மை", "C": "வெண்மை", "D": "பசும்"}, "explanation": "பாரதியாரின் வரிகள்: 'காணி நிலம் வேண்டும் - பராசக்தி காணி நிலம் வேண்டும்; அங்கு தூணில் அழகியதாய் - நன் மாடங்கள் துய்ய நிறத்தினதாய்...' என்பது மூல நூல் வரிகளாகும். 'துய்ய' என்பது தூய/வெண்மையான என்ற பொருளைத் தரும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "pyq_bridging", "section": null, "reference": "TNPSC Group 4 (2013, 2016) & Bharathiyar Quotes", "url": null, "source_notes": null