{"id": "12th_tamil_u1_q169", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tnpsc_pyq_integration", "chapter_id": null, "topic_id": "bharathi_letter_place", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியார் எந்த ஊரிலிருந்து தம்பி நெல்லையப்பருக்கு 1915-ஆம் ஆண்டு கடிதம் எழுதினார்?", "media_id": null}], "options": {"A": "புதுச்சேரி", "B": "சென்னை", "C": "எட்டயபுரம்", "D": "மதுரை"}, "explanation": "மகாகவி பாரதியார் 1915-ஆம் ஆண்டு டிசம்பர் 23 அன்று புதுச்சேரியிலிருந்து தம்பி நெல்லையப்பருக்குக் கடிதம் எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "From which town did Bharathiyar write his famous letter to brother Nellaiyappar in 1915?", "media_id": null}], "options": {"A": "Puducherry", "B": "Chennai", "C": "Ettayapuram", "D": "Madurai"}, "explanation": "Bharathiyar wrote the letter from Puducherry on 23 December 1915."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 11, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 11", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 2", "exam_name": "Combin