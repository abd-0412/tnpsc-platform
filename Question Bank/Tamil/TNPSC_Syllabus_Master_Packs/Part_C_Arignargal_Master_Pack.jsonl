{"id": "11th_tamil_u6_q037", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "bronze_casting_technique", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சோழர் காலத்துச் செப்புத் திருமேனிகள் எந்த உன்னத தொழில்நுட்ப முறையில் வார்க்கப்பட்டன?", "media_id": null}], "options": {"A": "மெழுகு உருக்கி வார்ப்பு முறை (Lost-wax process / மதுச்சிஷ்ட விதானம்)", "B": "சுத்தி வார்ப்பு முறை", "C": "மணல் அச்சு முறை மட்டுமே", "D": "தகடு ஒட்டு முறை"}, "explanation": "முதலில் மெழுகினால் உருவம் செய்து, பின்னர் களிமண் பூசி, மெழுகை உருக்கி வெளியேற்றிவிட்டு உருகிய ஐம்பொன்னை ஊற்றி வார்க்கும் 'மெழுகு உருக்கி முறை'யில் இவை வார்க்கப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "Through which sophisticated metallurgic casting technique were Chola bronze sculptures created?", "media_id": null}], "options": {"A": "Lost-wax casting process (Cire perdue / Madhucchishta Vidhana)", "B": "Cold hammered technique", "C": "Crude sand casting only", "D": "Riveted sheet metal technique"}, "explanation": "Chola bronzes were cast using the precision lost-wax casting technique."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "cl