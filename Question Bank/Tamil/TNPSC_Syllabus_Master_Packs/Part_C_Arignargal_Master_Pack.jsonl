# ==============================================================================
# 6-ஆம் வகுப்பு - ஆடுமேய்க்கும் சிறுவர்கள், மயங்கி விழுந்த மாணவன், பரமக்குடி தரைப்பாலம், மதிய உணவுத் திட்டம், இலவசக் கட்டாயக் கல்வி, சீருடைத் திட்டம், 1976 பாரத ரத்னா, கல்வி வளர்ச்சி நாள் ஜூலை 15, கன்னியாகுமரி மணிமண்டபம்
# ==============================================================================
{"id": "6th-t1-u3-027", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காமராசருக்குச் செய்யப்பட்ட சிறப்புகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. மதுரைப் பல்கலைக்கழகத்திற்கு 'மதுரை காமராசர் பல்கலைக்கழகம்' எனப் பெயரிடப்பட்டது.\n2. நடுவண் அரசு 1976-இல் இவருக்குப் 'பாரத ரத்னா' விருது வழங்கிச் சிறப்பித்தது.\n3. காமராசர் வாழ்ந்த சென்னை இல்லமும் விருதுநகர் இல்லமும் அரசுடைமையாக்கப்பட்டு நினைவு இல்லங்களாக மாற்றப்பட்டன.\n4. காமராசரின் பிறந்தநாளான ஜூலை 15-ஆம் நாள் ஆண்டுதோறும் 'கல்வி வளர்ச்சி நாள்' எனக் கொண்டாடப்படுகிறது.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2 மட்டுமே சரியானவை", "B": "கூற்றுகள் 1, 2, 3 மட்டுமே சரியானவை", "C": "கூற்றுகள் 1, 2, 3, 4 ஆகிய அனைத்தும் சரியானவை", "D": "கூற்றுகள் 2, 3, 4 மட்டுமே சரியானவை"}, "explanation": "நான்கு கூற்றுகளும் பாடநூல் தெரிந்து தெளிவோம் பெட்டிச் செய்தியின்படி 100% சரியானவை."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "மதுரைப் பல்கலைக்கழகத்திற்கு 'மதுரை காமராசர் பல்கலைக்கழகம்' எனப் பெயரிடப்பட்டது.", "content_en": null}, {"id": "S2", "content_ta": "நடுவண் அரசு 1976-இல் இவருக்குப் 'பாரத ரத்னா' விருது வழங்கிச் சிறப்பித்தது.", "content_en": null}, {"id": "S3", "content_ta": "காமராசர் வாழ்ந்த சென்னை இல்லமும் விருதுநகர் இல்லமும் அரசுடைமையாக்கப்பட்டு நினைவு இல்லங்களாக மாற்றப்பட்டன.", "content_en": null}, {"id": "S4", "content_ta": "காமராசரின் பிறந்தநாளான ஜூலை 15-ஆம் நாள் ஆண்டுதோறும் 'கல்வி வளர்ச்சி நாள்' எனக் கொண்டாடப்படுகிறது.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "or