"exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-8", "ambedkar", "bharat-ratna", "direct", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

# ==============================================================================
# 8-ஆம் வகுப்பு - எழுத்தாளர் கோமகள் (ராஜலட்சுமி), தஞ்சைத் தமிழ்ப் பல்கலைக்கழகத் தமிழன்னை விருது, அன்னை பூமி நாவல், பால் மனம் சிறுகதை, கிருஷ்ணா, சித்தப்பா மாந்தர்கள், மழலை மனம், கள்ளமற்ற குழந்தைமை, சமூக பாகுபாடுகளைக் கடக்கும் மனிதநேயம்
