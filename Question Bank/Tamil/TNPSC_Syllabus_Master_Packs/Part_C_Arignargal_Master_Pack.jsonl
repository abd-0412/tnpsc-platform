{"id": "6th-t1-u1-014", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தம் கவிதைகளில் பெண்கல்வி, கைம்பெண் மறுமணம், பொதுவுடைமை, பகுத்தறிவு முதலான புரட்சிகரமான கருத்துகளைப் பாடுபொருளாகப் பாடியதால் 'புரட்சிக்கவி' என்று போற்றப்படுபவர் யார்?", "media_id": null}], "options": {"A": "பாரதியார்", "B": "பாரதிதாசன்", "C": "நாமக்கல் கவிஞர்", "D": "முடியரசன்"}, "explanation": "பெண்கல்வி, கைம்பெண் மறுமணம், பொதுவுடைமை, பகுத்தறிவு முதலான முற்போக்குக் கருத்துகளைப் பாடியதால் பாரதிதாசன் 'புரட்சிக்கவி' என்றும் 'பாவேந்தர்' என்றும் அழைக்கப்படுகிறார்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "6th Tamil, Term 1, Unit 1, Page 3", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": n