{"id": "11th_tamil_u8_q106", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_muthukumar", "chapter_id": null, "topic_id": "newton_third_law_book", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'நியூட்டனின் மூன்றாம் விதி' என்ற தலைப்பில் கவிதை நூலை இயற்றிய படைப்பாளர் யார்?", "media_id": null}], "options": {"A": "வைரமுத்து", "B": "நா. முத்துக்குமார்", "C": "இன்குலாப்", "D": "வாலி"}, "explanation": "'நியூட்டனின் மூன்றாம் விதி' நா. முத்துக்குமார் இயற்றிய சிந்தனைமிக்க கவிதைத் தொகுப்பாகும்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the poetry collection titled 'Newtonin Moondram Vidhi' (Newton's Third Law)?", "media_id": null}], "options": {"A": "Vairamuthu", "B": "Na. Muthukumar", "C": "Inquilab", "D": "Vaali"}, "explanation": "Na. Muthukumar composed the poetry book 'Newtonin Moondram Vidhi'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 186, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 186", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": n