{"id": "9th-u6-q086", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l3", "chapter_id": null, "topic_id": "nachiyar-thirumozhi-songs-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆண்டாள் இயற்றிய 'நாச்சியார் திருமொழி' மொத்தம் எத்தனை பாடல்களைக் கொண்டது?", "media_id": null}], "options": {"A": "108 பாடல்கள்", "B": "143 பாடல்கள்", "C": "30 பாடல்கள்", "D": "173 பாடல்கள்"}, "explanation": "ஆண்டாள் இயற்றிய நாச்சியார் திருமொழி மொத்தம் 143 பாடல்களைக் கொண்டது. ஆண்டாளின் மற்றொரு நூலான திருப்பாவை 30 பாடல்களைக் கொண்டது."}, "en": {"blocks": [{"type": "text", "content": "How many sacred verses (Pasurams) are compiled in Andal's 'Nachiyar Thirumozhi'?", "media_id": null}], "options": {"A": "108 verses", "B": "143 verses", "C": "30 verses", "D": "173 verses"}, "explanation": "'Nachiyar Thirumozhi' comprises 143 verses, whereas Andal's Thiruppavai contains 30 verses."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 109, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 109", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam"