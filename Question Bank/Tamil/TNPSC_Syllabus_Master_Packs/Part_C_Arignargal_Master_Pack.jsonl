{"id": "10th-u9-q092", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "story_friend_character", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குப்புசாமியின் பரிதாப நிலையைக் கண்டு அவனுக்கு மருத்துவ உதவி செய்ய முன்வரும் நண்பர் யார்?", "media_id": null}], "options": {"A": "சுப்பையா", "B": "மாரிமுத்து", "C": "இராமநாதன்", "D": "வீரராகவன்"}, "explanation": "பாடநூல் குறிப்பு: கதையின் கதைசொல்லியான வீரராகவன், குப்புசாமியின் நிலையைக் கண்டு கலங்கி அவனுக்கு உதவ முயற்சிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "Who is the compassionate friend and narrator who resolves to arrange medical care for Kuppusamy?", "media_id": null}], "options": {"A": "Subbiah", "B": "Maarimuthu", "C": "Ramanathan", "D": "Veeraraghavan"}, "explanation": "Veeraraghavan steps forward to help Kuppusamy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 206, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 206", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year":