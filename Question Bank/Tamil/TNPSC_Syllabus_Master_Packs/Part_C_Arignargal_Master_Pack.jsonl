{"id": "12th_tamil_u8_q1484", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kodai_mazhai", "chapter_id": null, "topic_id": "unit_integration", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "12-ஆம் வகுப்பு இயல் 8-இன் தலைப்பான ‘எல்லைகள் ஆயிரம்’ என்பதோடு ‘கோடை மழை’ சிறுகதை எவ்வாறு இணைகிறது?", "media_id": null}], "options": {"A": "தேச எல்லைகளை விவரிப்பதால்", "B": "விண்வெளி எல்லைகளைப் பேசுவதால்", "C": "நில எல்லைகளை அளவிடுவதால்", "D": "சாதி, வர்க்க, பிரதேச எல்லைகள் ஆயிரம் இருப்பினும் மனிதநேய அன்பு அவை அனைத்தையும் கடந்து மனிதர்களை இணைக்கும் என்பதை நிறுவுவதால்"}, "explanation": "மனிதர்களைப் பிரிக்கும் எல்லைகள் ஆயிரம் இருந்தாலும், மனிதநேயம் என்னும் ஒற்றைப் பெருமழை அந்த எல்லைகளைக் கரைத்து மனிதர்களை ஒன்று சேர்க்கிறது."}, "en": {"blocks": [{"type": "text", "content": "How does the short story 'Kodai Mazhai' integrate into the overarching Unit 8 theme 'Ellaigal Aayiram' (Thousand Boundaries)?", "media_id": null}], "options": {"A": "By charting geopolitical territorial borders", "B": "By exploring outer space cosmic horizons", "C": "By surveying agricultural land boundaries", "D": "By demonstrating that though thousands of caste, class, and territorial boundaries divide humans, compassionate empathy dissolves all barriers"}, "explanation": "It embodies the theme by showing how empathetic love dissolves all artificial divisions and boundaries."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 208, "chapter": null, "section": null, "reference": "12th Tamil, Unit 8, Page 208", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 8", "Supplementary", "Unit Theme Integration"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

