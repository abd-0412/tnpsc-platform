{"id": "11th_tamil_u2_q076", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_thirumalai_murugan_pallu", "chapter_id": null, "topic_id": "meaning_kulaam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘குலாம்’ என்ற சொல்லின் பொருள் யாது?", "media_id": null}], "options": {"A": "தனிமை", "B": "நெருப்பு", "C": "கடற்கரை", "D": "கூட்டம் (கூட்டமாய் மொய்த்தல்)"}, "explanation": "குலாம் என்றால் வண்டுகளோ அல்லது பறவைகளோ திரளாகக் கூடும் 'கூட்டம்' என்று பொருள்படும்."}, "en": {"blocks": [{"type": "text", "content": "What does the classical word 'Kulaam' mean in the poem?", "media_id": null}], "options": {"A": "Isolation", "B": "Blaze", "C": "Seashore", "D": "Flock / Swarm (Gathered assemblage)"}, "explanation": "'Kulaam' denotes a gathered assemblage, flock, or swarm."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 28, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 28", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items":