{"id": "10th-u7-q040", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "marshal_nesamony_memorial", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மார்ஷல் ஏ. நேசமணி அவர்களின் நினைவைப் போற்றும் வகையில் தமிழக அரசால் மணிமண்டபமும் சிலையும் எங்கு அமைக்கப்பட்டுள்ளன?", "media_id": null}], "options": {"A": "சென்னையில்", "B": "மதுரையில்", "C": "திருநெல்வேலியில்", "D": "நாகர்கோவிலில்"}, "explanation": "தெற்கெல்லைப் போராட்ட நாயகன் மார்ஷல் ஏ. நேசமணிக்குக் கன்னியாகுமரி மாவட்டத் தலைநகரான நாகர்கோவிலில் மணிமண்டபமும் முழு உருவச் சிலையும் அமைக்கப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Where has the Government of Tamil Nadu erected a memorial hall and statue to commemorate Marshal A. Nesamony?", "media_id": null}], "options": {"A": "In Chennai", "B": "In Madurai", "C": "In Tirunelveli", "D": "In Nagercoil (Kanyakumari District)"}, "explanation": "A memorial hall and statue honor Marshal Nesamony in Nagercoil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 153, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page