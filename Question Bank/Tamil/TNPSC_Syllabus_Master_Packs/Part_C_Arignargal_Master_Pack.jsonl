{"id": "10th-u9-q112", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "universal_theme", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"ஒருவன் இருக்கிறான்\" கதையின் வாயிலாகத் தமிழ்ச் சமூகம் பெற வேண்டிய முதன்மையான படிப்பினை யாது?", "media_id": null}], "options": {"A": "செல்வத்தைச் சேமிக்க வேண்டும்", "B": "நோயாளிகளிடமிருந்து விலகி ஓட வேண்டும்", "C": "நகரத்திற்கு இடம்பெயர வேண்டும்", "D": "துன்பப்படும் எளிய மனிதர்களை மனிதநேயத்தோடு அணுகி, எந்த நிலையிலும் கருணையை இழக்காமல் வாழ்வது"}, "explanation": "பாடநூல் முடிவுரை: மனிதன் சக மனிதனை நேசிப்பதும், எந்த வறுமையிலும் ஜீவகாருண்யத்தைக் கைவிடாமல் இருப்பதுமே மனிதப் பிறவியின் பேறு."}, "en": {"blocks": [{"type": "text", "content": "What enduring moral lesson should society imbibe from \"Oruvan Irukkiran\"?", "media_id": null}], "options": {"A": "Amass material fortunes", "B": "Flee from afflicted patients", "C": "Migrate to urban centers", "D": "Approaching suffering souls with unconditional humanism and never relinquishing compassion"}, "explanation": "Embracing afflicted human beings with compassionate empathy under all circumstances."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 206, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 206", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["ஒருவன் இருக்கிறான்", "படிப்பினை", "மனிதநேயம்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

