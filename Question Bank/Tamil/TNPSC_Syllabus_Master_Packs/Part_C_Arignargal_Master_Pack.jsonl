{"id": "9th-u8-q084", "schema_version": "1.0", "kind": "conceptual", "level": "analysis", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l2", "chapter_id": null, "topic_id": "pitchamurthi-free-verse-true-false", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புதுக்கவிதை மற்றும் ந. பிச்சமூர்த்தி பற்றிய கூற்றுகளை ஆராய்க:\nI. ந. பிச்சமூர்த்தி புதுக்கவிதையின் தந்தை எனப் போற்றப்படுகிறார்.\nII. இவரது புனைப்பெயர் 'ரேவதி' என்பதாகும்.\nIII. இவர் சங்க காலப் புலவர் ஆவார்.", "media_id": null}], "options": {"A": "கூற்று I, II, III அனைத்தும் சரி", "B": "கூற்று I மட்டும் சரி", "C": "கூற்று II மட்டும் சரி", "D": "கூற்று I, II சரி; கூற்று III தவறு (இருபதாம் நூற்றாண்டு நவீனக் கவிஞர்)"}, "explanation": "கூற்று I மற்றும் II சரி. கூற்று III தவறு; ஏனெனில் ந. பிச்சமூர்த்தி 20-ஆம் நூற்றாண்டில் வாழ்ந்த நவீன இலக்கியவாதி ஆவார் (சங்க காலப் புலவர் அன்று)."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Na. Pitchamurthi:\nI. He is venerated as the Father of Modern Tamil Free Verse.\nII. His pseudonym is 'Revathi'.\nIII. He was an ancient Sangam poet.", "media_id": null}], "options": {"A": "Statements I, II, and III are all correct", "B": "Only statement I is correct", "C": "Only statement II is correct", "D": "Statements I and II are correct; statement III is incorrect (He was a 20th-century modern writer)"}, "explanation": "Statements I and II are factual. Statement III is false because Pitchamurthi was a 20th-century modern writer."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 168, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 168", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_8", "pitchamurthi", "analytical_check"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

