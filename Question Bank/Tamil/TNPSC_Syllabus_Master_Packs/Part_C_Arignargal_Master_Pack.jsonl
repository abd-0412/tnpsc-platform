{"id": "9th-u4-q054", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u4-kalvi", "lesson_id": "lesson-01-kalviyil-sirantha-pengal", "chapter_id": null, "topic_id": "topic-kalviyil-sirantha-pengal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மூவலூர் ராமாமிர்தம் அம்மையார் உயர்கல்வி உறுதித் திட்டத்தின் (புதுமைப் பெண் திட்டம்) கீழ் மாணவிகள் பயன்பெற அரசுப் பள்ளிகளில் எந்தெந்த வகுப்புகளில் படித்திருக்க வேண்டும்?", "media_id": null}], "options": {"A": "1 முதல் 12-ஆம் வகுப்பு வரை", "B": "6 முதல் 12-ஆம் வகுப்பு வரை", "C": "9 முதல் 12-ஆம் வகுப்பு வரை", "D": "11 மற்றும் 12-ஆம் வகுப்பு மட்டும்"}, "explanation": "பாடநூல் பக்க எண் 83 குறிப்பு: இத்திட்டத்தின் கீழ் அரசுப் பள்ளிகளில் 6-ஆம் வகுப்பு முதல் 12-ஆம் வகுப்பு வரை பயின்று உயர்கல்வி சேரும் மாணவிகளுக்கு மாதம் ரூ.1,000 வழங்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "To qualify for the Pudhumai Penn Higher Education Assurance Scheme, in which grades must the girl student have studied in government schools?", "media_id": null}], "options": {"A": "Grade 1 to Grade 12", "B": "Grade 6 to Grade 12", "C": "Grade 9 to Grade 12", "D": "Grades 11 and 12 only"}, "explanation": "The official eligibility criterion requires the student to have studied continuously from Grade 6 to Grade 12 in Tamil Nadu Government schools."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": 