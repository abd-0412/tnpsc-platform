{"id": "8th-u5-q644", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l3", "chapter_id": null, "topic_id": "bus-body-building-karur", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்நாட்டில் பேருந்துக் கட்டுமானத் தொழிலின் (Bus Body Building) தலைசிறந்த சிகரமாக விளங்கும் மாவட்டம் எது?"}], "options": {"A": "சேலம்", "B": "திருப்பூர்", "C": "ஈரோடு", "D": "கரூர்"}, "explanation": "பாடநூல் பக். 100: 'பேருந்துக் கட்டுமானத் தொழிலின் சிகரமாகக் கரூர் விளங்குகிறது'."}, "en": {"blocks": [{"type": "text", "content": "Which district stands as the paramount apex of the bus body building industry in Tamil Nadu?"}], "options": {"A": "Salem", "B": "Tiruppur", "C": "Erode", "D": "Karur"}, "explanation": "Textbook Page 100 explicitly declares: 'Karur stands as the pinnacle of the bus body building industry'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 100, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "