{"id": "11th_tamil_u3_q034", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kaavadichindu", "chapter_id": null, "topic_id": "musical_folk_tradition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காவடிச்சிந்தின் முதன்மையான நோக்கம் யாது?", "media_id": null}], "options": {"A": "அரண்மனை நாடகங்களில் நடிப்பது", "B": "முருகனுக்குக் காவடி சுமந்து செல்லும் பக்தர்கள் வழிநடையின் களைப்புத் தெரியாமல் இருக்க பாடி ஆடுதல்", "C": "போரில் எதிரிகளை அச்சுறுத்துவது", "D": "கப்பல் வணிகக் கணக்குகள் போடுவது"}, "explanation": "காவடி ஏந்திப் பாதயாத்திரை செல்லும் பக்தர்கள் நெடுந்தொலைவு நடையின் உடல் அசதியை மறந்து பக்திப் பரவசத்தோடு ஆட இச்சிந்து பாடப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the primary traditional functional purpose of singing Kaavadichindu?", "media_id": null}], "options": {"A": "Court palace theatrical dramas", "B": "Relieving the physical fatigue of pilgrims carrying Kaavadi on foot journeys through ecstatic rhythmic singing", "C": "Terrifying enemies on battlefields", "D": "Maritime trade ledger audits"}, "explanation": "Kaavadichindu's electric rhythm relieves pilgrim fatigue during long foot pilgrimages."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook