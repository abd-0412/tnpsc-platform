{"id": "7th-t1-u3-248", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l1-vidudhalai-thirunaal", "chapter_id": null, "topic_id": "odd-meera-work", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் மீரா இயற்றிய நூல்களுள் பொருந்தாத ஒன்றைத் தேர்ந்தெடுக்க:"}], "options": {"A": "ஊசிகள்", "B": "குக்கூ", "C": "மூன்றும் ஆறும்", "D": "மலைக்கள்ளன்"}, "explanation": "பாடநூல் விளக்கம்: 'மலைக்கள்ளன்' என்னும் புதினத்தை எழுதியவர் நாமக்கல் கவிஞர் வெ. இராமலிங்கனார் ஆவார்; மற்றவை அனைத்தும் கவிஞர் மீராவின் கவிதை நூல்கள். எனவே D பொருந்தாத ஒன்று."}, "en": {"blocks": [{"type": "text", "content": "Identify the book that was NOT authored by poet Meera:"}], "options": {"A": "Oosigal", "B": "Kuckoo", "C": "Moondrum Aarum", "D": "Malaikkallan (தவறு: இது நாமக்கல் கவிஞரின் நூல்)"}, "explanation": "Textbook explanation: 'Malaikkallan' was authored by Namakkal Kavignar; all other volumes were penned by poet Meera."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 49, "chapter": null, "section": null, "reference": null, "url": null, "sourc