{"id": "12th_tamil_u6_q983", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thiraimozhi", "chapter_id": null, "topic_id": "charlie_chaplin_gold_rush", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கடும் குளிரிலும் பசியிலும் வாடும்போது தன் காலணியை வேகவைத்து உண்பது போன்ற உலகப் புகழ்பெற்ற காட்சி இடம்பெற்ற சாப்ளினின் திரைப்படம் எது?", "media_id": null}], "options": {"A": "தி கிட் (The Kid)", "B": "மாடர்ன் டைம்ஸ் (Modern Times)", "C": "தி கோல்ட் ரஷ் (The Gold Rush - 1925)", "D": "தி கிரேட் டிக்டேட்டர் (The Great Dictator)"}, "explanation": "1925-இல் வெளியான ‘தி கோல்ட் ரஷ்’ திரைப்படத்தில், பசியின் கொடுமையால் சாப்ளின் தன் பூட்ஸ் காலணியை வேகவைத்து உண்ணும் நகைச்சுவை கலந்த சோகக் காட்சி இடம்பெற்றுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "In which classic 1925 silent masterpiece does Charlie Chaplin famously boil and eat his own leather boot due to extreme starvation?", "media_id": null}], "options": {"A": "The Kid", "B": "Modern Times", "C": "The Gold Rush (1925)", "D": "The Great Dictator"}, "explanation": "Chaplin's iconic boot-eating scene is featured in his masterpiece 'The Gold Rush' (1925)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation"