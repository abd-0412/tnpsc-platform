{"id": "6th-t3-u3-011", "schema_version": "1.0", "kind": "match_4x4", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சொற்களைப் பிரித்துப் பொருத்துக:\n(a) நேரிடை - 1. நீள் + நிலம்\n(b) எவர்க்கும் - 2. நேர் + இடை\n(c) நீள்நிலம் - 3. இன் + உயிர்\n(d) இன்னுயிர் - 4. எவர் + உம்", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-1, (c)-4, (d)-3", "C": "(a)-2, (b)-4, (c)-1, (d)-3", "D": "(a)-4, (b)-3, (c)-2, (d)-1"}, "explanation": "நேரிடை = நேர் + இடை; எவர்க்கும் = எவர் + உம் (உம்மை); நீள்நிலம் = நீள் + நிலம்; இன்னுயிர் = இனிமை + உயிர் (இன் + உயிர்)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L_A", "content_ta": "நேரிடை", "content_en": null}, {"id": "L_B", "content_ta": "எவர்க்கும்", "content_en": null}, {"id": "L_C", "content_ta": "நீள்நிலம்", "content_en": null}, {"id": "L_D", "content_ta": "இன்னுயிர்", "content_en": null}], "right": [{"id": "R1", "content_ta": "நீள் + நிலம்", "content_en": null}, {"id": "R2", "content_ta": "நேர் + இடை", "content_en": null}, {"id": "R3", "content_ta": "இன் + உயிர்", "content_en": null}, {"id": "R4", "content_ta": "எவர் + உம்", "content_en": null}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_a