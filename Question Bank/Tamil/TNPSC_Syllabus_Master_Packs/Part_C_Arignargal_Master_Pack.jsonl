{"id": "11th_tamil_u3_q048", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kaavadichindu", "chapter_id": null, "topic_id": "core_legacy_kaavadi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காவடிச்சிந்து இலக்கியம் தமிழ்க் கலாச்சாரத்திற்கு வழங்கிய மாபெரும் கொடை யாது?", "media_id": null}], "options": {"A": "மக்களைத் தனிமைப்படுத்தியது", "B": "சாதிய வேறுபாடுகளை வளர்த்தது", "C": "போர்களை ஆதரித்தது", "D": "பக்தியையும், நாட்டுப்புற இசையையும் ஒன்றிணைத்து சாதிமத பேதமின்றி மக்கள் ஒன்றாகப் பாடி ஆடும் மக்கள் இலக்கிய மரபை உருவாக்கியது"}, "explanation": "காவடிச்சிந்து பக்தி இயக்கத்தையும் நாட்டுப்புற இசையையும் மக்கள் இலக்கியமாக மாற்றிப் பாமரரையும் பரவசப்படுத்திய மாபெரும் பண்பாட்டுச் சாதனையாகும்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the supreme cultural gift bequeathed by Kaavadichindu to Tamil heritage?", "media_id": null}], "options": {"A": "Isolated human communities", "B": "Deepened feudal sectarianism", "C": "Glorified imperial warfare", "D": "Democratized devotional ecstasy, uniting classical poetry with folk melody for universal mass participation"}, "explanation": "It democratized devotional music, uniting people in ecstatic community singing."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi