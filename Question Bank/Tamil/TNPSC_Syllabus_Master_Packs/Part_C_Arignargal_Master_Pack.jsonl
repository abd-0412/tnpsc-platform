{"id": "11th_tamil_u2_q015", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "prose_iyarkai_velanmai", "chapter_id": null, "topic_id": "amirthakaraisal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயற்கை வேளாண்மையில் பயிர்களுக்கு உயிரூட்டும் மற்றொரு முதன்மை திரவக் கரைசல் எது?", "media_id": null}], "options": {"A": "டி.டி.டி. கரைசல்", "B": "யூரியா கரைசல்", "C": "அமிர்தக் கரைசல் (சாணம் + கோமியம் + வெல்லம் + நீர்)", "D": "மலாத்தியான் கரைசல்"}, "explanation": "சாணம், கோமியம், நாட்டுச் சர்க்கரை அல்லது வெல்லம் ஆகியவற்றை நீரில் கலந்து நொதிக்க வைத்துத் தயாரிக்கப்படும் 'அமிர்தக் கரைசல்' பயிர்களை விரைந்து வளர்க்கும்."}, "en": {"blocks": [{"type": "text", "content": "Which natural microbial liquid formulation is celebrated for revitalizing crop health in organic farming alongside Panchagavya?", "media_id": null}], "options": {"A": "DDT solution", "B": "Urea solution", "C": "Amirtha Karaisal (Dung + cow urine + jaggery + water)", "D": "Malathion emulsion"}, "explanation": "'Amirtha Karaisal' is prepared by fermenting fresh cow dung, urine, and jaggery in water."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2