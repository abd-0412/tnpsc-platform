{"id": "11th_tamil_u2_q119", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "supplementary_yanai_doctor", "chapter_id": null, "topic_id": "elephant_surgery_scene", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சீழ்பிடித்து அழுகிய நிலையில் உள்ள யானையின் காலை டாக்டர் கே சிகிச்சையளிக்கும் போது வெளிப்படும் காட்சி உணர்த்துவது யாது?", "media_id": null}], "options": {"A": "டாக்டரின் பணம் ஈட்டும் ஆசை", "B": "யானையின் பழிவாங்கும் குணம்", "C": "டாக்டரின் எல்லையற்ற துணிவும், வலியிலும் சிகிச்சைக்காக அமைதியாய் நிற்கும் காட்டு யானையின் விவரிக்க முடியாத மனிதநேய நம்பிக்கையும்", "D": "காட்டை விட்டு ஓடுதல்"}, "explanation": "மரண வலியிலும் தன்னை ஆற்றுப்படுத்தும் மருத்துவரிடம் ஒரு குழந்தை போல காட்டு யானை சரணடையும் நெகிழ்ச்சியான உயிர்ப்பிணைப்பை இது காட்டுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What profound bond is revealed when Dr. K performs excruciating surgery on the gangrenous footpad of a wild elephant?", "media_id": null}], "options": {"A": "The doctor mercenary greed", "B": "Vindictive wrath of the elephant", "C": "The doctor fearless compassion and the wild beast intuitive, child-like surrender to healing touch despite excruciating pain", "D": "Fleeing the forest"}, "explanation": "It portrays the sacred intuitive trust between the suffering wild behemoth and the compassionate healer."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_