{"id": "9th-u3-q075", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-02-manimekalai", "chapter_id": null, "topic_id": "topic-manimekalai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சீத்தலைச் சாத்தனார் 'கூல வாணிகம்' செய்து வந்தார்; இதில் 'கூலம்' என்பது எதனைக் குறிக்கும்?", "media_id": null}], "options": {"A": "தங்கம் / பொன்", "B": "ஆடை / பட்டு", "C": "தானியம் (எட்டு வகை உணவுத் தானியங்கள்)", "D": "முத்து / பவளம்"}, "explanation": "பாடநூல் குறிப்பு: 'கூல வாணிகம் (கூலம் - தானியம்) செய்தவர். இக்காரணங்களால் இவர் மதுரைக் கூலவாணிகன் சீத்தலைச் சாத்தனார் என்று அழைக்கப்பட்டார்.'"}, "en": {"blocks": [{"type": "text", "content": "Seethalai Saathanaar engaged in 'Koola Vaanigam'; what does 'Koolam' designate?", "media_id": null}], "options": {"A": "Gold bullion", "B": "Silk textiles", "C": "Food grains / cereals (Dhanyam)", "D": "Pearls and corals"}, "explanation": "Textbook gloss: 'Koolam means food grain (cereals/pulses)'. Dealing in grain trade, he earned the prefix Koolavaanigan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 56", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_3", "manimekalai", "seethalai_saathanaar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
