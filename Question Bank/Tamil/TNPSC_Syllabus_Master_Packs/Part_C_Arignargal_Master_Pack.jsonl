{"id": "11th_tamil_rev1_q171", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_pyq_model", "chapter_id": null, "topic_id": "pyq_kurunthogai_devakulathar_first_line", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] \"நிலத்தினும் பெரிதே வானினும் உயர்ந்தன்று\nநீரினும் ஆரள வின்றே...\"\n- இப்பாடல் வரிகள் இடம்பெற்றுள்ள சங்க நூல் மற்றும் பாடிய புலவர் யார்?", "media_id": null}], "options": {"A": "நற்றிணை - கபிலர்", "B": "அகநானூறு - பரணர்", "C": "குறுந்தொகை (பாடல் 3) - தேவகுலத்தார்", "D": "ஐங்குறுநூறு - பேயனார்"}, "explanation": "தலைவனின் அன்பை நிலத்தை விடப் பெரியதாகவும், வானை விட உயர்ந்ததாகவும், கடலை விட ஆழமானதாகவும் போற்றும் இப்பாடல் குறுந்தொகையில் தேவகுலத்தாரால் பாடப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Identify the Sangam work and poet of the verse 'Nilathinum Peridhae Vaaninum Uyarndhandru Neerinum Aarala Vindrae':", "media_id": null}], "options": {"A": "Natrinai - Kapilar", "B": "Akananuru - Paranar", "C": "Kurunthogai (Song 3) - Devakulathaar", "D": "Aingurunooru - Peyanaar"}, "explanation": "Devakulathaar composed this immortal verse in Kurunthogai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Ser