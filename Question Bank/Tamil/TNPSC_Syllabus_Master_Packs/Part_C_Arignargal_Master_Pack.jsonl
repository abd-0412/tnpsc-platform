{"id": "12th_tamil_u1_q177", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tnpsc_pyq_integration", "chapter_id": null, "topic_id": "thandiyalankaram_iyals", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தண்டியலங்காரத்தில் அமைந்துள்ள மொத்த இயல்களின் எண்ணிக்கை மற்றும் பெயர்கள் எவை?", "media_id": null}], "options": {"A": "மூன்று இயல்கள் (பொதுவணியியல், பொருளணியியல், சொல்லணியியல்)", "B": "நான்கு இயல்கள் (எழுத்து, சொல், பொருள், யாப்பு)", "C": "இரண்டு இயல்கள் (அகவணியியல், புறவணியியல்)", "D": "ஐந்து இயல்கள் (எழுத்து, சொல், பொருள், யாப்பு, அணி)"}, "explanation": "தண்டியலங்காரம்: 1. பொதுவணியியல், 2. பொருளணியியல், 3. சொல்லணியியல் என மூன்று இயல்களைக் கொண்ட அணி இலக்கண நூலாகும்."}, "en": {"blocks": [{"type": "text", "content": "What are the number and names of the chapters (iyals) in Thandiyalankaram?", "media_id": null}], "options": {"A": "Three sections: Podhuvaniyiyal, Porulaniyiyal, Sollaniyiyal", "B": "Four sections", "C": "Two sections", "D": "Five sections"}, "explanation": "Thandiyalankaram is divided into 3 chapters: Podhuvaniyiyal, Porulaniyiyal, and Sollaniyiyal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "e