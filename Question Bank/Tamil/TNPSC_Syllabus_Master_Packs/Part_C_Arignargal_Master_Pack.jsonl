{"id": "12th_tamil_mp1_q1621", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "rumi_acceptance_philosophy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜலாலுத்தீன் ரூமி மனிதர்களுக்குப் புகட்டும் வாழ்க்கை அணுகுமுறை எத்தகையது?", "media_id": null}], "options": {"A": "எதிர்மறை உணர்வுகளையும், துயரங்களையும் கூட ஒரு வழிகாட்டியாக ஏற்று இன்முகத்தோடு வரவேற்பது", "B": "துன்பம் வந்தால் தற்கொலை செய்துகொள்வது", "C": "மற்றவர்களை ஏமாற்றி வாழ்வது", "D": "உலகைத் துறந்து குகையில் வாழ்வது"}, "explanation": "ரூமியின் சூஃபி பார்வை துயரங்களையும் வாழ்க்கையின் மேலான பாடங்களாக மதித்து இன்முகத்தோடு ஏற்குமாறு போதிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What transformative existential attitude does Jalaluddin Rumi inculcate in 'The Guest House'?", "media_id": null}], "options": {"A": "Welcoming even negative emotions, sorrows, and shame with gratitude as divine scouts guiding the soul", "B": "Despairing into self-destruction", "C": "Deceiving others for gain", "D": "Renouncing society for cave hermitage"}, "explanation": "He advocates welcoming every sorrow and difficulty with hospitality, viewing them as guides clearing space for new joy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 48, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 48", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 2", "Sufi Wisdom"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp1_q1624", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "mock2_grand_synthesis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல்கள் 2 & 3 ஒருங்கிணைப்பு உணர்த்தும் முழுமையான பண்பாட்டு விழுமியம் யாது?", "media_id": null}], "options": {"A": "பொருளாதார ஏற்றத்தாழ்வை நியாயப்படுத்துதல்", "B": "சுயநலமாக வாழ்வது", "C": "மொழியைப் புறக்கணிப்பது", "D": "குடும்ப உறவுகளின் புனிதத்தைப் பேணுதல், மனித சமத்துவம், சூஃபி ஞானத்தின் ஏற்பு நெறி மற்றும் நிலத்தோடு இணைந்த உழைப்பு அறம்"}, "explanation": "இயல்கள் 2 & 3 மனித உறவுகளின் மேன்மை, விருந்தோம்பல், கம்பரின் மானுட ஒருமைப்பாடு, பூமணியின் மண்வாசம் ஆகியவற்றை ஒருங்கே தொகுத்துரைக்கின்றன."}, "en": {"blocks": [{"type": "text", "content": "What overarching cultural ethos is articulated through the synoptic integration of Units 2 and 3?", "media_id": null}], "options": {"A": "Justifying economic inequalities", "B": "Cultivating selfish individualism", "C": "Neglecting linguistic heritage", "D": "Cherishing sacred familial bonds, egalitarian fraternity, Sufi psychological acceptance, and sacred agrarian peasant ethics"}, "explanation": "Units 2 and 3 synthesize human family cohesion, cosmic fraternity, psychological emotional balance, and land ethics."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 65, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 65", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 2", "Grand Synthesis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

