{"id": "6th-t1-u2-052", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): சாண்டியாகோ கடலில் மீன் கிடைக்காத விரக்தியில் 84-ஆம் நாளே தற்கொலை செய்து கொண்டார்.\nகாரணம் (R): சாண்டியாகோவிற்கு உதவிகள் செய்ய மனோலின் என்னும் சிறுவன் ஒருநாளும் வரவில்லை.", "media_id": null}], "options": {"A": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு.", "B": "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "கூற்று, காரணம் இரண்டும் கதையின்படி முற்றிலும் தவறானவை. சாண்டியாகோ 85-ஆம் நாள் சென்று மீன் பிடித்தார்; மனோலின் முதல் 40 நாள்கள் அவருடன் வந்தான்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "சாண்டியாகோ கடலில் மீன் கிடைக்காத விரக்தியில் 84-ஆம் நாளே தற்கொலை செய்து கொண்டார்.", "reason": "சாண்டியாகோவிற்கு உதவிகள் செய்ய மனோலின் என்னும் சிறுவன் ஒருநாளும் வரவில்லை.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "6th Tamil, Term 1, Unit 2, Page 27, 28", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u2-053", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சாண்டியாகோ கரை திரும்பிய நிகழ்வு குறித்த கூற்றுகளை ஆராய்க:\n1. வேட்டையாடப்பட்ட மீனைப் படகில் ஏற்ற முடியாததால் அதன் பக்கவாட்டில் சாண்டியாகோ கட்டினார்.\n2. மீனின் ரத்த வாடையை முகர்ந்து வந்த சுறா மீன்கள் மாலின் மீனைத் தின்று தீர்த்தன.\n3. கரைக்கு வந்தடைந்த போது மீனின் எலும்புக் கூடும் தலையும் மட்டுமே மிஞ்சியிருந்தன.\n4. இதனைக் கண்ட மனோலின் சாண்டியாகோவை மீன்பிடிக்கத் தகுதியற்றவர் என்று ஏளனம் செய்தான்.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2, 3 ஆகியவை சரியானவை; 4 தவறானது", "B": "கூற்றுகள் 1, 2, 4 ஆகியவை சரியானவை; 3 தவறானது", "C": "கூற்றுகள் 2, 3, 4 ஆகியவை சரியானவை; 1 தவறானது", "D": "கூற்றுகள் அனைத்தும் சரியானவை"}, "explanation": "கூற்றுகள் 1, 2, 3 சரியானவை. கூற்று 4 தவறானது; மனோலின் சாண்டியாகோவை ஏளனம் செய்யவில்லை; மாறாக 'உன் திறமையும் விடாமுயற்சியும் வென்றுவிட்டது தாத்தா, இனி நான் உன்னோடுதான் கடலுக்கு வருவேன்' என்று பாராட்டினான்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "வேட்டையாடப்பட்ட மீனைப் படகில் ஏற்ற முடியாததால் அதன் பக்கவாட்டில் சாண்டியாகோ கட்டினார்.", "content_en": null}, {"id": "S2", "content_ta": "மீனின் ரத்த வாடையை முகர்ந்து வந்த சுறா மீன்கள் மாலின் மீனைத் தின்று தீர்த்தன.", "content_en": null}, {"id": "S3", "content_ta": "கரைக்கு வந்தடைந்த போது மீனின் எலும்புக் கூடும் தலையும் மட்டுமே மிஞ்சியிருந்தன.", "content_en": null}, {"id": "S4", "content_ta": "இதனைக் கண்ட மனோலின் சாண்டியாகோவை மீன்பிடிக்கத் தகுதியற்றவர் என்று ஏளனம் செய்தான்.", "content_en":