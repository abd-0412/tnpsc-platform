{"id": "11th_tamil_u8_q092", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_muthukumar", "chapter_id": null, "topic_id": "muthukumar_birthplace", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தொலைந்து போனவர்கள்' என்ற கவிதையை இயற்றிய கவிஞர் நா. முத்துக்குமார் எந்த மாவட்டத்தில் பிறந்தவர்?", "media_id": null}], "options": {"A": "தஞ்சாவூர்", "B": "மதுரை", "C": "கோயம்புத்தூர்", "D": "காஞ்சிபுரம் (கன்னிகாபுரம்)"}, "explanation": "நா. முத்துக்குமார் காஞ்சிபுரம் மாவட்டம் கன்னிகாபுரத்தில் 1975-ல் பிறந்தார்."}, "en": {"blocks": [{"type": "text", "content": "In which district was renowned poet and lyricist Na. Muthukumar born?", "media_id": null}], "options": {"A": "Thanjavur", "B": "Madurai", "C": "Coimbatore", "D": "Kanchipuram (Kannikapuram)"}, "explanation": "Na. Muthukumar was born in Kannikapuram, Kanchipuram district."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 185, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 185", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper