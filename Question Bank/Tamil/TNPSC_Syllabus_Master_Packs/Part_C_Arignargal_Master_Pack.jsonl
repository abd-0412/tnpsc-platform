{"id": "6th-t3-u1-026", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாஞ்சாலங்குறிச்சி நகரமைப்பு குறித்த செய்திகளை ஆராய்க:\n1. சுற்றிலும் பல சுற்றுக் கோட்டைகளும், மதில் மேல் பீரங்கி மேடைகளும் அமைந்திருந்தன.\n2. வீடுகள் தோறும் மெத்தை வீடுகளும், முத்து மணி மேடைகளும் அழகு சேர்த்தன.\n3. சோலைகளில் மாடப்புறாக்களும் குயில்களும் இன்னிசை பாடின.", "media_id": null}], "options": {"A": "1, 2 மட்டும் சரி", "B": "1, 2, 3 ஆகிய அனைத்தும் சரி", "C": "2, 3 மட்டும் சரி", "D": "1 மட்டும் சரி"}, "explanation": "பாஞ்சாலங்குறிச்சியின் கோட்டைகள், மெத்தை வீடுகள், மணி மேடைகள், சோலைகள் அனைத்தும் பாடலில் விளக்கப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "சுற்றிலும் பல சுற்றுக் கோட்டைகளும், மதில் மேல் பீரங்கி மேடைகளும் அமைந்திருந்தன.", "content_en": null}, {"id": "S2", "content_ta": "வீடுகள் தோறும் மெத்தை வீடுகளும், முத்து மணி மேடைகளும் அழகு சேர்த்தன.", "content_en": null}, {"id": "S3", "content_ta": "சோலைகளில் மாடப்புறாக்களும் குயில்களும் இன்னிசை பாடின.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": tr