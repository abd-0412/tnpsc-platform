{"id": "9th-u9-q092", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l4", "chapter_id": null, "topic_id": "vocab-kappithan-meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கதையில் மாலுமிகளால் அழைக்கப்படும் 'கப்பித்தான்' என்ற சொல் யாரைக் குறிக்கும்?", "media_id": null}], "options": {"A": "கப்பல் சமையல்காரர்", "B": "கப்பல் மருத்துவர்", "C": "துறைமுகப் பாதுகாவலர்", "D": "கப்பலின் தலைமை மாலுமி / கப்பல் தலைவர் (Captain)"}, "explanation": "'கப்பித்தான்' என்பது ஆங்கிலத்தின் 'Captain' மற்றும் போர்த்துகீசிய வழக்கிலிருந்து உருவான கடலோடிகளின் வழக்குச் சொல் ஆகும். இது கப்பலின் தலைவரைக் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "Who does the seafaring title 'Kappithaan' (கப்பித்தான்) refer to?", "media_id": null}], "options": {"A": "Ship's cook", "B": "Ship's surgeon", "C": "Harbor guard", "D": "Captain / Commander of the ship (கப்பல் தலைவர்)"}, "explanation": "'Kappithaan' corresponds to the ship's Captain."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 183, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 183", "url": null, "source