{"id": "8th-u5-q640", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u5-l3", "chapter_id": null, "topic_id": "namakkal-hills-odd", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாமக்கல் மாவட்டத்தில் அமைந்துள்ள மலைப் பகுதிகளில் சேராத ஒன்றைத் தேர்ந்தெடுக்க:"}], "options": {"A": "பச்சைமலை", "B": "கொல்லிமலை", "C": "சேர்வராயன் மலையின் ஒரு பகுதி", "D": "ஏலக்காய் மலை (ஏலமலை)"}, "explanation": "பாடநூல் பக். 100: 'பச்சைமலை, கொல்லிமலை, சேர்வராயன் மலையின் ஒரு பகுதி இம்மாவட்டத்தில் உள்ளன'. ஏலமலை (Cardamom Hills) என்பது மேற்குத் தொடர்ச்சி மலையில் தென்பகுதியில் உள்ள மலையாகும்; இது நாமக்கல் மாவட்டத்தில் அமையவில்லை."}, "en": {"blocks": [{"type": "text", "content": "Select the hill range that is NOT located within Namakkal district:"}], "options": {"A": "Pachaimalai", "B": "Kolli Hills", "C": "A portion of Shervaroy Hills", "D": "Cardamom Hills (Ela Malai)"}, "explanation": "Textbook Page 100 explicitly lists Pachaimalai, Kolli Hills, and part of the Shervaroy range in Namakkal. Cardamom Hills (Ela Malai) is located in the southern Western Ghats, not Namakkal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational 