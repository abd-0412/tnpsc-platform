{"id": "11th_tamil_u1_q139", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "supplementary_aaraam_thinai", "chapter_id": null, "topic_id": "summary_message", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஆறாம் திணை’ உணர்த்தும் முதன்மையான வரலாற்றுச் செய்தி யாது?", "media_id": null}], "options": {"A": "போர்கள் எப்போதுமே நன்மையை மட்டுமே தரும்", "B": "மனிதர்கள் வெளிநாடுகளுக்குச் செல்லவே கூடாது", "C": "புலம் பெயர்ந்தாலும் தாய்மண்ணின் நினைவும், மொழி உணர்வும், பண்பாட்டுத் தொடர்பும் ஒருபோதும் அற்றுப்போவதில்லை", "D": "பனி பிரதேசங்களில் வாழ்வது மட்டுமே பெருமை"}, "explanation": "எத்தனை கடல்களையும் பனி நிலங்களையும் கடந்து சென்றாலும், தமிழ் மக்களின் ஆன்மா தாய்மொழியோடும் பண்பாட்டு வேர்களோடும் பிணைந்தே வாழ்கிறது என்பதை இக்கதை உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What primary historical message does 'Aaraam Thinai' enshrine?", "media_id": null}], "options": {"A": "Wars produce only wholesome outcomes", "B": "Human beings must never emigrate", "C": "No matter how distant the exile, ancestral memory, linguistic pulse, and cultural kinship remain immortal", "D": "Residing in snowy tundra is life sole prestige"}, "explanation": "Regardless of territorial displacement into arctic terrain, ancestral language and roots remain indestructible."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": 