{"id": "11th_tamil_u5_q004", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "prose_anandarangar_naatkurippu", "chapter_id": null, "topic_id": "meaning_of_dubash", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிரெஞ்சு ஆட்சியில் ஆனந்தரங்கர் வகித்த ‘துவிபாஷி’ (Dubash) என்னும் பதவியின் பணி யாது?", "media_id": null}], "options": {"A": "ராணுவத் தளபதி", "B": "கப்பல் மாலுமி", "C": "வரி வசூலிப்பாளர்", "D": "இரு மொழிகள் தெரிந்த மொழிபெயர்ப்பாளர் (தலைமைத் துவிபாஷி / தலைமை மொழிபெயர்ப்பாளர்)"}, "explanation": "துவிபாஷி (துவி = இரண்டு, பாஷா = மொழி) என்பது இருமொழிகளைப் பேசி பிரெஞ்சு ஆட்சியாளர்களுக்கும் உள்ளூர் சுதேசி மக்களுக்கும் இடையே பாலமாக இருந்த தலைமை மொழிபெயர்ப்பாளர் பதவியாகும்."}, "en": {"blocks": [{"type": "text", "content": "What were the professional role and linguistic duties of the designation 'Dubash' held by Anandarangar?", "media_id": null}], "options": {"A": "Infantry Commander", "B": "Naval Helmsman", "C": "Tax Collector", "D": "Chief Court Interpreter and Diplomatic Intermediary conversant in two or more languages"}, "explanation": "'Dubash' (Dvi-bhashi) signifies an interpreter fluent in two languages acting as administrative go-between."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook a