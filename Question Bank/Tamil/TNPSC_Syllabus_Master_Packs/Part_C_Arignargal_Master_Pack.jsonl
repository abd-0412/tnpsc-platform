{"id": "9th-u6-q107", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l4", "chapter_id": null, "topic_id": "mangalyaan-adviser", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியாவின் வரலாற்றுச் சிறப்புமிக்க செவ்வாய் கிரக ஆய்வுத் திட்டமான 'மங்கள்யான்' (MOM) திட்டத்தின் ஆலோசகராகப் பணியாற்றியவர் யார்?", "media_id": null}], "options": {"A": "வளர்மதி", "B": "நம்பி நாராயணன்", "C": "மயில்சாமி அண்ணாதுரை", "D": "சதீஷ் தவான்"}, "explanation": "மயில்சாமி அண்ணாதுரை சந்திரயான் 1 திட்ட இயக்குநராகப் பணியாற்றியதோடு மட்டுமல்லாமல், 'மங்கள்யான்' விண்கலத் திட்டத்தின் முக்கிய ஆலோசகராகவும் விளங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "Who served as the Program Director / Advisor for India's historic Mars Orbiter Mission (Mangalyaan)?", "media_id": null}], "options": {"A": "Valarmathi", "B": "Nambi Narayanan", "C": "Mayilsamy Annadurai", "D": "Satish Dhawan"}, "explanation": "Dr. Mayilsamy Annadurai served as Program Director and Advisor for India's Mars Orbiter Mission."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 110, "chapter": null, "section": null, "reference": "9th Tam