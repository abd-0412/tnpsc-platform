{"id": "12th_tamil_u4_q609", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "school_opening_auspicious_day", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திண்ணைப் பள்ளிகளில் சிறுவர்களை முதன்முதலில் பள்ளியில் சேர்க்கும் தொடக்க விழா எவ்வாறு அழைக்கப்பட்டது?", "media_id": null}], "options": {"A": "வித்யாரம்பம் (ஏடு தொடங்குதல் / அட்சராப்பியாசம்)", "B": "பட்டமளிப்பு", "C": "அரங்கேற்றம்", "D": "தேர்வு"}, "explanation": "சிறுவர்களுக்கு ஏடு தொடங்கும் தொடக்க விழா ‘வித்யாரம்பம்’ அல்லது ஏடு தொடங்குதல் எனப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "What was the initiation ceremony marking a child's formal entry into literacy and schooling called?", "media_id": null}], "options": {"A": "Vidhyarambham / Eadu Thodangudhal (Initiation into Letters)", "B": "Graduation", "C": "Arangaetram", "D": "Examinations"}, "explanation": "The auspicious commencement of schooling was called Vidhyarambham or Eadu Thodangudhal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 71, "chapter": null, "section": null, "reference": "12t