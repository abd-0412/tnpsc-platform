{"id": "12th_tamil_u2_q290", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "drainage_obstacle", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வயல்களில் தேங்கிய வெள்ள நீர் வடியாமல் தடுத்த பெரும் தடை எது?", "media_id": null}], "options": {"A": "அரசாங்கத் தடை உத்தரவு", "B": "வண்டிப்பாதையின் கீழ் இருந்த மடை/மதகில் விழுந்து அடைத்துக் கொண்டிருந்த கனத்த பாறைக் கற்கள்", "C": "ஆற்றின் கரைகள் உடைந்தது", "D": "முட்புதர்கள் மூடியது"}, "explanation": "வண்டிப்பாதையின் கீழிருந்த பாலம்/மதகில் விழுந்த கனத்த பாறாங்கற்கள் நீர்வழிப்பாதையை அடைத்ததால் வெள்ளம் வடியவில்லை."}, "en": {"blocks": [{"type": "text", "content": "What physical barrier prevented the stagnant deluge from draining away from the village fields?", "media_id": null}], "options": {"A": "Official stay order by authorities", "B": "Massive granite boulders fallen into the cart track culvert sluice choking water outflow", "C": "Breach of river embankments", "D": "Dense growth of thorny brambles"}, "explanation": "Heavy boulders had collapsed into the cart track culvert sluice, totally blocking drainage flow."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "cla