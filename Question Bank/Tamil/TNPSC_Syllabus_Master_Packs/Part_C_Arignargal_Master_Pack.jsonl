{"id": "9th-u2-q067", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-02-periyapuranam", "chapter_id": null, "topic_id": "topic-periyapuranam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'நாளிகேரஞ் செருந்தி நறுமலர் நரந்தம் எங்கும்' - இதில் 'நாளிகேரம்', 'நரந்தம்' என்பவை குறிக்கும் மரங்கள் முறையே எவை?", "media_id": null}], "options": {"A": "பலா மரம், மாமரம்", "B": "ஆலமரம், அரசமரம்", "C": "தென்னை மரம், நாரத்தை மரம்", "D": "சந்தன மரம், பனைமரம்"}, "explanation": "சொல்லும் பொருளும்: நாளிகேரம் - தென்னை; நரந்தம் - நாரத்தை; செருந்தி - ஒரு வகை மலர்ச்செடி."}, "en": {"blocks": [{"type": "text", "content": "In the verse 'Naalikeranj serundhi narumalar narantham engum', what trees do 'Naalikeram' and 'Narantham' denote?", "media_id": null}], "options": {"A": "Jackfruit tree, Mango tree", "B": "Banyan tree, Peepal tree", "C": "Coconut tree, Bitter orange (citron) tree", "D": "Sandalwood tree, Palmyra palm"}, "explanation": "Glossary: 'Naalikeram' refers to coconut tree, and 'Narantham' refers to citron / bitter orange tree."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 30, "chap