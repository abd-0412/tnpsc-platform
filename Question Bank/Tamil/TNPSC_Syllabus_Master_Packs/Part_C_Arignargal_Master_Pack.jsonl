{"id": "11th_tamil_u3_q096", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "manikkodi_movement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சி. சு. செல்லப்பா எந்த வரலாற்றுச் சிறப்புமிக்க இலக்கியக் குழுவினரோடு நெருங்கிய தொடர்புடைய எழுத்தாளர்?", "media_id": null}], "options": {"A": "வானம்பாடி இயக்கம்", "B": "மறுமலர்ச்சி சங்கம்", "C": "திராவிட இயக்க எழுத்தாளர்கள்", "D": "மணிக்கொடி கால எழுத்தாளர்கள் (மணிக்கொடி பரம்பரை)"}, "explanation": "சி. சு. செல்லப்பா மணிக்கொடி இதழில் சிறுகதைகள் எழுதி இலக்கிய உலகிற்கு அறிமுகமான மணிக்கொடி பரம்பரை எழுத்தாளர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "To which legendary literary vanguard movement did C. S. Chellappa historically belong?", "media_id": null}], "options": {"A": "Vaanambadi movement", "B": "Marumalarichi Sangam", "C": "Dravidian writers", "D": "The Manikkodi Generation of literary trailblazers"}, "explanation": "Chellappa was an illustrious stalwart of the landmark Manikkodi literary renaissance."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 52, "chapter": n