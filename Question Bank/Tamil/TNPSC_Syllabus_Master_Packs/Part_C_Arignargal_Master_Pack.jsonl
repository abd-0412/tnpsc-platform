{"id": "10th-u3-q041", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "virunthu_potruthum", "chapter_id": null, "topic_id": "food_tradition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழர் விருந்தில் இலையின் இடப்பக்கம் வைக்கப்படும் \"பச்சடி, ஊறுகாய்\" முதலியவற்றின் சுவை நோக்கம் யாது?", "media_id": null}], "options": {"A": "நாவின் சுவை அரும்புகளைத் தூண்டி, செரிமானத்திற்கு உதவுதல்", "B": "வயிற்றை நிரப்புதல்", "C": "அலங்காரம் செய்தல் மட்டுமே", "D": "உணவை வேகமாக உண்ணச் செய்தல்"}, "explanation": "உப்பு, புளிப்பு, காரம் கலந்த பச்சடி மற்றும் ஊறுகாய் உமிழ்நீரைச் சுரக்கச் செய்து உணவை எளிதில் செரிக்கத் தூண்டுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What physiological purpose do sour, salty pickles and pacchadi served on the left side serve?", "media_id": null}], "options": {"A": "Stimulating salivary enzymes and priming digestive secretions", "B": "Filling the stomach", "C": "Mere visual decoration", "D": "Forcing rapid swallowing"}, "explanation": "They awaken the taste buds and stimulate salivation to ease digestion."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 5