{"id": "8th-booster-q1257", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-booster-bridging", "lesson_id": "8th-booster-pyq", "chapter_id": null, "topic_id": "pyq-quote-completion-bharathiyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அடிக்கோடிட்ட தொடரை நிரப்புக (TNPSC PYQ):\n\"வாழ்க நிரந்தரம் வாழ்க தமிழ்மொழி ______ வாழியவே!\""}], "options": {"A": "வாழிய", "B": "என்றும்", "C": "நாளும்", "D": "வானம்"}, "explanation": "பாடநூல் பக். 3 & TNPSC பலமுறை வினா: பாரதியாரின் பாடல் வரி: 'வாழ்க நிரந்தரம் வாழ்க தமிழ்மொழி வாழிய வாழியவே!'. விடுபட்ட சொல் 'வாழிய'."}, "en": {"blocks": [{"type": "text", "content": "Complete the verse from TNPSC past papers:\n\"Vaazhga nirantharam vaazhga Thamizhmozhi ______ vaazhiyavae!\":"}], "options": {"A": "Vaazhiya", "B": "Endrum", "C": "Naalum", "D": "Vaanam"}, "explanation": "Textbook Page 3 & TNPSC recurrent question: Bharati's anthem reads 'Vaazhga nirantharam vaazhga Thamizhmozhi vaazhiya vaazhiyavae!'. The missing word is 'Vaazhiya'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 3, "chapter": null, "