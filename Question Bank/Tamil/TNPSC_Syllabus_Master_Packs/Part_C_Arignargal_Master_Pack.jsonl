{"id": "11th_tamil_u3_q018", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "prose_malai_idappeyargal", "chapter_id": null, "topic_id": "korkai_vanji_in_odisha", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வடகிழக்கு மற்றும் மத்திய இந்திய மாநிலங்களான ஒடிசா, மத்தியப் பிரதேசம் ஆகியவற்றிலும் எந்தத் திராவிட இடப்பெயர்கள் பரவலாக உள்ளன?", "media_id": null}], "options": {"A": "ஆற்காடு, காஞ்சி", "B": "கொற்கை, வஞ்சி, தொண்டி, பாண்டி, மதிரை", "C": "சேலம், ஈரோடு", "D": "தஞ்சை, திருச்சி"}, "explanation": "ஒடிசாவிலும் மத்தியப் பிரதேச பழங்குடிப் பகுதிகளிலும் கொற்கை, வஞ்சி, பாண்டி போன்ற திராவிடப் பெயர்கள் நிலவுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Which archaic Sangam toponymic roots are discovered in central and eastern Indian states such as Odisha and Madhya Pradesh?", "media_id": null}], "options": {"A": "Arcot and Kanchi", "B": "Korkai, Vanji, Thondi, Pandi, and Mathirai", "C": "Salem and Erode", "D": "Thanjai and Trichy"}, "explanation": "Korkai, Vanji, Thondi, and Pandi exist across tribal geographical belts of Odisha and Madhya Pradesh."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025