{"id": "11th_tamil_u1_q041", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "sung_recitation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சு. வில்வரத்தினத்தின் கவிதை பாடும் முறை குறித்த சிறப்பு என்ன?", "media_id": null}], "options": {"A": "தமது கவிதைகளை உணர்ச்சி ததும்ப இசையுடன் பாடும் தனித்துவமான குரல் வளம் கொண்டவர்", "B": "அமைதியாகப் படிப்பவர் மட்டுமே", "C": "பாடல்களை ஒருபோதும் பொதுவெளியில் பாடாதவர்", "D": "ஆங்கிலத்தில் மட்டுமே பாடியவர்"}, "explanation": "சு. வில்வரத்தினம் தம் கவிதைகளை மேடைகளில் மிக உருக்கமாகவும், தாள லயத்துடனும் பாடி அவையோரை மெய்சிலிர்க்க வைக்கும் தனிச்சிறப்பு மிக்கவர்."}, "en": {"blocks": [{"type": "text", "content": "What unique performing characteristic distinguished poet Su. Vilvarathinam's poetry recitations?", "media_id": null}], "options": {"A": "A distinct melodious and emotionally electrifying chanting of verses with musical cadence", "B": "Strictly silent reading only", "C": "Never reciting verses in public forums", "D": "Chanting exclusively in English"}, "explanation": "Vilvarathinam possessed a legendary resonant voice, chanting his poems rhythmically with profound emotional intensity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Poetry", "Author Trait"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q042", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "word_meaning_ottri", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஒற்றி வைத்தாள்’ என்ற சொல்லின் நேரடிப் பொருள் யாது?", "media_id": null}], "options": {"A": "விலை பேசினாள்", "B": "பதிய வைத்தாள் (தொட்டுத் தடவிப் பதித்தல்)", "C": "மறைத்து வைத்தாள்", "D": "அழித்துவிட்டாள்"}, "explanation": "‘ஒற்றி வைத்தாள்’ என்றால் உதட்டிலும் நெற்றியிலும் தொட்டு அன்போடு பதிய வைத்தாள் என்று பொருள்படும்."}, "en": {"blocks": [{"type": "text", "content": "What is the literal contextual meaning of the phrase 'Ottri vaithaal'?", "media_id": null}], "options": {"A": "Mortgaged for money", "B": "Imprinted with tender touch", "C": "Concealed secretly", "D": "Obliterated totally"}, "explanation": "'Ottri vaithaal' means pressing or imprinting affectionately upon lips and forehead."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null, "source_notes": null}, "previous_year": {"is_previous_year":