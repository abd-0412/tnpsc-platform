{"id": "12th_tamil_u7_q1284", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sangkakala_kalvettu", "chapter_id": null, "topic_id": "tamizhi_phonetics", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தமிழி’ எழுத்துகளில் வடமொழி ஒலிகளைக் குறிக்கும் சிறப்பு எழுத்துகள் எவ்வாறு கையாளப்பட்டன?", "media_id": null}], "options": {"A": "அனைத்து சமஸ்கிருத எழுத்துகளும் அப்படியே ஏற்கப்பட்டன", "B": "எந்த மாற்றமும் இல்லாமல் ரோமன் எழுத்துகள் கலக்கப்பட்டன", "C": "கிரந்த எழுத்துக்களோடு முழுமையாக மாற்றியமைக்கப்பட்டன", "D": "தமிழ் ஒலிப்பு முறைக்கு ஏற்ப மாற்றப்பட்டும், பிறமொழிச் சொற்களுக்குச் சில தனிக்குறிகள் மட்டும் பயன்படுத்தப்பட்டும் அமைந்தன"}, "explanation": "தமிழ் மொழியின் இயல்புக்கு ஏற்ப வடமொழி ஒலிகள் தவிர்க்கப்பட்டு, தமிழ் ஒலிகளுக்கு ஏற்ப புதிய குறியீடுகளுடன் (எ.கா. ள, ழ, ற, ன) தமிழி அமைந்தது."}, "en": {"blocks": [{"type": "text", "content": "How were special phonetic characters representing Indo-Aryan sounds handled in early Tamizhi script?", "media_id": null}], "options": {"A": "All Sanskrit characters were copied without change", "B": "Roman letters were interspersed", "C": "Replaced entirely by Grantha script", "D": "Phonology adapted to Tamil, with minimal special signs retained only for loan names"}, "explanation": "Tamizhi adapted script signs exclusively for unique Tamil phonemes (la, zha, rra, nna) while dropping redundant non-Tamil aspirates."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 182, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 182", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Supplementary", "Tamizhi Phonetics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1285", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sangkakala_kalvettu", "chapter_id": null, "topic_id": "estampage_method", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கல்வெட்டுகளைப் படியெடுக்கும் முறையில் காகிதத்தில் மை தடவி எடுக்கும் அச்சு முறைக்கு என்ன பெயர்?", "media_id": null}], "options": {"A": "மைப்படி (Estampage)", "B": "புகைப்படம்", "C": "கணினி வருடி (Scanner)", "D": "சுண்ணப் பூச்சு"}, "explanation": "ஈரமான விசேஷத் தாளைக் கல்வெட்டின் மீது பதித்து, மை உருளையைக் கொண்டு எடுக்கும் அச்சுப் படிக்கு 'மைப்படி' (Estampage) என்று பெயர்."}, "en": {"blocks": [{"type": "text", "content": "What is the traditional epigraphical method called where ink is applied on moistened paper over stone carvings to take an impression?", "media_id": null}], "options": {"A": "Estampage (Ink impression rubbing)", "B": "Photograph", "C": "Digital scanning", "D": "Lime coating"}, "explanation": "Taking an inking impression on dampened paper beaten gently into the stone inscription is technically known as 'Estampage'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 182, "chapter"