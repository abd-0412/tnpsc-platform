{"id": "11th_tamil_u2_q138", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "supplementary_yanai_doctor", "chapter_id": null, "topic_id": "elephant_corridor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "யானைகள் உணவு மற்றும் தண்ணீருக்காகத் தலைமுறை தலைமுறையாகப் பயணம் செய்யும் பாதைகள் எவ்வாறு அழைக்கப்படுகின்றன?", "media_id": null}], "options": {"A": "தங்க நாற்கரச் சாலை", "B": "யானைகள் வலசைப் பாதை (Elephant Corridors)", "C": "சுற்றுலாப் பாதை", "D": "புகைவண்டிப் பாதை"}, "explanation": "யானைகள் பருவகால மாற்றத்திற்கேற்ப உணவு, தண்ணீரை நாடிச் செல்லும் பாரம்பரிய பாதைகளே 'யானைகள் வலசைப் பாதை' (Elephant Corridors) எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What are the ancestral migratory passages traversed by elephant herds for food and water termed in conservation biology?", "media_id": null}], "options": {"A": "Golden Quadrilateral", "B": "Elephant Corridors (Valasaip Paathai)", "C": "Tourism highway", "D": "Railway trunk route"}, "explanation": "'Elephant Corridors' designate the critical migratory paths traversed across generations."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-20