{"id": "12th_tamil_u8_q1461", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kodai_mazhai", "chapter_id": null, "topic_id": "social_realism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சாந்தா தத்தின் கதைகளில் வெளிப்படும் முதன்மையான நடை பாணி எது?", "media_id": null}], "options": {"A": "எளிய மனிதர்களின் அன்றாட வாழ்வியலையும் அக உலகப் போராட்டங்களையும் நுட்பமாகப் படம்பிடிக்கும் எதார்த்தவாதம் (Social Realism)", "B": "மந்திர எதார்த்தவாதம்", "C": "புராணக் கற்பனை", "D": "துப்பறியும் மர்ம நடை"}, "explanation": "சாந்தா தத் அலங்காரச் சொற்களின்றி, எளிய மக்களின் அன்றாட வாழ்வின் யதார்த்தங்களையும் உணர்வுகளையும் மிக நுட்பமாகச் சித்தரித்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "What predominant narrative style characterizes Shanta Dutt's storytelling?", "media_id": null}], "options": {"A": "Social realism capturing the everyday lives, psychological dilemmas, and gentle emotions of ordinary people", "B": "Magical realism", "C": "Mythological fantasy", "D": "Detective suspense thriller"}, "explanation": "She employs an unadorned social realist style capturing the nuanced emotions of common folk."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "c