{"id": "10th-u7-q114", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mangaiyaraai_pirappadharkae", "chapter_id": null, "topic_id": "un_general_assembly_performance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எம். எஸ். சுப்புலட்சுமி அவர்கள் எந்த ஆண்டு ஐக்கிய நாடுகள் சபையின் பொது அவையில் (UN General Assembly) இசைக்கச்சேரி நிகழ்த்தி உலக அரங்கில் பாராட்டுப் பெற்றார்?", "media_id": null}], "options": {"A": "1950-ஆம் ஆண்டு", "B": "1966-ஆம் ஆண்டு", "C": "1974-ஆம் ஆண்டு", "D": "1998-ஆம் ஆண்டு"}, "explanation": "1966-ஆம் ஆண்டு ஐ.நா. பொது அவையில் எம். எஸ். சுப்புலட்சுமி அவர்கள் ராஜாஜி இயற்றிய \"குறை ஒன்றும் இல்லை\", \"மைத்ரீம் பஜத\" ஆகிய பாடல்களைப் பாடி உலக நாடுகளின் பிரதிநிதிகளை மெய்சிலிர்க்க வைத்தார்."}, "en": {"blocks": [{"type": "text", "content": "In which historic year did M. S. Subbulakshmi perform at the United Nations General Assembly in New York?", "media_id": null}], "options": {"A": "1950", "B": "1966", "C": "1974", "D": "1998"}, "explanation": "She performed at the UN General Assembly in 1966."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 164, "chapter": null, "section"