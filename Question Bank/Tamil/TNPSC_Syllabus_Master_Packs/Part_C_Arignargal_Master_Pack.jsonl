, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["கு. அழகிரிசாமி", "கி.ரா. பாராட்டு", "கதைச்சிறப்பு"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u9-q099", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "story_setting_chennai_slum", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"ஒருவன் இருக்கிறான்\" கதையின் களமாக அமையும் இடம் எது?", "media_id": null}], "options": {"A": "மதுரை கிராமம்", "B": "திருநெல்வேலி பாளையங்கோட்டை", "C": "சென்னையின் ஒரு பழைய சந்தில் அமைந்த ஏழை மக்களின் வாடகை வரிசை வீடுகள்", "D": "கோவில்பட்டி சந்தை"}, "explanation": "பாடநூல் குறிப்பு: சென்னை நகரின் நெரிசலான சந்தில் அமைந்துள்ள ஏழைக் குடியிருப்புப் பகுதியில் நோயுற்று வாடும் குப்புசாமியின் வாழ்விடமே கதைக் களம்."}, "en": {"blocks": [{"type": "text", "content": "What serves as the atmospheric geographical backdrop for \"Oruvan Irukkiran\"?", "media_id": null}], "options": {"A": "A Madurai village", "B": "Palayamkottai", "C": "An impoverished tenement row house in an old Chennai alley", "D": "Kovilpatti market"}, "explanation": "An impoverished tenement house in an old Chennai lane."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 206, "chapter": null, "section": null, "reference": "10th Tamil, U