{"id": "9th-u5-q001", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "sculpture-divakara-nikandu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"கல்லும் உலோகமும் செங்கல்லும் மரமும் / மண்ணும் சுதையும் தந்தமும் வண்ணமும் / கண்டசருக்கரையும் மெழுகும் என்றிவை / பத்தே சிற்பத் தொழிற்கு உறுப்பாவன\" - என்று கூறும் நிகண்டு நூல் எது?", "media_id": null}], "options": {"A": "திவாகர நிகண்டு", "B": "சூடாமணி நிகண்டு", "C": "பிங்கல நிகண்டு", "D": "அகராதி நிகண்டு"}, "explanation": "சிற்பங்கள் செய்வதற்குரிய 10 வகையான பொருள்களைப் பட்டியலிட்டு விளக்கும் பழமையான தமிழ் நிகண்டு 'திவாகர நிகண்டு' ஆகும். இதே கூற்றைப் பிங்கல நிகண்டும் உறுதிப்படுத்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "\"Stone, metal, brick, timber, clay, stucco, ivory, pigment, sugarcane jaggery paste, and wax - these ten are constituents of sculptural craft\" - Which ancient Tamil lexicon (Nikandu) states this?", "media_id": null}], "options": {"A": "Divakara Nikandu", "B": "Chudamani Nikandu", "C": "Pingala Nikandu", "D": "Agaradhi Nikandu"}, "explanation": "'Divakara Nikandu' explicitly enumerates the ten primary raw materials traditionally utilized for traditional sculpture in Tamil Nadu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tami