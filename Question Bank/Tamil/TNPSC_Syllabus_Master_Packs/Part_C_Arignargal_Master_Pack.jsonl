{"id": "12th_tamil_u2_q301", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "character_marudhan_trait", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மருதனின் பாத்திரப் படைப்பு வெளிப்படுத்தும் உன்னதப் பண்பு எது?", "media_id": null}], "options": {"A": "பொதுநலனுக்காகத் தன்னலமின்றி முன்நிற்கும் தலைமைப் பண்பும் செயலூக்கமும்", "B": "பணத்தின் மீதான அளவற்ற ஆசை", "C": "பிறரை ஏமாற்றி வாழும் தந்திரம்", "D": "அரசாங்கத்தை மட்டுமே சார்ந்திருக்கும் இயலாமை"}, "explanation": "மருதன் சுயநலமின்றி, பயிர்களைக் காக்கத் துணிந்து முன்னிற்கும் தன்னலமற்ற தலைமைப் பண்பின் அடையாளமாகத் திகழ்கிறான்."}, "en": {"blocks": [{"type": "text", "content": "What noble character trait does Marudhan exemplify in the story?", "media_id": null}], "options": {"A": "Proactive civic leadership and selfless initiative for communal welfare", "B": "Insatiable greed for wealth", "C": "Deceptive exploitation of others", "D": "Helpless dependence on state machinery"}, "explanation": "Marudhan embodies civic initiative, courage, and selfless leadership in times of community crisis."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "f