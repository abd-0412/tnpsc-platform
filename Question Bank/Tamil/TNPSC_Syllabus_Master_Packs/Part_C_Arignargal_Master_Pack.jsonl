{"id": "12th_tamil_u2_q250", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "piragoru_naal_kodai", "chapter_id": null, "topic_id": "mazhai_aftermath", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மழைக்குப்பிறகும் மழை’ என்னும் நூலின் தலைப்பு உணர்த்தும் பொருள் யாது?", "media_id": null}], "options": {"A": "விடாமல் பெய்யும் பெருமழை", "B": "மழை நின்ற பின்னரும் மனித மனத்தில் நீடிக்கும் அதன் நினைவுகளும் உணர்வுகளும்", "C": "மழைக்கால வெள்ளப் பெருக்கு", "D": "மழையே இல்லாத நிலை"}, "explanation": "மழை நின்றாலும் மனதிற்குள் மழை தந்த பரவசமும் ஈரமும் சிந்தனையில் நீடித்துக் கொண்டிருப்பதை இது குறிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What lyrical meaning is enshrined in the title 'Mazhaikkup Piragum Mazhai' (Rain Even After Rain)?", "media_id": null}], "options": {"A": "Unending cyclonic deluge", "B": "The lasting emotional resonance and impressions persisting in the mind after physical showers stop", "C": "Monsoon flood inundation", "D": "Total absence of rainfall"}, "explanation": "It evokes the internal emotional fragrance and lingering tranquility that endures within even after physical rain departs."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpora