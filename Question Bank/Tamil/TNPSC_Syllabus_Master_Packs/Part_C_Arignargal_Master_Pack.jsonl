{"id": "11th_tamil_rev2_q195", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u8_pyq_mega_model", "chapter_id": null, "topic_id": "tnpsc_thanjavur_kattrali_construction", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC Group 1 2022 அசல் வினா] தஞ்சைப் பெரிய கோயில் எவ்வகைக் கட்டடக்கலை அமைப்பிற்கு உன்னத சான்றாகத் திகழ்கிறது?", "media_id": null}], "options": {"A": "குடைவரைக் கோயில் மட்டுமே", "B": "செங்கல் கட்டுமானம்", "C": "முழுக்க முழுக்கக் கருங்கற்களால் அமைக்கப்பட்ட மாபெரும் கற்றளிக் கட்டுமானம்", "D": "மரக் கட்டுமானம்"}, "explanation": "தஞ்சைப் பெரிய கோயில் முழுக்க முழுக்கக் கருங்கற்களை ஒன்றின் மேல் ஒன்றாக அடுக்கிக் கட்டப்பட்ட மாபெரும் திராவிடக் கற்றளிக் கட்டடக் கலையின் சிகரமாகும்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Group 1 2022 PYQ] Thanjavur Big Temple stands as the monumental pinnacle of which architectural style?", "media_id": null}], "options": {"A": "Rock-cut cave temple only", "B": "Brick superstructure", "C": "Massive monolithic granite Kattrali structural temple", "D": "Timber construction"}, "explanation": "The Brihadisvara temple represents the zenith of monolithic granite Kattrali architecture in South India."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publ