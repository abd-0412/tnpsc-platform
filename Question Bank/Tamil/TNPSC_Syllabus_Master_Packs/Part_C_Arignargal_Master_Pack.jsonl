{"id": "10th-u1-q144", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "book_back", "chapter_id": null, "topic_id": "palavul_theriga", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"கேட்டவர் மகிழப் பாடிய பாடல் இது\" - தொடரில் இடம்பெற்றுள்ள தொழிற்பெயரும் வினையாலணையும் பெயரும் முறையே எவை?", "media_id": null}], "options": {"A": "பாடிய, கேட்டவர்", "B": "பாடல், பாடிய", "C": "கேட்டவர், பாடிய", "D": "பாடல், கேட்டவர்"}, "explanation": "பாடல் என்பது தொழிலைக் குறிக்கும் தொழிற்பெயர்; கேட்டவர் என்பது கேட்ட மனிதரைக் குறிக்கும் வினையாலணையும் பெயர்."}, "en": {"blocks": [{"type": "text", "content": "In \"This is the song sung to delight those who listened\", identify the verbal noun and participial noun respectively:", "media_id": null}], "options": {"A": "Paadiya, Kettavar", "B": "Paadal, Paadiya", "C": "Kettavar, Paadiya", "D": "Paadal, Kettavar"}, "explanation": "\"Paadal\" is the verbal noun and \"Kettavar\" is the participial noun."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 19, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 19", "url": null, "source_notes": nul