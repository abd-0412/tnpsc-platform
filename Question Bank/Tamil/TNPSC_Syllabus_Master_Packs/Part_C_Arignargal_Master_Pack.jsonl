{"id": "11th_tamil_u8_q010", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "prose_tagore_letters", "chapter_id": null, "topic_id": "tagore_music_genre", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரவீந்திரநாத் தாகூரால் உருவாக்கப்பட்ட தனித்துவமான இசைப் பாணி இந்தியாவில் எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "ஹிந்துஸ்தானி செவ்வியல்", "B": "இரவீந்திர சங்கீதம் (Rabindra Sangeet)", "C": "பௌல் இசை", "D": "துமிரி"}, "explanation": "தாகூர் இரண்டாயிரத்திற்கும் மேற்பட்ட பாடல்களை எழுதித் தாமே மெட்டமைத்தார்; இந்நாட்டுப்புற-செவ்வியல் கலந்த இசை மரபு 'இரவீந்திர சங்கீதம்' என்று அழைக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What distinctive genre of music originated by Rabindranath Tagore forms an integral cultural treasure of India?", "media_id": null}], "options": {"A": "Hindustani Classical", "B": "Rabindra Sangeet", "C": "Baul Folk", "D": "Thumri"}, "explanation": "Rabindra Sangeet encompasses over 2,000 lyrical melodies composed by Tagore."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 178, "chapter": null, "section": null, "reference": "11th T