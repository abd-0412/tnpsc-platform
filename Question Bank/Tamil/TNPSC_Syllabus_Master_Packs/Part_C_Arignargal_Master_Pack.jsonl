{"id": "12th_tamil_u3_q426", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "virundhinar_illam", "chapter_id": null, "topic_id": "unexpected_guests", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிதையில் ‘எதிர்பாராத விருந்தினர்களாக’ மனித உள்ளத்திற்குள் வருபவை எவை?", "media_id": null}], "options": {"A": "பணமும் பொருளும்", "B": "மகிழ்ச்சி, மனச்சோர்வு, அற்பத்தனம், விழிப்புணர்வு முதலிய உணர்வுகள்", "C": "புதிய ஆடைகள்", "D": "பகைவர்கள்"}, "explanation": "மகிழ்ச்சி, சோகம், அற்பத்தனம், ஏமாற்றம் போன்ற பல்வேறு மனித மன உணர்வுகளே எதிர்பாராத விருந்தினர்களாக உள்ளே நுழைகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What are the unexpected 'visitors' that arrive daily at the human guest house in the poem?", "media_id": null}], "options": {"A": "Bags of gold coins", "B": "Joy, depression, meanness, unexpected momentary awareness", "C": "New festive clothes", "D": "Armed foes"}, "explanation": "Emotions such as joy, sorrow, malice, and momentary flash of awareness arrive as unexpected guests."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "referen