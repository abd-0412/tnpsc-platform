{"id": "11th_tamil_u2_q055", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aethilik_kuruvigal", "chapter_id": null, "topic_id": "salim_ali_autobiography", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "டாக்டர் சலீம் அலி எழுதிய புகழ்பெற்ற சுயசரிதை நூலின் பெயர் என்ன?", "media_id": null}], "options": {"A": "ஒற்றை வைக்கோல் புரட்சி", "B": "தகப்பன் கொடி", "C": "ஒரு சிட்டுக்குருவியின் வீழ்ச்சி (The Fall of a Sparrow)", "D": "பறவைகளின் உலகம்"}, "explanation": "டாக்டர் சலீம் அலியின் சுயசரிதை நூல் 'ஒரு சிட்டுக்குருவியின் வீழ்ச்சி' (The Fall of a Sparrow) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the title of the celebrated autobiography written by Dr. Salim Ali?", "media_id": null}], "options": {"A": "The One-Straw Revolution", "B": "Thagappan Kodi", "C": "The Fall of a Sparrow", "D": "World of Birds"}, "explanation": "Dr. Salim Ali's autobiography is famously titled 'The Fall of a Sparrow'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 27", "url": null, "source_notes": null}, "previous_y