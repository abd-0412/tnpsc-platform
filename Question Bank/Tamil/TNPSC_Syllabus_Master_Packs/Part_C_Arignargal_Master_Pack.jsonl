{"id": "6th-t2-u1-098", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): சோம்பல் இன்றித் தளராத ஊக்கம் கொண்டவனிடம் செல்வம் வழிகேட்டுக்கொண்டு செல்லும்.\nகாரணம் (R): 'ஆக்கம் அதர்வினாய்ச் செல்லும் அசைவுஇலா ஊக்கம் உடையான் உழை' என்று வள்ளுவர் கூறியுள்ளதே இதற்குச் சான்றாகும்.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு.", "B": "கூற்று தவறு, காரணம் சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "அசைவிலா ஊக்கம் = தளராத மன உறுதி. அதர்வினாய் = வழி கேட்டுக்கொண்டு. ஊக்கமுடையோனைத் தேடிச் செல்வம் செல்லும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "சோம்பல் இன்றித் தளராத ஊக்கம் கொண்டவனிடம் செல்வம் வழிகேட்டுக்கொண்டு செல்லும்.", "reason": "'ஆக்கம் அதர்வினாய்ச் செல்லும் அசைவுஇலா ஊக்கம் உடையான் உழை' என்று வள்ளுவர் கூறியுள்ளதே இதற்குச் சான்றாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 22", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u1-100", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருவள்ளுவரின் சிறப்புப் பெயர்களையும் காரணங்களையும் பொருத்துக:\nபட்டியல் I (சிறப்புப் பெயர்):\n(a) தெய்வப்புலவர்\n(b) பொய்யில் புலவர்\n(c) முதற்பாவலர்\n(d) வான்புகழ் வள்ளுவர்\n\nபட்டியல் II (காரணம்):\n1. எல்லையற்ற வானளாவிய புகழ் கொண்டவர்\n2. தமிழ் அறநெறிப் பாவலர்களுள் தலையாய முன்னோடி\n3. ஒருபோதும் பொய்க்காத மெய்ம்மொழிகளைப் பாடியவர்\n4. தெய்வத்தன்மை பொருந்திய உயர்ந்த அறங்களைப் பாடியவர்", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-3, (c)-4, (d)-1", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-4, (b)-3, (c)-2, (d)-1"}, "explanation": "தெய்வப்புலவர் - தெய்வத்தன்மை வாய்ந்தவர்; பொய்யில் புலவர் - பொய்க்காத அறம் பாடியவர்; முதற்பாவலர் - முன்னோடிப் பாவலர்; வான்புகழ் வள்ளுவர் - வானளாவிய புகழ் கொண்டவர். சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Servic