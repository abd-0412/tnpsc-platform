{"id": "11th_tamil_u7_q090", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "fate_of_king", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மக்களின் மாபெரும் புரட்சிப் பேரெழுச்சியைக் கண்ட மன்னன் மதனமன்னன் என்ன செய்தான்?", "media_id": null}], "options": {"A": "மக்களை எதிர்த்துப் போரிட்டு வென்றான்", "B": "மக்களின் பேராற்றலுக்கு அஞ்சி, முடிதுறந்து நாட்டை விட்டு ஓடினான் (மன்னராட்சி வீழ்ந்தது)", "C": "உதாரனைக் கொன்றான்", "D": "அமுதவல்லியைச் சிறையிலிட்டான்"}, "explanation": "மக்கள் வெள்ளத்தின் புரட்சிக்கு முன் நிற்க முடியாத மன்னன் அஞ்சி நடுங்கி மணிமுடியை இழந்து ஓடினான்; கொடுங்கோல் மன்னராட்சி முடிவுக்கு வந்தது."}, "en": {"blocks": [{"type": "text", "content": "Confronted by the tsunami of popular uprising, what fate befell King Madhanamannan?", "media_id": null}], "options": {"A": "Defeated the crowds in battle", "B": "Terrified by the people irresistible wrath, lost his crown and fled in disgrace (monarchy collapsed)", "C": "Executed Udharan", "D": "Imprisoned Amuthavalli"}, "explanation": "The tyrant fled in terror, bringing an end to monarchical rule."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 152, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 152", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 7", "Poetry", "Puratchikkavi"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u7_q091", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "republic_birth", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மன்னராட்சி ஒழிந்த பின்னர் அந்நாட்டில் எவ்வகை ஆட்சி முறை மலர்ந்ததாகப் பாரதிதாசன் காவியத்தை முடிக்கிறார்?", "media_id": null}], "options": {"A": "இராணுவ ஆட்சி", "B": "வேறோர் அரசனின் ஆட்சி", "C": "மக்களாட்சி (குடியரசு ஆட்சி முறை)", "D": "அமைச்சரின் ஆட்சி"}, "explanation": "மன்னராட்சி ஒழிக்கப்பட்டு, நாட்டின் அனைத்து மக்களும் சம உரிமையுடன் வாழும் 'குடியரசு' (மக்களாட்சி) நிறுவப்பட்டதாகப் பாவேந்தர் காவியத்தை நிறைவு செய்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "Following the overthrow of the monarch, what form of governance was established as the climax of 'Puratchikkavi'?", "media_id": null}], "options": {"A": "Military dictatorship", "B": "Rule by an invading king", "C": "Egalitarian Democracy / Republic (Kudiyarasu)", "D": "Oligarchy of ministers"}, "explanation": "The epic culminates in the dawn of a democratic republic governed by the people."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025