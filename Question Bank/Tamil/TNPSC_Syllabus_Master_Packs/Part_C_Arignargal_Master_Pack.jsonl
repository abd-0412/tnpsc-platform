{"id": "12th_tamil_mp1_q1760", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_7", "chapter_id": null, "topic_id": "tnpsc_pyq_u_ve_sa_first_epic", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC Group 4 2012] உ.வே. சாமிநாதையர் பதிப்பித்த முதல் காப்பியம் எது?", "media_id": null}], "options": {"A": "\"சிலப்பதிகாரம்", "B": "\"மணிமேகலை", "C": "\"குண்டலகேசி", "D": "\"சீவகசிந்தாமணி"}, "explanation": "உ.வே.சா அவர்கள் 1887-ஆம் ஆண்டு 'சீவகசிந்தாமணி' என்னும் சமணப் பெருங்காப்பியத்தையே முதன்முதலில் அச்சேற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Group 4 2012] Which was the first classical epic published in print by U.V. Swaminatha Iyer?", "media_id": null}], "options": {"A": "\"Silappathikaram", "B": "\"Manimekalai", "C": "\"Kundalakesi", "D": "\"Seevaga Chinthamani"}, "explanation": "Seevaga Chinthamani in 1887 was U.Ve.Sa's maiden monumental classical print publication."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 72, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 72", "url": null, "source_notes": null}, "previ