{"id": "11th_tamil_u7_q092", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "wedding_of_lovers", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குடியரசு மலர்ந்த பின்னர் உதாரனுக்கும் அமுதவல்லிக்கும் திருமணம் எவ்வாறு நடைபெற்றது?", "media_id": null}], "options": {"A": "ரகசியமாக நடைபெற்றது", "B": "நடைபெறவே இல்லை", "C": "மன்னன் நடத்தி வைத்தான்", "D": "நாட்டு மக்கள் அனைவரும் கூடி நின்று மகிழ்வோடு புரட்சித் திருமணத்தை நடத்தி வைத்தனர்"}, "explanation": "நாட்டு மக்களே முன்னின்று உதாரனுக்கும் அமுதவல்லிக்கும் சமத்துவப் புரட்சித் திருமணத்தை நடத்தி வாழ்த்தினர்."}, "en": {"blocks": [{"type": "text", "content": "How was the union of Udharan and Amuthavalli solemnized after the democratic republic was instituted?", "media_id": null}], "options": {"A": "Conducted in secret", "B": "Never materialized", "C": "Conducted by the king", "D": "Celebrated as an egalitarian wedding by the sovereign citizens of the newly born republic"}, "explanation": "The citizens joyously solemnized their marriage as an egalitarian celebration."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "editi