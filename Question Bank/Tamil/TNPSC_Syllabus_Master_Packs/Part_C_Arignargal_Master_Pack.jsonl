{"id": "9th-u5-q092", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "janakiraman-dialect", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி. ஜானகிராமனின் படைப்புகளில் எந்த மாவட்டத்து வட்டார மொழி வழக்கு இயல்பாக இழையோடுகிறது?", "media_id": null}], "options": {"A": "கொங்கு வட்டார வழக்கு", "B": "நெல்லை வட்டார வழக்கு", "C": "கரிசல் வட்டார வழக்கு", "D": "தஞ்சாவூர் வட்டார வழக்கு"}, "explanation": "தி. ஜானகிராமன் தஞ்சை மாவட்டத்துப் பண்பாட்டையும் காவிரி பாசனப் பகுதியின் எழிலார்ந்த வட்டார மொழி வழக்கையும் தம் எழுத்துகளில் மிக நுணுக்கமாகப் பதிவு செய்தவர்."}, "en": {"blocks": [{"type": "text", "content": "Which regional dialect and cultural idiom permeate the literary works of T. Janakiraman?", "media_id": null}], "options": {"A": "Kongu dialect", "B": "Nellai dialect", "C": "Karisal dialect", "D": "Thanjavur regional dialect"}, "explanation": "T. Janakiraman is celebrated for capturing the rich Thanjavur dialect and delta ethos."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 121, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1