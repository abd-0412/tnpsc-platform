{"id": "12th_tamil_mp1_q1749", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_7", "chapter_id": null, "topic_id": "tnpsc_pyq_u_ve_sa_autobiography", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC Group 4 2013] உ.வே. சாமிநாதையர் ஆனந்த விகடன் இதழில் தொடராக எழுதிய தமது சுயசரிதை நூலின் பெயர் என்ன?", "media_id": null}], "options": {"A": "\"என் சரித்திரம்", "B": "\"என் கதை", "C": "\"என் வாழ்க்கை வரலாறு", "D": "\"நினைவு அலைகள்"}, "explanation": "உ.வே.சா அவர்கள் ஆனந்த விகடனில் தொடராக எழுதி வெளியிட்ட தன்வரலாற்று நூல் 'என் சரித்திரம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Group 4 2013] What is the title of U.V. Swaminatha Iyer's celebrated serialized autobiography published in Ananda Vikatan?", "media_id": null}], "options": {"A": "\"En Sarithiram", "B": "\"En Kathai", "C": "\"En Vaazhkkai Varalaaru", "D": "\"Ninaivu Alaigal"}, "explanation": "U.Ve.Sa authored his classic serialized autobiography under the title 'En Sarithiram'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 72, "chapter": null, "section": null, "reference": "12th Tamil, U