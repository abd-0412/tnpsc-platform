{"id": "7th-t1-u2-214", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l6-kurukkangal", "chapter_id": null, "topic_id": "aigaaram-positions-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஐகாரக்குறுக்கம் வரும் சொல்லிடங்களையும் சான்றுகளையும் பொருத்துக:\nபட்டியல் I (சொல்லிடம்):\nL1. சொல்லின் முதலில் ஐகாரம்\nL2. சொல்லின் இடையில் ஐகாரம்\nL3. சொல்லின் இறுதியில் ஐகாரம்\nL4. தனித்து வரும் ஐகாரம்\nபட்டியல் II (சான்றுச் சொல் / மாத்திரை):\nR1. சமையல் (1 மாத்திரை)\nR2. வையம் (1.5 மாத்திரை)\nR3. கை, பை (2 மாத்திரை)\nR4. பறவை (1 மாத்திரை)"}], "options": {"A": "L1-R1, L2-R2, L3-R3, L4-R4", "B": "L1-R2, L2-R1, L3-R4, L4-R3", "C": "L1-R3, L2-R4, L3-R1, L4-R2", "D": "L1-R4, L2-R3, L3-R2, L4-R1"}, "explanation": "பாடநூல் விளக்கம்: முதலில் வையம் (R2); இடையில் சமையல் (R1); இறுதியில் பறவை (R4); தனித்து கை/பை (R3). வரிசை: 2 - 1 - 4 - 3."}, "en": {"blocks": [{"type": "text", "content": "Match the positional manifestations of Aigaaram with examples:\nList I (Position):\nL1. Aigaaram at word initial\nL2. Aigaaram at word medial\nL3. Aigaaram at word final\nL4. Aigaaram isolated\nList II (Example Word / Duration):\nR1. Samaiyal (1 maathirai)\nR2. Vaiyam (1.5 maathirai)\nR3. Kai, Pai (2 maathirai)\nR4. Paravai (1 maathirai)"}], "options": {"A": "L1-R1, L2-R2, L3-R3, L4-R4", "B": "L1-R2, L2-R1, L3-R4, L4-R3", "C": "L1-R3, L2-R4, L3-R1, L4-R2", "D": "L1-R4, L2-R3, L3-R2, L4-R1"}, "explanation": "Textbook match: Initial=Vaiyam (R2), Medial=Samaiyal (R1), Final=Paravai (R4), Isolated=Kai/Pai (R3)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "சொல்லின் முதலில் ஐகாரம்", "content_en": "Word initial Aigaaram"}, {"id": "L2", "content_ta": "சொல்லின் இடையில் ஐகாரம்", "content_en": "Word medial Aigaaram"}, {"id": "L3", "content_ta": "சொல்லின் இறுதியில் ஐகாரம்", "content_en": "Word final Aigaaram"}, {"id": "L4", "content_ta": "தனித்து வரும் ஐகாரம்", "content_en": "Isolated Aigaaram"}], "right": [{"id": "R1", "content_ta": "சமையல் (1 மாத்திரை)", "content_en": "Samaiyal (1 maathirai)"}, {"id": "R2", "content_ta": "வையம் (1.5 மாத்திரை)", "content_en": "Vaiyam (1.5 maathirai)"}, {"id": "R3", "content_ta": "கை, பை (2 மாத்திரை)", "content_en": "Kai, Pai (2 maathirai)"}, {"id": "R4", "content_ta": "பறவை (1 மாத்திரை)", "content_en": "Paravai (1 maathirai)"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 39, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "match", "aigaaram_positions"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 