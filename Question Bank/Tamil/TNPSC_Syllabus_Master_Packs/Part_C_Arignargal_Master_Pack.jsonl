{"id": "12th_tamil_u2_q293", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "alli_support", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மருதன் தனி ஆளாகக் கல்லைத் தூக்க முடியாமல் திணறியபோது முதலில் ஓடிவந்து அவனுக்குத் தோள் கொடுத்தவர் யார்?", "media_id": null}], "options": {"A": "அவன் மனைவி அல்லி", "B": "ஊர்த் தலைவர்", "C": "கிராமத்து இளைஞர்கள்", "D": "அரசு ஊழியர்"}, "explanation": "மருதன் திணறியதைக் கண்ட அவன் மனைவி அல்லி, சேலை நனைய வெள்ளத்தில் இறங்கி அவனுடன் சேர்ந்து கல்லைத் தூக்கினாள்."}, "en": {"blocks": [{"type": "text", "content": "When Marudhan struggled to move the massive stone single-handedly, who was the first person to wade into the water beside him?", "media_id": null}], "options": {"A": "His wife Alli", "B": "The village headman", "C": "A group of young men", "D": "A government clerk"}, "explanation": "Seeing her husband struggle in the currents, Alli immediately waded into the water to heave the stone alongside him."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": "12th Ta