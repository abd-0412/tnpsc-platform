{"id": "10th-u7-q051", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "national_integrity_and_tamil", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ம. பொ. சிவஞானம் அவர்களின் அரசியல் சித்தாந்தத்தின் தனிப்பெரும் சிறப்பு யாது?", "media_id": null}], "options": {"A": "இந்தியாவிலிருந்து தமிழ்நாடு பிரிந்து போக வேண்டும் என்ற கொள்கை", "B": "தமிழைப் புறக்கணித்து தேசியத்தை மட்டுமே பேசுவது", "C": "\"இந்திய ஒருமைப்பாட்டுக்குள் சுயாட்சி கொண்ட தமிழ்நாடு\" - தேசியத்தையும் தமிழ்த் தேசியத்தையும் இணைத்த ஒருங்கிணைந்த பார்வை", "D": "அரசியலில் எதிலும் ஈடுபடாமல் இருப்பது"}, "explanation": "ம. பொ. சி அவர்கள் இந்திய ஒருமைப்பாட்டை விட்டுக் கொடுக்காமல், அதே நேரத்தில் தமிழகத்தின் தன்னுரிமையையும் மொழியுரிமையையும் காத்த சமநிலையான தலைவராவார்."}, "en": {"blocks": [{"type": "text", "content": "What distinct political ideology characterized the statesmanship of M. P. Sivagnanam?", "media_id": null}], "options": {"A": "Outright secession from India", "B": "Neglecting Tamil identity for pan-Indian nationalism", "C": "\"Autonomous Tamil Nadu within united India\" — synthesizing Indian patriotism with robust Tamil cultural nationalism", "D": "Total political apathy"}, "explanation": "He harmonized Indian national patriotism with assertive Tamil cultural federalism."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, 