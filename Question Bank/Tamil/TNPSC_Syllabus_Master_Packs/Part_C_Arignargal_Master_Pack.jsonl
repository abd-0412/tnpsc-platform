{"id": "11th_tamil_rev2_q196", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u8_pyq_mega_model", "chapter_id": null, "topic_id": "tnpsc_tamil_thai_valthu_author", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC Group 4 2016 அசல் வினா] ‘நீராருங் கடலுடுத்த நிலமடந்தை...’ என்னும் தமிழ்த்தாய் வாழ்த்துப் பாடலை இயற்றிய பேராசிரியர் யார்?", "media_id": null}], "options": {"A": "பேராசிரியர் நன்னன்", "B": "பேராசிரியர் வரதராசனார்", "C": "பேராசிரியர் சண்முகம்", "D": "பேராசிரியர் பெ. சுந்தரனார்"}, "explanation": "1891-இல் மனோன்மணீயம் நாடக நூலின் தொடக்கப் பாயிரப் பாடலாக இப்பாடலை இயற்றியவர் பேராசிரியர் பெ. சுந்தரனார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Group 4 2016 PYQ] Who composed the celebrated Tamil Thai Valthu beginning with 'Neeraarum Kadaludutha'?", "media_id": null}], "options": {"A": "Prof. Nannan", "B": "Prof. Varadarajanar", "C": "Prof. Shanmugam", "D": "Prof. P. Sundaranar"}, "explanation": "Prof. P. Sundaranar composed the invocation in 1891 within his play Manonmaneeyam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 200, "chapter"