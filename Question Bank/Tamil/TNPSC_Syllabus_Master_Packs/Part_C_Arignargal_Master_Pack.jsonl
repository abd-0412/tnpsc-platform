{"id": "12th_tamil_u6_q1092", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nadigar_thilagam", "chapter_id": null, "topic_id": "nadigar_thilagam_legacy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிவாஜி கணேசன் தமிழ்த் திரையுலகிற்கு விட்டுச் சென்ற அழியாத கொடை எது?", "media_id": null}], "options": {"A": "திரையரங்கங்கள் மட்டும்", "B": "பாடல்கள் மட்டும்", "C": "படத் தயாரிப்பு மட்டும்", "D": "உணர்ச்சி வெளிப்பாடு, மொழி உச்சரிப்பு, பாத்திர வார்ப்பு ஆகியவற்றில் எதிர்காலத் தலைமுறையினருக்கு நடிப்புப் பாடப்புத்தகமாகத் திகழும் நடிப்புப் பாரம்பரியம்"}, "explanation": "தமிழ் மொழியின் கம்பீரமான உச்சரிப்பு, முகபாவனைகள், உடல் நயம் ஆகியவற்றில் சிவாஜி நிறுவிய நடிப்பு இலக்கணம் என்றும் நிலைத்து நிற்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the enduring legacy bequeathed by Sivaji Ganesan to the history of Indian performing arts?", "media_id": null}], "options": {"A": "Movie palaces alone", "B": "Audio discs only", "C": "Studio infrastructure", "D": "An acting textbook of emotional diction, immaculate articulation, and psychological embodiment for future generations"}, "explanation": "Sivaji left an enduring benchmark of emotional articulation, voice modulation, and dramatic embodiment."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name"