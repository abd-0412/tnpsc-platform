{"id": "12th_tamil_u3_q481", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "urimaithaagam", "chapter_id": null, "topic_id": "karisal_literary_tradition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பூமணி தமிழ் இலக்கியத்தில் எந்த வட்டார வழக்கு எழுத்து மரபிற்குப் புகழ்பெற்றவர்?", "media_id": null}], "options": {"A": "கோவில்பட்டி கரிசல் வட்டார வழக்கு மரபு", "B": "கொங்கு வட்டார வழக்கு", "C": "நாஞ்சில் நாட்டு வழக்கு", "D": "சென்னைத் தமிழ் வழக்கு"}, "explanation": "கி. ராஜநாராயணனைத் தொடர்ந்து கோவில்பட்டிப் பகுதியின் கரிசல் மண் சார்ந்த உழைக்கும் மக்களின் வாழ்வியலை எழுதியவர் பூமணி."}, "en": {"blocks": [{"type": "text", "content": "To which celebrated regional dialect tradition of Tamil literature does Poomani belong?", "media_id": null}], "options": {"A": "Kovilpatti Karisal (Black Soil) regional dialect tradition", "B": "Kongu regional dialect", "C": "Nanjil Nadu dialect", "D": "Madras dialect"}, "explanation": "Poomani is a foremost exponent of the Kovilpatti Karisal (black soil) agrarian literary tradition."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 58, "chapter": null, "sectio