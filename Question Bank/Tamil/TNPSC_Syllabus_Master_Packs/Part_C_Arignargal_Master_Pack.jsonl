{"id": "10th-u7-q057", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "aer_pudhithaa", "chapter_id": null, "topic_id": "author_name", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "10-ஆம் வகுப்பு இயல் 7-இல் இடம்பெற்றுள்ள \"ஏர் புதிதா?\" என்னும் வேளாண்மை அழகியல் கவிதையின் ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "கு. ப. ராஜகோபாலன் (கு.ப.ரா)", "B": "ந. பிச்சமூர்த்தி", "C": "புதுமைப்பித்தன்", "D": "தி. ஜானகிராமன்"}, "explanation": "பாடநூல் குறிப்பு: \"ஏர் புதிதா?\" என்னும் கவிதையை இயற்றியவர் மறுமலர்ச்சி எழுத்தாளர் கு. ப. ராஜகோபாலன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the evocative agrarian poem \"Aer Pudhithaa?\" in Standard 10 Unit 7?", "media_id": null}], "options": {"A": "Ku. Pa. Rajagopalan (Ku. Pa. Raa.)", "B": "Na. Pichamurthi", "C": "Pudhumaipithan", "D": "Thi. Janakiraman"}, "explanation": "Ku. Pa. Rajagopalan composed the acclaimed poem Aer Pudhithaa."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 156", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["ஏர் புதிதா", "கு. ப. ராஜகோபாலன்", "ஆசிரியர்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q058", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "aer_pudhithaa", "chapter_id": null, "topic_id": "poet_native_literary_magazines", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கு. ப. ராஜகோபாலன் அவர்கள் பிறந்த ஊர் எது? அவர் பணியாற்றிய புகழ்பெற்ற இதழ்கள் எவை?", "media_id": null}], "options": {"A": "மதுரை - சுதேசமித்திரன்", "B": "கும்பகோணம் (தஞ்சை மாவட்டம்) - மணிக்கொடி, கிராம ஊழியன், பாரதமணி", "C": "சென்னை - ஆனந்த விகடன்", "D": "திருநெல்வேலி - கணையாழி"}, "explanation": "பாடநூல் குறிப்பு: கு. ப. ரா கும்பகோணத்தில் பிறந்தவர்; மணிக்கொடி, கிராம ஊழியன், பாரதமணி, தமிழ்நாடு முதலான இதழ்களில் தீவிரமாகப் பணியாற்றியவர்."}, "en": {"blocks": [{"type": "text", "content": "What was the birthplace of Ku. Pa. Rajagopalan, and which pioneering literary journals did he contribute to?", "media_id": null}], "options": {"A": "Madurai - Swadesamitran", "B": "Kumbakonam (Thanjavur district) - Manikkodi, Grama Oozhiyan, Bharathamani", "C": "Chennai - Ananda Vikatan", "D": "Tirunelveli - Kanaiyaazhi"}, "explanation": "He was born in Kumbakonam and contributed to Manikkodi and Grama Oozhiyan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 157, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 157", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["ஏர் புதிதா", "கு. ப. ரா ஊர் இதழ்கள்", "கும்பகோணம் மணிக்கொடி"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q059", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "aer_pudhithaa", "chapter_id": null, "topic_id": "poet_works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கு. ப. ராஜகோபாலன் அவர்களின் சிறுகதைகள் மற்றும் படைப்புகளுள் அடங்காத ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "அகலிகை", "B": "ஆத்மசிந்தனை", "C": "கோபல்லபுரத்து மக்கள்", "D": "காணாமலே காதல்"}, "explanation": "கு. ப. ரா அவர்களின் படைப்புகள்: அகலிகை, ஆத்மசிந்தனை, விடியுமா முதலானவை. \"கோபல்லபுரத்து மக்கள்\" புதினத்தை எழுதியவர் கி. ராஜநாராயணன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Identify the literary work NOT composed by Ku. Pa. Rajagopalan:", "media_id": null}], "options": {"A": "Agaligai", "B": "Aathmasinthana", "C": "Gopallapurathu Makkal", "D": "Kaanamalae Kaadhal"}, "explanation": "Gopallapurathu Makkal was written by Ki. Rajanarayanan, not Ku. Pa. Raa."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 157, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 157", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["ஏர் புதிதா", "கு. ப. ரா படைப்புகள்", "பொருந்தாதது"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q060", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "aer_pudhithaa", "chapter_id": null, "topic_id": "ponnaer_poottuthal_tradition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சித்திரை மாதத்தின் தொடக்கத்தில் முதல் மழை பெய்தவுடன் உழவர்கள் நிலத்தை உழுவதற்காக நிகழ்த்தும் மங்கல நிகழ்வு எது?", "media_id": null}], "options": {"A": "நாற்று நடுதல்", "B": "களை எடுத்தல்", "C": "கதிர் அறுத்தல்", "D": "பொன்னேர் பூட்டுதல் (ஏர் மங்கலம் / உழவுத் திருநாள்)"}, "explanation": "பாடநூல் குறிப்பு: சித்திரை முதல் நாளில் மழை பெய்தவுடன் ஏரில் மாடுகளைப் பூட்டி உழவைத் தொடங்குவதை உழவர்கள் \"பொன்னேர் பூட்டுதல்\" என மங்கலமாகக் கொண்டாடுவர்."}, "en": {"blocks": [{"type": "text", "content": "What sacred inaugural ploughing ritual is performed by farmers at the onset of the first rains in the month of Chithirai?", "media_id": null}], "options": {"A": "Transplanting seedlings", "B": "Weeding operations", "C": "Harvesting crop", "D": "Ponnaer Poottuthal (Golden Plough ceremony / Agrarian inauguration)"}, "explanation": "Ponnaer Poottuthal marks the auspicious seasonal start of ploughing."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 156", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["ஏர் புதிதா", "பொன்னேர் பூட்டுதல்", "சித்திரை உழவு"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q061", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "aer_pudhithaa", "chapter_id": null, "topic_id": "poem_lines_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"முதல் மழை விழுந்தது... நாளும் புதிது நன்செய் புதிது ஏர் புதிதா? அன்று...\" - இவ்வடிகளில் கவிஞர் வெளிப்படுத்தும் மையக் கருத்து என்ன?", "media_id": null}], "options": {"A": "ஏர் கருவி பழையதே ஆயினும், ஒவ்வொரு ஆண்டும் புதிதாகத் தொடங்கும் உழவுப் பணி புத்துணர்ச்சியும் புது நம்பிக்கையும் தருகிறது", "B": "ஏர் பழுதடைந்துவிட்டது", "C": "மழை பெய்யவில்லை", "D": "விவசாயத்தை நிறுத்த வேண்டும்"}, "explanation": "பழைய ஏர்க்கருவியாக இருந்தாலும், உழவுத் தொழில் தலைமுறை தலைமுறையாகப் புதுப்பிக்கப்படும் மனித வாழ்வின் ஆதார ஊற்று என்பதை உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What poetic truth is captured by the verse: \"First rain fell... The day is new, wetland is new, is the plough new? No...\"?", "media_id": null}], "options": {"A": "Though the wooden plough is ancient, every seasonal beginning of tilling infuses fresh vitality and hope into humanity", "B": "The plough is broken", "C": "Rains failed", "D": "Abandon farming"}, "explanation": "Ploughing renews the timeless covenant between earth, farmer, and vitality."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 156", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["ஏர் புதிதா", "கவிதை வரிகள்", "புது நம்பிக்கை"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q062", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "aer_pudhithaa", "chapter_id": null, "topic_id": "bulls_hump_strength", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிதையில் மாடுகளின் வீரம் மற்றும் உழைப்பின் கம்பீரத்தை விவரிக்கக் கவிஞர் குறிப்பிடும் உடல் உறுப்பு எது?", "media_id": null}], "options": {"A": "மாடுகளின் வால்", "B": "காளைகளின் திமில் (முறுக்கேறும் திமில்)", "C": "மாடுகளின் காதுகள்", "D": "மாடுகளின் கண்கள்"}, "explanation": "கவிதையில்: \"காளைகளின் திமில் முறுக்கேறுகிறது... நிலத்தைப் பிளந்து உழுக...\" என்று காளைகளின் திமில் பலத்தைப் போற்றுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Which physical anatomy of the tilling bulls is emphasized by the poet to portray muscular vigor?", "media_id": null}], "options": {"A": "Bulls' tail", "B": "Muscular humps of the bulls (Thimil murukkaerugirathu)", "C": "Bulls' ears", "D": "Bulls' eyes"}, "explanation": "The tensed muscular hump (Thimil) embodies agrarian strength."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 156", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["ஏர் புதிதா", "காளைகளின் திமில்", "வலிமை"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q063", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "meikkeerthi", "chapter_id": null, "topic_id": "definition_meikkeerthi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சோழ மன்னர்களின் சாதனைகளையும், வரலாற்றையும், புகழையும் கல்வெட்டுகளில் அழியாதவாறு பொறிக்கும் முறை எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "செப்பேடு", "B": "ஓலைச்சுவடி", "C": "மெய்க்கீர்த்தி", "D": "வட்டெழுத்து"}, "explanation": "அரசர்களின் உண்மையான புகழையும் வரலாற்றையும் கல்லில் செதுக்கி ஆவணப்படுத்தும் முறை \"மெய்க்கீர்த்தி\" (மெய் = உண்மை, கீர்த்தி = புகழ்) எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What is the classical epigraphic tradition of engraving the authentic history and benevolent achievements of Chola kings called?", "media_id": null}], "options": {"A": "Copper plate deed", "B": "Palm-leaf manuscript", "C": "Meikkeerthi (Imperial Epigraphic Panegyric)", "D": "Vatteluttu"}, "explanation": "Meikkeerthi is the formal stone-inscribed panegyric eulogizing Chola monarchs."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 158, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 158", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மெய்க்கீர்த்தி", "விளக்கம்", "சோழர் கல்வெட்டு"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q064", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "meikkeerthi", "chapter_id": null, "topic_id": "first_chola_king_meikkeerthi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தன் கல்வெட்டுகளில் மெய்க்கீர்த்தியை முதன்முதலில் வடித்த பெருமைக்குரிய சோழப் பேரரசன் யார்?", "media_id": null}], "options": {"A": "விசயாலய சோழன்", "B": "பராந்தக சோழன்", "C": "குலோத்துங்க சோழன்", "D": "முதலாம் இராசராச சோழன்"}, "explanation": "பாடநூல் குறிப்பு: சோழ மன்னர்களில் தன் கல்வெட்டுகளின் தொடக்கத்தில் முதன்முதலில் மெய்க்கீர்த்திகளைப் பொறிக்கும் வழக்கத்தைத் தொடங்கியவர் முதலாம் இராசராச சோழன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Which imperial Chola monarch inaugurated the tradition of engraving Meikkeerthi inscriptions at the start of royal records?", "media_id": null}], "options": {"A": "Vijayalaya Chola", "B": "Parantaka Chola", "C": "Kulothunga Chola", "D": "Rajaraja Chola I (First Rajaraja Chola)"}, "explanation": "Rajaraja Chola I pioneered standardized Meikkeerthis on stone."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 159, "chapter": null, "section": null, "