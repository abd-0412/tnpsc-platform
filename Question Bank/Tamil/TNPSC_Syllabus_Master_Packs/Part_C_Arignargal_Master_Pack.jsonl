{"id": "8th-u2-q196", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-08-tamizhar-maruthuvam", "chapter_id": null, "topic_id": "ta-8th-u2-direct-bookback-alienation-nature", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நோய்கள் பெருக மனிதன் எதனை விட்டு விலகியதே முதன்மைக் காரணமாகும்?"}], "options": {"A": "வீட்டை", "B": "உணவை", "C": "நாட்டை", "D": "இயற்கையை"}, "explanation": "பாடநூல் பக்கம் 34 மதிப்பீடு வினா 3: 'நோய்கள் பெருக மனிதன் இயற்கையை விட்டு விலகியதுதான் முதன்மைக் காரணமாகும்.'"}, "en": {"blocks": [{"type": "text", "content": "What did humans alienate themselves from, which became the prime cause for the surge in diseases?"}], "options": {"A": "Home", "B": "Food", "C": "Country", "D": "Nature (இயற்கையை)"}, "explanation": "Textbook page 34 exercise question 3: 'Man's estrangement from nature is the primary cause of diseases.'"}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 34, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year":