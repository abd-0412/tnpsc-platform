{"id": "10th-u7-q081", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "aer_pudhithaa", "chapter_id": null, "topic_id": "seeds_sowing_phrase", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஏர் புதிதா கவிதையில் \"விதைக்க விதைநெல்...\" என்று தொடங்கும் வரிகள் எதனை உழவர்களுக்கு அறிவுறுத்துகின்றன?", "media_id": null}], "options": {"A": "உழுது பண்படுத்திய நிலத்தில் எதிர்கால உணவுக்காக விதைநெல்லை நம்பிக்கையோடு விதைக்க வேண்டும்", "B": "நெல்லை சமைக்க வேண்டும்", "C": "விதைகளை விற்க வேண்டும்", "D": "நிலத்தைப் பாழாக்க வேண்டும்"}, "explanation": "மழை பெய்து உழுத நிலத்தில் விதைநெல்லைத் தூவி நல்விளைச்சலைப் பெற வேண்டும் என்பதே கவிதையின் அறிவுறுத்தலாகும்."}, "en": {"blocks": [{"type": "text", "content": "What does the injunction \"Vidhaikka vidhainel...\" urge farmers to perform?", "media_id": null}], "options": {"A": "Sowing seed paddy with optimism into newly ploughed fertile soils for future sustenance", "B": "Boiling grain immediately", "C": "Selling seed stock", "D": "Neglecting fields"}, "explanation": "It exhorts farmers to sow the seeds of future abundance in furrowed fields."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "