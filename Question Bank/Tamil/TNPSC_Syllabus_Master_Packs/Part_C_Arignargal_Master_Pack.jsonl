{"id": "12th_tamil_u4_q695", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pathukaapaai_oru_payanam", "chapter_id": null, "topic_id": "child_restraint_safety", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிறு குழந்தைகளை வாகனத்தின் முன் இருக்கையில் அமர்த்திப் பயணம் செய்ய அனுமதிக்கக் கூடாது என்பதன் முக்கிய அறிவியல் காரணம் யாது?", "media_id": null}], "options": {"A": "வாகனத்தின் எடை கூடும்", "B": "கண்ணாடி மறைக்கப்படும்", "C": "திடீர் விபத்தின்போது பலூன் விரிவடையும்போது (Airbag) மூச்சுத்திணறல் மற்றும் காயங்கள் ஏற்படும்", "D": "பெட்ரோல் செலவு அதிகரிக்கும்"}, "explanation": "விபத்தின்போது ஏர்பேக் (Airbag) அதிவேகமாக விரிவடையும்போது சிறு குழந்தைகள் மார்பிலும் முகத்திலும் தாக்கப்பட்டுக் காயமடைய வாய்ப்புள்ளதால் அவர்கள் பின் இருக்கையில்தான் அமர வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "What is the critical biomechanical safety reason prohibiting infants and toddlers from occupying vehicle front passenger seats?", "media_id": null}], "options": {"A": "Vehicle payload increases", "B": "Windshield view is blocked", "C": "Sudden airbag deployment impact can cause severe infant head/neck trauma", "D": "Fuel consumption spikes"}, "explanation": "Violent explosive expansion of frontal airbags during collision poses grave injury risk to children."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers"