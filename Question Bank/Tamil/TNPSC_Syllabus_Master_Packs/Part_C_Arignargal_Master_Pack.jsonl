{"id": "12th_tamil_u8_q1479", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kodai_mazhai", "chapter_id": null, "topic_id": "moral_compassion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வள்ளலார் பாடிய ‘வாடிய பயிரைக் கண்டபோதெல்லாம் வாடினேன்’ என்ற இரக்கப் பண்போடு ஒத்துப் போகும் சிறுகதை எது?", "media_id": null}], "options": {"A": "சாப விமோசனம்", "B": "தலைக்குளம்", "C": "கோடை மழை", "D": "உரிமைத்தாகம்"}, "explanation": "வள்ளலாரின் அனைத்துயிரொன்றிய கருணை உணர்வைப் பிரதிபலிக்கும் வகையில் அமைந்த துணைப்பாடக் கதை 'கோடை மழை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which supplementary short story harmonizes directly with Ramalinga Vallalar's universal compassion: 'I withered whenever I saw a withered plant'?", "media_id": null}], "options": {"A": "Saaba Vimosanam", "B": "Thalaikkulam", "C": "Kodai Mazhai", "D": "Urimai Thaagam"}, "explanation": "'Kodai Mazhai' echoes Vallalar's Jeevakaarunyam: intuitive sorrow upon witnessing suffering and spontaneous kindness."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 208, "chapter": null, "section": null, "reference": "12th Tamil, Uni