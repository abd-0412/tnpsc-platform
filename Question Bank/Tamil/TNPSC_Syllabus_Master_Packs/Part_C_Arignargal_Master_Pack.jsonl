{"id": "9th-u2-q072", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-02-periyapuranam", "chapter_id": null, "topic_id": "topic-periyapuranam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தடவரை' - இச்சொல்லிற்குரிய இலக்கணக்குறிப்பு யாது?", "media_id": null}], "options": {"A": "பண்புத்தொகை", "B": "வினைத்தொகை", "C": "உவமைத்தொகை", "D": "உரிச்சொல் தொடர்"}, "explanation": "'தட' என்பது உரிச்சொல் (பெரிய என்ற பொருள் தரும்). எனவே 'தடவரை' என்பது உரிச்சொல் தொடர் ஆகும். (தட - பெரிய, வரை - மலை)."}, "en": {"blocks": [{"type": "text", "content": "What is the grammatical term for 'Thadavarai'?", "media_id": null}], "options": {"A": "Panputhogai (Qualitative compound)", "B": "Vinaithogai (Verbal compound)", "C": "Uvamaithogai (Simile compound)", "D": "Urichol thodar (Adverbial / root prefix phrase)"}, "explanation": "'Thada' is an urichol meaning large/grand, hence 'Thadavarai' is an Urichol Thodar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 31, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 31", "url": null, "source_notes": null}, "previous_year": {"is_pr