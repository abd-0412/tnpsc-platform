{"id": "12th_tamil_u6_q998", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thiraimozhi", "chapter_id": null, "topic_id": "cinematic_language_essence", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திரைப்படத்திற்குரிய முதன்மையான மொழி எது?", "media_id": null}], "options": {"A": "வசன மொழி மட்டுமே", "B": "காட்சி மொழி (Visual Language)", "C": "பாடல்கள் மட்டுமே", "D": "பின்னணி இசை மட்டுமே"}, "explanation": "திரைப்படம் என்பது அடிப்படையில் காட்சி ஊடகமாகும். சொற்களை விடக் காட்சிகளின் வழியே கதையையும் உணர்வுகளையும் கடத்துவதே 'காட்சி மொழி' (Visual Language) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the primary, essential expressive language of cinema as an artistic medium?", "media_id": null}], "options": {"A": "Verbal dialogue alone", "B": "Visual Language (Kaatchi Mozhi)", "C": "Musical lyrics alone", "D": "Background score alone"}, "explanation": "Visual language—communicating narrative through imagery—is the core grammar of cinema."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 131, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page