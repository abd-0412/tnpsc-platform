{"id": "11th_tamil_u6_q047", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "bronze_deities_list", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இராஜராஜ சோழன் தஞ்சைப் பெரிய கோயிலுக்குச் செய்வித்துக் கொடுத்த செப்புத் திருமேனிகளுள் முதன்மையானது எது?", "media_id": null}], "options": {"A": "புத்தர் சிலை", "B": "சமண தீர்த்தங்கரர் சிலை", "C": "ஆடவல்லான் (நடராஜர்), பிச்சாடனர், திரிபுராந்தகர் மற்றும் தஞ்சை விடங்கர் திருமேனிகள்", "D": "துர்க்கை சிலை மட்டுமே"}, "explanation": "இராஜராஜன் ஆடவல்லான் (நடராஜர்), சந்திரசேகரர், பிச்சாடனர் முதலான எழில்மிகு செப்புத் திருமேனிகளைச் செய்வித்து அணிகலன்களையும் வழங்கிப் போற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Which were among the foremost bronze icons commissioned by Rajaraja Chola for the Big Temple?", "media_id": null}], "options": {"A": "Buddha statues", "B": "Jain Tirthankaras", "C": "Aadavallan (Nataraja), Bhikshatana, Tripurantaka, and Thanjai Vidangar", "D": "Durga icon only"}, "explanation": "Rajaraja consecrated master bronzes including Aadavallan, Tripurantaka, and Bhikshatana."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "clas