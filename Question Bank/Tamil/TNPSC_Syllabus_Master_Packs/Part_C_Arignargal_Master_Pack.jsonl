{"id": "11th_tamil_u8_q111", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_muthukumar", "chapter_id": null, "topic_id": "muthukumar_verse_rhythm", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நா. முத்துக்குமாரின் கவிதைகளில் காணப்படும் தனித்துவமான நடையியல் நயம் யாது?", "media_id": null}], "options": {"A": "கடினமான இலக்கணச் சூத்திரங்கள்", "B": "பழைய வெண்பா மரபு", "C": "உள்ளத்தைத் தொடும் எளிய வரிகள், காட்சிப் படிமங்கள் (Visual imagery), தத்துவார்த்த வினாக்கள்", "D": "வடமொழிச் சொல் அடுக்குகள்"}, "explanation": "எளிய அன்றாடச் சொற்களில் ஆழமான தத்துவத்தையும், திரைப்படக் காட்சிப் படிமங்கள் போன்ற காட்சிகளையும் அமைப்பது நா. முத்துக்குமாரின் கவிதைச் சிறப்பியல்பாகும்."}, "en": {"blocks": [{"type": "text", "content": "What distinctive stylistic trait characterizes Na. Muthukumar's poetry?", "media_id": null}], "options": {"A": "Arduous grammatical sutras", "B": "Rigid archaic Venba metrical forms", "C": "Heart-stirring accessible diction, vivid visual imagery, and searching philosophical inquiries", "D": "Sanskritized ornate cadences"}, "explanation": "His hallmark lies in evocative visual imagery and touching everyday lyricism loaded with existential depth."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil 