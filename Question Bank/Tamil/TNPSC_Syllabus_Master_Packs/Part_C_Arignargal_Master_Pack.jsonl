{"id": "11th_tamil_u7_q094", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "udharan_scaffold_quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தமிழுக்கு நிலவென்று பேர் - இன்பத் தமிழெங்கள் சமூகத்தின் விளைவுக்கு நீர்' - இவ்வடிகள் கொலைக்களத்தில் உதாரனின் வாயிலாக எதனை வெளிப்படுத்துகின்றன?", "media_id": null}], "options": {"A": "மரணம் பற்றிய பயத்தை", "B": "சாகும் தருவாயிலும் தமிழ் மொழியே தன் வாழ்வின் உயிர்நாடி என்ற பாவேந்தரின் அளப்பரிய தமிழ்ப்பற்றை", "C": "இயற்கை வர்ணனையை மட்டும்", "D": "அரசனைப் புகழ்வதை"}, "explanation": "மரணத்தின் வாசலிலும் தமிழ் மொழியின் உயிர்ப்பையும், தமிழ் சமுதாயத்தின் வளர்ச்சியையுமே பாவேந்தர் உதாரனின் குரலில் முழங்கச் செய்கிறார்."}, "en": {"blocks": [{"type": "text", "content": "What does Udharan singing 'Thamizhukku Nilavendru Per...' at the foot of the scaffold reveal?", "media_id": null}], "options": {"A": "Dread of death", "B": "Bharathidasan profound devotion to Tamil as the lifeblood of human dignity even in the face of death", "C": "Simple pastoral nature imagery", "D": "Royal adulation"}, "explanation": "It embodies the indomitable ethos where devotion to mother tongue transcends mortality."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Ka