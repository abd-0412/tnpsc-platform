{"id": "10th-u1-q112", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "urai_nadaiyin_aninangal", "chapter_id": null, "topic_id": "prose_summary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உரைநடையின் அணிநலன்கள் பாடத்தில் வெளிப்படும் மையக்கருத்து யாது?", "media_id": null}], "options": {"A": "சங்க இலக்கியமே சிறந்தது", "B": "நவீன உரைநடை செய்யுளை விடத் தாழ்ந்தது", "C": "மொழி மாற்றங்கள் தேவையற்றவை", "D": "செய்யுளின் அழகிய அணிகள் கால மாற்றத்தால் உரைநடையிலும் புதுப்பொலிவுடன் திகழ்கின்றன"}, "explanation": "பழங்காலச் செய்யுள்களில் அமைந்த அணிநலன்கள் யாவும் காலத்தின் வளர்ச்சிக்கு ஏற்ப நவீன உரைநடையிலும் சிறப்பான இலக்கிய நயங்களுடன் மிளிர்கின்றன என்பதே இதன் மையக்கருத்தாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the central core message of \"Urainadaiyin Aninalangal\"?", "media_id": null}], "options": {"A": "Sangam verse alone is supreme", "B": "Modern prose is inferior to verse", "C": "Linguistic evolution is unnecessary", "D": "Classical poetic figures have evolved into brilliant modern prose ornaments"}, "explanation": "It demonstrates how traditional aesthetic poetic devices have vibrantly evolved and enriched modern prose."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook a