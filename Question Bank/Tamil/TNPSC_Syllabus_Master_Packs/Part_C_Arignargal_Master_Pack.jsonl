{"id": "10th-u2-q029", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "ketkiratha_en_kural", "chapter_id": null, "topic_id": "hippalus_discovery", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கி.பி. முதல் நூற்றாண்டில் பருவக்காற்றின் உதவியால் நடுக்கடல் வழியாக முசிறித் துறைமுகத்திற்கு விரைவாகப் பயணம் செய்யும் வழியைக் கண்டுபிடித்த கிரேக்க மாலுமி யார்?", "media_id": null}], "options": {"A": "ஹிப்பாலஸ் (Hippalus)", "B": "தாலமி", "C": "ஸ்ட்ராபோ", "D": "பிளினி"}, "explanation": "கிரேக்க மாலுமியான ஹிப்பாலஸ் பருவக்காற்றின் துணைகொண்டு முசிறிக்கு நேரடிப் பெருங்கடல் வழியைக் கண்டுபிடித்தார். அதனால் அப்பருவக்காற்றுக்கு ஹிப்பாலஸ் பருவக்காற்று எனப் பெயரிடப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which Greek mariner discovered the direct trans-oceanic monsoon route to the ancient Chera port of Musiri in the 1st century AD?", "media_id": null}], "options": {"A": "Hippalus", "B": "Ptolemy", "C": "Strabo", "D": "Pliny the Elder"}, "explanation": "The navigator Hippalus determined the monsoon wind patterns facilitating swift sea voyages directly to Musiri."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition":