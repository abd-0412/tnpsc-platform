{"id": "11th_tamil_u1_q123", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "supplementary_aaraam_thinai", "chapter_id": null, "topic_id": "pyq_muthulingam_awards", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] ‘வம்சவிருத்தி’ என்னும் சிறுகதைத் தொகுதிக்காக தமிழக அரசின் பரிசு பெற்ற ஈழத்து எழுத்தாளர் யார்?", "media_id": null}], "options": {"A": "எஸ். பொன்னுத்துரை", "B": "டானியல்", "C": "அ. முத்துலிங்கம்", "D": "தெளிவத்தை ஜோசப்"}, "explanation": "அ. முத்துலிங்கம் வம்சவிருத்தி சிறுகதைத் தொகுதிக்காக 1996-ல் தமிழக அரசு பரிசு பெற்றார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Which Sri Lankan Tamil author won the Tamil Nadu State Government Award for the short story collection 'Vamsaviruththi'?", "media_id": null}], "options": {"A": "S. Ponnuthurai", "B": "Daniel", "C": "A. Muthulingam", "D": "Thelivaththai Joseph"}, "explanation": "A. Muthulingam was conferred the Tamil Nadu State Award in 1996 for 'Vamsaviruththi'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 10, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 10", "url": null