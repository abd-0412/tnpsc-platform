{"id": "11th_tamil_u4_q139", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "supplementary_ithazhaalar_bharathi", "chapter_id": null, "topic_id": "bharathi_translator_role", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுதேசமித்திரன் இதழில் பாரதியார் செய்த முதன்மையான சர்வதேச இதழியல் பணி யாது?", "media_id": null}], "options": {"A": "விளம்பரங்கள் வரைந்தது", "B": "சினிமா விமர்சனம் செய்தது", "C": "சர்வதேசச் செய்திகளையும், ராய்ட்டர்ஸ் (Reuters) தந்திச் செய்திகளையும் உடனுக்குடன் தமிழில் மொழிபெயர்த்து வெளியிட்டது", "D": "சோதிடக் குறிப்புகள் எழுதியது"}, "explanation": "உலக நிகழ்வுகளையும், சர்வதேச விடுதலைப் போராட்டங்களையும், ராய்ட்டர்ஸ் ஆங்கிலச் செய்திகளையும் கணநேரத்தில் இனிய தமிழில் மொழிபெயர்த்து வழங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "What critical editorial responsibility did Bharati execute with distinction at Swadesamitran?", "media_id": null}], "options": {"A": "Drawing commercial adverts", "B": "Film gossip reviews", "C": "Rapidly translating international telegraphic dispatches from Reuters into crisp Tamil", "D": "Astrology columns"}, "explanation": "Bharati translated international Reuters telegraphic news rapidly into idiomatic Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher":