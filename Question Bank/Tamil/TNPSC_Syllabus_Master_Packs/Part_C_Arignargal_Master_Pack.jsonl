{"id": "6th-t3-u2-034", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): மனிதன் இயற்கையின் ஒரு பகுதியே அன்றி இயற்கையின் எஜமான் அல்ல என்பதைச் சியாட்டல் உணர்த்துகிறார்.\nகாரணம் (R): மனிதன் வாழ்வதற்காகப் பின்னிய வலை அல்ல இயற்கை; அவன் அந்த வலையின் ஒரு இழை மட்டுமே.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று மற்றும் காரணம் இரண்டும் சரி; சரியான விளக்கம்", "C": "கூற்று தவறு, காரணம் சரி", "D": "இரண்டும் தவறு"}, "explanation": "வாழ்க்கை வலையை மனிதன் நெய்யவில்லை, அவன் அதில் ஒரு இழை மட்டுமே என்பது சியாட்டலின் பொன்மொழி."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "மனிதன் இயற்கையின் ஒரு பகுதியே அன்றி இயற்கையின் எஜமான் அல்ல என்பதைச் சியாட்டல் உணர்த்துகிறார்.", "reason": "மனிதன் வாழ்வதற்காகப் பின்னிய வலை அல்ல இயற்கை; அவன் அந்த வலையின் ஒரு இழை மட்டுமே.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "3", "edition": "2024-2025", "publication_year": "2025", "page