{"id": "11th_tamil_u1_q058", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "patron_king", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பவணந்தி முனிவரை நன்னூலை இயற்றுமாறு வேண்டிக்கொண்ட சிற்றரசன் யார்?", "media_id": null}], "options": {"A": "வல்லாள தேவன்", "B": "சீயகங்கன்", "C": "குலோத்துங்க சோழன்", "D": "அதியமான்"}, "explanation": "கங்க வம்சத்து சிற்றரசனான சீயகங்கன் கேட்டுக்கொண்டதற்கு இணங்கவே பவணந்தி முனிவர் நன்னூலை இயற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Which chieftain requested Pavanandhi Munivar to compose the grammar text 'Nannool'?", "media_id": null}], "options": {"A": "Vallala Devan", "B": "Seeyagangan", "C": "Kulothunga Cholan", "D": "Athiyaman"}, "explanation": "At the humble request of Ganga dynasty chieftain Seeyagangan, Pavanandhi Munivar composed Nannool."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 6", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": n