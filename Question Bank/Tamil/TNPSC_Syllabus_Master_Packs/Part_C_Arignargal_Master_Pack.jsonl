{"id": "12th_tamil_u7_q1210", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "theyilai_thotta_paattu", "chapter_id": null, "topic_id": "kangani_exploitation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தேயிலைத் தோட்டப் பாடலில் எளிய தமிழ் மக்களைப் பொய் ஆசை வார்த்தைகள் கூறி இலங்கைக்கு அழைத்துச் சென்று ஏமாற்றியவர்கள் யார்?", "media_id": null}], "options": {"A": "ஆங்கில அதிகாரிகள் மட்டுமே", "B": "கங்காணிகள் (தரகர்கள்)", "C": "மன்னர்கள்", "D": "வணிகர்கள்"}, "explanation": "தமிழகத்தில் பஞ்சம் நிலவிய காலத்தில் ஆசை வார்த்தைகள் கூறி மக்களை இலங்கைக்கு அழைத்துச் சென்று கொத்தடிமைகளாக விற்ற இடைத்தரகர்கள் 'கங்காணிகள்' எனப்பட்டனர்."}, "en": {"blocks": [{"type": "text", "content": "Who were the predatory recruitment sub-agents who lured impoverished Tamil peasants into bonded labor in Ceylon?", "media_id": null}], "options": {"A": "British colonels directly", "B": "Kangaanis (Labor broker overseers)", "C": "Feudal rajahs", "D": "Retail peddlers"}, "explanation": "Kangaanis were labor recruiting intermediaries who trapped starving Tamil families into indentured tea plantation serfdom."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_