{"id": "10th-u2-q057", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "kaatre_vaa", "chapter_id": null, "topic_id": "author_info", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"காற்றே, வா! மகரந்தத் தூளைச் சுமந்துகொண்டு, மனத்தை மயலுறுத்துகின்ற இனிய வாசனையுடன் வா\" - என்ற பாடலின் ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "மகாகவி பாரதியார்", "B": "பாரதிதாசன்", "C": "கவிமணி தேசிக விநாயகம்", "D": "நாமக்கல் கவிஞர்"}, "explanation": "\"காற்றே வா!\" என்னும் இக்கவிதையை இயற்றியவர் மகாகவி சுப்பிரமணிய பாரதியார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the poetic verse: \"Kaatre, vaa! Magarantha thoolai sumanthukondu...\"?", "media_id": null}], "options": {"A": "Mahakavi Bharathiyar", "B": "Bharathidasan", "C": "Kavimani Desiga Vinayagam", "D": "Namakkal Kavignar"}, "explanation": "Mahakavi Subramania Bharathiyar authored the celebrated prose-poem \"Kaatre Vaa!\"."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 32, "chapter": null, "section": null, "reference": "10th Tamil, Unit 2, Page 32", "url": null, "source_notes": null}, "previous_year": {"is_prev