{"id": "10th-u9-q090", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "kuppusamy_illness", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிறுகதையில் குப்புசாமியை வாட்டிய கொடிய நோய் எது?", "media_id": null}], "options": {"A": "மலேரியா", "B": "காசநோய் (க்ஷயரோகம் / T.B.)", "C": "காலரா", "D": "டைபாய்டு"}, "explanation": "பாடநூல் குறிப்பு: குப்புசாமி தீராத காசநோயினால் (க்ஷயரோகம்) உடம்பு இளைத்து, எழுந்து நடக்கக் கூட இயலாமல் படுக்கையிலேயே முடங்கிக் கிடந்தான்."}, "en": {"blocks": [{"type": "text", "content": "Which debilitating disease afflicted Kuppusamy in the story?", "media_id": null}], "options": {"A": "Malaria", "B": "Tuberculosis (TB / Kshayaroagam)", "C": "Cholera", "D": "Typhoid"}, "explanation": "He was bedridden due to severe Tuberculosis."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 206, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 206", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null},