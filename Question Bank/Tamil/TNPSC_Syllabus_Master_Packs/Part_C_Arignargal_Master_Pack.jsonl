{"id": "12th_tamil_u7_q1194", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "risk_management_kural", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வருமுன்னர்க் காவாதான் வாழ்க்கை எரிமுன்னர், வைத்தூறு போலக் கெடும்’ - இக்குறள் உணர்த்தும் மேலாண்மைத் தத்துவம் எது?", "media_id": null}], "options": {"A": "விபத்து காப்பீடு மட்டும்", "B": "இடர் மேலாண்மை / முன்னெச்சரிக்கை மேலாண்மை (Risk Management & Foresight)", "C": "பயிர்ப் பாதுகாப்பு", "D": "நெருப்பு அணைத்தல்"}, "explanation": "துன்பம் அல்லது இழப்பு வருவதற்கு முன்னரே திட்டமிட்டுத் தற்காத்துக் கொள்ளாதவனின் வாழ்க்கை நெருப்பின் முன் வைக்கோல்போர் எரிவது போல அழியும் என்பது 'இடர் மேலாண்மை' (Risk Management) விதியாகும்."}, "en": {"blocks": [{"type": "text", "content": "What modern corporate strategy is illuminated by 'Varumunnark kaavaadhaan vaazhkkai erimunnar vaiththooru polak kedum'?", "media_id": null}], "options": {"A": "Casualty insurance purchase only", "B": "Proactive Risk Management and Contingency Foresight", "C": "Pesticide spraying", "D": "Firefighting"}, "explanation": "Proactive risk management averts catastrophic ruin before a crisis strikes."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 159, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 159", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Prose", "Risk Management"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1195", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "motivation_in_management", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நவீன மேலாண்மையில் பணியாளர்களை உற்சாகப்படுத்தி ஊக்கப்படுத்தும் ‘ஊக்கப்படுத்துதல்’ (Motivation) கோட்பாட்டை வள்ளுவர் எவ்வாறு குறிப்பிடுகிறார்?", "media_id": null}], "options": {"A": "அச்சப்படுத்துதல்", "B": "தண்டித்தல்", "C": "‘ஊக்கம் உடைமை’ (வெள்ளத் தனைய மலர்நீட்டம் மாந்தர்தம், உள்ளத் தனையது உயர்வு)", "D": "கடன் கொடுத்தல்"}, "explanation": "நீரின் உயரத்திற்கு ஏற்பத் தாமரை மலர்வது போல, ஒரு மனிதனின் உள்ளத்து ஊக்கத்திற்கு ஏற்பவே அவனது வாழ்வும் நிறுவனமும் உயரும் என்று ஊக்கமுடைமையைப் போற்றுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "How does Thiruvalluvar articulate the employee Motivation dynamic in leadership poetics?", "media_id": null}], "options": {"A": "Intimidation", "B": "Punitive fines", "C": "Ukkam Udaimai ('Vellath thanaiya malarneettam maanthartham ullath thanaiyathu uyarvu')", "D": "Credit lending"}, "explanation": "A person's true stature rises in exact proportion to the caliber of their internal motivation (Ukkam)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 159, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 159", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Prose", "Motivation"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1196", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "administrative_leadership_qualities", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அஞ்சாமை ஈகை அறிவுஊக்கம் இந்நான்கும், எஞ்சாமை வேந்தற்கியல்பு’ - நிருவாகத் தலைவருக்குரிய நான்கு அடிப்படைத் தகுதிகளாக வள்ளுவர் எவற்றைக் கூறுகிறார்?", "media_id": null}], "options": {"A": "அழகு, இளமை, செல்வம், சொல்வன்மை", "B": "வாள்வீச்சு, வில்வித்தை, குதிரையேற்றம், யானையேற்றம்", "C": "அடக்கம், அமைதி, தனிமை, தியானம்", "D": "அஞ்சாமை (துணிவு), ஈகை (கொடை), அறிவு (ஞானம்), ஊக்கம் (விடாமுயற்சி)"}, "explanation": "ஒரு நாட்டின் மன்னனுக்கோ அல்லது நிறுவனத்தின் தலைவருக்கோ துணிவு (அஞ்சாமை), கொடைத்தன்மை, நுட்பமான அறிவு, தளராத ஊக்கம் ஆகிய நான்கும் இன்றியமையாத பண்புகளாகும்."}, "en": {"blocks": [{"type": "text", "content": "What four irreducible executive leadership qualities are prescribed by Valluvar in 'Anjaamai eegai arivu-ookkam innaangum...'?", "media_id": null}], "options": {"A": "Beauty, youth, wealth, and eloquence", "B": "Swordsmanship, archery, equitation, and elephant riding", "C": "Meekness, quietude, reclusiveness, and trance", "D": "Moral courage (Anjaamai), Generosity (Eegai), Intellect (Arivu), and Dynamic persistence (Ukkam)"}, "explanation": "Executive leadership rests upon Moral Courage, Generosity, Deep Intellect, and Dynamic Energy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_se