{"id": "11th_tamil_u3_q052", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kaavadichindu", "chapter_id": null, "topic_id": "folk_instruments_kaavadi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காவடிச்சிந்து பாடல்களுக்குரிய முதன்மையான நாட்டுப்புற பக்கவாத்தியங்கள் எவை?", "media_id": null}], "options": {"A": "வயலின் மற்றும் கிதார்", "B": "பியானோ மற்றும் ஆர்மோனியம்", "C": "வீணை மற்றும் தம்பூரா", "D": "தவில், நையாண்டி மேளம் மற்றும் உடுக்கை"}, "explanation": "காவடி ஆட்டத்திற்கு விறுவிறுப்பூட்டும் தவில், நையாண்டி மேளம், நாதசுவரம், பம்பை, உடுக்கை போன்றவை முதன்மை பக்கவாத்தியங்கள் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which traditional folk instruments traditionally accompany the dynamic ecstasy of Kaavadichindu performances?", "media_id": null}], "options": {"A": "Violin and Western guitar", "B": "Grand piano and harmonium", "C": "Veena and Tambura", "D": "Thavil, Naiyandi Melam, and Udukkai"}, "explanation": "Thavil, Naiyandi Melam, and Udukkai furnish the pulsating rhythmic bedrock of Kaavadi dance."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 49, "chapter": 