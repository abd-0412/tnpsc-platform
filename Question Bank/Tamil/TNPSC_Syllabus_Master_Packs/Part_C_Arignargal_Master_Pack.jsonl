{"id": "11th_tamil_u3_q030", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "poem_kaavadichindu", "chapter_id": null, "topic_id": "shrine_celebrated", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அண்ணாமலையார் இயற்றிய காவடிச்சிந்து எந்த ஊரில் எழுந்தருளியுள்ள முருகன் மீது பாடப்பட்டது?", "media_id": null}], "options": {"A": "திருச்செந்தூர்", "B": "கழுகுமலை (கழுகாசலபதி கோவில்)", "C": "பழனி", "D": "சுவாமிமலை"}, "explanation": "தூத்துக்குடி மாவட்டம் கோவில்பட்டி அருகிலுள்ள கழுகுமலை முருகன் கோவில் (கழுகாசலபதி) மீது பாடப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which sacred hill temple of Lord Murugan is celebrated in Annamalaiyar's Kaavadichindu?", "media_id": null}], "options": {"A": "Thiruchendur", "B": "Kazhugumalai (Kazhugasalamoorthy Temple)", "C": "Palani", "D": "Swamimalai"}, "explanation": "The song eulogizes Lord Murugan enshrined at the rock-cut hill shrine of Kazhugumalai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 49, "chapter": null, "section": null, "reference": "11th Tamil, Unit 3, Page 49", "url": null, "source_notes": null}, "previous_year": {"is_pr