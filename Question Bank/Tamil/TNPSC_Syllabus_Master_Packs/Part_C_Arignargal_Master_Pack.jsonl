{"id": "11th_tamil_u2_q121", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "supplementary_yanai_doctor", "chapter_id": null, "topic_id": "dr_k_global_work", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "டாக்டர் வி. கிருஷ்ணமூர்த்தி எந்தெந்த வெளிநாடுகளில் யானைகள் பாதுகாப்புப் பணிக்காக அழைக்கப்பட்டார்?", "media_id": null}], "options": {"A": "கென்யா உள்ளிட்ட ஆப்பிரிக்க நாடுகள், மற்றும் அஸ்ஸாம், அந்தமான்", "B": "அமெரிக்கா மற்றும் கனடா மட்டுமே", "C": "இங்கிலாந்து மற்றும் ஜெர்மனி மட்டுமே", "D": "ஆஸ்திரேலியா மட்டுமே"}, "explanation": "டாக்டர் கே ஆப்பிரிக்காவின் கென்யா, இந்தியாவின் அஸ்ஸாம், மேற்கு வங்கம், அந்தமான் எனப் பல சர்வதேசக் களங்களில் யானைகளுக்காகப் பணியாற்றியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "To which international and domestic regions was Dr. V. Krishnamoorthy summoned for expert elephant conservation?", "media_id": null}], "options": {"A": "African nations including Kenya, as well as Assam, West Bengal, and the Andamans", "B": "USA and Canada exclusively", "C": "UK and Germany solely", "D": "Australia alone"}, "explanation": "He worked across Kenya, Assam, and the Andaman Islands managing wild elephant herds."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Edu