{"id": "10th-u9-q022", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "jayakanthan", "chapter_id": null, "topic_id": "novel_oru_manithan_oru_veedu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மனித உறவுகளின் ஆழத்தையும் விருந்தோம்பலின் மாண்பையும் விளக்கும் ஜெயகாந்தனின் புகழ்பெற்ற நாவல் எது?", "media_id": null}], "options": {"A": "கோகிலா என்ன செய்துவிட்டாள்?", "B": "ஒரு மனிதன் ஒரு வீடு ஒரு உலகம்", "C": "ரிஷிமூலம்", "D": "சுந்தர காண்டம்"}, "explanation": "பாடநூல் மற்றும் கூடுதல் குறிப்பு: ஹென்றி என்ற கதாபாத்திரத்தை மையமாகக் கொண்டு உலகளாவிய மானுடப் பார்வையை முன்வைத்த நாவல் \"ஒரு மனிதன் ஒரு வீடு ஒரு உலகம்\"."}, "en": {"blocks": [{"type": "text", "content": "Which celebrated novel by Jayakanthan weaves universal human hospitality centered on character Henry?", "media_id": null}], "options": {"A": "Kokila Enna Seithuvittaal?", "B": "Oru Manithan Oru Veedu Oru Ulagam", "C": "Rishimoolam", "D": "Sundara Kandam"}, "explanation": "Oru Manithan Oru Veedu Oru Ulagam represents his humanitarian zenith."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 199, "chapter": null, "section": null, "refer