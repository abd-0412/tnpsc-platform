{"id": "9th-u8-q040", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-moral-message", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தந்தை பெரியார் மக்கள் வாழ வேண்டிய நெறியாகப் போதித்த இரு கண்கள் எவை?", "media_id": null}], "options": {"A": "பணமும் பதவியும்", "B": "அழகும் இளமையும்", "C": "சொத்தும் நிலமும்", "D": "மானமும் அறிவும்"}, "explanation": "பாடநூலின் முகப்பில்: 'மானமும் அறிவும் கொண்டவர்களாகத் தமிழர்கள் வாழ வேண்டும் என்று அரும்பாடுபட்டவர் தந்தை பெரியார்' என்று தெளிவாகக் குறிப்பிடப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "What two essential virtues did Thanthai Periyar uphold as the twin eyes of an enlightened human life?", "media_id": null}], "options": {"A": "Wealth and power", "B": "Beauty and youth", "C": "Property and land", "D": "Self-respect and intellect (மானமும் அறிவும்)"}, "explanation": "Periyar proclaimed that self-respect (Maanam) and rational intellect (Arivu) are the indispensable attributes of human life."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 154, "chapter": null, "se