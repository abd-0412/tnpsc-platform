{"id": "6th-t3-u1-020", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தாராபாரதி 'கவிஞாயிறு' என்று சிறப்பிக்கப்படுகிறார்.\nகாரணம் (R): இவர் தமிழகத்தின் முதல் அரசவைக் கவிஞராகப் பணியாற்றியவர்.", "media_id": null}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று சரி, ஆனால் காரணம் சரியான விளக்கமல்ல", "D": "கூற்று (A) சரி, ஆனால் காரணம் (R) முற்றிலும் தவறு"}, "explanation": "தாராபாரதி கவிஞாயிறு எனப் போற்றப்படுவது சரி; ஆனால் தமிழகத்தின் முதல் அரசவைக் கவிஞர் நாமக்கல் கவிஞர் வெ. இராமலிங்கம் பிள்ளை ஆவார். எனவே காரணம் தவறானது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "தாராபாரதி 'கவிஞாயிறு' என்று சிறப்பிக்கப்படுகிறார்.", "reason": "இவர் தமிழகத்தின் முதல் அரசவைக் கவிஞராகப் பணியாற்றியவர்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "3", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "ref