{"id": "11th_tamil_u4_q032", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "dpi_formation_1854", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "1854-ஆம் ஆண்டு உட் அறிக்கையின் பரிந்துரையின்படி தமிழ்நாட்டில் உருவாக்கப்பட்ட அரசு கல்வி நிர்வாக அமைப்பு எது?", "media_id": null}], "options": {"A": "பல்கலைக்கழக மானியக் குழு", "B": "தேர்வு வாரியம்", "C": "தொழில்நுட்பக் கல்வி இயக்குநரகம்", "D": "பொதுக்கல்வித் துறை / பொதுக்கல்வி இயக்குநர் (DPI - Director of Public Instruction)"}, "explanation": "உட் அறிக்கையின்படி மாநிலம்தோறும் பொதுக்கல்வித் துறை (DPI) உருவாக்கப்பட்டு கல்வி நிர்வாகம் ஒருங்கிணைக்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which administrative department was instituted in Madras following Wood's Despatch recommendations?", "media_id": null}], "options": {"A": "University Grants Commission", "B": "Board of Secondary Examinations", "C": "Directorate of Technical Education", "D": "Department of Public Instruction (headed by the DPI)"}, "explanation": "The Department of Public Instruction (DPI) was instituted to govern provincial education."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educationa