{"id": "12th_tamil_u8_q1469", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kodai_mazhai", "chapter_id": null, "topic_id": "story_conclusion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கோடை மழை’ சிறுகதை வாசகருக்கு உணர்த்தி நிற்கும் நிலையான படிப்பினை யாது?", "media_id": null}], "options": {"A": "துன்புறும் எளிய மக்களுக்கு நாம் செய்யும் சிறு உதவியும் அவர்களின் வாழ்வில் பெரும் கோடை மழையாக மாறும்", "B": "கோடை காலத்தில் வெளியே செல்லக் கூடாது", "C": "மழைக் காலத்தில் மட்டுமே உதவி செய்ய வேண்டும்", "D": "பணத்தைச் சேமிக்க வேண்டும்"}, "explanation": "எளியோருக்குச் செய்யும் அன்பான சிறு உதவியும் கூட அவர்களின் வறண்ட வாழ்வில் அமிர்த மழை போன்ற பெரும் விளைவைத் தரும்."}, "en": {"blocks": [{"type": "text", "content": "What enduring moral lesson does 'Kodai Mazhai' impart to the reader?", "media_id": null}], "options": {"A": "Even the smallest act of kindness extended to suffering individuals can transform their weary lives like blessed summer rain", "B": "Never venture outdoors during summer", "C": "Offer help strictly during rainy seasons", "D": "Accumulate financial savings"}, "explanation": "A tiny spark of compassion can transform another soul's scorched existential landscape."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publi