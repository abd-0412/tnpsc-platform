{"id": "9th-u8-q005", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "self-respect-movement-year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மக்களிடையே சுயமரியாதை உணர்வை ஏற்படுத்தத் தந்தை பெரியார் சுயமரியாதை இயக்கத்தைத் தொடங்கிய ஆண்டு எது?", "media_id": null}], "options": {"A": "1925", "B": "1938", "C": "1944", "D": "1919"}, "explanation": "சமூகத்தில் சாதி, மதப் பாகுபாடுகளை ஒழித்து, தன்மானமும் சுயமரியாதையும் கொண்ட சமுதாயத்தை உருவாக்க 1925-ஆம் ஆண்டில் பெரியார் சுயமரியாதை இயக்கத்தைத் தொடங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "In which year did Thanthai Periyar establish the historic Self-Respect Movement (சுயமரியாதை இயக்கம்)?", "media_id": null}], "options": {"A": "1925", "B": "1938", "C": "1944", "D": "1919"}, "explanation": "Periyar founded the revolutionary Self-Respect Movement in 1925 to advocate human dignity and rationalism."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 155, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 155", "url": null, "source_notes": null}, "previous_year": 