{"id": "9th-u1-q069", "schema_version": "1.0", "kind": "quote_completion", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-02-tamilvidu-thoothu", "chapter_id": null, "topic_id": "topic-sevigal-unavaana-line", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'செவிகள் உணவான நன்சுவை அமுதத்தை நுகர்ந்தோர் யார்?' என்று தமிழ்விடு தூது கூறுகிறது?", "media_id": null}], "options": {"A": "சான்றோர்கள் (புலவர்கள்)", "B": "விண்ணுலக முத்தேவர்கள்", "C": "பொதுமக்கள்", "D": "அரசர்கள்"}, "explanation": "பாடலின் பொருள்: விண்ணில் உள்ள தேவர்கள் உண்ணும் அமுதத்தை விடச் சான்றோர்களின் செவிகளுக்குத் தமிழே நன்சுவை விருந்தாக அமைகிறது."}, "en": {"blocks": [{"type": "text", "content": "According to Tamilvidu Thoothu, who are the fortunate connoisseurs who relish Tamil as the divine ambrosia for their ears?", "media_id": null}], "options": {"A": "Learned Scholars and Sages (சான்றோர்கள்)", "B": "Celestial Trinity Gods of Heaven", "C": "Commoners", "D": "Monarchs and Emperors"}, "explanation": "The poem states that while gods consume heavenly nectar, true scholars partake in the immortal nectar of Tamil through their ears."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["tamilvidu_thoothu", "comprehension", "quote_completion"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u1-q072", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-02-tamilvidu-thoothu", "chapter_id": null, "topic_id": "topic-uvesa-year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உ.வே. சாமிநாதையர் தமிழ்விடு தூது நூலை அச்சேற்றிய ஆண்டு எது?", "media_id": null}], "options": {"A": "1920", "B": "1925", "C": "1928", "D": "1930"}, "explanation": "பாடநூல் பக். 3 நூல் வெளி: 'இந்நூலை 1930-இல் உ.வே.சா. முதன்முதலில் பதிப்பித்தார்'."}, "en": {"blocks": [{"type": "text", "content": "In which year did U.V. Swaminatha Iyer publish the first printed edition of Tamilvidu Thoothu?", "media_id": null}], "options": {"A": "1920", "B": "1925", "C": "1928", "D": "1930"}, "explanation": "Textbook page 3 confirms that U.Ve.Sa printed and released Tamilvidu Thoothu in 1930."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 3", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["tamilvidu_thoothu", "uvesa", "publication_year"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u1-q073", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-02-tamilvidu-thoothu", "chapter_id": null, "topic_id": "topic-poetic-colors-vannangal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் பெற்றுள்ள 'நூறு வண்ணங்கள்' குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. மனிதரால் உண்டாக்கப்பட்ட வண்ணங்கள் வெண்மை, செம்மை, கருமை, பொன்மை, பசுமை என ஐந்தே ஆகும்.\n2. புலவர்கள் கண்ட தமிழின் வண்ணங்கள் குறில், அகவல், தூங்கிசை, மெல்லிசை உள்ளிட்ட நூறு வண்ணங்களைக் கொண்டதாகும்.\n3. தமிழ்விடு தூது பாடலில் கூறப்படும் நூறு வண்ணங்கள் ஓவியக் கலைக்குரிய வண்ணங்களாகும்.\nமேற்கண்ட கூற்றுகளுள் சரியானவை எவை?", "media_id": null}], "options": {"A": "1, 2 மட்டும் சரி", "B": "2, 3 மட்டும் சரி", "C": "1, 3 மட்டும் சரி", "D": "அனைத்தும் சரி"}, "explanation": "பாடநூல் பொருள்: தமிழின் நூறு வண்ணங்கள் என்பது செய்யுளின் ஓசை மற்றும் சந்த நயங்களைக் குறிக்கும் (ஓவிய வண்ணங்கள் அல்ல; கூற்று 3 தவறு). 1 மற்றும் 2 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements regarding the 'Hundred Poetic Colors' (நூறு வண்ணங்கள்) of Tamil:\n1. Man-made visual colors are strictly five: White, Red, Black, Yellow, and Green.\n2. Ancient Tamil bards discovered one hundred prosodic rhythms/colors (Vannangal) like Kuril, Agaval, Thoongisai, and Mellisai.\n3. The hundred colors described in Tamilvidu Thoothu refer to visual oil painting pigments.\nWhich statements are correct?", "media_id": null}], "options": {"A": "1 and 2 only are correct", "B": "2 and 3 only are correct", "C": "1 and 3 only are correct", "D": "All are correct"}, "explanation": "In Tamil poetics, 'Vannam' signifies rhythmic acoustic cadences (not painting paints). Statements 1 and 2 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["tamilvidu_thoothu", "poetic_rhythms", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u1-q074", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-02-tamilvidu-thoothu", "chapter_id": null, "topic_id": "topic-thoothu-request", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்விடு தூதில் தலைவி, மதுரை சொக்கநாதரிடம் சென்று தமிழிடம் என்ன வாங்கி வருமாறு வேண்டுகோள் விடுக்கிறாள்?", "media_id": null}], "options": {"A": "மாணிக்க மணிமாலை", "B": "வேப்பம்பூ மாலை", "C": "பொற்றாமரை மாலை", "D": "செண்பகப்பூ மாலை"}, "explanation": "பாடநூல் பக். 2: மதுரை சொக்கநாதர் சூடியுள்ள 'வேப்பம்பூ மாலையை' வாங்கி வருமாறு தமிழாகிய தூதினிடம் தலைவி அன்போடு வேண்டுகிறாள்."}, "en": {"blocks": [{"type": "text", "content": "In Tamilvidu Thoothu, what token of love does the heroine instruct the Tamil emissary to secure from Lord Chokkanathar of Madurai?", "media_id": null}], "options": {"A": "Ruby garland", "B": "Neem flower garland (வேப்பம்பூ மாலை)", "C": "Golden Lotus garland", "D": "Champaka flower garland"}, "explanation": "The heroine beseeches the Tamil emissary to fetch the cool fragrant garland of neem blossoms worn by Lord Chokkanathar of the Pandya realm."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["tamilvidu_thoothu", "neem_garland", "direct_mcq"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u1-q075", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-02-tamilvidu-thoothu", "chapter_id": null, "topic_id": "topic-tamilin-perumai-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தமிழ்விடு தூது தமிழில் உள்ள பிற சிற்றிலக்கியங்களை விடச் சொல்நயமும் பொருள்நயமும் மிகுந்து விளங்குகிறது.\nகாரணம் (R): அஃறிணைப் பொருள்களைத் தூது விடுவதற்குப் பதிலாக, உயர்தனிச் செம்மொழியான தமிழையே தூதுப் பொருளாகக் கொண்டு பாடப்பட்ட ஒப்பற்ற நூல் இதுவாகும்.", "media_id": null}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "B": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு"}, "explanation": "பிற தூது நூல்கள் அன்னம், வண்டு ஆகியவற்றைத் தூது விட்டபோது, தமிழ்விடு தூது தமிழை உயர்த்தித் தமிழையே தூதுப் பொருளாக ஆக்கியதால் தனிச்சிறப்புப் பெறுகிறது. கூற்று மற்றும் காரணம் இரண்டும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Tamilvidu Thoothu stands out uniquely among all 96 genres of minor Tamil literature for its poetic resonance and grandeur.\nReason (R): Instead of mundane birds or insects, it elevates the classical Tamil language itself as the sacred celestial emissary.", "media_id": null}], "options": {"A": "(A) is true, but (R) is false", "B": "(A) is false, but (R) is true", "C": "Both (A) and (R) are true, and (R) correctly explains (A)", "D": "Both (A) and (R) are false"}, "explanation": "Choosing the language itself as the beloved messenger imparts peerless literary glory to Tamilvidu Thoothu. Both statements are true."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["tamilvidu_thoothu", "literary_significance", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u1-q076", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-02-tamilvidu-thoothu", "chapter_id": null, "topic_id": "topic-kolvaar-koduppaai-meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'குறமென்றும் பள்ளென்றும் கொள்வார் கொடுப்பாய்க்கு' — இதில் 'கொள்வார் கொடுப்பாய்' என்பதன் விளக்கம் என்ன?", "media_id": null}], "options": {"A": "வணிகர்கள் பண்டமாற்று செய்தல்", "B": "பரிசிலர் அரசரிடம் பொருள் பெறுதல்", "C": "பக்தர்கள் இறைவனிடம் வரம் வேண்டுதல்", "D": "புலவர்கள் பாடிப் பெறவும், அவர்கள் சுவைக்கக் கொடுக்கவும் பெற்ற பெருமை"}, "explanation": "பாடநூல் உரை: குறவஞ்சி, பள்ளு முதலான நூல்களைப் பாடிப் புலவர்கள் பரிசில் பெறுவர்; அத்தகைய நூல்களைப் புலவர்களுக்குத் தந்து சுவைக்கக் கொடுப்பவள் தமிழ்த்தாய்."}, "en": {"blocks": [{"type": "text", "content": "In the line 'Kuramendrum Pallendrum Kolvaar Koduppaaykku', what is the exact literary significance of 'Kolvaar Koduppaai'?", "media_id": null}], "options": {"A": "Merchants bartering commodities", "B": "Bards asking kings for cattle", "C": "Devotees pleading for boons", "D": "Scholars who compose Kuravanji and Pallu receiving rewards, as Tamil generously supplies literary wealth for them"}, "explanation": "It refers to Tamil bountifully yielding dramatic texts like Kuravanji and Pallu for poets to sing, enjoy, and receive accolades."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["tamilvidu_thoothu", "textual_meaning", "direct_mcq"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u1-q079", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-02-tamilvidu-thoothu", "chapter_id": null, "topic_id": "topic-author-anonymity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்விடு தூது நூலை இயற்றிய ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "குமரகுருபரர்", "B": "பலபட்டடைச் சொக்கநாதப் புலவர்", "C": "ஆசிரியர் பெயர் அறியப்படவில்லை", "D": "ஒட்டக்கூத்தர்"}, "explanation": "பாடநூல் பக். 3 நூல் வெளி: 'இந்நூலின் ஆசிரியர் யார் என்பதை அறிய முடியவில்லை'."}, "en": {"blocks": [{"type": "text", "content": "Who is the celebrated author of the classical text Tamilvidu Thoothu?", "media_id": null}], "options": {"A": "Kumaragurubarar", "B": "Balapattadai Chokkanatha Pulavar", "C": "Author is unknown (Anonymous)", "D": "Ottakoothar"}, "explanation": "The author of Tamilvidu Thoothu remains anonymous, as documented on page 3."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 3", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null,