{"id": "6th-t2-u2-022", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கடலோடு விளையாடு' பாடலின் உருவகங்களைப் பொருத்துக:\nபட்டியல் I:\n(a) விடிவெள்ளி\n(b) மணல்\n(c) புயல்\n(d) பனிமூட்டம்\n\nபட்டியல் II:\n1. உடல் போர்வை\n2. ஊஞ்சல்\n3. பஞ்சுமெத்தை\n4. நம் விளக்கு", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-4, (b)-3, (c)-2, (d)-1", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-2, (b)-1, (c)-4, (d)-3"}, "explanation": "விடிவெள்ளி - நம் விளக்கு (4); மணல் - பஞ்சுமெத்தை (3); புயல் - ஊஞ்சல் (2); பனிமூட்டம் - உடல் போர்வை (1). சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 29", "url": null, "source_notes": null}, "previous_year": {"is_pr