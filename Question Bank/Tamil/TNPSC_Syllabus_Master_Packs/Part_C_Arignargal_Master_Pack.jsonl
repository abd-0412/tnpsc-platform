{"id": "9th-u7-q010", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "jhansi-rani-regiment-leader", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்திய தேசிய இராணுவத்தில் பெண்களுக்காக உருவாக்கப்பட்ட 'ஜான்சி ராணி படைப்பிரிவின்' தலைவராக நியமிக்கப்பட்ட தமிழர் யார்?", "media_id": null}], "options": {"A": "அன்னி பெசன்ட்", "B": "டாக்டர் கேப்டன் லட்சுமி சுவாமிநாதன்", "C": "வேலு நாச்சியார்", "D": "தில்லையாடி வள்ளியம்மை"}, "explanation": "இந்திய தேசிய இராணுவத்தில் பெண்களுக்காகத் தொடங்கப்பட்ட ஜான்சி ராணி படைப்பிரிவின் தளபதியாகத் தமிழர் டாக்டர் கேப்டன் லட்சுமி செயல்பட்டார்."}, "en": {"blocks": [{"type": "text", "content": "Which patriotic Tamil physician was appointed as the supreme commander of the INA's historic all-women 'Rani of Jhansi Regiment'?", "media_id": null}], "options": {"A": "Annie Besant", "B": "Dr. Captain Lakshmi Swaminathan (கேப்டன் லட்சுமி)", "C": "Velu Nachiyar", "D": "Thillaiyadi Valliammai"}, "explanation": "Dr. Captain Lakshmi headed the iconic Rani of Jhansi Regiment, leading fearless women soldiers into battle."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_yea