{"id": "10th-u9-q069", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "thembavani", "chapter_id": null, "topic_id": "tamil_name_dhairiyanathar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கான்ஸ்டன்டைன் ஜோசப் பெஸ்கி தமிழகம் வந்ததும் தம் பெயரை முதலில் எவ்வாறு மாற்றிக் கொண்டார்?", "media_id": null}], "options": {"A": "தைரியநாதர் (பின்னர் வீரமாமுனிவர் என மாற்றினார்)", "B": "செந்தமிழ்ச் செல்வர்", "C": "ஞானப்பிரகாசர்", "D": "கருணாமிர்தர்"}, "explanation": "பாடநூல் குறிப்பு: தனது பெயரான கான்ஸ்டன்டைன் (துணிவுடையவன்) என்பதைத் தமிழில் மொழிபெயர்த்து முதலில் \"தைரியநாதர்\" என்றும், பின்னர் தமிழ்ப்பற்றினால் \"வீரமாமுனிவர்\" என்றும் அமைத்துக் கொண்டார்."}, "en": {"blocks": [{"type": "text", "content": "What was the initial Tamil translation of Constantine adopted by Beschi before choosing Veeramamunivar?", "media_id": null}], "options": {"A": "Dhairiyanathar", "B": "Senthamizh Chelvar", "C": "Gnanaprakasar", "D": "Karunamirthar"}, "explanation": "He initially styled himself Dhairiyanathar before finalizing Veeramamunivar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 205, "chapter": null, "