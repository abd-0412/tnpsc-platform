{"id": "12th_tamil_u7_q1177", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "author_iraiyanbu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘இலக்கியத்தில் மேலாண்மை’ என்னும் உரைநடைப் பகுதியை எழுதிய எழுத்தாளர் மற்றும் முன்னாள் தலைமைச் செயலாளர் யார்?", "media_id": null}], "options": {"A": "முனைவர் வெ. இறையன்பு இ.ஆ.ப.", "B": "ஐராவதம் மகாதேவன்", "C": "பக்தவத்சல பாரதி", "D": "மயிலை சீனி. வேங்கடசாமி"}, "explanation": "தமிழ் இலக்கியங்களில் பொதிந்துள்ள மேலாண்மைக் கருத்துகளைத் தொகுத்து 'இலக்கியத்தில் மேலாண்மை' என்ற கட்டுரையை எழுதியவர் முனைவர் வெ. இறையன்பு இ.ஆ.ப. ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who is the author of the administrative essay 'Management in Literature' and former Chief Secretary of Tamil Nadu?", "media_id": null}], "options": {"A": "Dr. V. Irai Anbu I.A.S.", "B": "Iravatham Mahadevan", "C": "Bhakthavatsala Bharathi", "D": "Mayilai Seeni. Venkatasamy"}, "explanation": "Dr. V. Irai Anbu I.A.S. authored the acclaimed administrative treatise 'Management in Literature'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "20