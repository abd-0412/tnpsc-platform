{"id": "9th-u8-q048", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-unmai-journal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தந்தை பெரியார் தொடங்கிய 'உண்மை' என்னும் இதழின் தலையாய பணி யாது?", "media_id": null}], "options": {"A": "திரைப்பட விமர்சனம் செய்வது", "B": "விளையாட்டுச் செய்திகளை வெளியிடுவது", "C": "வணிக விளம்பரங்களை வெளியிடுவது", "D": "சமூக மூடநம்பிக்கைகளைத் தகர்த்து அறிவியல் மற்றும் பகுத்தறிவுக் கருத்துகளைப் பரப்புவது"}, "explanation": "'உண்மை' என்னும் இருமுறை இதழ் மூடநம்பிக்கைகளைத் தகர்த்து, அறிவியல் உண்மைகளையும் பகுத்தறிவுக் கொள்கைகளையும் மக்களிடம் கொண்டுசேர்க்கும் பணியைச் செய்தது."}, "en": {"blocks": [{"type": "text", "content": "What was the primary editorial mission of Periyar's ideological periodical 'Unmai' (உண்மை - Truth)?", "media_id": null}], "options": {"A": "Cinema gossip reviews", "B": "Sports reportage", "C": "Commercial advertising", "D": "Debunking superstitious myths and disseminating scientific, rationalist truths"}, "explanation": "'Unmai' was dedicated to scientific journalism, rational analysis, and unmasking social myths."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services 