{"id": "9th-u9-q111", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l4", "chapter_id": null, "topic_id": "diaspora-tamil-experience", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'புயலிலே ஒரு தோணி' விரிவானப் பகுதி உணர்த்தும் தமிழர்களின் வரலாற்று உண்மை யாது?", "media_id": null}], "options": {"A": "தமிழர்கள் வெளிநாடுகளுக்குச் செல்லவே இல்லை", "B": "தமிழர்கள் கடற்பயணங்களில் அச்சம் கொண்டவர்கள்", "C": "வாழ்வாதாரத்திற்காகவும் வணிகத்திற்காகவும் கடல் கடந்து சென்று உலகெங்கும் துன்பங்களை வென்று வாழ்ந்த தமிழர்களின் பேராண்மை", "D": "தமிழர்கள் கப்பல் கட்டும் கலையை அறியாதவர்கள்"}, "explanation": "இக்கதை புலம்பெயர்ந்த ஈழ, தமிழகத் தமிழர்கள் தென்கிழக்காசிய நாடுகளில் உழைத்து, கடற்பயண ஆபத்துகளையும் உலகப்போர் நெருக்கடிகளையும் எதிர்கொண்டு வாழ்ந்த வீர வரலாற்றைப் பறைசாற்றுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What historical reality regarding the global Tamil diaspora is reflected in this narrative?", "media_id": null}], "options": {"A": "Tamils never journeyed beyond their home territories", "B": "Tamils were terrified of sea voyages", "C": "The fortitude of Tamils crossing stormy oceans to build livelihoods globally, overcoming perils and wars", "D": "Tamils lacked shipbuilding expertise"}, "explanation": "It chronicles the resilience of Tamils venturing overseas amidst maritime peril and war."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": fal