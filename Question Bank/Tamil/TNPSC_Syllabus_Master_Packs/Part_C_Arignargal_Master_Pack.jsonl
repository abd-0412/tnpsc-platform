{"id": "10th-u7-q023", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "silappathikaram_conferences", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ம. பொ. சிவஞானம் அவர்கள் தமிழகத்தில் சிலப்பதிகாரத்தை மக்களிடம் கொண்டு சேர்க்க ஆண்டுதோறும் நடத்திய விழா எது?", "media_id": null}], "options": {"A": "பொங்கல் விழா", "B": "கம்பன் விழா", "C": "சிலப்பதிகார விழா (சிலப்பதிகார மாநாடுகள்)", "D": "பாரதி விழா"}, "explanation": "ம. பொ. சி அவர்கள் 1950 முதல் ஆண்டுதோறும் தொடர்ந்து சிலப்பதிகார மாநாடுகளை நடத்தி, பொதுமக்களிடையே தமிழ்த் தேசிய உணர்வை ஊட்டினார்."}, "en": {"blocks": [{"type": "text", "content": "Which annual cultural congress was spearheaded across Tamil Nadu by M. P. Sivagnanam from 1950 onward?", "media_id": null}], "options": {"A": "Pongal Festival", "B": "Kamban Vizha", "C": "Silappathikara Vizha (Silappathikaram Conferences)", "D": "Bharathi Vizha"}, "explanation": "He organized annual Silappathikara Vizhas to foster Tamil unity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 151, "chapter": null, "section": null, "reference": "10th Tamil, 