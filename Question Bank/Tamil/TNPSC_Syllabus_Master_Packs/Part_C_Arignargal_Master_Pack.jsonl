{"id": "11th_tamil_u8_q002", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "prose_tagore_letters", "chapter_id": null, "topic_id": "tagore_nobel_prize", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரவீந்திரநாத் தாகூருக்கு எந்த ஆண்டு, எந்த இலக்கியப் படைப்பிற்காக இலக்கியத்திற்கான நோபல் பரிசு வழங்கப்பட்டது?", "media_id": null}], "options": {"A": "1911 - கோரா", "B": "1913 - கீதாஞ்சலி (Gitanjali)", "C": "1915 - தபால் நிலையம் (The Post Office)", "D": "1919 - காபூலிவாலா"}, "explanation": "1913-ஆம் ஆண்டு தாகூரின் புகழ்பெற்ற கவிதைத் தொகுப்பான 'கீதாஞ்சலி'க்கு ஆசியாவிலேயே முதன்முதலாக இலக்கியத்திற்கான நோபல் பரிசு வழங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "In which year and for which seminal literary work was Rabindranath Tagore awarded the Nobel Prize in Literature?", "media_id": null}], "options": {"A": "1911 - Gora", "B": "1913 - Gitanjali (Song Offerings)", "C": "1915 - The Post Office", "D": "1919 - Kabuliwala"}, "explanation": "Tagore won the Nobel Prize in Literature in 1913 for his poetry collection Gitanjali."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 178