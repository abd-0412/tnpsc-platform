{"id": "6th-t3-u1-030", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நா. வானமாமலை குறித்த கூற்றுகளை ஆராய்க:\n1. இவர் நாட்டுப்புறவியல் ஆய்வில் முன்னோடிகளுள் ஒருவர்.\n2. கட்டபொம்மன் கதைப்பாடல்கள், முத்துப்பட்டன் கதை முதலான பல கதைப்பாடல்களைத் தொகுத்துப் பதிப்பித்துள்ளார்.", "media_id": null}], "options": {"A": "கூற்று 1 தவறு, கூற்று 2 சரி", "B": "கூற்று 1, 2 இரண்டும் சரி", "C": "கூற்று 1 சரி, கூற்று 2 தவறு", "D": "இரண்டும் தவறு"}, "explanation": "நா. வானமாமலை தமிழ் நாட்டுப்புறப் பாடல்களையும் கதைப்பாடல்களையும் ஆய்வு செய்து வெளியிட்ட தலைசிறந்த ஆய்வாளர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "இவர் நாட்டுப்புறவியல் ஆய்வில் முன்னோடிகளுள் ஒருவர்.", "content_en": null}, {"id": "S2", "content_ta": "கட்டபொம்மன் கதைப்பாடல்கள், முத்துப்பட்டன் கதை முதலான பல கதைப்பாடல்களைத் தொகுத்துப் பதிப்பித்துள்ளார்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpor