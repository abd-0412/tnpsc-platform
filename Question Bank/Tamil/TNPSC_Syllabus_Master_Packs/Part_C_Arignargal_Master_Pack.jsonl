{"id": "9th-u7-q051", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "chennai-central-jail-history", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "INA இளைஞர்கள் 18 பேர் தூக்கிலிடப்பட்ட சென்னை சிறைச்சாலை எது?", "media_id": null}], "options": {"A": "மதுரை மத்திய சிறை", "B": "பாளையங்கோட்டை சிறை", "C": "சென்னை மத்திய சிறைச்சாலை", "D": "வேலூர் சிறை"}, "explanation": "1943 முதல் 1945 வரையிலான காலகட்டத்தில் சென்னை மத்திய சிறையில் (Chennai Central Prison) 18 இளம் வீரர்கள் தூக்கிலிடப்பட்டனர்."}, "en": {"blocks": [{"type": "text", "content": "In which historic penal institution were the 18 INA young heroes executed by hanging?", "media_id": null}], "options": {"A": "Madurai Central Prison", "B": "Palayamkottai Prison", "C": "Chennai Central Prison (சென்னை மத்திய சிறை)", "D": "Vellore Prison"}, "explanation": "The colonial government carried out the death sentences of the 18 INA youths at Chennai Central Prison."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 133, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 133", "url