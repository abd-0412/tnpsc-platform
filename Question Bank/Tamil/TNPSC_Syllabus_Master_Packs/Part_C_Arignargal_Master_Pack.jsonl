{"id": "12th_tamil_u7_q1197", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "quality_control_management", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தயாரிக்கப்படும் பொருளின் தரத்தை உறுதி செய்யும் ‘தரக் கட்டுப்பாடு’ (Quality Control) கோட்பாட்டிற்கு இக்கட்டுரையில் எந்த சங்க இலக்கியக் குறிப்பு காட்டப்படுகிறது?", "media_id": null}], "options": {"A": "பொன்னை உரைகல்லில் உரசி மாற்றுப் பார்க்கும் தமிழரின் பொன் உரைத்தல் மரபு", "B": "மீன் பிடித்தல்", "C": "மண்பாண்டம் செய்தல்", "D": "நெசவு செய்தல்"}, "explanation": "பொன்னின் தரத்தை உரைகல்லில் உரசி அதன் மாற்றுக் குறையாத தரத்தை உறுதி செய்யும் சங்க காலப் பொற்கொல்லர் மரபு, தரக் கட்டுப்பாட்டு மேலாண்மைக்கு (Quality Control) உன்னத உதாரணமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which Sangam metallurgical custom illustrates the industrial doctrine of Quality Control?", "media_id": null}], "options": {"A": "Testing gold purity against a traditional touchstone (Uraikal) to certify carat quality", "B": "Deep-sea fishing", "C": "Pottery baking", "D": "Cotton spinning"}, "explanation": "Assaying gold purity against a touchstone exemplifies ancient quality control systems."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 159, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 159", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Prose", "Quality Control"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1198", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "uraiyanbu_radio_broadcasts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெ. இறையன்பு அவர்கள் அகில இந்திய வானொலியில் ஆற்றிய உரைகள் எந்தத் தலைப்பில் நூலாகத் தொகுக்கப்பட்டுள்ளன?", "media_id": null}], "options": {"A": "வானொலி விருந்து", "B": "சிந்தனை அரங்கம் / ஒலிக்கும் அமைதி", "C": "வானொலிக் கதைகள்", "D": "இனிய காலை"}, "explanation": "வெ. இறையன்பு வானொலியில் இளைஞர்களுக்கு தன்னம்பிக்கை ஊட்டும் வண்ணம் ஆற்றிய பல்வேறு சிந்தனை உரைகள் நூல்களாக வெளிவந்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Under what thematic publications were Dr. Irai Anbu's motivational All India Radio broadcasts compiled?", "media_id": null}], "options": {"A": "Radio Feast", "B": "Chinthani Arangam / Thought Spectrum Essays", "C": "Radio Fiction", "D": "Sweet Dawn"}, "explanation": "His motivational radio lectures were compiled into reflective philosophical essays."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 160", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Prose", "Radio Broadcasts"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1199", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "ethics_in_management", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மேலாண்மையில் ‘அறநெறி’ (Ethics) எத்தகைய முக்கியத்துவம் வாய்ந்தது என்று ஆசிரியர் விளக்குகிறார்?", "media_id": null}], "options": {"A": "லாபம் ஈட்டுவதே முதன்மை, அறநெறி தேவையில்லை", "B": "அறநெறி சட்டத்திற்குப் புறம்பானது", "C": "அறநெறியற்ற மேலாண்மை எவ்வளவு பெரிய நிறுவனமாயினும் அதை வீழ்ச்சி அடையச் செய்யும்", "D": "விளம்பரத்திற்கு மட்டுமே அறநெறி பயன்படும்"}, "explanation": "வணிகத்திலோ நிருவாகத்திலோ நெறிமுறைகளும் அறமும் (Ethics) இல்லாத போது அந்நிறுவனம் நீண்ட காலம் நிலைக்க முடியாது; அறமே நிலைத்த வெற்றியைத் தரும் என்பதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What indispensability does Corporate Ethics hold according to the managerial teachings of the essay?", "media_id": null}], "options": {"A": "Profit justifies all means; ethics is unnecessary", "B": "Ethics violates commercial law", "C": "Management devoid of moral ethics inevitably collapses regardless of company scale", "D": "Ethics is purely for PR publicity"}, "explanation": "Unethical management structures are inherently fragile and bound to collapse over time."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 159, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 159", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Prose", "Business Ethics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1200", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "chola_irrigation_management", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சோழப் பேரரசின் மாபெரும் நீர் மேலாண்மைச் சாதனையாக உலக வரலாற்றில் இன்றளவும் போற்றப்படும் கட்டுமானம் எது?", "media_id": null}], "options": {"A": "மேட்டூர் அணை", "B": "வைகை அணை", "C": "பவானிசாகர் அணை", "D": "கல்லணை (கரிகால் சோழன் கட்டிய 2000 ஆண்டு காலப் பழமையான அணை)"}, "explanation": "காவிரியின் பெருவெள்ளத்தைத் தடுத்துக் கொள்ளிடத்தில் திருப்பி, பாசனத்திற்குப் பயன்படுத்தக் கரிகாலன் கட்டிய கல்லணையே உலகின் தலைசிறந்த நீர் மேலாண்மைப் பொறியியல் அற்புதமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which 2,000-year-old engineering feat constructed by King Karikala Chola is internationally celebrated as hydraulic management?", "media_id": null}], "options": {"A": "Mettur Dam", "B": "Vaigai Dam", "C": "Bhavanisagar Dam", "D": "Kallanai (The Grand Anicut across River Cauvery)"}, "explanation": "Kallanai stands as one of the world's oldest functional water diversion and hydraulic management dams."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 160", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Prose", "Kallanai Engineering"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1202", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "ilakkiyaththil_melaanmai", "chapter_id": null, "topic_id": "uraiyanbu_chief_secretary_tenure", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முனைவர் வெ. இறையன்பு அவர்கள் தமிழ்நாடு அரசின் எத்தனையாவது தலைமைச் செயலாளராகப் பணியாற்றி ஓய்வு பெற்றார்?", "media_id": null}], "options": {"A": "நாற்பதாவது", "B": "நாற்பத்தேழாவது (47-ஆவது தலைமைச் செயலாளர்)", "C": "ஐம்பதாவது", "D": "முப்பத்தைந்தாவது"}, "explanation": "வெ. இறையன்பு தமிழ்நாடு அரசின் 47-ஆவது தலைமைச் செயலாளராக 2021 முதல் 2023 வரை மிகச் சிறப்பாகப் பணியாற்றி ஓய்வு பெற்றார்."}, "en": {"blocks": [{"type": "text", "content": "As which Chief Secretary of the Government of Tamil Nadu did Dr. V. Irai Anbu I.A.S. serve with distinction?", "media_id": null}], "options": {"A": "40th Chief Secretary", "B": "47th Chief Secretary (2021 to 2023)", "C": "50th Chief Secretary", "D": "35th Chief Secretary"}, "explanation": "Dr. Irai Anbu served as the 47th Chief Secretary of Tamil Nadu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "ref