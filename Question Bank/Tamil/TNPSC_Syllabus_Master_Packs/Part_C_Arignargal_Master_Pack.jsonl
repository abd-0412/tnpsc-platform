{"id": "10th-u4-q020", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "seyarkai_nunnarivu", "chapter_id": null, "topic_id": "tamil_nlp", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் மொழியில் செயற்கை நுண்ணறிவைப் புகுத்துவதற்குத் தமிழ்நாடு அரசால் நிறுவப்பட்ட நிறுவனம் எது?", "media_id": null}], "options": {"A": "தமிழ் வளர்ச்சித் துறை", "B": "உலகத் தமிழ்ச் சங்கம்", "C": "சாகித்திய அகாதெமி", "D": "தமிழ் இணையக் கல்விக்கழகம் (Tamil Virtual Academy)"}, "explanation": "தமிழ் இணையக் கல்விக்கழகம் தமிழ் மொழிக்கான இயற்கை மொழி ஆய்வு (NLP) மற்றும் AI மென்பொருள்களை உருவாக்கி வருகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which nodal governmental institution in Tamil Nadu spearheads Tamil Natural Language Processing (NLP) and AI digital initiatives?", "media_id": null}], "options": {"A": "Tamil Development Board", "B": "World Tamil Sangam", "C": "Sahitya Akademi", "D": "Tamil Virtual Academy (Thamizh Inaiya Kalvikkazhagam)"}, "explanation": "Tamil Virtual Academy coordinates Tamil computational linguistics and AI tools."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 75, "chapter