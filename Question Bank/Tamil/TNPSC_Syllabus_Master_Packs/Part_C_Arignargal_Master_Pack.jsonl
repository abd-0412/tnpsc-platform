{"id": "10th-u8-q138", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "paa_vagai", "chapter_id": null, "topic_id": "adi_types_count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சீர்கள் பல தொடர்ந்து வருவது \"அடி\" எனப்படும். யாப்பிலக்கணத்தில் அடிகள் எத்தனை வகைப்படும்?", "media_id": null}], "options": {"A": "3", "B": "5 வகைப்படும் (குறளடி, சிந்தடி, அளவடி, நெடிலடி, கழிநெடிலடி)", "C": "4", "D": "6"}, "explanation": "பாடநூல் குறிப்பு: சீர்களின் எண்ணிக்கைக்கு ஏற்ப அடி 5 வகைப்படும் (2 சீர் - குரளடி, 3 சீர் - சிந்தடி, 4 சீர் - அளவடி, 5 சீர் - நெடிலடி, 6 அல்லது அதற்கு மேற்பட்ட சீர் - கழிநெடிலடி)."}, "en": {"blocks": [{"type": "text", "content": "How many types of metrical lines (Adi) exist based on foot count?", "media_id": null}], "options": {"A": "3", "B": "5 types (Kuraladi, Sindhadhi, Alavadi, Nediladi, Kazhinediladi)", "C": "4", "D": "6"}, "explanation": "There are 5 types of poetic lines."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 188, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 188", "url": null, "source_notes": null}, "previous_year": {"is_previ