{"id": "12th_tamil_u2_q251", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "piragoru_naal_kodai", "chapter_id": null, "topic_id": "neervazhipadooum_sangam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘நீர்வழிப்படூஉம்’ என்னும் தொடர் முதன்முதலில் இடம்பெற்ற சங்க இலக்கிய நூல் எது?", "media_id": null}], "options": {"A": "நற்றிணை", "B": "குறுந்தொகை", "C": "புறநானூறு (கணியன் பூங்குன்றனார் பாடல்)", "D": "அகநானூறு"}, "explanation": "‘யாதும் ஊரே யாவரும் கேளிர்... நீர்வழிப்படூஉம் புணைபோல் ஆருயிர் முறைவழிப் படூஉம்’ எனப் புறநானூற்றில் கணியன் பூங்குன்றனார் பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "In which classical Sangam anthology did the celebrated phrase 'Neervazhip Padooum' originate?", "media_id": null}], "options": {"A": "Narrinai", "B": "Kurunthogai", "C": "Purananuru (Kaniyan Poongundranar's poem)", "D": "Akananuru"}, "explanation": "Kaniyan Poongundranar coined 'Neervazhip padooum punai pol' in Purananuru verse 192."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": "12th Tamil, Unit 2, Page 30", "url": null, "s