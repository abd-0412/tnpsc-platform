{"id": "9th-u8-q015", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-thrift-simplicity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தந்தை பெரியார் தனது வாழ்நாள் முழுவதும் கடைப்பிடித்த அருங்குணங்களாகப் பாடநூல் குறிப்பிடுவது எவை?", "media_id": null}], "options": {"A": "ஆடம்பரம் மற்றும் விழாக்கள்", "B": "அரண்மனை வாழ்வு மற்றும் அலங்காரம்", "C": "சிக்கனம் மற்றும் எளிமை", "D": "அமைதி மற்றும் துறவு"}, "explanation": "பெரியார் பொதுப்பணத்திலும் தன் சொந்த வாழ்க்கையிலும் சல்லிக்காசு கூட வீணாகக் கூடாது என்பதில் கண்ணும் கருத்துமாக இருந்து 'சிக்கனம்' என்னும் அருங்குணத்தைப் பெரிதும் கடைப்பிடித்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which personal virtues did Thanthai Periyar rigorously adhere to throughout his life according to the textbook?", "media_id": null}], "options": {"A": "Extravagance and luxury", "B": "Palatial splendor and ornamentation", "C": "Thrift and austere simplicity (சிக்கனம் மற்றும் எளிமை)", "D": "Reclusive asceticism"}, "explanation": "Periyar practiced strict frugality and exemplary simplicity in personal and public funds."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Service