{"id": "12th_tamil_mp2_q1790", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "agananooru_poets_count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அகநானூற்றுப் பாடல்களைப் பாடிய புலவர்களின் மொத்த எண்ணிக்கை யாது?", "media_id": null}], "options": {"A": "86 புலவர்கள்", "B": "145 புலவர்கள்", "C": "205 புலவர்கள்", "D": "300 புலவர்கள்"}, "explanation": "அகநானூற்றில் உள்ள 400 பாடல்களை 145 புலவர்கள் பாடியுள்ளனர்."}, "en": {"blocks": [{"type": "text", "content": "How many poets contributed the verses compiled in Agananooru?", "media_id": null}], "options": {"A": "86 poets", "B": "145 poets", "C": "205 poets", "D": "300 poets"}, "explanation": "A total of 145 different poets composed the 400 verses found in Agananooru."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 112, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 112", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 1", "Agananooru"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp2_q1791", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "silappathikaram_stage_curtains", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகார நாட்டிய அரங்கில் பயன்படுத்தப்பட்ட மூன்று வகையான திரைகள் எவை?", "media_id": null}], "options": {"A": "வெள்ளைத் திரை, சிவப்பைத் திரை, பச்சைத் திரை", "B": "முன்திரை, இடைத்திரை, பின்திரை", "C": "ஒருமுக எழினி, பொருமுக எழினி, கரந்துவரல் எழினி", "D": "வட்ட எழினி, நீள் எழினி, குறு எழினி"}, "explanation": "நாட்டிய அரங்கில் மேடையின் ஒரு பக்கத்திலிருந்து மறுபக்கம் செல்லும் 'ஒருமுக எழினி', இரு பக்கத்திலிருந்தும் நடுவில் இணையும் 'பொருமுக எழினி', மேலிருந்து கீழே இறங்கும் 'கரந்துவரல் எழினி' ஆகியவை பயன்படுத்தப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "Which three types of stage curtains were utilized in the classical Tamil theater described in Silappathikaram?", "media_id": null}], "options": {"A": "White curtain, Red curtain, Green curtain", "B": "Front screen, Middle screen, Back screen", "C": "Orymukha Ezhini, Porumukha Ezhini, Karanthuvaral Ezhini", "D": "Circular screen, Long screen, Short screen"}, "explanation": "The stage featured single-draw curtains (Orymukha), double-center parting curtains (Porumukha), and overhead drop-curtains (Karanthuvaral)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 129, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 129", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 1", "Silappathikaram Theater"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

