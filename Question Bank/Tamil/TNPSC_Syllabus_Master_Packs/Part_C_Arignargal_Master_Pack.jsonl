{"id": "12th_tamil_u6_q989", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thiraimozhi", "chapter_id": null, "topic_id": "charlie_chaplin_tramp", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சார்லி சாப்ளின் உலகப் புகழ்பெற்ற தனது எந்த உருவப் பாத்திரத்தின் மூலம் எளிய மக்களின் குரலாக ஒலித்தார்?", "media_id": null}], "options": {"A": "நாடோடி (தி டிராம்ப் - The Tramp)", "B": "அரசர்", "C": "துப்பறிவாளர்", "D": "மந்திரவாதி"}, "explanation": "தலையில் தொப்பி, கையில் ஊன்றுகோல், தளர்ந்த ஆடை, தத்தித் தத்தி நடக்கும் நடை கொண்ட 'நாடோடி' (The Tramp) பாத்திரமே சாப்ளினின் அடையாளமானது."}, "en": {"blocks": [{"type": "text", "content": "Through which world-famous iconic screen persona did Charlie Chaplin champion the dignity of the common man?", "media_id": null}], "options": {"A": "The Little Tramp (Naadodi)", "B": "The Monarch", "C": "The Sleuth", "D": "The Illusionist"}, "explanation": "Chaplin immortalized 'The Tramp', sporting a bowler hat, baggy trousers, and bamboo cane."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 133, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, P