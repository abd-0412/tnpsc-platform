{"id": "9th-u8-q035", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-self-reliance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தந்தை பெரியாரின் வாழ்க்கை நமக்கு உணர்த்தும் தலையாய நற்பண்பு எது?", "media_id": null}], "options": {"A": "பிறரைச் சார்ந்து வாழ்வது", "B": "புகழுக்காகக் கொள்கைகளை மாற்றுவது", "C": "தானே முயன்று கற்று, தானாகவே சிந்தித்து, அஞ்சாமல் தன் கொள்கைகளை வாழ்நாள் முழுவதும் கடைப்பிடித்தல்", "D": "அதிகாரப் பதவிகளைத் தேடி ஓடுவது"}, "explanation": "பாடநூலின் தொடக்கத்தில்: 'தானே முயன்று கற்று, தானாகவே சிந்தித்து அறிவார்ந்த கருத்துகளை வெளியிட்டவர்; எவ்வித சமரசமும் இன்றி கொள்கையில் உறுதியாக நின்றவர்' எனப் போற்றப்படுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What defining personal quality characterizes Periyar's life trajectory according to the textbook?", "media_id": null}], "options": {"A": "Total dependence on patrons", "B": "Compromising principles for fame", "C": "Self-taught erudition, independent thinking, fearless articulation, and steadfast adherence to principles without compromise", "D": "Chasing political offices"}, "explanation": "Periyar's life was defined by independent thought, self-education, and fearless lifelong dedication to human dignity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": 