{"id": "11th_tamil_u1_q113", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "supplementary_aaraam_thinai", "chapter_id": null, "topic_id": "author_origin_muthulingam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஆறாம் திணை’ என்னும் துணைப்பாடக் கதையை எழுதிய அ. முத்துலிங்கம் இலங்கையில் எங்கு பிறந்தார்?", "media_id": null}], "options": {"A": "யாழ்ப்பாணம் கொக்குவில்", "B": "மட்டக்களப்பு காரைதீவு", "C": "மன்னார் பேசாலை", "D": "கண்டி நாவலப்பிட்டி"}, "explanation": "அ. முத்துலிங்கம் இலங்கை யாழ்ப்பாணத்திலுள்ள கொக்குவில் என்னும் கிராமத்தில் பிறந்தவர்."}, "en": {"blocks": [{"type": "text", "content": "Where was A. Muthulingam, author of the supplementary story 'Aaraam Thinai', born in Sri Lanka?", "media_id": null}], "options": {"A": "Kokkuvil, Jaffna", "B": "Karaitheevu, Batticaloa", "C": "Pesalai, Mannar", "D": "Navalapitiya, Kandy"}, "explanation": "Eminent author A. Muthulingam was born in Kokkuvil, Jaffna, Sri Lanka."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 10, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 10", "url": null, "source_notes": null}, "previ