{"id": "11th_tamil_u7_q077", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "love_transcends_caste", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'புரட்சிக்கவி' காப்பியத்தில் உதாரன் - அமுதவல்லியின் காதல் எதனை வென்று நிற்கிறது?", "media_id": null}], "options": {"A": "சாதி, குலம், ஏழை-பணக்காரன் என்னும் வர்க்கப் பாகுபாடுகளைத் தகர்த்து நிற்கும் தூய அன்பின் வெற்றி", "B": "மன்னனின் தந்திரத்தை", "C": "அமைச்சரின் ஆணையை", "D": "பகை நாட்டின் படையை"}, "explanation": "இக்காவியக் காதல் சாதி, குலம், மன்னர்-குடிமக்கள் என்ற வர்க்க எல்லைகளைத் தகர்த்து நிற்கும் சமத்துவக் காதலாக மிளிர்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What does the love between Udharan and Amuthavalli triumph over in 'Puratchikkavi'?", "media_id": null}], "options": {"A": "Shatters caste, royal lineage, and feudal class inequalities, asserting the supremacy of authentic human love", "B": "King cunningness only", "C": "Minister order", "D": "Foreign army"}, "explanation": "Their love transcends class, caste, and aristocratic barriers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edi