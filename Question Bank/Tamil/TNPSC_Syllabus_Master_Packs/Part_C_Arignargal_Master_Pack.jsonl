{"id": "11th_tamil_u6_q113", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "supplementary_isaitthamizhar", "chapter_id": null, "topic_id": "kodumudi_kokilam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கொடுமுடி கோகிலம்' என்றும் 'இசைக்குயில்' என்றும் தமிழக மக்களால் அன்போடு போற்றப்பட்ட இசைப் பேரரசி யார்?", "media_id": null}], "options": {"A": "கே. பி. சுந்தராம்பாள்", "B": "எம். எஸ். சுப்புலட்சுமி", "C": "டி. கே. பட்டம்மாள்", "D": "எம். எல். வசந்தகுமாரி"}, "explanation": "ஈரோடு மாவட்டம் கொடுமுடியில் பிறந்து தம் கணீரென்ற குரல்வளத்தால் நாட்டையே கவர்ந்த கே. பி. சுந்தராம்பாள் 'கொடுமுடி கோகிலம்' எனப் போற்றப்பட்டார்."}, "en": {"blocks": [{"type": "text", "content": "Which legendary vocalist was affectionately revered as 'Kodumudi Kokilam' (The Nightingale of Kodumudi)?", "media_id": null}], "options": {"A": "K. B. Sundarambal", "B": "M. S. Subbulakshmi", "C": "D. K. Pattammal", "D": "M. L. Vasanthakumari"}, "explanation": "K. B. Sundarambal from Kodumudi in Erode was celebrated as 'Kodumudi Kokilam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "r