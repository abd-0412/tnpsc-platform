{"id": "9th-u7-q007", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "provisional-gov-tamil-ministers", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நேதாஜி அமைத்த தற்காலிக அரசில் (Provisional Government) அமைச்சர்களாகப் பணியாற்றிய தமிழர்கள் யார்?", "media_id": null}], "options": {"A": "வ.உ.சி மற்றும் சுப்பிரமணிய பாரதியார்", "B": "ராஜாஜி மற்றும் காமராசர்", "C": "கேப்டன் லட்சுமி மற்றும் சிதம்பரம் லோகநாதன்", "D": "பசும்பொன் தேவர் மற்றும் கக்கன்"}, "explanation": "நேதாஜி அமைத்த தற்காலிக அரசில் டாக்டர் கேப்டன் லட்சுமி மற்றும் சிதம்பரம் லோகநாதன் முதலான தமிழர்கள் முக்கிய அமைச்சர்களாகப் பதவி வகித்தனர்."}, "en": {"blocks": [{"type": "text", "content": "Which prominent Tamils served as cabinet ministers in the Provisional Government of Free India established by Netaji?", "media_id": null}], "options": {"A": "V.O.C and Subramanya Bharathiyar", "B": "Rajaji and Kamarajar", "C": "Captain Lakshmi and Chidambaram Lokanathan (கேப்டன் லட்சுமி, சிதம்பரம் லோகநாதன்)", "D": "Pasumpon Muthuramalingathevar and Kakkan"}, "explanation": "Captain Dr. Lakshmi and Chidambaram Lokanathan served as key ministers in Netaji's Azad Hind provisional government."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalv