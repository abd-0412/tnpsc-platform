{"id": "6th-t1-u2-047", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-6th-u2-iyarkai", "lesson_id": "lesson-03-kizhavanum-kadalum", "chapter_id": null, "topic_id": "topic-characters-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கிழவனும் கடலும்' கதையின் பாத்திரங்களையும் அவற்றின் தன்மைகளையும் பொருத்துக:\nபட்டியல் I:\nஅ) சாண்டியாகோ\nஆ) மனோலின்\nஇ) மார்லின்\nஈ) சுறாக்கள்\nபட்டியல் II:\n1. தூண்டிலில் சிக்கிய மீனைத் தின்றவை\n2. தூண்டிலில் சிக்கிய மிகப்பெரிய மீன்\n3. சாண்டியாகோவிடம் மீன்பிடிக்கப் பயின்ற சிறுவன்\n4. தன்னம்பிக்கைமிக்க முதிய மீனவர்", "media_id": null}], "options": {"A": "அ-4, ஆ-2, இ-3, ஈ-1", "B": "அ-3, ஆ-4, இ-1, ஈ-2", "C": "அ-4, ஆ-3, இ-2, ஈ-1", "D": "அ-2, ஆ-1, இ-4, ஈ-3"}, "explanation": "கதைப் பாத்திரங்கள் பொருத்தம்: சாண்டியாகோ - முதிய மீனவர் (4); மனோலின் - சிறுவன் (3); மார்லின் - பெரிய மீன் (2); சுறாக்கள் - மீனைத் தின்றவை (1). சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": "Match the characters of 'The Old Man and the Sea' with their descriptions:\nList I: (a) Santiago (b) Manolin (c) Marlin (d) Sharks\nList II: 1. Devoured the hooked catch 2. The gigantic fish hooked on the line 3. Boy learning fishing from Santiago 4. Resilient elderly fisherman", "media_id": null}], "options": {"A": "(a)-4, (b)-2, (c)-3, (d)-1", "B": "(a)-3, (b)-4, (c)-1, (d)-2", "C": "(a)-4, (b)-3, (c)-2, (d)-1", "D": "(a)-2, (b)-1, (c)-4, (d)-3"}, "explanation": "Correct order: 4, 3, 2, 1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": ["சாண்டியாகோ", "மனோலின்", "மார்லின்", "சுறாக்கள்"], "right": ["முதிய மீனவர்", "சிறுவன்", "பெரிய மீன்", "மீனைத் தின்றவை"]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "textbook", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": 27, "chapter": "lesson-03-kizhavanum-kadalum", "section": null, "reference": "6th Std Tamil Term 1, Page 27", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "characters"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u2-048", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'கிழவனும் கடலும்' என்னும் புதினம் 1954-ஆம் ஆண்டு புக்கர் பரிசு பெற்றது.\nகாரணம் (R): இந்நூலின் ஆசிரியர் வில்லியம் ஷேக்ஸ்பியர் ஆவார்.", "media_id": null}], "options": {"A": "கூற்று (A) சரி; காரணம் (R) தவறு.", "B": "கூற்று (A) தவறு; காரணம் (R) சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "கூற்று, காரணம் இரண்டும் தவறு. 'கிழவனும் கடலும்' 1954-ல் நோபல் பரிசு பெற்றது (புக்கர் அல்ல); ஆசிரியர் எர்னஸ்ட் ஹெமிங்வே (ஷேக்ஸ்பியர் அல்ல)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'கிழவனும் கடலும்' என்னும் புதினம் 1954-ஆம் ஆண்டு புக்கர் பரிசு பெற்றது.", "reason": "இந்நூலின் ஆசிரியர் வில்லியம் ஷேக்ஸ்பியர் ஆவார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter":