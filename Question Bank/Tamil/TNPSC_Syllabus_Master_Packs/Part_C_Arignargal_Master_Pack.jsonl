{"id": "10th-u4-q140", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "vinnaith_thaandiya_thannambikkai", "chapter_id": null, "topic_id": "perseverance_lesson", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஸ்டீபன் ஹாக்கிங்கின் வாழ்க்கை வரலாறு உலக மக்கள் அனைவருக்கும் புகட்டும் முதன்மையான பாடம் யாது?", "media_id": null}], "options": {"A": "விதியை நம்பி முடங்குவது", "B": "உடல் குறைபாட்டைக் கண்டு அஞ்சுவது", "C": "மருத்துவத்தை வெறுப்பது", "D": "உடலில் எத்தகைய குறைபாடு நேர்ந்தாலும் தன்னம்பிக்கையும் விடாமுயற்சியும் அறிவுத் தாகமும் இருந்தால் விண்மீன்களையும் தாண்டி வெற்றி பெறலாம்"}, "explanation": "கடும் உடல் முடக்கத்தையும் மீறி அறிவுத் தேடலாலும் அசாத்திய மன உறுதியாலும் பிரபஞ்சத்தின் புதிர்களை அவிழ்த்த ஹாக்கிங்கின் வாழ்வு ஒப்பற்ற தன்னம்பிக்கைப் பாடமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What transcendent life lesson does Stephen Hawking’s indomitable life teach humanity?", "media_id": null}], "options": {"A": "Surrendering to fatalism", "B": "Despairing over physical disabilities", "C": "Spurning modern science", "D": "Undaunted resilience, unyielding willpower, and intellectual passion can conquer cosmic frontiers regardless of extreme physical adversity"}, "explanation": "Indomitable courage and unwavering intellectual curiosity can transcend physical barriers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, 