{"id": "6th-t3-u2-032", "schema_version": "1.0", "kind": "quote_completion", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சியாட்டல் மடலின் நிறைவு வரிகளை நிரப்புக:\n'நாங்கள் பூமியை நேசிப்பது போலவே நீங்களும் பூமியை நேசியுங்கள்; ஏனெனில் இந்நிலம் __________!'", "media_id": null}], "options": {"A": "எங்களுக்கு மட்டுமே சொந்தமானது", "B": "அரசுக்குச் சொந்தமானது", "C": "எவராலும் அழிக்க முடியாதது", "D": "அனைவருக்கும் பொதுவானது"}, "explanation": "'இந்நிலம் அனைவருக்கும் பொதுவானது; நாங்கள் நேசிப்பது போல் நீங்களும் நேசியுங்கள்' என்று மடல் முடிகிறது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "3", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6 Tamil Term 3, Unit 2 - நிலம் பொது", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "pap