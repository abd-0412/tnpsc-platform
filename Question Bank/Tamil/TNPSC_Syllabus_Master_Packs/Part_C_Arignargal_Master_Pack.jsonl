{"id": "10th-u9-q107", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "humanitarian_crow_analogy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குப்புசாமி காகத்திற்கு உணவிடும் செயல் உணர்த்துவது எதனை?", "media_id": null}], "options": {"A": "மூடநம்பிக்கை", "B": "நேரம்போக்கு", "C": "தன்னைப் போன்றே பசியால் வாடும் சக உயிரினத்தின் பசி தீர்க்கும் தாய்மை உணர்வு", "D": "பய உணர்வு"}, "explanation": "பாடநூல் விளக்கம்: தான் மரணப் படுக்கையில் இருந்தபோதிலும், மற்றோர் உயிரின் பசியை உணர்ந்து பகிரும் உன்னதமான தாய்மைப் பேரன்பு வெளிப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What does Kuppusamy's ritual of feeding the visiting crow truly epitomize?", "media_id": null}], "options": {"A": "Superstition", "B": "Pastime", "C": "Maternal empathy quenching the hunger of another living soul despite one's own agony", "D": "Fear"}, "explanation": "Profound maternal empathy understanding another soul's hunger."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 206, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 206",