{"id": "9th-u7-q011", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "jhansi-regiment-tamil-women", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜான்சி ராணி படைப்பிரிவில் முக்கிய தளபதிகளாகவும் வீரப்பெண்களாகவும் விளங்கிய தமிழ்ப் பெண்கள் யார்?", "media_id": null}], "options": {"A": "ருக்மணி லட்சுமிபதி, அஞ்சலை அம்மாள்", "B": "மூவலூர் ராமாமிர்தம், முத்துலட்சுமி ரெட்டி", "C": "ஜானகி, கௌதமி", "D": "சரோஜினி நாயுடு, கமலா நேரு"}, "explanation": "ஜான்சி ராணி மகளிர் படைப்பிரிவில் ஜானகி, கௌதமி முதலான தமிழ்ப் பெண்கள் சிறப்பான தலைவர்களாகப் பயிற்சி பெற்றுப் பங்காற்றினர்."}, "en": {"blocks": [{"type": "text", "content": "Which valiant Tamil women were prominently trained as frontline leaders in the Rani of Jhansi Regiment?", "media_id": null}], "options": {"A": "Rukmini Lakshmipathi and Anjalai Ammal", "B": "Moovalur Ramamirtham and Muthulakshmi Reddy", "C": "Janaki and Gowthami (ஜானகி, கௌதமி)", "D": "Sarojini Naidu and Kamala Nehru"}, "explanation": "Janaki (later Janaki Thevar) and Gowthami were among the prominent Tamil women officers commanding the regiment."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "clas