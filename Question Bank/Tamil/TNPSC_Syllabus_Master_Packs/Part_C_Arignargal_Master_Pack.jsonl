{"id": "9th-u7-q005", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "delhi-chalo-slogan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்திய தேசிய இராணுவப் படையினரை நோக்கி நேதாஜி முழங்கிய புகழ்பெற்ற போர் முழக்கம் எது?", "media_id": null}], "options": {"A": "டெல்லி நோக்கிச் செல்லுங்கள் (டெல்லி சலோ)", "B": "செய் அல்லது செத்து மடி", "C": "வந்தே மாதரம்", "D": "ஜெய் ஜவான் ஜெய் கிசான்"}, "explanation": "நேதாஜி சுபாஷ் சந்திர போஸ் ஆற்றிய மாபெரும் கூட்டத்தில் 'டெல்லி நோக்கிச் செல்லுங்கள்' (டெல்லி சலோ - Delhi Chalo) எனப் போர் முழக்கம் செய்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which resounding battle cry did Netaji proclaim to the assembled soldiers of the Indian National Army?", "media_id": null}], "options": {"A": "March to Delhi (Delhi Chalo - டெல்லி சலோ)", "B": "Do or Die", "C": "Vande Mataram", "D": "Jai Jawan Jai Kisan"}, "explanation": "Netaji gave the historic rallying war cry 'Delhi Chalo' (March to Delhi) to inspire the troops to liberate the motherland."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 131, "chapter": n