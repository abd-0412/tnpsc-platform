{"id": "11th_tamil_u3_q098", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "climax_of_vaadivaasal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வாடிவாசலில் காரிக் காளையை அடக்கிய பிறகு பிச்சி காட்டிய பண்பு யாது?", "media_id": null}], "options": {"A": "காளையைக் கொன்று பழிதீர்த்தல்", "B": "காளையைத் தன் கட்டுப்பாட்டுக்குள் கொண்டுவந்து அடக்கிவிட்டு, அதற்கு எவ்வித காயமும் இன்றி விடுவித்து மரியாதை செலுத்துதல்", "C": "மைனரின் காலில் விழுந்து பணம் பெறுதல்", "D": "காளையை ஊருக்குள் இழுத்துச் சென்று விற்றல்"}, "explanation": "பிச்சி தன் தந்தையைக் கொன்ற காளையை வஞ்சம் தீர்த்து அழிக்காமல், வீரத் தழுவலால் அடக்கி மாட்டின் பெருமையையும் தன் மரபு வீரத்தையும் நிலைநிறுத்தினான்."}, "en": {"blocks": [{"type": "text", "content": "What noble sportsmanship and virtue does Pitchi demonstrate after subduing the lethal Kaari bull?", "media_id": null}], "options": {"A": "Slaughtering the beast in vendetta", "B": "Mastering the bull through pure skill, releasing it uninjured, and honoring the noble spirit of the contest", "C": "Groveling before the landlord for prize money", "D": "Auctioning off the captured bull"}, "explanation": "Pitchi triumphs purely through chivalry, subduing the beast without malice or cruelty."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers":