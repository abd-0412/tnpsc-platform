{"id": "12th_tamil_u3_q485", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "urimaithaagam", "chapter_id": null, "topic_id": "mortgage_crisis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தம்பி வெள்ளைச்சாமி தன் நிலத்தை யாரிடம் அடமானம் வைத்து மீட்க முடியாமல் தவித்தான்?", "media_id": null}], "options": {"A": "ஊரின் வட்டித் தொழிலாளியான மேலத்தெரு பண்ணையாரிடம்", "B": "அரசு வங்கியில்", "C": "தன் அண்ணன் முத்தையனிடம்", "D": "கிராமப் பஞ்சாயத்தில்"}, "explanation": "வெள்ளைச்சாமி குடும்ப வறுமையால் மேலத்தெரு பண்ணையாரிடம் தன் நிலப் பத்திரத்தை அடமானம் வைத்து மீட்க முடியாமல் போகும் நிலைக்கு ஆளானான்."}, "en": {"blocks": [{"type": "text", "content": "To whom had younger brother Vellaisami mortgaged his land, falling into distress when facing foreclosure?", "media_id": null}], "options": {"A": "To the local usurious usurer/landlord of the upper street", "B": "Nationalised bank", "C": "His brother Muthaiyan", "D": "Village panchayat"}, "explanation": "Vellaisami mortgaged his field deed to the village landlord/usurer and was on the brink of losing it forever."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025"