{"id": "12th_tamil_u2_q303", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "cart_track_water_flow", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மடை அடைக்கப்பட்டிருந்த வண்டிப்பாதை எதற்குப் பயன்பட்டு வந்தது?", "media_id": null}], "options": {"A": "ரயில் செல்வதற்கு", "B": "விமானம் இறங்குவதற்கு", "C": "கிராமத்து மாட்டு வண்டிகளும் மனிதர்களும் சென்று வரும் வரப்பு வழிப் பாதை", "D": "போர்க்களப் பாதை"}, "explanation": "கிராம மக்கள் வயல்களுக்குச் செல்லவும் விளைபொருட்களை மாட்டுவண்டியில் ஏற்றிச் செல்லவும் அமைக்கப்பட்ட வழிப்பாதையாகும்."}, "en": {"blocks": [{"type": "text", "content": "What was the regular utility of the cart track bridge under which the sluice was located?", "media_id": null}], "options": {"A": "Railway line track", "B": "Airstrip runway", "C": "Rural embankment cart road for bullock carts and farmers transporting farm harvest", "D": "Military warfare route"}, "explanation": "It was a rural field track used by farmers and bullock carts transporting produce."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 34, "chapter": null, "se