{"id": "9th-u1-q036", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-01-dravida-mozhi-kudumbam", "chapter_id": null, "topic_id": "topic-mooladravida-kootru", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திராவிட மொழிகளுள் மூலத் திராவிட மொழியின் (Proto-Dravidian) பண்புகள் பலவற்றையும் சிதையாமல் அப்படியே பாதுகாத்து வரும் முதன்மை மொழி எது?", "media_id": null}], "options": {"A": "கன்னடம்", "B": "தெலுங்கு", "C": "மலையாளம்", "D": "தமிழ்"}, "explanation": "பாடநூல் பக். 9-இன் படி: 'மூலத் திராவிட மொழியின் பண்புகள் பலவற்றையும் பேணிப் பாதுகாத்து வரும் தன்மையே தமிழின் தனித்தன்மையாக விளங்குகிறது'."}, "en": {"blocks": [{"type": "text", "content": "Which Dravidian language has preserved the structural and grammatical traits of Proto-Dravidian with the greatest fidelity?", "media_id": null}], "options": {"A": "Kannada", "B": "Telugu", "C": "Malayalam", "D": "Tamil"}, "explanation": "Tamil preserves the characteristics of the Proto-Dravidian parent language far more intact than any other descendant language."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 9, "chapter": null, "section": null, "r