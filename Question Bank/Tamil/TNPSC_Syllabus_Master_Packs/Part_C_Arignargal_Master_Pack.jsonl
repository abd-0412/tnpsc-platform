{"id": "10th-u5-q006", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "cardila_first_printed_book", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "1554-ஆம் ஆண்டு போர்த்துக்கீசிய நாட்டின் தலைநகர் லிஸ்பனில் தமிழ் மொழியில் மொழிபெயர்க்கப்பட்டு ரோமன் வரிவடிவில் அச்சிடப்பட்ட முதல் ஐரோப்பிய நூல் எது?", "media_id": null}], "options": {"A": "விவிலியம்", "B": "கார்திலா (Cartilha de lingoa Tamul e Portugues)", "C": "திருக்கருவூலம்", "D": "செந்தோமையார் சரிதம்"}, "explanation": "1554-இல் போர்ச்சுகல் தலைநகர் லிஸ்பனில் \"கார்திலா\" (Cartilha) என்னும் நூல் தமிழ் மொழியில் மொழிபெயர்க்கப்பட்டு ரோமன் வரிவடிவில் கறுப்பு, சிவப்பு மை வண்ணங்களில் அச்சிடப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which Portuguese book was translated into Tamil and printed in Roman script at Lisbon in 1554, marking the earliest printed European work in Tamil?", "media_id": null}], "options": {"A": "The Holy Bible", "B": "Cartilha (Cartilha de lingoa Tamul e Portugues)", "C": "Thirukkaruvoolam", "D": "Saint Thomas Chronicles"}, "explanation": "Cartilha was printed in Lisbon in 1554 with black and red types."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 100, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 100", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மொழிபெயர்ப்புக் கல்வி", "கார்திலா", "1554 லிஸ்பன்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u5-q007", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "cartilha_details", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கார்திலா (Cartilha) நூல் குறித்துக் கீழ்க்கண்ட கூற்றுகளுள் எது சரியானது?", "media_id": null}], "options": {"A": "இந்நூல் வட்டெழுத்து முறையில் அச்சிடப்பட்டது", "B": "இந்நூல் லண்டன் மாநகரில் அச்சிடப்பட்டது", "C": "இந்நூல் ரோமன் வரிவடிவில், கறுப்பு மற்றும் சிவப்பு ஆகிய இரு வண்ணங்களில் அச்சிடப்பட்டது", "D": "இந்நூல் 18-ஆம் நூற்றாண்டில் அச்சிடப்பட்டது"}, "explanation": "கார்திலா நூல் ரோமன் வரிவடிவில் தமிழ் மொழிபெயர்ப்பாக, அழகிய கறுப்பு மற்றும் சிவப்பு ஆகிய இரு வண்ண மைகளில் அச்சிடப்பட்டு வெளிவந்தது."}, "en": {"blocks": [{"type": "text", "content": "Which statement is accurate regarding the 1554 printed work \"Cartilha\"?", "media_id": null}], "options": {"A": "It was printed in Vatteluttu script", "B": "It was printed in London", "C": "It was printed in Roman script using both black and red inks", "D": "It was printed in the 18th century"}, "explanation": "Cartilha was printed in Roman type utilizing both black and red ink."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpora