{"id": "11th_tamil_u7_q046", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "jeeva_friendship_writers", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜீவாவோடு மிக நெருங்கிய நட்பு பாராட்டிய சமகால எழுத்தாளர்களுள் முதன்மையானவர் யார்?", "media_id": null}], "options": {"A": "கல்கி", "B": "ஜெயகாந்தன் மற்றும் புதுமைப்பித்தன்", "C": "அகிலன்", "D": "சாண்டில்யன்"}, "explanation": "எழுத்தாளர் ஜெயகாந்தன் ஜீவாவைத் தம் அரசியல்-இலக்கிய ஆசானாகவே கருதினார்; புதுமைப்பித்தனுடனும் ஜீவா ஆழமான தோழமை கொண்டிருந்தார்."}, "en": {"blocks": [{"type": "text", "content": "Who among contemporary Tamil literary luminaries shared an intimate bond with Comrade Jeeva, viewing him as a mentor?", "media_id": null}], "options": {"A": "Kalki", "B": "Jayakanthan and Pudhumaipithan", "C": "Akilan", "D": "Sandilyan"}, "explanation": "Jayakanthan revered Jeeva as his ideological guru and master."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 149, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 149", "url": null, "source_notes": null}, "previou