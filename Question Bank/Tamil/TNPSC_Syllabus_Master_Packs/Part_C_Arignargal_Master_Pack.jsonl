{"id": "10th-u7-q078", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "meikkeerthi", "chapter_id": null, "topic_id": "sculptor_poet_relationship", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மெய்க்கீர்த்திகளைப் பாடியவர் யார்? கல்வெட்டில் அவற்றைச் செதுக்கியவர் யார்?", "media_id": null}], "options": {"A": "மன்னனே பாடி செதுக்கினான்", "B": "அரசவைப் புலவர்கள் பாடினர்; தலைசிறந்த கல் தச்சர்கள் (சிற்பிகள்) கல்லில் செதுக்கினர்", "C": "அமைச்சர்கள் மட்டுமே செய்தனர்", "D": "வணிகர்கள் செய்தனர்"}, "explanation": "மெய்க்கீர்த்திகளை அரசவைக் கவிஞர்கள் சொல்லழகுடன் யாத்துத் தர, அவற்றை அழகிய தமிழ் வரிவடிவத்தில் கல் தச்சர்கள் கல்வெட்டுகளாகச் செதுக்கினர்."}, "en": {"blocks": [{"type": "text", "content": "Who composed the poetic text of Meikkeerthis, and who engraved them upon temple stones?", "media_id": null}], "options": {"A": "The king himself wrote and carved them", "B": "Eminent court poets composed the verses, and master stone sculptors (Thachargal) chiseled them", "C": "Ministers solely", "D": "Merchants"}, "explanation": "Royal court poets drafted the panegyrics and master sculptors engraved them."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10",