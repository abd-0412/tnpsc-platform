{"id": "9th-u3-q072", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-02-manimekalai", "chapter_id": null, "topic_id": "topic-manimekalai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தாழ்பூந்துறை' - என்னும் சொல்லிற்குரிய இலக்கணக்குறிப்பு யாது?", "media_id": null}], "options": {"A": "பண்புத்தொகை", "B": "உரிச்சொல் தொடர்", "C": "எண்ணும்மை", "D": "வினைத்தொகை"}, "explanation": "தாழ்பூந்துறை = தாழ்ந்த பூந்துறை, தாழ்கின்ற பூந்துறை, தாழும் பூந்துறை என முக்காலத்திற்கும் பொருந்தி வருவதால் இது 'வினைத்தொகை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the grammatical classification of 'Thaazhpoonthurai'?", "media_id": null}], "options": {"A": "Panputhogai", "B": "Urichol thodar", "C": "Ennummai", "D": "Vinaithogai (Verbal compound across three tenses)"}, "explanation": "'Thaazhpoonthurai' conceals tense (past, present, future), making it a classic Vinaithogai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 56", "url": null, "source_notes": null}, "previous_year": {"is_previous_yea