{"id": "7th-t1-u3-252", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l1-vidudhalai-thirunaal", "chapter_id": null, "topic_id": "meera-profession-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் மீரா கல்லூரியில் எந்தப் பேராசிரியராகப் பணியாற்றி ஓய்வு பெற்றார்?"}], "options": {"A": "வரலாற்றுப் பேராசிரியர்", "B": "ஆங்கிலப் பேராசிரியர்", "C": "தத்துவப் பேராசிரியர்", "D": "தமிழ்ப் பேராசிரியர்"}, "explanation": "பாடநூல் குறிப்பு: கவிஞர் மீரா கல்லூரியில் தமிழ்ப் பேராசிரியராகப் பணியாற்றியவர்."}, "en": {"blocks": [{"type": "text", "content": "In what academic capacity did poet Meera serve as a professor in college?"}], "options": {"A": "History Professor", "B": "English Professor", "C": "Philosophy Professor", "D": "Tamil Professor (தமிழ்ப் பேராசிரியர்)"}, "explanation": "Textbook fact: Poet Meera served professionally as a Professor of Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 49, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previou