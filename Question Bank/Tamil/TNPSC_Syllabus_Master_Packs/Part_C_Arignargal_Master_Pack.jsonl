{"id": "9th-u7-q029", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "ina-women-sacrifice", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜான்சி ராணி படைப்பிரிவில் தமிழ் பெண்கள் ஆற்றிய முதன்மையான பங்களிப்பு யாது?", "media_id": null}], "options": {"A": "ஆண்களுக்கு நிகராகத் துப்பாக்கி ஏந்தி போர்க்களத்தில் வீரப்போர் புரிந்தனர்", "B": "சமையல் பணி மட்டுமே செய்தனர்", "C": "மருத்துவச் சீருடை அணிந்து பார்வையாளர்களாக நின்றனர்", "D": "கடிதங்கள் எழுதும் பணியை மட்டும் செய்தனர்"}, "explanation": "ஜான்சி ராணி மகளிர் படைப்பிரிவில் பெண்கள் துப்பாக்கி ஏந்தி, கடுமையான இராணுவப் பயிற்சிகளைப் பெற்று ஆண்களுக்கு நிகராகப் போர்க்களத்தில் போரிட்டனர்."}, "en": {"blocks": [{"type": "text", "content": "What was the primary frontline contribution of Tamil women in the Rani of Jhansi Regiment?", "media_id": null}], "options": {"A": "Bearing arms and fighting fearlessly on the frontlines on par with male soldiers", "B": "Serving only as kitchen cooks", "C": "Standing by as mere medical spectators", "D": "Engaging purely in clerical letter writing"}, "explanation": "Women soldiers in the Rani of Jhansi Regiment underwent rigorous combat drills and fought valiantly on the battlegrounds."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 132, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 132", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_7", "jhansi_regiment", "combat"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u7-q030", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "tamil-donations-netaji", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நேதாஜி சுபாஷ் சந்திர போஸ் நிதி திரட்ட வந்த போது, தம்மிடமிருந்த பொன், பொருள், நகை அனைத்தையும் நாட்டு விடுதலைக்காக வாரி வழங்கியவர்கள் யார்?", "media_id": null}], "options": {"A": "வடஇந்திய நிலப்பிரபுக்கள் மட்டுமே", "B": "மலேசியா, பர்மாவில் வாழ்ந்த எளிய தமிழ் மக்கள்", "C": "ஆங்கிலேய அதிகாரிகள்", "D": "ஜப்பானிய வணிகர்கள்"}, "explanation": "மலேசியா, பர்மா ஆகிய நாடுகளில் வாழ்ந்த தமிழ் தோட்டத் தொழிலாளர்களும் எளிய மக்களும் தங்கள் காது, கழுத்து நகைகளையும் சேமிப்புகளையும் நேதாஜியிடம் முழுமையாகக் காணிக்கையாக வழங்கினர்."}, "en": {"blocks": [{"type": "text", "content": "Who overwhelmingly donated their hard-earned jewelry, gold, and entire life savings to Netaji for the INA war fund?", "media_id": null}], "options": {"A": "Only North Indian landlords", "B": "Humble Tamil migrant workers residing in Malaya and Burma", "C": "British officers", "D": "Japanese traders"}, "explanation": "Poor Tamil rubber tappers and laborers in Malaya and Burma selflessly handed over their family gold and jewelry to Netaji."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kal