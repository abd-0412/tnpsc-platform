{"id": "12th_tamil_u6_q995", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thiraimozhi", "chapter_id": null, "topic_id": "chaplin_modern_times", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொழிற்புரட்சியினால் மனிதன் இயந்திரமாக மாறிவிட்ட அவலத்தைப் பகடி செய்த சாப்ளினின் திரைப்படம் எது?", "media_id": null}], "options": {"A": "தி கிட்", "B": "தி சர்க்கஸ்", "C": "மாடர்ன் டைம்ஸ் (Modern Times - 1936)", "D": "சிட்டி லைட்ஸ்"}, "explanation": "1936-இல் வெளியான 'மாடர்ன் டைம்ஸ்' படத்தில் இயந்திரங்களின் பற்சக்கரங்களுக்குள் மனிதன் மாட்டிக்கொள்ளும் காட்சி மூலம் முதலாளித்துவ எந்திரமயமாதலை சாப்ளின் சாடினார்."}, "en": {"blocks": [{"type": "text", "content": "Which 1936 classic satirized the dehumanizing assembly-line mechanization of industrial capitalism?", "media_id": null}], "options": {"A": "The Kid", "B": "The Circus", "C": "Modern Times (1936)", "D": "City Lights"}, "explanation": "'Modern Times' (1936) critiqued assembly-line factory industrialization."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 133, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 133", "url