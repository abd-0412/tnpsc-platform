{"id": "9th-u8-q006", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "script-reform-year-implementation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தந்தை பெரியார் உருவாக்கிய தமிழ் எழுத்துச் சீர்திருத்தங்களை எந்த ஆண்டு தமிழ்நாடு அரசு ஏற்று அதிகாரப்பூர்வமாக நடைமுறைப்படுத்தியது?", "media_id": null}], "options": {"A": "1967", "B": "1978", "C": "1989", "D": "1996"}, "explanation": "பெரியாரின் நூற்றாண்டு விழாவையொட்டி 1978-ஆம் ஆண்டில் தமிழ்நாடு அரசு (எம்.ஜி.ஆர் ஆட்சிக் காலத்தில்) பெரியாரின் தமிழ் எழுத்துச் சீர்திருத்தத்தை ஏற்று நடைமுறைப்படுத்தியது."}, "en": {"blocks": [{"type": "text", "content": "In which year did the Government of Tamil Nadu officially adopt and implement Periyar's Tamil script reforms?", "media_id": null}], "options": {"A": "1967", "B": "1978 (1978-ஆம் ஆண்டு)", "C": "1989", "D": "1996"}, "explanation": "The Tamil Nadu government implemented Periyar's modernized typographic script reforms in 1978 during his centenary year."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 156", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_8", "periyar", "script_reform"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u8-q007", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "script-reform-letters", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தந்தை பெரியார் தமிழ் எழுத்துச் சீர்திருத்தத்தின் வாயிலாக மாற்றியமைத்த எழுத்து வடிவங்கள் எவை?", "media_id": null}], "options": {"A": "க், ச், ட், த், ப், ற்", "B": "அ, ஆ, இ, ஈ, உ, ஊ", "C": "ணா, றா, னா, ணை, லை, ளை, னை", "D": "ங், ஞ், ண், ந், ம், ன்"}, "explanation": "பழைய வரிவடிவங்களான ணா, றா, னா, ணை, லை, ளை, னை முதலான சிக்கலான எழுத்துகளை அச்சுக்கும் தட்டச்சுக்கும் எளிதாகும் வண்ணம் சீர்திருத்தினார்."}, "en": {"blocks": [{"type": "text", "content": "Which complex traditional orthographic letter shapes were simplified by Periyar through his script reform?", "media_id": null}], "options": {"A": "k, ch, t, th, p, r", "B": "a, aa, i, ee, u, oo", "C": "Nnaa, Raa, Naa, Nnai, Lai, Lhai, Nai (ணா, றா, னா, ணை, லை, ளை, னை)", "D": "ng, nj, nn, nth, m, n"}, "explanation": "Periyar modernized ligatures such as ணா, றா, னா, ணை, லை, ளை, னை to suit printing presses and modern typewriters."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "ed