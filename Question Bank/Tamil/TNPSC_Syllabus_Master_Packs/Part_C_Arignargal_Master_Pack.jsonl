{"id": "6th-t1-u1-032", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாவர இலைப்பெயர்களைப் பொருத்துக:\nபட்டியல் I:\nஅ) அருகு, கோரை\nஆ) சப்பாத்திக்கள்ளி, தாழை\nஇ) கரும்பு, நாணல்\nஈ) ஆலமரம், அரசமரம்\n\nபட்டியல் II:\n1. மடல்\n2. தோகை\n3. இலை\n4. புல்", "media_id": null}], "options": {"A": "1, 2, 3, 4", "B": "4, 2, 1, 3", "C": "2, 1, 4, 3", "D": "4, 1, 2, 3"}, "explanation": "பாடநூல் அட்டவணைப்படி:\nஅ) அருகு, கோரை - புல் (4)\nஆ) சப்பாத்திக்கள்ளி, தாழை - மடல் (1)\nஇ) கரும்பு, நாணல் - தோகை (2)\nஈ) ஆலமரம், அரசமரம் - இலை (3)\nசரியான வரிசை: 4, 1, 2, 3."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "6th Tamil, Term 1, Unit 1, Page 7", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, 