{"id": "12th_tamil_u1_q191", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tnpsc_pyq_integration", "chapter_id": null, "topic_id": "thandiyalankaram_core_concept", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தண்டியலங்காரப் பாடல் உணர்த்தும் முதன்மை மாண்பு யாது?", "media_id": null}], "options": {"A": "இயற்கையின் கொடுஞ்சீற்றம்", "B": "மனிதனின் தற்காலிக வாழ்வு", "C": "அறியாமை இருள் நீக்கி மாண்பு தரும் தமிழ் மொழியின் ஒப்புயர்வற்ற பெருமை", "D": "வானியல் விதிகள்"}, "explanation": "சூரியன் உலகத்தின் புற இருளை மட்டுமே போக்கும்; ஆனால் தமிழ்மொழி உலக மக்களின் உள்ளத்து அறியாமை இருளைப் போக்கி அறிவுச்சுடர் கொளுத்துவதால் நிகரற்றது."}, "en": {"blocks": [{"type": "text", "content": "What is the cardinal philosophical virtue extolled in the Thandiyalankaram illustrative verse?", "media_id": null}], "options": {"A": "The fury of cosmic natural elements", "B": "Transience of human lifespan", "C": "Peerless grandeur of Tamil in expelling darkness of inner ignorance", "D": "Cosmic planetary mechanics"}, "explanation": "Tamil is acclaimed as matchless because it illuminates minds and expels inner darkness, whereas the Sun only lights the exterior."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educat