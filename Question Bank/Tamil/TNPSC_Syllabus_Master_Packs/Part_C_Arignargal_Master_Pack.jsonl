{"id": "12th_tamil_u2_q305", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "marudhan_occupation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மருதன் எத்தகைய வாழ்க்கைச் சூழலில் வாழும் உழைப்பாளி?", "media_id": null}], "options": {"A": "நிலத்தை உயிராக மதித்து உழைக்கும் எளிய விளிம்புநிலை விவசாயி", "B": "நகரத்து வங்கி மேலாளர்", "C": "பன்னாட்டு நிறுவன அதிகாரி", "D": "நிலப்பிரபுத்துவப் பண்ணையார்"}, "explanation": "மருதன் நிலத்தையே தன் வாழ்வாதாரமாகவும் தாய்மையாகவும் போற்றி உழைக்கும் ஓர் எளிய உழவன்."}, "en": {"blocks": [{"type": "text", "content": "What socio-economic background does Marudhan belong to in the village hierarchy?", "media_id": null}], "options": {"A": "A hardworking subaltern peasant who reveres land and farming as sacred duty", "B": "An urban commercial bank manager", "C": "Multinational corporate executive", "D": "Wealthy feudal landlord"}, "explanation": "Marudhan is an ordinary, hard-working small peasant dedicated to farming."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 33, "chapter": null, "section": null, "reference"