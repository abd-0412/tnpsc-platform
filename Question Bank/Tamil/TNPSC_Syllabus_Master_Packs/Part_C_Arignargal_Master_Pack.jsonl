{"id": "12th_tamil_u4_q699", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pathukaapaai_oru_payanam", "chapter_id": null, "topic_id": "broken_white_line", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சாலையின் நடுவே இடப்பட்டுள்ள 'விட்டுவிட்டு அமைந்த வெள்ளைக் கோடு' (Broken White Line) எதனை உணர்த்துகிறது?", "media_id": null}], "options": {"A": "முந்திச் செல்லவே கூடாது", "B": "வாகனத்தை நிறுத்தவே கூடாது", "C": "எச்சரிக்கையுடன் பாதுகாப்பாகப் பாதை மாறி முந்திச் செல்லலாம்", "D": "சாலையின் முடிவு"}, "explanation": "விட்டுவிட்டு அமைந்த வெள்ளைக் கோடுகள் உள்ள இடங்களில் வாகனங்கள் எதிரே வரும் போக்குவரத்தைக் கவனித்துப் பாதுகாப்பாக முந்திச் செல்ல அனுமதிக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What does a longitudinal 'Broken / Dashed White Line' marked down the center of a carriageway signify?", "media_id": null}], "options": {"A": "Overtaking strictly banned", "B": "Stopping completely forbidden", "C": "Drivers may change lanes and overtake when safe to do so", "D": "Road termination"}, "explanation": "Dashed white lines indicate lane demarcation where overtaking and lane transitions are permitted when safe."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Se