{"id": "11th_tamil_u1_q038", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "pyq_yugathin_paadal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] ‘உயிர்த்தெழும் காலத்துக்காக’ என்ற தலைப்பில் கவிதைத் தொகுப்பை வெளியிட்ட ஈழத்துக் கவிஞர் யார்?", "media_id": null}], "options": {"A": "சேரன்", "B": "சு. வில்வரத்தினம்", "C": "காசி ஆனந்தன்", "D": "புதுவை இரத்தினதுரை"}, "explanation": "சு. வில்வரத்தினம் அவர்களின் கவிதைகள் 'உயிர்த்தெழும் காலத்துக்காக' என்ற தொகுப்பாக வெளிவந்தன."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Which Eelam poet brought out his acclaimed poetry collection titled 'Uyirtthezhum Kaalathukkaaga'?", "media_id": null}], "options": {"A": "Cheran", "B": "Su. Vilvarathinam", "C": "Kasi Ananthan", "D": "Puthuvai Rathinathurai"}, "explanation": "Poet Su. Vilvarathinam's poems were published under the title 'Uyirtthezhum Kaalathukkaaga'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null, "source_notes": null}, "