{"id": "11th_tamil_u7_q017", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "jeeva_selfless_money", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜீவா பொதுக்கூட்டங்களுக்குச் செல்லும்போது தமக்குக் கிடைக்கும் மாலைகள், நன்கொடைகளை என்ன செய்தார்?", "media_id": null}], "options": {"A": "கட்சியின் பொது நிதிக்காகவும், ஏழைத் தோழர்களின் மருத்துவத்திற்காகவும் உடனுக்குடன் வழங்கிவிடுவார்", "B": "தமக்கெனச் சேர்த்து வைத்தார்", "C": "வீடு கட்டப் பயன்படுத்தினார்", "D": "நிலம் வாங்கினார்"}, "explanation": "ஜீவா தமக்குக் கிடைக்கும் ஒரு பைசாவையும் சொந்தத்திற்குப் பயன்படுத்தாமல், இயக்கத்தின் பொதுப்பணிக்காகவும் நலிந்த தோழர்களின் நலனுக்காகவுமே முழுமையாகக் கொடுத்தார்."}, "en": {"blocks": [{"type": "text", "content": "What did Comrade Jeeva do with the garlands and monetary donations presented at mass rallies?", "media_id": null}], "options": {"A": "Handed over immediately to party common funds and relief for impoverished cadre", "B": "Hoarded for personal wealth", "C": "Built luxury real estate", "D": "Purchased land"}, "explanation": "He never touched party donations for personal use, dedicating everything to the cause."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil 