{"id": "11th_tamil_u3_q027", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "prose_malai_idappeyargal", "chapter_id": null, "topic_id": "toponymic_resilience", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மனித நாகரிகங்கள் அழிந்தாலும், மொழிகள் மாறினாலும் எவை மட்டும் தலைமுறை தலைமுறையாக அழியாமல் வாழ்கின்றன?’ என்று ஆசிரியர் கூறுகிறார்?", "media_id": null}], "options": {"A": "கட்டடங்கள்", "B": "நாணயங்கள்", "C": "இடப்பெயர்கள் (Place Names / Toponyms)", "D": "துணிகள்"}, "explanation": "மண்ணில் மக்கள் மாறினாலும் அவர்கள் இட்டுச் சென்ற இடப்பெயர்கள் ஆயிரக்கணக்கான ஆண்டுகள் வாழும் என்று இடப்பெயராய்வியல் கூறுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What linguistic cultural entities endure across millennia even when ancient civilizations fall and empires dissolve?", "media_id": null}], "options": {"A": "Palace brick structures", "B": "Metal coins", "C": "Geographic Place Names (Toponyms)", "D": "Woven fabrics"}, "explanation": "Toponyms are the most resilient cultural fossils, surviving across civilizations."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 46, "chapter": null, "