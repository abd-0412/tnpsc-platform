{"id": "7th-t1-u2-220", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l6-kurukkangal", "chapter_id": null, "topic_id": "odd-kurukkam-word", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்காணும் சொற்களுள் ஆய்தக்குறுக்கத்திற்குப் பொருந்தாத ஒன்றைத் தேர்ந்தெடுக்க:"}], "options": {"A": "முஃடீது", "B": "கஃறீது", "C": "அஃறீது", "D": "எஃகு"}, "explanation": "பாடநூல் விளக்கம்: 'எஃகு' என்பதில் உள்ள ஆய்த எழுத்து தனக்குரிய அரை மாத்திரை அளவில் முழுமையாக ஒலிக்கிறது (அது ஆய்தத்தொடர்க் குற்றியலுகரம்). முஃடீது, கஃறீது ஆகியவற்றில் மட்டுமே புணர்ச்சியால் ஆய்தம் கால் மாத்திரையாகக் குறுகும். எனவே D பொருந்தாத ஒன்று."}, "en": {"blocks": [{"type": "text", "content": "Identify the word that does NOT contain an Aydhakkurukkam:"}], "options": {"A": "Muhdeedhu", "B": "Kahreedhu", "C": "Ahreedhu", "D": "Ehgu (தவறு: இது ஆய்தத்தொடர்க் குற்றியலுகரம், ஆய்தக்குறுக்கம் அல்ல)"}, "explanation": "Textbook explanation: In 'Ehgu', Aydham retains its full 0.5 maathirai (Aydhathodar Kutriyalugaram); only Muhdeedhu/Kahreedhu contract to 0.25 maathirai. Option D is odd."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 40, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "odd_one_out", "aydhakkurukkam_odd"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
