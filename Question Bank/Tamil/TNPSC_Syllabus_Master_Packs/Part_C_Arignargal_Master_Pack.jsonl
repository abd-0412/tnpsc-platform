{"id": "12th_tamil_u6_q1071", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nadigar_thilagam", "chapter_id": null, "topic_id": "dadasaheb_phalke_award", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியத் திரைப்படத்துறையின் ஆகச்சிறந்த வாழ்நாள் சாதனையாளர் விருதான ‘தாதா சாகேப் பால்கே விருது’ சிவாஜி கணேசனுக்கு எந்த ஆண்டு வழங்கப்பட்டது?", "media_id": null}], "options": {"A": "1980", "B": "1990", "C": "1996", "D": "2001"}, "explanation": "இந்தியக் கலையுலகின் உயரிய விருதான தாதா சாகேப் பால்கே விருது 1996-ஆம் ஆண்டு சிவாஜி கணேசனுக்கு வழங்கிப் பெருமைப்படுத்தப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "In which year was Sivaji Ganesan bestowed with India's highest cinema honor, the Dadasaheb Phalke Lifetime Achievement Award?", "media_id": null}], "options": {"A": "1980", "B": "1990", "C": "1996", "D": "2001"}, "explanation": "Sivaji was conferred the Dadasaheb Phalke Award in 1996 by the Government of India."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 141", "url": null, "source_notes": null