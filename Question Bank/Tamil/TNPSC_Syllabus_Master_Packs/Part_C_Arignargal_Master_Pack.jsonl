{"id": "11th_tamil_u2_q014", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "prose_iyarkai_velanmai", "chapter_id": null, "topic_id": "traditional_seeds_names", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்நாட்டின் பாரம்பரிய நெல் ரகங்களுள் பொருந்தாத ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "மாப்பிள்ளைச் சம்பா, சீரகச் சம்பா", "B": "ஐ.ஆர். 20, பொன்னி (ஹைப்ரிட் ரகங்கள்)", "C": "காட்டுயாணம், கருங்குறுவை", "D": "குள்ளக்கார், தூயமல்லி"}, "explanation": "மாப்பிள்ளைச் சம்பா, சீரகச் சம்பா, காட்டுயாணம், கருங்குறுவை, குள்ளக்கார், தூயமல்லி ஆகியவை பாரம்பரிய நெல் ரகங்கள்; ஐ.ஆர். 20 போன்றவை இரசாயன வீரிய ஒட்டு ரகங்கள்."}, "en": {"blocks": [{"type": "text", "content": "Identify the non-indigenous, synthetic hybrid paddy variety from the following:", "media_id": null}], "options": {"A": "Mappillai Samba and Seeraga Samba", "B": "IR-20 and Modern Hybrid Ponni", "C": "Kaattuyanam and Karunguruvai", "D": "Kullakkar and Thooyamalli"}, "explanation": "IR-20 is a modern laboratory hybrid; the others are centuries-old native Tamil heritage paddy varieties."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2