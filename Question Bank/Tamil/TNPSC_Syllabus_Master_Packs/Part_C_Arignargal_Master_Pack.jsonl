{"id": "11th_tamil_u7_q103", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "bharathidasan_song_state_anthem", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புதுச்சேரி அரசின் தமிழ்த்தாய் வாழ்த்துப் பாடலாக ஏற்றுக்கொள்ளப்பட்டுள்ள பாரதிதாசனின் பாடல் எது?", "media_id": null}], "options": {"A": "நீராரும் கடலுடுத்த (மனோன்மணீயம்)", "B": "செந்தமிழ் நாடெனும் போதினிலே", "C": "வாழ்வினில் செம்மையைச் செய்பவள் நீயே (புதுவை தமிழ்த்தாய் வாழ்த்து)", "D": "தமிழுக்கும் அமுதென்று பேர்"}, "explanation": "புதுச்சேரி அரசின் அதிகாரப்பூர்வத் தமிழ்த்தாய் வாழ்த்துப் பாடலாகப் பாரதிதாசன் இயற்றிய 'வாழ்வினில் செம்மையைச் செய்பவள் நீயே' என்னும் பாடல் விளங்கி வருகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which composition by Bharathidasan was adopted as the official State Anthem of Puducherry Government?", "media_id": null}], "options": {"A": "Neeraarum Kadaluduttha", "B": "Senthamizh Naadenum Pothinile", "C": "Vaazhvinil Semmaiyaic Cheybaval Neeye", "D": "Thamizhukkum Amuthendru Per"}, "explanation": "'Vaazhvinil Semmaiyaic Cheybaval Neeye' is the official invocation anthem of Puducherry."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Education