{"id": "12th_tamil_u4_q689", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pathukaapaai_oru_payanam", "chapter_id": null, "topic_id": "pedestrian_walking_rule", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நடைபாதை இல்லாத சாலைகளில் பாதசாரிகள் சாலையின் எந்தப் பக்கமாக நடக்க வேண்டும்?", "media_id": null}], "options": {"A": "எதிரே வரும் வாகனங்களைப் பார்த்தவாறு வலது புறம்", "B": "வாகனம் செல்லும் திசையில் இடது புறம்", "C": "சாலையின் நடுப்பகுதி", "D": "எந்தப் பக்கம் வேண்டுமானாலும் நடக்கலாம்"}, "explanation": "நடைபாதை இல்லாத சாலைகளில், எதிரே வரும் வாகனங்களைத் தெளிவாகப் பார்த்து விலகிச் செல்ல வசதியாகச் சாலையின் வலப்பக்கத்தில்தான் நடக்க வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "On roads devoid of pedestrian footpaths, on which side of the carriageway should pedestrians walk?", "media_id": null}], "options": {"A": "On the right side facing incoming oncoming vehicular traffic", "B": "On the left side along vehicle flow", "C": "Along the middle median line", "D": "On whichever side they prefer"}, "explanation": "Walking facing oncoming traffic on the right side provides advance visual perception of approaching hazards."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educatio