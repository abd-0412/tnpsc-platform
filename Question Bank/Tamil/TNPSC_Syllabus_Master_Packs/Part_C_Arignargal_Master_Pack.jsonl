{"id": "12th_tamil_mp1_q1610", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "matrilineal_patrilineal_sangam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க காலத்தில் தாய்வழிச் சமூகத்தின் எச்சமாக அமைந்த ‘தாய்வழி முறை’ எவற்றின் மூலம் அறியப்படுகிறது?", "media_id": null}], "options": {"A": "மன்னரின் ஆட்சி முறை", "B": "மகளிர் சொத்துரிமை, தாயின் வழியில் உறவுமுறை அமைதல் (தாய்முறை) மற்றும் சிறுமிகளின் இல்லத்தில் மணமகன் சென்று தங்குதல்", "C": "போர்க்களப் பயிற்சிகள்", "D": "வணிகக் குழுக்கள்"}, "explanation": "சங்க இலக்கியத்தில் பெண்வழிச் சமூக எச்சங்களாகப் பெண்வழிச் சொத்துடைமை, தாயின் பெயரை இணைத்து அழைத்தல் போன்றவை பக்தவத்சல பாரதியால் சுட்டப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "How are the vestigial remnants of ancient matrilineal clan systems evidenced in Sangam Tamil anthologies?", "media_id": null}], "options": {"A": "Monarchical royal succession", "B": "Matrilocal residence, female inheritance rights, and tracing kinship lineages through mothers", "C": "Martial infantry drills", "D": "Maritime merchant guilds"}, "explanation": "Sangam poetry reflects matrilineal survivals via maternal property inheritance and matrilocal living."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 44, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 44", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 1", "Mock 2", "Social Anthropology"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp1_q1611", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "kambar_veedanan_adaikkalam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஆழியான் அவனை நோக்கி... என்னுடைத் தம்பி நீ’ என்று இராமன் வீடணனை எந்தப் படலத்தில் அடைக்கலமாக ஏற்றுக்கொண்டான்?", "media_id": null}], "options": {"A": "குகப் படலம்", "B": "சடாயு காண் படலம்", "C": "வீடணன் அடைக்கலப் படலம்", "D": "நாகபாசப் படலம்"}, "explanation": "வீடணன் அடைக்கலப் படலத்தில், பகைவனான இராவணனின் தம்பியாயினும் அடைக்கலம் என்று வந்தவனைத் தன் தம்பியாக இராமன் ஏற்றுக் கொண்டான்."}, "en": {"blocks": [{"type": "text", "content": "In which Canto of Kamba Ramayanam does Rama accept Vibhishana with unconditional asylum declaring 'Thou art my brother'?", "media_id": null}], "options": {"A": "Guha Padalam", "B": "Jatayu Kaan Padalam", "C": "Veedanan Adaikkalap Padalam", "D": "Nagapaasa Padalam"}, "explanation": "Rama grants absolute refuge (Abhaya) to Ravana's brother Vibhishana in Veedanan Adaikkalap Padalam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "se