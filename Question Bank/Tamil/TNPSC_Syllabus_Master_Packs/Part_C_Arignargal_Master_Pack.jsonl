{"id": "9th-u5-q008", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l1", "chapter_id": null, "topic_id": "pandya-sculpture-sites", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் ஊர்களுள் பாண்டியர் காலக் குடைவரைச் சிற்பங்கள் காணப்படாத ஊர் எது?", "media_id": null}], "options": {"A": "திருமயம்", "B": "பிள்ளையார்பட்டி", "C": "குன்றக்குடி", "D": "தாராசுரம்"}, "explanation": "கழுகுமலை, திருமயம், பிள்ளையார்பட்டி, குன்றக்குடி, திருப்பரங்குன்றம் ஆகியவை பாண்டியர் காலச் சிற்பத் தலங்கள். தாராசுரம் சோழர் காலச் சிற்பத் தலமாகும்."}, "en": {"blocks": [{"type": "text", "content": "In which of the following towns are Pandya rock-cut sculptures NOT located?", "media_id": null}], "options": {"A": "Thirumayam", "B": "Pillaiyarpatti", "C": "Kundrakudi", "D": "Darasuram"}, "explanation": "Thirumayam, Pillaiyarpatti, and Kundrakudi are renowned for Pandya sculptures; Darasuram (Airavatesvara temple) was built by Cholas."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 110, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 110", "url": null, "source_notes": null}, 