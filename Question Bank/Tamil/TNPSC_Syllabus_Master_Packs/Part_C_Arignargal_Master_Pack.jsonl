{"id": "11th_tamil_u2_q026", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "prose_iyarkai_velanmai", "chapter_id": null, "topic_id": "soil_carbon", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயற்கை உரம் இடுவதால் மண்ணில் அதிகரிக்கும் முதன்மைத் தாது எது, அது புவி வெப்பமயமாதலை எவ்வாறு குறைக்கிறது?", "media_id": null}], "options": {"A": "இரும்புச் சத்து", "B": "கரிமக் கார்பன் (Organic Carbon) மண்ணில் நிலைநிறுத்தப்பட்டு வளிமண்டலக் கார்பன் குறைகிறது", "C": "யுரேனியம் சத்து", "D": "கந்தகச் சத்து"}, "explanation": "இயற்கை வேளாண்மை காற்றில் உள்ள கார்பனை மண்ணுக்குள் கரிமச் சத்தாகப் பிடித்து வைத்து புவி வெப்பமயமாதலைத் தடுக்கும் பெரும் அரணாகத் திகழ்கிறது."}, "en": {"blocks": [{"type": "text", "content": "Which element is enriched in the soil through organic composting that mitigates global climate warming?", "media_id": null}], "options": {"A": "Iron ores", "B": "Soil Organic Carbon (SOC) which sequesters atmospheric carbon dioxide into humus", "C": "Uranium deposits", "D": "Sulfur gas"}, "explanation": "Organic compost sequesters atmospheric carbon dioxide into stable soil organic carbon (SOC)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "