{"id": "8th-u1-q082", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-04-sorpoonga", "chapter_id": null, "topic_id": "ta-8th-u1-odd-ilangkumaranar-books", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புலவர் இரா. இளங்குமரனார் இயற்றிய நூல்களுள் பொருந்தாத ஒன்றைத் தேர்ந்தெடுக்க:"}], "options": {"A": "இலக்கண வரலாறு", "B": "தொல்காப்பியப் பூங்கா", "C": "தமிழிசை இயக்கம்", "D": "தனித்தமிழ் இயக்கம்"}, "explanation": "பாடநூல் பக்கம் 16: 'தொல்காப்பியப் பூங்கா' என்பது மு. கருணாநிதி எழுதிய நூல். இளங்குமரனார் இயற்றியவை: இலக்கண வரலாறு, தமிழிசை இயக்கம், தனித்தமிழ் இயக்கம் (தொகுத்த நூல்: தேவநேயம்)."}, "en": {"blocks": [{"type": "text", "content": "Pick the odd book out that was NOT authored by Pulavar Ra. Ilangkumaranar:"}], "options": {"A": "Ilakkana Varalaaru", "B": "Tholkappiyap Poonga", "C": "Tamizhisai Iyakkam", "D": "Thanithamizh Iyakkam"}, "explanation": "Textbook page 16: 'Tholkappiyap Poonga' was authored by M. Karunanidhi. Ra. Ilangkumaranar authored Ilakkana Varalaaru, Tamizhisai Iyakkam, Thanithamizh Iyakkam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 16, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["odd_one_out", "ilangkumaranar", "books"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u1-q084", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "lesson-04-sorpoonga", "chapter_id": null, "topic_id": "ta-8th-u1-direct-thavassaalai-founder", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருச்சிக்கு அருகில் உள்ள அல்லூரில் 'திருவள்ளுவர் தவச்சாலை' மற்றும் 'பாவாணர் நூலகம்' ஆகியவற்றை நிறுவிய தமிழறிஞர் யார்?"}], "options": {"A": "மறைமலையடிகள்", "B": "தேவநேயப் பாவாணர்", "C": "பெருஞ்சித்திரனார்", "D": "இரா. இளங்குமரனார்"}, "explanation": "பாடநூல் பக்கம் 16: திருச்சிக்கு அருகில் அமைந்துள்ள அல்லூரில் 'திருவள்ளுவர் தவச்சாலை' மற்றும் 'பாவாணர் நூலகம்' ஆகியவற்றை அமைத்தவர் 'செந்தமிழ்ச் அந்தணர்' இரா. இளங்குமரனார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Which Tamil scholar founded the 'Thiruvalluvar Thavassaalai' and 'Paavaanar Library' at Allur near Tiruchirappalli?"}], "options": {"A": "Maraimalai Adigal", "B": "Devaneya Paavaanar", "C": "Perunchithiranaar", "D": "Ra. Ilangkumaranar"}, "explanation": "Textbook page 16: 'Senthamizh Andhanar' Ra. Ilangkumaranar established Thiruvalluvar Thavassaalai and Paavaanar Library in Allur near Trichy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook a