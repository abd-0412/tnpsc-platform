{"id": "12th_tamil_mp1_q1683", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_5", "chapter_id": null, "topic_id": "kudumba_murai_kootru", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மனித சமூகம் அடைந்த மிகப்பெரிய நாகரிகப் படிநிலைகளுள் ஒன்று குடும்ப அமைப்பாகும்’ - இக்கூற்றை நிறுவிய மானுடவியல் ஆய்வாளர் யார்?", "media_id": null}], "options": {"A": "மாலினோவ்ஸ்கி", "B": "லெவி ஸ்ட்ராஸ்", "C": "பக்தவத்சல பாரதி", "D": "இரா. நாகசாமி"}, "explanation": "பக்தவத்சல பாரதி தமது 'தமிழர் குடும்ப முறை' நூலில் குடும்பம் என்பது மனித நாகரிக வளர்ச்சியின் உச்சகட்ட சாதனை என நிறுவியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which anthropologist established that the 'institution of the family represents one of the crowning developmental milestones of human civilization'?", "media_id": null}], "options": {"A": "Bronislaw Malinowski", "B": "Claude Levi-Strauss", "C": "Bhakthavatsala Bharathi", "D": "R. Nagaswamy"}, "explanation": "Bhakthavatsala Bharathi elucidated the evolution of the family as an evolutionary summit of human culture."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-202