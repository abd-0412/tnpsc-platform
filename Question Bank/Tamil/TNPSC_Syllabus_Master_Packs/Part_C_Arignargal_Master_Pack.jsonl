{"id": "12th_tamil_mp1_q1649", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "suradha_birth_name", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உவமைக் கவிஞர் சுரதாவின் பெற்றோர் அவருக்கு இட்ட இயற்பெயர் யாது?", "media_id": null}], "options": {"A": "இராசகோபாலன்", "B": "சுப்புரத்தினம்", "C": "பழனிச்சாமி", "D": "மாணிக்கம்"}, "explanation": "சுரதாவின் இயற்பெயர் இராசகோபாலன் என்பதாகும். இவர் பழைய தஞ்சை மாவட்டம் பழையனூரில் பிறந்தார்."}, "en": {"blocks": [{"type": "text", "content": "What was the personal birth name given to Uvamai Kavignar Suradha by his parents?", "media_id": null}], "options": {"A": "Rajagopalan", "B": "Subburathinam", "C": "Palanichamy", "D": "Manikkam"}, "explanation": "Suradha's original given birth name was Rajagopalan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 79, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 79", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": nul