{"id": "11th_tamil_u4_q019", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "women_education_sangam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க காலத்தில் பெண்கல்வி தழைத்தோங்கியது என்பதற்குச் சிறந்த வரலாற்றுச் சான்று எது?", "media_id": null}], "options": {"A": "பெண்கள் போர் புரியாதது", "B": "பெண்கள் வெளிநாடுகளுக்குச் சென்றது", "C": "ஔவையார், வெள்ளிவீதியார், காக்கைப்பாடினியார் உள்ளிட்ட 40-க்கும் மேற்பட்ட பெண்பாற் புலவர்கள் பாடல்கள் இயற்றியுள்ளமை", "D": "கல்வெட்டுகளில் பெண்கள் பெயர் இல்லாமை"}, "explanation": "சங்க இலக்கியத்தில் 40-க்கும் மேற்பட்ட பெண்பாற் புலவர்கள் அரிய இலக்கியப் பாடல்களைப் பாடியிருப்பதே சங்க காலப் பெண்கல்வியின் பொற்காலச் சான்றாகும்."}, "en": {"blocks": [{"type": "text", "content": "What historical evidence proves that women's education flourished with distinction during the Sangam era?", "media_id": null}], "options": {"A": "Women abstaining from military service", "B": "Women traveling overseas", "C": "The existence of over 40 celebrated poetesses including Avvaiyar, Velliveethiyaar, and Kaakkaipaadiniyaar", "D": "Absence of inscriptions"}, "explanation": "Over 40 eminent women savants composed classical Sangam literature."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book",