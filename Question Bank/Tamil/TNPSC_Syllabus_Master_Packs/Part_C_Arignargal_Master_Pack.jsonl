{"id": "9th-u7-q009", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "captain-dasan-seychelles", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "டோக்கியோ போர் பயிற்சி பெற்ற இளைஞர்களில் ஒருவரான கேப்டன் தாசன் சுதந்திர இந்தியாவில் எந்நாட்டுத் தூதுவராகப் பணியாற்றினார்?", "media_id": null}], "options": {"A": "செசல்ஸ் (Seychelles)", "B": "மலேசியா", "C": "சிங்கப்பூர்", "D": "மியான்மர் (பர்மா)"}, "explanation": "டோக்கியோ போர் பயிற்சி பெற்ற தமிழர்களுள் குறிப்பிடத்தக்கவரான கேப்டன் தாசன், பின்பு சுதந்திர இந்தியாவில் 'செசல்ஸ்' நாட்டுத் தூதுவராகப் பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "To which nation did Tokyo Cadet trained officer Captain Dasan serve as independent India's ambassador/diplomatic envoy?", "media_id": null}], "options": {"A": "Seychelles (செசல்ஸ் நாட்டுத் தூதுவர்)", "B": "Malaysia", "C": "Singapore", "D": "Myanmar (Burma)"}, "explanation": "Captain Dasan, who underwent elite cadet training in Tokyo under Netaji's sponsorship, was appointed independent India's ambassador to Seychelles."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "editio