{"id": "9th-u2-q089", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-03-purananuru-thanneer", "chapter_id": null, "topic_id": "topic-purananuru-thanneer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'உணவெனப் படுவது நிலத்தொடு நீரே' - இவ்வடியின் மூலம் குடபுலவியனார் வலியுறுத்தும் முதன்மை வாழ்வியல் உண்மை யாது?", "media_id": null}], "options": {"A": "நீரையும் நிலத்தையும் ஒன்று சேர்த்தவர்களே இவ்வுலகில் உடலையும் உயிரையும் உருவாக்கியவர்கள்", "B": "மழையை மட்டும் நம்பி உழவு செய்வதே அரசனுக்கு நற்புகழைத் தரும்", "C": "உணவு உண்பதை விடப் போரில் வீரம் காட்டுவதே முதன்மையானது", "D": "நிலப்பரப்பை விரிவாக்குவதே ஒரு மன்னனின் தலையாய கடமை"}, "explanation": "உணவு என்பது நிலமும் நீரும் சேர்ந்ததே ஆகும்; எனவே நிலத்தையும் நீரையும் ஒன்று சேர்த்தவரே இவ்வுலகில் உடலையும் உயிரையும் படைத்தவர் ஆவர் எனப் புலவர் வலியுறுத்துகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What core philosophy does Kudapulaviyanaar advocate in 'Unavenap paduvadhu nilatthodu neerae'?", "media_id": null}], "options": {"A": "Those who unite land and water are verily the creators of both physical body and living soul", "B": "Depending solely on rain for agriculture brings everlasting fame to a king", "C": "Displaying valor in warfare is more vital than providing food", "D": "Expanding territorial boundaries is a monarch's paramount duty"}, "explanation": "Food consists of earth merged with water; hence whoever combines land with irrigation creates the body and breath of life."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 33, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 33", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_2", "purananuru", "thanneer", "kandharvan"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u2-q090", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-03-purananuru-thanneer", "chapter_id": null, "topic_id": "topic-purananuru-thanneer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புறநானூற்றுப் பாடலில் வரும் 'புன்புலம்' மற்றும் 'தாட்கு' ஆகியவற்றின் சரியான பொருள் யாது?", "media_id": null}], "options": {"A": "புன்புலம் - பூந்தோட்டம் ; தாட்கு - பாதத்திற்கு", "B": "புன்புலம் - புல்லிய நிலம் (வானம் பார்த்த பூமி) ; தாட்கு - முயற்சி / ஆளுமை", "C": "புன்புலம் - நன்செய் நிலம் ; தாட்கு - தண்டனைக்கு", "D": "புன்புலம் - சதுப்பு நிலம் ; தாட்கு - தலைவனுக்கு"}, "explanation": "சொல்லும் பொருளும்: புன்புலம் - புல்லிய நிலம் (வானம் பார்த்த மென்மையான நிலம்); தாட்கு - முயற்சி (ஆளுமை). வித்தி வான்நோக்கும் புன்புலம் அரசனின் முயற்சிக்கு உதவாது."}, "en": {"blocks": [{"type": "text", "content": "What do 'Punpulam' and 'Thaatku' signify in Kudapulaviyanaar's song?", "media_id": null}], "options": {"A": "Punpulam - Flower garden ; Thaatku - To the feet", "B": "Punpulam - Dry/infertile land dependent on rain ; Thaatku - Enterprise / governance effort", "C": "Punpulam - Wetland ; Thaatku - To punishment", "D": "Punpulam - Marshland ; Thaatku - To the chieftain"}, "explanation": "Glossary: 'Punpulam' means rain-dependent dry ground, and 'Thaatku' means royal enterprise or ruler's endeavor."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "n