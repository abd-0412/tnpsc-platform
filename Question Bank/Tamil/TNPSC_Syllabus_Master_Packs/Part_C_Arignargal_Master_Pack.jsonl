{"id": "9th-u5-q112", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l3", "chapter_id": null, "topic_id": "seidhai-lesson-value", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இக்கதை மாணவர்களிடையே எத்தகைய மனப்பாங்கை வளர்ப்பதை நோக்கமாகக் கொண்டுள்ளது?", "media_id": null}], "options": {"A": "போட்டி மனப்பான்மை", "B": "பொருளீட்டும் ஆசை", "C": "இயற்கையை அழித்தல்", "D": "பாரம்பரிய கலைகளையும் இசைக் கலைஞர்களையும் மதித்துப் போற்றும் பண்பாடு"}, "explanation": "நம் பாரம்பர்ய நுண்கலைகளையும், கலைக்காகத் தங்கள் வாழ்வை அர்ப்பணிக்கும் கலைஞர்களையும் போற்றிப் பாதுகாக்கும் உயர்ந்த பண்பாட்டுக் கண்ணோட்டத்தை மாணவர்களிடம் விதைப்பதே இப்பாடத்தின் நோக்கமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What positive value does the study of 'Seidhi' seek to instill among learners?", "media_id": null}], "options": {"A": "Aggressive competitiveness", "B": "Mercenary wealth accumulation", "C": "Destruction of habitats", "D": "Reverence and appreciation for traditional performing arts and dedicated artists"}, "explanation": "The lesson fosters deep cultural appreciation for classical arts and reverence for practicing artists."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpo