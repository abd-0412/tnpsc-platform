{"id": "6th-t3-u1-006", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதம் அன்றைய நாற்றங்கால் பாடலின் வரிகளை ஆராய்க:\n1. 'மெய்களைப் போற்றிய இந்தியத் தாய்க்கு மெய்யுணர்வு என்கிற மேலாடை'\n2. 'கல்லைக் கூடக் காவிய மாக்கிக் கட்டி நிறுத்திய கலைக்கூடம்'\n3. 'புல்வெளி யெல்லாம் பூக்காடாகிப் புன்னகை செய்த பொற்காலம்'", "media_id": null}], "options": {"A": "1, 2 மட்டும் சரி", "B": "1, 2, 3 ஆகிய அனைத்து வரிகளும் பாடலில் இடம்பெற்றுள்ளன", "C": "2, 3 மட்டும் சரி", "D": "1 மட்டும் சரி"}, "explanation": "இம்மூன்று வரிகளுமே தாராபாரதியின் பாரதம் அன்றைய நாற்றங்கால் பாடலில் உள்ள வரிகளாகும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'மெய்களைப் போற்றிய இந்தியத் தாய்க்கு மெய்யுணர்வு என்கிற மேலாடை'", "content_en": null}, {"id": "S2", "content_ta": "'கல்லைக் கூடக் காவிய மாக்கிக் கட்டி நிறுத்திய கலைக்கூடம்'", "content_en": null}, {"id": "S3", "content_ta": "'புல்வெளி யெல்லாம் பூக்காடாகிப் புன்னகை செய்த பொற்காலம்'", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Ta