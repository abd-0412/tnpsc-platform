{"id": "11th_tamil_u2_q001", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "prose_iyarkai_velanmai", "chapter_id": null, "topic_id": "nammazhvar_title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்நாட்டில் இயற்கை வேளாண்மையின் தேவையை மக்களிடம் தீவிரமாகப் பரப்பிய முதன்மை வேளாண் விஞ்ஞானி யார்?", "media_id": null}], "options": {"A": "கோ. நம்மாழ்வார்", "B": "எம். எஸ். சுவாமிநாதன்", "C": "ம. பொ. சிவஞானம்", "D": "நெல் ஜெயராமன் மட்டுமே"}, "explanation": "வேளாண் விஞ்ஞானி கோ. நம்மாழ்வார் தமிழ்நாட்டில் இயற்கை வேளாண்மை, பாரம்பரிய விதைகள் மீட்டெடுப்பு மற்றும் நஞ்சில்லா உணவின் முக்கியத்துவத்தை தீவிரமாகப் பரப்பியவர்."}, "en": {"blocks": [{"type": "text", "content": "Who was the foremost agricultural scientist who passionately championed the organic farming movement across Tamil Nadu?", "media_id": null}], "options": {"A": "G. Nammazhvar", "B": "M. S. Swaminathan", "C": "M. P. Sivagnanam", "D": "Nel Jayaraman alone"}, "explanation": "Agricultural scientist G. Nammazhvar spearheaded organic agriculture, indigenous seed conservation, and poison-free food."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025",