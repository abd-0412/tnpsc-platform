{"id": "11th_tamil_u2_q036", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_aethilik_kuruvigal", "chapter_id": null, "topic_id": "author_short_stories", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அழகிய பெரியவனின் சிறுகதைத் தொகுப்புகளில் சரியானது எது?", "media_id": null}], "options": {"A": "அக்கா", "B": "வம்சவிருத்தி", "C": "பறவைகள் ஒருவேளை தூங்கப் போயிருக்கலாம்", "D": "குரடு, நெறிக்கட்டு"}, "explanation": "‘குரடு’, ‘நெறிக்கட்டு’ ஆகியவை அழகிய பெரியவனின் குறிப்பிடத்தக்க சிறுகதைத் தொகுப்புகளாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following short story collections was authored by Azhagiya Periyavan?", "media_id": null}], "options": {"A": "Akka", "B": "Vamsaviruththi", "C": "Paravaigal Oruvelai Thoongap Poyirukkalaam", "D": "Kuradu, Nerikkattu"}, "explanation": "'Kuradu' and 'Nerikkattu' are prominent short story collections by Azhagiya Periyavan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 27", "url": null, "source_notes": null}, "previous_year": {"is_previous_year":