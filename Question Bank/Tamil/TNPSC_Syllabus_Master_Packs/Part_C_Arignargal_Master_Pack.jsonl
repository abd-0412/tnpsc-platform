{"id": "12th_tamil_u4_q604", "schema_version": "1.0", "kind": "statement", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "school_statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைய தமிழ்க் கல்வி முறை குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\nகூற்று 1: தொடக்கக் காலத்தில் மாணவர்கள் தரையில் மணலைப் பரப்பி விரலால் எழுதிப் பழகினர்.\nகூற்று 2: எழுத்தாணியால் பனையோலைகளில் எழுதிப் பழகிய பின்னரே சுவடிகள் அமைத்தனர்.", "media_id": null}], "options": {"A": "கூற்று 1 மட்டும் சரி", "B": "கூற்று 2 மட்டும் சரி", "C": "இரண்டு கூற்றுகளும் தவறு", "D": "இரண்டு கூற்றுகளும் சரி"}, "explanation": "மணலில் விரலால் எழுதிப் பழகிய பின்னரே எழுத்தாணியால் ஓலைச்சுவடிகளில் எழுதக் கற்றுக் கொடுத்தனர். இரண்டு கூற்றுகளும் உண்மை."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the assertions regarding pedagogical stages in ancient Tamil schools:\nAssertion 1: Beginners initially practiced orthography by tracing with fingers on floor sand beds.\nAssertion 2: Only after achieving manual fluency did they inscribe with iron styluses on palm leaves.", "media_id": null}], "options": {"A": "Assertion 1 only is correct", "B": "Assertion 2 only is correct", "C": "Both assertions are false", "D": "Both assertions are correct"}, "explanation": "Both statements accurately delineate traditional progressive stages of literacy instruction."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 72, "chapter": null, "section": null, "reference": "12th Tamil, Unit 4, Page 72", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 4", "Prose", "Pedagogical Stages"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u4_q605", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "uve_sa_library_chennai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உ.வே.சா அவர்களின் நினைவாகச் சென்னையில் அமைந்துள்ள நூல் நிலையம் எது?", "media_id": null}], "options": {"A": "உ.வே.சா நூல்நிலையம், பெசன்ட் நகர்", "B": "கன்னிமாரா பொது நூலகம்", "C": "அண்ணா நூற்றாண்டு நூலகம்", "D": "மறைமலையடிகள் நூலகம்"}, "explanation": "உ.வே.சா அவர்களின் அரிய சுவடிகள் மற்றும் புத்தகங்களைப் பாதுகாக்கச் சென்னை பெசன்ட் நகரில் ‘உ.வே.சா நூல்நிலையம்’ அமைக்கப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Which library in Chennai preserves the invaluable manuscript archives and personal collections of U. V. Swaminatha Iyer?", "media_id": null}], "options": {"A": "U. V. Swaminatha Iyer Library, Besant Nagar", "B": "Connemara Public Library", "C": "Anna Centenary Library", "D": "Maraimalai Adigal Library"}, "explanation": "The U. V. Swaminatha Iyer Library is located at Besant Nagar, Chennai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 70, "chapter": null, "section": null, "reference": "12th Tamil, Unit 4, Page 70", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 4", "Prose", "U. V. Sa Library"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u4_q606", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "uve_sa_honorary_doctorate", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உ.வே.சா அவர்களுக்கு ‘டாக்டர்’ (Doctor of Literature) பட்டமளித்துப் பெருமைப்படுத்திய பல்கலைக்கழகம் எது?", "media_id": null}], "options": {"A": "அண்ணாமலைப் பல்கலைக்கழகம்", "B": "சென்னைப் பல்கலைக்கழகம் (1932)", "C": "மதுரை காமராசர் பல்கலைக்கழகம்", "D": "பாரதியார் பல்கலைக்கழகம்"}, "explanation": "சென்னைப் பல்கலைக்கழகம் 1932-ஆம் ஆண்டு உ.வே.சா அவர்களின் தமிழ்ப் பணியைப் போற்றி ‘டி.லிட்’ (D.Litt) டாக்டர் பட்டம் வழங்கியது."}, "en": {"blocks": [{"type": "text", "content": "Which prestigious university conferred the honorary Doctorate of Literature (D.Litt) upon U. V. Swaminatha Iyer in 1932?", "media_id": null}], "options": {"A": "Annamalai University", "B": "Madras University (1932)", "C": "Madurai Kamaraj University", "D": "Bharathiar University"}, "explanation": "Madras University conferred an honorary D.Litt on U. V. Swaminatha Iyer in 1932."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2