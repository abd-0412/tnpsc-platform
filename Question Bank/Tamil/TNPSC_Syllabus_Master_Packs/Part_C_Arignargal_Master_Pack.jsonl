{"id": "12th_tamil_mp1_q1577", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_1", "chapter_id": null, "topic_id": "thandi_vetrumai_ani", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தன்னேர் இலாத தமிழ்’ பாடலில் பயின்றுவந்துள்ள அணி எது?", "media_id": null}], "options": {"A": "பொருள் வேற்றுமை அணி", "B": "தற்குறிப்பேற்ற அணி", "C": "வஞ்சப்புகழ்ச்சி அணி", "D": "உவமையணி"}, "explanation": "முதலில் இரு பொருள்களை (சூரியன், தமிழ்) ஒப்பிட்டு, பின் தமிழ் மக்களை அறியாமை இருளிலிருந்து மீட்டுத் தனக்கு நிகரற்றது எனப் பிரித்துக் காட்டுவதால் இது பொருள் வேற்றுமை அணி ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which rhetorical figure of speech (Ani) is employed in the poem 'Thanneer Ilaadha Thamizh'?", "media_id": null}], "options": {"A": "Porul Vetrumai Ani (Contrastive Antithesis)", "B": "Tharkurippetra Ani", "C": "Vanchappugazhchi Ani", "D": "Uvamai Ani"}, "explanation": "It employs Porul Vetrumai Ani by first comparing the sun and Tamil, and then distinguishing Tamil as uniquely peerless."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 8, "chapter": null, "section