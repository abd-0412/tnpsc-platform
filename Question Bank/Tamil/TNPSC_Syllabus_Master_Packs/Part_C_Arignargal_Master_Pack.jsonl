{"id": "12th_tamil_mp1_q1619", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_2", "chapter_id": null, "topic_id": "tholkappiyam_kizhavan_kizhavathi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொல்காப்பியத்தில் இல்லற வாழ்வின் தலைவன் மற்றும் தலைவியைக் குறிக்க ஆளப்பட்டுள்ள மரபுச் சொற்கள் எவை?", "media_id": null}], "options": {"A": "அரசன் - அரசி", "B": "கோன் - தேவி", "C": "கிழவன் - கிழத்தி", "D": "ஆண்டான் - அடிமை"}, "explanation": "‘கிழவன்’ என்றால் உரிமை உடையவன்; ‘கிழத்தி’ என்றால் உரிமை உடையவள். குடும்பத்தின் மீதும் நிலத்தின் மீதும் உரிமை கொண்டவர்களே கிழவன், கிழத்தி எனப்பட்டனர்."}, "en": {"blocks": [{"type": "text", "content": "Which classical Sangam terms are employed in Tholkappiyam to designate the male and female heads of a household?", "media_id": null}], "options": {"A": "King and Queen", "B": "Sovereign and Consort", "C": "Kizhavan and Kizhavathi (He who possesses rightful ownership and She who possesses rightful ownership)", "D": "Master and Serf"}, "explanation": "Tholkappiyar refers to spouses as Kizhavan and Kizhavathi, denoting proprietary custodians of the household."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "clas