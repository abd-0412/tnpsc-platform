{"id": "10th-u6-q066", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "muthukumarasami_pillaithamizh", "chapter_id": null, "topic_id": "pillaithamizh_total_paruvams", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிள்ளைத்தமிழ் சிற்றிலக்கியத்தில் பாடப்படும் மொத்தப் பருவங்கள் மற்றும் மொத்தப் பாடல்களின் எண்ணிக்கை முறையே எவ்வளவு?", "media_id": null}], "options": {"A": "7 பருவங்கள் - 70 பாடல்கள்", "B": "10 பருவங்கள் - 100 பாடல்கள் (பருவத்திற்கு 10 பாடல்கள் வீதம்)", "C": "12 பருவங்கள் - 120 பாடல்கள்", "D": "8 பருவங்கள் - 80 பாடல்கள்"}, "explanation": "பிள்ளைத்தமிழ் 10 பருவங்களைக் கொண்டு, ஒவ்வொரு பருவத்திற்கும் 10 பாடல்கள் வீதம் மொத்தம் 100 விருத்தப் பாடல்களால் பாடப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What are the total number of Paruvams (stages) and verses in a standard Pillaithamizh work?", "media_id": null}], "options": {"A": "7 stages - 70 verses", "B": "10 stages - 100 verses (10 verses per stage)", "C": "12 stages - 120 verses", "D": "8 stages - 80 verses"}, "explanation": "Pillaithamizh encompasses 10 Paruvams comprising 100 verses."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "