{"id": "12th_tamil_u4_q599", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "manuscript_ink_rubbing", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஓலைச்சுவடிகளில் எழுத்துக்கள் தெளிவாகவும் நீண்ட காலம் நிலைக்கவும் எதனைத் தடவினர்?", "media_id": null}], "options": {"A": "வண்ணச் சாயம்", "B": "எண்ணெய் மட்டும்", "C": "ஊமத்தஞ்சாறு, மாவிலைக்கரி முதலியவற்றால் செய்யப்பட்ட மை", "D": "சுண்ணாம்பு"}, "explanation": "எழுத்துக்கள் வெண்மையாகத் தெரியாமலும் பூச்சிகள் அரிக்காமலும் இருக்க ஊமத்தஞ்சாறு, மாவிலைக்கரி கலந்த மையைத் தடவினர்."}, "en": {"blocks": [{"type": "text", "content": "What herbal ink concoction was rubbed over incised palm-leaf scrolls to enhance legibility and repel insect pests?", "media_id": null}], "options": {"A": "Chemical dyes", "B": "Pure coconut oil", "C": "Herbal soot ink prepared from Datura leaf juice (Oomathai) and charred mango leaves", "D": "Slaked lime"}, "explanation": "Inks prepared with Datura juice and mango-leaf soot were rubbed onto inscribed leaves for clarity and preservation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "