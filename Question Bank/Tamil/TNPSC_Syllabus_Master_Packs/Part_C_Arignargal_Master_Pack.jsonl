{"id": "6th-t1-u2-066", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): ஆய்த எழுத்து சொல்லின் இடையில் மட்டுமே வரும் வரம்புடையது.\nகாரணம் (R): ஆய்த எழுத்து மூன்று புள்ளிகளை உடைய தனித்த முக்கோண வடிவம் பெற்றது.", "media_id": null}], "options": {"A": "கூற்று (A) சரி; காரணம் (R) தவறு.", "B": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் (R) என்பது கூற்றுக்கு (A) சரியான விளக்கம் அல்ல.", "C": "கூற்று (A) தவறு; காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "கூற்று மற்றும் காரணத்தில் உள்ள செய்திகள் இரண்டுமே உண்மையானவை. ஆனால் மூன்று புள்ளிகளைப் பெற்றுள்ளது என்பது அதன் வடிவம்; அது சொல்லின் இடையில் வருவதற்கான ஒலியியல் இலக்கண விளக்கம் அல்ல. எனவே B சரி."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "ஆய்த எழுத்து சொல்லின் இடையில் மட்டுமே வரும் வரம்புடையது.", "reason": "ஆய்த எழுத்து மூன்று புள்ளிகளை உடைய தனித்த முக்கோண வடிவம் பெற்றது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Serv