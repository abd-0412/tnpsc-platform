{"id": "11th_tamil_u7_q104", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "puratchikkavi_rhetoric_scaffold", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கொலைக்களத்தில் உதாரன் பேசும் கவிதைகளில் ஒலிக்கும் முதன்மையான முழக்கம் எத்தகையது?", "media_id": null}], "options": {"A": "மன்னனின் செங்கோல் வாழ்க", "B": "விதியை யாராலும் வெல்ல முடியாது", "C": "மௌனமே சிறந்தது", "D": "\"எங்கள் தமிழ் வாழ்க! எங்கள் மக்கள் உரிமை வாழ்க! சாதி குலங்களை மாய்ப்போம்! மனிதநேய சமதர்மம் மலர்க!\""}, "explanation": "உதாரனின் கொலைக்களப் பேச்சு தமிழின் மாண்பையும், உழைக்கும் மக்களின் சமத்துவ விடுதலையையும் முழங்கும் புரட்சிப் பிரகடனமாக அமைகிறது."}, "en": {"blocks": [{"type": "text", "content": "What supreme manifesto resonates through Udharan's scaffold verses?", "media_id": null}], "options": {"A": "Long live the royal sceptre", "B": "None can conquer fate", "C": "Silence is supreme", "D": "\"Long live glorious Tamil! Long live people freedom! Eradicate caste hierarchy! Let egalitarian socialist humanism bloom!\""}, "explanation": "His speech constitutes a soaring manifesto for human equality and linguistic pride."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and E