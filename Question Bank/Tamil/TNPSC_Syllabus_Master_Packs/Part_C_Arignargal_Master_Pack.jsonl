{"id": "9th-u1-q059", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-02-tamilvidu-thoothu", "chapter_id": null, "topic_id": "topic-uvesa-pathippu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்விடு தூது நூலை 1930-ஆம் ஆண்டு முதன்முதலில் அச்சுப் பதிப்பாக வெளியிட்ட தமிழறிஞர் யார்?", "media_id": null}], "options": {"A": "சி.வை. தாமோதரம்பிள்ளை", "B": "மறைமலையடிகள்", "C": "உ.வே. சாமிநாதையர்", "D": "ரா.பி. சேதுப்பிள்ளை"}, "explanation": "தமிழ் தாத்தா உ.வே. சாமிநாதையர் 1930-இல் தமிழ்விடு தூது நூலை முதன்முதலில் பதிப்பித்து வெளியிட்டார்; இந்நூலின் ஆசிரியர் பெயர் அறியப்படவில்லை."}, "en": {"blocks": [{"type": "text", "content": "Which eminent Tamil savant first edited and published Tamilvidu Thoothu in print format in the year 1930?", "media_id": null}], "options": {"A": "C.W. Damodaram Pillai", "B": "Maraimalai Adigal", "C": "U.V. Swaminatha Iyer (U.Ve.Sa)", "D": "R.P. Sethu Pillai"}, "explanation": "Dr. U.V. Swaminatha Iyer recovered and edited the palm-leaf manuscript of Tamilvidu Thoothu in 1930."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 3, "chapter": null, "section": null