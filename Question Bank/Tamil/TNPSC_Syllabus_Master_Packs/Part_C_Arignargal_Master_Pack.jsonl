{"id": "11th_tamil_u8_q112", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_inkulab", "chapter_id": null, "topic_id": "inkulab_muthukumar_commonality", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இன்குலாப் மற்றும் நா. முத்துக்குமார் ஆகிய இரு கவிஞர்களின் பாடப்பகுதிகள் மாணவர்களிடம் வளர்க்கும் பொதுவான அறப்பண்பு எது?", "media_id": null}], "options": {"A": "சுயநல வாழ்க்கை", "B": "பணத்தின் மீது வெறி", "C": "எல்லைகளைக் கடந்த பகைமை", "D": "இயற்கையைப் போற்றுதல், மனிதநேயத்தைப் பேணிக்காத்தல், போலி முகமூடிகளைத் துறந்து உண்மை அன்போடு வாழ்தல்"}, "explanation": "இரு கவிஞர்களும் இயற்கையையும் மனிதத்தையும் போற்றுவதையும், இயந்திரத்தனமான போலி வாழ்க்கையிலிருந்து விடுபட்டு அன்போடு வாழ்வதையுமே வலியுறுத்துகின்றனர்."}, "en": {"blocks": [{"type": "text", "content": "What shared humanist virtue do the poems of Inquilab and Na. Muthukumar collectively inculcate in young learners?", "media_id": null}], "options": {"A": "Solipsistic selfishness", "B": "Greed for monetary accumulation", "C": "Hostility across national borders", "D": "Reverence for nature, preserving genuine humanity, discarding hypocritical masks, and living with authentic love"}, "explanation": "Both visionary poets summon humanity to shed artificial pretensions and rediscover organic love for all beings."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answe