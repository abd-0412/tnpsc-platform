{"id": "9th-u1-q058", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-02-tamilvidu-thoothu", "chapter_id": null, "topic_id": "topic-pattudaithalaivan-kannigal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்விடு தூது எந்தத் தெய்வத்தின் மீது பாடப்பட்டது? இந்நூலில் உள்ள மொத்தக் கண்ணிகள் எத்தனை?", "media_id": null}], "options": {"A": "திருச்செந்தூர் முருகன் மீது; 250 கண்ணிகள்", "B": "மதுரை சொக்கநாதர் மீது; 268 கண்ணிகள்", "C": "தஞ்சைப் பெருவுடையார் மீது; 260 கண்ணிகள்", "D": "சிதம்பரம் நடராசர் மீது; 300 கண்ணிகள்"}, "explanation": "தமிழ்விடு தூது மதுரையில் எழுந்தருளியுள்ள சொக்கநாதர் மீது காதல் கொண்ட பெண் ஒருத்தி பாடியது; இந்நூல் 268 கண்ணிகளைக் கொண்டது."}, "en": {"blocks": [{"type": "text", "content": "On which presiding deity is Tamilvidu Thoothu dedicated, and how many rhyming couplets (Kannigal) does it contain?", "media_id": null}], "options": {"A": "Lord Murugan of Tiruchendur; 250 Kannigal", "B": "Lord Chokkanathar of Madurai; 268 Kannigal", "C": "Lord Brihadisvara of Thanjavur; 260 Kannigal", "D": "Lord Nataraja of Chidambaram; 300 Kannigal"}, "explanation": "Tamilvidu Thoothu is addressed to Lord Chokkanathar of Madurai and comprises exactly 268 couplets."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publi