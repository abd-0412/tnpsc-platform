{"id": "9th-u4-q023", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u4-kalvi", "lesson_id": "lesson-01-kalviyil-sirantha-pengal", "chapter_id": null, "topic_id": "topic-kalviyil-sirantha-pengal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆண்கள் பல பெண்களை மணந்து பெண்களைக் கைவிடும் நிலையைத் தடுக்க 'இருதார தடைச் சட்டம்' கொண்டுவரப்பட்டதில் யாருடைய பங்கு முதன்மையானது?", "media_id": null}], "options": {"A": "அன்னி பெசன்ட்", "B": "வேலு நாச்சியார்", "C": "டாக்டர் முத்துலட்சுமி ரெட்டி", "D": "ராணி மங்கம்மாள்"}, "explanation": "ஆண்கள் இருதார மணம் புரிவதைத் தடுக்கும் 'இருதார தடைச் சட்டம்' கொண்டுவரப்படக் காரணமாக இருந்தவர் டாக்டர் முத்துலட்சுமி ரெட்டி ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Whose resolute advocacy was central to the enactment of the Bigamy Prohibition Act prohibiting polygyny?", "media_id": null}], "options": {"A": "Annie Besant", "B": "Velu Nachiyar", "C": "Dr. Muthulakshmi Reddi", "D": "Rani Mangammal"}, "explanation": "Dr. Muthulakshmi was the chief architect advocating the Bigamy Prohibition Act protecting vulnerable married women."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025",