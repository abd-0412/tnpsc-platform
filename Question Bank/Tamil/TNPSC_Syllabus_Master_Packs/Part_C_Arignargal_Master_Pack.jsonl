{"id": "11th_tamil_u4_q042", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "danish_mission_tranquebar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "1715-இல் தரங்கம்பாடியில் முதன்முதலில் பெண்களுக்கான பள்ளியை நிறுவி, தமிழ்நாட்டில் நவீனப் பெண் கல்விக்கு வித்திட்ட டேனிஷ் மிஷனரி யார்?", "media_id": null}], "options": {"A": "கால்டுவெல்", "B": "பார்த்தலோமியோ சீகன்பால்கு (Bartholomaeus Ziegenbalg)", "C": "போப்", "D": "எல்லிஸ்"}, "explanation": "டேனிஷ் மிஷனரியான சீகன்பால்கு தரங்கம்பாடியில் தமிழ் அச்சுக்கூடத்தை நிறுவியதுடன், பெண்களுக்கான பள்ளியையும் முதன்முதலில் தொடங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "Which Danish missionary established a pioneering school for girls in Tranquebar around 1715, early in colonial education?", "media_id": null}], "options": {"A": "Robert Caldwell", "B": "Bartholomaeus Ziegenbalg", "C": "G. U. Pope", "D": "Francis Whyte Ellis"}, "explanation": "Ziegenbalg set up early indigenous community schools including schooling for girls in Tranquebar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-