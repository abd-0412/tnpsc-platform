{"id": "12th_tamil_u1_q010", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamil_nadai_azhagiyal", "chapter_id": null, "topic_id": "critical_works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வருவனவற்றுள் பேராசிரியர் தி.சு. நடராசன் எழுதிய திறனாய்வு நூல்களுள் ஒன்று எது?", "media_id": null}], "options": {"A": "கவிதை எனும் மொழி", "B": "திறனாய்வுக் கலை", "C": "தமிழ் நாவல்கள்", "D": "புதிய பார்வை"}, "explanation": "தி.சு. நடராசன் எழுதிய புகழ்பெற்ற கல்விசார் ஆய்வு நூல்களில் 'திறனாய்வுக் கலை' முதன்மையான ஒன்றாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following is a major literary critical treatise authored by Prof. T. S. Natarajan?", "media_id": null}], "options": {"A": "Kavithai Enum Mozhi", "B": "Thiranaivuk Kalai", "C": "Tamil Novels", "D": "Puthiya Paarvai"}, "explanation": "'Thiranaivuk Kalai' is an authoritative university textbook on literary criticism authored by him."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 4, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 4", "url": null, "source_notes": null}, "previous_year":