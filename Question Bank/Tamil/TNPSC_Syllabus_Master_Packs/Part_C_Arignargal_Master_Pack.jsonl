{"id": "11th_tamil_u5_q139", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "supplementary_bimbam", "chapter_id": null, "topic_id": "muttai_genre", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிரபஞ்சன் இயற்றிய 'முட்டை' என்னும் படைப்பு முதன்மையாக எந்த இலக்கிய வகைமைக்குரியது?", "media_id": null}], "options": {"A": "கவிதை நூல்", "B": "பயண இலக்கியம்", "C": "நாடகம் (மேடை நாடக நூல்)", "D": "வரலாற்றுக் காப்பியம்"}, "explanation": "'முட்டை' என்பது பிரபஞ்சன் எழுதிய புகழ்பெற்ற மேடை நாடக நூலாகும்."}, "en": {"blocks": [{"type": "text", "content": "To which literary genre does Prabanjan's work 'Muttai' belong?", "media_id": null}], "options": {"A": "Poetry", "B": "Travelogue", "C": "Play / Drama", "D": "Historical epic"}, "explanation": "'Muttai' is a well-known theatrical play written by Prabanjan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 120, "chapter": null, "section": null, "reference": "11th Tamil, Unit 5, Page 120", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media":