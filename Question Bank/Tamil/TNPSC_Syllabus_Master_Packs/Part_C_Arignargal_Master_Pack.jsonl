{"id": "8th-u6-q756", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u6-naadu", "lesson_id": "8th-u6-l2", "chapter_id": null, "topic_id": "mgr-primary-school-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எம்.ஜி.ஆர் தம் இளமைக் காலத்தில் கும்பகோணத்தில் தொடக்கக் கல்வி பயின்ற பள்ளியின் பெயர் என்ன?"}], "options": {"A": "காமராசர் நகராட்சிப் பள்ளி", "B": "தூய வளனார் பள்ளி", "C": "அரசினர் மாதிரிப் பள்ளி", "D": "ஆணையடிப் பள்ளி"}, "explanation": "பாடநூல் பக். 117: 'கும்பகோணத்தில் உள்ள ஆணையடிப் பள்ளி... அங்கே உடன்பிறந்தோராகிய இரண்டு சிறுவர்கள் பசியுடன் ஓர் ஓரமாக அமர்ந்திருக்கின்றனர்'."}, "en": {"blocks": [{"type": "text", "content": "What was the name of the school in Kumbakonam where M.G.R. received his primary education in childhood?"}], "options": {"A": "Kamarajar Municipal School", "B": "St. Joseph's School", "C": "Government Model School", "D": "Aanaiyadi School"}, "explanation": "Textbook Page 117 opens the narrative at 'Aanaiyadi School in Kumbakonam' where young M.G.R. and his brother studied."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025",