{"id": "7th-t1-u2-167", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l3-kapparkalai", "chapter_id": null, "topic_id": "ship-nails-name-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழர்கள் கப்பல் கட்டும்போது மரப்பலகைகளை ஒன்றோடொன்று இணைப்பதற்குப் பயன்படுத்திய மர ஆணிகளுக்கு என்ன பெயர்?"}], "options": {"A": "எரா", "B": "சுக்கான்", "C": "தொகுதி", "D": "பருமல்"}, "explanation": "பாடநூல் குறிப்பு: மரப்பலகைகளை இணைக்கப் பயன்படுத்திய மர ஆணிகளுக்குத் 'தொகுதி' என்று பெயர்."}, "en": {"blocks": [{"type": "text", "content": "What specific technical name did ancient Tamils give to the wooden pegs/nails used to fasten ship planks?"}], "options": {"A": "Eraa", "B": "Sukkaan", "C": "Thogudhi (தொகுதி)", "D": "Parumal"}, "explanation": "Textbook fact: Wooden nails utilized to fasten timber hulls were designated as 'Thogudhi'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 32, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_n