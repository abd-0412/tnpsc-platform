{"id": "11th_tamil_u2_q083", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_thirumalai_murugan_pallu", "chapter_id": null, "topic_id": "significance_of_pallu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மன்னர்களையும் கடவுளர்களையும் மட்டுமே பாடிக்கொண்டிருந்த சிற்றிலக்கிய மரபில், உழைக்கும் பாட்டாளி மக்களை முதன்மைப் பாத்திரங்களாக மாற்றிய இலக்கியம் எது?", "media_id": null}], "options": {"A": "உலா", "B": "பரணி", "C": "பள்ளு இலக்கியம்", "D": "பிள்ளைத் தமிழ்"}, "explanation": "மண்ணில் உழைக்கும் ஏழை எளிய உழவர்களையும் உழத்தியரையும் காப்பியத் தலைவர்களாக ஏற்றிப் போற்றியது பள்ளு இலக்கியத்தின் பெரும் புரட்சியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which genre revolutionized classical Tamil literature by elevating humble working peasants into primary protagonists?", "media_id": null}], "options": {"A": "Ula", "B": "Parani", "C": "Pallu Literature", "D": "Pillaithamizh"}, "explanation": "Pallu literature democratized literature by enshrining the working peasantry as heroic protagonists."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 28, "chapter": null, "section": null