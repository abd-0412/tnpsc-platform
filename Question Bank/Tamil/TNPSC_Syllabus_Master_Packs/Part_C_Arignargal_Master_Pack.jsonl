{"id": "12th_tamil_u2_q308", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "moral_takeaway", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘முதல் கல்’ சிறுகதை மாணவர்களுக்கும் சமுதாயத்திற்கும் புகட்டும் முதன்மையான பாடம் எது?", "media_id": null}], "options": {"A": "சமூகப் பிரச்சினைகளை அரசு மட்டுமே தீர்க்க வேண்டும்", "B": "இயற்கைச் சீற்றங்களை எதிர்கொள்ள முடியாது", "C": "பிறர் உழைப்பைச் சுரண்ட வேண்டும்", "D": "சமூகப் பொதுப் பணிகளில் வேடிக்கை பார்க்காமல், தயங்காமல் முதல் அடியை நாம் எடுத்து வைக்க வேண்டும்"}, "explanation": "வேடிக்கை பார்க்கும் கூட்டமாக இராமல், மாற்றத்திற்கான முதல் படியைத் துணிந்து எடுத்து வைப்பவனே உண்மையான வழிகாட்டி என்பதை இக்கதை உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What vital ethical lesson does 'Mudhal Kal' impart to students and society at large?", "media_id": null}], "options": {"A": "Social crises should be resolved solely by government bureaucracy", "B": "Natural calamities are insurmountable", "C": "One must exploit the labor of fellow citizens", "D": "Instead of remaining passive bystanders, one must bravely take the initiative and cast the first stone for common good"}, "explanation": "The story teaches that instead of being passive spectators, individuals must have the courage to take the first proactive step for collective good."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": "12th Tamil, Unit 2, Page 36", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 2", "Supplementary", "Moral Takeaway"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

