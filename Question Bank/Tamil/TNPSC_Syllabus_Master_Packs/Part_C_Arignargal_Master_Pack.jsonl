{"id": "6th-t1-u3-037", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காமராசரின் சிறப்புப் பெயர்களைப் பொருத்துக:\nபட்டியல் I:\nஅ) படிக்காத\nஆ) கருப்புக்\nஇ) ஏழைப்\nஈ) கர்ம\n\nபட்டியல் II:\n1. காந்தி\n2. பங்காளர்\n3. மேதை\n4. வீரர்", "media_id": null}], "options": {"A": "3, 1, 2, 4", "B": "1, 3, 2, 4", "C": "4, 2, 1, 3", "D": "2, 4, 3, 1"}, "explanation": "அ) படிக்காத மேதை (3)\nஆ) கருப்புக் காந்தி (1)\nஇ) ஏழைப் பங்காளர் (2)\nஈ) கர்மவீரர் (4)\nசரியான வரிசை: 3, 1, 2, 4."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u3", "section": null, "reference": "6th Tamil, Term 1, Unit 3, Page 49", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_n