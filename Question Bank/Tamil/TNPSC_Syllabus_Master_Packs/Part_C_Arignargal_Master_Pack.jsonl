{"id": "10th-u8-q036", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "gnanam", "chapter_id": null, "topic_id": "optimistic_philosophy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் தி. சோ. வேணுகோபாலன் தமது \"ஞானம்\" கவிதையின் வாயிலாக மனிதர்களுக்கு ஊட்டும் தலையாய உளவியல் பண்பு எது?", "media_id": null}], "options": {"A": "எதிர்மறை எண்ணம்", "B": "சோம்பல்", "C": "பயம்", "D": "நேர்மறைச் சிந்தனையும், தளராத வாழ்வியல் நம்பிக்கையும் (Optimism)"}, "explanation": "காலம் எத்தகைய துயரங்களையும் கரைத்துவிடும் என்ற நம்பிக்கையோடு, மனிதன் தன் அகக்கண்களைத் திறந்து புதிய வெளிச்சத்தைப் பெற வேண்டும் என்ற நேர்மறை ஊக்கத்தை அளிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What psychological fortitude does Thi. So. Venugopalan instill through \"Gnaanam\"?", "media_id": null}], "options": {"A": "Cynical fatalism", "B": "Chronic lethargy", "C": "Paralyzing fear", "D": "Resilient optimism and positive inner affirmation"}, "explanation": "The verse inspires resilient optimism and forward-looking faith."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 180, "chapter": null, "section": null, 