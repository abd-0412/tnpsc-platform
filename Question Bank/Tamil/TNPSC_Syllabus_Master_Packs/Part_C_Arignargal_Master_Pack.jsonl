{"id": "9th-u6-q110", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l4", "chapter_id": null, "topic_id": "space-centre-sriharikota", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியாவில் ஆந்திர மாநிலம் ஸ்ரீஹரிகோட்டாவில் அமைந்துள்ள ராக்கெட் ஏவுதள ஆய்வு மையம் யாருடைய பெயரால் அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "விக்ரம் சாராபாய் விண்வெளி மையம்", "B": "சதீஷ் தவான் விண்வெளி மையம் (SDSC - SHAR)", "C": "அப்துல் கலாம் ஏவுதளம்", "D": "இஸ்ரோ மையம்"}, "explanation": "ஆந்திர மாநிலம் ஸ்ரீஹரிகோட்டாவில் உள்ள இந்தியாவின் முதன்மை ராக்கெட் ஏவுதளம் புகழ்பெற்ற விஞ்ஞானி 'சதீஷ் தவான் விண்வெளி மையம்' (Satish Dhawan Space Centre) என அழைக்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "After which renowned aerospace pioneer is the spaceport at Sriharikota in Andhra Pradesh named?", "media_id": null}], "options": {"A": "Vikram Sarabhai Space Centre", "B": "Satish Dhawan Space Centre (SDSC - SHAR)", "C": "Abdul Kalam Launch Base", "D": "ISRO Hub"}, "explanation": "The Sriharikota spaceport is officially designated the Satish Dhawan Space Centre (SDSC)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full