{"id": "9th-u4-q096", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l4", "chapter_id": null, "topic_id": "anna-tamil-journals", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வருவனவற்றுள் பேரறிஞர் அண்ணா நடத்திய/பணியாற்றிய தமிழ் இதழ்களுள் சேராதது எது?", "media_id": null}], "options": {"A": "திராவிடநாடு", "B": "நம்நாடு", "C": "காஞ்சி", "D": "சுதேசமித்திரன்"}, "explanation": "அண்ணா திராவிடநாடு, நம்நாடு, மாலைமணி, காஞ்சி ஆகிய இதழ்களில் ஆசிரியராகப் பணியாற்றினார். 'சுதேசமித்திரன்' ஜி. சுப்பிரமணிய ஐயர் அவர்களால் தொடங்கப்பட்ட இதழாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following Tamil periodicals was NOT edited or founded by Perarignar Anna?", "media_id": null}], "options": {"A": "Dravida Nadu", "B": "Nam Nadu", "C": "Kanchi", "D": "Swadesamitran"}, "explanation": "Anna was associated with Dravida Nadu, Nam Nadu, Maalai Mani, and Kanchi. 'Swadesamitran' was established by G. Subramania Iyer."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 95, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 95", "url": null, "source_notes": 