{"id": "9th-u8-q042", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-e-ve-ra-full-name", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஈ.வெ.ரா.' என்பதன் விரிவாக்கம் யாது?", "media_id": null}], "options": {"A": "ஈரோடு வெங்கடேசன் ராமானுஜம்", "B": "ஈரோடு வேங்கடப்பர் மகன் இராமசாமி", "C": "ஈரோடு வேலுச்சாமி ரத்தினம்", "D": "ஈரோடு வைகுண்டம் ராஜகோபால்"}, "explanation": "ஈரோடு மாநகரில் வேங்கடப்பரின் மகனாகப் பிறந்ததால் 'ஈரோடு வேங்கடப்பர் மகன் இராமசாமி' (ஈ.வெ.ரா.) என அழைக்கப்பட்டார்."}, "en": {"blocks": [{"type": "text", "content": "What is the full expansion of the initials in 'E.V.Ra.' (ஈ.வெ.ரா.)?", "media_id": null}], "options": {"A": "Erode Venkatesan Ramanujam", "B": "Erode Venkatappa's son Ramasamy (ஈரோடு வேங்கடப்பர் மகன் இராமசாமி)", "C": "Erode Veluchami Rathinam", "D": "Erode Vaikundam Rajagopal"}, "explanation": "E.V.R. expands to Erode Venkatappa Ramasamy (E.V. Ramasamy)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 154, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 154", "url": null, "source_notes": 