{"id": "9th-u3-q084", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-02-manimekalai", "chapter_id": null, "topic_id": "topic-manimekalai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புகார் நகரில் இந்திர விழா நடைபெறுவதை மக்களுக்கு அறிவிக்க முரசு அறைந்தவர் யார்?", "media_id": null}], "options": {"A": "சோழ மன்னன்", "B": "சீத்தலைச் சாத்தனார்", "C": "காவல் படைத்தளபதி", "D": "அரசனின் ஆணைபெற்று யானை மீது முரசு அறைந்து சென்ற வீரன் / வள்ளுவன்"}, "explanation": "'ஒளிறுவாள் மறவரும் தேரும் மாவும் களிறும் சூழ்தரக் கண்முரசு இயம்பி... அணிவிழா அறைந்தனன்' - அரசனின் ஆணைபெற்ற வீரன் யானை மீது முரசு ஏற்றி நகர் முழுவதும் அறைந்து அறிவித்தான்."}, "en": {"blocks": [{"type": "text", "content": "Who formally announced the celebration of the Indra carnival throughout Poompuhar?", "media_id": null}], "options": {"A": "The Chola Emperor in person", "B": "Seethalai Saathanaar", "C": "The chief commander of the army", "D": "The royal herald beating the proclamation drum mounted atop an elephant flanked by chariot guards"}, "explanation": "Escorted by glittering swordsmen, cavalry, and chariots, the royal drummer mounted an elephant and sounded the auspicious proclamation drum."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publish