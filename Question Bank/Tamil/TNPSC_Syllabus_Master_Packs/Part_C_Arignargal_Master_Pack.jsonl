{"id": "10th-u9-q006", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "jayakanthan", "chapter_id": null, "topic_id": "short_story_agnipravesam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆனந்த விகடனில் வெளியாகிப் பெரும் இலக்கிய விவாதத்தை ஏற்படுத்திய ஜெயகாந்தனின் புகழ்பெற்ற சிறுகதை எது?", "media_id": null}], "options": {"A": "நான் இருக்கிறேன்", "B": "அக்னிப்பிரவேசம்", "C": "யுகசந்தி", "D": "சுமைதாங்கி"}, "explanation": "பாடநூல் குறிப்பு: ஜெயகாந்தன் எழுதிய \"அக்னிப்பிரவேசம்\" சிறுகதை மிகப்பெரிய சமூக விவாதங்களை உருவாக்கியது; அதன் தொடர்ச்சியாகவே \"சில நேரங்களில் சில மனிதர்கள்\" நாவல் பிறந்தது."}, "en": {"blocks": [{"type": "text", "content": "Which pathbreaking short story by Jayakanthan published in Ananda Vikatan sparked widespread intellectual debate?", "media_id": null}], "options": {"A": "Naan Irukkiren", "B": "Agnipravesam", "C": "Yugasandhi", "D": "Sumaithaangi"}, "explanation": "Agnipravesam generated immense cultural discussions, leading to Sila Nerangalil Sila Manithargal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 198, "chapter": null, "section": null, "reference": "