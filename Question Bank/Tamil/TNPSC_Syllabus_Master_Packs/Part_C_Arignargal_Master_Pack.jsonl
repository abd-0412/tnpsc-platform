{"id": "9th-u7-q028", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "netaji-quote-sacrifice-price", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நேதாஜியின் பொன்மொழி: \"விடுதலையினால் உண்டாகும் மகிழ்ச்சியும் சுதந்திரத்தினால் உண்டாகும் மனநிறைவும் வேண்டுமானால் அதற்குரிய விலை ______.\"", "media_id": null}], "options": {"A": "பணமும் பொருளும்", "B": "அறிவும் ஆற்றலும்", "C": "பொறுமையும் அமைதியும்", "D": "துன்பமும் தியாகமும்தான்"}, "explanation": "பாடநூலில் இடம்பெற்றுள்ள நேதாஜியின் பொன்மொழி: 'விடுதலையினால் உண்டாகும் மகிழ்ச்சியும் சுதந்திரத்தினால் உண்டாகும் மனநிறைவும் வேண்டுமா? அப்படியானால் அதற்கு விலையுண்டு. அவற்றுக்கான விலை துன்பமும் தியாகமும்தான்.'"}, "en": {"blocks": [{"type": "text", "content": "Complete Netaji's famous maxim: 'Do you want the joy of liberation and the peace of freedom? If so, the price for it is ______.'", "media_id": null}], "options": {"A": "Wealth and material treasures", "B": "Knowledge and sheer energy", "C": "Patience and tranquility", "D": "Suffering and sacrifice (துன்பமும் தியாகமும்தான்)"}, "explanation": "Netaji inscribed: 'The price of liberty is eternal suffering and sacrifice.'"}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 133, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 133", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_7", "netaji", "golden_quote"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

