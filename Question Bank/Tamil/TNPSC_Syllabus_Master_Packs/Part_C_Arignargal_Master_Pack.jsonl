{"id": "12th_tamil_mp1_q1632", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_3", "chapter_id": null, "topic_id": "road_safety_golden_hour", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சாலைப் பாதுகாப்பில் விபத்து நடந்த முதல் ஒரு மணி நேரத்திற்கு என்ன பெயர்?", "media_id": null}], "options": {"A": "வெள்ளி மணி", "B": "சிவப்பு மணி", "C": "ஆபத்து நேரம்", "D": "தங்க மணித்துளிகள் (Golden Hour)"}, "explanation": "விபத்து நடந்த முதல் ஒரு மணி நேரத்திற்குள் மருத்துவ உதவி கிடைத்தால் உயிரைக் காப்பாற்ற முடியும் என்பதால் இது 'தங்க மணித்துளிகள்' எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "In trauma care and road safety guidelines, what is the critical first 60 minutes following an accident termed?", "media_id": null}], "options": {"A": "Silver Hour", "B": "Red Hour", "C": "Hazard Time", "D": "The Golden Hour"}, "explanation": "The first hour post-injury when prompt medical care can avert fatality is globally termed the 'Golden Hour'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 92, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1,