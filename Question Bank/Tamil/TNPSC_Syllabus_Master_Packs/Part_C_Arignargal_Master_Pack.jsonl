{"id": "10th-u5-q035", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "translator_qualities", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒரு சிறந்த மொழிபெயர்ப்பாளருக்கு (Translator) இருக்க வேண்டிய தலையாய தகுதிகள் யாவை?", "media_id": null}], "options": {"A": "ஒரு மொழியில் மட்டுமே ஆழ்ந்த புலமை கொண்டிருத்தல்", "B": "அகராதியை மட்டும் பார்த்து வார்த்தைகளை இணைத்தல்", "C": "மூல மொழி மற்றும் பெயர்க்கும் மொழி ஆகிய இரண்டிலும் ஆழமான இலக்கண, இலக்கிய, பண்பாட்டுப் புலமை பெற்றிருத்தல்", "D": "எந்தக் கருத்தையும் சுருக்கி எழுதுதல்"}, "explanation": "சிறந்த மொழிபெயர்ப்பாளர் மூல மொழி (Source Language), இலக்கு மொழி (Target Language) இரண்டிலும் பண்பாட்டுப் புரிதலுடன் சமமான ஆழ்ந்த புலமை பெற்றிருக்க வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "What fundamental credentials characterize an accomplished professional translator?", "media_id": null}], "options": {"A": "Monolingual depth only", "B": "Mechanical dictionary word matching", "C": "Profound grammatical, literary, and cultural command over both source and target languages", "D": "Habitual textual compression"}, "explanation": "Bilingual mastery and intercultural nuance define an exceptional translator."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_na