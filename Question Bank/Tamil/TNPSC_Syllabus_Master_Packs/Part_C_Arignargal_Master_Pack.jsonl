{"id": "11th_tamil_u3_q026", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "prose_malai_idappeyargal", "chapter_id": null, "topic_id": "korkai_in_greece", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கிரேக்க வரலாற்று ஆய்வாளர் தாலமி மற்றும் பெரிப்ளூஸ் நூல்களில் குறிப்பிடப்படும் பாண்டிய நாட்டின் துறைமுகம் எது?", "media_id": null}], "options": {"A": "பூம்புகார்", "B": "கொற்கை (Colchi)", "C": "மாமல்லபுரம்", "D": "நாகப்பட்டினம்"}, "explanation": "பண்டைய கிரேக்க, உரோமானிய ஆவணங்களில் பாண்டியர்களின் முத்துக்குளிக்கும் கொற்கைத் துறைமுகம் 'கொல்சி' (Colchi) எனக் குறிக்கப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Which Pandyan port is chronicled by classical Greco-Roman geographers like Ptolemy and the Periplus under the Hellenic name 'Colchi'?", "media_id": null}], "options": {"A": "Poompuhar", "B": "Korkai (Colchi)", "C": "Mamallapuram", "D": "Nagapattinam"}, "explanation": "Ptolemy and the Periplus record Korkai as 'Colchi', the epicenter of pearl fisheries."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 48, "chapter": null, "section": null, "reference": "11th Tamil, Uni