{"id": "12th_tamil_u3_q483", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "urimaithaagam", "chapter_id": null, "topic_id": "story_characters", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உரிமைத்தாகம்’ கதையில் நிலத்திற்காகப் போராடும் இரு உடன் பிறந்த சகோதரர்கள் யார் யார்?", "media_id": null}], "options": {"A": "மருதன், அல்லி", "B": "இராமன், பரதன்", "C": "முத்தையன் (அண்ணன்), வெள்ளைச்சாமி (தம்பி)", "D": "செழியன், பாரி"}, "explanation": "முத்தையன் அண்ணனாகவும், வெள்ளைச்சாமி தம்பியாகவும் உரிமைத்தாகம் கதையில் பாத்திரங்களாக உலா வருகின்றனர்."}, "en": {"blocks": [{"type": "text", "content": "Who are the two estranged brothers at the center of the conflict in the story 'Urimaithaagam'?", "media_id": null}], "options": {"A": "Marudhan and Alli", "B": "Rama and Bharata", "C": "Muthaiyan (elder brother) and Vellaisami (younger brother)", "D": "Chezhiyan and Paari"}, "explanation": "Muthaiyan (elder) and Vellaisami (younger) are the two brothers featured in the story."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 57, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 57",