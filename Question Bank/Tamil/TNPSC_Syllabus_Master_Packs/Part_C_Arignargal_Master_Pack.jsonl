{"id": "11th_tamil_u3_q095", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "definition_vaadivaasal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வாடிவாசல்’ என்பதன் சரியான பொருள் விளக்கம் யாது?", "media_id": null}], "options": {"A": "ஊரின் நுழைவாயில்", "B": "கோவில் கோபுர வாசல்", "C": "ஜல்லிக்கட்டுக் காளைகள் களத்திற்குள் சீறிப் பாய்ந்து வரும் குறுகிய தடுப்பு வழி/வாசல்", "D": "அரண்மனை வாயில்"}, "explanation": "ஜல்லிக்கட்டுப் பந்தயத்தில் காளைகளை ஒவ்வொன்றாக அவிழ்த்து விடும் குறுகிய மரப் பலகை அடைப்பு வாயிலுக்கு 'வாடிவாசல்' என்று பெயர்."}, "en": {"blocks": [{"type": "text", "content": "What is the precise architectural-functional definition of 'Vaadivaasal'?", "media_id": null}], "options": {"A": "Village gateway", "B": "Temple tower entrance", "C": "The narrow gated chute or barricaded portal through which spirited bulls surge out into the open arena", "D": "Palace gate"}, "explanation": "Vaadivaasal is the narrow gated chute through which bulls explode into the sporting arena."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5