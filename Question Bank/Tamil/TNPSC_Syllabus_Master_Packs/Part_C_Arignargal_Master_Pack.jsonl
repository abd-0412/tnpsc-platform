{"id": "10th-u9-q045", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "siddhaalu", "chapter_id": null, "topic_id": "poetic_tone", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"சித்தாளு\" கவிதையில் வெளிப்படும் முதன்மையான தொனி (Tone) எது?", "media_id": null}], "options": {"A": "அனுதாபமும் சமூக விழிப்புணர்வும் (இரக்க உணர்வு)", "B": "எள்ளல் மற்றும் நகைச்சுவை", "C": "வீர உணர்ச்சி", "D": "அச்ச உணர்வு"}, "explanation": "பாடநூல் விளக்கம்: உழைக்கும் பெண்ணின் நிலைகண்டு உள்ளம் உருகும் கருணையும், சமூக மாற்றத்திற்கான விழிப்புணர்வுத் தொனியும் மிளிர்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What predominant emotional tone resonates through the poem \"Siddhaalu\"?", "media_id": null}], "options": {"A": "Deep empathy, compassion, and social consciousness", "B": "Satire and humor", "C": "Martial anger", "D": "Fear and awe"}, "explanation": "Profound compassion and social awakening."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 202, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 202", "url": null, "source_notes": null}, "previous_year": {"is_previous_year