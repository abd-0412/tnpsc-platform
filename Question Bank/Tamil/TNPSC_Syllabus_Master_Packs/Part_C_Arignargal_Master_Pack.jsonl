{"id": "10th-u9-q013", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "jayakanthan", "chapter_id": null, "topic_id": "philosophy_marginalized_people", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜெயகாந்தன் தனது இலக்கியப் படைப்புகளில் யாருடைய வாழ்க்கையை முதன்மையாகப் படம்பிடித்துக் காட்டினார்?", "media_id": null}], "options": {"A": "சமுதாயத்தின் விளிம்புநிலை எளிய உழைக்கும் மக்கள்", "B": "அரண்மனை மன்னர்கள்", "C": "பெரும் பணக்காரர்கள்", "D": "புராணக் கதாபாத்திரங்கள்"}, "explanation": "பாடநூல் விளக்கம்: ரிக்ஷாக்காரர்கள், சுமைதூக்குவோர், தெருவோர மனிதர்கள் மற்றும் எளிய மக்களின் வலிகளையும் வாழ்க்கை உண்மைகளையும் துணிச்சலுடன் வெளிப்படுத்தினார்."}, "en": {"blocks": [{"type": "text", "content": "Whose lives formed the primary vibrant subject of Jayakanthan's realistic fiction?", "media_id": null}], "options": {"A": "Socially marginalized, underprivileged everyday working people", "B": "Royalty and kings", "C": "Wealthy aristocrats", "D": "Mythological characters"}, "explanation": "Marginalized and everyday working people in urban underbellies."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page":