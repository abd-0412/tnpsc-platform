{"id": "12th_tamil_u3_q484", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "urimaithaagam", "chapter_id": null, "topic_id": "story_conflict", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்தையனுக்கும் வெள்ளைச்சாமிக்கும் இடையே பகை ஏற்படுவதற்குக் காரணமாக அமைந்தது எது?", "media_id": null}], "options": {"A": "அரசியல் கருத்து வேறுபாடு", "B": "திருமணப் பேச்சுவார்த்தை முறிந்தது", "C": "நகரத்திற்குச் செல்ல நினைத்தது", "D": "பரம்பரை நிலத்தைப் பிரித்துக் கொள்வதில் ஏற்பட்ட வரப்புத் தகராறும் சொத்து உரிமைப் பங்கீடும்"}, "explanation": "தந்தை விட்டுச் சென்ற நிலத்தைப் பிரிப்பதில் வரப்பு எல்லை தொடர்பாக ஏற்பட்ட பிணக்கே சகோதரர்களுக்குள் பகையை மூட்டியது."}, "en": {"blocks": [{"type": "text", "content": "What ignited the bitter estrangement between Muthaiyan and Vellaisami?", "media_id": null}], "options": {"A": "Political ideological rivalry", "B": "A failed matrimonial alliance", "C": "Desire to migrate to cities", "D": "Dispute over field bund boundaries and division of ancestral agrarian land"}, "explanation": "A dispute over field bund boundaries and dividing ancestral land caused deep friction between the brothers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporat