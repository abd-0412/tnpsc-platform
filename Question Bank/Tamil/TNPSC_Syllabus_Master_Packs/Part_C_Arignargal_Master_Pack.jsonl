{"id": "6th-t1-u2-038", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிட்டுக்குருவியின் இயல்புகளை அவற்றின் அளவுகளோடு பொருத்துக:\nபட்டியல் I:\nஅ) இடும் முட்டைகளின் எண்ணிக்கை\nஆ) அடைகாக்கும் நாள்கள்\nஇ) குஞ்சு பொரிக்கும் நாள்\nஈ) சராசரி வாழ்நாள்\n\nபட்டியல் II:\n1. 14 நாள்கள்\n2. 3 முதல் 6 முட்டைகள்\n3. 10 முதல் 14 ஆண்டுகள்\n4. 15-ஆம் நாள்", "media_id": null}], "options": {"A": "1, 2, 3, 4", "B": "2, 1, 4, 3", "C": "2, 4, 1, 3", "D": "4, 1, 2, 3"}, "explanation": "அ) முட்டைகள் - 3 முதல் 6 (2)\nஆ) அடைகாப்பது - 14 நாள்கள் (1)\nஇ) குஞ்சு பொரிப்பது - 15-ஆம் நாள் (4)\nஈ) வாழ்நாள் - 10 முதல் 14 ஆண்டுகள் (3)\nசரியான வரிசை: 2, 1, 4, 3."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "6th Tamil, Term 1, Unit 2, Page 23, 24", "url