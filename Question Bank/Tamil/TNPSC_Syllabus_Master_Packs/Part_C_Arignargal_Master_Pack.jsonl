{"id": "12th_tamil_u2_q296", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "author_story_theme", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உத்தமசோழனின் பெரும்பாலான சிறுகதைகள் எவ்வகை மனிதர்களின் வாழ்வியலைப் பேசுகின்றன?", "media_id": null}], "options": {"A": "அரண்மனை மன்னர்கள்", "B": "வெளிநாட்டுப் பணக்காரர்கள்", "C": "விண்வெளி வீரர்கள்", "D": "தஞ்சை, திருவாரூர் டெல்டா பகுதியின் உழைக்கும் விளிம்புநிலை எளிய விவசாய மக்கள்"}, "explanation": "உத்தமசோழன் சோழநாட்டு டெல்டா பகுதியின் எளிய விவசாய மக்களின் பாடுகளையும் மண் மணக்கும் வாழ்வியலையும் எழுதுபவர்."}, "en": {"blocks": [{"type": "text", "content": "What stratum of society forms the central focus of most of Uthamasozhan's literary narratives?", "media_id": null}], "options": {"A": "Palace royalty", "B": "Affluent expatriate merchants", "C": "Astronauts and scientists", "D": "Toiling subaltern agrarian peasants and laborers of the Cauvery Delta region"}, "explanation": "Uthamasozhan authentically depicts the agrarian peasant life, struggles, and dialect of the Cauvery delta."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year"