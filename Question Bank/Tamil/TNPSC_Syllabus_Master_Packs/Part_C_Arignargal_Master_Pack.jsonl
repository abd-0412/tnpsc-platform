{"id": "9th-u7-q027", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "submarines-landing-states", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜப்பானிய நீர்மூழ்கிக் கப்பல் மூலம் INA ஒற்றர்கள் இந்தியாவின் எம்மாநிலக் கடற்கரைகளில் இறக்கிவிடப்பட்டனர்?", "media_id": null}], "options": {"A": "தமிழ்நாடு மற்றும் ஆந்திரா", "B": "ஒடிசா மற்றும் மேற்கு வங்கம்", "C": "கேரளா மற்றும் குஜராத்", "D": "கோவா மற்றும் கர்நாடகா"}, "explanation": "ஜப்பானிய நீர்மூழ்கிக் கப்பல்கள் மூலம் இந்திய தேசிய இராணுவ ஒற்றர்கள் கேரள மற்றும் குஜராத் கடற்கரைகளில் இறக்கிவிடப்பட்டனர்."}, "en": {"blocks": [{"type": "text", "content": "On the coastal shores of which two Indian provinces were INA secret agents disembarked from Japanese submarines?", "media_id": null}], "options": {"A": "Tamil Nadu and Andhra Pradesh", "B": "Odisha and West Bengal", "C": "Kerala and Gujarat (கேரளா மற்றும் குஜராத்)", "D": "Goa and Karnataka"}, "explanation": "Japanese submarines stealthily landed INA intelligence operatives on the strategic shorelines of Kerala and Gujarat."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edit