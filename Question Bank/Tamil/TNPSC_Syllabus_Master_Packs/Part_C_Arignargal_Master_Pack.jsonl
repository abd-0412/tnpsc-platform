{"id": "6th-t2-u1-095", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'உள்ளுவது எல்லாம் உயர்வுள்ளல் மற்றது தள்ளினும் தள்ளாமை நீர்த்து' - இக்குறள் தரும் கருத்துகளை ஆராய்க:\n1. எண்ணுவதெல்லாம் உயர்வாகவே எண்ண வேண்டும்.\n2. நாம் எண்ணிய உயர்ந்த எண்ணம் கைகூடாவிட்டாலும் அத்தகைய உயர்வான எண்ணமே மனநிறைவைத் தரும்.\n3. நாம் பிறரை ஏமாற்றி வாழ்வதே உயர்வான வாழ்வாகும்.\n4. மனிதனின் பெருமை அவன் கொள்ளும் உயர்ந்த குறிக்கோளிலேயே அடங்கியுள்ளது.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்றுகள் 1, 3 சரி; 2, 4 தவறு", "C": "கூற்றுகள் 1, 2, 4 சரி; 3 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "கூற்று 3 முற்றிலும் தவறானது. 1, 2, 4 ஆகிய கூற்றுகள் உள்ளுவதெல்லாம் உயர்வுள்ளல் குறளின் சரியான வாழ்வியல் விளக்கங்கள்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "எண்ணுவதெல்லாம் உயர்வாகவே எண்ண வேண்டும்.", "content_en": null}, {"id": "S2", "content_ta": "நாம் எண்ணிய உயர்ந்த எண்ணம் கைகூடாவிட்டாலும் அத்தகைய உயர்வான எண்ணமே மனநிறைவைத் தரும்.", "content_en": null}, {"id": "S3", "content_ta": "நாம் பிறரை ஏமாற்றி வாழ்வதே உயர்வான வாழ்வாகும்.", "content_en": null}, {"id": "S4", "content_ta": "மனிதனின் பெருமை அவன் கொள்ளும் உயர்ந்த குறிக்கோளிலேயே அடங்கியுள்ளது.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_an