{"id": "9th-u3-q041", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-01-eru-thazhuvuthal", "chapter_id": null, "topic_id": "topic-eru-thazhuvuthal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்நாட்டில் நடைபெறும் ஏறு தழுவுதலில் காளையை அடக்குபவர்கள் கடைப்பிடிக்க வேண்டிய மிக முதன்மையான பண்பாட்டு விதி எது?", "media_id": null}], "options": {"A": "எந்தவித ஆயுதத்தையும் பயன்படுத்தக் கூடாது", "B": "காளையின் வாலை மட்டுமே பிடிக்க வேண்டும்", "C": "குதிரையின் மீது அமர்ந்து அடக்க வேண்டும்", "D": "காளையைக் காயப்படுத்தினால் மட்டுமே வெற்றி"}, "explanation": "தமிழ்நாட்டில் நடைபெறும் ஏறு தழுவுதலில் காளையை அடக்குபவர்கள் எந்த ஆயுதத்தையும் பயன்படுத்தக் கூடாது. அன்பையும் வீரத்தையும் ஒருசேர வளர்த்தெடுப்பதே தமிழரின் மரபாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the foremost ethical rule incumbent upon bull tamers in Tamil Nadu?", "media_id": null}], "options": {"A": "No weapon of any kind must be used", "B": "Only the bull's tail must be held", "C": "Taming must be executed mounted on horseback", "D": "Victory is recognized only if the bull is injured"}, "explanation": "Participants are strictly forbidden from wielding any weapon; taming must be performed entirely barehanded by grasping the hump."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", 