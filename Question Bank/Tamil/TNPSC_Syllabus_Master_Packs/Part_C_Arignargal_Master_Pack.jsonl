{"id": "6th-t3-u1-086", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்றுகளை ஆராய்க:\nகூற்று 1: வேலுநாச்சியார் சிவகங்கைக் கோட்டையை மீட்பதற்கு 8 ஆண்டுகள் காத்திருந்து திட்டமிட்டார்.\nகூற்று 2: சிவகங்கைக் கோட்டையில் உள்ள இராஜராஜேஸ்வரி அம்மன் கோவிலில் விஜயதசமி திருவிழா சிறப்பாக நடைபெற்றது.", "media_id": null}], "options": {"A": "கூற்று 1 தவறு, கூற்று 2 சரி", "B": "கூற்று 1, கூற்று 2 ஆகிய இரண்டும் சரி", "C": "கூற்று 1 சரி, கூற்று 2 தவறு", "D": "இரண்டும் தவறு"}, "explanation": "திண்டுக்கல்லில் 8 ஆண்டுகள் திட்டமிட்டதும், விஜயதசமி நாளில் அம்மன் கோவில் விழா வழிபாட்டின் போது நுழைந்ததும் சரி."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "வேலுநாச்சியார் சிவகங்கைக் கோட்டையை மீட்பதற்கு 8 ஆண்டுகள் காத்திருந்து திட்டமிட்டார்.", "content_en": null}, {"id": "S2", "content_ta": "சிவகங்கைக் கோட்டையில் உள்ள இராஜராஜேஸ்வரி அம்மன் கோவிலில் விஜயதசமி திருவிழா சிறப்பாக நடைபெற்றது.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publis