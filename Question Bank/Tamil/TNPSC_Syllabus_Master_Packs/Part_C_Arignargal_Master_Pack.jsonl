{"id": "11th_tamil_u1_q046", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "kaalam_poetic_line", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘யுகத்தின் பாடல்’ கவிதையில் ‘காலத்தின் தொடக்கம் நீ’ என்று அழைக்கப்படுபவள் யார்?", "media_id": null}], "options": {"A": "சூரிய ஒளி", "B": "தமிழ் மொழி", "C": "நிலவு", "D": "வானம்"}, "explanation": "மனித நாகரிகத்தின் தோற்றத்தோடு உடன் பிறந்து காலத்தின் தொடக்கமாக விளங்குவது தாய்மொழியாகிய தமிழே ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "In the poem 'Yugathin Paadal', who is addressed as 'You are the beginning of time'?", "media_id": null}], "options": {"A": "Sunlight", "B": "Tamil Language", "C": "The Moon", "D": "The Sky"}, "explanation": "Mother Tamil is venerated as coeval with the very dawn of human historical time."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Poetry", "Poetic Lines"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q047", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "analysis_lines_root", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வேரறுக்க நினைத்தவர்களின் வாள்கள் / உன் வேரருகே மழுங்கிப் போயின’ - இவ்வடிகள் சுட்டுவது எதனை?", "media_id": null}], "options": {"A": "மன்னர்களின் வாட்போர் பயிற்சி", "B": "இரும்புத் தொழிலாளர்களின் உழைப்பு", "C": "தமிழை அழிக்க முற்பட்ட ஆதிக்க சக்திகளின் தோல்வி", "D": "மரங்களை வெட்டுவோரின் சோர்வு"}, "explanation": "வரலாற்றில் தமிழையும் அதன் பண்பாட்டையும் அழிக்க முயன்ற எத்தனையோ ஆதிக்க சக்திகள் தோற்றுப்போயின என்பதை இது உருவகப்படுத்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What historical reality is signified by 'The swords of those who sought to uproot you grew blunt beside your root'?", "media_id": null}], "options": {"A": "Swordsmanship drill of soldiers", "B": "Labor of iron smiths", "C": "The inevitable defeat of oppressive forces that plotted the erasure of Tamil", "D": "Tiredness of woodcutters"}, "explanation": "It allegorizes the historical resilience of Tamil outliving imperial oppressors who sought to destroy it."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Poetry", "Literary Analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q049", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_yugathin_paadal", "chapter_id": null, "topic_id": "eelam_writers_contemporary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சு. வில்வரத்தினத்தோடு சமகாலத்தில் இயங்கிய மற்றொரு தலைசிறந்த ஈழத்து நவீனக் கவிஞர் யார்?", "media_id": null}], "options": {"A": "சேரன் (Cheran)", "B": "கண்ணதாசன்", "C": "வாலி", "D": "வைரமுத்து"}, "explanation": "சேரன், வ. ஐ. ச. ஜெயபாலன், சு. வில்வரத்தினம் ஆகியோர் ஈழத்துப் போர்க்கால நவீனக் கவிதைக் களத்தின் முன்னோடிச் சிற்பிகள்."}, "en": {"blocks": [{"type": "text", "content": "Who among the following was a renowned contemporary Eelam modern poet alongside Su. Vilvarathinam?", "media_id": null}], "options": {"A": "Cheran", "B": "Kannadasan", "C": "Vaali", "D": "Vairamuthu"}, "explanation": "Poet Cheran along with Vilvarathinam shaped the vibrant modern anti-war poetic movement of Eelam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 5", "url": null, "source_notes": null}, "previous_year": {"is_previous_ye