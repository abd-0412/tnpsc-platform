{"id": "12th_tamil_u1_q182", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tnpsc_pyq_integration", "chapter_id": null, "topic_id": "nellaiyappar_published_works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பரலி சு. நெல்லையப்பர் பாரதியாரின் எந்த நூல்களை முதன்முதலில் அச்சிட்டுப் பதிப்பித்தார்?", "media_id": null}], "options": {"A": "பாஞ்சாலி சபதம்", "B": "கண்ணன் பாட்டு, நாட்டுப்பாட்டு, பாப்பா பாட்டு, முரசு", "C": "குயில் பாட்டு மட்டும்", "D": "ஞானரதம்"}, "explanation": "பரலி சு. நெல்லையப்பர் பாரதியின் ‘கண்ணன் பாட்டு, நாட்டுப்பாட்டு, பாப்பா பாட்டு, முரசு’ போன்ற நூல்களைத் தம் சொந்தப் பொறுப்பில் அச்சிட்டுப் பதிப்பித்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which poetic masterpieces of Bharathiyar were published first by Parali S. Nellaiyappar?", "media_id": null}], "options": {"A": "Panchali Sabatham", "B": "Kannan Paattu, Naattu Paattu, Paappa Paattu, and Murasu", "C": "Kuyil Paattu alone", "D": "Gnanaratham"}, "explanation": "Nellaiyappar printed and brought out Kannan Paattu, Naattu Paattu, Paappa Paattu, and Murasu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page"