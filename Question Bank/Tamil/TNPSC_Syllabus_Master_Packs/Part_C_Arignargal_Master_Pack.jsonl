{"id": "12th_tamil_mp1_q1761", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_7", "chapter_id": null, "topic_id": "tnpsc_pyq_bharathi_brother_journal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC Group 2A 2018] பாரதியார் பரலி சு. நெல்லையப்பரைத் தம்பியாக ஏற்று மடல் எழுதிய ஆண்டு எது?", "media_id": null}], "options": {"A": "\"1915 (ஜூலை 19)", "B": "\"1920", "C": "\"1910", "D": "\"1905"}, "explanation": "பாரதியார் புதுச்சேரியிலிருந்து 1915-ஆம் ஆண்டு ஜூலை 19 அன்று நெல்லையப்பருக்கு வரலாற்றுப் புகழ்பெற்ற மடல் எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Group 2A 2018] In which year did Mahakavi Bharathi pen his celebrated fraternal letter to Parali Su. Nellaiyappar?", "media_id": null}], "options": {"A": "\"1915 (July 19)", "B": "\"1920", "C": "\"1910", "D": "\"1905"}, "explanation": "Bharathi wrote this historic epistle on July 19, 1915, from Puducherry."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 13, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_1, Page 13", "url": null, "source_notes": null}, "previous_