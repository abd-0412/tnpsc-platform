{"id": "12th_tamil_u6_q992", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "thiraimozhi", "chapter_id": null, "topic_id": "long_shot_purpose", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கதை நிகழும் நிலப்பரப்பு, ஊர் அல்லது பிரம்மாண்டமான போர்க்களச் சூழலைப் பார்வையாளர்களுக்கு அறிமுகப்படுத்தப் பயன்படும் காட்சி எது?", "media_id": null}], "options": {"A": "அண்மைக் காட்சி (Close-up)", "B": "மிக அண்மைக் காட்சி (Extreme close-up)", "C": "தாழ் கோணம் மட்டும்", "D": "சேய்மைக் காட்சி / தொலைக் காட்சி (Long shot / Establishing shot)"}, "explanation": "கதைக்களம் அமைந்துள்ள பிரம்மாண்ட சூழலையும் இயற்கை பின்னணியையும் முழுமையாகக் காட்ட 'சேய்மைக் காட்சி' (Long shot) பயன்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which photographic shot establishes the grand spatial geographic context, landscape expanse, or battle panorama?", "media_id": null}], "options": {"A": "Close-up shot", "B": "Extreme close-up", "C": "Low-angle shot only", "D": "Long shot / Establishing shot (Seimaik Kaatchi)"}, "explanation": "A Long shot or Establishing shot showcases broad geographical setting, vast landscapes, and scale."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "clas