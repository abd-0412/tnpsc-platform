{"id": "11th_tamil_u1_q131", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "supplementary_aaraam_thinai", "chapter_id": null, "topic_id": "toronto_life", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கனடாவின் டொராண்டோ நகரில் தமிழர்கள் அமைத்துள்ள பண்பாட்டு அமைப்புகள் மற்றும் தமிழ்ப் பள்ளிகள் எதனை உணர்த்துகின்றன?", "media_id": null}], "options": {"A": "அரசியல் பதவிகளை அடைவதை மட்டுமே", "B": "பணக்காரர்களாக வாழ்வதை மட்டுமே", "C": "எங்கு வாழ்ந்தாலும் புதிய தலைமுறைக்குத் தமிழ் மொழியையும் பண்பாட்டையும் கடத்தும் கடமை உணர்வை", "D": "கனடியப் பண்பாட்டை நிராகரிப்பதை"}, "explanation": "புலம் பெயர்ந்து பல தலைமுறைகள் கடந்தாலும் தமிழ்க் குழந்தைகளிடம் தாய்மொழியை நிலைநிறுத்த வார இறுதி தமிழ்ப் பள்ளிகளை நடத்துகின்றனர்."}, "en": {"blocks": [{"type": "text", "content": "What does the vibrant network of weekend Tamil schools established by Tamils in Toronto embody?", "media_id": null}], "options": {"A": "Merely capturing municipal posts", "B": "Exhibiting material wealth", "C": "The sacred intergenerational duty of transmitting Tamil language and cultural roots to young diasporic generations", "D": "Hostile rejection of Canadian multiculturalism"}, "explanation": "It reflects the fierce commitment to transmitting their mother tongue to children growing up in the Arctic diaspora."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 11, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 11", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Supplementary", "Cultural Continuity"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
