{"id": "12th_tamil_u7_q1211", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "theyilai_thotta_paattu", "chapter_id": null, "topic_id": "hardships_leech_cold", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலங்கைத் தேயிலைத் தோட்டங்களில் தொழிலாளர்கள் எதிர்கொண்ட சொல்லொணாத் துயரங்களாகப் பாடலில் விவரிக்கப்படுபவை எவை?", "media_id": null}], "options": {"A": "அதிக வெயில்", "B": "வெள்ளப்பெருக்கு", "C": "கடும் பனிக்குளிர், அட்டைக் கடி (அட்டைப்பூச்சி இரத்தம் குடித்தல்), பட்டினி மற்றும் கங்காணிகளின் சாட்டையடி", "D": "காட்டுத்தீ"}, "explanation": "விடியற்காலையிலேயே பனிமலையில் தேயிலை பறிக்க வேண்டும்; கால்களில் அட்டைப்பூச்சிகள் கடித்து இரத்தம் உறிஞ்சும்; உணவின்றிப் பட்டினியும் கங்காணிகளின் அடக்குமுறையும் நிலவியது."}, "en": {"blocks": [{"type": "text", "content": "What excruciating physical hardships plagued Tamil tea estate indentured laborers in Ceylon?", "media_id": null}], "options": {"A": "Heatstroke waves", "B": "Flash floods", "C": "Freezing montane cold, blood-sucking leeches, chronic starvation, and brutal lashings by supervisors", "D": "Wildfires"}, "explanation": "Indentured workers suffered freezing montane mist, leeches draining their blood, starvation, and physical beatings."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi"