{"id": "8th-u6-q752", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u6-naadu", "lesson_id": "8th-u6-l2", "chapter_id": null, "topic_id": "mgr-titles-odd", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எம்.ஜி.ஆருக்கு மக்கள் வழங்கிய சிறப்புப் பெயர்களுள் பொருந்தாத ஒன்றைத் தேர்ந்தெடுக்க:"}], "options": {"A": "புரட்சி நடிகர்", "B": "மக்கள் திலகம்", "C": "பொன்மனச் செம்மல்", "D": "சிலம்புச் செல்வர்"}, "explanation": "புரட்சி நடிகர், மக்கள் திலகம், பொன்மனச் செம்மல், புரட்சித்தலைவர் என்பன எம்.ஜி.ஆரின் சிறப்புப் பெயர்கள் ஆகும். 'சிலம்புச் செல்வர்' என்பது சிலப்பதிகார மாநாடுகளை நடத்திய ம.பொ. சிவஞானத்திற்குரிய (ம.பொ.சி) சிறப்புப் பெயராகும். எனவே இது பொருந்தாதது."}, "en": {"blocks": [{"type": "text", "content": "Identify the title that was NOT bestowed upon M.G.R. by the people:"}], "options": {"A": "Puratchi Nadigar", "B": "Makkal Thilagam", "C": "Ponmana Chemmal", "D": "Silambu Chelvar"}, "explanation": "Puratchi Nadigar, Makkal Thilagam, and Ponmana Chemmal belong to M.G.R. 'Silambu Chelvar' is the title of Ma. Po. Sivagnanam (Ma.Po.Si). Thus D is the odd one."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 118, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "odd-one-out", "mgr", "titles"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q753", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u6-naadu", "lesson_id": "8th-u6-l2", "chapter_id": null, "topic_id": "textbook-eval-q1-mgr-schooling", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூல் மதிப்பீட்டு வினா: \"எம்.ஜி.ஆர் __________ என்னும் ஊரில் கல்வி பயின்றார்.\""}], "options": {"A": "கும்பகோணம்", "B": "கண்டி", "C": "சென்னை", "D": "மதுரை"}, "explanation": "பாடநூல் மதிப்பீடு (பக். 121 சரியான விடை 1): எம்.ஜி.ஆர் 'கும்பகோணம்' என்னும் ஊரில் உள்ள ஆணையடிப் பள்ளியில் கல்வி பயின்றார். (கண்டி என்பது அவர் பிறந்த ஊர் ஆகும்)."}, "en": {"blocks": [{"type": "text", "content": "Textbook Evaluation Question: \"M.G.R. pursued his early schooling in the town of __________.\""}], "options": {"A": "Kumbakonam", "B": "Kandy", "C": "Chennai", "D": "Madurai"}, "explanation": "Textbook Evaluation (Page 121, Q1): M.G.R. pursued his schooling in Kumbakonam at the Aanaiyadi School. (Kandy was his birthplace)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 121, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "quote-completion", "mgr", "textbook-eval", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
