{"id": "6th-t1-u2-046", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கிழவனும் கடலும்' கதையின் பாத்திரங்களையும் எண்களையும் பொருத்துக:\nபட்டியல் I:\nஅ) சாண்டியாகோ\nஆ) மனோலின்\nஇ) மீனின்றி சென்ற நாள்கள்\nஈ) நோபல் பரிசு பெற்ற ஆண்டு\n\nபட்டியல் II:\n1. முதல் 40 நாள்கள் உடன் சென்ற சிறுவன்\n2. வயது முதிர்ந்த மீனவர்\n3. 1954\n4. 84 நாள்கள்", "media_id": null}], "options": {"A": "1, 2, 3, 4", "B": "2, 1, 4, 3", "C": "2, 4, 1, 3", "D": "4, 1, 2, 3"}, "explanation": "அ) சாண்டியாகோ - முதிர்ந்த மீனவர் (2)\nஆ) மனோலின் - 40 நாள் சென்ற சிறுவன் (1)\nஇ) மீனின்றி சென்ற நாள்கள் - 84 நாள்கள் (4)\nஈ) நோபல் பரிசு ஆண்டு - 1954 (3)\nசரியான வரிசை: 2, 1, 4, 3."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "6th Tamil, Term 1, Unit 2, Page 27, 