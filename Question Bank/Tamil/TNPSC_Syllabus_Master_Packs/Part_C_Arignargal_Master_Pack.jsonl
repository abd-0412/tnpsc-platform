{"id": "9th-u3-q078", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-02-manimekalai", "chapter_id": null, "topic_id": "topic-manimekalai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சீத்தலைச் சாத்தனார் பிறந்த ஊர் மற்றும் வாழ்ந்த ஊர் முறையே எவை?", "media_id": null}], "options": {"A": "மதுரை, திருச்சி", "B": "சீத்தலை (திருச்சி), மதுரை", "C": "பூம்புகார், காஞ்சிபுரம்", "D": "தஞ்சாவூர், மதுரை"}, "explanation": "இவர் திருச்சிராப்பள்ளியைச் சேர்ந்த 'சீத்தலை' என்னும் ஊரில் பிறந்து, பாண்டி நாட்டின் தலைநகரான 'மதுரையில்' வாழ்ந்தவர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Where was Seethalai Saathanaar born and where did he reside respectively?", "media_id": null}], "options": {"A": "Madurai, Tiruchirappalli", "B": "Seethalai (near Tiruchirappalli), and Madurai", "C": "Poompuhar, Kanchipuram", "D": "Thanjavur, Madurai"}, "explanation": "Saathanaar was born in Seethalai village near Tiruchirappalli and lived his adult professional life in Madurai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 56, "chapter": null, "section": null, "reference": "9th Tamil, Uni