{"id": "10th-u4-q023", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "seyarkai_nunnarivu", "chapter_id": null, "topic_id": "edwin_hubble", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "1924-இல் \"நம் பால்வீதி போன்று பல விண்மீன் திரள்கள் விண்வெளியில் உள்ளன; அண்டம் தொடர்ந்து விரிவடைந்து கொண்டே செல்கிறது\" என்று மெய்ப்பித்த அமெரிக்க வானியலாளர் யார்?", "media_id": null}], "options": {"A": "கலீலியோ", "B": "நியூட்டன்", "C": "எட்வின் ஹப்பிள் (Edwin Hubble)", "D": "கோபர்நிகஸ்"}, "explanation": "அமெரிக்க வானியலாளர் எட்வின் ஹப்பிள் 1924-இல் பேரண்டம் தொடர்ந்து விரிவடைகிறது என்று அறிவியல் பூர்வமாக நிறுவினார்."}, "en": {"blocks": [{"type": "text", "content": "Which American astronomer demonstrated in 1924 that our Milky Way is but one of countless galaxies and that the universe is constantly expanding?", "media_id": null}], "options": {"A": "Galileo Galilei", "B": "Isaac Newton", "C": "Edwin Hubble", "D": "Nicolaus Copernicus"}, "explanation": "Edwin Hubble proved in 1924 that galaxies exist beyond the Milky Way and that the universe expands."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 76