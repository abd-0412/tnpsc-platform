{"id": "11th_tamil_u2_q005", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "prose_iyarkai_velanmai", "chapter_id": null, "topic_id": "earthworm_friend", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உழவனின் நண்பன்’ என்று போற்றப்படும் உயிரினம் எது?", "media_id": null}], "options": {"A": "மண்புழு", "B": "வெட்டுக்கிளி", "C": "எலி", "D": "நத்தை"}, "explanation": "மண்ணைத் தின்று செரித்து உரமாக மாற்றுவதாலும், மண்ணைத் துளையிட்டு காற்றோட்டம் தருவதாலும் மண்புழு ‘உழவனின் நண்பன்’ எனப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which living creature is universally revered as the 'Farmer's Best Friend' in agroecology?", "media_id": null}], "options": {"A": "Earthworm (Manpuzhu)", "B": "Locust", "C": "Rat", "D": "Snail"}, "explanation": "The earthworm aerates the soil and produces nutrient-rich vermicompost, making it the farmer's indispensable ally."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 25, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 25", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_nam