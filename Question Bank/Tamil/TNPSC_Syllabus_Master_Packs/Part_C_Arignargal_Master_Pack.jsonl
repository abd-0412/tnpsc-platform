{"id": "11th_tamil_u7_q106", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "puratchikkavi_meter_sound", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கொலைக்களக் காட்சியில் பாரதிதாசன் கையாண்டுள்ள சந்த நடையின் உணர்ச்சி எத்தகையது?", "media_id": null}], "options": {"A": "தாலாட்டுப் பாடும் அமைதியான நடை", "B": "போர்க்கள முரசு முழங்குவது போன்ற வேகமும் அனலும் தெறிக்கும் வீர உணர்ச்சி நடை", "C": "அழுகை நடை", "D": "சந்தேக நடை"}, "explanation": "பாவேந்தரின் சந்த நடை போர்க்கள முரசொலி போலவும், எரிமலை வெடிப்பது போலவும் வேகமும் வீர உணர்ச்சியும் ததும்பும் வண்ணம் அமைந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "What emotional cadence does Bharathidasan's rhythmic meter evoke in the scaffold scene?", "media_id": null}], "options": {"A": "Lullaby tranquility", "B": "Roaring cadence resonant like battle drums and volcanic upheaval charged with heroic passion", "C": "Lamentation", "D": "Hesitant cadence"}, "explanation": "The tempo echoes the thunderous percussive fury of war drums."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 1