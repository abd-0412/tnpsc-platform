{"id": "11th_tamil_u8_q003", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "prose_tagore_letters", "chapter_id": null, "topic_id": "shantiniketan_philosophy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாகூர் தோற்றுவித்த 'சாந்திநிகேதன்' மற்றும் 'விஸ்வபாரதி' கல்வி நிறுவனங்களின் மையக் கல்விக் கோட்பாடாக விளங்கியது எது?", "media_id": null}], "options": {"A": "சுவர் சூழ்ந்த வகுப்பறை மனப்பாடக் கல்வி", "B": "அரசுப் பணிக்கான ஆங்கில வழிப் பயிற்சி முறை மட்டுமே", "C": "இயற்கையோடு இயைந்த திறந்தவெளிக் கல்வி மற்றும் உலகளாவிய மனிதநேயக் கலை வளர்ச்சி", "D": "தொழிற்கல்வி மட்டுமே"}, "explanation": "சுவர்கள் இல்லாத மரத்தடி நிழலில், இயற்கையோடு ஒன்றிணைந்து கற்பதும், அனைத்து நாட்டுப் பண்பாடுகளையும் மதிக்கும் உலகளாவிய மனிதநேயமுமே தாகூரின் சாந்திநிகேதன் கோட்பாடாகும்."}, "en": {"blocks": [{"type": "text", "content": "What was the foundational educational philosophy underpinning Tagore's 'Shantiniketan' and 'Visva-Bharati'?", "media_id": null}], "options": {"A": "Enclosed classroom rote memorization", "B": "Exclusive English instruction geared toward colonial administration", "C": "Open-air learning harmonized with pristine nature fostering universal humanist aesthetics", "D": "Exclusively vocational training"}, "explanation": "Tagore championed communion with nature and broad humanist education over artificial institutional boundaries."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": fa