{"id": "12th_tamil_u8_q1382", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "mayilai_seeni_venkatasamy", "chapter_id": null, "topic_id": "thulasi_singaram", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மயிலை சீனி. வேங்கடசாமியிடம் வரலாற்று ஆய்வுக் கண்ணோட்டத்தையும் தமிழ் ஆர்வத்தையும் தூண்டிய அவரது பள்ளி ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "கா. நமச்சிவாய முதலியார்", "B": "துளசிங்க பெருமாள்", "C": "மறைமலையடிகள்", "D": "உ.வே. சாமிநாதையர்"}, "explanation": "மயிலாப்பூரில் பயின்ற காலத்தில் அவருக்குத் தமிழ் கற்பித்த ஆசிரியர் துளசிங்க பெருமாள் அவரிடம் தமிழ் ஆய்வு ஆர்வத்தை விதைத்தார்."}, "en": {"blocks": [{"type": "text", "content": "Who was the schoolteacher that ignited historical inquiry and love for Tamil in Mayilai Seeni. Venkatasamy?", "media_id": null}], "options": {"A": "K. Namachivaya Mudaliar", "B": "Thulasinga Perumal", "C": "Maraimalai Adigal", "D": "U.V. Swaminatha Iyer"}, "explanation": "His teacher Thulasinga Perumal in Mylapore inspired his scholarly journey into Tamil antiquity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 193, "chapter": null, "section": 