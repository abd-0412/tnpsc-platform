{"id": "10th-u8-q037", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "gnanam", "chapter_id": null, "topic_id": "kodaivayal_title_symbolism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி. சோ. வேணுகோபாலனின் கவிதைத் தொகுப்பான \"கோடைவயல்\" என்ற தலைப்பு உணர்த்தும் அழகியல் நயம் என்ன?", "media_id": null}], "options": {"A": "கடும் கோடையிலும் பசுமை தாகத்தோடு விளையும் கவிதை வயல்", "B": "பாலை நிலம்", "C": "மழைக்காலம் மட்டுமே", "D": "விவசாயக் கடன்"}, "explanation": "வறண்ட கோடைக்காலத்திலும் பசுமையான கவிதைப் பயிர்களை விளைவிக்கும் உள்ளத்தின் படைப்பாற்றலை இத்தலைப்பு உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What aesthetic resonance is evoked by the title of his poetry anthology \"Kodaivayal\" (Summer Field)?", "media_id": null}], "options": {"A": "A creative fertile field yielding green verses even amidst the parched heat of summer", "B": "Barren desert", "C": "Monsoon flood solely", "D": "Farm debt"}, "explanation": "It symbolizes creative fertility flourishing even amidst scorching adversity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 181, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 181", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["ஞானம்", "கோடைவயல் தலைப்பு நயம்", "படைப்பாற்றல்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
