{"id": "11th_tamil_u2_q023", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "prose_iyarkai_velanmai", "chapter_id": null, "topic_id": "indigenous_seed_conservation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நம்மாழ்வாரின் வழிகாட்டுதலில் தமிழ்நாட்டில் பல்லாயிரக்கணக்கான பாரம்பரிய நெல் ரகங்களை மீட்டெடுத்துப் பாதுகாத்த ‘நெல் நாயகன்’ யார்?", "media_id": null}], "options": {"A": "சுவாமிநாதன்", "B": "ஃபுகோகா", "C": "நெல் ஜெயராமன்", "D": "இந்திரன்"}, "explanation": "நம்மாழ்வாரின் மாணவரான திருத்துறைப்பூண்டி நெல் ஜெயராமன் 170-க்கும் மேற்பட்ட பாரம்பரிய நெல் ரகங்களை மீட்டெடுத்து திருவிழாக்கள் மூலம் பரப்பினார்."}, "en": {"blocks": [{"type": "text", "content": "Who was the dedicated disciple of Nammazhvar who resurrected over 170 traditional paddy varieties across Tamil Nadu?", "media_id": null}], "options": {"A": "Swaminathan", "B": "Fukuoka", "C": "Nel Jayaraman", "D": "Indiran"}, "explanation": "'Nel' Jayaraman conserved and distributed over 170 native paddy seed varieties through annual festivals."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 26, "chapter": null, "section": null, "ref