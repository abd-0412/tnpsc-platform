{"id": "12th_tamil_u2_q236", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "piragoru_naal_kodai", "chapter_id": null, "topic_id": "metaphor_summer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிதையில் ‘திடீரெனப் புகுந்து கொண்ட கோடை’ எதன் வருகையைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "இரவின் வருகையை", "B": "பனிக்காலத்தின் தொடக்கத்தை", "C": "மழை மேகங்களின் வருகையை", "D": "சூரியனின் கடுமையான வெயில் மற்றும் வாழ்வின் அடுத்த பருவ மாற்றம்"}, "explanation": "மழை நின்றவுடன் திடீரென வந்து தாக்கும் சுட்டெரிக்கும் வெயிலையும் வாழ்வின் இயங்கு நிலையையும் இது உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What does the sudden intrusion of 'summer' signify in the poem?", "media_id": null}], "options": {"A": "Onset of nocturnal darkness", "B": "Beginning of chilly winter frost", "C": "Arrival of dark rain clouds", "D": "Intense blaze of the sun and cyclical change of life's seasons"}, "explanation": "It symbolizes the sudden, blinding arrival of harsh summer sunshine, illustrating the rapid flux in nature and human experience."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025