{"id": "9th-u7-q050", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u7", "lesson_id": "9th-tamil-u7-l1", "chapter_id": null, "topic_id": "ina-malaya-rubber-workers", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மலேயா இரப்பர் தோட்டங்களில் கூலித் தொழிலாளர்களாக வாழ்ந்த எளிய தமிழர்களை INA-வில் இணையத் தூண்டிய உந்துசக்தி எது?", "media_id": null}], "options": {"A": "பண ஆதாயம்", "B": "தாய்நாட்டின் மீதான தணியாத விடுதலைப் பற்றும் நேதாஜியின் காந்தக் கவர்ச்சிமிக்க தலைமையுரையும்", "C": "அரசு வேலை வாய்ப்பு", "D": "நில உரிமை ஆசை"}, "explanation": "நேதாஜியின் விடுதலை முழக்கங்களும், தாய்நாடு ஆங்கிலேய ஆதிக்கத்திலிருந்து விடுதலை பெற வேண்டும் என்ற தணியாத நாட்டுப்பற்றுமே அவர்களை இராணுவத்தில் இணைத்தது."}, "en": {"blocks": [{"type": "text", "content": "What driving conviction motivated impoverished Tamil rubber plantation laborers in Malaya to enlist in the INA?", "media_id": null}], "options": {"A": "Financial mercenary gains", "B": "Unquenchable patriotic fervor for motherland's liberation and Netaji's magnetic leadership", "C": "Government employment promises", "D": "Desire for land ownership"}, "explanation": "Netaji's patriotic speeches awakened the dormant nationalist pride of Tamil laborers, inspiring them to sacrifice all."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu