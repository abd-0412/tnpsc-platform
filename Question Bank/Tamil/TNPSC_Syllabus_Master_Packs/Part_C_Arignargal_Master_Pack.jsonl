{"id": "9th-u8-q001", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-titles", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெண்தாடி வேந்தர், பகுத்தறிவுப் பகலவன், வைக்கம் வீரர், ஈரோட்டுச் சிங்கம் என்றெல்லாம் போற்றப்படுபவர் யார்?", "media_id": null}], "options": {"A": "தந்தை பெரியார்", "B": "அறிஞர் அண்ணா", "C": "காமராசர்", "D": "முத்துராமலிங்கத் தேவர்"}, "explanation": "வெண்தாடி வேந்தர், பகுத்தறிவுப் பகலவன், வைக்கம் வீரர், ஈரோட்டுச் சிங்கம் எனப் பல்வேறு சிறப்புப் பெயர்களால் போற்றப்படுபவர் தந்தை பெரியார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who is venerated by the epithets 'Venthadi Vendhar', 'Pagutharivu Pagalavan', 'Vaikom Veerar', and 'Eroattu Singam'?", "media_id": null}], "options": {"A": "Thanthai Periyar (தந்தை பெரியார்)", "B": "Arignar Anna", "C": "Kamarajar", "D": "Muthuramalingathevar"}, "explanation": "Thanthai Periyar (E.V. Ramasamy) is affectionately honored by these celebrated titles for his transformative social crusade."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 154, "chapter": null, "sectio