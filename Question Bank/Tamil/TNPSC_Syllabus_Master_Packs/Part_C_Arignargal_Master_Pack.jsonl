{"id": "12th_tamil_u3_q576", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "tnpsc_pyq_u3", "chapter_id": null, "topic_id": "jatayu_dasaratha_friendship", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கம்பராமாயணத்தில் கழுகு வேந்தன் சடாயு தசரத மன்னனுக்கு எத்தகைய உறவுடையவராக விளங்கினார்?", "media_id": null}], "options": {"A": "பகைவர்", "B": "அடிமை", "C": "அரண்மனை மருத்துவர்", "D": "உயிர் போன்ற ஆருயிர் நண்பர்"}, "explanation": "சடாயு தசரத மன்னனின் உற்ற தோழனாகத் திகழ்ந்தவர்; அதனாலேயே இராமன் சடாயுவைத் தன் தந்தை ஸ்தானத்தில் வைத்து ஈமக்கடன் செய்தான்."}, "en": {"blocks": [{"type": "text", "content": "What was the relationship between Emperor Dasaratha and the vulture king Jatayu in Kambaramayanam?", "media_id": null}], "options": {"A": "Hostile adversaries", "B": "Bonded vassals", "C": "Royal physicians", "D": "Cherished, bosom friends"}, "explanation": "Jatayu and Dasaratha were beloved lifetime companions, prompting Rama to treat Jatayu as his own father."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 55, "chapter": null, "section": null, "reference": "12th Tamil, Unit 3, Page 55", "ur