{"id": "10th-u6-q117", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "paaichal", "chapter_id": null, "topic_id": "story_characters", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"பாய்ச்சல்\" கதையில் தெருவில் அனுமன் வேடமிட்டு ஆடிய கலைஞனின் ஆட்டத்தால் ஈர்க்கப்பட்டு, தானும் துள்ளி ஆடிய சிறுவனின் பெயர் என்ன?", "media_id": null}], "options": {"A": "அழகு", "B": "கண்ணன்", "C": "மணி", "D": "முருகன்"}, "explanation": "கதையின் நாயகனாக வரும் சிறுவனின் பெயர் \"அழகு\" ஆகும். அவன் அனுமன் ஆட்டத்தைக் கண்டு தன்னையும் அறியாமல் கலை உணர்வில் பாய்ந்து ஆடுகிறான்."}, "en": {"blocks": [{"type": "text", "content": "What is the name of the spirited young village boy in \"Paaichal\" captivated by the Hanuman folk dancer?", "media_id": null}], "options": {"A": "Azhagu", "B": "Kannan", "C": "Mani", "D": "Murugan"}, "explanation": "Young Azhagu is swept into rhythmic ecstatic dancing by the Hanuman masquerader."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": "10th Tamil, Unit 6, Page 138", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["பாய்ச்சல்", "அழகு", "கதாபாத்திரம்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u6-q118", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "paaichal", "chapter_id": null, "topic_id": "saayavanam_novel_fame", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சா. கந்தசாமியின் முதல் புதினமான \"சாயாவனம்\" எந்த இலக்கிய இதழில் வெளிவந்து அவரைத் தமிழ் இலக்கிய உலகில் புகழின் உச்சிக்குக் கொண்டு சென்றது?", "media_id": null}], "options": {"A": "மணிக்கொடி", "B": "எழுத்து", "C": "கணையாழி", "D": "தீபம்"}, "explanation": "சி. சு. செல்லப்பாவின் \"எழுத்து\" இதழில் சா. கந்தசாமியின் \"சாயாவனம்\" புதினம் தொடராக வெளிவந்து பெரும் புகழ்பெற்றது; இது நேஷனல் புக் டிரஸ்ட் மூலம் மொழிபெயர்க்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "In which influential literary journal was Sa. Kandasamy's landmark debut novel \"Saayaavanam\" serialized?", "media_id": null}], "options": {"A": "Manikkodi", "B": "Ezhuthu", "C": "Kanaiyaazhi", "D": "Deepam"}, "explanation": "Saayaavanam was published in Ci. Su. Chellappa's pathbreaking magazine \"Ezhuthu\"."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 140, "chapter": null, "section": null, "reference": "10th Tamil, Unit 6, Page 14