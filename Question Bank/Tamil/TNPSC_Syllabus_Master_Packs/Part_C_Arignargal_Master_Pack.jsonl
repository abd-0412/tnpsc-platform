{"id": "11th_tamil_u1_q028", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "prose_speech_and_poem", "chapter_id": null, "topic_id": "written_language_distance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘எழுத்து மொழிக்கும் வாசகனுக்கும் இடையே உள்ள இடைவெளி எதனால் ஏற்படுகிறது?’ என்று பாடப்பகுதி விளக்குகிறது?", "media_id": null}], "options": {"A": "எழுத்து மொழி எளிய மக்களால் படிக்க முடியாததால் மட்டுமே", "B": "காகிதத்தின் தரம் குறைவாக இருப்பதால்", "C": "அச்சுப் பிழைகள் அதிகமாக இருப்பதால்", "D": "எழுத்து மொழி பேசும் மனித உடலின் நேரடி வெப்பத்தையும் குரல் ஏற்றத்தாழ்வுகளையும் இழந்துவிடுவதால்"}, "explanation": "பேசும் மனிதனின் முகபாவம், கண் அசைவு, குரலின் தணிவு போன்ற உடல்சார்ந்த உணர்ச்சிகளை அச்சு எழுத்துகள் நேரடியாகத் தராததால் வாசகனுக்கும் அதற்குமான இடைவெளி ஏற்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Why does an aesthetic distance exist between written language and the reader compared to live speech?", "media_id": null}], "options": {"A": "Because commoners can never read texts", "B": "Due to poor paper quality", "C": "Due to frequent typesetting typographical errors", "D": "Because written print loses the immediate bodily warmth, facial cues, and vocal modulations of the living speaker"}, "explanation": "The printed text strips away the somatic cues and spontaneous vocal inflections inherent in living vocal utterance."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Prose", "Concepts"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

