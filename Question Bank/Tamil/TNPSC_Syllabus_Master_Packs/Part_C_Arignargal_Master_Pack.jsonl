{"id": "10th-u5-q055", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "manavai_mustafa_service", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மணவை முஸ்தபா அவர்கள் தமிழில் அறிவியல் மற்றும் மருத்துவ நூல்களை மொழிபெயர்ப்பதில் ஆற்றிய முதன்மையான பங்களிப்பு யாது?", "media_id": null}], "options": {"A": "சமையல் நூல்கள் எழுதுதல்", "B": "கிரேக்கக் கதைகளை நாடகமாக்குதல்", "C": "அறிவியல் மற்றும் மருத்துவக் கலைச்சொல் களஞ்சியங்களை உருவாக்கித் தமிழ் வளர்ச்சிக்கு வித்திட்டமை", "D": "வானியல் காலண்டர் தயாரித்தல்"}, "explanation": "மணவை முஸ்தபா அவர்கள் மருத்துவக் கலைச்சொல் களஞ்சியம், கணினிக் கலைச்சொல் களஞ்சியம் முதலான அரிய நூல்களை வெளியிட்டு நவீன அறிவியல் தமிழுக்குப் பெரும் தொண்டாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "What seminal contribution was rendered by scholar Manavai Mustafa to modern Tamil scientific translation?", "media_id": null}], "options": {"A": "Composing culinary books", "B": "Dramatizing Greek folklore", "C": "Compiling foundational encyclopedic dictionaries of medical and technical terminology in Tamil", "D": "Publishing astronomical almanacs"}, "explanation": "Manavai Mustafa pioneered modern Tamil scientific terminology compendiums."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_