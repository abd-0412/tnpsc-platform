{"id": "11th_tamil_u5_q137", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "supplementary_bimbam", "chapter_id": null, "topic_id": "story_climax_emotion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பிம்பம்' கதையின் முடிவில் வாசகருக்கு ஏற்படும் முதன்மையான உணர்வு யாது?", "media_id": null}], "options": {"A": "ஆசிரியரின் கண்டிப்புக்குப் பின்னால் உள்ள மனிதநேயப் பேரன்பும் மாணவனின் அக மலர்ச்சியும்", "B": "பள்ளியின் மீதான வெறுப்புணர்வு", "C": "ஆசிரியரின் அதிகார ஆதிக்கம்", "D": "மாணவனின் தோல்வி மனப்பான்மை"}, "explanation": "கதையின் இறுதியில் ஆசிரியரின் கண்டிப்புக்குப் பின்னாலுள்ள மனிதநேய அன்பும் மாணவனின் உள்ளார்ந்த மலர்ச்சியும் வாசகரை நெகிழச் செய்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What primary emotion is evoked in the reader at the story's conclusion?", "media_id": null}], "options": {"A": "Humanist affection beneath teacher discipline and student inner blooming", "B": "Dislike towards schools", "C": "Teacher tyranny", "D": "Student despair"}, "explanation": "The ending evokes deep appreciation for the profound empathy underlying teacher discipline."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year