{"id": "12th_tamil_u7_q1216", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "athisaya_malar", "chapter_id": null, "topic_id": "free_verse_nature", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அதிசய மலர்’ கவிதை எவ்வகை யாப்பு அல்லது கவிதை நடையில் அமைந்துள்ளது?", "media_id": null}], "options": {"A": "வெண்பா யாப்பு", "B": "ஆசிரிய விருத்தம்", "C": "கலிவெண்பா", "D": "நவீனப் புதுக்கவிதை (வசன கவிதை / கட்டற்ற கவிதை வடிவம்)"}, "explanation": "இக்கவிதை மரபுத் தளைகளின்றி உணர்ச்சியை முதன்மைப்படுத்தும் நவீனப் புதுக்கவிதை (Free verse) நடையில் யாக்கப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "In which structural poetic format is Thamizhnathi's poem 'Athisaya Malar' composed?", "media_id": null}], "options": {"A": "Classical Venpa", "B": "Viruththam meter", "C": "Kalivenpa", "D": "Modern Free Verse (Puthukkavithai)"}, "explanation": "'Athisaya Malar' is rendered in modern Tamil free verse."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 162, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 162", "url": null, "source_notes": null}, "previous_year": {"is_pre