{"id": "12th_tamil_u8_q1460", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kodai_mazhai", "chapter_id": null, "topic_id": "metaphor_summer_rain", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கதையில் ‘கோடை மழை’ என்பது எதற்கான உருவகமாக ஆசிரியரால் கையாளப்பட்டுள்ளது?", "media_id": null}], "options": {"A": "பொருளாதார இழப்பு", "B": "பயிர்களின் அழிவு", "C": "சூரியனின் வெப்பம்", "D": "துன்பமும் சோர்வும் நிறைந்த மனித வாழ்வில் ஆறுதலாய் வந்து தணியும் அன்பு மற்றும் நற்பண்புகள்"}, "explanation": "கடும் வெப்பத்தில் கோடை மழை குளிர்ச்சியைத் தருவது போல, துன்பியல் நிறைந்த வாழ்வில் மனிதர்களின் பரஸ்பர உதவி குளிர்ச்சியையும் புது வாழ்வையும் தருகிறது."}, "en": {"blocks": [{"type": "text", "content": "What does the title metaphor 'Summer Rain' (Kodai Mazhai) symbolically represent?", "media_id": null}], "options": {"A": "Financial ruin", "B": "Crop destruction", "C": "Scorching solar heat", "D": "Revitalizing love, empathy, and kindness arriving as unexpected solace amidst life's exhausting adversities"}, "explanation": "'Summer Rain' symbolizes timely benevolence soothing life's harsh tribulations."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "