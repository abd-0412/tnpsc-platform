{"id": "11th_tamil_u3_q086", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "author_full_name_birthplace", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சி. சு. செல்லப்பாவின் முழுப்பெயர் மற்றும் அவர் பிறந்த ஊர் எது?", "media_id": null}], "options": {"A": "சிவகங்கை சுப்பிரமணிய செல்லப்பா; தேவகோட்டை", "B": "சின்னமனூர் சுப்பிரமணியம் செல்லப்பா; தேனி மாவட்டம் சின்னமனூர்", "C": "சிதம்பரம் சுப்பிரமணியன்; விருத்தாசலம்", "D": "சீர்காழி சுப்பிரமணியன்; மயிலாடுதுறை"}, "explanation": "சி. சு. செல்லப்பா தேனி மாவட்டம் சின்னமனூரில் சுப்பிரமணியம் என்பவரின் மகனாகப் பிறந்தார்."}, "en": {"blocks": [{"type": "text", "content": "What is the expanded full name and native place of C. S. Chellappa?", "media_id": null}], "options": {"A": "Sivagangai Subramania Chellappa; Devakottai", "B": "Chinnamanur Subramaniam Chellappa; Chinnamanur, Theni district", "C": "Chidambaram Subramaniyan; Vridhachalam", "D": "Sirkazhi Subramaniyan; Mayiladuthurai"}, "explanation": "C. S. Chellappa stands for Chinnamanur Subramaniam Chellappa, hailing from Chinnamanur in Theni district."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "