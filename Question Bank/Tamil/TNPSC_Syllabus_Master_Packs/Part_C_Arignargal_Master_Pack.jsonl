{"id": "9th-u9-q103", "schema_version": "1.0", "kind": "factual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l4", "chapter_id": null, "topic_id": "singaram-diaspora-significance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் நாவல் இலக்கிய வரலாற்றில் 'புலம்பெயர்ந்த தமிழர்களின் வாழ்வை முழுமையாகப் பதிவு செய்த முன்னோடி நாவல்' என்ற சிறப்பைப் பெறுவது எது?", "media_id": null}], "options": {"A": "பிரதாப முதலியார் சரித்திரம்", "B": "கமலாம்பாள் சரித்திரம்", "C": "'புயலிலே ஒரு தோணி' (ப. சிங்காரம்)", "D": "பத்மாவதி சரித்திரம்"}, "explanation": "தென்கிழக்காசிய நாடுகளுக்குப் பிழைப்புத் தேடிப் புலம்பெயர்ந்த தமிழ் மக்களின் வாழ்வியல் பாடுகளையும் போர்க்காலத் துயரங்களையும் பதிவு செய்த முன்னோடி நாவலாக 'புயலிலே ஒரு தோணி' போற்றப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which work holds historic pride of place in Tamil fiction as the pioneering novel comprehensively chronicling the Tamil diaspora's life abroad?", "media_id": null}], "options": {"A": "Prathapa Mudaliar Charithiram", "B": "Kamalambal Charithiram", "C": "'Puyalilae Oru Thoni' (Pa. Singaram)", "D": "Padmavathi Charithiram"}, "explanation": "'Puyalilae Oru Thoni' is celebrated as the trailblazer of Tamil diaspora literature."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "pu