{"id": "12th_tamil_u7_q1230", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "theyilai_thotta_paattu", "chapter_id": null, "topic_id": "sinthu_oral_tradition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாட்டுப்புற இலக்கியங்களில் ‘சிந்து’ வகை எதற்காகப் பெரிதும் பயன்படுத்தப்பட்டது?", "media_id": null}], "options": {"A": "மன்னர்களைப் புகழ்ந்து பாட மட்டும்", "B": "பாட்டாளிகளின் உழைப்பு மற்றும் துயரங்களை எளிய சந்தத்தோடு மக்களிடையே பரப்ப", "C": "கோயில் திருவிழா ஆடலுக்கு மட்டும்", "D": "சட்ட நூல்கள் இயற்ற"}, "explanation": "சிந்துப் பாடல்கள் எளிய தொழிலாளர்கள் தங்கள் உழைப்பின் களைப்பை மறக்கவும், சமூக அநீதிகளை எளிய இசையோடு பாடவும் வழிகோலிய வடிவமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Why was the 'Sinthu' folk ballad format favored in oral social protest literature?", "media_id": null}], "options": {"A": "To flatter royal kings exclusively", "B": "To articulate the suffering, exploitation, and angst of laborers in memorable musical verse", "C": "Exclusively for temple pageantry", "D": "To draft legal codes"}, "explanation": "Sinthu verses gave rhythmic voice to the grievances and struggles of common laborers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Se