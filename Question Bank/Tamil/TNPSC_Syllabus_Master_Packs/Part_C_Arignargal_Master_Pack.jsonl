{"id": "12th_tamil_u2_q249", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "piragoru_naal_kodai", "chapter_id": null, "topic_id": "short_film_media", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அய்யப்ப மாதவன் அவர்கள் இலக்கியப் பணியோடு எத்துறையிலும் ஈடுபாடு கொண்டவர்?", "media_id": null}], "options": {"A": "குறும்படம் மற்றும் இதழியல்", "B": "நாட்டிய நாடகம்", "C": "சிற்பக்கலை", "D": "தொல்பொருள் அகழாய்வு"}, "explanation": "அய்யப்ப மாதவன் கவிதைகள் எழுதுவதோடு ‘இன்று’ குறும்படத்தை இயக்கியும், ‘பாவையா’ இதழை நடத்தியும் திரை, இதழியல் துறைகளில் இயங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "Besides literature and poetry, in which artistic media was Ayyappa Madhavan actively engaged?", "media_id": null}], "options": {"A": "Short Filmmaking and Literary Journalism", "B": "Dance Drama", "C": "Stone Sculpting", "D": "Archaeological Excavations"}, "explanation": "Ayyappa Madhavan ventured into short filmmaking ('Indru') and edited the periodical 'Paavaiya'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": "12th Tamil, Unit 2, Pag