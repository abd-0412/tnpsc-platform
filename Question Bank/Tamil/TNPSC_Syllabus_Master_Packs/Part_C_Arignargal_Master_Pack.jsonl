{"id": "9th-u3-q056", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u3-panpaadu", "lesson_id": "lesson-01-eru-thazhuvuthal", "chapter_id": null, "topic_id": "topic-eru-thazhuvuthal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழரின் ஏறு தழுவுதல் பண்பாட்டு மரபு எவற்றை ஒருசேர வளர்த்தெடுக்கும் மேன்மைமிக்க விளையாட்டாகத் திகழ்கிறது?", "media_id": null}], "options": {"A": "பகையையும் கோபத்தையும்", "B": "கர்வதையும் ஆணவத்தையும்", "C": "வெற்றியையும் தோல்வியையும் மட்டும்", "D": "அன்பையும் வீரத்தையும்"}, "explanation": "பாடநூல் பக்க எண் 53 கூற்று: 'அன்பையும் வீரத்தையும் ஒருசேர வளர்த்தெடுக்கும் இவ்விளையாட்டில் காளையை அரவணைத்து அடக்குபவரே வீரராகப் போற்றப்படுவர்.'"}, "en": {"blocks": [{"type": "text", "content": "Which virtues are nurtured hand-in-hand in the noble Tamil tradition of Eru Thazhuvuthal?", "media_id": null}], "options": {"A": "Hatred and fierce vengeance", "B": "Pride and haughtiness", "C": "Solely cold victory and defeat", "D": "Compassionate love and indomitable valor"}, "explanation": "Tamil Eru Thazhuvuthal is uniquely distinguished by harmoniously combining boundless affection for animals with fearless martial valor."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpor