{"id": "11th_tamil_u4_q036", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "printed_books_revolution", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஓலைச்சுவடிகளிலிருந்து நவீன அச்சுப் புத்தகங்களுக்குத் தமிழ் கல்வி முறை மாறுவதற்கு முதன்மைக் காரணியாக அமைந்தது எது?", "media_id": null}], "options": {"A": "எழுத்தாணி தயாரிப்பு குறைந்தது", "B": "பனை மரங்கள் அழிந்தது", "C": "சுவடிகள் தடை செய்யப்பட்டது", "D": "அச்சு இயந்திரங்களின் வரவு மற்றும் தமிழ் நூல்கள் அச்சேறியமை (சீகன் பால்கு தரங்கம்பாடி அச்சுக்கூடம்)"}, "explanation": "தரங்கம்பாடியில் சீகன்பால்கு அமைத்த அச்சுக்கூடம் மற்றும் 19-ஆம் நூற்றாண்டு அச்சுப் புரட்சி ஏட்டுச் சுவடியிலிருந்து புத்தகக் கல்விக்கு வழிகோலியது."}, "en": {"blocks": [{"type": "text", "content": "What historical technological revolution facilitated the transition from brittle palm-leaf manuscripts to modern textbooks?", "media_id": null}], "options": {"A": "Scarcity of iron styluses", "B": "Extinction of palmyra trees", "C": "Prohibition of palm leaves", "D": "Arrival of printing press technology (e.g. Ziegenbalg's Tranquebar press) and modern typography"}, "explanation": "Printing presses in Tranquebar and Madras revolutionized mass education via printed books."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}