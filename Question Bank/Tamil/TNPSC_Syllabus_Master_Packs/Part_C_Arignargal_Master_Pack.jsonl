{"id": "12th_tamil_u3_q486", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "urimaithaagam", "chapter_id": null, "topic_id": "landlord_conspiracy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்ணையார் வெள்ளைச்சாமியின் நிலத்தைக் குறைந்த விலைக்கு அபகரிக்க எத்தகைய சதி செய்தார்?", "media_id": null}], "options": {"A": "வெள்ளையனை ஊரை விட்டுத் துரத்தினார்", "B": "அடமானக் கெடு முடிந்துவிட்டதாகக் கூறி, நிலத்தைத் தன் பெயருக்கு எழுதித் தரும்படி மிரட்டினார்", "C": "பயிர்களைத் தீயிட்டுக் கொளுத்தினார்", "D": "காவல்துறையில் புகார் செய்தார்"}, "explanation": "பண்ணையார் வட்டிக்குப் பணத்தைக் கொடுக்காமல் காலம் தாழ்த்தி, நிலத்தை ஏப்பம் விடத் திட்டம் தீட்டினார்."}, "en": {"blocks": [{"type": "text", "content": "How did the usurious landlord plot to usurp Vellaisami's valuable land at a pittance?", "media_id": null}], "options": {"A": "Exiled Vellaisami from the village", "B": "Declared the mortgage redemption period expired and coerced him to forfeit land ownership", "C": "Set fire to standing crops", "D": "Lodged false police charges"}, "explanation": "The landlord exploited the missed deadline to confiscate the mortgaged property outright."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educationa