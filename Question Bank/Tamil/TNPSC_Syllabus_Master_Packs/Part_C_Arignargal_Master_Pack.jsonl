{"id": "6th-t1-u2-007", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): பாரதியார் சிட்டுக்குருவிகளை வேட்டையாடித் தன் குடும்ப வறுமையைப் போக்கினார்.\nகாரணம் (R): பாரதியார் 'காக்கை குருவி எங்கள் ஜாதி' என்று பாடியதோடு, தம் வீட்டில் தன் மனைவி சமைக்க வைத்திருந்த சிறிதளவு அரிசியையும் சிட்டுக்குருவிகளுக்குப் போட்டுவிட்டுப் பட்டினியாக இருந்தார்.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி.", "B": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு.", "C": "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "கூற்று (A) முற்றிலும் தவறானது (பழிக்கும் கூற்று). காரணம் (R) மகாகவி பாரதியாரின் பறவை நேயத்தை விளக்கும் வரலாற்று உண்மைச் செய்தி."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "பாரதியார் சிட்டுக்குருவிகளை வேட்டையாடித் தன் குடும்ப வறுமையைப் போக்கினார்.", "reason": "பாரதியார் 'காக்கை குருவி எங்கள் ஜாதி' என்று பாடியதோடு, தம் வீட்டில் தன் மனைவி சமைக்க வைத்திருந்த சிறிதளவு அரிசியையும் சிட்டுக்குருவிகளுக்குப் போட்டுவிட்டுப் பட்டினியாக இருந்தார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_ac