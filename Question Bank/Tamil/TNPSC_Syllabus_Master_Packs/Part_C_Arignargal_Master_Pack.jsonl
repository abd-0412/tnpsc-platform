{"id": "11th_tamil_u4_q043", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "dheena_dhaayalu_sanroor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்நாட்டில் நவீன உயர்நிலைப் பள்ளிகளை நிறுவி கல்விச் சேவை ஆற்றியதில் முக்கியப் பங்கு வகித்த அமைப்புகள் எவை?", "media_id": null}], "options": {"A": "வணிக வங்கிகள்", "B": "ராணுவப் பாசறைகள்", "C": "கிறித்தவ மிஷனரிகள் மற்றும் சுதேச தர்ம பரிபாலன சங்கங்கள் (பச்சையப்பர், தியாகராயர்)", "D": "வெளிநாட்டுத் தூதரகங்கள்"}, "explanation": "கிறித்தவ அமைப்புகளுடன் இணைந்து பச்சையப்ப முதலியார் அறக்கட்டளை போன்ற உள்நாட்டு வள்ளல்களின் அறக்கட்டளைகளும் நவீனக் கல்விக்கூடங்களை உருவாக்கின."}, "en": {"blocks": [{"type": "text", "content": "Which institutions partnered significantly in seeding modern secondary high schools across Tamil Nadu?", "media_id": null}], "options": {"A": "Commercial banking syndicates", "B": "Military cantonments", "C": "Christian missionary societies alongside indigenous philanthropic trusts (e.g. Pachaiyappa Mudaliar)", "D": "Foreign embassies"}, "explanation": "Missionary institutions and indigenous trusts established the foundations of secondary education."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi",