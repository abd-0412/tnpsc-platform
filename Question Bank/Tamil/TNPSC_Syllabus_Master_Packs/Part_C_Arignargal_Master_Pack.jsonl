{"id": "6th-t3-u2-022", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'காற்றின் தூய்மையும் நீரின் உயர்வும் யாருக்கும் சொந்தமானவை அல்ல' என்று சியாட்டல் கூறுகிறார்.\nகாரணம் (R): இயற்கைப் பொருள்களை விலைகொடுத்து வாங்கவோ விற்கவோ முடியாது என்பது பழங்குடி மக்களின் பண்பாடு.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "C": "கூற்று தவறு, காரணம் சரி", "D": "இரண்டும் தவறு"}, "explanation": "காற்றையும் நீரையும் நிலத்தையும் எவரும் சொந்தம் கொண்டாட முடியாது என்பது பழங்குடியினரின் உயர்ந்த தத்துவம்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'காற்றின் தூய்மையும் நீரின் உயர்வும் யாருக்கும் சொந்தமானவை அல்ல' என்று சியாட்டல் கூறுகிறார்.", "reason": "இயற்கைப் பொருள்களை விலைகொடுத்து வாங்கவோ விற்கவோ முடியாது என்பது பழங்குடி மக்களின் பண்பாடு.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "3", "edition": "20