{"id": "10th-u1-q094", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "urai_nadaiyin_aninangal", "chapter_id": null, "topic_id": "metaphor_anna", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"களம்புகத் துடித்து நின்ற உனக்கு, வெற்றிச் சாறு கிடைத்துவிட்டது, உண்டு மகிழ்ந்தாய்; உன் புன்னகை தான் அதற்குச் சான்று\" - என்று உருவக நடை நயம்பட உரைநடை எழுதியவர் யார்?", "media_id": null}], "options": {"A": "பெரியார்", "B": "பேரறிஞர் அண்ணா", "C": "மு. கருணாநிதி", "D": "காமராசர்"}, "explanation": "இவ்வரிகள் பேரறிஞர் அண்ணாவின் புகழ்பெற்ற உரைநடை வரிகள் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Who penned the metaphor: \"To you who stood yearning to enter the arena, the juice of victory has been attained... your smile is the living proof\"?", "media_id": null}], "options": {"A": "Periyar", "B": "Perarignar Anna", "C": "M. Karunanidhi", "D": "Kamarajar"}, "explanation": "These celebrated metaphoric prose lines were written by Perarignar Anna."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 12, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 12", "url": null,