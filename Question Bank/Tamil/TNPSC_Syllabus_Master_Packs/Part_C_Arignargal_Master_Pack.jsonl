{"id": "11th_tamil_u6_q006", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "prose_thanjai_periyakovil", "chapter_id": null, "topic_id": "sikhara_stone_weight", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தஞ்சைப் பெரிய கோயில் விமானத்தின் உச்சியில் அமைந்துள்ள ஒற்றைக்கல் போன்ற பிரம்மாண்டத் தளக்கல்லின் (சிகரம் / பிரம்மமந்திரக் கல்) எடை ஏறத்தாழ எவ்வளவு?", "media_id": null}], "options": {"A": "50 டன்கள்", "B": "80 டன்கள்", "C": "100 டன்கள்", "D": "120 டன்கள்"}, "explanation": "விமானத்தின் உச்சியில் வைக்கப்பட்டுள்ள பிரம்மமந்திரக் கல் எனப்படும் கலசத் தளக்கல் ஏறத்தாழ 80 டன் எடை கொண்டதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the approximate weight of the massive octagonal monolithic capstone (Brahmarandhra-sila) crowning the Vimana?", "media_id": null}], "options": {"A": "50 tonnes", "B": "80 tonnes", "C": "100 tonnes", "D": "120 tonnes"}, "explanation": "The massive capstone atop the Vimana weighs approximately 80 tonnes."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 131, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 131", "url": null