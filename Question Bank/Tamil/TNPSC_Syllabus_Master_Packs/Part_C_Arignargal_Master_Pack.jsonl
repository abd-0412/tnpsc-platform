{"id": "10th-u8-q030", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "gnanam", "chapter_id": null, "topic_id": "dust_on_leaves_symbol", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஏடுகளில் படிந்துள்ள அழுக்கு மற்றும் தூசிகளைத் துடைப்பது கவிதையில் எதனை வெளிப்படுத்துகிறது?", "media_id": null}], "options": {"A": "புத்தகத்தை வீசி எறிவது", "B": "காலப்போக்கில் சிந்தனைகளில் படிந்துவிட்ட பழமைவாதக் கசடுகளையும் அறியாமையையும் நீக்கிப் புத்துணர்ச்சி பெறுதல்", "C": "எழுத்துக்களை அழிப்பது", "D": "காகிதங்களை எரிப்பது"}, "explanation": "தூசியைத் துடைத்தல் என்பது காலந்தோறும் மனதில் படியும் தேவையற்ற சோர்வுகளையும் எதிர்மறை எண்ணங்களையும் துடைத்துச் சீராக்குவதைக் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "What does wiping the grime from manuscripts signify in the poet's philosophical vision?", "media_id": null}], "options": {"A": "Discarding the volume", "B": "Purging petrified dogma and negative inertia accumulated over time to achieve intellectual rejuvenation", "C": "Erasing words", "D": "Burning paper"}, "explanation": "It signifies purging accumulated prejudices to restore mental clarity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class