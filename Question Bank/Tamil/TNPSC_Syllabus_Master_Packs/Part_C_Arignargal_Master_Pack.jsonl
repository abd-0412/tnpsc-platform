{"id": "8th-u6-q781", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l2", "chapter_id": null, "topic_id": "textbook-eval-q5-everlasting-scheme", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூல் மதிப்பீட்டு வினா: \"எம்.ஜி.ஆருக்கு அழியாத பெரும் புகழைத் தேடித்தந்த திட்டம் எது?\""}], "options": {"A": "சத்துணவுத் திட்டம்", "B": "வீட்டு வசதித் திட்டம்", "C": "மகளிர் நலன் திட்டம்", "D": "இலவசக் காலணித் திட்டம்"}, "explanation": "பாடநூல் மதிப்பீடு (பக். 121 சரியான விடை 5): எம்.ஜி.ஆருக்கு அழியாத புகழைத் தேடித்தந்த திட்டம் 'சத்துணவுத் திட்டம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Textbook Evaluation Question: \"Which scheme earned M.G.R. everlasting historic fame?\""}], "options": {"A": "Nutritious Meal Scheme (Satthunavu Thittam)", "B": "Housing Facility Scheme", "C": "Women Welfare Scheme", "D": "Free Footwear Scheme"}, "explanation": "Textbook Evaluation (Page 121, Q5): The Nutritious Meal Scheme is universally acknowledged as the hallmark scheme that immortalized M.G.R."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year