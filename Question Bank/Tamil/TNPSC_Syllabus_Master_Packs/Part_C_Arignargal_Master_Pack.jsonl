{"id": "11th_tamil_u2_q126", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "supplementary_yanai_doctor", "chapter_id": null, "topic_id": "jeyamohan_epic", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜெயமோகன் மகாபாரதத்தை அடிப்படையாகக் கொண்டு எழுதிய நவீன பிரம்மாண்ட நாவல் வரிசையின் பெயர் என்ன?", "media_id": null}], "options": {"A": "அறம்", "B": "வெண்முரசு (26 தொகுதிகள்)", "C": "விஷ்ணுபுரம்", "D": "காடு"}, "explanation": "ஜெயமோகன் மகாபாரதத்தை மறுவாசிப்பு செய்து 26 தொகுதிகளாக 'வெண்முரசு' என்னும் உலகின் மிக நீண்ட நாவலை எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "What is the title of the monumental 26-volume modern epic novel series based on the Mahabharata authored by Jeyamohan?", "media_id": null}], "options": {"A": "Aram", "B": "Venmurasu (26 volumes)", "C": "Vishnupuram", "D": "Kaadu"}, "explanation": "'Venmurasu' in 26 volumes is Jeyamohan's re-envisioning of the Mahabharata."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 31, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 31", "url": null, "source_notes": null}, "previous_year": {"is_pr