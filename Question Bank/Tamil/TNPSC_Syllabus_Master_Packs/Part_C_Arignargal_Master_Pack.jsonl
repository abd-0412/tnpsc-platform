{"id": "12th_tamil_u4_q594", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "pandaiya_kaalathu_pallikkoodangal", "chapter_id": null, "topic_id": "thinnai_schools", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைய தமிழகத்தில் ஊர்தோறும் வீடுகளின் முகப்பில் அமைந்துள்ள திண்ணைகளில் நடைபெற்ற கல்வி முறை எவ்வாறு அழைக்கப்பட்டது?", "media_id": null}], "options": {"A": "குருகுலக் கல்வி மட்டும்", "B": "திண்ணைப் பள்ளிக்கூடங்கள் (நாட்டுப் பள்ளிக்கூடங்கள்)", "C": "மழலையர் பள்ளி", "D": "பல்கலைக்கழகம்"}, "explanation": "கிராமப்புறங்களில் ஆசிரியரின் வீட்டுத் திண்ணையிலோ ஊர்ப் பொது இடத்திலோ நடைபெற்ற பள்ளிகள் ‘திண்ணைப் பள்ளிக்கூடங்கள்’ எனப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "What were the traditional community neighbourhood schools conducted on the raised porticoes (Thinnai) of village houses called?", "media_id": null}], "options": {"A": "Gurukula education only", "B": "Thinnai Pallikkoodangal (Native portico schools)", "C": "Kindergarten", "D": "Universities"}, "explanation": "These indigenous village portico academies were known as Thinnai Pallikkoodangal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "