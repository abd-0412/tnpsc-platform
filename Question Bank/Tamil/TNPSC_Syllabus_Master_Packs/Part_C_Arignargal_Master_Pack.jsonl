{"id": "11th_tamil_u7_q045", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "prose_thozhar_jeeva", "chapter_id": null, "topic_id": "sundara_ramasamy_editing_journal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுந்தர ராமசாமி நடத்தி வந்த புகழ்பெற்ற இலக்கியச் சிற்றிதழின் பெயர் யாது?", "media_id": null}], "options": {"A": "காலச்சுவடு (1987-இல் தொடங்கப்பட்டது)", "B": "ழ", "C": "எழுத்து", "D": "மணிக்கொடி"}, "explanation": "சுந்தர ராமசாமி 1987-இல் 'காலச்சுவடு' என்னும் இலக்கிய இதழைத் தொடங்கி நவீனத் தமிழ் இலக்கியச் சூழலில் புதிய விவாதங்களை உருவாக்கினார்."}, "en": {"blocks": [{"type": "text", "content": "Which famous literary journal was founded and edited by Sundara Ramasamy in 1987?", "media_id": null}], "options": {"A": "Kalachuvadu (founded in 1987)", "B": "Zha", "C": "Ezhuthu", "D": "Manikkodi"}, "explanation": "Sundara Ramasamy founded the literary journal 'Kalachuvadu' in 1987."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 148, "chapter": null, "section": null, "reference": "11th Tamil, Unit 7, Page 148", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": fal