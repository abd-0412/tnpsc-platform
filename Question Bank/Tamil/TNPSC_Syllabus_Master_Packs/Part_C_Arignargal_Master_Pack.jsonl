{"id": "11th_tamil_u2_q063", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "poem_thirumalai_murugan_pallu", "chapter_id": null, "topic_id": "paddy_seed_names", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருமலை முருகன் பள்ளுவில் குறிப்பிடப்படும் நெல் விதை வகைகளுள் சரியான வரிசை எது?", "media_id": null}], "options": {"A": "ஹைப்ரிட் 1, ஹைப்ரிட் 2", "B": "கோதுமை, கம்பு, சோளம்", "C": "செந்நெல், வெண்ணெல், சித்திரைக் காளான், வாடன் சம்பா, முத்து வெள்ளை, மணல்வாரி", "D": "ஆப்பிள், ஆரஞ்சு, மாதுளை"}, "explanation": "செந்நெல், வெண்ணெல், சித்திரைக் காளான், வாடன் சம்பா, முத்து வெள்ளை, மணல்வாரி போன்ற எண்ணற்ற நாட்டு நெல் ரகங்கள் பாடலில் பட்டியலிடப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Which sequence accurately lists the native paddy seed varieties recorded in Thirumalai Murugan Pallu?", "media_id": null}], "options": {"A": "Hybrid 1, Hybrid 2", "B": "Wheat, Pearl Millet, Sorghum", "C": "Sennel, Vennel, Chithiraik Kaalaan, Vaadan Samba, Muthu Vellai, Manalvaari", "D": "Apple, Orange, Pomegranate"}, "explanation": "Sennel, Vennel, Chithiraik Kaalaan, Vaadan Samba, Muthu Vellai, and Manalvaari reflect native heritage paddy varieties."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook a