{"id": "8th-u2-q192", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-08-tamizhar-maruthuvam", "chapter_id": null, "topic_id": "ta-8th-u2-odd-health-prescriptions", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மருத்துவர் கு. சிவராமன் பரிந்துரைக்கும் தினசரி ஆரோக்கிய நெறிமுறைகளுள் பொருந்தாத தவறான ஒன்றைக் கண்டறிக:"}], "options": {"A": "45 நிமிடத்தில் 3 கி.மீ. நடைப்பயணம் செய்தல்", "B": "15 நிமிடம் யோகாசனம், தியானம் அல்லது மூச்சுப்பயிற்சி செய்தல்", "C": "இரவில் 7 மணி நேரம் உறங்குதல் மற்றும் 3 லிட்டர் தண்ணீர் அருந்துதல்", "D": "எடைக்குறைப்பை ஒரே மாதத்தில் அதிரடியாக 15 கிலோ அளவுக்குச் செய்து முடித்தல்"}, "explanation": "பாடநூல் பக்கம் 33: 'ஒரேயடியாக எடையைக் குறைப்பது சரியன்று; குறிப்பிட்ட கால இடைவெளியில் ஒன்று, ஒன்றரை ஆண்டுகளில் எடையைக் கட்டுக்குள் கொண்டுவர வேண்டும்' என்று மருத்துவர் கூறுகிறார். எனவே 'ஒரே மாதத்தில் அதிரடியாகக் குறைத்தல்' பொருந்தாதது."}, "en": {"blocks": [{"type": "text", "content": "Identify the INCORRECT daily health guideline not recommended by Dr. Ku. Sivaraman:"}], "options": {"A": "Walking 3 km in 45 minutes", "B": "Practicing 15 minutes of yoga, meditation, or pranayama", "C": "Sleeping 7 hours at night and drinking 3 liters of water", "D": "Cutting down 15 kg drastically within a single month"}, "explanation": "Textbook page 33: Dr. Sivaraman strongly advises against crash diets, advocating weight loss gradually over 1 to 1.5 years. Option D is mismatched."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 33, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["odd_one_out", "health_prescriptions", "tamizhar_maruthuvam"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u2-q194", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "lesson-08-tamizhar-maruthuvam", "chapter_id": null, "topic_id": "ta-8th-u2-odd-native-fruits-list", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மருத்துவர் உணவில் சேர்த்துக்கொள்ளப் பரிந்துரைத்த எளிய உள்ளூர்ப் பழங்களின் பட்டியலில் இடம்பெறாத ஒன்றைக் கண்டறிக:"}], "options": {"A": "கொய்யா, இலந்தை", "B": "கிவி பழம்", "C": "நாவல், நெல்லி", "D": "பப்பாளி, வாழைப்பழம்"}, "explanation": "பாடநூல் பக்கம் 33: மருத்துவர் பரிந்துரைத்த உள்ளூர்ப் பழங்கள்: கொய்யா, இலந்தை, நாவல், பப்பாளி, நெல்லி, வாழைப்பழம். 'கிவி பழம்' என்பது இறக்குமதி செய்யப்படும் விலையுயர்ந்த வெளிநாட்டுப் பழமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Find the fruit that is NOT included in the physician's list of recommended native fruits:"}], "options": {"A": "Guava, Jujube", "B": "Kiwi fruit", "C": "Jamun, Amla", "D": "Papaya, Banana"}, "explanation": "Textbook page 33: Dr. Sivaraman specifically advocates local fruits: guava, jujube, jamun, papaya, amla, and banana. Kiwi is an imported fruit not in the text."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Serv