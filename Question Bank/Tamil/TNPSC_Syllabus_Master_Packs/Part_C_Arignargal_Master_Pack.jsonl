{"id": "12th_tamil_u4_q622", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "idhil_vetri_pera", "chapter_id": null, "topic_id": "suradha_other_books", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுரதாவின் தலைசிறந்த பிற நூல்களுள் தமிழக அரசின் பரிசு பெற்ற நூல் எது?", "media_id": null}], "options": {"A": "துறைமுகம்", "B": "தேன்மழை (1969-ல் தமிழக அரசு பரிசு)", "C": "சிரிப்பின் நிழல்", "D": "முன்னும் பின்னும்"}, "explanation": "சுரதாவின் புகழ்பெற்ற ‘தேன்மழை’ என்னும் கவிதை நூல் தமிழக அரசின் பரிசைப் பெற்றது."}, "en": {"blocks": [{"type": "text", "content": "Which famous poetry anthology by Suradha was awarded the Tamil Nadu State Government Best Book Prize?", "media_id": null}], "options": {"A": "Thuraimugam", "B": "Thaenmazhai", "C": "Sirippin Nizhal", "D": "Munnum Pinnum"}, "explanation": "Suradha's 'Thaenmazhai' won the Tamil Nadu State Government Award."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 76, "chapter": null, "section": null, "reference": "12th Tamil, Unit 4, Page 76", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_n