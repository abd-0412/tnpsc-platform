{"id": "12th_tamil_u2_q295", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "mudhal_kal", "chapter_id": null, "topic_id": "moral_symbolism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘முதல் கல்’ சிறுகதையின் தலைப்பு உணர்த்தும் குறியீட்டுப் பொருள் யாது?", "media_id": null}], "options": {"A": "வீடு கட்டத் தொடங்கும் அஸ்திவாரம்", "B": "ஆற்றில் கிடக்கும் வெறும் கல்", "C": "ஒரு பொதுநலப் பணியைத் தொடங்க யாராவது ஒருவரின் முதல் முன்முயற்சியே ஒட்டுமொத்த சமூக மாற்றத்திற்கும் தொடக்கப்புள்ளி", "D": "பகைமை உணர்ச்சி"}, "explanation": "சமூக மாற்றத்திற்கோ கூட்டுப் பணிக்கோ யாராவது ஒருவர் தயக்கத்தை உடைத்து எடுக்கும் ‘முதல் முயற்சி’யே (முதல் கல்) வெற்றியைத் தரும்."}, "en": {"blocks": [{"type": "text", "content": "What is the deeper symbolic significance encapsulated in the title 'Mudhal Kal' (The First Stone)?", "media_id": null}], "options": {"A": "The foundation stone of a house", "B": "An ordinary river boulder", "C": "The courage of an individual taking the first initiative that breaks collective inertia and sparks communal revolution", "D": "A symbol of enmity"}, "explanation": "'The First Stone' represents the courage of a single pioneer breaking collective bystander paralysis to inspire mass action."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu 