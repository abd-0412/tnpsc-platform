{"id": "7th-t1-u1-083", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l5-kutriyalugaram", "chapter_id": null, "topic_id": "saarbezhethu-types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் இலக்கணத்தில் சார்பெழுத்துகள் மொத்தம் எத்தனை வகைகளாக வகைப்படுத்தப்பட்டுள்ளன?"}], "options": {"A": "ஆறு (6)", "B": "எட்டு (8)", "C": "பத்து (10)", "D": "பன்னிரண்டு (12)"}, "explanation": "பாடநூல் குறிப்பு: சார்பெழுத்து பத்து வகைப்படும் (உயிர்மெய், ஆய்தம், உயிரளபெடை, ஒற்றளபெடை, குற்றியலுகரம், குற்றியலிகரம், ஐகாரக்குறுக்கம், ஔகாரக்குறுக்கம், மகரக்குறுக்கம், ஆய்தக்குறுக்கம்)."}, "en": {"blocks": [{"type": "text", "content": "According to Tamil grammar, into how many classes are Dependent Letters (Saarbezhetthu) classified?"}], "options": {"A": "Six", "B": "Eight", "C": "Ten (10)", "D": "Twelve"}, "explanation": "Textbook fact: Saarbezhetthu comprises exactly 10 categories."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 17, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_p