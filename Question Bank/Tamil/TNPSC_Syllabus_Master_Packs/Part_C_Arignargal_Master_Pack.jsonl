{"id": "12th_tamil_u7_q1217", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "theyilai_thotta_paattu", "chapter_id": null, "topic_id": "sinthu_musical_charm", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சிந்து’ பாடல்களின் முதன்மையான சிறப்பியல்பு யாது?", "media_id": null}], "options": {"A": "எளிய மக்களும் எளிதாகப் பாடி மகிழக்கூடிய சந்த நயமும் தாளக் கட்டும் கொண்ட இசைப்பாடல் வடிவம்", "B": "கடினமான இலக்கண விதிகள்", "C": "உரைநடை வடிவம் மட்டுமே", "D": "பாட முடியாது"}, "explanation": "சிந்து என்பது தமிழ் நாட்டுப்புற இசையின் சந்த நயம் மிக்க, பாமர மக்களும் பாடி உருகக்கூடிய இனிய இசைப்பாடலாகும் (எ.கா: காவடிச்சிந்து, நொண்டிச்சிந்து)."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the primary aesthetic charm of traditional Tamil Sinthu verse?", "media_id": null}], "options": {"A": "Catchy rhythmic cadence and musical lilt easily accessible for oral singing by common folk", "B": "Rigid archaic constraints", "C": "Dry prose syntax", "D": "Unmelodic structure"}, "explanation": "Sinthu songs feature rhythmic cadences suited for oral singing by common laborers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year"