{"id": "12th_tamil_u2_q368", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "tnpsc_pyq_u2", "chapter_id": null, "topic_id": "global_warming_impact", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புவி வெப்பமயமாதலால் ஏற்படும் தீவிர விளைவுகளுள் பொருந்தாதது எது?", "media_id": null}], "options": {"A": "துருவப் பனிப்பாறைகள் உருகுதல்", "B": "கடல்மட்டம் உயர்ந்து தீவுகள் மூழ்குதல்", "C": "பருவமழை பொய்த்தலும் திடீர்ப் பெருவெள்ளமும் ஏற்படுதல்", "D": "பூமியின் வளிமண்டலத்தில் ஆக்ஸிஜன் அளவு அபரிமிதமாக அதிகரித்தல்"}, "explanation": "புவி வெப்பமயமாதலால் பனி உருகும், கடல் மட்டம் உயரும், பருவநிலை மாறும்; ஆக்ஸிஜன் அளவு அதிகரிக்கும் என்பது தவறான கூற்றாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following is NOT a consequence of global warming?", "media_id": null}], "options": {"A": "Melting of polar ice caps", "B": "Rising sea levels submerging low-lying islands", "C": "Erratic monsoons and unseasonal flash floods", "D": "Exponential increase of atmospheric oxygen concentrations"}, "explanation": "Global warming disrupts climate and melts glaciers; it does not increase oxygen levels."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "1