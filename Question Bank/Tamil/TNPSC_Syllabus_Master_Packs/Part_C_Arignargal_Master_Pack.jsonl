{"id": "11th_tamil_u7_q076", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_puratchikkavi", "chapter_id": null, "topic_id": "feudalism_critique", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'புரட்சிக்கவி' காப்பியத்தின் தொடக்கக் காட்சிகளில் மன்னன் மதனமன்னன் எத்தகைய மனோபாவம் கொண்டவனாகக் காட்டப்படுகிறான்?", "media_id": null}], "options": {"A": "மக்களாட்சி விரும்பி", "B": "ஏழைகளை நேசிப்பவன்", "C": "அறிஞர்களை மதிக்கும் பண்பாளன்", "D": "குலப்பெருமை, சாதி மேட்டிமைத்தனம், நிலப்பிரபுத்துவ அகங்காரம் கொண்ட கொடுங்கோல் மன்னன்"}, "explanation": "மதனமன்னன் தன் அரசிளங்குமரி ஓர் ஏழையைக் காதலிப்பதைத் தன் குலத்திற்கும் மன்னராட்சிக்கும் நேர்ந்த மாபெரும் அவமானமாகக் கருதும் நிலப்பிரபுத்துவ வெறி கொண்டவனாகச் சித்தரிக்கப்படுகிறான்."}, "en": {"blocks": [{"type": "text", "content": "How is King Madhanamannan characterized in the opening cantos of 'Puratchikkavi'?", "media_id": null}], "options": {"A": "Democratic reformer", "B": "Lover of the poor", "C": "Respecter of egalitarian scholars", "D": "Feudal autocrat obsessed with lineage pride, caste elitism, and despotic power"}, "explanation": "He personifies arrogant feudal class-pride and autocratic tyranny."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook 