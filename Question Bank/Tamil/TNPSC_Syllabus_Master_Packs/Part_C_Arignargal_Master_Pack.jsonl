{"id": "12th_tamil_u7_q1267", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sangkakala_kalvettu", "chapter_id": null, "topic_id": "tamizhi_script", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் பிராமி எழுத்துக்களுக்கு ஐராவதம் மகாதேவன் சூட்டிய தகுந்த வரலாற்றுப் பெயர் எது?", "media_id": null}], "options": {"A": "கிரந்த எழுத்து", "B": "வட்டெழுத்து", "C": "தமிழி (Damili)", "D": "கோலெழுத்து"}, "explanation": "சமவாய்ச்சூத்திரம், பன்னவணா சூத்திரம் போன்ற பண்டைய சமண நூல்களின் அடிப்படையில் ஐராவதம் மகாதேவன் இக்குறியீட்டு முறைக்கு 'தமிழி' என்ற பெயரை வழங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "What appropriate historical nomenclature did Iravatham Mahadevan designate for Tamil-Brahmi script?", "media_id": null}], "options": {"A": "Grantha script", "B": "Vatteluttu", "C": "Tamizhi (Damili)", "D": "Koleluttu"}, "explanation": "Based on ancient Jain texts like Samavayanga Sutra and Pannavana Sutra, he designated the name 'Tamizhi' (Damili) to this script."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 182, "chapter": null, "section": null, "reference": "12th Tamil, Unit