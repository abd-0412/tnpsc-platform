{"id": "9th-u2-q071", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-02-periyapuranam", "chapter_id": null, "topic_id": "topic-periyapuranam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பாய்வன' என்னும் சொல்லின் சரியான பகுபத உறுப்பிலக்கணப் பிரிப்பு முறை எது?", "media_id": null}], "options": {"A": "பாய் + வன் + அ", "B": "பாய்வ + அன் + அ", "C": "பாய் + வ் + அன் + அ", "D": "பாய் + வ் + அன"}, "explanation": "பாய்வன = பாய் + வ் + அன் + அ. பாய் - பகுதி, வ் - எதிர்கால இடைநிலை, அன் - சாரியை, அ - பலவின்பால் வினைமுற்று விகுதி."}, "en": {"blocks": [{"type": "text", "content": "Which is the correct morphemic division of 'Paayvana' in Tamil grammar?", "media_id": null}], "options": {"A": "Paay + van + a", "B": "Paayva + an + a", "C": "Paay + v + an + a", "D": "Paay + v + ana"}, "explanation": "Paayvana = Paay (root) + v (future tense medial) + an (inflectional increment) + a (neuter plural finite verb suffix)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 31, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 31", "url": null, "source_notes": null}, "prev