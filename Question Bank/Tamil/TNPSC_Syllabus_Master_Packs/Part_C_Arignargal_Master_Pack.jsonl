{"id": "11th_tamil_u3_q094", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "supplementary_vaadivaasal", "chapter_id": null, "topic_id": "jallikattu_sacred_rule", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஏறுதழுவுதலில் தமிழர்களின் அறம் சார்ந்த வீர விதிமுறை யாது?", "media_id": null}], "options": {"A": "காளையைக் கயிறுகளால் கட்டி இழுப்பது", "B": "காளையின் கொம்புகளையோ வாலையோ பிடிக்காமல், அதன் திமிலை மட்டுமே பற்றித் தழுவி அடக்குதல்", "C": "காளையைக் கூரிய ஆயுதங்களால் தாக்குவது", "D": "காளையை வீழ்த்த மருந்துகளைப் பயன்படுத்துவது"}, "explanation": "தமிழர் ஏறுதழுவலில் மாட்டின் கொம்பையோ வாலையோ தொடாமல் அதன் திமிலை மட்டுமே நெஞ்சோடு தழுவி அடக்குவதே வீர மரபாகும்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the cardinal, ethical rule of engagement in traditional Tamil bull-taming (Eru Thazhuvuthal)?", "media_id": null}], "options": {"A": "Tying the bull with heavy ropes", "B": "Grasping only the muscular hump (Thimil) in a firm embrace without touching the horns or twisting the tail", "C": "Striking the beast with iron weapons", "D": "Sedating the bull with narcotics"}, "explanation": "Traditional ethos strictly mandates embracing only the hump without harming horns or tail."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Sam