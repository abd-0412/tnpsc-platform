{"id": "8th-u7-q921", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l3", "chapter_id": null, "topic_id": "periyar-quote-completion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தந்தை பெரியாரின் அருள்வாக்கை நிறைவு செய்க:\n\"என் பகுத்தறிவுப் பிரச்சாரத்திற்கும் சீர்திருத்தக் கருத்துகளுக்கும் முன்னோடிகளாகத் திகழ்ந்தவர்கள் பண்டிதமணி அயோத்திதாசரும் ______ ஆவார்.\""}], "options": {"A": "தங்கவயல் அப்பாதுரையாரும்", "B": "திரு. வி. கலியாணசுந்தரனாரும்", "C": "மறைமலையடிகளாரும்", "D": "உ. வே. சாமிநாதையரும்"}, "explanation": "பாடநூல் பக். 138 தெரிந்து தெளிவோம்: \"என் பகுத்தறிவுப் பிரச்சாரத்திற்கும் சீர்திருத்தக் கருத்துகளுக்கும் முன்னோடிகளாகத் திகழ்ந்தவர்கள் பண்டிதமணி அயோத்திதாசரும் தங்கவயல் அப்பாதுரையாரும் ஆவார்கள்\" - தந்தை பெரியார்."}, "en": {"blocks": [{"type": "text", "content": "Complete the famous tribute by Thanthai Periyar:\n\"The pioneers of my rationalist campaign and reformist thoughts were Pandithamani Ayothidhasar and ______.\""}], "options": {"A": "Thangavayal Appaduraiyar", "B": "Thiru. Vi. Kaliyanasundaranar", "C": "Maraimalai Adigalar", "D": "U. Ve. Swaminatha Iyer"}, "explanation": "Textbook Page 138: Periyar named 'Thangavayal Appaduraiyar' alongside Pandithamani Ayothidhasar as the dual pioneers of his rationalist movement."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "odd_one_out", "quote-completion", "periyar", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q922", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l3", "chapter_id": null, "topic_id": "sangam-demands-odd-one", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திராவிட மகாஜன சங்கம் போராடிய மக்கள் நலக் கோரிக்கைகளுள் பொருந்தாத ஒன்றைத் தேர்க:"}], "options": {"A": "கிராமப்புறச் சாலைகள் அமைத்தல்", "B": "அயல்நாடுகளுக்குப் போர் தொடுக்கத் தனிப்படை திரட்டுதல்", "C": "கால்வாய்களைப் பராமரித்தல் மற்றும் பொது மருத்துவமனைகள் அமைத்தல்", "D": "சிற்றூர்கள்தோறும் பள்ளிக்கூடங்கள் அமைத்தல்"}, "explanation": "பாடநூல் பக். 138: திராவிட மகாஜன சங்கம் சாலைகள், கால்வாய்கள், காவல் பாதுகாப்பு, பொது மருத்துவமனை, சிற்றூர் பள்ளிக்கூடங்கள் ஆகியவற்றிற்காகவே போராடியது; போர் தொடுக்கப் படை திரட்டவில்லை. எனவே பொருந்தாதது கூற்று B."}, "en": {"blocks": [{"type": "text", "content": "Select the item that does NOT belong to the civic demands of Dravida Mahajana Sangam:"}], "options": {"A": "Laying rural roadways", "B": "Mobilizing military armies to wage foreign wars", "C": "Canal maintenance and establishing public hospitals", "D": "Constructing primary schools in every village"}, "explanation": "Textbook Page 138: The Sangam fought for roads, canals, policing, hospitals, and schools. Waging foreign wars was never its agenda. Hence B is the odd one."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-7", "odd_one_out", "civic-demands", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u7-q923", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u7-l3", "chapter_id": null, "topic_id": "dravida-mahajana-sangam-year-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அயோத்திதாசர் 'திராவிட மகாஜன சங்கம்' என்னும் அமைப்பைத் தோற்றுவித்த ஆண்டு எது?"}], "options": {"A": "1845", "B": "1885", "C": "1892", "D": "1907"}, "explanation": "பாடநூல் பக். 138: அயோத்திதாசர் தமது கொள்கைகளை வலியுறுத்தவும் ஒடுக்கப்பட்டோர் உரிமைகளைப் பாதுகாக்கவும் 1892-ஆம் ஆண்டு 'திராவிட மகாஜன சங்கம்' என்னும் அமைப்பைத் தோற்றுவித்தார்."}, "en": {"blocks": [{"type": "text", "content": "In which year did Ayothidhasar establish the organization 'Dravida Mahajana Sangam'?"}], "options": {"A": "1845", "B": "1885", "C": "1892", "D": "1907"}, "explanation": "Textbook Page 138: Ayothidhasar founded the Dravida Mahajana Sangam in 1892."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": nul