{"id": "6th-t2-u1-077", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சொல்லின் இடங்களில் வரும் எழுத்துகளின் எண்ணிக்கையைப் பொருத்துக:\nபட்டியல் I:\n(a) சொல்லின் இடையில் வரும் மெய்யெழுத்துகள்\n(b) சொல்லின் இறுதியில் வரும் மெய்யெழுத்துகள்\n(c) சொல்லின் இறுதியில் வாரா மெய்யெழுத்துகள்\n(d) சொல்லின் இடையில் மட்டுமே வரும் சார்பெழுத்து\n\nபட்டியல் II:\n1. ஆய்த எழுத்து (1)\n2. ஏழு (7)\n3. பதினொன்று (11)\n4. பதினெட்டு (18)", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-4, (b)-3, (c)-2, (d)-1", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-2, (b)-1, (c)-4, (d)-3"}, "explanation": "இடையில் வரும் மெய்கள் - 18; இறுதியில் வரும் மெய்கள் - 11; வாரா மெய்கள் - 7; இடையில் மட்டுமே வரும் சார்பெழுத்து - ஆய்தம் (1). சரியான பொருத்தம்: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "public