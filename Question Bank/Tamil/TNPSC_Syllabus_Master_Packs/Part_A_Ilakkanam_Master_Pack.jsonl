{"id": "11th_tamil_u2_q179", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "revision_unit_2", "chapter_id": null, "topic_id": "kural_medicine_air", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மருந்தென வேண்டாவாம் யாக்கைக்கு அருந்தியது / அற்றது போற்றி உணின்’ - இக்குறள் உணர்த்தும் நல்வாழ்வு நெறி யாது?", "media_id": null}], "options": {"A": "அடிக்கடி மருந்து உண்ண வேண்டும்", "B": "உணவு உண்ணாமல் பட்டினி கிடக்க வேண்டும்", "C": "முன் உண்ட உணவு செரித்ததை (செரிமானம் ஆனதை) அறிந்து அடுத்த வேளை உணவை அளவோடு உண்டால் உடலுக்கு மருந்தே தேவையில்லை", "D": "விலையுயர்ந்த உணவுகளை மட்டுமே உண்ண வேண்டும்"}, "explanation": "முன்பு உண்ட உணவு நன்கு செரித்த பின்னரே அடுத்த வேளை உணவை அளவாக உண்ண வேண்டும்; அவ்வாறு உண்டால் ஒருபோதும் நோயும் மருந்தும் தேவைப்படாது."}, "en": {"blocks": [{"type": "text", "content": "What health wisdom does the Kural 'Marunthena vaendaavaam yaakkaikku arunthiyathu atrathu poatri unin' articulate?", "media_id": null}], "options": {"A": "One must consume pills continuously", "B": "One must starve perpetually", "C": "If one eats with moderation only after previously ingested food is fully digested, the body requires no medicine whatsoever", "D": "Consume exclusively costly gourmet meals"}, "explanation": "Eating moderately after previous meal digestion renders pharmaceutical medicine unnecessary."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "nega