{"id": "12th_tamil_u6_q1108", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "anangu_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அச்சத்திற்குரிய காரணங்களில் கூறப்படும் ‘அணங்கு’ என்னும் சொல்லின் பொருள் யாது?", "media_id": null}], "options": {"A": "காட்டு விலங்கு", "B": "அரசன்", "C": "திருடன்", "D": "தெய்வம் / பேய் போன்ற இயற்கை கடந்த அமானுஷ்ய ஆற்றல்"}, "explanation": "‘அணங்கு’ என்பது மனித ஆற்றலுக்கு அப்பாற்பட்ட தெய்வீக அல்லது அமானுஷ்ய பேயுருவ ஆற்றலைக் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "What does the ancient Tamil term 'Anangu' precisely designate in the etiology of Fear (Achcham)?", "media_id": null}], "options": {"A": "Wild beast", "B": "Mighty king", "C": "Highway robber", "D": "Supernatural divine or spectral entity possessing eerie metaphysical power"}, "explanation": "'Anangu' signifies uncanny supernatural spirits, deities, or spectral forces that inspire dread."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 144, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 144", "u