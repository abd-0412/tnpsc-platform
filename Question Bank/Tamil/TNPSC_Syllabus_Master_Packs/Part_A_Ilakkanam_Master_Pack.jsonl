{"id": "7th-t2-u2-q189", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-09-tamil-olir-idangal", "chapter_id": null, "topic_id": "ta-t2-u2-grammar-tamil-olir-punarchi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தமிழ் + ஒளிர் = தமிழ்ஒளிர்' என்பதில் உயிர்மெய் இணைந்தமைக்குரிய புணர்ச்சி விதி யாது?"}], "options": {"A": "உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே", "B": "உயிர்வரின் உக்குறள் மெய்விட்டோடும்", "C": "இ ஈ ஐ வழி யவ்வும்", "D": "தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும்"}, "explanation": "'தமிழ் + ஒளிர்': நிலைமொழி ஈற்றில் உள்ள மெய்யெழுத்தின் மீது (ழ்) வருமொழி முதலிலுள்ள உயிரெழுத்து (ஒ) இயல்பாக வந்து இணைந்து (ழ் + ஒ = ழொ) 'தமிழ்ஒளிர்' என்றானது. விதி: உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே."}, "en": {"blocks": [{"type": "text", "content": "Identify the Sandhi rule for the vowel combination in 'Tamil + Olir = Tamilolir':"}], "options": {"A": "Udalmel uyirvanthu ondruvathu iyalbe", "B": "Uyirvarin ukkural meyvittodum", "C": "I Ee Ai vazhi yavvum", "D": "Thanikkuril mun otru uyirvarin irattum"}, "explanation": "The final consonant 'zh' naturally joins with initial vowel 'o' into 'zho' per 'Udalmel uyirvanthu ondruvathu iyalbe'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 29, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["punarchi", "sandhi_rules", "grammar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q190", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-09-tamil-olir-idangal", "chapter_id": null, "topic_id": "ta-t2-u2-grammar-poompuhar-thogai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பூம்புகார்' என்னும் சொல்லின் இலக்கணக் குறிப்பைக் கண்டறிக:\n'பூம் + புகார்'"}], "options": {"A": "வினைத்தொகை", "B": "பண்புத்தொகை", "C": "உவமைத்தொகை", "D": "உம்மைத்தொகை"}, "explanation": "'பூம்புகார்' என்பது 'பொலிவு மிக்க புகார்' (பொலிவாகிய புகார்) என்னும் பண்புப் பொருளை உணர்த்தி நிற்பதால் இது பண்புத்தொகை எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the grammatical categorization (Ilakkana Kurippu) of 'Poompuhar':"}], "options": {"A": "Vinai-thogai (Verbal compound)", "B": "Panbu-thogai (Qualitative compound)", "C": "Uvamai-thogai (Metaphorical compound)", "D": "Ummai-thogai (Co-ordinate compound)"}, "explanation": "'Poompuhar' signifies beauty/splendor (Polivaana Puhar), functioning as a qualitative compound (Panbu-thogai)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 33, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["ilakkana_kurippu", "panbuthogai", "grammar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q191", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-09-tamil-olir-idangal", "chapter_id": null, "topic_id": "ta-t2-u2-grammar-nedungal-sandhi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'நெடுங்கல்' என்னும் சொல்லின் சரியான பிரித்தெழுதுதலையும் இலக்கண விதியையும் கண்டறிக:\n'நெடுமை + கல்'"}], "options": {"A": "உயிர்வரின் உக்குறள் மெய்விட்டோடும்", "B": "இ ஈ ஐ வழி யவ்வும்", "C": "ஈறு போதல், முன்னின்ற மெய்திரிதல் (இனமிகல்)", "D": "தனிக்குறில் முன் ஒற்று இரட்டும்"}, "explanation": "நெடுமை + கல்:\n1. 'ஈறு போதல்' விதிப்படி 'மை' கெட்டது (நெடு + கல்).\n2. 'இனமிகல்' விதிப்படி வருமொழி வல்லினமான 'க்'கு இனமான மெல்லினம் 'ங்' தோன்றி 'நெடுங்கல்' என்றானது."}, "en": {"blocks": [{"type": "text", "content": "Identify the split and Sandhi transformation rules in 'Nedungal' (Nedumai + Kal):"}], "options": {"A": "Uyirvarin ukkural meyvittodum", "B": "I Ee Ai vazhi yavvum", "C": "Eeru pothal, followed by nasal assimilation (Inamikal: ng before k)", "D": "Thanikkuril mun otru irattum"}, "explanation": "First, 'Eeru pothal' drops the suffix 'mai' (Nedu + Kal), then nasal assimilation introduces 'ng' before velar stop 'k', yielding 'Nedungal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 34, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["punarchi", "sandhi_rules", "grammar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

