{"id": "12th_tamil_u1_q147", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "mozhi_thiran", "chapter_id": null, "topic_id": "suradha_original_name", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘உவமைக் கவிஞர்’ என்று பாராட்டப்படும் சுரதாவின் இயற்பெயர் யாது?", "media_id": null}], "options": {"A": "சுப்புரத்தினம்", "B": "துரைராசு", "C": "இராசகோபாலன்", "D": "மாணிக்கம்"}, "explanation": "சுரதாவின் இயற்பெயர் இராசகோபாலன். பாரதிதாசன் மீதான பற்றினால் ‘சுப்புரத்தினதாசன்’ (சுரதா) என்று மாற்றிக்கொண்டார்."}, "en": {"blocks": [{"type": "text", "content": "What is the original name of Suradha, revered as 'Uvamai Kavignar'?", "media_id": null}], "options": {"A": "Subburathinam", "B": "Durairasu", "C": "Rajagopalan", "D": "Manickam"}, "explanation": "Suradha's original given name was Rajagopalan. He took the pseudonym Subburathinadasan (Suradha) out of reverence for Bharathidasan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 19, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 19", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null