{"id": "6th-t3-u2-014", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்றுகளை ஆராய்க:\nகூற்று 1: பூக்களைத் தொடுப்பது போல் இரண்டு இரண்டு அடிகளாக எதுகையால் தொடுக்கப்படும் பாடல் வகை கண்ணி எனப்படும்.\nகூற்று 2: தாயுமானவர் பாடல்கள் பக்தி உணர்வோடு தத்துவச் சிந்தனைகளையும் ஒருங்கே தருகின்றன.", "media_id": null}], "options": {"A": "கூற்று 1 சரி, கூற்று 2 தவறு", "B": "கூற்று 1, கூற்று 2 ஆகிய இரண்டும் சரி", "C": "கூற்று 1 தவறு, கூற்று 2 சரி", "D": "இரண்டும் தவறு"}, "explanation": "கண்ணி என்பது இரண்டு மலர்களை வைத்துக் கட்டுவது போல இரண்டு அடிகளால் எதுகை அமைத்துப் பாடப்படுவது. இரண்டும் சரி."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பூக்களைத் தொடுப்பது போல் இரண்டு இரண்டு அடிகளாக எதுகையால் தொடுக்கப்படும் பாடல் வகை கண்ணி எனப்படும்.", "content_en": null}, {"id": "S2", "content_ta": "தாயுமானவர் பாடல்கள் பக்தி உணர்வோடு தத்துவச் சிந்தனைகளையும் ஒருங்கே தருகின்றன.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tami