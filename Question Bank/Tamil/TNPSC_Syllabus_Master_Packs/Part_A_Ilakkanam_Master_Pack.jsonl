{"id": "7th-t3-u3-q301", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u3-maanudam", "lesson_id": "lesson-13-payanam", "chapter_id": null, "topic_id": "ta-t3-u3-sandhi-eethuvakkum", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஈத்துவக்கும்' என்னும் சொல்லைச் சரியாகப் பிரித்தெழுதக் கிடைக்கும் வடிவம் மற்றும் புணர்ச்சி விதி யாது?"}], "options": {"A": "ஈத்து + உவக்கும் (உயிர்வரின் உக்குறள் மெய்விட்டோடும்)", "B": "ஈ + துவக்கும் (தோன்றல் புணர்ச்சி)", "C": "ஈத்து + வக்கும் (கெடுதல் புணர்ச்சி)", "D": "ஈத்த + உவக்கும் (இயல்புப் புணர்ச்சி)"}, "explanation": "'ஈத்துவக்கும்' = ஈத்து + உவக்கும். நிலைமொழி ஈற்றில் உள்ள குற்றியலுகரம் வருமொழி முதல் உயிரெழுத்து (உ) வரக் கெட்டது (ஈத் + உவக்கும் = ஈத்துவக்கும்: விதி: உயிர்வரின் உக்குறள் மெய்விட்டோடும்; உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே)."}, "en": {"blocks": [{"type": "text", "content": "What is the correct splitting of 'Eethuvakkum' and which sandhi rule operates?"}], "options": {"A": "Eethu + uvakkum (Elision of short u before vowel)", "B": "Ee + thuvakkum (Epenthesis)", "C": "Eethu + vakkum (Elision)", "D": "Eetha + uvakkum (Normal)"}, "explanation": "'Eethu + uvakkum' = Eethuvakkum. The terminal kurriyalugaram is elided before the initial vowel 'u', followed by consonant-vowel bonding."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 55, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["sandhi", "split_words", "eethuvakkum", "grammar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u3-q302", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u3-maanudam", "lesson_id": "lesson-13-payanam", "chapter_id": null, "topic_id": "ta-t3-u3-metrics-paavannan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பாவண்ணன்' என்ற சொல்லின் மொத்த மாத்திரை அளவைக் கணக்கிடுக:"}], "options": {"A": "4.0 மாத்திரைகள்", "B": "5.0 மாத்திரைகள்", "C": "5.5 மாத்திரைகள்", "D": "6.0 மாத்திரைகள்"}, "explanation": "மாத்திரை கணக்கீடு:\nபா (நெடில்) = 2\nவ (குறில்) = 1\nண் (மெய்) = 0.5\nண (குறில்) = 1\nன் (மெய்) = 0.5\nகூடுதல் = 2 + 1 + 0.5 + 1 + 0.5 = 5.0 மாத்திரைகள்."}, "en": {"blocks": [{"type": "text", "content": "Calculate the total Maathirai count for the name 'Paavannan':"}], "options": {"A": "4.0 Maathirais", "B": "5.0 Maathirais", "C": "5.5 Maathirais", "D": "6.0 Maathirais"}, "explanation": "Metrics: Paa (2) + va (1) + n (0.5) + na (1) + n (0.5) = 5.0 Maathirais."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 58, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["metrics", "maathirai", "paavannan", "grammar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u3-q303", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u3-maanudam", "lesson_id": "lesson-13-payanam", "chapter_id": null, "topic_id": "ta-t3-u3-paaimarakkappal-grammar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாவண்ணனின் நூலான 'பாய்மரக் கப்பல்' என்ற தொடரின் இலக்கணக் குறிப்பைக் கண்டறிக:"}], "options": {"A": "வினைத்தொகை", "B": "உவமைத்தொகை", "C": "இரண்டாம் வேற்றுமை உருபும் பயனும் உடன் தொக்க தொகை", "D": "பண்புத்தொகை"}, "explanation": "'பாய்மரக் கப்பல்' என்பதை 'பாய்மரத்தை உடைய கப்பல்' என விரிக்கலாம். இதில் 'ஐ' என்னும் இரண்டாம் வேற்றுமை உருபும், 'உடைய' என்னும் பயனும் மறைந்து (தொக்கு) வந்ததால் இது 'இரண்டாம் வேற்றுமை உருபும் பயனும் உடன் தொக்க தொகை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the grammatical classification of the phrase 'Paaimarak Kappal':"}], "options": {"A": "Vinai-thogai", "B": "Uvamai-thogai", "C": "2nd Case compound with case marker and role noun elided", "D": "Panbu-thogai"}, "explanation": "'Paaimarak Kappal' expands as 'Paaimarathai udaiya kappal'. The 2nd case marker 'ai' and the relative role 'udaiya' are elided together, making it a 2nd case roll-and-marker compound."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publ