{"id": "12th_tamil_mp1_q1664", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_1", "lesson_id": "synoptic_mock_4", "chapter_id": null, "topic_id": "traffic_white_lines", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சாலையின் நடுவே விட்டுவிட்டுப் போடப்படும் வெள்ளைக் கோடுகள் (Broken White Lines) வாகன ஓட்டிகளுக்கு எதனை அனுமதிக்கின்றன?", "media_id": null}], "options": {"A": "வாகனத்தை அங்கேயே நிறுத்துவதை", "B": "வேக வரம்பை மீறுவதை", "C": "சாலை விதிகளைப் புறக்கணிப்பதை", "D": "பாதுகாப்பான சூழல் இருப்பின் முன்னால் செல்லும் வாகனத்தை முந்திச் செல்வதையும் (Overtaking) பாதை மாறுவதையும்"}, "explanation": "விட்டுவிட்டுக் காணப்படும் வெள்ளைக் கோடுகள் தேவையான எச்சரிக்கையுடன் எதிரில் வாகனம் வராத போது முந்திச் செல்ல (Overtake) அனுமதிக்கின்றன."}, "en": {"blocks": [{"type": "text", "content": "What does a broken white lane line running along the center of a roadway permit motorists to do?", "media_id": null}], "options": {"A": "Park vehicles permanently on the line", "B": "Exceed statutory speed limits", "C": "Disregard traffic laws", "D": "Overtake vehicles ahead and change lanes safely when road conditions permit"}, "explanation": "Broken white center lines indicate that overtaking and lane maneuvering are permitted with caution."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Ta