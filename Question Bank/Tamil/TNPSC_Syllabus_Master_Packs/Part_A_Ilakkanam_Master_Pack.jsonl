{"id": "11th_tamil_rev2_q159", "schema_version": "1.0", "kind": "grammar_identification", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u8_grammar_mega_test", "chapter_id": null, "topic_id": "sandhi_demonstrative", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அ, இ, எ என்னும் சுட்டெழுத்துகளின் பின் வல்லினம் மிகும்’ - இவிதிக்குரிய எடுத்துக்காட்டு எது?", "media_id": null}], "options": {"A": "அப்பையன், இச்சிலை, எப்பொருள்", "B": "அக்காலம், இக்காலம், எத்திசை", "C": "மேற்கண்ட இரண்டும் சரியான எடுத்துக்காட்டுகளே", "D": "எதுவுமில்லை"}, "explanation": "அ, இ என்னும் அகச்சுட்டு மற்றும் எ என்னும் வினா எழுத்தின் பின் வரும் வல்லினம் கண்டிப்பாக மிகும். இரண்டும் சரியான சான்றுகளே."}, "en": {"blocks": [{"type": "text", "content": "Which set confirms the rule 'Vallinam doubles after root demonstratives A, I and interrogative E'?", "media_id": null}], "options": {"A": "Appaiyan, Ichilai, Epporul", "B": "Akkaalam, Ikkaalam, Etthisai", "C": "Both the above are correct examples", "D": "None of the above"}, "explanation": "Direct vowel demonstratives a-, i- and interrogative e- mandatorily double subsequent plosives."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", 