{"id": "11th_tamil_u2_q144", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "grammar_punarchi_vithigal", "chapter_id": null, "topic_id": "v_glide_example", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பல + உயிர் = பலவுயிர்’ - இதில் எந்த உடம்படுமெய் தோன்றிப் புணர்ந்துள்ளது?", "media_id": null}], "options": {"A": "யகர உடம்படுமெய் (ய்)", "B": "ரகர மெய் (ர்)", "C": "லகர மெய் (ல்)", "D": "வகர உடம்படுமெய் (வ்)"}, "explanation": "பல (ல்+அ): அகரம் ஈறாக உள்ளதால் 'ஏனை உயிர் வழி வவ்வும்' விதிப்படி வகர உடம்படுமெய் (வ்) தோன்றி 'பலவுயிர்' என்றானது."}, "en": {"blocks": [{"type": "text", "content": "Which transitional glide appears in the compound 'Pala + uyir = Palavuyir'?", "media_id": null}], "options": {"A": "Y-glide (ய்)", "B": "R-consonant (ர்)", "C": "L-consonant (ல்)", "D": "V-glide (வ் via Eanai uyir vazhi vavvum)"}, "explanation": "Terminating in vowel 'a', it takes the V-glide 'v' (வ்) to bridge the hiatus."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 36", "url": null, "source_notes": null}, "previous_yea