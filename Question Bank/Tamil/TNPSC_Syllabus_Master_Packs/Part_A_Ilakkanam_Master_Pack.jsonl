{"id": "11th_tamil_u7_q179", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "pyq_unit7", "chapter_id": null, "topic_id": "pyq_nataka_iyal_parithimar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] தமிழில் முதன்முதலில் நாடகத்திற்குரிய இலக்கணத்தை மரபார்ந்த சூத்திர அமைப்பில் 'நாடகவியல்' என்னும் பெயரில் இயற்றிய தமிழறிஞர் யார்?", "media_id": null}], "options": {"A": "பேராசிரியர் சுந்தரனார்", "B": "உ. வே. சாமிநாதையர்", "C": "பரிதிமாற்கலைஞர் (வி. கோ. சூரியநாராயண சாஸ்திரியார்)", "D": "மறைமலையடிகள்"}, "explanation": "பரிதிமாற்கலைஞர் தாமே செய்யுள் வடிவில் 'நாடகவியல்' என்னும் அரிய நாடக இலக்கண நூலை இயற்றித் தமிழுக்கு வழங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Who authored 'Naadagaviyal', the pioneering classical treatise on Tamil dramatic theory formatted in poetic sutras?", "media_id": null}], "options": {"A": "Prof. Sundaranar", "B": "U. Ve. Swaminatha Iyer", "C": "Parithimaar Kalaignar (V. G. Suryanarayana Sastriar)", "D": "Maraimalai Adigal"}, "explanation": "Parithimaar Kalaignar formulated dramatic grammar in his treatise 'Naadagaviyal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "