{"id": "12th_tamil_u7_q1307", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "poetic_resonance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழங்காலத் தொன்மங்களை நவீனக் கவிஞர்கள் கையாள்வதன் மிக முக்கியமான நன்மை என்ன?", "media_id": null}], "options": {"A": "கவிதையின் பக்க அளவை நீட்டிக்க முடியும்", "B": "கவிஞரின் மதப்பற்றைக் காட்ட முடியும்", "C": "நீண்ட விளக்கங்கள் இன்றி, ஒற்றைக் குறியீட்டின் வழி வாசகனின் ஆழ்மனதில் தீவிரமான உணர்வுகளையும் உட்கருத்தையும் சட்டெனத் தூண்ட முடியும்", "D": "எளிமையான எதுகை மோனைகளை உருவாக்கலாம்"}, "explanation": "தொன்மங்கள் செறிவு மிக்க குறியீடுகளாக அமைவதால், ஒரு சில வரிகளில் பெரும் சமூக, தத்துவார்த்த உண்மைகளை வாசகருக்கு உணர்த்தும் ஆற்றல் பெறுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What is the most significant advantage when modern poets deploy ancient mythological archetypes?", "media_id": null}], "options": {"A": "Allows extending the length of verses", "B": "Displays the religious faith of the bard", "C": "Instantly evokes deep aesthetic feelings and complex subtexts within the reader's psyche without lengthy explanations", "D": "Enables simple rhyming schemes"}, "explanation": "Because myths act as condensed multi-layered symbolic archetypes, they trigger intense emotional and philosophical resonance immediately."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, 