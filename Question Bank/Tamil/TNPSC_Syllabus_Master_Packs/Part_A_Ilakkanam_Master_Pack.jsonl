{"id": "11th_tamil_rev2_q050", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "vallinam_sandhi_error", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வல்லினம் மிகும் இடங்களில் தவறான இணையைத் தேர்க:", "media_id": null}], "options": {"A": "அந்தப் பையன் (சுட்டுத் திரிபு)", "B": "வந்த பையன் (பெயரெச்சம்)", "C": "ஓடிப் போனான் (வினையெச்சம்)", "D": "பாடக் கேட்டான் (அகர ஈற்று வினையெச்சம்)"}, "explanation": "பெயரெச்சத்தின் பின் வல்லினம் மிகக் கூடாது. 'வந்த பையன்' என்பதே சரியானது; 'வந்தப் பையன்' என வல்லினம் மிகுவது பிழையாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the INCORRECT sandhi doubling pair:", "media_id": null}], "options": {"A": "Antha-p paiyan (demonstrative change)", "B": "Vantha-p paiyan (relative participle)", "C": "Odi-p ponaan (verbal participle)", "D": "Paada-k kettaan (adverbial participle ending in 'a')"}, "explanation": "Vallinam never doubles after a relative participle; 'Vantha paiyan' is correct without doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": nul