{"id": "6th-t2-u2-003", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'நானிலம் படைத்தவன்' செய்யுளில் வரும் சொல்லும் பொருளும் குறித்த கூற்றுகளை ஆராய்க:\n1. 'மல்லெடுத்த' என்பதற்கு 'வலிமை பெற்ற' என்பது பொருள்.\n2. 'சமர்' என்பதற்குப் 'போர்' என்பது பொருள்.\n3. 'நல்கும்' என்பதற்குத் 'தரும்' என்பது பொருள்.\n4. 'ஆழி' என்பதற்குப் 'பெருங்காற்று' என்பது பொருள்.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "C": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "D": "கூற்றுகள் 2, 4 சரி; 1, 3 தவறு"}, "explanation": "கூற்று 4 தவறானது; 'ஆழி' என்பதற்கு 'கடல்' என்பது பொருளாகும் ('பெருங்காற்று' அல்ல). மற்ற 1, 2, 3 கூற்றுகள் பாடநூல் சொல்லும் பொருளும் பகுதியில் உள்ளபடி முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'மல்லெடுத்த' என்பதற்கு 'வலிமை பெற்ற' என்பது பொருள்.", "content_en": null}, {"id": "S2", "content_ta": "'சமர்' என்பதற்குப் 'போர்' என்பது பொருள்.", "content_en": null}, {"id": "S3", "content_ta": "'நல்கும்' என்பதற்குத் 'தரும்' என்பது பொருள்.", "content_en": null}, {"id": "S4", "content_ta": "'ஆழி' என்பதற்குப் 'பெருங்காற்று' என்பது பொருள்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings