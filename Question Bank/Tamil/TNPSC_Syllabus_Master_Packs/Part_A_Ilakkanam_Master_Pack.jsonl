{"id": "11th_tamil_u5_q141", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "grammar_paa_vagaigal", "chapter_id": null, "topic_id": "four_paas_and_sounds", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் யாப்பிலக்கணத்தில் குறிப்பிடப்படும் நான்கு வகைப் பாக்கள் மற்றும் அவற்றிற்குரிய ஓசைகளுள் சரியான இணை எது?\n1. வெண்பா - செப்பல் ஓசை\n2. ஆசிரியப்பா - அகவல் ஓசை\n3. கலிப்பா - துள்ளல் ஓசை\n4. வஞ்சிப்பா - தூங்கல் ஓசை", "media_id": null}], "options": {"A": "1, 2, 3, 4 ஆகிய நான்கும் சரியானவை", "B": "1 மற்றும் 2 மட்டுமே சரி", "C": "2 மற்றும் 3 மட்டுமே சரி", "D": "1, 3, 4 மட்டுமே சரி"}, "explanation": "வெண்பாவுக்குரியது செப்பலோசை; ஆசிரியப்பாவுக்குரியது அகவலோசை; கலிப்பாவுக்குரியது துள்ளலோசை; வஞ்சிப்பாவுக்குரியது தூங்கலோசை ஆகும். இந்நான்கு இணைகளும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Which of the pairings between the four major Tamil poetic meters and their characteristic cadences is correct?\n1. Venba - Seppal Osai\n2. Asiriyappa - Agaval Osai\n3. Kalippa - Thullal Osai\n4. Vanjippa - Thoongal Osai", "media_id": null}], "options": {"A": "All four (1, 2, 3, 4) are correct", "B": "1 and 2 only", "C": "2 and 3 only", "D": "1, 3, 4 only"}, "explanation": "Venba has Seppal, Asiriyappa has Agaval, Kalippa has Thullal, and Vanjippa has Thoongal cadence. All four are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 121, "chapter": null, "section": null, "reference": "11th Tamil, Unit 5, Page 121", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 5", "Grammar", "Prosody"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u5_q142", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "grammar_paa_vagaigal", "chapter_id": null, "topic_id": "seppal_sound_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெண்பாவுக்குரிய 'செப்பல் ஓசை' என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "பாடி அழைப்பது போன்ற ஓசை", "B": "இருவர் உரையாடுவது போன்றும் விடை கூறுவது போன்றும் அமையும் ஓசை", "C": "கன்று துள்ளினாற் போன்ற தாள ஓசை", "D": "மெல்ல உறங்குவது போன்று தளர்ந்த ஓசை"}, "explanation": "செப்பல் என்றால் விடை தருதல் அல்லது சொல்வது என்று பொருள். இருவர் உரையாடுவது போன்றும் ஒருவர் வினவ மற்றொருவர் விடை சொல்வது போன்றும் அமைவது செப்பல் ஓசையாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the intrinsic nature of 'Seppal Osai' (conversational cadence) characteristic of Venba?", "media_id": null}], "options": {"A": "Chanting or calling out aloud", "B": "Resembling a conversational discourse or answering tone", "C": "Leaping cadence like a dancing calf", "D": "Languid cadence like drooping into slumber"}, "explanation": "'Seppal' means conversing or answering, characteristic of didactic discourse like Thirukkural."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services 