{"id": "11th_tamil_u4_q092", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_tholkappiya_paayiram", "chapter_id": null, "topic_id": "meaning_of_paayiram", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் இலக்கண மரபில் ‘பாயிரம்’ என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "முடிவுரை", "B": "அகராதி", "C": "அடிக்குறிப்பு", "D": "நூலின் முகவுரை அல்லது முன்னுரை (நூலை அறிமுகம் செய்யும் பகுதி)"}, "explanation": "பாயிரம் என்பது ஒரு நூலின் தொடக்கத்தில் அந்நூலின் ஆசிரியர், நோக்கம், பயன், அரங்கேற்றம் ஆகியவற்றை விளக்கித் தரும் முகவுரை/முன்னுரையாகும்."}, "en": {"blocks": [{"type": "text", "content": "In the classical Tamil tradition of textual exegesis, what does 'Paayiram' signify?", "media_id": null}], "options": {"A": "Epilogue index", "B": "Lexicographical glossary", "C": "Footnotes", "D": "Introductory Preface / Prolegomenon (Textual introduction)"}, "explanation": "Paayiram denotes the introductory preface or prolegomenon introducing an author, scope, and patron."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 85, "chapter": null, "section": null, "reference": "11t