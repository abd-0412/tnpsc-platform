{"id": "11th_tamil_u7_q124", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "poetry_pathitrupathu", "chapter_id": null, "topic_id": "pathitrupathu_structure_features", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பதிற்றுப்பத்தின் ஒவ்வொரு பாடலின் இறுதியிலும் இடம்பெறும் நான்கு முக்கிய இலக்கணக் குறிப்புகள் எவை?", "media_id": null}], "options": {"A": "திணை, துறை மட்டுமே", "B": "எதுகை, மோனை, இயைபு, முரண்", "C": "ஆசிரியர், மன்னன், நாடு, ஊர்", "D": "துறை, வண்ணம், தூக்கு, பாடலின் பெயர் (மற்றும் பாடியோர், பாடப்பட்டோர்)"}, "explanation": "பதிற்றுப்பத்தின் தனிச்சிறப்பு என்னவெனில், ஒவ்வொரு பாடலின் இறுதியிலும் துறை, வண்ணம், தூக்கு, பாடலின் பெயர் ஆகியவை தவறாது குறிப்பிடப்பட்டிருக்கும்."}, "en": {"blocks": [{"type": "text", "content": "Which four distinct metadata annotations conclude every single verse in Pathitrupathu?", "media_id": null}], "options": {"A": "Thinai and Thurai only", "B": "Rhyme, alliteration, cadence, and antithesis", "C": "Poet, king, country, town", "D": "Thurai (situation), Vannam (rhythm), Thookku (meter beat), and Title of the song"}, "explanation": "Every Pathitrupathu verse systematically notes its Thurai, Vannam, Thookku, and song title."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu 