{"id": "11th_tamil_u2_q152", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "grammar_punarchi_vithigal", "chapter_id": null, "topic_id": "makara_eetru_rule", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மரம் + வேர் = மரவேர்’ - இதில் செயல்பட்டுள்ள புணர்ச்சி விதி யாது?", "media_id": null}], "options": {"A": "இ ஈ ஐ வழி யவ்வும்", "B": "உயிர்வரின் உக்குறள் மெய்விட்டு ஓடும்", "C": "தனிக்குறில் முன் ஒற்று இரட்டும்", "D": "மவ்வீறு ஒற்றழிந்து உயிரீறாதல் (மகர ஈற்றுப் புணர்ச்சி)"}, "explanation": "நிலைமொழி ஈற்றில் மகர மெய் (ம்) வரும்போது, அது மறைந்து (கெட்டு) மர+வேர் = மரவேர் எனப் புணரும். இது 'மவ்வீறு ஒற்றழிந்து' விதியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which grammatical sandhi rule operates in 'Maram + vaer = Maravaer'?", "media_id": null}], "options": {"A": "I Ee Ai vazhi yavvum", "B": "Uyirvarin ukkural meivittu odum", "C": "Tanikkuril mun otru irattum", "D": "Mavveetru otrazhinthu uyireeraathal (Elision of terminal makaram)"}, "explanation": "Terminal makaram 'm' elides before an incoming consonant, yielding 'Maravaer'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 