{"id": "7th-t1-u3-275", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "ilakkana-kurippu-thaninila", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கணக் குறிப்புத் தருக:\n'சொந்த நிலம்' - இத்தொடரின் சரியான இலக்கணக் குறிப்பு யாது?"}], "options": {"A": "வினைத்தொகை", "B": "உவமைத்தொகை", "C": "பண்புத்தொகை", "D": "உரிச்சொற்றொடர்"}, "explanation": "இலக்கண விளக்கம்: சொந்தமாகிய நிலம் என 'ஆகிய' என்னும் பண்பு உருபு மறைந்து வந்து, நிலத்தின் உரிமைப் பண்பைச் சுட்டுவதால் இது 'பண்புத்தொகை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the grammatical category (Ilakkana Kurippu) of 'Sondha Nilam':"}], "options": {"A": "Vinaitthogai", "B": "Uvamaitthogai", "C": "Panbutthogai (பண்புத்தொகை)", "D": "Urichotrodar"}, "explanation": "Grammar explanation: Expands as 'Sondhamaagiya nilam', functioning as a Panbutthogai denoting possessive attribute."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 54, "chapter": null, "section": null, "reference": null, "url": null, "source_