{"id": "7th-t3-u1-q078", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-03-tirunelveli-seemaiyum-kavigalum", "chapter_id": null, "topic_id": "ta-t3-u1-grammar-ilakkana-kurippu-konjum", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கொஞ்சும்' என்னும் சொல்லின் சரியான இலக்கணக் குறிப்பைக் கண்டறிக:\n(குறவஞ்சி அடி: 'மந்தியொடு கொஞ்சும் மந்தி')"}], "options": {"A": "முதனிலைத் தொழிற்பெயர்", "B": "வினையாலணையும் பெயர்", "C": "வினையெச்சம்", "D": "பெயரெச்சம்"}, "explanation": "'கொஞ்சும் மந்தி': 'கொஞ்சும்' என்னும் எச்சவினை 'மந்தி' என்னும் பெயர்ச்சொல்லைக் கொண்டு முடிவதால் இது 'பெயரெச்சம்' (செய்யும் என்னும் வாய்பாட்டுப் பெயரெச்சம்) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the precise grammatical categorization (Ilakkana Kurippu) of 'Konjum' in 'Manthiyodu konjum manthi':"}], "options": {"A": "Primary verbal noun", "B": "Participial noun", "C": "Verbal participle (Vinaiyecham)", "D": "Relative participle (Peyarecham)"}, "explanation": "'Konjum' modifies the following noun 'Manthi', making it a Relative Participle (Peyarecham). Key D is correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational