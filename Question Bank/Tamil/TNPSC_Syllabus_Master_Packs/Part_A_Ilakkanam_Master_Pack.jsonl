{"id": "8th-u6-q840", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u8-manitham", "lesson_id": "8th-u6-l4", "chapter_id": null, "topic_id": "kadinagar-kadi-meaning-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கடிநகர்' என்னும் சொல்லில் இடம்பெற்றுள்ள 'கடி' என்னும் உரிச்சொல்லின் சரியான பொருள் யாது?"}], "options": {"A": "மணம் மிக்க நகர்", "B": "செல்வம் மிக்க நகர்", "C": "கல்வி மிக்க நகர்", "D": "காவல் மிக்க நகர்"}, "explanation": "பாடநூல் பக். 128 மதிப்பீடு: 'கடிநகர்' என்பதில் 'கடி' என்பது 'காவல்' (காவல் மிக்க நகர்) என்னும் பொருளை உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the exact meaning of the Urichol 'Kadi' in the compound 'Kadinagar'?"}], "options": {"A": "Fragrant city", "B": "Wealthy city", "C": "Educated city", "D": "Well-guarded / fortified city (Kaaval mikka nagar)"}, "explanation": "Textbook Page 128 Exercise: In 'Kadinagar', 'Kadi' denotes 'Kaaval' (strongly protected/guarded city)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 128, "chapter": null, "section": null, "reference": null, "