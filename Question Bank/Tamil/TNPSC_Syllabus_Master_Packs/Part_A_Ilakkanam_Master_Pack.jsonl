{"id": "9th-rev-q020", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l4", "chapter_id": null, "topic_id": "singaram-puyalilae-oru-thoni-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] 'புயலிலே ஒரு தோணி' என்ற புலம்பெயர் நாவலின் ஆசிரியர் ப. சிங்காரம் எந்த மாவட்டத்தைச் சேர்ந்தவர்?", "media_id": null}], "options": {"A": "மதுரை மாவட்டம்", "B": "இராமநாதபுரம் மாவட்டம்", "C": "புதுக்கோட்டை மாவட்டம்", "D": "சிவகங்கை மாவட்டம் (சிங்கம்புணரி)"}, "explanation": "ப. சிங்காரம் சிவகங்கை மாவட்டம் சிங்கம்புணரியைச் சேர்ந்தவர். இவர் தம் வாழ்நாள் சேமிப்பான ஏழரை இலட்ச ரூபாயை மாணவர் கல்விக்கு வழங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Writer Pa. Singaram, author of 'Puyalilae Oru Thoni', belonged to which district in Tamil Nadu?", "media_id": null}], "options": {"A": "Madurai district", "B": "Ramanathapuram district", "C": "Pudukkottai district", "D": "Sivagangai district (Singampunari - சிவகங்கை)"}, "explanation": "Pa. Singaram hailed from Singampunari in Sivagangai district."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 186, "chapter": null,