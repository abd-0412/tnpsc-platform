{"id": "11th_tamil_u5_q147", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "grammar_paa_vagaigal", "chapter_id": null, "topic_id": "nerisai_venba_structure", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நான்கு அடிகளைக் கொண்டு, இரண்டாம் அடியில் தனிச்சொல் பெற்று, முதல் இரண்டு அடிகளும் பின்னிரண்டு அடிகளும் தனித்தனி எதுகை அமைப்பில் வருவது எந்த வகை வெண்பா?", "media_id": null}], "options": {"A": "இன்னிசை வெண்பா", "B": "பஃறொடை வெண்பா", "C": "நேரிசை வெண்பா", "D": "குறள் வெண்பா"}, "explanation": "நான்கு அடிகளாய், இரண்டாம் அடியின் இறுதியில் தனிச்சொல் பெற்று, முதலிரண்டு அடிகளும் பின்னிரண்டு அடிகளும் எதுகை நயத்துடன் அமைவது நேரிசை வெண்பா எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Which type of Venba consists of 4 lines, possesses a Thanichol (isolated word) at the end of the second line, and has rhyming couplets?", "media_id": null}], "options": {"A": "Innisai Venba", "B": "Pakrodai Venba", "C": "Nerisai Venba", "D": "Kural Venba"}, "explanation": "A 4-line Venba with a Thanichol at line 2 and dual rhyme schemes is called Nerisai Venba."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "