{"id": "11th_tamil_u5_q173", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thirukkural_and_pyq", "chapter_id": null, "topic_id": "pyq_anandarangar_period", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] ஆனந்தரங்கர் நாட்குறிப்பு எந்தக் காலகட்டத்து வரலாற்று நிகழ்வுகளை விரிவாகப் படம் பிடித்துக் காட்டுகிறது?", "media_id": null}], "options": {"A": "1736 முதல் 1761 வரையிலான 25 ஆண்டு கால நிகழ்வுகள்", "B": "1600 முதல் 1650 வரையிலான நிகழ்வுகள்", "C": "1800 முதல் 1825 வரையிலான நிகழ்வுகள்", "D": "1700 முதல் 1715 வரையிலான நிகழ்வுகள்"}, "explanation": "ஆனந்தரங்கர் 1736 செப்டம்பர் 6 முதல் 1761 ஜனவரி 11 வரை ஏறத்தாழ 25 ஆண்டுகள் புதுச்சேரி வரலாற்று நிகழ்வுகளைத் துல்லியமாகப் பதிவு செய்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Which specific period of South Indian history does Anandarangar's diary chronicle?", "media_id": null}], "options": {"A": "25-year span from 1736 to 1761", "B": "1600 to 1650", "C": "1800 to 1825", "D": "1700 to 1715"}, "explanation": "Anandarangar's diary meticulously spans 25 continuous years from 1736 to 1761."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition"