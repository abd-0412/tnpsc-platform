{"id": "9th-u8-q154", "schema_version": "1.0", "kind": "factual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l1", "chapter_id": null, "topic_id": "periyar-periodicals-chronology", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தந்தை பெரியார் தோற்றுவித்து நடத்திய இதழ்களை அவை தொடங்கப்பட்ட காலவரிசைப்படி சரியாகக் குறிப்பிடும் வரிசை எது?", "media_id": null}], "options": {"A": "விடுதலை (1925) -> புரட்சி (1930) -> குடியரசு (1935)", "B": "குடியரசு (1925) -> புரட்சி (1933) -> பகுத்தறிவு (1934) -> விடுதலை (1935)", "C": "பகுத்தறிவு (1925) -> விடுதலை (1928) -> குடியரசு (1935)", "D": "குடியரசு (1935) -> விடுதலை (1940) -> புரட்சி (1945)"}, "explanation": "பெரியார் நடத்திய இதழ்கள்: குடியரசு (1925), Revolt (1928), புரட்சி (1933), பகுத்தறிவு (1934), விடுதலை (1935). எனவே சரியான காலவரிசை 'குடியரசு -> புரட்சி -> பகுத்தறிவு -> விடுதலை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which option correctly arranges the journals launched and edited by Thanthai Periyar in chronological order?", "media_id": null}], "options": {"A": "Viduthalai (1925) -> Puratchi (1930) -> Kudiyarasu (1935)", "B": "Kudiyarasu (1925) -> Puratchi (1933) -> Pagutharivu (1934) -> Viduthalai (1935)", "C": "Pagutharivu (1925) -> Viduthalai (1928) -> Kudiyarasu (1935)", "D": "Kudiyarasu (1935) -> Viduthalai (1940) -> Puratchi (1945)"}, "explanation": "Periyar launched Kudiyarasu in 1925, Puratchi in 1933, Pagutharivu in 1934, and Viduthalai in 1935."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, 