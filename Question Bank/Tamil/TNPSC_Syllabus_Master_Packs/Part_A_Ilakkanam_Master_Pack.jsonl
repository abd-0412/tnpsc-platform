{"id": "11th_tamil_u2_q181", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "revision_unit_2", "chapter_id": null, "topic_id": "kural_food_rain", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘துப்பார்க்குத் துப்பாய துப்பாக்கித் துப்பார்க்குத் / துப்பாய தூஉம் மழை’ - இக்குறளில் இடம்பெற்றுள்ள ‘துப்பு’ என்னும் சொல் தரும் மூன்று பொருள்கள் எவை?", "media_id": null}], "options": {"A": "உண்பவர், உணவு, நல்ல நன்மை (சுவை)", "B": "துப்பாக்கி, தோட்டா, வீரன்", "C": "தூய்மை, வெண்மை, வெளிச்சம்", "D": "மண், காற்று, நெருப்பு"}, "explanation": "இக்குறளில் துப்பு என்பது உண்பவர்க்கு (துப்பார்க்கு), உணவாகி (துப்பாய), நன்மையையும் உணவையும் தரும் (தூஉம்) மழையைக் குறிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What three meanings does the polysemic word 'Thuppu' signify across the verse 'Thuppaarkkuth thuppaaya thuppaakkith thuppaarkkuth thuppaaya thoouum mazhai'?", "media_id": null}], "options": {"A": "Eater / consumer, wholesome food, and life-giving nourishment / benefit", "B": "Gun, bullet, and soldier", "C": "Purity, whiteness, and illumination", "D": "Soil, air, and fire"}, "explanation": "'Thuppu' poetically signifies the consumer, the food created, and the beneficial sustenance bestowed by rain."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil N