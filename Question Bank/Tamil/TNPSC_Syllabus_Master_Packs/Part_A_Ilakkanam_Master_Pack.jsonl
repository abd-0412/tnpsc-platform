{"id": "10th-u1-q131", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "eluthu_sol", "chapter_id": null, "topic_id": "ethirmarai_thozhirpeyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"நடவாமை, கொல்லாமை\" என்பன எவ்வகைத் தொழிற்பெயர்கள்?", "media_id": null}], "options": {"A": "முதனிலைத் தொழிற்பெயர்", "B": "முதனிலை திரிந்த தொழிற்பெயர்", "C": "எதிர்மறைத் தொழிற்பெயர்", "D": "வினையாலணையும் பெயர்"}, "explanation": "எதிர்மறைப் பொருளில் வரும் தொழிற்பெயர் எதிர்மறைத் தொழிற்பெயர் எனப்படும் (எ.கா: நடவாமை, கொல்லாமை)."}, "en": {"blocks": [{"type": "text", "content": "What type of verbal nouns are \"Nadavaamai\" and \"Kollaamai\"?", "media_id": null}], "options": {"A": "Primary verbal noun", "B": "Modified primary verbal noun", "C": "Negative verbal noun (Ethirmarai Thozhirpeyar)", "D": "Participial noun"}, "explanation": "They represent negative verbal nouns denoting the negation/abstention of the action."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 17, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 17", "url": null, "source_notes": null}, "previous_year": {"is_