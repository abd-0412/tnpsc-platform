{"id": "9th-rev-q018", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u9", "lesson_id": "9th-tamil-u9-l1", "chapter_id": null, "topic_id": "thaninayagam-iatr-founding-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] உலகத் தமிழாராய்ச்சி மன்றம் (IATR) என்னும் பன்னாட்டு அமைப்பை 1964-இல் புதுதில்லியில் தோற்றுவித்தவர் யார்?", "media_id": null}], "options": {"A": "உ. வே. சாமிநாதையர்", "B": "தனிநாயக அடிகள் (Father Xavier Thaninayagam)", "C": "மறைமலையடிகள்", "D": "திரு. வி. க."}, "explanation": "தனிநாயக அடிகள் 1964-இல் உலகத் தமிழாராய்ச்சி மன்றத்தை (IATR) உருவாக்கி, அதன் வாயிலாக உலகத் தமிழாராய்ச்சி மாநாடுகளைத் தொடக்கி வைத்தார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Who founded the International Association of Tamil Research (IATR) in New Delhi in 1964?", "media_id": null}], "options": {"A": "U. V. Swaminatha Iyer", "B": "Father Xavier Thaninayagam (தனிநாயக அடிகள்)", "C": "Maraimalai Adigal", "D": "Thiru. Vi. Ka."}, "explanation": "Father Thaninayagam founded IATR in 1964."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 176, "chapter": null, "section": null, "reference": "