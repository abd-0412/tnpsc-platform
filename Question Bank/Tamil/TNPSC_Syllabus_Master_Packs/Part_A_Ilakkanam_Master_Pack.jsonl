{"id": "6th-t3-u1-039", "schema_version": "1.0", "kind": "match_4x4", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாஞ்சை வளம் வரிகளில் அமைந்த நயங்களைப் பொருத்துக:\n(a) சுத்தவீர - கட்டபொம்மு - 1. இறுதி இயைபு\n(b) வாரணம் - பரி - 2. மோனை நயம்\n(c) தண்ணீர்தான் - குடித்தாற்போல் - 3. எதுகை நயம்\n(d) வீடுகளாம் - மேடைகளாம் - 4. சொல்லாட்சி நயம்", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-4, (b)-1, (c)-2, (d)-3", "C": "(a)-3, (b)-4, (c)-2, (d)-1", "D": "(a)-2, (b)-3, (c)-1, (d)-4"}, "explanation": "சுத்தவீர / கட்டபொம்மு - இரண்டாம் எழுத்து 'த்'/'ட்' (எதுகை); வாரணம் / பரி - யானை, குதிரை குறிக்கும் சொல்லாட்சி; வீடுகளாம் / மேடைகளாம் - இறுதி ஓசை இயைபு."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "3", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6 Tamil Term 3, Unit 1 - பாஞ்சை