{"id": "7th-t3-u3-q329", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u3-maanudam", "lesson_id": "lesson-14-vina-vidai", "chapter_id": null, "topic_id": "ta-t3-u3-vina-application-seerudai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆசிரியர் பள்ளி மாணவர்களைப் பார்த்து, 'உங்களுள் யாருக்குப் புதிய பாடப்புத்தகம் இல்லை?' என்று அவர்களுக்குக் கொடுக்கும் நோக்கில் கேட்பது எவ்வகை வினா ஆகும்?"}], "options": {"A": "கொடை வினா", "B": "கொளல் வினா", "C": "அறியாவினா", "D": "ஐயவினா"}, "explanation": "பிறருக்கு ஒரு பொருளைக் கொடுத்து உதவும் பொருட்டுக் கேட்கப்படும் வினா 'கொடை வினா' எனப்படும். இங்கு மாணவர்களுக்குப் புத்தகம் கொடுக்கும் நோக்கில் ஆசிரியர் கேட்பதால் இது கொடை வினா ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "When a teacher asks students 'Who among you does not have a new textbook?' intending to provide books, what kind of question is it?"}], "options": {"A": "Kodai Vinaa", "B": "Kolal Vinaa", "C": "Ariyaavinaa", "D": "Aiyyavinaa"}, "explanation": "A question posed with the intention of gifting or providing help is Kodai Vinaa. Hence Option A is correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "c