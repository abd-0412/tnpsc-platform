{"id": "12th_tamil_u5_q905", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "padimam", "chapter_id": null, "topic_id": "olfactory_image_example", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘முதல் மழையின் மண்வாசனை’, ‘மல்லிகையின் நறுமணம்’ ஆகியவற்றை உணர்த்தும் படிமம் எது?", "media_id": null}], "options": {"A": "மணப் படிமம் (Olfactory Image)", "B": "ஒலிப் படிமம்", "C": "தொடு படிமம்", "D": "சுவைப் படிமம்"}, "explanation": "மூக்கினால் நுகரப்படும் நறுமணம், துர்நாற்றம் உள்ளிட்ட நுகர்ச்சி உணர்வுகளைத் தூண்டுவது 'மணப் படிமம்' (Olfactory Image) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which sensory image conveys fragrances like petrichor of parched earth after rainfall or blooming jasmine?", "media_id": null}], "options": {"A": "Olfactory Image (Manap Padimam)", "B": "Auditory image", "C": "Tactile image", "D": "Gustatory image"}, "explanation": "Olfactory imagery appeals to the reader's sense of smell."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 120, "chapter": null, "section": null, "reference": "12th Tamil, Unit 5, Page 120", "url": null, "source_notes": null}, "previous