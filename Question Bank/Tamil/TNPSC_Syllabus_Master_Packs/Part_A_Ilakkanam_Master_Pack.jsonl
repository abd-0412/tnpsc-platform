{"id": "12th_tamil_u1_q130", "schema_version": "1.0", "kind": "grammar_identification", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamizhaai_ezhuthuvom", "chapter_id": null, "topic_id": "sandhi_hard_stop", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அங்கு, இங்கு, எங்கு’ என்னும் சொற்களுக்குப் பின் வல்லினம் என்னவாகும்?", "media_id": null}], "options": {"A": "எப்போதும் மிகாது", "B": "வல்லினம் கண்டிப்பாக மிகும் (எ.கா: அங்குக் கண்டேன், இங்குக் கொடுத்தான்)", "C": "மெல்லினமாகும்", "D": "இடைவினையாகும்"}, "explanation": "அங்கு, இங்கு, எங்கு என்னும் இடஞ்சுட்டுச் சொற்களின் பின் வரும் வல்லினம் கண்டிப்பாக மிகும் (அங்குக் கண்டான், இங்குக் பார்த்தான்)."}, "en": {"blocks": [{"type": "text", "content": "What sandhi behavior occurs following locative adverbs Angu, Ingu, Engu?", "media_id": null}], "options": {"A": "Never doubles", "B": "Vallinam mandatorily doubles (e.g., Anguk kanden, Inguk koduthaan)", "C": "Becomes nasal", "D": "Converts to particle"}, "explanation": "Locative demonstrative adverbs terminating in hard syllables strictly double subsequent plosives."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 14, "chapter": null, "secti