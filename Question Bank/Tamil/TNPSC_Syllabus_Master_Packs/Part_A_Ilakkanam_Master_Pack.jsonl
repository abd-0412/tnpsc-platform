{"id": "6th-t2-u1-017", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'பாட்டிசைத்துப் பாடினாலும் தாலாட்டுப் பாடல் குழந்தையின் உறக்கத்தை எளிதாக்குகிறது.'\nகாரணம் (R): 'பாட்டிசைத்து' என்னும் சொல்லைப் பிரித்தெழுதும்போது 'பாட்டு + இசைத்து' எனப் புணர்கிறது.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சொல்லின் புணர்ச்சியைச் சரியாக விளக்குகிறது.", "B": "கூற்று சரி, காரணம் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "பாட்டு + இசைத்து = பாட்டிசைத்து (உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி ட் + இ = டி). நூல் மதிப்பீட்டுப் பகுதியில் கேட்கப்பட்டுள்ள புணர்ச்சி வினா."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'பாட்டிசைத்துப் பாடினாலும் தாலாட்டுப் பாடல் குழந்தையின் உறக்கத்தை எளிதாக்குகிறது.'", "reason": "'பாட்டிசைத்து' என்னும் சொல்லைப் பிரித்தெழுதும்போது 'பாட்டு + இசைத்து' எனப் புணர்கிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 4", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u1-016", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): அதியமான் தான் உண்டால் நெடுங்காலம் வாழலாம் என்று தெரிந்தும் அரிய நெல்லிக்கனியை ஔவையாருக்கு ஈந்தான்.\nகாரணம் (R): அதியமான் அரச பதவியைத் துறந்து காடுகளுக்குச் சென்று துறவறம் பூண விரும்பியதால் அக்கனியைப் புறக்கணித்தான்.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி.", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) முற்றிலும் தவறு.", "C": "கூற்று (A) தவறு, காரணம் (R) சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறானவை."}, "explanation": "கூற்று சரி, காரணம் தவறு. அதியமான் துறவறம் செல்ல விரும்பவில்லை; தான் வாழ்வதைவிடத் தமிழறிவும் புலமையும் மிக்க ஔவையார் நெடுங்காலம் வாழ்ந்தால் தமிழ் தழைக்கும், மக்கள் நலம் பெறுவர் என்ற உயர்ந்த நோக்கிலேயே அக்கனியை அளித்தான்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "அதியமான் தான் உண்டால் நெடுங்காலம் வாழலாம் என்று தெரிந்தும் அரிய நெல்லிக்கனியை ஔவையாருக்கு ஈந்தான்.", "reason": "அதியமான் அரச பதவியைத் துறந்து காடுகளுக்குச் சென்று துறவறம் பூண விரும்பியதால் அக்கனியைப் புறக்கணித்தான்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 10", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u1-013", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கண்மணியே கண்ணுறங்கு' தாலாட்டுப் பாடல் குறித்த கூற்றுகளை ஆராய்க:\n1. தாலாட்டு என்பது வாய்மொழி இலக்கியங்களுள் ஒன்றாகும்.\n2. தால் என்பதற்கு 'நாக்கு' என்று பொருள்; நாவை அசைத்துப் பாடுவதால் தாலாட்டு (தால் + ஆட்டு) எனப் பெயர் பெற்றது.\n3. குழந்தையின் அழுகையை நிறுத்தவும், தூங்க வைக்கவும் இனிய ஓசையுடன் பாடப்படும் பாடல் தாலாட்டு ஆகும்.\n4. இப்பாடலில் பல்லவ மன்னர்களின் வீரம் மட்டுமே சிறப்பாகப் பாடப்பட்டுள்ளது.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "C": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "கூற்று 4 தவறானது; இப்பாடலில் சேர, சோழ, பாண்டிய மன்னர்களின் சிறப்புகளும் வளங்களுமே பாடப்பட்டுள்ளன (சேர நாட்டின் முத்தேன், சோழ நாட்டின் முக்கனி, பாண்டிய நாட்டின் முத்தமிழ்). பல்லவர்கள் பற்றிப் பாடப்படவில்லை."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "தாலாட்டு என்பது வாய்மொழி இலக்கியங்களுள் ஒன்றாகும்.", "content_en": null}, {"id": "S2", "content_ta": "தால் என்பதற்கு 'நாக்கு' என்று பொருள்; நாவை அசைத்துப் பாடுவதால் தாலாட்டு (தால் + ஆட்டு) எனப் பெயர் பெற்றது.", "content_en": null}, {"id": "S3", "content_ta": "குழந்தையின் அழுகையை நிறுத்தவும், தூங்க வைக்கவும் இனிய ஓசையுடன் பாடப்படும் பாடல் தாலாட்டு ஆகும்.", "content_en": null}, {"id": "S4", "content_ta": "இப்பாடலில் பல்லவ மன்னர்களின் வீரம் மட்டுமே சிறப்பாகப் பாடப்பட்டுள்ளது.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 4", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u1-010", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆசாரக்கோவை கூறும் நல்ஒழுக்க விதைகளுள் பொருந்தாத ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "நன்றியறிதல்", "B": "பொறையுடைமை", "C": "ஒப்புரவு", "D": "புலால் உண்ணாமை"}, "explanation": "'புலால் உண்ணாமை' என்பது திருக்குறள் மற்றும் ஆசாரக்கோவையின் பிற பாடல்களில் வந்தாலும், இப்பாடலில் கூறப்பட்டுள்ள எட்டு நல்லொழுக்க விதைகளுள் இடம்பெறவில்லை. இப்பாடலில் நன்றியறிதல், பொறையுடைமை, இன்சொல், இன்னா செய்யாமை, கல்வி, ஒப்புரவு, அறிவுடைமை, நல்லினத்தாரோடு நட்டல் ஆகிய எட்டே கூறப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": true, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exa