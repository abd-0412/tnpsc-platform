{"id": "9th-u8-q155", "schema_version": "1.0", "kind": "factual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l6", "chapter_id": null, "topic_id": "marabuthodar-aagaya-thamarai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மொழியோடு விளையாடு: 'ஆகாயத் தாமரை' என்னும் மரபுத்தொடர் உணர்த்தும் சரியான பொருள் யாது?", "media_id": null}], "options": {"A": "வானில் பூக்கும் அழகிய மலர்", "B": "எளிதில் பெறக்கூடிய அரிய பொருள்", "C": "இல்லாத ஒன்று (ஒருபோதும் நிகழாத ஒன்று)", "D": "விரைவில் வாடிப் போகும் மலர்"}, "explanation": "'ஆகாயத் தாமரை' என்பது உலகில் நடைமுறையில் இல்லாத - ஒருபோதும் நிகழ முடியாத பொருளைக் குறிக்கப் பயன்படும் தமிழ் மரபுத்தொடராகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the figurative meaning of the Tamil idiom 'Aagaya Thaamarai' (ஆகாயத் தாமரை)?", "media_id": null}], "options": {"A": "A celestial lotus flower", "B": "Something easily obtainable", "C": "Something nonexistent / An impossible entity (இல்லாத ஒன்று)", "D": "A flower that quickly withers"}, "explanation": "'Aagaya Thaamarai' figuratively denotes something that does not exist in reality."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-202