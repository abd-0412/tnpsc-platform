{"id": "12th_tamil_u1_q148", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "mozhi_thiran", "chapter_id": null, "topic_id": "idioms_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்காணும் மரபுத்தொடர்களில் தவறான பொருளைக் குறிக்கும் இணையைத் தேர்க:", "media_id": null}], "options": {"A": "ஆகாயத் தாமரை - இல்லாத ஒன்று", "B": "கானல் நீர் - பயனற்ற ஒன்று அல்லது பொய்த்தோற்றம்", "C": "கிணற்றுத் தவளை - உலகறியாத நிலை", "D": "அச்சாணி போன்றது - நிலையற்ற தன்மை"}, "explanation": "‘அச்சாணி போன்றது’ என்பது இன்றியமையாத முதன்மை ஆதாரத்தைக் குறிக்கும். ‘நிலையற்ற தன்மை’ என்பது தவறான விளக்கமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the idiom that has been matched with an incorrect meaning:", "media_id": null}], "options": {"A": "Akaya Thamarai - Non-existent entity", "B": "Kanal Neer - Mirage or illusion", "C": "Kinattruth Thavalai - Lacking world knowledge", "D": "Achani Pondrathu - Instability"}, "explanation": "'Achani pondrathu' signifies an indispensable linchpin/support, not instability."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 18, "chapter": null, "sectio