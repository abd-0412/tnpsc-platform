{"id": "10th-u6-q134", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "agapporul_ilakkanam", "chapter_id": null, "topic_id": "marutham_neithal_sirupozhuthu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மருதத் திணைக்குரிய சிறுபொழுதும், நெய்தல் திணைக்குரிய சிறுபொழுதும் முறையே எவை?", "media_id": null}], "options": {"A": "மாலை, யாமம்", "B": "வைகறை (விடியல் - மருதம்) மற்றும் எற்பாடு (சூரியன் சாயும் பிற்பகல் - நெய்தல்)", "C": "நண்பகல், காலை", "D": "காலை, நண்பகல்"}, "explanation": "மருதத்தின் சிறுபொழுது \"வைகறை\" (விடியல் உழவு தொடங்கும் நேரம்); நெய்தலின் சிறுபொழுது \"எற்பாடு\" (மீனவர் கரை திரும்பும் பிற்பகல் நேரம்)."}, "en": {"blocks": [{"type": "text", "content": "What are the designated Sirupozhuthu micro-times for Marutham and Neithal respectively?", "media_id": null}], "options": {"A": "Maalai, Yaamam", "B": "Vaikarai (Dawn - Marutham) and Erpaadu (Afternoon sunset - Neithal)", "C": "Nanpagal, Kaalai", "D": "Kaalai, Nanpagal"}, "explanation": "Marutham aligns with pre-dawn (Vaikarai) and Neithal with afternoon (Erpaadu)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 142, "chapter