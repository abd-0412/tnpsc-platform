{"id": "6th-t2-u1-067", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மொழி இறுதி எழுத்துகளின் மொத்த எண்ணிக்கை மற்றும் வகைகள் குறித்த கூற்றுகளை ஆராய்க:\n1. மொழி இறுதியில் வரும் உயிரெழுத்துகள் (உயிர்மெய்யாக) = 12.\n2. மொழி இறுதியில் வரும் மெய்யெழுத்துகள் = 11.\n3. மொழி இறுதியில் வரும் குற்றியலுகரம் = 1.\n4. இவை தவிர ஆய்த எழுத்தும் சொல்லின் இறுதியில் வரும்.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "C": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "கூற்று 4 தவறானது; ஆய்த எழுத்து சொல்லின் இறுதியில் ஒருபோதும் வராது. மொழி இறுதி எழுத்துகள் மொத்தம் 24 (உயிர் 12 + மெய் 11 + குற்றியலுகரம் 1)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "மொழி இறுதியில் வரும் உயிரெழுத்துகள் (உயிர்மெய்யாக) = 12.", "content_en": null}, {"id": "S2", "content_ta": "மொழி இறுதியில் வரும் மெய்யெழுத்துகள் = 11.", "content_en": null}, {"id": "S3", "content_ta": "மொழி இறுதியில் வரும் குற்றியலுகரம் = 1.", "content_en": null}, {"id": "S4", "content_ta": "இவை தவிர ஆய்த எழுத்தும் சொல்லின் இறுதியில் வரும்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_quest