{"id": "10th-u2-q141", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "thogainilai_thodargal", "chapter_id": null, "topic_id": "vinaithogai_def", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காலம் காட்டும் இடைநிலையும் பெயரெச்ச விகுதியும் மறைந்து நிற்க, வினைப்பகுதியைத் தொடர்ந்து ஒரு பெயர்ச்சொல் வந்து ஒரு சொல் போல் அமைவது எது?", "media_id": null}], "options": {"A": "வினைத்தொகை", "B": "பண்புத்தொகை", "C": "உவமைத்தொகை", "D": "உம்மைத்தொகை"}, "explanation": "காலம் கரந்த பெயரெச்சமே வினைத்தொகை ஆகும் (நன்னூல்: காலம் கரந்த பெயரெச்சம் வினைத்தொகை)."}, "en": {"blocks": [{"type": "text", "content": "What compound is formed when a verbal root is juxtaposed with a noun while tense markers and adjectival participle suffixes are elided?", "media_id": null}], "options": {"A": "Vinaithogai (Verbal compound / Concealed tense participle)", "B": "Panbuthogai", "C": "Uvamaithogai", "D": "Ummaithogai"}, "explanation": "Nannool defines Vinaithogai as an adjectival participle whose tense is concealed."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "reference": "10th Tami