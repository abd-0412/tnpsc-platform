{"id": "11th_tamil_rev2_q161", "schema_version": "1.0", "kind": "grammar_identification", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u8_grammar_mega_test", "chapter_id": null, "topic_id": "aakkappeyar_valar_suffix", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘வாணர்’ என்னும் பின்னொட்டால் உருவாக்கப்படும் ஆக்கப்பெயருக்குச் சான்று எது?", "media_id": null}], "options": {"A": "நகரவாணர், காட்டுவாணர், உலகவாணர்", "B": "படிப்பகம்", "C": "வண்டிக்காரன்", "D": "தோட்டக்காரி"}, "explanation": "நகரம் + வாணர் = நகரவாணர் (நகரத்தில் வாழ்பவர்); காடு + வாணர் = காட்டுவாணர் என வசிப்பிடத்தைக் குறிக்கும் 'வாணர்' பின்னொட்டு ஆக்கப்பெயர்களை அமைக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "Which words represent derivative nominals carrying the habitational suffix '-Vaanar' (dwellers)?", "media_id": null}], "options": {"A": "Nagaravaanar, Kaattuvaanar, Ulagavaanar", "B": "Padippagam", "C": "Vandikkaaran", "D": "Thottakkaari"}, "explanation": "The archaic bound nominalizer '-Vaanar' productively denotes inhabitants or residents."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 191, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 191", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 2", "Aakkappeyar", "Inhabitant Suffix"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev2_q162", "schema_version": "1.0", "kind": "grammar_identification", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u8_grammar_mega_test", "chapter_id": null, "topic_id": "mayangoli_ara_ara", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அறம்’ மற்றும் ‘அரம்’ ஆகிய சொற்களின் சரியான பொருள் யாது?", "media_id": null}], "options": {"A": "அறம் = இரும்பை அறுக்கும் கருவி ; அரம் = தருமம்", "B": "அறம் = தருமம்/நற்செயல் ; அரம் = இரும்பை அல்லது மரத்தைத் தேய்க்கும் கருவி", "C": "அறம் = நீர் ; அரம் = காற்று", "D": "அறம் = மலை ; அரம் = காடு"}, "explanation": "வல்லின 'ற' அமைந்த 'அறம்' என்பது தருமம், ஒழுக்கம்; இடையின 'ர' அமைந்த 'அரம்' என்பது இரும்பு, மரத்தைத் தேய்த்துச் சீராக்கும் கருவியாகும்."}, "en": {"blocks": [{"type": "text", "content": "Distinguish the semantic meaning of homophones 'Aram' (ற) and 'Aram' (ர):", "media_id": null}], "options": {"A": "Aram (ற) = File tool ; Aram (ர) = Virtue", "B": "Aram (ற) = Moral virtue / Dharma ; Aram (ர) = Rasp / Metal filing file", "C": "Aram = Water ; Aram = Air", "D": "Aram = Mountain ; Aram = Forest"}, "explanation": "Aram with alveolar ற means virtue/righteousness; Aram with medial ர means a filing/sharpening rasp tool."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textboo