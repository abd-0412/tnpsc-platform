{"id": "9th-u2-q143", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-05-evaluation-and-pyq", "chapter_id": null, "topic_id": "topic-iyal2-evaluation-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூல் பலவுள் தெரிக: சரியான தொடர்களைத் தெரிவு செய்க.\n௧) நீரின்று அமையாது உலகு - திருவள்ளுவர்\n௨) நீரின்று அமையாது யாக்கை - ஔவையார்\n௩) மாமழை போற்றுதும் - இளங்கோவடிகள்", "media_id": null}], "options": {"A": "௧, ௨, ௩ அனைத்தும் சரி", "B": "௨, ௩ மட்டும் சரி", "C": "௧, ௩ மட்டும் சரி", "D": "௧, ௨ மட்டும் சரி"}, "explanation": "'நீரின்று அமையாது உலகு' என்றவர் திருவள்ளுவர் (சரி); 'மாமழை போற்றுதும்' என்றவர் இளங்கோவடிகள் (சரி); 'நீரின்று அமையா யாக்கைக்கு எல்லாம்' என்றவர் குடபுலவியனார் (ஔவையார் அன்று, எனவே ௨ தவறு). ஆகவே ௧, ௩ சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Textbook Evaluation: Select the correctly matched statements:\n1. Neerindru amaiyaadhu ulagu - Thiruvalluvar\n2. Neerindru amaiyaadhu yaakkai - Avvaiyar\n3. Maamazhai poattrudhum - Ilango Adigal", "media_id": null}], "options": {"A": "All 1, 2, 3 are correct", "B": "2 and 3 only are correct", "C": "1 and 3 only are correct", "D": "1 and 2 only are correct"}, "explanation": "Statement 2 is incorrect because 'Neerindru amaiyaa yaakkai' was sung by Kudapulaviyanaar in Purananuru, not Avvaiyar. Thus 1 and 3 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks"