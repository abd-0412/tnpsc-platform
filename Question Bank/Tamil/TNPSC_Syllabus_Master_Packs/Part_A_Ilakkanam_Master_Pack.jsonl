{"id": "9th-u2-q134", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-04-pagupadha-uruppilakkanam", "chapter_id": null, "topic_id": "topic-pagupadha-uruppilakkanam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பதிற்றுப்பத்து' என்னும் சங்க இலக்கிய நூற்பெயரில் பயின்று வந்துள்ள சாரியை எது?", "media_id": null}], "options": {"A": "அற்று", "B": "இற்று", "C": "அத்து", "D": "இன்"}, "explanation": "பத்து + பத்து = பதிற்றுப்பத்து. இதில் 'இற்று' என்னும் சாரியை பயின்று வந்துள்ளது (பத்து + இற்று + பத்து = பதிற்றுப்பத்து)."}, "en": {"blocks": [{"type": "text", "content": "Which Saariyai particle is embedded in the compound classical title 'Pathitruppatthu'?", "media_id": null}], "options": {"A": "Atru", "B": "Itru", "C": "Atthu", "D": "In"}, "explanation": "'Itru' is the medial connective particle occurring in Pathu + itru + pathu = Pathitruppatthu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 41", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9th_tamil", "iyal_2", "grammar", "pagupadham", "uruppilakkanam"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "9th-u2-q135", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-04-pagupadha-uruppilakkanam", "chapter_id": null, "topic_id": "topic-pagupadha-uruppilakkanam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வாரான்' மற்றும் 'செய்யான்' ஆகிய சொற்களில் பயின்று வந்துள்ள 'ஆ' என்பது எவ்வகை உறுப்பு?", "media_id": null}], "options": {"A": "எதிர்கால இடைநிலை", "B": "பெயரெச்ச விகுதி", "C": "எதிர்மறை இடைநிலை", "D": "சாரியை"}, "explanation": "இல், அல், ஆ என்பன எதிர்மறை இடைநிலைகள் ஆகும். (எ.கா. செய்யான் = செய் + ய் + ஆ + ஆன்; இதில் 'ஆ' எதிர்மறை இடைநிலை)."}, "en": {"blocks": [{"type": "text", "content": "What type of grammatical constituent is 'aa' in words like 'Vaaraan' and 'Seyyaan'?", "media_id": null}], "options": {"A": "Future tense medial", "B": "Relative participle suffix", "C": "Negative medial marker (Ethirmarai Idainilai)", "D": "Saariyai increment"}, "explanation": "'Il', 'Al', and 'Aa' serve as negative medial infixes; 'aa' indicates negation in Seyyaan (Sey + y + aa + aan)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "refer