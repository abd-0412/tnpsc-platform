{"id": "9th-u8-q114", "schema_version": "1.0", "kind": "factual", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l5", "chapter_id": null, "topic_id": "yaappu-ezhuthu-types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "யாப்பிலக்கண அடிப்படையில் எழுத்துகள் எத்தனை வகைப்படும்?", "media_id": null}], "options": {"A": "இரண்டு", "B": "மூன்று (குறில், நெடில், ஒற்று)", "C": "நான்கு", "D": "ஐந்து"}, "explanation": "யாப்பிலக்கண அடிப்படையில் எழுத்துகள் குறில், நெடில், ஒற்று என மூவகைப்படும். மெய்யெழுத்துகளும் ஆய்த எழுத்தும் ஒற்று எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Into how many phonetic categories are letters classified in Tamil metric prosody?", "media_id": null}], "options": {"A": "Two", "B": "Three (Kuril - short, Nedil - long, Otru - consonant/aytham)", "C": "Four", "D": "Five"}, "explanation": "Prosody classifies all graphemes strictly into three categories: short vowels, long vowels, and consonants/aytham (Otru)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 164, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 164", "url": null, "source_notes": null}, "previous_year": {"is_