{"id": "11th_tamil_rev1_q130", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_supp_grammar", "chapter_id": null, "topic_id": "pagupatham_sentrana", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'சென்றன' என்னும் பலவின்பால் வினைமுற்றுச் சொல்லின் சரியான பகுபதப் பகுப்பாய்வு எது?", "media_id": null}], "options": {"A": "சென் + ற் + அன", "B": "செல்(சென்) + ற் + அன் + அ (செல் - பகுதி, சென் எனத் திரிந்தது விகாரம்; ற் - இறந்தகால இடைநிலை; அன் - சாரியை; அ - பலவின்பால் வினைமுற்று விகுதி)", "C": "சென்ற + ன", "D": "சென் + றன"}, "explanation": "'சென்றன' = செல்(சென்) + ற் + அன் + அ. செல் என்பது பகுதி; ற் - இறந்தகால இடைநிலை; அன் - சாரியை; அ - பலவின்பால் வினைமுற்று விகுதி."}, "en": {"blocks": [{"type": "text", "content": "What is the precise grammatical dissection of the neuter plural finite verb 'Sentrana' (They went)?", "media_id": null}], "options": {"A": "Sen + t + ana", "B": "Sel(sen) + t + an + a (Sel: root mutating to sen; t: past infix; an: saariyai; a: neuter plural suffix)", "C": "Sentra + na", "D": "Sen + rana"}, "explanation": "Sel(sen) + t + an + a is the standard grammatical dissection."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 73, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 73", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 1", "Grammar", "Pagupatham"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_rev1_q131", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_supp_grammar", "chapter_id": null, "topic_id": "thirukkural_gnaalam_karuthinum", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"ஞாலம் கருதினுங் கைகூடும் காலம்\nகருதி இடத்தால் செயின்\" - இத்திருக்குறளின்படி உலகம் முழுவதையும் ஆள நினைத்தாலும் அது எப்போது கைகூடும்?", "media_id": null}], "options": {"A": "படை பலம் அதிகமாக இருக்கும்போது", "B": "அரசன் வலிமையோடு பிறக்கும்போது", "C": "தக்க காலத்தை அறிந்து, பொருத்தமான இடத்தைத் தேர்ந்தெடுத்து ஒரு செயலைச் செய்யும்போது", "D": "செல்வம் குவியும்போது"}, "explanation": "செயலை முடிப்பதற்குரிய தகுந்த காலத்தை அறிந்து, ஏற்ற இடத்தையும் தேர்ந்தெடுத்துச் செயல்பட்டால் உலகத்தையே ஆள நினைத்தாலும் அது எளிதில் கைகூடும்."}, "en": {"blocks": [{"type": "text", "content": "In 'Gnaalam Karuthinung Kaikoodum Kaalam Karuthi Idaththaal Seyin', under what strategic conditions can one conquer the entire world?", "media_id": null}], "options": {"A": "Possessing vast mercenary armies", "B": "Being born to a royal lineage", "C": "Acting with precise timing and selecting the appropriate tactical terrain", "D": "Amassing boundless wealth"}, "explanation": "Even global dominion is achievable if actions are synchronized with opportune timing and strategic location."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "al