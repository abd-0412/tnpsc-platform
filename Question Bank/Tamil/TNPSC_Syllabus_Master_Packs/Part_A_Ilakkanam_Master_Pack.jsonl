{"id": "9th-u5-q137", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u5", "lesson_id": "9th-tamil-u5-l4", "chapter_id": null, "topic_id": "vallinam-salachirandhadhu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'சாலச் சிறந்தது' என்னும் தொடரில் 'ச்' மிகுந்துள்ளதற்கான இலக்கண விதி யாது?", "media_id": null}], "options": {"A": "'சால' என்னும் உரிச்சொல்லின் பின் வல்லினம் மிகும்", "B": "உவமைத்தொகையில் வல்லினம் மிகும்", "C": "வினாத் திரிபில் வல்லினம் மிகும்", "D": "இடைத்தொடர்க் குற்றியலுகரத்தில் வல்லினம் மிகும்"}, "explanation": "'சால' என்பது மிகுதி என்னும் பொருளுணர்த்தும் உரிச்சொல். சால, தவ போன்ற உரிச்சொற்களுக்குப் பின் வல்லினம் மிகும் என்ற விதிப்படி சால + சிறந்தது = சாலச் சிறந்தது என்றானது."}, "en": {"blocks": [{"type": "text", "content": "What rule causes 'ch' doubling in 'Saalach chirandhadhu'?", "media_id": null}], "options": {"A": "Plosives double following the intensive qualifying particle 'Saala'", "B": "Simile compound rule", "C": "Interrogative mutation rule", "D": "Idai-thodar kuttiyalugaram rule"}, "explanation": "'Saala' is an Urichol that obligatorily triggers plosive gemination."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year",