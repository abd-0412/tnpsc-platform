{"id": "9th-u4-q154", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l6", "chapter_id": null, "topic_id": "pyq-bharathidasan-sahitya", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC முந்தைய ஆண்டு வினா] பாரதிதாசன் இயற்றிய எந்த நாடக நூலுக்கு சாகித்திய அகாதெமி விருது கிடைத்தது?", "media_id": null}], "options": {"A": "பாண்டியன் பரிசு", "B": "பிசிராந்தையார்", "C": "குடும்ப விளக்கு", "D": "அழகின் சிரிப்பு"}, "explanation": "பாரதிதாசனின் 'பிசிராந்தையார்' என்னும் நாடக நூலுக்கு 1969 ஆம் ஆண்டு சாகித்திய அகாதெமி விருது வழங்கப்பட்டது. இது TNPSC தேர்வுகளில் பலமுறை கேட்கப்பட்ட வினாவாகும்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Previous Year Question] For which dramatic work did Bharathidasan receive the Sahitya Akademi Award?", "media_id": null}], "options": {"A": "Pandiyan Parisu", "B": "Pisiranthaiyar", "C": "Kudumba Vilakku", "D": "Azhagin Sirippu"}, "explanation": "Bharathidasan's play 'Pisiranthaiyar' was awarded the Sahitya Akademi prize in 1969."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 89, "chapter": null, "section": null, "reference": "9th Tamil,