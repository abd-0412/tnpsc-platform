{"id": "7th-t1-u3-274", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "sandhi-chokkampatti", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிரித்தெழுதுக:\n'சொக்கம்பட்டி' என்னும் ஊர்ப் பெயரைச் சரியாகப் பிரித்தெழுதக் கிடைக்கும் வடிவம் எது?"}], "options": {"A": "சொக்க + பட்டி", "B": "சொக்கம் + பட்டி", "C": "சொக்கப் + பட்டி", "D": "சொக்கு + பட்டி"}, "explanation": "இலக்கண விதி: சொக்கம் + பட்டி -> 'மவ்வீறு ஒற்றழிந்து உயிரீறு ஒப்பவும்' விதிப்படி மகர மெய் அழிந்து, பகரம் மிகுந்து 'சொக்கம்பட்டி' அல்லது மகரம் மெல்லினமாய் நின்று புணர்ந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Identify the correct grammatical separation of 'Chokkampatti':"}], "options": {"A": "Chokka + Patti", "B": "Chokkam + Patti (சொக்கம் + பட்டி)", "C": "Chokkap + Patti", "D": "Chokku + Patti"}, "explanation": "Grammar rule: Splits as Chokkam + Patti."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 54, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "pr