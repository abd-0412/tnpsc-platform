{"id": "11th_tamil_u5_q102", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "poetry_agananuru", "chapter_id": null, "topic_id": "grammar_alapedai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வளைஇ' என்னும் சொல்லில் இடம்பெற்றுள்ள அளபெடை வகை எது?", "media_id": null}], "options": {"A": "செய்யுளிசை அளபெடை", "B": "சொல்லிசை அளபெடை", "C": "இன்னிசை அளபெடை", "D": "ஒற்றளபெடை"}, "explanation": "'வளை' என்னும் சொல் 'வளைஇ' என 'இ' பெற்று வினையெச்சப் பொருளில் வந்ததால் இது சொல்லிசை அளபெடை ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What type of Alapedai is found in the word 'Valaii'?", "media_id": null}], "options": {"A": "Seyyulisai Alapedai", "B": "Sollissai Alapedai", "C": "Innisai Alapedai", "D": "Otralapedai"}, "explanation": "'Valaii' takes 'i' to function as a verbal participle, which is Sollissai Alapedai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": "11th Tamil, Unit 5, Page 114", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": nul