{"id": "11th_tamil_rev1_q151", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_grammar", "chapter_id": null, "topic_id": "panbupeyar_eerkku_mun_nindru", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"இணையவும்\" என்ற விதியினால் பண்புப்பெயர்ப் புணர்ச்சியில் விளையும் மாற்றம் எது?", "media_id": null}], "options": {"A": "எழுத்து கெடுவது", "B": "மெய் இரட்டுவது", "C": "விதிகளில் கூறப்படாத பிற மாற்றங்களும் சொல்லமைப்பிற்கு ஏற்ப நிகழ்வது (எ.கா: பசுமை + கூழ் = பைங்கூழ்)", "D": "புணர்ச்சி நிகழாமல் இருப்பது"}, "explanation": "நன்னூலில் சொல்லப்பட்ட பண்புப்பெயர்ப் புணர்ச்சி விதிகளில் அடங்காத பிற வடிவ மாற்றங்களும் 'இணையவும்' என்ற விதியினால் ஏற்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What phonetic leeway is governed by the residual Panbupeyar sutra 'Inaiyavum' in Nannool?", "media_id": null}], "options": {"A": "Total letter deletion", "B": "Consonant gemination", "C": "Accommodating idiosyncratic morphological adjustments not covered by primary rules (e.g., Pasumai + Koozh = Paingoozh)", "D": "Halting sandhi entirely"}, "explanation": "'Inaiyavum' functions as an omnibus catch-all rule sanctioning specialized mutations like Pasumai becoming Pai-."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "