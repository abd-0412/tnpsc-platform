{"id": "11th_tamil_u8_q068", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "poetry_manonmaniyam", "chapter_id": null, "topic_id": "happy_ending_resolution", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மனோன்மணீயம் நாடகத்தின் நிறைவு எத்தகைய நிகழ்வோடு இனிதே முடிகிறது?", "media_id": null}], "options": {"A": "பாண்டிய நாடு அழிகிறது", "B": "புருடோத்தமன் போரில் மாள்கிறான்", "C": "மனோன்மனி நஞ்சு அருந்துகிறாள்", "D": "குடிலன் சிறைப்படுத்தப்பட்டு, மனோன்மனி-புருடோத்தமன் மற்றும் வாணி-நடராசன் ஆகியோரின் இனிய திருமணங்கள் நடந்தேறுகின்றன"}, "explanation": "நாடகம் மங்கலகரமான இன்பியல் முடிவாக (Happy ending), துரோகிகள் களையப்பட்டு, இரு ஜோடிகளுக்கும் மங்களத் திருமணம் இனிதே நடந்தேற முடிவடைகிறது."}, "en": {"blocks": [{"type": "text", "content": "How does the dramatic narrative of Manonmaniyam happily culminate?", "media_id": null}], "options": {"A": "Pandya realm is destroyed", "B": "Purudothaman perishes in battle", "C": "Manonmani consumes poison", "D": "Kudilan is imprisoned, while joyous nuptials unite Manonmani-Purudothaman and Vaani-Natarasan"}, "explanation": "The verse play terminates in a joyous classical resolution celebrating justice and auspicious nuptials."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 181, "chapter": null, "section": null, "reference": "11th Tamil, Unit 8, Page 181", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 8", "Poetry", "Manonmaniyam"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

