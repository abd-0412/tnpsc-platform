{"id": "11th_tamil_u5_q156", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "grammar_paa_vagaigal", "chapter_id": null, "topic_id": "thoongal_sound_vanjippa", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தூங்கல் ஓசை எதற்குரியது? அதன் தன்மை யாது?", "media_id": null}], "options": {"A": "வெண்பாவுக்குரியது; வினா-விடை ஓசை", "B": "ஆசிரியப்பாவுக்குரியது; விளித்து அழைக்கும் ஓசை", "C": "கலிப்பாவுக்குரியது; சீர்தோறும் துள்ளிவரும் ஓசை", "D": "வஞ்சிப்பாவுக்குரியது; தூங்குதல் போல மெல்லத் தளர்ந்து ஒழுகும் ஓசை"}, "explanation": "தூங்கல் ஓசை வஞ்சிப்பாவுக்குரியது; தூங்குதல் போல மெல்ல அசைந்து தளர்ந்து வருவது இதன் இலக்கணமாகும்."}, "en": {"blocks": [{"type": "text", "content": "To which meter does 'Thoongal Osai' belong, and what is its attribute?", "media_id": null}], "options": {"A": "Venba; question-answer cadence", "B": "Asiriyappa; calling out", "C": "Kalippa; leaping rhythm", "D": "Vanjippa; slow, languid rhythm swaying gently like slumber"}, "explanation": "Thoongal cadence belongs to Vanjippa, characterized by undulating, rhythmic descent."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 121,