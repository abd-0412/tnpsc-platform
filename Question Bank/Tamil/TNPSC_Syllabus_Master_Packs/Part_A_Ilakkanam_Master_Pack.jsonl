{"id": "12th_tamil_u4_q710", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "paa_iyatra_pazhagalam", "chapter_id": null, "topic_id": "venseer_venthali_rule", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெண்சீர் வெண்டளையின் இலக்கண விதி யாது?", "media_id": null}], "options": {"A": "மாமுன் நிரை", "B": "காய்முன் நேர்", "C": "காய்முன் நிரை", "D": "விளமுன் நேர்"}, "explanation": "வெண்சீர் வெண்டளைக்குரிய இலக்கணம்: காய்ச்சீரின் முன் நேர் அசை வருவது (காய்முன் நேர்) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the prosodic linkage rule defining 'Ven-seer Ven-thalai'?", "media_id": null}], "options": {"A": "Nirai following Maa", "B": "Ner following Kaai (Kaai-mun Ner)", "C": "Nirai following Kaai", "D": "Ner following Vilam"}, "explanation": "Ven-seer Ven-thalai occurs strictly when a Ner syllable follows a Kaai foot."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 89, "chapter": null, "section": null, "reference": "12th Tamil, Unit 4, Page 89", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null