{"id": "11th_tamil_u4_q165", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "grammar_padaippaakka_uthigal", "chapter_id": null, "topic_id": "muran_oxymoron_examples", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘சுடும் பனி’ என்பது எவ்வகை உத்தி?", "media_id": null}], "options": {"A": "முரண் (Paradox / Oxymoron)", "B": "உவமை", "C": "உருவகம்", "D": "படிமம் மட்டுமே"}, "explanation": "பனி குளிர்ச்சியானது; சுடுவது வெப்பமானது; ஒன்றுக்கொன்று எதிரான இரு பண்புகளை இணைத்துக் கூறுவதால் இது 'முரண்' உத்தியாகும்."}, "en": {"blocks": [{"type": "text", "content": "What literary figure is embodied by the phrase 'Burning frost' (சுடும் பனி)?", "media_id": null}], "options": {"A": "Muran (Paradox / Oxymoron)", "B": "Simile", "C": "Metaphor", "D": "Image solely"}, "explanation": "'Burning frost' pairs opposing sensations, creating an oxymoronic Muran."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 89, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 89", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null,