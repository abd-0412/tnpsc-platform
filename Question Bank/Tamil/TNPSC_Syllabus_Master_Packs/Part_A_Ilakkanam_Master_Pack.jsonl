{"id": "11th_tamil_u1_q154", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "grammar_first_last_letters", "chapter_id": null, "topic_id": "aaytham_position", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆய்த எழுத்து (ஃ) சொல்லில் எங்கு மட்டுமே வரும்?", "media_id": null}], "options": {"A": "சொல்லின் முதலில் மட்டுமே", "B": "சொல்லின் இடையில் மட்டுமே", "C": "சொல்லின் இறுதியில் மட்டுமே", "D": "முதலும் இறுதியுமாகிய இரு இடங்களில்"}, "explanation": "ஆய்த எழுத்து சொல்லின் முதலிலும் வராது, இறுதியிலும் வராது; அது தனிக்குறிலை அடுத்தும் வல்லின உயிர்மெய்க்கு முன்னுமாகச் சொல்லின் இடையில் மட்டுமே வரும் (எ.கா: அஃது, எஃகு)."}, "en": {"blocks": [{"type": "text", "content": "Where does the Aaytham letter (ஃ) exclusively position itself within a Tamil word?", "media_id": null}], "options": {"A": "Exclusively at the word start", "B": "Exclusively in the middle of a word", "C": "Exclusively at the word terminus", "D": "At both start and terminus"}, "explanation": "Aaytham occurs strictly in medial positions between an isolated short vowel and a plosive."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 15, "c