{"id": "6th-t2-u1-069", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): ஆய்த எழுத்து சொல்லின் முதலாகவோ இறுதியாகவோ வாராது.\nகாரணம் (R): ஆய்த எழுத்து தனக்கு முன் ஒரு குறிலையும் பின் ஒரு வல்லின உயிர்மெய்க் குறிலையும் பெற்றுச் சொல்லின் இடையில் மட்டுமே இயங்கும் சார்பெழுத்து ஆகும்.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்.", "B": "கூற்று சரி, காரணம் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "ஆய்த எழுத்து சொல்லின் இடையில் மட்டுமே வரும் (எ.கா: அஃது, இஃது). சொல்லின் முதலில் அல்லது இறுதியில் ஒருபோதும் வராது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "ஆய்த எழுத்து சொல்லின் முதலாகவோ இறுதியாகவோ வாராது.", "reason": "ஆய்த எழுத்து தனக்கு முன் ஒரு குறிலையும் பின் ஒரு வல்லின உயிர்மெய்க் குறிலையும் பெற்றுச் சொல்லின் இடையில் மட்டுமே இயங்கும் சார்பெழுத்து ஆகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 16", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u1-070", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'நொ' என்னும் உயிர்மெய் எழுத்து சொல்லின் இறுதியில் வரக்கூடிய எழுத்து ஆகும்.\nகாரணம் (R): 'நொ' என்பது ஓரெழுத்து ஒரு மொழியாக வந்து 'மகிழ்ச்சி' என்னும் பொருளைத் தரும்.", "media_id": null}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி.", "B": "கூற்று சரி, ஆனால் காரணம் முற்றிலும் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "கூற்று சரி, காரணம் தவறு. ஒகர வரிசையில் 'நொ' மட்டுமே இறுதியில் வரும்; ஆனால் 'நொ' என்பதன் பொருள் 'துன்பம்' அல்லது 'நோதல்' ஆகும் ('மகிழ்ச்சி' அல்ல)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'நொ' என்னும் உயிர்மெய் எழுத்து சொல்லின் இறுதியில் வரக்கூடிய எழுத்து ஆகும்.", "reason": "'நொ' என்பது ஓரெழுத்து ஒரு மொழியாக வந்து 'மகிழ்ச்சி' என்னும் பொருளைத் தரும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication