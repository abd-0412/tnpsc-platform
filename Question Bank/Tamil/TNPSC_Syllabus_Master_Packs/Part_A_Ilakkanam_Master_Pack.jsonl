{"id": "10th-u1-q077", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "irattura_mozhithal", "chapter_id": null, "topic_id": "grammar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"துய்ப்பது\" என்ற சொல்லின் சரியான பொருள்களைத் தேர்க (தமிழுக்கும் கடலுக்கும் முறையே):", "media_id": null}], "options": {"A": "கற்பது, தருதல்", "B": "பாடுதல், ஆடுதல்", "C": "அழித்தல், காத்தல்", "D": "வாங்குதல், கொடுத்தல்"}, "explanation": "துய்ப்பது என்பதற்குத் தமிழுக்குக் \"கற்பது\" என்றும், கடலுக்குத் \"தருதல்\" என்றும் பொருள்படும்."}, "en": {"blocks": [{"type": "text", "content": "What are the distinct respective meanings of the word \"Thuippathu\" for Tamil and the Ocean?", "media_id": null}], "options": {"A": "Learning, Providing", "B": "Singing, Dancing", "C": "Destroying, Guarding", "D": "Buying, Giving"}, "explanation": "For Tamil \"Thuippathu\" means learning/enjoying knowledge; for the ocean it means providing pearls and ambrosia."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 9, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 9", "url": null, "source_notes": null}, "pre