{"id": "11th_tamil_u5_q146", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "grammar_paa_vagaigal", "chapter_id": null, "topic_id": "venba_types_count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "யாப்பிலக்கணத்தின்படி வெண்பா எத்தனை வகைப்படும்?", "media_id": null}], "options": {"A": "ஐந்து வகைப்படும்", "B": "ஆறு வகைப்படும்", "C": "நான்கு வகைப்படும்", "D": "எட்டு வகைப்படும்"}, "explanation": "வெண்பா 6 வகைப்படும்: 1. குறள் வெண்பா, 2. சிந்தியல் வெண்பா, 3. நேரிசை வெண்பா, 4. இன்னிசை வெண்பா, 5. பஃறொடை வெண்பா, 6. கலிவெண்பா."}, "en": {"blocks": [{"type": "text", "content": "According to Tamil prosody, into how many types is Venba classified?", "media_id": null}], "options": {"A": "Five types", "B": "Six types", "C": "Four types", "D": "Eight types"}, "explanation": "Venba is categorized into 6 types: Kural, Sinthiyal, Nerisai, Innisai, Pakrodai, and Kalivenba."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 122, "chapter": null, "section": null, "reference": "11th Tamil, Unit 5, Page 122", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exa