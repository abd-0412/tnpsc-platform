{"id": "10th-u5-q144", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "porulkol_vagaigal", "chapter_id": null, "topic_id": "niralnirai_definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "செய்யுளில் பெயர்ச்சொற்களையோ வினைச்சொற்களையோ வரிசையாக (நிரலாக) நிறுத்தி, அவற்றிற்குரிய பயனிலைகளையும் வரிசையாக நிறுத்திப் பொருள் கொள்ளும் முறை எது?", "media_id": null}], "options": {"A": "மொழிமாற்றுப் பொருள்கோள்", "B": "பூட்டுவிற் பொருள்கோள்", "C": "அளைமறிபாப்புப் பொருள்கோள்", "D": "நிரல்நிறைப் பொருள்கோள்"}, "explanation": "நிரல் = வரிசை; நிறை = நிறுத்துதல். சொற்களை வரிசையாக நிறுத்திப் பொருள் கொள்வது \"நிரல்நிறைப் பொருள்கோள்\" எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Arranging nouns or verbs in a set series and pairing them systematically with corresponding predicates in order is:", "media_id": null}], "options": {"A": "Mozhimaatru Porulkol", "B": "Poottuvir Porulkol", "C": "Alaimaripaapu Porulkol", "D": "Niralnirai Porulkol (Ordered alignment construal)"}, "explanation": "Niralnirai aligns items systematically in sequential columns of meaning."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "