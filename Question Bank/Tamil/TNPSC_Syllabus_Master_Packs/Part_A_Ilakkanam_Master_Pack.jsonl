{"id": "11th_tamil_u6_q160", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "compound_words_check", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்கண்டவற்றுள் வல்லினம் மிகா இடங்களுக்கான சரியான தொகுப்பைத் தேர்க:", "media_id": null}], "options": {"A": "அந்தப் பையன், பூப்பறித்தான், தமிழ்த்தாய்", "B": "பாடத்தைப் படி, சுக்குத்தூள், அங்குக் கண்டேன்", "C": "ஓடாக்குதிரை, சாலப்பேசினான், தைப் பூசம்", "D": "வினைத்தொகை, பெயரெச்சம், எழுவாய்த் தொடர், விளித்தொடர், உம்மைத்தொகை"}, "explanation": "வினைத்தொகை, பெயரெச்சம், எழுவாய்த் தொடர், விளித்தொடர், உம்மைத்தொகை ஆகிய அனைத்திலும் வல்லினம் மிகாது."}, "en": {"blocks": [{"type": "text", "content": "Identify the set consisting entirely of non-geminating grammatical environments (Vallinam Migaa Idangal):", "media_id": null}], "options": {"A": "Antha paiyan, Pooparithaan", "B": "Paadathai padi, Sukkuthool", "C": "Odaakkuthirai, Saalappesinaan", "D": "Vinai Thogai, Peyarechcham, Ezhuvai Thodar, Vili Thodar, Ummai Thogai"}, "explanation": "All five categories listed in option D forbid plosive gemination."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11"