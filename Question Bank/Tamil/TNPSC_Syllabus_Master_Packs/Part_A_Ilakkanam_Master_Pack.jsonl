{"id": "9th-u2-q141", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-05-evaluation-and-pyq", "chapter_id": null, "topic_id": "topic-iyal2-evaluation-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூல் பலவுள் தெரிக: 'மாடு' என்பதன் பொருள் என்ன?", "media_id": null}], "options": {"A": "பக்கம்", "B": "கீழே", "C": "மேலே", "D": "தொலைவு"}, "explanation": "பாடநூல் பக்க எண் 43 வினா: 'மாடு' என்பதன் பொருள் 'பக்கம்' ஆகும். (பெரியபுராணம்: மாடெல்லாம் கருங்குவளை = பக்கங்களிலெல்லாம் கருங்குவளை மலர்கள்)."}, "en": {"blocks": [{"type": "text", "content": "Textbook Evaluation: What is the contextual meaning of 'Maadu' in Periyapuranam?", "media_id": null}], "options": {"A": "Side / adjacent border (Pakkam)", "B": "Below", "C": "Above", "D": "Distance"}, "explanation": "As defined in Chapter 2 (page 43), 'Maadu' means side/adjacent area ('Maadellaam karungkuvalai' = black water lilies on all sides)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 43, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 43", "url": null, "source_notes": null}, "previous_year": {"is_