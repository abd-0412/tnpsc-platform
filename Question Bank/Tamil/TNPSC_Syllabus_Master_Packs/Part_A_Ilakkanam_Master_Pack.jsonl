{"id": "11th_tamil_u2_q164", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "grammar_punarchi_vithigal", "chapter_id": null, "topic_id": "iyalbierum_vithiyierum", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘இயல்பீறாகவோ விதியீறாகவோ வரும் உயிர்முன் கசதப மிகும்’ - இதில் ‘விதியீறு’ என்பதற்குச் சரியான சான்று எது?", "media_id": null}], "options": {"A": "பலா + காய் = பலாகாய்", "B": "பூ + கொடி = பூங்கொடி", "C": "பல் + பொடி = பற்பொடி", "D": "மரம் + குறிது = மரக்குறிது (மகர மெய் கெட்டு விதியினால் உயிரீறான நிலை)"}, "explanation": "மரம் என்பதில் 'ம்' கெட்டு 'மர' என விதியினால் உயிரீறாக மாறியதால் (விதியீறு) அதன் முன் வல்லினம் மிகுந்து 'மரக்குறிது' என்றானது."}, "en": {"blocks": [{"type": "text", "content": "What constitutes an authentic example of 'Vithiyeetru' (terminal vowel created by a sandhi deletion rule)?", "media_id": null}], "options": {"A": "Palaa + kaai", "B": "Poo + kodi", "C": "Pal + podi", "D": "Maram + kurithu = Marakkurithu (Terminal 'm' deleted via rule leaving a vowel terminus)"}, "explanation": "When 'Maram' loses terminal 'm' via sandhi rule, it becomes 'Vithiyeetru', doubling following plosives."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": "11th Tamil, Unit 2, Page 37", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 2", "Grammar", "Advanced Sandhi"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
