{"id": "12th_tamil_u6_q1106", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "shanta_rasa_exclusion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வடமொழி நாட்டிய சாஸ்திரத்தில் ஒன்பதாவது சுவையாகக் கூறப்படும் ‘சாந்தம்’ (அமைதி) தொல்காப்பியத்தில் இடம்பெறாததன் காரணம் யாது?", "media_id": null}], "options": {"A": "தொல்காப்பியருக்குத் தெரியாததால்", "B": "அமைதி (சாந்தம்) என்பது எவ்வித உடல் அசைவுகளும் இல்லாத நிலை என்பதால், உடலின் புறத்தே வெளிப்படும் மெய்ப்பாட்டில் அது சேர்க்கப்படவில்லை", "C": "இலக்கணம் மறுத்ததால்", "D": "மன்னர்கள் விரும்பாததால்"}, "explanation": "மெய்ப்பாடு என்பது உடலின் புற உறுப்புகளில் அசைவுகளோடு புலப்பட வேண்டும். அமைதி என்பது புற அசைவுகளற்ற மனநிலை என்பதால் தொல்காப்பியர் எண்வகை மெய்ப்பாடுகளை மட்டுமே வரையறுத்தார்."}, "en": {"blocks": [{"type": "text", "content": "Why did Tolkappiyar deliberately omit 'Shanta' (Tranquility / 9th Rasa) from his primary catalog of Meyppaadugal?", "media_id": null}], "options": {"A": "Unawareness of aesthetics", "B": "Because tranquility involves zero physical somatic movement or kinetic expression upon bodily limbs", "C": "Grammatical prohibition", "D": "Royal disapproval"}, "explanation": "Shanta entails total absence of somatic physical perturbation, making it ineligible as an overt physical 'Meyppaadu'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 143, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 143", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 6", "Grammar", "Shanta Exclusion"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u6_q1107", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "meyppaadu_poetry_link", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிதையில் மெய்ப்பாட்டின் இன்றியமையாத பங்கு யாது?", "media_id": null}], "options": {"A": "கடினமான சொற்களைக் கொண்டு வருவது", "B": "எழுத்துகளின் எண்ணிக்கையைக் கூட்டுவது", "C": "கவிஞன் உணர்ந்த உணர்ச்சியை வாசகனும் அதே சுவையோடு தன்னுள் உணர்ந்து அனுபவிக்கச் செய்தல்", "D": "வரலாற்று ஆண்டுகளைக் குறிப்பிடுவது"}, "explanation": "கவிஞனின் அக உணர்வை வாசகனிடம் நேரடியாகக் கடத்தி, அவனை அந்த உணர்ச்சியில் மூழ்க வைப்பதே மெய்ப்பாட்டின் பணியாகும்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the supreme literary function of Meyppaadu in poetic composition?", "media_id": null}], "options": {"A": "Inserting intricate lexicon", "B": "Multiplying metrical syllables", "C": "Evoking the identical emotional epiphany experienced by the poet within the receptive soul of the reader", "D": "Recording historical chronologies"}, "explanation": "Meyppaadu transmits the authentic emotional experience from author directly into the reader's consciousness."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and E