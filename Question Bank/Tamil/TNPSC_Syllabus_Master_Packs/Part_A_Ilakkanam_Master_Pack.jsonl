{"id": "11th_tamil_u1_q177", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "revision_unit_1", "chapter_id": null, "topic_id": "pyq_seeyagangan_dynasty", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] சீயகங்கன் என்ற சிற்றரசனின் வேண்டுகோளுக்கு இணங்க இயற்றப்பட்ட தமிழ் இலக்கண நூல் எது?", "media_id": null}], "options": {"A": "நன்னூல்", "B": "தொல்காப்பியம்", "C": "வீரசோழியம்", "D": "நேமிநாதம்"}, "explanation": "சீயகங்கன் வேண்டுகோளுக்கு இணங்க பவணந்தி முனிவரால் நன்னூல் இயற்றப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Which Tamil grammatical treatise was composed at the request of chieftain Seeyagangan?", "media_id": null}], "options": {"A": "Nannool", "B": "Tholkappiyam", "C": "Veerasozhiyam", "D": "Neminatham"}, "explanation": "Nannool was composed by Pavanandhi Munivar at the request of Seeyagangan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 6", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC", "exam_name": "Group 2", "ye