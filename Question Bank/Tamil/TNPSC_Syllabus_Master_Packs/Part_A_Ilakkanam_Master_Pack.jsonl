{"id": "12th_tamil_u4_q708", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "paa_iyatra_pazhagalam", "chapter_id": null, "topic_id": "venpaa_thalai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெண்பாவுக்குரிய தளைகள் எவை?", "media_id": null}], "options": {"A": "ஆசிரியத்தளை மற்றும் கலித்தளை", "B": "ஒன்றிய வஞ்சித்தளை மற்றும் ஒன்றாத வஞ்சித்தளை", "C": "வஞ்சித்தளை மட்டும்", "D": "இயற்சீர் வெண்டளை மற்றும் வெண்சீர் வெண்டளை"}, "explanation": "வெண்பாவில் 'வெண்டளை' மட்டுமே பயின்று வரும். வெண்டளை என்பது இயற்சீர் வெண்டளை, வெண்சீர் வெண்டளை ஆகிய இருவகைப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Which metrical linkages (Thalai) exclusively govern the construction of Venpa verse?", "media_id": null}], "options": {"A": "Asiriya-thalai and Kali-thalai", "B": "United and disunited Vanji-thalai", "C": "Vanji-thalai alone", "D": "Iyar-seer Ven-thalai and Ven-seer Ven-thalai"}, "explanation": "Venpa strictly admits only Ven-thalai: Iyar-seer Ven-thalai and Ven-seer Ven-thalai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 89, "chapter": null, "section": null, "reference": "12th Tamil, Un