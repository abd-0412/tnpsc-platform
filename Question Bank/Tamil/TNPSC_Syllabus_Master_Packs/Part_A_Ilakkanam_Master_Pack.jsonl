{"id": "11th_tamil_u6_q141", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "basic_demonstrative_letters", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'அ, இ' என்னும் சுட்டெழுத்துகளுக்குப் பின்னும், 'எ' என்னும் வினா எழுத்தின் பின்னும் வல்லினம் _____?", "media_id": null}], "options": {"A": "கட்டாயமாக மிகும் (எடுத்துக்காட்டு: அப்பக்கம், இப்பத்தகம், எத்திசை)", "B": "ஒருபோதும் மிகாது", "C": "சில இடங்களில் மட்டுமே மிகும்", "D": "மெல்லினம் மட்டுமே மிகும்"}, "explanation": "'அ, இ' என்னும் தனிச் சுட்டெழுத்துகளின் பின்னும், 'எ' என்னும் வினா எழுத்தின் பின்னும் வரும் க, ச, த, ப ஆகிய வல்லெழுத்துகள் மிகும்."}, "en": {"blocks": [{"type": "text", "content": "Following the demonstrative base vowels 'A', 'I' and the interrogative vowel 'E', do Vallinam consonants undergo gemination?", "media_id": null}], "options": {"A": "Strictly geminate (e.g., Appakkam, Ipputthagam, Etthisai)", "B": "Never geminate", "C": "Geminate optionally", "D": "Mellinam alone appears"}, "explanation": "Hard consonants (k, c, t, p) strictly double after demonstrative and interrogative letter roots."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Page 141", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 6", "Grammar", "Sandhi"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u6_q142", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "demonstrative_words", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'அந்த, இந்த, எந்த' என்னும் சுட்டு மற்றும் வினாத் திரிபுகளின் பின் வல்லினம் எவ்வாறமையும்?", "media_id": null}], "options": {"A": "வல்லினம் மிகாது", "B": "வல்லினம் மிகும் (எ.கா: அந்தக் காலம், இந்தப் புத்தகம், எந்தச் சட்டை)", "C": "இடையினம் மிகும்", "D": "ஆய்த எழுத்து தோன்றும்"}, "explanation": "'அந்த, இந்த, எந்த' என்னும் சொற்களின் பின் வரும் வல்லெழுத்துகள் கட்டாயமாக மிகும்."}, "en": {"blocks": [{"type": "text", "content": "How does Vallinam behave following demonstrative adjectives 'Antha', 'Intha' and interrogative 'Entha'?", "media_id": null}], "options": {"A": "Does not geminate", "B": "Strictly geminates (e.g., Antha Kaalam, Intha Puthagam)", "C": "Idaiyinam doubles", "D": "Ayutha letter emerges"}, "explanation": "Following 'Antha', 'Intha', and 'Entha', hard consonants always double."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": null, "section": null, "referen