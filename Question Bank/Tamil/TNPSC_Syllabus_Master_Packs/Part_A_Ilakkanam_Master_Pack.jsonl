{"id": "12th_tamil_u1_q143", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "mozhi_thiran", "chapter_id": null, "topic_id": "glossary_terminology", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘Terminology’ என்ற கலைச்சொல்லுக்குப் பொருத்தமான தமிழ்ச் சொல் எது?", "media_id": null}], "options": {"A": "ஒலியியல்", "B": "மொழியியல்", "C": "கலைச்சொல்", "D": "அகராதியியல்"}, "explanation": "Terminology என்பது ‘கலைச்சொல்’ அல்லது கலைச்சொல்லியல் என்று பொருள்படும்."}, "en": {"blocks": [{"type": "text", "content": "Which is the appropriate Tamil translation for the term 'Terminology'?", "media_id": null}], "options": {"A": "Phonetics", "B": "Linguistics", "C": "Kalaichol (Terminology)", "D": "Lexicography"}, "explanation": "'Terminology' means 'Kalaichol' in Tamil glossary studies."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 18", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "i