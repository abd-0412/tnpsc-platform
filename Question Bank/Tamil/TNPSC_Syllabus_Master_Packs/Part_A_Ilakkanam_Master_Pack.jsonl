{"id": "10th-u1-q078", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "irattura_mozhithal", "chapter_id": null, "topic_id": "grammar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"மேவலால்\" என்பதன் இருவேறு பொருள்கள் யாவை?", "media_id": null}], "options": {"A": "வருதலால், போதலால்", "B": "பொருந்துதலால், பெறுதலால்", "C": "பாடுவதால், ஆடுவதால்", "D": "மறைவதால், தோன்றுவதால்"}, "explanation": "மேவலால் என்பதற்குப் பொருந்துதலால் (அணிகலன்களாகப் பொருந்துதல்) என்றும் பெறுதலால் (கப்பல்கள் பெறுதல்) என்றும் பொருள் உண்டு."}, "en": {"blocks": [{"type": "text", "content": "What are the two contextual meanings of the word \"Mevalaal\"?", "media_id": null}], "options": {"A": "Coming, Going", "B": "Adorning/fitting, Receiving/attaining", "C": "Singing, Dancing", "D": "Disappearing, Appearing"}, "explanation": "\"Mevalaal\" denotes fitting/adorning nicely and receiving/possessing merchant vessels."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 9, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 9", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": fal