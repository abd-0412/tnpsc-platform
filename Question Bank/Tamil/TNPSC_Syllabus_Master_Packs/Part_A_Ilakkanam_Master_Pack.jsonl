{"id": "11th_tamil_rev1_q168", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_grammar", "chapter_id": null, "topic_id": "grammar_summary_batch6", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல்கள் 1 முதல் 4 வரையிலான இலக்கணப் பகுதிகள் மாணவர்களுக்கு வழங்கும் முதன்மையான மொழி ஆளுமைப் பயன் யாது?", "media_id": null}], "options": {"A": "இலக்கண விதிகளுக்கு மதிப்பளிக்காமல் எழுதுவது", "B": "பேச்சுத்தமிழிலேயே அனைத்து நூல்களையும் எழுதுவது", "C": "வேற்றுமொழிச் சொற்களை மிகுதியாகக் கலப்பது", "D": "சொற்களின் அகக் கட்டமைப்பை அறிவியல் பூர்வமாகப் பகுத்தறிந்து, சந்திப் பிழைகள் மற்றும் மரபு வழுக்களின்றித் தூய தமிழில் எழுதவும் பேசவும் தேர்ச்சி பெறுதல்"}, "explanation": "பகுபத உறுப்பிலக்கணம், புணர்ச்சி நெறிகள், பண்புப்பெயர்ப் புணர்ச்சி, மரபுத்தொடர்கள் ஆகியவை மாணவர்களுக்குப் பிழையற்ற தூய தமிழ்க் கையாளுகைத் திறனை அளிக்கின்றன."}, "en": {"blocks": [{"type": "text", "content": "What ultimate linguistic competence is imparted by the integrated grammar curricula of Units 1 through 4?", "media_id": null}], "options": {"A": "Writing without heed to grammar rules", "B": "Restricting all literature to slang", "C": "Inundating sentences with foreign loanwords", "D": "Scientifically analyzing internal word morphology and mastering error-free, pristine Tamil composition free of sandhi and idiomatic flaws"}, "explanation": "The curriculum equips students to master rigorous morphological analysis and immaculate composition."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 76, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_1, Page 76", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Revision 1", "Grammar", "Synthesis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

