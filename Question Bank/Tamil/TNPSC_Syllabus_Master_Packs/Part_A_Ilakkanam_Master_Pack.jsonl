{"id": "11th_tamil_rev2_q125", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_interview_proof_names", "chapter_id": null, "topic_id": "thirukkural_marunthu_kural", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மருந்தென வேண்டாவாம் யாக்கைக்கு அருந்தியது\nஅற்றது போற்றி உணின்’ - இக்குறட்பா உணர்த்தும் அடிப்படை வாழ்வியல் உண்மை யாது?", "media_id": null}], "options": {"A": "முன் உண்ட உணவு செரித்ததை அறிந்து பின்னரே உண்ண வேண்டும்; அவ்வாறு உண்டால் உடலுக்கு மருந்தே தேவையில்லை", "B": "மருந்து தினமும் உண்ண வேண்டும்", "C": "பசியோடு இருக்க வேண்டும்", "D": "சுவையான உணவை மட்டுமே உண்ண வேண்டும்"}, "explanation": "முன்பு சாப்பிட்ட உணவு செரித்துவிட்டதை உறுதி செய்துவிட்டு அடுத்த வேளை உணவை உண்பவனுக்கு எந்த மருந்தும் தேவைப்படாது என்று திருவள்ளுவர் தெளிவுறுத்துகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What foundational health guideline is proclaimed in the Thirukkural chapter on Medicine (Marunthu)?", "media_id": null}], "options": {"A": "Wait till previous food is fully digested before dining again; then no medicine is ever required", "B": "Medicines must be taken daily", "C": "Remain starving forever", "D": "Eat only rich delicacies"}, "explanation": "Valluvar states that one who waits until previous digestion is complete needs no pharmacopeia."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multi