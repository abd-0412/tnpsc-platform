{"id": "11th_tamil_rev1_q139", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u3_u4_supp_grammar", "chapter_id": null, "topic_id": "vadivasal_ambalathar_counsel", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வாடிவாசல்' குறுநாவலில் பிச்சி காரிக் காளையைக் களத்தில் எதிர்கொள்ளும் போது பக்கபலமாக இருந்து ஆலோசனைகள் கூறி உற்சாகப்படுத்தும் பாத்திரம் எது?", "media_id": null}], "options": {"A": "ஜமீன்தார்", "B": "கிராமத் தலைவர்", "C": "மருதன் (பிச்சியின் மைத்துனன் / தோழன்)", "D": "வேலன்"}, "explanation": "களத்தில் பிச்சியின் பின்னால் நின்று அவனைக் கவனித்து எச்சரித்து உற்சாகப்படுத்தும் உற்ற துணைவனாக 'மருதன்' திகழ்கிறான்."}, "en": {"blocks": [{"type": "text", "content": "In Vaadivaasal, which loyal companion stands steadfast behind Picchi in the arena whispering tactical warnings and courage?", "media_id": null}], "options": {"A": "The Zamindar", "B": "The Village Headman", "C": "Maruthan (Picchi brother-in-law and trusted ally)", "D": "Velan"}, "explanation": "Maruthan acts as Picchi's loyal tactical guide throughout the confrontation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "