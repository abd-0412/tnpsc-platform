{"id": "11th_tamil_u1_q176", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "revision_unit_1", "chapter_id": null, "topic_id": "paayiram_seven_synonyms_check", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாயிரத்திற்கு வழங்கப்படும் ஏழு பெயர்களுள் பொருந்தாத ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "முகவுரை", "B": "புனைந்துரை", "C": "அணிந்துரை", "D": "முடிவுரை"}, "explanation": "முடிவுரை என்பது நூலின் இறுதியில் அமைவது; பாயிரத்தின் பெயர்கள்: முகவுரை, பதிகம், அணிந்துரை, புனைந்துரை, பாயிரம், புறவுரை, தந்துரை ஆகிய ஏழாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following does NOT belong to the seven traditional synonyms for Paayiram?", "media_id": null}], "options": {"A": "Mugavurai", "B": "Punainthurai", "C": "Aninthurai", "D": "Mudivurai (Epilogue)"}, "explanation": "'Mudivurai' means epilogue/conclusion; the seven preface names include Mugavurai, Pathigam, Aninthurai, Punainthurai, Paayiram, Puravurai, and Thanthurai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 6", "url":