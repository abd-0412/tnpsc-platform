{"id": "8th-u4-q471", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u8-manitham", "lesson_id": "8th-u4-l2", "chapter_id": null, "topic_id": "purananuru-meepaai-meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கூம்பொடு மீப்பாய் களையாது' என்னும் புறநானூற்றுப் பாடல் அடியில் 'மீப்பாய்' என்னும் சொல்லின் இலக்கணப் பொருள் யாது?"}], "options": ["பாய் முடைவதற்குரிய மெல்லிய கோரைப்புல்", "பாய்மரக் கப்பலின் கீழ் தளத்தில் விரிக்கப்பட்ட பாய்", "கப்பலின் பாய்மரக் கூம்பின் உச்சியில் கட்டப்பட்ட மேல்பாய்", "மீன்பிடி வலைகளில் கட்டப்படும் மிதவைப்பாய்"], "explanation": "புறநானூற்றில் 'மீப்பாய்' என்பது 'மேல்பாய்' (கப்பல் கூம்பின் உச்சியில் கட்டப்படும் பாய்மரம்/பாய்) என்பதைக் குறிக்கும். 'மீ' என்றால் மேல் என்று பொருள்."}, "en": {"blocks": [{"type": "text", "content": "What is the literal contextual meaning of the term 'மீப்பாய்' in the Purananuru verse 'கூம்பொடு மீப்பாய் களையாது'?"}], "options": ["Fine reed grass used for mat weaving", "Floor mat spread on the lower deck of ship", "Upper sail mat hoisted on the mast of a sailing ship", "Floating net mat tied to fishing gear"], "explanation": "In classical Tamil, 'மீ' means upper/above. 'மீப்பாய்' specifically refers to the upper sailcloth hoisted on the mast (கூம்பு) of the vessel."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 72, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["purananuru", "vocabulary", "grammar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

