{"id": "7th-t2-pyq-q331", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-06-iyal1-aivu", "chapter_id": null, "topic_id": "ta-t2-bridging-grammar-sandhi-iranduporul", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஆறு' என்னும் சொல்லுக்குரிய இருவேறு சரியான பொருள்களைத் தேர்வு செய்க:"}], "options": {"A": "நதி / எண் (ஆறு)", "B": "கடல் / வானம்", "C": "நெருப்பு / காற்று", "D": "மலை / காடு"}, "explanation": "பாடநூல் பக்கம் 20 'இருபொருள் தரும் சொற்கள்': 'ஆறு' என்பது ஓடும் நீரையும் (நதி), எண் வரிசையில் வரும் ஆறு என்னும் எண்ணையும் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "Select the two distinct accurate meanings of the homonym word 'Aaru':"}], "options": {"A": "River / Number six", "B": "Sea / Sky", "C": "Fire / Wind", "D": "Mountain / Forest"}, "explanation": "Page 20 homonyms: 'Aaru' means both river and the number six."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 20, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "e