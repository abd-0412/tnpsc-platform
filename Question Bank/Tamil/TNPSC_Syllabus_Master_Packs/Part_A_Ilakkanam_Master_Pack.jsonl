{"id": "10th-u1-q138", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "eluthu_sol", "chapter_id": null, "topic_id": "general", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "செய்யுளில் ஓசை குறையும் போது அதனை நிறைவு செய்ய நெட்டெழுத்துகள் எத்தனை மாத்திரைக்கு அளபெடுக்கும்?", "media_id": null}], "options": {"A": "இரண்டு மாத்திரையிலிருந்து மூன்று மாத்திரையாக", "B": "இரண்டு மாத்திரையிலிருந்து மூன்று மாத்திரையாக நீளும் (குற்றெழுத்து 1 மாத்திரை துணைபெறும்)", "C": "ஒரு மாத்திரையாக", "D": "நான்கு மாத்திரையாக"}, "explanation": "நெட்டெழுத்து தனது இயல்பான இரண்டு மாத்திரையிலிருந்து மேலும் ஒரு மாத்திரை நீண்டு ஒலிக்கும்; அதன் அடையாளமாகக் குற்றெழுத்து எழுதப்படும்."}, "en": {"blocks": [{"type": "text", "content": "When long vowels elongate in poetry, how do their morae (Maathirai) duration change?", "media_id": null}], "options": {"A": "From 1 to 2 morae", "B": "From standard 2 morae to 3 morae (accompanied by short vowel)", "C": "Remains 1 mora", "D": "Elongates to 4 morae"}, "explanation": "The base 2 morae of long vowels elongate by an extra mora indicated by the short vowel grapheme."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 15, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 15", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["எழுத்து சொல்", "மாத்திரை", "உயிரளபெடை"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u1-q139", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "eluthu_sol", "chapter_id": null, "topic_id": "otralabedai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒற்றளபெடையில் அளபெடுக்கும் ஒற்றெழுத்தின் மாத்திரை அளவு யாது?", "media_id": null}], "options": {"A": "அரை மாத்திரை", "B": "இரண்டு மாத்திரை", "C": "ஒரு மாத்திரை", "D": "கால் மாத்திரை"}, "explanation": "ஒற்றெழுத்தின் இயல்பான மாத்திரை 1/2; அது அளபெடுக்கும் போது மேலும் 1/2 மாத்திரை பெற்று 1 மாத்திரையாக ஒலிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "What is the total duration (Maathirai) of an elongated consonant in Otrralabedai?", "media_id": null}], "options": {"A": "Half mora", "B": "Two morae", "C": "One mora (0.5 + 0.5)", "D": "Quarter mora"}, "explanation": "A consonant has 0.5 mora naturally; when elongated in Otrralabedai it doubles to 1 full mora."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 16, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 16", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "ye