{"id": "7th-t3-u3-q247", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u3-maanudam", "lesson_id": "lesson-10-malaippozhivu", "chapter_id": null, "topic_id": "ta-t3-u3-imaikkum-grammar-category", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'இமைக்கும் போதில்' என்ற தொடரில் அமைந்துள்ள 'இமைக்கும்' என்னும் சொல்லின் இலக்கணக் குறிப்பைக் கண்டறிக:"}], "options": {"A": "வினையெச்சம்", "B": "வினைமுற்று", "C": "பெயரெச்சம்", "D": "தொழிற்பெயர்"}, "explanation": "'இமைக்கும் போதில்' - இதில் 'இமைக்கும்' என்னும் சொல் 'போது' (காலத்தைக் குறிக்கும் பெயர்ச்சொல்) என்னும் பெயரைத் தழுவி நின்று முடிவடையாத எச்சமாக அமைந்ததால் இது 'பெயரெச்சம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the grammatical classification of 'Imaikkum' in the phrase 'Imaikkum pothil':"}], "options": {"A": "Vinaiyecham (Adverbial participle)", "B": "Vinai-mutru (Finite verb)", "C": "Peyarecham (Relative participle)", "D": "Thozhir-peyar (Verbal noun)"}, "explanation": "'Imaikkum' qualifies the noun 'pothu' (time/moment) without completing the action, thus functioning as a relative/adjectival participle (Peyarecham)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational