{"id": "12th_tamil_mp2_q1945", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "kuriyedu_modern_tamil_poet", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கூண்டு திறந்தாலும் சிறகடிக்க மறந்துவிட்ட பறவை’ - இத்தொடரில் பறவை எதன் குறியீடாக நிற்கிறது?", "media_id": null}], "options": {"A": "சுதந்திரம் கிடைத்தாலும் அடிமைப் பழக்கத்திலிருந்து விடுபட முடியாத மனித மனம்", "B": "பறவையின் இயலாமை", "C": "இயற்கையின் அழிவு", "D": "மழைக்காலம்"}, "explanation": "கூண்டு திறந்த பின்னும் பறக்காத பறவை என்பது நீண்டகால அடிமைத்தளையால் விடுதலை உணர்வை இழந்த சமூகத்தின் குறியீடாகும்."}, "en": {"blocks": [{"type": "text", "content": "'A bird that forgot to flutter its wings even when its cage was opened' - What does this bird symbolize?", "media_id": null}], "options": {"A": "The conditioned human mind unable to embrace freedom due to internalized subjugation", "B": "Physical disability of the avian species", "C": "Destruction of forest ecology", "D": "Monsoon weather"}, "explanation": "The caged bird represents internalized oppression and psychological paralysis even when emancipated."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 172, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 172", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 7", "Symbolism Poetics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp2_q1946", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "meyppattiyal_ilakkiya_payanpadu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘இழிவரல்’ என்னும் மெய்ப்பாட்டிற்குப் பொருத்தமான இலக்கியக் காட்சி எது?", "media_id": null}], "options": {"A": "இராமனின் வில்லாற்றலைக் கண்டு வியப்பது", "B": "தன் உடல் தளர்ந்து மூப்பும் நோயும் அடைந்த நிலையை எண்ணி முதியவர் வருந்துவது", "C": "போர்க்களத்தில் பகைவரை வென்று ஆர்ப்பரிப்பது", "D": "அரங்கில் மாதவி நடனமாடுவது"}, "explanation": "மூப்பு, பிணி, மென்மை ஆகியவற்றால் தனக்கு ஏற்படும் இயலாமையையும் தாழ்வுநிலையையும் கண்டு இரங்குவது இளிவரல் மெய்ப்பாடாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which textual scenario accurately embodies the aesthetic emotion 'Ilivaral' (pathos / self-pity / abjection)?", "media_id": null}], "options": {"A": "Astonishment witnessing Rama stringing the bow", "B": "An elder lamenting their decrepitude, bodily infirmity, and helplessness", "C": "Warriors cheering their battlefield triumph", "D": "Madhavi performing at the royal theater"}, "explanation": "Lamenting physical infirmity, decrepitude, and abject helplessness perfectly manifests Ilivaral."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 137", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 7", "Meyppattiyal Application"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp2_q1947", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "thirukkural_kural_venba_syllables", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறள் வெண்பா எத்தனை அடிகளையும் எத்தனை சீர்களையும் கொண்டு அமையும்?", "media_id": null}], "options": {"A": "நான்கு அடிகள், 16 சீர்கள்", "B": "மூன்று அடிகள், 10 சீர்கள்", "C": "இரண்டு அடிகள், 7 சீர்கள் (முதல் அடி 4 சீர், இரண்டாம் அடி 3 சீர்)", "D": "ஐந்து அடிகள், 20 சீர்கள்"}, "explanation": "குறள் வெண்பா என்பது முதல் அடியில் 4 சீர்களும், இரண்டாம் அடியில் 3 சீர்களும் கொண்டு மொத்தம் இரண்டு அடிகளில் 7 சீர்களாய் அமையும்."}, "en": {"blocks": [{"type": "text", "content": "How many lines (Adi) and metrical feet (Seer) constitute a classical Kural Venba stanza?", "media_id": null}], "options": {"A": "4 lines, 16 feet", "B": "3 lines, 10 feet", "C": "2 lines, 7 feet (4 feet in first line, 3 feet in second line)", "D": "5 lines, 20 feet"}, "explanation": "A Kural Venba comprises 2 metrical lines containing precisely 7 feet (4 in the first line, 3 in the second)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 174, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 174", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 7", "Prosody Metrics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp2_q1948", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "padimam_concept_ezhuthu_movement", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழில் 'படிமக் கவிதைகள்' (Imagist Poetry) தீவிரமாக எழுதப்பட்டு விவாதிக்கப்பட்ட இதழ் இயக்கம் எது?", "media_id": null}], "options": {"A": "மணிக்கொடி", "B": "கலாமோகினி", "C": "ஆனந்த விகடன்", "D": "எழுத்து (சி.சு. செல்லப்பா காலம்)"}, "explanation": "சி.சு. செல்லப்பாவின் 'எழுத்து' இதழில் பிரமிள், நகுலன், தருமு சிவராமு போன்ற பல நவீனக் கவிஞர்கள் படிமவாதக் கவிதைகளைத் தீவிரமாக எழுதினர்."}, "en": {"blocks": [{"type": "text", "content": "During which literary periodical movement was modernist Imagist poetry (Padimam) actively fostered and theorized in Tamil?", "media_id": null}], "options": {"A": "Manikkodi", "B": "Kalamohini", "C": "Ananda Vikatan", "D": "Ezhuthu movement (edited by C.S. Chellappa)"}, "explanation": "C.S. Chellappa's magazine 'Ezhuthu' served as the vanguard for Imagist modern Tamil poetry."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 114, "chapter": null, "section": null, "reference": "12th Tamil, Unit megapack_2, Page 114", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "MegaPack 2", "Mock 7", "Literary Movements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_mp2_q1958", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "megapack_2", "lesson_id": "final_tnpsc_simulation", "chapter_id": null, "topic_id": "padimam_modern_criticism_kailasapathy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழில் 'ஒப்பியல் இலக்கியம்', 'தமிழ் நாவல் இலக்கியம்' உள்ளிட்ட திறனாய்வு நூல்களை எழுதிய ஈழத்து மார்க்சியத் தமிழறிஞர் யார்?", "media_id": null}], "options": {"A": "கா. சிவத்தம்பி", "B": "க. கைலாசபதி", "C": "மு. வரதராசனார்", "D": "தெ.பொ. மீனாட்சிசுந்தரனார்"}, "explanation": "பேராசிரியர் க. கைலாசபதி தமிழ் இலக்கியத் திறனாய்வில் அறிவியல் பூர்வமான சமூகவியல் மற்றும் ஒப்பீட்டு ஆய்வு முறைகளை அறிமுகப்படுத்திய முன்னோடி அறிஞராவார்."}, "en": {"blocks": [{"type": "text", "content": "Which pioneering Marxist Tamil critic from Sri Lanka authored monumental critical treatises like 'Oppiyal Ilakkiyam'?", "media_id": null}], "options": {"A": "K. Sivathamby", "B": "K. Kailasapathy", "C": "Mu. Varadarajanar", "D": "T.P. Meenakshisundaranar"}, "explanation": "Prof. K. Kailasapathy pioneered socio-historical and comparative methodologies in modern Tamil literary criticism."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "ful