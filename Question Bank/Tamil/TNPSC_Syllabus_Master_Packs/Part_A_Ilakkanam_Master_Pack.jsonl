{"id": "9th-u8-q160", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l2", "chapter_id": null, "topic_id": "pichamoorthy-pen-names-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] ந. பிச்சமூர்த்தி தம் படைப்புகளை எந்தப் புனைப்பெயர்களில் எழுதினார்?", "media_id": null}], "options": {"A": "பாரதி, செல்லம்மா", "B": "சுரதா, ராஜகோபாலன்", "C": "வல்லிக்கண்ணன், சாவி", "D": "பிசு, ரேவதி"}, "explanation": "ந. பிச்சமூர்த்தி தொடக்கக் காலத்தில் 'பிசு', 'ரேவதி' ஆகிய புனைப்பெயர்களில் கவிதைகளையும் சிறுகதைகளையும் எழுதினார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Under which pen names did Na. Pichamoorthy author many of his early poems and short stories?", "media_id": null}], "options": {"A": "Bharati, Chellamma", "B": "Suradha, Rajagopalan", "C": "Vallikkannan, Saavi", "D": "Bisu and Revathi (பிசு, ரேவதி)"}, "explanation": "Na. Pichamoorthy famously wrote under the pseudonyms 'Bisu' and 'Revathi'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 156", "url": null, "source_notes"