{"id": "9th-u6-q165", "schema_version": "1.0", "kind": "conceptual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l5", "chapter_id": null, "topic_id": "punarchi-porundhadhadhu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்கண்டவற்றுள் விகாரப் புணர்ச்சியோடு தொடர்பில்லாத பொருந்தாத இணையைக் கண்டறிக:", "media_id": null}], "options": {"A": "வாழை + பழம் = வாழைப்பழமாய் (விகாரமின்மை)", "B": "பல் + பொடி = பற்பொடி (திரிதல்)", "C": "நுழைவு + தேர்வு = நுழைவுத்தேர்வு (தோன்றல்)", "D": "மரம் + வேர் = மரவேர் (கெடுதல்)"}, "explanation": "பற்பொடி (திரிதல்), நுழைவுத்தேர்வு (தோன்றல்), மரவேர் (கெடுதல்) ஆகியவை விகாரப் புணர்ச்சிகள் ஆகும். ஆப்ஷன் A பொருந்தாத இணை."}, "en": {"blocks": [{"type": "text", "content": "Identify the odd pair unrelated to the three canonical forms of Vikara Punarchi:", "media_id": null}], "options": {"A": "Vazhai + Pazham = Vazhaipazham (Mismatch)", "B": "Pal + Podi = Parpodi (Thrithal - mutation)", "C": "Nuzaivu + Thaervu = Nuzaivuthaervu (Thondral - insertion)", "D": "Maram + Ver = Maraver (Keduthal - elision)"}, "explanation": "Options B, C, and D accurately demonstrate Thrithal, Thondral, and Keduthal modifications, whereas A is the non-conforming option."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Text