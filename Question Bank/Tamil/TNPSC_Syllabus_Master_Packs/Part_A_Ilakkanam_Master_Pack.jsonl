{"id": "12th_tamil_u1_q123", "schema_version": "1.0", "kind": "grammar_identification", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamizhaai_ezhuthuvom", "chapter_id": null, "topic_id": "sandhi_error_sentences", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் வாக்கியங்களுள் சந்திப்பிழையற்ற (ஒற்றுப்பிழையற்ற) வாக்கியம் எது?", "media_id": null}], "options": {"A": "அவன் பாடத்தை படித்து தேர்வில் வென்றான்", "B": "அவன் பாடம் படித்துத் தேர்வில் வென்றான்", "C": "அவன் பாடத்தைப் படித்துத் தேர்வில் வென்றான்", "D": "அவன் பாடத்தை படித்து தேர்வில் வென்றான்"}, "explanation": "‘பாடத்தை’ என்பது இரண்டாம் வேற்றுமை விரி (ஐ), எனவே 'ப்' மிகும் (பாடத்தைப்). 'படித்து' என்பது வன்தொடர்க் குற்றியலுகர வினையெச்சம், எனவே 'த்' மிகும் (படித்துத்)."}, "en": {"blocks": [{"type": "text", "content": "Select the sentence completely free from Sandhi doubling errors:", "media_id": null}], "options": {"A": "Avan paadathai padithu thervil ventraan", "B": "Avan paadam padithuth thervil ventraan", "C": "Avan paadathaip padithuth thervil ventraan", "D": "Avan paadathai padithu thervil ventraan"}, "explanation": "Both the explicit accusative marker '-ai' and hard verbal participle 'padithu' demand mandatory plosive doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 14, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 14", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 1", "Grammar", "Sentence Sandhi"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u1_q124", "schema_version": "1.0", "kind": "grammar_identification", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamizhaai_ezhuthuvom", "chapter_id": null, "topic_id": "kan_kan_homophones", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘கண்’ மற்றும் ‘கன்’ ஆகியவற்றில் சரியான பயன்பாடு எது?", "media_id": null}], "options": {"A": "கன் என்பது பார்வை", "B": "கண் என்பது பாறை", "C": "இரண்டும் ஒன்றே", "D": "கண் என்பது உடலுறுப்பு/பார்வை ; கன் என்பது பாறை/கல் என்பதன் திரிபு (கன்மலை)"}, "explanation": "டண்ணகர 'கண்' என்பது பார்வை/உடலுறுப்பு; றன்னகர 'கன்' என்பது கல்/பாறை என்பதன் மரபுத் திரிபு (எ.கா: கன்மலை = கற்பாறை மலை)."}, "en": {"blocks": [{"type": "text", "content": "Discriminate the lexical applications of 'Kan' (ண்) and 'Kan' (ன்):", "media_id": null}], "options": {"A": "Kan (ன்) is sight", "B": "Kan (ண்) is rock", "C": "Both are identical", "D": "Kan (ண்) denotes the physical eye/vision ; Kan (ன்) denotes stone/rock derivative (e.g., Kanmalai)"}, "explanation": "Retroflex Kan denotes eye; alveolar Kan is the morphophonemic variant of Kal (stone/boulder)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 13, "chapter":