{"id": "7th-t2-u2-q133", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-grammar-kottoviyam-sandhi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கோட்டோவியம்' என்னும் சொல்லின் சரியான புணர்ச்சி விதியைக் கண்டறிக:\n'கோடு + ஓவியம்'"}], "options": {"A": "நெடிலோடோ ரிகரக்கண்ணும் தகர றகரம் இரட்டும்; உயிர்வரின் உக்குறள் மெய்விட்டோடும்; உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே", "B": "இ ஈ ஐ வழி யவ்வும்", "C": "தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும்", "D": "இயல்பினும் விதியினும் நின்ற உயிர்முன் கசதப மிகும்"}, "explanation": "கோடு + ஓவியம்:\n1. 'நெடிலோடோ ரிகரக்கண்ணும் தகர றகரம் இரட்டும்' என்ற விதிப்படி 'கோடு' என்பது 'கோட்டு' என இரட்டியது.\n2. 'உயிர்வரின் உக்குறள் மெய்விட்டோடும்' விதிப்படி 'உ' கெட்டு 'கோட்' ஆனது (கோட் + ஓவியம்).\n3. 'உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே' விதிப்படி ட் + ஓ = டோ என இணைந்து 'கோட்டோவியம்' என்றானது."}, "en": {"blocks": [{"type": "text", "content": "Identify the proper Sandhi combination rule for 'Kottoviyam' (Kodu + Oviyam):"}], "options": {"A": "Doubling of dental/retroflex stop before vowel in root; Uyirvarin ukkural meyvittodum; Udalmel uyirvanthu ondruvathu iyalbe", "B": "I Ee Ai vazhi yavvum", "C": "Thanikkuril mun otru uyirvarin irattum", "D": "Iyalbinum vithiyinum nindra uyirmun kasathapa migum"}, "explanation": "The retroflex stop 'du' geminates in noun roots (kottu), drops final 'u' before vowel 'o', and fuses into 'tto' yielding 'Kottoviyam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 28, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["punarchi", "sandhi_rules", "grammar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q134", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-grammar-seppedu-sandhi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'செப்பேடு' என்னும் சொல்லின் சரியான புணர்ச்சிப் பிரிப்பைக் கண்டறிக:"}], "options": {"A": "செப்பு + ஈடு", "B": "செப்பு + ஏடு", "C": "செப்பு + ஓடு", "D": "செப்பு + யேடு"}, "explanation": "பாடநூல் மதிப்பீடு வினா 4: 'செப்பேடு' = செப்பு + ஏடு. இதில் 'உயிர்வரின் உக்குறள் மெய்விட்டோடும்' (செப் + ஏடு), 'உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே' (ப் + ஏ = பே -> செப்பேடு)."}, "en": {"blocks": [{"type": "text", "content": "Identify the correct split of the compound word 'Seppedu':"}], "options": {"A": "Seppu + Eedu", "B": "Seppu + Eadu", "C": "Seppu + Oadu", "D": "Seppu + Yeadu"}, "explanation": "Textbook evaluation 4: 'Seppedu' splits into 'Seppu + Eadu'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 28, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": fal