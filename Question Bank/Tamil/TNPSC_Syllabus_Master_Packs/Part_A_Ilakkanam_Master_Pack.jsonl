{"id": "12th_tamil_u1_q120", "schema_version": "1.0", "kind": "grammar_identification", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamizhaai_ezhuthuvom", "chapter_id": null, "topic_id": "one_word_substitution_errors", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் இணைகளுள் பிழையற்ற சரியான இணையைத் தேர்க:", "media_id": null}], "options": {"A": "வலது பக்கம் - தவறு", "B": "இடது பக்கம் - தவறு", "C": "வலப்பக்கம், இடப்பக்கம் என்பதே சரியான மரபு", "D": "மேற்கண்ட அனைத்தும் சரி (வலப்பக்கம், இடப்பக்கம் என்பதே இலக்கண மரபு; வலது பக்கம், இடது பக்கம் என்பது தவறான வழக்கு)"}, "explanation": "வலது, இடது என்னும் சொற்களுக்குப் பின் பக்கம் சேரும் போது 'வலப்பக்கம்', 'இடப்பக்கம்' என்றே எழுத வேண்டும். 'வலது பக்கம்' என்பது பிழையான தொடராகும்."}, "en": {"blocks": [{"type": "text", "content": "Select the grammatically accurate standard idiom regarding direction:", "media_id": null}], "options": {"A": "Valathu pakkam is wrong", "B": "Idathu pakkam is wrong", "C": "Valappakkam, Idappakkam is correct standard idiom", "D": "All the above are correct assertions (Valappakkam and Idappakkam are standard; Valathu pakkam is colloquial error)"}, "explanation": "Standard Tamil syntax dictates 'Valappakkam' and 'Idappakkam' over colloquial additions."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 14, "chapter": null, "section": null, "reference": "12th Tamil, Unit 1, Page 14", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 1", "Grammar", "Idiomatic Usage"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u1_q121", "schema_version": "1.0", "kind": "grammar_identification", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamizhaai_ezhuthuvom", "chapter_id": null, "topic_id": "ila_ilai_izhai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘இலை, இளை, இழை’ ஆகிய சொற்களின் பொருளை முறையே பொருத்துக:", "media_id": null}], "options": {"A": "இலை = மரத்தின் இலை ; இளை = மெலிந்து போதல் ; இழை = நூல் இழை / ஆபரணம் செய்தல்", "B": "இலை = நூல் ; இளை = மரம் ; இழை = மெலிதல்", "C": "இலை = ஆடை ; இளை = மரம் ; இழை = நீர்", "D": "இலை = காற்று ; இளை = நிலம் ; இழை = ஆகாயம்"}, "explanation": "இலை (தாவரத்தின் இலை), இளை (உடம்பு இளைத்துப் போதல்/மெலிதல்), இழை (ஆடையின் நூல் இழை/தங்க நகை இழைத்தல்)."}, "en": {"blocks": [{"type": "text", "content": "Match the meanings of the homophonic triad 'Ilai' (லை), 'Ilhai' (ளை), and 'Izhai' (ழை):", "media_id": null}], "options": {"A": "Ilai (லை) = Plant leaf ; Ilhai (ளை) = Emaciating / growing lean ; Izhai (ழை) = Thread filament / crafting ornament", "B": "Ilai = Thread ; Ilhai = Tree ; Izhai = Leanness", "C": "Ilai = Attire ; Ilhai = Tree ; Izhai = Water", "D": "Ilai = Air ; Ilhai = Land ; Izhai = Sky"}, "explanation": "Ilai denotes foliage; Ilhai denotes physical emaciation; Izhai denotes thread filaments or fine inlay work."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tami