{"id": "11th_tamil_u7_q174", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "pyq_unit7", "chapter_id": null, "topic_id": "pyq_jeeva_quote_tnpsc", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC அசல் வினா] \"என்னை எங்கேனும் ஒரு கிராமத்தில் புதைத்துவிடுங்கள்; என் சமாதியின் மீது ஓர் ஏழை விவசாயி தன் மாடுகளை மேய்த்துவிட்டுப் போகட்டும்\" - என்று நெகிழ்ச்சியுடன் கூறிய தமிழறிஞர்/மக்கள் தலைவர் யார்?", "media_id": null}], "options": {"A": "சி. பா. ஆதித்தனார்", "B": "தோழர் ஜீவானந்தம்", "C": "காமராசர்", "D": "அண்ணா"}, "explanation": "எளிய விவசாயிகளுக்காகவும் பாட்டாளி மக்களுக்காகவும் தன் வாழ்நாளெல்லாம் உழைத்த தோழர் ப. ஜீவானந்தம் இவ்வாறு உரைத்தார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Which renowned public leader expressed: 'Bury me in any humble village; let a destitute peasant graze his cattle upon my grave'?", "media_id": null}], "options": {"A": "Si. Pa. Adithanar", "B": "Comrade P. Jeevanandham", "C": "Kamarajar", "D": "Anna"}, "explanation": "Comrade Jeeva's self-effacing socialist humility is immortalized in this celebrated declaration."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition"