{"id": "10th-u9-q165", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "unit9_overall", "chapter_id": null, "topic_id": "unit9_theme_summary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "10-ஆம் வகுப்பு இயல் 9 \"அன்பின் மொழி\" உணர்த்தும் முதன்மைப் பொதுக்கருத்து யாது?", "media_id": null}], "options": {"A": "மனிதநேயம், பிறருக்காக வாழும் தியாகம் மற்றும் உலகளாவிய சகோதரத்துவம்", "B": "போரிட்டு வெல்லுதல்", "C": "பொருளீட்டுதல் மட்டுமே", "D": "இயற்கையை அழித்தல்"}, "explanation": "பாடநூல் பொதுக்கருத்து: ஜெயகாந்தன், நாகூர் ரூமி, வீரமாமுனிவர், கு. அழகிரிசாமி மற்றும் திருவள்ளுவர் ஆகியோரின் படைப்புகள் வழியே மானுடப் பேரன்பே இங்கு நிலைநிறுத்தப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the overarching ethical synthesis of Standard 10 Unit 9 \"Anbin Mozhi\"?", "media_id": null}], "options": {"A": "Humanitarianism, sacrificial living for others, and universal compassion", "B": "Martial conquest", "C": "Material greed", "D": "Destroying nature"}, "explanation": "Universal humanitarian empathy and living altruistically for others."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "pag