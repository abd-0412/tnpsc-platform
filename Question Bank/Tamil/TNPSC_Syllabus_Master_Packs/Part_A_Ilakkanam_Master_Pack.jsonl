{"id": "6th-t2-u1-029", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறள் நூல் அமைப்பு மற்றும் ஆசிரியர் திருவள்ளுவர் குறித்த கூற்றுகளை ஆராய்க:\n1. திருவள்ளுவர் இரண்டாயிரம் ஆண்டுகளுக்கு முற்பட்டவர்; இவர் வான்புகழ் வள்ளுவர், தெய்வப்புலவர், பொய்யில் புலவர் முதலான சிறப்புப் பெயர்களால் போற்றப்படுகிறார்.\n2. திருக்குறள் அறத்துப்பால், பொருட்பால், இன்பத்துப்பால் (காமத்துப்பால்) என்னும் முப்பிரிவுகளைக் கொண்டது.\n3. இந்நூல் பதினெண்கீழ்க்கணக்கு நூல்களுள் ஒன்றாகும்; 133 அதிகாரங்களையும் 1330 குறட்பாக்களையும் கொண்டது.\n4. உலக மக்கள் அனைவருக்கும் எக்காலத்திற்கும் பொருந்தும் பொதுவான அறங்களைக் கூறுவதால் இந்நூல் 'உலகப் பொதுமறை' எனப்படுகிறது.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரியானவை", "B": "கூற்றுகள் 1, 2 சரி; 3, 4 தவறு", "C": "கூற்றுகள் 1, 3, 4 சரி; 2 தவறு", "D": "கூற்றுகள் 2, 3 சரி; 1, 4 தவறு"}, "explanation": "நான்கு கூற்றுகளும் நூல் வெளிப் பகுதியின் துல்லியமான தகவல்கள்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "திருவள்ளுவர் இரண்டாயிரம் ஆண்டுகளுக்கு முற்பட்டவர்; இவர் வான்புகழ் வள்ளுவர், தெய்வப்புலவர், பொய்யில் புலவர் முதலான சிறப்புப் பெயர்களால் போற்றப்படுகிறார்.", "content_en": null}, {"id": "S2", "content_ta": "திருக்குறள் அறத்துப்பால், பொருட்பால், இன்பத்துப்பால் (காமத்துப்பால்) என்னும் முப்பிரிவுகளைக் கொண்டது.", "content_en": null}, {"id": "S3", "content_ta": "இந்நூல் பதினெண்கீழ்க்கணக்கு நூல்களுள் ஒன்றாகும்; 133 அதிகாரங்களையும் 1330 குறட்பாக்களையும் கொண்டது.", "content_en": null}, {"id": "S4", "content_ta": "உலக மக்கள் அனைவருக்கும் எக்காலத்திற்கும் பொருந்தும் பொதுவான அறங்களைக் கூறுவதால் இந்நூல் 'உலகப் பொதுமறை' எனப்படுகிறது.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 22-23", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u1-032", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறட்பாக்களையும் அவற்றின் அதிகாரங்களையும் பொருத்துக:\nபட்டியல் I (குறள்):\n(a) விருந்து புறத்ததாத் தானுண்டல் சாவா மருந்தெனினும்\n(b) உள்ளத்தால் உள்ளலும் தீதே பிறன்பொருளைக்\n(c) வெள்ளத்து அனைய மலர்நீட்டம் மாந்தர்தம்\n(d) சொல்லுக சொல்லில் பயனுடைய\n\nபட்டியல் II (அதிகாரம்):\n1. பயனில சொல்லாமை\n2. ஊக்கமுடைமை\n3. கள்ளாமை\n4. விருந்தோம்பல்", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-4, (b)-3, (c)-2, (d)-1", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-2, (b)-1, (c)-4, (d)-3"}, "explanation": "விருந்து புறத்ததாத்... - விருந்தோம்பல் (4); உள்ளத்தால் உள்ளலும்... - கள்ளாமை (3); வெள்ளத்து அனைய... - ஊக்கமுடைமை (2); சொல்லுக சொல்லில்... - பயனில சொல்லாமை (1). சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": 