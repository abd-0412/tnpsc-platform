{"id": "9th-u4-q162", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l6", "chapter_id": null, "topic_id": "pyq-sharda-act", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC முந்தைய ஆண்டு வினா] குழந்தை திருமணத்தைத் தடை செய்யும் நோக்கில் கொண்டுவரப்பட்ட 'சாரதா சட்டம்' இயற்றப்பட்ட ஆண்டு எது?", "media_id": null}], "options": {"A": "1927", "B": "1929", "C": "1931", "D": "1935"}, "explanation": "குழந்தைத் திருமணத்தைத் தடுக்கும் வரலாற்றுச் சிறப்புமிக்க 'சாரதா சட்டம்' (Child Marriage Restraint Act) 1929 ஆம் ஆண்டு இயற்றப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Previous Year Question] In which year was the historic 'Sharda Act' prohibiting child marriages enacted?", "media_id": null}], "options": {"A": "1927", "B": "1929", "C": "1931", "D": "1935"}, "explanation": "The Sharda Act (Child Marriage Restraint Act) was passed in 1929."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 85, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 85", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Gro