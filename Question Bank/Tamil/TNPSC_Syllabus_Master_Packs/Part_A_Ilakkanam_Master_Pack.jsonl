{"id": "7th-t1-pyq-387", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-grammar", "chapter_id": null, "topic_id": "thamizhinbam-punarchi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தமிழின்பம்' என்னும் சொல்லைப் புணர்ச்சி விதிகளின்படி சரியான முறையில் பிரித்துக் காட்டும் வடிவம் எது?"}], "options": {"A": "தமிழ + இன்பம்", "B": "தமிழ் + ன் + இன்பம்", "C": "தமிழ் + இன்பம்", "D": "தமிழின் + பம்"}, "explanation": "TNPSC PYQ இலக்கணக் குறிப்பு: தமிழ் + இன்பம் = தமிழின்பம். நிலைமொழி ஈற்று மெய் (ழ்) வருமொழி முதல் உயிர் (இ) உடன் இணைந்து 'உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே' என்னும் விதிப்படி 'ழி' எனப் புணர்ந்தது."}, "en": {"blocks": [{"type": "text", "content": "Which is the correct morphemic division of 'Thamizhinbam' according to Tamil sandhi rules?"}], "options": {"A": "Thamizha + Inbam", "B": "Thamizh + n + Inbam", "C": "Thamizh + Inbam", "D": "Thamizhin + pam"}, "explanation": "TNPSC PYQ Fact: Thamizh + Inbam = Thamizhinbam; consonant 'zh' merges with initial vowel 'i' under standard Tamil sandhi rule."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edi