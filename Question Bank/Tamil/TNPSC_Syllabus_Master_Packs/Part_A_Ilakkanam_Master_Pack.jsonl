{"id": "8th-u4-q499", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u8-manitham", "lesson_id": "8th-u4-l3", "chapter_id": null, "topic_id": "panilam-meaning-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பணிலம்' என்னும் சொல்லின் நேரடிப் பொருள் யாது?"}], "options": ["முரசு", "வீணை", "சங்கு", "தவில்"], "explanation": "பாடநூல் பக்கம் 77-இன் படி: 'இலக்கியங்களில் சங்கை பணிலம் என்றும் குறிப்பிட்டுள்ளனர்'. எனவே பணிலம் என்பதன் பொருள் 'சங்கு' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the direct meaning of the classical Tamil word 'பணிலம்'?"}], "options": ["Drum (Murasu)", "Lute (Veena)", "Conch (Sangu)", "Thavil"], "explanation": "Textbook page 77 states: 'In classical literature, the conch is referred to as Panilam'. Therefore, Panilam means Conch."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 77, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "q