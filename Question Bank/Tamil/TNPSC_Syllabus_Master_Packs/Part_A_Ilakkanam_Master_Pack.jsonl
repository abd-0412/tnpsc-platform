{"id": "9th-u6-q135", "schema_version": "1.0", "kind": "application", "level": "application", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l5", "chapter_id": null, "topic_id": "varavarindhadhu-steps", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வரவு + அறிந்தது = வரவறிந்தது' - இதில் நிலைமொழி ஈற்று 'வு' எவ்வகை உகரம்?", "media_id": null}], "options": {"A": "நெடில்தொடர்க் குற்றியலுகரம்", "B": "உயிர்த்தொடர்க் குற்றியலுகரம்", "C": "முற்றியலுகரம்", "D": "ஆய்தத்தொடர்க் குற்றியலுகரம்"}, "explanation": "'வரவு' என்பது குற்றியலுகரச் சொற்கள் ஆறனுள் அடங்காத, சொல்லின் இறுதியில் முழுக் கை அளவோடு ஒலிக்கும் 'முற்றியலுகரம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "In 'வரவு + அறிந்தது = வரவறிந்தது', what type of 'u' is the ending 'vu' of Nilaimozhi?", "media_id": null}], "options": {"A": "Nedil thodark kutriyalukaram", "B": "Uyirthodark kutriyalukaram", "C": "Mutriyalukaram (முற்றியலுகரம்)", "D": "Aythathodark kutriyalukaram"}, "explanation": "'Varavu' does not fall under the six types of shortened 'u' and sounds with full mora value, making it Mutriyalukaram."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 115, "chapter": null, "s