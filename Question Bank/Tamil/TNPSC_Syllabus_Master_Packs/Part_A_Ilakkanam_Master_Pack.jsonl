{"id": "7th-t3-u1-q051", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-02-tirunelveli", "chapter_id": null, "topic_id": "ta-t3-u1-grammar-ilakkana-kurippu-korkai-muthu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கொற்கை முத்து' என்னும் தொடரின் சரியான இலக்கணக் குறிப்பைக் கண்டறிக:"}], "options": {"A": "இரண்டாம் வேற்றுமை உருபும் பயனும் உடன் தொக்க தொகை", "B": "வினைத்தொகை", "C": "உவமைத்தொகை", "D": "ஏழாம் வேற்றுமைத் தொகை"}, "explanation": "'கொற்கையின் கண் விளைந்த முத்து' என ஏழாம் வேற்றுமை உருபாகிய 'கண்' (இடப்பொருள்) மறைந்து வந்தமையால், இது 'ஏழாம் வேற்றுமைத் தொகை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the precise grammatical categorization (Ilakkana Kurippu) of 'Korkai Muthu':"}], "options": {"A": "2nd case accusative compound", "B": "Verb compound (Vinaithogai)", "C": "Simile compound (Uvamaithogai)", "D": "7th case locative compound (Ezhaam Vetrumaithogai)"}, "explanation": "'Korkai Muthu' expands to 'Korkaiyin-kan vilaintha muthu', implying the locative marker 'kan', classifying it as Ezhaam Vetrumaithogai (7th case compound)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educatio