{"id": "6th-t2-u2-042", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வணிகச் சொற்களையும் அவர்தம் விளக்கங்களையும் பொருத்துக:\nபட்டியல் I:\n(a) வணிகச் சாத்து\n(b) நுகர்வோர்\n(c) பட்டினம்\n(d) பாக்கம்\n\nபட்டியல் II:\n1. கடற்கரைச் சிற்றூர்\n2. கடற்கரை நகரம் (துறைமுக நகரம்)\n3. பொருள்களை வாங்கிப் பயன்படுத்துபவர்\n4. வணிகர்கள் கூட்டமாகச் செல்லும் வணிகக் குழு", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-3, (c)-4, (d)-1", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-4, (b)-3, (c)-2, (d)-1"}, "explanation": "வணிகச் சாத்து - வணிகக் குழு; நுகர்வோர் - பொருளைப் பயன்படுத்துபவர்; பட்டினம் - கடற்கரை நகரம்; பாக்கம் - கடற்கரைச் சிற்றூர். சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null