{"id": "11th_tamil_u2_q143", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "grammar_punarchi_vithigal", "chapter_id": null, "topic_id": "y_glide_example", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மணி + அடித்தது = மணியடித்தது’ - இதில் இடம்பெற்றுள்ள புணர்ச்சி விதி எது?", "media_id": null}], "options": {"A": "ஏனை உயிர் வழி வவ்வும்", "B": "உயிர்வரின் உக்குறள் மெய்விட்டு ஓடும்", "C": "இ ஈ ஐ வழி யவ்வும், உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே", "D": "தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும்"}, "explanation": "மணி (ண்+இ) என இகரம் ஈறாக உள்ளதால் 'இ ஈ ஐ வழி யவ்வும்' விதிப்படி 'ய்' தோன்றி, பின் ய்+அ=ய எனப்புணர்ந்து 'மணியடித்தது' என்றானது."}, "en": {"blocks": [{"type": "text", "content": "Which grammatical rule governs the sandhi fusion in 'Mani + adiththathu = Maniyadiththathu'?", "media_id": null}], "options": {"A": "Eanai uyir vazhi vavvum", "B": "Uyirvarin ukkural meivittu odum", "C": "I Ee Ai vazhi yavvum, followed by Udalmel uyirvanthu ondruvathu iyalbe", "D": "Tanikkuril mun otru uyirvarin irattum"}, "explanation": "Terminating in vowel 'i', it takes glide 'y' via 'I Ee Ai vazhi yavvum' yielding 'Mani-y-adiththathu'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Serv