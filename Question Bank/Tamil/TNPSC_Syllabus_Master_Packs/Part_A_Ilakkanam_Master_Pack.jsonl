{"id": "12th_tamil_u8_q1510", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kuriyeedu_grammar", "chapter_id": null, "topic_id": "tholkappiyam_porulathikaram_uvamam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொல்காப்பியர் எந்த அதிகாரத்தில் உள்ளுறை உவமம் பற்றிக் குறிப்பிடுகிறார்?", "media_id": null}], "options": {"A": "எழுத்ததிகாரம்", "B": "பொருளதிகாரம் (அகத்திணையியல் & உவமவியல்)", "C": "சொல்லதிகாரம்", "D": "யாப்பதிகாரம்"}, "explanation": "தொல்காப்பியப் பொருளதிகாரத்தில் அகத்திணையியலிலும் உவமவியலிலும் 'உள்ளுறை தெய்வம் ஒழிந்ததை நிலனெனக் கொள்ளும் என்ப குறிப்பறிந் தோரே' என விளக்கியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "In which section of Tholkappiyam does Tholkappiyar expound upon 'Ullurai Uvamam'?", "media_id": null}], "options": {"A": "Ezhuthathikaram", "B": "Porulathikaram (Agathinaiyal & Uvamaviyal)", "C": "Sollathikaram", "D": "Yaappathikaram"}, "explanation": "Tholkappiyar expounds on interior landscape symbols in Agathinaiyal and Uvamaviyal of Porulathikaram."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 210, "chapter": null, "section": null, "reference"