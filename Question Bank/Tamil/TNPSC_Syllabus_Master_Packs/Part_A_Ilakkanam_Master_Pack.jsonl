{"id": "8th-u6-q778", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l2", "chapter_id": null, "topic_id": "grammar-case-seventh-fourth", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மதுரையில் மாநாடு', 'மாணவர்களுக்குக் காலணி' ஆகிய தொடர்களில் அடிக்கோடிட்ட 'மதுரையில்', 'மாணவர்களுக்கு' ஆகிய சொற்களில் அமைந்துள்ள வேற்றுமை உருபுகளைக் கண்டறிக:"}], "options": {"A": "மூன்றாம் வேற்றுமை, ஐந்தாம் வேற்றுமை", "B": "ஏழாம் வேற்றுமை, நான்காம் வேற்றுமை", "C": "ஆறாம் வேற்றுமை, இரண்டாம் வேற்றுமை", "D": "எட்டாம் வேற்றுமை, முதலாம் வேற்றுமை"}, "explanation": "- 'மதுரையில்' என்பதில் 'இல்' என்னும் ஏழாம் வேற்றுமை (இடப்பொருள்) உருபு அமைந்துள்ளது.\n- 'மாணவர்களுக்கு' என்பதில் 'கு' என்னும் நான்காம் வேற்றுமை (கொடைப்பொருள்) உருபு அமைந்துள்ளது.\nஎனவே 'ஏழாம் வேற்றுமை, நான்காம் வேற்றுமை' என்பது சரியான விடையாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the case suffixes (Vaetrumai urubugal) present in the words 'Maduraiyil' and 'Maanavargalukku':"}], "options": {"A": "Third case, Fifth case", "B": "Seventh case, Fourth case", "C": "Sixth case, Second case", "D": "Eighth case, First case"}, "explanation": "'Maduraiyil' contains the 7th locative case marker 'il'. 'Maanavargalukku' contains the 4th dative case marker 'ku'. Hence Seventh case, Fourth case."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 119, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "grammar", "vaetrumai"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q779", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l2", "chapter_id": null, "topic_id": "grammar-irupeyarottu-tamil-university", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தமிழ்ப் பல்கலைக்கழகம்' என்னும் சொற்றொடரின் சரியான இலக்கணக் குறிப்பைக் கண்டறிக:"}], "options": {"A": "உவமைத்தொகை", "B": "உம்மைத்தொகை", "C": "இருபெயரொட்டுப் பண்புத்தொகை", "D": "அன்மொழித்தொகை"}, "explanation": "'தமிழ் ஆகிய பல்கலைக்கழகம்': தமிழ் என்னும் சிறப்புப் பெயரும், பல்கலைக்கழகம் என்னும் பொதுப் பெயரும் இணைந்து வந்து இடையில் 'ஆகிய' என்னும் பண்பு உருபு மறைந்து வந்துள்ளதால் இது 'இருபெயரொட்டுப் பண்புத்தொகை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the correct grammatical compound classification for 'Tamil-p-palkalaikkazhagam':"}], "options": {"A": "Uvamai Thogai", "B": "Ummai Thogai", "C": "Irupeyarottu Panbutthogai", "D": "Anmozhitthogai"}, "explanation": "'Tamil-p-palkalaikkazhagam' pairs the specific noun 'Tamil' with the generic noun 'Palkalaikkazhagam' with the elision of 'aagiya', making it an Irupeyarottu Panbutthogai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 119, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "grammar", "irupeyarottu"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

