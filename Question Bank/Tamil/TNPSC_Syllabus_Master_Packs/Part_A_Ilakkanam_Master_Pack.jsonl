{"id": "11th_tamil_rev2_q130", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_interview_proof_names", "chapter_id": null, "topic_id": "proofreading_stet_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மெய்ப்புத் திருத்தக் குறியீடான ‘Stet’ என்பதன் தமிழ்ப் பொருள் யாது?", "media_id": null}], "options": {"A": "நீக்கிவிடுக", "B": "அப்படியே விடுக / முன்போலவே இருக்கட்டும்", "C": "இடம் மாற்றுக", "D": "புதிய பத்தி தொடங்குக"}, "explanation": "தவறுதலாக அடித்த திருத்தத்தை ரத்து செய்து 'முன்பு இருந்தவாறே இருக்கட்டும்' என்று மெய்ப்பாளர் குறிப்பதே 'Stet' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What does the Latin typographical instruction 'Stet' indicate?", "media_id": null}], "options": {"A": "Delete this word", "B": "Let it stand / maintain as it was before", "C": "Transpose the order", "D": "Indent a new paragraph"}, "explanation": "'Stet' cancels a previous deletion instruction, retaining original copy text."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 220, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Pa