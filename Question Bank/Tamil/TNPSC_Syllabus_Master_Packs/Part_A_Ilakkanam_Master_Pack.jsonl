{"id": "11th_tamil_u4_q090", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_tholkappiya_paayiram", "chapter_id": null, "topic_id": "tholkappiyam_three_sections", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘எழுத்தும் சொல்லும் பொருளும் நாடி...’ - தொல்காப்பியத்தில் அமைந்துள்ள மூன்று பெரும் பிரிவுகள் (அதிகாரங்கள்) எவை?", "media_id": null}], "options": {"A": "அறம், பொருள், இன்பம்", "B": "எழுத்ததிகாரம், சொல்லதிகாரம், பொருளதிகாரம்", "C": "இயல், இசை, நாடகம்", "D": "யாப்பு, அணி, பாட்டு"}, "explanation": "தொல்காப்பியம் எழுத்து, சொல், பொருள் என மூன்று அதிகாரங்களைக் கொண்டுள்ளது; ஒவ்வோர் அதிகாரமும் 9 இயல்களாகப் பகுக்கப்பட்டு மொத்தம் 27 இயல்களைக் கொண்டது."}, "en": {"blocks": [{"type": "text", "content": "Which three grand foundational divisions (Athikaarangal) constitute the treatise Tholkappiyam?", "media_id": null}], "options": {"A": "Aram, Porul, and Inbam", "B": "Ezhuthathikaaram (Phonology/Orthography), Sollathikaaram (Morphology/Syntax), and Porulathikaaram (Poetics/Sociology)", "C": "Iyal, Isai, and Naadagam", "D": "Prosody, Rhetoric, and Poetry"}, "explanation": "Tholkappiyam contains three master books: Ezhuthu, Sol, and Porul, each with 9 chapters totaling 27."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher