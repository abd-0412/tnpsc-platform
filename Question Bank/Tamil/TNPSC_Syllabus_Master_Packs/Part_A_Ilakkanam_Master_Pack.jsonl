{"id": "9th-rev-q001", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u1", "lesson_id": "9th-tamil-u1-l1", "chapter_id": null, "topic_id": "dravidian-caldwell-foundational-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] 'திராவிட மொழிகளின் ஒப்பிலக்கணம்' (A Comparative Grammar of the Dravidian Languages) என்ற தலைசிறந்த நூலை 1856-இல் வெளியிட்ட அறிஞர் யார்?", "media_id": null}], "options": {"A": "ராபர்ட் கால்டுவெல் (Robert Caldwell)", "B": "ஜி. யு. போப்", "C": "வீரமாமுனிவர்", "D": "எல்லிஸ்"}, "explanation": "ராபர்ட் கால்டுவெல் 1856-ஆம் ஆண்டு 'திராவிட மொழிகளின் ஒப்பிலக்கணம்' என்னும் ஒப்பாய்வு நூலை வெளியிட்டுத் திராவிட மொழிகள் வடமொழியினின்று வேறுபட்ட தனிக்குடும்பம் என நிலைநாட்டினார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Who authored the epochal work 'A Comparative Grammar of the Dravidian Languages' in 1856?", "media_id": null}], "options": {"A": "Robert Caldwell (ராபர்ட் கால்டுவெல்)", "B": "G. U. Pope", "C": "Veeramamunivar", "D": "F. W. Ellis"}, "explanation": "Robert Caldwell published this monumental linguistic study in 1856."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025