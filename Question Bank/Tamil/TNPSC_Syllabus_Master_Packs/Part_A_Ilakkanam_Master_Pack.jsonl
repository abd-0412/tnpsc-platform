{"id": "9th-u6-q147", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u6", "lesson_id": "9th-tamil-u6-l6", "chapter_id": null, "topic_id": "arivai-virivu-sei-yen-yedharku-yeppadi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஏன்? எதற்கு? எப்படி?' என்ற புகழ்பெற்ற அறிவியல் வினா-விடை நூலின் ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "ஜெயகாந்தன்", "B": "தி. ஜானகிராமன்", "C": "சுஜாதா", "D": "அப்துல் கலாம்"}, "explanation": "'ஏன்? எதற்கு? எப்படி?' என்ற புகழ்பெற்ற நூலை எழுதியவர் பிரபல எழுத்தாளர் சுஜாதா ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the famous scientific query book 'Yen? Yedharku? Yeppadi?' (Why? For What? How?)?", "media_id": null}], "options": {"A": "Jayakanthan", "B": "T. Janakiraman", "C": "Sujatha (சுஜாதா)", "D": "Abdul Kalam"}, "explanation": "'Yen? Yedharku? Yeppadi?' is written by legendary writer and engineer Sujatha (Rangarajan)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 118, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 118", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": n