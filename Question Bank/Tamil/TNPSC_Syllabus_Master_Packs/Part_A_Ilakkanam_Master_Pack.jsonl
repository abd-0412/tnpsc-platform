{"id": "7th-t3-u3-q331", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u3-maanudam", "lesson_id": "lesson-14-vina-vidai", "chapter_id": null, "topic_id": "ta-t3-u3-mattaippanthu-bookback-grammar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மட்டைப்பந்து விளையாடத் தெரியுமா?' என்னும் வினாவிற்குக் 'கால்பந்து விளையாடத் தெரியும்' என்று கூறுவது எவ்வகை விடை?"}], "options": {"A": "மறை விடை", "B": "உறுவது கூறல் விடை", "C": "இனமொழி விடை", "D": "உற்றது உரைத்தல் விடை"}, "explanation": "பாடநூல் பக்கம் 61 மதிப்பீடு வினா 2: 'மட்டைப்பந்து விளையாடத் தெரியுமா? என்னும் வினாவிற்குக் கால்பந்து விளையாடத் தெரியும் என்று கூறுவது இனமொழி விடை ஆகும்'."}, "en": {"blocks": [{"type": "text", "content": "Replying 'I know how to play football' to 'Do you know how to play cricket?' is what type of answer?"}], "options": {"A": "Marai Vidai", "B": "Uruvathu Kooral Vidai", "C": "Inamozhi Vidai", "D": "Urrathu Uraithal Vidai"}, "explanation": "Page 61 evaluation Q2: Answering 'I know football' to 'Do you know cricket?' is Inamozhi Vidai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 61, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bookback", "inamozhi_vidai", "grammar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

