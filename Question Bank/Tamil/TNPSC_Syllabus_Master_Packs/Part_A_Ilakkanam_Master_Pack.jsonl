{"id": "9th-u4-q163", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l6", "chapter_id": null, "topic_id": "pyq-ida-scudder-vellore", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC முந்தைய ஆண்டு வினா] தமிழகத்தில் வேலூரில் பெண்களுக்கெனச் சிறப்பு மருத்துவப் பணிகளையும் மருத்துவக் கல்லூரியையும் (CMC) நிறுவிய அமெரிக்கப் பெண் மருத்துவர் யார்?", "media_id": null}], "options": {"A": "பண்டித ரமாபாய்", "B": "அன்னி பெசன்ட்", "C": "டாக்டர் ஐடா ஸ்கடர் (Dr. Ida Scudder)", "D": "அன்னை தெரசா"}, "explanation": "வேலூரில் பெண்களுக்காகப் பிரசவ மருத்துவமனையைத் தொடங்கி, பின்னர் புகழ்மிக்க சி.எம்.சி (Christian Medical College) மருத்துவக் கல்லூரியை நிறுவியவர் அமெரிக்க மருத்துவர் டாக்டர் ஐடா ஸ்கடர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Previous Year Question] Which pioneering American female physician founded medical relief centers and the prestigious CMC hospital in Vellore, Tamil Nadu?", "media_id": null}], "options": {"A": "Pandita Ramabai", "B": "Annie Besant", "C": "Dr. Ida Scudder", "D": "Mother Teresa"}, "explanation": "Dr. Ida Scudder founded the world-renowned Christian Medical College and hospital in Vellore to provide specialized maternal healthcare."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi