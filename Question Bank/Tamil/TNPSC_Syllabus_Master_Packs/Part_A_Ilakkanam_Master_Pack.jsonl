{"id": "11th_tamil_u7_q144", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "grammar_aakkappeyarkal", "chapter_id": null, "topic_id": "place_noun_aham", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இடப்பெயர் சார்ந்த ஆக்கங்களை உருவாக்கும் '-அகம்' என்னும் விகுதியுடன் அமைந்துள்ள சரியான சொற்களின் தொகுப்பு எது?", "media_id": null}], "options": {"A": "அறிவாளி, முதலாளி, கூட்டாளி", "B": "கட்டுமானம், தேய்மானம், வருமானம்", "C": "ஓட்டுநர், நடத்துநர், இயக்குநர்", "D": "நூலகம், மருந்தகம், உறைவிடம் சார்ந்த பணியகம், அச்சகம்"}, "explanation": "'-அகம்' என்பது இடத்தை அல்லது இருப்பிடத்தைக் குறிக்கும் ஆக்கப்பெயர் விகுதியாகும் (நூல் + அகம் = நூலகம், மருந்து + அகம் = மருந்தகம், அச்சு + அகம் = அச்சகம்)."}, "en": {"blocks": [{"type": "text", "content": "Which set correctly represents locational derivative nouns formed by the locative suffix '-aham'?", "media_id": null}], "options": {"A": "Arivaali, Mudhalaali, Koottaali", "B": "Kattumaanam, Theymaanam, Varumaanam", "C": "Ottunar, Nadathunar, Iyakkunar", "D": "Noolaham (library), Marunthaham (pharmacy), Panniyaham (office), Achaham (press)"}, "explanation": "The formative suffix '-aham' denotes places or establishments (library, pharmacy, printing press)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer K