{"id": "11th_tamil_rev2_q144", "schema_version": "1.0", "kind": "grammar_rule", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u8_grammar_mega_test", "chapter_id": null, "topic_id": "vallinam_migaa_situations", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் இலக்கண விதிகளுள் வல்லினம் மிகா விதி எது?", "media_id": null}], "options": {"A": "ஈறுகெட்ட எதிர்மறைப் பெயரெச்சத்தின் பின் வல்லினம் மிகாது", "B": "உவமைத் தொகையில் வல்லினம் மிகாது", "C": "நான்காம் வேற்றுமை விரியில் வல்லினம் மிகாது", "D": "அத்தனை, இத்தனை, எத்தனை என்னும் சொற்களின் பின் வல்லினம் மிகாது"}, "explanation": "அத்தனை, இத்தனை, எத்தனை என்னும் சொற்களுக்குப் பின் வல்லினம் மிகாது (எ.கா: அத்தனை புத்தகங்கள், எத்தனை குதிரைகள்). ஏனைய மூன்றிலும் வல்லினம் மிகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following represents an authentic rule where Vallinam DOES NOT double?", "media_id": null}], "options": {"A": "Vallinam never doubles after negative relative participles with elided endings", "B": "Vallinam never doubles in simile compounds", "C": "Vallinam never doubles after overt dative marker", "D": "Vallinam DOES NOT double after Atthani, Ithani, Etthani"}, "explanation": "Quantitative adjective markers atthani, ithani, etthani strictly prohibit subsequent hard plosive doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": 