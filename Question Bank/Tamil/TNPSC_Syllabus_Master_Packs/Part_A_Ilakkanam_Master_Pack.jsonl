{"id": "9th-u8-q150", "schema_version": "1.0", "kind": "factual", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l6", "chapter_id": null, "topic_id": "kalaichol-reform", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கலைச்சொல்லறிவோம்: 'Reform' என்ற ஆங்கிலச் சொல்லுக்கு இணையான தமிழ்ச் சொல் எது?", "media_id": null}], "options": {"A": "உருவகம்", "B": "சீர்திருத்தம்", "C": "படிமம்", "D": "புதுக்கவிதை"}, "explanation": "பாடநூல் கலைச்சொல் பட்டியல்: Reform = சீர்திருத்தம்."}, "en": {"blocks": [{"type": "text", "content": "Which Tamil term correctly translates the sociological concept 'Reform'?", "media_id": null}], "options": {"A": "Metaphor", "B": "Seerthirutham (சீர்திருத்தம் - Reform)", "C": "Imagery", "D": "Free verse"}, "explanation": "'Reform' corresponds to 'சீர்திருத்தம்'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 169, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 169", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["9