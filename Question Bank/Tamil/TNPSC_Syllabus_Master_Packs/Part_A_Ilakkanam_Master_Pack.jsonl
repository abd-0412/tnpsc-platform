{"id": "10th-u1-q132", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "eluthu_sol", "chapter_id": null, "topic_id": "muthanilai_thozhirpeyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "விகுதி பெறாமல் வினைப்பகுதியே தொழிற்பெயராய் நின்று பொருள் தருவது எது?", "media_id": null}], "options": {"A": "வினையாலணையும் பெயர்", "B": "எதிர்மறைத் தொழிற்பெயர்", "C": "முதனிலை திரிந்த தொழிற்பெயர்", "D": "முதனிலைத் தொழிற்பெயர்"}, "explanation": "விகுதி பெறாமல் பகுதியே தொழிற்பெயராய் நின்று உணர்த்துவது \"முதனிலைத் தொழிற்பெயர்\" எனப்படும் (எ.கா: தட்டு, உரை, அடி)."}, "en": {"blocks": [{"type": "text", "content": "What is a verbal noun called when the raw verb root itself functions directly as the noun without any suffix?", "media_id": null}], "options": {"A": "Participial noun", "B": "Negative verbal noun", "C": "Modified primary verbal noun", "D": "Primary root verbal noun (Muthanilai Thozhirpeyar)"}, "explanation": "When the bare root acts as the noun without suffixes, it is a Muthanilai Thozhirpeyar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 17, "chapter": null, "section": null, "reference":