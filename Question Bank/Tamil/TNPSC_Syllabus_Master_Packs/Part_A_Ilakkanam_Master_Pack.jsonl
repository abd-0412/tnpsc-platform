{"id": "11th_tamil_rev1_q167", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_1", "lesson_id": "rev_u1_u4_grammar", "chapter_id": null, "topic_id": "panbupeyar_nine_rules_summary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நன்னூலில் பவணந்தி முனிவர் பண்புப்பெயர்ப் புணர்ச்சிக்காக வகுத்துள்ள சூத்திரத்தில் இடம்பெற்றுள்ள மொத்த விதிகளின் எண்ணிக்கை யாது?", "media_id": null}], "options": {"A": "ஐந்து", "B": "ஏழு", "C": "ஒன்பது விதிகள் (\"ஈறு போதல் இடைஉகரம் இய்யாதல்...\")", "D": "பன்னிரண்டு"}, "explanation": "\"ஈறு போதல் இடைஉகரம் இய்யாதல் / ஆதி நீடல் அடிஅகரம் ஐயாதல் / தன்னு ஒற்று இரட்டல் முன்னின்ற மெய்திரிதல் / இனம்மிகல் இணையவும் பண்பிற்கு இயல்பே\" என நன்னூல் 9 விதிகளை வகுத்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "How many canonical sandhi rules are encapsulated in Pavanandhi Munivar's famous Nannool sutra on Panbupeyar Punarchi?", "media_id": null}], "options": {"A": "Five rules", "B": "Seven rules", "C": "Nine rules (Eeru pothal, Idaiyugaram iyyaathal, Aadhi needal...)", "D": "Twelve rules"}, "explanation": "The Panbupeyar sutra encapsulates nine distinct morphophonemic operations."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "1