{"id": "6th-t2-u2-065", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'வென்ரான்' என்பது தவறான சொல்; 'வென்றான்' என்பதே சரியான சொல் ஆகும்.\nகாரணம் (R): றகர வல்லின உயிர்மெய்க்கு (றா = ற்+ஆ) முன்னால் அதன் இன மெல்லினமான றன்னகர (ன்) ஒற்றே வர வேண்டும்; ரகரத்திற்கு முன் அவ்வாறு வருவது பிழையாகும்.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு.", "B": "கூற்று தவறு, காரணம் சரி.", "C": "கூற்று, காரணம் இரண்டும் தவறு.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) கூற்றிற்குரிய சரியான விளக்கம் ஆகும்."}, "explanation": "வென்றான் என்பதே சரியான சொல். ற் என்னும் வல்லினத்திற்கு ன் என்னும் மெல்லினமே இன எழுத்து."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'வென்ரான்' என்பது தவறான சொல்; 'வென்றான்' என்பதே சரியான சொல் ஆகும்.", "reason": "றகர வல்லின உயிர்மெய்க்கு (றா = ற்+ஆ) முன்னால் அதன் இன மெல்லினமான றன்னகர (ன்) ஒற்றே வர வேண்டும்; ரகரத்திற்கு முன் அவ்வாறு வருவது பிழையாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook an