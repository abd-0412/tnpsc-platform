{"id": "11th_tamil_u1_q083", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "payan_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிறப்புப்பாயிர உறுப்புகளில் ‘பயன்’ என்பது எதனைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "நூலை விற்றுக் கிடைக்கும் பொன்", "B": "அரசன் அளிக்கும் நிலக்கொடை", "C": "அந்நூலைக் கற்பதால் மாணவனுக்குக் கிடைக்கும் அறிவு மற்றும் அறப்பயன்", "D": "நூலாசிரியரின் புகழ் மட்டுமே"}, "explanation": "பயன் என்பது அந்நூலைக் கற்பதன் மூலமாக மாணவர் அடையும் இலக்கணத் தெளிவு, மொழியறிவு மற்றும் நற்பயன்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "In Chirappuppaayiram, what does 'Payan' (Benefit) specify?", "media_id": null}], "options": {"A": "Monetary gold earned from book sales", "B": "Land grants bestowed by kings", "C": "The intellectual mastery, linguistic clarity, and moral benefit acquired by the student", "D": "Mere personal fame of the author"}, "explanation": "'Payan' specifies the cognitive and linguistic mastery attained by the learner."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "pa