{"id": "7th-t3-u3-q244", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u3-maanudam", "lesson_id": "lesson-10-malaippozhivu", "chapter_id": null, "topic_id": "ta-t3-u3-sandhi-saanthamudaiyor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'சாந்தம் + உடையோர்' என்பதனைச் சேர்த்து எழுதக் கிடைக்கும் சொல் மற்றும் அதில் அமைந்துள்ள புணர்ச்சி விதிகள் யாவை?"}], "options": {"A": "சாந்தமுடையார் - நெடிலாதல் புணர்ச்சி", "B": "சாந்தஉடையோர் - உடம்படுமெய்ப் புணர்ச்சி", "C": "சாந்தம்மிகவுடையோர் - தோன்றல் புணர்ச்சி", "D": "சாந்தமுடையோர் - உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே"}, "explanation": "'சாந்தம் + உடையோர்' = சாந்தமுடையோர். நிலைமொழி ஈற்றில் உள்ள மகர மெய்யோடு (ம்) வருமொழி முதலில் உள்ள உயிர் (உ) இணைந்து 'மு' என ஆயிற்று (விதி: உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே: ம் + உ = மு)."}, "en": {"blocks": [{"type": "text", "content": "What is the combined form of 'Saantham + udaiyor' and which sandhi rule applies?"}], "options": {"A": "Saanthamudaiyaar - Lengthening sandhi", "B": "Saantha-udaiyor - Udampadumey sandhi", "C": "Saanthammigavudaiyor - Epenthetic sandhi", "D": "Saanthamudaiyor - Udalmael uyirvanthu ondruvathu iyalbae"}, "explanation": "'Saantham + udaiyor' combines as 'Saanthamudaiyor'. The final consonant 'm' merges directly with initial vowel 'u' to form 'mu' ('Udalmael uyirvanthu ondruvathu iyalbae')."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0,