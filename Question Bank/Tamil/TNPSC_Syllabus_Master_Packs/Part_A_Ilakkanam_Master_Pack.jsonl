{"id": "9th-rev-q053", "schema_version": "1.0", "kind": "matching", "level": "knowledge", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u8", "lesson_id": "9th-tamil-u8-l6", "chapter_id": null, "topic_id": "kalaichol-rationalism-humanism-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] கலைச்சொற்கள்: 'Rationalism' மற்றும் 'Humanism' ஆகியவற்றுக்குரிய சரியான தமிழ்ச் சொற்கள் எவை?", "media_id": null}], "options": {"A": "பகுத்தறிவு மற்றும் மனிதநேயம்", "B": "சீர்திருத்தம் மற்றும் பண்பாடு", "C": "தத்துவம் மற்றும் ஆளுமை", "D": "உருவகம் மற்றும் விழுமியம்"}, "explanation": "Rationalism = பகுத்தறிவு; Humanism = மனிதநேயம்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] What are the correct Tamil equivalents for the English terms 'Rationalism' and 'Humanism'?", "media_id": null}], "options": {"A": "Pakutharivu and Manithaneyam (பகுத்தறிவு மற்றும் மனிதநேயம்)", "B": "Seerthirutham and Panpaadu", "C": "Thathuvam and Aalumaai", "D": "Uruvagam and Vizhumiyam"}, "explanation": "'Rationalism' is பகுத்தறிவு; 'Humanism' is மனிதநேயம்."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 169, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 16