{"id": "8th-u6-q832", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l4", "chapter_id": null, "topic_id": "inban-sentence-idaichol-identification", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"இன்பன் வாழைப்பழத்தைவிட மாம்பழத்தைத்தான் விரும்புவான்\" - இத்தொடரில் இடம்பெற்றுள்ள இடைச்சொற்களைச் சரியாகக் குறிப்பிடுக:"}], "options": {"A": "இன்பன், விரும்புவான்", "B": "வாழைப்பழம், மாம்பழம்", "C": "இன்பன், மாம்பழம்", "D": "ஐ (வாழைப்பழத்தை), விட, தான்"}, "explanation": "பாடநூல் பக். 127: இன்பன், வாழைப்பழம், மாம்பழம் ஆகியன பெயர்ச்சொற்கள்; விரும்புவான் என்பது வினைச்சொல்; இதில் இணைந்துள்ள 'ஐ, விட, தான்' என்பனவே இடைச்சொற்கள் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the Idaichol (particles/connectives) present in: 'Inban vaazhaippazhatthaivida maambazhatthaithaan virumbuvaan':"}], "options": {"A": "Inban, virumbuvaan", "B": "Vaazhaippazham, maambazham", "C": "Inban, maambazham", "D": "'Ai' (vaazhaippazhatthai), 'vida', 'thaan'"}, "explanation": "Textbook Page 127: 'Inban', 'vaazhaippazham', and 'maambazham' are nouns; 'virumbuvaan' is a verb; 'ai', 'vida', and 'thaan' are the Idaichol."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 127, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "grammar", "idaichol-identification", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q833", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l5", "chapter_id": null, "topic_id": "siddhars-sentence-correction", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"சித்தர்கள் இயற்கையை விரும்பியவர்கள் அல்லோம்\" - இத்தொடரில் அமைந்துள்ள எதிர்மறைப் பிழையைத் திருத்திச் சரியான தொடரைக் கண்டறிக:"}], "options": {"A": "சித்தர்கள் இயற்கையை விரும்பியவர்கள் அல்லர்", "B": "சித்தர்கள் இயற்கையை விரும்பியவர்கள் அன்று", "C": "சித்தர்கள் இயற்கையை விரும்பியவர்கள் அல்லேன்", "D": "சித்தர்கள் இயற்கையை விரும்பியவர்கள் அல்லீர்"}, "explanation": "'சித்தர்கள்' என்பது படர்க்கைப் பலர்பால் எழுவாய் ஆகும். பலர்பாலுக்குரிய எதிர்மறை வினைமுற்று 'அல்லர்' ஆகும். எனவே 'சித்தர்கள் இயற்கையை விரும்பியவர்கள் அல்லர்' என்பதே பிழையற்ற தூய தமிழ்த் தொடராகும்."}, "en": {"blocks": [{"type": "text", "content": "Correct the negative verb agreement error in the sentence: 'Siddhargal iyarkaiyai virumbiyavargal allom':"}], "options": {"A": "Siddhargal iyarkaiyai virumbiyavargal allar", "B": "Siddhargal iyarkaiyai virumbiyavargal andru", "C": "Siddhargal iyarkaiyai virumbiyavargal allaen", "D": "Siddhargal iyarkaiyai virumbiyavargal alleer"}, "explanation": "'Siddhargal' is third-person epicene plural (Palarbaal), requiring the matching negative verb 'allar'. Hence 'Siddhargal iyarkaiyai virumbiyavargal allar' is correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 129, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "grammar", "sentence-correction", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q834", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l4", "chapter_id": null, "topic_id": "urichol-miguthi-semantics", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"சாலப் பேசினான், தவச்சிறிது, நனிநன்று, கூர்வேல்\" - இத்தொடர்களில் அமைந்துள்ள உரிச்சொற்கள் உணர்த்தும் பொதுவான பொருள் யாது?"}], "options": {"A": "மென்மை", "B": "மிகுதி", "C": "விரைவு", "D": "காவல்"}, "explanation": "சால, தவ, நனி, கூர், கழி, உறு முதலான உரிச்சொற்கள் யாவும் 'மிகுதி' என்னும் ஒரு பொதுப் பொருளைத் தரும் பல சொற்கள் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the common meaning denoted by the Urichol in: 'Saalap pesinaan', 'Thavacchirithu', 'Naninandru', and 'Koorvel'?"}], "options": {"A": "Gentleness / softness (Menmai)", "B": "Abundance / intensity (Miguthi)", "C": "Speed / haste (Viraivu)", "D": "Security / guardianship (Kaaval)"}, "explanation": "Saala, thava, nani, koor, kazhi, and uru are multiple Urichol words denoting the single semantic attribute of 'Miguthi' (intensity/abundance)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 128, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "grammar", "urichol-semantics", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q835", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l4", "chapter_id": null, "topic_id": "sariyai-identification", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் தொடர்களுள் 'சாரியை' என்னும் இடைச்சொல் வெளிப்பட்டு இணைந்துள்ள தொடரைக் கண்டறிக:"}], "options": {"A": "அவன் வேகமாக ஓடினான்", "B": "மதுரைக்குச் சென்றான்", "C": "புளியங்காய் தின்றான் ('அம்' சாரியை)", "D": "தீயை அணைத்தான்"}, "explanation": "பாடநூல் பக். 127: 'புளியங்காய்' என்பதில் 'புளி + அம் + காய்' என 'அம்' என்ற சாரியை இடைச்சொல் பயின்றுவந்துள்ளது. மற்ற தொடர்களில் வேற்றுமை உருபுகள் வந்துள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Which of the following compounds exhibits the overt presence of the inflectional increment 'Saariyai'?"}], "options": {"A": "Avan vegamaaga odinaan", "B": "Maduraikkuc chendraan", "C": "Puliyangaai thinraan ('am' saariyai)", "D": "Theeyai anaithaan"}, "explanation": "Textbook Page 127: In 'Puliyangaai' (Puli + am + kaai), 'am' functions as the inflectional increment Saariyai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 127, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "iyal-6", "grammar", "saariyai", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u6-q836", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-u6-l4", "chapter_id": null, "topic_id": "miguthi-urichol-odd-one", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மிகுதி' என்னும் பொருள் தரும் உரிச்சொற்களின் தொகுப்பில் பொருந்தாத ஒன்றைத் தேர்க:"}], "options": {"A": "சால", "B": "தவ", "C": "நனி", "D": "கடி"}, "explanation": "சால, தவ, நனி ஆகியவை 'மிகுதி' என்னும் ஒரே பொருள் தரும் பல உரிச்சொற்கள். ஆனால் 'கடி' என்பது மணம், காவல், விரைவு, கூர்மை எனப் பல பொருள் தரும் ஒரு சொல் ஆகும். எனவே பொருந்தாதது 'கடி'."}, "en": {"blocks": [{"type": "text", "content": "Select the word that does NOT belong to the group of Urichol denoting 'Miguthi' (abundance/intensity):"}], "options": {"A": "Saala", "B": "Thava", "C": "Nani", "D": "Kadi"}, "explanation": "'Saala', 'thava', and 'nani' all signify 'abundance'. 'Kadi', however, is a polysemous word denoting fragrance, guard, speed, and sharpness. Hence 'Kadi' is the odd one."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 128, "chapter": null, "section": null,