{"id": "10th-u1-q120", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "eluthu_sol", "chapter_id": null, "topic_id": "otralabedai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒற்றளபெடையில் அளபெடுக்கும் மொத்த எழுத்துகளின் எண்ணிக்கை எத்தனை?", "media_id": null}], "options": {"A": "8 எழுத்துகள்", "B": "9 எழுத்துகள்", "C": "10 எழுத்துகள்", "D": "11 எழுத்துகள்"}, "explanation": "மெல்லின மெய்கள் 6 (ங், ஞ், ண், ந், ம், ன்) + இடையின மெய்கள் 4 (ய், ர், ழ் தவிர்ந்த ய், வ், ல், ள்) + ஆய்த எழுத்து 1 (ஃ) ஆக மொத்தம் 11 எழுத்துகள் ஒற்றளபெடையில் அளபெடுக்கும்."}, "en": {"blocks": [{"type": "text", "content": "What is the total count of letters that can undergo consonant elongation (Otrralabedai)?", "media_id": null}], "options": {"A": "8 letters", "B": "9 letters", "C": "10 letters", "D": "11 letters"}, "explanation": "Exactly 11 letters undergo Otrralabedai (10 consonants + 1 Aytham)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 16, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 16", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam