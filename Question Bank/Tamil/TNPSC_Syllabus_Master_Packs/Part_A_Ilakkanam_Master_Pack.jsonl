{"id": "8th-u3-q391", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u3-kalvi", "lesson_id": "lesson-16-vinaimutru", "chapter_id": null, "topic_id": "ta-8th-u3-direct-viyangol-moods-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வியங்கோள் வினைமுற்று வாழ்த்துதல், வைதல், விதித்தல், வேண்டல் என எத்தனை பொருள்களில் வரும்?"}], "options": {"A": "இரண்டு பொருள்களில்", "B": "மூன்று பொருள்களில்", "C": "நான்கு பொருள்களில்", "D": "ஐந்து பொருள்களில்"}, "explanation": "பாடநூல் பக்கம் 61: வாழ்த்துதல், வைதல், விதித்தல், வேண்டல் ஆகிய நான்கு பொருள்களில் வரும் வினைமுற்று வியங்கோள் வினைமுற்று ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "In how many semantic moods (such as blessing, cursing, enjoining, entreating) does an optative verb occur?"}], "options": {"A": "Two moods", "B": "Three moods", "C": "Four moods", "D": "Five moods"}, "explanation": "Textbook page 61: Optative verbs express exactly four semantic moods: benediction, malediction, prescription, and supplication. Option C is correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 61, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["direct", "viyangol", "moods_count"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

