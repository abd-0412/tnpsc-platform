{"id": "6th-t2-u1-026", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): நடப்பு ஆங்கில ஆண்டு 2026 எனில், திருவள்ளுவர் ஆண்டு 2057 ஆகும்.\nகாரணம் (R): திருவள்ளுவர் கிறிஸ்து பிறப்பதற்கு 31 ஆண்டுகளுக்கு முன்பு (கி.மு. 31) பிறந்தவர் என்பதால் நடப்பு ஆண்டுடன் 31-ஐக் கூட்ட வேண்டும்.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) சரியான கணித விளக்கம் ஆகும்.", "B": "கூற்று தவறு, காரணம் சரி.", "C": "கூற்று, காரணம் இரண்டும் தவறு.", "D": "கூற்று சரி, காரணம் தவறு."}, "explanation": "திருவள்ளுவர் ஆண்டு = ஆங்கில ஆண்டு + 31. எனவே 2026 + 31 = 2057. கூற்று, காரணம் இரண்டும் மிகச்சரி."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "நடப்பு ஆங்கில ஆண்டு 2026 எனில், திருவள்ளுவர் ஆண்டு 2057 ஆகும்.", "reason": "திருவள்ளுவர் கிறிஸ்து பிறப்பதற்கு 31 ஆண்டுகளுக்கு முன்பு (கி.மு. 31) பிறந்தவர் என்பதால் நடப்பு ஆண்டுடன் 31-ஐக் கூட்ட வேண்டும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 7", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u1-024", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தை முதல் நாள் உழவர்கள் அறுவடை செய்து முடித்த புது நெல்லினைப் பொங்கலிட்டு இயற்கைக்கு நன்றி செலுத்துகின்றனர்.\nகாரணம் (R): உழவர்கள் சித்திரை மாதத்தில் நெல் அறுவடை செய்வதால் தை மாதத்தில் ஓய்வெடுப்பதற்காகப் பொங்கல் கொண்டாடுகின்றனர்.", "media_id": null}], "options": {"A": "கூற்று மற்றும் காரணம் இரண்டும் சரி.", "B": "கூற்று சரி, ஆனால் காரணம் முற்றிலும் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "கூற்று சரி, காரணம் தவறு. ஆடி மாதத்தில் விதைத்துத் தை மாதத்தில்தான் உழவர்கள் நெல் அறுவடை செய்கின்றனர்; எனவே புது நெல்லினால் பொங்கலிட்டு தை 1-இல் அறுவடைத் திருநாள் கொண்டாடுகின்றனர்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "தை முதல் நாள் உழவர்கள் அறுவடை செய்து முடித்த புது நெல்லினைப் பொங்கலிட்டு இயற்கைக்கு நன்றி செலுத்துகின்றனர்.", "reason": "உழவர்கள் சித்திரை மாதத்தில் நெல் அறுவடை செய்வதால் தை மாதத்தில் ஓய்வெடுப்பதற்காகப் பொங்கல் கொண்டாடுகின்றனர்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_na