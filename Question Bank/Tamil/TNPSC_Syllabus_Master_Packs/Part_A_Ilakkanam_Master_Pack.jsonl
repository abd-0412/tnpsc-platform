{"id": "9th-u1-q089", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u1-mozhi", "lesson_id": "lesson-04-aaram-thinai", "chapter_id": null, "topic_id": "topic-muthulingam-bio-awards", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஆறாம் திணை' என்னும் விரிவானப் பகுதியை எழுதிய அ. முத்துலிங்கம் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. இவர் இலங்கையில் உள்ள யாழ்ப்பாணத்துக்கு அருகில் உள்ள கொக்குவில் கிராமத்தில் பிறந்தவர்.\n2. இவரது 'அக்கா' என்னும் சிறுகதைத் தொகுதி தமிழ்நாடு அரசின் முதல் பரிசினைப் பெற்றது.\n3. 'வம்சவிருத்தி' என்னும் சிறுகதைத் தொகுதிக்காக 1999-இல் தமிழ்நாடு அரசின் பரிசினைப் பெற்றார்.\nமேற்கண்ட கூற்றுகளுள் சரியானவை எவை?", "media_id": null}], "options": {"A": "அனைத்தும் சரி", "B": "1, 2 மட்டும் சரி", "C": "2, 3 மட்டும் சரி", "D": "1, 3 மட்டும் சரி"}, "explanation": "பாடநூல் பக். 15 நூல் வெளி: அ. முத்துலிங்கம் யாழ்ப்பாணம் கொக்குவிலில் பிறந்தவர்; 'அக்கா' தமிழக அரசு பரிசு; 'வம்சவிருத்தி' 1999 தமிழக அரசு பரிசு. அனைத்தும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements concerning writer A. Muthulingam, author of 'Aaram Thinai':\n1. He was born in Kokkuvil village near Jaffna in Sri Lanka.\n2. His short story collection 'Akka' won the First Prize from the Government of Tamil Nadu.\n3. His anthology 'Vamsaviruthi' was awarded the Tamil Nadu State Award in 1999.\nWhich statements are correct?", "media_id": null}], "options": {"A": "All are correct", "B": "1 and 2 only are correct", "C": "2 and 3 only are correct", "D": "1 and 3 only are correct"}, "explanation": "All three biographical and award details match the textbook page 15 profile."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 15, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 15", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["aaram_thinai", "muthulingam", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T09:50:00Z", "updated_at": "2026-11-04T09:50:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
