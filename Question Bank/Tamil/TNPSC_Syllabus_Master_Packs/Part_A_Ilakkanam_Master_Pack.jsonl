{"id": "8th-booster-q1282", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u2-iyarkai", "lesson_id": "8th-booster-pyq", "chapter_id": null, "topic_id": "pyq-vinaithogai-identification", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "TNPSC அண்மைக்கால வினா: 'சுடுசோறு' - இச்சொல்லின் சரியான இலக்கணக் குறிப்பினைத் தேர்க:"}], "options": {"A": "பண்புத்தொகை", "B": "வினைத்தொகை (சுட்ட சோறு, சுடுகின்ற சோறு, சுடும் சோறு என முக்காலத்திற்கும் விரியும்)", "C": "உவமைத்தொகை", "D": "உம்மைத்தொகை"}, "explanation": "TNPSC Group 4 (2022) & பாடநூல் பக். 111: 'சுடு' என்ற வினைப்பகுதி 'சோறு' என்ற பெயர்ச்சொல்லோடு இணைந்து முக்கால இடைநிலையும் தொக்கு நின்றதால் 'வினைத்தொகை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "TNPSC Recent PYQ: Identify the exact grammatical classification for 'Sudusoru':"}], "options": {"A": "Panbuthogai", "B": "Vinaithogai (Spanning past, present, future: 'sutta soru', 'sudugindra soru', 'sudum soru')", "C": "Uvamaithogai", "D": "Ummaithogai"}, "explanation": "TNPSC Group 4 (2022): 'Sudusoru' is an archetype of Vinaithogai, spanning all three tenses with elision of tense infixes."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Ed