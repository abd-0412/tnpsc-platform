{"id": "11th_tamil_rev2_q124", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_interview_proof_names", "chapter_id": null, "topic_id": "aakkappeyar_maan_suffix", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மான்’ என்னும் பின்னொட்டு பெற்று வரும் ஆக்கப்பெயருக்குச் சான்று எது?", "media_id": null}], "options": {"A": "வருமானம்", "B": "தேய்மானம்", "C": "கட்டுமானம்", "D": "மேற்கண்ட அனைத்தும்"}, "explanation": "வரு + மான் = வருமானம்; தேய் + மான் = தேய்மானம்; கட்டு + மான் = கட்டுமானம் என வினை வேர்களோடு 'மான்' பின்னொட்டு இணைந்து தொழிற்பெயர் ஆக்கப்பெயர்களாகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Which words exemplify derived nominals ending in the deverbal suffix '-Maan'?", "media_id": null}], "options": {"A": "Varumaanam (Income)", "B": "Theiymaanam (Depreciation)", "C": "Kattumaanam (Construction)", "D": "All the above"}, "explanation": "The nominalizing suffix '-Maan' derives abstract verbal nouns from verb roots."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 191, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack