{"id": "6th-t2-u1-030", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): விருந்தினரை முகம் மலர்ந்து வரவேற்க வேண்டும் என்று வள்ளுவர் வலியுறுத்துகிறார்.\nகாரணம் (R): அனிச்ச மலர் மோந்து பார்த்தால் வாடுவது போல, நம் முகம் மாறினாலே விருந்தினர் உள்ளம் வாடிவிடும்.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்.", "B": "கூற்று சரி, காரணம் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "'மோப்பக் குழையும் அனிச்சம் முகந்திரிந்து நோக்கக் குழையும் விருந்து' என்ற குறள் விருந்தினர் உள்ளத்தின் மென்மையை அனிச்ச மலரோடு ஒப்பிட்டு விளக்குகிறது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "விருந்தினரை முகம் மலர்ந்து வரவேற்க வேண்டும் என்று வள்ளுவர் வலியுறுத்துகிறார்.", "reason": "அனிச்ச மலர் மோந்து பார்த்தால் வாடுவது போல, நம் முகம் மாறினாலே விருந்தினர் உள்ளம் வாடிவிடும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation"