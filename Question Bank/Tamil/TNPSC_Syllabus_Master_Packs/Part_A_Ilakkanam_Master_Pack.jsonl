{"id": "11th_tamil_u4_q152", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "grammar_padaippaakka_uthigal", "chapter_id": null, "topic_id": "ezra_pound_imagism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மேலைநாட்டு இலக்கியத்தில் 20-ஆம் நூற்றாண்டின் தொடக்கத்தில் ‘படிமவியல் இயக்கம்’ (Imagism Movement) யாரால் முன்னெடுக்கப்பட்டது?", "media_id": null}], "options": {"A": "ஷேக்ஸ்பியர்", "B": "மில்டன்", "C": "வேர்ட்ஸ்வொர்த்", "D": "எஸ்ரா பவுண்ட் (Ezra Pound) மற்றும் டி.இ. ஹியூம்"}, "explanation": "20-ஆம் நூற்றாண்டின் தொடக்கத்தில் ஆங்கிலக் கவிதையில் அலங்காரச் சொற்களைத் தவிர்த்து துல்லியமான படிமங்களை முன்னிறுத்தியவர் எஸ்ரா பவுண்ட் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Which 20th-century Western poet-critic pioneered the influential Imagism Movement in modern poetry?", "media_id": null}], "options": {"A": "William Shakespeare", "B": "John Milton", "C": "William Wordsworth", "D": "Ezra Pound (along with T. E. Hulme)"}, "explanation": "Ezra Pound and T. E. Hulme pioneered modern Imagism."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 88, "chapter": null, "section": null, "r