{"id": "9th-u4-q047", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u4-kalvi", "lesson_id": "lesson-01-kalviyil-sirantha-pengal", "chapter_id": null, "topic_id": "topic-kalviyil-sirantha-pengal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வடசொற்களுக்கு இணையான தூய தமிழ்ச் சொற்களைக் கொண்டு 'வடசொல்-தமிழ் அகரவரிசை' என்னும் ஒப்பற்ற அகராதியைத் தொகுத்தளித்தவர் யார்?", "media_id": null}], "options": {"A": "மறைமலையடிகள்", "B": "தேவநேயப் பாவாணர்", "C": "நீலாம்பிகை அம்மையார்", "D": "பெருஞ்சித்திரனார்"}, "explanation": "வடமொழிச் சொற்கள் கலவாமல் தூய தமிழில் எழுத விரும்பும் தமிழர்களுக்குப் பயன்படும் வகையில் 'வடசொல்-தமிழ் அகரவரிசை' தொகுத்தளித்தவர் நீலாம்பிகை அம்மையார் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who compiled the invaluable dictionary 'Vadasol - Thamizh Agaravarisai' supplying pure Tamil synonyms for Sanskrit loanwords?", "media_id": null}], "options": {"A": "Maraimalai Adigal", "B": "Devaneya Pavanar", "C": "Neelambigai Ammaiyar", "D": "Perunchithiranar"}, "explanation": "Neelambigai Ammaiyar authored this benchmark lexicon providing authentic Tamil linguistic equivalents for northern loanwords."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class