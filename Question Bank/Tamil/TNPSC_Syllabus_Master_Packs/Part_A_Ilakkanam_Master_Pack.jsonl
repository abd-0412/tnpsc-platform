{"id": "12th_tamil_u7_q1304", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "kambar_erezhupathu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘மேழி பிடிக்கும் கை வேந்தர் கைத்தலத்தை காக்கும்’ என்ற கம்பரின் ஏரெழுபது வரிகளில் வெளிப்படும் தொன்மப் படிமம் எது?", "media_id": null}], "options": {"A": "போர்க்கருவிகளின் மேன்மை", "B": "அரசரின் மணிமுடிப் பெருமை", "C": "வணிகரின் தராசு நேர்மை", "D": "உழவுத் தொழிலின் உலகளாவிய தாய்ப்பண்பும் முதன்மையும்"}, "explanation": "உழவுத் தொழில் உலக உயிர்களுக்கெல்லாம் உணவளித்து அரசையும் தாங்கும் வாழ்வாதாரத் தொன்மமாகப் போற்றப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which archetypal motif is celebrated in Kambar's Er Ezhupathu praising the farmer's ploughshare protecting the sovereign?", "media_id": null}], "options": {"A": "Superiority of weapons", "B": "Majesty of royal crown", "C": "Fairness of merchant scale", "D": "Universal nurturing maternal archetype and supreme primacy of agriculture"}, "explanation": "Agriculture is elevated as the foundational archetype feeding life and sustaining earthly sovereigns."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 186, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 186", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Grammar", "Kambar Er Ezhupathu"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1305", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "indira_parthasarathy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘அசுவத்தாமன்’ என்னும் மகாபாரதக் கதாபாத்திரத்தின் தீராத சாபத்தை நவீன மனிதனின் தார்மீகக் குற்ற உணர்ச்சிக்கு ஒப்பிட்டு நாடகம் எழுதியவர் யார்?", "media_id": null}], "options": {"A": "இந்திரா பார்த்தசாரதி (ஔரங்கசீப் / தர்மம் நாடகங்கள்)", "B": "சுஜாதா", "C": "நா. பார்த்தசாரதி", "D": "ஜெயகாந்தன்"}, "explanation": "இந்திரா பார்த்தசாரதி தொன்மங்களையும் வரலாற்றுக் கதைமாந்தர்களையும் நவீன மனிதனின் அகமுரண்களை ஆராயும் நாடகக் குறியீடுகளாகப் பயன்படுத்தியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who deployed the Mahabharata figure of Ashwatthama cursed with incurable wounds to signify modern man's moral guilt?", "media_id": null}], "options": {"A": "Indira Parthasarathy", "B": "Sujatha", "C": "Na. Parthasarathy", "D": "Jayakanthan"}, "explanation": "Indira Parthasarathy effectively employed mythic characters to dissect the ethical angst and guilt of contemporary human civilization."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_