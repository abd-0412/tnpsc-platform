{"id": "11th_tamil_rev2_q055", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u6_modern_grammar", "chapter_id": null, "topic_id": "antru_intru_vallinam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வல்லினம் மிகாத் தொடர்களில் சரியான ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "கண்ணைத் திறந்தான்", "B": "நாளைப் போவான்", "C": "அன்று சொன்னார்", "D": "இனிப் பேசுவார்"}, "explanation": "அன்று, இன்று, என்று என்னும் இடைச்சொற்களின் பின் வல்லினம் மிகாது (அன்று சொன்னார்)."}, "en": {"blocks": [{"type": "text", "content": "Select the phrase that correctly preserves the absence of Vallinam doubling:", "media_id": null}], "options": {"A": "Kannai-th thiranthaan", "B": "Naalai-p povaan", "C": "Antru sonnaar", "D": "Ini-p pesuvaar"}, "explanation": "Vallinam does not double after the temporal particles antru, intru, entru."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 161, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 161", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "ex