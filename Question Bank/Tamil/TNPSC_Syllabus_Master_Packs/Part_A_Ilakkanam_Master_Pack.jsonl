{"id": "11th_tamil_u5_q150", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "grammar_paa_vagaigal", "chapter_id": null, "topic_id": "kural_venba_line_structure", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறள் வெண்பாவின் அடி மற்றும் சீர் அமைப்பு எவ்வாறானது?", "media_id": null}], "options": {"A": "முதலடி முச்சீர், இரண்டாம் அடி நாற்சீர்", "B": "முதலடி நாற்சீர் (அளவடி), இரண்டாம் அடி முச்சீர் (சிந்தடி) மொத்தம் 7 சீர்கள்", "C": "இரண்டு அடிகளும் நாற்சீர்கள்", "D": "இரண்டு அடிகளும் முச்சீர்கள்"}, "explanation": "குறள் வெண்பா முதலடி நான்கு சீர்களும் (அளவடி), இரண்டாம் அடி மூன்று சீர்களும் (சிந்தடி) பெற்று மொத்தம் ஏழு சீர்களால் அமையும்."}, "en": {"blocks": [{"type": "text", "content": "What is the line and foot structure of Kural Venba?", "media_id": null}], "options": {"A": "First line 3 feet, second line 4 feet", "B": "First line 4 feet (Alavadi), second line 3 feet (Sinthadi), totaling 7 feet", "C": "Both lines 4 feet each", "D": "Both lines 3 feet each"}, "explanation": "A Kural Venba has 4 feet in the first line and 3 feet in the second line, making 7 feet in total."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year",