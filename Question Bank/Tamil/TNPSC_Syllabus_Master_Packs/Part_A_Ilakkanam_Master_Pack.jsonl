{"id": "10th-u1-q004", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "tamil_sol_valam", "chapter_id": null, "topic_id": "adi_vagai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குத்துச்செடி, புதர் ஆகியவற்றின் அடிப்பகுதியைத் தமிழிலக்கணப்படி எவ்வாறு அழைப்பர்?", "media_id": null}], "options": {"A": "கட்டை", "B": "கழை", "C": "தண்டு", "D": "தூறு"}, "explanation": "குத்துச்செடி, புதர் முதலியவற்றின் அடிப்பகுதி \"தூறு\" எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "According to Tamil plant terminology, what is the base of a bush or shrub called?", "media_id": null}], "options": {"A": "Kattai", "B": "Kazhai", "C": "Thandu", "D": "Thooru"}, "explanation": "The base of a bush or shrub is called \"Thooru\"."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 3", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["தமிழ்ச்சொல் வளம்", "அடிவகை", "தூற