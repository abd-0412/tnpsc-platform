{"id": "9th-u4-q158", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l6", "chapter_id": null, "topic_id": "pyq-pandita-ramabai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC முந்தைய ஆண்டு வினா] பெண் விடுதலைக்கும் ஒடுக்கப்பட்ட மக்களின் முன்னேற்றத்திற்கும் தன் வாழ்வை அர்ப்பணித்த பண்டித ரமாபாய் சமூக சேவைகளுக்காக ஆங்கிலேய அரசால் வழங்கப்பட்ட விருது எது?", "media_id": null}], "options": {"A": "பாரத ரத்னா", "B": "கைசர்-இ-ஹிந்த் (Kaisar-i-Hind)", "C": "பத்ம விபூஷண்", "D": "வீரமங்கை விருது"}, "explanation": "பண்டித ரமாபாயின் இணையற்ற கல்வி மற்றும் சமூக நலப் பணிகளைப் பாராட்டி பிரிட்டிஷ் அரசாங்கம் 1919-ல் 'கைசர்-இ-ஹிந்த்' (Kaisar-i-Hind) தங்கப் பதக்கத்தை வழங்கி கௌரவித்தது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Previous Year Question] Which imperial decoration was conferred on Pandita Ramabai by the British government for her humanitarian social service?", "media_id": null}], "options": {"A": "Bharat Ratna", "B": "Kaisar-i-Hind Gold Medal", "C": "Padma Vibhushan", "D": "Veeramangai Award"}, "explanation": "In 1919, the British Crown conferred the prestigious Kaisar-i-Hind medal on Pandita Ramabai for community service."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textboo