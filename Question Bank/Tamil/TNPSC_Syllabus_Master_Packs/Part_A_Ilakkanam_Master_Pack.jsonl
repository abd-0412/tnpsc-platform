{"id": "11th_tamil_u1_q082", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "ketpor_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிறப்புப்பாயிரத்தில் ‘கேட்போர்’ என்பது எவரைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "அரண்மனை இசைப் பாடகர்களை", "B": "அந்நூலைக் கற்றுப் பயன்பெறும் தகுதியுடைய மாணவர் அல்லது வாசகர்களை", "C": "போரில் புறமுதுகிட்டு ஓடியவர்களை", "D": "நீதிமன்ற நீதிபதிகளை"}, "explanation": "கேட்போர் என்பது இந்நூலைக் கேட்டுப் பயிலத் தகுதியுடைய தகுதியான மாணவர்கள் மற்றும் வாசகர்களைக் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "In Chirappuppaayiram, whom does 'Ketpoar' represent?", "media_id": null}], "options": {"A": "Palace musicians", "B": "Qualified students and receptive seekers fit to study the work", "C": "Soldiers fleeing battlefield", "D": "Court magistrates"}, "explanation": "'Ketpoar' refers to the eligible audience/students deserving to learn the treatise."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 7, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1