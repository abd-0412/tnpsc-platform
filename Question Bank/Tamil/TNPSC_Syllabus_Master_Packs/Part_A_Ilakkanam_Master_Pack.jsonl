{"id": "7th-t1-u1-048", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l2-ondralla-irandalla", "chapter_id": null, "topic_id": "sandhi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'இரண்டல்ல' என்னும் சொல்லைப் பிரித்து எழுதும் முறை மற்றும் அதன் புணர்ச்சி விதியைக் கண்டறிக:"}], "options": {"A": "இரண் + அல்ல (தோன்றல் விகாரம்)", "B": "இரண்டு + தல்ல (வலிமிகல் விதி)", "C": "இரண்டு + நல்ல (இயல்பு புணர்ச்சி)", "D": "இரண்டு + அல்ல (\"உயிர்வரின் உக்குறள் மெய்விட்டோடும்\" விதிப்படி ட் + அ = ட)"}, "explanation": "இரண்டு + அல்ல: நிலைமொழி ஈற்றில் உள்ள குற்றியலுகரம் (டு = ட்+உ) வருமொழி முதலில் உயிர் (அ) வந்ததால் உகரம் மெய்யை விட்டு ஓடி, ட்+அ=ட என்றாகி 'இரண்டல்ல' எனப் புணர்ந்தது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the grammatical splitting and sandhi rules for 'Irandalla':"}], "options": {"A": "Iran + alla", "B": "Irandu + thalla", "C": "Irandu + nalla", "D": "Irandu + alla (Kutriyalugaram sandhi: t + a = da)"}, "explanation": "Irandu + alla: Under 'Uyirvarin ukkural meivittodum', 'u' drops, yielding t + a = da (Irandalla)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation"