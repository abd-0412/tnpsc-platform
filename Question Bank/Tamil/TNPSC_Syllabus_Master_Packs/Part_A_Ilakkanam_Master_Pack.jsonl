{"id": "9th-rev-q021", "schema_version": "1.0", "kind": "factual", "level": "comprehension", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u1", "lesson_id": "9th-tamil-u1-l5", "chapter_id": null, "topic_id": "thanvinai-piravinai-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] \"பந்து உருண்டது\", \"பந்தை உருட்டினான்\" - இவ்விரு தொடர்கள் முறையே எவ்வகை வினைகள்?", "media_id": null}], "options": {"A": "தன்வினை மற்றும் பிறவினை", "B": "பிறவினை மற்றும் தன்வினை", "C": "செய்வினை மற்றும் செயப்பாட்டுவினை", "D": "உடன்பாட்டு வினை மற்றும் எதிர்மறை வினை"}, "explanation": "எழுவாய் தானே வினையைச் செய்தால் தன்வினை (பந்து உருண்டது); எழுவாய் ஒரு வினையைச் செய்ய வைத்தால் பிறவினை (பந்தை உருட்டினான்)."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] In the sentences 'Panthu urundathu' and 'Panthai uruttinaan', what types of verbs are represented respectively?", "media_id": null}], "options": {"A": "Thanvinai (direct/intransitive) and Piravinai (causative/transitive) (தன்வினை, பிறவினை)", "B": "Piravinai and Thanvinai", "C": "Active voice and Passive voice", "D": "Affirmative and Negative"}, "explanation": "'Urundathu' is Thanvinai; 'Uruttinaan' is Piravinai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term":