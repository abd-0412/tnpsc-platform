{"id": "7th-t3-u1-q079", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-03-tirunelveli-seemaiyum-kavigalum", "chapter_id": null, "topic_id": "ta-t3-u1-grammar-uruppilakkanam-kanikoduthu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கொடுத்து' என்னும் சொல்லின் சரியான உறுப்பிலக்கணப் பகுப்பைத் தேர்வு செய்க:"}], "options": {"A": "கொடு + த் + த் + உ", "B": "கொடு + த் + து", "C": "கொடுத் + து", "D": "கொடு + உ"}, "explanation": "'கொடுத்து' பகுப்பாய்வு:\nகொடு = பகுதி\nத் = சந்தி\nத் = இறந்தகால இடைநிலை\nஉ = வினையெச்ச விகுதி.\nகொடு + த் + த் + உ = கொடுத்து."}, "en": {"blocks": [{"type": "text", "content": "Select the correct grammatical morphological parsing (Uruppilakkanam) for 'Koduthu':"}], "options": {"A": "Kodu + th + th + u", "B": "Kodu + th + thu", "C": "Koduth + thu", "D": "Kodu + u"}, "explanation": "Parsing of 'Koduthu': Kodu (root) + th (junction consonant/sandhi) + th (past tense marker) + u (verbal participle suffix). Option A is correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 11, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tirunelveli_poets", "grammar", "uruppilakkanam"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

# ==============================================================================
# 7-ஆம் வகுப்பு - வழக்கு இரு வகை: 1. இயல்பு வழக்கு (இலக்கணம் உடையது: நிலம்/மரம்; இலக்கணப் போலி / முன்பின் மாறாகத் தொக்க போலி: முன்றில்/புறநகர்; மரூஉ: கோவை/தஞ்சை/நெல்லை/எந்தை), 2. தகுதி வழக்கு (இடக்கரடக்கல்: கால் கழுவி வந்தான்; மங்கலம்: செத்தார்->இயற்கை எய்தினார், சுடுகாடு->நன்காடு, விளக்கை குளிரவை; குழூஉக்குறி: பொற்கொல்லர் பொன்னை 'பறி' எனல், பாகர் ஆடையைக் 'காரை' எனல்), போலி வகைகள் (முதற்போலி: பசல்->பைசல்; இடைப்போலி: அமச்சு->அமைச்சு; கடைப்போலி: நிலம்->நிலன், பந்தல்->பந்தர்; முற்றுப்போலி: ஐந்து->அஞ்சு), கலைச்சொற்கள் (Civilization, Folklore, Harvest, Irrigation, Foreign Trade, Agriculture, Poet, Paddy)
