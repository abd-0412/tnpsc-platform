{"id": "11th_tamil_u1_q070", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "three_extra_items", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிறப்புப்பாயிரத்தின் எட்டுப் பொருள்களோடு பின்னர் சேர்க்கப்பட்ட கூடுதல் மூன்று கூறுகள் எவை?", "media_id": null}], "options": {"A": "அரசன், அமைச்சர், படைத்தளபதி", "B": "காலம், களம், காரணம்", "C": "மலர், மாலை, சந்தனம்", "D": "பொருளாதாரம், சமூகம், அரசியல்"}, "explanation": "நூல் இயற்றப்பட்ட காலம், அரங்கேற்றப்பட்ட களம், இயற்றப்பட்டதற்கான காரணம் ஆகிய மூன்றும் பின்னர் சிறப்புப்பாயிரத்தில் சேர்க்கப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "What are the three additional contextual components incorporated into Chirappuppaayiram alongside the primary eight?", "media_id": null}], "options": {"A": "Monarch, Minister, Commander", "B": "Kaalam (Time), Kalam (Forum/Court), Kaaranam (Reason/Purpose)", "C": "Flower, Garland, Sandal", "D": "Economics, Society, Politics"}, "explanation": "Time, forum/assembly, and motivating cause constitute the three supplementary dimensions."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 7, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 7", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Grammar", "Chirappuppaayiram"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q072", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "paayiram_etymology", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘பாயிரம்’ என்னும் சொல் எதனை உணர்த்துகிறது?", "media_id": null}], "options": {"A": "நூலின் முடிவுரை", "B": "நூலில் உள்ள பிழைகளின் பட்டியல்", "C": "பாடல்களின் சந்த வரிசை", "D": "நூலின் முகப்பில் வைக்கப்படும் அறிமுக உரை (முன்னுரை)"}, "explanation": "நூலை இயற்றுவதற்கு முன்னதாக நூலின் சிறப்பையும் மாண்பையும் எடுத்துக் கூறும் முகவுரையே ‘பாயிரம்’ எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What does the term 'Paayiram' fundamentally designate in classical Tamil treatises?", "media_id": null}], "options": {"A": "Concluding epilogue", "B": "Errata of printing mistakes", "C": "Prosodic meter rhythm table", "D": "Comprehensive introductory preface set at the threshold of a treatise"}, "explanation": "'Paayiram' designates the formal scholarly preface/prolegomena preceding a book."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": "1