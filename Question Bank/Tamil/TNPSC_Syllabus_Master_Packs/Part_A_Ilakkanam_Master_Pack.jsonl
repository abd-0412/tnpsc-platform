{"id": "7th-t1-u1-050", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l2-ondralla-irandalla", "chapter_id": null, "topic_id": "sandhi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஒப்புமையில்லாத' என்னும் சொல்லில் உடம்படுமெய் தோன்றுவதற்கான சரியான இலக்கண விதி யாது?"}], "options": {"A": "உயிர்வரின் உக்குறள் மெய்விட்டோடும்", "B": "\"இ ஈ ஐ வழி யவ்வும்\" (ஒப்புமை [ஐ] + ய் + இல்லாத = ஒப்புமையில்லாத)", "C": "ஏனை உயிர்வழி வவ்வும்", "D": "தனிக்குறில் முன் ஒற்று இரட்டும்"}, "explanation": "நிலைமொழியின் ஈற்றில் 'ஐ'காரம் வந்ததால் 'இ ஈ ஐ வழி யவ்வும்' என்ற விதிப்படி 'ய்' என்னும் உடம்படுமெய் தோன்றி 'ஒப்புமையில்லாத' எனப் புணர்ந்தது."}, "en": {"blocks": [{"type": "text", "content": "Which morpho-phonemic rule governs the 'y' insertion in 'Oppumaiyillaadha'?"}], "options": {"A": "Uyirvarin ukkural meivittodum", "B": "\"I Ee Ai vazhi yavvum\" (Oppumai [ai] + y + illaadha = Oppumaiyillaadha)", "C": "Enai uyirvazhi vavvum", "D": "Thanikkuril mun otru irattum"}, "explanation": "Because 'ai' terminates the first element, 'y' glides as udambadumei: Oppumai + y + illaadha."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational S