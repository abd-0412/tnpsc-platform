{"id": "11th_tamil_u6_q154", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "viyangol_non_gemination", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வியங்கோள் வினைமுற்றுத் தொடரில் வல்லினம் எவ்வாறமையும்?", "media_id": null}], "options": {"A": "வல்லினம் மிகும்", "B": "வல்லினம் மிகாது (எ.கா: வாழ்க தமிழ், வருக தலைவா, ஒழிக தீமை)", "C": "எப்போதும் இரட்டிக்கும்", "D": "மெல்லினமாக மாறும்"}, "explanation": "க, இய, இயர் என முடியும் வியங்கோள் வினைமுற்றுகளின் பின் வல்லினம் மிகாது (வாழ்க தமிழ், வருக செல்வா)."}, "en": {"blocks": [{"type": "text", "content": "What is the Sandhi rule following optative finite verbs (Viyangol Vinaimutru)?", "media_id": null}], "options": {"A": "Vallinam geminates", "B": "Vallinam does not geminate (e.g., Vaazhga Thamizh, Varuga thalaiva)", "C": "Always doubles", "D": "Converts to nasal"}, "explanation": "Optative verbs expressing wishes/commands do not permit hard consonant doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 142, "chapter": null, "section": null, "reference": "11th Tamil, Unit 6, Pag