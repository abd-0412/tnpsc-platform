{"id": "9th-u4-q135", "schema_version": "1.0", "kind": "factual", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l5", "chapter_id": null, "topic_id": "verb-thallu-aux", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"அவன் வேலையை முடித்துத் தள்ளினான்\" - இத்தொடரில் 'தள்ளினான்' என்னும் துணைவினை உணர்த்தும் பொருட்பாடு யாது?", "media_id": null}], "options": {"A": "பய உணர்வு", "B": "மெதுவாகச் செய்தல்", "C": "விரைவு அல்லது தவிர்வு (வேகமாக முடித்தல்)", "D": "மகிழ்ச்சி"}, "explanation": "'முடித்துத் தள்ளினான்' என்பதில் உள்ள 'தள்ளினான்' என்னும் துணைவினை ஒரு வேலையை விரைவாக, வேகத்தோடு செய்து முடித்தலைக் குறிக்கும் விரைவுப் பொருளில் வந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "In \"Avan vaelaiyai mudithuth thallinaan\", what nuance does the auxiliary 'thallinaan' express?", "media_id": null}], "options": {"A": "Apprehension", "B": "Leisurely pace", "C": "Rapidity / Hasty dispatch (Viraivu)", "D": "Euphoria"}, "explanation": "'Thallinaan' attached to 'mudithu' imparts the nuance of dispatching the work with brisk rapidity and urgency."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 97, "chapter": null, "section": n