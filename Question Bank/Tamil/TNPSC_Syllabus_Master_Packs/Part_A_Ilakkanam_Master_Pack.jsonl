{"id": "12th_tamil_u6_q1095", "schema_version": "1.0", "kind": "multiple_choice", "level": "easy", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "meyppaattiyal", "chapter_id": null, "topic_id": "sanskrit_equivalent_rasa", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொல்காப்பிய மெய்ப்பாட்டிற்கு இணையான வடமொழி இலக்கியக் கோட்பாடு எது?", "media_id": null}], "options": {"A": "துவனி (Dhvani)", "B": "அலங்காரம்", "C": "ரசம் (Rasa / சுவை)", "D": "வக்ரோக்தி"}, "explanation": "தொல்காப்பியர் கூறும் 'மெய்ப்பாடு' என்பது பரத முனிவரின் நாட்டிய சாஸ்திரத்தில் கூறப்படும் 'ரசம்' (Rasa) என்னும் சுவைக் கோட்பாட்டிற்கு இணையானதாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which theoretical aesthetic framework in Sanskrit poetics directly corresponds to Tolkappiyar's 'Meyppaadu'?", "media_id": null}], "options": {"A": "Dhvani (Suggestion)", "B": "Alankara (Ornamentation)", "C": "Rasa (Aesthetic sentiment / Suvai)", "D": "Vakrokti"}, "explanation": "'Meyppaadu' directly corresponds to the concept of 'Rasa' in Indian aesthetics."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 143, "chapter": null, "section": null, "reference": "12th Tamil, Unit 6, Page 143", "url": n