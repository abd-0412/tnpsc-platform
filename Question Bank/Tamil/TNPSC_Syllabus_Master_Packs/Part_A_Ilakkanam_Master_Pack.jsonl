{"id": "11th_tamil_u4_q093", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "poem_tholkappiya_paayiram", "chapter_id": null, "topic_id": "types_of_paayiram", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாயிரம் எத்தனை வகைப்படும்?", "media_id": null}], "options": {"A": "இரண்டு வகை (பொதுப் பாயிரம், சிறப்புப் பாயிரம்)", "B": "நான்கு வகை", "C": "ஆறு வகை", "D": "எட்டு வகை"}, "explanation": "பாயிரம் பொதுப் பாயிரம் (எல்லா நூல்களுக்கும் பொதுவான இலக்கணம்) மற்றும் சிறப்புப் பாயிரம் (குறிப்பிட்ட நூலுக்குரிய தனிச்சிறப்பு) என இருவகைப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Into how many primary categories is a Paayiram (preface) classified in classical Tamil grammar?", "media_id": null}], "options": {"A": "Two types: Pothup Paayiram (General Preface) and Sirappup Paayiram (Special Specific Preface)", "B": "Four types", "C": "Six types", "D": "Eight types"}, "explanation": "Paayiram is classified into General (Pothu) and Special (Sirappu) prefaces."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 85, "chapter": null, "section": null, "reference": "11th Tamil, Unit 4, Page 85", "url