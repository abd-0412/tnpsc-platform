{"id": "7th-t2-u2-q251", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-11-thirukkural", "chapter_id": null, "topic_id": "ta-t2-u2-direct-bookback-manarkeni-ani", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தொட்டனைத்து ஊறும் மணற்கேணி மாந்தர்க்குக் கற்றனைத்து ஊறும் அறிவு' என்னும் குறளில் அமைந்துள்ள அணி எது?"}], "options": {"A": "உவமை அணி", "B": "எடுத்துக்காட்டு உவமை அணி", "C": "சொற்பொருள் பின்வருநிலையணி", "D": "வேற்றுமை அணி"}, "explanation": "பாடநூல் பக்கம் 40-ல் நேரடியாகக் குறிப்பிடப்பட்டுள்ளபடி, இதில் அமைந்துள்ள அணி 'எடுத்துக்காட்டு உவமை அணி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which figure of speech is embedded in 'Thottanaithu oorum manarkeni maantharkkuk katranaithu oorum arivu'?"}], "options": {"A": "Uvamai Ani", "B": "Eduthukkaattu Uvamai Ani", "C": "Sorporul Pinvarunilai Ani", "D": "Vetrumai Ani"}, "explanation": "Textbook explicit note on page 40: The figure of speech is Eduthukkaattu Uvamai Ani."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 40, "chapter": null, "section": null, "reference"