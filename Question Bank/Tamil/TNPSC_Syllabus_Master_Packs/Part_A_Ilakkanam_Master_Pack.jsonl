{"id": "11th_tamil_u4_q020", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "prose_thamizhaga_kalvi_varalaaru", "chapter_id": null, "topic_id": "marabu_kalvi_strengths", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திண்ணைப் பள்ளிக் கல்வி முறையில் மாணவர்களுக்குக் கற்பிக்கப்பட்ட அடிப்படைப் பாடங்களுள் முதன்மையானது எது?", "media_id": null}], "options": {"A": "கிரேக்க மொழி", "B": "வானியல் இயற்பியல்", "C": "மேற்கத்திய ஓவியம்", "D": "எண் சுவடி (கணிதம்), நெல் இலக்கம், கீழ்வாய் இலக்கம் மற்றும் நீதி நூல்கள் (ஆத்திசூடி, கொன்றைவேந்தன்)"}, "explanation": "திண்ணைப் பள்ளிகளில் தமிழ் எழுத்துகள், எண்சுவடி, வாய்ப்பாடுகள், மனக்கணக்கு, ஆத்திசூடி, நல்வழி போன்ற நீதிநூல்கள் அடித்தளமாகக் கற்பிக்கப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "What foundational subjects formed the core elementary curriculum in indigenous Thinnai schools?", "media_id": null}], "options": {"A": "Ancient Greek grammar", "B": "Astrophysics", "C": "Western oil painting", "D": "Enn Suvadi (Arithmetic mental mathematics), fractions, and ethical primers (Aathichoodi, Konraiventhan)"}, "explanation": "Mental arithmetic, fractional tables (Keezhvaai Ilakkam), and moral primers formed the core curriculum."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher