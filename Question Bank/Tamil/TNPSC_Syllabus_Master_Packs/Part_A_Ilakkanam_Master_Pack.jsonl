{"id": "7th-t1-u2-132", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l1-kaadu", "chapter_id": null, "topic_id": "sandhi-splitting-kaadellam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிரித்தெழுதுக:\n'காடெல்லாம்' என்னும் சொல்லைச் சரியாகப் பிரித்தெழுதக் கிடைக்கும் வடிவம் எது?"}], "options": {"A": "காடு + எல்லாம்", "B": "காட் + எல்லாம்", "C": "கா + டெல்லாம்", "D": "காடு + எல்லாம்"}, "explanation": "இலக்கண விதி: காடு + எல்லாம் -> நிலைமொழி ஈற்று உகரம் (டு = ட் + உ) 'உயிர்வரின் உக்குறள் மெய்விட்டோடும்' என்ற விதிப்படி உகரம் கெட்டு, 'உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே' என்ற விதிப்படி ட் + எ = 'டெ' எனப் புணர்ந்து 'காடெல்லாம்' என்றானது."}, "en": {"blocks": [{"type": "text", "content": "Identify the correct grammatical split for the compound word 'Kaadellaam':"}], "options": {"A": "Kaadu + Ellaam (தவறு: குற்றியலுகர விதிப்படி ட்+எ=டெ)", "B": "Kaat + Ellaam", "C": "Kaa + Dellaam", "D": "காடு + எல்லாம்"}, "explanation": "Grammar rule: In 'Kaadu + Ellaam', ugaram is dropped before a vowel, combining t + e = de to form 'Kaadellaam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 26, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "grammar", "sandhi_splitting"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
