{"id": "11th_tamil_u1_q094", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "cow_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தலைமாணாக்கருக்கு ‘ஆ’ (பசு) உவமையாக்கப்பட்டதன் காரணம் என்ன?", "media_id": null}], "options": {"A": "பசு அமைதியாக இருப்பதால்", "B": "மிகுதியாகப் புல்லை மேய்ந்து, பின்னர் ஓரிடத்தில் அமைதியாக அமர்ந்து அசைபோட்டுச் செரிப்பது போல, கற்றவற்றை மீண்டும் மீண்டும் சிந்தித்துத் தெளிவு பெறுவதால்", "C": "பசு பால் தருவதால்", "D": "பசு வீட்டு விலங்கு என்பதால்"}, "explanation": "பசு புல்லை நிறைய உண்டு பின் அசைபோடுவது போல, தலைமாணாக்கன் ஆசிரியர் கூறியவற்றை முழுமையாக உள்வாங்கி, பின்னர் தனித்திருந்து சிந்தித்து ஞானம் பெறுவான்."}, "en": {"blocks": [{"type": "text", "content": "Why is the 'Cow' (Aa) metaphorically used for the superior student?", "media_id": null}], "options": {"A": "Because cows are docile", "B": "Like a cow grazing plentifully and then chewing the cud in contemplation, the student ruminates deeply upon received wisdom", "C": "Because cows yield milk", "D": "Because cows are domesticated"}, "explanation": "The cow ruminates the ingested fodder; the excellent student contemplates knowledge repeatedly until mastery."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 9, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 9", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Grammar", "Student Similes"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q095", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "idai_maanaakkar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இடைமாணாக்கருக்கு (இரண்டாம் நிலை மாணவர்) நன்னூலில் கூறப்பட்டுள்ள உவமைகள் எவை?", "media_id": null}], "options": {"A": "அன்னம், பசு", "B": "இல்லிக்குடம், ஆடு", "C": "மண் (நிலம்), கிளி", "D": "மலர், நிறைகோல்"}, "explanation": "இடைமாணாக்கருக்கு மண் (உழுத அளவு விளையும் நிலம்) மற்றும் கிளி (சொன்னதை மட்டுமே திருப்பிச் சொல்லும் பறவை) ஆகியவை உவமைகளாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which similes are assigned in Nannool to mediocre/second-tier students (Idai Maanaakkar)?", "media_id": null}], "options": {"A": "Swan, Cow", "B": "Leaky pot, Goat", "C": "Mann (Tilled soil) and Kili (Parrot)", "D": "Flower, Balance scales"}, "explanation": "Tilled earth (yielding strictly to labor) and repetitive parrot embody middle-tier learners."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 9, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 9", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 11", "Unit 1", "Grammar", "Student Similes"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "11th_tamil_u1_q096", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "poem_nannool_paayiram", "chapter_id": null, "topic_id": "parrot_analogy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஆசிரியர் சொல்லிக் கொடுத்ததை அப்படியே திரும்பச் சொல்வதைத் தவிர, சுயமாகச் சிந்திக்கும் ஆற்றல் இல்லாத மாணவன்’ - எந்த உவமையால் குறிக்கப்படுகிறான்?", "media_id": null}], "options": {"A": "பசு", "B": "அன்னம்", "C": "மண்", "D": "கிளி"}, "explanation": "கிளி தான் கேட்ட சொற்களைத் திரும்பக் கூறுமே தவிர சுயமாகச் சிந்திக்காது; அதுபோல ஆசிரியர் கற்பித்ததை மட்டுமே மனனம் செய்து ஒப்புவிப்பவன் இடைமாணாக்கன்."}, "en": {"blocks": [{"type": "text", "content": "Which simile designates a student who mechanically repeats what the teacher recited without spontaneous individual cognition?", "media_id": null}], "options": {"A": "Cow", "B": "Swan", "C": "Soil", "D": "Parrot (Kili)"}, "explanation": "A parrot echoes words mechanically without comprehension; matching the rote memorizer."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 9, "chapter": null, "section": null, "reference": "11th Tamil, Unit 1, Page 9", "url