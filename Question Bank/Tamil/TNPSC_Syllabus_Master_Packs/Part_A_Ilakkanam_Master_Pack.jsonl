{"id": "8th-booster-q1142", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u6-naadu", "lesson_id": "8th-booster-thirukkural", "chapter_id": null, "topic_id": "punarchi-kural-words", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வைத்தூறு' - இச்சொல்லின் சரியான புணர்ச்சி விதியினைக் கண்டறிக:\nவை + தூறு = வைத்தூறு"}], "options": {"A": "உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே", "B": "'இயல்பினும் விதியினும் நின்ற உயிர்முன் கசதப மிகும்' என்னும் விதிப்படி தகர மெய் (த்) மிகுந்தது", "C": "தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும்", "D": "இடை உகரம் இய்யாதல்"}, "explanation": "பாடநூல் பக். 65: வை (ஐகார உயிர் ஈறு) + தூறு. நிலைமொழி உயிர் ஈறாக நிற்க, வருமொழி முதலில் க, ச, த, ப வந்தால் வல்லினம் மிகும் என்ற விதிப்படி 'த்' மிகுந்து 'வைத்தூறு' எனப் புணர்ந்தது."}, "en": {"blocks": [{"type": "text", "content": "Identify the correct Sandhi rule (Punarchi Vidhi) governing the compound 'Vaithoori' (Vai + Thoori = Vaithoori):"}], "options": {"A": "Udalmel uyirvandhu ondruvathu iyalbe", "B": "Doubling of 'th' consonant following an open vowel by rule of Kasathapa hardening", "C": "Doubling of solitary consonant before a vowel", "D": "Medial 'u' transforming into 'i'"}, "explanation": "Textbook Page 65: Vai ends in the vowel diphthong 'ai'. Following the sandhi rule of initial stop doubling, 'th' geminates to form 'Vaithoori'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 65, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "booster-thirukkural", "punarchi", "grammar", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-booster-q1143", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u1-mozhi", "lesson_id": "8th-booster-thirukkural", "chapter_id": null, "topic_id": "seer-asai-kural-scansion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'இடும்பைக்கு' - இச்சீரின் அசைப் பிரிப்பையும் வாய்பாட்டையும் சரியாகத் தேர்க:\nஇ/டும்/பைக்/கு"}], "options": {"A": "நேர் நேர் நேர் - தேமாங்காய்", "B": "நிரை நேர் நிரை - கூவிளங்கனி", "C": "நிரை நேர் நேர் - புளிமாங்காய்", "D": "நிரை நிரை நேர் - கருவிளங்காய்"}, "explanation": "பாடநூல் பக். 137: இடும் (குறில்-ஒற்று = நேர் அன்று, குறிலிணை ஒற்று 'இடும்' = நிரை), பைக் (நெடில் ஒற்று = நேர்), கு (குறில் தனித்து = நேர்). ஆகவே நிரை + நேர் + நேர் = 'புளிமாங்காய்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the correct metrical scansion (Asai) and pattern name (Vaaypaadu) for the metrical foot 'Idumbaikku':"}], "options": {"A": "Ner Ner Ner - Themaangaai", "B": "Nirai Ner Nirai - Koovilangani", "C": "Nirai Ner Ner - Pulimaangaai", "D": "Nirai Nirai Ner - Karuvilangaai"}, "explanation": "Textbook Page 137: 'Idum' (short+short+consonant = Nirai), 'baik' (long+consonant = Ner), 'ku' (short = Ner). Nirai + Ner + Ner = 'Pulimaangaai'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["8th-tamil", "booster-thirukkural", "asai-seer", "grammar", "tnpsc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

