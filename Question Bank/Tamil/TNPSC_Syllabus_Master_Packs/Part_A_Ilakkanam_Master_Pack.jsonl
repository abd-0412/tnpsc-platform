{"id": "9th-u2-q133", "schema_version": "1.0", "kind": "single_choice", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-9th-u2-iyarkai", "lesson_id": "lesson-04-pagupadha-uruppilakkanam", "chapter_id": null, "topic_id": "topic-pagupadha-uruppilakkanam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூலில் பெயர்ப் பகுபதத்திற்குத் தரப்பட்டுள்ள சரியான சான்று எது?", "media_id": null}], "options": {"A": "வேலன் (வேல் + அன்)", "B": "செய்தான் (செய் + த் + ஆன்)", "C": "நடந்தான் (நட + த் + ஆன்)", "D": "பாடினான் (பாடு + இன் + ஆன்)"}, "explanation": "பாடநூல் விளக்கம்: பெயர்ப் பகுபதம் - எ.கா. வேலன் (வேல் - பகுதி, அன் - விகுதி). மற்றவை வினைப் பகுபதங்கள் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which is the textbook example illustrating a nominal divisible word (Peyarp Pagupadham)?", "media_id": null}], "options": {"A": "Velan (Vel + an)", "B": "Seydhaan (Sey + th + aan)", "C": "Nadandhaan (Nada + th + aan)", "D": "Paadinaan (Paadu + in + aan)"}, "explanation": "Velan (Vel + an) is a noun derived from the noun root Vel and suffix an, exemplifying Peyarp Pagupadham."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 39, "chapter": null, "section": null, "re