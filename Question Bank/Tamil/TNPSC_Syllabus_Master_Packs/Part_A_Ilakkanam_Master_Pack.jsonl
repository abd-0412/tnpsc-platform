{"id": "12th_tamil_u2_q333", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "naalvagai_poruthangal", "chapter_id": null, "topic_id": "vazhaanilai_definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திணை, பால், எண், இடம், காலம், வினா, விடை ஆகியவற்றில் எவ்வித இலக்கணப் பிழையுமின்றித் தொடர் அமைவது எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "வழாநிலை", "B": "வழு", "C": "வழுவமைதி", "D": "மரபுப் பிழை"}, "explanation": "இலக்கண விதிகளுக்கு உட்பட்டுப் பிழையின்றி இயல்பாக அமையும் தொடர் ‘வழாநிலை’ எனப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the grammatical term for a sentence constructed entirely without any violation of syntax, class, gender, person, or tense?", "media_id": null}], "options": {"A": "Vazhaanilai (Standard flawless syntax)", "B": "Vazhu (Syntactic error)", "C": "Vazhuvamaidhi (Sanctioned anomaly)", "D": "Marabup Pizhai"}, "explanation": "Vazhaanilai denotes grammatically sound, standard syntactic execution free from errors."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 39, "chapter": null, "section": null, "reference": "1