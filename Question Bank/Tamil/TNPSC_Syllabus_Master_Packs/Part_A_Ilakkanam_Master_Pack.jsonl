{"id": "10th-u4-q144", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "valukkal_valuvamaithi", "chapter_id": null, "topic_id": "idam_kaalam_marabu_valuvu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்கண்டவற்றுள் \"இட வழு\" (Person Error)-க்குரிய சரியான எடுத்துக்காட்டு எது?", "media_id": null}], "options": {"A": "நேற்று வருவான்", "B": "ஒரு விரலைக் காட்டிச் சிறியதோ பெரியதோ எனக் கேட்டல்", "C": "குயில் கத்தியது", "D": "நீ வந்தேன்"}, "explanation": "\"நீ\" என்பது முன்னிலைப் பெயர்; \"வந்தேன்\" என்பது தன்மை வினைமுற்று. முன்னிலைக்குத் தன்மை வினை வந்ததால் \"நீ வந்தேன்\" என்பது இட வழுவாகும் (\"நீ வந்தாய்\" என்பதே சரியானது)."}, "en": {"blocks": [{"type": "text", "content": "Which of the following is an accurate example of \"Idam Vazhu\" (Grammatical Person Error)?", "media_id": null}], "options": {"A": "Netru varuvaan (Tense error)", "B": "Showing one finger and asking if it is big or small (Vina error)", "C": "Kuyil kathiyathu (Idiom error)", "D": "Nee vanthen (Person error: you I-came)"}, "explanation": "\"Nee\" is second person while \"vanthen\" is first person verb, causing an Idam Vazhu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "