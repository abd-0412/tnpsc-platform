{"id": "7th-t1-u1-078", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l5-kutriyalugaram", "chapter_id": null, "topic_id": "metrics-calculation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'நாடு' என்னும் நெடில்தொடர்க் குற்றியலுகரச் சொல்லின் மொத்த மாத்திரை அளவு என்ன?"}], "options": {"A": "2 மாத்திரை", "B": "2.5 மாத்திரை (நா [நெடில்] = 2, டு [குற்றியலுகரம்] = 0.5)", "C": "3 மாத்திரை", "D": "1.5 மாத்திரை"}, "explanation": "நா = தனி நெடில் (2 மாத்திரை); டு = நெடில்தொடர்க் குற்றியலுகரமாகக் குறைந்து ஒலிப்பதால் அரை மாத்திரை (0.5). மொத்தம் = 2 + 0.5 = 2.5 மாத்திரை."}, "en": {"blocks": [{"type": "text", "content": "Calculate the total metrical count (maathirai) of the Nedil-thodar word 'Naadu':"}], "options": {"A": "2 morae", "B": "2.5 morae (Naa [long vowel] = 2, Du [kutriyalugaram] = 0.5)", "C": "3 morae", "D": "1.5 morae"}, "explanation": "Naa (2) + du (0.5) = 2.5 morae."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year"