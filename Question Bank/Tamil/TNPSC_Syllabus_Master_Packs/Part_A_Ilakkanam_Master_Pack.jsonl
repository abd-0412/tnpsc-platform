{"id": "7th-t1-u1-051", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l3-pechu-ezhuthu", "chapter_id": null, "topic_id": "colloquial-conversion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"அம்மா பசிக்கிது எனக்குச் சோறு வேணும்\" என்னும் பேச்சுவழக்குத் தொடரின் திருத்தமான எழுத்துவழக்கு வடிவம் எது?"}], "options": {"A": "அம்மா பசிக்குது எனக்கு சோறு வேண்டும்", "B": "அம்மா பசிக்குதே எனக்கு உணவு தாருங்கள்", "C": "\"அம்மா! பசிக்கிறது; எனக்குச் சோறு வேண்டும்.\"", "D": "அம்மா பசித்தது எனக்குச் சோறு வேணும்"}, "explanation": "பாடநூல் பயிற்சி: பேச்சுமொழி 'அம்மா பசிக்கிது. எனக்குச் சோறு வேணும்' என்பது எழுத்துமொழியில் 'அம்மா! பசிக்கிறது. எனக்குச் சோறு வேண்டும்' என்று அமையும்."}, "en": {"blocks": [{"type": "text", "content": "What is the standard literary written register equivalent of the colloquial sentence \"Amma pasikkidhu enakkuch soru venum\"?"}], "options": {"A": "Amma pasikkudhu enakku soru vendum", "B": "Amma pasikkudhe enakku unavu thaarungal", "C": "\"Amma! Pasikkiradhu; enakkuch soru vendum.\"", "D": "Amma pasitthadhu enakkuch soru venum"}, "explanation": "Standard textbook conversion: 'Amma! Pasikkiradhu; enakkuch soru vendum.'"}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "