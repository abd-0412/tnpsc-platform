{"id": "6th-t1-pyq-050", "schema_version": "1.0", "kind": "grammar_application", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தமிழ்நாடு' என்னும் சொல்லின் மொத்த மாத்திரை அளவு யாது?", "media_id": null}], "options": {"A": "4 மாத்திரைகள்", "B": "4 1/2 மாத்திரைகள்", "C": "5 மாத்திரைகள்", "D": "5 1/2 மாத்திரைகள்"}, "explanation": "த (குறில் = 1) + மி (குறில் = 1) + ழ் (மெய் = 1/2) + நா (நெடில் = 2) + டு (குறில் = 1 அல்ல, குற்றியலுகரமாக 1/2 அல்லது தனிச்சொல்லில் குறில் மாத்திரை 1). பள்ளி இலக்கண விதிப்படி: த(1) + மி(1) + ழ்(0.5) + நா(2) = 4.5. இறுதியில் உள்ள குற்றியலுகர 'டு' அரை மாத்திரையாகக் குறைந்தால் 4.5 + 0.5 = 5 அல்ல; தனிச் சொல்லாக த(1) + மி(1) + ழ்(0.5) + நா(2) + டு(1/2 குற்றியலுகரம்) = 5 மாத்திரை அல்லது முற்றியலுகரம் எனில்: த(1)+மி(1)+ழ்(0.5)+நா(2) = 4.5."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "pyq_bridging", "section": null, "reference": "Maathirai Metric Calculation", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "tnpsc", "exam_name": "group_4", "year": null, "paper": "general_tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "grammar_application"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-pyq-051", "schema_version": "1.0", "kind": "grammar_application", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தமிழ் மொழியின் இனிமையை உணர்ந்து நாளும் தமிழ் நூல்களைக் கற்பாயாக!' - இத்தொடரின் வகை யாது?", "media_id": null}], "options": {"A": "செய்தித்தொடர்", "B": "வினாத்தொடர்", "C": "விழைவுத்தொடர்", "D": "உணர்ச்சித்தொடர்"}, "explanation": "வாழ்த்துதல், வைதல், வேண்டல், விதித்தல் ஆகிய பொருள்களில் வரும் தொடர் விழைவுத்தொடர் ஆகும். 'கற்பாயாக' என வேண்டுதல் / விதித்தல் பொருளில் வந்ததால் இது விழைவுத்தொடர்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "pyq_bridging", "section": null, "reference": "Sentence Structure Identification", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "tnpsc", "exam_name": "group_4"