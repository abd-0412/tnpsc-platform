{"id": "6th-t2-u1-023", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தால்' என்னும் சொல்லிற்குரிய சரியான தமிழ்ப் பொருள் யாது?", "media_id": null}], "options": {"A": "கால்", "B": "பாட்டு", "C": "அன்னை", "D": "நாக்கு"}, "explanation": "'தால்' என்பதற்கு 'நாக்கு' என்று பொருள். நாவை அசைத்துப் பாடுவதால் தாலாட்டு (தால் + ஆட்டு) எனப் பெயர் பெற்றது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 4", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}