{"id": "10th-u5-q142", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "porulkol_vagaigal", "chapter_id": null, "topic_id": "aatruneer_porulkol", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடலின் தொடக்கம் முதல் முடிவு வரை ஆற்றுநீரின் போக்கைப் போல நேராகவே பொருள் கொள்ளும் முறை எவ்வகைப் பொருள்கோள் ஆகும்?", "media_id": null}], "options": {"A": "நிரல்நிறைப் பொருள்கோள்", "B": "ஆற்றுநீர்ப் பொருள்கோள்", "C": "கொண்டு கூட்டுப் பொருள்கோள்", "D": "அடிமறிமாற்றுப் பொருள்கோள்"}, "explanation": "ஆற்றுநீரின் தடையற்ற ஓட்டம் போலச் சொற்கள் முன்பின் மாறாமல் நேராகப் பொருள் தரும் பொருள்கோள் \"ஆற்றுநீர்ப் பொருள்கோள்\" ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Construing the meaning of a poem straight from beginning to end like the unidirectional flow of river water is:", "media_id": null}], "options": {"A": "Niralnirai Porulkol", "B": "Aatruneer Porulkol (River-flow construal)", "C": "Kondu kootu Porulkol", "D": "Adimarimaatru Porulkol"}, "explanation": "Aatruneer Porulkol signifies straightforward semantic progression like running water."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 117, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 117", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["இலக்கணம்", "ஆற்றுநீர்ப் பொருள்கோள்", "வரையறை"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u5-q143", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "porulkol_vagaigal", "chapter_id": null, "topic_id": "aatruneer_example_chinthamani", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"சொல்லரும் சூல்பசும் பாம்பின் தோற்றம்போல்... செல்வம் போன்று தலைநிறுவி... கல்விசேர் மாந்தரின் இறைஞ்சி காய்த்தவே\" - என்ற சீவகசிந்தாமணிப் பாடல் எவ்வகைப் பொருள்கோளுக்குச் சான்றாகும்?", "media_id": null}], "options": {"A": "கொண்டு கூட்டுப் பொருள்கோள்", "B": "எதிர் நிரல்நிறைப் பொருள்கோள்", "C": "ஆற்றுநீர்ப் பொருள்கோள்", "D": "பூட்டுவிற் பொருள்கோள்"}, "explanation": "நெற்பயிர் கருவுற்ற பாம்பு போல் தோன்றி, செல்வம் சேர்ந்தவுடன் தலைநிமிர்ந்து, பின்னர் கல்வி கற்ற சான்றோர் போல் பணிந்து விளைந்தது எனத் தொடர்ச்சியாக ஆற்றுநீர் போலப் பொருள் தருவதால் இது ஆற்றுநீர்ப் பொருள்கோள் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "The Civaka Chintamani verse depicting ripening paddy bending modestly like learned scholars is an example of which Porulkol?", "media_id": null}], "options": {"A": "Kondu kootu Porulkol", "B": "Ethir Niralnirai Porulkol", "C": "Aatruneer Porulkol", "D": "Poottuvir Porulkol"}, "explanation": "The verse progresses continuously from sprout to harvest, exemplifying Aatruneer Porulkol."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu