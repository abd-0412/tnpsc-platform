{"id": "12th_tamil_u5_q914", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "padimam", "chapter_id": null, "topic_id": "complex_image_combination", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒரே கவிதையில் காட்சியும் ஒலியும் சுவையும் இணைந்து வரும் படிமக் கூட்டமைப்பு எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "தனிப் படிமம்", "B": "கூட்டுப் படிமம் / கலவைப் படிமம் (Complex / Composite Image)", "C": "எதிர் படிமம்", "D": "வெற்றுப் படிமம்"}, "explanation": "ஒன்றுக்கும் மேற்பட்ட புலன் உணர்வுகளை ஒரே கவிதை வரிகளில் ஒன்றிணைத்துக் காட்டும் படிம உத்தி 'கூட்டுப் படிமம்' எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What is a multi-layered poetic image combining visual, auditory, and tactile elements in unison termed?", "media_id": null}], "options": {"A": "Isolated image", "B": "Composite / Complex Image (Kootup Padimam)", "C": "Anti-image", "D": "Blank image"}, "explanation": "A composite image synchronizes multiple sensory perceptions into a single unified aesthetic experience."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 120, "chapter": null, "section":