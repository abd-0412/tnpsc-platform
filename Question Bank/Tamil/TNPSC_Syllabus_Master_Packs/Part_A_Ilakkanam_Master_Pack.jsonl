{"id": "9th-u4-q136", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l5", "chapter_id": null, "topic_id": "verb-koodum-aux", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"நாளை மழை பெய்யக்கூடும்\" - இத்தொடரில் 'கூடும்' என்னும் துணைவினை உணர்த்தும் இலக்கணப் பண்பு யாது?", "media_id": null}], "options": {"A": "உறுதிப்பாடு", "B": "கட்டளை", "C": "அனுமதி", "D": "சாத்தியக்கூறு அல்லது ஐயம் (Possibility / Probability)"}, "explanation": "'பெய்யக்கூடும்' என்பதில் உள்ள 'கூடும்' துணைவினை ஒரு செயல் உறுதியாக நடக்கும் என்று கூறாமல், நடப்பதற்கான சாத்தியக்கூறை (Possibility) உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "In \"Naalai mazhai peyyakkoodum\", what modality does 'koodum' convey?", "media_id": null}], "options": {"A": "Absolute certainty", "B": "Imperative command", "C": "Permission", "D": "Possibility / Probability"}, "explanation": "'Koodum' functions as an epistemic modal auxiliary expressing possibility/likelihood."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 97, "chapter": null, "section": null, "reference": "9th Tamil, Unit 1, Page 97", "url": null, "s