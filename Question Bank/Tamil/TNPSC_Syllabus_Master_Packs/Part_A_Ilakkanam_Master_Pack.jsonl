{"id": "11th_tamil_rev2_q141", "schema_version": "1.0", "kind": "grammar_identification", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u5_u8_grammar_mega_test", "chapter_id": null, "topic_id": "sandhi_hard_rules", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் சொற்றொடர்களுள் சந்திப்பிழையற்ற (வல்லினம் மிகும் விதிப்படி அமைந்த) சரியான தொடர் எது?", "media_id": null}], "options": {"A": "பாடநூலைப் படித்துப் பயன்பெறுங்கள்", "B": "பாடநூல் படித்து பயன்பெறுங்கள்", "C": "பாடநூலை படித்து பயன்பெறுங்கள்", "D": "பாடநூலைப் படித்து பயன்பெறுங்கள்"}, "explanation": "‘பாடநூலை’ என்பது இரண்டாம் வேற்றுமை விரி, எனவே 'ப்' மிகும் (பாடநூலைப்). 'படித்து' என்பது 'உ'கர ஈற்று வினையெச்சம் (வன்தொடர்க் குற்றியலுகரம்), எனவே 'ப்' மிகும் (படித்துப்)."}, "en": {"blocks": [{"type": "text", "content": "Select the phrase that is grammatically flawless without sandhi errors:", "media_id": null}], "options": {"A": "Paadanoolaip padithup payanperungal", "B": "Paadanool padithu payanperungal", "C": "Paadanoolai padithu payanperungal", "D": "Paadanoolaip padithu payanperungal"}, "explanation": "Both accusative marker '-ai' and the hard-series verbal participle 'padithu' mandatorily trigger sandhi doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook