{"id": "7th-t3-u3-q362", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u3-maanudam", "lesson_id": "lesson-15-thirukkural-part2", "chapter_id": null, "topic_id": "ta-t3-u3-glossary-odd-one-out", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கலைச்சொற்கள் மற்றும் அவற்றின் தமிழாக்க இணைகளில் பொருந்தாத தவறான இணை எது?"}], "options": {"A": "Simplicity - எளிமை", "B": "Astronomy - தத்துவம்", "C": "Charity - ஈகை", "D": "Sincerity - வாய்மை"}, "explanation": "இணை B தவறானது. பாடநூல் பக்கம் 66: 'Astronomy' என்பதற்குரிய தமிழ்ச்சொல் 'வானியல்' ஆகும்; 'தத்துவம்' என்பதற்குரிய ஆங்கிலச் சொல் Philosophy ஆகும். மற்ற இணைகள் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Which of the following vocabulary pairs is incorrectly matched?"}], "options": {"A": "Simplicity - Elimai", "B": "Astronomy - Thathuvam", "C": "Charity - Eegai", "D": "Sincerity - Vaaimai"}, "explanation": "Pair B is incorrect. Astronomy translates to 'Vaaniyal', while 'Thathuvam' is Philosophy. Hence B is the odd one."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 66, "chapter": null, "section