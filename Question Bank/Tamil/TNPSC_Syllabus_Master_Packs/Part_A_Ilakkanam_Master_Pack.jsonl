{"id": "8th-u3-q328", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u3-kalvi", "lesson_id": "lesson-14-palthuraikkalvi", "chapter_id": null, "topic_id": "ta-8th-u3-grammar-valarchi-vaayil-compound", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குலோத்துங்கன் கவிதையில் வரும் 'வளர்ச்சி வாயில்' என்னும் தொடரின் இலக்கணக் குறிப்பைக் கண்டறிக:"}], "options": {"A": "இரண்டாம் வேற்றுமைத் தொகை", "B": "பண்புத்தொகைத் தொடர்", "C": "வினைத்தொகை", "D": "ஆறாம் வேற்றுமைத் தொகை (வளர்ச்சியினது வாயில்)"}, "explanation": "பாடநூல் பக்கம் 54 தெரிந்து தெளிவோம்: 'அது வளர்ச்சி வாயில்' என்பதில் 'வளர்ச்சியின் வாயில் / வளர்ச்சியினது வாயில்' என 'அது' என்னும் ஆறாம் வேற்றுமை உருபு மறைந்து வருவதால் இது 'ஆறாம் வேற்றுமைத் தொகை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the grammatical classification (Ilakkana Kurippu) of 'Valarchi Vaayil' from Kulothungan's verse:"}], "options": {"A": "Second case compound", "B": "Qualitative compound", "C": "Verbal compound (Vinai thogai)", "D": "Sixth case genitive compound ('வளர்ச்சியினது வாயில்')"}, "explanation": "Textbook page 54: 'வளர்ச்சி வாயில்' expands into 'வளர்ச்சியின் வாயில்' with the genitive case marker elided, classifying it as a 6th case compound (Aaraam Vetrumaith Thogai)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "8", "term": "full_year", "edition": "2024-2025", "page": 54, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["grammar", "ilakkana_kurippu", "vetrumaith_thogai"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "8th-u3-q329", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "8", "subject_id": "general_tamil", "term": "full_year", "unit_id": "ta-8th-u3-kalvi", "lesson_id": "lesson-14-palthuraikkalvi", "chapter_id": null, "topic_id": "ta-8th-u3-grammar-edandru-punarchi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஏடன்று' என்னும் சொல்லைப் பிரித்து எழுதும் முறையையும் அதில் பயின்று வந்துள்ள புணர்ச்சி விதிகளையும் கண்டறிக:"}], "options": {"A": "ஏடு + அன்று; 'உயிர்வரின் உக்குறள் மெய்விட்டு ஓடும்', 'உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே'", "B": "ஏ + அன்று; 'இ ஈ ஐ வழி யவ்வும்' உடம்படுமெய் விதி", "C": "ஏட் + அன்று; இயல்புப் புணர்ச்சி விதி மட்டுமே", "D": "ஏடு + நின்று; விகாரப் புணர்ச்சி விதி"}, "explanation": "பாடநூல் பக்கம் 54: 'ஏடன்று' = ஏடு + அன்று. குற்றியலுகர நிலைமொழியின் ஈற்று 'உ' கெட்டு 'ஏட் + அன்று' என்றாகி, ட் + அ = ட என இணைந்து 'ஏடன்று' எனப் புணரும். எனவே A சரியானதாகும்."}, "en": {"blocks": [{"type": "text", "content": "Determine the split form and sandhi rules for 'Yedandru' from Kulothungan's poem:"}], "options": {"A": "ஏடு + அன்று; 'Uyirvarin ukkural meivittu odum' & 'Udalmel uyirvanthu ondruvathu iyalbe'", "B": "ஏ + அன்று; Udambadumei rule", "C": "ஏட் + அன்று; Normal sandhi rule", "D": "ஏடு + நின்று; Transformative sandhi"}, "explanation": "Textbook page 54: 'ஏடன்று' splits into ஏடு + அன்று. Short 'u' drops before vowel 'a', and 't' combines with 'a' to form 'da'. Option A is correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "mark