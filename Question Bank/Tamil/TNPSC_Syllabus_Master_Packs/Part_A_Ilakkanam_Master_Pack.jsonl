{"id": "9th-u4-q164", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l6", "chapter_id": null, "topic_id": "pyq-kothari-commission", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC முந்தைய ஆண்டு வினா] இந்திய வரலாற்றில் பெண்கல்விக்காக அனைத்து நிலைகளிலும் இலவசக் கல்வியை முதன்முதலில் பரிந்துரைத்த கல்விக் குழு எது?", "media_id": null}], "options": {"A": "இராதாகிருஷ்ணன் கல்விக் குழு (1948)", "B": "முதலியார் கல்விக் குழு (1952)", "C": "ஹண்டர் குழு (1882)", "D": "கோத்தாரி கல்விக் குழு (1964)"}, "explanation": "1964 ஆம் ஆண்டு அமைக்கப்பட்ட கோத்தாரி கல்விக் குழு அனைத்து நிலைகளிலும் பெண்களுக்கு இலவசக் கல்வி மற்றும் கட்டாயக் கல்வியைப் பரிந்துரைத்தது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC Previous Year Question] Which Indian Education Commission recommended free and universal education for girls at all stages of schooling in 1964?", "media_id": null}], "options": {"A": "Radhakrishnan Commission (1948)", "B": "Mudaliar Commission (1952)", "C": "Hunter Commission (1882)", "D": "Kothari Education Commission (1964)"}, "explanation": "The Kothari Commission of 1964 emphasized gender equity and recommended free schooling for female students across all stages."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi