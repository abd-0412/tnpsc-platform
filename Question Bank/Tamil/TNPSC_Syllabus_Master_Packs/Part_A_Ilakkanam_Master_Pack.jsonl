{"id": "12th_tamil_u7_q1293", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "bharathi_myth_allegory", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘ஆயிரம் அரக்கர் வம்சத்தை அழித்த வில்லாளன்’ - இராமன் பற்றிய இத்தொன்மத்தை பாரதியார் எதனை ஒப்பிட்டுக் கவிதையாக்கினார்?", "media_id": null}], "options": {"A": "இந்திய சுதந்திரப் போராட்டத்தில் அந்நிய ஆதிக்கத்தை வீழ்த்தும் மக்கள் எழுச்சி", "B": "இயற்கைச் சீற்றங்களை எதிர்த்து நிற்றல்", "C": "வறுமையை ஒழித்தல்", "D": "புதிய தொழிற்சாலைகளை நிறுவுதல்"}, "explanation": "பாரதியார் இதிகாசத் தொன்மங்களைப் பயன்படுத்தி விடுதலை வேட்கையை மக்களிடம் கொழுந்துவிட்டு எரியச் செய்தார்."}, "en": {"blocks": [{"type": "text", "content": "Bharathiyar used the heroic myth of Rama destroying demonic hordes to metaphorically depict which contemporary reality?", "media_id": null}], "options": {"A": "People's uprising against British colonial oppression in the Indian freedom struggle", "B": "Standing against natural disasters", "C": "Eradication of poverty", "D": "Building modern industrial factories"}, "explanation": "Bharathiyar deftly deployed Puranic archetypes to evoke revolutionary fervor against colonial subjugation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 186, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 186", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Grammar", "Bharathi Myth"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1294", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "abdul_rahman_karna", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிக்கோ அப்துல் ரகுமான் ‘நேயர் விருப்பம்’ கவிதைத் தொகுப்பில் கர்ணனின் கொடைத் தொன்மத்தை எதற்கு உருவகப்படுத்தியுள்ளார்?", "media_id": null}], "options": {"A": "வானத்துப் பிறைநிலவுக்கு", "B": "தனது குருதியையே கொடையளிக்கும் மனிதநேயப் பண்பிற்கும் தியாகத்திற்கும்", "C": "செல்வந்தர்களின் பகட்டுச் செலவுகளுக்கு", "D": "அரசியல் தலைவர்களின் வாக்குறுதிகளுக்கு"}, "explanation": "அப்துல் ரகுமான் கர்ணன் மரணப் படுக்கையிலும் தன் புண்ணியத்தைத் தானமாகத் தந்த தொன்மத்தை மானுடத்தின் உன்னத ஈகைக்குக் குறியீடாகப் பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "In his poetry collection 'Neyar Viruppam', how did Kavikko Abdul Rahman allegorize Karna's mythic charity?", "media_id": null}], "options": {"A": "To the crescent moon in the sky", "B": "To ultimate humanitarian sacrifice donating one's very lifeblood and selflessness", "C": "To ostentatious luxury spending of oligarchs", "D": "To political promises of ministers"}, "explanation": "Abdul Rahman utilized Karna's legendary act of giving away his virtues while dying as an archetype for pure self-effacing sacrifice."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 187, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 187", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Grammar", "Abdul Rahman Karna"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1295", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "carl_jung_archetype", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘தொன்மம் என்பது பண்பாட்டின் கூட்டு நனவிலி மனத்தின் வெளிப்பாடு’ (Collective Unconscious) என்று விளக்கிய உலகப் புகழ்பெற்ற உளவியல் அறிஞர் யார்?", "media_id": null}], "options": {"A": "சிக்மண்ட் பிராய்டு", "B": "ஜீன் பியாஜே", "C": "கார்ல் யுங் (Carl Jung)", "D": "இவான் பாவ்லோவ்"}, "explanation": "கார்ல் யுங் தொன்மங்கள் என்பவை மனித குலத்தின் ஆழ்மன கூட்டு நனவிலி (Collective Unconscious) படிமங்களே என்று மெய்ப்பித்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which famous psychologist postulated that myths are projections of the 'Collective Unconscious' of human culture?", "media_id": null}], "options": {"A": "Sigmund Freud", "B": "Jean Piaget", "C": "Carl Jung", "D": "Ivan Pavlov"}, "explanation": "Carl Jung formulated the archetypal theory where myths reflect the primordial symbols residing within the human collective unconscious."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 185, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 185", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Grammar", "Carl Jung Archetype"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1296", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "silambu_kannagi_kotravai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரத்தில் மதுரையை எரித்த கண்ணகியின் சீற்றம் எந்தத் தொன்மத்தின் வெளிப்பாடாக இலக்கிய ஆய்வாளர்களால் கருதப்படுகிறது?", "media_id": null}], "options": {"A": "மழைத் தெய்வத்தின் அருள்", "B": "வருண பகவானின் கோபம்", "C": "சரசுவதியின் வாக்கு", "D": "தீத்தெய்வமும் அநீதிக்கு எதிரான இயற்கைச் சீற்றமும் கொண்ட கொற்றவைத் தொன்மம்"}, "explanation": "கண்ணகியின் கற்புக் கனலும் அநீதிக்கு எதிரான ஆவேசமும் பழையோள் கொற்றவையின் தொன்மத்தோடு இணைத்துப் பார்க்கப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Kannagi's righteous wrath burning the city of Madurai in Silappathikaram is identified with which ancient archetypal myth?", "media_id": null}], "options": {"A": "Grace of rain deity", "B": "Wrath of Varuna", "C": "Speech of Saraswati", "D": "The archetype of Kotravai and elemental cosmic fire rebelling against injustice"}, "explanation": "Kannagi's unyielding chastity and retaliatory fury against royal injustice align with the fierce Kotravai mother archetype."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "2024-2025", "page": 186, "chapter": null, "section": null, "reference": "12th Tamil, Unit 7, Page 186", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["Class 12", "Unit 7", "Grammar", "Kannagi Kotravai"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-05T12:00:00Z", "updated_at": "2026-11-05T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "12th_tamil_u7_q1297", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "12", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "thonmam_grammar", "chapter_id": null, "topic_id": "kupa_rajagopalan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "‘குருசேத்திரப் போரில் வீழ்ந்த கர்ணன்’ என்ற தொன்மத்தைக் கொண்டு கு.ப. ராஜகோபாலன் எழுதிய சிறுகதை எது?", "media_id": null}], "options": {"A": "கர்ணன் மற்றும் அகலிகை பற்றிய நவீனப் பார்வைகள்", "B": "நளவெண்பா உரை", "C": "வில்லிபாரதச் சுருக்கம்", "D": "கண்ணன் பாட்டு உரை"}, "explanation": "கு.ப.ரா அவர்கள் அகலிகை மற்றும் மகாபாரதக் கதாபாத்திரங்களின் உள்ளார்ந்த மன உணர்வுகளைத் தொன்ம மறுவாசிப்பாக எழுதியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which renowned work/theme was explored using Mahabharata mythological archetypes by Ku. Pa. Rajagopalan?", "media_id": null}], "options": {"A": "Modernist perspectives on Karna and Agaligai archetypes", "B": "Nalavenba commentary", "C": "Villibharatam abridgment", "D": "Kannan Pattu notes"}, "explanation": "Ku. Pa. Rajagopalan creatively explored psychological dilemmas using the Agaligai and Mahabharata mythic motifs."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "12", "term": "full_year", "edition": "20