{"id": "9th-u4-q151", "schema_version": "1.0", "kind": "factual", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "9", "subject_id": "general_tamil", "term": "full_year", "unit_id": "9th-tamil-u4", "lesson_id": "9th-tamil-u4-l6", "chapter_id": null, "topic_id": "book-back-evaluation-q4", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"பெண்ணடிமை தீரும் வரை மண்ணடிமை தீருமோ என வெடித்தவர் யார்?\" (அல்லது 'பெண் கல்வி வேண்டும் எனப் பாடியவர்')", "media_id": null}], "options": {"A": "சுப்பிரமணிய பாரதியார்", "B": "கவிமணி", "C": "புரட்சிக்கவிஞர் பாரதிதாசன்", "D": "நாமக்கல் கவிஞர்"}, "explanation": "'பெண்ணடிமை தீரும் வரை மண்ணடிமை தீருமோ' என்று பெண்ணடிமைத்தனத்தை எதிர்த்து முழங்கியவர் புரட்சிக் கவிஞர் பாரதிதாசன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "\"Will the slavery of our land end before the subjugation of women is eradicated?\" - Who uttered this fiery question?", "media_id": null}], "options": {"A": "Subramania Bharati", "B": "Kavimani", "C": "Puratchi Kavignar Bharathidasan", "D": "Namakkal Kavignar"}, "explanation": "Revolutionary poet Bharathidasan connected national liberation inextricably to the emancipation of women."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "9", "term": "full_year", "edition": "2024-2025", "page": 99, "chapter": null, "section": null, "refe