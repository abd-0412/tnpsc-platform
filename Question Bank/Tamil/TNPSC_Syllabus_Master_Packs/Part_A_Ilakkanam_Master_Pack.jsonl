{"id": "7th-t3-u1-q021", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-01-virundhombal", "chapter_id": null, "topic_id": "ta-t3-u1-grammar-sandhi-ondruraa", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மாரி + ஒன்று = மாரியொன்று' என்னும் புணர்ச்சியில் இடம்பெற்றுள்ள உடம்படுமெய் விதி யாது?"}], "options": {"A": "இ ஈ ஐ வழி யவ்வும்", "B": "ஏனை உயிர்வழி வவ்வும்", "C": "தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும்", "D": "உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே"}, "explanation": "'மாரி' நிலைமொழி ஈற்றில் 'இ'காரம் (ர் + இ) நிற்பதால், 'இ ஈ ஐ வழி யவ்வும்' என்னும் விதிப்படி 'ய்' என்னும் உடம்படுமெய் தோன்றி (மாரி + ய் + ஒன்று), பின்னர் ய் + ஒ = யொ என இணைந்து 'மாரியொன்று' என்றானது."}, "en": {"blocks": [{"type": "text", "content": "Identify the Udambadumey Sandhi rule operating in 'Maari + Ondru = Maariyonru':"}], "options": {"A": "I Ee Ai vazhi yavvum", "B": "Eenai uyirvazhi vavvum", "C": "Thanikkuril mun otru uyirvarin irattum", "D": "Udalmel uyirvanthu ondruvathu iyalbe"}, "explanation": "Since 'Maari' ends with vowel 'i', the rule 'I Ee Ai vazhi yavvum' inserts the semi-vowel 'y', yielding 'Maariyonru'. Option A is correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer 