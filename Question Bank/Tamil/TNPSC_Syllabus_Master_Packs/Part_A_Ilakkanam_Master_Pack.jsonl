{"id": "11th_tamil_u6_q166", "schema_version": "1.0", "kind": "multiple_choice", "level": "hard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "grammar_vallinam_sandhi", "chapter_id": null, "topic_id": "kutriyalugaram_exceptions", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மென்தொடர்க் குற்றியலுகரம் மற்றும் இடைத்தொடர்க் குற்றியலுகரச் சொற்களின் பின் வல்லினம் எவ்வாறமையும்?", "media_id": null}], "options": {"A": "எப்போதும் மிகும்", "B": "பெரும்பாலும் வல்லினம் மிகாது (எ.கா: வந்து போனான், அம்பு பாய்ந்தது, செய்து பார்த்தான்)", "C": "இரட்டிக்கும்", "D": "மெல்லினமாக மாறும்"}, "explanation": "வன்தொடர்க் குற்றியலுகரத்தில் மட்டுமே வல்லினம் மிகும்; மென்தொடர் (வந்து போனான்) மற்றும் இடைத்தொடர்க் குற்றியலுகரங்களில் வல்லினம் மிகாது."}, "en": {"blocks": [{"type": "text", "content": "How does Vallinam behave following Mentodar and Idaitodar Kutriyalukaram words?", "media_id": null}], "options": {"A": "Always geminates", "B": "Generally does not geminate (e.g., Vanthu ponaan, Ambu paaynthathu)", "C": "Always doubles", "D": "Mutates to nasal"}, "explanation": "Unlike Vantodar roots, Mentodar and Idaitodar roots do not cause plosive doubling."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition":