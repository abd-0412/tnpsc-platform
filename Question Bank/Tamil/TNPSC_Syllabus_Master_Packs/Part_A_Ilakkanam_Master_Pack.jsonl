{"id": "7th-t1-u1-077", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l5-kutriyalugaram", "chapter_id": null, "topic_id": "mutriyalugaram-nature", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கதவு' என்னும் சொல்லின் இறுதியில் அமைந்துள்ள 'வு' எவ்வகை உகரம் மற்றும் அதன் மாத்திரை அளவு யாது?"}], "options": {"A": "முற்றியலுகரம் (வல்லினம் அல்லாத மெய்யோடு இணைந்த உகரம்), 1 மாத்திரை", "B": "வன்தொடர்க் குற்றியலுகரம், 0.5 மாத்திரை", "C": "இடைத்தொடர்க் குற்றியலுகரம், 0.5 மாத்திரை", "D": "ஐகாரக்குறுக்கம், 1.5 மாத்திரை"}, "explanation": "'வு' என்பது இடையின மெய்யான 'வ்' உடன் இணைந்த உகரம். இது வல்லினம் அல்லாத மெய் உகரம் என்பதால் முழுமையாக 1 மாத்திரை பெறும் முற்றியலுகரம் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What type of 'u' syllable is 'vu' terminating the word 'Kadhavu', and what is its mora duration?"}], "options": {"A": "Mutriyalugaram (Non-plosive medial consonant 'v' + 'u'), 1 full mora", "B": "Van-thodar, 0.5 mora", "C": "Idai-thodar, 0.5 mora", "D": "Aigaarakkurukkam, 1.5 morae"}, "explanation": "'Vu' is formed by non-plosive medial consonant 'v' + 'u', thus remaining unreduced at 1 full mora (Mutriyalugaram)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nad