{"id": "6th-t2-u1-072", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'கார்த்திக்', 'ஹாங்காங்' ஆகிய சொற்கள் தமிழ் இலக்கணப்படி மொழி இறுதி எழுத்து விதிகளுக்கு உட்படாதவை.\nகாரணம் (R): இச்சொற்கள் பிறமொழிப் பெயர்களாக இருப்பதனால் முறையே 'க்', 'ங்' ஆகிய தமிழ் மொழிக்கு இறுதியாகா மெய்களை இறுதியில் பெற்றுள்ளன.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) சரியான விளக்கமாகும்.", "B": "கூற்று சரி, காரணம் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "பாடநூல் 'தெரிந்து தெளிவோம்' விளக்கம்: கார்த்திக், ஹாங்காங் போன்ற பிறமொழிப் பெயர்களில் இவ்வுயிரற்ற வல்லின மற்றும் ங் மெய்கள் இறுதியில் வருவதுண்டு."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'கார்த்திக்', 'ஹாங்காங்' ஆகிய சொற்கள் தமிழ் இலக்கணப்படி மொழி இறுதி எழுத்து விதிகளுக்கு உட்படாதவை.", "reason": "இச்சொற்கள் பிறமொழிப் பெயர்களாக இருப்பதனால் முறையே 'க்', 'ங்' ஆகிய தமிழ் மொழிக்கு இறுதியாகா மெய்களை இறுதியில் பெற்றுள்ளன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": 