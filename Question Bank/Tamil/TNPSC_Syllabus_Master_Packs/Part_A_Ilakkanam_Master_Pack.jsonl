{"id": "7th-t3-u2-q122", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-uruvaga-ani-rules-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'வையம் தகளியா வார்கடலே நெய்யாக' என்னும் பாடலில் உருவக அணி அமைந்துள்ளது.\nகாரணம் (R): உவமிக்கப்படும் பொருளையும் உவமையையும் வேறுபடுத்தாமல் இரண்டும் ஒன்றே என்று கூறுவது உருவக அணி ஆகும்."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "C": "கூற்று தவறு, காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் பக்கம் 21: பூமி வேறு தகழி வேறு எனப் பிரிக்காமல் பூமியே தகழி எனக் கூறியதால் இது உருவக அணி. கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'Vaiyam thagaliyaa vaarkadale neyyaaga' contains Uruvaga Ani (Metaphor).\nReason (R): Identifying the Upameya and Upamana as one without differentiating them constitutes Uruvaga Ani."}], "options": {"A": "Assertion is true, Reason is false", "B": "Both Assertion and Reason are true, and Reason is the correct explanation", "C": "Assertion is false, Reason is true", "D": "Both Assertion and Reason are false"}, "explanation": "Both A and R are verified grammatical facts from page 21; R directly defines why it is Uruvaga Ani."}}, "question_data": {"assertion": "'வையம் தகளியா வார்கடலே நெய்யாக' என்னும் பாடலில் உருவக அணி அமைந்துள்ளது.", "reason": "உவமிக்கப்படும் பொருளையும் உவமையையும் வேறுபடுத்தாமல் இரண்டும் ஒன்றே என்று கூறுவது உருவக அணி ஆகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 21, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pudhumai_vilakku", "grammar", "uruvaga_ani", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u2-q132", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-grammar-maathirai-thagali", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தகளி' என்னும் சொல்லின் மொத்த மாத்திரை அளவைக் கணக்கிடுக:"}], "options": {"A": "2 மாத்திரை", "B": "2.5 மாத்திரை", "C": "3.5 மாத்திரை", "D": "3 மாத்திரை"}, "explanation": "'தகளி' மாத்திரை பகுப்பாய்வு:\nத (குறில்) = 1 மாத்திரை\nக (குறில்) = 1 மாத்திரை\nளி (குறில்) = 1 மாத்திரை\nமொத்தம் = 1 + 1 + 1 = 3 மாத்திரை."}, "en": {"blocks": [{"type": "text", "content": "Calculate the total prosodic metric count (Maathirai) for the poetic word 'Thagali':"}], "options": {"A": "2 Maathirai", "B": "2.5 Maathirai", "C": "3.5 Maathirai", "D": "3 Maathirai"}, "explanation": "Metrics for 'Thagali': Tha (1) + ka (1) + li (1) = 3 Maathirai. Key D is correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 20, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pudhumai_vilakku", "grammar", "metrics", "maathirai"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u2-q133", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-grammar-sandhi-idam-aazhi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'இடர் + ஆழி = இடராழி' என்னும் புணர்ச்சியில் இடம்பெற்றுள்ள விதி யாது?"}], "options": {"A": "உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே", "B": "உயிர்வரின் உக்குறள் மெய்விட்டோடும்", "C": "தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும்", "D": "இ ஈ ஐ வழி யவ்வும்"}, "explanation": "'இடர் + ஆழி': நிலைமொழி ஈற்றில் 'ர்' என்னும் மெய்யெழுத்தும் (உடல்), வருமொழி முதலில் 'ஆ' என்னும் உயிரெழுத்தும் உள்ளதால், 'உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே' என்னும் விதிப்படி ர் + ஆ = ரா என இணைந்து 'இடராழி' என்றானது."}, "en": {"blocks": [{"type": "text", "content": "Identify the Sandhi rule operating in 'Idar + Aazhi = Idaraazhi':"}], "options": {"A": "Udalmel uyirvanthu ondruvathu iyalbe", "B": "Uyirvarin ukkural meyvittodum", "C": "Thanikkuril mun otru uyirvarin irattum", "D": "I Ee Ai vazhi yavvum"}, "explanation": "Consonant 'r' joins vowel 'aa' under the classic rule 'Udalmel uyirvanthu ondruvathu iyalbe' to form 'Idaraazhi'. Option A is correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu S