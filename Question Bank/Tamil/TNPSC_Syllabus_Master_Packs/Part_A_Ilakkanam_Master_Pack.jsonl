{"id": "7th-t3-u1-q023", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-01-virundhombal", "chapter_id": null, "topic_id": "ta-t3-u1-grammar-ilakkana-kurippu-ondruraa", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஒன்றுறா முன்றில்' என்ற தொடரில் 'ஒன்றுறா' என்பதன் சரியான இலக்கணக் குறிப்பு யாது?"}], "options": {"A": "முதனிலைத் தொழிற்பெயர்", "B": "வினையாலணையும் பெயர்", "C": "ஈறுகெட்ட எதிர்மறைப் பெயரெச்சம்", "D": "செய்யா வாய்ப்பாட்டு வினையெச்சம்"}, "explanation": "'ஒன்றுறாத முன்றில்' என வரவேண்டிய தொடரில், இறுதி 'த' கெட்டு 'ஒன்றுறா' என நின்று 'முன்றில்' என்னும் பெயர்ச்சொல்லைக் கொண்டு முடிவதால், இது 'ஈறுகெட்ட எதிர்மறைப் பெயரெச்சம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the precise grammatical categorization (Ilakkana Kurippu) of 'Ondruraa' in 'Ondruraa mundril':"}], "options": {"A": "Primary verbal noun", "B": "Participial noun", "C": "Eeruketta Ethirmarai Peyarecham", "D": "Seyyaa pattern Vinaiyecham"}, "explanation": "'Ondruraadha' dropped its final syllable 'dha' becoming 'Ondruraa' and modifies the noun 'Mundril', classifying it as Eeruketta Ethirmarai Peyarecham."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher"