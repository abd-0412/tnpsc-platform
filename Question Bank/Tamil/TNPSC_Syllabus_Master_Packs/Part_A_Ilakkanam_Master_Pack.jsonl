{"id": "11th_tamil_rev2_q119", "schema_version": "1.0", "kind": "multiple_choice", "level": "medium", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "11", "subject_id": "general_tamil", "term": "full_year", "unit_id": "revision_megapack_2", "lesson_id": "rev_u7_u8_interview_proof_names", "chapter_id": null, "topic_id": "proofreading_pilcrow_space", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மெய்ப்புத் திருத்தத்தில் ‘பத்தி பிரிக்க’ (Paragraph break) பயன்படுத்தப்படும் குறியீடு எது?", "media_id": null}], "options": {"A": "Caret (^)", "B": "Dele", "C": "பில்கிரோ / பத்திக் குறியீடு (¶ அல்லது [ )", "D": "Stet"}, "explanation": "ஒரு பத்தியைப் புதிதாகத் தொடங்க வேண்டும் என்பதைக் குறிக்க பில்கிரோ (Pilcrow - ¶) அல்லது அடைப்புக் குறியீடு பயன்படும்."}, "en": {"blocks": [{"type": "text", "content": "Which standard proofreading symbol instructs the typesetter to start a new paragraph?", "media_id": null}], "options": {"A": "Caret (^)", "B": "Dele", "C": "Pilcrow symbol (¶ or [ )", "D": "Stet"}, "explanation": "The Pilcrow sign (¶) designates the insertion of a new paragraph indent."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "11", "term": "full_year", "edition": "2024-2025", "page": 220, "chapter": null, "section": null, "reference": "11th Tamil, Unit revision_megapack_2, Page 220", "url": null, "source_no