{"id": "7th-t2-u2-q252", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-11-thirukkural", "chapter_id": null, "topic_id": "ta-t2-u2-direct-bookback-theemai-kaaranam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளின்படி எதனால் ஒருவருக்குத் தீமை உண்டாகும்?"}], "options": {"A": "செய்யத்தகுந்த செயல்களைச் செய்வதால்", "B": "செய்யத்தகாத செயல்களைச் செய்யாமல் இருப்பதால்", "C": "செய்யத்தகுந்த செயல்களைச் செய்யாமல் விடுவதாலும், செய்யத்தகாதவற்றைச் செய்வதாலும்", "D": "எந்தச் செயலையும் தொடங்குவதற்கு முன் சிந்திப்பதால்"}, "explanation": "பாடநூல் மதிப்பீடு வினா 1: 'செய்தக்க அல்ல செயக்கெடும் செய்தக்க செய்யாமை யானும் கெடும்' என்ற குறளின்படி செய்யத்தகுந்த செயல்களைச் செய்யாமல் விடுவதாலும் தீமை உண்டாகும்."}, "en": {"blocks": [{"type": "text", "content": "According to Thirukkural, how does harm/ruin befall a person?"}], "options": {"A": "By executing noble duties", "B": "By abstaining from prohibited acts", "C": "By omitting obligatory actions and committing prohibited acts", "D": "By deliberate scrutiny prior to action"}, "explanation": "Textbook evaluation 1: Ruin occurs both by doing what should not be done and failing to do what ought to be done."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 42, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["direct", "bookback", "thirukkural"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
