{"id": "7th-t2-pyq-q306", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-11-thirukkural", "chapter_id": null, "topic_id": "ta-t2-pyq-quote-fill-madiyinmai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறள் அடியை நிறைவு செய்க:\n'மடியை மடியா தொழுகல் ________\nகுடியாக வேண்டு பவர்.'"}], "options": {"A": "குடியைக்", "B": "நன்றைக்", "C": "அறிவைக்", "D": "செல்வத்தைக்"}, "explanation": "குறள் (குறள் 602): 'மடியை மடியா தொழுகல் குடியைக் குடியாக வேண்டு பவர்'. விடுபட்ட சொல் 'குடியைக்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Complete the verse from Chapter Madiyinmai (Unslothfulness):\n'Madiyai madiyaa thozhugal ________\nkudiyaaga vendu bavar.'"}], "options": {"A": "Kudiyaik", "B": "Nanraik", "C": "Arivaic", "D": "Selvathaik"}, "explanation": "Kural 602: 'Madiyai madiyaa thozhugal kudiyaik kudiyaaga vendu bavar'. The missing word is 'Kudiyaik' (Key A)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_