{"id": "7th-t2-pyq-q308", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-pyq-direct-thozhirpeyar-definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒரு செயலின் அல்லது தொழிலின் பெயராக அமைந்து எண், இடம், காலம், பால் ஆகியவற்றைக் காட்டாமல் படர்க்கையில் மட்டும் வரும் பெயர் எது?"}], "options": {"A": "பொருட்பெயர்", "B": "இனப்பெயர்", "C": "வினையாலணையும் பெயர்", "D": "தொழிற்பெயர்"}, "explanation": "பாடநூல் பக்கம் 37 இலக்கண வரைவிலக்கணம்: ஒரு செயலின் அல்லது வினையின் பெயராக அமைவது 'தொழிற்பெயர்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which noun functions as the name of an action, does not indicate number, person, tense, or gender, and belongs exclusively to the third person?"}], "options": {"A": "Concrete Noun", "B": "Generic Noun", "C": "Participial Noun", "D": "Verbal Noun (Thozhirpeyar)"}, "explanation": "Textbook page 37 definition: The noun that stands as the name of an action without marking tense, person, or gender is the Verbal Noun (Thozhirpeyar)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": 