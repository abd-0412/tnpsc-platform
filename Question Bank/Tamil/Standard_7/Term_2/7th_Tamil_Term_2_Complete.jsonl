{"id": "7th-t2-u2-q135", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-grammar-ezhutthaani-sandhi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'எழுத்து + ஆணி' என்பதனைச் சேர்த்தெழுதக் கிடைக்கும் சரியான சொல் யாது? அங்கு நிகழ்ந்த புணர்ச்சி மாற்றம் யாது?"}], "options": {"A": "எழுத்துஆணி (இயல்புப் புணர்ச்சி)", "B": "எழுதாணி (மெய்க்கெடு புணர்ச்சி)", "C": "எழுத்தாணி (உயிர்வரின் உக்குறள் மெய்விட்டோடி உடல்மேல் உயிர் இணைந்தது)", "D": "எழுத்துதாணி (தோன்றல் புணர்ச்சி)"}, "explanation": "எழுத்து + ஆணி:\nநிலைமொழி ஈற்று 'து'வில் உள்ள 'உ' கெட்டு (எழுத் + ஆணி), த் + ஆ = தா என இணைந்து 'எழுத்தாணி' எனப் புணரும். பாடநூல் மதிப்பீடு வினா 5."}, "en": {"blocks": [{"type": "text", "content": "What is the combined form of 'Ezhuthu + Aani' and the phonetic transformation involved?"}], "options": {"A": "Ezhuthuaani (Natural sandhi)", "B": "Ezhuthaani (Consonant drop sandhi)", "C": "Ezhutthaani (Ukkural elision followed by vowel attachment)", "D": "Ezhuthuthaani (Augmentative sandhi)"}, "explanation": "'Ezhuthu + Aani' drops the final short 'u' and fuses 'th' + 'aa' into 'thaa', yielding 'Ezhutthaani'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_na