{"id": "7th-t2-u2-q138", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-07-poothoduthal", "chapter_id": null, "topic_id": "ta-t2-u2-quote-fill-poothoduthal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உமா மகேஸ்வரியின் 'பூத்தொடுத்தல்' கவிதை அடியை நிறைவு செய்க:\n'ஒரு வினாடி கூடப் பூக்களின் முகத்தை\n___________ விரல்களினால் தொட முடிவதில்லை.'"}], "options": {"A": "அஞ்சிய", "B": "இறுகிய", "C": "வலிய", "D": "சாந்தமான"}, "explanation": "பாடலின் அழகியல் வரிகள் அமைதி ததும்பும் 'சாந்தமான விரல்களினால்' மலர்களின் நளினத்தைத் தொடுதல் பற்றியதாகும். 'சாந்தம்' என்பது அமைதியைக் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "Complete the verse line from Uma Maheswari's 'Poothoduthal':\n'Oru vinaadi koodap pookkalin mugathai\n___________ viralkalinaal thoda mudivathillai.'"}], "options": {"A": "Anjiya", "B": "Irugiya", "C": "Valiya", "D": "Santhamaana"}, "explanation": "The poem invokes gentle, peaceful fingers ('Santhamaana viralkalinaal') touching the delicate faces of blossoms."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025"