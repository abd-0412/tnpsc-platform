{"id": "7th-t2-u2-q137", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-odd-thuni-synonyms", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழங்காலத்தில் ஓவியம் வரையப் பயன்பட்ட துணியைக் குறிக்கும் பெயர்களில் பொருந்தாத ஒன்றைக் கண்டறிக:"}], "options": {"A": "சித்திரக்கூடம்", "B": "சித்திரப்படம்", "C": "சித்திரச்சுவர்", "D": "களம்காரி"}, "explanation": "ஓவியம் வரையப்பட்ட துணியைச் 'சித்திரப்படம்', 'சித்திரச்சுவர்', 'களம்காரி' என அழைத்தனர். 'சித்திரக்கூடம்' என்பது ஓவியங்கள் காட்சிப்படுத்தப்படும் கலைக்கூடம்/அரங்கத்தைக் குறிப்பதாகும்; துணியைக் குறிக்காது."}, "en": {"blocks": [{"type": "text", "content": "Find the term that was NOT an ancient synonym for painting canvas/cloth:"}], "options": {"A": "Chithirakkoodam", "B": "Chithirappadam", "C": "Chithirachuvor", "D": "Kalamkari"}, "explanation": "Fabric canvas was termed Chithirappadam, Chithirachuvor, and Kalamkari. 'Chithirakkoodam' denotes an art gallery hall, not the canvas cloth itself."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition"