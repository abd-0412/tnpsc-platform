{"id": "7th-t2-pyq-q304", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-05-ilakkiyavagai-sorkal", "chapter_id": null, "topic_id": "ta-t2-pyq-odd-foreign-loan-words", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திசைச்சொற்களுள் வேற்று மொழிச் சொல்லாக அமைந்தவற்றில் பொருந்தாத ஒன்றைக் கண்டறிக:"}], "options": {"A": "மண்", "B": "சாவி", "C": "சன்னல்", "D": "இரயில்"}, "explanation": "'சாவி', 'சன்னல்', 'இரயில்' என்பவை பிற மொழிகளிலிருந்து தமிழுக்கு வந்த 'திசைச்சொற்கள்'. 'மண்' என்பது எல்லோர்க்கும் எளிதில் பொருள் விளங்கும் 'பெயர் இயற்சொல்' ஆகும். எனவே 'A' பொருந்தாதது."}, "en": {"blocks": [{"type": "text", "content": "Identify the odd word among the following regional/foreign loanwords:"}], "options": {"A": "Mann", "B": "Saavi", "C": "Sannal", "D": "Rayil"}, "explanation": "'Mann' is a pure native noun Iyarsol; the others are Tisaisorkal (loanwords). A is the odd one out."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year