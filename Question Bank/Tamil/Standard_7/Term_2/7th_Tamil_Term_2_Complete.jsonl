// ==============================================================================
// பகுதி 2: உயர்நிலை இலக்கணப் பொறிகள் & செய்யுள் யாப்பியல் (Advanced Grammar Traps & Metrics) [Q281 - Q308]
// சொல் வகைகள், இலக்கியவகைச் சொற்கள் (இயற்சொல், திரிசொல், திசைச்சொல், வடசொல்), தொழிற்பெயர் வகைகள் (விகுதி பெற்றவை, முதனிலை, முதனிலை திரிந்தது, எதிர்மறை), தொழிற்பெயர் vs வினையாலணையும் பெயர், மாத்திரை அளவுகள், புணர்ச்சி விதிகள், அணி இலக்கணம்
// ==============================================================================
{"id": "7th-t2-pyq-q281", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-05-ilakkiyavagai-sorkal", "chapter_id": null, "topic_id": "ta-t2-pyq-iyarsol-characteristics-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயற்சொல் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. எல்லார்க்கும் எளிதில் பொருள் விளங்கும் சொல்லாக அமைவது இயற்சொல்.\n2. இது பெயர், வினை, இடை, உரி என நான்கு வகைகளில் வரும்.\n3. மண், பொன் என்பவை பெயர் இயற்சொல்; நடந்தான், வந்தான் என்பவை வினை இயற்சொல்.\n4. இயற்சொற்கள் கற்றவர்களுக்கு மட்டுமே விளங்கக்கூடிய கடினமான சொற்கள் ஆகும்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 2, 3 மட்டுமே சரி; 4 தவறு", "C": "1, 3 மட்டுமே சரி; 2, 4 தவறு", "D": "2, 4 மட்டுமே சரி; 1, 3 தவறு"}, "explanation": "கற்றவர்களுக்கு மட்டுமே விளங்கக்கூடிய சொற்கள் 'திரிசொற்கள்' எனப்படும்; இயற்சொற்கள் எல்லோருக்கும் எளிதில் விளங்குபவை. எனவே கூற்று 4 தவறு. 1, 2, 3 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements regarding Iyarsol:\n1. Words easily understood by all are Iyarsol.\n2. It occurs in four forms: noun, verb, particle, and qualitative.\n3. Mann, Pon are noun iyarsol; Nadanthan, Vanthan are verb iyarsol.\n4. Iyarsol are dense words comprehensible only to scholars.\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1, 2, and 3 only correct; 4 incorrect", "C": "1 and 3 only correct; 2 and 4 incorrect", "D": "2 and 4 only correct; 1 and 3 incorrect"}, "explanation": "Words comprehensible only to scholars are Thirisorkal, not Iyarsorkal. Statement 4 is false. 1, 2, 3 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "எல்லார்க்கும் எளிதில் பொருள் விளங்கும் வகையில் அமைந்த சொற்கள் இயற்சொற்கள் எனப்படும்.", "content_en": "Words whose meanings are easily understood by all are Iyarsorkal."}, {"id": "S2", "content_ta": "இயற்சொல் பெயர் இயற்சொல், வினை இயற்சொல், இடை இயற்சொல், உரி இயற்சொல் என நான்கு வகைப்படும்.", "content_en": "Iyarsol is classified into four types: noun, verb, particle, and qualitative."}, {"id": "S3", "content_ta": "மண், பொன் என்பவை பெயர் இயற்சொற்கள்; நடந்தான், வந்தான் என்பவை வினை இயற்சொற்கள் ஆகும்.", "content_en": "Mann, Pon are noun iyarsol; Nadanthan, Vanthan are verbal iyarsol."}, {"id": "S4", "content_ta": "இயற்சொற்கள் கற்றவர்களுக்கு மட்டுமே விளங்கக்கூடிய கடினமான இலக்கணச் சொற்கள் ஆகும்.", "content_en": "Iyarsorkal are difficult grammatical words understandable only to scholars."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 17, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4 / Group 2", "exam_name": "TNPSC Combined Civil Services", "year": "2014-2024", "paper": "General Tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pyq", "iyarsol", "grammar", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"sta