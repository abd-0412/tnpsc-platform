{"id": "7th-t2-u2-q136", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-odd-ancient-materials", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டையத் தமிழர்கள் ஓவியம் வரைவதற்குப் பயன்படுத்திய பாரம்பரியப் பொருள்களில் பொருந்தாத நவீனப் பொருள் ஒன்றைத் தேர்ந்தெடுக்க:"}], "options": {"A": "பாறை மற்றும் சுவர்கள்", "B": "துணி மற்றும் ஓலைச்சுவடிகள்", "C": "செப்பேடுகள் மற்றும் யானைத் தந்தங்கள்", "D": "செயற்கை அக்ரிலிக் நெகிழிச் சாயங்கள்"}, "explanation": "பழந்தமிழர்கள் பாறை, சுவர், துணி, ஓலைச்சுவடி, செப்பேடு, தந்தம், கண்ணாடி போன்றவற்றில் இயற்கை வண்ணங்களால் வரைந்தனர். செயற்கை அக்ரிலிக் நெகிழிச் சாயங்கள் தற்கால நவீனப் பொருளாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the modern material that does NOT belong to the traditional indigenous painting media of ancient Tamils:"}], "options": {"A": "Rocks and walls", "B": "Cloth and palm leaves", "C": "Copper plates and ivory", "D": "Synthetic acrylic polymer paints"}, "explanation": "Ancient Tamils used rocks, murals, cloth, palm leaves, and ivory. Synthetic acrylic polymers are modern industrial materials."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil