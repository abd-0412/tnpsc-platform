{"id": "7th-t2-u2-q164", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-odd-art-media", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தற்கால ஓவிய வடிவங்களில் பொருந்தாத பழங்கால ஓவிய வடிவம் ஒன்றைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கருத்துப்படம் (Cartoon)", "B": "நாட்காட்டி ஓவியம் (Calendar Painting)", "C": "நவீன ஓவியம் (Modern Art)", "D": "சுண்ணாம்புக் குகைக் கோட்டோவியம்"}, "explanation": "கருத்துப்படம், நாட்காட்டி ஓவியம், நவீன ஓவியம் ஆகியவை தற்கால நவீன ஓவிய வடிவங்கள். சுண்ணக் குகைக் கோட்டோவியம் என்பது பல்லாயிரம் ஆண்டுகளுக்கு முந்தைய ஆதிமனிதரின் பழங்கால ஓவியமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the ancient traditional art form that does NOT belong to the modern painting genres:"}], "options": {"A": "Cartoon", "B": "Calendar Painting", "C": "Modern Art", "D": "Prehistoric lime cave line drawing"}, "explanation": "Cartoon, calendar art, and modern art are modern styles. Prehistoric cave drawings date back millennia, making option D the odd ancient form."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Servic