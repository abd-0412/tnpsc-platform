{"id": "7th-t2-u2-q157", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-match-historical-artifacts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வரலாற்று ஓவிய ஆவணங்களையும் அவற்றின் விளக்கங்களையும் பொருத்துக:\n(a) இந்தியா இதழ் - 1. பாரதியாரின் கருத்துப்படம்\n(b) பஜார் பெயிண்டிங் - 2. கொண்டையராஜுவின் நாட்காட்டி முறை\n(c) தற்கால ஓவிய ஊடகம் - 3. தாள், கரிக்கோல், நீர் வண்ணம்\n(d) அரசு ஆவண ஓவியம் - 4. செப்பேடுகள் மீது வரைதல்"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-3, b-4, c-1, d-2", "D": "a-4, b-3, c-2, d-1"}, "explanation": "இந்தியா இதழ் = பாரதியார் கருத்துப்படம் (1); பஜார் பெயிண்டிங் = நாட்காட்டி ஓவியம் (2); தற்கால ஓவிய ஊடகம் = தாள், கரிக்கோல் (3); அரசு ஆவண ஓவியம் = செப்பேடு (4). அனைத்தும் நேருக்கு நேராகச் சரியாகப் பொருந்தியுள்ளன. a-1, b-2, c-3, d-4."}, "en": {"blocks": [{"type": "text", "content": "Match historical art records with their descriptions:\n(a) India magazine - 1. Bharathiyar's political cartoon\n(b) Bazaar painting - 2. Kondaiyaraju's calendar art\n(c) Modern media - 3. Paper, charcoal, watercolor\n(d) State archival art - 4. Copper plate inscriptions"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-3, b-4, c-1, d-2", "D": "a-4, b-3, c-2, d-1"}, "explanation": "Each art historical development matches its textbook explanation sequentially (1, 2, 3, 4)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "இந்தியா இதழ்", "content_en": "India magazine"}, {"id": "L2", "content_ta": "பஜார் பெயிண்டிங்", "content_en": "Bazaar painting"}, {"id": "L3", "content_ta": "தற்கால ஓவிய ஊடகம்", "content_en": "Modern art medium"}, {"id": "L4", "content_ta": "அரசு ஆவண ஓவியம்", "content_en": "State archive art"}], "right": [{"id": "R1", "content_ta": "பாரதியாரின் கருத்துப்படம்", "content_en": "Bharathiyar's cartoon"}, {"id": "R2", "content_ta": "கொண்டையராஜுவின் நாட்காட்டி முறை", "content_en": "Kondaiyaraju's calendar technique"}, {"id": "R3", "content_ta": "தாள், கரிக்கோல், நீர் வண்ணம்", "content_en": "Paper, charcoal, watercolor"}, {"id": "R4", "content_ta": "செப்பேடுகள் மீது வரைதல்", "content_en": "Incisions upon copper plates"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["art_history", "matching"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
