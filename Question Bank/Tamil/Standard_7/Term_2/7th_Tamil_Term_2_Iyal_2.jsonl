// பாடம் 4: தொழிற்பெயர் (கற்கண்டு - தொழிற்பெயர் வகைகள் & இலக்கணக் கூறுகள்) [Q197 - Q224]
// தொழில் / வினையை உணர்த்தும் பெயர் தொழிற்பெயர்; எண், இடம், காலம், பால் காட்டாது, படர்க்கைக்கே உரியது; விகுதி பெற்ற தொழிற்பெயர் (தல், அல், அம், ஐ, கை, வை, கு, பு, ஊ, தி, சி, வி, உள் ஆகிய 13 விகுதிகள்; எ.கா: தருதல், வந்தல், ஆட்டம், விலை, வருகை, பார்வை, போக்கு, நட்பு, மறதி, உணர்ச்சி, கல்வி), முதனிலைத் தொழிற்பெயர் (விகுதி பெறாமல் பகுதி மட்டுமே தொழிலை உணர்த்துவது; எ.கா: தட்டு, உரை, அடி, கொதி, பிடி, புகழ், வாழ்), முதனிலை திரிந்த தொழிற்பெயர் (பகுதி திரிந்து தொழிலை உணர்த்துவது; எ.கா: கெடு->கேடு, சுடு->சூடு, பெறு->பேறு, கொள்->கோள்), எதிர்மறைத் தொழிற்பெயர் (நடவாமை, கொல்லாமை), தொழிற்பெயர் vs வினையாலணையும் பெயர் (தொழிலை உணர்த்தும் vs தொழிலைச் செய்த கருத்தாவைக் குறிக்கும்; காலம் காட்டாது vs முக்காலமும் காட்டும்; படர்க்கைக்கே உரியது vs மூவிடத்திற்கும் உரியது)
// ==============================================================================
{"id": "7th-t2-u2-q197", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-10-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-u2-thozhirpeyar-intro", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொழிற்பெயர் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. ஒரு செயலின் அல்லது வினையின் பெயராக அமைவது தொழிற்பெயர் எனப்படும்.\n2. தொழிற்பெயர் எண், இடம், காலம், பால் ஆகியவற்றை வெளிப்படையாகக் காட்டாது.\n3. தொழிற்பெயர் படர்க்கை இடத்தில் மட்டுமே வரும்.\n4. படித்தல், ஆடல், நடிப்பு, எழுதுதல் என்பன தொழிற்பெயர்களுக்குச் சிறந்த எடுத்துக்காட்டுகளாகும்.\nஇவற்றுள் சரியானவை எவை?"}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 2, 3 மட்டுமே சரி", "C": "2, 3, 4 மட்டுமே சரி", "D": "1, 3, 4 மட்டுமே சரி"}, "explanation": "பாடநூல் பக்கம் 35: தொழிற்பெயர் செயலின் பெயராகும்; எண், இடம், காலம், பால் காட்டாது; படர்க்கைக்கே உரியது. நான்கு கூற்றுகளும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Verbal Nouns (Thozhirpeyar):\n1. A noun designating an action or process is a verbal noun.\n2. It does not overtly express number, person, tense, or gender.\n3. It functions solely in the third person (Padarkkai).\n4. Padithal, Aadal, Nadippu, and Ezhuthuthal are exemplary verbal nouns.\nWhich of these are correct?"}], "options": {"A": "1, 2, 3, 4 all are correct", "B": "1, 2, 3 only correct", "C": "2, 3, 4 only correct", "D": "1, 3, 4 only correct"}, "explanation": "All four statements perfectly outline the definition and grammatical characteristics of Thozhirpeyar."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ஒரு செயலின் அல்லது வினையின் பெயராக அமைவது தொழிற்பெயர் எனப்படும்.", "content_en": "The name given to an action or verb is called a Verbal Noun (Thozhirpeyar)."}, {"id": "S2", "content_ta": "தொழிற்பெயர் எண், இடம், காலம், பால் ஆகியவற்றை வெளிப்படையாகக் காட்டாது.", "content_en": "A verbal noun does not overtly indicate number, place, tense, or gender."}, {"id": "S3", "content_ta": "தொழிற்பெயர் படர்க்கை இடத்தில் மட்டுமே வரும்.", "content_en": "A verbal noun occurs strictly in the third person (Padarkkai)."}, {"id": "S4", "content_ta": "படித்தல், ஆடல், நடிப்பு, எழுதுதல் என்பன தொழிற்பெயர்களுக்குச் சிறந்த எடுத்துக்காட்டுகளாகும்.", "content_en": "Padithal, Aadal, Nadippu, and Ezhuthuthal are prime examples of verbal nouns."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["thozhirpeyar", "grammar", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q198", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-10-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-u2-vikuthi-petra-thozhirpeyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "விகுதி பெற்ற தொழிற்பெயர் குறித்த கூற்றுகளை ஆராய்க:\n1. வினைப்பகுதியுடன் தொழிற்பெயர் விகுதி சேர்ந்து வருவது 'விகுதி பெற்ற தொழிற்பெயர்' ஆகும்.\n2. தல், அல், அம், ஐ, கை, வை, கு, பு, வு, தி, சி, வி, மை போன்றவை தொழிற்பெயர் விகுதிகளாக வரும்.\n3. தொழிற்பெயர் இறந்தகாலம், நிகழ்காலம், எதிர்காலம் ஆகிய முக்காலங்களையும் மிகத் தெளிவாகக் காட்டும்.\n4. 'வாழ்க்கை' என்னும் சொல்லில் 'வாழ்' என்ற பகுதியுடன் 'கை' என்னும் தொழிற்பெயர் விகுதி இணைந்துள்ளது.\nஇவற்றுள் தவறான கூற்று எது?"}], "options": {"A": "கூற்று 1", "B": "கூற்று 3", "C": "கூற்று 2", "D": "கூற்று 4"}, "explanation": "தொழிற்பெயர் 'காலம் காட்டாது'. காலம் காட்டும் என்று கூறும் கூற்று 3 முற்றிலும் தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Suffix-derived Verbal Nouns:\n1. A verbal base combining with a nominal suffix forms a suffixed verbal noun.\n2. Thal, Al, Am, Ai, Kai, Vai, Ku, Pu, Vu, Thi, Si, Vi, Mai act as suffixes.\n3. A verbal noun explicitly marks past, present, and future tenses.\n4. In 'Vaazhkkai', the suffix 'kai' attaches to the root 'vaazh'.\nWhich statement is incorrect?"}], "options": {"A": "Statement 1", "B": "Statement 3", "C": "Statement 2", "D": "Statement 4"}, "explanation": "A verbal noun does not mark tense. Statement 3 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "வினைப்பகுதியுடன் தொழிற்பெயர் விகுதி சேர்ந்து வருவது 'விகுதி பெற்ற தொழிற்பெயர்' ஆகும்.", "content_en": "A verbal noun formed by attaching a suffix to a verb root is a derived verbal noun."}, {"id": "S2", "content_ta": "தல், அல், அம், ஐ, கை, வை, கு, பு, வு, தி, சி, வி, மை போன்றவை தொழிற்பெயர் விகுதிகளாக வரும்.", "content_en": "Thal, Al, Am, Ai, Kai, Vai, Ku, Pu, Vu, Thi, Si, Vi, and Mai serve as verbal noun suffixes."}, {"id": "S3", "content_ta": "தொழிற்பெயர் இறந்தகாலம், நிகழ்காலம், எதிர்காலம் ஆகிய முக்காலங்களையும் மிகத் தெளிவாகக் காட்டும்.", "content_en": "A verbal noun overtly reveals past, present, and future tenses."}, {"id": "S4", "content_ta": "'வாழ்க்கை' என்னும் சொல்லில் 'வாழ்' என்ற பகுதியுடன் 'கை' என்னும் தொழிற்பெயர் விகுதி இணைந்துள்ளது.", "content_en": "In 'Vaazhkkai', the suffix 'kai' joins the root 'vaazh'."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["thozhirpeyar", "vikuthi", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q199", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-10-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-u2-mudhalnilai-thozhirpeyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முதல்நிலைத் தொழிற்பெயர் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. ஏவல் ஒருமை வினையாக அமையும் வினைச்சொற்களின் பகுதியையே முதல்நிலை என்பர்.\n2. பகுதியாகிய முதல்நிலை எவ்வித மாற்றமும் பெறாமல் தொழிற்பெயராக அமைவது 'முதல்நிலைத் தொழிற்பெயர்' ஆகும்.\n3. 'வானில் இடி இடித்தது' என்பதில் 'இடி', 'சோறு கொதி வந்தது' என்பதில் 'கொதி' என்பன விகுதி பெற்ற தொழிற்பெயர்கள் ஆகும்.\nஇவற்றுள் சரியானவை எவை?"}], "options": {"A": "1, 2, 3 அனைத்தும் சரி", "B": "2 மற்றும் 3 மட்டுமே சரி", "C": "1 மற்றும் 2 மட்டுமே சரி", "D": "1 மற்றும் 3 மட்டுமே சரி"}, "explanation": "'இடி', 'கொதி' என்பன விகுதி பெறாமல் பகுதியே தொழிற்பெயராய் நின்ற 'முதல்நிலைத் தொழிற்பெயர்கள்' ஆகும். கூற்று 3-ல் விகுதி பெற்றது எனக் கூறியது தவறு. 1 மற்றும் 2 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Primary Verbal Nouns (Mudhalnilai Thozhirpeyar):\n1. The imperative singular root of a verb is called Mudhalnilai.\n2. When this root functions as a verbal noun without modification, it is a primary verbal noun.\n3. 'Idi' in thunder struck and 'Kothi' in rice boiled are suffixed verbal nouns.\nWhich of these are correct?"}], "options": {"A": "1, 2, 3 all are correct", "B": "2 and 3 only correct", "C": "1 and 2 only correct", "D": "1 and 3 only correct"}, "explanation": "'Idi' and 'Kothi' are unsuffixed primary roots acting as nouns (Mudhalnilai Thozhirpeyar). Statement 3 is false; 1 and 2 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ஏவல் ஒருமை வினையாக அமையும் வினைச்சொற்களின் பகுதியையே முதல்நிலை என்பர்.", "content_en": "The base root of an imperative singular verb is defined as Mudhalnilai."}, {"id": "S2", "content_ta": "பகுதியாகிய முதல்நிலை எவ்வித மாற்றமும் பெறாமல் தொழிற்பெயராக அமைவது 'முதல்நிலைத் தொழிற்பெயர்' ஆகும்.", "content_en": "When an imperative verbal base functions directly as a noun without mutation, it is a primary verbal noun."}, {"id": "S3", "content_ta": "'வானில் இடி இடித்தது' என்பதில் 'இடி', 'சோறு கொதி வந்தது' என்பதில் 'கொதி' என்பன விகுதி பெற்ற தொழிற்பெயர்கள் ஆகும்.", "content_en": "In 'Idithathu', 'Idi' and in 'Kothi vanthathu', 'Kothi' are suffix-derived verbal nouns."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["mudhalnilai_thozhirpeyar", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q200", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-10-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-u2-mudhalnilai-thirintha", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முதல்நிலை திரிந்த தொழிற்பெயர் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. முதல்நிலை திரிந்து தொழிற்பெயராக அமைவது 'முதல்நிலை திரிந்த தொழிற்பெயர்' எனப்படும்.\n2. 'கெடு' என்னும் முதல்நிலை 'கேடு' எனத் திரிந்து தொழிற்பெயராவது முதல்நிலை திரிந்த தொழிற்பெயர் ஆகும்.\n3. 'சுடு' என்னும் முதல்நிலை 'சூடு' எனத் திரிந்து தொழிற்பெயராவது இதற்கு மற்றொரு சான்றாகும்.\n4. 'தமிழ் படிக்கும் பேறு பெற்றேன்' என்பதில் 'பேறு' என்பது முதல்நிலை திரிந்த தொழிற்பெயராகும்.\nஇவற்றுள் சரியானவை எவை?"}], "options": {"A": "1, 2, 3 மட்டுமே சரி", "B": "2, 3, 4 மட்டுமே சரி", "C": "1, 3, 4 மட்டுமே சரி", "D": "1, 2, 3, 4 அனைத்தும் சரி"}, "explanation": "கெடு->கேடு, சுடு->சூடு, பெறு->பேறு ஆகியவை முதல்நிலை குறில் நெடிலாகத் திரிந்து அமைந்த முதல்நிலை திரிந்த தொழிற்பெயர்களாகும். நான்கு கூற்றுகளும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Mutated Primary Verbal Nouns:\n1. Mutation or lengthening of the verbal root constitutes Mudhalnilai Thirintha Thozhirpeyar.\n2. Root 'Kedu' becoming 'Keedu' is an exemplar.\n3. Root 'Sudu' becoming 'Soodu' is another exemplar.\n4. In 'Pearu petrean', 'Pearu' (from Peru) is a mutated primary verbal noun.\nWhich of these are correct?"}], "options": {"A": "1, 2, 3 only correct", "B": "2, 3, 4 only correct", "C": "1, 3, 4 only correct", "D": "1, 2, 3, 4 all are correct"}, "explanation": "Kedu->Kedu, Sudu->Soodu, and Peru->Pearu lengthen the root vowel to form nouns. All four statements are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "முதல்நிலை (பகுதி) திரிந்து தொழிற்பெயராக அமைவது 'முதல்நிலை திரிந்த தொழிற்பெயர்' எனப்படும்.", "content_en": "When the root base lengthens or mutates to form a verbal noun, it is a mutated primary verbal noun."}, {"id": "S2", "content_ta": "'கெடு' என்னும் முதல்நிலை 'கேடு' எனத் திரிந்து தொழிற்பெயராவது முதல்நிலை திரிந்த தொழிற்பெயர் ஆகும்.", "content_en": "Root 'Kedu' mutating into 'Kedu' (damage) is a mutated primary verbal noun."}, {"id": "S3", "content_ta": "'சுடு' என்னும் முதல்நிலை 'சூடு' எனத் திரிந்து தொழிற்பெயராவது இதற்கு மற்றொரு சான்றாகும்.", "content_en": "Root 'Sudu' mutating into 'Soodu' (heat) is another example."}, {"id": "S4", "content_ta": "'தமிழ் படிக்கும் பேறு பெற்றேன்' என்பதில் 'பேறு' (பெறு -> பேறு) என்பது முதல்நிலை திரிந்த தொழிற்பெயராகும்.", "content_en": "In 'Tamizh padikkum pearu petrean', 'Pearu' (Peru -> Pearu) is a mutated primary verbal noun."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["mudhalnilai_thirintha", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q201", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-10-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-u2-thozhirpeyar-vs-vinaiyaalanaiyum", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொழிற்பெயருக்கும் வினையாலணையும் பெயருக்கும் இடையிலான வேறுபாடுகளை ஆராய்க:\n1. தொழிற்பெயர் வினையையே உணர்த்தி நிற்கும்; காலம் காட்டாது; படர்க்கைக்கே உரியது.\n2. வினையாலணையும் பெயர் வினையைச் செய்த கருத்தாவை உணர்த்தும்; காலம் காட்டும்; மூவிடத்திற்கும் உரியது.\n3. 'பாடுதல்', 'படித்தல்' என்பன தொழிற்பெயர்கள் ஆகும்.\n4. 'பாடியவள்', 'படித்தவர்' என்பன வினையாலணையும் பெயர்கள் ஆகும்.\nஇவற்றுள் சரியானவை எவை?"}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 2, 3 மட்டுமே சரி", "C": "2, 3, 4 மட்டுமே சரி", "D": "1, 3, 4 மட்டுமே சரி"}, "explanation": "பாடநூல் பக்கம் 36 அட்டவணையில் தொழிற்பெயருக்கும் வினையாலணையும் பெயருக்கும் உள்ள ஒப்பீடு மிகத் தெளிவாகக் கொடுக்கப்பட்டுள்ளது. நான்கு கூற்றுகளும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the distinctions between Thozhirpeyar and Vinaiyaalanaiyum Peyar:\n1. Thozhirpeyar denotes action, shows no tense, and is 3rd person only.\n2. Vinaiyaalanaiyum Peyar denotes the agent, shows tense, and spans all three persons.\n3. 'Paaduthal' and 'Padithal' are verbal nouns.\n4. 'Paadiyaval' and 'Padithavar' are participial nouns.\nWhich of these are correct?"}], "options": {"A": "1, 2, 3, 4 all are correct", "B": "1, 2, 3 only correct", "C": "2, 3, 4 only correct", "D": "1, 3, 4 only correct"}, "explanation": "All four statements perfectly present the comparative table from page 36 differentiating verbal nouns from participial nouns."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "தொழிற்பெயர் வினையையே உணர்த்தி நிற்கும்; காலம் காட்டாது; படர்க்கைக்கே உரியது.", "content_en": "Thozhirpeyar denotes the action itself, does not mark tense, and is restricted to third person."}, {"id": "S2", "content_ta": "வினையாலணையும் பெயர் வினையைச் செய்த கருத்தாவை உணர்த்தும்; காலம் காட்டும்; தன்மை, முன்னிலை, படர்க்கை ஆகிய மூவிடத்திற்கும் உரியது.", "content_en": "Vinaiyaalanaiyum Peyar denotes the agent doing the action, marks tense, and applies to all three persons."}, {"id": "S3", "content_ta": "'பாடுதல்', 'படித்தல்' என்பன தொழிற்பெயர்கள் ஆகும்.", "content_en": "'Paaduthal' and 'Padithal' are verbal nouns."}, {"id": "S4", "content_ta": "'பாடியவள்', 'படித்தவர்' என்பன வினையாலணையும் பெயர்கள் ஆகும்.", "content_en": "'Paadiyaval' and 'Padithavar' are participial nouns."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["comparison", "grammar", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q202", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-10-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-u2-ethirmarai-thozhirpeyar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எதிர்மறைத் தொழிற்பெயர் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. எதிர்மறைப் பொருளில் வரும் தொழிற்பெயர் 'எதிர்மறைத் தொழிற்பெயர்' எனப்படும்.\n2. 'நடவாமை', 'கொல்லாமை' என்பன எதிர்மறைத் தொழிற்பெயர்களுக்குச் சான்றுகளாகும்.\n3. எதிர்மறைத் தொழிற்பெயர் எதிர்காலத்தை மட்டுமே தெளிவாகக் காட்டும்.\n4. எதிர்மறைத் தொழிற்பெயரில் 'மை' அல்லது எதிர்மறை இடைநிலை இணைந்து பொருள் தரும்.\nஇவற்றுள் தவறான கூற்று எது?"}], "options": {"A": "கூற்று 1", "B": "கூற்று 3", "C": "கூற்று 2", "D": "கூற்று 4"}, "explanation": "எதிர்மறைத் தொழிற்பெயரும் தொழிற்பெயரின் ஒரு வகையே ஆதலால் அது எக்காலத்தையும் காட்டாது. எதிர்காலம் காட்டும் எனக் கூறும் கூற்று 3 தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Examine statements on Negative Verbal Nouns:\n1. A verbal noun in the negative sense is Ethirmarai Thozhirpeyar.\n2. 'Nadavaamai' and 'Kollaamai' are classic examples.\n3. A negative verbal noun explicitly marks future tense.\n4. It carries suffix 'mai' or negative markers.\nWhich statement is incorrect?"}], "options": {"A": "Statement 1", "B": "Statement 3", "C": "Statement 2", "D": "Statement 4"}, "explanation": "Being a verbal noun, negative verbal nouns never mark tense. Statement 3 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "எதிர்மறைப் பொருளில் வரும் தொழிற்பெயர் 'எதிர்மறைத் தொழிற்பெயர்' எனப்படும்.", "content_en": "A verbal noun expressing negative sense is a negative verbal noun."}, {"id": "S2", "content_ta": "'நடவாமை', 'கொல்லாமை' என்பன எதிர்மறைத் தொழிற்பெயர்களுக்குச் சான்றுகளாகும்.", "content_en": "'Nadavaamai' and 'Kollaamai' are examples of negative verbal nouns."}, {"id": "S3", "content_ta": "எதிர்மறைத் தொழிற்பெயர் எதிர்காலத்தை மட்டுமே தெளிவாகக் காட்டும்.", "content_en": "A negative verbal noun explicitly marks future tense."}, {"id": "S4", "content_ta": "எதிர்மறைத் தொழிற்பெயரில் 'மை' அல்லது எதிர்மறை இடைநிலை இணைந்து பொருள் தரும்.", "content_en": "Negative verbal nouns incorporate 'mai' or negative infixes to express meaning."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["ethirmarai_thozhirpeyar", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q203", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-10-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-u2-peechu-pugazh-analysis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூல் எடுத்துக்காட்டுத் தொடர் குறித்த கூற்றுகளை ஆராய்க:\n'அறிஞர் அண்ணா தம் பேச்சால் புகழ் பெற்றார்'\n1. இதில் 'பேச்சு', 'புகழ்' என்பன தொழிற்பெயர்கள் ஆகும்.\n2. 'புகழ்' என்பது விகுதி பெறாமல் தன் பொருளை உணர்த்தும் முதனிலைத் தொழிற்பெயர் ஆகும்.\n3. 'பேச்சு' என்பது காலங்காட்டும் பெயரெச்சச் சொல்லாகும்.\nஇவற்றுள் சரியானவை எவை?"}], "options": {"A": "1, 2, 3 அனைத்தும் சரி", "B": "2 மற்றும் 3 மட்டுமே சரி", "C": "1 மற்றும் 2 மட்டுமே சரி", "D": "1 மற்றும் 3 மட்டுமே சரி"}, "explanation": "'பேச்சு' என்பது பேசுதல் என்னும் வினையின் தொழிற்பெயர் ஆகும் (விகுதி பெற்றது). அது பெயரெச்சம் அன்று. எனவே கூற்று 3 தவறு; 1 மற்றும் 2 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the textbook example sentence:\n'Arignar Anna tham pechaal pugazh petraar'\n1. 'Peechu' and 'Pugazh' are verbal nouns.\n2. 'Pugazh' is a primary verbal noun functioning without suffixation.\n3. 'Peechu' is a tense-marking relative participle.\nWhich of these are correct?"}], "options": {"A": "1, 2, 3 all are correct", "B": "2 and 3 only correct", "C": "1 and 2 only correct", "D": "1 and 3 only correct"}, "explanation": "'Peechu' is a verbal noun, not a relative participle. Statement 3 is false; 1 and 2 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'அறிஞர் அண்ணா தம் பேச்சால் புகழ் பெற்றார்' - இதில் 'பேச்சு', 'புகழ்' என்பன தொழிற்பெயர்கள் ஆகும்.", "content_en": "In 'Anna won fame by his speech', 'Peechu' and 'Pugazh' are verbal nouns."}, {"id": "S2", "content_ta": "'புகழ்' என்பது விகுதி பெறாமல் தன் பொருளை உணர்த்தும் முதனிலைத் தொழிற்பெயர் ஆகும்.", "content_en": "'Pugazh' is an unsuffixed primary verbal noun."}, {"id": "S3", "content_ta": "'பேச்சு' என்பது காலங்காட்டும் பெயரெச்சச் சொல்லாகும்.", "content_en": "'Peechu' is a tense-marking relative participle."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["thozhirpeyar", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q204", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-10-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-u2-ar-thozhirpeyar-tense", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தொழிற்பெயர் காலம் காட்டாது.\nகாரணம் (R): ஒரு செயலின் பொதுவான பெயராக மட்டுமே நின்று உணர்த்துவதால் அதற்கு இறந்த, நிகழ், எதிர்கால வேறுபாடுகள் அமைவதில்லை.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "B": "கூற்று (A) தவறு, காரணம் (R) சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; மேலும் காரணம் கூற்றிற்குச் சரியான விளக்கமாகும்."}, "explanation": "தொழிற்பெயர் வினையின் பெயராக மட்டுமே அமைவதால் காலம் காட்டாது. கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): A verbal noun (Thozhirpeyar) never expresses tense.\nReason (R): Because it designates the generalized abstract concept of the action itself, temporal distinctions do not apply to it.\nSelect the correct option:"}], "options": {"A": "Assertion (A) is correct, Reason (R) is false.", "B": "Assertion (A) is false, Reason (R) is correct.", "C": "Both (A) and (R) are false.", "D": "Both (A) and (R) are correct, and (R) is the proper explanation of (A)."}, "explanation": "Verbal nouns denote the nominal state of an action without tense markers. Both assertion and reason are true and coherent."}}, "question_data": {"assertion": "தொழிற்பெயர் காலம் காட்டாது.", "reason": "ஒரு செயலின் பொதுவான பெயராக மட்டுமே நின்று உணர்த்துவதால் அதற்கு இறந்த, நிகழ், எதிர்கால வேறுபாடுகள் அமைவதில்லை.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["thozhirpeyar", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q205", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-10-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-u2-ar-mudhalnilai-triputhal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'கேடு', 'சூடு' என்பன முதல்நிலை திரிந்த தொழிற்பெயர்கள் ஆகும்.\nகாரணம் (R): 'கெடு', 'சுடு' என்னும் ஏவல் வினைப்பகுதிகள் தமக்குரிய முதலெழுத்துக் குறில் நெடிலாகத் திரிந்து தொழிற்பெயர்களாக மாறியுள்ளன.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது.", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "C": "கூற்று (A) தவறு, காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "பகுதியின் முதலெழுத்து நீண்டு தொழிற்பெயராவது முதல்நிலை திரிந்த தொழிற்பெயராகும் (கெடு->கேடு, சுடு->சூடு). கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'Keedu' and 'Soodu' are categorized as Mutated Primary Verbal Nouns (Mudhalnilai Thirintha Thozhirpeyar).\nReason (R): The short initial vowel in the imperative verbal roots 'Kedu' and 'Sudu' lengthened into long vowels, mutating into verbal nouns.\nSelect the correct option:"}], "options": {"A": "Both (A) and (R) are true; Reason correctly explains Assertion.", "B": "(A) is true, Reason is false.", "C": "(A) is false, Reason is true.", "D": "Both (A) and (R) are false."}, "explanation": "The initial root vowel lengthens (Kedu->Kedu; Sudu->Soodu), exemplifying Mudhalnilai Thirintha Thozhirpeyar. Both (A) and (R) are correct."}}, "question_data": {"assertion": "'கேடு', 'சூடு' என்பன முதல்நிலை திரிந்த தொழிற்பெயர்கள் ஆகும்.", "reason": "'கெடு', 'சுடு' என்னும் ஏவல் வினைப்பகுதிகள் தமக்குரிய முதலெழுத்துக் குறில் நெடிலாகத் திரிந்து தொழிற்பெயர்களாக மாறியுள்ளன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["mudhalnilai_thirintha", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q206", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-10-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-u2-ar-vinaiyaalanaiyum-person", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): வினையாலணையும் பெயர் தன்மை, முன்னிலை, படர்க்கை ஆகிய மூவிடங்களிலும் வரும்.\nகாரணம் (R): வினையைச் செய்த கருத்தாவையே சுட்டி நிற்பதால் கருத்தாவுக்குரிய இட வேறுபாடுகளை அது ஏற்கிறது.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "B": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது.", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "வினையாலணையும் பெயர் கருத்தாவை உணர்த்துவதால் மூவிடத்திற்கும் உரியதாக அமைகிறது (எ.கா. வந்தேன், வந்தாய், வந்தார்). கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Participial nouns (Vinaiyaalanaiyum Peyar) occur across all three grammatical persons (1st, 2nd, and 3rd).\nReason (R): Because they directly denote the agent performer of the action, they assimilate the personal pronominal distinctions of the agent.\nSelect the correct option:"}], "options": {"A": "Assertion (A) is correct, Reason (R) is false.", "B": "Both (A) and (R) are correct; Reason explains Assertion.", "C": "Assertion (A) is false, Reason (R) is correct.", "D": "Both (A) and (R) are false."}, "explanation": "Because participial nouns represent the performing agent, they inflect across first, second, and third persons. Both statement and reason are sound."}}, "question_data": {"assertion": "வினையாலணையும் பெயர் தன்மை, முன்னிலை, படர்க்கை ஆகிய மூவிடங்களிலும் வரும்.", "reason": "வினையைச் செய்த கருத்தாவையே சுட்டி நிற்பதால் கருத்தாவுக்குரிய இட வேறுபாடுகளை அது ஏற்கிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vinaiyaalanaiyum_peyar", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q207", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-10-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-u2-ar-thozhirpeyar-contrast", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'பாடியவள்' என்பது படர்க்கை இடத்தில் மட்டுமே வரக்கூடிய தொழிற்பெயர் ஆகும்.\nகாரணம் (R): தொழிற்பெயர் வினையைச் செய்த கருத்தாவை மட்டுமே முதன்மையாக உணர்த்தி நிற்கும்.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி.", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு.", "D": "கூற்று (A) தவறு, காரணம் (R) சரி."}, "explanation": "'பாடியவள்' என்பது இறந்தகாலம் காட்டும் 'வினையாலணையும் பெயர்' ஆகும்; தொழிற்பெயர் அல்ல. மேலும் கருத்தாவை உணர்த்துவது வினையாலணையும் பெயரே தவிர தொழிற்பெயர் அன்று. எனவே கூற்றும் தவறு, காரணமும் தவறு."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'Paadiyaval' is a verbal noun restricted solely to the third person.\nReason (R): A verbal noun primarily indicates the performing agent of an action.\nSelect the correct option:"}], "options": {"A": "Both (A) and (R) are true.", "B": "(A) is true, but (R) is false.", "C": "Both (A) and (R) are false.", "D": "(A) is false, but (R) is true."}, "explanation": "'Paadiyaval' is a participial noun, not a verbal noun. A verbal noun denotes the action, not the agent. Both assertion and reason are completely false."}}, "question_data": {"assertion": "'பாடியவள்' என்பது படர்க்கை இடத்தில் மட்டுமே வரக்கூடிய தொழிற்பெயர் ஆகும்.", "reason": "தொழிற்பெயர் வினையைச் செய்த கருத்தாவை மட்டுமே முதன்மையாக உணர்த்தி நிற்கும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["thozhirpeyar", "vinaiyaalanaiyum_peyar", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q208", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-10-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-u2-ar-pidi-mudhalnilai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'உணவை ஒரு பிடி பிடித்தான்' என்னும் தொடரில் 'பிடி' என்பது முதனிலைத் தொழிற்பெயர் ஆகும்.\nகாரணம் (R): பிடித்தல் என்னும் வினையின் பகுதியான 'பிடி' என்னும் ஏவல் ஒருமை வடிவம் எவ்வித விகுதியும் ஏற்காமல் தன் பொருளை உணர்த்தி நிற்கிறது.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "B": "கூற்று (A) தவறு, காரணம் (R) சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; மேலும் காரணம் கூற்றிற்குச் சரியான விளக்கமாகும்."}, "explanation": "பாடநூல் பக்கம் 36 எடுத்துக்காட்டு: 'உணவை ஒரு பிடி பிடித்தான்' என்பதில் 'பிடி' விகுதி பெறாத முதனிலைத் தொழிற்பெயராகும். கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): In 'Unavai oru pidi pidithaan', the word 'Pidi' is a Primary Verbal Noun (Mudhalnilai Thozhirpeyar).\nReason (R): The imperative root 'Pidi' of the verb 'pidithal' expresses nominal meaning without taking any explicit suffix.\nSelect the correct option:"}], "options": {"A": "Assertion (A) is true, Reason (R) is false.", "B": "Assertion (A) is false, Reason (R) is true.", "C": "Both (A) and (R) are false.", "D": "Both (A) and (R) are true, and Reason properly explains Assertion."}, "explanation": "'Pidi' functions directly as an unsuffixed primary verbal noun. Both assertion and reason are valid."}}, "question_data": {"assertion": "'உணவை ஒரு பிடி பிடித்தான்' என்னும் தொடரில் 'பிடி' என்பது முதனிலைத் தொழிற்பெயர் ஆகும்.", "reason": "பிடித்தல் என்னும் வினையின் பகுதியான 'பிடி' என்னும் ஏவல் ஒருமை வடிவம் எவ்வித விகுதியும் ஏற்காமல் தன் பொருளை உணர்த்தி நிற்கிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["mudhalnilai_thozhirpeyar", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q209", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-10-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-u2-ar-vikuthi-diversity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தமிழ் மொழியில் தொழிற்பெயர்கள் பல வகையான விகுதிகளை ஏற்று அமையும் நெகிழ்வுத்தன்மை கொண்டவை.\nகாரணம் (R): தல், அல் மட்டுமல்லாமல் அம், ஐ, கை, வை, கு, பு, வு, தி, சி, வி, மை போன்ற எண்ணற்ற விகுதிகள் வினைப்பகுதியுடன் இணைந்து தொழிற்பெயர்களை உருவாக்குகின்றன.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது.", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "C": "கூற்று (A) தவறு, காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "பாடநூல் பக்கம் 35-ல் தொழிற்பெயர் விகுதிகளாக 13 விகுதிகள் பட்டியலிடப்பட்டுள்ளன. கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Verbal nouns in Tamil possess rich morphological flexibility, utilizing diverse suffixes.\nReason (R): Beyond 'thal' and 'al', numerous suffixes like am, ai, kai, vai, ku, pu, vu, thi, si, vi, and mai derive verbal nouns from roots.\nSelect the correct option:"}], "options": {"A": "Both (A) and (R) are true; (R) is the correct explanation of (A).", "B": "(A) is true, but (R) is false.", "C": "(A) is false, but (R) is true.", "D": "Both (A) and (R) are false."}, "explanation": "The textbook details 13 productive suffixes generating verbal nouns from verbal roots. Both (A) and (R) are true."}}, "question_data": {"assertion": "தமிழ் மொழியில் தொழிற்பெயர்கள் பல வகையான விகுதிகளை ஏற்று அமையும் நெகிழ்வுத்தன்மை கொண்டவை.", "reason": "தல், அல் மட்டுமல்லாமல் அம், ஐ, கை, வை, கு, பு, வு, தி, சி, வி, மை போன்ற எண்ணற்ற விகுதிகள் வினைப்பகுதியுடன் இணைந்து தொழிற்பெயர்களை உருவாக்குகின்றன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["thozhirpeyar_vikuthi", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q210", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-10-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-u2-match-vikuthi-set1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொழிற்பெயர்களையும் அவற்றின் விகுதிகளையும் பொருத்துக:\n(a) தருதல் - 1. அல் விகுதி\n(b) கூறல் - 2. தல் விகுதி\n(c) ஆட்டம் - 3. ஐ விகுதி\n(d) விலை - 4. அம் விகுதி"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-2, b-4, c-1, d-3", "D": "a-3, b-1, c-4, d-2"}, "explanation": "தருதல் = தல் (2); கூறல் = அல் (1); ஆட்டம் = அம் (4); விலை = ஐ (3). வரிசை: 2, 1, 4, 3."}, "en": {"blocks": [{"type": "text", "content": "Match the verbal nouns with their constituent nominal suffixes:\n(a) Tharuthal - 1. Al suffix\n(b) Kooral - 2. Thal suffix\n(c) Aattam - 3. Ai suffix\n(d) Vilai - 4. Am suffix"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-2, b-4, c-1, d-3", "D": "a-3, b-1, c-4, d-2"}, "explanation": "Tharuthal = thal (2); Kooral = al (1); Aattam = am (4); Vilai = ai (3). Match: 2, 1, 4, 3 (B)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "தருதல்", "content_en": "Tharuthal"}, {"id": "L2", "content_ta": "கூறல்", "content_en": "Kooral"}, {"id": "L3", "content_ta": "ஆட்டம்", "content_en": "Aattam"}, {"id": "L4", "content_ta": "விலை", "content_en": "Vilai"}], "right": [{"id": "R1", "content_ta": "அல் விகுதி", "content_en": "Al suffix"}, {"id": "R2", "content_ta": "தல் விகுதி", "content_en": "Thal suffix"}, {"id": "R3", "content_ta": "ஐ விகுதி", "content_en": "Ai suffix"}, {"id": "R4", "content_ta": "அம் விகுதி", "content_en": "Am suffix"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["thozhirpeyar", "vikuthi", "matching"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
