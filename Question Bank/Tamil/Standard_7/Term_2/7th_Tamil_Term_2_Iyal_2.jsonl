{"id": "7th-t2-u2-q165", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-odd-painter-epithets", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைத் தமிழ் இலக்கியங்களில் ஓவியர்களைக் குறிக்கும் சிறப்புப் பெயர்களில் பொருந்தாத ஒன்றைக் கண்டறிக:"}], "options": {"A": "கற்கண்டு ஆசிரியர்", "B": "கண்ணுள் வினைஞன்", "C": "சித்திரக்காரர்", "D": "வித்தகக் கலைஞர்"}, "explanation": "பாடநூல் பக்கம் 26-ன் படி, ஓவியரை அழைக்கும் பெயர்கள்: கண்ணுள் வினைஞன், சித்திரக்காரர், வித்தகக் கலைஞர், கிளவிக் கோவலன். 'கற்கண்டு ஆசிரியர்' என்பது ஓவியரைக் குறிக்கும் சொல் அன்று."}, "en": {"blocks": [{"type": "text", "content": "Identify the title that was NOT an ancient Tamil synonym for a painter:"}], "options": {"A": "Karkandu Aasiriyar", "B": "Kannul Vinaijnan", "C": "Chithirakkaarar", "D": "Vithakak Kalaignar"}, "explanation": "Painters were termed Kannul Vinaijnan, Chithirakkaarar, and Vithakak Kalaignar. 'Karkandu Aasiriyar' is not an artistic synonym."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-20