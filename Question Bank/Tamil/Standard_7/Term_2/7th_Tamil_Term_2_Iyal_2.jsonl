{"id": "7th-t2-u2-q217", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-10-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-u2-grammar-pearu-ilakkana-kurippu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தமிழ் படிக்கும் பேறு பெற்றேன்' - இத்தொடரில் 'பேறு' என்னும் சொல்லின் இலக்கணக் குறிப்பு யாது?"}], "options": {"A": "முதல்நிலை திரிந்த தொழிற்பெயர்", "B": "விகுதி பெற்ற தொழிற்பெயர்", "C": "முதனிலைத் தொழிற்பெயர்", "D": "வினையாலணையும் பெயர்"}, "explanation": "'பெறு' என்னும் முதனிலை குறில் 'பேறு' என நீண்டு தொழிற்பெயராக அமைந்தமையால் இது 'முதல்நிலை திரிந்த தொழிற்பெயர்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the grammatical categorization (Ilakkana Kurippu) of 'Pearu' in 'Tamizh padikkum pearu petrean':"}], "options": {"A": "Mutated Primary Verbal Noun (Mudhalnilai Thirintha Thozhirpeyar)", "B": "Suffixed Verbal Noun", "C": "Primary Verbal Noun", "D": "Participial Noun"}, "explanation": "'Pearu' is formed by the lengthening of the root 'peru', making it a Mudhalnilai Thirintha Thozhirpeyar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "t