{"id": "7th-t2-u2-q188", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-09-tamil-olir-idangal", "chapter_id": null, "topic_id": "ta-t2-u2-grammar-kalladukku-mathirai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கன்னியாகுமரி' என்னும் சொல்லின் மொத்த மாத்திரை அளவைக் கணக்கிடுக:"}], "options": {"A": "6 மாத்திரை", "B": "6.5 மாத்திரை", "C": "7 மாத்திரை", "D": "7.5 மாத்திரை"}, "explanation": "'கன்னியாகுமரி' மாத்திரை பகுப்பாய்வு:\nக (குறில்) = 1 மாத்திரை\nன் (மெய்) = 0.5 மாத்திரை\nனி (குறில்) = 1 மாத்திரை\nயா (நெடில்) = 2 மாத்திரை\nகு (குறில்) = 1 மாத்திரை\nம (குறில்) = 1 மாத்திரை\nரி (குறில்) = 1 மாத்திரை\nகூட்டுத்தொகை = 1 + 0.5 + 1 + 2 + 1 + 1 + 1 = 7.5 மாத்திரை."}, "en": {"blocks": [{"type": "text", "content": "Calculate the total prosodic metric count (Maathirai) for the word 'Kanniyakumari':"}], "options": {"A": "6 Maathirai", "B": "6.5 Maathirai", "C": "7 Maathirai", "D": "7.5 Maathirai"}, "explanation": "Metrics for 'Kanniyakumari': Ka (1) + n (0.5) + ni (1) + yaa (2) + ku (1) + ma (1) + ri (1) = 7.5 Maathirai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term"