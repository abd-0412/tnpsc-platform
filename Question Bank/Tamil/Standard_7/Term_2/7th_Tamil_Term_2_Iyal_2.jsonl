// பாடம் 2: பேசும் ஓவியங்கள் (உரைநடை உலகம் - வரலாற்று ஓவிய வகைகள்) & தற்கால ஓவியக் கலை [Q141 - Q168]
// சுவர் ஓவியங்கள் (சித்தன்னவாசல், தஞ்சைப் பெரிய கோவில் சேரமான் நாயனார் ஓவியம்), துணி ஓவியங்கள் (ஓவிய விதானம், சித்திரப் படம், சித்திரத்திரை, களம்காரி / கலம்காரி ஓவியங்கள்), ஓலைச்சுவடி ஓவியங்கள் (தஞ்சை சரசுவதி மகால் நூலகம்), தந்த ஓவியங்கள் (கேரளா), கண்ணாடி ஓவியங்கள் (தஞ்சாவூர்), தாள் ஓவியங்கள் (கோட்டோவியம், வண்ண ஓவியம், நவீன ஓவியம்), கருத்துப்பட ஓவியங்கள் (பாரதியார், 'இந்தியா' இதழ், கேலிச்சித்திரம்/கார்ட்டூன்), நாட்காட்டி ஓவியங்கள் (பஜார் பெயிண்டிங், முன்னோடி சி. கொண்டையராஜு, மாணாக்கர்), கலைச்சொற்கள் (Modern Art, Visual Art, Folk Art, Periodical, Caricature, Crafts, Puppet Show)
// ==============================================================================
{"id": "7th-t2-u2-q141", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-bharathiyar-cartoon", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியாரின் கருத்துப்படங்கள் மற்றும் கேலிச்சித்திரம் குறித்த கூற்றுகளை ஆராய்க:\n1. அரசியல் மற்றும் சமூகக் கருத்துகளை எளிதில் புரிய வைக்கும் வகையில் நகைச்சுவையோடு வரைவதே 'கருத்துப்படம்' (Cartoon) ஆகும்.\n2. தமிழ் இதழ்களில் முதன்முதலில் கருத்துப் படங்களை அறிமுகப்படுத்தியவர் மகாகவி பாரதியார் ஆவார்.\n3. பாரதியார் 'இந்தியா' என்னும் இதழில் முதன்முதலாகக் கருத்துப் படங்களை வெளியிட்டு மக்களிடையே விடுதலை உணர்வைத் தூண்டினார்.\n4. உருவங்களை விந்தையான தோற்றங்களில் நகைச்சுவை தோன்றும்படி வரைவதைக் 'கேலிச்சித்திரம்' (Caricature) என்பர்.\nஇவற்றுள் சரியானவை எவை?"}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 2, 3 மட்டுமே சரி", "C": "2, 3, 4 மட்டுமே சரி", "D": "1, 3, 4 மட்டுமே சரி"}, "explanation": "பாடநூல் பக்கங்கள் 26-27 இன் படி, பாரதியார் 'இந்தியா' இதழில் முதன்முதலில் கருத்துப்படங்களை அறிமுகப்படுத்தினார்; கேலிச்சித்திரம் என்பது இதன் மற்றொரு வடிவமாகும். நான்கு கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine statements regarding Bharathiyar's cartoons and caricature:\n1. Communicating political and socio-economic critique through humor is a Cartoon.\n2. Mahakavi Bharathiyar was the first to introduce cartoons in Tamil periodicals.\n3. Bharathiyar published cartoons in his magazine 'India' to inspire the independence movement.\n4. Drawing exaggerated, witty distortions of figures is called Caricature.\nWhich of these are correct?"}], "options": {"A": "1, 2, 3, 4 all are correct", "B": "1, 2, 3 only correct", "C": "2, 3, 4 only correct", "D": "1, 3, 4 only correct"}, "explanation": "All four statements precisely reflect the textbook facts concerning Bharathiyar introducing political cartoons in 'India' and the definition of caricature."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "அரசியல் மற்றும் சமூகக் கருத்துகளை எளிதில் புரிய வைக்கும் வகையில் நகைச்சுவையோடு வரைவதே 'கருத்துப்படம்' (Cartoon) ஆகும்.", "content_en": "Rendering political and social concepts with humor and satire is known as a Cartoon."}, {"id": "S2", "content_ta": "தமிழ் இதழ்களில் முதன்முதலில் கருத்துப் படங்களை அறிமுகப்படுத்தியவர் மகாகவி பாரதியார் ஆவார்.", "content_en": "Mahakavi Bharathiyar was the pioneer who first introduced cartoons into Tamil journalism."}, {"id": "S3", "content_ta": "பாரதியார் 'இந்தியா' என்னும் இதழில் முதன்முதலாகக் கருத்துப் படங்களை வெளியிட்டு மக்களிடையே விடுதலை உணர்வைத் தூண்டினார்.", "content_en": "Bharathiyar published cartoons in his weekly journal 'India' to ignite patriotic freedom fervor."}, {"id": "S4", "content_ta": "உருவங்களை விந்தையான தோற்றங்களில் நகைச்சுவை தோன்றும்படி வரைவதைக் 'கேலிச்சித்திரம்' (Caricature) என்பர்.", "content_en": "Drawing grotesque, humorous character distortions is termed Caricature (Kaelichithiram)."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pesum_oviyangal", "bharathiyar", "cartoons", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q142", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-kondaiyaraju-calendar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாட்காட்டி ஓவியங்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. நாட்காட்டி ஓவியம் வரையும் முறையின் முன்னோடிகளுள் ஒருவராகக் கருதப்படுபவர் கொண்டையராஜு ஆவார்.\n2. நாட்காட்டி ஓவியங்களைப் 'பஜார் பெயிண்டிங்' (Bazaar painting) என்றும் அழைப்பர்.\n3. நாட்காட்டி ஓவியங்கள் அரச குடும்பத்தினர் மட்டுமே தனிப்பட்ட முறையில் வாங்கிப் பாதுகாக்கும் அரிய கலைப்பொருட்கள் ஆகும்.\n4. பல வீடுகளிலும் வழிபாட்டு அறைகளிலும் தெய்வ உருவங்கள் நாட்காட்டி ஓவியங்கள் மூலமாகவே பொதுமக்களிடம் பரவின.\nஇவற்றுள் தவறான கூற்று எது?"}], "options": {"A": "கூற்று 1", "B": "கூற்று 3", "C": "கூற்று 2", "D": "கூற்று 4"}, "explanation": "நாட்காட்டி ஓவியங்கள் பொதுமக்களிடையே மிக மலிவாகவும் எளிதாகவும் பரவிய வெகுசனக் கலையாகும்; அரசர்கள் மட்டுமே வாங்கும் ஆடம்பரப் பொருள் அன்று. எனவே கூற்று 3 தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Calendar Paintings:\n1. Kondaiyaraju is revered as a key pioneer of calendar painting.\n2. Calendar paintings are also termed 'Bazaar Paintings'.\n3. Calendar paintings are exclusive aristocratic possessions reserved only for royalty.\n4. Deity pictures reached domestic shrines broadly through calendar prints.\nWhich statement is incorrect?"}], "options": {"A": "Statement 1", "B": "Statement 3", "C": "Statement 2", "D": "Statement 4"}, "explanation": "Calendar painting is a mass popular art form (Bazaar painting) accessible to ordinary households, not exclusive to royalty. Statement 3 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "நாட்காட்டி ஓவியம் வரையும் முறையின் முன்னோடிகளுள் ஒருவராகக் கருதப்படுபவர் கொண்டையராஜு ஆவார்.", "content_en": "Kondaiyaraju is regarded as one of the chief pioneers of calendar painting."}, {"id": "S2", "content_ta": "நாட்காட்டி ஓவியங்களைப் 'பஜார் பெயிண்டிங்' (Bazaar painting) என்றும் அழைப்பர்.", "content_en": "Calendar paintings are also popularly called 'Bazaar Paintings'."}, {"id": "S3", "content_ta": "நாட்காட்டி ஓவியங்கள் அரச குடும்பத்தினர் மட்டுமே தனிப்பட்ட முறையில் வாங்கிப் பாதுகாக்கும் அரிய கலைப்பொருட்கள் ஆகும்.", "content_en": "Calendar paintings are rare luxury items acquired solely for private royal collections."}, {"id": "S4", "content_ta": "பல வீடுகளிலும் வழிபாட்டு அறைகளிலும் தெய்வ உருவங்கள் நாட்காட்டி ஓவியங்கள் மூலமாகவே பொதுமக்களிடம் பரவின.", "content_en": "Deity portraits widely proliferated into ordinary household prayer rooms via calendar art."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["kondaiyaraju", "calendar_art", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q143", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-modern-art-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நவீன ஓவியங்கள் (Modern Art) குறித்த கூற்றுகளை ஆராய்க:\n1. நவீன ஓவியம் என்பது ஓவியக்கலையின் மிகப்புதுமையான வடிவமாகும்.\n2. பார்வையாளரின் சொந்தக் கற்பனைக்கும் சிந்தனைக்கும் ஏற்பப் பலவிதமான அர்த்தங்களை விரிக்கும் வகையில் நவீன ஓவியங்கள் வரையப்படுகின்றன.\n3. நவீன ஓவியங்களில் முன்கூட்டியே வரையறுக்கப்பட்ட ஒற்றைப் பொருள் மட்டுமே எந்நாளும் வெளிப்பட வேண்டும் என்பது கட்டாய விதியாகும்.\nஇவற்றுள் சரியானவை எவை?"}], "options": {"A": "1, 2, 3 அனைத்தும் சரி", "B": "2 மற்றும் 3 மட்டுமே சரி", "C": "1 மற்றும் 2 மட்டுமே சரி", "D": "1 மற்றும் 3 மட்டுமே சரி"}, "explanation": "நவீன ஓவியங்கள் பார்வையாளரின் சிந்தனைக்கேற்ப மாறுபட்ட கருத்துகளை உணர்த்தும் பன்முகத் தன்மை கொண்டவை. ஒற்றைப் பொருள் மட்டுமே வர வேண்டும் என்பது தவறு. எனவே 1 மற்றும் 2 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements regarding Modern Art:\n1. Modern art is the newest innovative form of painting.\n2. Modern paintings are created to evoke open-ended subjective interpretations based on the viewer's intellect.\n3. Modern art strictly mandates that only a single, rigidly predetermined message must emerge.\nWhich of these are correct?"}], "options": {"A": "1, 2, 3 all are correct", "B": "2 and 3 only correct", "C": "1 and 2 only correct", "D": "1 and 3 only correct"}, "explanation": "Modern Art is intentionally abstract and polysemic, not bound to a single rigid interpretation. Statement 3 is false; 1 and 2 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "நவீன ஓவியம் என்பது ஓவியக்கலையின் மிகப்புதுமையான வடிவமாகும்.", "content_en": "Modern Art represents the most contemporary manifestation of painting."}, {"id": "S2", "content_ta": "பார்வையாளரின் சொந்தக் கற்பனைக்கும் சிந்தனைக்கும் ஏற்பப் பலவிதமான அர்த்தங்களை விரிக்கும் வகையில் நவீன ஓவியங்கள் வரையப்படுகின்றன.", "content_en": "Modern artworks are executed to evoke pluralistic interpretations based on the viewer's imagination."}, {"id": "S3", "content_ta": "நவீன ஓவியங்களில் முன்கூட்டியே வரையறுக்கப்பட்ட ஒற்றைப் பொருள் மட்டுமே எந்நாளும் வெளிப்பட வேண்டும் என்பது கட்டாய விதியாகும்.", "content_en": "In Modern Art, it is mandatory that only a single, rigidly predefined meaning must be conveyed."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["modern_art", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q144", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-ancient-art-terminology", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் இலக்கியங்களில் ஓவியக்கலைச் சொற்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. பழந்தமிழகத்தில் ஓவியத்திற்குப் படம், பவை, துகிலிகை, வட்டிகைச் செய்தி, சித்திரம் எனப் பல பெயர்கள் வழங்கின.\n2. ஓவியம் வரைபவரை 'கண்ணுள் வினைஞன்', 'சித்திரக்காரர்', 'வித்தகக் கலைஞர்' எனப் போற்றினர்.\n3. ஓவியம் வரையப்பட்ட இடம் 'சித்திரக்கூடம்', 'எழுதுநிலை மண்டபம்', 'சித்திர மாடம்' என அழைக்கப்பட்டது.\n4. ஓவியக் கலை பற்றிய எவ்விதக் குறிப்பும் சிலப்பதிகாரம், மணிமேகலை போன்ற சங்க கால இலக்கியங்களில் காணப்படவில்லை.\nஇவற்றுள் தவறான கூற்று எது?"}], "options": {"A": "கூற்று 1", "B": "கூற்று 2", "C": "கூற்று 3", "D": "கூற்று 4"}, "explanation": "சிலப்பதிகாரம் மற்றும் மணிமேகலையில் ஓவியக் கலை, ஓவிய மாடங்கள், கண்ணுள் வினைஞர் பற்றிய எண்ணற்ற குறிப்புகள் நிறைந்துள்ளன. இல்லை என்று கூறும் கூற்று 4 முற்றிலும் தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Examine ancient Tamil artistic nomenclature:\n1. Painting was called Padam, Pavai, Thugiligai, Vattigaich-cheithi, and Chithiram.\n2. A painter was titled Kannul Vinaijnan, Chithirakkaarar, and Vithakak Kalaignar.\n3. Art galleries were named Chithirakkoodam, Ezhuthunilai Mandapam, and Chithira Maadam.\n4. Classical epics like Silappathikaram and Manimekalai contain no mention of painting traditions.\nWhich statement is incorrect?"}], "options": {"A": "Statement 1", "B": "Statement 2", "C": "Statement 3", "D": "Statement 4"}, "explanation": "Classical Tamil epics Silappathikaram and Manimekalai frequently celebrate painters ('Kannul Vinaijnan') and galleries. Statement 4 is completely false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பழந்தமிழகத்தில் ஓவியத்திற்குப் படம், பவை, துகிலிகை, வட்டிகைச் செய்தி, சித்திரம் எனப் பல பெயர்கள் வழங்கின.", "content_en": "In ancient Tamil Nadu, painting was termed Padam, Pavai, Thugiligai, Vattigaich-cheithi, and Chithiram."}, {"id": "S2", "content_ta": "ஓவியம் வரைபவரை 'கண்ணுள் வினைஞன்', 'சித்திரக்காரர்', 'வித்தகக் கலைஞர்' எனப் போற்றினர்.", "content_en": "Painters were honored as Kannul Vinaijnan, Chithirakkaarar, and Vithakak Kalaignar."}, {"id": "S3", "content_ta": "ஓவியம் வரையப்பட்ட இடம் 'சித்திரக்கூடம்', 'எழுதுநிலை மண்டபம்', 'சித்திர மாடம்' என அழைக்கப்பட்டது.", "content_en": "Art studios and galleries were designated Chithirakkoodam, Ezhuthunilai Mandapam, and Chithira Maadam."}, {"id": "S4", "content_ta": "ஓவியக் கலை பற்றிய எவ்விதக் குறிப்பும் சிலப்பதிகாரம், மணிமேகலை போன்ற சங்க கால இலக்கியங்களில் காணப்படவில்லை.", "content_en": "No mentions of painting exist in classical Sangam or post-Sangam epics like Silappathikaram and Manimekalai."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 26, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["art_terminology", "ancient_tamil", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q145", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-paper-paintings", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாள் ஓவியங்கள் (Paper Paintings) குறித்த கூற்றுகளை ஆராய்க:\n1. தாள் ஓவியங்கள் வரையும் வழக்கம் காகிதம் புழக்கத்திற்கு வந்த பின்னரே பரவலாக வளர்ந்தது.\n2. தாள் ஓவியங்களை வரையக் கரிக்கோல், நீர் வண்ணம், எண்ணெய் வண்ணம் போன்ற கருவிகளைப் பயன்படுத்துகின்றனர்.\n3. தற்காலத்தில் காகிதத் தாள்களில் வண்ண ஓவியங்கள் வரையும் வழக்கம் மிக அருகிப் போய்விட்டது.\nஇவற்றுள் சரியானவை எவை?"}], "options": {"A": "1 மற்றும் 2 மட்டுமே சரி", "B": "2 மற்றும் 3 மட்டுமே சரி", "C": "1, 2, 3 அனைத்தும் சரி", "D": "1 மட்டுமே சரி"}, "explanation": "தாள் ஓவியங்கள் தற்காலத்தில் எங்கும் பரவலாகப் பயன்பாட்டில் உள்ள கலை வடிவமாகும். வழக்கொழிந்து விட்டது எனக் கூறும் கூற்று 3 தவறு. 1 மற்றும் 2 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Paper Paintings:\n1. Paper painting evolved widely following the widespread availability of paper.\n2. Charcoal pencils, watercolors, and oil paints are utilized for paper works.\n3. In present times, painting on paper media has nearly ceased to exist.\nWhich of these are correct?"}], "options": {"A": "1 and 2 only correct", "B": "2 and 3 only correct", "C": "1, 2, 3 all are correct", "D": "1 only correct"}, "explanation": "Paper painting is ubiquitous and vibrant today. Statement 3 asserting its disappearance is false; 1 and 2 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "தாள் ஓவியங்கள் வரையும் வழக்கம் காகிதம் புழக்கத்திற்கு வந்த பின்னரே பரவலாக வளர்ந்தது.", "content_en": "Paper painting flourished broadly only after paper came into common usage."}, {"id": "S2", "content_ta": "தாள் ஓவியங்களை வரையக் கரிக்கோல், நீர் வண்ணம், எண்ணெய் வண்ணம் போன்ற கருவிகளைப் பயன்படுத்துகின்றனர்.", "content_en": "Charcoal pencils, watercolors, and oil colors are utilized to render paper art."}, {"id": "S3", "content_ta": "தற்காலத்தில் காகிதத் தாள்களில் வண்ண ஓவியங்கள் வரையும் வழக்கம் மிக அருகிப் போய்விட்டது.", "content_en": "In contemporary times, the practice of painting on paper sheets has almost completely vanished."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 26, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["paper_paintings", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q146", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-art-kalaichorkal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல் 2-ன் கலைச்சொற்கள் பற்றிய கூற்றுகளை ஆராய்க:\n1. 'Aesthetics' என்னும் ஆங்கிலக் கலைச்சொல்லிற்கு இணையான தமிழ்ச் சொல் 'அழகியல்' ஆகும்.\n2. 'Brush' என்பதற்கு இணையான தமிழ்ச் சொல் 'எழுத்தாணி' ஆகும்.\n3. 'Cartoon' என்பதற்கு இணையான தமிழ்ச் சொல் 'கருத்துப்படம்' ஆகும்.\n4. 'Cave paintings' என்பதற்கு இணையான தமிழ்ச் சொல் 'குகை ஓவியங்கள்' ஆகும்.\nஇவற்றுள் தவறான கூற்று எது?"}], "options": {"A": "கூற்று 1", "B": "கூற்று 2", "C": "கூற்று 3", "D": "கூற்று 4"}, "explanation": "'Brush' என்பதற்கு இணையான சரியான தமிழ்ச் சொல் 'தூரிகை' ஆகும். 'எழுத்தாணி' என்பது ஓலைச்சுவடியில் எழுதப் பயன்படும் இரும்புக் கருவி (Stylus). எனவே கூற்று 2 தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Examine the artistic technical vocabulary in Unit 2:\n1. 'Aesthetics' corresponds to 'Azhagiyal'.\n2. 'Brush' corresponds to 'Ezhutthaani'.\n3. 'Cartoon' corresponds to 'Karuthuppadam'.\n4. 'Cave paintings' corresponds to 'Kugai Oviyangal'.\nWhich statement is incorrect?"}], "options": {"A": "Statement 1", "B": "Statement 2", "C": "Statement 3", "D": "Statement 4"}, "explanation": "'Brush' translates to 'Thoorigai', while 'Ezhutthaani' is an iron stylus. Statement 2 is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'Aesthetics' என்னும் ஆங்கிலக் கலைச்சொல்லிற்கு இணையான தமிழ்ச் சொல் 'அழகியல்' ஆகும்.", "content_en": "The Tamil term for 'Aesthetics' is 'Azhagiyal'."}, {"id": "S2", "content_ta": "'Brush' என்பதற்கு இணையான தமிழ்ச் சொல் 'எழுத்தாணி' ஆகும்.", "content_en": "The Tamil term for 'Brush' is 'Ezhutthaani'."}, {"id": "S3", "content_ta": "'Cartoon' என்பதற்கு இணையான தமிழ்ச் சொல் 'கருத்துப்படம்' ஆகும்.", "content_en": "The Tamil term for 'Cartoon' is 'Karuthuppadam'."}, {"id": "S4", "content_ta": "'Cave paintings' என்பதற்கு இணையான தமிழ்ச் சொல் 'குகை ஓவியங்கள்' ஆகும்.", "content_en": "The Tamil term for 'Cave paintings' is 'Kugai Oviyangal'."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 39, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["kalaichorkal", "vocabulary", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q147", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-art-evolution-synthesis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஓவியக்கலையின் வளர்ச்சி குறித்த கூற்றுகளை ஆராய்க:\n1. ஓவியக்கலை மனித வாழ்வின் உணர்வுகளையும் அழகியலையும் வெளிப்படுத்தும் உன்னதமான கலை.\n2. குகை ஓவியங்கள் முதல் நவீன ஓவியங்கள் வரை காலந்தோறும் புதிய புதிய ஊடகங்களில் ஓவியக்கலை உருமாறி வளர்ந்துள்ளது.\n3. பாரதியாரின் கருத்துப் படங்கள் விடுதலைப் போராட்டக் காலத்தில் ஆங்கிலேய ஆட்சியாளர்களைப் புகழ்ந்து பாராட்டுவதற்காகப் பயன்படுத்தப்பட்டன.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "1, 2, 3 அனைத்தும் சரி", "B": "2 மற்றும் 3 மட்டுமே சரி", "C": "1 மற்றும் 2 மட்டுமே சரி", "D": "1 மற்றும் 3 மட்டுமே சரி"}, "explanation": "பாரதியாரின் கருத்துப் படங்கள் பிரிட்டிஷ் அடக்குமுறையைக் கேலி செய்து விடுதலை வேட்கையை ஊட்டின; அவர்களைப் புகழவில்லை. எனவே கூற்று 3 தவறு; 1 மற்றும் 2 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the evolutionary trajectory of Tamil painting:\n1. Painting is an exalted vehicle for expressing human sentiment and beauty.\n2. Painting metamorphosed across changing media from cave petroglyphs to abstract modernism.\n3. Bharathiyar's political cartoons were drawn to praise British colonial rulers.\nWhich statements are correct?"}], "options": {"A": "1, 2, 3 all are correct", "B": "2 and 3 only correct", "C": "1 and 2 only correct", "D": "1 and 3 only correct"}, "explanation": "Bharathiyar satirized colonial oppression to kindle patriotic rebellion. Statement 3 is false; statements 1 and 2 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ஓவியக்கலை மனித வாழ்வின் உணர்வுகளையும் அழகியலையும் வெளிப்படுத்தும் உன்னதமான கலை.", "content_en": "Painting is an exalted art reflecting human emotions and aesthetic consciousness."}, {"id": "S2", "content_ta": "குகை ஓவியங்கள் முதல் நவீன ஓவியங்கள் வரை காலந்தோறும் புதிய புதிய ஊடகங்களில் ஓவியக்கலை உருமாறி வளர்ந்துள்ளது.", "content_en": "From cave art to modern abstraction, painting has continuously evolved across diverse media through eras."}, {"id": "S3", "content_ta": "பாரதியாரின் கருத்துப் படங்கள் விடுதலைப் போராட்டக் காலத்தில் ஆங்கிலேய ஆட்சியாளர்களைப் புகழ்ந்து பாராட்டுவதற்காகப் பயன்படுத்தப்பட்டன.", "content_en": "Bharathiyar's political cartoons were created to eulogize British imperial authorities."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pesum_oviyangal", "art_history", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q148", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-ar-bharathiyar-cartoons", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): பாரதியார் 'இந்தியா' என்னும் தம் இதழில் கருத்துப் படங்களை வெளியிட்டார்.\nகாரணம் (R): பாமர மக்களும் அரசியல் கொடுமைகளையும் சமூக அவலங்களையும் எளிதாகப் புரிந்து கொண்டு விடுதலைப் போராட்டத்தில் இணைய வேண்டும் என்ற நோக்கில் கருத்துப் படங்களை அவர் முதன்முதலில் அறிமுகம் செய்தார்.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "B": "கூற்று (A) தவறு, காரணம் (R) சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; மேலும் காரணம் கூற்றிற்குச் சரியான விளக்கமாகும்."}, "explanation": "பாரதியார் இந்தியா இதழில் கருத்துப்படங்களை வெளியிட்டுப் பொதுமக்களிடம் அரசியல் விழிப்புணர்வை உருவாக்கினார். கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Bharathiyar pioneered the publication of political cartoons in his periodical 'India'.\nReason (R): He introduced cartoons so that illiterate common masses could intuitively grasp political despotism and join the independence struggle.\nSelect the correct option:"}], "options": {"A": "Assertion (A) is correct, Reason (R) is false.", "B": "Assertion (A) is false, Reason (R) is correct.", "C": "Both (A) and (R) are false.", "D": "Both (A) and (R) are correct, and (R) is the proper explanation of (A)."}, "explanation": "Bharathiyar used cartoons to make political satire accessible to common folk. Both assertion and reason are true and logically linked."}}, "question_data": {"assertion": "பாரதியார் 'இந்தியா' என்னும் தம் இதழில் கருத்துப் படங்களை வெளியிட்டார்.", "reason": "பாமர மக்களும் அரசியல் கொடுமைகளையும் சமூக அவலங்களையும் எளிதாகப் புரிந்து கொண்டு விடுதலைப் போராட்டத்தில் இணைய வேண்டும் என்ற நோக்கில் கருத்துப் படங்களை அவர் முதன்முதலில் அறிமுகம் செய்தார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bharathiyar", "cartoons", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q149", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-ar-kondaiyaraju-bazaar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): நாட்காட்டி ஓவியங்களைப் 'பஜார் பெயிண்டிங்' என்னும் பெயரிலும் அழைப்பர்.\nகாரணம் (R): கடைவீதிகளில் மக்கள் எளிதில் வாங்கும் வகையில் குறைந்த விலையில் பெருமளவில் அச்சிடப்பட்டு விற்கப்பட்டதால் இப்பெயர் பெற்றது.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது.", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "C": "கூற்று (A) தவறு, காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "நாட்காட்டி ஓவியங்கள் சந்தைகளில் பரவலாக விற்கப்பட்டதால் பஜார் பெயிண்டிங் எனப்பட்டன; கொண்டையராஜு இதன் முன்னோடி. கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Calendar paintings are also referred to by the terminology 'Bazaar Painting'.\nReason (R): They received this moniker because they were mass-printed and distributed economically in commercial marketplaces for common households.\nSelect the correct option:"}], "options": {"A": "Both (A) and (R) are true; Reason correctly explains Assertion.", "B": "(A) is true, Reason is false.", "C": "(A) is false, Reason is true.", "D": "Both (A) and (R) are false."}, "explanation": "Calendar art reached commercial markets in high volumes, earning the title 'Bazaar Painting'. Both (A) and (R) are correct."}}, "question_data": {"assertion": "நாட்காட்டி ஓவியங்களைப் 'பஜார் பெயிண்டிங்' என்னும் பெயரிலும் அழைப்பர்.", "reason": "கடைவீதிகளில் மக்கள் எளிதில் வாங்கும் வகையில் குறைந்த விலையில் பெருமளவில் அச்சிடப்பட்டு விற்கப்பட்டதால் இப்பெயர் பெற்றது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["kondaiyaraju", "bazaar_painting", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q150", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-ar-caricature-satire", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): மனித உருவங்களை விந்தையான தோற்றங்களில் கேலியாக வரைவது கேலிச்சித்திரம் எனப்படுகிறது.\nகாரணம் (R): சமூகத்தில் நிலவும் மூடநம்பிக்கைகளையும் போலித்தனங்களையும் நகைச்சுவை உணர்வோடு சாடி விழிப்புணர்வு ஏற்படுத்துவதே இதன் நோக்கமாகும்.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "B": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது.", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "கேலிச்சித்திரம் விந்தையான உருவ அமைப்பின் மூலம் நகைச்சுவை தோன்ற வரைவதோடு, சமூகக் கருத்துகளை வெளிப்படுத்துகிறது. கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Depicting human figures in bizarre, humorous distortions is designated as Caricature.\nReason (R): Its core purpose is to satirize superstition, societal hypocrisy, and injustice through visual wit.\nSelect the correct option:"}], "options": {"A": "Assertion (A) is correct, Reason (R) is false.", "B": "Both (A) and (R) are correct; (R) is the proper explanation of (A).", "C": "Assertion (A) is false, Reason (R) is correct.", "D": "Both (A) and (R) are false."}, "explanation": "Caricatures combine visual exaggeration with incisive social commentary. Both assertion and reason are true and coherent."}}, "question_data": {"assertion": "மனித உருவங்களை விந்தையான தோற்றங்களில் கேலியாக வரைவது கேலிச்சித்திரம் எனப்படுகிறது.", "reason": "சமூகத்தில் நிலவும் மூடநம்பிக்கைகளையும் போலித்தனங்களையும் நகைச்சுவை உணர்வோடு சாடி விழிப்புணர்வு ஏற்படுத்துவதே இதன் நோக்கமாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["caricature", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q151", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-ar-modern-art-contrast", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): நவீன ஓவியங்கள் பழங்காலக் குகை ஓவியங்களைப் போலவே வெறும் கரிக்கோலால் மட்டுமே வரையப்பட வேண்டும் என்ற கட்டுப்பாடு உடையவை.\nகாரணம் (R): நவீன ஓவியக் கலைஞர்கள் மரபுசார்ந்த விதிகளை உடைத்துப் புதிய கோடுகள், வண்ணங்கள் மற்றும் வெளிப்பாட்டு முறைகளைக் கையாள்கின்றனர்.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி.", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "நவீன ஓவியங்கள் எவ்வித இறுக்கமான கட்டுப்பாடுகளும் இன்றிப் புதுமையான வடிவங்களில் பன்முக வண்ணங்களால் வரையப்படுகின்றன. எனவே கூற்று (A) தவறு; காரணம் (R) சரியானது."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Modern Art strictly mandates that works must be executed solely in charcoal pencils mimicking primitive cave petroglyphs.\nReason (R): Modern artists deliberately shatter rigid classical conventions, deploying innovative brushstrokes, hues, and abstraction.\nSelect the correct option:"}], "options": {"A": "Both (A) and (R) are true.", "B": "(A) is true, but (R) is false.", "C": "(A) is false, but (R) is true.", "D": "Both (A) and (R) are false."}, "explanation": "Modern Art is not restricted to charcoal pencils; it embraces boundary-pushing media and colors. Thus (A) is false and (R) is true."}}, "question_data": {"assertion": "நவீன ஓவியங்கள் பழங்காலக் குகை ஓவியங்களைப் போலவே வெறும் கரிக்கோலால் மட்டுமே வரையப்பட வேண்டும் என்ற கட்டுப்பாடு உடையவை.", "reason": "நவீன ஓவியக் கலைஞர்கள் மரபுசார்ந்த விதிகளை உடைத்துப் புதிய கோடுகள், வண்ணங்கள் மற்றும் வெளிப்பாட்டு முறைகளைக் கையாள்கின்றனர்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["modern_art", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q152", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-ar-kannul-vinaijnan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): பழந்தமிழர் ஓவியர்களைக் 'கண்ணுள் வினைஞன்' என்று போற்றினர்.\nகாரணம் (R): காண்போரின் கண்களையும் மனத்தையும் தம் வண்ணக் கைவண்ணத்தால் தம்பால் ஈர்த்து அகக்கண்ணால் காண்பதை ஓவியமாகப் படைக்கும் மாபெரும் வித்தகக் கலைஞர்களாக அவர்கள் திகழ்ந்தனர்.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "B": "கூற்று (A) தவறு, காரணம் (R) சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; மேலும் காரணம் கூற்றிற்குச் சரியான விளக்கமாகும்."}, "explanation": "'கண்ணுள் வினைஞன்' என்பது மணிமேகலை மற்றும் சிலப்பதிகாரத்தில் ஓவியரை அழைக்கப் பயன்பட்ட தொன்மையான தமிழ் சொல்லாட்சியாகும். கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Ancient Tamils revered painters with the exalted title 'Kannul Vinaijnan'.\nReason (R): They were supreme visionary artists capable of captivating the onlooker's eyes and transmuting inner imagination onto canvas.\nSelect the correct option:"}], "options": {"A": "Assertion (A) is true, Reason (R) is false.", "B": "Assertion (A) is false, Reason (R) is true.", "C": "Both (A) and (R) are false.", "D": "Both (A) and (R) are true, and Reason properly explains Assertion."}, "explanation": "'Kannul Vinaijnan' is the classical epic epithet for a master painter. Both assertion and reason are true and logically aligned."}}, "question_data": {"assertion": "பழந்தமிழர் ஓவியர்களைக் 'கண்ணுள் வினைஞன்' என்று போற்றினர்.", "reason": "காண்போரின் கண்களையும் மனத்தையும் தம் வண்ணக் கைவண்ணத்தால் தம்பால் ஈர்த்து அகக்கண்ணால் காண்பதை ஓவியமாகப் படைக்கும் மாபெரும் வித்தகக் கலைஞர்களாக அவர்கள் திகழ்ந்தனர்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 26, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["kannul_vinaijnan", "art_terminology", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q153", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-ar-paper-art-spread", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தாள் ஓவியங்களின் வருகை ஓவியக்கலையைப் பாமர மக்களிடையேயும் மாணவர்களிடையேயும் மிகப்பெரிய அளவில் பரவலாக்கியது.\nகாரணம் (R): பாறை, சுவர்கள், தந்தம் போன்ற கடினமான ஊடகங்களைக் காட்டிலும் காகிதத் தாள்கள் மிக எளிதாகவும் குறைந்த செலவிலும் அனைவருக்கும் கிடைத்தன.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது.", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "C": "கூற்று (A) தவறு, காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "காகிதத்தின் புழக்கத்திற்குப் பிறகே ஓவியக்கலை அன்றாடக் கல்வி மற்றும் சமூக ஊடகமாக எளிதில் பரவியது. கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): The advent of paper paintings profoundly democratized and popularized visual art among ordinary students and masses.\nReason (R): Unlike cumbersome surfaces like cave boulders, stone walls, or ivory, paper was lightweight, inexpensive, and readily accessible.\nSelect the correct option:"}], "options": {"A": "Both (A) and (R) are true; (R) is the correct explanation of (A).", "B": "(A) is true, but (R) is false.", "C": "(A) is false, but (R) is true.", "D": "Both (A) and (R) are false."}, "explanation": "The mass availability of paper revolutionized the accessibility of visual arts across educational strata. Both (A) and (R) are true."}}, "question_data": {"assertion": "தாள் ஓவியங்களின் வருகை ஓவியக்கலையைப் பாமர மக்களிடையேயும் மாணவர்களிடையேயும் மிகப்பெரிய அளவில் பரவலாக்கியது.", "reason": "பாறை, சுவர்கள், தந்தம் போன்ற கடினமான ஊடகங்களைக் காட்டிலும் காகிதத் தாள்கள் மிக எளிதாகவும் குறைந்த செலவிலும் அனைவருக்கும் கிடைத்தன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 26, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["paper_paintings", "democratization", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q154", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-match-modern-forms", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தற்கால ஓவிய வடிவங்களையும் அவற்றின் தனித்துவங்களையும் பொருத்துக:\n(a) கருத்துப்படம் - 1. கொண்டையராஜு (பஜார் பெயிண்டிங்)\n(b) நாட்காட்டி ஓவியம் - 2. பாரதியார் ('இந்தியா' இதழ்)\n(c) கேலிச்சித்திரம் - 3. பார்வையாளர் சிந்தனைக்கேற்ப பன்முக அர்த்தம்\n(d) நவீன ஓவியம் - 4. விந்தையான நகைச்சுவைத் தோற்றங்கள்"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-2, b-4, c-1, d-3", "D": "a-3, b-1, c-4, d-2"}, "explanation": "கருத்துப்படம் = பாரதியார் (2); நாட்காட்டி ஓவியம் = கொண்டையராஜு (1); கேலிச்சித்திரம் = விந்தையான நகைச்சுவை (4); நவீன ஓவியம் = பன்முக அர்த்தம் (3). வரிசை: 2, 1, 4, 3."}, "en": {"blocks": [{"type": "text", "content": "Match contemporary art styles with their hallmarks/pioneers:\n(a) Cartoon - 1. Kondaiyaraju (Bazaar painting)\n(b) Calendar art - 2. Bharathiyar ('India' weekly)\n(c) Caricature - 3. Multi-layered subjective meaning\n(d) Modern Art - 4. Grotesque humorous distortions"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-2, b-4, c-1, d-3", "D": "a-3, b-1, c-4, d-2"}, "explanation": "Cartoon = Bharathiyar (2); Calendar = Kondaiyaraju (1); Caricature = Humorous distortions (4); Modern Art = Open interpretation (3). Match: 2, 1, 4, 3 (B)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "கருத்துப்படம்", "content_en": "Cartoon"}, {"id": "L2", "content_ta": "நாட்காட்டி ஓவியம்", "content_en": "Calendar painting"}, {"id": "L3", "content_ta": "கேலிச்சித்திரம்", "content_en": "Caricature"}, {