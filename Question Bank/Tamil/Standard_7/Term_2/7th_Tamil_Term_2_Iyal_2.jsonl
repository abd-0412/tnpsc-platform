// 7-ஆம் வகுப்பு தமிழ் - பருவம் 2 - இயல் 2: கலை, அழகியல் (கலைவண்ணம்) (மொத்த வினாக்கள்: 140)
// ==============================================================================
// ==============================================================================
// பாடம் 1: பூத்தொடுத்தல் (கவிதைப்பேழை - உமா மகேஸ்வரி) & ஓவியக்கலை தொடக்க வரலாறு [Q113 - Q140]
// உமா மகேஸ்வரி, மதுரை மாவட்டம், ஆண்டிப்பட்டி வாழ்வு, கவிதைத் தொகுதிகள் (நட்சத்திரங்களின் நடுவே, வெறும் பொழுது, கற்பாவை), புதுக்கவிதை, 'சாந்தமானதொரு பிரபஞ்சத்தை சுமக்கின்றன ஒல்லித் தண்டுகள்', தொல் தமிழர் குகை ஓவியங்கள் (பாறை ஓவியங்கள், வேட்டைக்காட்சிகள், செம்மண் சாயம்/சிவப்புக்கல், யானை/குதிரை/மான்), எழுத்து - ஓவியம் வரலாற்றுத் தொடர்பு (கண்ணெழுத்துப் படுத்த எண்ணுப் பல்பொதி, சிலப்பதிகாரம், நடுகல் வணக்கம்), பரிபாடல் சித்திர மாடம், மணிமேகலை ஓவியச் செந்நூல், சிலப்பதிகார ஓவியக் கலைஞர் 'ஓவக்கrecords'
// ==============================================================================
{"id": "7th-t2-u2-q113", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-07-poothoduthal", "chapter_id": null, "topic_id": "ta-t2-u2-uma-maheswari-bio", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் உமா மகேஸ்வரி பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. கவிஞர் உமா மகேஸ்வரி மதுரை மாவட்டத்தில் பிறந்தவர்.\n2. இவர் தற்போது தேனி மாவட்டம் ஆண்டிபட்டியில் வாழ்ந்து வருகிறார்.\n3. 'நட்சத்திரங்களின் நடுவே', 'வெறும் பொழுது', 'கற்பாவை' என்பன இவரது புகழ்பெற்ற கவிதை நூல்களாகும்.\n4. இவரது கவிதைகள் அன்றாட வாழ்வின் நுட்பமான அழகியல் உணர்வுகளையும் தத்துவச் சிந்தனைகளையும் வெளிப்படுத்துவன.\nஇவற்றுள் சரியானவை எவை?"}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 2, 3 மட்டுமே சரி", "C": "2, 3, 4 மட்டுமே சரி", "D": "1, 3, 4 மட்டுமே சரி"}, "explanation": "பாடநூல் நூல் வெளிப் பகுதியின்படி, கவிஞர் உமா மகேஸ்வரி மதுரை மாவட்டத்தில் பிறந்தவர், தேனி மாவட்டம் ஆண்டிபட்டியில் வாழ்ந்து வருபவர். நட்சத்திரங்களின் நடுவே, வெறும் பொழுது, கற்பாவை உள்ளிட்ட கவிதை நூல்களை எழுதியுள்ளார். நான்கு கூற்றுகளும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements regarding poet Uma Maheswari:\n1. Poet Uma Maheswari was born in Madurai district.\n2. She currently lives in Andipatti, Theni district.\n3. 'Natchathirangalin Naduve', 'Verum Pozhuthu', and 'Karpavai' are her famous poetry works.\n4. Her poems express subtle aesthetic nuances and philosophical contemplations.\nWhich of these are correct?"}], "options": {"A": "1, 2, 3, 4 all are correct", "B": "1, 2, 3 only correct", "C": "2, 3, 4 only correct", "D": "1, 3, 4 only correct"}, "explanation": "All four statements accurately convey the biographical details and literary contributions of poet Uma Maheswari as per the textbook."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "கவிஞர் உமா மகேஸ்வரி மதுரை மாவட்டத்தில் பிறந்தவர்.", "content_en": "Poet Uma Maheswari was born in Madurai district."}, {"id": "S2", "content_ta": "இவர் தற்போது தேனி மாவட்டம் ஆண்டிபட்டியில் வாழ்ந்து வருகிறார்.", "content_en": "She currently resides in Andipatti, Theni district."}, {"id": "S3", "content_ta": "'நட்சத்திரங்களின் நடுவே', 'வெறும் பொழுது', 'கற்பாவை' என்பன இவரது புகழ்பெற்ற கவிதை நூல்களாகும்.", "content_en": "'Natchathirangalin Naduve', 'Verum Pozhuthu', and 'Karpavai' are her renowned poetry collections."}, {"id": "S4", "content_ta": "இவரது கவிதைகள் அன்றாட வாழ்வின் நுட்பமான அழகியல் உணர்வுகளையும் தத்துவச் சிந்தனைகளையும் வெளிப்படுத்துவன.", "content_en": "Her poetry reflects subtle aesthetic sensitivities and philosophical observations of daily life."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 23, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["uma_maheswari", "poothoduthal", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q114", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-07-poothoduthal", "chapter_id": null, "topic_id": "ta-t2-u2-poothoduthal-vocab", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பூத்தொடுத்தல்' கவிதையின் அருஞ்சொற்பொருள் குறித்த கூற்றுகளை ஆராய்க:\n1. 'சாந்தம்' என்னும் சொல்லிற்கு 'அமைதி' என்பது பொருளாகும்.\n2. 'பிரபஞ்சம்' என்னும் சொல்லிற்கு 'பூமி மட்டுமே' என்பது பாடநூல் தரும் பொருளாகும்.\n3. 'நுண்மை' என்பதற்கு 'நுட்பம்' என்பது பொருளாகும்.\n4. 'உற்றால்' என்பதற்கு 'அடைந்தால்' என்பது பொருளாகும்.\nஇவற்றுள் தவறான கூற்று எது?"}], "options": {"A": "கூற்று 1", "B": "கூற்று 2", "C": "கூற்று 3", "D": "கூற்று 4"}, "explanation": "'பிரபஞ்சம்' என்பதற்குப் பாடநூல் தரும் பொருள் 'அண்டம் (பெருவெளி)' என்பதாகும். கூற்று 2-ல் 'பூமி மட்டுமே' என்று குறுகிய பொருளில் தந்துள்ளது தவறாகும்."}, "en": {"blocks": [{"type": "text", "content": "Examine the glossary of 'Poothoduthal':\n1. 'Santham' means peace / serenity.\n2. 'Pirabanjam' denotes 'earth alone' per the textbook.\n3. 'Nunmai' denotes subtlety.\n4. 'Utraal' denotes 'upon reaching / attaining'.\nWhich statement is incorrect?"}], "options": {"A": "Statement 1", "B": "Statement 2", "C": "Statement 3", "D": "Statement 4"}, "explanation": "'Pirabanjam' denotes 'Andam (Cosmos/Great Space)', not merely the Earth. Statement 2 is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'சாந்தம்' என்னும் சொல்லிற்கு 'அமைதி' என்பது பொருளாகும்.", "content_en": "'Santham' denotes 'peace / tranquility'."}, {"id": "S2", "content_ta": "'பிரபஞ்சம்' என்னும் சொல்லிற்கு 'பூமி மட்டுமே' என்பது பாடநூல் தரும் பொருளாகும்.", "content_en": "'Pirabanjam' denotes 'earth alone' according to the textbook glossary."}, {"id": "S3", "content_ta": "'நுண்மை' என்பதற்கு 'நுட்பம்' என்பது பொருளாகும்.", "content_en": "'Nunmai' signifies 'subtlety / precision'."}, {"id": "S4", "content_ta": "'உற்றால்' என்பதற்கு 'அடைந்தால்' என்பது பொருளாகும்.", "content_en": "'Utraal' signifies 'if achieved / if attained'."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 23, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vocabulary", "poothoduthal", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q115", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-cave-paintings-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குகை ஓவியங்கள் தொடர்பான பின்வரும் கூற்றுகளை ஆராய்க:\n1. பழங்கால மனிதர்கள் செய்திகளைப் பிறருக்குத் தெரிவிப்பதற்காகவே குகைகளில் ஓவியங்களை முதலில் வரைந்தனர்.\n2. வேட்டைக்குச் செல்லுதல், நடனம் ஆடுதல், போர் செய்தல் போன்ற காட்சிகள் குகை ஓவியங்களில் பெருமளவில் வரையப்பட்டன.\n3. பழந்தமிழர்கள் குகை ஓவியங்களுக்கு எண்ணெய் வண்ணங்களையும் வேதிச் சாயங்களையும் பயன்படுத்தினர்.\nஇவற்றுள் சரியானவை எவை?"}], "options": {"A": "1, 2, 3 அனைத்தும் சரி", "B": "2 மற்றும் 3 மட்டுமே சரி", "C": "1 மற்றும் 2 மட்டுமே சரி", "D": "1 மற்றும் 3 மட்டுமே சரி"}, "explanation": "குகை ஓவியங்களுக்கு 'மண் மற்றும் கல் துகள்களைக் கொண்டே வண்ணம் தீட்டினர்'. கூற்று 3-ல் எண்ணெய் வண்ணம், வேதிச்சாயம் எனக் கூறியது முற்றிலும் தவறு. 1 மற்றும் 2 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements regarding prehistoric cave paintings:\n1. Primitive humans drew paintings primarily to communicate messages to peers.\n2. Scenes of hunting, group dances, and warfare were commonly rendered.\n3. Ancient Tamils utilized oil paints and synthetic dyes for cave murals.\nWhich of these are correct?"}], "options": {"A": "1, 2, 3 all are correct", "B": "2 and 3 only correct", "C": "1 and 2 only correct", "D": "1 and 3 only correct"}, "explanation": "Prehistoric humans applied mineral powders and ground earth stones for coloring, not oil colors. Statement 3 is false; 1 and 2 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பழங்கால மனிதர்கள் செய்திகளைப் பிறருக்குத் தெரிவிப்பதற்காகவே குகைகளில் ஓவியங்களை முதலில் வரைந்தனர்.", "content_en": "Ancient humans initially drew paintings in caves to communicate information to others."}, {"id": "S2", "content_ta": "வேட்டைக்குச் செல்லுதல், நடனம் ஆடுதல், போர் செய்தல் போன்ற காட்சிகள் குகை ஓவியங்களில் பெருமளவில் வரையப்பட்டன.", "content_en": "Hunting scenes, dancing, and warfare scenes were prominently depicted in cave art."}, {"id": "S3", "content_ta": "பழந்தமிழர்கள் குகை ஓவியங்களுக்கு எண்ணெய் வண்ணங்களையும் (oil colors) வேதிச் சாயங்களையும் பயன்படுத்தினர்.", "content_en": "Ancient Tamils utilized modern oil pigments and chemical dyes for cave art."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 24, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pesum_oviyangal", "cave_paintings", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q116", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-mural-paintings-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுவர் ஓவியங்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. சுவர் ஓவியங்கள் மனிதர்கள் வீடுகட்டி வாழத் தொடங்கிய காலம் முதல் வரையப்பட்டு வருகின்றன.\n2. அரண்மனைகள், மண்டபங்கள், கோவில் சுவர்கள் மற்றும் மேற்கூரைகளில் சுவர் ஓவியங்களைக் காண முடிகிறது.\n3. சித்தன்னவாசலிலும் தஞ்சைப் பெரிய கோவிலிலும் புகழ்பெற்ற பழங்காலச் சுவர் ஓவியங்கள் ஏராளமாகக் காணப்படுகின்றன.\n4. தஞ்சைப் பெரிய கோவிலில் நாயன்மார்களில் ஒருவரான சுந்தரரின் வரலாற்றுடன் சேரமான் நாயனாரின் காட்சிகளும் வரையப்பட்டுள்ளன.\nஇவற்றுள் சரியானவை எவை?"}], "options": {"A": "1, 2, 3 மட்டுமே சரி", "B": "2, 3, 4 மட்டுமே சரி", "C": "1, 3, 4 மட்டுமே சரி", "D": "1, 2, 3, 4 அனைத்தும் சரி"}, "explanation": "பாடநூல் பக்கங்கள் 24-25 இன் படி, மனிதர் வீடுகட்டி வாழத் தொடங்கிய காலம் முதல் சித்தன்னவாசல், தஞ்சைப் பெரிய கோவில் (சேரமான் நாயனார் வரலாற்றுக் காட்சிகள்) வரை சுவர் ஓவியங்கள் போற்றப்பட்டன. நான்கு கூற்றுகளும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on wall murals (Suvar Oviyam):\n1. Murals have been rendered since humanity transitioned into permanent architectural dwelling.\n2. They adorn palaces, mandapams, and sanctuary ceilings.\n3. Sittannavasal and Thanjavur Brihadisvara temple preserve majestic ancient murals.\n4. In Thanjavur temple, episodes of Cheraman Nayanar along with Sundarar are painted.\nWhich of these are correct?"}], "options": {"A": "1, 2, 3 only correct", "B": "2, 3, 4 only correct", "C": "1, 3, 4 only correct", "D": "1, 2, 3, 4 all are correct"}, "explanation": "All four statements perfectly match the historical and architectural descriptions of Tamil mural painting traditions."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "சுவர் ஓவியங்கள் மனிதர்கள் வீடுகட்டி வாழத் தொடங்கிய காலம் முதல் வரையப்பட்டு வருகின்றன.", "content_en": "Wall murals have been painted ever since humans began constructing permanent dwellings."}, {"id": "S2", "content_ta": "அரண்மனைகள், மண்டபங்கள், கோவில் சுவர்கள் மற்றும் மேற்கூரைகளில் சுவர் ஓவியங்களைக் காண முடிகிறது.", "content_en": "Murals are found across palaces, public halls, temple walls, and ceilings."}, {"id": "S3", "content_ta": "சித்தன்னவாசலிலும் தஞ்சைப் பெரிய கோவிலிலும் புகழ்பெற்ற பழங்காலச் சுவர் ஓவியங்கள் ஏராளமாகக் காணப்படுகின்றன.", "content_en": "Celebrated historic murals abound in Sittannavasal and Thanjavur Big Temple."}, {"id": "S4", "content_ta": "தஞ்சைப் பெரிய கோவிலில் நாயன்மார்களில் ஒருவரான சுந்தரரின் வரலாற்றுடன் சேரமான் நாயனாரின் காட்சிகளும் வரையப்பட்டுள்ளன.", "content_en": "In Thanjavur Big Temple, historical episodes of Cheraman Nayanar alongside Sundarar are portrayed."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 25, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["suvar_oviyam", "thanjavur_paintings", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q117", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-cloth-paintings-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "துணி ஓவியங்கள் (கலம்காரி) குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. பழங்காலத்தில் ஓவியம் வரையப் பயன்பட்ட துணியைச் 'சித்திரப்படம்', 'சித்திரச்சுவர்', 'களம்காரி' என அழைத்தனர்.\n2. சீவக சிந்தாமணியில் குணமாலை என்னும் தலைவி யானையைக் கண்டு அஞ்சிய காட்சியைச் சீவகன் துணியில் வரைந்ததாகக் குறிப்பிடப்பட்டுள்ளது.\n3. தற்காலத்தில் ஆந்திராவிலும் தமிழ்நாட்டிலும் துணி ஓவியங்கள் 'கலம்காரி ஓவியங்கள்' என்னும் பெயரில் புகழுடன் வரையப்படுகின்றன.\n4. துணி ஓவியங்கள் முதன்முதலில் பிரிட்டிஷ் கிழக்கிந்தியக் கம்பெனியாரால் மட்டுமே இந்தியாவிற்குள் அறிமுகப்படுத்தப்பட்டன.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "1, 2, 3 மட்டுமே சரி", "B": "2, 3, 4 மட்டுமே சரி", "C": "1, 3, 4 மட்டுமே சரி", "D": "அனைத்தும் சரி"}, "explanation": "துணி ஓவியங்கள் சங்க காலம் மற்றும் காப்பியக் காலந்தொட்டே தமிழகத்தில் வழக்கிலிருந்த தொன்மை வாய்ந்த கலை. ஆங்கிலேயர் அறிமுகப்படுத்தியதன்று. கூற்று 4 தவறு; 1, 2, 3 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on cloth paintings (Kalamkari):\n1. Fabric used for painting was called Chithirappadam, Chithirachuvor, and Kalamkari.\n2. Seevaka Chinthamani mentions Seevakan painting Gunamaalai's fear of an elephant on fabric.\n3. In contemporary times, Andhra and Tamil Nadu actively produce Kalamkari cloth art.\n4. Cloth painting was initially introduced to India strictly by the East India Company.\nWhich statements are correct?"}], "options": {"A": "1, 2, 3 only correct", "B": "2, 3, 4 only correct", "C": "1, 3, 4 only correct", "D": "All are correct"}, "explanation": "Cloth painting is an ancient indigenous Tamil tradition documented in epic literature. Statement 4 is false; 1, 2, and 3 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பழங்காலத்தில் ஓவியம் வரையப் பயன்பட்ட துணியைச் 'சித்திரப்படம்', 'சித்திரச்சுவர்', 'களம்காரி' என அழைத்தனர்.", "content_en": "Cloth used for painting in ancient times was called Chithirappadam, Chithirachuvor, and Kalamkari."}, {"id": "S2", "content_ta": "சீவக சிந்தாமணியில் குணமாலை என்னும் தலைவி யானையைக் கண்டு அஞ்சிய காட்சியைச் சீவகன் துணியில் வரைந்ததாகக் குறிப்பிடப்பட்டுள்ளது.", "content_en": "In Seevaka Chinthamani, it is recorded that Seevakan drew the scene of heroine Gunamaalai alarmed by an elephant upon cloth."}, {"id": "S3", "content_ta": "தற்காலத்தில் ஆந்திராவிலும் தமிழ்நாட்டிலும் துணி ஓவியங்கள் 'கலம்காரி ஓவியங்கள்' என்னும் பெயரில் புகழுடன் வரையப்படுகின்றன.", "content_en": "Presently in Andhra and Tamil Nadu, cloth painting is famously practiced under the name Kalamkari."}, {"id": "S4", "content_ta": "துணி ஓவியங்கள் முதன்முதலில் பிரிட்டிஷ் கிழக்கிந்தியக் கம்பெனியாரால் மட்டுமே இந்தியாவிற்குள் அறிமுகப்படுத்தப்பட்டன.", "content_en": "Cloth painting was first introduced into India solely by the British East India Company."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 25, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["thuni_oviyam", "kalamkari", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q118", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-palmleaf-paintings", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஓலைச்சுவடி ஓவியங்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. ஓலைச்சுவடிகளில் எழுத்தாணியைக் கொண்டு கோட்டோவியமாகவும் வண்ணப்பூச்சோவியமாகவும் வரைந்தனர்.\n2. ஓலைச்சுவடி ஓவியங்கள் தமிழகத்தின் அனைத்து மாவட்ட பொது நூலகங்களிலும் தற்காலத்தில் காணப்படுகின்றன.\n3. இதிகாச மற்றும் புராணக் காட்சிகளே ஓலைச்சுவடிகளில் மிகுதியாக வரையப்பட்டன.\n4. தஞ்சை சரசுவதி மகால் நூலகத்திற்குச் சென்றால் அரிய ஓலைச்சுவடி ஓவியங்களை இன்றும் நேரில் காணலாம்.\nஇவற்றுள் தவறான கூற்று எது?"}], "options": {"A": "கூற்று 1", "B": "கூற்று 2", "C": "கூற்று 3", "D": "கூற்று 4"}, "explanation": "பாடநூல் கூற்று: 'ஓலைச்சுவடி ஓவியங்களை இப்போது காண்பது அரிது; தஞ்சை சரசுவதி மகால் நூலகத்திற்குச் சென்றால் மட்டுமே நாம் இவற்றைக் காண முடியும்'. எனவே அனைத்து மாவட்ட நூலகங்களிலும் உண்டு என்பது தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on palm-leaf manuscript paintings:\n1. Palm-leaf paintings were executed using iron styluses as line drawings and colored art.\n2. Palm-leaf paintings are preserved in all district public libraries across Tamil Nadu today.\n3. Epic and puranic themes were abundantly illustrated on palm leaves.\n4. Visitors can view rare surviving palm-leaf art at Saraswathi Mahal Library in Thanjavur.\nWhich statement is incorrect?"}], "options": {"A": "Statement 1", "B": "Statement 2", "C": "Statement 3", "D": "Statement 4"}, "explanation": "The textbook explicitly states that palm-leaf paintings are rare today and can only be seen at Saraswathi Mahal Library, Thanjavur. Statement 2 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ஓலைச்சுவடிகளில் எழுத்தாணியைக் கொண்டு கோட்டோவியமாகவும் வண்ணப்பூச்சோவியமாகவும் வரைந்தனர்.", "content_en": "On palm-leaf manuscripts, lines were etched with an iron stylus and tinted with natural pigments."}, {"id": "S2", "content_ta": "ஓலைச்சுவடி ஓவியங்கள் தமிழகத்தின் அனைத்து மாவட்ட பொது நூலகங்களிலும் தற்காலத்தில் காணப்படுகின்றன.", "content_en": "Palm-leaf paintings are presently preserved across all district public libraries in Tamil Nadu."}, {"id": "S3", "content_ta": "இதிகாச மற்றும் புராணக் காட்சிகளே ஓலைச்சுவடிகளில் மிகுதியாக வரையப்பட்டன.", "content_en": "Mythological and epic scenes were predominantly etched onto palm leaves."}, {"id": "S4", "content_ta": "தஞ்சை சரசுவதி மகால் நூலகத்திற்குச் சென்றால் அரிய ஓலைச்சுவடி ஓவியங்களை இன்றும் நேரில் காணலாம்.", "content_en": "Rare palm-leaf paintings can be observed today in Saraswathi Mahal Library, Thanjavur."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 26, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["olaichuvadi_oviyam", "saraswathi_mahal", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q119", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-ivory-glass-paintings", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தந்த ஓவியங்கள் மற்றும் கண்ணாடி ஓவியங்கள் குறித்த கூற்றுகளை ஆராய்க:\n1. வயது முதிர்ந்து இறந்த யானைகளின் தந்தங்களின் மீது நீர்வண்ணங்களைப் பயன்படுத்தித் தந்த ஓவியங்கள் வரையப்பட்டன.\n2. தந்த ஓவியங்கள் கேரள மாநிலத்தில் பெருமளவில் காணப்படுகின்றன.\n3. கண்ணாடி ஓவியங்களை வரையும் கலைஞர்கள் தஞ்சாவூரில் மிகுதியாக வாழ்கின்றனர்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "1 மற்றும் 2 மட்டுமே சரி", "B": "2 மற்றும் 3 மட்டுமே சரி", "C": "1, 2, 3 அனைத்தும் சரி", "D": "1 மட்டுமே சரி"}, "explanation": "தந்த ஓவியங்கள் கேரளாவிலும், கண்ணாடி ஓவியங்கள் தஞ்சாவூரிலும் சிறந்து விளங்குவதாகப் பாடநூலில் தெளிவாக விளக்கப்பட்டுள்ளது. மூன்று கூற்றுகளும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on ivory paintings and glass paintings:\n1. Ivory paintings were made with watercolors on tusks of elephants that died naturally.\n2. Ivory paintings are predominantly found in Kerala.\n3. Glass painting artists thrive predominantly in Thanjavur.\nWhich statements are correct?"}], "options": {"A": "1 and 2 only correct", "B": "2 and 3 only correct", "C": "1, 2, 3 all are correct", "D": "1 only correct"}, "explanation": "All three statements faithfully state the geographic concentrations and technical attributes of ivory paintings (Kerala) and glass paintings (Thanjavur)."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "வயது முதிர்ந்து இறந்த யானைகளின் தந்தங்களின் மீது நீர்வண்ணங்களைப் பயன்படுத்தித் தந்த ஓவியங்கள் வரையப்பட்டன.", "content_en": "Ivory paintings were rendered using watercolors on the tusks of elephants that died of old age."}, {"id": "S2", "content_ta": "தந்த ஓவியங்கள் கேரள மாநிலத்தில் பெருமளவில் காணப்படுகின்றன.", "content_en": "Ivory paintings are extensively found in the state of Kerala."}, {"id": "S3", "content_ta": "கண்ணாடி ஓவியங்களை வரையும் கலைஞர்கள் தஞ்சாவூரில் மிகுதியாக வாழ்கின்றனர்.", "content_en": "Glass-painting artisans reside in large numbers in Thanjavur."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 26, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["thantha_oviyam", "kannadi_oviyam", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q120", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-ar-art-primacy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): ஓவியக்கலையை நுண்கலைகளுள் முதன்மையான ஒன்றாக அறிஞர்கள் கருதுகின்றனர்.\nகாரணம் (R): ஒரு கருத்தைப் பேச்சாலும் எழுத்தாலும் விளக்குவதைக் காட்டிலும் ஓர் ஓவியத்தால் காண்போருக்கு மிக நுட்பமாகவும் எளிமையாகவும் புரிய வைத்துவிட முடியும்.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "B": "கூற்று (A) தவறு, காரணம் (R) சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; மேலும் காரணம் கூற்றிற்குச் சரியான விளக்கமாகும்."}, "explanation": "ஆயகலைகள் அறுபத்து நான்கனுள் நுண்கலைகளுள் தலையாயது ஓவியக்கலையாகும். காண்போரின் கண்ணையும் கருத்தையும் கவர்ந்திழுக்கும் ஆற்றல் அதற்கு உண்டு. கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Scholars consider the art of painting as foremost among the fine arts.\nReason (R): Better than spoken or written prose, a visual painting conveys complex concepts to observers with supreme nuance and immediacy.\nSelect the correct option:"}], "options": {"A": "Assertion (A) is correct, Reason (R) is false.", "B": "Assertion (A) is false, Reason (R) is correct.", "C": "Both (A) and (R) are false.", "D": "Both (A) and (R) are correct, and (R) is the proper explanation of (A)."}, "explanation": "Painting is celebrated as the paramount fine art because of its immediate visual resonance and conceptual economy. Both statement and reasoning are correct."}}, "question_data": {"assertion": "ஓவியக்கலையை நுண்கலைகளுள் முதன்மையான ஒன்றாக அறிஞர்கள் கருதுகின்றனர்.", "reason": "ஒரு கருத்தைப் பேச்சாலும் எழுத்தாலும் விளக்குவதைக் காட்டிலும் ஓர் ஓவியத்தால் காண்போருக்கு மிக நுட்பமாகவும் எளிமையாகவும் புரிய வைத்துவிட முடியும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 24, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pesum_oviyangal", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q121", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-ar-seevaka-chinthamani-art", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): சீவக சிந்தாமணிக் காப்பியத்தில் துணி ஓவியம் பற்றிய அரிய குறிப்பு இடம்பெற்றுள்ளது.\nகாரணம் (R): காப்பியத் தலைவன் சீவகன், குணமாலை மதயானையைக் கண்டு அஞ்சி நடுங்கிய காட்சியைத் துணியில் வரைந்து வெளிப்படுத்தியதாகப் பாடப்பட்டுள்ளது.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது.", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "சீவக சிந்தாமணியில் சீவகன் குணமாலையின் அச்சத்தைத் துணியில் வரைந்த காட்சி கூறப்பட்டுள்ளது. எனவே துணி ஓவிய மரபிற்கு இது முதன்மைச் சான்றாகும். கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): An invaluable reference to fabric painting occurs in the epic Seevaka Chinthamani.\nReason (R): The epic hero Seevakan is depicted as painting on fabric the heroine Gunamaalai trembling in terror upon encountering a rogue elephant.\nSelect the correct option:"}], "options": {"A": "Both (A) and (R) are correct; Reason properly explains Assertion.", "B": "(A) is correct, Reason is false.", "C": "(A) is false, Reason is correct.", "D": "Both (A) and (R) are false."}, "explanation": "Seevaka Chinthamani contains classical evidence of cloth painting where Seevakan paints Gunamaalai's fear of an elephant. Both are true."}}, "question_data": {"assertion": "சீவக சிந்தாமணிக் காப்பியத்தில் துணி ஓவியம் பற்றிய அரிய குறிப்பு இடம்பெற்றுள்ளது.", "reason": "காப்பியத் தலைவன் சீவகன், குணமாலை மதயானையைக் கண்டு அஞ்சி நடுங்கிய காட்சியைத் துணியில் வரைந்து வெளிப்படுத்தியதாகப் பாடப்பட்டுள்ளது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 25, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["seevaka_chinthamani", "thuni_oviyam", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q122", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-ar-kerala-ivory-paintings", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தந்த ஓவியங்கள் கேரள மாநிலத்தில் மிக அதிகமாகக் காணப்படுகின்றன.\nகாரணம் (R): கேரளக் காடுகளில் யானைகள் மிகுதியாக வாழ்ந்ததால் முற்காலம் முதலே தந்தங்களின் மீது கலைநயமிக்க ஓவியங்கள் வரையும் மரபு அங்கு செழித்து வளர்ந்தது.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "B": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது.", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "பாடநூல் சிந்தனை வினாவிலும் உரையிலும், கேரளாவில் தந்த ஓவியங்கள் அதிகம் காணப்படுவதற்குக் கேரளாவின் வனவளமும் யானைகளின் இருப்பும் காரணமென விளக்கப்பட்டுள்ளது. கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Ivory paintings are predominantly found in the state of Kerala.\nReason (R): The abundance of elephants in Kerala forests historically supported a flourishing tradition of fine ivory craftsmanship and painting.\nSelect the correct option:"}], "options": {"A": "Assertion (A) is correct, Reason (R) is false.", "B": "Both (A) and (R) are correct; (R) is the proper explanation of (A).", "C": "Assertion (A) is false, Reason (R) is correct.", "D": "Both (A) and (R) are false."}, "explanation": "Ivory painting thrived in Kerala owing to its historical ecology and availability of elephant ivory. Both statement and reason are sound."}}, "question_data": {"assertion": "தந்த ஓவியங்கள் கேரள மாநிலத்தில் மிக அதிகமாகக் காணப்படுகின்றன.", "reason": "கேரளக் காடுகளில் யானைகள் மிகுதியாக வாழ்ந்ததால் முற்காலம் முதலே தந்தங்களின் மீது கலைநயமிக்க ஓவியங்கள் வரையும் மரபு அங்கு செழித்து வளர்ந்தது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 26, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["thantha_oviyam", "kerala", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q123", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-ar-sittannavasal-contradiction", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): சித்தன்னவாசல் குகைக் கோவிலில் காணப்படும் பழமையான ஓவியங்கள் அனைத்தும் கண்ணாடி ஓவியக் கலையைச் சார்ந்தவை ஆகும்.\nகாரணம் (R): சித்தன்னவாசலில் சமண முனிவர்கள் வாழ்ந்த குகைகளின் சுவர்களிலும் மேற்கூரைகளிலும் இயற்கை வண்ணங்களால் சுவர் ஓவியங்கள் தீட்டப்பட்டுள்ளன.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி.", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "சித்தன்னவாசல் ஓவியங்கள் 'சுவர் ஓவியங்கள் (மற்றும் குகைச் சுவர் ஓவியங்கள்)' ஆகும்; கண்ணாடி ஓவியங்கள் அல்ல. கண்ணாடி ஓவியங்கள் தஞ்சாவூரின் சிறப்பம்சமாகும். எனவே கூற்று (A) தவறு; காரணம் (R) சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): The ancient artworks found at the Sittannavasal cave shrine belong to the category of glass paintings.\nReason (R): Natural mural paintings were executed on the stone walls and ceilings of caves inhabited by Jain ascetics at Sittannavasal.\nSelect the correct option:"}], "options": {"A": "Both (A) and (R) are true.", "B": "(A) is true, but (R) is false.", "C": "(A) is false, but (R) is true.", "D": "Both (A) and (R) are false."}, "explanation": "Sittannavasal frescoes are rock-wall murals, not glass paintings. Glass painting is typical of Thanjavur. Thus (A) is false and (R) is true."}}, "question_data": {"assertion": "சித்தன்னவாசல் குகைக் கோவிலில் காணப்படும் பழமையான ஓவியங்கள் அனைத்தும் கண்ணாடி ஓவியக் கலையைச் சார்ந்தவை ஆகும்.", "reason": "சித்தன்னவாசலில் சமண முனிவர்கள் வாழ்ந்த குகைகளின் சுவர்களிலும் மேற்கூரைகளிலும் இயற்கை வண்ணங்களால் சுவர் ஓவியங்கள் தீட்டப்பட்டுள்ளன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 25, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["sittannavasal", "suvar_oviyam", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q124", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-07-poothoduthal", "chapter_id": null, "topic_id": "ta-t2-u2-ar-poothoduthal-delicacy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): உமா மகேஸ்வரி பூத்தொடுக்கும் செயலை ஒரு பிரபஞ்சப் பேரமைப்போடும் நுட்பமான கலை உணர்வோடும் ஒப்பிடுகிறார்.\nகாரணம் (R): நாரின் இறுக்கமும் மென்மையும் சரியாய் அமைந்தால் மட்டுமே நளினமான மலர்கள் சிதையாமல் மாலையாக மலரும் என்ற இயற்கையின் உண்மையை அவர் உணர்த்துகிறார்.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "B": "கூற்று (A) தவறு, காரணம் (R) சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; மேலும் காரணம் கூற்றிற்குச் சரியான விளக்கமாகும்."}, "explanation": "பூத்தொடுத்தல் கவிதையில் மலர்களின் மென்மை, நாரின் வலிமை, விரல்களின் நளினம், பிரபஞ்ச ஒழுங்கமைப்பு ஆகியவற்றின் அழகியல் பிணைப்பு நுட்பமாகப் பாடப்பட்டுள்ளது. கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Uma Maheswari equates flower stringing with cosmic harmony and delicate artistic sensitivity.\nReason (R): She conveys that only when the tension and gentleness of the fiber are balanced will delicate blossoms coalesce without being crushed.\nSelect the correct option:"}], "options": {"A": "Assertion (A) is true, Reason (R) is false.", "B": "Assertion (A) is false, Reason (R) is true.", "C": "Both (A) and (R) are false.", "D": "Both (A) and (R) are true, and (R) is the proper explanation of (A)."}, "explanation": "The poem 'Poothoduthal' meditates on delicate artistry and cosmic balance through the act of weaving flowers. Both statement and reason are correct."}}, "question_data": {"assertion": "உமா மகேஸ்வரி பூத்தொடுக்கும் செயலை ஒரு பிரபஞ்சப் பேரமைப்போடும் நுட்பமான கலை உணர்வோடும் ஒப்பிடுகிறார்.", "reason": "நாரின் இறுக்கமும் மென்மையும் சரியாய் அமைந்தால் மட்டுமே நளினமான மலர்கள் சிதையாமல் மாலையாக மலரும் என்ற இயற்கையின் உண்மையை அவர் உணர்த்துகிறார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 22, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["poothoduthal", "uma_maheswari", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q125", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-ar-olaichuvadi-preservation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): ஓலைச்சுவடி ஓவியங்கள் தற்காலத்தில் அழியும் நிலையை எட்டியுள்ளன.\nகாரணம் (R): கால மாற்றத்தில் காகிதமும் நவீன அச்சுக்கலையும் தோன்றியதால் எழுத்தாணியால் ஓலைகளில் வரையும் மரபு வழக்கொழிந்து, பழஞ்சுவடிகள் தஞ்சை சரசுவதி மகால் போன்ற குறிப்பிட்ட இடங்களில் மட்டுமே பாதுகாக்கப்படுகின்றன.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது.", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "C": "கூற்று (A) தவறு, காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "ஓலைச்சுவடி ஓவியங்கள் தற்காலத்தில் அரிதாகி சரசுவதி மகால் நூலகத்தில் மட்டுமே பாதுகாக்கப்படுகிறது என்ற பாடநூல் செய்தி கூற்றையும் காரணத்தையும் மெய்ப்பிக்கிறது. கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Palm-leaf manuscript paintings have become an endangered legacy in modern times.\nReason (R): The advent of paper and printing technology obsoleted stylus etching, leaving remaining artifacts preserved in limited sanctuaries like Thanjavur Saraswathi Mahal.\nSelect the correct option:"}], "options": {"A": "Both (A) and (R) are true; (R) is the correct explanation of (A).", "B": "(A) is true, but (R) is false.", "C": "(A) is false, but (R) is true.", "D": "Both (A) and (R) are false."}, "explanation": "The transition to modern media made palm-leaf incision paintings extremely rare, preserved now only in scholarly archives like Saraswathi Mahal. Both (A) and (R) are true."}}, "question_data": {"assertion": "ஓலைச்சுவடி ஓவியங்கள் தற்காலத்தில் அழியும் நிலையை எட்டியுள்ளன.", "reason": "கால மாற்றத்தில் காகிதமும் நவீன அச்சுக்கலையும் தோன்றியதால் எழுத்தாணியால் ஓலைகளில் வரையும் மரபு வழக்கொழிந்து, பழஞ்சுவடிகள் தஞ்சை சரசுவதி மகால் போன்ற குறிப்பிட்ட இடங்களில் மட்டுமே பாதுகாக்கப்படுகின்றன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 26, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["olaichuvadi_oviyam", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q126", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-match-art-forms-1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஓவிய வகைகளையும் அவற்றின் முதன்மைக் கூறுகளையும் பொருத்துக:\n(a) குகை ஓவியம் - 1. சித்தன்னவாசல், தஞ்சைப் பெரிய கோவில்\n(b) சுவர் ஓவியம் - 2. மண் மற்றும் கல் துகள் வண்ணம்\n(c) துணி ஓவியம் - 3. கேரள மாநிலம் (நீர்வண்ணம்)\n(d) தந்த ஓவியம் - 4. சித்திரப்படம், கலம்காரி"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-2, b-4, c-1, d-3", "D": "a-3, b-1, c-4, d-2"}, "explanation": "குகை ஓவியம் = மண், கல் துகள் (2); சுவர் ஓவியம் = சித்தன்னவாசல், தஞ்சை (1); துணி ஓவியம் = சித்திரப்படம், கலம்காரி (4); தந்த ஓவியம் = கேரளா (3). வரிசை: 2, 1, 4, 3."}, "en": {"blocks": [{"type": "text", "content": "Match the painting forms with their defining characteristics:\n(a) Cave painting - 1. Sittannavasal, Thanjavur Big Temple\n(b) Wall mural - 2. Earth and mineral powder colors\n(c) Cloth painting - 3. Kerala state (Watercolors)\n(d) Ivory painting - 4. Chithirappadam, Kalamkari"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-2, b-4, c-1, d-3", "D": "a-3, b-1, c-4, d-2"}, "explanation": "Cave = earth powder (2); Mural = Sittannavasal, Thanjavur (1); Cloth = Kalamkari (4); Ivory = Kerala (3). Match: 2, 1, 4, 3 (B)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "குகை ஓவியம்", "content_en": "Cave painting"}, {"id": "L2", "content_ta": "சுவர் ஓவியம்", "content_en": "Wall mural"}, {"id": "L3", "content_ta": "துணி ஓவியம்", "content_en": "Cloth painting"}, {"id": "L4", "content_ta": "தந்த ஓவியம்", "content_en": "Ivory painting"}], "right": [{"id": "R1", "content_ta": "சித்தன்னவாசல், தஞ்சைப் பெரிய கோவில்", "content_en": "Sittannavasal, Thanjavur Big Temple"}, {"id": "R2", "content_ta": "மண் மற்றும் கல் துகள் வண்ணம்", "content_en": "Earth and mineral rock powder colors"}, {"id": "R3", "content_ta": "கேரள மாநிலம் (நீர்வண்ணம்)", "content_en": "Kerala state (Watercolors)"}, {"id": "R4", "content_ta": "சித்திரப்படம், கலம்காரி", "content_en": "Chithirappadam, Kalamkari"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 24, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pesum_oviyangal", "matching"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
