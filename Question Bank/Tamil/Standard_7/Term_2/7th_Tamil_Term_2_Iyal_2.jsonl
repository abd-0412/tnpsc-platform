{"id": "7th-t2-u2-q161", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-grammar-karuthuppadam-sandhi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கருத்து + படம் = கருத்துப்படம்' என்னும் புணர்ச்சியில் 'ப்' என்னும் வல்லினம் மிகக் காரணமான இலக்கண விதி யாது?"}], "options": {"A": "வன்தொடர்க் குற்றியலுகரத்தின் பின் வல்லினம் மிகும்", "B": "மென்தொடர்க் குற்றியலுகரத்தின் பின் வல்லினம் மிகாது", "C": "இரண்டாம் வேற்றுமைத் தொகையில் வல்லினம் மிகாது", "D": "இடைத்தொடர்க் குற்றியலுகரத்தின் முன் மெல்லினம் மிகும்"}, "explanation": "'கருத்து' என்பது வன்தொடர்க் குற்றியலுகரச் சொல்லாகும் (த் + உ = து). வன்தொடர்க் குற்றியலுகரத்தின் பின் வருமொழி முதலில் க, ச, த, ப வந்தால் வல்லினம் மிகும் என்ற விதிப்படி 'ப்' மிக்கு 'கருத்துப்படம்' எனப் புணர்ந்தது."}, "en": {"blocks": [{"type": "text", "content": "Identify the Sandhi rule responsible for the stop gemination 'p' in 'Karuthu + Padam = Karuthuppadam':"}], "options": {"A": "Voiceless stops geminate after Vanthodark-kutriyalugaram", "B": "Stops do not geminate after Menthodark-kutriyalugaram", "C": "Stops do not geminate in 2nd case compounds", "D": "Nasals geminate before Idaithodark-kutriyalugaram"}, "explanation": "'Karuthu' is a Vanthodark-kutriyalugaram base. Voiceless stops geminate following it: Karuthu + Padam = Karuthuppadam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["kutriyalugaram", "vallinam_miguthal", "grammar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
