{"id": "7th-t2-u2-q244", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-11-thirukkural", "chapter_id": null, "topic_id": "ta-t2-u2-grammar-karka-kasadara-metrics", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கசடற' என்னும் சொல்லின் மொத்த மாத்திரை அளவைக் கணக்கிடுக:"}], "options": {"A": "2 மாத்திரை", "B": "2.5 மாத்திரை", "C": "3.5 மாத்திரை", "D": "4 மாத்திரை"}, "explanation": "'கசடற' மாத்திரை பகுப்பாய்வு:\nக (குறில்) = 1 மாத்திரை\nச (குறில்) = 1 மாத்திரை\nட (குறில்) = 1 மாத்திரை\nற (குறில்) = 1 மாத்திரை\nமொத்தம் = 1 + 1 + 1 + 1 = 4 மாத்திரை."}, "en": {"blocks": [{"type": "text", "content": "Calculate the total prosodic metric count (Maathirai) for the word 'Kasadara':"}], "options": {"A": "2 Maathirai", "B": "2.5 Maathirai", "C": "3.5 Maathirai", "D": "4 Maathirai"}, "explanation": "Metrics for 'Kasadara': Ka (1) + sa (1) + da (1) + ra (1) = 4 Maathirai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 40, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous