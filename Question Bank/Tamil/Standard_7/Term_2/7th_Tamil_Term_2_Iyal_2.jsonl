{"id": "7th-t2-u2-q215", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-10-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-u2-match-root-mutation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முதனிலைகளையும் அவை திரியும் முதல்நிலை திரிந்த தொழிற்பெயர்களையும் பொருத்துக:\n(a) கெடு - 1. சூடு\n(b) சுடு - 2. வீடு\n(c) பெறு - 3. கேடு\n(d) விடு - 4. பேறு"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-4, b-3, c-2, d-1", "C": "a-3, b-1, c-4, d-2", "D": "a-3, b-4, c-1, d-2"}, "explanation": "கெடு -> கேடு (3); சுடு -> சூடு (1); பெறு -> பேறு (4); விடு -> வீடு (2). வரிசை: 3, 1, 4, 2."}, "en": {"blocks": [{"type": "text", "content": "Match the primary roots with their mutated verbal noun derivatives:\n(a) Kedu - 1. Soodu\n(b) Sudu - 2. Veedu\n(c) Peru - 3. Keedu\n(d) Vidu - 4. Pearu"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-4, b-3, c-2, d-1", "C": "a-3, b-1, c-4, d-2", "D": "a-3, b-4, c-1, d-2"}, "explanation": "Kedu -> Keedu (3); Sudu -> Soodu (1); Peru -> Pearu (4); Vidu -> Veedu (2). Match: 3, 1, 4, 2 (C)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "கெடு", "content_en": "Kedu"}, {"id": "L2", "content_ta": "சுடு", "content_en": "Sudu"}, {"id": "L3", "content_ta": "பெறு", "content_en": "Peru"}, {"id": "L4", "content_ta": "விடு", "content_en": "Vidu"}], "right": [{"id": "R1", "content_ta": "சூடு", "content_en": "Soodu"}, {"id": "R2", "content_ta": "வீடு", "content_en": "Veedu"}, {"id": "R3", "content_ta": "கேடு", "content_en": "Keedu"}, {"id": "R4", "content_ta": "பேறு", "content_en": "Pearu"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["mudhalnilai_thirintha", "matching"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u2-q216", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-10-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-u2-grammar-seyyaamai-mathirai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'செய்யாமை' என்னும் எதிர்மறைத் தொழிற்பெயரின் மொத்த மாத்திரை அளவைக் கணக்கிடுக:"}], "options": {"A": "4 மாத்திரை", "B": "4.5 மாத்திரை", "C": "5 மாத்திரை", "D": "5.5 மாத்திரை"}, "explanation": "'செய்யாமை' மாத்திரை பகுப்பாய்வு:\nசெ (குறில்) = 1 மாத்திரை\nய் (மெய்) = 0.5 மாத்திரை\nயா (நெடில்) = 2 மாத்திரை\nமை (நெடில்) = 2 மாத்திரை\nகூட்டுத்தொகை = 1 + 0.5 + 2 + 2 = 5.5 மாத்திரை."}, "en": {"blocks": [{"type": "text", "content": "Calculate the total prosodic metric count (Maathirai) for 'Seyyaamai':"}], "options": {"A": "4 Maathirai", "B": "4.5 Maathirai", "C": "5 Maathirai", "D": "5.5 Maathirai"}, "explanation": "Metrics for 'Seyyaamai': Se (1) + y (0.5) + yaa (2) + mai (2) = 5.5 Maathirai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}