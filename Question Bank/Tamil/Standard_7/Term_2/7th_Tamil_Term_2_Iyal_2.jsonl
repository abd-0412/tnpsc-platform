{"id": "7th-t2-u2-q160", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-u2-grammar-karuthuppadam-mathirai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கருத்துப்படம்' என்னும் சொல்லின் மொத்த மாத்திரை அளவைக் கணக்கிடுக:"}], "options": {"A": "5 மாத்திரை", "B": "5.5 மாத்திரை", "C": "6 மாத்திரை", "D": "6.5 மாத்திரை"}, "explanation": "'கருத்துப்படம்' மாத்திரை பகுப்பாய்வு:\nக (குறில்) = 1 மாத்திரை\nரு (குறில்) = 1 மாத்திரை\nத் (மெய்) = 0.5 மாத்திரை\nது (குறில்) = 1 மாத்திரை\nப் (மெய்) = 0.5 மாத்திரை\nப (குறில்) = 1 மாத்திரை\nட (குறில்) = 1 மாத்திரை\nம் (மெய்) = 0.5 மாத்திரை\nகூட்டுத்தொகை = 1 + 1 + 0.5 + 1 + 0.5 + 1 + 1 + 0.5 = 6.5 மாத்திரை."}, "en": {"blocks": [{"type": "text", "content": "Calculate the total prosodic metric count (Maathirai) for 'Karuthuppadam':"}], "options": {"A": "5 Maathirai", "B": "5.5 Maathirai", "C": "6 Maathirai", "D": "6.5 Maathirai"}, "explanation": "Metrics for 'Karuthuppadam': Ka (1) + ru (1) + th (0.5) + thu (1) + p (0.5) + pa (1) + da (1) + m (0.5) = 6.5 Maathirai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Servi