{"id": "7th-t2-pyq-q302", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-08-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-pyq-grammar-ethirmarai-ident", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் வாக்கியங்களில் 'எதிர்மறைத் தொழிற்பெயர்' அமைந்துள்ள தொடரைக் கண்டறிக:"}], "options": {"A": "அவன் நாள்தோறும் நூலகத்திற்கு வருகை புரிந்தான்", "B": "பிறருக்கு உதவி செய்தல் சிறந்த அறம் ஆகும்", "C": "பொய் பேசாமையும் உயிர்களைக் கொல்லாமையும் சான்றோர் கொள்கை", "D": "பாடியவள் யார் என்பதை நடுவர் அறிவித்தார்"}, "explanation": "'பேசாமை', 'கொல்லாமை' என்பவை வினையின் எதிர்மறையை உணர்த்தும் 'எதிர்மறைத் தொழிற்பெயர்கள்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the sentence containing an Ethirmarai Thozhirpeyar (negative verbal noun):"}], "options": {"A": "He visited the library daily", "B": "Helping others is a noble virtue", "C": "Non-lying and non-killing are codes of the virtuous", "D": "The judge declared who sang"}, "explanation": "'Peesaamai' and 'Kollaamai' function as negative verbal nouns denoting the negation of the acts."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Ser