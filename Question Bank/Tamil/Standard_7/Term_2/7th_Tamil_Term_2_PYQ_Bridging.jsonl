// பகுதி 3: பழைய சமச்சீர் இணைப்பு & 7-ஆம் வகுப்பு பருவம் 2 முழுமையான தொகுப்பு (Old Samacheer Bridging & Master Synthesis) [Q309 - Q336]
// பழைய மற்றும் புதிய சமச்சீர் பாடத்திட்ட ஒப்பீடு (நாலடியார் கல்வி வெண்பாக்கள், வாழ்விக்கும் கல்வி நெறிகள், உமா மகேஸ்வரி பூத்தொடுத்தல் மெய்யியல்), வரலாற்று ஓவிய வளர்ச்சி மரபு (குகை முதல் நவீன கருத்துப்படம் வரை), திருக்குறள் வாழ்வியல் ஆழம், பருவம் 2 முழுமையான திருப்புதல்
// ==============================================================================
{"id": "7th-t2-pyq-q309", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-01-azhiyaa-selvam", "chapter_id": null, "topic_id": "ta-t2-bridging-naaladiyaar-master-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழைய மற்றும் புதிய பாடத்திட்ட நாலடியார் தகவல்கள் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. நாலடியார் பதினெண்கீழ்க்கணக்கு அறநூல்களுள் ஒன்றாகும்.\n2. திருக்குறளைப் போன்றே அறம், பொருள், இன்பம் என்னும் முப்பால் பகுப்பைக் கொண்டது.\n3. 'கல்வி கரையில கற்பவர் நாள்சில' என்னும் புகழ்பெற்ற பாடல் நாலடியாரில் உள்ளது.\n4. நாலடியார் கபிலரால் மட்டுமே இயற்றப்பட்ட தனிநபர் நீதி இலக்கியமாகும்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 2 மட்டுமே சரி", "C": "1, 2, 3 மட்டுமே சரி; 4 தவறு", "D": "2, 4 மட்டுமே சரி"}, "explanation": "நாலடியார் சமண முனிவர்கள் பலரால் இயற்றப்பட்டு பதுமனாரால் தொகுக்கப்பட்டு, தருமர் உரையெழுதிய நூல். கபிலர் இயற்றியதன்று. எனவே கூற்று 4 தவறு. 1, 2, 3 மிகச்சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements integrating Old & New Samacheer points on Naaladiyaar:\n1. Naaladiyaar belongs to Pathinenkeelkanakku ethical works.\n2. Like Thirukkural, it is divided into three sections: Aram, Porul, and Inbam.\n3. 'Kalvi karaiyila karpavar naalsila' is a celebrated verse from Naaladiyaar.\n4. Naaladiyaar was authored exclusively by Kabilar.\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1 and 2 only correct", "C": "1, 2, and 3 only correct; 4 incorrect", "D": "2 and 4 only correct"}, "explanation": "Naaladiyaar was authored by numerous Jain ascetics, not Kabilar. Statement 4 is false. 1, 2, and 3 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "நாலடியார் சங்க மருவிய காலத்து பதினெண்கீழ்க்கணக்கு அறநூல்களுள் ஒன்றாகத் திகழ்கிறது.", "content_en": "Naaladiyaar is one of the Pathinenkeelkanakku ethical anthologies of the post-Sangam era."}, {"id": "S2", "content_ta": "திருக்குறளைப் போன்றே அறம், பொருள், இன்பம் என்னும் முப்பால் பகுப்பைக் கொண்டது.", "content_en": "Like Thirukkural, it is organized into three divisions: Aram, Porul, and Inbam."}, {"id": "S3", "content_ta": "கல்வியின் பெருமையைப் பேசும் 'கல்வி கரையில கற்பவர் நாள்சில' என்னும் புகழ்பெற்ற வெண்பா நாலடியாரில் இடம்பெற்றுள்ளது.", "content_en": "The renowned poem 'Kalvi karaiyila karpavar naalsila' praising education belongs to Naaladiyaar."}, {"id": "S4", "content_ta": "நாலடியார் கபிலரால் மட்டுமே இயற்றப்பட்ட தனிநபர் நீதி இலக்கியமாகும்.", "content_en": "Naaladiyaar is a solo ethical text authored exclusively by poet Kabilar."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bridging", "naaladiyaar", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q310", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-07-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-bridging-art-literary-evidences", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பண்டைத் தமிழ் இலக்கியங்களில் ஓவியக்கலை பற்றிய குறிப்புகளை ஆராய்ந்து தவறான கூற்றைக் கண்டறிக:"}], "options": {"A": "நற்றிணையில் 'ஓவச் செய்தி' என்ற குறிப்பு ஓவியத்தைக் குறிக்கிறது", "B": "பரிபாடலில் திருப்பரங்குன்றத்துச் சித்திர மாடம் விவரிக்கப்பட்டுள்ளது", "C": "மணிமேகலையில் 'ஓவியச் செந்நூல்' பற்றிய குறிப்பு இடம்பெற்றுள்ளது", "D": "பண்டைக்காலத் தமிழகத்தில் ஓவியக்கலை முற்றிலும் தடை செய்யப்பட்டிருந்தது"}, "explanation": "பண்டைத் தமிழகத்தில் ஓவியக்கலை மிகுந்த சிறப்புற்று விளங்கியது. குகை, அரண்மனை, கோவில், பொது மன்றங்கள் என எங்கும் ஓவியங்கள் நிறைந்திருந்தன. எனவே 'D' முற்றிலும் தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Examine the references to art in classical Tamil literature and identify the INCORRECT statement:"}], "options": {"A": "Natrinai mentions 'Ova cheythi' denoting paintings", "B": "Paripaadal describes the Chithira Maadam at Thirupparankundram", "C": "Manimekalai refers to 'Oviyach chennool'", "D": "In ancient Tamil Nadu, painting was completely prohibited"}, "explanation": "Painting was celebrated and flourished in ancient Tamil society across caves, temples, and palaces. Statement D is absurdly false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "சங்க இலக்கியத்தில் ஓவியக்கலைக்கு 'ஓவச் செய்தி', 'சித்திர மாடம்' முதலான குறிப்புகள் காணப்படுகின்றன.", "content_en": "Sangam literature mentions painting as 'Ova cheythi' and refers to 'Chithira Maadam'."}, {"id": "S2", "content_ta": "பரிபாடலில் திருப்பரங்குன்றக் கோவில் சித்திர மாடம் பற்றிய விரிவான வர்ணனை இடம்பெற்றுள்ளது.", "content_en": "Paripaadal provides a vivid description of the art gallery at Thirupparankundram temple."}, {"id": "S3", "content_ta": "மணிமேகலையில் 'ஓவியச் செந்நூல் உரைநூற் கிடக்கையும்' என்று ஓவிய இலக்கண நூல் குறிப்பிடப்பட்டுள்ளது.", "content_en": "Manimekalai references painting treatises as 'Oviyach chennool urainoor kidakkaiyum'."}, {"id": "S4", "content_ta": "பண்டைக்காலத் தமிழகத்தில் ஓவியக்கலை முற்றிலும் தடை செய்யப்பட்டிருந்தது.", "content_en": "In ancient Tamil Nadu, painting was completely prohibited."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 22, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bridging", "art_history", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q311", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-07-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-bridging-cloth-art-kalamkari-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "துணி ஓவியங்கள் (கலம்காரி) பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. ஓவியம் வரையப் பயன்படும் துணியைச் சித்திரப் படம், சித்திரத்திரை என அழைத்தனர்.\n2. சிலப்பதிகாரத்தில் ஓவிய விதானம் பற்றிய குறிப்பு காணப்படுகிறது.\n3. தற்காலத்தில் இவை 'கலம்காரி ஓவியங்கள்' என்று அழைக்கப்படுகின்றன.\n4. தமிழ்நாடு மற்றும் ஆந்திர மாநிலங்களில் இக்கலைஞர்கள் பரவலாக வாழ்ந்து வருகின்றனர்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 3 மட்டுமே சரி", "C": "2, 3, 4 மட்டுமே சரி", "D": "1, 2, 4 மட்டுமே சரி"}, "explanation": "பாடநூல் பக்கம் 23-ல் உள்ளபடி துணி ஓவியத்தின் பழங்காலப் பெயர்கள் (சித்திரப் படம், சித்திரத்திரை), சிலப்பதிகாரக் குறிப்பு, கலம்காரி பெயரிடல் மற்றும் தமிழ்நாடு-ஆந்திர பரவல் ஆகிய நான்கு கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on cloth paintings (Kalamkari):\n1. Fabric used for painting was called Chithirap padam, Chithirathirai.\n2. Silappathikaram references painted ceilings (Oviya Vithaanam).\n3. In modern times, these are known as Kalamkari paintings.\n4. Kalamkari artisans thrive in Tamil Nadu and Andhra Pradesh.\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1 and 3 only correct", "C": "2, 3, and 4 only correct", "D": "1, 2, and 4 only correct"}, "explanation": "All four statements are verified facts from textbook page 23. All are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "துணி ஓவியங்களை 'சித்திரப் படம்', 'சித்திரத்திரை' எனப் பழந்தமிழர் அழைத்தனர்.", "content_en": "Ancient Tamils referred to cloth paintings as 'Chithirap padam' and 'Chithirathirai'."}, {"id": "S2", "content_ta": "மணிமேகலையில் 'சீவக சிந்தாமணி' காப்பியக் காட்சிகள் துணியில் வரையப்பட்டதாகக் கூறப்பட்டுள்ளது.", "content_en": "Wait, Silappathikaram mentions Oviya Vithaanam."}, {"id": "S3", "content_ta": "தற்காலத்தில் துணி ஓவியங்கள் 'கலம்காரி ஓவியங்கள்' என்று அழைக்கப்படுகின்றன.", "content_en": "In modern times, cloth paintings are known as Kalamkari paintings."}, {"id": "S4", "content_ta": "தமிழ்நாடு மற்றும் ஆந்திர மாநிலங்களில் கலம்காரி ஓவியக் கலைஞர்கள் இன்றும் பரவலாக வாழ்ந்து வருகின்றனர்.", "content_en": "Kalamkari artisans currently thrive across Tamil Nadu and Andhra Pradesh."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 23, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bridging", "kalamkari", "art_history", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q312", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-03-vaazhvikkum-kalvi", "chapter_id": null, "topic_id": "ta-t2-bridging-thirukkuralar-legacy-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளார் வீ. முனிசாமி பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. திருக்குறளை எளிய மக்களிடம் பரப்பிய பெருமகனார்.\n2. நகைச்சுவை ததும்பும் பேச்சால் மக்களை ஈர்த்தார்.\n3. 'வள்ளுவர் காட்டிய வழி', 'திருக்குறளில் நகைச்சுவை' முதலான நூல்களை இயற்றியுள்ளார்.\n4. இவர் தமிழக சட்டமன்றத்தின் சபாநாயகராக 30 ஆண்டுகள் தொடர்ந்து பணியாற்றினார்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 2, 3 மட்டுமே சரி; 4 தவறு", "C": "1, 3 மட்டுமே சரி; 2, 4 தவறு", "D": "2, 4 மட்டுமே சரி; 1, 3 தவறு"}, "explanation": "திருக்குறளார் வீ. முனிசாமி புகழ்பெற்ற அறிஞர், சொற்பொழிவாளர், எழுத்தாளர் ஆவார். அவர் சபாநாயகராகப் பணியாற்றவில்லை. எனவே கூற்று 4 தவறு. 1, 2, 3 மிகச்சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Thirukkuralar V. Munusamy:\n1. Great personality who propagated Thirukkural to common people.\n2. Attracted people through humour-filled speeches.\n3. Authored 'Valluvar Kaattiya Vazhi' and 'Thirukkuralil Nagaichuvai'.\n4. Served continuously as TN Assembly Speaker for 30 years.\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1, 2, and 3 only correct; 4 incorrect", "C": "1 and 3 only correct; 2 and 4 incorrect", "D": "2 and 4 only correct; 1 and 3 incorrect"}, "explanation": "Thirukkuralar was a scholar, speaker, and writer, not an assembly speaker. Statement 4 is false. 1, 2, 3 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "திருக்குறளார் வீ. முனிசாமி உலக பொதுமறையான திருக்குறளை எளிய மக்களிடம் பரப்பிய பெருமகனார்.", "content_en": "Thirukkuralar V. Munusamy popularized the universal scripture Thirukkural among the masses."}, {"id": "S2", "content_ta": "இவர் நகைச்சுவை ததும்பும் பேச்சால் மக்களைத் திருக்குறள் நெறியில் ஈர்த்தார்.", "content_en": "He captivated audiences into Kural ethics through his sparkling humour."}, {"id": "S3", "content_ta": "இவர் 'வள்ளுவர் காட்டிய வழி', 'திருக்குறளில் நகைச்சுவை' ஆகிய நூல்களை இயற்றியுள்ளார்.", "content_en": "He authored 'Valluvar Kaattiya Vazhi' and 'Thirukkuralil Nagaichuvai'."}, {"id": "S4", "content_ta": "இவர் தமிழக சட்டமன்றத்தின் சபாநாயகராக 30 ஆண்டுகள் தொடர்ந்து பணியாற்றினார்.", "content_en": "He served continuously as the Speaker of Tamil Nadu Legislative Assembly for 30 years."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 10, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bridging", "thirukkuralar", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q313", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-07-poothoduthal", "chapter_id": null, "topic_id": "ta-t2-bridging-uma-maheswari-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் உமா மகேஸ்வரி பற்றிய கூற்றுகளை ஆராய்ந்து தவறான கூற்றைக் கண்டறிக:"}], "options": {"A": "மதுரை மாவட்டத்தில் பிறந்து தேனி மாவட்டம் ஆண்டிப்பட்டியில் வாழ்ந்து வருகிறார்", "B": "நட்சத்திரங்களின் நடுவே, வெறும் பொழுது, கற்பாவை ஆகியவை இவரது கவிதைத் தொகுதிகள்", "C": "இவர் மரபு வெண்பாக்களை மட்டுமே இயற்றும் மரபுக் கவிஞர் ஆவார்", "D": "புதுக்கவிதை உலகில் மென்மையான உணர்வுகளைச் செதுக்கும் ஆற்றல் வாய்ந்தவர்"}, "explanation": "பாடநூல் பக்கம் 21: உமா மகேஸ்வரி புதுக்கவிதை, சிறுகதை, புதினம் எனப் பல தளங்களில் இயங்கி வரும் நவீனப் படைப்பாளர் ஆவார்; மரபு வெண்பாக்களை மட்டுமே இயற்றும் பழங்காலக் கவிஞர் அல்ல. எனவே 'C' தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements on poet Uma Maheswari and identify the INCORRECT statement:"}], "options": {"A": "Born in Madurai district, lives in Andipatti, Theni district", "B": "Natchathirangalin Naduve, Verum Pozhuthu, Karpavai are her poetry collections", "C": "She is a classical poet composing exclusively traditional Venbas", "D": "Renowned for sculpting tender sensibilities in contemporary free verse"}, "explanation": "Textbook page 21: Uma Maheswari writes free verse, short stories, and novels. She is not an exclusively traditional Venba metric poet. Option C is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "கவிஞர் உமா மகேஸ்வரி மதுரை மாவட்டத்தில் பிறந்தவர்; தற்போது தேனி மாவட்டம் ஆண்டிப்பட்டியில் வாழ்ந்து வருகிறார்.", "content_en": "Poet Uma Maheswari was born in Madurai district; currently resides in Andipatti, Theni district."}, {"id": "S2", "content_ta": "நட்சத்திரங்களின் நடுவே, வெறும் பொழுது, கற்பாவை ஆகியவை இவரது கவிதைத் தொகுதிகள்.", "content_en": "Natchathirangalin Naduve, Verum Pozhuthu, Karpavai are her poetry anthologies."}, {"id": "S3", "content_ta": "இவர் மரபு வெண்பாக்களை மட்டுமே இயற்றும் மரபுக் கவிஞர் ஆவார்.", "content_en": "She is a classical poet composing exclusively traditional Venbas."}, {"id": "S4", "content_ta": "பூத்தொடுத்தல் என்னும் கவிதையில் மலரின் மென்மைக்கும் நாரினுடைய உறுதிக்கும் இடையிலான அழகியலை வெளிப்படுத்தியுள்ளார்.", "content_en": "In 'Poothoduthal', she depicts the delicate tension between flower softness and thread strength."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 21, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bridging", "uma_maheswari", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q314", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-09-tamil-olir-idangal", "chapter_id": null, "topic_id": "ta-t2-bridging-oriental-library-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்த்திசை நூலகம் பற்றிய பின்வரும் கூற்றுகளில் தவறானது எது?"}], "options": {"A": "பொ.ஆ. 1869-இல் தொடங்கப்பட்ட வரலாற்றுச் சிறப்புமிக்க நூலகம்", "B": "தற்போது சென்னை அண்ணா நூற்றாண்டு நூலகத்தின் ஏழாம் தளத்தில் இயங்கி வருகிறது", "C": "மருத்துவம், வானியல், கணிதம் முதலான ஓலைச்சுவடிகள் இங்குப் பாதுகாக்கப்படுகின்றன", "D": "கீழ்த்திசை நூலகம் மதுரையில் உள்ள மீனாட்சியம்மன் கோவிலின் உட்பிரகாரத்தில் அமைந்துள்ளது"}, "explanation": "பாடநூல் பக்கம் 34: கீழ்த்திசை நூலகம் சென்னையில் தொடங்கப்பட்டு, தற்போது அண்ணா நூற்றாண்டு நூலகத்தின் 7-ஆம் தளத்தில் இயங்கி வருகிறது. மதுரையில் இல்லை. எனவே 'D' தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Which of the statements regarding the Oriental Manuscripts Library is INCORRECT?"}], "options": {"A": "Historic library established in 1869 CE", "B": "Currently functions on the 7th floor of Anna Centenary Library", "C": "Preserves palm-leaf manuscripts on medicine, astronomy, mathematics", "D": "Located in the inner precinct of Madurai Meenakshi Amman Temple"}, "explanation": "Page 34: Oriental Manuscripts Library is located in Chennai on the 7th floor of Anna Centenary Library, not in Madurai. Option D is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "கீழ்த்திசை நூலகம் பொ.ஆ. 1869-இல் தொடங்கப்பட்ட தொன்மையான நூலகமாகும்.", "content_en": "The Oriental Manuscripts Library was established in 1869 CE."}, {"id": "S2", "content_ta": "இந்நூலகம் தற்போது சென்னை அண்ணா நூற்றாண்டு நூலகத்தின் ஏழாம் தளத்தில் செயல்பட்டு வருகிறது.", "content_en": "It currently functions on the 7th floor of Anna Centenary Library in Chennai."}, {"id": "S3", "content_ta": "இங்குத் தமிழ், சமஸ்கிருதம், தெலுங்கு முதலான மொழிகளின் ஓலைச்சுவடிகள் பாதுகாக்கப்படுகின்றன.", "content_en": "Palm-leaf manuscripts of Tamil, Sanskrit, Telugu, etc. are preserved here."}, {"id": "S4", "content_ta": "கீழ்த்திசை நூலகம் மதுரையில் உள்ள மீனாட்சியம்மன் கோவிலின் உட்பிரகாரத்தில் அமைந்துள்ளது.", "content_en": "The Oriental Library is situated in the inner sanctum of Meenakshi Temple in Madurai."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 34, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bridging", "oriental_library", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q315", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-06-iyal1-aivu", "chapter_id": null, "topic_id": "ta-t2-bridging-six-noun-types-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அறுவகைப் பெயர்கள் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. பெயர்ச்சொற்கள் பொருள், இடம், காலம், சினை, பண்பு, தொழில் என ஆறு வகைப்படும்.\n2. கண், கை, இலை ஆகியவை சினைப்பெயருக்குரிய சான்றுகள்.\n3. தொழிற்பெயர் தொழிலைக் குறித்துக் காலம் காட்டாது நிற்கும்.\n4. செம்மை, வட்டம் ஆகியவை பண்புப்பெயருக்குரிய சான்றுகள்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 2 மட்டுமே சரி", "C": "2, 3, 4 மட்டுமே சரி", "D": "1, 3 மட்டுமே சரி"}, "explanation": "பாடநூல் பக்கம் 20-ல் உள்ள அறுவகைப் பெயர்களின் வரைவிலக்கணம் மற்றும் சான்றுகள் அனைத்தும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on the six classifications of nouns:\n1. Nouns classify into six categories: entity, place, time, limb/part, quality, action.\n2. Eye, hand, leaf are examples of Sinaippeyar.\n3. Verbal noun denotes an action without showing tense.\n4. Redness, circularity are examples of Panbuppeyar.\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1 and 2 only correct", "C": "2, 3, and 4 only correct", "D": "1 and 3 only correct"}, "explanation": "All four statements match textbook page 20 precisely. All are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "அறுவகைப் பெயர்கள்: பொருட்பெயர், இடப்பெயர், காலப்பெயர், சினைப்பெயர், பண்புப்பெயர், தொழிற்பெயர்.", "content_en": "Six types of nouns: Porutpeyar, Idappeyar, Kaalappeyar, Sinaippeyar, Panbuppeyar, Thozhirpeyar."}, {"id": "S2", "content_ta": "கண், கை, இலை, கிளை என்பவை உறுப்புகளைக் குறிக்கும் சினைப்பெயர்கள் ஆகும்.", "content_en": "Eye, hand, leaf, branch are Sinaippeyar denoting bodily/plant limbs."}, {"id": "S3", "content_ta": "தொழிற்பெயர் என்பது ஒரு தொழிலைக் குறிக்கும் பெயராக அமைந்து காலம் காட்டாது.", "content_en": "Verbal noun denotes an action and does not show tense."}, {"id": "S4", "content_ta": "செம்மை, நன்மை, வட்டம், சதுரம் என்பவை பண்புப் பெயர்கள் ஆகும்.", "content_en": "Semmai, Nanmai, Vattam, Sathuram are Panbuppeyar denoting attributes/shapes."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 20, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bridging", "grammar", "noun_types", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q316", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-01-azhiyaa-selvam", "chapter_id": null, "topic_id": "ta-t2-bridging-education-indestructible", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): கல்விச்செல்வம் பிறரால் திருட முடியாததும், மற்றவர்க்குக் கொடுக்கக் கொடுக்கக் குறையாததும் ஆகும்.\nகாரணம் (R): கல்வி மட்டுமே ஒருவனுக்கு அழியாத நிலையான செல்வமாக அமைந்து இறுதிவரை துணைநிற்கிறது."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றுக்கான சரியான விளக்கம்", "C": "கூற்று தவறு, காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "நாலடியார் & திருக்குறள் மையக் கருத்து: கல்வியே அழியாச் செல்வம் ('வைப்புழிக் கோட்படா வாய்ந்தீயிர்கேடில்லை', 'கேடில் விழுச்செல்வம் கல்வி'). கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): The wealth of learning cannot be stolen by thieves and does not diminish when bestowed on others.\nReason (R): Learning alone serves as eternal imperishable wealth accompanying a person throughout life."}], "options": {"A": "Assertion is true, Reason is false", "B": "Both Assertion and Reason are true, and Reason is the correct explanation", "C": "Assertion is false, Reason is true", "D": "Both Assertion and Reason are false"}, "explanation": "Core theme of Naaladiyaar & Kural: Learning is indestructible wealth. Both A and R are true and R explains A."}}, "question_data": {"assertion": "கல்விச்செல்வம் பிறரால் திருட முடியாததும், மற்றவர்க்குக் கொடுக்கக் கொடுக்கக் குறையாததும் ஆகும்.", "reason": "கல்வி மட்டுமே ஒருவனுக்கு அழியாத நிலையான செல்வமாக அமைந்து இறுதிவரை துணைநிற்கிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bridging", "naaladiyaar", "thirukkural", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q317", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-07-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-bridging-cave-art-tools-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): பழங்கால மனிதர்கள் குகைச் சுவர்களில் வேட்டைக்குப் போக முடியாதவர்கள் ஓவியங்களை வரைந்து பார்த்தனர்.\nகாரணம் (R): பழங்கால மனிதர்கள் எண்ணெய் வண்ணங்களையும் நவீன தூரிகைகளையும் பயன்படுத்தி நுணுக்கமான நவீன ஓவியங்களை வரைந்தனர்."}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "கூற்று சரி: பாடநூல் பக்கம் 22-ல் வேட்டைக்குச் செல்ல இயலாதவர்கள் குகையில் தங்கி ஓவியம் வரைந்ததாகக் குறிப்பிடப்பட்டுள்ளது. காரணம் தவறு: அவர்கள் செம்மண் துகள்கள், தாவரச் சாறுகள் மற்றும் சிவப்புக்கற்களைப் பயன்படுத்தினர்; நவீன வண்ணங்களையும் தூரிகைகளையும் அல்ல."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Ancient humans drew scenes on cave walls, particularly by those unable to participate in hunting expeditions.\nReason (R): Ancient humans utilized oil paints and modern brushes to produce intricate modern paintings."}], "options": {"A": "Both Assertion and Reason are true", "B": "Assertion is false, Reason is true", "C": "Assertion (A) is true, but Reason (R) is false", "D": "Both Assertion and Reason are false"}, "explanation": "Assertion is true as per page 22. Reason is absurdly false: ancient cave dwellers used red ochre and plant dyes, not modern oil paints and brushes."}}, "question_data": {"assertion": "பழங்கால மனிதர்கள் குகைச் சுவர்களில் வேட்டைக்குப் போக முடியாதவர்கள் ஓவியங்களை வரைந்து பார்த்தனர்.", "reason": "பழங்கால மனிதர்கள் எண்ணெய் வண்ணங்களையும் நவீன தூரிகைகளையும் பயன்படுத்தி நுணுக்கமான நவீன ஓவியங்களை வரைந்தனர்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 22, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bridging", "cave_art", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q318", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-09-tamil-olir-idangal", "chapter_id": null, "topic_id": "ta-t2-bridging-kanniyakumari-statue-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): கன்னியாகுமரி திருவள்ளுவர் சிலையின் பீடத்தின் உட்புறச் சுவரில் அதிகாரத்திற்கு ஒரு குறள் வீதம் 133 குறள்கள் செதுக்கப்பட்டுள்ளன.\nகாரணம் (R): அறத்துப்பால், பொருட்பால், இன்பத்துப்பால் ஆகிய மூன்று பால்களின் தமிழ்க் குறள்களும் ஆங்கில மொழிபெயர்ப்புடன் அங்குப் பொறிக்கப்பட்டுள்ளன."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று, காரணம் இரண்டும் தவறு", "D": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது"}, "explanation": "பாடநூல் பக்கம் 36: மண்டபத்தின் உட்புறச் சுவரில் அதிகாரத்திற்கு ஒரு குறள் வீதம் 133 குறட்பாக்கள் தமிழிலும் ஆங்கிலத்திலும் செதுக்கப்பட்டுள்ளன. கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Inside the pedestal of Kanniyakumari Thiruvalluvar statue, 133 select Kurals (one per chapter) are inscribed.\nReason (R): Verses from all three divisions are engraved there in Tamil alongside their English translations."}], "options": {"A": "Assertion is true, Reason is false", "B": "Assertion is false, Reason is true", "C": "Both Assertion and Reason are false", "D": "Both Assertion and Reason are true, and Reason is the correct explanation"}, "explanation": "Both A and R are verified from page 36: 133 Kurals are engraved in Tamil and English inside the pedestal hall."}}, "question_data": {"assertion": "கன்னியாகுமரி திருவள்ளுவர் சிலையின் பீடத்தின் உட்புறச் சுவரில் அதிகாரத்திற்கு ஒரு குறள் வீதம் 133 குறள்கள் செதுக்கப்பட்டுள்ளன.", "reason": "அறத்துப்பால், பொருட்பால், இன்பத்துப்பால் ஆகிய மூன்று பால்களின் தமிழ்க் குறள்களும் ஆங்கில மொழிபெயர்ப்புடன் அங்குப் பொறிக்கப்பட்டுள்ளன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bridging", "thiruvalluvar_statue", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q319", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-pyq-thozhirpeyar-action-distinction", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'வருதல்' என்பது தொழிற்பெயர்; 'வந்தவன்' என்பது வினையாலணையும் பெயர்.\nகாரணம் (R): 'வருதல்' என்பது வருகின்ற தொழிலின் பெயரைக் குறிக்கிறது; 'வந்தவன்' என்பது அத்தொழிலைச் செய்த கருத்தாவைக் குறிக்கிறது."}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றுக்கான சரியான விளக்கம்", "B": "கூற்று சரி, காரணம் தவறு", "C": "கூற்று தவறு, காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் பக்கம் 38 வேறுபாடு: தொழிலைக் குறிப்பது தொழிற்பெயர் (வருதல்); அத்தொழிலைச் செய்தவரைக் குறிப்பது வினையாலணையும் பெயர் (வந்தவன்). கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'Varuthal' is a verbal noun; 'Vanthavan' is a participial noun.\nReason (R): 'Varuthal' denotes the action of coming; 'Vanthavan' denotes the person who performed the action."}], "options": {"A": "Both Assertion and Reason are true, and Reason is the correct explanation", "B": "Assertion is true, Reason is false", "C": "Assertion is false, Reason is true", "D": "Both Assertion and Reason are false"}, "explanation": "Both A and R are true as per page 38, and R directly explains why one is a verbal noun and the other a participial noun."}}, "question_data": {"assertion": "'வருதல்' என்பது தொழிற்பெயர்; 'வந்தவன்' என்பது வினையாலணையும் பெயர்.", "reason": "'வருதல்' என்பது வருகின்ற தொழிலின் பெயரைக் குறிக்கிறது; 'வந்தவன்' என்பது அத்தொழிலைச் செய்த கருத்தாவைக் குறிக்கிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bridging", "grammar", "thozhirpeyar", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q320", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-11-thirukkural", "chapter_id": null, "topic_id": "ta-t2-bridging-crow-kinship-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): காக்கையானது தனக்குக் கிடைத்த உணவை மறைக்காமல் தன் சுற்றத்தாரை அழைத்து கூடி உண்ணும்.\nகாரணம் (R): சுற்றத்தாரைத் தழுவி வாழும் அத்தகைய பண்புடையவர்க்கே ஆக்கமும் செல்வமும் பெருகும் என்று வள்ளுவர் அறிவுறுத்துகிறார்."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "C": "கூற்று தவறு, காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "குறள் (குறள் 527): 'காக்கை கரவா கரைந்துண்ணும் ஆக்கமும் அன்னநீ ரார்க்கே உள'. கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): The crow does not conceal food it finds, but caws and gathers its kin to eat together.\nReason (R): Valluvar teaches that prosperity increases only for those possessing such kinship-cherishing virtues."}], "options": {"A": "Assertion is true, Reason is false", "B": "Both Assertion and Reason are true, and Reason is the correct explanation", "C": "Assertion is false, Reason is true", "D": "Both Assertion and Reason are false"}, "explanation": "Kural 527: Both A and R are true and R provides the moral philosophy of the assertion."}}, "question_data": {"assertion": "காக்கையானது தனக்குக் கிடைத்த உணவை மறைக்காமல் தன் சுற்றத்தாரை அழைத்து கூடி உண்ணும்.", "reason": "சுற்றத்தாரைத் தழுவி வாழும் அத்தகைய பண்புடையவர்க்கே ஆக்கமும் செல்வமும் பெருகும் என்று வள்ளுவர் அறிவுறுத்துகிறார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bridging", "thirukkural", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q321", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-05-ilakkiyavagai-sorkal", "chapter_id": null, "topic_id": "ta-t2-bridging-tharsamam-vadasol-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'விடம்' என்னும் சொல் வடமொழியில் உள்ளவாறே எவ்வித மாற்றமும் இன்றித் தமிழில் வந்துள்ள தற்சமச் சொல்லாகும்.\nகாரணம் (R): வடமொழிச் சொற்கள் தமிழில் பயன்படும்போது எப்போதுமே கிரந்த எழுத்துகளுடனே எழுதப்பட வேண்டும்."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று, காரணம் இரண்டும் சரி", "C": "கூற்று, காரணம் இரண்டும் தவறு", "D": "கூற்று தவறு, காரணம் சரி"}, "explanation": "பாடநூல் பக்கம் 18:\n1. 'விடம்' (விஷம் -> விடம்) என்பது திரிந்து வந்த 'தற்பவம்' ஆகும் (தற்சமம் அன்று; கமலம், அலங்காரம் என்பவையே தற்சமம்). கூற்று தவறு.\n2. தற்பவச் சொற்கள் தூய தமிழ் எழுத்துகளாலேயே எழுதப்படும்; கிரந்த எழுத்துகளுடன் எழுதப்பட வேண்டும் என்பது தவறு.\nஎனவே கூற்று, காரணம் இரண்டும் தவறு!"}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'Vidam' is a Tharsamam word retained in Tamil without any modification from Sanskrit.\nReason (R): Sanskrit loanwords must always be written using Grantha characters in Tamil."}], "options": {"A": "Assertion is true, Reason is false", "B": "Both Assertion and Reason are true", "C": "Both Assertion and Reason are false", "D": "Assertion is false, Reason is true"}, "explanation": "'Vidam' is Tharpavam, not Tharsamam. Tharpavam replaces Grantha with native Tamil letters. Both A and R are completely false."}}, "question_data": {"assertion": "'விடம்' என்னும் சொல் வடமொழியில் உள்ளவாறே எவ்வித மாற்றமும் இன்றித் தமிழில் வந்துள்ள தற்சமச் சொல்லாகும்.", "reason": "வடமொழிச் சொற்கள் தமிழில் பயன்படும்போது எப்போதுமே கிரந்த எழுத்துகளுடனே எழுதப்பட வேண்டும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bridging", "grammar", "vadachol", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q322", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-01-azhiyaa-selvam", "chapter_id": null, "topic_id": "ta-t2-bridging-master-authors-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "7-ஆம் வகுப்பு இரண்டாம் பருவத்தின் முதன்மைப் பாடங்களையும் அவற்றின் படைப்பாளர்களையும் பொருத்துக:\n(a) நாலடியார் - 1. உமா மகேஸ்வரி\n(b) தேயிலைத் தோட்டப் பாட்டு - 2. சுப்ரபாரதிமணியன்\n(c) பூத்தொடுத்தல் - 3. சமண முனிவர்கள்\n(d) பள்ளி மறுதிறப்பு - 4. பாரத மக்களின் பரிதாபச் சிந்து"}], "options": {"A": "a-1, b-4, c-2, d-3", "B": "a-3, b-1, c-4, d-2", "C": "a-4, b-3, c-1, d-2", "D": "a-3, b-4, c-1, d-2"}, "explanation": "சரியான பொருத்தம்:\nநாலடியார் = சமண முனிவர்கள் (3)\nதேயிலைத் தோட்டப் பாட்டு = பாரத மக்களின் பரிதாபச் சிந்து (4)\nபூத்தொடுத்தல் = உமா மகேஸ்வரி (1)\nபள்ளி மறுதிறப்பு = சுப்ரபாரதிமணியன் (2).\nவரிசை: 3, 4, 1, 2."}, "en": {"blocks": [{"type": "text", "content": "Match the core lessons of Term 2 with their creators/sources:\n(a) Naaladiyaar - 1. Uma Maheswari\n(b) Theyilai Thottap Paattu - 2. Subrabharathimanian\n(c) Poothoduthal - 3. Jain Ascetics\n(d) Palli Maruthirappu - 4. Parithaapach Chinthu"}], "options": {"A": "a-1, b-4, c-2, d-3", "B": "a-3, b-1, c-4, d-2", "C": "a-4, b-3, c-1, d-2", "D": "a-3, b-4, c-1, d-2"}, "explanation": "Correct alignment: Naaladiyaar = 3, Theyilai Thottap Paattu = 4, Poothoduthal = 1, Palli Maruthirappu = 2. Sequence: 3, 4, 1, 2."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "நாலடியார்", "content_en": "Naaladiyaar"}, {"id": "L2", "content_ta": "தேயிலைத் தோட்டப் பாட்டு", "content_en": "Theyilai Thottap Paattu"}, {"id": "L3", "content_ta": "பூத்தொடுத்தல்", "content_en": "Poothoduthal"}, {"id": "L4", "content_ta": "பள்ளி மறுதிறப்பு", "content_en": "Palli Maruthirappu"}], "right": [{"id": "R1", "content_ta": "உமா மகேஸ்வரி", "content_en": "Uma Maheswari"}, {"id": "R2", "content_ta": "சுப்ரபாரதிமணியன்", "content_en": "Subrabharathimanian"}, {"id": "R3", "content_ta": "சமண முனிவர்கள்", "content_en": "Jain Ascetics"}, {"id": "R4", "content_ta": "பாரத மக்களின் பரிதாபச் சிந்து", "content_en": "Parithaapach Chinthu"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bridging", "master_synthesis", "matching"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q323", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-07-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-bridging-art-types-specialty-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் ஓவிய வகைகளையும் அவற்றின் வரலாற்றுச் சான்றுகளையும் பொருத்துக:\n(a) குகை ஓவியங்கள் - 1. கோட்டோவியங்கள் (செம்மண் சாயம்)\n(b) சுவர் ஓவியங்கள் - 2. சித்தன்னவாசல், தஞ்சைப் பெரிய கோவில்\n(c) ஓலைச்சுவடி ஓவியங்கள் - 3. தஞ்சை சரசுவதி மகால் நூலகம்\n(d) நாட்காட்டி ஓவியங்கள் - 4. பஜார் பெயிண்டிங் (கொண்டையராஜு)"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-4, b-3, c-2, d-1", "D": "a-1, b-3, c-2, d-4"}, "explanation": "பாடநூல் பக்கங்கள் 22-25:\nகுகை ஓவியம் = செம்மண் சாயம் கோட்டோவியம் (1)\nசுவர் ஓவியம் = சித்தன்னவாசல், தஞ்சைப் பெரிய கோவில் (2)\nஓலைச்சுவடி ஓவியம் = தஞ்சை சரசுவதி மகால் நூலகம் (3)\nநாட்காட்டி ஓவியம் = பஜார் பெயிண்டிங், கொண்டையராஜு (4).\nநேரடிப் பொருத்தம்: 1, 2, 3, 4."}, "en": {"blocks": [{"type": "text", "content": "Match the Tamil art mediums with their historic sites and attributes:\n(a) Cave paintings - 1. Line drawings in red ochre\n(b) Murals - 2. Sittannavasal, Thanjavur Temple\n(c) Palm-leaf paintings - 3. Thanjavur Saraswathi Mahal\n(d) Calendar paintings - 4. Bazaar Painting (Kondaiyaraju)"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-4, b-3, c-2, d-1", "D": "a-1, b-3, c-2, d-4"}, "explanation": "Direct alignment: Cave = 1, Murals = 2, Palm-leaf = 3, Calendar = 4. Sequence: 1, 2, 3, 4."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "குகை ஓவியங்கள்", "content_en": "Cave paintings"}, {"id": "L2", "content_ta": "சுவர் ஓவியங்கள்", "content_en": "Mural paintings"}, {"id": "L3", "content_ta": "ஓலைச்சுவடி ஓவியங்கள்", "content_en": "Palm-leaf paintings"}, {"id": "L4", "content_ta": "நாட்காட்டி ஓவியங்கள்", "content_en": "Calendar paintings"}], "right": [{"id": "R1", "content_ta": "கோட்டோவியங்கள் (செம்மண் சாயம்)", "content_en": "Line drawings (Red ochre)"}, {"id": "R2", "content_ta": "சித்தன்னவாசல், தஞ்சைப் பெரிய கோவில்", "content_en": "Sittannavasal, Thanjavur Temple"}, {"id": "R3", "content_ta": "தஞ்சை சரசுவதி மகால் நூலகம்", "content_en": "Thanjavur Saraswathi Mahal"}, {"id": "R4", "content_ta": "பஜார் பெயிண்டிங் (கொண்டையராஜு)", "content_en": "Bazaar Painting (Kondaiyaraju)"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 22, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["bridging", "art_history", "matching"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at