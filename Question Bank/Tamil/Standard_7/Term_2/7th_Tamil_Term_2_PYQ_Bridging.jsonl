{"id": "7th-t2-pyq-q280", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-01-azhiyaa-selvam", "chapter_id": null, "topic_id": "ta-t2-pyq-direct-theylai-thottam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆங்கிலேயர் ஆட்சிக்காலத்தில் தமிழர்கள் தேயிலைத் தோட்டத் தொழிலாளர்களாக இடம்பெயர்ந்த துயரத்தை விவரிக்கும் பாடல் எது?"}], "options": {"A": "கப்பலோட்டிய பாட்டு", "B": "காவடிச்சிந்து", "C": "தேயிலைத் தோட்டப் பாட்டு", "D": "உழவர் பாட்டு"}, "explanation": "பாடநூல் பக்கம் 5: தேயிலைத் தோட்டப் பாட்டு (பாரத மக்களின் பரிதாபச் சிந்து) ஆங்கிலேயர் ஆட்சியில் தமிழர்கள் பட்ட பெருந்துயரத்தை விவரிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "Which folk song vividly recounts the misery of Tamil plantation labourers in tea estates under British rule?"}], "options": {"A": "Kappalottiya Paattu", "B": "Kaavadichinthu", "C": "Theyilai Thottap Paattu", "D": "Uzhavar Paattu"}, "explanation": "Page 5: 'Theyilai Thottap Paattu' describes the plight of tea estate labourers."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 5, "chapter": 