// ==============================================================================
// பகுதி 2: உயர்நிலை இலக்கணப் பொறிகள் & செய்யுள் யாப்பியல் (Advanced Grammar Traps & Metrics) [Q281 - Q308]
// சொல் வகைகள், இலக்கியவகைச் சொற்கள் (இயற்சொல், திரிசொல், திசைச்சொல், வடசொல்), தொழிற்பெயர் வகைகள் (விகுதி பெற்றவை, முதனிலை, முதனிலை திரிந்தது, எதிர்மறை), தொழிற்பெயர் vs வினையாலணையும் பெயர், மாத்திரை அளவுகள், புணர்ச்சி விதிகள், அணி இலக்கணம்
// ==============================================================================
{"id": "7th-t2-pyq-q281", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-05-ilakkiyavagai-sorkal", "chapter_id": null, "topic_id": "ta-t2-pyq-iyarsol-characteristics-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயற்சொல் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. எல்லார்க்கும் எளிதில் பொருள் விளங்கும் சொல்லாக அமைவது இயற்சொல்.\n2. இது பெயர், வினை, இடை, உரி என நான்கு வகைகளில் வரும்.\n3. மண், பொன் என்பவை பெயர் இயற்சொல்; நடந்தான், வந்தான் என்பவை வினை இயற்சொல்.\n4. இயற்சொற்கள் கற்றவர்களுக்கு மட்டுமே விளங்கக்கூடிய கடினமான சொற்கள் ஆகும்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 2, 3 மட்டுமே சரி; 4 தவறு", "C": "1, 3 மட்டுமே சரி; 2, 4 தவறு", "D": "2, 4 மட்டுமே சரி; 1, 3 தவறு"}, "explanation": "கற்றவர்களுக்கு மட்டுமே விளங்கக்கூடிய சொற்கள் 'திரிசொற்கள்' எனப்படும்; இயற்சொற்கள் எல்லோருக்கும் எளிதில் விளங்குபவை. எனவே கூற்று 4 தவறு. 1, 2, 3 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements regarding Iyarsol:\n1. Words easily understood by all are Iyarsol.\n2. It occurs in four forms: noun, verb, particle, and qualitative.\n3. Mann, Pon are noun iyarsol; Nadanthan, Vanthan are verb iyarsol.\n4. Iyarsol are dense words comprehensible only to scholars.\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1, 2, and 3 only correct; 4 incorrect", "C": "1 and 3 only correct; 2 and 4 incorrect", "D": "2 and 4 only correct; 1 and 3 incorrect"}, "explanation": "Words comprehensible only to scholars are Thirisorkal, not Iyarsorkal. Statement 4 is false. 1, 2, 3 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "எல்லார்க்கும் எளிதில் பொருள் விளங்கும் வகையில் அமைந்த சொற்கள் இயற்சொற்கள் எனப்படும்.", "content_en": "Words whose meanings are easily understood by all are Iyarsorkal."}, {"id": "S2", "content_ta": "இயற்சொல் பெயர் இயற்சொல், வினை இயற்சொல், இடை இயற்சொல், உரி இயற்சொல் என நான்கு வகைப்படும்.", "content_en": "Iyarsol is classified into four types: noun, verb, particle, and qualitative."}, {"id": "S3", "content_ta": "மண், பொன் என்பவை பெயர் இயற்சொற்கள்; நடந்தான், வந்தான் என்பவை வினை இயற்சொற்கள் ஆகும்.", "content_en": "Mann, Pon are noun iyarsol; Nadanthan, Vanthan are verbal iyarsol."}, {"id": "S4", "content_ta": "இயற்சொற்கள் கற்றவர்களுக்கு மட்டுமே விளங்கக்கூடிய கடினமான இலக்கணச் சொற்கள் ஆகும்.", "content_en": "Iyarsorkal are difficult grammatical words understandable only to scholars."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 17, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4 / Group 2", "exam_name": "TNPSC Combined Civil Services", "year": "2014-2024", "paper": "General Tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pyq", "iyarsol", "grammar", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q282", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-05-ilakkiyavagai-sorkal", "chapter_id": null, "topic_id": "ta-t2-pyq-thirisol-characteristics-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திரிசொல் பற்றிய கூற்றுகளை ஆராய்ந்து தவறான கூற்றைக் கண்டறிக:"}], "options": {"A": "கற்றவர்களுக்கு மட்டுமே விளங்குவதாகவும் இலக்கியங்களில் வருவதுமாகவும் அமைவது திரிசொல்", "B": "திரிசொற்கள் பெயர், வினை, இடை, உரி என நான்கு வகைகளில் வரும்", "C": "திரிசொற்கள் அனைத்தும் சமஸ்கிருதத்திலிருந்து மட்டுமே தமிழுக்கு வந்த கடன் சொற்கள் ஆகும்", "D": "ஒரு பொருள் குறித்த பல திரிசொல், பல பொருள் குறித்த ஒரு திரிசொல் எனவும் இவை பாகுபடுத்தப்படும்"}, "explanation": "வடமொழியிலிருந்து தமிழுக்கு வரும் சொற்கள் 'வடசொற்கள்' எனப்படும். திரிசொற்கள் என்பவை தமிழின் இலக்கியச் சொற்கள் ஆகும் (எ.கா: வங்கம், நவிலல்). எனவே 'C' முற்றிலும் தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Thirisol and identify the INCORRECT statement:"}], "options": {"A": "Occurs in literature and understood only by the learned", "B": "Occurs in four grammatical classes: noun, verb, particle, qualitative", "C": "All Thirisorkal are loanwords strictly from Sanskrit", "D": "Classified into single-meaning/multiple-words and multiple-meaning/single-word"}, "explanation": "Loanwords from Sanskrit are Vadasorkal. Thirisorkal are pure classical Tamil literary words. Option C is entirely false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "கற்றவர்களுக்கு மட்டுமே விளங்குவதாகவும், இலக்கியங்களில் மட்டுமே பயின்று வருவதாகவும் அமையும் சொற்கள் திரிசொற்கள் ஆகும்.", "content_en": "Words understood only by the educated and occurring primarily in literature are Thirisorkal."}, {"id": "S2", "content_ta": "திரிசொற்களும் பெயர், வினை, இடை, உரி என நான்கு வகைப்படும்.", "content_en": "Thirisorkal also divide into noun, verb, particle, and qualitative types."}, {"id": "S3", "content_ta": "ஒரு பொருள் குறித்த பல திரிசொற்கள் மற்றும் பல பொருள் குறித்த ஒரு திரிசொல் எனவும் இவை வகைப்படுத்தப்படும்.", "content_en": "They are also categorized as multiple thirisol for one meaning, and one thirisol for multiple meanings."}, {"id": "S4", "content_ta": "திரிசொற்கள் அனைத்தும் சமஸ்கிருதத்திலிருந்து மட்டுமே தமிழுக்கு வந்த கடன் சொற்கள் ஆகும்.", "content_en": "All Thirisorkal are loanwords entering Tamil strictly from Sanskrit."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4 / Group 2", "exam_name": "TNPSC Combined Civil Services", "year": "2014-2024", "paper": "General Tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pyq", "thirisol", "grammar", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q283", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-pyq-thozhirpeyar-core-rules-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொழிற்பெயரின் இலக்கண விதிகள் பற்றிய பின்வரும் கூற்றுகளில் தவறானது எது?"}], "options": {"A": "தொழிற்பெயர் எண், இடம், காலம், பால் ஆகியவற்றைக் காட்டாது", "B": "தொழிற்பெயர் படர்க்கை இடத்திற்கு மட்டுமே உரியது", "C": "தொழிற்பெயர் ஒரு தொழிலின் பெயராக அமையும்", "D": "தொழிற்பெயர் எப்போதும் முக்காலங்களையும் வெளிப்படையாகக் காட்டும்"}, "explanation": "பாடநூல் பக்கம் 37 இலக்கண விதி: தொழிற்பெயர் காலம் காட்டாது. காலம் காட்டுவது 'வினையாலணையும் பெயர்' ஆகும். எனவே 'D' தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Which statement regarding the grammatical principles of verbal nouns is INCORRECT?"}], "options": {"A": "Does not denote number, person, tense, or gender", "B": "Belongs strictly to third person", "C": "Functions as the name of an action", "D": "Always explicitly indicates the three tenses"}, "explanation": "Textbook rule on page 37 explicitly affirms: Verbal nouns do NOT denote tense. Participial nouns indicate tense. Hence D is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "தொழிற்பெயர் எண், இடம், காலம், பால் ஆகியவற்றைக் காட்டாது.", "content_en": "Verbal nouns do not indicate number, person, tense, or gender."}, {"id": "S2", "content_ta": "தொழிற்பெயர் படர்க்கை இடத்திற்கு மட்டுமே உரியது.", "content_en": "Verbal nouns are confined solely to the third person (Padarkkai)."}, {"id": "S3", "content_ta": "தொழிற்பெயர் ஒரு செயலின் (வினையின்) பெயராக மட்டுமே அமையும்.", "content_en": "A verbal noun functions strictly as the name of an action."}, {"id": "S4", "content_ta": "தொழிற்பெயர் எப்போதும் இறந்த காலம், நிகழ்காலம், எதிர்காலம் ஆகிய முக்காலங்களையும் வெளிப்படையாகக் காட்டும்.", "content_en": "Verbal nouns always explicitly denote past, present, and future tenses."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4 / Group 2", "exam_name": "TNPSC Combined Civil Services", "year": "2014-2024", "paper": "General Tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pyq", "thozhirpeyar", "grammar", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q284", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-08-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-pyq-muthannilai-types-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முதனிலைத் தொழிற்பெயர் மற்றும் முதனிலை திரிந்த தொழிற்பெயர் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. முதனிலை விகுதி பெறாமல் தொழிலை உணர்த்துவது முதனிலைத் தொழிற்பெயர்.\n2. 'இடி', 'கொதி' என்பவை முதனிலைத் தொழிற்பெயர்களுக்குச் சான்றுகள்.\n3. முதனிலை திரிந்து தொழிலை உணர்த்துவது முதனிலை திரிந்த தொழிற்பெயர்.\n4. 'பேறு', 'கேடு' என்பவை முதனிலை திரிந்த தொழிற்பெயர்களுக்குச் சான்றுகள்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரியானவை (1, 2, 3, 4)", "B": "1, 2 மட்டுமே சரி", "C": "3, 4 மட்டுமே சரி", "D": "1, 3 மட்டுமே சரி"}, "explanation": "பாடநூல் பக்கம் 37 & 38-ல் உள்ளபடி இடி, கொதி முதனிலைத் தொழிற்பெயர்களுக்கும், பெறு->பேறு, கெடு->கேடு முதனிலை திரிந்த தொழிற்பெயர்களுக்கும் மிகச்சரியான சான்றுகள். நான்கு கூற்றுகளும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on root verbal nouns and lengthened root verbal nouns:\n1. Root denoting action without suffix is Muthannilai Thozhirpeyar.\n2. 'Idi' and 'Kothi' are examples of root verbal nouns.\n3. Root modified to denote action is Muthannilai Thirintha Thozhirpeyar.\n4. 'Paeru' and 'Kedu' are examples of lengthened root verbal nouns.\nWhich statements are correct?"}], "options": {"A": "All statements are correct (1, 2, 3, 4)", "B": "1 and 2 only correct", "C": "3 and 4 only correct", "D": "1 and 3 only correct"}, "explanation": "All four statements perfectly describe textbook definitions and examples from pages 37-38. All are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "முதனிலை எவ்வகை மாற்றமும் பெறாமல் தொழிலை உணர்த்துவது 'முதனிலைத் தொழிற்பெயர்' ஆகும்.", "content_en": "When the root signifies an action without any modification, it is Muthannilai Thozhirpeyar."}, {"id": "S2", "content_ta": "வானில் 'இடி' இடித்தது, சோறு 'கொதி' வந்தது ஆகிய தொடர்களில் இடி, கொதி என்பவை முதனிலைத் தொழிற்பெயர்கள்.", "content_en": "In 'idi' and 'kothi', they function as root verbal nouns."}, {"id": "S3", "content_ta": "முதனிலை திரிந்து (நீண்டு) தொழிலை உணர்த்துவது 'முதனிலை திரிந்த தொழிற்பெயர்' ஆகும்.", "content_en": "When the root undergoes phonetic lengthening to denote an action, it is Muthannilai Thirintha Thozhirpeyar."}, {"id": "S4", "content_ta": "தமிழ் கற்பது எங்கள் 'பேறு' என்பதில் 'பேறு' என்பது முதனிலை திரிந்த தொழிற்பெயர் ஆகும்.", "content_en": "In 'Paeru', it functions as a lengthened root verbal noun (from 'peru')."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4 / Group 2", "exam_name": "TNPSC Combined Civil Services", "year": "2014-2024", "paper": "General Tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pyq", "thozhirpeyar", "grammar", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q285", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-08-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-pyq-vinaiyaalanaiyum-rules-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வினையாலணையும் பெயர் பற்றிய கூற்றுகளை ஆராய்க:\n1. தொழிலைச் செய்த கருத்தாவைக் குறிப்பது வினையாலணையும் பெயர்.\n2. இது மூவிடங்களிலும் (தன்மை, முன்னிலை, படர்க்கை) வரும்.\n3. இது முக்காலத்தையும் காட்டும்.\n4. 'பாடியவள்', 'படித்தவர்' என்பவை தொழிற்பெயருக்குரிய சான்றுகள் ஆகும்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 2, 3 மட்டுமே சரி; 4 தவறு", "C": "1, 3 மட்டுமே சரி; 2, 4 தவறு", "D": "2, 4 மட்டுமே சரி; 1, 3 தவறு"}, "explanation": "'பாடியவள்', 'படித்தவர்' என்பவை தொழிலைச் செய்தவரைக் குறிப்பதால் 'வினையாலணையும் பெயர்கள்' ஆகும்; தொழிற்பெயர்கள் அல்ல (பாடுதல், படித்தல் என்பவையே தொழிற்பெயர்கள்). எனவே கூற்று 4 தவறு. 1, 2, 3 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Participial nouns:\n1. Denotes the agent performing the act.\n2. Occurs in all three persons.\n3. Indicates all three tenses.\n4. 'Paadiyaval' and 'Padithavar' are examples of verbal nouns.\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1, 2, and 3 only correct; 4 incorrect", "C": "1 and 3 only correct; 2 and 4 incorrect", "D": "2 and 4 only correct; 1 and 3 incorrect"}, "explanation": "'Paadiyaval' and 'Padithavar' are Participial nouns denoting the doer, not verbal nouns. Statement 4 is false. 1, 2, 3 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "வினையாலணையும் பெயர் தொழிலைச் செய்த கருத்தாவைக் குறிக்கும்.", "content_en": "Participial noun denotes the person/agent who performed the action."}, {"id": "S2", "content_ta": "வினையாலணையும் பெயர் தன்மை, முன்னிலை, படர்க்கை ஆகிய மூவிடங்களிலும் வரும்.", "content_en": "Participial noun occurs across all three grammatical persons."}, {"id": "S3", "content_ta": "வினையாலணையும் பெயர் இறந்த காலம், நிகழ்காலம், எதிர்காலம் ஆகிய முக்காலங்களையும் காட்டும்.", "content_en": "Participial noun indicates all three tenses."}, {"id": "S4", "content_ta": "பாடியவள், படித்தவர் என்பவை தொழிற்பெயருக்குச் சான்றுகள் ஆகும்.", "content_en": "Paadiyaval and Padithavar are examples of verbal nouns."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 38, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4 / Group 2", "exam_name": "TNPSC Combined Civil Services", "year": "2014-2024", "paper": "General Tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pyq", "grammar", "vinaiyaalanaiyum_peyar", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q286", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-05-ilakkiyavagai-sorkal", "chapter_id": null, "topic_id": "ta-t2-pyq-tharsamam-tharpavam-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வடசொற்கள் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. வடமொழி எழுத்துகள் தமிழில் வடசொற்களில் கையாளப்படுகின்றன.\n2. வடமொழிச் சொற்களைத் தமிழ் எழுத்துகளால் திரித்து எழுதுவது தற்பவம் எனப்படும்.\n3. 'இலக்குமி', 'விடம்' என்பவை தற்சமத்திற்குச் சான்றுகளாகும்.\n4. 'கமலம்', 'அலங்காரம்' என்பவை தற்சமத்திற்குரிய சான்றுகளாகும்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 2 மட்டுமே சரி", "C": "1, 2, 4 மட்டுமே சரி; 3 தவறு", "D": "2, 3 மட்டுமே சரி"}, "explanation": "'இலக்குமி', 'விடம்' என்பவை 'தற்பவம்' ஆகும் (தற்சமம் அன்று). எனவே கூற்று 3 தவறு. 1, 2, 4 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Sanskrit loanwords (Vadasorkal):\n1. Grantha letters are utilized in Tamil for Sanskrit loanwords.\n2. Modifying Sanskrit words phonetically using Tamil letters is Tharpavam.\n3. 'Ilakkumi' and 'Vidam' are examples of Tharsamam.\n4. 'Kamalam' and 'Alangaaram' are examples of Tharsamam.\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1 and 2 only correct", "C": "1, 2, and 4 only correct; 3 incorrect", "D": "2 and 3 only correct"}, "explanation": "'Ilakkumi' and 'Vidam' are Tharpavam, not Tharsamam. Statement 3 is false. 1, 2, and 4 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "வடமொழி எழுத்துகளாகிய ஜ, ஷ, ஸ, ஹ, க்ஷ முதலானவை தமிழில் வடசொற்களில் பயின்று வருகின்றன.", "content_en": "Grantha letters ja, sha, sa, ha, ksha are used in Tamil for Sanskrit words."}, {"id": "S2", "content_ta": "வடமொழிச் சொல்லைத் தமிழ் எழுத்துகளால் மாற்றி எழுதுவது தற்பவம் எனப்படும்.", "content_en": "Transcribing Sanskrit words using native Tamil letters is Tharpavam."}, {"id": "S3", "content_ta": "'லக்ஷ்மி' என்பதை 'இலக்குமி' என்றும், 'விஷம்' என்பதை 'விடம்' என்றும் எழுதுவது தற்சமத்திற்குச் சான்றுகளாகும்.", "content_en": "Writing 'Lakshmi' as 'Ilakkumi' and 'Visham' as 'Vidam' are examples of Tharsamam."}, {"id": "S4", "content_ta": "'கமலம்', 'அலங்காரம்' என்பவை தற்சமத்திற்குரிய சான்றுகளாகும்.", "content_en": "'Kamalam' and 'Alangaaram' are examples of Tharsamam."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4 / Group 2", "exam_name": "TNPSC Combined Civil Services", "year": "2014-2024", "paper": "General Tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pyq", "grammar", "vadachol", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q287", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-pyq-ethirmarai-thozhirpeyar-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எதிர்மறைத் தொழிற்பெயர் பற்றிய கூற்றுகளில் தவறானது எது?"}], "options": {"A": "எதிர்மறைப் பொருளில் வருவது எதிர்மறைத் தொழிற்பெயர்", "B": "நடவாமை, கொல்லாமை என்பவை இதற்குச் சான்றுகள்", "C": "இவை வினையெதிர்ப்பை உணர்த்தும் விகுதியைப் பெற்று அமைகின்றன", "D": "எதிர்மறைத் தொழிற்பெயர்கள் எப்போதும் எதிர்காலத்தை மட்டுமே காட்டும்"}, "explanation": "தொழிற்பெயர்கள் (உடன்பாடாயினும் எதிர்மறையாயினும்) பொதுவாகக் காலம் காட்டாது. எனவே எதிர்காலத்தை மட்டுமே காட்டும் என்பது இலக்கணப் பிழையான கூற்று. 'D' தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Which of the statements regarding negative verbal nouns is INCORRECT?"}], "options": {"A": "Functions in a negative sense", "B": "Nadavaamai, Kollaamai are examples", "C": "Formed with negative verbal noun suffixes", "D": "Always denotes future tense exclusively"}, "explanation": "Verbal nouns do not indicate tense. Stating that it denotes future tense is grammatically false. Option D is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "எதிர்மறைப் பொருளில் வரும் தொழிற்பெயர் எதிர்மறைத் தொழிற்பெயர் ஆகும்.", "content_en": "A verbal noun expressing negative sense is an Ethirmarai Thozhirpeyar."}, {"id": "S2", "content_ta": "'நடவாமை', 'கொல்லாமை' ஆகியவை எதிர்மறைத் தொழிற்பெயர்கள் ஆகும்.", "content_en": "'Nadavaamai' and 'Kollaamai' are negative verbal nouns."}, {"id": "S3", "content_ta": "எதிர்மறைத் தொழிற்பெயரில் 'ஆமை' போன்ற எதிர்மறை விகுதிகள் இணைந்து வருகின்றன.", "content_en": "Negative verbal nouns incorporate negative suffixes like 'aamai'."}, {"id": "S4", "content_ta": "எதிர்மறைத் தொழிற்பெயர்கள் எப்போதும் எதிர்காலத்தை மட்டுமே வெளிப்படையாகக் காட்டும்.", "content_en": "Negative verbal nouns always explicitly signify future tense only."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 38, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4 / Group 2", "exam_name": "TNPSC Combined Civil Services", "year": "2014-2024", "paper": "General Tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pyq", "grammar", "ethirmarai_thozhirpeyar", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q288", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-pyq-thozhirpeyar-root-behavior", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'தட்டு', 'உரை', 'அடி' ஆகியவை முதனிலைத் தொழிற்பெயர்கள் ஆகும்.\nகாரணம் (R): விகுதி எதுவும் பெறாமல் பகுதி மட்டுமே தொழிலை உணர்த்துவதால் இவை முதனிலைத் தொழிற்பெயர் எனப்படுகின்றன."}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றுக்கான சரியான விளக்கம்", "B": "கூற்று சரி, காரணம் தவறு", "C": "கூற்று தவறு, காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் பக்கம் 37: தட்டுதல், உரைத்தல், அடித்தல் என்பவற்றின் முதனிலைகளான தட்டு, உரை, அடி என்பவை விகுதி பெறாமல் தொழிலை உணர்த்துவதால் முதனிலைத் தொழிற்பெயர்களாகும். கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'Thattu', 'Urai', 'Adi' are primary root verbal nouns (Muthannilai Thozhirpeyar).\nReason (R): Because they signify action through the root without taking any suffixes, they are called primary root verbal nouns."}], "options": {"A": "Both Assertion and Reason are true, and Reason is the correct explanation", "B": "Assertion is true, Reason is false", "C": "Assertion is false, Reason is true", "D": "Both Assertion and Reason are false"}, "explanation": "Both A and R are true as per page 37, and R is the precise grammatical definition explaining A."}}, "question_data": {"assertion": "'தட்டு', 'உரை', 'அடி' ஆகியவை முதனிலைத் தொழிற்பெயர்கள் ஆகும்.", "reason": "விகுதி எதுவும் பெறாமல் பகுதி மட்டுமே தொழிலை உணர்த்துவதால் இவை முதனிலைத் தொழிற்பெயர் எனப்படுகின்றன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4 / Group 2", "exam_name": "TNPSC Combined Civil Services", "year": "2014-2024", "paper": "General Tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pyq", "grammar", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q289", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-05-ilakkiyavagai-sorkal", "chapter_id": null, "topic_id": "ta-t2-pyq-tisaisol-foreign-loans", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தற்காலத் தமிழில் வழங்கும் 'சாவி', 'சன்னல்', 'இரயில்' போன்ற சொற்கள் திசைச்சொற்கள் எனப்படுகின்றன.\nகாரணம் (R): வடமொழி தவிர்த்த பிற மொழிகளிலிருந்து தமிழில் வந்து வழங்கும் சொற்களும் திசைச்சொற்கள் எனப்படும்."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "C": "கூற்று தவறு, காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் பக்கம் 18: சாவி, சன்னல், இரயில் போன்ற பிற மொழிச் சொற்கள் திசைச்சொற்களாகவே கொள்ளப்படும். வடமொழி தவிர்த்த பிற மொழியிலிருந்து வருபவை திசைச்சொல். கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Words like 'Saavi', 'Sannal', 'Rayil' used in contemporary Tamil are classified as Tisaisorkal.\nReason (R): Words that entered Tamil from languages other than Sanskrit are also termed Tisaisorkal."}], "options": {"A": "Assertion is true, Reason is false", "B": "Both Assertion and Reason are true, and Reason is the correct explanation", "C": "Assertion is false, Reason is true", "D": "Both Assertion and Reason are false"}, "explanation": "Both A and R are verified from page 18; non-Sanskrit foreign loanwords are categorized under Tisaisol. B is correct."}}, "question_data": {"assertion": "தற்காலத் தமிழில் வழங்கும் 'சாவி', 'சன்னல்', 'இரயில்' போன்ற சொற்கள் திசைச்சொற்கள் எனப்படுகின்றன.", "reason": "வடமொழி தவிர்த்த பிற மொழிகளிலிருந்து தமிழில் வந்து வழங்கும் சொற்களும் திசைச்சொற்கள் எனப்படும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4 / Group 2", "exam_name": "TNPSC Combined Civil Services", "year": "2014-2024", "paper": "General Tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pyq", "grammar", "tisaisol", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q290", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-pyq-thozhirpeyar-person-restriction", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தொழிற்பெயரானது தன்மை, முன்னிலை, படர்க்கை ஆகிய மூவிடங்களிலும் பரவலாகப் பயன்படும்.\nகாரணம் (R): தொழிற்பெயர் என்பது வினையின் பெயரை உணர்த்தி எப்போதுமே படர்க்கைக்கே உரியதாக அமையும்."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று, காரணம் இரண்டும் சரி", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "கூற்று தவறு: தொழிற்பெயர் மூவிடங்களிலும் வராது; படர்க்கை இடத்திற்கு மட்டுமே உரியது. காரணம் சரி: பாடநூல் பக்கம் 37-ல் 'படர்க்கைக்கே உரியது' எனத் தெளிவாகக் கூறப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Verbal noun is widely utilized across first, second, and third persons.\nReason (R): A verbal noun denotes the name of an action and belongs strictly to the third person (Padarkkai)."}], "options": {"A": "Assertion is true, Reason is false", "B": "Both Assertion and Reason are true", "C": "Assertion (A) is false, but Reason (R) is true", "D": "Both Assertion and Reason are false"}, "explanation": "Assertion is false because verbal nouns are confined to third person only. Reason is true as per page 37. Key C is correct."}}, "question_data": {"assertion": "தொழிற்பெயரானது தன்மை, முன்னிலை, படர்க்கை ஆகிய மூவிடங்களிலும் பரவலாகப் பயன்படும்.", "reason": "தொழிற்பெயர் என்பது வினையின் பெயரை உணர்த்தி எப்போதுமே படர்க்கைக்கே உரியதாக அமையும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4 / Group 2", "exam_name": "TNPSC Combined Civil Services", "year": "2014-2024", "paper": "General Tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pyq", "grammar", "thozhirpeyar", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q291", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-05-ilakkiyavagai-sorkal", "chapter_id": null, "topic_id": "ta-t2-pyq-thirisol-definition-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'வங்கம்', 'அம்பி', 'நாவாய்' என்பவை பல பொருள் குறித்த ஒரு திரிசொல்லுக்குச் சான்றுகளாகும்.\nகாரணம் (R): 'இதழ்' என்னும் சொல் பூவின் இதழ், உதடு, கண் இமை, நாளிதழ் எனப் பல பொருள்களைத் தருவதால் அது ஒரு பொருள் குறித்த பல திரிசொல் எனப்படும்."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று, காரணம் இரண்டும் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் பக்கம் 18:\n1. 'வங்கம், அம்பி, நாவாய்' என்பது கப்பல் என்ற ஒரு பொருளைத் தரும் 'ஒரு பொருள் குறித்த பல திரிசொல்' ஆகும் (கூற்று தலைகீழாக உள்ளது, தவறு).\n2. 'இதழ்' என்பது பல பொருள்களைத் தரும் 'பல பொருள் குறித்த ஒரு திரிசொல்' ஆகும் (காரணமும் தலைகீழாக உள்ளது, தவறு).\nஎனவே கூற்று, காரணம் இரண்டும் தவறு!"}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'Vangam', 'Ambi', 'Naavaai' are examples of single Thirisol having multiple meanings.\nReason (R): Because 'Ithazh' means petal, lip, eyelid, and journal, it is called multiple Thirisol for a single meaning."}], "options": {"A": "Assertion is true, Reason is false", "B": "Assertion is false, Reason is true", "C": "Both Assertion and Reason are true", "D": "Both Assertion and Reason are false"}, "explanation": "Both A and R have definitions cross-swapped: Vangam/Ambi/Naavaai is 'Oru porul kuritha pala thirisol', and Ithazh is 'Pala porul kuritha oru thirisol'. Both are completely false."}}, "question_data": {"assertion": "'வங்கம்', 'அம்பி', 'நாவாய்' என்பவை பல பொருள் குறித்த ஒரு திரிசொல்லுக்குச் சான்றுகளாகும்.", "reason": "'இதழ்' என்னும் சொல் பூவின் இதழ், உதடு, கண் இமை, நாளிதழ் எனப் பல பொருள்களைத் தருவதால் அது ஒரு பொருள் குறித்த பல திரிசொல் எனப்படும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4 / Group 2", "exam_name": "TNPSC Combined Civil Services", "year": "2014-2024", "paper": "General Tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pyq", "grammar", "thirisol", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q292", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-pyq-thozhirpeyar-lengthening-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'சுடு' என்னும் பகுதி 'சூடு' எனத் திரிந்து தொழிற்பெயராக மாறுகிறது.\nகாரணம் (R): குறில் பகுதி நெடிலாகத் திரிந்து விகுதியின்றித் தொழில் உணர்த்துவது முதனிலை திரிந்த தொழிற்பெயர் ஆகும்."}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "B": "கூற்று சரி, காரணம் தவறு", "C": "கூற்று தவறு, காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "சுடு -> சூடு, கெடு -> கேடு. முதனிலைக் குறில் நெடிலாகத் திரிந்து தொழிலை உணர்த்துவது முதனிலை திரிந்த தொழிற்பெயர். கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): The root 'Sudu' transforms into 'Soodu' functioning as a verbal noun.\nReason (R): When a short root vowel lengthens to denote action without suffix, it is a Muthannilai Thirintha Thozhirpeyar."}], "options": {"A": "Both Assertion and Reason are true, and Reason explains Assertion", "B": "Assertion is true, Reason is false", "C": "Assertion is false, Reason is true", "D": "Both Assertion and Reason are false"}, "explanation": "Both A and R are true and R is the textbook definition of lengthened root verbal nouns explaining A."}}, "question_data": {"assertion": "'சுடு' என்னும் பகுதி 'சூடு' எனத் திரிந்து தொழிற்பெயராக மாறுகிறது.", "reason": "குறில் பகுதி நெடிலாகத் திரிந்து விகுதியின்றித் தொழில் உணர்த்துவது முதனிலை திரிந்த தொழிற்பெயர் ஆகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 38, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4 / Group 2", "exam_name": "TNPSC Combined Civil Services", "year": "2014-2024", "paper": "General Tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pyq", "grammar", "thozhirpeyar", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q293", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-11-thirukkural", "chapter_id": null, "topic_id": "ta-t2-pyq-manarkeni-uvamai-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'தொட்டனைத்து ஊறும் மணற்கேணி மாந்தர்க்குக் கற்றனைத்து ஊறும் அறிவு' என்னும் குறளில் எடுத்துக்காட்டு உவமை அணி பயின்று வந்துள்ளது.\nகாரணம் (R): உவமையும் உவமேயமும் தனித்தனி வாக்கியங்களாக வந்து உவம உருபு மறைந்து வந்துள்ளது."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றுக்கான சரியான விளக்கம்", "C": "கூற்று தவறு, காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் பக்கம் 40: இக்குறட்பாவில் உவம உருபு மறைந்து வந்துள்ளதால் இது 'எடுத்துக்காட்டு உவமை அணி' ஆகும். கூற்று, காரணம் இரண்டும் சரி; காரணம் சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'Thottanaithu oorum manarkeni maantharkkuk katranaithu oorum arivu' contains Eduthukkaattu Uvamai Ani.\nReason (R): Upamana and Upameya appear as distinct sentences with the comparative marker (uvama urubu) implied/omitted."}], "options": {"A": "Assertion is true, Reason is false", "B": "Both Assertion and Reason are true, and Reason is the correct explanation", "C": "Assertion is false, Reason is true", "D": "Both Assertion and Reason are false"}, "explanation": "Both A and R are correct; in Eduthukkaattu Uvamai Ani, the comparative particle is omitted, which explains why the Kural is categorized under this figure of speech."}}, "question_data": {"assertion": "'தொட்டனைத்து ஊறும் மணற்கேணி மாந்தர்க்குக் கற்றனைத்து ஊறும் அறிவு' என்னும் குறளில் எடுத்துக்காட்டு உவமை அணி பயின்று வந்துள்ளது.", "reason": "உவமையும் உவமேயமும் தனித்தனி வாக்கியங்களாக வந்து உவம உருபு மறைந்து வந்துள்ளது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 40, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4 / Group 2", "exam_name": "TNPSC Combined Civil Services", "year": "2014-2024", "paper": "General Tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pyq", "ani_ilakkanam", "thirukkural", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q294", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-05-ilakkiyavagai-sorkal", "chapter_id": null, "topic_id": "ta-t2-pyq-iyarsol-four-types-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயற்சொல்லின் நான்கு வகைகளையும் அவற்றுக்கான சான்றுகளையும் பொருத்துக:\n(a) பெயர் இயற்சொல் - 1. அவனை, அவனால்\n(b) வினை இயற்சொல் - 2. மாநகரம்\n(c) இடை இயற்சொல் - 3. மண், பொன்\n(d) உரி இயற்சொல் - 4. நடந்தான், வந்தான்"}], "options": {"A": "a-1, b-4, c-3, d-2", "B": "a-3, b-1, c-4, d-2", "C": "a-3, b-4, c-1, d-2", "D": "a-4, b-3, c-1, d-2"}, "explanation": "பாடநூல் பக்கம் 17:\nபெயர் இயற்சொல் = மண், பொன் (3)\nவினை இயற்சொல் = நடந்தான், வந்தான் (4)\nஇடை இயற்சொல் = அவனை, அவனால் (1)\nஉரி இயற்சொல் = மாநகரம் (2).\nவரிசை: 3, 4, 1, 2."}, "en": {"blocks": [{"type": "text", "content": "Match the four classes of Iyarsol with their textbook examples:\n(a) Noun Iyarsol - 1. Avanai, Avanaal\n(b) Verbal Iyarsol - 2. Maanagaram\n(c) Particle Iyarsol - 3. Mann, Pon\n(d) Qualitative Iyarsol - 4. Nadanthan, Vanthan"}], "options": {"A": "a-1, b-4, c-3, d-2", "B": "a-3, b-1, c-4, d-2", "C": "a-3, b-4, c-1, d-2", "D": "a-4, b-3, c-1, d-2"}, "explanation": "Correct alignment: Noun Iyarsol = 3, Verb Iyarsol = 4, Particle Iyarsol = 1, Qualitative Iyarsol = 2. Sequence: 3, 4, 1, 2."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "பெயர் இயற்சொல்", "content_en": "Noun Iyarsol"}, {"id": "L2", "content_ta": "வினை இயற்சொல்", "content_en": "Verbal Iyarsol"}, {"id": "L3", "content_ta": "இடை இயற்சொல்", "content_en": "Particle Iyarsol"}, {"id": "L4", "content_ta": "உரி இயற்சொல்", "content_en": "Qualitative Iyarsol"}], "right": [{"id": "R1", "content_ta": "அவனை, அவனால்", "content_en": "Avanai, Avanaal"}, {"id": "R2", "content_ta": "மாநகரம்", "content_en": "Maanagaram"}, {"id": "R3", "content_ta": "மண், பொன்", "content_en": "Mann, Pon"}, {"id": "R4", "content_ta": "நடந்தான், வந்தான்", "content_en": "Nadanthan, Vanthan"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 17, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4 / Group 2", "exam_name": "TNPSC Combined Civil Services", "year": "2014-2024", "paper": "General Tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pyq", "grammar", "iyarsol", "matching"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q295", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-08-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-pyq-thozhirpeyar-suffixes-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொழிற்பெயர் விகுதிகளையும் அவற்றால் அமைந்த சொற்களையும் பொருத்துக:\n(a) தல், அல் - 1. பார்வை, நட்பு\n(b) ஐ, கை - 2. மறதி, உணர்ச்சி\n(c) வை, பு - 3. தருதல், வந்தல்\n(d) தி, சி - 4. விலை, வருகை"}], "options": {"A": "a-1, b-4, c-3, d-2", "B": "a-3, b-1, c-4, d-2", "C": "a-4, b-3, c-1, d-2", "D": "a-3, b-4, c-1, d-2"}, "explanation": "பாடநூல் பக்கம் 37:\nதல், அல் = தருதல், வந்தல் (3)\nஐ, கை = விலை, வருகை (4)\nவை, பு = பார்வை, நட்பு (1)\nதி, சி = மறதி, உணர்ச்சி (2).\nவரிசை: 3, 4, 1, 2."}, "en": {"blocks": [{"type": "text", "content": "Match the verbal noun suffixes with their resulting nouns:\n(a) Thal, Al - 1. Paarvai, Natpu\n(b) Ai, Kai - 2. Marathi, Unarchi\n(c) Vai, Pu - 3. Tharuthal, Vanthal\n(d) Thi, Si - 4. Vilai, Varugai"}], "options": {"A": "a-1, b-4, c-3, d-2", "B": "a-3, b-1, c-4, d-2", "C": "a-4, b-3, c-1, d-2", "D": "a-3, b-4, c-1, d-2"}, "explanation": "Correct match: Thal/Al = 3, Ai/Kai = 4, Vai/Pu = 1, Thi/Si = 2. Sequence: 3, 4, 1, 2."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "தல், அல்", "content_en": "Thal, Al"}, {"id": "L2", "content_ta": "ஐ, கை", "content_en": "Ai, Kai"}, {"id": "L3", "content_ta": "வை, பு", "content_en": "Vai, Pu"}, {"id": "L4", "content_ta": "தி, சி", "content_en": "Thi, Si"}], "right": [{"id": "R1", "content_ta": "பார்வை, நட்பு", "content_en": "Paarvai, Natpu"}, {"id": "R2", "content_ta": "மறதி, உணர்ச்சி", "content_en": "Marathi, Unarchi"}, {"id": "R3", "content_ta": "தருதல், வந்தல்", "content_en": "Tharuthal, Vanthal"}, {"id": "R4", "content_ta": "விலை, வருகை", "content_en": "Vilai, Varugai"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "TNPSC Group 4 / Group 2", "exam_name": "TNPSC Combined Civil Services", "year": "2014-2024", "paper": "General Tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pyq", "grammar", "thozhirpeyar", "matching"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-pyq-q296", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-08-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-pyq-root-lengthening-pairs-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முதனிலைகளையும் அவை முதனிலை திரிந்த தொழிற்பெயர்களாக மாறும் வடிவங்களையும் பொருத்துக:\n(a) கெடு - 1. கேடு\n(b) சுடு - 2. சூடு\n(c) பெறு - 3. பேறு\n(d) கொள் - 4. கோள்"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-3, b-4, c-1, d-2", "D": "a-4, b-3, c-2, d-1"}, "explanation": "பாடநூல் பக்கம் 38-ல் நேரடியான ஜோடிகள்:\nகெடு -> கேடு (1)\nசுடு -> சூடு (2)\nபெறு -> பேறு (3)\nகொள் -> கோள் (4).\nநேரடிப் பொருத்தம்: 1, 2, 3, 4."}, "en": {"blocks": [{"type": "text", "content": "Match the verb roots with their transformed lengthened root verbal nouns:\n(a) Kedu - 1. Kedu (long)\n(b) Sudu - 2. Soodu\n(c) Peru - 3. Paeru\n(d) Kol - 4. Kol (long)"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-3, b-4, c-1, d-2", "D": "a-4, b-3, c-2, d-1"}, "explanation": "Direct textbook alignments from page 38: Kedu -> Kedu (1), Sudu -> Soodu (2), Peru -> Paeru (3), Kol -> Kol (4). Sequence: 1, 2, 3, 4."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "கெடு", "content_en": "Kedu"}, {"id": "L2", "content_ta": "சுடு", "content_en": "Sudu"}, {"id": "L3", "content_ta": "பெறு", "content_en": "Peru"}, {"id": "L4", "content_ta": "கொள்", "content_en": "Kol"}], "right": [{"id": "R1", "content_ta": "கேடு", "content_en": "Kedu (Lengthened)"}, {"id": "R2", "content_ta": "சூடு", "content_en": "Soodu"}, {"id": "R3", "content_ta": "பேறு", "content_en": "Paeru"}, {"id": "R4", "content_ta": "கோள்", "content_en": "Kol (Lengthen