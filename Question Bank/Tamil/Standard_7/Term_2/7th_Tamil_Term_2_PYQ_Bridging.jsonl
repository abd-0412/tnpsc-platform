{"id": "7th-t2-pyq-q275", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-pyq-bridging", "lesson_id": "lesson-08-thozhirpeyar", "chapter_id": null, "topic_id": "ta-t2-pyq-grammar-vikuthi-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடநூலில் குறிப்பிடப்பட்டுள்ள தொழிற்பெயர் விகுதிகளில் சேராத விகுதி எது?"}], "options": {"A": "தல், அல், அம்", "B": "ஐ, கை, வை", "C": "அன், ஆன், அள்", "D": "கு, பு, ஊ"}, "explanation": "பாடநூல் பக்கம் 37-ல் தொழிற்பெயர் விகுதிகளாக தல், அல், அம், ஐ, கை, வை, கு, பு, ஊ, தி, சி, வி, உள் ஆகிய 13 விகுதிகள் குறிப்பிடப்பட்டுள்ளன. 'அன், ஆன், அள்' என்பவை வினைமுற்றுப் பால் காட்டும் விகுதிகள் ஆகும்; தொழிற்பெயர் விகுதிகள் அல்ல."}, "en": {"blocks": [{"type": "text", "content": "Which of the following suffixes is NOT among the 13 verbal noun suffixes explicitly listed in the textbook?"}], "options": {"A": "Thal, Al, Am", "B": "Ai, Kai, Vai", "C": "An, Aan, Al", "D": "Ku, Pu, Oo"}, "explanation": "'An, Aan, Al' are gender-marking finite verb suffixes, not verbal noun suffixes. Hence C is the correct answer."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2