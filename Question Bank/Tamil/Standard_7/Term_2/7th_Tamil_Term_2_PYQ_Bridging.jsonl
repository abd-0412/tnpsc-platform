{"id": "7th-t2-pyq-q276", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-07-pesum-oviyangal", "chapter_id": null, "topic_id": "ta-t2-pyq-odd-art-media", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் வரலாற்று ஓவிய வகைகளுள் பொருந்தாத ஒன்றைக் கண்டறிக:"}], "options": {"A": "சுவர் ஓவியம்", "B": "துணி ஓவியம்", "C": "ஓலைச்சுவடி ஓவியம்", "D": "நெகிழி (பிளாஸ்டிக்) ஓவியம்"}, "explanation": "பாடப்பகுதியில் குகை, சுவர், துணி, ஓலைச்சுவடி, தந்தம், கண்ணாடி, தாள் ஓவியங்கள் குறிப்பிடப்பட்டுள்ளன. 'நெகிழி (பிளாஸ்டிக்) ஓவியம்' என்பது மரபுவழி வரலாற்று ஓவிய வகைகளில் பொருந்தாதது ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the odd one out among historical Tamil painting mediums:"}], "options": {"A": "Mural painting", "B": "Cloth painting", "C": "Palm-leaf painting", "D": "Plastic painting"}, "explanation": "Plastic painting is not a traditional historical medium of Tamil art. D is the odd one out."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 23, "chapter": null, "section": null, "reference": null, "url": null,