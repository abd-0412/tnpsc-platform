{"id": "7th-t2-u1-q053", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-04-palli-maruthirappu", "chapter_id": null, "topic_id": "ta-t2-u1-odd-subra-works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுப்ரபாரதிமணியனின் படைப்புகளில் பொருந்தாத ஒன்றைத் தேர்ந்தெடுக்க:"}], "options": {"A": "சிந்தனைக் களஞ்சியம்", "B": "புத்துமண்", "C": "கதை சொல்லும் கலை", "D": "பின்னல்"}, "explanation": "'சிந்தனைக் களஞ்சியம்' என்பது திருக்குறளார் வீ. முனிசாமியின் நூல் ஆகும். புத்துமண், கதை சொல்லும் கலை, பின்னல் ஆகியவை சுப்ரபாரதிமணியனின் நூல்கள்."}, "en": {"blocks": [{"type": "text", "content": "Identify the work that was NOT authored by Subrabharathimanian:"}], "options": {"A": "Chinthanaik Kalanjiyam", "B": "Puthumann", "C": "Kathai Sollum Kalai", "D": "Pinnal"}, "explanation": "'Chinthanaik Kalanjiyam' was authored by Thirukkuralar V. Munusamy. Puthumann, Kathai Sollum Kalai, and Pinnal were written by Subrabharathimanian."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 14, "chapter": null, "section": null, "reference": null, "url": null