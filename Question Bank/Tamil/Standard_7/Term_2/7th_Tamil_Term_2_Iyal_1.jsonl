{"id": "7th-t2-u1-q056", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-03-vaazhvikkum-kalvi", "chapter_id": null, "topic_id": "ta-t2-u1-bookback-illiterate-comparison", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கல்வியறிவில்லாதவரைத் திருவள்ளுவர் எதனோடு ஒப்பிடுகிறார்?"}], "options": {"A": "மரம்", "B": "கல்", "C": "விலங்கு", "D": "பாம்பு"}, "explanation": "பாடநூல் மதிப்பீடு வினா 2: 'விலங்கொடு மக்கள் அனையர்' என்னும் குறளின்படி கல்வியறிவில்லாதவரைத் திருவள்ளுவர் 'விலங்கு' என்று ஒப்பிடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "With what does Thiruvalluvar equate an uneducated person?"}], "options": {"A": "Tree", "B": "Stone", "C": "Beast / Animal", "D": "Snake"}, "explanation": "Textbook evaluation answer: In Kural 410, Thiruvalluvar compares the illiterate to 'animals/beasts' (Vilangu)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 11, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year":