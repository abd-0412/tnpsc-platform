{"id": "7th-t2-u1-q049", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-03-vaazhvikkum-kalvi", "chapter_id": null, "topic_id": "ta-t2-u1-grammar-kattrar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கற்றார்', 'கல்லாதவர்' ஆகிய சொற்களின் இலக்கணக் குறிப்பைக் கண்டறிக:"}], "options": {"A": "வினையாலணையும் பெயர்கள்", "B": "தொழிற்பெயர்கள்", "C": "பெயரெச்சங்கள்", "D": "வினையெச்சங்கள்"}, "explanation": "'கற்றார்', 'கல்லாதவர்' என்பவை வினையைச் செய்த கருத்தாவைக் குறித்து நின்று, காலம் காட்டி, வேற்றுமை உருபுகளை ஏற்கும் வினையாலணையும் பெயர்கள் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the grammatical categorization (Ilakkana Kurippu) of 'Katrar' and 'Kallathavar':"}], "options": {"A": "Participial nouns (Vinaiyaalanaiyum Peyar)", "B": "Verbal nouns (Thozhirpeyar)", "C": "Relative participles (Peyarecham)", "D": "Verbal participles (Vinaiyecham)"}, "explanation": "'Katrar' (those who learned) and 'Kallathavar' (those unlettered) refer to the agents of action, indicating tense, and are Participial Nouns (Vinaiyaalanaiyum Peyar)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpora