{"id": "7th-t2-u1-q106", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-06-mozhi-thiran", "chapter_id": null, "topic_id": "ta-t2-u1-grammar-orezhuthu-sandhi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தீ + சுடும் = தீச்சுடும்', 'பூ + கூடை = பூக்கூடை' என்பவற்றில் வல்லினம் மிகக் காரணமான இலக்கண விதி யாது?"}], "options": {"A": "வினைத்தொகையில் வல்லினம் மிகும்", "B": "ஓரெழுத்து ஒருமொழிக்குப் பின் வல்லினம் மிகும்", "C": "இரண்டாம் வேற்றுமைத் தொகையில் வல்லினம் மிகாது", "D": "திசைப்பெயர்களின் பின் வல்லினம் மிகாது"}, "explanation": "'ஓரெழுத்து ஒருமொழிக்குப் பின் வல்லினம் மிகும்' என்பது நன்னூல் விதி. தீ, பூ ஆகியவை ஓரெழுத்து ஒருமொழிகள் ஆதலால் அவற்றின் பின் வல்லினம் (ச், க்) மிக்கு முடிந்தது."}, "en": {"blocks": [{"type": "text", "content": "What is the Sandhi rule governing stop gemination in 'Thee + Sudum = Theechudum' and 'Poo + Koodai = Pookkoodai'?"}], "options": {"A": "Stops geminate in Vinai-thogai", "B": "Stops geminate following monosyllabic base words (Orezhuthu Orumozhi)", "C": "Stops do not geminate in 2nd case compounds", "D": "Stops do not geminate after directional words"}, "explanation": "Per Nannool rules, voiceless stops geminate after monosyllabic base roots (Orezhuthu Orumozhi)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active