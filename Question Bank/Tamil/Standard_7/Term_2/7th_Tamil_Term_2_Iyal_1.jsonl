{"id": "7th-t2-u1-q026", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-01-naladiyar", "chapter_id": null, "topic_id": "ta-t2-u1-odd-naladiyar-terms", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாலடியார் 'அழியாச் செல்வம்' பாடலில் குறிப்பிடப்படும் கல்விச் செல்வத்தின் இயல்புகளில் பொருந்தாத ஒன்றைக் கண்டறிக:"}], "options": {"A": "வைத்த இடத்தில் பிறரால் கொள்ளப்படாது (திருடப்படாது)", "B": "ஒருவர் விரும்பிக் கொடுத்தாலும் குறைவுபடாது", "C": "கோபமுற்ற வல்லரசராலும் பறித்துக் கொள்ள முடியாது", "D": "நாட்கள் செல்லச் செல்ல இயல்பாகவே தேய்ந்து அழியும்"}, "explanation": "நாலடியார் கூற்றுப்படி கல்வி அழியாச் செல்வமாகும் ('வைப்புழிக் கோட்படா வாய்த்தீயிற் கேடில்லை'). அது அழியும் என்று கூறுவது தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Find the statement that does not correspond to the attributes of educational wealth in Naladiyar's 'Azhiyaach Selvam':"}], "options": {"A": "Cannot be stolen or taken from where it is stored", "B": "Does not decrease when generously imparted", "C": "Cannot be confiscated even by enraged mighty monarchs", "D": "Gradually diminishes and vanishes with the passage of time"}, "explanation": "Education is immortal ('Azhiyaach Selvam') and never diminishes or fades with time. Hence option D is false and the odd one out."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_mult