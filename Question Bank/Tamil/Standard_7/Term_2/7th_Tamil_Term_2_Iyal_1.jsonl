// ==============================================================================
// பாடம் 4: மொழியை ஆள்வோம், அலுவலகக் கடிதம், கலைச்சொற்கள் & இயல் 1 ஒருங்கிணைந்த ஆய்வு [Q085 - Q112]
// அலுவலகக் கடிதம் / விண்ணப்பக் கடிதம் அமைப்புகள் (அனுப்புநர், பெறுநர், பொருள், உடல், கையொப்பம், உறைமேல் முகவரி), அறுவகைப் பெயர்கள் (பொருள், இடம், காலம், சினை, குணம், தொழில்), மூன்றாம் வேற்றுமை உருபு 'ஆல்' சேர்க்கை, ஓரெழுத்து ஒருமொழி வாக்கியப் பொருத்தம் (ஆ, தீ, நா, பூ), இருபொருள் தரும் சொற்கள் (ஆறு, விளக்கு, படி, சொல், கல், மாலை, இடி), கலைச்சொற்கள் (Summer Vacation, Child Labour, Literacy, Discipline, Uniform, Degree, Guidance, Moral)
// ==============================================================================
{"id": "7th-t2-u1-q085", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-06-mozhi-thiran", "chapter_id": null, "topic_id": "ta-t2-u1-official-letter-format", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அலுவலகக் கடிதத்தின் கட்டமைப்பு குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. அலுவலகக் கடிதம் என்பது ஒரு குறிப்பிட்ட நோக்கத்திற்காக ஓர் அலுவலகம் அல்லது நிறுவனத்திற்கு எழுதப்படும் கடிதமாகும்.\n2. இதனை விண்ணப்பக் கடிதம் அல்லது விண்ணப்பம் எனவும் அழைப்பர்.\n3. இக்கடிதத்தில் முதலில் அனுப்புநரின் பெயரும் முகவரியும், அடுத்துப் பெறுநரின் அலுவலகப் பதவிப்பெயரும் முகவரியும் இடம்பெறும்.\n4. 'பொருள்' என்னும் தலைப்பில் கடிதத்தின் நோக்கத்தைச் சுருக்கமாகக் குறிப்பிட வேண்டும்.\nஇவற்றுள் சரியானவை எவை?"}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 2, 3 மட்டுமே சரி", "C": "2, 3, 4 மட்டுமே சரி", "D": "1, 3, 4 மட்டுமே சரி"}, "explanation": "அலுவலகக் கடிதத்தின் வரைமுறை, விளி (மதிப்பிற்குரிய ஐயா/அம்மா), பொருள், உடல் பகுதி, இடம், தேதி, கையொப்பம், உறைமேல் முகவரி ஆகியவை முறைப்படி அமைதல் வேண்டும். நான்கு கூற்றுகளும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements regarding the structure of an official letter:\n1. An official letter is addressed to an institution or office for a specific purpose.\n2. It is also referred to as an application letter.\n3. It begins with the sender's credentials, followed by the recipient's title and address.\n4. Under 'Subject' (Porul), the objective must be concisely framed.\nWhich of these are correct?"}], "options": {"A": "1, 2, 3, 4 all are correct", "B": "1, 2, 3 only correct", "C": "2, 3, 4 only correct", "D": "1, 3, 4 only correct"}, "explanation": "All four statements perfectly outline the standard formal structure of an official application letter according to the textbook."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "அலுவலகக் கடிதம் என்பது ஒரு குறிப்பிட்ட நோக்கத்திற்காக ஓர் அலுவலகம் அல்லது நிறுவனத்திற்கு எழுதப்படும் கடிதமாகும்.", "content_en": "An official letter is written to an office or organization for a specific administrative purpose."}, {"id": "S2", "content_ta": "இதனை விண்ணப்பக் கடிதம் அல்லது விண்ணப்பம் எனவும் அழைப்பர்.", "content_en": "It is also known as an application letter or application."}, {"id": "S3", "content_ta": "இக்கடிதத்தில் முதலில் அனுப்புநரின் பெயரும் முகவரியும், அடுத்துப் பெறுநரின் அலுவலகப் பதவிப்பெயரும் முகவரியும் இடம்பெறும்.", "content_en": "It begins with the sender's details, followed by the recipient's designation and address."}, {"id": "S4", "content_ta": "'பொருள்' என்னும் தலைப்பில் கடிதத்தின் நோக்கத்தைச் சுருக்கமாகக் குறிப்பிட வேண்டும்.", "content_en": "Under 'Subject' (Porul), the core purpose of the letter must be concisely stated."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["official_letter", "mozhiyai_aalvom", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u1-q086", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-06-mozhi-thiran", "chapter_id": null, "topic_id": "ta-t2-u1-letter-layout-rules", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கடித அமைப்புக் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. அலுவலகக் கடிதத்தின் உடல் பகுதியில் கோரிக்கையின் காரணமும் வேண்டுகோளும் விரிவாக எழுதப்படும்.\n2. கடிதத்தின் இடப்பக்கம் கையொப்பமும், வலப்பக்கம் இடம் மற்றும் தேதியும் இட வேண்டும்.\n3. கடிதத்தின் இறுதிப் பகுதியில் 'உறைமேல் முகவரி' இடம்பெறுவது மரபாகும்.\n4. உறவினருக்கு எழுதும் உறவுமுறைக் கடிதத்தை விட அலுவலகக் கடிதத்தின் கட்டமைப்பு முற்றிலும் மாறுபட்டதாகும்.\nஇவற்றுள் தவறான கூற்று எது?"}], "options": {"A": "கூற்று 1", "B": "கூற்று 2", "C": "கூற்று 3", "D": "கூற்று 4"}, "explanation": "பாடநூல் பக்கங்கள் 18-19 இன் படி, கடிதத்தின் கீழ் 'இடப்பக்கம் இடம் மற்றும் தேதியும்', 'வலப்பக்கம் கையொப்பமும்' இடம்பெற வேண்டும். கூற்று 2-ல் இதனை மாற்றித் தந்துள்ளதால் அது தவறாகும்."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on letter composition:\n1. The body of an official letter elucidates reasons and specific requests.\n2. Signature is placed on the left, while date and place are placed on the right.\n3. The superscription on the envelope is placed at the end.\n4. An official letter follows a fundamentally different layout from personal correspondence.\nWhich statement is incorrect?"}], "options": {"A": "Statement 1", "B": "Statement 2", "C": "Statement 3", "D": "Statement 4"}, "explanation": "As stipulated in the textbook, place and date belong to the lower-left, while signature belongs to the lower-right. Statement 2 is inverted and incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "அலுவலகக் கடிதத்தின் உடல் பகுதியில் கோரிக்கையின் காரணமும் வேண்டுகோளும் விரிவாக எழுதப்படும்.", "content_en": "The body of the official letter details the grounds and specific plea of the request."}, {"id": "S2", "content_ta": "கடிதத்தின் இடப்பக்கம் கையொப்பமும், வலப்பக்கம் இடம் மற்றும் தேதியும் இட வேண்டும்.", "content_en": "Signature must be placed on the left side, and place and date on the right side."}, {"id": "S3", "content_ta": "கடிதத்தின் இறுதிப் பகுதியில் 'உறைமேல் முகவரி' இடம்பெறுவது மரபாகும்.", "content_en": "The superscription address on the cover appears traditionally at the end."}, {"id": "S4", "content_ta": "உறவினருக்கு எழுதும் உறவுமுறைக் கடிதத்தை விட அலுவலகக் கடிதத்தின் கட்டமைப்பு முற்றிலும் மாறுபட்டதாகும்.", "content_en": "The formal structure of an official letter distinctly differs from an informal personal letter."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 19, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["letter_layout", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u1-q087", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-06-mozhi-thiran", "chapter_id": null, "topic_id": "ta-t2-u1-third-case-aal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஆல்' என்னும் வேற்றுமை உருபு தொடர்பான கூற்றுகளை ஆராய்க:\n1. 'கல்லணை கரிகாலனால் கட்டப்பட்டது' என்பதில் மூன்றாம் வேற்றுமை உருபான 'ஆல்' கருத்தாப் பொருளில் வந்துள்ளது.\n2. 'அவர் களிமண்ணால் பானை வனைந்தார்' என்பதில் 'ஆல்' கருவிப் பொருளில் வந்துள்ளது.\n3. 'ஆல்' உருபு எட்டாம் வேற்றுமைக்குரிய சொல்லுருபு ஆகும்.\nஇவற்றுள் சரியானவை எவை?"}], "options": {"A": "1, 2, 3 அனைத்தும் சரி", "B": "2 மற்றும் 3 மட்டுமே சரி", "C": "1 மற்றும் 2 மட்டுமே சரி", "D": "1 மற்றும் 3 மட்டுமே சரி"}, "explanation": "'ஆல்' என்பது மூன்றாம் வேற்றுமைக்குரிய உருபாகும். எட்டாம் வேற்றுமை என்பது விளி வேற்றுமை, அதற்கு உருபுகள் இல்லை. எனவே கூற்று 3 தவறு; 1 மற்றும் 2 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements regarding the case marker 'aal':\n1. In 'Kallanai Karikaalanaal kattappattathu', 'aal' marks the agentive subject.\n2. In 'Avar kalimannaal paanai vanainthaar', 'aal' marks the instrumental material.\n3. 'Aal' is the marker of the eighth (vocative) case.\nWhich of these are correct?"}], "options": {"A": "1, 2, 3 all are correct", "B": "2 and 3 only correct", "C": "1 and 2 only correct", "D": "1 and 3 only correct"}, "explanation": "'Aal' is the suffix for the 3rd case (instrument/agent). The 8th case is vocative without markers. Statement 3 is false; 1 and 2 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'கல்லணை கரிகாலனால் கட்டப்பட்டது' என்பதில் மூன்றாம் வேற்றுமை உருபான 'ஆல்' கருத்தாப் பொருளில் வந்துள்ளது.", "content_en": "In 'Kallanai Karikaalanaal kattappattathu', the 3rd case suffix 'aal' signifies the agentive maker."}, {"id": "S2", "content_ta": "'அவர் களிமண்ணால் பானை வனைந்தார்' என்பதில் 'ஆல்' கருவிப் பொருளில் வந்துள்ளது.", "content_en": "In 'Avar kalimannaal paanai vanainthaar', 'aal' serves an instrumental role."}, {"id": "S3", "content_ta": "'ஆல்' உருபு எட்டாம் வேற்றுமைக்குரிய சொல்லுருபு ஆகும்.", "content_en": "'Aal' is the word-marker for the eighth case."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vetrumai", "case_marker", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u1-q088", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-06-mozhi-thiran", "chapter_id": null, "topic_id": "ta-t2-u1-homonyms-two-meanings", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இருபொருள் தரும் தமிழ்ச் சொற்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. ஒரு சொல்லே பல பொருள்களை உணர்த்துவது தமிழ் மொழியின் வளத்தைக் காட்டுகிறது.\n2. 'ஆறு' என்னும் சொல் 'எண் ஆறு' மற்றும் 'ஓடும் நதி' என இருபொருள் தரும்.\n3. 'படி' என்னும் சொல் 'ஏணிப்படி / மாடிப்படி' மற்றும் 'புத்தகம் படித்தல்' என இருபொருள் தரும்.\n4. 'மாலை' என்னும் சொல் 'பூமாலை' மற்றும் 'அந்திப்பொழுது' என இருபொருள் தரும்.\nஇவற்றுள் சரியானவை எவை?"}], "options": {"A": "1, 2, 3 மட்டுமே சரி", "B": "2, 3, 4 மட்டுமே சரி", "C": "1, 3, 4 மட்டுமே சரி", "D": "1, 2, 3, 4 அனைத்தும் சரி"}, "explanation": "பாடநூல் பக்கம் 20-ல் ஆறு, படி, மாலை, விளக்கு, சொல், கல், இடி ஆகிய சொற்கள் இருபொருள் தருமாறு தொடரமைக்கக் கோரப்பட்டுள்ளன. நான்கு கூற்றுகளும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on homonymous Tamil words with dual meanings:\n1. A single word holding multiple senses reflects the richness of Tamil vocabulary.\n2. 'Aaru' conveys the number 6 and a river.\n3. 'Padi' conveys a staircase step and the verb to read.\n4. 'Maalai' conveys a garland and evening time.\nWhich of these are correct?"}], "options": {"A": "1, 2, 3 only correct", "B": "2, 3, 4 only correct", "C": "1, 3, 4 only correct", "D": "1, 2, 3, 4 all are correct"}, "explanation": "All four statements correctly identify the authentic dual meanings of classic Tamil homonyms specified on page 20."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ஒரு சொல்லே பல பொருள்களை உணர்த்துவது தமிழ் மொழியின் வளத்தைக் காட்டுகிறது.", "content_en": "A single word signifying diverse meanings showcases the lexical richness of Tamil."}, {"id": "S2", "content_ta": "'ஆறு' என்னும் சொல் 'எண் ஆறு' மற்றும் 'ஓடும் நதி' என இருபொருள் தரும்.", "content_en": "'Aaru' denotes the number six as well as a flowing river."}, {"id": "S3", "content_ta": "'படி' என்னும் சொல் 'ஏணிப்படி / மாடிப்படி' மற்றும் 'புத்தகம் படித்தல்' என இருபொருள் தரும்.", "content_en": "'Padi' signifies a staircase step as well as the action of reading."}, {"id": "S4", "content_ta": "'மாலை' என்னும் சொல் 'பூமாலை' மற்றும் 'அந்திப்பொழுது' என இருபொருள் தரும்.", "content_en": "'Maalai' denotes a flower garland as well as evening twilight."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 20, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["homonyms", "polysemy", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u1-q089", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-01-naladiyar", "chapter_id": null, "topic_id": "ta-t2-u1-integrated-synthesis-iyal1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல் 1 முழுவதையும் ஒருங்கிணைத்து நோக்கும்போது வெளிப்படும் கருத்துகளை ஆராய்க:\n1. கல்வி மனிதனை விலங்கு நிலையிலிருந்து உயர்த்தி மாண்புடைய மனிதனாக்கும் ஒப்பற்ற கருவியாகும்.\n2. நாலடியார் கல்வியை அரசராலும் கவர முடியாத, கொடுத்தாலும் குறையாத அழியாச் செல்வம் என்கிறது.\n3. தேயிலைத் தோட்டப் பாட்டு கல்வியறிவின்மையால் தமிழக மக்கள் கூலிகளாகப் புலம் பெயர்ந்த துயரத்தை விவரிக்கிறது.\n4. சுப்ரபாரதிமணியனின் 'பள்ளி மறுதிறப்பு' குழந்தைத்தொழிலாளர் முறையிலிருந்து விடுபட்டுப் பள்ளி செல்வதே தலையாய விழிப்புணர்வு என்பதைப் புகட்டுகிறது.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "1, 2, 3, 4 அனைத்தும் சரி", "B": "1, 2, 3 மட்டுமே சரி", "C": "2, 3, 4 மட்டுமே சரி", "D": "1, 3, 4 மட்டுமே சரி"}, "explanation": "இயல் 1 முழுவதும் 'ஓதுவது ஒழியேல்' என்னும் கல்வி விழுமியத்தை நாலடியார், தேயிலைத் தோட்டப் பாட்டு, வாழ்விக்கும் கல்வி, பள்ளி மறுதிறப்பு வழியாகப் படிப்படியாகக் கட்டமைக்கிறது. அனைத்துக் கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the integrated pedagogical synthesis of Unit 1 (Education):\n1. Education elevates mankind from bestial ignorance to dignified humanity.\n2. Naladiyar depicts education as imperishable wealth immune to royal confiscation.\n3. Tea Garden Song reflects the sorrow of uneducated Tamils driven into overseas indentured labor.\n4. 'Palli Maruthirappu' teaches that choosing schooling over child labor is the true awakening.\nWhich statements are correct?"}], "options": {"A": "1, 2, 3, 4 all are correct", "B": "1, 2, 3 only correct", "C": "2, 3, 4 only correct", "D": "1, 3, 4 only correct"}, "explanation": "Unit 1 systematically establishes the theme 'Othuvathu Ozhiyel' across its poems, prose, and fiction. All four statements are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "கல்வி மனிதனை விலங்கு நிலையிலிருந்து உயர்த்தி மாண்புடைய மனிதனாக்கும் ஒப்பற்ற கருவியாகும்.", "content_en": "Education is the supreme tool elevating humans from beastliness to civilized nobility."}, {"id": "S2", "content_ta": "நாலடியார் கல்வியை அரசராலும் கவர முடியாத, கொடுத்தாலும் குறையாத அழியாச் செல்வம் என்கிறது.", "content_en": "Naladiyar exalts education as an imperishable treasure that cannot be seized by kings or depleted by giving."}, {"id": "S3", "content_ta": "தேயிலைத் தோட்டப் பாட்டு கல்வியறிவின்மையால் தமிழக மக்கள் கூலிகளாகப் புலம் பெயர்ந்த துயரத்தை விவரிக்கிறது.", "content_en": "The Tea Garden Song narrates the tragedy of uneducated Tamils forced into indentured plantation exile."}, {"id": "S4", "content_ta": "சுப்ரபாரதிமணியனின் 'பள்ளி மறுதிறப்பு' குழந்தைத்தொழிலாளர் முறையிலிருந்து விடுபட்டுப் பள்ளி செல்வதே தலையாய விழிப்புணர்வு என்பதைப் புகட்டுகிறது.", "content_en": "Subrabharathimanian's 'Palli Maruthirappu' emphasizes shedding child labor to return to school as the ultimate awakening."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["integrated_synthesis", "statements", "iyal1"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u1-q090", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-06-mozhi-thiran", "chapter_id": null, "topic_id": "ta-t2-u1-kalaichorkal-analysis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கலைச்சொல்லாக்கம் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'Literacy' என்பதற்கு இணையான தமிழ்ச் சொல் 'எழுத்தறிவு' ஆகும்.\n2. 'Discipline' என்பதற்கு இணையான தமிழ்ச் சொல் 'சீருடை' ஆகும்.\n3. 'Child Labour' என்பதற்கு இணையான தமிழ்ச் சொல் 'குழந்தைத் தொழிலாளர்' ஆகும்.\n4. 'Guidance' என்பதற்கு இணையான தமிழ்ச் சொல் 'வழிகாட்டுதல்' ஆகும்.\nஇவற்றுள் தவறான கூற்று எது?"}], "options": {"A": "கூற்று 1", "B": "கூற்று 2", "C": "கூற்று 3", "D": "கூற்று 4"}, "explanation": "'Discipline' என்பதற்கு இணையான சொல் 'ஒழுக்கம்' ஆகும். 'சீருடை' என்பது 'Uniform' என்பதற்கான தமிழ்ச் சொல். எனவே கூற்று 2 தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on technical terminology:\n1. 'Literacy' corresponds to 'Ezhutharivu'.\n2. 'Discipline' corresponds to 'Seerudai'.\n3. 'Child Labour' corresponds to 'Kuzhanthai Thozhilaalar'.\n4. 'Guidance' corresponds to 'Vazhikaattuthal'.\nWhich statement is incorrect?"}], "options": {"A": "Statement 1", "B": "Statement 2", "C": "Statement 3", "D": "Statement 4"}, "explanation": "'Discipline' translates to 'Ozhukkam'. 'Uniform' is the English term for 'Seerudai'. Thus statement 2 is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'Literacy' என்பதற்கு இணையான தமிழ்ச் சொல் 'எழுத்தறிவு' ஆகும்.", "content_en": "The Tamil equivalent of 'Literacy' is 'Ezhutharivu'."}, {"id": "S2", "content_ta": "'Discipline' என்பதற்கு இணையான தமிழ்ச் சொல் 'சீருடை' ஆகும்.", "content_en": "The Tamil equivalent of 'Discipline' is 'Seerudai'."}, {"id": "S3", "content_ta": "'Child Labour' என்பதற்கு இணையான தமிழ்ச் சொல் 'குழந்தைத் தொழிலாளர்' ஆகும்.", "content_en": "The Tamil equivalent of 'Child Labour' is 'Kuzhanthai Thozhilaalar'."}, {"id": "S4", "content_ta": "'Guidance' என்பதற்கு இணையான தமிழ்ச் சொல் 'வழிகாட்டுதல்' ஆகும்.", "content_en": "The Tamil equivalent of 'Guidance' is 'Vazhikaattuthal'."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 20, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["kalaichorkal", "vocabulary", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u1-q091", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-06-mozhi-thiran", "chapter_id": null, "topic_id": "ta-t2-u1-six-peyar-types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அறுவகைப் பெயர்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. பொருள் பெயர் என்பது பொருள்களை மட்டுமே குறிக்கும் பெயராகும் (எ.கா. வடை, பொன்).\n2. இடப்பெயர் என்பது இடத்தைக் குறிக்கும் (எ.கா. நல்லூர், பள்ளி).\n3. 'செம்மை', 'பெரியது' என்பன தொழிற்பெயர்கள் ஆகும்.\nஇவற்றுள் சரியானவை எவை?"}], "options": {"A": "1, 2, 3 அனைத்தும் சரி", "B": "2 மற்றும் 3 மட்டுமே சரி", "C": "1 மற்றும் 2 மட்டுமே சரி", "D": "1 மற்றும் 3 மட்டுமே சரி"}, "explanation": "'செம்மை', 'பெரியது' என்பன பொருளின் நிறம், அளவைக் குறிக்கும் 'பண்புப் பெயர்கள் (குணப் பெயர்கள்)' ஆகும்; தொழிற்பெயர்கள் அல்ல. எனவே கூற்று 3 தவறு; 1 மற்றும் 2 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on the six noun categories:\n1. Porul Peyar denotes entities and substances (e.g., Vadai, Pon).\n2. Idap Peyar designates geographical places (e.g., Nallur, Palli).\n3. 'Semmai' and 'Periyathu' are Thozhirpeyar (Verbal nouns).\nWhich of these are correct?"}], "options": {"A": "1, 2, 3 all are correct", "B": "2 and 3 only correct", "C": "1 and 2 only correct", "D": "1 and 3 only correct"}, "explanation": "'Semmai' (redness) and 'Periyathu' (large) denote quality/attribute, making them Panbu Peyar, not Thozhirpeyar. Statements 1 and 2 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பொருள் பெயர் என்பது பொருள்களை மட்டுமே குறிக்கும் பெயராகும் (எ.கா. வடை, பொன்).", "content_en": "Porul Peyar refers to tangible objects or substances (e.g., Vadai, Pon)."}, {"id": "S2", "content_ta": "இடப்பெயர் என்பது இடத்தைக் குறிக்கும் (எ.கா. நல்லூர், பள்ளி).", "content_en": "Idap Peyar indicates places (e.g., Nallur, Palli)."}, {"id": "S3", "content_ta": "'செம்மை', 'பெரியது' என்பன தொழிற்பெயர்கள் ஆகும்.", "content_en": "'Semmai' and 'Periyathu' are verbal nouns (Thozhirpeyar)."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["peyar_vagai", "grammar", "statements"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u1-q092", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-06-mozhi-thiran", "chapter_id": null, "topic_id": "ta-t2-u1-ar-letter-subject-line", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): அலுவலகக் கடிதங்களில் 'பொருள்' என்னும் தலைப்பு மிக இன்றியமையாத இடத்தைப் பெறுகிறது.\nகாரணம் (R): ஒரு பெரிய கடிதத்தின் முழு உடற்பகுதியையும் படிக்காமலேயே அதிகாரி கடிதத்தின் நோக்கத்தை உடனே அறிய இது வழிசெய்கிறது.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "B": "கூற்று (A) தவறு, காரணம் (R) சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; மேலும் காரணம் கூற்றிற்குச் சரியான விளக்கமாகும்."}, "explanation": "அலுவலகக் கடிதத்தில் கடிதத்தின் சுருக்கமான நோக்கத்தை உணர்த்த 'பொருள்' பகுதி அமைக்கப்படுகிறது. கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): The 'Subject' line holds critical importance in official correspondence.\nReason (R): It allows the administrative official to instantly grasp the core purpose without parsing through lengthy paragraphs.\nSelect the correct option:"}], "options": {"A": "Assertion (A) is correct, Reason (R) is false.", "B": "Assertion (A) is false, Reason (R) is correct.", "C": "Both (A) and (R) are false.", "D": "Both (A) and (R) are correct, and (R) is the proper explanation of (A)."}, "explanation": "The subject heading crystallizes the objective of administrative letters for rapid comprehension. Both statement and reason are valid."}}, "question_data": {"assertion": "அலுவலகக் கடிதங்களில் 'பொருள்' என்னும் தலைப்பு மிக இன்றியமையாத இடத்தைப் பெறுகிறது.", "reason": "ஒரு பெரிய கடிதத்தின் முழு உடற்பகுதியையும் படிக்காமலேயே அதிகாரி கடிதத்தின் நோக்கத்தை உடனே அறிய இது வழிசெய்கிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 19, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["official_letter", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u1-q093", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-06-mozhi-thiran", "chapter_id": null, "topic_id": "ta-t2-u1-ar-monosyllabic-meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'தீ', 'பூ', 'நா', 'மா' என்பன தனித்து நின்றே முழுமையான பொருள் தரும் ஓரெழுத்து ஒருமொழிகள் ஆகும்.\nகாரணம் (R): தமிழ் மொழியில் ஓர் எழுத்தே சொல்லாக நின்று பொருளை வெளிப்படுத்தும் ஆற்றல் வாய்ந்ததாகத் தொல்காப்பியர் காலந்தொட்டே இலக்கண மரபு வகுக்கப்பட்டுள்ளது.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது.", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "C": "கூற்று (A) தவறு, காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "பாடநூல் பக்கம் 20-ல் 'ஓரெழுத்துச் சொற்களால் நிரப்புக' என்னும் பயிற்சியில் தீ, நா, பூ முதலியன தனிச்சொற்களாகப் பொருள் தருவது விளக்கப்பட்டுள்ளது. கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'Thee', 'Poo', 'Naa', and 'Maa' are monosyllabic words yielding complete independent meanings.\nReason (R): Tamil grammatical tradition since Tolkappiyar establishes that individual letters can function autonomously as semantic words.\nSelect the correct option:"}], "options": {"A": "Both (A) and (R) are true; (R) is the correct explanation of (A).", "B": "(A) is true, but (R) is false.", "C": "(A) is false, but (R) is true.", "D": "Both (A) and (R) are false."}, "explanation": "Tamil possesses 42 monosyllabic words (Orezhuthu Orumozhi) capable of expressing complete meaning independently. Both assertion and reason are true."}}, "question_data": {"assertion": "'தீ', 'பூ', 'நா', 'மா' என்பன தனித்து நின்றே முழுமையான பொருள் தரும் ஓரெழுத்து ஒருமொழிகள் ஆகும்.", "reason": "தமிழ் மொழியில் ஓர் எழுத்தே சொல்லாக நின்று பொருளை வெளிப்படுத்தும் ஆற்றல் வாய்ந்ததாகத் தொல்காப்பியர் காலந்தொட்டே இலக்கண மரபு வகுக்கப்பட்டுள்ளது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 20, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["orezhuthu_orumozhi", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u1-q094", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-06-mozhi-thiran", "chapter_id": null, "topic_id": "ta-t2-u1-ar-passive-aal-marker", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): செயப்பாட்டு வினைத் தொடர்களில் செய்பவரைக் குறிக்கும் சொல்லுடன் 'ஆல்' என்னும் மூன்றாம் வேற்றுமை உருபு சேர்க்கப்படுகிறது.\nகாரணம் (R): 'கல்லணை கரிகாலன் கட்டப்பட்டது' என்பதைச் சரியான இலக்கணத் தொடராக மாற்ற 'கல்லணை கரிகாலனால் கட்டப்பட்டது' என எழுத வேண்டும்.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "B": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது.", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "பாடநூல் பயிற்சி 18-ன் படி, செயப்பாட்டு வினையில் 'ஆல்' சேர்க்கப்பட்டுத் தொடர் முழுமை பெறுகிறது. கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): In passive voice constructions, the agentive subject receives the 3rd case marker 'aal'.\nReason (R): To render 'Kallanai Karikaalan kattappattathu' into grammatical syntax, it must be rewritten as 'Kallanai Karikaalanaal kattappattathu'.\nSelect the correct option:"}], "options": {"A": "Assertion (A) is correct, Reason (R) is false.", "B": "Both (A) and (R) are correct; Reason explains Assertion.", "C": "Assertion (A) is false, Reason (R) is correct.", "D": "Both (A) and (R) are false."}, "explanation": "In passive voice formations, the agent requires the instrumental-agentive suffix 'aal'. Both statement and illustrative reason are correct."}}, "question_data": {"assertion": "செயப்பாட்டு வினைத் தொடர்களில் செய்பவரைக் குறிக்கும் சொல்லுடன் 'ஆல்' என்னும் மூன்றாம் வேற்றுமை உருபு சேர்க்கப்படுகிறது.", "reason": "'கல்லணை கரிகாலன் கட்டப்பட்டது' என்பதைச் சரியான இலக்கணத் தொடராக மாற்ற 'கல்லணை கரிகாலனால் கட்டப்பட்டது' என எழுத வேண்டும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["grammar", "passive_voice", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u1-q095", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-06-mozhi-thiran", "chapter_id": null, "topic_id": "ta-t2-u1-ar-degree-kalaichol", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'Degree' என்னும் ஆங்கிலக் கலைச்சொல்லிற்கு இணையான தமிழ்ச் சொல் 'சீருடை' என்பதாகும்.\nகாரணம் (R): பல்கலைக்கழகங்களில் உயர் கல்வி முடித்தோருக்கு வழங்கப்படும் பட்டத்தை ஆங்கிலத்தில் Degree என்பர்.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி.", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "'Degree' என்பதற்கான தமிழ்ச் சொல் 'பட்டம்' ஆகும். 'சீருடை' என்பது 'Uniform' ஆகும். எனவே கூற்று (A) தவறு; காரணம் (R) சரியானது."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): The Tamil equivalent of the English term 'Degree' is 'Seerudai'.\nReason (R): The academic certification conferred by universities upon graduation is called a Degree.\nSelect the correct option:"}], "options": {"A": "Both (A) and (R) are true.", "B": "(A) is true, but (R) is false.", "C": "(A) is false, but (R) is true.", "D": "Both (A) and (R) are false."}, "explanation": "'Degree' in Tamil is 'Pattam', whereas 'Seerudai' is 'Uniform'. Hence (A) is false and (R) is true."}}, "question_data": {"assertion": "'Degree' என்னும் ஆங்கிலக் கலைச்சொல்லிற்கு இணையான தமிழ்ச் சொல் 'சீருடை' என்பதாகும்.", "reason": "பல்கலைக்கழகங்களில் உயர் கல்வி முடித்தோருக்கு வழங்கப்படும் பட்டத்தை ஆங்கிலத்தில் Degree என்பர்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 20, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["kalaichorkal", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u1-q096", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-01-naladiyar", "chapter_id": null, "topic_id": "ta-t2-u1-ar-iyal1-educational-motive", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): இயல் 1-ன் தலைப்பு 'ஓதுவது ஒழியேல்' என ஔவையாரின் ஆத்திசூடி வரியைத் தாங்கி நிற்கிறது.\nகாரணம் (R): தொடக்கக் கல்வி முதல் உயர்கல்வி வரை கல்வியின் இன்றியமையாமை, அழியாத தன்மை, குழந்தைத்தொழிலாளர் ஒழிப்பு ஆகியவற்றை உணர்த்துவதே இவ்வியலின் நோக்கமாகும்.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "B": "கூற்று (A) தவறு, காரணம் (R) சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை முழுமையாக விளக்குகிறது."}, "explanation": "பாடநூல் இயல் 1 தலைப்பு 'ஓதுவது ஒழியேல்' (கல்வி). இது கல்வியின் முக்கியத்துவம் மற்றும் குழந்தை உழைப்பு ஒழிப்பை மையப்படுத்தி அமைக்கப்பட்டுள்ளது. கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Unit 1 carries the title 'Othuvathu Ozhiyel' from Avvaiyar's Aathichoodi.\nReason (R): The objective of this unit is to impart the imperishability of learning and advocate for child labor eradication.\nSelect the correct option:"}], "options": {"A": "Assertion (A) is true, Reason (R) is false.", "B": "Assertion (A) is false, Reason (R) is true.", "C": "Both (A) and (R) are false.", "D": "Both (A) and (R) are true, and Reason properly explains Assertion."}, "explanation": "Unit 1's overarching theme is education drawn from Aathichoodi, synthesizing literature, grammar, and social awareness. Both (A) and (R) are correct."}}, "question_data": {"assertion": "இயல் 1-ன் தலைப்பு 'ஓதுவது ஒழியேல்' என ஔவையாரின் ஆத்திசூடி வரியைத் தாங்கி நிற்கிறது.", "reason": "தொடக்கக் கல்வி முதல் உயர்கல்வி வரை கல்வியின் இன்றியமையாமை, அழியாத தன்மை, குழந்தைத்தொழிலாளர் ஒழிப்பு ஆகியவற்றை உணர்த்துவதே இவ்வியலின் நோக்கமாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["integrated_synthesis", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u1-q097", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u2-kalai", "lesson_id": "lesson-06-mozhi-thiran", "chapter_id": null, "topic_id": "ta-t2-u1-ar-thozhirpeyar-in-names", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'கேட்டல்', 'வருதல்' ஆகிய சொற்கள் அறுவகைப் பெயர்களுள் தொழிற்பெயரின் பாற்படும்.\nகாரணம் (R): ஒரு தொழிலையோ செயலையோ உணர்த்தி, எண், இடம், காலம், பால் ஆகியவற்றை வெளிப்படையாகக் காட்டாமல் அமைவதால் இவை தொழிற்பெயர்களாகும்.\nவிடைக்குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது.", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "C": "கூற்று (A) தவறு, காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "'கேட்டல்', 'வருதல்' என்பன தல் விகுதி பெற்று தொழிலைக் குறிக்கும் தொழிற்பெயர்கள் ஆகும். தொழிற்பெயர் காலம் காட்டாது. கூற்றும் காரணமும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'Keattal' and 'Varuthal' belong to the category of Thozhirpeyar among the six noun types.\nReason (R): Because they denote an action without overtly marking number, place, tense, or gender, they are categorized as verbal nouns.\nSelect the correct option:"}], "options": {"A": "Both (A) and (R) are true; (R) is the correct explanation of (A).", "B": "(A) is true, but (R) is false.", "C": "(A) is false, but (R) is true.", "D": "Both (A) and (R) are false."}, "explanation": "'Keattal' and 'Varuthal' are classic verbal nouns denoting actions without tense. Both assertion and reason are true and logically coherent."}}, "question_data": {"assertion": "'கேட்டல்', 'வருதல்' ஆகிய சொற்கள் அறுவகைப் பெயர்களுள் தொழிற்பெயரின் பாற்படும்.", "reason": "ஒரு தொழிலையோ செயலையோ உணர்த்தி, எண், இடம், காலம், பால் ஆகியவற்றை வெளிப்படையாகக் காட்டாமல் அமைவதால் இவை தொழிற்பெயர்களாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["thozhirpeyar", "grammar", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u1-q098", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-06-mozhi-thiran", "chapter_id": null, "topic_id": "ta-t2-u1-match-kalaichol-1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆங்கிலக் கலைச்சொற்களையும் அவற்றின் தமிழாக்கங்களையும் பொருத்துக:\n(a) Summer Vacation - 1. குழந்தைத் தொழிலாளர்\n(b) Child Labour - 2. கோடை விடுமுறை\n(c) Literacy - 3. ஒழுக்கம்\n(d) Discipline - 4. எழுத்தறிவு"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-2, b-4, c-1, d-3", "D": "a-3, b-1, c-4, d-2"}, "explanation": "Summer Vacation = கோடை விடுமுறை (2); Child Labour = குழந்தைத் தொழிலாளர் (1); Literacy = எழுத்தறிவு (4); Discipline = ஒழுக்கம் (3). வரிசை: 2, 1, 4, 3."}, "en": {"blocks": [{"type": "text", "content": "Match the English terms with their official Tamil translations:\n(a) Summer Vacation - 1. Kuzhanthai Thozhilaalar\n(b) Child Labour - 2. Kodai Vidumurai\n(c) Literacy - 3. Ozhukkam\n(d) Discipline - 4. Ezhutharivu"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-2, b-4, c-1, d-3", "D": "a-3, b-1, c-4, d-2"}, "explanation": "Summer Vacation = Kodai Vidumurai (2); Child Labour = Kuzhanthai Thozhilaalar (1); Literacy = Ezhutharivu (4); Discipline = Ozhukkam (3). Match: 2, 1, 4, 3 (B)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "Summer Vacation", "content_en": "Summer Vacation"}, {"id": "L2", "content_ta": "Child Labour", "content_en": "Child Labour"}, {"id": "L3", "content_ta": "Literacy", "content_en": "Literacy"}, {"id": "L4", "content_ta": "Discipline", "content_en": "Discipline"}], "right": [{"id": "R1", "content_ta": "குழந்தைத் தொழிலாளர்", "content_en": "Kuzhanthai Thozhilaalar