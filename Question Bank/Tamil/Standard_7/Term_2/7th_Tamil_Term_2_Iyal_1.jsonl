{"id": "7th-t2-u1-q105", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-06-mozhi-thiran", "chapter_id": null, "topic_id": "ta-t2-u1-grammar-anna-pechuvanmai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'அறிஞர் அண்ணா தமது பேச்சுவன்மையால் மக்களைக் கவர்ந்தார்' - இத்தொடரில் 'பேச்சுவன்மையால்' என்னும் சொல்லில் பயின்று வந்துள்ள வேற்றுமை உருபு யாது? அதன் வகை யாது?"}], "options": {"A": "மூன்றாம் வேற்றுமை உருபு 'ஆல்' (கருவிப்பொருள்)", "B": "இரண்டாம் வேற்றுமை உருபு 'ஐ' (செயப்படுபொருள்)", "C": "நான்காம் வேற்றுமை உருபு 'கு' (ஏதுப்பொருள்)", "D": "ஐந்தாம் வேற்றுமை உருபு 'இல்' (ஒப்புப்பொருள்)"}, "explanation": "'பேச்சுவன்மையால்' = பேச்சுவன்மை + ஆல். இதில் 'ஆல்' என்பது மூன்றாம் வேற்றுமை உருபாகும். கவர்வதற்குப் பேச்சுவன்மை கருவியாக அமைந்ததால் கருவிப்பொருள் ஆயிற்று."}, "en": {"blocks": [{"type": "text", "content": "Identify the case suffix and classification in 'Peechuvanmaiyaal' in the sentence 'Arignar Anna captivated people by his eloquence':"}], "options": {"A": "3rd case marker 'aal' (Instrumental)", "B": "2nd case marker 'ai' (Accusative)", "C": "4th case marker 'ku' (Causal)", "D": "5th case marker 'il' (Comparative)"}, "explanation": "'Peechuvanmaiyaal' features the 3rd case suffix 'aal' functioning as the instrument of eloquence."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "