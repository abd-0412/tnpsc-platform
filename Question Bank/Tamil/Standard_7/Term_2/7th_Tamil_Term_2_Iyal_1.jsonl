{"id": "7th-t2-u1-q052", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-03-vaazhvikkum-kalvi", "chapter_id": null, "topic_id": "ta-t2-u1-odd-munusamy-works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளார் வீ. முனிசாமி எழுதிய நூல்களின் வரிசையில் பொருந்தாத ஒன்றைத் தேர்ந்தெடுக்க:"}], "options": {"A": "வள்ளுவர் உள்ளம்", "B": "வள்ளுவர் காட்டிய வழி", "C": "திருக்குறளில் நகைச்சுவை", "D": "தண்ணீர் யுத்தம்"}, "explanation": "'தண்ணீர் யுத்தம்' என்னும் நூலை எழுதியவர் எழுத்தாளர் சுப்ரபாரதிமணியன் ஆவார். மற்ற மூன்றும் திருக்குறளார் வீ. முனிசாமி எழுதிய நூல்கள்."}, "en": {"blocks": [{"type": "text", "content": "Find the book that was NOT written by Thirukkuralar V. Munusamy:"}], "options": {"A": "Valluvar Ullam", "B": "Valluvar Kaattiya Vazhi", "C": "Thirukkuralil Nagaichuvai", "D": "Thanneer Yutham"}, "explanation": "'Thanneer Yutham' was authored by Subrabharathimanian. The other three are well-known works by Thirukkuralar V. Munusamy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 10, "chapter": null, "section": nul