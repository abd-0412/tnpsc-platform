{"id": "7th-t2-u1-q108", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-06-mozhi-thiran", "chapter_id": null, "topic_id": "ta-t2-u1-odd-kalaichol", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல் 1-ன் கலைச்சொற்கள் வரிசையில் தவறாகப் பொருந்தியுள்ள ஒன்றைத் தேர்ந்தெடுக்க:"}], "options": {"A": "Summer Vacation - கோடை விடுமுறை", "B": "Child Labour - குழந்தைத் தொழிலாளர்", "C": "Literacy - எழுத்தறிவு", "D": "Guidance - சீருடை"}, "explanation": "'Guidance' என்பதற்கு 'வழிகாட்டுதல்' என்பது சரியான தமிழ்ச் சொல். 'சீருடை' என்பது 'Uniform' என்பதன் தமிழாக்கம் ஆகும். எனவே D தவறாகப் பொருந்தியுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Select the incorrectly matched technical term pair from Unit 1:"}], "options": {"A": "Summer Vacation - Summer vacation", "B": "Child Labour - Child labor", "C": "Literacy - Literacy", "D": "Guidance - Uniform"}, "explanation": "'Guidance' means 'Vazhikaattuthal', not 'Seerudai' (Uniform). Hence option D is the mismatched pair."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 20, "chapter