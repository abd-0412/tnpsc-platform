{"id": "7th-t2-u1-q021", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-01-naladiyar", "chapter_id": null, "topic_id": "ta-t2-u1-ilakkana-kurippu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கோட்படா', 'கேடில்லை' ஆகிய சொற்களுக்குப் பொருத்தமான இலக்கணக் குறிப்பைத் தேர்ந்தெடுக்க:"}], "options": {"A": "கோட்படா - ஈறுகெட்ட எதிர்மறைப் பெயரெச்சம்; கேடில்லை - எதிர்மறை வினைமுற்று", "B": "கோட்படா - பெயரெச்சம்; கேடில்லை - தொழிற்பெயர்", "C": "கோட்படா - வினையெச்சம்; கேடில்லை - குறிப்புப் பெயரெச்சம்", "D": "கோட்படா - தொழிற்பெயர்; கேடில்லை - வினையாலணையும் பெயர்"}, "explanation": "'கோட்படாத' என்பதில் உள்ள இறுதி 'த' கெட்டு 'கோட்படா' என நின்றதால் இது 'ஈறுகெட்ட எதிர்மறைப் பெயரெச்சம்' ஆகும். கேடு இல்லை (கேடில்லை) என்பது எதிர்மறைப் பொருளைத் தரும் வினைமுற்றுத் தொடராகும்."}, "en": {"blocks": [{"type": "text", "content": "Select the appropriate grammatical designation (Ilakkana Kurippu) for 'Kotpada' and 'Kedillai':"}], "options": {"A": "Kotpada - Negative relative participle with dropped final; Kedillai - Negative finite verb", "B": "Kotpada - Relative participle; Kedillai - Verbal noun", "C": "Kotpada - Verbal participle; Kedillai - Appositional participle", "D": "Kotpada - Verbal noun; Kedillai - Participial noun"}, "explanation": "'Kotpada' is a negative relative participle with the final 'tha' dropped (Eeruketta Ethirmarai Peyarecham). 'Kedillai' is a negative finite verb."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["ilakkana_kurippu", "grammar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u1-q022", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-02-thottapattu", "chapter_id": null, "topic_id": "ta-t2-u1-sandhi-rules", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'நாடெங்கும்' என்னும் சொல்லில் இடம்பெற்றுள்ள புணர்ச்சி விதிகளை வரிசைப்படுத்துக:\n'நாடு + எங்கும்'"}], "options": {"A": "உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே", "B": "உயிர்வரின் உக்குறள் மெய்விட்டோடும்; உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே", "C": "இஈஐ வழி யவ்வும்", "D": "தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும்"}, "explanation": "நாடு + எங்கும்:\n1. 'உயிர்வரின் உக்குறள் மெய்விட்டோடும்' என்ற விதிப்படி நிலைமொழி ஈற்று 'டு'வில் உள்ள 'உ' கெட்டு 'நாட்' என நின்றது (நாட் + எங்கும்).\n2. 'உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே' விதிப்படி ட் + எ = டெ என இணைந்து 'நாடெங்கும்' என்றானது."}, "en": {"blocks": [{"type": "text", "content": "Identify the Sandhi (phonetic combination) rules applied in the word 'Naadengum' (Naadu + Engum):"}], "options": {"A": "Udalmel uyirvanthu ondruvathu iyalbe", "B": "Uyirvarin ukkural meyvittodum; Udalmel uyirvanthu ondruvathu iyalbe", "C": "I Ee Ai vazhi yavvum", "D": "Thanikkuril mun otru uyirvarin irattum"}, "explanation": "First, 'Uyirvarin ukkural meyvittodum' drops the 'u' from 'du' (Naad + engum). Then, 'Udalmel uyirvanthu ondruvathu iyalbe' combines 't' + 'e' into 'de' yielding 'Naadengum'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["punarchi", "grammar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u1-q023", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-02-thottapattu", "chapter_id": null, "topic_id": "ta-t2-u1-udambadumey", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'குறை + எனவே = குறையெனவே' என்னும் புணர்ச்சியில் இடம்பெற்றுள்ள உடம்படுமெய் எழுத்து யாது? அதற்குரிய நன்னூல் விதி யாது?"}], "options": {"A": "வ் - ஏனை உயிர்வழி வவ்வும்", "B": "ற் - உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே", "C": "ய் - இ ஈ ஐ வழி யவ்வும்", "D": "த் - தனிக்குறில் முன் ஒற்று இரட்டும்"}, "explanation": "நிலைமொழி ஈற்றில் 'ஐ' (குறை = ற் + ஐ) வந்து வருமொழி முதலில் உயிர் எழுத்து (எ) வந்தால் 'இ ஈ ஐ வழி யவ்வும்' என்ற விதிப்படி 'ய்' என்னும் உடம்படுமெய் தோன்றும். குறை + ய் + எனவே = குறையெனவே."}, "en": {"blocks": [{"type": "text", "content": "Identify the transitional glide consonant (Udambadumey) and Nannool rule in 'Kurai + Enave = Kuraiyenave':"}], "options": {"A": "v - Eenai uyirvazhi vavvum", "B": "r - Udalmel uyirvanthu ondruvathu iyalbe", "C": "y - I Ee Ai vazhi yavvum", "D": "th - Thanikkuril mun otru irattum"}, "explanation": "Since the preceding base ends in 'ai' (kurai), the glide 'y' appears according to 'I Ee Ai vazhi yavvum': kurai + y + enave = kuraiyenave."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["udambadumey", "sandhi", "grammar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t2-u1-q024", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-01-naladiyar", "chapter_id": null, "topic_id": "ta-t2-u1-naladiyar-quote-fill", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாலடியார் பாடல் அடியை நிறைவு செய்க:\n'எச்சம் எனவொருவன் மக்கட்குச் செய்வன\n___________ மற்று அல்ல பிற.'"}], "options": {"A": "பொன்னே", "B": "நிலமே", "C": "அறிவே", "D": "விச்சை"}, "explanation": "நாலடியார் பாடல் வரி: 'எச்சம் எனவொருவன் மக்கட்குச் செய்வன விச்சைமற்று அல்ல பிற.' இதில் விச்சை என்பது கல்வியைக் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "Complete the verse line from Naladiyar:\n'Echam enavoruvan makkatkuch seyvana\n___________ matru alla pira.'"}], "options": {"A": "Ponne", "B": "Nilame", "C": "Arive", "D": "Vichai"}, "explanation": "The exact poem line is '...seyvana vichaimatru alla pira', where 'vichai' denotes knowledge/education."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "2", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_pre