{"id": "7th-t2-u1-q078", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "2", "unit_id": "ta-t2-u1-kalvi", "lesson_id": "lesson-05-ilakkiya-vagai-sorkal", "chapter_id": null, "topic_id": "ta-t2-u1-grammar-urichol-punarchi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மாநகர்' என்னும் உரி இயற்சொல்லின் புணர்ச்சி அமைப்பை விளக்குக:\n'மா + நகர் = மாநகர்'"}], "options": {"A": "தோன்றல் விகாரத்தால் நகரம் இரட்டித்தது", "B": "இயல்புப் புணர்ச்சியாய் எவ்வித மாற்றமும் இன்றி இணைந்தது", "C": "திரிதல் விகாரத்தால் மெல்லினம் பிறந்தது", "D": "கெடுதல் விகாரத்தால் உயிர் எழுத்து கெட்டது"}, "explanation": "'மா + நகர்' புணரும்போது நிலைமொழியிலும் வருமொழியிலும் எவ்வித எழுத்து மாற்றமும் நிகழாமல் இயல்பாக 'மாநகர்' என நின்றதால் இது 'இயல்புப் புணர்ச்சி' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Explain the combination dynamics of the Uri-iyarsol 'Maanagar' (Maa + Nagar):"}], "options": {"A": "Doubling of dental nasal due to augmentative change", "B": "Natural combination (Iyalbu Punarchi) without phonetic mutation", "C": "Mutation change generating nasal", "D": "Elision change dropping vowel"}, "explanation": "'Maa + Nagar = Maanagar' undergoes no phonetic alteration, representing pristine Iyalbu Punarchi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_n