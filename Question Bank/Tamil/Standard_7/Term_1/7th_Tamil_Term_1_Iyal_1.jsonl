{"id": "7th-t1-u1-076", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l5-kutriyalugaram", "chapter_id": null, "topic_id": "metrics-calculation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பட்டு' என்னும் சொல்லின் மொத்த மாத்திரை அளவை இலக்கண விதிகளின்படி கணக்கிடுக:"}], "options": {"A": "3 மாத்திரை", "B": "2.5 மாத்திரை", "C": "1.5 மாத்திரை", "D": "2 மாத்திரை (ப [குறில்] = 1, ட் [மெய்] = 0.5, டு [வன்தொடர்க் குற்றியலுகரம்] = 0.5)"}, "explanation": "ப = குறில் (1 மாத்திரை); ட் = மெய் (0.5 மாத்திரை); டு = வன்தொடர்க் குற்றியலுகரமாக ஒலிப்பதால் அரை மாத்திரை (0.5). மொத்தம் = 1 + 0.5 + 0.5 = 2 மாத்திரை."}, "en": {"blocks": [{"type": "text", "content": "Calculate the total metrical count (maathirai) of the word 'Pattu':"}], "options": {"A": "3 morae", "B": "2.5 morae", "C": "1.5 morae", "D": "2 morae (Pa = 1, T = 0.5, Tu = 0.5)"}, "explanation": "Pa (1) + t (0.5) + tu (0.5) = 2 morae."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 17, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previo