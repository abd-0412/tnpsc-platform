// 7-ஆம் வகுப்பு தமிழ் - பருவம் 1 - இயல் 1: அமுதத்தமிழ் (மொத்த வினாக்கள்: 112)
// ==============================================================================

// ==============================================================================
// பாடம் 1: எங்கள் தமிழ் & ஒன்றல்ல இரண்டல்ல (கவிதைப்பேழை - நாமக்கல் கவிஞர் & உடுமலை நாராயணகவி) [Q001 - Q028]
// அருள்நெறி அறிவை தரலாகும், தமிழன் என்றொரு இனம் உண்டு, கத்தியின்றி ரத்தமின்றி, தமிழக முதல் அரசவைக் கவிஞர், காந்தியக் கவிஞர், மலைக்கள்ளன், என் கதை, சங்கொலி; பகுத்தறிவுக் கவிராயர், முல்லைக்குத் தேர் தந்த பாரி, சொல்லுக்குத் தலை தந்த குமணன், நாட்டுப்புற மெட்டு
// ==============================================================================
{"id": "7th-t1-u1-001", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l1-engal-tamil", "chapter_id": null, "topic_id": "namakkal-kavignar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாமக்கல் கவிஞர் வெ. இராமலிங்கனார் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. இவர் தமிழறிஞர், கவிஞர், ஓவியர், விடுதலைப் போராட்ட வீரர் எனப் பன்முகத் தன்மை கொண்டவர்.\n2. காந்தியடிகளின் கொள்கைகளால் ஈர்க்கப்பட்டு காந்தியத்தைப் பின்பற்றியதால் 'காந்தியக் கவிஞர்' என அழைக்கப்படுகிறார்.\n3. தமிழ்நாடு அரசின் முதல் அரசவைக் கவிஞராக விளங்கிய பெருமைக்குரியவர்.\n4. 'மலைக்கள்ளன்', 'என் கதை', 'சங்கொலி' உள்ளிட்ட பல்வேறு சிறந்த நூல்களை எழுதியுள்ளார்."}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்று 1, 2 மட்டும் சரி", "C": "கூற்று 1, 3, 4 சரி; 2 தவறு", "D": "கூற்று 2, 4 மட்டும் சரி"}, "explanation": "நாமக்கல் கவிஞர் வெ. இராமலிங்கனார் பன்முக ஆற்றல் படைத்தவர்; காந்தியக் கவிஞர் எனப்பட்டவர்; தமிழக அரசின் முதல் அரசவைக் கவிஞர்; மலைக்கள்ளன், என் கதை, சங்கொலி ஆகிய நூல்களை இயற்றியவர். அனைத்துக் கூற்றுகளும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the following statements regarding Namakkal Poet V. Ramalinganar:\n1. He was a multi-faceted personality as a Tamil scholar, poet, painter, and freedom fighter.\n2. Inspired by Mahatma Gandhi's doctrines, he is reverently called 'Gandhian Poet'.\n3. He was appointed as the very first Poet Laureate of the Government of Tamil Nadu.\n4. He authored renowned works including 'Malaikkallan', 'En Kathai', and 'Sangoli'."}], "options": {"A": "All statements are correct", "B": "Statements 1 and 2 only are correct", "C": "Statements 1, 3, 4 are correct; 2 is false", "D": "Statements 2 and 4 only are correct"}, "explanation": "All four statements represent authentic biographical facts from the Standard 7 textbook."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "இவர் தமிழறிஞர், கவிஞர், ஓவியர், விடுதலைப் போராட்ட வீரர் எனப் பன்முகத் தன்மை கொண்டவர்.", "content_en": "He was a multifaceted scholar, poet, painter, and freedom fighter."}, {"id": "S2", "content_ta": "காந்தியடிகளின் கொள்கைகளால் ஈர்க்கப்பட்டு காந்தியத்தைப் பின்பற்றியதால் 'காந்தியக் கவிஞர்' என அழைக்கப்படுகிறார்.", "content_en": "Inspired by Gandhi, he is called 'Gandhian Poet'."}, {"id": "S3", "content_ta": "தமிழ்நாடு அரசின் முதல் அரசவைக் கவிஞராக விளங்கிய பெருமைக்குரியவர்.", "content_en": "He served as the first Poet Laureate of Tamil Nadu."}, {"id": "S4", "content_ta": "'மலைக்கள்ளன்', 'என் கதை', 'சங்கொலி' உள்ளிட்ட பல்வேறு சிறந்த நூல்களை எழுதியுள்ளார்.", "content_en": "He authored Malaikkallan, En Kathai, and Sangoli."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statements", "namakkal_kavignar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u1-002", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l1-engal-tamil", "chapter_id": null, "topic_id": "namakkal-kavignar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'எங்கள் தமிழ்' பாடலில் இடம்பெற்றுள்ள தமிழரின் அறநெறிப் பண்புகள் குறித்த கூற்றுகளை ஆராய்க:\n1. தாய்மொழியாகிய தமிழ் அருள் நெறிகள் நிரம்பிய அறிவைத் தருகிறது; அதுவே தமிழரின் குரலாக விளங்குகிறது.\n2. தமிழ்மொழியைக் கற்ற சான்றோர் பொருள் பெறுவதற்காக யாரையும் புகழ்ந்து பேச மாட்டார்கள்; போற்றாதவரையும் இகழ மாட்டார்கள்.\n3. பிற உயிர்களை அழிக்கும் வன்முறையைக் குறிக்கோளாகவும், பொய்யான வழிகளை நன்னெறியாகவும் கொள்வர்.\n4. எல்லா மனிதர்களும் இன்புற்று வாழ அன்பும் அறமும் உதவும் என்று நாமக்கல் கவிஞர் கூறுகிறார்."}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்று 1, 2, 4 சரி; கூற்று 3 தவறு", "C": "கூற்று 1, 3 சரி; 2, 4 தவறு", "D": "கூற்று 3 மட்டும் சரி"}, "explanation": "தமிழர்கள் கொல்லாமையைக் குறிக்கோளாகவும் பொய்யாமையைக் கொள்கையாகவும் கொண்டு வாழ்வர்; கூற்று 3 தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Tamil ethical virtues from 'Engal Tamil':\n1. Mother tongue Tamil imparts knowledge full of grace, standing as the voice of Tamils.\n2. Learned Tamils neither flatter for wealth nor revile those who do not praise them.\n3. They adopt violence against living beings as goal and falsehood as policy.\n4. Love and virtue will guide all humanity to live in perpetual bliss."}], "options": {"A": "All statements are correct", "B": "Statements 1, 2, 4 are correct; Statement 3 is false", "C": "Statements 1 and 3 are correct; 2 and 4 are false", "D": "Only Statement 3 is correct"}, "explanation": "Statements 1, 2, and 4 are correct; Statement 3 is false because Tamils uphold non-killing (Ahimsa) and truthfulness."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "தாய்மொழியாகிய தமிழ் அருள் நெறிகள் நிரம்பிய அறிவைத் தருகிறது; அதுவே தமிழரின் குரலாக விளங்குகிறது.", "content_en": "Tamil imparts grace-filled knowledge as the Tamilian voice."}, {"id": "S2", "content_ta": "தமிழ்மொழியைக் கற்ற சான்றோர் பொருள் பெறுவதற்காக யாரையும் புகழ்ந்து பேச மாட்டார்கள்; போற்றாதவரையும் இகழ மாட்டார்கள்.", "content_en": "Learned scholars neither flatter for gain nor despise detractors."}, {"id": "S3", "content_ta": "பிற உயிர்களை அழிக்கும் வன்முறையைக் குறிக்கோளாகவும், பொய்யான வழிகளை நன்னெறியாகவும் கொள்வர்.", "content_en": "They adopt violence as goal and falsehood as virtue."}, {"id": "S4", "content_ta": "எல்லா மனிதர்களும் இன்புற்று வாழ அன்பும் அறமும் உதவும் என்று நாமக்கல் கவிஞர் கூறுகிறார்.", "content_en": "Love and virtue help all humanity live joyfully."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statements", "engal_tamil"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u1-003", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l1-engal-tamil", "chapter_id": null, "topic_id": "namakkal-kavignar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடலின் தொடை நயங்கள் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. பாடலடிகளில் இரண்டாம் எழுத்து ஒன்றி வருவது எதுகைத் தொடை எனப்படும்; இதில் முதல் எழுத்து மாத்திரை அளவில் அளவொத்து இருக்க வேண்டும்.\n2. பாடலடிகளில் முதல் எழுத்து ஒன்றி வருவது மோனைத் தொடை எனப்படும்; மோனைத் தொடையில் குறில் நெடில் எழுத்துகள் மாறியும் வரலாம்.\n3. அடிகளின் இறுதியில் வரும் சொற்கள் ஒரே ஓசையிலோ ஒரே எழுத்திலோ முடிவதை இயைபுத் தொடை என்பர்.\n4. 'எங்கள் தமிழ்' பாடலில் 'தரலாகும் - குரலாகும்', 'புகழாது - இகழாது' ஆகியன எதுகைத் தொடைக்கு மட்டுமே சான்றாகும்."}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்று 1, 4 சரி; 2, 3 தவறு", "C": "கூற்று 1, 2, 3 சரி; கூற்று 4 தவறு", "D": "கூற்று 2, 4 சரி; 1, 3 தவறு"}, "explanation": "கூற்று 4 தவறு; ஏனெனில் 'தரலாகும் - குரலாகும்', 'புகழாது - இகழாது' ஆகியவை அடிகளின் இறுதியில் ஒரே ஓசையில் முடியும் 'இயைபுத் தொடை'க்குச் சான்றுகளாகும்."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on poetic rhyme ornaments (Thodai Nayangal):\n1. Rhyme of the second consonant is Edhugai; initial vowels must have proportional mora length.\n2. Rhyme of the initial character is Monai; vowels may alternate between short and long forms.\n3. Lines terminating with identical acoustic cadence or terminal letters constitute Iyaibu.\n4. In 'Engal Tamil', 'Tharalaagum - Kuralaagum' and 'Pugazhaadhu - Igazhaadhu' represent Edhugai alone."}], "options": {"A": "All statements are correct", "B": "Statements 1, 4 are correct; 2, 3 false", "C": "Statements 1, 2, 3 are correct; Statement 4 is false", "D": "Statements 2, 4 are correct; 1, 3 false"}, "explanation": "Statement 4 is false because line-end rhyming words represent Iyaibu thodai, not Edhugai."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பாடலடிகளில் இரண்டாம் எழுத்து ஒன்றி வருவது எதுகைத் தொடை எனப்படும்; இதில் முதல் எழுத்து மாத்திரை அளவில் அளவொத்து இருக்க வேண்டும்.", "content_en": "Edhugai is second-letter rhyme with equal initial mora lengths."}, {"id": "S2", "content_ta": "பாடலடிகளில் முதல் எழுத்து ஒன்றி வருவது மோனைத் தொடை எனப்படும்; மோனைத் தொடையில் குறில் நெடில் எழுத்துகள் மாறியும் வரலாம்.", "content_en": "Monai is first-letter alliteration; short and long vowels may alternate."}, {"id": "S3", "content_ta": "அடிகளின் இறுதியில் வரும் சொற்கள் ஒரே ஓசையிலோ ஒரே எழுத்திலோ முடிவதை இயைபுத் தொடை என்பர்.", "content_en": "Iyaibu is terminal acoustic rhyme at line endings."}, {"id": "S4", "content_ta": "'எங்கள் தமிழ்' பாடலில் 'தரலாகும் - குரலாகும்', 'புகழாது - இகழாது' ஆகியன எதுகைத் தொடைக்கு மட்டுமே சான்றாகும்.", "content_en": "In 'Engal Tamil', Tharalaagum - Kuralaagum are examples of Edhugai alone."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statements", "prosody"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u1-004", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l1-engal-tamil", "chapter_id": null, "topic_id": "namakkal-kavignar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாமக்கல் கவிஞரின் வரலாற்றுப் பின்னணி மற்றும் தேசியப் பாடல்கள் பற்றிய கூற்றுகளை ஆராய்க:\n1. 1930ஆம் ஆண்டு இராசாசி தலைமையில் நடைபெற்ற வேதாரண்யம் உப்புச் சத்தியாக்கிரகத் தொண்டர்களுக்காகப் பாடல் இயற்றினார்.\n2. \"கத்தியின்றி ரத்தமின்றி யுத்தமொன்று வருகுது - சத்தியத்தின் நித்தியத்தை நம்பும்யாரும் சேருவீர்!\" என்பது இவர் பாடிய புகழ்பெற்ற பாடலாகும்.\n3. இவரது 'எங்கள் தமிழ்' என்னும் பாடல் 'நாமக்கல் கவிஞர் பாடல்கள்' என்னும் நூலிலிருந்து எடுத்துத் தரப்பட்டுள்ளது.\n4. இவர் ஆங்கில அரசுக்கு ஆதரவாகப் பாடல்கள் இயற்றி 'சர்' பட்டம் பெற்றவர்."}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்று 1, 4 சரி; 2, 3 தவறு", "C": "கூற்று 2, 3, 4 சரி; 1 தவறு", "D": "கூற்று 1, 2, 3 சரி; கூற்று 4 தவறு"}, "explanation": "கூற்று 4 தவறானது. நாமக்கல் கவிஞர் சுதந்திரப் போராட்டத் தியாகி; சிறை சென்றவர். ஆங்கில அரசை எதிர்த்துத் தேசபக்திப் பாடல்களைப் பாடியவர்."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Namakkal Kavignar's national freedom legacy:\n1. He composed marching hymns for the 1930 Vedaranyam Salt Satyagraha marchers under Rajaji.\n2. \"Katthiyinri ratthaminri yutthamonru varugudhu...\" is his legendary non-violent rallying song.\n3. The textbook poem 'Engal Tamil' is extracted from 'Namakkal Kavignar Paadalkal'.\n4. He composed praises supporting British rule and accepted a British Knighthood."}], "options": {"A": "All statements are correct", "B": "Statements 1, 4 are correct; 2, 3 false", "C": "Statements 2, 3, 4 are correct; 1 false", "D": "Statements 1, 2, 3 are correct; Statement 4 is false"}, "explanation": "Statement 4 is absurdly false; he was an ardent Gandhian freedom fighter who suffered imprisonment."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "1930ஆம் ஆண்டு இராசாசி தலைமையில் நடைபெற்ற வேதாரண்யம் உப்புச் சத்தியாக்கிரகத் தொண்டர்களுக்காகப் பாடல் இயற்றினார்.", "content_en": "Composed hymns for the 1930 Vedaranyam Salt Satyagraha marchers."}, {"id": "S2", "content_ta": "\"கத்தியின்றி ரத்தமின்றி யுத்தமொன்று வருகுது - சத்தியத்தின் நித்தியத்தை நம்பும்யாரும் சேருவீர்!\" என்பது இவர் பாடிய புகழ்பெற்ற பாடலாகும்.", "content_en": "Composed the iconic weaponless non-violent song."}, {"id": "S3", "content_ta": "இவரது 'எங்கள் தமிழ்' என்னும் பாடல் 'நாமக்கல் கவிஞர் பாடல்கள்' என்னும் நூலிலிருந்து எடுத்துத் தரப்பட்டுள்ளது.", "content_en": "Extracted from 'Namakkal Kavignar Paadalkal'."}, {"id": "S4", "content_ta": "இவர் ஆங்கில அரசுக்கு ஆதரவாகப் பாடல்கள் இயற்றி 'சர்' பட்டம் பெற்றவர்.", "content_en": "He composed verses praising the British and received a Knighthood."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 4, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statements", "national_movement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u1-005", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l2-ondralla-irandalla", "chapter_id": null, "topic_id": "udumalai-narayana-kavi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பகுத்தறிவுக் கவிராயர் உடுமலை நாராயணகவி பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. இவர் தமிழ்த் திரைப்படப் பாடலாசிரியராகவும் நாடக எழுத்தாளராகவும் பெரும் புகழ் பெற்றவர்.\n2. தமது பாடல்கள் மூலம் சமுதாயத்தில் நிலவிய மூடநம்பிக்கைகளை ஒழித்துப் பகுத்தறிவுக் கருத்துகளைப் பரப்பியவர்.\n3. நாட்டுப்புற இசையின் எளிமையைக் கையாண்டு பாமர மக்களும் உணரும் வகையில் கவிதைகள் எழுதியவர்.\n4. 'ஒன்றல்ல இரண்டல்ல தம்பி' என்னும் பாடலில் தமிழ்நாட்டின் நிலவளம், நீர்வளம், இலக்கிய வளம் மற்றும் வள்ளல்களின் கொடைத்திறனைப் பாடியுள்ளார்."}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்று 1, 2 மட்டும் சரி", "C": "கூற்று 1, 3 சரி; 2, 4 தவறு", "D": "கூற்று 4 மட்டும் சரி"}, "explanation": "உடுமலை நாராயணகவி திரைப்படப் பாடலாசிரியர், நாடக எழுத்தாளர், நாட்டுப்புற இசையால் பகுத்தறிவைப் பரப்பியவர். அனைத்துக் கூற்றுகளும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Udumalai Narayana Kavi:\n1. He achieved widespread renown as a Tamil film lyricist and playwright.\n2. Through his verses, he eradicated blind superstitions and disseminated rationalist ideals.\n3. He deployed the simplicity of rustic folk melodies to compose songs for common people.\n4. In 'Ondralla Irandalla', he sings of Tamil Nadu's fertility, literature, and patrons' munificence."}], "options": {"A": "All statements are correct", "B": "Statements 1 and 2 only are correct", "C": "Statements 1 and 3 are correct; 2 and 4 false", "D": "Only Statement 4 is correct"}, "explanation": "All four statements represent genuine textbook facts regarding Udumalai Narayana Kavi."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "இவர் தமிழ்த் திரைப்படப் பாடலாசிரியராகவும் நாடக எழுத்தாளராகவும் பெரும் புகழ் பெற்றவர்.", "content_en": "Renowned film lyricist and playwright."}, {"id": "S2", "content_ta": "தமது பாடல்கள் மூலம் சமுதாயத்தில் நிலவிய மூடநம்பிக்கைகளை ஒழித்துப் பகுத்தறிவுக் கருத்துகளைப் பரப்பியவர்.", "content_en": "Propagated rationalism combating superstitions."}, {"id": "S3", "content_ta": "நாட்டுப்புற இசையின் எளிமையைக் கையாண்டு பாமர மக்களும் உணரும் வகையில் கவிதைகள் எழுதியவர்.", "content_en": "Utilized simplicity of folk tunes for the masses."}, {"id": "S4", "content_ta": "'ஒன்றல்ல இரண்டல்ல தம்பி' என்னும் பாடலில் தமிழ்நாட்டின் நிலவளம், நீர்வளம், இலக்கிய வளம் மற்றும் வள்ளல்களின் கொடைத்திறனைப் பாடியுள்ளார்.", "content_en": "Sang of Tamil agrarian wealth and legendary patrons."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statements", "udumalai_narayana_kavi"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u1-006", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l2-ondralla-irandalla", "chapter_id": null, "topic_id": "udumalai-narayana-kavi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஒன்றல்ல இரண்டல்ல' பாடலில் குறிப்பிடப்படும் சங்க இலக்கியங்கள் மற்றும் வள்ளல்கள் குறித்த கூற்றுகளை ஆராய்க:\n1. பகைவரைப் போர்க்களத்தில் வென்ற வீரத்தைப் பாடுவது பரணி இலக்கியம் ஆகும்.\n2. பரிபாடல் என்பது பண்ணோடு பாடப்படும் சங்ககால இசைப்பாடல் நூலாகும்.\n3. முல்லைக் கொடி படர்வதற்குத் தன் தேரையே ஈந்தவன் வேள்பாரி; புலவரின் சொல்லுக்காகத் தன் தலையையே தரத் துணிந்தவன் குமண வள்ளல்.\n4. எட்டுத்தொகையும் திருக்குறளும் தமிழரின் இலக்கிய வளங்கள் அல்ல என்று உடுமலை நாராயணகவி பாடுகிறார்."}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்று 1, 2, 3 சரி; கூற்று 4 தவறு", "C": "கூற்று 1, 4 சரி; 2, 3 தவறு", "D": "கூற்று 2, 4 மட்டும் சரி"}, "explanation": "கூற்று 4 தவறானது; எட்டுத்தொகை, பரிபாடல், திருக்குறள், பரணி, கலம்பகம் ஆகியவற்றைத் தமிழின் இணையற்ற இலக்கியப் பெருஞ்செல்வம் என்று போற்றுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Sangam literature and patrons in 'Ondralla Irandalla':\n1. Parani is the literary genre singing victory over enemies on the battlefield.\n2. Paripaadal is an ancient Sangam musical poetry classic set to melodic pans.\n3. Vel Pari offered his chariot for a jasmine creeper; Kumana Vallal offered his head for a poet.\n4. Udumalai Narayana Kavi sings that Ettuthogai and Thirukkural are not literary riches."}], "options": {"A": "All statements are correct", "B": "Statements 1, 2, 3 are correct; Statement 4 is false", "C": "Statements 1, 4 are correct; 2, 3 false", "D": "Statements 2 and 4 only are correct"}, "explanation": "Statements 1, 2, and 3 are correct; Statement 4 is false because the poet extols these classics as supreme treasures."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பகைவரைப் போர்க்களத்தில் வென்ற வீரத்தைப் பாடுவது பரணி இலக்கியம் ஆகும்.", "content_en": "Parani sings battlefield triumph over enemies."}, {"id": "S2", "content_ta": "பரிபாடல் என்பது பண்ணோடு பாடப்படும் சங்ககால இசைப்பாடல் நூலாகும்.", "content_en": "Paripaadal is an ancient musical poetic anthology."}, {"id": "S3", "content_ta": "முல்லைக் கொடி படர்வதற்குத் தன் தேரையே ஈந்தவன் வேள்பாரி; புலவரின் சொல்லுக்காகத் தன் தலையையே தரத் துணிந்தவன் குமண வள்ளல்.", "content_en": "Pari gave his chariot; Kumanan offered his head for a poet's word."}, {"id": "S4", "content_ta": "எட்டுத்தொகையும் திருக்குறளும் தமிழரின் இலக்கிய வளங்கள் அல்ல என்று உடுமலை நாராயணகவி பாடுகிறார்.", "content_en": "Udumalai sings that Ettuthogai and Kural are not literary assets."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statements", "sangam_patrons"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u1-007", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l2-ondralla-irandalla", "chapter_id": null, "topic_id": "udumalai-narayana-kavi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்நாட்டின் இயற்கை மற்றும் நன்செய் வளம் குறித்து உடுமலை நாராயணகவி கூறும் கருத்துகளை ஆராய்க:\n1. தமிழ்நாட்டில் வீசும் தென்றல் காற்றில் தேன்மணம் கமழும் என்று பாடுகிறார்.\n2. சுவைமிகு செங்கனிகளும் பொன் போன்ற தானியக் கதிர்களும் தந்துதவும் நன்செய் நிலவளம் நிறைந்தது தமிழ்நாடு.\n3. தமிழ்நாட்டின் புகழைப் பாடத் தொடங்கினால் ஒப்புமை இல்லாத விந்தைகள் ஒன்றிரண்டல்ல, பலவாகும்.\n4. தமிழ்நாட்டில் நிலவளமும் நீர்வளமும் முற்றிலும் குறைந்து மக்கள் வறுமையில் வாடினர் என்று கூறுகிறார்."}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்று 1, 4 சரி; 2, 3 தவறு", "C": "கூற்று 1, 2, 3 சரி; கூற்று 4 தவறு", "D": "கூற்று 4 மட்டும் சரி"}, "explanation": "கூற்று 4 தவறானது. தமிழ்நாடு செங்கனியும் பொன்கதிரும் தந்துதவும் நன்செய் நிலவளமும் அருள்வளமும் நிறைந்தது என்று பாடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Examine the descriptions of Tamil agrarian landscape in 'Ondralla Irandalla':\n1. The southern breeze wafting across Tamil lands carries rich fragrance of wild honey.\n2. Fertile wet fields (Nansei) yield sweet ripe fruits and golden grains in abundance.\n3. The glorious marvels of Tamil Nadu are not one or two, but matchless and infinite.\n4. He states that land fertility and water vanished, leaving Tamils in acute famine."}], "options": {"A": "All statements are correct", "B": "Statements 1, 4 are correct; 2, 3 false", "C": "Statements 1, 2, 3 are correct; Statement 4 is false", "D": "Only Statement 4 is correct"}, "explanation": "Statements 1, 2, and 3 are correct; Statement 4 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "தமிழ்நாட்டில் வீசும் தென்றல் காற்றில் தேன்மணம் கமழும் என்று பாடுகிறார்.", "content_en": "The southern breeze carries the aroma of honey."}, {"id": "S2", "content_ta": "சுவைமிகு செங்கனிகளும் பொன் போன்ற தானியக் கதிர்களும் தந்துதவும் நன்செய் நிலவளம் நிறைந்தது தமிழ்நாடு.", "content_en": "Nansei wet soils yield ripe fruits and golden paddy ears."}, {"id": "S3", "content_ta": "தமிழ்நாட்டின் புகழைப் பாடத் தொடங்கினால் ஒப்புமை இல்லாத விந்தைகள் ஒன்றிரண்டல்ல, பலவாகும்.", "content_en": "Tamil marvels are countless and peerless."}, {"id": "S4", "content_ta": "தமிழ்நாட்டில் நிலவளமும் நீர்வளமும் முற்றிலும் குறைந்து மக்கள் வறுமையில் வாடினர் என்று கூறுகிறார்.", "content_en": "He states fertility and water vanished into famine."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statements", "nature_fertility"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u1-008", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l1-engal-tamil", "chapter_id": null, "topic_id": "namakkal-kavignar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): நாமக்கல் கவிஞர் வெ. இராமலிங்கனார் தீவிரமான பிரிட்டிஷ் ஆதரவாளர் ஆவார்.\nகாரணம் (R): காந்தியடிகளின் அகிம்சைக் கொள்கைகளால் ஈர்க்கப்பட்டு காந்தியத்தைப் பின்பற்றியதால் இவர் 'காந்தியக் கவிஞர்' என்று அழைக்கப்படுகிறார்."}], "options": {"A": "(A) மற்றும் (R) இரண்டும் சரி; (R) என்பது (A) விற்கு சரியான விளக்கம்", "B": "(A) மற்றும் (R) இரண்டும் சரி; ஆனால் விளக்கம் தவறு", "C": "(A) சரி, ஆனால் (R) தவறு", "D": "(A) தவறு, ஆனால் (R) சரி"}, "explanation": "கூற்று (A) முற்றிலும் தவறானது; நாமக்கல் கவிஞர் தீவிர விடுதலைப் போராட்ட வீரர், சிறை சென்ற தியாகி. காரணம் (R) சரியானது."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Namakkal Poet V. Ramalinganar was an ardent supporter of British imperial rule.\nReason (R): Inspired by Mahatma Gandhi's doctrines of Ahimsa, he is revered as 'Gandhian Poet'."}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation", "B": "Both are true, but (R) is not the correct explanation", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Assertion (A) is false as he was a patriotic freedom fighter; Reason (R) is true."}}, "question_data": {"assertion": "நாமக்கல் கவிஞர் வெ. இராமலிங்கனார் தீவிரமான பிரிட்டிஷ் ஆதரவாளர் ஆவார்.", "reason": "காந்தியடிகளின் அகிம்சைக் கொள்கைகளால் ஈர்க்கப்பட்டு காந்தியத்தைப் பின்பற்றியதால் இவர் 'காந்தியக் கவிஞர்' என்று அழைக்கப்படுகிறார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "namakkal_kavignar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u1-009", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l1-engal-tamil", "chapter_id": null, "topic_id": "namakkal-kavignar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): \"கொல்லா விரதம் குறியாகக் கொள்கை பொய்யா நெறியாக\" என்று நாமக்கல் கவிஞர் தமிழர்களின் வாழ்வியல் வழியைப் பாடுகிறார்.\nகாரணம் (R): தமிழர்கள் எல்லா உயிர்களிடத்தும் அன்பு செலுத்தி, எந்த உயிரையும் கொல்லாமையைக் குறிக்கோளாகவும், பொய் பேசாமையைக் கொள்கையாகவும் கொண்டு வாழ வேண்டும் என்பது இதன் உட்பொருளாகும்."}], "options": {"A": "(A) மற்றும் (R) இரண்டும் சரி; (R) என்பது (A) விற்கு சரியான விளக்கம்", "B": "(A) மற்றும் (R) இரண்டும் சரி; ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கம் அல்ல", "C": "(A) சரி, (R) தவறு", "D": "(A) தவறு, (R) சரி"}, "explanation": "கூற்றும் காரணமும் சரியானவை; மேலும் காரணம் கூற்றுக்குத் துல்லியமான விளக்கமாக அமைகிறது."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): In 'Engal Tamil', Namakkal Kavignar proclaims non-killing as life's goal and non-lying as core principle.\nReason (R): The inner philosophy urges Tamils to shower compassion on all beings, taking Ahimsa as the ideal and truthfulness as moral duty."}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation of (A)", "B": "Both are true, but (R) is not the correct explanation", "C": "(A) is true, (R) is false", "D": "(A) is false, (R) is true"}, "explanation": "Both assertion and reason are factually accurate, with the reason correctly explaining the poetic premise."}}, "question_data": {"assertion": "\"கொல்லா விரதம் குறியாகக் கொள்கை பொய்யா நெறியாக\" என்று நாமக்கல் கவிஞர் தமிழர்களின் வாழ்வியல் வழியைப் பாடுகிறார்.", "reason": "தமிழர்கள் எல்லா உயிர்களிடத்தும் அன்பு செலுத்தி, எந்த உயிரையும் கொல்லாமையைக் குறிக்கோளாகவும், பொய் பேசாமையைக் கொள்கையாகவும் கொண்டு வாழ வேண்டும் என்பது இதன் உட்பொருளாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "gandhian_ideology"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u1-010", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l1-engal-tamil", "chapter_id": null, "topic_id": "namakkal-kavignar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தமிழ் மொழியைக் கற்ற சான்றோர்கள் பொருள் பெறுவதற்காக யாரையும் புகழ்ந்து பேச மாட்டார்கள்.\nகாரணம் (R): தமிழ்மொழி அருளும் அறமும் ஊட்டி அச்சத்தைப் போக்கி இன்பம் தரும் தேன் போன்ற இனிமையான மொழியாகும்."}], "options": {"A": "(A) மற்றும் (R) இரண்டும் சரி; (R) என்பது (A) விற்கு சரியான விளக்கம்", "B": "(A) மற்றும் (R) இரண்டும் சரி; ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கம் அல்ல", "C": "(A) சரி, (R) தவறு", "D": "(A) தவறு, (R) சரி"}, "explanation": "இரண்டு கூற்றுகளும் பாடநூலின்படி சரியானவை; ஆனால் சான்றோர்களின் சுயமரியாதைப் பண்பிற்குக் காரணம் அவர்கள் பொருளை விட ஒழுக்கத்தை நேசிப்பதே ஆகும்; எனவே (R) என்பது (A)விற்கு நேரடி விளக்கம் அல்ல."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Learned scholars who mastered Tamil will never flatter anyone merely for monetary riches.\nReason (R): Tamil is a honey-sweet tongue that inculcates virtue, dispels fear, and yields eternal bliss."}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation", "B": "Both (A) and (R) are true, but (R) is not the correct explanation of (A)", "C": "(A) is true, (R) is false", "D": "(A) is false, (R) is true"}, "explanation": "Both statements are true facts from the text, but the sweet nature of Tamil is not the direct causal reason for scholars' refusal to flatter."}}, "question_data": {"assertion": "தமிழ் மொழியைக் கற்ற சான்றோர்கள் பொருள் பெறுவதற்காக யாரையும் புகழ்ந்து பேச மாட்டார்கள்.", "reason": "தமிழ்மொழி அருளும் அறமும் ஊட்டி அச்சத்தைப் போக்கி இன்பம் தரும் தேன் போன்ற இனிமையான மொழியாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "scholar_ethics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u1-011", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l1-engal-tamil", "chapter_id": null, "topic_id": "namakkal-kavignar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): \"கத்தியின்றி ரத்தமின்றி யுத்தமொன்று வருகுது\" என்னும் பாடல் உப்புச் சத்தியாக்கிரகத் தொண்டர்களுக்கு மாபெரும் வீர எழுச்சியை ஊட்டியது.\nகாரணம் (R): இப்பாடல் ஆங்கிலேயர்களை வன்முறையான ஆயுதப் போரில் நேரடியாகத் தாக்க வேண்டும் என்று அழைப்பு விடுத்தது."}], "options": {"A": "(A) மற்றும் (R) இரண்டும் சரி", "B": "(A) தவறு, (R) சரி", "C": "(A) சரி, ஆனால் (R) தவறு", "D": "(A) மற்றும் (R) இரண்டும் தவறு"}, "explanation": "கூற்று (A) சரி; ஆனால் காரணம் (R) முற்றிலும் தவறு. இப்பாடல் வாளும் ரத்தமும் இல்லாத அகிம்சை சத்தியாகிரக அறப்போரை வலியுறுத்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): The song \"Katthiyinri ratthaminri yutthamonru varugudhu\" inspired immense courage among Salt Satyagrahis.\nReason (R): This song urged volunteers to engage in direct violent armed combat against the British."}], "options": {"A": "Both (A) and (R) are true", "B": "(A) is false, (R) is true", "C": "(A) is true, but (R) is false", "D": "Both (A) and (R) are false"}, "explanation": "Assertion (A) is correct; Reason (R) is false because the song champions non-violence (Ahimsa), not armed violence."}}, "question_data": {"assertion": "\"கத்தியின்றி ரத்தமின்றி யுத்தமொன்று வருகுது\" என்னும் பாடல் உப்புச் சத்தியாக்கிரகத் தொண்டர்களுக்கு மாபெரும் வீர எழுச்சியை ஊட்டியது.", "reason": "இப்பாடல் ஆங்கிலேயர்களை வன்முறையான ஆயுதப் போரில் நேரடியாகத் தாக்க வேண்டும் என்று அழைப்பு விடுத்தது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 4, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "salt_satyagraha"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u1-012", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l1-engal-tamil", "chapter_id": null, "topic_id": "namakkal-kavignar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): எதுகைத் தொடையில் முதல் எழுத்துகள் எப்போதும் வேறுபட்ட மாத்திரை அளவுகளில் அமையலாம் (குறிலும் நெடிலும் கலக்கலாம்).\nகாரணம் (R): எதுகைத் தொடையின் அடிப்படை விதியின்படி அடிகளில் இரண்டாம் எழுத்து மட்டுமே ஒன்றி வர வேண்டும்; முதல் எழுத்து பற்றி எவ்வித நிபந்தனையும் இல்லை."}], "options": {"A": "(A) மற்றும் (R) இரண்டும் சரி", "B": "(A) சரி, (R) தவறு", "C": "(R) சரி, (A) தவறு", "D": "(A) மற்றும் (R) இரண்டும் தவறு"}, "explanation": "பாடநூல் இலக்கண விதி: எதுகைத் தொடையில் இரண்டாம் எழுத்து ஒன்றி வர வேண்டும்; மேலும் முதல் எழுத்து கட்டாயம் அளவொத்து (குறில்-குறில் / நெடில்-நெடில்) இருக்க வேண்டும். எனவே கூற்று, காரணம் இரண்டும் தவறானவை."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): In Edhugai, initial letters can freely possess differing mora lengths (short and long mixed).\nReason (R): According to the basic rule of Edhugai, only the second letter must match; there is no condition regarding initial letters."}], "options": {"A": "Both (A) and (R) are true", "B": "(A) is true, (R) is false", "C": "(R) is true, (A) is false", "D": "Both (A) and (R) are false"}, "explanation": "Both are false. In classical Edhugai, initial vowels MUST match in mora length (short with short, long with long)."}}, "question_data": {"assertion": "எதுகைத் தொடையில் முதல் எழுத்துகள் எப்போதும் வேறுபட்ட மாத்திரை அளவுகளில் அமையலாம் (குறிலும் நெடிலும் கலக்கலாம்).", "reason": "எதுகைத் தொடையின் அடிப்படை விதியின்படி அடிகளில் இரண்டாம் எழுத்து மட்டுமே ஒன்றி வர வேண்டும்; முதல் எழுத்து பற்றி எவ்வித நிபந்தனையும் இல்லை.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "prosody_rules"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u1-013", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l2-ondralla-irandalla", "chapter_id": null, "topic_id": "udumalai-narayana-kavi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): உடுமலை நாராயணகவி 'பகுத்தறிவுக் கவிராயர்' என்று மக்களால் போற்றிப் பாராட்டப்படுகிறார்.\nகாரணம் (R): இவர் தமது திரைப்படப் பாடல்கள் மற்றும் நாடகங்கள் வழியாகத் தமிழ் மக்களிடையே மலிந்திருந்த மூடநம்பிக்கைகளை ஒழித்துப் பகுத்தறிவுக் கருத்துகளைப் பரப்பினார்."}], "options": {"A": "(A) மற்றும் (R) இரண்டும் சரி; (R) என்பது (A) விற்கு சரியான விளக்கம்", "B": "(A) மற்றும் (R) இரண்டும் சரி; ஆனால் (R) என்பது (A) விற்கு சரியான விளக்கம் அல்ல", "C": "(A) சரி, (R) தவறு", "D": "(A) தவறு, (R) சரி"}, "explanation": "கூற்றும் காரணமும் முற்றிலும் சரியானவை; உடுமலை நாராயணகவி பகுத்தறிவைப் பரப்பியதால் 'பகுத்தறிவுக் கவிராயர்' எனப்பட்டார்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Udumalai Narayana Kavi is celebrated as 'Pagutharivu Kavirayar' (Rationalist Poet).\nReason (R): Through his film lyrics and stage dramas, he eradicated blind superstitions and widely propagated rationalist ideologies."}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation of (A)", "B": "Both are true, but (R) is not the correct explanation", "C": "(A) is true, (R) is false", "D": "(A) is false, (R) is true"}, "explanation": "Both assertion and reason are historically exact, with the reason fully validating the title."}}, "question_data": {"assertion": "உடுமலை நாராயணகவி 'பகுத்தறிவுக் கவிராயர்' என்று மக்களால் போற்றிப் பாராட்டப்படுகிறார்.", "reason": "இவர் தமது திரைப்படப் பாடல்கள் மற்றும் நாடகங்கள் வழியாகத் தமிழ் மக்களிடையே மலிந்திருந்த மூடநம்பிக்கைகளை ஒழித்துப் பகுத்தறிவுக் கருத்துகளைப் பரப்பினார்.", "statements": 