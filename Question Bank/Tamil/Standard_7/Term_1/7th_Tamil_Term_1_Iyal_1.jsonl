{"id": "7th-t1-u1-056", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l3-pechu-ezhuthu", "chapter_id": null, "topic_id": "bharathidasan-poem", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"எளியநடையில் தமிழ்நூல் எழுதிடவும் வேண்டும் - செந்தமிழைச் செழுந்தமிழாய்ச் செய்வதும் வேண்டும்\" என்று முழங்கிய புரட்சிக் கவிஞர் யார்?"}], "options": {"A": "சுப்பிரமணிய பாரதியார்", "B": "நாமக்கல் கவிஞர்", "C": "வாணிதாசன்", "D": "பாவேந்தர் பாரதிதாசன்"}, "explanation": "பாடநூல் குறிப்பு: புரட்சிக் கவிஞர் பாரதிதாசன் செந்தமிழைச் செழுந்தமிழாக மாற்ற எளிய நடையில் நூல்கள் படைக்க வேண்டும் என்று பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which revolutionary poet proclaimed: \"Eliyanadaiyil Thamizhnool ezhudhidavum vendum... senthamizhaic sezhundhamizhaaic seivadhum vendum\"?"}], "options": {"A": "Subramania Bharati", "B": "Namakkal Kavignar", "C": "Vanidasan", "D": "Paavendhar Bharathidasan"}, "explanation": "Paavendhar Bharathidasan issued this iconic clarion call for modernizing Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", 