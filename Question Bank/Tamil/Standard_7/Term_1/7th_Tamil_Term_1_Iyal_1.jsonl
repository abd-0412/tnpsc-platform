{"id": "7th-t1-u1-073", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l5-kutriyalugaram", "chapter_id": null, "topic_id": "vallinam-compound", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வல்லின மெய்களையும் அவை உகரத்தோடு இணைந்து தோன்றும் குற்றியலுகர எழுத்துகளையும் பொருத்துக:\n(a) க் + உ - 1. சு\n(b) ச் + உ - 2. கு\n(c) ட் + உ - 3. து\n(d) த் + உ - 4. டு"}], "options": {"A": "a-2, b-1, c-4, d-3", "B": "a-1, b-2, c-4, d-3", "C": "a-2, b-4, c-1, d-3", "D": "a-3, b-1, c-2, d-4"}, "explanation": "க்+உ = கு (2); ச்+உ = சு (1); ட்+உ = டு (4); த்+உ = து (3). சரியான வரிசை: 2, 1, 4, 3."}, "en": {"blocks": [{"type": "text", "content": "Match the plosive consonants with their corresponding 'u' syllables:\n(a) k + u - 1. su\n(b) ch + u - 2. ku\n(c) t + u - 3. thu\n(d) th + u - 4. du"}], "options": {"A": "a-2, b-1, c-4, d-3", "B": "a-1, b-2, c-4, d-3", "C": "a-2, b-4, c-1, d-3", "D": "a-3, b-1, c-2, d-4"}, "explanation": "k+u = ku (2); ch+u = su (1); t+u = du (4); th+u = thu (3)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "க் + உ", "content_en": "k + u"}, {"id": "L2", "content_ta": "ச் + உ", "content_en": "ch + u"}, {"id": "L3", "content_ta": "ட் + உ", "content_en": "t + u"}, {"id": "L4", "content_ta": "த் + உ", "content_en": "th + u"}], "right": [{"id": "R1", "content_ta": "சு", "content_en": "su"}, {"id": "R2", "content_ta": "கு", "content_en": "ku"}, {"id": "R3", "content_ta": "து", "content_en": "thu"}, {"id": "R4", "content_ta": "டு", "content_en": "du"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order":