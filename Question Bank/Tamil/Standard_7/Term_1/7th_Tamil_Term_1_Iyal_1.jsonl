{"id": "7th-t1-u1-107", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l5-kutriyalugaram", "chapter_id": null, "topic_id": "identify-kutriyalugaram-type", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வரலாறு' - இச்சொல்லில் அமைந்துள்ள குற்றியலுகரத்தின் வகை யாது?"}], "options": {"A": "நெடில்தொடர்க் குற்றியலுகரம்", "B": "இடைத்தொடர்க் குற்றியலுகரம்", "C": "உயிர்த்தொடர்க் குற்றியலுகரம்", "D": "வன்றொடர்க் குற்றியலுகரம்"}, "explanation": "பாடநூல் விளக்கம்: 'வரலாறு' என்பதில் ஈற்றெழுத்து 'று' குற்றியலுகரம். அதற்கு முந்தைய எழுத்து 'லா' (ல் + ஆ). தனி நெடில் அல்லாமல் தொடர்ந்து வரும் உயிர்மெய் நெடிலை அடுத்து உகரம் அமைந்துள்ளதால் இது 'உயிர்த்தொடர்க் குற்றியலுகரம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the type of Kutriyalugaram exemplified in the word 'Varalaaru'?"}], "options": {"A": "Nedil-thodar Kutriyalugaram", "B": "Idai-thodar Kutriyalugaram", "C": "Uyirthodar Kutriyalugaram", "D": "Vanthodar Kutriyalugaram"}, "explanation": "Textbook explanation: In 'Varalaaru', 'la' (l + aa) precedes terminal 'ru'. Since it follows a non-initial vowel-consonant, it is Uyirthodar Kutriyalugaram."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "p