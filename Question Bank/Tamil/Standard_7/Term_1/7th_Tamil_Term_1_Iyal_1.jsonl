{"id": "7th-t1-u1-080", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l5-kutriyalugaram", "chapter_id": null, "topic_id": "odd-one-out", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உகர ஒலிப்பு முறை அடிப்படையில் பின்வரும் தொகுப்பில் பொருந்தாத சொல்லினைக் கண்டறிக:\nபசு, விடு, கரு, காது"}], "options": {"A": "பசு", "B": "விடு", "C": "கரு", "D": "காது (நெடில்தொடர்க் குற்றியலுகரம்; மற்றவை முற்றியலுகரச் சொற்கள்)"}, "explanation": "பாடநூல் மதிப்பீடு: பசு, விடு, கரு ஆகியவை தனிக்குறிலை அடுத்து வந்த முற்றியலுகரச் சொற்கள் (1 மாத்திரை). 'காது' என்பது நெடில்தொடர்க் குற்றியலுகரச் சொல் (0.5 மாத்திரை)."}, "en": {"blocks": [{"type": "text", "content": "Identify the odd one out based on phonological mora classification: Pasu, Vidu, Karu, Kaadhu"}], "options": {"A": "Pasu", "B": "Vidu", "C": "Karu", "D": "Kaadhu (Nedil-thodar Kutriyalugaram; others are Mutriyalugaram)"}, "explanation": "Kaadhu is Kutriyalugaram (half mora); the other three are Mutriyalugaram (full 1 mora)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 20, "chapter"