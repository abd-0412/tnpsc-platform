{"id": "7th-t1-u1-111", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l1-engal-tamil", "chapter_id": null, "topic_id": "gandhian-poet-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காந்தியடிகளின் கொள்கைகளால் பெரிதும் ஈர்க்கப்பட்டு, காந்தியக் கொள்கைகளைத் தம் கவிதைகள் வழியே பரப்பியதால் 'காந்தியக் கவிஞர்' என்று போற்றப்படுபவர் யார்?"}], "options": {"A": "பாரதியார்", "B": "பாரதிதாசன்", "C": "நாமக்கல் கவிஞர் வெ. இராமலிங்கனார்", "D": "உடுமலை நாராயணகவி"}, "explanation": "பாடநூல் குறிப்பு: காந்தியடிகளின் கொள்கைகளால் ஈர்க்கப்பட்டு காந்தியத்தை பரப்பியதால் நாமக்கல் கவிஞர் 'காந்தியக் கவிஞர்' என்று அழைக்கப்படுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Who is celebrated as the 'Gandhian Poet' for being profoundly inspired by Mahatma Gandhi and propagating his ideals through verses?"}], "options": {"A": "Subramaniya Bharathiyar", "B": "Bharathidasan", "C": "Namakkal Kavignar V. Ramalinganar", "D": "Udumalai Narayana Kavi"}, "explanation": "Textbook fact: Namakkal Kavignar V. Ramalinganar is honored as the Gandhian Poet."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "clas