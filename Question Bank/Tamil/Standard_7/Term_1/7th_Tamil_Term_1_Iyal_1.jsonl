{"id": "7th-t1-u1-027", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l1-engal-tamil", "chapter_id": null, "topic_id": "author-title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ்நாடு அரசின் முதல் அரசவைக் கவிஞராக நியமிக்கப்பட்டுச் சிறப்பிக்கப்பட்டவர் யார்?"}], "options": {"A": "பாரதிதாசன்", "B": "கண்ணதாசன்", "C": "நாமக்கல் கவிஞர் வெ. இராமலிங்கனார்", "D": "வாலி"}, "explanation": "நாமக்கல் கவிஞர் வெ. இராமலிங்கனார் தமிழ்நாடு அரசின் முதல் அரசவைக் கவிஞராகப் பொறுப்பு வகித்தார்."}, "en": {"blocks": [{"type": "text", "content": "Who was honored as the first Poet Laureate (Arasavai Kavignar) of the Tamil Nadu Government?"}], "options": {"A": "Bharathidasan", "B": "Kannadasan", "C": "Namakkal Poet V. Ramalinganar", "D": "Vaali"}, "explanation": "Namakkal Poet V. Ramalinganar had the distinction of serving as Tamil Nadu's first State Poet Laureate."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": fa