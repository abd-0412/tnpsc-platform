{"id": "7th-t1-u1-028", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l2-ondralla-irandalla", "chapter_id": null, "topic_id": "author-title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் மக்களால் 'பகுத்தறிவுக் கவிராயர்' என்று போற்றிப் பாராட்டப்படுபவர் யார்?"}], "options": {"A": "பட்டுக்கோட்டை கல்யாணசுந்தரம்", "B": "மருதகாசி", "C": "புலமைப்பித்தன்", "D": "உடுமலை நாராயணகவி"}, "explanation": "பாடநூல் குறிப்பு: பகுத்தறிவுக் கருத்துகளைத் தம் பாடல்கள் மூலம் மக்களிடையே பரப்பிய உடுமலை நாராயணகவி 'பகுத்தறிவுக் கவிராயர்' எனப் போற்றப்படுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Who is celebrated across Tamil Nadu as 'Pagutharivu Kavirayar' (The Rationalist Poet)?"}], "options": {"A": "Pattukkottai Kalyanasundaram", "B": "Maruthakasi", "C": "Pulamaipitthan", "D": "Udumalai Narayana Kavi"}, "explanation": "Udumalai Narayana Kavi is celebrated as Pagutharivu Kavirayar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 6, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previo