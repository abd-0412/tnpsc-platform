{"id": "7th-t1-u1-054", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l3-pechu-ezhuthu", "chapter_id": null, "topic_id": "odd-one-out", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மொழியியல் கூறுகள் பற்றிய இணைகளில் பொருந்தாத தவறான இணையைக் கண்டறிக:"}], "options": {"A": "பேச்சுமொழி - முதல் நிலை (உடனடிப் பயன்பாடு)", "B": "வரிவடிவம் - உடனடிப் பேச்சு ஒலி வடிவம் மட்டுமே", "C": "எழுத்துமொழி - இரண்டாம் நிலை (நீண்டகாலப் பயன்பாடு)", "D": "இரட்டை வழக்கு - பேச்சு மற்றும் எழுத்து வடிவம் கொண்ட மொழி"}, "explanation": "வரிவடிவம் என்பது எழுத்துமொழியின் நீண்டகாலப் பயன்பாட்டிற்குரியது; 'உடனடிப் பேச்சு ஒலி வடிவம்' என்பது தவறான இணையாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the mismatched linguistic pairing:"}], "options": {"A": "Spoken language - Primary stage (immediate use)", "B": "Written script - Immediate speech sound only", "C": "Written language - Secondary stage (enduring use)", "D": "Diglossia - Dual spoken and written registers"}, "explanation": "Pair B is mismatched because script represents the visual written code for preservation, not instantaneous acoustic speech."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "T