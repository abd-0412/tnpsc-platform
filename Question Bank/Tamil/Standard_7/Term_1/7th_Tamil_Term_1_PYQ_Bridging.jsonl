{"id": "7th-t1-pyq-386", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-grammar", "chapter_id": null, "topic_id": "sollin-selvar-case", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"சொல்லின் செல்வர்\" - இத்தொடரில் பயின்று வந்துள்ள வேற்றுமை உருபும் அதன் இலக்கணப் பொருளும் யாது?"}], "options": {"A": "மூன்றாம் வேற்றுமை கருவிப் பொருள்", "B": "ஐந்தாம் வேற்றுமை ஒப்பு / நீங்கள் பொருள்", "C": "ஏழாம் வேற்றுமை இடப் பொருள்", "D": "இரண்டாம் வேற்றுமை செயப்படுபொருள்"}, "explanation": "TNPSC PYQ இலக்கணக் குறிப்பு: சொல்லின் செல்வர் = சொல்லில் சிறந்த செல்வர். இங்கு 'இன்' என்னும் ஐந்தாம் வேற்றுமை உருபு ஒப்பு / சிறப்புப் பொருளில் பயின்று வந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "\"Sollin Selvar\" - Which case marker and grammatical sense are employed in this phrase?"}], "options": {"A": "Third case instrumental", "B": "Fifth case comparative / separation (In)", "C": "Seventh case locative", "D": "Second case accusative"}, "explanation": "TNPSC PYQ Fact: 'In' (இன்) is the fifth case suffix denoting distinction/comparison among speech exponents."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Serv