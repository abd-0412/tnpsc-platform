// ==============================================================================
// பகுதி 2: சார்பெழுத்துகள், குறுக்கங்கள் & இலக்கணப் பொறி வினாக்கள் [Q393 - Q420]
// குற்றியலுகர 6 வகை விதிகள், இடைத்தொடர் கட்டுப்பாடுகள், குற்றியலிகர புணர்ச்சி இடங்கள் (யகரம், மியா அசைச்சொல்), நால்வகை குறுக்கங்களின் மாத்திரை நுண் அளவுகள் (1½, 1, ¼ மாத்திரை), ஓரெழுத்து ஒருமொழி பொருள் நுட்பங்கள், பகுபத உறுப்பிலக்கணப் பிரிப்பு & புணர்ச்சி மரபுகள்
// ==============================================================================
{"id": "7th-t1-pyq-393", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-grammar", "chapter_id": null, "topic_id": "kurriyalugaram-traps-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குற்றியலுகரம் மற்றும் அதன் ஆறு வகைகள் குறித்த பின்வரும் இலக்கணப் பொறி விதிகளை ஆராய்க:\n1. தனி நெடிலை அடுத்து வரும் குற்றியலுகரம் 'நெடில்தொடர்க் குற்றியலுகரம்' எனப்படும்; இவை ஈரெழுத்துச் சொற்களாக மட்டுமே அமையும்.\n2. ஆய்த எழுத்தைத் தொடர்ந்து வரும் குற்றியலுகரம் 'ஆய்தத்தொடர்க் குற்றியலுகரம்' எனப்படும் (எ.கா: எஃகு, அஃது).\n3. தனிநெடில் அல்லாத உயிர்மெய் எழுத்தைத் தொடர்ந்து வரும் குற்றியலுகரம் 'உயிர்த்தொடர்க் குற்றியலுகரம்' எனப்படும் (எ.கா: அரசு, கயிறு).\n4. இடைத்தொடர்க் குற்றியலுகரத்தில் 'சு, டு, று' ஆகிய உகரங்களை ஈறாகக் கொண்ட சொற்கள் தமிழில் இல்லை.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2 மட்டுமே சரி", "C": "கூற்றுகள் 1, 3, 4 சரி; 2 தவறு", "D": "கூற்றுகள் 2, 4 மட்டுமே சரி"}, "explanation": "TNPSC இலக்கணக் குறிப்பு: நெடில்தொடர் ஈரெழுத்தாக மட்டுமே வரும்; அரசு/கயிறு உயிர்த்தொடர்; சு, டு, று இடைத்தொடரில் வாராது. இந்நான்கு விதிகளும் தொல்காப்பிய, நன்னூல் மரபார்ந்த TNPSC பொறி வினாக்களாகும். அனைத்தும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following advanced grammatical rules regarding Kurriyalugaram and its six varieties:\n1. Kurriyalugaram succeeding an isolated long syllable is Nedil Thodark Kurriyalugaram; these exist strictly as two-letter words.\n2. Kurriyalugaram succeeding the Ayudham letter is Ayudhat Thodark Kurriyalugaram (e.g., Ehgu, Ahdhu).\n3. Kurriyalugaram succeeding a non-long composite letter is Uyirt Thodark Kurriyalugaram (e.g., Arasu, Kayiru).\n4. In Idait Thodark Kurriyalugaram, words terminating in 'su, du, ru' do not exist in Tamil.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Only statements 1 and 2 are correct", "C": "Statements 1, 3, and 4 are correct; 2 is false", "D": "Only statements 2 and 4 are correct"}, "explanation": "TNPSC Grammar Fact: All four statements accurately define critical phonological constraints of Kurriyalugaram in classical Tamil grammar."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "நெடில்தொடர்க் குற்றியலுகரம் ஈரெழுத்துச் சொல்லாக மட்டுமே அமையும்.", "content_en": "Nedil Thodar words consist strictly of two letters."}, {"id": "S2", "content_ta": "ஆய்த எழுத்தைத் தொடர்ந்து வருவது ஆய்தத்தொடர்க் குற்றியலுகரம்.", "content_en": "Succeeding Ayudham is Ayudhat Thodar."}, {"id": "S3", "content_ta": "தனிநெடில் அல்லாத உயிர்மெய் அடுத்து வருவது உயிர்த்தொடர்.", "content_en": "Succeeding non-long syllable is Uyirt Thodar."}, {"id": "S4", "content_ta": "இடைத்தொடரில் 'சு, டு, று' ஈறாகக் கொண்ட சொற்கள் தமிழில் இல்லை.", "content_en": "'su, du, ru' endings do not exist in Idait Thodar."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "kurriyalugaram_traps"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-394", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-grammar", "chapter_id": null, "topic_id": "kurriyaligaram-rules-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குற்றியலிகரம் மற்றும் அதன் பயன்பாட்டு இடங்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. குற்றியலுகரச் சொற்களைத் தொடர்ந்து 'ய'கரத்தை முதலாகக் கொண்ட சொல் வரும்போது உகரம் இகரமாகத் திரியும் (எ.கா: கொக்கு + யாது = கொக்கியாது).\n2. 'மியா' என்னும் அசைச்சொல்லில் உள்ள 'மி'யில் உள்ள இகரம் தனக்குரிய ஒரு மாத்திரையிலிருந்து அரை மாத்திரையாகக் குறையும் (எ.கா: கேண்மியா).\n3. குற்றியலிகரம் தற்காலத்தில் உரைநடை வழக்கில் பெருமளவு பயன்படுத்தப்பட்டு வருகிறது.\n4. குற்றியலிகரத்திற்கு உரிய மாத்திரை அளவு அரை (½) மாத்திரை ஆகும்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2, 4 சரி; 3 தவறானது", "C": "கூற்றுகள் 1, 3 சரி; 2, 4 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "TNPSC இலக்கணக் குறிப்பு: கூற்று 3 தவறானது; ஏனெனில் குற்றியலிகரம் தற்காலத்தில் உரைநடை வழக்கில் இல்லை; செய்யுள் வழக்கில் மட்டுமே உள்ளது எனப் பாடநூல் தெளிவாகக் குறிப்பிடுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding Kurriyaligaram and its environments of occurrence:\n1. When a word beginning with 'Ya' succeeds a Kurriyalugaram word, 'u' mutates into 'i' (e.g., Kokku + Yaadhu = Kokkiyaadhu).\n2. In the expletive clitic 'Miya', the vowel in 'Mi' shortens from one mora to half a mora (e.g., Kaenmiya).\n3. Kurriyaligaram is extensively utilized in contemporary modern Tamil prose.\n4. The metric quantity of Kurriyaligaram is half (½) mora.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Statements 1, 2, and 4 are correct; 3 is incorrect", "C": "Statements 1 and 3 are correct; 2 and 4 are false", "D": "Statements 2, 3, and 4 are correct; 1 is false"}, "explanation": "TNPSC Grammar Fact: Statement 3 is false; modern prose has no Kurriyaligaram; it survives purely as a classical poetic phenomenon. Statements 1, 2, and 4 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "யகரம் வரும்போது உகரம் இகரமாகத் திரியும் (கொக்கியாது).", "content_en": "'u' mutates to 'i' before 'Ya' (Kokkiyaadhu)."}, {"id": "S2", "content_ta": "'மியா' அசைச்சொல்லில் உள்ள 'மி' அரை மாத்திரையாகக் குறையும்.", "content_en": "'Mi' in 'Miya' reduces to half mora."}, {"id": "S3", "content_ta": "குற்றியலிகரம் தற்கால உரைநடையில் மிகுதியாகப் பயன்படுகிறது.", "content_en": "Kurriyaligaram is widely used in modern prose."}, {"id": "S4", "content_ta": "குற்றியலிகரத்தின் மாத்திரை அளவு அரை மாத்திரை ஆகும்.", "content_en": "Metric duration of Kurriyaligaram is half mora."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 19, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "kurriyaligaram_pyq"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-395", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-grammar", "chapter_id": null, "topic_id": "aigaaram-owgaaram-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஐகாரக் குறுக்கம் மற்றும் ஔகாரக் குறுக்கம் குறித்த பின்வரும் மாத்திரை விதிகளை ஆராய்க:\n1. ஐகாரம் ஒரு சொல்லின் முதல், இடை, இறுதி ஆகிய மூன்று இடங்களிலும் வரும்.\n2. ஐகாரம் மொழிக்கு முதலில் வரும்போது ஒன்றரை (1½) மாத்திரையாகவும்; மொழிக்கு இடையிலும் இறுதியிலும் வரும்போது ஒரு (1) மாத்திரையாகவும் குறையும்.\n3. ஔகாரம் மொழிக்கு முதலிலும் இறுதியிலும் மட்டுமே வரும்; இடையில் வராது.\n4. ஔகாரம் மொழிக்கு முதலில் வரும்போது தனக்குரிய 2 மாத்திரையிலிருந்து ஒன்றரை (1½) மாத்திரையாகக் குறைந்து ஒலிக்கும்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2 மட்டுமே சரி", "C": "கூற்றுகள் 1, 2, 4 சரி; 3 தவறானது", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "TNPSC இலக்கணக் குறிப்பு: கூற்று 3 தவறானது; ஏனெனில் ஔகாரம் சொல்லின் இடையிலும் இறுதியிலும் ஒருபோதும் வாராது; மொழிக்கு முதலில் மட்டுமே வரும். கூற்றுகள் 1, 2, 4 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following metric rules regarding Aigaarak Kurukkam and Owgaarak Kurukkam:\n1. The diphthong 'Ai' appears in all three positions: initial, medial, and final in a word.\n2. 'Ai' reduces to 1½ morae in word-initial position, and to 1 mora in medial and final positions.\n3. The diphthong 'Ow' occurs only in initial and final positions of a word, never medially.\n4. 'Ow' shortens from its full 2 morae to 1½ morae when occurring at the beginning of a word.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Only statements 1 and 2 are correct", "C": "Statements 1, 2, and 4 are correct; 3 is incorrect", "D": "Statements 2, 3, and 4 are correct; 1 is false"}, "explanation": "TNPSC Grammar Fact: Statement 3 is incorrect; 'Ow' never occurs in the middle or end of words—it appears exclusively word-initially. Statements 1, 2, and 4 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ஐகாரம் முதல், இடை, இறுதி ஆகிய மூன்றிலும் வரும்.", "content_en": "'Ai' occurs initially, medially, and finally."}, {"id": "S2", "content_ta": "ஐகாரம் முதலில் 1½ மாத்திரையாகவும், இடை கடையில் 1 மாத்திரையாகவும் குறையும்.", "content_en": "'Ai' is 1½ initially, 1 medially and finally."}, {"id": "S3", "content_ta": "ஔகாரம் முதலிலும் இறுதியிலும் மட்டுமே வரும்.", "content_en": "'Ow' occurs initially and finally."}, {"id": "S4", "content_ta": "ஔகாரம் முதலில் வரும்போது 1½ மாத்திரையாகக் குறையும்.", "content_en": "'Ow' reduces to 1½ morae initially."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 40, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "shortened_diphthongs"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-396", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-grammar", "chapter_id": null, "topic_id": "magaram-aayudham-kurukkam-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மகரக் குறுக்கம் மற்றும் ஆய்தக் குறுக்கம் பற்றிய பின்வரும் இலக்கண விதிகளை ஆராய்க:\n1. மகர மெய்யெழுத்து (ம்) தனக்குரிய அரை மாத்திரையிலிருந்து கால் (¼) மாத்திரையாகக் குறைந்து ஒலிப்பது மகரக் குறுக்கம் எனப்படும்.\n2. மகர மெய்யைத் தொடர்ந்து 'வ'கர எழுத்து வரும்போது மகரக் குறுக்கம் ஏற்படும் (எ.கா: வலம் வந்தான்).\n3. செய்யுளில் 'போலும்' என்பது 'போன்ம்' என்றும், 'மருளும்' என்பது 'மருண்ம்' என்றும் திரியும்போது மகரம் கால் மாத்திரையாகக் குறையும்.\n4. 'முள் + தீது = முட்டீது', 'கல் + தீது = கஃறீது' எனப் புணரும்போது ஆய்த எழுத்து அரை மாத்திரையிலிருந்து கால் (¼) மாத்திரையாகக் குறைந்து ஒலிக்கும்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2 மட்டுமே சரி", "B": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "C": "கூற்றுகள் 1, 3 சரி; 2, 4 தவறு", "D": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி"}, "explanation": "TNPSC இலக்கணக் குறிப்பு: வகரத்தின் முன் மகரம் கால் மாத்திரை; போன்ம்/மருண்ம்-இல் கால் மாத்திரை; கஃறீது/முஃடீது-இல் ஆய்தம் கால் மாத்திரை. இந்நான்கு விதிகளும் பாடநூலில் உள்ளவாறு முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following grammatical rules regarding Magarak Kurukkam and Aayudhak Kurukkam:\n1. When the consonant 'm' shortens from its standard half mora to a quarter (¼) mora, it is Magarak Kurukkam.\n2. When followed by the letter 'v', the preceding 'm' undergoes shortening (e.g., Valam vandhaan).\n3. In poetic contraction where 'polum' becomes 'ponm' and 'marulum' becomes 'marunm', 'm' reduces to ¼ mora.\n4. In sandhi compounds like Mul + theedhu = Mutteedhu and Kal + theedhu = Kahreedhu, Ayudham shortens to ¼ mora.\nSelect the correct statements."}], "options": {"A": "Only statements 1 and 2 are correct", "B": "Statements 2, 3, and 4 are correct; 1 is false", "C": "Statements 1 and 3 are correct; 2 and 4 are false", "D": "All statements 1, 2, 3, and 4 are correct"}, "explanation": "TNPSC Grammar Fact: All four statements accurately articulate the rigorous phonological conditions governing the shortening of 'm' and Ayudham to ¼ mora."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "மகர மெய் அரை மாத்திரையிலிருந்து கால் மாத்திரையாகக் குறைவது மகரக் குறுக்கம்.", "content_en": "'m' reducing from ½ to ¼ mora is Magarak Kurukkam."}, {"id": "S2", "content_ta": "வகர எழுத்து வரும்போது மகரக் குறுக்கம் ஏற்படும் (வலம் வந்தான்).", "content_en": "'m' shortens before 'v' (Valam vandhaan)."}, {"id": "S3", "content_ta": "போன்ம், மருண்ம் சொற்களில் மகரம் கால் மாத்திரையாகக் குறையும்.", "content_en": "'m' reduces to ¼ mora in ponm, marunm."}, {"id": "S4", "content_ta": "கஃறீது, முஃடீது சொற்களில் ஆய்தம் கால் மாத்திரையாகக் குறையும்.", "content_en": "Ayudham reduces to ¼ mora in kahreedhu, muhdeedhu."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "magaram_aayudham_rules"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-397", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-grammar", "chapter_id": null, "topic_id": "orezhuthu-subtle-meanings", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஓரெழுத்து ஒருமொழியின் நுண்ணிய பொருள்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'ஏ' என்பது அம்பு என்னும் பொருளையும், 'ஐ' என்பது தலைவன் என்னும் பொருளையும் தரும்.\n2. 'ஓ' என்பது மதகுநீர் தாங்கும் பலகையையும், 'சோ' என்பது அரண் மதிலையும் குறிக்கும்.\n3. 'மா' என்பது மாமரம், பெரிய, விலங்கு உள்ளிட்ட பல பொருள்களைத் தரும் ஓரெழுத்து ஒருமொழியாகும்.\n4. 'நை' என்பது இழிவு என்னும் பொருளையும், 'நொ' என்பது நோய் என்னும் பொருளையும் உணர்த்தும்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2 மட்டுமே சரி", "C": "கூற்றுகள் 1, 3, 4 சரி; 2 தவறு", "D": "கூற்றுகள் 2, 4 மட்டுமே சரி"}, "explanation": "TNPSC இலக்கணக் குறிப்பு: ஏ-அம்பு, ஐ-தலைவன், ஓ-மதகுநீர் தாங்கும் பலகை, சோ-மதில், மா-பெரிய/மரம், நை-இழிவு, நொ-நோய். அனைத்துக் கூற்றுகளும் நன்னூல் அட்டவணையின்படி முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding specific meanings of single-letter words (Orezhuthu Orumozhi):\n1. 'Ee' (ஏ) signifies 'arrow', and 'Ai' (ஐ) signifies 'leader / master'.\n2. 'O' (ஓ) signifies 'sluice plank holding water', and 'So' (சோ) signifies 'fortress wall'.\n3. 'Maa' (மா) is a polysemous single-letter word denoting mango tree, great, animal, and more.\n4. 'Nai' (நை) denotes 'degradation / insult', and 'No' (நொ) denotes 'disease / pain'.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Only statements 1 and 2 are correct", "C": "Statements 1, 3, and 4 are correct; 2 is false", "D": "Only statements 2 and 4 are correct"}, "explanation": "TNPSC Grammar Fact: All four statements accurately reflect the lexical definitions of single-letter words codified in Nannool. All statements are true."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ஏ - அம்பு, ஐ - தலைவன்.", "content_en": "Ee - arrow, Ai - leader."}, {"id": "S2", "content_ta": "ஓ - மதகுநீர் பலகை, சோ - மதில்.", "content_en": "O - sluice plank, So - fort wall."}, {"id": "S3", "content_ta": "மா - மாமரம், பெரிய, விலங்கு.", "content_en": "Maa - mango tree, great, beast."}, {"id": "S4", "content_ta": "நை - இழிவு, நொ - நோய்.", "content_en": "Nai - insult, No - disease."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 60, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "orezhuthu_semantics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-398", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-grammar", "chapter_id": null, "topic_id": "pagupatham-subtle-rules", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பகுபத உறுப்புகளின் நுண்ணிய இலக்கண விதிகள் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. பகுதி என்பது சொல்லின் முதலில் நின்று முதற்பொருளை உணர்த்தும் பகாப்பதமாகும்; இது பெரும்பாலும் ஏவல் வடிவில் அமையும்.\n2. விகுதி என்பது சொல்லின் இறுதியில் நின்று திணை, பால், எண், இடம் ஆகியவற்றுடன் எப்போதும் காலத்தையும் தெளிவாகக் காட்டும்.\n3. எதிர்மறை இடைநிலைகளாக இல், அல், ஆ ஆகிய உருபுகள் பயன்படுகின்றன (எ.கா: காணலள், பேசான்).\n4. இடைநிலைக்கும் விகுதிக்கும் இடையே பெரும்பாலும் இடம்பெறும் அசைச்சொல் 'சாரியை' எனப்படும்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 3, 4 சரி; 2 தவறானது", "C": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "TNPSC இலக்கணக் குறிப்பு: கூற்று 2 தவறானது; ஏனெனில் 'காலம் காட்டுவது' இடைநிலையின் பணியாகும்; விகுதியின் பணி அன்று. விகுதி திணை, பால், எண், இடம் அல்லது முற்று, எச்சம் மட்டுமே காட்டும். கூற்றுகள் 1, 3, 4 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding the nuanced grammatical rules of Pagupatham constituents:\n1. Paguthi (root) stands at the beginning, conveys primary meaning, is an indivisible morpheme, and generally takes an imperative tone.\n2. Viguthi (suffix) stands at the end and always conveys tense along with gender, number, and person.\n3. Il, Al, and Aa function as negative infixes (e.g., Kaanalal, Paesaan).\n4. An expletive particle occurring predominantly between infix and suffix is Saariyai.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Statements 1, 3, and 4 are correct; 2 is incorrect", "C": "Statements 1 and 4 are correct; 2 and 3 are false", "D": "Statements 2, 3, and 4 are correct; 1 is false"}, "explanation": "TNPSC Grammar Fact: Statement 2 is incorrect; tense is denoted by the infix (Idainilai), not the suffix (Viguthi). Suffix denotes gender/person/finite status. Statements 1, 3, and 4 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பகுதி முதலில் நின்று முதற்பொருள் தரும் ஏவல் பகாப்பதம்.", "content_en": "Paguthi is the initial imperative root."}, {"id": "S2", "content_ta": "விகுதி எப்போதும் காலத்தையும் தெளிவாகக் காட்டும்.", "content_en": "Viguthi always conveys tense."}, {"id": "S3", "content_ta": "இல், அல், ஆ எதிர்மறை இடைநிலைகளாகும்.", "content_en": "Il, Al, Aa are negative infixes."}, {"id": "S4", "content_ta": "இடைநிலைக்கும் விகுதிக்கும் இடையே வருவது சாரியை.", "content_en": "Saariyai occurs between infix and suffix."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 61, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "morpheme_subtle_rules"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-399", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-grammar", "chapter_id": null, "topic_id": "pagaappatham-trap-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பகாப்பதம் மற்றும் வேர்ச்சொல் நுட்பங்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. பகாப்பதம் என்பது மேலும் பிரிக்க முடியாத அடிச்சொல் அல்லது வேர்ச்சொல்லாக அமையும்.\n2. பகாப்பதம் பெயர், வினை, இடை, உரி என நான்கு வகைப்படும்.\n3. 'கொல், தில், மன், போல்' என்பன தமிழில் 'வினைப் பகாப்பதங்கள்' ஆகும்.\n4. 'உறு, தவ, நனி, கூர், கழி' என்பன தமிழில் 'உரிப் பகாப்பதங்கள்' ஆகும்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2 மட்டுமே சரி", "C": "கூற்றுகள் 1, 2, 4 சரி; 3 தவறானது", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "TNPSC இலக்கணக் குறிப்பு: கூற்று 3 தவறானது; ஏனெனில் 'கொல், தில், மன், போல்' என்பன 'இடைப் பகாப்பதங்கள்' ஆகும்; வினைப் பகாப்பதங்கள் அல்ல. கூற்றுகள் 1, 2, 4 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding Pagaappatham and root morphemes:\n1. Pagaappatham is an indivisible base word or root that cannot be split into smaller morphemes.\n2. Pagaappatham is classified into four categories: noun, verb, medial particle, and qualifier particle.\n3. 'Kol, Thil, Man, Pol' are Verb Pagaappatham in Tamil.\n4. 'Uru, Thava, Nani, Koor, Kazhi' are Qualifier (Uri) Pagaappatham in Tamil.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Only statements 1 and 2 are correct", "C": "Statements 1, 2, and 4 are correct; 3 is incorrect", "D": "Statements 2, 3, and 4 are correct; 1 is false"}, "explanation": "TNPSC Grammar Fact: Statement 3 is false; 'Kol, Thil, Man, Pol' are Particle (Idai) Pagaappatham, not Verb Pagaappatham. Statements 1, 2, and 4 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பகாப்பதம் பிரிக்க முடியாத வேர்ச்சொல்லாக அமையும்.", "content_en": "Pagaappatham is an indivisible root word."}, {"id": "S2", "content_ta": "பகாப்பதம் பெயர், வினை, இடை, உரி என நால்வகைப்படும்.", "content_en": "Pagaappatham is of four types."}, {"id": "S3", "content_ta": "'கொல், தில், மன், போல்' என்பன வினைப் பகாப்பதங்கள்.", "content_en": "'Kol, Thil, Man, Pol' are Verb Pagaappatham."}, {"id": "S4", "content_ta": "'உறு, தவ, நனி, கூர், கழி' என்பன உரிப் பகாப்பதங்கள்.", "content_en": "'Uru, Thava, Nani, Koor, Kazhi' are Uri Pagaappatham."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 62, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "pagaappatham_traps"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-400", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-grammar", "chapter_id": null, "topic_id": "ar-kurriyalugaram-types-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று, காரணத்தை ஆராய்ந்து சரியான விடையைத் தேர்வு செய்க:\nகூற்று (A): 'பாக்கு', 'பஞ்சு' ஆகிய இரு சொற்களுள் 'பாக்கு' வன்தொடர்க் குற்றியலுகரமும், 'பஞ்சு' மென்தொடர்க் குற்றியலுகரமும் ஆகும்.\nகாரணம் (R): குற்றியலுகரத்திற்கு முன்னுள்ள ஈற்றயல் எழுத்து வல்லின மெய்யாக (க்) இருப்பின் வன்தொடர் எனவும், மெல்லின மெய்யாக (ஞ்) இருப்பின் மென்தொடர் எனவும் இலக்கணம் வரையறுக்கிறது."}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் சரியான விளக்கம் அல்ல", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் சரி; மேலும் காரணம் கூற்றை விளக்குகிறது"}, "explanation": "TNPSC இலக்கணக் குறிப்பு: ஈற்றயல் வல்லின மெய் எனில் வன்தொடர்; மெல்லின மெய் எனில் மென்தொடர். கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the assertion and reason and select the correct option:\nAssertion (A): Between the two words 'Paakku' and 'Panju', 'Paakku' is Van Thodark Kurriyalugaram and 'Panju' is Men Thodark Kurriyalugaram.\nReason (R): Grammar defines that if the penultimate consonant preceding Kurriyalugaram is a hard stop (k), it is Van Thodar; if a nasal (nj), it is Men Thodar."}], "options": {"A": "Assertion (A) is correct, but Reason (R) is false", "B": "Both (A) and (R) are correct, but (R) is not the correct explanation", "C": "Assertion (A) is false, but Reason (R) is correct", "D": "Both (A) and (R) are correct, and (R) is the correct explanation of (A)"}, "explanation": "TNPSC Grammar Fact: Both Assertion and Reason are correct; the penultimate consonant determines whether Kurriyalugaram is Van Thodar or Men Thodar."}}, "question_data": {"assertion": "'பாக்கு' வன்தொடர்க் குற்றியலுகரமும், 'பஞ்சு' மென்தொடர்க் குற்றியலுகரமும் ஆகும்.", "reason": "ஈற்றயல் எழுத்து வல்லின மெய்யாக இருப்பின் வன்தொடர் எனவும், மெல்லின மெய்யாக இருப்பின் மென்தொடர் எனவும் வரையறுக்கப்படுகிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 18, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "kurriyalugaram_classification"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-401", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-grammar", "chapter_id": null, "topic_id": "ar-magarak-kurukkam-condition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று, காரணத்தை ஆராய்ந்து சரியான விடையைத் தேர்வு செய்க:\nகூற்று (A): \"வலம் வந்தான்\" என்னும் தொடரில் உள்ள நிலைமொழி ஈற்று மகர மெய்யெழுத்து தனக்குரிய அரை மாத்திரையிலிருந்து கால் (¼) மாத்திரையாகக் குறைந்து ஒலிக்கும்.\nகாரணம் (R): நிலைமொழி ஈற்றில் மகர மெய் இருந்து, வருமொழி முதலில் வல்லின எழுத்துகள் வரும்போது மட்டுமே மகரக் குறுக்கம் ஏற்படும்."}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் சரியான விளக்கம் அல்ல", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "TNPSC இலக்கணக் குறிப்பு: காரணம் (R) தவறானது; ஏனெனில் மகர மெய்யைத் தொடர்ந்து 'வ'கர எழுத்து வரும்போது மட்டுமே மகரக் குறுக்கம் ஏற்படும்; வல்லின எழுத்து வரும்போது மகரக் குறுக்கம் ஏற்படாது. கூற்று (A) சரியானது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the assertion and reason and select the correct option:\nAssertion (A): In the phrase \"Valam vandhaan\", the terminal consonant 'm' of the preceding word shortens from its half mora to a quarter (¼) mora.\nReason (R): Magarak Kurukkam occurs strictly when the standing word ends in 'm' and the succeeding word begins with hard stop consonants (vallinam)."}], "options": {"A": "Assertion (A) is correct, but Reason (R) is false", "B": "Both (A) and (R) are correct, but (R) is not the correct explanation", "C": "Assertion (A) is false, but Reason (R) is correct", "D": "Both (A) and (R) are false"}, "explanation": "TNPSC Grammar Fact: Reason (R) is false; Magarak Kurukkam occurs when 'm' is followed specifically by the semi-vowel 'v', never by hard stops (vallinam). Assertion (A) is correct."}}, "question_data": {"assertion": "\"வலம் வந்தான்\" என்னும் தொடரில் உள்ள மகர மெய் தனக்குரிய அரை மாத்திரையிலிருந்து கால் மாத்திரையாகக் குறைந்து ஒலிக்கும்.", "reason": "நிலைமொழி ஈற்றில் மகர மெய் இருந்து வருமொழி முதலில் வல்லின எழுத்து வரும்போது மட்டுமே மகரக் குறுக்கம் ஏற்படும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "magarak_kurukkam_rule"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-402", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-grammar", "chapter_id": null, "topic_id": "ar-kurriyaligaram-phonology", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று, காரணத்தை ஆராய்ந்து சரியான விடையைத் தேர்வு செய்க:\nகூற்று (A): 'கொக்கியாது' (கொக்கு + யாது) என்னும் புணர்ச்சிச் சொல்லில் குற்றியலிகரம் இடம் பெற்றுள்ளது.\nகாரணம் (R): குற்றியலிகரம் மற்றும் குற்றியலுகரம் ஆகிய இரண்டு சார்பெழுத்துகளுமே தனித்து இயங்காது; சொல்லோடு இணைந்தே ஒலிக்கும் தன்மையுடையவை."}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் கூற்றின் சரியான விளக்கம் அல்ல", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "TNPSC இலக்கணக் குறிப்பு: கூற்று (A) சரி ('கொக்கியாது' குற்றியலிகரம்); காரணம் (R) சரி (சார்பெழுத்துகள் தனித்து இயங்காமை); ஆனால் கொக்கியாது தோன்றியதற்கான காரணம் யகர வருமொழி விதி; சார்பெழுத்துகளின் பொது இயல்பு அன்று. எனவே B சரியான விடை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the assertion and reason and select the correct option:\nAssertion (A): In the sandhi compound 'Kokkiyaadhu' (Kokku + Yaadhu), Kurriyaligaram is present.\nReason (R): Both secondary letter classes, Kurriyaligaram and Kurriyalugaram, cannot function independently in isolation and exist strictly within words."}], "options": {"A": "Assertion (A) is correct, but Reason (R) is false", "B": "Both (A) and (R) are correct, but (R) is not the correct explanation of (A)", "C": "Assertion (A) is false, but Reason (R) is correct", "D": "Both (A) and (R) are false"}, "explanation": "TNPSC Grammar Fact: Both statements are true in phonology, but Reason (R) states a general trait of dependent letters rather than the specific rule creating 'Kokkiyaadhu'."}}, "question_data": {"assertion": "'கொக்கியாது' (கொக்கு + யாது) என்னும் புணர்ச்சிச் சொல்லில் குற்றியலிகரம் இடம் பெற்றுள்ளது.", "reason": "குற்றியலிகரம் மற்றும் குற்றியலுகரம் ஆகிய இரண்டு சார்பெழுத்துகளுமே தனித்து இயங்காது சொல்லோடு இணைந்தே ஒலிக்கும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 19, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "kurriyaligaram_sandhi"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-403", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-grammar", "chapter_id": null, "topic_id": "ar-owvaiyaar-matra", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று, காரணத்தை ஆராய்ந்து சரியான விடையைத் தேர்வு செய்க:\nகூற்று (A): 'ஔவையார்' என்னும் சொல்லில் உள்ள 'ஔ' என்னும் நெடில் எழுத்து தனக்குரிய இரண்டு மாத்திரை அளவில் முழுமையாக ஒலிக்கிறது.\nகாரணம் (R): ஔகாரம் மொழிக்கு முதலில் வரும்போது தனக்குரிய இரண்டு மாத்திரையிலிருந்து ஒன்றரை (1½) மாத்திரையாகக் குறைந்து ஒலிப்பதே 'ஔகாரக் குறுக்கம்' எனப்படும்."}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "TNPSC இலக்கணக் குறிப்பு: 'ஔவையார்' என்பதில் ஔகாரம் சொல்லில் வரும்போது 1½ மாத்திரையாகக் குறுகி ஒலிக்கும்; 2 மாத்திரையாக முழுமையாக ஒலிக்காது. எனவே கூற்று (A) தவறு; காரணம் (R) சரியானது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the assertion and reason and select the correct option:\nAssertion (A): In the word 'Owwaiyaar', the initial long letter 'Ow' sounds fully in its full duration of two morae.\nReason (R): When 'Ow' appears word-initially, it shortens from its full two morae to one and a half (1½) morae, termed Owgaarak Kurukkam."}], "options": {"A": "Assertion (A) is correct, but Reason (R) is false", "B": "Both (A) and (R) are correct", "C": "Assertion (A) is false, but Reason (R) is correct", "D": "Both (A) and (R) are false"}, "explanation": "TNPSC Grammar Fact: Assertion (A) is false because in 'Owwaiyaar', 'Ow' is shortened to 1½ morae (Owgaarak Kurukkam), not its full 2 morae. Reason (R) is correct."}}, "question_data": {"assertion": "'ஔவையார்' என்னும் சொல்லில் உள்ள 'ஔ' என்னும் நெடில் தனக்குரிய இரண்டு மாத்திரை அளவில் முழுமையாக ஒலிக்கிறது.", "reason": "ஔகாரம் மொழிக்கு முதலில் வரும்போது தனக்குரிய இரண்டு மாத்திரையிலிருந்து ஒன்றரை மாத்திரையாகக் குறைந்து ஒலிப்பதே ஔகாரக் குறுக்கம் ஆகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "owgaaram_shortening"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-404", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-grammar", "chapter_id": null, "topic_id": "ar-aayudhak-kurukkam-sandhi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று, காரணத்தை ஆராய்ந்து சரியான விடையைத் தேர்வு செய்க:\nகூற்று (A): \"கல் + தீது = கஃறீது\" எனப் புணரும்போது அங்குத் தோன்றும் ஆய்த எழுத்து அரை மாத்திரையிலிருந்து கால் (¼) மாத்திரையாகக் குறைந்து ஒலிக்கும்.\nகாரணம் (R): லகர, ளகரங்களைத் தொடர்ந்து தகரம் வரும்போது புணர்ந்து தோன்றும் ஆய்த எழுத்து தனக்குரிய அரை மாத்திரையிலிருந்து கால் மாத்திரையாகக் குறைந்து ஒலிப்பது 'ஆய்தக் குறுக்கம்' எனப்படும்."}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் சரியான விளக்கம் அல்ல", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் சரி; மேலும் காரணம் கூற்றை விளக்குகிறது"}, "explanation": "TNPSC இலக்கணக் குறிப்பு: கல் + தீது = கஃறீது, முள் + தீது = முஃடீது ஆகியவற்றில் தோன்றும் ஆய்தம் கால் மாத்திரையாகக் குறுகும். கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the assertion and reason and select the correct option:\nAssertion (A): In the sandhi synthesis \"Kal + theedhu = Kahreedhu\", the resultant Ayudham letter reduces from half mora to a quarter (¼) mora.\nReason (R): When 'l' or 'lh' is succeeded by 'th', the synthesized Ayudham letter shortens from its standard half mora to a quarter mora, termed Aayudhak Kurukkam."}], "options": {"A": "Assertion (A) is correct, but Reason (R) is false", "B": "Both (A) and (R) are correct, but (R) is not the correct explanation", "C": "Assertion (A) is false, but Reason (R) is correct", "D": "Both (A) and (R) are correct, and (R) is the correct explanation of (A)"}, "explanation": "TNPSC Grammar Fact: Both Assertion and Reason are correct; the classical sandhi rule explicitly produces Ayudham shortened to a quarter mora (Aayudhak Kurukkam)."}}, "question_data": {"assertion": "\"கல் + தீது = கஃறீது\" எனப் புணரும்போது அங்குத் தோன்றும் ஆய்த எழுத்து அரை மாத்திரையிலிருந்து கால் மாத்திரையாகக் குறைந்து ஒலிக்கும்.", "reason": "லகர ளகரங்களைத் தொடர்ந்து தகரம் வரும்போது தோன்றும் ஆய்த எழுத்து அரை மாத்திரையிலிருந்து கால் மாத்திரையாகக் குறைந்து ஒலிப்பது ஆய்தக் குறுக்கம் ஆகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 42, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "aayudhak_kurukkam_proof"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-405", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-grammar", "chapter_id": null, "topic_id": "ar-orezhuthu-kuril-scholar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று, காரணத்தை ஆராய்ந்து சரியான விடையைத் தேர்வு செய்க:\nகூற்று (A): 'நொ', 'து' ஆகிய இரண்டு ஓரெழுத்து ஒருமொழிகளும் குறில் எழுத்துகளாகும்; அவற்றின் பொருள் முறையே நோய், உண் என்பதாகும்.\nகாரணம் (R): தொல்காப்பியர் தம்முடைய தொல்காப்பிய நூலில் தமிழில் 42 ஓரெழுத்து ஒருமொழிகள் உள்ளன எனப் பட்டியலிட்டுள்ளார்."}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் சரியான விளக்கம் அல்ல", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் சரி; மேலும் காரணம் கூற்றை விளக்குகிறது"}, "explanation": "TNPSC இலக்கணக் குறிப்பு: காரணம் (R) தவறானது; ஏனெனில் 42 ஓரெழுத்து ஒருமொழிகளைப் பட்டியலிட்டவர் நன்னூலார் பவணந்தி முனிவர் ஆவார்; தொல்காப்பியர் அல்ல. கூற்று (A) சரியானது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the assertion and reason and select the correct option:\nAssertion (A): 'No' and 'Thu' are the two short single-letter words; their meanings are 'disease' and 'eat' respectively.\nReason (R): Tolkappiyar in his treatise Tolkappiyam enumerated the list of 42 single-letter words in Tamil."}], "options": {"A": "Assertion (A) is correct, but Reason (R) is false", "B": "Both (A) and (R) are correct, but (R) is not the correct explanation", "C": "Assertion (A) is false, but Reason (R) is correct", "D": "Both (A) and (R) are correct, and (R) is the correct explanation of (A)"}, "explanation": "TNPSC Grammar Fact: Reason (R) is false; Pavanandhi Munivar in Nannool enumerated the 42 words, not Tolkappiyar. Assertion (A) is correct."}}, "question_data": {"assertion": "'நொ', 'து' ஆகிய இரண்டு ஓரெழுத்து ஒருமொழிகளும் குறில் எழுத்துகள்; அவற்றின் பொருள் நோய், உண் என்பதாகும்.", "reason": "தொல்காப்பியர் தம் தொல்காப்பிய நூலில் தமிழில் 42 ஓரெழுத்து ஒருமொழிகள் உள்ளன எனப் பட்டியலிட்டுள்ளார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 60, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "orezhuthu_author_pyq"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-406", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-grammar", "chapter_id": null, "topic_id": "match-kurukkam-matras", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறுக்கங்களையும் அவற்றிற்குரிய மாத்திரை அளவுகளையும் பொருத்துக:\n(a) ஐகாரம் மொழி முதல் வரும்போது - 1. ஒரு (1) மாத்திரை\n(b) ஐகாரம் மொழி இடை, கடையில் வரும்போது - 2. ஒன்றரை (1½) மாத்திரை\n(c) மகரக் குறுக்கம் மற்றும் ஆய்தக் குறுக்கம் - 3. அரை (½) மாத்திரை\n(d) ஆய்த எழுத்து தனித்து ஒலிக்கும்போது - 4. கால் (¼) மாத்திரை"}], "options": {"A": "a-1, b-3, c-4, d-2", "B": "a-2, b-1, c-4, d-3", "C": "a-3, b-2, c-1, d-4", "D": "a-2, b-4, c-3, d-1"}, "explanation": "TNPSC இலக்கணக் குறிப்பு: ஐகாரம் முதலில் 1½ (2), ஐகாரம் இடை/கடையில் 1 (1), மகர/ஆய்த குறுக்கம் ¼ (4), ஆய்தம் தனித்து ½ (3). சரியான பொருத்தம்: a-2, b-1, c-4, d-3."}, "en": {"blocks": [{"type": "text", "content": "Match the shortened sounds with their precise metric quantities (Morae):\n(a) 'Ai' in word-initial position - 1. One (1) mora\n(b) 'Ai' in medial and final positions - 2. One and a half (1½) morae\n(c) Magarak Kurukkam and Aayudhak Kurukkam - 3. Half (½) mora\n(d) Ayudham sounding independently - 4. Quarter (¼) mora"}], "options": {"A": "a-1, b-3, c-4, d-2", "B": "a-2, b-1, c-4, d-3", "C": "a-3, b-2, c-1, d-4", "D": "a-2, b-4, c-3, d-1"}, "explanation": "TNPSC Grammar Fact: Initial Ai -> 1½ (2), Medial/Final Ai -> 1 (1), Shortened m/Ayudham -> ¼ (4), Full Ayudham -> ½ (3). Correct match is a-2, b-1, c-4, d-3."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "ஐகாரம் மொழி முதல் வரும்போது", "content_en": "'Ai' in word-initial position"}, {"id": "L2", "content_ta": "ஐகாரம் மொழி இடை, கடையில் வரும்போது", "content_en": "'Ai' in medial/final positions"}, {"id": "L3", "content_ta": "மகரக் குறுக்கம் மற்றும் ஆய்தக் குறுக்கம்", "content_en": "Magarak and Aayudhak Kurukkam"}, {"id": "L4", "content_ta": "ஆய்த எழுத்து தனித்து ஒலிக்கும்போது", "content_en": "Ayudham sounding independently"}], "right": [{"id": "R1", "content_ta": "ஒரு (1) மாத்திரை", "content_en": "One (1) mora"}, {"id": "R2", "content_ta": "ஒன்றரை (1½) மாத்திரை", "content_en": "One and a half (1½) morae"}, {"id": "R3", "content_ta": "அரை (½) மாத்திரை", "content_en": "Half (½) mora"}, {"id": "R4", "content_ta": "கால் (¼) மாத்திரை", "content_en": "Quarter (¼) mora"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 40, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "match", "matra_measurements_match"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at"