{"id": "7th-t1-pyq-389", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-authors", "chapter_id": null, "topic_id": "odd-namakkal-works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்காணும் நூல்களுள் நாமக்கல் கவிஞர் வெ. இராமலிங்கனார் இயற்றாத (பொருந்தாத) நூல் எது?"}], "options": {"A": "மலைக்கள்ளன்", "B": "சுவரும் சுண்ணாம்பும்", "C": "என் கதை", "D": "சங்கொலி"}, "explanation": "TNPSC PYQ குறிப்பு: மலைக்கள்ளன், என் கதை, சங்கொலி ஆகியன நாமக்கல் கவிஞரின் நூல்கள். 'சுவரும் சுண்ணாம்பும்' என்பது உவமைக் கவிஞர் சுரதா இயற்றிய நூலாகும். எனவே அது பொருந்தாதது."}, "en": {"blocks": [{"type": "text", "content": "Which of the following literary works was NOT authored by Namakkal Kavignar V. Ramalinganar (odd one out)?"}], "options": {"A": "Malaikkallan", "B": "Suvarum Sunnaambum", "C": "En Kathai", "D": "Sangoli"}, "explanation": "TNPSC PYQ Fact: Malaikkallan, En Kathai, and Sangoli are works of Namakkal Kavignar; 'Suvarum Sunnaambum' was written by Suradha."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 3, "chapter": null, "sec