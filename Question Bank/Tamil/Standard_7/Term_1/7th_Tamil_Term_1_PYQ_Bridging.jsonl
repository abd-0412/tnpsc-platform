{"id": "7th-t1-pyq-418", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-grammar", "chapter_id": null, "topic_id": "odd-idait-thodark-kurriyalugaram", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்காண்பனவற்றுள் 'இடைத்தொடர்க் குற்றியலுகரச் சொல்லாக' அமையாத (பொருந்தாத) சொல் எது?"}], "options": {"A": "எய்து", "B": "மார்பு", "C": "சால்பு", "D": "மருந்து"}, "explanation": "TNPSC இலக்கணக் குறிப்பு: எய்து (ய்), மார்பு (ர்), சால்பு (ல்) ஆகியன இடையின மெய்களை அடுத்து வந்த இடைத்தொடர்க் குற்றியலுகரங்கள். 'மருந்து' (ந்) என்பது மெல்லின மெய்யை அடுத்து வந்த 'மென்தொடர்க் குற்றியலுகரம்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which of the following is NOT an Idait Thodark Kurriyalugaram word (odd one out)?"}], "options": {"A": "Eydhu", "B": "Maarbu", "C": "Saalbu", "D": "Marundhu"}, "explanation": "TNPSC Grammar Fact: Eydhu, Maarbu, and Saalbu are Idait Thodar; 'Marundhu' succeeds dental nasal 'n' (ந்), making it Men Thodar, hence the odd one out."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 18, "chapter": 