{"id": "7th-t1-pyq-391", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-authors", "chapter_id": null, "topic_id": "direct-first-court-poet", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "TNPSC முந்தைய ஆண்டு வினா: சுதந்திரத்திற்குப் பின் தமிழகத்தின் 'முதல் அரசவைக் கவிஞராக' நியமிக்கப்பட்டவர் யார்?"}], "options": {"A": "நாமக்கல் கவிஞர் வெ. இராமலிங்கனார்", "B": "கவிமணி தேசிக விநாயகம் பிள்ளை", "C": "பாவேந்தர் பாரதிதாசன்", "D": "உவமைக் கவிஞர் சுரதா"}, "explanation": "TNPSC PYQ குறிப்பு: தமிழகத்தின் முதல் அரசவைக் கவிஞராக நாமக்கல் கவிஞர் வெ. இராமலிங்கனார் நியமிக்கப்பட்டார் (பலமுறை TNPSC தேர்வுகளில் கேட்கப்பட்ட நேரடி வினா)."}, "en": {"blocks": [{"type": "text", "content": "TNPSC PYQ: Who was appointed as the very 'First Poet Laureate' (Arasavai Kavignar) of Tamil Nadu after independence?"}], "options": {"A": "Namakkal Kavignar V. Ramalinganar", "B": "Kavimani Desika Vinayagam Pillai", "C": "Pavendhar Bharathidasan", "D": "Uvamai Kavignar Suradha"}, "explanation": "TNPSC PYQ Fact: Namakkal Kavignar V. Ramalinganar was honored as the first Poet Laureate of Tamil Nadu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "direct_mcq", "first_court_poet_pyq"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-392", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-leaders", "chapter_id": null, "topic_id": "direct-thevar-stamp-year", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "TNPSC முந்தைய ஆண்டு வினா: இந்திய அஞ்சல் துறையால் பசும்பொன் உ. முத்துராமலிங்கத்தேவருக்கு நினைவு அஞ்சல் தலை வெளியிடப்பட்ட ஆண்டு எது?"}], "options": {"A": "1985", "B": "1990", "C": "1995", "D": "2000"}, "explanation": "TNPSC PYQ குறிப்பு: இந்திய அரசால் பசும்பொன் உ. முத்துராமலிங்கத்தேவருக்கு 1995-ஆம் ஆண்டு அஞ்சல் தலை வெளியிடப்பட்டது எனப் பாடநூல் குறிப்பிடுகிறது."}, "en": {"blocks": [{"type": "text", "content": "TNPSC PYQ: In which year did the Indian Postal Department release a commemorative postage stamp in honor of Pasumpon U. Muthuramalingathevar?"}], "options": {"A": "1985", "B": "1990", "C": "1995", "D": "2000"}, "explanation": "TNPSC PYQ Fact: The commemorative postage stamp for Pasumpon U. Muthuramalingathevar was issued in the year 1995."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 54, "chapter": null, "section": null, "refere