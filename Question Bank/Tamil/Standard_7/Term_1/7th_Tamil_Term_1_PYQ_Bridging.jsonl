// ==============================================================================
// 7-ஆம் வகுப்பு தமிழ் - பருவம் 1 - TNPSC முந்தைய ஆண்டு வினாக்கள் & பாடத்திட்ட இணைப்பு (மொத்த வினாக்கள்: 84)
// ==============================================================================

// ==============================================================================
// பகுதி 1: TNPSC 10 ஆண்டுகால முந்தைய தேர்வு வினாக்கள் - கவிஞர்கள் & பெருந்தலைவர்கள் [Q365 - Q392]
// நாமக்கல் கவிஞர் தமிழக முதல் அரசவைக் கவிஞர் சாதனைகள், உவமைக் கவிஞர் சுரதா விருதுகள் & இதழ்கள், பசும்பொன் முத்துராமலிங்கத்தேவர் முழக்கங்கள் & வரலாற்றுப் பாராட்டுரைகள் (சுத்தத் தியாகி, தென்னாட்டுச் சிங்கம், தேசியம் காத்த செம்மல்), கப்பலோட்டிய தமிழர் வ.உ.சி சுதேசி இயக்கம், சொல்லின் செல்வர் ரா.பி. சேதுப்பிள்ளை முதல் சாகித்திய அகாதெமி
// ==============================================================================
{"id": "7th-t1-pyq-365", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-authors", "chapter_id": null, "topic_id": "namakkal-kavignar-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாமக்கல் கவிஞர் வெ. இராமலிங்கனார் பற்றிய TNPSC முந்தைய ஆண்டுக் கூற்றுகளை ஆராய்க:\n1. தமிழகத்தின் முதல் அரசவைக் கவிஞராக விளங்கிய பெருமைக்குரியவர் நாமக்கல் கவிஞர்.\n2. காந்தியடிகளின் கொள்கைகளால் ஈர்க்கப்பட்டு காந்தியத்தை போற்றியதால் இவர் 'காந்தியக் கவிஞர்' என அழைக்கப்படுகிறார்.\n3. 1930 உப்பு சத்தியாக்கிரகத் தொண்டர்களுக்காக 'கத்தியின்றி ரத்தமின்றி யுத்தமொன்று வருகுது' என்ற புகழ்பெற்ற பாடலை இயற்றினார்.\n4. மலைக்கள்ளன், என் கதை, அவனும் அவளும், சங்கொலி உள்ளிட்ட பல நூல்களை இயற்றியுள்ளார்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2 மட்டுமே சரி", "C": "கூற்றுகள் 1, 3, 4 சரி; 2 தவறு", "D": "கூற்றுகள் 2, 4 மட்டுமே சரி"}, "explanation": "TNPSC PYQ குறிப்பு: தமிழக முதல் அரசவைக் கவிஞர்; காந்தியக் கவிஞர்; உப்பு சத்தியாக்கிரகப் பாடல் ஆசிரியர்; மலைக்கள்ளன், என் கதை ஆகிய நூல்களின் ஆசிரியர். நான்கு கூற்றுகளும் முற்றிலும் சரியானவை (TNPSC Group 4 & Group 2 பலமுறை கேட்கப்பட்ட வினாக்கள்)."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following TNPSC PYQ statements regarding Namakkal Kavignar V. Ramalinganar:\n1. He had the distinction of serving as the very first Poet Laureate (Arasavai Kavignar) of Tamil Nadu.\n2. Inspired by Mahatma Gandhi's ideals, he is celebrated as 'Gandhian Poet' (Gandhiya Kavignar).\n3. He composed the iconic marching anthem 'Katthiyinri Rathaminri Yuthamonru Varugudhu' for 1930 Salt Satyagrahis.\n4. His notable literary compositions include Malaikkallan, En Kathai, Avanum Avalum, and Sangoli.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Only statements 1 and 2 are correct", "C": "Statements 1, 3, and 4 are correct; 2 is false", "D": "Only statements 2 and 4 are correct"}, "explanation": "TNPSC PYQ Fact: All four statements regarding Namakkal Kavignar's official titles, Gandhian ethos, freedom movement anthem, and literary oeuvre are verified and thoroughly correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "தமிழகத்தின் முதல் அரசவைக் கவிஞராக விளங்கியவர் நாமக்கல் கவிஞர்.", "content_en": "First Poet Laureate of Tamil Nadu."}, {"id": "S2", "content_ta": "காந்திய நெறிகளைப் போற்றியதால் 'காந்தியக் கவிஞர்' என அழைக்கப்படுகிறார்.", "content_en": "Celebrated as Gandhian Poet."}, {"id": "S3", "content_ta": "உப்பு சத்தியாக்கிரகத்திற்கு 'கத்தியின்றி ரத்தமின்றி' பாடலை இயற்றினார்.", "content_en": "Composed Katthiyinri Rathaminri for Salt March."}, {"id": "S4", "content_ta": "மலைக்கள்ளன், என் கதை, சங்கொலி உள்ளிட்ட நூல்களை இயற்றினார்.", "content_en": "Authored Malaikkallan, En Kathai, Sangoli."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "namakkal_kavignar_pyq"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-366", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-authors", "chapter_id": null, "topic_id": "suradha-pyq-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உவமைக் கவிஞர் சுரதா பற்றிய பின்வரும் TNPSC தேர்வுசார் கூற்றுகளை ஆராய்க:\n1. சுரதாவின் இயற்பெயர் இராசகோபாலன்; பாரதிதாசன் மீது கொண்ட பற்றால் தம் பெயரை 'சுப்புரத்தினதாசன்' என மாற்றிக் கொண்டார்.\n2. உவமைகளைக் கையாண்டு கவிதை பாடுவதில் தனிச்சிறப்பு மிக்கவர் என்பதால் 'உவமைக் கவிஞர்' என அழைக்கப்படுகிறார்.\n3. இவருடைய 'தேன்மழை' என்னும் கவிதை நூல் தமிழக அரசின் தமிழ் வளர்ச்சித் துறைப் பரிசைப் பெற்றது.\n4. சாகித்திய அகாதெமி விருது பெற்ற முதல் தமிழ் கவிதை நூல் சுரதாவின் 'துறைமுகம்' ஆகும்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறானது", "C": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "TNPSC PYQ குறிப்பு: கூற்று 4 தவறானது; ஏனெனில் 'துறைமுகம்' சுரதாவின் புகழ்பெற்ற நூலாயினும், சாகித்திய அகாதெமி விருது பெற்ற முதல் தமிழ் நூல் ரா.பி. சேதுப்பிள்ளையின் 'தமிழின்பம்' (1955) ஆகும். கூற்றுகள் 1, 2, 3 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following TNPSC examination statements regarding poet Suradha:\n1. Suradha's birth name is Rasagopalan; out of reverence for Bharathidasan, he took the pen name 'Subburathinadasan'.\n2. Celebrated for his exceptional mastery of metaphors, he earned the title 'Uvamai Kavignar'.\n3. His poetry collection 'Thaenmazhai' won the Tamil Nadu State Government Literary Award.\n4. Suradha's 'Thuraimugam' was the very first poetry collection to receive the Sahitya Akademi Award in Tamil.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Statements 1, 2, 3 are correct; 4 is incorrect", "C": "Statements 1 and 4 are correct; 2 and 3 are false", "D": "Statements 2, 3, and 4 are correct; 1 is false"}, "explanation": "TNPSC PYQ Fact: Statement 4 is incorrect; 'Thuraimugam' is a famous work by Suradha, but the first Tamil book to win Sahitya Akademi was R.P. Sethupillai's 'Thamizhinbam'. Statements 1, 2, and 3 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "சுரதாவின் இயற்பெயர் இராசகோபாலன்; சுப்புரத்தினதாசன் எனப் பெயர் மாற்றினார்.", "content_en": "Birth name Rasagopalan, pen name Subburathinadasan."}, {"id": "S2", "content_ta": "உவமைகளைக் கையாள்வதில் வல்லவர் என்பதால் 'உவமைக் கவிஞர்' எனப்பட்டார்.", "content_en": "Celebrated as 'Uvamai Kavignar' for metaphors."}, {"id": "S3", "content_ta": "'தேன்மழை' தமிழக அரசின் தமிழ் வளர்ச்சித் துறைப் பரிசு பெற்றது.", "content_en": "'Thaenmazhai' won Tamil Nadu State Govt Award."}, {"id": "S4", "content_ta": "சுரதாவின் 'துறைமுகம்' முதல் சாகித்திய அகாதெமி விருது பெற்ற கவிதை நூல்.", "content_en": "Suradha's Thuraimugam was first Sahitya Akademi winner."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 25, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "suradha_pyq"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-367", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-leaders", "chapter_id": null, "topic_id": "thevar-pyq-milestones", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பசும்பொன் உ. முத்துராமலிங்கத்தேவர் பற்றிய பின்வரும் TNPSC வரலாற்றுத் தரவுக் கூற்றுகளை ஆராய்க:\n1. இவர் 1908 அக்டோபர் 30 அன்று பசும்பொன்னில் உக்கிரபாண்டித் தேவர் - இந்திராணி இணையருக்கு மகனாகப் பிறந்தார்.\n2. விவேகானந்தரின் பெருமையை சாயல்குடியில் மூன்று மணி நேரம் பேசி பெருந்தலைவர் காமராசரின் பாராட்டைப் பெற்றார்.\n3. ஆங்கிலேய அரசு 1934-இல் முத்துராமலிங்கத்தேவர் மீது விதித்திருந்த வாய்ப்பூட்டுச் சட்டத்தை உடனடியாக நீக்கியது.\n4. குற்றப்பரம்பரைச் சட்ட எதிர்ப்பு மாநாட்டை 1934 மே 12, 13 தேதிகளில் கமுதியில் வெற்றிகரமாக நடத்தினார்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2 மட்டுமே சரி", "C": "கூற்றுகள் 1, 2, 4 சரி; 3 தவறானது", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "TNPSC PYQ குறிப்பு: கூற்று 3 தவறானது; ஏனெனில் ஆங்கிலேய அரசு வாய்ப்பூட்டுச் சட்டத்தை நீக்கவில்லை; குற்றப்பரம்பரைச் சட்டமே பல தொடர் போராட்டங்களுக்குப் பின் 1948-இல் நீக்கப்பட்டது. கூற்றுகள் 1, 2, 4 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following TNPSC historical statements regarding Pasumpon U. Muthuramalingathevar:\n1. He was born on October 30, 1908, at Pasumpon to Ukkirapandiathevar and Indirani Ammaiyar.\n2. He delivered a historic 3-hour address on Swami Vivekananda at Sayalgudi, winning high praise from Kamarajar.\n3. The British Government immediately revoked the Gagging Act against Muthuramalingathevar in 1934.\n4. He successfully organized the Criminal Tribes Act Protest Conference on May 12 and 13, 1934, at Kamudhi.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Only statements 1 and 2 are correct", "C": "Statements 1, 2, and 4 are correct; 3 is incorrect", "D": "Statements 2, 3, and 4 are correct; 1 is false"}, "explanation": "TNPSC PYQ Fact: Statement 3 is false; the British never revoked the Gagging Act against him; the Criminal Tribes Act was repealed only in 1948 after sustained struggle. Statements 1, 2, and 4 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "1908 அக் 30 பசும்பொன்னில் உக்கிரபாண்டித் தேவர் - இந்திராணி அம்மையாருக்குப் பிறந்தார்.", "content_en": "Born Oct 30, 1908, to Ukkirapandian and Indirani."}, {"id": "S2", "content_ta": "சாயல்குடியில் விவேகானந்தர் உரை நிகழ்த்தி காமராசரின் பாராட்டைப் பெற்றார்.", "content_en": "Addressed on Vivekananda at Sayalgudi, lauded by Kamarajar."}, {"id": "S3", "content_ta": "1934-இல் ஆங்கிலேய அரசு வாய்ப்பூட்டுச் சட்டத்தை உடனடியாக நீக்கியது.", "content_en": "British revoked Gagging Act in 1934."}, {"id": "S4", "content_ta": "1934 மே 12, 13 கமுதியில் குற்றப்பரம்பரை எதிர்ப்பு மாநாடு நடத்தினார்.", "content_en": "Organized CTA protest conference at Kamudhi in May 1934."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "thevar_pyq_milestones"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-368", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-leaders", "chapter_id": null, "topic_id": "voc-pyq-swadeshi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வ.உ.சிதம்பரனார் மேற்கொண்ட சுதேசி விடுதலைப் பணிகள் குறித்த பின்வரும் TNPSC வினாத் தரவுகளை ஆராய்க:\n1. வ.உ.சிதம்பரனார் 1906 அக்டோபர் 16 அன்று 'சுதேசி நாவாய்ச் சங்கம்' (Swadeshi Steam Navigation Company) என்னும் நிறுவனத்தைப் பதிவு செய்தார்.\n2. இந்நிறுவனத்தின் தலைவராகப் பாண்டித்துரைத் தேவரும், செயலாளராக வ.உ.சிதம்பரனாரும் பொறுப்பேற்றனர்.\n3. எஸ்.எஸ். காலியா, எஸ்.எஸ். லாவோ என்னும் இரண்டு சுதேசிக் கப்பல்கள் தூத்துக்குடிக்கும் கொழும்புக்கும் இடையே இயக்கப்பட்டன.\n4. பிரிட்டிஷ் அடக்குமுறையால் கோவை மற்றும் கண்ணனூர் சிறைகளில் அடைக்கப்பட்டு செக்கிழுத்துக் கொடுந்துன்பம் அனுபவித்தார்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2 மட்டுமே சரி", "B": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "C": "கூற்றுகள் 1, 3 சரி; 2, 4 தவறு", "D": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி"}, "explanation": "TNPSC PYQ குறிப்பு: 1906 அக் 16 சுதேசி நாவாய்ச் சங்கம்; தலைவர் பாண்டித்துரைத் தேவர், செயலர் வ.உ.சி; காலியா, லாவோ கப்பல்கள்; கோவை, கண்ணனூர் சிறை செக்கிழுத்தல். இந்நான்கு வரலாற்றுத் தரவுகளும் பலமுறை TNPSC தேர்வுகளில் கேட்கப்பட்டவை; முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following TNPSC examination facts regarding V.O. Chidambaranar's Swadeshi movement:\n1. V.O. Chidambaranar officially registered the 'Swadeshi Steam Navigation Company' on October 16, 1906.\n2. Pandithurai Thevar served as President and V.O. Chidambaranar served as Secretary of this historic company.\n3. Two Swadeshi steamships, S.S. Gaelia and S.S. Lawoe, operated between Tuticorin and Colombo.\n4. Imprisoned under harsh colonial punishment at Coimbatore and Kannanoor jails, he was made to drag heavy oil mills.\nSelect the correct statements."}], "options": {"A": "Only statements 1 and 2 are correct", "B": "Statements 2, 3, and 4 are correct; 1 is false", "C": "Statements 1 and 3 are correct; 2 and 4 are false", "D": "All statements 1, 2, 3, and 4 are correct"}, "explanation": "TNPSC PYQ Fact: All four statements regarding the 1906 company registration, presidency of Pandithurai Thevar, vessels Gaelia and Lawoe, and hard labor in Coimbatore/Kannanoor jails are historically authentic and correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "1906 அக் 16 சுதேசி நாவாய்ச் சங்கம் பதிவு செய்யப்பட்டது.", "content_en": "Swadeshi Steam Navigation Co. registered Oct 16, 1906."}, {"id": "S2", "content_ta": "தலைவராக பாண்டித்துரைத் தேவரும் செயலாளராக வ.உ.சியும் இருந்தனர்.", "content_en": "Pandithurai Thevar was President, V.O.C Secretary."}, {"id": "S3", "content_ta": "காலியா, லாவோ கப்பல்கள் தூத்துக்குடி-கொழும்பு இடையே இயங்கின.", "content_en": "Gaelia and Lawoe sailed between Tuticorin and Colombo."}, {"id": "S4", "content_ta": "கோவை, கண்ணனூர் சிறைகளில் செக்கிழுத்துக் கொடுந்துன்பம் அடைந்தார்.", "content_en": "Pulled heavy oil mills in Coimbatore and Kannanoor jails."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 57, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "voc_swadeshi_pyq"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-369", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-authors", "chapter_id": null, "topic_id": "sethupillai-sahitya-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ரா.பி. சேதுப்பிள்ளை பற்றிய பின்வரும் TNPSC முந்தைய ஆண்டுக் கூற்றுகளை ஆராய்க:\n1. தம்முடைய இனிய அடுக்குமொழி உரைநடையால் 'சொல்லின் செல்வர்' என்று தமிழறிஞர்களால் போற்றப்பட்டவர்.\n2. 1955-ஆம் ஆண்டு சாகித்திய அகாதெமி விருது முதன்முதலில் வழங்கப்பட்டபோது, இவரது 'தமிழின்பம்' என்னும் நூலுக்கே அவ்விருது கிடைத்தது.\n3. ஆற்றங்கரையினிலே, கடற்கரையினிலே, தமிழகம் ஊரும் பேரும், மேடைப் பேச்சு உள்ளிட்ட பல சிறந்த நூல்களை இயற்றியுள்ளார்.\n4. இவர் ஒரு சிறந்த வழக்கறிஞராகவும், சென்னைப் பல்கலைக்கழகத் தமிழ்ப் பேராசிரியராகவும் தமிழ்த்தொண்டு ஆற்றினார்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2 மட்டுமே சரி", "C": "கூற்றுகள் 1, 3 சரி; 2, 4 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "TNPSC PYQ குறிப்பு: சொல்லின் செல்வர் பட்டம்; தமிழின்பம் 1955 முதல் சாகித்திய அகாதெமி; ஊரும் பேரும் ஆசிரியர்; வழக்கறிஞர் மற்றும் பேராசிரியர். நான்கு கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following TNPSC PYQ statements regarding scholar R. P. Sethupillai:\n1. Celebrated for his alliterative and resonant prose, scholars bestowed on him the title 'Sollin Selvar'.\n2. When the Sahitya Akademi Award was inaugurated in 1955, his essay collection 'Thamizhinbam' won the first award.\n3. His notable literary compositions include Aatrangkaraiyinile, Kadarkaraiyinile, Thamizhagam Oorum Paerum, and Maedaip Paechu.\n4. He rendered illustrious service both as an advocate and as Professor of Tamil at the University of Madras.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Only statements 1 and 2 are correct", "C": "Statements 1 and 3 are correct; 2 and 4 are false", "D": "Statements 2, 3, and 4 are correct; 1 is false"}, "explanation": "TNPSC PYQ Fact: All four statements regarding R.P. Sethupillai's title, 1955 Sahitya Akademi award, bibliography, and academic professorship are entirely accurate."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "அடுக்குமொழி உரைநடையால் 'சொல்லின் செல்வர்' என்று போற்றப்பட்டார்.", "content_en": "Celebrated as 'Sollin Selvar' for resonant prose."}, {"id": "S2", "content_ta": "1955-இல் இவரது 'தமிழின்பம்' முதல் சாகித்திய அகாதெமி விருது பெற்றது.", "content_en": "'Thamizhinbam' won first Sahitya Akademi award in 1955."}, {"id": "S3", "content_ta": "ஆற்றங்கரையினிலே, கடற்கரையினிலே, தமிழகம் ஊரும் பேரும் இயற்றினார்.", "content_en": "Authored Aatrangkaraiyinile, Kadarkaraiyinile, etc."}, {"id": "S4", "content_ta": "வழக்கறிஞராகவும் பேராசிரியராகவும் தமிழ்த்தொண்டு ஆற்றினார்.", "content_en": "Served as lawyer and Tamil Professor at Madras University."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 59, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "sethupillai_pyq"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-370", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-leaders", "chapter_id": null, "topic_id": "thevar-titles-eval", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்துராமலிங்கத்தேவரின் சிறப்புப் பெயர்கள் மற்றும் தலைவர்கள் பாராட்டு குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'சுத்தத் தியாகி' என்று தந்தை பெரியாரால் போற்றப்பட்டவர் முத்துராமலிங்கத்தேவர்.\n2. 'தென்னாட்டுச் சிங்கம்' என்று பேரறிஞர் அண்ணாவால் பாராட்டப்பட்டவர்.\n3. 'தேசியம் காத்த செம்மல்' என்று திரு.வி. கல்யாணசுந்தரனாரால் புகழப்பட்டவர்.\n4. 'வீரப் பேச்சால் தமிழகத்தை மாற்றியவர்' என்று மகாத்மா காந்தியடிகள் இவருக்குப் பட்டம் வழங்கினார்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறானது", "C": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "TNPSC PYQ குறிப்பு: கூற்று 4 தவறானது; ஏனெனில் காந்தியடிகள் இத்தகைய பட்டம் வழங்கவில்லை. பெரியார் (சுத்தத் தியாகி), அண்ணா (தென்னாட்டுச் சிங்கம்), திரு.வி.க (தேசியம் காத்த செம்மல்) பாராட்டிய கூற்றுகள் 1, 2, 3 மட்டுமே சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding Muthuramalingathevar's honorary titles and national leaders' accolades:\n1. Muthuramalingathevar was extolled as 'Sutha Thyaagi' (Pure Sacrificer) by Thanthai Periyar.\n2. He was celebrated as 'Thennaattu Singam' (Lion of the South) by Arignar Anna.\n3. He was decorated with the title 'Dhesiyam Kaatha Semmal' by Thiru. Vi. Kalyanasundaranar.\n4. Mahatma Gandhi officially conferred on him the title 'Hero who transformed Tamil Nadu by speech'.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Statements 1, 2, 3 are correct; 4 is incorrect", "C": "Statements 1 and 4 are correct; 2 and 3 are false", "D": "Statements 2, 3, and 4 are correct; 1 is false"}, "explanation": "TNPSC PYQ Fact: Statement 4 is incorrect; Mahatma Gandhi never conferred such a title. Statements 1 (Periyar), 2 (Anna), and 3 (Thiru. Vi. Ka) are historical facts."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "தந்தை பெரியாரால் 'சுத்தத் தியாகி' என்று பாராட்டப்பட்டார்.", "content_en": "Lauded as 'Sutha Thyaagi' by Periyar."}, {"id": "S2", "content_ta": "பேரறிஞர் அண்ணாவால் 'தென்னாட்டுச் சிங்கம்' என்று புகழப்பட்டார்.", "content_en": "Praised as 'Lion of South' by Anna."}, {"id": "S3", "content_ta": "திரு.வி.க-வால் 'தேசியம் காத்த செம்மல்' எனப் போற்றப்பட்டார்.", "content_en": "Titled 'Dhesiyam Kaatha Semmal' by Thiru. Vi. Ka."}, {"id": "S4", "content_ta": "மகாத்மா காந்தியடிகள் இவருக்கு அதிகாரப்பூர்வ பட்டம் வழங்கினார்.", "content_en": "Mahatma Gandhi officially gave him a title."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 53, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "thevar_titles_pyq"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-371", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-leaders", "chapter_id": null, "topic_id": "voc-literary-works-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வ.உ.சிதம்பரனாரின் இலக்கியப் பங்களிப்புகள் குறித்த பின்வரும் TNPSC வினாத் தரவுக் கூற்றுகளை ஆராய்க:\n1. வ.உ.சிதம்பரனார் மெய்யறிவு, மெய்யறம் ஆகிய சிறிய மெய்யியல் கவிதை நூல்களை இயற்றினார்.\n2. ஆங்கிலத்தில் ஜேம்ஸ் ஆலன் எழுதிய நூல்களை 'மனம்போல் வாழ்வு' உள்ளிட்ட தலைப்புகளில் தமிழில் மொழிபெயர்த்தார்.\n3. கம்பராமாயணத்திற்கு முழுமையான அரும்பத உரை எழுதி முதன்முதலில் பதிப்பித்தார்.\n4. திருக்குறளுக்கு மணக்குடவர் எழுதிய பழமையான உரையையும், தொல்காப்பியப் பொருளதிகாரத்தையும் ஆராய்ந்து பதிப்பித்தார்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2 மட்டுமே சரி", "C": "கூற்றுகள் 1, 2, 4 சரி; 3 தவறானது", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "TNPSC PYQ குறிப்பு: கூற்று 3 தவறானது; ஏனெனில் வ.உ.சி கம்பராமாயணத்திற்கு உரை எழுதவில்லை. திருக்குறள் மணக்குடவர் உரையையும், தொல்காப்பியப் பொருளதிகாரத்தையும் பதிப்பித்தார். மெய்யறிவு, மெய்யறம் நூல்களை எழுதினார்; ஜேம்ஸ் ஆலன் நூல்களை மொழிபெயர்த்தார். கூற்றுகள் 1, 2, 4 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following TNPSC examination facts regarding V.O. Chidambaranar's literary contributions:\n1. V.O. Chidambaranar authored philosophical poetic treatises including Meyyarivu and Meyyaram.\n2. He translated James Allen's English philosophical works into Tamil, including 'Manampol Vaazhvu'.\n3. He wrote an exhaustive commentary on Kamba Ramayanam and published it first.\n4. He edited and published the ancient commentary of Manakkudavar on Thirukkural and Tolkappiyam Porulathikaram.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Only statements 1 and 2 are correct", "C": "Statements 1, 2, and 4 are correct; 3 is incorrect", "D": "Statements 2, 3, and 4 are correct; 1 is false"}, "explanation": "TNPSC PYQ Fact: Statement 3 is incorrect; V.O.C never wrote a commentary on Kamba Ramayanam. He edited and published Manakkudavar's Thirukkural commentary and Tolkappiyam Porulathikaram. Statements 1, 2, and 4 are authentic."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "மெய்யறிவு, மெய்யறம் ஆகிய நூல்களை இயற்றினார்.", "content_en": "Authored Meyyarivu and Meyyaram."}, {"id": "S2", "content_ta": "ஜேம்ஸ் ஆலன் நூல்களை 'மனம்போல் வாழ்வு' என மொழிபெயர்த்தார்.", "content_en": "Translated James Allen's works as Manampol Vaazhvu."}, {"id": "S3", "content_ta": "கம்பராமாயணத்திற்கு முழுமையான அரும்பத உரை எழுதிப் பதிப்பித்தார்.", "content_en": "Wrote and published commentary on Kamba Ramayanam."}, {"id": "S4", "content_ta": "மணக்குடவர் திருக்குறள் உரையையும் தொல்காப்பியப் பொருளதிகாரத்தையும் பதிப்பித்தார்.", "content_en": "Edited and published Manakkudavar's Kural and Tolkappiyam."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 58, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "voc_literary_pyq"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-372", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-leaders", "chapter_id": null, "topic_id": "ar-voc-guru-friend-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று, காரணத்தை ஆராய்ந்து சரியான விடையைத் தேர்வு செய்க:\nகூற்று (A): வ.உ.சிதம்பரனார் தம் அரசியல் குருவாக பாலகங்காதர திலகரையும், உற்ற தோழராக மகாகவி பாரதியாரையும் ஏற்றுக்கொண்டார்.\nகாரணம் (R): பாரதியாரின் தீவிர விடுதலைப் பாடல்களைத் தூத்துக்குடி மக்களிடையே பரப்பியதோடு, திலகரின் சுதேசி கொள்கைகளைத் தமிழ்நாட்டில் கப்பல் நிறுவனமாக நடைமுறைப்படுத்தினார்."}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் சரியான விளக்கம் அல்ல", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் சரி; மேலும் காரணம் கூற்றை விளக்குகிறது"}, "explanation": "TNPSC PYQ குறிப்பு: வ.உ.சி-யின் அரசியல் குரு திலகர்; தோழர் பாரதியார். இருவரின் கொள்கைகளையும் தமிழ்நாட்டில் முழுமையாகப் பரப்பினார். கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the assertion and reason and select the correct option:\nAssertion (A): V.O. Chidambaranar revered Bal Gangadhar Tilak as his political guru and Mahakavi Bharathiyar as his close friend.\nReason (R): He propagated Bharathi's fiery patriotic anthems among Tuticorin citizens and practically translated Tilak's Swadeshi philosophy into an indigenous shipping enterprise in Tamil Nadu."}], "options": {"A": "Assertion (A) is correct, but Reason (R) is false", "B": "Both (A) and (R) are correct, but (R) is not the correct explanation", "C": "Assertion (A) is false, but Reason (R) is correct", "D": "Both (A) and (R) are correct, and (R) is the correct explanation of (A)"}, "explanation": "TNPSC PYQ Fact: Both Assertion and Reason are correct; V.O.C accepted Tilak as guru and Bharathi as comrade, translating their ideals into maritime action. Reason accurately explains Assertion."}}, "question_data": {"assertion": "வ.உ.சிதம்பரனார் தம் அரசியல் குருவாக பாலகங்காதர திலகரையும், உற்ற தோழராக மகாகவி பாரதியாரையும் ஏற்றுக்கொண்டார்.", "reason": "பாரதியாரின் விடுதலைப் பாடல்களைப் பரப்பியதோடு, திலகரின் சுதேசி கொள்கைகளைத் தமிழ்நாட்டில் கப்பல் நிறுவனமாக நடைமுறைப்படுத்தினார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 58, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "voc_guru_pyq"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-373", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-authors", "chapter_id": null, "topic_id": "ar-namakkal-gandhi-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று, காரணத்தை ஆராய்ந்து சரியான விடையைத் தேர்வு செய்க:\nகூற்று (A): நாமக்கல் கவிஞர் வெ. இராமலிங்கனார் 'காந்தியக் கவிஞர்' என்று தமிழக மக்களால் போற்றப்படுகிறார்.\nகாரணம் (R): இவர் காந்தியடிகளுடன் நேரடியாகத் தென்னாப்பிரிக்கா சென்று அங்கு நடைபெற்ற தொடக்கக்கால அறப்போராட்டங்களில் பங்குகொண்டார்."}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் சரியான விளக்கம் அல்ல", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் சரி; மேலும் காரணம் கூற்றை விளக்குகிறது"}, "explanation": "TNPSC PYQ குறிப்பு: காந்தியடிகளின் கொள்கைகளால் ஈர்க்கப்பட்டு காந்தியத்தைப் பாடியதால் இவர் 'காந்தியக் கவிஞர்' எனப்பட்டார். இவர் தென்னாப்பிரிக்கா செல்லவில்லை; எனவே காரணம் (R) தவறானது; கூற்று (A) சரியானது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the assertion and reason and select the correct option:\nAssertion (A): Namakkal Kavignar V. Ramalinganar is venerated as 'Gandhiya Kavignar' by the people of Tamil Nadu.\nReason (R): He travelled directly with Mahatma Gandhi to South Africa and actively took part in his earliest Satyagraha campaigns there."}], "options": {"A": "Assertion (A) is correct, but Reason (R) is false", "B": "Both (A) and (R) are correct, but (R) is not the correct explanation", "C": "Assertion (A) is false, but Reason (R) is correct", "D": "Both (A) and (R) are correct, and (R) is the correct explanation of (A)"}, "explanation": "TNPSC PYQ Fact: Namakkal Kavignar earned the moniker 'Gandhiya Kavignar' because he adhered to and poetically championed Gandhian principles in India; he never travelled to South Africa. Reason (R) is false, Assertion (A) is correct."}}, "question_data": {"assertion": "நாமக்கல் கவிஞர் வெ. இராமலிங்கனார் 'காந்தியக் கவிஞர்' என்று தமிழக மக்களால் போற்றப்படுகிறார்.", "reason": "இவர் காந்தியடிகளுடன் நேரடியாகத் தென்னாப்பிரிக்கா சென்று அங்கு நடைபெற்ற அறப்போராட்டங்களில் பங்குகொண்டார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "namakkal_gandhian_pyq"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-pyq-374", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-leaders", "chapter_id": null, "topic_id": "ar-thevar-meenakshi-temple-pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று, காரணத்தை ஆராய்ந்து சரியான விடையைத் தேர்வு செய்க:\nகூற்று (A): முத்துராமலிங்கத்தேவர் 1939 ஜூலை 8 அன்று மதுரையில் வைத்தியநாத ஐயர் தலைமையில் நடைபெற்ற மீனாட்சியம்மன் கோயில் ஆலயப் பிரவேசத்திற்குத் துணையாக நின்று முழுப் பாதுகாப்பு அளித்தார்.\nகாரணம் (R): பசும்பொன் தேவர் பார்வர்டு பிளாக் கட்சியின் தமிழகத் தலைவராக நேதாஜி சுபாஷ் சந்திரபோஸால் நியமிக்கப்பட்டிருந்தார்."}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் கூற்றின் சரியான விளக்கம் அல்ல", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் தவறு"}, "explanation": "TNPSC PYQ குறிப்பு: கூற்று (A) சரி (1939 ஜூலை 8 ஆலயப் பிரவேசப் பாதுகாப்பு); காரணம் (R) சரி (பார்வர்டு பிளாக் தலைமை); ஆனால் சமூக நீதிக்காக ஆலயப் பிரவேசத்திற்குப் பாதுகாப்பு கொடுத்ததற்குப் பார்வர்டு பிளாக் தலைமை நேரடிக் காரணம் அல்ல. எனவே B சரியான விடை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the assertion and reason and select the correct option:\nAssertion (A): On July 8, 1939, Muthuramalingathevar stood as a protective shield and ensured the successful temple entry at Madurai Meenakshi Temple led by Vaidyanatha Iyer.\nReason (R): Pasumpon Thevar had been designated as the Tamil Nadu state president of the Forward Bloc party by Netaji Subhash Chandra Bose."}], "options": {"A": "Assertion (A) is correct, but Reason (R) is false", "B": "Both (A) and (R) are correct, but (R) is not the correct explanation of (A)", "C": "Assertion (A) is false, but Reason (R) is correct", "D": "Both (A) and (R) are false"}, "explanation": "TNPSC PYQ Fact: Both statements are individually true historical facts, but Reason (R) is not the causative explanation for Assertion (A) (temple entry defense)."}}, "question_data": {"assertion": "முத்துராமலிங்கத்தேவர் 1939 ஜூலை 8 அன்று மதுரை மீனாட்சியம்மன் கோயில் ஆலயப் பிரவேசத்திற்குத் துணையாக நின்று முழுப் பாதுகாப்பு அளித்தார்.", "reason": "பசும்பொன் தேவர் பார்வர்டு பிளாக் கட்சியின் தமிழகத் தலைவராக நேதாஜி சுபாஷ் சந்திரபோஸால் நியமிக்கப்பட்டிருந்தார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": null, "exam_name": "TNPSC Group 4 / Group 2 / VAO Benchmark", "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "thevar_temple_entry_pyq"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null},