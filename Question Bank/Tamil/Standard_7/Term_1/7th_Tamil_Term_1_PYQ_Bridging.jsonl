{"id": "7th-t1-pyq-445", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u4-pyq-bridging", "lesson_id": "ta-pyq-bridging", "chapter_id": null, "topic_id": "odd-suradha-periodical-set", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உவமைக் கவிஞர் சுரதா தொடங்கிய இதழ்களுள் சேராத (பொருந்தாத) இதழ் எது?"}], "options": {"A": "காவியம்", "B": "அன்னம் விடு தூது", "C": "இலக்கியம்", "D": "விண்மீன்"}, "explanation": "பாடநூல் குறிப்பு: காவியம், இலக்கியம், விண்மீன், ஊர்வலம் ஆகியன சுரதாவின் இதழ்கள். 'அன்னம் விடு தூது' என்பது கவிஞர் மீரா (மீ. இராசேந்திரன்) நடத்திய புகழ்பெற்ற இதழாகும். எனவே அது பொருந்தாதது."}, "en": {"blocks": [{"type": "text", "content": "Which of the following was NOT an editorial periodical launched by Suradha (odd one out)?"}], "options": {"A": "Kaaviyam", "B": "Annam Vidu Thoodhu", "C": "Ilakkiyam", "D": "Vinmeen"}, "explanation": "Textbook Fact: Kaaviyam, Ilakkiyam, and Vinmeen were run by Suradha; 'Annam Vidu Thoodhu' was edited by poet Meera."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 25, "chapter": null, "section": null, "reference": null, "u