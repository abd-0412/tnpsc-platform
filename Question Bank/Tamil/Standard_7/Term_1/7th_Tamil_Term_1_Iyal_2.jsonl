// பாடம் 3: விலங்குகள் உலகம் & இந்திய வனமனிதர் ஜாதவ் பயேங் (உரைநடை உலகம் & விரிவானம்) [Q169 - Q196]
// முண்டந்துறை புலிகள் காப்பகம் (895 ச.கி.மீ), தமிழ்நாட்டின் 2-வது பெரிய காப்பகம், ஆசிய & ஆப்பிரிக்க யானைகள், புலி (காட்டின் சமநிலை குறியீடு), கரடி அனைத்துண்ணி, புள்ளிமான் அழகு; ஜாதவ் பயேங் (அசாம் ஜோர்ஹாட்), பிரம்மபுத்திரா மணல்தீவு, 30 ஆண்டுகள் உழைப்பு, 1360 ஏக்கர் வனம், 2012 ஜே.என்.யு 'வனமனிதர்', 2015 பத்மஸ்ரீ
// ==============================================================================
{"id": "7th-t1-u2-169", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l4-vilangugal-ulagam", "chapter_id": null, "topic_id": "tiger-nature-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புலியின் உடலமைப்பு மற்றும் வேட்டைப் பண்புகள் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. புலி இரவில் மட்டுமே வேட்டையாடும் தனித்துவமான விலங்காகும்.\n2. புலிகள் தனக்கென ஒரு குறிப்பிட்ட எல்லையை வகுத்துக் கொண்டு தனித்து வாழும் இயல்புடையவை.\n3. ஒரு புலியின் எல்லைக்குள் மற்றொரு புலி நுழைவதில்லை.\n4. புலியின் சினைக்காலம் 90 நாட்கள் ஆகும்; அது 2 அல்லது 3 குட்டிகளை ஈனும்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2 மட்டுமே சரி; 3, 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 மட்டுமே சரி; 1 தவறு", "D": "கூற்றுகள் 1, 3 மட்டுமே சரி; 2, 4 தவறு"}, "explanation": "பாடநூல் குறிப்பு: புலி இரவில் மட்டுமே வேட்டையாடும்; தனித்து வாழும்; எல்லைக்குள் பிற புலி வராது; சினைக்காலம் 90 நாட்கள்; 2 அல்லது 3 குட்டிகள் ஈனும். நான்கு கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding the physical and predatory nature of the tiger:\n1. The tiger is a solitary predator that hunts exclusively during the nocturnal hours.\n2. Tigers delineate a dedicated territorial boundary and lead solitary lives.\n3. A tiger never encroaches into the marked territorial domain of another tiger.\n4. The gestation period of a tigress is 90 days; she gives birth to 2 or 3 cubs.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Only statements 1 and 2 are correct", "C": "Only statements 2, 3, and 4 are correct", "D": "Only statements 1 and 3 are correct"}, "explanation": "Textbook fact: All four statements regarding nocturnal hunting, territoriality, 90-day gestation, and litter size (2-3 cubs) are accurate."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "புலி இரவில் மட்டுமே வேட்டையாடும் தனித்துவமான விலங்காகும்.", "content_en": "The tiger hunts exclusively during nocturnal hours."}, {"id": "S2", "content_ta": "புலிகள் தனக்கென ஒரு குறிப்பிட்ட எல்லையை வகுத்துக் கொண்டு தனித்து வாழும் இயல்புடையவை.", "content_en": "Tigers delineate territorial boundaries and lead solitary lives."}, {"id": "S3", "content_ta": "ஒரு புலியின் எல்லைக்குள் மற்றொரு புலி நுழைவதில்லை.", "content_en": "A tiger never enters the territory of another tiger."}, {"id": "S4", "content_ta": "புலியின் சினைக்காலம் 90 நாட்கள் ஆகும்; அது 2 அல்லது 3 குட்டிகளை ஈனும்.", "content_en": "Tigress gestation is 90 days, delivering 2-3 cubs."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "tiger_facts"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-170", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l4-vilangugal-ulagam", "chapter_id": null, "topic_id": "tiger-ecological-indicator", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காட்டின் சுற்றுச்சூழல் சமநிலை மற்றும் புலியின் முக்கியத்துவம் பற்றிய கூற்றுகளை ஆராய்க:\n1. புலிதான் ஒரு காட்டின் வளத்தைக் குறிக்கும் முதன்மையான குறியீடாகும்.\n2. புலி தான் வேட்டையாடிய உணவை உண்டபின், பசி தீர்ந்ததும் பிற விலங்குகளைத் தேவையின்றி வேட்டையாடுவதில்லை; அதனால் அதனைப் 'பண்புள்ள விலங்கு' என்பர்.\n3. இயற்கை விஞ்ஞானிகள் காட்டின் உண்மையான அரசனாகச் சிங்கத்தை விடப் புலியையே கருதுகின்றனர்.\n4. காட்டில் புலிகளின் எண்ணிக்கை மிக அதிகமாகப் பெருகுவது தாவரங்களின் வளர்ச்சியை அழித்துவிடும்.\nஇவற்றுள் சரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "B": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "D": "கூற்றுகள் அனைத்தும் சரி"}, "explanation": "பாடநூல் விளக்கம்: புலி தாவர உண்ணிகளைக் கட்டுப்படுத்தி காட்டின் தாவர வளத்தைப் பாதுகாக்கிறது; எனவே புலி காட்டின் செழிப்பிற்கு இன்றியமையாதது. புலிகள் தாவரங்களை அழிக்கும் என்பது தவறான கூற்றாகும். எனவே கூற்று 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding the ecological indicator status of the tiger:\n1. The presence of the tiger is the prime bio-indicator reflecting the health of a forest.\n2. Once satiated, a tiger never hunts unnecessarily; hence it is hailed as a 'noble animal' (Panbulla Vilangu).\n3. Naturalists consider the tiger to be the true king of the forest rather than the lion.\n4. A rise in tiger population destroys vegetation and wipes out forest growth.\nSelect the correct option."}], "options": {"A": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "B": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect", "C": "Statements 2, 3, and 4 are correct; 1 is incorrect", "D": "All statements are correct"}, "explanation": "Textbook explanation: Tigers regulate herbivore populations, conserving forest flora; claiming tigers destroy vegetation is biologically absurd. Statement 4 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "புலிதான் ஒரு காட்டின் வளத்தைக் குறிக்கும் முதன்மையான குறியீடாகும்.", "content_en": "The tiger is the prime bio-indicator of forest health."}, {"id": "S2", "content_ta": "பசி தீர்ந்ததும் தேவையின்றி வேட்டையாடாததால் புலி 'பண்புள்ள விலங்கு' எனப்படுகிறது.", "content_en": "Not hunting once fed, the tiger is hailed as a noble animal."}, {"id": "S3", "content_ta": "இயற்கை விஞ்ஞானிகள் காட்டின் அரசனாகப் புலியையே கருதுகின்றனர்.", "content_en": "Naturalists view the tiger as the true monarch of the forest."}, {"id": "S4", "content_ta": "காட்டில் புலிகள் பெருகுவது தாவரங்களின் வளர்ச்சியை அழித்துவிடும்.", "content_en": "Rising tiger numbers wipe out forest vegetation."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "tiger_ecology"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-171", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l4-vilangugal-ulagam", "chapter_id": null, "topic_id": "lion-and-deer-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிங்கம் மற்றும் மான் பற்றிய பாடநூல் தகவல்களை ஆராய்க:\n1. உலகில் ஆசியச் சிங்கங்கள் குஜராத் மாநிலத்திலுள்ள 'கிர்' சரணாலயத்தில் மட்டுமே பாதுகாக்கப்பட்டு வருகின்றன.\n2. நீளம், உயரம், பருமன், எடை, பலம், வேட்டைத்திறன் ஆகிய அனைத்திலும் சிங்கத்தை விடப் புலியே மேலானது என இயற்கை அறிஞர்கள் கூறுகின்றனர்.\n3. தமிழ்நாட்டில் காணப்படும் மான்களுள் சருகுமான், மிளாமான், வெளிமான், புள்ளிமான் முதலான வகைகள் உள்ளன.\n4. தமிழ்நாட்டில் காணப்படும் மான் வகைகளிலேயே உருவத்திலும் அழகிலும் மிகக் குறைந்ததாகப் புள்ளிமான் கருதப்படுகிறது.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "B": "கூற்றுகள் அனைத்தும் சரி", "C": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "பாடநூல் விளக்கம்: தமிழ்நாட்டிலுள்ள அனைத்து மான் வகைகளிலும் 'புள்ளிமான்களே மிகவும் அழகானவை' என்று பாடநூல் தெளிவாகக் குறிப்பிடுகிறது. எனவே கூற்று 4 தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the textbook facts regarding lions and deer:\n1. Asiatic lions survive in the wild exclusively in Gujarat's Gir Sanctuary.\n2. In length, height, girth, weight, muscle power, and predatory acumen, naturalists rate the tiger superior to the lion.\n3. Tamil Nadu forests host deer varieties including mouse deer (Sarugumaan), Sambar (Milamaan), blackbuck (Velimaan), and spotted deer (Pullimaan).\n4. The spotted deer is considered the least attractive and inferior in beauty among Tamil deer species.\nWhich statements are correct?"}], "options": {"A": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "B": "All statements are correct", "C": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect", "D": "Statements 2, 3, and 4 are correct; 1 is incorrect"}, "explanation": "Textbook explanation: Spotted deer (Pullimaan) are celebrated as the most aesthetically beautiful among all deer species in Tamil Nadu. Statement 4 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "உலகில் ஆசியச் சிங்கங்கள் குஜராத் மாநிலத்திலுள்ள 'கிர்' சரணாலயத்தில் மட்டுமே உள்ளன.", "content_en": "Asiatic lions survive exclusively in Gujarat's Gir Sanctuary."}, {"id": "S2", "content_ta": "பருமன், எடை, பலம், வேட்டைத்திறன் அனைத்திலும் சிங்கத்தை விடப் புலியே மேலானது.", "content_en": "In girth, weight, power, and hunting, the tiger is superior."}, {"id": "S3", "content_ta": "தமிழ்நாட்டில் சருகுமான், மிளாமான், வெளிமான், புள்ளிமான் வகைகள் உள்ளன.", "content_en": "Tamil Nadu hosts mouse deer, sambar, blackbuck, and spotted deer."}, {"id": "S4", "content_ta": "மாறாக புள்ளிமான் உருவத்திலும் அழகிலும் மிகக் குறைந்ததாகக் கருதப்படுகிறது.", "content_en": "Spotted deer are considered the least attractive."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 38, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "lion_deer_facts"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-172", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l5-indhiya-vanamagan", "chapter_id": null, "topic_id": "jadav-payeng-origin", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்திய வனமகன் ஜாதவ் பயேங் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. ஜாதவ் பயேங் அசாம் மாநிலத்தின் ஜோர்ஹட் மாவட்டத்தைச் சேர்ந்தவர்.\n2. இவர் பிரம்மபுத்திரா ஆற்றின் நடுவில் உள்ள மிகப்பெரிய மணல் தீவில் தனியொரு மனிதராக 30 ஆண்டுகள் உழைத்துக் காட்டை உருவாக்கினார்.\n3. இவர் உருவாக்கிய காட்டின் பரப்பளவு சுமார் 1360 ஏக்கர் ஆகும்.\n4. இவர் அரசாங்க வனத்துறையின் பெரும் நிதி உதவியையும் இயந்திரங்களையும் கொண்டு இக்காட்டை உருவாக்கினார்.\nஇவற்றுள் சரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் அனைத்தும் சரி", "B": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "C": "கூற்றுகள் 2, 3, 4 சரி; கூற்று 1 தவறு", "D": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு"}, "explanation": "பாடநூல் விளக்கம்: ஜாதவ் பயேங் எவ்வித அரசாங்க நிதி உதவியோ இயந்திரங்களோ இன்றி, தனியொரு மனிதராகத் தமது சொந்த உழைப்பால் தினந்தோறும் மரக்கன்றுகளை நட்டு 1360 ஏக்கர் காட்டை உருவாக்கினார். எனவே கூற்றுகள் 1, 2, 3 சரி; 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding the Forest Man of India, Jadav Payeng:\n1. Jadav Payeng hails from the Jorhat district of Assam state.\n2. On a sandbar island in the middle of the Brahmaputra River, he labored single-handedly for 30 years to raise a forest.\n3. The sprawling forest created by him covers an expanse of approximately 1,360 acres.\n4. He raised this forest utilizing massive government financial subsidies and heavy mechanized machinery.\nSelect the correct option."}], "options": {"A": "All statements are correct", "B": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "C": "Statements 2, 3, and 4 are correct; 1 is incorrect", "D": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect"}, "explanation": "Textbook explanation: Payeng built the 1,360-acre forest entirely through personal labor without government funds or machines. Statement 4 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ஜாதவ் பயேங் அசாம் மாநிலத்தின் ஜோர்ஹட் மாவட்டத்தைச் சேர்ந்தவர்.", "content_en": "Jadav Payeng hails from Jorhat district, Assam."}, {"id": "S2", "content_ta": "பிரம்மபுத்திரா ஆற்றின் மணல் தீவில் 30 ஆண்டுகள் உழைத்துக் காட்டை உருவாக்கினார்.", "content_en": "He labored for 30 years on a Brahmaputra sandbar to create a forest."}, {"id": "S3", "content_ta": "இவர் உருவாக்கிய காட்டின் பரப்பளவு சுமார் 1360 ஏக்கர் ஆகும்.", "content_en": "The forest created spans roughly 1,360 acres."}, {"id": "S4", "content_ta": "அரசாங்கத்தின் பெரும் நிதி உதவியையும் இயந்திரங்களையும் கொண்டு இக்காட்டை உருவாக்கினார்.", "content_en": "He utilized massive government funds and machinery."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "jadav_payeng_forest"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-173", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l5-indhiya-vanamagan", "chapter_id": null, "topic_id": "payeng-history-ants", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜாதவ் பயேங் மரம் நடத் தொடங்கிய வரலாற்றுப் பின்னணி மற்றும் மண் வள உத்திகள் பற்றிய கூற்றுகளை ஆராய்க:\n1. 1979-ல் பிரம்மபுத்திரா ஆற்றில் ஏற்பட்ட பெருவெள்ளத்தில் அடித்து வரப்பட்ட எண்ணற்ற பாம்புகள் மரங்களற்ற மணல்தீவின் வெப்பம் தாளாமல் இறந்ததைக் கண்டு மனம் வருந்தினார்.\n2. பாம்புகளின் பரிதாப மரணமே இவர் அத்தீவில் முதன்முதலில் மூங்கில் மரக்கன்றுகளை நடத் தூண்டுகோலாக அமைந்தது.\n3. மணல் தீவில் பிற மரங்கள் வளர ஏதுவாக மண்ணின் தன்மையை மாற்ற அசாம் வேளாண்மைப் பல்கலைக்கழகப் பேராசிரியர் ஜாதுநாத் ஆலோசனைப்படி சிவப்பு எறும்புகளைக் கொண்டு வந்தார்.\n4. சிவப்பு எறும்புகளும் மண்புழுக்களும் மணலின் கடினத் தன்மையைத் தளர்த்தி, நிலத்தை மரம் வளர்வதற்கு உகந்த வளமான மண்ணாக மாற்றின.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2 மட்டுமே சரி; 3, 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 மட்டுமே சரி; 1 தவறு", "D": "கூற்றுகள் 1, 3 மட்டுமே சரி; 2, 4 தவறு"}, "explanation": "பாடநூல் குறிப்பு: 1979 வெள்ளம் மற்றும் பாம்புகளின் இறப்பு; மூங்கில் நடுதல்; பேராசிரியர் ஜாதுநாத்தின் சிவப்பு எறும்புகள் ஆலோசனை; எறும்புகளால் மண் வளம் அடைதல் ஆகிய இந்நான்கு விவரங்களும் பாடநூலின்படி முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze Payeng's impetus for afforestation and his soil conditioning techniques:\n1. In 1979, massive Brahmaputra floods washed ashore countless snakes that perished due to intense heat on the treeless sandbar.\n2. The tragic death of the snakes served as the profound catalyst prompting him to plant bamboo saplings.\n3. On advice from Assam Agricultural University Professor Jadhunath, he introduced red ants to condition the barren sand.\n4. The red ants and earthworms aerated the hard sandy soil, transforming it into fertile humus suitable for diverse trees.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Only statements 1 and 2 are correct", "C": "Only statements 2, 3, and 4 are correct", "D": "Only statements 1 and 3 are correct"}, "explanation": "Textbook fact: All four historical points regarding the 1979 flood, snake mortality, Prof. Jadhunath's red ants advice, and soil conditioning are validated."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "1979 பெருவெள்ளத்தில் பாம்புகள் வெப்பம் தாளாமல் இறந்ததைக் கண்டு வருந்தினார்.", "content_en": "Snakes dying in the 1979 flood catalyzed his ecological mission."}, {"id": "S2", "content_ta": "பாம்புகளின் மரணமே இவர் தீவில் மூங்கில் மரங்களை நடத் தூண்டியது.", "content_en": "The snake tragedy prompted him to plant bamboo."}, {"id": "S3", "content_ta": "பேராசிரியர் ஜாதுநாத் ஆலோசனைப்படி சிவப்பு எறும்புகளைக் கொண்டு வந்தார்.", "content_en": "Prof. Jadhunath advised introducing red ants."}, {"id": "S4", "content_ta": "சிவப்பு எறும்புகளும் மண்புழுக்களும் நிலத்தை வளமான மண்ணாக மாற்றின.", "content_en": "Red ants and earthworms transformed the soil into fertile land."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "payeng_afforestation_methods"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-174", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l5-indhiya-vanamagan", "chapter_id": null, "topic_id": "payeng-awards-honors", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜாதவ் பயேங் பெற்ற விருதுகள் மற்றும் கௌரவங்கள் பற்றிய கூற்றுகளை ஆராய்க:\n1. 2012-ஆம் ஆண்டு புது தில்லி ஜவஹர்லால் நேரு பல்கலைக்கழகம் (JNU) இவருக்கு 'இந்திய வனமகன்' (Forest Man of India) என்ற பட்டத்தை வழங்கிச் சிறப்பித்தது.\n2. 2015-ஆம் ஆண்டு இந்திய அரசு இவருக்கு நாட்டின் மிக உயரிய குடிமை விருதுகளுள் ஒன்றான 'பத்மஸ்ரீ' விருது வழங்கிப் பெருமைப்படுத்தியது.\n3. அசாமின் கவுகாத்தி பல்கலைக்கழகம் இவருக்கு மதிப்புறு முனைவர் (Honorary Doctorate) பட்டம் வழங்கிக் கவுரவித்தது.\n4. ஜாதவ் பயேங்கிற்கு அமைதிக்கான நோபல் பரிசு வழங்கி சர்வதேச அளவில் ஐக்கிய நாடுகள் சபை கவுரவித்தது.\nஇவற்றுள் சரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "B": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "D": "கூற்றுகள் அனைத்தும் சரி"}, "explanation": "பாடநூல் குறிப்பு: ஜாதவ் பயேங் பெற்றவை: 2012 JNU 'இந்திய வனமகன்', 2015 இந்திய அரசின் 'பத்மஸ்ரீ', கவுகாத்தி பல்கலைக்கழக 'மதிப்புறு முனைவர்' பட்டம். அவருக்கு நோபல் பரிசு வழங்கப்பட்டது என்பது தவறான கூற்று. எனவே கூற்று 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding awards and titles conferred upon Jadav Payeng:\n1. In 2012, Jawaharlal Nehru University (JNU), New Delhi conferred the title 'Forest Man of India'.\n2. In 2015, the Government of India honored him with the civilian honor 'Padma Shri'.\n3. Gauhati University in Assam conferred an Honorary Doctorate upon him.\n4. Jadav Payeng was conferred the Nobel Peace Prize by the United Nations.\nSelect the correct option."}], "options": {"A": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "B": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect", "C": "Statements 2, 3, and 4 are correct; 1 is incorrect", "D": "All statements are correct"}, "explanation": "Textbook fact: Payeng received 2012 JNU Forest Man title, 2015 Padma Shri, and Gauhati Doctorate. The Nobel Prize claim is false. Statement 4 is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "2012-ல் JNU பல்கலைக்கழகம் 'இந்திய வனமகன்' பட்டத்தை வழங்கியது.", "content_en": "2012 JNU conferred 'Forest Man of India'."}, {"id": "S2", "content_ta": "2015-ல் இந்திய அரசு இவருக்கு 'பத்மஸ்ரீ' விருது வழங்கிப் பெருமைப்படுத்தியது.", "content_en": "2015 Govt of India awarded 'Padma Shri'."}, {"id": "S3", "content_ta": "கவுகாத்தி பல்கலைக்கழகம் இவருக்கு மதிப்புறு முனைவர் பட்டம் வழங்கியது.", "content_en": "Gauhati University awarded an Honorary Doctorate."}, {"id": "S4", "content_ta": "ஜாதவ் பயேங்கிற்கு அமைதிக்கான நோபல் பரிசு வழங்கி கவுரவிக்கப்பட்டது.", "content_en": "Payeng was awarded the Nobel Peace Prize."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 42, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "payeng_awards"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-175", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l5-indhiya-vanamagan", "chapter_id": null, "topic_id": "forest-discovery-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜாதவ் பயேங் உருவாக்கிய காடு வெளி உலகிற்குத் தெரியவந்த நிகழ்வு பற்றிய கூற்றுகளை ஆராய்க:\n1. காடு உருவானதை ஆரம்பத்தில் எவரும் அறியவில்லை; ஒருமுறை யானைகள் கூட்டம் பயேங் உருவாக்கிய காட்டிற்குள் புகுந்தன.\n2. யானைகளின் கால்தடங்களைத் தொடர்ந்து வந்த வனத்துறை அதிகாரி ஜிதின் கலிதா இக்காட்டைக் கண்டு வியந்து வெளி உலகிற்கு அறிவித்தார்.\n3. தன் காட்டிற்கு யானைகள் கூட்டம் வந்த அந்த நாளையே தம் வாழ்வின் மிக மகிழ்ச்சியான நாளாக ஜாதவ் பயேங் கருதினார்.\n4. யானைகள் தனது மரங்களை அழித்துவிட்டன என்று வனத்துறையிடம் ஜாதவ் பயேங் இழப்பீடு கோரிப் புகார் அளித்தார்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "B": "கூற்றுகள் அனைத்தும் சரி", "C": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "பாடநூல் விளக்கம்: 'யானைகள் தங்கியிருக்கும் காடே வளமான காடு' என்று ஜாதவ் பயேங் பெருமகிழ்ச்சி அடைந்தார்; இழப்பீடு கோரிப் புகார் அளித்தார் என்பது தவறான கூற்றாகும். எனவே கூற்று 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the circumstances surrounding the discovery of Payeng's forest by the outside world:\n1. Initially unknown to society, the forest came to light when an elephant herd entered Payeng's sanctuary.\n2. Forest official Jitin Kalita, tracking the wild elephants, discovered the dense forest in astonishment and reported it.\n3. Payeng considered the day elephants arrived at his forest as the happiest and most fulfilled day of his entire life.\n4. Payeng filed an official compensation grievance complaining that elephants destroyed his trees.\nWhich statements are correct?"}], "options": {"A": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "B": "All statements are correct", "C": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect", "D": "Statements 2, 3, and 4 are correct; 1 is incorrect"}, "explanation": "Textbook explanation: Payeng celebrated the elephants' arrival as proof of an authentic flourishing jungle ('Forest where elephants stay is fertile'); he never filed grievances. Statement 4 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "யானைகள் கூட்டம் பயேங் உருவாக்கிய காட்டிற்குள் புகுந்தன.", "content_en": "An elephant herd entered Payeng's jungle."}, {"id": "S2", "content_ta": "வனத்துறை அதிகாரி ஜிதின் கலிதா இக்காட்டைக் கண்டு வெளி உலகுக்கு அறிவித்தார்.", "content_en": "Forest official Jitin Kalita reported the discovery."}, {"id": "S3", "content_ta": "காட்டிற்கு யானைகள் வந்த நாளையே தம் வாழ்வின் மகிழ்ச்சியான நாளாக பயேங் கருதினார்.", "content_en": "Payeng deemed the day elephants arrived his happiest day."}, {"id": "S4", "content_ta": "யானைகள் மரங்களை அழித்துவிட்டன என்று பயேங் இழப்பீடு கோரிப் புகார் அளித்தார்.", "content_en": "Payeng filed compensation claims against elephant damage."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 42, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "forest_discovery"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-176", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l4-vilangugal-ulagam", "chapter_id": null, "topic_id": "tiger-lion-apex-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): இயற்கை விஞ்ஞானிகள் சிங்கத்தை விடப் புலியையே உடலமைப்பு மற்றும் ஆற்றலில் மேலான விலங்காகக் கருதுகின்றனர்.\nகாரணம் (R): சிங்கங்கள் எப்போதும் கூட்டமாக வாழ்ந்து மனிதர்களை அஞ்சுவதால், அவற்றிற்கு வேட்டையாடும் திறன் அறவே இல்லை.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று மற்றும் காரணம் இரண்டும் சரி; சரியான விளக்கம்", "B": "கூற்று தவறு; காரணம் சரி", "C": "கூற்று, காரணம் இரண்டும் தவறு", "D": "கூற்று சரி; ஆனால் காரணம் தவறு"}, "explanation": "பாடநூல் விளக்கம்: நீளம், உயரம், பருமன், பலம், வேட்டைத்திறன் அனைத்திலும் புலியே மேலானது என்பது அறிவியல் உண்மை (கூற்று சரி). ஆனால் சிங்கம் வேட்டையாடும் திறன் இல்லாதது எனக் கூறுவது தவறான காரணம் ஆகும். எனவே கூற்று சரி, காரணம் தவறு."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): Naturalists regard the tiger as biologically and physically superior to the lion.\nReason (R): Because lions invariably live in social prides and dread humans, they possess zero hunting instincts.\nSelect the correct option."}], "options": {"A": "Both Assertion and Reason are correct; correct explanation", "B": "Assertion is incorrect; Reason is correct", "C": "Both Assertion and Reason are incorrect", "D": "Assertion is correct; but Reason is incorrect"}, "explanation": "Textbook explanation: Tigers are rated superior in strength, size, and hunting stealth. Claiming lions possess zero hunting capability is ridiculous. Assertion is true; Reason is false."}}, "question_data": {"assertion": "இயற்கை விஞ்ஞானிகள் சிங்கத்தை விடப் புலியையே உடலமைப்பு மற்றும் ஆற்றலில் மேலான விலங்காகக் கருதுகின்றனர்.", "reason": "சிங்கங்கள் எப்போதும் கூட்டமாக வாழ்ந்து மனிதர்களை அஞ்சுவதால், அவற்றிற்கு வேட்டையாடும் திறன் அறவே இல்லை.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 38, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "tiger_lion_comparison"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-177", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l5-indhiya-vanamagan", "chapter_id": null, "topic_id": "red-ants-soil-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): ஜாதவ் பயேங் மணல் தீவில் பிற வகை மரங்களை நட்டு வளர்ப்பதற்காகச் சிவப்பு எறும்புகளைக் கொண்டு வந்து பரவவிட்டார்.\nகாரணம் (R): சிவப்பு எறும்புகளின் தொடர் நடமாட்டமும் புற்றுகளும் உதிரும் எச்சங்களும் கடினமான மணலின் தன்மையை மாற்றி, நிலத்தில் மண்புழுக்கள் பெருகவும் மண் வளம் பெறவும் வழிவகுத்தன.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றுக்குச் சரியான விளக்கம் ஆகும்", "B": "கூற்று மற்றும் காரணம் இரண்டும் சரி; ஆனால் காரணம் கூற்றுக்குச் சரியான விளக்கமல்ல", "C": "கூற்று சரி; ஆனால் காரணம் தவறு", "D": "கூற்று தவறு; ஆனால் காரணம் சரி"}, "explanation": "பாடநூல் விளக்கம்: மணல் தீவில் மூங்கிலைத் தவிர பிற மரங்கள் வளர பேராசிரியர் ஜாதுநாத்தின் வழிகாட்டல்படி சிவப்பு எறும்புகளைக் கொண்டு வந்தார்; எறும்புகளும் மண்புழுக்களும் மணலின் தன்மையை மாற்றியதால் காடு உருவானது. கூற்றும் காரணமும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): Jadav Payeng introduced red ants onto the sandbar to enable diverse tree species to take root and flourish.\nReason (R): The relentless subterranean burrowing and organic matter from red ants altered the soil texture, fostering earthworms and organic fertility.\nSelect the correct option."}], "options": {"A": "Both Assertion and Reason are correct; Reason correctly explains Assertion", "B": "Both Assertion and Reason are correct; but Reason does not explain Assertion", "C": "Assertion is correct; Reason is incorrect", "D": "Assertion is incorrect; Reason is correct"}, "explanation": "Textbook explanation: Red ants conditioned the sandbar, enabling earthworms to flourish and allowing non-bamboo trees to thrive. Both Assertion and Reason are correct."}}, "question_data": {"assertion": "ஜாதவ் பயேங் மணல் தீவில் பிற வகை மரங்களை நட்டு வளர்ப்பதற்காகச் சிவப்பு எறும்புகளைக் கொண்டு வந்து பரவவிட்டார்.", "reason": "சிவப்பு எறும்புகளின் தொடர் நடமாட்டமும் புற்றுகளும் உதிரும் எச்சங்களும் கடினமான மணலின் தன்மையை மாற்றி, நிலத்தில் மண்புழுக்கள் பெருகவும் மண் வளம் பெறவும் வழிவகுத்தன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "payeng_soil_science"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-178", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l4-vilangugal-ulagam", "chapter_id": null, "topic_id": "tiger-noble-beast-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): வனவிலங்கியலாளர்கள் மற்றும் பழங்குடியினர் புலியைப் 'பண்புள்ள விலங்கு' என்று அழைக்கின்றனர்.\nகாரணம் (R): புலி தான் வேட்டையாடிய உணவைத் தன் வயிறு நிறைய உண்ட பிறகு, பிற விலங்குகள் தன் கண்ணெதிரே சென்றாலும் அவற்றை அநாவசியமாகத் தாக்குவதோ வேட்டையாடுவதோ இல்லை.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று சரி; காரணம் தவறு", "B": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றுக்குச் சரியான விளக்கமாகும்", "C": "கூற்று தவறு; காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் விளக்கம்: புலி தான் வேட்டையாடிய உணவை உண்டபின் பசி தீர்ந்ததும் பிற விலங்குகளை வேட்டையாடுவதில்லை; எனவே அது 'பண்புள்ள விலங்கு' எனப்படுகிறது என்று பாடநூல் கூறுகிறது. கூற்று, காரணம் இரண்டும் சரி, சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): Wildlife experts and indigenous tribes revere the tiger as a 'noble animal' (Panbulla Vilangu).\nReason (R): Once a tiger feeds sufficiently on its prey, it never engages in wanton killings even if vulnerable animals pass in front of it.\nSelect the correct option."}], "options": {"A": "Assertion is correct; Reason is incorrect", "B": "Both Assertion and Reason are correct; Reason is the correct explanation", "C": "Assertion is incorrect; Reason is correct", "D": "Both Assertion and Reason are incorrect"}, "explanation": "Textbook explanation: The tiger's refusal to hunt gratuitously when satiated earns it the epithet 'noble animal'. Both are correct."}}, "question_data": {"assertion": "வனவிலங்கியலாளர்கள் மற்றும் பழங்குடியினர் புலியைப் 'பண்புள்ள விலங்கு' என்று அழைக்கின்றனர்.", "reason": "புலி தான் வேட்டையாடிய உணவைத் தன் வயிறு நிறைய உண்ட பிறகு, பிற விலங்குகள் தன் கண்ணெதிரே சென்றாலும் அவற்றை அநாவசியமாகத் தாக்குவதோ வேட்டையாடுவதோ இல்லை.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "tiger_noble_behavior"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-179", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l5-indhiya-vanamagan", "chapter_id": null, "topic_id": "payeng-bamboo-monoculture", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): ஜாதவ் பயேங் உருவாக்கிய 1360 ஏக்கர் காடு முழுவதும் மூங்கில் மரங்களை மட்டுமே கொண்ட ஒரு பயிர் காடாகும் (Monoculture).\nகாரணம் (R): பிரம்மபுத்திரா ஆற்றின் மணல் படுகைகளில் மூங்கில் தவிர்த்து வேறு எந்தத் தாவரமும் ஒருபோதும் முளைக்காது.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி", "B": "கூற்று சரி; காரணம் தவறு", "C": "கூற்று தவறு; காரணமும் முற்றிலும் தவறானது", "D": "கூற்று சரி; சரியான விளக்கம்"}, "explanation": "பாடநூல் விளக்கம்: ஜாதவ் பயேங் முதலில் மூங்கில் நட்டாலும், பின்னர் சிவப்பு எறும்புகளின் உதவியால் மணலை வளப்படுத்தி அர்ஜுனா, மருதம், தேக்கு உள்ளிட்ட பல்லாயிரக்கணக்கான பல்வேறு மரங்களை நட்டு அடர்ந்த பல்லுயிர் காட்டை உருவாக்கினார். எனவே கூற்றும் காரணமும் முற்றிலும் தவறானவை."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): The 1,360-acre forest created by Jadav Payeng is exclusively a bamboo monoculture lacking other plant species.\nReason (R): On the sandy shoals of the Brahmaputra River, no plant species other than bamboo can ever germinate or survive.\nSelect the correct option."}], "options": {"A": "Both Assertion and Reason are correct", "B": "Assertion is correct; Reason is incorrect", "C": "Assertion is incorrect; Reason is also completely false", "D": "Assertion is correct; correct explanation"}, "explanation": "Textbook explanation: Payeng's forest contains diverse native hardwood and fruit trees, not just bamboo. Both Assertion and Reason are false."}}, "question_data": {"assertion": "ஜாதவ் பயேங் உருவாக்கிய 1360 ஏக்கர் காடு முழுவதும் மூங்கில் மரங்களை மட்டுமே கொண்ட ஒரு பயிர் காடாகும்.", "reason": "பிரம்மபுத்திரா ஆற்றின் மணல் படுகைகளில் மூங்கில் தவிர்த்து வேறு எந்தத் தாவரமும் ஒருபோதும் முளைக்காது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "payeng_biodiversity"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-180", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l4-vilangugal-ulagam", "chapter_id": null, "topic_id": "asiatic-lion-habitat-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): உலகில் வாழும் ஆசியச் சிங்கங்கள் அனைத்தும் இந்தியாவில் குஜராத் மாநிலத்தில் உள்ள கிர் சரணாலயத்தில் மட்டுமே வாழ்ந்து வருகின்றன.\nகாரணம் (R): தமிழ்நாட்டின் களக்காடு முண்டந்துறை காடுகளில் சிங்கங்கள் புலிகளோடு போட்டியிட்டு வாழ முடியாததால் அங்கிருந்து அவை குஜராத்திற்கு இடம்பெயர்ந்துவிட்டன.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று தவறு; காரணம் சரி", "B": "கூற்று, காரணம் இரண்டும் சரி", "C": "கூற்று, காரணம் இரண்டும் தவறு", "D": "கூற்று சரி; ஆனால் காரணம் தவறு"}, "explanation": "பாடநூல் விளக்கம்: ஆசிய சிங்கம் குஜராத்தின் கிர் சரணாலயத்தில் மட்டுமே உள்ளது என்பது உண்மை (கூற்று சரி). களக்காடு முண்டந்துறையிலிருந்து இடம்பெயர்ந்தது எனக் கூறுவது நகைப்புக்குரிய கற்பனையான தவறான காரணம் ஆகும். எனவே கூற்று சரி, காரணம் தவறு."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): Wild Asiatic lions in the world survive exclusively within Gujarat's Gir Sanctuary in India.\nReason (R): Because lions could not compete against tigers in Tamil Nadu's Kalakkadu sanctuary, they migrated en masse to Gujarat.\nSelect the correct option."}], "options": {"A": "Assertion is incorrect; Reason is correct", "B": "Both Assertion and Reason are correct", "C": "Both Assertion and Reason are incorrect", "D": "Assertion is correct; but Reason is incorrect"}, "explanation": "Textbook explanation: Asiatic lions are naturally endemic to Gir; claiming they migrated from Kalakkadu is absurd. Assertion is true; Reason is false."}}, "question_data": {"assertion": "உலகில் வாழும் ஆசியச் சிங்கங்கள் அனைத்தும் இந்தியாவில் குஜராத் மாநிலத்தில் உள்ள கிர் சரணாலயத்தில் மட்டுமே வாழ்ந்து வருகின்றன.", "reason": "தமிழ்நாட்டின் களக்காடு முண்டந்துறை காடுகளில் சிங்கங்கள் புலிகளோடு போட்டியிட்டு வாழ முடியாததால் அங்கிருந்து அவை குஜராத்திற்கு இடம்பெயர்ந்துவிட்டன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 38, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "asiatic_lion_habitat"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-181", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l5-indhiya-vanamagan", "chapter_id": null, "topic_id": "elephant-forest-fertility-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): காட்டில் யானைகள் கூட்டம் தங்கியிருப்பதே ஒரு காட்டின் உச்சபட்ச வளத்திற்கான அடையாளம் என்று ஜாதவ் பயேங் கூறுகிறார்.\nகாரணம் (R): யானைகளின் பிரம்மாண்ட உடலுக்குத் தேவையான பெருமளவு உணவும் தண்ணீரும் நிறைந்துள்ள காடு மட்டுமே யானைக் கூட்டத்தைத் தன் மடியில் தாங்கிக் கொள்ளும் ஆற்றல் படைத்தது.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றுக்குச் சரியான விளக்கம் ஆகும்", "B": "கூற்று சரி; ஆனால் காரணம் தவறு", "C": "கூற்று தவறு; காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் விளக்கம்: 'யானைகள் தங்கியிருக்கும் காடே வளமான காடு' என்ற ஜாதவ் பயேங்கின் கூற்றும், யானைகளின் உணவுத் தேவையை நிறைவு செய்யும் ஆற்றலே காட்டின் வளம் என்ற காரண விளக்கமும் பாடநூலின்படி முழுமையாகச் சரியானது."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): Jadav Payeng affirms that the continuous presence of an elephant herd is the ultimate hallmark of a forest's ecological fertility.\nReason (R): Only a dense, resource-rich jungle abundant in enormous food biomass and perennial water can sustain the colossal dietary demands of elephant herds.\nSelect the correct option."}], "options": {"A": "Both Assertion and Reason are correct; Reason correctly explains Assertion", "B": "Assertion is correct; Reason is incorrect", "C": "Assertion is incorrect; Reason is correct", "D": "Both Assertion and Reason are incorrect"}, "explanation": "Textbook explanation: Elephants serve as flagship keystone species whose survival reflects immense floral and hydrological abundance. Both are correct."}}, "question_data": {"assertion": "காட்டில் யானைகள் கூட்டம் தங்கியிருப்பதே ஒரு காட்டின் உச்சபட்ச வளத்திற்கான அடையாளம் என்று ஜாதவ் பயேங் கூறுகிறார்.", "reason": "யானைகளின் பிரம்மாண்ட உடலுக்குத் தேவையான பெருமளவு உணவும் தண்ணீரும் நிறைந்துள்ள காடு மட்டுமே யானைக் கூட்டத்தைத் தன் மடியில் தாங்கிக் கொள்ளும் ஆற்றல் படைத்தது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 42, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "elephant_forest_indicator"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-182", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l4-vilangugal-ulagam", "chapter_id": null, "topic_id": "fauna-traits-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காட்டு விலங்குகளின் சிறப்பியல்புகளையும் பட்டங்களையும் பொருத்துக:\nபட்டியல் I (விலங்கு):\nL1. புலி\nL2. கரடி\nL3. பெண் யானை\nL4. ஆசிய சிங்கம்\nபட்டியல் II (சிறப்பு / பண்பு):\nR1. பண்புள்ள விலங்கு / காட்டின் வளம்\nR2. அனைத்துண்ணி / கரையான் பிரியர்\nR3. யானைக் கூட்டத்தின் தலைவி\nR4. குஜராத் கிர் சரணாலயத்தின் பெருமை"}], "options": {"A": "L1-R2, L2-R1, L3-R4, L4-R3", "B": "L1-R1, L2-R2, L3-R3, L4-R4", "C": "L1-R3, L2-R4, L3-R1, L4-R2", "D": "L1-R4, L2-R3, L3-R2, L4-R1"}, "explanation": "பாடநூல் விளக்கம்: புலி = பண்புள்ள விலங்கு (R1); கரடி = அனைத்துண்ணி (R2); பெண் யானை = கூட்டத்தின் தலைவி (R3); ஆசிய சிங்கம் = கிர் சரணாலயம் (R4). வரிசை: 1 - 2 - 3 - 4."}, "en": {"blocks": [{"type": "text", "content": "Match wildlife species with their behavioral traits and conservation statuses:\nList I (Animal):\nL1. Tiger\nL2. Bear\nL3. Female Elephant\nL4. Asiatic Lion\nList II (Trait / Distinction):\nR1. Noble animal / Forest fertility indicator\nR2. Omnivore / Termite lover\nR3. Matriarch leading the elephant herd\nR4. Glory of Gujarat's Gir Sanctuary"}], "options": {"A": "L1-R2, L2-R1, L3-R4, L4-R3", "B": "L1-R1, L2-R2, L3-R3, L4-R4", "C": "L1-R3, L2-R4, L3-R1, L4-R2", "D": "L1-R4, L2-R3, L3-R2, L4-R1"}, "explanation": "Textbook match: Direct sequence: 1-1, 2-2, 3-3, 4-4."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "புலி", "content_en": "Tiger"}, {"id": "L2", "content_ta": "கரடி", "content_en": "Bear"}, {"id": "L3", "content_ta": "பெண் யானை", "content_en": "Female Elephant"}, {"id": "L4", "content_ta": "ஆசிய சிங்கம்", "content_en": "Asiatic Lion"}], "right": [{"id": "R1", "content_ta": "பண்புள்ள விலங்கு / காட்டின் வளம்", "content_en": "Noble animal / Forest fertility indicator"}, {"id": "R2", "content_ta": "அனைத்துண்ணி / கரையான் பிரியர்", "content_en": "Omnivore / Termite lover"}, {"id": "R3", "content_ta": "யானைக் கூட்டத்தின் தலைவி", "content_en": "Matriarch leading herd"}, {"id": "R4", "content_ta": "குஜராத் கிர் சரணாலயத்தின் பெருமை", "content_en": "Glory of Gujarat Gir Sanctuary"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "match", "wildlife_traits"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-183", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l5-indhiya-vanamagan", "chapter_id": null, "topic_id": "payeng-milestones-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜாதவ் பயேங்கின் வாழ்வியல் நிகழ்வுகளையும் ஆண்டுகளையும் பொருத்துக:\nபட்டியல் I (நிகழ்வு / விருது):\nL1. பிரம்மபுத்திரா வெள்ளத்தில் பாம்புகள் இறந்து மரம் நடத் தொடங்கிய ஆண்டு\nL2. ஜவஹர்லால் நேரு பல்கலைக்கழகம் (JNU) 'இந்திய வனமகன்' பட்டம் வழங்கிய ஆண்டு\nL3. இந்திய அரசு 'பத்மஸ்ரீ' விருது வழங்கிச் சிறப்பித்த ஆண்டு\nL4. பயேங் தனியொருவராக உருவாக்கிய காட்டின் பரப்பளவு\nபட்டியல் II (ஆண்டு / அளவு):\nR1. 2012\nR2. 2015\nR3. 1360 ஏக்கர்\nR4. 1979"}], "options": {"A": "L1-R1, L2-R2, L3-R3, L4-R4", "B": "L1-R2, L2-R1, L3-R4, L4-R3", "C": "L1-R4, L2-R1, L3-R2, L4-R3", "D": "L1-R3, L2-R4, L3-R1, L4-R2"}, "explanation": "பாடநூல் விளக்கம்: வெள்ளம் = 1979 (R4); JNU இந்திய வனமகன் = 2012 (R1); பத்மஸ்ரீ = 2015 (R2); காட்டின் பரப்பு = 1360 ஏக்கர் (R3). வரிசை: 4 - 1 - 2 - 3."}, "en": {"blocks": [{"type": "text", "content": "Match Jadav Payeng's life milestones and honors with their respective dates/metrics:\nList I (Milestone / Honor):\nL1. Year of Brahmaputra flood and snake mortality triggering tree planting\nL2. Year JNU conferred 'Forest Man of India'\nL3. Year Government of India awarded 'Padma Shri'\nL4. Acreage of forest created by Payeng single-handedly\nList II (Year / Metric):\nR1. 2012\nR2. 2015\nR3. 1,360 acres\nR4. 1979"}], "options": {"A": "L1-R1, L2-R2, L3-R3, L4-R4", "B": "L1-R2, L2-R1, L3-R4, L4-R3", "C": "L1-R4, L2-R1, L3-R2, L4-R3", "D": "L1-R3, L2-R4, L3-R1, L4-R2"}, "explanation": "Textbook match: Sequence is 4 - 1 - 2 - 3."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "பாம்புகள் இறந்து மரம் நடத் தொடங்கிய ஆண்டு", "content_en": "Year tree planting began"}, {"id": "L2", "content_ta": "JNU 'இந்திய வனமகன்' பட்டம் வழங்கிய ஆண்டு", "content_en": "Year JNU conferred Forest Man"}, {"id": "L3", "content_ta": "இந்திய அரசு 'பத்மஸ்ரீ' விருது வழங்கிய ஆண்டு", "content_en": "Year Padma Shri awarded"}, {"id": "L4", "content_ta": "பயேங் உருவாக்கிய காட்டின் பரப்பளவு", "content_en": "Acreage of forest"}], "right": [{"id": "R1", "content_ta": "2012", "content_en": "2012"}, {"id": "R2", "content_ta": "2015", "content_en": "2015"}, {"id": "R3", "content_ta": "1360 ஏக்கர்", "content_en": "1,360 acres"}, {"id": "R4", "content_ta": "1979", "content_en": "1979"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 41, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "match", "payeng_milestones"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by"