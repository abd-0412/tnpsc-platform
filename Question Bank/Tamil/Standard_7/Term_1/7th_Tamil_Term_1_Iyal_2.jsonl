{"id": "7th-t1-u2-161", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l3-kapparkalai", "chapter_id": null, "topic_id": "sandhi-kalangarai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிரித்தெழுதுக:\n'கலங்கரைவிளக்கம்' என்னும் சொல்லைச் சரியாகப் பிரித்தெழுதக் கிடைக்கும் வடிவம் எது?"}], "options": {"A": "கலம் + கரை + விளக்கம்", "B": "கலன் + கரைவிளக்கம்", "C": "கலங்கரை + விளக்கம்", "D": "கல + கரை + விளக்கம்"}, "explanation": "இலக்கண விளக்கம்: கலம் (கப்பல்) + கரை (அழைத்தல் - கரைதல் தொழிற்சுட்டு) + விளக்கம் (ஒளிவிளக்கு) எனப் பிரியும். 'கலம் கரை விளக்கம்' என்பதே 'கலங்கரைவிளக்கம்' எனப் புணர்ந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Identify the correct grammatical separation of 'Kalangarai Vilakkam':"}], "options": {"A": "Kalam + Karai + Vilakkam", "B": "Kalan + Karaivilakkam", "C": "Kalangarai + Vilakkam", "D": "Kala + Karai + Vilakkam"}, "explanation": "Grammar explanation: Splits as Kalam (vessel) + Karai (beckoning) + Vilakkam (light)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 33, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "grammar", "sandhi_splitting"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-162", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l4-vilangugal-ulagam", "chapter_id": null, "topic_id": "ilakkana-kurippu-kattupadudhaadha", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கணக் குறிப்புத் தருக:\n'கட்டுப்படுத்த முடியாத யானை' - இதில் 'கட்டுப்படுத்த முடியாத' என்பதன் சரியான இலக்கணக் குறிப்பு யாது?"}], "options": {"A": "தெரிநிலை வினையெச்சம்", "B": "எதிர்மறைப் பெயரெச்சம்", "C": "வினையாலணையும் பெயர்", "D": "ஈறுகெட்ட எதிர்மறைப் பெயரெச்சம்"}, "explanation": "இலக்கண விதி: 'முடியாத' என்பது எதிர்மறைப் பொருளில் நின்று 'யானை' என்னும் பெயர்ச்சொல்லைக் கொண்டு முடிவதால் இது 'எதிர்மறைப் பெயரெச்சம்' ஆகும். (ஈற்றெழுத்து 'த' கெடாமல் உள்ளதால் ஈறுகெட்ட பெயரெச்சம் அன்று)."}, "en": {"blocks": [{"type": "text", "content": "Identify the grammatical category (Ilakkana Kurippu) of 'Kattupaduttha Mudiyaadha' in 'Kattupaduttha Mudiyaadha Yaanai':"}], "options": {"A": "Terinilai Vinaiyecham", "B": "Edhirmarai Peyarecham (Negative relative participle)", "C": "Vinaiyaalanaiyum Peyar", "D": "Eeruketta Edhirmarai Peyarecham"}, "explanation": "Grammar rule: A negative participle retaining terminal 'dha' modifying a following noun is an Edhirmarai Peyarecham."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source":