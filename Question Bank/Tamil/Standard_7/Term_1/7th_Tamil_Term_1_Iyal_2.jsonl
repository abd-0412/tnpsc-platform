// பாடம் 2: அப்படியே நிற்கட்டும் அந்த மரம் (கவிதைப்பேழை - கவிஞர் ராஜமார்த்தாண்டன்) [Q141 - Q168]
// கவிஞர் ராஜமார்த்தாண்டன், இதழாளர், விமர்சகர், கொல்லிப்பாவை சிற்றிதழ், ராஜமார்த்தாண்டன் கவிதைகள் (தமிழ் வளர்ச்சித் துறை பரிசு), கொங்குதேர் வாழ்க்கை சிறந்த கவிதைத் தொகுப்பு, ஊரின் வடகோடியில் நின்ற மரம், பரவசமூட்டும் நாவற்பழங்கள், பெருமழையில் வேரோடு சாய்ந்த மரம், இயற்கைப் பாதுகாப்பு
// ==============================================================================
{"id": "7th-t1-u2-141", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l3-kapparkalai", "chapter_id": null, "topic_id": "ship-components-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கப்பலின் முதன்மையான உறுப்புகள் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. கப்பலின் முதன்மையான உறுப்பாகிய அடிமரம் 'எரா' எனப்படும்.\n2. கப்பலின் குறுக்கு மரத்தை 'பருமல்' என்று அழைத்தனர்.\n3. கப்பலைச் செலுத்துவதற்கும் உரிய திசையில் திருப்புவதற்கும் பயன்படும் முதன்மைக் கருவி 'சுக்கான்' எனப்படும்.\n4. கப்பலை ஓரிடத்தில் நிலையாக நிறுத்தி வைக்க உதவும் கனத்த உறுப்பு 'நங்கூரம்' எனப்படும்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2 மட்டுமே சரி; 3, 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 மட்டுமே சரி; 1 தவறு", "D": "கூற்றுகள் 1, 3 மட்டுமே சரி; 2, 4 தவறு"}, "explanation": "பாடநூல் குறிப்பு: கப்பலின் அடிமரம் எரா, குறுக்குமரம் பருமல், திசைதிருப்பும் கருவி சுக்கான், நிலைநிறுத்தும் கருவி நங்கூரம். இந்நான்கு உறுப்புகளின் விளக்கங்களும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding the primary structural parts of Tamil ships:\n1. The principal keel (base beam) of the ship is known as 'Eraa'.\n2. The transverse cross-beams spanning the vessel are called 'Parumal'.\n3. The primary steering apparatus used to helm and turn the vessel is 'Sukkaan'.\n4. The heavy anchor device utilized to moor and stabilize the ship in place is 'Nangooram'.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Only statements 1 and 2 are correct", "C": "Only statements 2, 3, and 4 are correct", "D": "Only statements 1 and 3 are correct"}, "explanation": "Textbook fact: All four definitions regarding Eraa (keel), Parumal (crossbeam), Sukkaan (rudder), and Nangooram (anchor) are fully correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "கப்பலின் முதன்மையான உறுப்பாகிய அடிமரம் 'எரா' எனப்படும்.", "content_en": "The principal keel of the ship is known as 'Eraa'."}, {"id": "S2", "content_ta": "கப்பலின் குறுக்கு மரத்தை 'பருமல்' என்று அழைத்தனர்.", "content_en": "The transverse cross-beams are called 'Parumal'."}, {"id": "S3", "content_ta": "கப்பலைத் திசையில் திருப்புவதற்குப் பயன்படும் முதன்மைக் கருவி 'சுக்கான்' எனப்படும்.", "content_en": "The primary steering apparatus is 'Sukkaan'."}, {"id": "S4", "content_ta": "கப்பலை நிலையாக நிறுத்தி வைக்க உதவும் கனத்த உறுப்பு 'நங்கூரம்' எனப்படும்.", "content_en": "The heavy mooring anchor is 'Nangooram'."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 32, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "ship_components"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-142", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l3-kapparkalai", "chapter_id": null, "topic_id": "lighthouse-ports-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கலங்கரை விளக்கம் மற்றும் பழந்தமிழர் துறைமுகங்கள் பற்றிய கூற்றுகளை ஆராய்க:\n1. 'கலங்கரை விளக்கம்' என்பது கலம் (கப்பல்) + கரைதல் (அழைத்தல்) எனப் பிரிந்து, கப்பலை அழைக்கும் விளக்கு என்ற பொருளைத் தருகிறது.\n2. கடலில் செல்லும் கப்பல்களுக்குத் துறைமுகம் இருக்கும் இடத்தை வழிகாட்ட உயரமான கோபுரத்தின் உச்சியில் விளக்கு அமைக்கப்பட்டது.\n3. சங்க இலக்கியங்களில் கலங்கரை விளக்கம் 'மாட ஒள்ளெரி' என்று போற்றப்படுகிறது.\n4. பெரிய கப்பல்கள் துறைமுகத்தின் மிக ஆழமற்ற கடற்கரை மணல் வரை நேரடியாக வந்து சரக்குகளை இறக்கின.\nஇவற்றுள் சரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "B": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "D": "கூற்றுகள் அனைத்தும் சரி"}, "explanation": "பாடநூல் விளக்கம்: கடலில் ஆழம் குறைந்த பகுதிகளில் பெரிய கப்பல்கள் நேரடியாகக் கரைக்கு வர முடியாது என்பதால், அவை கடலிலேயே நிலைநிறுத்தப்பட்டு சிறிய தோணிகள் வழியாகவே சரக்குகள் கரைக்குக் கொண்டுவரப்பட்டன ('கலம் தந்த பொற்பரிசம் கழித்தோணியால் கரை சேர்க்குந்து'). எனவே கூற்று 4 தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding Lighthouses and ancient Tamil ports:\n1. 'Kalangarai Vilakkam' splits as Kalam (ship) + Karaidhal (beckoning/calling), signifying a light that summons ships.\n2. To guide seafaring vessels toward safe harbors, beacons were mounted atop lofty towers.\n3. Sangam classical texts designate the lighthouse beacon as 'Maada Ollaeri'.\n4. Deep-sea mega ships sailed directly onto shallow sandy beaches to unload their heavy cargo.\nSelect the correct option."}], "options": {"A": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "B": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect", "C": "Statements 2, 3, and 4 are correct; 1 is incorrect", "D": "All statements are correct"}, "explanation": "Textbook explanation: Large ships anchored offshore due to shallow harbor waters, while smaller boats (Thonigal) lightered goods ashore. Statement 4 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'கலங்கரை விளக்கம்' என்பது கப்பலை அழைக்கும் விளக்கு என்ற பொருளைத் தருகிறது.", "content_en": "'Kalangarai Vilakkam' signifies a beacon that beckons ships."}, {"id": "S2", "content_ta": "துறைமுகம் இருக்கும் இடத்தை வழிகாட்ட உயரமான கோபுரத்தின் உச்சியில் விளக்கு அமைக்கப்பட்டது.", "content_en": "Beacons mounted atop lofty towers guided vessels to ports."}, {"id": "S3", "content_ta": "சங்க இலக்கியங்களில் கலங்கரை விளக்கம் 'மாட ஒள்ளெரி' என்று போற்றப்படுகிறது.", "content_en": "Sangam texts celebrate lighthouses as 'Maada Ollaeri'."}, {"id": "S4", "content_ta": "பெரிய கப்பல்கள் துறைமுகத்தின் மணல் வரை நேரடியாக வந்து சரக்குகளை இறக்கின.", "content_en": "Mega ships directly beached on shallow sands to unload cargo."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 33, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "lighthouse_ports"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-143", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l4-vilangugal-ulagam", "chapter_id": null, "topic_id": "kalakkadu-reserve-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "களக்காடு முண்டந்துறை புலிகள் காப்பகம் பற்றிய கூற்றுகளை ஆராய்க:\n1. களக்காடு முண்டந்துறை புலிகள் காப்பகம் தமிழ்நாட்டின் இரண்டாவது மிகப்பெரிய வனவிலங்கு காப்பகமாகும்.\n2. இக்காப்பகம் சுமார் 895 சதுர கிலோமீட்டர் பரப்பளவு கொண்டதாக அமைந்துள்ளது.\n3. இக்காப்பகத்தில் யானை, புலி, சிறுத்தை, மான், கரடி முதலான பல காட்டு விலங்குகள் பாதுகாக்கப்பட்டு வருகின்றன.\n4. களக்காடு முண்டந்துறை தமிழ்நாட்டின் முதலாவது மற்றும் பரப்பளவில் மிகச் சிறிய காப்பகமாகும்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "B": "கூற்றுகள் அனைத்தும் சரி", "C": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "பாடநூல் விளக்கம்: களக்காடு முண்டந்துறை புலிகள் காப்பகம் 895 ச.கி.மீ பரப்பளவு கொண்ட தமிழ்நாட்டின் இரண்டாவது பெரிய காப்பகமாகும். அது மிகச் சிறிய காப்பகம் என்பது முரணான தவறான கூற்றாகும். எனவே கூற்று 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding the Kalakkadu Mundanthurai Tiger Reserve:\n1. Kalakkadu Mundanthurai is the second-largest tiger reserve in the state of Tamil Nadu.\n2. The sanctuary spans an expanse of approximately 895 square kilometers.\n3. It provides ecological sanctuary to diverse wildlife including elephants, tigers, leopards, deer, and bears.\n4. It is officially the first established and geographically smallest sanctuary in Tamil Nadu.\nWhich statements are correct?"}], "options": {"A": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "B": "All statements are correct", "C": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect", "D": "Statements 2, 3, and 4 are correct; 1 is incorrect"}, "explanation": "Textbook explanation: It spans 895 sq.km and ranks as Tamil Nadu's second largest reserve; claiming it is the smallest is blatantly incorrect. Statement 4 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "களக்காடு முண்டந்துறை புலிகள் காப்பகம் தமிழ்நாட்டின் இரண்டாவது மிகப்பெரிய காப்பகமாகும்.", "content_en": "Kalakkadu Mundanthurai is Tamil Nadu's second-largest reserve."}, {"id": "S2", "content_ta": "இக்காப்பகம் சுமார் 895 சதுர கிலோமீட்டர் பரப்பளவு கொண்டதாக அமைந்துள்ளது.", "content_en": "The sanctuary spans approximately 895 square kilometers."}, {"id": "S3", "content_ta": "இங்கு யானை, புலி, சிறுத்தை, மான், கரடி முதலான விலங்குகள் பாதுகாக்கப்பட்டு வருகின்றன.", "content_en": "It conserves elephants, tigers, leopards, deer, and bears."}, {"id": "S4", "content_ta": "களக்காடு முண்டந்துறை தமிழ்நாட்டின் மிகச் சிறிய காப்பகமாகும்.", "content_en": "It is the smallest wildlife sanctuary in Tamil Nadu."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 35, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "kalakkadu_sanctuary"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-144", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l4-vilangugal-ulagam", "chapter_id": null, "topic_id": "elephant-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "யானைகளின் உடலமைப்பு மற்றும் வாழ்வியல் குணங்கள் பற்றிய கூற்றுகளை ஆராய்க:\n1. உலகில் ஆசிய யானை, ஆப்பிரிக்க யானை என இரண்டு வகை யானைகள் மட்டுமே உள்ளன.\n2. ஆசிய யானைகளில் ஆண் யானைக்குத் தந்தம் உண்டு; பெண் யானைக்குத் தந்தம் இல்லை.\n3. ஆப்பிரிக்க யானைகளில் ஆண், பெண் ஆகிய இரண்டு யானைகளுக்குமே தந்தங்கள் உண்டு.\n4. யானைக் கூட்டத்திற்கு எப்போதும் வயதான ஓர் ஆண் யானையே தலைமை தாங்கி வழிநடத்தும்.\nஇவற்றுள் சரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் அனைத்தும் சரி", "B": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "C": "கூற்றுகள் 2, 3, 4 சரி; கூற்று 1 தவறு", "D": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு"}, "explanation": "பாடநூல் விளக்கம்: யானைக் கூட்டத்திற்கு எப்போதும் ஒரு பெண் யானையே தலைமை தாங்கும். ஆண் யானை தலைமை தாங்கும் என்பது தவறான கூற்றாகும். எனவே கூற்றுகள் 1, 2, 3 சரி; 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding the biology and social behavior of elephants:\n1. The world hosts exactly two extant elephant species: Asian elephants and African elephants.\n2. Among Asian elephants, only males possess tusks while females lack them.\n3. Among African elephants, both males and females possess prominent tusks.\n4. An elephant herd is invariably led and guided by an elderly bull (male) elephant.\nSelect the correct option."}], "options": {"A": "All statements are correct", "B": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "C": "Statements 2, 3, and 4 are correct; 1 is incorrect", "D": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect"}, "explanation": "Textbook explanation: Elephant matriarchy dictates that a herd is led by an elder female elephant, never a bull. Statement 4 is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "உலகில் ஆசிய யானை, ஆப்பிரிக்க யானை என இரண்டு வகை யானைகள் உள்ளன.", "content_en": "Two extant elephant species exist: Asian and African."}, {"id": "S2", "content_ta": "ஆசிய யானைகளில் ஆண் யானைக்குத் தந்தம் உண்டு; பெண் யானைக்குத் தந்தம் இல்லை.", "content_en": "In Asian elephants, males possess tusks whereas females do not."}, {"id": "S3", "content_ta": "ஆப்பிரிக்க யானைகளில் ஆண், பெண் இரண்டுக்குமே தந்தங்கள் உண்டு.", "content_en": "In African elephants, both sexes bear tusks."}, {"id": "S4", "content_ta": "யானைக் கூட்டத்திற்கு எப்போதும் வயதான ஓர் ஆண் யானையே தலைமை தாங்கும்.", "content_en": "An elephant herd is led by an elderly bull elephant."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "elephant_behavior"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-145", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l4-vilangugal-ulagam", "chapter_id": null, "topic_id": "elephant-nutrition-memory", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "யானைகளின் உணவு உட்கொள்ளல் மற்றும் உளவியல் இயல்புகள் பற்றிய கூற்றுகளை ஆராய்க:\n1. ஒரு வளர்ந்த யானை நாள் ஒன்றுக்கு சுமார் 250 கிலோகிராம் அளவிலான புல், இலைதழைகளை உணவாக உட்கொள்ளும்.\n2. ஒரு யானை நாள்தோறும் குடிப்பதற்குச் சுமார் 65 லிட்டர் தண்ணீர் தேவைப்படுகிறது.\n3. யானை மிகுந்த நினைவாற்றல் கொண்ட விலங்காகவும், அதே நேரத்தில் பாசம் நிறைந்த விலங்காகவும் திகழ்கிறது.\n4. யானைகள் இயல்பாக யாரையும் தாக்குவதில்லை; அவற்றின் வழித்தடங்கள் ஆக்கிரமிக்கப்படும்போதே மனிதர்களைத் தாக்குகின்றன.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2 மட்டுமே சரி; 3, 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 மட்டுமே சரி; 1 தவறு", "D": "கூற்றுகள் 1, 3 மட்டுமே சரி; 2, 4 தவறு"}, "explanation": "பாடநூல் குறிப்பு: ஒரு யானை ஒரு நாளைக்கு 250 கிலோ புல், தழைகள் உண்ணும்; 65 லிட்டர் தண்ணீர் குடிக்கும்; மிகுந்த நினைவாற்றலும் பாசமும் கொண்டது; தனது வழித்தடம் மறிக்கப்படும்போதே சினமுறுகிறது. இந்நான்கு கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements regarding elephant nutrition and behavioral psychology:\n1. An adult elephant consumes around 250 kilograms of grass, leaves, and fodder daily.\n2. An elephant requires roughly 65 liters of water daily for hydration.\n3. Elephants possess formidable memory power coupled with intense emotional affection.\n4. Elephants rarely attack unprovoked; conflicts arise when human encroachment obstructs their migratory corridors.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Only statements 1 and 2 are correct", "C": "Only statements 2, 3, and 4 are correct", "D": "Only statements 1 and 3 are correct"}, "explanation": "Textbook fact: All four statements regarding daily dietary intake (250 kg), water volume (65 L), and corridor ecology are validated."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ஒரு வளர்ந்த யானை நாள் ஒன்றுக்கு சுமார் 250 கிலோகிராம் புல், இலைகளை உண்ணும்.", "content_en": "An adult elephant eats around 250 kg of fodder daily."}, {"id": "S2", "content_ta": "ஒரு யானைக்கு நாள் ஒன்றுக்குக் குடிப்பதற்குச் சுமார் 65 லிட்டர் தண்ணீர் தேவைப்படுகிறது.", "content_en": "An elephant consumes approximately 65 liters of water daily."}, {"id": "S3", "content_ta": "யானை மிகுந்த நினைவாற்றல் கொண்ட விலங்காகவும், பாசம் நிறைந்ததாகவும் திகழ்கிறது.", "content_en": "Elephants have formidable memory and intense emotional bonds."}, {"id": "S4", "content_ta": "தமது வழித்தடங்கள் ஆக்கிரமிக்கப்படும்போது மட்டுமே யானைகள் மனிதர்களைத் தாக்குகின்றன.", "content_en": "Elephants attack when human activity encroaches on migratory paths."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "elephant_ecology"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-146", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l4-vilangugal-ulagam", "chapter_id": null, "topic_id": "bear-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கரடியின் உடல் தகவமைப்புகள் மற்றும் உணவுப் பழக்கங்கள் பற்றிய கூற்றுகளை ஆராய்க:\n1. கரடி ஓர் அனைத்துண்ணி (Omnivore) விலங்காகும்; அது பழங்கள், தாவரங்கள், பூச்சிகள் அனைத்தையும் உண்ணும்.\n2. கரடிக்கு மிகவும் பிடித்தமான முதன்மை உணவு கரையான் ஆகும்.\n3. கரடியின் உடலைப் போர்த்தியிருக்கும் அடர்ந்த ரோமங்கள் தேனீக்கள் கொட்டுவதிலிருந்தும் கடும் குளிரிலிருந்தும் அதைப் பாதுகாக்கின்றன.\n4. கரடிகள் புலியையும் சிங்கத்தையும் விட அதிக வேகத்தில் வேட்டையாடித் தாவரங்களை அறவே தவிர்ப்பவை.\nஇவற்றுள் சரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "B": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "D": "கூற்றுகள் அனைத்தும் சரி"}, "explanation": "பாடநூல் விளக்கம்: கரடி ஒரு சோம்பலான அனைத்துண்ணி விலங்கு; பழங்கள், கிழங்குகள், கரையான் ஆகியவற்றை உண்பது. அது தாவரங்களை அறவே தவிர்ப்பதும் புலியை விட வேகமாக வேட்டையாடுவதும் தவறான தகவல். எனவே கூற்று 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements regarding the anatomical adaptations and dietary habits of the bear:\n1. The bear is an omnivore; it feeds on fruits, plants, roots, and insects.\n2. The bear's most cherished and favorite delicacy is termites.\n3. The dense fur coat enveloping its body shields it from stinging bees and freezing temperatures.\n4. Bears hunt at higher speeds than tigers and lions, strictly avoiding plant diet.\nSelect the correct option."}], "options": {"A": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "B": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect", "C": "Statements 2, 3, and 4 are correct; 1 is incorrect", "D": "All statements are correct"}, "explanation": "Textbook explanation: Bears are omnivorous lovers of termites and fruits, not hyper-carnivores outspeeding big cats. Statement 4 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "கரடி ஓர் அனைத்துண்ணி விலங்காகும்; பழங்கள், பூச்சிகள் அனைத்தையும் உண்ணும்.", "content_en": "The bear is an omnivore consuming fruits, plants, and insects."}, {"id": "S2", "content_ta": "கரடிக்கு மிகவும் பிடித்தமான முதன்மை உணவு கரையான் ஆகும்.", "content_en": "The bear's favorite food is termites."}, {"id": "S3", "content_ta": "கரடியின் அடர்ந்த ரோமங்கள் தேனீக்கள் கொட்டுவதிலிருந்தும் குளிரிலிருந்தும் பாதுகாக்கின்றன.", "content_en": "Its dense fur protects it from bee stings and cold."}, {"id": "S4", "content_ta": "கரடிகள் புலியையும் விட வேகமாக வேட்டையாடித் தாவரங்களை அறவே தவிர்ப்பவை.", "content_en": "Bears hunt faster than tigers and strictly shun vegetation."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "bear_adaptations"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-147", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l3-kapparkalai", "chapter_id": null, "topic_id": "sails-and-ropes-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழந்தமிழரின் பாய்மரக் கப்பல்கள் மற்றும் கயிறுகள் பற்றிய கூற்றுகளை ஆராய்க:\n1. காற்றின் ஆற்றலைப் பயன்படுத்திக் கப்பலைச் செலுத்துவதற்குப் பாய்மரங்கள் உதவின.\n2. பெரிய பாய்மரம், திருக்கைத்தி பாய்மரம், கோம்புப் பாய்மரம் முதலிய பலவகையான பாய்மரங்களைப் பயன்படுத்தினர்.\n3. பாய்மரங்களையும் கப்பலையும் இணைத்துக் கட்ட ஆஞ்சான் கயிறு, மூட்டங்கயிறு, இளங்கயிறு, கோடிப்பாய் கயிறு போன்ற பலவிதக் கயிறுகளைப் பயன்படுத்தினர்.\n4. கப்பலில் பயன்படுத்தப்பட்ட பாய்மரங்களை இணைக்கும் கயிறுகள் அனைத்தையும் மணிமேகலை காப்பியம் மட்டுமே விரிவாகப் பட்டியலிடுகிறது.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "B": "கூற்றுகள் அனைத்தும் சரி", "C": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "பாடநூல் விளக்கம்: பாய்மரக் கப்பலின் கயிறுகளைப் பற்றி விரிவாகக் குறிப்பிடும் நூல் 'சேந்தன் திவாகரம்' நிகண்டு ஆகும். மணிமேகலை அல்ல. எனவே கூற்று 4 தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding ancient Tamil sail rigging and nautical ropes:\n1. Sails harnessed wind energy to propel seafaring vessels across the ocean.\n2. Shipwrights deployed diverse sails like Periya Paaimaram, Thirukkaithi Paaimaram, and Koompu Paaimaram.\n3. Nautical rigging utilized specialized cordage like Aanjaan, Moottangkayiru, Ilangkayiru, and Kodippaai ropes.\n4. Epic Manimekalai alone comprehensively catalogues all nautical cordage used in ships.\nWhich statements are correct?"}], "options": {"A": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "B": "All statements are correct", "C": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect", "D": "Statements 2, 3, and 4 are correct; 1 is incorrect"}, "explanation": "Textbook explanation: It is the classical lexicon 'Sendhan Dhivaagaram' that lists the nautical ropes and sails in detail, not Manimekalai. Statement 4 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "காற்றின் ஆற்றலைப் பயன்படுத்திக் கப்பலைச் செலுத்துவதற்குப் பாய்மரங்கள் உதவின.", "content_en": "Sails harnessed wind energy to propel vessels."}, {"id": "S2", "content_ta": "பெரிய பாய்மரம், கோம்புப் பாய்மரம் முதலிய பலவகையான பாய்மரங்களைப் பயன்படுத்தினர்.", "content_en": "Diverse sails like Periya and Koompu paaimaram were utilized."}, {"id": "S3", "content_ta": "பாய்மரக் கயிறுகளாக ஆஞ்சான் கயிறு, மூட்டங்கயிறு, இளங்கயிறு முதலியன பயன்பட்டன.", "content_en": "Ropes like Aanjaan, Moottangkayiru, and Ilangkayiru were deployed."}, {"id": "S4", "content_ta": "பாய்மரக் கயிறுகளை மணிமேகலை காப்பியம் மட்டுமே விரிவாகப் பட்டியலிடுகிறது.", "content_en": "Epic Manimekalai alone catalogues nautical cordage."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 32, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "sails_and_ropes"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-148", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l4-vilangugal-ulagam", "chapter_id": null, "topic_id": "elephant-tusk-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): ஆசிய பெண் யானைகளுக்குத் தந்தங்கள் இருப்பதில்லை.\nகாரணம் (R): பெண் யானைகள் பிறக்கும்போதே தந்தங்களைப் பெற்றிருந்தாலும், பருவம் அடைந்தவுடன் தந்தங்கள் தாமாகவே உதிர்ந்துவிடுகின்றன.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்", "B": "கூற்று தவறு; காரணம் சரி", "C": "கூற்று, காரணம் இரண்டும் தவறு", "D": "கூற்று சரி; ஆனால் காரணம் தவறு"}, "explanation": "பாடநூல் விளக்கம்: ஆசிய பெண் யானைகளுக்கு இயற்கையிலேயே தந்தம் உருவாவதில்லை (ஆண் யானைக்கு மட்டுமே தந்தம் உண்டு). பருவம் அடைந்தவுடன் தந்தங்கள் உதிர்ந்துவிடும் எனக் கூறுவது முற்றிலும் அறிவியல் மற்றும் பாடநூல் உண்மைக்கு முரணான தவறான காரண விளக்கம் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): Female Asian elephants do not possess tusks.\nReason (R): Even though female elephants are born with tusks, the tusks naturally shed and fall off upon reaching maturity.\nSelect the correct option."}], "options": {"A": "Both Assertion and Reason are correct; correct explanation", "B": "Assertion is incorrect; Reason is correct", "C": "Both Assertion and Reason are incorrect", "D": "Assertion is correct; but Reason is incorrect"}, "explanation": "Textbook explanation: Female Asian elephants genetically do not develop tusks. Claiming tusks shed at maturity is completely false."}}, "question_data": {"assertion": "ஆசிய பெண் யானைகளுக்குத் தந்தங்கள் இருப்பதில்லை.", "reason": "பெண் யானைகள் பிறக்கும்போதே தந்தங்களைப் பெற்றிருந்தாலும், பருவம் அடைந்தவுடன் தந்தங்கள் தாமாகவே உதிர்ந்துவிடுகின்றன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 36, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "elephant_tusks"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-149", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l3-kapparkalai", "chapter_id": null, "topic_id": "anchor-rudder-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): கப்பலை ஒரு குறிப்பிட்ட திசையில் செலுத்துவதற்குச் 'சுக்கான்' என்னும் கருவியும், அலைகளால் அடித்துச் செல்லப்படாமல் நிலைநிறுத்த 'நங்கூரம்' என்னும் கனத்த கருவியும் பயன்படுத்தப்பட்டன.\nகாரணம் (R): சுக்கான் சுழன்று கப்பலின் போக்கைத் திசைமாற்ற உதவுகிறது; நங்கூரம் தன் அதீத எடையினால் கடலடித் தளத்தில் பதிந்து கப்பலை நகராமல் பற்றிக் கொள்கிறது.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றுக்குச் சரியான விளக்கம் ஆகும்", "B": "கூற்று மற்றும் காரணம் இரண்டும் சரி; ஆனால் காரணம் கூற்றுக்குச் சரியான விளக்கமல்ல", "C": "கூற்று சரி; ஆனால் காரணம் தவறு", "D": "கூற்று தவறு; ஆனால் காரணம் சரி"}, "explanation": "பாடநூல் விளக்கம்: சுக்கான் கப்பலின் திசையைத் திருப்பும் உறுப்பாகவும், நங்கூரம் கப்பலை நிலைநிறுத்தும் உறுப்பாகவும் பயன்படும் உண்மையும் அதன் இயங்குமுறைக் காரணமும் பாடநூலின்படி முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): 'Sukkaan' steered the ship along intended trajectories, while heavy 'Nangooram' anchored it against wave drift.\nReason (R): Sukkaan swivels to alter rudder heading; Nangooram sinks by sheer deadweight into the seabed to hold the vessel fast.\nSelect the correct option."}], "options": {"A": "Both Assertion and Reason are correct; Reason correctly explains Assertion", "B": "Both Assertion and Reason are correct; but Reason does not explain Assertion", "C": "Assertion is correct; Reason is incorrect", "D": "Assertion is incorrect; Reason is correct"}, "explanation": "Textbook explanation: Both the functions and functional mechanics of rudder and anchor are precisely explained."}}, "question_data": {"assertion": "கப்பலை ஒரு குறிப்பிட்ட திசையில் செலுத்துவதற்குச் 'சுக்கான்' என்னும் கருவியும், அலைகளால் அடித்துச் செல்லப்படாமல் நிலைநிறுத்த 'நங்கூரம்' என்னும் கனத்த கருவியும் பயன்படுத்தப்பட்டன.", "reason": "சுக்கான் சுழன்று கப்பலின் போக்கைத் திசைமாற்ற உதவுகிறது; நங்கூரம் தன் அதீத எடையினால் கடலடித் தளத்தில் பதிந்து கப்பலை நகராமல் பற்றிக் கொள்கிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 32, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "rudder_anchor_physics"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current":