{"id": "7th-t1-u2-168", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l4-vilangugal-ulagam", "chapter_id": null, "topic_id": "bear-diet-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கரடிக்கு மிகவும் பிடித்தமான முதன்மையான உணவு எதுவெனப் பாடநூல் குறிப்பிடுகிறது?"}], "options": {"A": "மீன்", "B": "தேன் மட்டுமே", "C": "புல் பூண்டுகள்", "D": "கரையான்"}, "explanation": "பாடநூல் குறிப்பு: 'கரடிக்கு மிகவும் பிடித்த உணவு கரையான்' என வனவர் ஆதினியிடம் விளக்குகிறார்."}, "en": {"blocks": [{"type": "text", "content": "According to the textbook, which of the following is the most favorite food of a bear?"}], "options": {"A": "Fish", "B": "Honey alone", "C": "Grasses", "D": "Termites (கரையான்)"}, "explanation": "Textbook fact: Termites (கரையான்) are explicitly cited as the favorite food of bears."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "pap