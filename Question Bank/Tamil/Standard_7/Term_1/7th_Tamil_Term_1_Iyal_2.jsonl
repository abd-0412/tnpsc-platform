// ==============================================================================
// பாடம் 1: காடு (கவிதைப்பேழை - உவமைக் கவிஞர் சுரதா) [Q113 - Q140]
// சுரதா (இராசகோபாலன்), சுப்புரத்தினதாசன், உவமைக் கவிஞர், தேன்மழை (தமிழக அரசு பரிசு), துறைமுகம், சுவரும் சுண்ணாம்பும், கிளிக்கண்ணிப் பாவகைப் பாடல், காடு வாசம் தரும், கார்த்திகை தீபம் என காடெல்லாம் பூத்திருக்கும், பச்சைமயில் நடிக்கும், நச்சரவம் துவளும், வேழம் பிளிறும் இயற்கை வளம்
// ==============================================================================
{"id": "7th-t1-u2-113", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l1-kaadu", "chapter_id": null, "topic_id": "suradha-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுரதா பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. சுரதாவின் இயற்பெயர் இராசகோபாலன் ஆகும்.\n2. பாரதிதாசன் மீது மிகுந்த பற்று கொண்ட இவர், தம் பெயரை 'சுப்புரத்தினதாசன்' என மாற்றிக் கொண்டார்.\n3. உவமைகளைப் பயன்படுத்திக் கவிதைகள் எழுதுவதில் வல்லவர் என்பதால் இவர் 'உவமைக் கவிஞர்' என்று அழைக்கப்படுகிறார்.\n4. துறைமுகம், சுவரும் சுண்ணாம்பும், தேன்மழை உள்ளிட்ட பல நூல்களை இவர் இயற்றியுள்ளார்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2 மட்டுமே சரி; 3, 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 மட்டுமே சரி; 1 தவறு", "D": "கூற்றுகள் 1, 3 மட்டுமே சரி; 2, 4 தவறு"}, "explanation": "பாடநூல் குறிப்பு: சுரதாவின் இயற்பெயர் இராசகோபாலன்; பாரதிதாசன் மீது கொண்ட பற்றால் சுப்புரத்தினதாசன் என மாற்றிக்கொண்டார்; உவமைக் கவிஞர் என அழைக்கப்படுகிறார்; தேன்மழை, துறைமுகம், சுவரும் சுண்ணாம்பும் இவருடைய நூல்கள். எனவே அனைத்துக் கூற்றுகளும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding poet Suradha:\n1. Suradha's birth name is Rasagopalan.\n2. Out of immense affection for Bharathidasan, he styled his pen name as 'Subburathinadasan'.\n3. Renowned for crafting exquisite metaphors, he earned the title 'Uvamai Kavignar'.\n4. His notable works include Thuraimugam, Suvarum Sunnaambum, and Thaenmazhai.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Only statements 1 and 2 are correct", "C": "Only statements 2, 3, and 4 are correct", "D": "Only statements 1 and 3 are correct"}, "explanation": "Textbook fact: All four statements regarding Suradha's life, pen name, title, and literary compositions are thoroughly correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "சுரதாவின் இயற்பெயர் இராசகோபாலன் ஆகும்.", "content_en": "Suradha's birth name is Rasagopalan."}, {"id": "S2", "content_ta": "பாரதிதாசன் மீது மிகுந்த பற்று கொண்ட இவர், தம் பெயரை 'சுப்புரத்தினதாசன்' என மாற்றிக் கொண்டார்.", "content_en": "Out of immense affection for Bharathidasan, he styled his pen name as 'Subburathinadasan'."}, {"id": "S3", "content_ta": "உவமைகளைப் பயன்படுத்திக் கவிதைகள் எழுதுவதில் வல்லவர் என்பதால் இவர் 'உவமைக் கவிஞர்' என்று அழைக்கப்படுகிறார்.", "content_en": "Renowned for crafting exquisite metaphors, he earned the title 'Uvamai Kavignar'."}, {"id": "S4", "content_ta": "துறைமுகம், சுவரும் சுண்ணாம்பும், தேன்மழை உள்ளிட்ட பல நூல்களை இவர் இயற்றியுள்ளார்.", "content_en": "His notable works include Thuraimugam, Suvarum Sunnaambum, and Thaenmazhai."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 25, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "suradha"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-114", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l2-maram", "chapter_id": null, "topic_id": "rajamarthandan-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ராஜமார்த்தாண்டன் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. ராஜமார்த்தாண்டன் கவிஞர், இதழாளர், கவியரங்கக் கவிஞர், திறனாய்வாளர் எனப் பன்முகத் திறன் கொண்டவர்.\n2. 'கொல்லிப்பாவை' என்னும் சிற்றிதழை நடத்தி இளம் கவிஞர்களை ஊக்குவித்தவர்.\n3. இவரது 'ராஜமார்த்தாண்டன் கவிதைகள்' என்னும் நூல் தமிழக அரசின் தமிழ் வளர்ச்சித் துறைப் பரிசு பெற்றது.\n4. இவர் சிறந்த பாரதிதாசன் கவிதைகளைத் தொகுத்து 'கொங்குதேர் வாழ்க்கை' என்னும் நூலாக்கினார்.\nஇவற்றுள் சரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "B": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 சரி; கூற்று 1 தவறு", "D": "கூற்றுகள் அனைத்தும் சரி"}, "explanation": "பாடநூல் விளக்கம்: 'கொங்குதேர் வாழ்க்கை' என்பது சிறந்த தமிழ்க் கவிதைகளைத் தொகுத்து அவரால் வெளியிடப்பட்ட நூல் ஆகும்; அது பாரதிதாசன் கவிதைகளை மட்டுமே தொகுத்த நூல் அல்ல. எனவே கூற்று 4 தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding Rajamarthandan:\n1. Rajamarthandan was multifaceted as a poet, journalist, forum poet, and literary critic.\n2. He ran the literary magazine 'Kollippaavai' fostering emerging literary talents.\n3. His volume 'Rajamarthandan Kavithaigal' received the Tamil Nadu State Award.\n4. He compiled Bharathidasan's best poems under the title 'Kongu Ther Vaazhkkai'.\nSelect the correct option."}], "options": {"A": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "B": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect", "C": "Statements 2, 3, and 4 are correct; 1 is incorrect", "D": "All statements are correct"}, "explanation": "Textbook explanation: 'Kongu Ther Vaazhkkai' is an anthology of outstanding Tamil poems from diverse authors, not solely Bharathidasan's verses. Statement 4 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ராஜமார்த்தாண்டன் கவிஞர், இதழாளர், கவியரங்கக் கவிஞர், திறனாய்வாளர் எனப் பன்முகத் திறன் கொண்டவர்.", "content_en": "Rajamarthandan was multifaceted as a poet, journalist, forum poet, and literary critic."}, {"id": "S2", "content_ta": "'கொல்லிப்பாவை' என்னும் சிற்றிதழை நடத்தி இளம் கவிஞர்களை ஊக்குவித்தவர்.", "content_en": "He ran the literary magazine 'Kollippaavai' fostering emerging literary talents."}, {"id": "S3", "content_ta": "இவரது 'ராஜமார்த்தாண்டன் கவிதைகள்' என்னும் நூல் தமிழக அரசின் தமிழ் வளர்ச்சித் துறைப் பரிசு பெற்றது.", "content_en": "His volume 'Rajamarthandan Kavithaigal' received the Tamil Nadu State Award."}, {"id": "S4", "content_ta": "இவர் சிறந்த பாரதிதாசன் கவிதைகளைத் தொகுத்து 'கொங்குதேர் வாழ்க்கை' என்னும் நூலாக்கினார்.", "content_en": "He compiled Bharathidasan's best poems under the title 'Kongu Ther Vaazhkkai'."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 28, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "rajamarthandan"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-115", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l3-kapparkalai", "chapter_id": null, "topic_id": "watercraft-classification", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழரின் நீர்வழிப் பயணக் கலன்கள் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. தமிழர்கள் ஆறு, ஏரி, குளம் போன்ற சிறிய நீர்நிலைகளைக் கடக்க கட்டுமரம், தோணி, ஓடம், படகு, புணை, மிதவை, தெப்பம் போன்றவற்றைப் பயன்படுத்தினர்.\n2. கடல் போன்ற பரந்த நீர்ப்பரப்பைக் கடந்து வெளிநாடுகளுக்குப் பயணம் செய்ய கலம், வங்கம், நாவாய் முதலிய பெரிய கலன்களைப் பயன்படுத்தினர்.\n3. தொல்காப்பியம் 'முந்நீர் வழக்கம்' எனக் கடல் பயணத்தைக் குறிப்பிடுகிறது.\n4. 'நாவாய்' என்னும் சொல் சிறிய அளவிலான உள்நாட்டுப் படகுகளுக்கு மட்டுமே வழங்கப்பட்ட சொல்லாகும்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "B": "கூற்றுகள் அனைத்தும் சரி", "C": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; கூற்று 1 தவறு"}, "explanation": "பாடநூல் விளக்கம்: 'நாவாய்' என்பது கடலில் பயணம் செய்யப் பயன்பட்ட மிகப் பெரிய கலன்களுள் ஒன்றாகும். சிறிய உள்நாட்டுப் படகு என்பது தவறானது. எனவே கூற்று 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding ancient Tamil watercraft classifications:\n1. Tamils used Kattumaram, Thoni, Odam, Padagu, Punai, Midhavai, and Theppam to traverse small inland water bodies.\n2. For transoceanic voyages to foreign shores, they deployed colossal vessels like Kalam, Vangam, and Naavaai.\n3. Tholkappiyam explicitly records transoceanic voyages as 'Munneer Vazhakku'.\n4. The term 'Naavaai' was exclusively reserved for small domestic river rafts.\nWhich statements are correct?"}], "options": {"A": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "B": "All statements are correct", "C": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect", "D": "Statements 2, 3, and 4 are correct; 1 is incorrect"}, "explanation": "Textbook explanation: 'Naavaai' designates large seaworthy seafaring vessels, not small inland riverboats. Statement 4 is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "தமிழர்கள் சிறிய நீர்நிலைகளைக் கடக்க கட்டுமரம், தோணி, ஓடம், படகு, புணை, மிதவை, தெப்பம் போன்றவற்றைப் பயன்படுத்தினர்.", "content_en": "Tamils used Kattumaram, Thoni, Odam, Padagu, Punai, Midhavai, and Theppam for small water bodies."}, {"id": "S2", "content_ta": "கடல் போன்ற பரந்த நீர்ப்பரப்பைக் கடக்க கலம், வங்கம், நாவாய் முதலிய பெரிய கலன்களைப் பயன்படுத்தினர்.", "content_en": "For transoceanic voyages, they deployed large vessels like Kalam, Vangam, and Naavaai."}, {"id": "S3", "content_ta": "தொல்காப்பியம் 'முந்நீர் வழக்கம்' எனக் கடல் பயணத்தைக் குறிப்பிடுகிறது.", "content_en": "Tholkappiyam records sea travel as 'Munneer Vazhakku'."}, {"id": "S4", "content_ta": "'நாவாய்' என்னும் சொல் சிறிய அளவிலான உள்நாட்டுப் படகுகளுக்கு மட்டுமே வழங்கப்பட்ட சொல்லாகும்.", "content_en": "The term 'Naavaai' was exclusively reserved for small domestic river rafts."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "watercraft_classification"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-116", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l1-kaadu", "chapter_id": null, "topic_id": "kilikkanni-poetic-form", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுரதாவின் 'காடு' பாடல் மற்றும் கிளிக்கண்ணிப் பாவகை பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. கிளியின் மொழி போன்ற இனிய சொற்களைப் பேசும் பெண்ணை நோக்கிக் கூறுவதாக அமைந்த பாடல் பாவகை 'கிளிக்கண்ணி' ஆகும்.\n2. கிளிக்கண்ணிப் பாடல்கள் இரண்டிரண்டு அடிகள் கொண்ட எதுகையால் தொடுக்கப்படும் கண்ணிகளாக அமைந்தவை.\n3. சுரதாவின் 'காடு' என்னும் பாடல் 'தேன்மழை' என்னும் கவிதை நூலில் இடம்பெற்றுள்ள காடு என்னும் பகுதியிலிருந்து எடுக்கப்பட்டது.\n4. 'தேன்மழை' என்னும் கவிதை நூலுக்கு சாகித்திய அகாதெமி விருது வழங்கப்பட்டது.\nஇவற்றுள் சரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் அனைத்தும் சரி", "B": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "C": "கூற்றுகள் 2, 3, 4 சரி; கூற்று 1 தவறு", "D": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு"}, "explanation": "பாடநூல் குறிப்பு: சுரதாவின் 'தேன்மழை' என்னும் நூல் தமிழக அரசின் தமிழ் வளர்ச்சித் துறைப் பரிசைப் பெற்றது; சாகித்திய அகாதெமி விருது பெற்றது என்பது தவறான கூற்று. எனவே கூற்றுகள் 1, 2, 3 சரி; 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding Suradha's 'Kaadu' poem and Kilikkanni poetic meter:\n1. Kilikkanni meter addresses a young maiden whose speech resembles a gentle parrot's melody.\n2. Kilikkanni verses are structured as rhyming couplets (Kannigal) sharing rhythmic Edhugai.\n3. 'Kaadu' is excerpted from the section titled Kaadu in Suradha's poetry collection 'Thaenmazhai'.\n4. Suradha's 'Thaenmazhai' was awarded the Sahitya Akademi Award.\nSelect the correct option."}], "options": {"A": "All statements are correct", "B": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "C": "Statements 2, 3, and 4 are correct; 1 is incorrect", "D": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect"}, "explanation": "Textbook fact: 'Thaenmazhai' won the Tamil Nadu State Government Award, not the Sahitya Akademi Award. Statement 4 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "கிளியின் மொழி போன்ற இனிய சொற்களைப் பேசும் பெண்ணை நோக்கிக் கூறுவதாக அமைந்த பாடல் பாவகை 'கிளிக்கண்ணி' ஆகும்.", "content_en": "Kilikkanni meter addresses a young maiden whose speech resembles a parrot."}, {"id": "S2", "content_ta": "கிளிக்கண்ணிப் பாடல்கள் இரண்டிரண்டு அடிகள் கொண்ட எதுகையால் தொடுக்கப்படும் கண்ணிகளாக அமைந்தவை.", "content_en": "Kilikkanni verses are structured as rhyming couplets sharing rhythmic Edhugai."}, {"id": "S3", "content_ta": "சுரதாவின் 'காடு' என்னும் பாடல் 'தேன்மழை' என்னும் கவிதை நூலில் இடம்பெற்றுள்ள காடு என்னும் பகுதியிலிருந்து எடுக்கப்பட்டது.", "content_en": "'Kaadu' is excerpted from the Kaadu section of 'Thaenmazhai'."}, {"id": "S4", "content_ta": "'தேன்மழை' என்னும் கவிதை நூலுக்கு சாகித்திய அகாதெமி விருது வழங்கப்பட்டது.", "content_en": "Suradha's 'Thaenmazhai' was awarded the Sahitya Akademi Award."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 25, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "kilikkanni_form"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-117", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l3-kapparkalai", "chapter_id": null, "topic_id": "shipbuilding-timber-rules", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழந்தமிழரின் கப்பல் கட்டும் மரத்தேர்வு மற்றும் தொழில்நுட்பம் பற்றிய கூற்றுகளை ஆராய்க:\n1. கப்பலின் பக்கங்களுக்கு வேம்பு, இலுப்பை, புன்னை, நாவல் போன்ற உறுதிமிக்க மரங்களைப் பயன்படுத்தினர்.\n2. கப்பலின் உட்பகுதிகளுக்குத் தேக்கு, வெண்தேக்கு போன்ற எடை குறைந்த ஆனால் உறுதி வாய்ந்த மரங்களைப் பயன்படுத்தினர்.\n3. மரத்தின் வெட்டப்பட்ட பகுதியை 'வெட்டுவாய்' என்றும், மரத்தில் உள்ள இயற்கைச் சுழியை 'கண்ணடை' என்றும் குறிப்பிட்டனர்.\n4. சுழி உள்ள மரங்களை உற்றுநோக்கி, அத்தகைய மரங்களை வலிமையற்றவை என்று தவிர்த்தனர்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2 மட்டுமே சரி; 3, 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 மட்டுமே சரி; 1 தவறு", "D": "கூற்றுகள் 1, 3 மட்டுமே சரி; 2, 4 தவறு"}, "explanation": "பாடநூல் விளக்கம்: கப்பல் கட்டுமானத்திற்கு தமிழர்கள் பயன்படுத்திய மர வகைகள் (பக்கங்களுக்கு வேம்பு, இலுப்பை, புன்னை, நாவல்; உட்பகுதிக்குத் தேக்கு, வெண்தேக்கு), வெட்டுவாய், கண்ணடை மற்றும் சுழி உள்ள மரங்களைத் தவிர்த்தல் ஆகிய நான்கு கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding ancient Tamil timber selection and shipbuilding technology:\n1. For the ship's flanks, hardy timbers like neem, mahua, pinnai, and naval were employed.\n2. For inner decks, teak and white teak were utilized.\n3. The cut cross-section of timber was called 'Vettuvai' and natural knots were termed 'Kannadai'.\n4. Knotted timbers were inspected and rejected due to structural vulnerability.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Only statements 1 and 2 are correct", "C": "Only statements 2, 3, and 4 are correct", "D": "Only statements 1 and 3 are correct"}, "explanation": "Textbook explanation: All four statements regarding timber choices, hull construction, knot avoidance, and nomenclature are fully correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "கப்பலின் பக்கங்களுக்கு வேம்பு, இலுப்பை, புன்னை, நாவல் போன்ற உறுதிமிக்க மரங்களைப் பயன்படுத்தினர்.", "content_en": "Neem, mahua, pinnai, and naval timbers were used for the ship flanks."}, {"id": "S2", "content_ta": "கப்பலின் உட்பகுதிகளுக்குத் தேக்கு, வெண்தேக்கு போன்ற மரங்களைப் பயன்படுத்தினர்.", "content_en": "Teak and white teak were deployed for inner ship decks."}, {"id": "S3", "content_ta": "மரத்தின் வெட்டப்பட்ட பகுதியை 'வெட்டுவாய்' என்றும், சுழியை 'கண்ணடை' என்றும் குறிப்பிட்டனர்.", "content_en": "Cut surface was termed 'Vettuvai' and knots 'Kannadai'."}, {"id": "S4", "content_ta": "சுழி உள்ள மரங்களை உற்றுநோக்கி, அத்தகைய மரங்களை கப்பல் கட்டப் பயன்படுத்தாமல் தவிர்த்தனர்.", "content_en": "Knotted timbers were carefully identified and avoided in shipbuilding."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 31, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "shipbuilding_technology"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-118", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l2-maram", "chapter_id": null, "topic_id": "maram-poem-content", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ராஜமார்த்தாண்டனின் 'அப்படியே நிற்கட்டும் அந்த மரம்' கவிதை பற்றிய கூற்றுகளை ஆராய்க:\n1. ஊரின் வடகோடியில் ஐந்தாண்டுகள் முந்தைய சிறுவயது நினைவுகளோடு பரந்து விரிந்து நின்ற நாவல் மரத்தைப் பற்றிப் பேசுகிறது.\n2. பகலில் காக்கை, குருவி, மைனா, கிளிகள் போன்ற பலவகை பறவைகளின் குரல்களாலும், இரவில் வௌவால்களாலும் மரம் உயிர்ப்புடன் திகழ்ந்தது.\n3. நாவற்பழங்களை சிறுவர்கள் சிறு சிறு கோலிக்குண்டுகளுக்கு ஒப்பிட்டுப் பொறுக்கித் தின்றனர்.\n4. நேற்றிரவு வீசிய பேய்க்காற்றிலும் அந்த மரம் சாயாமல் உறுதியாக நின்றது என கவிதை முடிகிறது.\nஇவற்றுள் சரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "B": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "D": "கூற்றுகள் அனைத்தும் சரி"}, "explanation": "பாடநூல் விளக்கம்: நேற்றிரவு வீசிய பெருங்காற்றில் அந்த மரம் வேரோடு சாய்ந்துவிட்டது; ஆனால் கவிஞரின் மனதில் அது சாய்ந்துவிடாமல் என்றென்றும் பசுமையாக 'அப்படியே நிற்கட்டும்' என்றே கவிதை முடிகிறது. எனவே கூற்று 4 தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements on Rajamarthandan's poem 'Appadiye Nirkattum Andha Maram':\n1. It portrays a jamun (naval) tree standing at the northern boundary of the village evoking childhood memories.\n2. The tree resonated with crows, sparrows, mynahs, parrots by day and bats by night.\n3. Children picked up fallen purple jamun fruits comparing them to shiny glass marbles.\n4. The poem ends by celebrating that the tree withstood last night's fierce hurricane standing tall.\nSelect the correct option."}], "options": {"A": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "B": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect", "C": "Statements 2, 3, and 4 are correct; 1 is incorrect", "D": "All statements are correct"}, "explanation": "Textbook explanation: The hurricane uprooted the tree in reality; the poet wishes it remains standing upright forever in his poetic memory. Statement 4 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ஊரின் வடகோடியில் பரந்து விரிந்து நின்ற நாவல் மரத்தைப் பற்றிப் பேசுகிறது.", "content_en": "It portrays a jamun tree standing at the northern boundary of the village."}, {"id": "S2", "content_ta": "பகலில் பறவைகளின் ஒலியாலும், இரவில் வௌவால்களாலும் மரம் உயிர்ப்புடன் திகழ்ந்தது.", "content_en": "The tree resonated with birds by day and bats by night."}, {"id": "S3", "content_ta": "நாவற்பழங்களை சிறுவர்கள் சிறு கோலிக்குண்டுகளுக்கு ஒப்பிட்டுப் பொறுக்கித் தின்றனர்.", "content_en": "Children picked up jamun fruits comparing them to glass marbles."}, {"id": "S4", "content_ta": "நேற்றிரவு வீசிய பேய்க்காற்றிலும் அந்த மரம் சாயாமல் உறுதியாக நின்றது என கவிதை முடிகிறது.", "content_en": "The poem ends stating the tree withstood the fierce hurricane."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "maram_poem"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-119", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l3-kapparkalai", "chapter_id": null, "topic_id": "sangam-literature-shipping", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க இலக்கியங்கள் குறிப்பிடும் கப்பற்கலை பற்றிய கூற்றுகளை ஆராய்க:\n1. 'நளியிரு முந்நீர் நாவாய் ஓட்டி வளி தொழில் ஆண்ட உரவோன் மருக' என்னும் புறநானூற்றுப் பாடலில் வெண்ணிக்குயத்தியார் கரிகால் பெருவளத்தானைப் போற்றுகிறார்.\n2. 'கூம்பொடு மீப்பாய் களையாது மிசைப்பரந்தோண்டாது' என்று பட்டினப்பாலை கப்பலின் பாய்மர அமைப்பைக் குறிப்பிடுகிறது.\n3. 'கலஞ்செய் கம்மியர் வருகெனக் கூஉய்' என்று புறநானூறு கப்பல் கட்டும் கலைஞர்களை அழைப்பதாகக் கூறுகிறது.\n4. சிலப்பதிகாரத்தில் மாநாய்கன், மாசாத்துவான் என்னும் பெயர்கள் கடல் மற்றும் நில வணிகர்களைக் குறிப்பிடுகின்றன.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 3 சரி; 2, 4 தவறு", "B": "கூற்றுகள் அனைத்தும் சரி", "C": "கூற்றுகள் 1, 2, 4 சரி; கூற்று 3 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; கூற்று 1 தவறு"}, "explanation": "பாடநூல் விளக்கம்: 'கலஞ்செய் கம்மியர் வருகெனக் கூஉய்' என்னும் அடி இடம்பெற்ற நூல் மணிமேகலை ஆகும் (புறநானூறு அன்று). எனவே கூற்று 3 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding maritime references in Sangam literature:\n1. In Purananuru, poetess Vennikkuyatthiyar praises Karikalan's mastery over maritime winds.\n2. Pattinappalai mentions ship masts and sails with 'Koompodu meeppaai kalaiyaadhu...'.\n3. Purananuru mentions shipbuilders as 'Kalanjey kammiyar varugenak koouy'.\n4. Silappathikaram mentions Maanaaykan and Maasaatthuvaan as ocean and land merchants.\nWhich statements are correct?"}], "options": {"A": "Statements 1 and 3 are correct; 2 and 4 are incorrect", "B": "All statements are correct", "C": "Statements 1, 2, and 4 are correct; Statement 3 is incorrect", "D": "Statements 2, 3, and 4 are correct; 1 is incorrect"}, "explanation": "Textbook explanation: 'Kalanjey kammiyar varugenak koouy' is from epic Manimekalai, not Purananuru. Statement 3 is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'நளியிரு முந்நீர் நாவாய் ஓட்டி...' என வெண்ணிக்குயத்தியார் கரிகாலனைப் போற்றுகிறார்.", "content_en": "Vennikkuyatthiyar praises Karikalan's wind mastery in Purananuru."}, {"id": "S2", "content_ta": "'கூம்பொடு மீப்பாய் களையாது...' என்று பட்டினப்பாலை குறிப்பிடுகிறது.", "content_en": "Pattinappalai notes ship sails and masts."}, {"id": "S3", "content_ta": "'கலஞ்செய் கம்மியர் வருகெனக் கூஉய்' என்று புறநானூறு கூறுகிறது.", "content_en": "'Kalanjey kammiyar...' appears in Purananuru."}, {"id": "S4", "content_ta": "சிலப்பதிகாரத்தில் மாநாய்கன், மாசாத்துவான் ஆகிய பெயர்கள் பெருவணிகர்களைக் குறிக்கின்றன.", "content_en": "Silappathikaram records Maanaaykan and Maasaatthuvaan."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 31, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "sangam_shipping_references"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-120", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l1-kaadu", "chapter_id": null, "topic_id": "suradha-metaphor-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): கவிஞர் சுரதா தமிழ்க் கவிதை உலகில் 'உவமைக் கவிஞர்' என்று பரவலாகப் பாராட்டப்படுகிறார்.\nகாரணம் (R): இவர் மரபுக் கவிதைகளை முற்றிலும் புறக்கணித்துவிட்டு, ஆங்கில உரைநடை உத்திகளை மட்டுமே பயன்படுத்தி கவிதைகள் இயற்றினார்.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் சரியான விளக்கம்", "B": "கூற்று மற்றும் காரணம் இரண்டும் சரி; ஆனால் விளக்கம் தவறு", "C": "கூற்று தவறு; ஆனால் காரணம் சரி", "D": "கூற்று சரி; ஆனால் காரணம் தவறு"}, "explanation": "பாடநூல் விளக்கம்: சுரதா தம் கவிதைகளில் உவமைகளைச் சிறந்த முறையில் நயம்படக் கையாண்டதால் 'உவமைக் கவிஞர்' எனப்பட்டார். அவர் மரபுக் கவிதைகளை புறக்கணித்து ஆங்கில உத்திகளை மட்டுமே பயன்படுத்தினார் என்பது முற்றிலும் தவறான காரண விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): Poet Suradha is widely acclaimed across Tamil literature as 'Uvamai Kavignar'.\nReason (R): He totally rejected classical Tamil verse meters and wrote solely through English prose styles.\nSelect the correct option."}], "options": {"A": "Both Assertion and Reason are correct; Reason is correct explanation", "B": "Both Assertion and Reason are correct; but Reason does not explain", "C": "Assertion is incorrect; Reason is correct", "D": "Assertion is correct; but Reason is incorrect"}, "explanation": "Textbook explanation: Suradha earned the title 'Uvamai Kavignar' for his unmatched mastery of Tamil similes and metaphors. Reason asserting he abandoned classical verse is entirely false."}}, "question_data": {"assertion": "கவிஞர் சுரதா தமிழ்க் கவிதை உலகில் 'உவமைக் கவிஞர்' என்று பரவலாகப் பாராட்டப்படுகிறார்.", "reason": "இவர் மரபுக் கவிதைகளை முற்றிலும் புறக்கணித்துவிட்டு, ஆங்கில உரைநடை உத்திகளை மட்டுமே பயன்படுத்தி கவிதைகள் இயற்றினார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 25, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "suradha_title"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-121", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l3-kapparkalai", "chapter_id": null, "topic_id": "ship-joints-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): பழந்தமிழர்கள் கட்டிய கப்பல்களின் அடிப்பகுதியில் சுண்ணாம்பையும் சணலையும் கலந்து அரைத்து எண்ணெயுடன் பூசினர்.\nகாரணம் (R): இக்கலவை மரப்பலகைகளிடையே நீர் உட்புகாமல் தடுத்து, மரங்கள் நீண்ட காலம் பூச்சிகளாலும் உப்புநீராலும் பழுதடையாமல் பாதுகாக்க உதவியது.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றுக்குச் சரியான விளக்கம் ஆகும்", "B": "கூற்று மற்றும் காரணம் இரண்டும் சரி; ஆனால் காரணம் கூற்றுக்குச் சரியான விளக்கமல்ல", "C": "கூற்று சரி; ஆனால் காரணம் தவறு", "D": "கூற்று தவறு; ஆனால் காரணம் சரி"}, "explanation": "பாடநூல் விளக்கம்: கப்பல் அடிப்புறத்தில் சுண்ணாம்பையும் சணலையும் எண்ணெயுடன் கலந்து பூசியதால் பல்லாண்டுகள் கப்பல் பழுதடையாமல் காக்கப்பட்டது. கூற்று, காரணம் இரண்டும் சரி, சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): Ancient Tamils coated the hull bottoms of ships with a ground paste of lime, hemp, and oil.\nReason (R): This paste prevented seawater infiltration and preserved the wooden planks against marine decay and saltwater erosion.\nSelect the correct option."}], "options": {"A": "Both Assertion and Reason are correct; Reason correctly explains Assertion", "B": "Both Assertion and Reason are correct; but Reason does not explain Assertion", "C": "Assertion is correct; Reason is incorrect", "D": "Assertion is incorrect; Reason is correct"}, "explanation": "Textbook explanation: The lime-hemp-oil sealant provided waterproofing and structural durability to wooden hulls. Both are correct and logically coherent."}}, "question_data": {"assertion": "பழந்தமிழர்கள் கட்டிய கப்பல்களின் அடிப்பகுதியில் சுண்ணாம்பையும் சணலையும் கலந்து அரைத்து எண்ணெயுடன் பூசினர்.", "reason": "இக்கலவை மரப்பலகைகளிடையே நீர் உட்புகாமல் தடுத்து, மரங்கள் நீண்ட காலம் பூச்சிகளாலும் உப்புநீராலும் பழுதடையாமல் பாதுகாக்க உதவியது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 32, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "ship_preservation"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-122", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l2-maram", "chapter_id": null, "topic_id": "kalapriya-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): 'குழந்தைகள் வரைந்தன பறவைகளை மட்டுமே; வானம் தானாக உருவானது' என்பது நவீனக் கவிஞர் கலாப்ரியாவின் புகழ்பெற்ற கவிதை வரியாகும்.\nகாரணம் (R): இக்கவிதை குழந்தைகளின் மாசற்ற இயல்பான படைப்பாற்றலையும் இயற்கையின் தன்னியல்பான அழகியலையும் மிக ஆழமாகச் சுட்டுகிறது.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று சரி; காரணம் தவறு", "B": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றுக்குச் சரியான விளக்கமாகும்", "C": "கூற்று தவறு; காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் விளக்கம்: பாடநூலில் இடம்பெற்றுள்ள கலாப்ரியாவின் கவிதை வரிகள் குழந்தைகளின் எல்லையற்ற கற்பனையையும் வானத்தின் விரிவையும் நயம்பட உரைக்கின்றன. கூற்று, காரணம் இரண்டும் சரி, சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): 'Children drew only the birds; the sky took shape on its own' is a renowned poetic line by Kalapriya.\nReason (R): This verse poignantly captures the pristine spontaneity of children's creativity and the self-unfolding harmony of nature.\nSelect the correct option."}], "options": {"A": "Assertion is correct; Reason is incorrect", "B": "Both Assertion and Reason are correct; Reason is the correct explanation", "C": "Assertion is incorrect; Reason is correct", "D": "Both Assertion and Reason are incorrect"}, "explanation": "Textbook explanation: Both the authorship attribution to Kalapriya and the aesthetic interpretation are accurate."}}, "question_data": {"assertion": "'குழந்தைகள் வரைந்தன பறவைகளை மட்டுமே; வானம் தானாக உருவானது' என்பது நவீனக் கவிஞர் கலாப்ரியாவின் புகழ்பெற்ற கவிதை வரியாகும்.", "reason": "இக்கவிதை குழந்தைகளின் மாசற்ற இயல்பான படைப்பாற்றலையும் இயற்கையின் தன்னியல்பான அழகியலையும் மிக ஆழமாகச் சுட்டுகிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 28, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "kalapriya_quote"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-123", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l3-kapparkalai", "chapter_id": null, "topic_id": "walker-quote-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): ஆங்கில அறிஞர் வாக்கர், தமிழர்கள் கட்டிய கப்பல்களைப் பன்னிரண்டு ஆண்டுகளுக்கு ஒருமுறை பழுதுபார்க்க வேண்டும் என்று கூறினார்.\nகாரணம் (R): தமிழர்கள் கப்பல் கட்டுவதற்கு மலிவான மர ஆணிகளான 'தொகுதி'களைப் பயன்படுத்தியதே இதன் அடிப்படைக் காரணமாகும்.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி", "B": "கூற்று சரி; காரணம் தவறு", "C": "கூற்று தவறு; காரணத்தின் உரைப்பும் தவறானது", "D": "கூற்று சரி; சரியான விளக்கம்"}, "explanation": "பாடநூல் விளக்கம்: வாக்கர் கூறியது: 'ஆங்கிலேயர் கட்டிய கப்பல்களைப் பன்னிரண்டு ஆண்டுகளுக்கு ஒருமுறை பழுதுபார்க்க வேண்டும்; தமிழர்கள் கட்டிய கப்பல்களை ஐம்பது ஆண்டுகள் ஆனாலும் பழுதுபார்க்க வேண்டியதில்லை'. எனவே கூற்று தவறானது; காரணமும் தவறான தகவலாகும்."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): British scholar Walker remarked that ships built by Tamils required repair every 12 years.\nReason (R): This was primarily because Tamils utilized inexpensive wooden nails known as 'Thogudhi'.\nSelect the correct option."}], "options": {"A": "Both Assertion and Reason are correct", "B": "Assertion is correct; Reason is incorrect", "C": "Assertion is incorrect; the factual premise in Reason is also false", "D": "Assertion is correct; correct explanation"}, "explanation": "Textbook explanation: Walker praised Tamil ships for needing no repair for 50 years, while British ships needed repairs every 12 years. Both Assertion and Reason are false."}}, "question_data": {"assertion": "ஆங்கில அறிஞர் வாக்கர், தமிழர்கள் கட்டிய கப்பல்களைப் பன்னிரண்டு ஆண்டுகளுக்கு ஒருமுறை பழுதுபார்க்க வேண்டும் என்று கூறினார்.", "reason": "தமிழர்கள் கப்பல் கட்டுவதற்கு மலிவான மர ஆணிகளான 'தொகுதி'களைப் பயன்படுத்தியதே இதன் அடிப்படைக் காரணமாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 32, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "walker_ship_quote"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-124", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l1-kaadu", "chapter_id": null, "topic_id": "forest-wealth-quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): 'காட்டின் வளமே நாட்டின் வளம்' என்று சுற்றுச்சூழல் அறிஞர்கள் மற்றும் பொருளியலாளர்கள் கூறுகின்றனர்.\nகாரணம் (R): காடுகளிலிருந்து கிடைக்கும் மரங்களை வெளிநாடுகளுக்கு ஏற்றுமதி செய்து அதிகப் பணம் ஈட்டுவதே ஒரு நாட்டின் பொருளாதாரத்தை உயர்த்தும் ஒரே வழியாகும்.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று தவறு; காரணம் சரி", "B": "கூற்று, காரணம் இரண்டும் சரி", "C": "கூற்று, காரணம் இரண்டும் தவறு", "D": "கூற்று சரி; ஆனால் காரணம் தவறு"}, "explanation": "பாடநூல் விளக்கம்: நாட்டின் மொத்த நிலப்பரப்பில் அமைந்துள்ள காடுகளின் அளவைப் பொறுத்தே அந்நாட்டின் மழை, சுற்றுச்சூழல் சமநிலை மற்றும் உண்மையான வளம் மதிப்பிடப்படுகிறது. மரங்களை வெட்டி ஏற்றுமதி செய்வது காட்டின் வளம் ஆகாது. எனவே கூற்று சரி, காரணம் தவறு."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): Ecologists and scholars state that 'The wealth of the forest is the wealth of the nation'.\nReason (R): Exporting timber from logged forests to foreign nations is the sole viable method to uplift national economy.\nSelect the correct option."}], "options": {"A": "Assertion is incorrect; Reason is correct", "B": "Both Assertion and Reason are correct", "C": "Both Assertion and Reason are incorrect", "D": "Assertion is correct; but Reason is incorrect"}, "explanation": "Textbook explanation: Forest coverage ensures rainfall, ecological equilibrium, and overall prosperity. Logging timber for quick cash is not the rationale. Assertion is true; Reason is false."}}, "question_data": {"assertion": "'காட்டின் வளமே நாட்டின் வளம்' என்று சுற்றுச்சூழல் அறிஞர்கள் மற்றும் பொருளியலாளர்கள் கூறுகின்றனர்.", "reason": "காடுகளிலிருந்து கிடைக்கும் மரங்களை வெளிநாடுகளுக்கு ஏற்றுமதி செய்து அதிகப் பணம் ஈட்டுவதே ஒரு நாட்டின் பொருளாதாரத்தை உயர்த்தும் ஒரே வழியாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 24, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "forest_wealth"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-125", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l3-kapparkalai", "chapter_id": null, "topic_id": "kattumaram-thoni-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): பழங்கால மனிதன் மரங்களின் உள்பகுதியைத் தோண்டி எடுத்துவிட்டு நீரில் மிதக்கவிட்ட கலன்களைப் பயன்படுத்தினான்; இவையே 'தோணிகள்' எனப்பட்டன.\nகாரணம் (R): மரத்தின் உள்பகுதியைத் தோண்டிப் பயன்படுத்திய காரணத்தாலேயே அக்கலன்களுக்குத் 'தோணி' என்னும் காரணப்பெயர் அமைந்தது.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றுக்குச் சரியான விளக்கம் ஆகும்", "B": "கூற்று சரி; ஆனால் காரணம் தவறு", "C": "கூற்று தவறு; காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் விளக்கம்: மரங்களின் உள்பகுதியைத் தோண்டி எடுத்துவிட்டுப் பயன்படுத்தியதால் அவை தோணிகள் எனப்பட்டன என்று பாடநூல் தெளிவாகக் குறிப்பிடுகிறது. கூற்றும் காரணமும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): Early humans hollowed out tree trunks to create watercraft that floated upon water; these were called 'Thonigal'.\nReason (R): Because the inner core of the wood was excavated (thondappattadhu), the craft acquired the etymological name 'Thoni'.\nSelect the correct option."}], "options": {"A": "Both Assertion and Reason are correct; Reason correctly explains Assertion", "B": "Assertion is correct; Reason is incorrect", "C": "Assertion is incorrect; Reason is correct", "D": "Both Assertion and Reason are incorrect"}, "explanation": "Textbook explanation: Textbook explicitly validates that excavating (thondudhal) the interior of tree logs gave rise to the term 'Thoni'."}}, "question_data": {"assertion": "பழங்கால மனிதன் மரங்களின் உள்பகுதியைத் தோண்டி எடுத்துவிட்டு நீரில் மிதக்கவிட்ட கலன்களைப் பயன்படுத்தினான்; இவையே 'தோணிகள்' எனப்பட்டன.", "reason": "மரத்தின் உள்பகுதியைத் தோண்டிப் பயன்படுத்திய காரணத்தாலேயே அக்கலன்களுக்குத் 'தோணி' என்னும் காரணப்பெயர் அமைந்தது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 30, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "thoni_etymology"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-126", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l1-kaadu", "chapter_id": null, "topic_id": "kaadu-vocab-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சுரதாவின் 'காடு' பாடலில் இடம்பெற்றுள்ள அருஞ்சொற்களையும் அவற்றின் பொருள்களையும் பொருத்துக:\nபட்டியல் I (சொல்):\nL1. ஈன்று\nL2. கொம்பு\nL3. அதிமதுரம்\nL4. நச்சரவம்\nபட்டியல் II (பொருள்):\nR1. தந்து\nR2. மரக்கிளை\nR3. மிகுந்த இனிமை\nR4. விடமுள்ள பாம்பு"}], "options": {"A": "L1-R2, L2-R1, L3-R4, L4-R3", "B": "L1-R1, L2-R2, L3-R3, L4-R4", "C": "L1-R3, L2-R4, L3-R1, L4-R2", "D": "L1-R4, L2-R3, L3-R2, L4-R1"}, "explanation": "பாடநூல் விளக்கம்: ஈன்று = தந்து; கொம்பு = கிளை; அதிமதுரம் = மிகுந்த இனிமை; நச்சரவம் = விடமுள்ள பாம்பு. சரியான பொருத்தம்: 1 - 2 - 3 - 4."}, "en": {"blocks": [{"type": "text", "content": "Match the vocabulary from Suradha's 'Kaadu' poem with their meanings:\nList I (Word):\nL1. Eendru\nL2. Kombu\nL3. Adhimadhuram\nL4. Nacharavam\nList II (Meaning):\nR1. Having given (Thandhu)\nR2. Tree branch (Marakkilai)\nR3. Extreme sweetness (Migu indimai)\nR4. Venomous serpent (Vidamulla paambu)"}], "options": {"A": "L1-R2, L2-R1, L3-R4, L4-R3", "B": "L1-R1, L2-R2, L3-R3, L4-R4", "C": "L1-R3, L2-R4, L3-R1, L4-R2", "D": "L1-R4, L2-R3, L3-R2, L4-R1"}, "explanation": "Textbook match: Eendru=Thandhu, Kombu=Branch, Adhimadhuram=Intense sweetness, Nacharavam=Venomous snake."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "ஈன்று", "content_en": "Eendru"}, {"id": "L2", "content_ta": "கொம்பு", "content_en": "Kombu"}, {"id": "L3", "content_ta": "அதிமதுரம்", "content_en": "Adhimadhuram"}, {"id": "L4", "content_ta": "நச்சரவம்", "content_en": "Nacharavam"}], "right": [{"id": "R1", 