{"id": "7th-t1-u2-216", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l6-kurukkangal", "chapter_id": null, "topic_id": "maathirai-calc-vaiyam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கண மாத்திரை அளவைக் கணக்கிடுக:\n'வையம்' என்னும் சொல்லின் மொத்த மாத்திரை அளவு எத்தனை?"}], "options": {"A": "2 மாத்திரைகள்", "B": "2.5 மாத்திரைகள்", "C": "3.5 மாத்திரைகள்", "D": "3 மாத்திரைகள்"}, "explanation": "இலக்கணக் கணக்கீடு: வை = சொல்லின் முதலில் வந்த ஐகாரக்குறுக்கம் (1.5 மாத்திரை) + ய = குறில் உயிர்மெய் (1 மாத்திரை) + ம் = மெய்யெழுத்து (0.5 மாத்திரை) = 1.5 + 1 + 0.5 = 3 (மூன்று) மாத்திரைகள்."}, "en": {"blocks": [{"type": "text", "content": "Calculate the total metric duration (Maathirai) for the word 'Vaiyam':"}], "options": {"A": "2 Maathirais", "B": "2.5 Maathirais", "C": "3.5 Maathirais", "D": "3 Maathirais"}, "explanation": "Grammar calculation: Vai(Aigaarakkurukkam=1.5) + ya(1) + m(0.5) = 3 maathirais."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 39, "chapter": null, "section": null, "reference": null, "url": null, "so