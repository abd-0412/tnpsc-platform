{"id": "7th-t1-u2-188", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l4-vilangugal-ulagam", "chapter_id": null, "topic_id": "maathirai-panbulla", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கண மாத்திரை அளவைக் கணக்கிடுக:\n'பண்புள்ள' என்னும் சொல்லின் மொத்த மாத்திரை அளவு எத்தனை?"}], "options": {"A": "3.5 மாத்திரைகள்", "B": "4 மாத்திரைகள்", "C": "3 மாத்திரைகள்", "D": "4.5 மாத்திரைகள்"}, "explanation": "இலக்கணக் கணக்கீடு: ப = குறில் உயிர்மெய் (1 மாத்திரை) + ண் = மெய்யெழுத்து (0.5 மாத்திரை) + பு = குறில் உயிர்மெய் (1 மாத்திரை) + ள் = மெய்யெழுத்து (0.5 மாத்திரை) + ள = குறில் உயிர்மெய் (1 மாத்திரை) + (ஈற்றில் உள்ள அசை மெய் இல்லை) = 1 + 0.5 + 1 + 0.5 + 1 = 4 மாத்திரைகள் (தவறு: 1 + 0.5 + 1 + 0.5 + 1 = 4 மாத்திரை). பண்புள்ள விலங்கு = 4 மாத்திரைகள்."}, "en": {"blocks": [{"type": "text", "content": "Calculate the total metric duration (Maathirai) for the word 'Panbulla':"}], "options": {"A": "3.5 Maathirais", "B": "4 Maathirais", "C": "3 Maathirais", "D": "4.5 Maathirais"}, "explanation": "Grammar calculation: Pa(1) + n(0.5) + bu(1) + l(0.5) + la(1) = 4 maathirais."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "grammar", "maathirai_calc"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u2-189", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l5-indhiya-vanamagan", "chapter_id": null, "topic_id": "sandhi-kaattaru", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிரித்தெழுதுக:\n'காட்டாறு' என்னும் சொல்லைச் சரியாகப் பிரித்தெழுதக் கிடைக்கும் வடிவம் எது?"}], "options": {"A": "காடு + ஆறு", "B": "காட் + ஆறு", "C": "காட்டு + ஆறு", "D": "கா + ஆறு"}, "explanation": "இலக்கண விதி: காடு + ஆறு -> 'நெடிலோ டாய்தக் குறுக்கமும் பிறவற் றொற்றிரட் டாதலும் ஆறும்' அல்லது பெயர் புணர்ச்சியில் 'காடு' நிலைமொழியாக நிற்கும்போது ஒற்று இரட்டித்து 'காட்டு' என்றாகி, ஆறு சேரும்போது ட் + ஆ = 'டா' என இணைந்து 'காட்டாறு' எனப் புணரும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the correct grammatical separation of 'Kaattaaru':"}], "options": {"A": "Kaadu + Aaru", "B": "Kaat + Aaru", "C": "Kaattu + Aaru", "D": "Kaa + Aaru"}, "explanation": "Grammar rule: Splits as Kaadu + Aaru, where the internal consonant doubles and elides ugaram before incoming vowel."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 41, "chapt