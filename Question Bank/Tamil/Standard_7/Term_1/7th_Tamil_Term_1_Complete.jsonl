{"id": "7th-t1-u2-218", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l7-thirukkural", "chapter_id": null, "topic_id": "sandhi-porutchelvam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிரித்தெழுதுக:\n'பொருட்செல்வம்' என்னும் சொல்லைச் சரியாகப் பிரித்தெழுதக் கிடைக்கும் வடிவம் எது?"}], "options": {"A": "பொரு + செல்வம்", "B": "பொருள் + செல்வம்", "C": "பொருட் + செல்வம்", "D": "பொன் + செல்வம்"}, "explanation": "இலக்கண விதி: பொருள் + செல்வம் -> 'லளவேற் றுமையில் றடவும்' என்ற விதியின்படி லகரம் வல்லினம் வர றகரமாகத் திரிந்து 'பொருட்செல்வம்' எனப் புணரும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the correct grammatical separation of 'Porutchelvam':"}], "options": {"A": "Poru + Selvam", "B": "Porul + Selvam (பொருள் + செல்வம்)", "C": "Porut + Selvam", "D": "Pon + Selvam"}, "explanation": "Grammar rule: In 'Porul + Selvam', terminal 'l' mutates into 't' before hard consonant 's', yielding 'Porutchelvam'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 46, "chapter": null, "section": null, "reference": null, "url"