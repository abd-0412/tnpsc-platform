{"id": "7th-t1-u2-165", "schema_version": "1.0", "kind": "quote_completion", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l3-kapparkalai", "chapter_id": null, "topic_id": "purananuru-quote-fill", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கரிகால் வளவனின் நாவாய் வெற்றியைப் போற்றும் புறநானூற்றுப் பாடல் வரியை நிரப்புக:\n'நளியிரு முந்நீர் நாவாய் ஓட்டி\nவளி தொழில் ஆண்ட ______________ மருக!'"}], "options": {"A": "உரவோன்", "B": "வேந்தன்", "C": "செழியன்", "D": "வளவன்"}, "explanation": "பாடநூல் புறநானூற்று வரி: 'நளியிரு முந்நீர் நாவாய் ஓட்டி வளி தொழில் ஆண்ட உரவோன் மருக' என வெண்ணிக்குயத்தியார் பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Complete the following Purananuru verse honoring Karikalan's seafaring mastery:\n'Naliyiru munneer naavaai otti\nvali thozhil aanda ______________ maruga!'"}], "options": {"A": "Uravon (உரவோன்)", "B": "Vendhan", "C": "Sezhiyan", "D": "Valavan"}, "explanation": "Textbook verse: '...vali thozhil aanda uravon maruga' is the exact verse by poetess Vennikkuyatthiyar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 33, "cha