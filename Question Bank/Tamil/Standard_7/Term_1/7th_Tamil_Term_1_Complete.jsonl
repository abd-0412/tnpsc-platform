{"id": "7th-t1-u2-224", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l6-kurukkangal", "chapter_id": null, "topic_id": "magarakkurukkam-mathirai-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் இலக்கணத்தில் மகரக்குறுக்கம் தனக்குரிய அரை மாத்திரை அளவிலிருந்து குறைந்து எத்தனை மாத்திரை அளவாக ஒலிக்கும்?"}], "options": {"A": "1 மாத்திரை", "B": "1.5 மாத்திரை", "C": "அரை (0.5) மாத்திரை", "D": "கால் (0.25) மாத்திரை"}, "explanation": "பாடநூல் குறிப்பு: மகரக்குறுக்கம் தனக்குரிய அரை மாத்திரை அளவிலிருந்து குறைந்து கால் மாத்திரை அளவாக ஒலிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "In Tamil grammar, into how many maathirais does Magarakkurukkam contract from its normal half maathirai?"}], "options": {"A": "1 Maathirai", "B": "1.5 Maathirais", "C": "0.5 Maathirai", "D": "0.25 (கால்) மாத்திரை"}, "explanation": "Textbook fact: Magarakkurukkam articulates for exactly 0.25 (quarter) maathirai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 40, "chapter": null, "section": null, "reference": null, "url": null, "sourc