{"id": "7th-t1-u2-140", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l3-kapparkalai", "chapter_id": null, "topic_id": "first-watercraft", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழங்காலத் தமிழர்கள் மரங்களில் உள்ள இயற்கைச் சுழியை எவ்வாறு குறிப்பிட்டனர்?"}], "options": {"A": "வெட்டுவாய்", "B": "தொகுதி", "C": "தச்சுமுழம்", "D": "கண்ணடை"}, "explanation": "பாடநூல் குறிப்பு: மரத்தில் அமைந்த இயற்கைச் சுழியை 'கண்ணடை' என்று அழைத்தனர். சுழி உள்ள மரங்களைப் பயன்படுத்தாமல் தவிர்த்தனர்."}, "en": {"blocks": [{"type": "text", "content": "How did ancient Tamil shipwrights designate natural whorls or knots occurring in timber?"}], "options": {"A": "Vettuvai", "B": "Thogudhi", "C": "Thacchumuzham", "D": "Kannadai (கண்ணடை)"}, "explanation": "Textbook fact: Knots or whorls in timber were technically referred to as 'Kannadai'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 31, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": 