{"id": "7th-t1-u2-134", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u1-amudhat-tamil", "lesson_id": "ta-l3-kapparkalai", "chapter_id": null, "topic_id": "maathirai-navaai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கண மாத்திரை அளவைக் கணக்கிடுக:\n'நாவாய்' என்னும் சொல்லின் மொத்த மாத்திரை அளவு எத்தனை?"}], "options": {"A": "3 மாத்திரைகள்", "B": "4.5 மாத்திரைகள்", "C": "4 மாத்திரைகள்", "D": "2.5 மாத்திரைகள்"}, "explanation": "இலக்கணக் கணக்கீடு: நா = நெடில் உயிர்மெய் (2 மாத்திரை) + வா = நெடில் உயிர்மெய் (2 மாத்திரை) + ய் = மெய்யெழுத்து (0.5 மாத்திரை) = 2 + 2 + 0.5 = 4.5 (நான்கரை) மாத்திரைகள்."}, "en": {"blocks": [{"type": "text", "content": "Calculate the total metric duration (Maathirai) for the word 'Naavaai':"}], "options": {"A": "3 Maathirais", "B": "4.5 Maathirais", "C": "4 Maathirais", "D": "2.5 Maathirais"}, "explanation": "Grammar calculation: Naa(2) + Vaa(2) + y(0.5) = 4.5 maathirais."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 31, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"i