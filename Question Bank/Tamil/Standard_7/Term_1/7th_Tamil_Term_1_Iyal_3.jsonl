{"id": "7th-t1-u3-303", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l3-kappalottiya-tamizhan", "chapter_id": null, "topic_id": "ilakkana-kurippu-kappalottiya", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கணக் குறிப்புத் தருக:\n'கப்பலோட்டிய தமிழர்' - இதில் 'கப்பலோட்டிய' என்பதன் சரியான இலக்கணக் குறிப்பு யாது?"}], "options": {"A": "வினையெச்சம்", "B": "தொழிற்பெயர்", "C": "பெயரெச்சம்", "D": "வினையாலணையும் பெயர்"}, "explanation": "இலக்கண விதி: 'கப்பலோட்டிய' என்னும் அகர ஈற்று எச்ச வினைச்சொல் 'தமிழர்' என்னும் பெயர்ச்சொல்லைக் கொண்டு முடிவதால் இது 'பெயரெச்சம்' (இறந்தகாலப் பெயரெச்சம்) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the grammatical category (Ilakkana Kurippu) of 'Kappalottiya' in 'Kappalottiya Tamizhan':"}], "options": {"A": "Vinaiyecham", "B": "Thozhirpeyar", "C": "Peyarecham (Relative participle)", "D": "Vinaiyaalanaiyum Peyar"}, "explanation": "Grammar rule: An incomplete verbal form ending in 'a' modifying the following noun 'Tamizhan' is a Peyarecham."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition"