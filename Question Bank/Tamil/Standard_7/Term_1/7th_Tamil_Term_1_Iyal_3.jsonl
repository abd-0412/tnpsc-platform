{"id": "7th-t1-u3-356", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l4-thodar-ilakkanam", "chapter_id": null, "topic_id": "ezhuvai-app-id", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"கொற்கைத் துறைமுகத்திலே பாண்டியனுடைய மீன்கொடி பறந்தது\" - இத்தொடரில் அமைந்துள்ள 'எழுவாய்' எது?"}], "options": {"A": "கொற்கைத் துறைமுகத்திலே", "B": "பாண்டியனுடைய", "C": "பறந்தது", "D": "மீன்கொடி"}, "explanation": "பாடநூல் குறிப்பு: 'பறந்தது எது?' என்னும் வினாவிற்கு விடையாக அமைவது 'மீன்கொடி' ஆகும். எனவே இத்தொடரின் எழுவாய் 'மீன்கொடி' ஆகும். 'பறந்தது' பயனிலை."}, "en": {"blocks": [{"type": "text", "content": "\"In Korkai harbour, the fish flag of Pandya fluttered\" - Which is the Subject (Ezhuvai) in this sentence?"}], "options": {"A": "In Korkai harbour", "B": "Pandya's", "C": "fluttered", "D": "Fish flag (Meenkodi)"}, "explanation": "Textbook fact: The constituent answering 'What fluttered?' is 'Meenkodi' (fish flag). Hence 'Meenkodi' is the Subject."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 64, "chapter": null, "section": 