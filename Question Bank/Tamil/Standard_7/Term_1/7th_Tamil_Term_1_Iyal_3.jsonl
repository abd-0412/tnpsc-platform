// பாடம் 2: பசும்பொன் உ. முத்துராமலிங்கத்தேவர் - அரசியல், சமூகப் புரட்சிகள் & தேர்தல் வரலாறு [Q253 - Q280]
// நேதாஜி சுபாஷ் சந்திரபோஸ் நட்பு (1939 செப் 6 மதுரை வருகை), பார்வர்டு பிளாக் தமிழக தலைமை, 'நேதாஜி' வார இதழ், வாய்ப்பூட்டுச் சட்டம் (வடக்கில் திலகர், தெற்கில் தேவர்), குற்றப்பரம்பரைச் சட்டம் நீக்கம் (1934 கமுதி மாநாடு, 1948 நீக்கம்), 1939 ஜூலை 8 மீனாட்சியம்மன் கோயில் ஆலயப் பிரவேசம், ஜமீன் விவசாயிகள் சங்கம், தேர்தல் வெற்றிகள் (1937, 1946, 1952, 1957, 1962), 1995 தபால் தலை
// ==============================================================================
{"id": "7th-t1-u3-253", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "thevar-netaji-alliance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்துராமலிங்கத்தேவர் மற்றும் நேதாஜி சுபாஷ் சந்திரபோஸ் இடையேயான வரலாற்றுத் தொடர்பு பற்றிய கூற்றுகளை ஆராய்க:\n1. முத்துராமலிங்கத்தேவர் நேதாஜி சுபாஷ் சந்திரபோஸைத் தமது அரசியல் தலைவராக ஏற்றுக்கொண்டார்.\n2. தேவரின் அழைப்பை ஏற்று நேதாஜி 1939-ஆம் ஆண்டு செப்டம்பர் 6-ஆம் நாள் மதுரைக்கு வருகை தந்தார்.\n3. நேதாஜி தொடங்கிய பார்வர்டு பிளாக் (Forward Bloc) கட்சியின் தமிழ்நாடு தலைவராகத் தேவர் பொறுப்பேற்றார்.\n4. 'நேதாஜி' என்னும் பெயரில் வார இதழை நடத்தி, இந்திய தேசிய ராணுவத்திற்குத் தமிழர்களைப் பெருமளவில் சேர்த்தார்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2 மட்டுமே சரி; 3, 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 மட்டுமே சரி; 1 தவறு", "D": "கூற்றுகள் 1, 3 மட்டுமே சரி; 2, 4 தவறு"}, "explanation": "பாடநூல் குறிப்பு: நேதாஜியைத் தலைவராக ஏற்றமை; 1939 செப் 6 மதுரை வருகை; பார்வர்டு பிளாக் தமிழக தலைமை; 'நேதாஜி' வார இதழ் மற்றும் ஐ.என்.ஏ படைக்கு ஆள்திரட்டு ஆகிய இந்நான்கு வரலாற்று நிகழ்வுகளும் பாடநூலின்படி முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the historical partnership between Muthuramalingathevar and Netaji Subhas Chandra Bose:\n1. Muthuramalingathevar revered and adopted Netaji Subhas Chandra Bose as his political leader.\n2. Accepting Thevar's invitation, Netaji arrived in Madurai on September 6, 1939.\n3. Thevar assumed leadership as the Tamil Nadu state president of the Forward Bloc founded by Netaji.\n4. He edited a weekly journal named 'Netaji' and recruited large numbers of Tamils into the Indian National Army (INA).\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Only statements 1 and 2 are correct", "C": "Only statements 2, 3, and 4 are correct", "D": "Only statements 1 and 3 are correct"}, "explanation": "Textbook fact: All four historical milestones regarding Thevar's alliance with Netaji, Madurai visit date (Sept 6, 1939), Forward Bloc leadership, and INA recruitment are accurate."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "முத்துராமலிங்கத்தேவர் நேதாஜி சுபாஷ் சந்திரபோஸைத் தமது அரசியல் தலைவராக ஏற்றுக்கொண்டார்.", "content_en": "Thevar adopted Netaji as his political leader."}, {"id": "S2", "content_ta": "தேவரின் அழைப்பை ஏற்று நேதாஜி 1939 செப்டம்பர் 6-ல் மதுரைக்கு வருகை தந்தார்.", "content_en": "Netaji visited Madurai on September 6, 1939."}, {"id": "S3", "content_ta": "பார்வர்டு பிளாக் கட்சியின் தமிழ்நாடு தலைவராகத் தேவர் பொறுப்பேற்றார்.", "content_en": "Thevar became Tamil Nadu president of Forward Bloc."}, {"id": "S4", "content_ta": "'நேதாஜி' வார இதழை நடத்தி, இந்திய தேசிய ராணுவத்திற்குத் தமிழர்களைச் சேர்த்தார்.", "content_en": "Ran 'Netaji' weekly and mobilized Tamils into INA."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 53, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "thevar_netaji"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-254", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "criminal-tribes-act-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குற்றப்பரம்பரைச் சட்டம் மற்றும் தேவரின் எதிர்ப்புப் போராட்டம் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. ஆங்கிலேய ஆட்சியில் மக்களை ஒடுக்குவதற்காகக் கொண்டுவரப்பட்ட சட்டம் 'குற்றப்பரம்பரைச் சட்டம்' (Criminal Tribes Act) ஆகும்.\n2. இச்சட்டத்தின்படி குறிப்பிட்ட சமூகத்தில் பிறந்த காரணத்தினாலேயே மக்கள் குற்றவாளிகளாகக் கருதப்பட்டு இரவு நேரங்களில் காவல் நிலையத்தில் ஆஜராக வேண்டும் எனக் கட்டாயப்படுத்தப்பட்டனர்.\n3. இச்சட்டத்தை எதிர்த்து 1934 மே 12, 13 தேதிகளில் கமுதியில் தேவர் தலைமையில் மாபெரும் மாநாடு நடத்தப்பட்டது.\n4. தேவரின் தீவிரப் போராட்டத்தின் விளைவாக ஆங்கிலேய அரசு 1935-லேயே இச்சட்டத்தை உடனடியாக ரத்து செய்தது.\nஇவற்றுள் சரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "B": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "D": "கூற்றுகள் அனைத்தும் சரி"}, "explanation": "பாடநூல் விளக்கம்: குற்றப்பரம்பரைச் சட்டம் தேவரின் தொடர் போராட்டத்தால் சுதந்திரத்திற்குப் பிறகு 1948-ஆம் ஆண்டில்தான் நீக்கப்பட்டது; 1935-ல் ரத்து செய்யப்படவில்லை. எனவே கூற்று 4 தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements on the Criminal Tribes Act and Thevar's campaign:\n1. The colonial British enacted the draconian Criminal Tribes Act to suppress native communities.\n2. Under this act, individuals born in certain communities were branded criminals and forced to register nightly at police stations.\n3. Against this injustice, Thevar convened a massive protest conference at Kamudhi on May 12 and 13, 1934.\n4. Due to Thevar's campaign, the British colonial government immediately revoked this law in 1935.\nSelect the correct option."}], "options": {"A": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "B": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect", "C": "Statements 2, 3, and 4 are correct; 1 is incorrect", "D": "All statements are correct"}, "explanation": "Textbook explanation: The Criminal Tribes Act was finally repealed in 1948 after independence; claiming it was repealed in 1935 is historically false. Statement 4 is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "மக்களை ஒடுக்குவதற்காக ஆங்கிலேயர் கொண்டுவந்த சட்டம் 'குற்றப்பரம்பரைச் சட்டம்'.", "content_en": "British enacted Criminal Tribes Act to suppress communities."}, {"id": "S2", "content_ta": "பிறப்பாலேயே குற்றவாளிகளாகக் கருதப்பட்டு இரவில் காவல் நிலையத்தில் ஆஜராகக் கட்டாயப்படுத்தப்பட்டனர்.", "content_en": "Branded criminals by birth and mandated nightly police reporting."}, {"id": "S3", "content_ta": "இச்சட்டத்தை எதிர்த்து 1934 மே 12, 13 தேதிகளில் கமுதியில் மாநாடு நடத்தப்பட்டது.", "content_en": "Conducted massive protest conference at Kamudhi on May 12-13, 1934."}, {"id": "S4", "content_ta": "ஆங்கிலேய அரசு 1935-லேயே இச்சட்டத்தை உடனடியாக ரத்து செய்தது.", "content_en": "British government immediately revoked the act in 1935."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 54, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "criminal_tribes_act"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-255", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "temple-entry-madurai-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மதுரை மீனாட்சியம்மன் கோயில் ஆலயப் பிரவேசத்தில் தேவரின் பங்கு பற்றிய கூற்றுகளை ஆராய்க:\n1. அந்நாளில் மதுரை மீனாட்சியம்மன் கோயிலுக்குள் ஒடுக்கப்பட்ட மக்கள் செல்வதற்குத் தடை இருந்தது.\n2. 1939-ஆம் ஆண்டு ஜூலைத் திங்கள் எட்டாம் நாளில் (1939 ஜூலை 8) க. வைத்தியநாத ஐயர் தலைமையில் ஆலயப் பிரவேசம் செய்யத் திட்டமிடப்பட்டது.\n3. ஆலயப் பிரவேசத்திற்கு எதிர்ப்புத் தெரிவித்த ஆசாரவாதிகளின் அச்சுறுத்தலை முறியடிக்க, தடையை மீறித் தொண்டர்களுக்குத் தேவர் முழுப் பாதுகாப்பளித்து ஆலயப் பிரவேசத்தை வெற்றிகரமாக நடத்த உதவினார்.\n4. தேவர் இப்போராட்டத்திற்கு எதிர்ப்பு தெரிவித்து மாற்றுப் பேரணியை ஏற்பாடு செய்தார்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "B": "கூற்றுகள் அனைத்தும் சரி", "C": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "பாடநூல் விளக்கம்: தேவர் ஒடுக்கப்பட்ட மக்களின் சமத்துவத்திற்காக நின்று, வைத்தியநாத ஐயரின் ஆலயப் பிரவேசத்திற்கு முழுப் பாதுகாப்பு வழங்கி வெற்றிகரமாக நடத்தினார்; எதிர்ப்பு தெரிவித்தார் என்பது தவறான கூற்றாகும். எனவே கூற்று 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the role of Muthuramalingathevar in the historic Madurai Meenakshi Temple entry:\n1. In those days, oppressed marginalized communities were unjustly barred from entering the Madurai Meenakshi Temple.\n2. On July 8, 1939, a temple entry was spearheaded under the leadership of A. Vaidyanatha Iyer.\n3. To thwart threats by conservative reactionaries, Thevar provided ironclad protection ensuring the temple entry succeeded peacefully.\n4. Thevar opposed this temple entry agitation and organized a counter-rally against Vaidyanatha Iyer.\nWhich statements are correct?"}], "options": {"A": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "B": "All statements are correct", "C": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect", "D": "Statements 2, 3, and 4 are correct; 1 is incorrect"}, "explanation": "Textbook explanation: Thevar stood firmly for social justice and provided total security to Vaidyanatha Iyer's temple entry contingent. Statement 4 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "மதுரை மீனாட்சியம்மன் கோயிலுக்குள் ஒடுக்கப்பட்ட மக்கள் செல்லத் தடை இருந்தது.", "content_en": "Temple entry was barred to oppressed communities."}, {"id": "S2", "content_ta": "1939 ஜூலை 8-ல் வைத்தியநாத ஐயர் தலைமையில் ஆலயப் பிரவேசம் திட்டமிடப்பட்டது.", "content_en": "Entry planned on July 8, 1939, under Vaidyanatha Iyer."}, {"id": "S3", "content_ta": "எதிர்ப்புகளை முறியடிக்கத் தொண்டர்களுக்குத் தேவர் முழுப் பாதுகாப்பு அளித்தார்.", "content_en": "Thevar provided protective escort neutralizing orthodox threats."}, {"id": "S4", "content_ta": "தேவர் இப்போராட்டத்திற்கு எதிர்ப்பு தெரிவித்து மாற்றுப் பேரணி நடத்தினார்.", "content_en": "Thevar opposed this entry and organized counter rallies."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 54, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "temple_entry_movement"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-256", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "agrarian-labour-welfare-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "விவசாயிகள் மற்றும் தொழிலாளர் நலனுக்காக முத்துராமலிங்கத்தேவர் ஆற்றிய பணிகளை ஆராய்க:\n1. 'ஜமீன் விவசாயிகள் சங்கம்' என்னும் அமைப்பை ஏற்படுத்தி விவசாயிகளின் துயர் துடைக்கப் பாடுபட்டார்.\n2. உழுபவர்க்கே நிலம் சொந்தமாக வேண்டும் என்ற நோக்கில், தமக்குச் சொந்தமாக 32 கிராமங்களில் இருந்த விளைநிலங்களை நிலமற்ற விவசாயிகளுக்குப் பகிர்ந்தளித்தார்.\n3. 1938-ஆம் ஆண்டு மதுரையில் 23 தொழிலாளர் சங்கங்களின் தலைவராகத் தேர்ந்தெடுக்கப்பட்டு நூற்பாலைத் தொழிலாளர்களின் உரிமைக்காகப் போராடினார்.\n4. தேவர் நிலவுடைமை ஜமீன்தார்களின் அமைப்பிற்குத் தலைவராக இருந்து விவசாயிகளிடம் அதிக வரி வசூலித்தார்.\nஇவற்றுள் சரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் அனைத்தும் சரி", "B": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "C": "கூற்றுகள் 2, 3, 4 சரி; கூற்று 1 தவறு", "D": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு"}, "explanation": "பாடநூல் விளக்கம்: ஜமீன்தார்களின் கொடுமையை எதிர்த்துத் தமது சொந்த 32 கிராம நிலங்களை விவசாயிகளுக்கே பகிர்ந்தளித்த வள்ளல் தேவர் ஆவார்; விவசாயிகளிடம் வரி வசூலித்தார் என்பது தவறான கூற்றாகும். எனவே கூற்றுகள் 1, 2, 3 சரி; 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze Muthuramalingathevar's contributions toward agrarian and industrial labor welfare:\n1. He established the 'Zamin Ryots Association' to alleviate the distress of impoverished tenant farmers.\n2. Believing that land belongs to the tiller, he redistributed his ancestral arable lands across 32 villages to landless peasants.\n3. In 1938, as president of 23 labor unions in Madurai, he led textile mill workers in agitations for labor rights.\n4. Thevar served as president of aristocratic zamindars and extorted exorbitant land taxes from peasants.\nSelect the correct option."}], "options": {"A": "All statements are correct", "B": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "C": "Statements 2, 3, and 4 are correct; 1 is incorrect", "D": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect"}, "explanation": "Textbook explanation: Thevar redistributed his own fertile lands in 32 villages to landless tillers; claiming he extorted taxes is slanderous and false. Statement 4 is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'ஜமீன் விவசாயிகள் சங்கம்' என்னும் அமைப்பை ஏற்படுத்தி விவசாயிகளுக்காகப் பாடுபட்டார்.", "content_en": "Founded Zamin Ryots Association for peasant rights."}, {"id": "S2", "content_ta": "32 கிராமங்களில் இருந்த தமது விளைநிலங்களை விவசாயிகளுக்குப் பகிர்ந்தளித்தார்.", "content_en": "Donated his arable lands across 32 villages to landless farmers."}, {"id": "S3", "content_ta": "1938-ல் 23 தொழிலாளர் சங்கங்களின் தலைவராக இருந்து தொழிலாளர்களுக்காகப் போராடினார்.", "content_en": "Led 23 labor unions in 1938 Madurai textile mill struggles."}, {"id": "S4", "content_ta": "தேவர் ஜமீன்தார்களின் தலைவராக இருந்து விவசாயிகளிடம் அதிக வரி வசூலித்தார்.", "content_en": "Thevar extorted heavy land taxes from peasants."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 54, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "agrarian_labour_welfare"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-257", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "thevar-electoral-triumphs", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்துராமலிங்கத்தேவரின் தேர்தல் வெற்றிகள் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. 1937-ஆம் ஆண்டு நடைபெற்ற சட்டமன்றத் தேர்தலில் இராமநாதபுரம் மன்னர் சண்முக ராஜேஸ்வர சேதுபதியை எதிர்த்துப் போட்டியிட்டு மகத்தான வெற்றி பெற்றார்.\n2. 1946-ஆம் ஆண்டு நடைபெற்ற சட்டமன்றத் தேர்தலில் போட்டியின்றி ஒருமனதாகத் தேர்ந்தெடுக்கப்பட்டார்.\n3. 1952 மற்றும் 1957 ஆகிய இரு தேர்தல்களிலும் சட்டமன்ற மற்றும் நாடாளுமன்றத் தேர்தல்களில் போட்டியிட்டு ஒரே நேரத்தில் இரண்டிலும் வெற்றி பெற்றார்.\n4. 1962-ஆம் ஆண்டு உடல்நலக்குறைவால் பிரச்சாரத்திற்குச் செல்ல இயலாத சூழலிலும் கூட நாடாளுமன்றத் தேர்தலில் பெருவாரியான வாக்குகள் பெற்று வெற்றி பெற்றார்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2 மட்டுமே சரி; 3, 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 மட்டுமே சரி; 1 தவறு", "D": "கூற்றுகள் 1, 3 மட்டுமே சரி; 2, 4 தவறு"}, "explanation": "பாடநூல் குறிப்பு: 1937-ல் மன்னரை வென்றது; 1946-ல் போட்டியின்றி தேர்வு; 1952, 1957 இரண்டிலும் ஒரே நேரத்தில் வெற்றி; 1962-ல் பிரச்சாரத்திற்குச் செல்லாமலேயே நாடாளுமன்ற வெற்றி ஆகிய நான்கு தேர்தல் சாதனைகளும் பாடநூலின்படி முழுமையாகச் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding the electoral triumphs of Muthuramalingathevar:\n1. In the 1937 provincial elections, he contested against the King of Ramanathapuram, Shanmugha Rajeshwara Sethupathi, and won a stunning victory.\n2. In the 1946 legislative assembly elections, he was returned unopposed without contest.\n3. In the 1952 and 1957 general elections, he contested both assembly and parliamentary seats and triumphed in both simultaneously.\n4. In 1962, despite severe illness preventing him from campaigning, he was elected to Parliament with a decisive majority.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Only statements 1 and 2 are correct", "C": "Only statements 2, 3, and 4 are correct", "D": "Only statements 1 and 3 are correct"}, "explanation": "Textbook fact: All four electoral milestones (1937, 1946 unopposed, 1952/1957 dual victories, 1962 bedridden victory) are historically authentic and validated in the textbook."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "1937-ல் இராமநாதபுரம் மன்னரை எதிர்த்துப் போட்டியிட்டு வெற்றி பெற்றார்.", "content_en": "Defeated Ramanathapuram King in 1937 elections."}, {"id": "S2", "content_ta": "1946 சட்டமன்றத் தேர்தலில் போட்டியின்றி ஒருமனதாகத் தேர்ந்தெடுக்கப்பட்டார்.", "content_en": "Elected unopposed in 1946 assembly elections."}, {"id": "S3", "content_ta": "1952 மற்றும் 1957-ல் சட்டமன்றம், நாடாளுமன்றம் இரண்டிலும் ஒரே நேரத்தில் வெற்றி பெற்றார்.", "content_en": "Triumphed in both Assembly and Parliament in 1952 and 1957."}, {"id": "S4", "content_ta": "1962-ல் பிரச்சாரத்திற்கே செல்லாமல் நாடாளுமன்றத் தேர்தலில் வெற்றி பெற்றார்.", "content_en": "Won 1962 Parliamentary election without campaigning due to illness."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 55, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "thevar_electoral_victories"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-258", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "thevar-spiritual-national-philosophy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்துராமலிங்கத்தேவரின் சிந்தனை மற்றும் வாழ்வியல் கோட்பாடுகள் பற்றிய கூற்றுகளை ஆராய்க:\n1. தேவர் 'தேசியம் உடலாகவும், தெய்வீகம் உயிராகவும்' கொண்டு பொதுப்பணி ஆற்றினார்.\n2. சாதி, மத எல்லைகளைக் கடந்து மனிதநேயத்தையே முதன்மையான அறமாகப் போற்றினார்.\n3. விவேகானந்தரின் வீரத்தையும், இராமகிருஷ்ணரின் ஆன்மிகத்தையும், நேதாஜியின் புரட்சிப் பாதையையும் இணைத்துப் பயணித்தார்.\n4. தேவர் தமது சொத்துக்கள் அனைத்தையும் விற்று அயல்நாட்டு வங்கிகளில் பாதுகாப்பாகச் சேமித்து வைத்தார்.\nஇவற்றுள் சரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "B": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "D": "கூற்றுகள் அனைத்தும் சரி"}, "explanation": "பாடநூல் விளக்கம்: தேவர் தமது சொத்துக்களை ஏழை எளிய விவசாயிகளுக்கும் பொதுமக்களுக்கும் தானமாக வழங்கிய சுத்தத் தியாகி ஆவார்; அயல்நாட்டு வங்கிகளில் சேர்த்தார் என்பது தவறான கூற்றாகும். எனவே கூற்று 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the philosophical and spiritual principles of Muthuramalingathevar:\n1. Thevar served society considering 'Nationalism as his body and Divinity as his soul'.\n2. Transcending boundaries of caste and creed, he upheld universal humanism as the foremost virtue.\n3. He harmonized Swami Vivekananda's valor, Ramakrishna Paramahamsa's spirituality, and Netaji's revolutionary courage.\n4. Thevar liquidated his entire property holdings and deposited the wealth securely into foreign bank accounts.\nSelect the correct option."}], "options": {"A": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "B": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect", "C": "Statements 2, 3, and 4 are correct; 1 is incorrect", "D": "All statements are correct"}, "explanation": "Textbook explanation: Thevar surrendered his vast properties to poor peasants; claiming he banked wealth abroad is false. Statement 4 is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'தேசியம் உடலாகவும், தெய்வீகம் உயிராகவும்' கொண்டு பொதுப்பணி ஆற்றினார்.", "content_en": "Served treating Nationalism as body and Divinity as life."}, {"id": "S2", "content_ta": "சாதி, மத எல்லைகளைக் கடந்து மனிதநேயத்தையே முதன்மையான அறமாகப் போற்றினார்.", "content_en": "Transcended caste and creed, upholding humanism."}, {"id": "S3", "content_ta": "விவேகானந்தர், இராமகிருஷ்ணர், நேதாஜி ஆகியோரின் கொள்கைகளை இணைத்துப் பயணித்தார்.", "content_en": "Synthesized Vivekananda, Ramakrishna, and Netaji's ideals."}, {"id": "S4", "content_ta": "தேவர் தமது சொத்துக்களை விற்று அயல்நாட்டு வங்கிகளில் சேமித்து வைத்தார்.", "content_en": "Thevar deposited his wealth into overseas bank accounts."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 53, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "thevar_philosophy"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-259", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "thevar-postal-stamp-memorial", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்துராமலிங்கத்தேவருக்கு இந்திய அரசு மற்றும் தமிழக அரசு செய்த சிறப்புகள் பற்றிய கூற்றுகளை ஆராய்க:\n1. இந்திய அரசு 1995-ஆம் ஆண்டு முத்துராமலிங்கத்தேவரின் தியாகத்தைப் போற்றி அஞ்சல் தலை வெளியிட்டது.\n2. தமிழ்நாடு அரசு இவர் நினைவாகப் பசும்பொன்னில் நினைவு மண்டபம் அமைத்துள்ளது.\n3. இவர் பிறந்த நாளும் மறைந்த நாளுமான அக்டோபர் 30-ஆம் நாளைத் தமிழக அரசு ஆண்டுதோறும் அரசு விழாவாகக் கொண்டாடி வருகிறது.\n4. முத்துராமலிங்கத்தேவருக்கு இந்திய அரசு பாரத ரத்னா விருதை வழங்கிச் சிறப்பித்தது.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "B": "கூற்றுகள் அனைத்தும் சரி", "C": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "பாடநூல் விளக்கம்: 1995 தபால் தலை, பசும்பொன் நினைவு மண்டபம், அக்டோபர் 30 அரசு விழா ஆகிய சிறப்புகள் செய்யப்பட்டுள்ளன; பாரத ரத்னா வழங்கப்பட்டது என்பது தவறான கூற்றாகும். எனவே கூற்று 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the honors conferred upon Muthuramalingathevar by the Central and Tamil Nadu Governments:\n1. In 1995, the Government of India released a commemorative postal stamp honoring his patriotism.\n2. The Government of Tamil Nadu erected a memorial hall (Ninaivu Mandabam) at Pasumpon.\n3. October 30, coinciding with both his birth and death day, is celebrated officially as a State Function by Tamil Nadu Government.\n4. The Government of India posthumously conferred the Bharat Ratna upon Muthuramalingathevar.\nWhich statements are correct?"}], "options": {"A": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "B": "All statements are correct", "C": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect", "D": "Statements 2, 3, and 4 are correct; 1 is incorrect"}, "explanation": "Textbook explanation: 1995 postal stamp, memorial hall, and Oct 30 state celebration are authentic. Bharat Ratna was not conferred. Statement 4 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "இந்திய அரசு 1995-ல் அஞ்சல் தலை வெளியிட்டது.", "content_en": "Govt of India released postal stamp in 1995."}, {"id": "S2", "content_ta": "தமிழ்நாடு அரசு பசும்பொன்னில் நினைவு மண்டபம் அமைத்துள்ளது.", "content_en": "Tamil Nadu Govt built a memorial at Pasumpon."}, {"id": "S3", "content_ta": "அக்டோபர் 30-ஆம் நாளைத் தமிழக அரசு ஆண்டுதோறும் அரசு விழாவாகக் கொண்டாடுகிறது.", "content_en": "Oct 30 is celebrated annually as an official state function."}, {"id": "S4", "content_ta": "முத்துராமலிங்கத்தேவருக்கு பாரத ரத்னா விருது வழங்கப்பட்டது.", "content_en": "Thevar was conferred the Bharat Ratna."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 55, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "thevar_memorials_honors"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-260", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "netaji-thevar-ina-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): இந்திய தேசிய ராணுவத்தில் (INA) பெருமளவிலான தமிழ்நாட்டு இளைஞர்கள் தங்களை இணைத்துக் கொண்டு தாயக விடுதலைக்குப் போராடினர்.\nகாரணம் (R): நேதாஜி சுபாஷ் சந்திரபோஸ் தமிழகத்தில் மட்டுமே இயங்கி வந்த தேசியத் தலைவராக இருந்தார்.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று மற்றும் காரணம் இரண்டும் சரி; சரியான விளக்கம்", "B": "கூற்று தவறு; காரணம் சரி", "C": "கூற்று, காரணம் இரண்டும் தவறு", "D": "கூற்று சரி; ஆனால் காரணம் தவறு"}, "explanation": "பாடநூல் விளக்கம்: பசும்பொன் தேவரின் தீவிர பிரச்சாரத்தாலும் 'நேதாஜி' வார இதழின் எழுச்சியாலும் தமிழர்கள் INA-வில் இணைந்தனர் என்பது உண்மை (கூற்று சரி). ஆனால் நேதாஜி தமிழகத்தில் மட்டுமே இயங்கிய தலைவர் எனக் கூறுவது முற்றிலும் தவறான காரணம் ஆகும். எனவே கூற்று சரி, காரணம் தவறு."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): Large numbers of Tamil youth joined the Indian National Army (INA) and fought bravely for the motherland's liberation.\nReason (R): Netaji Subhas Chandra Bose functioned strictly and exclusively as a regional political leader based solely in Tamil Nadu.\nSelect the correct option."}], "options": {"A": "Both Assertion and Reason are correct; correct explanation", "B": "Assertion is incorrect; Reason is correct", "C": "Both Assertion and Reason are incorrect", "D": "Assertion is correct; but Reason is incorrect"}, "explanation": "Textbook explanation: Tamils flocked to the INA due to Thevar's fiery persuasion and Netaji's heroic call. Netaji was an all-India supreme leader, not a regional Tamil leader. Assertion is true; Reason is false."}}, "question_data": {"assertion": "இந்திய தேசிய ராணுவத்தில் (INA) பெருமளவிலான தமிழ்நாட்டு இளைஞர்கள் தங்களை இணைத்துக் கொண்டு தாயக விடுதலைக்குப் போராடினர்.", "reason": "நேதாஜி சுபாஷ் சந்திரபோஸ் தமிழகத்தில் மட்டுமே இயங்கி வந்த தேசியத் தலைவராக இருந்தார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 53, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "thevar_ina_recruitment"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-261", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "thevar-land-donation-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): பசும்பொன் முத்துராமலிங்கத்தேவர் தமக்குச் சொந்தமாக இருந்த 32 கிராமங்களின் விளைநிலங்களைத் தமக்கென வைத்துக்கொள்ளாமல் உழைக்கும் ஏழை விவசாயிகளுக்குப் பகிர்ந்தளித்தார்.\nகாரணம் (R): நிலவுடைமை ஜமீன்தாரி சுரண்டல்களிலிருந்து விவசாயிகளை விடுவித்து, 'உழுபவனுக்கே நிலம் சொந்தம்' என்ற உன்னத பொதுவுடைமை அறநெறியை நடைமுறையில் செயல்படுத்த அவர் விரும்பினார்.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றுக்குச் சரியான விளக்கம் ஆகும்", "B": "கூற்று மற்றும் காரணம் இரண்டும் சரி; ஆனால் காரணம் கூற்றுக்குச் சரியான விளக்கமல்ல", "C": "கூற்று சரி; ஆனால் காரணம் தவறு", "D": "கூற்று தவறு; ஆனால் காரணம் சரி"}, "explanation": "பாடநூல் விளக்கம்: ஜமீன் விவசாயிகள் சங்கம் அமைத்து விவசாயிகளுக்காகப் போராடிய தேவர், தமக்குச் சொந்தமான 32 கிராம நிலங்களை ஏழை விவசாயிகளுக்குப் பகிர்ந்தளித்த வரலாற்று உண்மையும், உழுபவனுக்கே நிலம் என்ற நோக்கமும் பாடநூலின்படி முழுமையாகச் சரியானது; தகுந்த விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): Pasumpon Muthuramalingathevar distributed his ancestral arable lands across 32 villages to impoverished peasant tillers.\nReason (R): He sought to liberate peasantry from feudal zamindari exploitation, practically implementing the egalitarian ideal of 'land to the tiller'.\nSelect the correct option."}], "options": {"A": "Both Assertion and Reason are correct; Reason correctly explains Assertion", "B": "Both Assertion and Reason are correct; but Reason does not explain Assertion", "C": "Assertion is correct; Reason is incorrect", "D": "Assertion is incorrect; Reason is correct"}, "explanation": "Textbook explanation: Both the redistribution of land across 32 villages and the agrarian welfare objective are authentic and mutually coherent."}}, "question_data": {"assertion": "பசும்பொன் முத்துராமலிங்கத்தேவர் தமக்குச் சொந்தமாக இருந்த 32 கிராமங்களின் விளைநிலங்களைத் தமக்கென வைத்துக்கொள்ளாமல் உழைக்கும் ஏழை விவசாயிகளுக்குப் பகிர்ந்தளித்தார்.", "reason": "நிலவுடைமை ஜமீன்தாரி சுரண்டல்களிலிருந்து விவசாயிகளை விடுவித்து, 'உழுபவனுக்கே நிலம் சொந்தம்' என்ற உன்னத பொதுவுடைமை அறநெறியை நடைமுறையில் செயல்படுத்த அவர் விரும்பினார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 54, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "thevar_land_redistribution"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-262", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "madurai-temple-entry-escort-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): 1939 ஜூலை 8 அன்று நடைபெற்ற மதுரை மீனாட்சியம்மன் கோயில் ஆலயப் பிரவேசத்தில் வைத்தியநாத ஐயர் குழுவினருக்கு முத்துராமலிங்கத்தேவர் துணையாக நின்று பாதுகாப்பளித்தார்.\nகாரணம் (R): ஆலயப் பிரவேசத்தை எதிர்த்துத் தாக்குதல் நடத்த முற்பட்ட ஆசாரவாதக் குழுக்களைத் தேவரின் எச்சரிக்கையும் வீரமிக்க ஆளுமையும் தடுத்து நிறுத்தின.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று சரி; காரணம் தவறு", "B": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றுக்குச் சரியான விளக்கமாகும்", "C": "கூற்று தவறு; காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் விளக்கம்: வைத்தியநாத ஐயர் ஆலயப் பிரவேசம் செய்யும்போது எதிர்ப்பாளர்கள் தாக்க முற்பட்ட வேளையில், தொண்டர்களுக்கு ஆதரவாக நின்று ஆலயப் பிரவேசம் வெற்றிகரமாக அமையத் தேவர் பாதுகாப்பு நல்கினார். கூற்று, காரணம் இரண்டும் சரி, சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): Muthuramalingathevar stood as a protective shield for Vaidyanatha Iyer's group during the July 8, 1939 Madurai temple entry.\nReason (R): Thevar's stern warning and towering commanding stature deterred orthodox reactionary elements from staging violent attacks.\nSelect the correct option."}], "options": {"A": "Assertion is correct; Reason is incorrect", "B": "Both Assertion and Reason are correct; Reason is the correct explanation", "C": "Assertion is incorrect; Reason is correct", "D": "Both Assertion and Reason are incorrect"}, "explanation": "Textbook explanation: Thevar issued strong public notices warning reactionaries against obstructing the entry, ensuring the social reform event occurred safely. Both are correct."}}, "question_data": {"assertion": "1939 ஜூலை 8 அன்று நடைபெற்ற மதுரை மீனாட்சியம்மன் கோயில் ஆலயப் பிரவேசத்தில் வைத்தியநாத ஐயர் குழுவினருக்கு முத்துராமலிங்கத்தேவர் துணையாக நின்று பாதுகாப்பளித்தார்.", "reason": "ஆலயப் பிரவேசத்தை எதிர்த்துத் தாக்குதல் நடத்த முற்பட்ட ஆசாரவாதக் குழுக்களைத் தேவரின் எச்சரிக்கையும் வீரமிக்க ஆளுமையும் தடுத்து நிறுத்தின.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 54, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "thevar_temple_entry_escort"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-263", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "criminal-tribes-act-misconception", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): ஆங்கிலேய அரசு கொண்டுவந்த குற்றப்பரம்பரைச் சட்டம் குற்றங்களைச் செய்த குற்றவாளிகளை மட்டுமே கண்காணிப்பதற்காக உருவாக்கப்பட்ட உன்னதமான சமூகப் பாதுகாப்புச் சட்டமாகும்.\nகாரணம் (R): இச்சட்டத்தின்படி எவ்விதக் குற்றமும் செய்யாத அப்பாவிகள் ஒருபோதும் காவல் நிலையத்திற்கு அழைக்கப்படவில்லை.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி", "B": "கூற்று சரி; காரணம் தவறு", "C": "கூற்று தவறு; காரணமும் முற்றிலும் தவறானது", "D": "கூற்று சரி; சரியான விளக்கம்"}, "explanation": "பாடநூல் விளக்கம்: குற்றப்பரம்பரைச் சட்டம் என்பது பிறப்பாலேயே ஒட்டுமொத்த சமுதாய மக்களையும் குற்றவாளிகளாக முத்திரை குத்தி வதைத்த கொடிய அடக்குமுறைச் சட்டம் ஆகும். எவ்விதக் குற்றமும் செய்யாத பெண்களும் அப்பாவிகளும் காவல் நிலையத்தில் ஆஜராக நிர்ப்பந்திக்கப்பட்டனர். எனவே கூற்றும் காரணமும் அப்பட்டமான தவறான கருத்துகள் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): The Criminal Tribes Act enacted by the British was a progressive social security law targeting only convicted felons.\nReason (R): Under this law, innocent citizens who committed no crimes were never subjected to mandatory police reporting.\nSelect the correct option."}], "options": {"A": "Both Assertion and Reason are correct", "B": "Assertion is correct; Reason is incorrect", "C": "Assertion is incorrect; Reason is also completely false", "D": "Assertion is correct; correct explanation"}, "explanation": "Textbook explanation: The Criminal Tribes Act was an inhumane colonial statute branding entire communities as habitual criminals by birth, forcing innocent people to report daily. Both Assertion and Reason are completely false."}}, "question_data": {"assertion": "ஆங்கிலேய அரசு கொண்டுவந்த குற்றப்பரம்பரைச் சட்டம் குற்றங்களைச் செய்த குற்றவாளிகளை மட்டுமே கண்காணிப்பதற்காக உருவாக்கப்பட்ட உன்னதமான சமூகப் பாதுகாப்புச் சட்டமாகும்.", "reason": "இச்சட்டத்தின்படி எவ்விதக் குற்றமும் செய்யாத அப்பாவிகள் ஒருபோதும் காவல் நிலையத்திற்கு அழைக்கப்படவில்லை.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 54, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "criminal_tribes_act_reality"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-264", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "thevar-1937-election-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): 1937 சட்டமன்றத் தேர்தலில் முத்துராமலிங்கத்தேவர் இராமநாதபுரம் மன்னரை எதிர்த்துப் போட்டியிட்டு மகத்தான வெற்றி பெற்றார்.\nகாரணம் (R): இராமநாதபுரம் மன்னர் வாக்குப்பதிவு நாளன்று தேர்தலிலிருந்து விலகிக் கொண்டதால் தேவர் எவ்வித வாக்குகளும் பெறாமல் வெற்றி பெற்றதாக அறிவிக்கப்பட்டார்.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று தவறு; காரணம் சரி", "B": "கூற்று, காரணம் இரண்டும் சரி", "C": "கூற்று, காரணம் இரண்டும் தவறு", "D": "கூற்று சரி; ஆனால் காரணம் தவறு"}, "explanation": "பாடநூல் விளக்கம்: 1937 தேர்தலில் மன்னர் சண்முக ராஜேஸ்வர சேதுபதியை எதிர்த்துக் கடுமையான போட்டியில் வாக்குகள் பெற்று தேவர் மாபெரும் வெற்றி பெற்றார். மன்னர் போட்டியிலிருந்து விலகினார் என்பது தவறான காரணம் ஆகும். எனவே கூற்று சரி, காரணம் தவறு."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): In the 1937 legislative assembly elections, Muthuramalingathevar scored a magnificent victory defeating the King of Ramanathapuram.\nReason (R): Because the King withdrew from the contest on polling day, Thevar was declared elected without receiving any votes.\nSelect the correct option."}], "options": {"A": "Assertion is incorrect; Reason is correct", "B": "Both Assertion and Reason are correct", "C": "Both Assertion and Reason are incorrect", "D": "Assertion is correct; but Reason is incorrect"}, "explanation": "Textbook explanation: Thevar actively contested against the King and secured a historic electoral upset through mass voter support. The withdrawal claim is false. Assertion is true; Reason is false."}}, "question_data": {"assertion": "1937 சட்டமன்றத் தேர்தலில் முத்துராமலிங்கத்தேவர் இராமநாதபுரம் மன்னரை எதிர்த்துப் போட்டியிட்டு மகத்தான வெற்றி பெற்றார்.", "reason": "இராமநாதபுரம் மன்னர் வாக்குப்பதிவு நாளன்று தேர்தலிலிருந்து விலகிக் கொண்டதால் தேவர் எவ்வித வாக்குகளும் பெறாமல் வெற்றி பெற்றதாக அறிவிக்கப்பட்டார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 55, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "thevar_1937_election"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-265", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "thevar-1962-illness-victory-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): 1962-ஆம் ஆண்டு நடைபெற்ற நாடாளுமன்றத் தேர்தலில் முத்துராமலிங்கத்தேவர் உடல்நலக்குறைவால் பிரச்சாரத்திற்கே செல்ல இயலாத நிலையிலும் மகத்தான வெற்றி பெற்றார்.\nகாரணம் (R): தேவர் தமது வாழ்நாள் முழுவதும் ஆற்றிய தன்னலமற்ற மக்கள் தொண்டும், தியாகப் பொதுவாழ்வும் மக்கள் மனதில் அவர் மீது கொண்டிருந்த எல்லையற்ற நம்பிக்கையும் நன்றியுணர்வும் இத்தேர்தல் வெற்றியை ஈட்டித் தந்தன.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றுக்குச் சரியான விளக்கம் ஆகும்", "B": "கூற்று சரி; ஆனால் காரணம் தவறு", "C": "கூற்று தவறு; காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் விளக்கம்: 1962 தேர்தலில் உடல்நலக்குறைவால் மருத்துவமனையில் இருந்தபோதும் நாடாளுமன்றத் தேர்தலில் மக்கள் அவரை வெற்றிபெறச் செய்த வரலாற்று உண்மையும், மக்களின் நம்பிக்கையே அதற்குக் காரணம் என்பதும் முற்றிலும் சரியானவை; தகுந்த விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): In the 1962 parliamentary elections, Muthuramalingathevar won a landslide victory despite severe illness preventing him from campaigning.\nReason (R): His lifetime of selfless public service, heroic sacrifices, and the profound trust of the people secured his victory even in his physical absence.\nSelect the correct option."}], "options": {"A": "Both Assertion and Reason are correct; Reason correctly explains Assertion", "B": "Assertion is correct; Reason is incorrect", "C": "Assertion is incorrect; Reason is correct", "D": "Both Assertion and Reason are incorrect"}, "explanation": "Textbook explanation: In 1962, though hospitalized and unable to step into the constituency, people overwhelmingly voted him to Parliament out of supreme gratitude. Both are valid."}}, "question_data": {"assertion": "1962-ஆம் ஆண்டு நடைபெற்ற நாடாளுமன்றத் தேர்தலில் முத்துராமலிங்கத்தேவர் உடல்நலக்குறைவால் பிரச்சாரத்திற்கே செல்ல இயலாத நிலையிலும் மகத்தான வெற்றி பெற்றார்.", "reason": "தேவர் தமது வாழ்நாள் முழுவதும் ஆற்றிய தன்னலமற்ற மக்கள் தொண்டும், தியாகப் பொதுவாழ்வும் மக்கள் மனதில் அவர் மீது கொண்டிருந்த எல்லையற்ற நம்பிக்கையும் நன்றியுணர்வும் இத்தேர்தல் வெற்றியை ஈட்டித் தந்தன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 55, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "thevar_1962_victory"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-266", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "thevar-historical-dates-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்துராமலிங்கத்தேவரின் பொதுவாழ்வு வரலாற்றுத் தேதிகளையும் நிகழ்வுகளையும் பொருத்துக:\nபட்டியல் I (தேதி / ஆண்டு):\nL1. 1939 செப்டம்பர் 6\nL2. 1934 மே 12, 13\nL3. 1939 ஜூலை 8\nL4. 1948\nபட்டியல் II (வரலாற்று நிகழ்வு):\nR1. கமுதியில் குற்றப்பரம்பரைச் சட்ட எதிர்ப்பு மாநாடு\nR2. நேதாஜி சுபாஷ் சந்திரபோஸ் மதுரைக்கு வருகை தந்த நாள்\nR3. குற்றப்பரம்பரைச் சட்டம் முழுமையாக நீக்கப்பட்ட ஆண்டு\nR4. மதுரை மீனாட்சியம்மன் கோயில் ஆலயப் பிரவேசம் நிகழ்ந்த நாள்"}], "options": {"A": "L1-R1, L2-R2, L3-R3, L4-R4", "B": "L1-R2, L2-R1, L3-R4, L4-R3", "C": "L1-R3, L2-R4, L3-R1, L4-R2", "D": "L1-R4, L2-R3, L3-R2, L4-R1"}, "explanation": "பாடநூல் விளக்கம்: 1939 செப் 6 = நேதாஜி மதுரை வருகை (R2); 1934 மே 12, 13 = கமுதி மாநாடு (R1); 1939 ஜூலை 8 = ஆலயப் பிரவேசம் (R4); 1948 = குற்றப்பரம்பரைச் சட்டம் நீக்கம் (R3). வரிசை: 2 - 1 - 4 - 3."}, "en": {"blocks": [{"type": "text", "content": "Match the pivotal historical dates in Thevar's political life with their milestones:\nList I (Date / Year):\nL1. September 6, 1939\nL2. May 12-13, 1934\nL3. July 8, 1939\nL4. 1948\nList II (Historical Event):\nR1. Anti-Criminal Tribes Act conference at Kamudhi\nR2. Netaji Subhas Chandra Bose's historic visit to Madurai\nR3. Year the Criminal Tribes Act was finally revoked\nR4. Historic temple entry at Madurai Meenakshi Temple"}], "options": {"A": "L1-R1, L2-R2, L3-R3, L4-R4", "B": "L1-R2, L2-R1, L3-R4, L4-R3", "C": "L1-R3, L2-R4, L3-R1, L4-R2", "D": "L1-R4, L2-R3, L3-R2, L4-R1"}, "explanation": "Textbook match: Netaji Madurai visit=1939 Sep 6 (R2), Kamudhi Conference=1934 May 12-13 (R1), Temple Entry=1939 July 8 (R4), Act Repeal=1948 (R3)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "1939 செப்டம்பர் 6", "content_en": "September 6, 1939"}, {"id": "L2", "content_ta": "1934 மே 12, 13", "content_en": "May 12-13, 1934"}, {"id": "L3", "content_ta": "1939 ஜூலை 8", "content_en": "July 8, 1939"}, {"id": "L4", "content_ta": "1948", "content_en": "1948"}], "right": [{"id": "R1", "content_ta": "கமுதியில் குற்றப்பரம்பரைச் சட்ட எதிர்ப்பு மாநாடு", "content_en": "Anti-Criminal Tribes Act conference"}, {"id": "R2", "content_ta": "நேதாஜி சுபாஷ் சந்திரபோஸ் மதுரைக்கு வருகை தந்த நாள்", "content_en": "Netaji's visit to Madurai"}, {"id": "R3", "content_ta": "குற்றப்பரம்பரைச் சட்டம் முழுமையாக நீக்கப்பட்ட ஆண்டு", "content_en": "Year Criminal Tribes Act revoked"}, {"id": "R4", "content_ta": "மதுரை மீனாட்சியம்மன் கோயில் ஆலயப் பிரவேசம் நிகழ்ந்த நாள்", "content_en": "Madurai temple entry date"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 53, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "match", "thevar_chronology_match"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-267", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "thevar-electoral-record-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்துராமலிங்கத்தேவர் போட்டியிட்ட சட்டமன்ற/நாடாளுமன்றத் தேர்தல்களையும் சிறப்புகளையும் பொருத்துக:\nபட்டியல் I (தேர்தல் ஆண்டு):\nL1. 1937 தேர்தல்\nL2. 1946 தேர்தல்\nL3. 1952 & 1957 தேர்தல்\nL4. 1962 தேர்தல்\nபட்டியல் II (தேர்தல் சாதனை):\nR1. சட்டமன்றம் மற்றும் நாடாளுமன்றம் இரண்டிலும் ஒரே நேரத்தில் இரட்டை வெற்றி\nR2. உடல்நலக்குறைவால் பிரச்சாரத்திற்கே செல்லாமல் பெற்ற மாபெரும் வெற்றி\nR3. இராமநாதபுரம் மன்னர் சண்முக ராஜேஸ்வர சேதுபதியை எதிர்த்துப் பெற்ற வெற்றி\nR4. எவரும் எதிர்க்காமல் போட்டியின்றி ஒருமனதாக சட்டமன்றத்திற்குத் தேர்வானது"}], "options": {"A": "L1-R1, L2-R2, L3-R3, L4-R4", "B": "L1-R2, L2-R1, L3-R4, L4-R3", "C": "L1-R3, L2-R4, L3-R1, L4-R2", "D": "L1-R4, L2-R3, L3-R2, L4-R1"}, "explanation": "பாடநூல் விளக்கம்: 1937 = மன்னரை வென்றது (R3); 1946 = போட்டியின்றி தேர்வு (R4); 1952/1957 = இரட்டை வெற்றி (R1); 1962 = பிரச்சாரமின்றி வெற்றி (R2). வரிசை: 3 - 4 - 1 - 2."}, "en": {"blocks": [{"type": "text", "content": "Match Muthuramalingathevar's electoral milestones with their distinctive feats:\nList I (Election Year):\nL1. 1937 Election\nL2. 1946 Election\nL3. 1952 & 1957 Elections\nL4. 1962 Election\nList II (Electoral Feat):\nR1. Simultaneous dual triumphs in both Legislative Assembly and Parliament\nR2. Landslide Parliamentary victory achieved while bedridden without campaigning\nR3. Historic victory defeating the Raja of Ramanathapuram\nR4. Unanimous unopposed election to the Legislative Assembly"}], "options": {"A": "L1-R1, L2-R2, L3-R3, L4-R4", "B": "L1-R2, L2-R1, L3-R4, L4-R3", "C": "L1-R3, L2-R4, L3-R1, L4-R2", "D": "L1-R4, L2-R3, L3-R2, L4-R1"}, "explanation": "Textbook match: 1937=Defeating Raja (R3), 1946=Unopposed (R4), 1952/57=Dual victory (R1), 1962=Without campaign (R2)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "1937 தேர்தல்", "content_en": "1937 Election"}, {"id": "L2", "content_ta": "1946 தேர்தல்", "content_en": "1946 Election"}, {"id": "L3", "content_ta": "1952 & 1957 தேர்தல்", "content_en": "1952 & 1957 Elections"}, {"id": "L4", "content_ta": "1962 தேர்தல்", "content_en": "1962 Election"}], "right": [{"id": "R1", "content_ta": "சட்டமன்றம் மற்றும் நாடாளுமன்றம் இரண்டிலும் ஒரே நேரத்தில் வெற்றி", "content_en": "Simultaneous dual triumphs"}, {"id": "R2", "content_ta": "உடல்நலக்குறைவால் பிரச்சாரத்திற்கே செல்லாமல் பெற்ற வெற்றி", "content_en": "Victory without campaigning"}, {"id": "R3", "content_ta": "இராமநாதபுரம் மன்னரை எதிர்த்துப் பெற்ற வெற்றி", "content_en": "Victory defeating Raja"}, {"id": "R4", "content_ta": "போட்டியின்றி ஒருமனதாகச் சட்டமன்றத்திற்குத் தேர்வானது", "content_en": "Unopposed election to Assembly"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 55, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "off