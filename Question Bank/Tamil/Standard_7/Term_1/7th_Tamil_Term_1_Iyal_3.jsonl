{"id": "7th-t1-u3-331", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l4-orezhuthu-oru-mozhi", "chapter_id": null, "topic_id": "panbu-pagupatham-id", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பெரியார்', 'செம்மலையான்', 'இனியன்' என்பன எவ்வகைப் பகுபதத்திற்கு எடுத்துக்காட்டுகளாகும்?"}], "options": {"A": "பொருட்பெயர்ப் பகுபதம்", "B": "இடப்பெயர்ப் பகுபதம்", "C": "பண்புப் பெயர்ப் பகுபதம்", "D": "தொழிற்பெயர்ப் பகுபதம்"}, "explanation": "பாடநூல் குறிப்பு: பெரியார் (பெருமை/பண்பு), செம்மலையான் (செம்மை/பண்பு), இனியன் (இனிமை/பண்பு) என்பன பண்பினை அடிப்படையாகக் கொண்டு பிறந்த 'பண்புப் பெயர்ப் பகுபதங்கள்' (குணப்பெயர்ப் பகுபதங்கள்) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "'Periyar', 'Semmalaiyaan', and 'Iniyan' are examples of which type of Pagupatham?"}], "options": {"A": "Material Noun Pagupatham", "B": "Place Noun Pagupatham", "C": "Attribute/Quality Noun Pagupatham", "D": "Action/Occupation Noun Pagupatham"}, "explanation": "Textbook fact: 'Periyar', 'Semmalaiyaan', and 'Iniyan' are based on attribute/quality (Perumai, Semmai, Inimai), hence they are Attribute Noun Pagupatham."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher