{"id": "7th-t1-u3-359", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l5-thirukkural-iraimaatchi", "chapter_id": null, "topic_id": "earu-metric-meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"படைகுடி கூழ்அமைச்சு நட்பரண் ஆறும் உடையான் அரசருள் ஏறு\" - இக்குறட்பாவில் பயின்று வந்துள்ள 'ஏறு' என்னும் சொல்லின் பொருளும் இலக்கணக் குறிப்பும் யாது?"}], "options": {"A": "ஏறிச் செல்லுதல் (வினைமுற்று)", "B": "நிலத்தை உழும் எருது (பெயர்ச்சொல்)", "C": "ஆண் சிங்கம் / சிறந்தவன் (உவமையாக நின்ற பெயர்ச்சொல்)", "D": "உயரமான மலை (இடப்பெயர்)"}, "explanation": "பாடநூல் குறிப்பு: 'ஏறு' என்பதற்கு 'ஆண் சிங்கம்' என்பது பொருள். ஆறு அங்கங்களை உடையவன் அரசர்களுள் சிங்கம் போன்ற வீரம் மற்றும் தலைமை உடையவன் என்ற பொருளில் உவமை ஆகுபெயராக வந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "In the kural 'Padaikudi Koozhamaitchu Natparan Aarum Udaiyaan Arasarul Earu', what is the meaning and grammatical context of 'Earu'?"}], "options": {"A": "To ascend (Finite verb)", "B": "Bull ploughing field (Noun)", "C": "Male lion / Supreme person (Metaphorical noun)", "D": "Tall mountain (Place noun)"}, "explanation": "Textbook fact: 'Earu' signifies a male lion, used metaphorically to denote a paramount monarch who rules majestically like a lion among beasts."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 69, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "grammar", "kural_vocabulary_context"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
