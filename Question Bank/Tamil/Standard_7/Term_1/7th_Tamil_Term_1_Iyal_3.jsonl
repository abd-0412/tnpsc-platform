{"id": "7th-t1-u3-333", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l4-orezhuthu-oru-mozhi", "chapter_id": null, "topic_id": "odd-orezhuthu-kuril", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நன்னூலார் கூறிய 42 ஓரெழுத்து ஒருமொழிகளுள் குறில் எழுத்துகளாக அமைந்த சொல்லின் இணை எது?"}], "options": {"A": "கா, கூ", "B": "நொ, து", "C": "சா, சீ", "D": "பா, பூ"}, "explanation": "பாடநூல் குறிப்பு: பவணந்தி முனிவர் குறிப்பிட்ட 42 ஓரெழுத்து ஒருமொழிகளில் 'நொ' (நோய்) மற்றும் 'து' (உண்) ஆகிய இரண்டு மட்டுமே குறில் எழுத்துகள் ஆகும். ஏனையவை நெடில்கள்."}, "en": {"blocks": [{"type": "text", "content": "Which pair of single-letter words are short vowel letters (kuril) among the 42 identified in Nannool?"}], "options": {"A": "Kaa, Koo", "B": "No, Thu", "C": "Saa, See", "D": "Paa, Poo"}, "explanation": "Textbook fact: 'No' (disease) and 'Thu' (eat) are the only two short single-letter words mentioned in Nannool."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 60, "chapter": null, "section": null, "reference": null, "url": null, "so