{"id": "7th-t1-u3-301", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l3-kappalottiya-tamizhan", "chapter_id": null, "topic_id": "sandhi-sollinselvar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிரித்தெழுதுக:\n'சொல்லின்செல்வர்' என்னும் தொடரைச் சரியாகப் பிரித்தெழுதக் கிடைக்கும் வடிவம் எது?"}], "options": {"A": "சொல்லின் + செல்வர்", "B": "சொல் + செல்வர்", "C": "சொல்லி + செல்வர்", "D": "சொல்லு + செல்வர்"}, "explanation": "இலக்கண விளக்கம்: சொல் + இன் (ஐந்தாம் வேற்றுமை / இன் சாரியை) = சொல்லின் + செல்வர் எனப் பிரியும்; நிலைமொழி னகர ஈற்றின் முன் வல்லினம் சகரம் மிக்குப் புணர்ந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Identify the correct grammatical separation of 'Sollinselvar':"}], "options": {"A": "Sollin + Selvar (சொல்லின் + செல்வர்)", "B": "Sol + Selvar", "C": "Solli + Selvar", "D": "Sollu + Selvar"}, "explanation": "Grammar explanation: Splits as Sollin + Selvar, where the hard consonant 's' doubles after the case ending."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 59, "chapter": null, "se