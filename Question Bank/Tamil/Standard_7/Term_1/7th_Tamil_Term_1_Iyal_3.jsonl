{"id": "7th-t1-u3-335", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l4-orezhuthu-oru-mozhi", "chapter_id": null, "topic_id": "orezhuthu-total-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நன்னூலின்படி தமிழில் உள்ள ஓரெழுத்து ஒருமொழிகளின் மொத்த எண்ணிக்கை எத்தனை?"}], "options": {"A": "42", "B": "40", "C": "44", "D": "46"}, "explanation": "பாடநூல் குறிப்பு: நன்னூல் என்னும் இலக்கண நூலை எழுதிய பவணந்தி முனிவர் தமிழில் 42 ஓரெழுத்து ஒருமொழிகள் உள்ளன எனக் குறிப்பிட்டுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "According to Nannool, what is the total number of single-letter words in Tamil?"}], "options": {"A": "42", "B": "40", "C": "44", "D": "46"}, "explanation": "Textbook fact: Pavanandhi Munivar, author of the Tamil grammar work Nannool, stated that there are 42 single-letter words in Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 60, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name"