{"id": "7th-t1-u3-302", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l3-kappalottiya-tamizhan", "chapter_id": null, "topic_id": "sandhi-sudhesikkappal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சேர்த்தெழுதுக:\n'சுதேசி + கப்பல்' என்பது புணர்ச்சி விதிகளின்படி எவ்வாறு புணரும்?"}], "options": {"A": "சுதேசிகப்பல்", "B": "சுதேசிக் கப்பல்", "C": "சுதேச கப்பல்", "D": "சுதேசக்கப்பல்"}, "explanation": "இலக்கண விதி: நிலைமொழி இகர ஈற்றுப் பெயர்ச்சொல்லாக நிற்கும்போது, வருமொழி முதலில் வரும் ககரம் மிகுந்து 'சுதேசிக் கப்பல்' என வல்லினம் மிக்குப் புணரும்."}, "en": {"blocks": [{"type": "text", "content": "Combine 'Sudhesi + Kappal' according to Tamil grammatical sandhi rules:"}], "options": {"A": "Sudhesikappal", "B": "Sudhesik Kappal (சுதேசிக் கப்பல்)", "C": "Sudhesa kappal", "D": "Sudhesakkappal"}, "explanation": "Grammar rule: Hard consonant 'k' doubles after the vowel-ending noun 'sudhesi', yielding 'Sudhesik Kappal'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 57, "chapter": null, "section": null, "reference": null,