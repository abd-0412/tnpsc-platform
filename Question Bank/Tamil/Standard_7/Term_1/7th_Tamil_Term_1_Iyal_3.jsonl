// 7-ஆம் வகுப்பு தமிழ் - பருவம் 1 - இயல் 3: நாடு, சமூகம், அரசு, நிருவாகம் (மொத்த வினாக்கள்: 140)
// ==============================================================================

// ==============================================================================
// பாடம் 1: விடுதலைத் திருநாள் (கவிதைப்பேழை - கவிஞர் மீரா) & முத்துராமலிங்கத்தேவர் - தொடக்க வாழ்க்கை [Q225 - Q252]
// கவிஞர் மீரா (மீ. இராசேந்திரன்), தமிழ்ப் பேராசிரியர், அன்னம் விடு தூது இதழ், ஊசிகள், குக்கூ, மூன்றும் ஆறும், கோடையும் வசந்தமும், பகத்சிங் விடியல்; பசும்பொன் உ. முத்துராமலிங்கத்தேவர் (1908 அக் 30 - 1963 அக் 30), உக்கிரபாண்டித் தேவர் - இந்திராணி, இசுலாமியத் தாய் தாய்ப்பால், சாயல்குடி விவேகானந்தர் உரை (3 மணி நேரம்)
// ==============================================================================
{"id": "7th-t1-u3-225", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l1-vidudhalai-thirunaal", "chapter_id": null, "topic_id": "meera-facts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் மீரா பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. கவிஞர் மீராவின் இயற்பெயர் மீ. இராசேந்திரன் என்பதாகும்.\n2. இவர் கல்லூரியில் தமிழ்ப் பேராசிரியராகப் பணியாற்றிய பெருமைக்குரியவர்.\n3. 'அன்னம் விடு தூது' என்னும் புகழ்பெற்ற இதழை நடத்தியவர்.\n4. ஊசிகள், குக்கூ, மூன்றும் ஆறும், கோடையும் வசந்தமும் உள்ளிட்ட பல நூல்களை இயற்றியுள்ளார்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2 மட்டுமே சரி; 3, 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 மட்டுமே சரி; 1 தவறு", "D": "கூற்றுகள் 1, 3 மட்டுமே சரி; 2, 4 தவறு"}, "explanation": "பாடநூல் குறிப்பு: மீராவின் இயற்பெயர் மீ. இராசேந்திரன்; தமிழ்ப் பேராசிரியர்; அன்னம் விடு தூது இதழ் ஆசிரியர்; ஊசிகள், குக்கூ, மூன்றும் ஆறும், கோடையும் வசந்தமும் இவரது நூல்கள். எனவே அனைத்துக் கூற்றுகளும் சரி."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements regarding poet Meera:\n1. Poet Meera's birth name is M. Rajendran.\n2. He served distinguishedly as a Professor of Tamil in college.\n3. He edited and published the renowned literary journal 'Annam Vidu Thoodhu'.\n4. His literary works include Oosigal, Kuckoo, Moondrum Aarum, and Kodaiyum Vasanthamum.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Only statements 1 and 2 are correct", "C": "Only statements 2, 3, and 4 are correct", "D": "Only statements 1 and 3 are correct"}, "explanation": "Textbook fact: All four statements regarding poet Meera's identity, academia, journalism, and works are completely correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "கவிஞர் மீராவின் இயற்பெயர் மீ. இராசேந்திரன் என்பதாகும்.", "content_en": "Poet Meera's birth name is M. Rajendran."}, {"id": "S2", "content_ta": "இவர் கல்லூரியில் தமிழ்ப் பேராசிரியராகப் பணியாற்றியவர்.", "content_en": "He served as a Professor of Tamil in college."}, {"id": "S3", "content_ta": "'அன்னம் விடு தூது' என்னும் புகழ்பெற்ற இதழை நடத்தியவர்.", "content_en": "He edited the journal 'Annam Vidu Thoodhu'."}, {"id": "S4", "content_ta": "ஊசிகள், குக்கூ, மூன்றும் ஆறும், கோடையும் வசந்தமும் நூல்களை இயற்றியுள்ளார்.", "content_en": "Authored Oosigal, Kuckoo, Moondrum Aarum, Kodaiyum Vasanthamum."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 49, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "poet_meera"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-226", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "thevar-birth-childhood", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பசும்பொன் உ. முத்துராமலிங்கத்தேவரின் பிறப்பு மற்றும் இளமைக்காலம் பற்றிய கூற்றுகளை ஆராய்க:\n1. இவர் 1908-ஆம் ஆண்டு அக்டோபர் திங்கள் முப்பதாம் நாளில் இராமநாதபுரம் மாவட்டம் பசும்பொன்னில் பிறந்தார்.\n2. இவரது பெற்றோர் உக்கிரபாண்டியத் தேவர் மற்றும் இந்திராணி அம்மையார் ஆவர்.\n3. இவர் இளமையிலேயே தாயை இழந்ததால், ஓர் இசுலாமியத் தாயினால் தாய்ப்பால் ஊட்டி வளர்க்கப்பட்டார்.\n4. இவர் இங்கிலாந்து நாட்டிற்குச் சென்று சட்டம் பயின்று பாரிஸ்டர் பட்டம் பெற்றார்.\nஇவற்றுள் சரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "B": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "D": "கூற்றுகள் அனைத்தும் சரி"}, "explanation": "பாடநூல் விளக்கம்: தேவர் தொடக்கக் கல்வியைக் கமுதியிலும், உயர்நிலைக் கல்வியை மதுரை பசுமலை மற்றும் இராமநாதபுரத்திலும் பயின்றார்; பிளேக் நோயினால் பள்ளிப் படிப்பு தடைபட்டது; அவர் இங்கிலாந்து சென்று பாரிஸ்டர் பட்டம் பெறவில்லை. எனவே கூற்று 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements on the birth and early childhood of Pasumpon U. Muthuramalingathevar:\n1. He was born on October 30, 1908, in Pasumpon village of Ramanathapuram district.\n2. His parents were Ukkirapandiya Thevar and Indirani Ammaiyar.\n3. Having lost his mother in infancy, he was nurtured and breastfed by a Muslim foster mother.\n4. He traveled to England, studied jurisprudence, and qualified as a Barrister-at-Law.\nSelect the correct option."}], "options": {"A": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "B": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect", "C": "Statements 2, 3, and 4 are correct; 1 is incorrect", "D": "All statements are correct"}, "explanation": "Textbook explanation: Thevar studied in Kamudhi, Madurai Pasumalai, and Ramanathapuram, leaving school due to plague; he never studied law in England. Statement 4 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "1908 அக்டோபர் 30-ல் இராமநாதபுரம் மாவட்டம் பசும்பொன்னில் பிறந்தார்.", "content_en": "Born on October 30, 1908, in Pasumpon, Ramanathapuram."}, {"id": "S2", "content_ta": "பெற்றோர் உக்கிரபாண்டியத் தேவர் மற்றும் இந்திராணி அம்மையார் ஆவர்.", "content_en": "Parents were Ukkirapandiya Thevar and Indirani Ammaiyar."}, {"id": "S3", "content_ta": "இளமையில் தாயை இழந்ததால் இசுலாமியத் தாயினால் பாலூட்டி வளர்க்கப்பட்டார்.", "content_en": "Nurtured by a Muslim foster mother after losing his mother."}, {"id": "S4", "content_ta": "இவர் இங்கிலாந்து நாட்டிற்குச் சென்று பாரிஸ்டர் பட்டம் பெற்றார்.", "content_en": "He traveled to England and qualified as a Barrister."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "thevar_early_life"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-227", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "leaders-praise-thevar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்துராமலிங்கத்தேவர் பற்றித் தலைவர்கள் கூறிய புகழுரைகளை ஆராய்க:\n1. தந்தை பெரியார்: 'வீரப் பேச்சால் எத்தனையோ தியாகிகளையும், விவேகப் பேச்சால் எத்தனையோ அறிஞர்களையும் உண்டாக்கியவர்; எதையும் ஒளிவுமறைவின்றிப் பேசும் சுத்தத் தியாகி'.\n2. பேரறிஞர் அண்ணா: 'தென்னாட்டுச் சிங்கம் என்று போற்றப்படும் முத்துராமலிங்கத்தேவரின் பேச்சு உள்ளத்திலிருந்து வெளிவருகிறது; உதடுகளிலிருந்து அல்ல'.\n3. திரு.வி. கலியாணசுந்தரனார் இவரைத் 'தேசியம் காத்த செம்மல்' என்று பாராட்டியுள்ளார்.\n4. காந்தியடிகள் இவரைத் தனது 'அரசியல் வாரிசு' என அதிகாரப்பூர்வமாக அறிவித்தார்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "B": "கூற்றுகள் அனைத்தும் சரி", "C": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "பாடநூல் விளக்கம்: பெரியார், அண்ணா, திரு.வி.க ஆகியோர் கூறிய பாராட்டுகள் பாடநூலில் இடம்பெற்றுள்ளன. காந்தியடிகள் அரசியல் வாரிசாக அறிவித்தார் என்பது தவறான கூற்றாகும். எனவே கூற்று 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the tributes paid to Muthuramalingathevar by eminent leaders:\n1. Thanthai Periyar: 'Created innumerable martyrs through heroic speeches and scholars through wise discourses; a pure martyr who spoke truth plainly'.\n2. Arignar Anna: 'The lion of the south whose words emanate straight from the depths of the heart, not merely from the lips'.\n3. Thiru. Vi. Kalyanasundaranar lauded him as 'Dhesiyam Kaattha Semmal' (Guardian of Nationalism).\n4. Mahatma Gandhi officially proclaimed Thevar as his sole political heir.\nWhich statements are correct?"}], "options": {"A": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "B": "All statements are correct", "C": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect", "D": "Statements 2, 3, and 4 are correct; 1 is incorrect"}, "explanation": "Textbook explanation: Tributes by Periyar, Anna, and Thiru.Vi.Ka are accurate. The claim regarding Gandhi's political heir is false. Statement 4 is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பெரியார்: 'வீரப் பேச்சால் தியாகிகளையும், விவேகத்தால் அறிஞர்களையும் உண்டாக்கிய சுத்தத் தியாகி'.", "content_en": "Periyar hailed him as a pure martyr inspiring fighters and scholars."}, {"id": "S2", "content_ta": "அண்ணா: 'தென்னாட்டுச் சிங்கத்தின் பேச்சு உள்ளத்திலிருந்து வெளிவருகிறது'.", "content_en": "Anna: 'Southern lion whose speech flows from the heart'."}, {"id": "S3", "content_ta": "திரு.வி.க இவரைத் 'தேசியம் காத்த செம்மல்' என்று பாராட்டியுள்ளார்.", "content_en": "Thiru.Vi.Ka hailed him as 'Dhesiyam Kaattha Semmal'."}, {"id": "S4", "content_ta": "காந்தியடிகள் இவரைத் தனது அரசியல் வாரிசு என அறிவித்தார்.", "content_en": "Mahatma Gandhi proclaimed him his political heir."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 53, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "leaders_tributes_thevar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-228", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l1-vidudhalai-thirunaal", "chapter_id": null, "topic_id": "vidudhalai-poem-content", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மீராவின் 'விடுதலைத் திருநாள்' பாடல் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. முந்நூறு ஆண்டுகள் நம்மை அடிமைப்படுத்தி ஆண்ட அந்நிய ஆங்கிலேயரின் கொடுங்கோல் ஆட்சி வீழ்ந்ததை விவரிக்கிறது.\n2. செத்த பிணமாய் உணர்வின்றி வாழ்ந்த இந்தியத் தேசம் விடுதலைத் திருநாளில் உயிர்பெற்று (ஜீவன் பெற்று) எழுந்தது.\n3. பகத்சிங் போன்ற மாவீரர்கள் தூக்கு மேடையைத் தழுவிப் பெற்றுத் தந்த விடியலே நமது விடுதலைத் திருநாளாகும்.\n4. இப்பாடல் 'அன்னம் விடு தூது' என்னும் கவிதை நூலில் இருந்து நேரடியாகப் பாடப்பகுதியாகத் தேர்வு செய்யப்பட்டது.\nஇவற்றுள் சரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் அனைத்தும் சரி", "B": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "C": "கூற்றுகள் 2, 3, 4 சரி; கூற்று 1 தவறு", "D": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு"}, "explanation": "பாடநூல் குறிப்பு: 'விடுதலைத் திருநாள்' என்னும் பாடல் மீராவின் 'கோடையும் வசந்தமும்' என்னும் கவிதை நூலிலிருந்து எடுக்கப்பட்டது ('அன்னம் விடு தூது' என்பது அவர் நடத்திய இதழாகும்). எனவே கூற்றுகள் 1, 2, 3 சரி; 4 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the following statements on Meera's poem 'Vidudhalai Thirunaal':\n1. It portrays the overthrow of the tyrannical three-century colonial British yoke.\n2. The Indian nation, once lifeless like a corpse under subjugation, came vibrant with life on Independence Day.\n3. The dawn of liberty was sanctified by martyrs like Bhagat Singh who embraced the gallows.\n4. This poem is excerpted directly from the poetry volume titled 'Annam Vidu Thoodhu'.\nSelect the correct option."}], "options": {"A": "All statements are correct", "B": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "C": "Statements 2, 3, and 4 are correct; 1 is incorrect", "D": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect"}, "explanation": "Textbook fact: The poem is from the book 'Kodaiyum Vasanthamum' ('Annam Vidu Thoodhu' was his journal). Statement 4 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "முந்நூறு ஆண்டுகள் ஆண்ட ஆங்கிலேயரின் கொற்றம் வீழ்ந்ததை விவரிக்கிறது.", "content_en": "Portrays the fall of 300-year British rule."}, {"id": "S2", "content_ta": "செத்த பிணமாய் இருந்த இந்தியத் தேசம் விடுதலை நாளில் ஜீவன் பெற்று எழுந்தது.", "content_en": "Corpse-like India gained vibrant life on freedom day."}, {"id": "S3", "content_ta": "பகத்சிங் தூக்கு மேடையைத் தழுவிப் பெற்றுத் தந்த விடியலே விடுதலைத் திருநாள்.", "content_en": "Bhagat Singh's supreme sacrifice birthed freedom's dawn."}, {"id": "S4", "content_ta": "இப்பாடல் 'அன்னம் விடு தூது' என்னும் கவிதை நூலில் இருந்து எடுக்கப்பட்டது.", "content_en": "Excerpted from poetry volume 'Annam Vidu Thoodhu'."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 48, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "vidudhalai_poem"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-229", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "thevar-speech-multilingual", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்துராமலிங்கத்தேவரின் கல்வி, மொழித்திறன் மற்றும் பேச்சாற்றல் பற்றிய கூற்றுகளை ஆராய்க:\n1. இவர் தமிழ், ஆங்கிலம் ஆகிய இரு மொழிகளிலும் வல்லமை பெற்றுச் சொற்பொழிவு ஆற்றும் திறன் பெற்றிருந்தார்.\n2. சிலம்பம், குதிரையேற்றம், துப்பாக்கி சுடுதல், சோதிடம், மருத்துவம் முதலிய பல்துறை அறிவையும் சுயமாகக் கற்றுத் தேர்ந்தார்.\n3. சாயல்குடியில் விவேகானந்தரின் பெருமை குறித்து இவர் ஆற்றிய மூன்று மணி நேரச் சொற்பொழிவே இவரது முதல் மேடைப் பேச்சாகும்.\n4. இவரது சாயல்குடி உரையை நேரில் கேட்ட காமராசர், 'இதுபோன்ற ஒரு பேச்சை இதுவரை நான் கேட்டதே இல்லை' என்று மனமாரப் பாராட்டினார்.\nஇவற்றுள் சரியான கூற்றுகளைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரி", "B": "கூற்றுகள் 1, 2 மட்டுமே சரி; 3, 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 மட்டுமே சரி; 1 தவறு", "D": "கூற்றுகள் 1, 3 மட்டுமே சரி; 2, 4 தவறு"}, "explanation": "பாடநூல் குறிப்பு: தமிழ் மற்றும் ஆங்கில புலமை; சிலம்பம், குதிரையேற்றம் முதலான பல்துறை ஆற்றல்; சாயல்குடி விவேகானந்தர் உரை (முதல் பேச்சு); காமராசரின் பாராட்டு ஆகிய இந்நான்கு கூற்றுகளும் பாடநூலின்படி முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements on Muthuramalingathevar's learning, multilingual proficiency, and eloquence:\n1. He was proficient in both Tamil and English, delivering powerful orations in both languages.\n2. He mastered diverse arts including Silambam, equestrian riding, shooting, astrology, and indigenous medicine.\n3. His maiden public address was a mesmerizing 3-hour speech on Swami Vivekananda at Sayalgudi.\n4. Witnessing his Sayalgudi speech, Kamarajar remarked that he had never heard such a brilliant speech.\nSelect the correct statements."}], "options": {"A": "All statements 1, 2, 3, and 4 are correct", "B": "Only statements 1 and 2 are correct", "C": "Only statements 2, 3, and 4 are correct", "D": "Only statements 1 and 3 are correct"}, "explanation": "Textbook fact: All four statements regarding bilingual eloquence, traditional martial arts, the maiden Sayalgudi speech, and Kamarajar's tribute are validated."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "தமிழ், ஆங்கிலம் ஆகிய இரு மொழிகளிலும் சொற்பொழிவு ஆற்றும் திறன் பெற்றிருந்தார்.", "content_en": "Eloquent orator in both Tamil and English."}, {"id": "S2", "content_ta": "சிலம்பம், குதிரையேற்றம், துப்பாக்கி சுடுதல் முதலான பல்துறை அறிவைக் கற்றார்.", "content_en": "Mastered Silambam, horsemanship, shooting, and medicine."}, {"id": "S3", "content_ta": "சாயல்குடியில் விவேகானந்தர் குறித்து ஆற்றிய உரையே இவரது முதல் மேடைப் பேச்சு.", "content_en": "Speech on Vivekananda at Sayalgudi was his maiden oration."}, {"id": "S4", "content_ta": "இவரது பேச்சைக் கேட்ட காமராசர் இதுபோன்ற பேச்சை இதுவரை கேட்டதில்லை எனப் பாராட்டினார்.", "content_en": "Kamarajar lauded having never heard such a brilliant speech."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "thevar_oratory_skills"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-230", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "thevar-speech-ban-gag-act", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆங்கிலேய அரசின் அடக்குமுறைகளும் முத்துராமலிங்கத்தேவரின் தேசியப் பணியும் பற்றிய கூற்றுகளை ஆராய்க:\n1. முத்துராமலிங்கத்தேவரின் விடுதலை உணர்ச்சிமிக்க மேடைப் பேச்சுகள் மக்களிடையே பெரும் எழுச்சியை ஏற்படுத்தின.\n2. விடுதலைப் போரை முடக்க ஆங்கிலேய அரசு மேடைகளில் அரசியல் பேசக்கூடாது எனத் தேவரின் மீது 'வாய்ப்பூட்டுச் சட்டம்' போட்டது.\n3. வட இந்தியாவில் பாலகங்காதர திலகருக்கும், தென்னிந்தியாவில் பசும்பொன் முத்துராமலிங்கத்தேவருக்கும் இச்சட்டம் பாய்ந்தது.\n4. வாய்ப்பூட்டுச் சட்டம் விதிக்கப்பட்டதால் தேவர் தமது பொது வாழ்க்கையை முற்றிலுமாகக் கைவிட்டு ஆன்மிகத்தில் மட்டுமே ஒதுங்கினார்.\nஇவற்றுள் சரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "B": "கூற்றுகள் 1, 2, 3 சரி; கூற்று 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "D": "கூற்றுகள் அனைத்தும் சரி"}, "explanation": "பாடநூல் விளக்கம்: வாய்ப்பூட்டுச் சட்டம் மற்றும் பலமுறை சிறைத்தண்டனைகள் விதிக்கப்பட்ட போதும் தேவர் ஒருபோதும் அஞ்சாமல் தொடர்ந்து தேசிய விடுதலைப் போரிலும் மக்கள் பணியிலும் தீவிரமாக ஈடுபட்டார். எனவே கூற்று 4 தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Analyze the British colonial suppression and Thevar's nationalist struggle:\n1. Muthuramalingathevar's fiery nationalist speeches sparked immense political awakening among the masses.\n2. To paralyze his campaign, the British colonial regime slapped a Gagging Act banning him from public speaking.\n3. In Northern India, Bal Gangadhar Tilak and in Southern India, Muthuramalingathevar were subjected to this Gagging Act.\n4. Following the Gagging Act, Thevar completely abandoned public life and retreated strictly into spiritual seclusion.\nSelect the correct option."}], "options": {"A": "Statements 1 and 4 are correct; 2 and 3 are incorrect", "B": "Statements 1, 2, and 3 are correct; Statement 4 is incorrect", "C": "Statements 2, 3, and 4 are correct; 1 is incorrect", "D": "All statements are correct"}, "explanation": "Textbook explanation: Despite repetitive imprisonments and gagging orders, Thevar never retreated from active public politics. Statement 4 is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "தேவரின் மேடைப் பேச்சுகள் மக்களிடையே பெரும் விடுதலை எழுச்சியை ஏற்படுத்தின.", "content_en": "Thevar's fiery oratory ignited nationalist awakening."}, {"id": "S2", "content_ta": "ஆங்கிலேய அரசு தேவரின் மீது பேசக்கூடாது என 'வாய்ப்பூட்டுச் சட்டம்' போட்டது.", "content_en": "British regime imposed a Gagging Act banning public speeches."}, {"id": "S3", "content_ta": "வட இந்தியாவில் திலகருக்கும், தென்னிந்தியாவில் தேவருக்குமே இச்சட்டம் போடப்பட்டது.", "content_en": "Tilak in North and Thevar in South faced this Gagging Act."}, {"id": "S4", "content_ta": "வாய்ப்பூட்டுச் சட்டத்தால் தேவர் பொது வாழ்க்கையைக் கைவிட்டு ஒதுங்கினார்.", "content_en": "Thevar abandoned public life following the Gagging Act."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 53, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "gagging_act_thevar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-231", "schema_version": "1.0", "kind": "statements", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l1-vidudhalai-thirunaal", "chapter_id": null, "topic_id": "vidudhalai-vocab-meanings", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மீராவின் 'விடுதலைத் திருநாள்' கவிதையின் அருஞ்சொற்பொருள்கள் பற்றிய கூற்றுகளை ஆராய்க:\n1. 'சீவன்' என்னும் சொல் உயிர் என்ற பொருளைத் தருகிறது.\n2. 'சத்தியம்' என்னும் சொல் உண்மை என்ற பொருளைத் தருகிறது.\n3. 'ஆனந்த தரிசனம்' என்பது துன்பத்தை மறக்கும் நிலையைக் குறிக்கிறது.\n4. 'வையம்' என்பது உலகம் என்பதையும், 'மோகித்து' என்பது விரும்பி என்பதையும் குறிக்கின்றன.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 3 சரி; 2, 4 தவறு", "B": "கூற்றுகள் அனைத்தும் சரி", "C": "கூற்றுகள் 1, 2, 4 சரி; கூற்று 3 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "பாடநூல் விளக்கம்: 'ஆனந்த தரிசனம்' என்பது 'மகிழ்ச்சியான காட்சி' என்று பொருள்படும்; துன்பத்தை மறக்கும் நிலை என்பது தவறான விளக்கமாகும். எனவே கூற்று 3 தவறு."}, "en": {"blocks": [{"type": "text", "content": "Analyze the vocabulary meanings from Meera's 'Vidudhalai Thirunaal':\n1. 'Seevan' denotes living spirit or life (Uyir).\n2. 'Satyam' denotes truth (Unmai).\n3. 'Aanandha Dharisanam' denotes forgetting sorrows.\n4. 'Vaiyam' signifies world (Ulagam) and 'Moghithu' signifies desiring/cherishing with fondness.\nWhich statements are correct?"}], "options": {"A": "Statements 1 and 3 are correct; 2 and 4 are incorrect", "B": "All statements are correct", "C": "Statements 1, 2, and 4 are correct; Statement 3 is incorrect", "D": "Statements 2, 3, and 4 are correct; 1 is incorrect"}, "explanation": "Textbook explanation: 'Aanandha Dharisanam' specifically translates as 'joyous sight/vision' (Magizhchiyaana kaatchi). Statement 3 is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'சீவன்' என்னும் சொல் உயிர் என்ற பொருளைத் தருகிறது.", "content_en": "'Seevan' denotes living soul/life."}, {"id": "S2", "content_ta": "'சத்தியம்' என்னும் சொல் உண்மை என்ற பொருளைத் தருகிறது.", "content_en": "'Satyam' denotes truth."}, {"id": "S3", "content_ta": "'ஆனந்த தரிசனம்' என்பது துன்பத்தை மறக்கும் நிலையைக் குறிக்கிறது.", "content_en": "'Aanandha Dharisanam' denotes forgetting sorrows."}, {"id": "S4", "content_ta": "'வையம்' என்பது உலகம் என்பதையும், 'மோகித்து' என்பது விரும்பி என்பதையும் குறிக்கும்.", "content_en": "'Vaiyam' means world and 'Moghithu' means desiring."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 49, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "statement_analysis", "vidudhalai_vocabulary"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-232", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "thevar-education-interruption", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): பசும்பொன் முத்துராமலிங்கத்தேவர் இராமநாதபுரம் அரசு உயர்நிலைப் பள்ளியில் படித்துக் கொண்டிருந்தபோது அவரது பள்ளிப் படிப்பு தடைபட்டது.\nகாரணம் (R): ஆங்கிலேய அரசாங்கத்திற்கு எதிராக மாணவர் போராட்டம் நடத்தியதால் அவர் பள்ளியிலிருந்து நிரந்தரமாக நீக்கப்பட்டார்.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று மற்றும் காரணம் இரண்டும் சரி", "B": "கூற்று தவறு; காரணம் சரி", "C": "கூற்று, காரணம் இரண்டும் தவறு", "D": "கூற்று சரி; ஆனால் காரணம் தவறு"}, "explanation": "பாடநூல் விளக்கம்: இராமநாதபுரத்தில் படித்துக் கொண்டிருந்தபோது அந்நகரில் 'பிளேக் நோய்' பரவியதால் அவரது பள்ளிப் படிப்பு நின்றது; மாணவர் போராட்டத்தால் நீக்கப்பட்டார் எனக் கூறுவது தவறான காரணம் ஆகும். எனவே கூற்று சரி, காரணம் தவறு."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): Muthuramalingathevar's schooling at Ramanathapuram Government High School was interrupted and cut short.\nReason (R): He was permanently expelled from the school for orchestrating student agitation against the British Crown.\nSelect the correct option."}], "options": {"A": "Both Assertion and Reason are correct", "B": "Assertion is incorrect; Reason is correct", "C": "Both Assertion and Reason are incorrect", "D": "Assertion is correct; but Reason is incorrect"}, "explanation": "Textbook explanation: His formal schooling was halted due to an outbreak of the deadly bubonic plague in Ramanathapuram, not student unrest. Assertion is true; Reason is false."}}, "question_data": {"assertion": "பசும்பொன் முத்துராமலிங்கத்தேவர் இராமநாதபுரம் அரசு உயர்நிலைப் பள்ளியில் படித்துக் கொண்டிருந்தபோது அவரது பள்ளிப் படிப்பு தடைபட்டது.", "reason": "ஆங்கிலேய அரசாங்கத்திற்கு எதிராக மாணவர் போராட்டம் நடத்தியதால் அவர் பள்ளியிலிருந்து நிரந்தரமாக நீக்கப்பட்டார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "thevar_education"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-233", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "sayalgudi-oratory-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): சாயல்குடியில் நடைபெற்ற பொதுக்கூட்டத்தில் முத்துராமலிங்கத்தேவர் விவேகானந்தரின் பெருமை பற்றி மூன்று மணி நேரம் ஆற்றிய உரை அனைவரையும் வியப்பில் ஆழ்த்தியது.\nகாரணம் (R): அதுவே தேவரின் முதல் மேடைப் பேச்சாக இருந்தபோதிலும், ஆழ்ந்த புலமையோடும் சிங்க கர்ஜனை போன்ற கம்பீரக் குரலோடும் மிகச் சிறந்த கருத்துகளை அவர் முன்வைத்தார்.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றுக்குச் சரியான விளக்கம் ஆகும்", "B": "கூற்று மற்றும் காரணம் இரண்டும் சரி; ஆனால் காரணம் கூற்றுக்குச் சரியான விளக்கமல்ல", "C": "கூற்று சரி; ஆனால் காரணம் தவறு", "D": "கூற்று தவறு; ஆனால் காரணம் சரி"}, "explanation": "பாடநூல் விளக்கம்: சாயல்குடியில் விவேகானந்தர் குறித்து ஆற்றிய முதல் பேச்சும், அப்பேச்சின் கம்பீரமும் காமராசர் உள்ளிட்ட பலரையும் ஈர்த்ததும் பாடநூலின்படி முழுமையாகச் சரியானது; தகுந்த விளக்கமாகும்."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): At Sayalgudi public meeting, Thevar's 3-hour spellbinding oration on Swami Vivekananda mesmerized the audience.\nReason (R): Though it was his maiden public address, he delivered profound insights with erudition and a lion-like commanding voice.\nSelect the correct option."}], "options": {"A": "Both Assertion and Reason are correct; Reason correctly explains Assertion", "B": "Both Assertion and Reason are correct; but Reason does not explain Assertion", "C": "Assertion is correct; Reason is incorrect", "D": "Assertion is incorrect; Reason is correct"}, "explanation": "Textbook explanation: Both the maiden address at Sayalgudi and its profound impact on listeners including Kamarajar are authentic and coherent."}}, "question_data": {"assertion": "சாயல்குடியில் நடைபெற்ற பொதுக்கூட்டத்தில் முத்துராமலிங்கத்தேவர் விவேகானந்தரின் பெருமை பற்றி மூன்று மணி நேரம் ஆற்றிய உரை அனைவரையும் வியப்பில் ஆழ்த்தியது.", "reason": "அதுவே தேவரின் முதல் மேடைப் பேச்சாக இருந்தபோதிலும், ஆழ்ந்த புலமையோடும் சிங்க கர்ஜனை போன்ற கம்பீரக் குரலோடும் மிகச் சிறந்த கருத்துகளை அவர் முன்வைத்தார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "thevar_sayalgudi_speech"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-234", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "thiruvika-dhesiyam-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): தமிழ்த் தென்றல் திரு.வி. கலியாணசுந்தரனார் பசும்பொன் முத்துராமலிங்கத்தேவரைத் 'தேசியம் காத்த செம்மல்' என்று புகழ்ந்து பாராட்டினார்.\nகாரணம் (R): தேவர் தேசியத்தையும் தெய்வீகத்தையும் தமது இரு கண்களாகப் பாவித்து, நாட்டு விடுதலைக்கும் ஆன்மிக அறநெறிக்கும் தம் வாழ்நாள் முழுவதையும் அர்ப்பணித்தார்.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று சரி; காரணம் தவறு", "B": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றுக்குச் சரியான விளக்கமாகும்", "C": "கூற்று தவறு; காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் விளக்கம்: தேவர் தேசியத்தையும் தெய்வீகத்தையும் இரு கண்களாகக் கருதி வாழ்ந்தமையால் அவரைத் திரு.வி.க 'தேசியம் காத்த செம்மல்' எனப் போற்றினார். கூற்று, காரணம் இரண்டும் சரி, சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): Thiru. Vi. Kalyanasundaranar acclaimed Pasumpon Muthuramalingathevar as 'Dhesiyam Kaattha Semmal'.\nReason (R): Thevar treated Nationalism and Divinity as his two eyes, consecrating his life to freedom struggle and spiritual rectitude.\nSelect the correct option."}], "options": {"A": "Assertion is correct; Reason is incorrect", "B": "Both Assertion and Reason are correct; Reason is the correct explanation", "C": "Assertion is incorrect; Reason is correct", "D": "Both Assertion and Reason are incorrect"}, "explanation": "Textbook explanation: Thevar regarded nationalism and divinity as his two eyes; Thiru.Vi.Ka honored this synthesis with the title 'Dhesiyam Kaattha Semmal'. Both are correct."}}, "question_data": {"assertion": "தமிழ்த் தென்றல் திரு.வி. கலியாணசுந்தரனார் பசும்பொன் முத்துராமலிங்கத்தேவரைத் 'தேசியம் காத்த செம்மல்' என்று புகழ்ந்து பாராட்டினார்.", "reason": "தேவர் தேசியத்தையும் தெய்வீகத்தையும் தமது இரு கண்களாகப் பாவித்து, நாட்டு விடுதலைக்கும் ஆன்மிக அறநெறிக்கும் தம் வாழ்நாள் முழுவதையும் அர்ப்பணித்தார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 53, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "dhesiyam_kaattha_semmal"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-235", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l1-vidudhalai-thirunaal", "chapter_id": null, "topic_id": "three-hundred-years-british-misconception", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): மீராவின் கவிதையில் 'முந்நூறு ஆண்டாய் முடிசூடி ஆண்ட மன்னர் மன்னனின் கொற்றம் வீழ்ந்தது' என்று மொகலாயப் பேரரசு வீழ்ந்ததைக் குறிப்பிடுகிறார்.\nகாரணம் (R): 1947 ஆகஸ்ட் 15-ல் மொகலாய மன்னர்களிடமிருந்து இந்திய நாடு விடுதலை பெற்றது.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி", "B": "கூற்று சரி; காரணம் தவறு", "C": "கூற்று தவறு; காரணமும் முற்றிலும் தவறானது", "D": "கூற்று சரி; சரியான விளக்கம்"}, "explanation": "பாடநூல் விளக்கம்: 'முந்நூறு ஆண்டாய் முடிசூடி ஆண்ட' என்பது பிரிட்டிஷ் ஆங்கிலேயர்களின் காலனி ஆதிக்கத்தைக் குறிக்கிறதே தவிர மொகலாயர்களை அல்ல. 1947 ஆகஸ்ட் 15-ல் பிரிட்டிஷ் ஆதிக்கத்திலிருந்து இந்தியா விடுதலை பெற்றது. எனவே கூற்றும் காரணமும் முற்றிலும் தவறானவை."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): In Meera's verse, 'Munnuru aandaai mudisoodi aanda...' celebrates the fall of the Mughal Empire.\nReason (R): On August 15, 1947, India gained political freedom from the Mughal emperors.\nSelect the correct option."}], "options": {"A": "Both Assertion and Reason are correct", "B": "Assertion is correct; Reason is incorrect", "C": "Assertion is incorrect; Reason is also completely false", "D": "Assertion is correct; correct explanation"}, "explanation": "Textbook explanation: The 300 years refers to British colonial imperial rule over India. Freedom in 1947 was from Britain, not Mughals. Both are false."}}, "question_data": {"assertion": "மீராவின் கவிதையில் 'முந்நூறு ஆண்டாய் முடிசூடி ஆண்ட மன்னர் மன்னனின் கொற்றம் வீழ்ந்தது' என்று மொகலாயப் பேரரசு வீழ்ந்ததைக் குறிப்பிடுகிறார்.", "reason": "1947 ஆகஸ்ட் 15-ல் மொகலாய மன்னர்களிடமிருந்து இந்திய நாடு விடுதலை பெற்றது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 48, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "vidudhalai_historical_context"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-236", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "thevar-speech-ban-north-south", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): விடுதலைப் போராட்ட காலத்தில் ஆங்கிலேய அரசாங்கத்தால் தென்னிந்தியாவில் பசும்பொன் முத்துராமலிங்கத்தேவருக்கு வாய்ப்பூட்டுச் சட்டம் விதிக்கப்பட்டது.\nகாரணம் (R): வட இந்தியாவில் சுபாஷ் சந்திரபோஸுக்கும், தென்னிந்தியாவில் முத்துராமலிங்கத்தேவருக்கும் இச்சட்டம் போடப்பட்டது என்று வரலாற்று ஆவணங்கள் கூறுகின்றன.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று தவறு; காரணம் சரி", "B": "கூற்று, காரணம் இரண்டும் சரி", "C": "கூற்று, காரணம் இரண்டும் தவறு", "D": "கூற்று சரி; ஆனால் காரணம் தவறு"}, "explanation": "பாடநூல் விளக்கம்: வட இந்தியாவில் இச்சட்டம் விதிக்கப்பட்டது 'பாலகங்காதர திலகருக்கு' ஆகும் (நேதாஜி சுபாஷ் சந்திரபோஸுக்கு அல்ல). எனவே கூற்று சரி, காரணம் தவறு."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): During the freedom struggle, the British colonial regime enforced a Gagging Act against Pasumpon Muthuramalingathevar in South India.\nReason (R): Historical records establish that this Gagging Act was imposed on Subhas Chandra Bose in North India and Muthuramalingathevar in South India.\nSelect the correct option."}], "options": {"A": "Assertion is incorrect; Reason is correct", "B": "Both Assertion and Reason are correct", "C": "Both Assertion and Reason are incorrect", "D": "Assertion is correct; but Reason is incorrect"}, "explanation": "Textbook explanation: In North India, the Gagging Act was imposed on Bal Gangadhar Tilak, not Subhas Chandra Bose. Assertion is true; Reason is false."}}, "question_data": {"assertion": "விடுதலைப் போராட்ட காலத்தில் ஆங்கிலேய அரசாங்கத்தால் தென்னிந்தியாவில் பசும்பொன் முத்துராமலிங்கத்தேவருக்கு வாய்ப்பூட்டுச் சட்டம் விதிக்கப்பட்டது.", "reason": "வட இந்தியாவில் சுபாஷ் சந்திரபோஸுக்கும், தென்னிந்தியாவில் முத்துராமலிங்கத்தேவருக்கும் இச்சட்டம் போடப்பட்டது என்று வரலாற்று ஆவணங்கள் கூறுகின்றன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 53, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "thevar_tilak_gagging_act"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-237", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "periyar-suddha-thyagi-reasoning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): தந்தை பெரியார் பசும்பொன் முத்துராமலிங்கத்தேவரைப் பாராட்டும்போது 'சுத்தத் தியாகி' என்று மனமாரப் போற்றினார்.\nகாரணம் (R): தேவர் தாம் கொண்ட கொள்கையில் எவ்வித சமரசமும் செய்து கொள்ளாமல், உள்ளொன்று வைத்துப் புறமொன்று பேசாமல் பட்டவர்த்தனமாக உண்மையை உரைத்துத் தியாக வாழ்க்கை வாழ்ந்தார்.\nசரியான விடையைத் தேர்ந்தெடுக்க."}], "options": {"A": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றுக்குச் சரியான விளக்கம் ஆகும்", "B": "கூற்று சரி; ஆனால் காரணம் தவறு", "C": "கூற்று தவறு; காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் விளக்கம்: பெரியார் கூறிய 'சுத்தத் தியாகி' பாராட்டும், உண்மையை மறைக்காமல் பட்டவர்த்தனமாகச் சொல்லிவிடும் மனிதர் என்ற காரண விளக்கமும் பாடநூலில் அப்படியே இடம்பெற்றுள்ளன. கூற்றும் காரணமும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Evaluate the following Assertion and Reason:\nAssertion (A): Thanthai Periyar wholeheartedly lauded Pasumpon Muthuramalingathevar as a 'Suddha Thyaagi' (Pure Martyr/Renunciant).\nReason (R): Thevar never compromised his convictions, harbored zero duplicity, and boldly proclaimed unvarnished truth, leading a life of pure sacrifice.\nSelect the correct option."}], "options": {"A": "Both Assertion and Reason are correct; Reason correctly explains Assertion", "B": "Assertion is correct; Reason is incorrect", "C": "Assertion is incorrect; Reason is correct", "D": "Both Assertion and Reason are incorrect"}, "explanation": "Textbook explanation: Periyar's tribute of 'Suddha Thyaagi' and the rationale of fearless uncompromised truthfulness are explicitly verified in the textbook."}}, "question_data": {"assertion": "தந்தை பெரியார் பசும்பொன் முத்துராமலிங்கத்தேவரைப் பாராட்டும்போது 'சுத்தத் தியாகி' என்று மனமாரப் போற்றினார்.", "reason": "தேவர் தாம் கொண்ட கொள்கையில் எவ்வித சமரசமும் செய்து கொள்ளாமல், உள்ளொன்று வைத்துப் புறமொன்று பேசாமல் பட்டவர்த்தனமாக உண்மையை உரைத்துத் தியாக வாழ்க்கை வாழ்ந்தார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 53, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "periyar_thevar_praise"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t1-u3-238", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l2-thevar", "chapter_id": null, "topic_id": "leaders-praise-thevar-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முத்துராமலிங்கத்தேவரைப் பாராட்டிய சான்றோர்களையும் அவர்களின் புகழுரைகளையும் பொருத்துக:\nபட்டியல் I (தலைவர்):\nL1. தந்தை பெரியார்\nL2. பேரறிஞர் அண்ணா\nL3. திரு.வி. கலியாணசுந்தரனார்\nL4. காமராசர்\nபட்டியல் II (புகழுரை):\nR1. சுத்தத் தியாகி / உண்மையை மறைக்காமல் உரைப்பவர்\nR2. தென்னாட்டுச் சிங்கம் / உதட்டிலிருந்து அல்ல, உள்ளத்திலிருந்து வரும் பேச்சு\nR3. தேசியம் காத்த செம்மல்\nR4. இதுபோன்ற ஒரு பேச்சை இதுவரை நான் கேட்டதே இல்லை (சாயல்குடி உரை)"}], "options": {"A": "L1-R2, L2-R1, L3-R4, L4-R3", "B": "L1-R1, L2-R2, L3-R3, L4-R4", "C": "L1-R3, L2-R4, L3-R1, L4-R2", "D": "L1-R4, L2-R3, L3-R2, L4-R1"}, "explanation": "பாடநூல் விளக்கம்: பெரியார் = சுத்தத் தியாகி (R1); அண்ணா = உள்ளத்திலிருந்து வரும் பேச்சு (R2); திரு.வி.க = தேசியம் காத்த செம்மல் (R3); காமராசர் = சாயல்குடி பேச்சு வியப்பு (R4). வரிசை: 1 - 2 - 3 - 4."}, "en": {"blocks": [{"type": "text", "content": "Match the leaders with their memorable encomiums on Muthuramalingathevar:\nList I (Leader):\nL1. Thanthai Periyar\nL2. Arignar Anna\nL3. Thiru. Vi. Kalyanasundaranar\nL4. Kamarajar\nList II (Tribute):\nR1. Suddha Thyaagi (Pure Martyr) who speaks unvarnished truth\nR2. Southern Lion whose words flow from the heart, not lips\nR3. Dhesiyam Kaattha Semmal (Guardian of Nationalism)\nR4. Never have I heard such a brilliant speech (Sayalgudi address)"}], "options": {"A": "L1-R2, L2-R1, L3-R4, L4-R3", "B": "L1-R1, L2-R2, L3-R3, L4-R4", "C": "L1-R3, L2-R4, L3-R1, L4-R2", "D": "L1-R4, L2-R3, L3-R2, L4-R1"}, "explanation": "Textbook match: Periyar=Suddha Thyaagi, Anna=Words from heart, Thiru.Vi.Ka=Dhesiyam Kaattha Semmal, Kamarajar=Sayalgudi praise."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "தந்தை பெரியார்", "content_en": "Thanthai Periyar"}, {"id": "L2", "content_ta": "பேரறிஞர் அண்ணா", "content_en": "Arignar Anna"}, {"id": "L3", "content_ta": "திரு.வி. கலியாணசுந்தரனார்", "content_en": "Thiru. Vi. Ka"}, {"id": "L4", "content_ta": "காமராசர்", "content_en": "Kamarajar"}], "right": [{"id": "R1", "content_ta": "சுத்தத் தியாகி / உண்மையை மறைக்காமல் உரைப்பவர்", "content_en": "Suddha Thyaagi"}, {"id": "R2", "content_ta": "தென்னாட்டுச் சிங்கம் / உள்ளத்திலிருந்து வரும் பேச்சு", "content_en": "Southern Lion speaking from heart"}, {"id": "R3", "content_ta": "தேசியம் காத்த செம்மல்", "content_en": "Dhesiyam Kaattha Semmal"}, {"id": "R4", "content_ta": "இதுபோன்ற ஒரு பேச்சை நான் கேட்டதே இல்லை", "content_en": "Never heard such a speech"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 53, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "match", "thevar_tributes_match"], "langua