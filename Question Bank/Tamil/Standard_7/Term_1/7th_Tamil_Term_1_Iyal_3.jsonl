{"id": "7th-t1-u3-245", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l1-vidudhalai-thirunaal", "chapter_id": null, "topic_id": "sandhi-vaaniloru", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சேர்த்தெழுதுக:\n'வானில் + ஒரு' என்பது புணர்ச்சி விதிகளின்படி எவ்வாறு புணரும்?"}], "options": {"A": "வானிலொரு", "B": "வானில்ஒரு", "C": "வானொரு", "D": "வானிலுரு"}, "explanation": "இலக்கண விதி: 'உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே' என்ற விதிப்படி ல் + ஒ = 'லொ' என இணைந்து 'வானிலொரு' எனப் புணரும்."}, "en": {"blocks": [{"type": "text", "content": "Combine 'Vaanil + Oru' according to Tamil grammatical sandhi rules:"}], "options": {"A": "Vaaniloru (வானிலொரு)", "B": "Vaanil-oru", "C": "Vaanoru", "D": "Vaaniluru"}, "explanation": "Grammar rule: Consonant 'l' merges naturally with incoming vowel 'o' into 'lo', forming 'Vaaniloru'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 50, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam