{"id": "7th-t1-u3-321", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-u3-naadu-samoogam-arasu", "lesson_id": "ta-l4-orezhuthu-oru-mozhi", "chapter_id": null, "topic_id": "ar-orezhuthu-meaning-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று, காரணத்தை ஆராய்ந்து சரியான விடையைத் தேர்வு செய்க:\nகூற்று (A): ஓரெழுத்து ஒருமொழியில் 'யா' என்பது 'அகலம்' என்ற பொருளையும், 'மா' என்பது 'மாமரம்/பெரிய' என்ற பொருளையும் குறிக்கும்.\nகாரணம் (R): நன்னூல் ஆசிரியர் பவணந்தி முனிவர் வகுத்த 42 ஓரெழுத்து ஒருமொழிகளுள் 40 குறில் எழுத்துகளும் 2 நெடில் எழுத்துகளும் அடங்கும்."}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "B": "கூற்று (A), காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் சரியான விளக்கம் அல்ல", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "D": "கூற்று (A), காரணம் (R) இரண்டும் சரி; மேலும் காரணம் கூற்றை விளக்குகிறது"}, "explanation": "பாடநூல் குறிப்பு: காரணம் (R) தவறானது; ஏனெனில் நன்னூலின்படி 40 நெடில் எழுத்துகளும் 2 குறில் எழுத்துகளும் (நொ, து) மட்டுமே உள்ளன. கூற்று (A) சரியானது ('யா' - அகலம், 'மா' - மாமரம்)."}, "en": {"blocks": [{"type": "text", "content": "Analyze the assertion and reason and select the correct option:\nAssertion (A): In single-letter words, 'Yaa' signifies 'width/broad' and 'Maa' signifies 'mango tree/great'.\nReason (R): Among the 42 single-letter words codified by Pavanandhi Munivar in Nannool, 40 are short vowels and 2 are long vowels."}], "options": {"A": "Assertion (A) is correct, but Reason (R) is false", "B": "Both (A) and (R) are correct, but (R) is not the correct explanation", "C": "Assertion (A) is false, but Reason (R) is correct", "D": "Both (A) and (R) are correct, and (R) is the correct explanation of (A)"}, "explanation": "Textbook fact: Reason (R) is incorrect because there are 40 long letters and only 2 short letters. Assertion (A) is correct ('Yaa' = width, 'Maa' = mango tree)."}}, "question_data": {"assertion": "ஓரெழுத்து ஒருமொழியில் 'யா' என்பது 'அகலம்' என்ற பொருளையும், 'மா' என்பது 'மாமரம்/பெரிய' என்ற பொருளையும் குறிக்கும்.", "reason": "நன்னூல் ஆசிரியர் வகுத்த 42 ஓரெழுத்து ஒருமொழிகளுள் 40 குறில் எழுத்துகளும் 2 நெடில் எழுத்துகளும் அடங்கும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "1", "edition": "2024-2025", "page": 60, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["7th_tamil", "assertion_reason", "orezhuthu_meaning"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
