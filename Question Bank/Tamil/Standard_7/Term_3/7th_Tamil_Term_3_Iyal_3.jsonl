{"id": "7th-t3-u3-q356", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u3-maanudam", "lesson_id": "lesson-15-thirukkural-part2", "chapter_id": null, "topic_id": "ta-t3-u3-sandhi-theeyechem", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'தீ + எச்சம்' என்பதனைச் சேர்த்து எழுதக் கிடைக்கும் சொல் மற்றும் அதில் அமைந்துள்ள உடம்படுமெய் விதி யாது?"}], "options": {"A": "தீவெச்சம் - வவ்வுடம்படுமெய் விதி", "B": "தீஎச்சம் - இயல்புப் புணர்ச்சி", "C": "தீத்தெச்சம் - வல்லின மிகல் விதி", "D": "தீயெச்சம் - இ ஈ ஐ வழி யவ்வும்"}, "explanation": "'தீ + எச்சம்' = தீயெச்சம். நிலைமொழி ஈற்றில் 'ஈ' என்னும் ஈகார உயிர் இருப்பதால், வருமொழி முதலில் உள்ள உயிரோடு உடன்பட 'ய'கர உடம்படுமெய் தோன்றிற்று (விதி: இ ஈ ஐ வழி யவ்வும் - தீ + ய் + எச்சம் = தீயெச்சம்)."}, "en": {"blocks": [{"type": "text", "content": "What is the combined form of 'Thee + echam' and which glide (udampadumey) sandhi rule applies?"}], "options": {"A": "Theevecham - Vavvudampadumey rule", "B": "Thee-echam - Normal sandhi", "C": "Theethecham - Plosive doubling rule", "D": "Theeyechem - I Ee Ai vazhi yavvum"}, "explanation": "'Thee + echam' combines as 'Theeyechem'. As the first word ends in long vowel 'ee', the palatal glide 'y' appears ('I Ee Ai vazhi yavvum')."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source":