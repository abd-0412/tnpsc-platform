{"id": "7th-t3-u3-q359", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u3-maanudam", "lesson_id": "lesson-15-thirukkural-part2", "chapter_id": null, "topic_id": "ta-t3-u3-kolkurumbu-grammar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளில் வரும் 'கொல்குறும்பு' என்ற சொல்லின் இலக்கணக் குறிப்பைக் கண்டறிக:"}], "options": {"A": "பண்புத்தொகை", "B": "உவமைத்தொகை", "C": "வினைத்தொகை", "D": "உம்மைத்தொகை"}, "explanation": "'கொல்குறும்பு' - கொன்ற குறும்பு, கொல்கின்ற குறும்பு, கொல்லும் குறும்பு என முக்காலத்திற்கும் பொருந்தும் வகையில் காலம் காட்டும் இடைநிலையும் விகுதியும் மறைந்து நின்று பெயர்ச்சொல்லோடு (குறும்பு) இணைந்ததால் இது 'வினைத்தொகை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the grammatical classification of the phrase 'Kolkurumbu' in Thirukkural:"}], "options": {"A": "Panbu-thogai", "B": "Uvamai-thogai", "C": "Vinai-thogai", "D": "Ummai-thogai"}, "explanation": "'Kolkurumbu' combines the verbal root 'kol' with noun 'kurumbu' spanning all three tenses without overt tense markers, forming a Vinai-thogai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "editi