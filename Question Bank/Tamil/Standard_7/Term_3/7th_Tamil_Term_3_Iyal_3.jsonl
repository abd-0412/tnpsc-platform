{"id": "7th-t3-u3-q357", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-15-thirukkural-part2", "chapter_id": null, "topic_id": "ta-t3-u3-sandhi-aniyenba", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'அணியென்ப' என்னும் சொல்லைச் சரியாகப் பிரித்தெழுதக் கிடைக்கும் வடிவம் எது?"}], "options": {"A": "அணி + என்ப", "B": "அணிய + என்ப", "C": "அண் + என்ப", "D": "அணி + யென்ப"}, "explanation": "பாடநூல் குறள் தொடர்: 'அணியென்ப நாட்டிற்கிவ் வைந்து' - இதில் 'அணியென்ப' என்னும் சொல் 'அணி + என்ப' எனப் பிரியும் (விதி: இ ஈ ஐ வழி யவ்வும் - அணி + ய் + என்ப = அணியென்ப)."}, "en": {"blocks": [{"type": "text", "content": "Which is the correct splitting of the compound word 'Aniyenba'?"}], "options": {"A": "Ani + enba", "B": "Aniya + enba", "C": "Ann + enba", "D": "Ani + yenba"}, "explanation": "'Aniyenba' splits into 'Ani + enba' with the palatal glide 'y' linking the vowels."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 68, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_y