{"id": "7th-t3-u3-q328", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u3-maanudam", "lesson_id": "lesson-14-vina-vidai", "chapter_id": null, "topic_id": "ta-t3-u3-vidai-application-identification", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'உனக்கு நீச்சல் தெரியுமா?' என்று நண்பன் கேட்டதற்கு, 'எனக்கு ஓடத் தெரியும்' என்று விடையளித்தால், அவ்விடை எவ்வகையான விடையாகும்?"}], "options": {"A": "மறை விடை", "B": "சுட்டு விடை", "C": "ஏவல் விடை", "D": "இனமொழி விடை"}, "explanation": "வினாவிற்கு விடையாக அதற்கு இணையான மற்றொரு விளையாட்டுச் செயலைக் கூறியுள்ளதால் இது 'இனமொழி விடை' ஆகும் (எ.கா: கதை தெரியுமா என்ற வினாவிற்குக் கட்டுரை தெரியும் எனக் கூறுவது போல)."}, "en": {"blocks": [{"type": "text", "content": "When a friend asks 'Do you know how to swim?' and one answers 'I know how to run', what kind of answer is it?"}], "options": {"A": "Marai Vidai", "B": "Suttu Vidai", "C": "Eeval Vidai", "D": "Inamozhi Vidai"}, "explanation": "Replying with an analogous sport activity (running) when asked about swimming is Inamozhi Vidai (cognate answer)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 60, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["grammar_application", "inamozhi_vidai", "grammar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
