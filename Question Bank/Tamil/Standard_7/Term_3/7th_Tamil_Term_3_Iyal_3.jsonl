{"id": "7th-t3-u3-q358", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u3-maanudam", "lesson_id": "lesson-15-thirukkural-part2", "chapter_id": null, "topic_id": "ta-t3-u3-metrics-thirukkural", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'திருக்குறள்' என்ற சொல்லின் மொத்த மாத்திரை அளவைக் கணக்கிடுக:"}], "options": {"A": "4.5 மாத்திரைகள்", "B": "5.0 மாத்திரைகள்", "C": "5.5 மாத்திரைகள்", "D": "6.0 மாத்திரைகள்"}, "explanation": "மாத்திரை கணக்கீடு:\nதி (குறில்) = 1\nரு (குறில்) = 1\nக் (மெய்) = 0.5\nகு (குறில்) = 1\nற (குறில்) = 1\nள் (மெய்) = 0.5\nகூடுதல் = 1 + 1 + 0.5 + 1 + 1 + 0.5 = 5.0 மாத்திரைகள்."}, "en": {"blocks": [{"type": "text", "content": "Calculate the total Maathirai count for the word 'Thirukkural':"}], "options": {"A": "4.5 Maathirais", "B": "5.0 Maathirais", "C": "5.5 Maathirais", "D": "6.0 Maathirais"}, "explanation": "Metrics: Thi (1) + ru (1) + k (0.5) + ku (1) + ra (1) + l (0.5) = 5.0 Maathirais."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 67, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "p