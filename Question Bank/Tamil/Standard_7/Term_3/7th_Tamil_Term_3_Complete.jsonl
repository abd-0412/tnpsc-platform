{"id": "7th-t3-u2-q223", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-09-thirukkural", "chapter_id": null, "topic_id": "ta-t3-u2-pirappokkum-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மக்கள் அனைவரும் எதனால் ஒத்த இயல்புடையவர்கள் என்று திருவள்ளுவர் கூறுகிறார்?"}], "options": {"A": "குணத்தால்", "B": "பணத்தால்", "C": "பிறப்பால்", "D": "நிறத்தால்"}, "explanation": "பாடநூல் பக்கம் 44 மதிப்பீடு வினா 2: 'மக்கள் அனைவரும் பிறப்பால் ஒத்த இயல்புடையவர்கள்' ('பிறப்பொக்கும் எல்லா உயிர்க்கும்')."}, "en": {"blocks": [{"type": "text", "content": "According to Thiruvalluvar, by what are all human beings identical in natural essence?"}], "options": {"A": "By character", "B": "By wealth", "C": "By birth", "D": "By color"}, "explanation": "Page 44 evaluation Q2: 'All human beings share an equal essence by birth' ('Pirappokkum ella uyirkkum')."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 44, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "