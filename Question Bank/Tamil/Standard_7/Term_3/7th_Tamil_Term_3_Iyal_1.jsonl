{"id": "7th-t3-u1-q048", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-02-tirunelveli", "chapter_id": null, "topic_id": "ta-t3-u1-grammar-maathirai-porunai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பொருநை' என்னும் ஆற்றின் வரலாற்றுப் பெயரின் மொத்த மாத்திரை அளவைக் கணக்கிடுக:"}], "options": {"A": "4 மாத்திரை", "B": "3.5 மாத்திரை", "C": "3 மாத்திரை", "D": "2.5 மாத்திரை"}, "explanation": "'பொருநை' மாத்திரை பகுப்பாய்வு:\nபொ (குறில்) = 1 மாத்திரை\nரு (குறில்) = 1 மாத்திரை\nநை (ஐகார நெடில்) = 2 மாத்திரை\nமொத்தம் = 1 + 1 + 2 = 4 மாத்திரை."}, "en": {"blocks": [{"type": "text", "content": "Calculate the total prosodic metric count (Maathirai) for the historic river name 'Porunai':"}], "options": {"A": "4 Maathirai", "B": "3.5 Maathirai", "C": "3 Maathirai", "D": "2.5 Maathirai"}, "explanation": "Metrics for 'Porunai': Po (short = 1) + ru (short = 1) + nai (diphthong long = 2) = 4 Maathirai. Key A is correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 4, "chapter": null, "section": null, "reference": null, "url": null