{"id": "7th-t3-u1-q105", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-04-vazhakku", "chapter_id": null, "topic_id": "ta-t3-u1-grammar-identify-vazhakku-type", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் சொல்லாட்சிகளில் 'இலக்கணப் போலி' அமைந்துள்ள தொடர் எது?"}], "options": {"A": "குழந்தை வெளியே சென்று விளையாடியது", "B": "கோயம்புத்தூரில் நெசவுத் தொழில் செழித்தது", "C": "செத்தார் என்று கூறாமல் இயற்கை எய்தினார் எனல்", "D": "வீட்டின் முன்றிலில் அமர்ந்து பாணர் பாடினர்"}, "explanation": "பாடநூல் பக்கம் 14: 'முன்றில்' (இல்முன் என்பதன் இலக்கணப் போலி) அமைந்துள்ள தொடர் D ஆகும். B = மரூஉ; C = மங்கலம்."}, "en": {"blocks": [{"type": "text", "content": "Identify the phrase containing an Ilakkana Poli:"}], "options": {"A": "The child went outside to play", "B": "Textile industry thrived in Coimbatore", "C": "Saying passed away instead of died", "D": "Minstrels sat in the front porch (Mundril) and sang"}, "explanation": "'Mundril' (transposition of Ilmun) is an Ilakkana Poli. Option D contains Mundril."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edi