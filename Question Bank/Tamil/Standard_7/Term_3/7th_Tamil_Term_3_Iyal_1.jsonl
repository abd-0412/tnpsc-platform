// ==============================================================================
// 7-ஆம் வகுப்பு தமிழ் - பருவம் 3 - இயல் 1: நாகரிகம், பண்பாடு, தொழில், வணிகம் (நயத்தகு நாகரிகம்) (மொத்த வினாக்கள்: 112)
// ==============================================================================
// ==============================================================================
// பாடம் 1: விருந்தோம்பல் (கவிதைப்பேழை - முன்றுறை அரையனார் / பழமொழி நானூறு) [Q001 - Q028]
// முன்றுறை அரையனார் (கி.பி. 4-ஆம் நூற்றாண்டு, சமணர்), பழமொழி நானூறு, 400 வெண்பாக்கள், பதினெண்கீழ்க்கணக்கு அறநூல், 'ஒன்றுறா முன்றில் இல்' பழமொழி, பாரி மகளிர் அங்கவை/சங்கவை, உலைநீரில் பொன் இட்டுப் பாணர்க்கு உணவளித்தல், முன்றில் (இல்முன் - இலக்கணப் போலி), மாரி/மடமகள்/புகாவா/நல்கினாள் சொல்லும் பொருளும்
// ==============================================================================
{"id": "7th-t3-u1-q001", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-01-virundhombal", "chapter_id": null, "topic_id": "ta-t3-u1-author-profile-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முன்றுறை அரையனார் மற்றும் பழமொழி நானூறு பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. பழமொழி நானூறு நூலின் ஆசிரியர் முன்றுறை அரையனார்.\n2. இவர் கி.பி. நான்காம் நூற்றாண்டைச் சேர்ந்தவர்.\n3. கடவுள் வாழ்த்துப் பாடல் மூலம் இவர் சமண சமயத்தவர் என அறியமுடிகிறது.\n4. இந்நூல் பதினெண்கீழ்க்கணக்கு நூல்களுள் ஒன்றாகும்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 2 மட்டுமே சரி", "C": "1, 3, 4 மட்டுமே சரி", "D": "2, 3 மட்டுமே சரி"}, "explanation": "பாடநூல் பக்கம் 3 'நூல் வெளி': முன்றுறை அரையனார் கி.பி. 4-ஆம் நூற்றாண்டு; கடவுள் வாழ்த்து மூலம் சமணர் என அறியலாம்; பழமொழி நானூறு பதினெண்கீழ்க்கணக்கு நூல். நான்கு கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Mundrurai Araiyanaar and Pazhamozhi Naanooru:\n1. The author of Pazhamozhi Naanooru is Mundrurai Araiyanaar.\n2. He belongs to the 4th century CE.\n3. His invocation song shows he was a Jain.\n4. This work is one of the Pathinenkeelkanakku texts.\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1 and 2 only correct", "C": "1, 3, and 4 only correct", "D": "2 and 3 only correct"}, "explanation": "Textbook page 3 'Nool Veli' verifies all 4 facts: 4th century CE, Jain affiliation via invocation, author Mundrurai Araiyanaar, and Pathinenkeelkanakku classification. All are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பழமொழி நானூறு நூலின் ஆசிரியர் முன்றுறை அரையனார் ஆவார்.", "content_en": "The author of Pazhamozhi Naanooru is Mundrurai Araiyanaar."}, {"id": "S2", "content_ta": "இவர் கி.பி. நான்காம் நூற்றாண்டைச் சேர்ந்தவர் எனக் கருதப்படுகிறார்.", "content_en": "He is believed to belong to the 4th century CE."}, {"id": "S3", "content_ta": "பழமொழி நானூறு நூலின் கடவுள் வாழ்த்துப் பாடல் மூலம் இவர் சமண சமயத்தைச் சார்ந்தவர் என அறியலாம்.", "content_en": "From the invocation song of Pazhamozhi Naanooru, it is known that he belonged to Jainism."}, {"id": "S4", "content_ta": "பழமொழி நானூறு பதினெண்கீழ்க்கணக்கு நூல்களுள் ஒன்றாகும்.", "content_en": "Pazhamozhi Naanooru is one of the Pathinenkeelkanakku anthologies."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["virundhombal", "author_profile", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q002", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-01-virundhombal", "chapter_id": null, "topic_id": "ta-t3-u1-text-structure-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழமொழி நானூறு நூலின் கட்டமைப்பு பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. இந்நூல் நானூறு வெண்பாக்களைக் கொண்டது.\n2. ஒவ்வொரு பாடலின் இறுதியிலும் ஒரு பழமொழி இடம்பெறும்.\n3. பாடப்பகுதிப் பாடலின் இறுதி அடி 'ஒன்றுறா முன்றில் இல்' என்ற பழமொழியைக் கொண்டுள்ளது.\n4. இந்நூலின் பாடல்கள் ஆசிரியப்பா யாப்பினால் அமைந்தவை.\nஇவற்றுள் தவறான கூற்று எது?"}], "options": {"A": "கூற்று 2 தவறு", "B": "கூற்று 4 தவறு", "C": "கூற்று 1 தவறு", "D": "கூற்று 3 தவறு"}, "explanation": "பாடநூல் பக்கம் 3: பழமொழி நானூறு 400 'வெண்பாக்களால்' ஆகிய நூல். ஆசிரியப்பா என்பது தவறு. எனவே கூற்று 4 தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on the poetic structure of Pazhamozhi Naanooru:\n1. It comprises 400 Venba poems.\n2. Every poem concludes with a proverb.\n3. The textbook poem features the proverb 'Ondruraa mundril il'.\n4. Its poems are composed in Asiriyappa meter.\nWhich statement is incorrect?"}], "options": {"A": "Statement 2 is incorrect", "B": "Statement 4 is incorrect", "C": "Statement 1 is incorrect", "D": "Statement 3 is incorrect"}, "explanation": "Pazhamozhi Naanooru consists of Venba meter poems, not Asiriyappa. Statement 4 is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பழமொழி நானூறு நானூறு வெண்பாக்களைக் கொண்ட நூலாகும்.", "content_en": "Pazhamozhi Naanooru consists of 400 Venba verses."}, {"id": "S2", "content_ta": "இந்நூலின் ஒவ்வொரு பாடலின் இறுதியிலும் ஒரு பழமொழி இடம்பெற்றிருக்கும்.", "content_en": "Every song in this anthology concludes with a proverb."}, {"id": "S3", "content_ta": "பாடப்பகுதியில் இடம்பெற்றுள்ள பாடலின் இறுதி அடி 'ஒன்றுறா முன்றில் இல்' என்னும் பழமொழியை விளக்குகிறது.", "content_en": "The final line of the textbook song features the proverb 'Ondruraa mundril il'."}, {"id": "S4", "content_ta": "இந்நூலின் பாடல்கள் அனைத்தும் ஆசிரியப்பா யாப்பினால் இயற்றப்பட்டவை.", "content_en": "All songs in this text are composed in Asiriyappa meter."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["virundhombal", "metrics", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q003", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-01-virundhombal", "chapter_id": null, "topic_id": "ta-t3-u1-verse-vocabulary-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "விருந்தோம்பல் பாடல் சொற்பொருள் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'மாரி' என்பது மழையைக் குறிக்கும்.\n2. 'பாண்மகன்' என்பது பாணரைக் குறிக்கும்.\n3. 'முன்றில்' என்பது வீட்டின் முன் இடமாகிய திண்ணையைக் குறிக்கும்; பாடலில் வீட்டைக் குறித்து வந்துள்ளது.\n4. 'புகாவா' என்பது ஆடையைக் குறிக்கும் சொல்லாகும்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 2 மட்டுமே சரி", "C": "1, 2, 3 மட்டுமே சரி; 4 தவறு", "D": "2, 4 மட்டுமே சரி"}, "explanation": "பாடநூல் பக்கம் 2 சொல்லும் பொருளும்: 'புகாவா' என்பது 'உணவாக' என்று பொருள்படும்; ஆடை என்பது தவறு. 1, 2, 3 மிகச்சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the vocabulary statements from the Virundhombal verse:\n1. 'Maari' means rain.\n2. 'Paanmagan' means minstrel.\n3. 'Mundril' means front porch, here meaning home.\n4. 'Pugaavaa' means clothing.\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1 and 2 only correct", "C": "1, 2, and 3 only correct; 4 incorrect", "D": "2 and 4 only correct"}, "explanation": "'Pugaavaa' means 'as food' (unavaaga), not clothing. Statements 1, 2, and 3 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'மாரி ஒன்று இன்றி வறந்திருந்த காலத்தும்' என்ற அடியில் 'மாரி' என்பது மழையைக் குறிக்கும்.", "content_en": "In 'Maari ondru indri...', 'Maari' denotes rain."}, {"id": "S2", "content_ta": "'பாரி மடமகள் பாண்மகற்கு' என்ற அடியில் பாண்மகன் என்பது இசை பாடும் பாணரைக் குறிக்கும்.", "content_en": "'Paanmagan' denotes the wandering minstrel (Paanar)."}, {"id": "S3", "content_ta": "'முன்றில்' என்பது இயல்பாக வீட்டின் முன் இடத்தைக் (திண்ணை) குறிக்கும்; இங்கு வீட்டைக் குறிக்கிறது.", "content_en": "'Mundril' literally means the front porch of a house; here it metonymically represents the entire home."}, {"id": "S4", "content_ta": "'புகாவா நல்கினாள்' என்பதில் 'புகாவா' என்பது ஆடையைக் குறிக்கும் சொல்லாகும்.", "content_en": "In 'Pugaavaa nalginaal', 'Pugaavaa' denotes clothing."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["virundhombal", "vocabulary", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q004", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-01-virundhombal", "chapter_id": null, "topic_id": "ta-t3-u1-paari-magalir-history-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரி மகளிர் பற்றிய பின்வரும் கூற்றுகளில் தவறானது எது?"}], "options": {"A": "கடையெழு வள்ளல்களுள் ஒருவரான பாரியின் மகள்கள் அங்கவை, சங்கவை", "B": "வறட்சிக் காலத்திலும் தங்களை நாடி வந்த பாணர்க்கு உபசரித்தனர்", "C": "உலைநீரில் பொன் இட்டுப் பொற்கலத்தில் உணவாகத் தந்தனர்", "D": "பாரி மகளிர் உணவின்றி வந்த பாணர்களை வெறும் கையோடு திருப்பி அனுப்பினர்"}, "explanation": "பாடலின் மையக் கருத்தே தமிழரின் விருந்தோம்பல் மற்றும் பாரி மகளிரின் ஈகைப்பண்பு ஆகும்; பாணர்க்குப் பொன் தந்து பசி தீர்த்தனர். எனவே 'D' முற்றிலும் தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Which of the following statements about Paari's daughters is INCORRECT?"}], "options": {"A": "Angavai and Sangavai were daughters of Kadayezhu Vallal Paari", "B": "They hosted minstrels even during severe drought", "C": "They placed gold into cooking pots and served them", "D": "Paari's daughters sent away hungry minstrels empty-handed"}, "explanation": "The core theme is boundless hospitality and generosity; Paari's daughters gave gold to sustain the minstrels. Statement D is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "கடையெழு வள்ளல்களுள் ஒருவரான பாரியின் மகள்கள் அங்கவை, சங்கவை ஆவர்.", "content_en": "Angavai and Sangavai are the daughters of Paari, one of the seven great patrons."}, {"id": "S2", "content_ta": "மழை இல்லாத வறட்சிக் காலத்திலும் பாணர்கள் பாரி மகளிரிடம் வந்து இறந்து நின்றனர்.", "content_en": "Even during drought, minstrels approached Paari's daughters seeking alms."}, {"id": "S3", "content_ta": "பாரி மகளிர் பாணர்க்கு உலைநீரில் பொன்னிட்டு உணவாகக் கொடுத்தனர்.", "content_en": "Paari's daughters gave gold in the cooking pot as sustenance to the minstrels."}, {"id": "S4", "content_ta": "பாரி மகளிர் உணவின்றி வந்த பாணர்களை வெறும் கையோடு திருப்பி அனுப்பினர்.", "content_en": "Paari's daughters turned away the starving minstrels empty-handed."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["virundhombal", "paari_magalir", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q005", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-01-virundhombal", "chapter_id": null, "topic_id": "ta-t3-u1-proverb-significance-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஒன்றுறா முன்றில் இல்' என்னும் பழமொழி மற்றும் பாடல் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'ஒன்றுறா முன்றில் இல்' என்பதன் பொருள் 'ஒன்றும் இல்லாத வீடு எதுவும் இல்லை'.\n2. பாரி மகளிரின் இல்லத்தில் எப்போதுமே கொடுக்க ஏதேனும் பொருள் இருக்கும் என்பதை இது விளக்குகிறது.\n3. தமிழரின் விருந்தோம்பல் பண்பை உணர்த்தும் வரலாற்றுச் சான்றாக இப்பாடல் திகழ்கிறது.\n4. ஆசிரியர் இப்பழமொழியைப் பாடலின் நான்காம் அடியில் அமைத்துள்ளார்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 2 மட்டுமே சரி", "C": "1, 3 மட்டுமே சரி", "D": "2, 3, 4 மட்டுமே சரி"}, "explanation": "பாடநூல் பக்கங்கள் 2-3: 'ஒன்றுறா முன்றில் இல்' பழமொழி விளக்கம், பாரி மகளிர் ஈகை, விருந்தோம்பல் விழுமியம் மற்றும் 4-ஆம் அடியில் பழமொழி அமைவு ஆகிய 4 கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements regarding the proverb 'Ondruraa mundril il' and the poem:\n1. It means 'There is no house without anything'.\n2. It highlights that Paari's daughters always have something to offer.\n3. The song exemplifies traditional Tamil hospitality.\n4. The author places the proverb in the fourth line.\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1 and 2 only correct", "C": "1 and 3 only correct", "D": "2, 3, and 4 only correct"}, "explanation": "All four statements correctly reflect textbook pages 2-3 regarding meaning, hospitality theme, and structure. All are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'ஒன்றுறா முன்றில் இல்' என்னும் பழமொழியின் பொருள் 'ஒன்றும் இல்லாத வீடு எதுவும் இல்லை' என்பதாகும்.", "content_en": "The proverb 'Ondruraa mundril il' means 'There is no house with nothing in it'."}, {"id": "S2", "content_ta": "இப்பழமொழி பாரி மகளிரின் இல்லத்தில் எப்போதுமே பிறர்க்குக் கொடுக்க ஏதேனும் பொருள் இருக்கும் என்பதை உணர்த்துகிறது.", "content_en": "This proverb signifies that there is always something to give in the household of Paari's daughters."}, {"id": "S3", "content_ta": "தமிழர்களின் விருந்தோம்பல் பண்பை விளக்கும் வரலாற்றுச் சான்றாக இப்பாடல் திகழ்கிறது.", "content_en": "This poem serves as historical proof of Tamil hospitality."}, {"id": "S4", "content_ta": "முன்றுறை அரையனார் இப்பழமொழியைப் பாடலின் நான்காம் அடியில் பொதிந்து அமைத்துள்ளார்.", "content_en": "Mundrurai Araiyanaar embedded this proverb in the fourth line of the poem."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["virundhombal", "proverb", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q006", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-01-virundhombal", "chapter_id": null, "topic_id": "ta-t3-u1-mundril-ilakkanap-poli-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'முன்றில்' என்னும் சொல்லின் இலக்கண அமைப்பு பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'முன்றில்' என்பது 'இல்முன்' என்பதன் இலக்கணப் போலி ஆகும்.\n2. முன்பின் பகுதிகள் இடம் மாறி அமைந்தமையால் இது 'முன்பின் மாறாகத் தொக்க போலி' எனப்படும்.\n3. வாயில் என்பது வாசல் என மருவி வழங்குவது மரூஉ ஆகும்.\n4. முன்றில் என்பது எவ்வித மாற்றமும் இல்லாத தூய தொழிற்பெயர் ஆகும்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 2, 3 மட்டுமே சரி; 4 தவறு", "C": "1, 4 மட்டுமே சரி", "D": "2, 4 மட்டுமே சரி"}, "explanation": "'முன்றில்' என்பது இலக்கணப் போலி (இல்முன் -> முன்றில்) மற்றும் இடப்பெயர் ஆகும்; தொழிற்பெயர் அன்று. எனவே கூற்று 4 தவறு. 1, 2, 3 மிகச்சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the grammatical structure of the term 'Mundril':\n1. 'Mundril' is the Ilakkana Poli of 'Ilmun'.\n2. Transposing front and rear parts makes it 'Munpin maaraagath thokka poli'.\n3. 'Vaayil' shifting to 'Vaasal' is Maru-u.\n4. Mundril is an unmodified pure verbal noun.\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1, 2, and 3 only correct; 4 incorrect", "C": "1 and 4 only correct", "D": "2 and 4 only correct"}, "explanation": "'Mundril' is an Ilakkana Poli (spatial noun), not a verbal noun. Statement 4 is false. 1, 2, 3 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'முன்றில்' என்னும் சொல் 'இல்முன்' என்பதன் இலக்கணப் போலி ஆகும்.", "content_en": "'Mundril' is the grammatical substitute (Ilakkana Poli) for 'Ilmun'."}, {"id": "S2", "content_ta": "சொல்லின் முன்பின் பகுதிகள் இடம் மாறி அமைந்தமையால் இது 'முன்பின் மாறாகத் தொக்க போலி' என்றும் அழைக்கப்படும்.", "content_en": "Because front and back segments transposed, it is also termed 'Munpin maaraagath thokka poli'."}, {"id": "S3", "content_ta": "வாயில் என்பது 'வாசல்' என மருவி வழங்குவது மரூஉ ஆகும்.", "content_en": "'Vaayil' becoming 'Vaasal' is Maru-u."}, {"id": "S4", "content_ta": "'முன்றில்' என்பது எவ்வித மாற்றமும் இல்லாத தூய முதனிலைத் தொழிற்பெயர் ஆகும்.", "content_en": "'Mundril' is an unmodified primary root verbal noun."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 14, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["virundhombal", "grammar", "ilakkanap_poli", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q007", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-01-virundhombal", "chapter_id": null, "topic_id": "ta-t3-u1-pazhamozhi-context-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழமொழி நானூறு மற்றும் அதன் ஆசிரியர் பற்றிய கூற்றுகளில் தவறானது எது?"}], "options": {"A": "பதினெண்கீழ்க்கணக்கு அறநூல்களுள் ஒன்றாகத் திகழ்கிறது", "B": "அறக்கருத்துகள் பழமொழிகள் வாயிலாக விளக்கப்படுகின்றன", "C": "முன்றுறை அரையனார் சோழ நாட்டின் அரசனாக முடிசூடி ஆட்சி செய்தார்", "D": "பாடல்கள் ஒவ்வொன்றும் நான்கு அடிகளைக் கொண்ட வெண்பாக்களால் ஆனவை"}, "explanation": "முன்றுறை அரையனார் பெயரில் உள்ள 'அரையன்' என்பது அரசனை அல்லது சிற்றரசரைக் குறிக்கலாம் அல்லது அவர் ஊர்ப் பெயராக 'முன்றுறை' இருக்கலாம் என ஆய்வாளர்கள் கூறுவரே தவிர, சோழப் பேரரசனாக முடிசூடி ஆட்சி செய்ததாக வரலாற்றுச் சான்றில்லை. எனவே 'C' தவறான கூற்றாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which statement regarding Pazhamozhi Naanooru and its author is INCORRECT?"}], "options": {"A": "It is one of the Pathinenkeelkanakku ethical works", "B": "Moral values are illustrated via proverbs", "C": "Mundrurai Araiyanaar ruled as crowned Chola monarch", "D": "Each poem is a four-line Venba verse"}, "explanation": "There is no historical evidence that Mundrurai Araiyanaar ruled as a crowned Chola emperor; 'Araiyan' may denote a chieftain or title. Option C is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பதினெண்கீழ்க்கணக்கு நூல்கள் சங்க மருவிய காலத்து நீதி இலக்கியங்கள் ஆகும்.", "content_en": "Pathinenkeelkanakku works are post-Sangam ethical literature."}, {"id": "S2", "content_ta": "பழமொழி நானூறு நூலில் அறக்கருத்துகள் பழமொழிகள் வாயிலாக எளிமையாக விளக்கப்படுகின்றன.", "content_en": "Ethical tenets in Pazhamozhi Naanooru are illustrated simply through proverbs."}, {"id": "S3", "content_ta": "முன்றுறை அரையனார் சோழ நாட்டின் அரசனாக மணிமுடி சூடி 50 ஆண்டுகள் ஆட்சி செய்தார்.", "content_en": "Mundrurai Araiyanaar was crowned king of Chola realm and ruled for 50 years."}, {"id": "S4", "content_ta": "பழமொழி நானூறு பாடல்கள் ஒவ்வொன்றும் நான்கு அடிகளைக் கொண்டு திகழ்கின்றன.", "content_en": "Every poem in Pazhamozhi Naanooru consists of four lines."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["virundhombal", "author_history", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q008", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-01-virundhombal", "chapter_id": null, "topic_id": "ta-t3-u1-pazhamozhi-naming-reason", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): இந்நூல் 'பழமொழி நானூறு' என்று பெயர் பெற்றது.\nகாரணம் (R): இந்நூலின் நானூறு வெண்பாக்களின் ஒவ்வொரு பாடலின் இறுதியிலும் ஒரு பழமொழி இடம்பெற்றுள்ளது."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று, காரணம் இரண்டும் தவறு", "D": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது"}, "explanation": "பாடநூல் பக்கம் 3: நானூறு பாடல்களைக் கொண்டு ஒவ்வொரு பாடலின் இறுதியிலும் பழமொழி அமைந்தமையால் இந்நூல் 'பழமொழி நானூறு' எனப் பெயர் பெற்றது. கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): This text is titled 'Pazhamozhi Naanooru'.\nReason (R): Every poem among its 400 Venba verses concludes with a proverb."}], "options": {"A": "Assertion is true, Reason is false", "B": "Assertion is false, Reason is true", "C": "Both Assertion and Reason are false", "D": "Both Assertion and Reason are true, and Reason is the correct explanation"}, "explanation": "Both A and R are verified textbook facts from page 3, and R directly explains the naming rationale."}}, "question_data": {"assertion": "இந்நூல் 'பழமொழி நானூறு' என்று பெயர் பெற்றது.", "reason": "இந்நூலின் நானூறு வெண்பாக்களின் ஒவ்வொரு பாடலின் இறுதியிலும் ஒரு பழமொழி இடம்பெற்றுள்ளது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["virundhombal", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q009", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-01-virundhombal", "chapter_id": null, "topic_id": "ta-t3-u1-paari-magalir-generosity-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): மழையின்றி வறட்சி நிலவிய கொடுங்காலத்திலும் பாரி மகளிரால் பாணர்க்குப் பொன் வழங்க முடிந்தது.\nகாரணம் (R): கடையெழு வள்ளல்களில் ஒருவரான பாரியின் பறம்பு நாடு வற்றாத கொடை வளமும் செல்வச் செழிப்பும் கொண்டதாகத் திகழ்ந்தது."}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றுக்கான சரியான விளக்கம்", "B": "கூற்று சரி, காரணம் தவறு", "C": "கூற்று தவறு, காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாரி பறம்பு மலையை ஆண்ட மாபெரும் வள்ளல். அவரது புதல்வியரான அங்கவை, சங்கவை வறட்சி காலத்திலும் தங்களை நாடி வந்த பாணர்க்குப் பொற்கலத்தில் பொன்னிட்டு வழங்கினர் ('ஒன்றுறா முன்றில் இல்'). கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Even during severe rainless drought, Paari's daughters could bestow gold upon visiting minstrels.\nReason (R): As one of the seven great patrons, Paari's Parambu realm enjoyed inexhaustible generosity and wealth."}], "options": {"A": "Both Assertion and Reason are true, and Reason is the correct explanation", "B": "Assertion is true, Reason is false", "C": "Assertion is false, Reason is true", "D": "Both Assertion and Reason are false"}, "explanation": "Paari's boundless munificence enabled his daughters to bestow gold on minstrels even during famine. Both A and R are true and R explains A."}}, "question_data": {"assertion": "மழையின்றி வறட்சி நிலவிய கொடுங்காலத்திலும் பாரி மகளிரால் பாணர்க்குப் பொன் வழங்க முடிந்தது.", "reason": "கடையெழு வள்ளல்களில் ஒருவரான பாரியின் பறம்பு நாடு வற்றாத கொடை வளமும் செல்வச் செழிப்பும் கொண்டதாகத் திகழ்ந்தது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["virundhombal", "paari_magalir", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q010", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-01-virundhombal", "chapter_id": null, "topic_id": "ta-t3-u1-mundril-double-meaning-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'விருந்தோம்பல்' பாடலில் 'முன்றில்' என்னும் சொல் இருமுறை பயின்று வந்துள்ளது.\nகாரணம் (R): முன்றில் என்னும் சொல் பாடலின் முதல் அடியில் மழையைக் குறிக்கவும், இறுதி அடியில் சூரியனைக் குறிக்கவும் பயன்படுகிறது."}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "C": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "கூற்று சரி: பாடலில் 'முன்றில் முன்றில் புகாவா நல்கினாள் ஒன்றுறா முன்றில் இல்' என முன்றில் பயின்று வந்துள்ளது. காரணம் தவறு: 'முன்றில்' என்பது வீட்டின் முன் இடத்தைக் (திண்ணை) குறிக்கும் சொல்லாகும்; அது மழையையோ சூரியனையோ குறிக்காது (மாரி = மழை). எனவே காரணம் தவறு."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): The word 'Mundril' occurs twice in the Virundhombal verse.\nReason (R): 'Mundril' is used to denote rain in the first line and sun in the final line."}], "options": {"A": "Both Assertion and Reason are true", "B": "Assertion (A) is true, but Reason (R) is false", "C": "Assertion (A) is false, but Reason (R) is true", "D": "Both Assertion and Reason are false"}, "explanation": "Assertion is true (the word occurs in the verse). Reason is false: Mundril means front porch / house, not rain or sun. Key B is correct."}}, "question_data": {"assertion": "'விருந்தோம்பல்' பாடலில் 'முன்றில்' என்னும் சொல் இருமுறை பயின்று வந்துள்ளது.", "reason": "முன்றில் என்னும் சொல் பாடலின் முதல் அடியில் மழையைக் குறிக்கவும், இறுதி அடியில் சூரியனைக் குறிக்கவும் பயன்படுகிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["virundhombal", "vocabulary", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q011", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-01-virundhombal", "chapter_id": null, "topic_id": "ta-t3-u1-mundrurai-religion-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): முன்றுறை அரையனார் வைணவ சமயத்தைச் சார்ந்த ஆழ்வார்களில் ஒருவராவார்.\nகாரணம் (R): பழமொழி நானூறு நூலில் பெருமாளின் பத்து அவதாரங்கள் மட்டுமே பாடப்பட்டுள்ளன."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று, காரணம் இரண்டும் தவறு", "D": "கூற்று, காரணம் இரண்டும் சரி"}, "explanation": "பாடநூல் பக்கம் 3: முன்றுறை அரையனார் 'சமண சமயத்தைச்' சேர்ந்தவர்; வைணவர் அல்ல. இந்நூல் உலக வாழ்வியல் அறங்களை உரைக்கும் நீதி நூலாகும்; அவதாரங்களை மட்டும் பாடும் நூல் அல்ல. எனவே கூற்று, காரணம் இரண்டும் முற்றிலும் தவறு!"}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Mundrurai Araiyanaar is one of the Vaishnavite Alwars.\nReason (R): Pazhamozhi Naanooru sings exclusively about the ten avatars of Lord Vishnu."}], "options": {"A": "Assertion is true, Reason is false", "B": "Assertion is false, Reason is true", "C": "Both Assertion and Reason are false", "D": "Both Assertion and Reason are true"}, "explanation": "Mundrurai Araiyanaar was a Jain, not a Vaishnavite Alwar, and Pazhamozhi Naanooru is a moral didactic text, not a devotional hymnal. Both A and R are false."}}, "question_data": {"assertion": "முன்றுறை அரையனார் வைணவ சமயத்தைச் சார்ந்த ஆழ்வார்களில் ஒருவராவார்.", "reason": "பழமொழி நானூறு நூலில் பெருமாளின் பத்து அவதாரங்கள் மட்டுமே பாடப்பட்டுள்ளன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 3, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["virundhombal", "author_history", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q012", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-01-virundhombal", "chapter_id": null, "topic_id": "ta-t3-u1-hospitality-tamil-culture-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தமிழர்களின் தலையாய பண்பாட்டு விழுமியங்களுள் விருந்தோம்பல் முதன்மையானதாகப் போற்றப்படுகிறது.\nகாரணம் (R): தமக்கென வாழாமல் பிறர்க்கென வாழும் ஈகை நெறியே தமிழர்தம் வாழ்க்கையின் உயர்ந்த அறமாக இருந்தது."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று, காரணம் இரண்டும் தவறு", "D": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றுக்கான சரியான விளக்கம்"}, "explanation": "பாடநூல் பக்கம் 2 நுழைவு முன்: தமிழர்களின் பண்பாட்டுக் கூறுகளில் விருந்தோம்பல் முதன்மையானது; அல்லல் உற்ற காலத்திலும் விருந்தினர்க்கு உணவளித்த பெருமை தமிழருக்கு உண்டு. கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Hospitality is venerated as the foremost cultural virtue of the Tamils.\nReason (R): Living for others rather than selfishly was upheld as the highest moral ideal of Tamil life."}], "options": {"A": "Assertion is true, Reason is false", "B": "Assertion is false, Reason is true", "C": "Both Assertion and Reason are false", "D": "Both Assertion and Reason are true, and Reason is the correct explanation"}, "explanation": "Both A and R reflect textbook page 2 intro on the profound ethos of Tamil hospitality. R explains A."}}, "question_data": {"assertion": "தமிழர்களின் தலையாய பண்பாட்டு விழுமியங்களுள் விருந்தோம்பல் முதன்மையானதாகப் போற்றப்படுகிறது.", "reason": "தமக்கென வாழாமல் பிறர்க்கென வாழும் ஈகை நெறியே தமிழர்தம் வாழ்க்கையின் உயர்ந்த அறமாக இருந்தது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["virundhombal", "culture", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q013", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-01-virundhombal", "chapter_id": null, "topic_id": "ta-t3-u1-ilakkanap-poli-formation-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'இல்முன்' என்னும் சொல் 'முன்றில்' என அமைவது இலக்கணப் போலி ஆகும்.\nகாரணம் (R): இலக்கண முறைப்படி அமையாவிடினும் இலக்கணம் உடையது போன்றே ஏற்றுக்கொள்ளப்படும் சொற்கள் இலக்கணப் போலி எனப்படும்."}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றுக்கான சரியான விளக்கம்", "B": "கூற்று சரி, காரணம் தவறு", "C": "கூற்று தவறு, காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் பக்கம் 14: இல்முன் -> முன்றில். இலக்கண முறைப்படி இல்லாதிருப்பினும் சான்றோரால் ஏற்றுக்கொள்ளப்பட்டமையால் இலக்கணப் போலி எனப்படும். கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): The formation of 'Ilmun' as 'Mundril' is Ilakkana Poli.\nReason (R): Words that are not structurally conforming to formal grammar yet accepted as if grammatically valid are Ilakkana Poli."}], "options": {"A": "Both Assertion and Reason are true, and Reason is the correct explanation", "B": "Assertion is true, Reason is false", "C": "Assertion is false, Reason is true", "D": "Both Assertion and Reason are false"}, "explanation": "Both A and R are verified from page 14: Ilakkana Poli accepts transposed forms like Mundril. R explains A."}}, "question_data": {"assertion": "'இல்முன்' என்னும் சொல் 'முன்றில்' என அமைவது இலக்கணப் போலி ஆகும்.", "reason": "இலக்கண முறைப்படி அமையாவிடினும் இலக்கணம் உடையது போன்றே ஏற்றுக்கொள்ளப்படும் சொற்கள் இலக்கணப் போலி எனப்படும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 14, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["virundhombal", "grammar", "ilakkanap_poli", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q014", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-01-virundhombal", "chapter_id": null, "topic_id": "ta-t3-u1-verse-glossary-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "விருந்தோம்பல் பாடல் சொற்களையும் அவற்றின் பொருள்களையும் பொருத்துக:\n(a) மாரி - 1. இளமகள்\n(b) மடமகள் - 2. மழை\n(c) புகாவா - 3. வீட்டின் முன் இடம் (திண்ணை)\n(d) முன்றில் - 4. உணவாக"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-2, b-4, c-1, d-3", "D": "a-3, b-1, c-4, d-2"}, "explanation": "பாடநூல் பக்கம் 2:\nமாரி = மழை (2)\nமடமகள் = இளமகள் (1)\nபுகாவா = உணவாக (4)\nமுன்றில் = வீட்டின் முன் இடம் / திண்ணை (3).\nவரிசை: 2, 1, 4, 3."}, "en": {"blocks": [{"type": "text", "content": "Match the words from Virundhombal verse with their accurate meanings:\n(a) Maari - 1. Young maiden\n(b) Madamagal - 2. Rain\n(c) Pugaavaa - 3. Front porch\n(d) Mundril - 4. As food"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-2, b-4, c-1, d-3", "D": "a-3, b-1, c-4, d-2"}, "explanation": "Correct alignment: Maari = 2, Madamagal = 1, Pugaavaa = 4, Mundril = 3. Sequence: 2, 1, 4, 3."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "மாரி", "content_en": "Maari"}, {"id": "L2", "content_ta": "மடமகள்", "content_en": "Madamagal"}, {"id": "L3", "content_ta": "புகாவா", "content_en": "Pugaavaa"}, {"id": "L4", "content_ta": "முன்றில்", "content_en": "Mundril"}], "right": [{"id": "R1", "content_ta": "இளமகள்", "content_en": "Young maiden"}, {"id": "R2", "content_ta": "மழை", "content_en": "Rain"}, {"id": "R3", "content_ta": "வீட்டின் முன் இடம் (திண்ணை)", "content_en": "Front porch / Home"}, {"id": "R4", "content_ta": "உணவாக", "content_en": "As food"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["virundhombal", "vocabulary", "matching"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
