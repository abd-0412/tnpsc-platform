// பாடம் 4: வழக்கு & போலி (கற்கண்டு - இயல்பு வழக்கு, தகுதி வழக்கு, போலி வகைகள்) & கலைச்சொற்கள் [Q085 - Q112]
// வழக்கு இரு வகை: 1. இயல்பு வழக்கு (இலக்கணம் உடையது: நிலம்/மரம்; இலக்கணப் போலி / முன்பின் மாறாகத் தொக்க போலி: முன்றில்/புறநகர்; மரூஉ: கோவை/தஞ்சை/நெல்லை/எந்தை), 2. தகுதி வழக்கு (இடக்கரடக்கல்: கால் கழுவி வந்தான்; மங்கலம்: செத்தார்->இயற்கை எய்தினார், சுடுகாடு->நன்காடு, விளக்கை குளிரவை; குழூஉக்குறி: பொற்கொல்லர் பொன்னை 'பறி' எனல், பாகர் ஆடையைக் 'காரை' எனல்), போலி வகைகள் (முதற்போலி: பசல்->பைசல்; இடைப்போலி: அமச்சு->அமைச்சு; கடைப்போலி: நிலம்->நிலன், பந்தல்->பந்தர்; முற்றுப்போலி: ஐந்து->அஞ்சு), கலைச்சொற்கள் (Civilization, Folklore, Harvest, Irrigation, Foreign Trade, Agriculture, Poet, Paddy)
// ==============================================================================
{"id": "7th-t3-u1-q085", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-04-vazhakku", "chapter_id": null, "topic_id": "ta-t3-u1-vazhakku-classification-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வழக்கின் இலக்கணப் பாகுபாடுகள் பற்றிய பின்வரும் கூற்றுகளில் தவறானது எது?"}], "options": {"A": "எழுத்திலும் பேச்சிலும் சொற்களைப் பயன்படுத்தும் முறை வழக்கு எனப்படும்", "B": "வழக்கு இயல்பு வழக்கு, தகுதி வழக்கு என இரு பெரும் பிரிவுகளாக அமையும்", "C": "இயல்பு வழக்கு இலக்கணம் உடையது, இலக்கணப் போலி, மரூஉ என மூன்று வகைப்படும்", "D": "வழக்கு என்பது ஆங்கிலத்தில் மட்டுமே உள்ள இலக்கணக் கூறாகும்; தமிழில் இல்லை"}, "explanation": "பாடநூல் பக்கம் 13: நம் முன்னோர் எந்தெந்தப் பொருள்களை என்னென்ன சொற்களால் வழங்கி வந்தனரோ, நாமும் அவ்வாறே வழங்குவது தமிழ் வழக்காகும். தமிழில் இல்லை என்பது தவறு. எனவே 'D' தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Which statement regarding the grammatical divisions of Vazhakku is INCORRECT?"}], "options": {"A": "Mode of utilizing words in speech and writing is Vazhakku", "B": "Vazhakku divides into Iyalbu and Thaguthi", "C": "Iyalbu Vazhakku divides into Ilakkanam Udaiyathu, Ilakkana Poli, Maru-u", "D": "Vazhakku exists only in English and not in Tamil"}, "explanation": "Vazhakku is a foundational classical Tamil grammatical domain. Statement D is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "எழுத்திலும் பேச்சிலும் சொற்களைப் பயன்படுத்தும் முறை 'வழக்கு' எனப்படும்.", "content_en": "The mode of utilizing words in speech and writing is called 'Vazhakku'."}, {"id": "S2", "content_ta": "வழக்கு இயல்பு வழக்கு, தகுதி வழக்கு என இரு வகைப்படும்.", "content_en": "Vazhakku is classified into two types: Iyalbu Vazhakku and Thaguthi Vazhakku."}, {"id": "S3", "content_ta": "இயல்பு வழக்கு இலக்கணம் உடையது, இலக்கணப் போலி, மரூஉ என மூன்று வகைப்படும்.", "content_en": "Iyalbu Vazhakku is divided into three: Ilakkanam Udaiyathu, Ilakkana Poli, and Maru-u."}, {"id": "S4", "content_ta": "வழக்கு என்பது ஆங்கிலத்தில் மட்டுமே உள்ள இலக்கணக் கூறாகும்; தமிழில் வழக்கிற்கு இடமே இல்லை.", "content_en": "Vazhakku exists strictly in English grammar and has zero place in Tamil."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 13, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vazhakku", "grammar", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q086", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-04-vazhakku", "chapter_id": null, "topic_id": "ta-t3-u1-ilakkana-poli-rules-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கணம் உடையது மற்றும் இலக்கணப் போலி பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. இலக்கண நெறி மாறாமல் முறையாக அமைந்த சொல் இலக்கணம் உடையது.\n2. இலக்கண முறைப்படி இல்லாவிடினும் இலக்கணம் உடையது போன்றே ஏற்கப்படுவது இலக்கணப் போலி.\n3. இது 'முன்பின் மாறாகத் தொக்க போலி' எனவும் வழங்கப்படும்.\n4. இல்முன் -> முன்றில், நகர்ப்புறம் -> புறநகர் என்பவை இதற்குச் சான்றுகள்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 2 மட்டுமே சரி", "C": "2, 3, 4 மட்டுமே சரி", "D": "1, 3 மட்டுமே சரி"}, "explanation": "பாடநூல் பக்கங்கள் 13-14: இலக்கணம் உடையது மற்றும் இலக்கணப் போலி ஆகியவற்றின் வரைவிலக்கணம், மாற்றுப் பெயர் மற்றும் சான்றுகள் அனைத்தும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Ilakkanam Udaiyathu and Ilakkana Poli:\n1. Words conforming strictly to formal rules are Ilakkanam Udaiyathu.\n2. Non-conforming words accepted as valid by savants are Ilakkana Poli.\n3. Also named 'Munpin maaraagath thokka poli'.\n4. Ilmun -> Mundril, Nagarppuram -> Puranagar are examples.\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1 and 2 only correct", "C": "2, 3, and 4 only correct", "D": "1 and 3 only correct"}, "explanation": "All four statements match textbook definitions from pages 13-14. All are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "இலக்கண நெறி மாறாமல் முறையாக அமைந்த சொல் 'இலக்கணம் உடையது' எனப்படும் (எ.கா: நிலம், மரம், எழுது).", "content_en": "Words adhering strictly to grammar rules are 'Ilakkanam Udaiyathu' (e.g., Nilam, Maram, Ezhuthu)."}, {"id": "S2", "content_ta": "இலக்கண முறைப்படி அமையாவிடினும் சான்றோரால் இலக்கணம் உடையது போன்றே ஏற்றுக்கொள்ளப்படுவது 'இலக்கணப் போலி' எனப்படும்.", "content_en": "Words not strictly grammatical yet accepted by savants as valid are 'Ilakkana Poli'."}, {"id": "S3", "content_ta": "இலக்கணப் போலி பெரும்பாலும் முன்பின் சொற்கள் மாறி அமைவதால் 'முன்பின் மாறாகத் தொக்க போலி' என்றும் அழைக்கப்படும்.", "content_en": "Because words often transpose front and back, it is termed 'Munpin maaraagath thokka poli'."}, {"id": "S4", "content_ta": "இல்முன் -> முன்றில், நகர்ப்புறம் -> புறநகர், வாயில் -> வாசல் ஆகியவை இலக்கணப் போலிக்குச் சான்றுகளாகும்.", "content_en": "Ilmun -> Mundril, Nagarppuram -> Puranagar are textbook examples of Ilakkana Poli."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 13, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vazhakku", "grammar", "ilakkanap_poli", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q087", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-04-vazhakku", "chapter_id": null, "topic_id": "ta-t3-u1-maru-u-characteristics-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மரூஉ பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. இலக்கண நெறியிலிருந்து சிதைந்து வழங்கும் சொற்கள் மரூஉ எனப்படும்.\n2. கோயம்புத்தூர் -> கோவை, தஞ்சாவூர் -> தஞ்சை என்பவை மரூஉ ஆகும்.\n3. திருநெல்வேலி -> நெல்லை, என் தந்தை -> எந்தை என்பவை மரூஉ ஆகும்.\n4. மரூஉ சொற்களைப் பயன்படுத்துவது குற்றமாகும்; எப்போதும் வழங்கக்கூடாது.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 2, 3 மட்டுமே சரி; 4 தவறு", "C": "1, 3 மட்டுமே சரி; 2, 4 தவறு", "D": "2, 4 மட்டுமே சரி"}, "explanation": "பாடநூல் பக்கம் 14: மரூஉ சொற்கள் மக்கள் வழக்கில் இயல்பாகப் பயன்பட்டுத் தமிழ் இலக்கணத்தால் ஏற்றுக்கொள்ளப்பட்ட இயல்பு வழக்கின் பிரிவாகும். குற்றமன்று. எனவே கூற்று 4 தவறு. 1, 2, 3 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Maru-u:\n1. Words modified through historical usage are Maru-u.\n2. Coimbatore -> Kovai, Thanjavur -> Thanjai are Maru-u.\n3. Tirunelveli -> Nellai, En thanthai -> Enthai are Maru-u.\n4. Using Maru-u words is a penalized offence never allowed.\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1, 2, and 3 only correct; 4 incorrect", "C": "1 and 3 only correct; 2 and 4 incorrect", "D": "2 and 4 only correct"}, "explanation": "Maru-u is an accepted form under Iyalbu Vazhakku. Statement 4 is false. 1, 2, 3 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "இலக்கண நெறியிலிருந்து பிறழ்ந்து சிதைந்து வழங்கும் சொற்கள் 'மரூஉ' எனப்படும்.", "content_en": "Words that deviate from grammatical norms and become phonetically corrupted are 'Maru-u'."}, {"id": "S2", "content_ta": "கோயம்புத்தூர் என்பது 'கோவை' எனவும், தஞ்சாவூர் என்பது 'தஞ்சை' எனவும் மருவி வழங்குவது மரூஉ ஆகும்.", "content_en": "Coimbatore -> Kovai and Thanjavur -> Thanjai are examples of Maru-u."}, {"id": "S3", "content_ta": "திருநெல்வேலி என்பது 'நெல்லை' எனவும், என் தந்தை என்பது 'எந்தை' எனவும் வழங்குவது மரூஉ ஆகும்.", "content_en": "Tirunelveli -> Nellai and En thanthai -> Enthai are examples of Maru-u."}, {"id": "S4", "content_ta": "மரூஉ சொற்களைப் பயன்படுத்துவது பெரும் குற்றமாகும்; அவற்றை எப்போதும் பயன்படுத்தக் கூடாது.", "content_en": "Using Maru-u words is a severe crime and must never be permitted in speech."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 14, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vazhakku", "grammar", "maru-u", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q088", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-04-vazhakku", "chapter_id": null, "topic_id": "ta-t3-u1-thaguthi-vazhakku-types-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தகுதி வழக்கு பற்றிய பின்வரும் கூற்றுகளில் தவறானது எது?"}], "options": {"A": "பிறரிடம் தகுந்த வேறு சொற்களால் நாகரிகமாகக் குறிப்பிடுவது தகுதி வழக்கு", "B": "தகுதி வழக்கு இடக்கரடக்கல், மங்கலம், குழூஉக்குறி என மூன்று வகைப்படும்", "C": "மங்கலமில்லாத சொற்களை மங்கலமான சொல்லால் மாற்றுவது 'குழூஉக்குறி' எனப்படும்", "D": "வெளிப்படையாகச் சொல்லத் தகாததை மறைத்துக் கூறுவது இடக்கரடக்கல் ஆகும்"}, "explanation": "பாடநூல் பக்கம் 15: மங்கலமில்லாத சொற்களை மாற்றி மங்கலமான சொற்களால் குறிப்பிடுவது 'மங்கலம்' எனப்படும் (எ.கா: செத்தார் -> இயற்கை எய்தினார்). 'குழூஉக்குறி' என்பது ஒரு குழுவினர் தங்களுக்குள் அமைத்துக்கொள்ளும் சொல். எனவே 'C' தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Which statement regarding Thaguthi Vazhakku is INCORRECT?"}], "options": {"A": "Decorous utterance using suitable terms is Thaguthi Vazhakku", "B": "Thaguthi Vazhakku divides into Idakkaradakkal, Mangalam, Kuzhoo-ukkuri", "C": "Replacing inauspicious terms with auspicious ones is 'Kuzhoo-ukkuri'", "D": "Concealing improper words politely is Idakkaradakkal"}, "explanation": "Replacing inauspicious words with auspicious terms is 'Mangalam', not Kuzhoo-ukkuri. Statement C is incorrect."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ஏதேனும் ஒரு காரணத்தினால் பிறரிடம் வெளிப்படையாகச் சொல்லத் தகாத சொற்களைத் தகுந்த வேறு சொற்களால் கூறுவது தகுதி வழக்கு.", "content_en": "Expressing words unsuitable for open utterance through appropriate decorous terms is Thaguthi Vazhakku."}, {"id": "S2", "content_ta": "தகுதி வழக்கு இடக்கரடக்கல், மங்கலம், குழூஉக்குறி என மூன்று வகைப்படும்.", "content_en": "Thaguthi Vazhakku divides into Idakkaradakkal, Mangalam, and Kuzhoo-ukkuri."}, {"id": "S3", "content_ta": "பிறரிடம் வெளிப்படையாகச் சொல்லத் தகாதவற்றை மறைத்துக் கூறுவது 'இடக்கரடக்கல்' ஆகும் (எ.கா: கால் கழுவி வந்தான்).", "content_en": "Euphemistically masking words unsuitable for polite company is Idakkaradakkal (e.g., Kaal kazhuvi vanthan)."}, {"id": "S4", "content_ta": "மங்கலமில்லாத சொற்களை மங்கலமான சொல்லால் மாற்றுவது 'குழூஉக்குறி' எனப்படும்.", "content_en": "Replacing inauspicious words with auspicious ones is termed 'Kuzhoo-ukkuri'."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 15, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vazhakku", "grammar", "thaguthi_vazhakku", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q089", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-04-vazhakku", "chapter_id": null, "topic_id": "ta-t3-u1-mangalam-examples-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மங்கல வழக்கு பற்றிய பின்வரும் கூற்றுகளில் தவறானது எது?"}], "options": {"A": "செத்தார் என்பதை 'இயற்கை எய்தினார்' என்று கூறுவது மங்கல வழக்கு", "B": "சுடுகாடு என்பதை 'நன்காடு' என்று வழங்குவது மங்கல வழக்கு", "C": "விளக்கை அணை என்பதை 'விளக்கைக் குளிரவை' எனக் கூறுவது மங்கல வழக்கு", "D": "மங்கல வழக்கில் பேசப்படும் அனைத்துச் சொற்களும் வடமொழிக் கடன்களே"}, "explanation": "பாடநூல் பக்கம் 15: இயற்கை எய்தினார், நன்காடு, திருமுகம், குளிரவை ஆகியவை தமிழர்களின் மரபுசார்ந்த தூய தமிழ்ச் சொற்கள் ஆகும். வடமொழிக் கடன் என்பது தவறு. எனவே 'D' தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Which statement regarding Mangala Vazhakku is INCORRECT?"}], "options": {"A": "Calling death 'Iyarkkai eithinaar' is Mangalam", "B": "Calling burning ground 'Nankaadu' is Mangalam", "C": "Saying 'Vilakkai kuliravai' is Mangalam", "D": "All Mangalam terms are strictly Sanskrit loanwords"}, "explanation": "Mangalam phrases are pristine native Tamil cultural euphemisms, not Sanskrit loanwords. Statement D is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "செத்தார் என்று கூறாமல் 'இயற்கை எய்தினார்' அல்லது 'துஞ்சினார்' என்று கூறுவது மங்கல வழக்கு ஆகும்.", "content_en": "Saying 'Iyarkkai eithinaar' instead of 'Sethaar' is Mangala Vazhakku."}, {"id": "S2", "content_ta": "சுடுகாடு என்பதை 'நன்காடு' என்று வழங்குவது மங்கல வழக்கு ஆகும்.", "content_en": "Calling a cremation ground 'Nankaadu' is Mangala Vazhakku."}, {"id": "S3", "content_ta": "விளக்கை அணை என்று கூறாமல் 'விளக்கைக் குளிரவை' எனக் கூறுவது மங்கல வழக்கு ஆகும்.", "content_en": "Saying 'Vilakkai kuliravai' instead of dousing the lamp is Mangala Vazhakku."}, {"id": "S4", "content_ta": "மங்கல வழக்கில் பேசப்படும் அனைத்துச் சொற்களும் சமஸ்கிருதத்திலிருந்து மட்டுமே கடன்வாங்கப்பட்டவை.", "content_en": "All terms spoken in Mangala Vazhakku are loanwords strictly from Sanskrit."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 15, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vazhakku", "grammar", "mangalam", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q090", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-04-vazhakku", "chapter_id": null, "topic_id": "ta-t3-u1-poli-three-types-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "போலி (Poli) வகைகள் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. எழுத்து மாறினாலும் பொருள் மாறாதிருப்பது போலி எனப்படும்.\n2. சொல்லின் முதலெழுத்து மாறுவது முதற்போலி (பசல் -> பைசல்).\n3. சொல்லின் இடையெழுத்து மாறுவது இடைப்போலி (இலஞ்சி -> இலைஞ்சி).\n4. சொல்லின் இறுதியெழுத்து மாறுவது கடைப்போலி (நிலம் -> நிலன், பந்தல் -> பந்தர்).\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 2 மட்டுமே சரி", "C": "2, 3, 4 மட்டுமே சரி", "D": "1, 4 மட்டுமே சரி"}, "explanation": "பாடநூல் பக்கங்கள் 15-16: முதற்போலி, இடைப்போலி, கடைப்போலி ஆகியவற்றின் இலக்கண வரையறைகளும் சான்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on the classifications of Poli:\n1. Substituting a letter without altering meaning is Poli.\n2. Initial letter substitution is Mutharpoli (Pasal -> Paisal).\n3. Medial letter substitution is Idaippoli (Ilanji -> Ilainji).\n4. Final letter substitution is Kadaippoli (Nilam -> Nilan, Panthal -> Panthar).\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1 and 2 only correct", "C": "2, 3, and 4 only correct", "D": "1 and 4 only correct"}, "explanation": "All four statements match textbook pages 15-16 perfectly. All are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ஒரு சொல்லின் இயல்பான எழுத்துக்குப் பதிலாக வேறு எழுத்து வந்தாலும் பொருள் மாறாதிருப்பது 'போலி' எனப்படும்.", "content_en": "When a different letter replaces the normal letter of a word without altering its meaning, it is Poli."}, {"id": "S2", "content_ta": "சொல்லின் முதலெழுத்து மாறுவது முதற்போலி (எ.கா: பசல் -> பைசல், மஞ்சு -> மைஞ்சு, மயல் -> மையல்).", "content_en": "Change in initial letter is Mutharpoli (e.g., Pasal -> Paisal, Manju -> Mainju)."}, {"id": "S3", "content_ta": "சொல்லின் இடையெழுத்து மாறுவது இடைப்போலி (எ.கா: அமைச்சு -> அமச்சு, இலஞ்சி -> இலைஞ்சி).", "content_en": "Change in medial letter is Idaippoli (e.g., Amaichu -> Amachu)."}, {"id": "S4", "content_ta": "சொல்லின் இறுதியெழுத்து மாறுவது கடைப்போலி (எ.கா: நிலம் -> நிலன், பந்தல் -> பந்தர்).", "content_en": "Change in final letter is Kadaippoli (e.g., Nilam -> Nilan, Panthal -> Panthar)."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 15, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vazhakku", "grammar", "poli", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q091", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-04-vazhakku", "chapter_id": null, "topic_id": "ta-t3-u1-mutruppoli-kuzhooukuri-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முற்றுப்போலி மற்றும் குழூஉக்குறி பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. எல்லா எழுத்துகளும் மாறினாலும் பொருள் மாறாதிருப்பது முற்றுப்போலி.\n2. 'ஐந்து' என்பது 'அஞ்சு' என மாறுவது முற்றுப்போலிக்குச் சான்று.\n3. பொற்கொல்லர் பொன்னை 'பறி' எனல், ஆடையைக் 'காரை' எனல் குழூஉக்குறி ஆகும்.\n4. 'அஞ்சு' என்பது எண் ஐந்தைக் குறிக்காது; பயத்தை மட்டுமே குறிக்கும்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 2, 3 மட்டுமே சரி; 4 தவறு", "C": "1, 3 மட்டுமே சரி; 2, 4 தவறு", "D": "2, 4 மட்டுமே சரி"}, "explanation": "பாடநூல் பக்கம் 16: 'அஞ்சு' என்பது 'ஐந்து' என்னும் எண்ணின் முற்றுப்போலி ஆகும். எண் ஐந்தைக் குறிக்காது என்பது தவறு. எனவே கூற்று 4 தவறு. 1, 2, 3 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Mutruppoli and Kuzhoo-ukkuri:\n1. When all letters transform without changing meaning, it is Mutruppoli.\n2. 'Ainthu' -> 'Anju' is an example of Mutruppoli.\n3. Goldsmiths calling gold 'Pari' and cloth 'Kaarai' is Kuzhoo-ukkuri.\n4. 'Anju' never means five and strictly means fear.\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1, 2, and 3 only correct; 4 incorrect", "C": "1 and 3 only correct; 2 and 4 incorrect", "D": "2 and 4 only correct"}, "explanation": "'Anju' stands as the Mutruppoli for the number five ('Ainthu'). Statement 4 is false. 1, 2, 3 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ஒரு சொல்லில் உள்ள எல்லா எழுத்துகளும் மாறினாலும் பொருள் மாறாமல் இருப்பது 'முற்றுப்போலி' எனப்படும்.", "content_en": "When every letter in a word is substituted without changing the meaning, it is Mutruppoli."}, {"id": "S2", "content_ta": "'ஐந்து' என்னும் சொல் 'அஞ்சு' என மாறுவது முற்றுப்போலிக்குரிய சிறந்த சான்றாகும்.", "content_en": "'Ainthu' transforming to 'Anju' is the prime example of Mutruppoli."}, {"id": "S3", "content_ta": "பொற்கொல்லர் பொன்னை 'பறி' என அழைப்பதும், யானைப் பாகர் ஆடையைக் 'காரை' என அழைப்பதும் 'குழூஉக்குறி' ஆகும்.", "content_en": "Goldsmiths calling gold 'Pari' and mahouts calling cloth 'Kaarai' is Kuzhoo-ukkuri."}, {"id": "S4", "content_ta": "'அஞ்சு' என்பது ஐந்து என்ற பொருளைத் தராமல் முற்றிலும் பயம் என்னும் பொருளை மட்டுமே தரும்.", "content_en": "'Anju' strictly means fear and never denotes the number five."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 16, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vazhakku", "grammar", "mutruppoli", "kuzhooukuri", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q092", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-04-vazhakku", "chapter_id": null, "topic_id": "ta-t3-u1-kuzhooukuri-definition-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): ஒரு குழுவினர் தங்களுக்குள் மட்டுமே விளங்கும்படி அமைத்துக் கொள்ளும் குறியீட்டுச் சொற்கள் 'குழூஉக்குறி' எனப்படும்.\nகாரணம் (R): குழூஉக்குறிச் சொற்களை நாட்டில் உள்ள எல்லாக் குடிமக்களும் நீதிமன்றத்தில் மட்டுமே பயன்படுத்த வேண்டும் என்பது அரசு சட்டம் ஆகும்."}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "கூற்று சரி: பாடநூல் பக்கம் 15-ல் உள்ள வரைவிலக்கணம். காரணம் முற்றிலும் தவறு: குழூஉக்குறி என்பது ஒரு குறிப்பிட்ட தொழிற்குழு அல்லது சமூகக்குழு தங்களுக்குள் பயன்படுத்தும் சொல்லாகும் (எ.கா: பொற்கொல்லர்); நீதிமன்றக் கட்டாயச் சட்டம் என்பது தவறான கற்பனை."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Coded terms devised by a specific group comprehensible only to themselves are called 'Kuzhoo-ukkuri'.\nReason (R): Government law mandates that Kuzhoo-ukkuri must be spoken by all citizens exclusively in courts of law."}], "options": {"A": "Both Assertion and Reason are true", "B": "Assertion is false, Reason is true", "C": "Assertion (A) is true, but Reason (R) is false", "D": "Both Assertion and Reason are false"}, "explanation": "Assertion is true. Reason is absurdly false: Kuzhoo-ukkuri is professional jargon (e.g., goldsmiths), not a court mandate. Key C is correct."}}, "question_data": {"assertion": "ஒரு குழுவினர் தங்களுக்குள் மட்டுமே விளங்கும்படி அமைத்துக் கொள்ளும் குறியீட்டுச் சொற்கள் 'குழூஉக்குறி' எனப்படும்.", "reason": "குழூஉக்குறிச் சொற்களை நாட்டில் உள்ள எல்லாக் குடிமக்களும் நீதிமன்றத்தில் மட்டுமே பயன்படுத்த வேண்டும் என்பது அரசு சட்டம் ஆகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 15, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vazhakku", "grammar", "kuzhooukuri", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q093", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-04-vazhakku", "chapter_id": null, "topic_id": "ta-t3-u1-mutruppoli-anju-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'ஐந்து' என்னும் சொல் 'அஞ்சு' என வழங்கப்படுவது முற்றுப்போலி ஆகும்.\nகாரணம் (R): ஒரு சொல்லில் உள்ள எல்லா எழுத்துகளும் முற்றிலுமாக மாறினாலும் பொருள் மாறாமல் அப்படியே இருப்பதனால் இது முற்றுப்போலி எனப்படுகிறது."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று, காரணம் இரண்டும் தவறு", "D": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது"}, "explanation": "பாடநூல் பக்கம் 16: ஐ-ந்-து ஆகிய அனைத்து எழுத்துகளும் அ-ஞ்-சு என மாறிய போதிலும் 'ஐந்து' என்ற எண்ணின் பொருள் மாறவில்லை. எனவே இது முற்றுப்போலி. கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'Ainthu' pronounced as 'Anju' is classified as Mutruppoli.\nReason (R): Because all the letters of the word are completely substituted without altering its inherent meaning, it is termed Mutruppoli."}], "options": {"A": "Assertion is true, Reason is false", "B": "Assertion is false, Reason is true", "C": "Both Assertion and Reason are false", "D": "Both Assertion and Reason are true, and Reason is the correct explanation"}, "explanation": "Both A and R are verified textbook facts from page 16, and R directly provides the grammatical definition explaining A."}}, "question_data": {"assertion": "'ஐந்து' என்னும் சொல் 'அஞ்சு' என வழங்கப்படுவது முற்றுப்போலி ஆகும்.", "reason": "ஒரு சொல்லில் உள்ள எல்லா எழுத்துகளும் முற்றிலுமாக மாறினாலும் பொருள் மாறாமல் அப்படியே இருப்பதனால் இது முற்றுப்போலி எனப்படுகிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 16, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vazhakku", "grammar", "mutruppoli", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q094", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-04-vazhakku", "chapter_id": null, "topic_id": "ta-t3-u1-kadaippoli-makaram-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'நிலம்' என்பது 'நிலன்' என்றும், 'முகம்' என்பது 'முகன்' என்றும் வருவது கடைப்போலி ஆகும்.\nகாரணம் (R): அஃறிணைப் பெயர்ச்சொற்களின் ஈற்றில் நிற்கும் மகர மெய்க்குப் பதிலாக நகர மெய் கடைப்போலியாக வரும் என்பது இலக்கண விதி."}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றுக்கான சரியான விளக்கம்", "B": "கூற்று சரி, காரணம் தவறு", "C": "கூற்று தவறு, காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் பக்கம் 15 'தெரிந்து தெளிவோம்': அஃறிணைப் பெயர்களின் இறுதியில் மகரத்திற்குப் பதிலாக நகரம் கடைப்போலியாக வரும் (நிலம் -> நிலன், முகம் -> முகன், அகம் -> அகன்). கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'Nilam' becoming 'Nilan' and 'Mukam' becoming 'Mukan' are Kadaippoli.\nReason (R): Grammatical rule permits the final bilabial nasal 'm' of neuter nouns to be replaced by alveolar nasal 'n' as Kadaippoli."}], "options": {"A": "Both Assertion and Reason are true, and Reason is the correct explanation", "B": "Assertion is true, Reason is false", "C": "Assertion is false, Reason is true", "D": "Both Assertion and Reason are false"}, "explanation": "Both A and R are verified textbook rules from page 15, and R explains why 'm' shifts to 'n' in Kadaippoli."}}, "question_data": {"assertion": "'நிலம்' என்பது 'நிலன்' என்றும், 'முகம்' என்பது 'முகன்' என்றும் வருவது கடைப்போலி ஆகும்.", "reason": "அஃறிணைப் பெயர்ச்சொற்களின் ஈற்றில் நிற்கும் மகர மெய்க்குப் பதிலாக நகர மெய் கடைப்போலியாக வரும் என்பது இலக்கண விதி.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 15, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vazhakku", "grammar", "kadaippoli", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q095", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-04-vazhakku", "chapter_id": null, "topic_id": "ta-t3-u1-mangalam-euphemism-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'சுடுகாடு' என்னும் சொல்லைப் பழந்தமிழர் 'நன்காடு' என மங்கல வழக்கால் வழங்கினர்.\nகாரணம் (R): மங்கலமில்லாத அமங்கலச் சொற்களை மாற்றி மங்கலமான சொற்களால் குறிப்பிடுவது தமிழர் பண்பாட்டு நெறியாகும்."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "C": "கூற்று தவறு, காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் பக்கம் 15: சுடுகாடு என்பதை நன்காடு என மங்கலமாக வழங்குவர். கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Ancient Tamils called a cremation ground ('Sudukaadu') as 'Nankaadu' in Mangala Vazhakku.\nReason (R): Substituting inauspicious terms with auspicious ones is an esteemed cultural ethos of the Tamils."}], "options": {"A": "Assertion is true, Reason is false", "B": "Both Assertion and Reason are true, and Reason is the correct explanation", "C": "Assertion is false, Reason is true", "D": "Both Assertion and Reason are false"}, "explanation": "Both A and R are textbook verified facts from page 15; cultural aversion to inauspicious words explains the usage of 'Nankaadu'."}}, "question_data": {"assertion": "'சுடுகாடு' என்னும் சொல்லைப் பழந்தமிழர் 'நன்காடு' என மங்கல வழக்கால் வழங்கினர்.", "reason": "மங்கலமில்லாத அமங்கலச் சொற்களை மாற்றி மங்கலமான சொற்களால் குறிப்பிடுவது தமிழர் பண்பாட்டு நெறியாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 15, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vazhakku", "grammar", "mangalam", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q096", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-04-vazhakku", "chapter_id": null, "topic_id": "ta-t3-u1-dakkaradakkal-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'கால் கழுவி வந்தான்' என்பது இடக்கரடக்கலுக்குரிய சான்றாகும்.\nகாரணம் (R): ஒரு குறிப்பிட்ட தொழிற்குழுவினர் தங்களுக்குள் புரியும்படி அமைத்துக் கொள்ளும் குறியீட்டுச் சொற்களே இடக்கரடக்கல் எனப்படும்."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று, காரணம் இரண்டும் சரி", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "கூற்று சரி: கால் கழுவி வந்தான் என்பது இடக்கரடக்கல். காரணம் தவறு: ஒரு தொழிற்குழுவினர் தங்களுக்குள் அமைத்துக் கொள்ளும் சொல் 'குழூஉக்குறி' எனப்படும்; இடக்கரடக்கல் என்பது நாகரிகமாக மறைத்துக் கூறுவது. எனவே காரணம் தவறு."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'Kaal kazhuvi vanthan' is an example of Idakkaradakkal.\nReason (R): Coded terms structured by a specific occupational guild for internal comprehension are called Idakkaradakkal."}], "options": {"A": "Assertion is true, Reason is false", "B": "Both Assertion and Reason are true", "C": "Assertion (A) is true, but Reason (R) is false", "D": "Both Assertion and Reason are false"}, "explanation": "Assertion is true. Reason defines Kuzhoo-ukkuri, not Idakkaradakkal. Hence Reason is false. Key C is correct."}}, "question_data": {"assertion": "'கால் கழுவி வந்தான்' என்பது இடக்கரடக்கலுக்குரிய சான்றாகும்.", "reason": "ஒரு குறிப்பிட்ட தொழிற்குழுவினர் தங்களுக்குள் புரியும்படி அமைத்துக் கொள்ளும் குறியீட்டுச் சொற்களே இடக்கரடக்கல் எனப்படும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 15, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vazhakku", "grammar", "idakkaradakkal", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q097", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-04-vazhakku", "chapter_id": null, "topic_id": "ta-t3-u1-mutharpoli-paisal-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'பசல்' என்னும் சொல் 'பைசல்' என வழங்குவது முதற்போலி ஆகும்.\nகாரணம் (R): சொல்லின் முதலெழுத்தான 'ப' என்பது 'பை' எனத் திரிந்து வந்தபோதிலும் அச்சொல்லின் பொருளில் எவ்வித மாற்றமும் ஏற்படவில்லை."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று, காரணம் இரண்டும் தவறு", "D": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது"}, "explanation": "பாடநூல் பக்கம் 15: பசல் -> பைசல், மஞ்சு -> மைஞ்சு. சொல்லின் முதல் எழுத்து மாறினாலும் பொருள் மாறாதிருப்பது முதற்போலி. கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'Pasal' pronounced as 'Paisal' is Mutharpoli.\nReason (R): Even though the initial letter 'Pa' changed to 'Pai', the word retains its original meaning without alteration."}], "options": {"A": "Assertion is true, Reason is false", "B": "Assertion is false, Reason is true", "C": "Both Assertion and Reason are false", "D": "Both Assertion and Reason are true, and Reason is the correct explanation"}, "explanation": "Both A and R are verified textbook facts from page 15, and R directly explains why it is Mutharpoli."}}, "question_data": {"assertion": "'பசல்' என்னும் சொல் 'பைசல்' என வழங்குவது முதற்போலி ஆகும்.", "reason": "சொல்லின் முதலெழுத்தான 'ப' என்பது 'பை' எனத் திரிந்து வந்தபோதிலும் அச்சொல்லின் பொருளில் எவ்வித மாற்றமும் ஏற்படவில்லை.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 15, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vazhakku", "grammar", "mutharpoli", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q098", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-04-vazhakku", "chapter_id": null, "topic_id": "ta-t3-u1-vazhakku-types-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வழக்கின் வகைகளையும் அவற்றுக்குரிய நேரடிச் சான்றுகளையும் பொருத்துக:\n(a) இலக்கணம் உடையது - 1. நிலம், மரம், எழுது\n(b) இலக்கணப் போலி - 2. முன்றில், புறநகர்\n(c) மரூஉ - 3. கோவை, தஞ்சை, நெல்லை\n(d) முற்றுப்போலி - 4. ஐந்து -> அஞ்சு"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-4, b-3, c-2, d-1", "D": "a-3, b-4, c-1, d-2"}, "explanation": "பாடநூல் பக்கங்கள் 13-16 நேரடிப் பொருத்தம்:\nஇலக்கணம் உடையது = 1\nஇலக்கணப் போலி = 2\nமரூஉ = 3\nமுற்றுப்போலி = 4.\nவரிசை: 1, 2, 3, 4."}, "en": {"blocks": [{"type": "text", "content": "Match the categories of Vazhakku with their representative textbook examples:\n(a) Ilakkanam Udaiyathu - 1. Nilam, Maram, Ezhuthu\n(b) Ilakkana Poli - 2. Mundril, Puranagar\n(c) Maru-u - 3. Kovai, Thanjai, Nellai\n(d) Mutruppoli - 4. Ainthu -> Anju"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-4, b-3, c-2, d-1", "D": "a-3, b-4, c-1, d-2"}, "explanation": "Direct textbook alignments from pages 13-16: 1, 2, 3, 4."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "இலக்கணம் உடையது", "content_en": "Ilakkanam Udaiyathu"}, {"id": "L2", "content_ta": "இலக்கணப் போலி", "content_en": "Ilakkana Poli"}, {"id": "L3", "content_ta": "மரூஉ", "content_en": "Maru-u"}, {"id": "L4", "content_ta": "முற்றுப்போலி", "content_en": "Mutruppoli"}], "right": [{"id": "R1", "content_ta": "நிலம், மரம், எழுது", "content_en": "Nilam, Maram, Ezhuthu"}, {"id": "R2", "content_ta": "முன்றில், புறநகர்", "content_en": "Mundril, Puranagar"}, {"id": "R3", "content_ta": "கோவை, தஞ்சை, நெல்லை", "content_en": "Kovai, Thanjai, Nellai"}, {"id": "R4", "content_ta": "ஐந்து -> அஞ்சு", "content_en": "Ainthu -> Anju"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 14, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["vazhakku", "grammar", "matching"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u1-q099", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-04-vazhakku", "chapter_id": null, "topic_id": "ta-t3-u1-thaguthi-vazhakku-examples-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தகுதி வழக்கின் பிரிவுகளையும் அவற்றுக்குரிய சான்றுகளையும் பொருத்துக:\n(a) இடக்கரடக்கல் - 1. செத்தார் -> இயற்கை எய்தினார்\n(b) மங்கலம் - 2. கால் கழுவி வந்தான்\n(c) குழூஉக்குறி (பொற்கொல்லர்) - 3. ஆடையைக் 'காரை' எனல்\n(d) குழூஉக்குறி (யானைப் பாகர்) - 4. பொன்னைப் 'பறி' எனல்"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-2, b-4, c-1, d-3", "D": "a-3, b-1, c-4, d-2"}, "explanation": "பாடநூல் பக்கம் 15:\nஇடக்கரடக்கல் = கால் கழுவி வந்தான் (2)\nமங்கலம் = செத்தார் -> இயற்கை எய்தினார் (1)\nகுழூஉக்குறி (பொற்கொல்லர்) = பொன்னைப் பறி எனல் (4)\nகுழூஉக்குறி (யானைப் பாகர்) = ஆடையைக் காரை எனல் (3).\nவரிசை: 2, 1, 4, 3."}, "en": {"blocks": [{"type": "text", "content": "Match the Thaguthi Vazhakku divisions with their exact examples:\n(a) Idakkaradakkal - 1. Sethaar -> Iyarkkai eithinaar\n(b) Mangalam - 2. Kaal kazhuvi vanthan\n(c) Kuzhoo-ukkuri (Goldsmith) - 3. Cloth as 'Kaarai'\n(d) Kuzhoo-ukkuri (Mahout) - 4. Gold as 'Pari'"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-2, b-4, c-1, d-3", "D": "a-3, b-1, c-4, d-2"}, "explanation": "Correct alignment: Idakkaradakkal = 2, Mangalam = 1, Goldsmith = 4, Mahout = 3. Sequence: 2, 1, 4, 3."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "இடக்கரடக்கல்", "content_en": "Idakkaradakkal"}, {"id": "L2", "content_ta": "மங்கலம்", "content_en": "Mangalam"}, {"id": "L3", "content_ta": "குழூஉக்குறி (பொற்கொல்லர்)", "content_en": "Kuzhoo-ukkuri (Goldsmith)"}, {"id": 