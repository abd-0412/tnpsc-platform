{"id": "7th-t3-u1-q056", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-02-tirunelveli", "chapter_id": null, "topic_id": "ta-t3-u1-direct-bookback-nellai-second-capital", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருநெல்வேலி யாருடைய இரண்டாவது தலைநகரமாகத் திகழ்ந்தது?"}], "options": {"A": "சேரர்கள்", "B": "சோழர்கள்", "C": "பல்லவர்கள்", "D": "பாண்டியர்கள்"}, "explanation": "பாடநூல் பக்கம் 4: பாண்டியர்களின் தலைநகரமாக மதுரை விளங்கியது; அவர்களின் இரண்டாவது தலைநகரமாகத் திருநெல்வேலி திகழ்ந்தது."}, "en": {"blocks": [{"type": "text", "content": "Tirunelveli functioned as the secondary capital of which royal dynasty?"}], "options": {"A": "Cheras", "B": "Cholas", "C": "Pallavas", "D": "Pandyas"}, "explanation": "Textbook page 4: Madurai was the primary capital and Tirunelveli served as the second capital of the Pandyas."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 4, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name"