{"id": "7th-t3-u1-q049", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-02-tirunelveli", "chapter_id": null, "topic_id": "ta-t3-u1-grammar-maru-u-nellai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'திருநெல்வேலி' என்னும் பெயர் 'நெல்லை' என வழங்குவது எவ்வகை வழக்காகும்?"}], "options": {"A": "இலக்கணப் போலி", "B": "மரூஉ", "C": "இடக்கரடக்கல்", "D": "குழூஉக்குறி"}, "explanation": "பாடநூல் பக்கம் 14: காலப்போக்கில் சிதைந்து மருவி வழங்கும் சொற்கள் 'மரூஉ' எனப்படும். திருநெல்வேலி -> நெல்லை, கோயம்புத்தூர் -> கோவை, தஞ்சாவூர் -> தஞ்சை ஆகியவை மரூஉ ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What grammatical category of Vazhakku is exemplified when 'Tirunelveli' is spoken as 'Nellai'?"}], "options": {"A": "Ilakkana Poli", "B": "Maru-u", "C": "Idakkaradakkal", "D": "Kuzhoo-ukkuri"}, "explanation": "Page 14: Words corrupted phonetically through historical usage are Maru-u. Tirunelveli -> Nellai is a classic Maru-u."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 14, "chapter": null, "section": null, "reference": null, "ur