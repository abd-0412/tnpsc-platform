// 7-ஆம் வகுப்பு தமிழ் - பருவம் 3 - TNPSC முந்தைய ஆண்டு வினாக்கள், இலக்கண நுட்பங்கள் & பழைய சமச்சீர் இணைப்பு (மொத்த வினாக்கள்: 84)
// ==============================================================================
// ==============================================================================
// பாடம் 14: TNPSC 10 ஆண்டு முந்தைய வினாத்தாள் தொகுப்பு (TNPSC 10-Year PYQ Benchmarks) [Q365 - Q392]
// திருநெல்வேலி இலக்கிய மேற்கோள்கள் (சம்பந்தர், சேக்கிழார், இளங்கோவடிகள், நற்றிணை), ரசிகமணி டி.கே.சி & வட்டத்தொட்டி, பொதிகை மலை & தண்பொருநை தாமிரபரணி நதி, ஆதிச்சநல்லூர் & கொற்கை முத்து, புதுமை விளக்கு (பொய்கையாழ்வார், பூதத்தாழ்வார்), அறநெறிச்சாரம் (முனைப்பாடியார்), கண்ணியமிகு காயிதே மில்லத் (சுதந்திரப் போராட்டம், மொழி உரிமை, தூய தலைவர்), பாவண்ணன் 'பயணம்', வழக்கு & போலி, வினா & விடை வகைகள், திருக்குறள் அறக்கருத்துகள்
// ==============================================================================
{"id": "7th-t3-u4-q365", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-pyq-bridging", "lesson_id": "lesson-02-thirunelveli", "chapter_id": null, "topic_id": "ta-t3-pyq-thirunelveli-quotes-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "TNPSC முந்தைய ஆண்டு வினாக்களில் இடம்பெற்ற திருநெல்வேலி இலக்கிய மேற்கோள்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'திக்கெல்லாம் புகழுறும் திருநெல்வேலி' என்று பாடியவர் திருஞானசம்பந்தர் ஆவார் (தேவாரம்).\n2. 'தன் பொருநைப் புனல் நாடு' என்று திருநெல்வேலியின் நீர்வளத்தைப் புகழ்ந்தவர் சேக்கிழார் ஆவார் (பெரியபுராணம்).\n3. 'பொதியில் ஆயினும் இமயம் ஆயினும் ஓங்குயர் உச்சியிற் பெயர் பெற்றோங்கி' என்று பாடியவர் இளங்கோவடிகள் (சிலப்பதிகாரம்).\n4. 'முத்துப்படு பரப்பிற் கொற்கை முன்துறை' என்று கொற்கை முத்து வளத்தைப் பாடிய நூல் நற்றிணை ஆகும்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2 மட்டுமே சரியானவை", "C": "கூற்றுகள் 1, 3, 4 சரியானவை; 2 தவறானது", "D": "கூற்றுகள் 2, 4 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் இயல் 1 பக்கம் 4: சம்பந்தர் - திக்கெல்லாம் புகழுறும் திருநெல்வேலி; சேக்கிழார் - தன் பொருநைப் புனல் நாடு; இளங்கோவடிகள் - பொதியில் ஆயினும் இமயம் ஆயினும்; நற்றிணை - முத்துப்படு பரப்பிற் கொற்கை முன்துறை. நான்கு கூற்றுகளும் டிஎன்பிஎஸ்சி தேர்வுகளில் கேட்கப்பட்ட மிக முக்கியமான வினாக்களாகும்."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Tirunelveli literary quotations from TNPSC PYQs:\n1. 'Thikkellam pugazhurum Tirunelveli' was sung by Thirugnanasambandar in Thevaram.\n2. 'Than porunai-p punal naadu' was sung by Sekkizhar in Periyapuranam.\n3. 'Pothiyil aayinum imayam aayinum...' was authored by Ilangovadigal in Silappathikaram.\n4. 'Muthuppadu parappir Korkai munthurai' is a Sangam verse from Natrinai.\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 2 only are correct", "C": "Statements 1, 3, 4 are correct; 2 is incorrect", "D": "Statements 2, 4 only are correct"}, "explanation": "All 4 quotes are foundational TNPSC benchmarks cited directly on textbook page 4. All 4 statements are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'திக்கெல்லாம் புகழுறும் திருநெல்வேலி' என்று பாடியவர் திருஞானசம்பந்தர் ஆவார் (தேவாரம்).", "content_en": "'Thikkellam pugazhurum Tirunelveli' was sung by Thiru-gnana-sambandar (Thevaram)."}, {"id": "S2", "content_ta": "'தன் பொருநைப் புனல் நாடு' என்று திருநெல்வேலியின் நீர்வளத்தைப் புகழ்ந்தவர் சேக்கிழார் ஆவார் (பெரியபுராணம்).", "content_en": "'Than porunai-p punal naadu' was praised by Sekkizhar (Periyapuranam)."}, {"id": "S3", "content_ta": "'பொதியில் ஆயினும் இமயம் ஆயினும் ஓங்குயர் உச்சியிற் பெயர் பெற்றோங்கி' என்று பாடியவர் இளங்கோவடிகள் (சிலப்பதிகாரம்).", "content_en": "'Pothiyil aayinum imayam aayinum...' was composed by Ilangovadigal (Silappathikaram)."}, {"id": "S4", "content_ta": "'முத்துப்படு பரப்பிற் கொற்கை முன்துறை' என்று கொற்கை முத்து வளத்தைப் பாடிய நூல் நற்றிணை ஆகும்.", "content_en": "'Muthuppadu parappir Korkai munthurai' is a line from Natrinai."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 4, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tnpsc_pyq", "thirunelveli", "literary_quotes", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u4-q366", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-pyq-bridging", "lesson_id": "lesson-03-tkc", "chapter_id": null, "topic_id": "ta-t3-pyq-tkc-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "TNPSC தேர்வுகளில் அடிக்கடி கேட்கப்படும் ரசிகமணி டி.கே.சி குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. ரசிகமணி டி.கே. சிதம்பரநாதர் வழக்கறிஞர் தொழில் செய்தவர்; தமிழ் எழுத்தாளராகவும் திறனாய்வாளராகவும் புகழ் பெற்றவர்.\n2. இவர் தமது வீட்டில் 'வட்டத்தொட்டி' என்னும் பெயரில் இலக்கிய அமைப்பினை நடத்தி வந்தார்.\n3. டி.கே.சி அவர்களின் கடிதங்கள் இலக்கியத் தரம் வாய்ந்தவை; இவர் கடித இலக்கியத்தின் முன்னோடியாகப் போற்றப்படுகிறார்.\n4. ரசிகமணி டி.கே.சி அவர்களுக்கு ஆங்கிலக் கவிஞர் எட்வின் அர்னால்டின் 'ஆசிய ஜோதி' நூலைத் தமிழில் மொழிபெயர்த்த பெருமை உண்டு.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2, 3 சரியானவை; கூற்று 4 தவறானது", "C": "கூற்றுகள் 1, 4 மட்டுமே சரியானவை", "D": "கூற்றுகள் 2, 4 மட்டுமே சரியானவை"}, "explanation": "கூற்று 4 தவறானது. 'ஆசிய ஜோதி' நூலை மொழிபெயர்த்தவர் கவிமணி தேசிக விநாயகம் பிள்ளை ஆவார் (டி.கே.சி அன்று). டி.கே.சி 'இதய ஒலி' நூலை எழுதியவர். கூற்றுகள் 1, 2, 3 பாடநூல் பக்கம் 11 நூல்வெளியின்படி சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Rasigamani T.K.C. frequently asked in TNPSC exams:\n1. T.K.C. practiced law and was a renowned Tamil writer and critic.\n2. He organized a literary forum called 'Vattathotti' at his residence.\n3. T.K.C. is revered as a pioneer of Tamil epistolary (letter) literature.\n4. T.K.C. translated Edwin Arnold's 'The Light of Asia' into Tamil.\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 2, 3 are correct; statement 4 is incorrect", "C": "Statements 1, 4 only are correct", "D": "Statements 2, 4 only are correct"}, "explanation": "Statement 4 is false. 'The Light of Asia' was translated as 'Aasiya Jothi' by Kavimani Desigavinayagam Pillai. Statements 1, 2, and 3 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ரசிகமணி டி.கே. சிதம்பரநாதர் வழக்கறிஞர் தொழில் செய்தவர்; தமிழ் எழுத்தாளராகவும் திறனாய்வாளராகவும் புகழ் பெற்றவர்.", "content_en": "Rasigamani T.K.C. practiced law and achieved fame as an essayist and literary critic."}, {"id": "S2", "content_ta": "இவர் தமது வீட்டில் 'வட்டத்தொட்டி' என்னும் பெயரில் இலக்கிய அமைப்பினை நடத்தி வந்தார்.", "content_en": "He ran a literary circle named 'Vattathotti' at his residence."}, {"id": "S3", "content_ta": "டி.கே.சி அவர்களின் கடிதங்கள் இலக்கியத் தரம் வாய்ந்தவை; இவர் கடித இலக்கியத்தின் முன்னோடியாகப் போற்றப்படுகிறார்.", "content_en": "T.K.C.'s letters are literary treasures; he is hailed as a pioneer of epistolary literature."}, {"id": "S4", "content_ta": "ரசிகமணி டி.கே.சி அவர்களுக்கு ஆங்கிலக் கவிஞர் எட்வின் அர்னால்டின் 'ஆசிய ஜோதி' நூலைத் தமிழில் மொழிபெயர்த்த பெருமை உண்டு.", "content_en": "Rasigamani T.K.C. translated Edwin Arnold's 'The Light of Asia' into Tamil."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 11, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tnpsc_pyq", "tkc", "vattathotti", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u4-q367", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-pyq-bridging", "lesson_id": "lesson-05-puthumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-pyq-azhwars-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "TNPSC தேர்வுகளில் வைணவ இலக்கியம் சார்ந்து கேட்கப்படும் முதலாழ்வார்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. பொய்கையாழ்வார், பூதத்தாழ்வார், பேயாழ்வார் ஆகிய மூவரும் 'முதலாழ்வார்கள்' எனப் போற்றப்படுகின்றனர்.\n2. பொய்கையாழ்வார் பாடியது 'முதல் திருவந்தாதி' (வையம் தகளியா வார்கடலே நெய்யாக...).\n3. பூதத்தாழ்வார் பாடியது 'இரண்டாம் திருவந்தாதி' (அன்பே தகளியா ஆர்வமே நெய்யாக...).\n4. பொய்கையாழ்வார் மாமல்லபுரத்திலும், பூதத்தாழ்வார் காஞ்சிபுரத்திலும் பிறந்தவர்கள் ஆவர்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 4 மட்டுமே சரியானவை", "C": "கூற்றுகள் 1, 2, 3 சரியானவை; கூற்று 4 தவறானது", "D": "கூற்றுகள் 2, 4 மட்டுமே சரியானவை"}, "explanation": "கூற்று 4 தவறானது. பொய்கையாழ்வார் பிறந்த ஊர் காஞ்சிபுரம் (திருவெஃகா); பூதத்தாழ்வார் பிறந்த ஊர் மாமல்லபுரம் ஆகும். பிறந்த ஊர்கள் தலைகீழாக மாற்றப்பட்டுள்ளன. கூற்றுகள் 1, 2, 3 பாடநூல் பக்கம் 21-ன் படி சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on the First Azhwars from Vaishnavite literature in TNPSC PYQs:\n1. Poigai, Bootham, and Peyazhwar are celebrated as the 'First Azhwars'.\n2. Poigai Azhwar sang the First Thiruvandhadhi ('Vaiyam thagaliyaa...').\n3. Boothathazhwar sang the Second Thiruvandhadhi ('Anbae thagaliyaa...').\n4. Poigai Azhwar was born in Mamallapuram and Boothathazhwar in Kanchipuram.\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 4 only are correct", "C": "Statements 1, 2, 3 are correct; statement 4 is incorrect", "D": "Statements 2, 4 only are correct"}, "explanation": "Statement 4 is false. Poigai Azhwar was born in Kanchipuram and Boothathazhwar in Mamallapuram (birthplaces swapped). Statements 1, 2, and 3 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பொய்கையாழ்வார், பூதத்தாழ்வார், பேயாழ்வார் ஆகிய மூவரும் 'முதலாழ்வார்கள்' எனப் போற்றப்படுகின்றனர்.", "content_en": "Poigai Azhwar, Boothathazhwar, and Peyazhwar are revered as the First Azhwars."}, {"id": "S2", "content_ta": "பொய்கையாழ்வார் பாடியது 'முதல் திருவந்தாதி' (வையம் தகளியா வார்கடலே நெய்யாக...).", "content_en": "Poigai Azhwar composed the First Thiruvandhadhi ('Vaiyam thagaliyaa...')."}, {"id": "S3", "content_ta": "பூதத்தாழ்வார் பாடியது 'இரண்டாம் திருவந்தாதி' (அன்பே தகளியா ஆர்வமே நெய்யாக...).", "content_en": "Boothathazhwar composed the Second Thiruvandhadhi ('Anbae thagaliyaa...')."}, {"id": "S4", "content_ta": "பொய்கையாழ்வார் மாமல்லபுரத்திலும், பூதத்தாழ்வார் காஞ்சிபுரத்திலும் பிறந்தவர்கள் ஆவர்.", "content_en": "Poigai Azhwar was born in Mamallapuram and Boothathazhwar in Kanchipuram."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 21, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tnpsc_pyq", "azhwars", "pudhuvai_vilakku", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u4-q368", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-pyq-bridging", "lesson_id": "lesson-01-virundhombal", "chapter_id": null, "topic_id": "ta-t3-pyq-didactic-texts-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "TNPSC அறநூல்கள் பகுதியில் கேட்கப்படும் பழமொழி நானூறு மற்றும் அறநெறிச்சாரம் குறித்த பின்வரும் கூற்றுகளில் தவறான கூற்றைக் கண்டறிக:\n1. பழமொழி நானூறு நூலின் ஆசிரியர் முன்றுறை அரையனார்; இவர் கி.பி. 4-ஆம் நூற்றாண்டைச் சேர்ந்த சமணர் ஆவார்.\n2. அறநெறிச்சாரம் நூலின் ஆசிரியர் முனைப்பாடியார்; இவர் 13-ஆம் நூற்றாண்டைச் சேர்ந்த சமணப் புலவர்.\n3. பழமொழி நானூறு 400 வெண்பாக்களையும், அறநெறிச்சாரம் 225 பாடல்களையும் கொண்ட அறநூல்கள் ஆகும்.\n4. முன்றுறை அரையனாரும் முனைப்பாடியாரும் கிறித்தவக் காப்பியங்களைப் பாடிய புலவர்கள் ஆவர்."}], "options": {"A": "கூற்று 1 தவறானது", "B": "கூற்று 2 தவறானது", "C": "கூற்று 3 தவறானது", "D": "கூற்று 4 தவறானது"}, "explanation": "கூற்று 4 முற்றிலும் தவறானது. முன்றுறை அரையனார் மற்றும் முனைப்பாடியார் இருவரும் 'சமண சமயத்தைச்' சேர்ந்த அறநெறிப் புலவர்கள் ஆவர். கிறித்தவக் கம்பன் எனப் போற்றப்பட்டவர் எச்.ஏ. கிருஷ்ணப்பிள்ளை. எனவே கூற்று 4 தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Identify the incorrect statement regarding Pazhamozhi Naanooru and Aranericharam from TNPSC tests:\n1. Author of Pazhamozhi Naanooru is Mundrurai Araiyanaar, a 4th-century Jain.\n2. Author of Aranericharam is Munaippaadiyaar, a 13th-century Jain poet.\n3. Pazhamozhi Naanooru has 400 verses and Aranericharam has 225 verses.\n4. Mundrurai Araiyanaar and Munaippaadiyaar were Christian epic poets."}], "options": {"A": "Statement 1 is incorrect", "B": "Statement 2 is incorrect", "C": "Statement 3 is incorrect", "D": "Statement 4 is incorrect"}, "explanation": "Statement 4 is false. Both Mundrurai Araiyanaar and Munaippaadiyaar were Jain moral poets, not Christian epic poets. Statements 1, 2, and 3 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பழமொழி நானூறு நூலின் ஆசிரியர் முன்றுறை அரையனார்; இவர் கி.பி. 4-ஆம் நூற்றாண்டைச் சேர்ந்த சமணர் ஆவார்.", "content_en": "Author of Pazhamozhi Naanooru is Mundrurai Araiyanaar, a 4th-century Jain scholar."}, {"id": "S2", "content_ta": "அறநெறிச்சாரம் நூலின் ஆசிரியர் முனைப்பாடியார்; இவர் 13-ஆம் நூற்றாண்டைச் சேர்ந்த சமணப் புலவர்.", "content_en": "Author of Aranericharam is Munaippaadiyaar, a 13th-century Jain poet."}, {"id": "S3", "content_ta": "பழமொழி நானூறு 400 வெண்பாக்களையும், அறநெறிச்சாரம் 225 பாடல்களையும் கொண்ட அறநூல்கள் ஆகும்.", "content_en": "Pazhamozhi Naanooru has 400 venbas and Aranericharam has 225 verses."}, {"id": "S4", "content_ta": "முன்றுறை அரையனாரும் முனைப்பாடியாரும் கிறித்தவக் காப்பியங்களைப் பாடிய புலவர்கள் ஆவர்.", "content_en": "Mundrurai Araiyanaar and Munaippaadiyaar authored Christian epic poetry."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tnpsc_pyq", "pazhamozhi_naanooru", "aranericharam", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u4-q369", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-pyq-bridging", "lesson_id": "lesson-12-kayithe-millath", "chapter_id": null, "topic_id": "ta-t3-pyq-km-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "TNPSC தலைவர்கள் ஆளுமைப் பகுதியில் காயிதே மில்லத் குறித்துக் கேட்கப்படும் பின்வரும் கூற்றுகளை ஆராய்க:\n1. காயிதே மில்லத் முகம்மது இஸ்மாயில் 1920-ல் காந்தியடிகளின் அழைப்பை ஏற்று ஒத்துழையாமை இயக்கத்தில் இணைந்தார்.\n2. இந்திய அரசியல் நிர்ணய சபையில், பழமையான மொழிகளுள் ஒன்றான தமிழ்மொழியை ஆட்சிமொழியாக்க வேண்டும் என வாதிட்டார்.\n3. 'தமிழக அரசியல் வானில் கவ்வியிருந்த காரிருளை அகற்ற வந்த ஒளிக்கதிர்' என்று அண்ணாவால் போற்றப்பட்டார்.\n4. 'இப்படிப்பட்ட தலைவர் கிடைப்பது அரிது; நல்ல உத்தமமான மனிதர்' என்று பெரியாரால் பாராட்டப்பட்டார்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2 மட்டுமே சரியானவை", "C": "கூற்றுகள் 1, 3, 4 சரியானவை; 2 தவறானது", "D": "கூற்றுகள் 2, 3 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் பக்கம் 51-53: ஒத்துழையாமை இயக்கம், தமிழ் ஆட்சிமொழி வாதம், அண்ணா மற்றும் பெரியாரின் பாராட்டுரைகள் ஆகியவை டிஎன்பிஎஸ்சி தேர்வுகளில் பலமுறை கேட்கப்பட்ட நேரடி வினாக்களாகும். நான்கு கூற்றுகளும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Kayidhe Millath from TNPSC leader-profile questions:\n1. He joined the Non-Cooperation movement in 1920 answering Gandhi's call.\n2. He advocated Tamil as the official language in the Constituent Assembly.\n3. Anna praised him as the beam of light dispelling political gloom.\n4. Periyar commended him as a rare and upright noble leader.\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 2 only are correct", "C": "Statements 1, 3, 4 are correct; 2 is incorrect", "D": "Statements 2, 3 only are correct"}, "explanation": "All four statements are repeated TNPSC exam questions regarding Kayidhe Millath's life and tributes. All 4 statements are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "காயிதே மில்லத் முகம்மது இஸ்மாயில் 1920-ல் காந்தியடிகளின் அழைப்பை ஏற்று ஒத்துழையாமை இயக்கத்தில் இணைந்தார்.", "content_en": "Kayidhe Millath joined the Non-Cooperation Movement in 1920 responding to Gandhiji."}, {"id": "S2", "content_ta": "இந்திய அரசியல் நிர்ணய சபையில், பழமையான மொழிகளுள் ஒன்றான தமிழ்மொழியை ஆட்சிமொழியாக்க வேண்டும் என வாதிட்டார்.", "content_en": "He advocated Tamil as official language in the Constituent Assembly."}, {"id": "S3", "content_ta": "'தமிழக அரசியல் வானில் கவ்வியிருந்த காரிருளை அகற்ற வந்த ஒளிக்கதிர்' என்று அண்ணாவால் போற்றப்பட்டார்.", "content_en": "He was praised by Anna as the beam of light dispelling political darkness."}, {"id": "S4", "content_ta": "'இப்படிப்பட்ட தலைவர் கிடைப்பது அரிது; நல்ல உத்தமமான மனிதர்' என்று பெரியாரால் பாராட்டப்பட்டார்.", "content_en": "He was acclaimed by Periyar as a rare, upright noble human being."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 53, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tnpsc_pyq", "kayithe_millath", "leaders", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u4-q370", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-pyq-bridging", "lesson_id": "lesson-10-malaippozhivu", "chapter_id": null, "topic_id": "ta-t3-pyq-kannadasan-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "TNPSC கவிஞர்கள் பகுதியில் கண்ணதாசன் குறித்துக் கேட்கப்படும் பின்வரும் கூற்றுகளை ஆராய்க:\n1. கண்ணதாசனின் இயற்பெயர் முத்தையா; பிறந்த ஊர் சிறுகூடல்பட்டி.\n2. கண்ணதாசன் எழுதிய 'சேரமான் காதலி' என்னும் புதினத்திற்குச் சாகித்திய அகாதெமி விருது கிடைத்தது.\n3. இயேசுவின் வரலாற்றையும் போதனைகளையும் கூறும் 'இயேசு காவியம்' என்னும் நூலை இயற்றினார்.\n4. கண்ணதாசன் 'குற்றாலக் குறவஞ்சி' என்னும் புகழ்பெற்ற நாடக நூலை இயற்றினார்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2, 3 சரியானவை; கூற்று 4 தவறானது", "C": "கூற்றுகள் 1, 4 மட்டுமே சரியானவை", "D": "கூற்றுகள் 2, 4 மட்டுமே சரியானவை"}, "explanation": "கூற்று 4 தவறானது. 'திருக்குற்றாலக் குறவஞ்சி' மேலகரம் திரிகூடராசப்பக் கவிராயரால் இயற்றப்பட்டது ஆகும்; கண்ணதாசனுடையது அல்ல. 1, 2, 3 ஆகிய கூற்றுகள் பாடநூல் பக்கம் 47 நூல்வெளியின்படி சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Kannadasan from TNPSC poet-profile questions:\n1. Kannadasan's birth name was Muthaiah; birthplace was Sirukoodalpatti.\n2. His novel 'Cheraman Kaadhali' won the Sahitya Akademi Award.\n3. He authored the epic 'Yesu Kaaviyam' on the life and teachings of Jesus.\n4. Kannadasan authored the famous musical dance drama 'Kutralak Kuravanji'.\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 2, 3 are correct; statement 4 is incorrect", "C": "Statements 1, 4 only are correct", "D": "Statements 2, 4 only are correct"}, "explanation": "Statement 4 is false. Kutralak Kuravanji was composed by Thirikooda Rasappa Kavirayar. Statements 1, 2, and 3 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "கண்ணதாசனின் இயற்பெயர் முத்தையா; பிறந்த ஊர் சிறுகூடல்பட்டி.", "content_en": "Kannadasan's birth name was Muthaiah; born in Sirukoodalpatti."}, {"id": "S2", "content_ta": "கண்ணதாசன் எழுதிய 'சேரமான் காதலி' என்னும் புதினத்திற்குச் சாகித்திய அகாதெமி விருது கிடைத்தது.", "content_en": "Kannadasan was awarded the Sahitya Akademi Award for his novel Cheraman Kaadhali."}, {"id": "S3", "content_ta": "இயேசுவின் வரலாற்றையும் போதனைகளையும் கூறும் 'இயேசு காவியம்' என்னும் நூலை இயற்றினார்.", "content_en": "He authored 'Yesu Kaaviyam' chronicling the life and sermon of Jesus Christ."}, {"id": "S4", "content_ta": "கண்ணதாசன் 'குற்றாலக் குறவஞ்சி' என்னும் புகழ்பெற்ற நாடக நூலை இயற்றினார்.", "content_en": "Kannadasan authored the famous drama work Kutralak Kuravanji."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 47, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tnpsc_pyq", "kannadasan", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u4-q371", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-pyq-bridging", "lesson_id": "lesson-07-oppuravu-neri", "chapter_id": null, "topic_id": "ta-t3-pyq-famous-lines-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "TNPSC தேர்வுகளில் கேட்கப்படும் புகழ்பெற்ற மேற்கோள்கள் குறித்த பின்வரும் கூற்றுகளில் தவறான கூற்றைத் தேர்க:\n1. 'செல்வத்துப் பயனே ஈதல்' - புறநானூறு (மதுரை நக்கீரனார்).\n2. 'ஒன்றுறா முன்றில் இல்' - பழமொழி நானூறு (முன்றுறை அரையனார்).\n3. 'வானரங்கள் கனிகொடுத்து மந்தியொடு கொஞ்சும்' - திருக்குற்றாலக் குறவஞ்சி (திரிகூடராசப்பக் கவிராயர்).\n4. 'செல்வத்துப் பயனே ஈதல்' என்னும் பாடல் வரி கம்பராமாயணத்தில் இடம்பெற்றுள்ளது."}], "options": {"A": "கூற்று 1 தவறானது", "B": "கூற்று 2 தவறானது", "C": "கூற்று 4 தவறானது", "D": "கூற்று 3 தவறானது"}, "explanation": "கூற்று 4 தவறானது. 'செல்வத்துப் பயனே ஈதல் / துய்ப்பேம் எனினே தப்புந பலவே' என்பது புறநானூற்றுப் பாடலாகும் (பாடல் 189 - மதுரை நக்கீரனார்); கம்பராமாயணம் அன்று. எனவே கூற்று 4 தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Identify the incorrect statement among famous quotes frequently tested in TNPSC exams:\n1. 'Selvathu payane eethal' is from Purananooru (Madurai Nakkiranar).\n2. 'Ondruraa mundril il' is from Pazhamozhi Naanooru (Mundrurai Araiyanaar).\n3. 'Vaanarangal kani koduthu...' is from Thirukutralak Kuravanji (Thirikoodarasappar).\n4. The verse 'Selvathu payane eethal' occurs in Kamba Ramayanam."}], "options": {"A": "Statement 1 is incorrect", "B": "Statement 2 is incorrect", "C": "Statement 4 is incorrect", "D": "Statement 3 is incorrect"}, "explanation": "Statement 4 is false. 'Selvathu payane eethal' is a celebrated Sangam verse from Purananooru 189 by Madurai Nakkiranar, not from Kamba Ramayanam."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'செல்வத்துப் பயனே ஈதல்' - புறநானூறு (மதுரை நக்கீரனார்).", "content_en": "'Selvathu payane eethal' - Purananooru (Madurai Nakkiranar)."}, {"id": "S2", "content_ta": "'ஒன்றுறா முன்றில் இல்' - பழமொழி நானூறு (முன்றுறை அரையனார்).", "content_en": "'Ondruraa mundril il' - Pazhamozhi Naanooru (Mundrurai Araiyanaar)."}, {"id": "S3", "content_ta": "'வானரங்கள் கனிகொடுத்து மந்தியொடு கொஞ்சும்' - திருக்குற்றாலக் குறவஞ்சி (திரிகூடராசப்பக் கவிராயர்).", "content_en": "'Vaanarangal kani koduthu...' - Thirukutralak Kuravanji (Thirikoodarasappar)."}, {"id": "S4", "content_ta": "'செல்வத்துப் பயனே ஈதல்' என்னும் பாடல் வரி கம்பராமாயணத்தில் இடம்பெற்றுள்ளது.", "content_en": "The line 'Selvathu payane eethal' occurs in Kamba Ramayanam."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 27, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tnpsc_pyq", "purananooru", "famous_lines", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u4-q372", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-pyq-bridging", "lesson_id": "lesson-02-thirunelveli", "chapter_id": null, "topic_id": "ta-t3-pyq-korkai-pearls-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): பாண்டியர்களின் துறைமுகமான கொற்கையில் முத்து குளித்தல் எக்காலத்திலும் நடைபெறவில்லை.\nகாரணம் (R): கிரேக்க, உரோமப் பயணிகள் கொற்கை முத்தினைப் பற்றித் தங்களது பயணக் குறிப்புகளில் எங்கும் குறிப்பிடவில்லை."}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "B": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் கூற்றை விளக்கவில்லை", "C": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A) மற்றும் காரணம் (R) ஆகிய இரண்டும் தவறானவை"}, "explanation": "கூற்று, காரணம் இரண்டும் முற்றிலும் தவறானவை. கொற்கை முத்து உலகப் புகழ்பெற்றது. நற்றிணை, அகநானூறு முதலான சங்க இலக்கியங்களும், மார்க்கோ போலோ போன்ற வெளிநாட்டுப் பயணிகளின் குறிப்புகளும் கொற்கை முத்தின் சிறப்பைப் பறைசாற்றுகின்றன. எனவே இரண்டுமே தவறானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the assertion and reason:\nAssertion (A): Pearl diving never occurred at any point in history at the Pandyan port of Korkai.\nReason (R): Greek and Roman travelers made no mention of Korkai pearls in their travelogues."}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation of (A)", "B": "Both (A) and (R) are true, but (R) is not the correct explanation of (A)", "C": "(A) is true, but (R) is false", "D": "Both (A) and (R) are false"}, "explanation": "Both (A) and (R) are false. Korkai was globally famed for pearl fisheries, testified by Natrinai, Agananooru, and Marco Polo."}}, "question_data": {"assertion": {"ta": "கொற்கையில் முத்து குளித்தல் எக்காலத்திலும் நடைபெறவில்லை.", "en": "Pearl fishing never occurred in Korkai."}, "reason": {"ta": "வெளிநாட்டுப் பயணிகள் கொற்கை முத்தினைப் பற்றிக் குறிப்பிடவில்லை.", "en": "Foreign travelers made no mention of Korkai pearls."}, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 5, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tnpsc_pyq", "korkai", "pearls", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u4-q373", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-pyq-bridging", "lesson_id": "lesson-03-tkc", "chapter_id": null, "topic_id": "ta-t3-pyq-tkc-epistolary-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): ரசிகமணி டி.கே.சிதம்பரநாதர் 'கடித இலக்கியத்தின் முன்னோடி' என்று போற்றப்படுகிறார்.\nகாரணம் (R): நண்பர்களுக்கு அவர் எழுதிய கடிதங்கள் ஆழமான இலக்கிய நயமும், கவிதைச் சுவையும், எளிய உரையாடல் நடையும் கொண்டு கடிதத்தை ஓர் இலக்கிய வடிவமாக உயர்த்தின."}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) கூற்றிற்கு (A) சரியான விளக்கமாகும்", "B": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் சரியான விளக்கமல்ல", "C": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A) தவறு; காரணம் (R) சரி"}, "explanation": "பாடநூல் பக்கம் 11 நூல்வெளி: டி.கே.சி கடித இலக்கியத்தின் முன்னோடி எனப் போற்றப்படுகிறார்; அவரது கடிதங்கள் இலக்கியச் சுவை ததும்பும் நடை கொண்டவை. கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Examine the assertion and reason:\nAssertion (A): Rasigamani T.K. Chidambaranathar is revered as the 'Pioneer of Tamil Epistolary Literature'.\nReason (R): His personal letters to friends possessed profound literary charm, poetic aesthetic, and lucid conversational style, elevating letters to an art form."}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation of (A)", "B": "Both (A) and (R) are true, but (R) is not the correct explanation of (A)", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Page 11 Source Note: T.K.C. pioneered epistolary literature in Tamil through his literary letters. Both (A) and (R) are true, and (R) explains (A)."}}, "question_data": {"assertion": {"ta": "டி.கே.சிதம்பரநாதர் 'கடித இலக்கியத்தின் முன்னோடி' எனப் போற்றப்படுகிறார்.", "en": "T.K.C. is revered as the pioneer of epistolary literature."}, "reason": {"ta": "அவரது கடிதங்கள் இலக்கிய நயமும் கவிதைச் சுவையும் கொண்டு கடிதத்தை இலக்கியமாக உயர்த்தின.", "en": "His letters possessed poetic aesthetic and elevated letters to literature."}, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 11, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tnpsc_pyq", "tkc", "epistolary", "letters", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u4-q374", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-pyq-bridging", "lesson_id": "lesson-05-puthumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-pyq-azhwars-metaphor-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): பொய்கையாழ்வாரும் பூதத்தாழ்வாரும் அகல்விளக்கின் உறுப்புகளைத் தங்களது பக்தி உணர்வுகளோடு உருவகம் செய்து பாடியுள்ளனர்.\nகாரணம் (R): இவ்விரு ஆழ்வார்களின் பாடல்களும் நாலாயிர திவ்வியப் பிரபந்தத்தில் முதலிரு திருவந்தாதிகளாகத் தொகுக்கப்பட்டுள்ளன."}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "B": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் கூற்றின் நேரடி விளக்கமல்ல", "C": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A) தவறு; காரணம் (R) சரி"}, "explanation": "கூற்று சரி (பொய்கையார் பூமியை அகலாகவும் பூதத்தார் அன்பை அகலாகவும் உருவகப்படுத்தினர்). காரணமும் உண்மை (முதலிரு திருவந்தாதிகள்). ஆனால் நாலாயிர திவ்வியப் பிரபந்தத்தில் தொகுக்கப்பட்டிருப்பது உருவக அணி அமைந்ததற்கு நேரடி விளக்கமாகாது. எனவே இரண்டும் சரி, நேரடி விளக்கமல்ல."}, "en": {"blocks": [{"type": "text", "content": "Examine the assertion and reason:\nAssertion (A): Poigai Azhwar and Boothathazhwar metaphorized the parts of an oil lamp with their devotional emotions.\nReason (R): The hymns of both these Azhwars are anthologized as the first two Thiruvandhadhis in Naalaayira Divya Prabandham."}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation of (A)", "B": "Both (A) and (R) are true, but (R) is not the correct direct explanation of (A)", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Both (A) and (R) are true statements from the text, but the anthological compilation (R) does not explain the poetic metaphorical composition (A)."}}, "question_data": {"assertion": {"ta": "பொய்கையாரும் பூதத்தாரும் அகல்விளக்கின் உறுப்புகளை உருவகம் செய்து பாடியுள்ளனர்.", "en": "Both Azhwars metaphorized oil-lamp elements in their hymns."}, "reason": {"ta": "இவ்விருவரின் பாடல்களும் நாலாயிர திவ்வியப் பிரபந்தத்தில் முதலிரு திருவந்தாதிகளாகத் தொகுக்கப்பட்டுள்ளன.", "en": "Their songs are anthologized as the first two Thiruvandhadhis."}, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 20, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tnpsc_pyq", "azhwars", "uruvakam", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u4-q375", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-pyq-bridging", "lesson_id": "lesson-12-kayithe-millath", "chapter_id": null, "topic_id": "ta-t3-pyq-km-tamil-advocacy-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): இந்திய அரசியல் நிர்ணய சபையில் பழமையான மொழிகளுள் ஒன்றைத்தான் ஆட்சிமொழியாக்க வேண்டும் என்றால் அது தமிழ்தான் என்று காயிதே மில்லத் முழங்கினார்.\nகாரணம் (R): இந்தியாவில் தமிழ் மட்டுமே ஒரே ஒருவரால் மட்டுமே பேசப்படும் மிகச் சிறிய மொழி என்று அவர் கருதினார்."}], "options": {"A": "கூற்று (A), காரணம் (R) இரண்டும் சரி", "B": "கூற்று (A), காரணம் (R) இரண்டும் தவறு", "C": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறானது", "D": "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரியானது"}, "explanation": "கூற்று (A) சரியானது (அரசியல் நிர்ணய சபையில் தமிழாட்சி மொழி முழக்கம்). காரணம் (R) முற்றிலும் அபத்தமானது மற்றும் தவறானது; திராவிட மொழிகள் இந்த மண்ணில் முதன்முதலில் பேசப்பட்டவை, அவற்றுள் இலக்கிய வளம் வாய்ந்த தொன்மையான மொழி தமிழ் என்பதே அவரது வாதமாகும். எனவே காரணம் தவறு."}, "en": {"blocks": [{"type": "text", "content": "Examine the assertion and reason:\nAssertion (A): In the Constituent Assembly, Kayidhe Millath proclaimed that if an ancient tongue were chosen as the official language, it must be Tamil.\nReason (R): He believed that Tamil was a tiny dialect spoken by only a solitary person across India."}], "options": {"A": "Both (A) and (R) are true", "B": "Both (A) and (R) are false", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Assertion (A) is true. Reason (R) is completely absurd and false; his rationale was that Tamil is the foremost ancient Dravidian tongue with supreme literary antiquity."}}, "question_data": {"assertion": {"ta": "பழமையான மொழிகளுள் ஒன்றை ஆட்சிமொழியாக்க வேண்டும் என்றால் அது தமிழ்தான் என்று முழங்கினார்.", "en": "He proclaimed that if an ancient tongue were chosen, it must be Tamil."}, "reason": {"ta": "இந்தியாவில் தமிழ் மட்டுமே ஒருவரால் பேசப்படும் மிகச் சிறிய மொழி என்று கருதினார்.", "en": "He believed Tamil was a tiny dialect spoken by one person."}, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 52, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tnpsc_pyq", "kayithe_millath", "language_policy", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u4-q376", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-pyq-bridging", "lesson_id": "lesson-10-malaippozhivu", "chapter_id": null, "topic_id": "ta-t3-pyq-kannadasan-parl-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): கவியரசு கண்ணதாசன் தனது வாழ்நாள் முழுவதும் எந்தவிதமான இலக்கியப் படைப்புகளையும் எழுதாமல் திரைப்படங்களில் மட்டுமே நடித்தார்.\nகாரணம் (R): கண்ணதாசனுக்குத் தமிழ் மொழி மீது எவ்விதப் பற்றும் புலமையும் கிடையாது."}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி", "B": "கூற்று (A) சரி; காரணம் (R) தவறு", "C": "கூற்று (A) தவறு; காரணம் (R) சரி", "D": "கூற்று (A) மற்றும் காரணம் (R) ஆகிய இரண்டும் தவறானவை"}, "explanation": "கூற்று மற்றும் காரணம் இரண்டும் முற்றிலும் தவறானவை. கண்ணதாசன் அரசவைக் கவிஞராகத் திகழ்ந்தவர்; சாகித்திய அகாதெமி பெற்ற புதினமான சேரமான் காதலி, சமயக் காவியமான இயேசு காவியம், ஆயிரக்கணக்கான தத்துவப் பாடல்களைப் படைத்த மாபெரும் இலக்கிய ஆளுமை. எனவே இரண்டுமே தவறானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the assertion and reason:\nAssertion (A): Kaviarasu Kannadasan authored no literary works whatsoever in his lifetime and exclusively acted in films.\nReason (R): Kannadasan possessed zero affection or scholarship for the Tamil language."}], "options": {"A": "Both (A) and (R) are true", "B": "(A) is true; (R) is false", "C": "(A) is false; (R) is true", "D": "Both (A) and (R) are false"}, "explanation": "Both (A) and (R) are preposterous and false. Kannadasan was Poet Laureate, Sahitya Akademi laureate, and author of thousands of poems and epics."}}, "question_data": {"assertion": {"ta": "கண்ணதாசன் எந்த இலக்கியப் படைப்பையும் எழுதாமல் படங்களில் மட்டுமே நடித்தார்.", "en": "Kannadasan wrote no literary works and only acted in movies."}, "reason": {"ta": "கண்ணதாசனுக்குத் தமிழ் மீது பற்றும் புலமையும் கிடையாது.", "en": "Kannadasan had no affection or mastery of Tamil."}, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 47, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tnpsc_pyq", "kannadasan", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u4-q377", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u1-nagarigam", "lesson_id": "lesson-01-virundhombal", "chapter_id": null, "topic_id": "ta-t3-pyq-virundhombal-pari-ar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் கூற்று மற்றும் காரணத்தை ஆராய்க:\nகூற்று (A): பாரி மகளிர் அங்கவை, சங்கவை இருவரும் உலைநீரில் பொன்னிட்டுப் பாணர்களுக்கு உணவளித்தனர்.\nகாரணம் (R): மழையின்றி வறட்சி நிலவிய பஞ்ச காலத்திலும் இல்லையென்று கூறாமல் விருந்தோம்பும் பெருந்தன்மை பாரி மகளிர் வசம் இருந்தது."}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) கூற்றிற்கு (A) சரியான விளக்கமாகும்", "B": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் சரியான விளக்கமல்ல", "C": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு", "D": "கூற்று (A) தவறு; காரணம் (R) சரி"}, "explanation": "பாடநூல் பக்கம் 2 பழமொழி நானூறு: மாரியொன்று இன்றி வறந்திருந்த காலத்தும் பாரி மடமகள் பாணர்க்கு உலைநீரில் பொன் இட்டு நல்கினாள் ('ஒன்றுறா முன்றில் இல்'). கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Examine the assertion and reason:\nAssertion (A): Pari's daughters Angavai and Sangavai placed gold in the cooking vessel water and gifted food to the visiting bards.\nReason (R): Even during extreme drought when rains failed, Pari's daughters possessed the magnificent virtue of ungrudging hospitality without saying 'No'."}], "options": {"A": "Both (A) and (R) are true, and (R) is the correct explanation of (A)", "B": "Both (A) and (R) are true, but (R) is not the correct explanation of (A)", "C": "(A) is true, but (R) is false", "D": "(A) is false, but (R) is true"}, "explanation": "Page 2 Pazhamozhi Naanooru: Pari's daughters gave gold in boiling water to bards even during harsh drought, illustrating the adage 'Ondruraa mundril il'. Both (A) and (R) are true, and (R) explains (A)."}}, "question_data": {"assertion": {"ta": "பாரி மகளிர் உலைநீரில் பொன்னிட்டுப் பாணர்களுக்கு உணவளித்தனர்.", "en": "Pari's daughters put gold in boiling water to feed the bards."}, "reason": {"ta": "பஞ்ச காலத்திலும் இல்லையென்று கூறாமல் விருந்தோம்பும் பெருந்தன்மை பாரி மகளிரிடம் இருந்தது.", "en": "Even during drought, they had the virtue of ungrudging hospitality."}, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["tnpsc_pyq", "virundhombal", "pari_daughters", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u4-q378", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-pyq-bridging", "lesson_id": "lesson-02-thirunelveli", "chapter_id": null, "topic_id": "ta-t3-pyq-sangam-quotes-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "TNPSC தேர்வுகளில் கேட்கப்பட்ட இலக்கிய மேற்கோள்களையும் அவற்றுக்குரிய நூல்களையும் பொருத்துக:\na) திக்கெல்லாம் புகழுறும் திருநெல்வேலி - 1. திருஞானசம்பந்தர் தேவாரம்\nb) தன் பொருநைப் புனல் நாடு - 2. சேக்கிழார் பெரியபுராணம்\nc) முத்துப்படு பரப்பிற் கொற்கை முன்துறை - 3. நற்றிணை (சங்க இலக்கியம்)\nd) கொற்கையில் பெருந்துறை முத்து - 4. அகநானூறு (சங்க இலக்கியம்)"}], "options": {"A": "a-4, b-3, c-2, d-1", "B": "a-1, b-2, c-3, d-4", "C": "a-2, b-1, c-4, d-3", "D": "a-3, b-4, c-1, d-2"}, "explanation": "பாடநூல் பக்கம் 4-5: சம்பந்தர் - திக்கெல்லாம் புகழுறும் திருநெல்வேலி (1); சேக்கிழார் - தன் பொருநைப் புனல் நாடு (2); நற்றிணை - முத்துப்படு பரப்பிற் கொற்கை (3); அகநானூறு - கொற்கையில் பெருந்துறை முத்து (4). சரியான வரிசை: 1, 2, 3, 4 (B)."}, "en": {"blocks": [{"type": "text", "content": "Match the celebrated quotations from TNPSC exams with their source texts:\na) Thikkellam pugazhurum Tirunelveli - 1. Thirugnanasambandar's Thevaram\nb) Than porunai-p punal naadu - 2. Sekkizhar's Periyapuranam\nc) Muthuppadu parappir Korkai munthurai - 3. Natrinai (Sangam anthology)\nd) Korkaiyil perunthurai muthu - 4. Agananooru (Sangam anthology)"}], "options": {"A": "a-4, b-3, c-2, d-1", "B": "a-1, b-2, c-3, d-4", "C": "a-2, b-1, c-4, d-3", "D": "a-3, b-4, c-1, d-2"}, "explanation": "Classic TNPSC quotation matches: Thevaram -> 1; Periyapuranam -> 2; Natrinai -> 3; Agananooru -> 4. Sequence: a-1, b-2, c-3, d-4."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [{"left_ta": "திக்கெல்லாம் புகழுறும் திருநெல்வேலி", "left_e