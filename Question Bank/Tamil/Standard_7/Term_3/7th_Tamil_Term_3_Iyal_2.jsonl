{"id": "7th-t3-u2-q161", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-06-aram-ennum-kadhir", "chapter_id": null, "topic_id": "ta-t3-u2-grammar-sandhi-inso-nilam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'இனிமை + சொல் = இன்சொல்' என்னும் புணர்ச்சியில் இடம்பெற்றுள்ள முதன்மை விதி யாது?"}], "options": {"A": "உயிர்வரின் உக்குறள் மெய்விட்டோடும்", "B": "ஈறுபோதல்", "C": "தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும்", "D": "ஆதிநீடல்"}, "explanation": "'இனிமை + சொல்': பண்புப்பெயர்ப் புணர்ச்சியில் 'ஈறுபோதல்' விதிப்படி நிலைமொழி ஈற்று 'மை' விகுதி கெட்டு, 'இன் + சொல் = இன்சொல்' என்றானது."}, "en": {"blocks": [{"type": "text", "content": "Identify the primary Sandhi rule operating in 'Inimai + Sol = Insol':"}], "options": {"A": "Uyirvarin ukkural meyvittodum", "B": "Eerupothal", "C": "Thanikkuril mun otru uyirvarin irattum", "D": "Aadhineedal"}, "explanation": "Under Panbuppeyar Sandhi rules, 'Eerupothal' drops '-mai' to form 'Insol'. Option B is correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 23, "chapter": null, "sectio