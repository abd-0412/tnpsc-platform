// 7-ஆம் வகுப்பு தமிழ் - பருவம் 3 - இயல் 2: மானுடம், ஆளுமை (ஒப்புரவு ஒழுகு) (மொத்த வினாக்கள்: 112)
// ==============================================================================
// ==============================================================================
// பாடம் 1: புதுமை விளக்கு (கவிதைப்பேழை - பொய்கையாழ்வார் & பூதத்தாழ்வார்) [Q113 - Q140]
// பொய்கையாழ்வார் (காஞ்சிபுரம், திருவெஃகா, நாலாயிர திவ்வியப் பிரபந்தம் முதல் திருவந்தாதி 'வையம் தகளியா வார்கடலே நெய்யாக', வெண்பா யாப்பு), பூதத்தாழ்வார் (மாமல்லபுரம், இரண்டாம் திருவந்தாதி 'அன்பே தகளியா ஆர்வமே நெய்யாக', ஞானத்தமிழ்), முதலாழ்வார்கள் மூவர் (பொய்கை, பூதம், பேயாழ்வார்), திருக்கோவிலூர் மூலவர் திருமால் தரிசனம், உருவக அணி விளக்கம், தகளி/நாரணன்/ஞானம்/ஆர்வமெய் சொல்லும் பொருளும்
// ==============================================================================
{"id": "7th-t3-u2-q113", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-poigai-alwar-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பொய்கையாழ்வார் மற்றும் முதல் திருவந்தாதி பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. பொய்கையார், பூதத்தார், பேயாழ்வார் மூவரும் முதலாழ்வார்கள் எனப்படுவர்.\n2. பொய்கையாழ்வார் காஞ்சிபுரத்தை அடுத்த திருவெஃகா என்னும் ஊரில் அவதரித்தார்.\n3. இவர் பாடிய நூல் நாலாயிரத் திவ்வியப் பிரபந்தத்தில் முதல் திருவந்தாதி எனப்படுகிறது.\n4. 'வையம் தகளியா வார்கடலே நெய்யாக' என்பது இவரது பாடலாகும்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 2 மட்டுமே சரி", "C": "1, 3, 4 மட்டுமே சரி", "D": "2, 3 மட்டுமே சரி"}, "explanation": "பாடநூல் பக்கம் 21 'நூல் வெளி': முதலாழ்வார்கள் மூவர், திருவெஃகா ஊர், முதல் திருவந்தாதி, 'வையம் தகளியா' பாடல் ஆகிய 4 கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Poigai Alwar and Mudhal Thiruvandhadhi:\n1. Poigai, Bootham, Pey are called Mudhal Alwars.\n2. Poigai Alwar was born in Thiruvekka near Kanchipuram.\n3. His work is the First Thiruvandhadhi in Divya Prabandham.\n4. 'Vaiyam thagaliyaa vaarkadale neyyaaga' is his hymn.\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1 and 2 only correct", "C": "1, 3, and 4 only correct", "D": "2 and 3 only correct"}, "explanation": "All four statements are verified textbook facts from page 21 'Nool Veli'. All are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பொய்கையாழ்வார், பூதத்தாழ்வார், பேயாழ்வார் ஆகிய மூவரும் 'முதலாழ்வார்கள்' எனப் போற்றப்படுகின்றனர்.", "content_en": "Poigai Alwar, Boothathalwar, and Peyalwar are celebrated as the 'Mudhal Alwars'."}, {"id": "S2", "content_ta": "பொய்கையாழ்வார் காஞ்சிபுரத்தை அடுத்த திருவெஃகா என்னும் ஊரில் பிறந்தவர்.", "content_en": "Poigai Alwar was born in Thiruvekka near Kanchipuram."}, {"id": "S3", "content_ta": "இவர் பாடிய அந்தாதி நாலாயிரத் திவ்வியப் பிரபந்தத்தில் 'முதல் திருவந்தாதி' எனத் திகழ்கிறது.", "content_en": "The anthology he sang stands as the 'First Thiruvandhadhi' in Nalayira Divya Prabandham."}, {"id": "S4", "content_ta": "இவரது பாடல் 'வையம் தகளியா வார்கடலே நெய்யாக' என்று தொடங்குகிறது.", "content_en": "His song opens with 'Vaiyam thagaliyaa vaarkadale neyyaaga'."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 21, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pudhumai_vilakku", "poigai_alwar", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": 