// ==============================================================================
// பாடம் 4: உண்மை ஒளி (விரிவானம் / துணைப்பாடம் - ஜென் தத்துவக் கதை) & கற்கண்டு: இலக்கணம் - பொது [Q169 - Q196]
// ஜென் தத்துவம் ('தியானம் செய்' என்பது பொருள், புத்த மத துறவியர் பிரிவு, சீனா & ஜப்பான் வாழ்வு, எளிய கதைகள் மூலம் விளக்கம், குதிரைத் திருடனும் குருவின் மனிதநேயமும்), இலக்கணம் - பொது (திணை 2: உயர்திணை, அஃறிணை; பால் 5: ஆண், பெண், பலர், ஒன்றன்பால், பலவின்பால்; எண் 2: ஒருமை, பன்மை; மூவிடம்: தன்மை ஒருமை/பன்மை, முன்னிலை ஒருமை/பன்மை, படர்க்கை), இரட்டைக்கிளவி (பிரித்தால் பொருள் தராது, இரண்டு முறை மட்டுமே வரும், இணைந்து நிற்கும், குறிப்புப் பொருள்), அடுக்குத்தொடர் (பிரித்தாலும் பொருள் தரும், 2 முதல் 4 முறை வரும், தனித்து நிற்கும், விரைவு/வெகுளி/அச்சம்/உவகை), கலைச்சொற்கள் (Objective, Communism, Poverty, Wealth, Responsibility, Reciprocity, Ambition, Neighbour, Courtesy)
// ==============================================================================
{"id": "7th-t3-u2-q169", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-07-unmai-oli", "chapter_id": null, "topic_id": "ta-t3-u2-zen-philosophy-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜென் சிந்தனைகள் மற்றும் 'உண்மை ஒளி' துணைப்பாட நூல்வெளி குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'ஜென்' என்னும் ஜப்பானிய மொழிச் சொல்லுக்குத் 'தியானம் செய்' என்பது பொருள்.\n2. புத்த மதத்தைச் சார்ந்த துறவியரில் ஒரு பிரிவினரே ஜென் சிந்தனையாளர்கள் ஆவர்.\n3. ஜென் சிந்தனையாளர்கள் பெரும்பாலும் சீனா, ஜப்பான் ஆகிய நாடுகளில் வாழ்ந்து வந்தனர்.\n4. தமது தத்துவச் சிந்தனைகளைச் சிறு நிகழ்ச்சிகள், எளிய கதைகள் மூலம் விளக்கினர்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2 மட்டுமே சரியானவை", "C": "கூற்றுகள் 1, 3, 4 சரியானவை; 2 தவறானது", "D": "கூற்றுகள் 2, 3 மட்டுமே சரியானவை"}, "explanation": "பாடநூல் பக்கம் 34 'நூல் வெளி': ஜென் என்பது ஜப்பானிய சொல், இதற்குத் தியானம் செய் என்பது பொருள். புத்த மத துறவியரின் ஒரு பிரிவினர். சீனா, ஜப்பான் நாடுகளில் வாழ்ந்து எளிய கதைகள் மூலம் விளக்கினர். எனவே நான்கும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the following statements regarding Zen philosophy and 'Unmai Oli' source note:\n1. The Japanese word 'Zen' means 'meditate'.\n2. Zen thinkers were a branch of Buddhist monks.\n3. Zen thinkers mostly lived in China and Japan.\n4. They explained their thoughts through short incidents and simple stories.\nWhich statements are correct?"}], "options": {"A": "All statements 1, 2, 3, 4 are correct", "B": "Statements 1, 2 only are correct", "C": "Statements 1, 3, 4 are correct; 2 is incorrect", "D": "Statements 2, 3 only are correct"}, "explanation": "Page 34 Source Note: Zen means meditate; branch of Buddhist monks who lived in China and Japan; explained through simple stories. All 4 statements are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'ஜென்' என்னும் ஜப்பானிய மொழிச் சொல்லுக்குத் 'தியானம் செய்' என்பது பொருள்.", "content_en": "The Japanese word 'Zen' means 'meditate'."}, {"id": "S2", "content_ta": "புத்த மதத்தைச் சார்ந்த துறவியரில் ஒரு பிரிவினரே ஜென் சிந்தனையாளர்கள் ஆவர்.", "content_en": "Zen thinkers were a branch of Buddhist monks."}, {"id": "S3", "content_ta": "ஜென் சிந்தனையாளர்கள் பெரும்பாலும் சீனா, ஜப்பான் ஆகிய நாடுகளில் வாழ்ந்து வந்தனர்.", "content_en": "Zen thinkers mostly lived in China and Japan."}, {"id": "S4", "content_ta": "தமது தத்துவச் சிந்தனைகளைச் சிறு நிகழ்ச்சிகள், எளிய கதைகள் மூலம் விளக்கினர்.", "content_en": "They explained their philosophy through short incidents and simple stories."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 34, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["unmai_oli", "zen_philosophy", "statement_analysis"], "language_status": 