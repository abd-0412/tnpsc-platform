{"id": "7th-t3-u2-q139", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-direct-bookback-vaiyam-meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'வையம் தகளியா' என்ற தொடரில் 'வையம்' என்னும் சொல் குறிக்கும் பொருள் யாது?"}], "options": {"A": "வானம்", "B": "பூமி (உலகம்)", "C": "காற்று", "D": "நெருப்பு"}, "explanation": "பாடநூல் பக்கம் 22 மதிப்பீடு வினா 1: 'வையம்' என்னும் சொல் 'உலகம்' (பூமி) என்னும் பொருளைக் குறிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "What is the meaning of the word 'Vaiyam' in the phrase 'Vaiyam thagaliyaa'?"}], "options": {"A": "Sky", "B": "Earth (World)", "C": "Wind", "D": "Fire"}, "explanation": "Textbook page 22 evaluation question 1: 'Vaiyam' means 'Earth / World'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 22, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session