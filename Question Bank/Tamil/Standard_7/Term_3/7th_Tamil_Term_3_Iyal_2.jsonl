{"id": "7th-t3-u2-q219", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-09-thirukkural", "chapter_id": null, "topic_id": "ta-t3-u2-urubasi-grammar-type", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளில் வரும் 'உருபசி' என்ற சொல்லின் இலக்கணக் குறிப்பைக் கண்டறிக:"}], "options": {"A": "வினைத்தொகை", "B": "பண்புத்தொகை", "C": "உரிச்சொற்றொடர்", "D": "உவமைத்தொகை"}, "explanation": "'உரு', 'தவ', 'நனி' என்பன மிகுதி உணர்த்தும் உரிச்சொற்கள் ஆகும். 'உருபசி' என்பது 'மிக்க பசி' என்ற பொருளை உணர்த்தி உரு என்ற உரிச்சொல் முன்நின்று அமைந்ததால் இது 'உரிச்சொற்றொடர்' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the grammatical category of the phrase 'Urupasi' in Thirukkural:"}], "options": {"A": "Vinai-thogai", "B": "Panbu-thogai", "C": "Uri-chol-thodar", "D": "Uvamai-thogai"}, "explanation": "'Uru' is a qualifying particle (Uri-chol) signifying abundance/intensity ('mikka pasi'). Hence 'Urupasi' is an Uri-chol-thodar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 43, "chapter": null, "section": null, "referenc