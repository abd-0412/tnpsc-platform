{"id": "7th-t3-u2-q196", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-08-ilakkanam-pothu", "chapter_id": null, "topic_id": "ta-t3-u2-adukku-repetition-limit-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இலக்கண விதிப்படி அடுக்குத்தொடரில் ஒரே சொல் அதிகபட்சமாக எத்தனை முறை வரை அடுக்கி வரலாம்?"}], "options": {"A": "இரண்டு முறை மட்டுமே", "B": "மூன்று முறை வரை", "C": "ஐந்து முறை வரை", "D": "நான்கு முறை வரை"}, "explanation": "பாடநூல் பக்கம் 38 மதிப்பீடு வினா 3: அடுக்குத்தொடரில் ஒரே சொல் இரண்டு முதல் 'நான்கு முறை வரை' அடுக்கி வரும்."}, "en": {"blocks": [{"type": "text", "content": "According to Tamil grammar rules, a single word can repeat consecutively up to a maximum of how many times in an Adukku-th-thodar?"}], "options": {"A": "Two times only", "B": "Up to three times", "C": "Up to five times", "D": "Up to four times"}, "explanation": "Page 38 evaluation question 3: In an Adukku-th-thodar, a single word can repeat from two 'up to four times' consecutively."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 38, "chap