{"id": "7th-t3-u2-q218", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-09-thirukkural", "chapter_id": null, "topic_id": "ta-t3-u2-metrics-achaani", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறளில் இடம்பெற்றுள்ள 'அச்சாணி' என்ற சொல்லின் மொத்த மாத்திரை அளவைக் கணக்கிடுக:"}], "options": {"A": "3.5 மாத்திரைகள்", "B": "4.5 மாத்திரைகள்", "C": "5.0 மாத்திரைகள்", "D": "5.5 மாத்திரைகள்"}, "explanation": "மாத்திரை கணக்கீடு:\nஅ (குறில்) = 1\nச் (மெய்) = 0.5\nசா (நெடில்) = 2\nணி (குறில்) = 1\nமொத்தம் = 1 + 0.5 + 2 + 1 = 4.5 மாத்திரைகள்."}, "en": {"blocks": [{"type": "text", "content": "Calculate the total Maathirai count for the word 'Achaani' found in Thirukkural:"}], "options": {"A": "3.5 Maathirais", "B": "4.5 Maathirais", "C": "5.0 Maathirais", "D": "5.5 Maathirais"}, "explanation": "Metrics calculation: A (1) + ch (0.5) + saa (2) + ni (1) = 4.5 Maathirais."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 42, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previo