{"id": "7th-t3-u2-q165", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-06-aram-ennum-kadhir", "chapter_id": null, "topic_id": "ta-t3-u2-quote-fill-aram-verse1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'அறம் என்னும் கதிர்' பாடல் அடியை நிறைவு செய்க:\n'இன்சொல் விலைநிலனா ஈதலே வித்தாக\nவன்சொல் களைகட்டு ________ எருவட்டி.'"}], "options": {"A": "அன்பு", "B": "அறம்", "C": "வாய்மை", "D": "ஈகை"}, "explanation": "பாடல் அடி: 'வன்சொல் களைகட்டு வாய்மை எருவட்டி அன்புநீர் பாய்ச்சி'. விடுபட்ட சொல் 'வாய்மை' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Complete the verse line from 'Aram Ennum Kadhir':\n'Insol vilainilanaa eethale viththaaga\nVansol kalaikattu ________ eruvatti.'"}], "options": {"A": "Anbu", "B": "Aram", "C": "Vaaimai (Truth)", "D": "Eegai"}, "explanation": "The verse line completes with 'Vaaimai' (truth). Option C is correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 23, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year