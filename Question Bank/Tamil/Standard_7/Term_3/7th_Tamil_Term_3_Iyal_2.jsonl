{"id": "7th-t3-u2-q133", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-grammar-sandhi-idam-aazhi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'இடர் + ஆழி = இடராழி' என்னும் புணர்ச்சியில் இடம்பெற்றுள்ள விதி யாது?"}], "options": {"A": "உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே", "B": "உயிர்வரின் உக்குறள் மெய்விட்டோடும்", "C": "தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும்", "D": "இ ஈ ஐ வழி யவ்வும்"}, "explanation": "'இடர் + ஆழி': நிலைமொழி ஈற்றில் 'ர்' என்னும் மெய்யெழுத்தும் (உடல்), வருமொழி முதலில் 'ஆ' என்னும் உயிரெழுத்தும் உள்ளதால், 'உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே' என்னும் விதிப்படி ர் + ஆ = ரா என இணைந்து 'இடராழி' என்றானது."}, "en": {"blocks": [{"type": "text", "content": "Identify the Sandhi rule operating in 'Idar + Aazhi = Idaraazhi':"}], "options": {"A": "Udalmel uyirvanthu ondruvathu iyalbe", "B": "Uyirvarin ukkural meyvittodum", "C": "Thanikkuril mun otru uyirvarin irattum", "D": "I Ee Ai vazhi yavvum"}, "explanation": "Consonant 'r' joins vowel 'aa' under the classic rule 'Udalmel uyirvanthu ondruvathu iyalbe' to form 'Idaraazhi'. Option A is correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu S