{"id": "7th-t3-u2-q140", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-direct-bookback-divyaprabandham-compiler", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆழ்வார்கள் பாடிய அருளிச்செயல்களின் தொகுப்பான 'நாலாயிரத் திவ்வியப் பிரபந்தத்தை'த் தொகுத்தவர் யார்?"}], "options": {"A": "இராமானுசர்", "B": "வேதாந்த தேசிகர்", "C": "நாதமுனிகள்", "D": "மணவாள மாமுனிகள்"}, "explanation": "பாடநூல் பக்கம் 21 'நூல் வெளி': நாலாயிரத் திவ்வியப் பிரபந்தத்தைத் தொகுத்தவர் 'நாதமுனிகள்' ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who compiled the Nalayira Divya Prabandham, the sacred anthology of Alwars' hymns?"}], "options": {"A": "Ramanujar", "B": "Vedanta Desikar", "C": "Nathamunigal", "D": "Manavala Mamunigal"}, "explanation": "Textbook page 21: Nalayira Divya Prabandham was compiled by Nathamunigal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 21, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previ