{"id": "7th-t3-u2-q222", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-09-thirukkural", "chapter_id": null, "topic_id": "ta-t3-u2-unit2-chapters-odd-one-out", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "7-ஆம் வகுப்பு பருவம் 3 இயல் 2-ல் இடம்பெற்றுள்ள திருக்குறள் அதிகாரங்களுள் பொருந்தாத வேறுபட்ட அதிகாரம் எது?"}], "options": {"A": "வினை செயல்வகை", "B": "அடக்கமுடைமை", "C": "அவை அஞ்சாமை", "D": "அரண்"}, "explanation": "பருவம் 3 இயல் 2-ல் இடம்பெற்றுள்ள அதிகாரங்கள்: வினை செயல்வகை, அவை அஞ்சாமை, நாடு, அரண், பெருமை ஆகிய ஐந்து அதிகாரங்கள் ஆகும். 'அடக்கமுடைமை' இதில் இடம்பெறவில்லை (அது பருவம் 1-ல் வந்தது). எனவே அடக்கமுடைமை பொருந்தாதது."}, "en": {"blocks": [{"type": "text", "content": "Which chapter does NOT belong to Standard 7 Term 3 Unit 2 Thirukkural section?"}], "options": {"A": "Vinai Seyalvagai", "B": "Adakkamudaimai", "C": "Avai Anjaamai", "D": "Aran"}, "explanation": "Term 3 Unit 2 includes: Vinai Seyalvagai, Avai Anjaamai, Naadu, Aran, Perumai. 'Adakkamudaimai' is not part of this unit. Hence it is the odd one."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "te