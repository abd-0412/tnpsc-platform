{"id": "7th-t3-u2-q114", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-boothathalwar-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பூதத்தாழ்வார் பற்றிய பின்வரும் கூற்றுகளில் தவறானது எது?"}], "options": {"A": "சென்னைக்கு அருகிலுள்ள மாமல்லபுரத்தில் பிறந்தவர்", "B": "இமயமலையில் பிறந்து சமணத் துறவியாக வாழ்ந்தார்", "C": "இரண்டாம் திருவந்தாதியை இயற்றிய பெருமைக்குரியவர்", "D": "'அன்பே தகளியா ஆர்வமே நெய்யாக' என்பது இவரது பாடலாகும்"}, "explanation": "பாடநூல் பக்கம் 22: பூதத்தாழ்வார் மாமல்லபுரத்தில் அவதரித்த வைணவ முதலாழ்வார் ஆவார்; இமயமலையில் பிறந்த சமணர் என்பது தவறு. எனவே 'B' தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Which statement regarding Boothathalwar is INCORRECT?"}], "options": {"A": "Born in Mamallapuram near Chennai", "B": "Born in Himalayas and lived as a Jain monk", "C": "Composed the Second Thiruvandhadhi", "D": "'Anbe thagaliyaa aarvame neyyaaga' is his hymn"}, "explanation": "Boothathalwar was a Vaishnava Alwar born in Mamallapuram, not a Jain ascetic from Himalayas. Statement B is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பூதத்தாழ்வார் சென்னைக்கு அருகிலுள்ள மாமல்லபுரத்தில் பிறந்தவர்.", "content_en": "Boothathalwar was born in Mamallapuram near Chennai."}, {"id": "S2", "content_ta": "இவர் நாலாயிரத் திவ்வியப் பிரபந்தத்தில் 'இரண்டாம் திருவந்தாதி'யைப் பாடியுள்ளார்.", "content_en": "He composed the 'Second Thiruvandhadhi' in Nalayira Divya Prabandham."}, {"id": "S3", "content_ta": "இவரது பாடல் 'அன்பே தகளியா ஆர்வமே நெய்யாக' என்று தொடங்குகிறது.", "content_en": "His hymn opens with 'Anbe thagaliyaa aarvame neyyaaga'."}, {"id": "S4", "content_ta": "பூதத்தாழ்வார் இமயமலையில் பிறந்து சமணத் துறவியாக வாழ்ந்தார்.", "content_en": "Boothathalwar was born in Himalayas and lived as a Jain monk."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 22, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pudhumai_vilakku", "boothathalwar", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u2-q115", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-anthathi-definition-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அந்தாதி பற்றிய பின்வரும் கூற்றுகளில் தவறானது எது?"}], "options": {"A": "ஒரு பாடலின் இறுதி எழுத்து, அசை, சீர் அடுத்த பாடலின் தொடக்கமாக அமைவது அந்தாதி", "B": "அந்தம் என்றால் முடிவு, ஆதி என்றால் தொடக்கம் எனப் பொருள்படும்", "C": "அந்தாதி என்பது சினிமாப் பாடலின் பல்லவியை மட்டுமே பாடும் முறையாகும்", "D": "அந்தாதி என்பது தமிழ் சிற்றிலக்கிய வகைகளுள் ஒன்றாக விளங்குகிறது"}, "explanation": "பாடநூல் பக்கம் 21 'தெரிந்து தெளிவோம்': அந்தாதி என்பது தமிழின் மரபுவழியான சிற்றிலக்கிய யாப்பு வடிவம் ஆகும்; சினிமா பாடல் என்பது தவறு. எனவே 'C' தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Which statement regarding the prosodic genre Anthathi is INCORRECT?"}], "options": {"A": "Final syllable/foot of a song becoming the beginning of the next is Anthathi", "B": "Antham means end, Aadhi means beginning", "C": "Anthathi is merely a cinema singing method repeating the chorus", "D": "Anthathi stands as one of the traditional Tamil minor literatures"}, "explanation": "Anthathi is a celebrated classical Tamil literary form. Statement C is absurd and false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ஒரு பாடலின் இறுதி எழுத்தோ, அசையோ, சீரோ அடுத்த பாடலின் தொடக்கமாக அமைவது 'அந்தாதி' எனப்படும்.", "content_en": "When the final letter, syllable, or foot of a verse begins the subsequent verse, it is 'Anthathi'."}, {"id": "S2", "content_ta": "அந்தம் என்றால் முடிவு; ஆதி என்றால் தொடக்கம் (அந்தம் + ஆதி = அந்தாதி).", "content_en": "Antham means end; Aadhi means beginning (Antham + Aadhi = Anthathi)."}, {"id": "S3", "content_ta": "அந்தாதி என்பது சிற்றிலக்கிய வகைகளுள் ஒன்றாகத் திகழ்கிறது.", "content_en": "Anthathi is classified among minor literary genres (Chitrilakkiyam)."}, {"id": "S4", "content_ta": "அந்தாதி என்பது பாடலின் முதல் வரியை மட்டுமே திருப்பித் திருப்பிப் பாடும் சினிமாப் பாட்டு முறையாகும்.", "content_en": "Anthathi is merely a cinema singing style repeating only the first line."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 21, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pudhumai_vilakku", "anthathi", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u2-q116", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-uruvagam-comparison-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புதுமை விளக்கு பாடல்களின் அணி நயம் மற்றும் உருவகங்கள் பற்றிய கூற்றுகளில் தவறானது எது?"}], "options": {"A": "பொய்கையார் உலகை விளக்காகவும், கடலை நெய்யாகவும் உருவகம் செய்தார்", "B": "பூதத்தார் அன்பை விளக்காகவும், ஆர்வத்தை நெய்யாகவும் உருவகம் செய்தார்", "C": "இவ்விரு ஆழ்வார்களின் பாடல்களிலும் உருவக அணி மிகச் சிறப்பாக அமைந்துள்ளது", "D": "இப்பாடல்களில் இறைவனைத் தீய அரக்கனாகக் கற்பனை செய்து அஞ்சியுள்ளனர்"}, "explanation": "பாடநூல் பக்கங்கள் 20-21: ஆழ்வார்கள் எல்லையற்ற அன்பு, அருள், ஞானம் ஆகியவற்றால் இறைவனை ஒளிவிளக்கேற்றி வழிபட்டனர். அரக்கன் என்பது தவறு. எனவே 'D' தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Which statement regarding the poetic metaphors of Pudhumai Vilakku is INCORRECT?"}], "options": {"A": "Poigai Alwar metaphorized earth as lamp and sea as ghee", "B": "Boothathalwar metaphorized love as lamp and devotion as ghee", "C": "Both hymns masterfully weave Uruvaga Ani", "D": "In these songs, God is envisioned as an evil demon"}, "explanation": "Both Alwars worshipped the Almighty through boundless love and wisdom lamps. Statement D is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பொய்கையாழ்வார் பாடலில் உலகை அகல்விளக்காகவும், கடலை நெய்யாகவும், கதிரவனைச் சுடராகவும் உருவகம் செய்துள்ளார்.", "content_en": "Poigai Alwar metaphorically personifies earth as lamp, ocean as ghee, and sun as flame."}, {"id": "S2", "content_ta": "பூதத்தாழ்வார் பாடலில் அன்பை அகல்விளக்காகவும், ஆர்வத்தை நெய்யாகவும், சிந்தையைத் திரியாகவும் உருவகம் செய்துள்ளார்.", "content_en": "Boothathalwar metaphorically portrays love as lamp, earnest desire as ghee, and soul as wick."}, {"id": "S3", "content_ta": "இவ்விரு ஆழ்வார்களின் பாடல்களிலும் 'உருவக அணி' (Metaphor) பயின்று வந்துள்ளது.", "content_en": "Both hymns employ Uruvaga Ani (Metaphor)."}, {"id": "S4", "content_ta": "இப்பாடல்களில் இறைவனைத் தீய அரக்கனாகக் கற்பனை செய்து அஞ்சி நடுங்கியுள்ளனர்.", "content_en": "In these songs, God is imagined as an evil demon and feared."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 20, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pudhumai_vilakku", "uruvaga_ani", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u2-q117", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-alwars-prabandham-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆழ்வார்கள் மற்றும் நாலாயிரத் திவ்வியப் பிரபந்தம் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. திருமாலை வழிபட்டுப் பாடியவர்கள் ஆழ்வார்கள் ஆவர்.\n2. ஆழ்வார்கள் மொத்தம் பன்னிருவர்.\n3. இவர்கள் பாடிய பாடல்களின் தொகுப்பு நாலாயிரத் திவ்வியப் பிரபந்தம்.\n4. இந்நூலைத் தொகுத்தவர் நாதமுனிகள் ஆவார்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 2 மட்டுமே சரி", "C": "2, 3, 4 மட்டுமே சரி", "D": "1, 3 மட்டுமே சரி"}, "explanation": "பாடநூல் பக்கம் 21 'நூல் வெளி': ஆழ்வார்கள் 12 பேர், நாலாயிரத் திவ்வியப் பிரபந்தம், நாதமுனிகள் தொகுப்பு ஆகியவை TNPSC-இன் முதன்மை வினாக்கள்; 4 கூற்றுகளும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the statements on Alwars and Nalayira Divya Prabandham:\n1. Devotees singing in praise of Vishnu are Alwars.\n2. There are 12 Alwars in total.\n3. Their hymns form Nalayira Divya Prabandham.\n4. This anthology was compiled by Nathamunigal.\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1 and 2 only correct", "C": "2, 3, and 4 only correct", "D": "1 and 3 only correct"}, "explanation": "All four statements are verified facts from textbook page 21. All are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "திருமால் மீது பக்தி செலுத்திய வைணவப் பெரியோர்கள் 'ஆழ்வார்கள்' எனப்படுவர்.", "content_en": "Vaishnavite saints deeply immersed in devotion to Lord Vishnu are called 'Alwars'."}, {"id": "S2", "content_ta": "ஆழ்வார்கள் மொத்தம் பன்னிருவர் (12 பேர்) ஆவர்.", "content_en": "There are twelve Alwars in total."}, {"id": "S3", "content_ta": "ஆழ்வார்கள் பாடிய பாடல்களின் தொகுப்பு 'நாலாயிரத் திவ்வியப் பிரபந்தம்' எனப்படும்.", "content_en": "The compilation of hymns composed by Alwars is 'Nalayira Divya Prabandham'."}, {"id": "S4", "content_ta": "நாலாயிரத் திவ்வியப் பிரபந்தத்தைத் தொகுத்தவர் நாதமுனிகள் ஆவார்.", "content_en": "Nalayira Divya Prabandham was compiled by Nathamunigal."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 21, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pudhumai_vilakku", "alwars", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u2-q118", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-theological-terms-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புதுமை விளக்கு பாடல்களின் சொற்பொருள் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'சுடராழியான்' என்பது ஒளிவீசும் சக்கரத்தை உடைய திருமாலாகும்.\n2. 'இடராழி' என்பது துன்பக்கடல் எனப் பொருள்படும்.\n3. 'நாரணன்' என்பது சிவபெருமானைக் குறிக்கும் சொல்லாகும்.\n4. 'ஞானத் தமிழ் புரிந்த நான்' எனப் பூதத்தாழ்வார் கூறுகிறார்.\nஇவற்றுள் சரியான கூற்றுகள் எவை?"}], "options": {"A": "அனைத்தும் சரியானவை (1, 2, 3, 4)", "B": "1, 2, 4 மட்டுமே சரி; 3 தவறு", "C": "1, 3 மட்டுமே சரி; 2, 4 தவறு", "D": "2, 3 மட்டுமே சரி"}, "explanation": "பாடநூல் பக்கம் 21: 'நாரணன்' என்பது நாராயணனாகிய 'திருமாலையே' குறிக்கும்; சிவபெருமான் என்பது தவறு. எனவே கூற்று 3 தவறு. 1, 2, 4 சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine the theological terms in Pudhumai Vilakku:\n1. 'Sudaraazhiyaan' means Vishnu wielding radiant discus.\n2. 'Idaraazhi' means ocean of sorrow.\n3. 'Naaranan' denotes Lord Shiva.\n4. Boothathalwar states 'Gnaanath thamizh purintha naan'.\nWhich statements are correct?"}], "options": {"A": "All are correct (1, 2, 3, 4)", "B": "1, 2, and 4 only correct; 3 incorrect", "C": "1 and 3 only correct; 2 and 4 incorrect", "D": "2 and 3 only correct"}, "explanation": "'Naaranan' denotes Narayana (Lord Vishnu), not Shiva. Statement 3 is false. 1, 2, 4 are correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பொய்கையாழ்வார் பாடலில் 'சுடராழியான்' என்பது ஒளிவீசும் சக்கரப்படையை உடைய திருமாலைக் குறிக்கும்.", "content_en": "In Poigai Alwar's verse, 'Sudaraazhiyaan' denotes Lord Vishnu holding the radiant discus."}, {"id": "S2", "content_ta": "'இடராழி நீங்குகவே' என்ற தொடரில் 'இடர்' என்பது துன்பத்தையும், 'ஆழி' என்பது கடலையும் குறிக்கும்.", "content_en": "In 'Idaraazhi neengugave', 'Idar' means sorrow and 'Aazhi' means sea."}, {"id": "S3", "content_ta": "பூதத்தாழ்வார் பாடலில் 'நாரணன்' என்பது சிவபெருமானைக் குறிக்கும் சொல்லாகும்.", "content_en": "In Boothathalwar's verse, 'Naaranan' denotes Lord Shiva."}, {"id": "S4", "content_ta": "'ஞானத் தமிழ் புரிந்த நான்' என்று பூதத்தாழ்வார் பெருமிதத்தோடு தம்மைக் குறிப்பிடுகிறார்.", "content_en": "Boothathalwar glorifies himself as 'Gnaanath thamizh purintha naan'."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 20, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pudhumai_vilakku", "vocabulary", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u2-q119", "schema_version": "1.0", "kind": "statement", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-thiruvandhadhi-metrics-statements", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருவந்தாதிகளின் யாப்பு மற்றும் காலம் பற்றிய கூற்றுகளில் தவறானது எது?"}], "options": {"A": "முதல் திருவந்தாதி பொய்கையாழ்வாரால் வெண்பாவில் இயற்றப்பட்டது", "B": "இரண்டாம் திருவந்தாதி பூதத்தாழ்வாரால் வெண்பாவில் இயற்றப்பட்டது", "C": "முதலாழ்வார்கள் இருவரும் கி.பி. 20-ஆம் நூற்றாண்டில் வாழ்ந்த நவீனர்", "D": "இவ்விரு அந்தாதிகளும் தலா நூறு பாடல்களைக் கொண்டவை"}, "explanation": "முதலாழ்வார்கள் சங்க காலத்தை அடுத்து பக்தி இயக்கம் தொடங்கிய தொடக்கக் காலத்தில் (கி.பி. 7-8 ஆம் நூற்றாண்டுக்கு முற்பட்ட தொன்மைக்காலத்தில்) வாழ்ந்தவர்கள்; 20-ஆம் நூற்றாண்டு என்பது முற்றிலும் தவறு. எனவே 'C' தவறானது."}, "en": {"blocks": [{"type": "text", "content": "Which statement regarding the metrics and era of Thiruvandhadhis is INCORRECT?"}], "options": {"A": "First Thiruvandhadhi was composed in Venba by Poigai Alwar", "B": "Second Thiruvandhadhi was composed in Venba by Boothathalwar", "C": "Both Mudhal Alwars lived in the 20th century CE", "D": "Both anthologies consist of 100 poems each"}, "explanation": "Mudhal Alwars lived in the early Bhakti era, centuries before modern times. Statement C is false."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "முதல் திருவந்தாதி பொய்கையாழ்வாரால் வெண்பா யாப்பில் இயற்றப்பட்டது.", "content_en": "First Thiruvandhadhi was composed in Venba meter by Poigai Alwar."}, {"id": "S2", "content_ta": "இரண்டாம் திருவந்தாதி பூதத்தாழ்வாரால் வெண்பா யாப்பில் இயற்றப்பட்டது.", "content_en": "Second Thiruvandhadhi was composed in Venba meter by Boothathalwar."}, {"id": "S3", "content_ta": "இவ்விரு திருவந்தாதிகளும் தலா நூறு (100) பாடல்களைக் கொண்டவை.", "content_en": "Both Thiruvandhadhis consist of 100 poems each."}, {"id": "S4", "content_ta": "முதலாழ்வார்கள் இருவரும் கி.பி. இருபதாம் நூற்றாண்டில் வாழ்ந்த நவீனர் ஆவர்.", "content_en": "Both Mudhal Alwars lived in the 20th century CE."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 21, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pudhumai_vilakku", "literary_history", "statement_analysis"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u2-q120", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-poigai-cosmic-lamp-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): பொய்கையாழ்வார் பூமியையே அகல்விளக்காகவும், பெருங்கடலையே நெய்யாகவும் கொண்டு இறைவனை வழிபட்டார்.\nகாரணம் (R): இயற்கை முழுவதையும் இறையுணர்வின் வெளிப்பாடாகக் கண்டு, உலகத்தின் துன்பம் நீங்க வேண்டும் என்ற பெருவிருப்பில் இப்பாடலை இயற்றினார்."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று, காரணம் இரண்டும் தவறு", "D": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது"}, "explanation": "பாடநூல் பக்கம் 20: 'இடராழி நீங்குகவே என்று' பொய்கையார் பாடியுள்ளார். கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றுக்கான சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Poigai Alwar worshipped God by envisioning the earth as lamp and great ocean as ghee.\nReason (R): Perceiving all nature as an embodiment of the divine, he composed this prayer so that world's distress might vanish."}], "options": {"A": "Assertion is true, Reason is false", "B": "Assertion is false, Reason is true", "C": "Both Assertion and Reason are false", "D": "Both Assertion and Reason are true, and Reason is the correct explanation"}, "explanation": "Both A and R are verified textbook facts from page 20, and R explains why Poigai lit the cosmic lamp to dispel suffering."}}, "question_data": {"assertion": "பொய்கையாழ்வார் பூமியையே அகல்விளக்காகவும், பெருங்கடலையே நெய்யாகவும் கொண்டு இறைவனை வழிபட்டார்.", "reason": "இயற்கை முழுவதையும் இறையுணர்வின் வெளிப்பாடாகக் கண்டு, உலகத்தின் துன்பம் நீங்க வேண்டும் என்ற பெருவிருப்பில் இப்பாடலை இயற்றினார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 20, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pudhumai_vilakku", "poigai_alwar", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u2-q121", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-bootham-inner-lamp-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): பூதத்தாழ்வார் அக வழிபாடாகிய மனத்தின் தூய பக்தியையே ஞான விளக்காய் ஏற்றினார்.\nகாரணம் (R): அன்பு, ஆர்வம், உருகும் சிந்தை ஆகியவற்றின் துணையோடு மட்டுமே ஒருவனால் உண்மையான ஞானச் சுடரை அடைய முடியும்."}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றுக்கான சரியான விளக்கம்", "B": "கூற்று சரி, காரணம் தவறு", "C": "கூற்று தவறு, காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் பக்கம் 20: 'அன்பே தகளியா ஆர்வமே நெய்யாக... ஞானச் சுடர்விளக்கு ஏற்றினேன் நாரணற்கு'. கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Boothathalwar lit the inner lamp of pure spiritual devotion of the soul.\nReason (R): Only through love, earnest devotion, and melting heart can one ignite the beacon of divine wisdom."}], "options": {"A": "Both Assertion and Reason are true, and Reason is the correct explanation", "B": "Assertion is true, Reason is false", "C": "Assertion is false, Reason is true", "D": "Both Assertion and Reason are false"}, "explanation": "Both A and R reflect page 20: Boothathalwar's internalized lamp of love/wisdom explains his inward contemplation."}}, "question_data": {"assertion": "பூதத்தாழ்வார் அக வழிபாடாகிய மனத்தின் தூய பக்தியையே ஞான விளக்காய் ஏற்றினார்.", "reason": "அன்பு, ஆர்வம், உருகும் சிந்தை ஆகியவற்றின் துணையோடு மட்டுமே ஒருவனால் உண்மையான ஞானச் சுடரை அடைய முடியும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 20, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pudhumai_vilakku", "boothathalwar", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u2-q122", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-uruvaga-ani-rules-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'வையம் தகளியா வார்கடலே நெய்யாக' என்னும் பாடலில் உருவக அணி அமைந்துள்ளது.\nகாரணம் (R): உவமிக்கப்படும் பொருளையும் உவமையையும் வேறுபடுத்தாமல் இரண்டும் ஒன்றே என்று கூறுவது உருவக அணி ஆகும்."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது", "C": "கூற்று தவறு, காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் பக்கம் 21: பூமி வேறு தகழி வேறு எனப் பிரிக்காமல் பூமியே தகழி எனக் கூறியதால் இது உருவக அணி. கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): 'Vaiyam thagaliyaa vaarkadale neyyaaga' contains Uruvaga Ani (Metaphor).\nReason (R): Identifying the Upameya and Upamana as one without differentiating them constitutes Uruvaga Ani."}], "options": {"A": "Assertion is true, Reason is false", "B": "Both Assertion and Reason are true, and Reason is the correct explanation", "C": "Assertion is false, Reason is true", "D": "Both Assertion and Reason are false"}, "explanation": "Both A and R are verified grammatical facts from page 21; R directly defines why it is Uruvaga Ani."}}, "question_data": {"assertion": "'வையம் தகளியா வார்கடலே நெய்யாக' என்னும் பாடலில் உருவக அணி அமைந்துள்ளது.", "reason": "உவமிக்கப்படும் பொருளையும் உவமையையும் வேறுபடுத்தாமல் இரண்டும் ஒன்றே என்று கூறுவது உருவக அணி ஆகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 21, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pudhumai_vilakku", "grammar", "uruvaga_ani", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u2-q123", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-alwar-count-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): பன்னிரு ஆழ்வார்களில் பொய்கையாழ்வார், பூதத்தாழ்வார் ஆகிய இருவரும் முதலாழ்வார்கள் எனப்படுகின்றனர்.\nகாரணம் (R): ஆழ்வார்கள் மொத்தம் அறுபத்து மூவர் (63 பேர்) ஆவர்."}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "கூற்று சரி: பொய்கையார், பூதத்தார் முதலாழ்வார்கள். காரணம் தவறு: அறுபத்து மூவர் என்பது சைவ நாயன்மார்களின் எண்ணிக்கை ஆகும்; ஆழ்வார்கள் மொத்தம் 12 பேர் மட்டுமே. எனவே காரணம் தவறு."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Among the twelve Alwars, Poigai Alwar and Boothathalwar are called Mudhal Alwars.\nReason (R): There are sixty-three (63) Alwars in total."}], "options": {"A": "Both Assertion and Reason are true", "B": "Assertion is false, Reason is true", "C": "Assertion (A) is true, but Reason (R) is false", "D": "Both Assertion and Reason are false"}, "explanation": "Assertion is true. Reason confuses 63 Saiva Nayanmars with the 12 Vaishnava Alwars. Key C is correct."}}, "question_data": {"assertion": "பன்னிரு ஆழ்வார்களில் பொய்கையாழ்வார், பூதத்தாழ்வார் ஆகிய இருவரும் முதலாழ்வார்கள் எனப்படுகின்றனர்.", "reason": "ஆழ்வார்கள் மொத்தம் அறுபத்து மூவர் (63 பேர்) ஆவர்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 21, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pudhumai_vilakku", "alwars", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u2-q124", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-anthathi-name-reason-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): ஒரு பாடலின் முடிவு அடுத்த பாடலின் தொடக்கமாக அமையும் செய்யுள் 'அந்தாதி' எனப்படும்.\nகாரணம் (R): பாடலின் அந்தமே (முடிவே) அடுத்த பாடலின் ஆதியாக (தொடக்கமாக) அமைவதால் 'அந்தாதி' எனப் பெயர் பெற்றது."}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று, காரணம் இரண்டும் தவறு", "D": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றை விளக்குகிறது"}, "explanation": "பாடநூல் பக்கம் 21: அந்தம் + ஆதி = அந்தாதி. முடிவு தொடக்கமாக அமைவது அந்தாதி. கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): A verse where the end of one poem begins the next is called 'Anthathi'.\nReason (R): Because the end (Antham) serves as the beginning (Aadhi) of the subsequent poem, it is named Anthathi."}], "options": {"A": "Assertion is true, Reason is false", "B": "Assertion is false, Reason is true", "C": "Both Assertion and Reason are false", "D": "Both Assertion and Reason are true, and Reason is the correct explanation"}, "explanation": "Both A and R are verified textbook facts from page 21, and R directly provides the etymology of Anthathi."}}, "question_data": {"assertion": "ஒரு பாடலின் முடிவு அடுத்த பாடலின் தொடக்கமாக அமையும் செய்யுள் 'அந்தாதி' எனப்படும்.", "reason": "பாடலின் அந்தமே (முடிவே) அடுத்த பாடலின் ஆதியாக (தொடக்கமாக) அமைவதால் 'அந்தாதி' எனப் பெயர் பெற்றது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 21, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pudhumai_vilakku", "anthathi", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u2-q125", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-thiruvekka-poigai-assertion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): பொய்கையாழ்வார் பிறந்த திருவெஃகா என்னும் தலம் காஞ்சிபுரத்திற்கு அருகில் அமைந்துள்ளது.\nகாரணம் (R): பல்லவர் காலத் தலைநகரமான காஞ்சிபுரமும் அதன் சுற்றுவட்டாரப் பகுதிகளும் ஆழ்வார்களின் பக்தி இயக்கத்திற்குப் புகலிடமாகத் திகழ்ந்தன."}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி; காரணம் கூற்றுக்கான சரியான விளக்கம்", "B": "கூற்று சரி, காரணம் தவறு", "C": "கூற்று தவறு, காரணம் சரி", "D": "கூற்று, காரணம் இரண்டும் தவறு"}, "explanation": "பாடநூல் பக்கம் 21: பொய்கையாழ்வார் காஞ்சிபுரத்தை அடுத்த திருவெஃகாவில் பிறந்தவர். பல்லவப் பேரரசின் தலைநகரான காஞ்சியில் வைணவ நெறி செழித்தோங்கியது. கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Thiruvekka, the birthplace of Poigai Alwar, is situated near Kanchipuram.\nReason (R): Kanchipuram, the Pallava capital, and its environs served as a cradle for the Alwars' Bhakti movement."}], "options": {"A": "Both Assertion and Reason are true, and Reason is the correct explanation", "B": "Assertion is true, Reason is false", "C": "Assertion is false, Reason is true", "D": "Both Assertion and Reason are false"}, "explanation": "Both A and R are historically and textually verified facts from page 21. A is correct."}}, "question_data": {"assertion": "பொய்கையாழ்வார் பிறந்த திருவெஃகா என்னும் தலம் காஞ்சிபுரத்திற்கு அருகில் அமைந்துள்ளது.", "reason": "பல்லவர் காலத் தலைநகரமான காஞ்சிபுரமும் அதன் சுற்றுவட்டாரப் பகுதிகளும் ஆழ்வார்களின் பக்தி இயக்கத்திற்குப் புகலிடமாகத் திகழ்ந்தன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 21, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pudhumai_vilakku", "poigai_alwar", "assertion_reason"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u2-q126", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-05-pudhumai-vilakku", "chapter_id": null, "topic_id": "ta-t3-u2-poigai-metaphors-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பொய்கையாழ்வார் பாடலின் உருவகப் பொருள்களைப் பொருத்துக:\n(a) வையம் - 1. நெய்\n(b) வார்கடல் - 2. அகல்விளக்கு (தகளி)\n(c) வெய்ய கதிரோன் - 3. பாமாலை\n(d) சொல்மாலை - 4. சுடர்விளக்கு"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-2, b-4, c-1, d-3", "D": "a-3, b-1, c-4, d-2"}, "explanation": "பாடநூல் பக்கம் 20:\nவையம் = தகளி (2)\nவார்கடல் = நெய் (1)\nவெய்ய கதிரோன் = விளக்கு (4)\nசொல்மாலை = பாமாலை (3).\nவரிசை: 2, 1, 4, 3."}, "en": {"blocks": [{"type": "text", "content": "Match the metaphors from Poigai Alwar's hymn:\n(a) Vaiyam - 1. Ghee\n(b) Vaarkadal - 2. Lamp (Thagali)\n(c) Veyya Kathiron - 3. Garland of hymns\n(d) Solmaalai - 4. Radiant flame"}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-2, b-4, c-1, d-3", "D": "a-3, b-1, c-4, d-2"}, "explanation": "Correct match: Vaiyam = Thagali (2), Vaarkadal = Ney (1), Kathiron = Vilakku (4), Solmaalai = Paamalai (3). Sequence: 2, 1, 4, 3."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "வையம்", "content_en": "Vaiyam"}, {"id": "L2", "content_ta": "வார்கடல்", "content_en": "Vaarkadal"}, {"id": "L3", "content_ta": "வெய்ய கதிரோன்", "content_en": "Veyya Kathiron"}, {"id": "L4", "content_ta": "சொல்மாலை", "content_en": "Solmaalai"}], "right": [{"id": "R1", "content_ta": "நெய்", "content_en": "Ghee"}, {"id": "R2", "content_ta": "அகல்விளக்கு (தகளி)", "content_en": "Earthen Lamp (Thagali)"}, {"id": "R3", "content_ta": "பாமாலை", "content_en": "Garland of hymns"}, {"id": "R4", "content_ta": "சுடர்விளக்கு", "content_en": "Radiant flame"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 20, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["pudhumai_vilakku", "uruvagam", "matching"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
