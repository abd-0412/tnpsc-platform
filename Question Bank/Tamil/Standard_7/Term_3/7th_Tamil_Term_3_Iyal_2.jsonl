{"id": "7th-t3-u2-q194", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-08-ilakkanam-pothu", "chapter_id": null, "topic_id": "ta-t3-u2-irattaikkilavi-odd-one-out", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் சொற்களுள் இரட்டைக்கிளவியோடு பொருந்தாத வேறுபட்ட ஒன்றைக் கண்டறிக:"}], "options": {"A": "மளமள", "B": "வருக வருக", "C": "விறுவிறு", "D": "கலகல"}, "explanation": "பாடநூல் பக்கம் 37: 'மளமள, விறுவிறு, கலகல' ஆகிய மூன்று சொற்களும் பிரித்தால் பொருள் தராத இரட்டைக்கிளவிகள். ஆனால் 'வருக வருக' என்பது உவகையால் வந்து பிரித்தாலும் பொருள் தரும் அடுக்குத்தொடர் ஆகும். எனவே இது பொருந்தாதது."}, "en": {"blocks": [{"type": "text", "content": "Identify the odd word that is NOT an Irattaikkilavi:"}], "options": {"A": "Malamala", "B": "Varuga varuga", "C": "Viruviru", "D": "Kalakala"}, "explanation": "Page 37: 'Malamala, Viruviru, Kalakala' are Irattaikkilavi (yield no meaning if split). 'Varuga varuga' is an Adukku-th-thodar (retains meaning when split). Hence 'Varuga varuga' is the odd one."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["odd_one_out", "irattaikkilavi", "adukkuththodar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u2-q195", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-07-unmai-oli", "chapter_id": null, "topic_id": "ta-t3-u2-zen-countries-direct", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜென் சிந்தனையாளர்கள் பெரும்பாலும் எந்த இரு ஆசிய நாடுகளில் வாழ்ந்து வந்தனர்?"}], "options": {"A": "இந்தியா, இலங்கை", "B": "மியான்மர், தாய்லாந்து", "C": "சீனா, ஜப்பான்", "D": "திபெத், நேபாளம்"}, "explanation": "பாடநூல் பக்கம் 34 நூல்வெளி: புத்த மதத்தைச் சார்ந்த துறவியரில் ஒரு பிரிவினரான ஜென் சிந்தனையாளர்கள் பெரும்பாலும் 'சீனா, ஜப்பான்' ஆகிய நாடுகளில் வாழ்ந்து வந்தனர்."}, "en": {"blocks": [{"type": "text", "content": "In which two Asian countries did Zen thinkers mostly live?"}], "options": {"A": "India, Sri Lanka", "B": "Myanmar, Thailand", "C": "China, Japan", "D": "Tibet, Nepal"}, "explanation": "Page 34 Source Note: Zen thinkers mostly lived in 'China and Japan'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 34, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_