{"id": "7th-t3-u2-q159", "schema_version": "1.0", "kind": "matching", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-07-oppuravu-neri", "chapter_id": null, "topic_id": "ta-t3-u2-oppuravu-similes-match", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒப்புரவு நெறிக்குரிய உவமைகளையும் அவற்றின் தத்துவ விளக்கங்களையும் பொருத்துக:\n(a) ஊருணி - 1. ஊர் நடுவே பழுத்த மரம்\n(b) பயன்மரம் - 2. தன்னையே தந்து பிணி தீர்ப்பது\n(c) மருந்து மரம் - 3. வறியவர்க்கு அளிப்பது\n(d) ஈகை - 4. ஊர் மக்கள் அனைவருக்கும் குடிநீர் தருவது"}], "options": {"A": "a-1, b-4, c-2, d-3", "B": "a-4, b-2, c-1, d-3", "C": "a-3, b-1, c-4, d-2", "D": "a-4, b-1, c-2, d-3"}, "explanation": "பாடநூல் பக்கம் 26:\nஊருணி = ஊர் மக்கள் அனைவருக்கும் குடிநீர் வழங்குவது (4)\nபயன்மரம் = பழுத்து அனைவருக்கும் கனி தருவது (1)\nமருந்து மரம் = தன் இலை பட்டை தந்து நோய் தீர்ப்பது (2)\nஈகை = வறியவர்க்கு அளிப்பது (3).\nவரிசை: 4, 1, 2, 3."}, "en": {"blocks": [{"type": "text", "content": "Match the philosophical similes of Oppuravu:\n(a) Ooruni - 1. Fruit tree in town center\n(b) Payanmaram - 2. Curing disease offering itself\n(c) Marunthu maram - 3. Bestowing to destitute\n(d) Eegai - 4. Providing drinking water to all"}], "options": {"A": "a-1, b-4, c-2, d-3", "B": "a-4, b-2, c-1, d-3", "C": "a-3, b-1, c-4, d-2", "D": "a-4, b-1, c-2, d-3"}, "explanation": "Correct match: Ooruni = 4, Payanmaram = 1, Marunthu maram = 2, Eegai = 3. Sequence: 4, 1, 2, 3."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L1", "content_ta": "ஊருணி", "content_en": "Ooruni"}, {"id": "L2", "content_ta": "பயன்மரம்", "content_en": "Payanmaram"}, {"id": "L3", "content_ta": "மருந்து மரம்", "content_en": "Marunthu maram"}, {"id": "L4", "content_ta": "ஈகை", "content_en": "Eegai"}], "right": [{"id": "R1", "content_ta": "ஊர் நடுவே பழுத்த மரம்", "content_en": "Fruit-laden tree in town"}, {"id": "R2", "content_ta": "தன்னையே தந்து பிணி தீர்ப்பது", "content_en": "Curing ailment by offering itself"}, {"id": "R3", "content_ta": "வறியவர்க்கு அளிப்பது", "content_en": "Giving to the destitute"}, {"id": "R4", "content_ta": "ஊர் மக்கள் அனைவருக்கும் குடிநீர் தருவது", "content_en": "Providing water to all villagers"}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 26, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["oppuravu_neri", "similes", "matching"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "subject_expert_tamil", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "7th-t3-u2-q160", "schema_version": "1.0", "kind": "grammar", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-06-aram-ennum-kadhir", "chapter_id": null, "topic_id": "ta-t3-u2-grammar-maathirai-paingoozh", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பைங்கூழ்' என்னும் சொல்லின் மொத்த மாத்திரை அளவைக் கணக்கிடுக:"}], "options": {"A": "5 மாத்திரை", "B": "4.5 மாத்திரை", "C": "4 மாத்திரை", "D": "3.5 மாத்திரை"}, "explanation": "'பைங்கூழ்' மாத்திரை பகுப்பாய்வு:\nபை (ஐகார நெடில்) = 2 மாத்திரை\nங் (மெய்) = 0.5 மாத்திரை\nகூ (ஊகார நெடில்) = 2 மாத்திரை\nழ் (மெய்) = 0.5 மாத்திரை\nமொத்தம் = 2 + 0.5 + 2 + 0.5 = 5 மாத்திரை."}, "en": {"blocks": [{"type": "text", "content": "Calculate the total prosodic metric count (Maathirai) for the poetic word 'Paingoozh':"}], "options": {"A": "5 Maathirai", "B": "4.5 Maathirai", "C": "4 Maathirai", "D": "3.5 Maathirai"}, "explanation": "Metrics for 'Paingoozh': Pai (2) + ng (0.5) + koo (2) + zh (0.5) = 5 Maathirai. Key A is correct."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 23, "chapter": null, "section": null, "reference": null, "