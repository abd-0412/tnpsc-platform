{"id": "7th-t3-u2-q193", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "7", "subject_id": "general_tamil", "term": "3", "unit_id": "ta-t3-u2-oppuravu", "lesson_id": "lesson-07-unmai-oli", "chapter_id": null, "topic_id": "ta-t3-u2-zen-quote-completion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்றை நிறைவு செய்க:\n'ஜென் என்னும் ஜப்பானிய மொழிச் சொல்லுக்குத் __________ என்பது பொருள்'."}], "options": {"A": "தியானம் செய்", "B": "அறம் செய்", "C": "உண்மையை நாடு", "D": "தன்னலத்தைத் துற"}, "explanation": "பாடநூல் பக்கம் 34 நூல்வெளி: 'ஜென் என்னும் ஜப்பானிய மொழிச் சொல்லுக்குத் தியானம் செய் என்பது பொருள்'."}, "en": {"blocks": [{"type": "text", "content": "Complete the quote:\n'The Japanese word Zen literally means __________'."}], "options": {"A": "Meditate (Dhyaanam sey)", "B": "Do charity (Aram sey)", "C": "Seek truth (Unmaiyai naadu)", "D": "Renounce self (Thannalathai thura)"}, "explanation": "Page 34 Source Note: 'The Japanese word Zen means meditate (Dhyaanam sey)'."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "7", "term": "3", "edition": "2024-2025", "page": 34, "chapter": null, "section": null, "reference": null, "url": null, "source_notes": null}, "previous_