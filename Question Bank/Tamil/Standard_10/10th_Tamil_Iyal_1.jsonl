{"id": "10th-u1-q103", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "urai_nadaiyin_aninangal", "chapter_id": null, "topic_id": "antithesis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எதிரெதிரான பொருள்களைத் தரும் சொற்களை உரைநடையில் இணைத்து அமைப்பது எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "இணை ஒப்பு", "B": "உவமை", "C": "எதிரிணை இயைபு (Antithesis)", "D": "முரண்படு மெய்ம்மை"}, "explanation": "எதிரெதிரான பொருள்களை இணைத்து அமைப்பது \"எதிரிணை இயைபு\" (Antithesis) எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What stylistic figure contrasts sharply opposing concepts in balanced phrases in prose?", "media_id": null}], "options": {"A": "Analogy", "B": "Simile", "C": "Antithesis (Ethirinai Iyaibu)", "D": "Paradox"}, "explanation": "Juxtaposing opposing contrasting thoughts side-by-side is termed Antithesis (Ethirinai Iyaibu)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 13, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 13", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null,