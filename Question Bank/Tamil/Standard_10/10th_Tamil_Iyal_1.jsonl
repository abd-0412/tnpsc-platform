{"id": "10th-u1-q139", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "eluthu_sol", "chapter_id": null, "topic_id": "otralabedai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒற்றளபெடையில் அளபெடுக்கும் ஒற்றெழுத்தின் மாத்திரை அளவு யாது?", "media_id": null}], "options": {"A": "அரை மாத்திரை", "B": "இரண்டு மாத்திரை", "C": "ஒரு மாத்திரை", "D": "கால் மாத்திரை"}, "explanation": "ஒற்றெழுத்தின் இயல்பான மாத்திரை 1/2; அது அளபெடுக்கும் போது மேலும் 1/2 மாத்திரை பெற்று 1 மாத்திரையாக ஒலிக்கும்."}, "en": {"blocks": [{"type": "text", "content": "What is the total duration (Maathirai) of an elongated consonant in Otrralabedai?", "media_id": null}], "options": {"A": "Half mora", "B": "Two morae", "C": "One mora (0.5 + 0.5)", "D": "Quarter mora"}, "explanation": "A consonant has 0.5 mora naturally; when elongated in Otrralabedai it doubles to 1 full mora."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 16, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 16", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "ye