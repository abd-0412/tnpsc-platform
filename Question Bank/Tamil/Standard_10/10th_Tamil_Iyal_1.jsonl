{"id": "10th-u1-q141", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "book_back", "chapter_id": null, "topic_id": "palavul_theriga", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"மெத்த வணிகலன்\" என்னும் தொடரில் தமிழழகனார் குறிப்பிடுவது எது?", "media_id": null}], "options": {"A": "வணிகக் கப்பல்களும் ஐம்பெரும் காப்பியங்களும்", "B": "பெரும் வணிகமும் பெரும் கலன்களும்", "C": "ஐம்பெரும் காப்பியங்களும் அணிகலன்களும்", "D": "வணிகக் கப்பல்களும் அணிகலன்களும்"}, "explanation": "தமிழழகனார் இரட்டுற மொழிதலில் கடலுக்கு வணிகக் கப்பல்களையும், தமிழுக்கு ஐம்பெரும் காப்பியங்களையும் மெத்த வணிகலன் என்று குறிப்பிடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What does Thamizhazhaganar refer to with the phrase \"Metha Vanigalan\"?", "media_id": null}], "options": {"A": "Merchant ships and the Five Great Epics", "B": "Great trade and great vessels", "C": "Five epics and ornaments", "D": "Merchant vessels and jewellery"}, "explanation": "In his double entendre, it signifies merchant ships for the ocean and the Five Great Epics for Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 19, "cha