{"id": "10th-u1-q097", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "urai_nadaiyin_aninangal", "chapter_id": null, "topic_id": "analogy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"மழை பெய்யும்போது குடை பிடிப்பது போல, துன்பம் வரும்போது மனிதன் தற்காத்துக் கொள்ள வேண்டும்\" - இது உரைநடையில் எந்த அணி உத்தியைச் சார்ந்தது?", "media_id": null}], "options": {"A": "இணை ஒப்பு (Analogy)", "B": "முரண்படு மெய்ம்மை", "C": "எதிரிணை இயைபு", "D": "சொல் முரண்"}, "explanation": "மழைக்குக் குடை பிடிப்பது போல் துன்பத்தைத் தாங்குவது என்று ஒப்பிடுவது \"இணை ஒப்பு\" (Analogy) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "\"Just as one holds an umbrella during rain, one must shield oneself when misery strikes\" exemplifies which prose device?", "media_id": null}], "options": {"A": "Analogy (Inai Oppu)", "B": "Oxymoron", "C": "Antithesis", "D": "Paradox"}, "explanation": "This represents an everyday logical Analogy (Inai Oppu)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 12, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 12", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["உரைநடையின் அணிநலன்கள்", "இணை ஒப்பு", "உவமம்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u1-q098", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "urai_nadaiyin_aninangal", "chapter_id": null, "topic_id": "rhyme_prose", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"தென்றல் அசைந்துவரும் தென்தமிழ் நாட்டில் அமைந்த திருக்குற்றாலம் மலைவளம் படைத்த பழம்பதியாகும்\" - என்று எதுகை மோனை நடை ததும்ப எழுதிய தமிழறிஞர் யார்?", "media_id": null}], "options": {"A": "திரு. வி. க.", "B": "ரா. பி. சேதுப்பிள்ளை", "C": "வ. உ. சி.", "D": "பாரதியார்"}, "explanation": "இவ்வரியை எழுதியவர் சொல்லின் செல்வர் ரா. பி. சேதுப்பிள்ளை ஆவார் (நூல்: தமிழின்பம்)."}, "en": {"blocks": [{"type": "text", "content": "Who penned the alliterative and rhythmic prose describing Thirukutralam: \"Thendral asainthuvarum thenthamizh naattil...\"?", "media_id": null}], "options": {"A": "Thiru. Vi. Ka.", "B": "R. P. Sethupillai", "C": "V. O. C.", "D": "Bharathiyar"}, "explanation": "These poetic alliterative prose lines were written by \"Solleruzhavar\" R. P. Sethupillai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 13, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 13", "url":