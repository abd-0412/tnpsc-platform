{"id": "10th-u1-q107", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "urai_nadaiyin_aninangal", "chapter_id": null, "topic_id": "prose_evolution", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "செய்யுளில் உள்ள எதுகை, மோனை, இயைபு ஆகிய யாப்பு உறுப்புகளை உரைநடையில் கையாள்வதன் நோக்கம் யாது?", "media_id": null}], "options": {"A": "பக்கங்களை நிரப்புதல்", "B": "கடினமாக்குதல்", "C": "ஓசை இன்பமும் சுவையும் கூட்டுதல்", "D": "எழுத்துப் பிழைகளைத் தவிர்த்தல்"}, "explanation": "உரைநடையில் எதுகை, மோனைகளைப் பயன்படுத்துவது வாசிப்பவருக்கு ஓசை இன்பத்தையும் இலக்கியச் சுவையையும் கூட்டுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the primary aesthetic purpose of weaving alliteration and rhyme (Monai, Ethukai) into Tamil prose?", "media_id": null}], "options": {"A": "Filling pages", "B": "Making it intricate", "C": "Enhancing rhythmic harmony and literary resonance", "D": "Avoiding spelling mistakes"}, "explanation": "Employing rhyme patterns lends auditory elegance, musicality, and reading pleasure to prose."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 14, "chapter": null, "secti