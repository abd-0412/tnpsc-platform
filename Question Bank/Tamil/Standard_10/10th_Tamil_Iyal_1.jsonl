{"id": "10th-u1-q124", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "eluthu_sol", "chapter_id": null, "topic_id": "moovagai_mozhi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரண்டு அல்லது அதற்கு மேற்பட்ட தனிமொழிகள் தொடர்ந்து வந்து பொருள் தருவது எது?", "media_id": null}], "options": {"A": "தனிமொழி", "B": "பொதுமொழி", "C": "பகாப்பதம்", "D": "தொடர்மொழி"}, "explanation": "இரண்டு அல்லது அதற்கு மேற்பட்ட தனிமொழிகள் தொடர்ந்து வந்து பொருள் தருவது தொடர்மொழி எனப்படும் (எ.கா: கண்ணன் வந்தான்)."}, "en": {"blocks": [{"type": "text", "content": "When two or more individual words follow in sequence conveying collective meaning, what is it termed?", "media_id": null}], "options": {"A": "Thanimozhi", "B": "Pothumozhi", "C": "Pagaappatham", "D": "Thodarmpathozhi"}, "explanation": "A sequence of continuous words forming a syntactic group is Thodarmpathozhi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 16, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 16", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null,