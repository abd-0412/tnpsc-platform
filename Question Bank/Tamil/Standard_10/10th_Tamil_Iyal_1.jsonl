{"id": "10th-u1-q064", "schema_version": "1.0", "kind": "matching", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "annai_mozhiye", "chapter_id": null, "topic_id": "poem_lines", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பொருத்துக (செய்யுள் தொடர் - உணர்த்தும் நூல்): \nஅ) பாப்பத்தே - 1) மணிமேகலை \nஆ) எண்தொகையே - 2) பதினெண்கீழ்க்கணக்கு \nஇ) நற்கணக்கே - 3) பத்துப்பாட்டு \nஈ) மணிமேகலைவடிவே - 4) எட்டுத்தொகை", "media_id": null}], "options": {"A": "அ-1, ஆ-2, இ-3, ஈ-4", "B": "அ-2, ஆ-4, இ-1, ஈ-3", "C": "அ-4, ஆ-3, இ-2, ஈ-1", "D": "அ-3, ஆ-4, இ-2, ஈ-1"}, "explanation": "பாப்பத்தே = பத்துப்பாட்டு; எண்தொகையே = எட்டுத்தொகை; நற்கணக்கே = பதினெண்கீழ்க்கணக்கு; மணிமேகலைவடிவே = ஐம்பெருங்காப்பியங்களுள் ஒன்றான மணிமேகலை."}, "en": {"blocks": [{"type": "text", "content": "Match poetic phrase with referenced literature:\na) Paappathe - 3) Pathuppattu\nb) Ennthogaiye - 4) Ettuthogai\nc) Narkanakke - 2) Pathinenkeelkanakku\nd) Manimekalai vadive - 1) Manimekalai", "media_id": null}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-4, c-1, d-3", "C": "a-4, b-3, c-2, d-1", "D": "a-3, b-4, c-2, d-1"}, "explanation": "Paappathe refers to Pathuppattu, Ennthogaiye to Ettuthogai, Narkanakke to Pathinenkeelkanakku, and Manimekalai to the epic."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publi