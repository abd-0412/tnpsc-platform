{"id": "10th-u1-q063", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "annai_mozhiye", "chapter_id": null, "topic_id": "poem_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"தென்னன் மகளே! திருக்குறளின் மாண்புகழே!\" - இதில் \"தென்னன்\" என்பது யாரைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "சேரன்", "B": "சோழன்", "C": "பாண்டியன்", "D": "பல்லவன்"}, "explanation": "தென்னன் என்பது பாண்டிய மன்னனைக் குறிக்கும். பாண்டியன் வளர்த்த தமிழ்ச் சங்கத்தில் வளர்ந்தவள் தமிழ்த்தாய்."}, "en": {"blocks": [{"type": "text", "content": "In the line \"Thennan magale! Thirukkuralin maanpugazhe!\", who does \"Thennan\" refer to?", "media_id": null}], "options": {"A": "Chera king", "B": "Chola king", "C": "Pandya king", "D": "Pallava king"}, "explanation": "\"Thennan\" refers to the Pandya monarch under whose patronized Sangams the Tamil language blossomed."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name":