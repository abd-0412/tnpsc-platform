{"id": "10th-u1-q123", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "eluthu_sol", "chapter_id": null, "topic_id": "moovagai_mozhi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஒரு சொல் தனித்து நின்று பொருள் தருமாயின் அது எவ்வகை மொழி எனப்படும்?", "media_id": null}], "options": {"A": "தொடர்மொழி", "B": "பொதுமொழி", "C": "தனிமொழி", "D": "விரவுமொழி"}, "explanation": "ஒரு சொல் தனித்து நின்று ஒரு பொருளைத் தருவது தனிமொழி எனப்படும் (எ.கா: கண், படி, கண்ணன்)."}, "en": {"blocks": [{"type": "text", "content": "When a single word stands independently and imparts meaning, what is it called?", "media_id": null}], "options": {"A": "Thodarmpathozhi", "B": "Pothumozhi", "C": "Thanimozhi", "D": "Viravumozhi"}, "explanation": "A single independent meaningful word is a Thanimozhi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 16, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 16", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "it