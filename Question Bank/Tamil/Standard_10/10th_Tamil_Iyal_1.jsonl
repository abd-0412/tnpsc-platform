{"id": "10th-u1-q099", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "urai_nadaiyin_aninangal", "chapter_id": null, "topic_id": "author_title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"சொல்லின் செல்வர்\" என்று பாராட்டப்பெறும் தமிழறிஞர் யார்?", "media_id": null}], "options": {"A": "அறிஞர் அண்ணா", "B": "ஈ. வெ. ரா. பெரியார்", "C": "ரா. பி. சேதுப்பிள்ளை", "D": "மு. வரதராசனார்"}, "explanation": "\"சொல்லின் செல்வர்\" என்று பாராட்டப்படுபவர் ரா. பி. சேதுப்பிள்ளை ஆவார். (சொல்லின் செல்வன் - அனுமன்)."}, "en": {"blocks": [{"type": "text", "content": "Which eminent Tamil scholar is honored with the prestigious title \"Solin Selvar\"?", "media_id": null}], "options": {"A": "Arignar Anna", "B": "E. V. R. Periyar", "C": "R. P. Sethupillai", "D": "Mu. Varadarajanar"}, "explanation": "R. P. Sethupillai is celebrated as \"Solin Selvar\". (Hanuman is \"Solin Selvan\")."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 13, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 13", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exa