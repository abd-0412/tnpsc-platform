{"id": "10th-u1-q062", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "annai_mozhiye", "chapter_id": null, "topic_id": "famous_quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"சாகும் போதும் தமிழ்படித்துச் சாகவேண்டும் - என்றன் சாம்பலும் தமிழ்மணந்து வேகவேண்டும்\" என்று பாடிய கவிஞர் யார்?", "media_id": null}], "options": {"A": "பாரதிதாசன்", "B": "கா. சச்சிதானந்தன்", "C": "பெருஞ்சித்திரனார்", "D": "கண்ணதாசன்"}, "explanation": "இவ்வரியைப் பாடியவர் கா. சச்சிதானந்தன் (இலங்கைத் தமிழறிஞர்) ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who penned the famous quote: \"Even when dying I must die studying Tamil - and even my ashes must burn with the fragrance of Tamil\"?", "media_id": null}], "options": {"A": "Bharathidasan", "B": "K. Sachithananthan", "C": "Perunchithiranar", "D": "Kannadasan"}, "explanation": "These celebrated lines were composed by K. Sachithananthan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 2, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "e