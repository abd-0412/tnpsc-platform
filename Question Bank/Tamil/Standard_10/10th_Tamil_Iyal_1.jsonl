{"id": "10th-u1-q100", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "urai_nadaiyin_aninangal", "chapter_id": null, "topic_id": "sahitya_akademi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழில் சாகித்திய அகாதெமி விருது பெற்ற முதல் நூல் எது?", "media_id": null}], "options": {"A": "புதிய உரைநடை", "B": "சேரமான் காதலி", "C": "அகல் விளக்கு", "D": "தமிழின்பம் (ரா. பி. சேதுப்பிள்ளை, 1955)"}, "explanation": "சாகித்திய அகாதெமி விருது முதன்முதலில் 1955-இல் ரா. பி. சேதுப்பிள்ளையின் \"தமிழின்பம்\" என்னும் கட்டுரை நூலுக்கு வழங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which was the very first book to win the Sahitya Akademi Award for Tamil in 1955?", "media_id": null}], "options": {"A": "Puthiya Urainadai", "B": "Cheraman Kathali", "C": "Agal Vilakku", "D": "Thamizhinbam (R. P. Sethupillai, 1955)"}, "explanation": "\"Thamizhinbam\" by R. P. Sethupillai was the first ever Tamil book to win the Sahitya Akademi Award (1955)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 13, "chapter": null, "section": null, "reference": "10th Tamil, Unit 1, Page 13", "url": null, "sou