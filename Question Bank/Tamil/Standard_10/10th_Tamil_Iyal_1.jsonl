{"id": "10th-u1-q137", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_1", "lesson_id": "eluthu_sol", "chapter_id": null, "topic_id": "comparison", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொழிற்பெயருக்கும் வினையாலணையும் பெயருக்கும் உள்ள வேறுபாடுகளில் சரியான கூற்றைத் தேர்க:", "media_id": null}], "options": {"A": "தொழிற்பெயர் காலம் காட்டாது; வினையாலணையும் பெயர் காலம் காட்டும்", "B": "தொழிற்பெயர் மூவிடத்திற்கும் உரியது", "C": "வினையாலணையும் பெயர் படர்க்கைக்கே உரியது", "D": "தொழிற்பெயர் கருத்தாவைக் குறிக்கும்"}, "explanation": "தொழிற்பெயர் தொழிலை மட்டும் குறிக்கும், காலம் காட்டாது, படர்க்கைக்கே வரும். வினையாலணையும் பெயர் கருத்தாவைக் குறிக்கும், காலம் காட்டும், மூவிடத்திற்கும் வரும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the correct grammatical contrast between a Verbal Noun and a Participial Noun:", "media_id": null}], "options": {"A": "Verbal noun does not show tense; participial noun marks tense", "B": "Verbal noun applies to all 3 persons", "C": "Participial noun is restricted to 3rd person only", "D": "Verbal noun denotes the agent"}, "explanation": "A verbal noun never conveys tense; a participial noun always embodies tense."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and E