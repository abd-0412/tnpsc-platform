{"id": "10th-u2-q135", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "puyalile_oru_thoni", "chapter_id": null, "topic_id": "story_korean", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"புயலிலே ஒரு தோணி\" கதையில் வரும் கதாபாத்திரங்களில் கப்பலின் தலைவராக அல்லது மாலுமியாகச் செயல்பட்டவர் யார்?", "media_id": null}], "options": {"A": "சிங்காரம்", "B": "முருகேசன்", "C": "காப்டன் மற்றும் சுக்காணி பிடித்த கொரியன்/சீன மாலுமிகள்", "D": "ராமநாதன்"}, "explanation": "கப்பலில் பாய்மரத்தை ஒழுங்குபடுத்தி சுக்கானைத் தாங்கிப் பிடித்தவர்கள் பல்தேசிய மாலுமிகள் ஆவர்."}, "en": {"blocks": [{"type": "text", "content": "Who steered the rudder through the storm in the vessel?", "media_id": null}], "options": {"A": "Singaram", "B": "Murugesan", "C": "The Captain and resilient multi-ethnic helmsmen", "D": "Ramanathan"}, "explanation": "The captain and experienced native seamen fought the raging squall to stabilize the helm."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 37, "chapter": null, "section": null, "reference": "10th Tamil, Unit 2, Page 37", "url": null, "source_notes": null}, "previous_year": {"