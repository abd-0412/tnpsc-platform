{"id": "10th-u2-q125", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "thogainilai_thodargal", "chapter_id": null, "topic_id": "vetrumaithogai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரு சொற்களுக்கு இடையில் வேற்றுமை உருபுகள் (ஐ, ஆல், கு, இன், அது, கண்) மறைந்து வந்து பொருள் தருவது எது?", "media_id": null}], "options": {"A": "வேற்றுமைத் தொகை", "B": "வினைத்தொகை", "C": "பண்புத்தொகை", "D": "உம்மைத்தொகை"}, "explanation": "பெயர்ச்சொற்களுக்கு இடையே வேற்றுமை உருபுகள் மறைந்து வருவது \"வேற்றுமைத் தொகை\" எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What compound is formed when case markers (Ai, Aal, Ku, In, Athu, Kann) are elided between words?", "media_id": null}], "options": {"A": "Case compound (Vetrumaithogai)", "B": "Vinaithogai", "C": "Panbuthogai", "D": "Ummaithogai"}, "explanation": "Elision of internal case inflection markers forms a Vetrumaithogai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 40, "chapter": null, "section": null, "reference": "10th Tamil, Unit 2, Page 40", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "ex