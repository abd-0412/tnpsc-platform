{"id": "10th-u2-q054", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "ketkiratha_en_kural", "chapter_id": null, "topic_id": "wind_pollination", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாவரங்களின் இனப்பெருக்கத்திற்குப் பூக்களின் மகரந்தச் சேர்க்கைக்கு உதவும் இன்றியமையாத காரணி எது?", "media_id": null}], "options": {"A": "நெருப்பு", "B": "காற்று", "C": "நிலம்", "D": "சூரிய ஒளி மட்டும்"}, "explanation": "தாவரங்களின் மகரந்தத் துகள்களை ஓரிடத்திலிருந்து மற்றோர் இடத்திற்குச் சுமந்து சென்று மகரந்தச் சேர்க்கைக்கு (Pollination) காற்று பெருந்துணை புரிகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which environmental agent carries pollen grains across plants, enabling vital plant pollination and reproduction?", "media_id": null}], "options": {"A": "Fire", "B": "Wind", "C": "Bedrock soil", "D": "Sunlight alone"}, "explanation": "Wind acts as an indispensable pollinating vector carrying pollen grains across plant species."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 28, "chapter": null, "section": null, "reference": "10th Tamil, Unit 2, Page 28", "url": null, "source_notes": n