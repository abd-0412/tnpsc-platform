{"id": "10th-u2-q121", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "puyalile_oru_thoni", "chapter_id": null, "topic_id": "author_philanthropy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ப. சிங்காரம் தமது வாழ்நாள் சேமிப்பான எவ்வளவு தொகையை மாணவர்களின் கல்வி வளர்ச்சிக்காக உயிலில் எழுதி வைத்துக் கொடையளித்தார்?", "media_id": null}], "options": {"A": "ஏழரை இலட்சம் ரூபாய் (ரூ. 7,50,000)", "B": "ஒரு இலட்சம் ரூபாய்", "C": "பத்து இலட்சம் ரூபாய்", "D": "ஐந்து இலட்சம் ரூபாய்"}, "explanation": "ப. சிங்காரம் எளிய வாழ்வு வாழ்ந்து, தாம் ஈட்டிய சேமிப்பான ஏழரை இலட்சம் ரூபாயை மாணவர் கல்விக்காக அறக்கட்டளையிடம் வழங்கிய மாபெரும் கொடையாளர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "How much of his lifetime savings did Pa. Singaram bequeath in his will to support underprivileged students’ education?", "media_id": null}], "options": {"A": "7.5 Lakh Rupees (Rs. 7,50,000)", "B": "1 Lakh Rupees", "C": "10 Lakh Rupees", "D": "5 Lakh Rupees"}, "explanation": "Living a frugal bachelor life, he donated his entire lifetime savings of Rs. 7.5 lakhs for student educational scholarships."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_