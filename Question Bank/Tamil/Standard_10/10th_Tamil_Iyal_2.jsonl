{"id": "10th-u2-q142", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "thogainilai_thodargal", "chapter_id": null, "topic_id": "vinaithogai_tenses", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"வீசுதென்றல், கொள்களிறு\" என்பன முக்காலத்திற்கும் எவ்வாறு விரியும்?", "media_id": null}], "options": {"A": "இறந்த காலத்திற்கு மட்டும் விரியும்", "B": "வீசிய தென்றல், வீசுகின்ற தென்றல், வீசும் தென்றல் என முக்காலத்திற்கும் விரியும்", "C": "எதிர்காலத்திற்கு மட்டும் விரியும்", "D": "காலமே காட்டாது"}, "explanation": "வினைத்தொகை முக்காலத்திற்கும் பொருந்துமாறு விரியும் (வீசிய தென்றல், வீசுகின்ற தென்றல், வீசும் தென்றல்)."}, "en": {"blocks": [{"type": "text", "content": "How does the Vinaithogai \"Veesuthendral\" morphologically unfold across three tenses?", "media_id": null}], "options": {"A": "Past tense only", "B": "Veesiya thendral (past), Veesuginra thendral (present), Veesum thendral (future)", "C": "Future tense only", "D": "Lacks tense completely"}, "explanation": "Vinaithogai accommodates all three grammatical tenses seamlessly."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 41, "chapter