{"id": "10th-u2-q133", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "thogainilai_thodargal", "chapter_id": null, "topic_id": "vetrumai_matching", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பொருத்துக (வேற்றுமைத் தொகைகள்): \nஅ) பால் பருகினான் - 1) 2-ஆம் வேற்றுமைத் தொகை \nஆ) கைவணங்கினான் - 2) 3-ஆம் வேற்றுமைத் தொகை \nஇ) தம்பிக்குக் கொடுத்தான் - 3) 4-ஆம் வேற்றுமை விரி \nஈ) தலைமயிர் - 4) 6-ஆம் வேற்றுமைத் தொகை", "media_id": null}], "options": {"A": "அ-1, ஆ-2, இ-3, ஈ-4", "B": "அ-2, ஆ-1, இ-4, ஈ-3", "C": "அ-3, ஆ-4, இ-1, ஈ-2", "D": "அ-4, ஆ-3, இ-2, ஈ-1"}, "explanation": "பாலை பருகினான் = 2-ஆம் வேற்றுமைத் தொகை; கையால் வணங்கினான் = 3-ஆம் வேற்றுமைத் தொகை; தம்பிக்குக் கொடுத்தான் = 4-ஆம் வேற்றுமை விரி; தலையினது மயிர் = 6-ஆம் வேற்றுமைத் தொகை."}, "en": {"blocks": [{"type": "text", "content": "Match case compounds with their classification:\na) Paal paruginaan - 1) 2nd case compound\nb) Kaivananginaan - 2) 3rd case compound\nc) Thambikkuk koduthaan - 3) 4th case explicit\nd) Thalaimayir - 4) 6th case compound", "media_id": null}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-1, c-4, d-3", "C": "a-3, b-4, c-1, d-2", "D": "a-4, b-3, c-2, d-1"}, "explanation": "Correctly aligned case compound classifications."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "T