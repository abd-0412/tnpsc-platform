{"id": "10th-u2-q136", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "puyalile_oru_thoni", "chapter_id": null, "topic_id": "literary_style", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ப. சிங்காரத்தின் எழுத்து நடையின் தனிப்பெரும் சிறப்பு யாது?", "media_id": null}], "options": {"A": "மிகவும் கடினமான செய்யுள் நடை", "B": "ஆங்கிலச் சொற்களை மட்டுமே பயன்படுத்துதல்", "C": "எதுகைகளை மட்டும் அடுக்குதல்", "D": "வாழ்வியல் அனுபவங்களை ஒளிவுமறைவின்றி எதார்த்தமான நேரடி வீச்சுடன், சுழன்றடிக்கும் புயலின் வேகத்தோடு கூடிய விவரிப்பு நடை"}, "explanation": "நேரடி கடற்பயண அனுபவமும், உலகப் போர்க்கால நெருக்கடியும் கலந்த உண்மைத் தன்மையே சிங்காரத்தின் தனித்துவ நடையாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the distinct hallmark of Pa. Singaram’s literary prose style?", "media_id": null}], "options": {"A": "Obscure archaic verse", "B": "English vocabulary only", "C": "Mere rhyming words", "D": "Raw, realistic, kinetic prose charged with the visceral rhythm of the raging tempest and authentic diaspora experience"}, "explanation": "His prose vibrates with authentic realism, kinetic velocity, and lived maritime experience."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 38, "chapter": null, "section": null, "reference": "10th Tamil, Unit 2, Page 38", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["புயலிலே ஒரு தோணி", "எழுத்து நடை", "ப.சிங்காரம்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
