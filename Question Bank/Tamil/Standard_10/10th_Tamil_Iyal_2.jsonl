{"id": "10th-u2-q122", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "puyalile_oru_thoni", "chapter_id": null, "topic_id": "works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ப. சிங்காரம் எழுதிய மற்றொரு புகழ்பெற்ற புதினத்தின் பெயர் யாது?", "media_id": null}], "options": {"A": "சாயாவனம்", "B": "கடலுக்கு அப்பால்", "C": "வேரில் பழுத்த பலா", "D": "ஒரு புளியமரத்தின் கதை"}, "explanation": "ப. சிங்காரம் \"புயலிலே ஒரு தோணி\", \"கடலுக்கு அப்பால்\" ஆகிய இரு புகழ்பெற்ற புதினங்களை எழுதியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "What is the title of the other celebrated novel authored by Pa. Singaram?", "media_id": null}], "options": {"A": "Saayavanam", "B": "Kadalukku Appaal", "C": "Veeril Pazhutha Pala", "D": "Oru Puliyamarathin Kathai"}, "explanation": "Pa. Singaram wrote two landmark novels: \"Puyalile Oru Thoni\" and \"Kadalukku Appaal\"."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 39, "chapter": null, "section": null, "reference": "10th Tamil, Unit 2, Page 39", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_na