{"id": "10th-u2-q151", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "kalaichorkal", "chapter_id": null, "topic_id": "vocabulary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"Sea breeze\" மற்றும் \"Land breeze\" ஆகியவற்றின் சரியான தமிழாக்கங்கள் முறையே எவை?", "media_id": null}], "options": {"A": "நிலக்காற்று, கடற்காற்று", "B": "பெருங்காற்று, புயல்", "C": "கடற்காற்று, நிலக்காற்று", "D": "சூறாவளி, சுழல்காற்று"}, "explanation": "Sea breeze = கடற்காற்று; Land breeze = நிலக்காற்று."}, "en": {"blocks": [{"type": "text", "content": "What are the correct Tamil translations for \"Sea breeze\" and \"Land breeze\" respectively?", "media_id": null}], "options": {"A": "Land breeze, Sea breeze", "B": "Gale, Storm", "C": "Kadarkaattru (Sea breeze), Nilakkaattru (Land breeze)", "D": "Tornado, Whirlwind"}, "explanation": "Sea breeze translates to Kadarkaattru, and Land breeze translates to Nilakkaattru."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 46, "chapter": null, "section": null, "reference": "10th Tamil, Unit 2, Page 46", "url": null, "source_notes": null}, "previous_year": {"is_previ