{"id": "10th-u2-q148", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_2", "lesson_id": "thogainilai_thodargal", "chapter_id": null, "topic_id": "anmozhithogai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வேற்றுமை, வினை, பண்பு, உவமை, உம்மை ஆகிய தொகைநிலைத் தொடர்கள் அல்லாத வேறு சொற்கள் மறைந்து நின்று பொருள் தருவது எது?", "media_id": null}], "options": {"A": "பொதுமொழி", "B": "தொடர்மொழி", "C": "இரட்டைக்கிளவி", "D": "அன்மொழித்தொகை"}, "explanation": "அல்லாத மொழி தொக்கு (மறைந்து) நிற்பது \"அன்மொழித்தொகை\" எனப்படும் (அல் + மொழி + தொகை). எ.கா: சிவப்புச் சட்டை பேசினார்."}, "en": {"blocks": [{"type": "text", "content": "What compound arises when words outside the five standard compound types (case, verb, quality, simile, copulative) are elided to convey meaning?", "media_id": null}], "options": {"A": "Pothumozhi", "B": "Thodarmpathozhi", "C": "Irattaikkilavi", "D": "Anmozhithogai (Metonymic / Exocentric compound)"}, "explanation": "An exocentric compound where outside referents are elided is termed Anmozhithogai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 42, "chapter": null, "section": null, "referen