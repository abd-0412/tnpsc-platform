{"id": "10th-u4-q112", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "paripaadal", "chapter_id": null, "topic_id": "chapter_summary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீரந்தையாரின் பரிபாடல் பாடலின் ஒட்டுமொத்தக் கருத்து யாது?", "media_id": null}], "options": {"A": "பூமி அழிந்துவிடும்", "B": "வானத்தில் எதுவும் இல்லை", "C": "மழை மட்டுமே முக்கியம்", "D": "வானம், காற்று, தீ, நீர், நிலம் ஆகிய ஐம்பூதங்களின் சுழற்சிப் பரிணாமத்தின் வாயிலாகவே இவ்வுலகமும் உயிர்களும் தோன்றிக் காலந்தோறும் இயங்கி வருகின்றன"}, "explanation": "பிரபஞ்சம் பெருவெடிப்பில் தொடங்கி ஐம்பூதங்களின் தொடர் பரிணாம மாற்றங்களால் உயிர்வளம் மிக்க பூலோகமாக உருவான அறிவியல் வரலாற்றை அழகுறக் கூறுவதே இப்பாடலின் சாரமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the grand thematic essence of Keeranthaiyar’s Paripaadal hymn?", "media_id": null}], "options": {"A": "Imminent apocalypse", "B": "Space is total vacuum", "C": "Rainfall is the sole factor", "D": "The cosmic universe and terrestrial life evolved sequentially through the rhythmic, orderly cyclical evolution of the five primordial elements"}, "explanation": "The universe and terrestrial life evolved systematically through the cyclical evolution of the five elements."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "