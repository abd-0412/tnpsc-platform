{"id": "10th-u4-q115", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "vinnaith_thaandiya_thannambikkai", "chapter_id": null, "topic_id": "brief_history_of_time", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஸ்டீபன் ஹாக்கிங் இயற்றி உலகெங்கும் 40-க்கும் மேற்பட்ட மொழிகளில் மொழிபெயர்க்கப்பட்டு 1 கோடி பிரதிகளுக்கு மேல் விற்பனையான புகழ்பெற்ற நூல் எது?", "media_id": null}], "options": {"A": "வானியல் வரலாறு", "B": "இயற்பியல் விதிகள்", "C": "காலத்தின் சுருக்கமான வரலாறு (A Brief History of Time)", "D": "அண்டத்தின் எல்லை"}, "explanation": "1988-இல் வெளிவந்த \"காலத்தின் சுருக்கமான வரலாறு\" (A Brief History of Time) என்னும் நூல் 40 மொழிகளில் மொழிபெயர்க்கப்பட்டு 1 கோடிக்கும் மேல் விற்று சாதனை படைத்தது."}, "en": {"blocks": [{"type": "text", "content": "Which landmark science book by Stephen Hawking was translated into 40 languages and sold over 10 million copies?", "media_id": null}], "options": {"A": "History of Astronomy", "B": "Laws of Physics", "C": "A Brief History of Time (Kaalathin Surukkamaana Varalaaru)", "D": "The Edge of Cosmos"}, "explanation": "\"A Brief History of Time\" published in 1988 became a worldwide publishing phenomenon."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 83, "chapter": null, "section": null, "reference": "10th Tamil, Unit 4, Page 83", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["விண்ணைத் தாண்டிய தன்னம்பிக்கை", "காலத்தின் சுருக்கமான வரலாறு", "புத்தகம்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u4-q116", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "vinnaith_thaandiya_thannambikkai", "chapter_id": null, "topic_id": "black_hole_radiation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கருந்துளையிலிருந்து கதிர்வீச்சுகள் வெளிப்பட்டு இறுதியில் அது வெடித்து மறையும் என்று ஸ்டீபன் ஹாக்கிங் நிறுவிய கோட்பாடு எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "நியூட்டன் கதிர்வீச்சு", "B": "ஐன்ஸ்டைன் கதிர்வீச்சு", "C": "ராமன் கதிர்வீச்சு", "D": "ஹாக்கிங் கதிர்வீச்சு (Hawking Radiation)"}, "explanation": "கருந்துளை எதையும் விழுங்க மட்டுமே செய்யும் என்ற நிலையை மாற்றி, அதிலிருந்து அணுத்துகள்கள் கதிர்வீச்சாக வெளியேறும் என ஹாக்கிங் நிறுவியதால் அது \"ஹாக்கிங் கதிர்வீச்சு\" எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What is the theoretical thermal radiation emitted by black holes due to quantum effects discovered by Stephen Hawking called?", "media_id": null}], "options": {"A": "Newtonian Radiation", "B": "Einsteinian Radiation", "C": "Raman Scattering", "D": "Hawking Radiation"}, "explanation": "Hawking Radiation proved that black holes emit subatomic particles and eventually evaporate."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educatio