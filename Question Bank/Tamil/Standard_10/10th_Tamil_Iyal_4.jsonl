{"id": "10th-u4-q113", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "vinnaith_thaandiya_thannambikkai", "chapter_id": null, "topic_id": "scientist_title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"தற்காலத்தின் ஐன்ஸ்டைன்\" என்று உலக விஞ்ஞானிகளால் போற்றப்பட்ட அறிவியலாளர் யார்?", "media_id": null}], "options": {"A": "ஸ்டீபன் ஹாக்கிங் (Stephen Hawking)", "B": "தாமஸ் ஆல்வா எடிசன்", "C": "அப்துல் கலாம்", "D": "சி. வி. ராமன்"}, "explanation": "கருந்துளை ஆய்வுகளில் புரட்சி செய்த ஸ்டீபன் ஹாக்கிங் \"தற்காலத்தின் ஐன்ஸ்டைன்\" என உலக அறிவியல் அறிஞர்களால் போற்றப்படுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Which modern theoretical physicist was acclaimed worldwide as the \"Einstein of Our Times\"?", "media_id": null}], "options": {"A": "Stephen Hawking", "B": "Thomas Alva Edison", "C": "A. P. J. Abdul Kalam", "D": "C. V. Raman"}, "explanation": "Stephen Hawking was globally hailed as the contemporary Einstein."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 81, "chapter": null, "section": null, "reference": "10th Tamil, Unit 4, Page 81", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["விண்ணைத் தாண்டிய தன்னம்பிக்கை", "ஸ்டீபன் ஹாக்கிங்", "ஐன்ஸ்டைன்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u4-q114", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "vinnaith_thaandiya_thannambikkai", "chapter_id": null, "topic_id": "als_disease", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஸ்டீபன் ஹாக்கிங் தமது 21-ஆம் வயதில் எந்த அரிய நரம்புத் தளர்ச்சி நோயால் பாதிக்கப்பட்டார்?", "media_id": null}], "options": {"A": "மலேரியா", "B": "அமியோட்ரோபிக் லேட்டரல் ஸ்களீரோசிஸ் (ALS - Amyotrophic Lateral Sclerosis)", "C": "டைபாய்டு", "D": "காசநோய்"}, "explanation": "ஸ்டீபன் ஹாக்கிங் தமது 21-ஆம் வயதில் தண்டுவட நரம்பு நோயான பக்கவாதத்தை ஏற்படுத்தும் ALS நோயால் பாதிக்கப்பட்டார்."}, "en": {"blocks": [{"type": "text", "content": "At age 21, which rare motor neuron disease afflicted Stephen Hawking, paralyzing his body?", "media_id": null}], "options": {"A": "Malaria", "B": "Amyotrophic Lateral Sclerosis (ALS)", "C": "Typhoid", "D": "Tuberculosis"}, "explanation": "He was diagnosed with Amyotrophic Lateral Sclerosis (ALS), a progressive motor neuron disease."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 81, "chapter": null, "section": null, "reference": "10th Tamil, Unit 4, Page 81", "ur