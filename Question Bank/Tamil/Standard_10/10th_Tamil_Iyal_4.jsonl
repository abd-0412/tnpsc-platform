{"id": "10th-u4-q002", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "seyarkai_nunnarivu", "chapter_id": null, "topic_id": "virtual_assistant", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திறன்பேசிகளில் (Smartphones) நாம் பேசுவதை உணர்ந்து செயல்படும் மென்பொருள் எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "அச்சுப் பொறி", "B": "மெய்நிகர் உதவியாளர் (Virtual Assistant)", "C": "திரைப்படக் கருவி", "D": "ஒலி பெருக்கி"}, "explanation": "திறன்பேசிகளில் நாம் சொல்வதைப் புரிந்துகொண்டு அழைப்புகளை ஏற்படுத்துவது, செய்திகளை அனுப்புவது போன்ற பணிகளைச் செய்யும் மென்பொருள்கள் \"மெய்நிகர் உதவியாளர்\" (Virtual Assistant) எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What software in modern smartphones understands voice commands and performs tasks autonomously?", "media_id": null}], "options": {"A": "Printer", "B": "Virtual Assistant (Meinigazh Uthaviyaalar)", "C": "Projector", "D": "Loudspeaker"}, "explanation": "Voice-driven software agents are termed Virtual Assistants."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 72, "chapter": null, "section": null, "reference": "10th Tamil, Unit 4, Page 72", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["செயற்கை நுண்ணறிவு", "மெய்நிகர் உதவியாளர்", "Virtual Assistant"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u4-q003", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "seyarkai_nunnarivu", "chapter_id": null, "topic_id": "ibm_watson", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "2016-ஆம் ஆண்டில் சில நிமிடங்களில் இரண்டு கோடி மருத்துவ ஏடுகளை அலசி ஆய்வு செய்து ஒரு பெண்ணின் அரிய புற்றுநோயைக் கண்டறிந்த கணினி எது?", "media_id": null}], "options": {"A": "சூப்பர் கம்ப்யூட்டர் பரம்", "B": "ஆப்பிள் மேக்", "C": "ஐபிஎம் நிறுவனத்தின் \"வாட்சன்\" (Watson)", "D": "டீப் ப்ளூ"}, "explanation": "2016-இல் ஐபிஎம் நிறுவனத்தின் செயற்கை நுண்ணறிவுக் கணினியான \"வாட்சன்\", சில நிமிடங்களில் 2 கோடி மருத்துவ ஆய்வு ஏடுகளை ஆராய்ந்து புற்றுநோயைத் துல்லியமாகக் கண்டறிந்தது."}, "en": {"blocks": [{"type": "text", "content": "Which AI supercomputer analyzed 20 million medical records in mere minutes in 2016 to accurately diagnose a rare leukemia?", "media_id": null}], "options": {"A": "PARAM Supercomputer", "B": "Apple Mac", "C": "IBM Watson", "D": "Deep Blue"}, "explanation": "IBM Watson combed through 20 million medical studies in minutes to diagnose a rare cancer."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "pag