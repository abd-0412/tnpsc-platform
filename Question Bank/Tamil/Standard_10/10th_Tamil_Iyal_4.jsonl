10", "term": "full_year", "edition": "2024-2025", "page": 85, "chapter": null, "section": null, "reference": "10th Tamil, Unit 4, Page 85", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["இலக்கணம்", "இட வழு", "சான்று"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u4-q145", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "valukkal_valuvamaithi", "chapter_id": null, "topic_id": "kaala_vina_marabu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"நேற்று வருவான்\" என்பது கால வழு; \"தென்னை மரங்கள் உள்ள தோட்டத்தைத் தென்னந்தோட்டம்\" என்று கூறாமல் \"தென்னந்தோப்பு\" என்பது எவ்வகை அமைதி/நெறி?", "media_id": null}], "options": {"A": "வழாநிலை (மரபு வழாநிலை)", "B": "மரபு வழு", "C": "இட வழுவமைதி", "D": "திணை வழு"}, "explanation": "இலக்கண முறையுடன் குற்றமின்றிப் பேசுவதும் எழுதுவதும் வழாநிலை எனப்படும். தென்னை மரங்கள் நிறைந்த நிலத்தைத் தென்னந்தோப்பு என மரபுப்படி கூறுவது \"மரபு வழாநிலை\" ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Saying \"Thennanthoppu\" for coconut orchard instead of grammatically incorrect terms is an example of what in Tamil grammar?", "media_id": null}], "options": {"A": "Vazhanilai (Marabu Vazhanilai - standard grammatical form)", "B": "Marabu Vazhu", "C": "Idam Valuvamaithi", "D": "Thinai Vazhu"}, "explanation": "Using correct conventional idioms without error is termed Vazhanilai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "20