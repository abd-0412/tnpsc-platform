{"id": "10th-u4-q118", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "vinnaith_thaandiya_thannambikkai", "chapter_id": null, "topic_id": "paralympics_2012", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "2012-ஆம் ஆண்டில் நடைபெற்ற எந்த உலக விளையாட்டுப் போட்டியின் தொடக்க விழாவில் ஸ்டீபன் ஹாக்கிங் முதன்மை விருந்தினராகப் பங்கேற்றார்?", "media_id": null}], "options": {"A": "ஆசிய விளையாட்டுப் போட்டிகள்", "B": "இலண்டன் பாராலிம்பிக்ஸ் மாற்றுத்திறனாளிகள் விளையாட்டுப் போட்டி", "C": "காமன்வெல்த் போட்டிகள்", "D": "விண்டர் ஒலிம்பிக்ஸ்"}, "explanation": "2012 இலண்டன் மாற்றுத்திறனாளிகளுக்கான பாராலிம்பிக்ஸ் விளையாட்டுப் போட்டியின் தொடக்க விழாவில் ஹாக்கிங் பங்கேற்றுப் பேருரையாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "At the grand opening ceremony of which premier world sporting event in 2012 was Stephen Hawking the guest of honor?", "media_id": null}], "options": {"A": "Asian Games", "B": "London Paralympic Games", "C": "Commonwealth Games", "D": "Winter Olympics"}, "explanation": "He addressed the world at the opening ceremony of the London 2012 Paralympic Games."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year",