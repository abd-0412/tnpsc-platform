{"id": "10th-u4-q077", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "perumal_thirumozhi", "chapter_id": null, "topic_id": "medical_surgery", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குலசேகர ஆழ்வாரின் இப்பாசுரத்தின் மூலம் சங்க மற்றும் இடைக்காலத் தமிழகத்தில் எத்துறை மிகச் சிறப்பாக வளர்ந்திருந்தது புலனாகிறது?", "media_id": null}], "options": {"A": "அறுவை சிகிச்சை முறை உள்ளிட்ட மருத்துவத்துறை (Surgery)", "B": "விமானத்துறை", "C": "கப்பல் போக்குவரத்து மட்டும்", "D": "அச்சுத் தொழில்"}, "explanation": "\"வாளால் அறுத்துச் சுடினும்\" என்ற வரிகள் பழங்காலத்திலேயே புண்களை அறுவை சிகிச்சை செய்து, தீயினால் சுட்டுச் சிகிச்சை அளிக்கும் அறுவை மருத்துவம் (Surgery) தமிழகத்தில் நிலவியதை உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which sophisticated field of ancient knowledge is evidenced by the verse \"Vaalaal aruthus sudinum\"?", "media_id": null}], "options": {"A": "Advanced Surgical Medicine and Cauterization procedures (Aruvai Maruthuvam)", "B": "Aviation", "C": "Naval warfare only", "D": "Print technology"}, "explanation": "It proves ancient Tamil culture practiced surgical incision and wound cauterization."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 78, "chapter": null, "section": null, "reference": "10th Tamil, Unit 4, Page 78", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["பெருமாள் திருமொழி", "அறுவை மருத்துவம்", "அறிவியல் சான்று"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
