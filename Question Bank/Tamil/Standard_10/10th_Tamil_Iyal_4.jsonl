{"id": "10th-u4-q051", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "seyarkai_nunnarivu", "chapter_id": null, "topic_id": "human_centered_ai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"மனித மைய செயற்கை நுண்ணறிவு\" (Human-Centered AI) என்பதன் நோக்கம் என்ன?", "media_id": null}], "options": {"A": "மனிதர்களைத் தூக்கி எறிவது", "B": "இயந்திரங்களுக்கு முதலிடம் தருவது", "C": "மனிதர்களின் நலன், பாதுகாப்பு, மாண்பு ஆகியவற்றை முதன்மையாகக் கொண்டு AI கருவிகளை வடிவமைப்பது", "D": "மனிதர்களை விட இயந்திரங்களை நேசிப்பது"}, "explanation": "மனித உரிமைகளையும் மாண்புகளையும் முன்னிறுத்தி, மனிதகுலத்தின் முன்னேற்றத்திற்கு உகந்ததாக AI கட்டமைக்கப்பட வேண்டும் என்பதே மனித மைய AI ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the guiding ethos of Human-Centered Artificial Intelligence (HAI)?", "media_id": null}], "options": {"A": "Discarding humanity", "B": "Prioritizing algorithms above mortals", "C": "Architecting AI tools purposefully to safeguard human dignity, security, equity, and collective well-being", "D": "Valuing machines over human lives"}, "explanation": "Human-Centered AI ensures that machine systems advance human flourishing and protect civil liberties."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publish