{"id": "10th-u4-q097", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "paripaadal", "chapter_id": null, "topic_id": "evolution_order", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பரிபாடல் கூறும் பிரபஞ்சப் பரிணாம வளர்ச்சியின் சரியான வரிசை எது?", "media_id": null}], "options": {"A": "வானத்தில் பேரொலி (விசும்பு) -> காற்று (வளி) -> தீ (செந்தீ) -> மழை/வெள்ளம் (தண்பெயல்) -> நிலம் (இருநிலம்)", "B": "நிலம் -> நீர் -> காற்று -> தீ -> வானம்", "C": "தீ -> நிலம் -> காற்று -> நீர் -> வானம்", "D": "காற்று -> தீ -> நிலம் -> நீர் -> வானம்"}, "explanation": "பரிபாடல் ஐம்பூதங்களின் பரிணாம வரிசையை: வானத்தில் வித்து (ஒலி) -> காற்று -> தீப்பிழம்பு -> தொடர் பெருமழை வெள்ளம் -> நிலம் என அறிவியல் பூர்வமாக அடுக்கிக் கூறுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the cosmological evolutionary chronology outlined in Keeranthaiyar’s Paripaadal?", "media_id": null}], "options": {"A": "Cosmic Primordial Sound in Space (Visumbu) -> Wind/Atmosphere (Vali) -> Fire/Flames (Thee) -> Torrential deluge (Mazhai/Neer) -> Solid terrestrial Earth (Nilam)", "B": "Earth -> Water -> Wind -> Fire -> Space", "C": "Fire -> Earth -> Wind -> Water -> Space", "D": "Wind -> Fire -> Earth -> Water -> Space"}, "explanation": "The verse accurately anticipates physical cosmology: Space -> Gas -> Fire/Stars -> Hydro-cooling -> Earth."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 79, "chapter": null, "section": null, "reference": "10th Tamil, Unit 4, Page 79", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["பரிபாடல்", "பரிணாம வரிசை", "ஐம்பூதங்கள்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u4-q098", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "paripaadal", "chapter_id": null, "topic_id": "cosmic_sound", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"கருவளர் வானத்து இசையில் தோன்றி\" - இதில் \"இசையில்\" என்பது எதனைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "பாட்டு", "B": "பேரொலி (பெருவெடிப்பின் போது தோன்றிய முதல் ஒலி அதிர்வு)", "C": "மௌனம்", "D": "காற்று"}, "explanation": "அண்டத் தோற்றத்தின் போது உருவமற்ற பெருவெளியில் பிரபஞ்ச வித்து உருவாவதற்கு வித்திட்ட பேரொலியையே (Sound vibration) \"இசை\" எனக் கீரந்தையார் குறிப்பிடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What does \"Isaiyil\" signify in the phrase \"Karuvalar vaanathu isaiyil thonri\"?", "media_id": null}], "options": {"A": "Vocal song", "B": "Cosmic acoustic resonance / Primordial sound of the Big Bang", "C": "Absolute silence", "D": "Wind breeze"}, "explanation": "It refers to the primordial acoustic energy wave that echoed during the cosmic Big Bang."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 79, "chapter": null, "section": null, "reference": "10th Tamil, Unit 4, Page 79", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["பரிபாடல்", "இசை", "பேரொலி"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
