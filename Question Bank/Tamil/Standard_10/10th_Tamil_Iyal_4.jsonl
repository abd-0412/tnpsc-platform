{"id": "10th-u4-q084", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "perumal_thirumozhi", "chapter_id": null, "topic_id": "summary_core", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெருமாள் திருமொழிப் பாடலின் மையக்கருத்து யாது?", "media_id": null}], "options": {"A": "நோய்கள் தீர்க்க முடியாதவை", "B": "மருத்துவர்களை வெறுக்க வேண்டும்", "C": "மன்னனாக இருப்பதே பெருமை", "D": "துன்பங்கள் எத்துணை வந்தாலும் இறைவனின் பேரருளை மட்டுமே நம்பி சரணடைவதே ஆன்ம ஈடேற்றத்திற்குரிய வழி"}, "explanation": "மருத்துவனின் சிகிச்சை போல இறைவன் தரும் சோதனைகளும் நம்மைப் பக்குவப்படுத்தவே என்பதை உணர்ந்து, அவனருளையே நாடி நிற்றலே முக்திக்கு வழி என்பது இப்பாசுரத்தின் முடிந்த முடிவாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the ultimate spiritual thesis of this Perumal Thirumozhi pasuram?", "media_id": null}], "options": {"A": "Diseases are incurable", "B": "Physicians should be spurned", "C": "Secular kingship is supreme", "D": "Recognizing trials as soul-refining surgery and taking absolute sanctuary in Divine Grace as the path to salvation"}, "explanation": "Viewing worldly afflictions as divine therapeutic surgery and remaining steadfast in total surrender is the core thesis."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "p