{"id": "10th-u4-q021", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_4", "lesson_id": "seyarkai_nunnarivu", "chapter_id": null, "topic_id": "ai_arts", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "செயற்கை நுண்ணறிவு தற்போது கலை மற்றும் இலக்கியத்தில் ஆற்றும் பணிகளுள் சரியானது எது?", "media_id": null}], "options": {"A": "ஓவியம் வரைதல், இசை அமைத்தல், கவிதை எழுதுதல் போன்ற படைப்பாக்கப் பணிகளை மேற்கொள்ளுதல்", "B": "கலைகளை அழிக்கிறது", "C": "எந்தக் கலைக்கும் பயன்படுவதில்லை", "D": "மனிதர்களை விடக் குறைவாகவே வேலை செய்கிறது"}, "explanation": "செயற்கை நுண்ணறிவு புதிய மெட்டுகளை உருவாக்குதல், வாட்டர் கலர் ஓவியங்கள் தீட்டுதல், கவிதைகள் புனைதல் ஆகியவற்றிலும் வியக்க வைக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "How has Generative AI made inroads into creative arts and literature?", "media_id": null}], "options": {"A": "By composing musical scores, rendering paintings, and synthesizing poetry", "B": "By abolishing all arts", "C": "Zero artistic capability", "D": "By degrading all creative works"}, "explanation": "Generative AI composes intricate music, creates digital canvas art, and drafts poetry."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term