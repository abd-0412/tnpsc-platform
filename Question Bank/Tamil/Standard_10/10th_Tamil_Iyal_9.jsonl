{"id": "10th-u9-q168", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "unit9_overall", "chapter_id": null, "topic_id": "final_curriculum_mastery", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "10-ஆம் வகுப்புத் தமிழ் பாடநூலின் 9 இயல்களும் மாணவர்களிடையே எத்தகைய ஆளுமைப் பண்பை உருவாக்க வடிவமைக்கப்பட்டுள்ளன?", "media_id": null}], "options": {"A": "தேர்வில் மதிப்பெண் பெறுவது மட்டுமே", "B": "பழைய கதைகளை மனப்பாடம் செய்வது மட்டுமே", "C": "வெளிநாட்டு மொழிகளை வெறுப்பது", "D": "மொழித்திறன், இலக்கிய நயம், வரலாற்று விழிப்புணர்வு, சமூக நீதி மற்றும் உயர் அறநெறிகளுடன் கூடிய முழுமையான ஆளுமை வளர்ச்சி"}, "explanation": "பாடநூல் பாடத்திட்ட நோக்கம்: மொழி ஆளுமையோடு, தமிழ்ப் பண்பாட்டின் விழுமியங்களையும், சமூகச் சமத்துவத்தையும், மனிதநேய அறங்களையும் கொண்டு முழுமையான மனிதனாக வாழ வழிகாட்டுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What holistic educational ideal is cultivated across all 9 Units of Standard 10 Tamil?", "media_id": null}], "options": {"A": "Rote memorization for marks only", "B": "Reciting antique tales", "C": "Hating foreign tongues", "D": "Comprehensive holistic personality development integrating linguistic mastery, literary aesthetics, historical awareness, social justice, and humanitarian ethics"}, "explanation": "Nurturing holistic personality enriched with literary acumen, historical awareness, and humanitarian ethics."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 212, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 212", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["10-ஆம் வகுப்புத் தமிழ்", "முழுமைப் பார்வை", "பாடத்திட்ட நோக்கம்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
