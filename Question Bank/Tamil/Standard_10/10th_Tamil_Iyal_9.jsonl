{"id": "10th-u9-q091", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "kuppusamy_compassion_crow", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தன் பசி, மரண வேதனைக்கு மத்தியிலும் குப்புசாமி தன் குடிசை வாசலுக்கு வரும் எந்த உயிரினத்திற்குத் தினமும் உணவளித்தான்?", "media_id": null}], "options": {"A": "தெரு நாய்", "B": "பூனைக்குட்டி", "C": "காகம் (காக்கை)", "D": "அணில்"}, "explanation": "பாடநூல் விளக்கம்: தனக்குக் கிடைக்கும் சொற்பக் கஞ்சியிலும் ஒரு சிறு உருண்டையைத் தினமும் தவறாமல் வாசலில் வந்து கரையும் காகத்திற்குப் படைத்து மகிழ்கிறான் குப்புசாமி."}, "en": {"blocks": [{"type": "text", "content": "Despite his dire poverty and pain, to which creature did Kuppusamy faithfully share food every day?", "media_id": null}], "options": {"A": "Stray dog", "B": "Kitten", "C": "A crow (Kaakkai)", "D": "Squirrel"}, "explanation": "He faithfully shared his modest rice ball with a visiting crow."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 206, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 206", "url": null, "source_not