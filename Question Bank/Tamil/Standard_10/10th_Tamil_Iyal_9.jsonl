{"id": "10th-u9-q095", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "literary_friendship_ki_ra", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கு. அழகிரிசாமியின் ஆருயிர் நண்பராகவும், இலக்கியத் தோழராகவும் விளங்கிய கரிசல் எழுத்தாளர் யார்?", "media_id": null}], "options": {"A": "மேலாண்மை பொன்னுச்சாமி", "B": "பூமணி", "C": "கி. ராஜநாராயணன் (கி.ரா.)", "D": "சோ தர்மன்"}, "explanation": "பாடநூல் குறிப்பு: இடைசெவல் கிராமத்து இரட்டையர்களாக விளங்கியவர்கள் கு. அழகிரிசாமியும் கி. ராஜநாராயணனும் ஆவர். அழகிரிசாமியின் கடிதங்களை கி.ரா தொகுத்து வெளியிட்டுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which celebrated Karisal author shared a lifelong brotherhood and literary camaraderie with Ku. Alagirisamy?", "media_id": null}], "options": {"A": "Melanmai Ponnusamy", "B": "Poomani", "C": "Ki. Rajanarayanan (Ki. Ra.)", "D": "Cho. Dharman"}, "explanation": "Ki. Rajanarayanan was his close companion and literary brother."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 207, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 207", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["கு. அழகிரிசாமி", "கி. ராஜநாராயணன்", "இலக்கியத் தோழமை"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u9-q096", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "letters_collection", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கு. அழகிரிசாமி கி. ராஜநாராயணனுக்கு எழுதிய அரிய கடிதங்களைத் தொகுத்து வெளியிடப்பட்ட நூலின் பெயர் யாது?", "media_id": null}], "options": {"A": "தோழருக்குக் கடிதங்கள்", "B": "இடைசெவல் கடிதங்கள்", "C": "கரிசல்க் கடிதங்கள்", "D": "கு. அழகிரிசாமி கடிதங்கள்"}, "explanation": "பாடநூல் குறிப்பு: தமிழ் இலக்கியக் கடித இலக்கியத்தில் மிகச் சிறந்த ஆவணமாக \"கு. அழகிரிசாமி கடிதங்கள்\" போற்றப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the title of the compilation containing Ku. Alagirisamy's insightful literary letters to Ki. Rajanarayanan?", "media_id": null}], "options": {"A": "Thozharukku Kadithangal", "B": "Idaiseval Kadithangal", "C": "Karisal Kadithangal", "D": "Ku. Alagirisamy Kadithangal"}, "explanation": "Ku. Alagirisamy Kadithangal is a classic in Tamil epistolary literature."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 207, "chapter": null, "section": null, "reference": "10th