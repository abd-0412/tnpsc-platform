{"id": "10th-u9-q027", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "jayakanthan", "chapter_id": null, "topic_id": "matching_jayakanthan_awards", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பொருத்துக:\nஅ) சில நேரங்களில் சில மனிதர்கள் - 1. சோவியத் நேரு விருது\nஆ) இமயத்துக்கு அப்பால் - 2. தாமரைத்திரு (2009)\nஇ) ஞானபீட விருது - 3. சாகித்திய அகாதெமி (1972)\nஈ) பத்மபூஷண் - 4. இந்திய உயரிய இலக்கிய விருது (2002)", "media_id": null}], "options": {"A": "அ-1, ஆ-2, இ-3, ஈ-4", "B": "அ-2, ஆ-3, இ-4, ஈ-1", "C": "அ-3, ஆ-1, இ-4, ஈ-2", "D": "அ-4, ஆ-1, இ-2, ஈ-3"}, "explanation": "சரியான பொருத்தம்: சில நேரங்களில் சில மனிதர்கள் - சாகித்திய அகாதெமி (1972); இமயத்துக்கு அப்பால் - சோவியத் நேரு விருது; ஞானபீட விருது - 2002; பத்மபூஷண் - 2009."}, "en": {"blocks": [{"type": "text", "content": "Match: a) Sila Nerangalil Sila Manithargal - 1. Soviet Nehru award b) Imayatthukku Appaal - 2. Padma Bhushan c) Jnanpith - 3. Sahitya Akademi d) Padma Bhushan - 4. Highest Indian literary award.", "media_id": null}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-2, b-3, c-4, d-1", "C": "a-3, b-1, c-4, d-2", "D": "a-4, b-1, c-2, d-3"}, "explanation": "Correct match is a-3, b-1, c-4, d-2."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil