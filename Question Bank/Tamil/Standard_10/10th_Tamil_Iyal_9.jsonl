{"id": "10th-u9-q012", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "jayakanthan", "chapter_id": null, "topic_id": "mentor_communist_party", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜெயகாந்தனைத் தம் இளமைக் காலத்தில் அரவணைத்து அரசியல் மற்றும் பொதுவுடைமைச் சிந்தனைகளை ஊட்டிய தலைவர் யார்?", "media_id": null}], "options": {"A": "பாரதியார்", "B": "காமராசர்", "C": "அண்ணா", "D": "ஜீவானந்தம் (ப. ஜீவானந்தம்)"}, "explanation": "பாடநூல் குறிப்பு: ஜெயகாந்தன் சென்னை வந்ததும் அவரைத் தன் தோழனாக ஏற்று வழிகாட்டிய பெருந்தலைவர் தோழர் ஜீவானந்தம் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Which visionary communist leader mentored young Jayakanthan in Chennai?", "media_id": null}], "options": {"A": "Bharathiyar", "B": "Kamarajar", "C": "Anna", "D": "Jeevanandham (Pa. Jeevanandham)"}, "explanation": "Comrade Jeevanandham nurtured Jayakanthan's socio-political consciousness."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 198, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 198", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "e