{"id": "10th-u9-q029", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "siddhaalu", "chapter_id": null, "topic_id": "author_name", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "10-ஆம் வகுப்பு இயல் 9 கவிதைப் பேழையில் இடம்பெற்றுள்ள \"சித்தாளு\" என்னும் புதுக்கவிதையின் ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "நாகூர் ரூமி", "B": "கவிக்கோ அப்துல் ரகுமான்", "C": "இன்குலாப்", "D": "மு. மேத்தா"}, "explanation": "பாடநூல் குறிப்பு: இயல் 9 கவிதைப் பேழையில் விளிம்புநிலை உழைப்பாளிப் பெண்ணின் துயரத்தை உணர்த்தும் \"சித்தாளு\" கவிதையை இயற்றியவர் நாகூர் ரூமி ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who is the author of the poignant modern poem \"Siddhaalu\" in Standard 10 Unit 9?", "media_id": null}], "options": {"A": "Nagoor Rumi", "B": "Kavikko Abdul Rahman", "C": "Inquilab", "D": "Mu. Metha"}, "explanation": "Nagoor Rumi authored the evocative poem Siddhaalu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 202, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 202", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false,