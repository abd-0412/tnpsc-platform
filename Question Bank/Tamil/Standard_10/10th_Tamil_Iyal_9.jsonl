{"id": "10th-u9-q084", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "thembavani", "chapter_id": null, "topic_id": "epic_literary_significance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தேம்பாவணி தமிழ் இலக்கிய உலகிற்கு வழங்கிய ஆகச்சிறந்த கொடை எது?", "media_id": null}], "options": {"A": "மேலைநாட்டுக் கதைகளை மட்டுமே கூறியது", "B": "லத்தீன் சொற்களைத் தமிழில் புகுத்தியது", "C": "பழைய இலக்கியங்களை எதிர்த்தது", "D": "கிறித்தவக் கொள்கைகளைத் தூய சங்கத் தமிழின் செழுமையான மரபிலும் சந்த நயத்திலும் காவியமாக்கிய பெருமை"}, "explanation": "பாடநூல் ஆய்வு: பைபிள் நிகழ்வுகளைத் தமிழ்ப் பண்பாட்டிற்கும் செவ்வியல் கவிதை மரபிற்கும் ஏற்ப விருத்தப் பாக்களில் அமைத்துக் காப்பியமாக உயர்த்திய மகத்தான சாதனை."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the supreme literary legacy of Thembavani in Tamil literature?", "media_id": null}], "options": {"A": "Recounting Western tales only", "B": "Injecting Latin vocabulary", "C": "Rejecting ancient traditions", "D": "Enshrining Christian theology seamlessly into classical Tamil poetic idiom and grand Sangam aesthetics"}, "explanation": "Synthesizing biblical themes with classical Tamil poetic aesthetics and epic traditions."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publis