{"id": "10th-u9-q097", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "other_magazines_worked", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கு. அழகிரிசாமி தமிழ்நாட்டில் பணியாற்றிய இதழ்களுள் சரியான ஒன்று எது?", "media_id": null}], "options": {"A": "சக்தி மற்றும் பிரசண்ட விகடன்", "B": "குயில்", "C": "இந்தியா", "D": "ஞானரதம்"}, "explanation": "பாடநூல் குறிப்பு: இவர் \"சக்தி\", \"பிரசண்ட விகடன்\" ஆகிய புகழ்பெற்ற தமிழக இதழ்களில் துணையாசிரியராகப் பணியாற்றியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "In which Tamil literary periodicals did Ku. Alagirisamy work as an editor/assistant editor?", "media_id": null}], "options": {"A": "Sakthi and Prasanda Vikatan", "B": "Kuyil", "C": "India", "D": "Gnanaratham"}, "explanation": "He served on the editorial desks of Sakthi and Prasanda Vikatan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 207, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 207", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name