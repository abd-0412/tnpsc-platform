{"id": "10th-u9-q086", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "karisal_pioneer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கி. ராஜநாராயணனுக்கு முன்பே கரிசல் இலக்கியக் களத்தைத் தொடங்கி வைத்த மூத்த எழுத்தாளர் யார்?", "media_id": null}], "options": {"A": "புதுமைப்பித்தன்", "B": "கு. அழகிரிசாமி", "C": "சுந்தர ராமசாமி", "D": "ஜெயகாந்தன்"}, "explanation": "பாடநூல் குறிப்பு: கரிசல் இலக்கியத்தின் முன்னோடியாகத் திகழ்ந்தவர் கு. அழகிரிசாமி. கி. ராஜநாராயணன் இவரைத் தனது வழிகாட்டியாகக் குறிப்பிடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Who was the pioneer of Karisal (black soil) regional fiction preceding Ki. Rajanarayanan?", "media_id": null}], "options": {"A": "Pudhumaipithan", "B": "Ku. Alagirisamy", "C": "Sundara Ramasamy", "D": "Jayakanthan"}, "explanation": "Ku. Alagirisamy pioneered Karisal regional literature."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 207, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 207", "url": null, "source_notes": null}, "previous_year": {"is_previous_yea