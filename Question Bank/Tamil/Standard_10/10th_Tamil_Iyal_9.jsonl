{"id": "10th-u9-q089", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "central_character_kuppusamy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"ஒருவன் இருக்கிறான்\" சிறுகதையின் மையக் கதாபாத்திரமான நோயாளி யார்?", "media_id": null}], "options": {"A": "குப்புசாமி", "B": "வீரராகவன்", "C": "கந்தசாமி", "D": "ஆறுமுகம்"}, "explanation": "பாடநூல் குறிப்பு: வறுமையிலும் கடும் நோயிலும் வாடித் தன் குடிசையில் படுத்த படுக்கையாகக் கிடக்கும் எளிய மனிதன் குப்புசாமி ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who is the ailing impoverished protagonist at the heart of the short story \"Oruvan Irukkiran\"?", "media_id": null}], "options": {"A": "Kuppusamy", "B": "Veeraraghavan", "C": "Kanthasamy", "D": "Aarumugam"}, "explanation": "Kuppusamy is the central character struggling with illness."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 206, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 206", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "y