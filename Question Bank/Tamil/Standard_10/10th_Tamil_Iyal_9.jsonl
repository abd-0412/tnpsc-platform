{"id": "10th-u9-q132", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "anigal", "chapter_id": null, "topic_id": "jaathi_thanmai_example", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தன்மை அணியின் 4 வகைகளில் ஒரு குறிப்பிட்ட குலம் அல்லது இனத்தின் இயல்பை உள்ளவாறே விளக்குவது எந்த வகை?", "media_id": null}], "options": {"A": "பொருள் தன்மை அணி", "B": "குணத்தன்மை அணி", "C": "தொழிற்றன்மை அணி", "D": "சாதித்தன்மை அணி"}, "explanation": "பாடநூல் குறிப்பு: ஒரு குறிப்பிட்ட இனப் பிரிவினரின் இயல்பான மரபுத் தன்மைகளை உள்ளவாறே கூறுவது சாதித்தன்மை அணி ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which variety of Thanmai Ani captures the distinctive traits of a species or group faithfully?", "media_id": null}], "options": {"A": "Porul thanmai", "B": "Guna thanmai", "C": "Thozhir thanmai", "D": "Jaathi thanmai Ani"}, "explanation": "Jaathi thanmai Ani portrays species-specific natural characteristics."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 209, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 209", "url": null, "source_notes": null}, "previous_year": {"is_p