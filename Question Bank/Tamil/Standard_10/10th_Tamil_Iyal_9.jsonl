{"id": "10th-u9-q088", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "sahitya_akademi_posthumous", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கு. அழகிரிசாமி மறைந்த பின்னர் அவரது எந்தச் சிறுகதைத் தொகுப்பிற்கு 1970-ஆம் ஆண்டு சாகித்திய அகாதெமி விருது வழங்கப்பட்டது?", "media_id": null}], "options": {"A": "அழகிரிசாமி கதைகள்", "B": "தீராக்காதல்", "C": "தெய்வம் பிறந்தது", "D": "அன்பளிப்பு"}, "explanation": "பாடநூல் குறிப்பு: கு. அழகிரிசாமியின் \"அன்பளிப்பு\" என்னும் சிறுகதைத் தொகுப்பிற்கு 1970-இல் மறைவுக்குப் பின் சாகித்திய அகாதெமி விருது வழங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "For which short story collection was Ku. Alagirisamy posthumously honored with the Sahitya Akademi Award in 1970?", "media_id": null}], "options": {"A": "Alagirisamy Kadhaigal", "B": "Theeraakkadhal", "C": "Deivam Piranthadhu", "D": "Anbalippu"}, "explanation": "Anbalippu won the Sahitya Akademi Award posthumously in 1970."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 207, "chapter": null, "section": null, "reference": "10th Tamil, Un