{"id": "10th-u9-q043", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "siddhaalu", "chapter_id": null, "topic_id": "symbolism_bricks_mortar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிதையில் வரும் \"செங்கல்லும் சாந்தும்\" எதன் குறியீடுகளாகக் காட்டப்பட்டுள்ளன?", "media_id": null}], "options": {"A": "செல்வத்தின் அடையாளம்", "B": "அழகியல் பொருள்கள்", "C": "சுமக்கப்படும் வாழ்க்கைப் பெருஞ்சுமை மற்றும் உழைப்பு", "D": "விளையாட்டுப் பொருள்கள்"}, "explanation": "பாடநூல் விளக்கம்: வாழ்வின் சுமைகளைத் தன் தலையிலும் மனதிலும் தாங்கிக் கொண்டு நிற்கும் உழைப்பின் குறியீடாகச் செங்கற்களும் காரைச்சாந்தும் அமைகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What do the \"bricks and mortar\" symbolize in the poem?", "media_id": null}], "options": {"A": "Symbols of wealth", "B": "Aesthetic decor", "C": "Heavy daily burdens and ceaseless manual labor", "D": "Playthings"}, "explanation": "They represent the unyielding weight of physical and economic burden."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 202, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 202", "ur