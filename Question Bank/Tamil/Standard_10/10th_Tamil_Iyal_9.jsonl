{"id": "10th-u9-q059", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "thembavani", "chapter_id": null, "topic_id": "hero_valan_joseph", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தேம்பாவணி காப்பியத்தின் பாட்டுடைத் தலைவன் யார்?", "media_id": null}], "options": {"A": "இயேசு கிறிஸ்து", "B": "திருமுழுக்கு யோவான் (கருணையன்)", "C": "வளன் என்னும் சூசையப்பர் (இயேசுவின் வளர்ப்புத் தந்தை யோசேப்பு)", "D": "தூய பேதுரு"}, "explanation": "பாடநூல் குறிப்பு: கிறித்துவின் வளர்ப்புத் தந்தையாகிய யோசேப்பு என்னும் சூசையப்பரே தேம்பாவணியின் தலைவன் ஆவார். இவருக்குத் தமிழில் \"வளன்\" என்று பெயரிட்டுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who is the central epic protagonist (Pattudaithalaivan) of Thembavani?", "media_id": null}], "options": {"A": "Jesus Christ", "B": "John the Baptist (Karunaiyan)", "C": "Valan / Saint Joseph (Foster father of Jesus)", "D": "Saint Peter"}, "explanation": "Saint Joseph, lovingly named Valan in Tamil, is the protagonist."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 205, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 205", "u