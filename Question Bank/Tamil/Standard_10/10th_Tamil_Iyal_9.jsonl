{"id": "10th-u9-q131", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "anigal", "chapter_id": null, "topic_id": "antonym_of_thanmai_navirsi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தன்மை நவிற்சி அணிக்கு (உள்ளதை உள்ளவாறே கூறுதல்) நேர் எதிரான அணி எது?", "media_id": null}], "options": {"A": "வேற்றுமை அணி", "B": "சொல் பின்வருநிலையணி", "C": "உயர்வு நவிற்சி அணி (மிகைப் படுத்திக் கூறுதல்)", "D": "தீவக அணி"}, "explanation": "இலக்கண ஒப்பீடு: உள்ளதை உள்ளவாறே கூறுவது தன்மை நவிற்சி; உள்ளதை மிகைப்படுத்திக் கூறுவது உயர்வு நவிற்சி அணி."}, "en": {"blocks": [{"type": "text", "content": "Which poetic device represents the diametrical opposite of Thanmai Navirsi Ani?", "media_id": null}], "options": {"A": "Vettrukkai Ani", "B": "Sol Pinvarunilai Ani", "C": "Uyarvu Navirsi Ani (Hyperbole)", "D": "Theevaga Ani"}, "explanation": "Uyarvu Navirsi Ani (Hyperbole) is the exact opposite of Thanmai Navirsi (Realism)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 209, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 209", "url": null, "source_notes": null}, "previous_year": {"