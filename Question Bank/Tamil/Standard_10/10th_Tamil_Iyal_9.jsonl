{"id": "10th-u9-q028", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "jayakanthan", "chapter_id": null, "topic_id": "legacy_rebel_writer", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் இலக்கியத்தில் மரபுகளையும் போலித்தனங்களையும் எதிர்த்து கம்பீரக் குரல் கொடுத்ததால் ஜெயகாந்தன் எவ்வாறு அழைக்கப்பட்டார்?", "media_id": null}], "options": {"A": "மென்மைக் கவிஞர்", "B": "கற்பனை உலக நாயகன்", "C": "மௌன முனிவர்", "D": "இலக்கியத் தளபதி / புரட்சி எழுத்தாளர் (திமிறி நின்ற இலக்கியவாதி)"}, "explanation": "பாடநூல் செய்தி: தமிழ் இலக்கியத்தில் எதற்கும் தலைவணங்காத சுயமரியாதையும் கம்பீரமும் கொண்ட படைப்பாளியாக ஜெயகாந்தன் விளங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "How was Jayakanthan hailed for his fierce rebellion against hypocrisy and societal stereotypes?", "media_id": null}], "options": {"A": "Gentle poet", "B": "Hero of fantasy", "C": "Silent ascetic", "D": "Literary Commander / Fearless rebel intellectual"}, "explanation": "Fearless vanguard intellectual who refused to compromise his principles."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 198, "chapter": null, "secti