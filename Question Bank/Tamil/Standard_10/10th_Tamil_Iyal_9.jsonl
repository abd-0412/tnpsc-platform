{"id": "10th-u9-q020", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "jayakanthan", "chapter_id": null, "topic_id": "translations_russian_french", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஜெயகாந்தனின் படைப்புகள் எந்தெந்த உலக மொழிகளில் மொழிபெயர்க்கப்பட்டுப் பெருமை பெற்றுள்ளன?", "media_id": null}], "options": {"A": "சீன மற்றும் ஜப்பானிய மொழிகளில் மட்டும்", "B": "அரபு மொழியில் மட்டும்", "C": "கிரேக்க மொழியில் மட்டும்", "D": "ஆங்கிலம், இந்தி, ஜெர்மன், பிரெஞ்சு, உருசிய உள்ளிட்ட பல மொழிகளில்"}, "explanation": "பாடநூல் குறிப்பு: ஜெயகாந்தனின் சிறுகதைகளும் நாவல்களும் ஆங்கிலம் மட்டுமன்றி உருசியம், உக்ரைனியன், பிரெஞ்சு, ஜெர்மன் உள்ளிட்ட உலக மொழிகளிலும் மொழிபெயர்க்கப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Into which world languages have Jayakanthan's literary masterpieces been translated?", "media_id": null}], "options": {"A": "Chinese and Japanese only", "B": "Arabic only", "C": "Greek only", "D": "English, Hindi, German, French, and Russian among others"}, "explanation": "Translated into multiple Indian and world languages including Russian and French."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_y