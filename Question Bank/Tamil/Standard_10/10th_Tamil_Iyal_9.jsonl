{"id": "10th-u9-q111", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "storytelling_simplicity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கு. அழகிரிசாமியின் சிறுகதை நடையின் தனிச்சிறப்பாகக் கருதப்படுவது எது?", "media_id": null}], "options": {"A": "அடுக்குமொழி அலங்காரங்கள்", "B": "புதிரான தத்துவக் குழப்பங்கள்", "C": "ஆடம்பரமற்ற எளிய நடை, உயிரோட்டமான உரையாடல்கள் மற்றும் மெல்லிய புன்னகையோடு கூடிய சோகம்", "D": "கற்பனை உலக வருணனைகள்"}, "explanation": "பாடநூல் விளக்கம்: செயற்கையான எந்த அலங்காரமும் இன்றி, அன்றாட வாழ்க்கையின் எளிய மொழியில் ஆழ்ந்த உண்மைகளை வெளிப்படுத்துவதே அழகிரிசாமியின் கதை நடை."}, "en": {"blocks": [{"type": "text", "content": "What is considered the signature hallmark of Ku. Alagirisamy's narrative prose?", "media_id": null}], "options": {"A": "Flowery alliterative rhetoric", "B": "Cryptic philosophical enigmas", "C": "Unadorned simplicity, lifelike dialogues, and gentle sorrow intertwined with subtle warmth", "D": "Fantasy dreamscapes"}, "explanation": "Unadorned simplicity and lifelike authentic empathy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_ye