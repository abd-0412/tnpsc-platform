{"id": "10th-u9-q044", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "siddhaalu", "chapter_id": null, "topic_id": "statement_analysis", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் நாகூர் ரூமி பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. இவரது இயற்பெயர் முகமது ரஃபி.\n2. இவர் தஞ்சை மாவட்டத்தில் பிறந்தவர்.\n3. நதியின் கால்கள், ஏழாவது சுவை ஆகியவை இவரது கவிதைத் தொகுதிகள்.\nஇவற்றுள் சரியானவை எவை?", "media_id": null}], "options": {"A": "1, 2 மட்டும்", "B": "2, 3 மட்டும்", "C": "1, 3 மட்டும்", "D": "1, 2, 3 ஆகிய அனைத்தும் சரி"}, "explanation": "பாடநூல் ஆய்வு: முகமது ரஃபி என்பது இயற்பெயர், தஞ்சை மாவட்டம், நதியின் கால்கள் மற்றும் ஏழாவது சுவை கவிதைத் தொகுப்புகள் - மூன்றும் முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Examine statements on Nagoor Rumi: 1. Birth name was Mohamed Rafi. 2. Born in Thanjavur district. 3. Collections include Nadhiyin Kaalgal and Eazhaavadhu Suvai. Which are correct?", "media_id": null}], "options": {"A": "1 and 2 only", "B": "2 and 3 only", "C": "1 and 3 only", "D": "1, 2, and 3 - All are correct"}, "explanation": "All three statements are factually authentic."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporati