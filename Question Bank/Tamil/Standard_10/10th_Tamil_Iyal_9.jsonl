{"id": "10th-u9-q139", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "anigal", "chapter_id": null, "topic_id": "kannagi_silambu_reality", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"கையில் தனிச்சிலம்பும் கண்ணீரும்\" - இத்தொடரில் கண்ணகியின் துயரம் மிகைப்படுத்தப்படாமல் உள்ளவாறே கூறப்பட்டுள்ளதால் இது எந்த அணிக்குச் சிறந்த சான்றாகும்?", "media_id": null}], "options": {"A": "உவமை அணி", "B": "தற்குறிப்பேற்ற அணி", "C": "தன்மை நவிற்சி அணி", "D": "நிரல்நிறை அணி"}, "explanation": "பாடநூல் விளக்கம்: கண்ணகியின் கோலத்தை உள்ளவாறே சித்தரித்து நெஞ்சை உலுக்கும் சோகத்தை உருவாக்கியதால் இது தன்மை நவிற்சி அணிக்கு இணையற்ற சான்றாகும்."}, "en": {"blocks": [{"type": "text", "content": "Why is the phrase \"With solitary anklet in hand and streaming tears\" an unexcelled instance of Thanmai Navirsi Ani?", "media_id": null}], "options": {"A": "It uses simile", "B": "It imputes external intent", "C": "It mirrors raw unembellished reality evocative of heartbreaking grief", "D": "It uses parallel ordering"}, "explanation": "It reflects raw unembellished tragic reality."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 209, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 209", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["தன்மை நவிற்சி", "சிலப்பதிகாரம்", "கண்ணகி சிலம்பு"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u9-q140", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "anigal", "chapter_id": null, "topic_id": "summary_unit9_grammar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "10-ஆம் வகுப்பு இயல் 9 கற்கண்டுப் பகுதியில் பயிற்றுவிக்கப்படும் நான்கு முதன்மை அணிகள் எவை?", "media_id": null}], "options": {"A": "உவமை அணி, உருவக அணி, வேற்றுமை அணி, சிலேடை அணி", "B": "பின்வருநிலையணி, வஞ்சப்புகழ்ச்சி அணி, பிறிது மொழிதல் அணி, இரட்டுற மொழிதல்", "C": "வேற்றுப்பொருள் வைப்பணி, எடுத்துக்காட்டு உவமை அணி, இல்பொருள் உவமை அணி, ஏகதேச உருவக அணி", "D": "தற்குறிப்பேற்ற அணி, தீவக அணி, நிரல்நிறை அணி, தன்மை நவிற்சி அணி"}, "explanation": "பாடநூல் அட்டவணை: இயல் 9-இல் தற்குறிப்பேற்ற அணி, தீவக அணி, நிரல்நிறை அணி, தன்மை நவிற்சி அணி ஆகிய நான்கு அணிகள் விரிவாக விளக்கப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": "Which four major poetic figures constitute the curriculum of Standard 10 Unit 9 grammar?", "media_id": null}], "options": {"A": "Simile, Metaphor, Contrast, Double Entendre", "B": "Pinvarunilai, Irony, Allegory, Pun", "C": "Exemplification, Hyperbole, Unreal simile, Partial metaphor", "D": "Tharkurippetra Ani, Theevaga Ani, Niralnirai Ani, Thanmai Navirsi Ani"}, "explanation": "These four foundational figures make up Unit 9 grammar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"ty