{"id": "10th-u9-q093", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "title_significance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"ஒருவன் இருக்கிறான்\" என்ற சிறுகதைத் தலைப்பு உணர்த்தும் ஆழமான மெய்ப்பொருள் யாது?", "media_id": null}], "options": {"A": "எத்தகைய கொடிய துயரிலும் எளிய மனிதர்களுக்குள் உறங்கும் கருணையும், பிறரைக் காக்கும் அன்பும் இன்னும் உயிரோடு இருக்கிறது", "B": "ஊரில் ஒரு மனிதன் மட்டுமே வாழ்கிறான்", "C": "பணக்காரன் மட்டுமே வாழ முடியும்", "D": "மருத்துவர் மட்டுமே காப்பாற்ற முடியும்"}, "explanation": "பாடநூல் விளக்கம்: மனிதநேயம் மடிந்துவிடவில்லை; திக்கற்ற எளியவர்க்கும் ஆதரவாக யாரோ ஓர் எளிய மனிதனின் வழியே கருணை வாழ்கிறது என்ற ஆன்ம நம்பிக்கையைக் குறிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What profound truth is signified by the title \"Oruvan Irukkiran\" (Someone Still Exists)?", "media_id": null}], "options": {"A": "Even amid dire destitution, self-effacing compassion and protective empathy survive alive within human hearts", "B": "Only one person lives in town", "C": "Only the rich survive", "D": "Only doctors can heal"}, "explanation": "Enduring human compassion survives even amid abject poverty and terminal illness."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name