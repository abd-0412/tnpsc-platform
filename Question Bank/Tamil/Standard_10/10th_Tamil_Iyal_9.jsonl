{"id": "10th-u9-q147", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "thirukkural", "chapter_id": null, "topic_id": "oozhaiyum_uppakkam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"ஊழையும் உப்பக்கம் காண்பர் உலைவின்றித் / தாழாது உஞற்று பவர்\" - இதில் \"உப்பக்கம் காண்பர்\" என்பதன் பொருள் யாது?", "media_id": null}], "options": {"A": "முதுகைக் காட்டுவர் (தோற்று ஓடுவர்)", "B": "பக்கபலமாக இருப்பர்", "C": "புறமுதுகு காட்டித் தோற்று ஓடச் செய்வர் (வெற்றி காண்பர்)", "D": "உப்பு வணிகம் செய்வர்"}, "explanation": "பாடநூல் பொருள்: சோர்வில்லாமல் தொடர்ந்து முயற்சி செய்பவர்கள் விதியையும் புறமுதுகு காட்டி ஓடச் செய்து வெற்றி பெறுவார்கள்."}, "en": {"blocks": [{"type": "text", "content": "In \"Oozhaiyum uppakkam kaanbar...\", what does \"Uppakkam kaanbar\" directly mean?", "media_id": null}], "options": {"A": "Flee defeated", "B": "Stand as support", "C": "Defeat fate itself making it turn its back in retreat", "D": "Trade in salt"}, "explanation": "Conquer and put destiny itself to flight through unyielding resolve."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 143, "chapter": null, "section"