{"id": "10th-u9-q109", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "doctor_hospital_attempt", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கதையில் குப்புசாமியை மருத்துவமனையில் சேர்க்க நண்பர் வீரராகவன் யாரிடம் உதவி கேட்கச் சென்றார்?", "media_id": null}], "options": {"A": "அரசு மருத்துவமனை மருத்துவர் மற்றும் நண்பர்களிடம்", "B": "காவல் துறை ஆய்வாளரிடம்", "C": "அரசியல்வாதியிடம்", "D": "வங்கி மேலாளரிடம்"}, "explanation": "பாடநூல் குறிப்பு: குப்புசாமியின் உயிரைக் காப்பாற்ற மருத்துவர்களிடமும் நண்பர்களிடமும் பரிந்துரை கடிதம் பெற அலைந்து திரிந்தார் வீரராகவன்."}, "en": {"blocks": [{"type": "text", "content": "To whom did friend Veeraraghavan run to seek hospital admission and medical assistance for Kuppusamy?", "media_id": null}], "options": {"A": "Government hospital doctors and acquaintances", "B": "Police inspector", "C": "Politician", "D": "Bank manager"}, "explanation": "He ran between doctors and acquaintances to secure medical care."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 206, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 206", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["ஒருவன் இருக்கிறான்", "மருத்துவ உதவி", "வீரராகவன் முயற்சி"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
