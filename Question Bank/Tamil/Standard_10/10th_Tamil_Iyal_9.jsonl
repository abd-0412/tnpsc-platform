{"id": "10th-u9-q083", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "thembavani", "chapter_id": null, "topic_id": "veeramamunivar_memorial", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வீரமாமுனிவர் தன் இறுதிக் காலத்தில் மறைந்து அடக்கம் செய்யப்பட்ட இடம் எது?", "media_id": null}], "options": {"A": "மதுரை", "B": "பாண்டிச்சேரி", "C": "அம்பலக்காடு (கேரளா)", "D": "கோவா"}, "explanation": "பாடநூல் குறிப்பு: வீரமாமுனிவர் கி.பி. 1747-இல் கேரள மாநிலத்தில் உள்ள அம்பலக்காடு என்னும் ஊரில் இயற்கை எய்தினார்."}, "en": {"blocks": [{"type": "text", "content": "Where was Veeramamunivar laid to rest in 1747?", "media_id": null}], "options": {"A": "Madurai", "B": "Pondicherry", "C": "Ambalakkadu (Kerala)", "D": "Goa"}, "explanation": "Veeramamunivar passed away and was interred at Ambalakkadu in Kerala."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 205, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 205", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media"