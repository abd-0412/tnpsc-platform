{"id": "10th-u9-q105", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "other_stories_alagirisamy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கு. அழகிரிசாமியின் புகழ்பெற்ற பிற சிறுகதைகளுள் ஒன்று எது?", "media_id": null}], "options": {"A": "ராஜா வந்திருக்கிறார் (மற்றும் தவப்பயன்)", "B": "கபாடபுரம்", "C": "சாப விமோசனம்", "D": "ஒரு நாள் கழிந்தது"}, "explanation": "கூடுதல் தேர்வுக்குறிப்பு: \"ராஜா வந்திருக்கிறார்\" என்பது கு. அழகிரிசாமியின் மிகச் சிறந்த தலைசிறந்த சிறுகதைகளில் ஒன்றாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which among the following is another iconic short story by Ku. Alagirisamy?", "media_id": null}], "options": {"A": "Raja Vandhirukkirar", "B": "Kabadapuram", "C": "Saaba Vimochanam", "D": "Oru Naal Kazhinthadhu"}, "explanation": "Raja Vandhirukkirar is a renowned masterpiece by him."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 207, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 207", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam":