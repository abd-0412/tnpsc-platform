{"id": "10th-u9-q104", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "life_span_alagirisamy", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எழுத்தாளர் கு. அழகிரிசாமி வாழ்ந்த குறுகிய காலம் எது?", "media_id": null}], "options": {"A": "1890 - 1940", "B": "1900 - 1950", "C": "1910 - 1960", "D": "1923 - 1970 (சுமார் 47 ஆண்டுகள் மட்டுமே வாழ்ந்தார்)"}, "explanation": "பாடநூல் குறிப்பு: கு. அழகிரிசாமி 1923-இல் பிறந்து, 1970-இல் தனது 47-ஆவது வயதிலேயே மறைந்தார்."}, "en": {"blocks": [{"type": "text", "content": "What was the brief lifespan of legendary writer Ku. Alagirisamy?", "media_id": null}], "options": {"A": "1890 - 1940", "B": "1900 - 1950", "C": "1910 - 1960", "D": "1923 - 1970 (lived for about 47 years)"}, "explanation": "He lived between 1923 and 1970."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 207, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 207", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session"