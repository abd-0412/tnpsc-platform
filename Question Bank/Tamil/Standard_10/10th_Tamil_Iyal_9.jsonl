{"id": "10th-u9-q156", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "thirukkural", "chapter_id": null, "topic_id": "ozhukkam_uyir_comparison", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"ஒழுக்கம் விழுப்பம் தரலான் ஒழுக்கம் உயிரினும் ஓம்பப் படும்\" - இக்குறட்பாவில் அமைந்துள்ள எதுகை நயம் யாது?", "media_id": null}], "options": {"A": "அடிமோனை மட்டும்", "B": "இயைபுத் தொடை", "C": "முரண் தொடை", "D": "அடி எதுகை (ஒழுக்கம் - இழுக்கம் என இரண்டாம் எழுத்தான ழுகரம் ஒன்றி வருவது)"}, "explanation": "இலக்கண நயம்: முதல் அடியிலும் இரண்டாம் அடியிலும் இரண்டாம் எழுத்து (ழு) ஒன்றி அமைந்ததால் அடி எதுகை."}, "en": {"blocks": [{"type": "text", "content": "Identify the rhyming ornament (Edhugai) in the Kural on moral conduct:", "media_id": null}], "options": {"A": "Alliteration only", "B": "Cadence rhyme", "C": "Contrast", "D": "Adi Edhugai (Second letter \"zha\" rhyming across lines)"}, "explanation": "Adi Edhugai with second letter \"zha\" rhyming across lines."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 70, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 70", "url": null, "