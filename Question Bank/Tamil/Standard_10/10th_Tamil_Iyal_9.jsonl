{"id": "10th-u9-q094", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "journalistic_work_malaysia", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கு. அழகிரிசாமி மலேசியாவில் பணியாற்றிய போது எந்த நாளிதழின் ஆசிரியராகப் பொறுப்பு வகித்தார்?", "media_id": null}], "options": {"A": "தமிழ் முரசு", "B": "தமிழ் நேசன்", "C": "மலேசிய நண்பன்", "D": "சிங்கப்பூர் டைம்ஸ்"}, "explanation": "பாடநூல் குறிப்பு: கு. அழகிரிசாமி சில காலம் மலேசியாவில் தங்கி \"தமிழ் நேசன்\" நாளிதழின் ஆசிரியராகப் பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Which respected daily newspaper did Ku. Alagirisamy edit during his sojourn in Malaysia?", "media_id": null}], "options": {"A": "Tamil Murasu", "B": "Tamil Nesan", "C": "Malaysia Nanban", "D": "Singapore Times"}, "explanation": "He served as editor of Tamil Nesan in Malaysia."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 207, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 207", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "