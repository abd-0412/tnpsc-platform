{"id": "10th-u9-q160", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "thirukkural", "chapter_id": null, "topic_id": "grammar_split_oppuravu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"ஒப்புரவு\" என்னும் சொல்லின் சரியான பொருள் யாது?", "media_id": null}], "options": {"A": "ஒப்பந்தம் செய்தல்", "B": "ஒத்துப் போகுதல்", "C": "ஒப்பனை செய்தல்", "D": "உலக நடையறிந்து எல்லோருக்கும் பொதுவாக உதவி வாழ்தல் (ஊருக்கு உதவுதல்)"}, "explanation": "பாடநூல் விளக்கம்: உலக ஒழுக்கத்தை அறிந்து, தகுதியுடையோருக்கு உதவி செய்யும் நற்பண்பே \"ஒப்புரவு\" எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What is the classical ethical definition of \"Oppuravu\"?", "media_id": null}], "options": {"A": "Contract", "B": "Compromise", "C": "Makeup", "D": "Living in benevolent harmony by aiding society in tune with world order"}, "explanation": "Oppuravu signifies altruistic social beneficence."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 210, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 210", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false