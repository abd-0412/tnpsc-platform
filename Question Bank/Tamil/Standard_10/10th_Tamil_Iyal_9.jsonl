{"id": "10th-u9-q154", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "thirukkural", "chapter_id": null, "topic_id": "tnpsc_pyq_kannoattam_music", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC முந்தைய ஆண்டு வினா] \"பண்ணென்னாம் பாடற் கியைபின்றேல் கண்ணென்னாம் கண்ணோட்டம் இல்லாத கண்\" - இதில் பயின்று வந்துள்ள அணி எது?", "media_id": null}], "options": {"A": "தற்குறிப்பேற்ற அணி", "B": "எடுத்துக்காட்டு உவமை அணி (உவம உருபு மறைந்து வந்துள்ளது)", "C": "நிரல்நிறை அணி", "D": "வேற்றுமை அணி"}, "explanation": "TNPSC வினா ஆய்வு: பாடல் இசைக்கு பொருந்தாவிடில் பயனில்லை என்பது போல, கண்ணோட்டம் இல்லாத கண் பயனற்றது என \"போல\" என்னும் உவம உருபு வெளிப்படாமல் மறைந்து வந்ததால் எடுத்துக்காட்டு உவமை அணி."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Which figure of speech adorns the Kural on music without melody and eyes without mercy?", "media_id": null}], "options": {"A": "Tharkurippetra Ani", "B": "Eduthukkaattu Uvamai Ani (Illustrative simile with implied particle)", "C": "Niralnirai Ani", "D": "Vettrukkai Ani"}, "explanation": "Eduthukkaattu Uvamai Ani with implied comparison particle."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "t