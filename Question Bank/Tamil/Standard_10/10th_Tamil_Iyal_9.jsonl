{"id": "10th-u9-q114", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "anigal", "chapter_id": null, "topic_id": "tharkurippetram_definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயல்பாக நிகழும் ஒரு நிகழ்ச்சியின் மீது கவிஞன் தன் சொந்தக் குறிப்பை (கருத்தை) ஏற்றிக் கூறுவது எந்த அணி எனப்படும்?", "media_id": null}], "options": {"A": "உவமை அணி", "B": "தற்குறிப்பேற்ற அணி", "C": "தீவக அணி", "D": "உருவக அணி"}, "explanation": "பாடநூல் குறிப்பு: இயல்பாக நிகழும் நிகழ்ச்சியின் மீது கவிஞன் தன் குறிப்பை ஏற்றிக் கூறுவது \"தற்குறிப்பேற்ற அணி\" (தன் + குறிப்பு + ஏற்றம்) எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Which poetic figure attributes a poet's imaginative intention onto a natural occurrence?", "media_id": null}], "options": {"A": "Simile (Uvamai Ani)", "B": "Tharkurippetra Ani (Poetic attribution of intent)", "C": "Theevaga Ani", "D": "Metaphor (Uruvaga Ani)"}, "explanation": "Tharkurippetra Ani attributes poet's subjective intent to objective reality."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 208, "chapter": null, "section": null, "reference": "10th Tamil,