{"id": "10th-u9-q025", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "jayakanthan", "chapter_id": null, "topic_id": "tnpsc_pyq_jnanpith_writers", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC முந்தைய ஆண்டு வினா] தமிழில் இதுவரை ஞானபீட விருது பெற்ற இரு பெரும் படைப்பாளர்கள் யார் யார்?", "media_id": null}], "options": {"A": "அகிலன் (1975), ஜெயகாந்தன் (2002)", "B": "பாரதியார், பாரதிதாசன்", "C": "கல்கி, புதுமைப்பித்தன்", "D": "கண்ணதாசன், வைரமுத்து"}, "explanation": "TNPSC வினா: தமிழில் ஞானபீட விருது பெற்றவர்கள் அகிலன் (சித்திரப்பாவை - 1975) மற்றும் ஜெயகாந்தன் (2002) ஆகிய இருவர் மட்டுமே."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] Who are the only two Tamil authors who have received the prestigious Jnanpith Award to date?", "media_id": null}], "options": {"A": "Akilan (1975) and Jayakanthan (2002)", "B": "Bharathiyar and Bharathidasan", "C": "Kalki and Pudhumaipithan", "D": "Kannadasan and Vairamuthu"}, "explanation": "Akilan (1975) and Jayakanthan (2002) are the two Jnanpith laureates in Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 199, "chapter": null,