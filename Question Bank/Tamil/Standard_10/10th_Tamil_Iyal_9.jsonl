{"id": "10th-u9-q155", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "thirukkural", "chapter_id": null, "topic_id": "nandriyil_selvam_poison", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பிறருக்குக் கொடுத்து உதவாத செல்வம் எதற்கு ஒப்பாக அழியும் என்று திருவள்ளுவர் கூறுகிறார்?", "media_id": null}], "options": {"A": "மழை நீருக்கு", "B": "காற்றிற்கு", "C": "நச்சு மரம் பழுத்த நச்சுப் பழத்திற்கு ஒப்பாக எவருக்கும் பயன்படாமல் கெடும்", "D": "மணலுக்கு"}, "explanation": "திருக்குறள் விளக்கம்: \"நச்சுப் படாதவன் செல்வம் நடுவூருள் நச்சு மரம் பழுத்தற்று\" - ஊருக்கு உதவாதவன் செல்வம் நடுவூரில் பழுத்த நச்சு மரத்தின் பழம் போல எவருக்கும் பயனின்றி அழிந்துபோகும்."}, "en": {"blocks": [{"type": "text", "content": "To what does Thiruvalluvar compare the unused wealth of a miser?", "media_id": null}], "options": {"A": "Rain water", "B": "Wind", "C": "Poisonous fruit ripening on a toxic tree in the village square harmful to all", "D": "Sand"}, "explanation": "Fruit ripening on a poisonous tree in the village square."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 210, "chapter": null, "section": null, "re