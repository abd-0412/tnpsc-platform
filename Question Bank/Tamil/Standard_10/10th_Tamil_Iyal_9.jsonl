{"id": "10th-u9-q060", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "thembavani", "chapter_id": null, "topic_id": "title_split_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தேம்பாவணி என்னும் பெயர்ச்சொல் பிரிந்து தரும் இருவேறு பொருள்களுள் சரியான தேர்வு எது?", "media_id": null}], "options": {"A": "தே + பா + அணி = கடவுள் பாடல் மாலை", "B": "தேம் + பாவனி = இனிய பாவனை", "C": "தேம்பா + வணி = வாடும் உலகம்", "D": "தேம்பா + அணி (வாடாத மாலை) மற்றும் தேன் + பா + அணி (தேன் போன்ற இனிய பாடல்களின் மாலை)"}, "explanation": "பாடநூல் விளக்கம்: தேம்பா + அணி எனப் பிரித்தால் வாடாத மாலை என்றும்; தேன் + பா + அணி எனப் பிரித்தால் தேன் போன்ற இனிய பாடல்களின் மாலை என்றும் இருவகைப் பொருள் தரும்."}, "en": {"blocks": [{"type": "text", "content": "What are the two classical semantic meanings derived from dissecting \"Thembavani\"?", "media_id": null}], "options": {"A": "The + Pa + Ani = God's garland", "B": "Them + Bhavani = Sweet expression", "C": "Themba + Vani = Withered world", "D": "Themba + Ani (Unfading garland) and Then + Pa + Ani (Garland of honey-sweet verses)"}, "explanation": "It yields \"Unfading garland\" and \"Garland of honeyed songs\"."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 205, "chapter": null, "section": null, "reference": "10th Tamil, Unit 9, Page 205", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["தேம்பாவணி", "சொல் பிரிப்பு", "வாடாத மாலை"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u9-q061", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "thembavani", "chapter_id": null, "topic_id": "karunaiyan_lament", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடப்பகுதியில் கொடுக்கப்பட்டுள்ள தேம்பாவணிப் பாடல் காட்சி எதனைப் பின்னணியாகக் கொண்டது?", "media_id": null}], "options": {"A": "கருணையன் (யோவான்) தன் தாய் எலிசபெத் மறைந்தபோது காட்டில் பாடிய கையறுநிலைப் புலம்பல்", "B": "இயேசுவின் பிறப்பு விழா", "C": "வளன் எகிப்து நாட்டை விட்டுத் திரும்புதல்", "D": "கானாவூர் திருமணம்"}, "explanation": "பாடநூல் குறிப்பு: தன் அன்புத் தாய் எலிசபெத் அம்மையார் மறைந்த துயரம் தாளாமல், கருணையன் காட்டில் தனியனாக நின்று புலம்பும் தாய்ப் பாசத்தின் உருக்கமான காட்சி இது."}, "en": {"blocks": [{"type": "text", "content": "What poignant context frames the prescribed verses of Thembavani in the textbook?", "media_id": null}], "options": {"A": "Karunaiyan's (John's) mournful elegy in the wilderness upon the passing of his beloved mother Elizabeth", "B": "Nativity of Jesus", "C": "Return from Egypt", "D": "Wedding at Cana"}, "explanation": "Karunaiyan mourning the passing of his mother Elizabeth."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10