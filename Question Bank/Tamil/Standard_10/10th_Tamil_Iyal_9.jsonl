{"id": "10th-u9-q102", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_9", "lesson_id": "oruvan_irukkiran", "chapter_id": null, "topic_id": "moral_lesson", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"ஒருவன் இருக்கிறான்\" சிறுகதை மனித குலத்திற்கு உணர்த்தும் உன்னத வாழ்வியல் அறம் யாது?", "media_id": null}], "options": {"A": "செல்வம் மட்டுமே மனிதனை வாழவைக்கும்", "B": "உயிர்களிடத்தில் அன்பு செலுத்துவதும், எளிய மனிதர்களுக்கு உதவும் மனிதநேயமுமே உலகை இயக்கும் பெருங்கருணை", "C": "நோயாளிகளைத் தனிமைப்படுத்த வேண்டும்", "D": "நகர வாழ்க்கையே சிறந்தது"}, "explanation": "பாடநூல் செய்தி: சுயநலமற்ற அன்பும், சக உயிர்களின் மீதான எல்லையற்ற கருணையுமே மனித வாழ்வின் உண்மையான பொருள்."}, "en": {"blocks": [{"type": "text", "content": "What quintessential life value does the story \"Oruvan Irukkiran\" impart?", "media_id": null}], "options": {"A": "Wealth alone sustains life", "B": "Selfless compassion toward all living beings and humanitarian aid to the suffering sustains the world", "C": "Sick people should be isolated", "D": "Urban life is supreme"}, "explanation": "Compassion toward suffering beings constitutes the true sustaining spirit of humanity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Co