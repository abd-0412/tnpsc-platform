{"id": "10th-u7-q060", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "aer_pudhithaa", "chapter_id": null, "topic_id": "ponnaer_poottuthal_tradition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சித்திரை மாதத்தின் தொடக்கத்தில் முதல் மழை பெய்தவுடன் உழவர்கள் நிலத்தை உழுவதற்காக நிகழ்த்தும் மங்கல நிகழ்வு எது?", "media_id": null}], "options": {"A": "நாற்று நடுதல்", "B": "களை எடுத்தல்", "C": "கதிர் அறுத்தல்", "D": "பொன்னேர் பூட்டுதல் (ஏர் மங்கலம் / உழவுத் திருநாள்)"}, "explanation": "பாடநூல் குறிப்பு: சித்திரை முதல் நாளில் மழை பெய்தவுடன் ஏரில் மாடுகளைப் பூட்டி உழவைத் தொடங்குவதை உழவர்கள் \"பொன்னேர் பூட்டுதல்\" என மங்கலமாகக் கொண்டாடுவர்."}, "en": {"blocks": [{"type": "text", "content": "What sacred inaugural ploughing ritual is performed by farmers at the onset of the first rains in the month of Chithirai?", "media_id": null}], "options": {"A": "Transplanting seedlings", "B": "Weeding operations", "C": "Harvesting crop", "D": "Ponnaer Poottuthal (Golden Plough ceremony / Agrarian inauguration)"}, "explanation": "Ponnaer Poottuthal marks the auspicious seasonal start of ploughing."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "fu