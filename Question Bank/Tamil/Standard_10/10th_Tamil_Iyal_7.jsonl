{"id": "10th-u7-q007", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "sahitya_akademi_award_book", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ம. பொ. சிவஞானம் அவர்களுக்கு 1966-ஆம் ஆண்டு சாகித்திய அகாதெமி விருதைப் பெற்றுத் தந்த தலைசிறந்த வரலாற்று ஆய்வு நூல் எது?", "media_id": null}], "options": {"A": "வீரபாண்டிய கட்டபொம்மன்", "B": "சிலப்பதிகார ஆய்வு", "C": "வள்ளலார் கண்ட ஒருமைப்பாடு", "D": "எனது போராட்டம்"}, "explanation": "பாடநூல் குறிப்பு: ம. பொ. சி அவர்கள் இயற்றிய \"வள்ளலார் கண்ட ஒருமைப்பாடு\" என்னும் வரலாற்று ஆய்வு நூலுக்கு 1966-ஆம் ஆண்டின் சாகித்திய அகாதெமி விருது வழங்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which seminal research work earned M. P. Sivagnanam the prestigious Sahitya Akademi Award in 1966?", "media_id": null}], "options": {"A": "Veerapandiya Kattabomman", "B": "Silappathikara Aaivu", "C": "Vallalar Kanda Orumaippaadu", "D": "Enathu Poraattam"}, "explanation": "He won the Sahitya Akademi Award in 1966 for \"Vallalar Kanda Orumaippaadu\"."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 154, "cha