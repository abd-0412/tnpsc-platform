{"id": "10th-u7-q059", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "aer_pudhithaa", "chapter_id": null, "topic_id": "poet_works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கு. ப. ராஜகோபாலன் அவர்களின் சிறுகதைகள் மற்றும் படைப்புகளுள் அடங்காத ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "அகலிகை", "B": "ஆத்மசிந்தனை", "C": "கோபல்லபுரத்து மக்கள்", "D": "காணாமலே காதல்"}, "explanation": "கு. ப. ரா அவர்களின் படைப்புகள்: அகலிகை, ஆத்மசிந்தனை, விடியுமா முதலானவை. \"கோபல்லபுரத்து மக்கள்\" புதினத்தை எழுதியவர் கி. ராஜநாராயணன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Identify the literary work NOT composed by Ku. Pa. Rajagopalan:", "media_id": null}], "options": {"A": "Agaligai", "B": "Aathmasinthana", "C": "Gopallapurathu Makkal", "D": "Kaanamalae Kaadhal"}, "explanation": "Gopallapurathu Makkal was written by Ki. Rajanarayanan, not Ku. Pa. Raa."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 157, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 157", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null