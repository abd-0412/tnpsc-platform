{"id": "10th-u7-q004", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "early_profession_printing", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பள்ளிப் படிப்பை இழந்த ம. பொ. சிவஞானம் தமது இளம் வயதில் எத்தொழிலில் சேர்ந்து எழுத்துக்களைக் கூட்டி வாசிக்கும் திறனைப் பெற்றார்?", "media_id": null}], "options": {"A": "நெசவுத் தொழில்", "B": "தச்சுத் தொழில்", "C": "விவசாயத் தொழில்", "D": "அச்சுக் கூடத்தில் அச்சுக்கோக்கும் தொழில் (Compositor)"}, "explanation": "அச்சுக் கூடத்தில் அச்சுக்கோக்கும் தொழிலாளியாகச் சேர்ந்த ம. பொ. சி, அங்கு தமிழ் எழுத்துக்களைக் கூட்டிப் பிழைதிருத்திப் படித்துத் தன் மொழி அறிவை சுயமாக வளர்த்துக் கொண்டார்."}, "en": {"blocks": [{"type": "text", "content": "Which manual trade did young M. P. Sivagnanam enter, which paradoxically nurtured his self-taught reading literacy?", "media_id": null}], "options": {"A": "Textile weaving", "B": "Carpentry work", "C": "Agricultural labor", "D": "Typesetting in a printing press (Compositor)"}, "explanation": "Working as a typesetter in printing presses helped him master Tamil letters and literature."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class"