{"id": "10th-u7-q110", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "silappathikaram", "chapter_id": null, "topic_id": "eight_kool_seven_kool_stage", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரத்தில் குறிப்பிடப்படும் நாட்டிய அரங்கின் அகலம் மற்றும் நீள அளவுகள் முறையே எவை?", "media_id": null}], "options": {"A": "ஐந்து கோல் அகலம், ஐந்து கோல் நீளம்", "B": "எட்டுக் கோல் அகலம் மற்றும் ஏழு கோல் நீளம் (உயரம் ஒரு கோல்)", "C": "பத்துக் கோல் அகலம், பத்துக் கோல் நீளம்", "D": "நான்கு கோல் அகலம், மூன்று கோல் நீளம்"}, "explanation": "பாடநூல் குறிப்பு: \"எண்கோல் அகலத்து ஏழ்கோல் நீளத்து ஒருகோல் உயரத்து அரங்காக...\" நாட்டிய அரங்கம் 8 கோல் அகலமும், 7 கோல் நீளமும், 1 கோல் உயரமும் கொண்டது."}, "en": {"blocks": [{"type": "text", "content": "What were the precise width and length dimensions of the performance stage in Arangaetru Kaathai?", "media_id": null}], "options": {"A": "5 rods wide and 5 rods long", "B": "8 rods width and 7 rods length (1 rod height)", "C": "10 rods wide and 10 rods long", "D": "4 rods wide and 3 rods long"}, "explanation": "The stage measured 8 rods wide by 7 rods long, raised 1 rod high."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporatio