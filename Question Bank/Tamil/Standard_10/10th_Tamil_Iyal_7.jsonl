{"id": "10th-u7-q086", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "silappathikaram", "chapter_id": null, "topic_id": "kandams_and_kathais", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரத்தில் உள்ள மொத்தக் காண்டங்கள் மற்றும் காதைகளின் எண்ணிக்கை முறையே எவ்வளவு?", "media_id": null}], "options": {"A": "6 காண்டங்கள் - 64 காதைகள்", "B": "3 காண்டங்கள் (புகார், மதுரை, வஞ்சி) - 30 காதைகள்", "C": "5 காண்டங்கள் - 50 காதைகள்", "D": "4 காண்டங்கள் - 40 காதைகள்"}, "explanation": "சிலப்பதிகாரம் 3 காண்டங்களைக் கொண்டது: புகார் காண்டம் (10 காதைகள்), மதுரைக் காண்டம் (13 காதைகள்), வஞ்சிக் காண்டம் (7 காதைகள்). மொத்தம் 30 காதைகள்."}, "en": {"blocks": [{"type": "text", "content": "How many Kandams (Cantos) and Kaathais (Chapters) constitute Silappathikaram?", "media_id": null}], "options": {"A": "6 Kandams - 64 Kaathais", "B": "3 Kandams (Puhar, Madurai, Vanchi) - 30 Kaathais", "C": "5 Kandams - 50 Kaathais", "D": "4 Kandams - 40 Kaathais"}, "explanation": "Silappathikaram comprises 3 Kandams and 30 Kaathais."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 162, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 162", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["சிலப்பதிகாரம்", "காண்டங்கள் காதைகள்", "3 காண்டம் 30 காதை"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q087", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "silappathikaram", "chapter_id": null, "topic_id": "textbook_kathai_name", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "10-ஆம் வகுப்பு இயல் 7 பாடப்பகுதியில் இடம்பெற்றுள்ள சிலப்பதிகாரப் பகுதி எது?", "media_id": null}], "options": {"A": "கொலைக்களக் காதை", "B": "வழக்குரை காதை", "C": "அரங்கேற்று காதை (புகார் காண்டம் - காதை 3)", "D": "காடுகாண் காதை"}, "explanation": "பாடநூலில் இடம்பெற்றுள்ள பகுதி: புகார் காண்டத்தில் மாதவியின் நாட்டிய அரங்கேற்றத்தை விவரிக்கும் மூன்றாவது காதையான \"அரங்கேற்று காதை\" ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which specific chapter of Silappathikaram is featured in the Class 10 textbook?", "media_id": null}], "options": {"A": "Kolaikkala Kaathai", "B": "Vazhakkurai Kaathai", "C": "Arangaetru Kaathai (Canto 3 of Puhar Kandam)", "D": "Kaadukaan Kaathai"}, "explanation": "The prescribed text is Arangaetru Kaathai portraying Madhavi's dance debut."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 160",