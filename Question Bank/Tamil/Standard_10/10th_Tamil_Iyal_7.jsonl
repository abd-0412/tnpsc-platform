{"id": "10th-u7-q014", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "congress_movement_entry", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ம. பொ. சிவஞானம் அவர்கள் எந்த மாபெரும் தேசியத் தலைவரின் கொள்கைகளால் ஈர்க்கப்பட்டு இந்திய விடுதலை இயக்கத்தில் இணைந்தார்?", "media_id": null}], "options": {"A": "ஜவஹர்லால் நேரு", "B": "மகாத்மா காந்தியடிகள்", "C": "சுபாஷ் சந்திர போஸ்", "D": "சர்தார் வல்லபாய் படேல்"}, "explanation": "காந்தியடிகளின் சத்தியாகிரகம், எளிமை மற்றும் சுதேசி சிந்தனைகளால் ஈர்க்கப்பட்டு ம. பொ. சி இந்திய தேசிய காங்கிரஸ் இயக்கத்தில் தீவிரமாக ஈடுபட்டார்."}, "en": {"blocks": [{"type": "text", "content": "By which towering national leader's ideals was M. P. Sivagnanam deeply drawn to join the freedom movement?", "media_id": null}], "options": {"A": "Jawaharlal Nehru", "B": "Mahatma Gandhi", "C": "Subhas Chandra Bose", "D": "Sardar Vallabhbhai Patel"}, "explanation": "Mahatma Gandhi's ideals galvanized him into the national freedom struggle."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 151, "chapter": null, "section": null, "refe