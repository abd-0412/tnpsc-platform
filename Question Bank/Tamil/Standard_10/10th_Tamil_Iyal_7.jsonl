{"id": "10th-u7-q097", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "silappathikaram", "chapter_id": null, "topic_id": "twin_epics_pair", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரமும் மணிமேகலையும் கதையமைப்பாலும் காலத்தாலும் இணைந்து விளங்குவதால் எவ்வாறு அழைக்கப்படுகின்றன?", "media_id": null}], "options": {"A": "இரட்டைக் காப்பியங்கள்", "B": "பெருங்காப்பியங்கள்", "C": "சமணக் காப்பியங்கள்", "D": "பக்தி நூல்கள்"}, "explanation": "சிலப்பதிகாரத்தின் தொடர்ச்சியாக மணிமேகலை அமைந்திருப்பதால் இவ்விரண்டும் \"இரட்டைக் காப்பியங்கள்\" என அழைக்கப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Because of their shared timeline and continuous storyline, Silappathikaram and Manimekalai are jointly hailed as:", "media_id": null}], "options": {"A": "Irattai Kaappiyangal (The Twin Epics)", "B": "Perunkaappiyangal", "C": "Jain Epics", "D": "Bhakti Texts"}, "explanation": "They are celebrated together as the Twin Epics of Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 162, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 162", "url": null, "sour