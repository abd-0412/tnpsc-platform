{"id": "10th-u7-q066", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "meikkeerthi", "chapter_id": null, "topic_id": "paradoxical_poetics_elephants", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரண்டாம் இராசராசனின் மெய்க்கீர்த்தியில், நாட்டில் சிறைத்தண்டனை இல்லை என்பதை உணர்த்தும் \"முரண் அழகு வரி\" எது?", "media_id": null}], "options": {"A": "சிலம்புகள் மட்டுமே புலம்பின", "B": "யானைகள் மட்டுமே பிணிக்கப்பட்டன (விலங்கிடப்பட்டன); மனிதர்கள் எவரும் பிணிக்கப்படவில்லை!", "C": "காடுகள் மட்டுமே புல் கொண்டன", "D": "புனல் மட்டுமே அடைக்கப்பட்டது"}, "explanation": "யானைகளை மட்டுமே வடங்களால் கட்டினர் (பிணித்தனர்); குடிமக்களில் எவரும் குற்றத்திற்காகச் சிறையில் பிணிக்கப்படவில்லை என ஆட்சிச் சிறப்பை உரைக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "In Rajaraja II's Meikkeerthi, which paradoxical line illustrates that prisons and chains were non-existent for citizens?", "media_id": null}], "options": {"A": "Anklets alone lamented", "B": "Elephants alone were tethered/chained; no human beings were chained!", "C": "Only forests held grass", "D": "Only floods were dammed"}, "explanation": "Elephants were chained in stables, but no human subject was chained in prison."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 158, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 158", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மெய்க்கீர்த்தி", "யானைகள் பிணிக்கப்பட்டன", "முரண் நயம்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q067", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "meikkeerthi", "chapter_id": null, "topic_id": "silambu_pulambina_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"சிலம்புகளே புலம்பின; மக்களில் எவரும் புலம்பவில்லை\" - இத்தொடர் உணர்த்தும் உண்மை யாது?", "media_id": null}], "options": {"A": "மக்கள் பேசா மடந்தையராக இருந்தனர்", "B": "சிலம்புகள் உடைந்தன", "C": "பெண்கள் கால்களில் அணிந்த சிலம்புகள் மட்டுமே ஒலி எழுப்பின (புலம்பின); நாட்டில் துயரத்தால் புலம்பும் மக்கள் எவருமே இல்லை", "D": "நாட்டில் அமைதி இல்லை"}, "explanation": "சிலம்பு புலம்பின = பெண்களின் கால்களில் சிலம்புகள் இனிமையாக ஒலித்தன; வறுமையோ துன்பமோ இல்லாததால் நாட்டில் மனிதர்கள் எவரும் அழுது புலம்பவில்லை என்று ஆட்சிச் சிறப்பைப் போற்றுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What profound reality is captured by \"Silambugalae pulambina\" (Anklets alone wept/lamented; none of the citizens wept)?", "media_id": null}], "options": {"A": "People were struck dumb", "B": "Anklets shattered", "C": "Only the jingling ankle bells of women chimed; no citizen ever wept in agony or distress", "D": "Unrest everywhere"}, "explanation": "Only women's anklets made tinkling sounds; no subject shed tears of suffering."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 158, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 158", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மெய்க்கீர்த்தி", "சிலம்புகள் புலம்பின", "நயம்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q068", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "meikkeerthi", "chapter_id": null, "topic_id": "sengol_bent_justice", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"செங்கோலே வளைந்தது; நீதி நெறி ஒருபோதும் வளையவில்லை\" - இதில் செங்கோல் வளைந்தது எதைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "அரசன் தடியை வளைத்தான்", "B": "போர்க்களத்தில் கத்தி வளைந்தது", "C": "அரசாங்கக் கம்பம் சாய்ந்தது", "D": "அரசனின் செங்கோல் மட்டுமே வளைந்து காக்கும் குடையானது; அவனது நடுவுநிலை தவறாத நீதி வளைந்து போகவில்லை"}, "explanation": "செங்கோல் குடையின் கீழ் வளைந்து நின்றது; ஆனால் மன்னனின் அறநெறி வழுவாத நீதிநெறி எவ்வகையிலும் கோணவில்லை என்பது நயமான முரணாகும்."}, "en": {"blocks": [{"type": "text", "content": "In the Meikkeerthi paradox \"The royal scepter alone bent, but the course of justice never bent\", what does the bent scepter mean?", "media_id": null}], "options": {"A": "The king bent his stick", "B": "Swords bent in war", "C": "Flagpole tilted", "D": "The royal scepter bent only as a sheltering arch of benevolence; his upright impartial justice never compromised"}, "explanation": "The royal scepter curved like an umbrella of grace, but righteous justice remained steadfastly straight."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 158, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 158", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மெய்க்கீர்த்தி", "செங்கோல் வளைந்தது", "நீதி நெறி"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q069", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "meikkeerthi", "chapter_id": null, "topic_id": "water_dammed_not_people", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரண்டாம் இராசராசனின் ஆட்சியில் \"புனல் மட்டுமே அடைக்கப்பட்டது\" என்பது எதனைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "ஆற்று நீர் மட்டுமே அணைகளில் தேக்கி அடைக்கப்பட்டது; மனிதர்கள் எவரும் சிறையில் அடைக்கப்படவில்லை", "B": "குடிநீர் தடை செய்யப்பட்டது", "C": "மழை நீர் வற்றிப் போனது", "D": "வெள்ளத்தால் மக்கள் இறந்தனர்"}, "explanation": "புனல் அடைக்கப்பட்டது = ஆற்று நீரைப் பாசனத்திற்காக மதகுகளிலும் அணைகளிலும் அடைத்தனர்; மனிதர்கள் எவரும் சிறைச்சாலைகளில் அடைக்கப்படவில்லை."}, "en": {"blocks": [{"type": "text", "content": "What does the Meikkeerthi phrase \"Punal mattumae adaikkappattathu\" signify?", "media_id": null}], "options": {"A": "Only irrigation water was channeled and dammed in reservoirs; no human was imprisoned in dungeons", "B": "Drinking water was blocked", "C": "Rainwater vanished", "D": "Flood casualties"}, "explanation": "Water was stored in reservoirs for farming, while no citizens were locked in prisons."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Co