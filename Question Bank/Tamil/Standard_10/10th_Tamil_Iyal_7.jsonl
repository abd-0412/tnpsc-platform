{"id": "10th-u7-q037", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "thiruttani_temple_hill", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "படாஸ்கர் ஆணையத்தின் தீர்ப்பால் தமிழகத்துடன் மீட்கப்பட்ட முருகப்பெருமானின் ஐந்தாம் படைவீடு அமைந்த திருத்தலம் எது?", "media_id": null}], "options": {"A": "திருத்தணி (தணிகை)", "B": "பழனி", "C": "சுவாமிமலை", "D": "திருச்செந்தூர்"}, "explanation": "ம. பொ. சி அவர்களின் தொடர் போராட்டத்தால் முருகனின் ஐந்தாம் படைவீடான திருத்தணி தமிழகத்தின் எல்லையாக மீட்கப்பட்டது."}, "en": {"blocks": [{"type": "text", "content": "Which sacred 5th abode of Lord Murugan was secured for Tamil Nadu through the border agitation led by Ma. Po. Si.?", "media_id": null}], "options": {"A": "Tiruttani (Thanigai hill)", "B": "Palani", "C": "Swamimalai", "D": "Tiruchendur"}, "explanation": "Tiruttani was integrated into Tamil Nadu through the border struggle."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 153, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 153", "url": null, "source_notes": null}, "previous_