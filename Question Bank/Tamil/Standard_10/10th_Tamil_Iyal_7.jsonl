{"id": "10th-u7-q113", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mangaiyaraai_pirappadharkae", "chapter_id": null, "topic_id": "ms_subbulakshmi_nehru_quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"நான் வெறும் பிரதம மந்திரி; எம். எஸ். சுப்புலட்சுமியோ இசையின் பேரரசி\" என்று போற்றிப் புகழ்ந்த இந்தியப் பிரதமர் யார்?", "media_id": null}], "options": {"A": "ஜவஹர்லால் நேரு", "B": "இந்திரா காந்தி", "C": "லால் பகதூர் சாஸ்திரி", "D": "ராஜீவ் காந்தி"}, "explanation": "பாடநூல் குறிப்பு: பண்டித ஜவஹர்லால் நேரு எம். எஸ். சுப்புலட்சுமியின் இசையைக் கேட்டு வியந்து, \"நான் ஒரு பிரதம மந்திரி மட்டுமே; ஆனால் சுப்புலட்சுமியோ இசையின் பேரரசி\" என்று பாராட்டினார்."}, "en": {"blocks": [{"type": "text", "content": "Which Indian Prime Minister famously acclaimed: \"Who am I, a mere Prime Minister, before a Queen of Song like M. S. Subbulakshmi\"?", "media_id": null}], "options": {"A": "Jawaharlal Nehru", "B": "Indira Gandhi", "C": "Lal Bahadur Shastri", "D": "Rajiv Gandhi"}, "explanation": "Jawaharlal Nehru paid this iconic tribute to M. S. Subbulakshmi."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "p