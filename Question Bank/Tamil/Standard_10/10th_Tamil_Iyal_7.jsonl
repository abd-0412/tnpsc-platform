{"id": "10th-u7-q039", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "devikulam_peerumedu_loss", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழகத்தின் தெற்கு எல்லையில் தமிழர்கள் பெருமளவில் வாழ்ந்தபோதிலும், கேரள மாநிலத்தோடு சேர்க்கப்பட்ட முக்கிய மலைப்பகுதிகள் எவை?", "media_id": null}], "options": {"A": "கொடைக்கானல், நீலகிரி", "B": "ஏற்காடு, ஜவ்வாது மலை", "C": "தேவிகுளம், பீர்மேடு", "D": "ஆனைமலை, கொல்லிமலை"}, "explanation": "தேவிகுளம், பீர்மேடு ஆகிய தமிழர்கள் அடர்த்தியாக வாழ்ந்த தேயிலைத் தோட்டப் பகுதிகள் கேரளத்துடன் இணைக்கப்பட்டதால் தமிழகம் அவற்றை இழந்தது."}, "en": {"blocks": [{"type": "text", "content": "Which predominantly Tamil-inhabited hill plantation tracts on the southern border were ceded to Kerala despite intense protests?", "media_id": null}], "options": {"A": "Kodaikanal and Nilgiris", "B": "Yercaud and Jawadhu", "C": "Devikulam and Peermedu", "D": "Anaimalai and Kolli hills"}, "explanation": "Devikulam and Peermedu were ceded to Kerala."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 153, "chapter": null, "section": null