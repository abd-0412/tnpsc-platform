{"id": "10th-u7-q140", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mangaiyaraai_pirappadharkae", "chapter_id": null, "topic_id": "unit7_prose_women_empowerment", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "10-ஆம் வகுப்பு இயல் 7 விரிவானப் பகுதியான \"மங்கையராய்ப் பிறப்பதற்கே\" உணர்த்தும் இறுதிப் பேருண்மை என்ன?", "media_id": null}], "options": {"A": "பெண்கள் கலைகளைத் தொழிலாகக் கொள்ளக் கூடாது", "B": "பெண்கள் அமைதியாக இருக்க வேண்டும்", "C": "சமூகம் மாறாது", "D": "அர்ப்பணிப்பு, தன்னலமற்ற சேவை, சமூகப் போராட்டம் மற்றும் படைப்பாற்றல் வழியாகப் பெண்கள் உலகையே வழிநடத்தும் ஆற்றல் கொண்டவர்கள்"}, "explanation": "இசை, நாட்டியம், சமூக நீதி மற்றும் இலக்கியம் ஆகிய அனைத்திலும் சாதனை படைத்த இப்பெண்மணிகள் பெண் விடுதலையின் வெற்றிச் சின்னங்கள் ஆவர்."}, "en": {"blocks": [{"type": "text", "content": "What is the overarching realization enshrined in \"Mangaiyaraai Pirappadharkae\"?", "media_id": null}], "options": {"A": "Arts are unfruitful for women", "B": "Passive resignation", "C": "Society never evolves", "D": "Through profound dedication, selfless social activism, creative genius, and resilience, women have the power to steer humanity towards enlightenment"}, "explanation": "Women have the indomitable power to steer humanity toward justice and enlightenment."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 167, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 167", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மங்கையராய்ப் பிறப்பதற்கே", "பாடச் சுருக்கம்", "பெண் ஆளுமை வெற்றி"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
