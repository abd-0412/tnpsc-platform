{"id": "10th-u7-q005", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "thamizharasu_kazhagam_founding", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ம. பொ. சிவஞானம் அவர்களால் தமிழர்களின் பண்பாட்டு, அரசியல் ஒருமைப்பாட்டிற்காக 1946-ஆம் ஆண்டு தொடங்கப்பட்ட அமைப்பு எது?", "media_id": null}], "options": {"A": "தமிழரசுக் கழகம்", "B": "சுயமரியாதை இயக்கம்", "C": "திராவிடர் கழகம்", "D": "நீதிக் கட்சி"}, "explanation": "ம. பொ. சி அவர்கள் 1946-ஆம் ஆண்டு நவம்பரில் \"தமிழரசுக் கழகம்\" என்னும் அரசியல் பண்பாட்டு இயக்கத்தைத் தொடங்கித் தமிழரின் எல்லைகளைக் காக்கப் போராடினார்."}, "en": {"blocks": [{"type": "text", "content": "Which cultural and political organization was founded by M. P. Sivagnanam in 1946 to advocate for Tamil rights and borders?", "media_id": null}], "options": {"A": "Thamizharasu Kazhagam", "B": "Self-Respect Movement", "C": "Dravidar Kazhagam", "D": "Justice Party"}, "explanation": "He founded Thamizharasu Kazhagam in 1946."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 151, "chapter": null, "section": null, "reference": "10th Tam