{"id": "10th-u7-q085", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "silappathikaram", "chapter_id": null, "topic_id": "author_name", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழின் முதல் பெருங்காப்பியமும், முத்தமிழ்க் காப்பியமுமான \"சிலப்பதிகாரம்\" நூலை இயற்றியவர் யார்?", "media_id": null}], "options": {"A": "இளங்கோவடிகள்", "B": "சீத்தலைச் சாத்தனார்", "C": "கம்பர்", "D": "திருத்தக்கதேவர்"}, "explanation": "பாடநூல் குறிப்பு: சேர மன்னன் சேரன் செங்குட்டுவனின் தம்பியான இளங்கோவடிகள் சிலப்பதிகாரத்தை இயற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "Who is the author of \"Silappathikaram\", the maiden epic and foremost classical gem of Tamil literature?", "media_id": null}], "options": {"A": "Ilango Adigal", "B": "Seethalai Saathanar", "C": "Kambar", "D": "Thiruthakkadevar"}, "explanation": "Ilango Adigal, the ascetic younger brother of Cheran Senguttuvan, composed Silappathikaram."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 160", "url": null, "source_notes": null}, "previous_year": {"is_