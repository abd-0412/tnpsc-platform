{"id": "10th-u7-q105", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "silappathikaram", "chapter_id": null, "topic_id": "chola_capital_puhar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மாதவியின் அரங்கேற்று காதை நிகழ்ந்த புகார் நகரம் எந்த ஆற்றின் முகத்துவாரத்தில் அமைந்த சோழர்களின் கடற்கரைத் துறைமுகமாகும்?", "media_id": null}], "options": {"A": "காவிரி ஆறு (காவிரிப்பூம்பட்டினம்)", "B": "வைகை ஆறு", "C": "தாமிரபரணி ஆறு", "D": "பாலாறு"}, "explanation": "காவிரி ஆறு வங்கக் கடலோடு கலக்கும் முகத்துவாரத்தில் அமைந்த சோழப் பேரரசின் உலகப் புகழ்பெற்ற துறைமுக நகரம் காவிரிப்பூம்பட்டினம் (புகார்) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "At the estuary of which sacred river was the coastal Chola capital Puhar (Kaveripoompattinam) situated?", "media_id": null}], "options": {"A": "Cauvery River (Cauveripoompattinam)", "B": "Vaigai River", "C": "Thamirabarani River", "D": "Palar River"}, "explanation": "Puhar was the vibrant seaport at the mouth of the Cauvery River."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 160, "chapter": null, "section": null, "reference": "10th Tamil, Unit