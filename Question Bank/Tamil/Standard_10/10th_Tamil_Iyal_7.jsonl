{"id": "10th-u7-q045", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "tiruttani_border_direction", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ம. பொ. சிவஞானம் அவர்களால் மீட்கப்பட்ட திருத்தணி, தமிழகத்தின் எந்த எல்லையில் அமைந்துள்ளது?", "media_id": null}], "options": {"A": "வடக்கெல்லை (North border)", "B": "தெற்கெல்லை (South border)", "C": "மேற்கெல்லை (West border)", "D": "கிழக்கெல்லை (East border)"}, "explanation": "திருத்தணி தமிழகத்தின் வட எல்லையில் அமைந்துள்ளது; மங்கலங்கிழார், ம.பொ.சி ஆகியோர் வடக்கெல்லைப் போராட்டத்தின் மூலம் இதை மீட்டனர்."}, "en": {"blocks": [{"type": "text", "content": "On which geographical boundary of Tamil Nadu is Tiruttani situated?", "media_id": null}], "options": {"A": "Northern border (Vadakkellai)", "B": "Southern border", "C": "Western border", "D": "Eastern coast"}, "explanation": "Tiruttani guards the northern frontier of Tamil Nadu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 152, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 152", "url": null, "source_notes": null}, "pre