{"id": "10th-u7-q015", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "books_on_silappathikaram", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ம. பொ. சிவஞானம் அவர்கள் சிலப்பதிகாரத்தின் பெருமையை உணர்த்த எழுதிய புகழ்பெற்ற ஆய்வு நூல்களுள் ஒன்று எது?", "media_id": null}], "options": {"A": "சிலம்பு தந்த பெண்", "B": "சிலப்பதிகார நாவல்", "C": "சிலப்பதிகாரமும் தமிழ்த் தேசியமும் / சிலப்பதிகார ஆய்வு நூல்கள்", "D": "மணிமேகலை விளக்கம்"}, "explanation": "ம. பொ. சி சிலப்பதிகாரத்தின் மீது பல்வேறு சொற்பொழிவுகளையும் \"சிலப்பதிகாரமும் தமிழ்த் தேசியமும்\", \"சிலப்பதிகார யாத்திரை\" முதலான அரிய ஆய்வு நூல்களையும் தந்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which scholarly treatise on the epic Silappathikaram was written by M. P. Sivagnanam?", "media_id": null}], "options": {"A": "Silambu Thantha Pen", "B": "Silappathikara Novel", "C": "Silappathikaramum Thamizh Thesiyamum", "D": "Manimekalai Vilakkam"}, "explanation": "He authored foundational studies including \"Silappathikaramum Thamizh Thesiyamum\"."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-20