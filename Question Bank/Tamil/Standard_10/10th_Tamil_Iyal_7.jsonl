{"id": "10th-u7-q030", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "north_border_leader", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழகத்தின் வடக்கெல்லைப் போராட்டத்தை முன்னெடுத்து ம. பொ. சி-யோடு கைகோர்த்து நின்ற முதியவர் யார்?", "media_id": null}], "options": {"A": "நேசமணி", "B": "மங்கலங்கிழார்", "C": "ஜீவானந்தம்", "D": "பெரியார்"}, "explanation": "வடக்கு எல்லைப் போராட்டத்தை முன்னின்று நடத்திய தணிகை உலகநாதர் மற்றும் மங்கலங்கிழார் போன்ற பெரியோர்களோடு ம. பொ. சி இணைந்து திருத்தணியைத் தமிழகத்தோடு இணைக்கப் போராடினார்."}, "en": {"blocks": [{"type": "text", "content": "Which respected elder led the northern border agitation alongside M. P. Sivagnanam to reclaim Tiruttani for Tamil Nadu?", "media_id": null}], "options": {"A": "Marshal Nesamony", "B": "Mangalangizhar", "C": "Jeevanandham", "D": "Periyar"}, "explanation": "Mangalangizhar was the venerable leader of the northern border struggle."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 152, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 152", "url": nul