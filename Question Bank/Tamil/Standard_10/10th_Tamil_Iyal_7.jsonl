{"id": "10th-u7-q022", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "title_silambu_selvar_reason", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ம. பொ. சிவஞானத்திற்கு \"சிலம்புச் செல்வர்\" என்ற பட்டத்தை வழங்கிச் சிறப்பித்த தமிழறிஞர் யார்?", "media_id": null}], "options": {"A": "மறைமலையடிகள்", "B": "ரா. பி. சேதுப்பிள்ளை (சொல்லின் செல்வர் ரா. பி. சேதுப்பிள்ளை)", "C": "திரு. வி. கலியாணசுந்தரனார்", "D": "உ. வே. சாமிநாதையர்"}, "explanation": "ம. பொ. சி அவர்களின் சிலப்பதிகாரப் புலமையையும் பரப்பும் பணியையும் கண்டு வியந்த \"சொல்லின் செல்வர்\" ரா. பி. சேதுப்பிள்ளை அவர்கள் இவருக்கு \"சிலம்புச் செல்வர்\" என்ற பட்டத்தை வழங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "Which eminent literary savant conferred the iconic title \"Silambu Selvar\" upon M. P. Sivagnanam?", "media_id": null}], "options": {"A": "Maraimalai Adigal", "B": "R. P. Sethu Pillai (\"Sollin Selvar\")", "C": "Thiru. Vi. Ka.", "D": "U. V. Swaminatha Iyer"}, "explanation": "R. P. Sethu Pillai bestowed the title \"Silambu Selvar\" upon him."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": 