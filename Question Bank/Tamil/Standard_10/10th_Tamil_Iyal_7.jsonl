{"id": "10th-u7-q008", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "legislative_council_chairman", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ம. பொ. சிவஞானம் அவர்கள் தமிழ்நாடு சட்டமன்ற மேலவைத் தலைவராக (Chairman of Legislative Council) பணியாற்றிய காலகட்டம் எது?", "media_id": null}], "options": {"A": "1950 - 1956", "B": "1960 - 1965", "C": "1980 - 1985", "D": "1972 - 1978"}, "explanation": "பாடநூல் குறிப்பு: ம. பொ. சி அவர்கள் 1972 முதல் 1978 வரை தமிழ்நாடு சட்டமன்ற மேலவைத் தலைவராக மிகச் சிறப்பாகப் பணியாற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "During which tenure did M. P. Sivagnanam serve as the Chairman of the Tamil Nadu Legislative Council?", "media_id": null}], "options": {"A": "1950 - 1956", "B": "1960 - 1965", "C": "1980 - 1985", "D": "1972 - 1978"}, "explanation": "He served as Legislative Council Chairman from 1972 to 1978."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 154, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 154", "url": null, "source_notes": null}, "previous_year":