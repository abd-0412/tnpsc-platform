{"id": "10th-u7-q108", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "silappathikaram", "chapter_id": null, "topic_id": "significance_of_chapter", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகார அரங்கேற்று காதை பண்டைத் தமிழரின் எத்தகைய மேன்மையை உலகிற்கு ஆவணப்படுத்துகிறது?", "media_id": null}], "options": {"A": "போர் முறைகளை மட்டுமே", "B": "வணிகக் கப்பல்களை மட்டுமே", "C": "மருத்துவ முறைகளை மட்டுமே", "D": "பண்டைய தமிழரின் மிகச் செழுமையான நாட்டியக் கலை, மேடை வடிவமைப்பு, இசைக் கோட்பாடுகள் மற்றும் நுண்கலைகளின் உன்னத வளர்ச்சி"}, "explanation": "அரங்கேற்று காதை பண்டைத் தமிழரின் ஒப்பற்ற நாட்டிய சாஸ்திரம், இசைக்கலை நுட்பங்கள் மற்றும் அரங்கக் கட்டிடக் கலையை உலகிற்குப் பறைசாற்றும் அரிய வரலாற்றுப் பெட்டகமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What pinnacle of ancient Tamil cultural civilization is documented through Arangaetru Kaathai?", "media_id": null}], "options": {"A": "Military tactics only", "B": "Merchant fleets only", "C": "Medical lore only", "D": "The exquisite advancement of ancient Tamil dance aesthetics, stage engineering, acoustic theories, and fine arts"}, "explanation": "It documents the world-class sophistication of classical Tamil dance, acoustics, and stagecraft."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 162, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 162", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["சிலப்பதிகாரம்", "அரங்கேற்று காதை மேன்மை", "நாட்டியக் கலை ஆவணம்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q109", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "silappathikaram", "chapter_id": null, "topic_id": "three_cantos_order", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரத்தின் மூன்று காண்டங்களின் சரியான வரிசை எது?", "media_id": null}], "options": {"A": "புகார் காண்டம், மதுரைக் காண்டம், வஞ்சிக் காண்டம்", "B": "மதுரைக் காண்டம், புகார் காண்டம், வஞ்சிக் காண்டம்", "C": "வஞ்சிக் காண்டம், மதுரைக் காண்டம், புகார் காண்டம்", "D": "புகார் காண்டம், வஞ்சிக் காண்டம், மதுரைக் காண்டம்"}, "explanation": "சோழ நாட்டின் புகார் காண்டம் (1), பாண்டிய நாட்டின் மதுரைக் காண்டம் (2), சேர நாட்டின் வஞ்சிக் காண்டம் (3) என மூவேந்தர் வரிசையில் அமைந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "What is the correct sequential order of the 3 Kandams in Silappathikaram?", "media_id": null}], "options": {"A": "Puhar Kandam, Madurai Kandam, Vanchi Kandam", "B": "Madurai, Puhar, Vanchi", "C": "Vanchi, Madurai, Puhar", "D": "Puhar, Vanchi, Madurai"}, "explanation": "The sequence is Puhar (Chola), Madurai (Pandya), and Vanchi (Chera)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page