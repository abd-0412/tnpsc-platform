{"id": "10th-u7-q127", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mangaiyaraai_pirappadharkae", "chapter_id": null, "topic_id": "balasaraswati_artistic_excellence", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "டி. பாலசரஸ்வதி அவர்களின் நாட்டிய அசைவுகளில் உலக அறிஞர்களை வியப்பில் ஆழ்த்திய தனிப்பெரும் சிறப்பம்சம் எது?", "media_id": null}], "options": {"A": "வேகமாகச் சுற்றுவது மட்டுமே", "B": "பல வண்ண உடைகள் அணிவது", "C": "பாடலின் சொற்களுக்கு ஏற்ப முகபாவனைகளில் நுண்ணிய உணர்ச்சிகளைத் தத்ரூபமாக வெளிப்படுத்தும் ஒப்பற்ற \"அபிநயம்\" (Abhinaya)", "D": "மேடை அலங்காரம்"}, "explanation": "பாடநூல் குறிப்பு: பாலசரஸ்வதி அவர்கள் பாடல் வரிகளுக்கு முகத்திலும் கண்களிலும் காட்டும் உயிரோட்டமான நுண்ணிய அபிநயங்களே அவரது நாட்டியத்தின் சிகரமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What singular artistic virtuosity in T. Balasaraswati's dance astounded connoisseurs worldwide?", "media_id": null}], "options": {"A": "Merely rapid footwork pirouettes", "B": "Ostentatious costumes", "C": "Sublime Abhinaya (Nuanced facial expressions capturing micro-emotions matching lyrics)", "D": "Stage decorations"}, "explanation": "Her evocative Abhinaya transformed Bharatanatyam into sublime visual poetry."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 165, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 165", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மங்கையராய்ப் பிறப்பதற்கே", "பாலசரஸ்வதி", "அபிநயம்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q128", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mangaiyaraai_pirappadharkae", "chapter_id": null, "topic_id": "bharathi_penniyam_concept", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"மங்கையராய்ப் பிறப்பதற்கே நல்ல மாதவம் செய்திட வேண்டுமம்மா\" என்று பாடிய மகாகவிஞர் யார்?", "media_id": null}], "options": {"A": "பாரதியார்", "B": "பாரதிதாசன்", "C": "நாமக்கல் கவிஞர்", "D": "கவிமணி தேசிக விநாயகம் பிள்ளை"}, "explanation": "பெண்மையின் மாண்பைப் போற்றி \"மங்கையராய்ப் பிறப்பதற்கே நல்ல மாதவம் செய்திட வேண்டுமம்மா\" என்று கவிமணி தேசிக விநாயகம் பிள்ளை பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who penned the celebrated verse \"Mangaiyaraai pirappadharkae nalla maathavam seidhidavendumammaa\"?", "media_id": null}], "options": {"A": "Mahakavi Bharathiyar", "B": "Bharathidasan", "C": "Namakkal Kavignar", "D": "Kavimani Desika Vinayakam Pillai"}, "explanation": "Kavimani Desika Vinayakam Pillai composed this immortal praise of womanhood."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 163, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 163", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மங்கையராய்ப் பிறப்பதற்கே", "கவிமணி பாடல்", "பெண்மையின் மாண்பு"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q129", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mangaiyaraai_pirappadharkae", "chapter_id": null, "topic_id": "krishnammal_gandhian_lifestyle", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கிருஷ்ணம்மாள் ஜெகந்நாதன் அவர்கள் தமது பொதுவாழ்க்கையில் கடைப்பிடித்த தலையாய வாழ்வியல் நெறி யாது?", "media_id": null}], "options": {"A": "எளிமை, உண்மை, அகிம்சை மற்றும் ஏழை எளிய விளிம்புநிலை மக்களின் சமூக-பொருளாதார விடுதலை", "B": "அரசியல் பதவி வேட்கை", "C": "சொத்து குவித்தல்", "D": "வெளிநாட்டில் நிரந்தரமாக வாழ்வது"}, "explanation": "கிருஷ்ணம்மாள் காந்தியடிகளின் தூய எளிமையோடும் அறவழியோடும் வாழ்ந்து, ஒடுக்கப்பட்ட விவசாயிகளுக்கு நில உரிமை பெற்றுத் தருவதிலேயே தன் வாழ்நாளை அர்ப்பணித்தார்."}, "en": {"blocks": [{"type": "text", "content": "What core ethical lifestyle guided Krishnammal Jagannathan throughout her public service?", "media_id": null}], "options": {"A": "Frugality, truth, non-violence, and socio-economic emancipation of marginalized landless peasants", "B": "Pursuit of electoral power", "C": "Amassing personal wealth", "D": "Expatriate living"}, "explanation": "She embodied Gandhian simplicity and agrarian emancipation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 167, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 167", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மங்கையராய்ப் பிறப்பதற்கே", "கிருஷ்ணம்மாள் நெறி", "காந்திய வாழ்வு"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q130", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mangaiyaraai_pirappadharkae", "chapter_id": null, "topic_id": "rajam_krishnan_first_work", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ராஜம் கிருஷ்ணன் எழுதிய பெண்களின் குடும்பப் போராட்டங்களை விவரிக்கும் முதல் புதினங்களுள் ஒன்று எது?", "media_id": null}], "options": {"A": "குறிஞ்சித்தேன்", "B": "உத்தரகண்டம் / பெண் குரல்", "C": "சேற்றில் மனிதர்கள்", "D": "அலைவாய்க்கரையில்"}, "explanation": "பாடநூல் குறிப்பு: பெண்களின் அக உணர்வுகளையும் சமுதாயப் போராட்டங்களையும் சித்திரிக்கும் பல முன்னோடி நாவல்களை ராஜம் கிருஷ்ணன் படைத்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which pioneering novel depicts the internal tribulations of women in patriarchal society among Rajam Krishnan's early oeuvres?", "media_id": null}], "options": {"A": "Kurinjithen", "B": "Pen Kural / Uthara Kandam", "C": "Saetril Manithargal", "D": "Alaivaaik Karaiyil"}, "explanation": "She articulated women's voices through realistic novels."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 166, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 166", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மங்கையராய்ப் பிறப்பதற்கே", "ராஜம் கிருஷ்ணன்", "பெண் குரல்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q131", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mangaiyaraai_pirappadharkae", "chapter_id": null, "topic_id": "ms_subbulakshmi_charity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எம். எஸ். சுப்புலட்சுமி அவர்கள் தாம் இசைக்கச்சேரிகள் மூலம் ஈட்டிய பெரும் பொருளை எதற்காகப் பயன்படுத்தினார்?", "media_id": null}], "options": {"A": "தனிநபர் பங்களாக்கள் வாங்க", "B": "அயல்நாட்டு வங்கிகளில் சேமிக்க", "C": "மருத்துவமனைகள், பள்ளிகள், பல்கலைக்கழகங்கள் மற்றும் அறக்கட்டளைகளுக்கு நன்கொடையாக அளித்தார்", "D": "திரைப்படத் தொழில் தொடங்க"}, "explanation": "எம். எஸ். சுப்புலட்சுமி அவர்கள் காந்தியடிகளின் நினைவகம், சங்கர நேத்ராலயா கண் மருத்துவமனை, கஸ்தூரிபா அறக்கட்டளை முதலான பல அமைப்புகளுக்குத் தன் கச்சேரி வருமானம் முழுவதையும் தாராளமாக நன்கொடையாக வழங்கினார்."}, "en": {"blocks": [{"type": "text", "content": "How did M. S. Subbulakshmi utilize the immense wealth earned from her concerts throughout her life?", "media_id": null}], "options": {"A": "Amassing personal mansions", "B": "Offshore banking", "C": "Donated to eye hospitals (Sankara Nethralaya), universities, schools, and charitable trusts", "D": "Film production"}, "explanation": "She donated her concert earnings to charitable institutions and hospitals."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "bo