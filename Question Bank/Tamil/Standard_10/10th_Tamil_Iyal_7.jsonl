{"id": "10th-u7-q003", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "early_education_hardship", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ம. பொ. சிவஞானம் அவர்களின் தொடக்கப் பள்ளிப் படிப்பு எந்த வகுப்போடு வறுமையின் காரணமாக முற்றுப்பெற்றது?", "media_id": null}], "options": {"A": "ஐந்தாம் வகுப்பு", "B": "எட்டாம் வகுப்பு", "C": "மூன்றாம் வகுப்பு", "D": "முதல் வகுப்பு"}, "explanation": "குடும்பத்தின் கடுமையான ஏழ்மை காரணமாக புத்தகமும் கட்டணமும் செலுத்த இயலாததால், ம. பொ. சி அவர்களின் பள்ளிப் படிப்பு மூன்றாம் வகுப்போடு நின்றது."}, "en": {"blocks": [{"type": "text", "content": "At which early grade was M. P. Sivagnanam's formal schooling terminated due to extreme family penury?", "media_id": null}], "options": {"A": "Fifth standard", "B": "Eighth standard", "C": "Third standard", "D": "First standard"}, "explanation": "His formal schooling ended in the 3rd standard due to poverty."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 150, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 150", "url": null, "source_notes