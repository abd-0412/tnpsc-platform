{"id": "10th-u7-q141", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "purapporul_ilakkanam", "chapter_id": null, "topic_id": "purapporul_thinaigal_count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புறப்பொருள் வெண்பாமாலை இலக்கண நூலின்படி \"புறத்திணைகள்\" எத்தனை வகைப்படும்?", "media_id": null}], "options": {"A": "பன்னிரண்டு வகைப்படும் (12 திணைகள்)", "B": "ஏழு வகைப்படும்", "C": "எட்டு வகைப்படும்", "D": "பத்து வகைப்படும்"}, "explanation": "புறப்பொருள் வெண்பாமாலை இலக்கணப்படி புறத்திணைகள் வெட்சி முதல் பெருந்திணை வரை 12 வகைப்படும். (தொல்காப்பியத்தில் புறத்திணைகள் 7)."}, "en": {"blocks": [{"type": "text", "content": "According to Purapporul Venba Maalai, into how many types are the martial/external themes (Puratthinaigal) categorized?", "media_id": null}], "options": {"A": "Twelve types (12 Thinaigal)", "B": "Seven types", "C": "Eight types", "D": "Ten types"}, "explanation": "Purapporul Venba Maalai delineates 12 Puratthinais."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 168, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 168", "url": null, "source_notes":