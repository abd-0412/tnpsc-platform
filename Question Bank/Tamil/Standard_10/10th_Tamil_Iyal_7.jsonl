{"id": "10th-u7-q038", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "kanyakumari_taluks_merged", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தெற்கு எல்லைப் போராட்டத்தின் மூலம் திருவிதாங்கூரிலிருந்து பிரிந்து தமிழகத்தோடு இணைந்த நான்கு தாலுகாக்கள் எவை?", "media_id": null}], "options": {"A": "கொல்லம், கோட்டயம், ஆலப்புழா, திருவனந்தபுரம்", "B": "தோவாளை, அகத்தீசுவரம், கல்குளம், விளவங்கோடு மற்றும் செங்கோட்டை", "C": "மதுரை, தேனி, திண்டுக்கல், விருதுநகர்", "D": "பாலக்காடு, வயநாடு, இடுக்கி, கண்ணூர்"}, "explanation": "தோவாளை, அகத்தீசுவரம், கல்குளம், விளவங்கோடு ஆகிய 4 தாலுகாக்கள் கன்னியாகுமரி மாவட்டமாகவும், செங்கோட்டை பகுதியும் தமிழகத்தோடு இணைந்தன."}, "en": {"blocks": [{"type": "text", "content": "Which southern taluks separated from Travancore to constitute Kanyakumari district in Tamil Nadu in 1956?", "media_id": null}], "options": {"A": "Kollam, Kottayam, Alappuzha, Thiruvananthapuram", "B": "Thovala, Agastheeswaram, Kalkulam, Vilavancode, and Shenkottai", "C": "Madurai, Theni, Dindigul, Virudhunagar", "D": "Palakkad, Wayanad, Idukki, Kannur"}, "explanation": "Thovala, Agastheeswaram, Kalkulam, and Vilavancode formed the core."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "p