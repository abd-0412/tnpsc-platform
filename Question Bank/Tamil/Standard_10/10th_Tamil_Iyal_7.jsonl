{"id": "10th-u7-q027", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "part1_philosophical_message", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ம. பொ. சிவஞானத்தின் இளமைக்கால வாழ்க்கை வரலாறு இளைய தலைமுறைக்கு வழங்கும் மகத்தான வழிகாட்டல் யாது?", "media_id": null}], "options": {"A": "பணம் இல்லாவிட்டால் வாழ முடியாது", "B": "பள்ளிப் படிப்பு இல்லாவிட்டால் முன்னேறவே முடியாது", "C": "வறுமையும் வாய்ப்பின்மையும் ஒருபோதும் தடைக்கற்கள் அல்ல; தளராத தன்னம்பிக்கையும் தொடர் வாசிப்பும் மனிதனைப் பெருந்தலைவராக உயர்த்தும்", "D": "பிறரை அண்டிப் பிழைப்பதே வழி"}, "explanation": "எத்தகைய வறுமையிலும் முறையான பள்ளிப் படிப்பு இல்லாத நிலையிலும் சுயமாகப் படித்து சாகித்திய அகாதெமி விருதும் சட்டமன்றத் தலைவர் பதவியும் பெற முடியும் என்பதை ம.பொ.சி-யின் வாழ்வு மெய்ப்பிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What enduring inspirational beacon does M. P. Sivagnanam's early autobiography offer to youth?", "media_id": null}], "options": {"A": "Poverty precludes greatness", "B": "Lack of formal degrees prevents all progress", "C": "Poverty and lack of formal schooling are never insurmountable obstacles; indomitable self-study and willpower can elevate one to statesmanship", "D": "Dependency on others"}, "explanation": "His life proves that indomitable self-reliance and reading can overcome all deprivations."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 154, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 154", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["சிற்றகல் ஒளி", "வழிகாட்டல்", "தன்னம்பிக்கை வெற்றி"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q028", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "summary_part1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ம. பொ. சிவஞானம் அவர்களின் பொதுவாழ்க்கைப் பணிகள் எவற்றோடு பிரிக்க முடியாதவாறு இணைந்திருந்தன?", "media_id": null}], "options": {"A": "வணிக நிறுவனங்கள்", "B": "விளையாட்டு மன்றங்கள்", "C": "வானியல் ஆராய்ச்சிகள்", "D": "இந்திய விடுதலை இயக்கம், தமிழ் மொழிப் பாதுகாப்பு, தமிழிலக்கிய மறுமலர்ச்சி மற்றும் தமிழக எல்லைப் போராட்டங்கள்"}, "explanation": "ம.பொ.சி அவர்கள் தேசிய விடுதலை இயக்கத்திலும், தமிழரின் வரலாற்று எல்லைகளை மீட்பதிலும் தன் வாழ்நாள் முழுவதையும் அர்ப்பணித்த பெருந்தலைவர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "With which epic historic struggles were M. P. Sivagnanam's public contributions inextricably intertwined?", "media_id": null}], "options": {"A": "Commercial banking", "B": "Sports clubs", "C": "Astronomy research", "D": "Indian national liberation, safeguarding Tamil linguistic heritage, literary renaissance, and border protection movements"}, "explanation": "His legacy synthesizes Indian national liberation with Tamil linguistic border defense."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu T