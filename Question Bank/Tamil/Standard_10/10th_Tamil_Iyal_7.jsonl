{"id": "10th-u7-q088", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "silappathikaram", "chapter_id": null, "topic_id": "madhavi_training_duration", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாட்டிய நன்னூல் முறைப்படி மாதவி எந்த வயதில் ஆடற்பயிற்சியைத் தொடங்கி, எத்தனை ஆண்டுகள் பயின்று அரங்கேறினாள்?", "media_id": null}], "options": {"A": "10 வயதில் தொடங்கி 5 ஆண்டுகள் பயின்றாள்", "B": "5 வயதில் தொடங்கி 10 ஆண்டுகள் பயின்றாள்", "C": "9 வயதில் தொடங்கி 3 ஆண்டுகள் பயின்றாள்", "D": "ஏழாம் வயதில் ஆடற்பயிற்சி தொடங்கி, ஐந்து ஆண்டுகள் பயின்று பன்னிரண்டாம் வயதில் அரங்கேறினாள்"}, "explanation": "பாடநூல் வரி: \"ஈராறு ஆண்டின் ஈர் ஏழு ஆண்டின்... ஏழாண்டு இயற்றி ஓராறு ஆண்டில்...\" மாதவி 7-ஆம் வயதில் தொடங்கி 5 ஆண்டுகள் பயின்று 12-ஆம் வயதில் சோழ மன்னன் முன்னிலையில் அரங்கேற்றினாள்."}, "en": {"blocks": [{"type": "text", "content": "According to the Natya treatises, at what age did Madhavi initiate her training and how many years did she study before her royal debut?", "media_id": null}], "options": {"A": "Started at 10, trained for 5 years", "B": "Started at 5, trained for 10 years", "C": "Started at 9, trained for 3 years", "D": "Started at age seven, trained intensively for five years, and debuted at age twelve"}, "explanation": "Madhavi commenced dance training at age 7 and completed 5 years to debut at age 12."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "ne