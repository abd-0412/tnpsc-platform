{"id": "10th-u7-q010", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "national_movement_prison", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்திய விடுதலைப் போராட்டத்தின் போது ம. பொ. சிவஞானம் அவர்கள் சிறைவாசம் அனுபவித்த புகழ்பெற்ற சிறைகள் எவை?", "media_id": null}], "options": {"A": "அந்தமான் சிறை மட்டுமே", "B": "அமராவதி சிறை மற்றும் வேலூர் சிறை", "C": "செல்லுலார் சிறை", "D": "புழல் சிறை"}, "explanation": "சுதந்திரப் போராட்டக் களத்தில் 1942 வெள்ளையனே வெளியேறு இயக்கத்தில் கைதாகி ம. பொ. சி அமராவதி சிறையிலும், வேலூர் சிறையிலும் கடுமையான சிறைத்தண்டனை அனுபவித்தார்."}, "en": {"blocks": [{"type": "text", "content": "In which historic colonial prisons was M. P. Sivagnanam incarcerated during the Indian Independence struggle?", "media_id": null}], "options": {"A": "Andaman Cellular Jail exclusively", "B": "Amaravathi Prison and Vellore Central Prison", "C": "Tihar Jail", "D": "Puzhal Jail"}, "explanation": "He served rigorous prison terms in Amaravathi and Vellore prisons."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 150, "chapter": nul