{"id": "10th-u7-q006", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "autobiography_book_title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ம. பொ. சிவஞானம் அவர்களின் தன்வரலாற்று (Autobiography) நூலின் பெயர் என்ன?", "media_id": null}], "options": {"A": "என் சரிதம்", "B": "எனது போராட்டம்", "C": "வாழ்க்கைப் பயணம்", "D": "நினைவு அலைகள்"}, "explanation": "ம. பொ. சிவஞானம் அவர்களின் முழுமையான வரலாற்றுப் பதிவாக அமைந்த தன்வரலாற்று நூல் \"எனது போராட்டம்\" ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the title of the acclaimed autobiography of M. P. Sivagnanam?", "media_id": null}], "options": {"A": "En Charitham", "B": "Enathu Poraattam (\"My Struggle\")", "C": "Vaazhkkai Payanam", "D": "Ninaivu Alaigal"}, "explanation": "His autobiography is titled \"Enathu Poraattam\"."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 154, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 154", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": n