{"id": "10th-u7-q065", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "meikkeerthi", "chapter_id": null, "topic_id": "textbook_chola_king", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "10-ஆம் வகுப்பு இயல் 7 பாடப்பகுதியில் இடம்பெற்றுள்ள மெய்க்கீர்த்தி எந்தச் சோழ மன்னனுக்குரியது?", "media_id": null}], "options": {"A": "இரண்டாம் இராசராச சோழன்", "B": "முதலாம் இராசேந்திர சோழன்", "C": "கரிகால் சோழன்", "D": "முதலாம் குலோத்துங்கன்"}, "explanation": "பாடநூலில் இடம்பெற்றுள்ள மெய்க்கீர்த்தி இரண்டாம் இராசராச சோழனின் கல்வெட்டிலிருந்து எடுக்கப்பட்டதாகும்."}, "en": {"blocks": [{"type": "text", "content": "The Meikkeerthi excerpted in the Class 10 Tamil textbook belongs to which Chola monarch?", "media_id": null}], "options": {"A": "Rajaraja Chola II (Second Rajaraja Chola)", "B": "Rajendra Chola I", "C": "Karikala Chola", "D": "Kulothunga Chola I"}, "explanation": "It belongs to Rajaraja Chola II."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 158, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 158", "url": null, "source_notes": null}, "previous_year": {"is_previous_yea