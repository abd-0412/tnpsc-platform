{"id": "10th-u7-q053", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "kanyakumari_leader_title", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கன்னியாகுமரி தாலுகாக்கள் தமிழகத்துடன் இணைந்ததன் பின்னணியில் மக்கள் அன்போடு ஏ. நேசமணி அவர்களுக்கு வழங்கிய சிறப்புப் பெயர் எது?", "media_id": null}], "options": {"A": "மார்ஷல் நேசமணி (Marshal Nesamony)", "B": "தளபதி", "C": "கவிஞர்", "D": "பெருந்தலைவர்"}, "explanation": "தெற்கெல்லைப் போராட்டத்தை வீரத்தோடு முன்னெடுத்தமையால் ஏ. நேசமணி அவர்களை மக்கள் \"மார்ஷல் நேசமணி\" என்று போற்றினர்."}, "en": {"blocks": [{"type": "text", "content": "What prestigious honorific did the grateful people confer upon A. Nesamony for liberating Kanyakumari?", "media_id": null}], "options": {"A": "Marshal Nesamony", "B": "Thalapathi", "C": "Kavignar", "D": "Perunthalaivar"}, "explanation": "He was hailed as Marshal Nesamony."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 153, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 153", "url": null, "source_notes": null}, "previous_year": {"is_previous_ye