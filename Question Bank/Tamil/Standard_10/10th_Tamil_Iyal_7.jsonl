{"id": "10th-u7-q032", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "south_border_marshal_nesamony", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கன்னியாகுமரி மாவட்டம் உள்ளிட்ட தெற்கு எல்லைப் பகுதியைத் திருவிதாங்கூர் சமஸ்தானத்திலிருந்து மீட்டுத் தமிழகத்துடன் இணைக்கப் போராடிய \"மார்ஷல்\" யார்?", "media_id": null}], "options": {"A": "மங்கலங்கிழார்", "B": "காமராசர்", "C": "சி. பா. ஆதித்தனார்", "D": "மார்ஷல் ஏ. நேசமணி"}, "explanation": "பாடநூல் குறிப்பு: தெற்கெல்லைப் போராட்டத்தைத் தலைமை தாங்கி நடத்தி, கன்னியாகுமரி மாவட்டத்தைத் தமிழகத்துடன் இணைத்த பெருமை \"மார்ஷல்\" ஏ. நேசமணி அவர்களுக்கு உரியது."}, "en": {"blocks": [{"type": "text", "content": "Which valiant leader, revered as \"Marshal\", spearheaded the southern border struggle to merge Kanyakumari district with Tamil Nadu?", "media_id": null}], "options": {"A": "Mangalangizhar", "B": "K. Kamaraj", "C": "Si. Pa. Adithanar", "D": "Marshal A. Nesamony"}, "explanation": "Marshal A. Nesamony led the movement to merge Kanyakumari with Tamil Nadu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "p