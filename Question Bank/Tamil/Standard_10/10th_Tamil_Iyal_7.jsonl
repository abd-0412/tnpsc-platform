{"id": "10th-u7-q107", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "silappathikaram", "chapter_id": null, "topic_id": "title_given_to_madhavi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அரங்கேற்றத்தை மிக நேர்த்தியாக நிகழ்த்தி முடித்த மாதவிக்கு சோழ மன்னன் வழங்கிய சிறப்புப் பட்டம் யாது?", "media_id": null}], "options": {"A": "நாட்டிய தாரகை", "B": "ஆடல் அரசி", "C": "தலைக்கோலரிவை", "D": "கலைவாணி"}, "explanation": "அரங்கேற்றத்தில் தலைக்கோல் பெற்ற நாட்டியப் பெண்ணுக்கு \"தலைக்கோலரிவை\" என்ற பட்டத்தை மன்னன் வழங்கிச் சிறப்பிப்பது மரபாகும்."}, "en": {"blocks": [{"type": "text", "content": "What royal title was conferred upon Madhavi following her peerless maiden performance?", "media_id": null}], "options": {"A": "Natya Thaaragai", "B": "Aadal Arasi", "C": "Thalaikkol Arivai", "D": "Kalaivaani"}, "explanation": "She was crowned with the prestigious title \"Thalaikkol Arivai\"."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 162, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 162", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": fals