{"id": "10th-u7-q052", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "border_struggle_sacrifice_poet", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வடக்கெல்லைப் போராட்டத்தில் உயிர்நீத்த தியாகிகளுள் பாடநூலில் குறிப்பிடப்படும் முதன்மையான தியாகி யார்?", "media_id": null}], "options": {"A": "சுப்பிரமணிய சிவா", "B": "திருப்பூர் குமரன்", "C": "வாஞ்சிநாதன்", "D": "செங்கல்வராயன் / கோல்டன் ராகவன் மற்றும் திருவேங்கடம்"}, "explanation": "வடக்கெல்லைப் போராட்டத்தில் சிறை சென்று உயிரிழந்த தியாகிகளுள் கோல்டன் ராகவன், திருவேங்கடம் உள்ளிட்ட தியாகிகள் பாடநூலில் போற்றப்படுகின்றனர்."}, "en": {"blocks": [{"type": "text", "content": "Who among the following northern border martyrs sacrificed their lives in prison during the boundary agitation?", "media_id": null}], "options": {"A": "Subramania Siva", "B": "Tiruppur Kumaran", "C": "Vanchinathan", "D": "Golden Raghavan and Thiruvenkadam"}, "explanation": "Golden Raghavan and Thiruvenkadam laid down their lives as martyrs for Tamil borders."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 152, "chapter": nu