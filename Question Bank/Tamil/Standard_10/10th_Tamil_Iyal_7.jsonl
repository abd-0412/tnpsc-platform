{"id": "10th-u7-q063", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "meikkeerthi", "chapter_id": null, "topic_id": "definition_meikkeerthi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சோழ மன்னர்களின் சாதனைகளையும், வரலாற்றையும், புகழையும் கல்வெட்டுகளில் அழியாதவாறு பொறிக்கும் முறை எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "செப்பேடு", "B": "ஓலைச்சுவடி", "C": "மெய்க்கீர்த்தி", "D": "வட்டெழுத்து"}, "explanation": "அரசர்களின் உண்மையான புகழையும் வரலாற்றையும் கல்லில் செதுக்கி ஆவணப்படுத்தும் முறை \"மெய்க்கீர்த்தி\" (மெய் = உண்மை, கீர்த்தி = புகழ்) எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What is the classical epigraphic tradition of engraving the authentic history and benevolent achievements of Chola kings called?", "media_id": null}], "options": {"A": "Copper plate deed", "B": "Palm-leaf manuscript", "C": "Meikkeerthi (Imperial Epigraphic Panegyric)", "D": "Vatteluttu"}, "explanation": "Meikkeerthi is the formal stone-inscribed panegyric eulogizing Chola monarchs."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 158, "chapter": null, "section":