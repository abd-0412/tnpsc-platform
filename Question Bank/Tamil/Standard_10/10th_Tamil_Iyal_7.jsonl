{"id": "10th-u7-q036", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "chennai_mayor_resolution", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சென்னையை ஆந்திராவின் தற்காலிகத் தலைநகராக்க முற்பட்ட போது, அதற்கு எதிராக மாநகராட்சியில் ம. பொ. சி கொண்டுவந்த தீர்மானத்தை ஆதரித்த சென்னை மேயர் யார்?", "media_id": null}], "options": {"A": "காமராசர்", "B": "அண்ணா", "C": "ராஜாஜி", "D": "செங்கல்வராயன் (மாநகராட்சி மேயர் செங்கல்வராயன்)"}, "explanation": "ம. பொ. சி கொண்டுவந்த தீர்மானத்தை அன்றைய மாநகராட்சி மேயர் செங்கல்வராயன் அவர்கள் ஆதரித்து, சென்னையைத் தமிழரின் தலைநகராக நிலைநாட்டத் துணைநின்றார்."}, "en": {"blocks": [{"type": "text", "content": "Which Mayor of Madras Corporation supported M. P. Sivagnanam's resolution affirming that Chennai must remain strictly the capital of Tamil Nadu?", "media_id": null}], "options": {"A": "K. Kamaraj", "B": "C. N. Annadurai", "C": "C. Rajagopalachari", "D": "Mayor Chengalvarayan"}, "explanation": "Mayor Chengalvarayan backed the historic civic resolution."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 152, "chap