{"id": "10th-u7-q078", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "meikkeerthi", "chapter_id": null, "topic_id": "sculptor_poet_relationship", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மெய்க்கீர்த்திகளைப் பாடியவர் யார்? கல்வெட்டில் அவற்றைச் செதுக்கியவர் யார்?", "media_id": null}], "options": {"A": "மன்னனே பாடி செதுக்கினான்", "B": "அரசவைப் புலவர்கள் பாடினர்; தலைசிறந்த கல் தச்சர்கள் (சிற்பிகள்) கல்லில் செதுக்கினர்", "C": "அமைச்சர்கள் மட்டுமே செய்தனர்", "D": "வணிகர்கள் செய்தனர்"}, "explanation": "மெய்க்கீர்த்திகளை அரசவைக் கவிஞர்கள் சொல்லழகுடன் யாத்துத் தர, அவற்றை அழகிய தமிழ் வரிவடிவத்தில் கல் தச்சர்கள் கல்வெட்டுகளாகச் செதுக்கினர்."}, "en": {"blocks": [{"type": "text", "content": "Who composed the poetic text of Meikkeerthis, and who engraved them upon temple stones?", "media_id": null}], "options": {"A": "The king himself wrote and carved them", "B": "Eminent court poets composed the verses, and master stone sculptors (Thachargal) chiseled them", "C": "Ministers solely", "D": "Merchants"}, "explanation": "Royal court poets drafted the panegyrics and master sculptors engraved them."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 159, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 159", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மெய்க்கீர்த்தி", "புலவர் சிற்பி", "உருவாக்கம்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q079", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "meikkeerthi", "chapter_id": null, "topic_id": "ideal_welfare_state_theme", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரண்டாம் இராசராசனின் மெய்க்கீர்த்தி வெளிப்படுத்தும் சோழப் பேரரசின் நல்லாட்சித் தத்துவம் யாது?", "media_id": null}], "options": {"A": "மக்களை அச்சுறுத்தி ஆளுவது", "B": "அயல்நாடுகளைக் கொள்ளையடிப்பது", "C": "மன்னன் மக்களுக்குத் தந்தையைப் போல நின்று, எந்தக் குடிமகனுக்கும் துன்பமின்றி ஒரு குடைக்கீழ் அறநெறி தவறாமல் காக்கும் மக்கள் நல அரசு", "D": "வரி வசூலிப்பதை மட்டுமே குறிக்கோளாகக் கொண்டது"}, "explanation": "அரசன் ஒரு குடையின் கீழ் உலகைக் காத்து, நீதி தவறாமல் ஆட்சி செய்த சோழர்களின் அறநெறி அரசை இம்மெய்க்கீர்த்தி பறைசாற்றுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What vision of an ideal welfare state is projected through Rajaraja II's Meikkeerthi?", "media_id": null}], "options": {"A": "Rule through terror", "B": "Foreign pillage", "C": "A paternalistic welfare state where the sovereign shields all subjects under one umbrella of righteous compassion without oppression", "D": "Tax exploitation"}, "explanation": "It enshrines an enlightened welfare state where subjects lived free from grief."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samac