{"id": "10th-u7-q057", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "aer_pudhithaa", "chapter_id": null, "topic_id": "author_name", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "10-ஆம் வகுப்பு இயல் 7-இல் இடம்பெற்றுள்ள \"ஏர் புதிதா?\" என்னும் வேளாண்மை அழகியல் கவிதையின் ஆசிரியர் யார்?", "media_id": null}], "options": {"A": "கு. ப. ராஜகோபாலன் (கு.ப.ரா)", "B": "ந. பிச்சமூர்த்தி", "C": "புதுமைப்பித்தன்", "D": "தி. ஜானகிராமன்"}, "explanation": "பாடநூல் குறிப்பு: \"ஏர் புதிதா?\" என்னும் கவிதையை இயற்றியவர் மறுமலர்ச்சி எழுத்தாளர் கு. ப. ராஜகோபாலன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the evocative agrarian poem \"Aer Pudhithaa?\" in Standard 10 Unit 7?", "media_id": null}], "options": {"A": "Ku. Pa. Rajagopalan (Ku. Pa. Raa.)", "B": "Na. Pichamurthi", "C": "Pudhumaipithan", "D": "Thi. Janakiraman"}, "explanation": "Ku. Pa. Rajagopalan composed the acclaimed poem Aer Pudhithaa."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 156", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["ஏர் புதிதா", "கு. ப. ராஜகோபாலன்", "ஆசிரியர்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q058", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "aer_pudhithaa", "chapter_id": null, "topic_id": "poet_native_literary_magazines", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கு. ப. ராஜகோபாலன் அவர்கள் பிறந்த ஊர் எது? அவர் பணியாற்றிய புகழ்பெற்ற இதழ்கள் எவை?", "media_id": null}], "options": {"A": "மதுரை - சுதேசமித்திரன்", "B": "கும்பகோணம் (தஞ்சை மாவட்டம்) - மணிக்கொடி, கிராம ஊழியன், பாரதமணி", "C": "சென்னை - ஆனந்த விகடன்", "D": "திருநெல்வேலி - கணையாழி"}, "explanation": "பாடநூல் குறிப்பு: கு. ப. ரா கும்பகோணத்தில் பிறந்தவர்; மணிக்கொடி, கிராம ஊழியன், பாரதமணி, தமிழ்நாடு முதலான இதழ்களில் தீவிரமாகப் பணியாற்றியவர்."}, "en": {"blocks": [{"type": "text", "content": "What was the birthplace of Ku. Pa. Rajagopalan, and which pioneering literary journals did he contribute to?", "media_id": null}], "options": {"A": "Madurai - Swadesamitran", "B": "Kumbakonam (Thanjavur district) - Manikkodi, Grama Oozhiyan, Bharathamani", "C": "Chennai - Ananda Vikatan", "D": "Tirunelveli - Kanaiyaazhi"}, "explanation": "He was born in Kumbakonam and contributed to Manikkodi and Grama Oozhiyan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", 