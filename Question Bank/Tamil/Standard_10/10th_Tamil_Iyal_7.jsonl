{"id": "10th-u7-q050", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "memorial_honors_for_maposi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ம. பொ. சிவஞானம் அவர்களின் தமிழ்த் தொண்டைப் போற்றித் தமிழ்நாடு அரசு அவருக்கு எங்கு சிலை அமைத்துச் சிறப்பித்துள்ளது?", "media_id": null}], "options": {"A": "மதுரையில்", "B": "சென்னையில் (தியாகராய நகர் ஜி. என். செட்டி சாலையில் உள்ள நினைவு மண்டபம் மற்றும் சிலை)", "C": "திருச்சியில்", "D": "கோவையில்"}, "explanation": "தமிழக அரசு ம. பொ. சி அவர்களுக்குச் சென்னையில் மணிமண்டபமும் உருவச்சிலையும் அமைத்து, அவரது நூல்களை நாட்டுடைமையாக்கியுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Where has the Government of Tamil Nadu erected a memorial and statue honoring Silambu Selvar M. P. Sivagnanam?", "media_id": null}], "options": {"A": "In Madurai", "B": "In Chennai (Memorial Hall and statue at T. Nagar)", "C": "In Tiruchy", "D": "In Coimbatore"}, "explanation": "His statue and memorial hall grace T. Nagar in Chennai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 154, "chapter": null, "section":