{"id": "10th-u7-q002", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "full_name_birthplace", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ம. பொ. சிவஞானம் அவர்களின் பெயரில் உள்ள \"ம. பொ.\" என்பதன் விரிவாக்கம் யாது?", "media_id": null}], "options": {"A": "மதுரை பொன்னம்பலம்", "B": "மயிலாப்பூர் பொன்னுசாமி", "C": "மன்னார்குடி பொன்னையா", "D": "மயிலாடுதுறை பொன்னுரங்கம்"}, "explanation": "பாடநூல் குறிப்பு: ம. பொ. சி அவர்களின் இயற்பெயர் சிவஞானம்; மயிலாப்பூரில் பொன்னுசாமி - சிவகாமி தம்பதியருக்குப் பிறந்ததால் மயிலாப்பூர் பொன்னுசாமி சிவஞானம் (ம.பொ.சி) எனப்பட்டார்."}, "en": {"blocks": [{"type": "text", "content": "What does the initial prefix \"Ma. Po.\" in M. P. Sivagnanam stand for?", "media_id": null}], "options": {"A": "Madurai Ponnambalam", "B": "Mylapore Ponnusamy", "C": "Mannargudi Ponnaiya", "D": "Mayiladuthurai Ponnurangam"}, "explanation": "Ma. Po. stands for Mylapore Ponnusamy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 150, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 150", "url": null, "source_notes":