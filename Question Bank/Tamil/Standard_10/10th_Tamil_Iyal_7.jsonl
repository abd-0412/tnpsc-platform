{"id": "10th-u7-q114", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mangaiyaraai_pirappadharkae", "chapter_id": null, "topic_id": "un_general_assembly_performance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எம். எஸ். சுப்புலட்சுமி அவர்கள் எந்த ஆண்டு ஐக்கிய நாடுகள் சபையின் பொது அவையில் (UN General Assembly) இசைக்கச்சேரி நிகழ்த்தி உலக அரங்கில் பாராட்டுப் பெற்றார்?", "media_id": null}], "options": {"A": "1950-ஆம் ஆண்டு", "B": "1966-ஆம் ஆண்டு", "C": "1974-ஆம் ஆண்டு", "D": "1998-ஆம் ஆண்டு"}, "explanation": "1966-ஆம் ஆண்டு ஐ.நா. பொது அவையில் எம். எஸ். சுப்புலட்சுமி அவர்கள் ராஜாஜி இயற்றிய \"குறை ஒன்றும் இல்லை\", \"மைத்ரீம் பஜத\" ஆகிய பாடல்களைப் பாடி உலக நாடுகளின் பிரதிநிதிகளை மெய்சிலிர்க்க வைத்தார்."}, "en": {"blocks": [{"type": "text", "content": "In which historic year did M. S. Subbulakshmi perform at the United Nations General Assembly in New York?", "media_id": null}], "options": {"A": "1950", "B": "1966", "C": "1974", "D": "1998"}, "explanation": "She performed at the UN General Assembly in 1966."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 164, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 164", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மங்கையராய்ப் பிறப்பதற்கே", "ஐ.நா. சபை கச்சேரி", "1966"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q115", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mangaiyaraai_pirappadharkae", "chapter_id": null, "topic_id": "magsaysay_bharat_ratna_years", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எம். எஸ். சுப்புலட்சுமி அவர்களுக்கு \"ராமன் மகசேசே விருது\" மற்றும் \"பாரத ரத்னா விருது\" வழங்கப்பட்ட ஆண்டுகள் முறையே எவை?", "media_id": null}], "options": {"A": "1960 மற்றும் 1980", "B": "1970 மற்றும் 1990", "C": "1974 (மகசேசே விருது) மற்றும் 1998 (பாரத ரத்னா விருது)", "D": "1985 மற்றும் 2000"}, "explanation": "பாடநூல் குறிப்பு: 1974-இல் ஆசியாவின் நோபல் பரிசு எனப்படும் ராமன் மகசேசே விருதும், 1998-இல் இந்தியாவின் உயரிய பாரத ரத்னா விருதும் பெற்றார்."}, "en": {"blocks": [{"type": "text", "content": "In which respective years was M. S. Subbulakshmi conferred with the Ramon Magsaysay Award and the Bharat Ratna?", "media_id": null}], "options": {"A": "1960 and 1980", "B": "1970 and 1990", "C": "1974 (Ramon Magsaysay) and 1998 (Bharat Ratna)", "D": "1985 and 2000"}, "explanation": "She won the Ramon Magsaysay in 1974 and the Bharat Ratna in 1998."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 164, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 164", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மங்கையராய்ப் பிறப்பதற்கே", "மகசேசே பாரத ரத்னா", "1974 மற்றும் 1998"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q116", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mangaiyaraai_pirappadharkae", "chapter_id": null, "topic_id": "balasaraswati_art", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்தியாவின் பாரம்பரிய பரதநாட்டியக் கலையைத் தமது நளினமான அபிநயத்தால் உலக நாடுகளின் பல்கலைக்கழகங்களில் பரப்பிய நாட்டிய மேதை யார்?", "media_id": null}], "options": {"A": "ருக்மிணி தேவி", "B": "பத்மா சுப்பிரமணியம்", "C": "யாழினி", "D": "டி. பாலசரஸ்வதி (T. Balasaraswati)"}, "explanation": "பாடநூல் குறிப்பு: பாலசரஸ்வதி அவர்கள் ஜப்பான், அமெரிக்கா முதலான உலக நாடுகளில் பரதநாட்டியக் கச்சேரிகளையும் விரிவுரைகளையும் நிகழ்த்தி உலகப் புகழ்பெற்றார்."}, "en": {"blocks": [{"type": "text", "content": "Which legendary exponent elevated Bharatanatyam onto the global stage through peerless Abhinaya across international universities?", "media_id": null}], "options": {"A": "Rukmini Devi", "B": "Padma Subrahmanyam", "C": "Yaazhini", "D": "T. Balasaraswati"}, "explanation": "T. Balasaraswati was the undisputed global ambassador of classical Bharatanatyam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 165, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 165", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மங்கையராய்ப் பிறப்பதற்கே", "பாலசரஸ்வதி", "பரதநாட்டிய மேதை"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q117", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mangaiyaraai_pirappadharkae", "chapter_id": null, "topic_id": "rajam_krishnan_sahitya_akademi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் இலக்கியத்தில் சாகித்திய அகாதெமி விருது பெற்ற முதல் பெண் எழுத்தாளர் யார்? அவர் எந்த நாவலுக்காக அவ்விருதைப் பெற்றார்?", "media_id": null}], "options": {"A": "ராஜம் கிருஷ்ணன் - \"வேருக்கு நீர்\" (1973)", "B": "அம்பை - \"சிவப்பு கழுத்துடன் ஒரு பச்சை பறவை\"", "C": "தாமரை - \"வசந்த காலம்\"", "D": "அனுராதா ரமணன் - \"சிறை\""}, "explanation": "பாடநூல் குறிப்பு: தமிழில் சாகித்திய அகாதெமி விருது பெற்ற முதல் பெண் எழுத்தாளர் ராஜம் கிருஷ்ணன் ஆவார்; அவர் 1973-இல் \"வேருக்கு நீர்\" புதினத்திற்காக இவ்விருதைப் பெற்றார்."}, "en": {"blocks": [{"type": "text", "content": "Who was the first woman writer in Tamil literature to win the Sahitya Akademi Award, and for which novel?", "media_id": null}], "options": {"A": "Rajam Krishnan - for \"Vaerukku Neer\" (1973)", "B": "Ambai - for \"Siragugal Muriyum\"", "C": "Thamarai - for \"Vasantha Kaalam\"", "D": "Anuradha Ramanan - for \"Sirai\""}, "explanation": "Rajam Krishnan was the first woman Tamil author to win the Sahitya Akademi Award in 1973 for \"Vaerukku Neer\"."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 166, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 166", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மங்கையராய்ப் பிறப்பதற்கே", "ராஜம் கிருஷ்ணன்", "வேருக்கு நீர் சாகித்திய அகாதெமி"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q118", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mangaiyaraai_pirappadharkae", "chapter_id": null, "topic_id": "rajam_krishnan_novels_topics", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ராஜம் கிருஷ்ணன் அவர்களின் புகழ்பெற்ற நாவல்களையும் அவை சித்திரிக்கும் சமூகக் களங்களையும் சரியாகப் பொருத்துக:\n(a) குறிஞ்சித்தேன் - 1. சிவகாசி தீப்பெட்டித் தொழிற்சாலை குழந்தைத் தொழிலாளர்கள்\n(b) கரிப்பு மணிகள் - 2. நீலகிரி படுகர் இன மக்களின் வாழ்வியல்\n(c) கூட்டுக்குஞ்சுகள் - 3. தூத்துக்குடி உப்பளத் தொழிலாளர்களின் துயரம்", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3", "B": "(a)-2, (b)-3, (c)-1", "C": "(a)-3, (b)-1, (c)-2", "D": "(a)-2, (b)-1, (c)-3"}, "explanation": "பாடநூல் அட்டவணை: குறிஞ்சித்தேன் = நீலகிரி படுகர் வாழ்வு (2); கரிப்பு மணிகள் = தூத்துக்குடி உப்பளத் தொழிலாளர்கள் (3); கூட்டுக்குஞ்சுகள் = சிவகாசி தீப்பெட்டித் தொழில் குழந்தைகள் (1). பொருத்தம்: 2, 3, 1."}, "en": {"blocks": [{"type": "text", "content": "Match the acclaimed investigative novels of Rajam Krishnan with their respective socio-economic settings:\n(a) Kurinjithen - 1. Child laborers in Sivakasi match factories\n(b) Karippu Manigal - 2. Badaga indigenous community of Nilgiris\n(c) Koottukkunjugal - 3. Salt pan laborers of Thoothukudi", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3", "B": "(a)-2, (b)-3, (c)-1", "C": "(a)-3, (b)-1, (c)-2", "D": "(a)-2, (b)-1, (c)-3"}, "explanation": "The correct matching sequence is 2, 3, 1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 166, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 166", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மங்கையராய்ப் பிறப்பதற்கே", "ராஜம் கிருஷ்ணன் நாவல்கள்", "கள ஆய்வு"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q119", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mangaiyaraai_pirappadharkae", "chapter_id": null, "topic_id": "krishnammal_jagannathan_lafti", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்வெண்மணி படுகொலை நிகழ்விற்குப் பின், நிலமற்ற ஏழை விவசாயிகளுக்கு நில உரிமை பெற்றுத்தர \"LAFTI\" (உழுபவர்க்கே நில உரிமை இயக்கம்) அமைப்பைத் தொடங்கிய சமூகப் போராளி யார்?", "media_id": null}], "options": {"A": "ராஜம் கிருஷ்ணன்", "B": "மேரி மெக்லியோட்", "C": "கிருஷ்ணம்மாள் ஜெகந்நாதன்", "D": "அம்புஜத்தம்மாள்"}, "explanation": "பாடநூல் குறிப்பு: காந்தியவாதியான கிருஷ்ணம்மாள் ஜெகந்நாதன் அவர்கள் \"LAFTI\" (Land for Tillers' Freedom) என்னும் அமைப்பைத் தொடங்கி உழைக்கும் மக்களுக்கு நிலங்களைப் பெற்றுத் தந்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which grassroots Gandhian crusader founded LAFTI (Land for Tillers' Freedom) following the Keezhvenmani massacre to secure land deeds for landless Dalit farmers?", "media_id": null}], "options": {"A": "Rajam Krishnan", "B": "Mary McLeod", "C": "Krishnammal Jagannathan", "D": "Ambujathammal"}, "explanation": "Krishnammal Jagannathan spearheaded the agrarian justice movement LAFTI."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 167, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 167", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மங்கையராய்ப் பிறப்பதற்கே", "கிருஷ்ணம்மாள் ஜெகந்நாதன்", "LAFTI இயக்கம்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q120", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mangaiyaraai_pirappadharkae", "chapter_id": null, "topic_id": "krishnammal_international_award", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கிருஷ்ணம்மாள் ஜெகந்நாதன் அவர்களின் தன்னலமற்ற சமூகப் பணிக்காக சுவீடன் நாட்டினால் வழங்கப்பட்ட \"மாற்று நோபல் பரிசு\" (Alternative Nobel Prize) எது?", "media_id": null}], "options": {"A": "ராமோன் மகசேசே விருது", "B": "லெனின் அமைதிப் பரிசு", "C": "புலிட்சர் விருது", "D": "வாழ்வுரிமை விருது (Right Livelihood Award)"}, "explanation": "சுவீடன் நாடு வழங்கிய உயரிய \"வாழ்வுரிமை விருது\" (Right Livelihood Award), ஜம்னாலால் பஜாஜ் விருது, தாமரைத்திரு விருது ஆகியவற்றைப் பெற்றவர் கிருஷ்ணம்மாள் ஜெகந்நாதன்."}, "en": {"blocks": [{"type": "text", "content": "Which international honor, widely hailed as the \"Alternative Nobel Prize\" from Sweden, was conferred upon Krishnammal Jagannathan?", "media_id": null}], "options": {"A": "Ramon Magsaysay Award", "B": "Lenin Peace Prize", "C": "Pulitzer Prize", "D": "Right Livelihood Award (Vaazhvurimai Viruthu)"}, "explanation": "She was honored with the Right Livelihood Award in Sweden."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 167, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 167", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மங்கையராய்ப் பிறப்பதற்கே", "கிருஷ்ணம்மாள் ஜெகந்நாதன்", "வாழ்வுரிமை விருது"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q121", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "mangaiyaraai_pirappadharkae", "chapter_id": null, "topic_id": "rajam_krishnan_field_investigation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எழுத்தாளர் ராஜம் கிருஷ்ணன் அவர்களின் எழுத்துப் பணியின் தனித்துவமான முத்திரை எது?", "media_id": null}], "options": {"A": "நாவல் எழுதும் களத்திற்கே நேரில் சென்று மக்களோடு தங்கி, கள ஆய்வு (Field Work) செய்து உண்மைத் தரவுகளைத் திரட்டி எழுதுதல்", "B": "அறைக்குள் அமர்ந்து கற்பனைக் கதைகளை மட்டுமே எழுதுதல்", "C": "வெளிநாட்டு நாவல்களை மொழிபெயர்ப்பது மட்டுமே", "D": "வரலாற்றை மாற்றி எழுதுதல்"}, "explanation": "உப்பளத் தொழிலாளர்கள், குழந்தைத் தொழிலாளர்கள், பழங்குடியினர் வாழும் இடங்களுக்கே நேரில் சென்று மக்களோடு தங்கி ஆய்வு செய்து உண்மை நிலையை நாவலாக வடித்த பெருமை இவருக்கு உண்டு."}, "en": {"blocks": [{"type": "text", "content": "What distinctive ethnographic methodology characterized Rajam Krishnan's socially committed novel writing?", "media_id": null}], "options": {"A": "Immersive field research, physically living among afflicted communities to collect authentic lived data before authoring novels", "B": "Pure parlor arm-chair romantic fantasy", "C": "Translating foreign pulp fiction exclusively", "D": "Falsifying history"}, "explanation": "She pioneered rigorous ethnographic field immersion for writing social realism novels in Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_