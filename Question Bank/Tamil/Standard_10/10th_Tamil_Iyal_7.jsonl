{"id": "10th-u7-q075", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "aer_pudhithaa", "chapter_id": null, "topic_id": "agricultural_renaissance", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கு. ப. ராஜகோபாலனின் \"ஏர் புதிதா?\" கவிதை மனித சமுதாயத்திற்கு உணர்த்தும் உன்னத செய்தி எது?", "media_id": null}], "options": {"A": "இயந்திரங்களை மட்டுமே நம்ப வேண்டும்", "B": "விவசாயத்திற்கு முக்கியத்துவம் இல்லை", "C": "உழவுத் தொழிலே உலகத்தின் அச்சாணி; இயற்கைக்கும் உழவிற்கும் வணக்கம் செலுத்தி உழைப்பதே வாழ்வின் வளம்", "D": "நிலத்தை விற்க வேண்டும்"}, "explanation": "\"உழுவார் உலகத்தார்க்கு ஆணி\" என்ற குறள் நெறிக்கேற்ப, ஏர் பூட்டி நிலத்தை உழுது பயிர் செய்யும் விவசாயப் பணியே மனித வாழ்வின் தலையாய அறமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What noble message does Ku. Pa. Rajagopalan's poem \"Aer Pudhithaa?\" impart to humanity?", "media_id": null}], "options": {"A": "Rely on mechanization alone", "B": "Agriculture is obsolete", "C": "Farming is the axle-tree of the world; venerating nature and laboring on the land sustains all life", "D": "Sell arable land"}, "explanation": "Tilling the soil is the fundamental sustaining life-force of human existence."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 156", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["ஏர் புதிதா", "உழவின் சிறப்பு", "வாழ்வின் வளம்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q076", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "meikkeerthi", "chapter_id": null, "topic_id": "panegyric_poetic_meter", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரண்டாம் இராசராசனின் மெய்க்கீர்த்திப் பாடல் வரிகள் எவ்வகை யாப்பு நடையில் செதுக்கப்பட்டுள்ளன?", "media_id": null}], "options": {"A": "குறள் வெண்பா", "B": "சிந்துப் பாடல்", "C": "கலிப்பா", "D": "அகவற்பா (ஆசிரியப்பா நடை - சிலேடையும் எதுகை மோனையும் கலந்த கம்பீர உரைநடை-கவிதை)"}, "explanation": "கல்வெட்டு மெய்க்கீர்த்திகள் கம்பீரமான ஆசிரியப்பா (அகவற்பா) நடையில் சந்த நயத்தோடு புலவர்களால் இயற்றப்பட்டுக் கல் தச்சர்களால் செதுக்கப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": "In which classical metrical poetic style is the Meikkeerthi inscribed on temple plinths composed?", "media_id": null}], "options": {"A": "Kural Venba", "B": "Chindu folk meter", "C": "Kalippa", "D": "Agavarpa (Aasiriyappa style with stately cadence, alliteration, and panegyric diction)"}, "explanation": "Meikkeerthis are composed in the dignified, rhythmic Agavarpa (Aasiriyappa) cadence."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 158, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 158", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["மெய்க்கீர்த்தி", "பாவகை", "அகவற்பா ஆசிரியப்பா"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q077", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "aer_pudhithaa", "chapter_id": null, "topic_id": "season_of_ploughing", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஏர் புதிதா கவிதையில் உழவர்கள் பொன்னேர் பூட்டி உழவு தொடங்கும் பருவம் எது?", "media_id": null}], "options": {"A": "சித்திரை முதல் நாள் (இளவேனில் காலத் தொடக்கம்)", "B": "கார்த்திகை தீபம்", "C": "மார்கழி நடுப்பகுதி", "D": "ஆடிப் பெருக்கு மட்டுமே"}, "explanation": "பாடநூல் குறிப்பு: சித்திரைத் திங்களில் முதல் மழை பெய்தவுடன் உழவர்கள் புதிய நம்பிக்கையோடு உழவுப் பணிகளைத் தொடங்குவர்."}, "en": {"blocks": [{"type": "text", "content": "In which Tamil month does the poem Aer Pudhithaa depict the joyous ritual of Ponnaer Poottuthal?", "media_id": null}], "options": {"A": "Chithirai (Beginning of early spring / Tamil New Year)", "B": "Karthigai", "C": "Mid-Margazhi", "D": "Aadi alone"}, "explanation": "Chithirai rain inaugurates the sacred seasonal ploughing cycle."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 156, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 156", "url": null, "sour