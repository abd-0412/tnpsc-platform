{"id": "10th-u7-q013", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "sitragal_oli", "chapter_id": null, "topic_id": "grandma_folksongs_lullabies", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ம. பொ. சிவஞானத்திற்குத் தொடக்கக் காலத்தில் தமிழ் இலக்கிய ஆர்வத்தை விதைத்தவர் யார்?", "media_id": null}], "options": {"A": "தாய் சிவகாமி அம்மையார் (பாடிய அல்லி அரசாணி மாலை, பவளக்கொடி மாலை போன்ற அம்மானைப் பாடல்கள்)", "B": "பள்ளி ஆசிரியர்", "C": "அச்சுக்கூட முதலாளி", "D": "அரசியல் தலைவர்"}, "explanation": "ம. பொ. சி அவர்களின் தாய் சிவகாமி அம்மையார் அல்லி அரசாணி மாலை முதலான அம்மானைப் பாடல்களைப் பாடக் கேட்டுத்தான் அவருக்குத் தமிழ் மீது அளப்பரிய பற்று உண்டானது."}, "en": {"blocks": [{"type": "text", "content": "Who sowed the earliest seeds of passionate love for Tamil poetry in young M. P. Sivagnanam?", "media_id": null}], "options": {"A": "His mother Sivakami Ammaiyar (through lyrical folk ballads like Alli Arasaani Maalai)", "B": "School teacher", "C": "Press proprietor", "D": "Political leader"}, "explanation": "His mother's melodic singing of folk ballads inspired his early Tamil literary love."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "t