{"id": "10th-u7-q098", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "silappathikaram", "chapter_id": null, "topic_id": "three_cardinal_truths", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரம் உணர்த்தும் முப்பெரும் உண்மைகளுள் பொருந்தாத ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "அரசியல் பிழைத்தோர்க்கு அறம் கூற்றாகும்", "B": "அரசன் எவ்வழியோ மக்கள் அவ்வழி மட்டுமே (பாடநூல் முப்பெரும் உண்மை அல்லாதது)", "C": "உரைசால் பத்தினியை உயர்ந்தோர் ஏத்துவர்", "D": "ஊழ்வினை உருத்து வந்து ஊட்டும்"}, "explanation": "சிலப்பதிகாரத்தின் மூன்று நீதிகள்: 1. அரசியல் பிழைத்தோர்க்கு அறம் கூற்றாகும், 2. உரைசால் பத்தினியை உயர்ந்தோர் ஏத்துவர், 3. ஊழ்வினை உருத்து வந்து ஊட்டும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the statement that is NOT one of the Three Cardinal Maxims declared by Silappathikaram:", "media_id": null}], "options": {"A": "Righteousness slays monarchs who swerve from justice", "B": "As is the king, so are the subjects (Non-Silappathikaram dictum)", "C": "The exalted venerate the virtuous chaste wife", "D": "Past destiny inexorably manifests to exact retribution"}, "explanation": "The epic declares justice slays unjust kings, the chaste are revered, and destiny rules."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 162, "chapter": null, "section": null, "reference": "10th Tamil, Unit 7, Page 162", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["சிலப்பதிகாரம்", "முப்பெரும் உண்மைகள்", "அறம் கூற்றாகும்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u7-q099", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_7", "lesson_id": "silappathikaram", "chapter_id": null, "topic_id": "stage_hanging_lamps", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாட்டிய அரங்கில் பார்வையாளர்களுக்கு எவ்விதக் கண் கூச்சமும் நிழலும் விழாதவாறு விளக்குகளைப் பொருத்திய முறை எவ்வாறு விவரிக்கப்படுகிறது?", "media_id": null}], "options": {"A": "விளக்குகளைத் தரையில் வைத்தனர்", "B": "நடிகர்களின் கைகளில் கொடுத்தனர்", "C": "மேடையின் தூண்களின் நிழல் அவையோர் மீதும் அரங்கின் மீதும் விழாத வண்ணம் மேல்நோக்கி அமைக்கப்பட்ட மாட விளக்குகள்", "D": "பார்வையாளர் கைகளில் வைத்தனர்"}, "explanation": "பாடநூல் குறிப்பு: தூண்களின் நிழல் மேடையிலோ அவையோர் மீதோ விழாதவாறு எழிலோடு மாடங்களில் அமைக்கப்பட்ட விளக்குகள் பொருத்தப்பட்டிருந்தன."}, "en": {"blocks": [{"type": "text", "content": "How was the theatrical lighting engineered to ensure zero distracting pillar shadows fell across the auditorium?", "media_id": null}], "options": {"A": "Lamps on the floor", "B": "Actors held lanterns", "C": "Niche-lamps hung overhead positioned so no pillar shadows fell upon spectators or performers", "D": "Spectators held candles"}, "explanation": "Elevated niche lamps prevented shadows from falling on the stage or audience."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil