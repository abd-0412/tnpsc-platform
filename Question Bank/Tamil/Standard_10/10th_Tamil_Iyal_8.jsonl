{"id": "10th-u8-q028", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "gnanam", "chapter_id": null, "topic_id": "philosophical_resolution", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"ஞானம்\" கவிதை வாசகர்களுக்கு வழங்கும் இறுதி விழிப்புணர்வு என்ன?", "media_id": null}], "options": {"A": "அறையை மூடி வைக்க வேண்டும்", "B": "புத்தகங்களைப் படிக்கக் கூடாது", "C": "பழைய கவலைகளிலேயே மூழ்கியிருக்க வேண்டும்", "D": "பழைய துன்பங்களை உதறித்தள்ளி, விழிப்புணர்வுடன் அறிவுக் கதவுகளைத் திறந்து புதிய ஒளியை ஏற்றுப் புத்துலகம் படைக்க வேண்டும்"}, "explanation": "மனதின் சாளரங்களைத் திறந்து புதிய அறிவையும் புத்துணர்ச்சியையும் ஏற்று வாழ்வை முன்னெடுக்க வேண்டும் என்பதே இக்கவிதையின் ஆன்ம பலமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What ultimate philosophical resolution is imparted to readers by the poem \"Gnaanam\"?", "media_id": null}], "options": {"A": "Keep windows shuttered", "B": "Discard all books", "C": "Remain trapped in past misery", "D": "Shake off past despair, unlock the windows of awareness, and embrace the fresh dawn of enlightened action"}, "explanation": "It urges unlocking the mind's windows to welcome enlightened new dawns."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Ed