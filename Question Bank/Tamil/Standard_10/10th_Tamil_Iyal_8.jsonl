{"id": "10th-u8-q022", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "gnanam", "chapter_id": null, "topic_id": "poet_native_profession", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் தி. சோ. வேணுகோபாலன் பிறந்த ஊர் எது? அவர் எங்கு பேராசிரியராகப் பணியாற்றினார்?", "media_id": null}], "options": {"A": "மதுரை - சென்னைப் பல்கலைக்கழகம்", "B": "திருவையாறு (தஞ்சை மாவட்டம்) - மணிப்பால் பொறியியல் கல்லூரியில் இயந்திரவியல் பேராசிரியராகப் பணியாற்றினார்", "C": "கும்பகோணம் - அரசு கல்லூரி", "D": "திருச்சி - தேசியக் கல்லூரி"}, "explanation": "பாடநூல் குறிப்பு: தி. சோ. வேணுகோபாலன் திருவையாற்றில் பிறந்தவர்; மணிப்பால் பொறியியல் கல்லூரியில் இயந்திரவியல் (Mechanical Engineering) பேராசிரியராகப் பணியாற்றியவர்."}, "en": {"blocks": [{"type": "text", "content": "What was the native place of poet Thi. So. Venugopalan, and where did he serve as an engineering professor?", "media_id": null}], "options": {"A": "Madurai - Madras University", "B": "Thiruvaiyaru (Thanjavur) - Professor of Mechanical Engineering at Manipal Institute of Technology", "C": "Kumbakonam - Govt College", "D": "Tiruchy - National College"}, "explanation": "He was born in Thiruvaiyaru and served as a Mechanical Engineering professor at Manipal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 181, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 181", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["ஞானம்", "வேணுகோபாலன் ஊர் பணி", "திருவையாறு மணிப்பால்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u8-q023", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "gnanam", "chapter_id": null, "topic_id": "poetry_collections", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி. சோ. வேணுகோபாலன் அவர்களின் புகழ்பெற்ற கவிதைத் தொகுதிகளுள் ஒன்று எது?", "media_id": null}], "options": {"A": "நட்சத்திரங்களின் தூது", "B": "மறுபயணம்", "C": "கோடைவயல் (மற்றும் மீட்சி விண்ணப்பம்)", "D": "சூரியகாந்தி"}, "explanation": "பாடநூல் குறிப்பு: தி. சோ. வேணுகோபாலன் அவர்களின் கவிதைத் தொகுப்பு \"கோடைவயல்\" ஆகும்; ஞானம் என்னும் கவிதை இத்தொகுப்பிலிருந்தே எடுக்கப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Which celebrated poetry collection by Thi. So. Venugopalan includes the prescribed poem \"Gnaanam\"?", "media_id": null}], "options": {"A": "Natchathirangalin Thoothu", "B": "Marupayanam", "C": "Kodaivayal (and Meetchi Vinnappam)", "D": "Sooriyakanthi"}, "explanation": "The poem Gnaanam is excerpted from his acclaimed anthology \"Kodaivayal\"."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 181, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 181", "url": null