{"id": "10th-u8-q071", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kaalakkanitham", "chapter_id": null, "topic_id": "epic_yesu_kaaviyam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கண்ணதாசன் இயேசு கிறிஸ்துவின் திருச்சரிதத்தைக் காப்பியமாகப் பாடிய நூலின் பெயர் என்ன?", "media_id": null}], "options": {"A": "தேம்பாவணி", "B": "இரட்சணிய யாத்திரிகம்", "C": "இயேசு காவியம்", "D": "கிறிஸ்து சரிதை"}, "explanation": "பாடநூல் குறிப்பு: கவியரசு கண்ணதாசன் தம் இறுதிக் காலத்தில் இயேசுவின் வரலாற்றைக் காவியமாக வடித்த நூல் \"இயேசு காவியம்\" ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the name of the epic composed by Kannadasan narrating the life of Jesus Christ?", "media_id": null}], "options": {"A": "Thembavani", "B": "Ratchanya Yaathrigam", "C": "Yesu Kaaviyam", "D": "Christu Sarithai"}, "explanation": "Yesu Kaaviyam was Kannadasan's epic on the life of Christ."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 183, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 183", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "ex