{"id": "10th-u8-q136", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "paa_vagai", "chapter_id": null, "topic_id": "thalai_definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நின்ற சீரின் ஈற்றசையும், வரும் சீரின் முதலசையும் ஒன்றுபட்டும் ஒன்றுபடாமலும் பொருந்துவது எவ்வாறு அழைக்கப்படும்?", "media_id": null}], "options": {"A": "அடி", "B": "தொடை", "C": "அசை", "D": "தளை (7 வகைப்படும்)"}, "explanation": "பாடநூல் குறிப்பு: நின்ற சீரின் ஈற்றசையும் வரும் சீரின் முதலசையும் இணைவது \"தளை\" எனப்படும். இது ஏழு வகைப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What is the linkage between the terminal syllable of a preceding foot and the opening syllable of the succeeding foot called?", "media_id": null}], "options": {"A": "Adi", "B": "Thodai", "C": "Asai", "D": "Thalai (Metrical bond - 7 types)"}, "explanation": "The linkage between adjacent feet is called Thalai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 188, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 188", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exa