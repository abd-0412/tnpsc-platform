{"id": "10th-u8-q043", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "gnanam", "chapter_id": null, "topic_id": "poetic_tone_simplicity", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"ஞானம்\" கவிதையின் மொழிநடை எத்தகைய தன்மையைக் கொண்டுள்ளது?", "media_id": null}], "options": {"A": "கடினமான இலக்கணச் சொற்கள் நிறைந்த நடை", "B": "வடமொழிச் சொற்கள் நிறைந்த நடை", "C": "எளிய சொல்லாட்சிகள், ஆழ்ந்த தத்துவப் பொருள் மற்றும் காட்சிப்படுத்தும் தன்மை (Visual Imagery)", "D": "அடுக்குமொழிப் பேச்சு நடை"}, "explanation": "கவிஞர் மிக எளிய அன்றாட நிகழ்வான ஜன்னல் திறத்தல், தூசு தட்டுதல் ஆகியவற்றின் வழியே மிகப்பெரிய தத்துவார்த்த உண்மைகளைக் காட்சிப்படுத்தியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "What hallmarks define the poetic style and linguistic diction of \"Gnaanam\"?", "media_id": null}], "options": {"A": "Dense archaic grammatical phrasing", "B": "Sanskritized vocabulary", "C": "Simple everyday diction, profound philosophical resonance, and vivid evocative visual imagery", "D": "Alliterative political oratory"}, "explanation": "Everyday imagery is suffused with profound existential philosophy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class"