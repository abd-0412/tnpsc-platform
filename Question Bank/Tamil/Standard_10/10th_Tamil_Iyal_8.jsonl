{"id": "10th-u8-q085", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ramanujar", "chapter_id": null, "topic_id": "genre_drama", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "10-ஆம் வகுப்பு இயல் 8 விரிவானப் பகுதியில் இடம்பெற்றுள்ள \"இராமானுசர்\" என்னும் பகுதி எந்த இலக்கிய வகையைச் சார்ந்தது?", "media_id": null}], "options": {"A": "நாடகம்", "B": "சிறுகதை", "C": "கட்டுரை", "D": "சுயசரிதை"}, "explanation": "பாடநூல் குறிப்பு: இயல் 8 விரிவானப் பகுதியில் சீர்திருத்தச் செம்மல் இராமானுசரின் மாண்பினை விளக்கும் நாடகக் காட்சி இடம்பெற்றுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Which literary genre does the Unit 8 supplementary lesson \"Ramanujar\" belong to?", "media_id": null}], "options": {"A": "Play / Drama", "B": "Short story", "C": "Essay", "D": "Autobiography"}, "explanation": "It is a dramatic play presenting saint Ramanuja's revolutionary compassion."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 184, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 184", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": nul