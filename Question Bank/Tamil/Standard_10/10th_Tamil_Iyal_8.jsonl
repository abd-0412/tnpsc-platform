{"id": "10th-u8-q148", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "paa_vagai", "chapter_id": null, "topic_id": "nerpu_niraipu_definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "யாப்பிலக்கணத்தில் நேரசையுடன் உகரம் சேர்ந்து வருவது ________; நிரையசையுடன் உகரம் சேர்ந்து வருவது ________ எனப்படும்.", "media_id": null}], "options": {"A": "மலர்; நாள்", "B": "நாள்; மலர்", "C": "நிரைபு; நேர்பு", "D": "நேர்பு; நிரைபு"}, "explanation": "இலக்கண விளக்கம்: நேரசையோடு உகரம் சேரின் நேர்பு (காசு); நிரையசையோடு உகரம் சேரின் நிரைபு (பிறப்பு) எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Direct syllable + \"u\" is ________; compound syllable + \"u\" is ________.", "media_id": null}], "options": {"A": "Malar; Naal", "B": "Naal; Malar", "C": "Niraipu; Nerpu", "D": "Nerpu; Niraipu"}, "explanation": "Ner + u sound is Nerpu; Nirai + u sound is Niraipu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 189, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 189", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_n