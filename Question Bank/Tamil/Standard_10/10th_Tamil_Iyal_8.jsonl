{"id": "10th-u8-q045", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "gnanam", "chapter_id": null, "topic_id": "venugopalan_career_heritage", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பொறியியல் பேராசிரியராக இருந்தபோதிலும் இலக்கியத்தில் தடம் பதித்த தி. சோ. வேணுகோபாலன் பிறப்பால் எம்மண்ணின் இசை, இலக்கிய மரபைப் பெற்றவர்?", "media_id": null}], "options": {"A": "தியாகராஜ சுவாமிகள் அவதரித்த திருவையாறு (காவிரிக் கரை மரபு)", "B": "நெல்லை மண்", "C": "கொங்கு மண்", "D": "சென்னை"}, "explanation": "இசைக்கும் இலக்கியத்திற்கும் புகழ்பெற்ற திருவையாற்று மண்ணில் பிறந்த காரணத்தால் அவருக்குக் கவிதை உணர்வு இயல்பாகவே ஊற்றெடுத்தது."}, "en": {"blocks": [{"type": "text", "content": "Born in Thiruvaiyaru, the consecrated soil of Saint Tyagaraja on the Cauvery, what artistic heritage nourished Venugopalan?", "media_id": null}], "options": {"A": "The sublime musical and literary cultural heritage of Thiruvaiyaru on the Cauvery delta", "B": "Tirunelveli arid plains", "C": "Kongu belt", "D": "Urban Madras"}, "explanation": "Thiruvaiyaru's rich musical and poetic heritage nurtured his creative spirit."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "ful