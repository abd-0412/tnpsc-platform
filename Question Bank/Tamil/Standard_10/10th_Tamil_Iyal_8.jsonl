{"id": "10th-u8-q049", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "gnanam", "chapter_id": null, "topic_id": "ant_smallness_comfort", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கட்டெறும்பின் உருவ அளவு கவிதையில் எதனை உணர்த்தப் பயன்படுகிறது?", "media_id": null}], "options": {"A": "மிகவும் சிறிய வடிவம் (பெரிய சுமைகளும் மிகச் சிறியதாகக் கரைந்து விடும் தன்மை)", "B": "கொடிய விஷம்", "C": "வேகமாக ஓடுதல்", "D": "பறக்கும் திறன்"}, "explanation": "பெரிய கழுதை அளவிலான பிரச்சனைகளும் கூட கால ஓட்டத்தில் ஒரு சிறிய கட்டெறும்பைப் போல அற்பமாகிப் போகும் என்பதைக் காட்டவே எறும்பின் சிறுமை உவமையாகிறது."}, "en": {"blocks": [{"type": "text", "content": "What does the diminutive size of the black ant illustrate in the poem?", "media_id": null}], "options": {"A": "Extreme diminutiveness (illustrating how massive troubles shrink into insignificance)", "B": "Lethal venom", "C": "Speedy running", "D": "Flight capability"}, "explanation": "The tiny ant represents the complete shrinking of once-crushing worries."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 180, "chapter": null, "section": null, "reference