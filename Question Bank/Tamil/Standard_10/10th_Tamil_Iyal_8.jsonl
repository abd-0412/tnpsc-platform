{"id": "10th-u8-q104", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ramanujar", "chapter_id": null, "topic_id": "statue_of_equality_hyderabad", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இராமானுசரின் ஆயிரமாவது ஆண்டு நிறைவை முன்னிட்டு ஐதராபாத்தில் நிறுவப்பட்ட பிரம்மாண்ட சிலையின் பெயர் யாது?", "media_id": null}], "options": {"A": "ஒற்றுமைச் சிலை (Statue of Unity)", "B": "அமைதிச் சிலை (Statue of Peace)", "C": "ஞானச் சிலை (Statue of Knowledge)", "D": "சமத்துவச் சிலை (Statue of Equality)"}, "explanation": "பொது அறிவு மற்றும் நடப்பு நிகழ்வு: இராமானுசரின் சமத்துவக் கொள்கைகளைப் போற்றும் வகையில் ஐதராபாத்தில் 216 அடி உயர \"சமத்துவச் சிலை\" (Statue of Equality) அமைக்கப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "What is the name of the colossal 216-feet statue erected near Hyderabad honoring Ramanuja's millennium birth anniversary?", "media_id": null}], "options": {"A": "Statue of Unity", "B": "Statue of Peace", "C": "Statue of Knowledge", "D": "Statue of Equality"}, "explanation": "The Statue of Equality commemorates Ramanuja's egalitarian contributions."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 186, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 186", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["இராமானுசர்", "சமத்துவச் சிலை", "பொது அறிவு"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u8-q105", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ramanujar", "chapter_id": null, "topic_id": "tnpsc_pyq_ramanujar_era", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC முந்தைய ஆண்டு வினா] இராமானுசர் வாழ்ந்த காலம் மற்றும் அவரது ஆயுட்காலம் குறித்து வரலாற்றாய்வாளர்கள் குறிப்பிடுவது யாது?", "media_id": null}], "options": {"A": "கி.பி. 11-ஆம் நூற்றாண்டு முதல் 12-ஆம் நூற்றாண்டு வரை (சுமார் 120 ஆண்டுகள் வாழ்ந்தார்)", "B": "கி.பி. 7-ஆம் நூற்றாண்டு (32 ஆண்டுகள்)", "C": "கி.பி. 9-ஆம் நூற்றாண்டு (50 ஆண்டுகள்)", "D": "கி.பி. 16-ஆம் நூற்றாண்டு (80 ஆண்டுகள்)"}, "explanation": "வரலாற்றுக் குறிப்பு: இராமானுசர் கி.பி. 1017 முதல் 1137 வரை சுமார் 120 ஆண்டுகள் வாழ்ந்து அரும்பணி ஆற்றினார்."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] What is historically documented regarding Ramanuja's life span and era?", "media_id": null}], "options": {"A": "11th to 12th century CE (lived for about 120 years: 1017 - 1137 CE)", "B": "7th century CE (32 years)", "C": "9th century CE (50 years)", "D": "16th century CE (80 years)"}, "explanation": "Ramanuja lived 120 years between 1017 and 1137 CE."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation",