{"id": "10th-u8-q135", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "paa_vagai", "chapter_id": null, "topic_id": "four_sounds_comparison", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாக்களையும் அவற்றின் ஓசைகளையும் சரியாகப் பொருத்துக:\nஅ) வெண்பா - 1. துள்ளலோசை\nஆ) ஆசிரியப்பா - 2. தூங்கலோசை\nஇ) கலிப்பா - 3. செப்பலோசை\nஈ) வஞ்சிப்பா - 4. அகவலோசை", "media_id": null}], "options": {"A": "அ-1, ஆ-2, இ-3, ஈ-4", "B": "அ-4, ஆ-3, இ-2, ஈ-1", "C": "அ-3, ஆ-4, இ-1, ஈ-2", "D": "அ-2, ஆ-1, இ-4, ஈ-3"}, "explanation": "சரியான பொருத்தம்: வெண்பா - செப்பலோசை; ஆசிரியப்பா - அகவலோசை; கலிப்பா - துள்ளலோசை; வஞ்சிப்பா - தூங்கலோசை."}, "en": {"blocks": [{"type": "text", "content": "Match poetic meters with their cadences: a) Venba - 1. Thullal b) Asiriyappa - 2. Thoongal c) Kalippa - 3. Seppal d) Vanjippa - 4. Agaval.", "media_id": null}], "options": {"A": "a-1, b-2, c-3, d-4", "B": "a-4, b-3, c-2, d-1", "C": "a-3, b-4, c-1, d-2", "D": "a-2, b-1, c-4, d-3"}, "explanation": "Correct match is a-3, b-4, c-1, d-2."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 187, "chapter": null, "section": null, "reference": "1