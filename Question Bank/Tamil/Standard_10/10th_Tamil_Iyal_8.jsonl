{"id": "10th-u8-q003", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sanga_ilakkiyatthil_aram", "chapter_id": null, "topic_id": "trade_ethics_pattinappalai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"கொள்வதூஉம் மிகைகொளாது கொடுப்பதூஉம் குறைகொடாது\" - என்று சங்க கால வணிகர்களின் நேர்மையான வணிக அறத்தைப் போற்றும் நூல் எது?", "media_id": null}], "options": {"A": "மதுரைக்காஞ்சி", "B": "முல்லைப்பாட்டு", "C": "பட்டினப்பாலை (கடியலூர் உருத்திரங்கண்ணனார்)", "D": "நெடுநல்வாடை"}, "explanation": "பட்டினப்பாலையில் புகார் நகரத்து வணிகர்கள் வாங்கும் போது கூடுதலாக வாங்காமலும், விற்கும் போது குறைத்துக் கொடுக்காமலும் நேர்மையாக வணிகம் செய்தனர் எனப் போற்றப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which classical work lauds the ethical integrity of Tamil merchants: \"Neither taking in excess nor selling in deficit\"?", "media_id": null}], "options": {"A": "Maduraikkanji", "B": "Mullaippaattu", "C": "Pattinappaalai (by Kadiyalur Uruthirankannanar)", "D": "Nedunalvaadai"}, "explanation": "Pattinappaalai celebrates the high commercial ethics of Sangam merchants."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "e