{"id": "10th-u8-q027", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "gnanam", "chapter_id": null, "topic_id": "ezhuthu_movement_poet", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி. சோ. வேணுகோபாலன் அவர்கள் எந்த நவீன இலக்கிய இயக்கத்தின் முதன்மைக் கவிஞர்களுள் ஒருவராகத் திகழ்ந்தார்?", "media_id": null}], "options": {"A": "மணிக்கொடி இயக்கம்", "B": "வானம்பாடி இயக்கம்", "C": "சி. சு. செல்லப்பாவின் \"எழுத்து\" இதழ் புதுக்கவிதை இயக்கம்", "D": "மறுமலர்ச்சி சங்கம்"}, "explanation": "பாடநூல் குறிப்பு: சி. சு. செல்லப்பாவின் \"எழுத்து\" இதழில் புதுக்கவிதைகள் எழுதித் தமிழ்ப் புதுக்கவிதை வளர்ச்சிக்குப் பெரும் பங்களிப்பு செய்தவர் தி. சோ. வேணுகோபாலன்."}, "en": {"blocks": [{"type": "text", "content": "Thi. So. Venugopalan emerged as a prominent pioneer of modern poetry through which epochal literary magazine?", "media_id": null}], "options": {"A": "Manikkodi", "B": "Vaanambaadi movement", "C": "Ci. Su. Chellappa's \"Ezhuthu\" modern poetry movement", "D": "Renaissance Guild"}, "explanation": "He was a prominent voice of the \"Ezhuthu\" new poetry movement."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025",