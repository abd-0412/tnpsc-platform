{"id": "10th-u8-q048", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "gnanam", "chapter_id": null, "topic_id": "dust_removal_as_discipline", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தூசிகளை அகற்றுவது என்பது ஒரு முறை மட்டும் செய்து முடிக்கும் செயலா? அல்லது தொடர் செயலா?", "media_id": null}], "options": {"A": "ஒருமுறை செய்தால் போதும்", "B": "செய்யவே கூடாத செயல்", "C": "தேவையற்ற வேலை", "D": "அன்றாடம் தூசிகள் படிவது போல, மனிதன் தன் மனதையும் அன்றாடம் விழிப்புணர்வோடு தூய்மைப்படுத்திக் கொண்டே இருக்க வேண்டிய தொடர் தவம்"}, "explanation": "தூசி மீண்டும் மீண்டும் படிவது போல, மனித மனதிலும் சோர்வும் கவலைகளும் வரக்கூடும்; அவற்றை விழிப்புணர்வோடு தொடர்ந்து நீக்கிக் கொண்டே இருக்க வேண்டும்."}, "en": {"blocks": [{"type": "text", "content": "Is the purging of mental dust a one-time act or an ongoing daily discipline of mindful living?", "media_id": null}], "options": {"A": "A single one-off act", "B": "Prohibited chore", "C": "Superfluous labor", "D": "Just as physical dust gathers daily, cleansing the mind of negativity requires constant, daily meditative mindfulness"}, "explanation": "Mental purification is an ongoing daily discipline of mindful awareness."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Tex