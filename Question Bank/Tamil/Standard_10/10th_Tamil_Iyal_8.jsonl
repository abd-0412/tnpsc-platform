{"id": "10th-u8-q044", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "gnanam", "chapter_id": null, "topic_id": "knowledge_as_liberation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிதையில் ஞானம் (மெய்யறிவு) பெறுவதன் மூலம் மனிதனுக்குக் கிட்டும் விடுதலை எது?", "media_id": null}], "options": {"A": "சிறையிலிருந்து வெளிவருதல்", "B": "கடனை அடைத்தல்", "C": "பணக்காரன் ஆகுதல்", "D": "மனக்கவலைகள், அறியாமை மற்றும் தேவையற்ற பயங்களிலிருந்து விடுதலை பெற்று மன அமைதி அடைதல்"}, "explanation": "உண்மையான மெய்யறிவு மனிதனை அவனது அகப் பயங்களிலிருந்தும் கவலைகளிலிருந்தும் விடுவித்து அமைதி நிலைக்கு இட்டுச் செல்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What true liberation is unlocked in human life through the attainment of Gnaanam?", "media_id": null}], "options": {"A": "Jailbreak", "B": "Debt cancellation", "C": "Monetary fortune", "D": "Liberation from existential dread, delusion, and anxiety, attaining profound tranquil serenity"}, "explanation": "Gnaanam delivers liberation from inner anxiety and existential dread."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 180, "chapter": nu