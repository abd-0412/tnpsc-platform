{"id": "10th-u8-q035", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "gnanam", "chapter_id": null, "topic_id": "poet_lifespan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் தி. சோ. வேணுகோபாலன் அவர்களின் வாழ்ந்த காலம் எது?", "media_id": null}], "options": {"A": "1900 - 1970", "B": "1910 - 1985", "C": "1929 - 2009", "D": "1935 - 2015"}, "explanation": "தி. சோ. வேணுகோபாலன் 1929-ஆம் ஆண்டு பிறந்து 2009-ஆம் ஆண்டு வரை வாழ்ந்தார் (1929 - 2009)."}, "en": {"blocks": [{"type": "text", "content": "What was the lifespan of poet Thi. So. Venugopalan?", "media_id": null}], "options": {"A": "1900 - 1970", "B": "1910 - 1985", "C": "1929 - 2009", "D": "1935 - 2015"}, "explanation": "His lifetime spanned between 1929 and 2009."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 181, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 181", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["ஞானம்", "தி. சோ. வேணுகோபா