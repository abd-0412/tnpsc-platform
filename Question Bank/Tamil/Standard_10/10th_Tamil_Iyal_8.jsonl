{"id": "10th-u8-q050", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "gnanam", "chapter_id": null, "topic_id": "poetic_beauty_of_gnanam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி. சோ. வேணுகோபாலனின் \"ஞானம்\" கவிதையை வாசிப்பவருக்கு ஏற்படும் உடனடி மனநிலை யாது?", "media_id": null}], "options": {"A": "கலக்கமும் பதற்றமும்", "B": "அமைதியும், சுமை குறைந்த லேசான மனநிலையும், புத்துணர்ச்சியும்", "C": "கோபமும் ஆத்திரமும்", "D": "தூக்கமின்மை"}, "explanation": "கவிதையை வாசிக்கும் போது வாசகனின் மனதில் உள்ள பாரங்கள் குறைந்து, ஒரு புதிய விடியலின் அமைதியும் தெளிவும் படர்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What immediate cathartic psychological state is experienced by a reader upon contemplating \"Gnaanam\"?", "media_id": null}], "options": {"A": "Anxiety and agitation", "B": "Tranquility, a lightened unburdened heart, and a refreshing sense of renewal", "C": "Wrath and fury", "D": "Insomnia"}, "explanation": "The reader experiences tranquil lightness and refreshing clarity."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 180, "chapter": null, "section": null, "referen