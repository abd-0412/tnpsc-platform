{"id": "10th-u8-q039", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "gnanam", "chapter_id": null, "topic_id": "gnana_malar_blossom", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிதையின் இறுதியில் வெளிப்படும் \"ஞானப் பூ விரிகிறது\" என்பது எத்தகைய ஆன்மிக அனுபவத்தை உணர்த்துகிறது?", "media_id": null}], "options": {"A": "தோட்டத்தில் பூ பூப்பது", "B": "ரோஜா மலர் வாங்குவது", "C": "அறியாமை இருள் விலகி, உள்ளத்தில் தெளிந்த பேரறிவு மலர்ந்து மனம் அமைதியும் நிறைவும் அடைதல்", "D": "பூ மாலை கட்டுவது"}, "explanation": "மனதின் தூசிகளைத் துடைத்து வெளிச்சத்தை வரவேற்கும் போது, உள்ளத்தில் பேரறிவு மலர்ந்து வாழ்வு மலர்ச்சியடைகிறது என்பதே \"ஞானப் பூ\" மலர்தலாகும்."}, "en": {"blocks": [{"type": "text", "content": "What sublime spiritual epiphany is crowned by the concluding image \"The flower of Gnaanam blossoms\"?", "media_id": null}], "options": {"A": "Physical garden blooming", "B": "Buying roses", "C": "The darkness of delusion dissolves, and the soul expands with radiant serenity and enlightened comprehension", "D": "Stringing a garland"}, "explanation": "The blooming of Gnaanam signifies the awakening of serene inner enlightenment."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Servic