{"id": "10th-u8-q070", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "kaalakkanitham", "chapter_id": null, "topic_id": "kannadasan_prose_works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கண்ணதாசனின் புகழ்பெற்ற ஆன்மிகத் தத்துவ உரைநடை நூல் எது?", "media_id": null}], "options": {"A": "ஆயிரம் தீவு அங்கயற்கண்ணி", "B": "அர்த்தமுள்ள இந்துமதம்", "C": "வேலங்குடித் திருவிழா", "D": "ராஜ தண்டனை"}, "explanation": "பாடநூல் மற்றும் பொதுத் தமிழ் குறிப்பு: கண்ணதாசனின் மிகச் சிறந்த தத்துவப் படைப்பாக பல தொகுதிகளாக வெளிவந்த நூல் \"அர்த்தமுள்ள இந்துமதம்\" ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which is Kannadasan's renowned multi-volume philosophical prose masterpiece?", "media_id": null}], "options": {"A": "Aayiram Theevu Angayarkanni", "B": "Arthamulla Indhumatham", "C": "Velangudi Thiruvizha", "D": "Raja Thandanai"}, "explanation": "Arthamulla Indhumatham is Kannadasan's famous philosophical magnum opus."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 183, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 183", "url": null, "source_notes": null}, "previ