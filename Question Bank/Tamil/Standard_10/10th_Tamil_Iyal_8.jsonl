{"id": "10th-u8-q103", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ramanujar", "chapter_id": null, "topic_id": "grammar_split_emperumanar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"எம்பெருமானார்\" என்னும் சொல்லைச் சரியாகப் பிரித்தெழுதும் முறை எது?", "media_id": null}], "options": {"A": "எம் + பெருமான் + ஆர்", "B": "எம்பெருமை + ஆனார்", "C": "எம் + பெருமானார் (எமது பெருமானார்)", "D": "எம்பிரான் + மானார்"}, "explanation": "இலக்கணக் குறிப்பு: எம் + பெருமான் + ஆர் (அல்லது எம் + பெருமானார்) = எம்பெருமானார் (எமது தலைவர் / பெருமைமிக்க பெருமான்)."}, "en": {"blocks": [{"type": "text", "content": "What is the grammatical breakdown of the honorific title \"Emperumaanaar\"?", "media_id": null}], "options": {"A": "Em + Perumaan + Aar", "B": "Emperumai + Aanaar", "C": "Em + Perumaanaar (Our revered Lord)", "D": "Embiraan + Maanaar"}, "explanation": "Em + Perumaanaar denotes \"Our revered Lord / Spiritual master\"."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 185, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 185", "url": null, "source_notes": null}, "prev