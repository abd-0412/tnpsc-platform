{"id": "10th-u8-q153", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "paa_vagai", "chapter_id": null, "topic_id": "thirukkural_seer_count_total", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறள் வெண்பாவில் அமைந்த திருக்குறள் ஒன்றில் உள்ள மொத்தச் சீர்களின் எண்ணிக்கை எத்தனை?", "media_id": null}], "options": {"A": "7 சீர்கள் (முதல் அடியில் 4 சீர், இரண்டாம் அடியில் 3 சீர்)", "B": "8 சீர்கள்", "C": "6 சீர்கள்", "D": "10 சீர்கள்"}, "explanation": "பாடநூல் குறிப்பு: குறள் வெண்பா முதலடியில் 4 சீர்களும், இரண்டாம் அடியில் 3 சீர்களுமாக மொத்தம் 7 சீர்களைக் கொண்டிருக்கும்."}, "en": {"blocks": [{"type": "text", "content": "What is the total number of metrical feet (Seer) in a Thirukkural couplet?", "media_id": null}], "options": {"A": "7 feet (4 in the first line, 3 in the second line)", "B": "8 feet", "C": "6 feet", "D": "10 feet"}, "explanation": "A Kural Venba has exactly 7 feet (4 in line 1, 3 in line 2)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 189, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 189", "url": null, "source_notes": null}, "previous_year":