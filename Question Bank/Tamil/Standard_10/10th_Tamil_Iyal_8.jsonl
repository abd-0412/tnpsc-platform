{"id": "10th-u8-q087", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ramanujar", "chapter_id": null, "topic_id": "walking_trips_count_18", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இராமானுசர் திருமந்திர உபதேசம் பெறுவதற்காக ஸ்ரீரங்கத்திலிருந்து திருக்கோட்டியூருக்கு எத்தனை முறை கால்நடையாக நடந்து சென்றார்?", "media_id": null}], "options": {"A": "12 முறை", "B": "15 முறை", "C": "18 முறை", "D": "24 முறை"}, "explanation": "பாடநூல் குறிப்பு: இராமானுசர் தனது குருவான திருக்கோட்டியூர் நம்பியிடம் உபதேசம் பெறுவதற்காக 18 முறை நடந்து சென்றார்."}, "en": {"blocks": [{"type": "text", "content": "How many times did Ramanuja walk on foot from Srirangam to Thirukkottiyur to receive initiation?", "media_id": null}], "options": {"A": "12 times", "B": "15 times", "C": "18 times", "D": "24 times"}, "explanation": "Ramanuja traveled 18 times on foot to Thirukkottiyur."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 184, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 184", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name"