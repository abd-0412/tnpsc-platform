{"id": "10th-u8-q137", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "paa_vagai", "chapter_id": null, "topic_id": "vendhalai_rules", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெண்பாவுக்குரிய வெண்டளையின் இலக்கண விதிகள் எவை?", "media_id": null}], "options": {"A": "மாமுன் நிரை, விளமுன் நேர் (இயற்சீர் வெண்டளை) மற்றும் காய்முன் நேர் (வெண்சீர் வெண்டளை)", "B": "மாமுன் நேர், விளமுன் நிரை", "C": "கனிமுன் நேர்", "D": "காய்முன் நிரை"}, "explanation": "பாடநூல் விதி: வெண்பாவில் \"மாமுன் நிரையும் விளமுன் நேரும்\" வருவது இயற்சீர் வெண்டளை; \"காய்முன் நேர்\" வருவது வெண்சீர் வெண்டளை எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What are the metrical linkage rules of Vendhalai governing Venba?", "media_id": null}], "options": {"A": "Maamun Nirai, Vilamun Ner (Iyarseer Vendhalai) & Kaaimun Ner (Venseer Vendhalai)", "B": "Maamun Ner, Vilamun Nirai", "C": "Kanimun Ner", "D": "Kaaimun Nirai"}, "explanation": "Vendhalai requires Maamun Nirai, Vilamun Ner, or Kaaimun Ner."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 188, "chapter": null, "section": null, "reference": "10th Tamil, Unit