{"id": "10th-u8-q051", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "gnanam", "chapter_id": null, "topic_id": "modern_tamil_poetic_tradition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தி. சோ. வேணுகோபாலன் அவர்களின் படைப்புகள் தமிழ்ப் புதுக்கவிதை உலகில் எத்தகைய தகுதியைப் பெற்றுள்ளன?", "media_id": null}], "options": {"A": "வெறும் வணிகப் பாடல்கள்", "B": "மேடைப் பேச்சுக்கள் மட்டுமே", "C": "அளவான சொற்களால் ஆழமான தத்துவ வாழ்வியலை உணர்த்தும் உயர்தர நவீன செவ்வியல் கவிதைகள்", "D": "மொழிபெயர்ப்புக் கதைகள்"}, "explanation": "குறைந்த சொற்கள், அடர்ந்த பொருள், ஆழமான தத்துவ அமைதி ஆகியவற்றால் இவரது கவிதைகள் புதுக்கவிதையின் மணிமகுடங்களாகப் போற்றப்படுகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What prestigious standing do Thi. So. Venugopalan's works occupy in modern Tamil poetry?", "media_id": null}], "options": {"A": "Mere commercial jingles", "B": "Oratorical slogans only", "C": "High modern classics characterized by sparse economical words and profound existential depth", "D": "Translated tales"}, "explanation": "His poems are regarded as high modern classics of sparse diction and profound depth."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation",