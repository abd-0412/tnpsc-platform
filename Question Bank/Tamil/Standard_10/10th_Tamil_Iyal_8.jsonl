{"id": "10th-u8-q016", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sanga_ilakkiyatthil_aram", "chapter_id": null, "topic_id": "ruler_must_listen_to_criticism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க காலத்தில் மன்னர்கள் புலவர்களின் எத்தகைய அறவுரைகளுக்கு தலைவணங்கி நின்றனர்?", "media_id": null}], "options": {"A": "மன்னனைப் புகழ்ந்து மட்டுமே பேசிய உரைகள்", "B": "பொய்ப் புகழுரைகள்", "C": "போருக்குத் தூண்டிய உரைகள்", "D": "மன்னன் நெறிதவறும் போது அவன் முகத்திற்கு நேராக இடித்துரைத்த கசப்பான நல்லற உரைகள்"}, "explanation": "சங்க கால மன்னர்கள் புலவர்களின் சுதந்திரமான இடித்துரைக்கும் அறவுரைகளை மதித்துத் தம் ஆட்சிப் பிழைகளைத் திருத்திக் கொண்டனர்."}, "en": {"blocks": [{"type": "text", "content": "What kind of fearless poetic counsel did Sangam monarchs reverently heed from court bards?", "media_id": null}], "options": {"A": "Sycophantic flattery only", "B": "False praises", "C": "Instigating unnecessary wars", "D": "Bitter, candid reproaches delivered straight to the king's face whenever royal governance swerved from justice"}, "explanation": "Monarchs bowed to candid ethical reprimands delivered by principled poets."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Ser