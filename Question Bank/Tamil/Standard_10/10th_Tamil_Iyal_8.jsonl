{"id": "10th-u8-q020", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sanga_ilakkiyatthil_aram", "chapter_id": null, "topic_id": "prose_summary_ethics", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "போந்தை பசுபதியின் \"சங்க இலக்கியத்தில் அறம்\" கட்டுரை உலக சமுதாயத்திற்கு உணர்த்தும் தலையாய பாடம் என்ன?", "media_id": null}], "options": {"A": "பழைய இலக்கியங்களை மறந்துவிட வேண்டும்", "B": "போர்கள் மட்டுமே உலகை ஆளும்", "C": "வணிகத்தில் நேர்மை தேவையில்லை", "D": "சங்க காலத் தமிழர் போற்றிய மனிதநேயம், வாய்மை, கொடை, போரறம், இயற்கை நேயம் ஆகிய விழுமியங்களே இன்றைய உலகிற்கும் வழிகாட்டும் கலங்கரை விளக்கம்"}, "explanation": "சங்க இலக்கியத்தின் அறநெறிகள் மனித சமுதாயத்தின் அமைதிக்கும் நல்வாழ்விற்கும் காலத்தால் அழியாத உயரிய வழிகாட்டிகளாக விளங்குகின்றன."}, "en": {"blocks": [{"type": "text", "content": "What enduring universal lesson is imparted by Pondhai Pasupathi's treatise on Sangam ethics?", "media_id": null}], "options": {"A": "Ancient literature is obsolete", "B": "Wars alone govern the world", "C": "Ethics are unnecessary in trade", "D": "The humanism, truthfulness, selfless charity, chivalry, and ecological reverence of Sangam Tamils remain timeless beacons for global civilization"}, "explanation": "Sangam ethics serve as a timeless moral compass for global civilization."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 179, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 179", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["சங்க இலக்கியத்தில் அறம்", "கட்டுரைச் சுருக்கம்", "உலக வழிகாட்டல்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u8-q021", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "gnanam", "chapter_id": null, "topic_id": "poet_name", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "10-ஆம் வகுப்பு இயல் 8 கவிதைப் பேழையில் இடம்பெற்றுள்ள \"ஞானம்\" என்னும் கவிதையை இயற்றியவர் யார்?", "media_id": null}], "options": {"A": "தி. சோ. வேணுகோபாலன்", "B": "கண்ணதாசன்", "C": "உமா மகேஸ்வரி", "D": "குலோத்துங்கன்"}, "explanation": "பாடநூல் குறிப்பு: \"ஞானம்\" என்னும் அழகிய தத்துவக் கவிதையைப் படைத்தவர் கவிஞர் தி. சோ. வேணுகோபாலன் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "Who is the author of the philosophical poem \"Gnaanam\" featured in Standard 10 Unit 8?", "media_id": null}], "options": {"A": "Thi. So. Venugopalan", "B": "Kannadasan", "C": "Uma Maheswari", "D": "Kulothungan"}, "explanation": "Thi. So. Venugopalan composed the contemplative poem Gnaanam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 180, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 180", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, 