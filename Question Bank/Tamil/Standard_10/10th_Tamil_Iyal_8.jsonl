{"id": "10th-u8-q034", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "gnanam", "chapter_id": null, "topic_id": "light_entering_symbolism", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிதையில் ஜன்னல் வழியே உள்ளே நுழையும் \"வெளிச்சம்\" எதனைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "மின் விளக்கு", "B": "அறியாமை இருளைப் போக்கும் புதிய அறிவு, தெளிவு மற்றும் நம்பிக்கை", "C": "சூரிய வெப்பம் மட்டுமே", "D": "நெருப்பு"}, "explanation": "வெளிச்சம் என்பது மனதிற்குள் மலரும் மெய்யறிவையும், வாழ்க்கையை எதிர்கொள்ளும் புதிய நம்பிக்கையையும் குறிக்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What does the \"Light\" entering through the opened casement symbolize?", "media_id": null}], "options": {"A": "Electric bulb", "B": "Fresh enlightenment, intellectual lucidity, and transformative hope banishing ignorance", "C": "Solar scorch solely", "D": "Fire hazard"}, "explanation": "Light symbolizes the transformative awakening of wisdom dispelling dark despair."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 180, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8