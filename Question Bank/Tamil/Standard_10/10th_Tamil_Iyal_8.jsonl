{"id": "10th-u8-q018", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "sanga_ilakkiyatthil_aram", "chapter_id": null, "topic_id": "nature_protection_ethics", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க காலத்தில் இயற்கை மீதும் மரங்கள் மீதும் காட்டிய பேரன்பிற்குச் சான்றாக நற்றிணையில் ஒரு தலைவி எதனைத் தன் \"உடன்பிறந்த சகோதரி\" என்று பாடுகிறாள்?", "media_id": null}], "options": {"A": "வாழை மரம்", "B": "புன்னை மரம் (தன் தாய் நட்டு வளர்த்த புன்னை மரம்)", "C": "மாமரம்", "D": "வேப்பமரம்"}, "explanation": "நற்றிணையில் தலைவி: \"தாயால் நட்டு வளர்க்கப்பட்ட இப்பூத்த புன்னை மரம் உனக்குத் தமக்கையாகும் (சகோதரி) என்று தாய் கூறியதால், இதன் முன் நிற்க நாணுகிறேன்\" எனப் பாடுகிறாள்."}, "en": {"blocks": [{"type": "text", "content": "In Natrinai, as a testament to profound ecological kinship, which tree is tenderly addressed by a heroine as her own elder sister?", "media_id": null}], "options": {"A": "Plantain tree", "B": "Punnai tree (Alexandrian laurel nursed by her mother)", "C": "Mango tree", "D": "Neem tree"}, "explanation": "The heroine considers the blossoming Punnai tree as her own elder sister."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 178, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 178", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["சங்க இலக்கியத்தில் அறம்", "இயற்கை அறம்", "புன்னை மரம் சகோதரி"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
