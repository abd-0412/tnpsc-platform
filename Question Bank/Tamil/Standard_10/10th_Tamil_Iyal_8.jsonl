{"id": "10th-u8-q102", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ramanujar", "chapter_id": null, "topic_id": "drama_event_dialogue", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நாடகத்தில், \"மக்கள் அனைவரும் கேட்குமாறு திருக்கோயில் கோபுரத்தின் உச்சியில் ஏறிய இராமானுசரின் செயல் எதைக் குறிக்கிறது?\"", "media_id": null}], "options": {"A": "அறிவை மறைத்து வைப்பது", "B": "ஆன்மிக விடுதலையும் முக்தி உரிமையும் அனைவருக்கும் பொதுவானது என்ற சமத்துவப் புரட்சி", "C": "கோயில் அழகை ரசிப்பது", "D": "அரசனை வரவேற்பது"}, "explanation": "பாடநூல் விளக்கம்: ஒரு சிலருக்கு மட்டுமே சொந்தமாக இருந்த ஆன்மிக உண்மைகளை அனைத்து மக்களுக்கும் கொண்டு சேர்த்த மாபெரும் சமத்துவப் புரட்சியின் குறியீடாகும்."}, "en": {"blocks": [{"type": "text", "content": "What did Ramanuja's act of ascending the temple tower to reveal spiritual wisdom symbolize?", "media_id": null}], "options": {"A": "Concealing knowledge", "B": "An egalitarian revolution affirming that spiritual liberation is a universal human right", "C": "Admiring temple architecture", "D": "Welcoming a king"}, "explanation": "An egalitarian revolution democratizing sacred wisdom for all humankind."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Servi