{"id": "10th-u8-q101", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ramanujar", "chapter_id": null, "topic_id": "nalayira_divya_prabandham_spread", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வைணவக் கோயில்களில் ஆழ்வார்களின் \"நாலாயிர திவ்வியப் பிரபந்தம்\" ஒலிக்கும்படி வழிபாட்டு நடைமுறையை முறைப்படுத்தியவர் யார்?", "media_id": null}], "options": {"A": "இராமானுசர்", "B": "நாதமுனிகள்", "C": "வேதாந்த தேசிகர்", "D": "பிள்ளை லோகாசாரியர்"}, "explanation": "பாடநூல் குறிப்பு: தமிழ் மறையான திவ்வியப் பிரபந்தக் கருத்துகளைக் கோயில்களில் நிலைநிறுத்தி \"திராவிட வேதம்\" என்று போற்றி வளர்த்தவர் இராமானுசர்."}, "en": {"blocks": [{"type": "text", "content": "Who standardized temple liturgies ensuring that the Tamil Nalayira Divya Prabandham was recited across shrines?", "media_id": null}], "options": {"A": "Ramanuja", "B": "Nathamunigal", "C": "Vedanta Desikar", "D": "Pillai Lokachariar"}, "explanation": "Ramanuja institutionalized the daily chanting of the Divya Prabandham."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 186, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Pa