{"id": "10th-u8-q151", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "paa_vagai", "chapter_id": null, "topic_id": "alagituthal_kaasu_example", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்கண்டவற்றுள் \"காசு\" (நேர்பு) என்னும் வாய்பாட்டுடன் முடியும் திருக்குறள் ஈற்றுச்சொல்லுக்குச் சரியான சான்று எது?", "media_id": null}], "options": {"A": "மலர்", "B": "அருள்", "C": "பற்று (பற்/று -> நேர் + உகரம் -> நேர்பு)", "D": "அறிவு"}, "explanation": "அலகிடுதல் விளக்கம்: பற்று = பற் (நேர்) + று (குற்றியலுகரம்) = நேர்பு = காசு என்னும் வாய்பாடு."}, "en": {"blocks": [{"type": "text", "content": "Which word exemplifies the \"Kaasu\" (Nerpu) formula as the terminal foot of a Kural?", "media_id": null}], "options": {"A": "Malar", "B": "Arul", "C": "Patru (Pat / ru -> Ner + u -> Nerpu)", "D": "Arivu"}, "explanation": "Patru splits into Ner + short \"u\", forming Nerpu / Kaasu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 189, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 189", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": nu