{"id": "10th-u8-q147", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "paa_vagai", "chapter_id": null, "topic_id": "venba_terminal_foot_formulas", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வெண்பாவின் இறுதிச் சீர் (ஈற்றுச் சீர்) ஓரசைச் சீராக முடியும் போது அமையும் நான்கு வாய்பாடுகள் எவை?", "media_id": null}], "options": {"A": "தேமா, புளிமா, கூவிளம், கருவிளம்", "B": "அகவல், செப்பல், துள்ளல், தூங்கல்", "C": "நாள் (நேர்), மலர் (நிரை), காசு (நேர்பு), பிறப்பு (நிரைபு)", "D": "குறளடி, சிந்தடி, அளவடி, நெடிலடி"}, "explanation": "பாடநூல் விதி: வெண்பாவின் ஈற்றுச் சீர் நாள், மலர், காசு, பிறப்பு என்னும் வாய்பாடுகளுள் ஒன்றைக் கொண்டு மட்டுமே முடியும்."}, "en": {"blocks": [{"type": "text", "content": "Which four formulas conclude the terminal foot of a Venba?", "media_id": null}], "options": {"A": "Thema, Pulima, Koovizham, Karuvizham", "B": "Agaval, Seppal, Thullal, Thoongal", "C": "Naal (Ner), Malar (Nirai), Kaasu (Nerpu), Pirappu (Niraipu)", "D": "Kuraladi, Sindhadhi, Alavadi, Nediladi"}, "explanation": "Terminal feet of Venba end exclusively in Naal, Malar, Kaasu, or Pirappu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year",