{"id": "10th-u8-q100", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_8", "lesson_id": "ramanujar", "chapter_id": null, "topic_id": "sanskrit_commentary_sribhashyam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இராமானுசர் பிரம்மசூத்திரத்திற்கு இயற்றிய புகழ்பெற்ற விரிவுரை உரைநூல் எது?", "media_id": null}], "options": {"A": "கீதா பாஷ்யம்", "B": "வேதார்த்த சங்கிரகம்", "C": "வேதாந்த தீபம்", "D": "ஸ்ரீபாஷ்யம்"}, "explanation": "கூடுதல் தேர்வுக்குறிப்பு: பிரம்மசூத்திரத்திற்கு இராமானுசர் அருளிய தலைசிறந்த உரை \"ஸ்ரீபாஷ்யம்\" ஆகும். இதனாலேயே இவர் \"பாஷ்யகாரர்\" என்றும் புகழப்படுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What is Ramanuja's monumental Sanskrit commentary on the Brahma Sutras?", "media_id": null}], "options": {"A": "Gita Bhashyam", "B": "Vedartha Sangraham", "C": "Vedanta Deepam", "D": "Sri Bhashyam"}, "explanation": "Sri Bhashyam is Ramanuja's magnum opus commentary on Brahma Sutras."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 186, "chapter": null, "section": null, "reference": "10th Tamil, Unit 8, Page 186", "url": null, "source_notes": null}, "previous_year": {"is_prev