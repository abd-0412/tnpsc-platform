{"id": "10th-u5-q013", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "need_for_translation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மொழிபெயர்ப்புக் கல்வி ஒரு மனிதனுக்கு எவ்வகையான சிந்தனைப் பெருக்கத்தை ஏற்படுத்துகிறது?", "media_id": null}], "options": {"A": "உலகளாவிய பரந்த அறிவு மற்றும் பண்பாட்டுப் புரிதல்", "B": "தனிமை விரும்புதல்", "C": "பிற நாட்டுப் பகையுணர்வு", "D": "பொருளாதார இழப்பு"}, "explanation": "மொழிபெயர்ப்பு மனிதர்களிடையே எல்லைகளைக் கடந்து உலகளாவிய பரந்த அறிவு, பரஸ்பர பண்பாட்டுப் புரிதல் மற்றும் சகோதரத்துவத்தை வளர்க்கிறது."}, "en": {"blocks": [{"type": "text", "content": "What core intellectual and humanistic advancement is fostered through translation education?", "media_id": null}], "options": {"A": "Global intellectual broadening and intercultural harmony", "B": "Isolationist tendencies", "C": "Xenophobia towards foreign cultures", "D": "Economic detriment"}, "explanation": "Translation broadens perspectives and bridges cultures worldwide."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 99, "chapter": null