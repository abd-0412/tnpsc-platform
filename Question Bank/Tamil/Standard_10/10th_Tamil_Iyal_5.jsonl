{"id": "10th-u5-q072", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "neethi_venba", "chapter_id": null, "topic_id": "padupadha_thiruthi", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"திருத்தி\" என்னும் வினையெச்சச் சொல்லைப் பகுபத உறுப்பிலக்கணப்படி பிரிக்கும் சரியான முறை எது?", "media_id": null}], "options": {"A": "திரு + த் + தி", "B": "திருத் + தி", "C": "திருத்து + த் + இ", "D": "திருத்து + இ"}, "explanation": "திருத்தி = திருத்து (பகுதி) + இ (வினையெச்ச விகுதி). உகரம் கெட்டு இகர வினையெச்சமாய் நின்றது."}, "en": {"blocks": [{"type": "text", "content": "What is the correct morphological parsing (Pagupadha Uruppilakkanam) for \"Thiruthi\"?", "media_id": null}], "options": {"A": "Thiru + th + thi", "B": "Thiruth + thi", "C": "Thiruthu + th + i", "D": "Thiruthu + i"}, "explanation": "Thiruthu (root) + i (adverbial participle suffix)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 103, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 103", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year