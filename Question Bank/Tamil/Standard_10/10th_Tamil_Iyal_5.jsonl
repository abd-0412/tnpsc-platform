{"id": "10th-u5-q095", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thiruviyaiyadal_puranam", "chapter_id": null, "topic_id": "poet_complaint_to_god", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இடைக்காடனார் இறைவனிடம் சென்று முறையிடும்போது, \"மன்னன் இகழ்ந்தது என்னை மட்டுமன்று; யாரையும் சேர்த்து இகழ்ந்தான்\" என்று உரைத்தார்?", "media_id": null}], "options": {"A": "மதுரை மக்களை மட்டுமே", "B": "அரசவை அமைச்சர்களை", "C": "தமிழையும், தமிழறிந்த இறைவனாகிய உன்னையுமே இகழ்ந்தான்", "D": "கபிலரை மட்டுமே"}, "explanation": "இடைக்காடனார் சிவபெருமானிடம்: \"சொக்கநாதனே! மன்னன் என்னை இகழவில்லை; உன்னையும், உன்னால் வளர்க்கப்பட்ட தமிழையுமே தலைவணங்காமல் இகழ்ந்தான்\" என்று முறையிட்டார்."}, "en": {"blocks": [{"type": "text", "content": "When Idaikkaadanar lamented before Lord Shiva in Madurai temple, what did he declare about the king's insolence?", "media_id": null}], "options": {"A": "The king insulted only the citizens", "B": "The king insulted his ministers", "C": "The king insulted not just me, but the Tamil language and You, the Tamil-knowing Divine Being", "D": "The king insulted Kabilar alone"}, "explanation": "He stated that disrespecting a true poet equates to insulting Tamil and the Divine Lord."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 107, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 107", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["திருவிளையாடற் புராணம்", "தமிழையும் இறைவனையும்", "முறையீடு"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u5-q096", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thiruviyaiyadal_puranam", "chapter_id": null, "topic_id": "god_relocated_where", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இடைக்காடனாருக்காக மதுரைக் கோவிலை விட்டு நீங்கிய இறைவன், வைகை ஆற்றின் தென்கரையில் எங்கு சென்று அமர்ந்தார்?", "media_id": null}], "options": {"A": "திருப்பரங்குன்றம்", "B": "திருவாலங்காடு", "C": "பழமுதிர்சோலை", "D": "வடதிரு ஆலவாய் (வைகை தென்கரைத் திருக்கோயில்)"}, "explanation": "இடைக்காடனாரின் மனவருத்தத்தைப் போக்க இறைவன் மதுரைத் திருக்கோயிலை விட்டு நீங்கி, வைகை ஆற்றின் தெற்கே உள்ள \"வடதிரு ஆலவாயில்\" எழுந்தருளினார்."}, "en": {"blocks": [{"type": "text", "content": "Where did Lord Shiva relocate upon departing the Madurai sanctum to demonstrate solidarity with Idaikkaadanar?", "media_id": null}], "options": {"A": "Tiruparankundram", "B": "Thiruvalangadu", "C": "Pazhamuthircholai", "D": "Vada Thiru Aalavai (on the south bank of Vaigai river)"}, "explanation": "Lord Shiva manifested in Vada Thiru Aalavai temple across the Vaigai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 107, "chapter"