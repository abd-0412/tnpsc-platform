{"id": "10th-u5-q138", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "puthiya_nambikkai", "chapter_id": null, "topic_id": "theme_of_education", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கமலாலயனின் \"புதிய நம்பிக்கை\" கதை உணர்த்தும் முதன்மையான செய்தி என்ன?", "media_id": null}], "options": {"A": "பணம் இருந்தால் மட்டுமே படிக்க முடியும்", "B": "கல்வி கற்பதற்கான தாகமும் விடாமுயற்சியும் இருந்தால் எந்தவொரு சமூக, பொருளாதாரத் தடைகளையும் தகர்த்து வெல்ல முடியும்", "C": "விவசாயம் செய்வதே சிறந்தது", "D": "வெளிநாட்டிற்குச் செல்வதே வெற்றி"}, "explanation": "எத்தகைய வறுமையிலும் சமூகப் புறக்கணிப்பிலும் வாழும் ஒருவரால் கல்வி ஒன்றின் துணை கொண்டு உலகமே போற்றும் தலைவராக உயர முடியும் என்பதை இக்கதை உணர்த்துகிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the primary moral takeaway of the story \"Puthiya Nambikkai\"?", "media_id": null}], "options": {"A": "Only wealth enables education", "B": "With an insatiable thirst for knowledge and perseverance, one can overcome all social and economic obstacles", "C": "Farming is the only pursuit", "D": "Emigrating abroad ensures success"}, "explanation": "Education coupled with resilience dismantles all barriers of oppression."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publishe