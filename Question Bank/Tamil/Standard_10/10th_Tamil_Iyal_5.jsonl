{"id": "10th-u5-q047", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "subramanya_bharathi_japan", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியார் தமது கட்டுரைகளில் ஜப்பான் நாட்டின் எவ்வகை இலக்கிய வளர்ச்சி குறித்து வியந்து பாராட்டியுள்ளார்?", "media_id": null}], "options": {"A": "ஜப்பானியக் காப்பியங்கள்", "B": "ஜப்பானிய நாடகங்கள்", "C": "மேலைநாட்டு அறிவியல் நூல்களைத் தம் தாய்மொழியான ஜப்பானிய மொழியில் உடனுக்குடன் மொழிபெயர்த்து வளர்ந்த வியத்தகு முன்னேற்றம்", "D": "ஜப்பானிய ஓவிய முறைகள்"}, "explanation": "பாரதியார் \"ஜப்பானியர்கள் மேலைநாட்டு அறிவியல் நூல்களைத் தங்கள் மொழியில் மொழிபெயர்த்துப் படித்துத்தான் குறுகிய காலத்தில் உலக வல்லரசாக உயர்ந்தனர்\" என்று தமிழருக்கு வழிகாட்டினார்."}, "en": {"blocks": [{"type": "text", "content": "What remarkable intellectual triumph of modern Japan did Mahakavi Bharathiyar praise in his essays, urging Tamils to emulate?", "media_id": null}], "options": {"A": "Japanese epic ballads", "B": "Japanese traditional plays", "C": "Rapid translation of Western scientific treatises into Japanese, enabling rapid global eminence", "D": "Japanese calligraphy traditions"}, "explanation": "Bharathiyar highlighted Japan's translation-driven technological ascension."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, 