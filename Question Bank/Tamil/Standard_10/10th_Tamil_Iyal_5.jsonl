{"id": "10th-u5-q027", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "chinese_translation_tamil", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சீனாவில் பல நூற்றாண்டுகளுக்கு முன்பே நிலவிய தமிழ் தொடர்புகளையும், அங்குள்ள சீனப் பல்கலைக்கழகங்களில் தமிழ் கற்பிக்கப்பட்டு வருவதையும் மெய்ப்பிக்கும் சான்றாக விளங்குவது எது?", "media_id": null}], "options": {"A": "அங்குள்ள தமிழ் அருங்காட்சியகம் மட்டுமே", "B": "பண்டைய சீன நாணயங்கள் மட்டுமே", "C": "சீன வானொலி தமிழ்ப் பிரிவு மற்றும் குப்லாய்கானின் சிவன் கோயில் கல்வெட்டு", "D": "திபெத்திய ஓலைச்சுவடிகள்"}, "explanation": "சீனாவில் குப்லாய்கான் காலத்தில் கட்டப்பட்ட சிவன் கோவில் கல்வெட்டும், தற்காலத்தில் இயங்கும் சீன வானொலியின் தமிழ்ப் பிரிவும் அரிய சான்றுகளாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which living institution stands as testimony to continuous modern and medieval Sino-Tamil scholarly exchange?", "media_id": null}], "options": {"A": "Isolated maritime museum", "B": "Ancient coins exclusively", "C": "China Radio International (Tamil Division) and Kublai Khan temple epigraphs", "D": "Tibetan palm leaves"}, "explanation": "China Radio International operates a prominent Tamil broadcast department."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_n