{"id": "10th-u5-q109", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thiruviyaiyadal_puranam", "chapter_id": null, "topic_id": "god_protects_tamil_scholars", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இடைக்காடன் பிணக்கு தீர்த்த படலம் உணர்த்தும் இறைக் கொள்கை மற்றும் தமிழின் சிறப்பு யாது?", "media_id": null}], "options": {"A": "இறைவன் புலவர்களையும் தூய தமிழையும் உயிரெனக் கருதி காப்பவன்", "B": "அரசர்களின் செருக்கை மட்டுமே இறைவன் ஆதரிப்பான்", "C": "செல்வமே முதன்மையானது", "D": "கோவில்கள் ஊருக்குத் தேவையற்றவை"}, "explanation": "சிவபெருமான் மதுரை மாநகரில் தமிழ்ச் சங்கப் பலகையிலிருந்து தமிழ் வளர்த்த இறைவனாகவும், தன் அடியாரான புலவர்களின் தன்மானத்தைக் காப்பவனாகவும் விளங்குகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What core theological insight regarding divine patronage of Tamil is epitomized by this episode?", "media_id": null}], "options": {"A": "The Divine Lord ardently champions true poets and holds the Tamil language as His own essence", "B": "The Almighty favors monarchical arrogance", "C": "Material wealth is supreme", "D": "Temples are superfluous"}, "explanation": "God acts as the ultimate protector of poets and the Tamil language."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 107, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 107", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["திருவிளையாடற் புராணம்", "தமிழ்க் காப்பவன்", "இறைவன் சிறப்பு"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u5-q110", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thiruviyaiyadal_puranam", "chapter_id": null, "topic_id": "sangam_palagai_connection", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இறைவன் மதுரையில் இடைக்காடனாருக்கு ஆதரவாகச் செயல்பட்ட நிகழ்வு, மதுரையில் பாண்டியர்கள் காலத்துப் புலவர்களை ஆதரித்த எந்த வரலாற்று அமைப்போடு தொடர்புடையது?", "media_id": null}], "options": {"A": "நாலங்காடி", "B": "மதுரைத் தமிழ்ச் சங்கம் (சங்கப் பலகை)", "C": "அல்லங்காடி", "D": "மணிமேகலா மன்றம்"}, "explanation": "இறைவனே புலவராக வந்து தருமிக்குப் பொற்கிழி அளித்ததும், நக்கீரருடன் வாதிட்டதும், இடைக்காடனாருக்காக வடதிரு ஆலவாய் சென்றதும் மதுரைத் தமிழ்ச் சங்க வரலாற்றோடு பிணைந்த நிகழ்வுகளாகும்."}, "en": {"blocks": [{"type": "text", "content": "With which venerable historic institution patronized by Pandya rulers in Madurai is this divine narrative intertwined?", "media_id": null}], "options": {"A": "Naalangadi", "B": "Madurai Tamil Sangam (Sangam Board of Poets)", "C": "Allangadi", "D": "Manimekalai Assembly"}, "explanation": "It is deeply linked with the lore of the Madurai Tamil Sangam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 107, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 107", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["திருவிளையாடற் புராணம்", "தமிழ்ச் சங்கம்", "சங்கப் பலகை"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u5-q111", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thiruviyaiyadal_puranam", "chapter_id": null, "topic_id": "poet_reconciliation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாண்டிய மன்னன் தக்க மரியாதை செய்தவுடன் இடைக்காடனார் எத்தகைய மனநிலையைப் பெற்றார்?", "media_id": null}], "options": {"A": "மேலும் கோபமுற்றார்", "B": "நாட்டை விட்டு வெளியேறினார்", "C": "சினம் தணிந்து மன்னனை வாழ்த்தி மகிழ்ந்தார்", "D": "மன்னனைப் போருக்கு அழைத்தார்"}, "explanation": "மன்னன் தன் தவறை உணர்ந்து திருந்தியதும், புலவர் இடைக்காடனார் தன் சினம் தணிந்து, மன்னனின் தமிழ்ப் பற்றைப் பாராட்டி மனநிறைவடைந்தார்."}, "en": {"blocks": [{"type": "text", "content": "What emotional transformation did poet Idaikkaadanar undergo following the king's profound remorse and veneration?", "media_id": null}], "options": {"A": "His anger flared up further", "B": "He abandoned the kingdom", "C": "His wrath subsided, and he generously blessed the repentant king with joy", "D": "He challenged the king to duel"}, "explanation": "His righteous fury dissipated into generous blessings."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "