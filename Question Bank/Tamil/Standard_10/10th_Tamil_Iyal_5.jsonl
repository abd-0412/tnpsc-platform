{"id": "10th-u5-q028", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "translation_knowledge_window", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"மொழிபெயர்ப்பு என்பது பிறமொழி அறிவை நமக்குத் தரும் பலகணி (ஜன்னல்) போன்றது\" - இக்கூற்று உணர்த்தும் மையக் கருத்து என்ன?", "media_id": null}], "options": {"A": "மொழிபெயர்ப்பு தேவையில்லாத ஒன்று", "B": "மொழிபெயர்ப்பு சொந்த மொழியை அழித்துவிடும்", "C": "மொழிபெயர்ப்பால் பழமை மட்டுமே காக்கப்படும்", "D": "மொழிபெயர்ப்பு உலகின் புதிய அறிவையும் சிந்தனைகளையும் நம் மொழிக்குக் கொண்டு வந்து சேர்க்கும் திறவுகோல்"}, "explanation": "மொழிபெயர்ப்பு உலகளாவிய புதிய சிந்தனைகளையும் அறிவியல் கண்டுபிடிப்புகளையும் நமது மொழிக்குள் கொண்டுவரும் அறிவுப் பலகணியாக விளங்குகிறது."}, "en": {"blocks": [{"type": "text", "content": "What core truth is captured by the metaphor: \"Translation is a window opening into the intellectual landscape of other tongues\"?", "media_id": null}], "options": {"A": "Translation is superfluous", "B": "Translation destroys native identity", "C": "Translation only preserves antiquity", "D": "Translation is the gateway bringing cutting-edge global ideas and insights into our mother tongue"}, "explanation": "Translation serves as an intellectual gateway to universal human knowledge."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0,