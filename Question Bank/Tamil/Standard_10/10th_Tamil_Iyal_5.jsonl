{"id": "10th-u5-q046", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "translation_as_bridge", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"மொழிபெயர்ப்பு இல்லை எனில் உலகத்தில் மனித நாகரிகப் பரிமாற்றமே முடங்கிப் போயிருக்கும்\" - இக்கருத்தின்படி மொழிபெயர்ப்பின் சமூகப் பங்கு யாது?", "media_id": null}], "options": {"A": "மொழிகளுக்கிடையே போட்டியை உருவாக்குவது", "B": "பண்பாட்டுத் தடைகளை உடைத்து மானுட ஒற்றுமையையும் நாகரிக வளர்ச்சியையும் முன்னெடுப்பது", "C": "அனைத்து மொழிகளையும் ஒரே மொழியாக மாற்றுவது", "D": "வரலாற்றை மறக்கடிப்பது"}, "explanation": "மொழிபெயர்ப்பு மனித சமுதாயத்தின் பண்பாட்டு எல்லைகளை இணைத்து மானுட வளர்ச்சிக்கும் அமைதிக்கும் வித்திடுகிறது."}, "en": {"blocks": [{"type": "text", "content": "According to cultural historians, what fundamental social role is fulfilled by translation across human epochs?", "media_id": null}], "options": {"A": "Fomenting linguistic conflicts", "B": "Dismantling cultural barriers and advancing human solidarity and civilizational growth", "C": "Homogenizing all tongues into a single monolith", "D": "Erasing regional history"}, "explanation": "Translation dissolves insularity and propels universal civilizational progress."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "boo