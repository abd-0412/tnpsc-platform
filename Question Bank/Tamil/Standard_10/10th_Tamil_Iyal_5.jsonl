{"id": "10th-u5-q005", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "geetanjali_nobel", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ரவீந்திரநாத் தாகூர் வங்க மொழியில் எழுதிய \"கீதாஞ்சலி\" கவிதைத் தொகுப்பு, எந்த மொழியில் மொழிபெயர்க்கப்பட்ட பின்னர் அவருக்கு 1913-இல் இலக்கியத்திற்கான நோபல் பரிசைப் பெற்றுத் தந்தது?", "media_id": null}], "options": {"A": "ஆங்கில மொழி (English)", "B": "பிரெஞ்சு மொழி (French)", "C": "ஜெர்மன் மொழி (German)", "D": "இலத்தீன் மொழி (Latin)"}, "explanation": "தாகூர் தாமே வங்க மொழியிலிருந்து ஆங்கிலத்தில் \"Song Offerings\" என மொழிபெயர்த்த பிறகே கீதாஞ்சலிக்கு உலகளாவிய ஏற்பும் 1913-ஆம் ஆண்டின் இலக்கிய நோபல் பரிசும் கிடைத்தது."}, "en": {"blocks": [{"type": "text", "content": "Rabindranath Tagore won the 1913 Nobel Prize in Literature only after his Bengali \"Gitanjali\" was translated into which language?", "media_id": null}], "options": {"A": "English language", "B": "French language", "C": "German language", "D": "Latin language"}, "explanation": "Tagore translated Gitanjali into English himself, captivating the global audience."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporat