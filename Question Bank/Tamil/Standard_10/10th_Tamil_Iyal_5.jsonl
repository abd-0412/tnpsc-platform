{"id": "10th-u5-q040", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "kural_world_reputation", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறள் இதுவரை உலக மொழிகள் எத்தனைக்கும் மேற்பட்டவற்றில் மொழிபெயர்க்கப்பட்டு உலகப் பொதுமறையாகப் போற்றப்படுகிறது?", "media_id": null}], "options": {"A": "50 மொழிகள்", "B": "75 மொழிகள்", "C": "80 மொழிகள்", "D": "100-க்கும் மேற்பட்ட மொழிகள் (107-க்கும் மேல்)"}, "explanation": "திருக்குறள் ஆங்கிலம், இலத்தீன், ஜெர்மன், பிரெஞ்சு, சீனம், உருசியம் உள்ளிட்ட 100-க்கும் மேற்பட்ட உலக மொழிகளில் மொழிபெயர்க்கப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "Thirukkural has been translated into more than how many languages globally, cementing its stature as universal scripture?", "media_id": null}], "options": {"A": "50 languages", "B": "75 languages", "C": "80 languages", "D": "More than 100 languages (over 107)"}, "explanation": "Thirukkural has been translated into over 100 world languages."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 101, "chapter": null, "section": null, "referen