{"id": "10th-u5-q031", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "idiom_translation_challenge", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆங்கில மரபுத்தொடரான \"It is raining cats and dogs\" என்பதைத் தமிழில் எவ்வாறு மொழிபெயர்ப்பதே சரியான மொழிபெயர்ப்புச் செம்மையாகும்?", "media_id": null}], "options": {"A": "பூனைகளும் நாய்களும் மழையாகப் பொழிகின்றன", "B": "நாயும் பூனையும் மழையில் நனைகின்றன", "C": "மழை அடைமழையாகக் கொட்டித் தீர்க்கிறது (கனமழை பெய்கிறது)", "D": "மழையில் விலங்குகள் ஓடுகின்றன"}, "explanation": "ஆங்கில மரபுத்தொடரை (Idiom) அப்படியே நேரடிப் பொருளில் மொழிபெயர்க்காமல், தமிழின் மரபுக்கேற்ப \"கனமழை பெய்கிறது / அடைமழை பெய்கிறது\" என மொழிபெயர்ப்பதே செம்மையாகும்."}, "en": {"blocks": [{"type": "text", "content": "How should the English idiom \"It is raining cats and dogs\" be translated into Tamil with idiomatic precision?", "media_id": null}], "options": {"A": "Cats and dogs are falling from the sky", "B": "Dogs and cats get soaked", "C": "Mazhai adaimazhaiyaaga peigirathu (It is raining torrential downpour)", "D": "Animals are running in the rain"}, "explanation": "Idioms cannot be literally translated; equivalent target expressions must be chosen."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "b