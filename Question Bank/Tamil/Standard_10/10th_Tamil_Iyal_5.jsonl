{"id": "10th-u5-q084", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "neethi_venba", "chapter_id": null, "topic_id": "chapter_summary", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கா. ப. செய்குதம்பிப் பாவலரின் நீதி வெண்பா உணர்த்தும் தலையாய வாழ்வியல் செய்தி யாது?", "media_id": null}], "options": {"A": "செல்வத்தைச் சேமிக்க வேண்டும்", "B": "வெளிநாடுகளுக்குச் சென்று வாழ வேண்டும்", "C": "போர்க்கலைகளைக் கற்க வேண்டும்", "D": "அறியாமையைப் போக்கி, அருளையும் அறிவையும் பெருக்கி உயிருக்குத் துணையாய் இன்பம் தரும் கல்வியை நெஞ்சாரப் போற்றிக் கற்க வேண்டும்"}, "explanation": "கல்வி மட்டுமே மனிதனை அறியாமையிலிருந்து விடுவித்து, அருளையும் அறிவையும் பெருக்கி நிலைத்த இன்பத்தை வழங்கும் என்பதே இப்பாடலின் சாரமாகும்."}, "en": {"blocks": [{"type": "text", "content": "What is the core philosophical message delivered by Seikuthambi Paavalar's Neethi Venba?", "media_id": null}], "options": {"A": "Amassing bullion", "B": "Migrating permanently", "C": "Studying warfare techniques", "D": "Cherishing and pursuing education which dispels ignorance, fosters grace and intellect, and guides the soul with joy"}, "explanation": "Education is the supreme beacon dispelling ignorance and enriching grace."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publi