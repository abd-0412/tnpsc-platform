{"id": "10th-u5-q142", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "porulkol_vagaigal", "chapter_id": null, "topic_id": "aatruneer_porulkol", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடலின் தொடக்கம் முதல் முடிவு வரை ஆற்றுநீரின் போக்கைப் போல நேராகவே பொருள் கொள்ளும் முறை எவ்வகைப் பொருள்கோள் ஆகும்?", "media_id": null}], "options": {"A": "நிரல்நிறைப் பொருள்கோள்", "B": "ஆற்றுநீர்ப் பொருள்கோள்", "C": "கொண்டு கூட்டுப் பொருள்கோள்", "D": "அடிமறிமாற்றுப் பொருள்கோள்"}, "explanation": "ஆற்றுநீரின் தடையற்ற ஓட்டம் போலச் சொற்கள் முன்பின் மாறாமல் நேராகப் பொருள் தரும் பொருள்கோள் \"ஆற்றுநீர்ப் பொருள்கோள்\" ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Construing the meaning of a poem straight from beginning to end like the unidirectional flow of river water is:", "media_id": null}], "options": {"A": "Niralnirai Porulkol", "B": "Aatruneer Porulkol (River-flow construal)", "C": "Kondu kootu Porulkol", "D": "Adimarimaatru Porulkol"}, "explanation": "Aatruneer Porulkol signifies straightforward semantic progression like running water."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 