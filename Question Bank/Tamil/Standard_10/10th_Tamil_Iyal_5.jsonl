{"id": "10th-u5-q074", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "neethi_venba", "chapter_id": null, "topic_id": "poem_benefits_of_education", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நீதி வெண்பா பாடலில் செய்குதம்பிப் பாவலர் கல்வி மனிதனுக்குத் தரும் நான்கு பெரும் பேறுகளாகக் குறிப்பிடுபவை எவை?", "media_id": null}], "options": {"A": "செல்வம், புகழ், வலிமை, வீரம்", "B": "அருளைப் பெருக்குதல், அறிவைச் சீராக்குதல், அறியாமையை அகற்றுதல், அறிவுக்குத் தெளிவு தந்து இன்பம் அளித்தல்", "C": "அரசுப் பதவி, நிலம், வாகனம், ஆடை", "D": "பகைவரை வெல்லுதல், போர் புரிதல், வேட்டையாடுதல், தூங்குதல்"}, "explanation": "பாடல் அடிகள்: அருளைப் பெருக்கும்; அறிவைத் திருத்தும்; மருளை (மயக்கத்தை) அகற்றும்; அறிவுக்குத் தெளிவைத் தந்து உயிருக்குத் துணையாய் நின்று இன்பம் தரும்."}, "en": {"blocks": [{"type": "text", "content": "What four cardinal blessings of education are cataloged by Seikuthambi Paavalar in Neethi Venba?", "media_id": null}], "options": {"A": "Wealth, Fame, Strength, Valour", "B": "Augmenting grace, refining intellect, expelling ignorance, and imparting lucid wisdom with bliss", "C": "Royal posts, lands, carriages, robes", "D": "Warfare, defeating foes, hunting, slumber"}, "explanation": "Education expands grace, rectifies mind, dispels ignorance, and bestows joy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answ