{"id": "10th-u5-q021", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "translation_definition_muthu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"மொழிபெயர்த்தல் என்பது ஒரு மொழியின் வடிவத்தை மாற்றி மற்றொரு மொழிக்கு ஏற்ற வகையில் கருத்துச் சிதையாமல் மாற்றுவதாகும்\" - மொழிபெயர்ப்பின் அடிப்படை விதி என்ன?", "media_id": null}], "options": {"A": "மூல மொழியின் கருத்துச் சிதையாமல் பெறுமொழிக்கு ஏற்பப் பண்பாட்டுடன் பெயர்த்தல்", "B": "சொல்லுக்குச் சொல் நேரடிப் பொருள் மட்டும் தருதல்", "C": "மூல நூலின் கருத்தை மாற்றி எழுதுதல்", "D": "நீளத்தைக் குறைத்துச் சுருக்குவது மட்டுமே"}, "explanation": "மொழிபெயர்ப்பில் மூலத்தின் உட்கருத்து எவ்வகையிலும் சிதையாமல், ஏற்கும் மொழி இயல்புக்கும் இலக்கணப் பண்பாட்டிற்கும் ஏற்ப அமைப்பதே அடிப்படை விதியாகும்."}, "en": {"blocks": [{"type": "text", "content": "What constitutes the cardinal tenet of faithful literary and semantic translation?", "media_id": null}], "options": {"A": "Preserving the original intent without distortion while adapting naturally to the target language", "B": "Mechanical word-for-word literal substitution", "C": "Arbitrarily changing authorial intent", "D": "Condensing text drastically"}, "explanation": "Translation must preserve fidelity to source meaning while suiting target idiom."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 