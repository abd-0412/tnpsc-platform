{"id": "10th-u5-q058", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "neethi_venba", "chapter_id": null, "topic_id": "sathavadhanam_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"சதாவதானம்\" என்னும் சொல்லில் \"சதம்\" என்பது குறிக்கும் எண் எது?", "media_id": null}], "options": {"A": "பத்து (10)", "B": "நூறு (100)", "C": "ஆயிரம் (1000)", "D": "ஐம்பது (50)"}, "explanation": "\"சதம்\" என்றால் வடமொழியில் \"நூறு\" என்று பொருள். ஒரே நேரத்தில் நிகழ்த்தப்படும் நூறு வெவ்வேறு செயல்களையும் நினைவில் கொண்டு விடையளிக்கும் நினைவாற்றல் கலை \"சதாவதானம்\" எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "In the compound term \"Sathavadhanam\", what number does the root \"Satham\" represent?", "media_id": null}], "options": {"A": "Ten (10)", "B": "One Hundred (100)", "C": "One Thousand (1000)", "D": "Fifty (50)"}, "explanation": "Satham denotes 100, signifying the phenomenal capacity to attend to 100 simultaneous tasks."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 104, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 104", "url": null, "source_notes":