{"id": "10th-u5-q004", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "bharathi_quote_directions", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"சென்றிடுவீர் எட்டுத் திக்கும் - கலைச் செல்வங்கள் யாவும் கொணர்ந்து இங்கு சேர்ப்பீர்\" என்று உலக அறிவை நோக்கித் தமிழ் மக்களை அழைத்தவர் யார்?", "media_id": null}], "options": {"A": "வாணிதாசன்", "B": "சுரதா", "C": "கண்ணதாசன்", "D": "மகாகவி பாரதியார்"}, "explanation": "பாரதியார் உலகெங்கும் உள்ள கலைச் செல்வங்களைத் தமிழ்நாட்டுக்குக் கொண்டுவர வேண்டும் என்பதை \"சென்றிடுவீர் எட்டுத் திக்கும்...\" என்ற கவிதை வரிகள் மூலம் உணர்த்தினார்."}, "en": {"blocks": [{"type": "text", "content": "Who gave the clarion call: \"Go forth in all eight directions, and gather all treasures of knowledge and art here\"?", "media_id": null}], "options": {"A": "Vanidasan", "B": "Suratha", "C": "Kannadasan", "D": "Mahakavi Bharathiyar"}, "explanation": "Mahakavi Bharathiyar gave this inspirational call for knowledge assimilation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 99, "chapter": null, "section": null, "ref