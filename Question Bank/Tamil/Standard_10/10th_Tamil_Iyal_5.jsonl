{"id": "10th-u5-q033", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "translation_multi_benefits", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மொழிபெயர்ப்புக் கல்வியால் விளையும் நன்மைகளுள் பொருந்தாத ஒன்றைக் கண்டறிக:", "media_id": null}], "options": {"A": "சொந்த மொழியின் தனித்தன்மையும் இலக்கிய வளமும் முற்றிலும் குறைந்துவிடும்", "B": "பல்வேறு நாட்டுப் பண்பாடுகளையும் வாழ்க்கை முறைகளையும் அறிந்துகொள்ள முடிகிறது", "C": "உலகத் தரம் வாய்ந்த அறிவியல் மற்றும் மருத்துவ அறிவை எளிதில் பெற முடிகிறது", "D": "பன்னாட்டுத் தொடர்புகளும் பொருளாதார வர்த்தகமும் எளிதாகின்றன"}, "explanation": "மொழிபெயர்ப்பால் சொந்த மொழி வளர்ச்சி அடையுமே தவிர, அதன் தனித்தன்மையும் வளமும் ஒருபோதும் குறையாது. எனவே கூற்று (A) பொருந்தாத தவறான கூற்றாகும்."}, "en": {"blocks": [{"type": "text", "content": "Identify the INCORRECT statement regarding the multifaceted benefits of translation education:", "media_id": null}], "options": {"A": "The mother tongue completely loses its unique identity and literary heritage", "B": "It enables learning diverse world cultures and lifestyles", "C": "It grants accessible entry to advanced global science and medical insights", "D": "It facilitates cross-border relations and international economic trade"}, "explanation": "Translation enriches rather than diminishes native literary vigor."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negati