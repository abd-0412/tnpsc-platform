{"id": "10th-u5-q029", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "translation_precision_semmai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மொழிபெயர்ப்பில் \"செம்மை\" (Accuracy & Precision) என்பது எதைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "மூல மொழியின் சொல்லாட்சியும் பொருளும் பிழையின்றி, ஏற்கும் மொழியின் பண்பாட்டு மரபுக்கு ஏற்ப அமைவது", "B": "எழுத்துக்கூட்டிப் படிப்பது மட்டுமே", "C": "தமக்கேற்றவாறு புதிய கதையை உருவாக்குவது", "D": "அனைத்துச் சொற்களையும் ஆங்கிலத்திலேயே வைத்திருப்பது"}, "explanation": "மொழிபெயர்ப்புச் செம்மை என்பது மூலநூலின் உட்பொருளும் உணர்வும் சிதையாமல், ஏற்கும் மொழி இயல்புக்கேற்ப நேர்த்தியாகச் சொல்வதாகும்."}, "en": {"blocks": [{"type": "text", "content": "What does \"Translation Precision\" (Mozhipeyarppu Semmai) signify in professional translation ethics?", "media_id": null}], "options": {"A": "Preserving accurate source semantics while conforming naturally to the target cultural and grammatical idiom", "B": "Mere mechanical syllable pronunciation", "C": "Inventing an unrelated storyline", "D": "Retaining all foreign words untranslated"}, "explanation": "Semmai implies high fidelity of content with natural idiomatic expression."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type