{"id": "10th-u5-q131", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "vidai_vagaigal", "chapter_id": null, "topic_id": "vina_yethir_vinaathal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"என்னுடன் ஊருக்கு வருவாயா?\" என்று கேட்டதற்கு \"வராமல் இருப்பேனோ?\" என்று வினாவையே விடையாகக் கூறுவது எவ்வகை விடை?", "media_id": null}], "options": {"A": "மறை விடை", "B": "உற்றது உரைத்தல் விடை", "C": "வினா எதிர் வினாதல் விடை", "D": "உறுவது கூறல் விடை"}, "explanation": "ஒரு வினாவிற்கு விடையாக மற்றொரு வினாவையே திருப்பிக் கேட்பது \"வினா எதிர் வினாதல் விடை\" ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Replying \"Would I refrain from coming?\" to the invitation \"Will you come with me?\" is:", "media_id": null}], "options": {"A": "Marai vidai", "B": "Uttrathu uraithal vidai", "C": "Vina Yethir Vinaathal Vidai (Responding with a counter-question)", "D": "Uruvathu kooral vidai"}, "explanation": "Responding with an emphatic counter-question is Vina Yethir Vinaathal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 116, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 116", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["இலக்கணம்", "வினா எதிர் வினாதல்", "வராமல் இருப்பேனோ"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u5-q132", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "vidai_vagaigal", "chapter_id": null, "topic_id": "uttrathu_uraithal", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"நீ விளையாடவில்லையா?\" என்று கேட்டதற்கு \"எனக்குக் கால் வலிக்கிறது\" எனத் தனக்கு நேர்ந்ததை விடையாகக் கூறுவது எவ்வகை விடை?", "media_id": null}], "options": {"A": "உறுவது கூறல் விடை", "B": "இனமொழி விடை", "C": "ஏவல் விடை", "D": "உற்றது உரைத்தல் விடை"}, "explanation": "தனக்கு ஏற்கனவே உற்றதை (நிகழ்ந்த துன்பத்தை) விடையாகக் கூறுவது \"உற்றது உரைத்தல் விடை\" ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Replying \"My leg hurts\" (presently suffering pain) to \"Won't you play?\" exemplifies:", "media_id": null}], "options": {"A": "Uruvathu kooral vidai", "B": "Inamozhi vidai", "C": "Eeval vidai", "D": "Uttrathu Uraithal Vidai (Stating that which has afflicted oneself)"}, "explanation": "Stating one's present ailment as the reason is Uttrathu Uraithal Vidai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 116, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 116", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["இலக்கணம்", "உற்றது உரைத்தல்", "கால் வலிக்கிறது"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u5-q133", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "vidai_vagaigal", "chapter_id": null, "topic_id": "uruvathu_kooral", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"நீ விளையாட வருகிறாயா?\" என்று கேட்டதற்கு \"விளையாடினால் கால் வலிக்கும்\" என இனிமேல் நேரப்போவதை விடையாகக் கூறுவது எவ்வகை விடை?", "media_id": null}], "options": {"A": "உறுவது கூறல் விடை (இனி நிகழப்போவதை உரைத்தல்)", "B": "உற்றது உரைத்தல் விடை", "C": "இனமொழி விடை", "D": "சுட்டு விடை"}, "explanation": "தனக்கு எதிர்காலத்தில் நேரக்கூடியதை (உறுவதை) விடையாகக் கூறுவது \"உறுவது கூறல் விடை\" ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Replying \"My leg will ache\" (anticipating future consequence) when invited to play is:", "media_id": null}], "options": {"A": "Uruvathu Kooral Vidai (Stating that which will befall in the future)", "B": "Uttrathu uraithal vidai", "C": "Inamozhi vidai", "D": "Suttu vidai"}, "explanation": "Predicting future distress as reason for refusal is Uruvathu Kooral."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 116, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 116", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["இலக்கணம்", "உறுவது கூறல்", "கால் வலிக்கும்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u5-q134", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "vidai_vagaigal", "chapter_id": null, "topic_id": "inamozhi_vidai_example", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"உனக்குக் கதை எழுதத் தெரியுமா?\" என்ற வினாவிற்கு \"எனக்குக் கவிதை எழுதத் தெரியும்\" என்று அதற்கு இனமான மற்றொன்றை விடையாகக் கூறுவது எவ்வகை விடை?", "media_id": null}], "options": {"A": "ஏவல் விடை", "B": "இனமொழி விடை", "C": "மறை விடை", "D": "சுட்டு விடை"}, "explanation": "வினவப்பட்ட பொருளுக்கு இனமான மற்றொரு பொருளை விடையாகக் கூறுவது \"இனமொழி விடை\" ஆகும் (எ.கா: ஆடத் தெரியுமா என்பதற்குப் பாடத் தெரியும் எனல்)."}, "en": {"blocks": [{"type": "text", "content": "Replying \"I know how to write poetry\" when asked \"Do you know how to write stories?\" exemplifies:", "media_id": null}], "options": {"A": "Eeval vidai", "B": "Inamozhi Vidai (Replying with an allied/cognate genre)", "C": "Marai vidai", "D": "Suttu vidai"}, "explanation": "Offering an allied activity instead of directly addressing the specific query is Inamozhi Vidai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 116, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 116", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["இலக்கணம்", "இனமொழி விடை", "சான்று"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u5-q135", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "vidai_vagaigal", "chapter_id": null, "topic_id": "match_vina_types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்காணும் வினா வகைகளையும் சான்றுகளையும் சரியாகப் பொருத்துக:\n(a) அறிவினா - 1. உன்னிடம் பேனா உள்ளதா? (வாங்கிக்கொள்ள)\n(b) அறியாவினா - 2. தம்பி, இப்பாடலின் ஆசிரியர் யார்? (ஆசிரியர் கேட்டல்)\n(c) கொளல் வினா - 3. அங்கே நிற்பது தூணோ மனிதனோ?\n(d) ஐயவினா - 4. ஐயா, இப்பாடலின் ஆசிரியர் யார்? (மாணவன் கேட்டல்)", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-4, (b)-2, (c)-1, (d)-3", "C": "(a)-2, (b)-4, (c)-1, (d)-3", "D": "(a)-2, (b)-1, (c)-4, (d)-3"}, "explanation": "அறிவினா = ஆசிரியர் கேட்டல் (2); அறியாவினா = மாணவன் கேட்டல் (4); கொளல் வினா = பேனா உள்ளதா எனல் (1); ஐயவினா = தூணோ மனிதனோ எனல் (3). சரியான வரிசை: 2, 4, 1, 3."}, "en": {"blocks": [{"type": "text", "content": "Match the Vina question types with their examples:\n(a) Arivina - 1. Do you have a pen? (to acquire)\n(b) Ariyavina - 2. Who is the author? (Teacher asking student)\n(c) Kolal vina - 3. Is that a pillar or a human standing there?\n(d) Aiyavina - 4. Sir, who is the author? (Student asking teacher)", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-4, (b)-2, (c)-1, (d)-3", "C": "(a)-2, (b)-4, (c)-1, (d)-3", "D": "(a)-2, (b)-1, (c)-4, (d)-3"}, "explanation": "The correct matching sequence is 2, 4, 1, 3."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 115, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 115", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["இலக்கணம்", "பொருத்துக", "வினா வகைகள்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u5-q136", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "vidai_vagaigal", "chapter_id": null, "topic_id": "match_vidai_types", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்காணும் விடை வகைகளையும் அவற்றின் சான்றுகளையும் சரியாகப் பொருத்துக:\n(a) உற்றது உரைத்தல் - 1. ஆடத் தெரியுமா என்றதற்குப் பாடத் தெரியும் எனல்\n(b) உறுவது கூறல் - 2. வராமல் இருப்பேனோ?\n(c) வினா எதிர் வினாதல் - 3. எனக்கு உடம்பு சரியில்லை எனல்\n(d) இனமொழி விடை - 4. செய்தால் தலை வலிக்கும் எனல்", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-4, (b)-3, (c)-2, (d)-1", "C": "(a)-2, (b)-4, (c)-1, (d)-3", "D": "(a)-3, (b)-4, (c)-2, (d)-1"}, "explanation": "உற்றது உரைத்தல் = உடம்பு சரியில்லை (3); உறுவது கூறல் = தலை வலிக்கும் (4); வினா எதிர் வினாதல் = வராமல் இருப்பேனோ (2); இனமொழி விடை = பாடத் தெரியும் (1). பொருத்தம்: 3, 4, 2, 1."}, "en": {"blocks": [{"type": "text", "content": "Match the Vidai answer categories with their appropriate illustrations:\n(a) Uttrathu uraithal - 1. Replying knowing singing for dance query\n(b) Uruvathu kooral - 2. Would I not come?\n(c) Vina yethir vinaathal - 3. I am unwell presently\n(d) Inamozhi vidai - 4. Doing it will cause a headache", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-4, (b)-3, (c)-2, (d)-1", "C": "(a)-2, (b)-4, (c)-1, (d)-3", "D": "(a)-3, (b)-4, (c)-2, (d)-1"}, "explanation": "Matching order is 3, 4, 2, 1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 116, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 116", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["இலக்கணம்", "பொருத்துக", "விடை வகைகள்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u5-q137", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "puthiya_nambikkai", "chapter_id": null, "topic_id": "bethune_college_founding", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மேரி மெக்லியோட் பெத்யூன் தாம் தொடங்கிய சிறிய பள்ளியைப் பிற்காலத்தில் எத்தகைய புகழ்பெற்ற கல்வி நிறுவனமாக உயர்த்திக் காட்டினார்?", "media_id": null}], "options": {"A": "பெத்யூன்-குக்மேன் கல்லூரி/பல்கலைக்கழகம் (Bethune-Cookman University)", "B": "ஹார்வர்ட் பல்கலைக்கழகம்", "C": "கொலம்பியா கல்லூரி", "D": "ஆக்ஸ்போர்டு வளாகம்"}, "explanation": "மேரி ஐந்து டாலர் முதலீட்டில் தொடங்கி உருவாக்கிய தொடக்கப் பள்ளி பிற்காலத்தில் அமெரிக்காவின் புகழ்பெற்ற \"பெத்யூன்-குக்மேன் பல்கலைக்கழகமாக\" (Bethune-Cookman University) உருவெடுத்தது."}, "en": {"blocks": [{"type": "text", "content": "Into which prestigious higher educational institution did Mary McLeod Bethune's modest school evolve?", "media_id": null}], "options": {"A": "Bethune-Cookman University", "B": "Harvard University", "C": "Columbia College", "D": "Oxford Campus"}, "explanation": "Her pioneering school evolved into Bethune-Cookman University."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": 