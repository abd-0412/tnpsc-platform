{"id": "10th-u5-q052", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "kural_translations_german", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளை ஜெர்மன் மொழியில் மொழிபெயர்த்து ஜெர்மானிய அறிஞர்களிடையே தமிழின் புகழைப் பரப்பியவர் யார்?", "media_id": null}], "options": {"A": "மாக்ஸ் முல்லர்", "B": "கதே", "C": "சீகன் பால்கு", "D": "கிராவுல் (Dr. Karl Graul)"}, "explanation": "டாக்டர் காரல் கிராவுல் (Dr. Karl Graul) என்பவர் திருக்குறளை ஜெர்மன் மற்றும் இலத்தீன் மொழிகளில் மொழிபெயர்த்து வெளியிட்டார்."}, "en": {"blocks": [{"type": "text", "content": "Which German scholar translated Thirukkural into German and Latin in the 19th century?", "media_id": null}], "options": {"A": "Max Müller", "B": "Johann Wolfgang Goethe", "C": "Bartholomaeus Ziegenbalg", "D": "Dr. Karl Graul"}, "explanation": "Dr. Karl Graul translated Thirukkural into German in 1856."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 101, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 101", "url": null, "source_notes": null}, "previous_y