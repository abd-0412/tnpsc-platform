{"id": "10th-u5-q063", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "neethi_venba", "chapter_id": null, "topic_id": "poem_soul_companion", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நீதி வெண்பா பாடலின்படி மனிதனின் உயிருக்கு எப்போதும் பிரியாத சிறந்த அரிய துணையாய் நின்று இன்பம் பயப்பது எது?", "media_id": null}], "options": {"A": "பொன் பொருள்", "B": "உற்றார் உறவினர்", "C": "கல்வி (மெய்க்கல்வி)", "D": "அரசாட்சி"}, "explanation": "\"உயிர்க்கு அரிய துணையாய் இன்பம் பயக்கும் கல்வியை நெஞ்சில் போற்று\" என்று செய்குதம்பிப் பாவலர் கல்வி ஒன்றையே உயிருக்கு அழியாத உற்ற துணையாகக் குறிப்பிடுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "According to Neethi Venba, what serves as the supreme, infallible companion of the human soul conferring lasting joy?", "media_id": null}], "options": {"A": "Material gold", "B": "Kinsfolk", "C": "Education / True Knowledge (Kalvi)", "D": "Monarchical power"}, "explanation": "Education is hailed as the soul's ultimate companion granting everlasting joy."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 103, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 103", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["நீதி வெண்பா", "கல்வி", "உயிர்க்குத் துணை"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u5-q064", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "neethi_venba", "chapter_id": null, "topic_id": "paavalar_early_genius", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கா. ப. செய்குதம்பிப் பாவலர் எந்த இளம் வயதிலேயே மரபு வழியில் செய்யுள் இயற்றும் பேராற்றல் பெற்றிருந்தார்?", "media_id": null}], "options": {"A": "10-ஆம் வயதில்", "B": "12-ஆம் வயதில்", "C": "18-ஆம் வயதில்", "D": "15-ஆம் வயதில்"}, "explanation": "பாடநூல் குறிப்பு: செய்குதம்பிப் பாவலர் தமது 15-ஆம் வயதிலேயே செய்யுள் இயற்றும் பேராற்றல் பெற்று விளங்கிய இளம்புலவர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "At what early age did Ka. Pa. Seikuthambi Paavalar demonstrate the phenomenal ability to compose classical Tamil verse?", "media_id": null}], "options": {"A": "At age 10", "B": "At age 12", "C": "At age 18", "D": "At age 15"}, "explanation": "He possessed classical versification skills at the tender age of 15."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 104, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 104", "url": null, "source_notes": null}, "previous_year"