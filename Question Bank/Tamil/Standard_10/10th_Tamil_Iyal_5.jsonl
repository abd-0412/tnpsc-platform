{"id": "10th-u5-q127", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "vidai_vagaigal", "chapter_id": null, "topic_id": "explicit_implicit_answers", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "விடை வகைகளில் \"சுட்டு விடை, நேர் விடை, மறை விடை\" ஆகிய மூன்று விடைகளும் எவ்வகை விடைகளாகக் கொள்ளப்படுகின்றன?", "media_id": null}], "options": {"A": "குறிப்பு விடைகள்", "B": "மறைமுக விடைகள்", "C": "வெளிப்படை விடைகள் (நேரடியாகப் பொருளை வெளிப்படுத்துபவை)", "D": "வினா விடைகள்"}, "explanation": "விடை எட்டில் சுட்டு, நேர், மறை ஆகிய மூன்று விடைகளும் பொருளை நேரடியாக உணர்த்துவதால் \"வெளிப்படை விடைகள்\" எனப்படும்; மற்ற ஐந்தும் \"குறிப்பு விடைகள்\" ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "In Tamil grammar, which category do the first three answers (Suttu, Naer, and Marai) fall into?", "media_id": null}], "options": {"A": "Implicit answers (Kurippu Vidai)", "B": "Oblique answers", "C": "Explicit direct answers (Velipadai Vidai)", "D": "Interrogative answers"}, "explanation": "The first three give direct straightforward replies, termed Velipadai Vidai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-202