{"id": "10th-u5-q108", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thiruviyaiyadal_puranam", "chapter_id": null, "topic_id": "mudi_meaning_context", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"தலை வணங்காமல் மன்னன் இருந்தான்\" என்பதைத் \"தலையசைத்து மதிக்கவில்லை\" என உணர்த்தும் \"முடி\" என்னும் சொல்லின் நேரடிப் பொருள் என்ன?", "media_id": null}], "options": {"A": "முடிவு", "B": "முடிச்சு", "C": "கூந்தல்", "D": "தலை / கிரீடம்"}, "explanation": "முடி என்பது தலையைக் குறிக்கும் (முடி சாய்த்து = தலையசைத்து ரசித்து)."}, "en": {"blocks": [{"type": "text", "content": "In the poetic context of appreciating verse by nodding, what does \"Mudi\" literally refer to?", "media_id": null}], "options": {"A": "Conclusion", "B": "Knot", "C": "Tresses", "D": "Head / Crown (Thalai)"}, "explanation": "Mudi denotes the head/crown."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 106, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 106", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null,