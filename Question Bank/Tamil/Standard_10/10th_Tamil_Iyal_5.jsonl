{"id": "10th-u5-q003", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "bharathi_quote_foreign", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"பிறநாட்டு நல்லறிஞர் சாத்திரங்கள் தமிழ்மொழியிற் பெயர்த்தல் வேண்டும்; இறவாத புகழுடைய புதுநூல்கள் தமிழ்மொழியில் இயற்றல் வேண்டும்\" என்று முழங்கிய கவிஞர் யார்?", "media_id": null}], "options": {"A": "பாரதிதாசன்", "B": "கவிமணி தேசிக விநாயகம் பிள்ளை", "C": "மகாகவி பாரதியார்", "D": "நாமக்கல் கவிஞர்"}, "explanation": "மகாகவி பாரதியார் தமிழின் உலகளாவிய அறிவுப் பெருக்கத்திற்காக \"பிறநாட்டு நல்லறிஞர் சாத்திரங்கள் தமிழ்மொழியிற் பெயர்த்தல் வேண்டும்\" என்று பாடினார்."}, "en": {"blocks": [{"type": "text", "content": "Which revolutionary poet sang: \"Scholarly treatises of foreign thinkers must be translated into Tamil; immortal new works must be composed in Tamil\"?", "media_id": null}], "options": {"A": "Bharathidasan", "B": "Kavimani Desika Vinayakam Pillai", "C": "Mahakavi Bharathiyar", "D": "Namakkal Kavignar"}, "explanation": "Bharathiyar emphasized translating global scientific and scholarly works into Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "clas