{"id": "10th-u5-q025", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "thirukkural_translations", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உலகப் பொதுமறையான திருக்குறள் உலக மொழிகள் பலவற்றிலும் மொழிபெயர்க்கப்பட்டுள்ளது. திருக்குறளை இலத்தீன் மொழியில் மொழிபெயர்த்த அறிஞர் யார்?", "media_id": null}], "options": {"A": "வீரமாமுனிவர் (Constanzo Beschi)", "B": "ஜி. யு. போப்", "C": "கால்டுவெல்", "D": "சீகன் பால்கு"}, "explanation": "வீரமாமுனிவர் திருக்குறளின் அறத்துப்பால் மற்றும் பொருட்பாலை இலத்தீன் மொழியில் மொழிபெயர்த்து ஐரோப்பியர்களுக்கு அறிமுகம் செய்தார்."}, "en": {"blocks": [{"type": "text", "content": "Which Italian Jesuit missionary scholar translated the first two books of Thirukkural (Aram and Porul) into Latin?", "media_id": null}], "options": {"A": "Veeramamunivar (Constanzo Beschi)", "B": "G. U. Pope", "C": "Robert Caldwell", "D": "Bartholomaeus Ziegenbalg"}, "explanation": "Veeramamunivar translated Thirukkural into Latin in 1730."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 101, "chapter": null, "section": null, "re