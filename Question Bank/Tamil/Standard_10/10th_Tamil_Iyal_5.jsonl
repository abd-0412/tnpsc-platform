{"id": "10th-u5-q167", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "tnpsc_pyq", "chapter_id": null, "topic_id": "murai_niralnirai_pyq", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "[TNPSC முந்தைய வினா] \"அன்பும் அறனும் உடைத்தாயின் இல்வாழ்க்கை பண்பும் பயனும் அது\" - இத்திருக்குறளில் பயின்று வந்துள்ள பொருள்கோள் யாது?", "media_id": null}], "options": {"A": "ஆற்றுநீர்ப் பொருள்கோள்", "B": "கொண்டு கூட்டுப் பொருள்கோள்", "C": "முறை நிரல்நிறைப் பொருள்கோள்", "D": "எதிர் நிரல்நிறைப் பொருள்கோள்"}, "explanation": "TNPSC தேர்வுகளில் பலமுறை கேட்கப்பட்ட வினா: இக்குறளில் அன்பு-பண்பு, அறன்-பயன் என நேர்வரிசையில் நின்றதால் \"முறை நிரல்நிறைப் பொருள்கோள்\" அமைந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "[TNPSC PYQ] What Porulkol is exemplified in the verse \"Anbum aranum udaiththaayin ilvaazhkkai panbum payanum athu\"?", "media_id": null}], "options": {"A": "Aatruneer Porulkol", "B": "Kondu kootu Porulkol", "C": "Murai Niralnirai Porulkol", "D": "Ethir Niralnirai Porulkol"}, "explanation": "It exemplifies Murai Niralnirai Porulkol."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 118