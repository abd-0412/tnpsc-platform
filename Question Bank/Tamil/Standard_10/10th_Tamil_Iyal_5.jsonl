{"id": "10th-u5-q062", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "neethi_venba", "chapter_id": null, "topic_id": "poem_meaning_marul", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"மருளை அகற்றி மதிக்கும் தெருளை\" - இவ்வடியில் \"மருள்\", \"தெருள்\" என்னும் சொற்களின் முறையான பொருள்கள் யாவை?", "media_id": null}], "options": {"A": "அறிவு, அறியாமை", "B": "மயக்கம் (அறியாமை), தெளிவு (அறிவுத் தெளிவு)", "C": "கோபம், அமைதி", "D": "துன்பம், இன்பம்"}, "explanation": "பாடநூல் பொருள்: மருள் = மயக்கம் (அறியாமை); தெருள் = தெளிவு (மெய்யறிவுத் தெளிவு)."}, "en": {"blocks": [{"type": "text", "content": "In the line \"Marulai agatri mathikkum therulai\", what do the words \"Marul\" and \"Therul\" mean respectively?", "media_id": null}], "options": {"A": "Knowledge, Ignorance", "B": "Illusion / Ignorance (Mayakkam), Clarity / Wisdom (Thelivu)", "C": "Anger, Peace", "D": "Sorrow, Joy"}, "explanation": "Marul means illusion/delusion, while Therul means clarity of wisdom."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 103, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 103"