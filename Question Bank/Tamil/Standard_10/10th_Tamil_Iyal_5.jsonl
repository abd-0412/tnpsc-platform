{"id": "10th-u5-q144", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "porulkol_vagaigal", "chapter_id": null, "topic_id": "niralnirai_definition", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "செய்யுளில் பெயர்ச்சொற்களையோ வினைச்சொற்களையோ வரிசையாக (நிரலாக) நிறுத்தி, அவற்றிற்குரிய பயனிலைகளையும் வரிசையாக நிறுத்திப் பொருள் கொள்ளும் முறை எது?", "media_id": null}], "options": {"A": "மொழிமாற்றுப் பொருள்கோள்", "B": "பூட்டுவிற் பொருள்கோள்", "C": "அளைமறிபாப்புப் பொருள்கோள்", "D": "நிரல்நிறைப் பொருள்கோள்"}, "explanation": "நிரல் = வரிசை; நிறை = நிறுத்துதல். சொற்களை வரிசையாக நிறுத்திப் பொருள் கொள்வது \"நிரல்நிறைப் பொருள்கோள்\" எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "Arranging nouns or verbs in a set series and pairing them systematically with corresponding predicates in order is:", "media_id": null}], "options": {"A": "Mozhimaatru Porulkol", "B": "Poottuvir Porulkol", "C": "Alaimaripaapu Porulkol", "D": "Niralnirai Porulkol (Ordered alignment construal)"}, "explanation": "Niralnirai aligns items systematically in sequential columns of meaning."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 117, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 117", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["இலக்கணம்", "நிரல்நிறைப் பொருள்கோள்", "வரையறை"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u5-q145", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "porulkol_vagaigal", "chapter_id": null, "topic_id": "murai_niralnirai_kural", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"அன்பும் அறனும் உடைத்தாயின் இல்வாழ்க்கை\nபண்பும் பயனும் அது\"\n- இக்குறட்பாவில் பயின்று வந்துள்ள பொருள்கோள் எது?", "media_id": null}], "options": {"A": "முறை நிரல்நிறைப் பொருள்கோள்", "B": "எதிர் நிரல்நிறைப் பொருள்கோள்", "C": "கொண்டு கூட்டுப் பொருள்கோள்", "D": "ஆற்றுநீர்ப் பொருள்கோள்"}, "explanation": "இல்வாழ்க்கையின் அன்புக்குப் பண்பும், அறனுக்குப் பயனும் என எழுவாயும் பயனிலையும் நேர்வரிசையில் அமைந்ததால் இது \"முறை நிரல்நிறைப் பொருள்கோள்\" ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which Porulkol is exhibited in the Thirukkural: \"Anbum aranum udaiththaayin ilvaazhkkai panbum payanum athu\"?", "media_id": null}], "options": {"A": "Murai Niralnirai Porulkol (Direct parallel alignment)", "B": "Ethir Niralnirai Porulkol", "C": "Kondu kootu Porulkol", "D": "Aatruneer Porulkol"}, "explanation": "Love corresponds to culture and virtue to fruit, forming a direct parallel alignment."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 118, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 118", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["இலக்கணம்", "முறை நிரல்நிறைப் பொருள்கோள்", "திருக்குறள்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u5-q146", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "porulkol_vagaigal", "chapter_id": null, "topic_id": "ethir_niralnirai_kural", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"விலங்கொடு மக்கள் அனையர் இலங்குநூல்\nகற்றாரோடு ஏனையவர்\"\n- இக்குறட்பாவில் அமைந்துள்ள பொருள்கோள் எது?", "media_id": null}], "options": {"A": "முறை நிரல்நிறைப் பொருள்கோள்", "B": "எதிர் நிரல்நிறைப் பொருள்கோள்", "C": "ஆற்றுநீர்ப் பொருள்கோள்", "D": "பூட்டுவிற் பொருள்கோள்"}, "explanation": "முதல் அடியில் விலங்கு, மக்கள் என வரிசைப்படுத்தி, இரண்டாம் அடியில் கற்றாரோடு கல்லாதவரை (ஏனையவர்) எதிரெதிராக நிறுத்திப் பொருள் கொள்வதால் இது \"எதிர் நிரல்நிறைப் பொருள்கோள்\" ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which Porulkol is present in: \"Vilangodu makkal anaiyar ilangunool katraarodu enaiyavar\"?", "media_id": null}], "options": {"A": "Murai Niralnirai Porulkol", "B": "Ethir Niralnirai Porulkol (Chiasmic / Reverse order alignment)", "C": "Aatruneer Porulkol", "D": "Poottuvir Porulkol"}, "explanation": "Beasts correspond to unlettered and humans to learned in reverse chiasmic match."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term":