{"id": "10th-u5-q093", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "thiruviyaiyadal_puranam", "chapter_id": null, "topic_id": "idaikaadanar_friend", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இடைக்காடனார் சங்க காலப் புலவர்களுள் யாருடைய உற்ற தோழராக விளங்கினார்?", "media_id": null}], "options": {"A": "கபிலர் (கபிலரின் நண்பர்)", "B": "பரணர்", "C": "ஔவையார்", "D": "நக்கீரர்"}, "explanation": "பாடநூல் குறிப்பு: இடைக்காடனார் புலவர் கபிலரின் மீது அளவற்ற நட்புக் கொண்ட நண்பராவார் (\"கபிலனது கேண்மையினான்\")."}, "en": {"blocks": [{"type": "text", "content": "Whose intimate close friend was the poet Idaikkaadanar?", "media_id": null}], "options": {"A": "Kabilar (Friend of Kabilar)", "B": "Paranar", "C": "Avvaiyar", "D": "Nakkeerar"}, "explanation": "Idaikkaadanar was a devoted friend of the great Sangam poet Kabilar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 106, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 106", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "