{"id": "10th-u5-q020", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "sahitya_akademi_role", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இந்திய அரசின் எந்த உயரிய தன்னாட்சி அமைப்பு, இந்திய மொழிகளின் தலைசிறந்த இலக்கியங்களைப் பிற இந்திய மொழிகளிலும் ஆங்கிலத்திலும் மொழிபெயர்த்து வெளியிட்டு வருகிறது?", "media_id": null}], "options": {"A": "நேஷனல் புக் டிரஸ்ட் (NBT)", "B": "செம்மொழித் தமிழாய்வு மத்திய நிறுவனம்", "C": "இலலித கலா அகாதெமி", "D": "மத்திய சாகித்திய அகாதெமி (Sahitya Akademi)"}, "explanation": "மத்திய சாகித்திய அகாதெமி இந்திய மொழிகளின் சிறந்த படைப்புகளை அங்கீகரித்து, அவற்றை அனைத்து இந்திய மொழிகளிலும் மொழிபெயர்த்து வழங்கி வருகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which premier autonomous cultural body under the Government of India translates outstanding regional literary masterpieces into other Indian languages?", "media_id": null}], "options": {"A": "National Book Trust", "B": "Central Institute of Classical Tamil", "C": "Lalit Kala Akademi", "D": "Sahitya Akademi"}, "explanation": "Sahitya Akademi spearheads pan-Indian literary translation programs."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educa