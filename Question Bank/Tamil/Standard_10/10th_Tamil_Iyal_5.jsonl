{"id": "10th-u5-q147", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "porulkol_vagaigal", "chapter_id": null, "topic_id": "kondu_kootu_porulkol", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "செய்யுளில் ஆங்காங்கே சிதறிக் கிடக்கும் சொற்களைப் பொருளுக்கு ஏற்றவாறு முன்னும் பின்னுமாக மாற்றி அமைத்துப் பொருள் கொள்வது எவ்வகைப் பொருள்கோள்?", "media_id": null}], "options": {"A": "ஆற்றுநீர்ப் பொருள்கோள்", "B": "நிரல்நிறைப் பொருள்கோள்", "C": "கொண்டு கூட்டுப் பொருள்கோள்", "D": "மொழிமாற்றுப் பொருள்கோள்"}, "explanation": "ஒரு செய்யுளில் பல அடிகளிலும் சிதறிக்கிடக்கும் சொற்களைப் பொருளுக்கு ஏற்ப இணைத்துக் கொள்வது \"கொண்டு கூட்டுப் பொருள்கோள்\" ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Bringing together words dispersed across various lines in a verse to construct sensible meaning is:", "media_id": null}], "options": {"A": "Aatruneer Porulkol", "B": "Niralnirai Porulkol", "C": "Kondu Kootu Porulkol (Recombinant associative construal)", "D": "Mozhimaatru Porulkol"}, "explanation": "Kondu Kootu gathers dispersed words together to yield the intended sense."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 118, "chapter": null, "section": null, "reference": "10th Tamil, Unit 5, Page 118", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["இலக்கணம்", "கொண்டு கூட்டுப் பொருள்கோள்", "வரையறை"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u5-q148", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "porulkol_vagaigal", "chapter_id": null, "topic_id": "aalathu_mela_kuvalai_example", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"ஆலத்து மேல குவளை குளத்துள\nவாலின் நெடிய குரங்கு\"\n- இப்பாடல் வரிகளில் அமைந்துள்ள பொருள்கோள் யாது?", "media_id": null}], "options": {"A": "ஆற்றுநீர்ப் பொருள்கோள்", "B": "முறை நிரல்நிறைப் பொருள்கோள்", "C": "எதிர் நிரல்நிறைப் பொருள்கோள்", "D": "கொண்டு கூட்டுப் பொருள்கோள்"}, "explanation": "ஆல மரத்தின் மேல் குவளை மலரும், குளத்தில் நீண்ட வாலை உடைய குரங்கும் இருப்பதாக உள்ள சொற்களை மாற்றி, \"ஆலத்து மேல குரங்கு, குளத்துள குவளை\" என்று கொண்டு கூட்டிப் பொருள் கொள்வதால் இது \"கொண்டு கூட்டுப் பொருள்கோள்\" ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which Porulkol interprets the verse: \"Aalathu mela kuvalai kulathula vaalin nediya kurangu\"?", "media_id": null}], "options": {"A": "Aatruneer Porulkol", "B": "Murai Niralnirai Porulkol", "C": "Ethir Niralnirai Porulkol", "D": "Kondu Kootu Porulkol"}, "explanation": "Shifting monkey to the banyan tree and water-lily to the pond requires Kondu Kootu."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "clas