{"id": "10th-u5-q059", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "neethi_venba", "chapter_id": null, "topic_id": "chennai_event_date", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கா. ப. செய்குதம்பிப் பாவலர் எந்த ஆண்டு, எந்த நாளில் சென்னை விக்டோரியா அரங்கில் சதாவதான நிகழ்வை நிகழ்த்திக் காட்டிப் பட்டம் பெற்றார்?", "media_id": null}], "options": {"A": "1905 அக்டோபர் 2", "B": "1906 ஆகஸ்ட் 15", "C": "1907 மார்ச் 10", "D": "1910 ஜனவரி 26"}, "explanation": "செய்குதம்பிப் பாவலர் 1907-ஆம் ஆண்டு மார்ச் 10-ஆம் நாளில் சென்னை விக்டோரியா அரங்கில் அறிஞர் பலர் முன்னிலையில் 100 செயல்களை ஒரே நேரத்தில் செய்து காட்டி \"சதாவதானி\" என்று பாராட்டப்பட்டார்."}, "en": {"blocks": [{"type": "text", "content": "On which exact date did Ka. Pa. Seikuthambi Paavalar successfully demonstrate Sathavadhanam at Victoria Public Hall in Chennai?", "media_id": null}], "options": {"A": "2 October 1905", "B": "15 August 1906", "C": "10 March 1907", "D": "26 January 1910"}, "explanation": "He achieved this feat on 10 March 1907 in Chennai."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 104, "chapter": null, "section