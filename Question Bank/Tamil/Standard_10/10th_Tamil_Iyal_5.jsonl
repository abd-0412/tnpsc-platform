{"id": "10th-u5-q023", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_5", "lesson_id": "mozhipeyarppuk_kalvi", "chapter_id": null, "topic_id": "subramanya_bharathi_english", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதியார் தாகூரின் சிறுகதைகளைத் தமிழில் மொழிபெயர்த்துள்ளார். அவர் மொழிபெயர்த்த தாகூரின் புகழ்பெற்ற சிறுகதைகளுள் ஒன்று எது?", "media_id": null}], "options": {"A": "காபூலிவாலா", "B": "போஸ்ட்மாஸ்டர்", "C": "திக்குத் தெரியாத காட்டில் (தாகூர் சிறுகதைகள் தமிழாக்கம்)", "D": "கோரா"}, "explanation": "பாரதியார் தாகூரின் சிறுகதைகளை \"தாகூரின் சிறுகதைகள்\" என்ற தலைப்பில் அழகிய தமிழில் மொழிபெயர்த்துத் தந்துள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which legendary literary giant's short stories did Mahakavi Bharathiyar eagerly translate into Tamil for common readers?", "media_id": null}], "options": {"A": "Leo Tolstoy", "B": "Victor Hugo", "C": "Rabindranath Tagore's short stories", "D": "Maxim Gorky"}, "explanation": "Bharathiyar translated Rabindranath Tagore's short stories into chaste Tamil."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 101, "chapter": null, "section": null