{"id": "10th-u6-q112", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "kambaramayanam", "chapter_id": null, "topic_id": "kalviyil_periyavar_proverb", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"கல்வியில் பெரியவர் கம்பர்\" என்ற முதுமொழி தமிழ்ச் சூழலில் எதனை நிறுவுகிறது?", "media_id": null}], "options": {"A": "கம்பர் மட்டுமே பள்ளிக்கூடம் சென்றார்", "B": "கம்பர் இலக்கண நூல்களை மட்டுமே படித்தார்", "C": "கம்பர் பிற மொழிகளைப் புறக்கணித்தார்", "D": "கம்பரின் பரந்துபட்ட இலக்கிய, ஆன்மிக, அறிவியல் மற்றும் மானுடவியல் பேரறிவும் தமிழ் மொழி ஆளுமையும் எவருக்கும் எட்டாத உயரத்தில் நின்றது"}, "explanation": "கம்பரின் உலகளாவிய அறிவும், சகல சாத்திரங்களையும் கவிதையில் கரைத்துக் குடித்த பேராற்றலுமே அவரை \"கல்வியில் பெரியவர்\" என உலகை வியக்க வைத்தது."}, "en": {"blocks": [{"type": "text", "content": "What historical consensus is encapsulated by the traditional adage \"Kalviyil Periyavar Kambar\" (In scholarship, Kambar reigns supreme)?", "media_id": null}], "options": {"A": "He alone attended school", "B": "He studied only grammar", "C": "He shunned foreign tongues", "D": "His encyclopedic wisdom embracing literature, philosophy, aesthetics, and cosmic humanism stands at an unrivaled pinnacle"}, "explanation": "Kambar's encyclopedic intellectual and artistic mastery is celebrated by this proverb."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0