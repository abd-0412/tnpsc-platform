{"id": "10th-u6-q111", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "kambaramayanam", "chapter_id": null, "topic_id": "ayodhya_kandam_gangai_padalam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குகனின் பேரன்பையும், குகனைத் தன் உடன் பிறந்த தம்பியாக ராமன் ஏற்றதையும் விவரிக்கும் கங்கைப் படலம் எந்தக் காண்டத்தில் உள்ளது?", "media_id": null}], "options": {"A": "பால காண்டம்", "B": "ஆரணிய காண்டம்", "C": "அயோத்தியா காண்டம்", "D": "சுந்தர காண்டம்"}, "explanation": "பாடநூல் குறிப்பு: குகனின் தூய அன்பை விவரிக்கும் \"கங்கைப் படலம்\" கம்பராமாயணத்தின் இரண்டாவது காண்டமான அயோத்தியா காண்டத்தில் அமைந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "In which Kandam of Kamba Ramayanam is Gangai Padalam (featuring Guhan) located?", "media_id": null}], "options": {"A": "Bala Kandam", "B": "Aranya Kandam", "C": "Ayodhya Kandam", "D": "Sundara Kandam"}, "explanation": "Gangai Padalam is nestled in Ayodhya Kandam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "10th Tamil, Unit 6, Page 137", "url": null, "source_notes": null}, "previous_ye