{"id": "10th-u6-q099", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "kambaramayanam", "chapter_id": null, "topic_id": "uttara_kandam_author", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கம்பராமாயணத்தின் முதல் ஆறு காண்டங்களைக் கம்பர் இயற்றினார் எனில், ஏழாவது காண்டமான \"உத்தர காண்டத்தை\" இயற்றிய புலவர் யார்?", "media_id": null}], "options": {"A": "புகழேந்திப் புலவர்", "B": "கச்சியப்ப சிவாச்சாரியார்", "C": "ஒட்டக்கூத்தர்", "D": "பரஞ்சோதி முனிவர்"}, "explanation": "கம்பராமாயணத்தின் தொடர்ச்சியாக விளங்கும் ஏழாவது காண்டமான உத்தர காண்டத்தை இயற்றியவர் கவிச்சக்கரவர்த்தி ஒட்டக்கூத்தர் ஆவார்."}, "en": {"blocks": [{"type": "text", "content": "While Kambar composed the 6 core Kandams, who authored the concluding 7th canto \"Uttara Kandam\"?", "media_id": null}], "options": {"A": "Pugazhenthi Pulavar", "B": "Kachiappa Sivachariyar", "C": "Ottakoothar", "D": "Paranjothi Munivar"}, "explanation": "Ottakoothar composed the Uttara Kandam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "10th Tamil, Unit 6, Page 137", "url": null, "source_notes"