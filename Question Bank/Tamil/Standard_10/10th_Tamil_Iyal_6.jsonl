{"id": "10th-u6-q130", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "agapporul_ilakkanam", "chapter_id": null, "topic_id": "yaamam_vaikarai_hours", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரவு 10 மணி முதல் இரவு 2 மணி வரையிலான நடுஇரவுப் பொழுதும், இரவு 2 மணி முதல் காலை 6 மணி வரையிலான விடியற்பொழுதும் முறையே எவ்வாறு அழைக்கப்படுகின்றன?", "media_id": null}], "options": {"A": "மாலை, காலை", "B": "யாமம் (நடுஇரவு), வைகறை (விடியல்)", "C": "நண்பகல், எற்பாடு", "D": "எற்பாடு, மாலை"}, "explanation": "இரவு 10 மணி முதல் இரவு 2 மணி வரை = யாமம்; இரவு 2 மணி முதல் காலை 6 மணி வரை = வைகறை."}, "en": {"blocks": [{"type": "text", "content": "What are the technical terms for the time bands: 10:00 PM to 2:00 AM and 2:00 AM to 6:00 AM respectively?", "media_id": null}], "options": {"A": "Maalai, Kaalai", "B": "Yaamam (Midnight) and Vaikarai (Dawn)", "C": "Nanpagal, Erpaadu", "D": "Erpaadu, Maalai"}, "explanation": "Yaamam denotes the midnight quadrant (10 PM - 2 AM) and Vaikarai denotes pre-dawn (2 AM - 6 AM)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": null, "section": null, "refe