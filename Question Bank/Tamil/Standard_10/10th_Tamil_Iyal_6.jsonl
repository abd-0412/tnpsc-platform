{"id": "10th-u6-q049", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nigazhkalai", "chapter_id": null, "topic_id": "parai_types_sangam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழங்காலத்தில் போர்க்களத்தில் வீரர்களைத் திரட்டவும், அரசனின் ஆணைகளை மக்களுக்கு முரசறைந்து அறிவிக்கவும் பயன்படுத்தப்பட்ட தோற்கருவி எது?", "media_id": null}], "options": {"A": "பறை (வீர முரசு, கொடை முரசு, மண முரசு)", "B": "புல்லாங்குழல்", "C": "வீணை", "D": "நாதசுவரம்"}, "explanation": "பண்டைய தமிழகத்தில் போர் தொடங்குவதை அறிவிக்கும் போர்ப்பறை, கொடை அறிவிக்கும் கொடைப்பறை, சாவுப்பறை என முரசு மற்றும் பறைகள் தலையாய தகவல் தொடர்புச் சாதனங்களாக விளங்கின."}, "en": {"blocks": [{"type": "text", "content": "Which ancient percussion drum was beaten in Sangam warfare to assemble warriors and broadcast royal proclamations?", "media_id": null}], "options": {"A": "Parai / Murasu (War drum, heraldic royal drum)", "B": "Bamboo flute", "C": "Veena", "D": "Nadaswaram"}, "explanation": "Murasu and Parai served as ancient state broadcasting and military drums."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 129, "chapter": nul