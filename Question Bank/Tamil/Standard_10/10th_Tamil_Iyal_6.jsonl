{"id": "10th-u6-q143", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "karupporul_uripporul", "chapter_id": null, "topic_id": "kurinji_karupporul_details", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறிஞ்சி நிலத்திற்குரிய பறை, யாழ் மற்றும் தொழில் முறையே எவை?", "media_id": null}], "options": {"A": "ஏறுகோட்பறை, முல்லையாழ், ஆநிரை மேய்த்தல்", "B": "மணமுழவு, மருதயாழ், உழவு தொழில்", "C": "தொண்டகம், குறிஞ்சியாழ், தேனெடுத்தல் மற்றும் கிழங்கு அகழ்தல்", "D": "துடி, பாலையாழ், வழிப்பறி"}, "explanation": "பாடநூல் அட்டவணை: குறிஞ்சி நிலத்தின் பறை = தொண்டகம்; யாழ் = குறிஞ்சியாழ்; தொழில் = தேனெடுத்தல், கிழங்கு அகழ்தல்."}, "en": {"blocks": [{"type": "text", "content": "What are the designated drum (Parai), lute (Yaazh), and primary occupations of the Kurinji mountain landscape?", "media_id": null}], "options": {"A": "Erukotparai, Mullai yaazh, Cattle herding", "B": "Manamuzhavu, Marutha yaazh, Agriculture", "C": "Thondagam (drum), Kurinji yaazh (lute), Honey foraging and Tuber digging", "D": "Thudi, Paalai yaazh, Highway robbery"}, "explanation": "Kurinji features Thondagam drum and honey gathering."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10",