{"id": "10th-u6-q129", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "agapporul_ilakkanam", "chapter_id": null, "topic_id": "erpaadu_meaning_hours", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"எற்பாடு\" என்னும் சிறுபொழுதின் நேரம் எது? \"எற்பாடு\" என்பதன் சொல்லாக்கப் பொருள் என்ன?", "media_id": null}], "options": {"A": "பிற்பகல் 2 மணி முதல் மாலை 6 மணி வரை (எல் = ஞாயிறு/சூரியன், பாடு = மறையும் நேரம்)", "B": "காலை 6 மணி முதல் 10 மணி வரை", "C": "நடுநிசி 12 மணி", "D": "விடியற்காலை 4 மணி"}, "explanation": "எல் என்றால் சூரியன், பாடு என்றால் சாய்தல்/மறைதல். சூரியன் சாயும் நேரமான பிற்பகல் 2 மணி முதல் மாலை 6 மணி வரையிலான சிறுபொழுது \"எற்பாடு\" எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What time interval corresponds to \"Erpaadu\", and what does the etymology denote?", "media_id": null}], "options": {"A": "2:00 PM to 6:00 PM (El = Sun, Paadu = setting/declining time)", "B": "6:00 AM to 10:00 AM", "C": "Midnight 12:00", "D": "Dawn 4:00 AM"}, "explanation": "Erpaadu designates the afternoon solar decline from 2 PM to 6 PM."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 14