{"id": "10th-u6-q149", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "karupporul_uripporul", "chapter_id": null, "topic_id": "neithal_paalai_uripporul", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நெய்தல் நிலத்திற்கும் பாலை நிலத்திற்கும் உரிய உரிப்பொருள்கள் முறையே எவை?", "media_id": null}], "options": {"A": "இரங்கலும் இரங்கல் நிமித்தமும் (நெய்தல்) மற்றும் பிரிதலும் பிரிதல் நிமித்தமும் (பாலை)", "B": "ஊடலும் இருத்தலும்", "C": "புணர்தலும் ஊடலும்", "D": "இருத்தலும் புணர்தலும்"}, "explanation": "நெய்தலின் உரிப்பொருள் = இரங்கல் (தலைவன் கடலுக்குச் சென்றதால் தலைவி வருந்துதல்); பாலையின் உரிப்பொருள் = பிரிதல் (பொருள் தேடவோ போருக்கோ தலைவன் பிரிந்து செல்லுதல்)."}, "en": {"blocks": [{"type": "text", "content": "What are the designated Uripporul sentiments for Neithal (Coast) and Paalai (Arid Waste) respectively?", "media_id": null}], "options": {"A": "Irangal / Anxious pining (Neithal) and Pirithal / Painful separation (Paalai)", "B": "Oodal and Irutthal", "C": "Punaruthal and Oodal", "D": "Irutthal and Punaruthal"}, "explanation": "Neithal embodies anxious pining (Irangal) and Paalai represents harsh separation (Pirithal)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services