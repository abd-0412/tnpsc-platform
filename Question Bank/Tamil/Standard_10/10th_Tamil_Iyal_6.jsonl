{"id": "10th-u6-q148", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "karupporul_uripporul", "chapter_id": null, "topic_id": "marutham_uripporul", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மருத நிலத்திற்குரிய உரிப்பொருள் (மன ஒழுக்கம்) எது?", "media_id": null}], "options": {"A": "புணர்தல்", "B": "பிரிதல்", "C": "இரங்கல்", "D": "ஊடலும் ஊடல் நிமித்தமும் (தலைவன்-தலைவி இடையே தோன்றும் செல்லக் கோபம்/பிணக்கு)"}, "explanation": "மருத நிலத்தின் உரிப்பொருள்: \"ஊடலும் ஊடல் நிமித்தமும்\" (பரத்தைமை காரணமாகத் தலைவி தலைவனிடம் கொள்ளும் பிணக்கு) ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "Which emotional essence (Uripporul) governs the Marutham agrarian plains?", "media_id": null}], "options": {"A": "Physical union", "B": "Parting separation", "C": "Mournful weeping", "D": "Oodalum oodal nimithamum (Lovers' coquettish sulking / petulant feud)"}, "explanation": "Marutham mirrors feigned lover's quarrels (Oodal)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 143, "chapter": null, "section": null, "reference": "10th Tamil, Unit 6, Page 143", "url": null, "source_notes": null}, "pre