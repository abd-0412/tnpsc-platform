{"id": "10th-u6-q106", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "kambaramayanam", "chapter_id": null, "topic_id": "kumbakarna_tragic_grandeur", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கும்பகருணன் இராவணனின் தம்பியாக இருந்தபோதிலும் அவனது பாத்திரப் படைப்பு கம்பராமாயணத்தில் எத்தகைய சிறப்புப் பெற்றது?", "media_id": null}], "options": {"A": "அவன் கோழைத்தனமானவன்", "B": "அண்ணன் செய்தது தவறு என்று தெரிந்தும், உடன்பிறப்பு பாசத்திற்காகவும் நன்றி விசுவாசத்திற்காகவும் போர்க்களத்தில் வீர மரணம் அடைந்த கம்பீரமான பாத்திரம்", "C": "அவன் நாட்டை விட்டு ஓடினான்", "D": "அவன் போரிட மறுத்தான்"}, "explanation": "சீதையைச் சிறை வைத்தது பாவம் என்று இராவணனிடம் கண்டித்துக் கூறிய கும்பகருணன், போரில் தன் அண்ணனைத் தனியே விடாமல் உயிரைத் தியாகம் செய்த தீரமிக்க பாத்திரமாவான்."}, "en": {"blocks": [{"type": "text", "content": "What tragic heroism defines the characterization of Kumbakarna in Kamba Ramayanam?", "media_id": null}], "options": {"A": "Cowardly retreat", "B": "Advising Ravana against his sinful folly yet marching to valorous martyrdom out of unbreakable fraternal loyalty and gratitude", "C": "Deserting Lanka", "D": "Refusing to fight"}, "explanation": "Kumbakarna is portrayed as a tragic hero torn between righteous truth and supreme brotherly loyalty."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "s