{"id": "10th-u6-q096", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "kambaramayanam", "chapter_id": null, "topic_id": "kumbakarna_padalam_kandam", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கும்பகருணன் வதைப் படலம் கம்பராமாயணத்தில் எந்தக் காண்டத்தில் இடம்பெற்றுள்ளது?", "media_id": null}], "options": {"A": "ஆரணிய காண்டம்", "B": "கிட்கிந்தா காண்டம்", "C": "சுந்தர காண்டம்", "D": "யுத்த காண்டம்"}, "explanation": "பாடநூல் பகுதி: கும்பகருணன் வதைப் படலம் கம்பராமாயணத்தின் ஆறாவது காண்டமான \"யுத்த காண்டத்தில்\" அமைந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": "In which Kandam of Kamba Ramayanam does Kumbakarnan Vadhai Padalam feature?", "media_id": null}], "options": {"A": "Aranya Kandam", "B": "Kishkindha Kandam", "C": "Sundara Kandam", "D": "Yuddha Kandam (The War Canto)"}, "explanation": "Kumbakarna's episode forms part of Yuddha Kandam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 137, "chapter": null, "section": null, "reference": "10th Tamil, Unit 6, Page 137", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_nam