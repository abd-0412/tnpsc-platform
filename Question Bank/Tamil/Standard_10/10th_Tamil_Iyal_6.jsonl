{"id": "10th-u6-q144", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "karupporul_uripporul", "chapter_id": null, "topic_id": "mullai_karupporul_details", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முல்லை நிலத்திற்குரிய பறை மற்றும் பண் முறையே எவை?", "media_id": null}], "options": {"A": "தொண்டகம், குறிஞ்சிப் பண்", "B": "மீன்கோட்பறை, செவ்வழிப் பண்", "C": "மணமுழவு, மருதப் பண்", "D": "ஏறுகோட்பறை, சாதாரிப் பண்"}, "explanation": "முல்லை நிலத்தின் இசைக்கருவி பறை = ஏறுகோட்பறை; அதற்குரிய பண் = சாதாரிப் பண்."}, "en": {"blocks": [{"type": "text", "content": "Which percussion drum and melodic mode (Pann) belong to the Mullai pastoral landscape?", "media_id": null}], "options": {"A": "Thondagam, Kurinji pann", "B": "Meenkotparai, Sevvazhi pann", "C": "Manamuzhavu, Marutha pann", "D": "Erukotparai (Bull-taming drum) and Saadhaari pann"}, "explanation": "Mullai features the bull-taming Erukotparai and Saadhaari pann."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 143, "chapter": null, "section": null, "reference": "10th Tamil, Unit 6, Page 143", "url": null, "source_notes": null}, "previous_