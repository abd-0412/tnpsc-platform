{"id": "10th-u6-q116", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "paaichal", "chapter_id": null, "topic_id": "source_collection", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"பாய்ச்சல்\" என்னும் சிறுகதை சா. கந்தசாமியின் எந்தச் சிறுகதைத் தொகுப்பில் இடம்பெற்றுள்ளது?", "media_id": null}], "options": {"A": "ஒரு நாள் ஒரு இரவு", "B": "கந்தசாமி கதைகள்", "C": "நிழல் உலக மனிதர்கள்", "D": "தக்கையின் மீது நான்கு கண்கள்"}, "explanation": "பாடநூல் குறிப்பு: \"பாய்ச்சல்\" என்னும் சிறுகதை சா. கந்தசாமியின் \"தக்கையின் மீது நான்கு கண்கள்\" என்னும் சிறுகதைத் தொகுப்பில் இடம் பெற்றுள்ளது."}, "en": {"blocks": [{"type": "text", "content": "From which celebrated short story anthology by Sa. Kandasamy is \"Paaichal\" excerpted?", "media_id": null}], "options": {"A": "Oru Naal Oru Iravu", "B": "Kandasamy Kathaigal", "C": "Nizhal Ulaga Manithargal", "D": "Thakkaiyin Meethu Naangu Kangal"}, "explanation": "It is taken from his collection \"Thakkaiyin Meethu Naangu Kangal\"."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 140, "chapter": null, "section": null, "reference": "10th Tamil, Unit 6, Page 140", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["பாய்ச்சல்", "தக்கையின் மீது நான்கு கண்கள்", "சிறுகதைத் தொகுப்பு"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "10th-u6-q117", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "paaichal", "chapter_id": null, "topic_id": "story_characters", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"பாய்ச்சல்\" கதையில் தெருவில் அனுமன் வேடமிட்டு ஆடிய கலைஞனின் ஆட்டத்தால் ஈர்க்கப்பட்டு, தானும் துள்ளி ஆடிய சிறுவனின் பெயர் என்ன?", "media_id": null}], "options": {"A": "அழகு", "B": "கண்ணன்", "C": "மணி", "D": "முருகன்"}, "explanation": "கதையின் நாயகனாக வரும் சிறுவனின் பெயர் \"அழகு\" ஆகும். அவன் அனுமன் ஆட்டத்தைக் கண்டு தன்னையும் அறியாமல் கலை உணர்வில் பாய்ந்து ஆடுகிறான்."}, "en": {"blocks": [{"type": "text", "content": "What is the name of the spirited young village boy in \"Paaichal\" captivated by the Hanuman folk dancer?", "media_id": null}], "options": {"A": "Azhagu", "B": "Kannan", "C": "Mani", "D": "Murugan"}, "explanation": "Young Azhagu is swept into rhythmic ecstatic dancing by the Hanuman masquerader."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 138, "chapter": null, "section": null, "reference": "10th Tamil, Unit 6, Page 138", "url": null, "source_notes": null}, "previous_year": {"is_previous_ye