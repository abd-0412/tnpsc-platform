{"id": "10th-u6-q065", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "muthukumarasami_pillaithamizh", "chapter_id": null, "topic_id": "sengeerai_meaning_action", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "செங்கீரைப் பருவம் என்பது குழந்தையின் எத்தனையாவது மாதத்தில் நிகழும் பருவமாகும்? அப்பருவத்தில் குழந்தையின் உடல் அசைவு எவ்வாறு இருக்கும்?", "media_id": null}], "options": {"A": "ஐந்து முதல் ஆறாம் மாதங்களில், குழந்தை ஒரு காலை மடக்கி மற்றொரு காலை நீட்டி இரு கைகளையும் நிலத்தில் ஊன்றித் தலையை அசைத்தாடுதல்", "B": "முதல் மாதத்தில் தொட்டிலில் படுத்திருத்தல்", "C": "இரண்டாம் ஆண்டில் ஓடி விளையாடுதல்", "D": "பத்தாம் மாதத்தில் தேர் இழுத்தல்"}, "explanation": "செங்கீரைப் பருவம் குழந்தையின் 5-6 ஆம் மாதங்களில், முகம் நிமிர்த்தி இரு கைகளையும் ஊன்றித் தலையை மெல்ல அசைத்தாடும் அழகிய நிலையாகும்."}, "en": {"blocks": [{"type": "text", "content": "What physical developmental milestone is celebrated in Sengeerai Paruvam around the 5th-6th month?", "media_id": null}], "options": {"A": "The infant props up with both hands on the floor, folding one leg, extending the other, and sways the head gracefully", "B": "Sleeping motionless in cradle", "C": "Running outdoors at age two", "D": "Pulling toy chariots at month ten"}, "explanation": "The infant sways rhythmically propping its torso on tiny hands around month 5-6."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 134, "chapter": null, "section": null, "reference": "10th Tamil, Unit 6, Page 134", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["பிள்ளைத்தமிழ்", "செங்கீரைப் பருவம்", "குழந்தை அசைவு"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
