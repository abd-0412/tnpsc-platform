{"id": "10th-u6-q045", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "nigazhkalai", "chapter_id": null, "topic_id": "puliyattam_agility", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புலியாட்டத்தில் கலைஞர்கள் வெளிப்படுத்தும் உடல் அசைவுகள் எதனைப் போன்றிருக்கும்?", "media_id": null}], "options": {"A": "புலி பதுங்குதல், பாய்தல், நகங்களால் கீறுதல், இரையை வேட்டையாடுதல் போன்ற ஆக்ரோஷ அசைவுகள்", "B": "மயில் தோகையசைப்பது போல", "C": "யானை அசைந்து நடப்பது போல", "D": "மீன் நீந்துவது போல"}, "explanation": "புலியாட்டக் கலைஞர்கள் காட்டில் புலி தன் இரையைக் கண்டு பதுங்குவது போலவும், சீறிப் பாய்வது போலவும் மிகத் தத்ரூபமாக உடலை வளைத்து ஆடி வியக்க வைப்பர்."}, "en": {"blocks": [{"type": "text", "content": "What physical behaviors do Puliyattam performers dramatize with astonishing feline precision?", "media_id": null}], "options": {"A": "A tiger prowling, stalking, crouching, ferocious leaping, and capturing prey", "B": "Peacock preening plumes", "C": "Elephant slow lumbering", "D": "Fish swimming"}, "explanation": "Performers mimic crouching, pouncing, and savage feline agility."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edit