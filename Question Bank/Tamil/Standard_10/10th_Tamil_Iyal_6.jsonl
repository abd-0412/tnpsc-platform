{"id": "10th-u6-q098", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "kambaramayanam", "chapter_id": null, "topic_id": "kambar_meter_epithet", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கம்பரின் ஒப்பற்ற செய்யுள் யாப்புத் திறனைப் போற்றும் விதமாக எழுந்த புகழ்பெற்ற முதுமொழி எது?", "media_id": null}], "options": {"A": "வெண்பாவிற்குப் புகழேந்தி", "B": "விருத்தம் என்னும் ஒண்பாவிற்கு உயர் கம்பன்", "C": "பரணிக்கோர் சயங்கொண்டார்", "D": "அந்தாதிக்கு அழகிய சொக்கநாதர்"}, "explanation": "விருத்தப்பாக்களை பல்வேறு சந்த வேறுபாடுகளோடு அற்புதமாக இயற்றியதால் \"விருத்தம் என்னும் ஒண்பாவிற்கு உயர் கம்பன்\" எனப் பாராட்டப்படுகிறார்."}, "en": {"blocks": [{"type": "text", "content": "Which classical saying celebrates Kambar's peerless virtuosity in composing Virutham metrical verse?", "media_id": null}], "options": {"A": "Venbaavirku Pugazhenthi", "B": "Virutham ennum onpaavirku uyar Kamban", "C": "Paranirkkor Jayamkondar", "D": "Andhaadhikku Azhagiya Sokkanathar"}, "explanation": "Kambar is universally acclaimed as the monarch of the Virutham meter."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 137,