{"id": "10th-u6-q119", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_6", "lesson_id": "agapporul_ilakkanam", "chapter_id": null, "topic_id": "definition_porul", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் இலக்கணத்தில் \"பொருள்\" என்பது எதனைக் குறிக்கிறது?", "media_id": null}], "options": {"A": "பொன், வெள்ளி போன்ற செல்வங்கள்", "B": "வணிகப் பண்டங்கள்", "C": "ஒழுக்க முறை (வாழ்வியல் நெறிமுறை)", "D": "சொல்லின் விளக்கம் மட்டுமே"}, "explanation": "பொருள் என்பது தமிழரின் வாழ்க்கை நெறிமுறையான \"ஒழுக்க முறையை\" குறிக்கும். இது அகம், புறம் என இருவகைப்படும்."}, "en": {"blocks": [{"type": "text", "content": "In classical Tamil grammar, what foundational concept does the term \"Porul\" denote?", "media_id": null}], "options": {"A": "Precious metals like gold", "B": "Commercial commodities", "C": "Ozhukka Murai (Ethical codes of living and cultural conduct)", "D": "Dictionary definition alone"}, "explanation": "Porul signifies holistic ethical life patterns, divided into Aham and Puram."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 141, "chapter": null, "section": null, "reference": "10th Tamil, Unit 6,