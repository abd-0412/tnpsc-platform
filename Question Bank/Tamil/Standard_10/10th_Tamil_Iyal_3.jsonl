{"id": "10th-u3-q047", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "virunthu_potruthum", "chapter_id": null, "topic_id": "avvaiyar_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"மருந்தே ஆயினும் விருந்தொடு உண்\" என்ற ஔவையாரின் வாக்கின் உட்பொருள் என்ன?", "media_id": null}], "options": {"A": "மருந்தை விருந்தினருக்குக் கொடுக்க வேண்டும்", "B": "நோய் வந்தால் சாப்பிடக் கூடாது", "C": "சாவா மருந்தாகிய அமிர்தமே கிடைத்தாலும் தான் மட்டும் தனித்து உண்ணாமல் பிறரோடு பகிர்ந்து உண்ண வேண்டும்", "D": "மருந்தை மட்டுமே விருந்தாக வைக்க வேண்டும்"}, "explanation": "எவ்வளவு உயரிய பொருளாக இருந்தாலும் தனித்து உண்ணாமல் பகிர்ந்துண்பதே மனித மாண்பு என்பதை ஔவையார் உணர்த்துகிறார்."}, "en": {"blocks": [{"type": "text", "content": "What is the profound inner teaching of Avvaiyar’s dictum \"Marunthe aayinum virunthodu unn\"?", "media_id": null}], "options": {"A": "Medicine must be fed to guests", "B": "Fast during sickness", "C": "Even if one secures ambrosia that defies death, one must never hoard it alone but share it with others", "D": "Serve only medicine as food"}, "explanation": "Even the most precious immortal nectar must never be consumed in selfish isolation."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu 