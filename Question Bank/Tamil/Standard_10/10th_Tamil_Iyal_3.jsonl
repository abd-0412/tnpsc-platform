{"id": "10th-u3-q107", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "malaipadukadaam", "chapter_id": null, "topic_id": "poetic_metaphor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மலைபடுகடாம் நூலில் எதனை எதனோடு உருவகப்படுத்திய நயம் தமிழிலக்கியத்தில் ஈடு இணையற்றதாகப் போற்றப்படுகிறது?", "media_id": null}], "options": {"A": "மழையை அம்போடு", "B": "வானத்தைக் கடலோடு", "C": "மலையை யானையாகவும், மலையின் எதிரொலிகளை யானையின் மதநீராகவும் உருவகித்தது", "D": "காட்டைச் சிங்கத்தோடு"}, "explanation": "மலையையே ஒரு பிரம்மாண்ட மதயானையாகவும், அருவி ஓசை, விலங்கு ஓசை முதலானவற்றை மதநீராகவும் (கடாம்) உருவகித்தமை இதன் தனிச்சிறப்பாகும்."}, "en": {"blocks": [{"type": "text", "content": "Which unparalleled poetic metaphor serves as the central conceit of Malaipadukadaam?", "media_id": null}], "options": {"A": "Rain as arrows", "B": "Sky as ocean", "C": "The whole mountain personified as a rogue tusker, with mountain echoes as its rutting fluid", "D": "Forest as lion"}, "explanation": "Personifying the mountain as an elephant with natural reverberations as its rutting fluid."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2