{"id": "10th-u3-q133", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thoganilai_thodargal", "chapter_id": null, "topic_id": "adukkuthodar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"பாம்பு பாம்பு!, வருக வருக!\" என்பன எவ்வகைத் தொடர்கள்?", "media_id": null}], "options": {"A": "அடுக்குத்தொடர்கள்", "B": "இரட்டைக் கிளவிகள்", "C": "இடைச்சொல் தொடர்கள்", "D": "வினைத்தொகைகள்"}, "explanation": "ஒரே சொல் அச்சம், விரைவு, மகிழ்ச்சி காரணமாக இரண்டு, மூன்று, நான்கு முறை அடுக்கி வந்து, பிரித்தால் பொருள் தருவது \"அடுக்குத்தொடர்\" ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What type of construction is represented by \"Paambu paambu!\" and \"Varuga varuga!\"?", "media_id": null}], "options": {"A": "Iterative repeated words (Adukkuthodar)", "B": "Echo words (Irattaikilavi)", "C": "Idaichol phrase", "D": "Vinaithogai"}, "explanation": "Words repeated multiple times for emphasis or emotion that retain meaning when split form an Adukkuthodar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 65, "chapter": null, "section": null, "reference": "10th Tamil, Unit 3, Page 65", "url": null,