{"id": "10th-u3-q020", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "virunthu_potruthum", "chapter_id": null, "topic_id": "inmayilum_virunthu", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வறுமை நிலையிலும் தன் மானத்தையும் விருந்தோம்பலையும் கைவிடாத சங்கத் தமிழரின் பண்பு எவ்வாறு அழைக்கப்படுகிறது?", "media_id": null}], "options": {"A": "போர் அறம்", "B": "வணிக அறம்", "C": "கல்வி அறம்", "D": "இன்மையிலும் விருந்தோம்பல்"}, "explanation": "தான் வறுமையில் வாடும் போதும் விருந்தினரை இன்முகத்தோடு உபசரிக்கும் தமிழரின் உயர் பண்பு \"இன்மையிலும் விருந்தோம்பல்\" எனப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": "What is the legendary virtue called where impoverished Tamils upheld supreme hospitality even amidst acute destitution?", "media_id": null}], "options": {"A": "Martial chivalry", "B": "Commercial ethics", "C": "Scholarly duty", "D": "Hospitality amidst destitution (Inmaiyilum Virunthombal)"}, "explanation": "It is termed \"Inmaiyilum Virunthombal\" - the ethic of sharing meals even when destitute."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section