{"id": "10th-u3-q135", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "gopallapurathu_makkal", "chapter_id": null, "topic_id": "humanity_theme", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கோபல்லபுரத்து மக்கள் கதையில் வெளிப்படும் முதன்மையான மானுட விழுமியம் யாது?", "media_id": null}], "options": {"A": "அயலாரை விரட்டுவது", "B": "பணக்காரர்களுக்கு மட்டுமே உதவுவது", "C": "வறுமையிலும் வழியில் தவிக்கும் முன்பின் அறியாத மனிதனுக்குத் தன்னிடம் உள்ள எளிய உணவைப் பகிர்ந்தளிக்கும் ஈர நெஞ்சம்", "D": "வேலை வாங்கிவிட்டு உணவு தருவது"}, "explanation": "தன்னிடம் இருப்பது எளிய பழைய கஞ்சியானாலும் அதைத் தாகத்தோடு வரும் வழிப்போக்கனுக்கு இன்முகத்தோடு வழங்கிப் பசி போக்கும் உன்னத மானுடப் பண்பே கதையின் ஆன்மாவாகும்."}, "en": {"blocks": [{"type": "text", "content": "What supreme human value is illuminated in \"Gopallapurathu Makkal\"?", "media_id": null}], "options": {"A": "Driving strangers away", "B": "Aiding the wealthy only", "C": "Compassionately sharing one’s humble rustic meal with a collapsed unknown stranger even amidst poverty", "D": "Demanding labor before giving food"}, "explanation": "Unconditional compassion and generous sharing of food with a desperate stranger."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Na