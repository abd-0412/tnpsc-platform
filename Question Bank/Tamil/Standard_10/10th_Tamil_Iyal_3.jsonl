{"id": "10th-u3-q132", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thoganilai_thodargal", "chapter_id": null, "topic_id": "urichol_thodar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"மாநகர், சாலப் பேசினான்\" என்பன எவ்வகைத் தொகாநிலைத் தொடர்கள்?", "media_id": null}], "options": {"A": "இடைச்சொல் தொடர்கள்", "B": "அடுக்குத்தொடர்கள்", "C": "வினைமுற்றுத் தொடர்கள்", "D": "உரிச்சொல் தொடர்கள்"}, "explanation": "மா, சால என்னும் உரிச்சொற்களை அடுத்துப் பெயர்ச்சொல்லும் வினைச்சொல்லும் தொடர்ந்து வெளிப்படையாகப் பொருள் தருவதால் \"உரிச்சொல் தொடர்கள்\" எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": "What construction is formed by \"Maanagar\" and \"Saalap pesinaan\"?", "media_id": null}], "options": {"A": "Idaichol phrases", "B": "Iterative phrases", "C": "Finite verb phrases", "D": "Qualifying prefix constructions (Urichol Thodargal)"}, "explanation": "\"Maa\" and \"Saala\" are intensifying roots, forming Urichol Thodargal."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 65, "chapter": null, "section": null, "reference": "10th Tamil, Unit 3, Page 65", "url": null, "source_notes