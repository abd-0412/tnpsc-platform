{"id": "10th-u3-q002", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "virunthu_potruthum", "chapter_id": null, "topic_id": "kannagi_lament", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"தொல்லோர் சிறப்பின் \nவிருந்தெதிர் கோடலும் இழந்த என்னை\" - என்று கோவலனைப் பிரிந்த நிலையிலும் விருந்தோம்பல் செய்ய இயலவில்லையே என வருந்திய சிலப்பதிகாரப் பாத்திரம் யார்?", "media_id": null}], "options": {"A": "மாதவி", "B": "கண்ணகி", "C": "மாதரி", "D": "கவுந்தியடிகள்"}, "explanation": "சிலப்பதிகாரத்தில் கோவலனைப் பிரிந்து வாழும் கண்ணகி, தனது கணவனைப் பிரிந்த துன்பத்தை விட இல்லறத்தில் விருந்தினரை உபசரிக்க முடியாத நிலையையே பெருந்துன்பமாகக் கருதி வருந்துகிறாள்."}, "en": {"blocks": [{"type": "text", "content": "In Silappathikaram, who laments losing the noble householder opportunity to receive and host unexpected guests during marital separation?", "media_id": null}], "options": {"A": "Madhavi", "B": "Kannagi", "C": "Maathari", "D": "Kavunthi Adigal"}, "explanation": "Kannagi laments her inability to practice hospitality while separated from Kovalan."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 50, "ch