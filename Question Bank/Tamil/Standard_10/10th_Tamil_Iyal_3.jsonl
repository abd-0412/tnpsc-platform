{"id": "10th-u3-q037", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "virunthu_potruthum", "chapter_id": null, "topic_id": "seeyazh_meaning", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "புறநானூற்றில் வறிய தலைவன் விருந்தினருக்கு உணவிட இரண்டாம் நாளில் அடகு வைத்த இசைக்கருவி எது?", "media_id": null}], "options": {"A": "கருங்கோட்டுச் சீறியாழ்", "B": "பேரியாழ்", "C": "மத்தளம்", "D": "முழவு"}, "explanation": "முதல் நாளில் வாளையும், இரண்டாம் நாளில் தன் கருங்கோட்டுச் சீறியாழையும் அடகு வைத்து விருந்தளித்தான்."}, "en": {"blocks": [{"type": "text", "content": "Which musical instrument was pledged by the impoverished Sangam hero on the second day to feed his guests?", "media_id": null}], "options": {"A": "Karunkottus Seeriyaazh (Black-stemmed small harp)", "B": "Periyaazh", "C": "Maddalam", "D": "Muzhavu"}, "explanation": "He pawned his small black-stemmed harp (Seeriyaazh) to purchase provisions."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference": "10th Tamil, Unit 3, Page 51", "url": null, "source_notes": null}, "previous_year": {"is_previous