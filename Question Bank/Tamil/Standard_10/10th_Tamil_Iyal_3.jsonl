{"id": "10th-u3-q005", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "virunthu_potruthum", "chapter_id": null, "topic_id": "natrinai_quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"அல்லில் ஆயினும் விருந்து வரின் உவக்கும்\" - என்று நள்ளிரவில் விருந்தினர் வந்தாலும் முகம் மலர்ந்து வரவேற்கும் தமிழரின் பண்பைப் போற்றும் நூல் எது?", "media_id": null}], "options": {"A": "நற்றிணை", "B": "குறுந்தொகை", "C": "ஐங்குறுநூறு", "D": "கலித்தொகை"}, "explanation": "\"அல்லில் ஆயினும் விருந்து வரின் உவக்கும்\" (அல் = இரவு). நள்ளிரவில் விருந்தினர் வந்தாலும் மகிழ்ந்து உணவளிக்கும் தமிழர் பண்பை நற்றிணை (பாடல் 142) பேசுகிறது."}, "en": {"blocks": [{"type": "text", "content": "Which Sangam work praises the Tamil custom of rejoicing to host guests even if they arrive in the dark middle of the night?", "media_id": null}], "options": {"A": "Natrinai", "B": "Kurunthogai", "C": "Aingurunooru", "D": "Kalithogai"}, "explanation": "Natrinai (verse 142) extols hosting guests joyfully even during deep night hours."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference"