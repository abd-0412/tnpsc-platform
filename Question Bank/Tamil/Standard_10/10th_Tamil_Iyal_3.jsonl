{"id": "10th-u3-q001", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "virunthu_potruthum", "chapter_id": null, "topic_id": "tolkappiyam_def", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"விருந்தே தானும் புதுவது புனைந்த யாப்பின் மேற்றே\" - என்று விருந்துக்குப் புதியவர் என்ற பொருளை உணர்த்திய இலக்கண நூல் எது?", "media_id": null}], "options": {"A": "தொல்காப்பியம்", "B": "நன்னூல்", "C": "அகத்தியம்", "D": "வீரசோழியம்"}, "explanation": "தொல்காப்பியர் விருந்து என்பதற்குப் \"புதுமை\" அல்லது புதியவர் என்ற பொருளைக் கையாண்டுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Which ancient grammar text equates \"Virunthu\" with novelty / new unfamiliar guests with the line \"Virunthe thaanum puthuvathu punaintha yaappin metre\"?", "media_id": null}], "options": {"A": "Tholkappiyam", "B": "Nannool", "C": "Agathiyam", "D": "Veerasozhiyam"}, "explanation": "Tholkappiyar defines Virunthu as novelty/new guests."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 50, "chapter": null, "section": null, "reference": "10th Tamil, Unit 3, Page 50", "url": null, "source_notes": null}, "previous_year":