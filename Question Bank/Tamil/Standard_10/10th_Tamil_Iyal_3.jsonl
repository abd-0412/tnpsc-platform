{"id": "10th-u3-q131", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "thoganilai_thodargal", "chapter_id": null, "topic_id": "idaichol_thodar", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"மற்றொன்று\" (மற்று + ஒன்று) என்பது எவ்வகைத் தொகாநிலைத் தொடர்?", "media_id": null}], "options": {"A": "உரிச்சொல் தொடர்", "B": "அடுக்குத்தொடர்", "C": "இடைச்சொல் தொடர்", "D": "எழுவாய்த் தொடர்"}, "explanation": "மற்று என்னும் இடைச்சொல்லை அடுத்து ஒன்று என்னும் சொல் நின்று வெளிப்படையாகப் பொருள் தருவதால் இது \"இடைச்சொல் தொடர்\" ஆகும்."}, "en": {"blocks": [{"type": "text", "content": "What type of unelided phrase is \"Matronru\" (Matru + Onru)?", "media_id": null}], "options": {"A": "Urichol phrase", "B": "Iterative phrase", "C": "Particle phrase (Idaichol Thodar)", "D": "Subject phrase"}, "explanation": "\"Matru\" is an intermediate particle (Idaichol); followed by \"onru\", it forms an Idaichol Thodar."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 65, "chapter": null, "section": null, "reference": "10th Tamil, Unit 3, Page 65", "url": null, "source_notes": null}, "previous_year": {"is_previous_y