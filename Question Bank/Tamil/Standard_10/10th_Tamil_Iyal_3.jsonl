{"id": "10th-u3-q045", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "virunthu_potruthum", "chapter_id": null, "topic_id": "minnesota_details", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மினசோட்டா தமிழ்ச் சங்கத்தின் வாழை இலை விருந்தில் எத்தகைய உணவுகள் முதன்மையாகப் பரிமாறப்படுகின்றன?", "media_id": null}], "options": {"A": "பாரம்பரியத் தமிழ்நாட்டு சைவ அறுசுவை உணவுகள்", "B": "மேலைநாட்டு துரித உணவுகள்", "C": "சீன உணவு வகைகள்", "D": "ரொட்டி மற்றும் பழங்கள் மட்டும்"}, "explanation": "புலம்பெயர்ந்து வாழும் தமிழர்கள் தங்கள் பண்பாட்டை மறக்காமல் அடுத்த தலைமுறைக்குக் கடத்த பாரம்பரிய அறுசுவை சைவ உணவை வாழை இலையில் பரிமாறுகின்றனர்."}, "en": {"blocks": [{"type": "text", "content": "What genre of cuisine is served at the Minnesota Tamil Sangam’s annual feast?", "media_id": null}], "options": {"A": "Traditional Tamil six-taste (Arusuvai) vegetarian banquet", "B": "Western fast food", "C": "Chinese dishes", "D": "Bread and raw fruit only"}, "explanation": "A full authentic Tamil six-flavor vegetarian feast is served on plantain leaves."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 54, "chapte