{"id": "10th-u3-q003", "schema_version": "1.0", "kind": "single_choice", "level": "standard", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "10", "subject_id": "general_tamil", "term": "full_year", "unit_id": "unit_3", "lesson_id": "virunthu_potruthum", "chapter_id": null, "topic_id": "kambaramayanam_quote", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"பொருந்து செல்வமும் கல்வியும் பூத்தலால் \nவருந்தி வந்தவர்க்கு ஈதலும் வைகலும் \nவிருந்தும் அன்றி விளைவன யாவையே\" - என்று விருந்தோம்பலைப் பாடிய புலவர் யார்?", "media_id": null}], "options": {"A": "ஒட்டக்கூத்தர்", "B": "புகழேந்தி", "C": "கம்பர் (கம்பராமாயணத்தில்)", "D": "சேக்கிழார்"}, "explanation": "கம்பராமாயணத்தில் கோசல நாட்டு மக்களின் செல்வமும் கல்வியும் விருந்தோம்பல் செய்வதற்கே பயன்பட்டது என்று கம்பர் பாடியுள்ளார்."}, "en": {"blocks": [{"type": "text", "content": "Who authored the lines in Ramayana stating that wealth and erudition blossom solely to feed the needy and host guests daily?", "media_id": null}], "options": {"A": "Ottakoothar", "B": "Pugazhenthi", "C": "Kambar (in Kambaramayanam)", "D": "Sekkizhar"}, "explanation": "Kambar celebrated the hospitable virtue of the Kosala country in Kambaramayanam."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": [], "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "explanation_key": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "10", "term": "full_year", "edition": "2024-2025", "page": 51, "chapter": null, "section": null, "reference": "10th Tamil, Unit 3, Page 51", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null}, "media": {"has_media": false, "items": []}, "tags": ["விருந்து போற்றுதும்", "கம்பர்", "கம்பராமாயணம்"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "admin", "created_at": "2026-11-04T12:00:00Z", "updated_at": "2026-11-04T12:00:00Z"}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
