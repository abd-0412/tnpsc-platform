{"id": "6th-t3-u3-002", "schema_version": "1.0", "kind": "match_4x4", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆசிய ஜோதி சொல்லும் பொருளும் பொருத்துக:\n(a) அஞ்சினர் - 1. பரந்த உலகம்\n(b) பார் - 2. பயந்தனர்\n(c) நீள்நிலம் - 3. விழும்\n(d) வீழும் - 4. உலகம்", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-4, (c)-1, (d)-3", "C": "(a)-2, (b)-1, (c)-4, (d)-3", "D": "(a)-3, (b)-4, (c)-2, (d)-1"}, "explanation": "அஞ்சினர் = பயந்தனர்; பார் = உலகம்; நீள்நிலம் = பரந்த உலகம்; வீழும் = விழும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L_A", "content_ta": "அஞ்சினர்", "content_en": null}, {"id": "L_B", "content_ta": "பார்", "content_en": null}, {"id": "L_C", "content_ta": "நீள்நிலம்", "content_en": null}, {"id": "L_D", "content_ta": "வீழும்", "content_en": null}], "right": [{"id": "R1", "content_ta": "பரந்த உலகம்", "content_en": null}, {"id": "R2", "content_ta": "பயந்தனர்", "content_en": null}, {"id": "R3", "content_ta": "விழும்", "content_en": null}, {"id": "R4", "content_ta": "உலகம்", "content_en": null}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "sourc