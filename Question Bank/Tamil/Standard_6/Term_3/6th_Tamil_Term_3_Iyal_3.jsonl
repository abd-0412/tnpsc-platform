// பாடம் 4: முடிவில் ஒரு தொடக்கம் (விரிவானம்) [Q065 - Q076]
// உறுப்புக் கொடை விழிப்புணர்வு, திருக்கழுகுன்றம் மருத்துவர்கள் அசோகன்-புஷ்பாஞ்சலி மகன் ஹிதேந்திரன் மூளைச்சாவு, இதய தானம், பெங்களூரு சிறுமி மறுவாழ்வு, போக்குவரத்து நெரிசல் கடந்த பயணம், தமிழ்நாடு உறுப்பு தானத்தில் இந்தியாவில் முதலிடம்
// ==============================================================================
{"id": "6th-t3-u3-065", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "முடிவில் ஒரு தொடக்கம் பாடம் உணர்த்தும் செய்திகளை ஆராய்க:\n1. நமது இறப்பிற்குப் பின் மண்ணுக்குச் செல்லும் உடல் உறுப்புகளைப் பிறர் வாழ வழங்குவதும் வள்ளல் தன்மையே ஆகும்.\n2. மூளைச்சாவு அடைந்த இளைஞனின் உறுப்புகளைத் தானமாக வழங்கிப் பல உயிர்களைக் காப்பாற்ற முடியும்.\n3. உறுப்புக் கொடை பற்றிய விழிப்புணர்வை ஏற்படுத்திய நிகழ்வை இப்பாடம் கூறுகிறது.", "media_id": null}], "options": {"A": "1, 2, 3 ஆகிய அனைத்தும் சரி", "B": "1, 2 மட்டும் சரி", "C": "2, 3 மட்டும் சரி", "D": "1 மட்டும் சரி"}, "explanation": "உறுப்புக் கொடை பற்றிய உயர்ந்த விழிப்புணர்வை இப்பாடம் விவரிக்கிறது. அனைத்தும் சரி."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "நமது இறப்பிற்குப் பின் மண்ணுக்குச் செல்லும் உடல் உறுப்புகளைப் பிறர் வாழ வழங்குவதும் வள்ளல் தன்மையே ஆகும்.", "content_en": null}, {"id": "S2", "content_ta": "மூளைச்சாவு அடைந்த இளைஞனின் உறுப்புகளைத் தானமாக வழங்கிப் பல உயிர்களைக் காப்பாற்ற முடியும்.", "content_en": null}, {"id": "S3", "content_ta": "உறுப்புக் கொடை பற்றிய விழிப்புணர்வை ஏற்படுத்திய நிகழ்வை இப்பாடம் கூறுகிறது.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "