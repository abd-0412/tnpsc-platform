{"id": "6th-t3-u3-101", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பண்புடைமை' அதிகாரக் குறட்பாக்களை ஆராய்க:\n1. 'அன்புடைமை ஆன்ற குடிப்பிறத்தல் இவ்விரண்டும் பண்புடைமை என்னும் வழக்கு' - பிறரிடம் அன்புடையவராக இருத்தல், உயர்ந்த குடியில் பிறந்திருத்தல் ஆகிய இரண்டும் பண்புடைமையாகும்.\n2. 'பண்புடையார்ப் பட்டுண்டு உலகம் அதுஇன்றேல் மண்புக்கு மாய்வது மண்' - பண்புடைய சான்றோர்கள் வாழ்வதால்தான் இவ்வுலகம் நிலைபெற்றுள்ளது.", "media_id": null}], "options": {"A": "கூற்று 1, 2 இரண்டும் சரி", "B": "1 மட்டும் சரி", "C": "2 மட்டும் சரி", "D": "இரண்டும் தவறு"}, "explanation": "பண்புடைமையின் இலக்கணம் மற்றும் உலகம் நிலைபெறக் காரணமான பண்புடையோர் பற்றி வள்ளுவர் கூறுகிறார்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'அன்புடைமை ஆன்ற குடிப்பிறத்தல் இவ்விரண்டும் பண்புடைமை என்னும் வழக்கு' - பிறரிடம் அன்புடையவராக இருத்தல், உயர்ந்த குடியில் பிறந்திருத்தல் ஆகிய இரண்டும் பண்புடைமையாகும்.", "content_en": null}, {"id": "S2", "content_ta": "'பண்புடையார்ப் பட்டுண்டு உலகம் அதுஇன்றேல் மண்புக்கு மாய்வது மண்' - பண்புடைய சான்றோர்கள் வாழ்வதால்தான் இவ்வுலகம் நிலைபெற்றுள்ளது.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "nega