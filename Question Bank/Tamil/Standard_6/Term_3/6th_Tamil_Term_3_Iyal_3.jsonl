// ==============================================================================
// பாடம் 3: மனிதநேயம் (உரைநடை உலகம்) [Q037 - Q064]
// புறநானூறு 182 ('தமக்கென முயலா நோன்தாள் பிறர்க்கென முயலுநர் உண்மையானே' - கடலுள் மாய்ந்த இளம்பெருவழுதி), வள்ளலார் (கடுக்கன் நிகழ்வு, வாடிய பயிரைக் கண்டபோதெல்லாம் வாடினேன், 1867 வடலூர் சத்திய தரும சாலை பசிப்பிணி அணையா அடுப்பு, ஜீவகாருண்யம்), அன்னை தெரசா (சாலை மூதாட்டி தொழுநோயாளிப் பணி, நிர்மல் ஹிருதய், மக்களுக்குச் செய்யும் பணியே இறைப்பணி, 1979 அமைதிக்கான நோபல் பரிசு, புன்னகை பொன்மொழி), கைலாஷ் சத்யார்த்தி (Bachpan Bachao Andolan, 86,000+ குழந்தைகள் மீட்பு, 103 நாடுகள் 80,000 கி.மீ நடைபயணம், 2014 அமைதிக்கான நோபல் பரிசு, குழந்தைகளின் கண்கள் பொன்மொழி)
// ==============================================================================
{"id": "6th-t3-u3-037", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மனிதநேயம் குறித்த சங்க இலக்கியப் பாடலை ஆராய்க:\n1. 'தமக்கென முயலா நோன்தாள் பிறர்க்கென முயலுநர் உண்மையானே' - புறநானூறு.\n2. தமக்காக உழைக்காமல் பிறர்க்காக வாழும் மனிதநேயப் பண்பாளர்களால்தான் இவ்வுலகம் நிலைபெற்றுள்ளது என்பதை இப்பாடல் கூறுகிறது.\n3. இப்புறநானூற்றுப் பாடலை இயற்றியவர் கடலுள் மாய்ந்த இளம்பெருவழுதி ஆவார்.", "media_id": null}], "options": {"A": "1, 2, 3 ஆகிய அனைத்தும் சரி", "B": "1, 2 மட்டும் சரி", "C": "2, 3 மட்டும் சரி", "D": "1 மட்டும் சரி"}, "explanation": "புறநானூறு 182-ஆம் பாடல்; பிறர்க்கென முயலும் மனிதநேயத்தை விளக்குகிறது; ஆசிரியர் இளம்பெருவழுதி. மூன்றும் சரி."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'தமக்கென முயலா நோன்தாள் பிறர்க்கென முயலுநர் உண்மையானே' - புறநானூறு.", "content_en": null}, {"id": "S2", "content_ta": "தமக்காக உழைக்காமல் பிறர்க்காக வாழும் மனிதநேயப் பண்பாளர்களால்தான் இவ்வுலகம் நிலைபெற்றுள்ளது என்பதை இப்பாடல் கூறுகிறது.", "content_en": null}, {"id": "S3", "content_ta": "இப்புறநானூற்றுப் பாடலை இயற்றியவர் கடலுள் மாய்ந்த இளம்பெருவழுதி ஆவார்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "ne