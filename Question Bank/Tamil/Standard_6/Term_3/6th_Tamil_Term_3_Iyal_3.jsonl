{"id": "6th-t3-u3-009", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): புத்தபிரானைக் கண்ட யாகசாலை மக்கள் அனைவரும் நடுங்கி அச்சமுற்றனர்.\nகாரணம் (R): அரசனின் வேள்விக்குத் தடையாக புத்தபிரான் ஒரு நொண்டிய ஆட்டுக் குட்டியைத் தன் தோளில் சுமந்து கம்பீரமாக அங்கே வந்தார்.", "media_id": null}], "options": {"A": "கூற்று மற்றும் காரணம் இரண்டும் சரி; சரியான விளக்கம்", "B": "கூற்று சரி, காரணம் தவறு", "C": "கூற்று தவறு, காரணம் சரி", "D": "இரண்டும் தவறு"}, "explanation": "'நின்றவர் கண்டு நடுங்கினாரே - ஐயன் நேரிலே நிற்கவும் அஞ்சினாரே' என்று பாடலில் விவரிக்கப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "புத்தபிரானைக் கண்ட யாகசாலை மக்கள் அனைவரும் நடுங்கி அச்சமுற்றனர்.", "reason": "அரசனின் வேள்விக்குத் தடையாக புத்தபிரான் ஒரு நொண்டிய ஆட்டுக் குட்டியைத் தன் தோளில் சுமந்து கம்பீரமாக அங்கே வந்தார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "3", "edition": "2024-2025", "publication_ye