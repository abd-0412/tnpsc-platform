{"id": "6th-t3-u2-050", "schema_version": "1.0", "kind": "match_4x4", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நால்வகைச் சொற்களையும் அவற்றிற்கான சான்றுகளையும் பொருத்துக:\n(a) பெயர்ச்சொல் - 1. மற்றும், ஐ\n(b) வினைச்சொல் - 2. பாரதி, பள்ளி\n(c) இடைச்சொல் - 3. மாநகரம், சாலப் பேசினான்\n(d) உரிச்சொல் - 4. வந்தான், எழுதினான்", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-4, (c)-1, (d)-3", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-2, (b)-1, (c)-4, (d)-3"}, "explanation": "பெயர்ச்சொல்: பாரதி, பள்ளி; வினைச்சொல்: வந்தான், எழுதினான்; இடைச்சொல்: மற்றும், ஐ; உரிச்சொல்: மாநகரம், சாலப் பேசினான்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L_A", "content_ta": "பெயர்ச்சொல்", "content_en": null}, {"id": "L_B", "content_ta": "வினைச்சொல்", "content_en": null}, {"id": "L_C", "content_ta": "இடைச்சொல்", "content_en": null}, {"id": "L_D", "content_ta": "உரிச்சொல்", "content_en": null}], "right": [{"id": "R1", "content_ta": "மற்றும், ஐ", "content_en": null}, {"id": "R2", "content_ta": "பாரதி, பள்ளி", "content_en": null}, {"id": "R3", "content_ta": "மாநகரம், சாலப் பேசினான்", "content_en": null}, {"id": "R4", "content_ta": "வந்தான், எழுதினான்", "content_en": null}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negativ