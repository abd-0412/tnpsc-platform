{"id": "6th-t3-pyq-012", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): காந்தியடிகள் குற்றால அருவியில் மகிழ்ச்சியுடன் நீராடி மகிழ்ந்தார்.\nகாரணம் (R): குற்றாலத்தில் இயற்கை எழிலும் நீர் வளமும் காந்தியடிகளை மிகவும் ஈர்த்தது.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று, காரணம் இரண்டும் சரி", "C": "கூற்று தவறு, காரணம் சரி", "D": "கூற்று (A) முற்றிலும் தவறு (நீராட மறுத்தார்)"}, "explanation": "அருவிக்குச் செல்லும் வழியில் உள்ள கோயிலில் ஒடுக்கப்பட்டோருக்கு அனுமதி மறுக்கப்பட்டதால் காந்தியடிகள் குற்றால அருவியில் நீராட மறுத்தார். கூற்று தவறு."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "காந்தியடிகள் குற்றால அருவியில் மகிழ்ச்சியுடன் நீராடி மகிழ்ந்தார்.", "reason": "குற்றாலத்தில் இயற்கை எழிலும் நீர் வளமும் காந்தியடிகளை மிகவும் ஈர்த்தது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "3", "edition": "2024-2025", "pu