{"id": "6th-t3-pyq-019", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): காந்தியடிகள் கானாடுகாத்தானில் அன்பர் ஒருவரது வீட்டில் தங்கியிருந்த போது அங்குள்ள ஆடம்பர வெளிநாட்டுப் பொருள்களைக் கண்டு வருந்தினார்.\nகாரணம் (R): உள்நாட்டு நெசவையும் கைத்தொழில்களையும் காப்பதே இந்திய விடுதலைக்கு அடித்தளம் என்ற சுதேசி கொள்கையில் காந்தியடிகள் உறுதியாக இருந்தார்.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று மற்றும் காரணம் இரண்டும் சரி; சரியான விளக்கம்", "D": "இரண்டும் தவறு"}, "explanation": "இதற்குச் செலவழித்த தொகையில் பத்தில் ஒரு பங்கு கொடுத்தால் இதைவிட அழகாக்குவேன் என்று கூறி சுதேசி உணர்வை ஊட்டினார்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "காந்தியடிகள் கானாடுகாத்தானில் அன்பர் ஒருவரது வீட்டில் தங்கியிருந்த போது அங்குள்ள ஆடம்பர வெளிநாட்டுப் பொருள்களைக் கண்டு வருந்தினார்.", "reason": "உள்நாட்டு நெசவையும் கைத்தொழில்களையும் காப்பதே இந்திய விடுதலைக்கு அடித்தளம் என்ற சுதேசி கொள்கையில் காந்தியடிகள் உறுதியாக இருந்தார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}