// பகுதி 1: விடுதலைப் போராட்ட ஆளுமைகள் (TNPSC 10-Year PYQs 2011 - 2025) [Q001 - Q028] (வினாக்கள்: 28)
// வேலுநாச்சியார் 1730-1796, 1780 சிவகங்கை மீட்பு, 1772 காளையார் கோவில் போர் முத்துவடுகநாதர், விருப்பாட்சி கோபால நாயக்கர் 8 ஆண்டுகள், ஹைதர் அலி உருது பேச்சு 5000 குதிரைப்படை, தாண்டவராயன், பெரிய மருது/சின்ன மருது, குயிலி ஆயுதக்கிடங்கு தற்கொலைப்படை, உடையாள் நடுகல் தாலி காணிக்கை, ஜான்சி ராணிக்கு முன்னோடி; காந்தியடிகள் 1919 மார்ச் சென்னை ராஜாஜி இல்லம் பாரதியார் சந்திப்பு ("இவரைப் பத்திரமாகப் பாதுகாக்க வேண்டும்"), 1921 செப்டம்பர் மதுரை எளிய ஆடை புரட்சி, கானாடுகாத்தான் சுதேசி, மதுரை மீனாட்சியம்மன் கோவில் ஆலயப் பிரவேசம் 1946, குற்றால அருவி நீராட மறுப்பு, ஜி.யு. போப் தமிழ்க் கையேடு, திருக்குறள், 1937 சென்னை இலக்கிய மாநாடு உ.வே.சா தலைமையுரை ("அடிநிழலில் இருந்து தமிழ் கற்க ஆவல்"), திரு.வி.க, தில்லையாடி வள்ளியம்மை, தமிழ்க் கையெழுத்து; தாராபாரதி (கவிஞாயிறு, புதிய விடியல்கள், இது எங்கள் கிழக்கு, காளிதாசன்-கம்பன்-காந்தி); கட்டபொம்மன் நா. வானமாமலை
// ==============================================================================
{"id": "6th-t3-pyq-001", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வேலுநாச்சியார் குறித்த கீழ்க்காணும் கூற்றுகளை ஆராய்க:\n1. வேலுநாச்சியார் 1730-ல் இராமநாதபுரம் மன்னர் செல்லமுத்து சேதுபதியின் மகளாகப் பிறந்தார்.\n2. சிவகங்கை மன்னர் முத்துவடுகநாதரை மணந்து சிவகங்கையின் அரசியானார்.\n3. 1772-ல் காளையார் கோவில் போரில் ஆங்கிலேயரால் முத்துவடுகநாதர் கொல்லப்பட்டார்.", "media_id": null}], "options": {"A": "1, 2, 3 ஆகிய அனைத்தும் சரி", "B": "1, 2 மட்டும் சரி", "C": "2, 3 மட்டும் சரி", "D": "1 மட்டும் சரி"}, "explanation": "1730 பிறப்பு, முத்துவடுகநாதர் திருமணம், 1772 காளையார் கோவில் போர் கணவர் வீரமரணம். மூன்றும் TNPSC தேர்வுகளில் அடிக்கடி கேட்கப்பட்ட வரலாற்று உண்மைகள்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "வேலுநாச்சியார் 1730-ல் இராமநாதபுரம் மன்னர் செல்லமுத்து சேதுபதியின் மகளாகப் பிறந்தார்.", "content_en": null}, {"id": "S2", "content_ta": "சிவகங்கை மன்னர் முத்துவடுகநாதரை மணந்து சிவகங்கையின் அரசியானார்.", "content_en": null}, {"id": "S3", "content_ta": "1772-ல் காளையார் கோவில் போரில் ஆங்கிலேயரால் முத்துவடுகநாதர் கொல்லப்பட்டார்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false