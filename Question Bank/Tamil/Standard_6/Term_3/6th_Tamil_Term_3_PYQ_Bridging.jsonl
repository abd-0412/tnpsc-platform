{"id": "6th-t3-pyq-077", "schema_version": "1.0", "kind": "match_4x4", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழைய சமச்சீர் இலக்கிய விருதுகளைப் பொருத்துக:\n(a) பாரதிதாசன் - பிசிராந்தையார் - 1. 1969 சாகித்திய அகாதெமி\n(b) மு. மேத்தா - ஆகாயத்துக்கு அடுத்த வீடு - 2. 2006 சாகித்திய அகாதெமி\n(c) எஸ். ராமகிருஷ்ணன் - சஞ்சாரம் - 3. 2018 சாகித்திய அகாதெமி\n(d) அன்னை தெரசா - அமைதிக்கான நோபல் - 4. 1979 அமைதி நோபல்", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-1, (c)-4, (d)-3", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-4, (b)-3, (c)-2, (d)-1"}, "explanation": "பாரதிதாசன்: 1969; மு. மேத்தா: 2006; எஸ். ராமகிருஷ்ணன்: 2018; அன்னை தெரசா: 1979."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "3", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "pyq_bridging", "section": null, "re