{"id": "6th-t3-pyq-009", "schema_version": "1.0", "kind": "match_4x4", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காந்தியடிகளுடன் தொடர்புடைய தமிழ்நாட்டு நிகழ்வுகளையும் தலைவர்களையும் பொருத்துக:\n(a) உ.வே. சாமிநாதையர் - 1. 'இந்தப் பெரியவரின் அடிநிழலில் இருந்து தமிழ் கற்க ஆவல்' (1937)\n(b) ராஜாஜி - 2. 1919 ரௌலட் சட்டப் போராட்டத்தின் போது காந்தி தங்கியிருந்த சென்னை இல்லத்தின் தலைவர்\n(c) திரு.வி. கலியாணசுந்தரனார் - 3. மேடைகளில் காந்தியடிகளின் உரையைத் தமிழில் மொழிபெயர்த்தவர்\n(d) வைத்தியநாதையர் - 4. 1939-ல் மதுரை மீனாட்சியம்மன் கோவில் ஆலயப் பிரவேசத்தை முன்னெடுத்த தலைவர்", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-1, (c)-4, (d)-3", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-4, (b)-3, (c)-2, (d)-1"}, "explanation": "உ.வே.சா அடிநிழல்; ராஜாஜி சென்னை இல்லம்; திரு.வி.க மொழிபெயர்ப்பு; வைத்தியநாதையர் ஆலயப் பிரவேசம்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L_A", "content_ta": "உ.வே. சாமிநாதையர்", "content_en": null}, {"id": "L_B", "content_ta": "ராஜாஜி", "content_en": null}, {"id": "L_C", "content_ta": "திரு.வி. கலியாணசுந்தரனார்", "content_en": null}, {"id": "L_D", "content_ta": "வைத்தியநாதையர்", "content_en": null}], "right": [{"id": "R1", "content_ta": "'இந்தப் பெரியவரின் அடிநிழலில் இருந்து தமிழ் கற்க ஆவல்' (1937)", "content_en": null}, {"id": "R2", "content_ta": "1919 ரௌலட் சட்டப் போராட்டத்தின் போது காந்தி தங்கியிருந்த சென்னை இல்லத்தின் தலைவர்", "content_en": null}, {"id": "R3", "content_ta": "மேடைகளில் காந்தியடிகளின் உரையைத் தமிழில் மொழிபெயர்த்தவர்", "content_en": null}, {"id": "R4", "content_ta": "1939-ல் மதுரை மீனாட்சியம்மன் கோவில் ஆலயப் பிரவேசத்தை முன்னெடுத்த தலைவர்", "content_en": null}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "3", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "pyq_bridging", "section": null, "reference": "TNPSC Group 4 (2013, 2017) & Gandhi Tamil Ties", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "tnpsc", "exam_name": "group_4", "year": "2017", "paper": "general_tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_3", "match_4x4"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t3-pyq-010", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காந்தியடிகளைக் கவர்ந்த நூல்கள் மற்றும் தமிழ் ஆர்வத்தை ஆராய்க:\n1. தென்னாப்பிரிக்காவில் வாழ்ந்தபோதே காந்தியடிகள் தமிழ் கற்கத் தொடங்கினார்.\n2. ஜி.யு. போப் எழுதிய 'தமிழ் கையேடு' (Tamil Handbook) காந்தியடிகளைப் பெரிதும் கவர்ந்தது.\n3. திருவள்ளுவரின் 'திருக்குறள்' காந்தியடிகளின் அகிம்சைச் சிந்தனைகளுக்கு உரமூட்டியது.", "media_id": null}], "options": {"A": "1, 2 மட்டும் சரி", "B": "1, 2, 3 ஆகிய அனைத்தும் சரி", "C": "2, 3 மட்டும் சரி", "D": "1 மட்டும் சரி"}, "explanation": "தென்னாப்பிரிக்காவில் தமிழ் கற்றது, ஜி.யு. போப் தமிழ் கையேடு மற்றும் திருக்குறள் தம்மை ஈர்த்தது காந்தியே குறிப்பிட்டவை. மூன்றும் சரி."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "தென்னாப்பிரிக்காவில் வாழ்ந்தபோதே காந்தியடிகள் தமிழ் கற்கத் தொடங்கினார்.", "content_en": null}, {"id": "S2", "content_ta": "ஜி.யு. போப் எழுதிய 'தமிழ் கையேடு' (Tamil Handbook) காந்தியடிகளைப் பெரிதும் கவர்ந்தது.", "content_en": null}, {"id": "S3", "content_ta": "திருவள்ளுவரின் 'திருக்குறள்' காந்தியடிகளின் அகிம்சைச் சிந்தனைகளுக்கு உரமூட்டியது.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negat