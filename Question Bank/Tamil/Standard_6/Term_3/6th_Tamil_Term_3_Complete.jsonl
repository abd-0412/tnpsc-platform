// ==============================================================================
// பகுதி 2: இலக்கிய, அறநெறி & மனிதநேய ஆளுமைகள் (TNPSC 10-Year PYQs 2011 - 2025) [Q029 - Q056] (வினாக்கள்: 28)
// தாயுமானவர் திருப்பாடல் திரட்டு ("தமிழ்மொழியின் உபநிடதம்"), திருச்சிராப்பள்ளி விஜயரகுநாத சொக்கலிங்கர் தலைமைக் கணக்கர், கேடிலியப்பர்-கஜவல்லி வேதாரண்யம், பராபரக் கண்ணி (2 அடிகள்), இன்பநிலை/அன்பர்பணி/எல்லாரும் இன்புற்றிருக்க, சமாதி இலட்சுமிபுரம்; வள்ளலார் இராமலிங்க அடிகளார் மருதூர் (1823), திருவருட்பா 6 திருமுறைகள், 1867 வடலூர் சத்திய தரும சாலை அணையா அடுப்பு, ஜீவகாருண்ய ஒழுக்கம், மனுமுறை கண்ட வாசகம், வாடிய பயிரைக் கண்டபோதெல்லாம் வாடினேன், சன்மார்க்க சங்கம் 1865, சத்திய ஞான சபை 1872; கவிமணி தேசிக விநாயகனார் தேரூர், 36 ஆண்டுகள் ஆசிரியர் பணி, மலரும் மாலையும், மருமக்கள்வழி மான்மியம், ஆசிய ஜோதி (எட்வின் அர்னால்ட் The Light of Asia தழுவல், புத்தர் பிம்பிசாரன் யாக ஆடுகள்), உமர்கய்யாம் ரூபாயத் மொழிபெயர்ப்பு, குழந்தை பாடல்கள், 1940 கவிமணி பட்டம்; மு. மேத்தா வானம்பாடி இயக்கம், ஆகாயத்துக்கு அடுத்த வீடு சாகித்திய அகாதெமி (2006), கண்ணீர்ப் பூக்கள், ஊர்வலம்; அன்னை தெரசா நிர்மல் ஹிருதய், 1979 அமைதி நோபல், 1980 பாரத ரத்னா; கைலாஷ் சத்யார்த்தி Bachpan Bachao Andolan, 86,000+ குழந்தைகள் மீட்பு, 103 நாடுகள் 80,000 கி.மீ, 2014 அமைதி நோபல்; மணிமேகலை சீத்தலை சாத்தனார், கோமுகி பொய்கை வைகாசி விசாகம், ஆபுத்திரன் அமுதசுரபி, ஆதிரை முதல் பிச்சை
// ==============================================================================
{"id": "6th-t3-pyq-029", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாயுமானவர் குறித்த செய்திகளை ஆராய்க:\n1. தாயுமானவர் திருச்சியை ஆண்ட விஜயரகுநாத சொக்கலிங்கரிடம் தலைமைக் கணக்கராகப் பணியாற்றினார்.\n2. இவரது பாடல்கள் 'தாயுமானவர் திருப்பாடல் திரட்டு' என வழங்கப்படுகிறது.\n3. தாயுமானவர் பாடல்களைத் 'தமிழ்மொழியின் உபநிடதம்' என அறிஞர்கள் போற்றுகின்றனர்.", "media_id": null}], "options": {"A": "1, 2, 3 ஆகிய அனைத்தும் சரி", "B": "1, 2 மட்டும் சரி", "C": "2, 3 மட்டும் சரி", "D": "1 மட்டும் சரி"}, "explanation": "விஜயரகுநாத சொக்கலிங்கர் தலைமைக் கணக்கர், திருப்பாடல் திரட்டு, தமிழ்மொழியின் உபநிடதம். மூன்றும் TNPSC தேர்வுகளின் மிக முக்கிய வினாக்கள்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "தாயுமானவர் திருச்சியை ஆண்ட விஜயரகுநாத சொக்கலிங்கரிடம் தலைமைக் கணக்கராகப் பணியாற்றினார்.", "content_en": null}, {"id": "S2", "content_ta": "இவரது பாடல்கள் 'தாயுமானவர் திருப்பாடல் திரட்டு' என வழங்கப்படுகிறது.", "content_en": null}, {"id": "S3", "content_ta": "தாயுமானவர் பாடல்களைத் 'தமிழ்மொழியின் உபநிடதம்' என அறிஞர்கள் போற்றுகின்றனர்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "n