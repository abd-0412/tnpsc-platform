{"id": "6th-t3-u3-046", "schema_version": "1.0", "kind": "match_4x4", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆளுமைகளையும் அவர்களுக்குரிய அமைப்புகளையும் பொருத்துக:\n(a) வள்ளலார் - 1. Bachpan Bachao Andolan\n(b) அன்னை தெரசா - 2. சத்திய தரும சாலை\n(c) கைலாஷ் சத்யார்த்தி - 3. மிஷனரீஸ் ஆஃப் சாரிட்டி (கருணை இல்லம்)\n(d) இளம்பெருவழுதி - 4. புறநானூறு", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-3, (c)-1, (d)-4", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-4, (b)-3, (c)-2, (d)-1"}, "explanation": "வள்ளலார்: சத்திய தரும சாலை; தெரசா: மிஷனரீஸ் ஆஃப் சாரிட்டி; சத்யார்த்தி: Bachpan Bachao Andolan; இளம்பெருவழுதி: புறநானூறு."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L_A", "content_ta": "வள்ளலார்", "content_en": null}, {"id": "L_B", "content_ta": "அன்னை தெரசா", "content_en": null}, {"id": "L_C", "content_ta": "கைலாஷ் சத்யார்த்தி", "content_en": null}, {"id": "L_D", "content_ta": "இளம்பெருவழுதி", "content_en": null}], "right": [{"id": "R1", "content_ta": "Bachpan Bachao Andolan", "content_en": null}, {"id": "R2", "content_ta": "சத்திய தரும சாலை", "content_en": null}, {"id": "R3", "content_ta": "மிஷனரீஸ் ஆஃப் சாரிட்டி (கருணை இல்லம்)", "content_en": null}, {"id": "R4", "content_ta": "புறநானூறு", "content_en": null}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value":