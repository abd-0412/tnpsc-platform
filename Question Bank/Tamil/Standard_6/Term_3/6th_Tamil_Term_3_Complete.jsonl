{"id": "6th-t3-pyq-053", "schema_version": "1.0", "kind": "match_4x4", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆளுமைகளையும் அவர்களுக்குரிய சிறப்புப் பட்டங்களையும் பொருத்துக:\n(a) தாயுமானவர் - 1. தமிழ்மொழியின் உபநிடதம் தந்த தத்துவக் கவிஞர்\n(b) கவிமணி - 2. கவிமணி (1940 பட்டம்)\n(c) வள்ளலார் - 3. திருவருட்பிரகாச வள்ளலார்\n(d) மு. மேத்தா - 4. வானம்பாடிக் கவிஞர்", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-1, (c)-4, (d)-3", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-4, (b)-3, (c)-2, (d)-1"}, "explanation": "தாயுமானவர்: தமிழ்மொழியின் உபநிடதம்; கவிமணி: கவிமணி; வள்ளலார்: திருவருட்பிரகாசர்; மு. மேத்தா: வானம்பாடிக் கவிஞர்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L_A", "content_ta": "தாயுமானவர்", "content_en": null}, {"id": "L_B", "content_ta": "கவிமணி", "content_en": null}, {"id": "L_C", "content_ta": "வள்ளலார்", "content_en": null}, {"id": "L_D", "content_ta": "மு. மேத்தா", "content_en": null}], "right": [{"id": "R1", "content_ta": "தமிழ்மொழியின் உபநிடதம் தந்த தத்துவக் கவிஞர்", "content_en": null}, {"id": "R2", "content_ta": "கவிமணி (1940 பட்டம்)", "content_en": null}, {"id": "R3", "content_ta": "திருவருட்பிரகாச வள்ளலார்", "content_en": null}, {"id": "R4", "content_ta": "வானம்பாடிக் கவிஞர்", "content_en": null}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": []