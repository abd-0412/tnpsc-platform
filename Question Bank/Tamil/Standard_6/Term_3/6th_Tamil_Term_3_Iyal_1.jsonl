{"id": "6th-t3-u1-054", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காந்தியடிகள் குறித்த கூற்றுகளுள் தவறான ஒன்றைத் தேர்ந்தெடுக்க:", "media_id": null}], "options": {"A": "காந்தியடிகளுக்குத் தமிழ் கற்கும் ஆர்வத்தை ஏற்படுத்தியவர் உ.வே.சா", "B": "காந்தியடிகள் தமிழ்நாட்டில் மட்டுமே வேட்டி சட்டை அணிவதைத் தவிர்த்தார்; வடமாநிலங்களில் வழக்கம் போல் முழு ஆடை அணிந்தார்", "C": "காந்தியடிகள் தென்னாப்பிரிக்காவில் வாழ்ந்தபோதே தமிழ் கற்கத் தொடங்கினார்", "D": "ஜி.யு. போப் எழுதிய தமிழ்க் கையேடு காந்தியடிகளைக் கவர்ந்தது"}, "explanation": "மதுரையில் மேற்கொண்ட ஆடை மாற்றத்தை காந்தியடிகள் தம் வாழ்நாள் முழுவதும் உலக நாடுகளுக்குச் சென்றபோதும் இறுதிவரை மாற்றவேயில்லை. எனவே B தவறானது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": true, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "3", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "S