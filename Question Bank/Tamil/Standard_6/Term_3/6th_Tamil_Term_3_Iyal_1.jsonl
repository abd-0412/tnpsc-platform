{"id": "6th-t3-u1-095", "schema_version": "1.0", "kind": "match_4x4", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வினா எழுத்துகளின் இடத்தையும் சான்றுகளையும் பொருத்துக:\n(a) மொழி முதலில் வருபவை - 1. பேசலாமா? தெரியுமோ?\n(b) மொழி இறுதியில் வருபவை - 2. ஏன்? நீதானே?\n(c) முதலிலும் இறுதியிலும் வருபவை - 3. எங்கு? யாருக்கு?\n(d) புறவினா - 4. அவனா? வருவானோ?", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-1, (c)-4, (d)-3", "C": "(a)-3, (b)-1, (c)-2, (d)-4", "D": "(a)-4, (b)-3, (c)-2, (d)-1"}, "explanation": "மொழி முதல்: எங்கு, யாருக்கு (எ, யா); மொழி இறுதி: பேசலாமா, தெரியுமோ (ஆ, ஓ); முதலிலும் இறுதியிலும்: ஏன், நீதானே (ஏ); புறவினா: அவனா, வருவானோ."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [{"id": "L_A", "content_ta": "மொழி முதலில் வருபவை", "content_en": null}, {"id": "L_B", "content_ta": "மொழி இறுதியில் வருபவை", "content_en": null}, {"id": "L_C", "content_ta": "முதலிலும் இறுதியிலும் வருபவை", "content_en": null}, {"id": "L_D", "content_ta": "புறவினா", "content_en": null}], "right": [{"id": "R1", "content_ta": "பேசலாமா? தெரியுமோ?", "content_en": null}, {"id": "R2", "content_ta": "ஏன்? நீதானே?", "content_en": null}, {"id": "R3", "content_ta": "எங்கு? யாருக்கு?", "content_en": null}, {"id": "R4", "content_ta": "அவனா? வருவானோ?", "content_en": null}]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "3", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6 Tamil Term 3, Unit 1 - சுட்டு எழுத்துகள், வினா எழுத்துகள்", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_3", "match_4x4"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t3-u1-096", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'எது', 'யார்', 'ஏன்' ஆகிய சொற்கள் புறவினாவுக்குச் சான்றுகள் ஆகும்.\nகாரணம் (R): இச்சொற்களில் உள்ள வினா எழுத்துகளை நீக்கினாலும் பிற எழுத்துகள் பொருள் தரும்.", "media_id": null}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி", "B": "கூற்று சரி, காரணம் தவறு", "C": "கூற்று தவறு, காரணம் சரி", "D": "கூற்று மற்றும் காரணம் இரண்டும் தவறு"}, "explanation": "எது, யார், ஏன் என்பவை 'அகவினா' ஆகும் (வினா எழுத்தை நீக்கினால் பொருள் தராது). எனவே கூற்றும் காரணமும் தவறு."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'எது', 'யார்', 'ஏன்' ஆகிய சொற்கள் புறவினாவுக்குச் சான்றுகள் ஆகும்.", "reason": "இச்சொற்களில் உள்ள வினா எழுத்துகளை நீக்கினாலும் பிற எழுத்துகள் பொருள் தரும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "3", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "referen