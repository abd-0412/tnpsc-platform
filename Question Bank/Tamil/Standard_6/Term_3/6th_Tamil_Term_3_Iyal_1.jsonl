{"id": "6th-t3-u1-091", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'இவன்', 'அவள்' ஆகிய சொற்களில் உள்ள சுட்டு எழுத்துகளை நீக்கினால் பிற எழுத்துகள் பொருள் தருவதில்லை.\nகாரணம் (R): சொல்லின் அகத்தே (உள்ளே) இருந்து சுட்டுப் பொருளைத் தருவது அகச்சுட்டு எனப்படும்.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு", "B": "கூற்று தவறு, காரணம் சரி", "C": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் சரியான விளக்கம்", "D": "இரண்டும் தவறு"}, "explanation": "சுட்டெழுத்தை நீக்கினால் பொருள் தராமல் சொல்லின் உள்ளேயே இருப்பது அகச்சுட்டு எனப்படும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'இவன்', 'அவள்' ஆகிய சொற்களில் உள்ள சுட்டு எழுத்துகளை நீக்கினால் பிற எழுத்துகள் பொருள் தருவதில்லை.", "reason": "சொல்லின் அகத்தே (உள்ளே) இருந்து சுட்டுப் பொருளைத் தருவது அகச்சுட்டு எனப்படும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "3", "edition": "2024-2025", "publication_year": "2025",