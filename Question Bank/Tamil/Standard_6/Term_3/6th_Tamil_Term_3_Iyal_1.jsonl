{"id": "6th-t3-u1-070", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "hard", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வேலுநாச்சியார் திண்டுக்கல் கோட்டையில் தங்கியிருந்த காலம் குறித்த செய்திகளை ஆராய்க:\n1. கணவரை இழந்த வேலுநாச்சியார் திண்டுக்கல் அருகே விருப்பாட்சிக் கோட்டையில் 8 ஆண்டுகள் தங்கியிருந்தார்.\n2. அங்கு கோபால நாயக்கரின் ஆதரவுடன் படைகளைத் திரட்டினார்.\n3. 1780-ல் சிவகங்கையை மீட்கும் வரை அவர் உறுதி தளராமல் உழைத்தார்.", "media_id": null}], "options": {"A": "1, 2 மட்டும் சரி", "B": "1, 2, 3 ஆகிய அனைத்தும் சரி", "C": "2, 3 மட்டும் சரி", "D": "1 மட்டும் சரி"}, "explanation": "8 ஆண்டுகள் திண்டுக்கல்லில் தங்கிப் படை திரட்டியதும், கோபால நாயக்கர் அடைக்கலம் தந்ததும், 1780-ல் மீட்டதும் சரியான தகவல்கள்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "கணவரை இழந்த வேலுநாச்சியார் திண்டுக்கல் அருகே விருப்பாட்சிக் கோட்டையில் 8 ஆண்டுகள் தங்கியிருந்தார்.", "content_en": null}, {"id": "S2", "content_ta": "அங்கு கோபால நாயக்கரின் ஆதரவுடன் படைகளைத் திரட்டினார்.", "content_en": null}, {"id": "S3", "content_ta": "1780-ல் சிவகங்கையை மீட்கும் வரை அவர் உறுதி தளராமல் உழைத்தார்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multip