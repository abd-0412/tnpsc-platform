// 1919 பிப்ரவரி சென்னை ராஜாஜி இல்லம், பாரதியார் சந்திப்பு ("இவரைப் பத்திரமாகப் பாதுகாக்க வேண்டும்"), 1921 செப்டம்பர் மதுரை எளிய ஆடை புரட்சி, காரைக்குடி கானாடுகாத்தான் வெளிநாட்டுப் பொருள் துறப்பு, மதுரை மீனாட்சியம்மன் கோவில் ஆலயப் பிரவேசம் 1946, குற்றால அருவி தீண்டாமை எதிர்ப்பு, ஜி.யு. போப் தமிழ்க் கையேடு, திருக்குறள், டால்ஸ்டாய், 1937 சென்னை இலக்கிய மாநாடு - உ.வே.சா தலைமையுரை ("அடிநிழலில் இருந்து தமிழ் கற்க ஆவல்"), திரு.வி.க மொழிபெயர்ப்பு, தமிழ்க் கையெழுத்து
// ==============================================================================
{"id": "6th-t3-u1-041", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "3", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "1919-ல் காந்தியடிகள் சென்னை வந்த நிகழ்வு குறித்த சரியான கூற்றுகளைத் தேர்க:\n1. 1919 பிப்ரவரி மாதம் ரௌலட் சட்டத்தை எதிர்த்துப் போராடக் காந்தியடிகள் சென்னை வந்தார்.\n2. காந்தியடிகள் சென்னையில் ராஜாஜியின் இல்லத்தில் தங்கியிருந்தார்.\n3. அப்போது காந்தியடிகளைச் சந்தித்த பாரதியார், மாலையில் தாம் ஏற்பாடு செய்திருந்த பொதுக்கூட்டத்திற்குத் தலைமை தாங்க அழைத்தார்.", "media_id": null}], "options": {"A": "1, 2, 3 ஆகிய அனைத்தும் சரி", "B": "1, 2 மட்டும் சரி", "C": "2, 3 மட்டும் சரி", "D": "1 மட்டும் சரி"}, "explanation": "1919 பிப்ரவரி சென்னை வருகை, ராஜாஜி இல்லம், பாரதியாரின் சந்திப்பு மற்றும் அழைப்பு ஆகியவை வரலாற்று உண்மை."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "1919 பிப்ரவரி மாதம் ரௌலட் சட்டத்தை எதிர்த்துப் போராடக் காந்தியடிகள் சென்னை வந்தார்.", "content_en": null}, {"id": "S2", "content_ta": "காந்தியடிகள் சென்னையில் ராஜாஜியின் இல்லத்தில் தங்கியிருந்தார்.", "content_en": null}, {"id": "S3", "content_ta": "அப்போது காந்தியடிகளைச் சந்தித்த பாரதியார், மாலையில் தாம் ஏற்பாடு செய்திருந்த பொதுக்கூட்டத்திற்குத் தலைமை தாங்க அழைத்தார்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings":