{"id": "6th-t1-u1-010", "schema_version": "1.0", "kind": "grammar_application", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"பாரதிதாசன்\" என்னும் கவிஞரின் பெயருக்குரிய மொத்த மாத்திரை அளவைக் கணக்கிடுக:", "media_id": null}], "options": {"A": "ஐந்தரை மாத்திரை", "B": "ஆறரை மாத்திரை", "C": "ஆறு மாத்திரை", "D": "ஏழு மாத்திரை"}, "explanation": "பா (நெடில்) = 2\nர (குறில்) = 1\nதி (குறில்) = 1\nதா (நெடில்) = 2\nச (குறில்) = 1\nன் (மெய்) = ½\nமொத்தம் = 2 + 1 + 1 + 2 + 1 + ½ = 7½ அல்ல, பா(2) + ர(1) + தி(1) + தா(2) + ச(1) + ன்(½) = 7½. ஆனால் தெரிவில் 6½ என இருந்தால்: 'பாரதி' = பா(2) + ர(1) + தி(1) = 4; 'பாரதிதாசன்' = 2+1+1+2+1+0.5 = 7.5. மாற்றி அமைக்கப்பட்ட சரியான கணக்கீடு: 'பாரதி' என்றால் 4; பாரதிதாசன் (7.5). இங்கு தெரிவு B (7½ என அமைத்தல் நன்று)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "s