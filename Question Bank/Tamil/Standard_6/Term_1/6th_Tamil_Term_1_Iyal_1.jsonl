{"id": "6th-t1-u1-001", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதிதாசன் மற்றும் அவர்தம் படைப்புகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. பாரதிதாசனின் இயற்பெயர் சுப்புரத்தினம்; இவர் பாரதியாரின் கவிதைகள் மீது கொண்ட பற்றின் காரணமாகத் தம் பெயரைப் பாரதிதாசன் என மாற்றிக்கொண்டார்.\n2. தம் கவிதைகளில் பெண்கல்வி, கைம்பெண் மறுமணம், பொதுவுடைமை, பகுத்தறிவு முதலான புரட்சிகரமான கருத்துகளைப் பாடுபொருளாகப் பாடியுள்ளார்.\n3. இவர் புரட்சிக்கவி என்றும் பாவேந்தர் என்றும் சிறப்பித்துப் போற்றப்படுகிறார்.\n4. சமச்சீர் பாடப்பகுதியில் இடம்பெற்றுள்ள இன்பத்தமிழ் என்னும் பாடல் 'பாரதிதாசன் கவிதைகள்' என்ற நூலில் 'செந்தமிழ்' என்னும் தலைப்பின்கீழ் இடம்பெற்றுள்ளது.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2, 3 ஆகியவை சரியானவை; 4 தவறானது", "B": "கூற்றுகள் 1, 2, 4 ஆகியவை சரியானவை; 3 தவறானது", "C": "கூற்றுகள் 2, 3, 4 ஆகியவை சரியானவை; 1 தவறானது", "D": "கூற்றுகள் 1, 2, 3, 4 ஆகிய அனைத்தும் சரியானவை"}, "explanation": "கூற்றுகள் 1, 2, 3 முற்றிலும் சரியானவை. கூற்று 4 தவறானது; ஏனெனில் இன்பத்தமிழ் பாடல் பாரதிதாசன் கவிதைகள் என்ற நூலில் 'தமிழ்' என்னும் தலைப்பின்கீழ்தான் இடம்பெற்றுள்ளது ('செந்தமிழ்' என்பது தேர்வுப் பொறிக்கான தவறான திசைதிருப்பல்)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பாரதிதாசனின் இயற்பெயர் சுப்புரத்தினம்; இவர் பாரதியாரின் கவிதைகள் மீது கொண்ட பற்றின் காரணமாகத் தம் பெயரைப் பாரதிதாசன் என மாற்றிக்கொண்டார்.", "content_en": null}, {"id": "S2", "content_ta": "தம் கவிதைகளில் பெண்கல்வி, கைம்பெண் மறுமணம், பொதுவுடைமை, பகுத்தறிவு முதலான புரட்சிகரமான கருத்துகளைப் பாடுபொருளாகப் பாடியுள்ளார்.", "content_en": null}, {"id": "S3", "content_ta": "இவர் புரட்சிக்கவி என்றும் பாவேந்தர் என்றும் சிறப்பித்துப் போற்றப்படுகிறார்.", "content_en": null}, {"id": "S4", "content_ta": "சமச்சீர் பாடப்பகுதியில் இடம்பெற்றுள்ள இன்பத்தமிழ் என்னும் பாடல் 'பாரதிதாசன் கவிதைகள்' என்ற நூலில் 'செந்தமிழ்' என்னும் தலைப்பின்கீழ் இடம்பெற்றுள்ளது.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "6th Tamil, Term 1, Unit 1, Page 3", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u1-002", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் மொழியின் தொன்மை மற்றும் சிறப்புகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. உலகில் ஆறாயிரத்திற்கும் மேற்பட்ட மொழிகள் உள்ளன; இவற்றுள் சில மொழிகள் மட்டுமே பேச்சு வடிவம், எழுத்து வடிவம் ஆகிய இரண்டையும் பெற்றுள்ளன.\n2. \"யாமறிந்த மொழிகளிலே தமிழ்மொழி போல் இனிதாவது எங்கும் காணோம்\" என்று தமிழின் இனிமையை வியந்து பாரதிதாசன் பாடியுள்ளார்.\n3. சாலைகள் தோன்றிய பிறகே சாலை விதிகள் தோன்றியிருக்கும்; அதுபோல இலக்கியம் தோன்றிய பிறகே அதற்குரிய இலக்கண விதிகள் தோன்றியிருக்க வேண்டும்.\n4. தமிழில் நமக்குக் கிடைத்துள்ள மிகப் பழைமையான இலக்கண நூல் தொல்காப்பியம் ஆகும்.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2, 4 ஆகியவை சரியானவை; 3 தவறானது", "B": "கூற்றுகள் 1, 3, 4 ஆகியவை சரியானவை; 2 தவறானது", "C": "கூற்றுகள் 2, 3, 4 ஆகியவை சரியானவை; 1 தவறானது", "D": "கூற்றுகள் அனைத்தும் சரியானவை"}, "explanation": "கூற்றுகள் 1, 3, 4 சரியானவை. கூற்று 2 தவறானது; ஏனெனில் 'யாமறிந்த மொழிகளிலே தமிழ்மொழி போல் இனிதாவது எங்கும் காணோம்' என்று பாடியவர் மகாகவி பாரதியார் ஆவார் (பாரதிதாசன் அல்ல)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "உலகில் ஆறாயிரத்திற்கும் மேற்பட்ட மொழிகள் உள்ளன; இவற்றுள் சில மொழிகள் மட்டுமே பேச்சு வடிவம், எழுத்து வடிவம் ஆகிய இரண்டையும் பெற்றுள்ளன.", "content_en": null}, {"id": "S2", "content_ta": "\"யாமறிந்த மொழிகளிலே தமிழ்மொழி போல் இனிதாவது எங்கும் காணோம்\" என்று தமிழின் இனிமையை வியந்து பாரதிதாசன் பாடியுள்ளார்.", "content_en": null}, {"id": "S3", "content_ta": "சாலைகள் தோன்றிய பிற