{"id": "6th-t1-u1-044", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பூவின் நிலைகளை அவற்றின் பொருள்களோடு பொருத்துக:\nபட்டியல் I:\nஅ) அரும்பு\nஆ) முகை\nஇ) அலர்\nஈ) செம்மல்\n\nபட்டியல் II:\n1. மலர் விரியத் தொடங்கும் நிலை\n2. பூ வாடின நிலை\n3. பூவின் தோற்ற நிலை\n4. மலர்ந்த நிலை", "media_id": null}], "options": {"A": "1, 3, 4, 2", "B": "4, 1, 2, 3", "C": "2, 4, 1, 3", "D": "3, 1, 4, 2"}, "explanation": "அ) அரும்பு - தோற்ற நிலை (3)\nஆ) முகை - விரியத் தொடங்கும் நிலை (1)\nஇ) அலர் - மலர்ந்த நிலை (4)\nஈ) செம்மல் - பூ வாடின நிலை (2)\nசரியான வரிசை: 3, 1, 4, 2."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "6th Tamil, Term 1, Unit 1, Page 7", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam"