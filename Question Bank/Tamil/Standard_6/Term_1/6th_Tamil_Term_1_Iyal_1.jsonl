{"id": "6th-t1-u1-078", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'மா' என்னும் சொல்லின் பல்வேறு பொருள்களைப் பொருத்துக:\nபட்டியல் I (பொருட்கள்):\nஅ) இயற்கை / தாவரம்\nஆ) உயிரினம்\nஇ) அளவு / வடிவம்\nஈ) வணக்கம் / செல்வம்\n\nபட்டியல் II (சொற்கள்):\n1. விலங்கு\n2. மரம்\n3. திருமகள்\n4. பெரிய", "media_id": null}], "options": {"A": "1, 2, 3, 4", "B": "2, 1, 4, 3", "C": "2, 4, 1, 3", "D": "4, 1, 2, 3"}, "explanation": "பாடநூலில் 'மா' என்பதன் பொருள்கள்:\nஅ) தாவரம் - மரம் (2)\nஆ) உயிரினம் - விலங்கு (1)\nஇ) வடிவம்/பண்பு - பெரிய (4)\nஈ) வணக்கம்/செல்வம் - திருமகள் (3)\nசரியான பொருத்தம்: 2, 1, 4, 3."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "6th Tamil, Term 1, Unit 1, Page 7", "url": null, "source_notes": null}, "previous_ye