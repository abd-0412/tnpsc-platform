{"id": "6th-t1-u1-083", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மெய் எழுத்துகளின் வகைகளையும் அவற்றுக்குரிய எழுத்துகளையும் பொருத்துக:\nபட்டியல் I:\nஅ) வல்லினம்\nஆ) மெல்லினம்\nஇ) இடையினம்\nஈ) ஆய்தம்\n\nபட்டியல் II:\n1. ங், ஞ், ண், ந், ம், ன்\n2. ய், ர், ல், வ், ழ், ள்\n3. க், ச், ட், த், ப், ற்\n4. ஃ", "media_id": null}], "options": {"A": "1, 2, 3, 4", "B": "3, 2, 1, 4", "C": "3, 1, 2, 4", "D": "2, 3, 1, 4"}, "explanation": "அ) வல்லினம் - க், ச், ட், த், ப், ற் (3)\nஆ) மெல்லினம் - ங், ஞ், ண், ந், ம், ன் (1)\nஇ) இடையினம் - ய், ர், ல், வ், ழ், ள் (2)\nஈ) ஆய்தம் - ஃ (4)\nசரியான வரிசை: 3, 1, 2, 4."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "6th Tamil, Term 1, Unit 1, Page 15", "url": null, "source_notes": null}, "p