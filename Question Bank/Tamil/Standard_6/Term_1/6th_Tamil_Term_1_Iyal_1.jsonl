{"id": "6th-t1-u1-075", "schema_version": "1.0", "kind": "grammar_application", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆய்த எழுத்து இடம்பெற்றுள்ள \"அஃது\" என்னும் சொல்லுக்குரிய மொத்த மாத்திரை அளவைக் கண்டறிக:", "media_id": null}], "options": {"A": "ஒன்றரை மாத்திரை", "B": "இரண்டு மாத்திரை", "C": "இரண்டரை மாத்திரை", "D": "மூன்று மாத்திரை"}, "explanation": "அ (உயிர்க்குறில்) = 1 மாத்திரை\nஃ (ஆய்த எழுத்து) = ½ மாத்திரை\nது (உயிர்மெய்க்குறில்) = 1 மாத்திரை\nமொத்தம் = 1 + ½ + 1 = 2½ (இரண்டரை மாத்திரை)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "6th Tamil, Term 1, Unit 1, Page 15, 16", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_num