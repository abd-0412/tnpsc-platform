{"id": "6th-t1-u1-071", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் எழுத்துகளின் வகையும் தொகையும் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. தமிழ் மொழியின் இலக்கண வகைகள் ஐந்து; அவை எழுத்து, சொல், பொருள், யாப்பு, அணி என்பனவாகும்.\n2. இயல்பாகக் காற்று வெளிப்படும்போது வாயைத் திறத்தல், உதடுகளை விரித்தல், உதடுகளைக் குவித்தல் ஆகிய எளிய செயல்பாடுகளால் 12 உயிர் எழுத்துகளும் பிறக்கின்றன.\n3. மெய் எழுத்துகள் பதினெட்டும் ஒலிப்பதற்கு உடல் இயக்கத்தின் பங்கு தேவைப்படுவதில்லை.\n4. மெய்யுடன் உயிர்க்குறில் சேர்ந்தால் உயிர்மெய்க் குறிலும், மெய்யுடன் உயிர்நெடில் சேர்ந்தால் உயிர்மெய் நெடிலும் தோன்றுகின்றன.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 3, 4 ஆகியவை சரியானவை", "B": "கூற்றுகள் 2, 3 ஆகியவை சரியானவை", "C": "கூற்றுகள் 1, 2, 4 ஆகியவை சரியானவை; 3 தவறானது", "D": "கூற்றுகள் 1, 2, 3 ஆகியவை சரியானவை"}, "explanation": "கூற்றுகள் 1, 2, 4 சரியானவை. கூற்று 3 தவறானது; மெய் என்பது உடம்பு எனப் பொருள்படும்; மெய் எழுத்துகளை ஒலிக்க உடல் இயக்கத்தின் பங்கு இன்றியமையாதது என்று பாடநூல் தெளிவாகக் குறிப்பிடுகிறது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "தமிழ் மொழியின் இலக்கண வகைகள் ஐந்து; அவை எழுத்து, சொல், பொருள், யாப்பு, அணி என்பனவாகும்.", "content_en": null}, {"id": "S2", "content_ta": "இயல்பாகக் காற்று வெளிப்படும்போது வாயைத் திறத்தல், உதடுகளை விரித்தல், உதடுகளைக் குவித்தல் ஆகிய எளிய செயல்பாடுகளால் 12 உயிர் எழுத்துகளும் பிறக்கின்றன.", "content_en": null}, {"id": "S3", "content_ta": "மெய் எழுத்துகள் பதினெட்டும் ஒலிப்பதற்கு உடல் இயக்கத்தின் பங்கு தேவைப்படுவதில்லை.", "content_en": null}, {"id": "S4", "content_ta": "மெய்யுடன் உயிர்க்குறில் சேர்ந்தால் உயிர்மெய்க் குறிலும், மெய்யுடன் உயிர்நெடில் சேர்ந்தால் உயிர்மெய் நெடிலும் தோன்றுகின்றன.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "6th Tamil, Term 1, Unit 1, Page 14, 15, 16", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u1-072", "schema_version": "1.0", "kind": "grammar_application", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்காணும் சொற்களுள், இடையின மெய் எழுத்துகளை மட்டுமே கொண்டுள்ள சொல்லைத் தெரிவு செய்க:", "media_id": null}], "options": {"A": "கொக்கு", "B": "சங்கு", "C": "பந்து", "D": "செவ்வாய்"}, "explanation": "இடையின மெய் எழுத்துகள்: ய், ர், ல், வ், ழ், ள்.\n'செவ்வாய்' என்னும் சொல்லில் இடம்பெற்றுள்ள மெய் எழுத்துகள் 'வ்', 'ய்' ஆகிய இரண்டும் இடையின எழுத்துகள் ஆகும். பிற தெரிவுகளில்: கொக்கு (க் - வல்லினம்), சங்கு (ங் - மெல்லினம்), பந்து (ந் - மெல்லினம்)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "6th Tamil, Term 1, Unit 1, Page 15, 16", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": nu