{"id": "6th-t1-u2-030", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பறவைகள் வலசை போதலின் திசைகள் மற்றும் காரணங்கள் குறித்த கூற்றுகளை ஆராய்க:\n1. பறவைகள் பொதுவாக மேற்கிலிருந்து வடக்கு நோக்கியும், தெற்கிலிருந்து கிழக்கு நோக்கியும் வலசை போகின்றன.\n2. நீர்வாழ் பறவைகளே பெரும்பாலும் வலசை போகின்றன.\n3. தட்பவெப்பநிலை மாற்றம் மற்றும் இனப்பெருக்கம் ஆகியவை பறவைகள் இடம்பெயர்வதற்கான முதன்மைக் காரணங்கள் ஆகும்.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2 ஆகியவை சரியானவை", "B": "கூற்றுகள் 2, 3 ஆகியவை சரியானவை; 1 தவறானது", "C": "கூற்றுகள் 1, 3 ஆகியவை சரியானவை", "D": "கூற்றுகள் அனைத்தும் சரியானவை"}, "explanation": "கூற்றுகள் 2 மற்றும் 3 சரியானவை. கூற்று 1 தவறானது; பறவைகள் 'வடக்கிலிருந்து தெற்கு நோக்கியும், மேற்கிலிருந்து கிழக்கு நோக்கியும்' வலசை போகின்றன (திசை மாற்றிக் கூறப்பட்டுள்ளது)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பறவைகள் பொதுவாக மேற்கிலிருந்து வடக்கு நோக்கியும், தெற்கிலிருந்து கிழக்கு நோக்கியும் வலசை போகின்றன.", "content_en": null}, {"id": "S2", "content_ta": "நீர்வாழ் பறவைகளே பெரும்பாலும் வலசை போகின்றன.", "content_en": null}, {"id": "S3", "content_ta": "தட்பவெப்பநிலை மாற்றம் மற்றும் இனப்பெருக்கம் ஆகியவை பறவைகள் இடம்பெயர்வதற்கான முதன்மைக் காரணங்கள் ஆகும்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "match