{"id": "6th-t1-u2-061", "schema_version": "1.0", "kind": "grammar_application", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"முதலெழுத்துகளைச் சார்ந்து இயங்குவதால் ஆய்த எழுத்து சார்பெழுத்து ஆகும்.\" - இவ்விலக்கண விதிப்படி ஆய்த எழுத்து சார்ந்தியங்கும் முதல் எழுத்துகள் எவை?", "media_id": null}], "options": {"A": "உயிரும் மெய்யும்", "B": "மெய்யும் உயிர்மெய்யும்", "C": "உயிரும் சார்பெழுத்தும்", "D": "வல்லினமும் மெல்லினமும்"}, "explanation": "முதல் எழுத்துகளாகிய உயிரையும் (தனக்கு முன் குறில்) மெய்யையும் (தனக்குப் பின் வல்லின உயிர்மெய்) சார்ந்து இயங்குவதால் ஆய்த எழுத்து சார்பெழுத்து ஆகும் என்று பாடநூல் விளக்குகிறது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "6th Tamil, Term 1, Unit 2, Page 34", "url": null, "source_notes": null}, "previous_year": {"is_previou