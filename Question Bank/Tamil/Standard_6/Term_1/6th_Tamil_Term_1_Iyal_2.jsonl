{"id": "6th-t1-u2-013", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-6th-u2-iyarkai", "lesson_id": "lesson-01-edhilikkuruvigal", "chapter_id": null, "topic_id": "topic-azhagiya-periyavan-works", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அழகிய பெரியவனின் படைப்புகளையும் அவற்றின் இலக்கிய வகைமைகளையும் பொருத்துக:\nபட்டியல் I:\nஅ) தகப்பன் கொடி\nஆ) குறடு\nஇ) நெரிக்கட்டு\nஈ) பெருகும் வேட்கை\nபட்டியல் II:\n1. கட்டுரை\n2. கவிதை\n3. சிறுகதை\n4. புதினம்", "media_id": null}], "options": {"A": "அ-4, ஆ-3, இ-2, ஈ-1", "B": "அ-3, ஆ-4, இ-1, ஈ-2", "C": "அ-4, ஆ-2, இ-3, ஈ-1", "D": "அ-2, ஆ-1, இ-4, ஈ-3"}, "explanation": "பாடநூல் நூல் வெளிப்படி: தகப்பன் கொடி - புதினம் (4); குறடு - சிறுகதை (3); நெரிக்கட்டு - கவிதை (2); பெருகும் வேட்கை - கட்டுரை (1). சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": "Match the literary works of Azhagiya Periyavan with their respective genres:\nList I: (a) Thakappan Kodi (b) Kuradu (c) Nerikkattu (d) Perugum Vaetkai\nList II: 1. Essay 2. Poetry 3. Short Story 4. Novel", "media_id": null}], "options": {"A": "(a)-4, (b)-3, (c)-2, (d)-1", "B": "(a)-3, (b)-4, (c)-1, (d)-2", "C": "(a)-4, (b)-2, (c)-3, (d)-1", "D": "(a)-2, (b)-1, (c)-4, (d)-3"}, "explanation": "Textbook Page 21: Thakappan Kodi - Novel (4); Kuradu - Short story (3); Nerikkattu - Poetry (2); Perugum Vaetkai - Essay (1). Correct order: 4, 3, 2, 1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": ["தகப்பன் கொடி", "குறடு", "நெரிக்கட்டு", "பெருகும் வேட்கை"], "right": ["புதினம்", "சிறுகதை", "கவிதை", "கட்டுரை"]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "textbook", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": 21, "chapter": "lesson-01-edhilikkuruvigal", "section": null, "reference": "6th Std Tamil Term 1, Page 21", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "literature"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
