{"id": "6th-t1-u2-075", "schema_version": "1.0", "kind": "grammar_application", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கீழ்க்காணும் சொற்களுள், சரியான இலக்கண விதிகளின்படி ஆய்த எழுத்து அமைந்த சொல் எது?", "media_id": null}], "options": {"A": "ஃகல்", "B": "கஃ", "C": "கஃசு", "D": "பாஃது"}, "explanation": "ஆய்த எழுத்து சொல்லின் முதலில் வராது (ஃகல் தவறு), இறுதியில் வராது (கஃ தவறு), நெடிலுக்குப் பின் வராது (பாஃது தவறு). தனக்கு முன் ஒரு குறிலையும் (க), பின் வல்லின உயிர்மெய்க் குறிலையும் (சு) பெற்றுச் சொல்லின் இடையில் வருவது 'கஃசு' மட்டுமே."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "6th Tamil, Term 1, Unit 2, Page 34", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null