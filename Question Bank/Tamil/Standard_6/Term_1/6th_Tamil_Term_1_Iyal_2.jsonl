{"id": "6th-t1-u2-035", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-6th-u2-iyarkai", "lesson_id": "lesson-03-kizhavanum-kadalum", "chapter_id": null, "topic_id": "topic-santiago-days", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): சாண்டியாகோவிற்கு கடந்த 84 நாள்களாகக் கடலில் ஒரு மீனும் கிடைக்கவில்லை; எனவே 85-ஆம் நாள் அவர் தனியாகக் கடலுக்குச் சென்றார்.\nகாரணம் (R): சாண்டியாகோவுடன் மீன்பிடிக்கப் பழக வந்த சிறுவன் மனோலின், முதல் 40 நாள்கள் அவருடன் சென்ற நிலையில் மீன் எதுவும் கிடைக்காததால் அவன் பெற்றோர் அவனை வேறு படகிற்கு அனுப்பிவிட்டனர்.", "media_id": null}], "options": {"A": "கூற்று சரி, ஆனால் காரணம் தவறு.", "B": "கூற்று தவறு, ஆனால் காரணம் சரி.", "C": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் சரியான விளக்கமாகும்.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "கூற்று மற்றும் காரணம் ஆகிய இரண்டும் சரி. 84 நாள்கள் மீன் கிடைக்காததால் மனோலினைப் பெற்றோர் வேறு படகிற்கு அனுப்பினர்; 85-ஆம் நாள் சாண்டியாகோ தனியாகக் கடலுக்குச் சென்றார் (பக்கம் 27)."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Santiago caught no fish for the past 84 days; consequently, on the 85th day, he set out to the sea alone.\nReason (R): The young boy Manolin who accompanied him to learn fishing went for the first 40 days, but catching no fish, his parents sent him to another boat.", "media_id": null}], "options": {"A": "Assertion is true, but Reason is false.", "B": "Assertion is false, but Reason is true.", "C": "Both Assertion and Reason are true, and Reason is the correct explanation.", "D": "Both Assertion and Reason are false."}, "explanation": "Both statements are true as per Page 27 of 6th Std Tamil Term 1."}}, "question_data": {"assertion": "சாண்டியாகோவிற்கு 84 நாள்களாக மீன் கிடைக்கவில்லை; 85-ஆம் நாள் தனியாகச் சென்றார்.", "reason": "மனோலினின் பெற்றோர் மீன் கிடைக்காததால் அவனை வேறு படகிற்கு அனுப்பிவிட்டனர்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "textbook", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": 27, "chapter": "lesson-03-kizhavanum-kadalum", "section": null, "reference": "6th Std Tamil Term 1, Page 27", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "santiago"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u2-036", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பறவைகள் வலசை போவதற்கு அடிப்படையாக அமைபவற்றுள் பாடநூலில் குறிப்பிடப்படாத பொருந்தாத ஒன்று எது?", "media_id": null}], "options": {"A": "நிலவு", "B": "விண்மீன்", "C": "புவிஈர்ப்புப் புலம்", "D": "கடல் அலைகளின் திசை"}, "explanation": "பாடநூலின்படி: 'நிலவு, விண்மீன், புவிஈர்ப்புப் புலம் ஆகியவற்றை அடிப்படையாகக் கொண்டே பறவைகள் இடம்பெயர்கின்றன'. 'கடல் அலைகளின் திசை' என்பது பொருந்தாத ஒன்று."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": true, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "6th Tamil, Term 1, Unit 2, Page 22", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null,