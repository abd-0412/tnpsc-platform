{"id": "6th-t1-u2-068", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): திருவள்ளுவர் 'இனிய உளவாக இன்னாத கூறல்' என்னும் குறளில் எவ்வித அணியையும் கையாளாமல் நேரடியான சொற்களை மட்டுமே பயன்படுத்தியுள்ளார்.\nகாரணம் (R): கனி இருக்கும்போது காயைத் தின்பது போல இனிய சொல் இருக்க இன்னாச்சொல் பேசுவது அமையும் என வள்ளுவர் எவ்வித உவமையும் கூறவில்லை.", "media_id": null}], "options": {"A": "கூற்று (A) சரி; காரணம் (R) தவறு.", "B": "கூற்று (A) தவறு; காரணம் (R) சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "கூற்று, காரணம் இரண்டும் முற்றிலும் தவறானவை. 'கனியிருப்பக் காய்கவர்ந் தற்று' என்பதில் 'அற்று' என்னும் உவம உருபு வெளிப்பட்டு 'உவமை அணி' பயின்று வந்துள்ளது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "திருவள்ளுவர் 'இனிய உளவாக இன்னாத கூறல்' என்னும் குறளில் எவ்வித அணியையும் கையாளாமல் நேரடியான சொற்களை மட்டுமே பயன்படுத்தியுள்ளார்.", "reason": "கனி இருக்கும்போது காயைத் தின்பது போல இனிய சொல் இருக்க இன்னாச்சொல் பேசுவது அமையும் என வள்ளுவர் எவ்வித உவமையும் கூறவில்லை.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "i