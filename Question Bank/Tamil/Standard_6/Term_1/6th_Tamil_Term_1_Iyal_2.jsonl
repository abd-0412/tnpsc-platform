{"id": "6th-t1-u2-052", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): சாண்டியாகோ கடலில் மீன் கிடைக்காத விரக்தியில் 84-ஆம் நாளே தற்கொலை செய்து கொண்டார்.\nகாரணம் (R): சாண்டியாகோவிற்கு உதவிகள் செய்ய மனோலின் என்னும் சிறுவன் ஒருநாளும் வரவில்லை.", "media_id": null}], "options": {"A": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு.", "B": "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "கூற்று, காரணம் இரண்டும் கதையின்படி முற்றிலும் தவறானவை. சாண்டியாகோ 85-ஆம் நாள் சென்று மீன் பிடித்தார்; மனோலின் முதல் 40 நாள்கள் அவருடன் வந்தான்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "சாண்டியாகோ கடலில் மீன் கிடைக்காத விரக்தியில் 84-ஆம் நாளே தற்கொலை செய்து கொண்டார்.", "reason": "சாண்டியாகோவிற்கு உதவிகள் செய்ய மனோலின் என்னும் சிறுவன் ஒருநாளும் வரவில்லை.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6"