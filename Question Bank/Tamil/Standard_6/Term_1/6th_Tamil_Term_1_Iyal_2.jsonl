{"id": "6th-t1-u2-024", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பறவைகள் தொடர்பான சிறப்புத் தகவல்களைப் பொருத்துக:\nபட்டியல் I:\nஅ) சத்திமுத்தப் புலவர்\nஆ) சலீம் அலி\nஇ) ஆர்க்டிக் ஆலா\nஈ) சிட்டுக்குருவிகள் நாள்\n\nபட்டியல் II:\n1. 22,000 கி.மீ. பயணம்\n2. மார்ச் 20\n3. இந்தியாவின் பறவை மனிதர்\n4. செங்கால் நாரை பாடல்", "media_id": null}], "options": {"A": "1, 3, 4, 2", "B": "4, 1, 3, 2", "C": "3, 4, 1, 2", "D": "4, 3, 1, 2"}, "explanation": "அ) சத்திமுத்தப் புலவர் - செங்கால் நாரை பாடல் (4)\nஆ) சலீம் அலி - இந்தியாவின் பறவை மனிதர் (3)\nஇ) ஆர்க்டிக் ஆலா - 22,000 கி.மீ. பயணம் (1)\nஈ) சிட்டுக்குருவிகள் நாள் - மார்ச் 20 (2)\nசரியான வரிசை: 4, 3, 1, 2."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "6th Tamil, Term 1, Unit 2, Page 23, 25", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "match"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u2-025", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பறவைகளின் வலசைப் பாதை மற்றும் வழித்தடங்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. பறவைகள் தங்களுக்கென ஒரு வழித்தடத்தைத் தேர்ந்தெடுத்து அந்தப் பாதையிலேயே பறக்கின்றன.\n2. சில பறவை இனங்கள் போவதற்கும் வருவதற்கும் ஒரே பாதையைப் பயன்படுத்துகின்றன.\n3. சில பறவை இனங்கள் போவதற்கும் வருவதற்கும் இருவேறு பாதைகளைப் பயன்படுத்துகின்றன.\n4. பயணம் செய்யும் போது சிலவகைப் பறவைகள் இரை, ஓய்வு போன்ற தேவைகளுக்காகத் தரை இறங்கும்; இடையில் எங்கும் நிற்காமல் பறந்து வாழிடம் சேரும் பறவைகளும் உண்டு.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 ஆகிய அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2, 3 ஆகியவை மட்டுமே சரியானவை", "C": "கூற்றுகள் 2, 3, 4 ஆகியவை மட்டுமே சரியானவை", "D": "கூற்றுகள் 1, 3, 4 ஆகியவை மட்டுமே சரியானவை"}, "explanation": "பாடநூல் உரைநடைப் பகுதியின்படி நான்கு கூற்றுகளும் 100% சரியான உண்மைகளாகும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பறவைகள் தங்களுக்கென ஒரு வழித்தடத்தைத் தேர்ந்தெடுத்து அந்தப் பாதையிலேயே பறக்கின்றன.", "content_en": null}, {"id": "S2", "content_ta": "சில பறவை இனங்கள் போவதற்கும் வருவதற்கும் ஒரே பாதையைப் பயன்படுத்துகின்றன.", "content_en": null}, {"id": "S3", "content_ta": "சில பறவை இனங்கள் போவதற்கும் வருவதற்கும் இருவேறு பாதைகளைப் பயன்படுத்துகின்றன.", "content_en": null}, {"id": "S4", "content_ta": "பயணம் செய்யும் போது சிலவகைப் பறவைகள் இரை, ஓய்வு போன்ற தேவைகளுக்காகத் தரை இறங்கும்; இடையில் எங்கும் நிற்காமல் பறந்து வாழிடம் சேரும் பறவைகளும் உண்டு.", "conten