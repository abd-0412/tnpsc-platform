{"id": "6th-t1-u2-037", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): சிட்டுக்குருவியின் எண்ணிக்கை தற்காலத்தில் மிக வேகமாக அழிந்து வருகிறது.\nகாரணம் (R): விவசாயத்தில் அளவுக்கு அதிகமாகப் பயன்படுத்தப்படும் வேதியியல் பூச்சிக்கொல்லி மருந்துகளால் குருவிக் குஞ்சுகளின் முதன்மை உணவான புழுபூச்சிகள் அழிக்கப்படுகின்றன.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) என்பது கூற்றுக்கு (A) சரியான அறிவியல் விளக்கமாகும்.", "B": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் (R) என்பது கூற்றுக்கு (A) சரியான விளக்கம் அல்ல.", "C": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு.", "D": "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி."}, "explanation": "பூச்சிக்கொல்லி மருந்துகள் புழுபூச்சிகளை அழிப்பதால் சிட்டுக்குருவிக் குஞ்சுகளுக்கு உணவின்றி அவற்றின் இனம் அழிகிறது என்பது பாடநூல் உண்மை. கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "சிட்டுக்குருவியின் எண்ணிக்கை தற்காலத்தில் மிக வேகமாக அழிந்து வருகிறது.", "reason": "விவசாயத்தில் அளவுக்கு அதிகமாகப் பயன்படுத்தப்படும் வேதியியல் பூச்சிக்கொல்லி மருந்துகளால் குருவிக் குஞ்சுகளின் முதன்மை உணவான புழுபூச்சிகள் அழிக்கப்படுகின்றன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "6th Tamil, Term 1, Unit 2, Page 24", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u2-038", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிட்டுக்குருவியின் இயல்புகளை அவற்றின் அளவுகளோடு பொருத்துக:\nபட்டியல் I:\nஅ) இடும் முட்டைகளின் எண்ணிக்கை\nஆ) அடைகாக்கும் நாள்கள்\nஇ) குஞ்சு பொரிக்கும் நாள்\nஈ) சராசரி வாழ்நாள்\n\nபட்டியல் II:\n1. 14 நாள்கள்\n2. 3 முதல் 6 முட்டைகள்\n3. 10 முதல் 14 ஆண்டுகள்\n4. 15-ஆம் நாள்", "media_id": null}], "options": {"A": "1, 2, 3, 4", "B": "2, 1, 4, 3", "C": "2, 4, 1, 3", "D": "4, 1, 2, 3"}, "explanation": "அ) முட்டைகள் - 3 முதல் 6 (2)\nஆ) அடைகாப்பது - 14 நாள்கள் (1)\nஇ) குஞ்சு பொரிப்பது - 15-ஆம் நாள் (4)\nஈ) வாழ்நாள் - 10 முதல் 14 ஆண்டுகள் (3)\nசரியான வரிசை: 2, 1, 4, 3."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "6th Tamil, Term 1, Unit 2, Page 23, 24", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "match"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u2-039", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-6th-u2-iyarkai", "lesson_id": "lesson-03-kizhavanum-kadalum", "chapter_id": null, "topic_id": "topic-manolin-dialogue", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கதையின் முடிவில் சாண்டியாகோவைக் காண வந்த சிறுவன் மனோலின் கூறிய கூற்றுகளை ஆராய்க:\n1. \"தாத்தா! நீ பிடித்த மீனைப் பார்த்தேன்; அவ்வளவு பெரிய மீனை யாரும் பிடித்ததில்லை!\"\n2. \"உன் திறமையையும் விடாமுயற்சியையும் கண்டு வியக்கிறேன்; நீதான் கடலில் பெரிய வீரன் தாத்தா!\"\n3. \"இனிமேல் நான் உன் கூடத்தான் மீன்பிடிக்க வருவேன்; உன்னிடம் கற்றுக்கொள்ள வேண்டியவை நிறைய உள்ளன.\"\n4. மனோலின் கூறிய வார்த்தைகள் சாண்டியாகோவிற்குப் புதிய புத்துணர்ச்சியையும் நம்பிக்கையையும் அளித்தன.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2 சரி; 3, 4 தவறு", "B": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "C": "அனைத்துக் கூற்றுகளும் சரியானவை", "D": "கூற்றுகள் 1, 3 சரி; 2, 4 தவறு"}, "explanation": "நான்கு கூற்றுகளும் கதையின் நிறைவுப் பகுதியில் (பக்கம் 32) மனோலின் கூறிய ஆறுதல் மற்றும் நம்பிக்கை வார்த்தைகளாகும்."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements spoken by young Manolin upon seeing Santiago at the conclusion of the story:\n1. 'Grandpa! I saw the fish you caught; no one has ever caught such a magnificent fish!'\n2. 'I marvel at your skill and relentless perseverance; you are truly the great hero of the sea, Grandpa!'\n3. 'Henceforth, I will sail only with you for fishing; I have so much to learn from you.'\n4. Manolin's words imbued Santiago with renewed energy, hope, and affirmation.", "media_id": null}], "options": {"A": "Statements 1 and 2 are correct; 3 and 4 are incorrect", "B": "Statements 2, 3, and 4 are correct; 1 is incorrect", "C": "All statements are correct", "D": "Statements 1 and 3 are correct; 2 and 4 are incorrect"}, "explanation": "All four statements are correct as per 6th Std Tamil Term 1, Page 32."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "அவ்வளவு பெரிய மீனை யாரும் பிடித்ததில்லை.", "content_en": "No one caught such a big fish."}, {"id": "S2", "content_ta": "நீதான் கடலில் பெரிய வீரன் தாத்தா.", "content_en": "You are the greatest hero of the sea."}, {"id": "S3", "content_ta": "இனிமேல் உன் கூடத்தான் மீன்பிடிக்க வருவேன்.", "content_en": "I will go fishing only with you."}, {"id": "S4", "content_ta": "மனோலின் வார்த்தைகள் சாண்டியாகோவிற்குப் புத்துணர்ச்சி தந்தன.", "content_en": "Manolin's words gave renewed energy to Santiago."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "textbook", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": 32, "chapter": "lesson-03-kizhavanum-kadalum", "section": null, "reference": "6th Std Tamil Term 1, Page 32", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "manolin"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status"