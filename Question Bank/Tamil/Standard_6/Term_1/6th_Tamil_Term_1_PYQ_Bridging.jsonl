{"id": "6th-t1-pyq-016", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காமராசரின் நினைவிடங்கள் / சிறப்புகளை அவற்றுக்குரிய இடங்களோடு பொருத்துக:\nபட்டியல் I:\n(a) மணிமண்டபம்\n(b) உள்நாட்டு விமான நிலையம்\n(c) பல்கலைக்கழகம்\n(d) நினைவு இல்லங்கள்\n\nபட்டியல் II:\n1. சென்னை மற்றும் விருதுநகர்\n2. மதுரை\n3. சென்னை\n4. கன்னியாகுமரி", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-3, (c)-4, (d)-1", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-4, (b)-3, (c)-2, (d)-1"}, "explanation": "காமராசருக்கு மணிமண்டபம் அமைக்கப்பட்ட இடம் - கன்னியாகுமரி (2.10.2000); உள்நாட்டு விமான நிலையம் - சென்னை; பல்கலைக்கழகம் - மதுரை (மதுரை காமராசர் பல்கலைக்கழகம்); நினைவு இல்லங்கள் - சென்னை மற்றும் விருதுநகர். சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "pyq_bridging", "section": null, "reference": "TNPSC Group 4 (2014, 2019) & Kamarajar Memorials", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "tnpsc", "exam_name": "group_4", "year": "2019", "paper": "general_tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "match"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-pyq-017", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாடலடிகளையும் பாடிய கவிஞர்களையும் பொருத்துக:\nபட்டியல் I:\n(a) 'தமிழுக்கும் அமுதென்று பேர் - அந்தத் தமிழின்பத் தமிழெங்கள் உயிருக்கு நேர்'\n(b) 'கொட்டுங்கடி கும்மி கொட்டுங்கடி இளங்கோதையரே கும்மி கொட்டுங்கடி'\n(c) 'காணி நிலம் வேண்டும் பராசக்தி காணி நிலம் வேண்டும்'\n(d) 'ஏடெடுத் தேன்படிப் பதற்கு - கல்வி எய்திட வேண்டுமென் றாயினாள்'\n\nபட்டியல் II:\n1. பாரதிதாசன் (தமிழியக்கம்)\n2. பாரதியார்\n3. பெருஞ்சித்திரனார்\n4. பாரதிதாசன் (இன்பத்தமிழ்)", "media_id": null}], "options": {"A": "(a)-4, (b)-3, (c)-2, (d)-1", "B": "(a)-2, (b)-1, (c)-4, (d)-3", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-1, (b)-2, (c)-3, (d)-4"}, "explanation": "'தமிழுக்கும் அமுதென்று பேர்' - பாரதிதாசன் (இன்பத்தமிழ்); 'கொட்டுங்கடி கும்மி' - பெருஞ்சித்திரனார் (தமிழ்க் கும்மி); 'காணி நிலம் வேண்டும்' - பாரதியார்; 'ஏடெடுத் தேன்படிப் பதற்கு' - பாரதிதாசன் (தமிழியக்கம்). சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, 