{"id": "6th-t1-pyq-031", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழந்தமிழர் அறிவியல் சிந்தனைகள் தொடர்பான இலக்கியக் குறிப்புகளை ஆராய்க:\n1. 'நிலம், தீ, நீர், வளி, விசும்போடு ஐந்தும் கலந்த மயக்கம் உலகம்' என்று ஐம்பூதக் கொள்கையைத் தொல்காப்பியம் கூறுகிறது.\n2. கடல்நீர் ஆவியாகி மேகமாகிப் பின் மழையாகப் பொழியும் நீர்ச்சுழற்சி முறை முல்லைப்பாட்டு, பரிபாடல், கார் நாற்பது ஆகியவற்றில் கூறப்பட்டுள்ளது.\n3. 'ஆழ அமுக்கி முகக்கினும் ஆழ்கடல்நீர் நாழி முகவாது நால்நாழி' என்று திரவப் பொருட்களின் அழுத்த இயல்பு பற்றிக் கூறியவர் ஔவையார்.\n4. போர்க்களத்தில் காயம்பட்ட வீரரின் புண்ணை வெண்ணிற ஊசியால் தைத்த செய்தி நற்றிணையில் கூறப்பட்டுள்ளது.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்றுகள் 1, 2 சரி; 3, 4 தவறு", "C": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "D": "கூற்றுகள் 2, 4 சரி; 1, 3 தவறு"}, "explanation": "கூற்று 4 தவறானது; போர்க்களத்தில் வீரரின் புண்ணை 'வெண்ணிற ஊசியால் தைத்த செய்தி' பதிற்றுப்பத்தில் ('நெடுவசிய பரந்த வடுவாழ் மார்பின்...') கூறப்பட்டுள்ளது. நற்றிணையில் சுறாமீன் தாக்கியதால் ஏற்பட்ட புண்ணை நரம்பினால் தைத்த செய்தி ('கோட்சுறா எறிந்தெனச் சுருங்கிய நரம்பின்...') இடம்பெற்றுள்ளது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'நிலம், தீ, நீர், வளி, விசும்போடு ஐந்தும் கலந்த மயக்கம் உலகம்' என்று ஐம்பூதக் கொள்கையைத் தொல்காப்பியம் கூறுகிறது.", "content_en": null}, {"id": "S2", "content_ta": "கடல்நீர் ஆவியாகி மேகமாகிப் பின் மழையாகப் பொழியும் நீர்ச்சுழற்சி முறை முல்லைப்பாட்டு, பரிபாடல், கார் நாற்பது ஆகியவற்றில் கூறப்பட்டுள்ளது.", "content_en": null}, {"id": "S3", "content_ta": "'ஆழ அமுக்கி முகக்கினும் ஆழ்கடல்நீர் நாழி முகவாது நால்நாழி' என்று திரவப் பொருட்களின் அழுத்த இயல்பு பற்றிக் கூறியவர் ஔவையார்.", "content_en": null}, {"id": "S4", "content_ta": "போர்க்களத்தில் காயம்பட்ட வீரரின் புண்ணை வெண்ணிற ஊசியால் தைத்த செய்தி நற்றிணையில் கூறப்பட்டுள்ளது.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "pyq_bridging", "section": null, "reference": "Standard 6 Tamil - Science in Ancient Tamil Literature", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "tnpsc", "exam_name": "group_4", "year": null, "paper": "general_tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id":