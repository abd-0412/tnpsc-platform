{"id": "6th-t1-u3-047", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-6th-u3-kalvi", "lesson_id": "lesson-04-noolagam-nokki", "chapter_id": null, "topic_id": "topic-floors-part-1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அண்ணா நூற்றாண்டு நூலகத்தின் தளங்களையும் அங்கு அமைந்துள்ள நூல் பிரிவுகளையும் பொருத்துக (பகுதி 1):\nபட்டியல் I:\nஅ) தரைத்தளம்\nஆ) முதல் தளம்\nஇ) இரண்டாம் தளம்\nஈ) மூன்றாம் தளம்\nபட்டியல் II:\n1. கணினி அறிவியல், தத்துவம், அரசியல் நூல்கள்\n2. தமிழ் நூல்கள் பிரிவு\n3. குழந்தைகள் பிரிவு, பருவ இதழ்கள்\n4. சொந்த நூல் படிப்பகம், பிரெய்லி நூல்கள்", "media_id": null}], "options": {"A": "அ-4, ஆ-2, இ-3, ஈ-1", "B": "அ-3, ஆ-4, இ-1, ஈ-2", "C": "அ-4, ஆ-3, இ-2, ஈ-1", "D": "அ-2, ஆ-1, இ-4, ஈ-3"}, "explanation": "பாடநூல் அட்டவணைப்படி: தரைத்தளம் - சொந்த நூல் படிப்பகம்/பிரெய்லி (4); முதல் தளம் - குழந்தைகள்/பருவ இதழ்கள் (3); இரண்டாம் தளம் - தமிழ் நூல்கள் (2); மூன்றாம் தளம் - கணினி அறிவியல்/தத்துவம்/அரசியல் (1). சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": "Match the floors of Anna Centenary Library with their respective sections (Part 1):\nList I: (a) Ground Floor (b) First Floor (c) Second Floor (d) Third Floor\nList II: 1. Computer Science, Philosophy, Politics 2. Tamil Books Section 3. Children's Section, Periodicals 4. Own Book Reading, Braille Books", "media_id": null}], "options": {"A": "(a)-4, (b)-2, (c)-3, (d)-1", "B": "(a)-3, (b)-4, (c)-1, (d)-2", "C": "(a)-4, (b)-3, (c)-2, (d)-1", "D": "(a)-2, (b)-1, (c)-4, (d)-3"}, "explanation": "Correct order: 4, 3, 2, 1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": ["தரைத்தளம்", "முதல் தளம்", "இரண்டாம் தளம்", "மூன்றாம் தளம்"], "right": ["சொந்த நூல்/பிரெய்லி", "குழந்தைகள்/பருவ இதழ்கள்", "தமிழ் நூல்கள்", "கணினி/தத்துவம்/அரசியல்"]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "textbook", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": 53, "chapter": "lesson-04-noolagam-nokki", "section": null, "reference": "6th Std Tamil Term 1, Page 53", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "library_floors"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u3-048", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அண்ணா நூற்றாண்டு நூலகத்தின் தளங்களையும் அவற்றின் துறைப் பிரிவுகளையும் பொருத்துக:\nபட்டியல் I (தளம்):\nஅ) தரைத்தளம்\nஆ) முதல் தளம்\nஇ) இரண்டாம் தளம்\nஈ) மூன்றாம் தளம்\n\nபட்டியல் II (பிரிவு):\n1. குழந்தைகள் பிரிவு, பருவ இதழ்கள்\n2. தமிழ் நூல்கள்\n3. கணினி அறிவியல், தத்துவம், அரசியல்\n4. சொந்த நூல் படிப்பகம், பிரெய்லி நூல்கள்", "media_id": null}], "options": {"A": "1, 2, 3, 4", "B": "4, 2, 1, 3", "C": "2, 1, 4, 3", "D": "4, 1, 2, 3"}, "explanation": "அ) தரைத்தளம் - பிரெய்லி, சொந்த நூல் (4)\nஆ) முதல் தளம் - குழந்தைகள், பருவ இதழ்கள் (1)\nஇ) 2-ஆம் தளம் - தமிழ் நூல்கள் (2)\nஈ) 3-ஆம் தளம் - கணினி அறிவியல், தத்துவம் (3)\nசரியான வரிசை: 4, 1, 2, 3."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": 