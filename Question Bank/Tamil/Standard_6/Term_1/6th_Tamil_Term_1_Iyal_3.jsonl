{"id": "6th-t1-u3-024", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பட்டுக்கோட்டை கல்யாணசுந்தரத்தின் சொல்லும் பொருளையும் பொருத்துக:\nபட்டியல் I:\nஅ) தூற்றும்படி\nஆ) மாற்றார்\nஇ) நெறி\nஈ) வற்றாமல்\n\nபட்டியல் II:\n1. மற்றவர்\n2. குறையாமல்\n3. வழி\n4. இகழும்படி", "media_id": null}], "options": {"A": "1, 4, 2, 3", "B": "4, 2, 1, 3", "C": "2, 1, 4, 3", "D": "4, 1, 3, 2"}, "explanation": "அ) தூற்றும்படி - இகழும்படி (4)\nஆ) மாற்றார் - மற்றவர் (1)\nஇ) நெறி - வழி (3)\nஈ) வற்றாமல் - குறையாமல் (2)\nசரியான வரிசை: 4, 1, 3, 2."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u3", "section": null, "reference": "6th Tamil, Term 1, Unit 3, Page 45", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year":