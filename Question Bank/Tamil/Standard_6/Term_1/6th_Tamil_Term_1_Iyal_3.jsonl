// பாடம் 4: நூலகம் நோக்கி ... (விரிவானம் - அண்ணா நூற்றாண்டு நூலகம் & அரங்கநாதன் விருது) [Q049 - Q064] (வினாக்கள்: 16)
// ஆசியாவின் 2-ஆவது பெரிய நூலகம், 8 ஏக்கர், தரைத்தளம் உட்பட 8 தளங்களின் அமைப்புகள், பிரெய்லி நூல்கள், முதல் தளம் குழந்தைகள் பிரிவு, டாக்டர் ச.ரா. அரங்கநாதன் விருது, நடமாடும் நூலகம்
// ==============================================================================
{"id": "6th-t1-u3-049", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அண்ணா நூற்றாண்டு நூலகம் மற்றும் அரங்கநாதன் குறித்த கூற்றுகளை ஆராய்க:\n1. சென்னை கோட்டூர்புரத்தில் அமைந்துள்ள அண்ணா நூற்றாண்டு நூலகம் ஆசியக்கண்டத்திலேயே மூன்றாவது பெரிய நூலகமாகும்.\n2. இந்நூலகம் தரைத்தளத்தைச் சேர்த்து ஒன்பது அடுக்குகளைக் (8 தளங்கள்) கொண்டது; இதன் பரப்பளவு எட்டு ஏக்கர் ஆகும்.\n3. இந்திய நூலகவியலின் தந்தை என்று அழைக்கப்படுபவர் முனைவர் ச. இரா. அரங்கநாதன் ஆவார்; சிறந்த நூலகர்களுக்கு இவரது பெயரில் விருது வழங்கப்படுகிறது.\n4. ஆசியக் கண்டத்திலேயே மிகப் பெரிய நூலகம் ஜப்பான் நாட்டில் உள்ளது.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2, 3 ஆகியவை சரியானவை; 4 தவறானது", "B": "கூற்றுகள் 1, 2, 4 ஆகியவை சரியானவை; 3 தவறானது", "C": "கூற்றுகள் 2, 3, 4 ஆகியவை சரியானவை; 1 தவறானது", "D": "கூற்றுகள் அனைத்தும் சரியானவை"}, "explanation": "கூற்றுகள் 1, 2, 3 சரியானவை. கூற்று 4 தவறானது; ஆசியக் கண்டத்திலேயே மிகப் பெரிய நூலகம் 'சீனாவில்' உள்ளது என்று பாடநூல் தெளிவாகக் குறிப்பிடுகிறது (ஜப்பான் அல்ல)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "சென்னை கோட்டூர்புரத்தில் அமைந்துள்ள அண்ணா நூற்றாண்டு நூலகம் ஆசியக்கண்டத்திலேயே மூன்றாவது பெரிய நூலகமாகும்.", "content_en": null}, {"id": "S2", "content_ta": "இந்நூலகம் தரைத்தளத்தைச் சேர்த்து ஒன்பது அடுக்குகளைக் (8 தளங்கள்) கொண்டது; இதன் பரப்பளவு எட்டு ஏக்கர் ஆகும்.", "content_en": null}, {"id": "S3", "content_ta": "இந்திய நூலகவியலின் தந்தை என்று அழைக்கப்படுபவர் முனைவர் ச. இரா. அரங்கநாதன் ஆவார்; சிறந்த நூலகர்களுக்கு இவரது பெயரில் விருது வழங்கப்படுகிறது.", "content_en": null}, {"id": "S4", "content_ta": "ஆசியக் கண்டத்திலேயே மிகப் பெரிய நூலகம் ஜப்பான் நாட்டில் உள்ளது.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u3", "section": null, "reference": "6th Tamil, Term 1, Unit 3, Page 51, 52, 54", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u3-050", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): காமராசர் பள்ளிகளில் ஏற்றத்தாழ்வின்றிப் பிள்ளைகள் பயிலச் சீருடைத் திட்டத்தை அறிமுகப்படுத்தினார்.\nகாரணம் (R): ஏழை எளிய மாணவர்களின் குடும்ப வறுமையைப் போக்கப் பல தொழிற்பள்ளிகளையும் கிளை நூலகங்களையும் நிறுவினார்.", "media_id": null}], "options": {"A": "கூற்று (A) சரி; காரணம் (R) தவறு.", "B": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் (R) என்பது கூற்றுக்கு (A) சரியான விளக்கம் அல்ல.", "C": "கூற்று (A) தவறு; காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "இரண்டு கூற்றுகளும் உண்மையானவை. ஆனால் தொழிற்பள்ளிகள் திறந்தது சீருடைத் திட்டத்திற்கான நேரடி விளக்கமல்ல. எனவே B சரி."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "காமராசர் பள்ளிகளில் ஏற்றத்தாழ்வின்றிப் பிள்ளைகள் பயிலச் சீருடைத் திட்டத்தை அறிமுகப்படுத்தினார்.", "reason": "ஏழை எளிய மாணவர்களின் குடும்ப வறுமையைப் போக்கப் பல தொழிற்பள்ளிகளையும் கிளை நூலகங்களையும் நிறுவினார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u3", "section": null, "reference": "6th Tamil, Term 1, Unit 3, Page 48", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u3-051", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-6th-u3-kalvi", "lesson_id": "lesson-04-noolagam-nokki", "chapter_id": null, "topic_id": "topic-floors-part-2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அண்ணா நூற்றாண்டு நூலகத்தின் தளங்களையும் அங்கு அமைந்துள்ள நூல் பிரிவுகளையும் பொருத்துக (பகுதி 2):\nபட்டியல் I:\nஅ) நான்காம் தளம்\nஆ) ஐந்தாம் தளம்\nஇ) ஆறாம் தளம்\nஈ) ஏழாம் தளம்\nபட்டியல் II:\n1. வரலாறு, சுற்றுலா, அரசு ஆவணக் காப்பகம், போட்டித் தேர்வு நூல்கள்\n2. பொறியியல், வேளாண்மை, திரைப்படக்கலை நூல்கள்\n3. கணிதம், அறிவியல், மருத்துவம் நூல்கள்\n4. பொருளியல், சட்டம், வணிகவியல், கல்வி நூல்கள்", "media_id": null}], "options": {"A": "அ-3, ஆ-4, இ-1, ஈ-2", "B": "அ-4, ஆ-2, இ-3, ஈ-1", "C": "அ-4, ஆ-3, இ-2, ஈ-1", "D": "அ-1, ஆ-2, இ-4, ஈ-3"}, "explanation": "பாடநூல் அட்டவணைப்படி: நான்காம் தளம் - பொருளியல்/சட்டம்/வணிகம்/கல்வி (4); ஐந்தாம் தளம் - கணிதம்/அறிவியல்/மருத்துவம் (3); ஆறாம் தளம் - பொறியியல்/வேளாண்மை/திரைப்படம் (2); ஏழாம் தளம் - வரலாறு/சுற்றுலா/ஆவணக் காப்பகம்/போட்டித் தேர்வு (1). சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": "Match the higher floors of Anna Centenary Library with their specialized sections (Part 2):\nList I: (a) Fourth Floor (b) Fifth Floor (c) Sixth Floor (d) Seventh Floor\nList II: 1. History, Tourism, Government Archives, Competitive Exam Books 2. Engineering, Agriculture, Cinema 3. Mathematics, Science, Medicine 4. Economics, Law, Commerce, Education", "media_id": null}], "options": {"A": "(a)-3, (b)-4, (c)-1, (d)-2", "B": "(a)-4, (b)-2, (c)-3, (d)-1", "C": "(a)-4, (b)-3, (c)-2, (d)-1", "D": "(a)-1, (b)-2, (c)-4, (d)-3"}, "explanation": "Correct order: 4, 3, 2, 1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": ["நான்காம் தளம்", "ஐந்தாம் தளம்", "ஆறாம் தளம்", "ஏழாம் தளம்"], "right": ["பொருளியல்/சட்டம்/வணிகம்", "கணிதம்/அறிவியல்/மருத்துவம்", "பொறியியல்/வேளாண்மை", "வரலாறு/சுற்றுலா/ஆவணக் காப்பகம்"]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "textbook", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": 53, "chapter": "lesson-04-noolagam-nokki", "section": null, "reference": "6th Std Tamil Term 1, Page 53", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "library_floors"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u3-052", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-6th-u3-kalvi", "lesson_id": "lesson-04-noolagam-nokki", "chapter_id": null, "topic_id": "topic-ranganathan-father", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): முனைவர் ச.ரா. அரங்கநாதன் அவர்கள் 'இந்திய நூலகவியலின் தந்தை' எனப் போற்றப்படுகிறார்.\nகாரணம் (R): நூலகத்திற்கான சர்வதேச விதிகளை வகுத்து, இந்தியாவில் நூலகவியல் அறிவியலுக்கு வலுவான அடித்தளமிட்டவர் இவரே ஆவார்.", "media_id": null}], "options": {"A": "கூற்று சரி, ஆனால் காரணம் தவறு.", "B": "கூற்று தவறு, ஆனால் காரணம் சரி.", "C": "கூற்று, காரணம் இரண்டும் தவறு.", "D": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் சரியான விளக்கமாகும்."}, "explanation": "கூற்று மற்றும் காரணம் இரண்டும் சரி. நூலக விதிகளை உருவாக்கிய முனைவர் ச.ரா. அரங்கநாதன் 'இந்திய நூலகவியலின் தந்தை' எனப்படுகிறார் (பாடநூல் பக்கம் 52)."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Dr. S.R. Ranganathan is reverently hailed as the 'Father of Library Science in India'.\nReason (R): He formulated foundational library rules and laid a systematic scientific bedrock for library science in India.", "media_id": null}], "options": {"A": "Assertion is true, but Reason is false.", "B": "Assertion is false, but Reason is true.", "C": "Both Assertion and Reason are false.", "D": "Both Assertion and Reason are true, and Reason is the correct explanation."}, "explanation": "Both statements are true as per Page 52 of 6th Std Tamil Term 1."}}, "question_data": {"assertion": "முனைவர் ச.ரா. அரங்கநாதன் இந்திய நூலகவியலின் தந்தை எனப்படுகிறார்.", "reason": "நூலக விதிகளை வகுத்து நூலகவியலுக்கு அடித்தளமிட்டவர்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, 