{"id": "6th-t1-u3-033", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காமராசர் திட்டமிட்ட பள்ளித் தூர எல்லைகளைப் பொருத்துக:\nபட்டியல் I (பள்ளி வகை):\nஅ) தொடக்கப் பள்ளி\nஆ) நடுநிலைப் பள்ளி\nஇ) உயர்நிலைப் பள்ளி\nஈ) கல்லூரி / பல்கலைக்கழகம்\n\nபட்டியல் II (தொலைவு எல்லை):\n1. 3 மைல் தூரம்\n2. 5 மைல் தூரம்\n3. 1 மைல் தூரம்\n4. மாவட்டத் தலைநகரம்", "media_id": null}], "options": {"A": "3, 1, 2, 4", "B": "1, 3, 2, 4", "C": "3, 2, 1, 4", "D": "2, 4, 3, 1"}, "explanation": "பாடநூல் உரைநடையின்படி:\nஅ) தொடக்கப்பள்ளி - 1 மைல் (3)\nஆ) நடுநிலைப்பள்ளி - 3 மைல் (1)\nஇ) உயர்நிலைப்பள்ளி - 5 மைல் (2)\nஈ) கல்லூரி - முக்கிய நகரங்கள் (4)\nசரியான வரிசை: 3, 1, 2, 4."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u3", "section": null, "reference": "6th Tamil, Term 1, Unit 3, Page