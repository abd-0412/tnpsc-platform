{"id": "6th-t1-u3-072", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கல்வி மற்றும் நூலகக் கலைச்சொற்களைப் பொருத்துக:\nபட்டியல் I:\nஅ) கல்வி\nஆ) நூலகம்\nஇ) மின் நூலகம்\nஈ) மின் இதழ்கள்\n\nபட்டியல் II:\n1. E-Journals\n2. Library\n3. Education\n4. E-Library", "media_id": null}], "options": {"A": "1, 2, 3, 4", "B": "3, 4, 2, 1", "C": "2, 3, 4, 1", "D": "3, 2, 4, 1"}, "explanation": "அ) கல்வி - Education (3)\nஆ) நூலகம் - Library (2)\nஇ) மின் நூலகம் - E-Library (4)\nஈ) மின் இதழ்கள் - E-Journals (1)\nசரியான வரிசை: 3, 2, 4, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u3", "section": null, "reference": "6th Tamil, Term 1, Unit 3, Page 59", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "yea