{"id": "6th-t1-u3-064", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-6th-u3-kalvi", "lesson_id": "lesson-04-noolagam-nokki", "chapter_id": null, "topic_id": "topic-seventh-floor", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அண்ணா நூற்றாண்டு நூலகத்தின் ஏழாம் தளத்தில் உள்ள பிரிவுகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. இத்தளத்தில் வரலாறு, சுற்றுலா தொடர்பான பல அரிய நூல்கள் உள்ளன.\n2. தமிழ்நாடு அரசின் கீழ் இயங்கும் 'அரசு ஆவணக் காப்பகம்' (Government Archives) ஏழாம் தளத்தில் செயல்படுகிறது.\n3. பழமையான ஓலைச்சுவடிகள் இத்தளத்தில் பாதுகாக்கப்பட்டு வருகின்றன.\n4. TNPSC, UPSC உள்ளிட்ட அனைத்துப் போட்டித் தேர்வுகளுக்கும் தேவையான பாடப் புத்தகங்கள் மற்றும் மாதிரி வினாத்தாள்கள் இத்தளத்தில் தனியாக வைக்கப்பட்டுள்ளன.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2 சரி; 3, 4 தவறு", "B": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "C": "கூற்றுகள் 1, 3 சரி; 2, 4 தவறு", "D": "அனைத்துக் கூற்றுகளும் சரியானவை"}, "explanation": "நான்கு கூற்றுகளும் பாடநூல் பக்கம் 53 மற்றும் 54-ல் உள்ள ஏழாம் தள விவரிப்பிற்கு முற்றிலும் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements regarding the Seventh Floor of Anna Centenary Library:\n1. Rare volumes regarding History and Tourism are housed on this floor.\n2. The Government Archives operates on the seventh floor.\n3. Ancient palm-leaf manuscripts are preserved and curated here.\n4. Comprehensive study materials for competitive exams (TNPSC, UPSC) are maintained here.", "media_id": null}], "options": {"A": "Statements 1 and 2 are correct; 3 and 4 are incorrect", "B": "Statements 2, 3, and 4 are correct; 1 is incorrect", "C": "Statements 1 and 3 are correct; 2 and 4 are incorrect", "D": "All statements are correct"}, "explanation": "All four statements are correct as per 6th Std Tamil Term 1, Pages 53-54."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "வரலாறு, சுற்றுலா நூல்கள் உள்ளன.", "content_en": "Houses History, Tourism books."}, {"id": "S2", "content_ta": "அரசு ஆவணக் காப்பகம் செயல்படுகிறது.", "content_en": "Government Archives operates here."}, {"id": "S3", "content_ta": "ஓலைச்சுவடிகள் பாதுகாக்கப்படுகின்றன.", "content_en": "Palm-leaf manuscripts preserved."}, {"id": "S4", "content_ta": "போட்டித் தேர்வு நூல்கள் வைக்கப்பட்டுள்ளன.", "content_en": "Competitive exam books available."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "textbook", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": 53, "chapter": "lesson-04-noolagam-nokki", "section": null, "reference": "6th Std Tamil Term 1, Pages 53-54", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "seventh_floor"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigr