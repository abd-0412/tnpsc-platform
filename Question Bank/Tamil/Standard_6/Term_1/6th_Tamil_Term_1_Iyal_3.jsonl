{"id": "6th-t1-u3-034", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காமராசரின் நினைவுச் சின்னங்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. சென்னையில் உள்ள உள்நாட்டு விமான நிலையத்திற்குக் காமராசர் பெயர் சூட்டப்பட்டுள்ளது.\n2. கன்னியாகுமரியில் காமராசருக்கு 02.10.2000 அன்று மணிமண்டபம் அமைக்கப்பட்டது.\n3. சென்னை மெரினா கடற்கரையில் காமராசருக்கு நினைவு மண்டபம் அமைக்கப்பட்டு விமான நிலையம் மெரினாவில் உள்ளது.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 3 ஆகியவை சரியானவை", "B": "கூற்றுகள் 1, 2 ஆகியவை சரியானவை; 3 தவறானது", "C": "கூற்றுகள் 2, 3 ஆகியவை சரியானவை", "D": "கூற்றுகள் அனைத்தும் சரியானவை"}, "explanation": "கூற்றுகள் 1 மற்றும் 2 சரியானவை. கூற்று 3 தவறானது; மெரினா கடற்கரையில் காமராசருக்குச் 'சிலை' மட்டுமே நிறுவப்பட்டது; உள்நாட்டு விமான நிலையம் மீனம்பாக்கத்தில் உள்ளது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "சென்னையில் உள்ள உள்நாட்டு விமான நிலையத்திற்குக் காமராசர் பெயர் சூட்டப்பட்டுள்ளது.", "content_en": null}, {"id": "S2", "content_ta": "கன்னியாகுமரியில் காமராசருக்கு 02.10.2000 அன்று மணிமண்டபம் அமைக்கப்பட்டது.", "content_en": null}, {"id": "S3", "content_ta": "சென்னை மெரினா கடற்கரையில் காமராசருக்கு நினைவு மண்டபம் அமைக்கப்பட்டு விமான நிலையம் மெரினாவில் உள்ளது.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "mat