{"id": "6th-t1-u1-024", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'தமிழ்' என்னும் சொல் முதன்முதலில் அப்பர் தேவாரத்தில் மட்டுமே ஆளப்பட்டுள்ளது.\nகாரணம் (R): தொல்காப்பியத்தில் 'தமிழென் கிளவியும் அதனோ ரற்றே' என்னும் வரி இடம்பெற்றுள்ளது.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி.", "B": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு.", "D": "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி."}, "explanation": "கூற்று (A) தவறானது; 'தமிழ்' என்னும் சொல் முதன்முதலில் ஆளப்படும் இலக்கியம் தொல்காப்பியம் ஆகும் ('தமிழன்' என்ற சொல்லே அப்பர் தேவாரத்தில் ஆளப்பட்டது). காரணம் (R) சரியான உண்மைச் செய்தி."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'தமிழ்' என்னும் சொல் முதன்முதலில் அப்பர் தேவாரத்தில் மட்டுமே ஆளப்பட்டுள்ளது.", "reason": "தொல்காப்பியத்தில் 'தமிழென் கிளவியும் அதனோ ரற்றே' என்னும் வரி இடம்பெற்றுள்ளது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "6th Tamil, Term 1, Unit 1, Page 6", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u1-025", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதிதாசனின் 'இன்பத்தமிழ்' பாடலின் எதுகை, மோனை நயங்கள் குறித்த கூற்றுகளை ஆராய்க:\n1. 'தமிழுக்கும் - தமிழுக்கு' என்பன முதலெழுத்து ஒன்றி வரும் மோனைச் சொற்கள் ஆகும்.\n2. 'தமிழுக்கும் - அமுதென்று' என்பன இரண்டாம் எழுத்து ஒன்றி வரும் எதுகைச் சொற்கள் ஆகும்.\n3. 'நேர் - நீர் - ஊர்' என்பன இறுதி எழுத்து/ஓசை ஒன்றி வரும் இயைபுச் சொற்கள் ஆகும்.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 3 ஆகியவை சரியானவை; 2 தவறானது", "B": "கூற்றுகள் 1, 2 ஆகியவை சரியானவை; 3 தவறானது", "C": "கூற்றுகள் 2, 3 ஆகியவை சரியானவை; 1 தவறானது", "D": "கூற்றுகள் அனைத்தும் சரியானவை"}, "explanation": "கூற்றுகள் 1 மற்றும் 3 சரியானவை. கூற்று 2 தவறானது; 'தமிழுக்கும் - அமுதென்று' ஆகியவற்றில் இரண்டாம் எழுத்து ஒன்றி வரவில்லை ('தமிழுக்கும் - அமிழ்து' என அமைந்தால்தான் 'மி' எதுகையாகும்)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'தமிழுக்கும் - தமிழுக்கு' என்பன முதலெழுத்து ஒன்றி வரும் மோனைச் சொற்கள் ஆகும்.", "content_en": null}, {"id": "S2", "content_ta": "'தமிழுக்கும் - அமுதென்று' என்பன இரண்டாம் எழுத்து ஒன்றி வரும் எதுகைச் சொற்கள் ஆகும்.", "content_en": null}, {"id": "S3", "content_ta": "'நேர் - நீர் - ஊர்' என்பன இறுதி எழுத்து/ஓசை ஒன்றி வரும் இயைபுச் சொற்கள் ஆகும்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "6th Tamil, Term 1, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u1-026", "schema_version": "1.0", "kind": "grammar_application", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "\"பாகற்காய்\" மற்றும் \"சீரிளமை\" ஆகிய சொற்களைச் சரியாகப் பிரித்தெழுதும் முறையைத் தேர்வு செய்க:", "media_id": null}], "options": {"A": "பாகற்கு + காய்; சீரி + இளமை", "B": "பாகு + அல் + காய்; சீர்மை + இளமை", "C": "பாகு + அல் + காய்; சிறு + இளமை", "D": "பாகல் + காய்; சீற் + இளமை"}, "explanation": "பாடநூலின்படி பாகற்காய் = பாகு + அல் + காய் (இனிப்பு அல்லாத காய்); மதிப்பீட்டு வினாப்பகுதிப்படி சீரிளமை = சீர்மை + இளமை (ஈறுபோதல் விதியால் 'மை' கெட்டு சீர் + இளமை = சீரிளமை என்றானது)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "6th Tamil, Term 1, Unit 1, Page 6, 9", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": fal