{"id": "6th-t1-u2-022", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிட்டுக்குருவியின் வாழ்க்கை மற்றும் உடலமைப்பு குறித்த கூற்றுகளை ஆராய்க:\n1. சிட்டுக்குருவி கூடுகட்டி வாழும் பறவையினத்தைச் சார்ந்தது; கூடு கட்டும் காலங்களில் சத்தமிட்டுக் கொண்டே இருக்கும்.\n2. ஆண் குருவியின் தொண்டைப் பகுதி கருப்பு நிறத்தில் இருக்கும்; உடற்பகுதி அடர் பழுப்பு நிறமாக இருக்கும்.\n3. பெண் குருவியின் உடல் முழுவதும் அடர் கருப்பு நிறத்தில் அமைந்திருக்கும்.\n4. சிட்டுக்குருவியின் வாழ்நாள் 10 முதல் 14 ஆண்டுகள் ஆகும்.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2, 3 ஆகியவை சரியானவை", "B": "கூற்றுகள் 1, 2, 4 ஆகியவை சரியானவை; 3 தவறானது", "C": "கூற்றுகள் 2, 3, 4 ஆகியவை சரியானவை", "D": "கூற்றுகள் அனைத்தும் சரியானவை"}, "explanation": "கூற்றுகள் 1, 2, 4 சரியானவை. கூற்று 3 தவறானது; ஏனெனில் பெண் குருவியின் உடல் முழுவதும் 'மங்கிய பழுப்பு நிறத்தில்' இருக்கும் (அடர் கருப்பு நிறம் அல்ல)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "சிட்டுக்குருவி கூடுகட்டி வாழும் பறவையினத்தைச் சார்ந்தது; கூடு கட்டும் காலங்களில் சத்தமிட்டுக் கொண்டே இருக்கும்.", "content_en": null}, {"id": "S2", "content_ta": "ஆண் குருவியின் தொண்டைப் பகுதி கருப்பு நிறத்தில் இருக்கும்; உடற்பகுதி அடர் பழுப்பு நிறமாக இருக்கும்.", "content_en": null}, {"id": "S3", "content_ta": "பெண் குருவியின் உடல் முழுவதும் அடர் கருப்பு நிறத்தில் அமைந்திருக்கும்.", "content_en": null}, {"id": "S4", "content_ta": "சிட்டுக்குருவியின் வாழ்நாள் 10 முதல் 14 ஆண்டுகள் ஆகும்.", "content_en": null}], "matching_pairs": {"left": []