{"id": "6th-t1-u3-063", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-6th-u3-kalvi", "lesson_id": "lesson-04-noolagam-nokki", "chapter_id": null, "topic_id": "topic-floors-odd", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அண்ணா நூற்றாண்டு நூலகத்தின் தள அமைப்பில் பொருந்தாத இணையைத் தேர்ந்தெடுக்க:\nஅ) முதல் தளம் - குழந்தைகள் பிரிவு\nஆ) இரண்டாம் தளம் - தமிழ் நூல்கள் பிரிவு\nஇ) மூன்றாம் தளம் - கணிதம் மற்றும் அறிவியல் நூல்கள்\nஈ) நான்காம் தளம் - சட்டம் மற்றும் வணிகவியல் நூல்கள்", "media_id": null}], "options": {"A": "அ", "B": "ஆ", "C": "இ", "D": "ஈ"}, "explanation": "பொருந்தாதது 'இ'. மூன்றாம் தளத்தில் கணினி அறிவியல், தத்துவம், அரசியல் நூல்கள் உள்ளன; கணிதம், அறிவியல் நூல்கள் ஐந்தாம் தளத்தில் அமைந்துள்ளன (பக்கம் 53)."}, "en": {"blocks": [{"type": "text", "content": "Select the INCORRECTLY matched floor pair of Anna Centenary Library:\nA) First Floor - Children's Section\nB) Second Floor - Tamil Books Section\nC) Third Floor - Mathematics and Science Books\nD) Fourth Floor - Law and Commerce Books", "media_id": null}], "options": {"A": "A", "B": "B", "C": "C", "D": "D"}, "explanation": "Incorrect match is C. Third floor houses Computer Science, Philosophy, and Politics; Mathematics and Science are on the Fifth floor (Page 53)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_acti