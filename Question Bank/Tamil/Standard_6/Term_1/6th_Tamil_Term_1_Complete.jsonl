{"id": "6th-t1-pyq-022", "schema_version": "1.0", "kind": "grammar_application", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'காமராசர் ஏழை எளிய மாணவர்களுக்குப் பள்ளிகளில் இலவச மதிய உணவை வழங்கினார்' - இத்தொடரின் வகை யாது?", "media_id": null}], "options": {"A": "வினாத்தொடர்", "B": "செய்தித்தொடர்", "C": "விழைவுத்தொடர்", "D": "உணர்ச்சித்தொடர்"}, "explanation": "ஒரு செய்தியைத் தெளிவாகவும் நேரிடையாகவும் தெரிவிக்கும் தொடர் 'செய்தித்தொடர்' எனப்படும். காமராசர் மதிய உணவு வழங்கிய வரலாற்றுக் குறிப்பை நேரிடையாகக் கூறுவதால் இது செய்தித்தொடர் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "pyq_bridging", "section": null, "reference": "TNPSC Group 4 (2013, 2018) & Piravinai Thodar", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "e