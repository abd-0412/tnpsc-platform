{"id": "6th-t1-u2-081", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): மனிதருக்குத் தங்க ஆபரணங்களும் முத்து மாலைகளுமே மிகச்சிறந்த அணிகலன்கள் ஆகும் என்று வள்ளுவர் கூறுகிறார்.\nகாரணம் (R): 'பணிவுடையன் இன்சொலன் ஆதல் ஒருவற்கு அணியல்ல மற்றுப் பிற' - பணிவும் இன்சொல்லுமே ஒருவருக்கு மிகச்சிறந்த அணிகலன்கள் ஆகும்.", "media_id": null}], "options": {"A": "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி.", "B": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "கூற்று (A) தவறானது; வள்ளுவர் தங்க ஆபரணங்களை அணிகலன் எனக் கூறாமல், பணிவும் இன்சொல்லுமே உண்மையான அணிகலன் என்றார். காரணம் (R) திருக்குறள் வழி சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "மனிதருக்குத் தங்க ஆபரணங்களும் முத்து மாலைகளுமே மிகச்சிறந்த அணிகலன்கள் ஆகும் என்று வள்ளுவர் கூறுகிறார்.", "reason": "'பணிவுடையன் இன்சொலன் ஆதல் ஒருவற்கு அணியல்ல மற்றுப் பிற' - பணிவும் இன்சொல்லுமே ஒருவருக்கு மிகச்சிறந்த அணிகலன்கள் ஆகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "6th Tamil, Term 1, Unit 2, Page 39", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u2-082", "schema_version": "1.0", "kind": "quote_completion", "level": "SSLC", "difficulty": "easy", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-6th-u2-iyarkai", "lesson_id": "lesson-05-thirukkural", "chapter_id": null, "topic_id": "topic-valluvar-titles-count", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "திருக்குறளை இயற்றிய திருவள்ளுவருக்குரிய சிறப்புப் பெயர்களுள் பொருந்தாத ஒன்றைத் தேர்ந்தெடுக்க:\nஅ) வான்புகழ் வள்ளுவர்\nஆ) தெய்வப்புலவர்\nஇ) பொய்யில் புலவர்\nஈ) பாவேந்தர்", "media_id": null}], "options": {"A": "அ", "B": "ஈ", "C": "இ", "D": "ஆ"}, "explanation": "பொருந்தாதது 'ஈ'. 'பாவேந்தர்' என்பது பாரதிதாசனின் சிறப்புப் பெயராகும்; மற்ற மூன்றும் திருவள்ளுவரின் சிறப்புப் பெயர்கள் (பக்கம் 39)."}, "en": {"blocks": [{"type": "text", "content": "Identify the title that does NOT belong to Thiruvalluvar:\nA) Vaanpugazh Valluvar\nB) Deivappulavar\nC) Poiyil Pulavar\nD) Pavendhar", "media_id": null}], "options": {"A": "A", "B": "D", "C": "C", "D": "B"}, "explanation": "D is odd. 'Pavendhar' is the title of Bharathidasan; the others are titles of Valluvar (Page 39)."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "textbook", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "