{"id": "6th-t1-u2-055", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-6th-u2-iyarkai", "lesson_id": "lesson-03-kizhavanum-kadalum", "chapter_id": null, "topic_id": "topic-shark-attack", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): படகின் பக்கவாட்டில் கட்டப்பட்டிருந்த மீனின் வாசனையை அறிந்து வழியில் பல சுறா மீன்கள் அதைத் தாக்க வந்தன.\nகாரணம் (R): சாண்டியாகோ துடுப்பாலும் ஈட்டியாலும் சுறாக்களை மூர்க்கமாகத் தாக்கி விரட்டிய போதிலும், இறுதியில் மீனின் எலும்புக்கூடும் தலையும் மட்டுமே மிஞ்சின.", "media_id": null}], "options": {"A": "கூற்று சரி, ஆனால் காரணம் தவறு.", "B": "கூற்று தவறு, ஆனால் காரணம் சரி.", "C": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் சரியான விளக்கமாகும்.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "கூற்று மற்றும் காரணம் ஆகிய இரண்டும் சரி. சுறாக்கள் மீனைத் தின்று தீர்த்ததால் இறுதியில் எலும்புக்கூடு மட்டுமே கரை சேர்ந்தது (பாடநூல் பக்கம் 31)."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): Lured by the scent of the fish blood lashed to the skiff, packs of sharks attacked the boat.\nReason (R): Though Santiago fought fiercely with his oar and harpoon, the sharks devoured the flesh, leaving only the skeleton and head.", "media_id": null}], "options": {"A": "Assertion is true, but Reason is false.", "B": "Assertion is false, but Reason is true.", "C": "Both Assertion and Reason are true, and Reason is the correct explanation.", "D": "Both Assertion and Reason are false."}, "explanation": "Both statements are true as per Page 31 of 6th Std Tamil Term 1."}}, "question_data": {"assertion": "மீனின் வாசனையை அறிந்து சுறா மீன்கள் தாக்க வந்தன.", "reason": "சாண்டியாகோ சுறாக்களைத் தாக்கி விரட்டினாலும் இறுதியில் எலும்புக்கூடு மட்டுமே மிஞ்சியது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "textbook", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": 31, "chapter": "lesson-03-kizhavanum-kadalum", "section": null, "reference": "6th Std Tamil Term 1, Page 31", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "sharks"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
