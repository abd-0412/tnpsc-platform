{"id": "6th-t1-u3-005", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நீதி வெண்பா பாடலின் சொற்பொருள்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'மருளை' என்னும் சொல்லின் பொருள் 'மயக்கத்தை' என்பதாகும்.\n2. 'தெருளை' என்னும் சொல்லின் பொருள் 'தெளிவை' என்பதாகும்.\n3. 'மதி' என்பது 'அறிவு' என்பதையும், 'ஆவி' என்பது 'உயிர்' என்பதையும் குறிக்கும்.\n4. 'அருத்துவதும்' என்பதன் பொருள் 'தருவதும்' என்றும், 'பொருத்துவதும்' என்பது 'சேர்ப்பதும்' என்றும் பொருள்படும்.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2, 3, 4 ஆகிய அனைத்தும் சரியானவை", "B": "கூற்றுகள் 1, 2, 3 ஆகியவை மட்டுமே சரியானவை", "C": "கூற்றுகள் 2, 3, 4 ஆகியவை மட்டுமே சரியானவை", "D": "கூற்றுகள் 1, 3, 4 ஆகியவை மட்டுமே சரியானவை"}, "explanation": "பாடநூல் சொல்லும் பொருளும் பகுதியின்படி நான்கு கூற்றுகளும் 100% சரியானவை."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'மருளை' என்னும் சொல்லின் பொருள் 'மயக்கத்தை' என்பதாகும்.", "content_en": null}, {"id": "S2", "content_ta": "'தெருளை' என்னும் சொல்லின் பொருள் 'தெளிவை' என்பதாகும்.", "content_en": null}, {"id": "S3", "content_ta": "'மதி' என்பது 'அறிவு' என்பதையும், 'ஆவி' என்பது 'உயிர்' என்பதையும் குறிக்கும்.", "content_en": null}, {"id": "S4", "content_ta": "'அருத்துவதும்' என்பதன் பொருள் 'தருவதும்' என்றும், 'பொருத்துவதும்' என்பது 'சேர்ப்பதும்' என்றும் பொருள்படும்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u3", "section": null, "reference": "6th Tamil, Term 1, Unit 3, Page 42", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u3-006", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பட்டுக்கோட்டை கல்யாணசுந்தரம் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. எளிய தமிழில் சமூக சீர்திருத்தக் கருத்துகளைப் பாடி மக்களிடையே விழிப்புணர்வு ஏற்படுத்தியவர்.\n2. திரை இசைப் பாடல்களில் உழைப்பாளிகளின் உயர்வை இடைவிடாது போற்றியவர்.\n3. இவர் 'புரட்சிக் கவிஞர்' என்னும் சிறப்புப் பெயரால் மக்களால் அன்போடு அழைக்கப்படுகிறார்.\n4. சமச்சீர் பாடப்பகுதியில் இடம்பெற்றுள்ள 'துன்பத்தை வெல்லும் கல்வி' என்னும் பாடலை இயற்றியவர் இவரே ஆவார்.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2, 3 ஆகியவை சரியானவை", "B": "கூற்றுகள் 1, 2, 4 ஆகியவை சரியானவை; 3 தவறானது", "C": "கூற்றுகள் 2, 3, 4 ஆகியவை சரியானவை", "D": "கூற்றுகள் அனைத்தும் சரியானவை"}, "explanation": "கூற்றுகள் 1, 2, 4 சரியானவை. கூற்று 3 தவறானது; ஏனெனில் பட்டுக்கோட்டை கல்யாணசுந்தரம் 'மக்கள் கவிஞர்' என்று அழைக்கப்படுகிறார் ('புரட்சிக் கவிஞர்' என்பது பாரதிதாசன்)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "எளிய தமிழில் சமூக சீர்திருத்தக் கருத்துகளைப் பாடி மக்களிடையே விழிப்புணர்வு ஏற்படுத்தியவர்.", "content_en": null}, {"id": "S2", "content_ta": "திரை இசைப் பாடல்களில் உழைப்பாளிகளின் உயர்வை இடைவிடாது போற்றியவர்.", "content_en": null}, {"id": "S3", "content_ta": "இவர் 'புரட்சிக் கவிஞர்' என்னும் சிறப்புப் பெயரால் மக்களால் அன்போடு அழைக்கப்படுகிறார்.", "content_en": null}, {"id": "S4", "content_ta": "சமச்சீர் பாடப்பகுதியில் இடம்பெற்றுள்ள 'துன்பத்தை வெல்லும் கல்வி' என்னும் பாடலை இயற்றியவர் இவரே ஆவார்.", "content_en": null}], "matching_