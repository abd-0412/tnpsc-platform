{"id": "6th-t1-u2-028", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வலசையின் போது பறவையின் உடலில் ஏற்படும் மாற்றங்களுள் பொருந்தாத ஒன்றைத் தேர்ந்தெடுக்க:", "media_id": null}], "options": {"A": "தலையில் சிறகு வளர்தல்", "B": "இறகுகளின் நிறம் மாறுதல்", "C": "உடலில் கற்றையாக முடி வளர்தல்", "D": "அலகுகளின் நீளம் குறைதல்"}, "explanation": "பாடநூலின்படி வலசையின் போது உடலில் ஏற்படும் மாற்றங்கள் 3 மட்டுமே: 1. தலையில் சிறகு வளர்தல், 2. இறகுகளின் நிறம் மாறுதல், 3. உடலில் கற்றையாக முடி வளர்தல். 'அலகுகளின் நீளம் குறைதல்' என்பது பாடநூலில் கூறப்படாத பொருந்தாத ஒன்று."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": true, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "6th Tamil, Term 1, Unit 2, Page 23", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false