{"id": "6th-t1-u2-003", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-6th-u2-iyarkai", "lesson_id": "lesson-01-edhilikkuruvigal", "chapter_id": null, "topic_id": "topic-rain-nature", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஏதிலிக்குருவிகள்' பாடலின் தொடக்கக் கருத்துகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. உயிர்களின் இருப்பை இயற்கைச் சூழலே முடிவு செய்கிறது.\n2. இயற்கைக்கும் மனிதர்க்கும் இடையே அமைந்த தொப்புள்கொடி உறவாக அமைவது மழைத்துளி ஆகும்.\n3. சூழலியல் மாற்றத்தினால் பறவைகள் தங்கள் இயற்கை வாழிடங்களை இழந்து வருகின்றன.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2 சரி; 3 தவறு", "B": "கூற்றுகள் 2, 3 சரி; 1 தவறு", "C": "அனைத்துக் கூற்றுகளும் சரியானவை", "D": "கூற்றுகள் 1, 3 சரி; 2 தவறு"}, "explanation": "மூன்று கூற்றுகளும் பாடநூல் பக்கம் 20-ல் உள்ள நுழைவு முன் பகுதியில் இடம்பெற்றுள்ள தெளிவான உண்மை வரிகளாகும்."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements regarding the introductory themes of 'Edhilikkuruvigal':\n1. The survival of living beings is determined by the natural ecosystem.\n2. Raindrops serve as the umbilical cord connecting nature and humanity.\n3. Ecological changes are compelling birds to lose their ancestral habitats.", "media_id": null}], "options": {"A": "Statements 1 and 2 are correct; 3 is incorrect", "B": "Statements 2 and 3 are correct; 1 is incorrect", "C": "All statements are correct", "D": "Statements 1 and 3 are correct; 2 is incorrect"}, "explanation": "All three statements are correct as per 6th Std Tamil Term 1, Page 20."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "உயிர்களின் இருப்பை இயற்கைச் சூழலே முடிவு செய்கிறது.", "content_en": "Ecosystem decides the survival of living beings."}, {"id": "S2", "content_ta": "இயற்கைக்கும் மனிதர்க்கும் தொப்புள்கொடி உறவு மழைத்துளி.", "content_en": "Raindrops are umbilical cord of nature and human."}, {"id": "S3", "content_ta": "சூழலியல் மாற்றத்தால் பறவைகள் வாழிடங்களை இழக்கின்றன.", "content_en": "Birds lose habitats due to ecological changes."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "textbook", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": 20, "chapter": "lesson-01-edhilikkuruvigal", "section": null, "reference": "6th Std Tamil Term 1, Page 20", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "nature"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
