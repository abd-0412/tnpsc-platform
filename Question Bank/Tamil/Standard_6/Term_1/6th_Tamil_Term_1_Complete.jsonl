{"id": "6th-t1-u2-071", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "எழுத்துகளின் வகைகளையும் அவற்றின் எண்ணிக்கையையும் பொருத்துக:\nபட்டியல் I:\nஅ) முதல் எழுத்துகள்\nஆ) சார்பெழுத்து வகைகள்\nஇ) உயிர் எழுத்துகள்\nஈ) மெய் எழுத்துகள்\n\nபட்டியல் II:\n1. 10\n2. 18\n3. 30\n4. 12", "media_id": null}], "options": {"A": "1, 2, 3, 4", "B": "3, 4, 1, 2", "C": "3, 1, 4, 2", "D": "4, 2, 3, 1"}, "explanation": "அ) முதல் எழுத்துகள் - 30 (3)\nஆ) சார்பெழுத்துகள் - 10 (1)\nஇ) உயிர் - 12 (4)\nஈ) மெய் - 18 (2)\nசரியான பொருத்தம்: 3, 1, 4, 2."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "6th Tamil, Term 1, Unit 2, Page 33, 34", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null,