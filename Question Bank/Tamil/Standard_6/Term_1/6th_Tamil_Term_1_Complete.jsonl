{"id": "6th-t1-u1-031", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-6th-u1-mozhi", "lesson_id": "lesson-02-valarthamizh", "chapter_id": null, "topic_id": "topic-valarthamizh-words-part2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இரண்டாயிரத்திற்கும் மேற்பட்ட ஆண்டுகளாக வழக்கில் உள்ள சொற்களையும் அவை இடம்பெற்ற சங்க நூல்களையும் பொருத்துக:\nபட்டியல் I:\nஅ) மீன்\nஆ) புகழ்\nஇ) அரசு\nஈ) செய்\nபட்டியல் II:\n1. குறுந்தொகை (72)\n2. திருக்குறள் (554)\n3. தொல்காப்பியம் (வேற்றுமையியல் 71)\n4. குறுந்தொகை (54)", "media_id": null}], "options": {"A": "அ-3, ஆ-4, இ-1, ஈ-2", "B": "அ-4, ஆ-2, இ-3, ஈ-1", "C": "அ-4, ஆ-3, இ-2, ஈ-1", "D": "அ-1, ஆ-2, இ-4, ஈ-3"}, "explanation": "பாடநூல் அட்டவணைப்படி: மீன் - குறுந்தொகை 54 (4); புகழ் - தொல்காப்பியம் வேற்றுமையியல் 71 (3); அரசு - திருக்குறள் 554 (2); செய் - குறுந்தொகை 72 (1). சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": "Match the ancient words in Tamil usage with respective literary occurrences:\nList I: (a) Meen (b) Pugazh (c) Arasu (d) Sei\nList II: 1. Kurunthogai (72) 2. Thirukkural (554) 3. Tholkappiyam (71) 4. Kurunthogai (54)", "media_id": null}], "options": {"A": "(a)-3, (b)-4, (c)-1, (d)-2", "B": "(a)-4, (b)-2, (c)-3, (d)-1", "C": "(a)-4, (b)-3, (c)-2, (d)-1", "D": "(a)-1, (b)-2, (c)-4, (d)-3"}, "explanation": "Textbook Page 8: Meen - Kurunthogai 54 (4); Pugazh - Tholkappiyam 71 (3); Arasu - Thirukkural 554 (2); Sei - Kurunthogai 72 (1). Correct order: 4, 3, 2, 1."}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": ["மீன்", "புகழ்", "அரசு", "செய்"], "right": ["குறுந்தொகை (54)", "தொல்காப்பியம் (71)", "திருக்குறள் (554)", "குறுந்தொகை (72)"]}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "textbook", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": 8, "chapter": "lesson-02-valarthamizh", "section": null, "reference": "6th Std Tamil Term 1, Page 8", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "ancient_words"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
