{"id": "6th-t1-pyq-046", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நூலகங்களையும் அவை தொடங்கப்பட்ட ஆண்டுகளையும் பொருத்துக:\nபட்டியல் I:\n(a) தஞ்சை சரசுவதி மகால் நூலகம்\n(b) கன்னிமாரா நூலகம் (சென்னை)\n(c) உ.வே.சா. நூலகம் (சென்னை)\n(d) அண்ணா நூற்றாண்டு நூலகம்\n\nபட்டியல் II:\n1. 2010\n2. 1942\n3. 1896\n4. கி.பி. 1122", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-4, (b)-3, (c)-2, (d)-1", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-2, (b)-1, (c)-4, (d)-3"}, "explanation": "தஞ்சை சரசுவதி மகால் - கி.பி. 1122; கன்னிமாரா நூலகம் - 1896; உ.வே.சா. நூலகம் - 1942; அண்ணா நூற்றாண்டு நூலகம் - 2010. சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "pyq_bridging", "section"