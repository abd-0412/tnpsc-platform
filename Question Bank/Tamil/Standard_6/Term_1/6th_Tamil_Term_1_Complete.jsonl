{"id": "6th-t1-u2-033", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிட்டுக்குருவி எத்தனை நாள்கள் அடைகாத்து எத்தனையாவது நாளில் குஞ்சு பொரிக்கும் என்று பாடநூல் உரைநடை கூறுகிறது?", "media_id": null}], "options": {"A": "14 நாள்கள் அடைகாத்து, 15-ஆம் நாளில் குஞ்சு பொரிக்கும்", "B": "10 நாள்கள் அடைகாத்து, 11-ஆம் நாளில் குஞ்சு பொரிக்கும்", "C": "20 நாள்கள் அடைகாத்து, 21-ஆம் நாளில் குஞ்சு பொரிக்கும்", "D": "7 நாள்கள் அடைகாத்து, 8-ஆம் நாளில் குஞ்சு பொரிக்கும்"}, "explanation": "பாடநூலின்படி: சிட்டுக்குருவி 14 நாள்கள் அடைகாக்கும்; 15-ஆம் நாளில் குஞ்சுகள் வெளிவரும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "6th Tamil, Term 1, Unit 2, Page 24", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": fals