{"id": "6th-t1-u2-066", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): ஆய்த எழுத்து சொல்லின் இடையில் மட்டுமே வரும் வரம்புடையது.\nகாரணம் (R): ஆய்த எழுத்து மூன்று புள்ளிகளை உடைய தனித்த முக்கோண வடிவம் பெற்றது.", "media_id": null}], "options": {"A": "கூற்று (A) சரி; காரணம் (R) தவறு.", "B": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் (R) என்பது கூற்றுக்கு (A) சரியான விளக்கம் அல்ல.", "C": "கூற்று (A) தவறு; காரணம் (R) சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "கூற்று மற்றும் காரணத்தில் உள்ள செய்திகள் இரண்டுமே உண்மையானவை. ஆனால் மூன்று புள்ளிகளைப் பெற்றுள்ளது என்பது அதன் வடிவம்; அது சொல்லின் இடையில் வருவதற்கான ஒலியியல் இலக்கண விளக்கம் அல்ல. எனவே B சரி."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "ஆய்த எழுத்து சொல்லின் இடையில் மட்டுமே வரும் வரம்புடையது.", "reason": "ஆய்த எழுத்து மூன்று புள்ளிகளை உடைய தனித்த முக்கோண வடிவம் பெற்றது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "6th Tamil, Term 1, Unit 2, Page 34", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u2-067", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'செயற்கரிய செய்வார் பெரியர் சிறியர் செயற்கரிய செய்கலா தார்' என்னும் குறளின் நயங்கள் குறித்த கூற்றுகளை ஆராய்க:\n1. 'செயற்கரிய - செயற்கரிய' என்பன முதலெழுத்து ஒன்றி வரும் மோனைச் சொற்கள் ஆகும்.\n2. 'செயற்கரிய - செய்வார்' என்பன இரண்டாம் எழுத்து ஒன்றி வரும் எதுகைச் சொற்கள் ஆகும்.\n3. 'பெரியர் - சிறியர்' என்பன இரண்டாம் எழுத்து (ரி) ஒன்றி வரும் எதுகைச் சொற்கள் ஆகும்.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2 ஆகியவை சரியானவை", "B": "கூற்றுகள் 2, 3 ஆகியவை சரியானவை", "C": "கூற்றுகள் 1, 3 ஆகியவை சரியானவை; 2 தவறானது", "D": "கூற்றுகள் அனைத்தும் சரியானவை"}, "explanation": "கூற்றுகள் 1 மற்றும் 3 சரியானவை. கூற்று 2 தவறானது; 'செயற்கரிய - செய்வார்' என்பதில் முதல் எழுத்து ஒன்றி வருவதால் அவை மோனைச் சொற்கள் ஆகும் (எதுகை அல்ல; இரண்டாம் எழுத்து 'ய', 'ய்' மாறுபட்டுள்ளது)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'செயற்கரிய - செயற்கரிய' என்பன முதலெழுத்து ஒன்றி வரும் மோனைச் சொற்கள் ஆகும்.", "content_en": null}, {"id": "S2", "content_ta": "'செயற்கரிய - செய்வார்' என்பன இரண்டாம் எழுத்து ஒன்றி வரும் எதுகைச் சொற்கள் ஆகும்.", "content_en": null}, {"id": "S3", "content_ta": "'பெரியர் - சிறியர்' என்பன இரண்டாம் எழுத்து (ரி) ஒன்றி வரும் எதுகைச் சொற்கள் ஆகும்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_