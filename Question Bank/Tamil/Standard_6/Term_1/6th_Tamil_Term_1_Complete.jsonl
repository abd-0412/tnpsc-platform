{"id": "6th-t1-u3-084", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நூலகத்தில் படித்து உயர்ந்த தலைவர்கள் மற்றும் சிறப்புத் திட்டங்கள் குறித்த கூற்றுகளை ஆராய்க:\n1. நூலகத்தில் படித்து உலகப் புகழ் பெற்றவர்களுள் அறிஞர் அண்ணா, ஜவஹர்லால் நேரு, அண்ணல் அம்பேத்கர், காரல் மார்க்ஸ் ஆகியோர் குறிப்பிடத்தக்கவர்கள்.\n2. கிராமப்புறங்களில் நூலகம் இல்லாத இடங்களில் மக்கள் பயன்பெறத் தமிழ்நாடு அரசு 'நடமாடும் நூலகம்' என்னும் திட்டத்தைத் தொடங்கியுள்ளது.\n3. அண்ணா நூற்றாண்டு நூலகத்தின் முதல் தளத்தில் குழந்தைகளுக்காகப் பிற நாடுகளிலிருந்து திரட்டப்பட்ட இருபதாயிரத்திற்கும் மேற்பட்ட நூல்கள் உள்ளன.\n4. 'கற்றது கைம்மண் அளவு, கல்லாதது உலகளவு' என்பது கல்வியின் எல்லையின்மையை உணர்த்தும் பழமொழியாகும்.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2 மட்டுமே சரியானவை", "B": "கூற்றுகள் 2, 3 மட்டுமே சரியானவை", "C": "கூற்றுகள் 1, 3, 4 மட்டுமே சரியானவை", "D": "கூற்றுகள் 1, 2, 3, 4 ஆகிய அனைத்தும் சரியானவை"}, "explanation": "நான்கு கூற்றுகளும் பாடநூல் விரிவாக்கப் பகுதியின்படி 100% சரியான உண்மைகளாகும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "நூலகத்தில் படித்து உலகப் புகழ் பெற்றவர்களுள் அறிஞர் அண்ணா, ஜவஹர்லால் நேரு, அண்ணல் அம்பேத்கர், காரல் மார்க்ஸ் ஆகியோர் குறிப்பிடத்தக்கவர்கள்.", "content_en": null}, {"id": "S2", "content_ta": "கிராமப்புறங்களில் நூலகம் இல்லாத இடங்களில் மக்கள் பயன்பெறத் தமிழ்நாடு அரசு 'நடமாடும் நூலகம்' என்னும் திட்டத்தைத் தொடங்கியுள்ளது.", "content_en": null}, {"id": "S3", "content_ta": "அண்ணா நூற்றாண்டு நூலகத்தின் முதல் தளத்தில் குழந்தைகளுக்காகப் பிற நாடுகளிலிருந்து திரட்டப்பட்ட இருபதாயிரத்திற்கும் மேற்பட்ட நூல்கள் உள்ளன.", "content_en": null}, {"id": "S4", "content_ta": "'கற்றது கைம்மண் அளவு, கல்லாதது உலகளவு' என்பது கல்வியின் எல்லையின்மையை உணர்த்தும் பழமொழியாகும்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u3", "section": null, "reference": "6th Tamil, Term 1, Unit 3, Page 53", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

