{"id": "6th-t1-u3-081", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'ங' என்னும் உயிர்மெய் வரிசையில் உள்ள பன்னிரண்டு எழுத்துகளும் சொல்லின் முதலில் வரும்.\nகாரணம் (R): இக்காலத்தில் 'ஙனம்' என்னும் சொல் தனித்து இயங்காமல் அங்ஙனம், இங்ஙனம், எங்ஙனம் என்னும் சொற்களில் மட்டுமே வழங்கி வருகிறது.", "media_id": null}], "options": {"A": "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி.", "B": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "கூற்று (A) தவறானது; 'ங' வரிசையில் 'ங' என்னும் ஓரெழுத்து மட்டுமே சொல்லின் முதலில் வரும் (பன்னிரண்டு எழுத்துகளும் வராது). காரணம் (R) பாடநூலின்படி 100% சரி."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'ங' என்னும் உயிர்மெய் வரிசையில் உள்ள பன்னிரண்டு எழுத்துகளும் சொல்லின் முதலில் வரும்.", "reason": "இக்காலத்தில் 'ஙனம்' என்னும் சொல் தனித்து இயங்காமல் அங்ஙனம், இங்ஙனம், எங்ஙனம் என்னும் சொற்களில் மட்டுமே வழங்கி வருகிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Na