{"id": "6th-t1-u2-057", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உயிர்மெய் எழுத்தின் இயல்புகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. மெய் எழுத்துகளும் உயிர் எழுத்துகளும் ஒன்றுடன் ஒன்று சேர்வதால் உயிர்மெய் எழுத்துகள் தோன்றுகின்றன.\n2. உயிர்மெய் எழுத்தின் ஒலிவடிவம் மெய்யும் உயிரும் சேர்ந்ததாக இருக்கும்.\n3. உயிர்மெய் எழுத்தின் வரிவடிவம் மெய் எழுத்தை ஒத்திருக்கும்; ஒலிக்கும் கால அளவு உயிர் எழுத்தை ஒத்திருக்கும்.\n4. உயிர்மெய் எழுத்துகள் முதல் எழுத்துகளைச் சார்ந்து இயங்குவதால் முதல் எழுத்துகள் வகையுள் அடங்கும்.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2, 3 ஆகியவை சரியானவை; 4 தவறானது", "B": "கூற்றுகள் 1, 2, 4 ஆகியவை சரியானவை; 3 தவறானது", "C": "கூற்றுகள் 2, 3, 4 ஆகியவை சரியானவை; 1 தவறானது", "D": "கூற்றுகள் அனைத்தும் சரியானவை"}, "explanation": "கூற்றுகள் 1, 2, 3 சரியானவை. கூற்று 4 தவறானது; உயிர்மெய் எழுத்துகள் முதல் எழுத்துகளைச் சார்ந்து வருவதால் அவை 'சார்பெழுத்து' வகையுள் அடங்கும் (முதல் எழுத்துகள் அல்ல)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "மெய் எழுத்துகளும் உயிர் எழுத்துகளும் ஒன்றுடன் ஒன்று சேர்வதால் உயிர்மெய் எழுத்துகள் தோன்றுகின்றன.", "content_en": null}, {"id": "S2", "content_ta": "உயிர்மெய் எழுத்தின் ஒலிவடிவம் மெய்யும் உயிரும் சேர்ந்ததாக இருக்கும்.", "content_en": null}, {"id": "S3", "content_ta": "உயிர்மெய் எழுத்தின் வரிவடிவம் மெய் எழுத்தை ஒத்திருக்கும்; ஒலிக்கும் கால அளவு உயிர் எழுத்தை ஒத்திருக்கும்.", "content_en": null}, {"id": "S4", "content_ta": "உயிர்மெய் எழுத்துகள் முதல் எழுத்துகளைச் சார்ந்து இயங்குவதால் முதல் எழுத்துகள் வகையுள் அடங்கும்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "6th Tamil, Term 1, Unit 2, Page 33, 34", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u2-058", "schema_version": "1.0", "kind": "grammar_application", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆய்த எழுத்து சொல்லில் இடம்பெறும் இலக்கண வரம்புகளுள் சரியான விதியைத் தேர்வு செய்க:", "media_id": null}], "options": {"A": "தனக்குமுன் நெடிலையும் தனக்குப் பின் மெல்லினத்தையும் பெற்று வரும்", "B": "தனக்குமுன் ஒரு குறில் எழுத்தையும், தனக்குப் பின் ஒரு வல்லின உயிர்மெய்க் குறில் எழுத்தையும் பெற்றுச் சொல்லின் இடையில் மட்டுமே வரும்", "C": "சொல்லின் முதலிலும் இறுதியிலும் தனித்து நின்று இயங்கும்", "D": "தனக்குமுன் உயிர் எழுத்தையும் தனக்குப் பின் ஆய்தக் குறுக்கத்தையும் பெற்று வரும்"}, "explanation": "பாடநூலின்படி ஆய்த எழுத்து தனக்குமுன் ஒரு குறில் எழுத்தையும், தனக்குப் பின் ஒரு வல்லின உயிர்மெய்க் குறில் எழுத்தையும் பெற்றுச் சொல்லின் இடையில் மட்டுமே வரும் (எ.கா. அஃது, எஃகு); தனித்து இயங்காது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-202