{"id": "6th-t1-u1-035", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-6th-u1-mozhi", "lesson_id": "lesson-02-valarthamizh", "chapter_id": null, "topic_id": "topic-tamil-numerals", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் எண்களின் வரிசை மற்றும் பயன்பாடு குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. தமிழ் எண்களில் ௧ என்பது ஒன்று (1) என்பதையும், ௫ என்பது ஐந்து (5) என்பதையும் குறிக்கும்.\n2. ௪ என்பது நான்கு (4) என்பதையும், ௭ என்பது ஏழு (7) என்பதையும் குறிக்கும்.\n3. ௮ என்பது எட்டு (8) என்பதையும், ௰ என்பது பத்து (10) என்பதையும் குறிக்கும்.\n4. கணினி மொழிக்கும் ஏற்ப எண்களை அடிப்படையாகக் கொண்டும் தமிழ் எழுத்துகள் பயன்படுத்தப்படுகின்றன.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2 சரி; 3, 4 தவறு", "B": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு", "C": "அனைத்துக் கூற்றுகளும் சரியானவை", "D": "கூற்றுகள் 1, 3, 4 சரி; 2 தவறு"}, "explanation": "நான்கு கூற்றுகளும் பாடநூல் பக்கம் 8-ல் உள்ள தமிழ் எண்கள் அட்டவணைக்கு (௧ முதல் ௰ வரை) முற்றிலும் பொருந்துகின்றன."}, "en": {"blocks": [{"type": "text", "content": "Analyze the statements regarding Tamil numerals (Thamizh Engal):\n1. '௧' denotes 1, and '௫' denotes 5.\n2. '௪' denotes 4, and '௭' denotes 7.\n3. '௮' denotes 8, and '௰' denotes 10.\n4. Tamil letters are adapted for computational digital processing based on numerals.", "media_id": null}], "options": {"A": "Statements 1 and 2 are correct; 3 and 4 are incorrect", "B": "Statements 2, 3, and 4 are correct; 1 is incorrect", "C": "All statements are correct", "D": "Statements 1, 3, and 4 are correct; 2 is incorrect"}, "explanation": "All statements are correct as per 6th Std Tamil Term 1, Page 8."}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "௧ = 1, ௫ = 5.", "content_en": "௧ = 1, ௫ = 5."}, {"id": "S2", "content_ta": "௪ = 4, ௭ = 7.", "content_en": "௪ = 4, ௭ = 7."}, {"id": "S3", "content_ta": "௮ = 8, ௰ = 10.", "content_en": "௮ = 8, ௰ = 10."}, {"id": "S4", "content_ta": "கணினி பயன்பாட்டிற்கு ஏற்ப அமைகிறது.", "content_en": "Adapted for computational usage."}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "textbook", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": 8, "chapter": "lesson-02-valarthamizh", "section": null, "reference": "6th Std Tamil Term 1, Page 8", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "numerals"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u1-036", "schema_version": "1.0", "kind": "grammar_application", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உயிரெழுத்தில் தொடங்கும் இரண்டு மாத்திரை அளவுள்ள சொல்லைத் தெரிவு செய்க:", "media_id": null}], "options": {"A": "ஆடு", "B": "இலை", "C": "உரல்", "D": "அது"}, "explanation": "அ (உயிர்க்குறில்) = 1 மாத்திரை; து (உயிர்மெய்க்குறில்) = 1 மாத்திரை. மொத்தம் 1 + 1 = 2 மாத்திரை. பிற தெரிவுகளில்: ஆடு (2+1=3), இலை (1+2=3), உரல் (1+1+½=2½)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "6th Tamil, Term 1, Unit 1, Page 15, 16", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "offi