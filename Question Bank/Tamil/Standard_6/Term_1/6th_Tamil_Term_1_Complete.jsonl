{"id": "6th-t1-u2-074", "schema_version": "1.0", "kind": "direct", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மக்களுக்கு மகிழ்ச்சி தருவது எது என்று பாடநூல் திருக்குறள் மதிப்பீட்டு வினா குறிப்பிடுகிறது?", "media_id": null}], "options": {"A": "ஊக்கமின்மை", "B": "அறிவுடைய மக்கள்", "C": "வன்சொல் பேசுதல்", "D": "சிறிய செயல்"}, "explanation": "பாடநூல் மதிப்பீடு வினா: மக்களுக்கு மகிழ்ச்சி தருவது 'அறிவுடைய மக்கள்' (தம்மின்தம் மக்கள் அறிவுடைமை மாநிலத்து மன்னுயிர்க்கு எல்லாம் இனிது)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "6th Tamil, Term 1, Unit 2, Page 40", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question