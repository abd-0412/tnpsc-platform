{"id": "6th-t1-u2-018", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பறவைகள் வலசை போதல் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. பறவைகள் இடம்பெயர்தலை 'வலசை போதல்' என்பர்; நிலவாழ் பறவைகளே பெரும்பாலும் வலசை போகின்றன.\n2. உணவு, இருப்பிடம், தட்பவெப்பநிலை மாற்றம், இனப்பெருக்கம் ஆகியவற்றிற்காகவே பறவைகள் இடம்பெயர்கின்றன.\n3. நிலவு, விண்மீன், புவிஈர்ப்புப் புலம் ஆகியவற்றை அடிப்படையாகக் கொண்டே பறவைகள் இடம்பெயர்கின்றன.\n4. பொதுவாக வடக்கிலிருந்து தெற்கு நோக்கியும், மேற்கிலிருந்து கிழக்கு நோக்கியும் பறவைகள் வலசை போகின்றன.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2, 3 ஆகியவை சரியானவை", "B": "கூற்றுகள் 2, 3, 4 ஆகியவை சரியானவை; 1 தவறானது", "C": "கூற்றுகள் 1, 3, 4 ஆகியவை சரியானவை", "D": "கூற்றுகள் அனைத்தும் சரியானவை"}, "explanation": "கூற்றுகள் 2, 3, 4 சரியானவை. கூற்று 1 தவறானது; ஏனெனில் 'நீர்வாழ் பறவைகளே பெரும்பாலும் வலசை போகின்றன' என்று பாடநூல் தெளிவாகக் குறிப்பிடுகிறது (நிலவாழ் பறவைகள் அல்ல)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பறவைகள் இடம்பெயர்தலை 'வலசை போதல்' என்பர்; நிலவாழ் பறவைகளே பெரும்பாலும் வலசை போகின்றன.", "content_en": null}, {"id": "S2", "content_ta": "உணவு, இருப்பிடம், தட்பவெப்பநிலை மாற்றம், இனப்பெருக்கம் ஆகியவற்றிற்காகவே பறவைகள் இடம்பெயர்கின்றன.", "content_en": null}, {"id": "S3", "content_ta": "நிலவு, விண்மீன், புவிஈர்ப்புப் புலம் ஆகியவற்றை அடிப்படையாகக் கொண்டே பறவைகள் இடம்பெயர்கின்றன.", "content_en": null}, {"id": "S4", "content_ta": "பொதுவாக வடக்கிலிருந்து தெற்கு நோக்கியும், மேற்கிலிருந்து கிழக்கு நோக்கியும் பறவைகள் வலசை போகின்றன.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "6th Tamil, Term 1, Unit 2, Page 22", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u2-019", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிட்டுக்குருவிகள் அழியக் காரணங்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. மனிதர்கள் விவசாயத்திற்குப் பூச்சிக்கொல்லிகளைப் பயன்படுத்துவதால் குருவிக் குஞ்சுகளுக்கு உணவான புழுபூச்சிகள் கிடைப்பதில்லை.\n2. நவீன கட்டடங்கள் குருவிகள் கூடு கட்ட ஏற்றவையாக இல்லை.\n3. தற்காலத்தில் செயற்கை வேலிகளுக்குப் பதிலாகத் தாவர வேலிகள் அதிகளவில் வளர்க்கப்படுவதால் குருவிகளுக்கு அடைக்கலம் கிடைப்பதில்லை.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 3 ஆகியவை சரியானவை", "B": "கூற்றுகள் 2, 3 ஆகியவை சரியானவை", "C": "கூற்றுகள் 1, 2 ஆகியவை சரியானவை; 3 தவறானது", "D": "கூற்றுகள் அனைத்தும் சரியானவை"}, "explanation": "கூற்றுகள் 1, 2 சரியானவை. கூற்று 3 தவறானது; ஏனெனில் தற்காலத்தில் 'தாவர வேலிகளுக்குப் பதிலாகச் செயற்கை வேலிகள்' அமைக்கப்பட்டதால்தான் குருவிகளுக்கு இடமில்லாமல் போனது என்று பாடநூல் கூறுகிறது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "மனிதர்கள் விவசாயத்திற்குப் பூச்சிக்கொல்லிகளைப் பயன்படுத்துவதால் குருவிக் குஞ்சுகளுக்கு உணவான புழுபூச்சிகள் கிடைப்பதில்லை.", "content_en": null}, {"id": "S2", "content_ta": "நவீன கட்டடங்கள் குருவிகள் கூடு கட்ட ஏற்றவையாக இல்லை.", "content_en": null}, {"id": "S3", "content_ta": "தற்காலத்தில் செயற்கை வேலிகளுக்குப் பதிலாகத் தாவர வேலிகள் அதிகளவில் வளர்க்கப்படுவதால் குருவிகளுக்கு அடைக்கலம் கிடைப்பதில்லை.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference":