{"id": "6th-t1-u3-004", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): கா.ப.செய்குதம்பிப் பாவலர் கம்பராமாயணத்திற்கு உரை எழுதியதால் சதாவதானி பட்டம் பெற்றார்.\nகாரணம் (R): ஒரே நேரத்தில் 1000 செயல்களைச் செய்து காட்டுபவரே சதாவதானி எனப்படுவார்.", "media_id": null}], "options": {"A": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு.", "B": "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறு."}, "explanation": "கூற்று மற்றும் காரணம் இரண்டும் முற்றிலும் தவறானவை. இவர் சீறாப்புராணத்திற்கு உரை எழுதியவர்; ஒரே நேரத்தில் 100 செயல்களைச் செய்து காட்டுவதே சதாவதானம் ஆகும் (1000 அல்ல)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "கா.ப.செய்குதம்பிப் பாவலர் கம்பராமாயணத்திற்கு உரை எழுதியதால் சதாவதானி பட்டம் பெற்றார்.", "reason": "ஒரே நேரத்தில் 1000 செயல்களைச் செய்து காட்டுபவரே சதாவதானி எனப்படுவார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corpor