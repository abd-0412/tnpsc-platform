// பாரதிதாசன் பிசிராந்தையார்/சாகித்திய அகாதெமி 1969/குயில் இதழ்; பெருஞ்சித்திரனார் தென்மொழி/தமிழ்ச்சிட்டு; பட்டுக்கோட்டை கல்யாணசுந்தரம் மக்கள் கவிஞர்/செங்கப்படுத்தான்காடு; காமராசர் K-Plan 1963/பாரத ரத்னா 1976/கல்விக்கண் திறந்தவர்; சலீம் அலி The Fall of a Sparrow/சரணாலயங்கள்
// ==============================================================================
{"id": "6th-t1-pyq-001", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாரதிதாசன் பற்றிய பின்வரும் கூற்றுகளை ஆராய்க:\n1. பாரதிதாசனின் இயற்பெயர் கனகசுப்புரத்தினம்; பாரதியார் மீதான பற்றினால் தம் பெயரை பாரதிதாசன் என மாற்றிக்கொண்டார்.\n2. இவர் புதுச்சேரியில் கனகசபை - இலக்குமி அம்மாள் இணையருக்கு மகனாகப் பிறந்தார்.\n3. இவர் இயற்றிய 'பிசிராந்தையார்' என்னும் நாடக நூலுக்கு 1969-ஆம் ஆண்டு சாகித்திய அகாதெமி விருது வழங்கப்பட்டது.\n4. தந்தை பெரியார் இவருக்கு 'புரட்சிக்கவிஞர்' என்ற பட்டத்தை வழங்கினார்.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரியானவை", "B": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "C": "கூற்றுகள் 1, 3 சரி; 2, 4 தவறு", "D": "கூற்றுகள் 2, 4 சரி; 1, 3 தவறு"}, "explanation": "நான்கு கூற்றுகளும் முற்றிலும் சரியானவை. பாரதிதாசனின் இயற்பெயர் சுப்புரத்தினம் (பெற்றோர்: கனகசபை-இலக்குமி அம்மாள்). இவரது 'பிசிராந்தையார்' நாடக நூலுக்கு 1969-ல் (மறைவுக்குப் பின்) சாகித்திய அகாதெமி விருது கிடைத்தது. பெரியார் இவருக்குப் 'புரட்சிக்கவிஞர்' என்ற பட்டமும், அண்ணா 'பாவேந்தர்' என்ற பட்டமும் வழங்கினர். இது TNPSC தேர்வுகளில் பலமுறை கேட்கப்பட்ட வினா."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பாரதிதாசனின் இயற்பெயர் கனகசுப்புரத்தினம்; பாரதியார் மீதான பற்றினால் தம் பெயரை பாரதிதாசன் என மாற்றிக்கொண்டார்.", "content_en": null}, {"id": "S2", "content_ta": "இவர் புதுச்சேரியில் கனகசபை - இலக்குமி அம்மாள் இணையருக்கு மகனாகப் பிறந்தார்.", "content_en": null}, {"id": "S3", "content_ta": "இவர் இயற்றிய 'பிசிராந்தையார்' என்னும் நாடக நூலுக்கு 1969-ஆம் ஆண்டு சாகித்திய அகாதெமி விருது வழங்கப்பட்டது.", "content_en": null}, {"id": "S4", "content_ta": "தந்தை பெரியார் இவருக்கு 'புரட்சிக்கவிஞர்' என்ற பட்டத்தை வழங்கினார்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "pyq_bridging", "section": null, "reference": "TNPSC Group 4 (2013, 2019) & Bharathidasan Topics", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "tnpsc", "exam_name": "group_4", "year": "2019", "paper": "general_tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-pyq-002", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பாவலரேறு பெருஞ்சித்திரனார் குறித்த கூற்றுகளில் சரியானவற்றைத் தேர்க:\n1. பெருஞ்சித்திரனாரின் இயற்பெயர் துரை. மாணிக்கம் ஆகும்.\n2. தென்மொழி, தமிழ்ச்சிட்டு, தமிழ்நிலம் ஆகிய இதழ்களை நடத்தித் தனித்தமிழையும் தமிழ்ப்பற்றையும் பரப்பினார்.\n3. இவர் எழுதிய நூல்களுள் 'கணிச்சாறு', 'ஐயை', 'கொய்யாக்கனி', 'பாவியக்கொத்து' ஆகியவை அடங்கும்.\n4. இவர் எழுதிய 'தமிழ்ப்பசி' என்னும் நூல் இவருக்குத் தமிழக அரசின் விருதைப் பெற்றுத் தந்தது.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2, 4 சரி", "B": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "C": "கூற்றுகள் 2, 3, 4 சரி", "D": "அனைத்துக் கூற்றுகளும் சரி"}, "explanation": "கூற்று 4 தவறானது; 'காயும் கனியும்', 'எண்சுவை எண்பது', 'நூறாசிரியம்' போன்றவை இவரது நூல்கள். 'தமிழ்ப்பசி' என்ற புகழ்பெற்ற பாடலை இயற்றியவர் சச்சிதானந்தன் ('தமிழ்ப்பசி எனக்கு உண்டு...'). கூற்றுகள் 1, 2, 3 ஆகியவை பெருஞ்சித்திரனார் பற்றிய TNPSC முந்தைய ஆண்டு வினாக்களின் ஆதாரப்பூர்வமான உண்மைகள்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பெருஞ்சித்திரனாரின் இயற்பெயர் துரை. மாணிக்கம் ஆகும்.", "content_en": null}, {"id": "S2", "content_ta": "தென்மொழி, தமிழ்ச்சிட்டு, தமிழ்நிலம் ஆகிய இதழ்களை நடத்தித் தனித்தமிழையும் தமிழ்ப்பற்றையும் பரப்பினார்.", "content_en": null}, {"id": "S3", "content_ta": "இவர் எழுதிய நூல்களுள் 'கணிச்சாறு', 'ஐயை', 'கொய்யாக்கனி', 'பாவியக்கொத்து' ஆகியவை அடங்கும்.", "content_en": null}, {"id": "S4", "content_ta": "இவர் எழுதிய 'தமிழ்ப்பசி' என்னும் நூல் இவருக்குத் தமிழக அரசின் விருதைப் பெற்றுத் தந்தது.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "pyq_bridging", "section": null, "reference": "TNPSC Group 4 (2014, 2018) & Perunchithiranar Works", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "tnpsc", "exam_name": "group_4", "year": "2018", "paper": "general_tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-pyq-003", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மக்கள் கவிஞர் பட்டுக்கோட்டை கல்யாணசுந்தரம் பற்றிய கூற்றுகளை ஆராய்க:\n1. இவர் தஞ்சாவூர் மாவட்டம் செங்கப்படுத்தான்காடு என்னும் ஊரில் அருணாச்சலம் - விசாலாட்சி இணையருக்கு மகனாகப் பிறந்தார்.\n2. திரைப்படப் பாடல்களில் எளிய தமிழில் உழைப்பாளர்களின் உயர்வை, பொதுவுடைமைச் சிந்தனைகளைப் பாடினார்.\n3. பாவேந்தர் பாரதிதாசன் இவரை 'என் அருமைத் தம்பி' என்று அன்போடு பாராட்டினார்.\n4. இவர் 'மகாவித்துவான்' என்னும் பட்டப்பெயரால் அழைக்கப்பட்டார்.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "C": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "கூற்று 4 தவறானது; பட்டுக்கோட்டை கல்யாணசுந்தரத்தின் புகழ்பெற்ற சிறப்புப் பெயர் 'மக்கள் கவிஞர்' ஆகும் ('மகாவித்துவான்' என்பது மீனாட்சிசுந்தரம் பிள்ளையைக் குறிக்கும்). மற்ற 1, 2, 3 ஆகிய கூற்றுகள் பட்டுக்கோட்டையார் பற்றிய நேரடி TNPSC வினாக்களின் துல்லியத் தகவல்கள்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "இவர் தஞ்சாவூர் மாவட்டம் செங்கப்படுத்தான்காடு என்னும் ஊரில் அருணாச்சலம் - விசாலாட்சி இணையருக்கு மகனாகப் பிறந்தார்.", "content_en": null}, {"id": "S2", "content_ta": "திரைப்படப் பாடல்களில் எளிய தமிழில் உழைப்பாளர்களின் உயர்வை, பொதுவுடைமைச் சிந்தனைகளைப் பாடினார்.", "content_en": null}, {"id": "S3", "content_ta": "பாவேந்தர் பாரதிதாசன் இவரை 'என் அருமைத் தம்பி' என்று அன்போடு பாராட்டினார்.", "content_en": null}, {"id": "S4", "content_ta": "இவர் 'மகாவித்துவான்' என்னும் பட்டப்பெயரால் அழைக்கப்பட்டார்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "pyq_bridging", "section": null, "reference": "TNPSC Group 4 (2016, 2022) & Pattukottai Kalyanasundaram", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "tnpsc", "exam_name": "group_4", "year": "2022", "paper": "general_tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-pyq-004", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பெருந்தலைவர் காமராசர் பற்றிய கூற்றுகளை ஆராய்க:\n1. 1963-ஆம் ஆண்டு மூத்த தலைவர்கள் கட்சிப் பணிக்குத் திரும்ப வேண்டும் என இவர் முன்மொழிந்த திட்டம் 'கே-பிளான்' (K-Plan) எனப்படும்.\n2. தந்தை பெரியாரால் 'கல்விக்கண் திறந்த காமராசர்' எனப் பாராட்டப்பட்டவர்.\n3. இவர் தமிழகத்தின் முதலமைச்சராக 1954 முதல் 1963 வரை ஒன்பது ஆண்டுகள் தொடர்ந்து ஆட்சி புரிந்தார்.\n4. இந்திய அரசு 1976-ஆம் ஆண்டு இவருக்கு மரணத்திற்குப் பின் 'பாரத ரத்னா' விருது வழங்கிச் சிறப்பித்தது.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2 சரி; 3, 4 தவறு", "B": "கூற்றுகள் 2, 3 சரி; 1, 4 தவறு", "C": "கூற்றுகள் 1, 3, 4 சரி; 2 தவறு", "D": "அனைத்துக் கூற்றுகளும் சரியானவை"}, "explanation": "நான்கு கூற்றுகளும் மிகச்சரியானவை. காமராசர் திட்டம் (1963), பெரியாரின் பாராட்டு (கல்விக்கண் திறந்தவர்), முதல்வராக 9 ஆண்டுகள் (1954-1963), பாரத ரத்னா (1976) ஆகியவை TNPSC பொதுத்தமிழ் பகுதி-இ பாடத்திட்டத்தில் அடிக்கடி இடம்பெறும் முக்கியப் புள்ளிவிவரங்கள்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "1963-ஆம் ஆண்டு மூத்த தலைவர்கள் கட்சிப் பணிக்குத் திரும்ப வேண்டும் என இவர் முன்மொழிந்த திட்டம் 'கே-பிளான்' (K-Plan) எனப்படும்.", "content_en": null}, {"id": "S2", "content_ta": "தந்தை பெரியாரால் 'கல்விக்கண் திறந்த காமராசர்' எனப் பாராட்டப்பட்டவர்.", "content_en": null}, {"id": "S3", "content_ta": "இவர் தமிழகத்தின் முதலமைச்சராக 1954 முதல் 1963 வரை ஒன்பது ஆண்டுகள் தொடர்ந்து ஆட்சி புரிந்தார்.", "content_en": null}, {"id": "S4", "content_ta": "இந்திய அரசு 1976-ஆம் ஆண்டு இவருக்கு மரணத்திற்குப் பின் 'பாரத ரத்னா' விருது வழங்கிச் சிறப்பித்தது.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "pyq_bridging", "section": null, "reference": "TNPSC Group 4 (2012, 2016, 2019) & Kamarajar", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "tnpsc", "exam_name": "group_4", "year": "2019", "paper": "general_tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-pyq-005", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சிலப்பதிகாரம் மற்றும் இளங்கோவடிகள் தொடர்பான பின்வரும் கூற்றுகளை ஆராய்க:\n1. இளங்கோவடிகள் சேர மன்னர் மரபினர் என்றும் இவர் சேரன் செங்குட்டுவனின் தம்பி என்றும் சிலப்பதிகாரப் பதிகம் கூறுகிறது.\n2. இந்நூல் முத்தமிழ்க் காப்பியம், குடிமக்கள் காப்பியம், முதல் காப்பியம், ஒற்றுமைக் காப்பியம் எனப் பல பெயர்களால் போற்றப்படுகிறது.\n3. சிலப்பதிகாரமும் மணிமேகலையும் இரட்டைக் காப்பியங்கள் என அழைக்கப்படுகின்றன.\n4. சிலப்பதிகாரத்தின் மூன்று காண்டங்கள்: புகார்க் காண்டம், மதுரைக் காண்டம், வஞ்சிக் காண்டம்.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரியானவை", "B": "கூற்றுகள் 1, 2 சரி; 3, 4 தவறு", "C": "கூற்றுகள் 2, 3 சரி; 1, 4 தவறு", "D": "கூற்றுகள் 1, 3, 4 சரி; 2 தவறு"}, "explanation": "அனைத்துக் கூற்றுகளும் சரியானவை. இளங்கோவடிகள் சேர மரபினர்; சிலப்பதிகாரத்திற்கு முத்தமிழ்க் காப்பியம், குடிமக்கள் காப்பியம், இரட்டைக் காப்பியம் (மணிமேகலையுடன்) போன்ற சிறப்புகள் உண்டு; புகார்க் காண்டம் (10 காதைகள்), மதுரைக் காண்டம் (13 காதைகள்), வஞ்சிக் காண்டம் (7 காதைகள்) என மொத்தம் 30 காதைகளைக் கொண்டது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "இளங்கோவடிகள் சேர மன்னர் மரபினர் என்றும் இவர் சேரன் செங்குட்டுவனின் தம்பி என்றும் சிலப்பதிகாரப் பதிகம் கூறுகிறது.", "content_en": null}, {"id": "S2", "content_ta": "இந்நூல் முத்தமிழ்க் காப்பியம், குடிமக்கள் காப்பியம், முதல் காப்பியம், ஒற்றுமைக் காப்பியம் எனப் பல பெயர்களால் போற்றப்படுகிறது.", "content_en": null}, {"id": "S3", "content_ta": "சிலப்பதிகாரமும் மணிமேகலையும் இரட்டைக் காப்பியங்கள் என அழைக்கப்படுகின்றன.", "content_en": null}, {"id": "S4", "content_ta": "சிலப்பதிகாரத்தின் மூன்று காண்டங்கள்: புகார்க் காண்டம், மதுரைக் காண்டம், வஞ்சிக் காண்டம்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "pyq_bridging", "section": null, "reference": "TNPSC Group 4 (2014, 2018) & Silappathikaram", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "tnpsc", "exam_name": "group_4", "year": "2018", "paper": "general_tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-pyq-006", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "டாக்டர் சலீம் அலி தொடர்பான கூற்றுகளை ஆராய்க:\n1. இவர் 'இந்தியாவின் பறவை மனிதர்' (Birdman of India) என்று அழைக்கப்படுகிறார்.\n2. இவரது சுயசரிதை நூல் 'The Fall of a Sparrow' (ஒரு சிட்டுக்குருவியின் வீழ்ச்சி) என்ற பெயரில் வெளியானது.\n3. இவர் பறவைகள் பற்றிய ஆராய்ச்சிக்காக பத்ம பூஷண் மற்றும் பத்ம விபூஷண் ஆகிய உயரிய விருதுகளைப் பெற்றார்.\n4. தமிழ்நாட்டின் புகழ்பெற்ற பறவைகள் சரணாலயமான வேடந்தாங்கல் மதுரை மாவட்டத்தில் அமைந்துள்ளது.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "C": "கூற்றுகள் 1, 3 சரி; 2, 4 தவறு", "D": "கூற்றுகள் 2, 4 சரி; 1, 3 தவறு"}, "explanation": "கூற்று 4 தவறானது; வேடந்தாங்கல் பறவைகள் சரணாலயம் செங்கல்பட்டு (முன்பு காஞ்சிபுரம்) மாவட்டத்தில் அமைந்துள்ளது (மதுரையில் அல்ல). கூற்றுகள் 1, 2, 3 ஆகியவை டாக்டர் சலீம் அலி குறித்த வரலாற்று உண்மைகள்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "இவர் 'இந்தியாவின் பறவை மனிதர்' (Birdman of India) என்று அழைக்கப்படுகிறார்.", "content_en": null}, {"id": "S2", "content_ta": "இவரது சுயசரிதை நூல் 'The Fall of a Sparrow' (ஒரு சிட்டுக்குருவியின் வீழ்ச்சி) என்ற பெயரில் வெளியானது.", "content_en": null}, {"id": "S3", "content_ta": "இவர் பறவைகள் பற்றிய ஆராய்ச்சிக்காக பத்ம பூஷண் மற்றும் பத்ம விபூஷண் ஆகிய உயரிய விருதுகளைப் பெற்றார்.", "content_en": null}, {"id": "S4", "content_ta": "தமிழ்நாட்டின் புகழ்பெற்ற பறவைகள் சரணாலயமான வேடந்தாங்கல் மதுரை ம