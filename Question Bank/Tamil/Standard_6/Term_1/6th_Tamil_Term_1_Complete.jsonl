{"id": "6th-t1-pyq-043", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொல் தமிழ்ச் சொற்கள் இடம்பெற்ற நூல்களைப் பொருத்துக:\nபட்டியல் I (சொல்):\n(a) பாம்பு\n(b) வெள்ளம்\n(c) பார்\n(d) வேளாண்மை\n\nபட்டியல் II (நூல்):\n1. கலித்தொகை\n2. பெரும்பாணாற்றுப்படை\n3. பதிற்றுப்பத்து\n4. குறுந்தொகை", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-3, (c)-4, (d)-1", "C": "(a)-4, (b)-3, (c)-2, (d)-1", "D": "(a)-3, (b)-4, (c)-1, (d)-2"}, "explanation": "பாம்பு - குறுந்தொகை; வெள்ளம் - பதிற்றுப்பத்து; பார் - பெரும்பாணாற்றுப்படை; வேளாண்மை - கலித்தொகை. சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "pyq_bridging", "section": null, "reference": "Standard 6 Old Book - 20 Words