// ==============================================================================
// பாடம் 3: கல்விக்கண் திறந்தவர் (உரைநடை உலகம் - பெருந்தலைவர் காமராசர்) [Q027 - Q048] (வினாக்கள்: 22)
// ஆடுமேய்க்கும் சிறுவர்கள், மயங்கி விழுந்த மாணவன், பரமக்குடி தரைப்பாலம், மதிய உணவுத் திட்டம், இலவசக் கட்டாயக் கல்வி, சீருடைத் திட்டம், 1976 பாரத ரத்னா, கல்வி வளர்ச்சி நாள் ஜூலை 15, கன்னியாகுமரி மணிமண்டபம்
// ==============================================================================
{"id": "6th-t1-u3-027", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "காமராசருக்குச் செய்யப்பட்ட சிறப்புகள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. மதுரைப் பல்கலைக்கழகத்திற்கு 'மதுரை காமராசர் பல்கலைக்கழகம்' எனப் பெயரிடப்பட்டது.\n2. நடுவண் அரசு 1976-இல் இவருக்குப் 'பாரத ரத்னா' விருது வழங்கிச் சிறப்பித்தது.\n3. காமராசர் வாழ்ந்த சென்னை இல்லமும் விருதுநகர் இல்லமும் அரசுடைமையாக்கப்பட்டு நினைவு இல்லங்களாக மாற்றப்பட்டன.\n4. காமராசரின் பிறந்தநாளான ஜூலை 15-ஆம் நாள் ஆண்டுதோறும் 'கல்வி வளர்ச்சி நாள்' எனக் கொண்டாடப்படுகிறது.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2 மட்டுமே சரியானவை", "B": "கூற்றுகள் 1, 2, 3 மட்டுமே சரியானவை", "C": "கூற்றுகள் 1, 2, 3, 4 ஆகிய அனைத்தும் சரியானவை", "D": "கூற்றுகள் 2, 3, 4 மட்டுமே சரியானவை"}, "explanation": "நான்கு கூற்றுகளும் பாடநூல் தெரிந்து தெளிவோம் பெட்டிச் செய்தியின்படி 100% சரியானவை."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "மதுரைப் பல்கலைக்கழகத்திற்கு 'மதுரை காமராசர் பல்கலைக்கழகம்' எனப் பெயரிடப்பட்டது.", "content_en": null}, {"id": "S2", "content_ta": "நடுவண் அரசு 1976-இல் இவருக்குப் 'பாரத ரத்னா' விருது வழங்கிச் சிறப்பித்தது.", "content_en": null}, {"id": "S3", "content_ta": "காமராசர் வாழ்ந்த சென்னை இல்லமும் விருதுநகர் இல்லமும் அரசுடைமையாக்கப்பட்டு நினைவு இல்லங்களாக மாற்றப்பட்டன.", "content_en": null}, {"id": "S4", "content_ta": "காமராசரின் பிறந்தநாளான ஜூலை 15-ஆம் நாள் ஆண்டுதோறும் 'கல்வி வளர்ச்சி நாள்' எனக் கொண்டாடப்படுகிறது.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u3", "section": null, "reference": "6th Tamil, Term 1, Unit 3, Page 49", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u3-028", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "ta-6th-u3-kalvi", "lesson_id": "lesson-02-thunbathai-vellum-kalvi", "chapter_id": null, "topic_id": "topic-monai-nayathodai", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): \"ஏட்டில் படித்ததோடு இருந்துவிடாதே – நீ / ஏன்படித்தோம் என்பதையும் மறந்துவிடாதே\" - இப்பாடல் அடிகளில் ஏட்டில், ஏன்படித்தோம் ஆகிய சீர்கள் மோனைத்தொடைக்குச் சான்றுகளாகும்.\nகாரணம் (R): ஒரு செய்யுளின் சீர்களிலோ அடிகளிலோ முதல் எழுத்து ஒன்றி (ஒரே எழுத்தாக) வருவது மோனைத்தொடை எனப்படும்.", "media_id": null}], "options": {"A": "கூற்று சரி, ஆனால் காரணம் தவறு.", "B": "கூற்று தவறு, ஆனால் காரணம் சரி.", "C": "கூற்று, காரணம் இரண்டும் தவறு.", "D": "கூற்று மற்றும் காரணம் இரண்டும் சரி; காரணம் கூற்றுக்குச் சரியான விளக்கமாகும்."}, "explanation": "கூற்று மற்றும் காரணம் இரண்டும் சரி. முதலெழுத்து 'ஏ' ஒன்றி வருவதால் மோனைத்தொடை (பாடநூல் பக்கம் 45)."}, "en": {"blocks": [{"type": "text", "content": "Assertion (A): In 'Aettil padithadhodu irundhuvidaadhey - nee / Aenpadithom enbadhaiyum marandhuvidaadhey', 'Aettil' and 'Aenpadithom' exemplify Monai rhyme.\nReason (R): Monai refers to the metrical harmony where the initial letters of words or lines are identical.", "media_id": null}], "options": {"A": "Assertion is true, but Reason is false.", "B": "Assertion is false, but Reason is true.", "C": "Both Assertion and Reason are false.", "D": "Both Assertion and Reason are true, and Reason is the correct explanation."}, "explanation": "Both statements are true as per Page 45 of 6th Std Tamil Term 1."}}, "question_data": {"assertion": "ஏட்டில், ஏன்படித்தோம் சீர்கள் மோனைக்குச் சான்றாகும்.", "reason": "முதல் எழுத்து ஒன்றி வருவது மோனைத்தொடை எனப்படும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "textbook", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": 45, "chapter": "lesson-02-thunbathai-vellum-kalvi", "section": null, "reference": "6th Std Tamil Term 1, Page 45", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "grammar"], "language_status": {"ta": "available", "en": "available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-03T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-03T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u3-029", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): காமராசர் 'கல்விக்கண் திறந்தவர்' என்று தந்தை பெரியாரால் மனமாரப் பாராட்டப்பட்டார்.\nகாரணம் (R): ஏழை எளிய கிராமப்புறக் குழந்தைகள் எளிதாகப் பள்ளிக்குச் செல்ல வேண்டும் என்பதற்காகக் கல்வித்துறை விதிகளைத் தளர்த்தி, மாணவர்கள் வாழும் இடங்களிலேயே பள்ளிக்கூடங்களைத் திறக்கச் செய்தார்.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) என்பது கூற்றுக்கு (A) சரியான வரலாற்று விளக்கமாகும்.", "B": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் (R) என்பது கூற்றுக்கு (A) சரியான விளக்கம் அல்ல.", "C": "கூற்று (A) சரி; ஆனால் காரணம் (R) தவறு.", "D": "கூற்று (A) தவறு; ஆனால் காரணம் (R) சரி."}, "explanation": "கிராமப்புறக் குழந்தைகள் கல்வி கற்க ஆயிரக்கணக்கான பள்ளிகளைத் திறந்து புரட்சி செய்ததால் தந்தை பெரியார் காமராசரைக் 'கல்விக்கண் திறந்தவர்' என்று மனமாரப் பாராட்டினார். கூற்று, காரணம் இரண்டும் சரி; சரியான விளக்கம்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "காமராசர் 'கல்விக்கண் திறந்தவர்' என்று தந்தை பெரியாரால் மனமாரப் பாராட்டப்பட்டார்.", "reason": "ஏழை எளிய கிராமப்புறக் குழந்தைகள் எளிதாகப் பள்ளிக்குச் செல்ல வேண்டும் என்பதற்காகக் கல்வித்துறை விதிகளைத் தளர்த்தி, மாணவர்கள் வாழும் இடங்களிலேயே பள்ளிக்கூடங்களைத் திறக்கச் செய்தார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "match