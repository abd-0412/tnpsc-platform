{"id": "6th-t1-u1-027", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பழந்தமிழ் இலக்கியங்களில் குறிப்பிட்ட சொற்கள் முதன்முதலில் ஆளப்படும் இடங்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'தமிழ்' என்னும் சொல் முதன்முதலில் தொல்காப்பியத்தில் 'தமிழென் கிளவியும் அதனோ ரற்றே' என்னும் அடியில் ஆளப்பட்டுள்ளது.\n2. 'தமிழ்நாடு' என்னும் சொல் சிலப்பதிகாரத்தின் புகார்க் காண்டத்தில் 'இமிழ்கடல் வேலியைத் தமிழ்நாடு ஆக்கிய இதுநீ கருதினை ஆயின்' என ஆளப்பட்டுள்ளது.\n3. 'தமிழன்' என்னும் சொல் அப்பர் தேவாரத்தில் '... தமிழன் கண்டாய்' என்னும் திருத்தாண்டக அடியில் முதன்முதலில் ஆளப்பட்டுள்ளது.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2 ஆகியவை சரியானவை; 3 தவறானது", "B": "கூற்றுகள் 2, 3 ஆகியவை சரியானவை; 1 தவறானது", "C": "கூற்றுகள் 1, 3 ஆகியவை சரியானவை; 2 தவறானது", "D": "கூற்றுகள் 1, 2, 3 ஆகிய அனைத்தும் சரியானவை"}, "explanation": "கூற்றுகள் 1 மற்றும் 3 சரியானவை. கூற்று 2 தவறானது; ஏனெனில் சிலப்பதிகாரத்தில் 'இமிழ்கடல் வேலியைத் தமிழ்நாடு ஆக்கிய...' என்ற அடி இடம்பெற்றுள்ள பகுதி வஞ்சிக் காண்டம் ஆகும் (புகார்க் காண்டம் அல்ல)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'தமிழ்' என்னும் சொல் முதன்முதலில் தொல்காப்பியத்தில் 'தமிழென் கிளவியும் அதனோ ரற்றே' என்னும் அடியில் ஆளப்பட்டுள்ளது.", "content_en": null}, {"id": "S2", "content_ta": "'தமிழ்நாடு' என்னும் சொல் சிலப்பதிகாரத்தின் புகார்க் காண்டத்தில் 'இமிழ்கடல் வேலியைத் தமிழ்நாடு ஆக்கிய இதுநீ கருதினை ஆயின்' என ஆளப்பட்டுள்ளது.", "content_en": null}, {"id": "S3", "content_ta": "'தமிழன்' என்னும் சொல் அப்பர் தேவாரத்தில் '... தமிழன் கண்டாய்' என்னும் திருத்தாண்டக அடியில் முதன்முதலில் ஆளப்பட்டுள்ளது.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "6th Tamil, Term 1, Unit 1, Page 6", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_1", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t1-u1-028", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பூவின் பல்வேறு நிலைகளை அவற்றின் முறையான வரிசை எண்களோடு பொருத்துக:\nபட்டியல் I (பூவின் நிலை):\nஅ) மொட்டு\nஆ) மலர்\nஇ) அலர்\nஈ) வீ\n\nபட்டியல் II (வரிசை எண்):\n1. நான்காம் நிலை\n2. இரண்டாம் நிலை\n3. ஆறாம் நிலை\n4. ஐந்தாம் நிலை", "media_id": null}], "options": {"A": "1, 2, 3, 4", "B": "4, 3, 2, 1", "C": "3, 4, 1, 2", "D": "2, 1, 4, 3"}, "explanation": "பூவின் ஏழு நிலைகள்: 1. அரும்பு, 2. மொட்டு, 3. முகை, 4. மலர், 5. அலர், 6. வீ, 7. செம்மல்.\nஅ) மொட்டு - 2-ஆம் நிலை (2)\nஆ) மலர் - 4-ஆம் நிலை (1)\nஇ) அலர் - 5-ஆம் நிலை (4)\nஈ) வீ - 6-ஆம் நிலை (3)\nசரியான பொருத்தம்: 2, 1, 4, 3."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "6th Tamil, Term 1, Unit 1, Page 7"