{"id": "6th-t1-u1-021", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இன்பத்தமிழ் பாடலில் பாரதிதாசன் தமிழுக்குச் சூட்டியுள்ள பெயர்களையும் அவற்றின் உவமைகளையும் பொருத்துக:\nபட்டியல் I:\nஅ) அமுது\nஆ) நிலவு\nஇ) மணம்\nஈ) இளமை\n\nபட்டியல் II:\n1. விளைவுக்கு நீர்\n2. வாழ்வுக்கு ஊர்\n3. உயிருக்கு நேர்\n4. பால்", "media_id": null}], "options": {"A": "3, 1, 2, 4", "B": "1, 2, 3, 4", "C": "3, 2, 1, 4", "D": "2, 3, 4, 1"}, "explanation": "பாடலின் வரிகள்:\nஅ) அமுது - உயிருக்கு நேர் (3)\nஆ) நிலவு - விளைவுக்கு நீர் (1)\nஇ) மணம் - வாழ்வுக்கு ஊர் (2)\nஈ) இளமை - பால் (4)\nசரியான இணை: 3, 1, 2, 4."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "6th Tamil, Term 1, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_p