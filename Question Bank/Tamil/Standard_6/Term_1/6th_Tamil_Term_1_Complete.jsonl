{"id": "6th-t1-u2-021", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இயற்கை மற்றும் சூழலியல் கலைச்சொற்களைப் பொருத்துக:\nபட்டியல் I:\nஅ) கண்டம்\nஆ) தட்பவெப்பநிலை\nஇ) வானிலை\nஈ) வலசை\n\nபட்டியல் II:\n1. Weather\n2. Migration\n3. Continent\n4. Climate", "media_id": null}], "options": {"A": "3, 4, 1, 2", "B": "4, 3, 2, 1", "C": "3, 1, 4, 2", "D": "2, 4, 1, 3"}, "explanation": "அ) கண்டம் - Continent (3)\nஆ) தட்பவெப்பநிலை - Climate (4)\nஇ) வானிலை - Weather (1)\nஈ) வலசை - Migration (2)\nசரியான வரிசை: 3, 4, 1, 2."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "6th Tamil, Term 1, Unit 2, Page 37", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "pa