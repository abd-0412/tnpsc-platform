{"id": "6th-t1-u3-073", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u3", "lesson_id": "u3", "chapter_id": null, "topic_id": "topic-u3", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மெய்யெழுத்து வரிசைகளில் மொழி முதலில் வரும் எழுத்துகளின் எண்ணிக்கையைப் பொருத்துக:\nபட்டியல் I (வரிசை):\nஅ) ங - வரிசை\nஆ) ஞ - வரிசை\nஇ) ய - வரிசை\nஈ) வ - வரிசை\n\nபட்டியல் II (எண்ணிக்கை):\n1. ஆறு (6)\n2. எட்டு (8)\n3. ஒன்று (1)\n4. நான்கு (4)", "media_id": null}], "options": {"A": "3, 4, 1, 2", "B": "4, 3, 2, 1", "C": "1, 2, 3, 4", "D": "3, 1, 4, 2"}, "explanation": "அ) ங வரிசை - 1 (3)\nஆ) ஞ வரிசை - 4 (4)\nஇ) ய வரிசை - 6 (1)\nஈ) வ வரிசை - 8 (2)\nசரியான வரிசை: 3, 4, 1, 2."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u3", "section": null, "reference": "6th Tamil, Term 1, Unit 3, Page 56", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exa