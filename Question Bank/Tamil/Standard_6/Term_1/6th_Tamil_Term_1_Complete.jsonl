{"id": "6th-t1-u1-069", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "1", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தமிழ் எண்களின் கூட்டலை அவற்றுக்குரிய எண்களோடு பொருத்துக:\nபட்டியல் I:\nஅ) ௧ + ௨\nஆ) ௨ + ௨\nஇ) ௩ + ௩\nஈ) ௪ + ௪\n\nபட்டியல் II:\n1. ௪ (4)\n2. ௮ (8)\n3. ௩ (3)\n4. ௬ (6)", "media_id": null}], "options": {"A": "3, 1, 4, 2", "B": "1, 3, 2, 4", "C": "4, 2, 1, 3", "D": "2, 4, 3, 1"}, "explanation": "அ) 1 + 2 = 3 (௩) -> 3\nஆ) 2 + 2 = 4 (௪) -> 1\nஇ) 3 + 3 = 6 (௬) -> 4\nஈ) 4 + 4 = 8 (௮) -> 2\nசரியான வரிசை: 3, 1, 4, 2."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "1", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "6th Tamil, Term 1, Unit 1, Page 8", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "qu