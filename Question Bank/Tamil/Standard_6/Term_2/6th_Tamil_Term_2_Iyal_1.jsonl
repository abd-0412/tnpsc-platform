{"id": "6th-t2-u1-058", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'அறிவுசால் ஔவையார்' நாடகக் காட்சி குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. அதியமான் நெடுமான் அஞ்சிக்குக் கிடைத்த சாகா மூவா அரிய கருநெல்லிக்கனியைத் தான் உண்ணாமல் ஔவையாருக்குக் கொடுத்தான்.\n2. காஞ்சிபுரத்தை ஆண்ட தொண்டைமான் தகடூர் மீது போர் தொடுக்க ஆயத்தமானான்.\n3. அதியமானின் தூதுவராகத் தொண்டைமானிடம் சென்ற ஔவையார் தன் சொல்லாற்றலால் போரைத் தவிர்த்தார்.\n4. தொண்டைமானின் படைக்கலக் கொட்டிலையும் அதியமானின் போர்க்கருவிகளையும் ஔவையார் நுட்பமாக ஒப்பிட்டுப் பாடினார்.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரியானவை", "B": "கூற்றுகள் 1, 2 சரி; 3, 4 தவறு", "C": "கூற்றுகள் 1, 3, 4 சரி; 2 தவறு", "D": "கூற்றுகள் 2, 3 சரி; 1, 4 தவறு"}, "explanation": "நான்கு கூற்றுகளும் சரியானவை. அதியமான் தனக்குக் கிடைத்த அரிய நெல்லிக்கனியை ஔவைக்கு அளித்தான்; தொண்டைமான் அதியமான் மீது போருக்கு முயன்றபோது ஔவையார் தூது சென்று தடுத்து அமைதியை ஏற்படுத்தினார்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "அதியமான் நெடுமான் அஞ்சிக்குக் கிடைத்த சாகா மூவா அரிய கருநெல்லிக்கனியைத் தான் உண்ணாமல் ஔவையாருக்குக் கொடுத்தான்.", "content_en": null}, {"id": "S2", "content_ta": "காஞ்சிபுரத்தை ஆண்ட தொண்டைமான் தகடூர் மீது போர் தொடுக்க ஆயத்தமானான்.", "content_en": null}, {"id": "S3", "content_ta": "அதியமானின் தூதுவராகத் தொண்டைமானிடம் சென்ற ஔவையார் தன் சொல்லாற்றலால் போரைத் தவிர்த்தார்.", "content_en": null}, {"id": "S4", "content_ta": "தொண்டைமானின் படைக்கலக் கொட்டிலையும் அதியமானின் போர்க்கருவிகளையும் ஔவையார் நுட்பமாக ஒப்பிட்டுப் பாடினார்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 10-14", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}

