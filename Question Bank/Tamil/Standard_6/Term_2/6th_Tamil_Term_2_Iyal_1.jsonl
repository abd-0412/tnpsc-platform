{"id": "6th-t2-u1-017", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'பாட்டிசைத்துப் பாடினாலும் தாலாட்டுப் பாடல் குழந்தையின் உறக்கத்தை எளிதாக்குகிறது.'\nகாரணம் (R): 'பாட்டிசைத்து' என்னும் சொல்லைப் பிரித்தெழுதும்போது 'பாட்டு + இசைத்து' எனப் புணர்கிறது.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சொல்லின் புணர்ச்சியைச் சரியாக விளக்குகிறது.", "B": "கூற்று சரி, காரணம் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "பாட்டு + இசைத்து = பாட்டிசைத்து (உயிர்வரின் உக்குறள் மெய்விட்டோடும் விதிப்படி ட் + இ = டி). நூல் மதிப்பீட்டுப் பகுதியில் கேட்கப்பட்டுள்ள புணர்ச்சி வினா."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'பாட்டிசைத்துப் பாடினாலும் தாலாட்டுப் பாடல் குழந்தையின் உறக்கத்தை எளிதாக்குகிறது.'", "reason": "'பாட்டிசைத்து' என்னும் சொல்லைப் பிரித்தெழுதும்போது 'பாட்டு + இசைத்து' எனப் புணர்கிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 4", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u1-016", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): அதியமான் தான் உண்டால் நெடுங்காலம் வாழலாம் என்று தெரிந்தும் அரிய நெல்லிக்கனியை ஔவையாருக்கு ஈந்தான்.\nகாரணம் (R): அதியமான் அரச பதவியைத் துறந்து காடுகளுக்குச் சென்று துறவறம் பூண விரும்பியதால் அக்கனியைப் புறக்கணித்தான்.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி.", "B": "கூற்று (A) சரி, ஆனால் காரணம் (R) முற்றிலும் தவறு.", "C": "கூற்று (A) தவறு, காரணம் (R) சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறானவை."}, "explanation": "கூற்று சரி, காரணம் தவறு. அதியமான் துறவறம் செல்ல விரும்பவில்லை; தான் வாழ்வதைவிடத் தமிழறிவும் புலமையும் மிக்க ஔவையார் நெடுங்காலம் வாழ்ந்தால் தமிழ் தழைக்கும், மக்கள் நலம் பெறுவர் என்ற உயர்ந்த நோக்கிலேயே அக்கனியை அளித்தான்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "அதியமான் தான் உண்டால் நெடுங்காலம் வாழலாம் என்று தெரிந்தும் அரிய நெல்லிக்கனியை ஔவையாருக்கு ஈந்தான்.", "reason": "அதியமான் அரச பதவியைத் துறந்து காடுகளுக்குச் சென்று துறவறம் பூண விரும்பியதால் அக்கனியைப் புறக்கணித்தான்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": t