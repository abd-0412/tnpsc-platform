{"id": "6th-t2-u1-028", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கள்ளாமை' அதிகாரக் குறள்கள் குறித்த கூற்றுகளில் சரியானவற்றைத் தேர்க:\n1. அடுத்தவர் பொருளைக் களவாடலாம் என உள்ளத்தால் நினைப்பது கூடத் தீமையானது என்று வள்ளுவர் கூறுகிறார்.\n2. 'உள்ளத்தால் உள்ளலும் தீதே பிறன்பொருளைக் கள்ளத்தால் கள்வேம் எனல்' என்பது குறள்.\n3. களவினால் சேரும் செல்வம் நிலைத்து நின்று பல தலைமுறைகளுக்கும் வளம் சேர்க்கும்.\n4. 'களவினால் ஆகிய ஆக்கம் அளவிறந்து ஆவது போலக் கெடும்' - களவு மூலம் சேர்க்கப்படும் செல்வம் பெருகுவது போல் தோன்றினாலும் முடிவில் அழியும்.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2, 4 சரி; 3 தவறு", "B": "அனைத்துக் கூற்றுகளும் சரி", "C": "கூற்றுகள் 1, 3 சரி; 2, 4 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "கூற்று 3 தவறானது; களவினால் சேர்க்கப்படும் செல்வம் ஒருபோதும் நிலைக்காது, அது வளர்வது போலத் தோன்றி முற்றாக அழிந்துவிடும் என்று குறள் (4) கூறுகிறது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "அடுத்தவர் பொருளைக் களவாடலாம் என உள்ளத்தால் நினைப்பது கூடத் தீமையானது என்று வள்ளுவர் கூறுகிறார்.", "content_en": null}, {"id": "S2", "content_ta": "'உள்ளத்தால் உள்ளலும் தீதே பிறன்பொருளைக் கள்ளத்தால் கள்வேம் எனல்' என்பது குறள்.", "content_en": null}, {"id": "S3", "content_ta": "களவினால் சேரும் செல்வம் நிலைத்து நின்று பல தலைமுறைகளுக்கும் வளம் சேர்க்கும்.", "content_en": null}, {"id": "S4", "content_ta": "'களவினால் ஆகிய ஆக்கம் அளவிறந்து ஆவது போலக் கெடும்' - களவு மூலம் சேர்க்கப்படும் செல்வம் பெருகுவது போல் தோன்றினாலும் முடிவில் அழியும்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 21", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u1-022", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாலாட்டுப் பாடலில் குறிப்பிடப்படும் 'முத்தேன்' வகைகளுள் பொருந்தாத ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "கொம்புத்தேன்", "B": "மலைத்தேன்", "C": "பொந்துத்தேன்", "D": "கொசுத்தேன்"}, "explanation": "மரபுப்படி முத்தேன் என்பன: கொம்புத்தேன், பொந்துத்தேன், கொசுத்தேன் ஆகிய மூன்றும் ஆகும். 'மலைத்தேன்' என்பது பொதுப்பெயரே அன்றி முத்தேனில் தனி வகையாகக் குறிப்பிடப்படவில்லை."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": true, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 4", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "off