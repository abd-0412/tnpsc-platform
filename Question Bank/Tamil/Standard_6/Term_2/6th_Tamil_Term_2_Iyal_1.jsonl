// பாடம் 4: அறிவுசால் ஔவையார் (விரிவானம் - நாடகம் / அதியமான் தூது) [Q058 - Q060] (வினாக்கள்: 3)
// அதியமான் நெடுமான் அஞ்சி, சாகா மூவா அருங்கருநெல்லி, தகடூர், தொண்டைமான், காஞ்சிபுரம் படைக்கலக் கொட்டில், ஔவையாரின் வஞ்சப்புகழ்ச்சித் தூது, புறநானூற்றுப் பின்னணி, போர் தவிர்ப்பு
// ==============================================================================
{"id": "6th-t2-u1-059", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தொண்டைமானின் படைக்கலக் கொட்டில் குறித்து ஔவையார் கூறிய கூற்றுகளில் சரியானவற்றைத் தேர்க:\n1. தொண்டைமானின் போர்க்கருவிகள் நெய் பூசப்பட்டு, மாலைகள் சூட்டப்பட்டுப் பளபளப்பாகப் பாதுகாப்பாக வைக்கப்பட்டுள்ளன.\n2. அதியமானின் கருவிகள் பகைவரைக் குத்தி முனை மழுங்கி, கொல்லனின் உலைக்களத்தில் கிடக்கின்றன.\n3. தொண்டைமான் படைகள் இதுவரை எப்போரையும் சந்திக்காத புதியவை என்பதை ஔவையார் குறிப்பால் உணர்த்தினார்.\n4. அதியமான் போரில் ஒருபோதும் வெற்றி பெறாத கோழை என்பதை ஔவையார் தொண்டைமானுக்குத் தெரிவித்தார்.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "C": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "கூற்று 4 முற்றிலும் தவறானது; அதியமான் பல போர்களைக் கண்டு வெற்றிவாகை சூடிய இணையற்ற வீரன் என்பதை அவனது போர்க்கருவிகள் உலைக்களத்தில் இருப்பதைக் கொண்டு ஔவையார் புகழ்ந்து எச்சரித்தார்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "தொண்டைமானின் போர்க்கருவிகள் நெய் பூசப்பட்டு, மாலைகள் சூட்டப்பட்டுப் பளபளப்பாகப் பாதுகாப்பாக வைக்கப்பட்டுள்ளன.", "content_en": null}, {"id": "S2", "content_ta": "அதியமானின் கருவிகள் பகைவரைக் குத்தி முனை மழுங்கி, கொல்லனின் உலைக்களத்தில் கிடக்கின்றன.", "content_en": null}, {"id": "S3", "content_ta": "தொண்டைமான் படைகள் இதுவரை எப்போரையும் சந்திக்காத புதியவை என்பதை ஔவையார் குறிப்பால் உணர்த்தினார்.", "content_en": null}, {"id": "S4", "content_ta": "அதியமான் போரில் ஒருபோதும் வெற்றி ப