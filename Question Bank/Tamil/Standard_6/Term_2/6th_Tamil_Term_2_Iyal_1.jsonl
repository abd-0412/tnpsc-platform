{"id": "6th-t2-u1-044", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): அறுவடைத் திருநாள் என்பது வெறும் பொழுதுபோக்கு விழா மட்டுமன்று; அது இயற்கையையும் உழவு மாடுகளையும் போற்றும் நன்றியுணர்வு விழாவாகும்.\nகாரணம் (R): மனித குலத்திற்கு உணவளிக்கும் கதிரவன், மழை, நிலம், மாடுகள் ஆகிய அனைத்திற்கும் உளமார நன்றி செலுத்தும் உயர் பண்பாட்டை இவ்விழா பிரதிபலிக்கிறது.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்.", "B": "கூற்று சரி, காரணம் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "பொங்கல் திருநாள் இயற்கையோடு இயைந்த தமிழரின் தலைசிறந்த நன்றியுணர்வு (Gratitude) பண்பாட்டுத் திருவிழா ஆகும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "அறுவடைத் திருநாள் என்பது வெறும் பொழுதுபோக்கு விழா மட்டுமன்று; அது இயற்கையையும் உழவு மாடுகளையும் போற்றும் நன்றியுணர்வு விழாவாகும்.", "reason": "மனித குலத்திற்கு உணவளிக்கும் கதிரவன், மழை, நிலம், மாடுகள் ஆகிய அனைத்திற்கும் உளமார நன்றி செலுத்தும் உயர் பண்பாட்டை இவ்விழா பிரதிபலிக்கிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eli