{"id": "6th-t2-u1-025", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): மாட்டுப் பொங்கலன்று நடைபெறும் மஞ்சுவிரட்டு வீர விளையாட்டு 'ஜல்லிக்கட்டு' எனவும் அழைக்கப்படுகிறது.\nகாரணம் (R): அக்காலத்தில் மாட்டின் கொம்புகளில் காசுகள் அடங்கிய 'சல்லி' என்னும் நாணய முடிப்பைக் கட்டி விடுவர்; மாட்டை அடக்கும் வீரர் அந்த முடிப்பைப் பெறுவர் என்பதால் இப்பெயர் அமைந்தது.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு.", "B": "கூற்று தவறு, காரணம் சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) சரியான விளக்கம்.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "'சல்லி' என்பது ஒரு நாணயம். சல்லி நாணயங்களைத் துணியில் முடிந்து மாட்டின் கொம்புகளில் கட்டிவிடும் மரபிலிருந்து மருவி வந்ததே 'ஜல்லிக்கட்டு' ஆகும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "மாட்டுப் பொங்கலன்று நடைபெறும் மஞ்சுவிரட்டு வீர விளையாட்டு 'ஜல்லிக்கட்டு' எனவும் அழைக்கப்படுகிறது.", "reason": "அக்காலத்தில் மாட்டின் கொம்புகளில் காசுகள் அடங்கிய 'சல்லி' என்னும் நாணய முடிப்பைக் கட்டி விடுவர்; மாட்டை அடக்கும் வீரர் அந்த முடிப்பைப் பெறுவர் என்பதால் இப்பெயர் அமைந்தது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 7", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u1-020", "schema_version": "1.0", "kind": "grammar_application", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'கண்ணுறங்கு' என்னும் சொல்லைப் பிரித்தெழுதக் கிடைக்கும் வடிவம் எது?", "media_id": null}], "options": {"A": "கண் + உறங்கு", "B": "கண்ணு + உறங்கு", "C": "கண் + நுறங்கு", "D": "கண் + உறங்கு"}, "explanation": "கண் + உறங்கு = கண்ணுறங்கு. தனிக்குறில் முன் ஒற்று உயிர்வரின் இரட்டும் விதிப்படி 'ண்' இரட்டித்து (கண்ண் + உறங்கு), உடல்மேல் உயிர்வந்து ஒன்றுவது இயல்பே விதிப்படி ண் + உ = ணு என இணைந்து கண்ணுறங்கு என்றானது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 5", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "sessio