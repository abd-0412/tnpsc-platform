{"id": "6th-t2-u1-102", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறட்பாக்களின் முதல் சீர்களையும் இறுதிச் சீர்களையும் பொருத்துக:\nபட்டியல் I (முதல் சீர்):\n(a) உள்ளம் உடைமை\n(b) ஆக்கம் அதர்வினாய்ச்\n(c) வெள்ளத்து அனைய\n(d) உள்ளுவது எல்லாம்\n\nபட்டியல் II (இறுதிச் சீர்):\n1. தள்ளாமை நீர்த்து\n2. அனையது உயர்வு\n3. உடையான் உழை\n4. நீங்கி விடும்", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-4, (b)-3, (c)-2, (d)-1", "C": "(a)-2, (b)-3, (c)-4, (d)-1", "D": "(a)-3, (b)-4, (c)-1, (d)-2"}, "explanation": "உள்ளம் உடைமை... நீங்கி விடும் (4); ஆக்கம் அதர்வினாய்ச்... உடையான் உழை (3); வெள்ளத்து அனைய... அனையது உயர்வு (2); உள்ளுவது எல்லாம்... தள்ளாமை நீர்த்து (1). சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter