{"id": "6th-t2-pyq-049", "schema_version": "1.0", "kind": "grammar_application", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "பின்வரும் வாக்கியத்தில் இன எழுத்துப் பிழையற்ற சரியான தொடர் எது?", "media_id": null}], "options": {"A": "வீரன் போர்க்களத்தில் வீரத்தோடு போரிட்டு வென்றான்", "B": "வீரன் போர்க்களத்தில் வீரத்தோடு போரிட்டு வென்ரான்", "C": "வீரன் போர்க்களத்தில் வீரத்தோடு போரிட்டு வென்றாந்", "D": "வீரன் போர்க்களத்தில் வீரத்தோடு போரிட்டு வெண்ரான்"}, "explanation": "றகர வல்லினத்திற்கு முன் றன்னகர ஒற்றே வர வேண்டும்: 'வென்றான்' என்பதே பிழையற்ற சொல்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "pyq_bridging", "section": null, "reference": "TNPSC Group 4 (2016) & Error Correction Ina Ezhuthu", "url": null, "source_notes": null}, "previous_year": {"is_previous