{"id": "6th-t2-pyq-040", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தமிழ் இலக்கணத்தில் ஆய்த எழுத்து தனக்கென எந்த ஓர் இன எழுத்தையும் கொண்டிருக்கவில்லை.\nகாரணம் (R): ஆய்த எழுத்து பிற மெய்யெழுத்துகளையோ உயிரெழுத்துகளையோ போலப் பிறக்காமல், தலை இடமாகப் பிறந்து நுட்பமான தனி ஒலியாகத் திகழ்வதால் இதற்கு இணை எழுத்து இல்லை.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு.", "B": "கூற்று தவறு, காரணம் சரி.", "C": "கூற்று, காரணம் இரண்டும் தவறு.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) சரியான ஒலியியல் விளக்கம் ஆகும்."}, "explanation": "ஆய்த எழுத்து தலையை இடமாகக் கொண்டு பிறக்கும் தனிநிலை எழுத்தாகும்; எனவே இதற்கு இன எழுத்து இல்லை."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "தமிழ் இலக்கணத்தில் ஆய்த எழுத்து தனக்கென எந்த ஓர் இன எழுத்தையும் கொண்டிருக்கவில்லை.", "reason": "ஆய்த எழுத்து பிற மெய்யெழுத்துகளையோ உயிரெழுத்துகளையோ போலப் பிறக்காமல், தலை இடமாகப் பிறந்து நுட்பமான தனி ஒலியாகத் திகழ்வதால் இதற்கு இணை எழுத்து இல்லை.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "pyq_bridging", "section": null, "reference": "TNPSC Group 4 (2017) & Ayutha Letter Exceptions", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "tnpsc", "exam_name": "group_4", "year": "2017", "paper": "general_tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-pyq-041", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'க், ச், ட், த், ப், ற்' ஆகிய வல்லின மெய்கள் ஒரு சொல்லின் இறுதியாக அமையாது.\nகாரணம் (R): வல்லின மெய்கள் வன்மையான ஓசையுடையவை; அவை சொல்லின் இறுதியில் தனி மெய்யாக நின்றால் தமிழின் இயல்பான மென்மையும் இனிமையும் குன்றும் என்பதால் தொல்காப்பியர் காலம் முதலே இவை இறுதியாகா மெய்களாகக் கொள்ளப்பட்டன.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்.", "B": "கூற்று சரி, காரணம் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "வல்லின மெய்கள் ஆறும் மொழி இறுதியில் தனித்து வாரா. கூற்று மற்றும் காரணம் இரண்டும் மிகச்சரி."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'க், ச், ட், த், ப், ற்' ஆகிய வல்லின மெய்கள் ஒரு சொல்லின் இறுதியாக அமையாது.", "reason": "வல்லின மெய்கள் வன்மையான ஓசையுடையவை; அவை சொல்லின் இறுதியில் தனி மெய்யாக நின்றால் தமிழின் இயல்பான மென்மையும் இனிமையும் குன்றும் என்பதால் தொல்காப்பியர் காலம் முதலே இவை இறுதியாகா மெய்களாகக் கொள்ளப்பட்டன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_opti