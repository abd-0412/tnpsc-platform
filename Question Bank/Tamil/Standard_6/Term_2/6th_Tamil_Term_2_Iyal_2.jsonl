{"id": "6th-t2-u2-014", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறுக்கெழுத்துப் புதிரில் உள்ள கலைச்சொல் விடைகளைப் பொருத்துக:\nபட்டியல் I:\n(a) நானிலம் படைத்தவன் ஆசிரியர்\n(b) அரேபியாவிலிருந்து இறக்குமதி செய்யப்பட்டது\n(c) பண்டமாற்று முறை\n(d) ஆழி என்பதன் பொருள்\n\nபட்டியல் II:\n1. கடல்\n2. ஒரு பொருளைக் கொடுத்து வேறு பொருள் பெறுவது\n3. குதிரை\n4. முடியரசன்", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-3, (c)-4, (d)-1", "C": "(a)-4, (b)-3, (c)-2, (d)-1", "D": "(a)-3, (b)-4, (c)-1, (d)-2"}, "explanation": "நானிலம் படைத்தவன் - முடியரசன் (4); அரேபிய இறக்குமதி - குதிரை (3); பண்டமாற்று - பொருளுக்குப் பொருள் (2); ஆழி - கடல் (1). சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section"