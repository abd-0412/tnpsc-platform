{"id": "6th-t2-u2-039", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தமிழ்நாட்டிலிருந்து அரேபியாவிற்கு மிளகும் சந்தனமும் ஏற்றுமதி செய்யப்பட்டன; அரேபியாவிலிருந்து குதிரைகள் இறக்குமதி செய்யப்பட்டன.\nகாரணம் (R): அரேபியக் குதிரைகள் மிகச் சிறந்த வலிமையும் வேகமும் கொண்ட போர்க்குதிரைகளாகத் திகழ்ந்ததால் தமிழக மன்னர்கள் அவற்றை விரும்பி வாங்கினர்.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்.", "B": "கூற்று சரி, காரணம் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "அரேபியாவிலிருந்து குதிரைகள் கடல்வழியாகத் தமிழகத் துறைமுகங்களுக்கு இறக்குமதி செய்யப்பட்டன."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "தமிழ்நாட்டிலிருந்து அரேபியாவிற்கு மிளகும் சந்தனமும் ஏற்றுமதி செய்யப்பட்டன; அரேபியாவிலிருந்து குதிரைகள் இறக்குமதி செய்யப்பட்டன.", "reason": "அரேபியக் குதிரைகள் மிகச் சிறந்த வலிமையும் வேகமும் கொண்ட போர்க்குதிரைகளாகத் திகழ்ந்ததால் தமிழக மன்னர்கள் அவற்றை விரும்பி வாங்கினர்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 33", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u2-050", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'உழைப்பே மூலதனம்' கதை குறித்த கூற்றுகளில் சரியானவற்றைத் தேர்க:\n1. 'பாடுபட்டுத் தேடிய பணத்தைப் புதைத்து வைக்காதீர்' என்பது ஔவையாரின் அறிவுரை ஆகும்.\n2. அருளப்பர் தன் பிள்ளைகளான வளவன், அமுதா, எழிலன் ஆகிய மூவருக்கும் ஆளுக்கு ஐம்பதாயிரம் ரூபாய் கொடுத்தார்.\n3. வளவன் பணத்தை உழவுத் தொழிலில் முதலீடு செய்து இரட்டிப்பாக்கினான்; அமுதா தையல் தொழில் செய்து முன்னேறினாள்.\n4. எழிலன் பணத்தைப் பத்திரமாக நிலத்தில் புதைத்து வைத்திருந்ததால் அருளப்பரால் பெரிதும் பாராட்டப்பட்டான்.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "C": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "கூற்று 4 தவறானது; எழிலன் பணத்தைப் பயன்படுத்தாமல் வைத்திருந்ததால் அருளப்பரால் கண்டிக்கப்பட்டு, உழைப்பின் அருமையை உணர்த்தப்பட்டான். பணத்தைப் புதைத்து வைப்பது மடமை."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'பாடுபட்டுத் தேடிய பணத்தைப் புதைத்து வைக்காதீர்' என்பது ஔவையாரின் அறிவுரை ஆகும்.", "content_en": null}, {"id": "S2", "content_ta": "அருளப்பர் தன் பிள்ளைகளான வளவன், அமுதா, எழிலன் ஆகிய மூவருக்கும் ஆளுக்கு ஐம்பதாயிரம் ரூபாய் கொடுத்தார்.", "content_en": null}, {"id": "S3", "content_ta": "வளவன் பணத்தை உழவுத் தொழிலில் முதலீடு செய்து இரட்டிப்பாக்கினான்; அமுதா தையல் தொழில் செய்து முன்னேறினாள்.", "content_en": null}, {"id": "S4", "content_ta": "எழிலன் பணத்தைப் பத்திரமாக நிலத்தில் புதைத்து வைத்திருந்ததால் அருளப்பரால் பெரிதும் பாராட்டப்பட்டான்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 36-38", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u2-041", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வணிகம் தொடர்பான சங்க இலக்கிய வரிகளையும் நூல்களையும் பொருத்துக:\nபட்டியல் I:\n(a) 'கொள்வதூஉம் மிகைகொளாது கொடுப்பதூஉம் குறைகொடாது'\n(b) 'வாணிகம் செய்வார்க்கு வாணிகம் பேணிப் பிறவும் தமபோல் செயின்'\n(c) 'பொன்னொடு வந்து கறியொடு பெயரும்'\n(d) 'பாலொடு வந்து கூழொடு பெயரும்'\n\nபட்டியல் II:\n1. குறுந்தொகை\n2. புறநானூறு\n3. திருக்குறள்\n4. பட்டினப்பாலை", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-3, (c)-4, (d)-1", "C": "(a)-4, (b)-3, (c)-2, (d)-1", "D": "(a)-3, (b)-4, (c)-1, (d)-2"}, "explanation": "கொள்வதூஉம் மிகைகொளாது... - பட்டினப்பாலை (4); வாணிகம் செய்வார்க்கு... - திருக்குறள் (3); பொன்னொடு வந்து... - புறநானூறு (2); பாலொடு வந்து... - குறுந்தொகை (1). சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 33-34", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "match"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u2-042", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வணிகச் சொற்களையும் அவர்தம் விளக்கங்களையும் பொருத்துக:\nபட்டியல் I:\n(a) வணிகச் சாத்து\n(b) நுகர்வோர்\n(c) பட்டினம்\n(d) பாக்கம்\n\nபட்டியல் II:\n1. கடற்கரைச் சிற்றூர்\n2. கடற்கரை நகரம் (துறைமுக நகரம்)\n3. பொருள்களை வாங்கிப் பயன்படுத்துபவர்\n4. வணிகர்கள் கூட்டமாகச் செல்லும் வணிகக் குழு", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-3, (c)-4, (d)-1", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-4, (b)-3, (c)-2, (d)-1"}, "explanation": "வணிகச் சாத்து - வணிகக் குழு; நுகர்வோர் - பொருளைப் பயன்படுத்துபவர்; பட்டினம் - கடற்கரை நகரம்; பாக்கம் - கடற்கரைச் சிற்றூர். சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 33", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "match"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
