{"id": "6th-t2-u2-004", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): கவிஞர் முடியரசன் 'திராவிட நாட்டின் வானம்பாடி' எனப் போற்றப்படுகிறார்.\nகாரணம் (R): பாவேந்தர் பாரதிதாசனின் தலைமாணாக்கராக விளங்கி, எளிய தமிழில் வீறுமிக்க திராவிட இயக்க எழுச்சிக் கவிதைகளைப் பாடியதால் பேரறிஞர் அண்ணா இவருக்கு இப்பெயரைச் சூட்டினார்.", "media_id": null}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "B": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் தவறானவை.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) கூற்றிற்குரிய (A) சரியான விளக்கம் ஆகும்."}, "explanation": "கூற்று, காரணம் இரண்டும் சரி. அண்ணாவால் 'திராவிட நாட்டின் வானம்பாடி' என்று போற்றப்பட்டவர் துரைராசு என்ற இயற்பெயர் கொண்ட கவிஞர் முடியரசன்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "கவிஞர் முடியரசன் 'திராவிட நாட்டின் வானம்பாடி' எனப் போற்றப்படுகிறார்.", "reason": "பாவேந்தர் பாரதிதாசனின் தலைமாணாக்கராக விளங்கி, எளிய தமிழில் வீறுமிக்க திராவிட இயக்க எழுச்சிக் கவிதைகளைப் பாடியதால் பேரறிஞர் அண்ணா இவருக்கு இப்பெயரைச் சூட்டினார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options