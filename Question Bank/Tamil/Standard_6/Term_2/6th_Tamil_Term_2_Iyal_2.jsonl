{"id": "6th-t2-u2-086", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அன்புடைமை அதிகாரத்தின் உவமைகள் குறித்த கூற்றுகளில் சரியானவற்றைத் தேர்க:\n1. 'என்பு இலதனை வெயில்போலக் காயுமே அன்பி லதனை அறம்' - எலும்பில்லாத புழு போன்ற உயிர்களை வெயில் சுட்டுப் பொசுக்குவது போல, அன்பில்லாத உயிர்களை அறக்கடவுள் தண்டித்து அழிக்கும்.\n2. 'அன்பகத்து இல்லா உயிர்வாழ்க்கை வன்பாற்கண் வற்றல் மரம்தளிர்த் தற்று' - மனதில் அன்பில்லாத மனிதனின் வாழ்வு, பாலைநிலத்தில் காய்ந்துபோன பட்டமரம் தளிர்ப்பது போன்ற வீண் செயலாகும்.\n3. 'புறத்துறுப்பு எல்லாம் எவன்செய்யும் யாக்கை அகத்துறுப்பு அன்பி லவர்க்கு' - உள்ளத்தில் அன்பில்லாதவர்க்கு உடலின் வெளி உறுப்புகளால் எந்தப் பயனும் இல்லை.\n4. அன்பில்லாத மனிதர்கள் உலகில் மிக உயர்ந்த செல்வச் சீமான்களாகத் திகழ்வர்.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "C": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "கூற்று 4 முற்றிலும் தவறானது; அன்பில்லாதவர் எலும்பும் தோலும் போர்த்த நடைப்பிணமே ஆவர் என்று வள்ளுவர் சாடுகிறார். 1, 2, 3 உவமைக் கூற்றுகள் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'என்பு இலதனை வெயில்போலக் காயுமே அன்பி லதனை அறம்' - எலும்பில்லாத புழு போன்ற உயிர்களை வெயில் சுட்டுப் பொசுக்குவது போல, அன்பில்லாத உயிர்களை அறக்கடவுள் தண்டித்து அழிக்கும்.", "content_en": null}, {"id": "S2", "content_ta": "'அன்பகத்து இல்லா உயிர்வாழ்க்கை வன்பாற்கண் வற்றல் மரம்தளிர்த் தற்று' - மனதில் அன்பில்லாத மனிதனின் வாழ்வு, பாலைநிலத்தில் காய்ந்துபோன பட்டமரம் தளிர்ப்பது போன்ற வீண் செயலாகும்.", "content_en": null}, {"id": "S3", "content_ta": "'புறத்துறுப்பு எல்லாம் எவன்செய்யும் யாக்கை அகத்துறுப்பு அன்பி லவர்க்கு' - உள்ளத்தில் அன்பில்லாதவர்க்கு உடலின் வெளி உறுப்புகளால் எந்தப் பயனும் இல்லை.", "content_en": null}, {"id": "S4", "content_ta": "அன்பில்லாத மனிதர்கள் உலகில் மிக உயர்ந்த செல்வச் சீமான்களாகத் திகழ்வர்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 45", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u2-087", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஈகை' அதிகாரக் குறள்கள் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. 'வறியார்க்கு ஒன்று ஈவதே ஈகை மற்றெல்லாம் குறியெதிர்ப்பை நீரது உடைத்து' - இல்லாத ஏழைக்குக் கொடுப்பதே உண்மையான ஈகையாகும்; கைம்மாறு கருதித் தருவதெல்லாம் வணிகப் பயன் போன்றதே.\n2. 'நல்லாறு எனினும் கொளல்தீது மேலுலகம் இல்எனினும் ஈதலே நன்று' - நல்வழி என்றாலும் பிறரிடம் ஏற்பது தீது; மேலுலகம் கிடைக்காவிட்டாலும் பிறருக்குக் கொடுப்பதே நன்று.\n3. 'ஆற்றுவார் ஆற்றல் பசிஆற்றல் அப்பசியை மாற்றுவார் ஆற்றலின் பின்' - தவம் செய்வோரின் ஆற்றல் பசியைப் பொறுத்துக் கொள்வதாகும்; ஆனால் அத்தகைய பசியைப் போக்குவோரின் ஆற்றல் தவத்தை விட மேலானது.\n4. தன் பொருளைப் பிறருக்குக் கொடுக்காமல் பதுக்கி வைத்து இழப்பவரே அறிவில் சிறந்தவர்.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "C": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "கூற்று 4 தவறானது; ஈத்துவக்கும் இன்பம் அறியாமல் பொருளைச் சேர்த்து வைத்து இழக்கும் கஞ்சர்களை 'வன்கணவர்' (கொடியவர்) என்று வள்ளுவர் குறள் 8-இல் கண்டிக்கிறார்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'வறியார்க்கு ஒன்று ஈவதே ஈகை மற்றெல்லாம் குறியெதிர்ப்பை நீரது உடைத்து' - இல்லாத ஏழைக்குக் கொடுப்பதே உண்மையான ஈகையாகும்; கைம்மாறு கருதித் தருவதெல்லாம் வணிகப் பயன் போன்றதே.", "content_en": null}, {"id": "S2", "content_ta": "'நல்லாறு எனினும் கொளல்தீது மேலுலகம் இல்எனினும் ஈதலே நன்று' - நல்வழி என்றாலும் பிறரிடம் ஏற்பது தீது; மேலுலக