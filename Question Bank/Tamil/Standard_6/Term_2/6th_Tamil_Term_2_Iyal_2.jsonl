// ==============================================================================
{"id": "6th-t2-u2-018", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மீனவர்களின் கல்வி மற்றும் விளையாட்டு தொடர்பான உருவகங்களை ஆராய்க:\n1. பாயும் புயல் அவர்தம் ஊஞ்சல் ஆகும்.\n2. மின்னல் வரிகள் அவர்தம் அரிச்சுவடி (அடிப்படைப் பாடம்) ஆகும்.\n3. பிடிக்கும் மீன்களே அவர்தம் சேமிக்கும் செல்வம் ஆகும்.\n4. கடலலைகள் அவர்தம் பகைவர்கள் ஆகும்.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "C": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "D": "கூற்றுகள் 2, 4 சரி; 1, 3 தவறு"}, "explanation": "கூற்று 4 தவறானது; பாடலில் 'அடிக்கும் அலை நம் தோழன்' என்றே கூறப்பட்டுள்ளது (தோழனே தவிர பகைவன் அல்ல). புயல் ஊஞ்சல், மின்னல் வரி அரிச்சுவடி, மீன்கள் செல்வம் ஆகியவை சரியானவை."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "பாயும் புயல் அவர்தம் ஊஞ்சல் ஆகும்.", "content_en": null}, {"id": "S2", "content_ta": "மின்னல் வரிகள் அவர்தம் அரிச்சுவடி (அடிப்படைப் பாடம்) ஆகும்.", "content_en": null}, {"id": "S3", "content_ta": "பிடிக்கும் மீன்களே அவர்தம் சேமிக்கும் செல்வம் ஆகும்.", "content_en": null}, {"id": "S4", "content_ta": "கடலலைகள் அவர்தம் பகைவர்கள் ஆகும்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_questi