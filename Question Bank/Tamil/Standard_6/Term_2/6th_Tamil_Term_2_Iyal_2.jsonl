{"id": "6th-t2-u2-091", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வ.சுப. மாணிக்கனாரின் எளிய உரை மற்றும் திருக்குறள் பதிப்பு குறித்த கூற்றுகளை ஆராய்க:\n1. 6-ஆம் வகுப்பு இரண்டாம் பருவத் திருக்குறளுக்கு எளிய உரை எழுதியவர் டாக்டர் வ.சுப. மாணிக்கனார் ஆவார்.\n2. புதிய பாடத்திட்டத்தில் மாணவர்களுக்காகத் திருக்குறளின் 150 பாக்கள் சேர்க்கப்பட்டுள்ளன.\n3. மாணவர்கள் எளிதில் படித்துப் பொருள் புரிந்துகொள்வதற்காகக் குறட்பாக்களின் சொற்கள் பிரித்துத் தரப்பட்டுள்ளன; இது அலகிடுவதற்கு அன்று என்று குறிப்பில் குறிப்பிடப்பட்டுள்ளது.\n4. திருக்குறள் நாடகங்களை பள்ளிகளில் நடத்தக் கூடாது என்று அறிவுறுத்தப்பட்டுள்ளது.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "C": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "D": "கூற்றுகள் 2, 4 சரி; 1, 3 தவறு"}, "explanation": "கூற்று 4 தவறானது; பள்ளி வழிபாட்டுக் கூட்டம், நாடகங்கள், வினாடி வினாக்கள் ஆகியவற்றில் திருக்குறளைக் கொண்டு சேர்க்க வேண்டும் என்று பாடநூல் பக்கம் 47-இல் பரிந்துரைக்கப்பட்டுள்ளது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "6-ஆம் வகுப்பு இரண்டாம் பருவத் திருக்குறளுக்கு எளிய உரை எழுதியவர் டாக்டர் வ.சுப. மாணிக்கனார் ஆவார்.", "content_en": null}, {"id": "S2", "content_ta": "புதிய பாடத்திட்டத்தில் மாணவர்களுக்காகத் திருக்குறளின் 150 பாக்கள் சேர்க்கப்பட்டுள்ளன.", "content_en": null}, {"id": "S3", "content_ta": "மாணவர்கள் எளிதில் படித்துப் பொருள் புரிந்துகொள்வதற்காகக் குறட்பாக்களின் சொற்கள் பிரித்துத் தரப்பட்டுள்ளன; இது அலகிடுவதற்கு அன்று என்று குறிப்பில் குறிப்பிடப்பட்டுள்ளது.", "content_en": null}, {"id": "S4", "content_ta": "திருக்குறள் நாடகங்களை பள்ளிகளில் நடத்தக் கூடாது என்று அறிவுறுத்தப்பட்டுள்ளது.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 47", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u2-092", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'என்பிலதனை வெயில்போலக் காயுமே அன்பிலதனை அறம்' என்றார் திருவள்ளுவர்.\nகாரணம் (R): எலும்பில்லாத புழு பூச்சிகளை வெயிலின் வெப்பம் சுட்டெரிப்பது போல, உள்ளத்தில் அன்பில்லாத உயிர்களை அறக்கடவுள் தன் ஆற்றலால் தண்டித்து அழிக்கும்.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு.", "B": "கூற்று தவறு, காரணம் சரி.", "C": "கூற்று, காரணம் இரண்டும் தவறு.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) கூற்றிற்கு (A) பொருத்தமான விளக்கமாகும்."}, "explanation": "என்பு இலது = எலும்பு இல்லாத புழு. அன்பிலது = அன்பு இல்லாத மனிதன். எடுத்துக்காட்டு உவமையணி போல அமைந்த மிகச்சிறந்த தத்துவக் குறள்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'என்பிலதனை வெயில்போலக் காயுமே அன்பிலதனை அறம்' என்றார் திருவள்ளுவர்.", "reason": "எலும்பில்லாத புழு பூச்சிகளை வெயிலின் வெப்பம் சுட்டெரிப்பது போல, உள்ளத்தில் அன்பில்லாத உயிர்களை அறக்கடவுள் தன் ஆற்றலால் தண்டித்து அழிக்கும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 45", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u2-093", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'அன்பின் வழியது உயிர்நிலை அஃதுஇலார்க்கு என்புதோல் போர்த்த உடம்பு' என்றார் வள்ளுவர்.\nகாரணம் (R): நெஞ்சில் அன்பு கொண்டு பிறருக்கு இரங்கும் மனிதனின் உடலே உயிருள்ள உடம்பாகும்; அன்பில்லாதவரின் உடம்பு வெறும் எலும்பின் மீது தோல் போர்த்தப்பட்ட நடைப்பிணமே ஆகும்.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்.", "B": "கூற்று சரி, காரணம் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "கூற்று, காரணம் இரண்டும் சரி. மனித வாழ்வின் உயிர்த்தன்மையை அன்போடு பிணைத்துக் கூறும் குறள் இது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'அன்பின் வழியது உயிர்நிலை அஃதுஇலார்க்கு என்புதோல் போர்த்த உடம்பு' என்றார் வள்ளுவர்.", "reason": "நெஞ்சில் அன்பு கொண்டு பிறருக்கு இரங்கும் மனிதனின் உடலே உயிருள்ள உடம்பாகும்; அன்பில்லாதவரின் உடம்பு வெறும் எலும்பின் மீது தோல் போர்த்தப்பட்ட நடைப்பிணமே ஆகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 45", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u2-094", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): இல்லாத ஏழைகளுக்குக் கொடுப்பதே உண்மையான ஈகை ஆகும்.\nகாரணம் (R): மறுபயன் அல்லது கைம்மாறு எதிர்பார்த்துக் கொடுக்கும் கொடைகளும் ஈகையின் உயர்ந்த வகையிலேயே அடங்கும் என்று வள்ளுவர் கூறுகிறார்.", "media_id": null}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி.", "B": "கூற்று சரி, ஆனால் காரணம் முற்றிலும் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "கூற்று சரி, காரணம் தவறு. 'வறியார்க்கு ஒன்று ஈவதே ஈகை மற்றெல்லாம் குறியெதிர்ப்பை நீரது உடைத்து' - கைம்மாறு கருதித் தருவதெல்லாம் வணிகக் கடனே தவிர ஈகை ஆகாது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "இல்லாத ஏழைகளுக்குக் கொடுப்பதே உண்மையான ஈகை ஆகும்.", "reason": "மறுபயன் அல்லது கைம்மாறு எதிர்பார்த்துக் கொடுக்கும் கொடைகளும் ஈகையின் உயர்ந்த வகையிலேயே அடங்கும் என்று வள்ளுவர் கூறுகிறார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 46", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u2-095", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தவம் செய்வோரின் பசிபொறுக்கும் ஆற்றலை விட, பசியால் வாடுவோரின் பசியைத் தீர்ப்போரின் ஆற்றல் மேலானது.\nகாரணம் (R): 'ஆற்றுவார் ஆற்றல் பசிஆற்றல் அப்பசியை மாற்றுவார் ஆற்றலின் பின்' என்று வள்ளுவர் ஈகையின் தனிப்பெரும் ஆற்றலைத் தவத்தை விடவும் உயர்த்திப் பாடியுள்ளார்.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு.", "B": "கூற்று தவறு, காரணம் சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) சரியான விளக்கம்.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "தவத்தினால் பசியைப் பொறுப்பதை விட, ஏழையின் பசியை உணவிட்டுப் போக்குவதே மனித குலத்தின் தலையாய ஆற்றலாகும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "தவம் செய்வோரின் பசிபொறுக்கும் ஆற்றலை விட, பசியால் வாடுவோரின் பசியைத் தீர்ப்போரின் ஆற்றல் மேலானது.", "reason": "'ஆற்றுவார் ஆற்றல் பசிஆற்றல் அப்பசியை மாற்றுவார் ஆற்றலின் பின்' என்று வள்ளுவர் ஈகையின் தனிப்பெரும் ஆற்றலைத் தவத்தை விடவும் உயர்த்திப் பாடியுள்ளார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 46", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u2-096", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தான் சேர்த்த செல்வத்தைப் பாதுகாத்து வைக்கும் சிறந்த இடம் ஏழைகளின் பசியைத் தீர்ப்பதே ஆகும்.\nகாரணம் (R): 'அற்றார் அழிபசி தீர்த்தல் அஃதொருவன் பெற்றான் பொருள்வைப் புழி' என்று வள்ளுவர் பொருள் வைக்கும் இடமாக ஏழைகளின் வயிறுகளைச் சுட்டுகிறார்.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு.", "B": "கூற்று தவறு, காரணம் சரி.", "C": "கூற்று, காரணம் இரண்டும் தவறு.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) கூற்றிற்குப் பொருத்தமான விளக்கம் ஆகும்."}, "explanation": "பொருள் வைப்புழி = பொருளைச் சேமித்து வைக்கும் பாதுகாப்பான பெட்டகம். அற்றார் = ஏழைகள். ஏழைகளின் பசியைப் போக்குவதே அழியாத வைப்பு நிதி."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "தான் சேர்த்த செல்வத்தைப் பாதுகாத்து வைக்கும் சிறந்த இடம் ஏழைகளின் பசியைத் தீர்ப்பதே ஆகும்.", "reason": "'அற்றார் அழிபசி தீர்த்தல் அஃதொருவன் பெற்றான் பொருள்வைப் புழி' என்று வள்ளுவர் பொருள் வைக்கும் இடமாக ஏழைகளின் வயிறுகளைச் சுட்டுகிறார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book"