{"id": "6th-t2-u2-100", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "குறட்பாக்களின் தொடக்கச் சீர்களையும் இறுதிச் சீர்களையும் பொருத்துக:\nபட்டியல் I (தொடக்கச் சீர்):\n(a) அன்பிற்கும் உண்டோ\n(b) அன்பிலார் எல்லாம்\n(c) வறியார்க்கு ஒன்று ஈவதே\n(d) பாத்தூண் மரீஇ\n\nபட்டியல் II (இறுதிச் சீர்):\n1. தீண்டல் அரிது\n2. நீரது உடைத்து\n3. என்பும் உரியர் பிறர்க்கு\n4. பூசல் தரும்", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-3, (c)-4, (d)-1", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-4, (b)-3, (c)-2, (d)-1"}, "explanation": "அன்பிற்கும் உண்டோ... பூசல் தரும் (4); அன்பிலார் எல்லாம்... என்பும் உரியர் பிறர்க்கு (3); வறியார்க்கு ஒன்று ஈவதே... நீரது உடைத்து (2); பாத்தூண் மரீஇ... தீண்டல் அரிது (1). சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication