// பாடம் 3: வளரும் வணிகம் (உரைநடை உலகம் - சங்க கால வணிகம் & ஏற்றுமதி) [Q029 - Q049] (வினாக்கள்: 21)
// பண்டமாற்று முறை (நெல்லுக்கு உப்பு, பாலுக்கு தானியம்), தரைவழி/நீர்வழி வணிகம், வணிகச் சாத்து (வணிகக் குழு), துறைமுகங்கள்: பட்டினம், பாக்கம், முதன்மைத் துறைமுகம் பூம்புகார்; ஏற்றுமதி-இறக்குமதி: சீனா (பட்டு, கண்ணாடி, கற்பூரம்), அரேபியா (குதிரை), தமிழ்நாடு (மிளகு, சந்தனம், இஞ்சி, ஏலக்காய், முத்து, பவளம்); சங்க இலக்கிய வரிகள்: பட்டினப்பாலை ("கொள்வதூஉம் மிகைகொளாது... நடுவுநின்ற நன்னெஞ்சினோர்"), திருக்குறள் ("வாணிகம் செய்வார்க்கு..."), புறநானூறு ("பொன்னொடு வந்து கறியொடு பெயரும்"), குறுந்தொகை ("பாலொடு வந்து..."), மதுரைக்காஞ்சி ("நாளங்காடி, அல்லங்காடி"); மின் வணிகம்/இணையவழி வணிகம், கலைச்சொற்கள்
// ==============================================================================
{"id": "6th-t2-u2-029", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "சங்க காலப் பண்டமாற்று வணிகம் குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. ஒரு பொருளைக் கொடுத்து வேறொரு பொருளைப் பெறும் முறை 'பண்டமாற்று வணிகம்' எனப்படும்.\n2. நெல்லைக் கொடுத்து அதற்கு ஈடாக உப்பைப் பெற்றனர்.\n3. ஆட்டின் பாலைக் கொடுத்து தானியத்தைப் பெற்றனர்.\n4. 'பாலொடு வந்து கூழொடு பெயரும்' (குறுந்தொகை) மற்றும் 'பொன்னொடு வந்து கறியொடு பெயரும்' (புறநானூறு) ஆகிய சங்க வரிகள் பண்டமாற்று வணிகத்திற்குச் சான்றுகளாகும்.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரியானவை", "B": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "C": "கூற்றுகள் 1, 3 சரி; 2, 4 தவறு", "D": "கூற்றுகள் 2, 4 சரி; 1, 3 தவறு"}, "explanation": "நான்கு கூற்றுகளும் சங்க காலப் பண்டமாற்று வணிகத்தை விளக்கும் பாடநூல் செய்திகள் ஆகும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ஒரு பொருளைக் கொடுத்து வேறொரு பொருளைப் பெறும் முறை 'பண்டமாற்று வணிகம்' எனப்படும்.", "content_en": null}, {"id": "S2", "content_ta": "நெல்லைக் கொடுத்து அதற்கு ஈடாக உப்பைப் பெற்றனர்.", "content_en": null}, {"id": "S3", "content_ta": "ஆட்டின் பாலைக் கொடுத்து தானியத்தைப் பெற்றனர்.", "content_en": null}, {"id": "S4", "content_ta": "'பாலொடு வந்து கூழொடு பெயரும்' (குறுந்தொகை) மற்றும் 'பொன்னொடு வந்து கறியொடு பெயரும்' (புறநானூறு) ஆகிய சங்க வரிகள் பண்டமாற்று வணிகத்திற்குச் சான்றுகளாகும்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null,