{"id": "6th-t2-u2-064", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'கண்ணில்' என்னும் சொல்லில் மெல்லினத்திற்கான இன எழுத்து இடம்பெறவில்லை.\nகாரணம் (R): இச்சொல்லில் 'ண்' என்னும் மெல்லினத்தைத் தொடர்ந்து 'ணி' (ண்+இ) என்னும் மெல்லின உயிர்மெய்யே வந்துள்ளதே தவிர, டகர வல்லின மெய் வரவில்லை.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு.", "B": "கூற்று தவறு, காரணம் சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "புத்தக மதிப்பீட்டு வினா: 'மஞ்சள்' (ஞ்-ச்), 'வந்தான்' (ந்-த்), 'தம்பி' (ம்-ப்) ஆகியவற்றில் இன எழுத்து உண்டு; 'கண்ணில்' என்பதில் இன எழுத்து அமையவில்லை."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'கண்ணில்' என்னும் சொல்லில் மெல்லினத்திற்கான இன எழுத்து இடம்பெறவில்லை.", "reason": "இச்சொல்லில் 'ண்' என்னும் மெல்லினத்தைத் தொடர்ந்து 'ணி' (ண்+இ) என்னும் மெல்லின உயிர்மெய்யே வந்துள்ளதே தவிர, டகர வல்லின மெய் வரவில்லை.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publish