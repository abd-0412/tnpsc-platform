{"id": "6th-t2-u1-018", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "தாலாட்டுப் பாடலில் வரும் நாடுகள் மற்றும் அவற்றின் வளங்களைப் பொருத்துக:\nபட்டியல் I:\n(a) சேர நாடு\n(b) சோழ நாடு\n(c) பாண்டிய நாடு\n(d) தாய்மாமன்\n\nபட்டியல் II:\n1. முத்தமிழ் தந்த நாடு\n2. சீரோடு முரசு கொட்டித் தந்தது\n3. முத்தேன் தந்த நாடு\n4. முக்கனி தந்த நாடு", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-3, (b)-4, (c)-1, (d)-2", "C": "(a)-4, (b)-3, (c)-2, (d)-1", "D": "(a)-2, (b)-1, (c)-4, (d)-3"}, "explanation": "சேர நாடு - முத்தேன்; சோழ நாடு - முக்கனி; பாண்டிய நாடு - முத்தமிழ்; தாய்மாமன் - சீரோடு வந்து தந்தது. சரியான பொருத்தம்: 3, 4, 1, 2."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1