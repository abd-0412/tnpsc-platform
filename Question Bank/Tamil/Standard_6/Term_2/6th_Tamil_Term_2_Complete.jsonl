{"id": "6th-t2-u1-010", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "ஆசாரக்கோவை கூறும் நல்ஒழுக்க விதைகளுள் பொருந்தாத ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "நன்றியறிதல்", "B": "பொறையுடைமை", "C": "ஒப்புரவு", "D": "புலால் உண்ணாமை"}, "explanation": "'புலால் உண்ணாமை' என்பது திருக்குறள் மற்றும் ஆசாரக்கோவையின் பிற பாடல்களில் வந்தாலும், இப்பாடலில் கூறப்பட்டுள்ள எட்டு நல்லொழுக்க விதைகளுள் இடம்பெறவில்லை. இப்பாடலில் நன்றியறிதல், பொறையுடைமை, இன்சொல், இன்னா செய்யாமை, கல்வி, ஒப்புரவு, அறிவுடைமை, நல்லினத்தாரோடு நட்டல் ஆகிய எட்டே கூறப்பட்டுள்ளன."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": true, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exa