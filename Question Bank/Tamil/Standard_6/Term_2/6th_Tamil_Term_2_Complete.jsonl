{"id": "6th-t2-u1-005", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): பெருவாயின் முள்ளியார் 'நன்றியறிதல் பொறையுடைமை இன்சொல்லோடு...' என்னும் பாடலில் நல்லொழுக்கத்தை விதைகளோடு ஒப்பிடுகிறார்.\nகாரணம் (R): நிலத்தில் விதைக்கப்பட்ட நல்வித்துகள் செழித்து வளர்ந்து நற்பயன் தருவது போல, மனித உள்ளத்தில் விதைக்கப்படும் இந்த எட்டு ஒழுக்கங்களும் வாழ்க்கையைச் செம்மைப்படுத்தும் நற்பண்புகளாக விளங்குகின்றன.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு.", "B": "கூற்று தவறு, காரணம் சரி.", "C": "கூற்று, காரணம் இரண்டும் தவறு.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) கூற்றிற்கு (A) பொருத்தமான விளக்கமாகும்."}, "explanation": "ஆசார வித்து = ஒழுக்கத்தை உண்டாக்கும் விதைகள். விதைகளிலிருந்து நல்ல பயிர் முளைப்பது போல், இந்த எட்டுக் குணங்களால் நல்வாழ்வு உண்டாகும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "பெருவாயின் முள்ளியார் 'நன்றியறிதல் பொறையுடைமை இன்சொல்லோடு...' என்னும் பாடலில் நல்லொழுக்கத்தை விதைகளோடு ஒப்பிடுகிறார்.", "reason": "நிலத்தில் விதைக்கப்பட்ட நல்வித்துகள் செழித்து வளர்ந்து நற்பயன் தருவது போல, மனித உள்ளத்தில் விதைக்கப்படும் இந்த எட்டு ஒழுக்கங்களும் வாழ்க்கையைச் செம்மைப்படுத்தும் நற்பண்புகளாக விளங்குகின்றன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 2", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u1-015", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தாலாட்டுப் பாடல்கள் வாய்மொழி இலக்கிய வகையுள் அடங்கும்.\nகாரணம் (R): ஏட்டிலோ நூலிலோ எழுதப்படாமல் தாய்மார்களின் நாவிலிருந்து நாவிற்குப் பரவி வாய்வழியாகவே தலைமுறை தலைமுறையாகப் பாடப்பட்டு வருவதால் இது வாய்மொழி இலக்கியம் ஆயிற்று.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) சரியான விளக்கமாகும்.", "B": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; ஆனால் காரணம் (R) சரியான விளக்கமல்ல.", "C": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "D": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி."}, "explanation": "தால் + ஆட்டு = தாலாட்டு. நாவசைத்துப் பாடப்பட்டு வழிவழியாகப் பரவிவரும் நாட்டுப்புற வாய்மொழி இலக்கியம் இதுவாகும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "தாலாட்டுப் பாடல்கள் வாய்மொழி இலக்கிய வகையுள் அடங்கும்.", "reason": "ஏட்டிலோ நூலிலோ எழுதப்படாமல் தாய்மார்களின் நாவிலிருந்து நாவிற்குப் பரவி வாய்வழியாகவே தலைமுறை தலைமுறையாகப் பாடப்பட்டு வருவதால் இது வாய்மொழி இலக்கியம் ஆயிற்று.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": 