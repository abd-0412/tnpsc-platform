{"id": "6th-t2-u1-095", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'உள்ளுவது எல்லாம் உயர்வுள்ளல் மற்றது தள்ளினும் தள்ளாமை நீர்த்து' - இக்குறள் தரும் கருத்துகளை ஆராய்க:\n1. எண்ணுவதெல்லாம் உயர்வாகவே எண்ண வேண்டும்.\n2. நாம் எண்ணிய உயர்ந்த எண்ணம் கைகூடாவிட்டாலும் அத்தகைய உயர்வான எண்ணமே மனநிறைவைத் தரும்.\n3. நாம் பிறரை ஏமாற்றி வாழ்வதே உயர்வான வாழ்வாகும்.\n4. மனிதனின் பெருமை அவன் கொள்ளும் உயர்ந்த குறிக்கோளிலேயே அடங்கியுள்ளது.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்றுகள் 1, 3 சரி; 2, 4 தவறு", "C": "கூற்றுகள் 1, 2, 4 சரி; 3 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "கூற்று 3 முற்றிலும் தவறானது. 1, 2, 4 ஆகிய கூற்றுகள் உள்ளுவதெல்லாம் உயர்வுள்ளல் குறளின் சரியான வாழ்வியல் விளக்கங்கள்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "எண்ணுவதெல்லாம் உயர்வாகவே எண்ண வேண்டும்.", "content_en": null}, {"id": "S2", "content_ta": "நாம் எண்ணிய உயர்ந்த எண்ணம் கைகூடாவிட்டாலும் அத்தகைய உயர்வான எண்ணமே மனநிறைவைத் தரும்.", "content_en": null}, {"id": "S3", "content_ta": "நாம் பிறரை ஏமாற்றி வாழ்வதே உயர்வான வாழ்வாகும்.", "content_en": null}, {"id": "S4", "content_ta": "மனிதனின் பெருமை அவன் கொள்ளும் உயர்ந்த குறிக்கோளிலேயே அடங்கியுள்ளது.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 22", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u1-096", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'விருந்து புறத்ததாத் தானுண்டல் சாவா மருந்தெனினும் வேண்டற்பாற்று அன்று' என்றார் வள்ளுவர்.\nகாரணம் (R): சாகா மருந்தாகிய தேவாமிர்தமே கிடைத்தாலும், இல்லத்திற்கு வந்த விருந்தினரை வெளியே காக்க வைத்துவிட்டுத் தான் மட்டும் உண்பது அறநெறிக்கு முரணான விரும்பத்தகாத செயலாகும்.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு.", "B": "கூற்று தவறு, காரணம் சரி.", "C": "கூற்று, காரணம் இரண்டும் தவறு.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) கூற்றிற்குரிய சரியான விளக்கம் ஆகும்."}, "explanation": "கூற்று மற்றும் காரணம் இரண்டும் மிகச்சரி. விருந்தோம்பலின் உச்சகட்ட அறத்தை வள்ளுவர் இக்குறளில் நிலைநாட்டுகிறார்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'விருந்து புறத்ததாத் தானுண்டல் சாவா மருந்தெனினும் வேண்டற்பாற்று அன்று' என்றார் வள்ளுவர்.", "reason": "சாகா மருந்தாகிய தேவாமிர்தமே கிடைத்தாலும், இல்லத்திற்கு வந்த விருந்தினரை வெளியே காக்க வைத்துவிட்டுத் தான் மட்டும் உண்பது அறநெறிக்கு முரணான விரும்பத்தகாத செயலாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": 