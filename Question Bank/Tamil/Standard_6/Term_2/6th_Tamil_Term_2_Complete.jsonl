{"id": "6th-t2-u1-067", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மொழி இறுதி எழுத்துகளின் மொத்த எண்ணிக்கை மற்றும் வகைகள் குறித்த கூற்றுகளை ஆராய்க:\n1. மொழி இறுதியில் வரும் உயிரெழுத்துகள் (உயிர்மெய்யாக) = 12.\n2. மொழி இறுதியில் வரும் மெய்யெழுத்துகள் = 11.\n3. மொழி இறுதியில் வரும் குற்றியலுகரம் = 1.\n4. இவை தவிர ஆய்த எழுத்தும் சொல்லின் இறுதியில் வரும்.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "C": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "கூற்று 4 தவறானது; ஆய்த எழுத்து சொல்லின் இறுதியில் ஒருபோதும் வராது. மொழி இறுதி எழுத்துகள் மொத்தம் 24 (உயிர் 12 + மெய் 11 + குற்றியலுகரம் 1)."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "மொழி இறுதியில் வரும் உயிரெழுத்துகள் (உயிர்மெய்யாக) = 12.", "content_en": null}, {"id": "S2", "content_ta": "மொழி இறுதியில் வரும் மெய்யெழுத்துகள் = 11.", "content_en": null}, {"id": "S3", "content_ta": "மொழி இறுதியில் வரும் குற்றியலுகரம் = 1.", "content_en": null}, {"id": "S4", "content_ta": "இவை தவிர ஆய்த எழுத்தும் சொல்லின் இறுதியில் வரும்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 15-16", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u1-068", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தமிழ் மொழியில் தனி உயிரெழுத்துகள் ஒரு சொல்லின் இறுதியில் தனித்து வருவதில்லை.\nகாரணம் (R): உயிரெழுத்துகள் மெய்யெழுத்துடன் இணைந்து உயிர்மெய்யாக மட்டுமே சொல்லின் இறுதியில் ஒலிக்கும்; அளபெடையில் மட்டுமே தனித்து வர அனுமதிக்கப்படுகிறது.", "media_id": null}], "options": {"A": "கூற்று (A) சரி, ஆனால் காரணம் (R) தவறு.", "B": "கூற்று (A) தவறு, ஆனால் காரணம் (R) சரி.", "C": "கூற்று, காரணம் இரண்டும் தவறானவை.", "D": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) கூற்றிற்குரிய சரியான விளக்கம் ஆகும்."}, "explanation": "உயிரெழுத்துகள் சொல்லின் இறுதியில் தனித்து வாரா; உயிர்மெய்யாக மட்டுமே வரும் (எ.கா: பல = ல்+அ). அளபெடையில் மட்டுமே தனித்து வரும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "தமிழ் மொழியில் தனி உயிரெழுத்துகள் ஒரு சொல்லின் இறுதியில் தனித்து வருவதில்லை.", "reason": "உயிரெழுத்துகள் மெய்யெழுத்துடன் இணைந்து உயிர்மெய்யாக மட்டுமே சொல்லின் இறுதியில் ஒலிக்கும்; அளபெடையில் மட்டுமே தனித்து வர அனுமதிக்கப்படுகிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"t