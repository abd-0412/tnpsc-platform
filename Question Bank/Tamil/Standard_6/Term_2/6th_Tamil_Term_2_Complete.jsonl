{"id": "6th-t2-u2-011", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கவிஞர் முடியரசன் இயற்றிய நூல்களுள் பொருந்தாத ஒன்றைத் தேர்க:", "media_id": null}], "options": {"A": "பூங்கொடி", "B": "வீரகாவியம்", "C": "காவியப்பாவை", "D": "எழிலோவியம்"}, "explanation": "'எழிலோவியம்' என்பது கவிஞர் வாணிதாசனின் நூலாகும். பூங்கொடி, வீரகாவியம், காவியப்பாவை, புதியதொரு விதி செய்வோம் ஆகியவை முடியரசனின் படைப்புகள்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": true, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 27", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key