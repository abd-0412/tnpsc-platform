{"id": "6th-t2-u2-066", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): செய்யுளில் 'ஓஓதல் வேண்டும்', 'தூஉம்' என உயிர் எழுத்துகள் அளபெடுத்து வருகின்றன.\nகாரணம் (R): செய்யுளில் ஓசை குறையும்போது அதனை நிறைவு செய்ய நெடில் எழுத்துகளுக்கு இனமாகிய குறில் எழுத்துகள் அவற்றின் பின்னால் இணைந்து வருகின்றன.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்.", "B": "கூற்று சரி, காரணம் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "செய்யுளில் அளபெடையில் மட்டுமே உயிர் எழுத்துகள் சொல்லின் இடையில் அல்லது இறுதியில் இவ்வாறு இனமாகி வரும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "செய்யுளில் 'ஓஓதல் வேண்டும்', 'தூஉம்' என உயிர் எழுத்துகள் அளபெடுத்து வருகின்றன.", "reason": "செய்யுளில் ஓசை குறையும்போது அதனை நிறைவு செய்ய நெடில் எழுத்துகளுக்கு இனமாகிய குறில் எழுத்துகள் அவற்றின் பின்னால் இணைந்து வருகின்றன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and E