{"id": "6th-t2-u1-054", "schema_version": "1.0", "kind": "odd_one_out", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அறுவடைத் திருநாளை 'மகர சங்கராந்தி' என்ற பெயரில் கொண்டாடாத மாநிலத்தைத் தேர்க:", "media_id": null}], "options": {"A": "ஆந்திரப் பிரதேசம்", "B": "கர்நாடகா", "C": "மகாராஷ்டிரா", "D": "பஞ்சாப்"}, "explanation": "பஞ்சாப் மாநிலத்தில் அறுவடைத் திருநாள் 'லோரி' (Lohri) என்ற பெயரில் கொண்டாடப்படுகிறது. ஆந்திரா, கர்நாடகா, மகாராஷ்டிரா, உ.பி ஆகியவற்றில் 'மகர சங்கராந்தி' கொண்டாடப்படுகிறது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "D", "accepted_keys": ["D"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": true, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 8", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "offic