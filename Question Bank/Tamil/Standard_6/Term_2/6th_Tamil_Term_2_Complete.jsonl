{"id": "6th-t2-u2-021", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): நெய்தல் நில மக்களின் முதன்மை மலராகத் தாழம்பூ குறிப்பிடப்படுகிறது.\nகாரணம் (R): உவர்நிலக் கடலோர மணற்பாங்கான இடங்களில் தாழை மரங்கள் செழித்து வளர்ந்து மணமிக்க பூக்களைத் தருவதால் இது நெய்தல் நிலப் பூவாயிற்று.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்.", "B": "கூற்று சரி, காரணம் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "நெய்தல் நிலத்திற்குரிய பூ தாழம்பூ ஆகும். கடலோரக் கழிமுகங்களிலும் மணல்வெளிகளிலும் தாழம்பூ பூத்துக் குலுங்கும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "நெய்தல் நில மக்களின் முதன்மை மலராகத் தாழம்பூ குறிப்பிடப்படுகிறது.", "reason": "உவர்நிலக் கடலோர மணற்பாங்கான இடங்களில் தாழை மரங்கள் செழித்து வளர்ந்து மணமிக்க பூக்களைத் தருவதால் இது நெய்தல் நிலப் பூவாயிற்று.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 29", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u2-019", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): நெய்தல் நில மீனவர்கள் 'முழுநிலாவைக் கண்ணாடி'யாக உருவகிக்கின்றனர்.\nகாரணம் (R): சூரிய ஒளியில் மீன்பிடிக்க முடியாததால் மீனவர்கள் இரவில் மட்டுமே கடலுக்குச் சென்று மீன்பிடிப்பர்.", "media_id": null}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி.", "B": "கூற்று சரி, ஆனால் காரணம் முற்றிலும் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "கூற்று சரி, காரணம் தவறு. மீனவர்கள் இரவும் பகலும் கடலில் உழைப்பவர்கள். வானில் ஒளிரும் வட்ட முழுநிலா அவர்தம் முகத்தைப் பார்த்துக் கொள்ளும் கண்ணாடியாக உவமிக்கப்பட்டுள்ளதே தவிர சூரிய ஒளியில் மீன்பிடிக்க முடியாது என்பதற்காக அல்ல."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "நெய்தல் நில மீனவர்கள் 'முழுநிலாவைக் கண்ணாடி'யாக உருவகிக்கின்றனர்.", "reason": "சூரிய ஒளியில் மீன்பிடிக்க முடியாததால் மீனவர்கள் இரவில் மட்டுமே கடலுக்குச் சென்று மீன்பிடிப்பர்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook a