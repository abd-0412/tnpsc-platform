{"id": "6th-t2-u1-099", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): அறிவில் சிறந்த சான்றோர்கள் பெரும்பயன் தராத வீண் சொற்களை ஒருபோதும் பேசமாட்டார்கள்.\nகாரணம் (R): 'அரும்பயன் ஆயும் அறிவினார் சொல்லார் பெரும்பயன் இல்லாத சொல்' என்று வள்ளுவர் கூறியுள்ளது இதனை உறுதிப்படுத்துகிறது.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்.", "B": "கூற்று சரி, காரணம் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "நன்மையான பயன்களை ஆராயும் அறிவுடையோர் ஒருபோதும் பயனற்ற வீண் சொற்களைப் பேச மாட்டார்கள்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "அறிவில் சிறந்த சான்றோர்கள் பெரும்பயன் தராத வீண் சொற்களை ஒருபோதும் பேசமாட்டார்கள்.", "reason": "'அரும்பயன் ஆயும் அறிவினார் சொல்லார் பெரும்பயன் இல்லாத சொல்' என்று வள்ளுவர் கூறியுள்ளது இதனை உறுதிப்படுத்துகிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 22", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u1-097", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'உள்ளம் உடைமை உடைமை பொருளுடைமை நில்லாது நீங்கி விடும்' என்றார் வள்ளுவர்.\nகாரணம் (R): பொன், பொருள் போன்ற வெளிப்படையான செல்வங்கள் ஒருபோதும் அழியாமல் மனிதனிடம் நிரந்தரமாக நிலைத்து நிற்கும்.", "media_id": null}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி.", "B": "கூற்று சரி, ஆனால் காரணம் முற்றிலும் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "கூற்று சரி, காரணம் தவறு. பொருட்செல்வம் நில்லாது நீங்கிவிடும் (அழியக்கூடியது); உள்ளத்தில் இருக்கும் ஊக்கமே ஒருவனுக்கு அழியாத நிலையான செல்வமாகும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'உள்ளம் உடைமை உடைமை பொருளுடைமை நில்லாது நீங்கி விடும்' என்றார் வள்ளுவர்.", "reason": "பொன், பொருள் போன்ற வெளிப்படையான செல்வங்கள் ஒருபோதும் அழியாமல் மனிதனிடம் நிரந்தரமாக நிலைத்து நிற்கும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 22", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u1-092", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'ஊக்கமுடைமை' அதிகாரக் குறள்கள் குறித்த கூற்றுகளை ஆராய்க:\n1. ஊக்கமே நிலையான உடைமை; மற்ற பொருளுடைமை நிலைத்து நில்லாமல் நீங்கிவிடும்.\n2. தளராத ஊக்கம் உடையவனிடம் ஆக்கமானது (செல்வம்) தானே வழிகேட்டுக்கொண்டு செல்லும்.\n3. 'வெள்ளத்து அனைய மலர்நீட்டம் மாந்தர்தம் உள்ளத்து அனையது உயர்வு' - தண்ணீரின் உயரத்திற்கு ஏற்ப நீர்மலர்கள் வளரும்; அதுபோல மனிதரின் ஊக்கத்தின் அளவுக்கு ஏற்ப உயர்வார்கள்.\n4. நாம் எண்ணுவதை எப்போதும் தாழ்வாக எண்ண வேண்டும் என்று வள்ளுவர் அறிவுறுத்துகிறார்.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "C": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "கூற்று 4 தவறானது; 'உள்ளுவது எல்லாம் உயர்வுள்ளல்' - எண்ணுவதெல்லாம் உயர்வாகவே எண்ண வேண்டும் என்று வள்ளுவர் கூறுகிறார். தாழ்வாக எண்ணச் சொல்லவில்லை."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "ஊக்கமே நிலையான உடைமை; மற்ற பொருளுடைமை நிலைத்து நில்லாமல் நீங்கிவிடும்.", "content_en": null}, {"id": "S2", "content_ta": "தளராத ஊக்கம் உடையவனிடம் ஆக்கமானது (செல்வம்) தானே வழிகேட்டுக்கொண்டு செல்லும்.", "content_en": null}, {"id": "S3", "content_ta": "'வெள்ளத்து அனைய மலர்நீட்டம் மாந்தர்தம் உள்ளத்து அனையது உயர்வு' - தண்ணீரின் உயரத்திற்கு ஏற்ப நீர்மலர்கள் வளரும்; அதுபோல மனிதரின் ஊக்கத்தின் அளவுக்கு ஏற்ப உயர்வார்கள்.", "content_en": null}, {"id": "S4", "content_ta": "நாம் எண்ணுவதை எப்போதும் தாழ்வாக எண்ண வேண்டும் என்று வள்ளுவர் அறிவுறுத்துகிறார்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u1", "section": null, "reference": "Standard 6, Term 2, Unit 1, Page 22", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u1-093", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பயனில சொல்லாமை' அதிகாரக் குறள்கள் குறித்த கூற்றுகளை ஆராய்க:\n1. 'அரும்பயன் ஆயும் அறிவினார் சொல்லார் பெரும்பயன் இல்லாத சொல்' - நன்மை எதுவென ஆராயும் அறிவுடையவர்கள் பயனற்ற சொற்களைப் பேசமாட்டார்கள்.\n2. 'சொல்லுக சொல்லில் பயனுடைய சொல்லற்க சொல்லில் பயன்இலாச் சொல்' - பயன் தரும் சொற்களை மட்டுமே பேச வேண்டும்; பயனற்ற சொற்களைப் பேசாமல் விட்டுவிட வேண்டும்.\n3. வீண் பேச்சுகளையும் பயனற்ற சொற்களையும் தவிர்ப்பதே பண்புடைய மனிதரின் அடையாளம் ஆகும்.\n4. பொருளுடைய சொற்களைப் பேசுவது மனித அறிவின் முதிர்ச்சியைக் காட்டுகிறது.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2 சரி; 3, 4 தவறு", "B": "கூற்றுகள் 2, 3 சரி; 1, 4 தவறு", "C": "கூற்றுகள் 1, 3, 4 சரி; 2 தவறு", "D": "அனைத்துக் கூற்றுகளும் சரியானவை"}, "explanation": "நான்கு கூற்றுகளும் பயனில சொல்லாமை அதிகாரக் கருத்துகளை முழுமையாக விளக்குகின்றன."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "'அரும்பயன் ஆயும் அறிவினார் சொல்லார் பெரும்பயன் இல்லாத சொல்' - நன்மை எதுவென ஆராயும் அறிவுடையவர்கள் பயனற்ற சொற்களைப் பேசமாட்டார்கள்.", "content_en": null}, {"id": "S2", "content_ta": "'சொல்லுக சொல்லில் பயனுடைய சொல்லற்க சொல்லில் பயன்இலாச் சொல்' - பயன் தரும் சொற்களை மட்டுமே பேச வேண்டும்; பயனற்ற சொற்களைப் பேசாமல் விட்டுவிட வேண்டும்.", "content_en": null}, {"id": "S3", "content_ta": "வீண் பேச்சுகளையும் பயனற்ற சொற்களையும் தவிர்ப்பதே பண்புடைய மனிதரின் அடையாளம் ஆகும்.", "content_en": null}, {"id": "S4", "content_ta": "பொருளுடைய சொற்களைப் பேசுவது மனித அறிவின்