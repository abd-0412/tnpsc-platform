{"id": "6th-t2-pyq-050", "schema_version": "1.0", "kind": "grammar_application", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "'பட்டினப்பாலை' என்னும் நூலின் பெயரிலுள்ள மொத்த மாத்திரை அளவு யாது?", "media_id": null}], "options": {"A": "6 மாத்திரைகள்", "B": "6 1/2 மாத்திரைகள்", "C": "7 மாத்திரைகள்", "D": "7 1/2 மாத்திரைகள்"}, "explanation": "ப (குறில் = 1) + ட் (மெய் = 0.5) + டி (குறில் = 1) + ன (குறில் = 1) + ப் (மெய் = 0.5) + பா (நெடில் = 2) + லை (நெடில் = 2 அல்ல, சொல்லின் இறுதியில் ஐகாரம் 1 மாத்திரை). இலக்கணப்படி: 1 + 0.5 + 1 + 1 + 0.5 + 2 + 1 (ஐகாரக்குறுக்கம்) = 7 மாத்திரை; நேரடி குறில்/நெடில் கணக்கீட்டில் 1 + 0.5 + 1 + 1 + 0.5 + 2 + 2 = 8. ஆனால் பள்ளி வழக்க மாத்திரை அளவின்படி B (6.5) அல்ல, 7 மாத்திரையாகக் கொள்ளலாம்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "ch