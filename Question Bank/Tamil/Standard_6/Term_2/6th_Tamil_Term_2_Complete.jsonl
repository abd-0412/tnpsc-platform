{"id": "6th-t2-u2-051", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'பாடுபட்டுத் தேடிய பணத்தைப் புதைத்து வைக்காதீர்' என்பது ஔவையாரின் வாய்மொழி அறிவுரை ஆகும்.\nகாரணம் (R): பணத்தைப் பூமிக்கடியில் புதைத்து வைத்தால் தான் அதன் மதிப்பு பன்மடங்கு பெருகும் என்று ஔவையார் கருதினார்.", "media_id": null}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி.", "B": "கூற்று சரி, ஆனால் காரணம் முற்றிலும் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "கூற்று சரி, காரணம் தவறு. பணத்தைப் புதைத்து வைப்பது மடமை; அதைத் தொழிலிலோ நற்பணிகளிலோ முதலீடு செய்து உழைப்பினால் பெருக்க வேண்டும் என்பதே ஔவையின் அறிவுரை."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'பாடுபட்டுத் தேடிய பணத்தைப் புதைத்து வைக்காதீர்' என்பது ஔவையாரின் வாய்மொழி அறிவுரை ஆகும்.", "reason": "பணத்தைப் பூமிக்கடியில் புதைத்து வைத்தால் தான் அதன் மதிப்பு பன்மடங்கு பெருகும் என்று ஔவையார் கருதினார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 36", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u2-044", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "வணிகச் சொற்களின் தமிழாக்கம் பொருத்துக:\nபட்டியல் I:\n(a) Heritage\n(b) Consumer\n(c) Merchant\n(d) Adulteration\n\nபட்டியல் II:\n1. கலப்படம்\n2. வணிகர்\n3. நுகர்வோர்\n4. பாரம்பரியம்", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-2, (b)-3, (c)-4, (d)-1", "C": "(a)-4, (b)-3, (c)-2, (d)-1", "D": "(a)-3, (b)-4, (c)-1, (d)-2"}, "explanation": "Heritage - பாரம்பரியம் (4); Consumer - நுகர்வோர் (3); Merchant - வணிகர் (2); Adulteration - கலப்படம் (1). சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 44", "url": null, "source_notes": null}, "previous_year": {"is_previous_