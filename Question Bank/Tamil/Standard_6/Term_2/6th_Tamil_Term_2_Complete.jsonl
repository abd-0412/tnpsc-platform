{"id": "6th-t2-u2-024", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "நெய்தல் நிலத்தின் திணைக் கூறுகளையும் விவரங்களையும் பொருத்துக:\nபட்டியல் I:\n(a) நிலம்\n(b) மக்கள்\n(c) தொழில்\n(d) பூ\n\nபட்டியல் II:\n1. தாழம்பூ\n2. மீன்பிடித்தல், உப்பு விளைவித்தல்\n3. பரதவர், பரத்தியர்\n4. கடலும் கடல் சார்ந்த இடமும்", "media_id": null}], "options": {"A": "(a)-4, (b)-3, (c)-2, (d)-1", "B": "(a)-1, (b)-2, (c)-3, (d)-4", "C": "(a)-2, (b)-3, (c)-4, (d)-1", "D": "(a)-3, (b)-4, (c)-1, (d)-2"}, "explanation": "நிலம் - கடலும் கடல் சார்ந்த இடமும்; மக்கள் - பரதவர், பரத்தியர்; தொழில் - மீன்பிடித்தல், உப்பு; பூ - தாழம்பூ. சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 30", "url": nul