{"id": "6th-t2-pyq-010", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): அதியமான் தான் பெற்ற கருநெல்லிக்கனியைத் தான் உண்ணாமல் ஔவைக்கு அளித்தான்.\nகாரணம் (R): அதியமான் தனக்கு நீண்ட ஆயுள் வேண்டாமென்றும், போர்க்களத்தில் வீரமரணம் அடைவதே மேல் என்றும் விரும்பியதால் அக்கனியைப் புறக்கணித்தான்.", "media_id": null}], "options": {"A": "கூற்று, காரணம் இரண்டும் சரி.", "B": "கூற்று சரி, ஆனால் காரணம் முற்றிலும் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "காரணம் தவறு; தமிழறிவும் நல்லுணர்வும் கொண்ட ஔவையார் நீண்ட காலம் வாழ்ந்தால் தமிழ் உலகம் தழைக்கும் என்ற உன்னத நோக்கிலேயே அதியமான் அக்கனியை ஈந்தான்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "அதியமான் தான் பெற்ற கருநெல்லிக்கனியைத் தான் உண்ணாமல் ஔவைக்கு அளித்தான்.", "reason": "அதியமான் தனக்கு நீண்ட ஆயுள் வேண்டாமென்றும், போர்க்களத்தில் வீரமரணம் அடைவதே மேல் என்றும் விரும்பியதால் அக்கனியைப் புறக்கணித்தான்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "previous_year", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "pyq_bridging", "section": null, "reference": "TNPSC Group 4 (2017) & Avvaiyar Adhiyaman", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": true, "exam": "tnpsc", "exam_name": "group_4", "year": "2017", "paper": "general_tamil", "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-pyq-011", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "pyq_bridging", "lesson_id": "pyq_bridging", "chapter_id": null, "topic_id": "topic-pyq_bridging", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): தாலாட்டுப் பாடலில் 'சேர நாட்டின் முத்தேன்', 'சோழ நாட்டின் முக்கனி', 'பாண்டிய நாட்டின் முத்தமிழ்' என மூவேந்தர் வளங்களும் பாடப்பட்டுள்ளன.\nகாரணம் (R): பிறக்கும் குழந்தையைத் தமிழ்நாட்டின் மூவேந்தர் வளங்களும் பண்பாடும் நிறைந்த பெருமைமிக்க குடிமகனாக வளர்க்கும் தமிழ் அன்னையரின் பண்பாட்டு மரபை இது காட்டுகிறது.", "media_id": null}], "options": {"A": "கூற்று சரி, காரணம் தவறு.", "B": "கூற்று தவறு, காரணம் சரி.", "C": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் (R) சரியான விளக்கம்.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "மூவேந்தர் சிறப்புகளையும் தன் குழந்தையின் சிறப்புகளாக இணைத்துப் பாடும் தமிழ் மரபு தாலாட்டில் மிளிர்கிறது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "தாலாட்டுப் பாடலில் 'சேர நாட்டின் முத்தேன்', 'சோழ நாட்டின் முக்கனி', 'பாண்டிய நாட்டின் முத்தமிழ்' என மூவேந்தர் வளங்களும் பாடப்பட்டுள்ளன.", "reason": "பிறக்கும் குழந்தையைத் தமிழ்நாட்டின் மூவேந்தர் வளங்களும் பண்பாடும் நிறைந்த பெருமைமிக்க குடிமகனாக வளர்க்கும் தமிழ் அன்னையரின் பண்பாட்டு மரபை இது காட்டுகிறது.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "C", "accepted_keys": ["C"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0