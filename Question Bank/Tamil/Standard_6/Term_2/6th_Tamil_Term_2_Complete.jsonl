{"id": "6th-t2-u1-076", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "மெல்லின மற்றும் இடையின மெய்களை இறுதி நிலையோடு பொருத்துக:\nபட்டியல் I:\n(a) மொழி இறுதியில் வரும் மெல்லின மெய்கள் எண்ணிக்கை\n(b) மொழி இறுதியில் வரும் இடையின மெய்கள் எண்ணிக்கை\n(c) மொழி இறுதியில் வாரா வல்லின மெய்கள் எண்ணிக்கை\n(d) மொழி இறுதியில் வாரா மெல்லின மெய் எண்ணிக்கை\n\nபட்டியல் II:\n1. ஒன்று (ங்)\n2. ஆறு (க், ச், ட், த், ப், ற்)\n3. ஆறு (ய், ர், ல், வ், ழ், ள்)\n4. ஐந்து (ஞ், ண், ந், ம், ன்)", "media_id": null}], "options": {"A": "(a)-4, (b)-3, (c)-2, (d)-1", "B": "(a)-1, (b)-2, (c)-3, (d)-4", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-2, (b)-1, (c)-4, (d)-3"}, "explanation": "இறுதியில் வரும் மெல்லினம் - 5; இறுதியில் வரும் இடையினம் - 6; வாரா வல்லினம் - 6; வாரா மெல்லினம் - 1 (ங்). சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "ed