// பாடம் 5: கற்கண்டு: இன எழுத்துகள் (இலக்கணம் & பிழைதிருத்தம்) [Q054 - Q079] (வினாக்கள்: 26)
// இன எழுத்துகள் (நட்பு எழுத்துகள்: பிறக்கும் இடம்/ஒலிக்கும் முயற்சி ஒற்றுமை), வல்லினத்திற்கு மெல்லினம் இணை (க்-ங், ச்-ஞ், ட்-ண், த்-ந், ப்-ம், ற்-ன்), இடையினம் 6-ம் ஒரே இனம், உயிர் இன எழுத்துகள் (குறில்-நெடில், ஐ-க்கு இ, ஔ-க்கு உ), அளபெடை விதி, ஆய்த எழுத்தின் தனித்தன்மை (இன எழுத்து அற்றது), பிழைதிருத்தம்: கண்டான் (கண்ரான் x), வென்றான் (வென்ரான் x), நண்டு, வண்டு, கலைச்சொற்கள்
// ==============================================================================
{"id": "6th-t2-u2-054", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "இன எழுத்துகள் (நட்பு எழுத்துகள்) குறித்த பின்வரும் கூற்றுகளை ஆராய்க:\n1. சில எழுத்துகளுக்கு இடையே ஒலிக்கும் முயற்சி, பிறக்கும் இடம் ஆகியவற்றில் ஒற்றுமை உண்டு; இவ்வாறு ஒற்றுமை உள்ள எழுத்துகள் 'இன எழுத்துகள்' எனப்படும்.\n2. ஆறு வல்லின மெய் எழுத்துகளுக்கும் ஆறு மெல்லின எழுத்துகளும் இன எழுத்துகள் ஆகும்.\n3. சொற்களில் மெல்லின மெய் எழுத்தை அடுத்துப் பெரும்பாலும் அதற்கு இனமாகிய வல்லின எழுத்து வரும்.\n4. சங்கு (ங்-க்), மஞ்சள் (ஞ்-ச்), பந்து (ந்-த்), தம்பி (ம்-ப்) ஆகியவை இதற்குரிய சிறந்த சான்றுகளாகும்.", "media_id": null}], "options": {"A": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "B": "அனைத்துக் கூற்றுகளும் சரியானவை", "C": "கூற்றுகள் 1, 3 சரி; 2, 4 தவறு", "D": "கூற்றுகள் 2, 4 சரி; 1, 3 தவறு"}, "explanation": "நான்கு கூற்றுகளும் பாடநூல் இலக்கணப் பகுதியின்படி முற்றிலும் சரியானவை. வல்லினத்திற்கு மெல்லினம் இன எழுத்துகளாக அமைந்து சொற்களில் தொடர்ந்து வரும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "சில எழுத்துகளுக்கு இடையே ஒலிக்கும் முயற்சி, பிறக்கும் இடம் ஆகியவற்றில் ஒற்றுமை உண்டு; இவ்வாறு ஒற்றுமை உள்ள எழுத்துகள் 'இன எழுத்துகள்' எனப்படும்.", "content_en": null}, {"id": "S2", "content_ta": "ஆறு வல்லின மெய் எழுத்துகளுக்கும் ஆறு மெல்லின எழுத்துகளும் இன எழுத்துகள் ஆகும்.", "content_en": null}, {"id": "S3", "content_ta": "சொற்களில் மெல்லின மெய் எழுத்தை அடுத்துப் பெரும்பாலும் அதற்கு இனமாகிய வல்லின எழுத்து வரும்.", "content_en": null}, {"id": "S4", "content_ta": "சங்கு (ங்-க்), மஞ்சள் (ஞ்-ச்), பந்து (ந்-த்), தம்பி (ம்-ப்) ஆகியவை இதற்குரிய சிறந்த சான்றுகளாகும்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 39-40", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "statement_analysis"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u2-056", "schema_version": "1.0", "kind": "statement_analysis", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "உயிர் அளபெடை மற்றும் இன எழுத்துகள் தொடர்பான கூற்றுகளை ஆராய்க:\n1. சொல்லில் உயிர் எழுத்துகள் சேர்ந்து வருவது இல்லை.\n2. செய்யுளில் ஓசை குறையும்போது அதனை நிறைவு செய்ய நெடில் எழுத்துகள் அளபெடுக்கும்.\n3. நெடில் எழுத்துகள் அளபெடுக்கும்போது அவற்றுக்கு இனமான குறில் எழுத்துகள் அவற்றின் பின்னால் வரும் (எ.கா: ஓஓதல், தூஉம், தழீஇ).\n4. அளபெடையில் நெடிலுக்குப் பின்னால் வல்லின மெய் எழுத்துகள் மட்டுமே வரும்.", "media_id": null}], "options": {"A": "அனைத்துக் கூற்றுகளும் சரி", "B": "கூற்றுகள் 1, 4 சரி; 2, 3 தவறு", "C": "கூற்றுகள் 1, 2, 3 சரி; 4 தவறு", "D": "கூற்றுகள் 2, 3, 4 சரி; 1 தவறு"}, "explanation": "கூற்று 4 தவறானது; அளபெடையில் நெடில் எழுத்திற்குப் பின் அதன் இனமான குறில் எழுத்தே வரும் (வல்லின மெய் வராது). 1, 2, 3 கூற்றுகள் சரியானவை."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [{"id": "S1", "content_ta": "சொல்லில் உயிர் எழுத்துகள் சேர்ந்து வருவது இல்லை.", "content_en": null}, {"id": "S2", "content_ta": "செய்யுளில் ஓசை குறையும்போது அதனை நிறைவு செய்ய நெடில் எழுத்துகள் அளபெடுக்கும்.", "content_en": null}, {"id": "S3", "content_ta": "நெடில் எழுத்துகள் அளபெடுக்கும்போது அவற்றுக்கு இனமான குறில் எழுத்துகள் அவற்றின் பின்னால் வரும் (எ.கா: ஓஓதல், தூஉம், தழீஇ).", "content_en": null}, {"id": "S4", "content_ta": "அளபெடையில் நெடிலுக்குப் பின்னால் வல்லின மெய் எழுத்துகள் மட்டுமே வரும்.", "content_en": null}], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null,