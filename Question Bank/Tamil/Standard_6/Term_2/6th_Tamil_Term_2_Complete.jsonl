{"id": "6th-t2-u2-097", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): பலரோடு பகிர்ந்து உண்பவனைப் 'பசி' என்னும் தீய நோய் அணுகுவதில்லை.\nகாரணம் (R): 'பாத்தூண் மரீஇயவனைப் பசிஎன்னும் தீப்பிணி தீண்டல் அரிது' என்று வள்ளுவர் பகிர்ந்தளிக்கும் அறத்தின் பாதுகாப்பை விளக்குகிறார்.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்.", "B": "கூற்று சரி, காரணம் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "பாத்தூண் = பகுத்து உண்ணுதல். தீப்பிணி = கொடிய நோய் (பசி நோய்). பகிர்ந்து உண்பவனுக்குப் பசி நோய் வராது."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "பலரோடு பகிர்ந்து உண்பவனைப் 'பசி' என்னும் தீய நோய் அணுகுவதில்லை.", "reason": "'பாத்தூண் மரீஇயவனைப் பசிஎன்னும் தீப்பிணி தீண்டல் அரிது' என்று வள்ளுவர் பகிர்ந்தளிக்கும் அறத்தின் பாதுகாப்பை விளக்குகிறார்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 47", "url": null, "source_notes": null}, "previous_year": {"is_previous_year": false, "exam": null, "exam_name": null, "year": null, "paper": null, "session": null, "question_number": null, "official_question_paper_url": null, "official_answer_key_url": null}, "media": {"has_media": false, "items": []}, "tags": ["general_tamil", "std_6", "term_2", "assertion_reason"], "language_status": {"ta": "available", "en": "not_available"}, "workflow": {"status": "published", "verification_status": "verified", "created_by": "TNPSC Engine", "created_at": "2026-11-02T00:00:00Z", "updated_by": null, "updated_at": null, "verified_by": "Antigravity AI", "verified_at": "2026-11-02T00:00:00Z", "archived_at": null}, "version": {"current": 1, "previous_version_id": null, "revision_reason": null}}
{"id": "6th-t2-u2-098", "schema_version": "1.0", "kind": "match", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "அன்புடைமை குறட்பாக்களின் அருஞ்சொற்களையும் பொருளையும் பொருத்துக:\nபட்டியல் I (சொல்):\n(a) ஆர்வலர்\n(b) என்பு\n(c) வன்பால்\n(d) வற்றல் மரம்\n\nபட்டியல் II (பொருள்):\n1. காய்ந்த மரம் (பட்ட மரம்)\n2. பாலை நிலம்\n3. எலும்பு (உடம்பு)\n4. அன்புடையவர்", "media_id": null}], "options": {"A": "(a)-1, (b)-2, (c)-3, (d)-4", "B": "(a)-4, (b)-3, (c)-2, (d)-1", "C": "(a)-3, (b)-4, (c)-1, (d)-2", "D": "(a)-2, (b)-1, (c)-4, (d)-3"}, "explanation": "ஆர்வலர் - அன்புடையவர் (4); என்பு - எலும்பு/உடம்பு (3); வன்பால் - பாலை நிலம் (2); வற்றல் மரம் - காய்ந்த மரம் (1). சரியான வரிசை: 4, 3, 2, 1."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": null, "reason": null, "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "B", "accepted_keys": ["B"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": true, "is_active_eligible": true}, "source": {"type": "book", "book_name": "Tamil Nadu Samacheer Kalvi", "publisher": "Tamil Nadu Textbook and Educational Services Corporation", "class": "6", "term": "2", "edition": "2024-2025", "publication_year": "2025", "page": null, "chapter": "u2", "section": null, "reference": "Standard 6, Term 2, Unit 2, Page 45"