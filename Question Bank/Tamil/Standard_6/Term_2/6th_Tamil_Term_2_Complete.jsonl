{"id": "6th-t2-u1-043", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u1", "lesson_id": "u1", "chapter_id": null, "topic_id": "topic-u1", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): போகிப் பண்டிகையின் போது வீட்டின் கூரைகளில் பூசணிப்பூ, காப்பரிசி, ஆவாரம்பூ, வேப்பிலை முதலானவற்றைச் சொருகுவர்.\nகாரணம் (R): வீட்டில் உள்ள பழைய தேவையில்லாத பொருள்களை நீக்குவதோடு, கிருமி நாசினிகளான மூலிகைகளைக் கொண்டு இல்லத்தைப் பாதுகாப்பதே இதன் நோக்கமாகும்.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்.", "B": "கூற்று சரி, காரணம் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "'பழையன கழிதலும் புதியன புகுதலும்' என்பதற்கேற்ப இல்லத்தைத் தூய்மை செய்து காப்புக் கட்டுதல் தமிழர் பண்பாடாகும்."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "போகிப் பண்டிகையின் போது வீட்டின் கூரைகளில் பூசணிப்பூ, காப்பரிசி, ஆவாரம்பூ, வேப்பிலை முதலானவற்றைச் சொருகுவர்.", "reason": "வீட்டில் உள்ள பழைய தேவையில்லாத பொருள்களை நீக்குவதோடு, கிருமி நாசினிகளான மூலிகைகளைக் கொண்டு இல்லத்தைப் பாதுகாப்பதே இதன் நோக்கமாகும்.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible": true}, "source": {"type": "book", "book_name": 