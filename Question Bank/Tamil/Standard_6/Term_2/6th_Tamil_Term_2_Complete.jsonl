{"id": "6th-t2-u2-062", "schema_version": "1.0", "kind": "assertion_reason", "level": "SSLC", "difficulty": "medium", "exam_mappings": ["group_4", "group_2", "group_2a"], "syllabus": {"class": "6", "subject_id": "general_tamil", "term": "2", "unit_id": "u2", "lesson_id": "u2", "chapter_id": null, "topic_id": "topic-u2", "subtopic_id": null}, "texts": {"ta": {"blocks": [{"type": "text", "content": "கூற்று (A): 'ஐ' என்னும் நெடில் எழுத்திற்கு 'இ' என்பதும், 'ஔ' என்னும் நெடில் எழுத்திற்கு 'உ' என்பதும் இன எழுத்துகள் ஆகும்.\nகாரணம் (R): ஐ, ஔ ஆகிய நெடில் எழுத்துகளுக்கு நேரிடையான தனிக்குறில் எழுத்துகள் தமிழில் இல்லாததால், அவற்றின் ஒலிப்பு முடிவை ஒட்டி முறையே 'இ', 'உ' ஆகியவை இனமாக அமைக்கப்பட்டன.", "media_id": null}], "options": {"A": "கூற்று (A) மற்றும் காரணம் (R) இரண்டும் சரி; காரணம் சரியான விளக்கம்.", "B": "கூற்று சரி, காரணம் தவறு.", "C": "கூற்று தவறு, காரணம் சரி.", "D": "கூற்று, காரணம் இரண்டும் தவறு."}, "explanation": "ஐகாரத்திற்கு இகரமும் ஔகாரத்திற்கு உகரமும் இன எழுத்துகளாகும். கூற்று மற்றும் காரணம் இரண்டும் மிகச்சரி."}, "en": {"blocks": [{"type": "text", "content": null, "media_id": null}], "options": {"A": null, "B": null, "C": null, "D": null}, "explanation": null}}, "question_data": {"assertion": "'ஐ' என்னும் நெடில் எழுத்திற்கு 'இ' என்பதும், 'ஔ' என்னும் நெடில் எழுத்திற்கு 'உ' என்பதும் இன எழுத்துகள் ஆகும்.", "reason": "ஐ, ஔ ஆகிய நெடில் எழுத்துகளுக்கு நேரிடையான தனிக்குறில் எழுத்துகள் தமிழில் இல்லாததால், அவற்றின் ஒலிப்பு முடிவை ஒட்டி முறையே 'இ', 'உ' ஆகியவை இனமாக அமைக்கப்பட்டன.", "statements": [], "matching_pairs": {"left": [], "right": []}, "ordered_items": [], "numeric_answer": null, "passage_reference": null, "table_reference": null, "image_reference": null}, "answer": {"correct_key": "A", "accepted_keys": ["A"], "correct_order": [], "matching_answer": [], "numeric_value": null, "answer_notes": null}, "question_settings": {"is_negative_question": false, "marks": 1.5, "negative_marks": 0.0, "allow_multiple_answers": false, "shuffle_options": false, "is_active_eligible":